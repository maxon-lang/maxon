// Test: cross-file-bool-short-circuits
// --- file: a.maxon

export function ready() returns bool
	return false
end 'ready'

function opaqueZero() returns int
	return 0
end 'opaqueZero'

export function enabled() returns bool
	let zero = opaqueZero()
	return (try (1 / zero) otherwise panic("`and` did not short-circuit: enabled() was evaluated")) == 0
end 'enabled'

// --- file: b.maxon
function main() returns ExitCode
	if not (ready() and enabled()) 'skipped'
		return 42
	end 'skipped'
	return 1
end 'main'
---
ExitCode: 42
---
func @enabled {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.jmp __il_body
  __il_body:
    x64.movRegImm32 rax, 0
    x64.jmp __il_cont
  __il_cont:
    x64.movRegImm32 rcx, 1
    x64.cmpRegImm32 rax, 0
    x64.setccReg equal, rsi
    x64.movRegReg rax, rcx
    x64.cqo
    x64.idivReg rsi
    x64.cmpRegImm32 rsi, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  tryok:
    x64.cmpRegImm32 rax, 0
    x64.setccReg equal, r8
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.jmp __il_body
  __il_body:
    x64.movRegImm32 rax, 0
    x64.jmp __il_cont
  __il_cont:
    x64.movRegImm32 rcx, 0
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, andrhs
    x64.jmp critsplit
  andrhs:
    x64.callDirect enabled
    x64.jmp scmerge
  critsplit:
    x64.movRegReg r8, rcx
    x64.jmp scmerge
  scmerge:
    x64.xorRegImm32 r8, r8, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, skipped
    x64.jmp ifcont
  skipped:
    x64.movRegImm32 r8, 42
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
