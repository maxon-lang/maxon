// Test: return-in-if-then-statement-after
function pick(x ExitCode) returns ExitCode
	if x > 0 'positive'
		return 1
	end 'positive'
	let fallback = 4
	return fallback
end 'pick'

function main() returns ExitCode
	if pick(9) != 1 'tookFalsePath'
		return 2
	end 'tookFalsePath'

	return pick(0)
end 'main'
---
ExitCode: 4
---
func @pick {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rcx, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.cmpRegImm32 rcx, 0
    x64.jcc lessEqual, ifcont
  positive:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 4
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 9
  __il_body#4:
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __il_slow#9
  __rc_chk#8:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegImm32 rax, 9
    x64.jcc greaterEqual, __rc_ok#7
  __il_slow#9:
    x64.callDirect pick
    x64.jmp __il_cont#3
  __rc_ok#7:
    x64.cmpRegImm32 rcx, 0
    x64.jcc lessEqual, ifcont#6
  positive#5:
    x64.movRegImm32 rax, 1
    x64.movRegReg r8, rax
    x64.jmp __il_cont#3
  ifcont#6:
    x64.movRegImm32 rax, 4
    x64.movRegReg r8, rax
  __il_cont#3:
    x64.cmpRegImm32 r8, 1
    x64.jcc equal, ifcont#2
  tookFalsePath:
    x64.movRegImm32 r8, 2
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegImm32 rcx, 0
  __il_body#11:
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __il_slow#16
  __rc_chk#15:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegImm32 rax, 0
    x64.jcc greaterEqual, __rc_ok#14
  __il_slow#16:
    x64.callDirect pick
    x64.jmp __il_cont#10
  __rc_ok#14:
    x64.cmpRegImm32 rcx, 0
    x64.jcc lessEqual, ifcont#13
  positive#12:
    x64.movRegImm32 r8, 1
    x64.jmp __il_cont#10
  ifcont#13:
    x64.movRegImm32 r8, 4
  __il_cont#10:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
