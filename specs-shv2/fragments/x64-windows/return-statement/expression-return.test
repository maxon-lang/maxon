// Test: expression-return
function main() returns ExitCode
	return 2 + 3 * 4
end 'main'
---
ExitCode: 14
---
func @main {
  entry:
    x64.movRegImm32 rax, 2
    x64.movRegImm32 rcx, 3
    x64.movRegImm32 rdx, 4
    x64.imulRegReg rcx, rdx
    x64.movRegReg r8, rax
    x64.addRegReg r8, rcx
    x64.ret
}
