    x64.movRegReg rcx, r13
    x64.callDirect __mm_incref
    x64.movRegImm32 r14, 0
    x64.jmp forhdr
  forhdr:
    x64.cmpRegImm32 r14, 8
    x64.jcc less, churn
    x64.jmp forexit
  churn:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect __list_detach_node
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
