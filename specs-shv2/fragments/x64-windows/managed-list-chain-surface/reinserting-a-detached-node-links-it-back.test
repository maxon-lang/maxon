    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect __list_detach_node
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect __list_reinsert_last
    x64.jmp forstep
  forstep:
    x64.leaRegRegImm32 r14, r14, 1
    x64.jmp forhdr
  forexit:
    x64.movRegReg rcx, rbx
    x64.callDirect __list_count
    x64.movRegReg rbx, r8
