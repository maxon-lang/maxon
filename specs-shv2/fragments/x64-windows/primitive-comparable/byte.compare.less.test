// Test: byte.compare.less

typealias Byte = int(0 to u8.max)

function main() returns ExitCode
	let a = 10 as Byte
	let b = 20 as Byte
	let result = a.compare(b)
	match result 'check'
		lessThan then return 0
		equalTo then return 1
		greaterThan then return 1
	end 'check'
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 10
    x64.movRegImm32 rdx, 20
    x64.callDirect int.compare
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, matcharm#1
    x64.jmp matchnext#5
  matcharm#1:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchnext#5:
    x64.cmpRegImm32 r8, 1
    x64.jcc equal, matcharm#2
    x64.jmp matchnext#6
  matcharm#2:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchnext#6:
    x64.cmpRegImm32 r8, 2
    x64.jcc equal, matcharm#3
    x64.jmp matchdead
  matcharm#3:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
  matchcont:
}

func @int.compare {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegReg rcx, rdx
    x64.jcc less, lt
    x64.jmp ifcont#2
  lt:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.cmpRegReg rcx, rdx
    x64.jcc greater, gt
    x64.jmp ifcont#4
  gt:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}
