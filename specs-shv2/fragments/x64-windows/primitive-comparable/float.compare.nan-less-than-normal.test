// Test: float.compare.nan-less-than-normal
function main() returns ExitCode
	// NaN from overflow (inf - inf), NOT `0.0 / 0.0` — a literal zero divisor is now a compile
	// error and a runtime one throws DivisionByZero. Overflow and inf - inf stay silent.
	let inf = 1.0e308 * 10.0
	let nan = inf - inf
	let x = 42.0
	let result = nan.compare(x)
	match result 'check'
		lessThan then return 0
		equalTo then return 1
		greaterThan then return 1
	end 'check'
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movsdRegRip xmm0, [rip + __fconst_0]
    x64.movsdRegRip xmm1, [rip + __fconst_1]
    x64.mulsdRegReg xmm0, xmm0, xmm1
    x64.subsdRegReg xmm0, xmm0, xmm0
    x64.movsdRegRip xmm1, [rip + __fconst_2]
    x64.jmp __il_body
  __il_body:
    x64.ucomisdRegReg xmm0, xmm0
    x64.jcc parity, self_nan
    x64.jmp fordered#20
  fordered#20:
    x64.jcc notEqual, self_nan
    x64.jmp ifcont#13
  self_nan:
    x64.ucomisdRegReg xmm1, xmm1
    x64.jcc parity, both_nan
    x64.jmp fordered#21
  fordered#21:
    x64.jcc notEqual, both_nan
    x64.jmp ifcont#12
  both_nan:
    x64.movRegImm32 rax, 1
    x64.jmp __il_cont
  ifcont#12:
    x64.movRegImm32 rax, 0
    x64.jmp __il_cont
  ifcont#13:
    x64.ucomisdRegReg xmm1, xmm1
    x64.jcc parity, other_nan
    x64.jmp fordered#22
  fordered#22:
    x64.jcc notEqual, other_nan
    x64.jmp ifcont#15
  other_nan:
    x64.movRegImm32 rax, 2
    x64.jmp __il_cont
  ifcont#15:
    x64.ucomisdRegReg xmm1, xmm0
    x64.jcc above, lt
    x64.jmp ifcont#17
  lt:
    x64.movRegImm32 rax, 0
    x64.jmp __il_cont
  ifcont#17:
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc above, gt
    x64.jmp ifcont#19
  gt:
    x64.movRegImm32 rax, 2
    x64.jmp __il_cont
  ifcont#19:
    x64.movRegImm32 rax, 1
    x64.jmp __il_cont
  __il_cont:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#1
    x64.jmp matchnext#5
  matcharm#1:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  matchnext#5:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm#2
    x64.jmp matchnext#6
  matcharm#2:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  matchnext#6:
    x64.cmpRegImm32 rax, 2
    x64.jcc equal, matcharm#3
    x64.jmp matchdead
  matcharm#3:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  matchdead:
  matchcont:
}
