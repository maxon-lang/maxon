// Test: bool.compare.equal
function main() returns ExitCode
	let a = true
	let b = true
	let result = a.compare(b)
	match result 'check'
		lessThan then return 1
		equalTo then return 0
		greaterThan then return 1
	end 'check'
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 1
    x64.movRegImm32 rcx, 1
    x64.jmp __il_body
  __il_body:
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 rsi, 0
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, s
    x64.jmp critsplit#18
  s:
    x64.movRegImm32 rax, 1
    x64.jmp ifcont#11
  critsplit#18:
    x64.movRegReg rax, rdx
    x64.jmp ifcont#11
  ifcont#11:
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, o
    x64.jmp critsplit#19
  o:
    x64.movRegImm32 rcx, 1
    x64.jmp ifcont#13
  critsplit#19:
    x64.movRegReg rcx, rsi
    x64.jmp ifcont#13
  ifcont#13:
    x64.cmpRegReg rax, rcx
    x64.jcc less, lt
    x64.jmp ifcont#15
  lt:
    x64.movRegImm32 rax, 0
    x64.jmp __il_cont
  ifcont#15:
    x64.cmpRegReg rax, rcx
    x64.jcc greater, gt
    x64.jmp ifcont#17
  gt:
    x64.movRegImm32 rax, 2
    x64.jmp __il_cont
  ifcont#17:
    x64.movRegImm32 rax, 1
    x64.jmp __il_cont
  __il_cont:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#1
    x64.jmp matchnext#5
  matcharm#1:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  matchnext#5:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm#2
    x64.jmp matchnext#6
  matcharm#2:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  matchnext#6:
    x64.cmpRegImm32 rax, 2
    x64.jcc equal, matcharm#3
    x64.jmp matchdead
  matcharm#3:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  matchdead:
  matchcont:
}
