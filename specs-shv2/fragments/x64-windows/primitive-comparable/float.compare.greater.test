// Test: float.compare.greater
function main() returns ExitCode
	let a = 3.14
	let b = 2.71
	let result = a.compare(b)
	match result 'check'
		lessThan then return 1
		equalTo then return 1
		greaterThan then return 0
	end 'check'
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movsdRegRip xmm0, [rip + __fconst_0]
    x64.movsdRegRip xmm1, [rip + __fconst_1]
  __il_body:
    x64.ucomisdRegReg xmm0, xmm0
    x64.jcc parity, self_nan
  fordered#20:
    x64.jcc equal, ifcont#13
  self_nan:
    x64.ucomisdRegReg xmm1, xmm1
    x64.jcc parity, both_nan
  fordered#21:
    x64.jcc equal, ifcont#12
  both_nan:
    x64.movRegImm32 rax, 1
    x64.jmp __il_cont
  ifcont#12:
    x64.movRegImm32 rax, 0
    x64.jmp __il_cont
  ifcont#13:
    x64.ucomisdRegReg xmm1, xmm1
    x64.jcc parity, other_nan
  fordered#22:
    x64.jcc equal, ifcont#15
  other_nan:
    x64.movRegImm32 rax, 2
    x64.jmp __il_cont
  ifcont#15:
    x64.ucomisdRegReg xmm1, xmm0
    x64.jcc belowEqual, ifcont#17
  lt:
    x64.movRegImm32 rax, 0
    x64.jmp __il_cont
  ifcont#17:
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc belowEqual, ifcont#19
  gt:
    x64.movRegImm32 rax, 2
    x64.jmp __il_cont
  ifcont#19:
    x64.movRegImm32 rax, 1
  __il_cont:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext#5
  matcharm#1:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  matchnext#5:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchnext#6
  matcharm#2:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  matchnext#6:
    x64.cmpRegImm32 rax, 2
    x64.jcc notEqual, matchdead
  matcharm#3:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  matchdead:
  matchcont:
}
