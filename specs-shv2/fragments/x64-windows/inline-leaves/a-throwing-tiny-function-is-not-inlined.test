// Test: a-throwing-tiny-function-is-not-inlined
typealias Integer = int(i64.min to i64.max)

enum HalveError
	odd
end 'HalveError'

function halve(n Integer) returns Integer throws HalveError
	if n < 0 'negative'
		throw HalveError.odd
	end 'negative'
	return n / 2
end 'halve'

function main() returns ExitCode
	let v = try halve(84) otherwise 0
	return v as ExitCode
end 'main'
---
ExitCode: 42
---
func @halve {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.jcc greaterEqual, ifcont
  negative:
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegReg rax, rcx
    x64.sarRegImm8 rax, rcx, 63
    x64.shrRegImm8 rax, rax, 63
    x64.leaRegRegReg r8, rcx, rax
    x64.sarRegImm8 r8, r8, 1
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 84
    x64.callDirect halve
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, trycont
  tryerr:
    x64.movRegImm32 r8, 0
  trycont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at a-throwing-tiny-function-is-not-inlined.test:17: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
