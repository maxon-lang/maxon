// Test: the-panic-rule-holds-when-the-argument-is-an-inlined-element
typealias Integer = int(i64.min to i64.max)
typealias Percent = int(0 to 100)
typealias IntArray = Array with Integer

function clampPct(x Percent) returns Percent
	return x
end 'clampPct'

function main() returns ExitCode
	var a = IntArray.create()
	a.push(101)
	var last = 0
	for v in a 'each'
		last = clampPct(v)
	end 'each'
	return last as ExitCode
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @clampPct {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rcx, 100
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at the-panic-rule-holds-when-the-argument-is-an-inlined-element.test:6: Range check failed: value outside typealias 'Percent'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rcx
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 101
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 r12, 0
    x64.movRegImm32 r13, 0
  forhdr:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegReg r13, rax
    x64.jcc greaterEqual, forexit
  each:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseIndexScale.word64 rcx, [rax + r13*8 + 0]
  __il_body:
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __il_slow
  __rc_chk#12:
    x64.cmpRegImm32 rcx, 100
    x64.jcc lessEqual, __rc_ok#11
  __il_slow:
    x64.callDirect clampPct
    x64.jmp forstep
  __rc_ok#11:
    x64.movRegReg r8, rcx
  forstep:
    x64.leaRegRegImm32 r13, r13, 1
    x64.movRegReg r12, r8
    x64.jmp forhdr
  forexit:
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk#7:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc lessEqual, __rc_ok#5
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at the-panic-rule-holds-when-the-argument-is-an-inlined-element.test:17: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#5:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
