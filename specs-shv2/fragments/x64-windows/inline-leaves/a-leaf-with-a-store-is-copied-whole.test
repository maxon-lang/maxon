// Test: a-leaf-with-a-store-is-copied-whole
typealias Integer = int(i64.min to i64.max)

type Minter
	export var next as Integer

	export static function create() returns Self
		return Self{next: 0}
	end 'create'

	export function mint() returns Integer
		let id = self.next
		self.next = self.next + 1
		return id
	end 'mint'
end 'Minter'

function main() returns ExitCode
	var m = Minter.create()
	let a = m.mint()
	let b = m.mint()
	let c = m.mint()
	return (a + b + c + 39) as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __slab_cursor@0 = i64 0
  __mm_free_lists@8 = i64 0
  __slab_end@16 = i64 0
  __mm_alloc_count@24 = i64 0
}

func @main {
  entry#0:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.leaRegSlot rax, slot0
    x64.movRegImm32 rcx, 0
    x64.storeBaseDispReg.word64 [rax + 0], rcx
    x64.jmp entry#7
  entry#7:
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.loadRegBaseDisp.word64 rdx, [rax + 0]
    x64.leaRegRegImm32 rdx, rdx, 1
    x64.storeBaseDispReg.word64 [rax + 0], rdx
    x64.jmp __il_cont#6
  __il_cont#6:
    x64.jmp entry#8
  entry#8:
    x64.loadRegBaseDisp.word64 rdx, [rax + 0]
    x64.loadRegBaseDisp.word64 rsi, [rax + 0]
    x64.leaRegRegImm32 rsi, rsi, 1
    x64.storeBaseDispReg.word64 [rax + 0], rsi
    x64.jmp __il_cont#5
  __il_cont#5:
    x64.jmp entry#9
  entry#9:
    x64.loadRegBaseDisp.word64 rsi, [rax + 0]
    x64.loadRegBaseDisp.word64 rdi, [rax + 0]
    x64.leaRegRegImm32 rdi, rdi, 1
    x64.storeBaseDispReg.word64 [rax + 0], rdi
    x64.jmp __il_cont#4
  __il_cont#4:
    x64.leaRegRegReg rax, rcx, rdx
    x64.leaRegRegReg rax, rax, rsi
    x64.leaRegRegImm32 r8, rax, 39
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}
