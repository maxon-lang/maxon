// Test: a-pure-leaf-is-inlined
typealias RegNum = int(0 to 63)
typealias RegMask = int(0 to u64.max)

function maskContains(mask RegMask, regNum RegNum) returns bool
	return ((mask shr regNum) and 1) != 0
end 'maskContains'

function main() returns ExitCode
	let mask = 5 as RegMask
	var count = 0
	var i = 0
	while i < 8 'each'
		if maskContains(mask, regNum: i as RegNum) 'set'
			count = count + 1
		end 'set'
		i = i + 1
	end 'each'
	return count as ExitCode
end 'main'
---
ExitCode: 2
---
func @maskContains {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegReg rax, rcx
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rdx, 63
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, rdx
    x64.shrRegCl rax, rax
    x64.andRegImm32 rax, rax, 1
    x64.cmpRegImm32 rax, 0
    x64.setccReg notEqual, r8
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 5
    x64.movRegImm32 r12, 0
    x64.movRegImm32 r13, 0
  whilehdr:
    x64.cmpRegImm32 r13, 8
    x64.jcc greaterEqual, whileexit
  each:
    x64.cmpRegImm32 r13, 0
    x64.setccReg less, rax
    x64.jcc less, __rc_panic#7
  __rc_chk#8:
    x64.cmpRegImm32 r13, 63
    x64.setccReg greater, rcx
    x64.jcc lessEqual, __il_body
  __rc_panic#7:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __il_body:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, __il_slow
  __rc_chk#15:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, __rc_ok#14
  __il_slow:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect maskContains
    x64.jmp __il_cont
  __rc_ok#14:
    x64.movRegReg rcx, r13
    x64.movRegReg rax, rbx
    x64.shrRegCl rax, rbx
    x64.andRegImm32 rax, rax, 1
    x64.cmpRegImm32 rax, 0
    x64.setccReg notEqual, rax
    x64.movRegReg r8, rax
  __il_cont:
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, critsplit
  set:
    x64.leaRegRegImm32 rax, r12, 1
    x64.jmp ifcont
  critsplit:
    x64.movRegReg rax, r12
  ifcont:
    x64.leaRegRegImm32 r13, r13, 1
    x64.movRegReg r12, rax
    x64.jmp whilehdr
  whileexit:
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic#10
  __rc_chk#11:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc lessEqual, __rc_ok#9
  __rc_panic#10:
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#9:
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
