// Test: the-inlined-guard-still-panics-with-the-callees-frame
typealias Integer = int(i64.min to i64.max)
typealias Percent = int(0 to 100)

function clampPct(x Percent) returns Percent
	return x
end 'clampPct'

function grow(n Integer) returns Integer
	return n * 101
end 'grow'

function main() returns ExitCode
	let big = grow(1)
	return clampPct(big)
end 'main'
---
ExitCode: 1
---
func @clampPct {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rcx, 100
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rcx
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __il_body:
    x64.movRegImm32 rcx, 101
  __il_slow:
    x64.callDirect clampPct
  __il_cont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
