// Test: gives-owned-string-arm-undeclared-call
function pick(x Integer, c bool) returns String
	return match c 'm'
		true gives "{x}"
		default gives undefinedThing()
	end 'm'
end 'pick'

function main() returns ExitCode
	let s = pick(5, c: true)
	return 0
end 'main'
typealias Integer = int(i64.min to i64.max)
