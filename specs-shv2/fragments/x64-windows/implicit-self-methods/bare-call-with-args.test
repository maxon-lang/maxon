// Test: bare-call-with-args

typealias Integer = int(i64.min to i64.max)

type Adder
	export var base as Integer

	static function create(base Integer) returns Self
		return Self{base: base}
	end 'create'

	function add(x Integer) returns Integer
		return base + x
	end 'add'

	function addTwice(x Integer) returns Integer
		return add(x) + add(x)
	end 'addTwice'
end 'Adder'

function main() returns ExitCode
	let a = Adder.create(1)
	return a.addTwice(3)
end 'main'
---
ExitCode: 8
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Adder.add {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.leaRegRegReg r8, rax, rdx
    x64.popReg rbp
    x64.ret
}

func @Adder.addTwice {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect Adder.add
    x64.movRegReg r13, r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect Adder.add
    x64.leaRegRegReg r8, r13, r8
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.movRegImm32 rax, 1
    x64.leaRegSlot rcx, slot0
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 rdx, 3
    x64.callDirect Adder.addTwice
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}
