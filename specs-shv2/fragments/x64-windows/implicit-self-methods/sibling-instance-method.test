// Test: sibling-instance-method

typealias Integer = int(i64.min to i64.max)

type Counter
	export var n as Integer

	static function create() returns Self
		return Self{n: 0}
	end 'create'

	function bump() returns Integer
		return n + 1
	end 'bump'

	function twice() returns Integer
		return bump() + bump()
	end 'twice'
end 'Counter'

function main() returns ExitCode
	let c = Counter.create()
	return c.twice()
end 'main'
---
ExitCode: 2
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Counter.twice {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.jmp __il_body#3
  __il_body#3:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp __il_cont#2
  __il_cont#2:
    x64.jmp __il_body#4
  __il_body#4:
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.jmp __il_cont#1
  __il_cont#1:
    x64.leaRegRegReg r8, rax, rcx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.leaRegSlot rcx, slot0
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.callDirect Counter.twice
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}
