// Test: if-else-block-before-later-sibling

typealias Integer = int(i64.min to i64.max)

type Box
	export var n as Integer

	static function create() returns Self
		return Self{n: 0}
	end 'create'

	function branchy(x Integer) returns Integer
		if x > 0 'pos'
			return helper() + 1
		end 'pos' else 'neg'
			return helper()
		end 'neg'
	end 'branchy'

	function helper() returns Integer
		return 5
	end 'helper'
end 'Box'

function main() returns ExitCode
	let b = Box.create()
	return b.branchy(1)
end 'main'
---
ExitCode: 6
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Box.branchy {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rdx, 0
    x64.jcc lessEqual, __il_body#7
  __il_body#5:
    x64.movRegImm32 rax, 5
  __il_cont#4:
    x64.leaRegRegImm32 r8, rax, 1
    x64.popReg rbp
    x64.ret
  __il_body#7:
    x64.movRegImm32 r8, 5
  __il_cont#6:
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.leaRegSlot rcx, slot0
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 rdx, 1
    x64.callDirect Box.branchy
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}
