}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.leaRegFunc rcx, [rip + fill]
    x64.callDirect __gt_spawn
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __gt_ready
    x64.movRegReg rcx, rbx
    x64.callDirect __gt_await
    x64.cmpRegImm32 r8, 16000
    x64.jcc equal, ifcont#2
  lost:
    x64.movRegImm32 r8, 1
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.callDirect __slab_scavenge
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#4
  graceSkipped:
    x64.movRegImm32 r8, 2
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.callDirect __slab_scavenge
    x64.cmpRegImm32 r8, 0
