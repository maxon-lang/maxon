// Test: module-let-same-directory
// --- file: feature/limits.maxon
module let LIMIT = 21

// --- file: feature/main.maxon
let DOUBLE = LIMIT * 2

function main() returns ExitCode
	return DOUBLE
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
}
