// Test: the-four-node-argument-doors-admit-every-arrival
typealias StrChain = __ManagedList with String
typealias StrNode = __ManagedListNode with String

type Keeper
	export var node as StrNode

	export static function create(n StrNode) returns Self
		return Self{node: n}
	end 'create'

	export function held() returns StrNode
		return self.node
	end 'held'

	export function read() returns String
		return self.node.value()
	end 'read'
end 'Keeper'

function moveToBack(c StrChain, n StrNode)
	c.reinsertLast(n)
end 'moveToBack'

function headOf(c StrChain) returns String
	let h = try c.head() otherwise 'empty'
		return "<empty>"
	end 'empty'
	return h.value()
end 'headOf'

function main() returns ExitCode
	var chain = StrChain.create()
	let n1 = chain.insertLast("one, long enough to be a real heap allocation")
	let n2 = chain.insertLast("two, long enough to be a real heap allocation")
	let k = Keeper.create(n2)
	chain.reinsertFirst(k.node)
	print("field: {headOf(chain)} / {k.read()}\n")
	chain.reinsertLast(k.held())
	print("call result: {headOf(chain)} / {k.read()}\n")
	moveToBack(chain, n: n1)
	print("parameter: {headOf(chain)} / {n1.value()}\n")
	chain.reinsertFirst(try chain.tail() otherwise 'empty'
		return 1
	end 'empty')
	print("navigator: {headOf(chain)}\n")
	chain.reinsertLast(chain.insertFirst("three, long enough to be a real heap allocation"))
	print("insertion: {headOf(chain)} {chain.count()}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Keeper.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
    x64.movRegReg rcx, rbx
    x64.callDirect __list_node_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Keeper.held {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callDirect __mm_retain
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @Keeper.read {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callDirect __list_node_value
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @moveToBack {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __list_reinsert_last
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @headOf {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect __list_head_checked
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_rec_12]
    x64.callDirect __str_retain
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, rbx
    x64.callDirect __list_node_value
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.callDirect __mm_incref
    x64.movRegReg rcx, rbx
    x64.callDirect __list_node_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

