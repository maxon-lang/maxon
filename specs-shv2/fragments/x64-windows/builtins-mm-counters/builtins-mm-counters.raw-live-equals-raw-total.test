// Test: builtins-mm-counters.raw-live-equals-raw-total
function work(n ExitCode) returns ExitCode
	__Builtins.parallelBoundary()
	return n + 1
end 'work'

function main() returns ExitCode
	let p = async work(1)
	let a = await p
	let total = __Builtins.mmRawAllocTotal()
	let live = __Builtins.mmRawAllocLive()
	var score = a
	if total > 0 'somethingToCompare'
		score = score + 1
	end 'somethingToCompare'
	if live == total 'nothingReclaimsASlabSpan'
		score = score + 4
	end 'nothingReclaimsASlabSpan'
	return score as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
  __mm_alloc_total@24 = i64 0
  __mm_alloc_bytes@32 = i64 0
  __mm_raw_alloc_count@40 = i64 0
  __mm_raw_alloc_bytes@48 = i64 0
  __gt_current_gt@56 = i64 0
  __gt_run_queue_head@64 = i64 0
  __gt_run_queue_tail@72 = i64 0
  __gt_init_done@80 = i64 0
  __gt_system_stack_top@88 = i64 0
  __gt_timer_count@96 = i64 0
  __gt_timer_heap_base@104 = i64 0
  __gt_timer_capacity@112 = i64 0
  __gt_trace_counter@120 = i64 0
  __gt_trace_digits@128 = i64 0
  __gt_clock_ticks@136 = i64 0
  __gt_clock_freq@144 = i64 0
  __gt_proc_count@152 = i64 0
  __gt_proc_handles_base@160 = i64 0
  __gt_proc_gts_base@168 = i64 0
  __gt_free_list_head@176 = i64 0
  __gt_live_count@184 = i64 0
  __gt_startup_base@192 = i64 0
  __gt_procinfo_base@200 = i64 0
  __gt_exitcode_base@208 = i64 0
  __gt_cmdline_buf_base@216 = i64 0
  __gt_cmdline_buf_cap@224 = i64 0
}

func @work {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic#2
    x64.jmp __rc_chk#3
  __rc_chk#3:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc greater, __rc_panic#2
    x64.jmp __rc_ok#1
  __rc_panic#2:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#1:
    x64.callDirect __parallel_boundary
    x64.leaRegRegImm32 r8, rbx, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#5
    x64.jmp __rc_chk#6
  __rc_chk#6:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic#5
    x64.jmp __rc_ok#4
  __rc_panic#5:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#4:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rbx, 1
    x64.leaRegFunc rcx, [rip + work]
    x64.callDirect __gt_spawn
    x64.storeBaseDispReg.word64 [r8 + 192], rbx
    x64.movRegReg rcx, r8
    x64.callDirect __gt_await
    x64.movRegReg rbx, r8
    x64.callDirect __mm_counter_raw_alloc_total
    x64.movRegReg r12, r8
    x64.callDirect __mm_counter_raw_alloc_live
    x64.cmpRegImm32 r12, 0
    x64.jcc greater, somethingToCompare
    x64.jmp critsplit#11
  somethingToCompare:
    x64.leaRegRegImm32 rax, rbx, 1
    x64.jmp ifcont#2
  critsplit#11:
    x64.movRegReg rax, rbx
    x64.jmp ifcont#2
  ifcont#2:
    x64.cmpRegReg r8, r12
    x64.jcc equal, nothingReclaimsASlabSpan
    x64.jmp critsplit#12
  nothingReclaimsASlabSpan:
    x64.leaRegRegImm32 r8, rax, 4
    x64.jmp ifcont#4
  critsplit#12:
    x64.movRegReg r8, rax
    x64.jmp ifcont#4
  ifcont#4:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#6
    x64.jmp __rc_chk#7
  __rc_chk#7:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic#6
    x64.jmp __rc_ok#5
  __rc_panic#6:
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#5:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#9
    x64.jmp __rc_chk#10
  __rc_chk#10:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic#9
    x64.jmp __rc_ok#8
  __rc_panic#9:
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#8:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
