    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 3
    x64.movRegReg rcx, r12
    x64.callDirect __managed_push
    x64.movRegImm32 r13, 42
    x64.movRegReg rcx, r12
    x64.callDirect __mm_incref
    x64.leaRegRdata r9, [rip + __layout_Map_IntArr_Val]
    x64.leaRegRdata rsi, [rip + __witness_Array_Val.Hashable]
    x64.leaRegRdata rdi, [rip + __witness_Array_Val.Equatable]
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.movRegReg rax, r13
    x64.callDirect Map.insert
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, trycont
  trycont:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r13, r8
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, r13
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 2
    x64.movRegReg rcx, r13
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 3
    x64.movRegReg rcx, r13
    x64.callDirect __managed_push
    x64.leaRegRdata rax, [rip + __layout_Map_IntArr_Val]
    x64.leaRegRdata r9, [rip + __witness_Array_Val.Hashable]
    x64.leaRegRdata rsi, [rip + __witness_Array_Val.Equatable]
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect Map.get
    x64.movRegReg r14, r8
