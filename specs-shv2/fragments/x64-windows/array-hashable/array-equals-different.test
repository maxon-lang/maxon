// Test: array-equals-different
function main() returns ExitCode
	let a = [1, 2, 3]
	let b = [1, 2, 4]
	if a.equals(b) 'eq'
		return 1
	end 'eq'
	return 0
end 'main'
---
ExitCode: 0
