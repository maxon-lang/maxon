// Test: dead-global-dropped-beside-a-live-managed-one
let deadArr = [1, 2, 3]
let liveArr = [10, 20, 30]
var probe = 4

function main() returns ExitCode
	return ((try liveArr.get(1) otherwise 0) - probe) as ExitCode
end 'main'
---
ExitCode: 16
---
data {
  __data_liveArr@0 = i64 0
  __data_probe@8 = i64 4
  __mm_alloc_count@16 = i64 0
  __slab_arena_list@24 = i64 0
  __slab_arena_map_l1@32 = i64 0
  __slab_state@40 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegGlobal rax, __data_liveArr
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.movRegImm32 rdx, 1
    x64.loadRegBaseDisp.word64 rax, [rcx + 24]
    x64.cmpRegImm32 rax, 8
    x64.jcc equal, __im_word
    x64.jmp __im_stride
  __im_word:
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.cmpRegImm32 rdx, 0
    x64.setccReg less, rsi
    x64.cmpRegImm32 rax, 1
    x64.setccReg lessEqual, rax
    x64.orRegReg rsi, rsi, rax
    x64.cmpRegImm32 rsi, 0
    x64.jcc notEqual, __im_slow
    x64.jmp __im_load#13
  __im_load#13:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.imulRegRegImm32 rsi, rdx, 8
    x64.leaRegRegReg rax, rax, rsi
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.jmp __im_loaded
  __im_stride:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, __im_byte
    x64.jmp __im_slow
  __im_byte:
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.cmpRegImm32 rdx, 0
    x64.setccReg less, rsi
    x64.cmpRegImm32 rax, 1
    x64.setccReg lessEqual, rax
    x64.orRegReg rsi, rsi, rax
    x64.cmpRegImm32 rsi, 0
    x64.jcc notEqual, __im_slow
    x64.jmp __im_load#14
  __im_load#14:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.leaRegRegReg rax, rax, rdx
    x64.loadRegBaseDisp.byte rax, [rax + 0]
    x64.jmp __im_loaded
  __im_loaded:
    x64.movRegImm32 rsi, 0
    x64.loadRegBaseDisp.word64 rdi, [rcx + 40]
    x64.cmpRegImm32 rdi, 0
    x64.jcc notEqual, __im_empty
    x64.jmp critsplit#16
  __im_empty:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __im_slow
    x64.jmp critsplit#17
  critsplit#17:
    x64.jmp __im_cont
  critsplit#16:
    x64.jmp __im_cont
  __im_slow:
    x64.callDirect __managed_get
    x64.movRegReg rax, r8
    x64.movRegReg rsi, r10
    x64.jmp __im_cont
  __im_cont:
    x64.cmpRegImm32 rsi, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 rax, 0
    x64.jmp trycont
  tryok:
    x64.jmp trycont
  trycont:
    x64.leaRegGlobal rcx, __data_probe
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.movRegReg r8, rax
    x64.subRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
