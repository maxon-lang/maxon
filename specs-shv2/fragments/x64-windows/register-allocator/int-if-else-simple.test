// Test: int-if-else-simple
function main() returns ExitCode
	let x = 10
	if x == 10 'check'
		return 42
	end 'check' else 'other'
		return 0
	end 'other'
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 10
    x64.cmpRegImm32 rax, 10
    x64.jcc notEqual, ifelse
  check:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
  ifelse:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
