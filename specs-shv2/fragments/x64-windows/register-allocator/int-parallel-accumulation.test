// Test: int-parallel-accumulation
function main() returns ExitCode
	var sum1 = 0
	var sum2 = 0
	var sum3 = 0
	sum1 = sum1 + 10
	sum2 = sum2 + 20
	sum3 = sum3 + 30
	sum1 = sum1 + 5
	sum2 = sum2 + 10
	sum3 = sum3 + 15
	return sum1 + sum2 + sum3
end 'main'
---
ExitCode: 90
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 0
    x64.movRegImm32 rdx, 0
    x64.leaRegRegImm32 rax, rax, 10
    x64.leaRegRegImm32 rcx, rcx, 20
    x64.leaRegRegImm32 rdx, rdx, 30
    x64.leaRegRegImm32 rax, rax, 5
    x64.leaRegRegImm32 rcx, rcx, 10
    x64.leaRegRegImm32 rdx, rdx, 15
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegRegReg r8, rax, rdx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
