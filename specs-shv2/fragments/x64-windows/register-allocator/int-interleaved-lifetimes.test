// Test: int-interleaved-lifetimes
function main() returns ExitCode
	let a = 10
	let b = 20
	let ab = a + b
	let c = 30
	let d = 40
	let cd = c + d
	let e = 50
	let f = 60
	let ef = e + f
	let result = ab + cd + ef
	return result and 125
end 'main'
---
ExitCode: 80
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 10
    x64.leaRegRegImm32 rax, rax, 20
    x64.movRegImm32 rcx, 30
    x64.leaRegRegImm32 rcx, rcx, 40
    x64.movRegImm32 rdx, 50
    x64.leaRegRegImm32 rdx, rdx, 60
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegRegReg r8, rax, rdx
    x64.andRegImm32 r8, r8, 125
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
