// Test: int-ten-vars-alive
function main() returns ExitCode
	let a = 1
	let b = 2
	let c = 3
	let d = 4
	let e = 5
	let f = 6
	let g = 7
	let h = 8
	let i = 9
	let j = 10
	return a + b + c + d + e + f + g + h + i + j
end 'main'
---
ExitCode: 55
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 55
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
