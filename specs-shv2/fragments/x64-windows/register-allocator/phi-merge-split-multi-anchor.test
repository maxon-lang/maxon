// Test: phi-merge-split-multi-anchor
function main() returns ExitCode
	var a = 0
	var b = 0
	var c = 0
	var d = 0
	if 1 < 2 'g1'
		a = 1
		b = 2
		c = 3
		d = 4
	end 'g1' else 'g1e'
		a = 10
		b = 20
		c = 30
		d = 40
	end 'g1e'
	if a > 0 'g2'
		a = a + 100
		c = c + 100
	end 'g2' else 'g2e'
		b = b + 100
		d = d + 100
	end 'g2e'
	if b > 0 'g3'
		a = a + b
		c = c + d
	end 'g3' else 'g3e'
		b = a - 1
		d = c - 1
	end 'g3e'
	return (a + b + c + d) and 125
end 'main'
---
ExitCode: 88
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 rax, 2
    x64.jcc greaterEqual, ifelse#2
  g1:
    x64.movRegImm32 rax, 1
    x64.movRegImm32 rcx, 2
    x64.movRegImm32 rdx, 3
    x64.movRegImm32 rsi, 4
    x64.jmp ifcont#3
  ifelse#2:
    x64.movRegImm32 rax, 10
    x64.movRegImm32 rcx, 20
    x64.movRegImm32 rdx, 30
    x64.movRegImm32 rsi, 40
  ifcont#3:
    x64.cmpRegImm32 rax, 0
    x64.jcc lessEqual, ifelse#5
  g2:
    x64.leaRegRegImm32 rax, rax, 100
    x64.leaRegRegImm32 rdx, rdx, 100
    x64.jmp ifcont#6
  ifelse#5:
    x64.leaRegRegImm32 rcx, rcx, 100
    x64.leaRegRegImm32 rsi, rsi, 100
  ifcont#6:
    x64.cmpRegImm32 rcx, 0
    x64.jcc lessEqual, ifelse#8
  g3:
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegRegReg rdx, rdx, rsi
    x64.jmp ifcont#9
  ifelse#8:
    x64.leaRegRegImm32 rcx, rax, -1
    x64.leaRegRegImm32 rsi, rdx, -1
  ifcont#9:
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegRegReg rax, rax, rdx
    x64.leaRegRegReg r8, rax, rsi
    x64.andRegImm32 r8, r8, 125
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
