// Test: union-case-named-self-allowed
typealias Tally = int(0 to 125)

union Node
	leaf(value Tally)
	self
end 'Node'

function pick(n Node) returns Tally
	return match n 'm'
		leaf(v) gives v
		self gives 7
	end 'm'
end 'pick'

function main() returns ExitCode
	return pick(Node.self)
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r8 + 8], rax
    x64.jmp __il_body
  __il_body:
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#3
    x64.jmp matchnext
  matcharm#3:
    x64.loadRegBaseDisp.word64 rbx, [r8 + 8]
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm#4
    x64.jmp matchdead
  matcharm#4:
    x64.movRegImm32 rbx, 7
    x64.jmp matchcont
  matchcont:
    x64.jmp __il_cont
  __il_cont:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
}
