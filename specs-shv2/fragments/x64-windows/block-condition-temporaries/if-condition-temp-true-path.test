// Test: if-condition-temp-true-path
typealias Integer = int(i64.min to i64.max)

function main() returns ExitCode
	var flag = 0 as Integer
	if [10, 20, 30].count() == 3 'x'
		flag = 1
	end 'x'
	return flag
end 'main'
---
ExitCode: 1
---
