  __gt_proc_gts_base@80 = i64 0
  __gt_proc_wait_snapshot@88 = i64 0
  __gt_proc_poller@96 = i64 0
  __gt_live_count@104 = i64 0
  __sched_progress@112 = i64 0
  __sched_active_workers@120 = i64 1
  __sched_max_active_workers@128 = i64 1
  __sched_tls_index@136 = i64 0
  __sched_tls_teb_offset@144 = i64 0
  __sched_procs@152 = i64 0
  __sched_allm@160 = i64 0
  __sched_midle@168 = i64 0
  __sched_pidle@176 = i64 0
  __sched_num_procs@184 = i64 0
  __sched_shutdown_flag@192 = i64 0
  __sched_lock@200 = i64 0
  __sched_nmspinning@208 = i64 0
  __sched_parked_drivers@216 = i64 0
  __slab_arena_list@224 = i64 0
  __slab_arena_map_l1@232 = i64 0
  __slab_state@240 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_1]  ; "./*"
    x64.callDirect String.toByteArray
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __md_open_search
    x64.movRegReg r12, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#1
  tryerr#2:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#1:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg rcx, r12
    x64.callDirect __md_close
    x64.movRegReg rcx, r12
    x64.callDirect __md_next
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#3
  tryerr#4:
    x64.leaRegRegImm32 rax, r10, -1
    x64.cmpRegImm32 rax, 7
    x64.jcc notEqual, matchdefault
  matcharm:
    x64.movRegImm32 rbx, 42
    x64.movRegReg rcx, r12
    x64.callDirect __md_destruct
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdefault:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at managed-directory.next-after-close-throws-closed.test:8: expected closed\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#3:
    x64.movRegImm32 rbx, 2
    x64.movRegReg rcx, r12
    x64.callDirect __md_destruct
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
