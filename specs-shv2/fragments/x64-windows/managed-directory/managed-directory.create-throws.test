    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_1]  ; "nonexistent_parent_xyz_88888/child"
    x64.callDirect String.toByteArray
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __md_create
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm32 r12, 42
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
