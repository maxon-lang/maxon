// Test: managed-directory.open-search-not-found-variant
function main() returns ExitCode
	var result = 0
	try __ManagedDirectory.openSearch("nonexistent_phaseB_search_xyz/*".toByteArray().managed) otherwise (e) 'h'
		match e 'k'
			notFound then result = 42
			default panic("expected notFound")
		end 'k'
	end 'h'
	return result
end 'main'
---
ExitCode: 42
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rbx, 0
    x64.leaRegRdata r12, [rip + __str_rec_1]
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __arr_create
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r13
    x64.callDirect __str_to_bytes
    x64.movRegReg rcx, r13
    x64.callDirect __md_open_search
    x64.movRegReg r12, r8
    x64.movRegReg r14, r10
    x64.cmpRegImm32 r14, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegReg rcx, r13
    x64.callDirect __arr_decref
    x64.leaRegRegImm32 rax, r14, -1
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm
    x64.jmp matchdefault
  matcharm:
    x64.movRegImm32 r8, 42
    x64.jmp matchcont
  matchcont:
    x64.jmp trycont
  matchdefault:
    x64.leaRegRdata rax, [rip + __str_rec_3]
    x64.movRegImm32 rcx, 134
    x64.movReg32Reg32 rcx, rcx
    x64.iatCall 0
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, r13
    x64.callDirect __arr_decref
    x64.movRegReg rcx, r12
    x64.callDirect __md_destruct
    x64.movRegReg r8, rbx
    x64.jmp trycont
  trycont:
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
