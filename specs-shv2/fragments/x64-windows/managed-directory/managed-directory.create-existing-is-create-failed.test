// Test: managed-directory.create-existing-is-create-failed
function main() returns ExitCode
	let dirPath = "test_md_already_there"
	if not __ManagedDirectory.exists(dirPath.toByteArray().managed) 'needCreate'
		try __ManagedDirectory.create(dirPath.toByteArray().managed) otherwise return 1
	end 'needCreate'
	try __ManagedDirectory.create(dirPath.toByteArray().managed) otherwise (e) 'handler'
		match e 'kind'
			createFailed then return 42
			default panic("expected createFailed")
		end 'kind'
	end 'handler'
	return 2
end 'main'
---
ExitCode: 42
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.leaRegRdata rbx, [rip + __str_rec_1]
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __arr_create
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __str_to_bytes
    x64.movRegReg rcx, r12
    x64.callDirect __md_exists
    x64.movRegReg r13, r8
    x64.xorRegImm32 r13, r8, 1
    x64.movRegReg rcx, r12
    x64.callDirect __arr_decref
    x64.cmpRegImm32 r13, 0
    x64.jcc notEqual, needCreate
    x64.jmp ifcont
  needCreate:
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __arr_create
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __str_to_bytes
    x64.movRegReg rcx, r12
    x64.callDirect __md_create
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegReg rcx, r12
    x64.callDirect __arr_decref
    x64.movRegImm32 r8, 1
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, r12
    x64.callDirect __arr_decref
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __arr_create
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __str_to_bytes
    x64.movRegReg rcx, r12
    x64.callDirect __md_create
    x64.movRegReg rbx, r10
    x64.cmpRegImm32 rbx, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegReg rcx, r12
    x64.callDirect __arr_decref
    x64.leaRegRegImm32 rax, rbx, -1
    x64.cmpRegImm32 rax, 5
    x64.jcc equal, matcharm
    x64.jmp matchdefault
  matcharm:
    x64.movRegImm32 r8, 42
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdefault:
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, r12
    x64.callDirect __arr_decref
    x64.movRegImm32 r8, 2
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchcont:
}
