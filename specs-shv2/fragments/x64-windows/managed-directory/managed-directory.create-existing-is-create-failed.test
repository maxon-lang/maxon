// Test: managed-directory.create-existing-is-create-failed
function main() returns ExitCode
	// The scratch root is shared with every other case here and with every parallel spec
	// worker, so losing the create race is ordinary — see this file's Documentation. It is
	// NOT the subject: the catch-all below is pinned on `dirPath`'s SECOND create.
	let scratchRoot = "temp"
	try __ManagedDirectory.create(scratchRoot.toByteArray().managed) otherwise 'anotherWorkerMadeIt'
		if not __ManagedDirectory.exists(scratchRoot.toByteArray().managed) 'noScratchRoot'
			return 1
		end 'noScratchRoot'
	end 'anotherWorkerMadeIt'

	let dirPath = "temp/test_md_already_there"
	if not __ManagedDirectory.exists(dirPath.toByteArray().managed) 'needCreate'
		try __ManagedDirectory.create(dirPath.toByteArray().managed) otherwise return 1
	end 'needCreate'
	try __ManagedDirectory.create(dirPath.toByteArray().managed) otherwise (e) 'handler'
		match e 'kind'
			createFailed then return 42
			default panic("expected createFailed")
		end 'kind'
	end 'handler'
	return 2
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __gt_run_queue_head@8 = i64 0
  __gt_run_queue_tail@16 = i64 0
  __gt_init_done@24 = i64 0
  __gt_timer_count@32 = i64 0
  __gt_timer_heap_base@40 = i64 0
  __gt_timer_capacity@48 = i64 0
  __gt_trace_counter@56 = i64 0
  __gt_proc_count@64 = i64 0
  __gt_proc_handles_base@72 = i64 0
  __gt_proc_gts_base@80 = i64 0
  __gt_proc_wait_snapshot@88 = i64 0
  __gt_proc_poller@96 = i64 0
  __gt_live_count@104 = i64 0
  __sched_progress@112 = i64 0
  __sched_active_workers@120 = i64 1
  __sched_max_active_workers@128 = i64 1
  __sched_tls_index@136 = i64 0
  __sched_tls_teb_offset@144 = i64 0
  __sched_procs@152 = i64 0
  __sched_allm@160 = i64 0
  __sched_midle@168 = i64 0
  __sched_pidle@176 = i64 0
  __sched_num_procs@184 = i64 0
  __sched_shutdown_flag@192 = i64 0
  __sched_lock@200 = i64 0
  __sched_nmspinning@208 = i64 0
  __sched_parked_drivers@216 = i64 0
  __sched_sysmon_started@224 = i64 0
  __slab_arena_list@232 = i64 0
  __slab_arena_map_l1@240 = i64 0
  __slab_state@248 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.leaRegRdata rbx, [rip + __str_rec_2]  ; "temp"
    x64.movRegReg rcx, rbx
    x64.callDirect String.toByteArray
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.callDirect __md_create
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, trycont
  tryerr#2:
    x64.movRegReg rcx, rbx
    x64.callDirect String.toByteArray
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __md_exists
    x64.movRegReg r13, r8
    x64.xorRegImm32 r13, r8, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r13, 0
    x64.jcc equal, trycont
  noScratchRoot:
    x64.movRegImm32 rbx, 1
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  trycont:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.leaRegRdata rbx, [rip + __str_rec_3]  ; "temp/test_md_already_there"
    x64.movRegReg rcx, rbx
    x64.callDirect String.toByteArray
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.callDirect __md_exists
    x64.movRegReg r13, r8
    x64.xorRegImm32 r13, r8, 1
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r13, 0
    x64.jcc equal, ifcont
  needCreate:
    x64.movRegReg rcx, rbx
    x64.callDirect String.toByteArray
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.callDirect __md_create
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#7
  tryerr#8:
    x64.movRegImm32 rbx, 1
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#7:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
  ifcont:
    x64.movRegReg rcx, rbx
    x64.callDirect String.toByteArray
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __md_create
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#10
  tryerr#11:
    x64.leaRegRegImm32 rax, r10, -1
    x64.cmpRegImm32 rax, 5
    x64.jcc notEqual, matchdefault
  matcharm:
    x64.movRegImm32 r12, 42
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdefault:
    x64.leaRegRdata rcx, [rip + __str_blob_4]  ; "panic at managed-directory.create-existing-is-create-failed.test:20: expected createFailed\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#10:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegImm32 r8, 2
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
