// Test: managed-directory.create-existing-is-create-failed
function main() returns ExitCode
	// The scratch root is shared with every other case here and with every parallel spec
	// worker, so losing the create race is ordinary — see this file's Documentation. It is
	// NOT the subject: the catch-all below is pinned on `dirPath`'s SECOND create.
	let scratchRoot = "temp"
	try __ManagedDirectory.create(scratchRoot.toByteArray().managed) otherwise 'anotherWorkerMadeIt'
		if not __ManagedDirectory.exists(scratchRoot.toByteArray().managed) 'noScratchRoot'
			return 1
		end 'noScratchRoot'
	end 'anotherWorkerMadeIt'

	let dirPath = "temp/test_md_already_there"
	if not __ManagedDirectory.exists(dirPath.toByteArray().managed) 'needCreate'
		try __ManagedDirectory.create(dirPath.toByteArray().managed) otherwise return 1
	end 'needCreate'
	try __ManagedDirectory.create(dirPath.toByteArray().managed) otherwise (e) 'handler'
		match e 'kind'
			createFailed then return 42
			default panic("expected createFailed")
		end 'kind'
	end 'handler'
	return 2
end 'main'
---
ExitCode: 42
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
  __gt_current_gt@24 = i64 0
  __gt_run_queue_head@32 = i64 0
  __gt_run_queue_tail@40 = i64 0
  __gt_init_done@48 = i64 0
  __gt_system_stack_top@56 = i64 0
  __gt_timer_count@64 = i64 0
  __gt_timer_heap_base@72 = i64 0
  __gt_timer_capacity@80 = i64 0
  __gt_trace_counter@88 = i64 0
  __gt_trace_digits@96 = i64 0
  __gt_clock_ticks@104 = i64 0
  __gt_clock_freq@112 = i64 0
  __gt_proc_count@120 = i64 0
  __gt_proc_handles_base@128 = i64 0
  __gt_proc_gts_base@136 = i64 0
  __gt_free_list_head@144 = i64 0
  __gt_live_count@152 = i64 0
  __gt_startup_base@160 = i64 0
  __gt_procinfo_base@168 = i64 0
  __gt_exitcode_base@176 = i64 0
  __gt_cmdline_buf_base@184 = i64 0
  __gt_cmdline_buf_cap@192 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.leaRegRdata rbx, [rip + __str_rec_2]
    x64.movRegReg rcx, rbx
    x64.callDirect String.toByteArray
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.callDirect __md_create
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#2
    x64.jmp tryok#1
  tryerr#2:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect String.toByteArray
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __md_exists
    x64.movRegReg r12, r8
    x64.xorRegImm32 r12, r8, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc notEqual, noScratchRoot
    x64.jmp ifcont#4
  noScratchRoot:
    x64.movRegImm32 r8, 1
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.jmp trycont
  tryok#1:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.jmp trycont
  trycont:
    x64.leaRegRdata rbx, [rip + __str_rec_3]
    x64.movRegReg rcx, rbx
    x64.callDirect String.toByteArray
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.callDirect __md_exists
    x64.movRegReg r13, r8
    x64.xorRegImm32 r13, r8, 1
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r13, 0
    x64.jcc notEqual, needCreate
    x64.jmp ifcont#9
  needCreate:
    x64.movRegReg rcx, rbx
    x64.callDirect String.toByteArray
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.callDirect __md_create
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#8
    x64.jmp tryok#7
  tryerr#8:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegImm32 r8, 1
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#7:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.jmp ifcont#9
  ifcont#9:
    x64.movRegReg rcx, rbx
    x64.callDirect String.toByteArray
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __md_create
    x64.movRegReg r12, r10
    x64.cmpRegImm32 r12, 0
    x64.jcc notEqual, tryerr#11
    x64.jmp tryok#10
  tryerr#11:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.leaRegRegImm32 rax, r12, -1
    x64.cmpRegImm32 rax, 5
    x64.jcc equal, matcharm
    x64.jmp matchdefault
  matcharm:
    x64.movRegImm32 r8, 42
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdefault:
    x64.leaRegRdata rcx, [rip + __str_blob_4]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#10:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegImm32 r8, 2
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchcont:
}

func @String.toByteArray {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg rcx, rbx
    x64.callDirect __str_bytes_view
    x64.movRegReg r12, r8
    x64.movRegImm32 r13, 0
    x64.movRegReg rcx, rbx
    x64.callDirect String.byteLength
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r13
    x64.movRegReg rax, r8
    x64.callDirect __managed_slice
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.leaRegRdata rcx, [rip + __str_blob_5]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_retain
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

