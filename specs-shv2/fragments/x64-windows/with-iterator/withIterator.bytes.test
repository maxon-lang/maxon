// Test: withIterator.bytes
function main() returns ExitCode
	let s = "abc"
	var sum = 0
	for b in s.bytes() 'loop'
		sum = sum + b
	end 'loop'
	print("{sum}\n")
	return 0
end 'main'
---
ExitCode: 0
---
