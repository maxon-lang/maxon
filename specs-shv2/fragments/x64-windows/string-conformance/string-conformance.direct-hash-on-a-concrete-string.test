// Test: string-conformance.direct-hash-on-a-concrete-string
function main() returns ExitCode
	let e = ""
	if e.hash() != 5381 'p1'
		return 1
	end 'p1'
	let a = "abc"
	if a.hash() != 193485963 'p2'
		return 2
	end 'p2'
	let h = "hi"
	if h.hash() != 5863446 'p3'
		return 3
	end 'p3'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_3]
    x64.callDirect String.hash
    x64.cmpRegImm32 r8, 5381
    x64.jcc equal, ifcont#2
  p1:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.leaRegRdata rcx, [rip + __str_rec_4]
    x64.callDirect String.hash
    x64.cmpRegImm32 r8, 193485963
    x64.jcc equal, ifcont#4
  p2:
    x64.movRegImm32 r8, 2
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.leaRegRdata rcx, [rip + __str_rec_5]
    x64.callDirect String.hash
    x64.cmpRegImm32 r8, 5863446
    x64.jcc equal, ifcont#6
  p3:
    x64.movRegImm32 r8, 3
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
