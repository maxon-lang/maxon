// Test: string-conformance.direct-hash-on-a-concrete-string
function main() returns ExitCode
	let e = ""
	if e.hash() != 5381 'p1'
		return 1
	end 'p1'
	let a = "abc"
	if a.hash() != 193485963 'p2'
		return 2
	end 'p2'
	let h = "hi"
	if h.hash() != 5863446 'p3'
		return 3
	end 'p3'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_1]
    x64.callDirect String.hash
    x64.cmpRegImm32 r8, 5381
    x64.jcc notEqual, p1
    x64.jmp ifcont
  p1:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.leaRegRdata rcx, [rip + __str_rec_3]
    x64.callDirect String.hash
    x64.cmpRegImm32 r8, 193485963
    x64.jcc notEqual, p2
    x64.jmp ifcont
  p2:
    x64.movRegImm32 r8, 2
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.leaRegRdata rcx, [rip + __str_rec_5]
    x64.callDirect String.hash
    x64.cmpRegImm32 r8, 5863446
    x64.jcc notEqual, p3
    x64.jmp ifcont
  p3:
    x64.movRegImm32 r8, 3
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @String.hash {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 8]
    x64.movRegImm32 rdx, 5381
    x64.movRegImm32 rsi, 0
    x64.jmp header
  header:
    x64.cmpRegReg rsi, rcx
    x64.jcc greaterEqual, done
    x64.jmp body
  done:
    x64.movRegImm32 rax, 4294967295
    x64.movRegReg r8, rdx
    x64.andRegReg r8, rdx, rax
    x64.popReg rbp
    x64.ret
  body:
    x64.leaRegRegReg rdi, rax, rsi
    x64.loadRegBaseDisp.byte rdi, [rdi + 0]
    x64.movRegImm32 r8, 33
    x64.imulRegReg rdx, rdx, r8
    x64.leaRegRegReg rdx, rdx, rdi
    x64.movRegImm32 rdi, 1
    x64.leaRegRegReg rsi, rsi, rdi
    x64.jmp header
}
