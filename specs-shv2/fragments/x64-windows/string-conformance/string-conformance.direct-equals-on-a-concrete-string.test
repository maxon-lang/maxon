// Test: string-conformance.direct-equals-on-a-concrete-string
function main() returns ExitCode
	let a = "ab"
	if not a.equals("ab") 'same'
		return 1
	end 'same'
	if a.equals("ac") 'differentByte'
		return 2
	end 'differentByte'
	if a.equals("abc") 'differentLength'
		return 3
	end 'differentLength'
	if not "".equals("") 'bothEmpty'
		return 4
	end 'bothEmpty'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.leaRegRdata rbx, [rip + __str_rec_4]
    x64.leaRegRdata rdx, [rip + __str_rec_4]
    x64.movRegReg rcx, rbx
    x64.callDirect String.equals
    x64.xorRegImm32 r8, r8, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, same
    x64.jmp ifcont#2
  same:
    x64.movRegImm32 r8, 1
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.leaRegRdata rdx, [rip + __str_rec_5]
    x64.movRegReg rcx, rbx
    x64.callDirect String.equals
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, differentByte
    x64.jmp ifcont#4
  differentByte:
    x64.movRegImm32 r8, 2
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.leaRegRdata rdx, [rip + __str_rec_6]
    x64.movRegReg rcx, rbx
    x64.callDirect String.equals
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, differentLength
    x64.jmp ifcont#6
  differentLength:
    x64.movRegImm32 r8, 3
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.leaRegRdata rcx, [rip + __str_rec_7]
    x64.leaRegRdata rdx, [rip + __str_rec_7]
    x64.callDirect String.equals
    x64.xorRegImm32 r8, r8, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, bothEmpty
    x64.jmp ifcont#8
  bothEmpty:
    x64.movRegImm32 r8, 4
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#8:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
