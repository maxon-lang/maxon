// Test: string-conformance.direct-equals-on-a-concrete-string
function main() returns ExitCode
	let a = "ab"
	if not a.equals("ab") 'same'
		return 1
	end 'same'
	if a.equals("ac") 'differentByte'
		return 2
	end 'differentByte'
	if a.equals("abc") 'differentLength'
		return 3
	end 'differentLength'
	if not "".equals("") 'bothEmpty'
		return 4
	end 'bothEmpty'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.leaRegRdata rbx, [rip + __str_rec_1]
    x64.leaRegRdata rdx, [rip + __str_rec_1]
    x64.movRegReg rcx, rbx
    x64.callDirect String.equals
    x64.xorRegImm32 r8, r8, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, same
    x64.jmp ifcont
  same:
    x64.movRegImm32 r8, 1
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.leaRegRdata rdx, [rip + __str_rec_3]
    x64.movRegReg rcx, rbx
    x64.callDirect String.equals
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, differentByte
    x64.jmp ifcont
  differentByte:
    x64.movRegImm32 r8, 2
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.leaRegRdata rdx, [rip + __str_rec_5]
    x64.movRegReg rcx, rbx
    x64.callDirect String.equals
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, differentLength
    x64.jmp ifcont
  differentLength:
    x64.movRegImm32 r8, 3
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.leaRegRdata rcx, [rip + __str_rec_7]
    x64.leaRegRdata rdx, [rip + __str_rec_7]
    x64.callDirect String.equals
    x64.xorRegImm32 r8, r8, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, bothEmpty
    x64.jmp ifcont
  bothEmpty:
    x64.movRegImm32 r8, 4
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @String.equals {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.loadRegBaseDisp.word64 rsi, [rdx + 8]
    x64.cmpRegReg rax, rsi
    x64.jcc equal, lenMatch
    x64.jmp notEqual
  lenMatch:
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.loadRegBaseDisp.word64 rdx, [rdx + 0]
    x64.movRegImm32 rsi, 0
    x64.jmp cmphdr
  cmphdr:
    x64.cmpRegReg rsi, rax
    x64.jcc greaterEqual, allMatch
    x64.jmp cmpbody
  allMatch:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  cmpbody:
    x64.leaRegRegReg rdi, rcx, rsi
    x64.loadRegBaseDisp.byte rdi, [rdi + 0]
    x64.leaRegRegReg r8, rdx, rsi
    x64.loadRegBaseDisp.byte r8, [r8 + 0]
    x64.movRegImm32 r9, 1
    x64.leaRegRegReg rsi, rsi, r9
    x64.cmpRegReg rdi, r8
    x64.jcc equal, critsplit
    x64.jmp notEqual
  critsplit:
    x64.jmp cmphdr
  notEqual:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
