// Test: file-info.not-found
function main() returns ExitCode
	let fi = try File.info(FilePath from "nonexistent_fi_xyz.txt") otherwise 'e'
		print("not found")
		return 42
	end 'e'
	print("unexpected: size={fi.size}")
	return 0
end 'main'
