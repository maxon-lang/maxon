    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.leaRegRdata rcx, [rip + __str_rec_20]  ; "test_fi_dir"
    x64.callDirect FilePath.init
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect Directory.create
    x64.movRegReg rcx, rbx
    x64.callDirect File.info
    x64.movRegReg r12, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_rec_21]  ; "info failed"
    x64.callDirect print
    x64.movRegImm32 r12, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_FilePath
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.loadRegBaseDisp.byte rax, [r12 + 32]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, ifcont
  dc:
    x64.leaRegRdata rcx, [rip + __str_rec_22]  ; "expected directory"
    x64.callDirect print
