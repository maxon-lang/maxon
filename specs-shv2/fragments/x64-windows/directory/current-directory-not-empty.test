  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.callDirect Directory.currentPath
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect FilePath.toString
