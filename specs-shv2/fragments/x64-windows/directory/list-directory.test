func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_20]  ; "../bin"
    x64.callDirect FilePath.init
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect Directory.list
    x64.movRegReg r12, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_FilePath
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_FilePath
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 r13, 0
  forhdr:
    x64.loadRegBaseDisp.word64 rax, [r12 + 8]
    x64.cmpRegReg r13, rax
    x64.jcc greaterEqual, forexit
  loop:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.loadRegBaseIndexScale.word64 rcx, [rax + r13*8 + 0]
  __im_cont:
    x64.callDirect FilePath.filename
    x64.movRegReg r14, r8
    x64.leaRegRdata rdx, [rip + __str_rec_21]  ; "maxon.exe"
    x64.movRegReg rcx, r14
    x64.callDirect __str_eq
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, scmerge
  orrhs:
    x64.leaRegRdata rdx, [rip + __str_rec_22]  ; "maxon"
    x64.movRegReg rcx, r14
    x64.callDirect __str_eq
    x64.movRegReg rax, r8
  scmerge:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont#10
  check:
    x64.movRegImm32 rbx, 1
  ifcont#10:
    x64.movRegReg rcx, r14
    x64.callDirect __str_decref
  forstep:
    x64.leaRegRegImm32 r13, r13, 1
    x64.jmp forhdr
  forexit:
    x64.cmpRegImm32 rbx, 0
    x64.jcc equal, ifcont#12
  result:
    x64.movRegImm32 rbx, 42
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#12:
