// Test: error.return-wrong-union
typealias Integer = int(i64.min to i64.max)

union Shape
	circle(r Integer)
	square(s Integer)
end 'Shape'

union Palette
	red
	blue
end 'Palette'

function bad() returns Shape
	return Palette.red
end 'bad'

function main() returns ExitCode
	let s = bad()
	return 0 as ExitCode
end 'main'
---
CompilerError:
error E3005: <fragment>:15:2: Cannot return 'Palette' from function declared to return 'Shape'
