// Test: set-contains
function main() returns ExitCode
	let s = Set from [1, 2, 3, 4, 5]
	if s.contains(3) 'check'
		print("found\n")
	end 'check'
	if s.contains(99) 'check2'
		print("not found\n")
	end 'check2'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rbx, 1
    x64.leaRegRdata rcx, [rip + __layout_Set_int]
    x64.leaRegRdata rdx, [rip + __witness_int.Hashable]
    x64.leaRegRdata rax, [rip + __witness_int.Equatable]
    x64.callDirect Set.create
    x64.movRegReg r12, r8
    x64.leaRegRdata rax, [rip + __layout_Set_int]
    x64.leaRegRdata r9, [rip + __witness_int.Hashable]
    x64.leaRegRdata rsi, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect Set.insert
    x64.movRegImm32 rdx, 2
    x64.leaRegRdata rax, [rip + __layout_Set_int]
    x64.leaRegRdata r9, [rip + __witness_int.Hashable]
    x64.leaRegRdata rsi, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, r12
    x64.callDirect Set.insert
    x64.movRegImm32 rdx, 3
    x64.leaRegRdata rax, [rip + __layout_Set_int]
    x64.leaRegRdata r9, [rip + __witness_int.Hashable]
    x64.leaRegRdata rsi, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, r12
    x64.callDirect Set.insert
    x64.movRegImm32 rdx, 4
    x64.leaRegRdata rax, [rip + __layout_Set_int]
    x64.leaRegRdata r9, [rip + __witness_int.Hashable]
    x64.leaRegRdata rsi, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, r12
    x64.callDirect Set.insert
    x64.movRegImm32 rdx, 5
    x64.leaRegRdata rax, [rip + __layout_Set_int]
    x64.leaRegRdata r9, [rip + __witness_int.Hashable]
    x64.leaRegRdata rsi, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, r12
    x64.callDirect Set.insert
    x64.movRegImm32 rdx, 3
    x64.leaRegRdata rax, [rip + __layout_Set_int]
    x64.leaRegRdata r9, [rip + __witness_int.Hashable]
    x64.leaRegRdata rsi, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, r12
    x64.callDirect Set.contains
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#2
  check:
    x64.leaRegRdata rcx, [rip + __str_rec_2]  ; "found\x0a"
    x64.callDirect print
  ifcont#2:
    x64.movRegImm32 rdx, 99
    x64.leaRegRdata rax, [rip + __layout_Set_int]
    x64.leaRegRdata r9, [rip + __witness_int.Hashable]
    x64.leaRegRdata rsi, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, r12
    x64.callDirect Set.contains
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#4
  check2:
    x64.leaRegRdata rcx, [rip + __str_rec_3]  ; "not found\x0a"
    x64.callDirect print
  ifcont#4:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Set_int
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
