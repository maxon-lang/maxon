// Test: directives.top-level-branches
#if testing(false)
	function pick() returns ExitCode
		return 21
	end 'pick'
#else
	function pick() returns ExitCode
		return 99
	end 'pick'
#endif

function main() returns ExitCode
	return pick()
end 'main'
---
ExitCode: 21
---
func @pick {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 21
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect pick
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
