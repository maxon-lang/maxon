// Test: field-defaults.opaque-array-default-two-type-params
typealias Count = int(0 to u64.max)

type Pairs uses Key, Value
	typealias KeyArray = Array with Key
	typealias ValueArray = Array with Value
	var keys as KeyArray = KeyArray.create()
	var values as ValueArray = ValueArray.create()
	var seen = 0

	export static function create() returns Self
		return Self{}
	end 'create'

	export function add(key Key, value Value)
		keys.push(key)
		values.push(value)
		seen = seen + 1
	end 'add'

	export function size() returns Count
		return seen
	end 'size'
end 'Pairs'

typealias Integer = int(i64.min to i64.max)
typealias IntPairs = Pairs with (Integer, Integer)

function main() returns ExitCode
	var p = IntPairs.create()
	p.add(1, value: 5)
	p.add(2, value: 6)
	p.add(3, value: 7)
	return p.size()
end 'main'
---
ExitCode: 3
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Pairs.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg rcx, rbx
    x64.callDirect __fieldDefault#Pairs#keys
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __fieldDefault#Pairs#values
    x64.movRegReg rbx, r8
    x64.movRegImm32 r13, 0
    x64.movRegImm32 rcx, 24
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], r12
    x64.storeBaseDispReg.word64 [r8 + 8], rbx
    x64.storeBaseDispReg.word64 [r8 + 16], r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Pairs.add {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rax
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.callDirect __managed_push
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
    x64.movRegReg rdx, r12
    x64.callDirect __managed_push
    x64.loadRegBaseDisp.word64 rax, [rbx + 16]
    x64.leaRegRegImm32 rax, rax, 1
    x64.storeBaseDispReg.word64 [rbx + 16], rax
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __layout_Pairs_Integer_Integer]
    x64.callDirect Pairs.create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 1
    x64.movRegImm32 rax, 5
    x64.leaRegRdata r9, [rip + __layout_Pairs_Integer_Integer]
    x64.movRegReg rcx, rbx
    x64.callDirect Pairs.add
    x64.movRegImm32 rdx, 2
    x64.movRegImm32 rax, 6
    x64.leaRegRdata r9, [rip + __layout_Pairs_Integer_Integer]
    x64.movRegReg rcx, rbx
    x64.callDirect Pairs.add
    x64.movRegImm32 rdx, 3
    x64.movRegImm32 rax, 7
    x64.leaRegRdata r9, [rip + __layout_Pairs_Integer_Integer]
    x64.movRegReg rcx, rbx
    x64.callDirect Pairs.add
  __il_body:
    x64.loadRegBaseDisp.word64 r12, [rbx + 16]
  __il_cont:
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Pairs_Integer_Integer
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @__fieldDefault#Pairs#keys {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 8
    x64.loadRegBaseDisp.word64 rdx, [rcx + 40]
    x64.movRegReg rcx, rax
    x64.callDirect __managed_create
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @__fieldDefault#Pairs#values {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 8
    x64.loadRegBaseDisp.word64 rdx, [rcx + 112]
    x64.movRegReg rcx, rax
    x64.callDirect __managed_create
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
