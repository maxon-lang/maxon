// Test: field-defaults.two-type-params-with-the-managed-column-second
typealias Count = int(0 to u64.max)
typealias Integer = int(i64.min to i64.max)

type Pairs uses Key, Value
	typealias KeyArray = Array with Key
	typealias ValueArray = Array with Value
	var keys as KeyArray = KeyArray.create()
	var values as ValueArray = ValueArray.create()

	export static function create() returns Self
		return Self{}
	end 'create'

	export function add(key Key, value Value)
		keys.push(key)
		values.push(value)
	end 'add'

	export function size() returns Count
		return values.count()
	end 'size'
end 'Pairs'

typealias IntStrPairs = Pairs with (Integer, String)

function main() returns ExitCode
	var p = IntStrPairs.create()
	p.add(1, value: "alpha")
	p.add(2, value: "beta")
	p.add(3, value: "gamma")
	return p.size()
end 'main'
---
ExitCode: 3
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Pairs.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegReg rcx, rbx
    x64.callDirect __fieldDefault#Pairs#keys
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __fieldDefault#Pairs#values
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], r12
    x64.storeBaseDispReg.word64 [r8 + 8], rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Pairs.add {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rax
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.callDirect __managed_push
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
    x64.movRegReg rdx, r12
    x64.callDirect __managed_push
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Pairs.size {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.loadRegBaseDisp.word64 r8, [rax + 8]
    x64.popReg rbp
    x64.ret
}

