// Test: managed-socket.connect-refused
function main() returns ExitCode
	let host = "192.0.2.1"
	try __ManagedSocket.tcpConnect(host.toByteArray().managed, port: 1) otherwise (e) 'connErr'
		match e 'check'
			connectFailed then print("connect failed")
			default panic("unreachable: tcpConnect reports only resolveFailed or connectFailed")
		end 'check'
		return 42
	end 'connErr'
	return 0
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __gt_current_gt@8 = i64 0
  __gt_run_queue_head@16 = i64 0
  __gt_run_queue_tail@24 = i64 0
  __gt_init_done@32 = i64 0
  __gt_system_stack_top@40 = i64 0
  __gt_timer_count@48 = i64 0
  __gt_timer_heap_base@56 = i64 0
  __gt_timer_capacity@64 = i64 0
  __gt_trace_counter@72 = i64 0
  __gt_trace_digits@80 = i64 0
  __gt_clock_ticks@88 = i64 0
  __gt_clock_freq@96 = i64 0
  __gt_proc_count@104 = i64 0
  __gt_proc_handles_base@112 = i64 0
  __gt_proc_gts_base@120 = i64 0
  __gt_live_count@128 = i64 0
  __slab_arena_list@136 = i64 0
  __slab_arena_map_l1@144 = i64 0
  __slab_state@152 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_2]
    x64.callDirect String.toByteArray
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __ms_tcp_connect
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRegImm32 rax, r10, -1
    x64.cmpRegImm32 rax, 2
    x64.jcc equal, matcharm
    x64.jmp matchdefault
  matcharm:
    x64.leaRegRdata rcx, [rip + __str_rec_3]
    x64.callDirect print
    x64.jmp matchcont
  matchcont:
    x64.movRegImm32 r12, 42
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdefault:
    x64.leaRegRdata rcx, [rip + __str_blob_4]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, r8
    x64.callDirect __ms_destruct
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @print {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __write_stdout
    x64.epilogue 32
    x64.popReg rbp
