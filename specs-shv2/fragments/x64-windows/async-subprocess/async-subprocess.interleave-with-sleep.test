// Test: async-subprocess.interleave-with-sleep
var order = 0

function slow() returns int
	_ = try __Builtins.runProcess("cmd /c ping -n 2 127.0.0.1 >nul") otherwise 99
	order = order * 10 + 1
	return 1
end 'slow'

function fast() returns int
	sleep(50)
	order = order * 10 + 2
	return 2
end 'fast'

function main() returns ExitCode
	let p1 = async slow()
	let p2 = async fast()
	_ = await p1
	_ = await p2
	return order as ExitCode
end 'main'
---
ExitCode: 21
---
data {
  __data_order@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __gt_current_gt@16 = i64 0
  __gt_run_queue_head@24 = i64 0
  __gt_run_queue_tail@32 = i64 0
  __gt_init_done@40 = i64 0
  __gt_system_stack_top@48 = i64 0
  __gt_timer_count@56 = i64 0
  __gt_timer_heap_base@64 = i64 0
  __gt_timer_capacity@72 = i64 0
  __gt_trace_counter@80 = i64 0
  __gt_trace_digits@88 = i64 0
  __gt_clock_ticks@96 = i64 0
  __gt_clock_freq@104 = i64 0
  __gt_proc_count@112 = i64 0
  __gt_proc_handles_base@120 = i64 0
  __gt_proc_gts_base@128 = i64 0
  __gt_live_count@136 = i64 0
  __slab_arena_list@144 = i64 0
  __slab_arena_map_l1@152 = i64 0
  __slab_state@160 = i64 0
}

func @slow {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_1]
    x64.callDirect __gt_process_run
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.jmp trycont
  tryok:
    x64.jmp trycont
  trycont:
    x64.leaRegGlobal rax, __data_order
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.imulRegRegImm32 rax, rax, 10
    x64.leaRegRegImm32 rax, rax, 1
    x64.leaRegGlobal rcx, __data_order
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @fast {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 50
    x64.callDirect sleep
    x64.leaRegGlobal rax, __data_order
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.imulRegRegImm32 rax, rax, 10
    x64.leaRegRegImm32 rax, rax, 2
    x64.leaRegGlobal rcx, __data_order
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 r8, 2
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegFunc rcx, [rip + slow]
    x64.callDirect __gt_spawn
    x64.movRegReg rbx, r8
    x64.leaRegFunc rcx, [rip + fast]
    x64.callDirect __gt_spawn
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __gt_await
    x64.movRegReg rcx, r12
    x64.callDirect __gt_await
    x64.leaRegGlobal rax, __data_order
    x64.loadRegBaseDisp.word64 r8, [rax + 0]
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @sleep {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __gt_sleep
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
