// Test: async-subprocess.spawn-loop
function child() returns Integer
	return try __Builtins.runProcess("cmd /c exit 1") otherwise 99
end 'child'

function main() returns ExitCode
	var i = 0
	var sum = 0
	while i < 25 'l'
		let p = async child()
		let r = await p
		sum = sum + r
		i = i + 1
	end 'l'
	return sum as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 25
---
data {
  __mm_alloc_count@0 = i64 0
  __gt_run_queue_head@8 = i64 0
  __gt_run_queue_tail@16 = i64 0
  __gt_init_done@24 = i64 0
  __gt_timer_count@32 = i64 0
  __gt_timer_heap_base@40 = i64 0
  __gt_timer_capacity@48 = i64 0
  __gt_trace_counter@56 = i64 0
  __gt_proc_count@64 = i64 0
  __gt_proc_handles_base@72 = i64 0
  __gt_proc_gts_base@80 = i64 0
  __gt_proc_wait_snapshot@88 = i64 0
  __gt_proc_poller@96 = i64 0
  __gt_live_count@104 = i64 0
  __sched_progress@112 = i64 0
  __sched_active_workers@120 = i64 1
  __sched_max_active_workers@128 = i64 1
  __sched_tls_index@136 = i64 0
  __sched_tls_teb_offset@144 = i64 0
  __sched_procs@152 = i64 0
  __sched_num_procs@160 = i64 0
  __sched_shutdown_flag@168 = i64 0
  __sched_lock@176 = i64 0
  __sched_nmspinning@184 = i64 0
  __sched_parked_drivers@192 = i64 0
  __slab_arena_list@200 = i64 0
  __slab_arena_map_l1@208 = i64 0
  __slab_state@216 = i64 0
}

func @child {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_1]  ; "cmd /c exit 1"
    x64.callDirect __gt_process_run
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, trycont
  tryerr:
    x64.movRegImm32 r8, 99
  trycont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 r12, 0
  whilehdr:
    x64.cmpRegImm32 rbx, 25
    x64.jcc greaterEqual, whileexit
  l:
    x64.leaRegFunc rcx, [rip + child]
    x64.callDirect __gt_spawn
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r13
    x64.callDirect __gt_ready
    x64.movRegReg rcx, r13
    x64.callDirect __gt_await
    x64.leaRegRegReg r12, r12, r8
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp whilehdr
  whileexit:
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at async-subprocess.spawn-loop.test:15: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
