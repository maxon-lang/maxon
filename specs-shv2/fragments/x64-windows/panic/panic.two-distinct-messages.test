// Test: panic.two-distinct-messages
typealias Integer = int(i64.min to i64.max)

function runA(n Integer) returns Integer
	if n < 0 'a'
		panic("message A")
	end 'a'
	return n
end 'runA'

function runB(n Integer) returns Integer
	if n < 0 'b'
		panic("message B")
	end 'b'
	return n
end 'runB'

function main() returns ExitCode
	let a = runA(1)  // does not panic
	let b = runB(-1) // should print "message B"
	return a + b
end 'main'
---
ExitCode: 1
---
func @runB {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc greaterEqual, ifcont
  b:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at panic.two-distinct-messages.test:13: message B\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegReg r8, rcx
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 1
  __il_cont#5:
    x64.movRegImm rcx, 18446744073709551615
  __il_slow:
    x64.callDirect runB
  __il_cont#4:
    x64.leaRegRegReg r8, rbx, r8
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at panic.two-distinct-messages.test:21: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
