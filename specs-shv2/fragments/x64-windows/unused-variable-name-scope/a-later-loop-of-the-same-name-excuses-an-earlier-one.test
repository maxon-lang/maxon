// Test: a-later-loop-of-the-same-name-excuses-an-earlier-one
function main() returns ExitCode
	var total = 0
	for i in 0 upto 3 'a'
		total = total + 1
	end 'a'
	for i in 0 upto 3 'b'
		total = total + i
	end 'b'
	return total
end 'main'
---
ExitCode: 6
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 0
  forhdr#1:
    x64.cmpRegImm32 rcx, 3
    x64.jcc greaterEqual, forexit#4
  a:
    x64.leaRegRegImm32 rax, rax, 1
  forstep#3:
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.jmp forhdr#1
  forexit#4:
    x64.movRegImm32 rcx, 0
    x64.movRegReg r8, rax
  forhdr#5:
    x64.cmpRegImm32 rcx, 3
    x64.jcc greaterEqual, forexit#8
  b:
    x64.leaRegRegReg r8, r8, rcx
  forstep#7:
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.jmp forhdr#5
  forexit#8:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
