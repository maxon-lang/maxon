// Test: cross-file-enum-case-is-a-reference
// --- file: api/color.maxon
export enum Color
	red
	green
	blue
end 'Color'

// --- file: app/main.maxon
function main() returns ExitCode
	let c = Color.blue
	match c 'check'
		blue then return 42
		red then return 0
		green then return 0
	end 'check'
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 2
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#2
    x64.jmp matchnext#5
  matcharm#2:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  matchnext#5:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm#3
    x64.jmp matchnext#6
  matcharm#3:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  matchnext#6:
    x64.cmpRegImm32 rax, 2
    x64.jcc equal, matcharm#1
    x64.jmp matchdead
  matcharm#1:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
  matchdead:
  matchcont:
}
