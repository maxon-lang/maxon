// Test: error.compiler-reserved-base-type-is-not-undeclared

function hasIt(s CharacterSet, c Character) returns bool
	return s.contains(c)
end 'hasIt'

function main() returns ExitCode
	return 0
end 'main'
---
CompilerError:
error E2015: <fragment>:4:11: Unsupported: a member access 'contains' on a 'int' value — only a struct, a generic instance and the byte records (`String`, `Character`) carry members here
