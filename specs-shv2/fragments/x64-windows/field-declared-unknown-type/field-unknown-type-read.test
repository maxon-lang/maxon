// Test: field-unknown-type-read

type Value
	export var n as Nonexistent

	static function create() returns Self
		return Value{n: 7}
	end 'create'
end 'Value'

function main() returns ExitCode
	let v = Value.create()
	return v.n
end 'main'
---
CompilerError:
error E3011: Unknown type 'Nonexistent'
