    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 r8, 42
    x64.jmp trycont
  tryok:
    x64.jmp trycont
  trycont:
    x64.epilogue 40
    x64.popReg rbx
