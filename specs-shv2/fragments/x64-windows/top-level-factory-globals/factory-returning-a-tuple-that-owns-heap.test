// Test: factory-returning-a-tuple-that-owns-heap
typealias Num = int(0 to 1000)
typealias Tagged = (String, Num)

type Maker
	static function build() returns Tagged
		return ("hi", 7)
	end 'build'
end 'Maker'

var a = Maker.build()

function main() returns ExitCode
	print("{a.0} {a.1}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_a@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @Maker.build {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.leaRegRdata rbx, [rip + __str_rec_3]
    x64.movRegImm32 r12, 7
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r13 + 0], r8
    x64.storeBaseDispReg.word64 [r13 + 8], r12
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

