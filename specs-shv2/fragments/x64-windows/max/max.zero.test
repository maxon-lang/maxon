// Test: max.zero
function main() returns ExitCode
	let x = max(0.0, -5.0)
	if x == 0.0 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movsdRegRip xmm0, [rip + __fconst_0]
    x64.movsdRegRip xmm1, [rip + __fconst_1]
    x64.maxsd xmm0, xmm0, xmm1
    x64.movsdRegRip xmm1, [rip + __fconst_0]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc parity, ifcont
  fordered:
    x64.jcc notEqual, ifcont
  check:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}
