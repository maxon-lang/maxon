// Test: max.equal-values
function main() returns ExitCode
	let x = max(7.0, 7.0)
	return trunc(x)
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movsdRegRip xmm0, [rip + __fconst_0]
    x64.movsdRegRip xmm1, [rip + __fconst_0]
    x64.maxsd xmm0, xmm0, xmm1
    x64.cvttsd2siRegReg r8, xmm0
    x64.popReg rbp
    x64.ret
}
