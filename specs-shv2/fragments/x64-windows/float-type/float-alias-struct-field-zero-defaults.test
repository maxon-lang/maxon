// Test: float-alias-struct-field-zero-defaults

typealias Weight = float(f64.min to f64.max)

type Particle
	export var mass as Weight = 0
	export var vel as Weight = 0.0

	export static function make() returns Self
		return Self{}
	end 'make'
end 'Particle'

function main() returns ExitCode
	let p = Particle.make()
	if p.mass == 0.0 'zeroMass'
		if p.vel == 0.0 'zeroVel'
			return trunc((p.mass + p.vel + 4.2) * 10.0)
		end 'zeroVel'
	end 'zeroMass'
	return 7
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.leaRegSlot rax, slot0
    x64.movsdRegRip xmm0, [rip + __fconst_1]
    x64.storeBaseDispReg.word64 [rax + 0], xmm0
    x64.movsdRegRip xmm0, [rip + __fconst_1]
    x64.storeBaseDispReg.word64 [rax + 8], xmm0
    x64.loadRegBaseDisp.word64 xmm0, [rax + 0]
    x64.movsdRegRip xmm1, [rip + __fconst_1]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc parity, ifcont#4
    x64.jmp fordered#8
  fordered#8:
    x64.jcc equal, zeroMass
    x64.jmp ifcont#4
  zeroMass:
    x64.loadRegBaseDisp.word64 xmm0, [rax + 8]
    x64.movsdRegRip xmm1, [rip + __fconst_1]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc parity, ifcont#3
    x64.jmp fordered#9
  fordered#9:
    x64.jcc equal, zeroVel
    x64.jmp ifcont#3
  zeroVel:
    x64.loadRegBaseDisp.word64 xmm0, [rax + 0]
    x64.loadRegBaseDisp.word64 xmm1, [rax + 8]
    x64.addsdRegReg xmm0, xmm0, xmm1
    x64.movsdRegRip xmm1, [rip + __fconst_2]
    x64.addsdRegReg xmm0, xmm0, xmm1
    x64.movsdRegRip xmm1, [rip + __fconst_3]
    x64.mulsdRegReg xmm0, xmm0, xmm1
    x64.cvttsd2siRegReg r8, xmm0
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
  ifcont#3:
    x64.jmp ifcont#4
  ifcont#4:
    x64.movRegImm32 r8, 7
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}
