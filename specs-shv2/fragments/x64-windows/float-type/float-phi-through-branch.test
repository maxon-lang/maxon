// Test: float-phi-through-branch
function work(a int) returns int
	var f = a + 0.0
	if a > 5 'gt'
		f = f + 1.5
	end 'gt'
	return trunc(f)
end 'work'

function main() returns ExitCode
	return work(19)
end 'main'
---
ExitCode: 20
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 19
    x64.jmp __il_body
  __il_body:
    x64.movsdRegRip xmm0, [rip + __fconst_1]
    x64.cvtsi2sdRegReg xmm1, rax
    x64.addsdRegReg xmm1, xmm1, xmm0
    x64.cmpRegImm32 rax, 5
    x64.jcc greater, gt
    x64.jmp critsplit
  gt:
    x64.movsdRegRip xmm0, [rip + __fconst_2]
    x64.addsdRegReg xmm1, xmm1, xmm0
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.cvttsd2siRegReg r8, xmm1
    x64.jmp __il_cont
  __il_cont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
