// Test: iterating-a-string-locks-its-source
function main() returns ExitCode
	var s = "abcdefgh"
	var n = 0
	for c in s 'each'
		n = n + 1 if c == c else n
		if n == 2 'swap'
			s = "z"
		end 'swap'
	end 'each'
	print("{n}\n")
	return 0
end 'main'
---
CompilerError:
error E2013: <fragment>:8:4: cannot assign to immutable variable: 's'
