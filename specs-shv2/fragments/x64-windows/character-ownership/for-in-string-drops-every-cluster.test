// Test: for-in-string-drops-every-cluster
function fallthroughTrips(s String) returns Integer
	var n = 0
	for c in s 'a'
		n = n + 1 if c == c else n
	end 'a'
	return n
end 'fallthroughTrips'

function continueTrips(s String) returns Integer
	var n = 0
	for c in s 'b'
		n = n + 1 if c == c else n
		if n > 0 'always'
			continue
		end 'always'
	end 'b'
	return n
end 'continueTrips'

function breakTrips(s String) returns Integer
	var n = 0
	for c in s 'd'
		n = n + 1 if c == c else n
		if n == 2 'stop'
			break
		end 'stop'
	end 'd'
	return n
end 'breakTrips'

function returnFromLoop(s String) returns Integer
	var n = 0
	for c in s 'e'
		n = n + 1 if c == c else n
		if n == 3 'out'
			return n
		end 'out'
	end 'e'
	return n
end 'returnFromLoop'

function discardTrips(s String) returns Integer
	var n = 0
	for _ in s 'f'
		n = n + 1
	end 'f'
	return n
end 'discardTrips'

function main() returns ExitCode
	let s = "aé中!xéy"
	var total = 0
	var i = 0
	while i < 200 'rep'
		total = total + fallthroughTrips(s) + continueTrips(s) + breakTrips(s) + returnFromLoop(s) + discardTrips(s)
		i = i + 1
	end 'rep'
	if total != 5200 'wrongTotal'
		return 1
	end 'wrongTotal'
	return 0
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @fallthroughTrips {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegImm32 r12, 0
    x64.movRegImm32 r13, 0
  forhdr:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegReg r13, rax
    x64.jcc greaterEqual, forexit
  a:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect findGraphemeEnd
    x64.movRegReg r14, r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.movRegReg rax, r14
    x64.callDirect __char_at
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r13
    x64.callDirect __str_eq
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, matchcont
  ternarytrue:
    x64.leaRegRegImm32 r12, r12, 1
  matchcont:
    x64.movRegReg rcx, r13
    x64.callDirect __str_decref
  forstep:
    x64.movRegReg r13, r14
    x64.jmp forhdr
  forexit:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

