// Test: pre-loop-borrow-then-loop-consume
typealias Integer = int(i64.min to i64.max)
typealias ItemArray = Array with Integer

interface Payload
	function tag() returns Integer
end 'Payload'

type Desc implements Payload
	export var v as Integer

	export static function create(x Integer) returns Desc
		return Self{v: x}
	end 'create'

	export function tag() returns Integer
		return self.v
	end 'tag'
end 'Desc'

// Consumes `p` by storing it; destroyed at scope end.
type Holder
	export var p as Payload

	export static function create(p Payload) returns Holder
		return Holder{p: p}
	end 'create'

	export function run() returns Integer
		return self.p.tag()
	end 'run'
end 'Holder'

// Non-inlined BORROW of `p` (mirrors collectFuncsNeedingRegalloc(regTarget)).
function borrowCount(p Payload, base Integer) returns Integer
	var acc = base
	for _ in 0 upto 2 'r'
		acc = acc + p.tag()
	end 'r'
	return acc
end 'borrowCount'

// Consumes `p` (mirrors allocateRegistersForFunc storing into FunctionRegAllocator).
function forFunc(item Integer, p Payload) returns Integer
	var h = Holder.create(p)
	return h.run() + item
end 'forFunc'

// Pre-loop borrow + early-return guard + per-item loop consume
// (mirrors allocateRegistersWithTarget).
function withTarget(items ItemArray, p Payload) returns Integer
	let n = borrowCount(p, base: items.count())
	if n == 0 'empty'
		return 0
	end 'empty'

	var total = 0
	for item in items 'each'
		total = total + forFunc(item, p: p)
	end 'each'
	return total + n
end 'withTarget'

function withX64(items ItemArray) returns Integer
	let p = Desc.create(5)
	return withTarget(items, p: p)
end 'withX64'

function main() returns ExitCode
	var items = ItemArray.create()
	items.push(1)
	items.push(2)
	items.push(3)
	return withX64(items)
end 'main'
---
ExitCode: 34
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Desc.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Desc.tag {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 r8, [rcx + 0]
    x64.popReg rbp
    x64.ret
}

func @Holder.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect __retain_existential
    x64.storeBaseDispReg.word64 [r13 + 0], r8
    x64.storeBaseDispReg.word64 [r13 + 8], r12
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect __drop_existential
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Holder.run {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.word64 rbx, [rcx + 8]
    x64.movRegReg rcx, rax
    x64.callMem [rbx + 24]
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @borrowCount {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rax
    x64.movRegImm32 r13, 0
    x64.movRegReg r14, rdx
    x64.jmp forhdr
  forhdr:
    x64.cmpRegImm32 r13, 2
    x64.jcc less, r
    x64.jmp forexit
  r:
    x64.movRegReg rcx, rbx
    x64.callMem [r12 + 24]
    x64.leaRegRegReg r14, r14, r8
    x64.jmp forstep
  forstep:
    x64.leaRegRegImm32 r13, r13, 1
    x64.jmp forhdr
  forexit:
    x64.movRegReg r8, r14
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @forFunc {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rax
    x64.movRegReg rcx, r12
    x64.callDirect __retain_existential
    x64.movRegReg rcx, r8
    x64.movRegReg rdx, r12
    x64.callDirect Holder.create
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.callDirect Holder.run
    x64.leaRegRegReg rbx, r8, rbx
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Holder
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @withTarget {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegReg r13, rax
    x64.loadRegBaseDisp.word64 rdx, [rbx + 8]
    x64.movRegReg rcx, r12
    x64.movRegReg rax, r13
    x64.callDirect borrowCount
    x64.storeSlotReg slot0, r8
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, empty
    x64.jmp ifcont
  empty:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r14, 0
    x64.movRegImm32 r15, 0
    x64.jmp forhdr
  forhdr:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegReg r15, rax
    x64.jcc less, each
    x64.jmp forexit
  each:
    x64.loadRegBaseDisp.word64 rax, [rbx + 24]
    x64.cmpRegImm32 rax, 8
    x64.jcc equal, __im_word
    x64.jmp __im_stride
  __im_word:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.imulRegRegImm32 rcx, r15, 8
    x64.leaRegRegReg rax, rax, rcx
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.jmp __im_cont
  __im_stride:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, __im_byte
    x64.jmp __im_slow
  __im_byte:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.leaRegRegReg rax, rax, r15
    x64.loadRegBaseDisp.byte rcx, [rax + 0]
    x64.jmp __im_cont
  __im_slow:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r15
    x64.callDirect __managed_get_unchecked
    x64.movRegReg rcx, r8
    x64.jmp __im_cont
  __im_cont:
    x64.movRegReg rdx, r12
    x64.movRegReg rax, r13
    x64.callDirect forFunc
    x64.leaRegRegReg r14, r14, r8
    x64.jmp forstep
  forstep:
    x64.leaRegRegImm32 r15, r15, 1
    x64.jmp forhdr
  forexit:
    x64.loadRegSlot rax, slot0
    x64.leaRegRegReg r8, r14, rax
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @withX64 {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 5
    x64.callDirect Desc.create
    x64.movRegReg r12, r8
    x64.leaRegRdata rax, [rip + __witness_Desc.Payload]
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect withTarget
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 3
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegReg rcx, rbx
    x64.callDirect withX64
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
