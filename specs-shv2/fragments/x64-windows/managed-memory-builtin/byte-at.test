    x64.ret
  tryok:
    x64.cmpRegImm32 r12, 11
    x64.jcc notEqual, badA
    x64.jmp ifcont
  badA:
    x64.movRegImm32 r12, 5
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
