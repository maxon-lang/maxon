// Test: a-case-declared-after-a-method
enum Order
	alpha

	export function bump() returns int
		return 1
	end 'bump'

	omega
end 'Order'

function tagOf(k Order) returns int
	return match k 'w'
		alpha gives 1
		omega gives 5
	end 'w'
end 'tagOf'

function main() returns ExitCode
	let e = Order.omega
	return tagOf(e) as ExitCode
end 'main'
---
ExitCode: 5
---
func @tagOf {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, matcharm
    x64.jmp matchnext
  matcharm:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rcx, 1
    x64.jcc equal, matcharm
    x64.jmp matchdead
  matcharm:
    x64.movRegImm32 r8, 5
    x64.jmp matchcont
  matchcont:
    x64.popReg rbp
    x64.ret
  matchdead:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 1
    x64.callDirect tagOf
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
