// Test: a-case-declared-after-a-method
enum Order
	alpha

	export function bump() returns int
		return 1
	end 'bump'

	omega
end 'Order'

function tagOf(k Order) returns int
	return match k 'w'
		alpha gives 1
		omega gives 5
	end 'w'
end 'tagOf'

function main() returns ExitCode
	let e = Order.omega
	return tagOf(e) as ExitCode
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 1
    x64.jmp __il_body
  __il_body:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#6
    x64.jmp matchnext
  matcharm#6:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm#7
    x64.jmp matchdead
  matcharm#7:
    x64.movRegImm32 r8, 5
    x64.jmp matchcont
  matchcont:
    x64.jmp __il_cont
  __il_cont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
}
