// Test: struct-with-multiple-managed-fields

typealias Integer = int(i64.min to i64.max)

type MultiField
	export var a as String
	export var b as Integer
	export var c as String
	export var d as Integer
	export var e as String

	static function create(a String, b Integer, c String, d Integer, e String) returns Self
		return Self{a: a, b: b, c: c, d: d, e: e}
	end 'create'
end 'MultiField'

typealias MultiArray = Array with MultiField

function main() returns ExitCode
	var items = MultiArray.create()
	items.push(MultiField.create("string a that is long enough for heap", b: 1, c: "string c that is long enough for heap", d: 2, e: "string e that is long enough for heap"))
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @MultiField.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 56
    x64.movRegReg rbx, rcx
    x64.storeSlotReg slot0, rbx
    x64.movRegReg r12, rdx
    x64.movRegReg r13, rax
    x64.movRegReg r14, r9
    x64.storeSlotReg slot1, rsi
    x64.movRegImm32 rcx, 40
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r15, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r15 + 0], r8
    x64.storeBaseDispReg.word64 [r15 + 8], r12
    x64.movRegReg rcx, r13
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r15 + 16], r8
    x64.storeBaseDispReg.word64 [r15 + 24], r14
    x64.loadRegSlot rbx, slot1
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r15 + 32], r8
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegReg rcx, r13
    x64.callDirect __str_decref
    x64.loadRegSlot rcx, slot0
    x64.callDirect __str_decref
    x64.movRegReg r8, r15
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 56
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __destruct_MultiField]
    x64.callDirect __managed_create
    x64.storeSlotReg slot0, r8
    x64.leaRegRdata rax, [rip + __str_rec_3]
    x64.leaRegRdata rbx, [rip + __str_rec_4]
    x64.leaRegRdata rcx, [rip + __str_rec_5]
    x64.storeSlotReg slot1, rcx
    x64.loadRegBaseDisp.word64 r12, [rax + 0]
    x64.loadRegBaseDisp.word64 r13, [rax + 8]
    x64.leaRegRegImm32 rcx, r13, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.leaRegRegImm32 r15, r14, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r12
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r15, r13
    x64.storeBaseDispReg.word64 [r14 + 0], r15
    x64.storeBaseDispReg.word64 [r14 + 8], r13
    x64.movRegImm rax, -3
    x64.storeBaseDispReg.word64 [r14 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r14 + 24], rax
    x64.loadRegBaseDisp.word64 r12, [rbx + 0]
    x64.loadRegBaseDisp.word64 rbx, [rbx + 8]
    x64.leaRegRegImm32 rcx, rbx, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeSlotReg slot2, r13
    x64.leaRegRegImm32 r15, r13, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r12
    x64.movRegReg rax, rbx
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r15, rbx
    x64.storeBaseDispReg.word64 [r13 + 0], r15
    x64.storeBaseDispReg.word64 [r13 + 8], rbx
    x64.movRegImm rax, -3
    x64.storeBaseDispReg.word64 [r13 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r13 + 24], rax
    x64.loadRegSlot rax, slot1
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
    x64.loadRegBaseDisp.word64 r12, [rax + 8]
    x64.leaRegRegImm32 rcx, r12, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.leaRegRegImm32 r15, r13, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, rbx
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r15, r12
    x64.storeBaseDispReg.word64 [r13 + 0], r15
    x64.storeBaseDispReg.word64 [r13 + 8], r12
    x64.movRegImm rax, -3
    x64.storeBaseDispReg.word64 [r13 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r13 + 24], rax
    x64.movRegReg rcx, r14
    x64.movRegImm32 rdx, 1
    x64.loadRegSlot rax, slot2
    x64.movRegImm32 r9, 2
    x64.movRegReg rsi, r13
    x64.callDirect MultiField.create
    x64.loadRegSlot rbx, slot0
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
