// Test: hall-nonlaminar-confined-by-different-calls
function sink(x int) returns int
	return x
end 'sink'

function pick(k int) returns int
	let v1 = k + 11
	let v2 = k + 22
	let v3 = k + 33
	let v4 = k + 44
	let v5 = k + 55
	let v6 = k + 66
	var out = 0
	if k == 1 'b1'
		let t = sink(1)
		out = v1 + t
	end 'b1' else if k == 2 'b2'
		let t2 = sink(2)
		out = v2 + t2
	end 'b2' else if k == 3 'b3'
		let t3 = sink(3)
		out = v3 + t3
	end 'b3' else if k == 4 'b4'
		let t4 = sink(4)
		out = v4 + t4
	end 'b4' else if k == 5 'b5'
		let t5 = sink(5)
		out = v5 + t5
	end 'b5' else 'b6'
		let t6 = sink(6)
		out = v6 + t6
	end 'b6'
	return out
end 'pick'

function main() returns ExitCode
	let total = pick(1) + pick(2) + pick(3) + pick(4) + pick(5) + pick(6)
	if total == 273 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @pick {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegRegImm32 rax, rcx, 11
    x64.leaRegRegImm32 rdx, rcx, 22
    x64.leaRegRegImm32 rsi, rcx, 33
    x64.leaRegRegImm32 rdi, rcx, 44
    x64.leaRegRegImm32 r8, rcx, 55
    x64.leaRegRegImm32 r9, rcx, 66
    x64.cmpRegImm32 rcx, 1
    x64.jcc notEqual, ifelse#2
  __il_cont#16:
    x64.leaRegRegImm32 r8, rax, 1
    x64.jmp ifcont#15
  ifelse#2:
    x64.cmpRegImm32 rcx, 2
    x64.jcc notEqual, ifelse#4
  __il_cont#18:
    x64.leaRegRegImm32 rax, rdx, 2
    x64.jmp ifcont#14
  ifelse#4:
    x64.cmpRegImm32 rcx, 3
    x64.jcc notEqual, ifelse#6
  __il_cont#20:
    x64.leaRegRegImm32 rax, rsi, 3
    x64.jmp ifcont#14
  ifelse#6:
    x64.cmpRegImm32 rcx, 4
    x64.jcc notEqual, ifelse#8
  __il_cont#22:
    x64.leaRegRegImm32 rax, rdi, 4
    x64.jmp ifcont#14
  ifelse#8:
    x64.cmpRegImm32 rcx, 5
    x64.jcc notEqual, __il_cont#26
  __il_cont#24:
    x64.leaRegRegImm32 rax, r8, 5
    x64.jmp ifcont#14
  __il_cont#26:
    x64.leaRegRegImm32 rax, r9, 6
  ifcont#14:
    x64.movRegReg r8, rax
  ifcont#15:
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 1
    x64.callDirect pick
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 2
    x64.callDirect pick
    x64.leaRegRegReg rbx, rbx, r8
    x64.movRegImm32 rcx, 3
    x64.callDirect pick
    x64.leaRegRegReg rbx, rbx, r8
    x64.movRegImm32 rcx, 4
    x64.callDirect pick
    x64.leaRegRegReg rbx, rbx, r8
    x64.movRegImm32 rcx, 5
    x64.callDirect pick
    x64.leaRegRegReg rbx, rbx, r8
    x64.movRegImm32 rcx, 6
    x64.callDirect pick
    x64.leaRegRegReg rax, rbx, r8
    x64.cmpRegImm32 rax, 273
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
