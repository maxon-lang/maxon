// Test: seven-across-call-in-loop
function bump(x int) returns int
	return x + 1
end 'bump'

function sevenAcross(p int) returns int
	var a1 = p + 1
	var a2 = p + 2
	var a3 = p + 3
	var a4 = p + 4
	var a5 = p + 5
	var a6 = p + 6
	var a7 = p + 7
	var i = 0
	while i < 3 'loop'
		let d = bump(i)
		a1 = a1 + d
		a2 = a2 + d
		a3 = a3 + d
		a4 = a4 + d
		a5 = a5 + d
		a6 = a6 + d
		a7 = a7 + d
		i = i + 1
	end 'loop'
	return a1 + a2 + a3 + a4 + a5 + a6 + a7
end 'sevenAcross'

function main() returns ExitCode
	let r = sevenAcross(0)
	if r == 70 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @sevenAcross {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegRegImm32 rax, rcx, 1
    x64.leaRegRegImm32 rdx, rcx, 2
    x64.leaRegRegImm32 rsi, rcx, 3
    x64.leaRegRegImm32 rdi, rcx, 4
    x64.leaRegRegImm32 r8, rcx, 5
    x64.leaRegRegImm32 r9, rcx, 6
    x64.leaRegRegImm32 rcx, rcx, 7
    x64.movRegImm32 r10, 0
  whilehdr:
    x64.cmpRegImm32 r10, 3
    x64.jcc greaterEqual, whileexit
  __il_body:
    x64.leaRegRegImm32 r11, r10, 1
  __il_cont:
    x64.leaRegRegReg rax, rax, r11
    x64.leaRegRegReg rdx, rdx, r11
    x64.leaRegRegReg rsi, rsi, r11
    x64.leaRegRegReg rdi, rdi, r11
    x64.leaRegRegReg r8, r8, r11
    x64.leaRegRegReg r9, r9, r11
    x64.leaRegRegReg rcx, rcx, r11
    x64.leaRegRegImm32 r10, r10, 1
    x64.jmp whilehdr
  whileexit:
    x64.leaRegRegReg rax, rax, rdx
    x64.leaRegRegReg rax, rax, rsi
    x64.leaRegRegReg rax, rax, rdi
    x64.leaRegRegReg rax, rax, r8
    x64.leaRegRegReg rax, rax, r9
    x64.leaRegRegReg r8, rax, rcx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 0
    x64.callDirect sevenAcross
    x64.cmpRegImm32 r8, 70
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
