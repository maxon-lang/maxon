// Test: five-across-call-in-loop
function bump(x int) returns int
	return x + 1
end 'bump'

function fourAcross(p int) returns int
	var a1 = p + 1
	var a2 = p + 2
	var a3 = p + 3
	var a4 = p + 4
	var i = 0
	while i < 3 'loop'
		let d = bump(i)
		a1 = a1 + d
		a2 = a2 + d
		a3 = a3 + d
		a4 = a4 + d
		i = i + 1
	end 'loop'
	return a1 + a2 + a3 + a4
end 'fourAcross'

function main() returns ExitCode
	let r = fourAcross(0)
	if r == 34 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @fourAcross {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegRegImm32 rax, rcx, 1
    x64.leaRegRegImm32 rdx, rcx, 2
    x64.leaRegRegImm32 rsi, rcx, 3
    x64.leaRegRegImm32 rcx, rcx, 4
    x64.movRegImm32 rdi, 0
  whilehdr:
    x64.cmpRegImm32 rdi, 3
    x64.jcc greaterEqual, whileexit
  __il_body:
    x64.leaRegRegImm32 r8, rdi, 1
  __il_cont:
    x64.leaRegRegReg rax, rax, r8
    x64.leaRegRegReg rdx, rdx, r8
    x64.leaRegRegReg rsi, rsi, r8
    x64.leaRegRegReg rcx, rcx, r8
    x64.leaRegRegImm32 rdi, rdi, 1
    x64.jmp whilehdr
  whileexit:
    x64.leaRegRegReg rax, rax, rdx
    x64.leaRegRegReg rax, rax, rsi
    x64.leaRegRegReg r8, rax, rcx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 0
    x64.callDirect fourAcross
    x64.cmpRegImm32 r8, 34
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
