// Test: checked-divide-keeps-the-idiv
function opaque(x int) returns int
	return x
end 'opaque'

function main() returns ExitCode
	let d = opaque(7)
	let q = try (100 / d) otherwise 99
	return q as ExitCode
end 'main'
---
ExitCode: 14
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 7
  __il_cont:
    x64.movRegImm32 rcx, 100
    x64.cmpRegImm32 rax, 0
    x64.setccReg equal, rsi
    x64.movRegReg rdi, rsi
    x64.orRegImm32 rdi, rsi, 7
    x64.movRegReg rax, rcx
    x64.cqo
    x64.idivReg rdi
    x64.cmpRegImm32 rsi, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm32 r8, 99
    x64.jmp trycont
  tryok:
    x64.movRegReg r8, rax
  trycont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
