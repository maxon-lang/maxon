// Test: checked-divide-in-a-loop
function opaque(x int) returns int
	return x
end 'opaque'

function main() returns ExitCode
	var sum = 0
	var i = 1
	while i <= 6 'loop'
		sum = sum + (try (100 / opaque(i)) otherwise 0)
		i = i + 1
	end 'loop'
	return sum as ExitCode
end 'main'
---
ExitCode: 244
---
func @opaque {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegReg r8, rcx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 r12, 1
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegImm32 r12, 6
    x64.jcc lessEqual, loop
    x64.jmp whileexit
  loop:
    x64.movRegImm32 r13, 100
    x64.movRegReg rcx, r12
    x64.callDirect opaque
    x64.cmpRegImm32 r8, 0
    x64.setccReg equal, rcx
    x64.orRegReg r8, r8, rcx
    x64.movRegReg rax, r13
    x64.cqo
    x64.idivReg r8
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 rax, 0
    x64.jmp trycont
  tryok:
    x64.jmp trycont
  trycont:
    x64.leaRegRegReg rbx, rbx, rax
    x64.leaRegRegImm32 r12, r12, 1
    x64.jmp whilehdr
  whileexit:
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
