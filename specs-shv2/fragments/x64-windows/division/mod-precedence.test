// Test: mod-precedence
function main() returns ExitCode
	return 2 * 6 mod 4
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 2
    x64.imulRegRegImm32 rax, rax, 6
    x64.movRegImm32 rcx, 4
    x64.cqo
    x64.idivReg rcx
    x64.movRegReg r8, rdx
    x64.popReg rbp
    x64.ret
}
