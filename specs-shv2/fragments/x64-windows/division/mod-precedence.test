// Test: mod-precedence
function main() returns ExitCode
	return 2 * 6 mod 4
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 12
    x64.movRegReg rcx, rax
    x64.sarRegImm8 rcx, rax, 63
    x64.shrRegImm8 rcx, rcx, 62
    x64.leaRegRegImm32 rcx, rcx, 12
    x64.sarRegImm8 rcx, rcx, 2
    x64.imulRegRegImm32 rcx, rcx, 4
    x64.movRegReg r8, rax
    x64.subRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
