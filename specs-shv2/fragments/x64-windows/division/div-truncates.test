// Test: div-truncates
function main() returns ExitCode
	return 100 / 7
end 'main'
---
ExitCode: 14
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 100
    x64.movRegImm32 rcx, 7
    x64.cqo
    x64.idivReg rcx
    x64.movRegReg r8, rax
    x64.popReg rbp
    x64.ret
}
