// Test: div-truncates
function main() returns ExitCode
	return 100 / 7
end 'main'
---
ExitCode: 14
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 100
    x64.movRegImm rax, 5270498306774157605
    x64.imulHighReg rcx
    x64.sarRegImm8 rdx, rdx, 1
    x64.movRegReg rax, rdx
    x64.shrRegImm8 rax, rdx, 63
    x64.leaRegRegReg r8, rdx, rax
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at div-truncates.test:3: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
