  __il_body#12:
    x64.jmp __il_cont#11
  __il_cont#11:
    x64.movRegImm32 rcx, 0
    x64.jmp __il_body#13
  __il_body#13:
    x64.jmp __il_cont#10
  __il_cont#10:
    x64.movRegImm32 rdx, 100
    x64.cmpRegImm32 rax, 0
    x64.setccReg equal, rsi
    x64.movRegReg rdi, rsi
    x64.orRegImm32 rdi, rsi, 7
    x64.movRegReg rax, rdx
    x64.cqo
    x64.idivReg rdi
    x64.cmpRegImm32 rsi, 0
    x64.jcc notEqual, tryerr#2
    x64.jmp tryok#1
  tryerr#2:
    x64.movRegImm32 rsi, 99
    x64.jmp trycont#3
  tryok#1:
    x64.movRegReg rsi, rax
    x64.jmp trycont#3
  trycont#3:
    x64.movRegImm32 rax, 100
    x64.cmpRegImm32 rcx, 0
    x64.setccReg equal, rcx
    x64.cqo
    x64.idivReg rcx
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, tryerr#5
    x64.jmp tryok#4
  tryerr#5:
    x64.movRegImm32 rax, 0
    x64.jmp trycont#6
  tryok#4:
    x64.jmp trycont#6
  trycont#6:
    x64.leaRegRegImm32 rcx, rsi, 7
    x64.leaRegRegReg r8, rcx, rax
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
