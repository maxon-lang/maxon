// Test: divisor-is-read-after-a-checked-divide
function opaque(x int) returns int
	return x
end 'opaque'

function main() returns ExitCode
	let d = opaque(7)
	let z = opaque(0)
	let q = try (100 / d) otherwise 99
	let r = try (100 / z) otherwise 0
	return (q + d + r + z) as ExitCode
end 'main'
---
ExitCode: 21
---
