// Test: cast-to-loaded-stdlib-internal-typealias
function main() returns ExitCode
	let n = 5 as Milliseconds
	return n as ExitCode
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 5
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
