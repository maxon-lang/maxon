// Test: mixed-range-then-case-deferred
function classify(v E) returns ExitCode
	return match v 'm'
		c to d or a gives 1
		b gives 2
	end 'm'
end 'classify'

enum E
	a
	b
	c
	d
end 'E'

function main() returns ExitCode
	for x in E.allCases 'e'
		print("{x.name}={classify(x)}\n")
	end 'e'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @classify {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, matcharm#1
  matchnext#4:
    x64.cmpRegImm32 rcx, 1
    x64.jcc notEqual, matchnext#5
  matcharm#2:
    x64.movRegImm32 r8, 2
    x64.jmp matchcont
  matchnext#5:
    x64.cmpRegImm32 rcx, 2
    x64.setccReg greaterEqual, rax
    x64.cmpRegImm32 rcx, 3
    x64.setccReg lessEqual, rcx
    x64.andRegReg rax, rax, rcx
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matchdead
  matcharm#1:
    x64.movRegImm32 r8, 1
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_12]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
