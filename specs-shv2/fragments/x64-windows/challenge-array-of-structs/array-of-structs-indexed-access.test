// Test: array-of-structs-indexed-access

typealias Integer = int(i64.min to i64.max)

type Pair
	export var first as Integer
	export var second as Integer

	static function create(first Integer, second Integer) returns Self
		return Self{first: first, second: second}
	end 'create'
end 'Pair'

function main() returns ExitCode
	let p = Pair.create(10, second: 20)
	let arr = [p]
	let elem = try arr.get(0) otherwise Pair.create(0, second: 0)
	return elem.first + elem.second
end 'main'
---
ExitCode: 30
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Pair.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.storeBaseDispReg.word64 [r8 + 8], r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 10
    x64.movRegImm32 rdx, 20
    x64.callDirect Pair.create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __mm_decref]
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rax, [r12 + 24]
    x64.cmpRegImm32 rax, 8
    x64.jcc notEqual, __im_stride
  __im_word:
    x64.loadRegBaseDisp.word64 rax, [r12 + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc lessEqual, __il_slow
  __im_load#13:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.jmp __im_loaded
  __im_stride:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, __il_slow
  __im_byte:
    x64.loadRegBaseDisp.word64 rax, [r12 + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc lessEqual, __il_slow
  __im_load#14:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.loadRegBaseDisp.byte rax, [rax + 0]
  __im_loaded:
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rsi, [r12 + 40]
    x64.cmpRegImm32 rsi, 0
    x64.jcc equal, critsplit#16
  __im_empty:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __il_slow
  critsplit#17:
    x64.movRegReg r13, rax
    x64.jmp __il_cont
  critsplit#16:
    x64.movRegReg r13, rax
    x64.jmp __il_cont
  __il_slow:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_get
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r10
  __il_cont:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm32 rcx, 0
    x64.movRegImm32 rdx, 0
    x64.callDirect Pair.create
    x64.movRegReg rcx, r8
    x64.jmp trycont
  tryok:
    x64.movRegReg rcx, r13
    x64.callDirect __mm_incref
    x64.movRegReg rcx, r13
  trycont:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.word64 rdx, [rcx + 8]
    x64.leaRegRegReg r13, rax, rdx
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.cmpRegImm32 r13, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r13, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
