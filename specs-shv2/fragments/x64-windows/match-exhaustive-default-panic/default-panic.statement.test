// Test: default-panic.statement
function main() returns ExitCode
	let x = 2
	match x 'check'
		1 then return 10
		2 then return 20
		default panic("unexpected value")
	end 'check'
end 'main'
---
ExitCode: 20
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 2
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm#1
    x64.jmp matchnext
  matcharm#1:
    x64.movRegImm32 r8, 10
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchnext:
    x64.cmpRegImm32 rax, 2
    x64.jcc equal, matcharm#2
    x64.jmp matchdefault
  matcharm#2:
    x64.movRegImm32 r8, 20
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdefault:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchcont:
}
