// Test: postfix.string-method-on-a-string-result
function main() returns ExitCode
	let s = "hello"
	return "ab".toUpper().byteLength() + s.clone().byteLength()
end 'main'
---
ExitCode: 7
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.leaRegRdata rbx, [rip + __str_rec_1]
    x64.leaRegRdata rcx, [rip + __str_rec_3]
    x64.movRegImm32 rdx, 97
    x64.movRegImm32 rax, 122
    x64.movRegImm r9, -32
    x64.callDirect __str_map_case
    x64.movRegReg r12, r8
    x64.loadRegBaseDisp.word64 r13, [r12 + 8]
    x64.movRegReg rcx, rbx
    x64.callDirect __str_clone
    x64.loadRegBaseDisp.word64 rax, [r8 + 8]
    x64.leaRegRegReg rbx, r13, rax
    x64.movRegReg rcx, r8
    x64.callDirect __str_decref
    x64.movRegReg rcx, r12
    x64.callDirect __str_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_4]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
