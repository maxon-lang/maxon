// Test: builtins-cpu-parallel.cpu-count-is-stable-across-calls
function main() returns ExitCode
	let first = __Builtins.cpuCount()
	let second = __Builtins.cpuCount()
	let third = __Builtins.cpuCount()
	var score = 0
	if first == second 'firstPair'
		score = score + 1
	end 'firstPair'
	if second == third 'secondPair'
		score = score + 3
	end 'secondPair'
	return score as ExitCode
end 'main'
---
ExitCode: 4
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect __cpu_count
    x64.movRegReg rbx, r8
    x64.callDirect __cpu_count
    x64.movRegReg r12, r8
    x64.callDirect __cpu_count
    x64.movRegImm32 rax, 0
    x64.cmpRegReg rbx, r12
    x64.jcc equal, firstPair
    x64.jmp critsplit#8
  firstPair:
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp ifcont#2
  critsplit#8:
    x64.jmp ifcont#2
  ifcont#2:
    x64.cmpRegReg r12, r8
    x64.jcc equal, secondPair
    x64.jmp critsplit#9
  secondPair:
    x64.leaRegRegImm32 r8, rax, 3
    x64.jmp ifcont#4
  critsplit#9:
    x64.movRegReg r8, rax
    x64.jmp ifcont#4
  ifcont#4:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
