// Test: self-returned-aliases-the-receiver

typealias Integer = int(i64.min to i64.max)

type Counter
	export var value as Integer

	static function create(value Integer) returns Self
		return Self{value: value}
	end 'create'

	export function bump() returns Counter
		self.value = self.value + 1
		return self
	end 'bump'
end 'Counter'

function main() returns ExitCode
	var c = Counter.create(40)
	var d = c.bump()
	d.value = d.value + 1
	return c.value as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Counter.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Counter.bump {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.leaRegRegImm32 rax, rax, 1
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.callDirect __mm_retain
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 40
    x64.callDirect Counter.create
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect Counter.bump
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.leaRegRegImm32 rax, rax, 1
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.loadRegBaseDisp.word64 r12, [rbx + 0]
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
