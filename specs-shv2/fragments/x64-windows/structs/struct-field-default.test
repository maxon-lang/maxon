// Test: struct-field-default
type Counter
	export var value = 0
	export var step = 1

	static function create() returns Self
		return Self{}
	end 'create'

	static function create(value CounterValue, step CounterStep) returns Self
		return Self{value: value, step: step}
	end 'create'
end 'Counter'

typealias CounterValue = int(0 to u64.max)
typealias CounterStep = int(0 to u64.max)

function main() returns ExitCode
	let c1 = Counter.create()
	let c2 = Counter.create(40, step: 1)
	let c3 = Counter.create(10, step: 2)
	return c1.value + c2.value + c3.step
end 'main'
---
ExitCode: 42
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 80
    x64.leaRegSlot rax, slot0
    x64.movRegImm32 rcx, 0
    x64.storeBaseDispReg.word64 [rax + 0], rcx
    x64.movRegImm32 rcx, 1
    x64.storeBaseDispReg.word64 [rax + 8], rcx
    x64.movRegImm32 rcx, 40
    x64.movRegImm32 rdx, 1
    x64.leaRegSlot rsi, slot2
    x64.storeBaseDispReg.word64 [rsi + 0], rcx
    x64.storeBaseDispReg.word64 [rsi + 8], rdx
    x64.movRegImm32 rcx, 10
    x64.movRegImm32 rdx, 2
    x64.leaRegSlot rdi, slot4
    x64.storeBaseDispReg.word64 [rdi + 0], rcx
    x64.storeBaseDispReg.word64 [rdi + 8], rdx
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.loadRegBaseDisp.word64 rcx, [rsi + 0]
    x64.leaRegRegReg rax, rax, rcx
    x64.loadRegBaseDisp.word64 rcx, [rdi + 8]
    x64.leaRegRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 80
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 80
    x64.popReg rbp
    x64.ret
}
