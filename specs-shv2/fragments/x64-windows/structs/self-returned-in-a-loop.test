// Test: self-returned-in-a-loop

typealias Integer = int(i64.min to i64.max)

type Tally
	export var n as Integer
	export var label as String

	static function create(n Integer) returns Self
		return Self{n: n, label: "t"}
	end 'create'

	export function itself() returns Tally
		return self
	end 'itself'
end 'Tally'

function main() returns ExitCode
	let t = Tally.create(3)
	var sum = 0
	for _ in 0 upto 14 'trip'
		let handle = t.itself()
		sum = sum + handle.n + handle.label.count()
	end 'trip'
	return sum as ExitCode
end 'main'
---
ExitCode: 56
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Tally.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.leaRegRdata r12, [rip + __str_rec_1]
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
    x64.loadRegBaseDisp.word64 rbx, [r12 + 0]
    x64.loadRegBaseDisp.word64 r12, [r12 + 8]
    x64.leaRegRegImm32 rcx, r12, 49
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.leaRegRegImm32 r15, r14, 48
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, rbx
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r15, r12
    x64.storeBaseDispReg.word64 [r14 + 0], r15
    x64.storeBaseDispReg.word64 [r14 + 8], r12
    x64.movRegImm rax, -3
    x64.storeBaseDispReg.word64 [r14 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r14 + 24], rax
    x64.storeBaseDispReg.word64 [r13 + 8], r14
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Tally.itself {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __mm_retain
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rcx, 3
    x64.callDirect Tally.create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 0
    x64.movRegImm32 r13, 0
    x64.jmp forhdr
  forhdr:
    x64.cmpRegImm32 r13, 14
    x64.jcc less, trip
    x64.jmp forexit
  trip:
    x64.movRegReg rcx, rbx
    x64.callDirect Tally.itself
    x64.movRegReg r14, r8
    x64.loadRegBaseDisp.word64 rax, [r14 + 0]
    x64.leaRegRegReg r12, r12, rax
    x64.loadRegBaseDisp.word64 rcx, [r14 + 8]
    x64.callDirect __gr_count
    x64.leaRegRegReg r12, r12, r8
    x64.movRegReg rcx, r14
    x64.callDirect __destruct_Tally
    x64.jmp forstep
  forstep:
    x64.leaRegRegImm32 r13, r13, 1
    x64.jmp forhdr
  forexit:
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Tally
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
