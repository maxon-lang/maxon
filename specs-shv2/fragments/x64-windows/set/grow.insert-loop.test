// Test: grow.insert-loop
typealias Int = int(i64.min to i64.max)
typealias IntSet = Set with Int

function main() returns ExitCode
	var s = IntSet.create()
	var i = 0
	while i < 20 'fill'
		s.insert(i)
		i = i + 1
	end 'fill'
	if s.count() != 20 'count'
		return 1
	end 'count'
	var j = 0
	while j < 20 'check'
		if not s.contains(j) 'missing'
			return 2
		end 'missing'
		j = j + 1
	end 'check'
	if s.contains(20) 'phantom'
		return 3
	end 'phantom'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __layout_Set_Int]
    x64.leaRegRdata rdx, [rip + __witness_int.Hashable]
    x64.leaRegRdata rax, [rip + __witness_int.Equatable]
    x64.callDirect Set.create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 0
  whilehdr#1:
    x64.cmpRegImm32 r12, 20
    x64.jcc greaterEqual, whileexit#3
  fill:
    x64.leaRegRdata rax, [rip + __layout_Set_Int]
    x64.leaRegRdata r9, [rip + __witness_int.Hashable]
    x64.leaRegRdata rsi, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect Set.insert
    x64.leaRegRegImm32 r12, r12, 1
    x64.jmp whilehdr#1
  whileexit#3:
    x64.leaRegRdata rax, [rip + __witness_int.Hashable]
    x64.leaRegRdata rax, [rip + __witness_int.Equatable]
  __il_body:
    x64.loadRegBaseDisp.word64 rax, [rbx + 24]
  __il_cont:
    x64.cmpRegImm32 rax, 20
    x64.jcc equal, ifcont#5
  count:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Set_Int
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#5:
    x64.movRegImm32 r12, 0
  whilehdr#6:
    x64.cmpRegImm32 r12, 20
    x64.jcc greaterEqual, whileexit#8
  check:
    x64.leaRegRdata rax, [rip + __layout_Set_Int]
    x64.leaRegRdata r9, [rip + __witness_int.Hashable]
    x64.leaRegRdata rsi, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect Set.contains
    x64.xorRegImm32 r8, r8, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#10
  missing:
    x64.movRegImm32 r12, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Set_Int
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#10:
    x64.leaRegRegImm32 r12, r12, 1
    x64.jmp whilehdr#6
  whileexit#8:
    x64.movRegImm32 rdx, 20
    x64.leaRegRdata rax, [rip + __layout_Set_Int]
    x64.leaRegRdata r9, [rip + __witness_int.Hashable]
    x64.leaRegRdata rsi, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, rbx
    x64.callDirect Set.contains
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#12
  phantom:
    x64.movRegImm32 r12, 3
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Set_Int
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#12:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Set_Int
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
