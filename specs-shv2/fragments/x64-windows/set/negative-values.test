// Test: negative-values
typealias Int = int(i64.min to i64.max)
typealias IntSet = Set with Int

function main() returns ExitCode
	var s = IntSet.create()
	s.insert(-5)
	s.insert(-100)
	s.insert(-5)
	if s.count() != 2 'count'
		return 1
	end 'count'
	if not s.contains(-5) 'hasNeg5'
		return 2
	end 'hasNeg5'
	if not s.contains(-100) 'hasNeg100'
		return 3
	end 'hasNeg100'
	if s.contains(-7) 'noNeg7'
		return 4
	end 'noNeg7'
	if not s.remove(-5) 'rmNeg5'
		return 5
	end 'rmNeg5'
	if s.count() != 1 'count2'
		return 6
	end 'count2'
	if s.contains(-5) 'goneNeg5'
		return 7
	end 'goneNeg5'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect __set_create
    x64.movRegReg rbx, r8
    x64.movRegImm rdx, -5
    x64.leaRegRdata rax, [rip + __witness_int_Hashable]
    x64.leaRegRdata r9, [rip + __witness_int_Equatable]
    x64.movRegReg rcx, rbx
    x64.callDirect __set_insert
    x64.movRegImm rdx, -100
    x64.leaRegRdata rax, [rip + __witness_int_Hashable]
    x64.leaRegRdata r9, [rip + __witness_int_Equatable]
    x64.movRegReg rcx, rbx
    x64.callDirect __set_insert
    x64.movRegImm rdx, -5
    x64.leaRegRdata rax, [rip + __witness_int_Hashable]
    x64.leaRegRdata r9, [rip + __witness_int_Equatable]
    x64.movRegReg rcx, rbx
    x64.callDirect __set_insert
    x64.movRegReg rcx, rbx
    x64.callDirect __set_count
    x64.cmpRegImm32 r8, 2
    x64.jcc notEqual, count
    x64.jmp ifcont
  count:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __set_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm rdx, -5
    x64.leaRegRdata rax, [rip + __witness_int_Hashable]
    x64.leaRegRdata r9, [rip + __witness_int_Equatable]
    x64.movRegReg rcx, rbx
    x64.callDirect __set_contains
    x64.xorRegImm32 r8, r8, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, hasNeg5
    x64.jmp ifcont
  hasNeg5:
    x64.movRegImm32 r12, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __set_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm rdx, -100
    x64.leaRegRdata rax, [rip + __witness_int_Hashable]
    x64.leaRegRdata r9, [rip + __witness_int_Equatable]
    x64.movRegReg rcx, rbx
    x64.callDirect __set_contains
    x64.xorRegImm32 r8, r8, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, hasNeg100
    x64.jmp ifcont
  hasNeg100:
    x64.movRegImm32 r12, 3
    x64.movRegReg rcx, rbx
    x64.callDirect __set_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm rdx, -7
    x64.leaRegRdata rax, [rip + __witness_int_Hashable]
    x64.leaRegRdata r9, [rip + __witness_int_Equatable]
    x64.movRegReg rcx, rbx
    x64.callDirect __set_contains
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, noNeg7
    x64.jmp ifcont
  noNeg7:
    x64.movRegImm32 r12, 4
    x64.movRegReg rcx, rbx
    x64.callDirect __set_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm rdx, -5
    x64.leaRegRdata rax, [rip + __witness_int_Hashable]
    x64.leaRegRdata r9, [rip + __witness_int_Equatable]
    x64.movRegReg rcx, rbx
    x64.callDirect __set_remove
    x64.xorRegImm32 r8, r8, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, rmNeg5
    x64.jmp ifcont
  rmNeg5:
    x64.movRegImm32 r12, 5
    x64.movRegReg rcx, rbx
    x64.callDirect __set_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegReg rcx, rbx
    x64.callDirect __set_count
    x64.cmpRegImm32 r8, 1
    x64.jcc notEqual, count2
    x64.jmp ifcont
  count2:
    x64.movRegImm32 r12, 6
    x64.movRegReg rcx, rbx
    x64.callDirect __set_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm rdx, -5
    x64.leaRegRdata rax, [rip + __witness_int_Hashable]
    x64.leaRegRdata r9, [rip + __witness_int_Equatable]
    x64.movRegReg rcx, rbx
    x64.callDirect __set_contains
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, goneNeg5
    x64.jmp ifcont
  goneNeg5:
    x64.movRegImm32 r12, 7
    x64.movRegReg rcx, rbx
    x64.callDirect __set_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __set_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @int.hash {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 4294967295
    x64.movRegReg r8, rcx
    x64.andRegReg r8, rcx, rax
    x64.popReg rbp
    x64.ret
}

func @int.equals {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegReg rcx, rdx
    x64.jcc equal, equal
    x64.jmp notEqual
  equal:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  notEqual:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
