  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at promise-peek.does-not-consume-the-promise.test:25: Range check failed: value outside typealias 'ExitCode'\x0a"
