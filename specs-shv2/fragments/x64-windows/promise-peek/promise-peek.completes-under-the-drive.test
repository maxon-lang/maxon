    x64.movRegImm32 rax, 0
  whilehdr:
    x64.cmpRegImm32 r15, 100
    x64.movRegImm32 rcx, 0
    x64.jcc greaterEqual, scmerge
  andrhs:
    x64.cmpRegImm32 rax, 0
    x64.setccReg equal, rcx
  scmerge:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, whileexit
  drive:
    x64.callDirect Runtime.yield
    x64.movRegReg rcx, r13
    x64.callDirect __gt_is_complete
    x64.leaRegRegImm32 r15, r15, 1
    x64.movRegReg rax, r8
    x64.jmp whilehdr
  whileexit:
    x64.movRegImm32 rcx, 0
    x64.cmpRegImm32 r14, 0
    x64.jcc notEqual, ifcont#9
  notCompleteOnArrival:
    x64.movRegImm32 rcx, 1
  ifcont#9:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, critsplit#23
  completeAfterTheDrive:
    x64.leaRegRegImm32 r14, rcx, 2
    x64.jmp ifcont#11
  critsplit#23:
    x64.movRegReg r14, rcx
  ifcont#11:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __managed_vacate
    x64.movRegReg rcx, r13
    x64.callDirect __gt_await
    x64.cmpRegImm32 r8, 42
    x64.jcc notEqual, critsplit#24
  stillAwaitable:
    x64.leaRegRegImm32 r12, r14, 4
    x64.jmp ifcont#13
  critsplit#24:
    x64.movRegReg r12, r14
  ifcont#13:
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at promise-peek.completes-under-the-drive.test:34: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
