// Test: a-bare-call-still-widens-a-sibling-method
typealias Integer = int(i64.min to i64.max)

type Runner
	export var seed as Integer

	static function create() returns Self
		return Self{seed: 0}
	end 'create'

	function inner(n Integer) returns Integer
		n = 42
		return n
	end 'inner'

	function outer(n Integer) returns Integer
		_ = inner(n)
		return n
	end 'outer'
end 'Runner'

function main() returns ExitCode
	var r = Runner.create()
	var start = 7
	return r.outer(start)
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Runner.inner {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 42
    x64.storeBaseDispReg.word64 [rdx + 0], rax
    x64.loadRegBaseDisp.word64 r8, [rdx + 0]
    x64.popReg rbp
    x64.ret
}

func @Runner.outer {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rdx
    x64.movRegReg rdx, rbx
    x64.callDirect Runner.inner
    x64.loadRegBaseDisp.word64 r8, [rbx + 0]
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.leaRegSlot rbx, slot0
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [rbx + 0], rax
    x64.movRegImm32 r12, 7
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], r12
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect Runner.outer
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
