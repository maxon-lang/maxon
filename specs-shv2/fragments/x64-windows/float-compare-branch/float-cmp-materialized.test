// Test: float-cmp-materialized
var big = 1.0e308

function main() returns ExitCode
	let inf = big * 10.0
	let nan = inf - inf
	let a = nan == nan
	let b = nan != nan
	var r = 0
	if a 'isEq'
		r = r + 1
	end 'isEq'
	if b 'isNe'
		r = r + 2
	end 'isNe'
	return r
end 'main'
---
ExitCode: 2
---
data {
  __data_big@0 = f64 9214871658872686752
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegGlobal rax, __data_big
    x64.loadRegBaseDisp.word64 xmm0, [rax + 0]
    x64.movsdRegRip xmm1, [rip + __fconst_1]
    x64.mulsdRegReg xmm0, xmm0, xmm1
    x64.subsdRegReg xmm0, xmm0, xmm0
    x64.ucomisdRegReg xmm0, xmm0
    x64.setccReg notEqual, rcx
    x64.setccReg parity, rdx
    x64.leaRegRegReg rcx, rcx, rdx
    x64.cmpRegImm32 rcx, 0
    x64.setccReg equal, rax
    x64.ucomisdRegReg xmm0, xmm0
    x64.setccReg notEqual, rcx
    x64.setccReg parity, rdx
    x64.leaRegRegReg rsi, rcx, rdx
    x64.movRegImm32 rdi, 0
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, critsplit#8
  isEq:
    x64.movRegImm32 rax, 1
    x64.jmp ifcont#2
  critsplit#8:
    x64.movRegReg rax, rdi
  ifcont#2:
    x64.cmpRegImm32 rsi, 0
    x64.jcc equal, critsplit#9
  isNe:
    x64.leaRegRegImm32 r8, rax, 2
    x64.jmp ifcont#4
  critsplit#9:
    x64.movRegReg r8, rax
  ifcont#4:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
