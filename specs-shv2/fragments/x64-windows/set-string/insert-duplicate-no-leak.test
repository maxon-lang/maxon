    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @String.hash {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 8]
    x64.movRegImm32 rdx, 5381
    x64.movRegImm32 rsi, 0
    x64.jmp header
  header:
    x64.cmpRegReg rsi, rcx
    x64.jcc greaterEqual, done
    x64.jmp body
  done:
    x64.movRegImm32 rax, 4294967295
    x64.movRegReg r8, rdx
    x64.andRegReg r8, rdx, rax
    x64.popReg rbp
    x64.ret
  body:
    x64.leaRegRegReg rdi, rax, rsi
    x64.loadRegBaseDisp.byte rdi, [rdi + 0]
    x64.movRegImm32 r8, 33
    x64.imulRegReg rdx, rdx, r8
    x64.leaRegRegReg rdx, rdx, rdi
    x64.movRegImm32 rdi, 1
    x64.leaRegRegReg rsi, rsi, rdi
    x64.jmp header
}

func @String.equals {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.loadRegBaseDisp.word64 rsi, [rdx + 8]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.loadRegBaseDisp.word64 rdx, [rdx + 0]
    x64.movRegImm32 rdi, 0
    x64.cmpRegReg rax, rsi
    x64.jcc equal, critsplit
    x64.jmp notEqual
  critsplit:
    x64.jmp header
  header:
    x64.cmpRegReg rdi, rax
    x64.jcc greaterEqual, allMatch
    x64.jmp body
  allMatch:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  body:
    x64.leaRegRegReg rsi, rcx, rdi
    x64.loadRegBaseDisp.byte rsi, [rsi + 0]
    x64.leaRegRegReg r8, rdx, rdi
    x64.loadRegBaseDisp.byte r8, [r8 + 0]
    x64.movRegImm32 r9, 1
    x64.leaRegRegReg rdi, rdi, r9
    x64.cmpRegReg rsi, r8
    x64.jcc equal, critsplit
    x64.jmp notEqual
  critsplit:
    x64.jmp header
  notEqual:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
