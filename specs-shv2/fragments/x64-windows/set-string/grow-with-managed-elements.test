// Test: grow-with-managed-elements
typealias StrSet = Set with String

function main() returns ExitCode
	var s = StrSet.create()
	var i = 0
	while i < 20 'fill'
		s.insert("k{i}")
		i = i + 1
	end 'fill'
	if s.count() != 20 'count'
		return 1
	end 'count'
	var j = 0
	while j < 20 'check'
		if not s.contains("k{j}") 'missing'
			return 2
		end 'missing'
		j = j + 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 104
    x64.leaRegFunc rcx, [rip + __str_decref]
    x64.callDirect __set_create
    x64.movRegReg rbx, r8
    x64.storeSlotReg slot2, rbx
    x64.movRegImm32 r12, 0
    x64.jmp whilehdr
  whilehdr:
    x64.storeSlotReg slot1, r12
    x64.cmpRegImm32 r12, 20
    x64.jcc less, fill
    x64.jmp whileexit
  fill:
    x64.leaRegRdata rax, [rip + __str_rec_1]
    x64.loadRegBaseDisp.word64 r13, [rax + 0]
    x64.loadRegBaseDisp.word64 r14, [rax + 8]
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r15, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r15
    x64.callDirect __int_to_string
    x64.storeSlotReg slot7, r8
    x64.leaRegRegReg rax, r14, r8
    x64.storeSlotReg slot3, rax
    x64.leaRegRegImm32 rcx, rax, 49
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot5, r8
    x64.leaRegRegImm32 r12, r8, 48
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r13
    x64.movRegReg rax, r14
    x64.callDirect __str_copy
    x64.leaRegRegReg r13, r12, r14
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r15
    x64.loadRegSlot r14, slot7
    x64.movRegReg rax, r14
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r13, r14
    x64.loadRegSlot r13, slot5
    x64.storeBaseDispReg.word64 [r13 + 0], r12
    x64.loadRegSlot rax, slot3
    x64.storeBaseDispReg.word64 [r13 + 8], rax
    x64.movRegImm rax, -3
    x64.storeBaseDispReg.word64 [r13 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r13 + 24], rax
    x64.movRegReg rcx, r15
    x64.callDirect __mm_decref
    x64.leaRegRdata rax, [rip + __witness_String_Hashable]
    x64.leaRegRdata r9, [rip + __witness_String_Equatable]
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect __set_insert
    x64.loadRegSlot rax, slot1
    x64.leaRegRegImm32 rax, rax, 1
    x64.movRegReg r12, rax
    x64.jmp whilehdr
  whileexit:
    x64.movRegReg rcx, rbx
    x64.callDirect __set_count
    x64.cmpRegImm32 r8, 20
    x64.jcc notEqual, count
    x64.jmp ifcont
  count:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __set_decref
    x64.movRegReg r8, r12
    x64.epilogue 104
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rbx, 0
    x64.jmp whilehdr
  whilehdr:
    x64.storeSlotReg slot0, rbx
    x64.cmpRegImm32 rbx, 20
    x64.jcc less, check
    x64.jmp whileexit
  check:
    x64.leaRegRdata rax, [rip + __str_rec_1]
    x64.loadRegBaseDisp.word64 r12, [rax + 0]
    x64.loadRegBaseDisp.word64 r13, [rax + 8]
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r14
    x64.callDirect __int_to_string
    x64.movRegReg rbx, r8
    x64.leaRegRegReg rax, r13, rbx
    x64.storeSlotReg slot4, rax
    x64.leaRegRegImm32 rcx, rax, 49
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot6, r8
    x64.leaRegRegImm32 r15, r8, 48
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r12
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg r12, r15, r13
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r14
    x64.movRegReg rax, rbx
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r12, rbx
    x64.loadRegSlot rbx, slot6
    x64.storeBaseDispReg.word64 [rbx + 0], r15
    x64.loadRegSlot rax, slot4
    x64.storeBaseDispReg.word64 [rbx + 8], rax
    x64.movRegImm rax, -3
    x64.storeBaseDispReg.word64 [rbx + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [rbx + 24], rax
    x64.movRegReg rcx, r14
    x64.callDirect __mm_decref
    x64.leaRegRdata rax, [rip + __witness_String_Hashable]
    x64.leaRegRdata r9, [rip + __witness_String_Equatable]
    x64.loadRegSlot rcx, slot2
    x64.movRegReg rdx, rbx
    x64.callDirect __set_contains
    x64.movRegReg r12, r8
    x64.xorRegImm32 r12, r8, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc notEqual, missing
    x64.jmp ifcont
  missing:
    x64.movRegImm32 rbx, 2
    x64.loadRegSlot rcx, slot2
    x64.callDirect __set_decref
    x64.movRegReg r8, rbx
    x64.epilogue 104
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.loadRegSlot rax, slot0
    x64.leaRegRegImm32 rax, rax, 1
    x64.movRegReg rbx, rax
    x64.jmp whilehdr
  whileexit:
    x64.movRegImm32 rbx, 0
    x64.loadRegSlot rcx, slot2
    x64.callDirect __set_decref
    x64.movRegReg r8, rbx
    x64.epilogue 104
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @String.hash {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 8]
    x64.movRegImm32 rdx, 5381
    x64.movRegImm32 rsi, 0
    x64.jmp header
  header:
    x64.cmpRegReg rsi, rcx
    x64.jcc greaterEqual, done
    x64.jmp body
  done:
    x64.movRegImm32 rax, 4294967295
    x64.movRegReg r8, rdx
    x64.andRegReg r8, rdx, rax
    x64.popReg rbp
    x64.ret
  body:
    x64.leaRegRegReg rdi, rax, rsi
    x64.loadRegBaseDisp.byte rdi, [rdi + 0]
    x64.movRegImm32 r8, 33
    x64.imulRegReg rdx, rdx, r8
    x64.leaRegRegReg rdx, rdx, rdi
    x64.movRegImm32 rdi, 1
    x64.leaRegRegReg rsi, rsi, rdi
    x64.jmp header
}

func @String.equals {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.loadRegBaseDisp.word64 rsi, [rdx + 8]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.loadRegBaseDisp.word64 rdx, [rdx + 0]
    x64.movRegImm32 rdi, 0
    x64.cmpRegReg rax, rsi
    x64.jcc equal, critsplit
    x64.jmp notEqual
  critsplit:
    x64.jmp header
  header:
    x64.cmpRegReg rdi, rax
    x64.jcc greaterEqual, allMatch
    x64.jmp body
  allMatch:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  body:
    x64.leaRegRegReg rsi, rcx, rdi
    x64.loadRegBaseDisp.byte rsi, [rsi + 0]
    x64.leaRegRegReg r8, rdx, rdi
    x64.loadRegBaseDisp.byte r8, [r8 + 0]
    x64.movRegImm32 r9, 1
    x64.leaRegRegReg rdi, rdi, r9
    x64.cmpRegReg rsi, r8
    x64.jcc equal, critsplit
    x64.jmp notEqual
  critsplit:
    x64.jmp header
  notEqual:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
