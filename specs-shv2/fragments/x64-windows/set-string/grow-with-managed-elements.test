// Test: grow-with-managed-elements
typealias StrSet = Set with String

function main() returns ExitCode
	var s = StrSet.create()
	var i = 0
	while i < 20 'fill'
		s.insert("k{i}")
		i = i + 1
	end 'fill'
	if s.count() != 20 'count'
		return 1
	end 'count'
	var j = 0
	while j < 20 'check'
		if not s.contains("k{j}") 'missing'
			return 2
		end 'missing'
		j = j + 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
