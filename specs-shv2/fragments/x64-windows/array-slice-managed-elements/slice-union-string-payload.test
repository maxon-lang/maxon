// Test: slice-union-string-payload
typealias Integer = int(i64.min to i64.max)

union Node
		leaf(name String)
		branch(value Integer)
		empty
end 'Node'

typealias NodeArray = Array with Node

function checkLeaf(n String) returns ExitCode
		if n == "first leaf node name long enough for heap" 'correct'
				return 0
		end 'correct'
		return 1
end 'checkLeaf'

function makeSlice() returns NodeArray throws ArrayError
		var src = NodeArray.create()
		src.push(Node.leaf("first leaf node name long enough for heap"))
		src.push(Node.branch(42))
		src.push(Node.leaf("third leaf node name long enough for heap"))
		return try src.slice(0, endIndex: 2)
		// src is freed when this function returns
end 'makeSlice'

function main() returns ExitCode
		let sliced = try makeSlice() otherwise return 96

		if sliced.count() != 2 'badCount'
				return 99
		end 'badCount'

		let node = try sliced.get(0) otherwise Node.empty
		match node 'check'
				leaf(n) then return checkLeaf(n)
				branch then return 98
				empty then return 97
		end 'check'
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @checkLeaf {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRdata rdx, [rip + __str_rec_2]
    x64.callDirect __str_eq
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont
  correct:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @makeSlice {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __destruct_Node]
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.leaRegRdata r12, [rip + __str_rec_2]
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r13 + 0], rax
    x64.movRegReg rcx, r12
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r13 + 8], r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect __managed_push
    x64.movRegImm32 r12, 42
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.storeBaseDispReg.word64 [r8 + 8], r12
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.leaRegRdata r12, [rip + __str_rec_3]
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r13 + 0], rax
    x64.movRegReg rcx, r12
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r13 + 8], r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 rax, 2
    x64.leaRegRdata r9, [rip + __layout_Array_Node]
    x64.movRegReg rcx, rbx
    x64.callDirect Array.slice
    x64.movRegReg r12, r8
    x64.movRegReg r13, r10
    x64.cmpRegImm32 r13, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegImm32 r8, 0
    x64.movRegReg r10, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegImm32 r10, 0
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.callDirect makeSlice
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#1
  tryerr#2:
    x64.movRegImm32 r8, 96
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#1:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rax, 2
    x64.jcc equal, ifcont
  badCount:
    x64.movRegImm32 r12, 99
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc lessEqual, __im_slow
  __im_load:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseDisp.word64 r12, [rax + 0]
    x64.movRegImm32 rax, 0
    x64.loadRegBaseDisp.word64 rcx, [rbx + 40]
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, critsplit#19
  __im_empty:
    x64.cmpRegImm32 r12, 0
    x64.jcc notEqual, critsplit#20
  __im_slow:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.movRegReg r12, r8
    x64.jmp __im_cont
  critsplit#20:
    x64.movRegReg r10, rax
    x64.jmp __im_cont
  critsplit#19:
    x64.movRegReg r10, rax
  __im_cont:
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#5
  tryerr#6:
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegImm32 rax, 2
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r8 + 8], rax
    x64.movRegReg r12, r8
    x64.jmp trycont
  tryok#5:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_incref
  trycont:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext#12
  matcharm#8:
    x64.loadRegBaseDisp.word64 r13, [r12 + 8]
    x64.movRegReg rcx, r13
    x64.callDirect __mm_incref
    x64.movRegReg rcx, r13
    x64.callDirect checkLeaf
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r13
    x64.callDirect __str_decref
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Node
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r14
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchnext#12:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchnext#13
  matcharm#9:
    x64.movRegImm32 r13, 98
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Node
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r13
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchnext#13:
    x64.cmpRegImm32 rax, 2
    x64.jcc notEqual, matchdead
  matcharm#10:
    x64.movRegImm32 r13, 97
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Node
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r13
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
  matchcont:
}
