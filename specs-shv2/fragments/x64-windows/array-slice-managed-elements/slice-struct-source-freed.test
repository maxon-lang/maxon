    x64.jmp tryok#1
  tryerr#2:
    x64.movRegImm32 r8, 98
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
