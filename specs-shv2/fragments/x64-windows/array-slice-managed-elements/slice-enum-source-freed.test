    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, critsplit#22
  __im_empty:
    x64.cmpRegImm32 r12, 0
    x64.jcc notEqual, critsplit#23
  __im_slow:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.movRegReg r12, r8
    x64.jmp __im_cont
  critsplit#23:
    x64.movRegReg r10, rax
    x64.jmp __im_cont
  critsplit#22:
    x64.movRegReg r10, rax
  __im_cont:
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#5
  tryerr#6:
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegImm32 rax, 2
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r8 + 8], rax
    x64.movRegReg rcx, r8
    x64.jmp trycont
  tryok#5:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_incref
    x64.movRegReg rcx, r12
  trycont:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext#12
  matcharm#9:
    x64.movRegImm32 r12, 98
    x64.callDirect __mm_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchnext#12:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchnext#13
  matcharm#8:
    x64.loadRegBaseDisp.word64 r12, [rcx + 8]
    x64.callDirect __mm_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchnext#13:
    x64.cmpRegImm32 rax, 2
    x64.jcc notEqual, matchdead
  matcharm#10:
    x64.movRegImm32 r12, 97
    x64.callDirect __mm_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
  matchcont:
}
