// Test: int-literal-to-float-self-field
type Reading
	export var value as float = 0.0

	export function bump() returns int
		value = 3
		return 0
	end 'bump'

	export static function make() returns Self
		return Self{}
	end 'make'
end 'Reading'

function main() returns ExitCode
	var r = Reading.make()
	let done = r.bump()
	if r.value == 3.0 'exact'
		return trunc(r.value * 14.0) + done
	end 'exact'
	return 7
end 'main'
---
ExitCode: 42
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Reading.bump {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 3
    x64.cvtsi2sdRegReg xmm0, rax
    x64.storeBaseDispReg.word64 [rcx + 0], xmm0
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}

func @Reading.make {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.storeSlotReg slot0, xmm6
    x64.movsdRegRip xmm6, [rip + __fconst_0]
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], xmm6
    x64.loadRegSlot xmm6, slot0
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect Reading.make
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect Reading.bump
    x64.loadRegBaseDisp.word64 xmm0, [rbx + 0]
    x64.movsdRegRip xmm1, [rip + __fconst_1]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc parity, ifcont
    x64.jmp fordered
  fordered:
    x64.jcc equal, exact
    x64.jmp ifcont
  exact:
    x64.loadRegBaseDisp.word64 xmm0, [rbx + 0]
    x64.movsdRegRip xmm1, [rip + __fconst_2]
    x64.mulsdRegReg xmm0, xmm0, xmm1
    x64.cvttsd2siRegReg rax, xmm0
    x64.leaRegRegReg r12, rax, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r12, 7
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
