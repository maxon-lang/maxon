// Test: int-literal-to-float-return

typealias Float = float(f64.min to f64.max)

function widen() returns Float
	return 3
end 'widen'

function main() returns ExitCode
	return trunc(widen() * 14.0)
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.jmp __il_body
  __il_body:
    x64.movRegImm32 rax, 3
    x64.cvtsi2sdRegReg xmm0, rax
    x64.jmp __il_cont
  __il_cont:
    x64.movsdRegRip xmm1, [rip + __fconst_1]
    x64.mulsdRegReg xmm0, xmm0, xmm1
    x64.cvttsd2siRegReg r8, xmm0
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
