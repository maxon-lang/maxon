// Test: int-literal-to-float-local
function main() returns ExitCode
	var scale = 0.0
	scale = 3
	if scale == 3.0 'exact'
		return trunc(scale * 14.0)
	end 'exact'
	return 7
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 3
    x64.cvtsi2sdRegReg xmm0, rax
    x64.movsdRegRip xmm1, [rip + __fconst_0]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc parity, ifcont
    x64.jmp fordered
  fordered:
    x64.jcc equal, exact
    x64.jmp ifcont
  exact:
    x64.movsdRegRip xmm1, [rip + __fconst_1]
    x64.mulsdRegReg xmm0, xmm0, xmm1
    x64.cvttsd2siRegReg r8, xmm0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 7
    x64.popReg rbp
    x64.ret
}
