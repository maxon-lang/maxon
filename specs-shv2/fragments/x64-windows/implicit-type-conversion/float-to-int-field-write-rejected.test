// Test: float-to-int-field-write-rejected
type Reading
	export var value as int = 0

	export static function make() returns Self
		return Self{}
	end 'make'
end 'Reading'

function main() returns ExitCode
	var r = Reading.make()
	r.value = 3.7
	return r.value
end 'main'
