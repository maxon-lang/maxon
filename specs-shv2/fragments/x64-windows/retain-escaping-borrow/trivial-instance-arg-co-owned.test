// Test: trivial-instance-arg-co-owned
typealias Integer = int(i64.min to i64.max)
type Box uses T
	export var item as T
	export static function create(v T) returns Self
		return Self{item: v}
	end 'create'
end 'Box'
typealias IntBox = Box with Integer
typealias BoxBox = Box with (Box with Integer)
function main() returns ExitCode
	var outer = BoxBox.create(IntBox.create(0))
	if true 'inner'
		let innerBox = IntBox.create(5)
		outer = BoxBox.create(innerBox)
	end 'inner'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Box.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 0
    x64.callDirect Box.create
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.movRegReg rcx, rbx
    x64.callDirect Box.create
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, inner
    x64.jmp critsplit
  inner:
    x64.movRegImm32 rcx, 5
    x64.callDirect Box.create
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.movRegReg rcx, rbx
    x64.callDirect Box.create
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Box_Box_Integer
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r13
    x64.jmp ifcont
  critsplit:
    x64.movRegReg rcx, r12
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 rbx, 0
    x64.callDirect __destruct_Box_Box_Integer
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
