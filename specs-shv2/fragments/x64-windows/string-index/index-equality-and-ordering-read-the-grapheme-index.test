// Test: index-equality-and-ordering-read-the-grapheme-index
function main() returns ExitCode
	let s = "abcdefghijklm"
	let start = s.startIndex()
	let g = try s.findFirst("ghij") otherwise s.endIndex()
	if start < g 'ordered'
		print("lt\n")
	end 'ordered' else 'notOrdered'
		print("NOT lt\n")
	end 'notOrdered'
	if start == s.startIndex() 'same'
		print("eq\n")
	end 'same' else 'different'
		print("NOT eq\n")
	end 'different'
	if g == start 'wrong'
		print("BAD eq\n")
	end 'wrong' else 'right'
		print("ne\n")
	end 'right'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.leaRegRdata rbx, [rip + __str_rec_8]
    x64.movRegReg rcx, rbx
    x64.callDirect String.startIndex
    x64.movRegReg r12, r8
    x64.leaRegRdata rdx, [rip + __str_rec_9]
    x64.movRegReg rcx, rbx
    x64.callDirect String.findFirst
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegReg rcx, rbx
    x64.callDirect String.endIndex
    x64.movRegReg r13, r8
    x64.jmp trycont
  tryok:
    x64.movRegReg r13, r8
  trycont:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.loadRegBaseDisp.word64 rcx, [r13 + 0]
    x64.cmpRegReg rax, rcx
    x64.jcc aboveEqual, ifelse#5
  ordered:
    x64.leaRegRdata rcx, [rip + __str_rec_10]
    x64.callDirect print
    x64.jmp ifcont#6
  ifelse#5:
    x64.leaRegRdata rcx, [rip + __str_rec_11]
    x64.callDirect print
  ifcont#6:
    x64.movRegReg rcx, rbx
    x64.callDirect String.startIndex
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.loadRegBaseDisp.word64 rcx, [r8 + 0]
    x64.cmpRegReg rax, rcx
    x64.setccReg equal, rbx
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc equal, ifelse#8
  same:
    x64.leaRegRdata rcx, [rip + __str_rec_12]
    x64.callDirect print
    x64.jmp ifcont#9
  ifelse#8:
    x64.leaRegRdata rcx, [rip + __str_rec_13]
    x64.callDirect print
  ifcont#9:
    x64.loadRegBaseDisp.word64 rax, [r13 + 0]
    x64.loadRegBaseDisp.word64 rcx, [r12 + 0]
    x64.cmpRegReg rax, rcx
    x64.jcc notEqual, ifelse#11
  wrong:
    x64.leaRegRdata rcx, [rip + __str_rec_14]
    x64.callDirect print
    x64.jmp ifcont#12
  ifelse#11:
    x64.leaRegRdata rcx, [rip + __str_rec_15]
    x64.callDirect print
  ifcont#12:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
