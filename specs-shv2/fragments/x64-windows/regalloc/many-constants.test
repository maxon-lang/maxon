// Test: many-constants
typealias Integer = int(i64.min to i64.max)

function ident(x Integer) returns Integer
	return x
end 'ident'

function main() returns ExitCode
	let args = CommandLine.args()
	let seed = try int.fromString(try args.get(1) otherwise "0") otherwise 0

	// 4 working values that live across the body — opaque w.r.t. the
	// constant folder thanks to the runtime seed. The body below uses
	// each one with many distinct constants; pre-Phase-1 each constant
	// would compete with the working values for a register slot,
	// inflating pressure. Post-Phase-1 each constant rematerializes at
	// its use site, so v1..v4 + a couple of scratch reg are enough.
	let v1 = ident(seed + 11)
	let v2 = ident(seed + 22)
	let v3 = ident(seed + 33)
	let v4 = ident(seed + 44)

	// Many distinct constants combined with the working values.
	var total = 0
	total = total + (v1 and 255)
	total = total + (v2 and 61680)
	total = total + (v3 and 1193046)
	total = total + (v4 and 286265908)
	total = total + (v1 or 256)
	total = total + (v2 or 8192)
	total = total + (v3 or 196608)
	total = total + (v4 or 4194304)
	total = total + (v1 xor 21930)
	total = total + (v2 xor 2147483647)
	total = total + (v3 + 65536)
	total = total + (v4 + 131072)
	total = total + (v1 + 1234567)
	total = total + (v2 + 7654321)
	total = total + (v3 - 1048576)
	total = total + (v4 - 2097152)

	let masked = total and 255
	return masked as ExitCode
end 'main'
---
ExitCode: 102
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect CommandLine.args
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 1
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rax, 1
    x64.jcc belowEqual, __im_slow
  __im_load:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.leaRegRegImm32 rax, rax, 8
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rsi, [rbx + 40]
    x64.cmpRegImm32 rsi, 0
    x64.jcc equal, critsplit#22
  __im_empty:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, critsplit#23
  __im_slow:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.jmp __im_cont
  critsplit#23:
    x64.movRegReg r8, rax
    x64.movRegReg r10, rcx
    x64.jmp __im_cont
  critsplit#22:
    x64.movRegReg r8, rax
    x64.movRegReg r10, rcx
  __im_cont:
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#1
  tryerr#2:
    x64.leaRegRdata rcx, [rip + __str_rec_1]  ; "0"
    x64.jmp trycont#3
  tryok#1:
    x64.movRegReg rcx, r8
  trycont#3:
    x64.callDirect __int_fromString
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#4
  tryerr#5:
    x64.movRegImm32 rax, 0
    x64.jmp trycont#6
  tryok#4:
    x64.movRegReg rax, r8
  trycont#6:
    x64.leaRegRegImm32 rcx, rax, 11
  __il_cont#17:
    x64.leaRegRegImm32 rdx, rax, 22
  __il_cont#16:
    x64.leaRegRegImm32 rsi, rax, 33
  __il_cont#15:
    x64.leaRegRegImm32 rax, rax, 44
  __il_cont#14:
    x64.movRegReg rdi, rcx
    x64.andRegImm32 rdi, rcx, 255
    x64.movRegReg r8, rdx
    x64.andRegImm32 r8, rdx, 61680
    x64.leaRegRegReg rdi, rdi, r8
    x64.movRegReg r8, rsi
    x64.andRegImm32 r8, rsi, 1193046
    x64.leaRegRegReg rdi, rdi, r8
    x64.movRegReg r8, rax
    x64.andRegImm32 r8, rax, 286265908
    x64.leaRegRegReg rdi, rdi, r8
    x64.movRegReg r8, rcx
    x64.orRegImm32 r8, rcx, 256
    x64.leaRegRegReg rdi, rdi, r8
    x64.movRegReg r8, rdx
    x64.orRegImm32 r8, rdx, 8192
    x64.leaRegRegReg rdi, rdi, r8
    x64.movRegReg r8, rsi
    x64.orRegImm32 r8, rsi, 196608
    x64.leaRegRegReg rdi, rdi, r8
    x64.movRegReg r8, rax
    x64.orRegImm32 r8, rax, 4194304
    x64.leaRegRegReg rdi, rdi, r8
    x64.movRegReg r8, rcx
    x64.xorRegImm32 r8, rcx, 21930
    x64.leaRegRegReg rdi, rdi, r8
    x64.movRegReg r8, rdx
    x64.xorRegImm32 r8, rdx, 2147483647
    x64.leaRegRegReg rdi, rdi, r8
    x64.leaRegRegImm32 r8, rsi, 65536
    x64.leaRegRegReg rdi, rdi, r8
    x64.leaRegRegImm32 r8, rax, 131072
    x64.leaRegRegReg rdi, rdi, r8
    x64.leaRegRegImm32 rcx, rcx, 1234567
    x64.leaRegRegReg rcx, rdi, rcx
    x64.leaRegRegImm32 rdx, rdx, 7654321
    x64.leaRegRegReg rcx, rcx, rdx
    x64.leaRegRegImm32 rdx, rsi, -1048576
    x64.leaRegRegReg rcx, rcx, rdx
    x64.leaRegRegImm32 rax, rax, -2097152
    x64.leaRegRegReg r12, rcx, rax
    x64.andRegImm32 r12, r12, 255
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_11]  ; "panic at many-constants.test:43: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
