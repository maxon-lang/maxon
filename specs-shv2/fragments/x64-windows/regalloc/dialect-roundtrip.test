// Test: dialect-roundtrip
typealias Integer = int(i64.min to i64.max)

function ident(x Integer) returns Integer
	return x
end 'ident'

function main() returns ExitCode
	let args = CommandLine.args()
	let seed = try int.fromString(try args.get(1) otherwise "0") otherwise 0

	// Two values defined via opaque calls so the constant folder cannot
	// see through them. Each combines with a small set of distinct masks
	// using and/or/xor/cmp — the exact ALU mix that Phase 3 will eventually
	// fold into addRegMem / andRegMem / xorRegMem when the values spill.
	let v1 = ident(seed + 7)
	let v2 = ident(seed + 13)

	var acc = 0
	acc = acc + (v1 and 255)
	acc = acc + (v2 or 4096)
	acc = acc + (v1 xor 21845)
	acc = acc + (v2 + 1)

	let masked = acc and 255
	return masked as ExitCode
end 'main'
---
ExitCode: 116
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect CommandLine.args
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 1
    x64.loadRegBaseDisp.word64 rax, [rbx + 24]
    x64.cmpRegImm32 rax, 8
    x64.jcc equal, __im_word
    x64.jmp __im_stride
  __im_word:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rdx, 0
    x64.setccReg less, rcx
    x64.cmpRegImm32 rax, 1
    x64.setccReg lessEqual, rax
    x64.orRegReg rcx, rcx, rax
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, __il_slow
    x64.jmp __im_load#20
  __im_load#20:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.imulRegRegImm32 rcx, rdx, 8
    x64.leaRegRegReg rax, rax, rcx
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.jmp __im_loaded
  __im_stride:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, __im_byte
    x64.jmp __il_slow
  __im_byte:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rdx, 0
    x64.setccReg less, rcx
    x64.cmpRegImm32 rax, 1
    x64.setccReg lessEqual, rax
    x64.orRegReg rcx, rcx, rax
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, __il_slow
    x64.jmp __im_load#21
  __im_load#21:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.leaRegRegReg rax, rax, rdx
    x64.loadRegBaseDisp.byte rax, [rax + 0]
    x64.jmp __im_loaded
  __im_loaded:
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rsi, [rbx + 40]
    x64.cmpRegImm32 rsi, 0
    x64.jcc notEqual, __im_empty
    x64.jmp critsplit#23
  __im_empty:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __il_slow
    x64.jmp critsplit#24
  critsplit#24:
    x64.jmp __il_cont#14
  critsplit#23:
    x64.jmp __il_cont#14
  __il_slow:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.movRegReg rax, r8
    x64.movRegReg rcx, r10
    x64.jmp __il_cont#14
  __il_cont#14:
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, tryerr#2
    x64.jmp tryok#1
  tryerr#2:
    x64.leaRegRdata rcx, [rip + __str_rec_1]
    x64.jmp trycont#3
  tryok#1:
    x64.movRegReg rcx, rax
    x64.jmp trycont#3
  trycont#3:
    x64.callDirect __int_fromString
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#5
    x64.jmp tryok#4
  tryerr#5:
    x64.movRegImm32 rax, 0
    x64.jmp trycont#6
  tryok#4:
    x64.movRegReg rax, r8
    x64.jmp trycont#6
  trycont#6:
    x64.leaRegRegImm32 rcx, rax, 7
    x64.jmp __il_body#12
  __il_body#12:
    x64.jmp __il_cont#11
  __il_cont#11:
    x64.leaRegRegImm32 rax, rax, 13
    x64.jmp __il_body#13
  __il_body#13:
    x64.jmp __il_cont#10
  __il_cont#10:
    x64.movRegReg rdx, rcx
    x64.andRegImm32 rdx, rcx, 255
    x64.movRegReg rsi, rax
    x64.orRegImm32 rsi, rax, 4096
    x64.leaRegRegReg rdx, rdx, rsi
    x64.xorRegImm32 rcx, rcx, 21845
    x64.leaRegRegReg rcx, rdx, rcx
    x64.leaRegRegImm32 rax, rax, 1
    x64.leaRegRegReg r12, rcx, rax
    x64.andRegImm32 r12, r12, 255
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_11]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
