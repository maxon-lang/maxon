// Test: closer-case-member-in-else-if-chain
enum Kw
	alpha
	end
	omega
end 'Kw'

function tagOf(k Kw) returns int
	match k 'm'
		alpha then return 1
		end then return 2
		omega then return 3
	end 'm'
end 'tagOf'

function main() returns ExitCode
	if tagOf(Kw.end) == 1 'first'
		return 1
	end 'first' else if tagOf(Kw.end) == 2 'second'
		return 42
	end 'second' else 'rest'
		return 3
	end 'rest'
end 'main'
---
ExitCode: 42
---
func @tagOf {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, matcharm#1
    x64.jmp matchnext#5
  matcharm#1:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  matchnext#5:
    x64.cmpRegImm32 rcx, 1
    x64.jcc equal, matcharm#2
    x64.jmp matchnext#6
  matcharm#2:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  matchnext#6:
    x64.cmpRegImm32 rcx, 2
    x64.jcc equal, matcharm#3
    x64.jmp matchdead
  matcharm#3:
    x64.movRegImm32 r8, 3
    x64.popReg rbp
    x64.ret
  matchdead:
  matchcont:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 1
    x64.callDirect tagOf
    x64.cmpRegImm32 r8, 1
    x64.jcc equal, first
    x64.jmp ifelse#2
  first:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifelse#2:
    x64.movRegImm32 rcx, 1
    x64.callDirect tagOf
    x64.cmpRegImm32 r8, 2
    x64.jcc equal, second
    x64.jmp ifelse#4
  second:
    x64.movRegImm32 r8, 42
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifelse#4:
    x64.movRegImm32 r8, 3
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#5:
  ifcont#6:
}
