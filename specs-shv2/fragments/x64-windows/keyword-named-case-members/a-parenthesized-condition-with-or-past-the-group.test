// Test: a-parenthesized-condition-with-or-past-the-group
function main() returns ExitCode
	var i = 0
	var acc = 0
	while ((i < 2) or (i < 0)) or false 'spin'
		if ((i == 0) or (i == 1)) and true 'inner'
			acc = acc + 21
		end 'inner'
		i = i + 1
	end 'spin'
	if acc == 42 'ok'
		return 42
	end 'ok'
	return 1
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 0
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegImm32 rax, 2
    x64.movRegImm32 rdx, 1
    x64.jcc less, critsplit#16
    x64.jmp orrhs#2
  critsplit#16:
    x64.jmp scmerge#3
  orrhs#2:
    x64.cmpRegImm32 rax, 0
    x64.setccReg less, rdx
    x64.jmp scmerge#3
  scmerge#3:
    x64.movRegImm32 rsi, 1
    x64.cmpRegImm32 rdx, 0
    x64.jcc notEqual, critsplit#17
    x64.jmp orrhs#4
  critsplit#17:
    x64.jmp scmerge#5
  orrhs#4:
    x64.movRegImm32 rdx, 0
    x64.movRegReg rsi, rdx
    x64.jmp scmerge#5
  scmerge#5:
    x64.cmpRegImm32 rsi, 0
    x64.jcc notEqual, spin
    x64.jmp whileexit
  spin:
    x64.cmpRegImm32 rax, 0
    x64.movRegImm32 rdx, 1
    x64.jcc equal, critsplit#18
    x64.jmp orrhs#8
  critsplit#18:
    x64.jmp scmerge#9
  orrhs#8:
    x64.cmpRegImm32 rax, 1
    x64.setccReg equal, rdx
    x64.jmp scmerge#9
  scmerge#9:
    x64.movRegImm32 rsi, 0
    x64.cmpRegImm32 rdx, 0
    x64.jcc notEqual, andrhs
    x64.jmp critsplit#19
  andrhs:
    x64.movRegImm32 rdx, 1
    x64.jmp scmerge#11
  critsplit#19:
    x64.movRegReg rdx, rsi
    x64.jmp scmerge#11
  scmerge#11:
    x64.cmpRegImm32 rdx, 0
    x64.jcc notEqual, inner
    x64.jmp critsplit#20
  inner:
    x64.leaRegRegImm32 rcx, rcx, 21
    x64.jmp ifcont#13
  critsplit#20:
    x64.jmp ifcont#13
  ifcont#13:
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp whilehdr
  whileexit:
    x64.cmpRegImm32 rcx, 42
    x64.jcc equal, ok
    x64.jmp ifcont#15
  ok:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
  ifcont#15:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}
