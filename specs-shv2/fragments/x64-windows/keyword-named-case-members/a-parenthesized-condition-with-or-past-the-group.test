// Test: a-parenthesized-condition-with-or-past-the-group
function main() returns ExitCode
	var i = 0
	var acc = 0
	while ((i < 2) or (i < 0)) or false 'spin'
		if ((i == 0) or (i == 1)) and true 'inner'
			acc = acc + 21
		end 'inner'
		i = i + 1
	end 'spin'
	if acc == 42 'ok'
		return 42
	end 'ok'
	return 1
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 0
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegImm32 rax, 2
    x64.movRegImm32 rdx, 1
    x64.jcc less, critsplit
    x64.jmp orrhs
  critsplit:
    x64.jmp scmerge
  orrhs:
    x64.cmpRegImm32 rax, 0
    x64.setccReg less, rdx
    x64.jmp scmerge
  scmerge:
    x64.movRegImm32 rsi, 1
    x64.cmpRegImm32 rdx, 0
    x64.jcc notEqual, critsplit
    x64.jmp orrhs
  critsplit:
    x64.jmp scmerge
  orrhs:
    x64.movRegImm32 rdx, 0
    x64.movRegReg rsi, rdx
    x64.jmp scmerge
  scmerge:
    x64.cmpRegImm32 rsi, 0
    x64.jcc notEqual, spin
    x64.jmp whileexit
  spin:
    x64.cmpRegImm32 rax, 0
    x64.movRegImm32 rdx, 1
    x64.jcc equal, critsplit
    x64.jmp orrhs
  critsplit:
    x64.jmp scmerge
  orrhs:
    x64.cmpRegImm32 rax, 1
    x64.setccReg equal, rdx
    x64.jmp scmerge
  scmerge:
    x64.movRegImm32 rsi, 0
    x64.cmpRegImm32 rdx, 0
    x64.jcc notEqual, andrhs
    x64.jmp critsplit
  andrhs:
    x64.movRegImm32 rdx, 1
    x64.jmp scmerge
  critsplit:
    x64.movRegReg rdx, rsi
    x64.jmp scmerge
  scmerge:
    x64.cmpRegImm32 rdx, 0
    x64.jcc notEqual, inner
    x64.jmp critsplit
  inner:
    x64.leaRegRegImm32 rcx, rcx, 21
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp whilehdr
  whileexit:
    x64.cmpRegImm32 rcx, 42
    x64.jcc equal, ok
    x64.jmp ifcont
  ok:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}
