// Test: closer-case-member-and-the-declaration-sweep
enum Kw
	alpha
	end
	omega
end 'Kw'

var counter = 10

function tagOf(k Kw) returns int
	match k 'm'
		alpha then return 1
		end then return 2
		omega then return 3
	end 'm'
end 'tagOf'

function shadowing() returns int
	let a = tagOf(Kw.end)
	var counter = 100
	counter = counter + 1
	return a + counter
end 'shadowing'

function main() returns ExitCode
	return (shadowing() + counter) as ExitCode
end 'main'
---
ExitCode: 113
---
data {
  __data_counter@0 = i64 10
}

func @shadowing {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 1
    x64.jmp __il_body
  __il_body:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#3
    x64.jmp matchnext#7
  matcharm#3:
    x64.movRegImm32 rax, 1
    x64.jmp __il_cont
  matchnext#7:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm#4
    x64.jmp matchnext#8
  matcharm#4:
    x64.movRegImm32 rax, 2
    x64.jmp __il_cont
  matchnext#8:
    x64.cmpRegImm32 rax, 2
    x64.jcc equal, matcharm#5
    x64.jmp matchdead
  matcharm#5:
    x64.movRegImm32 rax, 3
    x64.jmp __il_cont
  __il_cont:
    x64.movRegImm32 rcx, 100
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.leaRegRegReg r8, rax, rcx
    x64.popReg rbp
    x64.ret
  matchdead:
  matchcont:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect shadowing
    x64.leaRegGlobal rax, __data_counter
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegRegReg r8, r8, rax
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
