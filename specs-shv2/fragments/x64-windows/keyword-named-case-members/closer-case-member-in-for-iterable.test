// Test: closer-case-member-in-for-iterable
enum Kw
	alpha
	end
	omega
end 'Kw'

function tagOf(k Kw) returns int
	match k 'm'
		alpha then return 1
		end then return 2
		omega then return 3
	end 'm'
end 'tagOf'

function main() returns ExitCode
	var acc = 0
	for i in 0 upto tagOf(Kw.end) 'each'
		acc = acc + 10 + i
	end 'each'
	return acc as ExitCode
end 'main'
---
ExitCode: 21
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 r8, 0
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 1
  __il_body:
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, matchnext#14
  matcharm#10:
    x64.movRegImm32 rcx, 1
    x64.jmp forhdr
  matchnext#14:
    x64.cmpRegImm32 rcx, 1
    x64.jcc notEqual, matchnext#15
  matcharm#11:
    x64.movRegImm32 rcx, 2
    x64.jmp forhdr
  matchnext#15:
    x64.cmpRegImm32 rcx, 2
    x64.jcc notEqual, matchdead
  matcharm#12:
    x64.movRegImm32 rcx, 3
  forhdr:
    x64.cmpRegReg rax, rcx
    x64.jcc greaterEqual, forexit
  each:
    x64.leaRegRegImm32 rdx, r8, 10
    x64.leaRegRegReg r8, rdx, rax
  forstep:
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp forhdr
  forexit:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
  matchcont:
}
