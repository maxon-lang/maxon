// Test: closer-case-member-in-while-condition
enum Kw
	alpha
	end
	omega
end 'Kw'

function tagOf(k Kw) returns int
	match k 'm'
		alpha then return 1
		end then return 2
		omega then return 3
	end 'm'
end 'tagOf'

function main() returns ExitCode
	var n = 0
	var acc = 0
	while n < tagOf(Kw.end) 'spin'
		acc = acc + 10
		n = n + 1
	end 'spin'
	return acc as ExitCode
end 'main'
---
ExitCode: 20
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 0
    x64.movRegImm32 r8, 0
    x64.jmp whilehdr
  whilehdr:
    x64.movRegImm32 rcx, 1
    x64.jmp __il_body
  __il_body:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, matcharm#9
    x64.jmp matchnext#13
  matcharm#9:
    x64.movRegImm32 rcx, 1
    x64.jmp __il_cont
  matchnext#13:
    x64.cmpRegImm32 rcx, 1
    x64.jcc equal, matcharm#10
    x64.jmp matchnext#14
  matcharm#10:
    x64.movRegImm32 rcx, 2
    x64.jmp __il_cont
  matchnext#14:
    x64.cmpRegImm32 rcx, 2
    x64.jcc equal, matcharm#11
    x64.jmp matchdead
  matcharm#11:
    x64.movRegImm32 rcx, 3
    x64.jmp __il_cont
  __il_cont:
    x64.cmpRegReg rax, rcx
    x64.jcc less, spin
    x64.jmp whileexit
  spin:
    x64.leaRegRegImm32 r8, r8, 10
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp whilehdr
  whileexit:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
  matchcont:
}
