// Test: every-block-keyword-as-a-case-member
enum Kw
	if
	else
	end
	while
	match
	for
	otherwise
end 'Kw'

function tagOf(k Kw) returns int
	match k 'm'
		if then return 1
		else then return 2
		end then return 4
		while then return 8
		match then return 16
		for then return 32
		otherwise then return 64
	end 'm'
end 'tagOf'

function main() returns ExitCode
	var sum = 0
	if tagOf(Kw.if) == 1 'guard'
		sum = tagOf(Kw.if) + tagOf(Kw.else) + tagOf(Kw.end) + tagOf(Kw.while) + tagOf(Kw.match) + tagOf(Kw.for) + tagOf(Kw.otherwise)
	end 'guard'
	return sum as ExitCode
end 'main'
---
ExitCode: 127
---
func @tagOf {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.jumpTable rcx, default=matchdead [[0]=matcharm#1, [1]=matcharm#2, [2]=matcharm#3, [3]=matcharm#4, [4]=matcharm#5, [5]=matcharm#6, [6]=matcharm#7] @__jumptable_1
  matchdead:
  matcharm#1:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  matcharm#2:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  matcharm#3:
    x64.movRegImm32 r8, 4
    x64.popReg rbp
    x64.ret
  matcharm#4:
    x64.movRegImm32 r8, 8
    x64.popReg rbp
    x64.ret
  matcharm#5:
    x64.movRegImm32 r8, 16
    x64.popReg rbp
    x64.ret
  matcharm#6:
    x64.movRegImm32 r8, 32
    x64.popReg rbp
    x64.ret
  matcharm#7:
    x64.movRegImm32 r8, 64
    x64.popReg rbp
    x64.ret
  matchcont:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 0
    x64.callDirect tagOf
    x64.cmpRegImm32 r8, 1
    x64.jcc equal, guard
    x64.jmp critsplit
  guard:
    x64.movRegImm32 rcx, 0
    x64.callDirect tagOf
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 1
    x64.callDirect tagOf
    x64.leaRegRegReg rbx, rbx, r8
    x64.movRegImm32 rcx, 2
    x64.callDirect tagOf
    x64.leaRegRegReg rbx, rbx, r8
    x64.movRegImm32 rcx, 3
    x64.callDirect tagOf
    x64.leaRegRegReg rbx, rbx, r8
    x64.movRegImm32 rcx, 4
    x64.callDirect tagOf
    x64.leaRegRegReg rbx, rbx, r8
    x64.movRegImm32 rcx, 5
    x64.callDirect tagOf
    x64.leaRegRegReg rbx, rbx, r8
    x64.movRegImm32 rcx, 6
    x64.callDirect tagOf
    x64.leaRegRegReg r8, rbx, r8
    x64.jmp ifcont
  critsplit:
    x64.movRegReg r8, rbx
    x64.jmp ifcont
  ifcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
