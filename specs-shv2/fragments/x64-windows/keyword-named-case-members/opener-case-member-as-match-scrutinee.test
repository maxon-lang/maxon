// Test: opener-case-member-as-match-scrutinee
enum Kw
	alpha
	match
	omega
end 'Kw'

function main() returns ExitCode
	match Kw.match 'm'
		alpha then return 11
		match then return 22
		omega then return 33
	end 'm'
end 'main'
---
ExitCode: 22
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#1
    x64.jmp matchnext#5
  matcharm#1:
    x64.movRegImm32 r8, 11
    x64.popReg rbp
    x64.ret
  matchnext#5:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm#2
    x64.jmp matchnext#6
  matcharm#2:
    x64.movRegImm32 r8, 22
    x64.popReg rbp
    x64.ret
  matchnext#6:
    x64.cmpRegImm32 rax, 2
    x64.jcc equal, matcharm#3
    x64.jmp matchdead
  matcharm#3:
    x64.movRegImm32 r8, 33
    x64.popReg rbp
    x64.ret
  matchdead:
  matchcont:
}
