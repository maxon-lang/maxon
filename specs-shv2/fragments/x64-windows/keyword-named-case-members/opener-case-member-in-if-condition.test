// Test: opener-case-member-in-if-condition
enum Kw
	alpha
	while
	omega
end 'Kw'

function tagOf(k Kw) returns int
	match k 'm'
		alpha then return 1
		while then return 2
		omega then return 3
	end 'm'
end 'tagOf'

function main() returns ExitCode
	if tagOf(Kw.while) == 2 'ok'
		return 25
	end 'ok'
	return 1
end 'main'
---
ExitCode: 25
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 1
  __il_body:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext#9
  matcharm#5:
    x64.movRegImm32 rax, 1
    x64.jmp __il_cont
  matchnext#9:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchnext#10
  matcharm#6:
    x64.movRegImm32 rax, 2
    x64.jmp __il_cont
  matchnext#10:
    x64.cmpRegImm32 rax, 2
    x64.jcc notEqual, matchdead
  matcharm#7:
    x64.movRegImm32 rax, 3
  __il_cont:
    x64.cmpRegImm32 rax, 2
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 r8, 25
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  matchdead:
  matchcont:
}
