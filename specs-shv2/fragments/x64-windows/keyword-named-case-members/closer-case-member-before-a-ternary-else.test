// Test: closer-case-member-before-a-ternary-else
enum Kw
	alpha
	end
	omega
end 'Kw'

function main() returns ExitCode
	var acc = 0
	var i = 0
	while i < 2 'spin'
		let x = 1 if i == 0 or Kw.end == Kw.end else 2
		acc = acc + x
		i = i + 1
	end 'spin'
	return acc as ExitCode
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 r8, 0
    x64.movRegImm32 rax, 0
  whilehdr:
    x64.cmpRegImm32 rax, 2
    x64.jcc greaterEqual, whileexit
  spin:
    x64.cmpRegImm32 rax, 0
    x64.movRegImm32 rcx, 1
    x64.jcc equal, scmerge
  orrhs:
    x64.movRegImm32 rcx, 1
  scmerge:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, ternaryfalse
  ternarytrue:
    x64.movRegImm32 rcx, 1
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegImm32 rcx, 2
  matchcont:
    x64.leaRegRegReg r8, r8, rcx
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp whilehdr
  whileexit:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at closer-case-member-before-a-ternary-else.test:16: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
