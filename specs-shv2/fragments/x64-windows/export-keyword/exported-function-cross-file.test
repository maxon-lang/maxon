// Test: exported-function-cross-file
// --- file: api/helper.maxon
typealias Integer = int(i64.min to i64.max)

export function helper() returns Integer
	return 42
end 'helper'

// --- file: app/main.maxon
function main() returns ExitCode
	return helper()
end 'main'
---
ExitCode: 42
---
func @helper {
  entry:
    x64.movRegImm32 r8, 42
    x64.ret
}

func @main {
  entry:
    x64.prologue 40
    x64.callDirect helper
    x64.epilogue 40
    x64.ret
}
