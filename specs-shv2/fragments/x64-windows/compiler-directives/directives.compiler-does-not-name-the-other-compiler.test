// Test: directives.compiler-does-not-name-the-other-compiler
function main() returns ExitCode
	#if compiler(csharp)
		return 1
	#else
		return 34
	#endif
end 'main'
---
ExitCode: 34
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 34
    x64.popReg rbp
    x64.ret
}
