// Test: two-loops-later-one-overflows
function hot(_ int) returns int
	var pad = 0
	while pad < 3 'pad'
		pad = pad + 1
	end 'pad'
	var s1 = 1
	var s2 = 2
	var s3 = 3
	var s4 = 4
	var s5 = 5
	var s6 = 6
	var s7 = 7
	var s8 = 8
	var s9 = 9
	var s10 = 10
	var s11 = 11
	var s12 = 12
	var s13 = 13
	var s14 = 14
	var s15 = 15
	var s16 = 16
	var i = 0
	while i < 5 'loop'
		s1 = s1 + i
		s2 = s2 + i
		s3 = s3 + i
		s4 = s4 + i
		s5 = s5 + i
		s6 = s6 + i
		s7 = s7 + i
		s8 = s8 + i
		s9 = s9 + i
		s10 = s10 + i
		s11 = s11 + i
		s12 = s12 + i
		s13 = s13 + i
		s14 = s14 + i
		s15 = s15 + i
		s16 = s16 + i
		i = i + 1
	end 'loop'
	return pad + s1 + s2 + s3 + s4 + s5 + s6 + s7 + s8 + s9 + s10 + s11 + s12 + s13 + s14 + s15 + s16
end 'hot'

function main() returns ExitCode
	return hot(0)
end 'main'
---
CompilerError:
