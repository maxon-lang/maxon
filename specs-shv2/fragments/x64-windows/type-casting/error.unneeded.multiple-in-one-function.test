// Test: error.unneeded.multiple-in-one-function

typealias Byte = int(0 to u8.max)

function main() returns ExitCode
	let a = 1 as Byte
	let b = a as Byte
	let c = b as Byte
	let d = c as Byte
	return d
end 'main'
---
CompilerError:
error E3010: <fragment>:7:12: unneeded cast: 'Byte' already fits in 'Byte'
error E3010: <fragment>:8:12: unneeded cast: 'Byte' already fits in 'Byte'
error E3010: <fragment>:9:12: unneeded cast: 'Byte' already fits in 'Byte'
