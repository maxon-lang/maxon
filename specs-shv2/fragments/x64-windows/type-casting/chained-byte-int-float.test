// Test: chained-byte-int-float

typealias Float = float(f64.min to f64.max)
typealias Byte = int(0 to u8.max)

function toFloat(b Byte) returns Float
	return b + 0.0
end 'toFloat'

function main() returns ExitCode
	let b = 25 as Byte
	let f = toFloat(b)
	return trunc(f)
end 'main'
---
ExitCode: 25
---
func @toFloat {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 rcx, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movsdRegRip xmm0, [rip + __fconst_2]
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movsdRegRip xmm0, [rip + __fconst_2]
    x64.cvtsi2sdRegReg xmm1, rcx
    x64.addsdRegReg xmm1, xmm1, xmm0
    x64.movRegReg xmm0, xmm1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 25
    x64.jmp __il_body
  __il_body:
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __il_slow
    x64.jmp __rc_chk#7
  __rc_chk#7:
    x64.cmpRegImm32 rcx, 255
    x64.jcc greater, __il_slow
    x64.jmp __rc_ok#6
  __il_slow:
    x64.callDirect toFloat
    x64.jmp __il_cont
  __rc_ok#6:
    x64.movsdRegRip xmm0, [rip + __fconst_2]
    x64.cvtsi2sdRegReg xmm1, rcx
    x64.addsdRegReg xmm1, xmm1, xmm0
    x64.movRegReg xmm0, xmm1
    x64.jmp __il_cont
  __il_cont:
    x64.cvttsd2siRegReg r8, xmm0
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk#3
  __rc_chk#3:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok#1
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#1:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
