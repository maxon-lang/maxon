// Test: six-args-all-live-after-the-call
function digits6(p1 int, p2 int, p3 int, p4 int, p5 int, p6 int) returns int
	return p1 * 100000 + p2 * 10000 + p3 * 1000 + p4 * 100 + p5 * 10 + p6
end 'digits6'

function keepAll(a int, b int, c int, d int, e int, f int) returns int
	let r = digits6(f, p2: e, p3: d, p4: c, p5: b, p6: a)
	return r + a * 100000 + b * 10000 + c * 1000 + d * 100 + e * 10 + f
end 'keepAll'

function main() returns ExitCode
	let v = keepAll(1, b: 2, c: 3, d: 4, e: 5, f: 6)
	if v == 777777 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @digits6 {
  entry:
    x64.imulRegRegImm32 rcx, rcx, 100000
    x64.imulRegRegImm32 rdx, rdx, 10000
    x64.leaRegRegReg rcx, rcx, rdx
    x64.imulRegRegImm32 rax, rax, 1000
    x64.leaRegRegReg rax, rcx, rax
    x64.imulRegRegImm32 rcx, r9, 100
    x64.leaRegRegReg rax, rax, rcx
    x64.imulRegRegImm32 rcx, rsi, 10
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegRegReg r8, rax, rdi
    x64.ret
}

func @keepAll {
  entry:
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 48
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegReg r13, rax
    x64.movRegReg r14, r9
    x64.movRegReg r15, rsi
    x64.storeSlotReg slot0, rdi
    x64.movRegReg rcx, rdi
    x64.movRegReg rdx, r15
    x64.movRegReg rax, r14
    x64.movRegReg r9, r13
    x64.movRegReg rsi, r12
    x64.movRegReg rdi, rbx
    x64.callDirect digits6
    x64.imulRegRegImm32 rax, rbx, 100000
    x64.leaRegRegReg rax, r8, rax
    x64.imulRegRegImm32 rcx, r12, 10000
    x64.leaRegRegReg rax, rax, rcx
    x64.imulRegRegImm32 rcx, r13, 1000
    x64.leaRegRegReg rax, rax, rcx
    x64.imulRegRegImm32 rcx, r14, 100
    x64.leaRegRegReg rax, rax, rcx
    x64.imulRegRegImm32 rcx, r15, 10
    x64.leaRegRegReg rax, rax, rcx
    x64.loadRegSlot rcx, slot0
    x64.leaRegRegReg r8, rax, rcx
    x64.epilogue 48
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.ret
}

func @main {
  entry:
    x64.prologue 40
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 2
    x64.movRegImm32 rax, 3
    x64.movRegImm32 r9, 4
    x64.movRegImm32 rsi, 5
    x64.movRegImm32 rdi, 6
    x64.callDirect keepAll
    x64.cmpRegImm32 r8, 777777
    x64.jcc equal, ok
    x64.jmp ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.epilogue 40
    x64.ret
}
