// Test: reverse-six-params-across-an-idiv
function digits6(p1 int, p2 int, p3 int, p4 int, p5 int, p6 int) returns int
	return p1 * 100000 + p2 * 10000 + p3 * 1000 + p4 * 100 + p5 * 10 + p6
end 'digits6'

function divPermute(a int, b int, c int, d int, e int, f int) returns int
	let sum = a + b + c + d + e + f
	let q = sum / 2
	let r = digits6(f, p2: e, p3: d, p4: c, p5: b, p6: a)
	return r + q
end 'divPermute'

function main() returns ExitCode
	let v = divPermute(1, b: 2, c: 3, d: 4, e: 5, f: 6)
	if v == 654331 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @divPermute {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegReg r8, rdx
    x64.movRegReg r10, rax
    x64.leaRegRegReg rax, rcx, r8
    x64.leaRegRegReg rax, rax, r10
    x64.leaRegRegReg rax, rax, r9
    x64.leaRegRegReg rax, rax, rsi
    x64.leaRegRegReg rax, rax, rdi
    x64.movRegImm32 r11, 2
    x64.cqo
    x64.idivReg r11
    x64.jmp __il_body
  __il_body:
    x64.imulRegRegImm32 rdx, rdi, 100000
    x64.imulRegRegImm32 rsi, rsi, 10000
    x64.leaRegRegReg rdx, rdx, rsi
    x64.imulRegRegImm32 rsi, r9, 1000
    x64.leaRegRegReg rdx, rdx, rsi
    x64.imulRegRegImm32 rsi, r10, 100
    x64.leaRegRegReg rdx, rdx, rsi
    x64.imulRegRegImm32 rsi, r8, 10
    x64.leaRegRegReg rdx, rdx, rsi
    x64.leaRegRegReg rcx, rdx, rcx
    x64.jmp __il_cont
  __il_cont:
    x64.leaRegRegReg r8, rcx, rax
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 2
    x64.movRegImm32 rax, 3
    x64.movRegImm32 r9, 4
    x64.movRegImm32 rsi, 5
    x64.movRegImm32 rdi, 6
    x64.callDirect divPermute
    x64.cmpRegImm32 r8, 654331
    x64.jcc equal, ok
    x64.jmp ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
