// Test: order-sensitive-body-through-a-reversal
function mix6(a int, b int, c int, d int, e int, f int) returns int
	return a - b * 2 + c * 3 - d * 4 + e * 5 - f * 6
end 'mix6'

function flip6(a int, b int, c int, d int, e int, f int) returns int
	return mix6(f, b: e, c: d, d: c, e: b, f: a)
end 'flip6'

function main() returns ExitCode
	let r = flip6(1, b: 20, c: 3, d: 30, e: 2, f: 40)
	if r == 208 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @mix6 {
  entry:
    x64.imulRegRegImm32 rdx, rdx, 2
    x64.subRegReg rcx, rcx, rdx
    x64.imulRegRegImm32 rax, rax, 3
    x64.leaRegRegReg rax, rcx, rax
    x64.imulRegRegImm32 rcx, r9, 4
    x64.subRegReg rax, rax, rcx
    x64.imulRegRegImm32 rcx, rsi, 5
    x64.leaRegRegReg r8, rax, rcx
    x64.imulRegRegImm32 rax, rdi, 6
    x64.subRegReg r8, r8, rax
    x64.ret
}

func @flip6 {
  entry:
    x64.prologue 40
    x64.movRegReg r8, rcx
    x64.movRegReg r10, rdx
    x64.movRegReg r11, rax
    x64.movRegReg rcx, rdi
    x64.movRegReg rdx, rsi
    x64.movRegReg rax, r9
    x64.movRegReg r9, r11
    x64.movRegReg rsi, r10
    x64.movRegReg rdi, r8
    x64.callDirect mix6
    x64.epilogue 40
    x64.ret
}

func @main {
  entry:
    x64.prologue 40
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 20
    x64.movRegImm32 rax, 3
    x64.movRegImm32 r9, 30
    x64.movRegImm32 rsi, 2
    x64.movRegImm32 rdi, 40
    x64.callDirect flip6
    x64.cmpRegImm32 r8, 208
    x64.jcc equal, ok
    x64.jmp ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.epilogue 40
    x64.ret
}
