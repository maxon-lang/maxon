// Test: reverse-six-params
function digits6(p1 int, p2 int, p3 int, p4 int, p5 int, p6 int) returns int
	return p1 * 100000 + p2 * 10000 + p3 * 1000 + p4 * 100 + p5 * 10 + p6
end 'digits6'

function reverse6(a int, b int, c int, d int, e int, f int) returns int
	return digits6(f, p2: e, p3: d, p4: c, p5: b, p6: a)
end 'reverse6'

function main() returns ExitCode
	let r = reverse6(1, b: 2, c: 3, d: 4, e: 5, f: 6)
	if r == 654321 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @digits6 {
  entry:
    x64.imulRegRegImm32 rcx, rcx, 100000
    x64.imulRegRegImm32 rdx, rdx, 10000
    x64.leaRegRegReg rcx, rcx, rdx
    x64.imulRegRegImm32 rax, rax, 1000
    x64.leaRegRegReg rax, rcx, rax
    x64.imulRegRegImm32 rcx, r9, 100
    x64.leaRegRegReg rax, rax, rcx
    x64.imulRegRegImm32 rcx, rsi, 10
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegRegReg r8, rax, rdi
    x64.ret
}

func @reverse6 {
  entry:
    x64.prologue 40
    x64.movRegReg r8, rcx
    x64.movRegReg r10, rdx
    x64.movRegReg r11, rax
    x64.movRegReg rcx, rdi
    x64.movRegReg rdx, rsi
    x64.movRegReg rax, r9
    x64.movRegReg r9, r11
    x64.movRegReg rsi, r10
    x64.movRegReg rdi, r8
    x64.callDirect digits6
    x64.epilogue 40
    x64.ret
}

func @main {
  entry:
    x64.prologue 40
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 2
    x64.movRegImm32 rax, 3
    x64.movRegImm32 r9, 4
    x64.movRegImm32 rsi, 5
    x64.movRegImm32 rdi, 6
    x64.callDirect reverse6
    x64.cmpRegImm32 r8, 654321
    x64.jcc equal, ok
    x64.jmp ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.epilogue 40
    x64.ret
}
