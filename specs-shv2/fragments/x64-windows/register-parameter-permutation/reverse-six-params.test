// Test: reverse-six-params
function digits6(p1 Integer, p2 Integer, p3 Integer, p4 Integer, p5 Integer, p6 Integer) returns Integer
	return p1 * 100000 + p2 * 10000 + p3 * 1000 + p4 * 100 + p5 * 10 + p6
end 'digits6'

function reverse6(a Integer, b Integer, c Integer, d Integer, e Integer, f Integer) returns Integer
	return digits6(f, p2: e, p3: d, p4: c, p5: b, p6: a)
end 'reverse6'

function main() returns ExitCode
	let r = reverse6(1, b: 2, c: 3, d: 4, e: 5, f: 6)
	if r == 654321 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
func @reverse6 {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.imulRegRegImm32 rdi, rdi, 100000
    x64.imulRegRegImm32 rsi, rsi, 10000
    x64.leaRegRegReg rsi, rdi, rsi
    x64.imulRegRegImm32 rdi, r9, 1000
    x64.leaRegRegReg rsi, rsi, rdi
    x64.imulRegRegImm32 rax, rax, 100
    x64.leaRegRegReg rax, rsi, rax
    x64.imulRegRegImm32 rdx, rdx, 10
    x64.leaRegRegReg rax, rax, rdx
    x64.leaRegRegReg r8, rax, rcx
  __il_cont:
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 2
    x64.movRegImm32 rax, 3
    x64.movRegImm32 r9, 4
    x64.movRegImm32 rsi, 5
    x64.movRegImm32 rdi, 6
    x64.callDirect reverse6
    x64.cmpRegImm32 r8, 654321
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
