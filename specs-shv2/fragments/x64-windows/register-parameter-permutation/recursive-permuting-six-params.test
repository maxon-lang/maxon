// Test: recursive-permuting-six-params
function rot(p1 int, p2 int, p3 int, p4 int, p5 int, n int) returns int
	if n <= 0 'base'
		return p1 * 10000 + p2 * 1000 + p3 * 100 + p4 * 10 + p5
	end 'base'
	return rot(p2, p2: p3, p3: p4, p4: p5, p5: p1, n: n - 1)
end 'rot'

function main() returns ExitCode
	let r = rot(1, p2: 2, p3: 3, p4: 4, p5: 5, n: 3)
	if r == 45123 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @rot {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegReg r8, rcx
    x64.cmpRegImm32 rdi, 0
    x64.jcc greater, ifcont
  base:
    x64.imulRegRegImm32 rcx, r8, 10000
    x64.imulRegRegImm32 rdx, rdx, 1000
    x64.leaRegRegReg rcx, rcx, rdx
    x64.imulRegRegImm32 rax, rax, 100
    x64.leaRegRegReg rax, rcx, rax
    x64.imulRegRegImm32 rcx, r9, 10
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegRegReg r8, rax, rsi
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.leaRegRegImm32 rdi, rdi, -1
    x64.movRegReg rcx, rdx
    x64.movRegReg rdx, rax
    x64.movRegReg rax, r9
    x64.movRegReg r9, rsi
    x64.movRegReg rsi, r8
    x64.callDirect rot
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 2
    x64.movRegImm32 rax, 3
    x64.movRegImm32 r9, 4
    x64.movRegImm32 rsi, 5
    x64.movRegImm32 rdi, 3
    x64.callDirect rot
    x64.cmpRegImm32 r8, 45123
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
