// Test: string-builder-append-allocates-no-record-per-append
function main() returns ExitCode
	var sb = StringBuilder.create()
	sb.append("ab")
	sb.append("cd")
	let s = sb.build()
	return s.byteLength() as ExitCode
end 'main'
---
ExitCode: 4
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
  __ds_base@24 = i64 0
  __ds_buf_size@32 = i64 0
  __ds_buf_mask@40 = i64 0
  __ds_start_ts@48 = i64 0
  __ds_lock@56 = i64 0
  __mm_alloc_id@64 = i64 0
}

