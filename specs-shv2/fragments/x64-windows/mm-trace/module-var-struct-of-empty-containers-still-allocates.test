// Test: module-var-struct-of-empty-containers-still-allocates
typealias Count = int(0 to 1000)
typealias CountArray = Array with Count
typealias NameArray = Array with String

type Facts
	export var counts as CountArray = CountArray.create()
	export var names as NameArray = NameArray.create()
	export static function create() returns Facts
		return Self{}
	end 'create'
end 'Facts'

var MutableFacts = Facts.create()

function main() returns ExitCode
	return (MutableFacts.counts.count() + MutableFacts.names.count()) as ExitCode
end 'main'
---
ExitCode: 0
---
data {
  __data_MutableFacts@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
  __ds_base@40 = i64 0
  __ds_buf_size@48 = i64 0
  __ds_buf_mask@56 = i64 0
  __ds_start_ts@64 = i64 0
  __ds_lock@72 = i64 0
  __mm_alloc_id@80 = i64 0
}

func @Facts.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect __fieldDefault#Facts#counts
    x64.movRegReg rbx, r8
    x64.callDirect __fieldDefault#Facts#names
    x64.movRegReg r12, r8
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 rax, 13
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.storeBaseDispReg.word64 [r8 + 8], r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegGlobal rax, __data_MutableFacts
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.leaRegGlobal rcx, __data_MutableFacts
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 8]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 8]
    x64.leaRegRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at module-var-struct-of-empty-containers-still-allocates.test:17: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @__fieldDefault#Facts#counts {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 2
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @__fieldDefault#Facts#names {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __str_decref]
    x64.callDirect __managed_create
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
