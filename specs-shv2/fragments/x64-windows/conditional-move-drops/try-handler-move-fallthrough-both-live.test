  __rc_chk:
    x64.cmpRegImm32 rbx, 125
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_12]  ; "panic at try-handler-move-fallthrough-both-live.test:19: Range check failed: value outside typealias 'Code'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
