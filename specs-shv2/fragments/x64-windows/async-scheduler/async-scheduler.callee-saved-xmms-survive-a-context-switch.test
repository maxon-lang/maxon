func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 48
    x64.storeSlotReg slot0, xmm6
    x64.storeSlotReg slot1, xmm7
    x64.movsdRegRip xmm6, [rip + __fconst_22]
    x64.movsdRegRip xmm7, [rip + __fconst_23]
    x64.leaRegFunc rcx, [rip + threadA]
    x64.callDirect __gt_spawn
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __gt_ready
    x64.leaRegFunc rcx, [rip + threadB]
    x64.callDirect __gt_spawn
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.callDirect __gt_ready
    x64.movRegReg rcx, rbx
    x64.callDirect __gt_await
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, r12
    x64.callDirect __gt_await
    x64.cvttsd2siRegReg rax, xmm6
    x64.cvttsd2siRegReg rcx, xmm7
    x64.leaRegRegReg rax, rax, rcx
    x64.cmpRegImm32 rbx, 79
    x64.movRegImm32 rcx, 0
    x64.jcc notEqual, scmerge#2
  andrhs#1:
    x64.cmpRegImm32 r8, 7702
    x64.setccReg equal, rcx
  scmerge#2:
    x64.movRegImm32 rdx, 0
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, critsplit
  andrhs#3:
    x64.cmpRegImm32 rax, 33
    x64.setccReg equal, rax
    x64.jmp scmerge#4
  critsplit:
    x64.movRegReg rax, rdx
  scmerge#4:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.loadRegSlot xmm6, slot0
    x64.loadRegSlot xmm7, slot1
    x64.epilogue 48
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 9
    x64.loadRegSlot xmm6, slot0
    x64.loadRegSlot xmm7, slot1
    x64.epilogue 48
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
