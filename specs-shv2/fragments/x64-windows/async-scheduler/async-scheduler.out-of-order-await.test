// Test: async-scheduler.out-of-order-await

function w(x int) returns int
	Runtime.yield()
	return x * 10
end 'w'

function main() returns ExitCode
	let p1 = async w(1)
	let p2 = async w(2)
	let r2 = await p2
	let p3 = async w(3)
	let p4 = async w(4)
	let r3 = await p3
	let r4 = await p4
	let r1 = await p1
	return (r1 + r2 + r3 + r4) as ExitCode
end 'main'
---
ExitCode: 100
---
data {
  __mm_alloc_count@0 = i64 0
  __gt_run_queue_head@8 = i64 0
  __gt_run_queue_tail@16 = i64 0
  __gt_init_done@24 = i64 0
  __gt_timer_count@32 = i64 0
  __gt_timer_heap_base@40 = i64 0
  __gt_timer_capacity@48 = i64 0
  __gt_trace_counter@56 = i64 0
  __gt_proc_count@64 = i64 0
  __gt_proc_handles_base@72 = i64 0
  __gt_proc_gts_base@80 = i64 0
  __gt_live_count@88 = i64 0
  __sched_active_workers@96 = i64 1
  __sched_max_active_workers@104 = i64 1
  __sched_tls_index@112 = i64 0
  __sched_tls_teb_offset@120 = i64 0
  __sched_procs@128 = i64 0
  __sched_num_procs@136 = i64 0
  __sched_shutdown_flag@144 = i64 0
  __sched_lock@152 = i64 0
  __slab_arena_list@160 = i64 0
  __slab_arena_map_l1@168 = i64 0
  __slab_state@176 = i64 0
}

func @w {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.callDirect Runtime.yield
    x64.imulRegRegImm32 r8, rbx, 10
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegImm32 rbx, 1
    x64.leaRegFunc rcx, [rip + w]
    x64.callDirect __gt_spawn
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 200], rbx
    x64.movRegReg rcx, r12
    x64.callDirect __gt_ready
    x64.movRegImm32 rbx, 2
    x64.leaRegFunc rcx, [rip + w]
    x64.callDirect __gt_spawn
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 200], rbx
    x64.movRegReg rcx, r13
    x64.callDirect __gt_ready
    x64.movRegReg rcx, r13
    x64.callDirect __gt_await
    x64.movRegReg rbx, r8
    x64.movRegImm32 r13, 3
    x64.leaRegFunc rcx, [rip + w]
    x64.callDirect __gt_spawn
    x64.movRegReg r14, r8
    x64.storeBaseDispReg.word64 [r14 + 200], r13
    x64.movRegReg rcx, r14
    x64.callDirect __gt_ready
    x64.movRegImm32 r13, 4
    x64.leaRegFunc rcx, [rip + w]
    x64.callDirect __gt_spawn
    x64.movRegReg r15, r8
    x64.storeBaseDispReg.word64 [r15 + 200], r13
    x64.movRegReg rcx, r15
    x64.callDirect __gt_ready
    x64.movRegReg rcx, r14
    x64.callDirect __gt_await
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r15
    x64.callDirect __gt_await
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r12
    x64.callDirect __gt_await
    x64.leaRegRegReg rax, r8, rbx
    x64.leaRegRegReg rax, rax, r13
    x64.leaRegRegReg r8, rax, r14
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
