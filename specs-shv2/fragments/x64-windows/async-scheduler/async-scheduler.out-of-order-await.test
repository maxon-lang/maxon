// Test: async-scheduler.out-of-order-await

function w(x int) returns int
	Runtime.yield()
	return x * 10
end 'w'

function main() returns ExitCode
	let p1 = async w(1)
	let p2 = async w(2)
	let r2 = await p2
	let p3 = async w(3)
	let p4 = async w(4)
	let r3 = await p3
	let r4 = await p4
	let r1 = await p1
	return (r1 + r2 + r3 + r4) as ExitCode
end 'main'
---
ExitCode: 100
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
  __gt_current_gt@24 = i64 0
  __gt_run_queue_head@32 = i64 0
  __gt_run_queue_tail@40 = i64 0
  __gt_init_done@48 = i64 0
  __gt_system_stack_top@56 = i64 0
  __gt_timer_count@64 = i64 0
  __gt_timer_heap_base@72 = i64 0
  __gt_timer_capacity@80 = i64 0
  __gt_trace_counter@88 = i64 0
  __gt_trace_digits@96 = i64 0
  __gt_clock_ticks@104 = i64 0
  __gt_clock_freq@112 = i64 0
  __gt_proc_count@120 = i64 0
  __gt_proc_handles_base@128 = i64 0
  __gt_proc_gts_base@136 = i64 0
  __gt_free_list_head@144 = i64 0
  __gt_live_count@152 = i64 0
  __gt_startup_base@160 = i64 0
  __gt_procinfo_base@168 = i64 0
  __gt_exitcode_base@176 = i64 0
  __gt_cmdline_buf_base@184 = i64 0
  __gt_cmdline_buf_cap@192 = i64 0
}

func @w {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.callDirect Runtime.yield
    x64.imulRegRegImm32 r8, rbx, 10
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegImm32 rbx, 1
    x64.leaRegFunc rcx, [rip + w]
    x64.callDirect __gt_spawn
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 192], rbx
    x64.movRegImm32 rbx, 2
    x64.leaRegFunc rcx, [rip + w]
    x64.callDirect __gt_spawn
    x64.storeBaseDispReg.word64 [r8 + 192], rbx
    x64.movRegReg rcx, r8
    x64.callDirect __gt_await
    x64.movRegReg rbx, r8
    x64.movRegImm32 r13, 3
    x64.leaRegFunc rcx, [rip + w]
    x64.callDirect __gt_spawn
    x64.movRegReg r14, r8
    x64.storeBaseDispReg.word64 [r14 + 192], r13
    x64.movRegImm32 r13, 4
    x64.leaRegFunc rcx, [rip + w]
    x64.callDirect __gt_spawn
    x64.movRegReg r15, r8
    x64.storeBaseDispReg.word64 [r15 + 192], r13
    x64.movRegReg rcx, r14
    x64.callDirect __gt_await
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r15
    x64.callDirect __gt_await
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r12
    x64.callDirect __gt_await
    x64.leaRegRegReg rax, r8, rbx
    x64.leaRegRegReg rax, rax, r13
    x64.leaRegRegReg r8, rax, r14
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Runtime.yield {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __gt_resched
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
