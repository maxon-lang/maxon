// Test: async-scheduler.multiple-args

function combine(a int, b int, c int) returns int
	return a + b * c
end 'combine'

function main() returns ExitCode
	let p = async combine(2, b: 4, c: 10)
	let r = await p
	return r as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
  __gt_current_gt@24 = i64 0
  __gt_run_queue_head@32 = i64 0
  __gt_run_queue_tail@40 = i64 0
  __gt_init_done@48 = i64 0
  __gt_system_stack_top@56 = i64 0
  __gt_timer_count@64 = i64 0
  __gt_timer_heap_base@72 = i64 0
  __gt_clock_ticks@80 = i64 0
  __gt_clock_freq@88 = i64 0
  __gt_proc_count@96 = i64 0
  __gt_proc_handles_base@104 = i64 0
  __gt_proc_gts_base@112 = i64 0
  __gt_free_list_head@120 = i64 0
  __gt_live_count@128 = i64 0
  __gt_startup_base@136 = i64 0
  __gt_procinfo_base@144 = i64 0
  __gt_exitcode_base@152 = i64 0
  __gt_cmdline_buf_base@160 = i64 0
  __gt_cmdline_buf_cap@168 = i64 0
}

func @combine {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.imulRegReg rdx, rdx, rax
    x64.leaRegRegReg r8, rcx, rdx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 2
    x64.movRegImm32 r12, 4
    x64.movRegImm32 r13, 10
    x64.leaRegFunc rcx, [rip + combine]
    x64.callDirect __gt_spawn
    x64.storeBaseDispReg.word64 [r8 + 176], rbx
    x64.storeBaseDispReg.word64 [r8 + 184], r12
    x64.storeBaseDispReg.word64 [r8 + 192], r13
    x64.movRegReg rcx, r8
    x64.callDirect __gt_await
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
