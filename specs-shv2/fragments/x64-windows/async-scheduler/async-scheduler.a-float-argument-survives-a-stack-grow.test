// Test: async-scheduler.a-float-argument-survives-a-stack-grow
function scale(x Real, depth Integer) returns Integer
	if depth == 0 'base'
		return trunc(x)
	end 'base'
	return trunc(x) + scale(x * 2.0, depth: depth - 1)
end 'scale'

function sweep() returns Integer
	Runtime.yield()
	let d0 = scale(20.0, depth: 0)
	if d0 != 20 'bad0'
		return 1
	end 'bad0'

	let d1 = scale(20.0, depth: 1)
	if d1 != 60 'bad1'
		return 2
	end 'bad1'

	let d2 = scale(20.0, depth: 2)
	if d2 != 140 'bad2'
		return 3
	end 'bad2'

	let d3 = scale(20.0, depth: 3)
	if d3 != 300 'bad3'
		return 4
	end 'bad3'

	return 0
end 'sweep'

function main() returns ExitCode
	let p = async sweep()
	let r = await p
	return r as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
typealias Real = float(f64.min to f64.max)
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __gt_run_queue_head@8 = i64 0
  __gt_run_queue_tail@16 = i64 0
  __gt_init_done@24 = i64 0
  __gt_timer_count@32 = i64 0
  __gt_timer_heap_base@40 = i64 0
  __gt_timer_capacity@48 = i64 0
  __gt_trace_counter@56 = i64 0
  __gt_proc_count@64 = i64 0
  __gt_proc_handles_base@72 = i64 0
  __gt_proc_gts_base@80 = i64 0
  __gt_proc_wait_snapshot@88 = i64 0
  __gt_proc_poller@96 = i64 0
  __gt_live_count@104 = i64 0
  __sched_progress@112 = i64 0
  __sched_active_workers@120 = i64 1
  __sched_max_active_workers@128 = i64 1
  __sched_tls_index@136 = i64 0
  __sched_tls_teb_offset@144 = i64 0
  __sched_procs@152 = i64 0
  __sched_allm@160 = i64 0
  __sched_midle@168 = i64 0
  __sched_pidle@176 = i64 0
  __sched_num_procs@184 = i64 0
  __sched_shutdown_flag@192 = i64 0
  __sched_lock@200 = i64 0
  __sched_nmspinning@208 = i64 0
  __sched_parked_drivers@216 = i64 0
  __slab_arena_list@224 = i64 0
  __slab_arena_map_l1@232 = i64 0
  __slab_state@240 = i64 0
}

func @scale {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, ifcont
  base:
    x64.cvttsd2siRegReg r8, xmm0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.cvttsd2siRegReg rbx, xmm0
    x64.movsdRegRip xmm1, [rip + __fconst_2]
    x64.mulsdRegReg xmm0, xmm0, xmm1
    x64.leaRegRegImm32 rcx, rcx, -1
    x64.callDirect scale
    x64.leaRegRegReg r8, rbx, r8
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @sweep {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect Runtime.yield
    x64.movsdRegRip xmm0, [rip + __fconst_20]
    x64.movRegImm32 rcx, 0
    x64.callDirect scale
    x64.cmpRegImm32 r8, 20
    x64.jcc equal, ifcont#2
  bad0:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movsdRegRip xmm0, [rip + __fconst_20]
    x64.movRegImm32 rcx, 1
    x64.callDirect scale
    x64.cmpRegImm32 r8, 60
    x64.jcc equal, ifcont#4
  bad1:
    x64.movRegImm32 r8, 2
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movsdRegRip xmm0, [rip + __fconst_20]
    x64.movRegImm32 rcx, 2
    x64.callDirect scale
    x64.cmpRegImm32 r8, 140
    x64.jcc equal, ifcont#6
  bad2:
    x64.movRegImm32 r8, 3
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.movsdRegRip xmm0, [rip + __fconst_20]
    x64.movRegImm32 rcx, 3
    x64.callDirect scale
    x64.cmpRegImm32 r8, 300
    x64.jcc equal, ifcont#8
  bad3:
    x64.movRegImm32 r8, 4
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#8:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.leaRegFunc rcx, [rip + sweep]
    x64.callDirect __gt_spawn
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __gt_ready
    x64.movRegReg rcx, rbx
    x64.callDirect __gt_await
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at async-scheduler.a-float-argument-survives-a-stack-grow.test:37: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
