// Test: async-scheduler.await-loop-bounded

function noop() returns int
	return 0
end 'noop'

function main() returns ExitCode
	var i = 0
	var acc = 0
	while i < 5000 'loop'
		let p = async noop()
		let r = await p
		acc = acc + r
		i = i + 1
	end 'loop'
	return acc as ExitCode
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
  __gt_current_gt@24 = i64 0
  __gt_run_queue_head@32 = i64 0
  __gt_run_queue_tail@40 = i64 0
  __gt_init_done@48 = i64 0
  __gt_stack_free_head@56 = i64 0
  __gt_timer_count@64 = i64 0
  __gt_timer_heap_base@72 = i64 0
  __gt_clock_ticks@80 = i64 0
  __gt_clock_freq@88 = i64 0
  __gt_proc_count@96 = i64 0
  __gt_proc_handles_base@104 = i64 0
  __gt_proc_gts_base@112 = i64 0
}

func @noop {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 r12, 0
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegImm32 rbx, 5000
    x64.jcc less, loop
    x64.jmp whileexit
  loop:
    x64.movRegImm32 rcx, 48
    x64.callDirect __slab_alloc
    x64.leaRegFunc rcx, [rip + noop]
    x64.movRegReg rdx, r8
    x64.callDirect __gt_spawn
    x64.movRegReg rcx, r8
    x64.callDirect __gt_await
    x64.leaRegRegReg r12, r12, r8
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp whilehdr
  whileexit:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
