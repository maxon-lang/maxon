// Test: console-stdin.builtin-answers-zero-bytes-at-eof
function main() returns ExitCode
	let mm = __Builtins.readStdin(64)
	if mm.length() == 0 'eof'
		return 5
	end 'eof'
	return 1
end 'main'
---
ExitCode: 5
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 64
    x64.callDirect __con_read_stdin
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_count
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, eof
    x64.jmp ifcont
  eof:
    x64.movRegImm32 r12, 5
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
