// Test: console-stdin.read-line-at-eof-throws
function main() returns ExitCode
	var stdin = Console.stdin()
	let line = try stdin.readLine() otherwise 'atEof'
		return 9
	end 'atEof'
	print(line)
	return 1
end 'main'
