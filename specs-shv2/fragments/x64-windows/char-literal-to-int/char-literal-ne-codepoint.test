// Test: char-literal-ne-codepoint
function main() returns ExitCode
	let cp = 45
	if cp != '.' 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 45
    x64.cmpRegImm32 rax, 46
    x64.jcc equal, ifcont
  check:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}
