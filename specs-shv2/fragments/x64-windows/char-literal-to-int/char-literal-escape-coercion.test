// Test: char-literal-escape-coercion
function main() returns ExitCode
	let cp = 10
	if cp == '\n' 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  check:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
