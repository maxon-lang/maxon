// Test: char-literal-ge-le-codepoint
function main() returns ExitCode
	let cp = 53
	if cp >= '0' 'ge'
		if cp <= '9' 'le'
			return 0
		end 'le'
	end 'ge'
	return 1
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.movRegImm32 rax, 53
    x64.cmpRegImm32 rax, 48
    x64.jcc greaterEqual, ge
    x64.jmp ifcont
  ge:
    x64.cmpRegImm32 rax, 57
    x64.jcc lessEqual, le
    x64.jmp ifcont
  le:
    x64.movRegImm32 r8, 0
    x64.ret
  ifcont:
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 r8, 1
    x64.ret
}
