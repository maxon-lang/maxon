// Test: unqualified-call
function main() returns ExitCode
	let result = sqrt(16.0)
	return trunc(result)
end 'main'
---
ExitCode: 4
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movsdRegRip xmm0, [rip + __fconst_0]
    x64.sqrtsdRegReg xmm0, xmm0
    x64.cvttsd2siRegReg r8, xmm0
    x64.popReg rbp
    x64.ret
}
