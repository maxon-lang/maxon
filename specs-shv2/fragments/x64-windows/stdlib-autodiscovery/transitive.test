// Test: transitive
// pow -> log, exp
function main() returns ExitCode
	let result = Math.pow(2.0, exponent: 3.0)
	if result > 7.5 'check'
		return 8
	end 'check'
	return 0
end 'main'
---
ExitCode: 8
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movsdRegRip xmm0, [rip + __fconst_6]
    x64.movsdRegRip xmm1, [rip + __fconst_7]
    x64.callDirect Math.pow
    x64.movsdRegRip xmm1, [rip + __fconst_8]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc belowEqual, ifcont
  check:
    x64.movRegImm32 r8, 8
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
