    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 64
    x64.storeSlotReg slot0, xmm6
    x64.storeSlotReg slot1, xmm7
    x64.storeSlotReg slot2, xmm8
    x64.movRegReg xmm6, xmm0
    x64.movRegReg xmm7, xmm1
    x64.movsdRegRip xmm0, [rip + __fconst_9]
    x64.ucomisdRegReg xmm7, xmm0
    x64.jcc parity, ifcont
    x64.jmp fordered
  fordered:
    x64.jcc equal, exponentZero
    x64.jmp ifcont
  exponentZero:
    x64.movsdRegRip xmm0, [rip + __fconst_10]
    x64.loadRegSlot xmm6, slot0
    x64.loadRegSlot xmm7, slot1
    x64.loadRegSlot xmm8, slot2
    x64.epilogue 64
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movsdRegRip xmm0, [rip + __fconst_10]
    x64.ucomisdRegReg xmm6, xmm0
    x64.jcc parity, ifcont
    x64.jmp fordered
  fordered:
    x64.jcc equal, baseOne
    x64.jmp ifcont
  baseOne:
    x64.movsdRegRip xmm0, [rip + __fconst_10]
    x64.loadRegSlot xmm6, slot0
    x64.loadRegSlot xmm7, slot1
    x64.loadRegSlot xmm8, slot2
    x64.epilogue 64
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegReg xmm0, xmm6
    x64.callDirect Math.isNaN
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, critsplit
    x64.jmp orrhs
  critsplit:
    x64.jmp scmerge
  orrhs:
    x64.movRegReg xmm0, xmm7
    x64.callDirect Math.isNaN
    x64.movRegReg rax, r8
    x64.jmp scmerge
  scmerge:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, notANumber
    x64.jmp ifcont
  notANumber:
    x64.callDirect Math.quietNaN
    x64.loadRegSlot xmm6, slot0
    x64.loadRegSlot xmm7, slot1
    x64.loadRegSlot xmm8, slot2
    x64.epilogue 64
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegReg xmm0, xmm7
    x64.callDirect Math.isInfinite
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, infiniteExponent
    x64.jmp ifcont
  infiniteExponent:
    x64.movRegReg xmm0, xmm6
    x64.movRegReg xmm1, xmm7
    x64.callDirect Math.powOfInfiniteExponent
    x64.loadRegSlot xmm6, slot0
    x64.loadRegSlot xmm7, slot1
    x64.loadRegSlot xmm8, slot2
    x64.epilogue 64
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegReg xmm0, xmm6
    x64.callDirect Math.isInfinite
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, infiniteBase
    x64.jmp ifcont
  infiniteBase:
    x64.movRegImm32 rcx, 1
    x64.movRegReg xmm0, xmm6
    x64.movRegReg xmm1, xmm7
    x64.callDirect Math.powOfExtremeBase
    x64.loadRegSlot xmm6, slot0
    x64.loadRegSlot xmm7, slot1
    x64.loadRegSlot xmm8, slot2
    x64.epilogue 64
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movsdRegRip xmm0, [rip + __fconst_9]
    x64.ucomisdRegReg xmm6, xmm0
    x64.jcc parity, ifcont
    x64.jmp fordered
  fordered:
    x64.jcc equal, zeroBase
    x64.jmp ifcont
  zeroBase:
    x64.movRegImm32 rcx, 0
    x64.movRegReg xmm0, xmm6
    x64.movRegReg xmm1, xmm7
    x64.callDirect Math.powOfExtremeBase
    x64.loadRegSlot xmm6, slot0
    x64.loadRegSlot xmm7, slot1
    x64.loadRegSlot xmm8, slot2
    x64.epilogue 64
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movsdRegRip xmm0, [rip + __fconst_9]
    x64.ucomisdRegReg xmm0, xmm6
    x64.jcc above, negativeBase
    x64.jmp ifcont
  negativeBase:
    x64.movRegReg xmm0, xmm7
    x64.callDirect Math.isIntegerValue
    x64.xorRegImm32 r8, r8, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, nonIntegerExponent
    x64.jmp ifcont
  nonIntegerExponent:
    x64.callDirect Math.quietNaN
    x64.loadRegSlot xmm6, slot0
    x64.loadRegSlot xmm7, slot1
    x64.loadRegSlot xmm8, slot2
    x64.epilogue 64
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movsdRegRip xmm0, [rip + __fconst_9]
    x64.subsdRegReg xmm0, xmm0, xmm6
    x64.movRegReg xmm1, xmm7
    x64.callDirect Math.pow
    x64.movRegReg xmm6, xmm0
    x64.movRegReg xmm0, xmm7
    x64.callDirect Math.isOddIntegerValue
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, ternarytrue
    x64.jmp ternaryfalse
  ternarytrue:
    x64.movsdRegRip xmm0, [rip + __fconst_9]
    x64.subsdRegReg xmm0, xmm0, xmm6
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegReg xmm0, xmm6
    x64.jmp matchcont
  matchcont:
    x64.loadRegSlot xmm6, slot0
    x64.loadRegSlot xmm7, slot1
    x64.loadRegSlot xmm8, slot2
    x64.epilogue 64
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movsdRegRip xmm8, [rip + __fconst_11]
    x64.movRegReg xmm0, xmm7
    x64.callDirect Math.isIntegerValue
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, is_int
    x64.jmp ifcont
  is_int:
    x64.movsdRegRip xmm0, [rip + __fconst_9]
    x64.ucomisdRegReg xmm7, xmm0
    x64.jcc above, positive_int
    x64.jmp ifcont
  positive_int:
    x64.ucomisdRegReg xmm8, xmm7
    x64.jcc aboveEqual, small_int
    x64.jmp ifcont
  small_int:
    x64.movsdRegRip xmm0, [rip + __fconst_10]
    x64.movsdRegRip xmm1, [rip + __fconst_9]
    x64.jmp whilehdr
  whilehdr:
    x64.ucomisdRegReg xmm7, xmm1
    x64.jcc above, mult_loop
    x64.jmp whileexit
  mult_loop:
    x64.mulsdRegReg xmm0, xmm0, xmm6
    x64.movsdRegRip xmm2, [rip + __fconst_10]
    x64.addsdRegReg xmm1, xmm1, xmm2
    x64.jmp whilehdr
  whileexit:
    x64.loadRegSlot xmm6, slot0
    x64.loadRegSlot xmm7, slot1
    x64.loadRegSlot xmm8, slot2
    x64.epilogue 64
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.jmp ifcont
  ifcont:
    x64.movsdRegRip xmm0, [rip + __fconst_9]
    x64.ucomisdRegReg xmm0, xmm7
    x64.jcc above, negative_int
    x64.jmp ifcont
  negative_int:
    x64.movsdRegRip xmm0, [rip + __fconst_9]
    x64.subsdRegReg xmm0, xmm0, xmm7
    x64.ucomisdRegReg xmm8, xmm0
    x64.jcc aboveEqual, small_neg
    x64.jmp ifcont
  small_neg:
    x64.movsdRegRip xmm1, [rip + __fconst_10]
    x64.movsdRegRip xmm2, [rip + __fconst_9]
    x64.jmp whilehdr
  whilehdr:
    x64.ucomisdRegReg xmm0, xmm2
    x64.jcc above, div_loop
    x64.jmp whileexit
  div_loop:
    x64.movsdRegRip xmm3, [rip + __fconst_9]
    x64.ucomisdRegReg xmm6, xmm3
    x64.setccReg notEqual, rcx
    x64.setccReg parity, rdx
    x64.leaRegRegReg rcx, rcx, rdx
    x64.cmpRegImm32 rcx, 0
    x64.setccReg equal, rax
    x64.divsdRegReg xmm1, xmm1, xmm6
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_4]
    x64.callDirect mrt_panic
    x64.movsdRegRip xmm0, [rip + __fconst_9]
    x64.loadRegSlot xmm6, slot0
    x64.loadRegSlot xmm7, slot1
    x64.loadRegSlot xmm8, slot2
    x64.epilogue 64
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movsdRegRip xmm3, [rip + __fconst_10]
    x64.addsdRegReg xmm2, xmm2, xmm3
    x64.jmp whilehdr
  whileexit:
    x64.movRegReg xmm0, xmm1
    x64.loadRegSlot xmm6, slot0
    x64.loadRegSlot xmm7, slot1
    x64.loadRegSlot xmm8, slot2
    x64.epilogue 64
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.jmp ifcont
  ifcont:
    x64.jmp ifcont
  ifcont:
    x64.movRegReg xmm0, xmm6
    x64.callDirect Math.log
    x64.mulsdRegReg xmm7, xmm7, xmm0
    x64.movRegReg xmm0, xmm7
    x64.callDirect Math.exp
    x64.loadRegSlot xmm6, slot0
    x64.loadRegSlot xmm7, slot1
    x64.loadRegSlot xmm8, slot2
    x64.epilogue 64
    x64.popReg rbp
    x64.ret
}
