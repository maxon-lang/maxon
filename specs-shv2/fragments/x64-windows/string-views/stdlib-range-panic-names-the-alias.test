// Test: stdlib-range-panic-names-the-alias
typealias Wide = int(0 to u32.max)

function widen(n Wide) returns Wide
	return n * 1000000
end 'widen'

function main() returns ExitCode
	let lead = utf16LeadSurrogate(widen(1000))
	return 7 if lead > 65535 else 9
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __rc_ok#9:
    x64.movRegImm32 rcx, 1000000000
  __il_cont:
    x64.callDirect utf16LeadSurrogate
    x64.cmpRegImm32 r8, 65535
    x64.jcc lessEqual, ternaryfalse
  ternarytrue:
    x64.movRegImm32 r8, 7
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegImm32 r8, 9
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok#4
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at stdlib-range-panic-names-the-alias.test:10: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#4:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
