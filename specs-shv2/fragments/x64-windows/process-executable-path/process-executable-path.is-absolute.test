// Test: process-executable-path.is-absolute
function main() returns ExitCode
	let exe = try Process.executablePath() otherwise return 2
	var score = 0
	if exe.path.byteLength() > 3 'longerThanADrive'
		score = score + 1
	end 'longerThanADrive'
	if exe.path.contains(":") 'driveQualified'
		score = score + 2
	end 'driveQualified'
	return score as ExitCode
end 'main'
---
ExitCode: 3
---
data {
  __data_CharacterSet.cachedWhitespacesAndNewlines@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect Process.executablePath
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 r8, 2
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegImm32 r12, 0
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.callDirect String.byteLength
    x64.cmpRegImm32 r8, 3
    x64.jcc greater, longerThanADrive
    x64.jmp critsplit#10
  longerThanADrive:
    x64.leaRegRegImm32 r12, r12, 1
    x64.jmp ifcont#4
  critsplit#10:
    x64.jmp ifcont#4
  ifcont#4:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.leaRegRdata rdx, [rip + __str_rec_16]
    x64.callDirect String.contains
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, driveQualified
    x64.jmp critsplit#11
  driveQualified:
    x64.leaRegRegImm32 r12, r12, 2
    x64.jmp ifcont#6
  critsplit#11:
    x64.jmp ifcont#6
  ifcont#6:
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_87]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_FilePath
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
