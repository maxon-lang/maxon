// Test: process-executable-path.builtin-result-is-owned
function main() returns ExitCode
	var seen = 0
	var i = 0
	while i < 50 'reads'
		let mm = __Builtins.executablePath()
		if mm.length() > 0 'nonEmpty'
			seen = seen + 1
		end 'nonEmpty'
		i = i + 1
	end 'reads'
	if seen == 50 'allFifty'
		return 6
	end 'allFifty'
	return 1
end 'main'
---
ExitCode: 6
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 r12, 0
  whilehdr:
    x64.cmpRegImm32 r12, 50
    x64.jcc greaterEqual, whileexit
  reads:
    x64.callDirect __proc_exe_path
    x64.loadRegBaseDisp.word64 rax, [r8 + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc lessEqual, ifcont#5
  nonEmpty:
    x64.leaRegRegImm32 rbx, rbx, 1
  ifcont#5:
    x64.leaRegRegImm32 r12, r12, 1
    x64.movRegReg rcx, r8
    x64.callDirect __managed_decref
    x64.jmp whilehdr
  whileexit:
    x64.cmpRegImm32 rbx, 50
    x64.jcc notEqual, ifcont#7
  allFifty:
    x64.movRegImm32 r8, 6
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#7:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
