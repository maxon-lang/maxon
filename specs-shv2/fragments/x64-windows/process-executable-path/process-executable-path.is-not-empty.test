// Test: process-executable-path.is-not-empty
function main() returns ExitCode
	let exe = try Process.executablePath() otherwise return 2
	if exe.path.byteLength() > 0 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __data_CharacterSet.cachedWhitespacesAndNewlines@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.callDirect Process.executablePath
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm32 r8, 2
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
  __il_body:
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
  __il_cont:
    x64.cmpRegImm32 rax, 0
    x64.jcc lessEqual, ifcont
  check:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r8
    x64.callDirect __destruct_FilePath
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rbx, 1
    x64.movRegReg rcx, r8
    x64.callDirect __destruct_FilePath
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
