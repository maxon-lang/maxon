// Test: over-budget-digits-round-through-the-sticky-bit
function main() returns ExitCode
	var r = 0
	if 9007199254740993. == 9007199254740992.0 'tieRoundsToEven'
		r = r + 1
	end 'tieRoundsToEven'
	if 9007199254740993. == 9007199254740994.0 'stickyBitRoundsUp'
		r = r + 2
	end 'stickyBitRoundsUp'
	return r
end 'main'
---
ExitCode: 3
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
    x64.movsdRegRip xmm0, [rip + __fconst_0]
    x64.movsdRegRip xmm1, [rip + __fconst_0]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc parity, critsplit
    x64.jmp fordered
  critsplit:
    x64.jmp ifcont
  fordered:
    x64.jcc equal, tieRoundsToEven
    x64.jmp critsplit
  tieRoundsToEven:
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movsdRegRip xmm0, [rip + __fconst_1]
    x64.movsdRegRip xmm1, [rip + __fconst_1]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc parity, critsplit
    x64.jmp fordered
  critsplit:
    x64.movRegReg r8, rax
    x64.jmp ifcont
  fordered:
    x64.jcc equal, stickyBitRoundsUp
    x64.jmp critsplit
  stickyBitRoundsUp:
    x64.leaRegRegImm32 r8, rax, 2
    x64.jmp ifcont
  critsplit:
    x64.movRegReg r8, rax
    x64.jmp ifcont
  ifcont:
    x64.popReg rbp
    x64.ret
}
