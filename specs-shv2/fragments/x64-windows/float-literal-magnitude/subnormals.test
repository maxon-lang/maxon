// Test: subnormals
function main() returns ExitCode
	var r = 0
	if 1.0e-310 > 0.0 'e310IsPositive'
		r = r + 1
	end 'e310IsPositive'
	if 1.0e-320 > 0.0 'e320IsPositive'
		r = r + 2
	end 'e320IsPositive'
	if 1.0e-310 > 1.0e-320 'ordered'
		r = r + 4
	end 'ordered'
	return r
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 0
    x64.movsdRegRip xmm0, [rip + __fconst_1E-310]
    x64.movsdRegRip xmm1, [rip + __fconst_0]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc belowEqual, ifcont#2
  e310IsPositive:
    x64.movRegImm32 rax, 1
  ifcont#2:
    x64.movsdRegRip xmm0, [rip + __fconst_1E-320]
    x64.movsdRegRip xmm1, [rip + __fconst_0]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc belowEqual, ifcont#4
  e320IsPositive:
    x64.leaRegRegImm32 rax, rax, 2
  ifcont#4:
    x64.movsdRegRip xmm0, [rip + __fconst_1E-310]
    x64.movsdRegRip xmm1, [rip + __fconst_1E-320]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc belowEqual, critsplit
  ordered:
    x64.leaRegRegImm32 r8, rax, 4
    x64.jmp ifcont#6
  critsplit:
    x64.movRegReg r8, rax
  ifcont#6:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at subnormals.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
