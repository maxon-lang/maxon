// Test: clamped-exponent-cannot-be-cancelled-into-range
function main() returns ExitCode
	if .0e-999999999 == 0.0 'underflowsToZero'
		return 1
	end 'underflowsToZero'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  underflowsToZero:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}
