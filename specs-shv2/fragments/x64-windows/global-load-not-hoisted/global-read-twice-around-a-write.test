// Test: global-read-twice-around-a-write


var slot = 3

function main() returns ExitCode
	let before = slot
	slot = 40
	let after = slot
	return before + after - 1
end 'main'
---
ExitCode: 42
---
data {
  __data_slot@0 = i64 3
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegGlobal rax, __data_slot
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.movRegImm32 rcx, 40
    x64.leaRegGlobal rdx, __data_slot
    x64.storeBaseDispReg.word64 [rdx + 0], rcx
    x64.leaRegGlobal rcx, __data_slot
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegRegImm32 r8, rax, -1
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
