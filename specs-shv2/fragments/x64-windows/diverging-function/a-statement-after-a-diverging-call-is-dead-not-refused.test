// Test: a-statement-after-a-diverging-call-is-dead-not-refused
function fatal(tag int)
	panic("fatal {tag}")
end 'fatal'

function main() returns ExitCode
	if false 'never'
		fatal(1)
		return 7
	end 'never'
	return 3
end 'main'
---
ExitCode: 3
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  ifcont:
    x64.movRegImm32 r8, 3
    x64.popReg rbp
    x64.ret
}
