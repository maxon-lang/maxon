// Test: a-body-with-a-return-does-not-diverge
function maybeFatal(b bool) returns int
	if b 'y'
		return 5
	end 'y'
	panic("no")
end 'maybeFatal'

function main() returns ExitCode
	maybeFatal(true)
	print("back in main\n")
	return 0
end 'main'
---
ExitCode: 0
---
func @maybeFatal {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, y
    x64.jmp ifcont
  y:
    x64.movRegImm32 r8, 5
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 1
    x64.callDirect maybeFatal
    x64.leaRegRdata rcx, [rip + __str_rec_2]
    x64.callDirect print
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @print {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __write_stdout
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
