// Test: a-body-with-a-return-does-not-diverge
function maybeFatal(b bool) returns Integer
	if b 'y'
		return 5
	end 'y'
	panic("no")
end 'maybeFatal'

function main() returns ExitCode
	maybeFatal(true)
	print("back in main\n")
	return 0
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __il_cont:
    x64.leaRegRdata rcx, [rip + __str_rec_2]
    x64.callDirect print
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
