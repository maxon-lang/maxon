// Test: a-body-that-panics-on-only-one-path-does-not-diverge
function notFatal(b bool)
	if b 'y'
		panic("boom")
	end 'y'
	print("survived\n")
end 'notFatal'

function main() returns ExitCode
	notFatal(false)
	print("back in main\n")
	return 0
end 'main'
---
ExitCode: 0
---
func @notFatal {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, y
    x64.jmp ifcont
  y:
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.leaRegRdata rcx, [rip + __str_rec_3]
    x64.callDirect print
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 0
    x64.callDirect notFatal
    x64.leaRegRdata rcx, [rip + __str_rec_4]
    x64.callDirect print
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
