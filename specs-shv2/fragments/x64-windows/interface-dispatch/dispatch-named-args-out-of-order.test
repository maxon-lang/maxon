// Test: dispatch-named-args-out-of-order

typealias Integer = int(i64.min to i64.max)

interface Subtractor
	function subtract(minuend Integer, subtrahend Integer) returns Integer
end 'Subtractor'

type Difference implements Subtractor
	let bias as Integer

	function subtract(minuend Integer, subtrahend Integer) returns Integer
		return minuend - subtrahend + bias
	end 'subtract'

	static function create(bias Integer) returns Self
		return Self{bias: bias}
	end 'create'
end 'Difference'

function subtractVia(s Subtractor) returns Integer
	return s.subtract(subtrahend: 2, minuend: 10)
end 'subtractVia'

function main() returns ExitCode
	let d = Difference.create(0)
	return subtractVia(d)
end 'main'
---
ExitCode: 8
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Difference.subtract {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.subRegReg rdx, rdx, rax
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.leaRegRegReg r8, rdx, rax
    x64.popReg rbp
    x64.ret
}

func @Difference.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @subtractVia {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rdx
    x64.movRegImm32 rax, 2
    x64.movRegImm32 rdx, 10
    x64.callMem [rbx + 24]
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 0
    x64.callDirect Difference.create
    x64.movRegReg rbx, r8
    x64.leaRegRdata rdx, [rip + __witness_Difference.Subtractor]
    x64.movRegReg rcx, rbx
    x64.callDirect subtractVia
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
