// Test: literal-conformer-dispatched-and-dropped
function widen(h Hashable) returns Hashable
	return h
end 'widen'

function main() returns ExitCode
	let n = 1
	let heap = widen("ab{n}cd")
	let literal = widen("ab1cd")
	print("heap={heap.hash()} literal={literal.hash()}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @widen {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rax, rcx
    x64.movRegReg rbx, rdx
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, rax
    x64.callDirect __retain_existential
    x64.movRegReg r10, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

