// Test: scalar-conformer-co-owned-into-a-var
typealias Integer = int(i64.min to i64.max)

function use(h Comparable, replace bool) returns Integer
	var v = h
	if replace 'maybe'
		v = h
	end 'maybe'
	return 11 if true else 12
end 'use'

function main() returns ExitCode
	return use(7, replace: false) as ExitCode
end 'main'
---
ExitCode: 11
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @use {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegReg r13, rax
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, rbx
    x64.callDirect __retain_existential
    x64.movRegReg r14, r8
    x64.cmpRegImm32 r12, 0
    x64.jcc equal, critsplit
  maybe:
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, rbx
    x64.callDirect __retain_existential
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r14
    x64.callDirect __drop_existential
    x64.movRegReg rdx, rbx
    x64.jmp ternarytrue
  critsplit:
    x64.movRegReg rdx, r14
  ternarytrue:
    x64.movRegImm32 rbx, 11
  matchcont:
    x64.movRegReg rcx, r13
    x64.callDirect __drop_existential
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 7
    x64.movRegImm32 rdx, 0
    x64.leaRegRdata rax, [rip + __witness_int.Comparable]
    x64.callDirect use
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
