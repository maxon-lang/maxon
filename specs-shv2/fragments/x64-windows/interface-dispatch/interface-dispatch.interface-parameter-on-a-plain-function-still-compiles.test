// Test: interface-dispatch.interface-parameter-on-a-plain-function-still-compiles
typealias Integer = int(i64.min to i64.max)

interface Shape
	function area() returns Integer
end 'Shape'

type Sq implements Shape
	let s as Integer

	function area() returns Integer
		return self.s
	end 'area'

	static function create(s Integer) returns Self
		return Self{s: s}
	end 'create'
end 'Sq'

function takeShape(c Shape, base Integer) returns Integer
	return base + c.area()
end 'takeShape'

type Holder
	let base as Integer

	function measure(c Shape) returns Integer
		return self.base + c.area()
	end 'measure'

	static function create(base Integer) returns Self
		return Self{base: base}
	end 'create'
end 'Holder'

type Helper
	static function measure(c Shape, base Integer) returns Integer
		return base + c.area()
	end 'measure'
end 'Helper'

function main() returns ExitCode
	return (takeShape(Sq.create(11), base: 20) - Holder.create(20).measure(Sq.create(11)) + Helper.measure(Sq.create(11), base: 31)) as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Sq.area {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 r8, [rcx + 0]
    x64.popReg rbp
    x64.ret
}

func @Sq.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @takeShape {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rdx
    x64.movRegReg r12, rax
    x64.callMem [r12 + 24]
    x64.leaRegRegReg r8, rbx, r8
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Holder.measure {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rax
    x64.loadRegBaseDisp.word64 r12, [rcx + 0]
    x64.movRegReg rcx, rdx
    x64.callMem [rbx + 24]
    x64.leaRegRegReg r8, r12, r8
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Helper.measure {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rdx
    x64.movRegReg r12, rax
    x64.callMem [r12 + 24]
    x64.leaRegRegReg r8, rbx, r8
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 48
    x64.movRegImm32 rcx, 11
    x64.callDirect Sq.create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 20
    x64.leaRegRdata rax, [rip + __witness_Sq.Shape]
    x64.movRegReg rcx, rbx
    x64.callDirect takeShape
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 20
    x64.leaRegSlot r13, slot0
    x64.storeBaseDispReg.word64 [r13 + 0], rax
    x64.movRegImm32 rcx, 11
    x64.callDirect Sq.create
    x64.movRegReg r14, r8
    x64.leaRegRdata rax, [rip + __witness_Sq.Shape]
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r14
    x64.callDirect Holder.measure
    x64.subRegReg r12, r12, r8
    x64.movRegImm32 rcx, 11
    x64.callDirect Sq.create
    x64.movRegReg r13, r8
    x64.movRegImm32 rdx, 31
    x64.leaRegRdata rax, [rip + __witness_Sq.Shape]
    x64.movRegReg rcx, r13
    x64.callDirect Helper.measure
    x64.leaRegRegReg r12, r12, r8
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r14
    x64.callDirect __mm_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg r8, r12
    x64.epilogue 48
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
