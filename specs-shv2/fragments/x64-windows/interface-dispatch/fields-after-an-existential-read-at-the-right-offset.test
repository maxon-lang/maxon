// Test: fields-after-an-existential-read-at-the-right-offset
typealias Integer = int(i64.min to i64.max)

interface Tagged
	function tag() returns Integer
end 'Tagged'

type Marker implements Tagged
	export let s as String
	let n as Integer

	function tag() returns Integer
		return n + self.s.byteLength()
	end 'tag'

	static function create(n Integer) returns Self
		return Self{s: "abc", n: n}
	end 'create'
end 'Marker'

type Holder
	export let label as String
	export let t as Tagged
	export let extra as Integer

	static function create(t Tagged) returns Self
		return Self{label: "hi", t: t, extra: 5}
	end 'create'
end 'Holder'

function callTag(t Tagged) returns Integer
	return t.tag()
end 'callTag'

function main() returns ExitCode
	let h = Holder.create(Marker.create(3))
	print("size={sizeof(Holder)} label={h.label} extra={h.extra}\n")
	return callTag(h.t)
end 'main'
---
ExitCode: 6
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Marker.tag {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
  __il_body:
    x64.loadRegBaseDisp.word64 rcx, [rcx + 8]
  __il_cont:
    x64.leaRegRegReg r8, rax, rcx
    x64.popReg rbp
    x64.ret
}

func @Marker.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.leaRegRdata r12, [rip + __str_rec_6]
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r12
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r13 + 0], r8
    x64.storeBaseDispReg.word64 [r13 + 8], rbx
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

