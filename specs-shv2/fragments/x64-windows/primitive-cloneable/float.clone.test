// Test: float.clone
function main() returns ExitCode
	let x = 3.14
	let y = x.clone()
	if y == 3.14 'ok'
		return 1
	end 'ok'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movsdRegRip xmm0, [rip + __fconst_3.14]
  __il_cont:
    x64.movsdRegRip xmm1, [rip + __fconst_3.14]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc parity, ifcont
  fordered:
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
