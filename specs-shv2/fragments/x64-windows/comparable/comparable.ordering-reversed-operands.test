// Test: comparable.ordering-reversed-operands
typealias Integer = int(0 to u32.max)

type Pair uses T where T is Comparable
	export var a as T
	export var b as T
	export static function create(a T, b T) returns Self
		return Self{ a: a, b: b }
	end 'create'
	export function forwardLess() returns bool
		return self.a < self.b
	end 'forwardLess'
	export function reverseLess() returns bool
		return self.b < self.a
	end 'reverseLess'
end 'Pair'

typealias IntPair = Pair with Integer

function main() returns ExitCode
	let p = IntPair.create(3, b: 9)
	var r = 0 as Integer
	if p.forwardLess() 'f'
		r = r + 1
	end 'f'
	if p.reverseLess() 'g'
		r = r + 10
	end 'g'
	return r
end 'main'
---
ExitCode: 1
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Pair.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.storeBaseDispReg.word64 [r8 + 8], r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Pair.forwardLess {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rdx
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.word64 rdx, [rcx + 8]
    x64.movRegReg rcx, rax
    x64.callMem [rbx + 24]
    x64.cmpRegImm32 r8, 0
    x64.setccReg equal, r8
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Pair.reverseLess {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rdx
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.loadRegBaseDisp.word64 rdx, [rcx + 0]
    x64.movRegReg rcx, rax
    x64.callMem [rbx + 24]
    x64.cmpRegImm32 r8, 0
    x64.setccReg equal, r8
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 3
    x64.movRegImm32 rdx, 9
    x64.callDirect Pair.create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 0
    x64.leaRegRdata rdx, [rip + __witness_int.Comparable]
    x64.movRegReg rcx, rbx
    x64.callDirect Pair.forwardLess
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, f
    x64.jmp critsplit
  f:
    x64.leaRegRegImm32 r12, r12, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.leaRegRdata rdx, [rip + __witness_int.Comparable]
    x64.movRegReg rcx, rbx
    x64.callDirect Pair.reverseLess
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, g
    x64.jmp critsplit
  g:
    x64.leaRegRegImm32 r12, r12, 10
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @int.compare {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegReg rcx, rdx
    x64.jcc less, less
    x64.jmp notLess
  less:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  notLess:
    x64.cmpRegReg rcx, rdx
    x64.jcc greater, greater
    x64.jmp equal
  greater:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  equal:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}
