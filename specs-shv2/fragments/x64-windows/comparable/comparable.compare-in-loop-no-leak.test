// Test: comparable.compare-in-loop-no-leak
typealias Counter = int(0 to 1000)

type Pair uses T where T is Comparable
	export var a as T
	export var b as T
	export static function create(a T, b T) returns Self
		return Self{ a: a, b: b }
	end 'create'
	export function isLess() returns bool
		let o = self.a.compare(self.b)
		let r = match o 'check'
			lessThan gives true
			equalTo gives false
			greaterThan gives false
		end 'check'
		return r
	end 'isLess'
	export function opLess() returns bool
		return self.a < self.b
	end 'opLess'
end 'Pair'

typealias CountPair = Pair with Counter

function main() returns ExitCode
	var i = 0 as Counter
	var acc = 0 as Counter
	while i < 100 'loop'
		let p = CountPair.create(3, b: 9)
		if p.isLess() 'ok'
			acc = acc + 1
		end 'ok'
		if p.opLess() 'ok2'
			acc = acc + 1
		end 'ok2'
		i = i + 1
	end 'loop'
	if acc == 200 'all'
		return 0
	end 'all'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Pair.isLess {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rdx
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.word64 rdx, [rcx + 8]
    x64.movRegReg rcx, rax
    x64.callMem [rbx + 24]
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, matcharm#1
    x64.jmp matchnext#5
  matcharm#1:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont
  matchnext#5:
    x64.cmpRegImm32 r8, 1
    x64.jcc equal, matcharm#2
    x64.jmp matchnext#6
  matcharm#2:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matchnext#6:
    x64.cmpRegImm32 r8, 2
    x64.jcc equal, matcharm#3
    x64.jmp matchdead
  matcharm#3:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matchcont:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
}

func @Pair.opLess {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rdx
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.word64 rdx, [rcx + 8]
    x64.movRegReg rcx, rax
    x64.callMem [rbx + 24]
    x64.cmpRegImm32 r8, 0
    x64.setccReg equal, r8
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 56
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 r12, 0
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegImm32 rbx, 100
    x64.jcc less, loop
    x64.jmp whileexit
  loop:
    x64.movRegImm32 rax, 3
    x64.movRegImm32 rcx, 9
    x64.leaRegRdata rdx, [rip + __witness_int.Comparable]
    x64.leaRegSlot r13, slot0
    x64.storeBaseDispReg.word64 [r13 + 0], rax
    x64.storeBaseDispReg.word64 [r13 + 8], rcx
    x64.leaRegRdata rdx, [rip + __witness_int.Comparable]
    x64.movRegReg rcx, r13
    x64.callDirect Pair.isLess
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, ok
    x64.jmp critsplit#10
  ok:
    x64.leaRegRegImm32 r12, r12, 1
    x64.jmp ifcont#5
  critsplit#10:
    x64.jmp ifcont#5
  ifcont#5:
    x64.leaRegRdata rdx, [rip + __witness_int.Comparable]
    x64.movRegReg rcx, r13
    x64.callDirect Pair.opLess
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, ok2
    x64.jmp critsplit#11
  ok2:
    x64.leaRegRegImm32 rax, r12, 1
    x64.jmp ifcont#7
  critsplit#11:
    x64.movRegReg rax, r12
    x64.jmp ifcont#7
  ifcont#7:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.movRegReg r12, rax
    x64.jmp whilehdr
  whileexit:
    x64.cmpRegImm32 r12, 200
    x64.jcc equal, all
    x64.jmp ifcont#9
  all:
    x64.movRegImm32 r8, 0
    x64.epilogue 56
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#9:
    x64.movRegImm32 r8, 1
    x64.epilogue 56
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @int.compare {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegReg rcx, rdx
    x64.jcc less, lt
    x64.jmp ifcont#2
  lt:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.cmpRegReg rcx, rdx
    x64.jcc greater, gt
    x64.jmp ifcont#4
  gt:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}
