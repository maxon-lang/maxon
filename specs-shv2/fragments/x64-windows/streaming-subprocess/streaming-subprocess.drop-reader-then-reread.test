    x64.movRegReg rcx, r12
    x64.callDirect __gt_promise_drop
    x64.movRegImm32 rcx, 200
    x64.callDirect sleep
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

