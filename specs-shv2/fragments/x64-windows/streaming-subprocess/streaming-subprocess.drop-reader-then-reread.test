    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.leaRegFunc rcx, [rip + reader]
    x64.callDirect __gt_spawn
    x64.storeBaseDispReg.word64 [r8 + 200], rbx
    x64.movRegReg rcx, r8
    x64.callDirect __gt_promise_drop
    x64.movRegImm32 rcx, 200
    x64.callDirect sleep
    x64.movRegImm32 r8, 0
    x64.epilogue 40
