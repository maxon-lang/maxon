// Test: enum-allcasenames.union-simple
union Signal
	start
	stop
	pause
end 'Signal'

function main() returns ExitCode
	for name in Signal.allCaseNames 'loop'
		print("{name}\n")
	end 'loop'
	return 0
end 'main'
