// Test: a-borrow-out-of-a-temporary-inside-a-short-circuit-right-hand-side
typealias Bytes = Array with ByteArray

function make() returns Bytes
	var outer = Bytes.create()
	var inner = ByteArray.create()
	inner.push(1)
	inner.push(2)
	inner.push(3)
	outer.push(inner)
	return outer
end 'make'

function main() returns ExitCode
	let d = ByteArray.create()
	let ok = false or (try make().get(0) otherwise d).count() == 3
	return 7 if ok else 0
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @make {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __managed_decref]
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, r12
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 2
    x64.movRegReg rcx, r12
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 3
    x64.movRegReg rcx, r12
    x64.callDirect __managed_push
    x64.movRegReg rcx, r12
    x64.callDirect __mm_incref
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __managed_push
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, scmerge
  orrhs:
    x64.callDirect make
    x64.movRegReg r12, r8
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rax, [r12 + 24]
    x64.cmpRegImm32 rax, 8
    x64.jcc notEqual, __im_stride
  __im_word:
    x64.loadRegBaseDisp.word64 rax, [r12 + 8]
    x64.cmpRegImm32 rdx, 0
    x64.setccReg less, rcx
    x64.cmpRegImm32 rax, 0
    x64.setccReg lessEqual, rax
    x64.orRegReg rcx, rcx, rax
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, __il_slow
  __im_load#18:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.imulRegRegImm32 rcx, rdx, 8
    x64.leaRegRegReg rax, rax, rcx
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.jmp __im_loaded
  __im_stride:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, __il_slow
  __im_byte:
    x64.loadRegBaseDisp.word64 rax, [r12 + 8]
    x64.cmpRegImm32 rdx, 0
    x64.setccReg less, rcx
    x64.cmpRegImm32 rax, 0
    x64.setccReg lessEqual, rax
    x64.orRegReg rcx, rcx, rax
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, __il_slow
  __im_load#19:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.leaRegRegReg rax, rax, rdx
    x64.loadRegBaseDisp.byte rax, [rax + 0]
  __im_loaded:
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rsi, [r12 + 40]
    x64.cmpRegImm32 rsi, 0
    x64.jcc equal, critsplit#22
  __im_empty:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __il_slow
  critsplit#23:
    x64.movRegReg r13, rax
    x64.jmp __il_cont
  critsplit#22:
    x64.movRegReg r13, rax
    x64.jmp __il_cont
  __il_slow:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_get
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r10
  __il_cont:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.movRegReg rcx, rbx
    x64.jmp trycont
  tryok:
    x64.movRegReg rcx, r13
    x64.callDirect __mm_incref
    x64.movRegReg rcx, r13
  trycont:
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.cmpRegImm32 rax, 3
    x64.setccReg equal, r13
    x64.callDirect __managed_decref
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, r13
  scmerge:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, ternaryfalse
  ternarytrue:
    x64.movRegImm32 r12, 7
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegImm32 r12, 0
  matchcont:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
