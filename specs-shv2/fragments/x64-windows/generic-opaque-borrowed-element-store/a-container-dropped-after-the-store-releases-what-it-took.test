    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, __il_slow
    x64.jmp __im_load#10
  __im_load#10:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.leaRegRegReg rax, rax, rdx
    x64.loadRegBaseDisp.byte rax, [rax + 0]
    x64.jmp __im_loaded
  __im_loaded:
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rsi, [rbx + 40]
    x64.cmpRegImm32 rsi, 0
    x64.jcc notEqual, __im_empty
    x64.jmp critsplit#12
  __im_empty:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __il_slow
    x64.jmp critsplit#13
  critsplit#13:
    x64.movRegReg rdx, rax
    x64.jmp __il_cont
  critsplit#12:
    x64.movRegReg rdx, rax
    x64.jmp __il_cont
  __il_slow:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.movRegReg rdx, r8
    x64.movRegReg rcx, r10
    x64.jmp __il_cont
  __il_cont:
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, r12
    x64.callDirect __retain_type_param
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.loadRegBaseDisp.word64 rbx, [r13 + 8]
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

