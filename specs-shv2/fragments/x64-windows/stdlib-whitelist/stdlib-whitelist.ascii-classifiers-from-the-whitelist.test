// Test: stdlib-whitelist.ascii-classifiers-from-the-whitelist
function main() returns ExitCode
	if Ascii.isDigit('7') 'digit'
		print("digit\n")
	end 'digit'
	if Ascii.isAlpha('q') 'alpha'
		print("alpha\n")
	end 'alpha'
	if Ascii.isAlphanumeric('Z') 'alnum'
		print("alnum\n")
	end 'alnum'
	if Ascii.isWhitespace('\t') 'tab'
		print("tab\n")
	end 'tab'
	if Ascii.isUpper('K') 'upper'
		print("upper\n")
	end 'upper'
	if Ascii.isLower('k') 'lower'
		print("lower\n")
	end 'lower'
	if Ascii.isDigit('x') 'notDigit'
		print("UNREACHED-notDigit\n")
	end 'notDigit'
	if Ascii.isUpper('k') 'notUpper'
		print("UNREACHED-notUpper\n")
	end 'notUpper'
	if Ascii.isAlpha('é') 'notAscii'
		print("UNREACHED-notAscii\n")
	end 'notAscii'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_25]
    x64.callDirect Ascii.isDigit
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, digit
    x64.jmp ifcont#2
  digit:
    x64.leaRegRdata rcx, [rip + __str_rec_26]
    x64.callDirect print
    x64.jmp ifcont#2
  ifcont#2:
    x64.leaRegRdata rcx, [rip + __str_rec_27]
    x64.callDirect Ascii.isAlpha
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, alpha
    x64.jmp ifcont#4
  alpha:
    x64.leaRegRdata rcx, [rip + __str_rec_28]
    x64.callDirect print
    x64.jmp ifcont#4
  ifcont#4:
    x64.leaRegRdata rcx, [rip + __str_rec_29]
    x64.callDirect Ascii.isAlphanumeric
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, alnum
    x64.jmp ifcont#6
  alnum:
    x64.leaRegRdata rcx, [rip + __str_rec_30]
    x64.callDirect print
    x64.jmp ifcont#6
  ifcont#6:
    x64.leaRegRdata rcx, [rip + __str_rec_31]
    x64.callDirect Ascii.isWhitespace
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, tab
    x64.jmp ifcont#8
  tab:
    x64.leaRegRdata rcx, [rip + __str_rec_32]
    x64.callDirect print
    x64.jmp ifcont#8
  ifcont#8:
    x64.leaRegRdata rcx, [rip + __str_rec_33]
    x64.callDirect Ascii.isUpper
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, upper
    x64.jmp ifcont#10
  upper:
    x64.leaRegRdata rcx, [rip + __str_rec_34]
    x64.callDirect print
    x64.jmp ifcont#10
  ifcont#10:
    x64.leaRegRdata rcx, [rip + __str_rec_35]
    x64.callDirect Ascii.isLower
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, lower
    x64.jmp ifcont#12
  lower:
    x64.leaRegRdata rcx, [rip + __str_rec_36]
    x64.callDirect print
    x64.jmp ifcont#12
  ifcont#12:
    x64.leaRegRdata rcx, [rip + __str_rec_37]
    x64.callDirect Ascii.isDigit
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, notDigit
    x64.jmp ifcont#14
  notDigit:
    x64.leaRegRdata rcx, [rip + __str_rec_38]
    x64.callDirect print
    x64.jmp ifcont#14
  ifcont#14:
    x64.leaRegRdata rcx, [rip + __str_rec_35]
    x64.callDirect Ascii.isUpper
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, notUpper
    x64.jmp ifcont#16
  notUpper:
    x64.leaRegRdata rcx, [rip + __str_rec_39]
    x64.callDirect print
    x64.jmp ifcont#16
  ifcont#16:
    x64.leaRegRdata rcx, [rip + __str_rec_40]
    x64.callDirect Ascii.isAlpha
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, notAscii
    x64.jmp ifcont#18
  notAscii:
    x64.leaRegRdata rcx, [rip + __str_rec_41]
    x64.callDirect print
    x64.jmp ifcont#18
  ifcont#18:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
