// Test: stdlib-whitelist.a-listed-modules-literals-are-byte-neutral
typealias Weight = float(0.0 to 100.0)

enum Marker
	alpha
	beta
	gamma
	delta
	epsilon
	zeta
	eta
	theta
end 'Marker'

function main() returns ExitCode
	let scale = 12.5 as Weight
	let pick = Marker.gamma
	let slot = match pick 'which'
		alpha gives 0
		beta gives 1
		gamma gives 2
		delta gives 3
		epsilon gives 4
		zeta gives 5
		eta gives 6
		theta gives 7
	end 'which'
	return trunc(scale) + slot
end 'main'
---
ExitCode: 14
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movsdRegRip xmm0, [rip + __fconst_0]
    x64.movRegImm32 rax, 2
    x64.jumpTable rax, default=matchdead [[0]=matcharm, [1]=matcharm, [2]=matcharm, [3]=matcharm, [4]=matcharm, [5]=matcharm, [6]=matcharm, [7]=matcharm] @__jumptable_1
  matchdead:
  matcharm:
    x64.movRegImm32 rax, 0
    x64.jmp matchcont
  matcharm:
    x64.movRegImm32 rax, 1
    x64.jmp matchcont
  matcharm:
    x64.movRegImm32 rax, 2
    x64.jmp matchcont
  matcharm:
    x64.movRegImm32 rax, 3
    x64.jmp matchcont
  matcharm:
    x64.movRegImm32 rax, 4
    x64.jmp matchcont
  matcharm:
    x64.movRegImm32 rax, 5
    x64.jmp matchcont
  matcharm:
    x64.movRegImm32 rax, 6
    x64.jmp matchcont
  matcharm:
    x64.movRegImm32 rax, 7
    x64.jmp matchcont
  matchcont:
    x64.cvttsd2siRegReg rcx, xmm0
    x64.leaRegRegReg r8, rcx, rax
    x64.popReg rbp
    x64.ret
}
