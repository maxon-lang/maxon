// Test: keyword-named-enum-case-through-Self
enum Kw
	while
	end

	export function pick() returns Kw
		if self == Self.while 'w'
			return Self.end
		end 'w'
		return Self.while
	end 'pick'
end 'Kw'

function main() returns ExitCode
	let k = Kw.while
	if k.pick() == Kw.end 'ok'
		return 42
	end 'ok'
	return 1
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
  __il_body:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, ifcont#6
  w:
    x64.movRegImm32 rax, 1
    x64.jmp __il_cont
  ifcont#6:
    x64.movRegImm32 rax, 0
  __il_cont:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, ifcont#2
  ok:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}
