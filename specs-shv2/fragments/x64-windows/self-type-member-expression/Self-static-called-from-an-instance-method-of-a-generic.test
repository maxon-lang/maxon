// Test: Self-static-called-from-an-instance-method-of-a-generic
typealias Num = int(0 to 1000)

type Holder uses T
	export var v as T

	export static function make(x T) returns Self
		return Self{v: x}
	end 'make'

	export function twin() returns T
		return Self.make(self.v).v
	end 'twin'
end 'Holder'

typealias NumHolder = Holder with Num

function main() returns ExitCode
	return NumHolder.make(42).twin()
end 'main'
---
ExitCode: 42
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Holder.twin {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.leaRegSlot rcx, slot0
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.movRegReg rcx, rdx
    x64.movRegReg rdx, rax
    x64.callDirect __retain_type_param
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.movRegImm32 rax, 42
    x64.leaRegSlot rcx, slot0
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.leaRegRdata rdx, [rip + __layout_Holder_Num]
    x64.callDirect Holder.twin
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}
