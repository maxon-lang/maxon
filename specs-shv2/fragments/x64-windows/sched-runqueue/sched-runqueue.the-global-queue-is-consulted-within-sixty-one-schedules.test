func @Leaf.__loop {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.jmp serve
  serve:
    x64.movRegReg rcx, r12
    x64.callDirect __mbox_recv
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, stopping
    x64.jmp dispatch
  dispatch:
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.jumpTable rax, default=stopping [[0]=__shutdown, [1]=go] @__jumptable_14
  __shutdown:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.jmp stopping
  stopping:
    x64.movRegReg rcx, r12
    x64.callDirect __mbox_close
    x64.jmp drain
  drain:
    x64.movRegReg rcx, r12
    x64.callDirect __mbox_recv
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, finished
    x64.jmp abandon
  finished:
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r12
    x64.callDirect __mbox_service_exit
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  abandon:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.jmp drain
  go:
    x64.jmp __il_body
  __il_body:
    x64.leaRegGlobal rax, __data_runCount
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegRegImm32 rax, rax, 1
    x64.leaRegGlobal rcx, __data_runCount
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, oldest
    x64.jmp ifcont
  oldest:
    x64.leaRegGlobal rax, __data_runCount
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegGlobal rcx, __data_firstPos
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.jmp ifcont
  ifcont:
    x64.jmp __il_cont
  __il_cont:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.jmp serve
}
