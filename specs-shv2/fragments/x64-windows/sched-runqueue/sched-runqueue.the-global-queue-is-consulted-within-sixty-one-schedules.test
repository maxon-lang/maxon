// Test: sched-runqueue.the-global-queue-is-consulted-within-sixty-one-schedules
var runCount = 0
var firstPos = 0

function leaf(id int) returns int
	__Builtins.parallelBoundary()
	runCount = runCount + 1
	if id == 1 'oldest'
		firstPos = runCount
	end 'oldest'
	return 1
end 'leaf'

function spawnMany(n int, id int) returns int
	if n == 0 'base'
		return 0
	end 'base'

	let p = async leaf(id)
	let rest = spawnMany(n - 1, id: id + 1)
	return (await p) + rest
end 'spawnMany'

function main() returns ExitCode
	let total = spawnMany(300, id: 1)
	if firstPos < 130 'early'
		print("total={total} oldest=early")
	end 'early' else 'late'
		print("total={total} oldest=late")
	end 'late'

	return 0 as ExitCode
end 'main'
---
ExitCode: 0
---
data {
  __data_runCount@0 = i64 0
  __data_firstPos@8 = i64 0
  __mm_alloc_count@16 = i64 0
  __gt_run_queue_head@24 = i64 0
  __gt_run_queue_tail@32 = i64 0
  __gt_init_done@40 = i64 0
  __gt_timer_count@48 = i64 0
  __gt_timer_heap_base@56 = i64 0
  __gt_timer_capacity@64 = i64 0
  __gt_trace_counter@72 = i64 0
  __gt_proc_count@80 = i64 0
  __gt_proc_handles_base@88 = i64 0
  __gt_proc_gts_base@96 = i64 0
  __gt_live_count@104 = i64 0
  __sched_active_workers@112 = i64 1
  __sched_max_active_workers@120 = i64 1
  __sched_tls_index@128 = i64 0
  __sched_tls_teb_offset@136 = i64 0
  __sched_procs@144 = i64 0
  __sched_num_procs@152 = i64 0
  __sched_shutdown_flag@160 = i64 0
  __sched_lock@168 = i64 0
  __slab_arena_list@176 = i64 0
  __slab_arena_map_l1@184 = i64 0
  __slab_state@192 = i64 0
}

func @leaf {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.callDirect __parallel_boundary
    x64.leaRegGlobal rax, __data_runCount
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegRegImm32 rax, rax, 1
    x64.leaRegGlobal rcx, __data_runCount
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.cmpRegImm32 rbx, 1
    x64.jcc equal, oldest
    x64.jmp ifcont
  oldest:
    x64.leaRegGlobal rax, __data_runCount
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegGlobal rcx, __data_firstPos
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 r8, 1
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @spawnMany {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.cmpRegImm32 rbx, 0
    x64.jcc equal, base
    x64.jmp ifcont
  base:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.leaRegFunc rcx, [rip + leaf]
    x64.callDirect __gt_spawn
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 200], r12
    x64.movRegReg rcx, r13
    x64.callDirect __gt_ready
    x64.leaRegRegImm32 rcx, rbx, -1
    x64.leaRegRegImm32 rdx, r12, 1
    x64.callDirect spawnMany
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, r13
    x64.callDirect __gt_await
    x64.leaRegRegReg r8, r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

