func @Spawnee.__loop {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
  serve:
    x64.movRegReg rcx, r12
    x64.callDirect __mbox_recv
    x64.movRegReg r13, r8
    x64.cmpRegImm32 r13, 0
    x64.jcc equal, stopping
  dispatch:
    x64.loadRegBaseDisp.word64 rax, [r13 + 0]
    x64.jumpTable rax, default=stopping [[0]=__shutdown, [1]=go] @__jumptable_4
  __shutdown:
    x64.loadRegBaseDisp.word64 rax, [r13 + 8]
    x64.storeBaseDispReg.word64 [r12 + 56], rax
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
  stopping:
    x64.movRegReg rcx, r12
    x64.callDirect __mbox_close
  drain:
    x64.movRegReg rcx, r12
    x64.callDirect __mbox_recv
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, abandon
  finished:
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r12
    x64.callDirect __mbox_service_exit
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  abandon:
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r8
    x64.callDirect __mbox_abandon
    x64.jmp drain
  go:
    x64.loadRegBaseDisp.word64 r14, [r13 + 8]
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r14
    x64.callDirect Spawnee.go
    x64.movRegReg rcx, r14
    x64.callDirect __mbox_handle_drop_box
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.jmp serve
}

