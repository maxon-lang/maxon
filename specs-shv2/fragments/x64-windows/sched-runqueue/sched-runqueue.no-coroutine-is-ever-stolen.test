// Test: sched-runqueue.no-coroutine-is-ever-stolen
function work(v Integer) returns Integer
	__Builtins.parallelBoundary()
	return v
end 'work'

function main() returns ExitCode
	let p = async work(5)
	let r = await p
	print("r={r} steals={__Builtins.schedStealCount()}")
	return 0 as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __gt_run_queue_head@8 = i64 0
  __gt_run_queue_tail@16 = i64 0
  __gt_init_done@24 = i64 0
  __gt_timer_count@32 = i64 0
  __gt_timer_heap_base@40 = i64 0
  __gt_timer_capacity@48 = i64 0
  __gt_trace_counter@56 = i64 0
  __gt_proc_count@64 = i64 0
  __gt_proc_handles_base@72 = i64 0
  __gt_proc_gts_base@80 = i64 0
  __gt_proc_wait_snapshot@88 = i64 0
  __gt_proc_poller@96 = i64 0
  __gt_live_count@104 = i64 0
  __sched_progress@112 = i64 0
  __sched_active_workers@120 = i64 1
  __sched_max_active_workers@128 = i64 1
  __sched_tls_index@136 = i64 0
  __sched_tls_teb_offset@144 = i64 0
  __sched_procs@152 = i64 0
  __sched_num_procs@160 = i64 0
  __sched_shutdown_flag@168 = i64 0
  __sched_lock@176 = i64 0
  __sched_nmspinning@184 = i64 0
  __slab_arena_list@192 = i64 0
  __slab_arena_map_l1@200 = i64 0
  __slab_state@208 = i64 0
}

func @work {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.callDirect __parallel_boundary
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 88
    x64.movRegImm32 rbx, 5
    x64.leaRegFunc rcx, [rip + work]
    x64.callDirect __gt_spawn
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 200], rbx
    x64.movRegReg rcx, r12
    x64.callDirect __gt_ready
    x64.movRegReg rcx, r12
    x64.callDirect __gt_await
    x64.movRegReg rbx, r8
    x64.leaRegRdata rax, [rip + __str_rec_2]  ; "r="
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.storeSlotReg slot5, rcx
    x64.loadRegBaseDisp.word64 r12, [rax + 8]
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot4, r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __int_to_string
    x64.movRegReg rbx, r8
    x64.leaRegRdata rax, [rip + __str_rec_3]  ; " steals="
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.storeSlotReg slot3, rcx
    x64.loadRegBaseDisp.word64 r13, [rax + 8]
    x64.callDirect __sched_steal_count
    x64.movRegReg r14, r8
