  __sched_shutdown_flag@152 = i64 0
  __sched_lock@160 = i64 0
  __slab_arena_list@168 = i64 0
  __slab_arena_map_l1@176 = i64 0
  __slab_state@184 = i64 0
}

func @Work.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

