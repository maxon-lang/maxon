// Test: sched-runqueue.a-spawn-drop-loop-stays-bounded
var ran = 0

function neverRuns() returns Integer
	__Builtins.parallelBoundary()
	ran = ran + 1
	return 1
end 'neverRuns'

function main() returns ExitCode
	var i = 0
	while i < 5000 'loop'
		_ = async neverRuns()
		i = i + 1
	end 'loop'

	if __Builtins.mmRawAllocLive() < 100 'bounded'
		print("ran={ran} live=bounded")
	end 'bounded' else 'grew'
		print("ran={ran} live=grew")
	end 'grew'

	return 0 as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
data {
  __data_ran@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __mm_alloc_total@16 = i64 0
  __mm_alloc_bytes@24 = i64 0
  __mm_raw_alloc_count@32 = i64 0
  __mm_raw_live_count@40 = i64 0
  __mm_raw_alloc_bytes@48 = i64 0
  __gt_run_queue_head@56 = i64 0
  __gt_run_queue_tail@64 = i64 0
  __gt_init_done@72 = i64 0
  __gt_timer_count@80 = i64 0
  __gt_timer_heap_base@88 = i64 0
  __gt_timer_capacity@96 = i64 0
  __gt_trace_counter@104 = i64 0
  __gt_proc_count@112 = i64 0
  __gt_proc_handles_base@120 = i64 0
  __gt_proc_gts_base@128 = i64 0
  __gt_proc_wait_snapshot@136 = i64 0
  __gt_proc_poller@144 = i64 0
  __gt_live_count@152 = i64 0
  __sched_progress@160 = i64 0
  __sched_active_workers@168 = i64 1
  __sched_max_active_workers@176 = i64 1
  __sched_tls_index@184 = i64 0
  __sched_tls_teb_offset@192 = i64 0
  __sched_procs@200 = i64 0
  __sched_allm@208 = i64 0
  __sched_midle@216 = i64 0
  __sched_pidle@224 = i64 0
  __sched_num_procs@232 = i64 0
  __sched_shutdown_flag@240 = i64 0
  __sched_lock@248 = i64 0
  __sched_nmspinning@256 = i64 0
  __sched_parked_drivers@264 = i64 0
  __sched_sysmon_started@272 = i64 0
  __slab_arena_list@280 = i64 0
  __slab_arena_map_l1@288 = i64 0
  __slab_state@296 = i64 0
}

func @neverRuns {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __parallel_boundary
    x64.leaRegGlobal rax, __data_ran
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegRegImm32 rax, rax, 1
    x64.leaRegGlobal rcx, __data_ran
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 104
    x64.movRegImm32 rbx, 0
  whilehdr:
    x64.cmpRegImm32 rbx, 5000
    x64.jcc greaterEqual, whileexit
  loop:
    x64.leaRegFunc rcx, [rip + neverRuns]
    x64.callDirect __gt_spawn
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.callDirect __gt_ready
    x64.movRegReg rcx, r12
    x64.callDirect __gt_promise_drop
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp whilehdr
  whileexit:
    x64.callDirect __mm_counter_raw_alloc_live
    x64.cmpRegImm32 r8, 100
    x64.jcc greaterEqual, ifelse
  bounded:
    x64.leaRegRdata rax, [rip + __str_rec_3]  ; "ran="
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
    x64.loadRegBaseDisp.word64 r12, [rax + 8]
    x64.leaRegGlobal rax, __data_ran
    x64.loadRegBaseDisp.word64 r13, [rax + 0]
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r14
    x64.callDirect __int_to_string
    x64.movRegReg r13, r8
    x64.leaRegRdata rax, [rip + __str_rec_4]  ; " live=bounded"
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.storeSlotReg slot7, rcx
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.storeSlotReg slot5, rax
    x64.leaRegRegReg rcx, r12, r13
    x64.leaRegRegReg rax, rcx, rax
    x64.storeSlotReg slot1, rax
    x64.leaRegRegImm32 rcx, rax, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot3, r8
    x64.leaRegRegImm32 r15, r8, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, rbx
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, r15, r12
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r14
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, rbx, r13
    x64.movRegReg rcx, rbx
    x64.loadRegSlot rdx, slot7
    x64.loadRegSlot r12, slot5
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, rbx, r12
    x64.loadRegSlot rbx, slot3
    x64.storeBaseDispReg.word64 [rbx + 0], r15
    x64.loadRegSlot rax, slot1
    x64.storeBaseDispReg.word64 [rbx + 8], rax
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [rbx + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [rbx + 24], rax
    x64.movRegReg rcx, r14
    x64.callDirect __mm_decref
    x64.movRegReg rcx, rbx
    x64.callDirect print
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.jmp ifcont
  ifelse:
    x64.leaRegRdata rax, [rip + __str_rec_3]  ; "ran="
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
    x64.loadRegBaseDisp.word64 r12, [rax + 8]
    x64.leaRegGlobal rax, __data_ran
    x64.loadRegBaseDisp.word64 r13, [rax + 0]
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r14
    x64.callDirect __int_to_string
    x64.movRegReg r13, r8
    x64.leaRegRdata rax, [rip + __str_rec_5]  ; " live=grew"
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.storeSlotReg slot6, rcx
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.storeSlotReg slot4, rax
    x64.leaRegRegReg rcx, r12, r13
    x64.leaRegRegReg rax, rcx, rax
    x64.storeSlotReg slot0, rax
    x64.leaRegRegImm32 rcx, rax, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot2, r8
    x64.leaRegRegImm32 r15, r8, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, rbx
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, r15, r12
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r14
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, rbx, r13
    x64.movRegReg rcx, rbx
    x64.loadRegSlot rdx, slot6
    x64.loadRegSlot r12, slot4
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, rbx, r12
    x64.loadRegSlot rbx, slot2
    x64.storeBaseDispReg.word64 [rbx + 0], r15
    x64.loadRegSlot rax, slot0
    x64.storeBaseDispReg.word64 [rbx + 8], rax
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [rbx + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [rbx + 24], rax
    x64.movRegReg rcx, r14
    x64.callDirect __mm_decref
    x64.movRegReg rcx, rbx
    x64.callDirect print
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 104
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
