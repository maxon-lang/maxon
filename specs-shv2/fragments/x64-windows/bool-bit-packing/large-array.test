// Test: large-array
typealias BoolArray = Array with bool

function main() returns ExitCode
	var arr = BoolArray.create()
	var i = 0
	while i < 100 'push'
		arr.push(i < 50)
		i = i + 1
	end 'push'
	var count = 0
	var j = 0
	while j < 100 'count'
		let v = try arr.get(j) otherwise false
		if v 'inc'
			count = count + 1
		end 'inc'
		j = j + 1
	end 'count'
	return count
end 'main'
---
ExitCode: 50
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm rcx, 18446744073709551615
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 0
    x64.jmp whilehdr#1
  whilehdr#1:
    x64.cmpRegImm32 r12, 100
    x64.jcc less, push
    x64.jmp whileexit#3
  push:
    x64.cmpRegImm32 r12, 50
    x64.setccReg less, rdx
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.leaRegRegImm32 r12, r12, 1
    x64.jmp whilehdr#1
  whileexit#3:
    x64.movRegImm32 r12, 0
    x64.movRegImm32 r13, 0
    x64.jmp whilehdr#4
  whilehdr#4:
    x64.cmpRegImm32 r13, 100
    x64.jcc less, count
    x64.jmp whileexit#6
  count:
    x64.loadRegBaseDisp.word64 rax, [rbx + 24]
    x64.cmpRegImm32 rax, 8
    x64.jcc equal, __im_word
    x64.jmp __im_stride
  __im_word:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 r13, 0
    x64.setccReg less, rcx
    x64.cmpRegReg r13, rax
    x64.setccReg greaterEqual, rax
    x64.orRegReg rcx, rcx, rax
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, __il_slow
    x64.jmp __im_load#21
  __im_load#21:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.imulRegRegImm32 rcx, r13, 8
    x64.leaRegRegReg rax, rax, rcx
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.jmp __im_loaded
  __im_stride:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, __im_byte
    x64.jmp __il_slow
  __im_byte:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 r13, 0
    x64.setccReg less, rcx
    x64.cmpRegReg r13, rax
    x64.setccReg greaterEqual, rax
    x64.orRegReg rcx, rcx, rax
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, __il_slow
    x64.jmp __im_load#22
  __im_load#22:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.leaRegRegReg rax, rax, r13
    x64.loadRegBaseDisp.byte rax, [rax + 0]
    x64.jmp __im_loaded
  __im_loaded:
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rdx, [rbx + 40]
    x64.cmpRegImm32 rdx, 0
    x64.jcc notEqual, __im_empty
    x64.jmp critsplit#25
  __im_empty:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __il_slow
    x64.jmp critsplit#26
  critsplit#26:
    x64.jmp __il_cont
  critsplit#25:
    x64.jmp __il_cont
  __il_slow:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect __managed_get
    x64.movRegReg rax, r8
    x64.movRegReg rcx, r10
    x64.jmp __il_cont
  __il_cont:
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 rax, 0
    x64.jmp trycont
  tryok:
    x64.jmp trycont
  trycont:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, inc
    x64.jmp critsplit#24
  inc:
    x64.leaRegRegImm32 rax, r12, 1
    x64.jmp ifcont
  critsplit#24:
    x64.movRegReg rax, r12
    x64.jmp ifcont
  ifcont:
    x64.leaRegRegImm32 r13, r13, 1
    x64.movRegReg r12, rax
    x64.jmp whilehdr#4
  whileexit#6:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
