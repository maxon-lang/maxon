// Test: character-key-remove
function main() returns ExitCode
	var cs = CharSet.create()
	cs.insert('a')
	cs.insert('🎉')
	print("{cs.remove('a')}\n")
	print("{cs.remove('a')}\n")
	print("{cs.count()}")
	return 0
end 'main'
