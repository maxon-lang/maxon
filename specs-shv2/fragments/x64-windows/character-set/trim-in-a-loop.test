// Test: trim-in-a-loop
function main() returns ExitCode
	var i = 0
	var total = 0
	while i < 50 'loop'
		let padded = "  x  "
		let t = padded.trim()
		total = total + t.byteLength()
		i = i + 1
	end 'loop'
	print("{total}")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_CharacterSet.cachedWhitespacesAndNewlines@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 r12, 0
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegImm32 rbx, 50
    x64.jcc less, loop
    x64.jmp whileexit
  loop:
    x64.leaRegRdata rcx, [rip + __str_rec_8]
    x64.callDirect String.trim#
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r13
    x64.callDirect String.byteLength
    x64.leaRegRegReg r12, r12, r8
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.movRegReg rcx, r13
    x64.callDirect __str_decref
    x64.jmp whilehdr
  whileexit:
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect __int_to_string
    x64.movRegReg r12, r8
    x64.leaRegRegImm32 rcx, r12, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.leaRegRegImm32 r14, r13, 56
    x64.movRegReg rcx, r14
    x64.movRegReg rdx, rbx
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r14, r12
    x64.storeBaseDispReg.word64 [r13 + 0], r14
    x64.storeBaseDispReg.word64 [r13 + 8], r12
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [r13 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r13 + 24], rax
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r13
    x64.callDirect print
    x64.movRegReg rcx, r13
    x64.callDirect __str_decref
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
