// Test: character-set-create
function main() returns ExitCode
	var cs = CharSet.create()
	print("{cs.count()}")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

