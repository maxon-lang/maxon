// Test: supplementary-plane-category
function main() returns ExitCode
	let syms = CharacterSet.symbols()
	let letters = CharacterSet.letters()
	print("{syms.contains('🎉')}\n")
	print("{letters.contains('🎉')}\n")
	print("{letters.contains('𝐀')}")
	return 0
end 'main'
