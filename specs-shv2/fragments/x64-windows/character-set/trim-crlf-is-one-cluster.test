// Test: trim-crlf-is-one-cluster
function main() returns ExitCode
	let s = "\r\nx\r\n"
	let cr = CharacterSet.from(CharSet from ['\r'])
	let r = s.trim(cr)
	print("{r.byteLength()}")
	return 0
end 'main'
---
ExitCode: 0
---
