// Test: nested-union-payload-write-back
typealias Integer = int(i64.min to i64.max)

union Ty
	concrete(name String)
	stringy
end 'Ty'

union Expr
	direct(ty Ty)
	unresolved
end 'Expr'

function tyLen(ty Ty) returns Integer
	return match ty 'l'
		concrete(name) gives name.byteLength()
		stringy gives 0
	end 'l'
end 'tyLen'

function main() returns ExitCode
	var e = Expr.direct(Ty.concrete("the first nested payload, long enough to be a real heap allocation"))

	match e 'write'
		direct(ty) then ty = Ty.concrete("the second one, also a real heap allocation")
		unresolved then print("none")
	end 'write'

	return match e 'read'
		direct(ty) gives tyLen(ty)
		unresolved gives 99
	end 'read'
end 'main'
---
ExitCode: 43
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @tyLen {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext
  matcharm#1:
    x64.loadRegBaseDisp.word64 rbx, [rcx + 8]
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
  __il_body:
    x64.loadRegBaseDisp.word64 r12, [rbx + 8]
  __il_cont:
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegReg r8, r12
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead
  matcharm#2:
    x64.movRegImm32 r8, 0
  matchcont:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.leaRegRdata rbx, [rip + __str_rec_3]
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r12 + 8], r8
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg rbx, r8
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [rbx + 0], rax
    x64.storeBaseDispReg.word64 [rbx + 8], r12
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext#4
  matcharm#1:
    x64.loadRegBaseDisp.word64 r12, [rbx + 8]
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [rbx + 8], rax
    x64.leaRegRdata r13, [rip + __str_rec_4]
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r14 + 0], rax
    x64.movRegReg rcx, r13
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r14 + 8], r8
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Ty
    x64.movRegReg rcx, r14
    x64.callDirect __mm_incref
    x64.storeBaseDispReg.word64 [rbx + 8], r14
    x64.movRegReg rcx, r14
    x64.callDirect __destruct_Ty
    x64.jmp matchcont#5
  matchnext#4:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead#3
  matcharm#2:
    x64.leaRegRdata rcx, [rip + __str_rec_5]
    x64.callDirect print
  matchcont#5:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext#9
  matcharm#6:
    x64.loadRegBaseDisp.word64 r12, [rbx + 8]
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [rbx + 8], rax
    x64.movRegReg rcx, r12
    x64.callDirect tyLen
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Ty
    x64.jmp matchcont#10
  matchnext#9:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead#8
  matcharm#7:
    x64.movRegImm32 r12, 99
    x64.movRegReg r13, r12
  matchcont#10:
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Expr
    x64.cmpRegImm32 r13, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r13, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_6]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r13
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead#8:
  matchdead#3:
}
