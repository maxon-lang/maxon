// Test: write-back-through-a-loop-carried-nested-union-payload
union Ty
	concrete(name String)
	stringy
end 'Ty'

union Expr
	direct(ty Ty)
	unresolved
end 'Expr'

function main() returns ExitCode
	var e = Expr.direct(Ty.concrete("the first nested payload, long enough to be a real heap allocation"))
	var total = 0

	for i in 1 to 2 'round'
		total = total + i
		match e 'write'
			direct(ty) then ty = Ty.concrete("a replacement, also a real heap allocation")
			unresolved then total = total + 1
		end 'write'
		e = Expr.direct(Ty.concrete("the next round's payload, a real heap allocation too"))
	end 'round'

	return total
end 'main'
---
ExitCode: 3
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.leaRegRdata rbx, [rip + __str_rec_3]  ; "the first nested payload, long enough to be a real heap allocation"
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r12 + 8], r8
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.storeBaseDispReg.word64 [r8 + 8], r12
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rax, 1
    x64.movRegReg r12, rbx
    x64.movRegReg rbx, r8
  forhdr:
    x64.storeSlotReg slot0, rax
    x64.cmpRegImm32 rax, 2
    x64.jcc greater, forexit
  round:
    x64.leaRegRegReg r12, r12, rax
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext
  matcharm#5:
    x64.loadRegBaseDisp.word64 r13, [rbx + 8]
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [rbx + 8], rax
    x64.leaRegRdata r14, [rip + __str_rec_4]  ; "a replacement, also a real heap allocation"
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r15, r8
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r15 + 0], rax
    x64.movRegReg rcx, r14
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r15 + 8], r8
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_Ty
    x64.movRegReg rcx, r15
    x64.callDirect __mm_incref
    x64.storeBaseDispReg.word64 [rbx + 8], r15
    x64.movRegReg rcx, r15
    x64.callDirect __destruct_Ty
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead
  matcharm#6:
    x64.leaRegRegImm32 r12, r12, 1
  matchcont:
    x64.leaRegRdata r13, [rip + __str_rec_5]  ; "the next round's payload, a real heap allocation too"
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r14 + 0], rax
    x64.movRegReg rcx, r13
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r14 + 8], r8
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r13 + 0], rax
    x64.storeBaseDispReg.word64 [r13 + 8], r14
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Expr
  forstep:
    x64.loadRegSlot rax, slot0
    x64.leaRegRegImm32 rax, rax, 1
    x64.movRegReg rbx, r13
    x64.jmp forhdr
  matchdead:
  forexit:
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Expr
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_6]  ; "panic at write-back-through-a-loop-carried-nested-union-payload.test:25: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
