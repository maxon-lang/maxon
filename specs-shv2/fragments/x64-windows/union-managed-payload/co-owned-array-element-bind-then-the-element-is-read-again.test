// Test: co-owned-array-element-bind-then-the-element-is-read-again
typealias Integer = int(i64.min to i64.max)
typealias TyArray = Array with Ty

union Ty
	concrete(name String)
	stringy
end 'Ty'

function tyLen(ty Ty) returns Integer
	return match ty 'l'
		concrete(name) gives name.byteLength() as Integer
		stringy gives 0
	end 'l'
end 'tyLen'

function main() returns ExitCode
	var arr = TyArray.create()
	arr.push(Ty.concrete("an array element payload, long enough to be a real heap allocation"))
	var borrowed = try arr.get(0) otherwise panic("get failed")
	let first = match borrowed 'b'
		concrete(name) gives name.byteLength() as Integer
		stringy gives 0
	end 'b'
	let second = tyLen(try arr.get(0) otherwise panic("get failed"))
	print("first={first} second={second}")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @tyLen {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext
  matcharm#1:
    x64.loadRegBaseDisp.word64 rbx, [rcx + 8]
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.movRegReg rcx, rbx
    x64.callDirect String.byteLength
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegReg r8, r12
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead
  matcharm#2:
    x64.movRegImm32 r8, 0
  matchcont:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
}

func @main {
  entry:
