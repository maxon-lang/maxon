// Test: three-managed-payloads-out-of-one-borrowed-union
union R
	one(a String)
	three(a String, b String, c String)
end 'R'

function first(r R) returns String
	return match r 's'
		one(a) gives a
		three(a, b, c) gives a
	end 's'
end 'first'

function main() returns ExitCode
	let r = R.three("a first payload string long enough to heap", b: "a second payload string long enough to heap", c: "a third payload string long enough to heap")
	print(first(r))
	return 6
end 'main'
---
ExitCode: 6
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @first {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#1
    x64.jmp matchnext
  matcharm#1:
    x64.loadRegBaseDisp.word64 rbx, [rbx + 8]
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.movRegReg r8, rbx
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm#2
    x64.jmp matchdead
  matcharm#2:
    x64.loadRegBaseDisp.word64 r12, [rbx + 8]
    x64.movRegReg rcx, r12
    x64.callDirect __mm_incref
    x64.loadRegBaseDisp.word64 r13, [rbx + 16]
    x64.movRegReg rcx, r13
    x64.callDirect __mm_incref
    x64.loadRegBaseDisp.word64 rbx, [rbx + 24]
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegReg rcx, r13
    x64.callDirect __str_decref
    x64.movRegReg r8, r12
    x64.jmp matchcont
  matchcont:
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.leaRegRdata rbx, [rip + __str_rec_3]
    x64.leaRegRdata r12, [rip + __str_rec_4]
    x64.leaRegRdata r13, [rip + __str_rec_5]
    x64.movRegImm32 rcx, 32
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r14 + 0], rax
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r14 + 8], r8
    x64.movRegReg rcx, r12
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r14 + 16], r8
    x64.movRegReg rcx, r13
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r14 + 24], r8
    x64.movRegReg rcx, r14
    x64.callDirect first
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect print
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegImm32 rbx, 6
    x64.movRegReg rcx, r14
    x64.callDirect __destruct_R
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @print {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __write_stdout
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
