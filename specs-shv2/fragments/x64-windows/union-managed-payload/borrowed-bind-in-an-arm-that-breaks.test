// Test: borrowed-bind-in-an-arm-that-breaks
typealias Integer = int(i64.min to i64.max)
typealias Round = int(0 to 100)

union M
	silent
	text(body String)
end 'M'

function show(m M) returns Integer
	var i = 0 as Round
	while i < 10 'spin'
		match m 'k'
			silent then return 0
			text(s) then break 'spin'
		end 'k'
		i = i + 1
	end 'spin'
	return 5
end 'show'

function main() returns ExitCode
	let m = M.text("a broken-arm payload string, long enough to be a real heap allocation")
	return show(m) as ExitCode
end 'main'
---
ExitCode: 5
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @show {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rax, 0
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegImm32 rax, 10
    x64.jcc less, spin
    x64.jmp critsplit
  spin:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#4
    x64.jmp matchnext
  matcharm#4:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm#5
    x64.jmp matchdead
  matcharm#5:
    x64.loadRegBaseDisp.word64 rbx, [rcx + 8]
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.jmp whileexit
  matchdead:
  critsplit:
    x64.jmp whileexit
  whileexit:
    x64.movRegImm32 r8, 5
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchcont:
    x64.leaRegRegImm32 rax, rax, 1
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.leaRegRdata rbx, [rip + __str_rec_1]
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.loadRegBaseDisp.word64 r13, [rbx + 0]
    x64.loadRegBaseDisp.word64 rbx, [rbx + 8]
    x64.leaRegRegImm32 rcx, rbx, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.leaRegRegImm32 r15, r14, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r13
    x64.movRegReg rax, rbx
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r15, rbx
    x64.storeBaseDispReg.word64 [r14 + 0], r15
    x64.storeBaseDispReg.word64 [r14 + 8], rbx
    x64.movRegImm rax, -3
    x64.storeBaseDispReg.word64 [r14 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r14 + 24], rax
    x64.storeBaseDispReg.word64 [r12 + 8], r14
    x64.movRegReg rcx, r12
    x64.callDirect show
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_M
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
