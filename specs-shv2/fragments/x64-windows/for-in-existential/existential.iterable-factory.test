// Test: existential.iterable-factory
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

type IntCursor
	let items as IntArray
	var pos as Integer

	export static function create(items IntArray) returns Self throws IterationError
		if items.count() == 0 'empty'
			throw IterationError.exhausted
		end 'empty'
		return Self{items: items, pos: 0}
	end 'create'

	export function current() returns Integer
		return try self.items.get(self.pos) otherwise 0
	end 'current'

	export function advance() throws IterationError
		if self.pos + 1 >= self.items.count() 'atTheLast'
			throw IterationError.exhausted
		end 'atTheLast'
		self.pos = self.pos + 1
	end 'advance'
end 'IntCursor'

interface Bag
	function createIterator() returns IntCursor throws IterationError
end 'Bag'

type Numbers implements Bag
	let items as IntArray

	export static function create(items IntArray) returns Self
		return Self{items: items}
	end 'create'

	export function createIterator() returns IntCursor throws IterationError
		return try IntCursor.create(self.items)
	end 'createIterator'
end 'Numbers'

function total(source Bag) returns Integer
	var sum = 0 as Integer
	for item in source 'walk'
		sum = sum + item
	end 'walk'
	return sum
end 'total'

function main() returns ExitCode
	var filled = IntArray.create()
	filled.push(4)
	filled.push(5)
	filled.push(6)
	let some = Numbers.create(filled)
	print("{total(some)}\n")

	let none = Numbers.create(IntArray.create())
	print("{total(none)}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @IntCursor.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_count
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, empty
    x64.jmp ifcont
  empty:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.leaRegRegImm32 r10, r12, 1
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r12, 0
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
    x64.storeBaseDispReg.word64 [r13 + 8], r12
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegImm32 r10, 0
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @IntCursor.current {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.word64 rdx, [rcx + 8]
    x64.movRegReg rcx, rax
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 r8, 0
    x64.jmp trycont
  tryok:
    x64.jmp trycont
  trycont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @IntCursor.advance {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.leaRegRegImm32 r12, rax, 1
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.callDirect __managed_count
    x64.cmpRegReg r12, r8
    x64.jcc greaterEqual, atTheLast
    x64.jmp ifcont
  atTheLast:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 r10, rax, 1
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.leaRegRegImm32 rax, rax, 1
    x64.storeBaseDispReg.word64 [rbx + 8], rax
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Numbers.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Numbers.createIterator {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.loadRegBaseDisp.word64 rbx, [rcx + 0]
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.movRegReg rcx, rbx
    x64.callDirect IntCursor.create
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegImm32 r10, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @total {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rdx
    x64.movRegImm32 r12, 0
    x64.callMem [rbx + 24]
    x64.movRegReg rbx, r8
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, critsplit
    x64.jmp forempty
  critsplit:
    x64.jmp forhdr
  forhdr:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, walk
    x64.jmp forexit
  walk:
    x64.movRegReg rcx, rbx
    x64.callDirect IntCursor.current
    x64.leaRegRegReg r12, r12, r8
    x64.jmp forstep
  forstep:
    x64.movRegReg rcx, rbx
    x64.callDirect IntCursor.advance
    x64.movRegReg rax, r10
    x64.jmp forhdr
  forexit:
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_IntCursor
    x64.movRegReg r8, r12
    x64.jmp forjoin
  forempty:
    x64.movRegReg r8, r12
    x64.jmp forjoin
  forjoin:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

