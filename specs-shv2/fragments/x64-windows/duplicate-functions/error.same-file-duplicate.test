// Test: error.same-file-duplicate

typealias Integer = int(i64.min to i64.max)

function helper() returns Integer
	return 1
end 'helper'

function helper() returns Integer
	return 2
end 'helper'

function main() returns ExitCode
	return helper()
end 'main'
