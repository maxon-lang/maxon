// Test: a-static-reads-the-count
typealias Int = int(i64.min to i64.max)
typealias Vec3 = Vector with 3 Int
typealias Vec5 = Vector with 5 Int

var trips = 0

extension Vector
	export static function counted() returns Self
		var i = 0
		while i < countof(Self) 'each'
			trips = trips + 1
			i = i + 1
		end 'each'
		return Self{}
	end 'counted'

	export function rebuild() returns Int
		var fresh = Self.counted()
		if fresh.count() == countof(Self) 'theStaticsResultStatesTheReceiversCount'
			return 0
		end 'theStaticsResultStatesTheReceiversCount'
		panic("a `Self`-returning static builds the instance its call site holds")
	end 'rebuild'
end 'Vector'

function main() returns ExitCode
	var a = Vec3.create()
	var b = Vec5.create()
	return a.rebuild() + b.rebuild() + trips
end 'main'
---
ExitCode: 8
---
data {
  __data_trips@0 = i64 0
  __slab_cursor@8 = i64 0
  __slab_end@16 = i64 0
  __mm_alloc_count@24 = i64 0
}

func @Vector.counted {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rdx
    x64.movRegImm32 rax, 0
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegReg rax, rbx
    x64.jcc less, each
    x64.jmp whileexit
  each:
    x64.leaRegGlobal rdx, __data_trips
    x64.loadRegBaseDisp.word64 rdx, [rdx + 0]
    x64.leaRegRegImm32 rdx, rdx, 1
    x64.leaRegGlobal rsi, __data_trips
    x64.storeBaseDispReg.word64 [rsi + 0], rdx
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp whilehdr
  whileexit:
    x64.movRegImm32 rax, 8
    x64.loadRegBaseDisp.word64 rdx, [rcx + 40]
    x64.movRegReg rcx, rax
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect __managed_resize
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Vector.rebuild {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rax
    x64.movRegReg rcx, rdx
    x64.movRegReg rdx, rbx
    x64.callDirect Vector.counted
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.callDirect Vector.count
    x64.cmpRegReg r8, rbx
    x64.jcc equal, theStaticsResultStatesTheReceiversCount
    x64.jmp ifcont
  theStaticsResultStatesTheReceiversCount:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.leaRegRdata rcx, [rip + __layout_Vector_N3_Int]
    x64.movRegImm32 rdx, 3
    x64.callDirect Vector.create
    x64.movRegReg rbx, r8
    x64.leaRegRdata rcx, [rip + __layout_Vector_N5_Int]
    x64.movRegImm32 rdx, 5
    x64.callDirect Vector.create
    x64.movRegReg r12, r8
    x64.leaRegRdata rdx, [rip + __layout_Vector_N3_Int]
    x64.movRegImm32 rax, 3
    x64.movRegReg rcx, rbx
    x64.callDirect Vector.rebuild
    x64.movRegReg r13, r8
    x64.leaRegRdata rdx, [rip + __layout_Vector_N5_Int]
    x64.movRegImm32 rax, 5
    x64.movRegReg rcx, r12
    x64.callDirect Vector.rebuild
    x64.leaRegRegReg rax, r13, r8
    x64.leaRegGlobal rcx, __data_trips
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.leaRegRegReg r13, rax, rcx
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r13, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r13, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Vector.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rdx
    x64.movRegImm32 rax, 8
    x64.loadRegBaseDisp.word64 rdx, [rcx + 40]
    x64.movRegReg rcx, rax
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect __managed_resize
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Vector.count {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __managed_count
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
