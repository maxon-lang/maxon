// Test: float.hash.zero-normalization
function main() returns ExitCode
	let pos = 0.0
	let neg = -0.0
	let h1 = pos.hash()
	let h2 = neg.hash()
	if h1 == h2 'eq'
		return 1
	end 'eq'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.storeSlotReg slot0, xmm6
    x64.movsdRegRip xmm0, [rip + __fconst_0]
    x64.movsdRegRip xmm6, [rip + __fconst_1]
    x64.callDirect float.hash
    x64.movRegReg rbx, r8
    x64.movRegReg xmm0, xmm6
    x64.callDirect float.hash
    x64.cmpRegReg rbx, r8
    x64.jcc equal, eq
    x64.jmp ifcont
  eq:
    x64.movRegImm32 r8, 1
    x64.loadRegSlot xmm6, slot0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.loadRegSlot xmm6, slot0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @float.hash {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movqGprXmm r8, xmm0
    x64.movRegImm32 rax, 4294967295
    x64.andRegReg r8, r8, rax
    x64.popReg rbp
    x64.ret
}
