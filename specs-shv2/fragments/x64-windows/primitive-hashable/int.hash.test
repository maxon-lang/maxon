// Test: int.hash
function main() returns ExitCode
	let i = 42
	let h = i.hash()
	return h
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 42
    x64.jmp __il_body
  __il_body:
    x64.movRegImm32 rax, 4294967295
    x64.andRegImm32 rax, rax, 42
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __il_slow
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rdx, 4294967295
    x64.cmpRegReg rax, rdx
    x64.jcc greater, __il_slow
    x64.jmp __rc_ok
  __il_slow:
    x64.callDirect int.hash
    x64.jmp __il_cont
  __rc_ok:
    x64.movRegReg r8, rax
    x64.jmp __il_cont
  __il_cont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
