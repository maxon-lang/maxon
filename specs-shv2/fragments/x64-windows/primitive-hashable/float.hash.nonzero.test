// Test: float.hash.nonzero
function main() returns ExitCode
	let f = 3.14
	let h = f.hash()
	if h != 0 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  ifcont#6:
    x64.movRegImm32 rax, 1374389535
  __il_cont:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont#2
  check:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
