// Test: int.equals.same
function main() returns ExitCode
	let a = 42
	let b = 42
	if a.equals(b) 'eq'
		return 1
	end 'eq'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 42
  __il_body:
    x64.cmpRegImm32 rax, 42
    x64.setccReg equal, rax
  __il_cont:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont
  eq:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
