func @reader {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_1]  ; "cmd /c echo hello"
    x64.callDirect __gt_io_read
    x64.epilogue 32
