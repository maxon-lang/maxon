// Test: spawn-read-line.spawned-reader
function reader() returns Integer
	return spawnReadLine("cmd /c echo hello")
end 'reader'

function main() returns ExitCode
	let r = async reader()
	let n = await r
	return n as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
