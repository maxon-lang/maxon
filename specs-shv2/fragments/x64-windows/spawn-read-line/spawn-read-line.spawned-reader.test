    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at spawn-read-line.spawned-reader.test:9: Range check failed: value outside typealias 'ExitCode'\x0a"
