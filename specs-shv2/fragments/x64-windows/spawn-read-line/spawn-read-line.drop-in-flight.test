// Test: spawn-read-line.drop-in-flight
function reader() returns Integer
	return spawnReadLine("cmd /c echo hello")
end 'reader'

function dropInFlight() returns Integer
	_ = async reader()
	sleep(1)
	return 0
end 'dropInFlight'

function main() returns ExitCode
	var i = 0
	while i < 5 'loop'
		_ = dropInFlight()
		i = i + 1
	end 'loop'
	let n = spawnReadLine("cmd /c echo hello")
	return n as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __gt_run_queue_head@8 = i64 0
  __gt_run_queue_tail@16 = i64 0
  __gt_init_done@24 = i64 0
  __gt_timer_count@32 = i64 0
  __gt_timer_heap_base@40 = i64 0
  __gt_timer_capacity@48 = i64 0
  __gt_trace_counter@56 = i64 0
  __gt_proc_count@64 = i64 0
  __gt_proc_handles_base@72 = i64 0
  __gt_proc_gts_base@80 = i64 0
  __gt_proc_wait_snapshot@88 = i64 0
  __gt_proc_poller@96 = i64 0
  __gt_live_count@104 = i64 0
  __sched_progress@112 = i64 0
  __sched_active_workers@120 = i64 1
  __sched_max_active_workers@128 = i64 1
  __sched_tls_index@136 = i64 0
  __sched_tls_teb_offset@144 = i64 0
  __sched_procs@152 = i64 0
  __sched_num_procs@160 = i64 0
  __sched_shutdown_flag@168 = i64 0
  __sched_lock@176 = i64 0
  __io_iocp@184 = i64 0
  __io_done_event@192 = i64 0
  __io_init_done@200 = i64 0
  __io_pending@208 = i64 0
  __io_pipe_seq@216 = i64 0
  __slab_arena_list@224 = i64 0
  __slab_arena_map_l1@232 = i64 0
  __slab_state@240 = i64 0
}

func @reader {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_1]  ; "cmd /c echo hello"
    x64.callDirect __gt_io_read
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @dropInFlight {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.leaRegFunc rcx, [rip + reader]
    x64.callDirect __gt_spawn
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __gt_ready
    x64.movRegReg rcx, rbx
    x64.callDirect __gt_promise_drop
    x64.movRegImm32 rcx, 1
    x64.callDirect sleep
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
  whilehdr:
    x64.cmpRegImm32 rbx, 5
    x64.jcc greaterEqual, whileexit
  loop:
    x64.callDirect dropInFlight
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp whilehdr
  whileexit:
    x64.leaRegRdata rcx, [rip + __str_rec_1]  ; "cmd /c echo hello"
    x64.callDirect __gt_io_read
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at spawn-read-line.drop-in-flight.test:19: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
