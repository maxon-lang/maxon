// Test: async-stack-growth.deep-recursion

function deepRecurse(n int) returns int
	if n == 0 'base'
		return 0
	end 'base'
	return deepRecurse(n - 1) + 1
end 'deepRecurse'

function main() returns ExitCode
	let p = async deepRecurse(200)
	let r = await p
	return r as ExitCode
end 'main'
---
ExitCode: 200
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
  __gt_current_gt@24 = i64 0
  __gt_run_queue_head@32 = i64 0
  __gt_run_queue_tail@40 = i64 0
  __gt_init_done@48 = i64 0
  __gt_system_stack_top@56 = i64 0
  __gt_timer_count@64 = i64 0
  __gt_timer_heap_base@72 = i64 0
  __gt_clock_ticks@80 = i64 0
  __gt_clock_freq@88 = i64 0
  __gt_proc_count@96 = i64 0
  __gt_proc_handles_base@104 = i64 0
  __gt_proc_gts_base@112 = i64 0
  __gt_free_list_head@120 = i64 0
  __gt_live_count@128 = i64 0
  __gt_startup_base@136 = i64 0
  __gt_procinfo_base@144 = i64 0
  __gt_exitcode_base@152 = i64 0
  __gt_cmdline_buf_base@160 = i64 0
  __gt_cmdline_buf_cap@168 = i64 0
}

func @deepRecurse {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, base
    x64.jmp ifcont
  base:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.leaRegRegImm32 rcx, rcx, -1
    x64.callDirect deepRecurse
    x64.leaRegRegImm32 r8, r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 200
    x64.leaRegFunc rcx, [rip + deepRecurse]
    x64.callDirect __gt_spawn
    x64.storeBaseDispReg.word64 [r8 + 184], rbx
    x64.movRegReg rcx, r8
    x64.callDirect __gt_await
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
