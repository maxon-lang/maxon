// Test: async-stack-growth.grow-then-complete-then-respawn

function deepRecurse(n int) returns int
	Runtime.yield()
	if n == 0 'base'
		return 0
	end 'base'
	return deepRecurse(n - 1) + 1
end 'deepRecurse'

function main() returns ExitCode
	let p1 = async deepRecurse(60)
	let r1 = await p1
	let p2 = async deepRecurse(90)
	let r2 = await p2
	return (r1 + r2) as ExitCode
end 'main'
---
ExitCode: 150
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
  __gt_current_gt@24 = i64 0
  __gt_run_queue_head@32 = i64 0
  __gt_run_queue_tail@40 = i64 0
  __gt_init_done@48 = i64 0
  __gt_system_stack_top@56 = i64 0
  __gt_timer_count@64 = i64 0
  __gt_timer_heap_base@72 = i64 0
  __gt_timer_capacity@80 = i64 0
  __gt_trace_counter@88 = i64 0
  __gt_trace_digits@96 = i64 0
  __gt_clock_ticks@104 = i64 0
  __gt_clock_freq@112 = i64 0
  __gt_proc_count@120 = i64 0
  __gt_proc_handles_base@128 = i64 0
  __gt_proc_gts_base@136 = i64 0
  __gt_free_list_head@144 = i64 0
  __gt_live_count@152 = i64 0
  __gt_startup_base@160 = i64 0
  __gt_procinfo_base@168 = i64 0
  __gt_exitcode_base@176 = i64 0
  __gt_cmdline_buf_base@184 = i64 0
  __gt_cmdline_buf_cap@192 = i64 0
}

func @deepRecurse {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.callDirect Runtime.yield
    x64.cmpRegImm32 rbx, 0
    x64.jcc equal, base
    x64.jmp ifcont
  base:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.leaRegRegImm32 rcx, rbx, -1
    x64.callDirect deepRecurse
    x64.leaRegRegImm32 r8, r8, 1
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rbx, 60
    x64.leaRegFunc rcx, [rip + deepRecurse]
    x64.callDirect __gt_spawn
    x64.storeBaseDispReg.word64 [r8 + 192], rbx
    x64.movRegReg rcx, r8
    x64.callDirect __gt_await
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 90
    x64.leaRegFunc rcx, [rip + deepRecurse]
    x64.callDirect __gt_spawn
    x64.storeBaseDispReg.word64 [r8 + 192], r12
    x64.movRegReg rcx, r8
    x64.callDirect __gt_await
    x64.leaRegRegReg r8, rbx, r8
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Runtime.yield {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __gt_resched
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
