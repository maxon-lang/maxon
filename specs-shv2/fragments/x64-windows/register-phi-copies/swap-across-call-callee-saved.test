// Test: swap-across-call-callee-saved
function sink(x int) returns int
	return x
end 'sink'

function swapAcrossCall(p int) returns int
	var a = p + 1
	var b = p + 2
	var i = 0
	while i < 3 'loop'
		let t = a
		a = b
		b = t
		i = i + sink(1)
	end 'loop'
	return a * 10 + b
end 'swapAcrossCall'

function main() returns ExitCode
	let r = swapAcrossCall(0)
	if r == 21 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @swapAcrossCall {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegRegImm32 rax, rcx, 1
    x64.leaRegRegImm32 rcx, rcx, 2
    x64.movRegImm32 rdx, 0
  whilehdr:
    x64.cmpRegImm32 rdx, 3
    x64.jcc greaterEqual, whileexit
  __il_cont:
    x64.leaRegRegImm32 rdx, rdx, 1
    x64.xchgRegReg rax, rcx
    x64.jmp whilehdr
  whileexit:
    x64.imulRegRegImm32 rax, rax, 10
    x64.leaRegRegReg r8, rax, rcx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 0
    x64.callDirect swapAcrossCall
    x64.cmpRegImm32 r8, 21
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
