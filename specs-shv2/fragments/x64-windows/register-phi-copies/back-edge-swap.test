// Test: back-edge-swap
function swapLoop(p Integer) returns Integer
	var a = p + 1
	var b = p + 2
	var i = 0
	while i < 3 'loop'
		let t = a
		a = b
		b = t
		i = i + 1
	end 'loop'
	return a * 10 + b
end 'swapLoop'

function main() returns ExitCode
	let r = swapLoop(0)
	if r == 21 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 rax, 1
    x64.movRegImm32 rcx, 2
    x64.movRegImm32 rdx, 0
  whilehdr:
    x64.cmpRegImm32 rdx, 3
    x64.jcc greaterEqual, whileexit
  loop:
    x64.leaRegRegImm32 rdx, rdx, 1
    x64.xchgRegReg rax, rcx
    x64.jmp whilehdr
  whileexit:
    x64.imulRegRegImm32 rax, rax, 10
    x64.leaRegRegReg rax, rax, rcx
  __il_cont:
    x64.cmpRegImm32 rax, 21
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.popReg rbp
    x64.ret
}
