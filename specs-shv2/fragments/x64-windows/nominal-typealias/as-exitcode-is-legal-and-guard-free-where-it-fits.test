// Test: as-exitcode-is-legal-and-guard-free-where-it-fits
typealias Byte = int(0 to u8.max)

function main() returns ExitCode
	let b = 7 as Byte
	return b as ExitCode
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 7
    x64.popReg rbp
    x64.ret
}
