// Test: error.narrow-returned-where-wide-declared
typealias Wide = int(0 to u64.max)
typealias Narrow = int(0 to 16)

function widen(n Narrow) returns Wide
	return n
end 'widen'

function main() returns ExitCode
	let w = widen(5)
	print("{w}")
	return 0
end 'main'
---
CompilerError:
error E3005: <fragment>:6:2: Cannot return 'Narrow' from function declared to return 'Wide'
