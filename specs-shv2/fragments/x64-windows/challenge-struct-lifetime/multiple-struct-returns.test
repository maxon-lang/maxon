// Test: multiple-struct-returns

typealias Integer = int(i64.min to i64.max)

type Value
	export var n as Integer

	static function create(n Integer) returns Self
		return Self{n: n}
	end 'create'
end 'Value'

function step1() returns Value
	return Value.create(1)
end 'step1'

function step2(v Value) returns Value
	return Value.create(v.n + 10)
end 'step2'

function step3(v Value) returns Value
	return Value.create(v.n + 100)
end 'step3'

function main() returns ExitCode
	let v1 = step1()
	let v2 = step2(v1)
	let v3 = step3(v2)
	return v3.n
end 'main'
---
ExitCode: 111
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Value.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @step1 {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 1
    x64.callDirect Value.create
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @step2 {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.leaRegRegImm32 rcx, rax, 10
    x64.callDirect Value.create
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @step3 {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.leaRegRegImm32 rcx, rax, 100
    x64.callDirect Value.create
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.callDirect step1
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect step2
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.callDirect step3
    x64.loadRegBaseDisp.word64 r13, [r8 + 0]
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.cmpRegImm32 r13, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r13, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
