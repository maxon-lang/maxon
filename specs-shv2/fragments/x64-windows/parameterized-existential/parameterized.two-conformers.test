// Test: parameterized.two-conformers
typealias Integer = int(i64.min to i64.max)

interface Seq uses Element
	function current() returns Element
	function advance() throws IterationError
end 'Seq'

type Upto implements Seq with Integer
	var pos as Integer
	let limit as Integer

	export static function create(limit Integer) returns Self
		return Self{pos: 1, limit: limit}
	end 'create'

	export function current() returns Integer
		return self.pos
	end 'current'

	export function advance() throws IterationError
		if self.pos >= self.limit 'atTheLast'
			throw IterationError.exhausted
		end 'atTheLast'
		self.pos = self.pos + 1
	end 'advance'
end 'Upto'

type Down implements Seq with Integer
	var pos as Integer

	export static function create(start Integer) returns Self
		return Self{pos: start}
	end 'create'

	export function current() returns Integer
		return self.pos
	end 'current'

	export function advance() throws IterationError
		if self.pos <= 1 'atTheLast'
			throw IterationError.exhausted
		end 'atTheLast'
		self.pos = self.pos - 1
	end 'advance'
end 'Down'

typealias IntegerSeq = Seq with Integer

function total(source IntegerSeq) returns Integer
	var sum = 0 as Integer
	for item in source 'walk'
		sum = sum + item
	end 'walk'
	return sum
end 'total'

function makeUp() returns IntegerSeq
	return Upto.create(4)
end 'makeUp'

function makeDown() returns IntegerSeq
	return Down.create(3)
end 'makeDown'

function pick(up bool) returns Integer
	var s = makeUp()
	if not up 'other'
		s = makeDown()
	end 'other'
	return total(s)
end 'pick'

function main() returns ExitCode
	print("{pick(true)}\n")
	print("{pick(false)}\n")
	print("{total(Upto.create(2)) + total(Down.create(2))}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Upto.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegImm32 r12, 1
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], r12
    x64.storeBaseDispReg.word64 [r8 + 8], rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Upto.current {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 r8, [rcx + 0]
    x64.popReg rbp
    x64.ret
}

func @Upto.advance {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.word64 rdx, [rcx + 8]
    x64.cmpRegReg rax, rdx
    x64.jcc greaterEqual, atTheLast
    x64.jmp ifcont
  atTheLast:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 r10, rax, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.leaRegRegImm32 rax, rax, 1
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
}

func @Down.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Down.current {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 r8, [rcx + 0]
    x64.popReg rbp
    x64.ret
}

func @Down.advance {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.cmpRegImm32 rax, 1
    x64.jcc lessEqual, atTheLast
    x64.jmp ifcont
  atTheLast:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 r10, rax, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.leaRegRegImm32 rax, rax, -1
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
}

func @total {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegImm32 r13, 0
    x64.movRegImm32 rax, 0
    x64.jmp forhdr
  forhdr:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, walk
    x64.jmp forexit
  walk:
    x64.movRegReg rcx, rbx
    x64.callMem [r12 + 24]
    x64.leaRegRegReg r13, r13, r8
    x64.jmp forstep
  forstep:
    x64.movRegReg rcx, rbx
    x64.callMem [r12 + 32]
    x64.movRegReg rax, r10
    x64.jmp forhdr
  forexit:
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @makeUp {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 4
    x64.callDirect Upto.create
    x64.leaRegRdata r10, [rip + __witness_Upto.Seq]
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @makeDown {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 3
    x64.callDirect Down.create
    x64.leaRegRdata r10, [rip + __witness_Down.Seq]
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @pick {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.callDirect makeUp
    x64.movRegReg r12, r8
    x64.movRegReg r13, r10
    x64.xorRegImm32 rbx, rbx, 1
    x64.cmpRegImm32 rbx, 0
    x64.jcc notEqual, other
    x64.jmp critsplit
  other:
    x64.callDirect makeDown
    x64.movRegReg rbx, r8
    x64.movRegReg r14, r10
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r12
    x64.callDirect __drop_existential
    x64.jmp ifcont
  critsplit:
    x64.movRegReg rbx, r12
    x64.movRegReg r14, r13
    x64.jmp ifcont
  ifcont:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r14
    x64.callDirect total
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r14
    x64.movRegReg rdx, rbx
    x64.callDirect __drop_existential
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

