// Test: floor.with-ceil
function main() returns ExitCode
	let x = 3.7
	let a = trunc(floor(x))
	let b = trunc(ceil(x))
	return a + b
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 7
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
