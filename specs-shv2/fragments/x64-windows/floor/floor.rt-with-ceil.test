func @CommandLine.args {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.callDirect __cl_count
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __str_decref]
    x64.callDirect __arr_create
    x64.movRegReg r12, r8
    x64.movRegImm32 r13, 0
    x64.jmp forhdr
  forhdr:
    x64.cmpRegReg r13, rbx
    x64.jcc less, loop
    x64.jmp forexit
  loop:
    x64.movRegReg rcx, r13
    x64.callDirect __cl_arg
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r14
    x64.callDirect __str_from_bytes
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r8
    x64.callDirect __arr_push
    x64.movRegReg rcx, r14
    x64.callDirect __arr_decref
    x64.jmp forstep
  forstep:
    x64.leaRegRegImm32 r13, r13, 1
    x64.jmp forhdr
  forexit:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
