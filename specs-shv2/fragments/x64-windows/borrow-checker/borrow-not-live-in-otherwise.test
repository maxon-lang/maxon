    x64.leaRegRdata rdx, [rip + __witness_String.Hashable]
    x64.leaRegRdata rax, [rip + __witness_String.Equatable]
    x64.callDirect Map.create
    x64.storeSlotReg slot0, r8
    x64.leaRegRdata rdx, [rip + __str_rec_2]  ; "hello"
    x64.movRegReg rcx, r8
    x64.callDirect intern
    x64.storeSlotReg slot1, r8
    x64.loadRegBaseDisp.word64 rbx, [r8 + 8]
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
