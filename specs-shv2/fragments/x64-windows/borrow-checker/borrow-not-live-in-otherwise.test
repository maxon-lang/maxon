// Test: borrow-not-live-in-otherwise
typealias ByteArrayMap = Map with (String, ByteArray)

function intern(lookup ByteArrayMap, name String) returns ByteArray
	let existing = try lookup.get(name) otherwise 'fresh'
		let bytes = name.toByteArray()
		lookup.upsert(name, value: bytes)
		return bytes
	end 'fresh'
	return existing
end 'intern'

function main() returns ExitCode
	var m = ByteArrayMap.create()
	let bytes = intern(m, name: "hello")
	print("{bytes.count()}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @intern {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.storeSlotReg slot0, rcx
    x64.movRegReg rbx, rdx
    x64.leaRegRdata rax, [rip + __layout_Map_String_ByteArray]
    x64.leaRegRdata r9, [rip + __witness_String.Hashable]
    x64.leaRegRdata rsi, [rip + __witness_String.Equatable]
    x64.movRegReg rdx, rbx
    x64.callDirect Map.get
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegReg rcx, rbx
    x64.callDirect String.toByteArray
    x64.movRegReg r12, r8
    x64.loadRegBaseDisp.word64 r13, [rbx + 0]
    x64.loadRegBaseDisp.word64 rbx, [rbx + 8]
    x64.leaRegRegImm32 rcx, rbx, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.leaRegRegImm32 r15, r14, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r13
    x64.movRegReg rax, rbx
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r15, rbx
    x64.storeBaseDispReg.word64 [r14 + 0], r15
    x64.storeBaseDispReg.word64 [r14 + 8], rbx
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [r14 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r14 + 24], rax
    x64.movRegReg rcx, r12
    x64.callDirect __mm_incref
    x64.leaRegRdata r9, [rip + __layout_Map_String_ByteArray]
    x64.leaRegRdata rsi, [rip + __witness_String.Hashable]
    x64.leaRegRdata rdi, [rip + __witness_String.Equatable]
    x64.loadRegSlot rcx, slot0
    x64.movRegReg rdx, r14
    x64.movRegReg rax, r12
    x64.callDirect Map.upsert
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

