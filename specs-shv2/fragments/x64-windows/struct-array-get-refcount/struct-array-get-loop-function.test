// Test: struct-array-get-loop-function
typealias Integer = int(i64.min to i64.max)

type Pair
		export var a as Integer
		export var b as Integer

		static function create(a Integer, b Integer) returns Self
			return Self{a: a, b: b}
		end 'create'
end 'Pair'

typealias PairArray = Array with Pair

function sumAll(pairs PairArray) returns Integer
		var total = 0
		for pair in pairs 'loop'
				total = total + pair.a + pair.b
		end 'loop'
		return total
end 'sumAll'

function main() returns ExitCode
		var pairs = PairArray.create()
		pairs.push(Pair.create(1, b: 2))
		pairs.push(Pair.create(3, b: 4))
		pairs.push(Pair.create(5, b: 6))
		let sum = sumAll(pairs)
		// After sumAll, elements should still be valid
		let p1 = try pairs.get(1) otherwise Pair.create(0, b: 0)
		if sum == 21 'ok'
				return p1.a + p1.b
		end 'ok'
		return 0
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Pair.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.storeBaseDispReg.word64 [r8 + 8], r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __mm_decref]
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 2
    x64.callDirect Pair.create
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.movRegImm32 rcx, 3
    x64.movRegImm32 rdx, 4
    x64.callDirect Pair.create
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.movRegImm32 rcx, 5
    x64.movRegImm32 rdx, 6
    x64.callDirect Pair.create
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
  __il_body:
    x64.movRegImm32 r12, 0
    x64.movRegImm32 rax, 0
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
    x64.loadRegBaseDisp.word64 rdx, [rbx + 0]
  forhdr:
    x64.cmpRegReg rax, rcx
    x64.jcc greaterEqual, __il_cont
  loop:
    x64.loadRegBaseIndexScale.word64 rsi, [rdx + rax*8 + 0]
  __im_cont#19:
    x64.loadRegBaseDisp.word64 rdi, [rsi + 0]
    x64.leaRegRegReg rdi, r12, rdi
    x64.loadRegBaseDisp.word64 rsi, [rsi + 8]
    x64.leaRegRegReg rsi, rdi, rsi
  forstep:
    x64.leaRegRegImm32 rax, rax, 1
    x64.movRegReg r12, rsi
    x64.jmp forhdr
  __il_cont:
    x64.movRegImm32 rdx, 1
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
