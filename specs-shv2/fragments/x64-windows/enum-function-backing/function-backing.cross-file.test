// Test: function-backing.cross-file
// --- file: api/ops.maxon
typealias Integer = int(i64.min to i64.max)

export function doubleFn(x Integer) returns Integer
	return x * 2
end 'doubleFn'

export function tripleFn(x Integer) returns Integer
	return x * 3
end 'tripleFn'

// --- file: api/dispatch.maxon
export enum Op
	doubleOp = doubleFn
	tripleOp = tripleFn
end 'Op'

// --- file: app/main.maxon
function main() returns ExitCode
	let f = Op.tripleOp.rawValue
	return f(14)
end 'main'
---
ExitCode: 42
---
func @doubleFn {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.imulRegRegImm32 r8, rcx, 2
    x64.popReg rbp
    x64.ret
}

func @tripleFn {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.imulRegRegImm32 r8, rcx, 3
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.leaRegFunc rax, [rip + __fnref_doubleFn]
    x64.imulRegRegImm32 rax, rax, 0
    x64.leaRegFunc rcx, [rip + __fnref_tripleFn]
    x64.leaRegRegReg rbx, rax, rcx
    x64.movRegImm32 rcx, 14
    x64.movRegImm32 rdx, 0
    x64.callReg rbx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at main.maxon:3: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
