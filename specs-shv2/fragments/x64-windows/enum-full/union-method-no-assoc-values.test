// Test: union-method-no-assoc-values
union Status
	pending
	active
	closed

	function isActive() returns bool
		return match self 'check'
			pending gives false
			active gives true
			closed gives false
		end 'check'
	end 'isActive'
end 'Status'

function main() returns ExitCode
	let s = Status.active
	if s.isActive() 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 1
    x64.jmp __il_body
  __il_body:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#5
    x64.jmp matchnext#9
  matcharm#5:
    x64.movRegImm32 rax, 0
    x64.jmp matchcont
  matchnext#9:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm#6
    x64.jmp matchnext#10
  matcharm#6:
    x64.movRegImm32 rax, 1
    x64.jmp matchcont
  matchnext#10:
    x64.cmpRegImm32 rax, 2
    x64.jcc equal, matcharm#7
    x64.jmp matchdead
  matcharm#7:
    x64.movRegImm32 rax, 0
    x64.jmp matchcont
  matchcont:
    x64.jmp __il_cont
  __il_cont:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, check
    x64.jmp ifcont
  check:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  matchdead:
}
