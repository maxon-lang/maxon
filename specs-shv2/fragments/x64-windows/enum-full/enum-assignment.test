// Test: enum-assignment
enum Color
	red
	green
	blue
end 'Color'

function main() returns ExitCode
	var c = Color.red
	c = Color.blue
	let result = match c 'check'
		red gives 0
		green gives 0
		blue gives 1
	end 'check'
	return result
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 2
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm
    x64.jmp matchnext
  matcharm:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm
    x64.jmp matchnext
  matcharm:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 2
    x64.jcc equal, matcharm
    x64.jmp matchdead
  matcharm:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont
  matchcont:
    x64.popReg rbp
    x64.ret
  matchdead:
}
