// Test: overloads-three-way-agree-on-the-error-they-throw
typealias Num = int(-1000 to 1000)

enum TestFailure
	mismatch
end 'TestFailure'

type Expect

	export static function equal(actual Num, expected Num) returns Num throws TestFailure
		if actual != expected 'differ'
			throw TestFailure.mismatch
		end 'differ'
		return 1
	end 'equal'

	export static function equal(actual String, expected String) returns Num throws TestFailure
		if actual.count() != expected.count() 'differ'
			throw TestFailure.mismatch
		end 'differ'
		return 2
	end 'equal'

	export static function equal(actual bool, expected bool) returns Num throws TestFailure
		if actual != expected 'differ'
			throw TestFailure.mismatch
		end 'differ'
		return 4
	end 'equal'

end 'Expect'

function main() returns ExitCode
	let a = try Expect.equal(1, expected: 1) otherwise 0
	let b = try Expect.equal("xy", expected: "ab") otherwise 0
	let c = try Expect.equal(true, expected: true) otherwise 0
	return (a + b + c) as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Expect.equal {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, -1000
    x64.jcc less, __rc_panic#4
  __rc_chk#5:
    x64.cmpRegImm32 rcx, 1000
    x64.jcc lessEqual, __rc_ok#3
  __rc_panic#4:
    x64.leaRegRdata rcx, [rip + __str_blob_15]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#3:
    x64.cmpRegImm32 rdx, -1000
    x64.jcc less, __rc_panic#7
  __rc_chk#8:
    x64.cmpRegImm32 rdx, 1000
    x64.jcc lessEqual, __rc_ok#6
  __rc_panic#7:
    x64.leaRegRdata rcx, [rip + __str_blob_15]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#6:
    x64.cmpRegReg rcx, rdx
    x64.jcc equal, ifcont
  differ:
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 1
    x64.movRegImm32 r10, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @Expect.equal#String#String {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rdx
    x64.callDirect String.count
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect String.count
    x64.cmpRegReg r12, r8
    x64.jcc equal, ifcont
  differ:
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 2
    x64.movRegImm32 r10, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Expect.equal#bool#bool {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegReg rcx, rdx
    x64.jcc equal, ifcont
  differ:
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 4
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 1
    x64.callDirect Expect.equal
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#1
  tryerr#2:
    x64.movRegImm32 rbx, 0
    x64.jmp trycont#3
  tryok#1:
    x64.movRegReg rbx, r8
  trycont#3:
    x64.leaRegRdata rcx, [rip + __str_rec_2]
    x64.leaRegRdata rdx, [rip + __str_rec_3]
    x64.callDirect Expect.equal#String#String
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#4
  tryerr#5:
    x64.movRegImm32 r12, 0
    x64.jmp trycont#6
  tryok#4:
    x64.movRegReg r12, r8
  trycont#6:
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 1
    x64.callDirect Expect.equal#bool#bool
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#7
  tryerr#8:
    x64.movRegImm32 rax, 0
    x64.jmp trycont#9
  tryok#7:
    x64.movRegReg rax, r8
  trycont#9:
    x64.leaRegRegReg rcx, rbx, r12
    x64.leaRegRegReg r8, rcx, rax
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_16]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
