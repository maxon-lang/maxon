// Test: overloads-agree-on-the-error-they-throw
typealias Num = int(-1000 to 1000)

enum Boom
	bad
end 'Boom'

type Chk

	export static function want(actual Num, expected Num) returns Num throws Boom
		if actual != expected 'differ'
			throw Boom.bad
		end 'differ'
		return 5
	end 'want'

	export static function want(actual bool, expected bool) returns Num throws Boom
		if actual != expected 'differ'
			throw Boom.bad
		end 'differ'
		return 9
	end 'want'

end 'Chk'

function main() returns ExitCode
	let a = try Chk.want(1, expected: 1) otherwise 0
	let b = try Chk.want(true, expected: true) otherwise 0
	return (a + b) as ExitCode
end 'main'
---
ExitCode: 14
---
func @Chk.want {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, -1000
    x64.jcc less, __rc_panic#4
  __rc_chk#5:
    x64.cmpRegImm32 rcx, 1000
    x64.jcc lessEqual, __rc_ok#3
  __rc_panic#4:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#3:
    x64.cmpRegImm32 rdx, -1000
    x64.jcc less, __rc_panic#7
  __rc_chk#8:
    x64.cmpRegImm32 rdx, 1000
    x64.jcc lessEqual, __rc_ok#6
  __rc_panic#7:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#6:
    x64.cmpRegReg rcx, rdx
    x64.jcc equal, ifcont
  differ:
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 5
    x64.movRegImm32 r10, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @Chk.want#bool#bool {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegReg rcx, rdx
    x64.jcc equal, ifcont
  differ:
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 9
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 1
    x64.callDirect Chk.want
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#1
  tryerr#2:
    x64.movRegImm32 rbx, 0
    x64.jmp trycont#3
  tryok#1:
    x64.movRegReg rbx, r8
  trycont#3:
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 1
    x64.callDirect Chk.want#bool#bool
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#4
  tryerr#5:
    x64.movRegImm32 rax, 0
    x64.jmp trycont#6
  tryok#4:
    x64.movRegReg rax, r8
  trycont#6:
    x64.leaRegRegReg r8, rbx, rax
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
