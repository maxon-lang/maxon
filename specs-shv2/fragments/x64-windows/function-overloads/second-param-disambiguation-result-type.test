// Test: second-param-disambiguation-result-type
typealias Integer = int(i64.min to i64.max)

type Registry
	export var seed as Integer

	export static function make(seed Integer) returns Registry
		return Registry{seed: seed}
	end 'make'
end 'Registry'

function lookup(reg Registry, index Integer) returns Integer
	return reg.seed + index
end 'lookup'

function lookup(reg Registry, present bool) returns bool
	if present 'yes'
		return reg.seed > 0
	end 'yes'
	return false
end 'lookup'

function useInt(value Integer) returns Integer
	return value
end 'useInt'

function useBool(flag bool) returns Integer
	if flag 'on'
		return 1
	end 'on'
	return 0
end 'useBool'

function main() returns ExitCode
	let reg = Registry.make(10)
	let asInt = lookup(reg, index: 5)
	let asBool = lookup(reg, present: true)
	return useInt(asInt) + useBool(asBool)
end 'main'
---
ExitCode: 16
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.movRegImm32 rax, 10
    x64.leaRegSlot rcx, slot0
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.jmp __il_body#8
  __il_body#8:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.leaRegRegImm32 rax, rax, 5
    x64.jmp __il_cont#7
  __il_cont#7:
    x64.movRegImm32 rdx, 1
    x64.jmp __il_body#9
  __il_body#9:
    x64.cmpRegImm32 rdx, 0
    x64.jcc notEqual, yes
    x64.jmp ifcont#11
  yes:
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.cmpRegImm32 rcx, 0
    x64.setccReg greater, rcx
    x64.jmp __il_cont#6
  ifcont#11:
    x64.movRegImm32 rcx, 0
    x64.jmp __il_cont#6
  __il_cont#6:
    x64.jmp __il_body#12
  __il_body#12:
    x64.jmp __il_cont#5
  __il_cont#5:
    x64.jmp __il_body#13
  __il_body#13:
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, on
    x64.jmp ifcont#15
  on:
    x64.movRegImm32 rcx, 1
    x64.jmp __il_cont#4
  ifcont#15:
    x64.movRegImm32 rcx, 0
    x64.jmp __il_cont#4
  __il_cont#4:
    x64.leaRegRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg rbp
