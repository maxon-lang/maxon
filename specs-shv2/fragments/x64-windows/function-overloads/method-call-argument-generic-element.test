// Test: method-call-argument-generic-element
typealias Wide = int(i64.min to i64.max)

type Cell uses T
	export var value as T

	export static function create(value T) returns Self
		return Self{value: value}
	end 'create'

	export function unwrap() returns T
		return self.value
	end 'unwrap'
end 'Cell'

typealias WideCell = Cell with Wide

function over(x String) returns Wide
	return x.count() + 200
end 'over'

function over(x Wide) returns Wide
	return x + 100
end 'over'

function main() returns ExitCode
	let c = WideCell.create(7)
	return over(c.unwrap())
end 'main'
---
ExitCode: 107
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Cell.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Cell.unwrap {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.movRegReg rcx, rdx
    x64.movRegReg rdx, rax
    x64.callDirect __retain_type_param
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @over#Wide {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegRegImm32 r8, rcx, 100
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 7
    x64.callDirect Cell.create
    x64.movRegReg rbx, r8
    x64.leaRegRdata rdx, [rip + __layout_Cell_Wide]
    x64.movRegReg rcx, rbx
    x64.callDirect Cell.unwrap
    x64.movRegReg rcx, r8
    x64.callDirect over#Wide
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_16]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
