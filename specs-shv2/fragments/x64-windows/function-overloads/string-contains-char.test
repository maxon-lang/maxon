// Test: string-contains-char
function main() returns ExitCode
	let text = "hello"
	if text.contains('e') 'check'
		return 1
	end 'check' else 'other'
		return 0
	end 'other'
end 'main'
---
ExitCode: 1
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_1]
    x64.leaRegRdata rdx, [rip + __str_rec_3]
    x64.callDirect String.contains#Character
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, check
    x64.jmp ifelse
  check:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifelse:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
}

func @Character.toString {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect __str_bytes_view
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __str_from_bytes
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @String.contains#Character {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegReg rcx, rdx
    x64.callDirect Character.toString
    x64.movRegReg r12, r8
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.movRegReg rcx, rbx
    x64.movRegReg r9, r12
    x64.callDirect findIn
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, found
    x64.jmp ifelse
  found:
    x64.movRegImm32 rbx, 1
    x64.movRegReg rcx, r12
    x64.callDirect __str_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifelse:
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r12
    x64.callDirect __str_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @bytesEqual {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 56
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.storeSlotReg slot2, rax
    x64.movRegReg r13, r9
    x64.movRegReg r14, rsi
    x64.movRegImm32 r15, 0
    x64.jmp forhdr
  forhdr:
    x64.storeSlotReg slot0, r15
    x64.cmpRegReg r15, r14
    x64.jcc less, compare_loop
    x64.jmp forexit
  compare_loop:
    x64.leaRegRegReg rdx, r12, r15
    x64.movRegReg rcx, rbx
    x64.callDirect __str_byte_at
    x64.storeSlotReg slot1, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_23]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.leaRegRegReg rdx, r13, r15
    x64.loadRegSlot rcx, slot2
    x64.callDirect __str_byte_at
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_24]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.loadRegSlot rax, slot1
    x64.cmpRegReg rax, r8
    x64.jcc notEqual, byte_check
    x64.jmp ifcont
  byte_check:
    x64.movRegImm32 r8, 0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.jmp forstep
  forstep:
    x64.loadRegSlot rax, slot0
    x64.leaRegRegImm32 rax, rax, 1
    x64.movRegReg r15, rax
    x64.jmp forhdr
  forexit:
    x64.movRegImm32 r8, 1
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @findIn {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 56
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegReg r13, rax
    x64.storeSlotReg slot2, r9
    x64.loadRegBaseDisp.word64 r14, [r9 + 8]
    x64.storeSlotReg slot1, r14
    x64.cmpRegImm32 r14, 0
    x64.jcc equal, empty_needle
    x64.jmp ifcont
  empty_needle:
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.cmpRegReg r14, r13
    x64.jcc greater, too_long
    x64.jmp ifcont
  too_long:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 r10, rax, 1
    x64.movRegImm32 r8, 0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, r9
    x64.callDirect __str_byte_at
    x64.movRegReg r15, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_25]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegImm32 rax, 0
    x64.subRegReg r13, r13, r14
    x64.movRegReg r14, rax
    x64.jmp forhdr
  forhdr:
    x64.storeSlotReg slot0, r14
    x64.cmpRegReg r14, r13
    x64.jcc lessEqual, search_loop
    x64.jmp forexit
  search_loop:
    x64.leaRegRegReg rdx, r12, r14
    x64.movRegReg rcx, rbx
    x64.callDirect __str_byte_at
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_26]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.cmpRegReg r8, r15
    x64.jcc equal, firstByteMatch
    x64.jmp ifcont
  firstByteMatch:
    x64.leaRegRegReg rdx, r12, r14
    x64.movRegImm32 r9, 0
    x64.movRegReg rcx, rbx
    x64.loadRegSlot rax, slot2
    x64.loadRegSlot rsi, slot1
    x64.callDirect bytesEqual
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, found_check
    x64.jmp ifcont
  found_check:
    x64.movRegImm32 r10, 0
    x64.loadRegSlot r8, slot0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.jmp ifcont
  ifcont:
    x64.jmp forstep
  forstep:
    x64.loadRegSlot rax, slot0
    x64.leaRegRegImm32 rax, rax, 1
    x64.movRegReg r14, rax
    x64.jmp forhdr
  forexit:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 r10, rax, 1
    x64.movRegImm32 r8, 0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
