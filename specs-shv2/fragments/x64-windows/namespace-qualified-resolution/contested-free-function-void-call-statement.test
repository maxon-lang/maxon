export function shout()
	print("A")
end 'shout'

// --- file: beta/b.maxon
export function shout()
	print("B")
end 'shout'

// --- file: app/main.maxon
function main() returns ExitCode
	alpha.shout()
	beta.shout()
	return 0
end 'main'
