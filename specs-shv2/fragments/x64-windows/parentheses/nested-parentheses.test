// Test: nested-parentheses
function main() returns ExitCode
	return ((5 + 3) * 2) - 6
end 'main'
---
ExitCode: 10
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 5
    x64.leaRegRegImm32 rax, rax, 3
    x64.imulRegRegImm32 rax, rax, 2
    x64.leaRegRegImm32 r8, rax, -6
    x64.popReg rbp
    x64.ret
}
