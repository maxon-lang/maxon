// Test: get-empty-module-level-array
typealias Int = int(i64.min to i64.max)
typealias IntArray = Array with Int
var arr = IntArray.create()

function main() returns ExitCode
	let val = try arr.get(0) otherwise -1
	if val == -1 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __data_arr@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegGlobal rax, __data_arr
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc lessEqual, __im_slow
  __im_load:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.movRegImm32 rsi, 0
    x64.loadRegBaseDisp.word64 rdi, [rcx + 40]
    x64.cmpRegImm32 rdi, 0
    x64.jcc equal, critsplit#10
  __im_empty:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, critsplit#11
  __im_slow:
    x64.callDirect __managed_get
    x64.jmp __im_cont
  critsplit#11:
    x64.movRegReg r8, rax
    x64.movRegReg r10, rsi
    x64.jmp __im_cont
  critsplit#10:
    x64.movRegReg r8, rax
    x64.movRegReg r10, rsi
  __im_cont:
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm rax, 18446744073709551615
    x64.jmp trycont
  tryok:
    x64.movRegReg rax, r8
  trycont:
    x64.cmpRegImm32 rax, -1
    x64.jcc notEqual, ifcont
  check:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
