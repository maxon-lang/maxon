  ifcont:
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#4
    x64.jmp tryok#3
  tryerr#4:
    x64.leaRegRdata r12, [rip + __str_rec_5]
    x64.jmp trycont#5
  tryok#3:
    x64.movRegReg r12, r8
    x64.jmp trycont#5
  trycont#5:
    x64.movRegImm32 rdx, 1
