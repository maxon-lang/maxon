// Test: insert-into-empty
typealias Int = int(i64.min to i64.max)
typealias IntArray = Array with Int

function main() returns ExitCode
	var arr = IntArray.create()

	arr.insert(0, value: 42)

	if arr.count() != 1 'cnt'
		return 1
	end 'cnt'

	let v0 = try arr.get(0) otherwise -1
	if v0 != 42 'c0'
		return 2
	end 'c0'

	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 rax, 42
    x64.leaRegRdata r9, [rip + __layout_Array_Int]
    x64.movRegReg rcx, rbx
    x64.callDirect Array.insert
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_count
    x64.cmpRegImm32 r8, 1
    x64.jcc notEqual, cnt
    x64.jmp ifcont#2
  cnt:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm rax, -1
    x64.jmp trycont
  tryok:
    x64.movRegReg rax, r8
    x64.jmp trycont
  trycont:
    x64.cmpRegImm32 rax, 42
    x64.jcc notEqual, c0
    x64.jmp ifcont#7
  c0:
    x64.movRegImm32 r12, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#7:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @grownCapacity {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegReg rsi, rdx
    x64.leaRegRegReg rax, rcx, rcx
    x64.cmpRegReg rsi, rax
    x64.jcc greater, takeTheAskAsGiven
    x64.jmp ifcont#2
  takeTheAskAsGiven:
    x64.movRegReg rcx, rsi
    x64.callDirect atLeastMinimum
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.cmpRegImm32 rcx, 256
    x64.jcc less, stillSmall
    x64.jmp ifcont#4
  stillSmall:
    x64.movRegReg rcx, rax
    x64.callDirect atLeastMinimum
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegReg r8, rcx
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegReg r8, rsi
    x64.jcc less, ease
    x64.jmp whileexit
  ease:
    x64.movRegImm32 rax, 3
    x64.imulRegRegImm32 rax, rax, 256
    x64.leaRegRegReg rax, r8, rax
    x64.movRegImm32 rcx, 4
    x64.cqo
    x64.idivReg rcx
    x64.leaRegRegReg r8, r8, rax
    x64.jmp whilehdr
  whileexit:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @atLeastMinimum {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 4
    x64.jcc less, raise
    x64.jmp ifcont
  raise:
    x64.movRegImm32 r8, 4
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegReg r8, rcx
    x64.popReg rbp
    x64.ret
}

func @Array.ensureCapacity {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_retain
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r13
    x64.callDirect __managed_capacity
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.cmpRegReg r12, r14
    x64.jcc greater, grow
    x64.jmp ifcont
  grow:
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_retain
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, r14
    x64.movRegReg rdx, r12
    x64.callDirect grownCapacity
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __managed_mem_grow
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.jmp ifcont
  ifcont:
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Array.insert {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegReg r13, rax
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_count
    x64.movRegReg r14, r8
    x64.cmpRegImm32 r12, 0
    x64.jcc less, ternarytrue
    x64.jmp ternaryfalse
  ternarytrue:
    x64.movRegImm32 rax, 0
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegReg rax, r12
    x64.jmp matchcont
  matchcont:
    x64.cmpRegReg rax, r14
    x64.jcc greater, clampHigh
    x64.jmp critsplit
  clampHigh:
    x64.movRegReg r12, r14
    x64.jmp ifcont#5
  critsplit:
    x64.movRegReg r12, rax
    x64.jmp ifcont#5
  ifcont#5:
    x64.leaRegRegImm32 rdx, r14, 1
    x64.movRegReg rcx, rbx
    x64.callDirect Array.ensureCapacity
    x64.cmpRegReg r12, r14
    x64.jcc less, shift
    x64.jmp ifcont#9
  shift:
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_retain
    x64.movRegReg r15, r8
    x64.movRegReg rax, r14
    x64.subRegReg rax, r14, r12
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r12
    x64.callDirect __managed_mem_shift_right
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#8
    x64.jmp tryok#7
  tryerr#8:
    x64.movRegReg rcx, r15
    x64.callDirect __managed_decref
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#7:
    x64.movRegReg rcx, r15
    x64.callDirect __managed_decref
    x64.jmp ifcont#9
  ifcont#9:
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_retain
    x64.movRegReg r15, r8
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r12
    x64.movRegReg rax, r13
    x64.callDirect __managed_mem_set
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#11
    x64.jmp tryok#10
  tryerr#11:
    x64.movRegReg rcx, r15
    x64.callDirect __managed_decref
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#10:
    x64.movRegReg rcx, r15
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_retain
    x64.movRegReg rbx, r8
    x64.leaRegRegImm32 rdx, r14, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_set_length
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#13
    x64.jmp tryok#12
  tryerr#13:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.leaRegRdata rcx, [rip + __str_blob_3]
    x64.callDirect mrt_panic
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#12:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
