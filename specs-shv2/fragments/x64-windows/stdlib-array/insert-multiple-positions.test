func @grownCapacity {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegReg rsi, rdx
    x64.leaRegRegReg rax, rcx, rcx
    x64.cmpRegReg rsi, rax
    x64.jcc greater, takeTheAskAsGiven
    x64.jmp ifcont#2
  takeTheAskAsGiven:
    x64.movRegReg rcx, rsi
    x64.callDirect atLeastMinimum
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.cmpRegImm32 rcx, 256
    x64.jcc less, stillSmall
    x64.jmp ifcont#4
  stillSmall:
    x64.movRegReg rcx, rax
    x64.callDirect atLeastMinimum
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegReg r8, rcx
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegReg r8, rsi
    x64.jcc less, ease
    x64.jmp whileexit
  ease:
    x64.movRegImm32 rax, 3
    x64.imulRegRegImm32 rax, rax, 256
    x64.leaRegRegReg rax, r8, rax
    x64.movRegImm32 rcx, 4
    x64.cqo
    x64.idivReg rcx
    x64.leaRegRegReg r8, r8, rax
    x64.jmp whilehdr
  whileexit:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @atLeastMinimum {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 4
    x64.jcc less, raise
    x64.jmp ifcont
  raise:
    x64.movRegImm32 r8, 4
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegReg r8, rcx
    x64.popReg rbp
    x64.ret
}

func @Array.ensureCapacity {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_retain
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r13
    x64.callDirect __managed_capacity
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.cmpRegReg r12, r14
    x64.jcc greater, grow
