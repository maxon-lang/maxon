// Test: build-sorted-with-inserts
typealias Int = int(i64.min to i64.max)
typealias IntArray = Array with Int

function main() returns ExitCode
	var arr = IntArray.create()

	arr.insert(0, value: 30)
	arr.insert(0, value: 10)
	arr.insert(1, value: 20)
	arr.insert(3, value: 40)

	if arr.count() != 4 'cnt'
		return 1
	end 'cnt'

	let v0 = try arr.get(0) otherwise -1
	let v1 = try arr.get(1) otherwise -1
	let v2 = try arr.get(2) otherwise -1
	let v3 = try arr.get(3) otherwise -1

	if v0 != 10 'c0'
		return 2
	end 'c0'
	if v1 != 20 'c1'
		return 3
	end 'c1'
	if v2 != 30 'c2'
		return 4
	end 'c2'
	if v3 != 40 'c3'
		return 5
	end 'c3'

	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __arr_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 rax, 30
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_insert
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 rax, 10
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_insert
    x64.movRegImm32 rdx, 1
    x64.movRegImm32 rax, 20
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_insert
    x64.movRegImm32 rdx, 3
    x64.movRegImm32 rax, 40
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_insert
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_count
    x64.cmpRegImm32 r8, 4
    x64.jcc notEqual, cnt
    x64.jmp ifcont
  cnt:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 rax, 1
    x64.negReg rax, rax
    x64.movRegReg r12, rax
    x64.jmp trycont
  tryok:
    x64.movRegReg r12, r8
    x64.jmp trycont
  trycont:
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 rax, 1
    x64.negReg rax, rax
    x64.movRegReg r13, rax
    x64.jmp trycont
  tryok:
    x64.movRegReg r13, r8
    x64.jmp trycont
  trycont:
    x64.movRegImm32 rdx, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 rax, 1
    x64.negReg rax, rax
    x64.movRegReg r14, rax
    x64.jmp trycont
  tryok:
    x64.movRegReg r14, r8
    x64.jmp trycont
  trycont:
    x64.movRegImm32 rdx, 3
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 rax, 1
    x64.negReg rax, rax
    x64.jmp trycont
  tryok:
    x64.movRegReg rax, r8
    x64.jmp trycont
  trycont:
    x64.cmpRegImm32 r12, 10
    x64.jcc notEqual, c0
    x64.jmp ifcont
  c0:
    x64.movRegImm32 r12, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.cmpRegImm32 r13, 20
    x64.jcc notEqual, c1
    x64.jmp ifcont
  c1:
    x64.movRegImm32 r12, 3
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.cmpRegImm32 r14, 30
    x64.jcc notEqual, c2
    x64.jmp ifcont
  c2:
    x64.movRegImm32 r12, 4
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.cmpRegImm32 rax, 40
    x64.jcc notEqual, c3
    x64.jmp ifcont
  c3:
    x64.movRegImm32 r12, 5
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
