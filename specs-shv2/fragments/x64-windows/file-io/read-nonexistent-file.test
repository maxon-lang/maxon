    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, r8
    x64.callDirect utf8IsContinuation
    x64.xorRegImm32 r8, r8, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, notContinuation
    x64.jmp ifcont
  notContinuation:
    x64.jmp whileexit
  ifcont:
    x64.leaRegRegImm32 r12, r12, -1
    x64.jmp whilehdr
  critsplit:
    x64.jmp whileexit
  whileexit:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

