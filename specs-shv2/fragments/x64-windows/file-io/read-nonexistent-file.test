// Test: read-nonexistent-file
function main() returns ExitCode
	let content = try File.readText(FilePath from "nonexistent.txt") otherwise 'err'
		print("File not found")
		return 0
	end 'err'
	print("Unexpected: {content}\n")
	return 1
end 'main'
