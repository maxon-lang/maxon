    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegImm32 r12, 0
    x64.jcc greater, back
    x64.jmp critsplit
  back:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect String.byteAt
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
