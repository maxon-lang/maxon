// Test: rhs-is-evaluated-when-lhs-does-not-decide
function t() returns bool
	return true
end 't'

function f() returns bool
	return false
end 'f'

function main() returns ExitCode
	var code = 0
	if t() and f() 'a'
		code = code + 1
	end 'a'
	if t() and t() 'b'
		code = code + 2
	end 'b'
	if f() and t() 'c'
		code = code + 4
	end 'c'
	if f() or f() 'd'
		code = code + 8
	end 'd'
	if f() or t() 'e'
		code = code + 16
	end 'e'
	if t() or f() 'g'
		code = code + 32
	end 'g'
	return code
end 'main'
---
ExitCode: 50
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 0
  __il_body#31:
    x64.movRegImm32 rcx, 0
  scmerge#2:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, __il_body#35
  a:
    x64.movRegImm32 rax, 1
  __il_body#35:
    x64.movRegImm32 rcx, 1
  scmerge#6:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, __il_cont#36
  b:
    x64.leaRegRegImm32 rax, rax, 2
  __il_cont#36:
    x64.movRegImm32 rcx, 0
  scmerge#10:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, __il_body#43
  c:
    x64.leaRegRegImm32 rax, rax, 4
  __il_body#43:
    x64.movRegImm32 rcx, 0
  scmerge#14:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, __il_body#47
  d:
    x64.leaRegRegImm32 rax, rax, 8
  __il_body#47:
    x64.movRegImm32 rcx, 1
  scmerge#18:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, __il_cont#48
  e:
    x64.leaRegRegImm32 rax, rax, 16
  __il_cont#48:
    x64.movRegImm32 rcx, 1
  scmerge#22:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, critsplit
  g:
    x64.leaRegRegImm32 r8, rax, 32
    x64.jmp ifcont
  critsplit:
    x64.movRegReg r8, rax
  ifcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
