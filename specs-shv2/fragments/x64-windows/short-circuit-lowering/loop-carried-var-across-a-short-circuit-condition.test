// Test: loop-carried-var-across-a-short-circuit-condition
function positive(v Integer) returns bool
	return v > 0
end 'positive'

function underLimit(v Integer) returns bool
	return v < 4
end 'underLimit'

function main() returns ExitCode
	var n = 1
	var steps = 0
	while positive(n) and underLimit(n) 'loop'
		n = n + 1
		steps = steps + 1
		if steps > 10 'runaway'
			break
		end 'runaway'
	end 'loop'
	return n * 10 + steps
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 43
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 1
    x64.movRegImm32 rcx, 0
  __il_body#12:
    x64.cmpRegImm32 rax, 0
    x64.setccReg greater, rdx
  __il_cont:
    x64.movRegImm32 rsi, 0
    x64.cmpRegImm32 rdx, 0
    x64.jcc equal, critsplit
  __il_body#14:
    x64.cmpRegImm32 rax, 4
    x64.setccReg less, rdx
    x64.jmp scmerge
  critsplit:
    x64.movRegReg rdx, rsi
  scmerge:
    x64.cmpRegImm32 rdx, 0
    x64.jcc equal, whileexit
  loop:
    x64.leaRegRegImm32 rax, rax, 1
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.cmpRegImm32 rcx, 10
    x64.jcc lessEqual, __il_body#12
  whileexit:
    x64.imulRegRegImm32 rax, rax, 10
    x64.leaRegRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
