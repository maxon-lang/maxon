// Test: nested-in-the-right-operand
function t() returns bool
	return true
end 't'

function f() returns bool
	return false
end 'f'

function main() returns ExitCode
	var code = 0
	if f() or (t() and t()) 'a'
		code = code + 1
	end 'a'
	if t() and (f() or t()) 'b'
		code = code + 2
	end 'b'
	if f() or (t() and f()) 'c'
		code = code + 4
	end 'c'
	return code
end 'main'
