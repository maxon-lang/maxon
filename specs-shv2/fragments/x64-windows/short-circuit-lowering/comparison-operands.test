// Test: comparison-operands
function main() returns ExitCode
	let x = 4
	let y = 0
	var code = 0
	if x > 0 and y > 0 'both'
		code = code + 1
	end 'both'
	if x > 0 or y > 0 'either'
		code = code + 2
	end 'either'
	if x > 0 and y == 0 'mixed'
		code = code + 4
	end 'mixed'
	return code
end 'main'
---
ExitCode: 6
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 0
  andrhs#1:
    x64.movRegImm32 rcx, 0
  scmerge#2:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, ifcont#4
  both:
    x64.movRegImm32 rax, 1
  ifcont#4:
    x64.movRegImm32 rcx, 1
  scmerge#6:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, andrhs#9
  either:
    x64.leaRegRegImm32 rax, rax, 2
  andrhs#9:
    x64.movRegImm32 rcx, 1
  scmerge#10:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, critsplit
  mixed:
    x64.leaRegRegImm32 r8, rax, 4
    x64.jmp ifcont#12
  critsplit:
    x64.movRegReg r8, rax
  ifcont#12:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at comparison-operands.test:15: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
