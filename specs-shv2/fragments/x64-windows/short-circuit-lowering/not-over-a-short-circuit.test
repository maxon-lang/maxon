// Test: not-over-a-short-circuit
function t() returns bool
	return true
end 't'

function f() returns bool
	return false
end 'f'

function main() returns ExitCode
	var code = 0
	if not (f() or f()) 'a'
		code = code + 1
	end 'a'
	if not (t() and t()) 'b'
		code = code + 2
	end 'b'
	if not (t() and f()) 'c'
		code = code + 4
	end 'c'
	return code
end 'main'
