// Test: not-over-a-short-circuit
function t() returns bool
	return true
end 't'

function f() returns bool
	return false
end 'f'

function main() returns ExitCode
	var code = 0
	if not (f() or f()) 'a'
		code = code + 1
	end 'a'
	if not (t() and t()) 'b'
		code = code + 2
	end 'b'
	if not (t() and f()) 'c'
		code = code + 4
	end 'c'
	return code
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 0
  __il_body#19:
    x64.movRegImm32 rcx, 0
  scmerge#2:
    x64.xorRegImm32 rcx, rcx, 1
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, __il_body#23
  a:
    x64.movRegImm32 rax, 1
  __il_body#23:
    x64.movRegImm32 rcx, 1
  scmerge#6:
    x64.xorRegImm32 rcx, rcx, 1
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, __il_body#27
  b:
    x64.leaRegRegImm32 rax, rax, 2
  __il_body#27:
    x64.movRegImm32 rcx, 0
  scmerge#10:
    x64.xorRegImm32 rcx, rcx, 1
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, critsplit
  c:
    x64.leaRegRegImm32 r8, rax, 4
    x64.jmp ifcont
  critsplit:
    x64.movRegReg r8, rax
  ifcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
