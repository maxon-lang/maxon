// Test: in-a-return-value
function t() returns bool
	return true
end 't'

function f() returns bool
	return false
end 'f'

function bothTrue() returns bool
	return t() and t()
end 'bothTrue'

function eitherTrue() returns bool
	return f() or t()
end 'eitherTrue'

function main() returns ExitCode
	var code = 0
	if bothTrue() 'a'
		code = code + 1
	end 'a'
	if eitherTrue() 'b'
		code = code + 2
	end 'b'
	return code
end 'main'
---
ExitCode: 3
---
func @bothTrue {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body#4:
    x64.movRegImm32 rax, 1
  __il_cont:
    x64.movRegImm32 r8, 0
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, scmerge
  __il_body#6:
    x64.movRegImm32 r8, 1
  scmerge:
    x64.popReg rbp
    x64.ret
}

func @eitherTrue {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body#4:
    x64.movRegImm32 rax, 0
  __il_cont:
    x64.movRegImm32 r8, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, scmerge
  __il_body#6:
    x64.movRegImm32 r8, 1
  scmerge:
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.callDirect bothTrue
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#2
  a:
    x64.leaRegRegImm32 rbx, rbx, 1
  ifcont#2:
    x64.callDirect eitherTrue
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, critsplit
  b:
    x64.leaRegRegImm32 r8, rbx, 2
    x64.jmp ifcont#4
  critsplit:
    x64.movRegReg r8, rbx
  ifcont#4:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
