// Test: where-clauses.constraint-interface-generic-alias-formal
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

interface Summer
	function total(xs IntArray) returns Integer
end 'Summer'

type Adder implements Summer
	export var base as Integer
	export static function create(base Integer) returns Self
		return Self{ base: base }
	end 'create'
	export function total(xs IntArray) returns Integer
		var sum = self.base
		for x in xs 'each'
			sum = sum + x
		end 'each'
		return sum
	end 'total'
end 'Adder'

type Box uses T where T is Summer
	export var item as T
	export static function create(item T) returns Self
		return Self{ item: item }
	end 'create'
	export function run(xs IntArray) returns Integer
		return self.item.total(xs)
	end 'run'
end 'Box'

typealias AdderBox = Box with Adder

function main() returns ExitCode
	var xs = IntArray.create()
	xs.push(10)
	xs.push(30)
	let b = AdderBox.create(Adder.create(2))
	return b.run(xs)
end 'main'
---
ExitCode: 42
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Adder.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Adder.total {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rbx, [rcx + 0]
    x64.movRegReg rcx, rdx
    x64.callDirect Array.createIterator
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, critsplit
    x64.jmp forempty
  critsplit:
    x64.jmp forhdr
  forhdr:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, each
    x64.jmp forexit
  each:
    x64.leaRegRdata rdx, [rip + __layout_ArrayIterator_Integer]
    x64.movRegReg rcx, r12
    x64.callDirect ArrayIterator.current
    x64.leaRegRegReg rbx, rbx, r8
    x64.jmp forstep
  forstep:
    x64.movRegReg rcx, r12
    x64.callDirect ArrayIterator.advance
    x64.movRegReg rax, r10
    x64.jmp forhdr
  forexit:
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_ArrayIterator_Integer
    x64.movRegReg r8, rbx
    x64.jmp forjoin
  forempty:
    x64.movRegReg r8, rbx
    x64.jmp forjoin
  forjoin:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Box.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Box.run {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rax
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callMem [rbx + 24]
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 10
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 30
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rcx, 2
    x64.callDirect Adder.create
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.callDirect __mm_incref
    x64.leaRegRdata rdx, [rip + __witness_Adder.Summer]
    x64.movRegReg rcx, r12
    x64.callDirect Box.create
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.leaRegRdata rax, [rip + __witness_Adder.Summer]
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, rbx
    x64.callDirect Box.run
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_Box_Adder
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Array.createIterator {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.callDirect __mm_retain
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect ArrayIterator.create
    x64.movRegReg r12, r8
    x64.movRegReg r13, r10
    x64.cmpRegImm32 r13, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegImm32 r8, 0
    x64.movRegReg r10, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegImm32 r10, 0
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @ArrayIterator.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect __managed_cursor_create
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 r10, rax, 1
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_cursor_decref
    x64.movRegImm32 r10, 0
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

