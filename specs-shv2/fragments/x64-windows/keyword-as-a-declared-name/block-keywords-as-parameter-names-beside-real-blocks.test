// Test: block-keywords-as-parameter-names-beside-real-blocks
typealias Integer = int(i64.min to i64.max)

function weigh(while Integer, for Integer, match Integer, from Integer, to Integer) returns Integer
	var acc = 0
	var k = 0
	while k < 3 'spin'
		acc = acc + from
		k = k + 1
	end 'spin'

	if acc > 2 'over'
		acc = acc + to
	end 'over'

	return acc
end 'weigh'

function main() returns ExitCode
	var total = 0
	for i in 1 upto 4 'walk'
		total = total + weigh(i, for: 3, match: 4, from: 2, to: 8)
	end 'walk'
	return total
end 'main'
---
ExitCode: 42
---
func @weigh {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 0
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegImm32 rcx, 3
    x64.jcc less, spin
    x64.jmp whileexit
  spin:
    x64.leaRegRegReg rax, rax, r9
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.jmp whilehdr
  whileexit:
    x64.cmpRegImm32 rax, 2
    x64.jcc greater, over
    x64.jmp critsplit
  over:
    x64.leaRegRegReg r8, rax, rsi
    x64.jmp ifcont
  critsplit:
    x64.movRegReg r8, rax
    x64.jmp ifcont
  ifcont:
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 r12, 1
    x64.jmp forhdr
  forhdr:
    x64.cmpRegImm32 r12, 4
    x64.jcc less, walk
    x64.jmp forexit
  walk:
    x64.movRegImm32 rdx, 3
    x64.movRegImm32 rax, 4
    x64.movRegImm32 r9, 2
    x64.movRegImm32 rsi, 8
    x64.movRegReg rcx, r12
    x64.callDirect weigh
    x64.leaRegRegReg rbx, rbx, r8
    x64.jmp forstep
  forstep:
    x64.leaRegRegImm32 r12, r12, 1
    x64.jmp forhdr
  forexit:
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
