// Test: a-keyword-named-METHOD-CALL-ending-a-block-HEADER
typealias Integer = int(i64.min to i64.max)

type Ops
	export static function otherwise(n Integer) returns bool
		return n < 3
	end 'otherwise'
end 'Ops'

function main() returns ExitCode
	var i = 0
	while Ops.otherwise(i) 'loop'
		i = i + 1
	end 'loop'

	if Ops.otherwise(i) 'lbl'
		i = 99
	end 'lbl'

	return (i * 14) as ExitCode
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 0
    x64.jmp whilehdr
  whilehdr:
    x64.jmp __il_body#10
  __il_body#10:
    x64.cmpRegImm32 rax, 3
    x64.setccReg less, rcx
    x64.jmp __il_cont#9
  __il_cont#9:
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, loop
    x64.jmp whileexit
  loop:
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp whilehdr
  whileexit:
    x64.jmp __il_body#12
  __il_body#12:
    x64.cmpRegImm32 rax, 3
    x64.setccReg less, rcx
    x64.jmp __il_cont#11
  __il_cont#11:
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, lbl
    x64.jmp critsplit
  lbl:
    x64.movRegImm32 rax, 99
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.imulRegRegImm32 r8, rax, 14
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
