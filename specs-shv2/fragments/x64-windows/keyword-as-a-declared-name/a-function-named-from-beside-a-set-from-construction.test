// Test: a-function-named-from-beside-a-set-from-construction
typealias Integer = int(i64.min to i64.max)

function from(n Integer) returns Integer
	return n * 7
end 'from'

function main() returns ExitCode
	let s = Set from [10, 20, 30, 40, 50, 60]
	return from(s.count())
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
