// Test: a-keyword-named-parameter-AS-THE-FIRST-TOKEN-OF-A-CONDITION
typealias Integer = int(i64.min to i64.max)

function twosComplementDistance(to Integer, from Integer) returns Integer
	if to >= from 'forward'
		return to - from
	end 'forward'

	return (from - to) * -1
end 'twosComplementDistance'

function span(to Integer, from Integer) returns Integer
	var acc = 0
	var k = from
	while to > k 'spin'
		acc = acc + 1
		k = k + 1
	end 'spin'

	return acc
end 'span'

function weight(to Integer) returns Integer
	return match to 'pick'
		1 gives 100
		2 gives 4
		default gives 0
	end 'pick'
end 'weight'

function main() returns ExitCode
	return (twosComplementDistance(50, from: 8) + span(4, from: 1) + weight(2)) as ExitCode
end 'main'
---
ExitCode: 49
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 50
    x64.movRegImm32 rcx, 8
  __il_body#7:
    x64.cmpRegImm32 rax, 8
    x64.jcc less, ifcont
  forward:
    x64.leaRegRegImm32 rax, rax, -8
    x64.jmp __il_cont#6
  ifcont:
    x64.leaRegRegImm32 rax, rcx, -50
    x64.imulRegRegImm32 rax, rax, -1
  __il_cont#6:
    x64.movRegImm32 rcx, 1
  __il_body#10:
    x64.movRegImm32 rdx, 0
  whilehdr:
    x64.cmpRegImm32 rcx, 4
    x64.jcc greaterEqual, __il_cont#5
  spin:
    x64.leaRegRegImm32 rdx, rdx, 1
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.jmp whilehdr
  __il_cont#5:
    x64.leaRegRegReg rax, rax, rdx
    x64.movRegImm32 rcx, 2
  __il_body#14:
    x64.cmpRegImm32 rcx, 1
    x64.jcc notEqual, matchnext
  matcharm#15:
    x64.movRegImm32 rcx, 100
    x64.jmp __il_cont#4
  matchnext:
    x64.cmpRegImm32 rcx, 2
    x64.jcc notEqual, matchdefault
  matcharm#16:
    x64.movRegImm32 rcx, 4
    x64.jmp __il_cont#4
  matchdefault:
    x64.movRegImm32 rcx, 0
  __il_cont#4:
    x64.leaRegRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
