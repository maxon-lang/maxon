// Test: a-library-body-named-into-the-golden
function main() returns ExitCode
	let s = "  abc  "
	return s.trim().byteLength() as ExitCode
end 'main'
---
ExitCode: 3
---
data {
  __data_CharacterSet.cachedWhitespacesAndNewlines@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_8]
    x64.callDirect String.trim#
    x64.movRegReg rbx, r8
  __il_body:
    x64.loadRegBaseDisp.word64 r12, [rbx + 8]
    x64.cmpRegImm32 r12, 0
    x64.jcc greaterEqual, __il_cont
  __il_slow:
    x64.movRegReg rcx, rbx
    x64.callDirect String.byteLength
    x64.movRegReg r12, r8
  __il_cont:
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_51]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @String.trim {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
  __il_body:
    x64.loadRegBaseDisp.word64 r13, [rbx + 8]
    x64.cmpRegImm32 r13, 0
    x64.jcc greaterEqual, __il_cont
  __il_slow:
    x64.movRegReg rcx, rbx
    x64.callDirect String.byteLength
    x64.movRegReg r13, r8
  __il_cont:
    x64.cmpRegImm32 r13, 0
    x64.jcc notEqual, ifcont#2
  empty:
    x64.movRegReg rcx, rbx
    x64.callDirect String.clone
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect String.scanTrimStart
    x64.movRegReg r14, r8
    x64.cmpRegReg r14, r13
    x64.jcc less, ifcont#4
  allMatch:
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 rax, 0
    x64.movRegImm32 r9, 1
    x64.movRegReg rcx, rbx
    x64.callDirect String.sliceBytes
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.movRegReg rax, r13
    x64.movRegReg r9, r14
    x64.callDirect String.scanTrimEnd
    x64.loadRegBaseDisp.byte r9, [rbx + 48]
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r14
    x64.movRegReg rax, r8
    x64.callDirect String.sliceBytes
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
