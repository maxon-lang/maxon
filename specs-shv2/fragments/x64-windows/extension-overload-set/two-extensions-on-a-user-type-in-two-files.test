// Test: two-extensions-on-a-user-type-in-two-files
// --- file: a.maxon
typealias Integer = int(i64.min to i64.max)

export type Box
	export var v as Integer

	export static function of(v Integer) returns Self
		return Self{v: v}
	end 'of'
end 'Box'

export extension Box
	export function widen(n Integer) returns Integer
		return self.v * n
	end 'widen'
end 'Box'

// --- file: b.maxon
typealias Amount = int(i64.min to i64.max)

export extension Box
	export function widen(flag bool) returns Amount
		return self.v + (1 if flag else 0)
	end 'widen'
end 'Box'

function main() returns ExitCode
	let b = Box.of(10)
	return b.widen(4) + b.widen(true)
end 'main'
---
ExitCode: 51
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Box.widen#Integer {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 r8, [rcx + 0]
    x64.imulRegReg r8, r8, rdx
    x64.popReg rbp
    x64.ret
}

func @Box.widen#bool {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.cmpRegImm32 rdx, 0
    x64.jcc notEqual, ternarytrue
    x64.jmp ternaryfalse
  ternarytrue:
    x64.movRegImm32 rcx, 1
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegImm32 rcx, 0
    x64.jmp matchcont
  matchcont:
    x64.leaRegRegReg r8, rax, rcx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 48
    x64.movRegImm32 rax, 10
    x64.leaRegSlot rbx, slot0
    x64.storeBaseDispReg.word64 [rbx + 0], rax
    x64.movRegImm32 rdx, 4
    x64.movRegReg rcx, rbx
    x64.callDirect Box.widen#Integer
    x64.movRegReg r12, r8
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, rbx
    x64.callDirect Box.widen#bool
    x64.leaRegRegReg r8, r12, r8
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 48
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
