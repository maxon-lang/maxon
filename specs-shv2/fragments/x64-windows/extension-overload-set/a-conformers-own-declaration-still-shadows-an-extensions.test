// Test: a-conformers-own-declaration-still-shadows-an-extensions
typealias Integer = int(i64.min to i64.max)

interface Holder
	function only() returns Integer
end 'Holder'

extension Holder
	export function has() returns Integer
		return 1
	end 'has'
end 'Holder'

type Bag implements Holder
	export static function make() returns Self
		return Self{}
	end 'make'

	export function only() returns Integer
		return 3
	end 'only'

	export function has() returns Integer
		return 40
	end 'has'
end 'Bag'

function main() returns ExitCode
	let b = Bag.make()
	return b.has() + b.only()
end 'main'
---
ExitCode: 43
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Bag.make {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.callDirect Bag.make
  __il_body:
    x64.movRegImm32 rax, 40
  __il_cont:
    x64.leaRegRegImm32 rbx, rax, 3
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
