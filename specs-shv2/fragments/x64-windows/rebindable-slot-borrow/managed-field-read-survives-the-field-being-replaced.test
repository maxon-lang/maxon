// Test: managed-field-read-survives-the-field-being-replaced
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

type Holder
	var items as IntArray

	export static function create() returns Self
		return Self{items: IntArray.create()}
	end 'create'

	export function fill(n Integer)
		for i in 0 upto n 'each'
			items.push(i)
		end 'each'
	end 'fill'

	export function swapAndRead() returns Integer
		let old = items
		var fresh = IntArray.create()
		fresh.push(99)
		items = fresh

		var sum = 0
		for i in 0 upto old.count() 'walk'
			sum = sum + (try old.get(i) otherwise 0)
		end 'walk'
		return sum
	end 'swapAndRead'
end 'Holder'

function main() returns ExitCode
	var h = Holder.create()
	h.fill(5)
	return h.swapAndRead() as ExitCode
end 'main'
---
ExitCode: 10
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Holder.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Holder.fill {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegImm32 r13, 0
    x64.jmp forhdr
  forhdr:
    x64.cmpRegReg r13, r12
    x64.jcc less, each
    x64.jmp forexit
  each:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.movRegReg rdx, r13
    x64.callDirect __managed_push
    x64.jmp forstep
  forstep:
    x64.leaRegRegImm32 r13, r13, 1
    x64.jmp forhdr
  forexit:
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Holder.swapAndRead {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.callDirect __mm_retain
    x64.movRegReg r12, r8
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r13, r8
    x64.movRegImm32 rdx, 99
    x64.movRegReg rcx, r13
    x64.callDirect __managed_push
    x64.loadRegBaseDisp.word64 r14, [rbx + 0]
    x64.movRegReg rcx, r13
    x64.callDirect __mm_incref
    x64.movRegReg rcx, r14
    x64.callDirect __managed_decref
    x64.storeBaseDispReg.word64 [rbx + 0], r13
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 r14, 0
    x64.loadRegBaseDisp.word64 r15, [r12 + 8]
    x64.jmp forhdr
  forhdr:
    x64.cmpRegReg r14, r15
    x64.jcc less, walk
    x64.jmp forexit
  walk:
    x64.loadRegBaseDisp.word64 rax, [r12 + 24]
    x64.cmpRegImm32 rax, 8
    x64.jcc equal, __im_word
    x64.jmp __im_stride
  __im_word:
    x64.loadRegBaseDisp.word64 rax, [r12 + 8]
    x64.cmpRegImm32 r14, 0
    x64.setccReg less, rcx
    x64.cmpRegReg r14, rax
    x64.setccReg greaterEqual, rax
    x64.orRegReg rcx, rcx, rax
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, __im_slow
    x64.jmp __im_load#14
  __im_load#14:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.imulRegRegImm32 rcx, r14, 8
    x64.leaRegRegReg rax, rax, rcx
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.jmp __im_loaded
  __im_stride:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, __im_byte
    x64.jmp __im_slow
  __im_byte:
    x64.loadRegBaseDisp.word64 rax, [r12 + 8]
    x64.cmpRegImm32 r14, 0
    x64.setccReg less, rcx
    x64.cmpRegReg r14, rax
    x64.setccReg greaterEqual, rax
    x64.orRegReg rcx, rcx, rax
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, __im_slow
    x64.jmp __im_load#15
  __im_load#15:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.leaRegRegReg rax, rax, r14
    x64.loadRegBaseDisp.byte rax, [rax + 0]
    x64.jmp __im_loaded
  __im_loaded:
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rdx, [r12 + 40]
    x64.cmpRegImm32 rdx, 0
    x64.jcc notEqual, __im_empty
    x64.jmp critsplit#17
  __im_empty:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __im_slow
    x64.jmp critsplit#18
  critsplit#18:
    x64.jmp __im_cont
  critsplit#17:
    x64.jmp __im_cont
  __im_slow:
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r14
    x64.callDirect __managed_get
    x64.movRegReg rax, r8
    x64.movRegReg rcx, r10
    x64.jmp __im_cont
  __im_cont:
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 rax, 0
    x64.jmp trycont
  tryok:
    x64.jmp trycont
  trycont:
    x64.leaRegRegReg rbx, rbx, rax
    x64.jmp forstep
  forstep:
    x64.leaRegRegImm32 r14, r14, 1
    x64.jmp forhdr
  forexit:
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect Holder.create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 5
    x64.movRegReg rcx, rbx
    x64.callDirect Holder.fill
    x64.movRegReg rcx, rbx
    x64.callDirect Holder.swapAndRead
    x64.movRegReg r12, r8
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Holder
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
