// Test: an-immutable-field-is-not-promoted
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

type Frozen
	let items as IntArray

	export static function create() returns Self
		var a = IntArray.create()
		a.push(4)
		a.push(5)
		return Self{items: a}
	end 'create'

	export function total() returns Integer
		let held = items

		var sum = 0
		for i in 0 upto held.count() 'walk'
			sum = sum + (try held.get(i) otherwise 0)
		end 'walk'
		return sum
	end 'total'
end 'Frozen'

function main() returns ExitCode
	var f = Frozen.create()
	return f.total() as ExitCode
end 'main'
---
ExitCode: 9
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Frozen.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 4
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 5
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Frozen.total {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rbx, [rcx + 0]
    x64.movRegImm32 r12, 0
    x64.movRegImm32 r13, 0
    x64.loadRegBaseDisp.word64 r14, [rbx + 8]
  forhdr:
    x64.cmpRegReg r13, r14
    x64.jcc greaterEqual, forexit
  walk:
    x64.loadRegBaseDisp.word64 rax, [rbx + 24]
    x64.cmpRegImm32 rax, 8
    x64.jcc notEqual, __im_stride
  __im_word:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 r13, 0
    x64.setccReg less, rcx
    x64.cmpRegReg r13, rax
    x64.setccReg greaterEqual, rax
    x64.orRegReg rcx, rcx, rax
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, __il_slow
  __im_load#14:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseIndexScale.word64 rax, [rax + r13*8 + 0]
    x64.jmp __im_loaded
  __im_stride:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, __il_slow
  __im_byte:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 r13, 0
    x64.setccReg less, rcx
    x64.cmpRegReg r13, rax
    x64.setccReg greaterEqual, rax
    x64.orRegReg rcx, rcx, rax
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, __il_slow
  __im_load#15:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.leaRegRegReg rax, rax, r13
    x64.loadRegBaseDisp.byte rax, [rax + 0]
  __im_loaded:
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rdx, [rbx + 40]
    x64.cmpRegImm32 rdx, 0
    x64.jcc equal, __il_cont
  __im_empty:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, __il_cont
  __il_slow:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect __managed_get
    x64.movRegReg rax, r8
    x64.movRegReg rcx, r10
  __il_cont:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, trycont
  tryerr:
    x64.movRegImm32 rax, 0
  trycont:
    x64.leaRegRegReg r12, r12, rax
  forstep:
    x64.leaRegRegImm32 r13, r13, 1
    x64.jmp forhdr
  forexit:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect Frozen.create
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect Frozen.total
    x64.movRegReg r12, r8
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Frozen
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
