// Test: async-promise-drop.never-ran-drop-not-run
var flag = 0

function incFlag() returns int
	flag = 1
	return 1
end 'incFlag'

function main() returns ExitCode
	let p = async incFlag()
	return flag as ExitCode
end 'main'
---
ExitCode: 0
---
data {
  __data_flag@0 = i64 0
  __slab_cursor@8 = i64 0
  __slab_end@16 = i64 0
  __mm_alloc_count@24 = i64 0
  __gt_current_gt@32 = i64 0
  __gt_run_queue_head@40 = i64 0
  __gt_run_queue_tail@48 = i64 0
  __gt_init_done@56 = i64 0
  __gt_system_stack_top@64 = i64 0
  __gt_timer_count@72 = i64 0
  __gt_timer_heap_base@80 = i64 0
  __gt_clock_ticks@88 = i64 0
  __gt_clock_freq@96 = i64 0
  __gt_proc_count@104 = i64 0
  __gt_proc_handles_base@112 = i64 0
  __gt_proc_gts_base@120 = i64 0
  __gt_free_list_head@128 = i64 0
  __gt_live_count@136 = i64 0
  __gt_startup_base@144 = i64 0
  __gt_procinfo_base@152 = i64 0
  __gt_exitcode_base@160 = i64 0
  __gt_cmdline_buf_base@168 = i64 0
  __gt_cmdline_buf_cap@176 = i64 0
}

func @incFlag {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 1
    x64.leaRegGlobal rcx, __data_flag
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.leaRegFunc rcx, [rip + incFlag]
    x64.callDirect __gt_spawn
    x64.leaRegGlobal rax, __data_flag
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
    x64.movRegReg rcx, r8
    x64.callDirect __gt_promise_drop
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
