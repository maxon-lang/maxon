    x64.movRegReg rcx, r14
    x64.callDirect __gt_ready
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegReg r12, rax
    x64.jcc greaterEqual, ifelse
  reuse:
    x64.loadRegBaseDisp.word64 rax, [rbx + 40]
