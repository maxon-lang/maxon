// Test: async-promise-drop.await-then-reassign-nonpromise
function nine() returns int
	Runtime.yield()
	return 9
end 'nine'

function main() returns ExitCode
	var p = async nine()
	let r = await p
	print("{r}")
	p = 5
	return p as ExitCode
end 'main'
---
ExitCode: 5
---
