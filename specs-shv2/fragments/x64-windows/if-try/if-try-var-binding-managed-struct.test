// Test: if-try-var-binding-managed-struct

enum MyError implements Error
	failed
end 'MyError'

function makeGreeting(succeed bool) returns String throws MyError
	if not succeed 'check'
		throw MyError.failed
	end 'check'
	return "hello"
end 'makeGreeting'

function main() returns ExitCode
	if var s = try makeGreeting(true) 'check'
		s.append(" world")
		return s.bytes().count()
	end 'check'
	return 0
end 'main'
---
ExitCode: 11
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @makeGreeting {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.xorRegImm32 rcx, rcx, 1
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, check
    x64.jmp ifcont
  check:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 r10, rax, 1
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.leaRegRdata rcx, [rip + __str_rec_2]
    x64.callDirect __str_retain
    x64.movRegImm32 r10, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

