// Test: greater-than
function main() returns ExitCode
	if 5 > 3 'check'
		return 42
	end 'check'
	return 0
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.movRegImm32 rax, 5
    x64.movRegImm32 rcx, 3
    x64.cmpRegReg rax, rcx
    x64.jcc greater, check
    x64.jmp ifcont
  check:
    x64.movRegImm32 rdx, 42
    x64.movRegReg r8, rdx
    x64.ret
  ifcont:
    x64.movRegImm32 r9, 0
    x64.movRegReg r8, r9
    x64.ret
}
