// Test: false-direction-and-boundary
function main() returns ExitCode
	let x = 5
	var r = 0
	if x == 6 'eqFalse'
		r = r + 1
	end 'eqFalse'
	if x != 5 'neFalse'
		r = r + 2
	end 'neFalse'
	if x > 5 'gtBoundary'
		r = r + 4
	end 'gtBoundary'
	if x <= 5 'leBoundary'
		r = r + 8
	end 'leBoundary'
	if x >= 5 'geBoundary'
		r = r + 16
	end 'geBoundary'
	if x < 5 'ltFalse'
		r = r + 32
	end 'ltFalse'
	return r
end 'main'
---
ExitCode: 24
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 5
    x64.movRegImm32 rcx, 0
    x64.cmpRegImm32 rax, 6
    x64.jcc notEqual, ifcont#2
  eqFalse:
    x64.leaRegRegImm32 rcx, rcx, 1
  ifcont#2:
    x64.cmpRegImm32 rax, 5
    x64.jcc equal, ifcont#4
  neFalse:
    x64.leaRegRegImm32 rcx, rcx, 2
  ifcont#4:
    x64.cmpRegImm32 rax, 5
    x64.jcc lessEqual, ifcont#6
  gtBoundary:
    x64.leaRegRegImm32 rcx, rcx, 4
  ifcont#6:
    x64.cmpRegImm32 rax, 5
    x64.jcc greater, ifcont#8
  leBoundary:
    x64.leaRegRegImm32 rcx, rcx, 8
  ifcont#8:
    x64.cmpRegImm32 rax, 5
    x64.jcc less, ifcont#10
  geBoundary:
    x64.leaRegRegImm32 rcx, rcx, 16
  ifcont#10:
    x64.cmpRegImm32 rax, 5
    x64.jcc greaterEqual, critsplit
  ltFalse:
    x64.leaRegRegImm32 r8, rcx, 32
    x64.jmp ifcont#12
  critsplit:
    x64.movRegReg r8, rcx
  ifcont#12:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
