// Test: equality
function main() returns ExitCode
	let x = 42
	if x == 42 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.movRegImm32 rax, 42
    x64.movRegImm32 rcx, 42
    x64.cmpRegReg rax, rcx
    x64.jcc equal, check
    x64.jmp ifcont
  check:
    x64.movRegImm32 r8, 1
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.ret
}
