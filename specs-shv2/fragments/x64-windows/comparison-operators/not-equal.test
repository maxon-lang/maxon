// Test: not-equal
function main() returns ExitCode
	let x = 10
	if x != 20 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.movRegImm32 rax, 10
    x64.movRegImm32 rcx, 20
    x64.cmpRegReg rax, rcx
    x64.jcc notEqual, check
    x64.jmp ifcont
  check:
    x64.movRegImm32 rdx, 1
    x64.movRegReg r8, rdx
    x64.ret
  ifcont:
    x64.movRegImm32 r9, 0
    x64.movRegReg r8, r9
    x64.ret
}
