// Test: a-negative-sentinel-in-a-non-negative-type-still-decodes
typealias Slot = int(0 to u64.max)

function findSlot(key Slot) returns Slot
	if key == 7 'found'
		return 3 as Slot
	end 'found'
	return 0 - 1
end 'findSlot'

function main() returns ExitCode
	let slot = findSlot(9 as Slot)

	if slot >= 0 'wronglyFound'
		return 1
	end 'wronglyFound'
	return 42
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 9
    x64.jmp __il_body
  __il_body:
    x64.cmpRegImm32 rax, 7
    x64.jcc equal, found
    x64.jmp ifcont#6
  found:
    x64.movRegImm32 rax, 3
    x64.jmp __il_cont
  ifcont#6:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 rax, rax, -1
    x64.jmp __il_cont
  __il_cont:
    x64.cmpRegImm32 rax, 0
    x64.jcc greaterEqual, wronglyFound
    x64.jmp ifcont#2
  wronglyFound:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
}
