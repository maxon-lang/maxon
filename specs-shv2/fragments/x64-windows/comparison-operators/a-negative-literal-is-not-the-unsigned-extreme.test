// Test: a-negative-literal-is-not-the-unsigned-extreme
typealias Wide = int(0 to u64.max)

function wide(n Wide) returns Wide
	return n
end 'wide'

function main() returns ExitCode
	let three = wide(3 as Wide)

	if three > 0 - 1 'aboveNegativeOne'
		return 42
	end 'aboveNegativeOne'
	return 1
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 3
    x64.jmp __il_body
  __il_body:
    x64.jmp __il_cont
  __il_cont:
    x64.movRegImm32 rcx, 0
    x64.leaRegRegImm32 rcx, rcx, -1
    x64.cmpRegReg rax, rcx
    x64.jcc greater, aboveNegativeOne
    x64.jmp ifcont
  aboveNegativeOne:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}
