// Test: match-range.exclusive-boundary
function main() returns ExitCode
	let x = 5
	match x 'check'
		1 upto 5 then return 1
		default then return 0
	end 'check'
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matchdefault:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
