// Test: match-range.character-lowercase
function main() returns ExitCode
	let c = 'm'
	match c 'classify'
		'a' to 'z' then return 1
		'A' to 'Z' then return 2
		default then return 0
	end 'classify'
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.leaRegRdata rbx, [rip + __str_rec_5]
    x64.leaRegRdata rdx, [rip + __str_rec_6]
    x64.leaRegRdata r12, [rip + __str_rec_7]
    x64.movRegReg rcx, rbx
    x64.callDirect __char_cmp
    x64.cmpRegImm32 r8, 0
    x64.setccReg notEqual, r13
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __char_cmp
    x64.cmpRegImm32 r8, 2
    x64.setccReg notEqual, rax
    x64.andRegReg r13, r13, rax
    x64.cmpRegImm32 r13, 0
    x64.jcc notEqual, matcharm#1
    x64.jmp matchnext#2
  matcharm#1:
    x64.movRegImm32 r8, 1
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchnext#2:
    x64.leaRegRdata rdx, [rip + __str_rec_8]
    x64.leaRegRdata r12, [rip + __str_rec_9]
    x64.movRegReg rcx, rbx
    x64.callDirect __char_cmp
    x64.cmpRegImm32 r8, 0
    x64.setccReg notEqual, r13
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __char_cmp
    x64.cmpRegImm32 r8, 2
    x64.setccReg notEqual, rax
    x64.andRegReg r13, r13, rax
    x64.cmpRegImm32 r13, 0
    x64.jcc notEqual, matcharm#3
    x64.jmp matchnext#4
  matcharm#3:
    x64.movRegImm32 r8, 2
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchnext#4:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchcont:
}
