// Test: match-range.multiple-ranges
function main() returns ExitCode
	let score = 85
	match score 'grade'
		90 to 100 then return 65
		80 upto 90 then return 66
		70 upto 80 then return 67
		default then return 70
	end 'grade'
end 'main'
---
ExitCode: 66
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 85
    x64.cmpRegImm32 rax, 70
    x64.setccReg greaterEqual, rcx
    x64.cmpRegImm32 rax, 79
    x64.setccReg lessEqual, rdx
    x64.andRegReg rcx, rcx, rdx
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, matcharm#3
    x64.jmp matchnext#5
  matcharm#3:
    x64.movRegImm32 r8, 67
    x64.popReg rbp
    x64.ret
  matchnext#5:
    x64.cmpRegImm32 rax, 80
    x64.setccReg greaterEqual, rcx
    x64.cmpRegImm32 rax, 89
    x64.setccReg lessEqual, rdx
    x64.andRegReg rcx, rcx, rdx
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, matcharm#2
    x64.jmp matchnext#6
  matcharm#2:
    x64.movRegImm32 r8, 66
    x64.popReg rbp
    x64.ret
  matchnext#6:
    x64.cmpRegImm32 rax, 90
    x64.setccReg greaterEqual, rcx
    x64.cmpRegImm32 rax, 100
    x64.setccReg lessEqual, rax
    x64.andRegReg rcx, rcx, rax
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, matcharm#1
    x64.jmp matchdefault
  matcharm#1:
    x64.movRegImm32 r8, 65
    x64.popReg rbp
    x64.ret
  matchdefault:
    x64.movRegImm32 r8, 70
    x64.popReg rbp
    x64.ret
  matchcont:
}
