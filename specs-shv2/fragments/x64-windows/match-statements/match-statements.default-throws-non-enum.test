// Test: match-statements.default-throws-non-enum
typealias Integer = int(0 to 100)

enum StringError
	notFound
end 'StringError'

function classify(s String) returns Integer throws StringError
	return match s 'check'
		"a" gives 1
		"b" gives 2
		default throws StringError.notFound
	end 'check'
end 'classify'

function main() returns ExitCode
	let a = try classify("a") otherwise 0
	let c = try classify("c") otherwise 99
	if a == 1 and c == 99 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
func @classify {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.leaRegRdata rdx, [rip + __str_rec_3]  ; "a"
    x64.movRegReg rcx, rbx
    x64.callDirect __str_eq
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, matchnext#2
  matcharm#1:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont
  matchnext#2:
    x64.leaRegRdata rdx, [rip + __str_rec_4]  ; "b"
    x64.movRegReg rcx, rbx
    x64.callDirect __str_eq
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, matchnext#4
  matcharm#3:
    x64.movRegImm32 r8, 2
  matchcont:
    x64.movRegImm32 r10, 0
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 100
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_6]  ; "panic at match-statements.default-throws-non-enum.test:9: Range check failed: value outside typealias 'Integer'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchnext#4:
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.leaRegRdata rcx, [rip + __str_rec_3]  ; "a"
    x64.callDirect classify
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#1
  tryerr#2:
    x64.movRegImm32 rbx, 0
    x64.jmp trycont#3
  tryok#1:
    x64.movRegReg rbx, r8
  trycont#3:
    x64.leaRegRdata rcx, [rip + __str_rec_5]  ; "c"
    x64.callDirect classify
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#4
  tryerr#5:
    x64.movRegImm32 rax, 99
    x64.jmp trycont#6
  tryok#4:
    x64.movRegReg rax, r8
  trycont#6:
    x64.cmpRegImm32 rbx, 1
    x64.movRegImm32 rcx, 0
    x64.jcc notEqual, critsplit
  andrhs:
    x64.cmpRegImm32 rax, 99
    x64.setccReg equal, rax
    x64.jmp scmerge
  critsplit:
    x64.movRegReg rax, rcx
  scmerge:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont
  check:
    x64.movRegImm32 r8, 1
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
