// Test: match-statements.try-otherwise-panic
enum Err implements Error
	bad
end 'Err'

function ok() throws Err
	return
end 'ok'

function dispatch(kind Tally)
	match kind 'k'
		1 then try ok() otherwise panic("unreachable")
		default panic("unreachable")
	end 'k'
end 'dispatch'

typealias Tally = int(0 to 100)

function main() returns ExitCode
	dispatch(1)
	return 0
end 'main'
---
ExitCode: 0
---
func @ok {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
}

func @dispatch {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 1
    x64.jcc equal, matcharm
    x64.jmp matchnext
  matcharm:
    x64.callDirect ok
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata rax, [rip + __str_rec_1]
    x64.movRegImm32 rcx, 134
    x64.movReg32Reg32 rcx, rcx
    x64.iatCall 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  tryok:
    x64.jmp matchcont
  matchcont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchnext:
    x64.leaRegRdata rax, [rip + __str_rec_1]
    x64.movRegImm32 rcx, 134
    x64.movReg32Reg32 rcx, rcx
    x64.iatCall 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 1
    x64.callDirect dispatch
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
