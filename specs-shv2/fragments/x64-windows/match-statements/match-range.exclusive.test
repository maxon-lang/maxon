// Test: match-range.exclusive
function main() returns ExitCode
	let x = 4
	match x 'check'
		1 upto 5 then return 1
		default then return 0
	end 'check'
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 4
    x64.cmpRegImm32 rax, 1
    x64.setccReg greaterEqual, rcx
    x64.cmpRegImm32 rax, 4
    x64.setccReg lessEqual, rax
    x64.andRegReg rcx, rcx, rax
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, matchdefault
  matcharm:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  matchdefault:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
