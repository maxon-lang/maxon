// Test: match-statements.default-panic-non-enum
typealias Integer = int(0 to 100)

function classify(x Integer) returns Integer
	return match x 'check'
		1 gives 10
		2 gives 20
		default panic("unexpected value")
	end 'check'
end 'classify'

function main() returns ExitCode
	let result = classify(2)
	if result == 20 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
func @classify {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic#7
  __rc_chk#8:
    x64.cmpRegImm32 rcx, 100
    x64.jcc lessEqual, __rc_ok#6
  __rc_panic#7:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at match-statements.default-panic-non-enum.test:4: Range check failed: value outside typealias 'Integer'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#6:
    x64.cmpRegImm32 rcx, 1
    x64.jcc notEqual, matchnext
  matcharm#1:
    x64.movRegImm32 r8, 10
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rcx, 2
    x64.jcc notEqual, matchdefault
  matcharm#2:
    x64.movRegImm32 r8, 20
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#10
  __rc_chk#11:
    x64.cmpRegImm32 r8, 100
    x64.jcc lessEqual, __rc_ok#9
  __rc_panic#10:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at match-statements.default-panic-non-enum.test:5: Range check failed: value outside typealias 'Integer'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#9:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdefault:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at match-statements.default-panic-non-enum.test:8: unexpected value\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 2
    x64.callDirect classify
    x64.cmpRegImm32 r8, 20
    x64.jcc notEqual, ifcont
  check:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
