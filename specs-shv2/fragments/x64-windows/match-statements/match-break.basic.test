// Test: match-break.basic
function main() returns ExitCode
	var result = 0
	match 2 'check'
		1 then result = 10
		2 then break
		default then result = 99
	end 'check'
	return result
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 0
    x64.movRegImm32 rax, 2
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm
    x64.jmp matchnext
  matcharm:
    x64.movRegImm32 r8, 10
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 2
    x64.jcc equal, matcharm
    x64.jmp matchdefault
  matcharm:
    x64.jmp matchcont
  matchdefault:
    x64.movRegImm32 r8, 99
    x64.jmp matchcont
  matchcont:
    x64.popReg rbp
    x64.ret
  afterbreak:
}
