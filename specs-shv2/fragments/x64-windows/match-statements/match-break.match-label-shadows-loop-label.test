// Test: match-break.match-label-shadows-loop-label
function main() returns ExitCode
	var n = 0
	var trips = 0
	while n < 3 'dup'
		n = n + 1
		match n 'dup'
			1 then break 'dup'
			default then trips = trips + 1
		end 'dup'
		trips = trips + 10
	end 'dup'
	return trips
end 'main'
---
ExitCode: 32
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
    x64.movRegImm32 r8, 0
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegImm32 rax, 3
    x64.jcc less, dup
    x64.jmp whileexit
  dup:
    x64.leaRegRegImm32 rax, rax, 1
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm
    x64.jmp matchdefault
  matcharm:
    x64.jmp matchcont
  matchdefault:
    x64.leaRegRegImm32 rcx, r8, 1
    x64.movRegReg r8, rcx
    x64.jmp matchcont
  matchcont:
    x64.leaRegRegImm32 r8, r8, 10
    x64.jmp whilehdr
  whileexit:
    x64.popReg rbp
    x64.ret
  afterbreak:
}
