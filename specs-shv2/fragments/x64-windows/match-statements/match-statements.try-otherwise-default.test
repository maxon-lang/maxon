// Test: match-statements.try-otherwise-default
enum Err implements Error
	bad
end 'Err'

typealias Tally = int(0 to 100)
typealias Score = int(0 to 100)

function leaf() returns Score throws Err
	throw Err.bad
end 'leaf'

function dispatch(kind Tally) returns Score
	match kind 'k'
		1 then return try leaf() otherwise 42
		default panic("unreachable")
	end 'k'
end 'dispatch'

function main() returns ExitCode
	return dispatch(1)
end 'main'
---
ExitCode: 42
---
func @leaf {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}

func @dispatch {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rcx, 100
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at match-statements.try-otherwise-default.test:13: Range check failed: value outside typealias 'Tally'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.cmpRegImm32 rcx, 1
    x64.jcc notEqual, matchdefault
  matcharm:
    x64.callDirect leaf
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, trycont
  tryerr:
    x64.movRegImm32 r8, 42
  trycont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdefault:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at match-statements.try-otherwise-default.test:16: unreachable\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 1
    x64.callDirect dispatch
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
