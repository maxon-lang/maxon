// Test: match-statements.or-patterns-first
function main() returns ExitCode
	let x = 1
	match x 'check'
		1 or 2 then return 10
		3 or 4 then return 20
		default then return 0
	end 'check'
end 'main'
---
ExitCode: 10
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 rax, 3
    x64.jcc less, matchlo
    x64.jmp matchhi
  matchlo:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm
    x64.jmp matchnext
  matchnext:
    x64.cmpRegImm32 rax, 2
    x64.jcc equal, matcharm
    x64.jmp matchdefault
  matcharm:
    x64.movRegImm32 r8, 10
    x64.popReg rbp
    x64.ret
  matchhi:
    x64.cmpRegImm32 rax, 3
    x64.jcc equal, matcharm
    x64.jmp matchnext
  matchnext:
    x64.cmpRegImm32 rax, 4
    x64.jcc equal, matcharm
    x64.jmp matchdefault
  matcharm:
    x64.movRegImm32 r8, 20
    x64.popReg rbp
    x64.ret
  matchdefault:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  matchcont:
}
