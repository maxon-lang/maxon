// Test: match-statements.or-patterns
function main() returns ExitCode
	let x = 3
	match x 'check'
		1 or 2 then return 10
		3 or 4 or 5 then return 20
		default then return 0
	end 'check'
end 'main'
---
ExitCode: 20
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 3
    x64.cmpRegImm32 rax, 1
    x64.setccReg equal, rcx
    x64.cmpRegImm32 rax, 2
    x64.setccReg equal, rdx
    x64.orRegReg rcx, rcx, rdx
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, matcharm
    x64.jmp matchnext
  matcharm:
    x64.movRegImm32 r8, 10
    x64.popReg rbp
    x64.ret
  matchnext:
    x64.cmpRegImm32 rax, 3
    x64.setccReg equal, rcx
    x64.cmpRegImm32 rax, 4
    x64.setccReg equal, rdx
    x64.orRegReg rcx, rcx, rdx
    x64.cmpRegImm32 rax, 5
    x64.setccReg equal, rax
    x64.orRegReg rcx, rcx, rax
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, matcharm
    x64.jmp matchnext
  matcharm:
    x64.movRegImm32 r8, 20
    x64.popReg rbp
    x64.ret
  matchnext:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  matchcont:
}
