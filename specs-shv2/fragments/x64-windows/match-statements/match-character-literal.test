// Test: match-character-literal
function main() returns ExitCode
	let c = 'ñ'
	match c 'check'
		'ñ' then print("eq\n")
		default then print("ne\n")
	end 'check'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_3]
    x64.leaRegRdata rdx, [rip + __str_rec_3]
    x64.callDirect __str_eq
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, matcharm
    x64.jmp matchnext
  matcharm:
    x64.leaRegRdata rcx, [rip + __str_rec_4]
    x64.callDirect print
    x64.jmp matchcont
  matchnext:
    x64.leaRegRdata rcx, [rip + __str_rec_5]
    x64.callDirect print
    x64.jmp matchcont
  matchcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
