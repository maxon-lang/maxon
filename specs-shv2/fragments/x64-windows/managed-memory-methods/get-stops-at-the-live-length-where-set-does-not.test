    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#3:
    x64.movRegImm32 rdx, 1
    x64.movRegImm32 rax, 77
    x64.loadRegBaseDisp.word64 rcx, [rbx + 40]
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, __im_slow#20
