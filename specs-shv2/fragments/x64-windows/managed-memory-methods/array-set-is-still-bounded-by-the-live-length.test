// Test: array-set-is-still-bounded-by-the-live-length
typealias Int = int(i64.min to i64.max)
typealias IntArray = Array with Int

function main() returns ExitCode
	var arr = IntArray.create()
	arr.push(1)
	arr.push(2)
	if arr.capacity() < 4 'needsASlotPastTheLength'
		return 1
	end 'needsASlotPastTheLength'
	try arr.set(2, value: 3) otherwise 'pastLength'
		return 42
	end 'pastLength'
	return 5
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegReg rcx, rbx
    x64.callDirect Array.capacity
    x64.cmpRegImm32 r8, 4
    x64.jcc less, needsASlotPastTheLength
    x64.jmp ifcont
  needsASlotPastTheLength:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rdx, 2
    x64.movRegImm32 rax, 3
    x64.loadRegBaseDisp.word64 rcx, [rbx + 24]
    x64.cmpRegImm32 rcx, 8
    x64.jcc equal, __im_word
    x64.jmp __im_stride
  __im_word:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 40]
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, __il_slow
    x64.jmp __im_bounds#10
  __im_bounds#10:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
    x64.cmpRegImm32 rdx, 0
    x64.setccReg less, rsi
    x64.cmpRegImm32 rcx, 2
    x64.setccReg lessEqual, rcx
    x64.orRegReg rsi, rsi, rcx
    x64.cmpRegImm32 rsi, 0
    x64.jcc notEqual, __il_slow
    x64.jmp __im_owned#11
  __im_owned#11:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 16]
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __il_slow
    x64.jmp __im_buffer#12
  __im_buffer#12:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, __il_slow
    x64.jmp __im_viewed#13
  __im_viewed#13:
    x64.leaRegRegImm32 rsi, rcx, -24
    x64.loadRegBaseDisp.word64 rsi, [rsi + 16]
    x64.cmpRegImm32 rsi, 0
    x64.jcc notEqual, __il_slow
    x64.jmp __im_store#14
  __im_store#14:
    x64.imulRegRegImm32 rdx, rdx, 8
    x64.leaRegRegReg rcx, rcx, rdx
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 rax, 0
    x64.jmp __il_cont
  __im_stride:
    x64.cmpRegImm32 rcx, 1
    x64.jcc equal, __im_byte
    x64.jmp __il_slow
  __im_byte:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 40]
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, __il_slow
    x64.jmp __im_bounds#15
  __im_bounds#15:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
    x64.cmpRegImm32 rdx, 0
    x64.setccReg less, rsi
    x64.cmpRegImm32 rcx, 2
    x64.setccReg lessEqual, rcx
    x64.orRegReg rsi, rsi, rcx
    x64.cmpRegImm32 rsi, 0
    x64.jcc notEqual, __il_slow
    x64.jmp __im_owned#16
  __im_owned#16:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 16]
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __il_slow
    x64.jmp __im_buffer#17
  __im_buffer#17:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, __il_slow
    x64.jmp __im_viewed#18
  __im_viewed#18:
    x64.leaRegRegImm32 rsi, rcx, -24
    x64.loadRegBaseDisp.word64 rsi, [rsi + 16]
    x64.cmpRegImm32 rsi, 0
    x64.jcc notEqual, __il_slow
    x64.jmp __im_store#19
  __im_store#19:
    x64.leaRegRegReg rcx, rcx, rdx
    x64.storeBaseDispReg.byte [rcx + 0], rax
    x64.movRegImm32 rax, 0
    x64.jmp __il_cont
  __il_slow:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_set
    x64.movRegReg rax, r10
    x64.jmp __il_cont
  __il_cont:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 r12, 42
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegImm32 r12, 5
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Array.capacity {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect __mm_retain
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_capacity
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
