    x64.jmp trycont#3
  tryok#1:
    x64.movRegReg rax, r8
  trycont#3:
    x64.storeSlotReg slot0, rax
    x64.movRegImm32 rdx, 3
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_resize
    x64.movRegImm32 rdx, 0
  whilehdr:
    x64.storeSlotReg slot1, rdx
    x64.cmpRegImm32 rdx, 3
    x64.jcc greaterEqual, whileexit
  read:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rdx, 0
    x64.setccReg less, rcx
    x64.cmpRegReg rdx, rax
    x64.setccReg greaterEqual, rax
    x64.orRegReg rcx, rcx, rax
