// Test: a-sibling-files-array-of-buffers-alias-serves-the-roster
// --- file: alias.maxon
typealias Int = int(i64.min to i64.max)
typealias BufArray = Array with __ManagedMemory

export function seed(x BufArray) returns Int
	return x.count() as Int
end 'seed'

// --- file: main.maxon
type Holder
	export var bufs as BufArray

	export static function create() returns Holder
		var a = BufArray.create()
		a.push("hello".toByteArray())
		return Self{bufs: a}
	end 'create'
end 'Holder'

function main() returns ExitCode
	let h = Holder.create()
	let m = try h.bufs.get(0) otherwise return 1
	return (m.length() + seed(BufArray.create())) as ExitCode
end 'main'
---
ExitCode: 5
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Holder.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __managed_decref]
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.leaRegRdata rcx, [rip + __str_rec_1]
    x64.callDirect String.toByteArray
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect Holder.create
    x64.movRegReg rbx, r8
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc belowEqual, __im_slow
  __im_load:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.movRegImm32 rsi, 0
    x64.loadRegBaseDisp.word64 rdi, [rcx + 40]
    x64.cmpRegImm32 rdi, 0
    x64.jcc equal, critsplit#12
  __im_empty:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, critsplit#13
  __im_slow:
    x64.callDirect __managed_get
    x64.jmp __im_cont
  critsplit#13:
    x64.movRegReg r8, rax
    x64.movRegReg r10, rsi
    x64.jmp __im_cont
  critsplit#12:
    x64.movRegReg r8, rax
    x64.movRegReg r10, rsi
  __im_cont:
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Holder
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.loadRegBaseDisp.word64 r12, [r8 + 8]
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __managed_decref]
    x64.callDirect __managed_create
  __il_body:
    x64.loadRegBaseDisp.word64 rax, [r8 + 8]
  __il_cont:
    x64.leaRegRegReg r12, r12, rax
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_3]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, r8
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Holder
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
