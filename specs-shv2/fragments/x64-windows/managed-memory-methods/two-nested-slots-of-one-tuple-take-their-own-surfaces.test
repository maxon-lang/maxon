// Test: two-nested-slots-of-one-tuple-take-their-own-surfaces
typealias Int = int(i64.min to i64.max)
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

function mixed() returns ((ByteArray, Int), (Int, __ManagedMemory), Int)
	return (("hello".toByteArray(), 1), (2, "abcd".toByteArray()), 9)
end 'mixed'

function main() returns ExitCode
	let p = mixed()
	return (p.1.1.length() + p.0.0.count()) as ExitCode
end 'main'
---
ExitCode: 9
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @mixed {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_2]
    x64.callDirect String.toByteArray
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 1
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
    x64.storeBaseDispReg.word64 [r13 + 8], r12
    x64.movRegImm32 rbx, 2
    x64.leaRegRdata rcx, [rip + __str_rec_3]
    x64.callDirect String.toByteArray
    x64.movRegReg r12, r8
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.storeBaseDispReg.word64 [r14 + 0], rbx
    x64.storeBaseDispReg.word64 [r14 + 8], r12
    x64.movRegImm32 rbx, 9
    x64.movRegImm32 rcx, 24
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], r13
    x64.storeBaseDispReg.word64 [r8 + 8], r14
    x64.storeBaseDispReg.word64 [r8 + 16], rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.callDirect mixed
    x64.loadRegBaseDisp.word64 rax, [r8 + 8]
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.loadRegBaseDisp.word64 rcx, [r8 + 0]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 8]
    x64.leaRegRegReg rbx, rax, rcx
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_5]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, r8
    x64.callDirect __destruct___Tuple3.__Tuple2#34ddfa177b5098c5.__Tuple2#10b2e2e220f2e58b.int
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @String.toByteArray {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg rcx, rbx
    x64.callDirect __str_bytes_view
    x64.movRegReg r12, r8
    x64.movRegImm32 r13, 0
    x64.movRegReg rcx, rbx
    x64.callDirect String.byteLength
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r13
    x64.movRegReg rax, r8
    x64.callDirect __managed_slice
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_4]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_retain
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @String.byteLength {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 r8, [rcx + 8]
    x64.popReg rbp
    x64.ret
}
