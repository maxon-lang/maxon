// Test: array-members-still-work-through-a-managed-field-hop
typealias Int = int(i64.min to i64.max)
typealias IntArray = Array with Int

function main() returns ExitCode
	var arr = IntArray.create()
	arr.push(10)
	arr.push(20)
	try arr.managed.set(0, value: 12) otherwise return 1
	arr.push(30)
	let popped = try arr.pop() otherwise return 2
	let head = try arr.first() otherwise return 3
	return (arr.count() + popped + head) as ExitCode
end 'main'
---
ExitCode: 44
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __arr_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 10
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_push
    x64.movRegImm32 rdx, 20
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_push
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 rax, 12
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_mem_set
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegImm32 rdx, 30
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_push
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_pop
    x64.movRegReg r12, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 r12, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_first
    x64.movRegReg r13, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 r12, 3
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_count
    x64.leaRegRegReg rax, r8, r12
    x64.leaRegRegReg r12, rax, r13
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
