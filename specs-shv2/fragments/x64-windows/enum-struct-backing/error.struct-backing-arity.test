// Test: error.struct-backing-arity
typealias Wide = int(0 to 100)

type Meta
	export let value as Wide
end 'Meta'

enum Task
	quick = Meta.create(1, 2)
end 'Task'

function main() returns ExitCode
	return 0
end 'main'
---
CompilerError:
error E2015: <fragment>:9:2: Unsupported: 2 argument(s) to a `Meta` backing, which declares 1 field(s) — a factory call in this position is read as the struct LITERAL its arguments fill, so an argument past the last field names nothing
