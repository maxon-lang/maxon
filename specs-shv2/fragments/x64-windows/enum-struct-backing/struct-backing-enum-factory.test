// Test: struct-backing-enum-factory
typealias Level = int(0 to 100)

enum Mode
	fast
	slow
end 'Mode'

type Config
	export let mode as Mode
	export let level as Level

	static function create(mode Mode, level Level) returns Self
		return Self{mode: mode, level: level}
	end 'create'
end 'Config'

enum Setting
	turbo = Config.create(Mode.fast, level: 10)
	eco = Config.create(Mode.slow, level: 3)
end 'Setting'

function main() returns ExitCode
	let s = Setting.turbo
	return s.rawValue.mode.ordinal
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 rax, 0
    x64.setccReg equal, rcx
    x64.imulRegRegImm32 rcx, rcx, 0
    x64.cmpRegImm32 rax, 1
    x64.setccReg equal, rax
    x64.leaRegRegReg r8, rcx, rax
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
