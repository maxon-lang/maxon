// Test: partition-merge-direct-correctness
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer
typealias ScratchArr = Array with Integer
typealias Idx = int(0 to u64.max)

function ascending(x Integer, y Integer) returns Ordering
	return x.compare(y)
end 'ascending'

function main() returns ExitCode
	var a = IntArray.create()
	for i in 0 upto 20 'l'
		a.push(i * 2 + 1)
	end 'l'
	for j in 0 upto 20 'r'
		a.push(j * 2 + 2)
	end 'r'
	var scratch = ScratchArr.create()
	let cap = 4 as Idx
	scratch.resize(cap)
	Log.startCapture()
	a.mergePartition(0, mid: 20, hi: 40, scratch: scratch, scratchCap: cap, cmp: ascending)
	let keys = Log.stopCapture()
	if Log.fired(keys, key: "partitionMerge.fire") 'pf'
		print("partitionMerge.fire ")
	end 'pf'
	for x in a 'p'
		print("{x} ")
	end 'p'
	print("\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_captured@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
  __data_capturing@40 = i1 0
}

func @ascending {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.cmpRegReg rcx, rdx
    x64.jcc greaterEqual, ifcont#4
  lt:
    x64.movRegImm32 r8, 0
    x64.jmp __il_cont
  ifcont#4:
    x64.cmpRegReg rcx, rdx
    x64.jcc lessEqual, ifcont#6
  gt:
    x64.movRegImm32 r8, 2
    x64.jmp __il_cont
  ifcont#6:
    x64.movRegImm32 r8, 1
  __il_cont:
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 120
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 0
  forhdr#1:
    x64.cmpRegImm32 r12, 20
    x64.jcc greaterEqual, forexit#4
  l:
    x64.imulRegRegImm32 rax, r12, 2
    x64.leaRegRegImm32 rdx, rax, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
  forstep#3:
    x64.leaRegRegImm32 r12, r12, 1
    x64.jmp forhdr#1
  forexit#4:
    x64.movRegImm32 r12, 0
  forhdr#5:
    x64.cmpRegImm32 r12, 20
    x64.jcc greaterEqual, forexit#8
  r:
    x64.imulRegRegImm32 rax, r12, 2
    x64.leaRegRegImm32 rdx, rax, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
  forstep#7:
    x64.leaRegRegImm32 r12, r12, 1
    x64.jmp forhdr#5
  forexit#8:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.storeSlotReg slot0, r12
    x64.movRegImm32 r13, 4
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r13
    x64.callDirect __managed_resize
    x64.callDirect Log.startCapture
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 rax, 20
    x64.movRegImm32 r9, 40
    x64.leaRegFunc rcx, [rip + __fnref_ascending]
    x64.movRegImm32 rsi, 0
    x64.leaRegRdata rdi, [rip + __layout_Array_Integer]
    x64.storeBaseDispReg.word64 [rsp + 32], rcx
    x64.storeBaseDispReg.word64 [rsp + 40], rsi
    x64.storeBaseDispReg.word64 [rsp + 48], rdi
    x64.movRegReg rcx, rbx
    x64.movRegReg rsi, r12
    x64.movRegReg rdi, r13
    x64.callDirect Array.mergePartition
    x64.callDirect Log.stopCapture
    x64.storeSlotReg slot1, r8
    x64.leaRegRdata rdx, [rip + __str_rec_7]
    x64.movRegReg rcx, r8
    x64.callDirect Log.fired
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont
  pf:
    x64.leaRegRdata rcx, [rip + __str_rec_8]
    x64.callDirect print
  ifcont:
    x64.movRegImm32 rax, 0
  forhdr#11:
    x64.storeSlotReg slot2, rax
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
    x64.cmpRegReg rax, rcx
    x64.jcc greaterEqual, forexit#14
  p:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.loadRegBaseIndexScale.word64 r12, [rcx + rax*8 + 0]
  __im_cont:
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeSlotReg slot3, r13
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r13
    x64.callDirect __int_to_string
    x64.movRegReg r12, r8
    x64.leaRegRdata rax, [rip + __str_rec_9]
    x64.loadRegBaseDisp.word64 r14, [rax + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.storeSlotReg slot6, rax
    x64.leaRegRegReg rax, r12, rax
    x64.storeSlotReg slot4, rax
    x64.leaRegRegImm32 rcx, rax, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot5, r8
    x64.leaRegRegImm32 r15, r8, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r13
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg r12, r15, r12
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r14
    x64.loadRegSlot r13, slot6
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r12, r13
    x64.loadRegSlot r12, slot5
    x64.storeBaseDispReg.word64 [r12 + 0], r15
    x64.loadRegSlot rax, slot4
    x64.storeBaseDispReg.word64 [r12 + 8], rax
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [r12 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r12 + 24], rax
    x64.loadRegSlot rcx, slot3
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r12
    x64.callDirect print
    x64.movRegReg rcx, r12
    x64.callDirect __str_decref
  forstep#13:
    x64.loadRegSlot rax, slot2
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp forhdr#11
  forexit#14:
    x64.leaRegRdata rcx, [rip + __str_rec_10]
    x64.callDirect print
    x64.movRegImm32 r12, 0
    x64.loadRegSlot rcx, slot1
    x64.callDirect __managed_decref
    x64.loadRegSlot rcx, slot0
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 120
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
