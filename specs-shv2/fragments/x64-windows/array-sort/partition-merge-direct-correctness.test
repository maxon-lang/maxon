// Test: partition-merge-direct-correctness
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer
typealias ScratchArr = Array with Integer
typealias Idx = int(0 to u64.max)

function ascending(x Integer, y Integer) returns Ordering
	return x.compare(y)
end 'ascending'

function main() returns ExitCode
	var a = IntArray.create()
	for i in 0 upto 20 'l'
		a.push(i * 2 + 1)
	end 'l'
	for j in 0 upto 20 'r'
		a.push(j * 2 + 2)
	end 'r'
	var scratch = ScratchArr.create()
	let cap = 4 as Idx
	scratch.resize(cap)
	Log.startCapture()
	a.mergePartition(0, mid: 20, hi: 40, scratch: scratch, scratchCap: cap, cmp: ascending)
	let keys = Log.stopCapture()
	if Log.fired(keys, key: "partitionMerge.fire") 'pf'
		print("partitionMerge.fire ")
	end 'pf'
	for x in a 'p'
		print("{x} ")
	end 'p'
	print("\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_captured@0 = i64 0
  __slab_cursor@8 = i64 0
  __slab_end@16 = i64 0
  __mm_alloc_count@24 = i64 0
  __data_capturing@32 = i1 0
}

func @ascending {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect int.compare
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

