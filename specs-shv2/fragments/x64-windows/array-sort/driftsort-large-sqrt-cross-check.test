    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 2463534242
    x64.movRegImm32 r13, 0
  forhdr#1:
    x64.cmpRegImm32 r13, 5000
    x64.jcc greaterEqual, forexit#4
  fill:
    x64.imulRegRegImm32 rax, rax, 1103515245
    x64.leaRegRegImm32 r14, rax, 12345
    x64.andRegImm32 r14, r14, 2147483647
    x64.movRegReg r15, r14
    x64.andRegImm32 r15, r14, 65535
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r15
    x64.callDirect __managed_push
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r15
    x64.callDirect __managed_push
  forstep#3:
    x64.leaRegRegImm32 r13, r13, 1
    x64.movRegReg rax, r14
    x64.jmp forhdr#1
  forexit#4:
    x64.leaRegFunc rdx, [rip + __fnref_ascending]
    x64.movRegImm32 rax, 0
