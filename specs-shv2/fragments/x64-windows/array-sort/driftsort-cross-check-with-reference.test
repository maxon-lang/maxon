  gt:
    x64.movRegImm32 r8, 2
    x64.jmp __il_cont
  ifcont#6:
    x64.movRegImm32 r8, 1
    x64.jmp __il_cont
  __il_cont:
    x64.popReg rbp
    x64.ret
}

