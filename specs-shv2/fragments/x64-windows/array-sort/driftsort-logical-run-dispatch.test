    x64.cmpRegReg rdx, rax
    x64.setccReg greaterEqual, rax
    x64.orRegReg rcx, rcx, rax
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, __im_slow#21
  __im_load#22:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseIndexScale.word64 r15, [rax + rdx*8 + 0]
    x64.movRegImm32 rax, 0
    x64.loadRegBaseDisp.word64 rcx, [rbx + 40]
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, critsplit#29
  __im_empty#23:
    x64.cmpRegImm32 r15, 0
    x64.jcc notEqual, critsplit#30
  __im_slow#21:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.movRegReg r15, r8
    x64.jmp __im_cont#20
  critsplit#30:
    x64.movRegReg r10, rax
    x64.jmp __im_cont#20
  critsplit#29:
    x64.movRegReg r10, rax
  __im_cont#20:
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#12
  tryerr#13:
    x64.movRegImm32 r13, 90
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
