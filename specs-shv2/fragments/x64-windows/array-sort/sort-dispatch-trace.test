// Test: sort-dispatch-trace
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

function main() returns ExitCode
	var a = IntArray.create()
	a.push(3)
	a.push(1)
	a.push(2)
	Log.startCapture()
	a.sort()
	let keys = Log.stopCapture()
	if Log.fired(keys, key: "insertionSort.run") 'k'
		print("insertion-fired\n")
	end 'k' else 'nk'
		print("insertion-MISSING\n")
	end 'nk'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_captured@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
  __data_capturing@40 = i1 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 3
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.callDirect Log.startCapture
    x64.leaRegRdata rdx, [rip + __layout_Array_Integer]
    x64.leaRegRdata rax, [rip + __witness_int.Comparable]
    x64.movRegReg rcx, rbx
    x64.callDirect Array.sort
    x64.callDirect Log.stopCapture
    x64.movRegReg r12, r8
    x64.leaRegRdata rdx, [rip + __str_rec_19]
    x64.movRegReg rcx, r12
    x64.callDirect Log.fired
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, k
    x64.jmp ifelse
  k:
    x64.leaRegRdata rcx, [rip + __str_rec_20]
    x64.callDirect print
    x64.jmp ifcont
  ifelse:
    x64.leaRegRdata rcx, [rip + __str_rec_21]
    x64.callDirect print
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 r13, 0
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
