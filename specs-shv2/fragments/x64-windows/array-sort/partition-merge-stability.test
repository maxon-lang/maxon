func @grownCapacity {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegReg rsi, rdx
    x64.leaRegRegReg rax, rcx, rcx
    x64.cmpRegReg rsi, rax
    x64.jcc greater, takeTheAskAsGiven
    x64.jmp ifcont#2
  takeTheAskAsGiven:
    x64.movRegReg rcx, rsi
    x64.callDirect atLeastMinimum
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.cmpRegImm32 rcx, 256
    x64.jcc less, stillSmall
    x64.jmp ifcont#4
  stillSmall:
    x64.movRegReg rcx, rax
    x64.callDirect atLeastMinimum
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegReg r8, rcx
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegReg r8, rsi
    x64.jcc less, ease
    x64.jmp whileexit
  ease:
    x64.movRegImm32 rax, 3
    x64.imulRegRegImm32 rax, rax, 256
    x64.leaRegRegReg rax, r8, rax
    x64.movRegImm32 rcx, 4
    x64.cqo
    x64.idivReg rcx
    x64.leaRegRegReg r8, r8, rax
    x64.jmp whilehdr
  whileexit:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @atLeastMinimum {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 4
    x64.jcc less, raise
    x64.jmp ifcont
  raise:
    x64.movRegImm32 r8, 4
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegReg r8, rcx
    x64.popReg rbp
    x64.ret
}

