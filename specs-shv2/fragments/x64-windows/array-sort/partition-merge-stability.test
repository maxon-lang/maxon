func @int.compare {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegReg rcx, rdx
    x64.jcc less, less
    x64.jmp notLess
  less:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  notLess:
    x64.cmpRegReg rcx, rdx
    x64.jcc greater, greater
    x64.jmp equal
  greater:
