    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.leaRegRegImm32 r12, rax, -1
    x64.movRegReg r13, r12
    x64.movRegReg r12, rdx
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegReg r12, r13
    x64.jcc less, loop
    x64.jmp whileexit
  loop:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.movRegReg rax, r13
    x64.callDirect Array.swap
    x64.leaRegRegImm32 r12, r12, 1
    x64.leaRegRegImm32 r13, r13, -1
    x64.jmp whilehdr
  whileexit:
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

