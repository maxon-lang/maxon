// Test: pdq-correctness-100elem-loop
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

function ascending(x Integer, y Integer) returns Ordering
	return x.compare(y)
end 'ascending'

function main() returns ExitCode
	var a = IntArray.create()
	for i in 0 upto 100 'fill'
		a.push((i * 31) + 7)
	end 'fill'
	a.sortUnstable(ascending)
	for x in a 'p'
		print("{x} ")
	end 'p'
	print("\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_captured@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
  __data_capturing@40 = i1 0
}

func @ascending {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.jmp __il_body
  __il_body:
    x64.cmpRegReg rcx, rdx
    x64.jcc less, lt
    x64.jmp ifcont#4
  lt:
    x64.movRegImm32 r8, 0
    x64.jmp __il_cont
  ifcont#4:
    x64.cmpRegReg rcx, rdx
    x64.jcc greater, gt
    x64.jmp ifcont#6
  gt:
    x64.movRegImm32 r8, 2
    x64.jmp __il_cont
  ifcont#6:
    x64.movRegImm32 r8, 1
    x64.jmp __il_cont
  __il_cont:
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 72
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 0
    x64.jmp forhdr#1
  forhdr#1:
    x64.cmpRegImm32 r12, 100
    x64.jcc less, fill
    x64.jmp forexit#4
  fill:
    x64.imulRegRegImm32 rax, r12, 31
    x64.leaRegRegImm32 rdx, rax, 7
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.jmp forstep#3
  forstep#3:
    x64.leaRegRegImm32 r12, r12, 1
    x64.jmp forhdr#1
  forexit#4:
    x64.leaRegFunc rdx, [rip + __fnref_ascending]
    x64.movRegImm32 rax, 0
    x64.leaRegRdata r9, [rip + __layout_Array_Integer]
    x64.movRegReg rcx, rbx
    x64.callDirect Array.sortUnstable#Array.SortComparator
    x64.movRegImm32 rdx, 0
    x64.jmp forhdr#5
  forhdr#5:
    x64.storeSlotReg slot0, rdx
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegReg rdx, rax
    x64.jcc less, p
    x64.jmp forexit#8
  p:
    x64.loadRegBaseDisp.word64 rax, [rbx + 24]
    x64.cmpRegImm32 rax, 8
    x64.jcc equal, __im_word
    x64.jmp __im_stride
  __im_word:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.imulRegRegImm32 rcx, rdx, 8
    x64.leaRegRegReg rax, rax, rcx
    x64.loadRegBaseDisp.word64 r12, [rax + 0]
    x64.jmp __il_cont
  __im_stride:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, __im_byte
    x64.jmp __il_slow
  __im_byte:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.leaRegRegReg rax, rax, rdx
    x64.loadRegBaseDisp.byte r12, [rax + 0]
    x64.jmp __il_cont
  __il_slow:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get_unchecked
    x64.movRegReg r12, r8
    x64.jmp __il_cont
  __il_cont:
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeSlotReg slot1, r13
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r13
    x64.callDirect __int_to_string
    x64.movRegReg r12, r8
    x64.leaRegRdata rax, [rip + __str_rec_11]
    x64.loadRegBaseDisp.word64 r14, [rax + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.storeSlotReg slot4, rax
    x64.leaRegRegReg rax, r12, rax
    x64.storeSlotReg slot2, rax
    x64.leaRegRegImm32 rcx, rax, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot3, r8
    x64.leaRegRegImm32 r15, r8, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r13
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg r12, r15, r12
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r14
    x64.loadRegSlot r13, slot4
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r12, r13
    x64.loadRegSlot r12, slot3
    x64.storeBaseDispReg.word64 [r12 + 0], r15
    x64.loadRegSlot rax, slot2
    x64.storeBaseDispReg.word64 [r12 + 8], rax
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [r12 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r12 + 24], rax
    x64.loadRegSlot rcx, slot1
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r12
    x64.callDirect print
    x64.movRegReg rcx, r12
    x64.callDirect __str_decref
    x64.jmp forstep#7
  forstep#7:
    x64.loadRegSlot rax, slot0
    x64.leaRegRegImm32 rdx, rax, 1
    x64.jmp forhdr#5
  forexit#8:
    x64.leaRegRdata rcx, [rip + __str_rec_12]
    x64.callDirect print
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 72
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
