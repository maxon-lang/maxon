// Test: async-try-await.otherwise-bind-cross-block
enum WorkError implements Error
	failed
end 'WorkError'

function work(shouldFail bool) returns int throws WorkError
	if shouldFail 'fail'
		throw WorkError.failed
	end 'fail'
	return 3
end 'work'

function main() returns ExitCode
	let p = async work(true)
	var guard = 1
	if guard == 1 'sep'
		guard = 2
	end 'sep'
	let r = try await p otherwise (e) 'failed'
		return match e 'which'
			failed gives 0
		end 'which'
	end 'failed'
	return r as ExitCode
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
  __gt_current_gt@24 = i64 0
  __gt_run_queue_head@32 = i64 0
  __gt_run_queue_tail@40 = i64 0
  __gt_init_done@48 = i64 0
  __gt_system_stack_top@56 = i64 0
  __gt_timer_count@64 = i64 0
  __gt_timer_heap_base@72 = i64 0
  __gt_clock_ticks@80 = i64 0
  __gt_clock_freq@88 = i64 0
  __gt_proc_count@96 = i64 0
  __gt_proc_handles_base@104 = i64 0
  __gt_proc_gts_base@112 = i64 0
  __gt_free_list_head@120 = i64 0
  __gt_startup_base@128 = i64 0
  __gt_procinfo_base@136 = i64 0
  __gt_exitcode_base@144 = i64 0
  __gt_cmdline_buf_base@152 = i64 0
  __gt_cmdline_buf_cap@160 = i64 0
}

func @work {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, fail
    x64.jmp ifcont
  fail:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 r10, rax, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 3
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 1
    x64.leaRegFunc rcx, [rip + work]
    x64.callDirect __gt_spawn
    x64.storeBaseDispReg.word64 [r8 + 176], rbx
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, sep
    x64.jmp critsplit
  sep:
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movRegReg rcx, r8
    x64.callDirect __gt_try_await
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRegImm32 rax, r10, -1
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm
    x64.jmp matchdead
  matcharm:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matchcont:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
  tryok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
