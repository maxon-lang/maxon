// Test: async-try-await.otherwise-bind-void
enum TaskError implements Error
	timedOut
	crashed
end 'TaskError'

var flag = 0

function maySetFlag(succeed bool) throws TaskError
	if succeed 'ok'
		flag = 1
		return
	end 'ok'
	throw TaskError.crashed
end 'maySetFlag'

function main() returns ExitCode
	let p = async maySetFlag(false)
	try await p otherwise (e) 'failed'
		flag = match e 'which'
			timedOut gives 7
			crashed gives 9
		end 'which'
	end 'failed'
	return flag as ExitCode
end 'main'
---
ExitCode: 9
---
data {
  __data_flag@0 = i64 0
  __slab_cursor@8 = i64 0
  __slab_end@16 = i64 0
  __mm_alloc_count@24 = i64 0
  __gt_current_gt@32 = i64 0
  __gt_run_queue_head@40 = i64 0
  __gt_run_queue_tail@48 = i64 0
  __gt_init_done@56 = i64 0
  __gt_stack_free_head@64 = i64 0
  __gt_timer_count@72 = i64 0
  __gt_timer_heap_base@80 = i64 0
  __gt_clock_ticks@88 = i64 0
  __gt_clock_freq@96 = i64 0
  __gt_proc_count@104 = i64 0
  __gt_proc_handles_base@112 = i64 0
  __gt_proc_gts_base@120 = i64 0
}

func @maySetFlag {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, ok
    x64.jmp ifcont
  ok:
    x64.movRegImm32 rax, 1
    x64.leaRegGlobal rcx, __data_flag
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rax, 1
    x64.leaRegRegImm32 r10, rax, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 48
    x64.callDirect __slab_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.leaRegFunc rcx, [rip + maySetFlag]
    x64.movRegReg rdx, r8
    x64.callDirect __gt_spawn
    x64.movRegReg rcx, r8
    x64.callDirect __gt_try_await
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRegImm32 rax, r10, -1
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm
    x64.jmp matchnext
  matcharm:
    x64.movRegImm32 rax, 7
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm
    x64.jmp matchnext
  matcharm:
    x64.movRegImm32 rax, 9
    x64.jmp matchcont
  matchcont:
    x64.leaRegGlobal rcx, __data_flag
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.jmp trycont
  matchnext:
  tryok:
    x64.jmp trycont
  trycont:
    x64.leaRegGlobal rax, __data_flag
    x64.loadRegBaseDisp.word64 r8, [rax + 0]
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
