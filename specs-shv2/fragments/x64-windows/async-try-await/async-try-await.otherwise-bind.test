// Test: async-try-await.otherwise-bind
enum TaskError implements Error
	timedOut
	crashed
end 'TaskError'

function mayFail(mode int) returns int throws TaskError
	Runtime.yield()
	if mode == 0 'ok'
		return 1
	end 'ok'
	if mode == 1 'slow'
		throw TaskError.timedOut
	end 'slow'
	throw TaskError.crashed
end 'mayFail'

function main() returns ExitCode
	let p = async mayFail(2)
	let r = try await p otherwise (e) 'failed'
		return match e 'why'
			timedOut gives 7
			crashed gives 9
		end 'why'
	end 'failed'
	return r as ExitCode
end 'main'
---
ExitCode: 9
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
  __gt_current_gt@24 = i64 0
  __gt_run_queue_head@32 = i64 0
  __gt_run_queue_tail@40 = i64 0
  __gt_init_done@48 = i64 0
  __gt_system_stack_top@56 = i64 0
  __gt_timer_count@64 = i64 0
  __gt_timer_heap_base@72 = i64 0
  __gt_timer_capacity@80 = i64 0
  __gt_trace_counter@88 = i64 0
  __gt_trace_digits@96 = i64 0
  __gt_clock_ticks@104 = i64 0
  __gt_clock_freq@112 = i64 0
  __gt_proc_count@120 = i64 0
  __gt_proc_handles_base@128 = i64 0
  __gt_proc_gts_base@136 = i64 0
  __gt_free_list_head@144 = i64 0
  __gt_live_count@152 = i64 0
  __gt_startup_base@160 = i64 0
  __gt_procinfo_base@168 = i64 0
  __gt_exitcode_base@176 = i64 0
  __gt_cmdline_buf_base@184 = i64 0
  __gt_cmdline_buf_cap@192 = i64 0
}

func @mayFail {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.callDirect Runtime.yield
    x64.cmpRegImm32 rbx, 0
    x64.jcc equal, ok
    x64.jmp ifcont#2
  ok:
    x64.movRegImm32 r8, 1
    x64.movRegImm32 r10, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.cmpRegImm32 rbx, 1
    x64.jcc equal, slow
    x64.jmp ifcont#4
  slow:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 r10, rax, 1
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegImm32 rax, 1
    x64.leaRegRegImm32 r10, rax, 1
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 2
    x64.leaRegFunc rcx, [rip + mayFail]
    x64.callDirect __gt_spawn
    x64.storeBaseDispReg.word64 [r8 + 192], rbx
    x64.movRegReg rcx, r8
    x64.callDirect __gt_try_await
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRegImm32 rax, r10, -1
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#3
    x64.jmp matchnext
  matcharm#3:
    x64.movRegImm32 r8, 7
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm#4
    x64.jmp matchdead
  matcharm#4:
    x64.movRegImm32 r8, 9
    x64.jmp matchcont
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#12
    x64.jmp __rc_chk#13
  __rc_chk#13:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic#12
    x64.jmp __rc_ok#11
  __rc_panic#12:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#11:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
  tryok:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#9
    x64.jmp __rc_chk#10
  __rc_chk#10:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic#9
    x64.jmp __rc_ok#8
  __rc_panic#9:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#8:
    x64.leaRegRegImm32 r8, r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Runtime.yield {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __gt_resched
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
