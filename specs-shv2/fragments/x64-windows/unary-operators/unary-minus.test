// Test: unary-minus
function main() returns ExitCode
	let x = -42
	let y = -x
	return y
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.movRegImm32 rax, 42
    x64.movRegReg rcx, rax
    x64.negReg rcx
    x64.movRegReg rdx, rcx
    x64.negReg rdx
    x64.movRegReg r8, rdx
    x64.ret
}
