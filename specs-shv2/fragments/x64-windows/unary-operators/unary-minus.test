// Test: unary-minus
function main() returns ExitCode
	let x = -42
	let y = -x
	return y
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 42
    x64.negReg rax, rax
    x64.movRegReg r8, rax
    x64.negReg r8, rax
    x64.popReg rbp
    x64.ret
}
