// Test: chained-error-edge-drops-two-temps
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

function make() returns IntArray
	var arr = IntArray.create()
	arr.push(10)
	arr.push(20)
	arr.push(30)
	return arr
end 'make'

function main() returns ExitCode
	let v = try make().clone().get(9) otherwise return 7
	return v
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @make {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 10
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 20
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 30
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.callDirect make
    x64.movRegReg rbx, r8
    x64.leaRegRdata rdx, [rip + __layout_Array_Integer]
    x64.movRegReg rcx, rbx
    x64.callDirect Array.clone
    x64.movRegReg r12, r8
    x64.movRegImm32 rdx, 9
    x64.loadRegBaseDisp.word64 rax, [r12 + 8]
    x64.cmpRegImm32 rax, 9
    x64.jcc lessEqual, __im_slow
  __im_load:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.leaRegRegImm32 rax, rax, 72
    x64.loadRegBaseDisp.word64 r13, [rax + 0]
    x64.movRegImm32 rax, 0
    x64.loadRegBaseDisp.word64 rcx, [r12 + 40]
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, critsplit#10
  __im_empty:
    x64.cmpRegImm32 r13, 0
    x64.jcc notEqual, critsplit#11
  __im_slow:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_get
    x64.movRegReg r13, r8
    x64.jmp __im_cont
  critsplit#11:
    x64.movRegReg r10, rax
    x64.jmp __im_cont
  critsplit#10:
    x64.movRegReg r10, rax
  __im_cont:
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm32 r13, 7
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r13, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r13, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
