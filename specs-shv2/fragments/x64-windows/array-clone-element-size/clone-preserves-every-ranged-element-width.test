// Test: clone-preserves-every-ranged-element-width
typealias Narrow = int(0 to 16)
typealias Mid = int(0 to 100000)
typealias Wide = int(0 to u64.max)
typealias NarrowCol = Array with Narrow
typealias MidCol = Array with Mid
typealias WideCol = Array with Wide

function main() returns ExitCode
	var n = NarrowCol.create()
	n.push(1)
	n.push(2)
	var m = MidCol.create()
	m.push(3)
	m.push(4)
	var w = WideCol.create()
	w.push(5)
	w.push(6)

	var nc = n.clone()
	var mc = m.clone()
	var wc = w.clone()

	let n0 = try nc.get(0) otherwise 0
	let m0 = try mc.get(0) otherwise 0
	let w0 = try wc.get(0) otherwise 0

	// Mutating a clone must not disturb the original (COW at the element's own stride).
	try nc.set(0, value: 15) otherwise panic("index 0 is in bounds")
	let nOrig = try n.get(0) otherwise 0
	let nClone = try nc.get(0) otherwise 0
	let nNeighbour = try nc.get(1) otherwise 0

	let ok = n0 == 1 and m0 == 3 and w0 == 5 and nOrig == 1 and nClone == 15 and nNeighbour == 2
	return 0 if ok else 1
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 88
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.storeSlotReg slot0, rbx
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rcx, 4
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.storeSlotReg slot1, r12
    x64.movRegImm32 rdx, 3
    x64.movRegReg rcx, r12
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 4
    x64.movRegReg rcx, r12
    x64.callDirect __managed_push
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r13, r8
    x64.storeSlotReg slot2, r13
    x64.movRegImm32 rdx, 5
    x64.movRegReg rcx, r13
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 6
    x64.movRegReg rcx, r13
    x64.callDirect __managed_push
    x64.leaRegRdata rdx, [rip + __layout_Array_Narrow]
    x64.movRegReg rcx, rbx
    x64.callDirect Array.clone
    x64.movRegReg r14, r8
    x64.storeSlotReg slot3, r14
    x64.leaRegRdata rdx, [rip + __layout_Array_Mid]
    x64.movRegReg rcx, r12
    x64.callDirect Array.clone
    x64.movRegReg r12, r8
    x64.storeSlotReg slot4, r12
    x64.leaRegRdata rdx, [rip + __layout_Array_Wide]
    x64.movRegReg rcx, r13
    x64.callDirect Array.clone
    x64.movRegReg r13, r8
    x64.storeSlotReg slot5, r13
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, r14
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 r15, 0
    x64.jmp trycont
  tryok:
    x64.movRegReg r15, r8
    x64.jmp trycont
  trycont:
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, r12
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 r12, 0
    x64.jmp trycont
  tryok:
    x64.movRegReg r12, r8
    x64.jmp trycont
  trycont:
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, r13
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 r13, 0
    x64.jmp trycont
  tryok:
    x64.movRegReg r13, r8
    x64.jmp trycont
  trycont:
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 rax, 15
    x64.movRegReg rcx, r14
    x64.callDirect __managed_set
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_15]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 88
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 rbx, 0
    x64.jmp trycont
  tryok:
    x64.movRegReg rbx, r8
    x64.jmp trycont
  trycont:
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, r14
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 rax, 0
    x64.jmp trycont
  tryok:
    x64.movRegReg rax, r8
    x64.jmp trycont
  trycont:
    x64.storeSlotReg slot6, rax
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, r14
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 rax, 0
    x64.jmp trycont
  tryok:
    x64.movRegReg rax, r8
    x64.jmp trycont
  trycont:
    x64.cmpRegImm32 r15, 1
    x64.movRegImm32 rcx, 0
    x64.jcc equal, andrhs
    x64.jmp critsplit
  andrhs:
    x64.cmpRegImm32 r12, 3
    x64.setccReg equal, rcx
    x64.jmp scmerge
  critsplit:
    x64.jmp scmerge
  scmerge:
    x64.movRegImm32 rdx, 0
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, andrhs
    x64.jmp critsplit
  andrhs:
    x64.cmpRegImm32 r13, 5
    x64.setccReg equal, rcx
    x64.jmp scmerge
  critsplit:
    x64.movRegReg rcx, rdx
    x64.jmp scmerge
  scmerge:
    x64.movRegImm32 rdx, 0
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, andrhs
    x64.jmp critsplit
  andrhs:
    x64.cmpRegImm32 rbx, 1
    x64.setccReg equal, rcx
    x64.jmp scmerge
  critsplit:
    x64.movRegReg rcx, rdx
    x64.jmp scmerge
  scmerge:
    x64.movRegImm32 rdx, 0
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, andrhs
    x64.jmp critsplit
  andrhs:
    x64.loadRegSlot rcx, slot6
    x64.cmpRegImm32 rcx, 15
    x64.setccReg equal, rcx
    x64.jmp scmerge
  critsplit:
    x64.movRegReg rcx, rdx
    x64.jmp scmerge
  scmerge:
    x64.movRegImm32 rdx, 0
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, andrhs
    x64.jmp critsplit
  andrhs:
    x64.cmpRegImm32 rax, 2
    x64.setccReg equal, rax
    x64.jmp scmerge
  critsplit:
    x64.movRegReg rax, rdx
    x64.jmp scmerge
  scmerge:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, ternarytrue
    x64.jmp ternaryfalse
  ternarytrue:
    x64.movRegImm32 rbx, 0
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegImm32 rbx, 1
    x64.jmp matchcont
  matchcont:
    x64.loadRegSlot rcx, slot5
    x64.callDirect __managed_decref
    x64.loadRegSlot rcx, slot4
    x64.callDirect __managed_decref
    x64.loadRegSlot rcx, slot3
    x64.callDirect __managed_decref
    x64.loadRegSlot rcx, slot2
    x64.callDirect __managed_decref
    x64.loadRegSlot rcx, slot1
    x64.callDirect __managed_decref
    x64.loadRegSlot rcx, slot0
    x64.callDirect __managed_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_42]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 88
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 88
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Array.clone {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_count
    x64.movRegReg r13, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_retain
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, rbx
    x64.movRegReg rax, r13
    x64.movRegReg r9, r12
    x64.callDirect __managed_slice_opaque
    x64.movRegReg r12, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.leaRegRdata rcx, [rip + __str_blob_16]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg rcx, r12
    x64.callDirect __mm_retain
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
