// Test: and-skips-rhs-when-lhs-false
function no() returns bool
	return false
end 'no'

function boom() returns bool
	let zero = 0
	let q = 1 / zero
	return q == 0
end 'boom'

function main() returns ExitCode
	if no() and boom() 'never'
		return 1
	end 'never'
	return 0
end 'main'
---
ExitCode: 0
---
func @no {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}

func @boom {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rcx, 0
    x64.movRegImm32 rax, 1
    x64.cqo
    x64.idivReg rcx
    x64.cmpRegImm32 rax, 0
    x64.setccReg equal, r8
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect no
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, andrhs
    x64.jmp critsplit
  andrhs:
    x64.callDirect boom
    x64.jmp scmerge
  critsplit:
    x64.movRegReg r8, rax
    x64.jmp scmerge
  scmerge:
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, never
    x64.jmp ifcont
  never:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
