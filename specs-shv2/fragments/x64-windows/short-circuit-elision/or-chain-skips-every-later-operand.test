// Test: or-chain-skips-every-later-operand
function yes() returns bool
	return true
end 'yes'

function boom() returns bool
	let zero = 0
	let q = 1 / zero
	return q == 0
end 'boom'

function boomAgain() returns bool
	let zero = 0
	let q = 2 / zero
	return q == 0
end 'boomAgain'

function main() returns ExitCode
	if yes() or boom() or boomAgain() 'taken'
		return 5
	end 'taken'
	return 9
end 'main'
---
ExitCode: 5
---
func @yes {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}

func @boom {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rcx, 0
    x64.movRegImm32 rax, 1
    x64.cqo
    x64.idivReg rcx
    x64.cmpRegImm32 rax, 0
    x64.setccReg equal, r8
    x64.popReg rbp
    x64.ret
}

func @boomAgain {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rcx, 0
    x64.movRegImm32 rax, 2
    x64.cqo
    x64.idivReg rcx
    x64.cmpRegImm32 rax, 0
    x64.setccReg equal, r8
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect yes
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, critsplit
    x64.jmp orrhs
  critsplit:
    x64.jmp scmerge
  orrhs:
    x64.callDirect boom
    x64.movRegReg rax, r8
    x64.jmp scmerge
  scmerge:
    x64.movRegImm32 rcx, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, critsplit
    x64.jmp orrhs
  critsplit:
    x64.jmp scmerge
  orrhs:
    x64.callDirect boomAgain
    x64.movRegReg rcx, r8
    x64.jmp scmerge
  scmerge:
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, taken
    x64.jmp ifcont
  taken:
    x64.movRegImm32 r8, 5
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 9
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
