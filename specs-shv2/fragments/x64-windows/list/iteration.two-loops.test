// Test: iteration.two-loops
function main() returns ExitCode
	let list = List from [1, 2, 3]
	var sum1 = 0
	for item in list 'loop1'
		sum1 = sum1 + item
	end 'loop1'
	var sum2 = 0
	for item in list 'loop2'
		sum2 = sum2 + item
	end 'loop2'
	if sum1 == sum2 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rbx, 1
    x64.leaRegRdata rcx, [rip + __layout_List_int]
    x64.callDirect List.create
    x64.movRegReg r12, r8
    x64.leaRegRdata rax, [rip + __layout_List_int]
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect List.append
    x64.movRegImm32 rdx, 2
    x64.leaRegRdata rax, [rip + __layout_List_int]
    x64.movRegReg rcx, r12
    x64.callDirect List.append
    x64.movRegImm32 rdx, 3
    x64.leaRegRdata rax, [rip + __layout_List_int]
    x64.movRegReg rcx, r12
    x64.callDirect List.append
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r12
    x64.callDirect List.createIterator
    x64.movRegReg r13, r8
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, critsplit#15
    x64.jmp forempty#2
  critsplit#15:
    x64.jmp forhdr#1
  forhdr#1:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, loop1
    x64.jmp forexit#5
  loop1:
    x64.leaRegRdata rdx, [rip + __layout_ListIterator_int]
    x64.movRegReg rcx, r13
    x64.callDirect ListIterator.current
    x64.leaRegRegReg rbx, rbx, r8
    x64.jmp forstep#4
  forstep#4:
    x64.movRegReg rcx, r13
    x64.callDirect ListIterator.advance
    x64.movRegReg rax, r10
    x64.jmp forhdr#1
  forexit#5:
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_ListIterator_int
    x64.jmp forjoin#6
  forempty#2:
    x64.jmp forjoin#6
  forjoin#6:
    x64.movRegImm32 r13, 0
    x64.movRegReg rcx, r12
    x64.callDirect List.createIterator
    x64.movRegReg r14, r8
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, critsplit#16
    x64.jmp forempty#8
  critsplit#16:
    x64.jmp forhdr#7
  forhdr#7:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, loop2
    x64.jmp forexit#11
  loop2:
    x64.leaRegRdata rdx, [rip + __layout_ListIterator_int]
    x64.movRegReg rcx, r14
    x64.callDirect ListIterator.current
    x64.leaRegRegReg r13, r13, r8
    x64.jmp forstep#10
  forstep#10:
    x64.movRegReg rcx, r14
    x64.callDirect ListIterator.advance
    x64.movRegReg rax, r10
    x64.jmp forhdr#7
  forexit#11:
    x64.movRegReg rcx, r14
    x64.callDirect __destruct_ListIterator_int
    x64.movRegReg rax, r13
    x64.jmp forjoin#12
  forempty#8:
    x64.movRegReg rax, r13
    x64.jmp forjoin#12
  forjoin#12:
    x64.cmpRegReg rbx, rax
    x64.jcc equal, check
    x64.jmp ifcont
  check:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_List_int
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rbx, 1
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_List_int
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @List.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.loadRegBaseDisp.word64 rcx, [rcx + 40]
    x64.callDirect __list_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @List.append {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callDirect __list_append
    x64.epilogue 32
    x64.popReg rbp
