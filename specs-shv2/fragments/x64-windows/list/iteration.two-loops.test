// Test: iteration.two-loops
function main() returns ExitCode
	let list = List from [1, 2, 3]
	var sum1 = 0
	for item in list 'loop1'
		sum1 = sum1 + item
	end 'loop1'
	var sum2 = 0
	for item in list 'loop2'
		sum2 = sum2 + item
	end 'loop2'
	if sum1 == sum2 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rcx, 48
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg rbx, r8
    x64.leaRegRdata rax, [rip + __barr_blob_0]
    x64.storeBaseDispReg.word64 [rbx + 0], rax
    x64.movRegImm32 rax, 3
    x64.storeBaseDispReg.word64 [rbx + 8], rax
    x64.movRegImm rax, -2
    x64.storeBaseDispReg.word64 [rbx + 16], rax
    x64.movRegImm32 rax, 8
    x64.storeBaseDispReg.word64 [rbx + 24], rax
    x64.movRegReg rcx, rbx
    x64.callDirect __list_from
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r12
    x64.callDirect __list_head
    x64.movRegReg r13, rbx
    x64.movRegReg rbx, r8
    x64.jmp forhdr#1
  forhdr#1:
    x64.cmpRegImm32 rbx, 0
    x64.jcc notEqual, loop1
    x64.jmp forexit#4
  loop1:
    x64.movRegReg rcx, rbx
    x64.callDirect __list_node_value
    x64.leaRegRegReg r13, r13, r8
    x64.jmp forstep#3
  forstep#3:
    x64.movRegReg rcx, rbx
    x64.callDirect __list_node_next
    x64.movRegReg rbx, r8
    x64.jmp forhdr#1
  forexit#4:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r12
    x64.callDirect __list_head
    x64.movRegReg r14, rbx
    x64.movRegReg rbx, r8
    x64.jmp forhdr#5
  forhdr#5:
    x64.cmpRegImm32 rbx, 0
    x64.jcc notEqual, loop2
    x64.jmp forexit#8
  loop2:
    x64.movRegReg rcx, rbx
    x64.callDirect __list_node_value
    x64.leaRegRegReg r14, r14, r8
    x64.jmp forstep#7
  forstep#7:
    x64.movRegReg rcx, rbx
    x64.callDirect __list_node_next
    x64.movRegReg rbx, r8
    x64.jmp forhdr#5
  forexit#8:
    x64.cmpRegReg r13, r14
    x64.jcc equal, check
    x64.jmp ifcont
  check:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r12
    x64.callDirect __list_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rbx, 1
    x64.movRegReg rcx, r12
    x64.callDirect __list_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
