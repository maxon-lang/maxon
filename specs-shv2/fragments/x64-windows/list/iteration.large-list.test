// Test: iteration.large-list
typealias Integer = int(i64.min to i64.max)
typealias IntList = List with Integer

function main() returns ExitCode
	var list = IntList.create()
	for i in 1 to 100 'build'
		list.append(i)
	end 'build'
	var sum = 0
	for item in list 'loop'
		sum = sum + item
	end 'loop'
	return sum - 5050
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 0
    x64.callDirect __list_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 1
    x64.jmp forhdr#1
  forhdr#1:
    x64.cmpRegImm32 r12, 100
    x64.jcc lessEqual, build
    x64.jmp forexit#4
  build:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __list_append
    x64.jmp forstep#3
  forstep#3:
    x64.leaRegRegImm32 r12, r12, 1
    x64.jmp forhdr#1
  forexit#4:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __list_head
    x64.movRegReg r13, r12
    x64.movRegReg r12, r8
    x64.jmp forhdr#5
  forhdr#5:
    x64.cmpRegImm32 r12, 0
    x64.jcc notEqual, loop
    x64.jmp forexit#8
  loop:
    x64.movRegReg rcx, r12
    x64.callDirect __list_node_value
    x64.leaRegRegReg r13, r13, r8
    x64.jmp forstep#7
  forstep#7:
    x64.movRegReg rcx, r12
    x64.callDirect __list_node_next
    x64.movRegReg r12, r8
    x64.jmp forhdr#5
  forexit#8:
    x64.leaRegRegImm32 r12, r13, -5050
    x64.movRegReg rcx, rbx
    x64.callDirect __list_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
