// Test: generic-module-merge
typealias Count = int(0 to u64.max)
typealias Integer = int(i64.min to i64.max)

interface Mergeable uses Func
	function itemCount() returns Count
	function getItem(index Count) returns Func
	function pushItem(item Func)
	function opsCount() returns Count
	function appendOps(source Self)
	function cloneItem(src Func) returns Func
end 'Mergeable'

extension Mergeable
	export function merge(source Self)
		self.appendOps(source)
		for i in 0 upto source.itemCount() 'eachItem'
			let src = source.getItem(i)
			let copy = self.cloneItem(src)
			self.pushItem(copy)
		end 'eachItem'
	end 'merge'
end 'Mergeable'

type Wrapper
	export var value as Integer
	export static function create(value Integer) returns Self
		return Self{value: value}
	end 'create'
end 'Wrapper'

typealias WrapperArray = Array with Wrapper

type Container uses Op implements Mergeable with Wrapper
	typealias OpArray = Array with Op

	export var ops as OpArray
	export var items as WrapperArray

	export static function create() returns Self
		return Self{
			ops: OpArray.create(),
			items: WrapperArray.create()
		}
	end 'create'

	export function opsCount() returns Count
		return self.ops.count()
	end 'opsCount'

	export function appendOps(source Self)
		self.ops.append(source.ops)
	end 'appendOps'

	export function itemCount() returns Count
		return self.items.count()
	end 'itemCount'

	export function getItem(index Count) returns Wrapper
		return try self.items.get(index) otherwise 'unreachable'
			panic("getItem: index out of bounds")
		end 'unreachable'
	end 'getItem'

	export function pushItem(item Wrapper)
		self.items.push(item)
	end 'pushItem'

	export function cloneItem(src Wrapper) returns Wrapper
		return Wrapper.create(src.value)
	end 'cloneItem'

	export function pushOp(op Op)
		self.ops.push(op)
	end 'pushOp'
end 'Container'

typealias IntContainer = Container with Integer

typealias ExitCode = int(0 to 125)

function main() returns ExitCode
	var a = IntContainer.create()
	a.pushOp(10)
	a.pushOp(20)
	a.pushItem(Wrapper.create(99))

	var b = IntContainer.create()
	b.merge(a)

	if b.opsCount() == 2 and b.itemCount() == 1 'check'
		let item = b.getItem(0)
		if item.value == 99 'valueCheck'
			return 0
		end 'valueCheck'
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Container.merge {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 56
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegReg r13, rax
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.movRegReg rax, r13
    x64.callDirect Container.appendOps
    x64.movRegImm32 rdx, 0
  __il_body:
    x64.loadRegBaseDisp.word64 rax, [r12 + 8]
    x64.loadRegBaseDisp.word64 r14, [rax + 8]
  forhdr:
    x64.storeSlotReg slot0, rdx
    x64.cmpRegReg rdx, r14
    x64.jcc greaterEqual, forexit
  eachItem:
    x64.movRegReg rcx, r12
    x64.movRegReg rax, r13
    x64.callDirect Container.getItem
    x64.storeSlotReg slot1, r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect Container.cloneItem
    x64.movRegReg r15, r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r15
    x64.movRegReg rax, r13
    x64.callDirect Container.pushItem
    x64.movRegReg rcx, r15
    x64.callDirect __mm_decref
    x64.loadRegSlot rcx, slot1
    x64.callDirect __mm_decref
  forstep:
    x64.loadRegSlot rax, slot0
    x64.leaRegRegImm32 rdx, rax, 1
    x64.jmp forhdr
  forexit:
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Wrapper.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Container.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rax, 8
    x64.loadRegBaseDisp.word64 rdx, [rcx + 40]
    x64.movRegReg rcx, rax
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __mm_decref]
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.storeBaseDispReg.word64 [r8 + 8], r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Container.appendOps {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.loadRegBaseDisp.word64 rdx, [rdx + 0]
    x64.callDirect __managed_append_opaque
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @Container.getItem {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rcx, [rcx + 8]
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.cmpRegReg rdx, rax
    x64.jcc aboveEqual, __im_slow
  __im_load:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseIndexScale.word64 rax, [rax + rdx*8 + 0]
    x64.movRegImm32 rsi, 0
    x64.loadRegBaseDisp.word64 rdi, [rcx + 40]
    x64.cmpRegImm32 rdi, 0
    x64.jcc equal, critsplit#7
  __im_empty:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, critsplit#8
  __im_slow:
    x64.callDirect __managed_get
    x64.movRegReg rcx, r8
    x64.jmp __im_cont
  critsplit#8:
    x64.movRegReg rcx, rax
    x64.movRegReg r10, rsi
    x64.jmp __im_cont
  critsplit#7:
    x64.movRegReg rcx, rax
    x64.movRegReg r10, rsi
  __im_cont:
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  tryok:
    x64.callDirect __mm_retain
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @Container.pushItem {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rdx
    x64.loadRegBaseDisp.word64 r12, [rcx + 8]
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect __managed_push
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Container.cloneItem {
