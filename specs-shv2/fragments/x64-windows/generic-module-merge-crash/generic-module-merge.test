}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.leaRegRdata rcx, [rip + __layout_Container_Integer]
    x64.callDirect Container.create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 10
    x64.leaRegRdata rax, [rip + __layout_Container_Integer]
    x64.movRegReg rcx, rbx
    x64.callDirect Container.pushOp
    x64.movRegImm32 rdx, 20
    x64.leaRegRdata rax, [rip + __layout_Container_Integer]
    x64.movRegReg rcx, rbx
    x64.callDirect Container.pushOp
    x64.movRegImm32 rcx, 99
    x64.callDirect Wrapper.create
    x64.movRegReg r12, r8
    x64.leaRegRdata rax, [rip + __layout_Container_Integer]
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect Container.pushItem
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.leaRegRdata rcx, [rip + __layout_Container_Integer]
    x64.callDirect Container.create
    x64.movRegReg r12, r8
    x64.leaRegRdata rax, [rip + __layout_Container_Integer]
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect Container.merge
  __il_body#8:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
  __il_cont#7:
    x64.cmpRegImm32 rax, 2
    x64.movRegImm32 rax, 0
    x64.jcc notEqual, scmerge
  __il_body#10:
    x64.loadRegBaseDisp.word64 rax, [r12 + 8]
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
  __il_cont#9:
    x64.cmpRegImm32 rax, 1
    x64.setccReg equal, rax
  scmerge:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont#6
  check:
    x64.movRegImm32 rdx, 0
    x64.leaRegRdata rax, [rip + __layout_Container_Integer]
    x64.movRegReg rcx, r12
    x64.callDirect Container.getItem
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.cmpRegImm32 rax, 99
    x64.jcc notEqual, ifcont#5
  valueCheck:
    x64.movRegImm32 r13, 0
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Container_Integer
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Container_Integer
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#5:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
  ifcont#6:
    x64.movRegImm32 r13, 1
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Container_Integer
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Container_Integer
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
