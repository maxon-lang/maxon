func @StringBuilder.appendBytes {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rax
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.callDirect __managed_append
    x64.xorRegImm32 r12, r12, 1
    x64.cmpRegImm32 r12, 0
    x64.jcc notEqual, clearFlag
    x64.jmp ifcont
  clearFlag:
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.byte [rbx + 8], rax
    x64.jmp ifcont
  ifcont:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @StringBuilder.build {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
