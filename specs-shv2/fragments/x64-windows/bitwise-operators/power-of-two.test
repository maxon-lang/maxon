// Test: power-of-two
function main() returns ExitCode
	// Calculate 2^n using shift
	let n = 5
	return 1 shl n        // 32
end 'main'
---
ExitCode: 32
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 1
    x64.shlRegImm8 r8, r8, 5
    x64.popReg rbp
    x64.ret
}
