// Test: an-and-result-is-no-proof-of-a-low-bound-above-zero
typealias Small = int(1 to 100)
typealias Num = int(i64.min to i64.max)

function guarded(a Small, b Small) returns Num
	return try (100 / (a and b)) otherwise 7
end 'guarded'

function main() returns ExitCode
	if guarded(1, b: 2) != 7 'zeroIsCaught'
		return 1
	end 'zeroIsCaught'
	return 42
end 'main'
---
ExitCode: 42
---
func @guarded {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 1
    x64.jcc less, __rc_panic#5
  __rc_chk#6:
    x64.cmpRegImm32 rcx, 100
    x64.jcc lessEqual, __rc_ok#4
  __rc_panic#5:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at an-and-result-is-no-proof-of-a-low-bound-above-zero.test:5: Range check failed: value outside typealias 'Small'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#4:
    x64.cmpRegImm32 rdx, 1
    x64.jcc less, __rc_panic#8
  __rc_chk#9:
    x64.cmpRegImm32 rdx, 100
    x64.jcc lessEqual, __rc_ok#7
  __rc_panic#8:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at an-and-result-is-no-proof-of-a-low-bound-above-zero.test:5: Range check failed: value outside typealias 'Small'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#7:
    x64.movRegImm32 rax, 100
    x64.andRegReg rcx, rcx, rdx
    x64.cmpRegImm32 rcx, 0
    x64.setccReg equal, rsi
    x64.orRegReg rcx, rcx, rsi
    x64.cqo
    x64.idivReg rcx
    x64.cmpRegImm32 rsi, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm32 r8, 7
    x64.jmp trycont
  tryok:
    x64.movRegReg r8, rax
  trycont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 2
    x64.callDirect guarded
    x64.cmpRegImm32 r8, 7
    x64.jcc equal, ifcont
  zeroIsCaught:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 42
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
