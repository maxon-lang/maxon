// Test: shift-ranged-operand-is-64-bit
typealias I32 = int(-2147483648 to 2147483647)
typealias U32 = int(0 to 4294967295)
typealias Num = int(i64.min to i64.max)

function shlBy(v Num, d Num) returns Num
	return v shl d
end 'shlBy'

function shrBy(v Num, d Num) returns Num
	return v shr d
end 'shrBy'

function main() returns ExitCode
	// NARROW SIGNED. The shift moves bits out of the declared type's width; that is legal, and the
	// answer needs all 64.
	let narrow = 0 - 8 as I32
	if narrow shl 29 != shlBy(0 - 8, d: 29) 'signedFoldVsEmitted'
		return 1
	end 'signedFoldVsEmitted'
	if narrow shl 29 != 0 - 4294967296 'signedValue'
		return 2
	end 'signedValue'

	// A count above the narrow type's width. A 32-bit shift instruction takes its count mod 32, so
	// `shr 33` would have quietly become `shr 1`.
	if narrow shr 33 != shrBy(0 - 8, d: 33) 'signedCountFoldVsEmitted'
		return 3
	end 'signedCountFoldVsEmitted'
	if narrow shr 33 != 0 - 1 'signedCountValue'
		return 4
	end 'signedCountValue'

	// NARROW UNSIGNED. Zero-filling, and still 64 bits wide.
	let wide = 4294967295 as U32
	if wide shl 33 != shlBy(4294967295, d: 33) 'unsignedFoldVsEmitted'
		return 5
	end 'unsignedFoldVsEmitted'
	if wide shr 4 != shrBy(4294967295, d: 4) 'unsignedShrFoldVsEmitted'
		return 6
	end 'unsignedShrFoldVsEmitted'
	if wide shr 4 != 268435455 'unsignedShrValue'
		return 7
	end 'unsignedShrValue'

	// A bare `int`, which never narrowed and so was always right. Here to show the ranged cases now
	// agree with it rather than merely with each other.
	let plain = 0 - 8 as Num
	if plain shl 29 != narrow shl 29 'rangedAgreesWithPlain'
		return 8
	end 'rangedAgreesWithPlain'

	return 42
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 rax, rax, -8
    x64.movRegReg rcx, rax
    x64.shlRegImm8 rcx, rax, 29
    x64.movRegImm32 rdx, 0
    x64.leaRegRegImm32 rdx, rdx, -8
    x64.movRegImm32 rsi, 29
    x64.jmp __il_body#18
  __il_body#18:
    x64.andRegImm32 rsi, rsi, -64
    x64.movRegReg rdi, rsi
    x64.negReg rdi, rsi
    x64.orRegReg rsi, rsi, rdi
    x64.sarRegImm8 rsi, rsi, 63
    x64.shlRegImm8 rdx, rdx, 29
    x64.notReg rsi, rsi
    x64.andRegReg rdx, rdx, rsi
    x64.jmp __il_cont#17
  __il_cont#17:
    x64.cmpRegReg rcx, rdx
    x64.jcc notEqual, signedFoldVsEmitted
    x64.jmp ifcont#2
  signedFoldVsEmitted:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegReg rcx, rax
    x64.shlRegImm8 rcx, rax, 29
    x64.movRegImm32 rdx, 0
    x64.movRegImm rsi, 4294967296
    x64.subRegReg rdx, rdx, rsi
    x64.cmpRegReg rcx, rdx
    x64.jcc notEqual, signedValue
    x64.jmp ifcont#4
  signedValue:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegReg rdx, rax
    x64.sarRegImm8 rdx, rax, 33
    x64.movRegImm32 rcx, 0
    x64.leaRegRegImm32 rsi, rcx, -8
    x64.movRegImm32 rcx, 33
    x64.jmp __il_body#20
  __il_body#20:
    x64.andRegImm32 rcx, rcx, -64
    x64.movRegReg rdi, rcx
    x64.negReg rdi, rcx
    x64.orRegReg rcx, rcx, rdi
    x64.sarRegImm8 rcx, rcx, 63
    x64.orRegImm32 rcx, rcx, 33
    x64.sarRegCl rsi, rsi
    x64.jmp __il_cont#19
  __il_cont#19:
    x64.cmpRegReg rdx, rsi
    x64.jcc notEqual, signedCountFoldVsEmitted
    x64.jmp ifcont#6
  signedCountFoldVsEmitted:
    x64.movRegImm32 r8, 3
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.movRegReg rcx, rax
    x64.sarRegImm8 rcx, rax, 33
    x64.movRegImm32 rdx, 0
    x64.leaRegRegImm32 rdx, rdx, -1
    x64.cmpRegReg rcx, rdx
    x64.jcc notEqual, signedCountValue
    x64.jmp ifcont#8
  signedCountValue:
    x64.movRegImm32 r8, 4
    x64.popReg rbp
    x64.ret
  ifcont#8:
    x64.movRegImm32 rdx, 4294967295
    x64.movRegReg rcx, rdx
    x64.shlRegImm8 rcx, rdx, 33
    x64.movRegImm32 rsi, 4294967295
    x64.movRegImm32 rdi, 33
    x64.jmp __il_body#22
  __il_body#22:
    x64.andRegImm32 rdi, rdi, -64
    x64.movRegReg r8, rdi
    x64.negReg r8, rdi
    x64.orRegReg rdi, rdi, r8
    x64.sarRegImm8 rdi, rdi, 63
    x64.shlRegImm8 rsi, rsi, 33
    x64.notReg rdi, rdi
    x64.andRegReg rsi, rsi, rdi
    x64.jmp __il_cont#21
  __il_cont#21:
    x64.cmpRegReg rcx, rsi
    x64.jcc notEqual, unsignedFoldVsEmitted
    x64.jmp ifcont#10
  unsignedFoldVsEmitted:
    x64.movRegImm32 r8, 5
    x64.popReg rbp
    x64.ret
  ifcont#10:
    x64.movRegReg rsi, rdx
    x64.shrRegImm8 rsi, rdx, 4
    x64.movRegImm32 rdi, 4294967295
    x64.movRegImm32 rcx, 4
    x64.jmp __il_body#24
  __il_body#24:
    x64.andRegImm32 rcx, rcx, -64
    x64.movRegReg r8, rcx
    x64.negReg r8, rcx
    x64.orRegReg rcx, rcx, r8
    x64.sarRegImm8 rcx, rcx, 63
    x64.orRegImm32 rcx, rcx, 4
    x64.sarRegCl rdi, rdi
    x64.jmp __il_cont#23
  __il_cont#23:
    x64.cmpRegReg rsi, rdi
    x64.jcc notEqual, unsignedShrFoldVsEmitted
    x64.jmp ifcont#12
  unsignedShrFoldVsEmitted:
    x64.movRegImm32 r8, 6
    x64.popReg rbp
    x64.ret
  ifcont#12:
    x64.shrRegImm8 rdx, rdx, 4
    x64.cmpRegImm32 rdx, 268435455
    x64.jcc notEqual, unsignedShrValue
    x64.jmp ifcont#14
  unsignedShrValue:
    x64.movRegImm32 r8, 7
    x64.popReg rbp
    x64.ret
  ifcont#14:
    x64.movRegImm32 rcx, 0
    x64.leaRegRegImm32 rcx, rcx, -8
    x64.shlRegImm8 rcx, rcx, 29
    x64.shlRegImm8 rax, rax, 29
    x64.cmpRegReg rcx, rax
    x64.jcc notEqual, rangedAgreesWithPlain
    x64.jmp ifcont#16
  rangedAgreesWithPlain:
    x64.movRegImm32 r8, 8
    x64.popReg rbp
    x64.ret
  ifcont#16:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
}
