// Test: logical-or-and-on-bool-fields
typealias Tag = int(0 to 100)

type Flags
	export var a as bool
	export var b as bool
	export var c as bool

	export static function make(a bool, b bool, c bool) returns Flags
		return Flags{a: a, b: b, c: c}
	end 'make'
end 'Flags'

function consume(flag bool) returns Tag
	if flag 'isTrue'
		return 1
	end 'isTrue'
	return 0
end 'consume'

function main() returns ExitCode
	let f = Flags.make(true, b: false, c: true)
	let orResult = consume(f.a or f.b)
	let andResult = consume(f.a and f.c)
	let bothFalse = consume(f.b or f.b)
	return orResult * 4 + andResult * 2 + bothFalse
end 'main'
---
ExitCode: 6
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Flags.make {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegReg r13, rax
    x64.movRegImm32 rcx, 24
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.byte [r8 + 0], rbx
    x64.storeBaseDispReg.byte [r8 + 8], r12
    x64.storeBaseDispReg.byte [r8 + 16], r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 rax, 1
    x64.callDirect Flags.make
    x64.loadRegBaseDisp.byte rax, [r8 + 0]
    x64.movRegImm32 rcx, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, __il_body#11
  orrhs#1:
    x64.loadRegBaseDisp.byte rax, [r8 + 8]
    x64.movRegReg rcx, rax
  __il_body#11:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, ifcont#13
  isTrue#12:
    x64.movRegImm32 rax, 1
    x64.jmp __il_cont#10
  ifcont#13:
    x64.movRegImm32 rax, 0
  __il_cont#10:
    x64.loadRegBaseDisp.byte rcx, [r8 + 0]
    x64.movRegImm32 rdx, 0
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, critsplit
  andrhs:
    x64.loadRegBaseDisp.byte rcx, [r8 + 16]
    x64.jmp __il_body#15
  critsplit:
    x64.movRegReg rcx, rdx
  __il_body#15:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, ifcont#17
  isTrue#16:
    x64.movRegImm32 rcx, 1
    x64.jmp __il_cont#14
  ifcont#17:
    x64.movRegImm32 rcx, 0
  __il_cont#14:
    x64.loadRegBaseDisp.byte rdx, [r8 + 8]
    x64.movRegImm32 rsi, 1
    x64.cmpRegImm32 rdx, 0
    x64.jcc notEqual, __il_body#19
  orrhs#5:
    x64.loadRegBaseDisp.byte rdx, [r8 + 8]
    x64.movRegReg rsi, rdx
  __il_body#19:
    x64.cmpRegImm32 rsi, 0
    x64.jcc equal, ifcont#21
  isTrue#20:
    x64.movRegImm32 rdx, 1
    x64.jmp __il_cont#18
  ifcont#21:
    x64.movRegImm32 rdx, 0
  __il_cont#18:
    x64.imulRegRegImm32 rax, rax, 4
    x64.imulRegRegImm32 rcx, rcx, 2
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegRegReg rbx, rax, rdx
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
