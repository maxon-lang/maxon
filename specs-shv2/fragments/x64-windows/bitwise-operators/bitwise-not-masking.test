// Test: bitwise-not-masking
function main() returns ExitCode
	let value = 125    // 0x7D
	// Clear lower 4 bits: 125 and not 15 = 112
	return value and not 15
end 'main'
---
ExitCode: 112
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 112
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
