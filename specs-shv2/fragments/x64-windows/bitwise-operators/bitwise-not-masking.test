// Test: bitwise-not-masking
function main() returns ExitCode
	let value = 125    // 0x7D
	// Clear lower 4 bits: 125 and not 15 = 112
	return value and not 15
end 'main'
---
ExitCode: 112
---
func @main {
  entry:
    x64.movRegImm32 rax, 15
    x64.notReg rax, rax
    x64.movRegReg r8, rax
    x64.andRegImm32 r8, rax, 125
    x64.ret
}
