// Test: a-count-whose-alias-reaches-64-keeps-the-guard
typealias Num = int(i64.min to i64.max)
typealias Word = int(0 to u64.max)
typealias UpTo64 = int(0 to 64)

function shlBy(value Num, n UpTo64) returns Num
	return value shl n
end 'shlBy'

function shrBy(value Num, n UpTo64) returns Num
	return value shr n
end 'shrBy'

function shrWordBy(value Word, n UpTo64) returns Word
	return value shr n
end 'shrWordBy'

function widen(step Num) returns UpTo64
	return (step * 64) as UpTo64
end 'widen'

function main() returns ExitCode
	let past = widen(1)

	if shlBy(7, n: past) != 0 'shl'
		return 1
	end 'shl'
	if shrBy(0 - 1, n: past) != 0 - 1 'shrSign'
		return 2
	end 'shrSign'
	if shrWordBy(u64.max, n: past) != 0 'shrZeroFill'
		return 3
	end 'shrZeroFill'

	return 42
end 'main'
---
ExitCode: 42
---
func @shlBy {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegReg rax, rcx
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rdx, 64
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, rdx
    x64.andRegImm32 rcx, rdx, -64
    x64.movRegReg rsi, rcx
    x64.negReg rsi, rcx
    x64.orRegReg rcx, rcx, rsi
    x64.movRegReg rsi, rcx
    x64.sarRegImm8 rsi, rcx, 63
    x64.movRegReg rcx, rdx
    x64.shlRegCl rax, rax
    x64.notReg rsi, rsi
    x64.movRegReg r8, rax
    x64.andRegReg r8, rax, rsi
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

