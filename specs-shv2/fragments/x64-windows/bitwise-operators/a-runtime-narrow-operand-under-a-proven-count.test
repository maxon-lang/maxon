// Test: a-runtime-narrow-operand-under-a-proven-count
typealias Num = int(i64.min to i64.max)
typealias Byte = int(0 to u8.max)
typealias Bits = int(0 to 63)

function shlByteByBits(b Byte, n Bits) returns Num
	return b shl n
end 'shlByteByBits'

function shrByteByBits(b Byte, n Bits) returns Num
	return b shr n
end 'shrByteByBits'

function byteOf(step Num) returns Byte
	return (step * 100) as Byte
end 'byteOf'

function bitsOf(step Num) returns Bits
	return (step * 5) as Bits
end 'bitsOf'

function main() returns ExitCode
	if shlByteByBits(byteOf(2), n: bitsOf(2)) != 204800 'shl'
		return 1
	end 'shl'
	if shrByteByBits(byteOf(2), n: bitsOf(0)) != 200 'shrZero'
		return 2
	end 'shrZero'
	if shrByteByBits(byteOf(2), n: bitsOf(1)) != 6 'shr'
		return 3
	end 'shr'

	return 42
end 'main'
---
ExitCode: 42
---
func @shlByteByBits {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegReg r8, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#2
    x64.jmp __rc_chk#3
  __rc_chk#3:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic#2
    x64.jmp __rc_ok#1
  __rc_panic#2:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#1:
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __rc_panic#5
    x64.jmp __rc_chk#6
  __rc_chk#6:
    x64.cmpRegImm32 rdx, 63
    x64.jcc greater, __rc_panic#5
    x64.jmp __rc_ok#4
  __rc_panic#5:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#4:
    x64.movRegReg rcx, rdx
    x64.shlRegCl r8, r8
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

