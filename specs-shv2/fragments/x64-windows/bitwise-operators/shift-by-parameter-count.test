// Test: shift-by-parameter-count
function shiftLeft(value ExitCode, count ExitCode) returns ExitCode
	return value shl count
end 'shiftLeft'

function main() returns ExitCode
	return shiftLeft(7, count: 65)
end 'main'
---
ExitCode: 14
---
func @shiftLeft {
  entry:
    x64.movRegReg r8, rcx
    x64.movRegReg rcx, rdx
    x64.shlRegCl r8, r8
    x64.ret
}

func @main {
  entry:
    x64.prologue 40
    x64.movRegImm32 rcx, 7
    x64.movRegImm32 rdx, 65
    x64.callDirect shiftLeft
    x64.epilogue 40
    x64.ret
}
