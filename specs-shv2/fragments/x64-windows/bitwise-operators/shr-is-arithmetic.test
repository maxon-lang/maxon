// Test: shr-is-arithmetic
function main() returns ExitCode
	let neg = 0 - 8
	if neg shr 60 != 0 - 1 'sixtyWrong'
		return 1
	end 'sixtyWrong'
	if neg shr 1 != 0 - 4 'oneWrong'
		return 2
	end 'oneWrong'
	return 42
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 rax, rax, -8
    x64.movRegReg rcx, rax
    x64.sarRegImm8 rcx, rax, 60
    x64.movRegImm32 rdx, 0
    x64.leaRegRegImm32 rdx, rdx, -1
    x64.cmpRegReg rcx, rdx
    x64.jcc equal, ifcont#2
  sixtyWrong:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.sarRegImm8 rax, rax, 1
    x64.movRegImm32 rcx, 0
    x64.leaRegRegImm32 rcx, rcx, -4
    x64.cmpRegReg rax, rcx
    x64.jcc equal, ifcont#4
  oneWrong:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
}
