// Test: shr-is-arithmetic
function main() returns ExitCode
	let neg = -8
	if neg shr 60 != -1 'sixtyWrong'
		return 1
	end 'sixtyWrong'
	if neg shr 1 != -4 'oneWrong'
		return 2
	end 'oneWrong'
	return 42
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  ifcont:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
}
