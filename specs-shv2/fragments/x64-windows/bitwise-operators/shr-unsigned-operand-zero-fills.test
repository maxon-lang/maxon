// Test: shr-unsigned-operand-zero-fills
typealias Wide = int(0 to u64.max)
typealias Num = int(i64.min to i64.max)

function shrConst(v Wide) returns Wide
	return v shr 60
end 'shrConst'

function shrDynamic(v Wide, d Num) returns Wide
	return v shr d
end 'shrDynamic'

function shrPastWidth(v Wide) returns Wide
	return v shr 64
end 'shrPastWidth'

function main() returns ExitCode
	// An UNSIGNED left operand zero-fills. Folded count, then a count the compiler cannot see.
	if shrConst(u64.max) != 15 'foldedCount'
		return 1
	end 'foldedCount'
	if shrDynamic(u64.max, d: 60) != 15 'dynamicCount'
		return 2
	end 'dynamicCount'

	// Zero-filling, so shifting every bit out leaves 0 — NOT the sign, and NOT the masked shift
	// the hardware would have performed.
	if shrPastWidth(u64.max) != 0 'foldedPastWidth'
		return 3
	end 'foldedPastWidth'
	if shrDynamic(u64.max, d: 100) != 0 'dynamicPastWidth'
		return 4
	end 'dynamicPastWidth'

	// A count of 0 is the identity, under either fill.
	if shrDynamic(u64.max, d: 0) != u64.max 'zeroCount'
		return 5
	end 'zeroCount'

	return 42
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm rax, 18446744073709551615
    x64.jmp __il_body#12
  __il_body#12:
    x64.shrRegImm8 rax, rax, 60
    x64.jmp __il_cont#11
  __il_cont#11:
    x64.cmpRegImm32 rax, 15
    x64.jcc notEqual, foldedCount
    x64.jmp ifcont#2
  foldedCount:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegImm rax, 18446744073709551615
    x64.movRegImm32 rcx, 60
    x64.jmp __il_body#14
  __il_body#14:
    x64.andRegImm32 rcx, rcx, -64
    x64.movRegReg rdx, rcx
    x64.negReg rdx, rcx
    x64.orRegReg rcx, rcx, rdx
    x64.sarRegImm8 rcx, rcx, 63
    x64.shrRegImm8 rax, rax, 60
    x64.notReg rcx, rcx
    x64.andRegReg rax, rax, rcx
    x64.jmp __il_cont#13
  __il_cont#13:
    x64.cmpRegImm32 rax, 15
    x64.jcc notEqual, dynamicCount
    x64.jmp ifcont#4
  dynamicCount:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.jmp __il_body#16
  __il_body#16:
    x64.movRegImm32 rax, 0
    x64.jmp __il_cont#15
  __il_cont#15:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, foldedPastWidth
    x64.jmp ifcont#6
  foldedPastWidth:
    x64.movRegImm32 r8, 3
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.movRegImm rax, 18446744073709551615
    x64.movRegImm32 rcx, 100
    x64.jmp __il_body#18
  __il_body#18:
    x64.movRegReg rdx, rcx
    x64.andRegImm32 rdx, rcx, -64
    x64.movRegReg rsi, rdx
    x64.negReg rsi, rdx
    x64.orRegReg rdx, rdx, rsi
    x64.sarRegImm8 rdx, rdx, 63
    x64.shrRegCl rax, rax
    x64.notReg rdx, rdx
    x64.andRegReg rax, rax, rdx
    x64.jmp __il_cont#17
  __il_cont#17:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, dynamicPastWidth
    x64.jmp ifcont#8
  dynamicPastWidth:
    x64.movRegImm32 r8, 4
    x64.popReg rbp
    x64.ret
  ifcont#8:
    x64.movRegImm rax, 18446744073709551615
    x64.movRegImm32 rcx, 0
    x64.jmp __il_body#20
  __il_body#20:
    x64.andRegImm32 rcx, rcx, -64
    x64.movRegReg rdx, rcx
    x64.negReg rdx, rcx
    x64.orRegReg rcx, rcx, rdx
    x64.sarRegImm8 rcx, rcx, 63
    x64.notReg rcx, rcx
    x64.andRegReg rax, rax, rcx
    x64.jmp __il_cont#19
  __il_cont#19:
    x64.cmpRegImm32 rax, -1
    x64.jcc notEqual, zeroCount
    x64.jmp ifcont#10
  zeroCount:
    x64.movRegImm32 r8, 5
    x64.popReg rbp
    x64.ret
  ifcont#10:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
