// Test: shift-by-variable-count
function main() returns ExitCode
	let a = 7
	let count = 64
	if a shl count != 0 'wrong'
		return 1
	end 'wrong'
	return 42
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  ifcont:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
}
