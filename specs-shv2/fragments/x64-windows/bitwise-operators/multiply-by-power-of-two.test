// Test: multiply-by-power-of-two
function main() returns ExitCode
	// Multiply by 8 using shift
	let value = 13
	return value shl 3    // 104
end 'main'
---
ExitCode: 104
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 13
    x64.shlRegImm8 r8, r8, 3
    x64.popReg rbp
    x64.ret
}
