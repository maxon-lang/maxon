// Test: shift-signedness-follows-the-cast
typealias Wide = int(0 to u64.max)
typealias Num = int(i64.min to i64.max)

function viaCast(p Num) returns Wide
	let w = p as Wide
	return w shr 60
end 'viaCast'

function viaParam(w Wide) returns Wide
	return w shr 60
end 'viaParam'

function main() returns ExitCode
	if viaParam(u64.max) != 15 'declaredParam'
		return 1
	end 'declaredParam'
	if viaCast(u64.max) != 15 'castLocal'
		return 2
	end 'castLocal'
	if viaCast(u64.max) != viaParam(u64.max) 'twoRoutesOneType'
		return 3
	end 'twoRoutesOneType'
	return 42
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm rax, 18446744073709551615
  __il_body#8:
    x64.shrRegImm8 rax, rax, 60
  __il_cont#7:
    x64.cmpRegImm32 rax, 15
    x64.jcc equal, ifcont#2
  declaredParam:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegImm rax, 18446744073709551615
  __il_body#10:
    x64.shrRegImm8 rax, rax, 60
  __il_cont#9:
    x64.cmpRegImm32 rax, 15
    x64.jcc equal, ifcont#4
  castLocal:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegImm rax, 18446744073709551615
  __il_body#13:
    x64.shrRegImm8 rax, rax, 60
  __il_cont#12:
    x64.movRegImm rcx, 18446744073709551615
  __il_body#14:
    x64.shrRegImm8 rcx, rcx, 60
  __il_cont#11:
    x64.cmpRegReg rax, rcx
    x64.jcc equal, ifcont#6
  twoRoutesOneType:
    x64.movRegImm32 r8, 3
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
}
