// Test: var-target-in-a-loop-carries
typealias Integer = int(i64.min to i64.max)

function step(n Integer) returns (Integer, Integer)
	return (n + 1, n * 2)
end 'step'

function main() returns ExitCode
	var acc = 0
	var total = 0
	var i = 0
	while i < 4 'loop'
		(acc, var doubled) = step(acc)
		doubled = doubled + 1
		total = total + doubled
		i = i + 1
	end 'loop'
	return total
end 'main'
---
ExitCode: 16
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @step {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRegImm32 rbx, rcx, 1
    x64.imulRegRegImm32 r12, rcx, 2
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.storeBaseDispReg.word64 [r8 + 8], r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 0
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 r12, 0
  whilehdr:
    x64.cmpRegImm32 r12, 4
    x64.jcc greaterEqual, whileexit
  loop:
    x64.callDirect step
    x64.loadRegBaseDisp.word64 r13, [r8 + 0]
    x64.loadRegBaseDisp.word64 rax, [r8 + 8]
    x64.leaRegRegImm32 rax, rax, 1
    x64.leaRegRegReg rbx, rbx, rax
    x64.leaRegRegImm32 r12, r12, 1
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r13
    x64.jmp whilehdr
  whileexit:
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at var-target-in-a-loop-carries.test:18: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
