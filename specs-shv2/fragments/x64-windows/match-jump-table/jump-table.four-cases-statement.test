// Test: jump-table.four-cases-statement
enum Direction
		north
		south
		east
		west
end 'Direction'

function main() returns ExitCode
		let d = Direction.west
		match d 'dir'
				north then print("N")
				south then print("S")
				east then print("E")
				west then print("W")
		end 'dir'
		return 0
end 'main'
---
ExitCode: unpinned
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 3
    x64.jumpTable rax, default=matchdead [[0]=matcharm#1, [1]=matcharm#2, [2]=matcharm#3, [3]=matcharm#4] @__jumptable_8
  matchdead:
  matcharm#1:
    x64.leaRegRdata rcx, [rip + __str_rec_4]  ; "N"
    x64.callDirect print
    x64.jmp matchcont
  matcharm#2:
    x64.leaRegRdata rcx, [rip + __str_rec_5]  ; "S"
    x64.callDirect print
    x64.jmp matchcont
  matcharm#3:
    x64.leaRegRdata rcx, [rip + __str_rec_6]  ; "E"
    x64.callDirect print
    x64.jmp matchcont
  matcharm#4:
    x64.leaRegRdata rcx, [rip + __str_rec_7]  ; "W"
    x64.callDirect print
  matchcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
