// Test: jump-table.default-panic
enum Color
		red
		green
		blue
		yellow
end 'Color'

function main() returns ExitCode
		let c = Color.blue
		match c 'check'
				red then print("red")
				green then print("green")
				blue then print("blue")
				yellow then print("yellow")
				default panic("unknown")
		end 'check'
		return 0
end 'main'
---
ExitCode: unpinned
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 2
    x64.jumpTable rax, default=matchdefault [[0]=matcharm#1, [1]=matcharm#2, [2]=matcharm#3, [3]=matcharm#4] @__jumptable_9
  matchdefault:
    x64.leaRegRdata rcx, [rip + __str_blob_8]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matcharm#1:
    x64.leaRegRdata rcx, [rip + __str_rec_4]
    x64.callDirect print
    x64.jmp matchcont
  matcharm#2:
    x64.leaRegRdata rcx, [rip + __str_rec_5]
    x64.callDirect print
    x64.jmp matchcont
  matcharm#3:
    x64.leaRegRdata rcx, [rip + __str_rec_6]
    x64.callDirect print
    x64.jmp matchcont
  matcharm#4:
    x64.leaRegRdata rcx, [rip + __str_rec_7]
    x64.callDirect print
  matchcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
