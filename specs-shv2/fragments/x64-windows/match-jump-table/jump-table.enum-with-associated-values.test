// Test: jump-table.enum-with-associated-values
typealias ID = int(i64.min to i64.max)

union Shape
		circle(r ID)
		square(s ID)
		triangle(b ID, h ID)
		rectangle(w ID, h ID)
end 'Shape'

function describe(s Shape) returns String
		return match s 'sh'
				circle gives "circle"
				square gives "square"
				triangle gives "triangle"
				rectangle gives "rectangle"
		end 'sh'
end 'describe'

function main() returns ExitCode
		print(describe(Shape.triangle(3, h: 4)))
		print(describe(Shape.circle(5)))
		print(describe(Shape.rectangle(2, h: 3)))
		print(describe(Shape.square(4)))
		return 0
end 'main'
---
ExitCode: unpinned
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @describe {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.jumpTable rax, default=matchdead [[0]=matcharm#1, [1]=matcharm#2, [2]=matcharm#3, [3]=matcharm#4] @__jumptable_8
  matchdead:
  matcharm#1:
    x64.leaRegRdata rcx, [rip + __str_rec_4]
    x64.jmp matchcont
  matcharm#2:
    x64.leaRegRdata rcx, [rip + __str_rec_5]
    x64.jmp matchcont
  matcharm#3:
    x64.leaRegRdata rcx, [rip + __str_rec_6]
    x64.jmp matchcont
  matcharm#4:
    x64.leaRegRdata rcx, [rip + __str_rec_7]
    x64.jmp matchcont
  matchcont:
    x64.callDirect __str_retain
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 3
    x64.movRegImm32 r12, 4
    x64.movRegImm32 rcx, 24
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.movRegImm32 rax, 2
    x64.storeBaseDispReg.word64 [r13 + 0], rax
    x64.storeBaseDispReg.word64 [r13 + 8], rbx
    x64.storeBaseDispReg.word64 [r13 + 16], r12
    x64.movRegReg rcx, r13
    x64.callDirect describe
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect print
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.movRegImm32 rbx, 5
    x64.movRegImm32 rcx, 24
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.storeBaseDispReg.word64 [r12 + 8], rbx
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r12 + 16], rax
    x64.movRegReg rcx, r12
    x64.callDirect describe
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect print
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegImm32 rbx, 2
    x64.movRegImm32 r12, 3
    x64.movRegImm32 rcx, 24
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.movRegImm32 rax, 3
    x64.storeBaseDispReg.word64 [r13 + 0], rax
    x64.storeBaseDispReg.word64 [r13 + 8], rbx
    x64.storeBaseDispReg.word64 [r13 + 16], r12
    x64.movRegReg rcx, r13
    x64.callDirect describe
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect print
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.movRegImm32 rbx, 4
    x64.movRegImm32 rcx, 24
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.storeBaseDispReg.word64 [r12 + 8], rbx
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r12 + 16], rax
    x64.movRegReg rcx, r12
    x64.callDirect describe
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect print
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
