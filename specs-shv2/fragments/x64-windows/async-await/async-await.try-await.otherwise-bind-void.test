// Test: async-await.try-await.otherwise-bind-void
typealias Code = int(0 to 100)

var flag = 0

enum TaskError implements Error
		timedOut
		crashed

		export function code() returns Code
				return match self 'e'
						timedOut gives 7
						crashed gives 9
				end 'e'
		end 'code'
end 'TaskError'

function maySetFlag(succeed bool) throws TaskError
		_ = File.exists(FilePath from "noyield.txt")
		if succeed 'ok'
				flag = 1
				return
		end 'ok'
		throw TaskError.crashed
end 'maySetFlag'

function main() returns ExitCode
		let p = async maySetFlag(false)
		try await p otherwise (e) 'failed'
				flag = e.code()
		end 'failed'
		return flag
end 'main'
---
ExitCode: 9
---
data {
  __data_flag@0 = i64 0
  __data_CharacterSet.cachedWhitespacesAndNewlines@8 = i64 0
  __mm_alloc_count@16 = i64 0
  __gt_run_queue_head@24 = i64 0
  __gt_run_queue_tail@32 = i64 0
  __gt_init_done@40 = i64 0
  __gt_timer_count@48 = i64 0
  __gt_timer_heap_base@56 = i64 0
  __gt_timer_capacity@64 = i64 0
  __gt_trace_counter@72 = i64 0
  __gt_proc_count@80 = i64 0
  __gt_proc_handles_base@88 = i64 0
  __gt_proc_gts_base@96 = i64 0
  __gt_live_count@104 = i64 0
  __sched_active_workers@112 = i64 1
  __sched_max_active_workers@120 = i64 1
  __sched_tls_index@128 = i64 0
  __sched_tls_teb_offset@136 = i64 0
  __sched_procs@144 = i64 0
  __sched_num_procs@152 = i64 0
  __sched_shutdown_flag@160 = i64 0
  __sched_lock@168 = i64 0
  __slab_arena_list@176 = i64 0
  __slab_arena_map_l1@184 = i64 0
  __slab_state@192 = i64 0
}

func @TaskError.code {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, matchnext
  matcharm#1:
    x64.movRegImm32 r8, 7
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rcx, 1
    x64.jcc notEqual, matchdead
  matcharm#2:
    x64.movRegImm32 r8, 9
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 100
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_89]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
}

func @maySetFlag {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.leaRegRdata rcx, [rip + __str_rec_17]
    x64.callDirect FilePath.init
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.callDirect File.exists
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_FilePath
    x64.cmpRegImm32 rbx, 0
    x64.jcc equal, ifcont
  ok:
    x64.movRegImm32 rax, 1
    x64.leaRegGlobal rcx, __data_flag
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r10, 2
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rbx, 0
    x64.leaRegFunc rcx, [rip + maySetFlag]
    x64.callDirect __gt_spawn
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 200], rbx
    x64.movRegReg rcx, r12
    x64.callDirect __gt_ready
    x64.movRegReg rcx, r12
    x64.callDirect __gt_try_await
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, trycont
  tryerr:
    x64.leaRegRegImm32 rcx, r10, -1
  __il_body:
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, matchnext
  matcharm#9:
    x64.movRegImm32 rax, 7
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rcx, 1
    x64.jcc notEqual, matchdead
  matcharm#10:
    x64.movRegImm32 rax, 9
  matchcont:
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __il_slow
  __rc_chk#15:
    x64.cmpRegImm32 rax, 100
    x64.jcc lessEqual, __rc_ok#14
  __il_slow:
    x64.callDirect TaskError.code
    x64.jmp __il_cont
  __rc_ok#14:
    x64.movRegReg r8, rax
  __il_cont:
    x64.leaRegGlobal rax, __data_flag
    x64.storeBaseDispReg.word64 [rax + 0], r8
    x64.jmp trycont
  matchdead:
  tryok:
  trycont:
    x64.leaRegGlobal rax, __data_flag
    x64.loadRegBaseDisp.word64 r8, [rax + 0]
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk#6:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok#4
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_90]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#4:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
