// Test: async-await.error.double-await-alias-outlives-rebind
function makeText() returns String
		_ = File.exists(FilePath from "noyield.txt")
		return "hello world"
end 'makeText'

function main() returns ExitCode
		var p = async makeText()
		let q = p
		let a = await p
		p = async makeText()
		let b = await q
		let c = await p
		print(a)
		print(b)
		print(c)
		return 0
end 'main'
---
CompilerError:
error E3100: <fragment>:12:11: this promise has already been awaited: 'await' is linear — a promise is awaited exactly once, because the awaited thunk hands its result over and a second await would release it twice
