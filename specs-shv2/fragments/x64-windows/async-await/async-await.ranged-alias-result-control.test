// Test: async-await.ranged-alias-result-control
typealias Tally = int(0 to 1000)

enum DrainError implements Error
	broken
end 'DrainError'

function countThunk() returns Tally throws DrainError
	_ = File.exists(FilePath from "noyield.txt")
	return 2 as Tally
end 'countThunk'

function main() returns ExitCode
	let p = async countThunk()
	let n = try await p otherwise (e) 'died'
		return 1
	end 'died'
	print("{n}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_CharacterSet.cachedWhitespacesAndNewlines@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __gt_run_queue_head@16 = i64 0
  __gt_run_queue_tail@24 = i64 0
  __gt_init_done@32 = i64 0
  __gt_timer_count@40 = i64 0
