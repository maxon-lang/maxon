// Test: async-await.nested-sleep
typealias Integer = int(i64.min to i64.max)

function leaf(n Integer) returns Integer
		sleep(5)
		return n
end 'leaf'

function outer() returns Integer
		let p1 = async leaf(9)
		return await p1
end 'outer'

function main() returns ExitCode
		let q = async outer()
		return await q
end 'main'
---
ExitCode: 9
---
