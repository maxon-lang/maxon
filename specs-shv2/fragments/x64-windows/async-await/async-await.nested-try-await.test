  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.leaRegRdata rcx, [rip + __str_rec_17]  ; "noyield.txt"
    x64.callDirect FilePath.init
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.callDirect File.exists
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_FilePath
    x64.cmpRegImm32 rbx, 0
    x64.jcc equal, ifcont
  ok:
    x64.movRegImm32 r8, 20
    x64.movRegImm32 r10, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
