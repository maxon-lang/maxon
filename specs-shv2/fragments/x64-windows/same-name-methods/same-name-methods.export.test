// Test: same-name-methods.export
// --- file: lib.maxon
typealias Integer = int(i64.min to i64.max)

export type Pair
	export var a as Integer
	export var b as Integer

	export static function create(a Integer, b Integer) returns Pair
		return Pair{a: a, b: b}
	end 'create'

	export static function sum(x Integer, y Integer) returns Integer
		return x + y
	end 'sum'

	export function sum() returns Integer
		return a + b
	end 'sum'
end 'Pair'

// --- file: main.maxon
function main() returns ExitCode
	let p = Pair.create(10, b: 20)
	let instanceResult = p.sum()
	let staticResult = Pair.sum(5, y: 7)
	return instanceResult + staticResult
end 'main'
---
ExitCode: 42
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Pair.sum#__static {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegRegReg r8, rcx, rdx
    x64.popReg rbp
    x64.ret
}

func @Pair.sum {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 8]
    x64.leaRegRegReg r8, rax, rcx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 56
    x64.movRegImm32 rax, 10
    x64.movRegImm32 rcx, 20
    x64.leaRegSlot rdx, slot0
    x64.storeBaseDispReg.word64 [rdx + 0], rax
    x64.storeBaseDispReg.word64 [rdx + 8], rcx
    x64.movRegReg rcx, rdx
    x64.callDirect Pair.sum
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 5
    x64.movRegImm32 rdx, 7
    x64.callDirect Pair.sum#__static
    x64.leaRegRegReg r8, rbx, r8
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 56
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 56
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
