// Test: same-name-methods.same-params
typealias Integer = int(i64.min to i64.max)

type Converter
	export var factor as Integer

	static function create(factor Integer) returns Converter
		return Converter{factor: factor}
	end 'create'

	static function convert(x Integer) returns Integer
		return x * 2
	end 'convert'

	function convert(x Integer) returns Integer
		return x * factor
	end 'convert'
end 'Converter'

function main() returns ExitCode
	let c = Converter.create(7)
	let instanceResult = c.convert(5)
	let staticResult = Converter.convert(3)
	return instanceResult + staticResult
end 'main'
---
ExitCode: 41
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Converter.convert#__static {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.imulRegRegImm32 r8, rcx, 2
    x64.popReg rbp
    x64.ret
}

func @Converter.convert {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.movRegReg r8, rdx
    x64.imulRegReg r8, rdx, rax
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rax, 7
    x64.leaRegSlot rcx, slot0
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 rdx, 5
    x64.callDirect Converter.convert
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 3
    x64.callDirect Converter.convert#__static
    x64.leaRegRegReg r8, rbx, r8
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
