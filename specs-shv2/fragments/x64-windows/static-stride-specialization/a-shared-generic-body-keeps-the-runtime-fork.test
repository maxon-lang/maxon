// Test: a-shared-generic-body-keeps-the-runtime-fork
typealias Word = int(i64.min to i64.max)
typealias Byte = int(0 to 255)
typealias Idx = int(0 to u64.max)

type Bag uses Element
	typealias Items = Array with Element
	export var items as Items

	export static function create() returns Self
		return Self{items: Items.create()}
	end 'create'

	export function add(value Element)
		items.push(value)
	end 'add'

	export function put(i Idx, value Element)
		try items.set(i, value: value) otherwise panic("Bag.put: index out of range")
	end 'put'

	export function at(i Idx) returns Element throws ArrayError
		return try items.get(i)
	end 'at'
end 'Bag'

typealias WordBag = Bag with Word
typealias ByteBag = Bag with Byte
typealias WordArray = Array with Word

function main() returns ExitCode
	var w = WordBag.create()
	w.add(1000000)
	w.add(2000000)
	w.put(1, value: 3000000)
	if (try w.at(0) otherwise return 1) != 1000000 'wordFirst'
		return 2
	end 'wordFirst'
	if (try w.at(1) otherwise return 1) != 3000000 'wordSecond'
		return 3
	end 'wordSecond'

	var b = ByteBag.create()
	b.add(200)
	b.add(7)
	b.put(1, value: 255)
	if (try b.at(0) otherwise return 1) != 200 'byteFirst'
		return 4
	end 'byteFirst'
	if (try b.at(1) otherwise return 1) != 255 'byteSecond'
		return 5
	end 'byteSecond'

	// The same element width reached DIRECTLY, where the stride is known and the fork is gone.
	var direct = WordArray.create()
	direct.push(9)
	if (try direct.get(0) otherwise return 1) != 9 'directWord'
		return 6
	end 'directWord'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Bag.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rax, 8
    x64.loadRegBaseDisp.word64 rdx, [rcx + 40]
    x64.movRegReg rcx, rax
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Bag.add {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callDirect __managed_push
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @Bag.put {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.loadRegBaseDisp.word64 rsi, [rcx + 24]
    x64.cmpRegImm32 rsi, 8
    x64.jcc notEqual, __im_stride
  __im_word:
    x64.loadRegBaseDisp.word64 rsi, [rcx + 40]
    x64.cmpRegImm32 rsi, 0
    x64.jcc notEqual, __im_slow
  __im_owned#8:
    x64.loadRegBaseDisp.word64 rsi, [rcx + 16]
    x64.cmpRegImm32 rsi, 0
    x64.jcc less, __im_slow
  __im_bounds#9:
    x64.loadRegBaseDisp.word64 rsi, [rcx + 8]
    x64.cmpRegReg rdx, rsi
    x64.jcc aboveEqual, __im_slow
  __im_buffer#10:
    x64.loadRegBaseDisp.word64 rsi, [rcx + 0]
    x64.cmpRegImm32 rsi, 0
    x64.jcc equal, __im_slow
  __im_viewed#11:
    x64.leaRegRegImm32 rdi, rsi, -24
    x64.loadRegBaseDisp.word64 rdi, [rdi + 16]
    x64.cmpRegImm32 rdi, 0
    x64.jcc notEqual, __im_slow
  __im_store#12:
    x64.storeBaseIndexScaleReg.word64 [rsi + rdx*8 + 0], rax
    x64.movRegImm32 rax, 0
    x64.jmp __im_cont
  __im_stride:
    x64.cmpRegImm32 rsi, 1
    x64.jcc notEqual, __im_slow
  __im_byte:
    x64.loadRegBaseDisp.word64 rsi, [rcx + 40]
    x64.cmpRegImm32 rsi, 0
    x64.jcc notEqual, __im_slow
  __im_owned#13:
    x64.loadRegBaseDisp.word64 rsi, [rcx + 16]
    x64.cmpRegImm32 rsi, 0
    x64.jcc less, __im_slow
  __im_bounds#14:
    x64.loadRegBaseDisp.word64 rsi, [rcx + 8]
    x64.cmpRegReg rdx, rsi
    x64.jcc aboveEqual, __im_slow
  __im_buffer#15:
    x64.loadRegBaseDisp.word64 rsi, [rcx + 0]
    x64.cmpRegImm32 rsi, 0
    x64.jcc equal, __im_slow
  __im_viewed#16:
    x64.leaRegRegImm32 rdi, rsi, -24
    x64.loadRegBaseDisp.word64 rdi, [rdi + 16]
    x64.cmpRegImm32 rdi, 0
    x64.jcc notEqual, __im_slow
  __im_store#17:
    x64.leaRegRegReg rcx, rsi, rdx
    x64.storeBaseDispReg.byte [rcx + 0], rax
    x64.movRegImm32 rax, 0
    x64.jmp __im_cont
  __im_slow:
    x64.callDirect __managed_set
    x64.movRegReg rax, r10
  __im_cont:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  tryok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @Bag.at {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
