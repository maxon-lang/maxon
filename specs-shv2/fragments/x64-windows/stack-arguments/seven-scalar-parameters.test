// Test: seven-scalar-parameters
typealias Integer = int(i64.min to i64.max)

function sum7(a Integer, b Integer, c Integer, d Integer, e Integer, f Integer, g Integer) returns Integer
	return a + b + c + d + e + f + g
end 'sum7'

function main() returns ExitCode
	return sum7(1, b: 2, c: 4, d: 8, e: 16, f: 32, g: 64)
end 'main'
---
ExitCode: 127
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 1
  __il_body:
    x64.leaRegRegImm32 rax, rax, 2
    x64.leaRegRegImm32 rax, rax, 4
    x64.leaRegRegImm32 rax, rax, 8
    x64.leaRegRegImm32 rax, rax, 16
    x64.leaRegRegImm32 rax, rax, 32
    x64.leaRegRegImm32 r8, rax, 64
  __il_cont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
