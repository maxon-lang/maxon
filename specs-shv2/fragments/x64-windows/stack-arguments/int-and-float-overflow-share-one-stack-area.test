// Test: int-and-float-overflow-share-one-stack-area
typealias Integer = int(i64.min to i64.max)

function mix(i1 Integer, i2 Integer, i3 Integer, i4 Integer, i5 Integer, i6 Integer, i7 Integer, f1 float, f2 float, f3 float, f4 float, f5 float, f6 float, f7 float) returns Integer
	if f1 + f2 + f3 + f4 + f5 + f6 + f7 == 127.0 'floatsOk'
		return i1 + i2 + i3 + i4 + i5 + i6 + i7
	end 'floatsOk'
	return 0
end 'mix'

function main() returns ExitCode
	return mix(1, i2: 2, i3: 4, i4: 8, i5: 16, i6: 32, i7: 64, f1: 1.0, f2: 2.0, f3: 4.0, f4: 8.0, f5: 16.0, f6: 32.0, f7: 64.0)
end 'main'
---
ExitCode: 127
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.storeSlotReg slot0, xmm6
    x64.movRegImm32 rax, 1
    x64.movsdRegRip xmm0, [rip + __fconst_1]
    x64.movsdRegRip xmm1, [rip + __fconst_2]
    x64.movsdRegRip xmm2, [rip + __fconst_3]
    x64.movsdRegRip xmm3, [rip + __fconst_4]
    x64.movsdRegRip xmm4, [rip + __fconst_5]
    x64.movsdRegRip xmm5, [rip + __fconst_6]
    x64.movsdRegRip xmm6, [rip + __fconst_7]
    x64.jmp __il_body
  __il_body:
    x64.addsdRegReg xmm0, xmm0, xmm1
    x64.addsdRegReg xmm0, xmm0, xmm2
    x64.addsdRegReg xmm0, xmm0, xmm3
    x64.addsdRegReg xmm0, xmm0, xmm4
    x64.addsdRegReg xmm0, xmm0, xmm5
    x64.addsdRegReg xmm0, xmm0, xmm6
    x64.movsdRegRip xmm1, [rip + __fconst_8]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc parity, ifcont
    x64.jmp fordered
  fordered:
    x64.jcc equal, floatsOk
    x64.jmp ifcont
  floatsOk:
    x64.leaRegRegImm32 rax, rax, 2
    x64.leaRegRegImm32 rax, rax, 4
    x64.leaRegRegImm32 rax, rax, 8
    x64.leaRegRegImm32 rax, rax, 16
    x64.leaRegRegImm32 rax, rax, 32
    x64.leaRegRegImm32 r8, rax, 64
    x64.jmp __il_cont
  ifcont:
    x64.movRegImm32 r8, 0
    x64.jmp __il_cont
  __il_cont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.loadRegSlot xmm6, slot0
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.loadRegSlot xmm6, slot0
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}
