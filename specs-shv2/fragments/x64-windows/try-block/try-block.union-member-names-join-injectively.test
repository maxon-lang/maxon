func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 1
    x64.callDirect callAB
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryblkok#2
  critsplit#22:
    x64.movRegReg rbx, r10
    x64.jmp tryblkerr#1
  tryblkok#2:
    x64.movRegImm32 rcx, 0
    x64.callDirect callC
    x64.leaRegRegImm32 r12, r10, 1
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryblkok#3
  critsplit#24:
    x64.movRegReg rbx, r12
  tryblkerr#1:
    x64.movRegImm32 rcx, 0
    x64.callDirect callA
    x64.movRegReg r12, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryblkerr#4
  tryblkok#5:
    x64.movRegImm32 rcx, 0
    x64.callDirect callBC
    x64.leaRegRegImm32 rax, r10, 1
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryblkok#6
  critsplit#25:
    x64.movRegReg r10, rax
  tryblkerr#4:
    x64.cmpRegImm32 r10, 1
