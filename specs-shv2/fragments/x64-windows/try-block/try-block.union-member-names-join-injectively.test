  matchnext#10:
    x64.cmpRegImm32 r10, 2
    x64.jcc equal, tryblkcont#12
  matchdead#9:
  tryblkok#6:
    x64.leaRegRegReg rax, r12, r8
  tryblkcont#12:
    x64.cmpRegImm32 rbx, 1
    x64.jcc notEqual, matchnext#16
  matcharm#13:
    x64.movRegImm32 rax, 11
    x64.jmp matchcont
  matchnext#16:
    x64.cmpRegImm32 rbx, 2
    x64.jcc notEqual, matchdead#15
  matcharm#14:
    x64.movRegImm32 rax, 22
  matchcont:
    x64.movRegReg r8, rax
    x64.jmp tryblkcont#18
  matchdead#15:
  tryblkok#3:
    x64.leaRegRegReg r8, rbx, r8
  tryblkcont#18:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
