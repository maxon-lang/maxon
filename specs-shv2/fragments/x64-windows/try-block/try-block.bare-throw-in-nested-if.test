// Test: try-block.bare-throw-in-nested-if
enum MyError implements Error
    failed
end 'MyError'

function main() returns ExitCode
    var sum = 0
    try 'work'
        if true 'gate'
            throw MyError.failed
        end 'gate'
    end 'work' otherwise (e) 'h'
        match e 'k'
            failed then sum = 5
        end 'k'
    end 'h'
    return sum as ExitCode
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 r8, 0
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, gate
    x64.jmp ifcont
  gate:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp tryblkerr
  tryblkerr:
    x64.leaRegRegImm32 rax, rax, -1
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm
    x64.jmp matchdead
  matcharm:
    x64.movRegImm32 r8, 5
    x64.jmp matchcont
  matchcont:
    x64.jmp tryblkcont
  matchdead:
  ifcont:
    x64.jmp tryblkcont
  tryblkcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
