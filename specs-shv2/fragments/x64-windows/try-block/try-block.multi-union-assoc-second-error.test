// Test: try-block.multi-union-assoc-second-error
typealias Score = int(0 to 1000)

union ErrA implements Error
    bad(code Score)
end 'ErrA'

enum ErrB implements Error
    splat
end 'ErrB'

function callA(x bool) returns Score throws ErrA
    if x 'c'
        throw ErrA.bad(50)
    end 'c'
    return 5
end 'callA'

function callB(x bool) returns Score throws ErrB
    if x 'c'
        throw ErrB.splat
    end 'c'
    return 6
end 'callB'

function main() returns ExitCode
    var sum = 0
    try 'work'
        let a = callA(false)
        let b = callB(true)
        sum = a + b
    end 'work'
    otherwise (e) 'h'
        match e 'k'
            ErrA.bad(code) then sum = code
            ErrB.splat then sum = 99
        end 'k'
    end 'h'
    return sum
end 'main'
---
ExitCode: 99
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @callA {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, c
    x64.jmp ifcont
  c:
    x64.movRegImm32 rbx, 50
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg rax, r8
    x64.movRegImm32 rcx, 0
    x64.storeBaseDispReg.word64 [rax + 0], rcx
    x64.storeBaseDispReg.word64 [rax + 8], rbx
    x64.movRegImm32 r8, 0
    x64.movRegReg r10, rax
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 5
    x64.movRegImm32 r10, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @callB {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, c
    x64.jmp ifcont
  c:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 r10, rax, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 6
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 0
    x64.callDirect callA
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryblkthrow
    x64.jmp tryblkok#2
  tryblkthrow:
    x64.loadRegBaseDisp.word64 rax, [r10 + 0]
    x64.movRegReg rcx, r10
    x64.jmp tryblkerr
  tryblkok#2:
    x64.movRegImm32 rcx, 1
    x64.callDirect callB
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, critsplit
    x64.jmp tryblkok#4
  critsplit:
    x64.movRegReg rcx, r10
    x64.movRegReg rax, r10
    x64.jmp tryblkerr
  tryblkerr:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#5
    x64.jmp matchnext
  matcharm#5:
    x64.loadRegBaseDisp.word64 rbx, [rcx + 8]
    x64.callDirect __mm_decref
    x64.movRegReg rax, rbx
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm#6
    x64.jmp matchdead
  matcharm#6:
    x64.movRegImm32 rax, 99
    x64.jmp matchcont
  matchcont:
    x64.movRegReg r8, rax
    x64.jmp tryblkcont
  matchdead:
  tryblkok#4:
    x64.leaRegRegReg r8, rbx, r8
    x64.jmp tryblkcont
  tryblkcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
