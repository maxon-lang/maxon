    x64.jcc notEqual, __il_cont#25
  __il_slow#26:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.movRegReg rax, r8
    x64.movRegReg rcx, r10
  __il_cont#25:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, trycont#8
  tryerr#7:
    x64.movRegImm32 rax, 0
  trycont#8:
    x64.movRegImm32 rcx, 0
    x64.cmpRegImm32 r12, 0
    x64.jcc equal, ifcont#10
  zero:
    x64.movRegImm32 rcx, 1
  ifcont#10:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, critsplit
  one:
    x64.leaRegRegImm32 r12, rcx, 2
    x64.jmp ifcont#12
  critsplit:
    x64.movRegReg r12, rcx
  ifcont#12:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
