// Test: swap-bit-packed-bool-slots
typealias Flags = Array with bool

function main() returns ExitCode
	var flags = Flags.create()
	flags.push(true)
	flags.push(false)
	flags.push(false)
	try flags.managed.swap(0, j: 1) otherwise return 99
	let atZero = try flags.get(0) otherwise true
	let atOne = try flags.get(1) otherwise false
	var total = 0
	if atZero 'zero'
		total = total + 1
	end 'zero'
	if atOne 'one'
		total = total + 2
	end 'one'
	return total
end 'main'
---
ExitCode: 2
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm rcx, 18446744073709551615
