// Test: shift-right-opens-a-hole-and-zeroes-it
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

function main() returns ExitCode
	var arr = ByteArray.create()
	arr.push(10)
	arr.push(20)
	arr.push(30)
	arr.reserve(4)
	try arr.managed.shiftRight(1, 2) otherwise return 98
	try arr.managed.set(1, 99) otherwise return 97
	try arr.managed.setLength(4) otherwise return 96
	var total = 0
	for v in arr 'sum'
		total = total + v
	end 'sum'
	return total
end 'main'
---
ExitCode: 159
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 10
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 20
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 30
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 4
    x64.movRegReg rcx, rbx
    x64.callDirect Array.reserve
    x64.movRegImm32 rdx, 1
    x64.movRegImm32 rax, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_mem_shift_right
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#2
    x64.jmp tryok#1
  tryerr#2:
    x64.movRegImm32 r12, 98
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#1:
    x64.movRegImm32 rdx, 1
    x64.movRegImm32 rax, 99
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_mem_set
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#4
    x64.jmp tryok#3
  tryerr#4:
    x64.movRegImm32 r12, 97
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#3:
    x64.movRegImm32 rdx, 4
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_set_length
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#6
    x64.jmp tryok#5
  tryerr#6:
    x64.movRegImm32 r12, 96
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#5:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect Array.createIterator
    x64.movRegReg r13, r8
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, critsplit
    x64.jmp forempty
  critsplit:
    x64.jmp forhdr
  forhdr:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, sum
    x64.jmp forexit
  sum:
    x64.leaRegRdata rdx, [rip + __layout_ArrayIterator_Byte]
    x64.movRegReg rcx, r13
    x64.callDirect ArrayIterator.current
    x64.leaRegRegReg r12, r12, r8
    x64.jmp forstep
  forstep:
    x64.movRegReg rcx, r13
    x64.callDirect ArrayIterator.advance
    x64.movRegReg rax, r10
    x64.jmp forhdr
  forexit:
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_ArrayIterator_Byte
    x64.jmp forjoin
  forempty:
    x64.jmp forjoin
  forjoin:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Array.reserve {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_retain
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r13
    x64.callDirect __managed_capacity
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.cmpRegReg r12, r14
    x64.jcc greater, grow
    x64.jmp ifcont
  grow:
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_retain
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __managed_mem_grow
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.jmp ifcont
  ifcont:
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Array.createIterator {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.callDirect __mm_retain
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect ArrayIterator.create
    x64.movRegReg r12, r8
    x64.movRegReg r13, r10
    x64.cmpRegImm32 r13, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegImm32 r8, 0
    x64.movRegReg r10, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegImm32 r10, 0
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @ArrayIterator.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect __managed_cursor_create
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 r10, rax, 1
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_cursor_decref
    x64.movRegImm32 r10, 0
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @ArrayIterator.current {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rdx
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callDirect __managed_cursor_current
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __retain_type_param
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @ArrayIterator.advance {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callDirect __managed_cursor_advance
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 r10, rax, 1
