// Test: crossfile-generic-instance-scalar-field-off-a-temporary
// --- file: holder.maxon
export type Holder uses T
	export var item as T

	export static function create(item T) returns Self
		return Self{ item: item }
	end 'create'
end 'Holder'

// --- file: main.maxon
typealias Integer = int(0 to u32.max)
typealias IntHolder = Holder with Integer

function main() returns ExitCode
	return IntHolder.create(7).item
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 16
    x64.movRegImm32 rax, 7
    x64.leaRegSlot rcx, slot0
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.loadRegBaseDisp.word64 r8, [rcx + 0]
    x64.epilogue 16
    x64.popReg rbp
    x64.ret
}
