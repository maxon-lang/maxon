typealias Num = int(0 to 1000)

export function double(v Num) returns Num
	return v + v
end 'double'

// --- file: gate.maxon
typealias Num = int(0 to 1000)

export type Gate
	export var n as Num

	export static function twice(v Num) returns Gate
		return Gate{n: double(v)}
	end 'twice'
end 'Gate'

// --- file: main.maxon
function main() returns ExitCode
