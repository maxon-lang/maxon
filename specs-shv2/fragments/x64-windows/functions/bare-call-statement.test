// Test: bare-call-statement
function noop(x int) returns int
	return x
end 'noop'

function main() returns ExitCode
	noop(5)
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_cont:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
