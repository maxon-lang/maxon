// Test: param-passed-as-later-arg
function diff(x int, y int) returns int
	return x - y
end 'diff'

function combine(a int, b int, c int) returns int
	let r = diff(b, y: a)
	return r + c
end 'combine'

function main() returns ExitCode
	return combine(10, b: 20, c: 30)
end 'main'
---
ExitCode: 40
---
func @diff {
  entry:
    x64.movRegReg r8, rcx
    x64.subRegReg r8, rcx, rdx
    x64.ret
}

func @combine {
  entry:
    x64.pushReg rbx
    x64.prologue 32
    x64.movRegReg rsi, rcx
    x64.movRegReg rbx, rax
    x64.movRegReg rcx, rdx
    x64.movRegReg rdx, rsi
    x64.callDirect diff
    x64.leaRegRegReg r8, r8, rbx
    x64.epilogue 32
    x64.popReg rbx
    x64.ret
}

func @main {
  entry:
    x64.prologue 40
    x64.movRegImm32 rcx, 10
    x64.movRegImm32 rdx, 20
    x64.movRegImm32 rax, 30
    x64.callDirect combine
    x64.epilogue 40
    x64.ret
}
