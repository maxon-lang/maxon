// Test: value-live-across-call
function add(a int, b int) returns int
	return a + b
end 'add'

function compute(n int) returns int
	let y = add(n, b: 100)
	return n + y
end 'compute'

function main() returns ExitCode
	return compute(5)
end 'main'
---
ExitCode: 110
---
func @add {
  entry:
    x64.leaRegRegReg r8, rcx, rdx
    x64.ret
}

func @compute {
  entry:
    x64.pushReg rbx
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rdx, 100
    x64.movRegReg rcx, rbx
    x64.callDirect add
    x64.leaRegRegReg r8, rbx, r8
    x64.epilogue 32
    x64.popReg rbx
    x64.ret
}

func @main {
  entry:
    x64.prologue 40
    x64.movRegImm32 rcx, 5
    x64.callDirect compute
    x64.epilogue 40
    x64.ret
}
