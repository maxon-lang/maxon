// Test: otherwise-panic.hit
typealias Integer = int(i64.min to i64.max)

enum PanicHitError implements Error
	bad
end 'PanicHitError'

function maybeFail(b bool) returns Integer throws PanicHitError
	if b 'c'
		throw PanicHitError.bad
	end 'c'
	return 7
end 'maybeFail'

function main() returns ExitCode
	var total = 0
	try 'work'
		let a = maybeFail(true)
		total = a
	end 'work'
	otherwise panic("call failed")
	return total
end 'main'
---
ExitCode: 1
---
func @maybeFail {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, ifcont
  c:
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 7
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 1
    x64.callDirect maybeFail
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryblkok
  tryblkerr:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  tryblkok:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
