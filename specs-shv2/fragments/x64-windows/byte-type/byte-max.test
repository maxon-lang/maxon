// Test: byte-max

typealias Byte = int(0 to u8.max)

function main() returns ExitCode
	let b = 255 as Byte
	if b == 255 'ok'
		return 0
	end 'ok' else 'fail'
		return 1
	end 'fail'
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  ok:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
