// Test: mixed-export-fields

typealias Integer = int(i64.min to i64.max)

type Box
	export var value as Integer
	var secret as Integer

	static function create(v Integer, s Integer) returns Self
		return Box{value: v, secret: s}
	end 'create'

	function getSecret() returns Integer
		return secret
	end 'getSecret'
end 'Box'

function main() returns ExitCode
	let b = Box.create(20, s: 22)
	return b.value + b.getSecret()
end 'main'
---
ExitCode: 42
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Box.getSecret {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 r8, [rcx + 8]
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 56
    x64.movRegImm32 rax, 20
    x64.movRegImm32 rcx, 22
    x64.leaRegSlot rdx, slot0
    x64.storeBaseDispReg.word64 [rdx + 0], rax
    x64.storeBaseDispReg.word64 [rdx + 8], rcx
    x64.loadRegBaseDisp.word64 rbx, [rdx + 0]
    x64.movRegReg rcx, rdx
    x64.callDirect Box.getSecret
    x64.leaRegRegReg r8, rbx, r8
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 56
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 56
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
