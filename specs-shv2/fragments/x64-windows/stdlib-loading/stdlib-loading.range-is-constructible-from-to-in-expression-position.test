// Test: stdlib-loading.range-is-constructible-from-to-in-expression-position
function main() returns ExitCode
	let r = 3 to 7
	var sum = 0
	for x in r 'walk'
		sum = sum + x
	end 'walk'
	return sum as ExitCode
end 'main'
---
ExitCode: 25
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 3
    x64.movRegImm32 rdx, 7
    x64.callDirect Range.create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect Range.createIterator
    x64.movRegReg r13, r8
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, forjoin
  forhdr:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, forexit
  __il_body:
    x64.loadRegBaseDisp.word64 rax, [r13 + 16]
  __il_cont:
    x64.leaRegRegReg r12, r12, rax
  forstep:
    x64.movRegReg rcx, r13
    x64.callDirect RangeIterator.advance
    x64.movRegReg rax, r10
    x64.jmp forhdr
  forexit:
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
  forjoin:
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at stdlib-loading.range-is-constructible-from-to-in-expression-position.test:8: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
