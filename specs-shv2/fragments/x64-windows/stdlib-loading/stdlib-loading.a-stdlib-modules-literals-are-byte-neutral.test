// Test: stdlib-loading.a-stdlib-modules-literals-are-byte-neutral
typealias Weight = float(0.0 to 100.0)

enum Marker
	alpha
	beta
	gamma
	delta
	epsilon
	zeta
	eta
	theta
end 'Marker'

function main() returns ExitCode
	let scale = 12.5 as Weight
	let pick = Marker.gamma
	let slot = match pick 'which'
		alpha gives 0
		beta gives 1
		gamma gives 2
		delta gives 3
		epsilon gives 4
		zeta gives 5
		eta gives 6
		theta gives 7
	end 'which'
	return trunc(scale) + slot
end 'main'
---
ExitCode: 14
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 2
    x64.jumpTable rax, default=matchdead [[0]=matcharm#1, [1]=matcharm#2, [2]=matcharm#3, [3]=matcharm#4, [4]=matcharm#5, [5]=matcharm#6, [6]=matcharm#7, [7]=matcharm#8] @__jumptable_1
  matchdead:
  matcharm#1:
    x64.movRegImm32 rax, 0
    x64.jmp matchcont
  matcharm#2:
    x64.movRegImm32 rax, 1
    x64.jmp matchcont
  matcharm#3:
    x64.movRegImm32 rax, 2
    x64.jmp matchcont
  matcharm#4:
    x64.movRegImm32 rax, 3
    x64.jmp matchcont
  matcharm#5:
    x64.movRegImm32 rax, 4
    x64.jmp matchcont
  matcharm#6:
    x64.movRegImm32 rax, 5
    x64.jmp matchcont
  matcharm#7:
    x64.movRegImm32 rax, 6
    x64.jmp matchcont
  matcharm#8:
    x64.movRegImm32 rax, 7
  matchcont:
    x64.leaRegRegImm32 r8, rax, 12
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at stdlib-loading.a-stdlib-modules-literals-are-byte-neutral.test:28: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
