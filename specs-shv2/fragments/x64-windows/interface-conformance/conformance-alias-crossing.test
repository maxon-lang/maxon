// Test: conformance-alias-crossing

typealias Integer = int(i64.min to i64.max)
typealias A = int(0 to 100)
typealias B = int(0 to 100)

interface Processor
	function process(value A) returns Integer
end 'Processor'

type Widget implements Processor
	var v as Integer

	function process(value B) returns Integer
		return value
	end 'process'

	static function create() returns Self
		return Self{v: 0}
	end 'create'
end 'Widget'

function main() returns ExitCode
	var w = Widget.create()
	return w.process(7)
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Widget.process {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rdx, 100
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rdx
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.leaRegSlot rcx, slot0
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 rdx, 7
  __il_body:
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __il_slow
  __rc_chk#7:
    x64.cmpRegImm32 rdx, 100
    x64.jcc lessEqual, __rc_ok#6
  __il_slow:
    x64.callDirect Widget.process
    x64.jmp __il_cont
  __rc_ok#6:
    x64.movRegReg r8, rdx
  __il_cont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk#3:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok#1
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
  __rc_ok#1:
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}
