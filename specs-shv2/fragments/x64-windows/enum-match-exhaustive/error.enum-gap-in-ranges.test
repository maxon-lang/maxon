// Test: error.enum-gap-in-ranges
enum Priority
		low
		medium
		high
		critical
end 'Priority'

function main() returns ExitCode
	let p = Priority.high
	match p 'check'
		low to medium then return 1
		critical then return 2
	end 'check'
end 'main'
---
CompilerError:
error E2026: <fragment>:14:2: match on enum 'Priority' is not exhaustive, missing: high
