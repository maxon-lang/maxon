// Test: enum-exhaustive.int-backed-range-is-declaration-order-not-raw-order
enum Code
	ok = 500
	notFound = 200
	serverError = 404
end 'Code'

function classify(c Code) returns ExitCode
	let r = match c 'm'
		ok to notFound gives 41
		serverError gives 42
	end 'm'
	return r
end 'classify'

function main() returns ExitCode
	return classify(Code.serverError)
end 'main'
---
ExitCode: 42
---
func @classify {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 200
    x64.jcc equal, matcharm#1
  matchnext#4:
    x64.cmpRegImm32 rcx, 404
    x64.jcc notEqual, matchnext#5
  matcharm#2:
    x64.movRegImm32 r8, 42
    x64.jmp matchcont
  matchnext#5:
    x64.cmpRegImm32 rcx, 500
    x64.jcc notEqual, matchdead
  matcharm#1:
    x64.movRegImm32 r8, 41
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 404
  __il_body:
    x64.cmpRegImm32 rcx, 200
    x64.jcc equal, matcharm#3
  matchnext#6:
    x64.cmpRegImm32 rcx, 404
    x64.jcc notEqual, matchnext#7
  matcharm#4:
    x64.movRegImm32 rax, 42
    x64.jmp matchcont
  matchnext#7:
    x64.cmpRegImm32 rcx, 500
    x64.jcc notEqual, matchdead
  matcharm#3:
    x64.movRegImm32 rax, 41
  matchcont:
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __il_slow
  __rc_chk:
    x64.movRegImm32 rdx, 4294967295
    x64.cmpRegReg rax, rdx
    x64.jcc lessEqual, __rc_ok
  __il_slow:
    x64.callDirect classify
    x64.jmp __il_cont
  __rc_ok:
    x64.movRegReg r8, rax
  __il_cont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
}
