// Test: enum-exhaustive.trailing-fallthrough
enum Color
		red
		green
		blue
end 'Color'

function main() returns ExitCode
	var x = 0
	let c = Color.blue
	match c 'check'
		red then x = 1
		green then x = 2
		blue then x = 3 and fallthrough
	end 'check'
	return x
end 'main'
---
ExitCode: 3
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  matcharm:
    x64.movRegImm32 r8, 3
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
