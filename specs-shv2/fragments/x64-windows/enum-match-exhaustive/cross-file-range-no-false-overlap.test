// Test: cross-file-range-no-false-overlap
// --- file: ops.maxon
export union WideOp
	call
	ret
	param
	extra
end 'WideOp'

export union NarrowOp
	ret
	call
	param
end 'NarrowOp'

// --- file: main.maxon
typealias Code = int(0 to 125)

function classify(op NarrowOp) returns Code
	return match op 'check'
		ret gives 1
		call to param gives 2
	end 'check'
end 'classify'

function describeWide(op WideOp) returns Code
	return match op 'check'
		call to extra gives 9
	end 'check'
end 'describeWide'

function main() returns ExitCode
	let narrow = classify(NarrowOp.call)
	let wide = describeWide(WideOp.ret)
	if wide == 9 'wideOk'
		return narrow
	end 'wideOk'
	return 99
end 'main'
---
ExitCode: 2
---
func @classify {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, matchnext
  matcharm#1:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rcx, 1
    x64.setccReg greaterEqual, rax
    x64.cmpRegImm32 rcx, 2
    x64.setccReg lessEqual, rcx
    x64.andRegReg rax, rax, rcx
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matchdead
  matcharm#2:
    x64.movRegImm32 r8, 2
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 125
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
}

func @describeWide {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.setccReg greaterEqual, rax
    x64.cmpRegImm32 rcx, 3
    x64.setccReg lessEqual, rcx
    x64.andRegReg rax, rax, rcx
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matchdead
  matcharm:
    x64.movRegImm32 r8, 9
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 125
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 1
  __il_body#5:
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, matchnext
  matcharm#6:
    x64.movRegImm32 rax, 1
    x64.jmp matchcont#10
  matchnext:
    x64.cmpRegImm32 rcx, 1
    x64.setccReg greaterEqual, rax
    x64.cmpRegImm32 rcx, 2
    x64.setccReg lessEqual, rdx
    x64.andRegReg rax, rax, rdx
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matchdead#8
  matcharm#7:
    x64.movRegImm32 rax, 2
  matchcont#10:
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __il_slow#13
  __rc_chk#12:
    x64.cmpRegImm32 rax, 125
    x64.jcc lessEqual, __rc_ok#11
  __il_slow#13:
    x64.callDirect classify
    x64.movRegReg rbx, r8
    x64.jmp __il_cont#4
  __rc_ok#11:
    x64.movRegReg rbx, rax
  __il_cont#4:
    x64.movRegImm32 rcx, 1
  __il_body#14:
    x64.cmpRegImm32 rcx, 0
    x64.setccReg greaterEqual, rax
    x64.cmpRegImm32 rcx, 3
    x64.setccReg lessEqual, rdx
    x64.andRegReg rax, rax, rdx
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matchdead#16
  matcharm#15:
    x64.movRegImm32 rax, 9
  matchcont#17:
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __il_slow#20
  __rc_chk#19:
    x64.cmpRegImm32 rax, 125
    x64.jcc lessEqual, __rc_ok#18
  __il_slow#20:
    x64.callDirect describeWide
    x64.jmp __il_cont#3
  __rc_ok#18:
    x64.movRegReg r8, rax
  __il_cont#3:
    x64.cmpRegImm32 r8, 9
    x64.jcc notEqual, ifcont
  wideOk:
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead#16:
  matchdead#8:
}
