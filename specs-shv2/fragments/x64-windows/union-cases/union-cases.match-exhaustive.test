// Test: union-cases.match-exhaustive
typealias Integer = int(i64.min to i64.max)

union Shape
	circle(radius Integer)
	square(side Integer)
	point
end 'Shape'

function describe(k Shape.unionCases) returns Integer
	match k 'tag'
		circle then return 100
		square then return 200
		point then return 300
	end 'tag'
end 'describe'

function main() returns ExitCode
	let c = Shape.unionCases.circle
	let s = Shape.unionCases.square
	let p = Shape.unionCases.point
	let total = describe(c) + describe(s) + describe(p)
	if total == 600 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 2
  __il_body#6:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext#11
  matcharm#7:
    x64.movRegImm32 rax, 100
    x64.jmp __il_body#14
  matchnext#11:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchnext#12
  matcharm#8:
    x64.movRegImm32 rax, 200
    x64.jmp __il_body#14
  matchnext#12:
    x64.cmpRegImm32 rax, 2
    x64.jcc notEqual, matchdead#10
  matcharm#9:
    x64.movRegImm32 rax, 300
  __il_body#14:
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, matchnext#19
  matcharm#15:
    x64.movRegImm32 rcx, 100
    x64.jmp __il_cont#4
  matchnext#19:
    x64.cmpRegImm32 rcx, 1
    x64.jcc notEqual, matchnext#20
  matcharm#16:
    x64.movRegImm32 rcx, 200
    x64.jmp __il_cont#4
  matchnext#20:
    x64.cmpRegImm32 rcx, 2
    x64.jcc notEqual, matchdead#18
  matcharm#17:
    x64.movRegImm32 rcx, 300
  __il_cont#4:
    x64.leaRegRegReg rax, rax, rcx
  __il_body#22:
    x64.cmpRegImm32 rdx, 0
    x64.jcc notEqual, matchnext#27
  matcharm#23:
    x64.movRegImm32 rcx, 100
    x64.jmp __il_cont#3
  matchnext#27:
    x64.cmpRegImm32 rdx, 1
    x64.jcc notEqual, matchnext#28
  matcharm#24:
    x64.movRegImm32 rcx, 200
    x64.jmp __il_cont#3
  matchnext#28:
    x64.cmpRegImm32 rdx, 2
    x64.jcc notEqual, matchdead#26
  matcharm#25:
    x64.movRegImm32 rcx, 300
  __il_cont#3:
    x64.leaRegRegReg rax, rax, rcx
    x64.cmpRegImm32 rax, 600
    x64.jcc notEqual, ifcont
  check:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  matchdead#26:
  matchdead#18:
  matchdead#10:
  matchcont#13:
  matchcont#21:
  matchcont#29:
}
