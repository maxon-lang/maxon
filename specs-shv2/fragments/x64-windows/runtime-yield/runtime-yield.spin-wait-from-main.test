// Test: runtime-yield.spin-wait-from-main
typealias Integer = int(i64.min to i64.max)

var progressed = 0

function worker() returns Integer
	progressed = 1
	Runtime.yield()
	return 7
end 'worker'

function main() returns ExitCode
	let p = async worker()
	for _ in 0 upto 1000 'spin'
		Runtime.yield()
	end 'spin'
	return (progressed + await p) as ExitCode
end 'main'
---
ExitCode: 8
---
data {
  __data_progressed@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __gt_run_queue_head@16 = i64 0
  __gt_run_queue_tail@24 = i64 0
  __gt_init_done@32 = i64 0
  __gt_timer_count@40 = i64 0
  __gt_timer_heap_base@48 = i64 0
  __gt_timer_capacity@56 = i64 0
  __gt_timer_seq@64 = i64 0
  __gt_trace_counter@72 = i64 0
  __gt_proc_count@80 = i64 0
  __gt_proc_handles_base@88 = i64 0
  __gt_proc_gts_base@96 = i64 0
  __gt_proc_wait_snapshot@104 = i64 0
  __gt_proc_poller@112 = i64 0
  __gt_live_count@120 = i64 0
  __sched_progress@128 = i64 0
  __sched_active_workers@136 = i64 1
  __sched_max_active_workers@144 = i64 1
  __sched_tls_index@152 = i64 0
  __sched_tls_teb_offset@160 = i64 0
  __sched_procs@168 = i64 0
  __sched_allm@176 = i64 0
  __sched_midle@184 = i64 0
  __sched_pidle@192 = i64 0
  __sched_num_procs@200 = i64 0
  __sched_shutdown_flag@208 = i64 0
  __sched_lock@216 = i64 0
  __sched_nmspinning@224 = i64 0
  __sched_parked_drivers@232 = i64 0
  __sched_sysmon_started@240 = i64 0
  __slab_arena_list@248 = i64 0
  __slab_arena_map_l1@256 = i64 0
  __slab_state@264 = i64 0
}

func @worker {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 1
    x64.leaRegGlobal rcx, __data_progressed
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.callDirect Runtime.yield
    x64.movRegImm32 r8, 7
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegFunc rcx, [rip + worker]
    x64.callDirect __gt_spawn
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __gt_ready
    x64.movRegImm32 r12, 0
  forhdr:
    x64.cmpRegImm32 r12, 1000
    x64.jcc greaterEqual, forexit
  spin:
    x64.callDirect Runtime.yield
  forstep:
    x64.leaRegRegImm32 r12, r12, 1
    x64.jmp forhdr
  forexit:
    x64.leaRegGlobal rax, __data_progressed
    x64.loadRegBaseDisp.word64 r12, [rax + 0]
    x64.movRegReg rcx, rbx
    x64.callDirect __gt_await
    x64.leaRegRegReg r8, r12, r8
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at runtime-yield.spin-wait-from-main.test:17: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
