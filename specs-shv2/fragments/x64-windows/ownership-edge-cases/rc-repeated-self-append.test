// Test: rc-repeated-self-append
function main() returns ExitCode
	var s = "abc"
	s.append(s)
	print("A={s}|{s.byteLength()}\n")
	s.append(s)
	print("B={s}|{s.byteLength()}\n")
	s.append(s)
	print("C={s}|{s.byteLength()}\n")
	print("D=done\n")
	return 0
end 'main'
