// Test: rc-enum-no-struct-payload-freed
typealias Integer = int(i64.min to i64.max)

enum Color
	red
	green
	blue
end 'Color'

function colorCode(c Color) returns Integer
	let result = match c 'pick'
		red   gives 1
		green gives 2
		blue  gives 3
	end 'pick'
	return result
end 'colorCode'

function main() returns ExitCode
	let c = Color.green
	return colorCode(c)
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 1
    x64.jmp __il_body
  __il_body:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#6
    x64.jmp matchnext#10
  matcharm#6:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont
  matchnext#10:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm#7
    x64.jmp matchnext#11
  matcharm#7:
    x64.movRegImm32 r8, 2
    x64.jmp matchcont
  matchnext#11:
    x64.cmpRegImm32 rax, 2
    x64.jcc equal, matcharm#8
    x64.jmp matchdead
  matcharm#8:
    x64.movRegImm32 r8, 3
    x64.jmp matchcont
  matchcont:
    x64.jmp __il_cont
  __il_cont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
}
