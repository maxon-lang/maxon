// Test: closure-body-restores-the-enclosing-functions-parse-context

typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer
typealias Fn1 = function(Integer) returns Integer

function apply(f Fn1, x Integer) returns Integer
	return f(x)
end 'apply'

interface Named
	function label() returns Integer
end 'Named'

type W implements Named
	export var n as Integer

	export function label() returns Integer
		return self.n
	end 'label'

	export static function create(n Integer) returns Self
		return Self{n: n}
	end 'create'
end 'W'

type Holder uses T where T is Named
	export var item as T

	export static function create(item T) returns Self
		return Self{item: item}
	end 'create'

	export function go() returns Integer
		let viaClosure = apply(function(n Integer) gives n + 1, x: 0)
		return self.item.label() + viaClosure
	end 'go'
end 'Holder'

typealias WH = Holder with W

function main() returns ExitCode
	var a = IntArray.create()
	a.push(1)
	a.push(2)
	var total = 0
	for x in a 'loop'
		total = total + x + apply(function(n Integer) gives n + 1, x: 0)
	end 'loop'
	let h = WH.create(W.create(38))
	print("total={total} go={h.go()}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @apply {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg rcx, rdx
    x64.movRegReg rdx, rax
    x64.callReg rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @W.label {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 r8, [rcx + 0]
    x64.popReg rbp
    x64.ret
}

func @W.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Holder.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
