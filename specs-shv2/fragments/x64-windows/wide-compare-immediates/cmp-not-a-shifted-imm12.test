// Test: cmp-not-a-shifted-imm12
typealias Val = int(i64.min to i64.max)

function base(p Val) returns Val
	return p
end 'base'

function main() returns ExitCode
	let x = base(65535)
	if not (x == 65535) 'eqWord'
		return 31
	end 'eqWord'
	if x > 65535 'gtWord'
		return 32
	end 'gtWord'
	if not (x < 65536) 'ltNext'
		return 33
	end 'ltNext'
	let y = base(16777215)
	if not (y == 16777215) 'eqPairMax'
		return 34
	end 'eqPairMax'
	if not (y > 65535) 'gtWordFromPair'
		return 35
	end 'gtWordFromPair'
	if y == 16777214 'eqOffByOne'
		return 36
	end 'eqOffByOne'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 65535
  __il_cont#13:
    x64.cmpRegImm32 rax, 65535
    x64.setccReg equal, rcx
    x64.xorRegImm32 rcx, rcx, 1
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, ifcont#2
  eqWord:
    x64.movRegImm32 r8, 31
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.cmpRegImm32 rax, 65535
    x64.jcc lessEqual, ifcont#4
  gtWord:
    x64.movRegImm32 r8, 32
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.cmpRegImm32 rax, 65536
    x64.setccReg less, rax
    x64.xorRegImm32 rax, rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont#6
  ltNext:
    x64.movRegImm32 r8, 33
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.movRegImm32 rax, 16777215
  __il_cont#15:
    x64.cmpRegImm32 rax, 16777215
    x64.setccReg equal, rcx
    x64.xorRegImm32 rcx, rcx, 1
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, ifcont#8
  eqPairMax:
    x64.movRegImm32 r8, 34
    x64.popReg rbp
    x64.ret
  ifcont#8:
    x64.cmpRegImm32 rax, 65535
    x64.setccReg greater, rcx
    x64.xorRegImm32 rcx, rcx, 1
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, ifcont#10
  gtWordFromPair:
    x64.movRegImm32 r8, 35
    x64.popReg rbp
    x64.ret
  ifcont#10:
    x64.cmpRegImm32 rax, 16777214
    x64.jcc notEqual, ifcont#12
  eqOffByOne:
    x64.movRegImm32 r8, 36
    x64.popReg rbp
    x64.ret
  ifcont#12:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
