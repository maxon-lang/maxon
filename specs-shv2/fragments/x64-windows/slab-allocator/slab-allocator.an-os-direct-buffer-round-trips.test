// Test: slab-allocator.an-os-direct-buffer-round-trips
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte
typealias Round = int(0 to 255)

function roundTrip(r Round) returns int
	var big = ByteArray.create()
	big.reserve(300000)
	for i in 0 upto 512 'fill'
		big.push(((r + i) mod 251) as Byte)
	end 'fill'

	var wrong = 0
	for i in 0 upto 512 'check'
		let got = try big.get(i) otherwise return 1
		if got != ((r + i) mod 251) 'value'
			wrong = wrong + 1
		end 'value'
	end 'check'
	return wrong
end 'roundTrip'

function main() returns ExitCode
	var bad = 0
	for r in 0 upto 64 'rounds'
		bad = bad + roundTrip(r as Round)
	end 'rounds'

	if bad != 0 'corrupted'
		return 3
	end 'corrupted'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @roundTrip {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic#14
  __rc_chk#15:
    x64.cmpRegImm32 rbx, 255
    x64.jcc lessEqual, __rc_ok#13
  __rc_panic#14:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#13:
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegImm32 rdx, 300000
    x64.movRegReg rcx, r12
    x64.callDirect Array.reserve
    x64.movRegImm32 r13, 0
  forhdr#1:
    x64.cmpRegImm32 r13, 512
    x64.jcc greaterEqual, forexit#4
  fill:
    x64.leaRegRegReg rsi, rbx, r13
    x64.movRegImm rax, 2351776136887273513
    x64.imulHighReg rsi
    x64.sarRegImm8 rdx, rdx, 5
    x64.movRegReg rax, rdx
    x64.shrRegImm8 rax, rdx, 63
    x64.leaRegRegReg rax, rdx, rax
    x64.imulRegRegImm32 rax, rax, 251
    x64.movRegReg rdx, rsi
    x64.subRegReg rdx, rsi, rax
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __rc_panic#17
  __rc_chk#18:
    x64.cmpRegImm32 rdx, 255
    x64.jcc lessEqual, __rc_ok#16
  __rc_panic#17:
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#16:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_push
  forstep#3:
    x64.leaRegRegImm32 r13, r13, 1
    x64.jmp forhdr#1
  forexit#4:
    x64.movRegImm32 r13, 0
    x64.movRegImm32 r14, 0
  forhdr#5:
    x64.cmpRegImm32 r14, 512
    x64.jcc greaterEqual, forexit#8
  check:
    x64.loadRegBaseDisp.word64 rax, [r12 + 24]
    x64.cmpRegImm32 rax, 8
    x64.jcc notEqual, __im_stride
  __im_word:
    x64.loadRegBaseDisp.word64 rax, [r12 + 8]
    x64.cmpRegImm32 r14, 0
    x64.setccReg less, rcx
    x64.cmpRegReg r14, rax
    x64.setccReg greaterEqual, rax
    x64.orRegReg rcx, rcx, rax
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, __im_slow
  __im_load#25:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.loadRegBaseIndexScale.word64 rax, [rax + r14*8 + 0]
    x64.jmp __im_loaded
  __im_stride:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, __im_slow
  __im_byte:
    x64.loadRegBaseDisp.word64 rax, [r12 + 8]
    x64.cmpRegImm32 r14, 0
    x64.setccReg less, rcx
    x64.cmpRegReg r14, rax
    x64.setccReg greaterEqual, rax
    x64.orRegReg rcx, rcx, rax
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, __im_slow
  __im_load#26:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.leaRegRegReg rax, rax, r14
    x64.loadRegBaseDisp.byte rax, [rax + 0]
  __im_loaded:
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rdx, [r12 + 40]
    x64.cmpRegImm32 rdx, 0
    x64.jcc equal, critsplit#29
  __im_empty:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __im_slow
  critsplit#30:
    x64.xchgRegReg rcx, rax
    x64.jmp __im_cont
  critsplit#29:
    x64.xchgRegReg rcx, rax
    x64.jmp __im_cont
  __im_slow:
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r14
    x64.callDirect __managed_get
    x64.movRegReg rcx, r8
    x64.movRegReg rax, r10
  __im_cont:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm32 rbx, 1
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.leaRegRegReg rsi, rbx, r14
    x64.movRegImm rax, 2351776136887273513
    x64.imulHighReg rsi
    x64.sarRegImm8 rdx, rdx, 5
    x64.movRegReg rax, rdx
    x64.shrRegImm8 rax, rdx, 63
    x64.leaRegRegReg rax, rdx, rax
    x64.imulRegRegImm32 rax, rax, 251
    x64.subRegReg rsi, rsi, rax
    x64.cmpRegReg rcx, rsi
    x64.jcc equal, critsplit#28
  value:
    x64.leaRegRegImm32 rax, r13, 1
    x64.jmp forstep#7
  critsplit#28:
    x64.movRegReg rax, r13
  forstep#7:
    x64.leaRegRegImm32 r14, r14, 1
    x64.movRegReg r13, rax
    x64.jmp forhdr#5
  forexit#8:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg r8, r13
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 r12, 0
  forhdr:
    x64.cmpRegImm32 r12, 64
    x64.jcc greaterEqual, forexit
  rounds:
    x64.movRegReg rcx, r12
    x64.callDirect roundTrip
    x64.leaRegRegReg rbx, rbx, r8
  forstep:
    x64.leaRegRegImm32 r12, r12, 1
    x64.jmp forhdr
  forexit:
    x64.cmpRegImm32 rbx, 0
    x64.jcc equal, ifcont
  corrupted:
    x64.movRegImm32 r8, 3
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
