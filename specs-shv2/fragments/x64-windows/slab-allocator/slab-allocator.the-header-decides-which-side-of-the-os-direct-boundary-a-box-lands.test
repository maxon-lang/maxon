    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.jmp __im_loaded#29
  __im_stride#28:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, __im_byte#27
    x64.jmp __il_slow#25
  __im_byte#27:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rdx, 0
    x64.setccReg less, rcx
    x64.cmpRegReg rdx, rax
    x64.setccReg greaterEqual, rax
    x64.orRegReg rcx, rcx, rax
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, __il_slow#25
    x64.jmp __im_load#31
  __im_load#31:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.leaRegRegReg rax, rax, rdx
    x64.loadRegBaseDisp.byte rax, [rax + 0]
    x64.jmp __im_loaded#29
  __im_loaded#29:
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rsi, [rbx + 40]
    x64.cmpRegImm32 rsi, 0
    x64.jcc notEqual, __im_empty#32
    x64.jmp critsplit#44
  __im_empty#32:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __il_slow#25
    x64.jmp critsplit#45
  critsplit#45:
    x64.movRegReg r14, rax
    x64.jmp __il_cont#24
  critsplit#44:
    x64.movRegReg r14, rax
    x64.jmp __il_cont#24
  __il_slow#25:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r10
    x64.jmp __il_cont#24
  __il_cont#24:
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, tryerr#10
    x64.jmp tryok#9
  tryerr#10:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#9:
    x64.loadRegBaseDisp.word64 rax, [r14 + 8]
    x64.cmpRegReg rax, r13
    x64.jcc notEqual, length
    x64.jmp critsplit#42
  length:
    x64.leaRegRegImm32 rax, r12, 1
    x64.jmp ifcont#12
  critsplit#42:
    x64.movRegReg rax, r12
    x64.jmp ifcont#12
  ifcont#12:
    x64.movRegImm32 r12, 0
    x64.movRegReg r15, rax
    x64.jmp forhdr#13
  forhdr#13:
    x64.cmpRegReg r12, r13
    x64.jcc less, bytes
    x64.jmp forexit#16
  bytes:
    x64.loadRegBaseDisp.word64 rax, [r14 + 24]
    x64.cmpRegImm32 rax, 8
    x64.jcc equal, __im_word#35
    x64.jmp __im_stride#37
  __im_word#35:
    x64.loadRegBaseDisp.word64 rax, [r14 + 8]
    x64.cmpRegImm32 r12, 0
    x64.setccReg less, rcx
    x64.cmpRegReg r12, rax
    x64.setccReg greaterEqual, rax
    x64.orRegReg rcx, rcx, rax
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, __il_slow#34
    x64.jmp __im_load#39
  __im_load#39:
    x64.loadRegBaseDisp.word64 rax, [r14 + 0]
    x64.imulRegRegImm32 rcx, r12, 8
    x64.leaRegRegReg rax, rax, rcx
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.jmp __im_loaded#38
  __im_stride#37:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, __im_byte#36
    x64.jmp __il_slow#34
  __im_byte#36:
    x64.loadRegBaseDisp.word64 rax, [r14 + 8]
    x64.cmpRegImm32 r12, 0
    x64.setccReg less, rcx
    x64.cmpRegReg r12, rax
    x64.setccReg greaterEqual, rax
    x64.orRegReg rcx, rcx, rax
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, __il_slow#34
    x64.jmp __im_load#40
  __im_load#40:
    x64.loadRegBaseDisp.word64 rax, [r14 + 0]
    x64.leaRegRegReg rax, rax, r12
    x64.loadRegBaseDisp.byte rax, [rax + 0]
    x64.jmp __im_loaded#38
  __im_loaded#38:
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rdx, [r14 + 40]
    x64.cmpRegImm32 rdx, 0
    x64.jcc notEqual, __im_empty#41
    x64.jmp critsplit#46
  __im_empty#41:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __il_slow#34
    x64.jmp critsplit#47
  critsplit#47:
    x64.xchgRegReg rcx, rax
    x64.jmp __il_cont#33
  critsplit#46:
    x64.xchgRegReg rcx, rax
    x64.jmp __il_cont#33
  __il_slow#34:
    x64.movRegReg rcx, r14
    x64.movRegReg rdx, r12
    x64.callDirect __managed_get
    x64.movRegReg rcx, r8
    x64.movRegReg rax, r10
    x64.jmp __il_cont#33
  __il_cont#33:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, tryerr#18
    x64.jmp tryok#17
  tryerr#18:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#17:
    x64.leaRegRegReg rax, r12, r13
    x64.movRegImm32 rsi, 251
    x64.cqo
    x64.idivReg rsi
    x64.cmpRegReg rcx, rdx
    x64.jcc notEqual, value
    x64.jmp critsplit#43
  value:
    x64.leaRegRegImm32 rax, r15, 1
    x64.jmp ifcont#20
  critsplit#43:
    x64.movRegReg rax, r15
    x64.jmp ifcont#20
  ifcont#20:
    x64.jmp forstep#15
  forstep#15:
    x64.leaRegRegImm32 r12, r12, 1
    x64.movRegReg r15, rax
    x64.jmp forhdr#13
  forexit#16:
    x64.jmp forstep#7
  forstep#7:
    x64.loadRegSlot rax, slot0
    x64.leaRegRegImm32 rdx, rax, 1
    x64.movRegReg r12, r15
    x64.jmp forhdr#5
  forexit#8:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
