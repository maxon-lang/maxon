// Test: slab-allocator.os-direct-mappings-coexist
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte
typealias Bufs = Array with ByteArray
typealias Index = int(0 to 255)

function build(k Index) returns ByteArray
	var b = ByteArray.create()
	b.reserve(280000 + k * 4096)
	for i in 0 upto 64 'fill'
		b.push(((k * 7 + i) mod 251) as Byte)
	end 'fill'
	return b
end 'build'

function main() returns ExitCode
	var bufs = Bufs.create()
	for k in 0 upto 40 'alloc'
		bufs.push(build(k as Index))
	end 'alloc'

	var bad = 0
	for k in 0 upto 40 'check'
		let b = try bufs.get(k) otherwise return 1
		for i in 0 upto 64 'bytes'
			let got = try b.get(i) otherwise return 2
			if got != ((k * 7 + i) mod 251) 'value'
				bad = bad + 1
			end 'value'
		end 'bytes'
	end 'check'

	if bad != 0 'corrupted'
		return 3
	end 'corrupted'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @build {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic#6
    x64.jmp __rc_chk#7
  __rc_chk#7:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic#6
    x64.jmp __rc_ok#5
  __rc_panic#6:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#5:
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.imulRegRegImm32 rax, rbx, 4096
    x64.leaRegRegImm32 rdx, rax, 280000
    x64.movRegReg rcx, r12
    x64.callDirect Array.reserve
    x64.movRegImm32 r13, 0
    x64.jmp forhdr
  forhdr:
    x64.cmpRegImm32 r13, 64
    x64.jcc less, fill
    x64.jmp forexit
  fill:
    x64.imulRegRegImm32 rax, rbx, 7
    x64.leaRegRegReg rax, rax, r13
    x64.movRegImm32 rcx, 251
    x64.cqo
    x64.idivReg rcx
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __rc_panic#9
    x64.jmp __rc_chk#10
  __rc_chk#10:
    x64.cmpRegImm32 rdx, 255
    x64.jcc greater, __rc_panic#9
    x64.jmp __rc_ok#8
  __rc_panic#9:
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#8:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_push
    x64.jmp forstep
  forstep:
    x64.leaRegRegImm32 r13, r13, 1
    x64.jmp forhdr
  forexit:
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

