    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, __im_slow#27
  __im_load#28:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseIndexScale.word64 r14, [rax + rdx*8 + 0]
    x64.movRegImm32 rax, 0
    x64.loadRegBaseDisp.word64 rcx, [rbx + 40]
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, critsplit#41
  __im_empty#29:
    x64.cmpRegImm32 r14, 0
    x64.jcc notEqual, critsplit#42
  __im_slow#27:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.movRegReg r14, r8
    x64.jmp __im_cont#26
  critsplit#42:
    x64.movRegReg r10, rax
    x64.jmp __im_cont#26
  critsplit#41:
    x64.movRegReg r10, rax
  __im_cont#26:
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#9
  tryerr#10:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#9:
    x64.loadRegBaseDisp.word64 rax, [r14 + 8]
    x64.cmpRegReg rax, r13
    x64.jcc equal, critsplit#39
  length:
    x64.leaRegRegImm32 rax, r12, 1
    x64.jmp ifcont#12
  critsplit#39:
    x64.movRegReg rax, r12
  ifcont#12:
    x64.movRegImm32 r12, 0
    x64.movRegReg r15, rax
  forhdr#13:
    x64.cmpRegReg r12, r13
    x64.jcc greaterEqual, forstep#7
  bytes:
    x64.loadRegBaseDisp.word64 rax, [r14 + 24]
    x64.cmpRegImm32 rax, 8
    x64.jcc notEqual, __im_stride
  __im_word:
    x64.loadRegBaseDisp.word64 rax, [r14 + 8]
    x64.cmpRegImm32 r12, 0
    x64.setccReg less, rcx
    x64.cmpRegReg r12, rax
    x64.setccReg greaterEqual, rax
    x64.orRegReg rcx, rcx, rax
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, __im_slow#31
  __im_load#36:
    x64.loadRegBaseDisp.word64 rax, [r14 + 0]
    x64.loadRegBaseIndexScale.word64 rax, [rax + r12*8 + 0]
    x64.jmp __im_loaded
  __im_stride:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, __im_slow#31
  __im_byte:
    x64.loadRegBaseDisp.word64 rax, [r14 + 8]
    x64.cmpRegImm32 r12, 0
    x64.setccReg less, rcx
    x64.cmpRegReg r12, rax
    x64.setccReg greaterEqual, rax
    x64.orRegReg rcx, rcx, rax
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, __im_slow#31
  __im_load#37:
    x64.loadRegBaseDisp.word64 rax, [r14 + 0]
    x64.leaRegRegReg rax, rax, r12
    x64.loadRegBaseDisp.byte rax, [rax + 0]
  __im_loaded:
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rdx, [r14 + 40]
    x64.cmpRegImm32 rdx, 0
    x64.jcc equal, critsplit#43
  __im_empty#38:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __im_slow#31
  critsplit#44:
    x64.xchgRegReg rcx, rax
    x64.jmp __im_cont#30
  critsplit#43:
    x64.xchgRegReg rcx, rax
    x64.jmp __im_cont#30
  __im_slow#31:
    x64.movRegReg rcx, r14
    x64.movRegReg rdx, r12
    x64.callDirect __managed_get
    x64.movRegReg rcx, r8
    x64.movRegReg rax, r10
  __im_cont#30:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, tryok#17
  tryerr#18:
    x64.movRegImm32 r12, 2
    x64.movRegReg rcx, rbx
