// Test: slab-allocator.every-size-class-keeps-its-own-bytes
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte
typealias Bufs = Array with ByteArray
typealias Len = int(0 to 4096)

function build(n Len) returns ByteArray
	var b = ByteArray.create()
	b.reserve(n)
	for i in 0 upto n 'fill'
		b.push(((i + n) mod 251) as Byte)
	end 'fill'
	return b
end 'build'

function main() returns ExitCode
	var bufs = Bufs.create()
	for n in 1 upto 261 'alloc'
		bufs.push(build(n as Len))
	end 'alloc'

	var bad = 0
	for n in 1 upto 261 'check'
		let b = try bufs.get(n - 1) otherwise return 1
		if b.count() != n 'length'
			bad = bad + 1
		end 'length'
		for i in 0 upto n 'bytes'
			let got = try b.get(i) otherwise return 2
			if got != ((i + n) mod 251) 'value'
				bad = bad + 1
			end 'value'
		end 'bytes'
	end 'check'

	if bad != 0 'corrupted'
		return 3
	end 'corrupted'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @build {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic#6
  __rc_chk#7:
    x64.cmpRegImm32 rbx, 4096
    x64.jcc lessEqual, __rc_ok#5
  __rc_panic#6:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#5:
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect Array.reserve
    x64.movRegImm32 r13, 0
  forhdr:
    x64.cmpRegReg r13, rbx
    x64.jcc greaterEqual, forexit
  fill:
    x64.leaRegRegReg rsi, r13, rbx
    x64.movRegImm rax, 2351776136887273513
    x64.imulHighReg rsi
    x64.sarRegImm8 rdx, rdx, 5
    x64.movRegReg rax, rdx
    x64.shrRegImm8 rax, rdx, 63
    x64.leaRegRegReg rax, rdx, rax
    x64.imulRegRegImm32 rax, rax, 251
    x64.movRegReg rdx, rsi
    x64.subRegReg rdx, rsi, rax
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __rc_panic#9
  __rc_chk#10:
    x64.cmpRegImm32 rdx, 255
    x64.jcc lessEqual, __rc_ok#8
  __rc_panic#9:
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#8:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_push
  forstep:
    x64.leaRegRegImm32 r13, r13, 1
    x64.jmp forhdr
  forexit:
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __managed_decref]
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 1
  forhdr#1:
    x64.cmpRegImm32 r12, 261
    x64.jcc greaterEqual, forexit#4
  alloc:
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
