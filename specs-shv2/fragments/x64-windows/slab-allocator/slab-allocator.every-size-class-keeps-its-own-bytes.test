    x64.sarRegImm8 rdx, rdx, 5
    x64.movRegReg rax, rdx
    x64.shrRegImm8 rax, rdx, 63
    x64.leaRegRegReg rax, rdx, rax
    x64.imulRegRegImm32 rax, rax, 251
    x64.subRegReg rsi, rsi, rax
    x64.cmpRegReg rcx, rsi
    x64.jcc equal, critsplit#40
  value:
    x64.leaRegRegImm32 rax, r15, 1
    x64.jmp forstep#15
  critsplit#40:
    x64.movRegReg rax, r15
  forstep#15:
    x64.leaRegRegImm32 r12, r12, 1
