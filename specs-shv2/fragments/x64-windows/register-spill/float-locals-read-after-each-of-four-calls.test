    x64.jmp __il_body#10
  __il_body#10:
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp __il_cont#5
  __il_cont#5:
    x64.cvttsd2siRegReg rcx, xmm0
    x64.leaRegRegReg rax, rax, rcx
    x64.cvttsd2siRegReg rcx, xmm1
    x64.leaRegRegReg rax, rax, rcx
    x64.jmp __il_body#11
  __il_body#11:
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp __il_cont#4
  __il_cont#4:
    x64.cvttsd2siRegReg rcx, xmm0
    x64.leaRegRegReg rax, rax, rcx
    x64.cvttsd2siRegReg rcx, xmm1
    x64.leaRegRegReg r8, rax, rcx
