// Test: float-locals-read-after-each-of-four-calls
function work(x int) returns int
	return x + 1
end 'work'

function main() returns ExitCode
	let a = 1.5
	let b = 2.5
	var acc = 0
	acc = work(acc)
	acc = acc + trunc(a) + trunc(b)
	acc = work(acc)
	acc = acc + trunc(a) + trunc(b)
	acc = work(acc)
	acc = acc + trunc(a) + trunc(b)
	acc = work(acc)
	acc = acc + trunc(a) + trunc(b)
	return acc
end 'main'
---
ExitCode: 16
---
