// Test: remat-constant-live-only-around-the-back-edge
function leaf(x int) returns int
	return x + 1
end 'leaf'

function loopDivisor(p int) returns int
	let c = 7
	var a1 = p + 1
	var a2 = p + 2
	var a3 = p + 3
	var a4 = p + 4
	var a5 = p + 5
	var a6 = p + 6
	var i = 0
	while i mod c < 3 'loop'
		a1 = a1 + leaf(i)
		a2 = a2 + a1
		a3 = a3 + a2
		a4 = a4 + a3
		a5 = a5 + a4
		a6 = a6 + a5
		i = i + 1
	end 'loop'
	return a1 + a2 + a3 + a4 + a5 + a6
end 'loopDivisor'

function main() returns ExitCode
	let r = loopDivisor(1)
	if r == 494 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @leaf {
  entry:
    x64.leaRegRegImm32 r8, rcx, 1
    x64.ret
}

func @loopDivisor {
  entry:
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 64
    x64.movRegImm32 rbx, 7
    x64.leaRegRegImm32 r12, rcx, 1
    x64.leaRegRegImm32 r13, rcx, 2
    x64.leaRegRegImm32 r14, rcx, 3
    x64.leaRegRegImm32 r15, rcx, 4
    x64.leaRegRegImm32 rax, rcx, 5
    x64.leaRegRegImm32 rcx, rcx, 6
    x64.movRegImm32 rsi, 0
    x64.jmp whilehdr
  whilehdr:
    x64.storeSlotReg slot2, rax
    x64.storeSlotReg slot1, rcx
    x64.storeSlotReg slot0, rsi
    x64.movRegReg rax, rsi
    x64.cqo
    x64.idivReg rbx
    x64.cmpRegImm32 rdx, 3
    x64.jcc less, loop
    x64.jmp whileexit
  loop:
    x64.movRegReg rcx, rsi
    x64.callDirect leaf
    x64.leaRegRegReg r12, r12, r8
    x64.leaRegRegReg r13, r13, r12
    x64.leaRegRegReg r14, r14, r13
    x64.leaRegRegReg r15, r15, r14
    x64.loadRegSlot rax, slot2
    x64.leaRegRegReg rax, rax, r15
    x64.loadRegSlot rcx, slot1
    x64.leaRegRegReg rcx, rcx, rax
    x64.loadRegSlot rdx, slot0
    x64.leaRegRegImm32 rsi, rdx, 1
    x64.jmp whilehdr
  whileexit:
    x64.leaRegRegReg rax, r12, r13
    x64.leaRegRegReg rax, rax, r14
    x64.leaRegRegReg rax, rax, r15
    x64.loadRegSlot rcx, slot2
    x64.leaRegRegReg rax, rax, rcx
    x64.loadRegSlot rcx, slot1
    x64.leaRegRegReg r8, rax, rcx
    x64.epilogue 64
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.ret
}

func @main {
  entry:
    x64.prologue 40
    x64.movRegImm32 rcx, 1
    x64.callDirect loopDivisor
    x64.cmpRegImm32 r8, 494
    x64.jcc equal, ok
    x64.jmp ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.epilogue 40
    x64.ret
}
