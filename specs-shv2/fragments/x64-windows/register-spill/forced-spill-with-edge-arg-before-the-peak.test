// Test: forced-spill-with-edge-arg-before-the-peak
function leaf(x int) returns int
	return x + 1
end 'leaf'

function edgeAnchor(p int, q int) returns int
	let t = p + q
	let a1 = p + 1
	let a2 = p + 2
	let a3 = p + 3
	let a4 = p + 4
	let a5 = p + 5
	let a6 = p + 6
	let a7 = p + 7
	let a8 = p + 8
	var m = 0
	if p > 0 'br'
		m = t
	end 'br'
	let r = leaf(p)
	return a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + m + r + t
end 'edgeAnchor'

function main() returns ExitCode
	if edgeAnchor(1, q: 2) != 52 'taken'
		return 1
	end 'taken'
	if edgeAnchor(0, q: 2) != 39 'skipped'
		return 2
	end 'skipped'
	return 0
end 'main'
---
ExitCode: 0
---
func @edgeAnchor {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.leaRegRegReg rax, rcx, rdx
    x64.leaRegRegImm32 rdx, rcx, 1
    x64.leaRegRegImm32 rsi, rcx, 2
    x64.leaRegRegImm32 rdi, rcx, 3
    x64.leaRegRegImm32 r8, rcx, 4
    x64.leaRegRegImm32 r9, rcx, 5
    x64.leaRegRegImm32 r10, rcx, 6
    x64.leaRegRegImm32 r11, rcx, 7
    x64.leaRegRegImm32 rbx, rcx, 8
    x64.movRegImm32 r12, 0
    x64.cmpRegImm32 rcx, 0
    x64.jcc lessEqual, __il_body
  br:
    x64.movRegReg r12, rax
  __il_body:
    x64.leaRegRegImm32 rcx, rcx, 1
  __il_cont:
    x64.leaRegRegReg rdx, rdx, rsi
    x64.leaRegRegReg rdx, rdx, rdi
    x64.leaRegRegReg rdx, rdx, r8
    x64.leaRegRegReg rdx, rdx, r9
    x64.leaRegRegReg rdx, rdx, r10
    x64.leaRegRegReg rdx, rdx, r11
    x64.leaRegRegReg rdx, rdx, rbx
    x64.leaRegRegReg rdx, rdx, r12
    x64.leaRegRegReg rcx, rdx, rcx
    x64.leaRegRegReg r8, rcx, rax
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 2
    x64.callDirect edgeAnchor
    x64.cmpRegImm32 r8, 52
    x64.jcc equal, ifcont#2
  taken:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegImm32 rcx, 0
    x64.movRegImm32 rdx, 2
    x64.callDirect edgeAnchor
    x64.cmpRegImm32 r8, 39
    x64.jcc equal, ifcont#4
  skipped:
    x64.movRegImm32 r8, 2
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
