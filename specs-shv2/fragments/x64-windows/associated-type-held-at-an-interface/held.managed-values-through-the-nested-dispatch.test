func @widthOf {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegReg rbx, rdx
    x64.movRegImm32 r12, 0
    x64.loadRegBaseDisp.word64 rax, [rbx + 32]
    x64.leaRegRegReg r13, rbx, rax
    x64.callMem [rbx + 24]
    x64.movRegReg rbx, r8
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, critsplit
    x64.jmp forempty
  critsplit:
    x64.jmp forhdr
  forhdr:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, walk
    x64.jmp forexit
  walk:
    x64.movRegReg rcx, rbx
    x64.callMem [r13 + 24]
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r14
    x64.callDirect String.byteLength
    x64.leaRegRegReg r12, r12, r8
    x64.movRegReg rcx, r14
    x64.callDirect __str_decref
    x64.jmp forstep
  forstep:
    x64.movRegReg rcx, rbx
    x64.callMem [r13 + 32]
    x64.movRegReg rax, r10
    x64.jmp forhdr
  forexit:
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, rbx
    x64.callDirect __drop_existential
    x64.movRegReg r8, r12
    x64.jmp forjoin
  forempty:
    x64.movRegReg r8, r12
    x64.jmp forjoin
  forjoin:
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

