// Test: method-statement-after-continue-in-loop
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

function build(n Integer) returns Integer
	var arr = IntArray.create()
	var i = 0
	while i < n 'loop'
		i = i + 1
		if i == 2 'skip'
			continue
		end 'skip'
		if n > 1 'grow'
			arr = IntArray.create()
		end 'grow'
		arr.reserve(4)
	end 'loop'
	return arr.count()
end 'build'

function main() returns ExitCode
	print("{build(5)}")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @build {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __arr_create
    x64.movRegImm32 rax, 0
    x64.movRegReg r12, r8
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegReg rax, rbx
    x64.jcc less, loop
    x64.jmp whileexit
  loop:
    x64.leaRegRegImm32 r13, rax, 1
    x64.cmpRegImm32 r13, 2
    x64.jcc equal, skip
    x64.jmp ifcont
  skip:
    x64.movRegReg rax, r13
    x64.jmp whilehdr
  ifcont:
    x64.cmpRegImm32 rbx, 1
    x64.jcc greater, grow
    x64.jmp critsplit
  grow:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __arr_create
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r12
    x64.callDirect __arr_decref
    x64.jmp ifcont
  critsplit:
    x64.movRegReg r14, r12
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 rdx, 4
    x64.movRegReg rcx, r14
    x64.callDirect __arr_reserve
    x64.movRegReg r12, r14
    x64.movRegReg rax, r13
    x64.jmp whilehdr
  whileexit:
    x64.movRegReg rcx, r12
    x64.callDirect __arr_count
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, r12
    x64.callDirect __arr_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rcx, 5
    x64.callDirect build
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __int_to_string
    x64.movRegReg rbx, r8
    x64.leaRegRegImm32 rcx, rbx, 49
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.leaRegRegImm32 r14, r13, 48
    x64.movRegReg rcx, r14
    x64.movRegReg rdx, r12
    x64.movRegReg rax, rbx
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r14, rbx
    x64.storeBaseDispReg.word64 [r13 + 0], r14
    x64.storeBaseDispReg.word64 [r13 + 8], rbx
    x64.movRegImm rax, -3
    x64.storeBaseDispReg.word64 [r13 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r13 + 24], rax
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r13
    x64.callDirect __print_string
    x64.movRegReg rcx, r13
    x64.callDirect __str_decref
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
