    x64.jcc above, reciprocal
    x64.jmp ifcont#8
  reciprocal:
    x64.movsdRegRip xmm6, [rip + __fconst_6]
    x64.movsdRegRip xmm1, [rip + __fconst_5]
    x64.movsdRegRip xmm2, [rip + __fconst_4]
    x64.ucomisdRegReg xmm0, xmm2
    x64.setccReg notEqual, rcx
    x64.setccReg parity, rdx
