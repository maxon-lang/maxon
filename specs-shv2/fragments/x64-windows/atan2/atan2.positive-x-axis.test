    x64.pushReg rbx
    x64.prologue 56
    x64.storeSlotReg slot0, xmm6
    x64.storeSlotReg slot1, xmm7
    x64.movRegReg xmm6, xmm0
    x64.movRegReg xmm7, xmm1
    x64.movRegReg xmm0, xmm6
    x64.callDirect Math.hasNegativeSignBit
    x64.movRegReg rbx, r8
    x64.movsdRegRip xmm0, [rip + __fconst_4]
    x64.ucomisdRegReg xmm7, xmm0
    x64.jcc parity, ifcont#10
    x64.jmp fordered#17
