// Test: while-loops.continue
function main() returns ExitCode
	var sum = 0
	var i = 0
	while i < 5 'loop'
		i = i + 1
		if i == 3 'skip'
			continue
		end 'skip'
		sum = sum + i
	end 'loop'
	return sum
end 'main'
---
ExitCode: 12
---
func @main {
  entry:
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 0
    x64.movRegReg r8, rax
    x64.jmp whilehdr
  whilehdr:
    x64.movRegImm32 rax, 5
    x64.cmpRegReg rcx, rax
    x64.jcc less, loop
    x64.jmp whileexit
  loop:
    x64.movRegImm32 rax, 1
    x64.addRegReg rcx, rax
    x64.movRegImm32 rax, 3
    x64.cmpRegReg rcx, rax
    x64.jcc equal, skip
    x64.jmp ifcont
  whileexit:
    x64.ret
  skip:
    x64.jmp whilehdr
  ifcont:
    x64.addRegReg r8, rcx
    x64.jmp whilehdr
}
