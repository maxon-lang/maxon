// Test: while-loops.continue
function main() returns ExitCode
	var sum = 0
	var i = 0
	while i < 5 'loop'
		i = i + 1
		if i == 3 'skip'
			continue
		end 'skip'
		sum = sum + i
	end 'loop'
	return sum
end 'main'
---
ExitCode: 12
---
func @main {
  entry:
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 0
    x64.jmp whilehdr
  whilehdr:
    x64.movRegImm32 rdx, 5
    x64.cmpRegReg rcx, rdx
    x64.jcc less, loop
    x64.jmp whileexit
  loop:
    x64.movRegImm32 r9, 1
    x64.movRegReg r10, rcx
    x64.addRegReg r10, r9
    x64.movRegImm32 r11, 3
    x64.cmpRegReg r10, r11
    x64.jcc equal, skip
    x64.jmp ifcont
  whileexit:
    x64.movRegReg r8, rax
    x64.ret
  skip:
    x64.movRegReg rcx, r10
    x64.jmp whilehdr
  ifcont:
    x64.addRegReg rax, r10
    x64.movRegReg rcx, r10
    x64.jmp whilehdr
}
