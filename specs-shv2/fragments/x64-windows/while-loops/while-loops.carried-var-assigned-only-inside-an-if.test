// Test: while-loops.carried-var-assigned-only-inside-an-if
function main() returns ExitCode
	var x = 1
	var i = 0
	while i < 3 'l'
		if i == 1 'b'
			x = 2
		end 'b'
		i = i + 1
	end 'l'
	return x
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    x64.movRegImm32 r8, 1
    x64.movRegImm32 rax, 0
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegImm32 rax, 3
    x64.jcc less, l
    x64.jmp whileexit
  l:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, b
    x64.jmp critsplit
  b:
    x64.movRegImm32 rcx, 2
    x64.jmp ifcont
  critsplit:
    x64.movRegReg rcx, r8
    x64.jmp ifcont
  ifcont:
    x64.leaRegRegImm32 rax, rax, 1
    x64.movRegReg r8, rcx
    x64.jmp whilehdr
  whileexit:
    x64.ret
}
