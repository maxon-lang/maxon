// Test: while-loops.zero-iterations
function main() returns ExitCode
	var x = 10
	while x < 5 'loop'
		x = x + 1
	end 'loop'
	return x
end 'main'
---
ExitCode: 10
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 10
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegImm32 r8, 5
    x64.jcc less, loop
    x64.jmp whileexit
  loop:
    x64.leaRegRegImm32 r8, r8, 1
    x64.jmp whilehdr
  whileexit:
    x64.popReg rbp
    x64.ret
}
