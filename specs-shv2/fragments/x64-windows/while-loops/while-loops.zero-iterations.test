// Test: while-loops.zero-iterations
function main() returns ExitCode
	var x = 10
	while x < 5 'loop'
		x = x + 1
	end 'loop'
	return x
end 'main'
---
ExitCode: 10
---
func @main {
  entry:
    x64.movRegImm32 rax, 10
    x64.jmp whilehdr
  whilehdr:
    x64.movRegImm32 rcx, 5
    x64.cmpRegReg rax, rcx
    x64.jcc less, loop
    x64.jmp whileexit
  loop:
    x64.movRegImm32 rdx, 1
    x64.addRegReg rax, rdx
    x64.jmp whilehdr
  whileexit:
    x64.movRegReg r8, rax
    x64.ret
}
