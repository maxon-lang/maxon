// Test: while-loops.break
function main() returns ExitCode
	var x = 5
	while true 'loop'
		x = x + 2
		if x == 11 'check'
			break
		end 'check'
	end 'loop'
	return x
end 'main'
---
ExitCode: 11
---
func @main {
  entry:
    x64.movRegImm32 rax, 5
    x64.jmp whilehdr
  whilehdr:
    x64.movRegImm32 rcx, 1
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, loop
    x64.jmp critsplit
  loop:
    x64.leaRegRegImm32 r8, rax, 2
    x64.cmpRegImm32 r8, 11
    x64.jcc equal, check
    x64.jmp ifcont
  check:
    x64.jmp whileexit
  ifcont:
    x64.movRegReg rax, r8
    x64.jmp whilehdr
  critsplit:
    x64.movRegReg r8, rax
    x64.jmp whileexit
  whileexit:
    x64.ret
}
