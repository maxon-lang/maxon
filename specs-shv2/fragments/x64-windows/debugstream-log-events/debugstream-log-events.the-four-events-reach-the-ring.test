// Test: debugstream-log-events.the-four-events-reach-the-ring
function main() returns ExitCode
	let phase = __DebugStream.nameId("compile")
	let ev = __DebugStream.nameId("allocated")
	__DebugStream.phaseBegin(phase, 7)
	__DebugStream.event(ev, 1, 2, 7, 100, 200)
	let msg = "hello ring"
	let bytes = msg.toByteArray()
	__DebugStream.text(3, 4, 7, bytes.managed)
	__DebugStream.phaseEnd(phase, 7)
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
  __ds_base@24 = i64 0
  __ds_buf_size@32 = i64 0
  __ds_buf_mask@40 = i64 0
  __ds_start_ts@48 = i64 0
  __ds_lock@56 = i64 0
  __mm_alloc_id@64 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegImm32 rdx, 1
    x64.movRegImm32 rbx, 2
    x64.movRegImm32 rax, 7
    x64.movRegImm32 rcx, 96
    x64.callDirect __ds_emit_log_phase
    x64.movRegImm32 rdx, 1
    x64.movRegImm32 rax, 2
    x64.movRegImm32 r9, 7
    x64.movRegImm32 rsi, 100
    x64.movRegImm32 rdi, 200
    x64.movRegReg rcx, rbx
    x64.callDirect __ds_emit_log_event
    x64.leaRegRdata rcx, [rip + __str_rec_1]
    x64.callDirect String.toByteArray
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 3
    x64.movRegImm32 r13, 4
    x64.movRegImm32 r14, 7
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_retain
    x64.movRegReg r15, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r13
    x64.movRegReg rax, r14
    x64.movRegReg r9, r15
    x64.callDirect __ds_emit_log_text
    x64.movRegReg rcx, r15
    x64.callDirect __managed_decref
    x64.movRegImm32 rax, 7
    x64.movRegImm32 rcx, 97
    x64.movRegImm32 rdx, 1
    x64.callDirect __ds_emit_log_phase
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @String.toByteArray {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg rcx, rbx
    x64.callDirect __str_bytes_view
    x64.movRegReg r12, r8
    x64.movRegImm32 r13, 0
    x64.movRegReg rcx, rbx
    x64.callDirect String.byteLength
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r13
    x64.movRegReg rax, r8
    x64.callDirect __managed_slice
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_retain
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

