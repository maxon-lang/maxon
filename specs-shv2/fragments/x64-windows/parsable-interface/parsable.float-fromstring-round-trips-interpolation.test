// Test: parsable.float-fromstring-round-trips-interpolation
function main() returns ExitCode
	let a = 1.7976931348623157
	let text = "{a}"
	let b = try float.fromString(text) otherwise 0.0
	print("{text}\n")
	print("{b}\n")
	if a == b 'exact'
		return 0
	end 'exact'
	return 1
end 'main'
