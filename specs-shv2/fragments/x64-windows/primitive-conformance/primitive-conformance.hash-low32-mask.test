// Test: primitive-conformance.hash-low32-mask
typealias Wide = int(i64.min to i64.max)

type Box uses T where T is Hashable
	export var item as T
	export static function create(item T) returns Self
		return Self{ item: item }
	end 'create'
	export function itemHash() returns HashValue
		return self.item.hash()
	end 'itemHash'
end 'Box'

typealias WideBox = Box with Wide

function main() returns ExitCode
	let a = WideBox.create(42)
	if a.itemHash() != 42 'p1'
		return 1
	end 'p1'
	let b = WideBox.create(4294967303)
	if b.itemHash() != 7 'p2'
		return 2
	end 'p2'
	let c = WideBox.create(-1)
	if c.itemHash() != 4294967295 'p3'
		return 3
	end 'p3'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Box.itemHash {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rdx
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callMem [rbx + 24]
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 64
    x64.movRegImm32 rax, 42
    x64.leaRegRdata rcx, [rip + __witness_int.Hashable]
    x64.leaRegSlot rcx, slot0
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.leaRegRdata rdx, [rip + __witness_int.Hashable]
    x64.callDirect Box.itemHash
    x64.cmpRegImm32 r8, 42
    x64.jcc notEqual, p1
    x64.jmp ifcont#2
  p1:
    x64.movRegImm32 r8, 1
    x64.epilogue 64
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegImm rax, 4294967303
    x64.leaRegRdata rcx, [rip + __witness_int.Hashable]
    x64.leaRegSlot rcx, slot1
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.leaRegRdata rdx, [rip + __witness_int.Hashable]
    x64.callDirect Box.itemHash
    x64.cmpRegImm32 r8, 7
    x64.jcc notEqual, p2
    x64.jmp ifcont#4
  p2:
    x64.movRegImm32 r8, 2
    x64.epilogue 64
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegImm rax, -1
    x64.leaRegRdata rcx, [rip + __witness_int.Hashable]
    x64.leaRegSlot rcx, slot2
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.leaRegRdata rdx, [rip + __witness_int.Hashable]
    x64.callDirect Box.itemHash
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc notEqual, p3
    x64.jmp ifcont#6
  p3:
    x64.movRegImm32 r8, 3
    x64.epilogue 64
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.movRegImm32 r8, 0
    x64.epilogue 64
    x64.popReg rbp
    x64.ret
}

func @int.hash {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 4294967295
    x64.movRegReg r8, rcx
    x64.andRegReg r8, rcx, rax
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_12]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
