// Test: primitive-conformance.hashable-and-equatable
typealias Integer = int(0 to u32.max)

type Key uses T where T is Hashable and Equatable
	export var value as T
	export static function create(value T) returns Self
		return Self{ value: value }
	end 'create'
	export function digest() returns HashValue
		return self.value.hash()
	end 'digest'
	export function matches(other T) returns bool
		return self.value.equals(other)
	end 'matches'
end 'Key'

typealias IntKey = Key with Integer

function main() returns ExitCode
	let k = IntKey.create(7)
	if k.digest() != 7 'h'
		return 1
	end 'h'
	if not k.matches(7) 'e1'
		return 2
	end 'e1'
	if k.matches(9) 'e2'
		return 3
	end 'e2'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Key.digest {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rdx
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callMem [rbx + 24]
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Key.matches {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, r9
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callMem [rbx + 24]
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rax, 7
    x64.leaRegRdata rcx, [rip + __witness_int.Hashable]
    x64.leaRegRdata rcx, [rip + __witness_int.Equatable]
    x64.leaRegSlot rbx, slot0
    x64.storeBaseDispReg.word64 [rbx + 0], rax
    x64.leaRegRdata rdx, [rip + __witness_int.Hashable]
    x64.leaRegRdata rax, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, rbx
    x64.callDirect Key.digest
    x64.cmpRegImm32 r8, 7
    x64.jcc equal, ifcont#2
  h:
    x64.movRegImm32 r8, 1
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegImm32 rdx, 7
    x64.leaRegRdata rax, [rip + __witness_int.Hashable]
    x64.leaRegRdata r9, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, rbx
    x64.callDirect Key.matches
    x64.xorRegImm32 r8, r8, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#4
  e1:
    x64.movRegImm32 r8, 2
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegImm32 rdx, 9
    x64.leaRegRdata rax, [rip + __witness_int.Hashable]
    x64.leaRegRdata r9, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, rbx
    x64.callDirect Key.matches
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#6
  e2:
    x64.movRegImm32 r8, 3
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
