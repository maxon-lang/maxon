// Test: keyword-prefix-ident-returns
function main() returns ExitCode
	let returnsX = 7
	return returnsX - 7
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 7
    x64.leaRegRegImm32 r8, rax, -7
    x64.popReg rbp
    x64.ret
}
