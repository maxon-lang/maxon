// Test: merged-tuple-copies-at-every-hand-off

typealias Num = int(i64.min to i64.max)

enum Fail
	nope
end 'Fail'

function risky(ok bool) returns (Num, Num) throws Fail
	if ok 'ok'
		return (7, 8)
	end 'ok'
	throw Fail.nope
end 'risky'

function viaMerge(t (Num, Num), c bool) returns (Num, Num)
	return t if c else (7, 8)
end 'viaMerge'

function viaFallback(t (Num, Num)) returns (Num, Num)
	return try risky(false) otherwise t
end 'viaFallback'

function viaBinding(t (Num, Num)) returns Num
	var q = t
	q.1 = 55
	return 0
end 'viaBinding'

function main() returns ExitCode
	var a = (1, 2)
	var b = viaMerge(a, c: true)
	b.1 = 99

	var m = (1, 2)
	var n = viaFallback(m)
	n.1 = 99

	var g = (1, 2)
	let z = viaBinding(g)

	print("merged a.1={a.1} fallback m.1={m.1} binding g.1={g.1} z={z}")
	return (a.1 + m.1 + g.1 + 9) as ExitCode
end 'main'
---
ExitCode: 68
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @risky {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, ok
    x64.jmp ifcont
  ok:
    x64.movRegImm32 rbx, 7
    x64.movRegImm32 r12, 8
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.storeBaseDispReg.word64 [r8 + 8], r12
    x64.movRegImm32 r10, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 r10, rax, 1
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @viaMerge {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.cmpRegImm32 rdx, 0
    x64.jcc notEqual, ternarytrue
    x64.jmp ternaryfalse
  ternarytrue:
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.storeBaseDispReg.word64 [r8 + 8], rax
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegImm32 rbx, 7
    x64.movRegImm32 r12, 8
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.storeBaseDispReg.word64 [r8 + 8], r12
    x64.jmp matchcont
  matchcont:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @viaFallback {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 0
    x64.callDirect risky
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.storeBaseDispReg.word64 [r8 + 8], rax
    x64.jmp trycont
  tryok:
    x64.jmp trycont
  trycont:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @viaBinding {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.callDirect __mm_retain
    x64.movRegImm32 rax, 55
    x64.storeBaseDispReg.word64 [r8 + 8], rax
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

