// Test: managed-file.unknown-instance-method-is-refused-by-name
function main() returns ExitCode
	let f = try __ManagedFile.openRead("nonexistent_unknown_method_xyz.txt".toByteArray().managed) otherwise 'nf'
		return 1
	end 'nf'
	let n = f.seek(0)
	return 0
end 'main'
