// Test: managed-file.open-read-nonexistent
function main() returns ExitCode
	try __ManagedFile.openRead("nonexistent_file_xyz_98765.txt".toByteArray().managed) otherwise 'notFound'
		print("not found")
		return 42
	end 'notFound'
	return 0
end 'main'
---
ExitCode: 42
---
