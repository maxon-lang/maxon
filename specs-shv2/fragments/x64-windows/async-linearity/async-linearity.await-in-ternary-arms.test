// Test: async-linearity.await-in-ternary-arms
function makeValue() returns int
	Runtime.yield()
	return 21
end 'makeValue'

function no() returns bool
	return false
end 'no'

function main() returns ExitCode
	let p = async makeValue()
	let v = (await p) if no() else (await p)
	return (v + 1) as ExitCode
end 'main'
---
ExitCode: 22
---
data {
  __mm_alloc_count@0 = i64 0
  __gt_current_gt@8 = i64 0
  __gt_run_queue_head@16 = i64 0
  __gt_run_queue_tail@24 = i64 0
  __gt_init_done@32 = i64 0
  __gt_system_stack_top@40 = i64 0
  __gt_timer_count@48 = i64 0
  __gt_timer_heap_base@56 = i64 0
  __gt_timer_capacity@64 = i64 0
  __gt_trace_counter@72 = i64 0
  __gt_trace_digits@80 = i64 0
  __gt_clock_ticks@88 = i64 0
  __gt_clock_freq@96 = i64 0
  __gt_proc_count@104 = i64 0
  __gt_proc_handles_base@112 = i64 0
  __gt_proc_gts_base@120 = i64 0
  __gt_live_count@128 = i64 0
  __slab_arena_list@136 = i64 0
  __slab_arena_map_l1@144 = i64 0
  __slab_state@152 = i64 0
}

func @makeValue {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect Runtime.yield
    x64.movRegImm32 r8, 21
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @no {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.leaRegFunc rcx, [rip + makeValue]
    x64.callDirect __gt_spawn
    x64.movRegReg rbx, r8
    x64.callDirect no
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, ternarytrue
    x64.jmp ternaryfalse
  ternarytrue:
    x64.movRegReg rcx, rbx
    x64.callDirect __gt_await
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegReg rcx, rbx
    x64.callDirect __gt_await
    x64.jmp matchcont
  matchcont:
    x64.leaRegRegImm32 r8, r8, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Runtime.yield {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __gt_resched
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
