// Test: error.bare-int-parameter
function add(a int, b int) returns ExitCode
	return 0
end 'add'

function main() returns ExitCode
	return add(1, b: 2)
end 'main'
---
CompilerError:
error E3005: <fragment>:2:16: Cannot use bare 'int' as a type. Define a typealias with range constraints, e.g., typealias MyInt = int(0 to 100)
