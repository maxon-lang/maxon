// Test: error.negative-out-of-range
typealias Positive = int(1 to 100)

function main() returns ExitCode
	let x = -5 as Positive
	return x
end 'main'
---
CompilerError:
error E3005: <fragment>:5:13: Value -5 is outside the range of 'Positive' (int(1 to 100))
error E3005: <fragment>:6:2: Value -5 is outside the range of 'ExitCode' (int(0 to 4294967295))
