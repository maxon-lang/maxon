// Test: type-parameter-argument-in-range
typealias Wide = int(0 to 1000)
typealias Percent = int(0 to 100)

type Box uses T
	export var v as T

	static function create(seed T) returns Self
		return Self{v: seed}
	end 'create'

	export function put(value T)
		self.v = value
	end 'put'
end 'Box'

typealias PB = Box with Percent

function grow(n Wide) returns Wide
	return n * 11
end 'grow'

function main() returns ExitCode
	var b = PB.create(1)
	b.put(grow(5))
	return b.v
end 'main'
---
ExitCode: 55
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.movRegImm32 rax, 1
    x64.leaRegSlot rcx, slot0
    x64.storeBaseDispReg.word64 [rcx + 0], rax
  __rc_ok:
    x64.movRegImm32 rax, 55
  __il_cont#4:
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rax, 100
    x64.jcc lessEqual, __il_body
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
  __il_body:
    x64.storeBaseDispReg.word64 [rcx + 0], rax
  __il_cont#11:
    x64.loadRegBaseDisp.word64 r8, [rcx + 0]
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}
