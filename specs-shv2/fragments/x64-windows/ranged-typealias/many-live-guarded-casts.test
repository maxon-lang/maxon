	let s22 = w22 as Small
	let s23 = w23 as Small
	acc = acc + s0
	acc = acc + s1
	acc = acc + s2
	acc = acc + s3
	acc = acc + s4
	acc = acc + s5
	acc = acc + s6
	acc = acc + s7
