	let s13 = w13 as Small
	let s14 = w14 as Small
	let s15 = w15 as Small
	let s16 = w16 as Small
	let s17 = w17 as Small
	let s18 = w18 as Small
	let s19 = w19 as Small
	let s20 = w20 as Small
	let s21 = w21 as Small
	let s22 = w22 as Small
	let s23 = w23 as Small
	acc = acc + s0
	acc = acc + s1
	acc = acc + s2
	acc = acc + s3
	acc = acc + s4
	acc = acc + s5
	acc = acc + s6
	acc = acc + s7
	acc = acc + s8
	acc = acc + s9
	acc = acc + s10
	acc = acc + s11
	acc = acc + s12
	acc = acc + s13
	acc = acc + s14
	acc = acc + s15
	acc = acc + s16
	acc = acc + s17
	acc = acc + s18
	acc = acc + s19
	acc = acc + s20
	acc = acc + s21
	acc = acc + s22
	acc = acc + s23
	if acc == 300 'summed'
		return 24
	end 'summed'
	return 1
end 'main'
