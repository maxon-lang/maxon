	let w20 = widen(20)
	let w21 = widen(21)
	let w22 = widen(22)
	let w23 = widen(23)
	let s0 = w0 as Small
	let s1 = w1 as Small
	let s2 = w2 as Small
	let s3 = w3 as Small
	let s4 = w4 as Small
	let s5 = w5 as Small
	let s6 = w6 as Small
	let s7 = w7 as Small
	let s8 = w8 as Small
	let s9 = w9 as Small
	let s10 = w10 as Small
	let s11 = w11 as Small
