// Test: range-id-comparison
function main() returns ExitCode
	let x = i32.max
	if x == 2147483647 'isMax'
		return 1
	end 'isMax'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  isMax:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}
