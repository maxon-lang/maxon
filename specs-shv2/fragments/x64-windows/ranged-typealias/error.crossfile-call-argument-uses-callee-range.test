// Test: error.crossfile-call-argument-uses-callee-range
// --- file: lib.maxon
typealias Limit = int(0 to 10)

export function narrow(x Limit) returns Limit
	return x
end 'narrow'

// --- file: main.maxon
typealias Limit = int(0 to 1000)

function main() returns ExitCode
	return narrow(500)
end 'main'
---
CompilerError:
error E3005: <fragment>:13:9: Value 500 is outside the range of 'Limit' (int(0 to 10))
