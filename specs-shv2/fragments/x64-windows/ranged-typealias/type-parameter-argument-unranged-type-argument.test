// Test: type-parameter-argument-unranged-type-argument
typealias FullInt = int(i64.min to i64.max)

type Box uses T
	export var v as T

	static function create(seed T) returns Self
		return Self{v: seed}
	end 'create'

	export function put(value T)
		self.v = value
	end 'put'
end 'Box'

typealias IB = Box with FullInt

function main() returns ExitCode
	var b = IB.create(1)
	b.put(1000000)
	return 42
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 16
    x64.movRegImm32 rax, 1
    x64.leaRegSlot rcx, slot0
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 rax, 1000000
    x64.jmp __il_body
  __il_body:
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.jmp __il_cont
  __il_cont:
    x64.movRegImm32 r8, 42
    x64.epilogue 16
    x64.popReg rbp
    x64.ret
}
