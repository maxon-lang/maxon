// Test: top-level-float-cast-in-range
typealias Pct = float(0.0 to 100.0)

let GOOD = 50.0 as Pct

function main() returns ExitCode
	return trunc(GOOD)
end 'main'
---
ExitCode: 50
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 50
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
