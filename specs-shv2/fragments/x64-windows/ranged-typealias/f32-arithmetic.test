// Test: f32-arithmetic
typealias F = float(f32.min to f32.max)

function main() returns ExitCode
	let a = 10.0 as F
	let b = 3.0 as F
	let sum = a + b
	let diff = a - b
	let prod = a * b
	let quot = a / b
	return trunc(sum + diff + prod + quot)
end 'main'
---
ExitCode: 53
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movsdRegRip xmm0, [rip + __fconst_10]
    x64.movsdRegRip xmm1, [rip + __fconst_3]
    x64.movRegReg xmm2, xmm0
    x64.addsdRegReg xmm2, xmm0, xmm1
    x64.movRegReg xmm3, xmm0
    x64.subsdRegReg xmm3, xmm0, xmm1
    x64.movRegReg xmm4, xmm0
    x64.mulsdRegReg xmm4, xmm0, xmm1
    x64.divsdRegReg xmm0, xmm0, xmm1
    x64.addsdRegReg xmm2, xmm2, xmm3
    x64.addsdRegReg xmm2, xmm2, xmm4
    x64.addsdRegReg xmm2, xmm2, xmm0
    x64.cvttsd2siRegReg r8, xmm2
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at f32-arithmetic.test:11: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
