// Test: float-runtime-negative-bound-in-range
typealias Neg = float(-100.0 to -1.0)
typealias Wide = float(f64.min to f64.max)

function scale(x Wide) returns Wide
	return x * 2.0
end 'scale'

function main() returns ExitCode
	let v = scale(-25.0)
	let n = v as Neg
	return trunc(-n)
end 'main'
---
ExitCode: 50
---
