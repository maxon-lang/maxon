    x64.ucomisdRegReg xmm1, xmm0
    x64.jcc above, __rc_panic#2
  __rc_chk#3:
    x64.movsdRegRip xmm1, [rip + __fconst_-1]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc belowEqual, __rc_ok#1
  __rc_panic#2:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at float-runtime-negative-bound-in-range.test:11: Range check failed: value outside typealias 'Neg'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#1:
    x64.negF64RegReg xmm0, xmm0
    x64.cvttsd2siRegReg r8, xmm0
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#5
  __rc_chk#6:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok#4
  __rc_panic#5:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at float-runtime-negative-bound-in-range.test:12: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
