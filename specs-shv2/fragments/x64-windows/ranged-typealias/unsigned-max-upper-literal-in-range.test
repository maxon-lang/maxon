// Test: unsigned-max-upper-literal-in-range
typealias Big = int(5 to u64.max)

function main() returns ExitCode
	let x = -1 as Big
	if x == u64.max 'ok'
		return 7
	end 'ok'
	return 3
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm rax, 18446744073709551615
    x64.leaRegRegImm32 rax, rax, 0
    x64.cmpRegImm32 rax, -1
    x64.jcc equal, ok
    x64.jmp ifcont
  ok:
    x64.movRegImm32 r8, 7
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 3
    x64.popReg rbp
    x64.ret
}
