// Test: signed-range-admits-a-written-negative
typealias Offset = int(-10 to 10)

function take(o Offset) returns Offset
	return o
end 'take'

function main() returns ExitCode
	if take(-5) == -5 'ok'
		return 7
	end 'ok'
	return 3
end 'main'
---
ExitCode: 7
---
func @take {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, -10
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 rcx, 10
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rcx
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm rcx, 18446744073709551611
    x64.jmp __il_body
  __il_body:
    x64.cmpRegImm32 rcx, -10
    x64.jcc less, __il_slow
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 rcx, 10
    x64.jcc greater, __il_slow
    x64.jmp __rc_ok
  __il_slow:
    x64.callDirect take
    x64.jmp __il_cont
  __rc_ok:
    x64.movRegReg r8, rcx
    x64.jmp __il_cont
  __il_cont:
    x64.cmpRegImm32 r8, -5
    x64.jcc equal, ok
    x64.jmp ifcont
  ok:
    x64.movRegImm32 r8, 7
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 3
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
