// Test: field-store-runtime-panic
typealias Wide = int(0 to 1000)
typealias Percent = int(0 to 100)

type Box
	export var v as Percent

	static function create() returns Self
		return Self{v: 1}
	end 'create'
end 'Box'

function grow(n Wide) returns Wide
	return n * 101
end 'grow'

function main() returns ExitCode
	var b = Box.create()
	b.v = grow(5)
	return b.v
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @grow {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic#2
  __rc_chk#3:
    x64.cmpRegImm32 rcx, 1000
    x64.jcc lessEqual, __rc_ok#1
  __rc_panic#2:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#1:
    x64.imulRegRegImm32 r8, rcx, 101
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#5
  __rc_chk#6:
    x64.cmpRegImm32 r8, 1000
    x64.jcc lessEqual, __rc_ok#4
  __rc_panic#5:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#4:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.leaRegSlot rbx, slot0
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [rbx + 0], rax
    x64.movRegImm32 rcx, 5
  __il_body:
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __il_slow
  __rc_chk#7:
    x64.cmpRegImm32 rcx, 1000
    x64.jcc greater, __il_slow
  __rc_ok#6:
    x64.imulRegRegImm32 rax, rcx, 101
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __il_slow
  __rc_chk#9:
    x64.cmpRegImm32 rax, 1000
    x64.jcc lessEqual, __rc_ok#8
  __il_slow:
    x64.callDirect grow
    x64.jmp __il_cont
  __rc_ok#8:
    x64.movRegReg r8, rax
  __il_cont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk#3:
    x64.cmpRegImm32 r8, 100
    x64.jcc lessEqual, __rc_ok#1
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#1:
    x64.storeBaseDispReg.word64 [rbx + 0], r8
    x64.loadRegBaseDisp.word64 r8, [rbx + 0]
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
