	let v18 = widen(18)
	let v19 = widen(19)
	let v20 = widen(20)
	let v21 = widen(21)
	let v22 = widen(22)
	let v23 = widen(23)
	b.f0 = v0
	b.f1 = v1
	b.f2 = v2
	b.f3 = v3
	b.f4 = v4
	b.f5 = v5
	b.f6 = v6
