// Test: fourth-guarded-return-site-fires-at-its-own-site
typealias Small = int(0 to 100)
typealias Wide = int(0 to 100000)

function pick(n Wide) returns Small
	if n == 0 'a'
		return n + 1
	end 'a'

	if n == 1 'b'
		return n + 2
	end 'b'

	if n == 2 'c'
		return n + 3
	end 'c'

	return n * 60
end 'pick'

function main() returns ExitCode
	print("a={pick(0)}\n")
	print("b={pick(1)}\n")
	print("c={pick(2)}\n")
	print("d={pick(9)}\n")
	return 0
end 'main'
