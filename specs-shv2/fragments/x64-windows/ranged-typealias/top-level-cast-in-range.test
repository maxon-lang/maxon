// Test: top-level-cast-in-range
typealias SmallByte = int(0 to 10)

let GOOD = 7 as SmallByte

function main() returns ExitCode
	return GOOD as ExitCode
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 7
    x64.popReg rbp
    x64.ret
}
