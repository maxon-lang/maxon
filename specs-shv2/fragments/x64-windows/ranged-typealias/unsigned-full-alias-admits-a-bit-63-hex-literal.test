// Test: unsigned-full-alias-admits-a-bit-63-hex-literal
typealias Slot = int(0 to u64.max)

function take(s Slot) returns Slot
	return s
end 'take'

function main() returns ExitCode
	if take(0xFFFFFFFFFFFFFFFE) == 0xFFFFFFFFFFFFFFFE 'ok'
		return 7
	end 'ok'
	return 3
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm rax, 18446744073709551614
    x64.jmp __il_body
  __il_body:
    x64.jmp __il_cont
  __il_cont:
    x64.cmpRegImm32 rax, -2
    x64.jcc equal, ok
    x64.jmp ifcont
  ok:
    x64.movRegImm32 r8, 7
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 3
    x64.popReg rbp
    x64.ret
}
