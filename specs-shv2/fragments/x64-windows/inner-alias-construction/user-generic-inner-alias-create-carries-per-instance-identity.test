// Test: user-generic-inner-alias-create-carries-per-instance-identity
typealias ExitCode = int(0 to 125)

type Pair uses T
	typealias Idx = int(0 to 100)

	export var a as T

	export static function create(a T) returns Self
		return Self{a: a}
	end 'create'

	export function firstIndex() returns Idx
		return 3
	end 'firstIndex'

	export function offsetBy(i Idx) returns Idx
		return i + 1
	end 'offsetBy'
end 'Pair'

type Plain
	typealias IntPair = Pair with ExitCode

	static function make() returns ExitCode
		let p = IntPair.create(9)
		let i = p.firstIndex()
		return p.offsetBy(i)
	end 'make'
end 'Plain'

function main() returns ExitCode
	return Plain.make()
end 'main'
---
ExitCode: 4
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Plain.make {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.movRegImm32 rax, 9
    x64.leaRegSlot rcx, slot0
    x64.storeBaseDispReg.word64 [rcx + 0], rax
  __il_body#6:
    x64.movRegImm32 rax, 3
  __il_body#7:
    x64.leaRegRegImm32 r8, rax, 1
  __il_cont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 125
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect Plain.make
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
