// Test: extension-body-user-generic-inner-alias-create
typealias ExitCode = int(0 to 125)

type Wrapped uses T
	let value as T

	export static function create(value T) returns Self
		return Self{value: value}
	end 'create'

	export function get() returns T
		return value
	end 'get'
end 'Wrapped'

interface Tagged uses Tag
	function tag() returns Tag
end 'Tagged'

export extension Tagged
	typealias WrappedTag = Wrapped with Tag

	export function wrapped() returns WrappedTag
		return WrappedTag.create(self.tag())
	end 'wrapped'
end 'Tagged'

type Box implements Tagged with ExitCode
	export var v as ExitCode

	export static function create() returns Self
		return Self{v: 5}
	end 'create'

	export function tag() returns ExitCode
		return self.v
	end 'tag'
end 'Box'

function main() returns ExitCode
	let b = Box.create()
	return b.wrapped().get()
end 'main'
---
ExitCode: 5
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Wrapped.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Wrapped.get {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.movRegReg rcx, rdx
    x64.movRegReg rdx, rax
    x64.callDirect __retain_type_param
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @Box.wrapped {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.jmp __il_body
  __il_body:
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.jmp __il_cont
  __il_cont:
    x64.callDirect Wrapped.create
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 48
    x64.leaRegSlot rcx, slot0
    x64.movRegImm32 rax, 5
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.callDirect Box.wrapped
    x64.movRegReg rbx, r8
    x64.leaRegRdata rdx, [rip + __layout_Wrapped_ExitCode$0_125]
    x64.movRegReg rcx, rbx
    x64.callDirect Wrapped.get
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg r8, r12
    x64.epilogue 48
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
