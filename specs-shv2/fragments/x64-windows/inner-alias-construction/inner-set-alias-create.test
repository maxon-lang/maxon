// Test: inner-set-alias-create
typealias ExitCode = int(0 to 125)
typealias Count = int(0 to u64.max)

type Plain
	typealias Nums = Set with ExitCode

	static function make() returns Count
		var s = Nums.create()
		s.insert(3)
		s.insert(3)
		return s.count()
	end 'make'
end 'Plain'

function main() returns ExitCode
	let c = Plain.make()
	if c == 1 'ok'
		return 8
	end 'ok'
	return 1
end 'main'
---
ExitCode: 8
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Plain.make {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 0
    x64.callDirect __set_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 3
    x64.leaRegRdata rax, [rip + __witness_int.Hashable]
    x64.leaRegRdata r9, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, rbx
    x64.callDirect __set_insert
    x64.movRegImm32 rdx, 3
    x64.leaRegRdata rax, [rip + __witness_int.Hashable]
    x64.leaRegRdata r9, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, rbx
    x64.callDirect __set_insert
    x64.movRegReg rcx, rbx
    x64.callDirect __set_count
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __set_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect Plain.make
    x64.cmpRegImm32 r8, 1
    x64.jcc equal, ok
    x64.jmp ifcont
  ok:
    x64.movRegImm32 r8, 8
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @int.hash {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 4294967295
    x64.movRegReg r8, rcx
    x64.andRegReg r8, rcx, rax
    x64.popReg rbp
    x64.ret
}

func @int.equals {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegReg rcx, rdx
    x64.jcc equal, equal
    x64.jmp notEqual
  equal:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  notEqual:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
