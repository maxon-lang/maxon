// Test: sleep.main-thread-alone
function main() returns ExitCode
		let start = Clock.nowMs()
		sleep(300)
		let elapsed = Clock.elapsedMs(start)
		var score = 0
		if elapsed >= 250 'slept'
				score = score + 1
		end 'slept'
		if elapsed < 10000 'bounded'
				score = score + 1
		end 'bounded'
		print("score={score}\n")
		return 0
end 'main'
---
ExitCode: unpinned
