// Test: sleep.trace-sleep-yields-the-green-thread
typealias Integer = int(i64.min to i64.max)

function napper() returns Integer
	sleep(1)
	return 7
end 'napper'

function main() returns ExitCode
	let p = async napper()
	let r = await p
	return r
end 'main'
