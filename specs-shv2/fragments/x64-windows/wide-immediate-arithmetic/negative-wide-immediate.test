// Test: negative-wide-immediate
function base(p int) returns int
	return p
end 'base'

function main() returns ExitCode
	let x = base(1000)
	let addNeg = x + -1000000007
	if addNeg != -999999007 'addNeg'
		return 41
	end 'addNeg'
	let subNeg = x - -1000000007
	if subNeg != 1000001007 'subNeg'
		return 42
	end 'subNeg'
	let addMax = x + 2147483647
	if addMax != 2147484647 'addMax'
		return 43
	end 'addMax'
	let subMax = x - 2147483647
	if subMax != -2147482647 'subMax'
		return 44
	end 'subMax'
	let addMin = x + -2147483648
	if addMin != -2147482648 'addMin'
		return 45
	end 'addMin'
	let subMin = x - -2147483648
	if subMin != 2147484648 'subMin'
		return 46
	end 'subMin'
	return 0
end 'main'
---
ExitCode: 0
---
func @base {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegReg r8, rcx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 1000
    x64.callDirect base
    x64.leaRegRegImm32 rax, r8, -1000000007
    x64.cmpRegImm32 rax, -999999007
    x64.jcc notEqual, addNeg
    x64.jmp ifcont#2
  addNeg:
    x64.movRegImm32 r8, 41
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.leaRegRegImm32 rax, r8, 1000000007
    x64.cmpRegImm32 rax, 1000001007
    x64.jcc notEqual, subNeg
    x64.jmp ifcont#4
  subNeg:
    x64.movRegImm32 r8, 42
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.leaRegRegImm32 rax, r8, 2147483647
    x64.movRegImm32 rcx, 2147484647
    x64.cmpRegReg rax, rcx
    x64.jcc notEqual, addMax
    x64.jmp ifcont#6
  addMax:
    x64.movRegImm32 r8, 43
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.leaRegRegImm32 rax, r8, -2147483647
    x64.cmpRegImm32 rax, -2147482647
    x64.jcc notEqual, subMax
    x64.jmp ifcont#8
  subMax:
    x64.movRegImm32 r8, 44
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#8:
    x64.leaRegRegImm32 rax, r8, -2147483648
    x64.cmpRegImm32 rax, -2147482648
    x64.jcc notEqual, addMin
    x64.jmp ifcont#10
  addMin:
    x64.movRegImm32 r8, 45
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#10:
    x64.movRegImm rax, 18446744071562067968
    x64.subRegReg r8, r8, rax
    x64.movRegImm32 rax, 2147484648
    x64.cmpRegReg r8, rax
    x64.jcc notEqual, subMin
    x64.jmp ifcont#12
  subMin:
    x64.movRegImm32 r8, 46
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#12:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
