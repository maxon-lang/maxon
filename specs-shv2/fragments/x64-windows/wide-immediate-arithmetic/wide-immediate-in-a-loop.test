// Test: wide-immediate-in-a-loop
function base(p int) returns int
	return p
end 'base'

function main() returns ExitCode
	var acc = base(0)
	var i = 0
	while i < 3 'loop'
		acc = acc + 1000000007
		i = i + 1
	end 'loop'
	if acc != 3000000021 'acc'
		return 61
	end 'acc'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
  __il_cont:
    x64.movRegImm32 rcx, 0
  whilehdr:
    x64.cmpRegImm32 rcx, 3
    x64.jcc greaterEqual, whileexit
  loop:
    x64.leaRegRegImm32 rax, rax, 1000000007
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.jmp whilehdr
  whileexit:
    x64.movRegImm32 rcx, 3000000021
    x64.cmpRegReg rax, rcx
    x64.jcc equal, ifcont
  acc:
    x64.movRegImm32 r8, 61
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
