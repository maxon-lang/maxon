func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 0
    x64.jmp __il_body
  __il_body:
    x64.jmp __il_cont
  __il_cont:
    x64.callDirect pressure
    x64.movRegImm rax, 6000000505
    x64.cmpRegReg r8, rax
    x64.jcc notEqual, total
    x64.jmp ifcont
  total:
    x64.movRegImm32 r8, 51
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
