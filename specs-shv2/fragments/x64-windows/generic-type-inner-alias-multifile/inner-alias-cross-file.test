// Test: inner-alias-cross-file
// --- file: types.maxon
typealias Count = int(0 to u64.max)
typealias Integer = int(i64.min to i64.max)

export type Item
	export var value as Integer
	export static function create(value Integer) returns Self
		return Self{value: value}
	end 'create'
end 'Item'

export typealias ItemArray = Array with Item

export type GenericModule uses Op
	typealias OpArray = Array with Op

	export var ops as OpArray
	export var items as ItemArray

	export static function create() returns Self
		return Self{
			ops: OpArray.create(),
			items: ItemArray.create()
		}
	end 'create'

	export function pushOp(op Op)
		self.ops.push(op)
	end 'pushOp'

	export function pushItem(item Item)
		self.items.push(item)
	end 'pushItem'

	export function opCount() returns Count
		return self.ops.count()
	end 'opCount'

	export function itemCount() returns Count
		return self.items.count()
	end 'itemCount'
end 'GenericModule'

export typealias IntModule = GenericModule with Integer

// --- file: main.maxon
typealias ExitCode = int(0 to 125)

function main() returns ExitCode
	var m = IntModule.create()
	m.pushOp(10)
	m.pushOp(20)
	m.pushItem(Item.create(99))
	let oc = m.opCount()
	let ic = m.itemCount()
	if oc == 2 and ic == 1 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Item.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @GenericModule.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rax, 8
    x64.loadRegBaseDisp.word64 rdx, [rcx + 40]
    x64.movRegReg rcx, rax
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __mm_decref]
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.storeBaseDispReg.word64 [r8 + 8], r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @GenericModule.pushOp {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callDirect __managed_push
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @GenericModule.pushItem {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rdx
    x64.loadRegBaseDisp.word64 r12, [rcx + 8]
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect __managed_push
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @GenericModule.opCount {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.word64 r8, [rax + 8]
    x64.popReg rbp
    x64.ret
}

func @GenericModule.itemCount {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.loadRegBaseDisp.word64 r8, [rax + 8]
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __layout_GenericModule_Integer]
    x64.callDirect GenericModule.create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 10
    x64.leaRegRdata rax, [rip + __layout_GenericModule_Integer]
    x64.movRegReg rcx, rbx
    x64.callDirect GenericModule.pushOp
    x64.movRegImm32 rdx, 20
    x64.leaRegRdata rax, [rip + __layout_GenericModule_Integer]
    x64.movRegReg rcx, rbx
    x64.callDirect GenericModule.pushOp
    x64.movRegImm32 rcx, 99
    x64.callDirect Item.create
    x64.movRegReg r12, r8
    x64.leaRegRdata rax, [rip + __layout_GenericModule_Integer]
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect GenericModule.pushItem
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg rcx, rbx
    x64.callDirect GenericModule.opCount
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect GenericModule.itemCount
    x64.cmpRegImm32 r12, 2
    x64.movRegImm32 rax, 0
    x64.jcc notEqual, scmerge
  andrhs:
    x64.cmpRegImm32 r8, 1
    x64.setccReg equal, rax
  scmerge:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont
  check:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_GenericModule_Integer
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_GenericModule_Integer
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
