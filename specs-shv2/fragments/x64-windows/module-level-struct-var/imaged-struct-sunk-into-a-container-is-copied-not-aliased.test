// Test: imaged-struct-sunk-into-a-container-is-copied-not-aliased
typealias Count = int(0 to 1000)
typealias CountArray = Array with Count

type Facts
	export var counts as CountArray = CountArray.create()

	export static function create() returns Facts
		return Self{}
	end 'create'
end 'Facts'

typealias FactsArray = Array with Facts

let SharedFacts = Facts.create()

function main() returns ExitCode
	var xs = FactsArray.create()
	xs.push(SharedFacts)
	var stored = try xs.get(0) otherwise panic("the push just landed")
	stored.counts.push(7)
	stored.counts.push(8)

	print("stored {stored.counts.count()} shared {SharedFacts.counts.count()}\n")
	return (stored.counts.count() + SharedFacts.counts.count()) as ExitCode
end 'main'
---
ExitCode: 2
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 120
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __destruct_Facts]
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.storeSlotReg slot0, rbx
    x64.leaRegRdata rcx, [rip + __struct_rec_3]
    x64.leaRegFunc rdx, [rip + __clone_Facts]
    x64.callDirect __mm_own_deep
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc belowEqual, __im_slow
  __im_load:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.movRegImm32 rax, 0
    x64.loadRegBaseDisp.word64 rsi, [rbx + 40]
    x64.cmpRegImm32 rsi, 0
    x64.jcc equal, critsplit#10
  __im_empty:
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, critsplit#11
  __im_slow:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.movRegReg rcx, r8
    x64.jmp __im_cont
  critsplit#11:
    x64.movRegReg r10, rax
    x64.jmp __im_cont
  critsplit#10:
    x64.movRegReg r10, rax
  __im_cont:
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_7]  ; "panic at imaged-struct-sunk-into-a-container-is-copied-not-aliased.test:20: the push just landed\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 120
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.leaRegFunc rdx, [rip + __clone_Facts]
    x64.callDirect __mm_own_deep
    x64.movRegReg rbx, r8
    x64.storeSlotReg slot1, rbx
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.movRegImm32 rdx, 7
    x64.callDirect __managed_push
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.movRegImm32 rdx, 8
    x64.callDirect __managed_push
    x64.leaRegRdata rax, [rip + __str_rec_4]  ; "stored "
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.storeSlotReg slot9, rcx
    x64.loadRegBaseDisp.word64 r12, [rax + 8]
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseDisp.word64 rbx, [rax + 8]
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot8, r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __int_to_string
    x64.movRegReg rbx, r8
    x64.leaRegRdata rax, [rip + __str_rec_5]  ; " shared "
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.storeSlotReg slot7, rcx
    x64.loadRegBaseDisp.word64 r13, [rax + 8]
