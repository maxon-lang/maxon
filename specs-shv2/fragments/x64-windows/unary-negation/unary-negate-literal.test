// Test: unary-negate-literal
function main() returns ExitCode
	let x = -5
	return 47 + x
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 5
    x64.negReg rax, rax
    x64.leaRegRegImm32 r8, rax, 47
    x64.popReg rbp
    x64.ret
}
