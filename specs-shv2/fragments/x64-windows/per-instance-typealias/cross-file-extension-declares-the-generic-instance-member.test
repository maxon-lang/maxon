// Test: cross-file-extension-declares-the-generic-instance-member
// --- file: a.maxon
typealias Num = int(0 to 200)

export type Holder
	export var v as Num

	export static function create(v Num) returns Holder
		return Holder{v: v}
	end 'create'
end 'Holder'

extension Holder
	typealias Bag = Array with Num

	export function fill() returns Bag
		var b = Bag.create()
		b.push(self.v)
		b.push(self.v)
		return b
	end 'fill'
end 'Holder'

// --- file: b.maxon
extension Holder
	export function firstOf(b Bag) returns Num
		return try b.get(0) otherwise 0
	end 'firstOf'
end 'Holder'

// --- file: main.maxon
function main() returns ExitCode
	let h = Holder.create(20)
	let b = h.fill()
	if h.firstOf(b) == 20 'ok'
		return 0
	end 'ok'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Holder.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 rbx, 200
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Holder.fill {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.loadRegBaseDisp.word64 rdx, [rbx + 0]
    x64.movRegReg rcx, r12
    x64.callDirect __managed_push
    x64.loadRegBaseDisp.word64 rdx, [rbx + 0]
    x64.movRegReg rcx, r12
    x64.callDirect __managed_push
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Holder.firstOf {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 0
    x64.loadRegBaseDisp.word64 rcx, [rdx + 24]
    x64.cmpRegImm32 rcx, 8
    x64.jcc equal, __im_word
    x64.jmp __im_stride
  __im_word:
    x64.loadRegBaseDisp.word64 rcx, [rdx + 8]
    x64.cmpRegImm32 rax, 0
    x64.setccReg less, rsi
    x64.cmpRegImm32 rcx, 0
    x64.setccReg lessEqual, rcx
    x64.orRegReg rsi, rsi, rcx
    x64.cmpRegImm32 rsi, 0
    x64.jcc notEqual, __im_slow
    x64.jmp __im_load#10
  __im_load#10:
    x64.loadRegBaseDisp.word64 rcx, [rdx + 0]
    x64.imulRegRegImm32 rsi, rax, 8
    x64.leaRegRegReg rcx, rcx, rsi
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.jmp __im_loaded
  __im_stride:
    x64.cmpRegImm32 rcx, 1
    x64.jcc equal, __im_byte
    x64.jmp __im_slow
  __im_byte:
    x64.loadRegBaseDisp.word64 rcx, [rdx + 8]
    x64.cmpRegImm32 rax, 0
    x64.setccReg less, rsi
    x64.cmpRegImm32 rcx, 0
    x64.setccReg lessEqual, rcx
    x64.orRegReg rsi, rsi, rcx
    x64.cmpRegImm32 rsi, 0
    x64.jcc notEqual, __im_slow
    x64.jmp __im_load#11
  __im_load#11:
    x64.loadRegBaseDisp.word64 rcx, [rdx + 0]
    x64.leaRegRegReg rcx, rcx, rax
    x64.loadRegBaseDisp.byte rcx, [rcx + 0]
    x64.jmp __im_loaded
  __im_loaded:
    x64.movRegImm32 rsi, 0
    x64.loadRegBaseDisp.word64 rdi, [rdx + 40]
    x64.cmpRegImm32 rdi, 0
    x64.jcc notEqual, __im_empty
    x64.jmp critsplit#13
  __im_empty:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, __im_slow
    x64.jmp critsplit#14
  critsplit#14:
    x64.jmp __im_cont
  critsplit#13:
    x64.jmp __im_cont
  __im_slow:
    x64.movRegReg rcx, rdx
    x64.movRegReg rdx, rax
    x64.callDirect __managed_get
    x64.movRegReg rcx, r8
    x64.movRegReg rsi, r10
    x64.jmp __im_cont
  __im_cont:
    x64.cmpRegImm32 rsi, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 r8, 0
    x64.jmp trycont
  tryok:
    x64.movRegReg r8, rcx
    x64.jmp trycont
  trycont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 20
    x64.callDirect Holder.create
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect Holder.fill
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect Holder.firstOf
    x64.cmpRegImm32 r8, 20
    x64.jcc equal, ok
    x64.jmp ifcont
  ok:
    x64.movRegImm32 r13, 0
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r13, 1
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
