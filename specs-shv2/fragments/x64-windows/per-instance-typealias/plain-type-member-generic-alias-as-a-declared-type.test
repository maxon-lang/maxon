// Test: plain-type-member-generic-alias-as-a-declared-type
// --- file: a.maxon
typealias Num = int(0 to 200)

export type Holder
	typealias Bag = Array with Num

	export var v as Num

	export static function create(v Num) returns Holder
		return Holder{v: v}
	end 'create'

	export function fill() returns Bag
		var b = Bag.create()
		b.push(self.v)
		return b
	end 'fill'
end 'Holder'

// --- file: main.maxon
type Keeper
	var held as Bag

	static function create(held Bag) returns Keeper
		return Keeper{held: held}
	end 'create'

	function total() returns Num
		return sumOf(self.held)
	end 'total'
end 'Keeper'

function makeBag() returns Bag
	var b = Bag.create()
	b.push(20)
	b.push(22)
	return b
end 'makeBag'

function sumOf(b Bag) returns Num
	var total = 0
	for n in b 'each'
		total = total + n
	end 'each'
	return total
end 'sumOf'

function main() returns ExitCode
	let k = Keeper.create(makeBag())
	let h = Holder.create(3)
	if k.total() == 42 and sumOf(h.fill()) == 3 'ok'
		return 0
	end 'ok'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Holder.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 rbx, 200
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

