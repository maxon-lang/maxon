func @sumOf {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rbx, 0
    x64.callDirect Array.createIterator
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, critsplit
    x64.jmp forempty
  critsplit:
    x64.jmp forhdr
  forhdr:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, each
    x64.jmp forexit
  each:
    x64.leaRegRdata rdx, [rip + __layout_ArrayIterator_Num]
    x64.movRegReg rcx, r12
    x64.callDirect ArrayIterator.current
    x64.leaRegRegReg rbx, rbx, r8
