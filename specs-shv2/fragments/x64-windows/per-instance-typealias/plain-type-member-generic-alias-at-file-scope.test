// Test: plain-type-member-generic-alias-at-file-scope
// --- file: a.maxon
typealias Num = int(0 to 200)

export type Holder
	typealias Bag = Array with Num

	export var v as Num

	export static function create(v Num) returns Holder
		return Holder{v: v}
	end 'create'

	export function fill() returns Bag
		var b = Bag.create()
		b.push(self.v)
		return b
	end 'fill'
end 'Holder'

// --- file: main.maxon
function main() returns ExitCode
	var b = Bag.create()
	b.push(20)
	b.push(22)
	let h = Holder.create(1)
	let ownBag = h.fill()
	if b.count() == 2 and ownBag.count() == 1 'ok'
		return 0
	end 'ok'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Holder.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 rbx, 200
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Holder.fill {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.loadRegBaseDisp.word64 rdx, [rbx + 0]
    x64.movRegReg rcx, r12
    x64.callDirect __managed_push
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 20
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 22
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rcx, 1
    x64.callDirect Holder.create
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.callDirect Holder.fill
    x64.movRegReg r13, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_count
    x64.cmpRegImm32 r8, 2
    x64.movRegImm32 rax, 0
    x64.jcc equal, andrhs
    x64.jmp critsplit
  andrhs:
    x64.movRegReg rcx, r13
    x64.callDirect __managed_count
    x64.cmpRegImm32 r8, 1
    x64.setccReg equal, rax
    x64.jmp scmerge
  critsplit:
    x64.jmp scmerge
  scmerge:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, ok
    x64.jmp ifcont
  ok:
    x64.movRegImm32 r14, 0
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r14
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r14, 1
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r14
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
