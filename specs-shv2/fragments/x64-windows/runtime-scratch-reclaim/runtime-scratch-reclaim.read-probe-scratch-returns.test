// Test: runtime-scratch-reclaim.read-probe-scratch-returns
function main() returns ExitCode
	let warm = spawnReadLine("cmd /c echo hello")
	let totalBefore = __Builtins.mmRawAllocTotal()
	let liveBefore = __Builtins.mmRawAllocLive()
	let a = spawnReadLine("cmd /c echo hello")
	let b = spawnReadLine("cmd /c echo hello")
	let c = spawnReadLine("cmd /c echo hello")
	let totalGrew = __Builtins.mmRawAllocTotal() - totalBefore
	let liveGrew = __Builtins.mmRawAllocLive() - liveBefore
	var score = 0
	if warm + a + b + c == 28 'everyReadReturnedSevenBytes'
		score = score + 1
	end 'everyReadReturnedSevenBytes'
	if totalGrew >= 9 'theReadsTookScratchFromTheAllocator'
		score = score + 2
	end 'theReadsTookScratchFromTheAllocator'
	if liveGrew <= 3 'andGaveItBack'
		score = score + 4
	end 'andGaveItBack'
	return score as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __mm_alloc_total@8 = i64 0
  __mm_alloc_bytes@16 = i64 0
  __mm_raw_alloc_count@24 = i64 0
  __mm_raw_live_count@32 = i64 0
  __mm_raw_alloc_bytes@40 = i64 0
  __gt_current_gt@48 = i64 0
  __gt_run_queue_head@56 = i64 0
  __gt_run_queue_tail@64 = i64 0
  __gt_init_done@72 = i64 0
  __gt_system_stack_top@80 = i64 0
  __gt_timer_count@88 = i64 0
  __gt_timer_heap_base@96 = i64 0
  __gt_timer_capacity@104 = i64 0
  __gt_trace_counter@112 = i64 0
  __gt_trace_digits@120 = i64 0
  __gt_clock_ticks@128 = i64 0
  __gt_clock_freq@136 = i64 0
  __gt_proc_count@144 = i64 0
  __gt_proc_handles_base@152 = i64 0
  __gt_proc_gts_base@160 = i64 0
  __gt_live_count@168 = i64 0
  __io_iocp@176 = i64 0
  __io_done_event@184 = i64 0
  __io_lock@192 = i64 0
  __io_init_done@200 = i64 0
  __io_pending@208 = i64 0
  __io_pipe_seq@216 = i64 0
  __slab_arena_list@224 = i64 0
  __slab_arena_map_l1@232 = i64 0
  __slab_state@240 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 56
    x64.leaRegRdata rcx, [rip + __str_rec_1]
    x64.callDirect __gt_io_read
    x64.movRegReg rbx, r8
    x64.callDirect __mm_counter_raw_alloc_total
    x64.movRegReg r12, r8
    x64.callDirect __mm_counter_raw_alloc_live
    x64.movRegReg r13, r8
    x64.leaRegRdata rcx, [rip + __str_rec_1]
    x64.callDirect __gt_io_read
    x64.movRegReg r14, r8
    x64.leaRegRdata rcx, [rip + __str_rec_1]
    x64.callDirect __gt_io_read
    x64.storeSlotReg slot1, r8
    x64.leaRegRdata rcx, [rip + __str_rec_1]
    x64.callDirect __gt_io_read
    x64.storeSlotReg slot0, r8
    x64.callDirect __mm_counter_raw_alloc_total
    x64.movRegReg r15, r8
    x64.subRegReg r15, r8, r12
    x64.callDirect __mm_counter_raw_alloc_live
    x64.subRegReg r8, r8, r13
    x64.movRegImm32 rax, 0
    x64.leaRegRegReg rcx, rbx, r14
    x64.loadRegSlot rdx, slot1
    x64.leaRegRegReg rcx, rcx, rdx
    x64.loadRegSlot rdx, slot0
    x64.leaRegRegReg rcx, rcx, rdx
    x64.cmpRegImm32 rcx, 28
    x64.jcc equal, everyReadReturnedSevenBytes
    x64.jmp critsplit#10
  everyReadReturnedSevenBytes:
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp ifcont#2
  critsplit#10:
    x64.jmp ifcont#2
  ifcont#2:
    x64.cmpRegImm32 r15, 9
    x64.jcc greaterEqual, theReadsTookScratchFromTheAllocator
    x64.jmp critsplit#11
  theReadsTookScratchFromTheAllocator:
    x64.leaRegRegImm32 rax, rax, 2
    x64.jmp ifcont#4
  critsplit#11:
    x64.jmp ifcont#4
  ifcont#4:
    x64.cmpRegImm32 r8, 3
    x64.jcc lessEqual, andGaveItBack
    x64.jmp critsplit#12
  andGaveItBack:
    x64.leaRegRegImm32 r8, rax, 4
    x64.jmp ifcont#6
  critsplit#12:
    x64.movRegReg r8, rax
    x64.jmp ifcont#6
  ifcont#6:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
