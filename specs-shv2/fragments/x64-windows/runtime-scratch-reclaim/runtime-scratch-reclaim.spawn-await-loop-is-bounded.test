// Test: runtime-scratch-reclaim.spawn-await-loop-is-bounded
function work(n int) returns int
	__Builtins.parallelBoundary()
	return n + 1
end 'work'

function spawnAndAwait(seed int) returns int
	let p = async work(seed)
	return await p
end 'spawnAndAwait'

function main() returns ExitCode
	var acc = spawnAndAwait(0)
	let totalBefore = __Builtins.mmRawAllocTotal()
	let liveBefore = __Builtins.mmRawAllocLive()
	acc = spawnAndAwait(acc)
	acc = spawnAndAwait(acc)
	acc = spawnAndAwait(acc)
	acc = spawnAndAwait(acc)
	acc = spawnAndAwait(acc)
	acc = spawnAndAwait(acc)
	acc = spawnAndAwait(acc)
	acc = spawnAndAwait(acc)
	let totalGrew = __Builtins.mmRawAllocTotal() - totalBefore
	let liveGrew = __Builtins.mmRawAllocLive() - liveBefore
	var score = 0
	if acc == 9 'everyThreadRanExactlyOnce'
		score = score + 1
	end 'everyThreadRanExactlyOnce'
	if totalGrew >= 8 'eachSpawnTookAStruct'
		score = score + 2
	end 'eachSpawnTookAStruct'
	if liveGrew <= 1 'andEachAwaitGaveItBack'
		score = score + 4
	end 'andEachAwaitGaveItBack'
	return score as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __mm_alloc_total@8 = i64 0
  __mm_alloc_bytes@16 = i64 0
  __mm_raw_alloc_count@24 = i64 0
  __mm_raw_live_count@32 = i64 0
  __mm_raw_alloc_bytes@40 = i64 0
  __gt_current_gt@48 = i64 0
  __gt_run_queue_head@56 = i64 0
  __gt_run_queue_tail@64 = i64 0
  __gt_init_done@72 = i64 0
  __gt_system_stack_top@80 = i64 0
  __gt_timer_count@88 = i64 0
  __gt_timer_heap_base@96 = i64 0
  __gt_timer_capacity@104 = i64 0
  __gt_trace_counter@112 = i64 0
  __gt_trace_digits@120 = i64 0
  __gt_clock_ticks@128 = i64 0
  __gt_clock_freq@136 = i64 0
  __gt_proc_count@144 = i64 0
  __gt_proc_handles_base@152 = i64 0
  __gt_proc_gts_base@160 = i64 0
  __gt_live_count@168 = i64 0
  __slab_arena_list@176 = i64 0
  __slab_arena_map_l1@184 = i64 0
  __slab_state@192 = i64 0
}

func @work {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.callDirect __parallel_boundary
    x64.leaRegRegImm32 r8, rbx, 1
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @spawnAndAwait {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.leaRegFunc rcx, [rip + work]
    x64.callDirect __gt_spawn
    x64.storeBaseDispReg.word64 [r8 + 200], rbx
    x64.movRegReg rcx, r8
    x64.callDirect __gt_await
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rcx, 0
    x64.callDirect spawnAndAwait
    x64.movRegReg rbx, r8
    x64.callDirect __mm_counter_raw_alloc_total
    x64.movRegReg r12, r8
    x64.callDirect __mm_counter_raw_alloc_live
    x64.movRegReg r13, r8
    x64.movRegReg rcx, rbx
    x64.callDirect spawnAndAwait
    x64.movRegReg rcx, r8
    x64.callDirect spawnAndAwait
    x64.movRegReg rcx, r8
    x64.callDirect spawnAndAwait
    x64.movRegReg rcx, r8
    x64.callDirect spawnAndAwait
    x64.movRegReg rcx, r8
    x64.callDirect spawnAndAwait
    x64.movRegReg rcx, r8
    x64.callDirect spawnAndAwait
    x64.movRegReg rcx, r8
    x64.callDirect spawnAndAwait
    x64.movRegReg rcx, r8
    x64.callDirect spawnAndAwait
    x64.movRegReg rbx, r8
    x64.callDirect __mm_counter_raw_alloc_total
    x64.movRegReg r14, r8
    x64.subRegReg r14, r8, r12
    x64.callDirect __mm_counter_raw_alloc_live
    x64.subRegReg r8, r8, r13
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 rbx, 9
    x64.jcc equal, everyThreadRanExactlyOnce
    x64.jmp critsplit#10
  everyThreadRanExactlyOnce:
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp ifcont#2
  critsplit#10:
    x64.jmp ifcont#2
  ifcont#2:
    x64.cmpRegImm32 r14, 8
    x64.jcc greaterEqual, eachSpawnTookAStruct
    x64.jmp critsplit#11
  eachSpawnTookAStruct:
    x64.leaRegRegImm32 rax, rax, 2
    x64.jmp ifcont#4
  critsplit#11:
    x64.jmp ifcont#4
  ifcont#4:
    x64.cmpRegImm32 r8, 1
    x64.jcc lessEqual, andEachAwaitGaveItBack
    x64.jmp critsplit#12
  andEachAwaitGaveItBack:
    x64.leaRegRegImm32 r8, rax, 4
    x64.jmp ifcont#6
  critsplit#12:
    x64.movRegReg r8, rax
    x64.jmp ifcont#6
  ifcont#6:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
