// Test: error.nested-struct-backing-characterset-field
typealias Wide = int(0 to 100)

type Meta
	export let chars as CharacterSet
	export let n as Wide
end 'Meta'

enum Task
	quick = Meta{chars: CharacterSet.create(), n: 2}
end 'Task'

function main() returns ExitCode
	return 0
end 'main'
---
CompilerError:
error E2015: <fragment>:10:2: Unsupported: the constant written for field 'chars' of the `Meta` backing, which is declared `__CharacterSet` — a backing field takes an INT literal for an integer field, a `true`/`false` for a `bool` field, an int or float literal for a float field, `<ThatEnum>.<case>` of THAT enum for a field of a declared enum, and a nested constant of THAT type (a literal or a factory call) for a field of a declared `type`
