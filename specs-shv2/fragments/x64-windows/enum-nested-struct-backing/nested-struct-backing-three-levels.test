// Test: nested-struct-backing-three-levels
typealias Latency = int(0 to 50)

type Cost
	export let cycles as Latency

	static function create(cycles Latency) returns Self
		return Self{cycles: cycles}
	end 'create'
end 'Cost'

type OpMeta
	export let cost as Cost
	export let isCall as bool

	static function create(cost Cost, isCall bool) returns Self
		return Self{cost: cost, isCall: isCall}
	end 'create'
end 'OpMeta'

type X64OpMeta
	export let meta as OpMeta

	static function create(meta OpMeta) returns Self
		return Self{meta: meta}
	end 'create'
end 'X64OpMeta'

enum X64Op
	add = X64OpMeta.create(OpMeta.create(Cost.create(4), isCall: false))
	call = X64OpMeta.create(OpMeta{cost: Cost.create(9), isCall: true})
end 'X64Op'

function cyclesOf(op X64Op) returns Latency
	return op.rawValue.meta.cost.cycles
end 'cyclesOf'

function main() returns ExitCode
	return cyclesOf(X64Op.call) - cyclesOf(X64Op.add)
end 'main'
---
ExitCode: 5
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @cyclesOf {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.setccReg equal, rax
    x64.imulRegRegImm32 rax, rax, 4
    x64.cmpRegImm32 rcx, 1
    x64.setccReg equal, rcx
    x64.imulRegRegImm32 rcx, rcx, 9
    x64.leaRegRegReg r8, rax, rcx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 1
    x64.callDirect cyclesOf
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 0
    x64.callDirect cyclesOf
    x64.subRegReg rbx, rbx, r8
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
