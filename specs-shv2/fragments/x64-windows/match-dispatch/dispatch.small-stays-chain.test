// Test: dispatch.small-stays-chain
function main() returns ExitCode
	let x = 2
	match x 'check'
		1 then return 10
		2 then return 20
		3 then return 30
		default then return 0
	end 'check'
end 'main'
---
ExitCode: 20
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 2
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm#1
    x64.jmp matchnext#5
  matcharm#1:
    x64.movRegImm32 r8, 10
    x64.popReg rbp
    x64.ret
  matchnext#5:
    x64.cmpRegImm32 rax, 2
    x64.jcc equal, matcharm#2
    x64.jmp matchnext#6
  matcharm#2:
    x64.movRegImm32 r8, 20
    x64.popReg rbp
    x64.ret
  matchnext#6:
    x64.cmpRegImm32 rax, 3
    x64.jcc equal, matcharm#3
    x64.jmp matchdefault
  matcharm#3:
    x64.movRegImm32 r8, 30
    x64.popReg rbp
    x64.ret
  matchdefault:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  matchcont:
}
