// Test: dispatch.negative-extreme
typealias N = int(i64.min to i64.max)

function band(x N) returns N
	return match x 'c'
		min to -100 gives 1
		-99 to -1 gives 2
		0 gives 3
		1 to 100 gives 4
		101 to max gives 5
		default gives 9
	end 'c'
end 'band'

function main() returns ExitCode
	var n = 0 as N
	if band(0 - 5000) == 1 'a'
		n = n + 1
	end 'a'
	if band(0 - 100) == 1 'b'
		n = n + 1
	end 'b'
	if band(0 - 99) == 2 'c'
		n = n + 1
	end 'c'
	if band(0 - 1) == 2 'd'
		n = n + 1
	end 'd'
	if band(0) == 3 'e'
		n = n + 1
	end 'e'
	if band(1) == 4 'f'
		n = n + 1
	end 'f'
	if band(100) == 4 'g'
		n = n + 1
	end 'g'
	if band(101) == 5 'h'
		n = n + 1
	end 'h'
	if band(999999) == 5 'i'
		n = n + 1
	end 'i'
	return n as ExitCode
end 'main'
---
ExitCode: 9
---
func @band {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, matchlo
    x64.jmp matchhi
  matchlo:
    x64.cmpRegImm32 rcx, -100
    x64.jcc lessEqual, matcharm#1
    x64.jmp matchnext#9
  matcharm#1:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont
  matchnext#9:
    x64.cmpRegImm32 rcx, -99
    x64.setccReg greaterEqual, rax
    x64.cmpRegImm32 rcx, -1
    x64.setccReg lessEqual, rcx
    x64.andRegReg rax, rax, rcx
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matcharm#2
    x64.jmp matchdefault
  matcharm#2:
    x64.movRegImm32 r8, 2
    x64.jmp matchcont
  matchhi:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, matcharm#3
    x64.jmp matchnext#10
  matcharm#3:
    x64.movRegImm32 r8, 3
    x64.jmp matchcont
  matchnext#10:
    x64.cmpRegImm32 rcx, 1
    x64.setccReg greaterEqual, rax
    x64.cmpRegImm32 rcx, 100
    x64.setccReg lessEqual, rdx
    x64.andRegReg rax, rax, rdx
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matcharm#4
    x64.jmp matchnext#11
  matcharm#4:
    x64.movRegImm32 r8, 4
    x64.jmp matchcont
  matchnext#11:
    x64.cmpRegImm32 rcx, 101
    x64.jcc greaterEqual, matcharm#5
    x64.jmp matchdefault
  matcharm#5:
    x64.movRegImm32 r8, 5
    x64.jmp matchcont
  matchdefault:
    x64.movRegImm32 r8, 9
    x64.jmp matchcont
  matchcont:
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 rcx, rax, -5000
    x64.callDirect band
    x64.cmpRegImm32 r8, 1
    x64.jcc equal, a
    x64.jmp critsplit#22
  a:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#2
  critsplit#22:
    x64.jmp ifcont#2
  ifcont#2:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 rcx, rax, -100
    x64.callDirect band
    x64.cmpRegImm32 r8, 1
    x64.jcc equal, b
    x64.jmp critsplit#23
  b:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#4
  critsplit#23:
    x64.jmp ifcont#4
  ifcont#4:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 rcx, rax, -99
    x64.callDirect band
    x64.cmpRegImm32 r8, 2
    x64.jcc equal, c
    x64.jmp critsplit#24
  c:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#6
  critsplit#24:
    x64.jmp ifcont#6
  ifcont#6:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 rcx, rax, -1
    x64.callDirect band
    x64.cmpRegImm32 r8, 2
    x64.jcc equal, d
    x64.jmp critsplit#25
  d:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#8
  critsplit#25:
    x64.jmp ifcont#8
  ifcont#8:
    x64.movRegImm32 rcx, 0
    x64.callDirect band
    x64.cmpRegImm32 r8, 3
    x64.jcc equal, e
    x64.jmp critsplit#26
  e:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#10
  critsplit#26:
    x64.jmp ifcont#10
  ifcont#10:
    x64.movRegImm32 rcx, 1
    x64.callDirect band
    x64.cmpRegImm32 r8, 4
    x64.jcc equal, f
    x64.jmp critsplit#27
  f:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#12
  critsplit#27:
    x64.jmp ifcont#12
  ifcont#12:
    x64.movRegImm32 rcx, 100
    x64.callDirect band
    x64.cmpRegImm32 r8, 4
    x64.jcc equal, g
    x64.jmp critsplit#28
  g:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#14
  critsplit#28:
    x64.jmp ifcont#14
  ifcont#14:
    x64.movRegImm32 rcx, 101
    x64.callDirect band
    x64.cmpRegImm32 r8, 5
    x64.jcc equal, h
    x64.jmp critsplit#29
  h:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#16
  critsplit#29:
    x64.jmp ifcont#16
  ifcont#16:
    x64.movRegImm32 rcx, 999999
    x64.callDirect band
    x64.cmpRegImm32 r8, 5
    x64.jcc equal, i
    x64.jmp critsplit#30
  i:
    x64.leaRegRegImm32 r8, rbx, 1
    x64.jmp ifcont#18
  critsplit#30:
    x64.movRegReg r8, rbx
    x64.jmp ifcont#18
  ifcont#18:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
