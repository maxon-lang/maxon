// Test: dispatch.sparse-hits-misses
typealias N = int(i64.min to i64.max)

function sparse(x N) returns N
	return match x 'c'
		10 gives 1
		20 gives 2
		30 gives 3
		40 gives 4
		50 gives 5
		default gives 9
	end 'c'
end 'sparse'

function main() returns ExitCode
	var n = 0 as N
	if sparse(10) == 1 'h1' n = n + 1 end 'h1'
	if sparse(30) == 3 'h3' n = n + 1 end 'h3'
	if sparse(50) == 5 'h5' n = n + 1 end 'h5'
	if sparse(25) == 9 'm1' n = n + 1 end 'm1'
	if sparse(35) == 9 'm2' n = n + 1 end 'm2'
	if sparse(9) == 9 'o1' n = n + 1 end 'o1'
	if sparse(11) == 9 'o2' n = n + 1 end 'o2'
	if sparse(51) == 9 'o3' n = n + 1 end 'o3'
	return n as ExitCode
end 'main'
---
ExitCode: 8
---
func @sparse {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 30
    x64.jcc less, matchlo
    x64.jmp matchhi
  matchlo:
    x64.cmpRegImm32 rcx, 10
    x64.jcc equal, matcharm
    x64.jmp matchnext
  matcharm:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rcx, 20
    x64.jcc equal, matcharm
    x64.jmp matchdefault
  matcharm:
    x64.movRegImm32 r8, 2
    x64.jmp matchcont
  matchhi:
    x64.cmpRegImm32 rcx, 30
    x64.jcc equal, matcharm
    x64.jmp matchnext
  matcharm:
    x64.movRegImm32 r8, 3
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rcx, 40
    x64.jcc equal, matcharm
    x64.jmp matchnext
  matcharm:
    x64.movRegImm32 r8, 4
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rcx, 50
    x64.jcc equal, matcharm
    x64.jmp matchdefault
  matcharm:
    x64.movRegImm32 r8, 5
    x64.jmp matchcont
  matchdefault:
    x64.movRegImm32 r8, 9
    x64.jmp matchcont
  matchcont:
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 10
    x64.callDirect sparse
    x64.cmpRegImm32 r8, 1
    x64.jcc equal, h1
    x64.jmp critsplit
  h1:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 rcx, 30
    x64.callDirect sparse
    x64.cmpRegImm32 r8, 3
    x64.jcc equal, h3
    x64.jmp critsplit
  h3:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 rcx, 50
    x64.callDirect sparse
    x64.cmpRegImm32 r8, 5
    x64.jcc equal, h5
    x64.jmp critsplit
  h5:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 rcx, 25
    x64.callDirect sparse
    x64.cmpRegImm32 r8, 9
    x64.jcc equal, m1
    x64.jmp critsplit
  m1:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 rcx, 35
    x64.callDirect sparse
    x64.cmpRegImm32 r8, 9
    x64.jcc equal, m2
    x64.jmp critsplit
  m2:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 rcx, 9
    x64.callDirect sparse
    x64.cmpRegImm32 r8, 9
    x64.jcc equal, o1
    x64.jmp critsplit
  o1:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 rcx, 11
    x64.callDirect sparse
    x64.cmpRegImm32 r8, 9
    x64.jcc equal, o2
    x64.jmp critsplit
  o2:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 rcx, 51
    x64.callDirect sparse
    x64.cmpRegImm32 r8, 9
    x64.jcc equal, o3
    x64.jmp critsplit
  o3:
    x64.leaRegRegImm32 r8, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.movRegReg r8, rbx
    x64.jmp ifcont
  ifcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
