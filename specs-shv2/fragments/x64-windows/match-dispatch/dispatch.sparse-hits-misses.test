// Test: dispatch.sparse-hits-misses
typealias N = int(i64.min to i64.max)

function sparse(x N) returns N
	return match x 'c'
		10 gives 1
		20 gives 2
		30 gives 3
		40 gives 4
		50 gives 5
		default gives 9
	end 'c'
end 'sparse'

function main() returns ExitCode
	var n = 0 as N
	if sparse(10) == 1 'h1'
		n = n + 1
	end 'h1'
	if sparse(30) == 3 'h3'
		n = n + 1
	end 'h3'
	if sparse(50) == 5 'h5'
		n = n + 1
	end 'h5'
	if sparse(25) == 9 'm1'
		n = n + 1
	end 'm1'
	if sparse(35) == 9 'm2'
		n = n + 1
	end 'm2'
	if sparse(9) == 9 'o1'
		n = n + 1
	end 'o1'
	if sparse(11) == 9 'o2'
		n = n + 1
	end 'o2'
	if sparse(51) == 9 'o3'
		n = n + 1
	end 'o3'
	return n as ExitCode
end 'main'
---
ExitCode: 8
---
func @sparse {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 30
    x64.jcc less, matchlo
    x64.jmp matchhi
  matchlo:
    x64.cmpRegImm32 rcx, 10
    x64.jcc equal, matcharm#1
    x64.jmp matchnext#9
  matcharm#1:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont
  matchnext#9:
    x64.cmpRegImm32 rcx, 20
    x64.jcc equal, matcharm#2
    x64.jmp matchdefault
  matcharm#2:
    x64.movRegImm32 r8, 2
    x64.jmp matchcont
  matchhi:
    x64.cmpRegImm32 rcx, 30
    x64.jcc equal, matcharm#3
    x64.jmp matchnext#10
  matcharm#3:
    x64.movRegImm32 r8, 3
    x64.jmp matchcont
  matchnext#10:
    x64.cmpRegImm32 rcx, 40
    x64.jcc equal, matcharm#4
    x64.jmp matchnext#11
  matcharm#4:
    x64.movRegImm32 r8, 4
    x64.jmp matchcont
  matchnext#11:
    x64.cmpRegImm32 rcx, 50
    x64.jcc equal, matcharm#5
    x64.jmp matchdefault
  matcharm#5:
    x64.movRegImm32 r8, 5
    x64.jmp matchcont
  matchdefault:
    x64.movRegImm32 r8, 9
    x64.jmp matchcont
  matchcont:
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 10
    x64.callDirect sparse
    x64.cmpRegImm32 r8, 1
    x64.jcc equal, h1
    x64.jmp critsplit#20
  h1:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#2
  critsplit#20:
    x64.jmp ifcont#2
  ifcont#2:
    x64.movRegImm32 rcx, 30
    x64.callDirect sparse
    x64.cmpRegImm32 r8, 3
    x64.jcc equal, h3
    x64.jmp critsplit#21
  h3:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#4
  critsplit#21:
    x64.jmp ifcont#4
  ifcont#4:
    x64.movRegImm32 rcx, 50
    x64.callDirect sparse
    x64.cmpRegImm32 r8, 5
    x64.jcc equal, h5
    x64.jmp critsplit#22
  h5:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#6
  critsplit#22:
    x64.jmp ifcont#6
  ifcont#6:
    x64.movRegImm32 rcx, 25
    x64.callDirect sparse
    x64.cmpRegImm32 r8, 9
    x64.jcc equal, m1
    x64.jmp critsplit#23
  m1:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#8
  critsplit#23:
    x64.jmp ifcont#8
  ifcont#8:
    x64.movRegImm32 rcx, 35
    x64.callDirect sparse
    x64.cmpRegImm32 r8, 9
    x64.jcc equal, m2
    x64.jmp critsplit#24
  m2:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#10
  critsplit#24:
    x64.jmp ifcont#10
  ifcont#10:
    x64.movRegImm32 rcx, 9
    x64.callDirect sparse
    x64.cmpRegImm32 r8, 9
    x64.jcc equal, o1
    x64.jmp critsplit#25
  o1:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#12
  critsplit#25:
    x64.jmp ifcont#12
  ifcont#12:
    x64.movRegImm32 rcx, 11
    x64.callDirect sparse
    x64.cmpRegImm32 r8, 9
    x64.jcc equal, o2
    x64.jmp critsplit#26
  o2:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#14
  critsplit#26:
    x64.jmp ifcont#14
  ifcont#14:
    x64.movRegImm32 rcx, 51
    x64.callDirect sparse
    x64.cmpRegImm32 r8, 9
    x64.jcc equal, o3
    x64.jmp critsplit#27
  o3:
    x64.leaRegRegImm32 rax, rbx, 1
    x64.jmp ifcont#16
  critsplit#27:
    x64.movRegReg rax, rbx
    x64.jmp ifcont#16
  ifcont#16:
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rcx, 4294967295
    x64.cmpRegReg rax, rcx
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.leaRegRegImm32 r8, rax, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
