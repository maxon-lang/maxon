// Test: dispatch.boxed-union-tree
typealias N = int(0 to 1000)

union Shape
	circle(r N)
	square(s N)
	tri(a N)
	pent(b N)
	hex(c N)
end 'Shape'

function sides(sh Shape) returns ExitCode
	return match sh 'm'
		circle gives 0
		square gives 44
		tri gives 33
		pent gives 55
		hex gives 66
	end 'm'
end 'sides'

function main() returns ExitCode
	var n = 0 as ExitCode
	if sides(Shape.circle(1)) == 0 'a' n = n + 1 end 'a'
	if sides(Shape.square(2)) == 44 'b' n = n + 1 end 'b'
	if sides(Shape.tri(3)) == 33 'c' n = n + 1 end 'c'
	if sides(Shape.pent(4)) == 55 'd' n = n + 1 end 'd'
	if sides(Shape.hex(5)) == 66 'e' n = n + 1 end 'e'
	return n
end 'main'
---
ExitCode: 5
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @sides {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.jumpTable rax, default=matchdead [[0]=matcharm, [1]=matcharm, [2]=matcharm, [3]=matcharm, [4]=matcharm] @__jumptable_0
  matchdead:
  matcharm:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matcharm:
    x64.movRegImm32 r8, 44
    x64.jmp matchcont
  matcharm:
    x64.movRegImm32 r8, 33
    x64.jmp matchcont
  matcharm:
    x64.movRegImm32 r8, 55
    x64.jmp matchcont
  matcharm:
    x64.movRegImm32 r8, 66
    x64.jmp matchcont
  matchcont:
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 r12, 1
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r13 + 0], rax
    x64.storeBaseDispReg.word64 [r13 + 8], r12
    x64.movRegReg rcx, r13
    x64.callDirect sides
    x64.cmpRegImm32 r8, 0
    x64.setccReg equal, r12
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc notEqual, a
    x64.jmp critsplit
  a:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 r12, 2
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r13 + 0], rax
    x64.storeBaseDispReg.word64 [r13 + 8], r12
    x64.movRegReg rcx, r13
    x64.callDirect sides
    x64.cmpRegImm32 r8, 44
    x64.setccReg equal, r12
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc notEqual, b
    x64.jmp critsplit
  b:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 r12, 3
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.movRegImm32 rax, 2
    x64.storeBaseDispReg.word64 [r13 + 0], rax
    x64.storeBaseDispReg.word64 [r13 + 8], r12
    x64.movRegReg rcx, r13
    x64.callDirect sides
    x64.cmpRegImm32 r8, 33
    x64.setccReg equal, r12
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc notEqual, c
    x64.jmp critsplit
  c:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 r12, 4
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.movRegImm32 rax, 3
    x64.storeBaseDispReg.word64 [r13 + 0], rax
    x64.storeBaseDispReg.word64 [r13 + 8], r12
    x64.movRegReg rcx, r13
    x64.callDirect sides
    x64.cmpRegImm32 r8, 55
    x64.setccReg equal, r12
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc notEqual, d
    x64.jmp critsplit
  d:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 r12, 5
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.movRegImm32 rax, 4
    x64.storeBaseDispReg.word64 [r13 + 0], rax
    x64.storeBaseDispReg.word64 [r13 + 8], r12
    x64.movRegReg rcx, r13
    x64.callDirect sides
    x64.cmpRegImm32 r8, 66
    x64.setccReg equal, r12
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc notEqual, e
    x64.jmp critsplit
  e:
    x64.leaRegRegImm32 r8, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.movRegReg r8, rbx
    x64.jmp ifcont
  ifcont:
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
