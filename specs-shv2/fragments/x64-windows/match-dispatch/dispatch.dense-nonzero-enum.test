// Test: dispatch.dense-nonzero-enum
enum Priority
	p0 = 10
	p1 = 11
	p2 = 12
	p3 = 13
	p4 = 14
end 'Priority'

function rank(p Priority) returns ExitCode
	return match p 'm'
		p0 gives 1
		p1 gives 2
		p2 gives 3
		p3 gives 4
		p4 gives 5
	end 'm'
end 'rank'

function main() returns ExitCode
	var n = 0 as ExitCode
	if rank(Priority.p0) == 1 'a' n = n + 1 end 'a'
	if rank(Priority.p1) == 2 'b' n = n + 1 end 'b'
	if rank(Priority.p2) == 3 'c' n = n + 1 end 'c'
	if rank(Priority.p3) == 4 'd' n = n + 1 end 'd'
	if rank(Priority.p4) == 5 'e' n = n + 1 end 'e'
	return n
end 'main'
---
ExitCode: 5
---
func @rank {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 12
    x64.jcc less, matchlo
    x64.jmp matchhi
  matchlo:
    x64.cmpRegImm32 rcx, 10
    x64.jcc equal, matcharm
    x64.jmp matchnext
  matcharm:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rcx, 11
    x64.jcc equal, matcharm
    x64.jmp matchdead
  matcharm:
    x64.movRegImm32 r8, 2
    x64.jmp matchcont
  matchhi:
    x64.cmpRegImm32 rcx, 12
    x64.jcc equal, matcharm
    x64.jmp matchnext
  matcharm:
    x64.movRegImm32 r8, 3
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rcx, 13
    x64.jcc equal, matcharm
    x64.jmp matchnext
  matcharm:
    x64.movRegImm32 r8, 4
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rcx, 14
    x64.jcc equal, matcharm
    x64.jmp matchdead
  matcharm:
    x64.movRegImm32 r8, 5
    x64.jmp matchcont
  matchcont:
    x64.popReg rbp
    x64.ret
  matchdead:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 10
    x64.callDirect rank
    x64.cmpRegImm32 r8, 1
    x64.jcc equal, a
    x64.jmp critsplit
  a:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 rcx, 11
    x64.callDirect rank
    x64.cmpRegImm32 r8, 2
    x64.jcc equal, b
    x64.jmp critsplit
  b:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 rcx, 12
    x64.callDirect rank
    x64.cmpRegImm32 r8, 3
    x64.jcc equal, c
    x64.jmp critsplit
  c:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 rcx, 13
    x64.callDirect rank
    x64.cmpRegImm32 r8, 4
    x64.jcc equal, d
    x64.jmp critsplit
  d:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 rcx, 14
    x64.callDirect rank
    x64.cmpRegImm32 r8, 5
    x64.jcc equal, e
    x64.jmp critsplit
  e:
    x64.leaRegRegImm32 r8, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.movRegReg r8, rbx
    x64.jmp ifcont
  ifcont:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
