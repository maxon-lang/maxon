// Test: dispatch.fallthrough-to-default-tree
typealias N = int(0 to 1000)

function ftd(x N) returns N
	var r = 0 as N
	match x 'c'
		1 then r = r + 1 and fallthrough
		2 then r = r + 2 and fallthrough
		3 then r = r + 4 and fallthrough
		4 then r = r + 8 and fallthrough
		default then r = r + 100
	end 'c'
	return r
end 'ftd'

function main() returns ExitCode
	var n = 0 as N
	if ftd(1) == 115 'a' n = n + 1 end 'a'
	if ftd(3) == 112 'b' n = n + 1 end 'b'
	if ftd(4) == 108 'c' n = n + 1 end 'c'
	if ftd(9) == 100 'd' n = n + 1 end 'd'
	return n as ExitCode
end 'main'
---
ExitCode: 4
---
func @ftd {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 rcx, 3
    x64.jcc less, matchlo
    x64.jmp matchhi
  matchlo:
    x64.cmpRegImm32 rcx, 1
    x64.jcc equal, matcharm
    x64.jmp matchnext
  matcharm:
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp matcharm
  matchnext:
    x64.cmpRegImm32 rcx, 2
    x64.jcc equal, critsplit
    x64.jmp critsplit
  critsplit:
    x64.jmp matcharm
  matcharm:
    x64.leaRegRegImm32 rax, rax, 2
    x64.jmp matcharm
  critsplit:
    x64.jmp matchdefault
  matchhi:
    x64.cmpRegImm32 rcx, 3
    x64.jcc equal, critsplit
    x64.jmp matchnext
  critsplit:
    x64.jmp matcharm
  matcharm:
    x64.leaRegRegImm32 rax, rax, 4
    x64.jmp matcharm
  matchnext:
    x64.cmpRegImm32 rcx, 4
    x64.jcc equal, critsplit
    x64.jmp critsplit
  critsplit:
    x64.jmp matcharm
  matcharm:
    x64.leaRegRegImm32 rax, rax, 8
    x64.jmp matchdefault
  critsplit:
    x64.jmp matchdefault
  matchdefault:
    x64.leaRegRegImm32 r8, rax, 100
    x64.jmp matchcont
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 1000
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 1
    x64.callDirect ftd
    x64.cmpRegImm32 r8, 115
    x64.jcc equal, a
    x64.jmp critsplit
  a:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 rcx, 3
    x64.callDirect ftd
    x64.cmpRegImm32 r8, 112
    x64.jcc equal, b
    x64.jmp critsplit
  b:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 rcx, 4
    x64.callDirect ftd
    x64.cmpRegImm32 r8, 108
    x64.jcc equal, c
    x64.jmp critsplit
  c:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 rcx, 9
    x64.callDirect ftd
    x64.cmpRegImm32 r8, 100
    x64.jcc equal, d
    x64.jmp critsplit
  d:
    x64.leaRegRegImm32 r8, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.movRegReg r8, rbx
    x64.jmp ifcont
  ifcont:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
