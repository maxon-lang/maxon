// Test: dispatch.carried-var-merge-tree
typealias N = int(0 to 1000)

function pick(x N) returns N
	var r = 0 as N
	match x 'c'
		1 then r = 10
		2 then r = 20
		3 then r = 30
		4 then r = 40
		5 then r = 50
		default then r = 99
	end 'c'
	return r
end 'pick'

function main() returns ExitCode
	var n = 0 as N
	if pick(1) == 10 'a'
		n = n + 1
	end 'a'
	if pick(3) == 30 'b'
		n = n + 1
	end 'b'
	if pick(5) == 50 'c'
		n = n + 1
	end 'c'
	if pick(99) == 99 'd'
		n = n + 1
	end 'd'
	return n as ExitCode
end 'main'
---
ExitCode: 4
---
func @pick {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 rcx, 1000
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.leaRegRegImm32 rax, rcx, -1
    x64.jumpTable rax, default=matchdefault [[0]=matcharm#1, [1]=matcharm#2, [2]=matcharm#3, [3]=matcharm#4, [4]=matcharm#5] @__jumptable_2
  matchdefault:
    x64.movRegImm32 r8, 99
    x64.jmp matchcont
  matcharm#1:
    x64.movRegImm32 r8, 10
    x64.jmp matchcont
  matcharm#2:
    x64.movRegImm32 r8, 20
    x64.jmp matchcont
  matcharm#3:
    x64.movRegImm32 r8, 30
    x64.jmp matchcont
  matcharm#4:
    x64.movRegImm32 r8, 40
    x64.jmp matchcont
  matcharm#5:
    x64.movRegImm32 r8, 50
    x64.jmp matchcont
  matchcont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 1
    x64.callDirect pick
    x64.cmpRegImm32 r8, 10
    x64.jcc equal, a
    x64.jmp critsplit#15
  a:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#2
  critsplit#15:
    x64.jmp ifcont#2
  ifcont#2:
    x64.movRegImm32 rcx, 3
    x64.callDirect pick
    x64.cmpRegImm32 r8, 30
    x64.jcc equal, b
    x64.jmp critsplit#16
  b:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#4
  critsplit#16:
    x64.jmp ifcont#4
  ifcont#4:
    x64.movRegImm32 rcx, 5
    x64.callDirect pick
    x64.cmpRegImm32 r8, 50
    x64.jcc equal, c
    x64.jmp critsplit#17
  c:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#6
  critsplit#17:
    x64.jmp ifcont#6
  ifcont#6:
    x64.movRegImm32 rcx, 99
    x64.callDirect pick
    x64.cmpRegImm32 r8, 99
    x64.jcc equal, d
    x64.jmp critsplit#18
  d:
    x64.leaRegRegImm32 r8, rbx, 1
    x64.jmp ifcont#8
  critsplit#18:
    x64.movRegReg r8, rbx
    x64.jmp ifcont#8
  ifcont#8:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#10
    x64.jmp __rc_chk#11
  __rc_chk#11:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic#10
    x64.jmp __rc_ok#9
  __rc_panic#10:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#9:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#13
    x64.jmp __rc_chk#14
  __rc_chk#14:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic#13
    x64.jmp __rc_ok#12
  __rc_panic#13:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#12:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
