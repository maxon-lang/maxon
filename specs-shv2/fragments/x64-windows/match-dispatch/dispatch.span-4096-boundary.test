		default gives 0
	end 'm'
end 'bucket'

function main() returns ExitCode
	// value v in [0,4095] routes to bucket (v/32)+1; 4096 and -1 are just outside the span, so the default.
	var n = 0 as ExitCode
	if bucket(0) == 1 'a'
		n = n + 1
	end 'a'
	if bucket(31) == 1 'b'
		n = n + 1
	end 'b'
	if bucket(32) == 2 'c'
		n = n + 1
	end 'c'
	if bucket(2047) == 64 'd'
		n = n + 1
	end 'd'
	if bucket(4095) == 128 'e'
		n = n + 1
	end 'e'
	if bucket(4096) == 0 'f'
		n = n + 1
	end 'f'
	if bucket(-1) == 0 'g'
		n = n + 1
	end 'g'
	return n as ExitCode
end 'main'
