    x64.orRegReg rsi, rbx, rcx
    x64.movRegReg rax, r8
    x64.cqo
    x64.idivReg rsi
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, tryerr#2
    x64.jmp tryok#1
  tryerr#2:
    x64.movRegImm32 r12, 77
    x64.jmp trycont#3
  tryok#1:
    x64.movRegReg r12, rdx
    x64.jmp trycont#3
  trycont#3:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 rcx, rax, -7
    x64.callDirect ident
    x64.cmpRegImm32 rbx, 0
    x64.setccReg equal, rcx
    x64.cmpRegImm32 rbx, -1
    x64.setccReg equal, rax
    x64.leaRegRegImm32 rax, rax, -1
    x64.andRegReg r8, r8, rax
    x64.movRegReg rsi, rbx
    x64.orRegReg rsi, rbx, rcx
    x64.movRegReg rax, r8
    x64.cqo
    x64.idivReg rsi
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, tryerr#5
    x64.jmp tryok#4
  tryerr#5:
    x64.movRegImm32 r13, 77
    x64.jmp trycont#6
  tryok#4:
    x64.movRegReg r13, rdx
    x64.jmp trycont#6
  trycont#6:
    x64.movRegImm32 rcx, 0
    x64.callDirect ident
    x64.cmpRegImm32 rbx, 0
    x64.setccReg equal, rcx
    x64.cmpRegImm32 rbx, -1
    x64.setccReg equal, rax
    x64.leaRegRegImm32 rax, rax, -1
    x64.andRegReg r8, r8, rax
    x64.orRegReg rbx, rbx, rcx
    x64.movRegReg rax, r8
    x64.cqo
    x64.idivReg rbx
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, tryerr#8
    x64.jmp tryok#7
  tryerr#8:
    x64.movRegImm32 rbx, 77
    x64.jmp trycont#9
  tryok#7:
    x64.movRegReg rbx, rdx
    x64.jmp trycont#9
  trycont#9:
    x64.leaRegRdata rax, [rip + __str_rec_4]
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.storeSlotReg slot9, rcx
    x64.loadRegBaseDisp.word64 r14, [rax + 8]
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot8, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r8
    x64.callDirect __int_to_string
    x64.movRegReg r12, r8
    x64.leaRegRdata rax, [rip + __str_rec_5]
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.storeSlotReg slot7, rcx
    x64.loadRegBaseDisp.word64 r15, [rax + 8]
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot6, r8
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r8
    x64.callDirect __int_to_string
    x64.movRegReg r13, r8
    x64.leaRegRdata rax, [rip + __str_rec_6]
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.storeSlotReg slot5, rcx
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.storeSlotReg slot11, rax
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot10, r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __int_to_string
    x64.storeSlotReg slot4, r8
    x64.leaRegRdata rax, [rip + __str_rec_7]
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.storeSlotReg slot2, rcx
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.storeSlotReg slot0, rax
    x64.leaRegRegReg rcx, r14, r12
    x64.leaRegRegReg rcx, rcx, r15
    x64.leaRegRegReg rcx, rcx, r13
    x64.loadRegSlot rdx, slot11
    x64.leaRegRegReg rcx, rcx, rdx
    x64.leaRegRegReg rcx, rcx, r8
    x64.leaRegRegReg rax, rcx, rax
    x64.storeSlotReg slot1, rax
    x64.leaRegRegImm32 rcx, rax, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot3, r8
    x64.leaRegRegImm32 rbx, r8, 56
    x64.movRegReg rcx, rbx
    x64.loadRegSlot rdx, slot9
    x64.movRegReg rax, r14
    x64.callDirect __str_copy
    x64.leaRegRegReg r14, rbx, r14
    x64.movRegReg rcx, r14
    x64.loadRegSlot rdx, slot8
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg r12, r14, r12
    x64.movRegReg rcx, r12
    x64.loadRegSlot rdx, slot7
    x64.movRegReg rax, r15
    x64.callDirect __str_copy
    x64.leaRegRegReg r12, r12, r15
