// Test: enum-match-range.multiple-ranges
typealias Integer = int(i64.min to i64.max)

union Op
	add
	sub
	mul
	div
	exec(code Integer)
end 'Op'

function main() returns ExitCode
	let op = Op.div
	let result = match op 'check'
		add to sub gives 1
		mul to div gives 2
		exec(code) gives code
	end 'check'
	return result
end 'main'
---
ExitCode: 2
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegImm32 rax, 3
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r8 + 8], rax
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.cmpRegImm32 rax, 0
    x64.setccReg greaterEqual, rcx
    x64.cmpRegImm32 rax, 1
    x64.setccReg lessEqual, rdx
    x64.andRegReg rcx, rcx, rdx
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, matcharm#1
    x64.jmp matchnext#5
  matcharm#1:
    x64.movRegImm32 rbx, 1
    x64.jmp matchcont
  matchnext#5:
    x64.cmpRegImm32 rax, 2
    x64.setccReg greaterEqual, rcx
    x64.cmpRegImm32 rax, 3
    x64.setccReg lessEqual, rdx
    x64.andRegReg rcx, rcx, rdx
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, matcharm#2
    x64.jmp matchnext#6
  matcharm#2:
    x64.movRegImm32 rbx, 2
    x64.jmp matchcont
  matchnext#6:
    x64.cmpRegImm32 rax, 4
    x64.jcc equal, matcharm#3
    x64.jmp matchdead
  matcharm#3:
    x64.loadRegBaseDisp.word64 rbx, [r8 + 8]
    x64.jmp matchcont
  matchcont:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
}
