// Test: match-gives-same-type
function main() returns ExitCode
	let c = 0
	let r = match c 'pick'
		0 gives 10
		default gives 20
	end 'pick'
	return r
end 'main'
---
ExitCode: 10
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm
    x64.jmp matchdefault
  matcharm:
    x64.movRegImm32 r8, 10
    x64.jmp matchcont
  matchdefault:
    x64.movRegImm32 r8, 20
    x64.jmp matchcont
  matchcont:
    x64.popReg rbp
    x64.ret
}
