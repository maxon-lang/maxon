// Test: equals-branching

typealias Integer = int(i64.min to i64.max)

type Token implements Equatable
	export var id as Integer

	function equals(other Token) returns bool
		return id == other.id
	end 'equals'

	static function create(id Integer) returns Self
		return Self{id: id}
	end 'create'
end 'Token'

function main() returns ExitCode
	let a = Token.create(10)
	let b = Token.create(10)
	let c = Token.create(20)
	var result = 0
	if a.equals(b) 'first'
		result = result + 1
	end 'first'
	if a.equals(c) 'second'
		result = result + 10
	end 'second'
	if b.equals(c) 'third'
		result = result + 100
	end 'third'
	return result
end 'main'
---
ExitCode: 1
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Token.equals {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.word64 rcx, [rdx + 0]
    x64.cmpRegReg rax, rcx
    x64.setccReg equal, r8
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 64
    x64.movRegImm32 rax, 10
    x64.leaRegSlot rbx, slot0
    x64.storeBaseDispReg.word64 [rbx + 0], rax
    x64.movRegImm32 rax, 10
    x64.leaRegSlot r12, slot1
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.movRegImm32 rax, 20
    x64.leaRegSlot r13, slot2
    x64.storeBaseDispReg.word64 [r13 + 0], rax
    x64.movRegImm32 r14, 0
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect Token.equals
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, first
    x64.jmp critsplit#10
  first:
    x64.leaRegRegImm32 r14, r14, 1
    x64.jmp ifcont#2
  critsplit#10:
    x64.jmp ifcont#2
  ifcont#2:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect Token.equals
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, second
    x64.jmp critsplit#11
  second:
    x64.leaRegRegImm32 rbx, r14, 10
    x64.jmp ifcont#4
  critsplit#11:
    x64.movRegReg rbx, r14
    x64.jmp ifcont#4
  ifcont#4:
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r13
    x64.callDirect Token.equals
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, third
    x64.jmp critsplit#12
  third:
    x64.leaRegRegImm32 r8, rbx, 100
    x64.jmp ifcont#6
  critsplit#12:
    x64.movRegReg r8, rbx
    x64.jmp ifcont#6
  ifcont#6:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 64
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 64
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
