// Test: single-field

typealias Integer = int(i64.min to i64.max)

type Wrapper implements Equatable
	export var value as Integer

	function equals(other Wrapper) returns bool
		return value == other.value
	end 'equals'

	static function create(value Integer) returns Self
		return Self{value: value}
	end 'create'
end 'Wrapper'

function main() returns ExitCode
	let a = Wrapper.create(42)
	let b = Wrapper.create(42)
	let c = Wrapper.create(99)
	if a.equals(b) 'eq'
		if a.equals(c) 'neq'
			return 1
		end 'neq'
		return 0
	end 'eq'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Wrapper.equals {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.word64 rcx, [rdx + 0]
    x64.cmpRegReg rax, rcx
    x64.setccReg equal, r8
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 64
    x64.movRegImm32 rax, 42
    x64.leaRegSlot rbx, slot0
    x64.storeBaseDispReg.word64 [rbx + 0], rax
    x64.movRegImm32 rax, 42
    x64.leaRegSlot rdx, slot1
    x64.storeBaseDispReg.word64 [rdx + 0], rax
    x64.movRegImm32 rax, 99
    x64.leaRegSlot r12, slot2
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.movRegReg rcx, rbx
    x64.callDirect Wrapper.equals
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, eq
    x64.jmp ifcont#4
  eq:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect Wrapper.equals
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, neq
    x64.jmp ifcont#3
  neq:
    x64.movRegImm32 r8, 1
    x64.epilogue 64
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#3:
    x64.movRegImm32 r8, 0
    x64.epilogue 64
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegImm32 r8, 1
    x64.epilogue 64
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
