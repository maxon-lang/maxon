// Test: builtins-ucd.bmp-byte-load
function main() returns ExitCode
	var score = 0
	if __Builtins.ucdByteAt("__ucd_bmp", offset: 65) == 1 'upper'
		score = score + 1
	end 'upper'
	if __Builtins.ucdByteAt("__ucd_bmp", offset: 122) == 2 'lower'
		score = score + 1
	end 'lower'
	if __Builtins.ucdByteAt("__ucd_bmp", offset: 53) == 9 'digit'
		score = score + 1
	end 'digit'
	if __Builtins.ucdByteAt("__ucd_bmp", offset: 32) == 23 'space'
		score = score + 1
	end 'space'
	return score as ExitCode
end 'main'
---
ExitCode: 4
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 65
    x64.callDirect __ucd_bmp_at
    x64.cmpRegImm32 r8, 1
    x64.jcc notEqual, ifcont#2
  upper:
    x64.leaRegRegImm32 rbx, rbx, 1
  ifcont#2:
    x64.movRegImm32 rcx, 122
    x64.callDirect __ucd_bmp_at
    x64.cmpRegImm32 r8, 2
    x64.jcc notEqual, ifcont#4
  lower:
    x64.leaRegRegImm32 rbx, rbx, 1
  ifcont#4:
    x64.movRegImm32 rcx, 53
    x64.callDirect __ucd_bmp_at
    x64.cmpRegImm32 r8, 9
    x64.jcc notEqual, ifcont#6
  digit:
    x64.leaRegRegImm32 rbx, rbx, 1
  ifcont#6:
    x64.movRegImm32 rcx, 32
    x64.callDirect __ucd_bmp_at
    x64.cmpRegImm32 r8, 23
    x64.jcc notEqual, critsplit
  space:
    x64.leaRegRegImm32 r8, rbx, 1
    x64.jmp ifcont#8
  critsplit:
    x64.movRegReg r8, rbx
  ifcont#8:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
