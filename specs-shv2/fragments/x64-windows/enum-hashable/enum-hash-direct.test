// Test: enum-hash-direct
enum Direction
	north
	south
	east
	west
end 'Direction'

function main() returns ExitCode
	let d = Direction.south
	let h = d.hash()
	return h
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 r8, 1
  __il_cont:
    x64.popReg rbp
    x64.ret
}
