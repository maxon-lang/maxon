// Test: char-backed-enum-as-map-key
enum Grade
	excellent = 'A'
	good = 'B'
	average = 'C'
end 'Grade'

typealias Int = int(i64.min to i64.max)
typealias GradeMap = Map with (Grade, Int)

function main() returns ExitCode
	var m = GradeMap.create()
	try m.insert(Grade.excellent, value: 100) otherwise ignore
	try m.insert(Grade.good, value: 85) otherwise ignore
	let result = try m.get(Grade.excellent) otherwise 0
	return result
end 'main'
---
ExitCode: 100
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __layout_Map_Grade_Int]
    x64.leaRegRdata rdx, [rip + __witness_Grade.Hashable]
    x64.leaRegRdata rax, [rip + __witness_Grade.Equatable]
    x64.callDirect Map.create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 65
    x64.movRegImm32 rax, 100
    x64.leaRegRdata r9, [rip + __layout_Map_Grade_Int]
    x64.leaRegRdata rsi, [rip + __witness_Grade.Hashable]
    x64.leaRegRdata rdi, [rip + __witness_Grade.Equatable]
    x64.movRegReg rcx, rbx
    x64.callDirect Map.insert
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, trycont#3
  trycont#3:
    x64.movRegImm32 rdx, 66
    x64.movRegImm32 rax, 85
    x64.leaRegRdata r9, [rip + __layout_Map_Grade_Int]
    x64.leaRegRdata rsi, [rip + __witness_Grade.Hashable]
    x64.leaRegRdata rdi, [rip + __witness_Grade.Equatable]
    x64.movRegReg rcx, rbx
    x64.callDirect Map.insert
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, trycont#6
  trycont#6:
    x64.movRegImm32 rdx, 65
    x64.leaRegRdata rax, [rip + __layout_Map_Grade_Int]
    x64.leaRegRdata r9, [rip + __witness_Grade.Hashable]
    x64.leaRegRdata rsi, [rip + __witness_Grade.Equatable]
    x64.movRegReg rcx, rbx
    x64.callDirect Map.get
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm32 r12, 0
    x64.jmp trycont#9
  tryok:
    x64.movRegReg r12, r8
  trycont#9:
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Map_Grade_Int
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_23]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
