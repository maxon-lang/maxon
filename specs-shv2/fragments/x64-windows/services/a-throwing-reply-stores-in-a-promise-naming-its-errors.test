    x64.jmp drain
  divide:
    x64.loadRegBaseDisp.word64 rdx, [r13 + 8]
    x64.loadRegBaseDisp.word64 rax, [r13 + 16]
    x64.loadRegBaseDisp.word64 r14, [r13 + 24]
    x64.movRegReg rcx, rbx
    x64.callDirect Calc.divide
    x64.storeSlotReg slot0, r8
    x64.movRegReg r15, r10
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.cmpRegImm32 r15, 0
