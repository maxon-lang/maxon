// Test: a-reply-error-type-with-one-member-is-nameable
type Calc
	var count as int

	static function create() returns Self
		return Self{count: 7}
	end 'create'

	export function total() returns int
		return self.count
	end 'total'
end 'Calc'

function fetch(h Calc.handle) returns int throws ServiceError
	return try await h.total()
end 'fetch'

function main() returns ExitCode
	let h = spawn Calc.create()
	let v = try fetch(h) otherwise 1
	return v as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __gt_run_queue_head@8 = i64 0
  __gt_run_queue_tail@16 = i64 0
  __gt_init_done@24 = i64 0
  __gt_timer_count@32 = i64 0
  __gt_timer_heap_base@40 = i64 0
  __gt_timer_capacity@48 = i64 0
  __gt_trace_counter@56 = i64 0
  __gt_proc_count@64 = i64 0
  __gt_proc_handles_base@72 = i64 0
  __gt_proc_gts_base@80 = i64 0
  __gt_live_count@88 = i64 0
  __sched_active_workers@96 = i64 1
  __sched_max_active_workers@104 = i64 1
  __sched_tls_index@112 = i64 0
  __sched_tls_teb_offset@120 = i64 0
  __sched_procs@128 = i64 0
  __sched_num_procs@136 = i64 0
  __sched_shutdown_flag@144 = i64 0
  __sched_lock@152 = i64 0
  __slab_arena_list@160 = i64 0
  __slab_arena_map_l1@168 = i64 0
  __slab_state@176 = i64 0
}

func @Calc.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 7
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @fetch {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 0
    x64.callDirect __gt_cell_alloc
    x64.movRegReg r12, r8
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.storeBaseDispReg.word64 [r8 + 8], r12
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.movRegReg rdx, r8
    x64.callDirect __mbox_send
    x64.movRegReg rcx, r12
    x64.callDirect __gt_try_await
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegImm32 r10, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect Calc.create
    x64.leaRegFunc rcx, [rip + Calc.__loop]
    x64.leaRegFunc rax, [rip + Calc.__abandon]
    x64.movRegReg rdx, r8
    x64.callDirect __svc_spawn
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
    x64.movRegReg rcx, r12
    x64.callDirect fetch
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 rbx, 1
    x64.jmp trycont
  tryok:
    x64.movRegReg rbx, r8
    x64.jmp trycont
  trycont:
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, r12
    x64.callDirect __mbox_handle_drop_box
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Calc.__loop {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.jmp serve
  serve:
    x64.movRegReg rcx, r12
    x64.callDirect __mbox_recv
    x64.movRegReg r13, r8
    x64.cmpRegImm32 r13, 0
    x64.jcc equal, stopping
    x64.jmp dispatch
  dispatch:
    x64.loadRegBaseDisp.word64 rax, [r13 + 0]
    x64.jumpTable rax, default=stopping [[0]=__shutdown, [1]=total] @__jumptable_1
  __shutdown:
    x64.loadRegBaseDisp.word64 rax, [r13 + 8]
    x64.storeBaseDispReg.word64 [r12 + 56], rax
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.jmp stopping
  stopping:
    x64.movRegReg rcx, r12
    x64.callDirect __mbox_close
    x64.jmp drain
  drain:
    x64.movRegReg rcx, r12
    x64.callDirect __mbox_recv
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, finished
    x64.jmp abandon
  finished:
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r12
    x64.callDirect __mbox_service_exit
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  abandon:
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r8
    x64.callDirect __mbox_abandon
    x64.jmp drain
  total:
    x64.loadRegBaseDisp.word64 rcx, [r13 + 8]
    x64.jmp __il_body
  __il_body:
    x64.loadRegBaseDisp.word64 rdx, [rbx + 0]
    x64.jmp __il_cont
  __il_cont:
    x64.movRegImm32 rax, 0
    x64.callDirect __gt_cell_complete
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.jmp serve
}

func @Calc.__abandon {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.jumpTable rax, default=abandondrop [[0]=__shutdown, [1]=total] @__jumptable_2
  __shutdown:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 rax, 1
    x64.callDirect __gt_cell_complete
    x64.jmp abandondrop
  total:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 rax, 1
    x64.callDirect __gt_cell_complete
    x64.jmp abandondrop
  abandondrop:
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
