export type Calc
	var count as int

	static function create() returns Self
		return Self{count: 0}
	end 'create'

	export function bump(by int)
		self.count = self.count + by
	end 'bump'
end 'Calc'

export function serve(h Calc.handle) returns int
	return 1
end 'serve'

