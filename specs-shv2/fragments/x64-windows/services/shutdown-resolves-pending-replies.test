// Test: shutdown-resolves-pending-replies
type Slow
	var n as Integer

	static function create() returns Self
		return Self{n: 0}
	end 'create'

	export function value() returns Integer
		return self.n
	end 'value'
end 'Slow'

function main() returns ExitCode
	var stops = 0
	let h = spawn Slow.create()
	h.shutdown()
	try await h.value() otherwise (e) 'first'
		match e 'w1'
			stopped then stops = stops + 1
		end 'w1'
	end 'first'
	try await h.value() otherwise (e) 'second'
		match e 'w2'
			stopped then stops = stops + 1
		end 'w2'
	end 'second'
	return stops as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 2
---
data {
  __mm_alloc_count@0 = i64 0
  __gt_run_queue_head@8 = i64 0
  __gt_run_queue_tail@16 = i64 0
  __gt_init_done@24 = i64 0
  __gt_timer_count@32 = i64 0
  __gt_timer_heap_base@40 = i64 0
  __gt_timer_capacity@48 = i64 0
  __gt_trace_counter@56 = i64 0
  __gt_proc_count@64 = i64 0
  __gt_proc_handles_base@72 = i64 0
  __gt_proc_gts_base@80 = i64 0
  __gt_proc_wait_snapshot@88 = i64 0
  __gt_proc_poller@96 = i64 0
  __gt_live_count@104 = i64 0
  __sched_progress@112 = i64 0
  __sched_active_workers@120 = i64 1
  __sched_max_active_workers@128 = i64 1
  __sched_tls_index@136 = i64 0
  __sched_tls_teb_offset@144 = i64 0
  __sched_procs@152 = i64 0
  __sched_num_procs@160 = i64 0
  __sched_shutdown_flag@168 = i64 0
  __sched_lock@176 = i64 0
  __sched_nmspinning@184 = i64 0
  __sched_parked_drivers@192 = i64 0
  __slab_arena_list@200 = i64 0
  __slab_arena_map_l1@208 = i64 0
  __slab_state@216 = i64 0
}

func @Slow.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.callDirect Slow.create
    x64.leaRegFunc rcx, [rip + Slow.__loop]
    x64.leaRegFunc rax, [rip + Slow.__abandon]
    x64.movRegReg rdx, r8
    x64.callDirect __svc_spawn
    x64.movRegReg r12, r8
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], r12
    x64.movRegImm32 rcx, 0
    x64.callDirect __gt_cell_alloc
    x64.movRegReg r12, r8
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.storeBaseDispReg.word64 [r8 + 8], r12
    x64.loadRegBaseDisp.word64 rcx, [r13 + 0]
    x64.movRegReg rdx, r8
    x64.callDirect __mbox_send
    x64.movRegReg rcx, r12
    x64.callDirect __gt_promise_drop
    x64.movRegImm32 rcx, 0
    x64.callDirect __gt_cell_alloc
    x64.movRegReg r12, r8
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.storeBaseDispReg.word64 [r8 + 8], r12
    x64.loadRegBaseDisp.word64 rcx, [r13 + 0]
    x64.movRegReg rdx, r8
    x64.callDirect __mbox_send
    x64.movRegReg rcx, r12
    x64.callDirect __gt_try_await
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, trycont#6
  tryerr#2:
    x64.leaRegRegImm32 rax, r10, -1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchdead#4
  matcharm#3:
    x64.movRegImm32 rbx, 1
    x64.jmp trycont#6
  matchdead#4:
  tryok#1:
  trycont#6:
    x64.movRegImm32 rcx, 0
    x64.callDirect __gt_cell_alloc
    x64.movRegReg r12, r8
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.storeBaseDispReg.word64 [r8 + 8], r12
    x64.loadRegBaseDisp.word64 rcx, [r13 + 0]
    x64.movRegReg rdx, r8
    x64.callDirect __mbox_send
    x64.movRegReg rcx, r12
    x64.callDirect __gt_try_await
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, trycont#12
  tryerr#8:
    x64.leaRegRegImm32 rax, r10, -1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchdead#10
  matcharm#9:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp trycont#12
  matchdead#10:
  tryok#7:
  trycont#12:
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at shutdown-resolves-pending-replies.test:28: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
