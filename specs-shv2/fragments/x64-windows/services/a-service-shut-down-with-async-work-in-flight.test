// Test: a-service-shut-down-with-async-work-in-flight
typealias Integer = int(i64.min to i64.max)

function slowWork(n Integer) returns Integer
	sleep(30)
	return n * 2
end 'slowWork'

type Worker
	var n as Integer

	static function create() returns Self
		return Self{n: 0}
	end 'create'

	// Starts a coroutine on the SERVICE's own green thread and never awaits it. The promise dies at handler
	// scope exit, and the service is shut down by the handle drop below while the sleep is still in flight.
	export function fire(v Integer) returns Integer
		let p = async slowWork(v)
		_ = p
		self.n = self.n + 1
		return self.n
	end 'fire'
end 'Worker'

function main() returns ExitCode
	for round in 1 to 8 'rounds'
		let w = spawn Worker.create()
		w.fire(round)
	end 'rounds'

	print("survived\n")
	return 42 as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __gt_run_queue_head@8 = i64 0
  __gt_run_queue_tail@16 = i64 0
  __gt_init_done@24 = i64 0
  __gt_timer_count@32 = i64 0
  __gt_timer_heap_base@40 = i64 0
  __gt_timer_capacity@48 = i64 0
  __gt_trace_counter@56 = i64 0
  __gt_proc_count@64 = i64 0
  __gt_proc_handles_base@72 = i64 0
  __gt_proc_gts_base@80 = i64 0
  __gt_proc_wait_snapshot@88 = i64 0
  __gt_proc_poller@96 = i64 0
  __gt_live_count@104 = i64 0
  __sched_progress@112 = i64 0
  __sched_active_workers@120 = i64 1
  __sched_max_active_workers@128 = i64 1
  __sched_tls_index@136 = i64 0
  __sched_tls_teb_offset@144 = i64 0
  __sched_procs@152 = i64 0
  __sched_num_procs@160 = i64 0
  __sched_shutdown_flag@168 = i64 0
  __sched_lock@176 = i64 0
  __sched_nmspinning@184 = i64 0
  __sched_parked_drivers@192 = i64 0
  __slab_arena_list@200 = i64 0
  __slab_arena_map_l1@208 = i64 0
  __slab_state@216 = i64 0
}

func @slowWork {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 30
    x64.callDirect sleep
    x64.imulRegRegImm32 r8, rbx, 2
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Worker.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Worker.fire {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.leaRegFunc rcx, [rip + slowWork]
    x64.callDirect __gt_spawn
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 200], r12
    x64.movRegReg rcx, r13
    x64.callDirect __gt_ready
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.leaRegRegImm32 rax, rax, 1
    x64.storeBaseDispReg.word64 [rbx + 0], rax
    x64.loadRegBaseDisp.word64 rbx, [rbx + 0]
    x64.movRegReg rcx, r13
    x64.callDirect __gt_promise_drop
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 1
  forhdr:
    x64.cmpRegImm32 rbx, 8
    x64.jcc greater, forexit
  rounds:
    x64.callDirect Worker.create
    x64.leaRegFunc rcx, [rip + Worker.__loop]
    x64.leaRegFunc rax, [rip + Worker.__abandon]
    x64.movRegReg rdx, r8
    x64.callDirect __svc_spawn
    x64.movRegReg r12, r8
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], r12
    x64.movRegImm32 rcx, 0
    x64.callDirect __gt_cell_alloc
    x64.movRegReg r12, r8
    x64.movRegImm32 rcx, 24
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.storeBaseDispReg.word64 [r8 + 8], rbx
    x64.storeBaseDispReg.word64 [r8 + 16], r12
    x64.loadRegBaseDisp.word64 rcx, [r13 + 0]
    x64.movRegReg rdx, r8
    x64.callDirect __mbox_send
    x64.movRegReg rcx, r12
    x64.callDirect __gt_promise_drop
    x64.movRegReg rcx, r13
    x64.callDirect __mbox_handle_drop_box
  forstep:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp forhdr
  forexit:
    x64.leaRegRdata rcx, [rip + __str_rec_1]  ; "survived\x0a"
    x64.callDirect print
    x64.movRegImm32 r8, 42
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Worker.__loop {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
  serve:
    x64.movRegReg rcx, r12
    x64.callDirect __mbox_recv
    x64.movRegReg r13, r8
    x64.cmpRegImm32 r13, 0
    x64.jcc equal, stopping
  dispatch:
    x64.loadRegBaseDisp.word64 rax, [r13 + 0]
    x64.jumpTable rax, default=stopping [[0]=__shutdown, [1]=fire] @__jumptable_3
  __shutdown:
    x64.loadRegBaseDisp.word64 rax, [r13 + 8]
    x64.storeBaseDispReg.word64 [r12 + 56], rax
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
  stopping:
    x64.movRegReg rcx, r12
    x64.callDirect __mbox_close
  drain:
    x64.movRegReg rcx, r12
    x64.callDirect __mbox_recv
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, abandon
  finished:
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r12
    x64.callDirect __mbox_service_exit
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  abandon:
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r8
    x64.callDirect __mbox_abandon
    x64.jmp drain
  fire:
    x64.loadRegBaseDisp.word64 rdx, [r13 + 8]
    x64.loadRegBaseDisp.word64 r14, [r13 + 16]
    x64.movRegReg rcx, rbx
    x64.callDirect Worker.fire
    x64.movRegReg r15, r8
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.movRegImm32 rax, 0
    x64.movRegReg rcx, r14
    x64.movRegReg rdx, r15
    x64.callDirect __gt_cell_complete
    x64.jmp serve
}

func @Worker.__abandon {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.jumpTable rax, default=abandondrop [[0]=__shutdown, [1]=fire] @__jumptable_4
  __shutdown:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 rax, 1
    x64.callDirect __gt_cell_complete
    x64.jmp abandondrop
  fire:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 16]
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 rax, 1
    x64.callDirect __gt_cell_complete
  abandondrop:
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
