// Test: a-string-moves-in-and-a-fresh-string-comes-back
type Echo
	var n as Integer

	static function create() returns Self
		return Self{n: 0}
	end 'create'

	export function say(s String) returns String
		return "[{s}]"
	end 'say'
end 'Echo'

function main() returns ExitCode
	let h = spawn Echo.create()
	let out = try await h.say("hi") otherwise (e) 'gone'
		return 9 as ExitCode
	end 'gone'
	print("{out}\n")
	return 0
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: unpinned
---
data {
  __mm_alloc_count@0 = i64 0
  __gt_run_queue_head@8 = i64 0
  __gt_run_queue_tail@16 = i64 0
  __gt_init_done@24 = i64 0
  __gt_timer_count@32 = i64 0
