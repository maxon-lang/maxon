func @Svc.__loop {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
  serve:
    x64.movRegReg rcx, r12
    x64.callDirect __mbox_recv
    x64.movRegReg r13, r8
    x64.cmpRegImm32 r13, 0
    x64.jcc equal, stopping
  dispatch:
    x64.loadRegBaseDisp.word64 rax, [r13 + 0]
    x64.jumpTable rax, default=stopping [[0]=__shutdown, [1]=take] @__jumptable_9
  __shutdown:
    x64.loadRegBaseDisp.word64 rax, [r13 + 8]
    x64.storeBaseDispReg.word64 [r12 + 56], rax
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
  stopping:
    x64.movRegReg rcx, r12
    x64.callDirect __mbox_close
  drain:
    x64.movRegReg rcx, r12
    x64.callDirect __mbox_recv
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, abandon
  finished:
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r12
    x64.callDirect __mbox_service_exit
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  abandon:
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r8
    x64.callDirect __mbox_abandon
    x64.jmp drain
  take:
    x64.loadRegBaseDisp.word64 r14, [r13 + 8]
    x64.loadRegBaseDisp.word64 r15, [r13 + 16]
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r14
    x64.callDirect Svc.take
    x64.storeSlotReg slot0, r8
    x64.movRegReg rcx, r14
    x64.callDirect __managed_decref
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.movRegImm32 rax, 0
    x64.movRegReg rcx, r15
    x64.loadRegSlot rdx, slot0
    x64.callDirect __gt_cell_complete
    x64.jmp serve
}

func @Svc.__abandon {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.jumpTable rax, default=abandondrop [[0]=__shutdown, [1]=take] @__jumptable_10
  __shutdown:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 rax, 1
    x64.callDirect __gt_cell_complete
    x64.jmp abandondrop
  take:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 16]
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 rax, 1
    x64.callDirect __gt_cell_complete
  abandondrop:
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Svc.request
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
