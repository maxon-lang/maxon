func @Module.sumIds {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 0
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rdx, [rax + 8]
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
  forhdr:
    x64.cmpRegReg rcx, rdx
    x64.jcc greaterEqual, forexit
  each:
    x64.loadRegBaseIndexScale.word64 rsi, [rax + rcx*8 + 0]
  __im_cont:
    x64.loadRegBaseDisp.word64 rsi, [rsi + 0]
    x64.leaRegRegReg r8, r8, rsi
  forstep:
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.jmp forhdr
  forexit:
    x64.popReg rbp
    x64.ret
}

