// Test: sched-processor.many-green-threads-through-one-processor
function step(n Counted) returns Counted
	__Builtins.parallelBoundary()
	return n * 3
end 'step'

typealias Counted = int(i64.min to i64.max)
typealias CountedPromise = Promise with Counted
typealias CountedPromiseArray = Array with CountedPromise

function main() returns ExitCode
	var promises = CountedPromiseArray.create()

	for i in 0 upto 32 'spawn'
		promises.push(async step(i))
	end 'spawn'

	var total = 0

	for p in promises 'await'
		total = total + await p
	end 'await'

	if total == 1488 'expected'
		return 7
	end 'expected'
	return 1
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __gt_run_queue_head@8 = i64 0
  __gt_run_queue_tail@16 = i64 0
  __gt_init_done@24 = i64 0
  __gt_timer_count@32 = i64 0
  __gt_timer_heap_base@40 = i64 0
  __gt_timer_capacity@48 = i64 0
  __gt_trace_counter@56 = i64 0
  __gt_proc_count@64 = i64 0
  __gt_proc_handles_base@72 = i64 0
  __gt_proc_gts_base@80 = i64 0
  __gt_proc_wait_snapshot@88 = i64 0
  __gt_proc_poller@96 = i64 0
  __gt_live_count@104 = i64 0
  __sched_progress@112 = i64 0
  __sched_active_workers@120 = i64 1
  __sched_max_active_workers@128 = i64 1
  __sched_tls_index@136 = i64 0
  __sched_tls_teb_offset@144 = i64 0
  __sched_procs@152 = i64 0
  __sched_allm@160 = i64 0
  __sched_midle@168 = i64 0
  __sched_pidle@176 = i64 0
  __sched_num_procs@184 = i64 0
  __sched_shutdown_flag@192 = i64 0
  __sched_lock@200 = i64 0
  __sched_nmspinning@208 = i64 0
  __sched_parked_drivers@216 = i64 0
  __slab_arena_list@224 = i64 0
  __slab_arena_map_l1@232 = i64 0
  __slab_state@240 = i64 0
}

func @step {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.callDirect __parallel_boundary
    x64.imulRegRegImm32 r8, rbx, 3
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __gt_promise_drop]
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 0
  forhdr#1:
    x64.cmpRegImm32 r12, 32
    x64.jcc greaterEqual, forexit#4
  spawn:
    x64.leaRegFunc rcx, [rip + step]
    x64.callDirect __gt_spawn
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 200], r12
    x64.movRegReg rcx, r13
    x64.callDirect __gt_ready
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect __managed_push
  forstep#3:
    x64.leaRegRegImm32 r12, r12, 1
    x64.jmp forhdr#1
  forexit#4:
    x64.movRegImm32 r12, 0
    x64.movRegImm32 r13, 0
  forhdr#5:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegReg r13, rax
    x64.jcc greaterEqual, forexit#8
  await:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseIndexScale.word64 r14, [rax + r13*8 + 0]
  __im_cont:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect __managed_vacate
    x64.movRegReg rcx, r14
    x64.callDirect __gt_await
    x64.leaRegRegReg r12, r12, r8
  forstep#7:
    x64.leaRegRegImm32 r13, r13, 1
    x64.jmp forhdr#5
  forexit#8:
    x64.cmpRegImm32 r12, 1488
    x64.jcc notEqual, ifcont
  expected:
    x64.movRegImm32 r12, 7
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
