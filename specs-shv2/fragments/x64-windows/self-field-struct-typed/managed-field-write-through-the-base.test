// Test: managed-field-write-through-the-base

typealias Small = int(0 to 1000)

type Inner
	export var name as String

	static function create(n String) returns Self
		return Self{name: n}
	end 'create'
end 'Inner'

type Outer
	export var inner as Inner

	export function setViaAlias(n String)
		inner.name = n
	end 'setViaAlias'

	export function setViaSelf(n String)
		self.inner.name = n
	end 'setViaSelf'

	export function lenViaAlias() returns Small
		return inner.name.byteLength() as Small
	end 'lenViaAlias'

	static function create(i Inner) returns Self
		return Self{inner: i}
	end 'create'
end 'Outer'

function main() returns ExitCode
	var o = Outer.create(Inner.create("abc"))
	o.setViaAlias("hello world")
	let a = o.lenViaAlias()
	o.setViaSelf("hi")
	let b = o.lenViaAlias()
	return a * 10 + b
end 'main'
---
ExitCode: 112
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Inner.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r12 + 0], r8
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Outer.setViaAlias {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.loadRegBaseDisp.word64 rbx, [rcx + 0]
    x64.loadRegBaseDisp.word64 r12, [rbx + 0]
    x64.movRegReg rcx, rdx
    x64.callDirect __str_retain
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r12
    x64.callDirect __str_decref
    x64.storeBaseDispReg.word64 [rbx + 0], r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

