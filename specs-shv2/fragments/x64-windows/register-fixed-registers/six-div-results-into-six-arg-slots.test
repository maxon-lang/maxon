// Test: six-div-results-into-six-arg-slots
function digits6(p1 int, p2 int, p3 int, p4 int, p5 int, p6 int) returns int
	return p1 * 100000 + p2 * 10000 + p3 * 1000 + p4 * 100 + p5 * 10 + p6
end 'digits6'

function main() returns ExitCode
	let n1 = 100
	let n2 = 45
	let n3 = 23
	let d1 = 12
	let d2 = 7
	let d3 = 9
	let r = digits6(n1 / d1, p2: n1 mod d1, p3: n2 / d2, p4: n2 mod d2, p5: n3 / d3, p6: n3 mod d3)
	if r == 846325 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rcx, 100
    x64.movRegImm32 rsi, 45
    x64.movRegImm32 rdi, 23
    x64.movRegImm32 r8, 12
    x64.movRegImm32 r9, 7
    x64.movRegImm32 r10, 9
    x64.movRegReg rax, rcx
    x64.cqo
    x64.idivReg r8
    x64.movRegReg r11, rax
    x64.movRegReg rax, rcx
    x64.cqo
    x64.idivReg r8
    x64.movRegReg rcx, rdx
    x64.movRegReg rax, rsi
    x64.cqo
    x64.idivReg r9
    x64.movRegReg r8, rax
    x64.movRegReg rax, rsi
    x64.cqo
    x64.idivReg r9
    x64.movRegReg rsi, rdx
    x64.movRegReg rax, rdi
    x64.cqo
    x64.idivReg r10
    x64.movRegReg r9, rax
    x64.movRegReg rax, rdi
    x64.cqo
    x64.idivReg r10
  __il_body:
    x64.imulRegRegImm32 rax, r11, 100000
    x64.imulRegRegImm32 rcx, rcx, 10000
    x64.leaRegRegReg rax, rax, rcx
    x64.imulRegRegImm32 rcx, r8, 1000
    x64.leaRegRegReg rax, rax, rcx
    x64.imulRegRegImm32 rcx, rsi, 100
    x64.leaRegRegReg rax, rax, rcx
    x64.imulRegRegImm32 rcx, r9, 10
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegRegReg rax, rax, rdx
  __il_cont:
    x64.cmpRegImm32 rax, 846325
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.popReg rbp
    x64.ret
}
