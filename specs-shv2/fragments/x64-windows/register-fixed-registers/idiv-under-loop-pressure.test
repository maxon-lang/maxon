// Test: idiv-under-loop-pressure
typealias Positive = int(1 to i64.max)

function press(p int) returns int
	let k1 = p + 11
	let k2 = p + 12
	let k3 = p + 13
	let k4 = p + 14
	let k5 = p + 15
	let k6 = p + 16
	let k7 = p + 17
	let k8 = p + 18
	let k9 = p + 19
	var sum = 0
	var i = 1
	while i <= 5 'loop'
		let t = k1 + k2 + k3 + k4 + k5 + k6 + k7 + k8 + k9
		sum = sum + t / (i as Positive)
		i = i + 1
	end 'loop'
	return sum
end 'press'

function main() returns ExitCode
	let r = press(0)
	if r == 307 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @press {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.leaRegRegImm32 rsi, rcx, 11
    x64.leaRegRegImm32 rdi, rcx, 12
    x64.leaRegRegImm32 r8, rcx, 13
    x64.leaRegRegImm32 r9, rcx, 14
    x64.leaRegRegImm32 r10, rcx, 15
    x64.leaRegRegImm32 r11, rcx, 16
    x64.leaRegRegImm32 rbx, rcx, 17
    x64.leaRegRegImm32 r12, rcx, 18
    x64.leaRegRegImm32 rcx, rcx, 19
    x64.movRegImm32 r13, 0
    x64.movRegImm32 r14, 1
  whilehdr:
    x64.cmpRegImm32 r14, 5
    x64.jcc greater, whileexit
  loop:
    x64.leaRegRegReg rax, rsi, rdi
    x64.leaRegRegReg rax, rax, r8
    x64.leaRegRegReg rax, rax, r9
    x64.leaRegRegReg rax, rax, r10
    x64.leaRegRegReg rax, rax, r11
    x64.leaRegRegReg rax, rax, rbx
    x64.leaRegRegReg rax, rax, r12
    x64.leaRegRegReg rax, rax, rcx
    x64.cmpRegImm32 r14, 1
    x64.jcc greaterEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.cqo
    x64.idivReg r14
    x64.leaRegRegReg r13, r13, rax
    x64.leaRegRegImm32 r14, r14, 1
    x64.jmp whilehdr
  whileexit:
    x64.movRegReg r8, r13
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 0
    x64.callDirect press
    x64.cmpRegImm32 r8, 307
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
