// Test: idiv-under-loop-pressure
typealias Positive = int(1 to i64.max)

function press(p Integer) returns Integer
	let k1 = p + 11
	let k2 = p + 12
	let k3 = p + 13
	let k4 = p + 14
	let k5 = p + 15
	let k6 = p + 16
	let k7 = p + 17
	let k8 = p + 18
	let k9 = p + 19
	var sum = 0
	var i = 1
	while i <= 5 'loop'
		let t = k1 + k2 + k3 + k4 + k5 + k6 + k7 + k8 + k9
		sum = sum + t / (i as Positive)
		i = i + 1
	end 'loop'
	return sum
end 'press'

function main() returns ExitCode
	let r = press(0)
	if r == 307 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
func @press {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRegImm32 rax, rcx, 11
    x64.leaRegRegImm32 rdx, rcx, 12
    x64.leaRegRegImm32 rsi, rcx, 13
    x64.leaRegRegImm32 rdi, rcx, 14
    x64.leaRegRegImm32 r8, rcx, 15
    x64.leaRegRegImm32 r9, rcx, 16
    x64.leaRegRegImm32 r10, rcx, 17
    x64.leaRegRegImm32 r11, rcx, 18
    x64.leaRegRegImm32 rcx, rcx, 19
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 r12, 1
    x64.leaRegRegReg rax, rax, rdx
    x64.leaRegRegReg rax, rax, rsi
    x64.leaRegRegReg rax, rax, rdi
    x64.leaRegRegReg rax, rax, r8
    x64.leaRegRegReg rax, rax, r9
    x64.leaRegRegReg rax, rax, r10
    x64.leaRegRegReg rax, rax, r11
    x64.leaRegRegReg rcx, rax, rcx
    x64.movRegReg r8, rbx
    x64.movRegReg rsi, r12
  whilehdr:
    x64.cmpRegImm32 rsi, 5
    x64.jcc greater, whileexit
  loop:
    x64.cmpRegImm32 rsi, 1
    x64.jcc greaterEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rax, rcx
    x64.cqo
    x64.idivReg rsi
    x64.leaRegRegReg r8, r8, rax
    x64.leaRegRegImm32 rsi, rsi, 1
    x64.jmp whilehdr
  whileexit:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 0
    x64.callDirect press
    x64.cmpRegImm32 r8, 307
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
