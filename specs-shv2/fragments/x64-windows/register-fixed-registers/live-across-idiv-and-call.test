// Test: live-across-idiv-and-call
function sink(x int) returns int
	return x + 1
end 'sink'

function f(p int) returns int
	let a = p + 100
	let q = a / 7
	let s = sink(3)
	return a + q + s
end 'f'

function main() returns ExitCode
	let v = f(0)
	if v == 118 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @sink {
  entry:
    x64.leaRegRegImm32 r8, rcx, 1
    x64.ret
}

func @f {
  entry:
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 40
    x64.leaRegRegImm32 rbx, rcx, 100
    x64.movRegImm32 rcx, 7
    x64.movRegReg rax, rbx
    x64.cqo
    x64.idivReg rcx
    x64.movRegReg r12, rax
    x64.movRegImm32 rcx, 3
    x64.callDirect sink
    x64.leaRegRegReg rax, rbx, r12
    x64.leaRegRegReg r8, rax, r8
    x64.epilogue 40
    x64.popReg r12
    x64.popReg rbx
    x64.ret
}

func @main {
  entry:
    x64.prologue 40
    x64.movRegImm32 rcx, 0
    x64.callDirect f
    x64.cmpRegImm32 r8, 118
    x64.jcc equal, ok
    x64.jmp ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.epilogue 40
    x64.ret
}
