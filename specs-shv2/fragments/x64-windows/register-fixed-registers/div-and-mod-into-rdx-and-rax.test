// Test: div-and-mod-into-rdx-and-rax
function take3(p1 int, p2 int, p3 int) returns int
	return p1 * 10000 + p2 * 100 + p3
end 'take3'

function main() returns ExitCode
	let n = 97
	let d = 5
	let r = take3(1, p2: n / d, p3: n mod d)
	if r == 11902 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rcx, 97
    x64.movRegImm32 rsi, 5
    x64.movRegImm32 rdi, 1
    x64.movRegReg rax, rcx
    x64.cqo
    x64.idivReg rsi
    x64.movRegReg r8, rax
    x64.movRegReg rax, rcx
    x64.cqo
    x64.idivReg rsi
  __il_body:
    x64.imulRegRegImm32 rax, rdi, 10000
    x64.imulRegRegImm32 rcx, r8, 100
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegRegReg rax, rax, rdx
  __il_cont:
    x64.cmpRegImm32 rax, 11902
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.popReg rbp
    x64.ret
}
