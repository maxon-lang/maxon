// Test: divisor-live-across-call
function bump(x int) returns int
	return x + 1
end 'bump'

function main() returns ExitCode
	let n = 500
	var d = 6
	let t = bump(d)
	let q = n / d
	let r = q + t
	if r == 90 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 500
    x64.movRegImm32 rcx, 6
  __il_body:
    x64.leaRegRegImm32 rsi, rcx, 1
  __il_cont:
    x64.cqo
    x64.idivReg rcx
    x64.leaRegRegReg rax, rax, rsi
    x64.cmpRegImm32 rax, 90
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.popReg rbp
    x64.ret
}
