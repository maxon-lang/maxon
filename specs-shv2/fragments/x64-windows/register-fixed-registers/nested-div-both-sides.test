// Test: nested-div-both-sides
function main() returns ExitCode
	let a = 1000
	let b = 7
	let c = 60
	let d = 4
	let q1 = a / b
	let q2 = c / d
	let r = q1 / q2
	if r == 9 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rcx, 1000
    x64.movRegImm32 rsi, 60
    x64.movRegImm rax, 5270498306774157605
    x64.imulHighReg rcx
    x64.sarRegImm8 rdx, rdx, 1
    x64.movRegReg rax, rdx
    x64.shrRegImm8 rax, rdx, 63
    x64.leaRegRegReg rax, rdx, rax
    x64.sarRegImm8 rsi, rsi, 63
    x64.shrRegImm8 rsi, rsi, 62
    x64.leaRegRegImm32 rcx, rsi, 60
    x64.sarRegImm8 rcx, rcx, 2
    x64.cqo
    x64.idivReg rcx
    x64.cmpRegImm32 rax, 9
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.popReg rbp
    x64.ret
}
