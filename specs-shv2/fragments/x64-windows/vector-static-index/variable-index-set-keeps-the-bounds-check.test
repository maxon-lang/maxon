// Test: variable-index-set-keeps-the-bounds-check
typealias Int = int(i64.min to i64.max)
typealias Vec3 = Vector with 3 Int

function main() returns ExitCode
	var v = Vec3.create()
	var i = 0
	while i < 3 'fill'
		try v.set(i, value: 4) otherwise panic("test invariant: set OOB")
		i = i + 1
	end 'fill'
	var total = 0
	for elem in v 'sum'
		total = total + elem
	end 'sum'
	return total
end 'main'
---
ExitCode: 12
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 3
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_resize
    x64.movRegImm32 r12, 0
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegImm32 r12, 3
    x64.jcc less, fill
    x64.jmp whileexit
  fill:
    x64.movRegImm32 rax, 4
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __managed_set
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.leaRegRegImm32 r12, r12, 1
    x64.jmp whilehdr
  whileexit:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect Vector.createIterator
    x64.movRegReg r13, r8
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, critsplit
    x64.jmp forempty
  critsplit:
    x64.jmp forhdr
  forhdr:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, sum
    x64.jmp forexit
  sum:
    x64.leaRegRdata rdx, [rip + __layout_ArrayIterator_Int]
    x64.movRegReg rcx, r13
    x64.callDirect ArrayIterator.current
    x64.leaRegRegReg r12, r12, r8
    x64.jmp forstep
  forstep:
    x64.movRegReg rcx, r13
    x64.callDirect ArrayIterator.advance
    x64.movRegReg rax, r10
    x64.jmp forhdr
  forexit:
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_ArrayIterator_Int
    x64.jmp forjoin
  forempty:
    x64.jmp forjoin
  forjoin:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @ArrayIterator.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect __managed_cursor_create
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 r10, rax, 1
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_cursor_decref
    x64.movRegImm32 r10, 0
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @ArrayIterator.current {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rdx
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callDirect __managed_cursor_current
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __retain_type_param
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @ArrayIterator.advance {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callDirect __managed_cursor_advance
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 r10, rax, 1
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @Vector.createIterator {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.callDirect __mm_retain
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect ArrayIterator.create
    x64.movRegReg r12, r8
    x64.movRegReg r13, r10
    x64.cmpRegImm32 r13, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegImm32 r8, 0
    x64.movRegReg r10, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegImm32 r10, 0
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @__managed_set {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 56
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.storeSlotReg slot1, r12
    x64.storeSlotReg slot0, rax
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
    x64.movRegImm32 rdx, 0
    x64.cmpRegReg r12, rdx
    x64.setccReg less, rdx
    x64.cmpRegReg r12, rcx
    x64.setccReg greaterEqual, rcx
    x64.orRegReg rdx, rdx, rcx
    x64.cmpRegImm32 rdx, 0
    x64.jcc notEqual, oob
    x64.jmp store
  oob:
    x64.loadRegBaseDisp.word64 rbx, [rbx + 40]
    x64.movRegImm32 rcx, 0
    x64.cmpRegReg rbx, rcx
    x64.jcc notEqual, rejchk
    x64.jmp rejcont
  rejchk:
    x64.movRegImm32 rcx, 0
    x64.cmpRegReg rax, rcx
    x64.jcc notEqual, rejdrop
    x64.jmp rejcont
  rejdrop:
    x64.movRegReg rcx, rax
    x64.callReg rbx
    x64.jmp rejcont
  rejcont:
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 1
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  store:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_cow_detach
    x64.loadRegBaseDisp.word64 r13, [rbx + 0]
    x64.loadRegBaseDisp.word64 r14, [rbx + 24]
    x64.movRegImm32 rax, 1
    x64.leaRegRegReg r15, r12, rax
    x64.loadRegBaseDisp.word64 rbx, [rbx + 40]
    x64.movRegImm32 rax, 0
    x64.cmpRegReg rbx, rax
    x64.jcc notEqual, mwalk
    x64.jmp mcont
  mwalk:
    x64.jmp dtorh
  dtorh:
    x64.cmpRegReg r12, r15
    x64.jcc greaterEqual, dtordone
    x64.jmp dtorb
  dtordone:
    x64.jmp mcont
  dtorb:
    x64.movRegReg rax, r12
    x64.imulRegReg rax, r12, r14
    x64.leaRegRegReg rax, r13, rax
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.movRegImm32 rax, 0
    x64.cmpRegReg rcx, rax
    x64.jcc notEqual, dtordo
    x64.jmp dtorstep
  dtordo:
    x64.callReg rbx
    x64.jmp dtorstep
  dtorstep:
    x64.movRegImm32 rax, 1
    x64.leaRegRegReg r12, r12, rax
    x64.jmp dtorh
  mcont:
    x64.movRegImm32 rax, 0
    x64.cmpRegReg r14, rax
    x64.jcc less, stpk
    x64.jmp stby
  stpk:
    x64.movRegImm32 rcx, 63
    x64.movRegReg rax, r14
    x64.sarRegCl rax, r14
    x64.movRegImm rdx, -1
    x64.movRegReg rsi, rax
    x64.xorRegReg rsi, rax, rdx
    x64.movRegImm32 rdx, 0
    x64.subRegReg rdx, rdx, r14
    x64.movRegImm32 rdi, 3
    x64.movRegReg rcx, rdi
    x64.shlRegCl r14, r14
    x64.andRegReg rdx, rdx, rax
    x64.andRegReg r14, r14, rsi
    x64.orRegReg rdx, rdx, r14
    x64.loadRegSlot rax, slot1
    x64.imulRegReg rax, rax, rdx
    x64.movRegImm32 rsi, 3
    x64.movRegReg rcx, rsi
    x64.movRegReg rsi, rax
    x64.shrRegCl rsi, rax
    x64.movRegImm32 rdi, 7
    x64.andRegReg rax, rax, rdi
    x64.movRegImm32 rdi, 64
    x64.subRegReg rdi, rdi, rdx
    x64.movRegImm r8, -1
    x64.movRegReg rcx, rdi
    x64.shrRegCl r8, r8
    x64.leaRegRegReg rdx, rax, rdx
    x64.movRegImm32 rdi, 7
    x64.leaRegRegReg rdx, rdx, rdi
    x64.movRegImm32 rdi, 3
    x64.movRegReg rcx, rdi
    x64.shrRegCl rdx, rdx
    x64.leaRegRegReg rdx, r13, rsi
    x64.loadRegBaseDisp.byte rsi, [rdx + 0]
    x64.movRegReg rcx, rax
    x64.movRegReg rdi, r8
    x64.shlRegCl rdi, r8
    x64.movRegImm r9, -1
    x64.xorRegReg rdi, rdi, r9
    x64.andRegReg rsi, rsi, rdi
    x64.loadRegSlot rdi, slot0
    x64.andRegReg rdi, rdi, r8
    x64.movRegReg rcx, rax
    x64.shlRegCl rdi, rdi
    x64.orRegReg rsi, rsi, rdi
    x64.storeBaseDispReg.byte [rdx + 0], rsi
    x64.jmp stjoin
  stby:
    x64.loadRegSlot rax, slot1
    x64.imulRegReg rax, rax, r14
    x64.leaRegRegReg rax, r13, rax
    x64.movRegImm32 rdx, 0
    x64.jmp steh
  steh:
    x64.cmpRegReg rdx, r14
    x64.jcc greaterEqual, sted
    x64.jmp steb
  sted:
    x64.jmp stjoin
  stjoin:
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  steb:
    x64.movRegImm32 rcx, 8
    x64.movRegReg rsi, rdx
    x64.imulRegReg rsi, rdx, rcx
    x64.movRegReg rcx, rsi
    x64.loadRegSlot rsi, slot0
    x64.shrRegCl rsi, rsi
    x64.leaRegRegReg rdi, rax, rdx
    x64.storeBaseDispReg.byte [rdi + 0], rsi
    x64.movRegImm32 rsi, 1
    x64.leaRegRegReg rdx, rdx, rsi
    x64.jmp steh
}
