// Test: constant-index-get-has-no-bounds-check
typealias Int = int(i64.min to i64.max)
typealias Vec4 = Vector with 4 Int

function main() returns ExitCode
	var v = Vec4.create()
	try v.set(2, value: 33) otherwise panic("test invariant: set OOB")
	return try v.get(2) otherwise 0
end 'main'
---
ExitCode: 33
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __arr_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 4
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_resize
    x64.movRegImm32 rdx, 2
    x64.movRegImm32 rax, 33
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_set_in_bounds
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegImm32 rdx, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_get_in_bounds
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 r12, 0
    x64.jmp trycont
  tryok:
    x64.movRegReg r12, r8
    x64.jmp trycont
  trycont:
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @__arr_get_in_bounds {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.movRegReg rax, rcx
    x64.loadRegBaseDisp.word64 rsi, [rax + 0]
    x64.loadRegBaseDisp.word64 rdi, [rax + 24]
    x64.movRegImm32 rcx, 63
    x64.movRegReg r8, rdi
    x64.sarRegCl r8, rdi
    x64.movRegImm r9, -1
    x64.movRegReg r10, r8
    x64.xorRegReg r10, r8, r9
    x64.movRegImm32 r9, 0
    x64.subRegReg r9, r9, rdi
    x64.movRegImm32 r11, 3
    x64.movRegReg rcx, r11
    x64.shlRegCl rdi, rdi
    x64.andRegReg r9, r9, r8
    x64.andRegReg rdi, rdi, r10
    x64.orRegReg r9, r9, rdi
    x64.imulRegReg rdx, rdx, r9
    x64.movRegImm32 rdi, 3
    x64.movRegReg rcx, rdi
    x64.movRegReg rdi, rdx
    x64.shrRegCl rdi, rdx
    x64.movRegImm32 r8, 7
    x64.andRegReg rdx, rdx, r8
    x64.movRegImm32 r8, 64
    x64.subRegReg r8, r8, r9
    x64.movRegImm r10, -1
    x64.movRegReg rcx, r8
    x64.shrRegCl r10, r10
    x64.leaRegRegReg r8, rdx, r9
    x64.movRegImm32 r9, 7
    x64.leaRegRegReg r8, r8, r9
    x64.movRegImm32 r9, 3
    x64.movRegReg rcx, r9
    x64.shrRegCl r8, r8
    x64.leaRegRegReg rsi, rsi, rdi
    x64.movRegImm32 rdi, 0
    x64.movRegImm32 r9, 0
    x64.jmp ldeh
  ldeh:
    x64.cmpRegReg rdi, r8
    x64.jcc greaterEqual, ldxtr
    x64.jmp ldeb
  ldxtr:
    x64.movRegReg rcx, rdx
    x64.shrRegCl r9, r9
    x64.movRegReg r8, r9
    x64.andRegReg r8, r9, r10
    x64.jmp gchkdtor
  gchkdtor:
    x64.loadRegBaseDisp.word64 rax, [rax + 40]
    x64.movRegImm32 rcx, 0
    x64.cmpRegReg rax, rcx
    x64.jcc notEqual, gchknull
    x64.jmp gok
  gchknull:
    x64.movRegImm32 rax, 0
    x64.cmpRegReg r8, rax
    x64.jcc equal, gempty
    x64.jmp gok
  gempty:
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 2
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  gok:
    x64.movRegImm32 r10, 0
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ldeb:
    x64.leaRegRegReg rcx, rsi, rdi
    x64.loadRegBaseDisp.byte r11, [rcx + 0]
    x64.movRegImm32 rcx, 8
    x64.movRegReg rbx, rdi
    x64.imulRegReg rbx, rdi, rcx
    x64.movRegReg rcx, rbx
    x64.shlRegCl r11, r11
    x64.orRegReg r9, r9, r11
    x64.movRegImm32 r11, 1
    x64.leaRegRegReg rdi, rdi, r11
    x64.jmp ldeh
}
