// Test: ceil.negative
function main() returns ExitCode
	let neg = -3.9
	let y = trunc(ceil(neg))
	return y + 10
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movsdRegRip xmm0, [rip + __fconst_0]
    x64.movsdRegRip xmm1, [rip + __fconst_1]
    x64.subsdRegReg xmm1, xmm1, xmm0
    x64.roundsdRegReg.towardPositive xmm0, xmm1
    x64.cvttsd2siRegReg rax, xmm0
    x64.leaRegRegImm32 r8, rax, 10
    x64.popReg rbp
    x64.ret
}
