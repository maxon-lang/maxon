    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.storeBaseDispReg.word64 [r12 + 8], rbx
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#1
    x64.jmp matchnext
  matcharm#1:
    x64.movRegImm32 r13, 0
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm#2
    x64.jmp matchdead
  matcharm#2:
    x64.movRegImm32 r13, 1
    x64.jmp matchcont
  matchcont:
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_WordBox
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r13, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r13, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
