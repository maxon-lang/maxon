// Test: error.xs-returned-where-ys-declared
typealias Integer = int(i64.min to i64.max)
typealias Xs = Array with Integer
typealias Ys = Array with Integer

function makeYs() returns Ys
	var xs = Xs.create()
	xs.push(1)
	return xs
end 'makeYs'

function main() returns ExitCode
	let ys = makeYs()
	print("{ys.count()}")
	return 0
end 'main'
---
CompilerError:
error E3005: <fragment>:9:2: Cannot return 'Xs' from function declared to return 'Ys'
