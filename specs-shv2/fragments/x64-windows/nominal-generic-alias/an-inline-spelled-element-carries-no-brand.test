// Test: an-inline-spelled-element-carries-no-brand
typealias Integer = int(i64.min to i64.max)
typealias Xs = Array with Integer
typealias Ys = Array with Integer
typealias Inline = Array with (Array with Integer)

function first(xs Xs) returns Integer
	return try xs.get(0) otherwise 0
end 'first'

function total(ys Ys) returns Integer
	var t = 0
	for y in ys 'each'
		t = t + y
	end 'each'
	return t
end 'total'

function main() returns ExitCode
	var rows = Inline.create()
	rows.push([1, 2])
	rows.push([3])
	var acc = 0
	for row in rows 'each'
		acc = acc + first(row) + total(row)
	end 'each'
	print("{acc}")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @first {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc belowEqual, __im_slow
  __im_load:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.movRegImm32 rsi, 0
    x64.loadRegBaseDisp.word64 rdi, [rcx + 40]
    x64.cmpRegImm32 rdi, 0
    x64.jcc equal, critsplit#8
  __im_empty:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, critsplit#9
  __im_slow:
    x64.callDirect __managed_get
    x64.jmp __im_cont
  critsplit#9:
    x64.movRegReg r8, rax
    x64.movRegReg r10, rsi
    x64.jmp __im_cont
  critsplit#8:
    x64.movRegReg r8, rax
    x64.movRegReg r10, rsi
  __im_cont:
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, trycont
  tryerr:
    x64.movRegImm32 r8, 0
  trycont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __managed_decref]
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 48
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.leaRegRdata rax, [rip + __barr_blob_0]
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.movRegImm32 rax, 2
    x64.storeBaseDispReg.word64 [r8 + 8], rax
    x64.movRegImm rax, 18446744073709551614
    x64.storeBaseDispReg.word64 [r8 + 16], rax
    x64.movRegImm32 rax, 8
    x64.storeBaseDispReg.word64 [r8 + 24], rax
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.movRegImm32 rcx, 48
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.leaRegRdata rax, [rip + __barr_blob_1]
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r8 + 8], rax
    x64.movRegImm rax, 18446744073709551614
    x64.storeBaseDispReg.word64 [r8 + 16], rax
    x64.movRegImm32 rax, 8
    x64.storeBaseDispReg.word64 [r8 + 24], rax
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.movRegImm32 r12, 0
    x64.movRegImm32 r13, 0
  forhdr#1:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegReg r13, rax
    x64.jcc greaterEqual, forexit
  each#2:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseIndexScale.word64 r14, [rax + r13*8 + 0]
  __im_cont#5:
    x64.movRegReg rcx, r14
    x64.callDirect first
    x64.leaRegRegReg rax, r12, r8
  __il_body:
    x64.movRegImm32 rcx, 0
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rsi, [r14 + 8]
    x64.loadRegBaseDisp.word64 rdi, [r14 + 0]
  forhdr#8:
    x64.cmpRegReg rdx, rsi
    x64.jcc greaterEqual, __il_cont
  each#9:
    x64.loadRegBaseIndexScale.word64 r8, [rdi + rdx*8 + 0]
  __im_cont#12:
    x64.leaRegRegReg rcx, rcx, r8
  forstep#10:
    x64.leaRegRegImm32 rdx, rdx, 1
    x64.jmp forhdr#8
  __il_cont:
    x64.leaRegRegReg rax, rax, rcx
  forstep#3:
    x64.leaRegRegImm32 r13, r13, 1
    x64.movRegReg r12, rax
    x64.jmp forhdr#1
  forexit:
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r13
    x64.callDirect __int_to_string
    x64.movRegReg r12, r8
    x64.leaRegRegImm32 rcx, r12, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.leaRegRegImm32 r15, r14, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r13
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r15, r12
    x64.storeBaseDispReg.word64 [r14 + 0], r15
    x64.storeBaseDispReg.word64 [r14 + 8], r12
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [r14 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r14 + 24], rax
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r14
    x64.callDirect print
    x64.movRegReg rcx, r14
    x64.callDirect __str_decref
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
