// Test: struct-reassign
type Point
	var x as int

	static function create(x int) returns Point
		return Self{x: x}
	end 'create'
end 'Point'

function main() returns ExitCode
	var p = Point.create(1)
	p = Point.create(2)
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 16
    x64.movRegImm32 rax, 1
    x64.leaRegSlot rcx, slot0
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 rax, 2
    x64.leaRegSlot rcx, slot1
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 r8, 0
    x64.epilogue 16
    x64.popReg rbp
    x64.ret
}
