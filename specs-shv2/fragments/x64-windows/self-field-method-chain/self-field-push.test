// Test: self-field-push
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

type Container
		export var items as IntArray

		function addItem(value Integer)
				self.items.push(value)
		end 'addItem'

		function getCount() returns Integer
				return self.items.count()
		end 'getCount'

		static function create(items IntArray) returns Self
			return Self{items: items}
		end 'create'
end 'Container'

function main() returns ExitCode
		var c = Container.create(IntArray.create())
		c.addItem(10)
		c.addItem(20)
		return c.getCount()
end 'main'
---
ExitCode: 2
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Container.addItem {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callDirect __managed_push
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @Container.getCount {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.word64 r8, [rax + 8]
    x64.popReg rbp
    x64.ret
}

func @Container.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rcx, r8
    x64.callDirect Container.create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 10
    x64.movRegReg rcx, rbx
    x64.callDirect Container.addItem
    x64.movRegImm32 rdx, 20
    x64.movRegReg rcx, rbx
    x64.callDirect Container.addItem
    x64.movRegReg rcx, rbx
    x64.callDirect Container.getCount
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Container
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
