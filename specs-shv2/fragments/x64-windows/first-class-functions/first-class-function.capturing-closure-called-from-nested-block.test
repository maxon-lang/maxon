// Test: first-class-function.capturing-closure-called-from-nested-block

typealias Integer = int(i64.min to i64.max)

function main() returns ExitCode
	let bump = 5
	let f = function(n Integer) gives n + bump
	var total = 0 as Integer

	total = total + f(1)

	if total > 0 'taken'
		total = total + f(10)
	end 'taken'

	var i = 0 as Integer
	while i < 2 'loop'
		total = total + f(100)
		i = i + 1
	end 'loop'

	return total as ExitCode
end 'main'
---
ExitCode: 231
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rbx, 5
    x64.leaRegFunc r12, [rip + main$closure_0]
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
    x64.movRegImm32 rcx, 1
    x64.movRegReg rdx, r13
    x64.callReg r12
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 rbx, 0
    x64.jcc lessEqual, critsplit
  taken:
    x64.movRegImm32 rcx, 10
    x64.movRegReg rdx, r13
    x64.callReg r12
    x64.leaRegRegReg rax, rbx, r8
    x64.jmp ifcont
  critsplit:
    x64.movRegReg rax, rbx
  ifcont:
    x64.movRegImm32 rbx, 0
    x64.movRegReg r14, rbx
    x64.movRegReg rbx, rax
  whilehdr:
    x64.cmpRegImm32 r14, 2
    x64.jcc greaterEqual, whileexit
  loop:
    x64.movRegImm32 rcx, 100
    x64.movRegReg rdx, r13
    x64.callReg r12
    x64.leaRegRegReg rbx, rbx, r8
    x64.leaRegRegImm32 r14, r14, 1
    x64.jmp whilehdr
  whileexit:
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main$closure_0 {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rdx + 0]
    x64.leaRegRegReg r8, rcx, rax
    x64.popReg rbp
    x64.ret
}
