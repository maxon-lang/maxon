// Test: first-class-function.float-param-called-indirectly

typealias Ratio = float(0.0 to 1000.0)
typealias ScaleFn = function(Ratio) returns Ratio

function scale(x Ratio) returns Ratio
	return x * 2.0
end 'scale'

function apply(f ScaleFn, v Ratio) returns Ratio
	return f(v)
end 'apply'

function main() returns ExitCode
	let fn = scale
	let r = apply(fn, v: 10.5)
	return trunc(r) as ExitCode
end 'main'
---
ExitCode: 21
---
func @scale {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movsdRegRip xmm1, [rip + __fconst_0]
    x64.mulsdRegReg xmm0, xmm0, xmm1
    x64.popReg rbp
    x64.ret
}

func @apply {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg rcx, rdx
    x64.callReg rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegFunc rcx, [rip + __fnref_scale]
    x64.movsdRegRip xmm0, [rip + __fconst_1]
    x64.movRegImm32 rdx, 0
    x64.callDirect apply
    x64.cvttsd2siRegReg r8, xmm0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
