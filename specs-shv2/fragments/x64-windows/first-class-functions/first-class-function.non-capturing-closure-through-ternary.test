// Test: first-class-function.non-capturing-closure-through-ternary

typealias Integer = int(i64.min to i64.max)

function main() returns ExitCode
	let c = 1
	let twice = function(n Integer) gives n * 2
	let thrice = function(n Integer) gives n * 3
	let h = twice if c > 0 else thrice
	return h(21)
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rax, 1
    x64.leaRegFunc rbx, [rip + main$closure_0]
    x64.leaRegFunc r12, [rip + main$closure_1]
    x64.cmpRegImm32 rax, 0
    x64.jcc greater, ternarytrue
    x64.jmp ternaryfalse
  ternarytrue:
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegReg rbx, r12
    x64.jmp matchcont
  matchcont:
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callReg rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main$closure_0 {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.imulRegRegImm32 r8, rcx, 2
    x64.popReg rbp
    x64.ret
}

func @main$closure_1 {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.imulRegRegImm32 r8, rcx, 3
    x64.popReg rbp
    x64.ret
}
