// Test: var-global-key-is-not-linted
typealias StrMap = Map with (String, String)

var key = "a"

function probe(t StrMap) returns ExitCode
	if t.contains(key) 'has'
		print(try t.get(key) otherwise "?")
	end 'has'
	return 0
end 'probe'

function main() returns ExitCode
	let m = StrMap.create()
	return probe(m)
end 'main'
---
ExitCode: 0
---
data {
  __data_key@0 = i64 0
  __slab_cursor@8 = i64 0
  __slab_end@16 = i64 0
  __mm_alloc_count@24 = i64 0
}

func @probe {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.leaRegGlobal rax, __data_key
    x64.loadRegBaseDisp.word64 rdx, [rax + 0]
    x64.leaRegRdata rax, [rip + __witness_String.Hashable]
    x64.leaRegRdata r9, [rip + __witness_String.Equatable]
    x64.movRegReg rcx, rbx
    x64.callDirect __map_contains
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, has
    x64.jmp ifcont
  has:
    x64.leaRegGlobal rax, __data_key
    x64.loadRegBaseDisp.word64 rdx, [rax + 0]
    x64.leaRegRdata rax, [rip + __witness_String.Hashable]
    x64.leaRegRdata r9, [rip + __witness_String.Equatable]
    x64.movRegReg rcx, rbx
    x64.callDirect __map_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_rec_1]
    x64.jmp trycont
  tryok:
    x64.movRegReg rcx, r8
    x64.jmp trycont
  trycont:
    x64.callDirect __print_string
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegFunc rcx, [rip + __str_decref]
    x64.leaRegFunc rdx, [rip + __str_decref]
    x64.callDirect __map_create
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect probe
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __map_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @String.hash {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 8]
    x64.movRegImm32 rdx, 5381
    x64.movRegImm32 rsi, 0
    x64.jmp header
  header:
    x64.cmpRegReg rsi, rcx
    x64.jcc greaterEqual, done
    x64.jmp body
  done:
    x64.movRegImm32 rax, 4294967295
    x64.movRegReg r8, rdx
    x64.andRegReg r8, rdx, rax
    x64.popReg rbp
    x64.ret
  body:
    x64.leaRegRegReg rdi, rax, rsi
    x64.loadRegBaseDisp.byte rdi, [rdi + 0]
    x64.movRegImm32 r8, 33
    x64.imulRegReg rdx, rdx, r8
    x64.leaRegRegReg rdx, rdx, rdi
    x64.movRegImm32 rdi, 1
    x64.leaRegRegReg rsi, rsi, rdi
    x64.jmp header
}

func @String.equals {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.loadRegBaseDisp.word64 rsi, [rdx + 8]
    x64.cmpRegReg rax, rsi
    x64.jcc equal, lenMatch
    x64.jmp notEqual
  lenMatch:
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.loadRegBaseDisp.word64 rdx, [rdx + 0]
    x64.movRegImm32 rsi, 0
    x64.jmp cmphdr
  cmphdr:
    x64.cmpRegReg rsi, rax
    x64.jcc greaterEqual, allMatch
    x64.jmp cmpbody
  allMatch:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  cmpbody:
    x64.leaRegRegReg rdi, rcx, rsi
    x64.loadRegBaseDisp.byte rdi, [rdi + 0]
    x64.leaRegRegReg r8, rdx, rsi
    x64.loadRegBaseDisp.byte r8, [r8 + 0]
    x64.movRegImm32 r9, 1
    x64.leaRegRegReg rsi, rsi, r9
    x64.cmpRegReg rdi, r8
    x64.jcc equal, critsplit
    x64.jmp notEqual
  critsplit:
    x64.jmp cmphdr
  notEqual:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
