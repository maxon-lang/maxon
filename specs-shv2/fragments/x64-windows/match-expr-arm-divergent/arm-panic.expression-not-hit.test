// Test: arm-panic.expression-not-hit
function main() returns ExitCode
	let x = 3
	let result = match x 'eval'
		1 panic("not one")
		2 gives 20
		3 gives 30
		default gives 0
	end 'eval'
	return result
end 'main'
---
ExitCode: 30
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 3
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchnext#5
  matcharm#1:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchnext#5:
    x64.cmpRegImm32 rax, 2
    x64.jcc notEqual, matchnext#6
  matcharm#2:
    x64.movRegImm32 r8, 20
    x64.jmp matchcont
  matchnext#6:
    x64.cmpRegImm32 rax, 3
    x64.jcc notEqual, matchdefault
  matcharm#3:
    x64.movRegImm32 r8, 30
    x64.jmp matchcont
  matchdefault:
    x64.movRegImm32 r8, 0
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
