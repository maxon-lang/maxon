// Test: arm-panic.expression-hit
function main() returns ExitCode
	let x = 1
	let result = match x 'eval'
		1 panic("got the bad one")
		2 gives 20
		3 gives 30
		default gives 0
	end 'eval'
	return result
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  matcharm:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at arm-panic.expression-hit.test:5: got the bad one\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
