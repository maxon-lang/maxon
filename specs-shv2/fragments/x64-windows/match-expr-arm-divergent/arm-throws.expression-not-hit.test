// Test: arm-throws.expression-not-hit
typealias Integer = int(i64.min to i64.max)

enum E
	bad
end 'E'

function pick(x Integer) returns ExitCode throws E
	let result = match x 'eval'
		1 throws E.bad
		2 gives 20
		3 gives 30
		default gives 0
	end 'eval'
	return result
end 'pick'

function main() returns ExitCode
	let r = try pick(2) otherwise 99
	return r
end 'main'
---
ExitCode: 20
---
func @pick {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 1
    x64.jcc equal, matcharm#1
    x64.jmp matchnext#5
  matcharm#1:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 r10, rax, 1
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchnext#5:
    x64.cmpRegImm32 rcx, 2
    x64.jcc equal, matcharm#2
    x64.jmp matchnext#6
  matcharm#2:
    x64.movRegImm32 r8, 20
    x64.jmp matchcont
  matchnext#6:
    x64.cmpRegImm32 rcx, 3
    x64.jcc equal, matcharm#3
    x64.jmp matchdefault
  matcharm#3:
    x64.movRegImm32 r8, 30
    x64.jmp matchcont
  matchdefault:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matchcont:
    x64.movRegImm32 r10, 0
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 2
    x64.callDirect pick
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 r8, 99
    x64.jmp trycont
  tryok:
    x64.jmp trycont
  trycont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
