// Test: interned-blobs-are-located-not-adjacent
function main() returns ExitCode
	let first = "region-one"
	let middle = "MIDDLE-PAYLOAD"
	let last = "region-two"
	return first.byteLength() + middle.byteLength() + last.byteLength()
end 'main'
---
ExitCode: 34
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.leaRegRdata rcx, [rip + __str_rec_3]
    x64.leaRegRdata rbx, [rip + __str_rec_4]
    x64.leaRegRdata r12, [rip + __str_rec_5]
    x64.callDirect String.byteLength
    x64.movRegReg r13, r8
    x64.movRegReg rcx, rbx
    x64.callDirect String.byteLength
    x64.leaRegRegReg rbx, r13, r8
    x64.movRegReg rcx, r12
    x64.callDirect String.byteLength
    x64.leaRegRegReg r8, rbx, r8
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_6]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @String.byteLength {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 r8, [rcx + 8]
    x64.popReg rbp
    x64.ret
}
