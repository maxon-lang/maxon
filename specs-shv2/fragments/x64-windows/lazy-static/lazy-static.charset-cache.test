// Test: lazy-static.charset-cache
type WSCache
	static var ws = CharacterSet.whitespacesAndNewlines()

	export static function isWhitespace(c Character) returns bool
		return WSCache.ws.contains(c)
	end 'isWhitespace'
end 'WSCache'

function main() returns ExitCode
	if WSCache.isWhitespace(' ') 'c1'
		print("space ")
	end 'c1'
	if WSCache.isWhitespace('a') 'c2'
		print("FAIL")
	end 'c2'
	if WSCache.isWhitespace('\t') 'c3'
		print("tab")
	end 'c3'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_WSCache.ws@0 = i64 0
  __data_CharacterSet.cachedWhitespacesAndNewlines@8 = i64 0
  __mm_alloc_count@16 = i64 0
  __slab_arena_list@24 = i64 0
  __slab_arena_map_l1@32 = i64 0
  __slab_state@40 = i64 0
}

func @WSCache.isWhitespace {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.callDirect __lazy_init#__data_WSCache.ws
    x64.leaRegGlobal rax, __data_WSCache.ws
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.movRegReg rdx, rbx
    x64.callDirect CharacterSet.contains
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_12]
    x64.callDirect WSCache.isWhitespace
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#2
  c1:
    x64.leaRegRdata rcx, [rip + __str_rec_13]
    x64.callDirect print
  ifcont#2:
    x64.leaRegRdata rcx, [rip + __str_rec_14]
    x64.callDirect WSCache.isWhitespace
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#4
  c2:
    x64.leaRegRdata rcx, [rip + __str_rec_15]
    x64.callDirect print
  ifcont#4:
    x64.leaRegRdata rcx, [rip + __str_rec_16]
    x64.callDirect WSCache.isWhitespace
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#6
  c3:
    x64.leaRegRdata rcx, [rip + __str_rec_17]
    x64.callDirect print
  ifcont#6:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
