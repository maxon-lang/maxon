// Test: lazy-static.struct-literal-in-two-types
typealias Count = int(0 to u64.max)

type A
	export var n as Count

	static var one = A{n: 1}

	export static function get() returns A
		return A.one
	end 'get'
end 'A'

type B
	export var n as Count

	static var two = B{n: 2}

	export static function get() returns B
		return B.two
	end 'get'
end 'B'

function main() returns ExitCode
	print("{A.get().n} {B.get().n}")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_A.one@0 = i64 0
  __data_B.two@8 = i64 0
  __slab_cursor@16 = i64 0
  __slab_end@24 = i64 0
  __mm_alloc_count@32 = i64 0
}

func @A.get {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __lazy_init#__data_A.one
    x64.leaRegGlobal rax, __data_A.one
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.callDirect __mm_retain
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @B.get {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __lazy_init#__data_B.two
    x64.leaRegGlobal rax, __data_B.two
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.callDirect __mm_retain
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 88
    x64.callDirect A.get
    x64.storeSlotReg slot0, r8
    x64.loadRegBaseDisp.word64 rbx, [r8 + 0]
    x64.movRegImm32 rcx, 20
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeSlotReg slot2, r12
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __uint_to_string
    x64.movRegReg rbx, r8
    x64.leaRegRdata rax, [rip + __str_rec_1]
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.storeSlotReg slot6, rcx
    x64.loadRegBaseDisp.word64 r13, [rax + 8]
    x64.callDirect B.get
    x64.storeSlotReg slot1, r8
    x64.loadRegBaseDisp.word64 r14, [r8 + 0]
    x64.movRegImm32 rcx, 20
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r15, r8
    x64.movRegReg rcx, r14
    x64.movRegReg rdx, r15
    x64.callDirect __uint_to_string
    x64.storeSlotReg slot5, r8
    x64.leaRegRegReg rax, rbx, r13
    x64.leaRegRegReg rax, rax, r8
    x64.storeSlotReg slot3, rax
    x64.leaRegRegImm32 rcx, rax, 49
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot4, r8
    x64.leaRegRegImm32 r14, r8, 48
    x64.movRegReg rcx, r14
    x64.movRegReg rdx, r12
    x64.movRegReg rax, rbx
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, r14, rbx
    x64.movRegReg rcx, rbx
    x64.loadRegSlot rdx, slot6
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, rbx, r13
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r15
    x64.loadRegSlot r12, slot5
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, rbx, r12
    x64.loadRegSlot rbx, slot4
    x64.storeBaseDispReg.word64 [rbx + 0], r14
    x64.loadRegSlot rax, slot3
    x64.storeBaseDispReg.word64 [rbx + 8], rax
    x64.movRegImm rax, -3
    x64.storeBaseDispReg.word64 [rbx + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [rbx + 24], rax
    x64.loadRegSlot rcx, slot2
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r15
    x64.callDirect __mm_decref
    x64.movRegReg rcx, rbx
    x64.callDirect print
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.loadRegSlot rcx, slot1
    x64.callDirect __mm_decref
    x64.loadRegSlot rcx, slot0
    x64.callDirect __mm_decref
    x64.movRegImm32 r8, 0
    x64.epilogue 88
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @print {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __write_stdout
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
