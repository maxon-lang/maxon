    x64.imulRegRegImm32 rdx, rbx, 8
    x64.leaRegRegReg rax, rax, rdx
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.jmp __im_loaded
  __im_stride:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, __im_byte
    x64.jmp __im_slow
  __im_byte:
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.cmpRegImm32 rbx, 0
    x64.setccReg less, rdx
    x64.cmpRegReg rbx, rax
    x64.setccReg greaterEqual, rax
    x64.orRegReg rdx, rdx, rax
    x64.cmpRegImm32 rdx, 0
    x64.jcc notEqual, __im_slow
    x64.jmp __im_load#11
  __im_load#11:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.leaRegRegReg rax, rax, rbx
    x64.loadRegBaseDisp.byte rax, [rax + 0]
    x64.jmp __im_loaded
  __im_loaded:
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rsi, [rcx + 40]
    x64.cmpRegImm32 rsi, 0
    x64.jcc notEqual, __im_empty
    x64.jmp critsplit#13
  __im_empty:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __im_slow
    x64.jmp critsplit#14
  critsplit#14:
    x64.jmp __im_cont
  critsplit#13:
    x64.jmp __im_cont
  __im_slow:
    x64.movRegReg rdx, rbx
    x64.callDirect __managed_get
    x64.movRegReg rax, r8
    x64.movRegReg rdx, r10
    x64.jmp __im_cont
  __im_cont:
    x64.cmpRegImm32 rdx, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm r8, 18446744073709551615
    x64.jmp trycont
  tryok:
    x64.movRegReg r8, rax
    x64.jmp trycont
  trycont:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
