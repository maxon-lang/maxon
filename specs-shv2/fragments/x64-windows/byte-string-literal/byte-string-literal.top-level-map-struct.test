// Test: byte-string-literal.top-level-map-struct
typealias Integer = int(i64.min to i64.max)

type Info
		export var value as Integer

		static function create(value Integer) returns Self
			return Self{value: value}
		end 'create'
end 'Info'

var m = [b"hello": Info.create(10), b"world": Info.create(20)]

function main() returns ExitCode
		let v1 = try m.get(b"hello") otherwise Info.create(0)
		let v2 = try m.get(b"world") otherwise Info.create(0)
		print("{v1.value} {v2.value}")
		return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_m@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @Info.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

