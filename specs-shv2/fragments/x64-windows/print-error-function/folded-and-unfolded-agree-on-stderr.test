// Test: folded-and-unfolded-agree-on-stderr
// --- stdlib-overlay: Builtins.maxon
export typealias WrittenBytes = int(0 to u64.max)

export function errFolded(text String) returns WrittenBytes
	return __Builtins.writeStderr(text.addressableBytes())
end 'errFolded'

export function errThroughABinding(text String) returns WrittenBytes
	let bytes = text.addressableBytes()
	return __Builtins.writeStderr(bytes)
end 'errThroughABinding'
// --- file: main.maxon
function main() returns ExitCode
	let a = errFolded("xy\n")
	let b = errThroughABinding("z\n")
	return (a + b) as ExitCode
end 'main'
---
ExitCode: 5
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.leaRegRdata rcx, [rip + __str_rec_2]
    x64.callDirect errFolded
    x64.movRegReg rbx, r8
    x64.leaRegRdata rcx, [rip + __str_rec_3]
    x64.callDirect errThroughABinding
    x64.leaRegRegReg r8, rbx, r8
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_4]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @errFolded {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __write_stderr
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @errThroughABinding {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect String.addressableBytes
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __write_stderr
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @String.addressableBytes {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __str_bytes_view
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
