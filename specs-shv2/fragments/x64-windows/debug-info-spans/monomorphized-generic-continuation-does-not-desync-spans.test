    x64.jcc less, __rc_panic#8
  __rc_chk#9:
    x64.cmpRegImm32 rbx, 1000
    x64.jcc lessEqual, __rc_ok#7
  __rc_panic#8:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at monomorphized-generic-continuation-does-not-desync-spans.test:21: Range check failed: value outside typealias 'Num'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
