// Test: self-with-params

typealias Integer = int(i64.min to i64.max)

type Accumulator
	var total as Integer

	function add(value Integer)
		self.total = self.total + value
	end 'add'

	function getTotal() returns Integer
		return self.total
	end 'getTotal'

	static function create(total Integer) returns Self
		return Self{total: total}
	end 'create'
end 'Accumulator'

function main() returns ExitCode
	let acc = Accumulator.create(0)
	acc.add(10)
	acc.add(20)
	acc.add(12)
	return acc.getTotal()
end 'main'
---
ExitCode: 42
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Accumulator.add {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.leaRegRegReg rax, rax, rdx
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.popReg rbp
    x64.ret
}

func @Accumulator.getTotal {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 r8, [rcx + 0]
    x64.popReg rbp
    x64.ret
}

func @Accumulator.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 0
    x64.callDirect Accumulator.create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 10
    x64.movRegReg rcx, rbx
    x64.callDirect Accumulator.add
    x64.movRegImm32 rdx, 20
    x64.movRegReg rcx, rbx
    x64.callDirect Accumulator.add
    x64.movRegImm32 rdx, 12
    x64.movRegReg rcx, rbx
    x64.callDirect Accumulator.add
    x64.movRegReg rcx, rbx
    x64.callDirect Accumulator.getTotal
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
