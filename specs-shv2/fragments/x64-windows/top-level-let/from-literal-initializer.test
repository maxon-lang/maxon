// Test: from-literal-initializer
let path = FilePath from "test.txt"

function main() returns ExitCode
	print(path.toString())
	return 0
end 'main'
---
ExitCode: unpinned
---
data {
  __data_path@0 = i64 0
  __data_CharacterSet.cachedWhitespacesAndNewlines@8 = i64 0
  __mm_alloc_count@16 = i64 0
  __slab_arena_list@24 = i64 0
  __slab_arena_map_l1@32 = i64 0
  __slab_state@40 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.leaRegGlobal rax, __data_path
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.callDirect FilePath.toString
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect print
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
