// Test: constant-in-expression
let OFFSET = 10

function main() returns ExitCode
	let x = 5
	return x + OFFSET
end 'main'
---
ExitCode: 15
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 5
    x64.leaRegRegImm32 r8, rax, 10
    x64.popReg rbp
    x64.ret
}
