// Test: multiple-constants
let A = 1
let B = 2
let C = 3

function main() returns ExitCode
	return A + B + C
end 'main'
---
ExitCode: 6
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 1
    x64.leaRegRegImm32 rax, rax, 2
    x64.leaRegRegImm32 r8, rax, 3
    x64.popReg rbp
    x64.ret
}
