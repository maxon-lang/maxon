    x64.jcc less, __il_slow
    x64.jmp __im_buffer#19
  __im_buffer#19:
    x64.loadRegBaseDisp.word64 rax, [r13 + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __il_slow
    x64.jmp __im_viewed#20
  __im_viewed#20:
    x64.leaRegRegImm32 rcx, rax, -24
    x64.loadRegBaseDisp.word64 rcx, [rcx + 16]
    x64.cmpRegImm32 rcx, 0
