// Test: managed-string-literal-deduplication
function main() returns ExitCode
	let a = "hello world"
	let b = "hello world"
	let c = "hello world"
	return a.byteLength() + b.byteLength() + c.byteLength()
end 'main'
---
ExitCode: 33
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.leaRegRdata rcx, [rip + __str_rec_1]  ; "hello world"
    x64.leaRegRdata rbx, [rip + __str_rec_1]  ; "hello world"
    x64.leaRegRdata r12, [rip + __str_rec_1]  ; "hello world"
  __il_body#7:
    x64.loadRegBaseDisp.word64 r13, [rcx + 8]
    x64.cmpRegImm32 r13, 0
    x64.jcc greaterEqual, __il_body#10
  __il_slow#9:
    x64.callDirect String.byteLength
    x64.movRegReg r13, r8
  __il_body#10:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc greaterEqual, __rc_ok#11
  __il_slow#12:
    x64.movRegReg rcx, rbx
    x64.callDirect String.byteLength
    x64.jmp __il_cont#5
  __rc_ok#11:
    x64.movRegReg r8, rax
  __il_cont#5:
    x64.leaRegRegReg rbx, r13, r8
  __il_body#13:
    x64.loadRegBaseDisp.word64 rax, [r12 + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc greaterEqual, __rc_ok#14
  __il_slow#15:
    x64.movRegReg rcx, r12
    x64.callDirect String.byteLength
    x64.jmp __il_cont#4
  __rc_ok#14:
    x64.movRegReg r8, rax
  __il_cont#4:
    x64.leaRegRegReg r8, rbx, r8
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok#1
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at managed-string-literal-deduplication.test:6: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#1:
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
