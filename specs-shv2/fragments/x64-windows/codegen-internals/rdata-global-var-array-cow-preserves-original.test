// Test: rdata-global-var-array-cow-preserves-original
typealias Integer = int(i64.min to i64.max)

var globalArr = [10, 20, 30]

function readFirst() returns Integer
	return try globalArr.get(0) otherwise 0
end 'readFirst'

function main() returns ExitCode
	try globalArr.set(0, value: 99) otherwise panic("test invariant: set OOB")
	return readFirst()
end 'main'
---
ExitCode: 99
---
data {
  __data_globalArr@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @readFirst {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegGlobal rax, __data_globalArr
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rax, [rcx + 24]
    x64.cmpRegImm32 rax, 8
    x64.jcc notEqual, __im_stride
  __im_word:
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc lessEqual, __il_slow
  __im_load#10:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.jmp __im_loaded
  __im_stride:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, __il_slow
  __im_byte:
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc lessEqual, __il_slow
  __im_load#11:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.byte rax, [rax + 0]
  __im_loaded:
    x64.movRegImm32 rsi, 0
    x64.loadRegBaseDisp.word64 rdi, [rcx + 40]
    x64.cmpRegImm32 rdi, 0
    x64.jcc equal, __il_cont
  __im_empty:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, __il_cont
  __il_slow:
    x64.callDirect __managed_get
    x64.movRegReg rax, r8
    x64.movRegReg rsi, r10
  __il_cont:
    x64.cmpRegImm32 rsi, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm32 r8, 0
    x64.jmp trycont
  tryok:
    x64.movRegReg r8, rax
  trycont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegGlobal rax, __data_globalArr
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 rax, 99
    x64.loadRegBaseDisp.word64 rsi, [rcx + 24]
    x64.cmpRegImm32 rsi, 8
    x64.jcc notEqual, __im_stride
  __im_word:
    x64.loadRegBaseDisp.word64 rsi, [rcx + 40]
    x64.cmpRegImm32 rsi, 0
    x64.jcc notEqual, __il_slow
  __im_bounds#11:
    x64.loadRegBaseDisp.word64 rsi, [rcx + 8]
    x64.cmpRegImm32 rsi, 0
    x64.jcc lessEqual, __il_slow
  __im_owned#12:
    x64.loadRegBaseDisp.word64 rsi, [rcx + 16]
    x64.cmpRegImm32 rsi, 0
    x64.jcc less, __il_slow
  __im_buffer#13:
    x64.loadRegBaseDisp.word64 rsi, [rcx + 0]
    x64.cmpRegImm32 rsi, 0
    x64.jcc equal, __il_slow
  __im_viewed#14:
    x64.leaRegRegImm32 rdi, rsi, -24
    x64.loadRegBaseDisp.word64 rdi, [rdi + 16]
    x64.cmpRegImm32 rdi, 0
    x64.jcc notEqual, __il_slow
  __im_store#15:
    x64.storeBaseDispReg.word64 [rsi + 0], rax
    x64.movRegImm32 rax, 0
    x64.jmp __il_cont
  __im_stride:
    x64.cmpRegImm32 rsi, 1
    x64.jcc notEqual, __il_slow
  __im_byte:
    x64.loadRegBaseDisp.word64 rsi, [rcx + 40]
    x64.cmpRegImm32 rsi, 0
    x64.jcc notEqual, __il_slow
  __im_bounds#16:
    x64.loadRegBaseDisp.word64 rsi, [rcx + 8]
    x64.cmpRegImm32 rsi, 0
    x64.jcc lessEqual, __il_slow
  __im_owned#17:
    x64.loadRegBaseDisp.word64 rsi, [rcx + 16]
    x64.cmpRegImm32 rsi, 0
    x64.jcc less, __il_slow
  __im_buffer#18:
    x64.loadRegBaseDisp.word64 rsi, [rcx + 0]
    x64.cmpRegImm32 rsi, 0
    x64.jcc equal, __il_slow
  __im_viewed#19:
    x64.leaRegRegImm32 rdi, rsi, -24
    x64.loadRegBaseDisp.word64 rdi, [rdi + 16]
    x64.cmpRegImm32 rdi, 0
    x64.jcc notEqual, __il_slow
  __im_store#20:
    x64.storeBaseDispReg.byte [rsi + 0], rax
    x64.movRegImm32 rax, 0
    x64.jmp __il_cont
  __il_slow:
    x64.callDirect __managed_set
    x64.movRegReg rax, r10
  __il_cont:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  tryok:
    x64.callDirect readFirst
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
