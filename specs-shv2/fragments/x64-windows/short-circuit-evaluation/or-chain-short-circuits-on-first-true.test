// Test: or-chain-short-circuits-on-first-true
var sideEffectCount = 0

function trackAndReturn(result bool) returns bool
	sideEffectCount = sideEffectCount + 1
	return result
end 'trackAndReturn'

function main() returns ExitCode
	let result = trackAndReturn(false) or trackAndReturn(true) or trackAndReturn(false)
	if not result 'r'
		return 99
	end 'r'
	return sideEffectCount
end 'main'
---
ExitCode: 2
---
data {
  __data_sideEffectCount@0 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 0
    x64.jmp __il_body#11
  __il_body#11:
    x64.leaRegGlobal rcx, __data_sideEffectCount
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.leaRegGlobal rdx, __data_sideEffectCount
    x64.storeBaseDispReg.word64 [rdx + 0], rcx
    x64.jmp __il_cont#10
  __il_cont#10:
    x64.movRegImm32 rcx, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, critsplit#17
    x64.jmp orrhs#1
  critsplit#17:
    x64.jmp scmerge#2
  orrhs#1:
    x64.movRegImm32 rax, 1
    x64.jmp __il_body#13
  __il_body#13:
    x64.leaRegGlobal rcx, __data_sideEffectCount
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.leaRegGlobal rdx, __data_sideEffectCount
    x64.storeBaseDispReg.word64 [rdx + 0], rcx
    x64.jmp __il_cont#12
  __il_cont#12:
    x64.movRegReg rcx, rax
    x64.jmp scmerge#2
  scmerge#2:
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, critsplit#16
    x64.jmp orrhs#3
  critsplit#16:
    x64.jmp scmerge#4
  orrhs#3:
    x64.movRegImm32 rax, 0
    x64.jmp __il_body#15
  __il_body#15:
    x64.leaRegGlobal rcx, __data_sideEffectCount
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.leaRegGlobal rdx, __data_sideEffectCount
    x64.storeBaseDispReg.word64 [rdx + 0], rcx
    x64.jmp __il_cont#14
  __il_cont#14:
    x64.jmp scmerge#4
  scmerge#4:
    x64.xorRegImm32 rax, rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, r
    x64.jmp ifcont
  r:
    x64.movRegImm32 r8, 99
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.leaRegGlobal rax, __data_sideEffectCount
    x64.loadRegBaseDisp.word64 r8, [rax + 0]
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
