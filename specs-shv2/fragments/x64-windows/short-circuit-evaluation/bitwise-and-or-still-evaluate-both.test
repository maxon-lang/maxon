// Test: bitwise-and-or-still-evaluate-both
typealias Integer = int(i64.min to i64.max)

function main() returns ExitCode
	let a = 12 as Integer
	let b = 10 as Integer
	let andResult = a and b
	let orResult = a or b
	return (andResult + orResult) as ExitCode
end 'main'
---
ExitCode: 22
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 12
    x64.movRegReg rcx, rax
    x64.andRegImm32 rcx, rax, 10
    x64.orRegImm32 rax, rax, 10
    x64.leaRegRegReg r8, rcx, rax
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
