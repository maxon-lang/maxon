// Test: return-a-minus-b
function diff(a int, b int) returns int
	return a - b
end 'diff'

function chainDiff(a int, b int, c int) returns int
	return a - b - c
end 'chainDiff'

function main() returns ExitCode
	let r = diff(200, b: 137) * 1000 + chainDiff(90, b: 20, c: 5)
	if r == 63065 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 200
  __il_body#5:
    x64.leaRegRegImm32 rax, rax, -137
  __il_cont#4:
    x64.imulRegRegImm32 rax, rax, 1000
    x64.movRegImm32 rcx, 90
  __il_body#6:
    x64.leaRegRegImm32 rcx, rcx, -20
    x64.leaRegRegImm32 rcx, rcx, -5
  __il_cont#3:
    x64.leaRegRegReg rax, rax, rcx
    x64.cmpRegImm32 rax, 63065
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.popReg rbp
    x64.ret
}
