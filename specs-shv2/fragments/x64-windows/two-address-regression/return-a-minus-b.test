// Test: return-a-minus-b
function diff(a int, b int) returns int
	return a - b
end 'diff'

function chainDiff(a int, b int, c int) returns int
	return a - b - c
end 'chainDiff'

function main() returns ExitCode
	let r = diff(200, b: 137) * 1000 + chainDiff(90, b: 20, c: 5)
	if r == 63065 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @diff {
  entry:
    x64.movRegReg r8, rcx
    x64.subRegReg r8, rcx, rdx
    x64.ret
}

func @chainDiff {
  entry:
    x64.subRegReg rcx, rcx, rdx
    x64.movRegReg r8, rcx
    x64.subRegReg r8, rcx, rax
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbx
    x64.prologue 32
    x64.movRegImm32 rcx, 200
    x64.movRegImm32 rdx, 137
    x64.callDirect diff
    x64.imulRegRegImm32 rbx, r8, 1000
    x64.movRegImm32 rcx, 90
    x64.movRegImm32 rdx, 20
    x64.movRegImm32 rax, 5
    x64.callDirect chainDiff
    x64.leaRegRegReg rax, rbx, r8
    x64.cmpRegImm32 rax, 63065
    x64.jcc equal, ok
    x64.jmp ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbx
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.epilogue 32
    x64.popReg rbx
    x64.ret
}
