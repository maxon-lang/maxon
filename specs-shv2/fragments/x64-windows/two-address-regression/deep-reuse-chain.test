// Test: deep-reuse-chain
function chain(p int) returns int
	let a = p + 100
	let b = p + 1
	let c = p + 2
	let d = p + 3
	let e = p + 4
	let f = p + 5
	let r1 = a - b
	let r2 = a - c
	let r3 = a - d
	let r4 = a - e
	let r5 = a - f
	return r1 + r2 + r3 + r4 + r5 + a
end 'chain'

function main() returns ExitCode
	let s = chain(0)
	if s == 585 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
  __il_body:
    x64.leaRegRegImm32 rcx, rax, 100
    x64.leaRegRegImm32 rdx, rax, 1
    x64.leaRegRegImm32 rsi, rax, 2
    x64.leaRegRegImm32 rdi, rax, 3
    x64.leaRegRegImm32 r8, rax, 4
    x64.leaRegRegImm32 rax, rax, 5
    x64.movRegReg r9, rcx
    x64.subRegReg r9, rcx, rdx
    x64.movRegReg rdx, rcx
    x64.subRegReg rdx, rcx, rsi
    x64.movRegReg rsi, rcx
    x64.subRegReg rsi, rcx, rdi
    x64.movRegReg rdi, rcx
    x64.subRegReg rdi, rcx, r8
    x64.movRegReg r8, rcx
    x64.subRegReg r8, rcx, rax
    x64.leaRegRegReg rax, r9, rdx
    x64.leaRegRegReg rax, rax, rsi
    x64.leaRegRegReg rax, rax, rdi
    x64.leaRegRegReg rax, rax, r8
    x64.leaRegRegReg rax, rax, rcx
  __il_cont:
    x64.cmpRegImm32 rax, 585
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.popReg rbp
    x64.ret
}
