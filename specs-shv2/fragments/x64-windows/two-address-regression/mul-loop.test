// Test: mul-loop
function main() returns ExitCode
	var product = 1
	var i = 5
	while i > 1 'loop'
		product = product * i
		i = i - 1
	end 'loop'
	return product
end 'main'
---
ExitCode: 120
---
func @main {
  entry:
    x64.movRegImm32 rax, 1
    x64.movRegImm32 rcx, 5
    x64.movRegReg r8, rax
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegImm32 rcx, 1
    x64.jcc greater, loop
    x64.jmp whileexit
  loop:
    x64.imulRegReg r8, r8, rcx
    x64.leaRegRegImm32 rcx, rcx, -1
    x64.jmp whilehdr
  whileexit:
    x64.ret
}
