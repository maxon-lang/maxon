// Test: same-value-twice
function sameTwice(p int) returns int
	let x = p + 9
	let y = p + 7
	let sq = x * x
	let df = x - x
	let t = y * y
	return sq * 100 + df * 10 + x + t
end 'sameTwice'

function main() returns ExitCode
	let r = sameTwice(0)
	if r == 8158 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @sameTwice {
  entry:
    x64.leaRegRegImm32 rax, rcx, 9
    x64.leaRegRegImm32 rcx, rcx, 7
    x64.movRegReg rdx, rax
    x64.imulRegReg rdx, rax, rax
    x64.movRegReg rsi, rax
    x64.subRegReg rsi, rax, rax
    x64.imulRegReg rcx, rcx, rcx
    x64.imulRegRegImm32 rdx, rdx, 100
    x64.imulRegRegImm32 rsi, rsi, 10
    x64.leaRegRegReg rdx, rdx, rsi
    x64.leaRegRegReg rax, rdx, rax
    x64.leaRegRegReg r8, rax, rcx
    x64.ret
}

func @main {
  entry:
    x64.prologue 40
    x64.movRegImm32 rcx, 0
    x64.callDirect sameTwice
    x64.cmpRegImm32 r8, 8158
    x64.jcc equal, ok
    x64.jmp ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.epilogue 40
    x64.ret
}
