// Test: same-value-twice
function sameTwice(p int) returns int
	let x = p + 9
	let y = p + 7
	let sq = x * x
	let df = x - x
	let t = y * y
	return sq * 100 + df * 10 + x + t
end 'sameTwice'

function main() returns ExitCode
	let r = sameTwice(0)
	if r == 8158 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
  __il_body:
    x64.leaRegRegImm32 rcx, rax, 9
    x64.leaRegRegImm32 rax, rax, 7
    x64.movRegReg rdx, rcx
    x64.imulRegReg rdx, rcx, rcx
    x64.movRegReg rsi, rcx
    x64.subRegReg rsi, rcx, rcx
    x64.imulRegReg rax, rax, rax
    x64.imulRegRegImm32 rdx, rdx, 100
    x64.imulRegRegImm32 rsi, rsi, 10
    x64.leaRegRegReg rdx, rdx, rsi
    x64.leaRegRegReg rcx, rdx, rcx
    x64.leaRegRegReg rax, rcx, rax
  __il_cont:
    x64.cmpRegImm32 rax, 8158
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.popReg rbp
    x64.ret
}
