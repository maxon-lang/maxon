// Test: range-check-panic.return-through-a-narrower-alias-is-still-guarded
typealias Wide = int(0 to 100)
typealias Narrow = int(0 to 10)

function narrow(x Wide) returns Narrow
  return x
end 'narrow'

function main() returns ExitCode
  return narrow(50)
end 'main'
---
ExitCode: 1
---
func @narrow {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.setccReg less, rax
    x64.jcc less, __rc_panic#2
  __rc_chk#3:
    x64.cmpRegImm32 rcx, 100
    x64.jcc lessEqual, __rc_ok#1
  __rc_panic#2:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#1:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, __rc_panic#5
  __rc_chk#6:
    x64.cmpRegImm32 rcx, 10
    x64.jcc lessEqual, __rc_ok#4
  __rc_panic#5:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#4:
    x64.movRegReg r8, rcx
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 50
  __il_slow:
    x64.callDirect narrow
  __il_cont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
