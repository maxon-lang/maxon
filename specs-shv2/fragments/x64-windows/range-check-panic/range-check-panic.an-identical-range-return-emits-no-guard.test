// Test: range-check-panic.an-identical-range-return-emits-no-guard
function code() returns ExitCode
  return 7
end 'code'

function main() returns ExitCode
  return code()
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 r8, 7
  __il_cont:
    x64.popReg rbp
    x64.ret
}
