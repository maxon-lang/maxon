// Test: range-check-panic.argument-through-a-function-value-is-guarded
typealias Integer = int(i64.min to i64.max)
typealias NonZero = int(1 to i64.max)
typealias DivFn = function(Integer, NonZero) returns Integer

function opaque(n Integer) returns Integer
  return n
end 'opaque'

function divide(a Integer, b NonZero) returns Integer
  return a / b
end 'divide'

function apply(f DivFn, a Integer, b Integer) returns Integer
  return f(a, b)
end 'apply'

function main() returns ExitCode
  let fn = divide
  return apply(fn, a: 10, b: opaque(0)) as ExitCode
end 'main'
---
ExitCode: 1
---
func @divide {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegReg rsi, rdx
    x64.cmpRegImm32 rsi, 1
    x64.jcc greaterEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rax, rcx
    x64.cqo
    x64.idivReg rsi
    x64.movRegReg r8, rax
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @apply {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg rcx, rdx
    x64.movRegReg rdx, rax
    x64.movRegReg rax, r9
    x64.callReg rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegFunc rcx, [rip + __fnref_divide]
    x64.movRegImm32 rdx, 10
    x64.movRegImm32 rax, 0
  __il_cont:
    x64.movRegImm32 r9, 0
    x64.callDirect apply
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
