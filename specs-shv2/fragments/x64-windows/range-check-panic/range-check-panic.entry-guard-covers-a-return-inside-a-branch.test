// Test: range-check-panic.entry-guard-covers-a-return-inside-a-branch
typealias Integer = int(i64.min to i64.max)
typealias SmallInt = int(0 to 10)

function opaque(n Integer) returns Integer
  return n
end 'opaque'

function pick(x SmallInt, flag Integer) returns SmallInt
  if flag > 0 'yes'
    return x
  end 'yes'
  return 3
end 'pick'

function main() returns ExitCode
  return pick(opaque(99), flag: 1)
end 'main'
---
ExitCode: 1
---
func @pick {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rcx, 10
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.cmpRegImm32 rdx, 0
    x64.jcc lessEqual, ifcont
  yes:
    x64.movRegReg r8, rcx
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 3
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 99
  __il_cont#2:
    x64.movRegImm32 rdx, 1
  __il_body:
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __il_slow
  __rc_chk:
    x64.cmpRegImm32 rcx, 10
    x64.jcc lessEqual, __rc_ok
  __il_slow:
    x64.callDirect pick
    x64.jmp __il_cont#1
  __rc_ok:
    x64.cmpRegImm32 rdx, 0
    x64.jcc lessEqual, ifcont
  yes:
    x64.movRegReg r8, rcx
    x64.jmp __il_cont#1
  ifcont:
    x64.movRegImm32 r8, 3
  __il_cont#1:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
