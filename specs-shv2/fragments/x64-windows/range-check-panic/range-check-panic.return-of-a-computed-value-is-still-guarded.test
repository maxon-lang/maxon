// Test: range-check-panic.return-of-a-computed-value-is-still-guarded
typealias SmallInt = int(0 to 10)

function grow(x SmallInt) returns SmallInt
  return x * 3
end 'grow'

function main() returns ExitCode
  return grow(5)
end 'main'
---
ExitCode: 1
---
func @grow {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic#2
  __rc_chk#3:
    x64.cmpRegImm32 rcx, 10
    x64.jcc lessEqual, __rc_ok#1
  __rc_panic#2:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#1:
    x64.imulRegRegImm32 r8, rcx, 3
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#5
  __rc_chk#6:
    x64.cmpRegImm32 r8, 10
    x64.jcc lessEqual, __rc_ok#4
  __rc_panic#5:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#4:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 5
  __il_body:
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __il_slow
  __rc_chk#4:
    x64.cmpRegImm32 rcx, 10
    x64.jcc greater, __il_slow
  __rc_ok:
    x64.imulRegRegImm32 r8, rcx, 3
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __il_slow
  __rc_chk#6:
    x64.cmpRegImm32 r8, 10
    x64.jcc lessEqual, __il_cont
  __il_slow:
    x64.callDirect grow
  __il_cont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
