// Test: range-check-panic.an-uncontained-element-store-is-still-guarded
typealias Integer = int(i64.min to i64.max)
typealias Loose = int(0 to 2000)
typealias Wide = int(0 to 1000)
typealias Wides = Array with Wide

function opaque(n Integer) returns Integer
  return n
end 'opaque'

function loose() returns Loose
  return opaque(1001)
end 'loose'

function main() returns ExitCode
  var a = Wides.create()
  a.push(loose())
  let v = try a.get(0) otherwise panic("no slot")
  print("v={v}\n")
  return 0
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @opaque {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegReg r8, rcx
    x64.popReg rbp
    x64.ret
}

func @loose {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 1001
    x64.callDirect opaque
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 2000
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_5]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

