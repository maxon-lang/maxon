// Test: duplicate-block-identifiers.nested-same-id
function main() returns ExitCode
	var x = 0
	if true 'check'
		x = 1
		if true 'check'
			x = 2
		end 'check'
	end 'check'
	return x
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 0
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, check
    x64.jmp critsplit
  check:
    x64.movRegImm32 rax, 1
    x64.movRegImm32 rcx, 1
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, check
    x64.jmp critsplit
  check:
    x64.movRegImm32 rax, 2
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movRegReg r8, rax
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.popReg rbp
    x64.ret
}
