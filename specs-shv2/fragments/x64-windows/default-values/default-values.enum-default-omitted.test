// Test: default-values.enum-default-omitted
enum Color
	red
	green
	blue
end 'Color'

function paint(color Color = Color.blue) returns ExitCode
	return color.rawValue
end 'paint'

function main() returns ExitCode
	return paint()
end 'main'
---
ExitCode: 2
---
func @paint {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rcx, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rcx
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.jmp __il_body#3
  __il_body#3:
    x64.movRegImm32 rcx, 2
    x64.jmp __il_cont#2
  __il_cont#2:
    x64.jmp __il_body#4
  __il_body#4:
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __il_slow
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rcx, rax
    x64.jcc greater, __il_slow
    x64.jmp __rc_ok
  __il_slow:
    x64.callDirect paint
    x64.jmp __il_cont#1
  __rc_ok:
    x64.movRegReg r8, rcx
    x64.jmp __il_cont#1
  __il_cont#1:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
