  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.word64 rdx, [rcx + 8]
    x64.loadRegBaseDisp.word64 rcx, [rax + 24]
    x64.cmpRegImm32 rcx, 8
    x64.jcc equal, __im_word
    x64.jmp __im_stride
  __im_word:
