func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 0
    x64.callDirect increment
    x64.movRegImm32 rcx, 0
    x64.callDirect increment
