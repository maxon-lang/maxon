// Test: module-union-in-monomorphized-method
typealias Small = int(0 to 100)

union Hold
	unowned
	owned(v Small)
end 'Hold'

var hold = Hold.unowned

type Cell uses T
	export var item as T

	export static function create(item T) returns Self
		return Self{item: item}
	end 'create'

	export function stash(v Small)
		hold = Hold.owned(v)
	end 'stash'

	export function readBack() returns Small
		return match hold 'r'
			unowned gives 0
			owned(v) gives v
		end 'r'
	end 'readBack'
end 'Cell'

typealias SmallCell = Cell with Small

function main() returns ExitCode
	let c = SmallCell.create(1)
	c.stash(5)
	return c.readBack()
end 'main'
---
ExitCode: 5
---
data {
  __data_hold@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @Cell.stash {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rdx
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 100
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at module-union-in-monomorphized-method.test:18: Range check failed: value outside typealias 'Small'\x0a"
    x64.callDirect mrt_panic
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.storeBaseDispReg.word64 [r12 + 8], rbx
    x64.leaRegGlobal rax, __data_hold
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.callDirect __mm_decref
    x64.leaRegGlobal rax, __data_hold
    x64.storeBaseDispReg.word64 [rax + 0], r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Cell.readBack {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegGlobal rax, __data_hold
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, matchnext
  matcharm#1:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rcx, 1
    x64.jcc notEqual, matchdead
  matcharm#2:
    x64.loadRegBaseDisp.word64 r8, [rax + 8]
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 100
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at module-union-in-monomorphized-method.test:23: Range check failed: value outside typealias 'Small'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rax, 1
    x64.leaRegSlot rbx, slot0
    x64.storeBaseDispReg.word64 [rbx + 0], rax
    x64.movRegImm32 rdx, 5
    x64.movRegReg rcx, rbx
    x64.callDirect Cell.stash
  __il_body:
    x64.leaRegGlobal rax, __data_hold
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, matchnext
  matcharm#3:
    x64.movRegImm32 rax, 0
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rcx, 1
    x64.jcc notEqual, matchdead
  matcharm#4:
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
  matchcont:
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __il_slow
  __rc_chk:
    x64.cmpRegImm32 rax, 100
    x64.jcc lessEqual, __rc_ok
  __il_slow:
    x64.movRegReg rcx, rbx
    x64.callDirect Cell.readBack
    x64.jmp __il_cont
  __rc_ok:
    x64.movRegReg r8, rax
  __il_cont:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
}
