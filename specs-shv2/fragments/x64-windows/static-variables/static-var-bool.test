// Test: static-var-bool
var initialized = false

function init()
	initialized = true
end 'init'

function main() returns ExitCode
	if initialized 'check1'
		return 1
	end 'check1'
	init()
	if initialized 'check2'
		return 42
	end 'check2'
	return 0
end 'main'
---
ExitCode: 42
---
data {
  __data_initialized@0 = i1 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegGlobal rax, __data_initialized
    x64.loadRegBaseDisp.byte rax, [rax + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, check1
    x64.jmp ifcont#2
  check1:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.jmp __il_body
  __il_body:
    x64.movRegImm32 rax, 1
    x64.leaRegGlobal rcx, __data_initialized
    x64.storeBaseDispReg.byte [rcx + 0], rax
    x64.jmp __il_cont
  __il_cont:
    x64.leaRegGlobal rax, __data_initialized
    x64.loadRegBaseDisp.byte rax, [rax + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, check2
    x64.jmp ifcont#4
  check2:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
