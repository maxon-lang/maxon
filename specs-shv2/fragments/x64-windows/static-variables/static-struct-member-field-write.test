// Test: static-struct-member-field-write
typealias Integer = int(i64.min to i64.max)

type Row
	export var n as Integer

	export static function create(n Integer) returns Self
		return Self{n: n}
	end 'create'
end 'Row'

type Cache
	static var head = Row.create(1)
end 'Cache'

function main() returns ExitCode
	Cache.head.n = 42
	return Cache.head.n as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __data_Cache.head@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegGlobal rax, __data_Cache.head
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.movRegImm32 rcx, 42
    x64.storeBaseDispReg.word64 [rax + 0], rcx
    x64.leaRegGlobal rax, __data_Cache.head
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.loadRegBaseDisp.word64 r8, [rax + 0]
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at static-struct-member-field-write.test:18: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
