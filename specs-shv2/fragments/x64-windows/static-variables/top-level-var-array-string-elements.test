// Test: top-level-var-array-string-elements
var names = ["ab", "cde"]

function main() returns ExitCode
	let a = try names.get(0) otherwise ""
	let b = try names.get(1) otherwise ""
	print("{a}{b}")
	return 0
end 'main'
