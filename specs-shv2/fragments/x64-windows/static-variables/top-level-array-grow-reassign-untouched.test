// Test: top-level-array-grow-reassign-untouched

var grow = [1]
var untouched = [7, 7, 7]
let fixed = [4, 5, 6]

function main() returns ExitCode
	var i = 0
	while i < 200 'fill'
		grow.push(i)
		i = i + 1
	end 'fill'
	grow = [3, 4]
	let a = try grow.get(0) otherwise 0
	let b = try grow.get(1) otherwise 0
	let c = try fixed.get(2) otherwise 0
	return a + b + c + grow.count()
end 'main'
---
ExitCode: 15
---
data {
  __data_grow@0 = i64 0
  __data_fixed@8 = i64 0
  __slab_cursor@16 = i64 0
  __slab_end@24 = i64 0
  __mm_alloc_count@32 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rbx, 0
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegImm32 rbx, 200
    x64.jcc less, fill
    x64.jmp whileexit
  fill:
    x64.leaRegGlobal rax, __data_grow
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.movRegReg rdx, rbx
    x64.callDirect __managed_push
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp whilehdr
  whileexit:
    x64.movRegImm32 rcx, 48
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg rbx, r8
    x64.leaRegRdata rax, [rip + __barr_blob_0]
    x64.storeBaseDispReg.word64 [rbx + 0], rax
    x64.movRegImm32 rax, 2
    x64.storeBaseDispReg.word64 [rbx + 8], rax
    x64.movRegImm rax, 18446744073709551614
    x64.storeBaseDispReg.word64 [rbx + 16], rax
    x64.movRegImm32 rax, 8
    x64.storeBaseDispReg.word64 [rbx + 24], rax
    x64.leaRegGlobal rax, __data_grow
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.callDirect __managed_decref
    x64.leaRegGlobal rax, __data_grow
    x64.storeBaseDispReg.word64 [rax + 0], rbx
    x64.leaRegGlobal rax, __data_grow
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#5
    x64.jmp tryok#4
  tryerr#5:
    x64.movRegImm32 rbx, 0
    x64.jmp trycont#6
  tryok#4:
    x64.movRegReg rbx, r8
    x64.jmp trycont#6
  trycont#6:
    x64.leaRegGlobal rax, __data_grow
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.movRegImm32 rdx, 1
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#8
    x64.jmp tryok#7
  tryerr#8:
    x64.movRegImm32 r12, 0
    x64.jmp trycont#9
  tryok#7:
    x64.movRegReg r12, r8
    x64.jmp trycont#9
  trycont#9:
    x64.leaRegGlobal rax, __data_fixed
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.movRegImm32 rdx, 2
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#11
    x64.jmp tryok#10
  tryerr#11:
    x64.movRegImm32 rax, 0
    x64.jmp trycont#12
  tryok#10:
    x64.movRegReg rax, r8
    x64.jmp trycont#12
  trycont#12:
    x64.leaRegRegReg rcx, rbx, r12
    x64.leaRegRegReg rbx, rcx, rax
    x64.leaRegGlobal rax, __data_grow
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.callDirect __managed_count
    x64.leaRegRegReg r8, rbx, r8
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_3]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
