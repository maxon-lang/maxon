// Test: bool-type-arg-admitted
type Sizer uses T
	export var v as T
	export static function create(x T) returns Self
		return Self{v: x}
	end 'create'
	export function get() returns T
		return self.v
	end 'get'
end 'Sizer'
typealias BoolSizer = Sizer with bool
typealias BoolArray = Array with bool
function main() returns ExitCode
	let s = BoolSizer.create(true)
	var a = BoolArray.create()
	a.push(s.get())
	return a.count() - 1
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Sizer.get {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.movRegReg rcx, rdx
    x64.movRegReg rdx, rax
    x64.callDirect __retain_type_param
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 48
    x64.movRegImm32 rax, 1
    x64.leaRegSlot rbx, slot0
    x64.storeBaseDispReg.word64 [rbx + 0], rax
    x64.movRegImm rcx, 18446744073709551615
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.leaRegRdata rdx, [rip + __layout_Sizer_bool]
    x64.movRegReg rcx, rbx
    x64.callDirect Sizer.get
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.movRegReg rcx, r12
    x64.callDirect __managed_count
    x64.leaRegRegImm32 rbx, r8, -1
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 48
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
