// Test: return-type
enum Result
	success
	failure
end 'Result'

function getResult(succeed bool) returns Result
	if succeed 'check'
		return Result.success
	end 'check'
	return Result.failure
end 'getResult'

function main() returns ExitCode
	let r = getResult(true)
	if r == Result.success 'test'
		return 1
	end 'test'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 1
    x64.jmp __il_body
  __il_body:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, check
    x64.jmp ifcont#6
  check:
    x64.movRegImm32 rax, 0
    x64.jmp __il_cont
  ifcont#6:
    x64.movRegImm32 rax, 1
    x64.jmp __il_cont
  __il_cont:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, test
    x64.jmp ifcont#2
  test:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
