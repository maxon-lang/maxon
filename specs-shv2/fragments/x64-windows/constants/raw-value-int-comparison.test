// Test: raw-value-int-comparison
enum Priority
	low = 1
	medium = 5
	high = 10
end 'Priority'

function main() returns ExitCode
	let p = Priority.high
	if p.rawValue > 5 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 10
    x64.cmpRegImm32 rax, 5
    x64.jcc greater, check
    x64.jmp ifcont
  check:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
