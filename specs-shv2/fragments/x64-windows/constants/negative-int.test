// Test: negative-int
enum Temperature
	freezing = 0
	cold = -10
	warm = 25
end 'Temperature'

function main() returns ExitCode
	let result = match Temperature.warm 'check'
		freezing gives 0
		cold gives -10
		warm gives 25
	end 'check'
	return result
end 'main'
---
ExitCode: 25
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 25
    x64.cmpRegImm32 rax, -10
    x64.jcc notEqual, matchnext#5
  matcharm#2:
    x64.movRegImm r8, 18446744073709551606
    x64.jmp matchcont
  matchnext#5:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext#6
  matcharm#1:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matchnext#6:
    x64.cmpRegImm32 rax, 25
    x64.jcc notEqual, matchdead
  matcharm#3:
    x64.movRegImm32 r8, 25
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
}
