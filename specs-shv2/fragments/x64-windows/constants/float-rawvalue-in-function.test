// Test: float-rawvalue-in-function

typealias Float = float(f64.min to f64.max)

enum Weights
	light = 1.5
	medium = 2.5
end 'Weights'

function getRaw(w Weights) returns Float
	return w.rawValue
end 'getRaw'

function main() returns ExitCode
	let w = Weights.medium
	let raw = getRaw(w)
	if raw > 2.0 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm rax, 4612811918334230528
  __il_body:
    x64.movqXmmGpr xmm0, rax
  __il_cont:
    x64.movsdRegRip xmm1, [rip + __fconst_2]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc belowEqual, ifcont
  check:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
