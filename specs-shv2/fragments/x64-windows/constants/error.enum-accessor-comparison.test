// Test: error.enum-accessor-comparison
enum Color
	red
	green
	blue
end 'Color'

function main() returns ExitCode
	let c = Color.green
	if c.ordinal == 1 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
CompilerError:
error E3097: <fragment>:10:15: cannot compare an enum's '.ordinal' with '==' — compare the value directly (e.g. `value == Type.case`), or use `match` for a union variant
