// Test: export
// --- file: defs.maxon
export enum Permission
	none = 0
	read = 1
	write = 2
end 'Permission'

// --- file: main.maxon
function main() returns ExitCode
	let p = Permission.read
	if p == Permission.read 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  check:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}
