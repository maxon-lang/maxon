// Test: string-interpolation
enum HttpStatus
	ok = 200
	notFound = 404
end 'HttpStatus'

function main() returns ExitCode
	let s = HttpStatus.notFound
	let msg = "status: {s}"
	if msg == "status: 404" 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
