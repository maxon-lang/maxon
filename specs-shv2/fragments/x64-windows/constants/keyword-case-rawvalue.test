// Test: keyword-case-rawvalue
enum TokenType
	function
	return
	end
	if
end 'TokenType'

function main() returns ExitCode
	let t = TokenType.end
	return t.rawValue
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 2
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
