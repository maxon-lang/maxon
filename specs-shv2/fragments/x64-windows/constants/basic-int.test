// Test: basic-int
enum Color
	red
	green
	blue
end 'Color'

function main() returns ExitCode
	let c = Color.green
	if c == Color.green 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, ifcont
  check:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
