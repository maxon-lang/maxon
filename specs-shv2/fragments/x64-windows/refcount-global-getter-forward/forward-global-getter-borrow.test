  __data_cachedBase@0 = i64 0
  __data_cachedMerged@8 = i64 0
  __mm_alloc_count@16 = i64 0
  __slab_arena_list@24 = i64 0
  __slab_arena_map_l1@32 = i64 0
  __slab_state@40 = i64 0
  __data_baseLoaded@48 = i1 0
  __data_mergedDone@49 = i1 0
}

