// Test: var-redeclare-after-scope
function main() returns ExitCode
	if true 'check'
		let x = 10
	end 'check'
	let x = 42
	return x
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, check
    x64.jmp ifcont
  check:
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 r8, 42
    x64.ret
}
