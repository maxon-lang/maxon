// Test: a-truncation-of-a-constant-folds-inside-the-i64-range
typealias Real = float(f64.min to f64.max)
typealias Word = int(i64.min to i64.max)

function truncF(a Real) returns Word
	return trunc(a)
end 'truncF'

function main() returns ExitCode
	if truncF(3.99) != 3 'towardZeroFromAbove'
		return 1
	end 'towardZeroFromAbove'
	if truncF(-3.99) != -3 'towardZeroFromBelow'
		return 2
	end 'towardZeroFromBelow'
	if truncF(-0.5) != 0 'andTheFractionBelowZero'
		return 3
	end 'andTheFractionBelowZero'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body#8:
    x64.movRegImm32 rax, 3
  __il_cont#7:
    x64.cmpRegImm32 rax, 3
    x64.jcc equal, __il_body#10
  towardZeroFromAbove:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  __il_body#10:
    x64.movRegImm rax, 18446744073709551613
  __il_cont#9:
    x64.cmpRegImm32 rax, -3
    x64.jcc equal, __il_body#12
  towardZeroFromBelow:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  __il_body#12:
    x64.movRegImm32 rax, 0
  __il_cont#11:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont
  andTheFractionBelowZero:
    x64.movRegImm32 r8, 3
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
