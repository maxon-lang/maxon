// Test: match-escape-character
function main() returns ExitCode
	let c = '\n'
	match c 'check'
		'\n' then return 0
		default then return 1
	end 'check'
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_1]
    x64.leaRegRdata rdx, [rip + __str_rec_1]
    x64.callDirect __str_eq
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, matchnext
  matcharm:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchnext:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
