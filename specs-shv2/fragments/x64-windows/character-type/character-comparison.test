// Test: character-comparison
function main() returns ExitCode
	let a = 'A'
	let b = 'B'
	if a < b 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.movRegImm32 rax, 65
    x64.cmpRegImm32 rax, 66
    x64.jcc less, check
    x64.jmp ifcont
  check:
    x64.movRegImm32 r8, 1
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.ret
}
