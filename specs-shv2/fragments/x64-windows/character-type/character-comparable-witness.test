// Test: character-comparable-witness
type Pair uses T where T is Comparable
	export var a as T
	export var b as T
	export static function create(a T, b T) returns Self
		return Self{ a: a, b: b }
	end 'create'
	export function lt() returns bool
		return self.a < self.b
	end 'lt'
end 'Pair'

typealias CharPair = Pair with Character

function main() returns ExitCode
	let p = CharPair.create('é', b: 'ü')
	if p.lt() 'ordered'
		print("lt\n")
	end 'ordered'
	let q = CharPair.create('ü', b: 'é')
	if q.lt() 'reversed'
		print("REVERSED\n")
	end 'reversed'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Pair.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.storeBaseDispReg.word64 [r8 + 8], r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Pair.lt {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rdx
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.word64 rdx, [rcx + 8]
    x64.movRegReg rcx, rax
    x64.callMem [rbx + 24]
    x64.cmpRegImm32 r8, 0
    x64.setccReg equal, r8
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.leaRegRdata rax, [rip + __str_rec_1]
    x64.leaRegRdata rbx, [rip + __str_rec_3]
    x64.loadRegBaseDisp.word64 r12, [rax + 0]
    x64.loadRegBaseDisp.word64 r13, [rax + 8]
    x64.leaRegRegImm32 rcx, r13, 49
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.leaRegRegImm32 r15, r14, 48
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r12
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r15, r13
    x64.storeBaseDispReg.word64 [r14 + 0], r15
    x64.storeBaseDispReg.word64 [r14 + 8], r13
    x64.movRegImm rax, -3
    x64.storeBaseDispReg.word64 [r14 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r14 + 24], rax
    x64.loadRegBaseDisp.word64 r12, [rbx + 0]
    x64.loadRegBaseDisp.word64 rbx, [rbx + 8]
    x64.leaRegRegImm32 rcx, rbx, 49
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.leaRegRegImm32 r15, r13, 48
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r12
    x64.movRegReg rax, rbx
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r15, rbx
    x64.storeBaseDispReg.word64 [r13 + 0], r15
    x64.storeBaseDispReg.word64 [r13 + 8], rbx
    x64.movRegImm rax, -3
    x64.storeBaseDispReg.word64 [r13 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r13 + 24], rax
    x64.movRegReg rcx, r14
    x64.movRegReg rdx, r13
    x64.callDirect Pair.create
    x64.storeSlotReg slot0, r8
    x64.leaRegRdata rdx, [rip + __witness_Character.Comparable]
    x64.movRegReg rcx, r8
    x64.callDirect Pair.lt
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, ordered
    x64.jmp ifcont
  ordered:
    x64.leaRegRdata rcx, [rip + __str_rec_5]
    x64.callDirect __print_string
    x64.jmp ifcont
  ifcont:
    x64.leaRegRdata rax, [rip + __str_rec_3]
    x64.leaRegRdata rbx, [rip + __str_rec_1]
    x64.loadRegBaseDisp.word64 r12, [rax + 0]
    x64.loadRegBaseDisp.word64 r13, [rax + 8]
    x64.leaRegRegImm32 rcx, r13, 49
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.leaRegRegImm32 r15, r14, 48
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r12
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r15, r13
    x64.storeBaseDispReg.word64 [r14 + 0], r15
    x64.storeBaseDispReg.word64 [r14 + 8], r13
    x64.movRegImm rax, -3
    x64.storeBaseDispReg.word64 [r14 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r14 + 24], rax
    x64.loadRegBaseDisp.word64 r12, [rbx + 0]
    x64.loadRegBaseDisp.word64 rbx, [rbx + 8]
    x64.leaRegRegImm32 rcx, rbx, 49
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.leaRegRegImm32 r15, r13, 48
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r12
    x64.movRegReg rax, rbx
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r15, rbx
    x64.storeBaseDispReg.word64 [r13 + 0], r15
    x64.storeBaseDispReg.word64 [r13 + 8], rbx
    x64.movRegImm rax, -3
    x64.storeBaseDispReg.word64 [r13 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r13 + 24], rax
    x64.movRegReg rcx, r14
    x64.movRegReg rdx, r13
    x64.callDirect Pair.create
    x64.movRegReg rbx, r8
    x64.leaRegRdata rdx, [rip + __witness_Character.Comparable]
    x64.movRegReg rcx, rbx
    x64.callDirect Pair.lt
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, reversed
    x64.jmp ifcont
  reversed:
    x64.leaRegRdata rcx, [rip + __str_rec_7]
    x64.callDirect __print_string
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Pair_Character
    x64.loadRegSlot rcx, slot0
    x64.callDirect __destruct_Pair_Character
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Character.compare {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.loadRegBaseDisp.word64 rsi, [rdx + 8]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.loadRegBaseDisp.word64 rdx, [rdx + 0]
    x64.cmpRegReg rax, rsi
    x64.jcc less, selfShorter
    x64.jmp otherShorter
  selfShorter:
    x64.movRegImm32 rdi, 0
    x64.movRegReg r8, rax
    x64.jmp header
  otherShorter:
    x64.movRegImm32 rdi, 0
    x64.movRegReg r8, rsi
    x64.jmp header
  header:
    x64.cmpRegReg rdi, r8
    x64.jcc greaterEqual, lengthTie
    x64.jmp body
  lengthTie:
    x64.cmpRegReg rax, rsi
    x64.jcc less, less
    x64.jmp lenNotLess
  lenNotLess:
    x64.cmpRegReg rax, rsi
    x64.jcc greater, greater
    x64.jmp equal
  equal:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  body:
    x64.leaRegRegReg r9, rcx, rdi
    x64.loadRegBaseDisp.byte r9, [r9 + 0]
    x64.leaRegRegReg r10, rdx, rdi
    x64.loadRegBaseDisp.byte r10, [r10 + 0]
    x64.cmpRegReg r9, r10
    x64.jcc less, less
    x64.jmp byteNotLess
  less:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  byteNotLess:
    x64.cmpRegReg r9, r10
    x64.jcc greater, greater
    x64.jmp nextByte
  greater:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  nextByte:
    x64.movRegImm32 r9, 1
    x64.leaRegRegReg rdi, rdi, r9
    x64.jmp header
}
