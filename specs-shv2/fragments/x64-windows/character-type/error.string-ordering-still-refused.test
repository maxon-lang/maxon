// Test: error.string-ordering-still-refused
function main() returns ExitCode
	let a = "apple"
	let b = "banana"
	if a < b 'lt'
		return 1
	end 'lt'
	return 0
end 'main'
---
CompilerError:
error E3005: <fragment>:5:7: cannot order String values using '<': a String is a byte record with no ordering, so its only comparisons are '==' and '!='
