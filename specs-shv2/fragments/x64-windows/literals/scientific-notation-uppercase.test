// Test: scientific-notation-uppercase
function main() returns ExitCode
	let x = 1.0E3
	return trunc(x) - 990
end 'main'
---
ExitCode: 10
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movsdRegRip xmm0, [rip + __fconst_0]
    x64.cvttsd2siRegReg rax, xmm0
    x64.leaRegRegImm32 r8, rax, -990
    x64.popReg rbp
    x64.ret
}
