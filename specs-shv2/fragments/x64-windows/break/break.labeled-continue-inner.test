// Test: break.labeled-continue-inner
function main() returns ExitCode
	var sum = 0
	var x = 0
	while x < 3 'outer'
		x = x + 1
		var y = 0
		while y < 5 'inner'
			y = y + 1
			if y == 3 'check'
				continue
			end 'check'
			sum = sum + 1
		end 'inner'
	end 'outer'
	return sum
end 'main'
---
ExitCode: 12
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 r8, 0
    x64.movRegImm32 rax, 0
  whilehdr#1:
    x64.cmpRegImm32 rax, 3
    x64.jcc greaterEqual, whileexit
  outer:
    x64.leaRegRegImm32 rax, rax, 1
    x64.movRegImm32 rcx, 0
  whilehdr#4:
    x64.cmpRegImm32 rcx, 5
    x64.jcc greaterEqual, whilehdr#1
  inner:
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.cmpRegImm32 rcx, 3
    x64.jcc equal, whilehdr#4
  ifcont:
    x64.leaRegRegImm32 r8, r8, 1
    x64.jmp whilehdr#4
  whileexit:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at break.labeled-continue-inner.test:16: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
