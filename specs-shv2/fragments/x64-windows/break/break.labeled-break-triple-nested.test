// Test: break.labeled-break-triple-nested
function main() returns ExitCode
	var result = 0
	while true 'outer'
		while true 'middle'
			while true 'inner'
				result = result + 1
				if result == 5 'check'
					break 'outer'
				end 'check'
			end 'inner'
		end 'middle'
	end 'outer'
	return result
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 0
    x64.jmp whilehdr#1
  whilehdr#1:
    x64.movRegImm32 rcx, 1
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, outer
    x64.jmp critsplit
  outer:
    x64.jmp whilehdr#4
  whilehdr#4:
    x64.movRegImm32 rcx, 1
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, middle
    x64.jmp whileexit#6
  middle:
    x64.jmp whilehdr#7
  whilehdr#7:
    x64.movRegImm32 rcx, 1
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, inner
    x64.jmp whileexit#9
  inner:
    x64.leaRegRegImm32 r8, rax, 1
    x64.cmpRegImm32 r8, 5
    x64.jcc equal, check
    x64.jmp ifcont
  check:
    x64.jmp whileexit#3
  ifcont:
    x64.movRegReg rax, r8
    x64.jmp whilehdr#7
  whileexit#9:
    x64.jmp whilehdr#4
  whileexit#6:
    x64.jmp whilehdr#1
  critsplit:
    x64.movRegReg r8, rax
    x64.jmp whileexit#3
  whileexit#3:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
