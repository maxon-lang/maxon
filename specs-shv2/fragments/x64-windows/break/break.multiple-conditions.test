// Test: break.multiple-conditions
function main() returns ExitCode
	var x = 5
	var count = 0
	while x < 100 'loop'
		x = x + 1
		count = count + 1
		if count == 3 'check'
			break
		end 'check'
	end 'loop'
	return x
end 'main'
---
ExitCode: 8
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 5
    x64.movRegImm32 rcx, 0
  whilehdr:
    x64.cmpRegImm32 rax, 100
    x64.jcc greaterEqual, critsplit
  loop:
    x64.leaRegRegImm32 r8, rax, 1
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.cmpRegImm32 rcx, 3
    x64.jcc equal, whileexit
  ifcont:
    x64.movRegReg rax, r8
    x64.jmp whilehdr
  critsplit:
    x64.movRegReg r8, rax
  whileexit:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
