func @Clock.nowNanos {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __gt_now_ns
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @Clock.elapsedNanos {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.callDirect Clock.nowNanos
    x64.cmpRegReg r8, rbx
    x64.jcc less, clockSkew
    x64.jmp ifcont
  clockSkew:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.subRegReg r8, r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @print {
