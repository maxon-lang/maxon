// Test: public-may-name-an-enum-case
enum Access
	public
	private
end 'Access'

function main() returns ExitCode
	let a = Access.public
	match a 'which'
		public then return 3
		private then return 0
	end 'which'
end 'main'
---
ExitCode: 3
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#1
    x64.jmp matchnext
  matcharm#1:
    x64.movRegImm32 r8, 3
    x64.popReg rbp
    x64.ret
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm#2
    x64.jmp matchdead
  matcharm#2:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  matchdead:
  matchcont:
}
