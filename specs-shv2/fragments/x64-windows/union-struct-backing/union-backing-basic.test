// Test: union-backing-basic
typealias Latency = int(0 to 50)
typealias ID = int(i64.min to i64.max)

type OpMeta
	export let latency as Latency

	static function create(latency Latency) returns Self
		return Self{latency: latency}
	end 'create'
end 'OpMeta'

union TestOp
	add(dest ID, src ID) = OpMeta.create(1)
	mul(dest ID, src ID) = OpMeta.create(3)
	nop = OpMeta.create(0)
end 'TestOp'

function main() returns ExitCode
	let op = TestOp.add(10, src: 20)
	match op 'handle'
		add(d, s) then return d + s
		mul(d, s) then return d * s
		nop then return 0
	end 'handle'
end 'main'
---
ExitCode: 30
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rbx, 10
    x64.movRegImm32 r12, 20
    x64.movRegImm32 rcx, 24
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.storeBaseDispReg.word64 [r8 + 8], rbx
    x64.storeBaseDispReg.word64 [r8 + 16], r12
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext#5
  matcharm#1:
    x64.loadRegBaseDisp.word64 rax, [r8 + 8]
    x64.loadRegBaseDisp.word64 rcx, [r8 + 16]
    x64.leaRegRegReg rbx, rax, rcx
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic#9
  __rc_chk#10:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc lessEqual, __rc_ok#8
  __rc_panic#9:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#8:
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchnext#5:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchnext#6
  matcharm#2:
    x64.loadRegBaseDisp.word64 rbx, [r8 + 8]
    x64.loadRegBaseDisp.word64 rax, [r8 + 16]
    x64.imulRegReg rbx, rbx, rax
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic#12
  __rc_chk#13:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc lessEqual, __rc_ok#11
  __rc_panic#12:
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#11:
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchnext#6:
    x64.cmpRegImm32 rax, 2
    x64.jcc notEqual, matchdead
  matcharm#3:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
  matchcont:
}
