// Test: a-declared-float-element-array-crosses-a-call-boundary
typealias Real = float(f64.min to f64.max)
typealias Reals = Array with Real

type Samples
	export var values as Reals

	export static function create() returns Self
		var v = Reals.create()
		v.push(2.5)
		return Self{values: v}
	end 'create'
end 'Samples'

function total(xs Reals) returns Real
	var sum = 0.0
	for x in xs 'each'
		sum = sum + x
	end 'each'
	return sum
end 'total'

function main() returns ExitCode
	let s = Samples.create()
	return trunc(total(s.values) + 1.5)
end 'main'
---
ExitCode: 4
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Samples.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movsdRegRip xmm0, [rip + __fconst_1]
    x64.movqGprXmm rdx, xmm0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @total {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 48
    x64.storeSlotReg slot0, xmm6
    x64.movRegReg rbx, rcx
    x64.movsdRegRip xmm6, [rip + __fconst_2]
    x64.movRegImm32 r12, 0
    x64.jmp forhdr
  forhdr:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegReg r12, rax
    x64.jcc less, each
    x64.jmp forexit
  each:
    x64.loadRegBaseDisp.word64 rax, [rbx + 24]
    x64.cmpRegImm32 rax, 8
    x64.jcc equal, __im_word
    x64.jmp __im_stride
  __im_word:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.imulRegRegImm32 rcx, r12, 8
    x64.leaRegRegReg rax, rax, rcx
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.jmp __im_cont
  __im_stride:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, __im_byte
    x64.jmp __im_slow
  __im_byte:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.leaRegRegReg rax, rax, r12
    x64.loadRegBaseDisp.byte rax, [rax + 0]
    x64.jmp __im_cont
  __im_slow:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __managed_get_unchecked
    x64.movRegReg rax, r8
    x64.jmp __im_cont
  __im_cont:
    x64.movqXmmGpr xmm0, rax
    x64.addsdRegReg xmm6, xmm6, xmm0
    x64.jmp forstep
  forstep:
    x64.leaRegRegImm32 r12, r12, 1
    x64.jmp forhdr
  forexit:
    x64.movRegReg xmm0, xmm6
    x64.loadRegSlot xmm6, slot0
    x64.epilogue 48
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect Samples.create
    x64.movRegReg rbx, r8
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.callDirect total
    x64.movsdRegRip xmm1, [rip + __fconst_3]
    x64.addsdRegReg xmm0, xmm0, xmm1
    x64.cvttsd2siRegReg r12, xmm0
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Samples
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
