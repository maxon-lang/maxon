    x64.movRegImm rdx, 18446744073709551615
    x64.movRegImm32 rax, 2
    x64.leaRegRdata r9, [rip + __layout_Array_int]
    x64.movRegReg rcx, rbx
    x64.callDirect Array.slice
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 r12, 99
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
