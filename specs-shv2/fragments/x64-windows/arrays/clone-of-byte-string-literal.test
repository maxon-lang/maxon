// Test: clone-of-byte-string-literal
function main() returns ExitCode
	let lit = b"abc"
	var copy = lit.clone()
	try copy.set(0, value: 90) otherwise panic("index 0 is in bounds")
	let c0 = try copy.get(0) otherwise 0
	let l0 = try lit.get(0) otherwise 0
	if c0 == 90 and l0 == 97 and copy.count() == 3 'ok'
		return 0
	end 'ok'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 48
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg rbx, r8
    x64.leaRegRdata rax, [rip + __barr_blob_0]
    x64.storeBaseDispReg.word64 [rbx + 0], rax
    x64.movRegImm32 rax, 3
    x64.storeBaseDispReg.word64 [rbx + 8], rax
    x64.movRegImm rax, 18446744073709551614
    x64.storeBaseDispReg.word64 [rbx + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [rbx + 24], rax
    x64.leaRegRdata rdx, [rip + __layout_Array_Byte]
    x64.movRegReg rcx, rbx
    x64.callDirect Array.clone
    x64.movRegReg r12, r8
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 rax, 90
    x64.movRegReg rcx, r12
    x64.callDirect __managed_set
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#2
    x64.jmp tryok#1
  tryerr#2:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#1:
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, r12
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#4
    x64.jmp tryok#3
  tryerr#4:
    x64.movRegImm32 r13, 0
    x64.jmp trycont#5
  tryok#3:
    x64.movRegReg r13, r8
    x64.jmp trycont#5
  trycont#5:
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#7
    x64.jmp tryok#6
  tryerr#7:
    x64.movRegImm32 rax, 0
    x64.jmp trycont#8
  tryok#6:
    x64.movRegReg rax, r8
    x64.jmp trycont#8
  trycont#8:
    x64.cmpRegImm32 r13, 90
    x64.movRegImm32 rcx, 0
    x64.jcc equal, andrhs#9
    x64.jmp critsplit#15
  andrhs#9:
    x64.cmpRegImm32 rax, 97
    x64.setccReg equal, rax
    x64.jmp scmerge#10
  critsplit#15:
    x64.movRegReg rax, rcx
    x64.jmp scmerge#10
  scmerge#10:
    x64.movRegImm32 rcx, 0
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, andrhs#11
    x64.jmp critsplit#16
  andrhs#11:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_count
    x64.cmpRegImm32 r8, 3
    x64.setccReg equal, rax
    x64.jmp scmerge#12
  critsplit#16:
    x64.movRegReg rax, rcx
    x64.jmp scmerge#12
  scmerge#12:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, ok
    x64.jmp ifcont
  ok:
    x64.movRegImm32 r13, 0
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
