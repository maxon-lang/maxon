// Test: a-float-element-iterates
function main() returns ExitCode
	let a = [1.5, 2.5, 3.5]
	var sum = 0.0
	for e in a 'each'
		sum = sum + e
	end 'each'
	return trunc(sum)
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 64
    x64.storeSlotReg slot0, xmm6
    x64.storeSlotReg slot1, xmm7
    x64.storeSlotReg slot2, xmm8
    x64.movsdRegRip xmm6, [rip + __fconst_1]
    x64.movsdRegRip xmm7, [rip + __fconst_2]
    x64.movsdRegRip xmm8, [rip + __fconst_3]
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movqGprXmm rdx, xmm6
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movqGprXmm rdx, xmm7
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movqGprXmm rdx, xmm8
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movsdRegRip xmm0, [rip + __fconst_4]
    x64.movRegImm32 rax, 0
  forhdr:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
    x64.cmpRegReg rax, rcx
    x64.jcc greaterEqual, forexit
  each:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.loadRegBaseIndexScale.word64 rcx, [rcx + rax*8 + 0]
  __im_cont:
    x64.movqXmmGpr xmm1, rcx
    x64.addsdRegReg xmm0, xmm0, xmm1
  forstep:
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp forhdr
  forexit:
    x64.cvttsd2siRegReg r12, xmm0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.loadRegSlot xmm6, slot0
    x64.loadRegSlot xmm7, slot1
    x64.loadRegSlot xmm8, slot2
    x64.epilogue 64
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.loadRegSlot xmm6, slot0
    x64.loadRegSlot xmm7, slot1
    x64.loadRegSlot xmm8, slot2
    x64.epilogue 64
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
