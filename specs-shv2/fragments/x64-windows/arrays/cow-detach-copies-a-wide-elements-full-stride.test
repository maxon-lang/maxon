    x64.jmp tryok#11
  tryerr#12:
    x64.movRegImm32 rax, 0
    x64.jmp trycont#13
  tryok#11:
    x64.movRegReg rax, r8
    x64.jmp trycont#13
  trycont#13:
    x64.cmpRegImm32 r13, 99
    x64.movRegImm32 rcx, 0
    x64.jcc equal, andrhs#14
