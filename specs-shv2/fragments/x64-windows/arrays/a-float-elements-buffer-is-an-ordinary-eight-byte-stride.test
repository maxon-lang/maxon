// Test: a-float-elements-buffer-is-an-ordinary-eight-byte-stride
function main() returns ExitCode
	let a = [1.5, 2.5, 3.5]
	print("{a.managed.length()}\n")
	print("{a.managed.elementSize()}\n")
	return trunc(try a.get(2) otherwise 0.0)
end 'main'
