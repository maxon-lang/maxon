// ⭐⭐ **FIVE OF THE OBJECT LAYER'S FOURTEEN ENTRY POINTS.** Two are the whole OS-DIRECT road, which above
// `SlabMaxSmallSize` makes a request its own mapping rather than a slot in a span: one `osAllocPages` per
// allocation, one `osFreePages` per free, and the mapping's own length in a 16-byte prefix. The other three
// are the allocator's STATE — the lazily committed region every shared structure lives in, and the metadata
// slab's two cursors, which hand mspan headers out and take them back.
//
// ⛔⛔ **THE REST OF `Compiler/Runtime/SlabRuntime.maxon` IS NOT MISSING — IT CANNOT BE SOURCE, AND THE
// BLOCKER IS THE TARGET.** The allocation doors, the free door and the lock pair read the target's
// `MachineModel`: on wasm the walk to *"which processor am I"* is a constant because the backend has no
// `tlsSlotLoad`, and on every other lane it is a TLS read. Tier source is compiled once and has no such
// knob. One more is blocked for a different reason: `__slab_rounded_size` shares
// `SlabRuntime.emitSlabClassIndex` with `__slab_alloc`, so porting it alone would be a SECOND SPELLING of
// one walk.
//
// ⛔ **AND `__slab_span_destroy` IS EXCLUDED ON THE SAME RULE, WHICH IS NOT WHERE ITS BLOCKER WAS EXPECTED.**
// It reads no usage record at all and every callee it names is here, so the machine model above does not
// touch it; what stops it is that it and `__slab_refill` compute a span's chunk run from the same packed
// class geometry, and the refill stays. `SlabRuntime.emitSpanChunkCount` states why that must be ONE
// spelling: the CUT and the DESTRUCTION have to agree to the chunk, or a span is released one chunk short
// and a chunk stays claimed forever.
//
// ⭐⭐ **THE ZEROING IS NOT WHAT BLOCKS THE ALLOCATION DOORS.** `zeroed` never reaches `RuntimeUsage`:
// `SlabRuntime.installSlabRuntime` passes a LITERAL to each of the two doors — `__slab_alloc` zeroes,
// `__slab_alloc_raw` does not — and a build-time argument that is a literal per entry point is one tier
// source simply spells. What it costs is one Maxon helper taking a `bool` parameter where the builder has
// two emissions of one emitter, which is a cost and not a blocker.
//
// The constants below are restated from `Compiler/Runtime/SlabRuntime.maxon` because no name crosses the
// tier boundary — the rule `runtime/SlabArena.maxon` states in full for its own geometry. Each names the
// fact it restates, and `checkSlabRuntimeGeometry` reads them back out of this file by these identifiers and
// compares each against the emitter's copy, so a seed that drifts here fails the next compile rather than
// becoming a wrong offset.

// ⭐ **SIGNED AND FULL-RANGE, AND THE SIGN IS WHAT MAKES `__slab_assert_os_alloc`'s TEST WORK.** A raw
// POSIX page syscall answers a small NEGATIVE errno in the result register; read unsigned that is the
// largest address the machine could have. `runtime/SlabArena.maxon`'s `ArenaWord` carries the same
// argument for the layer beneath, and full-range for the same reason: an address and a byte count share
// this type and neither has a bound this file could state.
typealias SlabWord = int(i64.min to i64.max)

// ⭐ **THE CHUNK IS GO'S 8 KiB PAGE.** `SlabClasses.SlabPageShift` is the compiler's copy, and an OS-direct
// mapping is rounded up to it so the whole road speaks one granularity.
let SlabPageBytes = 8192

// The align-up pair for that width — `(x + mask) and alignMask` — which is what `MmRuntime.emitAlignUp`
// emits one tier down and what `__slab_rounded_size` still reaches it through.
let SlabPageMask = SlabPageBytes - 1
let SlabPageAlignMask = -SlabPageBytes

// ⭐⭐ **THE PREFIX IS THE MAPPING'S OWN SIZE RECORD.** A free has to know how many bytes to hand back and
// the pointer→span reverse map cannot answer: a map MISS *is* the OS-direct sentinel, so registering these
// pages would destroy the very signal that identifies them.
//
// It is 16 bytes rather than 8 so the pointer handed back keeps the 16-byte alignment every record layout
// above this file assumes. ⚠ **`SlabRuntime.OsDirectPrefixBytes` IS THE OTHER COPY**, read by
// `__slab_rounded_size` to report the bytes a caller may actually use; the two must agree or that answer
// names more room than the mapping holds.
let OsDirectPrefixBytes = 16
let OsDirectTotalBytesOffset = 0
let OsDirectMagicOffset = 8

// ⭐ **THE DOUBLE-FREE GUARD, IN ONE COMPARE.** With no tracking array to search there is nothing for a
// bogus pointer to miss, so the fault — a double free, or a pointer that was never ours — is caught by a
// magic word the allocator stamps and the free checks. Without it a bogus free reads user data as a byte
// count and hands it to `osFreePages`, which unmaps an arbitrary region.
//
// `"SLABOSD!"` read as a little-endian machine word. Any value would do; a legible one makes a memory dump
// readable, which is the only thing this constant is ever looked at in.
let OsDirectMagic = 0x2144534F42414C53 as MachineWord

// The exit code this file ends the process with, restated from `RuntimeAbort` for
// `runtime/SlabArena.maxon`'s reason: an exit rather than a panic, because a panic builds a message and
// walks a stack and both allocate.
let SlabOsDirectPointerNotOursExit = 87 as MachineWord

// `__slab_os_direct_alloc(size) -> ptr` — one mapping for one request, with its length in a prefix.
module function __slab_os_direct_alloc(size MachineWord) returns MachineWord
	let withPrefix = (size as SlabWord) + OsDirectPrefixBytes
	let total = (withPrefix + SlabPageMask) and SlabPageAlignMask

	let base = __slab_assert_os_alloc(__Raw.osAllocPages(total as MachineWord) as SlabWord)

	__Raw.storeWord(base as MachineWord, offset: OsDirectTotalBytesOffset, value: total as MachineWord)
	__Raw.storeWord(base as MachineWord, offset: OsDirectMagicOffset, value: OsDirectMagic)
	slabStepOsDirectBytes(total)

	// The pages are fresh from the OS, so the payload past the prefix is already zero — the zeroing
	// contract costs this tier nothing at all, and an OS-direct mapping is never recycled through us.
	return (base + OsDirectPrefixBytes) as MachineWord
end '__slab_os_direct_alloc'

// `__slab_os_direct_free(ptr)` — hand one mapping back whole.
//
// ⚠ **THE RELEASE IS THE ARM THAT IS SPELLED, NOT THE GUARD**, which is the opposite of
// `runtime/SlabArena.maxon`'s guard-first shape and is deliberate: a body written as *"refuse, then
// release"* lays the abort out as the FALL-THROUGH and puts a taken branch on every large free.
module function __slab_os_direct_free(ptr MachineWord)
	let base = (ptr as SlabWord) - OsDirectPrefixBytes

	if __Raw.loadWord(base as MachineWord, offset: OsDirectMagicOffset) == OsDirectMagic 'ours'
		let total = __Raw.loadWord(base as MachineWord, offset: OsDirectTotalBytesOffset)

		__Raw.osFreePages(base as MachineWord, size: total)
		slabStepOsDirectBytes(-(total as SlabWord))

		return
	end 'ours'

	__Raw.osExit(SlabOsDirectPointerNotOursExit)
end '__slab_os_direct_free'

function slabStepOsDirectBytes(delta SlabWord)
	_ = __Raw.atomicAddWord((__slab_state_base() as SlabWord + SlabStateOsDirectBytesOffset) as MachineWord, delta: delta as MachineWord)
end 'slabStepOsDirectBytes'

// --- The state region, restated ---
//
// ⚠ `Compiler/Runtime/SlabRuntime.maxon` holds the other copy of every number below, and the two are made to
// meet at `checkSlabRuntimeGeometry`, which reads each constant here by name and compares it against the
// emitter's on every compile of every allocating program. That is the only thing standing between a
// regenerated class ladder and a request one chunk too small — an mcache running off the end of its run into
// whatever the arena hands out next, silently.

// The stride of the region's head words and of both arrays past the lock.
let SlabWordBytes = 8

// The head: the metadata slab's bump cursor, its limit, the free list of dead mspan headers, the
// scheduler word (`SlabRuntime.SlabStateSchedulerOffset`) and the lock-depth sink
// (`SlabRuntime.SlabStateLockDepthSinkOffset`). Chained so that inserting a head word moves the lock and
// the arrays after it. This file reads the first three and never the last two.
let SlabStateMetaBumpOffset = 0
let SlabStateMetaEndOffset = SlabStateMetaBumpOffset + SlabWordBytes
let SlabStateMetaFreeOffset = SlabStateMetaEndOffset + SlabWordBytes
let SlabStateSchedulerOffset = SlabStateMetaFreeOffset + SlabWordBytes
let SlabStateLockDepthSinkOffset = SlabStateSchedulerOffset + SlabWordBytes

// ⭐ **THE SLOW-PATH LOCK SITS IN THE REGION RATHER THAN IN A `.data` WORD**, because a new `.data` label
// shifts every label after it and re-mints every heap program's golden. `MmRuntime.OsLockBytes` is the other
// copy of the width, and it is the MAXIMUM over the five lanes (a Darwin `pthread_mutex_t`) rather than any
// one lane's — which is what makes this offset one number instead of five.
let SlabStateLockOffset = SlabStateLockDepthSinkOffset + SlabWordBytes
let OsLockBytes = 64

// The three arrays past the lock: one mcentral head per class, one mcache row per shard, then one row of
// traffic columns per shard. `SlabClasses.slabClassCount()`, `SlabRuntime.SlabMaxShards` and
// `SlabRuntime.SlabTrafficColumn` are the other copies.
let SlabClassCount = 68
let SlabMaxShards = 256
let SlabTrafficColumns = 6

// `SlabRuntime.SlabStateMcentralOffset` and `slabStateMcacheOffset()` are the other copies, pinned at
// `checkSlabRuntimeGeometry`.
let SlabStateMcentralOffset = SlabStateLockOffset + OsLockBytes
let SlabStateMcacheOffset = SlabStateMcentralOffset + SlabClassCount * SlabWordBytes

// A request above `SlabMaxSmallSize` is its own mapping, which no arena bitmap describes, so a
// committed-bytes census read off the arenas alone reports a program whose working set is large buffers as
// holding nothing. `SlabRuntime.slabStateOsDirectBytesOffset()` is the other copy.
//
// A word added here must go past the last array and never into the head. A head word shifts the lock and
// both arrays, and the compiler that builds the next compiler still emits the old offsets while reading
// this file for the tier — so that intermediate binary initialises the lock at one address and takes it at
// another. Past everything a builder addresses, only the region's total grows, and the total is the tier's
// own request.
//
// ⚠ The step is atomic because neither OS-direct door takes `__slab_lock`; they call the OS and return.
let SlabStateOsDirectBytesOffset = SlabStateMcacheOffset + SlabMaxShards * SlabClassCount * SlabWordBytes + SlabMaxShards * SlabTrafficColumns * SlabWordBytes

let SlabCensusTagBuckets = 2048
let SlabCensusBucketWords = 2
let SlabCensusSlotAlignBytes = 8

// A mark index is taken by this constant SHIFT and never by a division or a variable shift: either of
// those lowers to a check against `mrt_panic`, which would put that panic and its `.rdata` string into
// every program this compiler builds. `requireMarkTableCoversTheWidestSpan` pins the two together.
let SlabCensusSlotAlignShift = 3
let SlabCensusSpanMarkBytes = 10240

let SlabCensusBucketStride = SlabCensusBucketWords * SlabWordBytes
let SlabCensusBucketCountWord = 0
let SlabCensusBucketBytesWord = SlabWordBytes
let SlabCensusTableBytes = SlabCensusTagBuckets * SlabCensusBucketStride

let SlabStateCensusTableOffset = SlabStateOsDirectBytesOffset + SlabWordBytes
let SlabStateCensusMarksOffset = SlabStateCensusTableOffset + SlabCensusTableBytes

let SlabStateBytes = SlabStateCensusMarksOffset + SlabCensusSpanMarkBytes
let SlabStateChunks = (SlabStateBytes + SlabPageMask) / SlabPageBytes

// ⭐ **ZERO IS THE STATE THE `.data` IMAGE ALREADY EXPRESSES, so there is nothing to initialise and nothing
// to guard.** `SlabRuntime.SlabStateUncommitted` is the other copy, and it is what
// `SlabRuntime.emitSlabStateBase`'s inline probe tests for at every allocation and every free: a tier that
// published some other value would send every one of them down the commit call.
let SlabStateUncommitted = 0

// The metadata slab's slot. `SlabRuntime.MspanSlotBytes` is the other copy and is checked there against the
// mspan record's own width.
let MspanSlotBytes = 80

// A dead header's link rides in its FIRST word — `base_addr`, which `__slab_refill` overwrites on the way
// back out — so the free list costs no storage of its own and a recycled header needs no clearing.
// `SlabRuntime.MspanBaseAddrOffset` is the other copy.
let MspanBaseAddrOffset = 0

// `SlabRuntime.MspanFreeCountOffset`, `MspanClassIdxOffset` and `MspanOwningPOffset` are the other copies,
// pinned at `checkSlabRuntimeGeometry`. A field that moves on one side only reads a class index as a free
// count, with nothing at run time to notice.
let MspanFreeListOffset = 8
let MspanFreeCountOffset = 16
let MspanClassIdxOffset = 32
let MspanBumpNextOffset = 40
let MspanOwningPOffset = 48
let MspanRemoteHeadOffset = 56
let MspanRemoteCountOffset = 64

// A carved-and-returned metadata slot holds stale fields rather than zeroes, so nothing but this sentinel
// tells the census walk apart from a live span. `SlabRuntime.MspanOwningPFreed` is the other copy, and
// `__slab_free` aborts on a free that reaches one.
let MspanOwningPFreed = -2

// The state a span is in while it sits on its class's partial list, holding no processor.
// `SlabRuntime.MspanStatePartial` is the other copy.
let MspanStatePartial = -1

// A chunk's first slot links it to its predecessor, which is the only thing that makes the slab walkable:
// the bump cursor and its limit describe the chunk being filled and nothing before it.
let MetaChunkNextOffset = 0

// The packed class geometry is `slot_size | (objects_per_span << 32)`, reached by address through
// `__Raw.slabClassGeomAddr`. `SlabRuntime.SlabClassGeomSlotShift` and `SlabClassGeomSlotMask` are the other
// copies. A shift of 32 keeps the high field's top bit clear, which is what lets an arithmetic `shr`
// extract it.
let SlabClassGeomSlotShift = 32
let SlabClassGeomSlotMask = 0xFFFFFFFF

// `__slab_state_base() -> base` — the allocator's mutable state, committed on first use.
//
// ⭐ **THE REGION IS CHUNKS FROM THE ARENA, NOT A FRESH `osAllocPages`.** This sits ON the arena, so taking
// its chunks out of a mapping the process has already committed costs no additional commit at all.
//
// ⚠ **THE ZEROING IS NOT OPTIONAL AND THE ARENA'S OWN CONTRACT IS WHY.** A chunk is fresh OS memory only
// the first time it is handed out — the arena's scan is first-fit over a bitmap, so a freed low chunk is
// reused before a virgin high one. An unzeroed mcache reads a dead chunk's bytes as a span pointer.
//
// ⛔⛔ **THE `osLockInit` IS UNCONDITIONAL AND MUST STAY SO.** This arm fires on the FIRST allocation the
// process ever makes, which necessarily precedes any scheduler — `__gt_init` allocates the run-queue lock
// and the P array through `__slab_alloc`. A lock initialised only for a program that already "has threads"
// would therefore never be initialised at all, and every green-thread program would enter a raw region. The
// `memFill` above it is what makes the call legal: it hands the OS a zeroed region rather than a dead
// chunk's bytes.
//
// ⛔ **AND THE PUBLISHING STORE IS LAST.** The `.data` word is what every other thread tests to decide the
// region exists, so publishing it before the lock inside it is initialised would hand a second thread an
// uninitialised mutex.
//
// ⚠ **THE COMMIT IS THE ARM THAT FALLS THROUGH, NOT THE GUARD.** This function is reached from the inline
// probe's COLD arm, so the uncommitted case is the one that arrives here; a guard-first shape would put the
// taken branch on it. `__slab_os_direct_free` above makes the same argument the other way round.
module function __slab_state_base() returns MachineWord
	let stateAddr = __Raw.slabStateAddr()
	let current = __Raw.loadWord(stateAddr, offset: 0)

	if (current as SlabWord) == SlabStateUncommitted 'commit'
		let base = __slab_arena_alloc_chunks(SlabStateChunks as SlabWord) as SlabWord

		__Raw.memFill(base as MachineWord, byteCount: SlabStateBytes as MachineWord, value: 0)
		__Raw.osLockInit((base + SlabStateLockOffset) as MachineWord)
		__Raw.storeWord(stateAddr, offset: 0, value: base as MachineWord)

		return base as MachineWord
	end 'commit'

	return current
end '__slab_state_base'

// `__slab_meta_alloc() -> span` — one mspan header, off the free list if there is one and off the metadata
// slab's bump cursor otherwise.
//
// ⭐ **THE FREE LIST'S PRODUCER IS `__slab_scavenge`**, the one road that destroys a span. Without a list to
// put the header on, every span it reclaims would leak its metadata slot for the life of the process.
//
// ⚠⚠ **THE SLOT IS NOT ASSUMED ZERO, AND THE FREE LIST IS WHY THAT RULE BITES.** `__slab_refill` writes
// every mspan field regardless — an uninitialised field here is STALE DATA, not zero — which is what keeps
// this function free of any zeroing at all. A recycled header carries the previous span's fields AND the
// list link written over its first word, so a refill that left ONE field unwritten would produce a span
// describing a chunk run that belongs to somebody else.
//
// ⚠ **PRECONDITION: THE CALLER HOLDS `__slab_lock`.** The bump cursor and the free list are shared by every
// P, and every caller is already inside the lock — so taking it here would be a recursive re-entry paying
// for a fact the caller has established.
module function __slab_meta_alloc() returns MachineWord
	let state = __slab_state_base()

	// POP FIRST, AND THE BUMP IS THE ARM THAT FALLS THROUGH. The list is tested first because a recycled
	// header is warm and costs one load; the layout is the other way round because the bump path is what runs
	// while the metadata slab is still growing, which is every program that never scavenges.
	let listHead = __Raw.loadWord(state, offset: SlabStateMetaFreeOffset)

	if (listHead as SlabWord) == 0 'bump'
		let cursor = __Raw.loadWord(state, offset: SlabStateMetaBumpOffset) as SlabWord
		let advanced = cursor + MspanSlotBytes

		// The initial state is `cursor == 0` and `limit == 0`, so the first call fails this test and takes the
		// fresh-chunk arm — the `.data` zero IS the initialisation, exactly as it is for the arena list head.
		if advanced <= (__Raw.loadWord(state, offset: SlabStateMetaEndOffset) as SlabWord) 'take'
			__Raw.storeWord(state, offset: SlabStateMetaBumpOffset, value: advanced as MachineWord)

			return cursor as MachineWord
		end 'take'

		let chunk = __slab_arena_alloc_chunks(1 as SlabWord) as SlabWord

		// Slot 0 is the link, so the first header is slot 1 and the cursor starts past both.
		let previous = __Raw.loadWord(state, offset: SlabStateMetaEndOffset) as SlabWord
		let head = slabMetaChunkOf(previous)

		__Raw.storeWord(chunk as MachineWord, offset: MetaChunkNextOffset, value: head as MachineWord)
		__Raw.storeWord(state, offset: SlabStateMetaBumpOffset, value: (chunk + MspanSlotBytes + MspanSlotBytes) as MachineWord)
		__Raw.storeWord(state, offset: SlabStateMetaEndOffset, value: (chunk + SlabPageBytes) as MachineWord)

		return (chunk + MspanSlotBytes) as MachineWord
	end 'bump'

	// The link lives in the dead header's FIRST word, so unlinking is one load and one store and the slot
	// needs no clearing.
	__Raw.storeWord(state, offset: SlabStateMetaFreeOffset, value: __Raw.loadWord(listHead, offset: MspanBaseAddrOffset))

	return listHead
end '__slab_meta_alloc'

// `__slab_meta_free(span)` — put a destroyed span's header back on the metadata free list.
//
// ⚠ **THE HEADER'S CHUNK IS NEVER RELEASED, ONLY ITS SLOTS ARE REUSED.** The metadata slab bump-allocates
// out of whole chunks and this list hands the SLOTS back; the chunks stay claimed for the life of the
// process. One chunk holds a hundred-odd headers belonging to unrelated spans, so it could only be released
// when every one of them is dead — a second free-list-of-chunks problem for a structure that is under 1% of
// the heap it describes.
//
// ⚠ **PRECONDITION: THE CALLER HOLDS `__slab_lock`** — see `__slab_meta_alloc`, whose cursor this list
// shares.
module function __slab_meta_free(span MachineWord)
	let state = __slab_state_base()

	__Raw.storeWord(span, offset: MspanBaseAddrOffset, value: __Raw.loadWord(state, offset: SlabStateMetaFreeOffset))
	__Raw.storeWord(span, offset: MspanOwningPOffset, value: MspanOwningPFreed as MachineWord)
	__Raw.storeWord(state, offset: SlabStateMetaFreeOffset, value: span)
end '__slab_meta_free'

// The limit word is `chunk + SlabPageBytes`, so the chunk list needs no head of its own.
function slabMetaChunkOf(metaEnd SlabWord) returns SlabWord
	if metaEnd == 0 'none'
		return 0
	end 'none'

	return metaEnd - SlabPageBytes
end 'slabMetaChunkOf'

// --- The census ---
//
// `specs/slab-census.md` owns what each figure counts. Two facts bind here: `live + free` is every slot of
// every live span, which is the relation that case asserts, and a slot queued against a span is counted
// FREE — it is on no free list and is not handed out either, so `free_count` alone would report it live.
//
// ⚠ Nothing below is stepped at an allocation or a free. A figure derived at the door instead would put
// this walk's cost on every free in the language.

// `SlabRuntime.SlabCensusLiveBytes` and its four neighbours are the other copies. A drift swaps two
// figures over, which no run would notice.
let SlabCensusLiveBytes = 0
let SlabCensusFreeBytes = 1
let SlabCensusParkedBytes = 2
let SlabCensusCachedFreeBytes = 3
let SlabCensusCommittedBytes = 4

let SlabCensusTagMode = 0
let SlabCensusClassMode = 1

let SlabWalkTallyBase = SlabCensusCommittedBytes + 1
let SlabWalkTallyByTag = SlabWalkTallyBase + SlabCensusTagMode
let SlabWalkTallyByClass = SlabWalkTallyBase + SlabCensusClassMode

let SlabCensusImplausibleBucket = SlabCensusTagBuckets - 2
let SlabCensusOverflowBucket = SlabCensusTagBuckets - 1

let SlabCensusTagShift = 16
let SlabCensusTagMask = 0xFFFF

let SlabCensusSlotUnmarked = 0
let SlabCensusSlotMarked = 1

let SlabCensusTallyUnsoundExit = 119 as MachineWord

// Precondition: the caller holds `__slab_lock`. The metadata slab, the mcache rows and the arena bitmaps
// are all written by a P inside it, so an unlocked walk reads a span header between `__slab_meta_alloc` and
// the refill that fills it in. `SlabRuntime.buildSlabCensusEntry` is the caller that takes it.
module function __slab_census(kind MachineWord) returns MachineWord
	if (kind as SlabWord) == SlabCensusCommittedBytes 'committed'
		return ((__slab_arena_committed_bytes() as SlabWord) + (__Raw.loadWord(__slab_state_base(), offset: SlabStateOsDirectBytesOffset) as SlabWord)) as MachineWord
	end 'committed'

	if (kind as SlabWord) == SlabCensusCachedFreeBytes 'cached'
		return slabCensusMcache() as MachineWord
	end 'cached'

	return slabWalkSpans(kind as SlabWord) as MachineWord
end '__slab_census'

// The first chunk stops at the bump cursor and every other one at its end: the chunk the limit word
// describes is the one being filled, and every chunk behind it on the link is full.
function slabWalkSpans(what SlabWord) returns SlabWord
	let state = __slab_state_base()
	var chunk = slabMetaChunkOf(__Raw.loadWord(state, offset: SlabStateMetaEndOffset) as SlabWord)
	var limit = __Raw.loadWord(state, offset: SlabStateMetaBumpOffset) as SlabWord
	var total = 0 as SlabWord

	while chunk != 0 'chunks'
		var slot = chunk + MspanSlotBytes

		// The slot's END must fit, which is the bound `__slab_meta_alloc` bumps against. A slot size that
		// does not divide the chunk leaves a tail too short for a header, and `slot < limit` walks into it.
		while (slot + MspanSlotBytes) <= limit 'slots'
			total = total + slabVisitSpan(slot, what: what)
			slot = slot + MspanSlotBytes
		end 'slots'

		chunk = __Raw.loadWord(chunk as MachineWord, offset: MetaChunkNextOffset) as SlabWord
		limit = chunk + SlabPageBytes
	end 'chunks'

	return total
end 'slabWalkSpans'

function slabVisitSpan(span SlabWord, what SlabWord) returns SlabWord
	let owner = __Raw.loadWord(span as MachineWord, offset: MspanOwningPOffset) as SlabWord

	if owner == MspanOwningPFreed 'destroyed'
		return 0
	end 'destroyed'

	let geom = slabSpanGeom(span)
	let slotSize = geom and SlabClassGeomSlotMask
	let totalSlots = geom shr SlabClassGeomSlotShift

	// A queued slot is on no free list and is not handed out either, so it is counted with the free ones.
	// Reading it here rather than walking the chain keeps the census proportional to SPANS.
	let freeCount = slabSpanFreeSlots(span)
	let liveSlots = totalSlots - freeCount

	if what == SlabCensusFreeBytes 'free'
		return freeCount * slotSize
	end 'free'

	if what == SlabCensusParkedBytes 'parked'
		if freeCount != totalSlots 'stillHoldsLiveSlots'
			return 0
		end 'stillHoldsLiveSlots'

		if owner == MspanStatePartial 'idleOnThePartialList'
			return totalSlots * slotSize
		end 'idleOnThePartialList'

		return 0
	end 'parked'

	if what == SlabWalkTallyByTag 'tallyByTag'
		slabCensusTallyByTag(span, slotSize: slotSize, totalSlots: totalSlots, liveSlots: liveSlots)
	end 'tallyByTag' else if what == SlabWalkTallyByClass 'tallyByClass'
		slabCensusBucketAdd(__Raw.loadWord(span as MachineWord, offset: MspanClassIdxOffset) as SlabWord, slots: liveSlots, bytes: liveSlots * slotSize)
	end 'tallyByClass' else 'theLevelItself'
		slabCensusRequire(what == SlabCensusLiveBytes)
	end 'theLevelItself'

	return liveSlots * slotSize
end 'slabVisitSpan'

// Walked from the rows rather than from the spans, which is why it is a second walk: asking a span whether
// any row points at it is 17,408 words per span, where asking each row is 17,408 words for the whole heap.
function slabCensusMcache() returns SlabWord
	let base = (__slab_state_base() as SlabWord) + SlabStateMcacheOffset
	let entries = SlabMaxShards * SlabClassCount
	var entry = 0 as SlabWord
	var total = 0 as SlabWord

	while entry < entries 'entries'
		let span = __Raw.loadWord((base + entry * SlabWordBytes) as MachineWord, offset: 0) as SlabWord

		if span != 0 'cached'
			total = total + slabVisitSpan(span, what: SlabCensusFreeBytes)
		end 'cached'

		entry = entry + 1
	end 'entries'

	return total
end 'slabCensusMcache'

function slabSpanGeom(span SlabWord) returns SlabWord
	return __Raw.loadWord((__Raw.slabClassGeomAddr() as SlabWord + (__Raw.loadWord(span as MachineWord, offset: MspanClassIdxOffset) as SlabWord) * SlabWordBytes) as MachineWord, offset: 0) as SlabWord
end 'slabSpanGeom'

// The level and the tally both read the free set here, so a break in it moves both figures together and
// their equality survives. A tally that re-spelled it as `free_count` alone would agree on every
// single-processor heap and diverge the moment another processor frees into a span it does not hold
// cached — `specs/slab-census.md`'s `the-tally-totals-the-live-heap-on-several-processors` is the gate.
function slabSpanFreeSlots(span SlabWord) returns SlabWord
	return (__Raw.loadWord(span as MachineWord, offset: MspanFreeCountOffset) as SlabWord) + (__Raw.loadWord(span as MachineWord, offset: MspanRemoteCountOffset) as SlabWord)
end 'slabSpanFreeSlots'

module function __slab_census_tally_walk(mode MachineWord) returns MachineWord
	__Raw.memFill(slabCensusTableBase() as MachineWord, byteCount: SlabCensusTableBytes as MachineWord, value: 0)

	return slabWalkSpans(slabCensusWalkOfMode(mode as SlabWord)) as MachineWord
end '__slab_census_tally_walk'

module function __slab_census_bucket_count(index MachineWord) returns MachineWord
	return slabCensusBucketWord(index as SlabWord, word: SlabCensusBucketCountWord)
end '__slab_census_bucket_count'

module function __slab_census_bucket_bytes(index MachineWord) returns MachineWord
	return slabCensusBucketWord(index as SlabWord, word: SlabCensusBucketBytesWord)
end '__slab_census_bucket_bytes'

function slabCensusBucketWord(index SlabWord, word SlabWord) returns MachineWord
	if not slabCensusBucketIsInTable(index) 'outsideTheTable'
		return 0 as MachineWord
	end 'outsideTheTable'

	return __Raw.loadWord((slabCensusBucketEntry(index) + word) as MachineWord, offset: 0)
end 'slabCensusBucketWord'

function slabCensusWalkOfMode(mode SlabWord) returns SlabWord
	if mode != SlabCensusTagMode and mode != SlabCensusClassMode 'noSuchMode'
		__Raw.osExit(SlabCensusTallyUnsoundExit)
	end 'noSuchMode'

	return SlabWalkTallyBase + mode
end 'slabCensusWalkOfMode'

function slabCensusBucketIsInTable(index SlabWord) returns bool
	return index >= 0 and index < SlabCensusTagBuckets
end 'slabCensusBucketIsInTable'

function slabCensusBucketEntry(index SlabWord) returns SlabWord
	return slabCensusTableBase() + index * SlabCensusBucketStride
end 'slabCensusBucketEntry'

function slabCensusTableBase() returns SlabWord
	return (__slab_state_base() as SlabWord) + SlabStateCensusTableOffset
end 'slabCensusTableBase'

function slabCensusMarksBase() returns SlabWord
	return (__slab_state_base() as SlabWord) + SlabStateCensusMarksOffset
end 'slabCensusMarksBase'

function slabCensusBucketAdd(bucket SlabWord, slots SlabWord, bytes SlabWord)
	slabCensusRequire(slabCensusBucketIsInTable(bucket))

	let entry = slabCensusBucketEntry(bucket) as MachineWord

	__Raw.storeWord(entry, offset: SlabCensusBucketCountWord, value: ((__Raw.loadWord(entry, offset: SlabCensusBucketCountWord) as SlabWord) + slots) as MachineWord)
	__Raw.storeWord(entry, offset: SlabCensusBucketBytesWord, value: ((__Raw.loadWord(entry, offset: SlabCensusBucketBytesWord) as SlabWord) + bytes) as MachineWord)
end 'slabCensusBucketAdd'

function slabCensusTallyByTag(span SlabWord, slotSize SlabWord, totalSlots SlabWord, liveSlots SlabWord)
	let marks = slabCensusMarksBase()
	let base = __Raw.loadWord(span as MachineWord, offset: MspanBaseAddrOffset) as SlabWord
	let bumpNext = __Raw.loadWord(span as MachineWord, offset: MspanBumpNextOffset) as SlabWord

	slabCensusRequire(slotSize >= SlabCensusSlotAlignBytes)
	slabCensusRequire(bumpNext >= base and bumpNext <= (base + totalSlots * slotSize))

	__Raw.memFill(marks as MachineWord, byteCount: ((bumpNext - base) shr SlabCensusSlotAlignShift) as MachineWord, value: SlabCensusSlotUnmarked)

	slabCensusMarkChain(__Raw.loadWord(span as MachineWord, offset: MspanFreeListOffset) as SlabWord, base: base, bumpNext: bumpNext, marks: marks)
	slabCensusMarkChain(__Raw.loadWord(span as MachineWord, offset: MspanRemoteHeadOffset) as SlabWord, base: base, bumpNext: bumpNext, marks: marks)

	var slot = base
	var live = 0 as SlabWord

	while slot < bumpNext 'slots'
		if not slabCensusSlotIsMarked(marks, slot: slot, base: base) 'stillHandedOut'
			live = live + 1
			slabCensusBucketAdd(slabCensusTagBucketOf(__Raw.loadWord(slot as MachineWord, offset: 0) as SlabWord), slots: 1, bytes: slotSize)
		end 'stillHandedOut'

		slot = slot + slotSize
	end 'slots'

	slabCensusRequire(live == liveSlots)
end 'slabCensusTallyByTag'

function slabCensusMarkChain(head SlabWord, base SlabWord, bumpNext SlabWord, marks SlabWord)
	var slot = head

	while slot != 0 'chain'
		slabCensusRequire(slot >= base and slot < bumpNext)
		slabCensusRequire(not slabCensusSlotIsMarked(marks, slot: slot, base: base))
		slabCensusMarkSlot(marks, slot: slot, base: base)

		slot = __Raw.loadWord(slot as MachineWord, offset: 0) as SlabWord
	end 'chain'
end 'slabCensusMarkChain'

// An unsound reading ends the process rather than panicking. The walk holds `__slab_lock` and `mrt_panic`
// allocates, so a panic raised here would deadlock inside the allocator instead of reporting.
function slabCensusRequire(holds bool)
	if holds 'sound'
		return
	end 'sound'

	__Raw.osExit(SlabCensusTallyUnsoundExit)
end 'slabCensusRequire'

// A header-less slot — a string's bytes, an element buffer, a green thread's stack — is a slab slot too,
// and its first word is not a packed id. A word whose id half is zero is therefore attributed to no tag
// rather than to whatever tag its bytes happen to spell.
function slabCensusTagBucketOf(word SlabWord) returns SlabWord
	if (word shr SlabCensusTagShift) == 0 'noAllocationId'
		return SlabCensusImplausibleBucket
	end 'noAllocationId'

	let tag = word and SlabCensusTagMask

	if tag >= SlabCensusImplausibleBucket 'pastTheTable'
		return SlabCensusOverflowBucket
	end 'pastTheTable'

	return tag
end 'slabCensusTagBucketOf'

function slabCensusMarkAddr(marks SlabWord, slot SlabWord, base SlabWord) returns MachineWord
	return (marks + ((slot - base) shr SlabCensusSlotAlignShift)) as MachineWord
end 'slabCensusMarkAddr'

function slabCensusSlotIsMarked(marks SlabWord, slot SlabWord, base SlabWord) returns bool
	return (__Raw.loadByte(slabCensusMarkAddr(marks, slot: slot, base: base), offset: 0) as SlabWord) != SlabCensusSlotUnmarked
end 'slabCensusSlotIsMarked'

function slabCensusMarkSlot(marks SlabWord, slot SlabWord, base SlabWord)
	__Raw.storeByte(slabCensusMarkAddr(marks, slot: slot, base: base), offset: 0, value: SlabCensusSlotMarked as MachineWord)
end 'slabCensusMarkSlot'
