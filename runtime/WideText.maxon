typealias WideTextWord = int(i64.min to i64.max)

#if os(Windows)
	let NarrowUnitBytes = 1
	let WideUnitBytes = 2
	let ByteBits = 8
	let ByteMask = 0xFF
	let AsciiLimit = 0x80
	let NonAsciiByte = 0xFF
	let ContinuationFloor = 0x80
	let ContinuationCeiling = 0xBF
	let ContinuationPayloadMask = 0x3F
	let ContinuationPayloadBits = 6
	let TwoByteLeadFloor = 0xC2
	let TwoByteLead = 0xC0
	let ThreeByteLead = 0xE0
	let FourByteLead = 0xF0
	let LeadCeiling = 0xF5
	let TwoByteLeadMask = 0x1F
	let ThreeByteLeadMask = 0x0F
	let FourByteLeadMask = 0x07
	let ThreeByteOverlongSecondFloor = 0xA0
	let SurrogateRangeLead = 0xED
	let SurrogateRangeSecondCeiling = 0x9F
	let FourByteOverlongSecondFloor = 0x90
	let FourByteLastLead = 0xF4
	let FourByteLastSecondCeiling = 0x8F
	let TwoByteCeiling = 0x800
	let BasicPlaneCeiling = 0x10000
	let ReplacementCodepoint = 0xFFFD
	let HighSurrogateFloor = 0xD800
	let HighSurrogateCeiling = 0xDBFF
	let LowSurrogateFloor = 0xDC00
	let LowSurrogateCeiling = 0xDFFF
	let SurrogatePayloadBits = 10
	let SurrogatePayloadMask = 0x3FF
	let ExtendedPathThresholdUnits = 248
	let ExtendedPrefixUnits = 4
	let ExtendedUncPrefixUnits = 8
	let UncSkippedUnits = 2
	let ExtendedPathSlackUnits = ExtendedUncPrefixUnits - UncSkippedUnits
	let RootProbeUnits = 3
	let BackslashUnit = 0x5C
	let SlashUnit = 0x2F
	let ColonUnit = 0x3A
	let QuestionUnit = 0x3F
	let DotUnit = 0x2E
	let UpperCaseUnit = 0x55
	let UpperCaseNUnit = 0x4E
	let UpperCaseCUnit = 0x43
	let AsciiCaseBit = 0x20
	let AsciiLowerA = 0x61
	let AsciiLowerZ = 0x7A

	enum WidePathRoot
		relative
		drive
		unc
		device
	end 'WidePathRoot'

	function wideTextByte(src WideTextWord, index WideTextWord) returns WideTextWord
		return __Raw.loadByte((src + index) as MachineWord, offset: 0) as WideTextWord
	end 'wideTextByte'

	function wideTextUnit(src WideTextWord, index WideTextWord) returns WideTextWord
		let address = src + (index * WideUnitBytes)

		return (__Raw.loadByte(address as MachineWord, offset: 0) as WideTextWord) or ((__Raw.loadByte(address as MachineWord, offset: 1) as WideTextWord) shl ByteBits)
	end 'wideTextUnit'

	function wideTextUnitOfWidth(src WideTextWord, index WideTextWord, unitBytes WideTextWord) returns WideTextWord
		if unitBytes == NarrowUnitBytes 'narrow'
			return wideTextByte(src, index: index)
		end 'narrow'

		return wideTextUnit(src, index: index)
	end 'wideTextUnitOfWidth'

	function wideTextStoreByte(dst WideTextWord, index WideTextWord, value WideTextWord)
		if dst != 0 'writing'
			__Raw.storeByte((dst + index) as MachineWord, offset: 0, value: (value and ByteMask) as MachineWord)
		end 'writing'
	end 'wideTextStoreByte'

	function wideTextStoreUnit(dst WideTextWord, index WideTextWord, value WideTextWord)
		let address = index * WideUnitBytes

		wideTextStoreByte(dst, index: address, value: value)
		wideTextStoreByte(dst, index: address + 1, value: value shr ByteBits)
	end 'wideTextStoreUnit'

	function wideTextContinuationAt(src WideTextWord, index WideTextWord, byteLen WideTextWord, lowest WideTextWord, highest WideTextWord) returns bool
		if index >= byteLen 'truncated'
			return false
		end 'truncated'

		let value = wideTextByte(src, index: index)

		return value >= lowest and value <= highest
	end 'wideTextContinuationAt'

	function wideTextSequenceWidth(src WideTextWord, index WideTextWord, byteLen WideTextWord) returns WideTextWord
		let lead = wideTextByte(src, index: index)

		if lead < AsciiLimit 'ascii'
			return 1
		end 'ascii'

		if lead < TwoByteLeadFloor 'strayOrOverlong'
			return 0
		end 'strayOrOverlong'

		if lead < ThreeByteLead 'twoByte'
			if wideTextContinuationAt(src, index: index + 1, byteLen: byteLen, lowest: ContinuationFloor, highest: ContinuationCeiling) 'complete'
				return 2
			end 'complete'

			return 0
		end 'twoByte'

		if lead < FourByteLead 'threeByte'
			let secondLowest = ThreeByteOverlongSecondFloor if lead == ThreeByteLead else ContinuationFloor
			let secondHighest = SurrogateRangeSecondCeiling if lead == SurrogateRangeLead else ContinuationCeiling

			if wideTextContinuationAt(src, index: index + 1, byteLen: byteLen, lowest: secondLowest, highest: secondHighest) and wideTextContinuationAt(src, index: index + 2, byteLen: byteLen, lowest: ContinuationFloor, highest: ContinuationCeiling) 'complete'
				return 3
			end 'complete'

			return 0
		end 'threeByte'

		if lead < LeadCeiling 'fourByte'
			let secondLowest = FourByteOverlongSecondFloor if lead == FourByteLead else ContinuationFloor
			let secondHighest = FourByteLastSecondCeiling if lead == FourByteLastLead else ContinuationCeiling

			if wideTextContinuationAt(src, index: index + 1, byteLen: byteLen, lowest: secondLowest, highest: secondHighest) and wideTextContinuationAt(src, index: index + 2, byteLen: byteLen, lowest: ContinuationFloor, highest: ContinuationCeiling) and wideTextContinuationAt(src, index: index + 3, byteLen: byteLen, lowest: ContinuationFloor, highest: ContinuationCeiling) 'complete'
				return 4
			end 'complete'

			return 0
		end 'fourByte'

		return 0
	end 'wideTextSequenceWidth'

	function wideTextPayload(src WideTextWord, index WideTextWord) returns WideTextWord
		return wideTextByte(src, index: index) and ContinuationPayloadMask
	end 'wideTextPayload'

	function wideTextCodepoint(src WideTextWord, index WideTextWord, width WideTextWord) returns WideTextWord
		let lead = wideTextByte(src, index: index)

		if width == 1 'oneByte'
			return lead
		end 'oneByte'

		if width == 2 'twoByte'
			return ((lead and TwoByteLeadMask) shl ContinuationPayloadBits) or wideTextPayload(src, index: index + 1)
		end 'twoByte'

		if width == 3 'threeByte'
			return ((lead and ThreeByteLeadMask) shl (ContinuationPayloadBits * 2)) or (wideTextPayload(src, index: index + 1) shl ContinuationPayloadBits) or wideTextPayload(src, index: index + 2)
		end 'threeByte'

		return ((lead and FourByteLeadMask) shl (ContinuationPayloadBits * 3)) or (wideTextPayload(src, index: index + 1) shl (ContinuationPayloadBits * 2)) or (wideTextPayload(src, index: index + 2) shl ContinuationPayloadBits) or wideTextPayload(src, index: index + 3)
	end 'wideTextCodepoint'

	function wideTextStoreCodepointUnits(dst WideTextWord, written WideTextWord, codepoint WideTextWord) returns WideTextWord
		if codepoint < BasicPlaneCeiling 'basic'
			wideTextStoreUnit(dst, index: written, value: codepoint)

			return written + 1
		end 'basic'

		let beyondBasic = codepoint - BasicPlaneCeiling

		wideTextStoreUnit(dst, index: written, value: HighSurrogateFloor + (beyondBasic shr SurrogatePayloadBits))
		wideTextStoreUnit(dst, index: written + 1, value: LowSurrogateFloor + (beyondBasic and SurrogatePayloadMask))

		return written + 2
	end 'wideTextStoreCodepointUnits'

	function wideTextStoreCodepointBytes(dst WideTextWord, written WideTextWord, codepoint WideTextWord) returns WideTextWord
		if codepoint < AsciiLimit 'oneByte'
			wideTextStoreByte(dst, index: written, value: codepoint)

			return written + 1
		end 'oneByte'

		if codepoint < TwoByteCeiling 'twoByte'
			wideTextStoreByte(dst, index: written, value: TwoByteLead or (codepoint shr ContinuationPayloadBits))
			wideTextStoreByte(dst, index: written + 1, value: ContinuationFloor or (codepoint and ContinuationPayloadMask))

			return written + 2
		end 'twoByte'

		if codepoint < BasicPlaneCeiling 'threeByte'
			wideTextStoreByte(dst, index: written, value: ThreeByteLead or (codepoint shr (ContinuationPayloadBits * 2)))
			wideTextStoreByte(dst, index: written + 1, value: ContinuationFloor or ((codepoint shr ContinuationPayloadBits) and ContinuationPayloadMask))
			wideTextStoreByte(dst, index: written + 2, value: ContinuationFloor or (codepoint and ContinuationPayloadMask))

			return written + 3
		end 'threeByte'

		wideTextStoreByte(dst, index: written, value: FourByteLead or (codepoint shr (ContinuationPayloadBits * 3)))
		wideTextStoreByte(dst, index: written + 1, value: ContinuationFloor or ((codepoint shr (ContinuationPayloadBits * 2)) and ContinuationPayloadMask))
		wideTextStoreByte(dst, index: written + 2, value: ContinuationFloor or ((codepoint shr ContinuationPayloadBits) and ContinuationPayloadMask))
		wideTextStoreByte(dst, index: written + 3, value: ContinuationFloor or (codepoint and ContinuationPayloadMask))

		return written + 4
	end 'wideTextStoreCodepointBytes'

	function __wt_widen(src WideTextWord, byteLen WideTextWord, dst WideTextWord) returns WideTextWord
		var index = 0 as WideTextWord
		var written = 0 as WideTextWord

		while index < byteLen 'each'
			let sequence = wideTextSequenceWidth(src, index: index, byteLen: byteLen)
			let consumed = 1 if sequence == 0 else sequence
			let codepoint = ReplacementCodepoint if sequence == 0 else wideTextCodepoint(src, index: index, width: sequence)

			written = wideTextStoreCodepointUnits(dst, written: written, codepoint: codepoint)
			index = index + consumed
		end 'each'

		wideTextStoreUnit(dst, index: written, value: 0)

		return written
	end '__wt_widen'

	function widePathIsSeparator(unit WideTextWord) returns bool
		return unit == BackslashUnit or unit == SlashUnit
	end 'widePathIsSeparator'

	function widePathIsDriveLetter(unit WideTextWord) returns bool
		let folded = unit or AsciiCaseBit

		return folded >= AsciiLowerA and folded <= AsciiLowerZ
	end 'widePathIsDriveLetter'

	function widePathHasDevicePrefix(text WideTextWord, units WideTextWord) returns bool
		if units < ExtendedPrefixUnits 'tooShort'
			return false
		end 'tooShort'

		let marker = wideTextUnit(text, index: 2)

		return wideTextUnit(text, index: 0) == BackslashUnit and wideTextUnit(text, index: 1) == BackslashUnit and (marker == QuestionUnit or marker == DotUnit) and wideTextUnit(text, index: 3) == BackslashUnit
	end 'widePathHasDevicePrefix'

	function widePathRootOf(text WideTextWord, units WideTextWord) returns WidePathRoot
		if widePathHasDevicePrefix(text, units: units) 'device'
			return WidePathRoot.device
		end 'device'

		if units < RootProbeUnits 'tooShort'
			return WidePathRoot.relative
		end 'tooShort'

		let first = wideTextUnit(text, index: 0)
		let second = wideTextUnit(text, index: 1)
		let third = wideTextUnit(text, index: 2)

		if widePathIsSeparator(first) and widePathIsSeparator(second) 'network'
			return WidePathRoot.unc
		end 'network'

		if widePathIsDriveLetter(first) and second == ColonUnit and widePathIsSeparator(third) 'driveRoot'
			return WidePathRoot.drive
		end 'driveRoot'

		return WidePathRoot.relative
	end 'widePathRootOf'

	function widePathStorePrefix(text WideTextWord, root WidePathRoot)
		wideTextStoreUnit(text, index: 0, value: BackslashUnit)
		wideTextStoreUnit(text, index: 1, value: BackslashUnit)
		wideTextStoreUnit(text, index: 2, value: QuestionUnit)
		wideTextStoreUnit(text, index: 3, value: BackslashUnit)

		if root == WidePathRoot.unc 'uncSpelling'
			wideTextStoreUnit(text, index: ExtendedPrefixUnits, value: UpperCaseUnit)
			wideTextStoreUnit(text, index: ExtendedPrefixUnits + 1, value: UpperCaseNUnit)
			wideTextStoreUnit(text, index: ExtendedPrefixUnits + 2, value: UpperCaseCUnit)
			wideTextStoreUnit(text, index: ExtendedPrefixUnits + 3, value: BackslashUnit)
		end 'uncSpelling'
	end 'widePathStorePrefix'

	function widePathSkippedUnits(root WidePathRoot) returns WideTextWord
		if root == WidePathRoot.unc 'uncSpelling'
			return UncSkippedUnits
		end 'uncSpelling'

		return 0
	end 'widePathSkippedUnits'

	function widePathExtensionShift(root WidePathRoot) returns WideTextWord
		let prefixUnits = ExtendedUncPrefixUnits if root == WidePathRoot.unc else ExtendedPrefixUnits

		return prefixUnits - widePathSkippedUnits(root)
	end 'widePathExtensionShift'

	function widePathExtend(text WideTextWord, units WideTextWord, root WidePathRoot)
		let skipped = widePathSkippedUnits(root)
		let shift = widePathExtensionShift(root)
		var index = units

		while index >= skipped 'eachUnitRightward'
			wideTextStoreUnit(text, index: index + shift, value: wideTextUnit(text, index: index))
			index = index - 1
		end 'eachUnitRightward'

		widePathStorePrefix(text, root: root)
	end 'widePathExtend'

	// A verbatim or device path is never resolved: `GetFullPathNameW` collapses `..` even inside
	// `\\?\`, which would change the path's meaning.
	function __wt_path_needs_resolution(text WideTextWord, units WideTextWord) returns bool
		let root = widePathRootOf(text, units: units)

		if root == WidePathRoot.device 'verbatimOrDevice'
			return false
		end 'verbatimOrDevice'

		return units >= ExtendedPathThresholdUnits or root == WidePathRoot.relative
	end '__wt_path_needs_resolution'

	function __wt_path_extension_fits(written WideTextWord, capacity WideTextWord) returns bool
		if written >= capacity 'tooSmall'
			return false
		end 'tooSmall'

		return written < ExtendedPathThresholdUnits or written + ExtendedPathSlackUnits < capacity
	end '__wt_path_extension_fits'

	function __wt_extend_resolved(text WideTextWord, units WideTextWord, capacity WideTextWord) returns bool
		if units < ExtendedPathThresholdUnits 'short'
			return true
		end 'short'

		let root = widePathRootOf(text, units: units)

		if root == WidePathRoot.device 'alreadyExtended'
			return true
		end 'alreadyExtended'

		if root == WidePathRoot.relative 'unresolved'
			return false
		end 'unresolved'

		if units + widePathExtensionShift(root) >= capacity 'noRoom'
			return false
		end 'noRoom'

		widePathExtend(text, units: units, root: root)

		return true
	end '__wt_extend_resolved'

	function __wt_narrow(src WideTextWord, units WideTextWord, dst WideTextWord) returns WideTextWord
		var index = 0 as WideTextWord
		var written = 0 as WideTextWord

		while index < units 'each'
			let unit = wideTextUnit(src, index: index)
			var codepoint = unit
			var consumed = 1 as WideTextWord

			if unit >= HighSurrogateFloor and unit <= LowSurrogateCeiling 'surrogate'
				codepoint = ReplacementCodepoint

				if unit <= HighSurrogateCeiling and index + 1 < units 'canPair'
					let following = wideTextUnit(src, index: index + 1)

					if following >= LowSurrogateFloor and following <= LowSurrogateCeiling 'paired'
						codepoint = BasicPlaneCeiling + ((unit - HighSurrogateFloor) shl SurrogatePayloadBits) + (following - LowSurrogateFloor)
						consumed = 2
					end 'paired'
				end 'canPair'
			end 'surrogate'

			written = wideTextStoreCodepointBytes(dst, written: written, codepoint: codepoint)
			index = index + consumed
		end 'each'

		wideTextStoreByte(dst, index: written, value: 0)

		return written
	end '__wt_narrow'

	// One byte per unit, so the value fits the caller's `capacity`-byte buffer. Its callers parse
	// ASCII grammars, and 0xFF is a byte none of them accepts.
	function __wt_narrow_ascii(src WideTextWord, units WideTextWord, dst WideTextWord, capacity WideTextWord)
		let count = units if units < capacity else 0
		var index = 0 as WideTextWord

		while index < count 'each'
			let unit = wideTextUnit(src, index: index)

			wideTextStoreByte(dst, index: index, value: unit if unit < AsciiLimit else NonAsciiByte)
			index = index + 1
		end 'each'

		wideTextStoreByte(dst, index: count, value: 0)
	end '__wt_narrow_ascii'

	function __wt_text_length(src WideTextWord, unitBytes WideTextWord) returns WideTextWord
		var index = 0 as WideTextWord

		while wideTextUnitOfWidth(src, index: index, unitBytes: unitBytes) != 0 'each'
			index = index + 1
		end 'each'

		return index
	end '__wt_text_length'

	function __wt_block_extent(src WideTextWord) returns WideTextWord
		var index = 0 as WideTextWord

		while wideTextByte(src, index: index) != 0 'entries'
			index = index + __wt_text_length(src + index, unitBytes: NarrowUnitBytes) + 1
		end 'entries'

		return index + 1
	end '__wt_block_extent'
#endif
