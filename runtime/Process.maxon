// The process-control entry points a program reaches through `__Builtins.currentProcessId()`,
// `__Builtins.enterBackgroundPriority()` and `__Builtins.processIsAlive()`.
//
// Each entry answers its own host facility, and that split decides which targets may run it: a lane
// can serve the identity read long before the priority write, because a POSIX `setpriority` scopes
// to the process on Darwin and to the calling thread on Linux.
// `TargetFacilities.calleeHostFacility` names `__proc_bg_priority` and `__proc_alive` individually,
// ahead of the `__proc_` band that answers `processInfo`.
//
// `__proc_exe_path` is IR the compiler builds (`Compiler/Runtime/ProcessRuntime.maxon`), not tier
// source. Its body allocates and builds an `__ManagedMemory`, so here it would call other runtime
// entries, and `scanRuntimeUsage` walks every runtime body in every program: that call would set
// its family's bit for a program dead-function elimination sweeps the body out of.

module typealias ProcessId = int(0 to u64.max)

typealias ProbeWord = int(i64.min to i64.max)

let HighestProbedProcessId = 2147483647 as ProbeWord

#if os(Windows)
	let ProcessIdGranuleMask = 3 as ProbeWord
	let NoHandle = 0 as ProbeWord
	let ErrorInvalidParameter = 87 as ProbeWord
	let WaitTimeout = 0x102 as ProbeWord
	let NoWaitMs = 0 as ProbeWord
#else
	let ProbeNoSuchProcess = -3 as ProbeWord
#endif

// ⭐⭐ **`__proc_pid()` — THE OS-ASSIGNED ID OF THE RUNNING PROCESS.**
//
// ⚠ **THERE IS NO RETRY, NO FAILURE ARM AND NO BUFFER.** `GetCurrentProcessId` and `getpid` both read a
// value the kernel already holds, cannot fail, have no out-parameter and answer the same 32-bit id on every
// call in a process. The op is nevertheless not pure — it is a call, and the backends need the call
// barrier's clobber accounting — so two reads in one function are two calls, which
// `specs/process-id.md:is-stable-across-calls` asserts agree rather than assuming.
module function __proc_pid() returns ProcessId
	return __Raw.osGetPid() as ProcessId
end '__proc_pid'

// ⭐⭐ **`__proc_bg_priority()` — DROP THIS PROCESS TO BACKGROUND SCHEDULING PRIORITY AND ANSWER WHAT THE
// OS THEN REPORTS.**
//
// ⭐ **WHY A PROCESS-WIDE CALL AND NOT A PER-THREAD OR PER-CHILD ONE.** A child inherits the priority class
// on Windows and the nice value under POSIX, so ONE call at a harness's startup covers every worker
// subprocess it spawns AND every test binary those workers launch. A per-child variant would be the same
// fact spelled once per spawn site, and would miss the threads this process runs itself.
//
// ⚠ **THE ANSWER IS A SECOND READING, NOT AN ECHO** — see `StdOp.osEnterBackgroundPriority`, which owns
// that argument and the measurement behind it.
// ⚠ **IT ANSWERS A `MachineWord` WHERE `__proc_pid` ANSWERS A `ProcessId`, AND THE ASYMMETRY IS THE
// VALUE'S.** A priority is whatever unit the platform keeps — a Windows priority CLASS against a POSIX
// NICE value, on scales that run in opposite directions and one of which is legitimately negative. There
// is no non-negative domain to narrow it to; an id has one.
module function __proc_bg_priority() returns MachineWord
	return __Raw.osEnterBackgroundPriority()
end '__proc_bg_priority'

// A probe refused for any reason but "no such process" names a process that exists and is not ours
// to open or signal, so it answers alive.
module function __proc_alive(pid ProbeWord) returns bool
	// To `kill`, zero and negative ids name process groups; both hosts truncate the word to 32 bits,
	// so a wider one would probe some other id.
	if pid <= 0 or pid > HighestProbedProcessId 'noProcessHasThisId'
		return false
	end 'noProcessHasThisId'

	#if os(Windows)
		// The kernel ignores a process id's low two bits, so an id with them set would open the process
		// at the multiple of four below it.
		if (pid and ProcessIdGranuleMask) != 0 'notAProcessId'
			return false
		end 'notAProcessId'

		// The probe answers the opened handle, or the negated `GetLastError` of a refused open.
		let answer = __Raw.osProcessProbe(pid as MachineWord) as ProbeWord

		if answer <= NoHandle 'notOpened'
			return NoHandle - answer != ErrorInvalidParameter
		end 'notOpened'

		// An exited process stays openable while any handle to it is held, so only a wait that times out
		// proves it is still running.
		let waited = __Raw.osWaitHandle(answer as MachineWord, timeoutMs: NoWaitMs as MachineWord) as ProbeWord
		__Raw.osCloseHandle(answer as MachineWord)

		return waited == WaitTimeout
	#else
		return __Raw.osProcessProbe(pid as MachineWord) as ProbeWord != ProbeNoSuchProcess
	#endif
end '__proc_alive'
