// Near `.text` so a displaced pc-relative operand can still reach its referent from a slot; one
// that cannot is refused by `dbgSetBreakpoint`'s reach check.
function dbgSlotPoolNear(textBase DbgWord) returns DbgWord
	let lowestReachable = textBase - DbgSlotPoolReach
	var candidate = textBase - (textBase and (DbgAllocationGranule - 1)) - DbgAllocationGranule

	while candidate > lowestReachable and candidate > 0 'eachCandidate'
		let pool = __Raw.osDebugHost(DbgVerbAllocExecPages, a0: DbgSlotPoolBytes as MachineWord, a1: candidate as MachineWord, a2: DbgNothing, a3: DbgNothing) as DbgWord

		if pool != 0 'placed'
			return pool
		end 'placed'

		candidate = candidate - DbgAllocationGranule
	end 'eachCandidate'

	return __Raw.osDebugHost(DbgVerbAllocExecPages, a0: DbgSlotPoolBytes as MachineWord, a1: DbgNothing, a2: DbgNothing, a3: DbgNothing) as DbgWord
end 'dbgSlotPoolNear'

// Every program reaches this before `main`. The dark path — nothing named in `MAXON_DEBUG` — is one
// environment lookup and a return: no page is opened or mapped ahead of a name.
//
// The variable's own name is assembled in scratch rather than spelled as a literal, which would put its
// bytes in every program's `.rdata`.
module function __dbg_init()
	let nameBuffer = __Raw.scratch(DbgEnvNameBufferBytes)
	__Raw.storeWord(nameBuffer, offset: 0, value: DbgEnvNameWord0 as MachineWord)
	__Raw.storeWord(nameBuffer, offset: DbgWordBytes, value: DbgEnvNameWord1 as MachineWord)
	let valueBuffer = __Raw.scratch(DbgSegmentNameBytes)
	__Raw.storeByte(valueBuffer, offset: 0, value: DbgNothing)

	let nameCharacters = __Raw.dbgEnvironmentValue(nameBuffer, valueBuffer: valueBuffer, valueBytes: DbgSegmentNameBytes as MachineWord) as DbgWord

	if nameCharacters == 0 'noDebuggerNamedASegment'
		return
	end 'noDebuggerNamedASegment'

	let base = __Raw.dbgAttachSegment(nameBuffer, valueBuffer: valueBuffer, valueBytes: DbgSegmentNameBytes as MachineWord, segmentBytes: DbgSegmentBytes as MachineWord) as DbgWord

	if base == 0 'nothingMapped'
		return
	end 'nothingMapped'

	if dbgLoad(base, offset: DbgOffMagic) != DbgMagic 'notOurSegment'
		return
	end 'notOurSegment'

	dbgStore(base, offset: DbgOffAgentVersion, value: DbgLayoutVersion)

	if dbgLoad(base, offset: DbgOffDriverVersion) != DbgLayoutVersion 'unknownDriver'
		return
	end 'unknownDriver'

	let private = __Raw.osAllocPages(DbgPrivBytes as MachineWord) as DbgWord

	if private <= 0 'noPrivateBlock'
		return
	end 'noPrivateBlock'

	// The displaced instructions live in pages of their own rather than in a chunk of `.text`: anything
	// inside the image sits within `__symtable`'s range and is walked as the program's own code.
	let textBase = __Raw.dbgTextBase() as DbgWord
	let pool = dbgSlotPoolNear(textBase)

	if pool == 0 'noSlotPool'
		return
	end 'noSlotPool'

	let textSize = (__Raw.dbgTextLimit() as DbgWord) - textBase
	let plantedMap = __Raw.osAllocPages(((textSize shr DbgPlantedMapShift) + 1) as MachineWord) as DbgWord

	if plantedMap <= 0 'noPlantedMap'
		return
	end 'noPlantedMap'

	dbgWriteSlotTails(pool)
	dbgStore(private, offset: DbgPrivOffAgentSp, value: private + DbgPrivBytes - DbgAgentShadowBytes)
	dbgStore(private, offset: DbgPrivOffSlotPoolBase, value: pool)
	dbgStore(private, offset: DbgPrivOffPlantedMap, value: plantedMap)
	dbgStore(private, offset: DbgPrivOffResumeAction, value: DbgResumeContinue)

	let driverHandle = __Raw.osDebugHost(DbgVerbOpenDriverProcess, a0: dbgLoad(base, offset: DbgOffDriverPid) as MachineWord, a1: DbgNothing, a2: DbgNothing, a3: DbgNothing) as DbgWord

	if driverHandle == 0 'theDriverIsAlreadyGone'
		return
	end 'theDriverIsAlreadyGone'

	dbgStore(private, offset: DbgPrivOffDriverHandle, value: driverHandle)
	dbgStore(base, offset: DbgOffTextBase, value: textBase)
	dbgStore(base, offset: DbgOffTextSize, value: textSize)
	dbgStore(base, offset: DbgOffAgentPid, value: __Raw.osDebugHost(DbgVerbProcessId, a0: DbgNothing, a1: DbgNothing, a2: DbgNothing, a3: DbgNothing) as DbgWord)
	dbgStore(base, offset: DbgOffAgentPrivate, value: private)

	let mainThreadId = __Raw.osDebugHost(DbgVerbCurrentThreadId, a0: DbgNothing, a1: DbgNothing, a2: DbgNothing, a3: DbgNothing) as DbgWord
	dbgStore(private, offset: DbgPrivOffMainThreadId, value: mainThreadId)
	dbgStore(private, offset: DbgPrivOffMainThreadHandle, value: __Raw.osDebugHost(DbgVerbOpenThread, a0: mainThreadId as MachineWord, a1: DbgNothing, a2: DbgNothing, a3: DbgNothing) as DbgWord)

	let trampoline = __Raw.osDebugHost(DbgVerbAllocExecPages, a0: DbgPauseTrampolineBytes as MachineWord, a1: DbgNothing, a2: DbgNothing, a3: DbgNothing) as DbgWord

	if trampoline == 0 'noTrampoline'
		return
	end 'noTrampoline'

	dbgStoreByte(trampoline, offset: 0, value: DbgBreakpointByte)
	dbgFlushCode(trampoline, length: DbgPauseTrampolineBytes)
	dbgStore(private, offset: DbgPrivOffPauseTrampoline, value: trampoline)

	__Raw.storeWord(__Raw.dbgCtlAddr(), offset: 0, value: base as MachineWord)
	dbgSinkHostAnswer(__Raw.osDebugHost(DbgVerbInstallTrapHandler, a0: DbgNothing, a1: DbgNothing, a2: DbgNothing, a3: DbgNothing))

	dbgStore(private, offset: DbgPrivOffServiceThread, value: __Raw.osThreadCreate(__Raw.dbgServiceEntryAddr(), arg: DbgNothing) as DbgWord)

	dbgStore(base, offset: DbgOffFlags, value: DbgFlagAgentAlive)

	if dbgLoad(base, offset: DbgOffStopAtEntry) == DbgStopAtEntryYes 'parkBeforeMain'
		dbgTakeStopLock(private)
		dbgStopTheWorld(private)
		dbgPublishStop(base, reason: DbgStopReasonEntry, fault: DbgNoFault, conditionMissed: false)
		dbgPark(base, private: private, stopKind: DbgStopKindNoThread)
		dbgStartTheWorld(private)
		dbgDropStopLock(private)
	end 'parkBeforeMain'
end '__dbg_init'

// The agent's own OS thread: not a machine, holding no TLS slot and calling no scheduler door. It is the
// only servicer while nothing is parked, and the stop lock the park holds excludes it, so a command is
// answered by exactly one of the two and never by both.
module function __dbg_service_loop() returns MachineWord
	var running = true

	while running 'poll'
		let base = dbgControlSegment()

		if base == 0 'nothingAttached'
			running = false
			continue
		end 'nothingAttached'

		let private = dbgPrivateBlock()

		if dbgLoad(private, offset: DbgPrivOffPauseAttempts) > 0 'aPauseIsInFlight'
			dbgAdvancePause(base, private: private)
		end 'aPauseIsInFlight' else 'theMailbox'
			dbgServiceMailbox(base, private: private)
		end 'theMailbox'

		if __Raw.osDebugHost(DbgVerbDriverExited, a0: dbgLoad(private, offset: DbgPrivOffDriverHandle) as MachineWord, a1: DbgNothing, a2: DbgNothing, a3: DbgNothing) as DbgWord == DbgWaitSignalled 'theDriverIsGone'
			dbgExitOrphaned(private)
		end 'theDriverIsGone'

		dbgSinkHostAnswer(__Raw.osDebugHost(DbgVerbParkWait, a0: DbgParkPollIntervalMs as MachineWord, a1: DbgNothing, a2: DbgNothing, a3: DbgNothing))
	end 'poll'

	return DbgNothing
end '__dbg_service_loop'

// A record is registered by address, never by identity: the recycle doors zero it, so a life is derived at
// every read rather than stored here. The caller holds `__sched_lock`, and the count is published last, so
// a reader that takes no lock sees a whole entry or none of it.
module function __dbg_gt_carved(record MachineWord)
	let base = dbgControlSegment()

	if base == 0 'dark'
		return
	end 'dark'

	let private = dbgPrivateBlock()
	let count = dbgLoad(private, offset: DbgPrivOffRosterCount)

	if count >= DbgGtRosterCapacity 'full'
		dbgStore(private, offset: DbgPrivOffRosterTruncated, value: 1)
		return
	end 'full'

	dbgStore(private + DbgPrivOffGtRoster + count * DbgWordBytes, offset: 0, value: record as DbgWord)
	dbgStore(private, offset: DbgPrivOffRosterCount, value: count + 1)
end '__dbg_gt_carved'

// This answers; it moves nothing. The scheduler is what puts a refused candidate back — see
// `GtRuntime.emitDebugAgentHoldGate`, which owns that rule.
module function __dbg_gt_should_hold(gt MachineWord) returns MachineWord
	let base = dbgControlSegment()

	if base == 0 'dark'
		return DbgNothing
	end 'dark'

	let private = dbgPrivateBlock()

	if dbgLoad(private, offset: DbgPrivOffHoldsPlaced) == 0 'nothingIsHeldAtAll'
		return DbgNothing
	end 'nothingIsHeldAtAll'

	if not dbgHoldsThisLife(private, gt: gt as DbgWord) 'notHeldInThisLife'
		return DbgNothing
	end 'notHeldInThisLife'

	return 1 as MachineWord
end '__dbg_gt_should_hold'

module function __dbg_trap_planted_at(address MachineWord) returns MachineWord
	let base = dbgControlSegment()

	if base == 0 'dark'
		return DbgNothing
	end 'dark'

	let textOffset = (address as DbgWord) - dbgLoad(base, offset: DbgOffTextBase)

	if textOffset < 0 or textOffset >= dbgLoad(base, offset: DbgOffTextSize) 'outsideTheCode'
		return DbgNothing
	end 'outsideTheCode'

	if (dbgLoadByte(dbgPlantedMapByte(dbgPrivateBlock(), textOffset: textOffset), offset: 0) and dbgPlantedBitOf(textOffset)) == 0 'neverPlantedThere'
		return DbgNothing
	end 'neverPlantedThere'

	return DbgTrapPlanted
end '__dbg_trap_planted_at'

function dbgPlantedMapByte(private DbgWord, textOffset DbgWord) returns DbgWord
	return dbgLoad(private, offset: DbgPrivOffPlantedMap) + (textOffset shr DbgPlantedMapShift)
end 'dbgPlantedMapByte'

function dbgPlantedBitOf(textOffset DbgWord) returns DbgWord
	var remaining = textOffset and (DbgPlantedBitsPerByte - 1)
	var bit = 1 as DbgWord

	while remaining > 0 'eachDoubling'
		bit = bit + bit
		remaining = remaining - 1
	end 'eachDoubling'

	return bit
end 'dbgPlantedBitOf'

function dbgMarkPlanted(private DbgWord, textOffset DbgWord)
	let at = dbgPlantedMapByte(private, textOffset: textOffset)
	dbgStoreByte(at, offset: 0, value: dbgLoadByte(at, offset: 0) or dbgPlantedBitOf(textOffset))
end 'dbgMarkPlanted'

// The one agent-owned stack, handed out under a lock spun here over the compare-and-swap the encoder
// already emits, so serializing two stopped machines asks nothing new of it. The claim runs on the
// trapping thread's own stack, inside the reserve `requireDebugTrapFitsItsReserve` certifies.
module function __dbg_claim_stack() returns MachineWord
	let private = dbgPrivateBlock()

	// A thread that traps again while it owns the stop would spin on its own lock for ever. The
	// decline passes the exception on, and the world is let go first so a handler that ends the
	// process can take the locks the stop holds (see `dbgExitOrphaned`).
	if dbgLoad(private, offset: DbgPrivOffStopLockOwner) == dbgCurrentThreadId() 'thisThreadAlreadyOwnsTheStop'
		dbgLetGoOfTheWorld(private)
		return DbgClaimDeclined as MachineWord
	end 'thisThreadAlreadyOwnsTheStop'

	// `dbgStopTheWorld` takes the suspend window first, so a thread holding it would spin for ever.
	if (__Raw.loadWord(__Raw.schedPreemptExtLockAddr(), offset: 0) as DbgWord) == dbgCurrentThreadId() 'thisThreadHoldsTheSuspendWindow'
		return DbgClaimDeclined as MachineWord
	end 'thisThreadHoldsTheSuspendWindow'

	dbgTakeStopLock(private)
	return dbgLoad(private, offset: DbgPrivOffAgentSp) as MachineWord
end '__dbg_claim_stack'

module function __dbg_release_stack()
	dbgDropStopLock(dbgPrivateBlock())
end '__dbg_release_stack'

// The same lock the service thread takes, which is what makes the two servicers one: a parked stop holds it
// for the whole park, so the thread's poll finds it taken and answers nothing while a machine is stopped.
function dbgTakeStopLock(private DbgWord)
	while not dbgTryStopLock(private) 'spin'
		dbgSinkHostAnswer(__Raw.osDebugHost(DbgVerbParkWait, a0: DbgParkPollIntervalMs as MachineWord, a1: DbgNothing, a2: DbgNothing, a3: DbgNothing))
	end 'spin'
end 'dbgTakeStopLock'

// The owner is cleared before the lock is freed, or it could erase the next taker's claim.
function dbgDropStopLock(private DbgWord)
	dbgStore(private, offset: DbgPrivOffStopLockOwner, value: DbgNoOwner)
	dbgStore(private, offset: DbgPrivOffStopLock, value: DbgLockFree)
end 'dbgDropStopLock'

function dbgTryStopLock(private DbgWord) returns bool
	if __Raw.atomicCas((private + DbgPrivOffStopLock) as MachineWord, expected: DbgLockFree as MachineWord, replacement: DbgLockHeld as MachineWord) == DbgNothing 'anotherThreadHoldsIt'
		return false
	end 'anotherThreadHoldsIt'

	dbgStore(private, offset: DbgPrivOffStopLockOwner, value: dbgCurrentThreadId())
	return true
end 'dbgTryStopLock'

function dbgCurrentThreadId() returns DbgWord
	return __Raw.osDebugHost(DbgVerbCurrentThreadId, a0: DbgNothing, a1: DbgNothing, a2: DbgNothing, a3: DbgNothing) as DbgWord
end 'dbgCurrentThreadId'

// Zero here is the whole answer to whether there is a scheduler: the slot is laid out in every program the
// agent ships in, and only `__sched_init_procs` ever writes it.
function dbgTlsTebOffset() returns DbgWord
	return __Raw.loadWord(__Raw.schedTlsTebOffsetAddr(), offset: 0) as DbgWord
end 'dbgTlsTebOffset'

function dbgCurrentMachine() returns DbgWord
	let tebOffset = dbgTlsTebOffset()

	if tebOffset == 0 'noScheduler'
		return 0
	end 'noScheduler'

	return __Raw.tlsSlotLoad(tebOffset as MachineWord) as DbgWord
end 'dbgCurrentMachine'

function dbgAllMachines() returns DbgWord
	if dbgTlsTebOffset() == 0 'noScheduler'
		return 0
	end 'noScheduler'

	return __Raw.loadWord(__Raw.schedAllMachinesAddr(), offset: 0) as DbgWord
end 'dbgAllMachines'

function dbgTryTakeExtLock() returns bool
	return __Raw.atomicCas(__Raw.schedPreemptExtLockAddr(), expected: DbgPreemptClaimFree as MachineWord, replacement: dbgCurrentThreadId() as MachineWord) != DbgNothing
end 'dbgTryTakeExtLock'

function dbgTakeExtLock()
	while not dbgTryTakeExtLock() 'spin'
		dbgSinkHostAnswer(__Raw.osDebugHost(DbgVerbParkWait, a0: DbgParkPollIntervalMs as MachineWord, a1: DbgNothing, a2: DbgNothing, a3: DbgNothing))
	end 'spin'
end 'dbgTakeExtLock'

function dbgDropExtLock()
	__Raw.storeWord(__Raw.schedPreemptExtLockAddr(), offset: 0, value: DbgPreemptClaimFree as MachineWord)
end 'dbgDropExtLock'

// Zero until `__gt_init` builds it, which is also the answer to whether a machine can be born: nothing can
// start one before the scheduler exists.
function dbgSchedLock() returns DbgWord
	return __Raw.loadWord(__Raw.schedLockAddr(), offset: 0) as DbgWord
end 'dbgSchedLock'

// Holding this is what makes the machine walk complete: `__sched_startm` holds `__sched_lock` across the
// `osThreadCreate` that births a machine, so a roster read under it cannot be overtaken by a machine that
// does not exist yet, and the monitor — the one party that starts one during a stop — waits here instead.
//
// Whether the lock was entered is recorded rather than re-derived at the release. The word is 0 until
// `__gt_init` builds the mutex, so a stop that began before the scheduler existed enters nothing; asking
// the word again at the release would leave a mutex this thread never took.
function dbgTakeSchedLock(private DbgWord)
	let lock = dbgSchedLock()
	dbgStore(private, offset: DbgPrivOffSchedLockHeld, value: 0)

	if lock == 0 'noSchedulerToLock'
		return
	end 'noSchedulerToLock'

	__Raw.osLockEnter(lock as MachineWord)
	dbgStore(private, offset: DbgPrivOffSchedLockHeld, value: 1)
end 'dbgTakeSchedLock'

function dbgDropSchedLock(private DbgWord)
	if dbgLoad(private, offset: DbgPrivOffSchedLockHeld) == 0 'nothingWasEntered'
		return
	end 'nothingWasEntered'

	dbgStore(private, offset: DbgPrivOffSchedLockHeld, value: 0)
	__Raw.osLockLeave(dbgSchedLock() as MachineWord)
end 'dbgDropSchedLock'

// The preemption window must be open before the process may end: `osExit` routes through
// `__gt_exit_process`, which takes `__sched_preempt_ext_lock` and never gives it back, so an exit from
// inside a stop that holds the same lock spins for ever with nothing printed.
function dbgExitOrphaned(private DbgWord)
	dbgLetGoOfTheWorld(private)
	__Raw.osExit(DbgOrphanedExitCode as MachineWord)
end 'dbgExitOrphaned'

// Only the thread that owns the stop may drop its locks. `__sched_lock` is a host mutex and leaving
// one this thread does not hold is undefined; the service thread reaches `dbgExitOrphaned` while
// another thread is parked holding both, and must let go of neither.
function dbgLetGoOfTheWorld(private DbgWord)
	if dbgLoad(private, offset: DbgPrivOffWorldStopped) != 0 and dbgLoad(private, offset: DbgPrivOffStopThreadId) == dbgCurrentThreadId() 'thisThreadOwnsTheStop'
		dbgDropSchedLock(private)
		dbgDropExtLock()
	end 'thisThreadOwnsTheStop'
end 'dbgLetGoOfTheWorld'

// A stop is a stop of the program, not of a thread: every machine but this one is suspended before a word
// of the stop is published, and both locks are held across the park, so nothing runs user code while a
// driver reads the page and no exit or preemption can begin underneath it.
//
// The order is the ext lock, then `__sched_lock`, then the suspends, and nothing holds those two the other
// way round: the ext lock's only other taker is `__gt_preempt_m`, reached from `__sysmon` through
// `__sched_retake` with `__sched_lock` released, so there is no cycle to close.
//
// No suspended machine can hold `__sched_lock`, because it is taken before anyone is suspended and whoever
// holds it then is running and will release it — no road in the scheduler blocks while holding it, and the
// idle tail and the poller both release before they wait. The stopping thread never holds it either, since
// a breakpoint inside a runtime symbol is refused.
function dbgStopTheWorld(private DbgWord)
	dbgTakeExtLock()
	dbgTakeSchedLock(private)

	let me = dbgCurrentThreadId()
	dbgStore(private, offset: DbgPrivOffStopThreadId, value: me)
	dbgStore(private, offset: DbgPrivOffWorldStopped, value: 1)

	let context = private + DbgPrivOffContext
	var machine = dbgAllMachines()

	while machine != 0 'eachMachine'
		let handle = dbgLoad(machine, offset: DbgMOffPreemptThreadHandle)

		if handle != 0 and dbgLoad(machine, offset: DbgMOffOsThreadId) != me 'notTheStoppingThread'
			dbgSinkHostAnswer(__Raw.osDebugHost(DbgVerbSuspendThread, a0: handle as MachineWord, a1: DbgNothing, a2: DbgNothing, a3: DbgNothing))

			// A suspend on this host is a request, not an event: `SuspendThread` returns as soon as the count is
			// raised and the thread runs on until the kernel gets round to it. Reading its register file is what
			// forces the suspension to complete, so without this read the stop is published while a machine is
			// still running and the driver is told the program is frozen when it is not.
			dbgStore(context, offset: DbgCtxOffFlagsRequest, value: DbgCtxControlRequest)
			dbgSinkHostAnswer(__Raw.osDebugHost(DbgVerbReadThreadContext, a0: handle as MachineWord, a1: context as MachineWord, a2: DbgNothing, a3: DbgNothing))
		end 'notTheStoppingThread'

		machine = dbgLoad(machine, offset: DbgMOffAllNext)
	end 'eachMachine'
end 'dbgStopTheWorld'

function dbgStartTheWorld(private DbgWord)
	let me = dbgLoad(private, offset: DbgPrivOffStopThreadId)
	var machine = dbgAllMachines()

	while machine != 0 'eachMachine'
		let handle = dbgLoad(machine, offset: DbgMOffPreemptThreadHandle)

		if handle != 0 and dbgLoad(machine, offset: DbgMOffOsThreadId) != me 'notTheStoppingThread'
			dbgSinkHostAnswer(__Raw.osDebugHost(DbgVerbResumeThread, a0: handle as MachineWord, a1: DbgNothing, a2: DbgNothing, a3: DbgNothing))
		end 'notTheStoppingThread'

		machine = dbgLoad(machine, offset: DbgMOffAllNext)
	end 'eachMachine'

	dbgStore(private, offset: DbgPrivOffWorldStopped, value: 0)
	dbgDropSchedLock(private)
	dbgDropExtLock()
end 'dbgStartTheWorld'

module function __dbg_on_trap(contextPtr MachineWord, excCode MachineWord) returns MachineWord
	let base = dbgControlSegment()
	let private = dbgPrivateBlock()
	let context = contextPtr as DbgWord
	let code = excCode as DbgWord
	let rip = dbgLoad(context, offset: DbgCtxOffRip)
	let textBase = dbgLoad(base, offset: DbgOffTextBase)

	var stopPc = rip
	var reason = DbgStopReasonStep
	var landing = DbgLandingNotArmed

	dbgReleaseTheStepsPreemptionHold()

	// Windows hands a breakpoint trap a `CONTEXT.Rip` already backed onto the `int3` — the opposite of the
	// POSIX convention — so the pc as delivered IS the breakpoint's address and is not adjusted here.
	if code == DbgExcCodeBreakpoint and rip == dbgLoad(private, offset: DbgPrivOffPauseTrampoline) 'aPauseLanded'
		stopPc = dbgPoppedInterruptedPc(context)
		reason = DbgStopReasonPause
		landing = dbgLandingAt(private, context: context, pc: stopPc, textBase: textBase)
		dbgHandBackSignalPending(dbgCurrentMachine())
	end 'aPauseLanded' else if code == DbgExcCodeBreakpoint 'aPlantedByte'
		let armed = dbgFindBreakpoint(private, textOffset: rip - textBase)

		if armed == DbgNotFound and dbgLoadByte(rip, offset: 0) != DbgBreakpointByte 'clearedWhileWeWereReachingThisHandler'
			return DbgVehContinueExecution as MachineWord
		end 'clearedWhileWeWereReachingThisHandler'

		// An `int3` the agent does not own is reported, never declined. Declining hands the exception to a
		// chain that does not want it either and the process dies of `STATUS_BREAKPOINT` with the address —
		// the one fact worth having — printed nowhere.
		if armed == DbgNotFound 'anInt3NobodyHereOwns'
			return dbgTrapStop(base, private: private, context: context, rip: rip, textBase: textBase)
		end 'anInt3NobodyHereOwns'

		landing = dbgLandingOn(private, index: armed, context: context, pc: rip)

		// A condition is judged before a single machine is suspended and before a word is published: a hit
		// the driver did not ask for costs one trap and the program never notices it.
		if landing == DbgLandingConditionFalse 'notThisTime'
			dbgCaptureRegisters(base, context: context)
			dbgResume(base, private: private, context: context, stopPc: rip, index: armed, action: DbgResumeContinue)
			return DbgVehContinueExecution as MachineWord
		end 'notThisTime'
	end 'aPlantedByte' else if code == DbgExcCodeSingleStep 'oneInstructionDone'
		let slot = dbgSlotHolding(private, pc: rip)

		// A step into a displaced call runs the slot's pushes and tail before it reaches the callee,
		// and a thread past a tail's exit count is already counted out. Neither is at a program
		// instruction, so the thread is stepped on until it leaves the slot.
		if slot != DbgNotFound and (dbgPastTheExitCount(slot, pc: rip) or dbgSlotSendsACall(slot)) 'midwayThroughADisplacedCall'
			dbgSetTrapFlag(context, armed: true)
			dbgHoldPreemptionForTheStep()
			return DbgVehContinueExecution as MachineWord
		end 'midwayThroughADisplacedCall'

		dbgSetTrapFlag(context, armed: false)
		stopPc = dbgPcAfterASlot(slot, textBase: textBase, pc: rip)
		dbgLeaveTheSlot(slot)
		landing = dbgLandingAt(private, context: context, pc: stopPc, textBase: textBase)
	end 'oneInstructionDone' else 'theProgramFaulted'
		// After the park the exception goes on down the chain: resuming would only re-run the faulting
		// instruction, so the program's own handler reports the fault and ends it.
		let slot = dbgSlotHolding(private, pc: rip)
		let faultPc = dbgPcOfASlot(slot, textBase: textBase, pc: rip)

		if slot != DbgNotFound and not dbgPastTheExitCount(slot, pc: rip) 'itFaultedBeforeCountingItsExit'
			dbgLeaveTheSlot(slot)
		end 'itFaultedBeforeCountingItsExit'
		dbgStopAt(base, private: private, context: context, pc: faultPc, reason: DbgStopReasonFault, fault: code)
		dbgStore(context, offset: DbgCtxOffRip, value: faultPc)

		return DbgVehContinueSearch as MachineWord
	end 'theProgramFaulted'

	var pc = stopPc
	var currentReason = reason
	var settled = false

	dbgStopTheWorld(private)

	while not settled 'stopAndGo'
		dbgCaptureRegisters(base, context: context)
		dbgStore(base, offset: DbgOffStopPc, value: pc)
		dbgPublishStop(base, reason: dbgReasonOfLanding(landing, otherwise: currentReason), fault: DbgNoFault, conditionMissed: dbgLandingMissedItsCondition(landing))
		dbgPark(base, private: private, stopKind: DbgStopKindThread)

		let action = dbgLoad(private, offset: DbgPrivOffResumeAction)
		let index = dbgFindBreakpoint(private, textOffset: pc - textBase)
		var simulated = DbgNotFound

		if action == DbgResumeStep 'aStep'
			simulated = dbgSimulatedStep(base, private: private, index: index, stopPc: pc)
		end 'aStep'

		if simulated != DbgNotFound 'theTargetIsTheNextInstruction'
			dbgWriteRegistersBack(base, context: context)
			pc = simulated
			currentReason = DbgStopReasonStep
			landing = dbgLandingAt(private, context: context, pc: pc, textBase: textBase)
			continue
		end 'theTargetIsTheNextInstruction'

		dbgResume(base, private: private, context: context, stopPc: pc, index: index, action: action)
		settled = true
	end 'stopAndGo'

	dbgStartTheWorld(private)

	return DbgVehContinueExecution as MachineWord
end '__dbg_on_trap'

// A pause arrives on the agent's own trampoline, and `dbgInjectThread` pushed the interrupted pc
// below the thread's stack pointer. The word is popped here, so the reported sp is the one the
// thread really had and the resume leaves nothing on its stack.
function dbgPoppedInterruptedPc(context DbgWord) returns DbgWord
	let sp = dbgLoad(context, offset: DbgCtxOffRsp)
	dbgStore(context, offset: DbgCtxOffRsp, value: sp + DbgWordBytes)

	return dbgLoad(sp, offset: 0)
end 'dbgPoppedInterruptedPc'

// Every landing is judged here (a pause, a single step, a simulated jump, and an `int3` through
// `dbgLandingOn`), so a thread that comes to rest on an armed byte reports that breakpoint however
// it got there.
function dbgLandingAt(private DbgWord, context DbgWord, pc DbgWord, textBase DbgWord) returns DbgWord
	let index = dbgFindBreakpoint(private, textOffset: pc - textBase)

	if index == DbgNotFound 'nothingIsArmedHere'
		return DbgLandingNotArmed
	end 'nothingIsArmedHere'

	return dbgLandingOn(private, index: index, context: context, pc: pc)
end 'dbgLandingAt'

function dbgLandingOn(private DbgWord, index DbgWord, context DbgWord, pc DbgWord) returns DbgWord
	if dbgConditionAllows(private, index: index, context: context) 'itsConditionHolds'
		return DbgLandingHit
	end 'itsConditionHolds'

	return DbgLandingHeldOpen if pc == dbgLoad(private, offset: DbgPrivOffReturnHold) else DbgLandingConditionFalse
end 'dbgLandingOn'

function dbgReasonOfLanding(landing DbgWord, otherwise DbgWord) returns DbgWord
	return DbgStopReasonBreakpoint if landing == DbgLandingHit or landing == DbgLandingHeldOpen else otherwise
end 'dbgReasonOfLanding'

function dbgLandingMissedItsCondition(landing DbgWord) returns bool
	return landing == DbgLandingHeldOpen or landing == DbgLandingConditionFalse
end 'dbgLandingMissedItsCondition'

// The agent planted no byte here, so there is nothing to displace and nothing to put back: the trap was one
// byte wide and the resume is `rip + 1`, which is the only convention an unowned `int3` has.
function dbgTrapStop(base DbgWord, private DbgWord, context DbgWord, rip DbgWord, textBase DbgWord) returns MachineWord
	let trapPc = dbgPcOfASlot(dbgSlotHolding(private, pc: rip), textBase: textBase, pc: rip)
	dbgStopAt(base, private: private, context: context, pc: trapPc, reason: DbgStopReasonTrap, fault: DbgNoFault)

	dbgWriteRegistersBack(base, context: context)
	dbgStore(context, offset: DbgCtxOffRip, value: rip + DbgOneByte)
	dbgSetTrapFlag(context, armed: false)

	return DbgVehContinueExecution as MachineWord
end 'dbgTrapStop'

function dbgStopAt(base DbgWord, private DbgWord, context DbgWord, pc DbgWord, reason DbgWord, fault DbgWord)
	dbgStopTheWorld(private)
	dbgCaptureRegisters(base, context: context)
	dbgStore(base, offset: DbgOffStopPc, value: pc)
	dbgPublishStop(base, reason: reason, fault: fault, conditionMissed: false)
	dbgPark(base, private: private, stopKind: DbgStopKindThread)
	dbgStartTheWorld(private)
end 'dbgStopAt'

// Every road out of a claimed stop owes the claim back, or the monitor never preempts this machine again.
function dbgHandBackSignalPending(machine DbgWord)
	if machine == 0 'notAMachine'
		return
	end 'notAMachine'

	dbgStore(machine, offset: DbgMOffSignalPending, value: DbgPreemptClaimFree)
end 'dbgHandBackSignalPending'

// A declared result may not be discarded (E3067), so an answer nothing reads is parked in scratch.
function dbgSinkHostAnswer(answer MachineWord)
	__Raw.storeWord(__Raw.scratch(DbgWordBytes), offset: 0, value: answer)
end 'dbgSinkHostAnswer'

function dbgControlSegment() returns DbgWord
	return __Raw.loadWord(__Raw.dbgCtlAddr(), offset: 0) as DbgWord
end 'dbgControlSegment'

function dbgPrivateBlock() returns DbgWord
	return dbgLoad(dbgControlSegment(), offset: DbgOffAgentPrivate)
end 'dbgPrivateBlock'

function dbgLoad(addr DbgWord, offset DbgWord) returns DbgWord
	return __Raw.loadWord((addr + offset) as MachineWord, offset: 0) as DbgWord
end 'dbgLoad'

function dbgStore(addr DbgWord, offset DbgWord, value DbgWord)
	__Raw.storeWord((addr + offset) as MachineWord, offset: 0, value: value as MachineWord)
end 'dbgStore'

function dbgLoadByte(addr DbgWord, offset DbgWord) returns DbgWord
	return __Raw.loadByte((addr + offset) as MachineWord, offset: 0) as DbgWord
end 'dbgLoadByte'

function dbgStoreByte(addr DbgWord, offset DbgWord, value DbgWord)
	__Raw.storeByte((addr + offset) as MachineWord, offset: 0, value: (value and DbgByteMask) as MachineWord)
end 'dbgStoreByte'

// `stopMachine` is an OS thread id and never an index, so a driver can name it against anything else the
// host reports. The trace mark is read here rather than at attach because `__dbg_init` runs ahead of
// `__ds_init`.
function dbgPublishStop(base DbgWord, reason DbgWord, fault DbgWord, conditionMissed bool)
	let machine = dbgCurrentMachine()

	dbgStore(base, offset: DbgOffStopReason, value: reason)
	dbgStore(base, offset: DbgOffStopFault, value: fault)
	dbgStore(base, offset: DbgOffStopConditionMissed, value: DbgStopConditionMissedYes if conditionMissed else DbgStopConditionMet)
	dbgStore(base, offset: DbgOffStopMachine, value: 0 if machine == 0 else dbgCurrentThreadId())
	dbgStore(base, offset: DbgOffStopGreenThread, value: dbgRunningGreenThread(machine))
	dbgStore(base, offset: DbgOffStopTraceMark, value: dbgTraceMark())
	dbgStore(base, offset: DbgOffStopSeq, value: dbgLoad(base, offset: DbgOffStopSeq) + 1)
end 'dbgPublishStop'

function dbgRunningGreenThread(machine DbgWord) returns DbgWord
	if machine == 0 'noMachine'
		return 0
	end 'noMachine'

	let gt = dbgLoad(machine, offset: DbgMOffCurrentGt)

	if gt == 0 'nothingRunning'
		return 0
	end 'nothingRunning'

	return 0 if dbgLoad(gt, offset: DbgGtOffStackBase) == 0 else gt
end 'dbgRunningGreenThread'

function dbgTraceMark() returns DbgWord
	let ring = __Raw.loadWord(__Raw.dsBaseAddr(), offset: 0) as DbgWord

	if ring == 0 'noRingAttached'
		return 0
	end 'noRingAttached'

	return dbgLoad(ring, offset: DbgDsOffWriteCursor)
end 'dbgTraceMark'

function dbgPark(base DbgWord, private DbgWord, stopKind DbgWord)
	var lastCommand = dbgLoad(base, offset: DbgOffAckSeq)
	let driverHandle = dbgLoad(private, offset: DbgPrivOffDriverHandle)
	var waiting = true

	dbgStore(private, offset: DbgPrivOffResumeAction, value: DbgResumeContinue)

	while waiting 'poll'
		let sequence = dbgLoad(base, offset: DbgOffCmdSeq)

		if sequence != lastCommand 'aCommandArrived'
			let leaves = dbgDispatch(base, private: private, command: dbgLoad(base, offset: DbgOffCmd), stopKind: stopKind)
			dbgStore(base, offset: DbgOffAckStopSeq, value: dbgLoad(base, offset: DbgOffStopSeq))
			dbgStore(base, offset: DbgOffAckSeq, value: sequence)
			lastCommand = sequence

			if leaves 'resume'
				waiting = false
				continue
			end 'resume'
		end 'aCommandArrived'

		// Liveness of the driver PROCESS, never a heartbeat: a user sitting at the REPL sends nothing for
		// minutes, and a clock would read that as an abandoned debuggee and kill a healthy program.
		if __Raw.osDebugHost(DbgVerbDriverExited, a0: driverHandle as MachineWord, a1: DbgNothing, a2: DbgNothing, a3: DbgNothing) as DbgWord == DbgWaitSignalled 'theDriverIsGone'
			dbgExitOrphaned(private)
		end 'theDriverIsGone'

		dbgSinkHostAnswer(__Raw.osDebugHost(DbgVerbParkWait, a0: DbgParkPollIntervalMs as MachineWord, a1: DbgNothing, a2: DbgNothing, a3: DbgNothing))
	end 'poll'
end 'dbgPark'

// The two refusals a command that needs a stop can earn are different facts, and a driver reports them
// differently. `notRunning` says nothing is stopped at all and the service thread is answering.
// `notStopped` says a stop is in progress but no thread's registers were captured at it: the entry park,
// and a pause the service thread declared over machines that were all idle.
function dbgDispatch(base DbgWord, private DbgWord, command DbgWord, stopKind DbgWord) returns bool
	if command == DbgCmdContinue 'resume'
		if stopKind == DbgStopKindRunning 'nothingIsParked'
			dbgRefuse(base, reason: DbgRefusalNotRunning)
			return false
		end 'nothingIsParked'

		dbgStore(private, offset: DbgPrivOffResumeAction, value: DbgResumeContinue)
		dbgAnswerDone(base)
		return true
	end 'resume'

	if command == DbgCmdStepInstruction 'stepOne'
		if stopKind == DbgStopKindRunning 'nothingIsParked'
			dbgRefuse(base, reason: DbgRefusalNotRunning)
			return false
		end 'nothingIsParked'

		if stopKind != DbgStopKindThread 'noThreadIsStopped'
			dbgRefuse(base, reason: DbgRefusalNotStopped)
			return false
		end 'noThreadIsStopped'

		if dbgLoad(base, offset: DbgOffStopReason) == DbgStopReasonFault 'theInstructionWouldFaultAgain'
			dbgRefuse(base, reason: DbgRefusalFaultIsTerminal)
			return false
		end 'theInstructionWouldFaultAgain'

		dbgStore(private, offset: DbgPrivOffResumeAction, value: DbgResumeStep)
		dbgAnswerDone(base)
		return true
	end 'stepOne'

	if command == DbgCmdSetBreakpoint 'arm'
		dbgSetBreakpoint(base, private: private)
		return false
	end 'arm'

	if command == DbgCmdClearBreakpoint 'disarm'
		dbgClearBreakpoint(base, private: private)
		return false
	end 'disarm'

	if command == DbgCmdBacktrace 'walk'
		if stopKind == DbgStopKindRunning 'nothingIsParked'
			dbgRefuse(base, reason: DbgRefusalNotRunning)
			return false
		end 'nothingIsParked'

		if stopKind != DbgStopKindThread 'noFrameToWalk'
			dbgRefuse(base, reason: DbgRefusalNotStopped)
			return false
		end 'noFrameToWalk'

		dbgBacktrace(base)
		return false
	end 'walk'

	if command == DbgCmdReadMemory 'read'
		dbgReadMemory(base, private: private)
		return false
	end 'read'

	if command == DbgCmdSetCondition 'attachACondition'
		dbgSetCondition(base, private: private)
		return false
	end 'attachACondition'

	if command == DbgCmdClearCondition 'dropACondition'
		dbgClearCondition(base, private: private)
		return false
	end 'dropACondition'

	if command == DbgCmdHoldReturnPoint 'holdAReturnPoint'
		dbgHoldReturnPoint(base, private: private)
		return false
	end 'holdAReturnPoint'

	if command == DbgCmdReleaseReturnPoint 'releaseTheReturnPoint'
		dbgStore(private, offset: DbgPrivOffReturnHold, value: DbgNoReturnHold)
		dbgAnswerDone(base)
		return false
	end 'releaseTheReturnPoint'

	if command == DbgCmdGtList 'roster'
		dbgGtList(base, private: private, stopKind: stopKind)
		return false
	end 'roster'

	// A parked thread's walk needs no stopped thread, but it does need a stop: its registers are in its own
	// record, which the thread itself is writing while the program runs, so a walk taken then would chase a
	// moving chain.
	if command == DbgCmdGtBacktrace 'walkAParkedThread'
		if stopKind == DbgStopKindRunning 'nothingIsParked'
			dbgRefuse(base, reason: DbgRefusalNotRunning)
			return false
		end 'nothingIsParked'

		dbgGtBacktrace(base, private: private, stopKind: stopKind)
		return false
	end 'walkAParkedThread'

	if command == DbgCmdGtHold 'hold'
		dbgGtHold(base, private: private)
		return false
	end 'hold'

	if command == DbgCmdGtRelease 'release'
		dbgGtRelease(base, private: private)
		return false
	end 'release'

	// A pause reaching the park loop is a pause of a program that is already stopped, which it already is —
	// and the request in flight on the service thread is over, because this is the answer it was waiting for.
	if command == DbgCmdPause 'alreadyStopped'
		dbgStore(private, offset: DbgPrivOffPauseAttempts, value: 0)
		dbgAnswerDone(base)
		return false
	end 'alreadyStopped'

	dbgRefuse(base, reason: DbgRefusalUnknownCommand)
	return false
end 'dbgDispatch'

function dbgAnswerDone(base DbgWord)
	dbgStore(base, offset: DbgOffCmdRefusal, value: 0)
	dbgStore(base, offset: DbgOffCmdResult, value: DbgCmdResultDone)
end 'dbgAnswerDone'

function dbgRefuse(base DbgWord, reason DbgWord)
	dbgStore(base, offset: DbgOffCmdRefusal, value: reason)
	dbgStore(base, offset: DbgOffCmdResult, value: DbgCmdResultRefused)
end 'dbgRefuse'

function dbgBreakpointEntry(private DbgWord, index DbgWord) returns DbgWord
	return private + DbgPrivOffBreakpoints + index * DbgPrivBreakpointStride
end 'dbgBreakpointEntry'

function dbgFindBreakpoint(private DbgWord, textOffset DbgWord) returns DbgWord
	for index in 0 upto DbgBreakpointCapacity 'eachSlot'
		let entry = dbgBreakpointEntry(private, index: index as DbgWord)

		if dbgLoad(entry, offset: DbgBpOffState) != DbgBpStateFree 'taken'
			if dbgLoad(entry, offset: DbgBpOffTextOffset) == textOffset 'itIsThisOne'
				return index as DbgWord
			end 'itIsThisOne'
		end 'taken'
	end 'eachSlot'

	return DbgNotFound
end 'dbgFindBreakpoint'

function dbgNamedBreakpointOrRefuse(base DbgWord, private DbgWord) returns DbgWord
	let index = dbgFindBreakpoint(private, textOffset: dbgLoad(base, offset: DbgOffCmdArg0))

	if index == DbgNotFound 'nothingArmedThere'
		dbgRefuse(base, reason: DbgRefusalNoSuchBreakpoint)
	end 'nothingArmedThere'

	return index
end 'dbgNamedBreakpointOrRefuse'

function dbgFreeBreakpointRow(private DbgWord) returns DbgWord
	for index in 0 upto DbgBreakpointCapacity 'eachRow'
		if dbgLoad(dbgBreakpointEntry(private, index: index as DbgWord), offset: DbgBpOffState) == DbgBpStateFree 'free'
			return index as DbgWord
		end 'free'
	end 'eachRow'

	return DbgNotFound
end 'dbgFreeBreakpointRow'

function dbgSlotAt(private DbgWord, index DbgWord) returns DbgWord
	return dbgLoad(private, offset: DbgPrivOffSlotPoolBase) + index * DbgSlotBytes
end 'dbgSlotAt'

function dbgSlotIsBound(private DbgWord, slot DbgWord) returns bool
	for index in 0 upto DbgBreakpointCapacity 'eachRow'
		let entry = dbgBreakpointEntry(private, index: index as DbgWord)

		if dbgLoad(entry, offset: DbgBpOffState) == DbgBpStateLive and dbgLoad(entry, offset: DbgBpOffSlotAddr) == slot 'aLiveRowUsesIt'
			return true
		end 'aLiveRowUsesIt'
	end 'eachRow'

	return false
end 'dbgSlotIsBound'

// A slot may be refilled only when every thread sent into it has left. `dbgEnterTheSlot` counts a
// send at each resume into it, under the stop lock; the tail's `lock inc` counts an exit, and
// `dbgLeaveTheSlot` counts one for a thread the handler moves out any other way. A road out that
// counts no exit strands the slot for good, and one that counts twice lets it be rewritten under a
// running thread.
function dbgSlotIsDrained(slot DbgWord) returns bool
	return dbgLoad(slot, offset: DbgSlotExitsAt) == dbgLoad(slot, offset: DbgSlotSendsAt)
end 'dbgSlotIsDrained'

function dbgSlotHoldsTheSame(slot DbgWord, textOffset DbgWord, classWord DbgWord, fixup DbgWord) returns bool
	return dbgLoad(slot, offset: DbgSlotClassWordAt) == classWord and dbgLoad(slot, offset: DbgSlotOriginAt) == textOffset and dbgLoad(slot, offset: DbgSlotFixupAt) == fixup
end 'dbgSlotHoldsTheSame'

function dbgUnboundSlotHolding(private DbgWord, textOffset DbgWord, classWord DbgWord, fixup DbgWord) returns DbgWord
	for index in 0 upto DbgSlotCapacity 'eachSlot'
		let slot = dbgSlotAt(private, index: index as DbgWord)

		if dbgSlotHoldsTheSame(slot, textOffset: textOffset, classWord: classWord, fixup: fixup) and not dbgSlotIsBound(private, slot: slot) 'alreadyDisplacedHere'
			return slot
		end 'alreadyDisplacedHere'
	end 'eachSlot'

	return DbgNotFound
end 'dbgUnboundSlotHolding'

function dbgDrainedUnboundSlot(private DbgWord) returns DbgWord
	for index in 0 upto DbgSlotCapacity 'eachSlot'
		let slot = dbgSlotAt(private, index: index as DbgWord)

		if dbgSlotIsDrained(slot) and not dbgSlotIsBound(private, slot: slot) 'reusable'
			return slot
		end 'reusable'
	end 'eachSlot'

	return DbgNotFound
end 'dbgDrainedUnboundSlot'

function dbgSlotHolding(private DbgWord, pc DbgWord) returns DbgWord
	let poolBase = dbgLoad(private, offset: DbgPrivOffSlotPoolBase)

	if pc < poolBase or pc >= poolBase + DbgSlotCapacity * DbgSlotBytes 'notInThePool'
		return DbgNotFound
	end 'notInThePool'

	for index in 0 upto DbgSlotCapacity 'eachSlot'
		let slot = dbgSlotAt(private, index: index as DbgWord)

		if pc < slot + DbgSlotBytes 'thisSlot'
			return slot
		end 'thisSlot'
	end 'eachSlot'

	return DbgNotFound
end 'dbgSlotHolding'

function dbgSlotSendsACall(slot DbgWord) returns bool
	let instructionClass = dbgInstructionClassOf(dbgLoad(slot, offset: DbgSlotClassWordAt))

	return instructionClass == DbgClassDirectCall or instructionClass == DbgClassIndirectCall
end 'dbgSlotSendsACall'

function dbgEnterTheSlot(slot DbgWord)
	dbgStore(slot, offset: DbgSlotSendsAt, value: dbgLoad(slot, offset: DbgSlotSendsAt) + 1)
end 'dbgEnterTheSlot'

function dbgPastTheExitCount(slot DbgWord, pc DbgWord) returns bool
	return pc - slot >= DbgSlotTailPopAt
end 'dbgPastTheExitCount'

function dbgLeaveTheSlot(slot DbgWord)
	if slot == DbgNotFound 'neverInOne'
		return
	end 'neverInOne'

	dbgSinkHostAnswer(__Raw.atomicAddWord((slot + DbgSlotExitsAt) as MachineWord, delta: 1 as MachineWord))
end 'dbgLeaveTheSlot'

// The tail is `push [back]; pushfq; lock inc [exits]; popfq; ret`, written once here. A thread
// counted out may still be on its `popfq; ret`, which read only the stack: a refill writes the head
// and the data words and nothing the tail reads after the count. The flags are saved around the
// count because the displaced instruction's flags are still live.
function dbgWriteSlotTails(pool DbgWord)
	for index in 0 upto DbgSlotCapacity 'eachSlot'
		let slot = pool + (index as DbgWord) * DbgSlotBytes

		dbgWriteRipPush(slot, at: DbgSlotTailAt, word: DbgSlotBackAt)
		dbgStoreByte(slot, offset: DbgSlotTailFlagsAt, value: DbgPushFlagsOpcode)
		dbgStoreByte(slot, offset: DbgSlotTailIncAt, value: DbgLockPrefix)
		dbgStoreByte(slot, offset: DbgSlotTailIncAt + 1, value: DbgRexWide)
		dbgStoreByte(slot, offset: DbgSlotTailIncAt + 2, value: DbgIncGroupOpcode)
		dbgStoreByte(slot, offset: DbgSlotTailIncAt + 3, value: DbgIncRipRelativeModRm)
		dbgWriteDisplacement(slot, offset: DbgSlotTailIncAt + 4, value: DbgSlotExitsAt - DbgSlotTailPopAt)
		dbgStoreByte(slot, offset: DbgSlotTailPopAt, value: DbgPopFlagsOpcode)
		dbgStoreByte(slot, offset: DbgSlotTailReturnAt, value: DbgReturnOpcode)
	end 'eachSlot'

	dbgFlushCode(pool, length: DbgSlotCapacity * DbgSlotBytes)
end 'dbgWriteSlotTails'

function dbgSetBreakpoint(base DbgWord, private DbgWord)
	let textOffset = dbgLoad(base, offset: DbgOffCmdArg0)
	let classWord = dbgLoad(base, offset: DbgOffCmdArg1)
	let fixup = dbgLoad(base, offset: DbgOffCmdArg2)
	let length = classWord and DbgClassByteMask
	let instructionClass = dbgInstructionClassOf(classWord)
	let textBase = dbgLoad(base, offset: DbgOffTextBase)
	let textSize = dbgLoad(base, offset: DbgOffTextSize)

	if textOffset < 0 or textOffset + length > textSize 'outsideTheCode'
		dbgRefuse(base, reason: DbgRefusalOutOfText)
		return
	end 'outsideTheCode'

	if instructionClass < DbgClassPlain or instructionClass > DbgClassIndirectCall 'notSimulable'
		dbgRefuse(base, reason: DbgRefusalUnclassified)
		return
	end 'notSimulable'

	if length < 1 or length > DbgSlotTailAt - DbgSlotHeadTrailBytes 'noSlotFitsIt'
		dbgRefuse(base, reason: DbgRefusalUnclassified)
		return
	end 'noSlotFitsIt'

	if not dbgOperandsLieInside(classWord, instructionClass: instructionClass, length: length) 'anOperandPastTheInstruction'
		dbgRefuse(base, reason: DbgRefusalUnclassified)
		return
	end 'anOperandPastTheInstruction'

	if dbgInsideRuntimeSymbol(textOffset) 'theCompilersOwnCode'
		dbgRefuse(base, reason: DbgRefusalInsideRuntimeSymbol)
		return
	end 'theCompilersOwnCode'

	let existing = dbgFindBreakpoint(private, textOffset: textOffset)

	if existing != DbgNotFound 'alreadyArmed'
		dbgStore(dbgBreakpointEntry(private, index: existing), offset: DbgBpOffCondition + DbgCondRecOffKind, value: DbgCondKindNone)
		dbgDropTheReturnHoldAt(private, address: textBase + textOffset)
		dbgAnswerDone(base)
		return
	end 'alreadyArmed'

	let index = dbgFreeBreakpointRow(private)

	if index == DbgNotFound 'noRow'
		dbgRefuse(base, reason: DbgRefusalTableFull)
		return
	end 'noRow'

	let displaced = dbgUnboundSlotHolding(private, textOffset: textOffset, classWord: classWord, fixup: fixup)
	let slot = displaced if displaced != DbgNotFound else dbgDrainedUnboundSlot(private)

	if slot == DbgNotFound 'noSlot'
		dbgRefuse(base, reason: DbgRefusalTableFull)
		return
	end 'noSlot'

	let address = textBase + textOffset
	let entry = dbgBreakpointEntry(private, index: index)

	// The way back out of a slot is an absolute return, so the only reach a slot needs is a rebased
	// operand's. One out of reach is refused rather than displaced into an instruction that would
	// read a different address.
	if dbgSlotRebasesAnOperand(instructionClass, classWord: classWord) 'anOperandTheSlotMustStillReach'
		let reach = fixup - (slot + length)

		if reach < DbgDisplacementMin or reach > DbgDisplacementMax 'outOfReach'
			dbgRefuse(base, reason: DbgRefusalUnclassified)
			return
		end 'outOfReach'
	end 'anOperandTheSlotMustStillReach'

	// A slot already holding exactly these bytes is bound again without a write: a thread sent out
	// of line by an earlier hit may be inside it at this instant, and a refill would write over the
	// code it is running.
	if displaced == DbgNotFound 'theSlotDoesNotAlreadyHoldThis'
		dbgFillSlot(slot, private: private, textBase: textBase, address: address, textOffset: textOffset, classWord: classWord, fixup: fixup)
	end 'theSlotDoesNotAlreadyHoldThis'

	dbgStore(entry, offset: DbgBpOffTextOffset, value: textOffset)
	dbgStore(entry, offset: DbgBpOffOriginalByte, value: dbgLoadByte(address, offset: 0))
	dbgStore(entry, offset: DbgBpOffSlotAddr, value: slot)
	dbgStore(entry, offset: DbgBpOffClassWord, value: classWord)
	dbgStore(entry, offset: DbgBpOffFixup, value: fixup)
	dbgStore(entry, offset: DbgBpOffCondition + DbgCondRecOffKind, value: DbgCondKindNone)
	dbgStore(entry, offset: DbgBpOffState, value: DbgBpStateLive)

	dbgMarkPlanted(private, textOffset: textOffset)
	dbgPatchCode(address, value: DbgBreakpointByte)
	dbgAnswerDone(base)
end 'dbgSetBreakpoint'

function dbgFillSlot(slot DbgWord, private DbgWord, textBase DbgWord, address DbgWord, textOffset DbgWord, classWord DbgWord, fixup DbgWord)
	let length = classWord and DbgClassByteMask
	let instructionClass = dbgInstructionClassOf(classWord)

	dbgWriteWord(slot, offset: DbgSlotBackAt, value: address + length)
	dbgWriteWord(slot, offset: DbgSlotOriginAt, value: textOffset)
	dbgWriteWord(slot, offset: DbgSlotClassWordAt, value: classWord)
	dbgWriteWord(slot, offset: DbgSlotFixupAt, value: fixup)

	if instructionClass == DbgClassDirectCall 'aDisplacedCallIsSynthesized'
		dbgFillDirectCallHead(slot)
	end 'aDisplacedCallIsSynthesized' else 'theInstructionItself'
		dbgFillDisplacedHead(slot, private: private, textBase: textBase, address: address, classWord: classWord, fixup: fixup)
	end 'theInstructionItself'

	dbgFlushCode(slot, length: DbgSlotBytes)
end 'dbgFillSlot'

// The displaced bytes are read through the breakpoint table, never raw. One line can resolve to
// several offsets inside one instruction's span, so what this displaces may already carry a
// neighbouring breakpoint's `0xCC`; copied verbatim, that trap would fire from inside the slot
// pool, at an address no breakpoint entry claims.
function dbgFillDisplacedHead(slot DbgWord, private DbgWord, textBase DbgWord, address DbgWord, classWord DbgWord, fixup DbgWord)
	let length = classWord and DbgClassByteMask
	let instructionClass = dbgInstructionClassOf(classWord)

	for position in 0 upto length 'eachByte'
		dbgStoreByte(slot, offset: position as DbgWord, value: dbgProgramByteAt(private, textBase: textBase, address: address + (position as DbgWord)))
	end 'eachByte'

	if dbgSlotRebasesAnOperand(instructionClass, classWord: classWord) 'rebasedOperand'
		dbgWriteDisplacement(slot, offset: dbgOperandPositionOf(classWord), value: fixup - (slot + length))
	end 'rebasedOperand'

	if instructionClass == DbgClassIndirectCall 'itCallsThroughItsOperand'
		dbgFillIndirectCallTrail(slot, classWord: classWord)
		return
	end 'itCallsThroughItsOperand'

	dbgWriteShortJump(slot, at: length, to: DbgSlotTailAt)
end 'dbgFillDisplacedHead'

// A displaced call, direct or indirect, runs through its slot rather than being simulated: the slot
// pushes the return address and the target, and the tail's `ret` enters the callee. The handler
// cannot write the debuggee's stack itself, since Win64 has no red zone and the dispatcher's own
// frame already occupies the memory below rsp.
function dbgFillDirectCallHead(slot DbgWord)
	dbgWriteRipPush(slot, at: 0, word: DbgSlotBackAt)
	dbgWriteRipPush(slot, at: DbgCallHeadTargetAt, word: DbgSlotFixupAt)
	dbgWriteShortJump(slot, at: DbgCallHeadJumpAt, to: DbgSlotTailFlagsAt)
end 'dbgFillDirectCallHead'

// The displaced instruction, turned from `call` into `push`, pushes the target first, so an operand
// that addresses through rsp reads the stack the call saw; the return address is then swapped in
// beneath it.
function dbgFillIndirectCallTrail(slot DbgWord, classWord DbgWord)
	let length = classWord and DbgClassByteMask
	let modRmAt = dbgModRmPositionOf(classWord)
	let backAt = length + DbgCallTrailBackAt
	let popAt = length + DbgCallTrailPopAt

	dbgStoreByte(slot, offset: modRmAt, value: (dbgLoadByte(slot, offset: modRmAt) and DbgModRmKeepMask) or DbgModRmPushReg)
	dbgStoreByte(slot, offset: length, value: DbgPushIndirectOpcode)
	dbgStoreByte(slot, offset: length + 1, value: DbgPushStackTopModRm)
	dbgStoreByte(slot, offset: length + 2, value: DbgSibStackPointerBase)
	dbgWriteRipPush(slot, at: backAt, word: DbgSlotBackAt)
	dbgStoreByte(slot, offset: popAt, value: DbgPopIndirectOpcode)
	dbgStoreByte(slot, offset: popAt + 1, value: DbgPopStackDisp8ModRm)
	dbgStoreByte(slot, offset: popAt + 2, value: DbgSibStackPointerBase)
	dbgStoreByte(slot, offset: popAt + 3, value: DbgWordBytes)
	dbgWriteShortJump(slot, at: length + DbgCallTrailJumpAt, to: DbgSlotTailFlagsAt)
end 'dbgFillIndirectCallTrail'

function dbgWriteRipPush(slot DbgWord, at DbgWord, word DbgWord)
	dbgStoreByte(slot, offset: at, value: DbgPushIndirectOpcode)
	dbgStoreByte(slot, offset: at + 1, value: DbgPushIndirectModRm)
	dbgWriteDisplacement(slot, offset: at + 2, value: word - (at + DbgPushIndirectBytes))
end 'dbgWriteRipPush'

function dbgWriteShortJump(slot DbgWord, at DbgWord, to DbgWord)
	dbgStoreByte(slot, offset: at, value: DbgJmpShortOpcode)
	dbgStoreByte(slot, offset: at + 1, value: to - (at + DbgJmpShortBytes))
end 'dbgWriteShortJump'

function dbgSlotRebasesAnOperand(instructionClass DbgWord, classWord DbgWord) returns bool
	if instructionClass == DbgClassPcRelativeData 'aPcRelativeOperand'
		return true
	end 'aPcRelativeOperand'

	return instructionClass == DbgClassIndirectCall and dbgCallFormOf(classWord) == DbgCallFormPcRelative
end 'dbgSlotRebasesAnOperand'

function dbgCallFormOf(classWord DbgWord) returns DbgWord
	return (classWord shr DbgCallFormShift) and DbgClassByteMask
end 'dbgCallFormOf'

function dbgOperandPositionOf(classWord DbgWord) returns DbgWord
	return (classWord shr DbgCondShift) and DbgClassByteMask
end 'dbgOperandPositionOf'

function dbgModRmPositionOf(classWord DbgWord) returns DbgWord
	return (classWord shr DbgCallModRmShift) and DbgClassByteMask
end 'dbgModRmPositionOf'

function dbgOperandsLieInside(classWord DbgWord, instructionClass DbgWord, length DbgWord) returns bool
	let operandAt = dbgOperandPositionOf(classWord)

	if instructionClass == DbgClassReturn 'aRelease'
		return operandAt == DbgReturnReleasesNothing or operandAt + DbgReleaseImmediateBytes <= length
	end 'aRelease'

	if instructionClass == DbgClassIndirectCall and dbgModRmPositionOf(classWord) >= length 'aModRmPastTheInstruction'
		return false
	end 'aModRmPastTheInstruction'

	if dbgSlotRebasesAnOperand(instructionClass, classWord: classWord) 'aRebasedDisplacement'
		return operandAt + DbgDisplacementBytes <= length
	end 'aRebasedDisplacement'

	return true
end 'dbgOperandsLieInside'

// The byte the program has at this address, which is not always the byte in memory: a live breakpoint has
// replaced its own first byte, and the entry remembers what stood there.
function dbgProgramByteAt(private DbgWord, textBase DbgWord, address DbgWord) returns DbgWord
	let index = dbgFindBreakpoint(private, textOffset: address - textBase)

	if index != DbgNotFound 'oneOfOurOwnTrapsStandsHere'
		return dbgLoad(dbgBreakpointEntry(private, index: index), offset: DbgBpOffOriginalByte)
	end 'oneOfOurOwnTrapsStandsHere'

	return dbgLoadByte(address, offset: 0)
end 'dbgProgramByteAt'

function dbgWriteWord(base DbgWord, offset DbgWord, value DbgWord)
	var remaining = value

	for byteIndex in 0 upto DbgWordBytes 'eachByte'
		dbgStoreByte(base, offset: offset + (byteIndex as DbgWord), value: remaining and DbgByteMask)
		remaining = remaining shr DbgByteBits
	end 'eachByte'
end 'dbgWriteWord'

function dbgWriteDisplacement(base DbgWord, offset DbgWord, value DbgWord)
	var remaining = value

	for byteIndex in 0 upto DbgDisplacementBytes 'eachByte'
		dbgStoreByte(base, offset: offset + (byteIndex as DbgWord), value: remaining and DbgByteMask)
		remaining = remaining shr DbgByteBits
	end 'eachByte'
end 'dbgWriteDisplacement'

function dbgPatchCode(address DbgWord, value DbgWord)
	let previous = __Raw.scratch(DbgWordBytes)
	dbgSinkHostAnswer(__Raw.osDebugHost(DbgVerbProtectPages, a0: address as MachineWord, a1: DbgOneByte as MachineWord, a2: DbgPageExecuteReadWrite as MachineWord, a3: previous))
	dbgStoreByte(address, offset: 0, value: value)
	dbgSinkHostAnswer(__Raw.osDebugHost(DbgVerbProtectPages, a0: address as MachineWord, a1: DbgOneByte as MachineWord, a2: DbgPageExecuteRead as MachineWord, a3: previous))
	dbgFlushCode(address, length: DbgOneByte)
end 'dbgPatchCode'

function dbgFlushCode(address DbgWord, length DbgWord)
	dbgSinkHostAnswer(__Raw.osDebugHost(DbgVerbFlushCode, a0: address as MachineWord, a1: length as MachineWord, a2: DbgNothing, a3: DbgNothing))
end 'dbgFlushCode'

function dbgClearBreakpoint(base DbgWord, private DbgWord)
	let index = dbgNamedBreakpointOrRefuse(base, private: private)

	if index == DbgNotFound 'nothingArmedThere'
		return
	end 'nothingArmedThere'

	let entry = dbgBreakpointEntry(private, index: index)
	let address = dbgLoad(base, offset: DbgOffTextBase) + dbgLoad(entry, offset: DbgBpOffTextOffset)
	dbgPatchCode(address, value: dbgLoad(entry, offset: DbgBpOffOriginalByte))
	dbgStore(entry, offset: DbgBpOffState, value: DbgBpStateFree)
	dbgDropTheReturnHoldAt(private, address: address)
	dbgAnswerDone(base)
end 'dbgClearBreakpoint'

function dbgDropTheReturnHoldAt(private DbgWord, address DbgWord)
	if dbgLoad(private, offset: DbgPrivOffReturnHold) == address 'theWalkHeldThisByte'
		dbgStore(private, offset: DbgPrivOffReturnHold, value: DbgNoReturnHold)
	end 'theWalkHeldThisByte'
end 'dbgDropTheReturnHoldAt'

function dbgCaptureRegisters(base DbgWord, context DbgWord)
	for index in 0 upto DbgGprCount 'eachGeneral'
		dbgStore(base, offset: DbgOffRegisters + (index as DbgWord) * DbgWordBytes, value: dbgLoad(context, offset: DbgCtxOffGpr0 + (index as DbgWord) * DbgWordBytes))
	end 'eachGeneral'

	for index in 0 upto DbgXmmCount 'eachVector'
		dbgStore(base, offset: DbgOffRegisters + ((DbgGprCount + index) as DbgWord) * DbgWordBytes, value: dbgLoad(context, offset: DbgCtxOffXmm0 + (index as DbgWord) * DbgCtxXmmStride))
	end 'eachVector'

	dbgSetRegister(base, number: DbgRegEFlags, value: dbgLoadByte(context, offset: DbgCtxOffEFlagsLowByte) or (dbgLoadByte(context, offset: DbgCtxOffEFlagsHighByte) shl DbgByteBits))
	dbgStore(base, offset: DbgOffStopSp, value: dbgRegister(base, number: DbgRegRsp))
	dbgStore(base, offset: DbgOffStopFp, value: dbgRegister(base, number: DbgRegRbp))
end 'dbgCaptureRegisters'

function dbgClearRegisters(base DbgWord)
	for index in 0 upto DbgRegisterSlots 'eachSlot'
		dbgSetRegister(base, number: index as DbgWord, value: 0)
	end 'eachSlot'
end 'dbgClearRegisters'

function dbgRegister(base DbgWord, number DbgWord) returns DbgWord
	return dbgLoad(base, offset: DbgOffRegisters + number * DbgWordBytes)
end 'dbgRegister'

function dbgSetRegister(base DbgWord, number DbgWord, value DbgWord)
	dbgStore(base, offset: DbgOffRegisters + number * DbgWordBytes, value: value)
end 'dbgSetRegister'

function dbgWriteRegistersBack(base DbgWord, context DbgWord)
	for index in 0 upto DbgGprCount 'eachGeneral'
		dbgStore(context, offset: DbgCtxOffGpr0 + (index as DbgWord) * DbgWordBytes, value: dbgRegister(base, number: index as DbgWord))
	end 'eachGeneral'

	for index in 0 upto DbgXmmCount 'eachVector'
		dbgStore(context, offset: DbgCtxOffXmm0 + (index as DbgWord) * DbgCtxXmmStride, value: dbgRegister(base, number: (DbgGprCount + index) as DbgWord))
	end 'eachVector'
end 'dbgWriteRegistersBack'

function dbgSetTrapFlag(context DbgWord, armed bool)
	let flags = dbgLoadByte(context, offset: DbgCtxOffEFlagsHighByte)

	if armed 'stepOne'
		dbgStoreByte(context, offset: DbgCtxOffEFlagsHighByte, value: flags or DbgTrapFlagByteBit)
	end 'stepOne' else 'runOn'
		dbgStoreByte(context, offset: DbgCtxOffEFlagsHighByte, value: flags and (DbgByteMask xor DbgTrapFlagByteBit))
	end 'runOn'
end 'dbgSetTrapFlag'

function dbgPcAfterASlot(slot DbgWord, textBase DbgWord, pc DbgWord) returns DbgWord
	if slot == DbgNotFound 'notInASlot'
		return pc
	end 'notInASlot'

	return textBase + dbgLoad(slot, offset: DbgSlotOriginAt) + (dbgLoad(slot, offset: DbgSlotClassWordAt) and DbgClassByteMask)
end 'dbgPcAfterASlot'

function dbgPcOfASlot(slot DbgWord, textBase DbgWord, pc DbgWord) returns DbgWord
	if slot == DbgNotFound or dbgPastTheExitCount(slot, pc: pc) 'notInASlotItStillHolds'
		return pc
	end 'notInASlotItStillHolds'

	return textBase + dbgLoad(slot, offset: DbgSlotOriginAt)
end 'dbgPcOfASlot'

function dbgInstructionClassOf(classWord DbgWord) returns DbgWord
	return (classWord shr DbgClassShift) and DbgClassByteMask
end 'dbgInstructionClassOf'

function dbgSimulatedStep(base DbgWord, private DbgWord, index DbgWord, stopPc DbgWord) returns DbgWord
	if index == DbgNotFound 'nothingIsArmedHere'
		return DbgNotFound
	end 'nothingIsArmedHere'

	let entry = dbgBreakpointEntry(private, index: index)
	let classWord = dbgLoad(entry, offset: DbgBpOffClassWord)

	return dbgSimulate(base, entry: entry, stopPc: stopPc, classWord: classWord, instructionClass: dbgInstructionClassOf(classWord))
end 'dbgSimulatedStep'

// A breakpoint's byte is never lifted to step over it. The scheduler preempts machines asynchronously, so
// any window in which the original byte is back is a window in which another machine runs past the
// breakpoint unseen; the displaced instruction is executed out of line instead.
function dbgResume(base DbgWord, private DbgWord, context DbgWord, stopPc DbgWord, index DbgWord, action DbgWord)
	var nextPc = stopPc
	var singleStep = action == DbgResumeStep

	if index != DbgNotFound 'displacedByAnArmedByte'
		let entry = dbgBreakpointEntry(private, index: index)
		let classWord = dbgLoad(entry, offset: DbgBpOffClassWord)
		let simulated = dbgSimulate(base, entry: entry, stopPc: stopPc, classWord: classWord, instructionClass: dbgInstructionClassOf(classWord))

		if simulated != DbgNotFound 'simulated'
			nextPc = simulated
			singleStep = false
		end 'simulated' else 'runItOutOfLine'
			nextPc = dbgLoad(entry, offset: DbgBpOffSlotAddr)
			dbgEnterTheSlot(nextPc)
		end 'runItOutOfLine'
	end 'displacedByAnArmedByte'

	dbgWriteRegistersBack(base, context: context)
	dbgStore(context, offset: DbgCtxOffRip, value: nextPc)
	dbgSetTrapFlag(context, armed: singleStep)

	if singleStep 'oneInstruction'
		dbgHoldPreemptionForTheStep()
	end 'oneInstruction'
end 'dbgResume'

function dbgHoldPreemptionForTheStep()
	let machine = dbgCurrentMachine()

	if machine == 0 'notAMachine'
		return
	end 'notAMachine'

	while __Raw.atomicCas((machine + DbgMOffSignalPending) as MachineWord, expected: DbgPreemptClaimFree as MachineWord, replacement: DbgPreemptClaimStep as MachineWord) == DbgNothing 'theMonitorHoldsTheClaim'
		dbgSinkHostAnswer(__Raw.osDebugHost(DbgVerbParkWait, a0: DbgParkPollIntervalMs as MachineWord, a1: DbgNothing, a2: DbgNothing, a3: DbgNothing))
	end 'theMonitorHoldsTheClaim'
end 'dbgHoldPreemptionForTheStep'

function dbgReleaseTheStepsPreemptionHold()
	let machine = dbgCurrentMachine()

	if machine == 0 'notAMachine'
		return
	end 'notAMachine'

	dbgSinkHostAnswer(__Raw.atomicCas((machine + DbgMOffSignalPending) as MachineWord, expected: DbgPreemptClaimStep as MachineWord, replacement: DbgPreemptClaimFree as MachineWord))
end 'dbgReleaseTheStepsPreemptionHold'

// Only the two jump classes and a return are answered without executing anything: they write no
// memory, so the handler can state where they land. A return only reads its address and moves rsp
// in the register file, which the resume writes back.
function dbgSimulate(base DbgWord, entry DbgWord, stopPc DbgWord, classWord DbgWord, instructionClass DbgWord) returns DbgWord
	let length = classWord and DbgClassByteMask
	let fallThrough = stopPc + length
	let fixup = dbgLoad(entry, offset: DbgBpOffFixup)

	if instructionClass == DbgClassDirectJump 'jump'
		return fixup
	end 'jump'

	if instructionClass == DbgClassConditionalJump 'conditionalJump'
		return fixup if dbgConditionHolds(base, condition: (classWord shr DbgCondShift) and DbgLowNibbleMask) else fallThrough
	end 'conditionalJump'

	if instructionClass == DbgClassReturn 'aReturn'
		return dbgPoppedReturn(base, stopPc: stopPc, classWord: classWord)
	end 'aReturn'

	return DbgNotFound
end 'dbgSimulate'

function dbgPoppedReturn(base DbgWord, stopPc DbgWord, classWord DbgWord) returns DbgWord
	let sp = dbgRegister(base, number: DbgRegRsp)
	let releaseAt = dbgOperandPositionOf(classWord)
	var released = 0 as DbgWord

	if not dbgRegionIsReadable(sp, length: DbgWordBytes) 'noReturnAddressToRead'
		return DbgNotFound
	end 'noReturnAddressToRead'

	if releaseAt != DbgReturnReleasesNothing 'itReleasesArguments'
		let private = dbgPrivateBlock()
		let textBase = dbgLoad(base, offset: DbgOffTextBase)
		released = dbgProgramByteAt(private, textBase: textBase, address: stopPc + releaseAt) or (dbgProgramByteAt(private, textBase: textBase, address: stopPc + releaseAt + DbgOneByte) shl DbgByteBits)
	end 'itReleasesArguments'

	dbgSetRegister(base, number: DbgRegRsp, value: sp + DbgWordBytes + released)

	return dbgLoad(sp, offset: 0)
end 'dbgPoppedReturn'

function dbgConditionHolds(base DbgWord, condition DbgWord) returns bool
	let low = dbgRegisterFlagsLow(base)
	let high = dbgRegisterFlagsHigh(base)
	let carry = (low and DbgFlagCarryMask) != 0
	let parity = (low and DbgFlagParityMask) != 0
	let zero = (low and DbgFlagZeroMask) != 0
	let sign = (low and DbgFlagSignMask) != 0
	let overflow = (high and DbgFlagOverflowInHighByteMask) != 0

	if condition == DbgCondOverflow 'overflowSet'
		return overflow
	end 'overflowSet'

	if condition == DbgCondNoOverflow 'overflowClear'
		return not overflow
	end 'overflowClear'

	if condition == DbgCondBelow 'carrySet'
		return carry
	end 'carrySet'

	if condition == DbgCondAboveOrEqual 'carryClear'
		return not carry
	end 'carryClear'

	if condition == DbgCondEqual 'zeroSet'
		return zero
	end 'zeroSet'

	if condition == DbgCondNotEqual 'zeroClear'
		return not zero
	end 'zeroClear'

	if condition == DbgCondBelowOrEqual 'carryOrZero'
		return carry or zero
	end 'carryOrZero'

	if condition == DbgCondAbove 'neitherCarryNorZero'
		return not carry and not zero
	end 'neitherCarryNorZero'

	if condition == DbgCondSign 'signSet'
		return sign
	end 'signSet'

	if condition == DbgCondNoSign 'signClear'
		return not sign
	end 'signClear'

	if condition == DbgCondParity 'paritySet'
		return parity
	end 'paritySet'

	if condition == DbgCondNoParity 'parityClear'
		return not parity
	end 'parityClear'

	if condition == DbgCondLess 'signDiffersFromOverflow'
		return sign != overflow
	end 'signDiffersFromOverflow'

	if condition == DbgCondGreaterOrEqual 'signMatchesOverflow'
		return sign == overflow
	end 'signMatchesOverflow'

	if condition == DbgCondLessOrEqual 'zeroOrSignDiffers'
		return zero or sign != overflow
	end 'zeroOrSignDiffers'

	return not zero and sign == overflow
end 'dbgConditionHolds'

function dbgRegisterFlagsLow(base DbgWord) returns DbgWord
	return dbgRegister(base, number: DbgRegEFlags) and DbgByteMask
end 'dbgRegisterFlagsLow'

function dbgRegisterFlagsHigh(base DbgWord) returns DbgWord
	return (dbgRegister(base, number: DbgRegEFlags) shr DbgByteBits) and DbgByteMask
end 'dbgRegisterFlagsHigh'

function dbgBacktrace(base DbgWord)
	dbgWalkFrames(base, frame: dbgLoad(base, offset: DbgOffStopFp))
end 'dbgBacktrace'

// A frame whose return address is not code ends the walk. A parked green thread's chain is seeded from a
// record rather than from a register file, so the first word that is not a saved frame is indistinguishable
// from one, and a walk that kept going would answer whatever it found as a caller.
function dbgWalkFrames(base DbgWord, frame DbgWord)
	let textBase = dbgLoad(base, offset: DbgOffTextBase)
	let textLimit = textBase + dbgLoad(base, offset: DbgOffTextSize)
	var cursor = frame
	var count = 0 as DbgWord
	var truncated = 0 as DbgWord
	var outerFrame = 0 as DbgWord
	var walking = true

	while walking 'eachFrame'
		if cursor == 0 or not dbgRegionIsReadable(cursor, length: DbgWordBytes * DbgBacktraceFrameWords) 'chainEnds'
			walking = false
			continue
		end 'chainEnds'

		let returnPc = dbgLoad(cursor, offset: DbgWordBytes)

		if returnPc < textBase or returnPc >= textLimit 'notAReturnIntoThisImage'
			walking = false
			continue
		end 'notAReturnIntoThisImage'

		if count >= DbgMaxBacktraceFrames 'capped'
			truncated = 1
			walking = false
			continue
		end 'capped'

		let slot = DbgOffBtFrames + count * DbgBacktraceFrameWords * DbgWordBytes
		dbgStore(base, offset: slot, value: returnPc)
		dbgStore(base, offset: slot + DbgWordBytes, value: cursor)
		count = count + 1

		let next = dbgLoad(cursor, offset: 0)
		outerFrame = next

		if next <= cursor 'notAnAscendingChain'
			walking = false
			continue
		end 'notAnAscendingChain'

		cursor = next
	end 'eachFrame'

	dbgStore(base, offset: DbgOffBtCount, value: count)
	dbgStore(base, offset: DbgOffBtTruncated, value: truncated)
	dbgStore(base, offset: DbgOffBtOuterFrame, value: outerFrame)
	dbgAnswerDone(base)
end 'dbgWalkFrames'

// A driver disassembling what comes back must see the program's own instructions, so a read inside the
// image answers through the breakpoint table. Outside it there is no table to consult and the memory is
// the answer.
function dbgReadMemory(base DbgWord, private DbgWord)
	let address = dbgLoad(base, offset: DbgOffCmdArg0)
	let length = dbgLoad(base, offset: DbgOffCmdArg1)
	let textBase = dbgLoad(base, offset: DbgOffTextBase)
	let textLimit = textBase + dbgLoad(base, offset: DbgOffTextSize)

	if length < 0 or length > DbgMaxReadLength or not dbgRegionIsReadable(address, length: length) 'notReadable'
		dbgStore(base, offset: DbgOffReadLen, value: 0)
		dbgStore(base, offset: DbgOffReadStatus, value: 0)
		dbgAnswerDone(base)
		return
	end 'notReadable'

	for position in 0 upto length 'eachByte'
		let at = address + (position as DbgWord)
		dbgStoreByte(base, offset: DbgOffReadBuf + (position as DbgWord), value: dbgLoadByte(at, offset: 0) if at < textBase or at >= textLimit else dbgProgramByteAt(private, textBase: textBase, address: at))
	end 'eachByte'

	dbgStore(base, offset: DbgOffReadLen, value: length)
	dbgStore(base, offset: DbgOffReadStatus, value: 1)
	dbgAnswerDone(base)
end 'dbgReadMemory'

function dbgRegionIsReadable(address DbgWord, length DbgWord) returns bool
	if length <= 0 'nothingToRead'
		return false
	end 'nothingToRead'

	let query = __Raw.scratch(DbgMbiBytes) as DbgWord

	if __Raw.osDebugHost(DbgVerbQueryRegion, a0: address as MachineWord, a1: query as MachineWord, a2: DbgMbiBytes as MachineWord, a3: DbgNothing) == DbgNothing 'theQueryFailed'
		return false
	end 'theQueryFailed'

	let stateAndProtect = dbgLoad(query, offset: DbgMbiOffStateAndProtect)
	let state = stateAndProtect and DbgDwordMask
	let protect = (stateAndProtect shr DbgDwordBits) and DbgDwordMask

	if state != DbgMemCommit 'notBacked'
		return false
	end 'notBacked'

	if (protect and DbgPageNoAccess) != 0 or (protect and DbgPageGuard) != 0 'notReadableThere'
		return false
	end 'notReadableThere'

	let regionEnd = dbgLoad(query, offset: DbgMbiOffBaseAddress) + dbgLoad(query, offset: DbgMbiOffRegionSize)
	return address + length <= regionEnd
end 'dbgRegionIsReadable'

function dbgInsideRuntimeSymbol(textOffset DbgWord) returns bool
	let table = __Raw.dbgTextLimit() as DbgWord
	let count = dbgLoad(table, offset: 0) and DbgSymtabEntryCodeOffsetMask

	if count == 0 'noSymbols'
		return false
	end 'noSymbols'

	var low = 0 as DbgWord
	var high = count - 1
	var best = 0 as DbgWord

	while low <= high 'search'
		let middle = (low + high) shr 1
		let entry = dbgLoad(table, offset: DbgSymtabOffEntries + middle * DbgSymtabEntryBytes)

		if (entry and DbgSymtabEntryCodeOffsetMask) <= textOffset 'atOrBelow'
			best = middle
			low = middle + 1
			continue
		end 'atOrBelow'

		high = middle - 1
	end 'search'

	let flags = table + ((dbgLoad(table, offset: 0) shr (DbgSymtabColumnBytes * DbgByteBits)) and DbgSymtabEntryCodeOffsetMask)

	return (dbgLoadByte(flags, offset: best) and DbgSymtabScaffoldingBit) != 0
end 'dbgInsideRuntimeSymbol'

// A command posted while a machine is parked finds the stop lock taken and is left for the park loop; one
// posted while the program runs is answered here.
function dbgServiceMailbox(base DbgWord, private DbgWord)
	let sequence = dbgLoad(base, offset: DbgOffCmdSeq)

	if sequence == dbgLoad(base, offset: DbgOffAckSeq) 'nothingPosted'
		return
	end 'nothingPosted'

	if not dbgTryStopLock(private) 'aMachineOwnsTheMailbox'
		return
	end 'aMachineOwnsTheMailbox'

	let command = dbgLoad(base, offset: DbgOffCmd)

	// A pause is not answered here, only started: the thread it is aimed at has to reach a point where a stop
	// can be delivered, so whichever later poll lands it acknowledges it.
	if command == DbgCmdPause 'startAPause'
		dbgStore(private, offset: DbgPrivOffPauseAttempts, value: 1)
		dbgDropStopLock(private)
		return
	end 'startAPause'

	// Nothing is parked on this thread, so a dispatch asking to leave a park means a resume slipped past the
	// `notRunning` refusals above; the answer is that refusal rather than a resume of nothing.
	if dbgDispatch(base, private: private, command: command, stopKind: DbgStopKindRunning) 'aResumeWithNothingParked'
		dbgRefuse(base, reason: DbgRefusalNotRunning)
	end 'aResumeWithNothingParked'

	dbgStore(base, offset: DbgOffAckStopSeq, value: DbgAnsweredLive)
	dbgStore(base, offset: DbgOffAckSeq, value: sequence)
	dbgDropStopLock(private)
end 'dbgServiceMailbox'

// A pause has two roads and the program's state at the poll picks between them. A machine running user code
// is interrupted where it stands, which is the only road that can report a pc inside the program. A program
// whose machines are all idle has no instruction to interrupt, so the service thread takes the stop itself
// and the roster and the parked threads' saved registers are all such a stop can say.
//
// With no scheduler there is no second road: the one thread is the program, so a stop the service thread
// declared would leave it running and say otherwise. That is what `notPausable` refuses, and a scheduler
// program still on a green thread when the budget runs out is refused for the same reason.
function dbgAdvancePause(base DbgWord, private DbgWord)
	if not dbgTryStopLock(private) 'aStopOwnsTheMailbox'
		return
	end 'aStopOwnsTheMailbox'

	dbgPauseAttempt(base, private: private)
	dbgDropStopLock(private)
end 'dbgAdvancePause'

function dbgPauseAttempt(base DbgWord, private DbgWord)
	if dbgEveryMachineIsIdle() 'theProgramIsIdle'
		let stopped = dbgServiceStop(base, private: private)

		if stopped 'servedWhereItIdled'
			return
		end 'servedWhereItIdled'
	end 'theProgramIsIdle'

	if dbgTryInject(base, private: private) 'landed'
		dbgFinishPause(base, private: private, result: DbgCmdResultDone, reason: 0, answeredUnder: DbgAnsweredLive)
		return
	end 'landed'

	let attempts = dbgLoad(private, offset: DbgPrivOffPauseAttempts) + 1

	if attempts <= DbgPauseAttemptLimit 'tryAgainOnTheNextPoll'
		dbgStore(private, offset: DbgPrivOffPauseAttempts, value: attempts)
		return
	end 'tryAgainOnTheNextPoll'

	var paused = false

	if dbgEveryMachineIsIdle() 'idleAtLast'
		paused = dbgServiceStop(base, private: private)
	end 'idleAtLast'

	if not paused 'noSafePointWasEverReached'
		dbgFinishPause(base, private: private, result: DbgCmdResultRefused, reason: DbgRefusalNotPausable, answeredUnder: DbgAnsweredLive)
	end 'noSafePointWasEverReached'
end 'dbgPauseAttempt'

function dbgEveryMachineIsIdle() returns bool
	let machines = dbgAllMachines()

	return machines != 0 and not dbgSomeMachineRunsUserCode(machines)
end 'dbgEveryMachineIsIdle'

function dbgRequestYield(machine DbgWord)
	if machine == 0 'notAMachine'
		return
	end 'notAMachine'

	let gt = dbgLoad(machine, offset: DbgMOffCurrentGt)

	if gt == 0 or dbgLoad(gt, offset: DbgGtOffStackBase) == 0 'nothingToAsk'
		return
	end 'nothingToAsk'

	dbgStore(gt, offset: DbgGtOffStackGuard, value: DbgGtStackGuardPreempt)
end 'dbgRequestYield'

function dbgMachineRunsUserCode(machine DbgWord) returns bool
	let gt = dbgLoad(machine, offset: DbgMOffCurrentGt)

	return gt != 0 and dbgLoad(gt, offset: DbgGtOffStackBase) != 0
end 'dbgMachineRunsUserCode'

function dbgSomeMachineRunsUserCode(machines DbgWord) returns bool
	var machine = machines

	while machine != 0 'eachMachine'
		if dbgMachineRunsUserCode(machine) 'aRealThreadIsOnIt'
			return true
		end 'aRealThreadIsOnIt'

		machine = dbgLoad(machine, offset: DbgMOffAllNext)
	end 'eachMachine'

	return false
end 'dbgSomeMachineRunsUserCode'

// The pause is acknowledged before the park, so the driver can post the commands this stop exists
// to answer.
function dbgServiceStop(base DbgWord, private DbgWord) returns bool
	dbgStopTheWorld(private)

	// The caller judged the machines idle with the world running, and a green thread between two
	// machines looks idle then. Judged again under the stop, such a thread declines the stop rather
	// than running on under one.
	if dbgSomeGreenThreadCanRun(private) 'aGreenThreadIsBetweenMachines'
		dbgStartTheWorld(private)
		return false
	end 'aGreenThreadIsBetweenMachines'

	// No thread of the program is stopped at an instruction, so there are no registers to report; a file
	// still holding the previous stop's would be read as this one's.
	dbgClearRegisters(base)
	dbgStore(base, offset: DbgOffStopPc, value: 0)
	dbgStore(base, offset: DbgOffStopSp, value: 0)
	dbgStore(base, offset: DbgOffStopFp, value: 0)
	dbgPublishStop(base, reason: DbgStopReasonPause, fault: DbgNoFault, conditionMissed: false)
	dbgFinishPause(base, private: private, result: DbgCmdResultDone, reason: 0, answeredUnder: dbgLoad(base, offset: DbgOffStopSeq))

	dbgPark(base, private: private, stopKind: DbgStopKindNoThread)
	dbgStartTheWorld(private)
	return true
end 'dbgServiceStop'

function dbgSomeGreenThreadCanRun(private DbgWord) returns bool
	let count = dbgLoad(private, offset: DbgPrivOffRosterCount)
	var index = 0 as DbgWord

	while index < count 'eachRecord'
		let gt = dbgRosterEntry(private, index: index)

		if dbgGtIsLive(gt) and dbgLoad(gt, offset: DbgGtOffStatus) != DbgGtStatusWaitingWord and not dbgHoldsThisLife(private, gt: gt) 'itIsRunnable'
			return true
		end 'itIsRunnable'

		index = index + 1
	end 'eachRecord'

	return false
end 'dbgSomeGreenThreadCanRun'

function dbgFinishPause(base DbgWord, private DbgWord, result DbgWord, reason DbgWord, answeredUnder DbgWord)
	dbgStore(private, offset: DbgPrivOffPauseAttempts, value: 0)
	dbgStore(base, offset: DbgOffCmdRefusal, value: reason)
	dbgStore(base, offset: DbgOffCmdResult, value: result)
	dbgStore(base, offset: DbgOffAckStopSeq, value: answeredUnder)
	dbgStore(base, offset: DbgOffAckSeq, value: dbgLoad(base, offset: DbgOffCmdSeq))
end 'dbgFinishPause'

function dbgTryInject(base DbgWord, private DbgWord) returns bool
	let machines = dbgAllMachines()

	if machines == 0 'noSchedulerToAsk'
		return dbgInjectThread(base, private: private, machine: 0, handle: dbgLoad(private, offset: DbgPrivOffMainThreadHandle))
	end 'noSchedulerToAsk'

	var machine = machines

	while machine != 0 'eachMachineTried'
		if dbgMachineRunsUserCode(machine) 'itIsOnAGreenThreadRightNow'
			if dbgInjectThread(base, private: private, machine: machine, handle: dbgLoad(machine, offset: DbgMOffPreemptThreadHandle)) 'landedHere'
				return true
			end 'landedHere'
		end 'itIsOnAGreenThreadRightNow'

		machine = dbgLoad(machine, offset: DbgMOffAllNext)
	end 'eachMachineTried'

	return false
end 'dbgTryInject'

function dbgInjectThread(base DbgWord, private DbgWord, machine DbgWord, handle DbgWord) returns bool
	if handle == 0 'nothingSuspendable'
		return false
	end 'nothingSuspendable'

	if machine != 0 and __Raw.atomicCas((machine + DbgMOffSignalPending) as MachineWord, expected: DbgPreemptClaimFree as MachineWord, replacement: DbgPreemptClaimHeld as MachineWord) == DbgNothing 'aStopIsAlreadyInFlight'
		return false
	end 'aStopIsAlreadyInFlight'

	if not dbgTryTakeExtLock() 'aThreadOfThisProcessIsLeavingIt'
		dbgHandBackSignalPending(machine)
		return false
	end 'aThreadOfThisProcessIsLeavingIt'

	let suspended = __Raw.osDebugHost(DbgVerbSuspendThread, a0: handle as MachineWord, a1: DbgNothing, a2: DbgNothing, a3: DbgNothing) as DbgWord

	if suspended == DbgSuspendFailed 'theThreadIsGone'
		dbgDropExtLock()
		dbgHandBackSignalPending(machine)
		return false
	end 'theThreadIsGone'

	// The request is written while the thread is suspended, and that order is what makes a pause land.
	// `__gt_preempt_safe` requires the guard word to carry the request, but the request is also what makes
	// the thread yield at its next prologue, and a switch-in restores the word — so a request written before
	// the suspend is consumed before the instant is judged. Suspended, the thread cannot reach a prologue,
	// so the conjunct holds by construction and every other one is judged on an instant that cannot move.
	dbgRequestYield(machine)

	let context = private + DbgPrivOffContext
	dbgStore(context, offset: DbgCtxOffFlagsRequest, value: DbgCtxControlRequest)

	var injected = false

	if __Raw.osDebugHost(DbgVerbReadThreadContext, a0: handle as MachineWord, a1: context as MachineWord, a2: DbgNothing, a3: DbgNothing) != DbgNothing 'theInstantIsReadable'
		let pc = dbgLoad(context, offset: DbgCtxOffRip)
		let sp = dbgLoad(context, offset: DbgCtxOffRsp)

		if dbgPauseIsSafe(base, machine: machine, pc: pc, sp: sp) 'aSafePoint'
			let landing = sp - DbgWordBytes
			dbgStore(landing, offset: 0, value: pc)
			dbgStore(context, offset: DbgCtxOffRsp, value: landing)
			dbgStore(context, offset: DbgCtxOffRip, value: dbgLoad(private, offset: DbgPrivOffPauseTrampoline))
			injected = __Raw.osDebugHost(DbgVerbWriteThreadContext, a0: handle as MachineWord, a1: context as MachineWord, a2: DbgNothing, a3: DbgNothing) != DbgNothing
		end 'aSafePoint'
	end 'theInstantIsReadable'

	dbgSinkHostAnswer(__Raw.osDebugHost(DbgVerbResumeThread, a0: handle as MachineWord, a1: DbgNothing, a2: DbgNothing, a3: DbgNothing))
	dbgDropExtLock()

	if not injected 'nothingWillClearTheClaim'
		dbgHandBackSignalPending(machine)
	end 'nothingWillClearTheClaim'

	return injected
end 'dbgInjectThread'

// With a scheduler `__gt_preempt_safe` is the answer. Without one there is no machine and no
// green-thread stack to judge, and what is left is the pc: inside the image's own code, and outside
// the runtime's band, which is where a stop would land on a frame no walk can describe.
function dbgPauseIsSafe(base DbgWord, machine DbgWord, pc DbgWord, sp DbgWord) returns bool
	if machine != 0 'askTheScheduler'
		return __Raw.osDebugHost(DbgVerbPreemptSafe, a0: machine as MachineWord, a1: pc as MachineWord, a2: sp as MachineWord, a3: DbgNothing) != DbgNothing
	end 'askTheScheduler'

	let textBase = dbgLoad(base, offset: DbgOffTextBase)

	if pc < textBase or pc >= textBase + dbgLoad(base, offset: DbgOffTextSize) 'notThisProgramsCode'
		return false
	end 'notThisProgramsCode'

	return not dbgInsideRuntimeSymbol(pc - textBase)
end 'dbgPauseIsSafe'

function dbgSetCondition(base DbgWord, private DbgWord)
	let index = dbgNamedBreakpointOrRefuse(base, private: private)

	if index == DbgNotFound 'nothingArmedThere'
		return
	end 'nothingArmedThere'

	let entry = dbgBreakpointEntry(private, index: index)
	dbgStore(entry, offset: DbgBpOffCondition + DbgCondRecOffOperand, value: dbgLoad(base, offset: DbgOffConditionRecord + DbgCondRecOffOperand))
	dbgStore(entry, offset: DbgBpOffCondition + DbgCondRecOffWidth, value: dbgLoad(base, offset: DbgOffConditionRecord + DbgCondRecOffWidth))
	dbgStore(entry, offset: DbgBpOffCondition + DbgCondRecOffSigned, value: dbgLoad(base, offset: DbgOffConditionRecord + DbgCondRecOffSigned))
	dbgStore(entry, offset: DbgBpOffCondition + DbgCondRecOffOp, value: dbgLoad(base, offset: DbgOffConditionRecord + DbgCondRecOffOp))
	dbgStore(entry, offset: DbgBpOffCondition + DbgCondRecOffLiteral, value: dbgLoad(base, offset: DbgOffConditionRecord + DbgCondRecOffLiteral))

	// The kind goes last because it is what arms the test, so a trap taken on another machine mid-write reads
	// a whole record or none of it.
	dbgStore(entry, offset: DbgBpOffCondition + DbgCondRecOffKind, value: dbgLoad(base, offset: DbgOffConditionRecord + DbgCondRecOffKind))
	dbgAnswerDone(base)
end 'dbgSetCondition'

function dbgHoldReturnPoint(base DbgWord, private DbgWord)
	if dbgNamedBreakpointOrRefuse(base, private: private) == DbgNotFound 'nothingArmedThere'
		return
	end 'nothingArmedThere'

	dbgStore(private, offset: DbgPrivOffReturnHold, value: dbgLoad(base, offset: DbgOffTextBase) + dbgLoad(base, offset: DbgOffCmdArg0))
	dbgAnswerDone(base)
end 'dbgHoldReturnPoint'

function dbgClearCondition(base DbgWord, private DbgWord)
	let index = dbgNamedBreakpointOrRefuse(base, private: private)

	if index == DbgNotFound 'nothingArmedThere'
		return
	end 'nothingArmedThere'

	dbgStore(dbgBreakpointEntry(private, index: index), offset: DbgBpOffCondition + DbgCondRecOffKind, value: DbgCondKindNone)
	dbgAnswerDone(base)
end 'dbgClearCondition'

// A condition the agent cannot evaluate admits the stop. An unknown width, operator or kind, an operand
// outside the register file and an unmapped slot all describe something the driver got wrong, and an extra
// stop is visible where a dropped hit is not.
function dbgConditionAllows(private DbgWord, index DbgWord, context DbgWord) returns bool
	let entry = dbgBreakpointEntry(private, index: index)
	let kind = dbgLoad(entry, offset: DbgBpOffCondition + DbgCondRecOffKind)

	if kind == DbgCondKindNone 'unconditional'
		return true
	end 'unconditional'

	let width = dbgLoad(entry, offset: DbgBpOffCondition + DbgCondRecOffWidth)
	let op = dbgLoad(entry, offset: DbgBpOffCondition + DbgCondRecOffOp)

	if not dbgWidthIsKnown(width) or op < DbgCondOpEqual or op > DbgCondOpGreaterOrEqual 'aRecordTheAgentCannotEvaluate'
		return true
	end 'aRecordTheAgentCannotEvaluate'

	let operand = dbgLoad(entry, offset: DbgBpOffCondition + DbgCondRecOffOperand)
	var raw = 0 as DbgWord

	if kind == DbgCondKindRegister 'aRegister'
		if operand < 0 or operand >= DbgGprCount 'outsideTheGeneralFile'
			return true
		end 'outsideTheGeneralFile'

		raw = dbgLoad(context, offset: DbgCtxOffGpr0 + operand * DbgWordBytes)
	end 'aRegister' else if kind == DbgCondKindStackSlot 'aFrameSlot'
		let at = dbgLoad(context, offset: DbgCtxOffGpr0 + DbgRegRbp * DbgWordBytes) + operand

		if not dbgRegionIsReadable(at, length: DbgWordBytes) 'nothingMappedThere'
			return true
		end 'nothingMappedThere'

		raw = dbgLoad(at, offset: 0)
	end 'aFrameSlot' else 'aKindTheAgentDoesNotEvaluate'
		return true
	end 'aKindTheAgentDoesNotEvaluate'

	let signed = dbgLoad(entry, offset: DbgBpOffCondition + DbgCondRecOffSigned) == DbgCondSignedYes

	return dbgConditionCompare(dbgNarrowToWidth(raw, width: width, signed: signed), literal: dbgLoad(entry, offset: DbgBpOffCondition + DbgCondRecOffLiteral), op: op, signed: signed)
end 'dbgConditionAllows'

function dbgWidthIsKnown(width DbgWord) returns bool
	return width == DbgWidthByte or width == DbgWidthHalf or width == DbgWidthWord32 or width == DbgWidthWord64
end 'dbgWidthIsKnown'

// The four widths are spelled out rather than shifted: a variable shift is a guarded construct, and one here
// would mint a panic string into the `.rdata` of every program this compiler builds.
function dbgNarrowToWidth(value DbgWord, width DbgWord, signed bool) returns DbgWord
	if width == DbgWidthByte 'oneByte'
		return dbgSignExtend(value and DbgByteMask, signBit: DbgByteSignBit, span: DbgByteSpan, signed: signed)
	end 'oneByte'

	if width == DbgWidthHalf 'twoBytes'
		return dbgSignExtend(value and DbgHalfMask, signBit: DbgHalfSignBit, span: DbgHalfSpan, signed: signed)
	end 'twoBytes'

	if width == DbgWidthWord32 'fourBytes'
		return dbgSignExtend(value and DbgDwordMask, signBit: DbgDwordSignBit, span: DbgDwordSpan, signed: signed)
	end 'fourBytes'

	return value
end 'dbgNarrowToWidth'

function dbgSignExtend(masked DbgWord, signBit DbgWord, span DbgWord, signed bool) returns DbgWord
	if not signed or (masked and signBit) == 0 'positiveOrUnsigned'
		return masked
	end 'positiveOrUnsigned'

	return masked - span
end 'dbgSignExtend'

function dbgConditionCompare(value DbgWord, literal DbgWord, op DbgWord, signed bool) returns bool
	if op == DbgCondOpEqual 'equal'
		return value == literal
	end 'equal'

	if op == DbgCondOpNotEqual 'notEqual'
		return value != literal
	end 'notEqual'

	if op == DbgCondOpLess 'less'
		return dbgIsBelow(value, b: literal, signed: signed)
	end 'less'

	if op == DbgCondOpLessOrEqual 'lessOrEqual'
		return not dbgIsBelow(literal, b: value, signed: signed)
	end 'lessOrEqual'

	if op == DbgCondOpGreater 'greater'
		return dbgIsBelow(literal, b: value, signed: signed)
	end 'greater'

	return not dbgIsBelow(value, b: literal, signed: signed)
end 'dbgConditionCompare'

// An unsigned compare built from the signed one: two words whose sign bits differ order by that bit alone,
// and the rest is the ordinary compare. Spelling it this way needs no bias constant.
function dbgIsBelow(a DbgWord, b DbgWord, signed bool) returns bool
	if signed 'signedOrder'
		return a < b
	end 'signedOrder'

	if (a < 0) != (b < 0) 'oneOfThemHasTheTopBit'
		return b < 0
	end 'oneOfThemHasTheTopBit'

	return a < b
end 'dbgIsBelow'

function dbgRosterEntry(private DbgWord, index DbgWord) returns DbgWord
	return __Raw.loadWord((private + DbgPrivOffGtRoster + index * DbgWordBytes) as MachineWord, offset: 0) as DbgWord
end 'dbgRosterEntry'

function dbgRosterHolds(private DbgWord, handle DbgWord) returns bool
	if handle == 0 'noHandle'
		return false
	end 'noHandle'

	let count = dbgLoad(private, offset: DbgPrivOffRosterCount)
	var index = 0 as DbgWord

	while index < count 'eachRecord'
		if dbgRosterEntry(private, index: index) == handle 'itIsThisOne'
			return true
		end 'itIsThisOne'

		index = index + 1
	end 'eachRecord'

	return false
end 'dbgRosterHolds'

// Nothing stores `running`: a green thread is running exactly when some machine names it as the one it is
// on, so the answer is a walk of the machine roster rather than a word in the record.
function dbgMachineRunning(gt DbgWord) returns DbgWord
	var machine = dbgAllMachines()

	while machine != 0 'eachMachine'
		if dbgLoad(machine, offset: DbgMOffCurrentGt) == gt 'thisMachineIsOnIt'
			return machine
		end 'thisMachineIsOnIt'

		machine = dbgLoad(machine, offset: DbgMOffAllNext)
	end 'eachMachine'

	return 0
end 'dbgMachineRunning'

// A zero handle marks an empty slot and is never a thread, so searching for one would answer "held" for
// every thread the table has no room for.
function dbgHoldSlotOf(private DbgWord, handle DbgWord) returns DbgWord
	if handle == 0 'noHandle'
		return DbgNotFound
	end 'noHandle'

	for slot in 0 upto DbgHoldCapacity 'eachSlot'
		if dbgHoldSlot(private, slot: slot as DbgWord) == handle 'itIsThisOne'
			return slot as DbgWord
		end 'itIsThisOne'
	end 'eachSlot'

	return DbgNotFound
end 'dbgHoldSlotOf'

function dbgFreeHoldSlot(private DbgWord) returns DbgWord
	for slot in 0 upto DbgHoldCapacity 'eachSlot'
		if dbgHoldSlot(private, slot: slot as DbgWord) == 0 'free'
			return slot as DbgWord
		end 'free'
	end 'eachSlot'

	return DbgNotFound
end 'dbgFreeHoldSlot'

function dbgHoldSlotAddr(private DbgWord, slot DbgWord) returns DbgWord
	return private + DbgPrivOffHold + slot * DbgHoldSlotBytes
end 'dbgHoldSlotAddr'

function dbgHoldSlot(private DbgWord, slot DbgWord) returns DbgWord
	return dbgLoad(dbgHoldSlotAddr(private, slot: slot), offset: DbgHoldOffHandle)
end 'dbgHoldSlot'

function dbgGtList(base DbgWord, private DbgWord, stopKind DbgWord)
	let count = dbgLoad(private, offset: DbgPrivOffRosterCount)
	let stopThread = dbgLoad(private, offset: DbgPrivOffStopThreadId)
	var truncated = dbgLoad(private, offset: DbgPrivOffRosterTruncated)
	var written = 0 as DbgWord
	var index = 0 as DbgWord

	while index < count 'eachRecord'
		let gt = dbgRosterEntry(private, index: index)
		index = index + 1

		if not dbgGtIsLive(gt) 'notAThreadAnyoneCanAskAbout'
			continue
		end 'notAThreadAnyoneCanAskAbout'

		if written >= DbgGtRecordCapacity 'thePageIsFull'
			truncated = 1
			continue
		end 'thePageIsFull'

		let machine = dbgMachineRunning(gt)
		let status = dbgLoad(gt, offset: DbgGtOffStatus)

		let record = base + DbgOffGtRecords + written * DbgGtRecordStride
		dbgStore(record, offset: DbgGtRecOffHandle, value: gt)
		dbgStore(record, offset: DbgGtRecOffStatus, value: dbgReportedStatus(private, gt: gt, machine: machine, status: status))
		dbgStore(record, offset: DbgGtRecOffEntryPc, value: dbgLoad(gt, offset: DbgGtOffFuncPtr))
		dbgStore(record, offset: DbgGtRecOffParkKind, value: dbgLoad(gt, offset: DbgGtOffParkKind))
		dbgStore(record, offset: DbgGtRecOffMachine, value: 0 if machine == 0 else dbgLoad(machine, offset: DbgMOffOsThreadId))

		// A thread another machine is running has its registers in that machine and nowhere this agent can
		// read, so it reports none rather than the stale pair its record still carries.
		if machine == 0 'parked'
			dbgStore(record, offset: DbgGtRecOffSavedSp, value: dbgLoad(gt, offset: DbgGtOffSp))
			dbgStore(record, offset: DbgGtRecOffSavedFp, value: dbgLoad(gt, offset: DbgGtOffFp))
		end 'parked' else if stopKind == DbgStopKindThread and dbgLoad(machine, offset: DbgMOffOsThreadId) == stopThread 'theStoppingMachine'
			dbgStore(record, offset: DbgGtRecOffSavedSp, value: dbgLoad(base, offset: DbgOffStopSp))
			dbgStore(record, offset: DbgGtRecOffSavedFp, value: dbgLoad(base, offset: DbgOffStopFp))
		end 'theStoppingMachine' else 'runningElsewhere'
			dbgStore(record, offset: DbgGtRecOffSavedSp, value: 0)
			dbgStore(record, offset: DbgGtRecOffSavedFp, value: 0)
		end 'runningElsewhere'

		written = written + 1
	end 'eachRecord'

	dbgStore(base, offset: DbgOffGtCount, value: written)
	dbgStore(base, offset: DbgOffGtTruncated, value: truncated)
	dbgAnswerDone(base)
end 'dbgGtList'

// The one test for a thread anyone can ask about, shared by the three commands that ask: `gtList` omitting
// a record while `gtHold` accepted it is how a driver comes to name a thread that no longer exists. A
// record with no stack is a machine's own scheduler context or a reply cell, and a completed one is a life
// that has ended; the roster keeps both, because it registers an address and the address outlives every
// thread that occupies it.
function dbgGtIsLive(gt DbgWord) returns bool
	if gt == 0 or dbgLoad(gt, offset: DbgGtOffStackBase) == 0 'notAGreenThread'
		return false
	end 'notAGreenThread'

	return dbgLoad(gt, offset: DbgGtOffStatus) != DbgGtStatusCompletedWord
end 'dbgGtIsLive'

function dbgReportedStatus(private DbgWord, gt DbgWord, machine DbgWord, status DbgWord) returns DbgWord
	if machine != 0 'onAMachine'
		return DbgGtStatusRunning
	end 'onAMachine'

	if dbgHoldsThisLife(private, gt: gt) 'theDriverIsHoldingIt'
		return DbgGtStatusHeld
	end 'theDriverIsHoldingIt'

	return DbgGtStatusWaiting if status == DbgGtStatusWaitingWord else DbgGtStatusReady
end 'dbgReportedStatus'

function dbgGtBacktrace(base DbgWord, private DbgWord, stopKind DbgWord)
	let handle = dbgLoad(base, offset: DbgOffCmdArg0)

	if not dbgRosterHolds(private, handle: handle) or not dbgGtIsLive(handle) 'nobodyCarvedThatOrItIsOver'
		dbgRefuse(base, reason: DbgRefusalNoSuchThread)
		return
	end 'nobodyCarvedThatOrItIsOver'

	let machine = dbgMachineRunning(handle)

	if machine == 0 'parked'
		dbgWalkFrames(base, frame: dbgLoad(handle, offset: DbgGtOffFp))
		return
	end 'parked'

	// The stopping machine's own thread has its registers on the page; any other machine's are in a
	// suspended register file this walk has no seed from.
	if stopKind != DbgStopKindThread or dbgLoad(machine, offset: DbgMOffOsThreadId) != dbgLoad(private, offset: DbgPrivOffStopThreadId) 'anotherMachineIsOnIt'
		dbgRefuse(base, reason: DbgRefusalThreadIsRunning)
		return
	end 'anotherMachineIsOnIt'

	dbgWalkFrames(base, frame: dbgLoad(base, offset: DbgOffStopFp))
end 'dbgGtBacktrace'

function dbgGtHold(base DbgWord, private DbgWord)
	let handle = dbgLoad(base, offset: DbgOffCmdArg0)

	if not dbgRosterHolds(private, handle: handle) or not dbgGtIsLive(handle) 'nobodyCarvedThatOrItIsOver'
		dbgRefuse(base, reason: DbgRefusalNoSuchThread)
		return
	end 'nobodyCarvedThatOrItIsOver'

	if dbgMachineRunning(handle) != 0 'itIsRunningRightNow'
		dbgRefuse(base, reason: DbgRefusalThreadIsRunning)
		return
	end 'itIsRunningRightNow'

	if dbgHoldsThisLife(private, gt: handle) 'alreadyHeld'
		dbgAnswerDone(base)
		return
	end 'alreadyHeld'

	let lapsed = dbgHoldSlotOf(private, handle: handle)
	let free = lapsed if lapsed != DbgNotFound else dbgFreeHoldSlot(private)

	if free == DbgNotFound 'noRoom'
		dbgRefuse(base, reason: DbgRefusalHoldTableFull)
		return
	end 'noRoom'

	// The two witnesses are what make a hold lapse instead of catching a stranger: a recycle zeroes the record
	// and the next spawn writes its own entry function and stack at the same address.
	let at = dbgHoldSlotAddr(private, slot: free)
	dbgStore(at, offset: DbgHoldOffFuncPtr, value: dbgLoad(handle, offset: DbgGtOffFuncPtr))
	dbgStore(at, offset: DbgHoldOffStackBase, value: dbgLoad(handle, offset: DbgGtOffStackBase))
	dbgStore(at, offset: DbgHoldOffHandle, value: handle)

	if lapsed == DbgNotFound 'aNewSlot'
		dbgStore(private, offset: DbgPrivOffHoldsPlaced, value: dbgLoad(private, offset: DbgPrivOffHoldsPlaced) + 1)
	end 'aNewSlot'

	dbgAnswerDone(base)
end 'dbgGtHold'

function dbgHoldsThisLife(private DbgWord, gt DbgWord) returns bool
	let slot = dbgHoldSlotOf(private, handle: gt)

	if slot == DbgNotFound 'nobodyHoldsThisAddress'
		return false
	end 'nobodyHoldsThisAddress'

	let at = dbgHoldSlotAddr(private, slot: slot)

	return dbgLoad(at, offset: DbgHoldOffFuncPtr) == dbgLoad(gt, offset: DbgGtOffFuncPtr) and dbgLoad(at, offset: DbgHoldOffStackBase) == dbgLoad(gt, offset: DbgGtOffStackBase)
end 'dbgHoldsThisLife'

function dbgGtRelease(base DbgWord, private DbgWord)
	let slot = dbgHoldSlotOf(private, handle: dbgLoad(base, offset: DbgOffCmdArg0))

	if slot == DbgNotFound 'nothingHeldThere'
		dbgRefuse(base, reason: DbgRefusalNoSuchThread)
		return
	end 'nothingHeldThere'

	// Nothing is enqueued and nobody is woken: the thread never left the scheduler's structures, so the
	// next dequeue that comes round to it simply stops being refused.
	dbgStore(dbgHoldSlotAddr(private, slot: slot), offset: DbgHoldOffHandle, value: 0)
	dbgStore(private, offset: DbgPrivOffHoldsPlaced, value: dbgLoad(private, offset: DbgPrivOffHoldsPlaced) - 1)
	dbgAnswerDone(base)
end 'dbgGtRelease'
