# EditorConfig for Maxon compiler project
# https://editorconfig.org

root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.maxon]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
