// What `maxon run <task>` offers at the repository root. This file marks no project: the compiler's
// own is `maxon-bin/`, and its `project.maxon` is what `build` hands the build to.
export function build() returns ExitCode
	Build.delegate("maxon-bin", directory: "maxon-bin")
	return 0
end 'build'

let ExtensionDirectory = "vscode-extension"
let ExtensionPackageFileName = "maxon-lsp-client.vsix"
let TaskSucceeded = 0 as ExitCode
let TaskFailed = 1 as ExitCode

export function buildExtension() returns ExitCode
	return taskExitCode(packageExtension())
end 'buildExtension'

export function installExtension() returns ExitCode
	return taskExitCode(packageExtension() and runInExtensionDirectory("code", arguments: ["--install-extension", ExtensionPackageFileName, "--force"]))
end 'installExtension'

// `npm install` runs first so a fresh clone packages.
function packageExtension() returns bool
	return runInExtensionDirectory("npm", arguments: ["install"]) and runInExtensionDirectory("npm", arguments: ["run", "package", "--", "--out", ExtensionPackageFileName])
end 'packageExtension'

function taskExitCode(succeeded bool) returns ExitCode
	return TaskSucceeded if succeeded else TaskFailed
end 'taskExitCode'

function runInExtensionDirectory(program String, arguments StringArray) returns bool
	var commandLine = program.clone()

	for argument in arguments 'eachArgument'
		commandLine.append(" {argument}")
	end 'eachArgument'

	var configuration = Configuration.create(Executable.name(program))
	configuration.arguments = arguments
	configuration.workingDirectory = try FilePath.from(ExtensionDirectory) otherwise panic("runInExtensionDirectory: '{ExtensionDirectory}' is a well-formed relative path")
	configuration.standardOutput = OutputDestination.inherit
	configuration.standardError = OutputDestination.inherit

	let outcome = try configuration.run() otherwise (e) 'couldNotRun'
		printError("{commandLine}: {e.displayReason()}\n")
		return false
	end 'couldNotRun'

	if not outcome.succeeded() 'failed'
		printError("{commandLine} exited with {outcome.exitCode()}\n")
		return false
	end 'failed'

	return true
end 'runInExtensionDirectory'
