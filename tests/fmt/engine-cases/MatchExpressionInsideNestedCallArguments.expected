function batchCallLine(execution Execution) returns String
	var line = StringBuilder.create()
	line.append(shQuoted(match execution.procs 'procs'
		unset gives ""
		pinned(count) gives "{count}"
	end 'procs'))

	line.append(" ")
	line.append(shQuoted(match execution.preempt 'preempt'
		unset gives ""
		off gives "off"
	end 'preempt'))

	line.append(wrapped(inner(match execution.mode 'mode'
		fast gives "f"
		slow gives "s"
	end 'mode')))

	return line.build()
end 'batchCallLine'
