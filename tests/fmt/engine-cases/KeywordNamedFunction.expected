typealias Offset = int(0 to 255)

type Block
	export var offset as Offset

	export function with(offset Offset) returns Block
		return Block{offset: offset}
	end 'with'

	export function use() returns Block
		return self.with(1)
	end 'use'

	static function from(offset Offset) returns Block
		return Block{offset: offset}
	end 'from'

	static function to(offset Offset) returns Block
		return Block.from(offset)
	end 'to'
end 'Block'

function opensAClosure(kind TokenKind, flag bool) returns bool
	return kind == TokenKind.function and (flag or kind == TokenKind.type)
end 'opensAClosure'
