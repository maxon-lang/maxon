// A comment that continues an arm's pattern chain takes no forced blank line before it, and keeps the author's own.
module function classify(op StdOp) returns bool
	match op 'op'
		add or
		// A comment between two alternatives stays inside the chain.
		sub or
		mul then return true
		div or

		// The author's own blank line before one is kept.
		mod then return false
		default panic("unreachable")
	end 'op'
end 'classify'
