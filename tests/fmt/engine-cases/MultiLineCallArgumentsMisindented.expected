typealias Integer = int(i64.min to i64.max)

function pair(a Integer, b Integer) returns Integer
	return a * 10 + b
end 'pair'

function main() returns ExitCode
	let flat = pair(
		1,
		b: 2
	)

	let deep = pair(
		3,
		b: 4
	)

	let blanks = pair(5,

		b: 6
	)

	return (flat + deep + blanks) as ExitCode
end 'main'
