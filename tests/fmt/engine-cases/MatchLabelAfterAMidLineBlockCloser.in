enum Mode
	fast
	slow
end 'Mode'

function pair(a String, b String) returns String
	return "{a}{b}"
end 'pair'

function id(s String) returns String
	return s
end 'id'

function f(a Mode, b Mode) returns String
	return pair(id(match a 'a'
		fast gives "f"
		slow gives "s"
	end 'a'), b: id(id(match b 'b'
		fast gives "f"
		slow gives "s"
	end 'b')))
end 'f'

function main() returns ExitCode
	print("{f(Mode.fast, b: Mode.slow)}\n")
	return 0
end 'main'
