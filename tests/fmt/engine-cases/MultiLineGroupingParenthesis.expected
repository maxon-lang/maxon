function main() returns ExitCode
	let a = 3
	let split = (a +
		4) * 2

	let leading = (
		a
		+ 4
	) * (a
		- 1)

	let pair = (
		a,
		split
	)

	if (a > 1 and
		split > 1) 'both'
		print("both\n")
	end 'both'

	let nested = ((a +
		1) *
		(split
			- 2))

	return (split + leading + pair.0 + nested) mod 200
end 'main'
