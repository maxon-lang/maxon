typealias Grid   =   Array   with   readonly   (  Array with ByteArray  )
typealias Table   =   Map   with   (  String ,  readonly   ByteArray  )
typealias Keyed=Map with String,readonly Grid

function readonly(value Count) returns Count
	return value
end 'readonly'

function pass(value Count) returns Count
	return value
end 'pass'

function pair(first Count, second Count) returns Count
	return first + second
end 'pair'

function tableSize(grid Grid, table Table, keyed Keyed) returns Count
	return grid.count() + table.count() + keyed.count()
end 'tableSize'

function widthOfGrid() returns Count
	return sizeof(Grid)
end 'widthOfGrid'

function main() returns ExitCode
	let x = 3 as Count
	let a = pass(readonly(x))
	let b = pair(readonly(x), second: readonly   (x))
	let c = max(a, readonly(x))
	let d = min(readonly(x), b)
	let e = pass((readonly(x)))
	let f = (readonly(x), readonly(a))
	let g = [readonly(x), readonly(b)]
	let h = pass(pass(readonly(a)))
	let i = pass(readonly (b))
	let j = readonly(e) + readonly(f.0) + readonly(g.count()) + readonly(h) + readonly(i)
	print("{tableSize(Grid.create(), table: Table.create(), keyed: Keyed.create())} {widthOfGrid()} {j} {c + d}\n")
	return 0
end 'main'
