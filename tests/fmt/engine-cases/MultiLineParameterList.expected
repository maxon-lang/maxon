typealias Integer = int(i64.min to i64.max)
typealias Combine = function(Integer,
	Integer
) returns Integer

function add(
	a Integer,
	b Integer
) returns Integer
	return a + b
end 'add'

type Box
	var n as Integer

	static function create(
		n Integer
	) returns Self
		return Self{n: n}
	end 'create'

	function plus(a Integer,
		b Integer) returns Integer
		return self.n + a + b
	end 'plus'
end 'Box'

interface Scaler
	function scale(
		factor Integer,
		offset Integer
	) returns Integer
end 'Scaler'

function main() returns ExitCode
	let double = function(
		x Integer
	) gives x * 2

	let box = Box.create(
		double(2)
	)

	return box.plus(
		1,
		b: add(
			2,
			b: 3
		)
	) as ExitCode
end 'main'
