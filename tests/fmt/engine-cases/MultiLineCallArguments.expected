typealias Integer = int(i64.min to i64.max)

function pair(a Integer, b Integer) returns Integer
	return a * 10 + b
end 'pair'

function ping() returns Integer
	return 1
end 'ping'

function main() returns ExitCode
	let emptied = ping(
	)

	let commented = ping(
		// nothing to pass
	)

	let each = pair(
		1,
		b: 2
	)

	let afterAComma = pair(3,
		b: 4)

	let beforeTheClose = pair(5, b: 6
	)

	let nested = pair(
		pair(
			7,
			b: 8
		),
		b: 9
	)

	if pair(
		1,
		b: 2
	) == 12 'hit'
		print("hit\n")
	end 'hit'

	return (emptied + commented + each + afterAComma + beforeTheClose + nested) as ExitCode
end 'main'
