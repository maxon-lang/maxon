typealias Index = Map with (String, readonly Entry)
typealias ByName = Map with (ByteArray, readonly Entry)
typealias Wide = Map with (String, readonly (Array with readonly ByteArray))
typealias Keyed = Map with ByteArray, readonly (Map with (String, readonly Entry))

function main() returns ExitCode
	let readonly = 3
	return readonly
end 'main'
