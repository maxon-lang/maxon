function frozenBytes(text String) returns immutable ByteArray
	return freeze (try text.toByteArray() otherwise ByteArray.create(0))
end 'frozenBytes'

function movedOut(box isolated Box) returns Box
	return merge (box)
end 'movedOut'

function callsAFunction(items Pile) returns Count
	return freeze(items)
end 'callsAFunction'

function callsAMember(items Pile) returns Count
	return items.freeze (3)
end 'callsAMember'
