typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

function apply(f function(Integer) returns Integer, n Integer, extra Integer) returns Integer
	return f(n) + extra
end 'apply'

function pair(a Integer, b Integer) returns Integer
	return a * 10 + b
end 'pair'

function main() returns ExitCode
	var xs = IntArray.create()
	xs.push(1)
	let k = 2
	let total = apply(
		function(x) gives x + 1,
			n: match k 'pick'
			1 gives pair(
				1,
				b: 2
			)
			default gives 3
		end 'pick',
		extra: try xs.get(5) otherwise 'missing'
			if xs.count() > 0 'some'
				print("some\n")
			end 'some'
			return 1
		end 'missing'
	)
	return total as ExitCode
end 'main'
