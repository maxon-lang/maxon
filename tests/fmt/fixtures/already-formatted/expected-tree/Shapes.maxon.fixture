/// A thing.
///
/// More about it.
export let Thing = 1

export enum Kind
	function
	type
	match
	interface
end 'Kind'

export function span(from int, to int) returns int
	let pending = to - from
	let r = int(0 to -5)
	return pending + r
end 'span'

export function pick(op StdOp, k Kind) returns int
	let m = match op 'op'
		mod(result, lhs, rhs) then compute(lhs, rhs)
		default then -1
	end 'op'
	let w = x mod (y + 1)
	let n = sizeof(Node)
	let c = countof(Self)
	let v = try compute() otherwise (e) 'f'
		return 0
	end 'f'
	return m + w + n + c + v
end 'pick'
