let OwnTypeNamesReusedPassLine = "verify-warm-rebuild: PASS (determinism + cache + invalidation + warm equals cold + library parses reused across programs)"

test 'a second program whose own type names differ from the first one and outnumber them still reuses every library parse'
	let staged = stagedFixture("own-type-names", caseLabel: "a-second-program-with-different-type-names-reuses-library-parses")
	let run = spawnVerify(staged)

	Expect.contains(run.stdout, needle: OwnTypeNamesReusedPassLine, message: "`{TestedCompilerStem} {VerifyCommandName}` did not report every library parse reused by a second program that declares an enum, a type, an interface and more before the first program's own type names. It printed: {run.stdout} — and wrote to stderr: {run.stderr}")
	Expect.equal(run.exitCode(), expected: 0, message: "`{TestedCompilerStem} {VerifyCommandName}` exited {run.exitCode()}. It wrote to stderr: {run.stderr}")
end 'a second program whose own type names differ from the first one and outnumber them still reuses every library parse'
