// warm-equals-cold.maxtest — `verify-warm-rebuild` holds on a program whose parses mint instances.
//
// A parse memo outlives the signature index it was parsed against: an edit to one file's BYTES rebuilds the
// index and leaves every other file's parse reused. Whatever a reused artifact says about the index — the
// instance ids its parse minted — has to mean the same thing in the rebuilt one, and the only thing that can
// see that is comparing what a warm compile EMITS with what a cold compile of the same sources emits. The
// driver's fourth property does exactly that; this case points it at a fixture where it can fail.
//
// ⛔ **THE FIXTURE IS THE CASE.** Two files, each parse minting an instance no declaration names (a holder's cell
// read through a concrete holder), and the edited file LAST in fold order — so its re-parse runs after the
// reused artifact's, which is where an id can be claimed twice.

// What the driver prints for the property this case exists for.
let WarmPassLine = "PASS warm:"

test 'a warm compile after a bytes-only edit emits what a cold compile of the edited program emits'
	let staged = stagedFixture("nested", caseLabel: "warm-equals-cold")
	let run = spawnVerify(staged)

	Expect.contains(run.stdout, needle: WarmPassLine, message: "`{TestedCompilerStem} {VerifyCommandName}` did not report the warm-equals-cold property as holding on a program whose parses mint instances. It printed: {run.stdout} — and wrote to stderr: {run.stderr}")
	Expect.contains(run.stdout, needle: VerdictPassLine, message: "`{TestedCompilerStem} {VerifyCommandName}` did not pass as a whole. It printed: {run.stdout} — and wrote to stderr: {run.stderr}")
	Expect.equal(run.exitCode() as AssertedInt, expected: 0, message: "`{TestedCompilerStem} {VerifyCommandName}` exited {run.exitCode()}. It wrote to stderr: {run.stderr}")
end 'a warm compile after a bytes-only edit emits what a cold compile of the edited program emits'
