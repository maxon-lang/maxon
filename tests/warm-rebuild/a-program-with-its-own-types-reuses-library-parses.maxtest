let OwnTypesReusedPassLine = "verify-warm-rebuild: PASS (determinism + cache + invalidation + warm equals cold + library parses reused across programs)"

test 'a program that declares its own types, enums, unions, aliases and generic instances still reuses every library parse'
	let staged = stagedFixture("own-types", caseLabel: "a-program-with-its-own-types-reuses-library-parses")
	let run = spawnVerify(staged)

	Expect.contains(run.stdout, needle: OwnTypesReusedPassLine, message: "`{TestedCompilerStem} {VerifyCommandName}` did not report every library parse reused by a second program that declares its own struct, enum, union, ranged typealias and instances of them. It printed: {run.stdout} — and wrote to stderr: {run.stderr}")
	Expect.equal(run.exitCode(), expected: 0, message: "`{TestedCompilerStem} {VerifyCommandName}` exited {run.exitCode()}. It wrote to stderr: {run.stderr}")
end 'a program that declares its own types, enums, unions, aliases and generic instances still reuses every library parse'
