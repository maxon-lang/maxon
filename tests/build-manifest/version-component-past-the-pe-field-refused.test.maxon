// version-component-past-the-pe-field-refused.test.maxon — a manifest `version` with a component a PE
// version field cannot hold (each is 16 bits) is refused for a Windows target, rather than stamped as 0.

let PeFieldRefusalWording = "`version` component `70000` does not fit"

test 'a manifest version component past the PE field is refused'
	let staged = stagedProject("version-component-past-the-pe-field-refused", fixture: VersionPastThePeFieldFixtureName)

	requireRefused(staged, options: [PeTargetOption], exitCode: RefusedExitCode, wordings: [PeFieldRefusalWording], what: "maxon build {PeTargetOption}")
end 'a manifest version component past the PE field is refused'
