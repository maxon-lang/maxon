#if not os(Windows)
	test 'a manifest build takes over a tree lock that names its own process id, and says so'
		let staged = stagedProject("tree-lock-naming-the-builds-own-process-is-taken-over", fixture: DefaultFixtureName)

		let build = spawnManifestBuildUnderARecordOfItsOwnPid(staged)
		requireBuiltPastTheLock(staged, build: build, wordings: [TreeLockOwnProcessWording], what: "names the build's own process id under another token")
	end 'a manifest build takes over a tree lock that names its own process id, and says so'
#endif
