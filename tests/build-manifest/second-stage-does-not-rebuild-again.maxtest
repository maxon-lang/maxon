let CaseDirName = "second-stage-does-not-rebuild-again"
let SecondStageVariable = "MAXON_SECOND_STAGE"
let SecondStageValue = "1"

test 'a build already in its second stage does not run its output again'
	let staged = stagedProject(CaseDirName, fixture: RebuildWithOutputFixtureName)

	let build = spawnManifestBuild(staged, options: StringArray.create(), environment: [SecondStageVariable: SecondStageValue])
	let said = "It wrote to stdout: {build.stdout} and to stderr: {build.stderr}"

	Expect.equal(build.exitCode(), expected: 0, message: "`maxon build` with {SecondStageVariable} already set, over a manifest asking to rebuild with its output, did not exit with the build's own success. {said}")
	Expect.isTrue(File.exists(builtExecutable(staged)), message: "`maxon build` with {SecondStageVariable} already set wrote no {builtExecutable(staged).toString()}. {said}")
	Expect.isFalse(File.exists(staged.join(RebuildWithOutputMarkerFileName)), message: "`maxon build` with {SecondStageVariable} already set ran the program it wrote: a second stage never starts a third. {said}")
end 'a build already in its second stage does not run its output again'
