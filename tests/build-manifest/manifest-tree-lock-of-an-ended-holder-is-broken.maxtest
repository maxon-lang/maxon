test 'a manifest build breaks a tree lock whose holder has ended'
	let staged = stagedProject("tree-lock-of-an-ended-holder-is-broken", fixture: DefaultFixtureName)
	plantTreeLockOfEndedHolder(staged)

	let build = spawnManifestBuild(staged, options: StringArray.create())
	requireBuiltPastTheLock(staged, build: build, wordings: [TreeLockEndedHolderWording], what: "names a process that has ended")
end 'a manifest build breaks a tree lock whose holder has ended'
