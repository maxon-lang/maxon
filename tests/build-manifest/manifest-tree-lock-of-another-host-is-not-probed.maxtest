test 'a manifest build leaves a live tree lock taken on another host to its heartbeat'
	let staged = stagedProject("tree-lock-of-another-host-is-not-probed", fixture: DefaultFixtureName)
	plantTreeLockOfAnotherHostsHolder(staged)

	requireRefused(staged, options: StringArray.create(), exitCode: NothingRanExitCode, wordings: [TreeLockBusyWording, TreeLockUnprobedHolderWording], what: "maxon build")
end 'a manifest build leaves a live tree lock taken on another host to its heartbeat'
