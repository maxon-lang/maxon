// manifest-source-not-a-string-refused.test.maxon — a build description whose `sources` holds something
// that is not a string is refused as malformed, not reported as an invalid path.

let SourcesRefusalWording = "`sources` is not a list of strings"

test 'a manifest source that is not a string is refused'
	let staged = stagedProject("source-not-a-string-refused", fixture: SourceNotAStringFixtureName)

	try requireRefused(staged, options: StringArray.create(), exitCode: RefusedExitCode, wordings: [SourcesRefusalWording], what: "maxon build")
end 'a manifest source that is not a string is refused'
