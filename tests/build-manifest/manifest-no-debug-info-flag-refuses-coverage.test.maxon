// manifest-no-debug-info-flag-refuses-coverage.test.maxon — `--coverage --no-debug-info` is refused when
// the build is a manifest's, exactly as when it names a path. The manifest says nothing about debug info,
// so the command line is the only thing turning the sidecar off.

test 'coverage with no-debug-info is refused over a manifest'
	let staged = stagedProject("no-debug-info-flag-refuses-coverage", fixture: DefaultFixtureName)

	var options = StringArray.create()
	options.push(CoverageFlag)
	options.push(NoDebugInfoFlag)

	try requireRefused(staged, options: options, exitCode: RefusedExitCode, wording: CoverageNeedsDebugInfoWording, what: "maxon build {CoverageFlag} {NoDebugInfoFlag}")
end 'coverage with no-debug-info is refused over a manifest'
