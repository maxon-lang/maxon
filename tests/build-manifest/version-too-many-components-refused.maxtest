// version-too-many-components-refused.maxtest — a manifest `version` with more components than a PE
// version resource holds (four) is refused for a Windows target, rather than stamped without the rest.

let VersionTooManyComponentsFixtureName = "version-too-many-components"
let TooManyComponentsRefusalWording = "`version` has 5 components"

test 'a manifest version with more components than the PE field is refused'
	let staged = stagedProject("version-too-many-components-refused", fixture: VersionTooManyComponentsFixtureName)

	requireRefused(staged, options: [PeTargetOption], exitCode: RefusedExitCode, wordings: [TooManyComponentsRefusalWording], what: "maxon build {PeTargetOption}")
end 'a manifest version with more components than the PE field is refused'
