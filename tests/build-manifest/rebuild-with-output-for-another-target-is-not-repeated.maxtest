let CaseDirName = "rebuild-with-output-for-another-target-is-not-repeated"
let NotRepeatedWording = "Not repeating this build with the program it wrote:"

function otherTargetOption() returns String
	#if os(Windows)
		let option = MachOTargetOption
	#else
		let option = PeTargetOption
	#endif

	return option
end 'otherTargetOption'

test 'a build asking to rebuild with its output does not run an output built for another target'
	let staged = stagedProject(CaseDirName, fixture: RebuildWithOutputFixtureName)
	let otherTarget = otherTargetOption()

	let build = spawnManifestBuild(staged, options: [otherTarget])
	let said = "It wrote to stdout: {build.stdout} and to stderr: {build.stderr}"

	Expect.equal(build.exitCode(), expected: 0, message: "`maxon build {otherTarget}` over a manifest asking to rebuild with its output did not exit with the build's own success. {said}")
	Expect.contains(build.stdout, needle: NotRepeatedWording, message: "`maxon build {otherTarget}` did not say why the program it wrote was not run. {said}")
	Expect.isFalse(File.exists(staged.join(RebuildWithOutputMarkerFileName)), message: "`maxon build {otherTarget}` ran the program it wrote, which this host cannot run. {said}")
end 'a build asking to rebuild with its output does not run an output built for another target'
