// A define with no `=` names no value. `program` is `BuildManifestHarness.maxon`'s `BuiltStem`.
export typealias ExitCode = int(0 to 255)
typealias StringArray = Array with String

export function build() returns ExitCode
	var defines = StringArray.create()
	defines.push("Greeting")
	Build.build(".", output: "program", defines: defines)
	return 0
end 'build'
