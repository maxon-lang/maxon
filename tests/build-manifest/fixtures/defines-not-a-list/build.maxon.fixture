// A build description written by hand, because `Build` cannot write `defines` that are not a list.
// `program` is `BuildManifestHarness.maxon`'s `BuiltStem`.
typealias ExitCode = int(0 to 255)

export function build() returns ExitCode
	print("\{\"name\": \".\", \"output\": \"program\", \"sources\": [\".\"], \"debug_info\": true, \"version\": \"\", \"defines\": \"Greeting=hi\"\}")
	return 0
end 'build'
