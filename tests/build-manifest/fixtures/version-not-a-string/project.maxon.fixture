// A build description written by hand, because `Build` cannot write a `version` that is not a string.
// `program` is `BuildManifestHarness.maxon`'s `BuiltStem`.
export typealias ExitCode = int(0 to 255)

export function build() returns ExitCode
	let destination = try Process.environmentVariable("MAXON_BUILD_DESCRIPTION") otherwise return 1
	let path = try FilePath.from(destination) otherwise return 1
	try File.writeText(path, content: "\{\"name\": \".\", \"output\": \"program\", \"sources\": [\".\"], \"debug_info\": true, \"version\": 3, \"defines\": []\}") otherwise return 1
	return 0
end 'build'
