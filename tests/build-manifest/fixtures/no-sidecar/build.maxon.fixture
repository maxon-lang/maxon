// The manifest opts out of the debug-info sidecar itself, with nothing on the command line saying so.
// `program` is `BuildManifestHarness.maxon`'s `BuiltStem`.
typealias ExitCode = int(0 to 255)

export function build() returns ExitCode
	Build.build(".", output: "program", debugInfo: false)
	return 0
end 'build'
