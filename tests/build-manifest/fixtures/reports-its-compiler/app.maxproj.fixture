export typealias ExitCode = int(0 to 255)

let CompilerVariable = "MAXON_COMPILER"
let Unset = "<unset>"

export function build() returns ExitCode
	let compiler = try Process.environmentVariable(CompilerVariable) otherwise Unset
	print("{CompilerVariable}=[{compiler}]\n")
	Build.build(".", output: "program")
	return 0
end 'build'
