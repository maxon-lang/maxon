// A build description written by hand, because `Build` cannot write a source that is not a string.
// `program` is `BuildManifestHarness.maxon`'s `BuiltStem`.
typealias ExitCode = int(0 to 255)

export function build() returns ExitCode
	print("\{\"name\": \".\", \"output\": \"program\", \"sources\": [7], \"debug_info\": true, \"version\": \"\", \"defines\": []\}")
	return 0
end 'build'
