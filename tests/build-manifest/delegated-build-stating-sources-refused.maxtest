let CaseDirName = "delegated-build-stating-sources-refused"
let ProjectFileName = "app.maxproj"
let BothStatedWording = "states both a `directory` and `sources`"
let OfItsOwnWording = "it cannot also state `sources` of its own"

test 'a delegated build that also states sources is refused, naming the key'
	let staged = stagedProject(CaseDirName, fixture: DelegatedWithSourcesFixtureName)

	try requireRefused(staged, options: StringArray.create(), exitCode: RefusedExitCode, wordings: [ProjectFileName, BothStatedWording, OfItsOwnWording], what: "maxon build")
end 'a delegated build that also states sources is refused, naming the key'
