// version-component-not-a-number-refused.test.maxon — a manifest `version` with a component that is not
// a number is refused, rather than stamped as 0.

let NotANumberRefusalWording = "`version` component `x` is not a number"

test 'a manifest version component that is not a number is refused'
	let staged = stagedProject("version-component-not-a-number-refused", fixture: VersionNotANumberFixtureName)

	requireRefused(staged, options: [PeTargetOption], exitCode: RefusedExitCode, wordings: [NotANumberRefusalWording], what: "maxon build {PeTargetOption}")
end 'a manifest version component that is not a number is refused'
