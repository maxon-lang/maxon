// manifest-define-without-separator-refused.test.maxon — a manifest define with no `=` is refused, as
// `--define` without one is, rather than dropped and the build run without it.

let DefineRefusalWording = "`defines` holds `Greeting`"

test 'a manifest define without a separator is refused'
	let staged = stagedProject("define-without-separator-refused", fixture: DefineWithoutSeparatorFixtureName)

	try requireRefused(staged, options: StringArray.create(), exitCode: RefusedExitCode, wording: DefineRefusalWording, what: "maxon build")
end 'a manifest define without a separator is refused'
