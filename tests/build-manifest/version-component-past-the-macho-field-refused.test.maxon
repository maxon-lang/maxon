// version-component-past-the-macho-field-refused.test.maxon — a manifest `version` with a component
// Mach-O's LC_SOURCE_VERSION cannot hold (the second is 10 bits) is refused for a macOS target, rather
// than overflowing into its neighbour. `2048` fits a PE field, so only the Mach-O bound refuses it.

let MachOFieldRefusalWording = "`version` component `2048` does not fit"

test 'a manifest version component past the Mach-O field is refused'
	let staged = stagedProject("version-component-past-the-macho-field-refused", fixture: VersionPastTheMachOFieldFixtureName)

	try requireRefused(staged, options: [MachOTargetOption], exitCode: RefusedExitCode, wordings: [MachOFieldRefusalWording], what: "maxon build {MachOTargetOption}")
end 'a manifest version component past the Mach-O field is refused'
