// manifest-debug-info-false-refuses-coverage.test.maxon — `--coverage` over a manifest that turned the
// sidecar off is refused, as it is beside `--no-debug-info`: the manifest is a second way to say the same
// thing, and the refusal must not depend on which way it was said.

test 'coverage is refused over a manifest with debugInfo false'
	let staged = stagedProject("debug-info-false-refuses-coverage", fixture: NoSidecarFixtureName)

	var options = StringArray.create()
	options.push(CoverageFlag)

	requireRefused(staged, options: options, exitCode: RefusedExitCode, wordings: [CoverageNeedsDebugInfoWording], what: "maxon build {CoverageFlag}")
end 'coverage is refused over a manifest with debugInfo false'
