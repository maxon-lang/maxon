// manifest-defines-not-a-list-refused.test.maxon — `defines` that are present and not a list are refused,
// rather than read as no defines at all. The separator case cannot see this: it never reaches an entry.

let DefinesRefusalWording = "`defines` is not a list of strings"

test 'manifest defines that are not a list are refused'
	let staged = stagedProject("defines-not-a-list-refused", fixture: DefinesNotAListFixtureName)

	requireRefused(staged, options: StringArray.create(), exitCode: RefusedExitCode, wordings: [DefinesRefusalWording], what: "maxon build")
end 'manifest defines that are not a list are refused'
