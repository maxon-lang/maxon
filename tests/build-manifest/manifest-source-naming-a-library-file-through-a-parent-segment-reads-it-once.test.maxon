let ParentSegmentCaseLabel = "manifest-source-naming-a-library-file-through-a-parent-segment-reads-it-once"
let ParentSegment = "../"
let NamedRuntimeFile = "runtime/Clock.maxon"
let ParentSegmentMainFileName = "main.maxon"
let ParentSegmentManifestFileName = "project.maxon"
let ParentSegmentMainSource = "typealias ExitCode = int(0 to 255)\n\nfunction main() returns ExitCode\n\tlet started = WallClock.nowUnixSeconds()\n\treturn 0 if started > 0 else 1\nend 'main'\n"

test 'a manifest source naming a runtime file through parent segments reads that file once, as the tiers'
	let staged = stagedProject(ParentSegmentCaseLabel, fixture: DefaultFixtureName)
	let libraryFile = "{parentSegmentsToTheCheckout(staged)}{NamedRuntimeFile}"

	writeStagedFile(staged, fileName: ParentSegmentMainFileName, content: ParentSegmentMainSource)
	writeStagedFile(staged, fileName: ParentSegmentManifestFileName, content: manifestNaming(libraryFile))

	let build = spawnManifestBuild(staged, options: StringArray.create())
	let said = "It wrote to stdout: {build.stdout} and to stderr: {build.stderr}"

	Expect.equal(build.exitCode() as AssertedInt, expected: 0, message: "the manifest names `{libraryFile}`, the runtime tier's own file, beside the program. The file is the tier's however a manifest spells the way to it, and a build that reads it once compiles clean. {said}")
	Expect.isTrue(File.exists(builtExecutable(staged)), message: "the build exited 0 and wrote no executable. {said}")
end 'a manifest source naming a runtime file through parent segments reads that file once, as the tiers'

function manifestNaming(libraryFile String) returns String
	return "export typealias ExitCode = int(0 to 255)\n\nexport function build() returns ExitCode\n\tBuild.buildWithConfig(BuildConfig.create(\"program\", output: \"program\", sources: [\"{ParentSegmentMainFileName}\", \"{libraryFile}\"], debug_info: true))\n\treturn 0\nend 'build'\n"
end 'manifestNaming'

function parentSegmentsToTheCheckout(staged FilePath) returns String
	let checkout = Directory.currentPath()
	var segments = ""
	var current = staged

	while not current.equals(checkout) 'climb'
		segments = "{segments}{ParentSegment}"
		current = try current.parent() otherwise panic("{ParentSegmentCaseLabel}: the gate could not run - {staged.toString()} is not under the checkout {checkout.toString()}")
	end 'climb'

	return segments
end 'parentSegmentsToTheCheckout'

function writeStagedFile(staged FilePath, fileName String, content String)
	let file = staged.join(fileName)
	try File.writeText(file, content: content) otherwise panic("{ParentSegmentCaseLabel}: the gate could not run - could not write {file.toString()}")
end 'writeStagedFile'
