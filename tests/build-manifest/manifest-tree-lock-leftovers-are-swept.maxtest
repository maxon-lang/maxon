test 'a manifest build removes the tree lock files a command left behind past the claim window, says so, and builds'
	let staged = stagedProject("tree-lock-leftovers-are-swept", fixture: DefaultFixtureName)
	plantStaleTreeLockClaim(staged)
	plantStaleTreeLockLeftovers(staged)

	let build = spawnManifestBuild(staged, options: StringArray.create())
	requireBuiltPastTheLock(staged, build: build, wordings: [TreeLockStaleClaimWording, TreeLockLeftoverSweptWording], what: "has a set-aside claim, a clock probe and a staged record nothing has touched past the claim window")
end 'a manifest build removes the tree lock files a command left behind past the claim window, says so, and builds'
