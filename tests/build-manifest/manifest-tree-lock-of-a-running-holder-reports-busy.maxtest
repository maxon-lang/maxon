test 'a manifest build is refused while a running process on this host holds the tree lock'
	let staged = stagedProject("tree-lock-of-a-running-holder-reports-busy", fixture: DefaultFixtureName)
	plantTreeLockOfThisRunningProcess(staged)

	requireRefused(staged, options: StringArray.create(), exitCode: NothingRanExitCode, wordings: [TreeLockBusyWording, TreeLockHolderRunningWording], what: "maxon build")
end 'a manifest build is refused while a running process on this host holds the tree lock'
