// reported-on-recheck.test.maxon — a define that cannot bind is reported by every check of a project, not only the
// one that computed the signature index.
//
// The second check of one project answers its signatures from the memo, so a problem reported while the index is
// computed would stand on the first check and vanish from the second.

let UnknownName = "NoSuchConstant"
let StableOnOneLine = "PASS stability: two checks over unchanged input both reported 1 diagnostic(s)"

test 'a define naming nothing is reported by a second check of the same project'
	let staged = stagedProgram("reported-on-recheck", fixture: BannerFixtureName)

	let run = recheckWithDefine(staged, pair: "{UnknownName}=x")
	Expect.contains(run.stdout, needle: StableOnOneLine, message: "`{RecheckCommandName} {DefineOption}{UnknownName}=x` did not report the one refused define on both checks. It printed: {run.stdout} — and wrote to stderr: {run.stderr}")
end 'a define naming nothing is reported by a second check of the same project'
