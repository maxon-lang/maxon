// TWO constants named `Banner`, in two directories — the only way to make one bare name reach two
// declarations, because a namespace is a module DIRECTORY. Both are file-private, so they do not
// collide as declarations; they collide only as `--define` targets, which is the point.
typealias ExitCode = int(0 to 255)

let Banner = "root"

function main() returns ExitCode
	print("{Banner} {subBanner()}\n")
	return 0
end 'main'
