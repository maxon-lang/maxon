test 'a profile of a program that exits while a process it started holds its output ends within a bound and forwards all of that output'
	let staged = stagedHeldPipe(StagingRootDirName, caseLabel: "profile-a-completed-run-does-not-wait")
	_ = buildStagedSource(staged.join(StagedProgramFileName), staged: staged, what: HeldPipeFixtureName)

	let run = runProfiler(staged, extraArguments: StringArray.create(0))
	endHeldPipeHolder(staged, forwarded: run.stderr)

	let missing = heldPipeLinesMissingFrom(run.stderr)

	Expect.equal(run.exitCode(), expected: 0, message: "the profile of a program that exited did not complete. It wrote to stderr: {run.stderr}")
	Expect.isTrue(missing.isEmpty(), message: "the profiler did not forward these lines of the program's output, which a process it started wrote after the program exited: {listedLines(missing)}. It wrote to stderr: {run.stderr}")
	Expect.lessThan(run.durationMs, than: HeldPipePromptMs, message: "`{TestedCompilerStem} {ProfileSubcommandName} {ProfileRunVerb}` took {run.durationMs} ms to end a run whose program had already exited: it waited for a process the program started, which still holds the program's output. It wrote to stderr: {run.stderr}")
end 'a profile of a program that exits while a process it started holds its output ends within a bound and forwards all of that output'
