typealias ExitCode = int(0 to 255)
typealias Laps = int(0 to u64.max)

let Rounds = 20000
let LinePadding = "012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"

function emitLines(rounds Laps) returns Laps
	var i = 0 as Laps

	while i < rounds 'emit'
		print("line {i} {LinePadding}\n")
		i = i + 1
	end 'emit'

	return i
end 'emitLines'

function main() returns ExitCode
	let lines = emitLines(Rounds)
	print("done {lines}\n")

	return 0
end 'main'
