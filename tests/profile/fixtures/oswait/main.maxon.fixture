typealias ExitCode = int(0 to 255)
typealias Laps = int(0 to u64.max)

let Rounds = 30000

function emitLines(rounds Laps) returns Laps
	var i = 0 as Laps

	while i < rounds 'emit'
		print("line {i}\n")
		i = i + 1
	end 'emit'

	return i
end 'emitLines'

function main() returns ExitCode
	let lines = emitLines(Rounds)
	print("done {lines}\n")

	return 0
end 'main'
