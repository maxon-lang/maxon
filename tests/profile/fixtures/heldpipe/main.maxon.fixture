// The profiled program the held-pipe case runs: it starts a process in a session of its own that inherits its
// standard output and outlives the profiler's deadline, then sleeps past that deadline itself. Linux only.

let HolderLifeSeconds = "25"
let TargetLifeMs = 60000

function main() returns ExitCode
	var config = Configuration.create(Executable.name("sh"))
	var arguments = StringArray.create(0)
	arguments.push("-c")
	arguments.push("setsid sleep {HolderLifeSeconds} &")

	config.arguments = arguments
	config.standardOutput = OutputDestination.inherit
	config.standardError = OutputDestination.inherit
	_ = try config.run() otherwise return 2

	sleep(TargetLifeMs)

	return 0
end 'main'
