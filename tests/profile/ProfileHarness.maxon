// ProfileHarness.maxon — the shared half every case under `tests/profile/` reaches for: the compiler it
// spawns, staging a fixture, building it, running the profiler at it, and reading back the report.
//
// `maxon profile run <exe>` launches a program, samples where its CPU time goes, and prints a report. It
// needs no instrumentation and no rebuild: the only thing read besides the running process is the `.mxdbg`
// sidecar an ordinary build already writes, which leaves the executable byte-identical. So the binary
// measured is the binary that ships.
//
// ⭐⭐ **THE RUNNER AND THE SUBJECT ARE THE SAME BINARY, AND NOTHING OUTSIDE CLOSES THAT.** `maxon test
// tests/profile` both runs these cases and provides the compiler and profiler they spawn — named by
// `TestedCompilerStem` and by nothing else — so a runner broken badly enough to report green having run
// nothing cannot detect itself. READ THE PASS COUNT.
//
// ⭐⭐ **PIN NO NUMBER. A SAMPLING PROFILER IS NONDETERMINISTIC BY CONSTRUCTION** — it reports what a
// thread happened to be doing at a few hundred arbitrary instants, and two runs of one program never agree
// to the sample. Every case here therefore asserts RELATIONSHIPS: an order, a presence, an absence, a
// structure. A case that pinned a count or a percentage would be flaky, and a flaky gate teaches its reader
// to re-bless it.
//
// ⭐ **THE REPORTING FLOOR IS THE CASE'S, NOT THE TOOL'S.** Every profiler run here passes
// `--min-percent=0` so the tool summarizes nothing, and each case then keeps the rows worth a twentieth of
// the samples that run collected. The floor SCALES with the run, so a slower or faster host moves no case's
// answer. MEASURED on the hot/warm fixture: `hot` ~83%, `warm` ~17%, and every other row 0-1% — the floor
// sits three times below the smallest asserted row and five times above the tail, which is what makes it
// remove what varies and nothing else.
//
// ⛔ **EVERY FREE FUNCTION IN A DIRECTORY SHARES ONE NAMESPACE, whatever its visibility** (E3006). So the
// corpus gets ONE shared half, exported from this file, and a case file beside it declares only what that
// case alone uses. A file-private `let` does NOT collide, so a constant declared twice is the half nothing
// catches: every constant this corpus shares is declared here.
//
// ⛔ **EVERYTHING THAT WOULD STOP A CASE RUNNING AT ALL PANICS RATHER THAN FAILING AN ASSERTION**: a
// missing compiler, an unspellable path, a spawn that never happened, a build that did not produce a
// program. None of those is a profiler answering wrongly.
//
// ⛔ **THIS FILE'S PATHS ARE RELATIVE TO THE CHECKOUT ROOT**, which is the working directory a test binary
// inherits from `maxon test`. Everything handed to a child is made absolute first, because a relative path
// resolves against the child's directory on POSIX and the parent's on Windows. Every child also RUNS in its
// staging directory, so the paths a refusal prints are relative to that and are the same on every machine.
//
// ⛔ **ONE SPAWNING `test`, ONE FILE**, and `maxon test` runs files CONCURRENTLY — so every case stages
// into a directory named for ITSELF, never for the fixture it stages. A profiled run costs real wall time
// (the hot/warm fixture is ~0.5 s), so this corpus is run with a raised `--timeout=`.

// Where the corpus lives and where a runnable copy is built, both relative to the checkout root. Staging
// goes to gitignored `temp/`: a live `.maxon` under `tests/` is one `maxon fmt` over the checkout rewrites.
let FixturesDirName = "tests/profile/fixtures"
let StagingRootDirName = "temp/profile"
let PathSeparator = "/"

// The stored-name mapping, `tests/README.md` rule 1: `<name>.fixture -> <name>`.
let StoredFixtureSuffix = ".fixture"
let StagedProgramFileName = "main.maxon"

// The programs this corpus stages, by their fixture directory names.
export let HotWarmFixtureName = "hotwarm"
export let GreenThreadsFixtureName = "greenthreads"

// The binary this directory spawns, relative to the checkout root and without its host suffix. It is the
// compiler under test AND the profiler under test. ONE constant, so the SUBJECT axis cannot move when the
// RUNNER does.
export let TestedCompilerStem = "maxon-bin/.maxon/maxon"

// The command line one build is run from: `build <staged>/main.maxon -o <staged>/out[.exe]`. `-o` is what
// keeps the build out of the tree lock, so two case files can compile at once.
let BuildCommandName = "build"
let OutputOption = "-o"
let OutputFileStem = "out"

// The profiler's surface. One verb only.
export let ProfileSubcommandName = "profile"
export let ProfileRunVerb = "run"
export let FoldedFlag = "--folded"
export let MinPercentFlagPrefix = "--min-percent="
export let TargetEnvFlagPrefix = "--target-env="

// The share every run here asks the tool to summarize below: NONE of it. See this file's header — the
// floor that matters is the case's, taken against the samples that run actually collected.
let NoFloorShare = "0"

// The report's shape: the three sections, and the honest-answer line printed unconditionally above them.
let SectionHeaderMarker = "==="
export let HotFunctionsHeader = "=== hot functions (self time) ==="
export let CallTreeHeader = "=== call tree ==="
export let StacksHeader = "=== stacks ==="
let SamplesLinePrefix = "samples: "
export let TooFewSamplesPrefix = "TOO FEW SAMPLES:"

// Which word of `samples: N at R Hz over Ts (requested H Hz)` carries the count.
let SamplesLineCountField = 1

// Which whitespace-separated field of a measured row is which. A row is `<share>% <samples> <name>`, and a
// name may itself carry spaces (`[unnamed .text]`), so everything past the count belongs to it.
let PercentSuffix = "%"
let ShareField = 0
let SampleCountField = 1
let NameFirstField = 2

// The functions the hot/warm fixture declares, and the order its work ratio makes a fact about the program.
export let HotFunctionName = "hot"
export let WarmFunctionName = "warm"

// The folds every reader in this directory applies to a captured stream: CR dropped, so a Windows console's
// line endings do not decide what a row says; tabs folded to spaces, so a column written with either
// separates two words.
export let LineFeed = "\n"
let CarriageReturn = "\r"
let Space = " "
let Tab = "\t"

let DecimalBase = 10
let AsciiDigitZero = 48

// Spelled as a number rather than as a character literal, which a receiver position cannot carry.
let AsciiSpace = 32

// ⭐ **HOW SMALL A ROW MAY BE AND STILL BE ASSERTED ABOUT: a twentieth of the run.** See the header for why
// the floor is the case's rather than `--min-percent`'s, and for the measured margins on either side of it.
let SignificanceDivisor = 20

// A count of samples, or a position among the rows of one section.
typealias SampleTally = int(0 to u64.max)
export typealias RowPosition = int(0 to u64.max)

// Where a row's name begins, counted in characters from the start of the line.
typealias NameColumn = int(0 to u64.max)

// A list of paths one directory walk produced. Stdlib's own `FilePathArray` is a member of `Directory` and
// has no file-scope spelling.
typealias PathArray = Array with FilePath

// ============================================================================================
// STAGING AND SPAWNING
// ============================================================================================

// A runnable copy of one fixture program under a directory named for the CASE, so concurrent case files
// never share a staging tree. Absolute, because it is handed to a child as its working directory. The
// previous run's files go first: a stale executable or a stale sidecar would let a build that produced
// neither be read as though it had.
//
// The FIXTURE is a required parameter and the CASE LABEL is not the fixture's name: one case may stage
// several programs, each under its own label, and two cases staging one program still need two trees.
export function stagedProgram(caseLabel String, fixture String) returns FilePath
	let staged = stagingDir("{StagingRootDirName}{PathSeparator}{caseLabel}")
	clearStagedFiles(staged)

	let stored = fixtureDir("{FixturesDirName}{PathSeparator}{fixture}").join("{StagedProgramFileName}{StoredFixtureSuffix}")
	let body = try File.readText(stored) otherwise panic("profile tests: the gate could not run — could not read the stored fixture {stored.toString()}.")
	try File.writeText(staged.join("{StagedProgramFileName}"), content: body) otherwise panic("profile tests: the gate could not run — could not stage {StagedProgramFileName} into {staged.toString()}.")

	return staged
end 'stagedProgram'

// Compile one staged program, and refuse to go on if it did not produce a binary. A build is never this
// corpus's subject — the profiler is — so every failure here panics carrying the compiler's own words
// rather than failing an assertion a reader would go looking for a profiler bug in.
export function buildProgram(staged FilePath, label String, extraArguments StringArray)
	var arguments = StringArray.create()
	arguments.push(BuildCommandName)
	arguments.push(staged.join("{StagedProgramFileName}").toString())
	arguments.push(OutputOption)
	arguments.push(builtExecutable(staged).toString())

	for extra in extraArguments 'eachExtra'
		arguments.push(extra)
	end 'eachExtra'

	let run = spawnCompiler(arguments, staged: staged, what: "the '{label}' build")

	if run.exitCode() != 0 'didNotBuild'
		panic("profile tests: the gate could not run — `{TestedCompilerStem} {BuildCommandName}` exited {run.exitCode()} for the '{label}' program, so there is nothing to profile. It wrote to stderr: {run.stderr}")
	end 'didNotBuild'

	if not File.exists(builtExecutable(staged)) 'wroteNothing'
		panic("profile tests: the gate could not run — the '{label}' build exited 0 and wrote no executable to {builtExecutable(staged).toString()}.")
	end 'wroteNothing'
end 'buildProgram'

// One child compiler, run in the staging tree. A binary that is not there and a spawn that never happened
// both stop a case running at all, so both panic naming what was being asked for.
export function spawnCompiler(arguments StringArray, staged FilePath, what String) returns CollectedOutput
	let binary = testedCompilerPath()

	if not File.exists(binary) 'noBinary'
		panic("profile tests: the gate could not run — {what} needs a compiler at {binary.toString()} and there is none. This file's paths are relative to the CHECKOUT ROOT (see the header); run it from there, and build `{TestedCompilerStem}` first.")
	end 'noBinary'

	var config = Configuration.create(Executable.path(binary))
	config.arguments = arguments
	config.workingDirectory = staged

	return try config.run() otherwise (e) 'spawnFailed'
		panic("profile tests: the gate could not run — could not spawn {what} ({e.displayReason()}).")
	end 'spawnFailed'
end 'spawnCompiler'

// `profile run <exe> --min-percent=0 [extra...]` on the program staged here. The tool is told to summarize
// NOTHING; which rows are worth asserting about is the case's decision, taken against the samples that run
// actually collected.
export function runProfiler(staged FilePath, extraArguments StringArray) returns CollectedOutput
	var arguments = profileRunArguments(builtExecutable(staged).toString())
	arguments.push("{MinPercentFlagPrefix}{NoFloorShare}")

	for extra in extraArguments 'eachExtra'
		arguments.push(extra)
	end 'eachExtra'

	return spawnCompiler(arguments, staged: staged, what: "`{TestedCompilerStem} {ProfileSubcommandName} {ProfileRunVerb}`")
end 'runProfiler'

// The three words every profiler invocation opens with, so the verb and the subcommand have one spelling
// even where a case deliberately spoils one of them.
export function profileRunArguments(executablePath String) returns StringArray
	var arguments = StringArray.create()
	arguments.push(ProfileSubcommandName)
	arguments.push(ProfileRunVerb)
	arguments.push(executablePath)

	return arguments
end 'profileRunArguments'

// Where a build's executable lands: ONE path per staging directory. The host suffix is spelled INTO the
// `-o` argument rather than left for the compiler to append, so the path handed to the child and the path
// read back are one spelling.
export function builtExecutable(staged FilePath) returns FilePath
	return staged.join("{OutputFileStem}{executableSuffix()}")
end 'builtExecutable'

// The compiler under test, absolute and with the suffix this host can spawn.
function testedCompilerPath() returns FilePath
	let spelled = "{TestedCompilerStem}{executableSuffix()}"
	let relative = try FilePath.from(spelled) otherwise panic("profile tests: the gate could not run — '{spelled}' is not a spellable path")

	return relative.resolve(Directory.currentPath())
end 'testedCompilerPath'

function executableSuffix() returns String
	#if os(Windows)
		let suffix = ".exe"
	#else
		let suffix = ""
	#endif

	return suffix
end 'executableSuffix'

// ============================================================================================
// READING A CAPTURED STREAM — the folds every case in this directory shares
// ============================================================================================

export function withoutCarriageReturns(raw String) returns String
	return raw.replace(CarriageReturn, with: "")
end 'withoutCarriageReturns'

export function outputLines(raw String) returns StringArray
	return withoutCarriageReturns(raw).split(LineFeed)
end 'outputLines'

// A list of rows as the text a failure report shows, so a disagreement reads as a listing rather than as
// two array identities. It is what the equality assertions COMPARE as well as what they print.
export function renderedRows(rows StringArray) returns String
	var rendered = ""

	for row in rows 'eachRow'
		rendered.append("{row}{LineFeed}")
	end 'eachRow'

	return rendered
end 'renderedRows'

// A row's words, with the runs of spacing the report lays its columns out with dropped.
export function whitespaceTokens(row String) returns StringArray
	var tokens = StringArray.create()

	for piece in row.replace(Tab, with: Space).split(Space) 'eachPiece'
		if not piece.isEmpty() 'aWord'
			tokens.push(piece)
		end 'aWord'
	end 'eachPiece'

	return tokens
end 'whitespaceTokens'

// ============================================================================================
// READING A PROFILE REPORT
// ============================================================================================

// Does the report carry this line, exactly? Asked before a section's rows are read: a header that is not
// there is the whole answer, and a reader that went looking for rows under it would report the absence as
// an empty table instead.
export function reportHasLine(lines StringArray, wanted String) returns bool
	for line in lines 'eachLine'
		if line == wanted 'found'
			return true
		end 'found'
	end 'eachLine'

	return false
end 'reportHasLine'

// Does the report carry a line opening with this prefix? Asked where what matters is a line's PRESENCE
// rather than its wording, so a warning that was reworded still counts as printed.
export function reportHasLineStartingWith(lines StringArray, prefix String) returns bool
	for line in lines 'eachLine'
		if line.startsWith(prefix) 'found'
			return true
		end 'found'
	end 'eachLine'

	return false
end 'reportHasLineStartingWith'

// The MEASURED rows of one section: everything between its header and the next one that carries a share
// column. The prose under `=== stacks ===` and the `(N below M% not shown)` summary are dropped by the same
// test, which is what makes this fold independent of how many of either a section has.
//
// The caller has already asserted the header is present, so its absence here is that invariant broken.
export function sectionRows(lines StringArray, header String) returns StringArray
	var rows = StringArray.create()
	var inSection = false

	for line in lines 'eachLine'
		if line == header 'theHeader'
			inSection = true
			continue
		end 'theHeader'

		if not inSection 'notYetThere'
			continue
		end 'notYetThere'

		if line.startsWith(SectionHeaderMarker) 'theNextSection'
			break
		end 'theNextSection'

		if isMeasuredRow(line) 'aRow'
			rows.push(line)
		end 'aRow'
	end 'eachLine'

	if not inSection 'noSuchSection'
		panic("profile tests: the gate could not run — the report carries no '{header}' line, which the case asserts before reading rows under it.")
	end 'noSuchSection'

	return rows
end 'sectionRows'

// A row of the report is `<share>% <samples> <name>`; anything else in a section is prose or a summary.
function isMeasuredRow(line String) returns bool
	let tokens = whitespaceTokens(line)
	let share = try tokens.get(ShareField) otherwise return false

	return share.endsWith(PercentSuffix)
end 'isMeasuredRow'

// The rows worth asserting about: those carrying at least a twentieth of the samples this run collected.
// See this file's header for why the floor is the case's rather than the tool's.
export function significantRows(rows StringArray, totalSamples SampleTally) returns StringArray
	let floor = totalSamples / SignificanceDivisor
	var kept = StringArray.create()

	for row in rows 'eachRow'
		if rowSampleCount(row) >= floor 'worthAsserting'
			kept.push(row)
		end 'worthAsserting'
	end 'eachRow'

	return kept
end 'significantRows'

// What one row is named. Everything past the sample count belongs to the name, because a name may carry
// spaces of its own — `[unnamed .text]` is one — and runs of them are folded to a single space so a column
// laid out with either separator reads the same.
function rowName(row String) returns String
	let tokens = whitespaceTokens(row)
	var name = ""

	for (iter, token) in tokens.withIterator() 'eachToken'
		if iter.index() < NameFirstField 'aColumn'
			continue
		end 'aColumn'

		name.append(token if name.isEmpty() else "{Space}{token}")
	end 'eachToken'

	if name.isEmpty() 'unnamed'
		panic("profile tests: the gate could not run — the report row '{row}' carries a share and a count and no name.")
	end 'unnamed'

	return name
end 'rowName'

// ⭐ **WHERE A ROW'S NAME BEGINS — the call tree's NESTING, which is the only place it is written down.**
// The share and count columns are right-aligned, so leading blanks on the LINE measure alignment rather
// than depth; the name's own column is what a child is pushed further right by. Cases compare these to each
// other — deeper than its parent, level with its sibling — and never to a number.
export function nameColumn(row String) returns NameColumn
	var column = 0
	var fieldsPassed = 0
	var insideField = false

	for c in row.replace(Tab, with: Space) 'eachCharacter'
		let blank = isBlank(c)

		if blank and insideField 'fieldEnded'
			insideField = false
			fieldsPassed = fieldsPassed + 1
		end 'fieldEnded'

		if not blank and not insideField 'fieldStarted'
			if fieldsPassed == NameFirstField 'theName'
				return column
			end 'theName'

			insideField = true
		end 'fieldStarted'

		column = column + 1
	end 'eachCharacter'

	panic("profile tests: the gate could not run — the report row '{row}' carries fewer than three columns, so it has no name to place.")
end 'nameColumn'

function isBlank(c Character) returns bool
	let code = try c.asciiValue() otherwise return false

	return code == AsciiSpace
end 'isBlank'

// How many samples one row was given.
function rowSampleCount(row String) returns SampleTally
	let tokens = whitespaceTokens(row)
	let count = try tokens.get(SampleCountField) otherwise panic("profile tests: the gate could not run — the report row '{row}' opens with a share and carries no sample count beside it.")

	return decimalValue(count, what: "the sample count in the report row '{row}'")
end 'rowSampleCount'

// The names of a list of rows, in the order the report listed them.
export function rowNames(rows StringArray) returns StringArray
	var names = StringArray.create()

	for row in rows 'eachRow'
		names.push(rowName(row))
	end 'eachRow'

	return names
end 'rowNames'

// Where a name sits among a section's rows. The caller has already asserted it is there, because a name the
// report never printed is an answer in itself and must not reach a reader as a position.
export function positionOf(names StringArray, wanted String) returns RowPosition
	for (iter, name) in names.withIterator() 'eachName'
		if name == wanted 'found'
			return iter.index()
		end 'found'
	end 'eachName'

	panic("profile tests: the gate could not run — '{wanted}' is not among the rows its presence was asserted over.")
end 'positionOf'

// ⭐ **HOW MANY SAMPLES THIS RUN TOOK.** It is the denominator every share in the report was computed
// against and the basis of this corpus's own reporting floor — never a quantity a case asserts about.
export function totalSamples(report String, profilerLabel String) returns SampleTally
	for line in outputLines(report) 'eachLine'
		if not line.startsWith(SamplesLinePrefix) 'notTheCountLine'
			continue
		end 'notTheCountLine'

		let tokens = whitespaceTokens(line)
		let count = try tokens.get(SamplesLineCountField) otherwise panic("profile tests: the gate could not run — '{profilerLabel}' printed '{line}', which opens with '{SamplesLinePrefix}' and spells no count after it.")

		return decimalValue(count, what: "the sample count '{profilerLabel}' printed in '{line}'")
	end 'eachLine'

	panic("profile tests: the gate could not run — '{profilerLabel}' printed no '{SamplesLinePrefix}' line, so how many readings its report rests on is unknown. It printed:{LineFeed}{report}")
end 'totalSamples'

// A whole number the report printed. The caller has established which field this is, so a token that is not
// written in digits is the report having changed shape rather than a value to be read leniently.
export function decimalValue(token String, what String) returns SampleTally
	if token.isEmpty() 'noDigits'
		panic("profile tests: the gate could not run — {what} is empty.")
	end 'noDigits'

	var value = 0

	for c in token 'eachCharacter'
		if not Ascii.isDigit(c) 'notADigit'
			panic("profile tests: the gate could not run — {what} is '{token}', which is not written in digits.")
		end 'notADigit'

		value = value * DecimalBase + digitValue(c)
	end 'eachCharacter'

	return value
end 'decimalValue'

// One decimal digit's value. The caller has already classified `c`, so the conversion cannot fail.
function digitValue(c Character) returns SampleTally
	let code = try c.asciiValue() otherwise panic("profile tests: digitValue is reached only past a digit test")

	return code - AsciiDigitZero
end 'digitValue'

// ============================================================================================
// DIRECTORIES
// ============================================================================================

// Delete every file under a staging directory, leaving the directories. A case stages the same shape every
// time, and the previous run's products must not survive into a measurement — a stale sidecar in particular
// would let a build that wrote none be read as though it had.
function clearStagedFiles(dir FilePath)
	for entry in listing(dir) 'eachEntry'
		if Directory.isDirectory(entry) 'aDirectory'
			clearStagedFiles(entry)
			continue
		end 'aDirectory'

		try File.delete(entry) otherwise panic("profile tests: the gate could not run — could not clear {entry.toString()} from a previous run's staging tree.")
	end 'eachEntry'
end 'clearStagedFiles'

// A directory this corpus's paths name, refused loudly when it is not there: every such refusal is the
// working-directory contract in the header not being met.
function fixtureDir(spelled String) returns FilePath
	let path = try FilePath.from(spelled) otherwise panic("profile tests: the gate could not run — '{spelled}' is not a spellable path")

	if not Directory.isDirectory(path) 'notThere'
		panic("profile tests: the gate could not run — there is no directory at '{spelled}'. Every path in this corpus is relative to the CHECKOUT ROOT, which is the working directory a test binary inherits from `maxon test`; a run started anywhere else finds nothing.")
	end 'notThere'

	return path
end 'fixtureDir'

// A directory this run writes into, created ancestor by ancestor so a fresh checkout without `temp/` is not
// a failure, and absolute because it is handed to a child process as its working directory.
function stagingDir(spelled String) returns FilePath
	var prefix = ""

	for component in spelled.split(PathSeparator) 'eachComponent'
		prefix = component if prefix.isEmpty() else "{prefix}{PathSeparator}{component}"
		let ancestor = try FilePath.from(prefix) otherwise panic("profile tests: the gate could not run — '{prefix}' is not a spellable path")

		if not Directory.create(ancestor) 'couldNotCreate'
			panic("profile tests: the gate could not run — could not create '{prefix}'. It is where a case's runnable copy is built; nothing can be staged without it.")
		end 'couldNotCreate'
	end 'eachComponent'

	let path = try FilePath.from(spelled) otherwise panic("profile tests: the gate could not run — '{spelled}' is not a spellable path")
	return path.resolve(Directory.currentPath())
end 'stagingDir'

// What one directory holds.
function listing(dir FilePath) returns PathArray
	return try Directory.list(dir) otherwise panic("profile tests: the gate could not run — could not list {dir.toString()}")
end 'listing'
