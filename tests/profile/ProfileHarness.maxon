// ProfileHarness.maxon — the shared half every case under `tests/profile/` reaches for: running the
// profiler at a built fixture and reading back the report.
//
// `maxon profile run <exe>` launches a program, samples where its CPU time goes, and prints a report. It
// needs no instrumentation: the only thing read besides the running process is the `.mxdbg` sidecar an
// ordinary build already writes. On macOS the profiler launches a temporary copy of the program re-signed
// with the `get-task-allow` entitlement, so an ordinary build is all a case stages.
//
// ⭐⭐ **THE RUNNER AND THE SUBJECT ARE THE SAME BINARY, AND NOTHING OUTSIDE CLOSES THAT.** `maxon test
// tests/profile` both runs these cases and provides the compiler and profiler they spawn — named by
// `TestedCompilerStem` and by nothing else — so a runner broken badly enough to report green having run
// nothing cannot detect itself. READ THE PASS COUNT.
//
// ⭐⭐ **PIN NO NUMBER. A SAMPLING PROFILER IS NONDETERMINISTIC BY CONSTRUCTION** — it reports what a
// thread happened to be doing at a few hundred arbitrary instants, and two runs of one program never agree
// to the sample. Every case here therefore asserts RELATIONSHIPS: an order, a presence, an absence, a
// structure. A case that pinned a count or a percentage would be flaky, and a flaky gate teaches its reader
// to re-bless it.
//
// ⭐ **THE REPORTING FLOOR IS THE CASE'S, NOT THE TOOL'S.** Every profiler run here passes
// `--min-percent=0` so the tool summarizes nothing, and each case then keeps the rows worth a twentieth of
// the samples that run collected. The floor SCALES with the run, so a slower or faster host moves no case's
// answer. MEASURED on the hot/warm fixture: `hot` ~83%, `warm` ~17%, and every other row 0-1% — the floor
// sits three times below the smallest asserted row and five times above the tail, which is what makes it
// remove what varies and nothing else.
//
// ⛔ **EVERY FREE FUNCTION IN A DIRECTORY SHARES ONE NAMESPACE, whatever its visibility** (E3006).
// So the corpus gets ONE shared half, exported from this file, and a case file beside it declares
// only what that case alone uses. A file-private `let` does NOT collide, so a constant declared
// twice is the half nothing catches: every constant this corpus shares is declared here or in
// `tests/support/`.
//
// ⛔ **EVERYTHING THAT WOULD STOP A CASE RUNNING AT ALL PANICS RATHER THAN FAILING AN ASSERTION**: a
// missing compiler, an unspellable path, a spawn that never happened, a build that did not produce a
// program. None of those is a profiler answering wrongly.
//
// ⛔ **THIS FILE'S PATHS ARE RELATIVE TO THE CHECKOUT ROOT**, which is the working directory a test binary
// inherits from `maxon test`. Everything handed to a child is made absolute first, because a relative path
// resolves against the child's directory on POSIX and the parent's on Windows. Every child also RUNS in its
// staging directory, so the paths a refusal prints are relative to that and are the same on every machine.
//
// ⛔ **ONE SPAWNING `test`, ONE FILE**, and `maxon test` runs files CONCURRENTLY — so every case stages
// into a directory named for ITSELF, never for the fixture it stages. A profiled run costs real wall time
// (the hot/warm fixture is ~0.5 s), so this corpus is run with a raised `--timeout=`.

// Where the corpus lives and where a runnable copy is built, both relative to the checkout root. Staging
// goes to gitignored `temp/`: a live `.maxon` under `tests/` is one `maxon fmt` over the checkout rewrites.
export let FixturesDirName = "tests/profile/fixtures"
export let StagingRootDirName = "temp/profile"

// The programs this corpus stages, by their fixture directory names.
export let HotWarmFixtureName = "hotwarm"
export let GreenThreadsFixtureName = "greenthreads"
let SelfCopyFixtureName = "selfcopy"
export let EndsAtOnceFixtureName = "endsatonce"

// The profiler's surface. One verb only.
export let ProfileSubcommandName = "profile"
export let ProfileRunVerb = "run"
export let FoldedFlag = "--folded"
export let MinPercentFlagPrefix = "--min-percent="
export let TargetEnvFlagPrefix = "--target-env="

let MacosTargetOption = "--target=arm64-macos"
export let LinuxTargetOption = "--target=x64-linux"
export let GetTaskAllowEntitlement = "com.apple.security.get-task-allow"
let MacosImageFileName = "macos-image"
let PlistKeyClose = "</key>"
let PlistTrue = "<true/>"
let DerTagBoolean = 0x01
let DerTagUtf8String = 0x0C
let DerBooleanLength = 0x01

export typealias MagicWord = int(0 to u32.max)

export let SuperBlobMagic = 0xFADE0CC0
export let CodeDirectoryMagic = 0xFADE0C02
let SpoiledMagicDistance = 1
let BigEndianWordBytes = 4
let ByteBits = 8
let ByteMask = 0xFF

// The share every run here asks the tool to summarize below: NONE of it. See this file's header — the
// floor that matters is the case's, taken against the samples that run actually collected.
let NoFloorShare = "0"

// The report's shape: the three sections, and the honest-answer line printed unconditionally above them.
let SectionHeaderMarker = "==="
export let HotFunctionsHeader = "=== hot functions (self time) ==="
export let CallTreeHeader = "=== call tree ==="
export let StacksHeader = "=== stacks ==="
let SamplesLinePrefix = "samples: "
export let RuntimeLinePrefix = "runtime: "
export let TooFewSamplesPrefix = "TOO FEW SAMPLES:"

// Which word of `samples: N at R Hz over Ts (requested H Hz)` carries the count.
let SamplesLineCountField = 1

// Which whitespace-separated field of a measured row is which. A row is `<share>% <samples> <name>`, and a
// name may itself carry spaces (`[unnamed .text]`), so everything past the count belongs to it.
let PercentSuffix = "%"
let ShareField = 0
let SampleCountField = 1
let NameFirstField = 2

// The functions the hot/warm fixture declares, and the order its work ratio makes a fact about the program.
export let HotFunctionName = "hot"
export let WarmFunctionName = "warm"

// Spelled as a number rather than as a character literal, which a receiver position cannot carry.
let AsciiSpace = 32
let AsciiLineFeed = 10
let AsciiTab = 9

// ⭐ **HOW SMALL A ROW MAY BE AND STILL BE ASSERTED ABOUT: a twentieth of the run.** See the header for why
// the floor is the case's rather than `--min-percent`'s, and for the measured margins on either side of it.
let SignificanceDivisor = 20

// A position among the rows of one section.
export typealias RowPosition = int(0 to u64.max)

// Where a row's name begins, counted in characters from the start of the line.
export typealias NameColumn = int(0 to u64.max)

// ============================================================================================
// STAGING AND SPAWNING
// ============================================================================================

// `profile run <exe> --min-percent=0 [extra...]` on the program staged here. The tool is told to summarize
// NOTHING; which rows are worth asserting about is the case's decision, taken against the samples that run
// actually collected.
export function runProfiler(staged FilePath, extraArguments StringArray) returns CollectedOutput
	var arguments = profileRunArguments(executableIn(staged, stem: OutputFileStem).toString())
	arguments.push("{MinPercentFlagPrefix}{NoFloorShare}")

	for extra in extraArguments 'eachExtra'
		arguments.push(extra)
	end 'eachExtra'

	return spawnCompiler(arguments, staged: staged, what: "`{TestedCompilerStem} {ProfileSubcommandName} {ProfileRunVerb}`")
end 'runProfiler'

export function imageForTarget(source FilePath, staged FilePath, targetOption String, imageName String) returns FilePath
	var arguments = StringArray.create()
	arguments.push(targetOption)

	let image = staged.join(imageName)
	let build = spawnBuild(source, staged: staged, output: image, label: "{targetOption} image", extraArguments: arguments)
	requireBuiltOrPanic(build, output: image, what: "the {targetOption} image build")

	return image
end 'imageForTarget'

export let AttachedCopySuffix = ".attached"
export let NeighbourFileName = "neighbour.txt"
let CopiedImageFileName = "image-as-launched"
let FactsFileName = "facts.txt"
let FactSeparator = "="

export type SelfCopyRun
	export let run as CollectedOutput
	export let executable as FilePath
	export let copiedImage as FilePath
	export let facts as FilePath

	static function of(run CollectedOutput, executable FilePath, copiedImage FilePath, facts FilePath) returns SelfCopyRun
		return Self{run: run, executable: executable, copiedImage: copiedImage, facts: facts}
	end 'of'
end 'SelfCopyRun'

export function stagedSelfCopyTree(caseLabel String) returns FilePath
	let staged = stagedFixtureTree(FixturesDirName, stagingRootDir: StagingRootDirName, caseLabel: caseLabel, fixture: SelfCopyFixtureName)
	writeStagedFile(staged.join(NeighbourFileName), content: "present\n")

	return staged
end 'stagedSelfCopyTree'

export function buildSelfCopyProgram(caseLabel String) returns FilePath
	let staged = stagedSelfCopyTree(caseLabel)
	_ = buildStagedSource(staged.join(StagedProgramFileName), staged: staged, what: SelfCopyFixtureName)

	return staged
end 'buildSelfCopyProgram'

export function profileSelfCopyProgram(staged FilePath) returns SelfCopyRun
	var arguments = StringArray.create()
	arguments.push(staged.join(CopiedImageFileName).toString())
	arguments.push(staged.join(FactsFileName).toString())

	return SelfCopyRun.of(runProfiler(staged, extraArguments: arguments), executable: builtExecutable(staged), copiedImage: staged.join(CopiedImageFileName), facts: staged.join(FactsFileName))
end 'profileSelfCopyProgram'

export function factOf(facts FilePath, key String) returns String
	for line in outputLines(fileText(facts)) 'eachLine'
		if line.startsWith("{key}{FactSeparator}") 'found'
			return line.replaceFirst("{key}{FactSeparator}", with: "")
		end 'found'
	end 'eachLine'

	panic("profile tests: the gate could not run — {facts.toString()} states no `{key}`.")
end 'factOf'

export function attachedCopiesIn(directory FilePath) returns StringArray
	var names = StringArray.create()

	for entry in listing(directory) 'eachEntry'
		if entry.filename().endsWith(AttachedCopySuffix) 'aCopy'
			names.push(entry.filename())
		end 'aCopy'
	end 'eachEntry'

	return names
end 'attachedCopiesIn'

export function macosImageOf(source FilePath, staged FilePath) returns FilePath
	return imageForTarget(source, staged: staged, targetOption: MacosTargetOption, imageName: MacosImageFileName)
end 'macosImageOf'

union NeedleSearch
	at(start ElementIndex)
	absent
end 'NeedleSearch'

export function namesGetTaskAllow(image FilePath) returns bool
	return match searchBytes(imageBytes(image), needle: GetTaskAllowEntitlement.toByteArray()) 'found'
		at gives true
		absent gives false
	end 'found'
end 'namesGetTaskAllow'

export function grantsGetTaskAllow(image FilePath) returns bool
	let bytes = imageBytes(image)

	return plistGrants(bytes) and derGrants(bytes)
end 'grantsGetTaskAllow'

function plistGrants(bytes ByteArray) returns bool
	let key = "<key>{GetTaskAllowEntitlement}{PlistKeyClose}".toByteArray()

	return match searchBytes(bytes, needle: key) 'found'
		at(start) gives bytesMatchAt(bytes, needle: PlistTrue.toByteArray(), start: afterWhitespace(bytes, from: start + key.count()))
		absent gives false
	end 'found'
end 'plistGrants'

function afterWhitespace(bytes ByteArray, from ElementIndex) returns ElementIndex
	var position = from

	while isWhitespace(try bytes.get(position) otherwise 0) 'skip'
		position = position + 1
	end 'skip'

	return position
end 'afterWhitespace'

function isWhitespace(byte Byte) returns bool
	return byte == AsciiSpace or byte == AsciiLineFeed or byte == AsciiTab
end 'isWhitespace'

function derGrants(bytes ByteArray) returns bool
	let needle = derGetTaskAllowKey()

	return match searchBytes(bytes, needle: needle) 'found'
		at(start) gives (try bytes.get(start + needle.count()) otherwise 0) != 0
		absent gives false
	end 'found'
end 'derGrants'

function derGetTaskAllowKey() returns ByteArray
	var key = ByteArray.create()
	key.push(DerTagUtf8String)
	key.push(GetTaskAllowEntitlement.toByteArray().count())
	key.append(GetTaskAllowEntitlement.toByteArray())
	key.push(DerTagBoolean)
	key.push(DerBooleanLength)

	return key
end 'derGetTaskAllowKey'

export function carriesBlob(image FilePath, magic MagicWord) returns bool
	return match searchBytes(imageBytes(image), needle: bigEndianBytesOf(magic)) 'found'
		at gives true
		absent gives false
	end 'found'
end 'carriesBlob'

export function spoilBlobMagic(image FilePath, magic MagicWord, what String)
	var bytes = imageBytes(image)

	match searchBytes(bytes, needle: bigEndianBytesOf(magic)) 'found'
		absent then panic("profile tests: the gate could not run — {image.toString()} carries no {what} to spoil.")
		at(start) then overwriteBytes(bytes, at: start, replacement: bigEndianBytesOf((magic + SpoiledMagicDistance) as MagicWord))
	end 'found'

	writeImage(image, bytes: bytes)
end 'spoilBlobMagic'

function bigEndianBytesOf(word MagicWord) returns ByteArray
	var bytes = ByteArray.create()

	for shift in 0 upto BigEndianWordBytes 'eachByte'
		bytes.push(((word shr ((BigEndianWordBytes - 1 - shift) * ByteBits)) and ByteMask) as Byte)
	end 'eachByte'

	return bytes
end 'bigEndianBytesOf'

function writeImage(image FilePath, bytes ByteArray)
	try File.writeBinary(image, content: bytes, mode: FilePermission.executable) otherwise panic("profile tests: the gate could not run — could not write {image.toString()} back.")
end 'writeImage'

export function imageBytes(image FilePath) returns ByteArray
	return try File.readBinary(image) otherwise panic("profile tests: the gate could not run — {image.toString()} was built and cannot be read back.")
end 'imageBytes'

function searchBytes(bytes ByteArray, needle ByteArray) returns NeedleSearch
	for start in 0 upto bytes.count() - needle.count() + 1 'eachStart'
		if bytesMatchAt(bytes, needle: needle, start: start) 'found'
			return NeedleSearch.at(start)
		end 'found'
	end 'eachStart'

	return NeedleSearch.absent
end 'searchBytes'

function overwriteBytes(bytes ByteArray, at ElementIndex, replacement ByteArray)
	for (iter, replacementByte) in replacement.withIterator() 'eachByte'
		try bytes.set(at + iter.index(), value: replacementByte) otherwise panic("profile tests: the gate could not run — the replacement runs past the image.")
	end 'eachByte'
end 'overwriteBytes'

function bytesMatchAt(bytes ByteArray, needle ByteArray, start ElementIndex) returns bool
	for (iter, expected) in needle.withIterator() 'eachByte'
		let actual = try bytes.get(start + iter.index()) otherwise return false

		if actual != expected 'differs'
			return false
		end 'differs'
	end 'eachByte'

	return true
end 'bytesMatchAt'

// The three words every profiler invocation opens with, so the verb and the subcommand have one spelling
// even where a case deliberately spoils one of them.
export function profileRunArguments(executablePath String) returns StringArray
	var arguments = StringArray.create()
	arguments.push(ProfileSubcommandName)
	arguments.push(ProfileRunVerb)
	arguments.push(executablePath)

	return arguments
end 'profileRunArguments'

// ============================================================================================
// READING A PROFILE REPORT
// ============================================================================================

// Does the report carry this line, exactly? Asked before a section's rows are read: a header that is not
// there is the whole answer, and a reader that went looking for rows under it would report the absence as
// an empty table instead.
export function reportHasLine(lines StringArray, wanted String) returns bool
	for line in lines 'eachLine'
		if line == wanted 'found'
			return true
		end 'found'
	end 'eachLine'

	return false
end 'reportHasLine'

// Does the report carry a line opening with this prefix? Asked where what matters is a line's PRESENCE
// rather than its wording, so a warning that was reworded still counts as printed.
export function reportHasLineStartingWith(lines StringArray, prefix String) returns bool
	for line in lines 'eachLine'
		if line.startsWith(prefix) 'found'
			return true
		end 'found'
	end 'eachLine'

	return false
end 'reportHasLineStartingWith'

// The MEASURED rows of one section: everything between its header and the next one that carries a share
// column. The prose under `=== stacks ===` and the `(N below M% not shown)` summary are dropped by the same
// test, which is what makes this fold independent of how many of either a section has.
//
// The caller has already asserted the header is present, so its absence here is that invariant broken.
export function sectionRows(lines StringArray, header String) returns StringArray
	var rows = StringArray.create()
	var inSection = false

	for line in lines 'eachLine'
		if line == header 'theHeader'
			inSection = true
			continue
		end 'theHeader'

		if not inSection 'notYetThere'
			continue
		end 'notYetThere'

		if line.startsWith(SectionHeaderMarker) 'theNextSection'
			break
		end 'theNextSection'

		if isMeasuredRow(line) 'aRow'
			rows.push(line)
		end 'aRow'
	end 'eachLine'

	if not inSection 'noSuchSection'
		panic("profile tests: the gate could not run — the report carries no '{header}' line, which the case asserts before reading rows under it.")
	end 'noSuchSection'

	return rows
end 'sectionRows'

// A row of the report is `<share>% <samples> <name>`; anything else in a section is prose or a summary.
function isMeasuredRow(line String) returns bool
	let tokens = whitespaceTokens(line)
	let share = try tokens.get(ShareField) otherwise return false

	return share.endsWith(PercentSuffix)
end 'isMeasuredRow'

// The rows worth asserting about: those carrying at least a twentieth of the samples this run collected.
// See this file's header for why the floor is the case's rather than the tool's.
export function significantRows(rows StringArray, totalSamples PrintedNumber) returns StringArray
	let floor = totalSamples / SignificanceDivisor
	var kept = StringArray.create()

	for row in rows 'eachRow'
		if rowSampleCount(row) >= floor 'worthAsserting'
			kept.push(row)
		end 'worthAsserting'
	end 'eachRow'

	return kept
end 'significantRows'

// What one row is named. Everything past the sample count belongs to the name, because a name may carry
// spaces of its own — `[unnamed .text]` is one — and runs of them are folded to a single space so a column
// laid out with either separator reads the same.
function rowName(row String) returns String
	let tokens = whitespaceTokens(row)
	var name = ""

	for (iter, token) in tokens.withIterator() 'eachToken'
		if iter.index() < NameFirstField 'aColumn'
			continue
		end 'aColumn'

		name.append(token if name.isEmpty() else "{Space}{token}")
	end 'eachToken'

	if name.isEmpty() 'unnamed'
		panic("profile tests: the gate could not run — the report row '{row}' carries a share and a count and no name.")
	end 'unnamed'

	return name
end 'rowName'

// ⭐ **WHERE A ROW'S NAME BEGINS — the call tree's NESTING, which is the only place it is written down.**
// The share and count columns are right-aligned, so leading blanks on the LINE measure alignment rather
// than depth; the name's own column is what a child is pushed further right by. Cases compare these to each
// other — deeper than its parent, level with its sibling — and never to a number.
export function nameColumn(row String) returns NameColumn
	var column = 0 as NameColumn
	var fieldsPassed = 0 as Count
	var insideField = false

	for c in row.replace(Tab, with: Space) 'eachCharacter'
		let blank = isBlank(c)

		if blank and insideField 'fieldEnded'
			insideField = false
			fieldsPassed = fieldsPassed + 1
		end 'fieldEnded'

		if not blank and not insideField 'fieldStarted'
			if fieldsPassed == NameFirstField 'theName'
				return column
			end 'theName'

			insideField = true
		end 'fieldStarted'

		column = column + 1
	end 'eachCharacter'

	panic("profile tests: the gate could not run — the report row '{row}' carries fewer than three columns, so it has no name to place.")
end 'nameColumn'

function isBlank(c Character) returns bool
	let code = try c.asciiValue() otherwise return false

	return code == AsciiSpace
end 'isBlank'

// How many samples one row was given.
function rowSampleCount(row String) returns PrintedNumber
	let tokens = whitespaceTokens(row)
	let count = try tokens.get(SampleCountField) otherwise panic("profile tests: the gate could not run — the report row '{row}' opens with a share and carries no sample count beside it.")

	return wholeDecimalValue(count, what: "the sample count in the report row '{row}'")
end 'rowSampleCount'

// The names of a list of rows, in the order the report listed them.
export function rowNames(rows StringArray) returns StringArray
	var names = StringArray.create()

	for row in rows 'eachRow'
		names.push(rowName(row))
	end 'eachRow'

	return names
end 'rowNames'

// Where a name sits among a section's rows. The caller has already asserted it is there, because a name the
// report never printed is an answer in itself and must not reach a reader as a position.
export function positionOf(names StringArray, wanted String) returns RowPosition
	for (iter, name) in names.withIterator() 'eachName'
		if name == wanted 'found'
			return iter.index()
		end 'found'
	end 'eachName'

	panic("profile tests: the gate could not run — '{wanted}' is not among the rows its presence was asserted over.")
end 'positionOf'

// ⭐ **HOW MANY SAMPLES THIS RUN TOOK.** It is the denominator every share in the report was computed
// against and the basis of this corpus's own reporting floor — never a quantity a case asserts about.
export function totalSamples(report String, profilerLabel String) returns PrintedNumber
	return countOnLine(report, prefix: SamplesLinePrefix, profilerLabel: profilerLabel)
end 'totalSamples'

// How many of those samples the profiler counted in the runtime's own machinery rather than in a row.
export function runtimeSamples(report String, profilerLabel String) returns PrintedNumber
	return countOnLine(report, prefix: RuntimeLinePrefix, profilerLabel: profilerLabel)
end 'runtimeSamples'

function countOnLine(report String, prefix String, profilerLabel String) returns PrintedNumber
	for line in outputLines(report) 'eachLine'
		if not line.startsWith(prefix) 'notTheCountLine'
			continue
		end 'notTheCountLine'

		let tokens = whitespaceTokens(line)
		let count = try tokens.get(SamplesLineCountField) otherwise panic("profile tests: the gate could not run — '{profilerLabel}' printed '{line}', which opens with '{prefix}' and spells no count after it.")

		return wholeDecimalValue(count, what: "the sample count '{profilerLabel}' printed in '{line}'")
	end 'eachLine'

	panic("profile tests: the gate could not run — '{profilerLabel}' printed no '{prefix}' line, so how many readings its report rests on is unknown. It printed:{LineFeed}{report}")
end 'countOnLine'
