test 'a profile of an image that is already re-signed launches an image byte-identical to the one a single re-sign makes'
	let first = buildSelfCopyProgram("profile-signs-an-already-signed-image-to-the-same-bytes-first")
	let once = profileSelfCopyProgram(first)

	Expect.equal(once.run.exitCode(), expected: 0, message: "`{TestedCompilerStem} {ProfileSubcommandName} {ProfileRunVerb}` did not complete a measurement of the ordinary build. It printed:{LineFeed}{once.run.stdout}{LineFeed}— and wrote to stderr: {once.run.stderr}")

	let second = stagedSelfCopyTree("profile-signs-an-already-signed-image-to-the-same-bytes-second")
	let resigned = executableIn(second, stem: OutputFileStem)

	try File.writeBinary(resigned, content: imageBytes(once.copiedImage), mode: FilePermission.executable) otherwise panic("profile tests: the gate could not run — could not stage the re-signed image at {resigned.toString()}.")
	try File.writeBinary(sidecarOf(resigned), content: imageBytes(sidecarOf(once.executable))) otherwise panic("profile tests: the gate could not run — could not stage the sidecar beside {resigned.toString()}.")

	let twice = profileSelfCopyProgram(second)

	Expect.equal(twice.run.exitCode(), expected: 0, message: "`{TestedCompilerStem} {ProfileSubcommandName} {ProfileRunVerb}` refused an image it had already re-signed once. It printed:{LineFeed}{twice.run.stdout}{LineFeed}— and wrote to stderr: {twice.run.stderr}")
	Expect.isTrue(imageBytes(twice.copiedImage).equals(imageBytes(once.copiedImage)), message: "re-signing an already re-signed image made {twice.copiedImage.toString()}, which differs from {once.copiedImage.toString()}, the image one re-sign makes. The re-sign must be idempotent.")
end 'a profile of an image that is already re-signed launches an image byte-identical to the one a single re-sign makes'
