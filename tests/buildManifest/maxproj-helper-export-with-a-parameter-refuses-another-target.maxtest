let MaxprojHelperExportWithAParameterCaseDirName = "maxproj-helper-export-with-a-parameter-refuses-another-target"
let HelperWithAParameterAskedFor = "app"
let HelperWithAParameterCode = "E3225"
let HelperWithAParameterNamed = "'helper'"
let HelperWithAParameterFix = "remove `export`"

test 'an exported helper that takes a parameter refuses the build of another target, naming the helper and the fix'
	let staged = stagedProject(MaxprojHelperExportWithAParameterCaseDirName, fixture: MaxprojHelperExportParameterFixtureName)

	try requireRefused(staged, options: [HelperWithAParameterAskedFor], exitCode: RefusedExitCode, wordings: [HelperWithAParameterCode, HelperWithAParameterNamed, HelperWithAParameterFix], what: "maxon build {HelperWithAParameterAskedFor}")

	discardStagedDir(caseRootOf(staged))
end 'an exported helper that takes a parameter refuses the build of another target, naming the helper and the fix'
