let CaseDirName = "maxproj-nested-below-another-project-refused"
let NestedProjectFileName = "inner.maxproj"

test 'a .maxproj below the project root is refused by the outer build, naming it'
	let staged = stagedProject(CaseDirName, fixture: MaxprojNestedFixtureName)

	try requireRefused(staged, options: StringArray.create(), exitCode: RefusedExitCode, wordings: [NestedProjectFileName], what: "maxon build")
end 'a .maxproj below the project root is refused by the outer build, naming it'
