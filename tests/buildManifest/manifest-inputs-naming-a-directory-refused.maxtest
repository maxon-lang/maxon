let DirectoryInputWording = "`inputs` holds"
let DirectoryRefusalWording = "which is a directory, not a file"

test 'a manifest input that is the empty string, and so names the manifest directory, is refused'
	let staged = stagedProject("inputs-naming-a-directory-refused", fixture: InputsNamingADirectoryFixtureName)

	requireRefused(staged, options: StringArray.create(), exitCode: RefusedExitCode, wordings: [DirectoryInputWording, DirectoryRefusalWording], what: "maxon build")
end 'a manifest input that is the empty string, and so names the manifest directory, is refused'
