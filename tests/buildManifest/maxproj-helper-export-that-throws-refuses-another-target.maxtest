let MaxprojHelperExportThatThrowsCaseDirName = "maxproj-helper-export-that-throws-refuses-another-target"
let HelperThatThrowsAskedFor = "app"
let HelperThatThrowsCode = "E3054"
let HelperThatThrowsNamed = "'helper'"
let HelperThatThrowsFix = "remove `export`"

test 'an exported helper that throws refuses the build of another target, naming the helper and the fix'
	let staged = stagedProject(MaxprojHelperExportThatThrowsCaseDirName, fixture: MaxprojHelperExportThrowsFixtureName)

	try requireRefused(staged, options: [HelperThatThrowsAskedFor], exitCode: RefusedExitCode, wordings: [HelperThatThrowsCode, HelperThatThrowsNamed, HelperThatThrowsFix], what: "maxon build {HelperThatThrowsAskedFor}")

	discardStagedDir(caseRootOf(staged))
end 'an exported helper that throws refuses the build of another target, naming the helper and the fix'
