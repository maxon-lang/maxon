let BuildDirectoryInputWording = "`inputs` holds `.`, which is a directory, not a file"

test 'inputs given to Build.build reach the description, and one that is a directory is refused'
	let staged = stagedProject("build-inputs-naming-a-directory-refused", fixture: BuildInputNamingADirectoryFixtureName)

	requireRefused(staged, options: StringArray.create(), exitCode: RefusedExitCode, wordings: [BuildDirectoryInputWording], what: "maxon build")
end 'inputs given to Build.build reach the description, and one that is a directory is refused'
