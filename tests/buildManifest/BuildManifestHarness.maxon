let WroteCodeWording = "bytes of code to"
let UpToDateLinePrefix = "Up to date -> "
let SecondStageVariable = "MAXON_SECOND_STAGE"
let SecondStageValue = "1"
let NestedProjectFileName = "inner.maxproj"
let ProjectName = "app"
