test 'a manifest build leaves to its heartbeat a tree lock whose host names no pid space'
	let staged = stagedProject("tree-lock-without-the-pid-space-is-not-probed", fixture: DefaultFixtureName)
	plantTreeLockOfThisHostWithout(staged, dropped: HostIdentityPart.pidSpace)

	requireRefused(staged, options: StringArray.create(0), exitCode: NothingRanExitCode, wordings: [TreeLockBusyWording, TreeLockUnprobedHolderWording], what: "maxon build")

	discardStagedDir(caseRootOf(staged))
end 'a manifest build leaves to its heartbeat a tree lock whose host names no pid space'
