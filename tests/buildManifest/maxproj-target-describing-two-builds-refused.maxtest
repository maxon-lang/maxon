let CaseDirName = "maxproj-target-describing-two-builds-refused"
let ProjectFileName = "app.maxproj"
let TwoBuildsWording = "described 2 builds"

test 'a target that describes two builds is refused by the driver, naming the count'
	let staged = stagedProject(CaseDirName, fixture: MaxprojTwoBuildsInOneTargetFixtureName)

	try requireRefused(staged, options: StringArray.create(), exitCode: RefusedExitCode, wordings: [ProjectFileName, TwoBuildsWording], what: "maxon build")
end 'a target that describes two builds is refused by the driver, naming the count'
