let MaxprojTargetDescribingTwoBuildsRefusedCaseDirName = "maxproj-target-describing-two-builds-refused"
let TwoBuildsWording = "described 2 builds"

test 'a target that describes two builds is refused by the driver, naming the count'
	let staged = stagedProject(MaxprojTargetDescribingTwoBuildsRefusedCaseDirName, fixture: MaxprojTwoBuildsInOneTargetFixtureName)

	try requireRefused(staged, options: StringArray.create(0), exitCode: RefusedExitCode, wordings: [ProjectFileName, TwoBuildsWording], what: "maxon build")

	discardStagedDir(caseRootOf(staged))
end 'a target that describes two builds is refused by the driver, naming the count'
