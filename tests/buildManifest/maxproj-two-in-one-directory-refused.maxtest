let CaseDirName = "maxproj-two-in-one-directory-refused"
let FirstProjectFileName = "app.maxproj"
let SecondProjectFileName = "other.maxproj"

test 'two .maxproj files in one directory are refused, naming both'
	let staged = stagedProject(CaseDirName, fixture: MaxprojTwoInOneDirectoryFixtureName)

	try requireRefused(staged, options: StringArray.create(), exitCode: RefusedExitCode, wordings: [FirstProjectFileName, SecondProjectFileName], what: "maxon build")
end 'two .maxproj files in one directory are refused, naming both'
