let MaxprojTwoInOneDirectoryRefusedCaseDirName = "maxproj-two-in-one-directory-refused"
let FirstProjectFileName = "app.maxproj"
let SecondProjectFileName = "other.maxproj"

test 'two .maxproj files in one directory are refused, naming both'
	let staged = stagedProject(MaxprojTwoInOneDirectoryRefusedCaseDirName, fixture: MaxprojTwoInOneDirectoryFixtureName)

	try requireRefused(staged, options: StringArray.create(0), exitCode: RefusedExitCode, wordings: [FirstProjectFileName, SecondProjectFileName], what: "maxon build")

	discardStagedDir(caseRootOf(staged))
end 'two .maxproj files in one directory are refused, naming both'
