let CaseDirName = "rebuild-with-output-keeps-an-argument-holding-a-space"
let SpacedOutputOption = "--output=spaced program"

test 'a build asking to rebuild with its output hands the written program an argument holding a space intact'
	requireRepeatedWithOutput(CaseDirName, option: SpacedOutputOption)
end 'a build asking to rebuild with its output hands the written program an argument holding a space intact'
