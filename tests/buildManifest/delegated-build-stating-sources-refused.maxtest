let DelegatedBuildStatingSourcesRefusedCaseDirName = "delegated-build-stating-sources-refused"
let DelegatedBuildStatingSourcesRefusedBothStatedWording = "states both a `directory` and `sources`"
let DelegatedBuildStatingSourcesRefusedOfItsOwnWording = "it cannot also state `sources` of its own"

test 'a delegated build that also states sources is refused, naming the key'
	let staged = stagedProject(DelegatedBuildStatingSourcesRefusedCaseDirName, fixture: DelegatedWithSourcesFixtureName)

	try requireRefused(staged, options: StringArray.create(0), exitCode: RefusedExitCode, wordings: [ProjectFileName, DelegatedBuildStatingSourcesRefusedBothStatedWording, DelegatedBuildStatingSourcesRefusedOfItsOwnWording], what: "maxon build")
end 'a delegated build that also states sources is refused, naming the key'
