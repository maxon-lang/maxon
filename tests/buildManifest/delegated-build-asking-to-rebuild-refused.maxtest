let CaseDirName = "delegated-build-asking-to-rebuild-refused"
let ProjectFileName = "app.maxproj"
let BothStatedWording = "states both a `directory` and `rebuild_with_output`"
let OfItsOwnWording = "it cannot also state `rebuild_with_output` of its own"

test 'a delegated build that also asks to rebuild with its output is refused, naming the key'
	let staged = stagedProject(CaseDirName, fixture: DelegatedRebuildWithOutputFixtureName)

	try requireRefused(staged, options: StringArray.create(), exitCode: RefusedExitCode, wordings: [ProjectFileName, BothStatedWording, OfItsOwnWording], what: "maxon build")
end 'a delegated build that also asks to rebuild with its output is refused, naming the key'
