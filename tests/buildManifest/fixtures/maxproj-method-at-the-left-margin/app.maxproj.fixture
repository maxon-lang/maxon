type Tally
	var count as ExitCode

	static function create() returns Tally
		return Tally{count: 0}
	end 'create'
export function current() returns ExitCode
	return self.count
end 'current'
end 'Tally'

export function app() returns ExitCode
	let tally = Tally.create()
	Build.build(".")
	return tally.current()
end 'app'
