export typealias ExitCode = int(0 to 255)

export function build() returns ExitCode
	let destination = try Process.environmentVariable("MAXON_BUILD_DESCRIPTION") otherwise return 1
	let path = try FilePath.from(destination) otherwise return 1
	try File.writeText(path, content: "\{\"output\": \"program\", \"sources\": [\".\"], \"debug_info\": true, \"version\": \"\", \"defines\": [], \"inputs\": \"plan.txt\"\}") otherwise return 1
	return 0
end 'build'
