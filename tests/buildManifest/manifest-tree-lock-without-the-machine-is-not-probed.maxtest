test 'a manifest build leaves to its heartbeat a tree lock whose host names no machine'
	let staged = stagedProject("tree-lock-without-the-machine-is-not-probed", fixture: DefaultFixtureName)
	plantTreeLockOfThisHostWithout(staged, dropped: HostIdentityPart.machine)

	requireRefused(staged, options: StringArray.create(), exitCode: NothingRanExitCode, wordings: [TreeLockBusyWording, TreeLockUnprobedHolderWording], what: "maxon build")
end 'a manifest build leaves to its heartbeat a tree lock whose host names no machine'
