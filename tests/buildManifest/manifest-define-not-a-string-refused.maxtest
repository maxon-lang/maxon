// manifest-define-not-a-string-refused.maxtest — a `defines` entry that is not a string is refused,
// rather than read as the empty string. The separator case cannot see this: its entry is a string.

let DefineEntryRefusalWording = "`defines` is not a list of strings"

test 'a manifest define that is not a string is refused'
	let staged = stagedProject("define-not-a-string-refused", fixture: DefineNotAStringFixtureName)

	requireRefused(staged, options: StringArray.create(), exitCode: RefusedExitCode, wordings: [DefineEntryRefusalWording], what: "maxon build")
end 'a manifest define that is not a string is refused'
