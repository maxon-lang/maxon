let MaxprojTargetWithAParameterRefusedCaseDirName = "maxproj-target-with-a-parameter-refused"
let TargetTakesParametersCode = "E3225"
let TargetTakesParametersWording = "Function 'helper' must take no parameters"

test 'a target that takes a parameter is refused when the project file compiles, before it runs'
	let staged = stagedProject(MaxprojTargetWithAParameterRefusedCaseDirName, fixture: MaxprojTargetWithAParameterFixtureName)

	try requireRefused(staged, options: StringArray.create(0), exitCode: RefusedExitCode, wordings: [TargetTakesParametersCode, TargetTakesParametersWording], what: "maxon build")

	discardStagedDir(caseRootOf(staged))
end 'a target that takes a parameter is refused when the project file compiles, before it runs'
