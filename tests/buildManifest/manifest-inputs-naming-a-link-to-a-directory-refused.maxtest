#if not os(Windows)
	let InputsNamingALinkFixtureName = "inputs-naming-a-link-to-a-directory"
	let LinkName = "link"
	let LinkTargetDirName = "manifest-inputs-link-target"
	let LinkRefusalWording = "which is a directory, not a file"

	test 'a manifest input that is a link to a directory is refused'
		let staged = stagedProject("inputs-naming-a-link-to-a-directory-refused", fixture: InputsNamingALinkFixtureName)
		let target = freshOutsideCheckoutDir(LinkTargetDirName)
		plantedDirectoryLink(staged.join(LinkName), target: target.toString())

		requireRefused(staged, options: StringArray.create(0), exitCode: RefusedExitCode, wordings: [LinkRefusalWording], what: "maxon build")

		discardStagedDir(target)

		discardStagedDir(caseRootOf(staged))
	end 'a manifest input that is a link to a directory is refused'
#endif
