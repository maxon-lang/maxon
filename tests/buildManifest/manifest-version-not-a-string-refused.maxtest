// manifest-version-not-a-string-refused.maxtest — a build description whose `version` is present and
// not a string is refused rather than built as unversioned.

let VersionRefusalWording = "`version` is not a string"

test 'a manifest version that is not a string is refused'
	let staged = stagedProject("version-not-a-string-refused", fixture: VersionNotAStringFixtureName)

	requireRefused(staged, options: StringArray.create(), exitCode: RefusedExitCode, wordings: [VersionRefusalWording], what: "maxon build")
end 'a manifest version that is not a string is refused'
