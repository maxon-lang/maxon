test 'a manifest build removes a tree lock claim its claimer abandoned, says so, and builds'
	let staged = stagedProject("tree-lock-stale-claim-is-removed", fixture: DefaultFixtureName)
	plantStaleTreeLockClaim(staged)

	let build = spawnManifestBuild(staged, options: StringArray.create(0))
	requireBuiltPastTheLock(staged, build: build, wordings: [TreeLockStaleClaimWording], what: "claim nothing has touched past the claim window")

	discardStagedDir(caseRootOf(staged))
end 'a manifest build removes a tree lock claim its claimer abandoned, says so, and builds'
