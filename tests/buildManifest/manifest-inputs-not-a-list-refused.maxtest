let InputsRefusalWording = "`inputs` is not a list of strings"

test 'manifest inputs that are not a list are refused'
	let staged = stagedProject("inputs-not-a-list-refused", fixture: InputsNotAListFixtureName)

	requireRefused(staged, options: StringArray.create(), exitCode: RefusedExitCode, wordings: [InputsRefusalWording], what: "maxon build")
end 'manifest inputs that are not a list are refused'
