test 'a project build records the compiler release in the cache root'
	let staged = stagedProject("a-project-build-records-the-compiler-release", fixture: DefaultFixtureName)

	let build = spawnManifestBuild(staged, options: StringArray.create())
	Expect.equal(build.exitCode(), expected: 0, message: "`maxon build` over the default manifest exited {build.exitCode()}. It wrote to stdout: {build.stdout} and to stderr: {build.stderr}")

	let record = soleVersionRecordUnder(privateCacheRoot(staged))
	let expected = expectedRecordedRelease()
	Expect.equal(fileText(record), expected: recordLine(expected), message: "the compiler-version record {record.toString()} does not hold the release this compiler records, `{expected}`, on one line.")

	let written = filesInProjectProducts(staged)
	Expect.isEmpty(written, message: "`maxon build` wrote into the project's products directory: {written}")

	let inProject = spacedPaths(filesUnderEndingWith(staged, suffix: VersionRecordSuffix))
	Expect.isEmpty(inProject, message: "`maxon build` wrote a compiler-version record into the project directory: {inProject}")
end 'a project build records the compiler release in the cache root'
