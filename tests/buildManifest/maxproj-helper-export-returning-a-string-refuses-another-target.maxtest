let MaxprojHelperExportReturningAStringCaseDirName = "maxproj-helper-export-returning-a-string-refuses-another-target"
let HelperReturningAStringAskedFor = "app"
let HelperReturningAStringCode = "E3002"
let HelperReturningAStringNamed = "'helper'"
let HelperReturningAStringFix = "remove `export`"

test 'an exported helper that does not return ExitCode refuses the build of another target, naming the helper and the fix'
	let staged = stagedProject(MaxprojHelperExportReturningAStringCaseDirName, fixture: MaxprojHelperExportReturnFixtureName)

	try requireRefused(staged, options: [HelperReturningAStringAskedFor], exitCode: RefusedExitCode, wordings: [HelperReturningAStringCode, HelperReturningAStringNamed, HelperReturningAStringFix], what: "maxon build {HelperReturningAStringAskedFor}")

	discardStagedDir(caseRootOf(staged))
end 'an exported helper that does not return ExitCode refuses the build of another target, naming the helper and the fix'
