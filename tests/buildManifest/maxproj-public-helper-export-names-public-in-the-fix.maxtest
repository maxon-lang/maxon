let MaxprojPublicHelperExportCaseDirName = "maxproj-public-helper-export-names-public-in-the-fix"
let PublicHelperAskedFor = "app"
let PublicHelperCode = "E3225"
let PublicHelperNamed = "'helper'"
let PublicHelperFix = "remove `public`"

test 'a public helper that takes a parameter refuses the build of another target, and the fix names public'
	let staged = stagedProject(MaxprojPublicHelperExportCaseDirName, fixture: MaxprojPublicHelperExportFixtureName)

	try requireRefused(staged, options: [PublicHelperAskedFor], exitCode: RefusedExitCode, wordings: [PublicHelperCode, PublicHelperNamed, PublicHelperFix], what: "maxon build {PublicHelperAskedFor}")

	discardStagedDir(caseRootOf(staged))
end 'a public helper that takes a parameter refuses the build of another target, and the fix names public'
