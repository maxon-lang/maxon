let RebuildWithOutputRunsTheWrittenProgramCaseDirName = "rebuild-with-output-runs-the-written-program"

test 'a build asking to rebuild with its output runs the written program with the same arguments'
	requireRepeatedWithOutput(RebuildWithOutputRunsTheWrittenProgramCaseDirName, option: NoDebugInfoFlag)
end 'a build asking to rebuild with its output runs the written program with the same arguments'
