let RebuildSweepsRetiredImagesStagedDirName = "mcp-rebuild-sweeps-retired-images"
let RebuildSweepsRetiredImagesKnownLine = "built beside retired images"

test 'a self-rebuild deletes the retired images and sidecars of both spellings, and keeps every other file that shares the stem'
	let dir = stagedInTreeDirNamed(RebuildSweepsRetiredImagesStagedDirName)
	clearStagedTree(dir)

	let imageName = "{CompilerStem}{executableSuffix()}"
	let compiler = stagedCopyOf(testedCompilerPath(), dir: dir, name: CompilerStem)
	let program = dir.join(ProgramFileName)
	writeStagedFile(program, content: printingProgramSource(RebuildSweepsRetiredImagesKnownLine))

	let planted = PlantedRetiredImages.plantBeside(dir)

	let rebuilt = rebuildOwnImage(dir, compiler: compiler, program: program)
	Expect.equal(rebuilt.exitCode(), expected: 0, message: "`{BuildCommandName} {ProgramFileName} {OutputOptionPrefix}{imageName}`, run by {imageName} itself, exited {rebuilt.exitCode()}. The compiler said: {rebuilt.stderr}")

	expectNamesSwept(dir, names: planted.minted, why: "{imageName} rebuilt itself, and every self-rebuild sweeps its retired images")
	expectNamesSwept(dir, names: planted.numbered, why: "{imageName} rebuilt itself, and every self-rebuild sweeps the retired images of the older numbered spelling")
	expectNamesKept(dir, names: planted.lookalikes, why: "it only shares the stem of {imageName} and is no retired image")

	discardStagedDir(dir)
end 'a self-rebuild deletes the retired images and sidecars of both spellings, and keeps every other file that shares the stem'
