let RebuildProgramStagingDir = "temp/mcp-build-rebuild"
let RebuildCacheStagingDir = "temp/mcp-build-rebuild-cache"
let RebuildProgramFileName = "main.maxon"
let RebuildOutputStem = "program"
let RebuildProgramLine = "rebuilt"
let RebuildMember = "\"rebuild\":true"
let RebuildResultKey = "result"
let RebuildStdoutKey = "stdout"
let RebuildStderrKey = "stderr"
let RebuildCompiledPrefix = "Compiled -> "
let RebuildReason = "--rebuild was requested"

test 'the build tool given rebuild compiles a program its last build left up to date'
	let program = stagedProgram(RebuildProgramStagingDir, fileName: RebuildProgramFileName, source: printingProgramSource(RebuildProgramLine))
	let directory = try program.parent() otherwise panic("build-rebuild-compiles-an-up-to-date-output: {program.path} has no directory to build into")
	let cacheRoot = stagingDir(RebuildCacheStagingDir)
	clearStagedFiles(cacheRoot)

	var environment = EnvMap.create()
	environment.upsert(CacheRootVariable, value: cacheRoot.toString())

	let output = outputMember(directory.join(RebuildOutputStem))

	var requests = StringArray.create()
	requests.push(initRequest(1))
	requests.push(toolCallRequest(2, name: BuildTool, argumentsJson: argumentsOf([pathMember(program), output])))
	requests.push(toolCallRequest(3, name: BuildTool, argumentsJson: argumentsOf([pathMember(program), output, RebuildMember])))

	let docs = responseDocs(runMcp(requests, environment: Environment.inheritUpdating(environment)))
	let plain = try docs.get(1) otherwise panic("build-rebuild-compiles-an-up-to-date-output: no answer to the plain `{BuildTool}`")
	let rebuilt = try docs.get(2) otherwise panic("build-rebuild-compiles-an-up-to-date-output: no answer to the `{BuildTool}` given `rebuild`")

	Expect.isFalse(toolCallIsError(plain), message: "the control: `{BuildTool}` must build the staged program: {toolCallText(plain)}")
	Expect.isTrue(hasChildKey(rebuilt, parent: rebuilt.root, key: RebuildResultKey), message: "`{BuildTool}` refused the `rebuild` argument rather than building with it: {Json.stringify(rebuilt)}")
	Expect.isFalse(toolCallIsError(rebuilt), message: "`{BuildTool}` given `rebuild` did not build the staged program: {toolCallText(rebuilt)}")

	let stdout = payloadString(rebuilt, key: RebuildStdoutKey)
	let stderr = payloadString(rebuilt, key: RebuildStderrKey)

	Expect.contains(stdout, needle: RebuildCompiledPrefix, message: "`{BuildTool}` given `rebuild` did not compile the program its last call left up to date: {toolCallText(rebuilt)}")
	Expect.contains(stderr, needle: RebuildReason, message: "`{BuildTool}` given `rebuild` did not compile because a rebuild was requested: {toolCallText(rebuilt)}")
end 'the build tool given rebuild compiles a program its last build left up to date'
