let SnippetSweepStagingDir = "mcp-snippet-sweep"
let SnippetsAnEndedServerLeftAreSweptPlantedText = "not really a program"
let StagedSnippetSerial = 1
let OrphanedSnippetSerial = 2
let SnippetProbeLabel = "mcp-snippet-sweep"

typealias SnippetsAnEndedServerLeftAreSweptPlantedSerial = int(1 to 2)

function plantedSnippetFile(directory FilePath, owner Pid, serial SnippetsAnEndedServerLeftAreSweptPlantedSerial, suffix String) returns String
	return plantedSnippetFileIn(directory, namespace: OwnHostNamespace, owner: owner, serial: serial, suffix: suffix)
end 'plantedSnippetFile'

function plantedSnippetFileIn(directory FilePath, namespace String, owner Pid, serial SnippetsAnEndedServerLeftAreSweptPlantedSerial, suffix String) returns String
	let name = "{mintedScratchName(SnippetProbeLabel, base: SnippetStem, namespace: namespace, pid: owner, serial: serial as Count)}{suffix}"
	writeStagedFile(directory.join(name), content: SnippetsAnEndedServerLeftAreSweptPlantedText)

	return name
end 'plantedSnippetFileIn'

test 'a server sweeps the snippets and snippet builds whose server has ended, and keeps a live one s'
	let cacheRoot = stagedDirNamed(SnippetSweepStagingDir)
	clearStagedTree(cacheRoot)
	_ = stagedDirNamed("{SnippetSweepStagingDir}/{CacheVendorDirName}")
	let snippets = stagedDirNamed("{SnippetSweepStagingDir}/{CacheVendorDirName}/{SnippetDirName}")

	let ended = endedProcessId()
	let live = Process.id()
	let endedFiles = StringArray.create(0)
	endedFiles.push(plantedSnippetFile(snippets, owner: ended, serial: StagedSnippetSerial, suffix: MaxonSourceSuffix))
	endedFiles.push(plantedSnippetFile(snippets, owner: ended, serial: StagedSnippetSerial, suffix: executableSuffix()))
	endedFiles.push(plantedSnippetFile(snippets, owner: ended, serial: StagedSnippetSerial, suffix: "{executableSuffix()}{SidecarSuffix}"))
	let orphanedProduct = plantedSnippetFile(snippets, owner: ended, serial: OrphanedSnippetSerial, suffix: executableSuffix())
	let liveFiles = StringArray.create(0)
	liveFiles.push(plantedSnippetFile(snippets, owner: live, serial: StagedSnippetSerial, suffix: MaxonSourceSuffix))
	liveFiles.push(plantedSnippetFile(snippets, owner: live, serial: StagedSnippetSerial, suffix: executableSuffix()))
	liveFiles.push(plantedSnippetFileIn(snippets, namespace: AnotherHost, owner: ended, serial: StagedSnippetSerial, suffix: MaxonSourceSuffix))

	let legacyName = "{SnippetStem}-{ended}-{StagedSnippetSerial}{MaxonSourceSuffix}"
	writeStagedFile(snippets.join(legacyName), content: SnippetsAnEndedServerLeftAreSweptPlantedText)
	liveFiles.push(legacyName)

	let environment = EnvMap.create()
	environment.upsert(CacheRootVariable, value: cacheRoot.toString())
	let docs = responseDocs(runMcp([initRequest(1)], environment: Environment.inheritUpdating(environment)))

	try Expect.equal(docs.count(), expected: 1, message: "the control: the server must answer its `initialize`")

	for name in endedFiles 'eachEnded'
		try Expect.isFalse(File.exists(snippets.join(name)), message: "⛔ A SNIPPET NAMES THE SERVER THAT STAGED IT, and {name} names one that has ended, so nothing will ever delete it but the next server's sweep")
	end 'eachEnded'

	try Expect.isFalse(File.exists(snippets.join(orphanedProduct)), message: "{orphanedProduct} is a build of a snippet whose source is already gone and whose server has ended; nothing names it any longer, so the sweep must remove it on its own")

	for name in liveFiles 'eachLive'
		try Expect.isTrue(File.exists(snippets.join(name)), message: "{name} names a server that is still running, another host's, or an older compiler's server (judged only once it is stale); the sweep must leave it")
	end 'eachLive'

	discardStagedDir(stagedDirNamed(SnippetSweepStagingDir))
end 'a server sweeps the snippets and snippet builds whose server has ended, and keeps a live one s'
