let OkStatus = 200 as HttpStatusNumber

function rosterOverHttp(server StreamingHttpMcpServer, sessionId McpSession) returns StringArray
	let answer = server.post(toolsListRequest(2), sessionId: sessionId)

	if answer.statusCode != OkStatus 'refused'
		panic("mcp http tests: `tools/list` over HTTP answered {answer.statusCode}: {answer.body}")
	end 'refused'

	return toolNames(answer.bodyDoc())
end 'rosterOverHttp'

function missingFrom(roster StringArray, other StringArray) returns String
	var missing = ""

	for name in roster 'eachName'
		if not other.contains(name) 'absent'
			missing.append("{name} ")
		end 'absent'
	end 'eachName'

	return missing
end 'missingFrom'

test 'the http transport serves the same tool roster as stdio'
	var server = StreamingHttpMcpServer.start(StringArray.create())
	let (initialized, sessionId) = server.initializeSession()
	let overHttp = rosterOverHttp(server, sessionId: sessionId)
	try server.stop()

	let overStdio = toolNames(listTools())

	try Expect.equal(initialized.statusCode as AssertedInt, expected: OkStatus as AssertedInt)
	try Expect.isFalse(overStdio.count() == 0, message: "the stdio roster came back empty, so the comparison below would be vacuous")
	try Expect.equal(missingFrom(overHttp, other: overStdio), expected: "", message: "the HTTP transport advertises tools stdio does not")
	try Expect.equal(missingFrom(overStdio, other: overHttp), expected: "", message: "stdio advertises tools the HTTP transport does not")
	try Expect.equal(overHttp.count() as AssertedInt, expected: overStdio.count() as AssertedInt, message: "the two rosters name the same tools but not the same NUMBER of them, so one of them repeats a name")
end 'the http transport serves the same tool roster as stdio'
