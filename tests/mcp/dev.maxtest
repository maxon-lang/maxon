// `maxon mcp-server --dev` — the mode that serves someone working on the COMPILER.
//
// Gates the tool roster, the `repoRoot` and `from` arguments, and the three facts a caller in a
// worktree cannot check any other way: that a refusal names the tree it refused, that an answer ECHOES the
// tree it acted in, and that a tool given no tree names none rather than reporting one it did not use.

#if os(Windows)
	let NonCheckoutDir = "C:/no_such_checkout"
#else
	let NonCheckoutDir = "/no_such_checkout"
#endif

// The worktree this corpus runs in, as an absolute path — a real checkout to name in `repoRoot`.
function thisCheckout() returns String
	return Directory.currentPath().path
end 'thisCheckout'

test 'dev mcp-server advertises the twenty-one user tools plus the three contributor tools'
	let names = toolNames(listTools(true))
	Expect.equal(names.count() as AssertedInt, expected: 24, message: "dev mode must advertise exactly 24 tools: the twenty-one of standard mode, and the three contributor ones")

	Expect.isTrue(names.contains("run_spec_test"), message: "missing run_spec_test")
	Expect.isTrue(names.contains("run_scale_test"), message: "missing run_scale_test")
	Expect.isTrue(names.contains("spec_test_outcome"), message: "missing spec_test_outcome")
	Expect.isTrue(names.contains(BuildTool), message: "missing build")
	Expect.isTrue(names.contains("info"), message: "missing info")
end 'dev mcp-server advertises the twenty-one user tools plus the three contributor tools'

test 'dev mcp-server exposes repoRoot on every tool that acts in a tree'
	let doc = listTools(true)

	let buildProps = toolPropertyKeys(doc, toolName: BuildTool)
	Expect.isTrue(buildProps.contains("repoRoot"), message: "build must take repoRoot in dev mode")
	Expect.isTrue(buildProps.contains("from"), message: "build must take from in dev mode")

	for tool in ["run_spec_test", "run_scale_test", "spec_test_outcome", ExecuteTool, TestTool, FmtTool] 'each'
		Expect.isTrue(toolPropertyKeys(doc, toolName: tool).contains("repoRoot"), message: "{tool} must take repoRoot")
	end 'each'
end 'dev mcp-server exposes repoRoot on every tool that acts in a tree'

// `execute`, `test` and `fmt` act in the host's working directory when nothing names a tree, so what a
// `repoRoot` buys is what a caller in a worktree cannot otherwise get: the named tree's own compiler,
// and an answer that says which tree it was.
test 'dev mcp-server runs the named tree on run, test and fmt'
	for tool in [ExecuteTool, TestTool, FmtTool] 'eachHostTool'
		let refused = callTool(tool, argumentsJson: "\{\"repoRoot\":\"{NonCheckoutDir}\"\}", devMode: true)

		Expect.isTrue(toolCallIsError(refused), message: "{tool} must refuse a repoRoot that is not a checkout")
		Expect.contains(toolCallText(refused), needle: "is not a Maxon checkout")

		let relative = callTool(tool, argumentsJson: "\{\"repoRoot\":\"relative/path\"\}", devMode: true)

		Expect.isTrue(toolCallIsError(relative), message: "{tool} must refuse a relative repoRoot")
		Expect.contains(toolCallText(relative), needle: "is relative. It must be an absolute path")
	end 'eachHostTool'

	let answered = callTool(ExecuteTool, argumentsJson: "\{\"repoRoot\":{Json.quote(thisCheckout())},\"path\":\"no-such-source.maxon\"\}", devMode: true)

	Expect.equal(payloadString(answered, key: "repoRoot"), expected: thisCheckout())
	Expect.contains(payloadString(answered, key: "command"), needle: "no-such-source.maxon")
end 'dev mcp-server runs the named tree on run, test and fmt'

// The default is the host's working directory and not the server's own checkout, because `execute`,
// `test` and `fmt` resolve their paths against the caller's cwd. An answer that named a tree here would
// be about a different directory from the one the argument was written for.
test 'dev mcp-server names no tree on run when no repoRoot is given'
	let doc = callTool(ExecuteTool, argumentsJson: "\{\"path\":\"no-such-source.maxon\"\}", devMode: true)

	Expect.isFalse(payloadHasKey(doc, key: "repoRoot"), message: "an unnamed tree must not be reported as one: {toolCallText(doc)}")
	Expect.contains(payloadString(doc, key: "command"), needle: "no-such-source.maxon")
end 'dev mcp-server names no tree on run when no repoRoot is given'

test 'dev mcp-server refuses a relative repoRoot on every tool that takes one'
	for tool in [BuildTool, "run_spec_test", "run_scale_test"] 'each'
		let doc = callTool(tool, argumentsJson: "\{\"repoRoot\":\"relative/path\"\}", devMode: true)

		Expect.isTrue(toolCallIsError(doc), message: "{tool} must refuse a relative repoRoot")
		Expect.contains(toolCallText(doc), needle: "is relative. It must be an absolute path")
	end 'each'

	// `spec_test_outcome` requires a filter, so its relative-root refusal has to carry one.
	let outcome = callTool("spec_test_outcome", argumentsJson: "\{\"repoRoot\":\"relative/path\",\"filter\":\"x\"\}", devMode: true)
	Expect.isTrue(toolCallIsError(outcome), message: "spec_test_outcome must refuse a relative repoRoot")
	Expect.contains(toolCallText(outcome), needle: "is relative. It must be an absolute path")
end 'dev mcp-server refuses a relative repoRoot on every tool that takes one'

test 'dev mcp-server refuses a repoRoot that is not a checkout'
	let doc = callTool(BuildTool, argumentsJson: "\{\"repoRoot\":\"{NonCheckoutDir}\"\}", devMode: true)

	Expect.isTrue(toolCallIsError(doc))
	Expect.contains(toolCallText(doc), needle: "is not a Maxon checkout")
end 'dev mcp-server refuses a repoRoot that is not a checkout'

// `build` is the cheapest tool to ask: `run_spec_test` pays for a worker pool before it answers
// anything, and this case is about the echo, not a suite.
test 'dev mcp-server echoes the repoRoot it acted in'
	let doc = callTool(BuildTool, argumentsJson: "\{\"repoRoot\":{Json.quote(thisCheckout())},\"path\":\"no-such-source.maxon\"\}", devMode: true)

	Expect.equal(payloadString(doc, key: "repoRoot"), expected: thisCheckout())
	Expect.contains(payloadString(doc, key: "command"), needle: "no-such-source.maxon")
end 'dev mcp-server echoes the repoRoot it acted in'

test 'dev mcp-server names the tree in a refusal too'
	let doc = callTool(BuildTool, argumentsJson: "\{\"repoRoot\":{Json.quote(thisCheckout())},\"from\":\"nowhere/at/all.exe\"\}", devMode: true)

	Expect.isTrue(toolCallIsError(doc))
	Expect.contains(toolCallText(doc), needle: "does not exist")
	Expect.equal(payloadString(doc, key: "repoRoot"), expected: thisCheckout())
end 'dev mcp-server names the tree in a refusal too'

test 'dev mcp-server requires a filter for spec_test_outcome'
	let doc = callTool("spec_test_outcome", argumentsJson: "\{\}", devMode: true)

	Expect.equal(rpcErrorCode(doc) as AssertedInt, expected: RpcInvalidParamsCode)
	Expect.contains(rpcErrorMessage(doc), needle: "requires the `filter` argument")
end 'dev mcp-server requires a filter for spec_test_outcome'

// An `mmTrace: true` run that never traced, reported back as a clean success, is indistinguishable
// from a leak-free run.
test 'dev mcp-server refuses a flag the compiler cannot honour'
	let doc = callTool("run_spec_test", argumentsJson: "\{\"mmTrace\":true\}", devMode: true)

	Expect.equal(rpcErrorCode(doc) as AssertedInt, expected: RpcInvalidParamsCode)
	Expect.contains(rpcErrorMessage(doc), needle: "has no argument `mmTrace`")
end 'dev mcp-server refuses a flag the compiler cannot honour'
