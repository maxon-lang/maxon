let TwoSessionsStagingDir = "mcp-two-sessions"
let SessionsDebuggingOneSource = 2

#if os(Macos)
	let ImagesPerLiveSession = 2
#else
	let ImagesPerLiveSession = 1
#endif

test 'two debug sessions of one source each stop in their own build, and closing one removes its build'
	let program = stagedProgram(TwoSessionsStagingDir, fileName: "main.maxon", source: debuggableProgramSource())
	let anchored = anchorLine(program, anchor: DebuggableProgramAnchor)
	let cache = stagedDirNamed("{TwoSessionsStagingDir}/{CacheDirName}")
	let builds = cache.join(CacheVendorDirName).join(DebugBuildDirName)

	let server = StreamingHttpMcpServer.start(StringArray.create(0), environment: Environment.inheritUpdating([CacheRootVariable: cache.toString()]))
	let (firstInitialized, first) = server.initializeSession()
	let (secondInitialized, second) = server.initializeSession()

	let firstStarted = httpToolCall(server.address, sessionId: first, id: 2, name: DebugStartTool, argumentsJson: sourceArgument(program.toString()))
	let secondStarted = httpToolCall(server.address, sessionId: second, id: 2, name: DebugStartTool, argumentsJson: sourceArgument(program.toString()))
	_ = httpToolCall(server.address, sessionId: first, id: 3, name: DebugBreakTool, argumentsJson: debugBreakTargetArgument(anchored))
	_ = httpToolCall(server.address, sessionId: second, id: 3, name: DebugBreakTool, argumentsJson: debugBreakTargetArgument(anchored))
	let firstContinued = httpToolCall(server.address, sessionId: first, id: 4, name: DebugContinueTool)
	let secondContinued = httpToolCall(server.address, sessionId: second, id: 4, name: DebugContinueTool)
	let imagesWhileLive = imagesIn(builds)

	_ = httpToolCall(server.address, sessionId: first, id: 5, name: DebugStopTool)
	let imagesAfterFirst = imagesIn(builds)
	_ = httpToolCall(server.address, sessionId: second, id: 5, name: DebugStopTool)
	let leftAfterBoth = entriesIn(builds)

	try server.stop()

	try Expect.equal(firstInitialized.statusCode, expected: OkStatus)
	try Expect.equal(secondInitialized.statusCode, expected: OkStatus)
	try Expect.isFalse(toolCallIsError(firstStarted), message: "the first session's `{DebugStartTool}` must build the source and launch it: {toolCallText(firstStarted)}")
	try Expect.isFalse(toolCallIsError(secondStarted), message: "the second session's `{DebugStartTool}` builds the same source while the first session's program runs, and must not build over the image that program runs from: {toolCallText(secondStarted)}")
	try Expect.isTrue(debugEventLines(firstContinued, kind: DebugStopEventName).contains("{anchored}"), message: "the first session must stop at the anchored line {anchored}; it answered {toolCallText(firstContinued)}")
	try Expect.isTrue(debugEventLines(secondContinued, kind: DebugStopEventName).contains("{anchored}"), message: "the second session must stop at the anchored line {anchored}; it answered {toolCallText(secondContinued)}")
	try Expect.equal(imagesWhileLive.count(), expected: SessionsDebuggingOneSource * ImagesPerLiveSession, message: "each live session debugs a build of its own, and on macOS the signed copy of it that it launches; {builds.toString()} held{joined(imagesWhileLive, separator: Space)}")
	try Expect.equal(imagesAfterFirst.count(), expected: (SessionsDebuggingOneSource - 1) * ImagesPerLiveSession, message: "`{DebugStopTool}` removes the images its session held and no other's; {builds.toString()} held{joined(imagesAfterFirst, separator: Space)}")
	try Expect.isEmpty(joined(leftAfterBoth, separator: Space), message: "once both sessions have ended nothing they built is left in {builds.toString()}; it held {joined(leftAfterBoth, separator: Space)}")

	discardStagedDir(stagedDirNamed(TwoSessionsStagingDir))
end 'two debug sessions of one source each stop in their own build, and closing one removes its build'

function imagesIn(directory FilePath) returns StringArray
	let images = StringArray.create(0)

	for entry in entriesIn(directory) 'eachEntry'
		if not entry.endsWith(SidecarSuffix) 'anImage'
			images.push(entry)
		end 'anImage'
	end 'eachEntry'

	return images
end 'imagesIn'

function entriesIn(directory FilePath) returns StringArray
	let names = StringArray.create(0)

	if not Directory.isDirectory(directory) 'nothingBuiltThere'
		return names
	end 'nothingBuiltThere'

	let entries = listing(directory)

	for entry in entries 'eachEntry'
		names.push(entry.filename())
	end 'eachEntry'

	return names
end 'entriesIn'
