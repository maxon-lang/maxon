let SweepStagingDir = "temp/mcp-debug-build-sweep"
let PlantedStem = "planted-main-maxon"
let ForeignFileName = "notes.txt"
let PlantedBytes = "not really an image"
let AnotherHost = "another-os/another-host/another-namespace"
let DebugBuildProbeLabel = "mcp-debug-build-sweep"

typealias BuildSerial = int(1 to 9)

function plantedName(owner Pid, serial BuildSerial) returns String
	return plantedNameIn(OwnHostNamespace, owner: owner, serial: serial)
end 'plantedName'

function plantedNameIn(namespace String, owner Pid, serial BuildSerial) returns String
	return "{mintedScratchName(DebugBuildProbeLabel, base: PlantedStem, namespace: namespace, pid: owner, serial: serial as Count)}{executableSuffix()}"
end 'plantedNameIn'

function plant(directory FilePath, name String)
	writeStagedFile(directory.join(name), content: PlantedBytes)
end 'plant'

function planted(directory FilePath, name String) returns bool
	return File.exists(directory.join(name))
end 'planted'

test 'a server sweeps exactly the debug builds whose owner has ended on its own host'
	let cache = stagingDir("{SweepStagingDir}/{CacheDirName}")
	clearStagedFiles(cache)
	_ = stagingDir("{SweepStagingDir}/{CacheDirName}/{CacheVendorDirName}")
	let builds = stagingDir("{SweepStagingDir}/{CacheDirName}/{CacheVendorDirName}/{DebugBuildDirName}")

	let live = Process.id()
	let ended = endedProcessId()

	let liveBuild = plantedName(live, serial: 1)
	let endedBuild = plantedName(ended, serial: 2)
	let endedSidecar = "{plantedName(ended, serial: 3)}{SidecarSuffix}"
	let liveSidecar = "{plantedName(live, serial: 4)}{SidecarSuffix}"
	let elsewhereBuild = plantedNameIn(AnotherHost, owner: ended, serial: 5)

	plant(builds, name: liveBuild)
	plant(builds, name: "{liveBuild}{SidecarSuffix}")
	plant(builds, name: endedBuild)
	plant(builds, name: "{endedBuild}{SidecarSuffix}")
	plant(builds, name: endedSidecar)
	plant(builds, name: liveSidecar)
	plant(builds, name: elsewhereBuild)
	plant(builds, name: ForeignFileName)

	let docs = responseDocs(runMcp([initRequest(1)], environment: Environment.inheritUpdating([CacheRootVariable: cache.toString()])))

	try Expect.equal(docs.count(), expected: 1, message: "the control: the server must start and answer `initialize`, or nothing below says anything about its startup")
	try Expect.isTrue(Process.isAlive(live), message: "the control: this test's own process is alive, so the builds planted under its id belong to a live owner")
	try Expect.isFalse(Process.isAlive(ended), message: "the control: the child run to learn an ended id has been reaped, so builds planted under it have no owner")
	try Expect.isTrue(planted(builds, name: liveBuild), message: "a build whose owner is still running belongs to a live session and must not be swept; `{liveBuild}` is gone")
	try Expect.isTrue(planted(builds, name: "{liveBuild}{SidecarSuffix}"), message: "a kept build keeps its sidecar")
	try Expect.isFalse(planted(builds, name: endedBuild), message: "a build whose process has ended has no session left to use it and must be swept; `{endedBuild}` is still there")
	try Expect.isFalse(planted(builds, name: "{endedBuild}{SidecarSuffix}"), message: "a swept build's sidecar goes with it")
	try Expect.isFalse(planted(builds, name: endedSidecar), message: "a sidecar whose image and owner are both gone must be swept")
	try Expect.isTrue(planted(builds, name: liveSidecar), message: "a sidecar whose owner is still running is that session's, even with its image not yet written")
	try Expect.isTrue(planted(builds, name: elsewhereBuild), message: "a build another host minted names a pid that means nothing here, so the sweep may not judge it by its owner: `{elsewhereBuild}` is gone")
	try Expect.isTrue(planted(builds, name: ForeignFileName), message: "a file whose name is not a debug build's is never the sweep's to delete")
end 'a server sweeps exactly the debug builds whose owner has ended on its own host'
