let MethodNotAllowedStatus = 405 as HttpAnswerStatus

let StrayPath = "/tools"

test 'a GET on the mcp route is refused 405'
	let server = StreamingHttpMcpServer.start(StringArray.create(0))
	let (initialized, sessionId) = server.initializeSession()
	let got = server.address.request("GET", target: McpRoutePath, host: server.address.authority(), origin: "", sessionId: sessionId, body: "")
	let posted = server.address.post(toolsListRequest(2), sessionId: sessionId)
	try server.stop()

	try Expect.equal(initialized.statusCode, expected: OkStatus)
	try Expect.equal(got.statusCode, expected: MethodNotAllowedStatus, message: "this transport carries no server-to-client stream, so `GET {McpRoutePath}` must be 405 rather than a stream that never speaks; it answered {got.statusCode}")
	try Expect.equal(posted.statusCode, expected: OkStatus, message: "a POST on the same route and session must still be served")
end 'a GET on the mcp route is refused 405'

test 'a path other than the mcp route is 404'
	let server = StreamingHttpMcpServer.start(StringArray.create(0))
	let (initialized, sessionId) = server.initializeSession()
	let stray = server.address.request("POST", target: StrayPath, host: server.address.authority(), origin: "", sessionId: sessionId, body: toolsListRequest(2))
	let onRoute = server.address.post(toolsListRequest(3), sessionId: sessionId)
	try server.stop()

	try Expect.equal(initialized.statusCode, expected: OkStatus)
	try Expect.equal(stray.statusCode, expected: NotFoundStatus, message: "`POST {StrayPath}` must be 404: only `{McpRoutePath}` exists. It answered {stray.statusCode} with {stray.body}")
	try Expect.equal(onRoute.statusCode, expected: OkStatus, message: "the same message on `{McpRoutePath}` must be served — a transport refusing both says nothing about routing")
end 'a path other than the mcp route is 404'

test 'a notification is accepted 202 with no body'
	let server = StreamingHttpMcpServer.start(StringArray.create(0))
	let (initialized, sessionId) = server.initializeSession()
	let notified = server.address.post(initializedNotification(), sessionId: sessionId)
	let request = server.address.post(toolsListRequest(2), sessionId: sessionId)
	try server.stop()

	try Expect.equal(initialized.statusCode, expected: OkStatus)
	try Expect.equal(notified.statusCode, expected: AcceptedStatus, message: "JSON-RPC forbids answering a notification, so the transport must answer 202 and no envelope; it answered {notified.statusCode}")
	try Expect.isTrue(notified.body.trim().isEmpty(), message: "a 202 must carry an empty body; it carried {notified.body}")
	try Expect.equal(request.statusCode, expected: OkStatus, message: "the session must go on serving requests after a notification")
end 'a notification is accepted 202 with no body'
