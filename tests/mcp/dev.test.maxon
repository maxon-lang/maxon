	reqs.push(initRequest(1))
	reqs.push(toolCallRequest(2, name: "run_spec_test", argumentsJson: "\{\"repoRoot\":\"relative/path\"\}"))

	let run = runMcp(reqs, devMode: true)
	let docs = responseDocs(run)
	let doc = try docs.get(1) otherwise panic("no call doc")

	try Expect.isTrue(toolCallIsError(doc), message: "relative repoRoot for run_spec_test must be an error")
	let text = toolCallText(doc)
	try Expect.contains(text, needle: "is relative. It must be an absolute path")
end 'dev mcp-server run_spec_test relative repoRoot is refused'

