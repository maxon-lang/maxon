// A running MCP server survives its own executable being replaced on disk.
//
// A compiler rebuilding its own slot RENAMES its running image to `.previous` — an OS will not let a
// running executable be deleted, but will let one be renamed — and writes the new one in its place.
// An MCP server started FROM that slot is a live process whose image is vacated underneath it, and
// the question is whether it keeps answering.
//
// ⛔ THE CASE STAGES ITS OWN COPY AND REPLACES THAT. Driving a real `build maxon-bin` here would
// rebuild the tree's compiler as a side effect of running the corpus — and a FAILED build leaves the
// slot EMPTY, so a red test would take the checkout's compiler with it. The property under test is
// the OS's, not the build's: rename the image, write another in its place, and ask the process.

let StagedDirName = "temp/mcp-rebuild"

function stagedCopyOf(binary FilePath, name String) returns FilePath
	let dir = try FilePath.from(StagedDirName) otherwise panic("`{StagedDirName}` is a valid path")
	let resolved = dir.resolve(Directory.currentPath())

	if not Directory.create(resolved) and not Directory.isDirectory(resolved) 'unusable'
		panic("could not create {resolved.path}, where this case stages its compiler copy")
	end 'unusable'

	let target = try FilePath.from("{resolved.path}/{name}{executableSuffix()}") otherwise panic("staged path is valid")
	let bytes = try File.readBinary(binary) otherwise panic("could not read {binary.path}")
	try File.writeBinary(target, content: bytes, mode: FilePermission.executable) otherwise panic("could not write {target.path}")

	return target
end 'stagedCopyOf'

test 'mcp server keeps answering after its executable is replaced on disk'
	let staged = stagedCopyOf(testedCompilerPath(), name: "maxon-under-test")

	var session = StreamingMcpSession.startFrom(staged, devMode: false)

	try session.sendLine(initRequest(1))
	let initDoc = try session.readResponseDoc()
	try Expect.isTrue(hasChildKey(initDoc, parent: resultNode(initDoc), key: "serverInfo"), message: "initialize response missing serverInfo")

	try session.sendLine(initializedNotification())

	// Vacate the running image exactly as a self-rebuild does, then put a fresh one back.
	let vacated = try FilePath.from("{staged.path}.previous") otherwise panic("vacated path is valid")
	try File.delete(vacated) otherwise ignore
	try File.rename(staged, to: vacated) otherwise panic("could not rename the running image out of the way")

	let replacement = stagedCopyOf(testedCompilerPath(), name: "maxon-under-test")
	try Expect.isTrue(File.exists(replacement), message: "a replacement image should now sit at the vacated path")

	// The process was started from an image that no longer exists at that path.
	try session.sendLine(toolCallRequest(2, name: "lookup_error_code", argumentsJson: "\{\"code\":\"E3014\"\}"))
	let lookupDoc = try session.readResponseDoc()
	try Expect.isFalse(toolCallIsError(lookupDoc), message: "the server should still answer after its image was replaced: {toolCallText(lookupDoc)}")
	try Expect.equal(payloadString(lookupDoc, key: "code"), expected: "E3014")

	let exitCode = try session.close()
	try Expect.equal(exitCode as AssertedInt, expected: 0, message: "mcp-server should exit 0 on stdin EOF")

	try File.delete(vacated) otherwise ignore
	try File.delete(replacement) otherwise ignore
end 'mcp server keeps answering after its executable is replaced on disk'
