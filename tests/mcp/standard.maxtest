// `maxon mcp-server` — the mode that serves someone WRITING Maxon.
//
// Gates the handshake, the eight tools it advertises, their schemas, and the two refusals that keep a
// wrong answer from reading as a right one: an argument no tool declares, and an error code no case
// claims.

test 'standard mcp-server initialize returns protocol version and server info'
	let docs = responseDocs(runMcpSingle(initRequest(1)))
	Expect.equal(docs.count() as AssertedInt, expected: 1, message: "expected 1 response line")

	let doc = try docs.get(0) otherwise panic("no response")
	let resId = resultNode(doc)

	Expect.equal(try doc.getString(resId, key: "protocolVersion") otherwise "", expected: "2024-11-05")

	let serverInfoId = try doc.getChild(resId, key: "serverInfo") otherwise panic("no serverInfo")
	Expect.equal(try doc.getString(serverInfoId, key: "name") otherwise "", expected: "maxon")
end 'standard mcp-server initialize returns protocol version and server info'

test 'standard mcp-server notifications/initialized produces no response'
	var reqs = StringArray.create()
	reqs.push(initRequest(1))
	reqs.push(initializedNotification())
	reqs.push(toolsListRequest(2))

	let docs = responseDocs(runMcp(reqs))
	Expect.equal(docs.count() as AssertedInt, expected: 2, message: "a notification must produce no response")

	let doc1 = try docs.get(0) otherwise panic("no first response")
	let doc2 = try docs.get(1) otherwise panic("no second response")
	Expect.equal((try doc1.getInt(doc1.root, key: "id") otherwise 0) as AssertedInt, expected: 1)
	Expect.equal((try doc2.getInt(doc2.root, key: "id") otherwise 0) as AssertedInt, expected: 2)
end 'standard mcp-server notifications/initialized produces no response'

test 'standard mcp-server advertises exactly the eight user-facing tools'
	let names = toolNames(listTools())
	Expect.equal(names.count() as AssertedInt, expected: 8, message: "standard mode must advertise exactly 8 tools")

	Expect.isTrue(containsString(names, target: "build"), message: "missing build")
	Expect.isTrue(containsString(names, target: "execute"), message: "missing execute")
	Expect.isTrue(containsString(names, target: "test"), message: "missing test")
	Expect.isTrue(containsString(names, target: "fmt"), message: "missing fmt")
	Expect.isTrue(containsString(names, target: "check"), message: "missing check")
	Expect.isTrue(containsString(names, target: "dump_ir"), message: "missing dump_ir")
	Expect.isTrue(containsString(names, target: "lookup_error_code"), message: "missing lookup_error_code")
	Expect.isTrue(containsString(names, target: "info"), message: "missing info")

	Expect.isFalse(containsString(names, target: "run_spec_test"), message: "run_spec_test is contributor-only")
	Expect.isFalse(containsString(names, target: "run_scale_test"), message: "run_scale_test is contributor-only")
	Expect.isFalse(containsString(names, target: "spec_test_outcome"), message: "spec_test_outcome is contributor-only")
end 'standard mcp-server advertises exactly the eight user-facing tools'

test 'standard mcp-server build schema hides the contributor arguments'
	let props = toolPropertyKeys(listTools(), toolName: "build")

	Expect.isTrue(containsString(props, target: "path"))
	Expect.isTrue(containsString(props, target: "source"))
	Expect.isTrue(containsString(props, target: "output"))
	Expect.isTrue(containsString(props, target: "target"))
	Expect.isTrue(containsString(props, target: "emitIr"))

	Expect.isFalse(containsString(props, target: "repoRoot"), message: "repoRoot is contributor-only")
	Expect.isFalse(containsString(props, target: "from"), message: "from is contributor-only")

	// `run`, `test` and `fmt` take `repoRoot` too, and it is contributor-only on them for the same reason it
	// is on `build`: it names a CHECKOUT and runs that tree's own compiler, which is not a thing a user of
	// the language has.
	for tool in ["execute", "test", "fmt"] 'eachUserFacingTool'
		Expect.isFalse(containsString(toolPropertyKeys(listTools(), toolName: tool), target: "repoRoot"), message: "{tool} must not advertise repoRoot in user mode")
	end 'eachUserFacingTool'
end 'standard mcp-server build schema hides the contributor arguments'

test 'standard mcp-server lookup_error_code answers name and stage from the compiled registry'
	let doc = callTool("lookup_error_code", argumentsJson: "\{\"code\":\"E2001\"\}")
	Expect.isFalse(toolCallIsError(doc), message: "a real code should not be an error")

	Expect.equal(payloadString(doc, key: "code"), expected: "E2001")
	Expect.equal(payloadString(doc, key: "name"), expected: "parserUnexpectedToken")
	Expect.contains(payloadString(doc, key: "stage"), needle: "Parser")
end 'standard mcp-server lookup_error_code answers name and stage from the compiled registry'

test 'standard mcp-server lookup_error_code accepts a bare number and a case name'
	let bare = callTool("lookup_error_code", argumentsJson: "\{\"code\":\"2001\"\}")
	Expect.equal(payloadString(bare, key: "code"), expected: "E2001")

	let numeric = callTool("lookup_error_code", argumentsJson: "\{\"code\":2001\}")
	Expect.equal(payloadString(numeric, key: "code"), expected: "E2001")

	let named = callTool("lookup_error_code", argumentsJson: "\{\"code\":\"parserUnexpectedToken\"\}")
	Expect.equal(payloadString(named, key: "code"), expected: "E2001")
end 'standard mcp-server lookup_error_code accepts a bare number and a case name'

// ⛔ The whole point of the tool: an answer about a code that does not exist reads as an answer and
// is not one.
test 'standard mcp-server lookup_error_code refuses a number no case claims'
	let doc = callTool("lookup_error_code", argumentsJson: "\{\"code\":\"E7777\"\}")

	Expect.isTrue(toolCallIsError(doc), message: "a free number must be refused, not answered")
	Expect.contains(toolCallText(doc), needle: "The number is FREE")
end 'standard mcp-server lookup_error_code refuses a number no case claims'

test 'standard mcp-server lookup_error_code refuses a name the registry does not declare'
	let doc = callTool("lookup_error_code", argumentsJson: "\{\"code\":\"noSuchDiagnostic\"\}")

	Expect.isTrue(toolCallIsError(doc))
	Expect.contains(toolCallText(doc), needle: "declares no case named")
end 'standard mcp-server lookup_error_code refuses a name the registry does not declare'

test 'standard mcp-server refuses a tools/call missing a required argument'
	let doc = callTool("lookup_error_code")

	Expect.isTrue(hasChildKey(doc, parent: doc.root, key: "error"), message: "a missing required argument is a protocol error")
	Expect.equal(rpcErrorCode(doc) as AssertedInt, expected: -32602)
	Expect.contains(rpcErrorMessage(doc), needle: "requires the `code` argument")
end 'standard mcp-server refuses a tools/call missing a required argument'

// ⛔ Silently dropping an argument the caller SET is the worse failure: the run reports clean having
// never honoured it.
test 'standard mcp-server refuses an argument no tool declares'
	let doc = callTool("run_spec_test_typo", argumentsJson: "\{\}")
	Expect.equal(rpcErrorCode(doc) as AssertedInt, expected: -32601)

	let stray = callTool("fmt", argumentsJson: "\{\"mmTrace\":true\}")
	Expect.equal(rpcErrorCode(stray) as AssertedInt, expected: -32602)
	Expect.contains(rpcErrorMessage(stray), needle: "has no argument `mmTrace`")
end 'standard mcp-server refuses an argument no tool declares'

test 'standard mcp-server refuses a contributor argument in user mode'
	for tool in ["build", "execute", "test", "fmt"] 'eachToolTakingARepoRoot'
		let doc = callTool(tool, argumentsJson: "\{\"repoRoot\":\"/somewhere\"\}")

		Expect.equal(rpcErrorCode(doc) as AssertedInt, expected: -32602, message: "{tool} answered a user-mode repoRoot instead of refusing it")
		Expect.contains(rpcErrorMessage(doc), needle: "started without --dev")
	end 'eachToolTakingARepoRoot'
end 'standard mcp-server refuses a contributor argument in user mode'

test 'standard mcp-server refuses an argument of the wrong JSON type'
	let doc = callTool("fmt", argumentsJson: "\{\"path\":42\}")

	Expect.equal(rpcErrorCode(doc) as AssertedInt, expected: -32602)
	Expect.contains(rpcErrorMessage(doc), needle: "must be of type string")
end 'standard mcp-server refuses an argument of the wrong JSON type'

test 'standard mcp-server info reports this compiler'
	let doc = callTool("info")
	Expect.isFalse(toolCallIsError(doc))

	Expect.equal(payloadString(doc, key: "name"), expected: "maxon")
	Expect.isFalse(payloadString(doc, key: "version").isEmpty(), message: "version must not be empty")
	Expect.isFalse(payloadString(doc, key: "executable").isEmpty(), message: "executable must not be empty")
	Expect.contains(payloadString(doc, key: "hostTarget"), needle: "-")
end 'standard mcp-server info reports this compiler'

test 'standard mcp-server refuses the contributor tools by name'
	let doc = callTool("run_spec_test")

	Expect.equal(rpcErrorCode(doc) as AssertedInt, expected: -32601)
	Expect.contains(rpcErrorMessage(doc), needle: "Unknown tool: run_spec_test")
end 'standard mcp-server refuses the contributor tools by name'

test 'standard mcp-server answers unknown methods and malformed input'
	let unknown = try responseDocs(runMcpSingle(unknownMethodRequest())).get(0) otherwise panic("no response")
	Expect.equal(rpcErrorCode(unknown) as AssertedInt, expected: -32601)
	Expect.contains(rpcErrorMessage(unknown), needle: "Method not found: unknown/method")

	let malformed = try responseDocs(runMcpSingle("not valid json at all")).get(0) otherwise panic("no response")
	Expect.equal(rpcErrorCode(malformed) as AssertedInt, expected: -32700)
end 'standard mcp-server answers unknown methods and malformed input'
