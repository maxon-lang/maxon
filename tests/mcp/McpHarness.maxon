// Shared harness for `maxon mcp-server`: spawns the compiler under test and drives it over stdio
// (newline-delimited JSON-RPC) or over the `--http` transport.

let CacheDirName = "cache"
let DebugBuildDirName = "debug-builds"
let SpecTempDirName = ".spec-tmp"
let ResultFlagPrefix = "--result-json="
let MessageByteBound = 4000
let TruncationMarkerOpen = "\n["
let TruncationMarkerClose = " bytes truncated]"
let SpecResultStem = "spec-result"

function resultPathNamedBy(command String) returns FilePath
	let after = try command.split(ResultFlagPrefix).get(1) otherwise panic("the command line names no {ResultFlagPrefix}: {command}")

	return try FilePath.from(after.trim()) otherwise panic("the result path is not a path: {after}")
end 'resultPathNamedBy'

function fakeCheckoutWithCompiler(root FilePath, compiler FilePath)
	for name in [StdlibDirName, CheckoutRuntimeDirName] 'eachCheckoutDir'
		_ = stagingDir(root.join(name).toString())
	end 'eachCheckoutDir'

	let installed = root.join(TestedCompilerStem)
	let slotParent = try installed.parent() otherwise panic("a compiler slot has a directory: {installed.toString()}")
	let slot = stagingDir(slotParent.toString())

	_ = stagedCopyOf(compiler, dir: slot, name: installed.filename())
end 'fakeCheckoutWithCompiler'

// A case that replaces a compiler image on disk replaces a COPY: doing it to the tree's own slot would
// rebuild the checkout's compiler as a side effect.
function stagedCopyOf(binary FilePath, dir FilePath, name String) returns FilePath
	let target = dir.join("{name}{executableSuffix()}")
	let bytes = fileBytes(binary)
	try File.writeBinary(target, content: bytes, mode: FilePermission.executable) otherwise panic("McpHarness: could not write {target.path}")

	return target
end 'stagedCopyOf'

function stagedDirNamed(name String) returns FilePath
	return stagingDir("{testScratchDir().toString()}{PortablePathSeparator}{name}")
end 'stagedDirNamed'

function stagedInTreeDirNamed(name String) returns FilePath
	return stagingDir("{projectScratchDir().toString()}{PortablePathSeparator}{name}")
end 'stagedInTreeDirNamed'

// A staging directory in the test scratch directory holding ONE program, the previous run's files
// cleared, so every file a tool call leaves there afterwards is one the call wrote.
function stagedProgram(dirName String, fileName String, source String) returns FilePath
	let dir = stagedDirNamed(dirName)
	clearStagedTree(dir)

	let program = dir.join(fileName)
	writeStagedFile(program, content: source)
	return program
end 'stagedProgram'

// `arguments` for a tool that takes a `path`, naming `file`.
function pathArgument(file FilePath) returns String
	return argumentsOf([pathMember(file)])
end 'pathArgument'

// Every file under `dir` at any depth other than `kept`, for a report. Empty is what a tool that writes
// nothing leaves.
function filesWrittenBeside(kept FilePath, dir FilePath) returns String
	let written = FilePathArray.create(0)

	for entry in filesUnder(dir) 'eachFile'
		if entry.toString() != kept.toString() 'written'
			written.push(entry)
		end 'written'
	end 'eachFile'

	return spacedPaths(written)
end 'filesWrittenBeside'

// A program that prints `line` and exits 0, written into the test scratch directory by a case so no live
// `.maxon` sits under `tests/`.
function printingProgramSource(line String) returns String
	return "function main() returns ExitCode\n\tprint(\"{line}\\n\")\n\treturn 0\nend 'main'\n"
end 'printingProgramSource'

// `compiler` builds `program` over its own image.
function rebuildOwnImage(dir FilePath, compiler FilePath, program FilePath) returns CollectedOutput
	return spawnCompiler([BuildCommandName, program.toString(), "{OutputOptionPrefix}{compiler.toString()}"], staged: dir, what: "the rebuild of its own image", binary: compiler)
end 'rebuildOwnImage'

typealias JsonDocArray = Array with JsonDoc

type McpRun
	export var stdout as String
	export var stderr as String
	export var exitCode as ExitInt

	static function create(stdout String, stderr String, exitCode ExitInt) returns McpRun
		return Self{stdout: stdout, stderr: stderr, exitCode: exitCode}
	end 'create'
end 'McpRun'

typealias RequestId = int(1 to i64.max)

function initRequest(id RequestId = 1) returns String
	return "\{\"jsonrpc\":\"2.0\",\"id\":{id},\"method\":\"initialize\",\"params\":\{\}\}"
end 'initRequest'

function initializedNotification() returns String
	return "\{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"\}"
end 'initializedNotification'

function toolsListRequest(id RequestId = 2) returns String
	return "\{\"jsonrpc\":\"2.0\",\"id\":{id},\"method\":\"tools/list\",\"params\":\{\}\}"
end 'toolsListRequest'

function toolCallRequest(id RequestId, name String, argumentsJson String = "\{\}") returns String
	return "\{\"jsonrpc\":\"2.0\",\"id\":{id},\"method\":\"tools/call\",\"params\":\{\"name\":\"{name}\",\"arguments\":{argumentsJson}\}\}"
end 'toolCallRequest'

function unknownMethodRequest(method String = "unknown/method", id RequestId = 1) returns String
	return "\{\"jsonrpc\":\"2.0\",\"id\":{id},\"method\":\"{method}\",\"params\":\{\}\}"
end 'unknownMethodRequest'

function runMcp(requests StringArray, devMode bool = false, environment Environment = Environment.inherit) returns McpRun
	let argv = StringArray.create(0)
	argv.push("mcp-server")

	if devMode 'dev'
		argv.push("--dev")
	end 'dev'

	var stdin = ""
	let n = requests.count()

	for i in 0 upto n 'each'
		let r = try requests.get(i) otherwise continue
		stdin = "{stdin}{r}\n"
	end 'each'

	let out = spawnCompiler(argv, what: "the MCP server", environment: environment, standardInput: InputSource.bytes(stdin))

	return McpRun.create(out.stdout, stderr: out.stderr, exitCode: out.exitCode())
end 'runMcp'

function runMcpSingle(request String, devMode bool = false) returns McpRun
	let reqs = StringArray.create(0)
	reqs.push(request)
	return runMcp(reqs, devMode: devMode)
end 'runMcpSingle'

type StreamingMcpSession
	export var server as StreamingSubprocess
	var responses as ChildOutputReader

	// `binary` is a parameter because a case starts a server from a STAGED COPY and then replaces or
	// renames that copy on disk; it must not be the tree's own slot.
	static function startFrom(binary FilePath, devMode bool = false) returns StreamingMcpSession
		let argv = StringArray.create(0)
		argv.push("mcp-server")

		if devMode 'dev'
			argv.push("--dev")
		end 'dev'

		let spawned = try StreamingSubprocess.spawn(Executable.path(binary), arguments: argv) otherwise (e) 'spawnFailed'
			panic("StreamingMcpSession: failed to spawn mcp server: {e.displayReason()}")
		end 'spawnFailed'

		let responses = try spawned.takeStdout() otherwise (e) 'stdoutNotTaken'
			spawned.release()
			panic("StreamingMcpSession: could not take the server's stdout: {e.displayReason()}")
		end 'stdoutNotTaken'

		return StreamingMcpSession{server: spawned, responses: merge responses}
	end 'startFrom'

	export function sendLine(line String) throws SubprocessError
		try self.server.writeStdinLine(line)
	end 'sendLine'

	export function readResponseDoc() returns JsonDoc throws StreamError
		let read = try self.responses.readLineWithin(ResponseLineByteCap)

		match read 'read'
			line(text) then return try Json.parse(text) otherwise panic("StreamingMcpSession: invalid JSON response: {text}")
			ended then throw StreamError.closed
			pastTheCap then throw StreamError.failed("a response line ran past {ResponseLineByteCap} bytes")
		end 'read'
	end 'readResponseDoc'

	export function close() returns ExitInt throws SubprocessError
		self.server.closeStdin()
		let code = try self.server.wait(WaitDeadline.within(SessionCloseDeadlineMs)) otherwise (e) 'waitErr'
			self.server.release()
			throw e
		end 'waitErr'

		self.server.release()
		return code
	end 'close'
end 'StreamingMcpSession'

function responseDocs(run McpRun) returns JsonDocArray
	let docs = JsonDocArray.create(0)

	for line in run.stdout.split("\n") 'each'
		let trimmed = line.trim()

		if trimmed.isEmpty() 'blank'
			continue
		end 'blank'

		let doc = try Json.parse(trimmed) otherwise continue
		docs.push(doc)
	end 'each'

	return docs
end 'responseDocs'

function hasChildKey(doc JsonDoc, parent JsonNodeId, key String) returns bool
	try doc.getChild(parent, key: key) otherwise return false
	return true
end 'hasChildKey'

function resultNode(doc JsonDoc) returns JsonNodeId
	return try doc.getChild(doc.root, key: "result") otherwise panic("response has no `result`: {Json.stringify(doc)}")
end 'resultNode'

function errorNode(doc JsonDoc) returns JsonNodeId
	return try doc.getChild(doc.root, key: "error") otherwise panic("response has no `error`: {Json.stringify(doc)}")
end 'errorNode'

function toolNames(doc JsonDoc) returns StringArray
	let names = StringArray.create(0)
	let resId = resultNode(doc)
	let toolsId = try doc.getChild(resId, key: "tools") otherwise return names
	let count = try doc.arrayLength(toolsId) otherwise return names

	for i in 0 upto count 'each'
		let toolId = try doc.arrayAt(toolsId, index: i) otherwise continue
		let name = try doc.getString(toolId, key: "name") otherwise continue
		names.push(name)
	end 'each'

	return names
end 'toolNames'

union SchemaLookup
	found(properties JsonNodeId)
	absent
end 'SchemaLookup'

// A tools/list response's `inputSchema.properties` object for one tool.
function toolSchemaProperties(doc JsonDoc, toolName String) returns SchemaLookup
	let resId = resultNode(doc)
	let toolsId = try doc.getChild(resId, key: "tools") otherwise return SchemaLookup.absent
	let count = try doc.arrayLength(toolsId) otherwise return SchemaLookup.absent

	for i in 0 upto count 'each'
		let toolId = try doc.arrayAt(toolsId, index: i) otherwise continue
		let name = try doc.getString(toolId, key: "name") otherwise continue

		if name.equals(toolName) 'found'
			let schemaId = try doc.getChild(toolId, key: "inputSchema") otherwise return SchemaLookup.absent
			let propsId = try doc.getChild(schemaId, key: "properties") otherwise return SchemaLookup.absent
			return SchemaLookup.found(propsId)
		end 'found'
	end 'each'

	return SchemaLookup.absent
end 'toolSchemaProperties'

function toolPropertyKeys(doc JsonDoc, toolName String) returns StringArray
	return match toolSchemaProperties(doc, toolName: toolName) 'lookup'
		found(propsId) gives doc.get(propsId).keys.clone()
		absent gives StringArray.create(0)
	end 'lookup'
end 'toolPropertyKeys'

// ⛔ A property or description that is not there is a BROKEN ROSTER, never an empty description.
function toolPropertyDescription(doc JsonDoc, toolName String, property String) returns String
	match toolSchemaProperties(doc, toolName: toolName) 'lookup'
		found(propsId) then return propertyDescriptionIn(doc, properties: propsId, toolName: toolName, property: property)
		absent then panic("tools/list has no input schema for `{toolName}`: {Json.stringify(doc)}")
	end 'lookup'
end 'toolPropertyDescription'

function propertyDescriptionIn(doc JsonDoc, properties JsonNodeId, toolName String, property String) returns String
	let propertyId = try doc.getChild(properties, key: property) otherwise panic("`{toolName}` declares no property `{property}`: {Json.stringify(doc)}")
	return try doc.getString(propertyId, key: "description") otherwise panic("`{toolName}`'s property `{property}` has no description: {Json.stringify(doc)}")
end 'propertyDescriptionIn'

// ⛔ A missing field is a BROKEN RESPONSE, not an empty one. Answering "" would let an assertion on
// the payload pass against a response that never carried it.
function toolCallText(doc JsonDoc) returns String
	let resId = resultNode(doc)
	let contentId = try doc.getChild(resId, key: "content") otherwise panic("tool result has no `content`: {Json.stringify(doc)}")
	let firstElemId = try doc.arrayAt(contentId, index: 0) otherwise panic("tool result `content` is empty: {Json.stringify(doc)}")
	return try doc.getString(firstElemId, key: "text") otherwise panic("tool result content[0] has no `text`: {Json.stringify(doc)}")
end 'toolCallText'

function toolCallIsError(doc JsonDoc) returns bool
	let resId = resultNode(doc)
	return try doc.getBool(resId, key: "isError") otherwise panic("tool result has no `isError`: {Json.stringify(doc)}")
end 'toolCallIsError'

function rpcErrorCode(doc JsonDoc) returns JsonInt
	let errId = errorNode(doc)
	return try doc.getInt(errId, key: "code") otherwise panic("rpc error has no `code`: {Json.stringify(doc)}")
end 'rpcErrorCode'

function rpcErrorMessage(doc JsonDoc) returns String
	let errId = errorNode(doc)
	return try doc.getString(errId, key: "message") otherwise panic("rpc error has no `message`: {Json.stringify(doc)}")
end 'rpcErrorMessage'

function toolPayload(doc JsonDoc) returns JsonDoc
	let text = toolCallText(doc)
	return try Json.parse(text) otherwise panic("tool payload is not JSON: {text}")
end 'toolPayload'

// Whether the payload carries a key at all — the question an OMITTED field is the answer to. A tool that
// names no tree leaves `repoRoot` out rather than reporting an empty one.
function payloadHasKey(doc JsonDoc, key String) returns bool
	let payload = toolPayload(doc)
	return hasChildKey(payload, parent: payload.root, key: key)
end 'payloadHasKey'

function payloadString(doc JsonDoc, key String) returns String
	let payload = toolPayload(doc)
	return try payload.getString(payload.root, key: key) otherwise panic("tool payload has no `{key}`: {toolCallText(doc)}")
end 'payloadString'

function payloadInt(doc JsonDoc, key String) returns JsonInt
	let payload = toolPayload(doc)
	return try payload.getInt(payload.root, key: key) otherwise panic("tool payload has no number `{key}`: {toolCallText(doc)}")
end 'payloadInt'

let SpecFileExtension = ".md"

function printingSpecCase(name String, mainBody String, expectedStdout String) returns String
	return "<!-- test: {name} -->\n\n```maxon\nfunction main() returns ExitCode\n{mainBody}\treturn 0\nend 'main'\n```\n\n```stdout\n{expectedStdout}\n```\n"
end 'printingSpecCase'

function failingSpecCase(name String) returns String
	return printingSpecCase(name, mainBody: "\tprint(\"{name}\\n\")\n", expectedStdout: "not {name}")
end 'failingSpecCase'

function passingSpecCase(name String) returns String
	return printingSpecCase(name, mainBody: "\tprint(\"kept\\n\")\n", expectedStdout: "kept")
end 'passingSpecCase'

function failingSpecCases(names StringArray) returns StringArray
	let cases = StringArray.create(0)

	for name in names 'eachName'
		cases.push(failingSpecCase(name))
	end 'eachName'

	return cases
end 'failingSpecCases'

function stageSpecFile(dir FilePath, specName String, cases StringArray)
	var source = "---\nfeature: mcp-{specName}\n---\n# {specName}\n\n## Tests\n"

	for c in cases 'eachCase'
		source = "{source}\n{c}"
	end 'eachCase'

	let path = dir.join("{specName}{SpecFileExtension}")
	writeStagedFile(path, content: source)
end 'stageSpecFile'

let CheckoutRuntimeDirName = "runtime"

// Drive one request against a server started in the given mode and return its response.
function callTool(name String, argumentsJson String = "\{\}", devMode bool = false) returns JsonDoc
	let reqs = StringArray.create(0)
	reqs.push(initRequest(1))
	reqs.push(toolCallRequest(2, name: name, argumentsJson: argumentsJson))

	let docs = responseDocs(runMcp(reqs, devMode: devMode))
	return try docs.get(1) otherwise panic("no response to tools/call `{name}`")
end 'callTool'

function listTools(devMode bool = false) returns JsonDoc
	let reqs = StringArray.create(0)
	reqs.push(initRequest(1))
	reqs.push(toolsListRequest(2))

	let docs = responseDocs(runMcp(reqs, devMode: devMode))
	return try docs.get(1) otherwise panic("no response to tools/list")
end 'listTools'

typealias HeaderMap = Map with (String, String)

// Not `StatusCode`: parsing a status line into that enum throws on a code it does not name, and a
// transport case must be able to read back any code the server sends.
typealias HttpAnswerStatus = int(100 to 599)

let LowestHttpAnswerStatus = 100 as FullRangeInt
let HighestHttpAnswerStatus = 599 as FullRangeInt
let AnswerBodyBound = 16777216

let McpHttpOption = "--http"
let McpExitOnStdinEofOption = "--exit-on-stdin-eof"
let McpIdleTimeoutOptionPrefix = "--idle-timeout="
let McpMaxSessionsOptionPrefix = "--max-sessions="
let McpSessionHeaderName = "mcp-session-id"
let McpRoutePath = "/mcp"

let EndpointKey = "endpoint"
let HeaderSeparator = "\r\n"
let HeaderEnd = "\r\n\r\n"
let StatusLineFieldSeparator = " "
let HeaderNameSeparator = ": "
let ServerExitDeadlineMs = 5000
let SessionCloseDeadlineMs = 10000 as WaitDeadlineMs
let NoContentStatus = 204
let NotModifiedStatus = 304

type HttpAnswer
	export var statusCode as HttpAnswerStatus
	export var headers as HeaderMap
	export var body as String

	static function create(statusCode HttpAnswerStatus, headers HeaderMap, body String) returns HttpAnswer
		return HttpAnswer{statusCode: statusCode, headers: headers, body: body}
	end 'create'

	function session() returns McpSession
		let id = try self.headers.get(McpSessionHeaderName) otherwise return McpSession.none

		return McpSession.minted(id)
	end 'session'

	export function bodyDoc() returns JsonDoc
		return try Json.parse(self.body) otherwise panic("McpHarness: an HTTP response body is not JSON: {self.body}")
	end 'bodyDoc'
end 'HttpAnswer'

union McpSession
	none
	minted(id String)
end 'McpSession'

function describedSession(session McpSession) returns String
	return match session 'which'
		none gives "no `Mcp-Session-Id`"
		minted(id) gives "`Mcp-Session-Id: {id}`"
	end 'which'
end 'describedSession'

function mcpRequestText(method String, target String, host String, origin String, sessionId McpSession, body String) returns String
	var text = "{method} {target} HTTP/1.1{HeaderSeparator}"
	text.append("Host: {host}{HeaderSeparator}")

	if not origin.isEmpty() 'hasOrigin'
		text.append("Origin: {origin}{HeaderSeparator}")
	end 'hasOrigin'

	match sessionId 'hasSession'
		none then break
		minted(id) then text.append("Mcp-Session-Id: {id}{HeaderSeparator}")
	end 'hasSession'

	text.append("Content-Type: application/json{HeaderSeparator}")
	text.append("Content-Length: {body.byteLength()}{HeaderSeparator}")
	text.append("Connection: close{HeaderSeparator}")
	text.append(HeaderSeparator)
	text.append(body)

	return text
end 'mcpRequestText'

// Anything that stops the exchange happening at all panics: none of it is the server answering
// wrongly.
function httpExchange(port NetworkPort, requestText String) returns HttpAnswer
	let client = try TcpClient.connect("127.0.0.1", port: port) otherwise (e) 'noConnection'
		panic("McpHarness: could not connect to the MCP HTTP transport on port {port}: {e.name}")
	end 'noConnection'

	let reader = StreamReader.over(client)

	_ = try reader.source.send(requestText) otherwise (e) 'sendFailed'
		reader.source.close()
		panic("McpHarness: could not send to the MCP HTTP transport: {e.name}")
	end 'sendFailed'

	let answer = try reader.readToEnd() otherwise (e) 'readFailed'
		reader.source.close()
		panic("McpHarness: reading the MCP HTTP transport's answer failed ({e.displayReason()})")
	end 'readFailed'

	reader.source.close()

	return parseHttpAnswer(String.from(answer))
end 'httpExchange'

function parseHttpAnswer(raw String) returns HttpAnswer
	let sections = raw.split(HeaderEnd)
	let head = try sections.get(0) otherwise panic("McpHarness: an HTTP answer is empty")

	if sections.count() < 2 'noBody'
		panic("McpHarness: an HTTP answer has no header terminator: {raw}")
	end 'noBody'

	var body = ""
	var sectionIndex = 1 as ElementIndex

	while sectionIndex < sections.count() 'rejoin'
		if sectionIndex > 1 'separator'
			body.append(HeaderEnd)
		end 'separator'

		body.append(try sections.get(sectionIndex) otherwise "")
		sectionIndex = sectionIndex + 1
	end 'rejoin'

	let lines = head.split(HeaderSeparator)
	let statusLine = try lines.get(0) otherwise panic("McpHarness: an HTTP answer has no status line: {raw}")
	let field = try statusLine.split(StatusLineFieldSeparator).get(1) otherwise panic("McpHarness: an HTTP answer has no status code: {statusLine}")
	let parsed = try int.fromString(field) otherwise panic("McpHarness: an HTTP answer's status code is not a number: {statusLine}")

	if parsed < LowestHttpAnswerStatus or parsed > HighestHttpAnswerStatus 'outsideTheStatusRange'
		panic("McpHarness: an HTTP answer's status code is outside {LowestHttpAnswerStatus}-{HighestHttpAnswerStatus}: {statusLine}")
	end 'outsideTheStatusRange'

	let statusCode = parsed as HttpAnswerStatus
	let headers = HeaderMap.create()
	let headerLines = StringArray.create(0)

	for (iter, line) in lines.withIterator() 'eachLine'
		if iter.index() == 0 'statusLine'
			continue
		end 'statusLine'

		headerLines.push(line)

		let parts = line.split(HeaderNameSeparator)

		if parts.count() >= 2 'named'
			let name = (try parts.get(0) otherwise "").toLower()
			let value = try parts.get(1) otherwise ""
			headers.upsert(name, value: value)
		end 'named'
	end 'eachLine'

	let contentless = statusCode == NoContentStatus or statusCode == NotModifiedStatus

	match httpHeaderBlockLength(headerLines, bound: AnswerBodyBound as UrlDecimalBound) 'framing'
		undeclared then requireUndeclaredFraming(contentless, body: body, raw: raw)
		malformedBlock then panic("McpHarness: an HTTP answer's header block is malformed: {raw}")
		notADecimal then panic("McpHarness: an HTTP answer's Content-Length is not a run of decimal digits: {raw}")
		aboveTheBound then panic("McpHarness: an HTTP answer's Content-Length is past {AnswerBodyBound}: {raw}")
		value(declaredBytes) then requireDeclaredFraming(contentless, declaredBytes: declaredBytes, body: body, raw: raw)
	end 'framing'

	return HttpAnswer.create(statusCode, headers: headers, body: body)
end 'parseHttpAnswer'

function requireUndeclaredFraming(contentless bool, body String, raw String)
	if not contentless 'bodied'
		panic("McpHarness: an HTTP answer carries no Content-Length, so a truncated one cannot be told from a whole one: {raw}")
	end 'bodied'

	if not body.isEmpty() 'carriesContent'
		panic("McpHarness: a contentless answer carries a body, which its status forbids: {raw}")
	end 'carriesContent'
end 'requireUndeclaredFraming'

function requireDeclaredFraming(contentless bool, declaredBytes BytePos, body String, raw String)
	if contentless 'forbidden'
		panic("McpHarness: a contentless answer carries a Content-Length, which its status forbids: {raw}")
	end 'forbidden'

	if body.byteLength() != declaredBytes 'truncated'
		panic("McpHarness: an HTTP answer declares {declaredBytes} body bytes and {body.byteLength()} arrived: {raw}")
	end 'truncated'
end 'requireDeclaredFraming'

let EndpointDeadlineMs = 60000
let ResponseLineByteCap = 16777216

union EndpointLine
	awaited
	printed(text String)
end 'EndpointLine'

enum EndpointNotPrinted implements Error
	awaited
end 'EndpointNotPrinted'

type EndpointWatch implements ChildLineSink
	var line as EndpointLine
	var stderrSeen as String

	static function create() returns EndpointWatch
		return Self{line: EndpointLine.awaited, stderrSeen: ""}
	end 'create'

	function isAwaiting() returns bool
		return match self.line 'line'
			awaited gives true
			printed gives false
		end 'line'
	end 'isAwaiting'

	function printedLine() returns String throws EndpointNotPrinted
		match self.line 'line'
			printed(text) then return text
			awaited then throw EndpointNotPrinted.awaited
		end 'line'
	end 'printedLine'

	export function heard(stream StdioStream, text String)
		match stream 'stream'
			stdout then self.line = EndpointLine.printed(text)
			stderr then self.stderrSeen.append("{text} ")
		end 'stream'
	end 'heard'

	export function broken(stream StdioStream, reason String)
		self.stderrSeen.append("(reading {stream.name} failed: {reason}) ")
	end 'broken'

	function said() returns String
		return self.stderrSeen if not self.stderrSeen.isEmpty() else "nothing on stderr"
	end 'said'
end 'EndpointWatch'

function watchedForEndpoint(pump ChildPump) returns EndpointWatch
	let watch = EndpointWatch.create()
	let started = Clock.nowMs()

	while watch.isAwaiting() and Clock.remainingMs(started, deadlineMs: EndpointDeadlineMs) > 0 'waiting'
		let event = pump.nextWithin(DefaultPumpWaitMs, started: started, deadlineMs: EndpointDeadlineMs)
		event.deliverTo(watch)

		match event 'event'
			said or
			closed or
			broke or
			silent then continue
			exhausted then break 'waiting'
		end 'event'
	end 'waiting'

	pump.stop()

	return watch
end 'watchedForEndpoint'

type HttpMcpAddress
	export let hostName as String
	export let port as NetworkPort

	static function at(hostName String, port NetworkPort) returns HttpMcpAddress
		return HttpMcpAddress{hostName: hostName, port: port}
	end 'at'

	export function authority() returns String
		return "{self.hostName}:{self.port}"
	end 'authority'

	export function loopbackOrigin() returns String
		return "http://{self.authority()}"
	end 'loopbackOrigin'

	function post(body String, sessionId McpSession) returns HttpAnswer
		return self.request("POST", target: McpRoutePath, host: self.authority(), origin: "", sessionId: sessionId, body: body)
	end 'post'

	function request(method String, target String, host String, origin String, sessionId McpSession, body String) returns HttpAnswer
		return httpExchange(self.port, requestText: mcpRequestText(method, target: target, host: host, origin: origin, sessionId: sessionId, body: body))
	end 'request'
end 'HttpMcpAddress'

// Every path owes `stop` or `terminate`: an unreleased `StreamingSubprocess` leaks and the run
// exits 101.
type StreamingHttpMcpServer
	export var server as StreamingSubprocess
	export var endpoint as String
	export let address as HttpMcpAddress

	static function start(extraOptions StringArray, environment Environment = Environment.inherit, endsWithItsStdin bool = true) returns StreamingHttpMcpServer
		let argv = StringArray.create(0)
		argv.push("mcp-server")
		argv.push(McpHttpOption)

		if endsWithItsStdin 'watchesItsStdin'
			argv.push(McpExitOnStdinEofOption)
		end 'watchesItsStdin'

		for option in extraOptions 'eachOption'
			argv.push(option)
		end 'eachOption'

		let spawned = try StreamingSubprocess.spawnWithEnvironment(Executable.path(testedCompilerPath()), arguments: argv, workingDirectory: WorkingDirectory.at(Directory.currentPath()), environment: environment) otherwise (e) 'spawnFailed'
			panic("StreamingHttpMcpServer: `mcp-server {McpHttpOption}` did not spawn: {e.displayReason()}")
		end 'spawnFailed'

		let pump = try ChildPump.of(spawned) otherwise (e) 'outputNotTaken'
			spawned.release()
			panic("StreamingHttpMcpServer: could not take the server's output: {e.displayReason()}")
		end 'outputNotTaken'

		let watch = watchedForEndpoint(pump)

		let line = try watch.printedLine() otherwise 'noEndpoint'
			spawned.release()
			panic("StreamingHttpMcpServer: the server printed no endpoint line. It said: {watch.said()}")
		end 'noEndpoint'

		let doc = try Json.parse(line.trim()) otherwise 'notJson'
			spawned.release()
			panic("StreamingHttpMcpServer: the endpoint line is not JSON. Stdout: `{line}`. It said: {watch.said()}")
		end 'notJson'

		let endpointText = try doc.getString(doc.root, key: EndpointKey) otherwise 'noKey'
			spawned.release()
			panic("StreamingHttpMcpServer: the endpoint line has no `{EndpointKey}`: {line}")
		end 'noKey'

		let url = try URL.parse(endpointText) otherwise 'notAUrl'
			spawned.release()
			panic("StreamingHttpMcpServer: the endpoint is not a URL: {endpointText}")
		end 'notAUrl'

		let parsedHost = try url.host() otherwise 'noHost'
			spawned.release()
			panic("StreamingHttpMcpServer: the endpoint names no host: {endpointText}")
		end 'noHost'

		let parsedPort = try url.port() otherwise 'noPort'
			spawned.release()
			panic("StreamingHttpMcpServer: the endpoint names no port: {endpointText}")
		end 'noPort'

		return StreamingHttpMcpServer{server: spawned, endpoint: endpointText, address: HttpMcpAddress.at(parsedHost, port: parsedPort)}
	end 'start'

	function initializeSession() returns (HttpAnswer, McpSession)
		let answer = self.address.post(initRequest(1), sessionId: McpSession.none)
		return (answer, answer.session())
	end 'initializeSession'

	export function stop() throws TestFailure
		self.server.closeStdin()

		let code = try self.server.wait(WaitDeadline.within(ServerExitDeadlineMs)) otherwise (e) 'noExit'
			self.server.release()
			try Expect.fail("`mcp-server {McpHttpOption}` did not exit within {ServerExitDeadlineMs} ms of its stdin closing ({e.displayReason()}), so it was terminated")

			return
		end 'noExit'

		self.server.release()
		try Expect.equal(code, expected: 0, message: "`mcp-server {McpHttpOption}` must exit 0 when its stdin closes; it exited {code}")
	end 'stop'

	export function closeItsStdin()
		self.server.closeStdin()
	end 'closeItsStdin'

	// For a server started without `endsWithItsStdin`: the HTTP transport has no shutdown route, so
	// `release` ends it and its exit code says nothing. No case may assert one.
	export function terminate()
		requireTreeEnded(self.server, what: "the HTTP `mcp-server`")
		self.server.release()
	end 'terminate'
end 'StreamingHttpMcpServer'

let RpcInvalidParamsCode = -32602
let RpcMethodNotFoundCode = -32601

typealias ProgramSleepMillis = int(0 to 60000)

let SleepingProgramStartedLine = "started sleeping"

function sleepingProgramSource(sleepMs ProgramSleepMillis) returns String
	var source = ""
	source.append("function main() returns ExitCode\n")
	source.append("\tprint(\"{SleepingProgramStartedLine}\\n\")\n")
	source.append("\tsleep({sleepMs})\n")
	source.append("\tprint(\"slept\\n\")\n")
	source.append("\n")
	source.append("\treturn 0\n")
	source.append("end 'main'\n")

	return source
end 'sleepingProgramSource'

function debuggableProgramSource() returns String
	let lines = StringArray.create(0)
	lines.push("typealias Step = int(0 to 1000000)")
	lines.push("")
	lines.push("function work(seed Step) returns Step")
	lines.push("\tvar total = seed")
	lines.push("\tvar i = 0 as Step")
	lines.push("")
	lines.push("\twhile i < 4 'grind'")
	lines.push("\t\ttotal = total + i {AnchorMarker}{DebuggableProgramAnchor}")
	lines.push("\t\ti = i + 1")
	lines.push("\tend 'grind'")
	lines.push("")
	lines.push("\treturn total")
	lines.push("end 'work'")
	lines.push("")
	lines.push("function main() returns ExitCode")
	lines.push("\tvar total = 0 as Step")
	lines.push("\ttotal = total + work(1)")
	lines.push("\ttotal = total + work(2)")
	lines.push("\tprint(\"total \{total\}\\n\")")
	lines.push("")
	lines.push("\treturn 0")
	lines.push("end 'main'")

	return terminatedLines(lines)
end 'debuggableProgramSource'

let DebuggableProgramLocalName = "total"

function stdioToolCall(session StreamingMcpSession, id RequestId, name String, argumentsJson String = "\{\}") returns JsonDoc
	try session.sendLine(toolCallRequest(id, name: name, argumentsJson: argumentsJson)) otherwise (e) 'writeFailed'
		panic("McpHarness: could not send `{name}`: {e.displayReason()}")
	end 'writeFailed'

	return try session.readResponseDoc() otherwise (e) 'readFailed'
		panic("McpHarness: no answer to `{name}`: {e.displayReason()}")
	end 'readFailed'
end 'stdioToolCall'

function stdioHandshake(session StreamingMcpSession)
	try session.sendLine(initRequest(1)) otherwise (e) 'writeFailed'
		panic("McpHarness: could not send `initialize`: {e.displayReason()}")
	end 'writeFailed'

	_ = try session.readResponseDoc() otherwise (e) 'readFailed'
		panic("McpHarness: no answer to `initialize`: {e.displayReason()}")
	end 'readFailed'
end 'stdioHandshake'

let DebuggedBuildLabel = "debuggee"

function buildStagedProgram(program FilePath) returns FilePath
	let directory = try program.parent() otherwise panic("McpHarness: {program.path} has no directory to build into")
	let executable = directory.join("debuggee{executableSuffix()}")
	let build = spawnBuild(program, staged: directory, output: executable, label: DebuggedBuildLabel, extraArguments: StringArray.create(0))

	requireBuiltOrPanic(build, output: executable, what: "the build of {program.path} for a debug session")

	return executable
end 'buildStagedProgram'

let DebugStateKey = "state"
let DebugEventsKey = "events"
let DebugEventKindKey = "event"
let DebugOutputKey = "output"

function debugToolState(doc JsonDoc) returns String
	let payload = toolPayload(doc)
	return try payload.getString(payload.root, key: DebugStateKey) otherwise panic("McpHarness: a debug tool answered no `{DebugStateKey}`: {toolCallText(doc)}")
end 'debugToolState'

function payloadArray(payload JsonDoc, doc JsonDoc, key String) returns JsonNodeIdArray
	let arrayId = try payload.getChild(payload.root, key: key) otherwise panic("McpHarness: a tool answered no `{key}`: {toolCallText(doc)}")
	let count = try payload.arrayLength(arrayId) otherwise panic("McpHarness: `{key}` is not an array: {toolCallText(doc)}")
	let elements = JsonNodeIdArray.create(0)

	for i in 0 upto count 'eachElement'
		elements.push(try payload.arrayAt(arrayId, index: i) otherwise panic("McpHarness: `{key}` has no element {i} of its {count}"))
	end 'eachElement'

	return elements
end 'payloadArray'

function payloadArrayFields(doc JsonDoc, key String, field String) returns StringArray
	let payload = toolPayload(doc)
	let values = StringArray.create(0)

	for elementId in payloadArray(payload, doc: doc, key: key) 'eachElement'
		values.push(try payload.getString(elementId, key: field) otherwise panic("McpHarness: a `{key}` element carries no string `{field}`: {toolCallText(doc)}"))
	end 'eachElement'

	return values
end 'payloadArrayFields'

function payloadArrayStrings(doc JsonDoc, key String) returns StringArray
	let payload = toolPayload(doc)
	let values = StringArray.create(0)

	for elementId in payloadArray(payload, doc: doc, key: key) 'eachElement'
		values.push(payload.get(elementId).stringValue)
	end 'eachElement'

	return values
end 'payloadArrayStrings'

function debugEventKinds(doc JsonDoc) returns StringArray
	let payload = toolPayload(doc)
	let kinds = StringArray.create(0)

	for eventId in payloadArray(payload, doc: doc, key: DebugEventsKey) 'eachEvent'
		let kind = try payload.getString(eventId, key: DebugEventKindKey) otherwise continue
		kinds.push(kind)
	end 'eachEvent'

	return kinds
end 'debugEventKinds'

function debugEventLines(doc JsonDoc, kind String) returns StringArray
	let payload = toolPayload(doc)
	let lines = StringArray.create(0)

	for eventId in payloadArray(payload, doc: doc, key: DebugEventsKey) 'eachEvent'
		let eventKind = try payload.getString(eventId, key: DebugEventKindKey) otherwise continue

		if eventKind.equals(kind) 'wanted'
			let line = try payload.getInt(eventId, key: "line") otherwise panic("McpHarness: a `{kind}` event carries no `line`: {toolCallText(doc)}")
			lines.push("{line}")
		end 'wanted'
	end 'eachEvent'

	return lines
end 'debugEventLines'

function debugOutputLines(doc JsonDoc) returns StringArray
	let payload = toolPayload(doc)
	let lines = StringArray.create(0)

	for lineId in payloadArray(payload, doc: doc, key: DebugOutputKey) 'eachLine'
		let line = payload.get(lineId)

		if line.kind != JsonKind.jsonString 'notText'
			panic("McpHarness: a `{DebugOutputKey}` element is not a string: {toolCallText(doc)}")
		end 'notText'

		lines.push(line.stringValue)
	end 'eachLine'

	return lines
end 'debugOutputLines'

function debugLocalNames(doc JsonDoc) returns StringArray
	let payload = toolPayload(doc)
	let names = StringArray.create(0)

	for eventId in payloadArray(payload, doc: doc, key: DebugEventsKey) 'eachEvent'
		let localsId = try payload.getChild(eventId, key: "locals") otherwise continue
		let localCount = try payload.arrayLength(localsId) otherwise continue

		for j in 0 upto localCount 'eachLocal'
			let localId = try payload.arrayAt(localsId, index: j) otherwise continue
			let name = try payload.getString(localId, key: "name") otherwise continue
			names.push(name)
		end 'eachLocal'
	end 'eachEvent'

	return names
end 'debugLocalNames'

let DebugStartTool = "debug_start"
let DebugBreakTool = "debug_break"
let DebugContinueTool = "debug_continue"
let DebugLocalsTool = "debug_locals"
let DebugStopTool = "debug_stop"
let ExecuteTool = "execute"
let BuildTool = "build"
let TestTool = "test"
let FmtTool = "fmt"

let TimeoutSecondsArgument = "timeoutSeconds"
let StopTimeoutArgument = "stopTimeoutSeconds"
let BoundStoppedMarker = "stopped waiting"

let DebuggableProgramAnchor = "hot"
let DebugStoppedState = "stopped"
let DebugStopEventName = "stop"
let HttpOkStatus = 200

let ArgumentMemberSeparator = ","

function argumentsOf(members StringArray) returns String
	var joined = ""

	for member in members 'eachMember'
		joined = member if joined.isEmpty() else "{joined}{ArgumentMemberSeparator}{member}"
	end 'eachMember'

	return "\{{joined}\}"
end 'argumentsOf'

function executableMember(executable FilePath) returns String
	return "\"executable\":{Json.quote(executable.toString())}"
end 'executableMember'

function sourceMember(source String) returns String
	return "\"source\":{Json.quote(source)}"
end 'sourceMember'

function pathMember(file FilePath) returns String
	return "\"path\":{Json.quote(file.toString())}"
end 'pathMember'

function outputMember(output FilePath) returns String
	return "\"output\":{Json.quote(output.toString())}"
end 'outputMember'

function targetMember(target String) returns String
	return "\"target\":{Json.quote(target)}"
end 'targetMember'

function secondsMember(key String, seconds String) returns String
	return "\"{key}\":{seconds}"
end 'secondsMember'

function debugExecutableArgument(executable FilePath) returns String
	return argumentsOf([executableMember(executable)])
end 'debugExecutableArgument'

function sourceArgument(source String) returns String
	return argumentsOf([sourceMember(source)])
end 'sourceArgument'

function debugBreakTargetArgument(line SourceLine) returns String
	return argumentsOf([targetMember("main.maxon:{line}")])
end 'debugBreakTargetArgument'

function httpToolCall(address HttpMcpAddress, sessionId McpSession, id RequestId, name String, argumentsJson String = "\{\}") returns JsonDoc
	let answer = address.post(toolCallRequest(id, name: name, argumentsJson: argumentsJson), sessionId: sessionId)

	if answer.statusCode != HttpOkStatus 'refused'
		panic("mcp http tests: `{name}` over HTTP answered {answer.statusCode}: {answer.body}")
	end 'refused'

	return answer.bodyDoc()
end 'httpToolCall'

let WellFormedSource = "function main() returns ExitCode\n\treturn 0\nend 'main'\n"
let AnotherHost = "another-os/another-host/another-namespace"
let SleepMs = 60000
let OkStatus = 200 as HttpAnswerStatus
let IdleTimeoutSeconds = 1
let AcceptedStatus = 202 as HttpAnswerStatus
let NotFoundStatus = 404 as HttpAnswerStatus
let SnippetDirName = "mcp-snippet"
let SnippetStem = "mcp-snippet"
let CompilerStem = "maxon"
let PreviousInfix = ".previous"
let ProgramFileName = "program.maxon"
let RetiredImageProbeLabel = "mcp-retired-images"
let RetiredImagePlantedSerial = 7
let RetiredImagePlantedText = "left by an earlier build"
let NumberedRetiredBase = "maxon.retired-"
let RetiredBase = "maxon.retired"

function plantNamesBeside(dir FilePath, names StringArray)
	for name in names 'eachName'
		writeStagedFile(dir.join(name), content: RetiredImagePlantedText)
	end 'eachName'
end 'plantNamesBeside'

type PlantedRetiredImages
	export var minted as StringArray
	export var numbered as StringArray
	export var lookalikes as StringArray

	static function plantBeside(dir FilePath) returns Self
		let suffix = executableSuffix()
		let mintedHere = mintedScratchName(RetiredImageProbeLabel, base: RetiredBase, namespace: OwnHostNamespace, pid: endedProcessId(), serial: RetiredImagePlantedSerial)
		let mintedByAnotherHost = mintedScratchName(RetiredImageProbeLabel, base: RetiredBase, namespace: AnotherHost, pid: endedProcessId(), serial: RetiredImagePlantedSerial + 1)

		let minted = [
			"{mintedHere}{suffix}",
			"{mintedHere}{suffix}{SidecarSuffix}",
			"{mintedByAnotherHost}{suffix}"
		]

		let numbered = [
			"{NumberedRetiredBase}123{suffix}",
			"{NumberedRetiredBase}123{suffix}{SidecarSuffix}"
		]

		let lookalikes = [
			"{NumberedRetiredBase}notes.txt",
			"{NumberedRetiredBase}123notes.txt",
			"{mintedHere}.notes.txt",
			"{RetiredBase}.notes.txt"
		]

		plantNamesBeside(dir, names: minted)
		plantNamesBeside(dir, names: numbered)
		plantNamesBeside(dir, names: lookalikes)

		return Self{minted: minted, numbered: numbered, lookalikes: lookalikes}
	end 'plantBeside'
end 'PlantedRetiredImages'

function plantPreviousImageBeside(dir FilePath)
	writeStagedFile(dir.join("{CompilerStem}{PreviousInfix}{executableSuffix()}"), content: RetiredImagePlantedText)
end 'plantPreviousImageBeside'

function expectNamesSwept(dir FilePath, names StringArray, why String) throws TestFailure
	for name in names 'eachSwept'
		try Expect.isFalse(File.exists(dir.join(name)), message: "{name} is still there, and it should have been deleted: {why}")
	end 'eachSwept'
end 'expectNamesSwept'

function expectNamesKept(dir FilePath, names StringArray, why String) throws TestFailure
	for name in names 'eachKept'
		try Expect.isTrue(File.exists(dir.join(name)), message: "{name} was deleted, and it should have stayed: {why}")
	end 'eachKept'
end 'expectNamesKept'
