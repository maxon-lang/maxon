let RewriteGateSpecName = "rewrite-gate"
let RewriteGateSpecFileName = "rewrite-gate.md"
let RewriteGatePassingCase = "rewrite-gate.pinned"
let RewriteGateWrongExitCodeCase = "rewrite-gate.wrong-exit-code"
let RewriteGateStaleCaptureCase = "rewrite-gate.stale-capture"
let RewriteGateMintedCount = 1
let RewriteGateCorruptedLine = "// planted by the rewrite-drifted-goldens gate; the flag must write the fresh golden over it"
let RewriteGatePlantedLine = "// planted by the rewrite-drifted-goldens gate beside a FAILING case; the flag must leave it alone"
let RewriteDriftedGoldensFlag = "--rewrite-drifted-goldens"

type RewriteGatePlant
	export let path as FilePath
	export let caseName as String
	export let content as String

	static function create(path FilePath, caseName String, content String) returns RewriteGatePlant
		return Self{path: path, caseName: caseName, content: content}
	end 'create'
end 'RewriteGatePlant'

typealias RewriteGatePlantArray = Array with RewriteGatePlant

test 'rewrite-drifted-goldens writes a passing case its fresh golden and leaves failing cases goldens and the spec file alone'
	let staged = stagedGateFixture()

	let mint = runSpecTest(staged, includeNetwork: false)
	let minted = mintedGoldensIn(staged)

	try Expect.equal(minted.count(), expected: RewriteGateMintedCount, message: "the fixture's mint run left {minted.count()} golden(s), not {RewriteGateMintedCount}. Only '{RewriteGatePassingCase}' may PASS and pin emitted code; the other two must fail, or there is no failing case to plant a golden beside. The mint run said:\n{everythingSaid(mint)}") otherwise (failure) 'mintedTheWrongCount'
		discardStaging(staged)
		throw failure
	end 'mintedTheWrongCount'

	let passingGolden = mintedGoldenOf(minted, caseName: RewriteGatePassingCase)
	let emitted = readStagedText(passingGolden)
	writeStagedText(passingGolden, content: "{RewriteGateCorruptedLine}\n")

	let specGoldenDir = try passingGolden.parent() otherwise panic("spec-harness tests: the gate could not run - the minted golden {passingGolden.toString()} has no parent directory.")
	var plants = RewriteGatePlantArray.create()

	for caseName in [RewriteGateWrongExitCodeCase, RewriteGateStaleCaptureCase] 'eachFailing'
		let plant = RewriteGatePlant.create(specGoldenDir.join("{caseName}{GoldenExtension}"), caseName: caseName, content: "{RewriteGatePlantedLine} {caseName}\n")
		writeStagedText(plant.path, content: plant.content)
		plants.push(plant)
	end 'eachFailing'

	let specPath = staged.join(RewriteGateSpecFileName)
	let specBefore = readStagedText(specPath)

	var arguments = StringArray.create()
	arguments.push(RewriteDriftedGoldensFlag)

	let run = runSpecTest(staged, includeNetwork: false, extraArguments: arguments)

	let passingAfter = readStagedText(passingGolden)
	var plantsAfter = StringArray.create()

	for plant in plants 'eachReadBack'
		plantsAfter.push(readStagedText(plant.path))
	end 'eachReadBack'

	let specAfter = readStagedText(specPath)
	discardStaging(staged)

	let said = everythingSaid(run)
	var broken = StringArray.create()

	if passingAfter != emitted 'notRewritten'
		broken.push("'{RewriteGatePassingCase}' PASSED, and its corrupted golden was not written back to what this compiler emits. It now reads:\n{passingAfter}\nThe run said:\n{said}\n")
	end 'notRewritten'

	for (iter, plant) in plants.withIterator() 'eachPlant'
		let after = try plantsAfter.get(iter.index()) otherwise panic("spec-harness tests: one golden is read back per plant, in one loop")

		if after != plant.content 'plantMoved'
			broken.push("'{plant.caseName}' FAILED, and its golden was rewritten anyway: a golden is only worth the verdict that validated it. It now reads:\n{after}\nThe run said:\n{said}\n")
		end 'plantMoved'

		let failVerdict = failVerdictPrefix(testLabel(RewriteGateSpecName, testName: plant.caseName))

		if not run.stdout.contains(failVerdict) 'didNotFail'
			broken.push("'{plant.caseName}' was not reported FAILING, so the fixture no longer proves the rewrite is refused to a failing case. Expected '{failVerdict}', and the run said:\n{said}\n")
		end 'didNotFail'
	end 'eachPlant'

	if specAfter != specBefore 'specRewritten'
		broken.push("the spec file changed under {RewriteDriftedGoldensFlag}. Only `--update-required` re-splices a capture block into it. It now reads:\n{specAfter}\nThe run said:\n{said}\n")
	end 'specRewritten'

	let passVerdict = passVerdictLine(testLabel(RewriteGateSpecName, testName: RewriteGatePassingCase))

	if not run.stdout.contains(passVerdict) 'didNotPass'
		broken.push("'{RewriteGatePassingCase}' is not reported PASSING. Expected '{passVerdict}', and the run said:\n{said}\n")
	end 'didNotPass'

	if said.contains(DriftHeadline) 'reportedAsDrift'
		broken.push("the run printed the drift report, and the only golden that differed was the one {RewriteDriftedGoldensFlag} rewrote. It said:\n{said}\n")
	end 'reportedAsDrift'

	if run.exitCode() == SuccessExitCode 'failuresDidNotCount'
		broken.push("the run exited {SuccessExitCode} with two failing cases in it. It said:\n{said}\n")
	end 'failuresDidNotCount'

	requireNothingBroken(broken, headline: RewriteDriftedGoldensFlag)
end 'rewrite-drifted-goldens writes a passing case its fresh golden and leaves failing cases goldens and the spec file alone'
