let DriftGateSpecName = "drift-gate"
let DriftGateDriftedCase = "drift-gate.pinned"
let DriftGateSecondDriftedCase = "drift-gate.also-pinned"
let DriftGateIntactCase = "drift-gate.intact"
let DriftGateGoldenCount = 3
let DriftGateCorruptedLine = "// planted by the drifted-golden gate and put back by it; a deliberate mismatch"

typealias DriftTally = int(0 to u64.max)

type DriftGoldenBackup
	export let path as FilePath
	export let caseName as String
	export let emitted as String

	static function create(path FilePath, caseName String, emitted String) returns DriftGoldenBackup
		return Self{path: path, caseName: caseName, emitted: emitted}
	end 'create'
end 'DriftGoldenBackup'

typealias DriftGoldenBackupArray = Array with DriftGoldenBackup

test 'a committed golden that contradicts the compiler is named, counted and quoted, and moves no verdict'
	let staged = stagedGateFixture()

	let mint = runSpecTest(staged, includeNetwork: false)
	let minted = mintedGoldensIn(staged)

	try Expect.equal(minted.count(), expected: DriftGateGoldenCount, message: "the fixture's mint run left {minted.count()} golden(s), not {DriftGateGoldenCount}. Its cases must PASS and pin emitted code, or there is nothing to corrupt. The mint run said:\n{everythingSaid(mint)}") otherwise (failure) 'mintedTheWrongCount'
		discardStaging(staged)
		throw failure
	end 'mintedTheWrongCount'

	var corruptedGoldens = DriftGoldenBackupArray.create()

	for caseName in [DriftGateDriftedCase, DriftGateSecondDriftedCase] 'eachDrifted'
		let path = mintedGoldenOf(minted, caseName: caseName)
		let emitted = readStagedText(path)
		corruptedGoldens.push(DriftGoldenBackup.create(path, caseName: caseName, emitted: emitted))
		writeStagedText(path, content: "{DriftGateCorruptedLine}\n")
	end 'eachDrifted'

	let corrupted = runSpecTest(staged, includeNetwork: false)

	for backup in corruptedGoldens 'eachRestore'
		writeStagedText(backup.path, content: backup.emitted)
	end 'eachRestore'

	let restored = everythingSaid(runSpecTest(staged, includeNetwork: false))
	discardStaging(staged)

	let onStdout = corrupted.stdout
	let onStderr = corrupted.stderr
	let said = everythingSaid(corrupted)

	var broken = StringArray.create()

	for backup in corruptedGoldens 'eachAssertion'
		let label = testLabel(DriftGateSpecName, testName: backup.caseName)
		let driftedEntry = resultNoteEntry(label)

		if not onStderr.contains(driftedEntry) 'didNotNameTheCase'
			broken.push("the trailer did NOT name '{backup.caseName}', whose golden was corrupted. Expected it to contain:\n{driftedEntry}and the run said:\n{said}\n")
		end 'didNotNameTheCase'

		if not onStderr.contains(backup.path.toString()) 'didNotNameTheFile'
			broken.push("the trailer named '{backup.caseName}' but not the FILE. Expected '{backup.path.toString()}', and the run said:\n{said}\n")
		end 'didNotNameTheFile'

		let passVerdict = passVerdictLine(label)

		if not onStdout.contains(passVerdict) 'driftMovedTheVerdict'
			broken.push("'{backup.caseName}' is no longer reported as PASSING. A golden is REFERENCE, NOT A GATE. Expected '{passVerdict}', and the run said:\n{said}\n")
		end 'driftMovedTheVerdict'
	end 'eachAssertion'

	if not onStderr.contains(DriftGateCorruptedLine) 'showedNoDifference'
		broken.push("the trailer named the drifted goldens but did not show what DIFFERS: the line written into them never appears. It said:\n{said}\n")
	end 'showedNoDifference'

	let summary = driftSummary(corruptedGoldens.count() as DriftTally)

	if not onStdout.contains(summary) 'summaryStayedSilent'
		broken.push("the run's SUMMARY, on STDOUT, says nothing about the {corruptedGoldens.count()} drifted goldens. Expected '{summary}', and the run said:\n{said}\n")
	end 'summaryStayedSilent'

	if corrupted.exitCode() != SuccessExitCode 'driftMovedTheExitCode'
		broken.push("a run whose only finding was {corruptedGoldens.count()} drifted goldens exited {corrupted.exitCode()}. A golden is REFERENCE, NOT A GATE.\n")
	end 'driftMovedTheExitCode'

	let intactEntry = resultNoteEntry(testLabel(DriftGateSpecName, testName: DriftGateIntactCase))

	if onStderr.contains(intactEntry) 'namedAGoldenThatMatched'
		broken.push("the trailer NAMED '{DriftGateIntactCase}', whose golden was compared and MATCHED. It said:\n{said}\n")
	end 'namedAGoldenThatMatched'

	if restored.contains(DriftHeadline) 'reportedAMatchingGolden'
		broken.push("the SAME fixture, with the goldens put back, still printed the drift report. It said:\n{restored}\n")
	end 'reportedAMatchingGolden'

	requireNothingBroken(broken, headline: "the golden-drift report")
end 'a committed golden that contradicts the compiler is named, counted and quoted, and moves no verdict'

function driftSummary(drifted DriftTally) returns String
	return "{drifted} committed golden(s) OF THE CASES THIS RUN COMPARED {DriftHeadline} — GOLDENS ARE REFERENCE, NOT A GATE: nothing failed on this and the exit code is unaffected (the note on stderr has the differences)"
end 'driftSummary'
