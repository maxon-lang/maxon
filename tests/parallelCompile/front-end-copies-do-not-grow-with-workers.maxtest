let FrontEndPoolPhaseName = "frontEndPool"
let IndexOverlayLinePrefix = "[CMP] DEBUG: front end index overlay: "
let IndexCopyLinePrefix = "[CMP] DEBUG: front end index copy: "
let PooledProcessors = 4 as ProcessorCount
let MinimumPooledAdoptions = 3 as ReportedPoolCount
let OverlayCopyDivisor = 4 as ReportedPoolCount
let WorkerCopyDivisor = 4 as ReportedPoolCount
let WarmUpLabel = "library-cache warm-up"
let OneProcessorLabel = "one processor"
let PooledLabel = "four processors"

test 'the front end copies no part of the signature index per worker or per file'
	let staged = stagedFixtureTree(FixturesDirName, caseLabel: "front-end-copies-do-not-grow-with-workers", fixture: "shared-index-program")

	var arguments = StringArray.create(0)
	arguments.push(CompilerDebugLogFlag)

	_ = meteredBuild(staged, label: WarmUpLabel, extraArguments: arguments, processors: ProcessorPin.pinned(PooledProcessors), wholeDirectory: true)
	_ = metricsTableOf(staged, label: WarmUpLabel)

	let single = meteredBuild(staged, label: OneProcessorLabel, extraArguments: arguments, processors: ProcessorPin.pinned(SingleProcessor), wholeDirectory: true)
	let singleAllocations = frontEndPoolAllocations(metricsTableOf(staged, label: OneProcessorLabel))
	let singleAdoptions = frontEndAdoptions(single)

	let pooled = meteredBuild(staged, label: PooledLabel, extraArguments: arguments, processors: ProcessorPin.pinned(PooledProcessors), wholeDirectory: true)
	let pooledAllocations = frontEndPoolAllocations(metricsTableOf(staged, label: PooledLabel))
	let pooledAdoptions = frontEndAdoptions(pooled)

	Expect.atLeast(pooledAdoptions, than: MinimumPooledAdoptions, message: "under MAXON_MAX_PROCS={PooledProcessors} the front end reported {pooledAdoptions} worker(s) adopting the signature index, so its parse drain did not spread the fixture's similar-sized files over several workers and the growth below measures nothing. One processor reported {singleAdoptions}.")
	Expect.greaterThan(pooledAdoptions, than: singleAdoptions, message: "the front end reported {pooledAdoptions} adoption(s) at {PooledProcessors} processors and {singleAdoptions} at one, so there is no extra worker to price.")

	let copyAllocations = reportedAllocations(pooled, prefix: IndexCopyLinePrefix)
	let overlayAllocations = reportedAllocations(pooled, prefix: IndexOverlayLinePrefix)
	Expect.greaterThan(copyAllocations, than: 0, message: "the front end reported a whole-index copy of {copyAllocations} allocations, so the bounds below measure nothing.")
	Expect.greaterThan(overlayAllocations, than: 0, message: "the front end reported a parse overlay of {overlayAllocations} allocations, so the bound below measures nothing.")

	let overlayBound = copyAllocations / OverlayCopyDivisor
	Expect.lessThan(overlayAllocations, than: overlayBound, message: "one parse's overlay over the shared signature index allocated {overlayAllocations} times, and a whole copy of that index {copyAllocations}: an overlay holds only what its parse writes, so it may cost at most 1/{OverlayCopyDivisor} of a copy, {overlayBound}.")

	let growth = pooledAllocations - singleAllocations
	let extraAdoptions = pooledAdoptions - singleAdoptions
	let perAdoption = try (growth / extraAdoptions) otherwise panic("parallel-compile.test: the adoption counts were found to differ above")

	let workerBound = copyAllocations / WorkerCopyDivisor

	Expect.lessThan(perAdoption, than: workerBound, message: "the `{PhaseRowKind} {FrontEndPoolPhaseName}` row allocated {pooledAllocations} times with {pooledAdoptions} worker(s) adopting the index under MAXON_MAX_PROCS={PooledProcessors}, and {singleAllocations} times with {singleAdoptions} under one processor: {growth} more, {perAdoption} per extra adopting worker. A whole copy of this fixture's signature index allocates {copyAllocations}, and an extra worker may cost at most 1/{WorkerCopyDivisor} of it, {workerBound}, for its own state — every worker reads the one published index and each parse writes only its own overlay, so neither the main thread nor a worker copies the index.")

	discardStagedDir(staged)
end 'the front end copies no part of the signature index per worker or per file'

function frontEndPoolAllocations(table MetricsTable) returns ReportedPoolCount
	let cell = table.cellOf(PhaseRowKind, name: FrontEndPoolPhaseName, column: AllocsColumn)
	return try int.fromString(cell) otherwise panic("parallel-compile.test: the `{PhaseRowKind} {FrontEndPoolPhaseName}` row holds '{cell}' where an allocation count belongs.")
end 'frontEndPoolAllocations'

function reportedAllocations(run CollectedOutput, prefix String) returns ReportedPoolCount
	let afterPrefix = try run.stderr.split(prefix).get(1) otherwise panic("parallel-compile.test: `{CompilerDebugLogFlag}` printed no line starting `{prefix}`, so the allocation count it reports cannot be read. It wrote to stderr: {run.stderr}")
	let line = (try afterPrefix.split(LineFeed).get(0) otherwise panic("parallel-compile.test: splitting a string always yields its first piece")).trim()
	let count = try line.split(" ").get(0) otherwise panic("parallel-compile.test: splitting a string always yields its first piece")

	return try int.fromString(count) otherwise panic("parallel-compile.test: the line holds '{count}' where an allocation count belongs. It wrote: {line}")
end 'reportedAllocations'
