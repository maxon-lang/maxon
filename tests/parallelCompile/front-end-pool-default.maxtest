// front-end-pool-default.maxtest — with no processor pin, the front end lexes and parses on min(P, F) workers,
// F the most files one drain dispatched, and says so once (`requireFrontEndPoolAtDefault`).

test 'the front end is one worker per processor up to the files it parses'
	let staged = stagedFixtureTree(FixturesDirName, stagingRootDir: StagingRootDirName, caseLabel: "front-end-pool-default", fixture: "front-end-program")

	var arguments = StringArray.create()
	arguments.push(CompilerDebugLogFlag)
	let run = spawnPinnedBuild(staged, label: "default-processors", extraArguments: arguments, processors: ProcessorPin.machine, wholeDirectory: true)

	let observedExit = run.exitCode()
	Expect.equal(observedExit, expected: 0, message: "the front-end program did not compile at the default processor count. It wrote to stderr: {run.stderr}")

	requireOneFrontEndPoolLine(run)
	requireFrontEndPoolAtDefault(run)
end 'the front end is one worker per processor up to the files it parses'
