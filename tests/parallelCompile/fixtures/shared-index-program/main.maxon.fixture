typealias Score = int(0 to 1000000)

function main() returns ExitCode
	var score = 0 as Score
	score = (score + alphaScore(1) as Score) mod 100000
	score = (score + bravoScore(2) as Score) mod 100000
	score = (score + charlieScore(3) as Score) mod 100000
	score = (score + deltaScore(4) as Score) mod 100000
	score = (score + echoScore(5) as Score) mod 100000
	score = (score + foxtrotScore(6) as Score) mod 100000
	score = (score + golfScore(7) as Score) mod 100000

	if score > 0 'scored'
		return 0
	end 'scored'

	return 1
end 'main'
