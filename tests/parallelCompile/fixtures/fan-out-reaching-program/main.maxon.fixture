typealias Integer = int(i64.min to i64.max)
typealias IntegerArray = Array with Integer
typealias LabelArray = Array with String

function main() returns ExitCode
	let values = IntegerArray.create(0)
	let labels = LabelArray.create(0)

	for i in 0 upto 6 'fill'
		values.push((6 - i) * 3)
		labels.push("item {i}")
	end 'fill'

	values.sort()

	var total = 0 as Integer

	for value in values 'sum'
		total = total + value
	end 'sum'

	for label in labels 'show'
		print("{label}\n")
	end 'show'

	print("total {total}\n")

	return 0
end 'main'
