typealias Integer = int(i64.min to i64.max)

function tripled(n Integer) returns Integer
	return n * 3
end 'tripled'

function stepped(n Integer) returns Integer
	return tripled(n) + 1
end 'stepped'

function main() returns ExitCode
	if stepped(2) == 7 'computed'
		return 0
	end 'computed'

	return 1
end 'main'
