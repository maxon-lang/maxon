// Thirty-two accumulators and the counter are thirty-three values live across the loop at once —
// more than the allocatable GPR pool of ANY host this corpus runs on, so every host refuses this
// program for register pressure rather than compiling it.
//
// ⚠ **THE CALIBRATION RULE: MORE HOT VALUES THAN THE WIDEST HOST POOL.** `allocatablePool`
// (`maxon-bin/Compiler/Targets/Shared/RegisterAllocator.maxon`) offers x64 fourteen GPRs and arm64
// twenty-six; a host or a pool wider than the count here compiles this program, and the case that
// stages it then goes red for the pool's width rather than for the allocator's answer. Grow the
// accumulators past the new pool, never restrict the case to the hosts it still fits.

function hot(_ Integer) returns Integer
	var s1 = 1 as Integer
	var s2 = 2 as Integer
	var s3 = 3 as Integer
	var s4 = 4 as Integer
	var s5 = 5 as Integer
	var s6 = 6 as Integer
	var s7 = 7 as Integer
	var s8 = 8 as Integer
	var s9 = 9 as Integer
	var s10 = 10 as Integer
	var s11 = 11 as Integer
	var s12 = 12 as Integer
	var s13 = 13 as Integer
	var s14 = 14 as Integer
	var s15 = 15 as Integer
	var s16 = 16 as Integer
	var s17 = 17 as Integer
	var s18 = 18 as Integer
	var s19 = 19 as Integer
	var s20 = 20 as Integer
	var s21 = 21 as Integer
	var s22 = 22 as Integer
	var s23 = 23 as Integer
	var s24 = 24 as Integer
	var s25 = 25 as Integer
	var s26 = 26 as Integer
	var s27 = 27 as Integer
	var s28 = 28 as Integer
	var s29 = 29 as Integer
	var s30 = 30 as Integer
	var s31 = 31 as Integer
	var s32 = 32 as Integer
	var i = 0 as Integer
	while i < 5 'loop'
		s1 = s1 + i
		s2 = s2 + i
		s3 = s3 + i
		s4 = s4 + i
		s5 = s5 + i
		s6 = s6 + i
		s7 = s7 + i
		s8 = s8 + i
		s9 = s9 + i
		s10 = s10 + i
		s11 = s11 + i
		s12 = s12 + i
		s13 = s13 + i
		s14 = s14 + i
		s15 = s15 + i
		s16 = s16 + i
		s17 = s17 + i
		s18 = s18 + i
		s19 = s19 + i
		s20 = s20 + i
		s21 = s21 + i
		s22 = s22 + i
		s23 = s23 + i
		s24 = s24 + i
		s25 = s25 + i
		s26 = s26 + i
		s27 = s27 + i
		s28 = s28 + i
		s29 = s29 + i
		s30 = s30 + i
		s31 = s31 + i
		s32 = s32 + i
		i = i + 1
	end 'loop'
	return s1 + s2 + s3 + s4 + s5 + s6 + s7 + s8 + s9 + s10 + s11 + s12 + s13 + s14 + s15 + s16 + s17 + s18 + s19 + s20 + s21 + s22 + s23 + s24 + s25 + s26 + s27 + s28 + s29 + s30 + s31 + s32
end 'hot'

function main() returns ExitCode
	return hot(0)
end 'main'
typealias Integer = int(i64.min to i64.max)
