export typealias ReportedPoolCount = int(i64.min to i64.max)

// parallel.maxtest — the shared half of the compiler's PARALLEL-POOL gate: how the compiler is
// spawned at a staged fixture program with the processor count pinned or left to the machine, and
// the two things asked of the corpus itself. The per-contract `test` declarations are the files
// beside this one, one contract line each.
//
// Each function's backend job — instruction selection through encoding — runs on a pool of worker
// services, one per processor (`BackendPool`), and its contract has six lines: it REPORTS the pool
// it built, the executable it emits is BYTE-IDENTICAL whatever the processor count — its `.rdata`
// section included, which every function's isel registers content into — a register-pressure
// refusal is RENDERED identically at every count, the per-function log lines of the Std pool come
// out in declaration order, the job's branch cleanup, frame and encoding are timed as POOL rows,
// and two identical compiles report IDENTICAL MEMORY. Lexing and parsing run on a pool of their own
// (`FrontEndPool`), which REPORTS the pool it built the same way.
//
// ⚠ EACH POOL LINE IS SHOWN ONLY BY ITS OWN CATEGORY'S FLAG: the allocator's by `--log=codegen:debug`
// (`[GEN]`), the front end's by `--log=compiler:debug` (`[CMP]`). `Logger.parseLogOption` raises ONE
// category for a `<category>:<level>` spec and every other category falls through to the global level,
// which is INFO. Each needle carries the sink's whole prefix so a line that moved to another category or
// level is red rather than merely quieter.
//
// ⛔ ONE SPAWNING `test` PER FILE, FOR TWO REASONS THAT ARE BOTH STRUCTURAL. A file is what ONE process
// runs under `TestExecutor.DefaultTestTimeoutMs`, and every contract needs compiles of its own.
// And `maxon test` runs its files CONCURRENTLY, so two files staging the same fixture into
// one directory race on it — the flake `testCommand/reserved-name-refused.maxtest` measured. Every
// case therefore stages into a directory named for ITSELF, never for the fixture it stages.
//
// ⛔ THE SPAWNED COMPILER'S WORKING DIRECTORY IS THE STAGED TREE; THIS FILE'S OWN PATHS ARE RELATIVE TO
// THE CHECKOUT ROOT, which is what a test binary inherits from `maxon test`. Everything handed to the
// child — the binary, the source, the output — is made absolute first, because a relative path resolves
// against the child's directory on POSIX and the parent's on Windows.

// Where the corpus lives and where a runnable copy is built, both relative to the checkout root. Staging
// goes to gitignored `temp/`: a live `.maxon` under `tests/` is one `maxon fmt` over the checkout rewrites.
export let FixturesDirName = "tests/parallelCompile/fixtures"
let ProjectDirName = "tests/parallelCompile"
export let StagingRootDirName = "temp/parallelCompile"

// Where `retainedAside` parks a build's image: a name no build writes, inside the case's own staging tree.
let RetainedImageFileName = "retained-image"

// The flags that raise each pool line's category to DEBUG — see the header for why they are two.
export let CodegenDebugLogFlag = "--log=codegen:debug"
export let CompilerDebugLogFlag = "--log=compiler:debug"

// Each pool line as the sink renders it, then the words both reports share. Each report ends with a count
// no needle pins: the allocator's functions and the front end's files both include what the stdlib adds.
let RegallocPoolLinePrefix = "[GEN] DEBUG: regalloc: "
let FrontEndPoolLinePrefix = "[CMP] DEBUG: front end: "
let PoolLineWorkersWord = "worker(s) over"
let PoolLineProcessorsWord = "processor(s), "

// Where the four counts sit among a front-end pool line's space-separated words:
// `<workers> worker(s) over <processors> processor(s), <files> file(s), <adopted> adopted`.
let PoolLineWordSeparator = " "
let PoolLineWorkersPosition = 0
let PoolLineProcessorsPosition = 3
let PoolLineFilesPosition = 5
let PoolLineAdoptedPosition = 7
let PoolLineAdoptedWordPosition = 8 as ElementIndex
let PoolLineAdoptedWord = "adopted"

// The scheduler's processor-count marker. Spelled here rather than read from `SchedRuntime.MaxProcsEnvName`
// because a test project cannot import the compiler. It cannot rot silently: a marker the scheduler stops
// reading leaves the pinned case reporting the machine's count, which is red.
export let SingleProcessor = 1

let PrivateRunCacheDirName = "run-cache"

// The phrase every register-pressure refusal carries. A phrase rather than the error number, because a
// code spelled outside the registry is a copy of the number space; this rots red, not silently.
export let RegisterPressureRefusalPhrase = "more register(s) than are available"

// A declaration line of a staged program. Counting them bounds from below the functions the allocator
// sees, which is what decides whether the default pool's worker count is knowable.
let FunctionDeclarationPrefix = "function "

// The folds a stderr goes through before two runs are compared: CR, the host separator, and the absolute
// staging path, in that order because the path is matched in its forward-slash form — then the wall time below.
let StagingTreeToken = "<TREE>"

// The wall time a build's `Wrote` line reports: everything from the opener to the end of the line is folded.
let CompileTimeOpener = "(compiled in "
let CompileTimeCloser = ")"
let CompileTimeToken = "<TIME>"

// A processor count as the scheduler resolves one. Its floor is carried in by a guard rather than by the
// runtime's clamp, which nothing here proves.
export typealias ProcessorCount = int(1 to u32.max)

export union ProcessorPin
	machine
	pinned(count ProcessorCount)
end 'ProcessorPin'

// How many declarations a staged program holds.
typealias FunctionTally = int(0 to u64.max)

let MetricsOptionPrefix = "--metrics="
let MetricsFileName = "metrics.tsv"
let MetricsFieldSeparator = "\t"
let MetricsCommentPrefix = "#"
export let MetricsKindColumn = "kind"
export let NameColumn = "name"
export let AllocsColumn = "allocs"
export let PhaseRowKind = "phase"
export let TotalRowKind = "total"
export let UnattributedRowKind = "unattributed"
export let WholeCompileRowName = "-"
export let UpkeepRowKind = "upkeep"
let MetricsHeaderOpener = "# kind"
let MetricsKindColumnPosition = 0

typealias MetricsRowArray = Array with MetricsRow

// ============================================================================================
// THE CORPUS ITSELF
// ============================================================================================

// A fixture program nobody stages reads exactly like one that passed, and no case can see its own
// absence, so the question is asked once of the corpus as a whole — by matching the `fixture: "…"`
// argument in the case files' own source, which keeps asking it however the cases are arranged.
test 'every fixture program is staged by name from a case file'
	let cases = caseFileSources()

	var unstaged = StringArray.create()

	for fixtureName in fixtureNames() 'eachFixture'
		if not cases.contains("fixture: \"{fixtureName}\"") 'neverStaged'
			unstaged.push(fixtureName)
		end 'neverStaged'
	end 'eachFixture'

	let listed = listedLines(unstaged)
	Expect.isEmpty(listed, message: "these program directories under {FixturesDirName} are never staged from a case file in {ProjectDirName}. Each one needs a `test` that calls `stagedFixtureTree(…, caseLabel: …, fixture: \"<name>\")`; a fixture nothing compiles proves nothing and reads exactly like one that passed.")
end 'every fixture program is staged by name from a case file'

// `maxon fmt` over the checkout walks `tests/`, so a real `main.maxon` under `fixtures/` would be
// formatted by a sibling command of the one under test. Stored as `<name>.fixture`, it is inert.
test 'no fixture is stored as a source maxon fmt would rewrite'
	let live = listedLines(sourcePathsEndingWith(fixtureDir(ProjectDirName), suffixes: [MaxonSourceSuffix]))
	Expect.isEmpty(live, message: "these files under {ProjectDirName} are LIVE Maxon sources, which `maxon fmt` over this checkout would rewrite. Store a fixture source as `<name>{StoredFixtureSuffix}`; do NOT add a `.maxonignore`, which would hide the corpus from the compiler's own walks.")
end 'no fixture is stored as a source maxon fmt would rewrite'

// ============================================================================================
// STAGING AND SPAWNING
// ============================================================================================

// `--output=` is what keeps the build out of the tree lock, so two case files can compile at once.
//
// ⚠ **THE OUTPUT BASENAME REACHES THE EMITTED IMAGE.** On Mach-O it is the ad-hoc code signature's
// CodeDirectory identifier (`MachOWriter.writeMachO`), and its LENGTH moves the __LINKEDIT sizes in the
// load commands, so two builds written to two names differ within the first kilobyte for a reason that
// is not the worker count. The output path is therefore a confound this corpus CONTROLS: a case that
// compares two builds gives both the same path and keeps the first with `retainedAside`.
export function spawnPinnedBuild(staged FilePath, label String, extraArguments StringArray, processors ProcessorPin, wholeDirectory bool = false, privateRunCache bool = false, runCacheDirName String = PrivateRunCacheDirName) returns CollectedOutput
	let source = staged if wholeDirectory else staged.join("{StagedProgramFileName}")
	let environment = pinnedEnvironment(staged, processors: processors, privateRunCache: privateRunCache, runCacheDirName: runCacheDirName)

	return spawnBuild(source, staged: staged, output: executableIn(staged, stem: OutputFileStem), label: label, extraArguments: extraArguments, environment: environment)
end 'spawnPinnedBuild'

function pinnedEnvironment(staged FilePath, processors ProcessorPin, privateRunCache bool, runCacheDirName String) returns Environment
	var overrides = EnvMap.create()

	match processors 'pin'
		machine then break
		pinned(count) then overrides.upsert(MaxProcsVariableName, value: "{count}")
	end 'pin'

	if privateRunCache 'isolated'
		overrides.upsert(CacheRootVariable, value: staged.join(runCacheDirName).toString())
	end 'isolated'

	return Environment.inheritUpdating(overrides) if overrides.count() > 0 else Environment.inherit
end 'pinnedEnvironment'

#if not os(Windows)
	let PauseShellCommandFlag = "-c"
	let PauseShellName = "sh"
	let PauseScript = "dir=$1; pause=$2; shift 2; \"$@\" & pid=$!; tries=0; until [ -n \"$(find \"$dir\" -name '*.lock' 2>/dev/null)\" ] || [ $tries -ge 400 ]; do sleep 0.05; tries=$((tries + 1)); done; if [ $tries -ge 400 ]; then echo \"no output lock appeared under $dir within 20 s\" >&2; kill $pid; exit 97; fi; (sleep $pause; kill -CONT $pid 2>/dev/null) & resumer=$!; if ! kill -STOP $pid 2>/dev/null; then echo \"the build ended before it could be stopped\" >&2; kill $resumer; exit 98; fi; wait $resumer; wait $pid"
	let PausedBuildTimeoutMs = 60000

	// Both builds of a comparison come through here, the unpaused one with a 0 s pause: a compile's
	// counted allocations follow its environment block, and `sh` changes it.
	export function pausedBuildMetricsTable(staged FilePath, label String, pauseSeconds String) returns MetricsTable throws TestFailure
		let shell = try FilePath.from(PosixShellPath) otherwise panic("parallel-compile.test: {PosixShellPath} is a spellable path")
		let build = buildArguments(staged.join(StagedProgramFileName), output: executableIn(staged, stem: OutputFileStem), extraArguments: metricsArguments(staged, extraArguments: StringArray.create()))

		var arguments = [PauseShellCommandFlag, PauseScript, PauseShellName, staged.join(PrivateRunCacheDirName).toString(), pauseSeconds, testedCompilerPath().toString()]

		for word in build 'eachWord'
			arguments.push(word)
		end 'eachWord'

		let run = spawnIn(Executable.path(shell), arguments: arguments, staged: staged, what: "the '{label}' build, paused", environment: pinnedEnvironment(staged, processors: ProcessorPin.machine, privateRunCache: true, runCacheDirName: PrivateRunCacheDirName), timeoutMs: PausedBuildTimeoutMs)
		try requireCompiled(run, label: label)

		return metricsTableOf(staged, label: label)
	end 'pausedBuildMetricsTable'
#endif

// ============================================================================================
// THE POOL LINE
// ============================================================================================

// The pool line at the default: one worker per processor, over every processor the machine has.
//
// W is min(P, F) and F is the allocator's function count, which exceeds the fixture's declared count by
// however many runtime functions it allocates — a number this file cannot know. So the needle stops at
// the count, and W = P is asserted only where the DECLARED count alone guarantees it; a host with more
// processors than the fixture declares functions is refused loudly rather than pinned to a guess.
export function defaultPoolNeedle(staged FilePath) returns String
	let reported = defaultProcessorCount()
	let declared = declaredFunctionCount(staged)

	if reported as FunctionTally > declared 'poolSmallerThanTheMachine'
		panic("parallel-compile.test: the gate could not run — this host has {reported} processors and the staged program declares only {declared} functions, so the default pool's worker count is min(P, F) with F unknowable from here. Add functions to the fixture until it declares more than the host has processors.")
	end 'poolSmallerThanTheMachine'

	return poolNeedle(RegallocPoolLinePrefix, workers: reported, processors: reported)
end 'defaultPoolNeedle'

// The pool line with the scheduler pinned to one processor: a pool of one worker.
export function singleProcessorPoolNeedle() returns String
	return poolNeedle(RegallocPoolLinePrefix, workers: SingleProcessor, processors: SingleProcessor)
end 'singleProcessorPoolNeedle'

// The front end's pool line with the scheduler pinned to one processor: one worker, whatever it parses.
export function frontEndPoolNeedleSingleProcessor() returns String
	return poolNeedle(FrontEndPoolLinePrefix, workers: SingleProcessor, processors: SingleProcessor)
end 'frontEndPoolNeedleSingleProcessor'

// ⭐ **THE DEFAULT POOL IS min(P, F) WORKERS, WHERE F IS THE MOST FILES ONE DRAIN DISPATCHED — AND THE LINE SAYS
// WHAT F WAS.** F includes the stdlib files this file cannot count, so it is read off the report rather than
// derived here; P is read off the report too and must be the machine's.
export function requireFrontEndPoolAtDefault(run CollectedOutput) throws TestFailure
	let line = frontEndPoolLine(run)
	let words = line.split(PoolLineWordSeparator)
	let workers = reportedCount(words, position: PoolLineWorkersPosition, line: line)
	let processors = reportedCount(words, position: PoolLineProcessorsPosition, line: line)
	let files = reportedCount(words, position: PoolLineFilesPosition, line: line)
	let machine = defaultProcessorCount() as ReportedPoolCount

	try Expect.equal(processors, expected: machine, message: "the front end reported a pool over {processors} processor(s) with nothing pinned, where the machine has {machine}. It wrote: {line}")
	try Expect.equal(workers, expected: files if files < machine else machine, message: "the front end reported {workers} worker(s) over {processors} processor(s) for {files} file(s) dispatched — the pool is min(P, F) workers, because a worker with no file is a mailbox bought for nothing and a file with no worker waits. It wrote: {line}")
end 'requireFrontEndPoolAtDefault'

// The front end's one pool line, from its first count to the end of the line.
function frontEndPoolLine(run CollectedOutput) returns String
	let afterPrefix = try run.stderr.split(FrontEndPoolLinePrefix).get(1) otherwise panic("parallel-compile.test: `{CompilerDebugLogFlag}` printed no line starting `{FrontEndPoolLinePrefix}`, so the pool it built cannot be read. It wrote to stderr: {run.stderr}")
	return (try afterPrefix.split(LineFeed).get(0) otherwise panic("parallel-compile.test: splitting a string always yields its first piece")).trim()
end 'frontEndPoolLine'

export function frontEndAdoptions(run CollectedOutput) returns ReportedPoolCount
	let line = frontEndPoolLine(run)
	let words = line.split(PoolLineWordSeparator)
	let word = try words.get(PoolLineAdoptedWordPosition) otherwise panic("parallel-compile.test: the front end's pool line ends before its `{PoolLineAdoptedWord}` count. It wrote: {line}")

	if word != PoolLineAdoptedWord 'notTheAdoptedCount'
		panic("parallel-compile.test: the front end's pool line holds '{word}' where `{PoolLineAdoptedWord}` belongs. It wrote: {line}")
	end 'notTheAdoptedCount'

	return reportedCount(words, position: PoolLineAdoptedPosition, line: line)
end 'frontEndAdoptions'

function reportedCount(words StringArray, position ElementIndex, line String) returns ReportedPoolCount
	let word = try words.get(position) otherwise panic("parallel-compile.test: the front end's pool line has no word at position {position}. It wrote: {line}")
	return try int.fromString(word) otherwise panic("parallel-compile.test: the front end's pool line holds '{word}' where a count belongs. It wrote: {line}")
end 'reportedCount'

// The front end reports its pool once per build, never once per file or per batch.
export function requireOneFrontEndPoolLine(run CollectedOutput) throws TestFailure
	let lines = run.stderr.split(FrontEndPoolLinePrefix).count() - 1
	try Expect.equal(lines, expected: 1, message: "`{CompilerDebugLogFlag}` printed {lines} lines starting `{FrontEndPoolLinePrefix}`. The front end builds ONE pool per build and reports it once. It wrote to stderr: {run.stderr}")
end 'requireOneFrontEndPoolLine'

// The processor count the scheduler resolves when nothing pins it: the machine's.
function defaultProcessorCount() returns ProcessorCount
	return Scheduler.machineCpuCount() as ProcessorCount
end 'defaultProcessorCount'

// The one grammar every pool needle is built from, up to and excluding the trailing count.
function poolNeedle(prefix String, workers ProcessorCount, processors ProcessorCount) returns String
	return "{prefix}{workers} {PoolLineWorkersWord} {processors} {PoolLineProcessorsWord}"
end 'poolNeedle'

// How many declarations the staged program holds: every line that opens a function, `main` included.
function declaredFunctionCount(staged FilePath) returns FunctionTally
	let source = fileText(staged.join("{StagedProgramFileName}"))

	var declared = 0 as FunctionTally

	for line in source.split(LineFeed) 'eachLine'
		if line.startsWith(FunctionDeclarationPrefix) 'declaresOne'
			declared = declared + 1
		end 'declaresOne'
	end 'eachLine'

	return declared
end 'declaredFunctionCount'

// ============================================================================================
// COMPARING TWO RUNS
// ============================================================================================

// A run's stderr as two runs are compared: CR folded, separators folded, the staging path replaced by
// `<TREE>` so a message that names the source stays readable in a failure report, and the wall time a
// build reports replaced by `<TIME>` — a pool of one and a pool of sixteen do not take the same time.
export function normalizedStderr(run CollectedOutput, staged FilePath) returns String
	let folded = withoutCarriageReturns(run.stderr).replace(FilePath.separator(), with: PortablePathSeparator)
	let tree = staged.toString().replace(FilePath.separator(), with: PortablePathSeparator)

	return withoutCompileTimes(folded.replace(tree, with: StagingTreeToken))
end 'normalizedStderr'

function withoutCompileTimes(text String) returns String
	var folded = ""
	var first = true

	for line in text.split(LineFeed) 'eachLine'
		if not first 'afterTheFirst'
			folded.append(LineFeed)
		end 'afterTheFirst'

		first = false
		folded.append(withoutCompileTime(line))
	end 'eachLine'

	return folded
end 'withoutCompileTimes'

function withoutCompileTime(line String) returns String
	let opener = try line.findFirst(CompileTimeOpener) otherwise return line
	return "{line.slice(line.startIndex(), endIndex: opener)}{CompileTimeOpener}{CompileTimeToken}{CompileTimeCloser}"
end 'withoutCompileTime'

// The staged program compiled pinned to one processor and at the default, and the two images
// compared byte for byte. Both builds are given the SAME output path — see `spawnPinnedBuild` for
// why the basename may not vary — and the pinned image is kept aside between them, so the processor
// count is the only difference between the two builds compared. `programName` names the program in
// failure reports.
export function requireIdenticalImagesAcrossProcessorCounts(staged FilePath, programName String, wholeDirectory bool = false) throws TestFailure
	let noArguments = StringArray.create()

	let pinnedRun = spawnPinnedBuild(staged, label: "single-processor", extraArguments: noArguments, processors: ProcessorPin.pinned(SingleProcessor), wholeDirectory: wholeDirectory)
	let pinnedExit = pinnedRun.exitCode()
	try Expect.equal(pinnedExit, expected: 0, message: "the {programName} did not compile pinned to one processor. It wrote to stderr: {pinnedRun.stderr}")

	let pinnedImage = retainedAside(executableIn(staged, stem: OutputFileStem), aside: staged.join(RetainedImageFileName))

	let defaultRun = spawnPinnedBuild(staged, label: "default-processors", extraArguments: noArguments, processors: ProcessorPin.machine, wholeDirectory: wholeDirectory)
	let defaultExit = defaultRun.exitCode()
	try Expect.equal(defaultExit, expected: 0, message: "the {programName} did not compile at the default processor count. It wrote to stderr: {defaultRun.stderr}")

	try requireIdenticalBytes(pinnedImage, second: executableIn(staged, stem: OutputFileStem))
end 'requireIdenticalImagesAcrossProcessorCounts'

// Two emitted executables, byte for byte. The count is asked first and asked to be non-zero: two empty
// files are identical, and a pair of builds that wrote nothing must not read as agreement.
//
// ⭐ **NO WRITER STAMPS A BUILD TIME INTO THE IMAGE** — the PE writer zeroes every `TimeDateStamp`, and
// neither the Mach-O nor the ELF writer reads a clock at all. That is what makes raw identity the right
// instrument here, rather than a comparison that has to mask known noise: masking hides whatever else
// drifted into the bytes it covers.
function requireIdenticalBytes(first FilePath, second FilePath) throws TestFailure
	let firstBytes = fileBytes(first)
	let secondBytes = fileBytes(second)
	try Expect.notEqual(firstBytes.count(), expected: 0, message: "{first.toString()} is empty. A build that wrote nothing has nothing to compare, and two of them would agree.")

	match compareBytes(firstBytes, second: secondBytes) 'compared'
		identical then break
		differentLengths then try Expect.fail("{second.toString()} and {first.toString()} differ in length, so the processor count changed what the compiler EMITTED, not merely how fast it emitted it.")
		differsAt(offset) then try Expect.fail("{second.toString()} first differs from {first.toString()} at byte offset {offset}. The emitted image must not depend on which worker parsed a file or allocated a function, or in what order a pool finished; a difference here is a nondeterminism, not a performance fact.")
	end 'compared'
end 'requireIdenticalBytes'

export function builtMetricsTable(staged FilePath, label String, runCacheDirName String = PrivateRunCacheDirName) returns MetricsTable throws TestFailure
	_ = try meteredBuild(staged, label: label, extraArguments: StringArray.create(), processors: ProcessorPin.machine, wholeDirectory: false, runCacheDirName: runCacheDirName)
	return metricsTableOf(staged, label: label)
end 'builtMetricsTable'

export function meteredBuild(staged FilePath, label String, extraArguments StringArray, processors ProcessorPin, wholeDirectory bool, runCacheDirName String = PrivateRunCacheDirName) returns CollectedOutput throws TestFailure
	let run = spawnPinnedBuild(staged, label: label, extraArguments: metricsArguments(staged, extraArguments: extraArguments), processors: processors, wholeDirectory: wholeDirectory, privateRunCache: true, runCacheDirName: runCacheDirName)
	try requireCompiled(run, label: label)

	return run
end 'meteredBuild'

function metricsArguments(staged FilePath, extraArguments StringArray) returns StringArray
	var arguments = StringArray.create()
	arguments.push("{MetricsOptionPrefix}{staged.join(MetricsFileName).toString()}")

	for extra in extraArguments 'eachExtra'
		arguments.push(extra)
	end 'eachExtra'

	return arguments
end 'metricsArguments'

function requireCompiled(run CollectedOutput, label String) throws TestFailure
	let observedExit = run.exitCode()
	try Expect.equal(observedExit, expected: 0, message: "the '{label}' build did not compile. It wrote to stderr: {run.stderr}")
end 'requireCompiled'

export function metricsTableOf(staged FilePath, label String) returns MetricsTable
	let metricsPath = staged.join(MetricsFileName)
	let text = fileText(metricsPath)
	try File.delete(metricsPath) otherwise panic("parallel-compile.test: the gate could not run — could not clear {metricsPath.toString()}, so the next build's table could not be told from this one's.")

	return metricsTableFrom(text, label: label)
end 'metricsTableOf'

function metricsTableFrom(text String, label String) returns MetricsTable
	var columns = StringArray.create()
	var rows = MetricsRowArray.create()

	for raw in text.split(LineFeed) 'eachLine'
		let line = raw.trimEnd()

		if line.isEmpty() 'blank'
			continue
		end 'blank'

		let fields = line.split(MetricsFieldSeparator)

		if line.startsWith(MetricsCommentPrefix) 'aComment'
			if line.startsWith("{MetricsHeaderOpener}{MetricsFieldSeparator}") 'theHeader'
				columns = metricsColumnsFrom(fields)
			end 'theHeader'

			continue
		end 'aComment'

		if columns.isEmpty() 'rowBeforeHeader'
			panic("parallel-compile.test: the gate could not run — the '{label}' build's metrics table carries a row before its `{MetricsHeaderOpener}` header, so its columns cannot be named: {line}")
		end 'rowBeforeHeader'

		if fields.count() != columns.count() 'malformed'
			panic("parallel-compile.test: the gate could not run — a row of the '{label}' build's metrics table carries {fields.count()} fields where its header names {columns.count()}: {line}")
		end 'malformed'

		rows.push(MetricsRow.create(line, fields: fields))
	end 'eachLine'

	if columns.isEmpty() 'noHeader'
		panic("parallel-compile.test: the gate could not run — the '{label}' build's metrics table has no `{MetricsHeaderOpener}` header line. It was: {text}")
	end 'noHeader'

	return MetricsTable.create(columns, rows: rows)
end 'metricsTableFrom'

function metricsColumnsFrom(headerFields StringArray) returns StringArray
	var columns = StringArray.create()
	columns.push(MetricsKindColumn)

	for (iter, heading) in headerFields.withIterator() 'eachHeading'
		if iter.index() != MetricsKindColumnPosition 'pastTheOpener'
			columns.push(heading)
		end 'pastTheOpener'
	end 'eachHeading'

	return columns
end 'metricsColumnsFrom'

export type MetricsRow
	var line as String
	var fields as StringArray

	static function create(line String, fields StringArray) returns Self
		return Self{line: line, fields: fields}
	end 'create'

	export function cell(column ElementIndex) returns String
		return try self.fields.get(column) otherwise panic("parallel-compile.test: a metrics row was read at column {column}, outside the {self.fields.count()} fields its table's header names: {self.line}")
	end 'cell'
end 'MetricsRow'

export type MetricsTable
	var columns as StringArray
	export var rows as MetricsRowArray

	static function create(columns StringArray, rows MetricsRowArray) returns Self
		return Self{columns: columns, rows: rows}
	end 'create'

	export function column(name String) returns ElementIndex
		for (iter, heading) in self.columns.withIterator() 'eachColumn'
			if heading == name 'found'
				return iter.index()
			end 'found'
		end 'eachColumn'

		panic("parallel-compile.test: the gate could not run — the metrics table has no `{name}` column. Its header names: {listedLines(self.columns)}")
	end 'column'

	export function cellOf(kind String, name String, column String) returns String
		let kindColumn = self.column(MetricsKindColumn)
		let nameColumn = self.column(NameColumn)
		let valueColumn = self.column(column)

		for row in self.rows 'eachRow'
			if row.cell(kindColumn) == kind and row.cell(nameColumn) == name 'found'
				return row.cell(valueColumn)
			end 'found'
		end 'eachRow'

		panic("parallel-compile.test: the gate could not run — the metrics table has no `{kind}` row named `{name}`.")
	end 'cellOf'
end 'MetricsTable'

// ============================================================================================
// WALKING THE CORPUS
// ============================================================================================

// The fixture programs, read from the filesystem rather than from a constant, so a fixture added without
// a case is one the guard above sees.
function fixtureNames() returns StringArray
	var names = StringArray.create()

	for entry in listing(fixtureDir(FixturesDirName)) 'eachEntry'
		if Directory.isDirectory(entry) 'aProgram'
			names.push(entry.filename())
		end 'aProgram'
	end 'eachEntry'

	return names
end 'fixtureNames'

// Every driver in this project, concatenated: the text the staging guard searches for each fixture's name.
function caseFileSources() returns String
	var sources = ""

	for entry in listing(fixtureDir(ProjectDirName)) 'eachEntry'
		if entry.filename().endsWith(TestSourceSuffix) 'aDriver'
			sources.append(fileText(entry))
		end 'aDriver'
	end 'eachEntry'

	return sources
end 'caseFileSources'
