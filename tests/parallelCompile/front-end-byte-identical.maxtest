// front-end-byte-identical.maxtest — the executable does not depend on how many workers lexed and
// parsed its sources. The fixture is a two-file project built as a directory whose parses both mint instances,
// and one file is folded again with the answer the other file's rows give — so a merge that followed the pool's
// finishing order, or a refold that depended on it, would move the image.
//
// Two compiles in one file is the budget `testCommand/reserved-name-refused.maxtest` prices against
// the per-file deadline; a third case here would need its own file.

test 'a multi-file project is byte-identical at one processor and at the default'
	let staged = stagedFixtureTree(FixturesDirName, caseLabel: "front-end-byte-identical", fixture: "front-end-program")
	requireIdenticalImagesAcrossProcessorCounts(staged, programName: "front-end program", wholeDirectory: true)

	discardStagedDir(staged)
end 'a multi-file project is byte-identical at one processor and at the default'
