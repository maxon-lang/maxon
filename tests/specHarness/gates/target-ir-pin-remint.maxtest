let PinRemintSpecName = "pin-remint"
let PinRemintSpecFileName = "pin-remint.md"
let PinRemintAbsentCase = "pin-remint.absent"
let PinRemintPlantedCase = "pin-remint.planted"
let PinRemintPattern = "pin-remint/"
let PinRemintAbsentMarker = "<!-- test: pin-remint.absent -->"
let PinRemintPlantedMarker = "<!-- test: pin-remint.planted -->"
let MainFunctionHeader = "func @main"
let RemintedPinCount = 2

test 'update-required replaces a wrong host-lane TargetIr pin and adds a missing one, and the next run passes'
	let staged = stagedGateFixture()
	let specPath = staged.join(PinRemintSpecFileName)
	plantBogusTargetIrPin(specPath)
	plantPlaceholderPinsBeneath(specPath, markers: [PinRemintAbsentMarker, PinRemintPlantedMarker])

	let arguments = StringArray.create(0)
	arguments.push(UpdateRequiredFlag)
	arguments.push(filterFlag(PinRemintPattern))

	let remint = runSpecTest(staged, includeNetwork: false, extraArguments: arguments)
	let written = fileText(specPath)
	let rerun = runSpecTest(staged, includeNetwork: false)
	discardStagedDir(staged)

	let said = "The file now reads:\n{written}\nThe re-mint run said:\n{everythingSaid(remint)}\nThe plain run said:\n{everythingSaid(rerun)}"
	let lines = written.split("\n")
	let pins = linesOpening(lines, prefix: hostTargetIrFence())
	let broken = StringArray.create(0)

	if pins.count() != RemintedPinCount 'wrongPinCount'
		broken.push("the re-mint left {pins.count()} {hostTargetIrFence()} block(s), not {RemintedPinCount}: one replacing the planted pin and one added to the case that had none. {said}\n")
	end 'wrongPinCount'

	if written.contains(PlantedTargetIrLine) 'plantSurvived'
		broken.push("the planted line '{PlantedTargetIrLine}' survived the re-mint. {said}\n")
	end 'plantSurvived'

	if occurrences(written, needle: MainFunctionHeader) != RemintedPinCount 'pinsHoldNoMain'
		broken.push("the re-minted pins do not each hold `{MainFunctionHeader}`, the Target IR of the case's own `main`. {said}\n")
	end 'pinsHoldNoMain'

	let absentAt = firstLineOpening(lines, prefix: PinRemintAbsentMarker, said: said)
	let plantedAt = firstLineOpening(lines, prefix: PinRemintPlantedMarker, said: said)
	let addedAt = try pins.get(0) otherwise plantedAt
	let replacedAt = try pins.get(1) otherwise absentAt

	if not (absentAt < addedAt and addedAt < plantedAt and plantedAt < replacedAt) 'pinsMisplaced'
		broken.push("the pins landed at lines {addedAt + 1} and {replacedAt + 1}, not one inside each case (markers at lines {absentAt + 1} and {plantedAt + 1}). {said}\n")
	end 'pinsMisplaced'

	collectNotPassed(everythingSaid(rerun), specName: PinRemintSpecName, testNames: [PinRemintAbsentCase, PinRemintPlantedCase], broken: broken)

	if rerun.exitCode() != SuccessExitCode 'rerunFailed'
		broken.push("the plain run after the re-mint exited {rerun.exitCode()}. {said}\n")
	end 'rerunFailed'

	requireNothingBroken(broken, headline: "`{UpdateRequiredFlag}` re-mints the host lane's `TargetIr` pins")
end 'update-required replaces a wrong host-lane TargetIr pin and adds a missing one, and the next run passes'
