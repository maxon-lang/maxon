let LeavesAProcessCaseLabel = "leaves-a-process/leaves-a-process.starts-one"

test 'a case that matches its stdout and exit code but leaves a process running fails, naming the process'
	let staged = stagedGateFixture()
	let run = runSpecTest(staged, includeNetwork: false)
	let said = everythingSaid(run)
	let leaker = recordedProcessId(staged.join(LeakerProcessIdFileName))
	let broken = StringArray.create(0)

	collectLeakNotReported(said, label: LeavesAProcessCaseLabel, leaker: leaker, broken: broken)

	if run.exitCode() == SuccessExitCode 'exitWrong'
		broken.push("the run exited {SuccessExitCode} with a case that left a process running in it. It said:\n{said}\n")
	end 'exitWrong'

	discardStagedDir(staged)
	requireNothingBroken(broken, headline: "a process left running by a case fails that case")
end 'a case that matches its stdout and exit code but leaves a process running fails, naming the process'
