let FedRunSleepingScenario = "sleeping"
let FedRunSleepingVerdict = "deadline error true, after the deadline true, before the child's sleep ends true"

test 'a fed run whose child sleeps without reading a large feed ends at the deadline'
	let broken = StringArray.create(0)

	collectUnlessSaid(FedRunSleepingScenario, verdict: FedRunSleepingVerdict, broken: broken)

	requireNothingBroken(broken, headline: "a fed run whose child sleeps without reading a large feed ends at the deadline")
end 'a fed run whose child sleeps without reading a large feed ends at the deadline'
