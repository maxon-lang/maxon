let ShadowRespellingSpecName = "shadow-respelling"
let ShadowRespellingCaseName = "shadow-respelling.library-file-spells-its-own-mint"

test 'a second spec-test run respells a library diagnostic exactly as the first run did'
	requireNothingBroken(coldThenWarmRunFailures(ShadowRespellingSpecName, caseName: ShadowRespellingCaseName), headline: "a warm library cache respells a library diagnostic as a cold one does")
end 'a second spec-test run respells a library diagnostic exactly as the first run did'
