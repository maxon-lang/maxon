let ProcsPlusReading = "procs=4"

test 'a procs marker with a leading plus is read as the count it spells'
	let label = testLabel("procs-plus", testName: "procs-plus.a-leading-plus")
	let said = saidByOneGateRun()

	Expect.isTrue(said.contains(failVerdictPrefix(label)), message: "the fixture did NOT run '{label}': a `+4` procs marker was refused or the case was dropped. It said:\n{said}")
	Expect.isTrue(said.contains(ProcsPlusReading), message: "'{label}' ran but did not print `{ProcsPlusReading}`, so the `+4` marker was not applied as 4. It said:\n{said}")
end 'a procs marker with a leading plus is read as the count it spells'
