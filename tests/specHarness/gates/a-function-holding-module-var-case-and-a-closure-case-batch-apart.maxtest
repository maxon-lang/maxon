let ClosureApartSpecName = "closure-apart"

test 'a case keeping a function in a module var and a case holding closures in a record batch into separate programs'
	let run = runGateFixtureOnce(StringArray.create())
	let said = everythingSaid(run)
	var broken = StringArray.create()

	collectNotPassed(said, specName: ClosureApartSpecName, testNames: ["closure-apart.keeps-a-handler", "closure-apart.holds-two-closures", "closure-apart.keeps-a-second-handler", "closure-apart.holds-two-more-closures"], broken: broken)
	collectMissingSummary(said, expected: batchSummaryLine(4, programs: 2, alone: 0), broken: broken)

	if run.exitCode() != SuccessExitCode 'runFailed'
		broken.push("the run exited {run.exitCode()}. It said:\n{said}\n")
	end 'runFailed'

	requireNothingBroken(broken, headline: "a function-holding module-var case and a closure case batch apart")
end 'a case keeping a function in a module var and a case holding closures in a record batch into separate programs'
