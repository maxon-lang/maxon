let ForeignLaneSpecName = "foreign-lane"
let ForeignLanePlainCase = "foreign-lane.plain"
let ForeignLaneParkingCase = "foreign-lane.parks-on-a-child"
let ForeignLaneTargetFlag = "--target=x64-linux"
let DiedMarker = "DIED"
let PassToken = "PASS"
let NotRunToken = "NOTRUN"
let NoVerdict = "no verdict"
let NothingProvedMessage = "proved nothing"
let NothingProvedExitCode = 1
let NoRunnerOnALinuxHostReason = "cannot be run from a Linux host"
let RunnerMissingMarkers = ["needs OrbStack", "needs WSL2", "needs a working WSL2"]
let WindowsLane = "x64-windows"

function verdictOfCase(said String, testName String) returns String
	let label = testLabel(ForeignLaneSpecName, testName: testName)

	if said.contains(passVerdictLine(label)) 'passed'
		return PassToken
	end 'passed'

	if said.contains("{NotRunToken} {label}") 'notRun'
		return NotRunToken
	end 'notRun'

	return NoVerdict
end 'verdictOfCase'

function runnerIsMissing(said String) returns bool
	for marker in RunnerMissingMarkers 'eachMarker'
		if said.contains(marker) 'named'
			return true
		end 'named'
	end 'eachMarker'

	return false
end 'runnerIsMissing'

function foreignLaneArguments() returns StringArray
	var arguments = StringArray.create()
	arguments.push(ForeignLaneTargetFlag)
	return arguments
end 'foreignLaneArguments'

test 'a foreign linux lane runs every case, a child-parking one included, and kills no worker'
	try requireForeignLaneAnswers(runGateFixtureOnce(foreignLaneArguments()))
end 'a foreign linux lane runs every case, a child-parking one included, and kills no worker'

test 'a foreign linux lane given its spec directory through a symlink answers every case the same'
	if hostLaneName() == WindowsLane 'noSymlinkTool'
		return
	end 'noSymlinkTool'

	try requireForeignLaneAnswers(runGateFixtureThroughASymlink(foreignLaneArguments()))
end 'a foreign linux lane given its spec directory through a symlink answers every case the same'

function requireForeignLaneAnswers(run CollectedOutput) throws TestFailure
	let said = everythingSaid(run)

	if runnerIsMissing(said) 'noRunnerOnThisHost'
		return
	end 'noRunnerOnThisHost'

	var broken = StringArray.create()

	if said.contains(DiedMarker) 'aWorkerDied'
		broken.push("a worker DIED while the {ForeignLaneTargetFlag} run was under way. It said:\n{said}\n")
	end 'aWorkerDied'

	// The verdict is read from the harness's output, not predicted from the host: the harness's
	// routing is the one source of which host has a runner, and a table here would drift from it.
	let laneVerdict = verdictOfCase(said, testName: ForeignLanePlainCase)

	for testName in [ForeignLanePlainCase, ForeignLaneParkingCase] 'eachCase'
		let verdict = verdictOfCase(said, testName: testName)

		if verdict != laneVerdict 'wrongVerdict'
			broken.push("'{testLabel(ForeignLaneSpecName, testName: testName)}' came back as {verdict}, where the lane's own verdict for '{testLabel(ForeignLaneSpecName, testName: ForeignLanePlainCase)}' is {laneVerdict}; every case of a lane is a {PassToken} or every case is a {NotRunToken}. It said:\n{said}\n")
		end 'wrongVerdict'
	end 'eachCase'

	if laneVerdict == PassToken 'laneRan'
		if run.exitCode() != SuccessExitCode 'runFailed'
			broken.push("the {ForeignLaneTargetFlag} run exited {run.exitCode()}, where every case is a {PassToken}. It said:\n{said}\n")
		end 'runFailed'
	end 'laneRan' else if laneVerdict == NotRunToken 'laneHasNoRunner'
		if run.exitCode() != NothingProvedExitCode 'notFailed'
			broken.push("the {ForeignLaneTargetFlag} run exited {run.exitCode()}, where a lane whose every case is a {NotRunToken} exits {NothingProvedExitCode}: a run that executed nothing is not a run that passed. It said:\n{said}\n")
		end 'notFailed'

		if not said.contains(NothingProvedMessage) 'silentAboutIt'
			broken.push("the {ForeignLaneTargetFlag} run did not say it {NothingProvedMessage}, though every case is a {NotRunToken}. It said:\n{said}\n")
		end 'silentAboutIt'

		if not said.contains(NoRunnerOnALinuxHostReason) 'noReason'
			broken.push("the {ForeignLaneTargetFlag} run did not give the reason a Linux host has no runner for a foreign CPU ('{NoRunnerOnALinuxHostReason}'), so a host that has a runner may have been routed to none. It said:\n{said}\n")
		end 'noReason'
	end 'laneHasNoRunner' else 'laneUndecided'
		broken.push("the {ForeignLaneTargetFlag} run gave '{testLabel(ForeignLaneSpecName, testName: ForeignLanePlainCase)}' no {PassToken} and no {NotRunToken}. It said:\n{said}\n")
	end 'laneUndecided'

	try requireNothingBroken(broken, headline: "a foreign Linux lane answers every case")
end 'requireForeignLaneAnswers'
