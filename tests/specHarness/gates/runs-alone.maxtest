let RunsAloneGateRanAfter = "ran-after-every-other-job"
let RunsAloneGateRanBeside = "ran-beside-another-job"

test 'a runs-alone case runs only once every other job has finished'
	let said = saidByOneGateRun()

	Expect.isTrue(said.contains(RunsAloneGateRanAfter) and not said.contains(RunsAloneGateRanBeside), message: "the alone case did not report `{RunsAloneGateRanAfter}` alone, so an `alone` case can run beside another job. The run said:\n{said}")
end 'a runs-alone case runs only once every other job has finished'
