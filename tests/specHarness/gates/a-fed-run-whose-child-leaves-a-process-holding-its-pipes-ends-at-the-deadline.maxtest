let FedRunProbeFixtureDir = "tests/specHarness/gates/a-fed-run-whose-child-leaves-a-process-holding-its-pipes-ends-at-the-deadline"
let FedRunProbeDirName = "fed-run-probe"
let FedRunProbeSourcePath = "maxon-bin/Testing/SpecFedRun.maxon"
let FedRunProbeStreamsPath = "maxon-bin/Debug/ChildStreams.maxon"
let FedRunProbeExecuteWord = "execute"
let FedRunProbeCacheDirName = "cache"
let FedRunProbeSourcesDirName = "sources"
let FedRunHolderScenario = "holder"
let FedRunChattyScenario = "chatty"
let FedRunCleanScenario = "clean"
let FedRunHolderVerdict = "deadline error after the deadline true, before the survivor's life ends true, survivor ended true"
let FedRunCleanVerdict = "exit 0, stdout anchor|done|tail|, prompt true"

function fedRunProbe(scenario String) returns CollectedOutput
	let probeRoot = projectScratchDir().join("{FedRunProbeDirName}-{scenario}")
	let caseDir = stagingDir(probeRoot.toString())
	let sources = freshStagingDir(probeRoot.join(FedRunProbeSourcesDirName).toString())
	let cache = stagingDir(probeRoot.join(FedRunProbeCacheDirName).toString())

	stageStoredTree(fixtureDir(FedRunProbeFixtureDir), into: sources)

	for sourcePath in [FedRunProbeSourcePath, FedRunProbeStreamsPath] 'eachSource'
		let source = Directory.currentPath().join(sourcePath)
		writeStagedFile(sources.join(source.filename()), content: fileText(source))
	end 'eachSource'

	let argv = StringArray.create(0)
	argv.push(FedRunProbeExecuteWord)
	argv.push(sources.toString())
	argv.push(scenario)

	let run = spawnCompiler(argv, staged: caseDir, what: "the fed-run probe", environment: Environment.inheritUpdating([CacheRootVariable: cache.toString()]))
	discardStagedDir(probeRoot)

	return run
end 'fedRunProbe'

function collectUnlessSaid(scenario String, verdict String, broken StringArray)
	let run = fedRunProbe(scenario)

	if not run.stdout.contains(verdict) 'unsaid'
		broken.push("the `{scenario}` probe did not say '{verdict}'. It said:\n{everythingSaid(run)}\n")
	end 'unsaid'
end 'collectUnlessSaid'

test 'a fed run whose child leaves a process holding its pipes stops at its deadline and ends that process'
	let broken = StringArray.create(0)

	collectUnlessSaid(FedRunCleanScenario, verdict: FedRunCleanVerdict, broken: broken)
	collectUnlessSaid(FedRunHolderScenario, verdict: FedRunHolderVerdict, broken: broken)
	collectUnlessSaid(FedRunChattyScenario, verdict: FedRunHolderVerdict, broken: broken)

	requireNothingBroken(broken, headline: "a fed run whose child leaves a process holding its pipes stops at its deadline and ends that process")
end 'a fed run whose child leaves a process holding its pipes stops at its deadline and ends that process'
