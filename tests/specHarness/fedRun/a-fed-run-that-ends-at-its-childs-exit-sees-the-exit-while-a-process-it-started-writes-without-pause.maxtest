let FedRunChattyExitScenario = "chattyexit"
let FedRunChattyExitVerdict = "ending exited 0, survivors ended true, survivor gone true"

test 'a fed run that ends at its childs exit sees the exit while a process it started writes without pause'
	let broken = StringArray.create(0)

	collectUnlessSaid(FedRunChattyExitScenario, verdict: FedRunChattyExitVerdict, broken: broken)

	requireNothingBroken(broken, headline: "a fed run that ends at its childs exit sees the exit while a process it started writes without pause")
end 'a fed run that ends at its childs exit sees the exit while a process it started writes without pause'
