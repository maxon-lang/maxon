let FedRunUnreadScenario = "unread"
let FedRunUnreadVerdict = "exit 0, stdout anchor|done|, prompt true"

test 'a fed run whose child never reads its feed is judged by its own outcome'
	let broken = StringArray.create(0)

	collectUnlessSaid(FedRunUnreadScenario, verdict: FedRunUnreadVerdict, broken: broken)

	requireNothingBroken(broken, headline: "a fed run whose child never reads its feed is judged by its own outcome")
end 'a fed run whose child never reads its feed is judged by its own outcome'
