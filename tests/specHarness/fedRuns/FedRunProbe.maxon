let FedRunProbeFixtureDir = "tests/specHarness/fedRuns/probe"
let FedRunProbeDirName = "fed-run-probe"
let FedRunProbeSourcePath = "maxon-bin/Testing/SpecFedRun.maxon"
let FedRunProbeExecuteWord = "execute"
let FedRunProbeCacheDirName = "cache"
let FedRunProbeSourcesDirName = "sources"

function fedRunProbe(scenario String) returns CollectedOutput
	let probeRoot = projectScratchDir().join("{FedRunProbeDirName}-{scenario}")
	let caseDir = stagingDir(probeRoot.toString())
	let sources = freshStagingDir(probeRoot.join(FedRunProbeSourcesDirName).toString())
	let cache = stagingDir(probeRoot.join(FedRunProbeCacheDirName).toString())

	stageStoredTree(fixtureDir(FedRunProbeFixtureDir), into: sources)

	let source = Directory.currentPath().join(FedRunProbeSourcePath)
	writeStagedFile(sources.join(source.filename()), content: fileText(source))

	let argv = StringArray.create(0)
	argv.push(FedRunProbeExecuteWord)
	argv.push(sources.toString())
	argv.push(scenario)

	let run = spawnCompiler(argv, staged: caseDir, what: "the fed-run probe", environment: Environment.inheritUpdating([CacheRootVariable: cache.toString()]))
	discardStagedDir(probeRoot)

	return run
end 'fedRunProbe'

function collectUnlessSaid(scenario String, verdict String, broken StringArray)
	let run = fedRunProbe(scenario)

	if not run.stdout.contains(verdict) 'unsaid'
		broken.push("the `{scenario}` probe did not say '{verdict}'. It said:\n{everythingSaid(run)}\n")
	end 'unsaid'
end 'collectUnlessSaid'
