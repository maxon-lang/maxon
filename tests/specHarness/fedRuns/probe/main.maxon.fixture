// Drives `runProcessFedAfter` from `maxon-bin/Testing/SpecFedRun.maxon`, staged beside this file as it stands
// in the checkout, and the standard library's `runChildFedAfterLine`.
//
// `holder` runs a child that exits after it is fed while a process it started still holds its standard output.
// `chatty` is `holder` with a survivor that writes without pause.
// `clean` runs a child that exits after it is fed with every one of its pipes closed.
// `unread` feeds a 1 MiB line to a child that exits without reading it.
// `sleeping` feeds the same line to a child that sleeps past the deadline without reading it.
// `chattyexit` runs `chatty`'s child through `runChildFedAfterLine`, ending at the child's exit.
// A scenario prints one line, and the line is what the gate pins.

export typealias ExitCodeValue = int(0 to u32.max)

export type ProcessCapture
	export let exitCode as ExitCodeValue
	export let stdout as String
	export let stderr as String

	export static function create(exitCode ExitCodeValue, stdout String, stderr String) returns ProcessCapture
		return Self{exitCode: exitCode, stdout: stdout, stderr: stderr}
	end 'create'
end 'ProcessCapture'

let ModeArgument = 1
let HolderScenario = "holder"
let ChattyScenario = "chatty"
let CleanScenario = "clean"
let UnreadScenario = "unread"
let SleepingScenario = "sleeping"
let ChattyExitScenario = "chattyexit"
let ChildMode = "child"
let SleepingChildMode = "sleeping-child"
let DeafChildMode = "deaf-child"
let ChattyChildMode = "chatty-child"
let SurvivorMode = "survivor"
let ChattySurvivorMode = "chatty-survivor"
let NoiseLine = "noise"
let QuietChildMode = "quiet-child"
let AnchorLine = "anchor"
let FeedWord = "hello"
let UnreadFeedChunk = "0123456789abcdef"
let UnreadFeedChunks = 65536
let SurvivorLine = "survivor "
let SurvivorLifeMs = 90000
let HolderDeadlineMs = 4000
let CleanDeadlineMs = 60000
let PromptBoundMs = 30000
let EndedGraceMs = 3000
let PollMs = 20
let FinalLineWithoutTerminator = "tail"

function survivorIdIn(stdout String) returns Pid throws ParseError
	for line in stdout.split("\n") 'eachLine'
		if line.startsWith(SurvivorLine) 'found'
			return try int.fromString(line.replaceFirst(SurvivorLine, with: "").trim())
		end 'found'
	end 'eachLine'

	throw ParseError.invalidFormat
end 'survivorIdIn'

function endsWithinGrace(pid Pid) returns bool
	var waited = 0 as DurationMs

	while waited < EndedGraceMs 'poll'
		if not Process.isAlive(pid) 'gone'
			return true
		end 'gone'

		sleep(PollMs)
		waited = waited + PollMs
	end 'poll'

	return not Process.isAlive(pid)
end 'endsWithinGrace'

function writeNoiseFor(lifeMs DurationMs)
	let begun = Clock.nowMs()

	while Clock.elapsedMs(begun) < lifeMs 'noise'
		print("{NoiseLine}\n")
	end 'noise'
end 'writeNoiseFor'

function survivorModeFor(chatty bool) returns String
	return ChattySurvivorMode if chatty else SurvivorMode
end 'survivorModeFor'

function startSurvivor(me FilePath, chatty bool)
	#if os(Windows)
		let config = Configuration.create(Executable.name("cmd"))
		config.arguments.push("/c")
		config.arguments.push("start")
		config.arguments.push("fed run survivor")
		config.arguments.push("/b")
		config.arguments.push(me.toString())
		config.arguments.push(survivorModeFor(chatty))
	#else
		let config = Configuration.create(Executable.name("sh"))
		config.arguments.push("-c")
		config.arguments.push("\"$0\" {survivorModeFor(chatty)} &")
		config.arguments.push(me.toString())
	#endif

	config.standardOutput = OutputDestination.inherit
	config.standardError = OutputDestination.inherit
	_ = try config.run() otherwise panic("the survivor could not be started")
end 'startSurvivor'

function runChild(mode String) returns ExitCode
	if mode == ChildMode or mode == ChattyChildMode 'withSurvivor'
		startSurvivor(try Process.executablePath() otherwise return 2, chatty: mode == ChattyChildMode)
	end 'withSurvivor'

	print("{AnchorLine}\n")

	if mode == SleepingChildMode 'sleeps'
		sleep(SurvivorLifeMs)

		return 0
	end 'sleeps'

	if mode != DeafChildMode 'reads'
		_ = try Console.stdin().readLine() otherwise LineOrEnd.ended
	end 'reads'

	print("done\n")

	if mode == QuietChildMode 'unterminated'
		print(FinalLineWithoutTerminator)
	end 'unterminated'

	return 0
end 'runChild'

function holderChild(chatty bool) returns StringArray
	let argv = StringArray.create(0)

	#if os(Windows)
		argv.push(ChattyChildMode if chatty else ChildMode)
	#else
		argv.push("-c")
		argv.push("\"$0\" {survivorModeFor(chatty)} & echo {AnchorLine}; read line; echo done")
		argv.push((try Process.executablePath() otherwise panic("the probe has no path")).toString())
	#endif

	return argv
end 'holderChild'

function holderExecutable() returns Executable
	#if os(Windows)
		return Executable.path(try Process.executablePath() otherwise panic("the probe has no path"))
	#else
		return Executable.name("sh")
	#endif
end 'holderExecutable'

function holderVerdict(chatty bool) returns String
	var timedOut = false
	var partial = ""

	let begun = Clock.nowMs()

	try runProcessFedAfter(holderExecutable(), argv: holderChild(chatty), workingDirectory: WorkingDirectory.at(Directory.currentPath()), timeoutMs: HolderDeadlineMs, environment: Environment.inherit, anchor: AnchorLine, feed: FeedWord) otherwise (e) 'expired'
		timedOut = e.timedOut()
		partial = match e 'kind'
			timeout(_, out, _) gives out
			treeNotEnded(_, out, _, _) gives out
			statusLost(out, _) gives out
			executableNotFound or
			spawnFailed or
			ioFailed or
			inputTooLarge or
			detachRefused gives ""
		end 'kind'
	end 'expired'

	let elapsed = Clock.elapsedMs(begun)

	if not timedOut 'returned'
		return "the run returned after {elapsed} ms without a deadline error"
	end 'returned'

	let survivor = try survivorIdIn(partial) otherwise panic("the survivor prints its id before the deadline: {partial}")

	return "deadline error after the deadline {elapsed >= HolderDeadlineMs}, before the survivor's life ends {elapsed < PromptBoundMs}, survivor ended {endsWithinGrace(survivor)}"
end 'holderVerdict'

function unreadFeed() returns String
	var feed = ""

	for _ in 0 upto UnreadFeedChunks 'chunks'
		feed.append(UnreadFeedChunk)
	end 'chunks'

	return feed
end 'unreadFeed'

function fedVerdict(me FilePath, childMode String, feed String) returns String
	let begun = Clock.nowMs()

	let capture = try runProcessFedAfter(Executable.path(me), argv: StringArray from [childMode], workingDirectory: WorkingDirectory.at(Directory.currentPath()), timeoutMs: CleanDeadlineMs, environment: Environment.inherit, anchor: AnchorLine, feed: feed) otherwise (e) 'failed'
		return "the run threw: {e.displayReason()}"
	end 'failed'

	let elapsed = Clock.elapsedMs(begun)

	return "exit {capture.exitCode}, stdout {capture.stdout.replace("\n", with: "|")}, prompt {elapsed < PromptBoundMs}"
end 'fedVerdict'

function sleepingVerdict(me FilePath) returns String
	let begun = Clock.nowMs()
	var timedOut = false

	try runProcessFedAfter(Executable.path(me), argv: StringArray from [SleepingChildMode], workingDirectory: WorkingDirectory.at(Directory.currentPath()), timeoutMs: HolderDeadlineMs, environment: Environment.inherit, anchor: AnchorLine, feed: unreadFeed()) otherwise (e) 'expired'
		timedOut = e.timedOut()
	end 'expired'

	let elapsed = Clock.elapsedMs(begun)

	return "deadline error {timedOut}, after the deadline {elapsed >= HolderDeadlineMs}, before the child's sleep ends {elapsed < PromptBoundMs}"
end 'sleepingVerdict'

function treeEnded(tree TreeEnd) returns bool
	return match tree 'tree'
		ended gives true
		survived or
		unconfirmed gives false
	end 'tree'
end 'treeEnded'

function exitVerdictOf(report ChildRunReport) returns String
	let ending = match report.ending 'ending'
		exited(code) gives "exited {code}"
		reapedElsewhere gives "reaped elsewhere"
		deadline gives "deadline"
		waitFailed(e) gives "wait failed ({e.displayReason()})"
	end 'ending'

	let survivorsEnded = match report.survivors 'survivors'
		noneHeld gives false
		ended(tree) gives treeEnded(tree)
	end 'survivors'

	let survivor = try survivorIdIn(report.stdout) otherwise panic("the survivor prints its id before the child exits: {report.stdout}")

	return "ending {ending}, survivors ended {survivorsEnded}, survivor gone {endsWithinGrace(survivor)}"
end 'exitVerdictOf'

function chattyExitVerdict(me FilePath) returns String
	let outcome = try runChildFedAfterLine(Executable.path(me), argv: StringArray from [ChattyChildMode], workingDirectory: WorkingDirectory.at(Directory.currentPath()), environment: Environment.inherit, deadlineMs: HolderDeadlineMs, endsWhen: RunEndsWhen.childExits, tailSilenceMs: EndedGraceMs, tailCapMs: EndedGraceMs, anchor: AnchorLine, feed: FeedWord) otherwise (e) 'failed'
		return "the run threw: {e.displayReason()}"
	end 'failed'

	return match outcome 'outcome'
		ran(report) gives exitVerdictOf(report)
		outputBroken(stream, reason, _) gives "reading the {stream.name} failed ({reason})"
	end 'outcome'
end 'chattyExitVerdict'

function main() returns ExitCode
	let args = CommandLine.args()
	let mode = try args.get(ModeArgument) otherwise ""

	if mode == SurvivorMode 'survivor'
		print("{SurvivorLine}{Process.id()}\n")
		sleep(SurvivorLifeMs)

		return 0
	end 'survivor'

	if mode == ChattySurvivorMode 'chattySurvivor'
		print("{SurvivorLine}{Process.id()}\n")
		writeNoiseFor(SurvivorLifeMs)

		return 0
	end 'chattySurvivor'

	if mode == ChildMode or mode == ChattyChildMode or mode == QuietChildMode or mode == DeafChildMode or mode == SleepingChildMode 'child'
		return runChild(mode)
	end 'child'

	let me = try Process.executablePath() otherwise return 2

	if mode == HolderScenario 'holder'
		print("{holderVerdict(false)}\n")
	end 'holder' else if mode == ChattyScenario 'chatty'
		print("{holderVerdict(true)}\n")
	end 'chatty' else if mode == CleanScenario 'clean'
		print("{fedVerdict(me, childMode: QuietChildMode, feed: FeedWord)}\n")
	end 'clean' else if mode == UnreadScenario 'unread'
		print("{fedVerdict(me, childMode: DeafChildMode, feed: unreadFeed())}\n")
	end 'unread' else if mode == SleepingScenario 'sleeping'
		print("{sleepingVerdict(me)}\n")
	end 'sleeping' else if mode == ChattyExitScenario 'chattyExit'
		print("{chattyExitVerdict(me)}\n")
	end 'chattyExit' else 'unknown'
		print("unknown scenario {mode}\n")

		return 3
	end 'unknown'

	return 0
end 'main'
