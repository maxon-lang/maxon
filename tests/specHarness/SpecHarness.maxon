let CorpusDirName = "tests/specHarness"
let RefusalsDirName = "refusals"
let GatesDirName = "gates"
let ExpectedRefusalFileName = "expected-refusal.txt"
let FixtureSpecExtension = ".md"

let SpecTestCommandWord = "spec-test"
let NetworkFlag = "--network"
let SuccessExitCode = 0
let FilterFlagPrefix = "--filter="
let UnmatchedPattern = "nosuch"
let BatchingChecksMissedThisCase = "the batching checks missed this case"
let BrokeTheBatchProgram = "broke the batch program its siblings share"
let HarnessErrorMarker = "harness error:"
let TrialBudgetSpentText = "trial builds without isolating"

let IgnoredWrapperDirName = "ignored"
let LinkedSpecDirSuffix = "-linked"
let RunCacheRootDirName = "run-cache"
let IgnoredWrapperInnerDirName = "spec"
let IgnoreMarkerFileName = ".maxonignore"
let StagedTierDirName = "tier"

let BrokenCheckIndent = "\n  "

let ResultNoteIndent = "  "
let FragmentsDirName = "fragments"
let WasiTargetFlag = "--target=wasm32-wasi"

let TargetIrFenceStem = "```TargetIr:"
let PlantedTargetIrLine = "planted.byTheTargetIrPinGates r0"
let PlaceholderTargetIrLine = "placeholder.forALaneTheRunIsNotOn r0"
let UpdateRequiredFlag = "--update-required"

typealias CaseTally = int(0 to u64.max)
typealias SpecLine = int(0 to u64.max)
typealias SpecLineArray = Array with SpecLine

type HarnessFixture
	export let kind as String
	export let caseName as String
	export let dir as FilePath

	static function create(kind String, caseName String, dir FilePath) returns HarnessFixture
		return Self{kind: kind, caseName: caseName, dir: dir}
	end 'create'
end 'HarnessFixture'

function requireRefusalFires(caller String = __file__) throws TestFailure
	let fixture = fixtureOf(caller, kind: RefusalsDirName)
	let expected = expectedRefusalIn(fixture)
	let run = runOnceThenDiscard(stagedCopyOf(fixture))
	let said = everythingSaid(run)

	try Expect.notEqual(run.exitCode(), expected: SuccessExitCode, message: "'{fixture.caseName}' was ACCEPTED (exit {SuccessExitCode}). It is a deliberately-malformed spec, and the refusal that should have caught it, the one that says '{expected}', did not fire. It said:\n{said}")
	try Expect.isTrue(said.contains(expected), message: "'{fixture.caseName}' failed (exit {run.exitCode()}) but for the WRONG REASON. Expected the output to contain '{expected}', and it said:\n{said}")
end 'requireRefusalFires'

function stagedGateFixture(caller String = __file__) returns FilePath
	return stagedCopyOf(fixtureOf(caller, kind: GatesDirName))
end 'stagedGateFixture'

function saidByOneGateRun(caller String = __file__) returns String
	return everythingSaid(runGateFixtureOnce(StringArray.create(0), caller: caller))
end 'saidByOneGateRun'

function runGateFixtureOnce(extraArguments StringArray, environment Environment = Environment.inherit, caller String = __file__) returns CollectedOutput
	return runOnceThenDiscard(stagedGateFixture(caller), extraArguments: extraArguments, environment: environment)
end 'runGateFixtureOnce'

function runGateFixtureThroughASymlink(extraArguments StringArray, caller String = __file__) returns CollectedOutput
	let staged = stagedGateFixture(caller)
	let link = try FilePath.from("{staged.toString()}{LinkedSpecDirSuffix}") otherwise panic("spec-harness tests: the gate could not run - '{staged.toString()}{LinkedSpecDirSuffix}' is not a spellable path")

	plantedDirectoryLink(link, target: staged.toString())

	let run = runSpecTest(link, includeNetwork: false, extraArguments: extraArguments)

	if not Directory.removeTree(link).isEmpty() 'linkStays'
		panic("spec-harness tests: the gate could not remove the link {link.toString()}")
	end 'linkStays'

	discardStagedDir(staged)

	return run
end 'runGateFixtureThroughASymlink'

function runGateFixtureOnceFromTheCheckout(extraArguments StringArray, caller String = __file__) returns CollectedOutput
	let staged = stagedGateFixture(caller)
	let run = runSpecTest(staged, includeNetwork: false, extraArguments: extraArguments, fromTheCheckout: true)
	discardStagedDir(staged)
	return run
end 'runGateFixtureOnceFromTheCheckout'

function requireMarkerShapeRan(label String, caller String = __file__) throws TestFailure
	let said = saidByOneGateRun(caller)
	let ranVerdict = failVerdictPrefix(label)

	try Expect.isTrue(said.contains(ranVerdict), message: "the fixture did NOT run '{label}': the compiler no longer reads this marker shape the way the reference does, and the case is simply GONE. Expected '{ranVerdict}', and it said:\n{said}")
end 'requireMarkerShapeRan'

function runSpecTest(staged FilePath, includeNetwork bool, extraArguments StringArray = StringArray.create(0), environment Environment = Environment.inherit, binary FilePath = testedCompilerPath(), fromTheCheckout bool = false) returns CollectedOutput
	let arguments = StringArray.create(0)
	arguments.push(SpecTestCommandWord)
	arguments.push(staged.toString())

	if includeNetwork 'wantsLiveNetwork'
		arguments.push(NetworkFlag)
	end 'wantsLiveNetwork'

	for extra in extraArguments 'eachExtra'
		arguments.push(extra)
	end 'eachExtra'

	let workingDirectory = Directory.currentPath() if fromTheCheckout else staged
	let run = spawnCompiler(arguments, staged: workingDirectory, what: "`{SpecTestCommandWord}` at {staged.toString()}", binary: binary, environment: environment)

	return CollectedOutput.create(run.status, stdout: withoutCarriageReturns(run.stdout), stderr: withoutCarriageReturns(run.stderr), pid: run.pid, durationMs: run.durationMs)
end 'runSpecTest'

function runOnceThenDiscard(staged FilePath, extraArguments StringArray = StringArray.create(0), environment Environment = Environment.inherit) returns CollectedOutput
	let run = runSpecTest(staged, includeNetwork: false, extraArguments: extraArguments, environment: environment)
	discardStagedDir(staged)
	return run
end 'runOnceThenDiscard'

function filterFlag(pattern String) returns String
	return "{FilterFlagPrefix}{pattern}"
end 'filterFlag'

function filterFlags(patterns StringArray) returns StringArray
	let flags = StringArray.create(0)

	for pattern in patterns 'eachPattern'
		flags.push(filterFlag(pattern))
	end 'eachPattern'

	return flags
end 'filterFlags'

function specPrefix(specName String) returns String
	return testLabel(specName, testName: "")
end 'specPrefix'

function selectedLabel(specName String) returns String
	return testLabel(specName, testName: "{specName}.selected")
end 'selectedLabel'

function ranVerdictIn(said String, specName String) returns bool
	let label = selectedLabel(specName)
	return said.contains(failVerdictPrefix(label)) or said.contains(passVerdictLine(label))
end 'ranVerdictIn'

function everythingSaid(run CollectedOutput) returns String
	return "{run.stdout}{LineFeed}{run.stderr}"
end 'everythingSaid'

function testLabel(specName String, testName String) returns String
	return "{specName}/{testName}"
end 'testLabel'

function failVerdictPrefix(label String) returns String
	return "FAIL {label}: "
end 'failVerdictPrefix'

function passVerdictLine(label String) returns String
	return "PASS {label}"
end 'passVerdictLine'

function skipVerdictLine(label String) returns String
	return "SKIP {label}{LineFeed}"
end 'skipVerdictLine'

function hostLaneName() returns String
	return hostTargetTriple()
end 'hostLaneName'

function hostTargetIrFence() returns String
	return "{TargetIrFenceStem}{hostTargetTriple()}"
end 'hostTargetIrFence'

function linesOpening(lines StringArray, prefix String) returns SpecLineArray
	let found = SpecLineArray.create(0)

	for (iter, line) in lines.withIterator() 'eachLine'
		if line.trim().startsWith(prefix) 'hit'
			found.push(iter.index() as SpecLine)
		end 'hit'
	end 'eachLine'

	return found
end 'linesOpening'

function firstLineOpening(lines StringArray, prefix String, said String) returns SpecLine
	let found = linesOpening(lines, prefix: prefix)
	return try found.get(0) otherwise panic("spec-harness tests: the re-minted spec holds no line opening with '{prefix}'. {said}")
end 'firstLineOpening'

function plantBogusTargetIrPin(specPath FilePath)
	let text = fileText(specPath)
	writeStagedFile(specPath, content: "{text}{LineFeed}{hostTargetIrFence()}{LineFeed}{PlantedTargetIrLine}{LineFeed}```{LineFeed}")
end 'plantBogusTargetIrPin'

// A spec holding a pin is refused unless every compiling case pins every native lane. The pin gates plant
// a block for each lane but the host's beneath the named markers, so the run reaches the one host-lane pin
// under test; a run only compares the block of its own lane.
function plantPlaceholderPinsBeneath(specPath FilePath, markers StringArray)
	let planted = StringBuilder.create()

	for (iter, line) in fileText(specPath).split(LineFeed).withIterator() 'eachLine'
		if iter.index() > 0 'afterTheFirstLine'
			planted.append(LineFeed)
		end 'afterTheFirstLine'

		planted.append(line)

		if not markers.contains(line.trim()) 'notAMarker'
			continue
		end 'notAMarker'

		for lane in otherNativeLanes() 'eachLane'
			planted.append("{LineFeed}{TargetIrFenceStem}{lane}{LineFeed}{PlaceholderTargetIrLine}{LineFeed}```")
		end 'eachLane'
	end 'eachLine'

	writeStagedFile(specPath, content: planted.build())
end 'plantPlaceholderPinsBeneath'

function otherNativeLanes() returns StringArray
	let others = StringArray.create(0)

	for lane in nativeTargets() 'eachLane'
		if lane != hostTargetTriple() 'anotherLane'
			others.push(lane)
		end 'anotherLane'
	end 'eachLane'

	return others
end 'otherNativeLanes'

function batchSummaryLine(batched CaseTally, programs CaseTally, alone CaseTally) returns String
	return "{batched} run case(s) ran batched in {programs} program(s); {alone} ran alone"
end 'batchSummaryLine'

function collectNotPassed(said String, specName String, testNames StringArray, broken StringArray)
	for testName in testNames 'eachCase'
		let verdict = "{passVerdictLine(testLabel(specName, testName: testName))}{LineFeed}"

		if not said.contains(verdict) 'didNotPass'
			broken.push("'{testLabel(specName, testName: testName)}' did not PASS. Expected '{verdict.trimEnd(CharacterSet.newlines)}', and the run said:\n{said}\n")
		end 'didNotPass'
	end 'eachCase'
end 'collectNotPassed'

function collectMissingSummary(said String, expected String, broken StringArray)
	if not said.contains(expected) 'summaryAbsent'
		broken.push("the run's summary does not say '{expected}'. It said:\n{said}\n")
	end 'summaryAbsent'
end 'collectMissingSummary'

let LeakerProcessIdFileName = "leaker.pid"
let LeakedOneProcessText = "the case left 1 process running: "
let LeakAdviceText = "wait for every process it starts before it ends"

function recordedProcessId(file FilePath) returns Pid
	let spelled = try File.readText(file) otherwise panic("spec-harness tests: the gate could not run - the case did not record the id of the process it started in {file.toString()}")

	return (try int.fromString(spelled.trim()) otherwise panic("spec-harness tests: the gate could not run - {file.toString()} holds '{spelled}', which is not a process id")) as Pid
end 'recordedProcessId'

function collectLeakNotReported(said String, label String, leaker Pid, broken StringArray)
	if not said.contains(failVerdictPrefix(label)) 'caseDidNotFail'
		broken.push("'{label}' left process {leaker} running and did not FAIL. Expected '{failVerdictPrefix(label)}', and the run said:\n{said}\n")
	end 'caseDidNotFail'

	if not said.contains("{LeakedOneProcessText}{leaker} ") 'leakerUnnamed'
		broken.push("the failure of '{label}' does not name the process it left. Expected '{LeakedOneProcessText}{leaker} ' followed by its image name, and the run said:\n{said}\n")
	end 'leakerUnnamed'

	if not said.contains(LeakAdviceText) 'adviceMissing'
		broken.push("the failure of '{label}' does not say how to fix it. Expected '{LeakAdviceText}', and the run said:\n{said}\n")
	end 'adviceMissing'

	if Process.isAlive(leaker) 'leakerStays'
		broken.push("the process the case left (id {leaker}) was still running when the run ended, so the harness did not end it")
	end 'leakerStays'
end 'collectLeakNotReported'

function resultNoteEntry(label String) returns String
	return "{ResultNoteIndent}{label}{LineFeed}"
end 'resultNoteEntry'

function requireNothingBroken(broken StringArray, headline String) throws TestFailure
	if broken.isEmpty() 'everyCheckHeld'
		return
	end 'everyCheckHeld'

	let report = StringBuilder.create()

	for item in broken 'eachBroken'
		report.append("{BrokenCheckIndent}{item}")
	end 'eachBroken'

	try Expect.fail("{broken.count()} check(s) FAILED: {headline}{report.build()}")
end 'requireNothingBroken'

function corpusDir(kind String) returns FilePath
	let spelled = "{CorpusDirName}{PortablePathSeparator}{kind}"
	let relative = try FilePath.from(spelled) otherwise panic("spec-harness tests: the gate could not run - '{spelled}' is not a spellable path")
	let dir = relative.resolve(Directory.currentPath())

	if not Directory.isDirectory(dir) 'notThere'
		panic("spec-harness tests: the gate could not run - there is no {dir.toString()}. This corpus's paths are relative to the CHECKOUT ROOT, which is the working directory a test binary inherits from `maxon test`.")
	end 'notThere'

	return dir
end 'corpusDir'

function caseNameOf(testFileName String) returns String
	if not testFileName.endsWith(TestSourceSuffix) 'notATestSource'
		panic("spec-harness tests: '{testFileName}' is not a `{TestSourceSuffix}` file, so it names no fixture.")
	end 'notATestSource'

	let parts = testFileName.split(TestSourceSuffix)

	if parts.count() != 2 'suffixInsideTheName'
		panic("spec-harness tests: '{testFileName}' carries `{TestSourceSuffix}` more than once, so which fixture it names is ambiguous.")
	end 'suffixInsideTheName'

	return try parts.get(0) otherwise panic("spec-harness tests: '{testFileName}' split into two parts and has no first one")
end 'caseNameOf'

function fixtureOf(caller String, kind String) returns HarnessFixture
	let components = caller.split(PortablePathSeparator)
	let depth = components.count()

	if depth < 2 'noCorpusDirectory'
		panic("spec-harness tests: '{caller}' does not sit in a `{kind}/` directory, so it names no fixture there.")
	end 'noCorpusDirectory'

	let fileName = try components.get(depth - 1) otherwise panic("spec-harness tests: '{caller}' has no last component")
	let dirName = try components.get(depth - 2) otherwise panic("spec-harness tests: '{caller}' has no parent component")

	if dirName != kind 'wrongCorpus'
		panic("spec-harness tests: '{caller}' asked for a `{kind}` fixture from outside `{kind}/`.")
	end 'wrongCorpus'

	let caseName = caseNameOf(fileName)
	let dir = corpusDir(kind).join(caseName)

	if not Directory.isDirectory(dir) 'noFixture'
		panic("spec-harness tests: '{caller}' names the fixture {dir.toString()}, and there is no such directory.")
	end 'noFixture'

	return HarnessFixture.create(kind, caseName: caseName, dir: dir)
end 'fixtureOf'

function expectedRefusalIn(fixture HarnessFixture) returns String
	let path = fixture.dir.join(ExpectedRefusalFileName)
	let text = fileText(path)
	let expected = text.trimEnd(CharacterSet.newlines)

	if expected.isEmpty() 'saysNothing'
		panic("spec-harness tests: {path.toString()} names no text, so nothing says WHICH refusal '{fixture.caseName}' is about.")
	end 'saysNothing'

	if expected.contains(LineFeed) or expected.contains(CarriageReturn) 'spansLines'
		panic("spec-harness tests: {path.toString()} holds more than one line. It is ONE substring of the refusal's message.")
	end 'spansLines'

	return expected
end 'expectedRefusalIn'

function copyFixtureInto(fixture HarnessFixture, staged FilePath)
	for entry in listing(fixture.dir) 'eachEntry'
		if Directory.isDirectory(entry) 'aSubdirectory'
			panic("spec-harness tests: the fixture {fixture.dir.toString()} holds a directory, {entry.filename()}. A fixture is flat: its spec files and nothing a run leaves behind.")
		end 'aSubdirectory'

		let bytes = fileBytes(entry)
		try File.writeBinary(staged.join(entry.filename()), content: bytes) otherwise panic("spec-harness tests: the gate could not run - could not stage {entry.filename()} into {staged.toString()}.")
	end 'eachEntry'
end 'copyFixtureInto'

function stagedCopyOf(fixture HarnessFixture) returns FilePath
	let staged = freshOutsideCheckoutDir("{fixture.kind}-{fixture.caseName}")
	copyFixtureInto(fixture, staged: staged)
	return staged
end 'stagedCopyOf'

function stagedRunCacheRoot(caller String = __file__) returns FilePath
	let fixture = fixtureOf(caller, kind: GatesDirName)
	return freshOutsideCheckoutDir("{RunCacheRootDirName}-{fixture.caseName}")
end 'stagedRunCacheRoot'

function runGateFixtureBelowAnIgnoredDirectory(caller String = __file__) returns CollectedOutput
	let fixture = fixtureOf(caller, kind: GatesDirName)
	let wrapper = freshOutsideCheckoutDir(IgnoredWrapperDirName)
	writeStagedFile(wrapper.join(IgnoreMarkerFileName), content: "")

	let staged = stagingDir(wrapper.join(IgnoredWrapperInnerDirName).toString())
	copyFixtureInto(fixture, staged: staged)

	let run = runSpecTest(staged, includeNetwork: false)
	discardStagedDir(wrapper)
	return run
end 'runGateFixtureBelowAnIgnoredDirectory'

function runGateFixtureBesideAStagedScriptlib(package String, fileName String, content String, caller String = __file__) returns CollectedOutput
	let fixture = fixtureOf(caller, kind: GatesDirName)
	let staged = stagedCopyOf(fixture)
	let tier = freshOutsideCheckoutDir("{StagedTierDirName}-{fixture.caseName}")
	let tierCompiler = stagedLibraryTierCompiler(tier, staged: tier)
	writeScriptlibPackageFile(tier, package: package, fileName: fileName, content: content)

	let run = runSpecTest(staged, includeNetwork: false, binary: tierCompiler)
	discardStagedDir(staged)
	discardStagedDir(tier)
	return run
end 'runGateFixtureBesideAStagedScriptlib'
