// homepage-hero.test.maxon — the program in the maxon.dev homepage's hero builds, and prints what it says it
// prints.

let HomepageDocument = "website/src/pages/index.astro"
let HomepageHeroMarker = "listening on"
let HomepageHeroProgram = "homepage-hero"

// What the program itself says: it prints `listening on` and its 8080 port, and `main` returns 0.
let HomepageHeroStdout = "listening on 8080\n"
let HomepageHeroExitCode = 0

test 'the homepage hero prints its port and exits 0'
	let run = try runDocumentProgram(HomepageDocument, marker: HomepageHeroMarker, name: HomepageHeroProgram)
	try requireAnswer(run, stdout: HomepageHeroStdout, exitCode: HomepageHeroExitCode)
end 'the homepage hero prints its port and exits 0'
