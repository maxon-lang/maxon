// binary-trees.maxtest — `examples/binary-trees.maxon` builds and computes the benchmark's node-count
// checks for a stretch tree, every batch of short-lived trees, and the long-lived tree.

let BinaryTreesExample = "binary-trees.maxon"

// The Benchmarks Game's published reference output, `binarytrees-output.txt`, which is for n=10. Each line
// separates its columns with a tab followed by a space, as the reference does.
let BinaryTreesPublishedDepth = "10"
let BinaryTreesPublishedStdout = "stretch tree of depth 11\t check: 4095\n1024\t trees of depth 4\t check: 31744\n256\t trees of depth 6\t check: 32512\n64\t trees of depth 8\t check: 32704\n16\t trees of depth 10\t check: 32752\nlong lived tree of depth 10\t check: 2047\n"
let BinaryTreesExitCode = 0

test 'binary-trees computes the published checks'
	let run = runExample(BinaryTreesExample, arguments: [BinaryTreesPublishedDepth])
	requireAnswer(run, stdout: BinaryTreesPublishedStdout, exitCode: BinaryTreesExitCode)
end 'binary-trees computes the published checks'
