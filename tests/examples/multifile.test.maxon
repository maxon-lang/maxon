// multifile.test.maxon — `examples/multifile/` builds as ONE project and runs.
//
// `main.maxon` calls functions only `math/vector.maxon` declares, so a build that compiled the entry file
// alone would not resolve them.

let MultifileExample = "multifile"

// What its source computes: (3, 4) + (1, 2) = (4, 6), whose squared magnitude 52 is positive, so `main`
// returns 5 and prints nothing.
let MultifileStdout = ""
let MultifileExitCode = 5

test 'multifile builds as one project and returns its answer'
	let run = try runExample(MultifileExample)
	try requireAnswer(run, stdout: MultifileStdout, exitCode: MultifileExitCode)
end 'multifile builds as one project and returns its answer'
