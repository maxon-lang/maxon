// hello.test.maxon — `examples/hello.maxon` builds, greets, and exits cleanly.

let HelloExample = "hello.maxon"

// What the example's own header documents: it prints the greeting, and `main` returns 0.
let HelloStdout = "Hello, world!\n"
let HelloExitCode = 0

test 'hello prints its greeting and exits 0'
	let run = try runExample(HelloExample)
	try requireAnswer(run, stdout: HelloStdout, exitCode: HelloExitCode)
end 'hello prints its greeting and exits 0'
