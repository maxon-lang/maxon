// basic.test.maxon — `examples/basic.maxon` builds, and its `main` answers with its exit code.

let BasicExample = "basic.maxon"

// `examples/basic.maxon` is `main` returning 42 and nothing else, so it prints nothing and exits 42.
let BasicStdout = ""
let BasicExitCode = 42

test 'basic exits with the value its main returns'
	let run = try runExample(BasicExample)
	try requireAnswer(run, stdout: BasicStdout, exitCode: BasicExitCode)
end 'basic exits with the value its main returns'
