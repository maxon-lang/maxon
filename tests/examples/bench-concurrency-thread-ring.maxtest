let ThreadRingWorkload = "thread-ring"
let ThreadRingPasses = "1000"
// What `bench/concurrency/thread-ring/main.go`, the oracle, prints for the arguments above.
let ThreadRingStdout = "thread-ring 498\n"

test 'thread-ring names the thread holding the token when it reaches zero'
	requireConcurrencyBenchmarkAnswer(ThreadRingWorkload, arguments: [ThreadRingPasses], stdout: ThreadRingStdout)
end 'thread-ring names the thread holding the token when it reaches zero'
