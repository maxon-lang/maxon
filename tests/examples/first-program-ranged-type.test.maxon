// first-program-ranged-type.test.maxon — the "Adding a ranged type" program in the docs' first-program
// walk-through builds, and prints what it says it prints.

let RangedTypeDocument = "website/src/content/docs/docs/getting-started/first-program.md"
let RangedTypeMarker = "listening on"
let RangedTypeProgram = "first-program-ranged-type"

// What the program itself says: it prints `listening on` and its 8080 port, and `main` returns 0.
let RangedTypeStdout = "listening on 8080\n"
let RangedTypeExitCode = 0

test 'the first-program ranged type prints its port and exits 0'
	let run = try runDocumentProgram(RangedTypeDocument, marker: RangedTypeMarker, name: RangedTypeProgram)
	try requireAnswer(run, stdout: RangedTypeStdout, exitCode: RangedTypeExitCode)
end 'the first-program ranged type prints its port and exits 0'
