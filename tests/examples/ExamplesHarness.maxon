// ExamplesHarness.maxon — the shared half every case under `tests/examples/` reaches for: building
// one program from `examples/` or `bench/concurrency/`, or one complete program a document shows,
// with the compiler under test, and running what it built.
//
// ⭐ **EVERY EXPECTATION IS EXTERNAL**: a reference output someone else published, or the behaviour the
// program's own source documents. An answer captured from this compiler would agree with whatever it does.
//
// ⛔ **THE EXAMPLES ARE BUILT WHERE THEY SIT, NEVER COPIED**, because the gate is about the files a reader
// runs. Only the OUTPUT is staged, into `temp/examples/<source spelling>/`: `maxon test` runs files
// concurrently, and `--output=` is what keeps a build out of the tree lock. The whole spelling names
// the directory because two programs can share a stem, and two builds in one directory overwrite
// each other. A document's program has no file of its own, so it is cut out of the document as it
// stands and written into its staging directory, and built there.
//
// ⛔ **A DOCUMENT PROGRAM IS NAMED BY A MARKER, AND A MARKER MUST SELECT EXACTLY ONE BLOCK** — the gate
// could not run otherwise. A marker that quietly selected nothing, or the first of two, would let an edit
// to the document take its program out of the gate without a word.
//
// ⛔ **EVERY FREE FUNCTION IN A DIRECTORY SHARES ONE NAMESPACE** (E3006), so a case file declares only what
// that case alone uses.
//
// ⛔ **WHAT WOULD STOP A CASE RUNNING AT ALL PANICS**: a missing compiler, example or document, an
// unspellable path, a spawn that never happened. A build that fails is asserted, because that is what this
// corpus gates.
//
// ⛔ **PATHS ARE RELATIVE TO THE CHECKOUT ROOT**, the working directory `maxon test` gives a test binary.
// Everything handed to a child is made absolute first, because a relative path resolves against the child's
// directory on POSIX and the parent's on Windows.

// The compiler under test, relative to the checkout root and without its host suffix.
let TestedCompilerStem = "maxon-bin/.maxon/maxon"

let ExamplesDirName = "examples"
let StagingRootDirName = "temp/examples"

let ConcurrencyBenchmarkDirName = "bench/concurrency"
let ProcessorCountVariable = "MAXON_MAX_PROCS"
let ConcurrencyBenchmarkProcessorCounts = ["1", "4"]
let ConcurrencyBenchmarkExitCode = 0

let BuildCommandName = "build"
let OutputOptionPrefix = "--output="

let MaxonSourceSuffix = ".maxon"
let PathSeparator = "/"
let CarriageReturn = "\r"
let LineFeed = "\n"

// A Markdown document's programs are its ```maxon fences.
let MarkdownSuffix = ".md"
let MaxonFenceOpen = "```maxon"
let FenceClose = "```"

// An Astro page's programs are the template literals its frontmatter binds with `const`.
let AstroSuffix = ".astro"
let ConstDeclaration = "const "
let TemplateLiteralOpen = " = `"
let TemplateLiteralClose = "`;"

// A template literal spells a backslash `\\`, so a program that prints `\n` holds `\\n` in the page.
let EscapedBackslash = "\\\\"
let Backslash = "\\"

// What a built program exits with, as the runner reports it.
export typealias ExampleExitCode = int(i64.min to i64.max)

// One run of a built program, stdout folded so a Windows console's line endings do not decide what it says.
export type ExampleRun
	export let commandLine as String
	export let exitCode as ExampleExitCode
	export let stdout as String
	export let stderr as String

	static function create(commandLine String, exitCode ExampleExitCode, stdout String, stderr String) returns ExampleRun
		return Self{commandLine: commandLine, exitCode: exitCode, stdout: stdout, stderr: stderr}
	end 'create'
end 'ExampleRun'

// Build `<directory>/<example>` — a file or a project directory — with the compiler under test. The
// previous run's files go first, so an executable a failed build left behind cannot answer for this
// one.
export function requireExampleBuild(example String, directory String = ExamplesDirName) throws TestFailure
	let source = examplePath(example, directory: directory)
	let staging = exampleStagingDir(example, directory: directory)
	clearStagedFiles(staging)

	try requireBuild(source, staging: staging, stem: exampleStem(example), spelling: exampleSpelling(example, directory: directory))
end 'requireExampleBuild'

// Run what `requireExampleBuild` produced, with `arguments` as its command line.
export function runBuiltExample(example String, arguments StringArray = StringArray.create(), directory String = ExamplesDirName, environment EnvMap = EnvMap.create()) returns ExampleRun
	return runBuilt(exampleStagingDir(example, directory: directory), stem: exampleStem(example), spelling: exampleSpelling(example, directory: directory), arguments: arguments, environment: environment)
end 'runBuiltExample'

export function requireConcurrencyBenchmarkAnswer(workload String, arguments StringArray, stdout String) throws TestFailure
	let program = "{workload}{MaxonSourceSuffix}"
	try requireExampleBuild(program, directory: ConcurrencyBenchmarkDirName)

	for processors in ConcurrencyBenchmarkProcessorCounts 'eachProcessorCount'
		let run = runBuiltExample(program, arguments: arguments, directory: ConcurrencyBenchmarkDirName, environment: [ProcessorCountVariable: processors])
		try requireAnswer(run, stdout: stdout, exitCode: ConcurrencyBenchmarkExitCode)
	end 'eachProcessorCount'
end 'requireConcurrencyBenchmarkAnswer'

// Write `content` at `relativePath` inside `example`'s staging directory, which is the working directory
// `runBuiltExample` gives the program — so a case hands its fixture to the program by relative path.
// Called after `requireExampleBuild`, which clears what a previous run staged.
export function stageExampleFile(example String, relativePath String, content String, directory String = ExamplesDirName) returns FilePath
	let staged = exampleStagingDir(example, directory: directory).join(relativePath)
	let parent = try staged.parent() otherwise panic("examples tests: the gate could not run — '{relativePath}' names no file under a staging directory.")

	if not Directory.create(parent) 'couldNotCreate'
		panic("examples tests: the gate could not run — could not create {parent.toString()}, where a fixture file is staged.")
	end 'couldNotCreate'

	try File.writeText(staged, content: content) otherwise panic("examples tests: the gate could not run — could not stage {staged.toString()}.")

	return staged
end 'stageExampleFile'

// Build an example and run it once.
export function runExample(example String, arguments StringArray = StringArray.create()) returns ExampleRun throws TestFailure
	try requireExampleBuild(example)

	return runBuiltExample(example, arguments: arguments)
end 'runExample'

// Build the one program in `document` that contains `marker`, staged as `<name>.maxon` in its own directory
// under `temp/examples/`, and run it once.
export function runDocumentProgram(document String, marker String, name String) returns ExampleRun throws TestFailure
	let program = documentProgram(document, marker: marker)

	let staged = stagingDir("{document}{PathSeparator}{name}")
	clearStagedFiles(staged)

	let source = staged.join("{name}{MaxonSourceSuffix}")
	try File.writeText(source, content: program) otherwise panic("examples tests: the gate could not run — could not stage {document}'s program at {source.toString()}.")

	let spelling = "{document} ({name})"
	try requireBuild(source, staging: staged, stem: name, spelling: spelling)

	return runBuilt(staged, stem: name, spelling: spelling, arguments: StringArray.create(), environment: EnvMap.create())
end 'runDocumentProgram'

// Build `source` into `staging` as `stem`; `spelling` is how every report names the program.
function requireBuild(source FilePath, staging FilePath, stem String, spelling String) throws TestFailure
	let output = builtExecutable(staging, stem: stem)

	var arguments = StringArray.create()
	arguments.push(BuildCommandName)
	arguments.push(source.toString())
	arguments.push("{OutputOptionPrefix}{output.toString()}")

	var config = Configuration.create(Executable.path(testedCompilerPath()))
	config.arguments = arguments
	config.workingDirectory = staging

	let build = try config.run() otherwise (e) 'spawnFailed'
		panic("examples tests: the gate could not run — could not spawn the compiler to build {source.toString()} ({e.displayReason()}).")
	end 'spawnFailed'

	let command = "{BuildCommandName} {spelling}"
	try Expect.equal(build.exitCode(), expected: 0, message: "`{command}` exited {build.exitCode()}. The compiler said: {withoutCarriageReturns(build.stderr)}")
	try Expect.isTrue(File.exists(output), message: "`{command}` exited 0 and wrote no executable to {output.toString()}.")
end 'requireBuild'

// Run what `requireBuild` produced for `stem`, with `arguments` as its command line.
function runBuilt(staging FilePath, stem String, spelling String, arguments StringArray, environment EnvMap) returns ExampleRun
	let executable = builtExecutable(staging, stem: stem)

	var config = Configuration.create(Executable.path(executable))
	config.arguments = arguments
	config.workingDirectory = staging
	config.environment = Environment.inheritUpdating(environment)

	let run = try config.run() otherwise (e) 'spawnFailed'
		panic("examples tests: the gate could not run — could not spawn {executable.toString()} ({e.displayReason()}).")
	end 'spawnFailed'

	var commandLine = ""

	for (name, value) in environment 'eachVariable'
		commandLine.append("{name}={value} ")
	end 'eachVariable'

	commandLine.append(spelling)

	for argument in arguments 'eachArgument'
		commandLine.append(" {argument}")
	end 'eachArgument'

	return ExampleRun.create(commandLine, exitCode: run.exitCode() as ExampleExitCode, stdout: withoutCarriageReturns(run.stdout), stderr: withoutCarriageReturns(run.stderr))
end 'runBuilt'

// The one program block in `document` that contains `marker`.
function documentProgram(document String, marker String) returns String
	let path = try FilePath.from(document) otherwise panic("examples tests: the gate could not run — '{document}' is not a spellable path")
	let text = try File.readText(path) otherwise panic("examples tests: the gate could not run — could not read '{document}'. Every path in this corpus is relative to the CHECKOUT ROOT; a run started anywhere else finds nothing, and a moved document needs its case moved with it.")
	let lines = withoutCarriageReturns(text).split(LineFeed)

	var marked = StringArray.create()

	for block in programBlocks(document, lines: lines) 'eachBlock'
		if block.contains(marker) 'hasMarker'
			marked.push(block)
		end 'hasMarker'
	end 'eachBlock'

	if marked.count() != 1 'notExactlyOne'
		panic("examples tests: the gate could not run — {marked.count()} program blocks in '{document}' contain the marker `{marker}`, and a case builds exactly one. A document edit that drops, rewords or duplicates a program has to be carried into its case.")
	end 'notExactlyOne'

	return try marked.get(0) otherwise panic("examples tests: exactly one marked block was just counted")
end 'documentProgram'

function programBlocks(document String, lines StringArray) returns StringArray
	if document.endsWith(MarkdownSuffix) 'markdown'
		return markdownFences(lines)
	end 'markdown'

	if not document.endsWith(AstroSuffix) 'unreadable'
		panic("examples tests: the gate could not run — '{document}' is neither Markdown nor an Astro page, the two kinds of document this harness reads programs out of.")
	end 'unreadable'

	return templateLiterals(lines)
end 'programBlocks'

// The text of every ```maxon fence, one line per source line.
function markdownFences(lines StringArray) returns StringArray
	var blocks = StringArray.create()
	var inFence = false
	var block = ""

	for line in lines 'eachLine'
		let fence = line.trim()

		if not inFence 'outside'
			inFence = fence == MaxonFenceOpen
			continue
		end 'outside'

		if fence == FenceClose 'closes'
			blocks.push(block)
			block = ""
			inFence = false
			continue
		end 'closes'

		block.append("{line}{LineFeed}")
	end 'eachLine'

	return blocks
end 'markdownFences'

// The text of every `const` template literal, its escaped backslashes undone. The opening line carries the
// literal's first line after the backtick, and the closing line its last before the `` `; ``.
function templateLiterals(lines StringArray) returns StringArray
	var blocks = StringArray.create()
	var inLiteral = false
	var block = ""

	for line in lines 'eachLine'
		let opens = not inLiteral and line.trimStart().startsWith(ConstDeclaration) and line.contains(TemplateLiteralOpen)

		if not inLiteral and not opens 'outside'
			continue
		end 'outside'

		let body = templateLiteralFirstLine(line) if opens else line
		inLiteral = true

		if not body.endsWith(TemplateLiteralClose) 'continues'
			block.append("{body}{LineFeed}")
			continue
		end 'continues'

		let closing = try body.findLast(TemplateLiteralClose) otherwise panic("examples tests: a line that ends with the literal's close contains it")
		block.append("{body.slice(body.startIndex(), endIndex: closing)}{LineFeed}")
		blocks.push(block.replace(EscapedBackslash, with: Backslash))
		block = ""
		inLiteral = false
	end 'eachLine'

	return blocks
end 'templateLiterals'

// What follows the opening backtick on the line that declares a template literal.
function templateLiteralFirstLine(line String) returns String
	let halves = line.split(TemplateLiteralOpen)

	if halves.count() != 2 'ambiguous'
		panic("examples tests: the gate could not run — cannot tell where the template literal opens on `{line}`.")
	end 'ambiguous'

	return try halves.get(1) otherwise panic("examples tests: a two-way split has a second half")
end 'templateLiteralFirstLine'

// Hold a run to the answer a case cites.
export function requireAnswer(run ExampleRun, stdout String, exitCode ExampleExitCode) throws TestFailure
	try Expect.equal(run.stdout, expected: stdout, message: "`{run.commandLine}` did not print its known answer. It exited {run.exitCode} and wrote to stderr: {run.stderr}")
	try Expect.equal(run.exitCode, expected: exitCode, message: "`{run.commandLine}` printed its known answer and exited {run.exitCode}. It wrote to stderr: {run.stderr}")
end 'requireAnswer'

// `<directory>/<example>`, which is also how every report names it.
function exampleSpelling(example String, directory String) returns String
	return "{directory}{PathSeparator}{example}"
end 'exampleSpelling'

// The example's source, absolute because it is handed to a child.
function examplePath(example String, directory String) returns FilePath
	let spelled = exampleSpelling(example, directory: directory)
	let path = try FilePath.from(spelled) otherwise panic("examples tests: the gate could not run — '{spelled}' is not a spellable path")

	if not File.exists(path) and not Directory.isDirectory(path) 'notThere'
		panic("examples tests: the gate could not run — there is no example at '{spelled}'. Every path in this corpus is relative to the CHECKOUT ROOT; a run started anywhere else finds nothing, and a renamed example needs its case renamed with it.")
	end 'notThere'

	return path.resolve(Directory.currentPath())
end 'examplePath'

// An example's name without its source suffix, which names its executable.
function exampleStem(example String) returns String
	return example.replace(MaxonSourceSuffix, with: "")
end 'exampleStem'

function builtExecutable(staging FilePath, stem String) returns FilePath
	return staging.join("{stem}{executableSuffix()}")
end 'builtExecutable'

function exampleStagingDir(example String, directory String) returns FilePath
	return stagingDir(exampleSpelling(example, directory: directory))
end 'exampleStagingDir'

// A program's own staging directory, created with its missing ancestors so a fresh checkout without
// `temp/` is not a failure.
function stagingDir(source String) returns FilePath
	let spelled = "{StagingRootDirName}{PathSeparator}{source}"
	let path = try FilePath.from(spelled) otherwise panic("examples tests: the gate could not run — '{spelled}' is not a spellable path")

	if not Directory.create(path) 'couldNotCreate'
		panic("examples tests: the gate could not run — could not create '{spelled}', which is where this program is built.")
	end 'couldNotCreate'

	return path.resolve(Directory.currentPath())
end 'stagingDir'

function testedCompilerPath() returns FilePath
	let spelled = "{TestedCompilerStem}{executableSuffix()}"
	let relative = try FilePath.from(spelled) otherwise panic("examples tests: the gate could not run — '{spelled}' is not a spellable path")
	let binary = relative.resolve(Directory.currentPath())

	if not File.exists(binary) 'noBinary'
		panic("examples tests: the gate could not run — there is no compiler at {binary.toString()}. This corpus's paths are relative to the CHECKOUT ROOT; run it from there, and build `{TestedCompilerStem}` first.")
	end 'noBinary'

	return binary
end 'testedCompilerPath'

function executableSuffix() returns String
	#if os(Windows)
		let suffix = ".exe"
	#else
		let suffix = ""
	#endif

	return suffix
end 'executableSuffix'

// Delete every file under a staging directory, leaving the directories: the standard library cannot remove
// a directory.
function clearStagedFiles(dir FilePath)
	let entries = try Directory.list(dir) otherwise panic("examples tests: the gate could not run — could not list {dir.toString()}")

	for entry in entries 'eachEntry'
		if Directory.isDirectory(entry) 'aDirectory'
			clearStagedFiles(entry)
			continue
		end 'aDirectory'

		try File.delete(entry) otherwise panic("examples tests: the gate could not run — could not clear {entry.toString()} from a previous run's staging.")
	end 'eachEntry'
end 'clearStagedFiles'

function withoutCarriageReturns(raw String) returns String
	return raw.replace(CarriageReturn, with: "")
end 'withoutCarriageReturns'
