// readme-hero.test.maxon — the program at the top of `README.md` builds, and prints what it says it prints.

let ReadmeDocument = "README.md"
let ReadmeHeroMarker = "listening on"
let ReadmeHeroProgram = "readme-hero"

// What the program itself says: it prints `listening on` and its 8080 port, and `main` returns 0.
let ReadmeHeroStdout = "listening on 8080\n"
let ReadmeHeroExitCode = 0

test 'the README hero prints its port and exits 0'
	let run = try runDocumentProgram(ReadmeDocument, marker: ReadmeHeroMarker, name: ReadmeHeroProgram)
	try requireAnswer(run, stdout: ReadmeHeroStdout, exitCode: ReadmeHeroExitCode)
end 'the README hero prints its port and exits 0'
