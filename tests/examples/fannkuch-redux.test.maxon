// fannkuch-redux.test.maxon — `examples/fannkuch-redux.maxon` builds and computes the benchmark's checksum
// and maximum flip count. Its header documents that the flip count is also the exit code.

let FannkuchExample = "fannkuch-redux.maxon"

// The Benchmarks Game's published reference output, `fannkuchredux-output.txt`, which is for n=7.
let PublishedSize = "7"
let PublishedStdout = "228\nPfannkuchen(7) = 16\n"
let PublishedFlips = 16

// n=10, the size the example's header documents alongside the benchmark's own sizes.
let DocumentedSize = "10"
let DocumentedStdout = "73196\nPfannkuchen(10) = 38\n"
let DocumentedFlips = 38

test 'fannkuch-redux computes the published checksum and flip count'
	try requireExampleBuild(FannkuchExample)

	let published = runBuiltExample(FannkuchExample, arguments: [PublishedSize])
	try requireAnswer(published, stdout: PublishedStdout, exitCode: PublishedFlips)

	let documented = runBuiltExample(FannkuchExample, arguments: [DocumentedSize])
	try requireAnswer(documented, stdout: DocumentedStdout, exitCode: DocumentedFlips)
end 'fannkuch-redux computes the published checksum and flip count'
