let SpawnManyWorkload = "spawn-many"
let SpawnManyThreadCount = "1000"

// What `bench/concurrency/spawn-many/main.go`, the oracle, prints for the arguments above.
let SpawnManyStdout = "spawn-many 999000\n"

test 'spawn-many sums the reply of every thread it started'
	requireConcurrencyBenchmarkAnswer(SpawnManyWorkload, arguments: [SpawnManyThreadCount], stdout: SpawnManyStdout)
end 'spawn-many sums the reply of every thread it started'
