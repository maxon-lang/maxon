let SharedCounterWorkload = "shared-counter"
let SharedCounterPerIncrementer = "100"

// What `bench/concurrency/shared-counter/main.go`, the oracle, prints for the arguments above.
let SharedCounterStdout = "shared-counter 6400\n"

test 'shared-counter counts every increment of its incrementers'
	requireConcurrencyBenchmarkAnswer(SharedCounterWorkload, arguments: [SharedCounterPerIncrementer], stdout: SharedCounterStdout)
end 'shared-counter counts every increment of its incrementers'
