// first-program-labeled-blocks.test.maxon — the "Labeled blocks" program in the docs' first-program
// walk-through builds, and prints what it says it prints.

let LabeledBlocksDocument = "website/src/content/docs/docs/getting-started/first-program.md"
let LabeledBlocksMarker = "while iteration < 10 'iterate'"
let LabeledBlocksProgram = "first-program-labeled-blocks"

// What the program itself says: one line per pass while `iteration` counts 0 up to 10, and `main` returns 0.
let LabeledBlocksStdout = "iteration 0\niteration 1\niteration 2\niteration 3\niteration 4\niteration 5\niteration 6\niteration 7\niteration 8\niteration 9\n"
let LabeledBlocksExitCode = 0

test 'the first-program labeled blocks prints ten iterations and exits 0'
	let run = try runDocumentProgram(LabeledBlocksDocument, marker: LabeledBlocksMarker, name: LabeledBlocksProgram)
	try requireAnswer(run, stdout: LabeledBlocksStdout, exitCode: LabeledBlocksExitCode)
end 'the first-program labeled blocks prints ten iterations and exits 0'
