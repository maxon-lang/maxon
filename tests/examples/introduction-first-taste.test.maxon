// introduction-first-taste.test.maxon — the "A first taste" program in the docs' introduction builds, and
// prints what it says it prints.

let IntroductionDocument = "website/src/content/docs/docs/getting-started/introduction.md"
let FirstTasteMarker = "listening on"
let FirstTasteProgram = "introduction-first-taste"

// What the program itself says: it prints `listening on` and its 8080 port, and `main` returns 0.
let FirstTasteStdout = "listening on 8080\n"
let FirstTasteExitCode = 0

test 'the introduction first taste prints its port and exits 0'
	let run = try runDocumentProgram(IntroductionDocument, marker: FirstTasteMarker, name: FirstTasteProgram)
	try requireAnswer(run, stdout: FirstTasteStdout, exitCode: FirstTasteExitCode)
end 'the introduction first taste prints its port and exits 0'
