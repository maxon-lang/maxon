// first-program-hello.test.maxon — the "Hello, exit code" program in the docs' first-program walk-through
// builds, and exits with what its `main` returns.

let FirstProgramHelloDocument = "website/src/content/docs/docs/getting-started/first-program.md"
let FirstProgramHelloProgram = "first-program-hello"

// Every program on that page has a `main` returning 0; this is the one that returns it straight away.
let FirstProgramHelloMarker = "returns ExitCode\n\treturn 0\n"

// The page's own account: the smallest valid program, whose return value becomes the exit code.
let FirstProgramHelloStdout = ""
let FirstProgramHelloExitCode = 0

test 'the first-program hello prints nothing and exits 0'
	let run = try runDocumentProgram(FirstProgramHelloDocument, marker: FirstProgramHelloMarker, name: FirstProgramHelloProgram)
	try requireAnswer(run, stdout: FirstProgramHelloStdout, exitCode: FirstProgramHelloExitCode)
end 'the first-program hello prints nothing and exits 0'
