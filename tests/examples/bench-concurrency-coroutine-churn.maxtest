let CoroutineChurnWorkload = "coroutine-churn"
let CoroutineChurnCount = "1000"
// What `bench/concurrency/coroutine-churn/main.go`, the oracle, prints for the arguments above.
let CoroutineChurnStdout = "coroutine-churn 499500\n"

test 'coroutine-churn sums the result of every coroutine after each yields once'
	requireConcurrencyBenchmarkAnswer(CoroutineChurnWorkload, arguments: [CoroutineChurnCount], stdout: CoroutineChurnStdout)
end 'coroutine-churn sums the result of every coroutine after each yields once'
