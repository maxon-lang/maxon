// spectral-norm.test.maxon — `examples/spectral-norm.maxon` builds and computes the benchmark's spectral
// norm.

let SpectralNormExample = "spectral-norm.maxon"

// The Benchmarks Game's published reference output, `spectralnorm-output.txt`, which is for n=100.
let SpectralNormPublishedSize = "100"
let SpectralNormPublishedStdout = "1.274219991\n"
let SpectralNormExitCode = 0

test 'spectral-norm computes the published norm'
	let run = try runExample(SpectralNormExample, arguments: [SpectralNormPublishedSize])
	try requireAnswer(run, stdout: SpectralNormPublishedStdout, exitCode: SpectralNormExitCode)
end 'spectral-norm computes the published norm'
