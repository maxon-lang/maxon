// spectral-norm.test.maxon — `examples/spectral-norm.maxon` builds.
//
// ⚠ BUILD ONLY. The example takes no argument and always runs the benchmark's full n=5500, which does not
// fit a test file's deadline, and it prints nothing: it answers through its exit code instead, so the
// Benchmarks Game's published output (`spectralnorm-output.txt`, n=100) has nothing to be compared with.

let SpectralNormExample = "spectral-norm.maxon"

test 'spectral-norm builds'
	try requireExampleBuild(SpectralNormExample)
end 'spectral-norm builds'
