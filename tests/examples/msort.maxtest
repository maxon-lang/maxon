// msort.maxtest — `examples/msort.maxon` builds, and orders a fixture the way its own usage documents:
// byte order on the key, a sort that is stable so equal keys keep input order, the flags it declares, the
// two options that carry a number, and the one failing exit code.
//
// ⭐ **EVERY EXPECTED VALUE BELOW IS READ OFF THE FIXTURE TEXT AND `msort`'s DOCUMENTED BEHAVIOUR**, which
// is what this corpus is for; a capture of what the program printed would agree with whatever it does.
//
// ⛔ **THE 256-LINE FIXTURE IS WRITTEN AT RUN TIME, NOT STORED** — one loop writes it counting down and
// writes the answer counting up, so the file and the order it is held to cannot drift apart.
//
// ⚠ **ZERO PADDING IS WHAT MAKES BYTE ORDER AND NUMERIC ORDER AGREE** on that file: unpadded, `line 9`
// sorts above `line 10` as text and below it as a number, and the case would be asking two questions.

let MsortExample = "msort.maxon"

// Five lines carrying the two things the ordering cases need: a repeated key, and a capital. `M` is 0x4D,
// below every lowercase letter, so `Moose` leads in byte order and moves into the middle under `-f`.
let MsortAnimalsText = "zebra\nant\nMoose\nant\nbee\n"

// Four lines whose leading numbers order differently from their text — `10` is the smallest number and the
// smallest text — and whose second field repeats, which is what `--key=2` needs to show stability.
let MsortScoresText = "10 ant\n2 zebra\n33 bee\n2 ant\n"

// The program gives a worker no fewer than 64 lines, so 256 is exactly four workers' worth: `--jobs=4` is a
// real fan-out and a real merge rather than a single in-process sort wearing a flag.
let MsortManyLineCount = 256

test 'msort orders its fixture the way its usage documents'
	requireExampleBuild(MsortExample)

	var manyText = StringBuilder.create()
	var manyAscending = StringBuilder.create()

	for number in 0 upto MsortManyLineCount 'eachLine'
		let descending = MsortManyLineCount - 1 - number
		manyText.append("line {descending:03}\n")
		manyAscending.append("line {number:03}\n")
	end 'eachLine'

	_ = stageExampleFile(MsortExample, relativePath: "data/animals.txt", content: MsortAnimalsText)
	_ = stageExampleFile(MsortExample, relativePath: "data/scores.txt", content: MsortScoresText)
	_ = stageExampleFile(MsortExample, relativePath: "data/many.txt", content: manyText.build())

	// Byte order on the whole line: `M` (0x4D) is below every lowercase letter, then `a` < `b` < `z`. The
	// two `ant` lines are one run, and nothing drops them without `-u`.
	requireAnswer(runBuiltExample(MsortExample, arguments: ["data/animals.txt"]), stdout: "Moose\nant\nant\nbee\nzebra\n", exitCode: 0)

	// `-f` folds ASCII case, which compares `Moose` as `moose` — between `bee` and `zebra`. The line itself
	// is printed as it was read: folding decides the key, not the text.
	requireAnswer(runBuiltExample(MsortExample, arguments: ["-f", "data/animals.txt"]), stdout: "ant\nant\nbee\nMoose\nzebra\n", exitCode: 0)

	// `-u` prints the first line of each run of equal keys, so one of the two `ant` lines goes.
	requireAnswer(runBuiltExample(MsortExample, arguments: ["-u", "data/animals.txt"]), stdout: "Moose\nant\nbee\nzebra\n", exitCode: 0)

	// `-r` orders from the greatest key down — the first case read backwards.
	requireAnswer(runBuiltExample(MsortExample, arguments: ["-r", "data/animals.txt"]), stdout: "zebra\nbee\nant\nant\nMoose\n", exitCode: 0)

	// `-n` compares the leading whole number of the key: 2, 2, 10, 33. The two 2s keep input order — `2 zebra`
	// is line 2 and `2 ant` is line 4 — which is what a stable sort guarantees. A text sort would put
	// `10 ant` first, so this case separates the two readings of the same file.
	requireAnswer(runBuiltExample(MsortExample, arguments: ["-n", "data/scores.txt"]), stdout: "2 zebra\n2 ant\n10 ant\n33 bee\n", exitCode: 0)

	// `--key=2` compares field 2, blanks separating fields: `ant`, `zebra`, `bee`, `ant`. The two `ant` keys
	// are lines 1 and 4 and keep that order, so the whole lines come out `10 ant` then `2 ant`.
	requireAnswer(runBuiltExample(MsortExample, arguments: ["--key=2", "data/scores.txt"]), stdout: "10 ant\n2 ant\n33 bee\n2 zebra\n", exitCode: 0)

	// `--jobs=N` is how many workers sort the chunks; it is not part of the answer, so four workers and one
	// print the same 256 lines ascending — the same numbers the fixture was written with, counted up.
	let manyStdout = manyAscending.build()
	requireAnswer(runBuiltExample(MsortExample, arguments: ["--jobs=4", "data/many.txt"]), stdout: manyStdout, exitCode: 0)
	requireAnswer(runBuiltExample(MsortExample, arguments: ["--jobs=1", "data/many.txt"]), stdout: manyStdout, exitCode: 0)

	// Every FILE's lines are sorted together, not file by file. The digits `1`–`3` are 0x31–0x33, below `M`,
	// so all four of `scores.txt`'s lines lead; `2 ant` precedes `2 zebra` on the byte after the blank.
	let both = "10 ant\n2 ant\n2 zebra\n33 bee\nMoose\nant\nant\nbee\nzebra\n"
	requireAnswer(runBuiltExample(MsortExample, arguments: ["data/animals.txt", "data/scores.txt"]), stdout: both, exitCode: 0)

	// A flag the program does not declare is a usage error: the report goes to stderr, stdout stays empty,
	// and the run exits 2.
	requireAnswer(runBuiltExample(MsortExample, arguments: ["-z", "data/animals.txt"]), stdout: "", exitCode: 2)

	// Fields count from 1, so `--key=0` names no field and is refused the same way. It is not read as "the
	// whole line", which is what the absent option means.
	requireAnswer(runBuiltExample(MsortExample, arguments: ["--key=0", "data/animals.txt"]), stdout: "", exitCode: 2)

	// A FILE that cannot be read is reported on stderr and leaves the run troubled, which is exit 2 — and
	// nothing was sorted, so stdout is empty.
	requireAnswer(runBuiltExample(MsortExample, arguments: ["data/nope.txt"]), stdout: "", exitCode: 2)
end 'msort orders its fixture the way its usage documents'
