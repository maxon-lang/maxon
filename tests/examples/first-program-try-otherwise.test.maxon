// first-program-try-otherwise.test.maxon — the "Fallible operations" program in the docs' first-program
// walk-through builds, and prints what it says it prints.

let TryOtherwiseDocument = "website/src/content/docs/docs/getting-started/first-program.md"
let TryOtherwiseMarker = "function guestAt"
let TryOtherwiseProgram = "first-program-try-otherwise"

// What the program itself says: seat 1 holds the second guest pushed, seat 5 is past the end of the two-guest
// list so its read falls back to "empty", and `main` returns 0.
let TryOtherwiseStdout = "seat 1: Grace\nseat 5: empty\n"
let TryOtherwiseExitCode = 0

test 'the first-program try otherwise falls back past the end and exits 0'
	let run = try runDocumentProgram(TryOtherwiseDocument, marker: TryOtherwiseMarker, name: TryOtherwiseProgram)
	try requireAnswer(run, stdout: TryOtherwiseStdout, exitCode: TryOtherwiseExitCode)
end 'the first-program try otherwise falls back past the end and exits 0'
