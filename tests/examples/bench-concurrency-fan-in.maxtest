let FanInWorkload = "fan-in"
let FanInPerProducer = "100"

// What `bench/concurrency/fan-in/main.go`, the oracle, prints for the arguments above.
let FanInStdout = "fan-in 20476800\n"

test 'fan-in totals every value its producers sent to one sink'
	requireConcurrencyBenchmarkAnswer(FanInWorkload, arguments: [FanInPerProducer], stdout: FanInStdout)
end 'fan-in totals every value its producers sent to one sink'
