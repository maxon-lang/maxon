// nbody.test.maxon — `examples/nbody.maxon` builds.
//
// ⚠ BUILD ONLY. The example takes no argument and always runs the benchmark's full 50,000,000 steps, which
// does not fit a test file's deadline, and it prints each energy's shortest round-trip spelling where the
// Benchmarks Game's published output (`nbody-output.txt`, n=1000) prints 9 fixed decimals, so no published
// answer applies to it as written.

let NbodyExample = "nbody.maxon"

test 'nbody builds'
	try requireExampleBuild(NbodyExample)
end 'nbody builds'
