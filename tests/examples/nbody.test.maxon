// nbody.test.maxon — `examples/nbody.maxon` builds and computes the benchmark's energies before and after
// n steps.

let NbodyExample = "nbody.maxon"

// The Benchmarks Game's published reference output, `nbody-output.txt`, which is for n=1000.
let NbodyPublishedSteps = "1000"
let NbodyPublishedStdout = "-0.169075164\n-0.169087605\n"
let NbodyExitCode = 0

test 'nbody computes the published energies'
	let run = try runExample(NbodyExample, arguments: [NbodyPublishedSteps])
	try requireAnswer(run, stdout: NbodyPublishedStdout, exitCode: NbodyExitCode)
end 'nbody computes the published energies'
