let WorkerPoolWorkload = "worker-pool"
let WorkerPoolTaskCount = "16"
let WorkerPoolIterations = "1000"
// What `bench/concurrency/worker-pool/main.go`, the oracle, prints for the arguments above.
let WorkerPoolStdout = "worker-pool 35201228246\n"

test 'worker-pool sums the kernel results of every task'
	requireConcurrencyBenchmarkAnswer(WorkerPoolWorkload, arguments: [WorkerPoolTaskCount, WorkerPoolIterations], stdout: WorkerPoolStdout)
end 'worker-pool sums the kernel results of every task'
