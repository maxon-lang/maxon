let PingPongWorkload = "ping-pong"
let PingPongRoundTrips = "1000"

// What `bench/concurrency/ping-pong/main.go`, the oracle, prints for the arguments above.
let PingPongStdout = "ping-pong 500500\n"

test 'ping-pong sums the replies of its round trips'
	requireConcurrencyBenchmarkAnswer(PingPongWorkload, arguments: [PingPongRoundTrips], stdout: PingPongStdout)
end 'ping-pong sums the replies of its round trips'
