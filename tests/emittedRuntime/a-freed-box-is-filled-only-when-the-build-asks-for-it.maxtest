let AFreedBoxIsFilledOnlyWhenTheBuildAsksForItCaseLabel = "freed-box-fill"

let BoxFreeName = "__mm_free_slow"
let FreedBoxDoorName = "__slab_free_box"
let PlainFreeName = "__slab_free_tracked"

let BranchLinkPrefix = "arm64.bl "
let TailBranchPrefix = "arm64.tailBranch "
let FillMnemonic = "arm64.arm64MemFill 0x3f"
let AbsentFunctionPhrase = "this program contains nothing named "

let FillReason = "A freed managed box is filled with 0x3F only by a build that asks for it with the poison option. Every other build frees a box through the plain slab free without writing to it, so the fill costs nothing there; a build that asks must route `__mm_free` through the door that fills, whose body writes the fill byte."

test 'a freed box is filled only when the build asks for it'
	let staged = stagedFixtureTree(FixturesDirName, stagingRootDir: StagingRootDirName, caseLabel: AFreedBoxIsFilledOnlyWhenTheBuildAsksForItCaseLabel, fixture: HeapFixtureName)

	var findings = StringArray.create(0)
	noteUnpoisoned(findings, staged: staged, target: MacosTargetName)
	noteUnpoisoned(findings, staged: staged, target: LinuxTargetName)
	notePoisoned(findings, staged: staged, target: MacosTargetName)
	notePoisoned(findings, staged: staged, target: LinuxTargetName)

	Expect.isTrue(findings.isEmpty(), message: "the freed-box fill is not tied to the build option:{renderedFindings(findings)}\n\n  {FillReason}")
end 'a freed box is filled only when the build asks for it'

function noteUnpoisoned(findings StringArray, staged FilePath, target String)
	let label = "{AFreedBoxIsFilledOnlyWhenTheBuildAsksForItCaseLabel}-default"
	let body = functionBody(irLines(buildStagedProgram(staged, caseLabel: label, target: target, functionName: BoxFreeName)), functionName: BoxFreeName, target: target)

	if callsOrTailBranchesTo(body, name: PlainFreeName) != 1 'noPlainFree'
		findings.push("on {target}, a default build's `{BoxFreeName}` does not call `{PlainFreeName}` exactly once")
	end 'noPlainFree'

	if callsOrTailBranchesTo(body, name: FreedBoxDoorName) != 0 'callsTheFillingDoor'
		findings.push("on {target}, a default build's `{BoxFreeName}` calls `{FreedBoxDoorName}`, which fills the freed box")
	end 'callsTheFillingDoor'

	var extra = StringArray.create(0)
	extra.push("{TargetOptionPrefix}{target}")
	extra.push("{EmitIrRuntimeOptionPrefix}{FreedBoxDoorName}")

	let build = spawnBuild(staged.join(StagedProgramFileName), staged: staged, output: staged.join("{OutputFileStem}-{label}-door-{target}"), label: label, extraArguments: extra)

	if build.exitCode() == 0 'builtTheDoor'
		findings.push("on {target}, a default build carries `{FreedBoxDoorName}`")
	end 'builtTheDoor' else if not "{build.stdout}{build.stderr}".contains("{AbsentFunctionPhrase}'{FreedBoxDoorName}'") 'refusedForAnotherReason'
		findings.push("on {target}, a default build refused `{EmitIrRuntimeOptionPrefix}{FreedBoxDoorName}` without saying the program contains nothing named it. It said: {oneLine(build.stdout)}{oneLine(build.stderr)}")
	end 'refusedForAnotherReason'
end 'noteUnpoisoned'

function notePoisoned(findings StringArray, staged FilePath, target String)
	let label = "{AFreedBoxIsFilledOnlyWhenTheBuildAsksForItCaseLabel}-poisoned"
	let lines = irLines(buildStagedProgram(staged, caseLabel: label, target: target, functionName: "{BoxFreeName}{EmittedNameSeparator}{FreedBoxDoorName}", poisonFreed: true))
	let freeBody = functionBody(lines, functionName: BoxFreeName, target: target)
	let doorBody = functionBody(lines, functionName: FreedBoxDoorName, target: target)

	if callsOrTailBranchesTo(freeBody, name: FreedBoxDoorName) != 1 'noFillingDoor'
		findings.push("on {target}, a {PoisonFreedOption} build's `{BoxFreeName}` does not call `{FreedBoxDoorName}` exactly once")
	end 'noFillingDoor'

	if bodyLineCount(doorBody, startingWith: FillMnemonic, containing: "", endingWith: "") != 1 'noFill'
		findings.push("on {target}, a {PoisonFreedOption} build's `{FreedBoxDoorName}` does not hold exactly one `{FillMnemonic}`")
	end 'noFill'
end 'notePoisoned'

function callsOrTailBranchesTo(body StringArray, name String) returns LineTally
	return bodyLineCount(body, startingWith: BranchLinkPrefix, containing: "", endingWith: " {name}") + bodyLineCount(body, startingWith: TailBranchPrefix, containing: "", endingWith: " {name}")
end 'callsOrTailBranchesTo'
