let CaseLabel = "macos-trust-store-imports"
let TrustStoreFixtureName = "trust-store"

let CarriedSymbols = ["_SecTrustSettingsCopyCertificates", "_SecTrustSettingsCopyTrustSettings", "_SecPolicyCopyProperties", "_CFDictionaryGetValueIfPresent", "_CFDictionaryContainsKey", "_CFNumberGetValue", "_CFEqual", "_CFStringCreateWithCString", "_dlsym", "_SecCertificateCopyData", "_CFRelease"]
let DroppedSymbols = ["_SecTrustCopyAnchorCertificates"]

let WalkReason = "Go's darwin root walk reads every trust-settings domain (system, admin, user) through SecTrustSettingsCopyCertificates and decides each certificate in the admin and user domains from its SSL trust settings, so a program that reads the store has to import the calls that make those two decisions. SecTrustCopyAnchorCertificates answers the system anchors alone."

test 'a macOS image that reads the trust store imports the trust-settings walk and no anchor-only call'
	let staged = stagedFixtureTree(FixturesDirName, stagingRootDir: StagingRootDirName, caseLabel: CaseLabel, fixture: TrustStoreFixtureName)
	let image = fileBytes(buildMacosImage(staged, label: CaseLabel))

	Expect.greaterThan(image.count(), than: 0, message: "the {MacosTargetName} build wrote an EMPTY file, so nothing read out of it means anything.")

	var findings = StringArray.create()

	for symbol in CarriedSymbols 'eachCarried'
		noteImageName(findings, image: image, name: symbol, present: true, why: WalkReason)
	end 'eachCarried'

	for symbol in DroppedSymbols 'eachDropped'
		noteImageName(findings, image: image, name: symbol, present: false, why: WalkReason)
	end 'eachDropped'

	Expect.isTrue(findings.isEmpty(), message: "the {MacosTargetName} image of a program that reads the trust store does not import the trust-settings walk:{renderedFindings(findings)}")
end 'a macOS image that reads the trust store imports the trust-settings walk and no anchor-only call'
