let FixturesDirName = "tests/emittedRuntime/fixtures"
let SpawnFixtureName = "spawn"
let PinnedMachineFixtureName = "pinned-machine"
let HeapFixtureName = "heap"
let PinnedMachineBlockedFixtureName = "pinned-machine-blocked"
let ClampedProcessorsFixtureName = "clamped-processors"
let CensusDuringRelistsFixtureName = "census-during-relists"
let CensusDuringScavengeFixtureName = "census-during-scavenge"
let CensusDuringRemoteFreesFixtureName = "census-during-remote-frees"
let ShallowFaultFixtureName = "shallow-fault"

let TargetOptionPrefix = "--target="
let EmitIrFunctionOptionPrefix = "--emit-ir-function="
let DebugStreamOption = "--debugstream"
let PoisonFreedOption = "--poison-freed"
let EmittedNameSeparator = ","
let IrFileSuffix = ".ir"

let MacosTargetName = "arm64-macos"
let LinuxTargetName = "arm64-linux"
let X64LinuxTargetName = "x64-linux"
let X64WindowsTargetName = "x64-windows"

let PinDestructName = "__gt_pin_destruct"
let SchedulerInitName = "__gt_init"
let SchedulerInitRole = "the green-thread scheduler's bring-up"
let AbsentFunctionPhrase = "this program contains nothing named "
let AbsenceLabelInfix = "-absent"
let PresenceLabelInfix = "-present"
let EmptyHolderArrayLine = "0"

let X64RegisterCallPrefix = "{X64OpPrefix}callReg "
let X64MemoryCallPrefix = "{X64OpPrefix}callMem "
let X64ImportCallPrefix = "{X64OpPrefix}iatCall "
let X64TailJumpPrefix = "{X64OpPrefix}tailJmp "
let X64SyscallPrefix = "{X64OpPrefix}x64Syscall "
let X64IndirectReturnLine = "{X64OpPrefix}retIndirect"
let Arm64RegisterCallPrefix = "{Arm64OpPrefix}blr "
let Arm64ImportCallPrefix = "{Arm64OpPrefix}importCall "
let Arm64TailBranchPrefix = "{Arm64OpPrefix}tailBranch "
let Arm64SyscallPrefix = "{Arm64OpPrefix}syscall "
let Arm64IndirectReturnLine = "{Arm64OpPrefix}retIndirect"

let FunctionHeaderSuffix = " \{"
let FunctionBodyEndLine = "\}"

let PlainLoadPrefix = "arm64.loadRegBaseDisp.word64 "
let PlainStorePrefix = "arm64.storeBaseDispReg.word64 "
let AcquireLoadMnemonic = "arm64.ldar.word64"
let ReleaseStoreMnemonic = "arm64.stlr.word64"
let AtomicClaimMnemonic = "arm64.arm64AtomicCas"
let RegisterMoveMnemonic = "movRegReg "
let RegisterMovePrefix = "{Arm64OpPrefix}{RegisterMoveMnemonic}"
let GlobalAddressPrefix = "arm64.leaGlobal "
let ArgumentSeparator = ", "
let NoFurtherDemand = ""
let WordSeparator = " "
let OperandSeparator = ","
let LineSeparator = "\n"
let DisplacedAddressInfix = " + "
let DestinationWordIndex = 1
let CopySourceIndex = 1

typealias ProcessorCount = int(1 to 1024)

typealias FieldOffset = int(0 to 65535)
typealias LineIndex = int(0 to u64.max)
typealias LineTally = int(0 to u64.max)
typealias AccessTally = int(0 to 65535)

enum IrScanError implements Error
	noSuchLine
	noDestinationRegister
end 'IrScanError'

enum RegisterUse
	plainLoad
	plainStore
	acquireLoad
	releaseStore
	atomicClaim
	otherAccess
	copiedOut
	untouched
end 'RegisterUse'

type RegisterEvent
	export let use as RegisterUse
	export let overwrites as bool
	export let line as String
	export let index as LineIndex

	static function create(use RegisterUse, overwrites bool, line String, index LineIndex) returns RegisterEvent
		return Self{use: use, overwrites: overwrites, line: line, index: index}
	end 'create'
end 'RegisterEvent'

typealias RegisterEventArray = Array with RegisterEvent

type WordAccesses
	export var plainLoads as StringArray
	export var plainStores as StringArray
	export var acquires as AccessTally
	export var releases as AccessTally

	static function create() returns Self
		return Self{plainLoads: StringArray.create(0), plainStores: StringArray.create(0), acquires: 0, releases: 0}
	end 'create'

	export function record(line String, register String, target String, functionName String, word String)
		match registerUseIn(line, register: register) 'use'
			plainLoad then self.plainLoads.push(line)
			plainStore then self.plainStores.push(line)
			acquireLoad then self.acquires = self.acquires + 1
			releaseStore then self.releases = self.releases + 1
			atomicClaim then self.claimAccess()

			otherAccess or
			copiedOut or
			untouched then panic("emitted-runtime tests: the gate could not run — on {target}, `{functionName}` reaches {word} through `{register}` with `{line}`, which is none of the five shapes this case can read: `{PlainStorePrefix.trim()}`, `{PlainLoadPrefix.trim()}`, `{ReleaseStoreMnemonic}`, `{AcquireLoadMnemonic}` or `{AtomicClaimMnemonic}` through that register. An access this case cannot classify would satisfy every absence demand by being none of them.")
		end 'use'
	end 'record'

	function claimAccess()
		self.acquires = self.acquires + 1
		self.releases = self.releases + 1
	end 'claimAccess'
end 'WordAccesses'

function buildStagedProgram(staged FilePath, caseLabel String, target String, functionName String, debugStream bool = false, poisonFreed bool = false, libraryTier bool = false) returns FilePath
	let ir = stagedIrPath(staged, caseLabel: caseLabel, target: target)
	let build = spawnStagedIrBuild(staged, caseLabel: caseLabel, target: target, functionName: functionName, debugStream: debugStream, poisonFreed: poisonFreed, libraryTier: libraryTier)

	requireBuiltOrPanic(build, output: ir, what: "{stagedIrBuildSpelling(target, functionName: functionName)}, which writes the Target IR to read,")

	return ir
end 'buildStagedProgram'

function stagedIrPath(staged FilePath, caseLabel String, target String) returns FilePath
	return staged.join("{OutputFileStem}-{caseLabel}-{target}{IrFileSuffix}")
end 'stagedIrPath'

function stagedIrBuildSpelling(target String, functionName String) returns String
	return "`{BuildCommandName} … {TargetOptionPrefix}{target} {EmitIrFunctionOptionPrefix}{functionName}`"
end 'stagedIrBuildSpelling'

function spawnStagedIrBuild(staged FilePath, caseLabel String, target String, functionName String, debugStream bool = false, poisonFreed bool = false, libraryTier bool = false) returns CollectedOutput
	let executable = staged.join("{OutputFileStem}-{caseLabel}-{target}")

	let extraArguments = StringArray.create(0)
	extraArguments.push("{TargetOptionPrefix}{target}")
	extraArguments.push("{EmitIrFunctionOptionPrefix}{functionName}")

	if debugStream 'withTheProducer'
		extraArguments.push(DebugStreamOption)
	end 'withTheProducer'

	if poisonFreed 'withTheFill'
		extraArguments.push(PoisonFreedOption)
	end 'withTheFill'

	if libraryTier 'asLibraryTier'
		return spawnBuild(staged.join(libraryTierProgramFile()), staged: staged, output: executable, label: caseLabel, extraArguments: extraArguments, binary: stagedTierCompilerPath(staged))
	end 'asLibraryTier'

	return spawnBuild(staged.join(StagedProgramFileName), staged: staged, output: executable, label: caseLabel, extraArguments: extraArguments)
end 'spawnStagedIrBuild'

function stagedTierCompilerPath(staged FilePath) returns FilePath
	return staged.join(LibraryTierDirName).join(StagedTierBinDirName).join(testedCompilerPath().filename())
end 'stagedTierCompilerPath'

function noteFunctionAbsent(findings StringArray, staged FilePath, caseLabel String, target String, functionName String, carrier String, role String, libraryTier bool = false)
	if functionIsLaidOut(staged, caseLabel: "{caseLabel}{AbsenceLabelInfix}{functionName}", target: target, functionName: functionName, carrier: carrier, libraryTier: libraryTier) 'laidOut'
		findings.push("on {target}, {carrier} carries `{functionName}`, {role}")
	end 'laidOut'
end 'noteFunctionAbsent'

function noteFunctionLaidOut(findings StringArray, staged FilePath, caseLabel String, target String, functionName String, carrier String, role String)
	if not functionIsLaidOut(staged, caseLabel: "{caseLabel}{PresenceLabelInfix}{functionName}", target: target, functionName: functionName, carrier: carrier) 'absent'
		findings.push("on {target}, {carrier} carries no `{functionName}`, {role}")
	end 'absent'
end 'noteFunctionLaidOut'

function functionIsLaidOut(staged FilePath, caseLabel String, target String, functionName String, carrier String, libraryTier bool = false) returns bool
	let build = spawnStagedIrBuild(staged, caseLabel: caseLabel, target: target, functionName: functionName, libraryTier: libraryTier)

	if build.exitCode() == 0 'laidOut'
		return true
	end 'laidOut'

	if not "{build.stdout}{build.stderr}".contains("{AbsentFunctionPhrase}'{functionName}'") 'anotherRefusal'
		panic("emitted-runtime tests: the gate could not run — {stagedIrBuildSpelling(target, functionName: functionName)} for {carrier} exited {build.exitCode()} without saying the program contains nothing named `{functionName}`: {oneLine(build.stdout)} {oneLine(build.stderr)}")
	end 'anotherRefusal'

	return false
end 'functionIsLaidOut'

function everyNativeTargetName() returns StringArray
	return [MacosTargetName, LinuxTargetName, X64LinuxTargetName, X64WindowsTargetName]
end 'everyNativeTargetName'

function noteHolderArrayRunsWithNoScheduler(findings StringArray, staged FilePath, caseLabel String, carrier String) throws TestFailure
	let run = runStagedForHost(builtExecutable(staged), staged: staged, procs: SoleProcessor, deadlineMs: RunDeadline, standardInput: InputSource.none)

	try Expect.equal(run.exitCode(), expected: 0, message: "{carrier} exited {run.exitCode()}; stderr: {run.stderr}")
	try Expect.equal(oneLine(run.stdout), expected: EmptyHolderArrayLine, message: "{carrier} said `{oneLine(run.stdout)}` where it says `{EmptyHolderArrayLine}` for its empty array")

	for target in everyNativeTargetName() 'eachTarget'
		noteFunctionAbsent(findings, staged: staged, caseLabel: caseLabel, target: target, functionName: SchedulerInitName, carrier: carrier, role: SchedulerInitRole, libraryTier: true)
	end 'eachTarget'
end 'noteHolderArrayRunsWithNoScheduler'

function controlTransferPrefixes() returns StringArray
	return [X64DirectCallPrefix, X64RegisterCallPrefix, X64MemoryCallPrefix, X64ImportCallPrefix, X64TailJumpPrefix, X64SyscallPrefix, X64IndirectReturnLine, Arm64DirectCallPrefix, Arm64RegisterCallPrefix, Arm64ImportCallPrefix, Arm64TailBranchPrefix, Arm64SyscallPrefix, Arm64IndirectReturnLine]
end 'controlTransferPrefixes'

function callsOrTailBranchesTo(body StringArray, name String) returns LineTally
	var found = 0 as LineTally

	for prefix in controlTransferPrefixes() 'eachTransfer'
		found = found + bodyLineCount(body, startingWith: prefix, containing: NoFurtherDemand, endingWith: " {name}")
	end 'eachTransfer'

	return found
end 'callsOrTailBranchesTo'

function firstControlTransfer(body StringArray) returns LineIndex throws IrScanError
	let prefixes = controlTransferPrefixes()

	for (iter, text) in body.withIterator() 'eachLine'
		for prefix in prefixes 'eachTransfer'
			if text.startsWith(prefix) 'aTransfer'
				return iter.index()
			end 'aTransfer'
		end 'eachTransfer'
	end 'eachLine'

	throw IrScanError.noSuchLine
end 'firstControlTransfer'

function buildStagedForHost(staged FilePath, caseLabel String) returns FilePath
	let executable = staged.join("{OutputFileStem}-{caseLabel}{executableSuffix()}")

	let build = spawnBuild(staged.join(StagedProgramFileName), staged: staged, output: executable, label: caseLabel, extraArguments: StringArray.create(0))

	requireBuiltOrPanic(build, output: executable, what: "`{BuildCommandName} {StagedProgramFileName}` for the host")

	return executable
end 'buildStagedForHost'

function environmentWithProcessors(procs ProcessorCount) returns Environment
	let overrides = EnvMap.create()
	try overrides.insert(MaxProcsVariableName, value: "{procs}") otherwise panic("emitted-runtime tests: the gate could not run — could not name {MaxProcsVariableName} in the child's environment.")

	return Environment.inheritUpdating(overrides)
end 'environmentWithProcessors'

function runStagedForHost(executable FilePath, staged FilePath, procs ProcessorCount, deadlineMs WaitDeadlineMs, standardInput InputSource) returns CollectedOutput
	return spawnIn(Executable.path(executable), arguments: StringArray.create(0), staged: staged, what: "the staged program at {executable.toString()}", environment: environmentWithProcessors(procs), standardInput: standardInput, deadline: WaitDeadline.within(deadlineMs))
end 'runStagedForHost'

function runStagedFedAfterLine(executable FilePath, staged FilePath, procs ProcessorCount, deadlineMs WaitDeadlineMs, afterLine String, feed String) returns FedRun
	return runFedAfterLine(executable, workingDirectory: staged, environment: environmentWithProcessors(procs), deadlineMs: deadlineMs, afterLine: afterLine, feed: feed)
end 'runStagedFedAfterLine'

function irLines(path FilePath) returns StringArray
	return fileText(path).split(LineSeparator)
end 'irLines'

function functionBody(lines StringArray, functionName String, target String) returns StringArray
	let header = "{functionHeader(functionName)}{FunctionHeaderSuffix}"
	let body = StringArray.create(0)
	var found = false

	for line in lines 'eachLine'
		let text = line.trim()

		if not found 'beforeTheFunction'
			found = text == header
			continue
		end 'beforeTheFunction'

		if text == FunctionBodyEndLine 'theEnd'
			break
		end 'theEnd'

		body.push(text)
	end 'eachLine'

	if not found 'neverRendered'
		panic("emitted-runtime tests: the gate could not run — the {target} Target IR holds no `{header}`, so that runtime body was never rendered. `{EmitIrFunctionOptionPrefix}{functionName}` is what opts a withheld runtime body into that text, and a name nothing emits is refused rather than skipped.")
	end 'neverRendered'

	if body.isEmpty() 'renderedEmpty'
		panic("emitted-runtime tests: the gate could not run — the {target} Target IR renders `{functionName}` with an EMPTY body, and an empty body satisfies every absence demand a case makes by holding nothing at all.")
	end 'renderedEmpty'

	return body
end 'functionBody'

function bodyLineCount(body StringArray, startingWith String, containing String, endingWith String) returns LineTally
	var found = 0 as LineTally

	for text in body 'eachLine'
		if lineMatches(text, startingWith: startingWith, containing: containing, endingWith: endingWith) 'theLine'
			found = found + 1
		end 'theLine'
	end 'eachLine'

	return found
end 'bodyLineCount'

function firstLineIndex(body StringArray, startingWith String, containing String, endingWith String) returns LineIndex throws IrScanError
	for (iter, text) in body.withIterator() 'eachLine'
		if lineMatches(text, startingWith: startingWith, containing: containing, endingWith: endingWith) 'theLine'
			return iter.index()
		end 'theLine'
	end 'eachLine'

	throw IrScanError.noSuchLine
end 'firstLineIndex'

// Every line that touches `register`, in body order, carrying TWO facts about each: what the line does
// through the register, and whether it overwrites it. `ldr x1, [x1 + 48]` is both, and an event that had to
// pick one would hide the other from whichever caller wanted it.
function registerEvents(body StringArray, register String) returns RegisterEventArray
	let events = RegisterEventArray.create(0)

	for (iter, text) in body.withIterator() 'eachLine'
		let use = registerUseIn(text, register: register)
		let overwrites = writesRegister(text, register: register)

		if use == RegisterUse.untouched and not overwrites 'anotherLine'
			continue
		end 'anotherLine'

		events.push(RegisterEvent.create(use, overwrites: overwrites, line: text, index: iter.index() as LineIndex))
	end 'eachLine'

	return events
end 'registerEvents'

function registerUseIn(text String, register String) returns RegisterUse
	if text.startsWith(RegisterMovePrefix) and text.endsWith("{ArgumentSeparator}{register}") 'aCopy'
		return RegisterUse.copiedOut
	end 'aCopy'

	if not text.contains("[{register}{DisplacedAddressInfix}") and not text.contains("[{register}]") 'untouched'
		return RegisterUse.untouched
	end 'untouched'

	if text.startsWith(PlainLoadPrefix) 'aPlainLoad'
		return RegisterUse.plainLoad
	end 'aPlainLoad'

	if text.startsWith(PlainStorePrefix) 'aPlainStore'
		return RegisterUse.plainStore
	end 'aPlainStore'

	if text.startsWith(AcquireLoadMnemonic) 'anAcquireLoad'
		return RegisterUse.acquireLoad
	end 'anAcquireLoad'

	if text.startsWith(ReleaseStoreMnemonic) 'aReleaseStore'
		return RegisterUse.releaseStore
	end 'aReleaseStore'

	if text.startsWith(AtomicClaimMnemonic) 'anAtomicClaim'
		return RegisterUse.atomicClaim
	end 'anAtomicClaim'

	return RegisterUse.otherAccess
end 'registerUseIn'

function writesRegister(text String, register String) returns bool
	let written = try destinationRegisterOf(text) otherwise return false

	return written == register
end 'writesRegister'

function firstWriteOfRegister(body StringArray, register String) returns LineIndex throws IrScanError
	for event in registerEvents(body, register: register) 'eachEvent'
		if event.overwrites 'theWrite'
			return event.index
		end 'theWrite'
	end 'eachEvent'

	throw IrScanError.noSuchLine
end 'firstWriteOfRegister'

function copySourceRegisterOf(text String, isa String) returns String throws IrScanError
	if not text.startsWith("{isa}{RegisterMoveMnemonic}") 'notACopy'
		throw IrScanError.noSuchLine
	end 'notACopy'

	return try text.split(ArgumentSeparator).get(CopySourceIndex) otherwise throw IrScanError.noSuchLine
end 'copySourceRegisterOf'

function lastWriteBefore(body StringArray, register String, site LineIndex) returns RegisterEvent throws IrScanError
	let found = RegisterEventArray.create(0)

	for event in registerEvents(body, register: register) 'eachEvent'
		if event.index >= site 'atOrAfterTheSite'
			break
		end 'atOrAfterTheSite'

		if event.overwrites 'aWrite'
			found.push(event)
		end 'aWrite'
	end 'eachEvent'

	return try found.last() otherwise throw IrScanError.noSuchLine
end 'lastWriteBefore'

function registerHoldingArgument(body StringArray, argument String) returns String throws IrScanError
	for event in registerEvents(body, register: argument) 'eachEvent'
		if event.use != RegisterUse.copiedOut 'notACopy'
			continue
		end 'notACopy'

		return try destinationRegisterOf(event.line)
	end 'eachEvent'

	throw IrScanError.noSuchLine
end 'registerHoldingArgument'

function accessThrough(body StringArray, site LineIndex, register String) returns RegisterEvent throws IrScanError
	for event in registerEvents(body, register: register) 'eachEvent'
		if event.index <= site 'atOrBeforeTheMaterialisation'
			continue
		end 'atOrBeforeTheMaterialisation'

		if event.use == RegisterUse.copiedOut 'carriedElsewhere'
			continue
		end 'carriedElsewhere'

		if event.use == RegisterUse.untouched 'overwritten'
			throw IrScanError.noSuchLine
		end 'overwritten'

		return event
	end 'eachEvent'

	throw IrScanError.noSuchLine
end 'accessThrough'

function notePlainFieldLoad(findings StringArray, body StringArray, target String, register String, offset FieldOffset, functionName String, field String)
	let addressed = "[{register} + {offset}]"
	let index = try firstLineIndex(body, startingWith: PlainLoadPrefix, containing: addressed, endingWith: NoFurtherDemand) otherwise return

	findings.push("on {target}, `{functionName}` still reads {field} with a plain load — `{lineAt(body, index: index)}`")
end 'notePlainFieldLoad'

function oneLine(raw String) returns String
	return withoutCarriageReturns(raw).replace("\n", with: " ").trim()
end 'oneLine'

function lineMatches(text String, startingWith String, containing String, endingWith String) returns bool
	if not text.startsWith(startingWith) 'anotherOp'
		return false
	end 'anotherOp'

	if not containing.isEmpty() and not text.contains(containing) 'anotherOperand'
		return false
	end 'anotherOperand'

	return endingWith.isEmpty() or text.endsWith(endingWith)
end 'lineMatches'

function lineAt(body StringArray, index LineIndex) returns String
	return try body.get(index as ElementIndex) otherwise panic("emitted-runtime tests: the gate could not run — line {index} was read out of a body of {body.count()} lines, and every line a case reads is one a scan of that same body found or the one after it, which a function body always holds.")
end 'lineAt'

// The destination is read off the line's own second word rather than off a roster of the ops that write, so
// a line that merely CARRIES the register there — a compare — reads as a write. That is the direction that
// costs a caller a refusal rather than a pass it did not earn.
function destinationRegisterOf(text String) returns String throws IrScanError
	let spelled = try text.split(WordSeparator).get(DestinationWordIndex) otherwise throw IrScanError.noDestinationRegister

	return try spelled.split(OperandSeparator).get(0) otherwise throw IrScanError.noDestinationRegister
end 'destinationRegisterOf'

function buildStagedImage(staged FilePath, label String, target String) returns FilePath
	let image = staged.join("{OutputFileStem}-{label}-{target}")
	let build = spawnBuild(staged.join(StagedProgramFileName), staged: staged, output: image, label: label, extraArguments: ["{TargetOptionPrefix}{target}"])

	requireBuiltOrPanic(build, output: image, what: "`{BuildCommandName} … {TargetOptionPrefix}{target}`, which emits the image to read,")

	return image
end 'buildStagedImage'

function noteImageName(findings StringArray, image ByteArray, target String, name String, present bool, why String)
	if image.containsSequence(asciiBytes(name)) == present 'asDemanded'
		return
	end 'asDemanded'

	let demand = "must carry" if present else "must NOT carry"
	let observed = "the name is nowhere in the image" if present else "the name is in the image"

	findings.push("the {target} image {demand} `{name}`, and {observed}. {why}")
end 'noteImageName'

function asciiBytes(name String) returns ByteArray
	let bytes = ByteArray.create(0)

	for octet in name.bytes() 'eachByte'
		bytes.push(octet)
	end 'eachByte'

	return bytes
end 'asciiBytes'

let RunDeadline = 30000 as WaitDeadlineMs
let SoleProcessor = 1
let TwoProcessors = 2
let FourProcessors = 4
