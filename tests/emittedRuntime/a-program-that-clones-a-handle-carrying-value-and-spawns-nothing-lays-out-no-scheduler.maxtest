let AProgramThatClonesAHandleCarryingValueAndSpawnsNothingLaysOutNoSchedulerCaseLabel = "handle-clone-array"

let HandleCloneArrayFixtureName = "handle-clone-array"
let AProgramThatClonesAHandleCarryingValueAndSpawnsNothingLaysOutNoSchedulerCarrier = "a program that clones an array of service handles and spawns nothing"

let AProgramThatClonesAHandleCarryingValueAndSpawnsNothingLaysOutNoSchedulerReason = "Cloning an array of service handles names the handle's clone, but only a spawn can make a handle, so a program that never spawns has none to clone. Naming a handle's clone or close never installs the scheduler: the scheduler is installed only for a program that spawns, on any target."

test 'a program that clones a handle-carrying value and spawns nothing lays out no scheduler'
	let staged = builtLibraryTierFixture(FixturesDirName, caseLabel: AProgramThatClonesAHandleCarryingValueAndSpawnsNothingLaysOutNoSchedulerCaseLabel, fixture: HandleCloneArrayFixtureName)

	let findings = StringArray.create(0)
	noteHolderArrayRunsWithNoScheduler(findings, staged: staged, caseLabel: AProgramThatClonesAHandleCarryingValueAndSpawnsNothingLaysOutNoSchedulerCaseLabel, carrier: AProgramThatClonesAHandleCarryingValueAndSpawnsNothingLaysOutNoSchedulerCarrier)

	Expect.isTrue(findings.isEmpty(), message: "a program that clones a handle-carrying value and spawns nothing laid out a scheduler:{renderedFindings(findings)}\n\n  {AProgramThatClonesAHandleCarryingValueAndSpawnsNothingLaysOutNoSchedulerReason}")

	discardStagedDir(staged)
end 'a program that clones a handle-carrying value and spawns nothing lays out no scheduler'
