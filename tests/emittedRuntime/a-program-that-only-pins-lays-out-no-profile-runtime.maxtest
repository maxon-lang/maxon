let AProgramThatOnlyPinsLaysOutNoProfileRuntimeCaseLabel = "pin-only"

let ProfileCloseName = "__prof_close"
let ProfileCloseRole = "the profiler's host-handle close"
let AProgramThatOnlyPinsLaysOutNoProfileRuntimeCarrier = "a program that only pins"
let PinOnlyFixtureName = "pin-only"
let HeldLine = "held true"
let AProgramThatOnlyPinsLaysOutNoProfileRuntimeRunDeadline = 30000

let AProgramThatOnlyPinsLaysOutNoProfileRuntimePinReason = "A machine pin is a green-thread object: the destructor that unpins it is in the scheduler's runtime band and its facility is the green-thread floor. A program that only pins must not install the profiler's runtime, whose host-handle close serves processes it samples and has no business in a program that never samples one."

test 'a program that only pins lays out the pin destructor and no profile runtime'
	let staged = stagedFixtureTree(FixturesDirName, caseLabel: AProgramThatOnlyPinsLaysOutNoProfileRuntimeCaseLabel, fixture: PinOnlyFixtureName)
	let executable = buildStagedForHost(staged, caseLabel: AProgramThatOnlyPinsLaysOutNoProfileRuntimeCaseLabel)
	let run = runStagedForHost(executable, staged: staged, procs: SoleProcessor, deadlineMs: AProgramThatOnlyPinsLaysOutNoProfileRuntimeRunDeadline, standardInput: InputSource.none)

	Expect.equal(run.exitCode(), expected: 0, message: "the pin-only program exited {run.exitCode()}; stderr: {run.stderr}")
	Expect.isTrue(run.stdout.contains(HeldLine), message: "the pin-only program said `{oneLine(run.stdout)}` where it says `{HeldLine}` when its pin was taken")

	let findings = StringArray.create(0)
	notePinDestructor(findings, staged: staged, target: MacosTargetName)
	notePinDestructor(findings, staged: staged, target: LinuxTargetName)
	noteFunctionAbsent(findings, staged: staged, caseLabel: AProgramThatOnlyPinsLaysOutNoProfileRuntimeCaseLabel, target: MacosTargetName, functionName: ProfileCloseName, carrier: AProgramThatOnlyPinsLaysOutNoProfileRuntimeCarrier, role: ProfileCloseRole)
	noteFunctionAbsent(findings, staged: staged, caseLabel: AProgramThatOnlyPinsLaysOutNoProfileRuntimeCaseLabel, target: LinuxTargetName, functionName: ProfileCloseName, carrier: AProgramThatOnlyPinsLaysOutNoProfileRuntimeCarrier, role: ProfileCloseRole)

	Expect.isTrue(findings.isEmpty(), message: "a program that only pins did not lay out the runtime a pin needs and nothing else:{renderedFindings(findings)}\n\n  {AProgramThatOnlyPinsLaysOutNoProfileRuntimePinReason}")

	discardStagedDir(staged)
end 'a program that only pins lays out the pin destructor and no profile runtime'

function notePinDestructor(findings StringArray, staged FilePath, target String)
	let body = functionBody(irLines(buildStagedProgram(staged, caseLabel: AProgramThatOnlyPinsLaysOutNoProfileRuntimeCaseLabel, target: target, functionName: PinDestructName)), functionName: PinDestructName, target: target)

	if body.isEmpty() 'empty'
		findings.push("on {target}, the emitted `{PinDestructName}` is empty")
	end 'empty'
end 'notePinDestructor'
