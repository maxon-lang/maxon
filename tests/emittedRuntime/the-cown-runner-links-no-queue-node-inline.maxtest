let TheCownRunnerLinksNoQueueNodeCaseLabel = "cown-runner"

let RunnerFixtureName = "cown"
let RunnerFunctionName = "__cown_run"
let EnqueueFinishFunctionName = "__cown_enqueue_finish"
let RenderedFunctionNames = "{RunnerFunctionName}{EmittedNameSeparator}{EnqueueFinishFunctionName}"

let TheCownRunnerLinksNoQueueNodeReason = "`__cown_run` is stoppable by asynchronous preemption, so it may not hold the window between a tail swap and the store that links the old tail to the new node: a multi-cown release that lost its own CAS spins on that link with no way to yield. Its finish claim publishes through `__cown_enqueue_finish`, which is not stoppable. A release store (`stlr`) in `__cown_run` is that link store inlined back."

test 'the cown runner links no queue node itself'
	let staged = stagedFixtureTree(FixturesDirName, caseLabel: TheCownRunnerLinksNoQueueNodeCaseLabel, fixture: RunnerFixtureName)

	let findings = StringArray.create(0)
	noteRunnerTarget(findings, staged: staged, target: MacosTargetName)
	noteRunnerTarget(findings, staged: staged, target: LinuxTargetName)

	Expect.isTrue(findings.isEmpty(), message: "the emitted `{RunnerFunctionName}` publishes a queue node itself:{renderedFindings(findings)}\n\n  {TheCownRunnerLinksNoQueueNodeReason}")

	discardStagedDir(staged)
end 'the cown runner links no queue node itself'

function noteRunnerTarget(findings StringArray, staged FilePath, target String)
	let lines = irLines(buildStagedProgram(staged, caseLabel: TheCownRunnerLinksNoQueueNodeCaseLabel, target: target, functionName: RenderedFunctionNames))
	let runner = functionBody(lines, functionName: RunnerFunctionName, target: target)
	let publisher = functionBody(lines, functionName: EnqueueFinishFunctionName, target: target)

	let runnerLinks = bodyLineCount(runner, startingWith: ReleaseStoreMnemonic, containing: NoFurtherDemand, endingWith: NoFurtherDemand)

	if runnerLinks != 0 'inlined'
		findings.push("on {target}, `{RunnerFunctionName}` carries {runnerLinks} `{ReleaseStoreMnemonic}` store(s)")
	end 'inlined'

	let publisherLinks = bodyLineCount(publisher, startingWith: ReleaseStoreMnemonic, containing: NoFurtherDemand, endingWith: NoFurtherDemand)

	if publisherLinks != 1 'notThePublisher'
		panic("emitted-runtime tests: the gate could not run — on {target}, `{EnqueueFinishFunctionName}` carries {publisherLinks} `{ReleaseStoreMnemonic}` store(s) where the one link store of a publisher is expected, so an absent link in `{RunnerFunctionName}` would mean nothing.")
	end 'notThePublisher'
end 'noteRunnerTarget'
