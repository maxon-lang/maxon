let AFedRunEndsAtItsChildsExitCaseLabel = "fed-held-pipe"

test 'a fed run returns within a bound when its child exits while a process it started holds its output, with all of that output'
	let staged = stagedHeldPipe(StagingRootDirName, caseLabel: AFedRunEndsAtItsChildsExitCaseLabel)
	let executable = buildStagedForHost(staged, caseLabel: AFedRunEndsAtItsChildsExitCaseLabel)

	let started = Clock.nowMs()
	let run = runStagedFedAfterLine(executable, staged: staged, procs: SoleProcessor, deadlineMs: RunDeadline, afterLine: HeldPipeOutputLine, feed: HeldPipeOutputLine)
	let tookMs = Clock.elapsedMs(started)

	endHeldPipeHolder(staged, forwarded: run.stdout)

	let missing = heldPipeLinesMissingFrom(run.stdout)

	match run.ending 'ending'
		exited(code) then Expect.equal(code, expected: HeldPipeExitStatus, message: "the program exited {code}; it said `{oneLine(run.stdout)}` on stdout and `{oneLine(run.stderr)}` on stderr")
		killedAtDeadline then Expect.fail("the program was still running at the {RunDeadline} ms deadline; it said `{oneLine(run.stdout)}` on stdout")
	end 'ending'

	Expect.isTrue(missing.isEmpty(), message: "the run did not collect these lines of the program's output: {listedLines(missing)}; it collected `{oneLine(run.stdout)}`")
	Expect.lessThan(tookMs, than: HeldPipePromptMs, message: "the run took {tookMs} ms to end a program that had already exited: it waited for a process the program started, which still holds the program's output")
end 'a fed run returns within a bound when its child exits while a process it started holds its output, with all of that output'
