let CaseLabel = "pinned-machine-blocked"

let RunDeadline = 30000 as DurationMs

let SoleProcessor = 1
let TwoProcessors = 2
let FourProcessors = 4

let FedLine = "go"
let RoundsDoneLine = "rounds done"

let StayedLine = "moved 0 of 20"
let WithinBudgetLine = "rounds ok"

let CaptureReason = "A pinned green thread's OWNER MACHINE may run nothing but that green thread. Its 20 parks are 10 ms each, so its rounds take about 200 ms — unless the owner M picks up an unrelated green thread that enters a LONG BLOCKING SYSCALL, and this program arranges exactly one: a reader sitting in `Console.stdin().readLine()`, which is `__con_read_stdin`, a synchronous `ReadFile` classed `SyscallClass.blocking` and held in the kernel until the test feeds it a line, which it does only once the pinned thread has printed `rounds done`. An owner captured that way cannot run its pinned thread at all: every other machine that finds the pinned thread refuses it, requeues it, hands the owner its processor and sleeps, so the pinned thread waits out the whole kernel call — and since nothing ends that call but the feed the pinned thread has yet to earn, the program never prints `rounds done` and is still running at the deadline. Go's answer is `stoplockedm` (`vendor/go/src/runtime/proc.go:3266-3288`), reached from the first three lines of `schedule()` (`proc.go:4158-4161`): a machine with a locked G hands its processor off and PARKS rather than searching, so it is never inside somebody else's syscall when its own thread becomes runnable, and `startlockedm` (`proc.go:3294-3308`) wakes it with a processor in its private slot."

test 'a pinned green thread runs while another sits in a blocking syscall'
	let staged = stagedFixtureTree(FixturesDirName, stagingRootDir: StagingRootDirName, caseLabel: CaseLabel, fixture: PinnedMachineBlockedFixtureName)
	let executable = buildStagedForHost(staged, caseLabel: CaseLabel)

	var findings = StringArray.create()

	noteCaptureRun(findings, executable: executable, staged: staged, procs: SoleProcessor)
	noteCaptureRun(findings, executable: executable, staged: staged, procs: TwoProcessors)
	noteCaptureRun(findings, executable: executable, staged: staged, procs: FourProcessors)

	Expect.isTrue(findings.isEmpty(), message: "a pinned green thread was starved by an unrelated green thread's blocking kernel call:{renderedFindings(findings)}\n\n  {CaptureReason}")
end 'a pinned green thread runs while another sits in a blocking syscall'

function noteCaptureRun(findings StringArray, executable FilePath, staged FilePath, procs ProcessorCount)
	let run = runStagedFedAfterLine(executable, staged: staged, procs: procs, deadlineMs: RunDeadline, afterLine: RoundsDoneLine, feed: FedLine)

	match run.ending 'ending'
		exited(code) then noteFinishedRun(findings, run: run, code: code, procs: procs)
		killedAtDeadline then findings.push("at {procs} processor(s) the program was still running at the {RunDeadline} ms deadline — it said `{oneLine(run.stdout)}` on stdout and `{oneLine(run.stderr)}` on stderr. Without `{RoundsDoneLine}` the pinned thread never finished its rounds, held behind the reader's kernel call that only the feed it has yet to earn can end; with it, the program was killed after the feed")
	end 'ending'
end 'noteCaptureRun'

function noteFinishedRun(findings StringArray, run FedRun, code ExitInt, procs ProcessorCount)
	if code != 0 'didNotSucceed'
		findings.push("at {procs} processor(s) the program exited {code} — it said `{oneLine(run.stdout)}` on stdout and `{oneLine(run.stderr)}` on stderr. A non-zero code is the program's own refusal")

		return
	end 'didNotSucceed'

	if not run.stdout.contains(StayedLine) 'movedMachine'
		findings.push("at {procs} processor(s) the program exited 0 and said `{oneLine(run.stdout)}` where it says `{StayedLine}` when every park gave the pinned thread back to the machine it pinned itself to")
	end 'movedMachine'

	if not run.stdout.contains(WithinBudgetLine) 'starved'
		findings.push("at {procs} processor(s) the program exited 0 and said `{oneLine(run.stdout)}` where it says `{WithinBudgetLine}` when the pinned thread's parks were not held behind the reader's kernel call — `rounds slow` is that starvation, and the figure beside it is how long 20 parks of 10 ms actually took")
	end 'starved'
end 'noteFinishedRun'
