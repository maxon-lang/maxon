let JoinedArmsCaseLabel = "sidecar-a-local-both-arms-assign-one-value-reads-it-after-the-join"

let JoinedArmsLocalName = "x"
let JoinedArmsValueName = "k"
let JoinedArmsHeldFunctionName = "blend"
let JoinedArmsHeldCalls = 2
let JoinedArmsFilled = 5
let JoinedArmsFactor = 7
let JoinedArmsTerm = 4
let JoinedArmsFirstValue = "1"

function joinedArmsAnswersAt(events JsonDocArray, line SourceLine) returns StringArray
	let answers = StringArray.create(0)
	var atTheLine = false

	for event in events 'eachEvent'
		if eventKind(event) == StopEventName 'aStop'
			atTheLine = numberOf(event, node: event.root, key: LineKey) == line as EventNumber
			continue
		end 'aStop'

		if atTheLine and eventKind(event) == ValueEventName 'itsAnswer'
			answers.push(printedAnswer(event))
			atTheLine = false
		end 'itsAnswer'
	end 'eachEvent'

	return answers
end 'joinedArmsAnswersAt'

test 'a local both arms of an if assign one value reads that value after the join, in a frame slot and in a register'
	let staged = builtFixture(JoinedArmsCaseLabel, fixture: JoinedArmsFixtureName)
	let program = staged.join(StagedProgramFileName)
	let executable = builtExecutable(staged)
	let beforeAt = anchorLine(program, anchor: "before")
	let afterAt = anchorLine(program, anchor: "after")
	let heldBeforeAt = anchorLine(program, anchor: "held-before")
	let heldAfterAt = anchorLine(program, anchor: "held-after")
	let functions = dumpedFunctionsSection(executable, staged: staged)
	let slotLocals = localRowsOf(functions, name: MainFunctionName)
	let heldLocals = localRowsOf(functions, name: JoinedArmsHeldFunctionName)
	let slotRows = rowsNamed(slotLocals, name: JoinedArmsLocalName)
	let heldRows = rowsNamed(heldLocals, name: JoinedArmsLocalName)
	var slotRowCount = 0 as Count

	for row in slotRows 'eachSlotRow'
		slotRowCount = slotRowCount + 1 if row.contains(StackSlotMark) else slotRowCount
	end 'eachSlotRow'

	Expect.notEqual(slotRowCount, expected: 0, message: "`{JoinedArmsLocalName}` has no stack-slot row in `{MainFunctionName}`, so this case no longer asks about a local in a FRAME SLOT. `{MainFunctionName}`'s locals were: {listedLines(slotLocals)}")
	Expect.notEqual(heldRows.count(), expected: 0, message: "`{JoinedArmsHeldFunctionName}` describes no `{JoinedArmsLocalName}`, so this case asks nothing about a local in a REGISTER. Its locals were: {listedLines(heldLocals)}")
	Expect.isEmpty(listedLines(rowsNotInRegisters(heldRows)), message: "`{JoinedArmsLocalName}` in `{JoinedArmsHeldFunctionName}` is no longer held only in registers, so this case no longer asks about a REGISTER at the join. These rows are not in a register: {listedLines(rowsNotInRegisters(heldRows))}")

	let afterOffsets = statementOffsetsOfLine(executable, staged: staged, line: afterAt)
	let heldAfterOffsets = statementOffsetsOfLine(executable, staged: staged, line: heldAfterAt)

	Expect.notEqual(rowsCoveringAny(rowsNamed(slotLocals, name: JoinedArmsValueName), offsets: afterOffsets).count(), expected: 0, message: "no row of `{JoinedArmsValueName}` covers the `after` line in `{MainFunctionName}`, so nothing there holds the value both arms assign and the join has nothing to show. `{MainFunctionName}`'s locals were: {listedLines(slotLocals)}")
	Expect.notEqual(rowsCoveringAny(rowsNamed(heldLocals, name: JoinedArmsValueName), offsets: heldAfterOffsets).count(), expected: 0, message: "no row of `{JoinedArmsValueName}` covers the `held-after` line in `{JoinedArmsHeldFunctionName}`, so nothing there holds the value both arms assign and the join has nothing to show. Its locals were: {listedLines(heldLocals)}")

	let mainAnchors = [beforeAt, afterAt]
	let heldAnchors = [heldBeforeAt, heldAfterAt]
	let commands = StringArray.create(0)

	for line in mainAnchors 'eachMainAnchor'
		commands.push("{BreakCommand} {lineTarget(line)}")
	end 'eachMainAnchor'

	for line in heldAnchors 'eachHeldAnchor'
		commands.push("{BreakCommand} {lineTarget(line)}")
	end 'eachHeldAnchor'

	commands.push(RunCommand)

	for _ in 0 upto mainAnchors.count() + heldAnchors.count() * JoinedArmsHeldCalls 'eachStop'
		commands.push("{PrintCommand} {JoinedArmsLocalName}")
		commands.push(ContinueCommand)
	end 'eachStop'

	let session = spawnDebugBatch(executable, staged: staged, commands: debugCommandLine(commands), extraOptions: StringArray.create(0))
	let events = batchEvents(session.stdout)
	let said = renderedEvents(session.stdout, stderr: session.stderr)

	for line in mainAnchors 'eachMainLine'
		Expect.equal(stopsAtLine(events, line: line), expected: 1, message: "the anchored line {line} of `{MainFunctionName}` runs once, so its breakpoint stops once. It printed: {listedLines(eventKinds(events))}. {said}")
	end 'eachMainLine'

	for line in heldAnchors 'eachHeldLine'
		Expect.equal(stopsAtLine(events, line: line), expected: JoinedArmsHeldCalls, message: "`{JoinedArmsHeldFunctionName}` is called from {JoinedArmsHeldCalls} sites, so its anchored line {line} runs {JoinedArmsHeldCalls} times and its breakpoint stops at each. It printed: {listedLines(eventKinds(events))}. {said}")
	end 'eachHeldLine'

	let assigned = "{JoinedArmsFilled * JoinedArmsFactor + JoinedArmsTerm}"
	let shownBefore = joinedArmsAnswersAt(events, line: beforeAt)
	let shownHeldBefore = joinedArmsAnswersAt(events, line: heldBeforeAt)

	Expect.equal(shownBefore.count(), expected: 1, message: "the stop at the `before` line answers its `{PrintCommand} {JoinedArmsLocalName}`. {said}")
	Expect.equal(shownHeldBefore.count(), expected: JoinedArmsHeldCalls, message: "each stop at the `held-before` line answers its `{PrintCommand} {JoinedArmsLocalName}`. {said}")
	Expect.isEmpty(listedLines(answersNeitherTrueNorUnavailable(shownBefore, trueValues: [JoinedArmsFirstValue])), message: "before the `if` in `{MainFunctionName}`, `{JoinedArmsLocalName}` is {JoinedArmsFirstValue}, or not shown; it read {listedLines(shownBefore)}, although neither arm has assigned {assigned} yet. {said}")
	Expect.isEmpty(listedLines(answersNeitherTrueNorUnavailable(shownHeldBefore, trueValues: [JoinedArmsFirstValue])), message: "before the `if` in `{JoinedArmsHeldFunctionName}`, `{JoinedArmsLocalName}` is {JoinedArmsFirstValue}, or not shown; it read {listedLines(shownHeldBefore)}, although neither arm has assigned {assigned} yet. {said}")

	let shownAfter = joinedArmsAnswersAt(events, line: afterAt)
	let shownHeldAfter = joinedArmsAnswersAt(events, line: heldAfterAt)

	Expect.equal(shownAfter.count(), expected: 1, message: "the stop at the `after` line answers its `{PrintCommand} {JoinedArmsLocalName}`. {said}")
	Expect.equal(shownHeldAfter.count(), expected: JoinedArmsHeldCalls, message: "each stop at the `held-after` line answers its `{PrintCommand} {JoinedArmsLocalName}`. {said}")

	for shown in shownAfter 'eachAfter'
		Expect.equal(shown, expected: assigned, message: "after the `if` in `{MainFunctionName}`, `{JoinedArmsLocalName}` holds {assigned} on every path, since both arms assign `{JoinedArmsValueName}`, and `{JoinedArmsValueName}`'s frame slot still holds it here. Neither arm's version reaches the join, so the join's own version must open there: a version that repeats an earlier version's value is left without rows of its own only where the earlier version's rows already cover it. {said}")
	end 'eachAfter'

	for shown in shownHeldAfter 'eachHeldAfter'
		Expect.equal(shown, expected: assigned, message: "after the `if` in `{JoinedArmsHeldFunctionName}`, `{JoinedArmsLocalName}` holds {assigned} on every path, since both arms assign `{JoinedArmsValueName}`, and `{JoinedArmsValueName}`'s register still holds it here. Neither arm's version reaches the join, so the join's own version must open there: a version that repeats an earlier version's value is left without rows of its own only where the earlier version's rows already cover it. {said}")
	end 'eachHeldAfter'

	discardStagedDir(staged)
end 'a local both arms of an if assign one value reads that value after the join, in a frame slot and in a register'
