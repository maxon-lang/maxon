let ArrayElementCaseLabel = "sidecar-array-element-type"

let ArrayLocalName = "items"
let ArrayTypeKindName = "Array"
let ElementTypeName = "Amount"
let ElementUnderlyingName = "i64"
let RenderFunctionName = "render"

test 'an Array local is described as an array, under a type row that names its element'
	let staged = builtFixture(ArrayElementCaseLabel, fixture: ValuesFixtureName)
	let dump = spawnDumpInfo(builtExecutable(staged), staged: staged, sections: StringArray.create())

	Expect.equal(dump.exitCode() as AssertedInt, expected: 0, message: "`{DebugSubcommandName} {DumpInfoOptionName} <exe>` did not print the sidecar. It wrote to stderr: {dump.stderr}")

	let functionRows = dumpSectionRows(withoutCarriageReturns(dump.stdout), heading: DumpFunctionsHeading)
	let typeRows = dumpSectionRows(withoutCarriageReturns(dump.stdout), heading: DumpTypesHeading)
	let locals = localRowsOf(functionRows, name: RenderFunctionName)
	var describedAs = AbsentEventText

	for row in locals 'eachLocal'
		if firstToken(row) == ArrayLocalName 'thisLocal'
			describedAs = describedTypeIn(row)
		end 'thisLocal'
	end 'eachLocal'

	Expect.notEqual(describedAs, expected: AbsentEventText, message: "`{RenderFunctionName}` describes no local named `{ArrayLocalName}` under any type, so this case would ask nothing of the type table. Its locals were: {renderedRows(locals)}")

	let described = typeRowOf(typeRows, name: describedAs)
	Expect.notEqual(described, expected: AbsentEventText, message: "`{ArrayLocalName}` is described under the type `{describedAs}`, which the type table does not hold — so a debugger asked to render it has nothing to render it AS. The types section held: {renderedRows(typeRows)}")
	Expect.equal(typeKindIn(described), expected: ArrayTypeKindName, message: "an Array is not a struct with one field; rendering it as one prints a pointer where the reader asked for elements. Its type row is: {described}")

	var namedElements = StringArray.create()

	for fieldRow in typeFieldRowsOf(typeRows, name: describedAs) 'eachField'
		namedElements.push(describedTypeIn(fieldRow))
	end 'eachField'

	let elements = renderedRows(namedElements)
	Expect.isTrue(elements.contains(ElementTypeName) or elements.contains(ElementUnderlyingName), message: "an array type record carries its ELEMENT's type id, because the element type is the only thing that says how far apart two elements are and how to render one. Either the declared alias `{ElementTypeName}` or the type it names, `{ElementUnderlyingName}`, is an honest answer; naming nothing is not. `{describedAs}`'s rows named: {elements}")
end 'an Array local is described as an array, under a type row that names its element'
