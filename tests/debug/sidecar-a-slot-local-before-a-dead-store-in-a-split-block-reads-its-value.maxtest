let SplitBlockValueCaseLabel = "sidecar-a-slot-local-before-a-dead-store-in-a-split-block-reads-its-value"

let SplitBlockLocalName = "limit"
let SplitBlockCurrentValue = "8"

test 'a var held in a stack slot reads its value on the lines before a dead store in a split block'
	let staged = builtFixture(SplitBlockValueCaseLabel, fixture: DeadSplitFixtureName)
	let threeAt = anchorLine(staged.join(StagedProgramFileName), anchor: "three")
	let commands = debugCommandLine(["{BreakCommand} {lineTarget(threeAt)}", RunCommand, "{PrintCommand} {SplitBlockLocalName}"])
	let session = spawnDebugBatch(builtExecutable(staged), staged: staged, commands: commands, extraOptions: StringArray.create())
	let events = batchEvents(session.stdout)
	let said = renderedEvents(session.stdout, stderr: session.stderr)
	let answers = eventsOfKind(events, kind: ValueEventName)

	Expect.equal(answers.count(), expected: 1, message: "`{PrintCommand} {SplitBlockLocalName}` printed no `{ValueEventName}` event. It printed: {listedLines(eventKinds(events))}. {said}")

	let answered = eventAt(answers, index: 0)
	let value = memberOf(answered, node: answered.root, key: ValueKey)

	Expect.equal(textOf(answered, node: nodeAt(value, index: 0), key: DisplayKey), expected: SplitBlockCurrentValue, message: "`{SplitBlockLocalName}` is {SplitBlockCurrentValue} on the line before `{SplitBlockLocalName} = 9`, which the optimiser deleted. That store was parsed in a block a range check later split, so the version the stop sits in is placed by the position the store held in its block and not by the block alone: a version dropped because its block cannot be told from the store's answers 'not live here' for a value the program still holds. {said}")
end 'a var held in a stack slot reads its value on the lines before a dead store in a split block'
