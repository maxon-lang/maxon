let KilledHeldCaseLabel = "a-detach-right-after-a-kill-of-a-held-program-reports-its-end"

let KilledHeldRounds = 8
let KilledHeldRoundDeadlineMs = 20000
let KilledHeldDetachPatienceMs = 3000
let KilledHeldKilledWording = "the program exited with code 137"
let KilledHeldDetachFailureWording = "the detach failed"
let KilledHeldDetachRefusalWording = "refused to detach"

test 'a detach issued right after the held program was killed outright reports the program ending instead of hanging'
	#if os(Macos)
		let staged = builtFixture(KilledHeldCaseLabel, fixture: ThreadBurstFixtureName)

		for round in 0 upto KilledHeldRounds 'eachRound'
			let log = roundStubLog(staged, round: round)
			let session = sessionHeldAt(staged, anchor: BurstSpinAnchorName, environment: loggedStubEnvironment(staged, log: log))
			let program = burstProcessId(staged)

			killedOutright(program)

			let detachedAt = Clock.nowMs()

			session.say(DetachCommand)
			session.say(QuitCommand)

			let ended = session.finish(KilledHeldRoundDeadlineMs)
			let detachMs = Clock.elapsedMs(detachedAt)
			let spoken = session.said()

			if not ended 'itHung'
				Expect.fail("round {round}: ⛔ A KILL THAT TAKES EFFECT ONLY WHEN THE DEBUGGER LETS GO CAN HAND THE DEAD PROGRAM TO A PROCESS THAT IS NOT THE DEBUGGER, WHICH THEN CANNOT WAIT FOR IT. The session did not end once it was told to quit. {spoken} {session.evidence()} {stubLogTail(log, lines: StubLogTailLines)}")
			end 'itHung'

			Expect.atMost(detachMs, than: KilledHeldDetachPatienceMs, message: "round {round}: a detach does not wait for the stub to leave on its own. The detach and the quit took {detachMs} ms. The session said: {spoken}")
			Expect.isFalse(spoken.contains(KilledHeldDetachRefusalWording), message: "round {round}: a detach from a program that was killed is not refused. The session said: {spoken}")
			Expect.isFalse(spoken.contains(KilledHeldDetachFailureWording), message: "round {round}: a detach from a program that was killed did not fail. The session said: {spoken}")
			Expect.isTrue(spoken.contains(KilledHeldKilledWording), message: "round {round}: the detach must report the program's end. The session said: {spoken}")

			requireNothingDefunct(round, program: program, stub: loggedStubProcessId(log), log: log, context: "The session said: {spoken}")
		end 'eachRound'

		discardStagedDir(staged)
	#endif
end 'a detach issued right after the held program was killed outright reports the program ending instead of hanging'
