typealias Round = int(0 to 1000)

function report(round Round)
	print("round {round}\n")
end 'report'

function main() returns ExitCode
	let limits = [7, 8, 9]
	var round = 0

	while round < limits.count() 'whileRounds' // anchor: while-header
		report(round)
		round = round + 1 // anchor: while-increment
	end 'whileRounds'

	for step in 0 upto limits.count() 'forRounds' // anchor: for-header
		report(step)
	end 'forRounds'

	return 0
end 'main'
