typealias Tick = int(0 to 1000000)

let TickRounds = 3

function tick(seed Tick) returns Tick
	let next = seed + 1

	return 0 if next > 100000 else next
end 'tick'

function chime(times Count)
	for _ in 0 upto times 'eachChime'
		print(".")
	end 'eachChime'
end 'chime'

function main() returns ExitCode
	var total = 0 as Tick
	var running = true

	while running 'outer'
		chime(2) // anchor: before
		total = tick(total) // anchor: call
		running = total < TickRounds
	end 'outer'

	chime(1)

	return total as ExitCode
end 'main'
