typealias Integer = int(i64.min to i64.max)

type Point
	export var x as Integer
	export var y as Integer

	static function create(x Integer, y Integer) returns Point
		return Self{x: x, y: y}
	end 'create'
end 'Point'

function pick(n Integer, other Integer) returns Integer
	let p = Point.create(n, y: 1)

	if n > 3 'big'
		return other
	end 'big'

	print("{p.x}\n")
	return n // anchor: final-return
end 'pick'

function main() returns ExitCode
	print("{pick(5, other: 7)}\n")
	print("{pick(1, other: 7)}\n")

	let q = Point.create(2, y: 3)
	print("{q.y}\n")

	return 0
end 'main'
