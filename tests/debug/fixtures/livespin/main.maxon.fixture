typealias Tick = int(0 to 1000000)

function tick(seed Tick) returns Tick
	let next = seed + 1 // anchor: tick-body

	return 0 if next > 100000 else next
end 'tick'

function main() returns ExitCode
	var total = 0
	var running = true

	while running 'outer'
		sleep(200)
		total = tick(total)
		running = total >= 0
	end 'outer'

	return total as ExitCode
end 'main'
