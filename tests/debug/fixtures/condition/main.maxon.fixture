typealias Step = int(0 to 1000)
typealias Ratio = float(f64.min to f64.max)

function hit(i Step) returns Step
	let flag = i == 11
	let label = "tick"
	let ratio = 1.5 as Ratio
	let tally = 1 if flag else 0 // anchor: hit-body
	print("hit {i} {flag} {label} {ratio} {tally}\n")

	return i + tally
end 'hit'

function main() returns ExitCode
	var total = 0

	for j in 0 upto 20 'loop'
		total = total + hit(j)
	end 'loop'

	total = total + hit(1)
	print("total {total}\n")

	return 0
end 'main'
