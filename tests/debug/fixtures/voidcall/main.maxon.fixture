typealias Rounds = int(0 to 1000000000)

function churn(rounds Rounds)
	var total = 0 as Rounds
	var i = 0 as Rounds

	while i < rounds 'spin'
		total = total + i mod 3
		i = i + 1
	end 'spin'

	print("churned {total}\n")
end 'churn'

function main() returns ExitCode
	let plan = [50000000, 3]
	let long = try plan.get(0) otherwise 0
	var marker = try plan.get(1) otherwise 0
	churn(long as Rounds) // anchor: main-long-call
	marker = marker + 1 // anchor: main-after
	churn(marker as Rounds)
	print("done {marker}\n")

	return 0
end 'main'
