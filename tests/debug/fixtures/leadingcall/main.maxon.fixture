typealias Step = int(0 to 1000000)

function tiny(x Step) returns Step
	return x * 3 + 1 // anchor: tiny-body
end 'tiny'

function main() returns ExitCode
	var total = 0
	let seed = total + 2

	for step in tiny(seed) upto 12 'steps' // anchor: leading-call
		total = total + step // anchor: loop-body
	end 'steps'

	for pass in 0 upto 3 'passes'
		let v = tiny(pass) + 1 // anchor: leading-call-each-pass
		total = total + v
	end 'passes'

	print("total {total}\n")

	return 0
end 'main'
