typealias Depth = int(0 to 100)

function countdown(n Depth) returns Depth // anchor: countdown-declaration
	if n == 0 'bottom'
		return 0
	end 'bottom'

	return countdown(n - 1) + 1
end 'countdown'

function main() returns ExitCode
	let top = countdown(3) // anchor: main-call
	print("countdown {top}\n")

	return 0
end 'main'
