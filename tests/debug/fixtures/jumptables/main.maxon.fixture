enum Four
	a
	b
	c
	d
end 'Four'

enum Five
	a
	b
	c
	d
	e
end 'Five'

enum Six
	a
	b
	c
	d
	e
	f
end 'Six'

enum Seven
	a
	b
	c
	d
	e
	f
	g
end 'Seven'

enum Eight
	a
	b
	c
	d
	e
	f
	g
	h
end 'Eight'

enum Nine
	a
	b
	c
	d
	e
	f
	g
	h
	i
end 'Nine'

function weighFour(value Four) returns Count
	return match value 'four'
		a gives 3
		b gives 5
		c gives 7
		d gives 11
	end 'four'
end 'weighFour'

function weighFive(value Five) returns Count
	return match value 'five'
		a gives 13
		b gives 17
		c gives 19
		d gives 23
		e gives 29
	end 'five'
end 'weighFive'

function weighSix(value Six) returns Count
	return match value 'six'
		a gives 31
		b gives 37
		c gives 41
		d gives 43
		e gives 47
		f gives 53
	end 'six'
end 'weighSix'

function weighSeven(value Seven) returns Count
	return match value 'seven'
		a gives 59
		b gives 61
		c gives 67
		d gives 71
		e gives 73
		f gives 79
		g gives 83
	end 'seven'
end 'weighSeven'

function weighEight(value Eight) returns Count
	return match value 'eight'
		a gives 89
		b gives 97
		c gives 101
		d gives 103
		e gives 107
		f gives 109
		g gives 113
		h gives 127
	end 'eight'
end 'weighEight'

function weighNine(value Nine) returns Count
	return match value 'nine'
		a gives 131
		b gives 137
		c gives 139
		d gives 149
		e gives 151
		f gives 157
		g gives 163
		h gives 167
		i gives 173
	end 'nine'
end 'weighNine'

function main() returns ExitCode
	let rounds = try CommandLine.readOptionalIntArgument(1, otherwise: 24) otherwise 24
	let fours = Four.allCases
	let fives = Five.allCases
	let sixes = Six.allCases
	let sevens = Seven.allCases
	let eights = Eight.allCases
	let nines = Nine.allCases
	var total = 0 as Count

	for round in 0 upto rounds 'eachRound'
		total = total + weighFour(try fours.get(round mod 4) otherwise Four.a)
		total = total + weighFive(try fives.get(round mod 5) otherwise Five.a)
		total = total + weighSix(try sixes.get(round mod 6) otherwise Six.a)
		total = total + weighSeven(try sevens.get(round mod 7) otherwise Seven.a)
		total = total + weighEight(try eights.get(round mod 8) otherwise Eight.a)
		total = total + weighNine(try nines.get(round mod 9) otherwise Nine.a)
	end 'eachRound'

	print("{total}\n")

	return 0
end 'main'
