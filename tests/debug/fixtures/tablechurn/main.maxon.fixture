function main() returns ExitCode
	var bytes = ByteArray.create()

	for i in 0 upto 50 'fill'
		bytes.push((65 + i mod 20) as Byte)
	end 'fill'

	let churned = churn((Clock.nowMs() mod 1000) as Rounds) // anchor: churn-call
	let found = bytes.contains(urlIsDigit) // anchor: spliced-scan
	print("found {found} {churned}\n") // anchor: after-scan

	return 0
end 'main'
