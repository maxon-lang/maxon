function main() returns ExitCode
	var bytes = ByteArray.create(0)

	for i in 0 upto 5 'fill'
		bytes.push((65 + i mod 20) as Byte)
	end 'fill'

	let first = bytes.count() * 41
	let second = bytes.count() * 43
	let third = bytes.count() * 47
	let w1 = bytes.count() * 3
	let w2 = bytes.count() * 5
	let w3 = bytes.count() * 7
	let marker = bytes.count() * 53
	var chosen = first
	chosen = second
	print("end {chosen} {first} {second} {third} {marker} {w1} {w2} {w3}\n") // anchor: end

	return 0
end 'main'
