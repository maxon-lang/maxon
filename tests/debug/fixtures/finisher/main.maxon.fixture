typealias Step = int(0 to 1000000)

function brief(seed Step) returns Step
	var total = seed
	var k = 0

	while k < 1 'loop'
		total = total + k // anchor: brief-loop
		sleep(5)
		k = k + 1
	end 'loop'

	return total
end 'brief'

function lasting(seed Step) returns Step
	var total = seed
	var k = 0

	while k < 40 'loop'
		total = total + k // anchor: lasting-loop
		sleep(5)
		k = k + 1
	end 'loop'

	return total
end 'lasting'

function main() returns ExitCode
	let short = async brief(1)
	let long = async lasting(2)
	let a = await short
	let b = await long

	print("finisher {a} {b}\n")

	return 0
end 'main'
