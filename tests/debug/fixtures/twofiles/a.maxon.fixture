// The first file of the two-file debug-info fixture. Its declarations and the second file's are interned into
// two different per-file type-name tables, so a local's declared type names the right type in the sidecar only
// if the merge carried the id across.
typealias Coord = int(0 to 1000)

type Alpha
	export var a as Coord

	export static function create(a Coord) returns Alpha
		return Self{a: a}
	end 'create'
end 'Alpha'

export function accumulateAlpha(n Coord) returns Coord
	let alphaValue = Alpha.create(n)
	var total = alphaValue.a
	var i = 0

	while i < 3 'loop'
		total = total + i
		i = i + 1
	end 'loop'

	return total
end 'accumulateAlpha'
