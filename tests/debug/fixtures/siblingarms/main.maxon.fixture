typealias Wide = int(0 to 1000000)

function mix(n Wide) returns Wide
	return n * 3 + 1
end 'mix'

function main() returns ExitCode
	var total = 0 as Wide
	var bytes = ByteArray.create(0)

	for i in 0 upto 6 'fill'
		bytes.push((65 + i) as Byte)
		total = total + mix(i as Wide)
	end 'fill'

	let n = bytes.count()
	let p0 = n * 3 + 1
	let p1 = n * 5 + 2
	let p2 = n * 7 + 3
	let p3 = n * 11 + 4
	let p4 = n * 13 + 5
	let p5 = n * 17 + 6
	let p6 = n * 19 + 7
	let p7 = n * 23 + 8
	let p8 = n * 29 + 9
	let p9 = n * 31 + 10
	let p10 = n * 37 + 11
	let p11 = n * 41 + 12
	let p12 = n * 43 + 13

	if bytes.count() > 9 'branch'
		let thenOnly = mix(total) * 7 // anchor: then-arm
		print("pressure {p0} {p1} {p2} {p3} {p4} {p5} {p6} {p7} {p8} {p9} {p10} {p11} {p12}\n")
		print("again {p0} {p1} {p2} {p3} {p4} {p5} {p6} {p7} {p8} {p9} {p10} {p11} {p12}\n")
		print("then {thenOnly} {bytes.count()} {total}\n")
		total = total + thenOnly
	end 'branch' else 'other'
		let elseOnly = total + 2 // anchor: else-arm
		print("else {elseOnly}\n")
	end 'other'

	print("done {total} {bytes.count()}\n")

	return 0
end 'main'
