typealias Wide = int(0 to 1000000)

function mix(n Wide) returns Wide
	return n * 3 + 1
end 'mix'

function main() returns ExitCode
	var total = 0 as Wide
	var bytes = ByteArray.create(0)

	for i in 0 upto 6 'fill'
		bytes.push((65 + i) as Byte)
		total = total + mix(i as Wide)
	end 'fill'

	if bytes.count() > 9 'branch'
		let thenOnly = mix(total) * 7 // anchor: then-arm
		print("then {thenOnly} {bytes.count()} {total}\n")
		total = total + thenOnly
	end 'branch' else 'other'
		let elseOnly = total + 2 // anchor: else-arm
		print("else {elseOnly}\n")
	end 'other'

	print("done {total} {bytes.count()}\n")

	return 0
end 'main'
