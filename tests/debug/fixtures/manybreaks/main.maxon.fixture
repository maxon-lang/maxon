typealias Rounds = int(0 to 1000000000)

function grind(seed Rounds) returns Rounds
	var total = seed mod 1000
	total = (total + seed mod 2) mod 1000 // anchor: bp01
	total = (total + seed mod 3) mod 1000 // anchor: bp02
	total = (total + seed mod 4) mod 1000 // anchor: bp03
