typealias Amount = int(i64.min to i64.max)
typealias Ratio = float(f64.min to f64.max)

function wrap(seed Amount) returns Amount
	let ratio = (seed as Ratio) * 2.5
	print("wrap {seed}\n")
	print("ratio {ratio}\n")

	if seed > 7 'large'
		return seed + 1 // anchor: early-return
	end 'large'

	return seed * 3 // anchor: final-return
end 'wrap'

function main() returns ExitCode
	let bytes = ByteArray.create(0)

	for i in 0 upto 5 'fill'
		bytes.push((65 + i mod 20) as Byte)
	end 'fill'

	let n = bytes.count() as Amount
	let answer = wrap(n) + wrap(n * 2)
	print("answer {answer}\n")

	return 0
end 'main'
