typealias Word = int(0 to u32.max)

function main() returns ExitCode
	let bytes = ByteArray.create(0)

	for i in 0 upto 5 'fill'
		bytes.push((65 + i mod 20) as Byte)
	end 'fill'

	let n = bytes.count() as Word
	let plan = [n, n + 1]
	let total = n * 7
	let v = try plan.get(n as ElementIndex) otherwise 0
	let sum = total + v
	print("sum {sum} {plan.count()}\n")

	return 0
end 'main'
