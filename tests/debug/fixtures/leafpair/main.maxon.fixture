typealias Small = int(0 to 100)
typealias Doubled = int(0 to 200)

function double(value Small) returns Doubled
	return value * 2 // anchor: double-body
end 'double'

function main() returns ExitCode
	let plan = [3, 4]
	let firstPlanned = try plan.get(0) otherwise 0
	let secondPlanned = try plan.get(1) otherwise 0
	let first = firstPlanned as Small
	let second = secondPlanned as Small
	let a = double(first) // anchor: first-call
	let b = double(second) // anchor: second-call

	print("doubled {a} {b}\n")

	return 0
end 'main'
