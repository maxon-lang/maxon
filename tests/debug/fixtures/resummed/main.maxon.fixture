function main() returns ExitCode
	let bytes = ByteArray.create(0)

	for i in 0 upto 5 'fill'
		bytes.push((65 + i mod 20) as Byte)
	end 'fill'

	let n = bytes.count()
	let a = n * 3 + 2
	let b = n * 4 + 1
	let p0 = n * 3 + 1
	let p1 = n * 5 + 2
	let p2 = n * 7 + 3
	let p3 = n * 11 + 4
	let p4 = n * 13 + 5
	let p5 = n * 17 + 6
	let p6 = n * 19 + 7
	let p7 = n * 23 + 8
	let p8 = n * 29 + 9
	let p9 = n * 31 + 10
	let p10 = n * 37 + 11
	let p11 = n * 41 + 12
	let p12 = n * 43 + 13
	let digits = bytes.containsWhere(urlIsDigit)
	var x = a + b
	let twice = x * 2
	x = 0
	let zeroAt = twice + n * 47 // anchor: zeroed
	x = a + b
	let againAt = zeroAt + n * 53 // anchor: again
	print("pressure {p0} {p1} {p2} {p3} {p4} {p5} {p6} {p7} {p8} {p9} {p10} {p11} {p12}\n")
	print("done {x} {twice} {againAt} {digits}\n")

	return 0
end 'main'
