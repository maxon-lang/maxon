typealias Step = int(0 to 1000000)
typealias StepPromise = Promise with Step
typealias StepPromiseArray = Array with StepPromise

function worker(n Step) returns Step
	var total = 0
	var k = 0

	while k < 4 'loop'
		total = total + n // anchor: worker-loop
		sleep(40)
		k = k + 1
	end 'loop'

	return total
end 'worker'

function main() returns ExitCode
	var pending = StepPromiseArray.create()
	pending.push(async worker(1))
	pending.push(async worker(2))
	pending.push(async worker(3))
	pending.push(async worker(4))
