test 'doubling two gives four'
	let doubled = double(2) // anchor: test-body
	try Expect.isTrue(doubled == 4, message: "two doubled is four")
end 'doubling two gives four'

test 'doubling three gives six'
	try Expect.isTrue(double(3) == 6, message: "three doubled is six")
end 'doubling three gives six'
