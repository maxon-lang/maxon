typealias Item = int(0 to 1000000)

function three() returns Item
	return 3 // anchor: three-body
end 'three'

function four() returns Item
	return 4 // anchor: four-body
end 'four'

function main() returns ExitCode
	var total = 0
	var round = 0

	while round < 3 'rounds'
		var chosen = three

		if round == 1 'takeFour'
			chosen = four
		end 'takeFour'

		let got = chosen() // anchor: value-call
		total = total + got // anchor: after-value-call
		round = round + 1
	end 'rounds'

	print("total {total}\n")

	return 0
end 'main'
