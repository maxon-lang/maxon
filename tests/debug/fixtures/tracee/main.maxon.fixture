typealias Tick = int(0 to 255)

function idle() returns Tick
	sleep(20)
	return 1
end 'idle'

function main() returns ExitCode
	let pending = async idle()

	print("ready\n")

	_ = try Console.stdin().readLine() otherwise LineRead.ended

	let ticked = await pending

	print("done {ticked}\n")
	return 0
end 'main'
