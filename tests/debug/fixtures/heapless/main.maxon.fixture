typealias Step = int(0 to 1000000)

function accumulate(limit Step) returns Step
	var total = 0 as Step
	var i = 0 as Step
	while i < limit 'sum'
		total = total + i
		i = i + 1
	end 'sum'

	return total
end 'accumulate'

function main() returns ExitCode
	var value = 0 as Step
	var rounds = 0 as Step
	while rounds < 4 'spin'
		value = value + accumulate(rounds) // anchor: hot
		rounds = rounds + 1
	end 'spin'

	value = value + accumulate(2)
	let answer = 7 if value >= 0 else 0

	return answer as ExitCode
end 'main'
