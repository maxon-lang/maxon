typealias Amount = int(i64.min to i64.max)

function bump(seed Amount) returns Amount
	let base = seed * 23 + 6
	let bumped = base + 9 // anchor: overwrite
	let total = bumped * 2 // anchor: probe
	print("bump {total}\n")

	return total
end 'bump'

function main() returns ExitCode
	let bytes = ByteArray.create(0)

	for i in 0 upto 5 'fill'
		bytes.push((65 + i mod 20) as Byte)
	end 'fill'

	let n = bytes.count() as Amount
	let answer = bump(n) + bump(n)
	print("answer {answer}\n")

	return 0
end 'main'
