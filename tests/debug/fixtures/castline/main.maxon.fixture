typealias Small = int(0 to 100)

function main() returns ExitCode
	let plan = [3 as Count, 4 as Count]
	let first = try plan.get(0) otherwise 0 // anchor: planned
	let narrowed = first as Small // anchor: narrowing
	let doubled = narrowed * 2 // anchor: doubling

	print("doubled {doubled}\n")

	return 0
end 'main'
