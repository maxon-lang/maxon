typealias Tick = int(0 to 1000000)

function grind(seed Tick) returns Tick
	var total = seed
	var running = true
	while running 'inner'
		total = total + 1 // anchor: grind
		total = 0 if total > 100000 else total
		running = total >= 0
	end 'inner'

	return total
end 'grind'

function main() returns ExitCode
	var ticks = grind(0)
	ticks = ticks + grind(1)

	return ticks as ExitCode
end 'main'
