typealias Item = int(0 to 1000000000)
typealias ItemArray = Array with Item

function isTarget(v Item) returns bool
	return v == 777 // anchor: closure-body
end 'isTarget'

function main() returns ExitCode
	var values = ItemArray.create()

	for i in 0 upto 3000 'fill'
		values.push((i * 7919) mod 1000003)
	end 'fill'

	let found = values.contains(function(v) gives isTarget(v)) // anchor: spliced-scan
	print("found {found}\n") // anchor: after-scan

	return 0
end 'main'
