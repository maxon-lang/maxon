typealias Step = int(0 to 1000000)

function worker(seed Step) returns Step
	var total = seed
	var i = 0 // anchor: worker-entry
	while i < 4 'grind'
		total = total + i
		sleep(1)
		i = i + 1
	end 'grind'

	return total
end 'worker'

function main() returns ExitCode
	let a = async worker(1)
	let b = async worker(2)
	let c = async worker(3)
	let d = async worker(4)
	let w = await a
	let x = await b
	let y = await c
	let z = await d
	print("coroutine {w} {x} {y} {z}\n")

	return 0
end 'main'
