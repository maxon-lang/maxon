typealias Word = int(0 to u32.max)

function blend(seed Word) returns Word
	var x = 1 as Word
	let k = seed * 7 + 4
	var mark = seed + 2 // anchor: held-before

	if seed > 3 'a'
		mark = mark * 3
		x = k
	end 'a' else 'b'
		mark = mark + 5
		x = k
	end 'b'

	let total = x + mark // anchor: held-after
	print("blend {total} {k}\n")

	return total
end 'blend'

function main() returns ExitCode
	let bytes = ByteArray.create(0)

	for i in 0 upto 5 'fill'
		bytes.push((65 + i mod 20) as Byte)
	end 'fill'

	let n = bytes.count()
	let p0 = n * 3 + 1
	let p1 = n * 5 + 2
	let p2 = n * 7 + 3
	let p3 = n * 11 + 4
	let p4 = n * 13 + 5
	let p5 = n * 17 + 6
	let p6 = n * 19 + 7
	let p7 = n * 23 + 8
	let p8 = n * 29 + 9
	let p9 = n * 31 + 10
	let p10 = n * 37 + 11
	let p11 = n * 41 + 12
	let p12 = n * 43 + 13
	var x = 1 as Word
	let k = (n * 7 + 4) as Word
	let digits = bytes.containsWhere(urlIsDigit)
	print("before {digits}\n") // anchor: before

	if n > 3 'a'
		print("long\n")
		x = k
	end 'a' else 'b'
		print("short\n")
		x = k
	end 'b'

	print("after {x}\n") // anchor: after
	print("pressure {p0} {p1} {p2} {p3} {p4} {p5} {p6} {p7} {p8} {p9} {p10} {p11} {p12}\n")
	print("done {x} {k} {digits} {blend(n as Word)}\n")

	return 0
end 'main'
