typealias Limit = int(0 to 1000)

function main() returns ExitCode
	var bytes = ByteArray.create()
	var limit = 0 as Limit

	for i in 0 upto 5 'fill'
		bytes.push((65 + i mod 20) as Byte)
		limit = limit + 1
	end 'fill'

	let found = bytes.containsWhere(urlIsDigit)
	var round = 0 as Limit

	while round < 3 'again'
		limit = limit + 100
		round = round + 1
	end 'again'

	print("tail {found} {round}\n") // anchor: after-loop

	return 0
end 'main'
