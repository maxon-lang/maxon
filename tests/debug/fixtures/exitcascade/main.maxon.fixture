typealias Tally = int(0 to 1000)

function measure(n Tally, floor Tally) returns Tally
	let label = "item {n}"

	if n > 100 'tooBig'
		return floor // anchor: untaken-return
	end 'tooBig'

	print("{label}\n") // anchor: before-the-taken-return
	return n // anchor: taken-return
end 'measure'

function main() returns ExitCode
	let first = measure(3, floor: 1)
	let second = measure(4, floor: 2)
	print("{first} {second}\n")

	return 0
end 'main'
