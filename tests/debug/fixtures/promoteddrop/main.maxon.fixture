typealias Integer = int(i64.min to i64.max)

type Point
	export var x as Integer
	export var y as Integer

	static function create(x Integer, y Integer) returns Point
		return Self{x: x, y: y}
	end 'create'
end 'Point'

function show(n Integer)
	let p = Point.create(n, y: 1)

	if n > 3 'big'
		return // anchor: promoted-drop-return
	end 'big'

	print("{p.x}\n")
end 'show'

function main() returns ExitCode
	show(5)
	show(1)

	let q = Point.create(2, y: 3)
	print("{q.y}\n")

	return 0
end 'main'
