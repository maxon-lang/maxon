typealias Verdict = int(0 to 255)

function giveUp(reason Verdict) returns Verdict
	if reason > 0 'fatal'
		panic("giving up with {reason}")
	end 'fatal'

	return reason
end 'giveUp'

function main() returns ExitCode
	let first = giveUp(0)
	let second = giveUp(7) // anchor: ending-call
	print("never {first} {second}\n")

	return 0
end 'main'
