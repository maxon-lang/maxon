typealias Amount = int(i64.min to i64.max)

function split(seed Amount) returns Amount
	let late = seed * 3 + 2
	let kept = seed * 13 + 1

	if kept > 100 'heavy' // anchor: branch
		print("heavy {seed}\n") // anchor: write
	end 'heavy'

	let total = late * 2 // anchor: join
	print("split {total}\n")

	return total
end 'split'

function main() returns ExitCode
	let bytes = ByteArray.create(0)

	for i in 0 upto 5 'fill'
		bytes.push((65 + i mod 20) as Byte)
	end 'fill'

	let n = bytes.count() as Amount
	let answer = split(n * 2) + split(n)
	print("answer {answer}\n")

	return 0
end 'main'
