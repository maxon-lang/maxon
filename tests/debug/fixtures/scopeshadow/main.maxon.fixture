function main() returns ExitCode
	let bytes = ByteArray.create(0)

	for i in 0 upto 5 'fill'
		bytes.push((65 + i mod 20) as Byte)
	end 'fill'

	let w1 = bytes.count() * 3
	let w2 = bytes.count() * 5
	let w3 = bytes.count() * 7
	let w4 = bytes.count() * 11
	let w5 = bytes.count() * 13
	let w6 = bytes.count() * 17
	let w7 = bytes.count() * 19
	let w8 = bytes.count() * 23
	let w9 = bytes.count() * 29
	let w10 = bytes.count() * 31
	let w11 = bytes.count() * 37
	let w12 = bytes.count() * 41
	let w13 = bytes.count() * 43
	let found = bytes.containsWhere(urlIsDigit)
	let depth = bytes.count() * 29 + 1

	if w1 > 4 'enters'
		let depth = bytes.count() * 31 + 2
		print("inner {depth} {w1} {w2} {w3} {w4} {w5} {w6} {w7} {w8} {w9} {w10} {w11} {w12} {w13} {found}\n")
	end 'enters' else 'leaves'
		return 1
	end 'leaves'

	print("after {depth} {w1} {w2} {w3} {w4} {w5} {w6} {w7} {w8} {w9} {w10} {w11} {w12} {w13}\n") // anchor: after
	print("tail {found} {depth}\n")

	return 0
end 'main'
