typealias Step = int(0 to 1000000)

function worker(n Step) returns Step
	var total = 0
	var k = 0

	while k < 6 'loop'
		total = total + n // anchor: worker-loop
		sleep(60) // anchor: worker-sleep
		k = k + 1 // anchor: worker-after-sleep
	end 'loop'

	return total
end 'worker'

function main() returns ExitCode
	let a = async worker(1)
	let b = async worker(2)
	let c = async worker(3)
	let d = async worker(4)
	let w = await a
	let x = await b
	let y = await c
	let z = await d

	print("workers {w} {x} {y} {z}\n") // anchor: after-awaits

	return 0
end 'main'
