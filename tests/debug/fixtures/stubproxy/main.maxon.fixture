typealias ByteSum = int(0 to u64.max)
typealias PacketBytes = int(1 to 0xFFFF)
typealias HexValue = int(0 to u64.max)

let RealStubVariable = "MAXON_PROXY_REAL_STUB"
let ModeVariable = "MAXON_PROXY_MODE"
let InjectAfterVariable = "MAXON_PROXY_INJECT_AFTER"
let InjectPayloadVariable = "MAXON_PROXY_INJECT"
let TraceVariable = "MAXON_PROXY_TRACE"
let PacketSizeVariable = "MAXON_PROXY_PACKET_SIZE"
let AdvertiseVariable = "MAXON_PROXY_ADVERTISE"
let AnswerMode = "answer"
let LateHaltMode = "late-halt"
let SmallBufferMode = "small-buffer"
let SilentMode = "silent"
let ProbeAnswerMode = "probe-answer"
let ProbeSwallowMode = "probe-swallow"
let AdvertiseYes = "yes"

let SupportedQuery = "qSupported"
let PacketSizeFeature = "PacketSize="
let UnadvertisedFeatures = "swbreak+;hwbreak+"
let MemoryReadRequest = "m"
let RequestFieldSeparator = ","
let TooLongRefusal = "E2E"
let HexDigitsPerByte = 2
let HexBase = 16
let AsciiDigitZero = 0x30
let AsciiLetterA = 0x61
let LettersBeforeTen = 10
let AnsweredMarker = "answered "
let RefusedMarker = "refused "
let WithheldMarker = "diverted "
let ContinuePayload = "c"
let ResumeRequest = "vCont"
let LiftRequest = "z"
let DetachRequest = "D"
let KillRequest = "k"
let SawMarker = "saw "
let SwallowedMarker = "swallowed "
let InterruptWording = "interrupt"

let ReverseConnectOption = "-R"
let Loopback = "127.0.0.1"
let HostPortSeparator = ":"
let PacketStart = "$"
let PacketEnd = "#"
let ChecksumModulus = 256
let InterruptByte = 3

let PollMs = 2
let ConnectBudgetMs = 20000
let StubExitBudgetMs = 3000
let ReceiveBytes = 65536

union Pulled
	data(text String)
	idle
	closed
end 'Pulled'

union ProbeFate
	answered(payload String)
	swallowed
end 'ProbeFate'

union Scenario
	answers(after String, payload String)
	lateHalt
	silent(after String)
	smallBuffer(limit PacketBytes, advertised bool)
	probes(fate ProbeFate)
end 'Scenario'

type Endpoint
	export let host as String
	export let port as NetworkPort

	static function create(host String, port NetworkPort) returns Endpoint
		return Self{host: host, port: port}
	end 'create'
end 'Endpoint'

type Relay
	var driver as TcpClient
	var stub as TcpClient
	let scenario as Scenario
	let trace as FilePath
	var done as bool
	var awaitingHalt as bool
	var lifted as bool
	var held as String
	var log as String

	static function create(driver TcpClient, stub TcpClient, scenario Scenario, trace FilePath) returns Relay
		return Self{driver: driver, stub: stub, scenario: scenario, trace: trace, done: false, awaitingHalt: false, lifted: false, held: "", log: ""}
	end 'create'

	function step() returns bool
		var alive = true

		match pull(self.driver) 'fromDriver'
			idle then break
			closed then alive = false
			data(text) then alive = self.toStub(text)
		end 'fromDriver'

		match pull(self.stub) 'fromStub'
			idle then break
			closed then alive = self.stubIsMuted() and alive
			data(text) then alive = self.toDriver(text) and alive
		end 'fromStub'

		return alive
	end 'step'

	function stubIsMuted() returns bool
		return match self.scenario 'which'
			silent gives self.done

			answers or
			lateHalt or
			smallBuffer or
			probes gives false
		end 'which'
	end 'stubIsMuted'

	function toStub(text String) returns bool
		var alive = true

		for piece in packetsOf(text) 'eachPiece'
			alive = self.routed(piece) and alive
		end 'eachPiece'

		return alive
	end 'toStub'

	function routed(piece String) returns bool
		return match self.scenario 'which'
			answers(after, payload) gives self.answeredOrForwarded(piece, after: after, payload: payload)
			lateHalt gives self.forwardedMindingTheHalt(piece)
			silent(after) gives self.continuedInPlaceOf(piece, after: after)
			smallBuffer(limit, advertised) gives self.forwardedWithinTheBuffer(piece, limit: limit, advertised: advertised)
			probes(fate) gives self.forwardedMindingTheProbe(piece, fate: fate)
		end 'which'
	end 'routed'

	function forwardedMindingTheProbe(piece String, fate ProbeFate) returns bool
		if containsInterrupt(piece) 'anInterrupt'
			self.noted("{SawMarker}{InterruptWording}")

			return self.done or sent(self.stub, text: piece)
		end 'anInterrupt'

		let request = requestIn(piece)

		if request.startsWith(LiftRequest) 'aTrapIsLifted'
			self.lifted = true
		end 'aTrapIsLifted'

		if request.startsWith(ResumeRequest) or request == DetachRequest or request == KillRequest 'worthNoting'
			self.noted("{SawMarker}{request}")
		end 'worthNoting'

		if self.done or not self.lifted or not request.startsWith(ResumeRequest) 'notTheProbe'
			return sent(self.stub, text: piece)
		end 'notTheProbe'

		self.done = true

		return match fate 'which'
			answered(payload) gives self.probeAnswered(payload)
			swallowed gives self.probeSwallowed()
		end 'which'
	end 'forwardedMindingTheProbe'

	function probeAnswered(payload String) returns bool
		self.noted("{AnsweredMarker}{payload}")

		return sent(self.driver, text: framed(payload))
	end 'probeAnswered'

	function probeSwallowed() returns bool
		self.noted("{SwallowedMarker}{ResumeRequest}")

		return true
	end 'probeSwallowed'

	function forwardedWithinTheBuffer(piece String, limit PacketBytes, advertised bool) returns bool
		let request = requestIn(piece)

		if request.startsWith(SupportedQuery) 'theHandshake'
			let features = "{PacketSizeFeature}{limit:x}" if advertised else UnadvertisedFeatures
			self.noted("{AnsweredMarker}{SupportedQuery} with {features}")

			return sent(self.driver, text: framed(features))
		end 'theHandshake'

		let bound = limit as HexValue

		if (request.byteLength() as HexValue) > bound or replyDigitsOf(request) > bound 'theBufferCannotTakeIt'
			self.noted("{RefusedMarker}{request}")

			return sent(self.driver, text: framed(TooLongRefusal))
		end 'theBufferCannotTakeIt'

		return sent(self.stub, text: piece)
	end 'forwardedWithinTheBuffer'

	function noted(line String)
		self.log.append("{line}\n")
		try File.writeText(self.trace, content: self.log) otherwise panic("the stub proxy could not write its trace")
	end 'noted'

	function answeredOrForwarded(piece String, after String, payload String) returns bool
		if self.done or not piece.startsWith("{PacketStart}{after}") 'nothingToAnswer'
			return sent(self.stub, text: piece)
		end 'nothingToAnswer'

		self.done = true
		try File.writeText(self.trace, content: "answered {payload} to {piece}") otherwise panic("the stub proxy could not write its trace")

		return sent(self.driver, text: framed(payload))
	end 'answeredOrForwarded'

	function forwardedMindingTheHalt(piece String) returns bool
		if not self.done and containsInterrupt(piece) 'theInterrupt'
			self.awaitingHalt = true
		end 'theInterrupt'

		var alive = sent(self.stub, text: piece)

		if self.held.isEmpty() or not piece.startsWith(PacketStart) 'nothingToRelease'
			return alive
		end 'nothingToRelease'

		self.done = true
		try File.writeText(self.trace, content: "released {self.held} after {piece}") otherwise panic("the stub proxy could not write its trace")
		alive = sent(self.driver, text: self.held) and alive
		self.held = ""

		return alive
	end 'forwardedMindingTheHalt'

	function continuedInPlaceOf(piece String, after String) returns bool
		if self.done or not piece.startsWith("{PacketStart}{after}") 'nothingToDivert'
			return sent(self.stub, text: piece)
		end 'nothingToDivert'

		self.done = true
		self.noted("{WithheldMarker}{piece}")

		return sent(self.stub, text: framed(ContinuePayload))
	end 'continuedInPlaceOf'

	function toDriver(text String) returns bool
		if self.stubIsMuted() 'theStubIsMuted'
			return true
		end 'theStubIsMuted'

		if not self.awaitingHalt 'theStubSpeaks'
			return sent(self.driver, text: text)
		end 'theStubSpeaks'

		self.awaitingHalt = false
		self.held = text

		return true
	end 'toDriver'

	function close()
		self.driver.close()
		self.stub.close()
	end 'close'
end 'Relay'

function packetsOf(text String) returns StringArray
	let packets = StringArray.create(0)

	for (iter, piece) in text.split(PacketStart).withIterator() 'eachPiece'
		if iter.index() == 0 'beforeAnyPacket'
			if not piece.isEmpty() 'somethingLeads'
				packets.push(piece)
			end 'somethingLeads'

			continue
		end 'beforeAnyPacket'

		packets.push("{PacketStart}{piece}")
	end 'eachPiece'

	return packets
end 'packetsOf'

function requestIn(piece String) returns String
	if not piece.startsWith(PacketStart) 'notAPacket'
		return ""
	end 'notAPacket'

	let body = try piece.split(PacketEnd).get(0) otherwise panic("a split answers at least the whole of what it was given")

	return body.replaceFirst(PacketStart, with: "")
end 'requestIn'

function replyDigitsOf(request String) returns HexValue
	if not request.startsWith(MemoryReadRequest) 'notARead'
		return 0
	end 'notARead'

	let fields = request.split(RequestFieldSeparator)
	let spelled = try fields.get(1) otherwise return 0

	return hexValueOf(spelled) * HexDigitsPerByte
end 'replyDigitsOf'

function hexValueOf(spelled String) returns HexValue
	var value = 0 as HexValue

	for digit in spelled.bytes() 'eachDigit'
		let step = (digit as HexValue) - AsciiDigitZero if digit < AsciiLetterA else (digit as HexValue) - AsciiLetterA + LettersBeforeTen
		value = value * HexBase + step
	end 'eachDigit'

	return value
end 'hexValueOf'

function containsInterrupt(piece String) returns bool
	for value in piece.bytes() 'eachByte'
		if value == InterruptByte 'theInterrupt'
			return true
		end 'theInterrupt'
	end 'eachByte'

	return false
end 'containsInterrupt'

function scenarioFromEnvironment() returns Scenario
	let mode = setting(ModeVariable)

	if mode == LateHaltMode 'late'
		return Scenario.lateHalt
	end 'late'

	if mode == AnswerMode 'answering'
		return Scenario.answers(setting(InjectAfterVariable), payload: setting(InjectPayloadVariable))
	end 'answering'

	if mode == SilentMode 'silent'
		return Scenario.silent(setting(InjectAfterVariable))
	end 'silent'

	if mode == SmallBufferMode 'small'
		return Scenario.smallBuffer(packetBytesFromEnvironment(), advertised: setting(AdvertiseVariable) == AdvertiseYes)
	end 'small'

	if mode == ProbeAnswerMode 'probeAnswered'
		return Scenario.probes(ProbeFate.answered(setting(InjectPayloadVariable)))
	end 'probeAnswered'

	if mode == ProbeSwallowMode 'probeSwallowed'
		return Scenario.probes(ProbeFate.swallowed)
	end 'probeSwallowed'

	panic("{ModeVariable} names '{mode}', which is none of {AnswerMode}, {LateHaltMode}, {SilentMode}, {SmallBufferMode}, {ProbeAnswerMode} and {ProbeSwallowMode}")
end 'scenarioFromEnvironment'

function packetBytesFromEnvironment() returns PacketBytes
	let spelled = setting(PacketSizeVariable)
	let size = try int.fromString(spelled) otherwise panic("{PacketSizeVariable} names '{spelled}', which is not a number")

	return size as PacketBytes
end 'packetBytesFromEnvironment'

function pull(source TcpClient) returns Pulled
	try source.setReadDeadline(PollMs) otherwise return Pulled.closed

	let chunk = try source.readSome(ReceiveBytes) otherwise (e) 'nothing'
		match e 'why'
			timedOut then return Pulled.idle
			closed or
				failed or
				secure then return Pulled.closed
		end 'why'
	end 'nothing'

	if chunk.isEmpty() 'peerClosed'
		return Pulled.closed
	end 'peerClosed'

	return Pulled.data(String.from(chunk))
end 'pull'

function sent(target TcpClient, text String) returns bool
	_ = try target.send(text) otherwise return false

	return true
end 'sent'

function framed(payload String) returns String
	var sum = 0 as ByteSum

	for value in payload.bytes() 'eachByte'
		sum = sum + (value as ByteSum)
	end 'eachByte'

	let checksum = sum mod ChecksumModulus

	return "{PacketStart}{payload}{PacketEnd}{checksum:02x}"
end 'framed'

function setting(name String) returns String
	return try Process.environmentVariable(name) otherwise panic("the stub proxy is started without {name} in its environment")
end 'setting'

function realStub() returns FilePath
	let spelled = setting(RealStubVariable)

	return try FilePath.from(spelled) otherwise panic("{RealStubVariable} names '{spelled}', which is not a path")
end 'realStub'

function traceFile() returns FilePath
	let spelled = setting(TraceVariable)

	return try FilePath.from(spelled) otherwise panic("{TraceVariable} names '{spelled}', which is not a path")
end 'traceFile'

function forwardedArguments(arguments StringArray, replacing String, by String) returns StringArray
	let forwarded = StringArray.create(arguments.count(), zeroed: false)
	var replaceNext = false

	for (iter, argument) in arguments.withIterator() 'eachArgument'
		if iter.index() == 0 'theProgram'
			continue
		end 'theProgram'

		forwarded.push(by if replaceNext else argument)
		replaceNext = argument == replacing
	end 'eachArgument'

	return forwarded
end 'forwardedArguments'

function driverEndpoint(arguments StringArray) returns Endpoint
	var next = false

	for argument in arguments 'eachArgument'
		if next 'theAddress'
			return endpointOf(argument)
		end 'theAddress'

		next = argument == ReverseConnectOption
	end 'eachArgument'

	panic("the stub proxy is started with {ReverseConnectOption} and an address, as the debugger starts its stub")
end 'driverEndpoint'

function endpointOf(spelled String) returns Endpoint
	let pieces = spelled.split(HostPortSeparator)
	let host = try pieces.get(0) otherwise panic("'{spelled}' has no host")
	let digits = try pieces.get(1) otherwise panic("'{spelled}' has no port")
	let port = try int.fromString(digits) otherwise panic("'{digits}' is not a port")

	return Endpoint.create(host, port: port as NetworkPort)
end 'endpointOf'

function carriesReverseConnect(arguments StringArray) returns bool
	for argument in arguments 'eachArgument'
		if argument == ReverseConnectOption 'found'
			return true
		end 'found'
	end 'eachArgument'

	return false
end 'carriesReverseConnect'

typealias DrainedBytes = int(0 to u64.max)
typealias DrainReply = Promise with DrainedBytes

type OutputDrain
	var reader as ChildOutputReader

	static function create(reader isolated ChildOutputReader) returns Self
		return Self{reader: merge reader}
	end 'create'

	export function drain() returns DrainedBytes
		let rest = try self.reader.readToEnd() otherwise return 0

		return rest.count() as DrainedBytes
	end 'drain'
end 'OutputDrain'

type StubDrains
	var stdout as DrainReply
	var stderr as DrainReply

	static function over(stub StreamingSubprocess) returns StubDrains
		let outReader = try stub.takeStdout() otherwise panic("the real stub's stdout could not be taken")
		let errReader = try stub.takeStderr() otherwise panic("the real stub's stderr could not be taken")
		let outDrain = spawn OutputDrain.create(outReader)
		let errDrain = spawn OutputDrain.create(errReader)
		let outReply = try outDrain.drain() otherwise panic("the stub's stdout drain refused its work")
		let errReply = try errDrain.drain() otherwise panic("the stub's stderr drain refused its work")

		return Self{stdout: outReply, stderr: errReply}
	end 'over'

	function finish()
		_ = await self.stdout
		_ = await self.stderr
	end 'finish'
end 'StubDrains'

function probed(arguments StringArray) returns ExitCode
	let ran = try Subprocess.run(Executable.path(realStub()), arguments: forwardedArguments(arguments, replacing: ReverseConnectOption, by: "")) otherwise panic("the real stub could not run")
	print(ran.stdout)
	printError(ran.stderr)

	return 0
end 'probed'

function served(arguments StringArray) returns ExitCode
	let driver = driverEndpoint(arguments)
	let door = try TcpListener.bind(Loopback, port: 0) otherwise panic("the stub proxy could not listen")
	let proxied = forwardedArguments(arguments, replacing: ReverseConnectOption, by: "{Loopback}{HostPortSeparator}{door.port()}")
	let stub = try StreamingSubprocess.spawn(Executable.path(realStub()), arguments: proxied) otherwise panic("the real stub could not start")
	stub.closeStdin()

	let drains = StubDrains.over(stub)

	try door.setAcceptDeadline(ConnectBudgetMs) otherwise panic("the stub proxy could not put a deadline on its door")
	let stubSocket = try door.accept() otherwise panic("the real stub did not connect to the proxy")

	return relayed(stub, stubSocket: stubSocket, driver: driver, scenario: scenarioFromEnvironment(), drains: drains)
end 'served'

function relayed(stub StreamingSubprocess, stubSocket TcpClient, driver Endpoint, scenario Scenario, drains StubDrains) returns ExitCode
	let driverSocket = try TcpClient.connect(driver.host, port: driver.port, deadlineMs: ConnectBudgetMs) otherwise panic("the stub proxy could not reach the debugger")
	let relay = Relay.create(driverSocket, stub: stubSocket, scenario: scenario, trace: traceFile())
	var relaying = true

	while relaying 'relaying'
		relaying = relay.step()
	end 'relaying'

	relay.close()

	try stub.wait(WaitDeadline.within(StubExitBudgetMs)) otherwise 'late'
		_ = stub.endTree()
	end 'late'

	drains.finish()
	stub.release()

	return 0
end 'relayed'

function main() returns ExitCode
	let arguments = CommandLine.args()

	if not carriesReverseConnect(arguments) 'theProbe'
		return probed(arguments)
	end 'theProbe'

	return served(arguments)
end 'main'
