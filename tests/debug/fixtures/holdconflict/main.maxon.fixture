typealias Limit = int(0 to 1000)

function main() returns ExitCode
	var bytes = ByteArray.create()
	var limit = 0 as Limit

	for i in 0 upto 5 'fill'
		bytes.push((65 + i mod 20) as Byte)
		limit = limit + 1
	end 'fill'

	let found = bytes.contains(urlIsDigit) // anchor: spliced-scan
	limit = limit + (1 if found else 0) // anchor: after-scan
	print("found {found} {limit}\n")

	return 0
end 'main'
