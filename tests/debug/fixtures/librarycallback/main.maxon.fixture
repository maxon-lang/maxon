typealias Item = int(0 to 1000000)
typealias ItemArray = Array with Item

function rank(a Item, b Item) returns Ordering
	let left = a mod 97 // anchor: rank-body
	let right = b mod 97

	return left.compare(right)
end 'rank'

function main() returns ExitCode
	var items = ItemArray.create()

	for i in 0 upto 50 'fill'
		items.push((i * 7919) mod 1003)
	end 'fill'

	items.sort(function(a, b) gives rank(a, b: b)) // anchor: main-sort
	let first = try items.get(0) otherwise 0
	print("sorted {first}\n")

	return 0
end 'main'
