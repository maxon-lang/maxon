typealias Amount = int(i64.min to i64.max)
typealias Step = function(Amount) returns Amount

function twice(n Amount) returns Amount
	return n * 2
end 'twice'

function apply(step Step, n Amount) returns Amount
	return step(n)
end 'apply'

function render(seed Amount) returns Amount
	let label = "closure label {seed}"
	let base = seed + 40
	let plain = twice
	let adder = function(n Amount) gives n + base + (label.byteLength() as Amount)
	print("{apply(plain, n: 1)} {adder(1)}\n") // anchor: rendered

	return apply(plain, n: seed) + adder(seed)
end 'render'

function main() returns ExitCode
	let answer = render(1)
	print("answer {answer}\n")

	return 0
end 'main'
