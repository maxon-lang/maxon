typealias Limit = int(0 to 1000)

function main() returns ExitCode
	var bytes = ByteArray.create()
	var limit = 0 as Limit

	for i in 0 upto 5 'fill'
		bytes.push((65 + i mod 20) as Byte)
		limit = limit + 1
	end 'fill'

	let first = bytes.containsWhere(urlIsDigit)
	limit = limit + 1
	limit = limit + 2
	let w1 = bytes.count() * 3
	let w2 = bytes.count() * 5
	let w3 = bytes.count() * 7
	let w4 = bytes.count() * 11
	let w5 = bytes.count() * 13
	let w6 = bytes.count() * 17
	let w7 = bytes.count() * 19
	let w8 = bytes.count() * 23
	let second = bytes.containsWhere(urlIsDigit)
	print("one {w1} {w2} {w3} {w4} {w5} {w6} {w7} {w8} {first} {second}\n")
	print("two {w1} {w2} {w3} {w4} {w5} {w6} {w7} {w8} {limit}\n")
	print("three {w1} {w2} {w3} {w4} {w5} {w6} {w7} {w8}\n") // anchor: three
	limit = 9 // anchor: dead

	print("tail {first}\n") // anchor: tail

	return 0
end 'main'
