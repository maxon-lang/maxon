typealias Step = int(0 to 1000000)

function approach(seed Step) returns Step
	var total = seed
	var i = 0
	while i < 3 'grind'
		total = total + i // anchor: before-crash
		i = i + 1
	end 'grind'

	return total
end 'approach'

function main() returns ExitCode
	var total = approach(1)
	total = total + approach(2)
	print("approaching {total}\n")
	__Builtins.forceSegfault()

	return 0
end 'main'
