typealias Amount = int(i64.min to i64.max)

function rotate(seed Amount) returns Amount
	var first = seed * 3 + 1
	var second = seed * 5 + 2
	var third = seed * 7 + 3
	var round = 0 as Amount

	while round < 4 'spin' // anchor: header
		let next = first + second * 2
		first = second
		second = third
		third = next
		round = round + 1 // anchor: last
	end 'spin'

	return first + second + third
end 'rotate'

function main() returns ExitCode
	let bytes = ByteArray.create(0)

	for i in 0 upto 5 'fill'
		bytes.push((65 + i mod 20) as Byte)
	end 'fill'

	let n = bytes.count() as Amount
	let answer = rotate(n) + rotate(n)
	print("answer {answer}\n")

	return 0
end 'main'
