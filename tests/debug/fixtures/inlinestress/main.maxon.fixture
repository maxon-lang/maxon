typealias Small = int(0 to 1000000)

function tail(n Small) returns Small
	let result = n + n
	let spare = 4

	if spare > 10 'never'
		return 0
	end 'never'

	return result
end 'tail'

function other(n Small) returns Small
	let bumped = n + 3
	let unusedLimit = 9

	if unusedLimit > 100 'never'
		return 1
	end 'never'

	return bumped
end 'other'

function plusZero(n Small) returns Small
	let answer = n + 0
	return answer
end 'plusZero'

function timesOne(n Small) returns Small
	let answer = n * 1
	return answer
end 'timesOne'

function viaConstant(n Small) returns Small
	let four = 4
	let answer = n * four
	return answer
end 'viaConstant'

function chosen(flag bool, n Small) returns Small
	let low = n
	let high = n + 1
	let answer = high if flag else low
	return answer
end 'chosen'

function mix(a Small, b Small) returns Small
	let left = tail(a)
	let right = other(b)
	let spareMix = 2

	if spareMix > 50 'never'
		return 2
	end 'never'

	return (left + right + plusZero(a) + timesOne(b)) mod 1000
end 'mix'

function main() returns ExitCode
	var total = 0 as Small
	var i = 0 as Small

	while i < 20 'loop'
		total = (total + mix(i, b: total) + tail(i) + other(total) + mix(total, b: i) + viaConstant(i) + chosen(i > 5, n: total)) mod 1000
		i = i + 1
	end 'loop'

	print("total {total}\n")

	return 0
end 'main'
