typealias Rounds = int(0 to 1000000000)

function churn(rounds Rounds) returns Rounds
	var total = 0 as Rounds
	var i = 0 as Rounds

	while i < rounds 'spin'
		total = total + i mod 3 // anchor: churn-loop
		i = i + 1
	end 'spin'

	print("churned {total}\n") // anchor: churn-done

	return total
end 'churn'

function main() returns ExitCode
	let plan = [50000000, 3]
	let long = try plan.get(0) otherwise 0
	let short = try plan.get(1) otherwise 0
	let first = churn(long as Rounds) // anchor: main-long-call
	let second = churn(short as Rounds) // anchor: main-after

	print("longcall {first + second}\n")

	return 0
end 'main'
