typealias Reading = int(0 to 1000)
typealias Readings = Array with Reading

type Gauge
	var reading as Reading

	static function make() returns Gauge
		return Self{reading: 7}
	end 'make'
end 'Gauge'

type Probe
	var level as Reading

	static function make() returns Probe
		return Self{level: 9}
	end 'make'
end 'Probe'

function shifted(readings Readings) returns Readings
	let gauge = Gauge.make()
	let probe = Probe.make()
	return readings.map(function(n) gives (n + gauge.reading + probe.level) as Reading)
end 'shifted'
