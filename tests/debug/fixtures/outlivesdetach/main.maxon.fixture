typealias Round = int(0 to 1000)

let FinishedMarkerName = "outlived-the-detach.txt"
let PidFileName = "outlivesdetach-pid.txt"
let Rounds = 40
let RoundSleepMs = 200

function main() returns ExitCode
	let pidFile = try FilePath.from(PidFileName) otherwise panic("the pid file name is a relative path")
	try File.writeText(pidFile, content: "{Process.id()}\n") otherwise panic("the program could not write its process id")

	var round = 0 as Round

	while round < Rounds 'wait'
		sleep(RoundSleepMs)  // anchor: wait-round
		round = round + 1
	end 'wait'

	let marker = try FilePath.from(FinishedMarkerName) otherwise panic("the marker name is a relative path")
	try File.writeText(marker, content: "{round}") otherwise panic("the program could not write its marker")

	return 0
end 'main'
