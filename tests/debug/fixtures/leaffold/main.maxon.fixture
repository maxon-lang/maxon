typealias Small = int(0 to 100)
typealias Doubled = int(0 to 200)

function double(value Small) returns Doubled
	return value * 2 // anchor: double-body
end 'double'

function main() returns ExitCode
	let fits = double(2) == 4 // anchor: folded-call
	let misfits = double(2) == 5

	print("fits {fits} {misfits}\n")

	return 0
end 'main'
