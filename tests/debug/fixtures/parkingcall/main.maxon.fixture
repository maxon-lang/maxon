typealias Step = int(0 to 1000000)

function rest(seed Step) returns Step
	var total = seed
	var k = 0 as Step

	while k < 2 'loop'
		total = total + k
		sleep(1)
		k = k + 1
	end 'loop'

	return total // anchor: rest-return
end 'rest'

function main() returns ExitCode
	let first = rest(1) // anchor: first-call
	let second = rest(first) // anchor: second-call
	print("parkingcall {first} {second}\n")

	return 0
end 'main'
