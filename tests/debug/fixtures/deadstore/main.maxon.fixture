typealias Limit = int(0 to 1000)

function main() returns ExitCode
	var bytes = ByteArray.create()
	var limit = 0 as Limit

	for i in 0 upto 5 'fill'
		bytes.push((65 + i mod 20) as Byte)
		limit = limit + 1
	end 'fill'

	let found = bytes.containsWhere(urlIsDigit)
	print("sum {limit} {found}\n")
	limit = 7 // anchor: dead

	print("tail {found}\n") // anchor: tail

	return 0
end 'main'
