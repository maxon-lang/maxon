typealias Step = int(0 to 1000000)

type Tally
	var count as Step

	static function create(count Step) returns Tally
		return Self{count: count}
	end 'create'
end 'Tally'

function tiny(x Step) returns Step
	return x + 1
end 'tiny'

function main() returns ExitCode
	let bytes = ByteArray.create(0)
	bytes.push(65)
	let holder = Tally.create(0)
	var total = bytes.count() as Step
	var round = 0 as Step

	while round < 3 'rounds'
		total = total + tiny(round)
		holder.count = total // anchor: before
		round = round + 1
	end 'rounds'

	print("total {total} {holder.count}\n")

	return 0
end 'main'
