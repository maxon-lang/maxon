typealias Amount = int(i64.min to i64.max)
typealias Level = int(0 to 100)
typealias AmountHolder = Holder with Amount
typealias LevelHolder = Holder with Level

type Holder uses Slot
	export var value as Slot

	static function create(value Slot) returns Holder
		return Holder{value: value}
	end 'create'

	function tripled(done Count) returns Slot
		if done == 2 'enough'
			return self.value
		end 'enough'

		return self.tripled(done + 1) + self.value
	end 'tripled'
end 'Holder'

type Ticket
	export var seat as Amount
	export var row as Amount

	static function create(seat Amount, row Amount) returns Ticket
		return Ticket{seat: seat, row: row}
	end 'create'
end 'Ticket'

function main() returns ExitCode
	let whole = AmountHolder.create(3)
	let level = LevelHolder.create(5)
	let ticket = Ticket.create(7, row: 2)
	let copy = ticket.clone()
	print("generics {whole.tripled(0)} {level.tripled(0)} {ticket.seat} {copy.row}\n")

	return 0
end 'main'
