typealias MixWord = bits(64)

function main() returns ExitCode
	let bytes = ByteArray.create(0)

	for i in 0 upto 5 'fill'
		bytes.push((65 + i mod 20) as Byte)
	end 'fill'

	let seed = (bytes.count() * 977) as HashValue
	let h = seed as MixWord
	let k = h or 0
	let m = h * 1
	let spread = h xor (k shr 16) xor (m shl 3) // anchor: after
	print("mixed {spread}\n")

	return 0
end 'main'
