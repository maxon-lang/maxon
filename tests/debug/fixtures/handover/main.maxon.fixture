typealias Amount = int(i64.min to i64.max)

function shift(seed Amount) returns Amount
	let keep = seed * 41 + 1
	var level = seed * 31 + 8

	if level > keep 'never'
		return 0
	end 'never'

	level = keep * 5 + seed // anchor: rebind
	let total = level + 1 // anchor: after
	print("shifted {total}\n")

	return total
end 'shift'

function main() returns ExitCode
	let bytes = ByteArray.create(0)

	for i in 0 upto 5 'fill'
		bytes.push((65 + i mod 20) as Byte)
	end 'fill'

	let n = bytes.count() as Amount
	let answer = shift(n) + shift(n)
	print("answer {answer}\n")

	return 0
end 'main'
