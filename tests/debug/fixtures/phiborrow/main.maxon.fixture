function pick(n Count) returns Count
	if n > 20 'big'
		return n * 3
	end 'big'

	return n + 7
end 'pick'

function main() returns ExitCode
	var bytes = ByteArray.create(0)

	for i in 0 upto 5 'fill'
		bytes.push((65 + i mod 20) as Byte)
	end 'fill'

	let other = bytes.count() * 41
	var best = bytes.count() * 43
	let w1 = bytes.count() * 3
	let w2 = bytes.count() * 5
	let w3 = bytes.count() * 7
	let found = bytes.containsWhere(urlIsDigit)
	let near = pick(w1)
	best = other
	print("end {best} {near} {w1} {w2} {w3} {found}\n") // anchor: end

	return 0
end 'main'
