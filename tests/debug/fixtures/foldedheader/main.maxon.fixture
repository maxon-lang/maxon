typealias Word = int(0 to u32.max)

function main() returns ExitCode
	let bytes = ByteArray.create(0)

	for i in 0 upto 5 'fill'
		bytes.push((65 + i mod 20) as Byte)
	end 'fill'

	let n = bytes.count()
	let stride = n as Word
	let limit = (n mod 3) as Word
	let p0 = n * 3 + 1
	let p1 = n * 5 + 2
	let p2 = n * 7 + 3
	let p3 = n * 11 + 4
	let p4 = n * 13 + 5
	let p5 = n * 17 + 6
	let p6 = n * 19 + 7
	let p7 = n * 23 + 8
	let p8 = n * 29 + 9
	let p9 = n * 31 + 10
	let p10 = n * 37 + 11
	let p11 = n * 41 + 12
	let p12 = n * 43 + 13
	var reached = false
	let digits = bytes.containsWhere(urlIsDigit)
	var chunk = 0 as Word
	var run = 0 as Word

	while chunk < 64 'scan'
		if (chunk + stride) mod 3 == 0 'used'
			chunk = chunk + 1
			run = 0
			continue
		end 'used'

		run = run + 1 // anchor: inside
		chunk = chunk + 1

		if run >= limit 'enough'
			reached = true
			break
		end 'enough'
	end 'scan'

	print("pressure {p0} {p1} {p2} {p3} {p4} {p5} {p6} {p7} {p8} {p9} {p10} {p11} {p12}\n")

	if reached 'hit'
		print("hit {chunk} {digits}\n") // anchor: hit
	end 'hit'

	print("done {run}\n")

	return 0
end 'main'
