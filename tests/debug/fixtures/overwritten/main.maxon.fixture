typealias Amount = int(i64.min to i64.max)

function render(seed Amount) returns Amount
	let dead = seed * 7 + 3
	let late = seed * 11 + 5

	if dead > late 'never'
		return 0
	end 'never'

	print("between {late} {seed}\n")
	let total = late * 2 // anchor: rendered
	print("rendered {total}\n")

	return total
end 'render'

function main() returns ExitCode
	let bytes = ByteArray.create(0)

	for i in 0 upto 5 'fill'
		bytes.push((65 + i mod 20) as Byte)
	end 'fill'

	let n = bytes.count() as Amount
	let answer = render(n) + render(n * 2)
	print("answer {answer}\n")

	return 0
end 'main'
