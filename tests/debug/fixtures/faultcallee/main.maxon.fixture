typealias Step = int(0 to 1000000)

function explode(seed Step) returns Step
	var total = seed
	var i = 0

	while i < 3 'grind'
		total = total + i
		i = i + 1
	end 'grind'

	__Builtins.forceSegfault() // anchor: callee-fault

	return total
end 'explode'

function main() returns ExitCode
	let first = explode(3) // anchor: main-call
	let second = explode(4)
	print("unreachable {first} {second}\n")

	return 0
end 'main'
