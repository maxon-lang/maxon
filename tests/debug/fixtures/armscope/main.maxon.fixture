union Shape
	empty
	sized(size Count, width Count)
end 'Shape'

function main() returns ExitCode
	var bytes = ByteArray.create(0)

	for i in 0 upto 5 'fill'
		bytes.push((65 + i mod 20) as Byte)
	end 'fill'

	let w1 = bytes.count() * 3
	let w2 = bytes.count() * 5
	let w3 = bytes.count() * 7
	let w4 = bytes.count() * 11
	let w5 = bytes.count() * 13
	let w6 = bytes.count() * 17
	let w7 = bytes.count() * 19
	let w8 = bytes.count() * 23
	let found = bytes.containsWhere(urlIsDigit)
	let depth = bytes.count() * 29 + 1
	let shape = Shape.sized(bytes.count() * 31 + 2, width: w1)

	match shape 'which'
		empty then print("empty\n")
		sized(size, width) then let depth = size + width
	end 'which'

	print("after {depth} {w1} {w2} {w3} {w4} {w5} {w6} {w7} {w8} {found}\n") // anchor: after

	return 0
end 'main'
