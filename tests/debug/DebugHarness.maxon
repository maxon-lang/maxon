// DebugHarness.maxon — the shared half every case under `tests/debug/` reaches for: the compiler it
// spawns, staging a fixture, building it, running a driver at it, and reading back what one printed.
//
// ⭐⭐ **THE RUNNER AND THE SUBJECT ARE THE SAME BINARY, AND NOTHING OUTSIDE CLOSES THAT.** `maxon test
// tests/debug` both runs these cases and provides the compiler they spawn — named by
// `TestedCompilerStem` and by nothing else — so a runner broken badly enough to report green having run
// nothing cannot detect itself. READ THE PASS COUNT.
//
// ⛔ **EVERY FREE FUNCTION IN A DIRECTORY SHARES ONE NAMESPACE, whatever its visibility** (E3006). So the
// corpus gets ONE shared half, exported from this file, and a case file beside it declares only what that
// case alone uses. A file-private `let` does NOT collide, so a constant declared twice is the half nothing
// catches: every constant this corpus shares is declared here.
//
// ⛔ **EVERYTHING THAT WOULD STOP A CASE RUNNING AT ALL PANICS RATHER THAN FAILING AN ASSERTION**: a
// missing compiler, an unspellable path, a spawn that never happened. None of those is a driver answering
// wrongly, so none of them may reach a reader as a failed assertion about one.
//
// ⛔ **THIS FILE'S PATHS ARE RELATIVE TO THE CHECKOUT ROOT**, which is the working directory a test binary
// inherits from `maxon test`. Everything handed to a child is made absolute first, because a relative path
// resolves against the child's directory on POSIX and the parent's on Windows.
//
// ⛔ **ONE SPAWNING `test` PER FILE, AND EVERY CASE STAGES INTO A DIRECTORY NAMED FOR ITSELF**, because
// `maxon test` runs files concurrently and two cases sharing a staging tree would race over one output
// path.

// Where the corpus lives and where a runnable copy is built, both relative to the checkout root. Staging
// goes to gitignored `temp/`: a live `.maxon` under `tests/` is one `maxon fmt` over the checkout rewrites.
let FixturesDirName = "tests/debug/fixtures"
export let SpansFixtureName = "spans"
let StagingRootDirName = "temp/debug"

// The stored-name mapping, `tests/README.md` rule 1: `<name>.fixture -> <name>`.
let StoredFixtureSuffix = ".fixture"
export let StagedProgramFileName = "main.maxon"

// The binary this directory spawns, relative to the checkout root and without its host suffix. It is the
// compiler under test AND the debug driver under test. ONE constant, so the SUBJECT axis cannot move when
// the RUNNER does.
export let TestedCompilerStem = "maxon-bin/.maxon/maxon"

// The command line one build is run from: `build <staged>/main.maxon -o <staged>/out[.exe]`.
// `-o` is what keeps the build out of the tree lock, so two case files can compile at once.
let BuildCommandName = "build"
let OutputOption = "-o"
let OutputFileStem = "out"

// How a declaration is recognized in the staged fixture source.
export let FunctionDeclarationPrefix = "function "
export let DeclarationNameEnd = "("

// The read-only sidecar surface every dump case in this directory goes through.
export let DebugSubcommandName = "debug"
export let DumpInfoOptionName = "--dump-info"

// The folds every reader in this directory applies to a captured stream: CR dropped, so a Windows
// console's line endings do not decide what a row says or where one ends; tabs folded to spaces, so a
// column written with either separates two words.
export let LineFeed = "\n"
let CarriageReturn = "\r"
let Space = " "
let Tab = "\t"

// The separator this file's own paths are spelled with, folded into the host's by `stagingDir`.
let PathSeparator = "/"

// How the dump writes its numbers, and the ASCII runs their digits come from. Spelled as numbers rather
// than as character literals, which a receiver position cannot carry.
export let HexPrefix = "0x"
let HexBase = 16
export let DecimalBase = 10
let HexLetterValue = 10
let AsciiDigitZero = 48
let AsciiDigitNine = 57
let AsciiLowerA = 97
let AsciiLowerF = 102
let AsciiUpperA = 65
let AsciiUpperF = 70

// A number the dump printed — a code offset, a size, a tally.
export typealias SidecarNumber = int(0 to u64.max)

// One hex digit's value.
typealias HexDigitValue = int(0 to 15)

// A list of paths one directory walk produced. Stdlib's own `FilePathArray` is a member of `Directory` and
// has no file-scope spelling.
typealias PathArray = Array with FilePath

// ============================================================================================
// STAGING AND SPAWNING
// ============================================================================================

// A runnable copy of one fixture program under a directory named for the CASE, so concurrent case files
// never share a staging tree. Absolute, because it is handed to a child as its working directory. The
// previous run's files go first: a stale executable or a stale sidecar would let a build that produced
// neither be read as though it had.
//
// The FIXTURE is a required parameter and the CASE LABEL is not the fixture's name: two cases staging the
// same program still need two trees, and one case may need a fixture another has no use for.
export function stagedProgram(caseLabel String, fixture String) returns FilePath
	let staged = stagingDir("{StagingRootDirName}{PathSeparator}{caseLabel}")
	clearStagedFiles(staged)

	let stored = fixtureDir("{FixturesDirName}{PathSeparator}{fixture}").join("{StagedProgramFileName}{StoredFixtureSuffix}")
	let body = try File.readText(stored) otherwise panic("debug tests: the gate could not run — could not read the stored fixture {stored.toString()}.")
	try File.writeText(staged.join("{StagedProgramFileName}"), content: body) otherwise panic("debug tests: the gate could not run — could not stage {StagedProgramFileName} into {staged.toString()}.")

	return staged
end 'stagedProgram'

// Compile the staged program, with whatever extra flag this build is asking about.
export function spawnBuild(staged FilePath, label String, extraArguments StringArray) returns CollectedOutput
	var arguments = StringArray.create()
	arguments.push(BuildCommandName)
	arguments.push(staged.join("{StagedProgramFileName}").toString())
	arguments.push(OutputOption)
	arguments.push(builtExecutable(staged).toString())
	for extra in extraArguments 'eachExtra'
		arguments.push(extra)
	end 'eachExtra'

	return spawnCompiler(arguments, staged: staged, what: "the '{label}' build")
end 'spawnBuild'

// One child compiler, run in the staging tree. A binary that is not there and a spawn that never happened
// both stop a case running at all, so both panic naming what was being asked for.
export function spawnCompiler(arguments StringArray, staged FilePath, what String) returns CollectedOutput
	let binary = testedCompilerPath()
	if not File.exists(binary) 'noBinary'
		panic("debug tests: the gate could not run — {what} needs a compiler at {binary.toString()} and there is none. This file's paths are relative to the CHECKOUT ROOT (see the header); run it from there, and build `{TestedCompilerStem}` first.")
	end 'noBinary'

	var config = Configuration.create(Executable.path(binary))
	config.arguments = arguments
	config.workingDirectory = staged

	return try config.run() otherwise (e) 'spawnFailed'
		panic("debug tests: the gate could not run — could not spawn {what} ({e.displayReason()}).")
	end 'spawnFailed'
end 'spawnCompiler'

// Where a build's executable lands: ONE path per staging directory, never one per run, because the output
// basename reaches the emitted image — on Mach-O it is the ad-hoc signature's identifier, whose length
// moves the `__LINKEDIT` sizes. The host suffix is spelled INTO the `-o` argument rather than left for the
// compiler to append, so the path handed to the child and the path read back are one spelling.
export function builtExecutable(staged FilePath) returns FilePath
	return staged.join("{OutputFileStem}{executableSuffix()}")
end 'builtExecutable'

// `<compiler> debug --dump-info <exe> [section...]`. The sections ride as trailing arguments because that
// is what the command line takes — naming none prints the whole sidecar, which is the default this corpus
// must not let move.
export function spawnDumpInfo(executable FilePath, staged FilePath, sections StringArray) returns CollectedOutput
	var arguments = StringArray.create()
	arguments.push(DebugSubcommandName)
	arguments.push(DumpInfoOptionName)
	arguments.push(executable.toString())
	for section in sections 'eachSection'
		arguments.push(section)
	end 'eachSection'

	return spawnCompiler(arguments, staged: staged, what: "`{TestedCompilerStem} {DebugSubcommandName} {DumpInfoOptionName}`")
end 'spawnDumpInfo'

// The compiler under test, absolute and with the suffix this host can spawn.
function testedCompilerPath() returns FilePath
	let spelled = "{TestedCompilerStem}{executableSuffix()}"
	let relative = try FilePath.from(spelled) otherwise panic("debug tests: the gate could not run — '{spelled}' is not a spellable path")

	return relative.resolve(Directory.currentPath())
end 'testedCompilerPath'

function executableSuffix() returns String
	#if os(Windows)
		let suffix = ".exe"
	#else
		let suffix = ""
	#endif

	return suffix
end 'executableSuffix'

// ============================================================================================
// READING A CAPTURED STREAM — the folds every case in this directory shares
// ============================================================================================

export function withoutCarriageReturns(raw String) returns String
	return raw.replace(CarriageReturn, with: "")
end 'withoutCarriageReturns'

function outputLines(raw String) returns StringArray
	return withoutCarriageReturns(raw).split(LineFeed)
end 'outputLines'

// A list of rows as the text a failure report shows, so a disagreement reads as a listing rather than as
// an array identity. EMPTY for an empty list, which is what lets a roster assertion be an `isEmpty` over
// the very text a reader has to act on.
export function renderedRows(rows StringArray) returns String
	var rendered = ""
	for row in rows 'eachRow'
		rendered.append("{LineFeed}  {row}")
	end 'eachRow'

	return rendered
end 'renderedRows'

// A row's words, with the runs of spacing the dump lays its columns out with dropped.
export function whitespaceTokens(row String) returns StringArray
	var tokens = StringArray.create()
	for piece in row.replace(Tab, with: Space).split(Space) 'eachPiece'
		if not piece.isEmpty() 'aWord'
			tokens.push(piece)
		end 'aWord'
	end 'eachPiece'

	return tokens
end 'whitespaceTokens'

// ============================================================================================
// NUMBERS THE DUMP PRINTS
// ============================================================================================

// A hex token's value. An optional `0x` opens it and the digits are read until the first character that
// is not one, so a token carrying no digits reads 0 — which fails the assertion that consumes it rather
// than standing in for a number nobody published.
export function hexValue(token String) returns SidecarNumber
	var value = 0
	for c in token.trim().replace(HexPrefix, with: "") 'eachCharacter'
		if not isHexDigit(c) 'pastTheDigits'
			break
		end 'pastTheDigits'

		value = value * HexBase + hexDigitValue(c)
	end 'eachCharacter'

	return value
end 'hexValue'

export function isHexDigit(c Character) returns bool
	let code = try c.asciiValue() otherwise return false

	return (code >= AsciiDigitZero and code <= AsciiDigitNine) or (code >= AsciiLowerA and code <= AsciiLowerF) or (code >= AsciiUpperA and code <= AsciiUpperF)
end 'isHexDigit'

// A hex digit's value. The caller has already classified `c`, so the conversion cannot fail.
export function hexDigitValue(c Character) returns HexDigitValue
	let code = try c.asciiValue() otherwise panic("debug tests: hexDigitValue is reached only past a digit test")
	if code <= AsciiDigitNine 'aDecimalDigit'
		return code - AsciiDigitZero
	end 'aDecimalDigit'

	if code <= AsciiUpperF 'anUpperCaseLetter'
		return code - AsciiUpperA + HexLetterValue
	end 'anUpperCaseLetter'

	return code - AsciiLowerA + HexLetterValue
end 'hexDigitValue'

// ============================================================================================
// READING THE STAGED FIXTURE — the roster every case here derives rather than writes down
// ============================================================================================

// The staged program's lines, CR folded. Read on demand rather than held: every case that wants them
// has already paid for a spawned compile.
export function stagedSourceLines(staged FilePath) returns StringArray
	let path = staged.join("{StagedProgramFileName}")
	let body = try File.readText(path) otherwise panic("debug tests: the gate could not run — could not read the staged program at {path.toString()}, which this process wrote moments ago.")

	return outputLines(body)
end 'stagedSourceLines'

// The functions the staged program DECLARES, in source order. Derived from the source rather than listed
// in a case file, so a fixture that grows a function grows every roster checked against it.
//
// ⚠ The prefix is unindented on purpose: a `static function` inside a `type` opens with a TAB, and a
// method is not what a case asking "which functions did this file declare" means.
export function declaredFunctionNames(staged FilePath) returns StringArray
	var names = StringArray.create()
	for line in stagedSourceLines(staged) 'eachLine'
		if line.startsWith(FunctionDeclarationPrefix) 'aDeclaration'
			names.push(declaredNameIn(line))
		end 'aDeclaration'
	end 'eachLine'

	return names
end 'declaredFunctionNames'

// The name in a `function NAME(…)` line.
function declaredNameIn(line String) returns String
	let open = try line.findFirst(DeclarationNameEnd) otherwise panic("debug tests: the gate could not run — the staged fixture line '{line}' opens a declaration and spells no '{DeclarationNameEnd}'.")

	return line.slice(line.startIndex(), endIndex: open).replace(FunctionDeclarationPrefix, with: "").trim()
end 'declaredNameIn'

// ============================================================================================
// DIRECTORIES
// ============================================================================================

// Delete every file under a staging directory, leaving the directories. Enough for a re-run: a case stages
// the same shape every time, and the previous run's products must not survive into a comparison.
function clearStagedFiles(dir FilePath)
	for entry in listing(dir) 'eachEntry'
		if Directory.isDirectory(entry) 'aDirectory'
			clearStagedFiles(entry)
			continue
		end 'aDirectory'

		try File.delete(entry) otherwise panic("debug tests: the gate could not run — could not clear {entry.toString()} from a previous run's staging tree.")
	end 'eachEntry'
end 'clearStagedFiles'

// A directory this corpus's paths name, refused loudly when it is not there: every such refusal is the
// working-directory contract in the header not being met.
function fixtureDir(spelled String) returns FilePath
	let path = try FilePath.from(spelled) otherwise panic("debug tests: the gate could not run — '{spelled}' is not a spellable path")
	if not Directory.isDirectory(path) 'notThere'
		panic("debug tests: the gate could not run — there is no directory at '{spelled}'. Every path in this corpus is relative to the CHECKOUT ROOT, which is the working directory a test binary inherits from `maxon test`; a run started anywhere else finds nothing.")
	end 'notThere'

	return path
end 'fixtureDir'

// A directory this run writes into, created ancestor by ancestor so a fresh checkout without `temp/` is not
// a failure, and absolute because it is handed to a child process as its working directory.
function stagingDir(spelled String) returns FilePath
	var prefix = ""
	for component in spelled.split(PathSeparator) 'eachComponent'
		prefix = component if prefix.isEmpty() else "{prefix}{PathSeparator}{component}"
		let ancestor = try FilePath.from(prefix) otherwise panic("debug tests: the gate could not run — '{prefix}' is not a spellable path")
		if not Directory.create(ancestor) 'couldNotCreate'
			panic("debug tests: the gate could not run — could not create '{prefix}'. It is where a case's runnable copy is built; nothing can be staged without it.")
		end 'couldNotCreate'
	end 'eachComponent'

	let path = try FilePath.from(spelled) otherwise panic("debug tests: the gate could not run — '{spelled}' is not a spellable path")
	return path.resolve(Directory.currentPath())
end 'stagingDir'

// What one directory holds.
function listing(dir FilePath) returns PathArray
	return try Directory.list(dir) otherwise panic("debug tests: the gate could not run — could not list {dir.toString()}")
end 'listing'
