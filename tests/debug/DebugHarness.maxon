let TraceeProcDirectory = "/proc"

typealias TraceeThreadIds = Array with DebuggeeThreadId
typealias TraceeTally = int(0 to u32.max)

type TraceeRoster
	var ids as TraceeThreadIds

	static function create() returns TraceeRoster
		return Self{ids: TraceeThreadIds.create(0)}
	end 'create'

	function count() returns Count
		return self.ids.count()
	end 'count'

	function knows(thread DebuggeeThreadId) returns bool
		for id in self.ids 'eachThread'
			if id == thread 'thisOne'
				return true
			end 'thisOne'
		end 'eachThread'

		return false
	end 'knows'

	function note(thread DebuggeeThreadId)
		if not self.knows(thread) 'aNewThread'
			self.ids.push(thread)
		end 'aNewThread'
	end 'note'

	function lines() returns StringArray
		let spelled = StringArray.create(0)

		for id in self.ids 'eachThread'
			spelled.push("{id}")
		end 'eachThread'

		return spelled
	end 'lines'
end 'TraceeRoster'

type TracedChild
	export var child as StreamingSubprocess
	export var trace as ProcessTrace
	export let pid as Pid
	export let threads as StringArray
	export let staged as FilePath

	static function create(child StreamingSubprocess, trace ProcessTrace, pid Pid, threads StringArray, staged FilePath) returns TracedChild
		return Self{child: child, trace: trace, pid: pid, threads: threads, staged: staged}
	end 'create'

	// The tree is ended first because `endTree` answers `unconfirmed` once the child is released, and
	// the verdict is required last so a survivor still leaves the staging removed and the trace
	// closed.
	export function release()
		let treeEnd = self.child.endTree()
		self.child.release()
		self.trace.close()
		discardStagedDir(self.staged)
		requireTreeEnd(treeEnd, what: "the traced program, process {self.pid}")
	end 'release'
end 'TracedChild'

function unservicedTracee(caseLabel String) returns TracedChild
	let staged = builtFixture(caseLabel, fixture: TraceeFixtureName)
	let child = try StreamingSubprocess.spawnTraceable(Executable.path(builtExecutable(staged)), arguments: StringArray.create(0), workingDirectory: WorkingDirectory.at(staged), environment: Environment.inherit, traced: true) otherwise panic("tracee: the traced spawn of the built fixture was refused")
	let process = try child.processId() otherwise panic("tracee: the spawned child recorded no process id")

	return TracedChild.create(child, trace: ProcessTrace.create(), pid: process, threads: StringArray.create(0), staged: staged)
end 'unservicedTracee'

function startedTracee(caseLabel String) returns TracedChild
	let spawned = unservicedTracee(caseLabel)
	let roster = traceeServiced(spawned.trace, child: spawned.child, process: spawned.pid as DebuggeeProcessId)

	if roster.count() < TraceeThreadsNeeded 'tooFewThreads'
		panic("tracee: the case needs a traced child with a second thread alive, and the child reported only {roster.count()} before the {TraceeLaunchDeadlineMs} ms deadline. Its threads: {listedLines(roster.lines())}")
	end 'tooFewThreads'

	// After `go` the child exits and nothing services its trace, so its threads die traced and stay
	// unreaped zombies: the state each case waits on.
	try spawned.child.writeStdinLine(TraceeGoLine) otherwise panic("tracee: the child's stdin refused the go line")

	return TracedChild.create(spawned.child, trace: spawned.trace, pid: spawned.pid, threads: roster.lines(), staged: spawned.staged)
end 'startedTracee'

function traceeSawReady(pump ChildPump) returns bool
	let event = pump.poll()

	match event 'event'
		said(stream, text) then return stream == StdioStream.stdout and text == TraceeReadyLine
		closed or
		silent or
		exhausted then return false
		broke(stream, reason) then panic("tracee: reading the child's {stream.name} failed ({reason})")
	end 'event'
end 'traceeSawReady'

function traceeServiced(trace ProcessTrace, child StreamingSubprocess, process DebuggeeProcessId) returns TraceeRoster
	let pump = try ChildPump.of(child) otherwise panic("tracee: the child's output could not be taken")
	let roster = TraceeRoster.create()
	var ready = false
	var quiet = 0 as TraceeTally
	var slices = 0 as TraceeTally

	while slices * TraceeServiceSliceMs < TraceeLaunchDeadlineMs and not (ready and roster.count() >= TraceeThreadsNeeded and quiet >= TraceeQuietSlices) 'untilSettled'
		slices = slices + 1

		let report = trace.wait(TraceeServiceSliceMs as DebuggeeWaitMs, process: process)

		quiet = 0 if report.arrived() else quiet + 1
		traceeAnswered(trace, report: report, process: process, roster: roster)
		ready = ready or traceeSawReady(pump)
	end 'untilSettled'

	pump.stop()

	return roster
end 'traceeServiced'

function traceeAnswered(trace ProcessTrace, report TraceReport, process DebuggeeProcessId, roster mutable TraceeRoster)
	match report 'which'
		nothing or
		exited or
		killed then return
		stopped(thread, signal, event) then traceeResumed(trace, thread: thread, signal: signal, event: event, process: process, roster: roster)
	end 'which'
end 'traceeAnswered'

function traceeResumed(trace ProcessTrace, thread DebuggeeThreadId, signal DebuggeeSignal, event TraceEvent, process DebuggeeProcessId, roster mutable TraceeRoster)
	if roster.count() == 0 'theExecStop'
		_ = trace.configure(process)
	end 'theExecStop'

	roster.note(thread)

	_ = trace.resume(thread, signal: traceeSignalToHandOn(signal, event: event), stepping: false)
end 'traceeResumed'

function traceeSignalToHandOn(signal DebuggeeSignal, event TraceEvent) returns DebuggeeSignal
	if event != TraceEvent.signalStop or signal == TraceeSignalTrap or signal == TraceeSignalStop 'ours'
		return NoTraceSignal
	end 'ours'

	return signal
end 'traceeSignalToHandOn'

#if os(Linux)
	let TraceeWaitDeadlineMs = 10000
	let TraceeHeldObserveBudgetMs = 5000

	typealias TraceeWaitReturnedCell = SharedValue with bool

	function traceeWaitedOn(child StreamingSubprocess, deadline WaitDeadline, returned TraceeWaitReturnedCell) returns ExitInt
		let code = try child.wait(deadline) otherwise panic("tracee: the wait on the traced child failed")

		returned.publish(true)

		return code
	end 'traceeWaitedOn'

	function traceeWaitOutcome(tracee TracedChild, deadline WaitDeadline) returns (bool, ExitInt)
		let returned = TraceeWaitReturnedCell.create(false)
		let waiting = async traceeWaitedOn(tracee.child, deadline: deadline, returned: returned.clone())
		var waitedMs = 0 as TraceeTally

		while not returned.current() and waitedMs < TraceeWaitDeadlineMs 'untilItReturns'
			sleep(TraceeServiceSliceMs)

			waitedMs = waitedMs + TraceeServiceSliceMs
		end 'untilItReturns'

		let returnedInTime = returned.current()

		if not returnedInTime 'unstick'
			_ = tracee.child.pollExit()
		end 'unstick'

		let code = await waiting

		return (returnedInTime, code)
	end 'traceeWaitOutcome'

	function heldTraceeWaitOutcome(tracee TracedChild, settleMs Milliseconds) returns (bool, bool)
		let returned = TraceeWaitReturnedCell.create(false)
		let waiting = async traceeWaitedOn(tracee.child, deadline: WaitDeadline.none, returned: returned.clone())

		sleep(settleMs)

		let returnedWhileHeld = returned.current()
		let report = tracee.trace.wait(TraceeHeldObserveBudgetMs as DebuggeeWaitMs, process: tracee.pid as DebuggeeProcessId)
		let stopStillPending = match report 'which'
			stopped gives true
			nothing or
			exited or
			killed gives false
		end 'which'

		_ = tracee.child.endTree()

		waiting.cancel()

		return (returnedWhileHeld, stopStillPending)
	end 'heldTraceeWaitOutcome'
#endif
