// DebugHarness.maxon — the shared half every case under `tests/debug/` reaches for: the compiler it
// spawns, staging a fixture, building it, running a driver at it, and reading back what one printed.
//
// ⭐⭐ **THE RUNNER AND THE SUBJECT ARE THE SAME BINARY, AND NOTHING OUTSIDE CLOSES THAT.** `maxon test
// tests/debug` both runs these cases and provides the compiler they spawn — named by
// `TestedCompilerStem` and by nothing else — so a runner broken badly enough to report green having run
// nothing cannot detect itself. READ THE PASS COUNT.
//
// ⛔ **EVERY FREE FUNCTION IN A DIRECTORY SHARES ONE NAMESPACE, whatever its visibility** (E3006).
// So the corpus gets ONE shared half, exported from this file, and a case file beside it declares
// only what that case alone uses. A constant collides the same way, and a copy in another directory
// does not, which is the half nothing catches: every constant this corpus shares is declared here or in
// `tests/support/`.
//
// ⛔ **EVERYTHING THAT WOULD STOP A CASE RUNNING AT ALL PANICS RATHER THAN FAILING AN ASSERTION**: a
// missing compiler, an unspellable path, a spawn that never happened. None of those is a driver answering
// wrongly, so none of them may reach a reader as a failed assertion about one.
//
// ⛔ **THIS FILE'S PATHS ARE RELATIVE TO THE CHECKOUT ROOT**, which is the working directory a test binary
// inherits from `maxon test`. Everything handed to a child is made absolute first, because a relative path
// resolves against the child's directory on POSIX and the parent's on Windows.
//
// ⛔ **ONE SPAWNING `test` PER FILE, AND EVERY CASE STAGES INTO A DIRECTORY NAMED FOR ITSELF**, because
// the cases of one process share its test scratch directory and two cases sharing a staging tree
// would write one output path.

// Where the corpus lives, relative to the checkout root. Staging goes to this process's test scratch
// directory outside the checkout (`testScratchDir`): a live `.maxon` under `tests/` is one `maxon fmt`
// over the checkout rewrites.
let FixturesDirName = "tests/debug/fixtures"
let SpansFixtureName = "spans"
let GreenThreadFixtureName = "greenthread"

// How a declaration is recognized in the staged fixture source.
let FunctionDeclarationPrefix = "function "
let DeclarationNameEnd = "("

// How the dump writes its numbers, and the ASCII runs their digits come from. Spelled as numbers rather
// than as character literals, which a receiver position cannot carry.
let HexPrefix = "0x"
let HexBase = 16

// ============================================================================================
// THE DUMP'S SECTIONS
// ============================================================================================

// Every section heading the dump prints. The roster is complete because a section ends where the NEXT one
// begins: a heading missing from it would have its rows read as the previous section's.
let DumpFilesHeading = "files ("
let DumpFunctionsHeading = "functions ("
let DumpTypesHeading = "types ("
let DumpLineTableHeading = "line table ("
let DumpInlineSitesHeading = "inline sites ("
let DumpInlineRangesHeading = "inline ranges ("
let DumpGlobalsSectionHeading = "globals ("
let DumpLayoutSectionHeading = "layout ("

let RosterGlobalName = "__gt_allg"
let RosterLengthGlobalName = "__gt_allglen"
let DebugStreamGlobalName = "__ds_base"

let SidecarNameTerminator = ":"

function sidecarTableNames(rows StringArray, names StringArray, published bool) returns StringArray
	let matching = StringArray.create(0)

	for name in names 'eachName'
		if sidecarTableRowsName(rows, name: name) == published 'wanted'
			matching.push(name)
		end 'wanted'
	end 'eachName'

	return matching
end 'sidecarTableNames'

function sidecarTableRowsName(rows StringArray, name String) returns bool
	for row in rows 'eachRow'
		for token in whitespaceTokens(row) 'eachToken'
			if token.replace(SidecarNameTerminator, with: "") == name 'namesIt'
				return true
			end 'namesIt'
		end 'eachToken'
	end 'eachRow'

	return false
end 'sidecarTableRowsName'

// The rows under one section heading: every line after it, up to the line that opens the NEXT section. A
// heading nothing opens yields no rows, which the caller reports as the section being absent.
function dumpSectionRows(dump String, heading String) returns StringArray
	let rows = StringArray.create(0)
	var inSection = false

	for rawLine in dump.split(LineFeed) 'eachLine'
		let line = rawLine.trim()

		if line.startsWith(heading) 'opensThisSection'
			inSection = true
			continue
		end 'opensThisSection'

		if not inSection 'beforeTheSection'
			continue
		end 'beforeTheSection'

		if opensASection(line) 'nextSection'
			break
		end 'nextSection'

		if not line.isEmpty() 'aRow'
			rows.push(line)
		end 'aRow'
	end 'eachLine'

	return rows
end 'dumpSectionRows'

function opensASection(line String) returns bool
	return line.startsWith(DumpFilesHeading) or line.startsWith(DumpFunctionsHeading) or line.startsWith(DumpTypesHeading) or line.startsWith(DumpLineTableHeading) or line.startsWith(DumpInlineSitesHeading) or line.startsWith(DumpInlineRangesHeading) or line.startsWith(DumpGlobalsSectionHeading) or line.startsWith(DumpLayoutSectionHeading)
end 'opensASection'

// ============================================================================================
// NUMBERS THE DUMP PRINTS
// ============================================================================================

// A hex token's value. An optional `0x` opens it and the digits are read until the first character that
// is not one, so a token carrying no digits reads 0 — which fails the assertion that consumes it rather
// than standing in for a number nobody published.
function hexValue(token String) returns PrintedNumber
	var value = 0 as PrintedNumber

	for c in token.trim().replace(HexPrefix, with: "") 'eachCharacter'
		match hexDigitOf(c) 'digit'
			value(digit) then value = value * HexBase + (digit as PrintedNumber)
			notAHexDigit then break 'eachCharacter'
		end 'digit'
	end 'eachCharacter'

	return value
end 'hexValue'

function hexDigitOf(c Character) returns UrlHexDigitReading
	let code = try c.asciiValue() otherwise return UrlHexDigitReading.notAHexDigit

	return urlHexDigitOf(code as Byte)
end 'hexDigitOf'

// ============================================================================================
// READING THE STAGED FIXTURE — the roster every case here derives rather than writes down
// ============================================================================================

// Every line of every staged source, CR folded — the roster a case over a multi-file fixture derives its
// demands from.
function everyStagedSourceLine(staged FilePath) returns StringArray
	let lines = StringArray.create(0)

	for entry in listing(staged) 'eachEntry'
		if not entry.filename().endsWith(MaxonSourceSuffix) 'notASource'
			continue
		end 'notASource'

		for line in linesOfStagedSource(entry) 'eachLine'
			lines.push(line)
		end 'eachLine'
	end 'eachEntry'

	return lines
end 'everyStagedSourceLine'

// The functions the staged program DECLARES, in source order. Derived from the source rather than listed
// in a case file, so a fixture that grows a function grows every roster checked against it.
//
// ⚠ The prefix is unindented on purpose: a `static function` inside a `type` opens with a TAB, and a
// method is not what a case asking "which functions did this file declare" means.
function declaredFunctionNames(staged FilePath) returns StringArray
	let names = StringArray.create(0)

	for line in linesOfStagedSource(staged.join(StagedProgramFileName)) 'eachLine'
		if line.startsWith(FunctionDeclarationPrefix) 'aDeclaration'
			names.push(declaredNameIn(line))
		end 'aDeclaration'
	end 'eachLine'

	return names
end 'declaredFunctionNames'

// The name in a `function NAME(…)` line.
function declaredNameIn(line String) returns String
	let open = try line.findFirst(DeclarationNameEnd) otherwise panic("debug tests: the gate could not run — the staged fixture line '{line}' opens a declaration and spells no '{DeclarationNameEnd}'.")

	return line.slice(line.startIndex(), endIndex: open).replace(FunctionDeclarationPrefix, with: "").trim()
end 'declaredNameIn'

// ============================================================================================
// THE DEBUGGER: FIXTURES, THE `maxon debug` FACES, AND THE EVENTS ONE PRINTS
// ============================================================================================

let SteppingFixtureName = "stepping"
let ValuesFixtureName = "values"
let InlinedFixtureName = "inlined"
let FuzzyFixtureName = "fuzzy"
let CoroutineFixtureName = "coroutine"
let HeaplessFixtureName = "heapless"
let LongTextFixtureName = "longtext"
let CrashFixtureName = "crash"
let SpinFixtureName = "spin"
let LongCallFixtureName = "longcall"
let TestBodyFixtureName = "testbody"
let LeafPairFixtureName = "leafpair"
let ExitCascadeFixtureName = "exitcascade"
let PromotedDropFixtureName = "promoteddrop"
let PromotedValueFixtureName = "promotedvalue"
let LeafFoldFixtureName = "leaffold"
let CastLineFixtureName = "castline"
let ClosuresFixtureName = "closures"
let TestBodyTestFileName = "doubling.maxtest"
let TestBodyLibraryFileName = "doubling.maxon"
let GenericsFixtureName = "generics"
let SplicedFixtureName = "spliced"
let TwoPassFixtureName = "twopass"
let LoopsFixtureName = "loops"
let TwoDirsFixtureName = "twodirs"
let PrologueFixtureName = "prologue"
let WalksFixtureName = "walks"
let EnderFixtureName = "ender"
let FaultCalleeFixtureName = "faultcallee"
let HotConditionFixtureName = "hotcondition"
let HotServiceFixtureName = "hotservice"
let LeadingCallFixtureName = "leadingcall"
let SplicedClosureFixtureName = "splicedclosure"
let InlineStressFixtureName = "inlinestress"
let SplicedLoopFixtureName = "splicedloop"
let SplicedLibraryCallFixtureName = "splicedlibrarycall"
let StaleStepFixtureName = "stalestep"
let TableChurnFixtureName = "tablechurn"
let HoldConflictFixtureName = "holdconflict"
let SpilledVarFixtureName = "spilledvar"
let SiblingArmsFixtureName = "siblingarms"
let RivalArmFixtureName = "rivalarm"
let RivalLoopFixtureName = "rivalloop"
let DeadStoreFixtureName = "deadstore"
let DeadSplitFixtureName = "deadsplit"
let DeadPhiFixtureName = "deadphi"
let ScopeShadowFixtureName = "scopeshadow"
let BorrowedVarFixtureName = "borrowedvar"
let ScopeSplitFixtureName = "scopesplit"
let PhiBorrowFixtureName = "phiborrow"
let ReboundTotalFixtureName = "reboundtotal"
let EqualBindsFixtureName = "equalbinds"
let LoopBreakFixtureName = "loopbreak"
let ArmScopeFixtureName = "armscope"
let LogicLineFixtureName = "logicline"
let VoidCallFixtureName = "voidcall"
let RecursionFixtureName = "recursion"
let LibraryCallbackFixtureName = "librarycallback"
let ValueCallFixtureName = "valuecall"
let ParkingCallFixtureName = "parkingcall"
let ServiceHandlerFixtureName = "servicehandler"

let DebugBatchOption = "--batch"
let DebugCommandsOptionPrefix = "--commands="
let DebugCompleteOptionPrefix = "--complete="
let DebugStopTimeoutOptionPrefix = "--stop-timeout="
let DebugTargetEnvOptionPrefix = "--target-env="
let NoDebugAgentOption = "--no-debug-agent"
let CommandSeparator = ";"

typealias EventIndex = int(0 to u32.max)
typealias EventTally = int(0 to u32.max)
typealias EventNumber = int(i64.min to i64.max)
typealias JsonDocArray = Array with JsonDoc

// What a reader answers for a key an event does not carry. The caller reports the absence naming the
// key and printing the whole event, exactly as `describedLocalType` reports an absent local row.
let AbsentEventText = ""
let AbsentEventNumber = i64.min

let JsonObjectOpen = "\{"

union CodeRangeLookup
	none
	range(start PrintedNumber, limit PrintedNumber)
end 'CodeRangeLookup'

// ============================================================================================
// SPAWNING THE DRIVER'S THREE FACES
// ============================================================================================

function debugBatchArguments(executable FilePath, commands String, extraOptions StringArray) returns StringArray
	let arguments = StringArray.create(0)
	arguments.push(DebugSubcommandName)
	arguments.push(DebugBatchOption)
	arguments.push("{DebugCommandsOptionPrefix}{commands}")

	for option in extraOptions 'eachOption'
		arguments.push(option)
	end 'eachOption'

	arguments.push(executable.toString())

	return arguments
end 'debugBatchArguments'

function spawnDebugBatch(executable FilePath, staged FilePath, commands String, extraOptions StringArray, environment Environment = Environment.inherit, deadline WaitDeadline = WaitDeadline.none) returns CollectedOutput
	return spawnCompiler(debugBatchArguments(executable, commands: commands, extraOptions: extraOptions), staged: staged, what: "`{DebugSubcommandName} {DebugBatchOption}`", environment: environment, deadline: deadline)
end 'spawnDebugBatch'

union BoundedSession
	finished(run CollectedOutput)
	cutOff(stdout String, stderr String, elapsedMs DurationMs)

	export function endedInTime() returns bool
		return match self 'which'
			finished gives true
			cutOff gives false
		end 'which'
	end 'endedInTime'

	export function stdoutText() returns String
		return match self 'which'
			finished(run) gives run.stdout
			cutOff(out, _, _) gives out
		end 'which'
	end 'stdoutText'

	export function stderrText() returns String
		return match self 'which'
			finished(run) gives run.stderr
			cutOff(_, err, _) gives err
		end 'which'
	end 'stderrText'

	export function elapsedMs() returns DurationMs
		return match self 'which'
			finished(run) gives run.durationMs
			cutOff(_, _, elapsedMs) gives elapsedMs
		end 'which'
	end 'elapsedMs'

	export function exitText() returns String
		return match self 'which'
			finished(run) gives "exited {run.exitCode()} after {run.durationMs} ms"
			cutOff(_, _, elapsedMs) gives "was still running at its {elapsedMs} ms deadline and was killed with its process tree"
		end 'which'
	end 'exitText'
end 'BoundedSession'

function boundedDebugBatch(executable FilePath, staged FilePath, commands String, extraOptions StringArray, environment Environment, timeoutMs WaitDeadlineMs) returns BoundedSession
	let config = Configuration.create(Executable.path(testedCompilerPath()), workingDirectory: WorkingDirectory.at(staged))
	config.arguments = debugBatchArguments(executable, commands: commands, extraOptions: extraOptions)
	config.environment = environment
	config.deadline = WaitDeadline.within(timeoutMs)

	let run = try config.run() otherwise (failure) 'notFinished'
		return cutOffBy(failure)
	end 'notFinished'

	return BoundedSession.finished(run)
end 'boundedDebugBatch'

function cutOffBy(failure SubprocessError) returns BoundedSession
	match failure 'which'
		timeout(elapsedMs, out, err) then return BoundedSession.cutOff(out, stderr: err, elapsedMs: elapsedMs)
		treeNotEnded(elapsedMs, out, err, _) then return BoundedSession.cutOff(out, stderr: err, elapsedMs: elapsedMs)
		executableNotFound or
		spawnFailed or
		ioFailed or
		detachRefused or
		inputTooLarge or
		statusLost then panic("the gate could not run — the debug session could not run ({failure.displayReason()}).")
	end 'which'
end 'cutOffBy'

function spawnDebugComplete(executable FilePath, staged FilePath, partial String) returns CollectedOutput
	let arguments = StringArray.create(0)
	arguments.push(DebugSubcommandName)
	arguments.push("{DebugCompleteOptionPrefix}{partial}")
	arguments.push(executable.toString())

	return spawnCompiler(arguments, staged: staged, what: "`{DebugSubcommandName} {DebugCompleteOptionPrefix}`")
end 'spawnDebugComplete'

// The REPL face: no `--batch`, the script on the driver's own stdin, one command per line.
function spawnDebugRepl(executable FilePath, staged FilePath, script String) returns CollectedOutput
	return spawnCompiler([DebugSubcommandName, executable.toString()], staged: staged, what: "the `{DebugSubcommandName}` REPL", standardInput: InputSource.bytes(script))
end 'spawnDebugRepl'

// `--target-env=NAME=VALUE`, the one option that reaches the DEBUGGEE's environment rather than the
// driver's.
function targetEnvOption(name String, value String) returns String
	return "{DebugTargetEnvOptionPrefix}{name}={value}"
end 'targetEnvOption'

function debugCommandLine(commands StringArray) returns String
	var line = ""

	for command in commands 'eachCommand'
		line = command if line.isEmpty() else "{line}{CommandSeparator}{command}"
	end 'eachCommand'

	return line
end 'debugCommandLine'

// ============================================================================================
// THE BATCH EVENT STREAM — one JSON object per stdout line, asserted as PARSED FIELDS
// ============================================================================================

// ⛔ A line that OPENS an object and does not parse PANICS: `--batch` promises a pure-JSON stdout, so a
// line that is neither blank nor an object is the gate having nothing to read rather than a driver
// answering wrongly.
function batchEvents(stdout String) returns JsonDocArray
	let events = JsonDocArray.create(0)

	for rawLine in withoutCarriageReturns(stdout).split(LineFeed) 'eachLine'
		let line = rawLine.trim()

		if not line.startsWith(JsonObjectOpen) 'notAnEventLine'
			continue
		end 'notAnEventLine'

		let doc = try Json.parse(line) otherwise panic("debug tests: the gate could not run — `{DebugBatchOption}` wrote a line that opens a JSON object and does not parse: {line}")
		events.push(doc)
	end 'eachLine'

	return events
end 'batchEvents'

function eventKind(event JsonDoc) returns String
	return textOf(event, node: event.root, key: "event")
end 'eventKind'

function eventKinds(events JsonDocArray) returns StringArray
	let kinds = StringArray.create(0)

	for event in events 'eachEvent'
		kinds.push(eventKind(event))
	end 'eachEvent'

	return kinds
end 'eventKinds'

function eventsOfKind(events JsonDocArray, kind String) returns JsonDocArray
	let matching = JsonDocArray.create(0)

	for event in events 'eachEvent'
		if eventKind(event) == kind 'thisKind'
			matching.push(event.clone())
		end 'thisKind'
	end 'eachEvent'

	return matching
end 'eventsOfKind'

function eventAt(events JsonDocArray, index EventIndex) returns JsonDoc
	return try events.get(index as ElementIndex) otherwise panic("debug tests: the gate could not run — event {index} was looked up in a stream of {events.count()}")
end 'eventAt'

// ============================================================================================
// READING ONE EVENT'S FIELDS
// ============================================================================================

function textOf(doc JsonDoc, node JsonNodeId, key String) returns String
	return try doc.getString(node, key: key) otherwise AbsentEventText
end 'textOf'

function numberOf(doc JsonDoc, node JsonNodeId, key String) returns EventNumber
	return try doc.getInt(node, key: key) otherwise AbsentEventNumber
end 'numberOf'

function flagOf(doc JsonDoc, node JsonNodeId, key String) returns bool
	return try doc.getBool(node, key: key) otherwise false
end 'flagOf'

// The one node a key names, as a list of AT MOST ONE — so "the key is absent" is a count of zero
// rather than a node id standing in for nothing.
function memberOf(doc JsonDoc, node JsonNodeId, key String) returns JsonNodeIdArray
	let found = JsonNodeIdArray.create(0)
	let child = try doc.getChild(node, key: key) otherwise return found
	found.push(child)

	return found
end 'memberOf'

// The elements of an array-valued key, EMPTY when the key is absent or is not an array — which the
// caller reports as the list being missing, naming the key.
function childrenOf(doc JsonDoc, node JsonNodeId, key String) returns JsonNodeIdArray
	let children = JsonNodeIdArray.create(0)
	let arrayId = try doc.getChild(node, key: key) otherwise return children
	let length = try doc.arrayLength(arrayId) otherwise return children

	for i in 0 upto length 'eachElement'
		children.push(try doc.arrayAt(arrayId, index: i) otherwise continue)
	end 'eachElement'

	return children
end 'childrenOf'

// The whole stream as the text a failure report shows.
function renderedEvents(stdout String, stderr String) returns String
	return "It wrote to stdout:{listedLines(withoutCarriageReturns(stdout).split(LineFeed))}{LineFeed}and to stderr:{listedLines(withoutCarriageReturns(stderr).split(LineFeed))}"
end 'renderedEvents'

// ============================================================================================
// THE STAGED SOURCE — every line a case names is found by its anchor, never written down
// ============================================================================================

function stagedLinesContaining(staged FilePath, needle String) returns EventTally
	var tally = 0 as EventTally

	for line in linesOfStagedSource(staged.join(StagedProgramFileName)) 'eachLine'
		tally = tally + 1 if line.contains(needle) else tally
	end 'eachLine'

	return tally
end 'stagedLinesContaining'

// The staged program's own file name, as a `file:line` break target and an event's `file` field spell it.
// ============================================================================================
// THE DUMP'S FUNCTION AND TYPE BLOCKS — a row and the rows nested under it
// ============================================================================================

// A function row carries the frame column; a local row nested under it does not, which is what tells
// the two apart once `dumpSectionRows` has trimmed the indentation away.
let FunctionRowColumn = "frame="
let TypeFieldRowPrefix = "+0x"
let TypeRowPrefix = "["

function functionRowOf(functionRows StringArray, name String) returns String
	for row in functionRows 'eachRow'
		if row.contains(FunctionRowColumn) and firstToken(row) == name 'thisFunction'
			return row
		end 'thisFunction'
	end 'eachRow'

	return AbsentEventText
end 'functionRowOf'

function localRowsOf(functionRows StringArray, name String) returns StringArray
	let locals = StringArray.create(0)
	var inside = false

	for row in functionRows 'eachRow'
		if row.contains(FunctionRowColumn) 'aFunctionRow'
			inside = firstToken(row) == name
			continue
		end 'aFunctionRow'

		if inside 'aLocalOfThisFunction'
			locals.push(row)
		end 'aLocalOfThisFunction'
	end 'eachRow'

	return locals
end 'localRowsOf'

function declaredFunctionRows(functionRows StringArray) returns StringArray
	let rows = StringArray.create(0)

	for row in functionRows 'eachRow'
		if row.contains(FunctionRowColumn) 'aFunctionRow'
			rows.push(row)
		end 'aFunctionRow'
	end 'eachRow'

	return rows
end 'declaredFunctionRows'

function typeRowOf(typeRows StringArray, name String) returns String
	for row in typeRows 'eachRow'
		if row.startsWith(TypeRowPrefix) and typeNameIn(row) == name 'thisType'
			return row
		end 'thisType'
	end 'eachRow'

	return AbsentEventText
end 'typeRowOf'

function typeFieldRowsOf(typeRows StringArray, name String) returns StringArray
	let fields = StringArray.create(0)
	var inside = false

	for row in typeRows 'eachRow'
		if row.startsWith(TypeRowPrefix) 'aTypeRow'
			inside = typeNameIn(row) == name
			continue
		end 'aTypeRow'

		if inside and row.startsWith(TypeFieldRowPrefix) 'aFieldOfThisType'
			fields.push(row)
		end 'aFieldOfThisType'
	end 'eachRow'

	return fields
end 'typeFieldRowsOf'

// A type row is `[N] NAME KIND size=… align=… fields=…`, so its name is the second word and its kind
// the third.
function typeNameIn(row String) returns String
	return try whitespaceTokens(row).get(1) otherwise AbsentEventText
end 'typeNameIn'

function typeKindIn(row String) returns String
	return try whitespaceTokens(row).get(2) otherwise AbsentEventText
end 'typeKindIn'

// The type a local row or a field row names: everything past its last `: ` separator, because a type's
// rendering may be several words (`<generic instance>`) and a last-WORD reader answers half of one.
function describedTypeIn(row String) returns String
	let pieces = row.split(TypeSeparatorToken)

	if pieces.count() < 2 'namesNoType'
		return AbsentEventText
	end 'namesNoType'

	return (try pieces.get(pieces.count() - 1) otherwise AbsentEventText).trim()
end 'describedTypeIn'

let TypeSeparatorToken = ": "

function firstToken(row String) returns String
	return try whitespaceTokens(row).get(0) otherwise AbsentEventText
end 'firstToken'

// The `lines=` column of a function row, as a number.
function columnValueIn(row String, column String) returns PrintedNumber
	for token in whitespaceTokens(row) 'eachToken'
		if token.startsWith(column) 'thisColumn'
			return decimalValue(token.replace(column, with: ""))
		end 'thisColumn'
	end 'eachToken'

	return 0
end 'columnValueIn'

// A `[0xSTART, 0xLIMIT)` pair anywhere in a row: the function row's code range, or the scope range a
// local row carries. A location column spells `[rbp-0x18]`, which opens no pair because it does not
// close with a comma.
function codeRangeIn(row String) returns CodeRangeLookup
	let tokens = whitespaceTokens(row)

	for (iter, token) in tokens.withIterator() 'eachToken'
		if not token.startsWith(RangeOpen) or not token.endsWith(RangeSeparator) 'notARangeStart'
			continue
		end 'notARangeStart'

		let limitToken = try tokens.get(iter.index() + 1) otherwise continue

		if not limitToken.endsWith(RangeClose) 'notARangeLimit'
			continue
		end 'notARangeLimit'

		return CodeRangeLookup.range(hexValue(token.replace(RangeOpen, with: "").replace(RangeSeparator, with: "")), limit: hexValue(limitToken.replace(RangeClose, with: "")))
	end 'eachToken'

	return CodeRangeLookup.none
end 'codeRangeIn'

let RangeOpen = "[0x"
let RangeSeparator = ","
let RangeClose = ")"

// ============================================================================================
// THE VOCABULARY EVERY CASE SPELLS — commands, event names, keys and the values they take
// ============================================================================================
//
// ⛔ ONE HOME, because a copy in another directory does not collide: a command word or an event key
// written down twice is the duplication nothing in this corpus catches for you.

let BreakCommand = "break"
let ClearCommand = "clear"
let RunCommand = "run"
let ContinueCommand = "continue"
let StepCommand = "step"
let NextCommand = "next"
let FinishCommand = "finish"
let UntilCommand = "until"
let BacktraceCommand = "backtrace"
let PrintCommand = "print"
let LocalsCommand = "locals"
let QuitCommand = "quit"

let BreakpointEventName = "breakpoint"
let StopEventName = "stop"
let BacktraceEventName = "backtrace"
let LocalsEventName = "locals"
let ValueEventName = "value"
let ExitEventName = "exit"
let CrashEventName = "crash"
let TimeoutEventName = "timeout"
let ErrorEventName = "error"

let ActionKey = "action"
let FunctionKey = "function"
let FileKey = "file"
let LineKey = "line"
let ColumnKey = "col"
let ReasonKey = "reason"
let CodeKey = "code"
let FramesKey = "frames"
let BacktraceKey = "backtrace"
let LocalsKey = "locals"
let InlinedKey = "inlined"
let OffsetsKey = "offsets"
let CandidatesKey = "candidates"
let SuggestionKey = "suggestion"
let NameKey = "name"
let DisplayKey = "display"
let UnavailableKey = "unavailable"
let MessageKey = "message"
let ValueKey = "value"
let FrameKey = "frame"

let SetAction = "set"
let ClearedAction = "cleared"
let AmbiguousAction = "ambiguous"
let NoMatchAction = "no-match"
let NoCodeAction = "no-code"

let BreakpointStopReason = "breakpoint"
let StepStopReason = "step"

let OptimizedOutReason = "optimized-out"

function lineTarget(line SourceLine, file String = StagedProgramFileName) returns String
	return "{file}:{line}"
end 'lineTarget'

let HeldStopWording = "stopped ("
let HeldStopDeadlineMs = 120000

function sessionHeldAt(staged FilePath, anchor String, environment Environment = Environment.inherit) returns ReplSession
	let line = anchorLine(staged.join(StagedProgramFileName), anchor: anchor)
	let session = ReplSession.open(builtExecutable(staged), staged: staged, environment: environment)

	session.say("{BreakCommand} {lineTarget(line)}")
	session.say(RunCommand)

	if not session.sayUntilThe(HeldStopWording, deadlineMs: HeldStopDeadlineMs) 'notHeld'
		panic("the gate could not run — the program never stopped at its breakpoint at `{anchor}`. {session.said()}")
	end 'notHeld'

	return session
end 'sessionHeldAt'

// One staged, built fixture — the preamble every case in this corpus opens with, in ONE place. A build
// that failed stops the case running at all, so it panics naming the fixture rather than failing an
// assertion about a debugger that was never handed a program.
function builtFixture(caseLabel String, fixture String, extraArguments StringArray = StringArray.create(0)) returns FilePath
	let staged = stagedFixtureTree(FixturesDirName, caseLabel: caseLabel, fixture: fixture)
	_ = buildStagedSource(staged.join(StagedProgramFileName), staged: staged, what: "{fixture} for case {caseLabel}", extraArguments: extraArguments)

	return staged
end 'builtFixture'

// The program run with nothing attached — the control every case comparing a debugged run with an
// undebugged one needs, because "the answer looks right" is not the claim; "the answer is the SAME" is.
function runBuiltProgram(staged FilePath, arguments StringArray = StringArray.create(0)) returns CollectedOutput
	let program = builtExecutable(staged)

	if not File.exists(program) 'noProgram'
		panic("debug tests: the gate could not run — there is no program at {program.toString()} to run undebugged.")
	end 'noProgram'

	return spawnIn(Executable.path(program), arguments: arguments, staged: staged, what: "{program.toString()} undebugged")
end 'runBuiltProgram'

// A command repeated: the only honest way to drive a session past a breakpoint whose hit count is a
// property of the fixture's loops rather than of the debugger.
function repeatedCommand(command String, times EventTally) returns StringArray
	let commands = StringArray.create(0)

	for _ in 0 upto times 'eachRepeat'
		commands.push(command)
	end 'eachRepeat'

	return commands
end 'repeatedCommand'

function appendedCommands(first StringArray, rest StringArray) returns StringArray
	let all = StringArray.create(0)

	for command in first 'eachFirst'
		all.push(command)
	end 'eachFirst'

	for command in rest 'eachRest'
		all.push(command)
	end 'eachRest'

	return all
end 'appendedCommands'

// A string element of an array-valued key — a candidate name, a completion — read off the node itself
// rather than out of an object field, because the element IS the string.
function stringAt(doc JsonDoc, node JsonNodeId) returns String
	return doc.get(node).stringValue
end 'stringAt'

function stringsOf(doc JsonDoc, node JsonNodeId, key String) returns StringArray
	let strings = StringArray.create(0)

	for element in childrenOf(doc, node: node, key: key) 'eachElement'
		strings.push(stringAt(doc, node: element))
	end 'eachElement'

	return strings
end 'stringsOf'

// ============================================================================================
// RENDERED VALUES — a `locals` list, a `print` answer, a struct's children
// ============================================================================================

// Every value of a list as `name=display`, which is what a disagreement has to show a reader: a
// display that is wrong is only legible beside the name it was rendered for.
function valueRows(doc JsonDoc, node JsonNodeId, key String) returns StringArray
	let rows = StringArray.create(0)

	for value in childrenOf(doc, node: node, key: key) 'eachValue'
		rows.push("{textOf(doc, node: value, key: NameKey)}={textOf(doc, node: value, key: DisplayKey)}")
	end 'eachValue'

	return rows
end 'valueRows'

// The one value of a list carrying `name` — EMPTY when the list holds none, which the caller reports
// as the value being missing rather than as a wrong rendering of it.
function valueNamed(doc JsonDoc, node JsonNodeId, key String, name String) returns JsonNodeIdArray
	let found = JsonNodeIdArray.create(0)

	for value in childrenOf(doc, node: node, key: key) 'eachValue'
		if textOf(doc, node: value, key: NameKey) == name 'thisValue'
			found.push(value)
		end 'thisValue'
	end 'eachValue'

	return found
end 'valueNamed'

function nodeAt(nodes JsonNodeIdArray, index EventIndex) returns JsonNodeId
	return try nodes.get(index as ElementIndex) otherwise panic("debug tests: the gate could not run — node {index} was looked up in a list of {nodes.count()}")
end 'nodeAt'

let ChildrenKey = "children"

// A row whose code range is a PRECONDITION rather than the claim — a function row, whose
// `[0xSTART, 0xLIMIT)` the dump has printed since `sidecar-dump` first pinned it.
function requiredCodeRange(row String, what String) returns (PrintedNumber, PrintedNumber)
	match codeRangeIn(row) 'theRange'
		none then panic("debug tests: the gate could not run — {what} carries no `[0xSTART, 0xLIMIT)` code range: {row}")
		range(start, limit) then return (start, limit)
	end 'theRange'
end 'requiredCodeRange'

let MostBytesOfOneInstruction = 15

// The location column of a local row (`reg0`, `[rbp-0x70]`): the token after its code range.
function placeOfRow(row String) returns String
	let tokens = whitespaceTokens(row)

	for (iter, token) in tokens.withIterator() 'eachToken'
		if token.endsWith(RangeClose) and iter.index() > 0 and (try tokens.get(iter.index() - 1) otherwise continue).startsWith(RangeOpen) 'theRangeLimit'
			return try tokens.get(iter.index() + 1) otherwise panic("debug tests: a local row names a range and no place after it: {row}")
		end 'theRangeLimit'
	end 'eachToken'

	panic("debug tests: a local row carries no code range: {row}")
end 'placeOfRow'

// The inline site a local row names (`in [1]`), or empty for a local of the function's own text.
function inlineSiteOfRow(row String) returns String
	let tokens = whitespaceTokens(row)

	for (iter, token) in tokens.withIterator() 'eachToken'
		if token == InlineSiteWord 'theSiteWord'
			return try tokens.get(iter.index() + 1) otherwise panic("debug tests: a local row names `{InlineSiteWord}` and no site after it: {row}")
		end 'theSiteWord'
	end 'eachToken'

	return ""
end 'inlineSiteOfRow'

let InlineSiteWord = "in"

// How far two rows of one name that sit in different places overlap, or 0 when they do not overlap or
// share a place.
function overlapOfRowsInDifferentPlaces(left String, right String) returns PrintedNumber
	if placeOfRow(left) == placeOfRow(right) 'thePlaceTheyShare'
		return 0
	end 'thePlaceTheyShare'

	let (leftStart, leftLimit) = requiredCodeRange(left, what: "a local row")
	let (rightStart, rightLimit) = requiredCodeRange(right, what: "a local row")
	let overlapStart = leftStart if leftStart > rightStart else rightStart
	let overlapLimit = leftLimit if leftLimit < rightLimit else rightLimit

	return overlapLimit - overlapStart if overlapLimit > overlapStart else 0
end 'overlapOfRowsInDifferentPlaces'

function pairsOfRowsThatShadow(rows StringArray) returns StringArray
	let shadowing = StringArray.create(0)

	for (leftAt, left) in rows.withIterator() 'eachRow'
		for rightAt in leftAt.index() + 1 upto rows.count() 'eachLaterRow'
			let right = try rows.get(rightAt) otherwise panic("debug tests: rows.get OOB at {rightAt}")

			if overlapOfRowsInDifferentPlaces(left, right: right) > MostBytesOfOneInstruction 'shadows'
				shadowing.push("{left}   ///   {right}")
			end 'shadows'
		end 'eachLaterRow'
	end 'eachRow'

	return shadowing
end 'pairsOfRowsThatShadow'

function functionCodeStart(executable FilePath, staged FilePath, name String) returns PrintedNumber
	let (start, _) = requiredCodeRange(dumpedFunctionRow(executable, staged: staged, name: name), what: "`{name}`'s function row")

	return start
end 'functionCodeStart'

function functionPrologueStart(executable FilePath, staged FilePath, name String) returns PrintedNumber
	let row = dumpedFunctionRow(executable, staged: staged, name: name)
	let (start, _) = requiredCodeRange(row, what: "`{name}`'s function row")

	for token in whitespaceTokens(row) 'eachToken'
		if token.startsWith(PrologueColumn) 'thePrologueColumn'
			return start + hexValue(token.replace(PrologueColumn, with: ""))
		end 'thePrologueColumn'
	end 'eachToken'

	panic("debug tests: the gate could not run — `{name}`'s function row carries no `{PrologueColumn}` column: {row}")
end 'functionPrologueStart'

function dumpedFunctionRow(executable FilePath, staged FilePath, name String) returns String
	let dump = spawnDumpInfo(executable, staged: staged, sections: StringArray.create(0))

	if dump.exitCode() != 0 'noSidecarPrinted'
		panic("debug tests: the gate could not run — `{DebugSubcommandName} {DumpInfoOptionName} <exe>` did not print the sidecar. It wrote to stderr: {dump.stderr}")
	end 'noSidecarPrinted'

	return functionRowOf(dumpSectionRows(withoutCarriageReturns(dump.stdout), heading: DumpFunctionsHeading), name: name)
end 'dumpedFunctionRow'

let PrologueColumn = "prologue=+"

let InsideRuntimeSymbolReason = "inside-runtime-symbol"

#if arch(arm64)
	export let PushedFramePointerBytes = 4 as PrintedNumber
	export let StackSlotMark = "[x29"
#endif

#if not arch(arm64)
	let PushedFramePointerBytes = 1 as PrintedNumber
	let StackSlotMark = "[rbp"
#endif

typealias SidecarNumberArray = Array with PrintedNumber

let LinesSectionName = "lines"
let StatementRowTag = "statement"
let LineEntryRowTag = "line-entry"
let RowTagListOpen = "["
let RowTagListClose = "]"
let RowTagSeparator = ", "
let ExactOffsetMarker = "*"
let DumpPositionColumn = 1
let OffsetKey = "offset"
let RefusedAction = "refused"
let OutOfTextReason = "out-of-text"

type DumpedLineRow
	export let offset as PrintedNumber
	export let tags as StringArray

	static function create(offset PrintedNumber, tags StringArray) returns DumpedLineRow
		return Self{offset: offset, tags: tags}
	end 'create'
end 'DumpedLineRow'

typealias DumpedLineRowArray = Array with DumpedLineRow

union DumpedRowScope
	theProgram
	line(number SourceLine)
end 'DumpedRowScope'

function lowestOffsetOf(offsets SidecarNumberArray) returns PrintedNumber
	var lowest = try offsets.get(0) otherwise panic("debug tests: a line of code has at least one statement row")

	for offset in offsets 'eachOffset'
		lowest = offset if offset < lowest else lowest
	end 'eachOffset'

	return lowest
end 'lowestOffsetOf'

function armedAndClearedAtEvery(offsets SidecarNumberArray) returns StringArray
	let commands = StringArray.create(0)

	for offset in offsets 'eachOffset'
		commands.push("{BreakCommand} {exactOffsetTarget(offset)}")
		commands.push("{ClearCommand} {exactOffsetTarget(offset)}")
	end 'eachOffset'

	return commands
end 'armedAndClearedAtEvery'

function breakpointAnswersWithAction(events JsonDocArray, action String) returns EventTally
	var tally = 0 as EventTally

	for answer in eventsOfKind(events, kind: BreakpointEventName) 'eachAnswer'
		if textOf(answer, node: answer.root, key: ActionKey) == action 'thatAction'
			tally = tally + 1
		end 'thatAction'
	end 'eachAnswer'

	return tally
end 'breakpointAnswersWithAction'

function statementOffsetsOfTheProgram(executable FilePath, staged FilePath, atMost EventTally) returns SidecarNumberArray
	return statementOffsetsAmong(dumpedRowsAt(executable, staged: staged, scope: DumpedRowScope.theProgram), atMost: atMost as ElementIndex)
end 'statementOffsetsOfTheProgram'

function statementOffsetsAmong(rows DumpedLineRowArray, atMost ElementIndex) returns SidecarNumberArray
	let offsets = SidecarNumberArray.create(0)

	for row in rows 'eachRow'
		if offsets.count() >= atMost 'enough'
			break
		end 'enough'

		if row.tags.contains(StatementRowTag) and not offsets.contains(row.offset) 'aNewStatement'
			offsets.push(row.offset)
		end 'aNewStatement'
	end 'eachRow'

	return offsets
end 'statementOffsetsAmong'

function dumpedRowsAt(executable FilePath, staged FilePath, scope DumpedRowScope) returns DumpedLineRowArray
	let position = match scope 'rows'
		theProgram gives "{StagedProgramFileName}:"
		line(number) gives "{StagedProgramFileName}:{number}:"
	end 'rows'

	let dump = spawnDumpInfo(executable, staged: staged, sections: [LinesSectionName])
	let rows = DumpedLineRowArray.create(0)

	for row in dumpSectionRows(withoutCarriageReturns(dump.stdout), heading: DumpLineTableHeading) 'eachRow'
		let tokens = whitespaceTokens(row)
		let spelledPosition = try tokens.get(DumpPositionColumn) otherwise continue

		if spelledPosition.contains(position) 'aRowOfTheLine'
			rows.push(DumpedLineRow.create(hexValue(firstToken(row)), tags: lineRowTagsIn(row)))
		end 'aRowOfTheLine'
	end 'eachRow'

	return rows
end 'dumpedRowsAt'

function statementOffsetsOfLine(executable FilePath, staged FilePath, line SourceLine) returns SidecarNumberArray
	let rows = dumpedRowsAt(executable, staged: staged, scope: DumpedRowScope.line(line))

	return statementOffsetsAmong(rows, atMost: rows.count())
end 'statementOffsetsOfLine'

function lineRowTagsIn(row String) returns StringArray
	let tags = StringArray.create(0)
	let pieces = row.split(RowTagListOpen)

	if pieces.count() < 2 'noTagList'
		return tags
	end 'noTagList'

	let list = (try pieces.get(pieces.count() - 1) otherwise "").replace(RowTagListClose, with: "")

	for tag in list.split(RowTagSeparator) 'eachTag'
		tags.push(tag.trim())
	end 'eachTag'

	return tags
end 'lineRowTagsIn'

function exactOffsetTarget(offset PrintedNumber) returns String
	return "{ExactOffsetMarker}{hexSpelling(offset)}"
end 'exactOffsetTarget'

function hexSpelling(offset PrintedNumber) returns String
	return "{HexPrefix}{offset:x}"
end 'hexSpelling'

let ConditionFixtureName = "condition"
let WideConditionFixtureName = "conditionwide"
let WorkersFixtureName = "workers"
let TracedFixtureName = "traced"
let LiveSpinFixtureName = "livespin"

let DebugTraceOption = "--trace"
let DebugStreamBuildOption = "--debugstream"

let ThreadsCommand = "threads"
let GtBacktraceCommand = "gt-backtrace"
let GtSelectCommand = "gt"
let GtParkCommand = "gt-park"
let GtResumeCommand = "gt-resume"
let TraceCommand = "trace"
let PauseCommand = "pause"

let ThreadsEventName = "threads"
let GtBacktraceEventName = "gt-backtrace"
let GtSelectEventName = "gt-select"
let GtParkEventName = "gt-park"
let GtResumeEventName = "gt-resume"
let TraceEventName = "trace"

let ThreadsKey = "threads"
let StatusKey = "status"
let TruncatedKey = "truncated"
let IdKey = "id"
let ThreadKey = "thread"
let MachineKey = "machine"
let EventsKey = "events"
let EventsUnavailableKey = "eventsUnavailable"
let ResultKey = "result"
let TextKey = "text"

let RunningThreadStatus = "running"
let WaitingThreadStatus = "waiting"
let ReadyThreadStatus = "ready"

let SelectedResult = "selected"
let ClearedSelectionResult = "cleared"
let HeldResult = "held"
let ReleasedResult = "released"
let RefusedResult = "refused"

let FinisherFixtureName = "finisher"
let NoSuchThreadReason = "no-such-thread"

let ConditionUnsupportedAction = "condition-unsupported"
let PauseStopReason = "pause"
let FaultStopReason = "fault"

let NotTracedReason = "not-traced"
let NotBuiltWithDebugStreamReason = "program-not-built-with-debugstream"

let AbsentThreadId = -1
let AbsentEventIndex = -1 as EventNumber
let SelectorFunctionSeparator = ":"

let GreenThreadPlaceholderText = "green-thread"
let ProgramGoneText = "no longer running"

let SpawnSchedEventText = "sched_spawn"
let AwaitSchedEventText = "sched_await"

let ConditionWord = " if "

function conditionalBreak(target String, condition String) returns String
	return "{BreakCommand} {target}{ConditionWord}{condition}"
end 'conditionalBreak'

function linesStartingWith(text String, prefix String) returns EventTally
	var tally = 0 as EventTally

	for line in withoutCarriageReturns(text).split(LineFeed) 'eachLine'
		tally = tally + 1 if line.startsWith(prefix) else tally
	end 'eachLine'

	return tally
end 'linesStartingWith'

function threadRows(doc JsonDoc) returns JsonNodeIdArray
	return childrenOf(doc, node: doc.root, key: ThreadsKey)
end 'threadRows'

function threadIdWithStatus(doc JsonDoc, status String, functionName String) returns EventNumber
	for row in threadRows(doc) 'eachRow'
		if textOf(doc, node: row, key: StatusKey) == status and textOf(doc, node: row, key: FunctionKey) == functionName 'thisRow'
			return numberOf(doc, node: row, key: IdKey)
		end 'thisRow'
	end 'eachRow'

	return AbsentThreadId
end 'threadIdWithStatus'

function threadFieldOfId(doc JsonDoc, id EventNumber, key String) returns String
	for row in threadRows(doc) 'eachRow'
		if numberOf(doc, node: row, key: IdKey) == id 'thisRow'
			return textOf(doc, node: row, key: key)
		end 'thisRow'
	end 'eachRow'

	return AbsentEventText
end 'threadFieldOfId'

function countThreadsWhere(doc JsonDoc, key String, value String) returns EventTally
	var tally = 0 as EventTally

	for row in threadRows(doc) 'eachRow'
		tally = tally + 1 if textOf(doc, node: row, key: key) == value else tally
	end 'eachRow'

	return tally
end 'countThreadsWhere'

function renderedThreads(doc JsonDoc) returns String
	let rows = StringArray.create(0)

	for row in threadRows(doc) 'eachRow'
		rows.push("#{numberOf(doc, node: row, key: IdKey)} {textOf(doc, node: row, key: StatusKey)} {textOf(doc, node: row, key: FunctionKey)}")
	end 'eachRow'

	return listedLines(rows)
end 'renderedThreads'

function stopsAtLine(events JsonDocArray, line SourceLine) returns EventTally
	var tally = 0 as EventTally

	for stop in eventsOfKind(events, kind: StopEventName) 'eachStop'
		tally = tally + 1 if numberOf(stop, node: stop.root, key: LineKey) == line as EventNumber else tally
	end 'eachStop'

	return tally
end 'stopsAtLine'

function stopsOnThreadInRange(events JsonDocArray, id EventNumber, after EventNumber, upto EventNumber) returns EventTally
	var tally = 0 as EventTally

	for (iter, event) in events.withIterator() 'eachEvent'
		let at = iter.index() as EventNumber

		if at > after and at < upto and eventKind(event) == StopEventName and numberOf(event, node: event.root, key: ThreadKey) == id 'thisThread'
			tally = tally + 1
		end 'thisThread'
	end 'eachEvent'

	return tally
end 'stopsOnThreadInRange'

function eventsOfKindBeforeTheExit(events JsonDocArray, kind String) returns JsonDocArray
	let matching = JsonDocArray.create(0)
	let ended = firstIndexOfKind(events, kind: ExitEventName)

	for (iter, event) in events.withIterator() 'eachEvent'
		if ended != AbsentEventIndex and (iter.index() as EventNumber) > ended 'pastTheEnd'
			break
		end 'pastTheEnd'

		if eventKind(event) == kind 'thisKind'
			matching.push(event.clone())
		end 'thisKind'
	end 'eachEvent'

	return matching
end 'eventsOfKindBeforeTheExit'

function firstIndexOfKind(events JsonDocArray, kind String) returns EventNumber
	for (iter, event) in events.withIterator() 'eachEvent'
		if eventKind(event) == kind 'thisKind'
			return iter.index() as EventNumber
		end 'thisKind'
	end 'eachEvent'

	return AbsentEventIndex
end 'firstIndexOfKind'

function lastIndexOfKind(events JsonDocArray, kind String) returns EventNumber
	var found = AbsentEventIndex

	for (iter, event) in events.withIterator() 'eachEvent'
		found = iter.index() as EventNumber if eventKind(event) == kind else found
	end 'eachEvent'

	return found
end 'lastIndexOfKind'

function stopsAfterIndex(events JsonDocArray, index EventNumber) returns EventTally
	var tally = 0 as EventTally

	for (iter, event) in events.withIterator() 'eachEvent'
		if (iter.index() as EventNumber) > index and eventKind(event) == StopEventName 'aLaterStop'
			tally = tally + 1
		end 'aLaterStop'
	end 'eachEvent'

	return tally
end 'stopsAfterIndex'

function innermostPhysicalFrameFunction(doc JsonDoc, key String) returns String
	for frame in childrenOf(doc, node: doc.root, key: key) 'eachFrame'
		if not flagOf(doc, node: frame, key: InlinedKey) 'aFrameOfItsOwn'
			return textOf(doc, node: frame, key: FunctionKey)
		end 'aFrameOfItsOwn'
	end 'eachFrame'

	return AbsentEventText
end 'innermostPhysicalFrameFunction'

function tracedEventTexts(doc JsonDoc) returns String
	let rows = StringArray.create(0)

	for event in childrenOf(doc, node: doc.root, key: EventsKey) 'eachEvent'
		rows.push(textOf(doc, node: event, key: TextKey))
	end 'eachEvent'

	return listedLines(rows)
end 'tracedEventTexts'

function tracedEventCount(doc JsonDoc) returns EventTally
	return childrenOf(doc, node: doc.root, key: EventsKey).count() as EventTally
end 'tracedEventCount'

function threadSelector(status String, functionName String) returns String
	return status if functionName.isEmpty() else "{status}{SelectorFunctionSeparator}{functionName}"
end 'threadSelector'

function selectorCommand(word String, selector String) returns String
	return "{word} {selector}"
end 'selectorCommand'

function reportedThreadId(doc JsonDoc) returns EventNumber
	return numberOf(doc, node: doc.root, key: IdKey)
end 'reportedThreadId'

function kindAfter(events JsonDocArray, index EventNumber) returns String
	let next = try events.get((index + 1) as ElementIndex) otherwise return AbsentEventText

	return eventKind(next)
end 'kindAfter'

function reportsNoThreadId(doc JsonDoc) returns bool
	return memberOf(doc, node: doc.root, key: IdKey).count() == 0
end 'reportsNoThreadId'

