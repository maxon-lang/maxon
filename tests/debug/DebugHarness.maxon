// DebugHarness.maxon — the shared half every case under `tests/debug/` reaches for: the compiler it
// spawns, staging a fixture, building it, running a driver at it, and reading back what one printed.
//
// ⭐⭐ **THE RUNNER AND THE SUBJECT ARE THE SAME BINARY, AND NOTHING OUTSIDE CLOSES THAT.** `maxon test
// tests/debug` both runs these cases and provides the compiler they spawn — named by
// `TestedCompilerStem` and by nothing else — so a runner broken badly enough to report green having run
// nothing cannot detect itself. READ THE PASS COUNT.
//
// ⛔ **EVERY FREE FUNCTION IN A DIRECTORY SHARES ONE NAMESPACE, whatever its visibility** (E3006).
// So the corpus gets ONE shared half, exported from this file, and a case file beside it declares
// only what that case alone uses. A file-private `let` does NOT collide, so a constant declared
// twice is the half nothing catches: every constant this corpus shares is declared here or in
// `tests/support/`.
//
// ⛔ **EVERYTHING THAT WOULD STOP A CASE RUNNING AT ALL PANICS RATHER THAN FAILING AN ASSERTION**: a
// missing compiler, an unspellable path, a spawn that never happened. None of those is a driver answering
// wrongly, so none of them may reach a reader as a failed assertion about one.
//
// ⛔ **THIS FILE'S PATHS ARE RELATIVE TO THE CHECKOUT ROOT**, which is the working directory a test binary
// inherits from `maxon test`. Everything handed to a child is made absolute first, because a relative path
// resolves against the child's directory on POSIX and the parent's on Windows.
//
// ⛔ **ONE SPAWNING `test` PER FILE, AND EVERY CASE STAGES INTO A DIRECTORY NAMED FOR ITSELF**, because
// `maxon test` runs files concurrently and two cases sharing a staging tree would race over one output
// path.

// Where the corpus lives and where a runnable copy is built, both relative to the checkout root. Staging
// goes to gitignored `temp/`: a live `.maxon` under `tests/` is one `maxon fmt` over the checkout rewrites.
export let FixturesDirName = "tests/debug/fixtures"
export let SpansFixtureName = "spans"
export let GreenThreadFixtureName = "greenthread"
export let StagingRootDirName = "temp/debug"

// How a declaration is recognized in the staged fixture source.
export let FunctionDeclarationPrefix = "function "
export let DeclarationNameEnd = "("

// The read-only sidecar surface every dump case in this directory goes through.
export let DebugSubcommandName = "debug"
export let DumpInfoOptionName = "--dump-info"

// How the dump writes its numbers, and the ASCII runs their digits come from. Spelled as numbers rather
// than as character literals, which a receiver position cannot carry.
export let HexPrefix = "0x"
let HexBase = 16

// ============================================================================================
// STAGING AND SPAWNING
// ============================================================================================

// `<compiler> debug --dump-info <exe> [section...]`. The sections ride as trailing arguments because that
// is what the command line takes — naming none prints the whole sidecar, which is the default this corpus
// must not let move.
export function spawnDumpInfo(executable FilePath, staged FilePath, sections StringArray) returns CollectedOutput
	var arguments = StringArray.create()
	arguments.push(DebugSubcommandName)
	arguments.push(DumpInfoOptionName)
	arguments.push(executable.toString())

	for section in sections 'eachSection'
		arguments.push(section)
	end 'eachSection'

	return spawnCompiler(arguments, staged: staged, what: "`{TestedCompilerStem} {DebugSubcommandName} {DumpInfoOptionName}`")
end 'spawnDumpInfo'

// ============================================================================================
// THE DUMP'S SECTIONS
// ============================================================================================

// Every section heading the dump prints. The roster is complete because a section ends where the NEXT one
// begins: a heading missing from it would have its rows read as the previous section's.
export let DumpFilesHeading = "files ("
export let DumpFunctionsHeading = "functions ("
export let DumpTypesHeading = "types ("
export let DumpLineTableHeading = "line table ("
let DumpInlineSitesHeading = "inline sites ("
let DumpInlineRangesHeading = "inline ranges ("
export let DumpGlobalsSectionHeading = "globals ("
export let DumpLayoutSectionHeading = "layout ("

export let RosterGlobalName = "__gt_allg"
export let RosterLengthGlobalName = "__gt_allglen"
export let DebugStreamGlobalName = "__ds_base"

let SidecarNameTerminator = ":"

export function sidecarTableNames(rows StringArray, names StringArray, published bool) returns StringArray
	var matching = StringArray.create()

	for name in names 'eachName'
		if sidecarTableRowsName(rows, name: name) == published 'wanted'
			matching.push(name)
		end 'wanted'
	end 'eachName'

	return matching
end 'sidecarTableNames'

export function sidecarTableRowsName(rows StringArray, name String) returns bool
	for row in rows 'eachRow'
		for token in whitespaceTokens(row) 'eachToken'
			if token.replace(SidecarNameTerminator, with: "") == name 'namesIt'
				return true
			end 'namesIt'
		end 'eachToken'
	end 'eachRow'

	return false
end 'sidecarTableRowsName'

// The rows under one section heading: every line after it, up to the line that opens the NEXT section. A
// heading nothing opens yields no rows, which the caller reports as the section being absent.
export function dumpSectionRows(dump String, heading String) returns StringArray
	var rows = StringArray.create()
	var inSection = false

	for rawLine in dump.split(LineFeed) 'eachLine'
		let line = rawLine.trim()

		if line.startsWith(heading) 'opensThisSection'
			inSection = true
			continue
		end 'opensThisSection'

		if not inSection 'beforeTheSection'
			continue
		end 'beforeTheSection'

		if opensASection(line) 'nextSection'
			break
		end 'nextSection'

		if not line.isEmpty() 'aRow'
			rows.push(line)
		end 'aRow'
	end 'eachLine'

	return rows
end 'dumpSectionRows'

function opensASection(line String) returns bool
	return line.startsWith(DumpFilesHeading) or line.startsWith(DumpFunctionsHeading) or line.startsWith(DumpTypesHeading) or line.startsWith(DumpLineTableHeading) or line.startsWith(DumpInlineSitesHeading) or line.startsWith(DumpInlineRangesHeading) or line.startsWith(DumpGlobalsSectionHeading) or line.startsWith(DumpLayoutSectionHeading)
end 'opensASection'

// ============================================================================================
// NUMBERS THE DUMP PRINTS
// ============================================================================================

// A hex token's value. An optional `0x` opens it and the digits are read until the first character that
// is not one, so a token carrying no digits reads 0 — which fails the assertion that consumes it rather
// than standing in for a number nobody published.
export function hexValue(token String) returns PrintedNumber
	var value = 0 as PrintedNumber

	for c in token.trim().replace(HexPrefix, with: "") 'eachCharacter'
		match hexDigitOf(c) 'digit'
			value(digit) then value = value * HexBase + (digit as PrintedNumber)
			notAHexDigit then break 'eachCharacter'
		end 'digit'
	end 'eachCharacter'

	return value
end 'hexValue'

export function hexDigitOf(c Character) returns UrlHexDigitReading
	let code = try c.asciiValue() otherwise return UrlHexDigitReading.notAHexDigit

	return urlHexDigitOf(code as Byte)
end 'hexDigitOf'

// ============================================================================================
// READING THE STAGED FIXTURE — the roster every case here derives rather than writes down
// ============================================================================================

// Every line of every staged source, CR folded — the roster a case over a multi-file fixture derives its
// demands from.
export function everyStagedSourceLine(staged FilePath) returns StringArray
	var lines = StringArray.create()

	for entry in listing(staged) 'eachEntry'
		if not entry.filename().endsWith(MaxonSourceSuffix) 'notASource'
			continue
		end 'notASource'

		for line in linesOfStagedSource(entry) 'eachLine'
			lines.push(line)
		end 'eachLine'
	end 'eachEntry'

	return lines
end 'everyStagedSourceLine'

// The functions the staged program DECLARES, in source order. Derived from the source rather than listed
// in a case file, so a fixture that grows a function grows every roster checked against it.
//
// ⚠ The prefix is unindented on purpose: a `static function` inside a `type` opens with a TAB, and a
// method is not what a case asking "which functions did this file declare" means.
export function declaredFunctionNames(staged FilePath) returns StringArray
	var names = StringArray.create()

	for line in linesOfStagedSource(staged.join(StagedProgramFileName)) 'eachLine'
		if line.startsWith(FunctionDeclarationPrefix) 'aDeclaration'
			names.push(declaredNameIn(line))
		end 'aDeclaration'
	end 'eachLine'

	return names
end 'declaredFunctionNames'

// The name in a `function NAME(…)` line.
function declaredNameIn(line String) returns String
	let open = try line.findFirst(DeclarationNameEnd) otherwise panic("debug tests: the gate could not run — the staged fixture line '{line}' opens a declaration and spells no '{DeclarationNameEnd}'.")

	return line.slice(line.startIndex(), endIndex: open).replace(FunctionDeclarationPrefix, with: "").trim()
end 'declaredNameIn'

// ============================================================================================
// THE DEBUGGER: FIXTURES, THE `maxon debug` FACES, AND THE EVENTS ONE PRINTS
// ============================================================================================

export let SteppingFixtureName = "stepping"
export let ValuesFixtureName = "values"
export let InlinedFixtureName = "inlined"
export let FuzzyFixtureName = "fuzzy"
export let CoroutineFixtureName = "coroutine"
export let HeaplessFixtureName = "heapless"
export let CrashFixtureName = "crash"
export let SpinFixtureName = "spin"
export let LongCallFixtureName = "longcall"
export let TestBodyFixtureName = "testbody"
export let LeafPairFixtureName = "leafpair"
export let ExitCascadeFixtureName = "exitcascade"
export let PromotedDropFixtureName = "promoteddrop"
export let PromotedValueFixtureName = "promotedvalue"
export let LeafFoldFixtureName = "leaffold"
export let CastLineFixtureName = "castline"
export let ClosuresFixtureName = "closures"
export let TestBodyTestFileName = "doubling.maxtest"
export let TestBodyLibraryFileName = "doubling.maxon"
export let GenericsFixtureName = "generics"
export let SplicedFixtureName = "spliced"
export let TwoPassFixtureName = "twopass"
export let LoopsFixtureName = "loops"
export let TwoDirsFixtureName = "twodirs"
export let PrologueFixtureName = "prologue"
export let WalksFixtureName = "walks"
export let EnderFixtureName = "ender"
export let FaultCalleeFixtureName = "faultcallee"
export let HotConditionFixtureName = "hotcondition"
export let HotServiceFixtureName = "hotservice"
export let LeadingCallFixtureName = "leadingcall"
export let SplicedClosureFixtureName = "splicedclosure"
export let InlineStressFixtureName = "inlinestress"
export let SplicedLoopFixtureName = "splicedloop"
export let SplicedLibraryCallFixtureName = "splicedlibrarycall"
export let StaleStepFixtureName = "stalestep"
export let TableChurnFixtureName = "tablechurn"
export let HoldConflictFixtureName = "holdconflict"
export let LogicLineFixtureName = "logicline"
export let VoidCallFixtureName = "voidcall"
export let RecursionFixtureName = "recursion"
export let LibraryCallbackFixtureName = "librarycallback"
export let ValueCallFixtureName = "valuecall"
export let ParkingCallFixtureName = "parkingcall"

export let DebugBatchOption = "--batch"
export let DebugCommandsOptionPrefix = "--commands="
export let DebugCompleteOptionPrefix = "--complete="
export let DebugStopTimeoutOptionPrefix = "--stop-timeout="
let DebugTargetEnvOptionPrefix = "--target-env="
export let NoDebugAgentOption = "--no-debug-agent"
let CommandSeparator = ";"

export typealias EventIndex = int(0 to u32.max)
export typealias EventTally = int(0 to u32.max)
export typealias EventNumber = int(i64.min to i64.max)
export typealias JsonDocArray = Array with JsonDoc

// What a reader answers for a key an event does not carry. The caller reports the absence naming the
// key and printing the whole event, exactly as `describedLocalType` reports an absent local row.
export let AbsentEventText = ""
let AbsentEventNumber = i64.min

let JsonObjectOpen = "\{"

export union CodeRangeLookup
	none
	range(start PrintedNumber, limit PrintedNumber)
end 'CodeRangeLookup'

// ============================================================================================
// SPAWNING THE DRIVER'S THREE FACES
// ============================================================================================

export function spawnDebugBatch(executable FilePath, staged FilePath, commands String, extraOptions StringArray) returns CollectedOutput
	var arguments = StringArray.create()
	arguments.push(DebugSubcommandName)
	arguments.push(DebugBatchOption)
	arguments.push("{DebugCommandsOptionPrefix}{commands}")

	for option in extraOptions 'eachOption'
		arguments.push(option)
	end 'eachOption'

	arguments.push(executable.toString())

	return spawnCompiler(arguments, staged: staged, what: "`{DebugSubcommandName} {DebugBatchOption}`")
end 'spawnDebugBatch'

export function spawnDebugComplete(executable FilePath, staged FilePath, partial String) returns CollectedOutput
	var arguments = StringArray.create()
	arguments.push(DebugSubcommandName)
	arguments.push("{DebugCompleteOptionPrefix}{partial}")
	arguments.push(executable.toString())

	return spawnCompiler(arguments, staged: staged, what: "`{DebugSubcommandName} {DebugCompleteOptionPrefix}`")
end 'spawnDebugComplete'

// The REPL face: no `--batch`, the script on the driver's own stdin, one command per line.
export function spawnDebugRepl(executable FilePath, staged FilePath, script String) returns CollectedOutput
	return spawnCompiler([DebugSubcommandName, executable.toString()], staged: staged, what: "the `{DebugSubcommandName}` REPL", standardInput: InputSource.bytes(script))
end 'spawnDebugRepl'

// `--target-env=NAME=VALUE`, the one option that reaches the DEBUGGEE's environment rather than the
// driver's.
export function targetEnvOption(name String, value String) returns String
	return "{DebugTargetEnvOptionPrefix}{name}={value}"
end 'targetEnvOption'

export function debugCommandLine(commands StringArray) returns String
	var line = ""

	for command in commands 'eachCommand'
		line = command if line.isEmpty() else "{line}{CommandSeparator}{command}"
	end 'eachCommand'

	return line
end 'debugCommandLine'

// ============================================================================================
// THE BATCH EVENT STREAM — one JSON object per stdout line, asserted as PARSED FIELDS
// ============================================================================================

// ⛔ A line that OPENS an object and does not parse PANICS: `--batch` promises a pure-JSON stdout, so a
// line that is neither blank nor an object is the gate having nothing to read rather than a driver
// answering wrongly.
export function batchEvents(stdout String) returns JsonDocArray
	var events = JsonDocArray.create()

	for rawLine in withoutCarriageReturns(stdout).split(LineFeed) 'eachLine'
		let line = rawLine.trim()

		if not line.startsWith(JsonObjectOpen) 'notAnEventLine'
			continue
		end 'notAnEventLine'

		let doc = try Json.parse(line) otherwise panic("debug tests: the gate could not run — `{DebugBatchOption}` wrote a line that opens a JSON object and does not parse: {line}")
		events.push(doc)
	end 'eachLine'

	return events
end 'batchEvents'

function eventKind(event JsonDoc) returns String
	return textOf(event, node: event.root, key: "event")
end 'eventKind'

export function eventKinds(events JsonDocArray) returns StringArray
	var kinds = StringArray.create()

	for event in events 'eachEvent'
		kinds.push(eventKind(event))
	end 'eachEvent'

	return kinds
end 'eventKinds'

export function eventsOfKind(events JsonDocArray, kind String) returns JsonDocArray
	var matching = JsonDocArray.create()

	for event in events 'eachEvent'
		if eventKind(event) == kind 'thisKind'
			matching.push(event.clone())
		end 'thisKind'
	end 'eachEvent'

	return matching
end 'eventsOfKind'

export function eventAt(events JsonDocArray, index EventIndex) returns JsonDoc
	return try events.get(index as ElementIndex) otherwise panic("debug tests: the gate could not run — event {index} was looked up in a stream of {events.count()}")
end 'eventAt'

// ============================================================================================
// READING ONE EVENT'S FIELDS
// ============================================================================================

export function textOf(doc JsonDoc, node JsonNodeId, key String) returns String
	return try doc.getString(node, key: key) otherwise AbsentEventText
end 'textOf'

export function numberOf(doc JsonDoc, node JsonNodeId, key String) returns EventNumber
	return try doc.getInt(node, key: key) otherwise AbsentEventNumber
end 'numberOf'

export function flagOf(doc JsonDoc, node JsonNodeId, key String) returns bool
	return try doc.getBool(node, key: key) otherwise false
end 'flagOf'

// The one node a key names, as a list of AT MOST ONE — so "the key is absent" is a count of zero
// rather than a node id standing in for nothing.
export function memberOf(doc JsonDoc, node JsonNodeId, key String) returns JsonNodeIdArray
	var found = JsonNodeIdArray.create()
	let child = try doc.getChild(node, key: key) otherwise return found
	found.push(child)

	return found
end 'memberOf'

// The elements of an array-valued key, EMPTY when the key is absent or is not an array — which the
// caller reports as the list being missing, naming the key.
export function childrenOf(doc JsonDoc, node JsonNodeId, key String) returns JsonNodeIdArray
	var children = JsonNodeIdArray.create()
	let arrayId = try doc.getChild(node, key: key) otherwise return children
	let length = try doc.arrayLength(arrayId) otherwise return children

	for i in 0 upto length 'eachElement'
		children.push(try doc.arrayAt(arrayId, index: i) otherwise continue)
	end 'eachElement'

	return children
end 'childrenOf'

// The whole stream as the text a failure report shows.
export function renderedEvents(stdout String, stderr String) returns String
	return "It wrote to stdout:{listedLines(withoutCarriageReturns(stdout).split(LineFeed))}{LineFeed}and to stderr:{listedLines(withoutCarriageReturns(stderr).split(LineFeed))}"
end 'renderedEvents'

// ============================================================================================
// THE STAGED SOURCE — every line a case names is found by its anchor, never written down
// ============================================================================================

export function stagedLinesContaining(staged FilePath, needle String) returns EventTally
	var tally = 0 as EventTally

	for line in linesOfStagedSource(staged.join(StagedProgramFileName)) 'eachLine'
		tally = tally + 1 if line.contains(needle) else tally
	end 'eachLine'

	return tally
end 'stagedLinesContaining'

// The staged program's own file name, as a `file:line` break target and an event's `file` field spell it.
// ============================================================================================
// THE DUMP'S FUNCTION AND TYPE BLOCKS — a row and the rows nested under it
// ============================================================================================

// A function row carries the frame column; a local row nested under it does not, which is what tells
// the two apart once `dumpSectionRows` has trimmed the indentation away.
let FunctionRowColumn = "frame="
let TypeFieldRowPrefix = "+0x"
let TypeRowPrefix = "["

export function functionRowOf(functionRows StringArray, name String) returns String
	for row in functionRows 'eachRow'
		if row.contains(FunctionRowColumn) and firstToken(row) == name 'thisFunction'
			return row
		end 'thisFunction'
	end 'eachRow'

	return AbsentEventText
end 'functionRowOf'

export function localRowsOf(functionRows StringArray, name String) returns StringArray
	var locals = StringArray.create()
	var inside = false

	for row in functionRows 'eachRow'
		if row.contains(FunctionRowColumn) 'aFunctionRow'
			inside = firstToken(row) == name
			continue
		end 'aFunctionRow'

		if inside 'aLocalOfThisFunction'
			locals.push(row)
		end 'aLocalOfThisFunction'
	end 'eachRow'

	return locals
end 'localRowsOf'

export function declaredFunctionRows(functionRows StringArray) returns StringArray
	var rows = StringArray.create()

	for row in functionRows 'eachRow'
		if row.contains(FunctionRowColumn) 'aFunctionRow'
			rows.push(row)
		end 'aFunctionRow'
	end 'eachRow'

	return rows
end 'declaredFunctionRows'

export function typeRowOf(typeRows StringArray, name String) returns String
	for row in typeRows 'eachRow'
		if row.startsWith(TypeRowPrefix) and typeNameIn(row) == name 'thisType'
			return row
		end 'thisType'
	end 'eachRow'

	return AbsentEventText
end 'typeRowOf'

export function typeFieldRowsOf(typeRows StringArray, name String) returns StringArray
	var fields = StringArray.create()
	var inside = false

	for row in typeRows 'eachRow'
		if row.startsWith(TypeRowPrefix) 'aTypeRow'
			inside = typeNameIn(row) == name
			continue
		end 'aTypeRow'

		if inside and row.startsWith(TypeFieldRowPrefix) 'aFieldOfThisType'
			fields.push(row)
		end 'aFieldOfThisType'
	end 'eachRow'

	return fields
end 'typeFieldRowsOf'

// A type row is `[N] NAME KIND size=… align=… fields=…`, so its name is the second word and its kind
// the third.
function typeNameIn(row String) returns String
	return try whitespaceTokens(row).get(1) otherwise AbsentEventText
end 'typeNameIn'

export function typeKindIn(row String) returns String
	return try whitespaceTokens(row).get(2) otherwise AbsentEventText
end 'typeKindIn'

// The type a local row or a field row names: everything past its last `: ` separator, because a type's
// rendering may be several words (`<generic instance>`) and a last-WORD reader answers half of one.
export function describedTypeIn(row String) returns String
	let pieces = row.split(TypeSeparatorToken)

	if pieces.count() < 2 'namesNoType'
		return AbsentEventText
	end 'namesNoType'

	return (try pieces.get(pieces.count() - 1) otherwise AbsentEventText).trim()
end 'describedTypeIn'

let TypeSeparatorToken = ": "

export function firstToken(row String) returns String
	return try whitespaceTokens(row).get(0) otherwise AbsentEventText
end 'firstToken'

// The `lines=` column of a function row, as a number.
export function columnValueIn(row String, column String) returns PrintedNumber
	for token in whitespaceTokens(row) 'eachToken'
		if token.startsWith(column) 'thisColumn'
			return decimalValue(token.replace(column, with: ""))
		end 'thisColumn'
	end 'eachToken'

	return 0
end 'columnValueIn'

// A `[0xSTART, 0xLIMIT)` pair anywhere in a row: the function row's code range, or the scope range a
// local row carries. A location column spells `[rbp-0x18]`, which opens no pair because it does not
// close with a comma.
export function codeRangeIn(row String) returns CodeRangeLookup
	let tokens = whitespaceTokens(row)

	for (iter, token) in tokens.withIterator() 'eachToken'
		if not token.startsWith(RangeOpen) or not token.endsWith(RangeSeparator) 'notARangeStart'
			continue
		end 'notARangeStart'

		let limitToken = try tokens.get(iter.index() + 1) otherwise continue

		if not limitToken.endsWith(RangeClose) 'notARangeLimit'
			continue
		end 'notARangeLimit'

		return CodeRangeLookup.range(hexValue(token.replace(RangeOpen, with: "").replace(RangeSeparator, with: "")), limit: hexValue(limitToken.replace(RangeClose, with: "")))
	end 'eachToken'

	return CodeRangeLookup.none
end 'codeRangeIn'

let RangeOpen = "[0x"
let RangeSeparator = ","
let RangeClose = ")"

// ============================================================================================
// THE VOCABULARY EVERY CASE SPELLS — commands, event names, keys and the values they take
// ============================================================================================
//
// ⛔ ONE HOME, because a file-private `let` does not collide: a command word or an event key written
// down twice is the duplication nothing in this corpus catches for you.

export let BreakCommand = "break"
export let ClearCommand = "clear"
export let RunCommand = "run"
export let ContinueCommand = "continue"
export let StepCommand = "step"
export let NextCommand = "next"
export let FinishCommand = "finish"
export let UntilCommand = "until"
export let BacktraceCommand = "backtrace"
export let PrintCommand = "print"
export let LocalsCommand = "locals"
export let QuitCommand = "quit"

export let BreakpointEventName = "breakpoint"
export let StopEventName = "stop"
export let BacktraceEventName = "backtrace"
export let LocalsEventName = "locals"
export let ValueEventName = "value"
export let ExitEventName = "exit"
export let CrashEventName = "crash"
export let TimeoutEventName = "timeout"
export let ErrorEventName = "error"

export let ActionKey = "action"
export let FunctionKey = "function"
export let FileKey = "file"
export let LineKey = "line"
export let ColumnKey = "col"
export let ReasonKey = "reason"
export let CodeKey = "code"
export let FramesKey = "frames"
export let BacktraceKey = "backtrace"
export let LocalsKey = "locals"
export let InlinedKey = "inlined"
export let OffsetsKey = "offsets"
export let CandidatesKey = "candidates"
export let SuggestionKey = "suggestion"
let NameKey = "name"
export let DisplayKey = "display"
export let UnavailableKey = "unavailable"
export let MessageKey = "message"
export let ValueKey = "value"
export let FrameKey = "frame"

export let SetAction = "set"
export let ClearedAction = "cleared"
export let AmbiguousAction = "ambiguous"
export let NoMatchAction = "no-match"
export let NoCodeAction = "no-code"

let EntryStopReason = "entry"
export let BreakpointStopReason = "breakpoint"
export let StepStopReason = "step"

export let OptimizedOutReason = "optimized-out"

export function lineTarget(line SourceLine, file String = StagedProgramFileName) returns String
	return "{file}:{line}"
end 'lineTarget'

// One staged, built fixture — the preamble every case in this corpus opens with, in ONE place. A build
// that failed stops the case running at all, so it panics naming the fixture rather than failing an
// assertion about a debugger that was never handed a program.
export function builtFixture(caseLabel String, fixture String, extraArguments StringArray = StringArray.create()) returns FilePath
	let staged = stagedFixtureTree(FixturesDirName, stagingRootDir: StagingRootDirName, caseLabel: caseLabel, fixture: fixture)
	_ = buildStagedSource(staged.join(StagedProgramFileName), staged: staged, what: "{fixture} for case {caseLabel}", extraArguments: extraArguments)

	return staged
end 'builtFixture'

// The program run with nothing attached — the control every case comparing a debugged run with an
// undebugged one needs, because "the answer looks right" is not the claim; "the answer is the SAME" is.
export function runBuiltProgram(staged FilePath, arguments StringArray = StringArray.create()) returns CollectedOutput
	let program = builtExecutable(staged)

	if not File.exists(program) 'noProgram'
		panic("debug tests: the gate could not run — there is no program at {program.toString()} to run undebugged.")
	end 'noProgram'

	return spawnIn(Executable.path(program), arguments: arguments, staged: staged, what: "{program.toString()} undebugged")
end 'runBuiltProgram'

// A command repeated: the only honest way to drive a session past a breakpoint whose hit count is a
// property of the fixture's loops rather than of the debugger.
export function repeatedCommand(command String, times EventTally) returns StringArray
	var commands = StringArray.create()

	for _ in 0 upto times 'eachRepeat'
		commands.push(command)
	end 'eachRepeat'

	return commands
end 'repeatedCommand'

export function appendedCommands(first StringArray, rest StringArray) returns StringArray
	var all = StringArray.create()

	for command in first 'eachFirst'
		all.push(command)
	end 'eachFirst'

	for command in rest 'eachRest'
		all.push(command)
	end 'eachRest'

	return all
end 'appendedCommands'

// A string element of an array-valued key — a candidate name, a completion — read off the node itself
// rather than out of an object field, because the element IS the string.
export function stringAt(doc JsonDoc, node JsonNodeId) returns String
	return doc.get(node).stringValue
end 'stringAt'

export function stringsOf(doc JsonDoc, node JsonNodeId, key String) returns StringArray
	var strings = StringArray.create()

	for element in childrenOf(doc, node: node, key: key) 'eachElement'
		strings.push(stringAt(doc, node: element))
	end 'eachElement'

	return strings
end 'stringsOf'

// ============================================================================================
// RENDERED VALUES — a `locals` list, a `print` answer, a struct's children
// ============================================================================================

// Every value of a list as `name=display`, which is what a disagreement has to show a reader: a
// display that is wrong is only legible beside the name it was rendered for.
export function valueRows(doc JsonDoc, node JsonNodeId, key String) returns StringArray
	var rows = StringArray.create()

	for value in childrenOf(doc, node: node, key: key) 'eachValue'
		rows.push("{textOf(doc, node: value, key: NameKey)}={textOf(doc, node: value, key: DisplayKey)}")
	end 'eachValue'

	return rows
end 'valueRows'

// The one value of a list carrying `name` — EMPTY when the list holds none, which the caller reports
// as the value being missing rather than as a wrong rendering of it.
export function valueNamed(doc JsonDoc, node JsonNodeId, key String, name String) returns JsonNodeIdArray
	var found = JsonNodeIdArray.create()

	for value in childrenOf(doc, node: node, key: key) 'eachValue'
		if textOf(doc, node: value, key: NameKey) == name 'thisValue'
			found.push(value)
		end 'thisValue'
	end 'eachValue'

	return found
end 'valueNamed'

export function nodeAt(nodes JsonNodeIdArray, index EventIndex) returns JsonNodeId
	return try nodes.get(index as ElementIndex) otherwise panic("debug tests: the gate could not run — node {index} was looked up in a list of {nodes.count()}")
end 'nodeAt'

export let ChildrenKey = "children"

// A row whose code range is a PRECONDITION rather than the claim — a function row, whose
// `[0xSTART, 0xLIMIT)` the dump has printed since `sidecar-dump` first pinned it.
export function requiredCodeRange(row String, what String) returns (PrintedNumber, PrintedNumber)
	match codeRangeIn(row) 'theRange'
		none then panic("debug tests: the gate could not run — {what} carries no `[0xSTART, 0xLIMIT)` code range: {row}")
		range(start, limit) then return (start, limit)
	end 'theRange'
end 'requiredCodeRange'

export function functionCodeStart(executable FilePath, staged FilePath, name String) returns PrintedNumber
	let (start, _) = requiredCodeRange(dumpedFunctionRow(executable, staged: staged, name: name), what: "`{name}`'s function row")

	return start
end 'functionCodeStart'

export function functionPrologueStart(executable FilePath, staged FilePath, name String) returns PrintedNumber
	let row = dumpedFunctionRow(executable, staged: staged, name: name)
	let (start, _) = requiredCodeRange(row, what: "`{name}`'s function row")

	for token in whitespaceTokens(row) 'eachToken'
		if token.startsWith(PrologueColumn) 'thePrologueColumn'
			return start + hexValue(token.replace(PrologueColumn, with: ""))
		end 'thePrologueColumn'
	end 'eachToken'

	panic("debug tests: the gate could not run — `{name}`'s function row carries no `{PrologueColumn}` column: {row}")
end 'functionPrologueStart'

function dumpedFunctionRow(executable FilePath, staged FilePath, name String) returns String
	let dump = spawnDumpInfo(executable, staged: staged, sections: StringArray.create())

	if dump.exitCode() != 0 'noSidecarPrinted'
		panic("debug tests: the gate could not run — `{DebugSubcommandName} {DumpInfoOptionName} <exe>` did not print the sidecar. It wrote to stderr: {dump.stderr}")
	end 'noSidecarPrinted'

	return functionRowOf(dumpSectionRows(withoutCarriageReturns(dump.stdout), heading: DumpFunctionsHeading), name: name)
end 'dumpedFunctionRow'

let PrologueColumn = "prologue=+"

#if arch(arm64)
	export let PushedFramePointerBytes = 4 as PrintedNumber
#endif

#if not arch(arm64)
	export let PushedFramePointerBytes = 1 as PrintedNumber
#endif

// What `--target` defaults to on this host, spelled `<arch>-<os>`.
export function hostTargetTriple() returns String
	#if arch(x64)
		let archName = "x64"
	#else
		let archName = "arm64"
	#endif

	#if os(Windows)
		let osName = "windows"
	#endif

	#if os(Linux)
		let osName = "linux"
	#endif

	#if os(Macos)
		let osName = "macos"
	#endif

	return "{archName}-{osName}"
end 'hostTargetTriple'

export typealias SidecarNumberArray = Array with PrintedNumber

let LinesSectionName = "lines"
let StatementRowTag = "statement"
export let LineEntryRowTag = "line-entry"
let RowTagListOpen = "["
let RowTagListClose = "]"
let RowTagSeparator = ", "
let ExactOffsetMarker = "*"
let DumpPositionColumn = 1
export let OffsetKey = "offset"
export let RefusedAction = "refused"
export let OutOfTextReason = "out-of-text"

export type DumpedLineRow
	export let offset as PrintedNumber
	export let tags as StringArray

	static function create(offset PrintedNumber, tags StringArray) returns DumpedLineRow
		return Self{offset: offset, tags: tags}
	end 'create'
end 'DumpedLineRow'

export typealias DumpedLineRowArray = Array with DumpedLineRow

export union DumpedRowScope
	theProgram
	line(number SourceLine)
end 'DumpedRowScope'

export function lowestOffsetOf(offsets SidecarNumberArray) returns PrintedNumber
	var lowest = try offsets.get(0) otherwise panic("debug tests: a line of code has at least one statement row")

	for offset in offsets 'eachOffset'
		lowest = offset if offset < lowest else lowest
	end 'eachOffset'

	return lowest
end 'lowestOffsetOf'

export function armedAndClearedAtEvery(offsets SidecarNumberArray) returns StringArray
	var commands = StringArray.create()

	for offset in offsets 'eachOffset'
		commands.push("{BreakCommand} {exactOffsetTarget(offset)}")
		commands.push("{ClearCommand} {exactOffsetTarget(offset)}")
	end 'eachOffset'

	return commands
end 'armedAndClearedAtEvery'

export function breakpointAnswersWithAction(events JsonDocArray, action String) returns EventTally
	var tally = 0 as EventTally

	for answer in eventsOfKind(events, kind: BreakpointEventName) 'eachAnswer'
		if textOf(answer, node: answer.root, key: ActionKey) == action 'thatAction'
			tally = tally + 1
		end 'thatAction'
	end 'eachAnswer'

	return tally
end 'breakpointAnswersWithAction'

export function statementOffsetsOfTheProgram(executable FilePath, staged FilePath, atMost EventTally) returns SidecarNumberArray
	return statementOffsetsAmong(dumpedRowsAt(executable, staged: staged, scope: DumpedRowScope.theProgram), atMost: atMost as ElementIndex)
end 'statementOffsetsOfTheProgram'

function statementOffsetsAmong(rows DumpedLineRowArray, atMost ElementIndex) returns SidecarNumberArray
	var offsets = SidecarNumberArray.create()

	for row in rows 'eachRow'
		if offsets.count() >= atMost 'enough'
			break
		end 'enough'

		if row.tags.contains(StatementRowTag) and not offsets.contains(row.offset) 'aNewStatement'
			offsets.push(row.offset)
		end 'aNewStatement'
	end 'eachRow'

	return offsets
end 'statementOffsetsAmong'

export function dumpedRowsAt(executable FilePath, staged FilePath, scope DumpedRowScope) returns DumpedLineRowArray
	let position = match scope 'rows'
		theProgram gives "{StagedProgramFileName}:"
		line(number) gives "{StagedProgramFileName}:{number}:"
	end 'rows'

	let dump = spawnDumpInfo(executable, staged: staged, sections: [LinesSectionName])
	var rows = DumpedLineRowArray.create()

	for row in dumpSectionRows(withoutCarriageReturns(dump.stdout), heading: DumpLineTableHeading) 'eachRow'
		let tokens = whitespaceTokens(row)
		let spelledPosition = try tokens.get(DumpPositionColumn) otherwise continue

		if spelledPosition.contains(position) 'aRowOfTheLine'
			rows.push(DumpedLineRow.create(hexValue(firstToken(row)), tags: lineRowTagsIn(row)))
		end 'aRowOfTheLine'
	end 'eachRow'

	return rows
end 'dumpedRowsAt'

export function statementOffsetsOfLine(executable FilePath, staged FilePath, line SourceLine) returns SidecarNumberArray
	let rows = dumpedRowsAt(executable, staged: staged, scope: DumpedRowScope.line(line))

	return statementOffsetsAmong(rows, atMost: rows.count())
end 'statementOffsetsOfLine'

function lineRowTagsIn(row String) returns StringArray
	var tags = StringArray.create()
	let pieces = row.split(RowTagListOpen)

	if pieces.count() < 2 'noTagList'
		return tags
	end 'noTagList'

	let list = (try pieces.get(pieces.count() - 1) otherwise "").replace(RowTagListClose, with: "")

	for tag in list.split(RowTagSeparator) 'eachTag'
		tags.push(tag.trim())
	end 'eachTag'

	return tags
end 'lineRowTagsIn'

export function exactOffsetTarget(offset PrintedNumber) returns String
	return "{ExactOffsetMarker}{hexSpelling(offset)}"
end 'exactOffsetTarget'

export function hexSpelling(offset PrintedNumber) returns String
	return "{HexPrefix}{offset:x}"
end 'hexSpelling'

export let ConditionFixtureName = "condition"
export let WideConditionFixtureName = "conditionwide"
export let WorkersFixtureName = "workers"
export let TracedFixtureName = "traced"
export let LiveSpinFixtureName = "livespin"

export let DebugTraceOption = "--trace"
export let DebugStreamBuildOption = "--debugstream"

export let ThreadsCommand = "threads"
export let GtBacktraceCommand = "gt-backtrace"
export let GtSelectCommand = "gt"
export let GtParkCommand = "gt-park"
export let GtResumeCommand = "gt-resume"
export let TraceCommand = "trace"
export let PauseCommand = "pause"

export let ThreadsEventName = "threads"
export let GtBacktraceEventName = "gt-backtrace"
export let GtSelectEventName = "gt-select"
export let GtParkEventName = "gt-park"
export let GtResumeEventName = "gt-resume"
export let TraceEventName = "trace"

let ThreadsKey = "threads"
export let StatusKey = "status"
export let TruncatedKey = "truncated"
let IdKey = "id"
export let ThreadKey = "thread"
export let MachineKey = "machine"
export let EventsKey = "events"
export let EventsUnavailableKey = "eventsUnavailable"
export let ResultKey = "result"
let TextKey = "text"

export let RunningThreadStatus = "running"
export let WaitingThreadStatus = "waiting"
export let ReadyThreadStatus = "ready"

export let SelectedResult = "selected"
export let ClearedSelectionResult = "cleared"
export let HeldResult = "held"
export let ReleasedResult = "released"
export let RefusedResult = "refused"

export let FinisherFixtureName = "finisher"
export let NoSuchThreadReason = "no-such-thread"

export let ConditionUnsupportedAction = "condition-unsupported"
export let PauseStopReason = "pause"
export let FaultStopReason = "fault"

export let NotTracedReason = "not-traced"
export let NotBuiltWithDebugStreamReason = "program-not-built-with-debugstream"

export let AbsentThreadId = -1
export let AbsentEventIndex = -1 as EventNumber
let SelectorFunctionSeparator = ":"

export let GreenThreadPlaceholderText = "green-thread"
export let ProgramGoneText = "no longer running"

export let SpawnSchedEventText = "sched_spawn"
export let AwaitSchedEventText = "sched_await"

let ConditionWord = " if "

export function conditionalBreak(target String, condition String) returns String
	return "{BreakCommand} {target}{ConditionWord}{condition}"
end 'conditionalBreak'

export function linesStartingWith(text String, prefix String) returns EventTally
	var tally = 0 as EventTally

	for line in withoutCarriageReturns(text).split(LineFeed) 'eachLine'
		tally = tally + 1 if line.startsWith(prefix) else tally
	end 'eachLine'

	return tally
end 'linesStartingWith'

export function threadRows(doc JsonDoc) returns JsonNodeIdArray
	return childrenOf(doc, node: doc.root, key: ThreadsKey)
end 'threadRows'

export function threadIdWithStatus(doc JsonDoc, status String, functionName String) returns EventNumber
	for row in threadRows(doc) 'eachRow'
		if textOf(doc, node: row, key: StatusKey) == status and textOf(doc, node: row, key: FunctionKey) == functionName 'thisRow'
			return numberOf(doc, node: row, key: IdKey)
		end 'thisRow'
	end 'eachRow'

	return AbsentThreadId
end 'threadIdWithStatus'

export function threadFieldOfId(doc JsonDoc, id EventNumber, key String) returns String
	for row in threadRows(doc) 'eachRow'
		if numberOf(doc, node: row, key: IdKey) == id 'thisRow'
			return textOf(doc, node: row, key: key)
		end 'thisRow'
	end 'eachRow'

	return AbsentEventText
end 'threadFieldOfId'

export function countThreadsWhere(doc JsonDoc, key String, value String) returns EventTally
	var tally = 0 as EventTally

	for row in threadRows(doc) 'eachRow'
		tally = tally + 1 if textOf(doc, node: row, key: key) == value else tally
	end 'eachRow'

	return tally
end 'countThreadsWhere'

export function renderedThreads(doc JsonDoc) returns String
	var rows = StringArray.create()

	for row in threadRows(doc) 'eachRow'
		rows.push("#{numberOf(doc, node: row, key: IdKey)} {textOf(doc, node: row, key: StatusKey)} {textOf(doc, node: row, key: FunctionKey)}")
	end 'eachRow'

	return listedLines(rows)
end 'renderedThreads'

export function stopsAtLine(events JsonDocArray, line SourceLine) returns EventTally
	var tally = 0 as EventTally

	for stop in eventsOfKind(events, kind: StopEventName) 'eachStop'
		tally = tally + 1 if numberOf(stop, node: stop.root, key: LineKey) == line as EventNumber else tally
	end 'eachStop'

	return tally
end 'stopsAtLine'

export function stopsOnThreadInRange(events JsonDocArray, id EventNumber, after EventNumber, upto EventNumber) returns EventTally
	var tally = 0 as EventTally

	for (iter, event) in events.withIterator() 'eachEvent'
		let at = iter.index() as EventNumber

		if at > after and at < upto and eventKind(event) == StopEventName and numberOf(event, node: event.root, key: ThreadKey) == id 'thisThread'
			tally = tally + 1
		end 'thisThread'
	end 'eachEvent'

	return tally
end 'stopsOnThreadInRange'

export function eventsOfKindBeforeTheExit(events JsonDocArray, kind String) returns JsonDocArray
	var matching = JsonDocArray.create()
	let ended = firstIndexOfKind(events, kind: ExitEventName)

	for (iter, event) in events.withIterator() 'eachEvent'
		if ended != AbsentEventIndex and (iter.index() as EventNumber) > ended 'pastTheEnd'
			break
		end 'pastTheEnd'

		if eventKind(event) == kind 'thisKind'
			matching.push(event.clone())
		end 'thisKind'
	end 'eachEvent'

	return matching
end 'eventsOfKindBeforeTheExit'

export function firstIndexOfKind(events JsonDocArray, kind String) returns EventNumber
	for (iter, event) in events.withIterator() 'eachEvent'
		if eventKind(event) == kind 'thisKind'
			return iter.index() as EventNumber
		end 'thisKind'
	end 'eachEvent'

	return AbsentEventIndex
end 'firstIndexOfKind'

export function lastIndexOfKind(events JsonDocArray, kind String) returns EventNumber
	var found = AbsentEventIndex

	for (iter, event) in events.withIterator() 'eachEvent'
		found = iter.index() as EventNumber if eventKind(event) == kind else found
	end 'eachEvent'

	return found
end 'lastIndexOfKind'

export function stopsAfterIndex(events JsonDocArray, index EventNumber) returns EventTally
	var tally = 0 as EventTally

	for (iter, event) in events.withIterator() 'eachEvent'
		if (iter.index() as EventNumber) > index and eventKind(event) == StopEventName 'aLaterStop'
			tally = tally + 1
		end 'aLaterStop'
	end 'eachEvent'

	return tally
end 'stopsAfterIndex'

export function innermostPhysicalFrameFunction(doc JsonDoc, key String) returns String
	for frame in childrenOf(doc, node: doc.root, key: key) 'eachFrame'
		if not flagOf(doc, node: frame, key: InlinedKey) 'aFrameOfItsOwn'
			return textOf(doc, node: frame, key: FunctionKey)
		end 'aFrameOfItsOwn'
	end 'eachFrame'

	return AbsentEventText
end 'innermostPhysicalFrameFunction'

export function tracedEventTexts(doc JsonDoc) returns String
	var rows = StringArray.create()

	for event in childrenOf(doc, node: doc.root, key: EventsKey) 'eachEvent'
		rows.push(textOf(doc, node: event, key: TextKey))
	end 'eachEvent'

	return listedLines(rows)
end 'tracedEventTexts'

export function tracedEventCount(doc JsonDoc) returns EventTally
	return childrenOf(doc, node: doc.root, key: EventsKey).count() as EventTally
end 'tracedEventCount'

export function threadSelector(status String, functionName String) returns String
	return status if functionName.isEmpty() else "{status}{SelectorFunctionSeparator}{functionName}"
end 'threadSelector'

export function selectorCommand(word String, selector String) returns String
	return "{word} {selector}"
end 'selectorCommand'

export function reportedThreadId(doc JsonDoc) returns EventNumber
	return numberOf(doc, node: doc.root, key: IdKey)
end 'reportedThreadId'

export function kindAfter(events JsonDocArray, index EventNumber) returns String
	let next = try events.get((index + 1) as ElementIndex) otherwise return AbsentEventText

	return eventKind(next)
end 'kindAfter'

export function reportsNoThreadId(doc JsonDoc) returns bool
	return memberOf(doc, node: doc.root, key: IdKey).count() == 0
end 'reportsNoThreadId'
