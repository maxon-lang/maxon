let DirectCallClass = 3
let DirectJumpClass = 4
let ConditionalJumpClass = 5
let ReturnClass = 6
let IndirectCallClass = 7
let IndirectJumpClass = 8
let InnerFunctionName = "inner"
let OuterFunctionName = "outer"
let TestBodyDisplayName = "test 'doubling two gives four'"
let AccountMethodName = "Account.deposit"
let LedgerMethodName = "Ledger.deposit"
let TimedOutSessionExitCode = 1
let ContinuesPastEveryWorker = 60
let CountedLinePrefix = "hit "
let ConditionText = "i == 7"
let HitFunctionName = "hit"
let ChurnFunctionName = "churn"
let WorkerFunctionName = "worker"
let OneProcessor = "1"
let FramesOfTheOutermostCall = 2
let RenderFunctionName = "render"
let JumpRowOfTheBranchLine = 1
