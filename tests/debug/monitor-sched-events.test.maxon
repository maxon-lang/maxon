// monitor-sched-events.test.maxon — `maxon monitor --filter=sched` shows the scheduler's transitions of a
// `--debugstream` program: a program that spawns a green thread and awaits it reports at least that spawn
// and that await.
//
// ⭐ **WHAT IS PINNED IS PRESENCE, NEVER A COUNT OR AN ID.** How many yields and resumes one await costs moves
// with the scheduler; that a spawn and an await happened does not.
//
// ⛔ **THE PROGRAM'S OWN ANSWER AND EXIT CODE ARE ASSERTED FIRST.** A monitor that ran nothing prints no
// events either, and that must not read as the runtime emitting none.
//
// ⛔ **ONE SPAWNING `test`, ONE FILE, ONE COMPILE.**

let MonitorCaseLabel = "monitor-sched-events"
let MonitorBuildLabel = "debugstream"

let DebugStreamOption = "--debugstream"
let MonitorSubcommandName = "monitor"
let SchedFilterOption = "--filter=sched"

// The decoder's verbs for the two transitions (`DebugStreamDecoder.schedVerbOf`), and the separator it
// prints before a green thread's trace id.
let SpawnEventWord = "sched_spawn #"
let AwaitEventWord = "sched_await #"

// What the fixture prints when its green thread answered.
let FixtureAnswerLine = "answer 42"

test 'monitor --filter=sched shows the spawn and the await of a green thread'
	let staged = stagedProgram(MonitorCaseLabel, fixture: GreenThreadFixtureName)

	let build = spawnBuild(staged, label: MonitorBuildLabel, extraArguments: [DebugStreamOption])

	if build.exitCode() != 0 'buildFailed'
		panic("monitor-sched-events: the gate could not run — the `{DebugStreamOption}` build failed with exit {build.exitCode()}: {build.stdout}{build.stderr}")
	end 'buildFailed'

	let monitored = spawnCompiler([MonitorSubcommandName, SchedFilterOption, builtExecutable(staged).toString()], staged: staged, what: "`{MonitorSubcommandName} {SchedFilterOption}`")
	let stdout = withoutCarriageReturns(monitored.stdout)
	let said = "It wrote to stdout: {stdout} and to stderr: {withoutCarriageReturns(monitored.stderr)}"

	try Expect.equal(monitored.exitCode() as AssertedInt, expected: 0, message: "the monitored program did not exit 0. {said}")
	try Expect.contains(stdout, needle: FixtureAnswerLine, message: "the monitored program did not print its answer, so it did not run to its await. {said}")
	try Expect.contains(stdout, needle: SpawnEventWord, message: "`{MonitorSubcommandName} {SchedFilterOption}` showed no spawn of the green thread the program started. {said}")
	try Expect.contains(stdout, needle: AwaitEventWord, message: "`{MonitorSubcommandName} {SchedFilterOption}` showed no await of the green thread the program waited on. {said}")
end 'monitor --filter=sched shows the spawn and the await of a green thread'
