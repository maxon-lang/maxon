let InlinedHandlerCaseLabel = "an-address-inside-a-handler-inlined-into-a-synthesized-behaviour-is-armed"

let ServiceBehaveName = "Mixer.__behave"
let HandlerName = "mixRounds"
let HandlerQualifier = "."
let RangeSiteColumn = 1

test 'an address inside an authored handler inlined into a synthesized behaviour function is armed and stops as the handler'
	let staged = builtFixture(InlinedHandlerCaseLabel, fixture: ServiceHandlerFixtureName)
	let executable = builtExecutable(staged)
	let dump = spawnDumpInfo(executable, staged: staged, sections: StringArray.create(0))

	try Expect.equal(dump.exitCode(), expected: 0, message: "`{DebugSubcommandName} {DumpInfoOptionName} <exe>` did not print the sidecar. It wrote to stderr: {dump.stderr}")

	let printed = withoutCarriageReturns(dump.stdout)
	let behaveRow = functionRowOf(dumpSectionRows(printed, heading: DumpFunctionsHeading), name: ServiceBehaveName)
	let (behaveStart, behaveLimit) = requiredCodeRange(behaveRow, what: "`{ServiceBehaveName}`'s function row")
	let rangeRows = dumpSectionRows(printed, heading: DumpInlineRangesHeading)
	let (handlerOffset, siteRow) = handlerRangeInBehave(dumpSectionRows(printed, heading: DumpInlineSitesHeading), rangeRows: rangeRows, start: behaveStart, limit: behaveLimit)

	try Expect.equal(originIn(behaveRow), expected: SynthesizedOrigin, message: "the behaviour function of a spawned type is written by the compiler, and the sidecar must say so; the row was: {behaveRow}")
	try Expect.equal(originIn(siteRow), expected: AuthoredOrigin, message: "`{HandlerName}` is the program's own code wherever the inliner copied it, and its inline site must say so; the row was: {siteRow}")

	if anInlineRangeStartsAt(rangeRows, offset: behaveStart) 'noControlOffset'
		panic("{InlinedHandlerCaseLabel}: the gate could not run — `{ServiceBehaveName}` opens with an inlined body at {hexSpelling(behaveStart)}, so there is no offset of the behaviour function's own code to aim the control at")
	end 'noControlOffset'

	let commands = debugCommandLine(["{BreakCommand} {exactOffsetTarget(handlerOffset)}", "{BreakCommand} {exactOffsetTarget(behaveStart)}", RunCommand])
	let session = spawnDebugBatch(executable, staged: staged, commands: commands, extraOptions: StringArray.create(0))
	let events = batchEvents(session.stdout)
	let said = renderedEvents(session.stdout, stderr: session.stderr)
	let answers = eventsOfKind(events, kind: BreakpointEventName)

	try Expect.equal(answers.count(), expected: 2, message: "each `{BreakCommand}` answers one `{BreakpointEventName}` event. It printed: {listedLines(eventKinds(events))}. {said}")

	let handler = eventAt(answers, index: 0)
	try Expect.equal(textOf(handler, node: handler.root, key: ActionKey), expected: SetAction, message: "{hexSpelling(handlerOffset)} is `{HandlerName}`'s code, inlined into `{ServiceBehaveName}`: whose code an offset is follows the innermost inline site there, not the physical function that holds it. {said}")

	let control = eventAt(answers, index: 1)
	try Expect.equal(textOf(control, node: control.root, key: ActionKey), expected: RefusedAction, message: "the control: `{ServiceBehaveName}`'s own entry is the compiler's code. {said}")
	try Expect.equal(textOf(control, node: control.root, key: ReasonKey), expected: InsideRuntimeSymbolReason, message: "the control's refusal names why. {said}")

	let stops = eventsOfKind(events, kind: StopEventName)
	try Expect.atLeast(stops.count(), than: 1, message: "every message runs `{HandlerName}`, so the armed offset is reached. It printed: {listedLines(eventKinds(events))}. {said}")

	let stopped = eventAt(stops, index: 0)
	try Expect.equal(textOf(stopped, node: stopped.root, key: OffsetKey), expected: hexSpelling(handlerOffset), message: "the stop is at the armed offset. {said}")

	let frames = childrenOf(stopped, node: stopped.root, key: BacktraceKey)
	try Expect.atLeast(frames.count(), than: 1, message: "a `{StopEventName}` carries its walk under `{BacktraceKey}`. {said}")
	try Expect.isTrue(namesTheHandler(textOf(stopped, node: nodeAt(frames, index: 0), key: FunctionKey)), message: "the innermost frame at a stop inside the inlined handler is `{HandlerName}`, not the behaviour function it was copied into. {said}")
end 'an address inside an authored handler inlined into a synthesized behaviour function is armed and stops as the handler'

function namesTheHandler(name String) returns bool
	return name == HandlerName or name.endsWith("{HandlerQualifier}{HandlerName}")
end 'namesTheHandler'

function handlerRangeInBehave(siteRows StringArray, rangeRows StringArray, start PrintedNumber, limit PrintedNumber) returns (PrintedNumber, String)
	for rangeRow in rangeRows 'eachRange'
		let offset = hexValue(firstToken(rangeRow))
		let site = try whitespaceTokens(rangeRow).get(RangeSiteColumn) otherwise continue

		if offset < start or offset >= limit 'outsideTheBehaviour'
			continue
		end 'outsideTheBehaviour'

		for siteRow in siteRows 'eachSite'
			let name = try inlineSiteNameIn(siteRow) otherwise continue

			if firstToken(siteRow) == site and namesTheHandler(name) 'theHandlersSite'
				return (offset, siteRow)
			end 'theHandlersSite'
		end 'eachSite'
	end 'eachRange'

	panic("{InlinedHandlerCaseLabel}: the gate could not run — no inline range of `{HandlerName}` lies inside `{ServiceBehaveName}` [{hexSpelling(start)}, {hexSpelling(limit)}), so the compiler did not inline the handler into its behaviour function. Sites:{listedLines(siteRows)}{LineFeed}Ranges:{listedLines(rangeRows)}")
end 'handlerRangeInBehave'

function anInlineRangeStartsAt(rangeRows StringArray, offset PrintedNumber) returns bool
	for rangeRow in rangeRows 'eachRange'
		if hexValue(firstToken(rangeRow)) == offset 'startsThere'
			return true
		end 'startsThere'
	end 'eachRange'

	return false
end 'anInlineRangeStartsAt'
