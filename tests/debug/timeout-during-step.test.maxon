let TimeoutDuringStepCaseLabel = "timeout-during-step"

let OneSecond = 1
let StepTimedOutExitCode = 1

test 'a step whose stop never arrives times out rather than hanging the session'
	let staged = builtFixture(TimeoutDuringStepCaseLabel, fixture: SpinFixtureName)
	let stepStopTimeout = "{DebugStopTimeoutOptionPrefix}{OneSecond}"
	let grindLine = anchorLine(staged, anchor: "grind")
	let commands = debugCommandLine(["{BreakCommand} {lineTarget(grindLine)}", RunCommand, FinishCommand])
	let session = spawnDebugBatch(builtExecutable(staged), staged: staged, commands: commands, extraOptions: [stepStopTimeout])
	let events = batchEvents(session.stdout)
	let said = renderedEvents(session.stdout, stderr: session.stderr)

	Expect.equal(eventsOfKind(events, kind: StopEventName).count() as AssertedInt, expected: 1, message: "the breakpoint at `{lineTarget(grindLine)}` was not the one stop this session reached before the step that never returns. It printed: {renderedRows(eventKinds(events))}. {said}")
	Expect.equal(eventsOfKind(events, kind: TimeoutEventName).count() as AssertedInt, expected: 1, message: "a `{FinishCommand}` out of a frame that never returns must be reported as a `{TimeoutEventName}`, not waited on forever. {said}")
	Expect.equal(session.exitCode() as AssertedInt, expected: StepTimedOutExitCode, message: "a session that timed out mid-step is a failed one. {said}")
end 'a step whose stop never arrives times out rather than hanging the session'
