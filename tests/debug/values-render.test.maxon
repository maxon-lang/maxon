let ValuesRenderCaseLabel = "values-render"

let WholeLocalRendering = "whole=42"
let LevelLocalRendering = "level=5"
let FlagLocalRendering = "flag=true"
let RatioLocalRendering = "ratio=2.5"
let LabelLocalRendering = "label=\"parcel\" (len=6)"
let GradeLocalRendering = "grade=silver"
let DeltaLocalRendering = "delta=-8"

let ParcelLocalName = "parcel"
let ShipmentLocalName = "shipment"
let ItemsLocalName = "items"
let CarryingCaseName = "carrying"

test 'every kind of local renders as itself, and an enum shows the case name its raw tag stands for'
	let staged = builtFixture(ValuesRenderCaseLabel, fixture: ValuesFixtureName)
	let renderedAt = anchorLine(staged, anchor: "rendered")
	let commands = debugCommandLine(["{BreakCommand} {lineTarget(renderedAt)}", RunCommand, LocalsCommand])
	let session = spawnDebugBatch(builtExecutable(staged), staged: staged, commands: commands, extraOptions: StringArray.create())
	let events = batchEvents(session.stdout)
	let said = renderedEvents(session.stdout, stderr: session.stderr)
	let listings = eventsOfKind(events, kind: LocalsEventName)

	Expect.equal(listings.count() as AssertedInt, expected: 1, message: "`{LocalsCommand}` at a stop printed no `{LocalsEventName}` event. It printed: {renderedRows(eventKinds(events))}. {said}")

	let listed = eventAt(listings, index: 0)
	let rows = renderedRows(valueRows(listed, node: listed.root, key: LocalsKey))

	Expect.contains(rows, needle: WholeLocalRendering, message: "an integer renders in decimal. The locals were: {rows}. {said}")
	Expect.contains(rows, needle: LevelLocalRendering, message: "a RANGED integer is still an integer and renders as its value, not as its range. The locals were: {rows}. {said}")
	Expect.contains(rows, needle: FlagLocalRendering, message: "a bool renders as `true` or `false`. The locals were: {rows}. {said}")
	Expect.contains(rows, needle: RatioLocalRendering, message: "a float renders as the shortest text that round-trips. The locals were: {rows}. {said}")
	Expect.contains(rows, needle: LabelLocalRendering, message: "a String renders as its quoted text AND its length, because a String is a heap object and an empty one and an unreadable one are otherwise the same picture. The locals were: {rows}. {said}")
	Expect.contains(rows, needle: DeltaLocalRendering, message: "a RANGED alias whose low bound is negative is a SIGNED integer, and a signed value read out of its slot without sign extension reads as a huge positive number rather than as a small negative one — the one wrong answer a reader cannot tell from a right one. The locals were: {rows}. {said}")
	Expect.contains(rows, needle: GradeLocalRendering, message: "an enum field's sidecar offset is its RAW TAG, and this enum's tags are not its ordinals — so an enum rendered by ORDINAL prints a different case's name and a reader cannot see that it did. The locals were: {rows}. {said}")

	let parcelValues = valueNamed(listed, node: listed.root, key: LocalsKey, name: ParcelLocalName)
	Expect.equal(parcelValues.count() as AssertedInt, expected: 1, message: "the struct local `{ParcelLocalName}` is not in the listing. The locals were: {rows}. {said}")

	let parcelFields = renderedRows(valueRows(listed, node: nodeAt(parcelValues, index: 0), key: ChildrenKey))
	Expect.contains(parcelFields, needle: "width=3", message: "a struct renders its FIELDS as children, each under its own name. `{ParcelLocalName}`'s children were: {parcelFields}. {said}")
	Expect.contains(parcelFields, needle: "height=4", message: "`{ParcelLocalName}`'s children were: {parcelFields}. {said}")

	let itemValues = valueNamed(listed, node: listed.root, key: LocalsKey, name: ItemsLocalName)
	Expect.equal(itemValues.count() as AssertedInt, expected: 1, message: "the Array local `{ItemsLocalName}` is not in the listing. The locals were: {rows}. {said}")

	let itemElements = renderedRows(valueRows(listed, node: nodeAt(itemValues, index: 0), key: ChildrenKey))
	Expect.contains(itemElements, needle: "=1", message: "an Array renders its ELEMENTS as children. `{ItemsLocalName}`'s children were: {itemElements}. {said}")
	Expect.contains(itemElements, needle: "=2", message: "`{ItemsLocalName}`'s children were: {itemElements}. {said}")

	let shipmentValues = valueNamed(listed, node: listed.root, key: LocalsKey, name: ShipmentLocalName)
	Expect.equal(shipmentValues.count() as AssertedInt, expected: 1, message: "the union local `{ShipmentLocalName}` is not in the listing. The locals were: {rows}. {said}")
	Expect.contains(textOf(listed, node: nodeAt(shipmentValues, index: 0), key: DisplayKey), needle: CarryingCaseName, message: "a payload union renders the CASE it is holding; a union shown as its payload alone says nothing about which case that payload belongs to. The locals were: {rows}. {said}")
end 'every kind of local renders as itself, and an enum shows the case name its raw tag stands for'
