let AlignmentCaseLabel = "entry-alignment"
let FunctionsSection = "functions"

let Arm64TargetPrefix = "arm64-"
let X64EntryAlignmentBytes = 32
let Arm64EntryAlignmentBytes = 16

function entryAlignmentOf(target String) returns PrintedNumber
	if target.startsWith(X64TargetPrefix) 'anX64Lane'
		return X64EntryAlignmentBytes
	end 'anX64Lane'

	if target.startsWith(Arm64TargetPrefix) 'anArm64Lane'
		return Arm64EntryAlignmentBytes
	end 'anArm64Lane'

	panic("the gate could not run - {target} is a native target this case states no entry alignment for")
end 'entryAlignmentOf'

function entryIsAligned(row String, alignment PrintedNumber) returns bool
	return match codeRangeIn(row) 'range'
		none gives false
		range(start, _) gives (start and (alignment - 1)) == 0
	end 'range'
end 'entryIsAligned'

test 'every function the sidecar lists starts on the entry boundary of its target, and so does the .text that holds them'
	let targets = nativeTargets()
	try Expect.notEqual(targets.count(), expected: 0, message: "{TargetsTablePath} lists no native target, so this case would assert nothing.")

	var findings = StringArray.create(0)
	var unchecked = StringArray.create(0)

	for target in targets 'eachTarget'
		let alignment = entryAlignmentOf(target)
		let staged = stagedFixtureTree(FixturesDirName, stagingRootDir: StagingRootDirName, caseLabel: "{AlignmentCaseLabel}-{target}", fixture: SpansFixtureName)
		let executable = buildStagedSource(staged.join(StagedProgramFileName), staged: staged, what: "{SpansFixtureName} for {target}", extraArguments: ["{TargetOptionPrefix}{target}"])
		let dumpRun = spawnDumpInfo(executable, staged: staged, sections: [FunctionsSection])

		try Expect.equal(dumpRun.exitCode(), expected: 0, message: "`{TestedCompilerStem} {DebugSubcommandName} {DumpInfoOptionName}` did not print the {target} sidecar. It printed: {dumpRun.stdout} - and wrote to stderr: {dumpRun.stderr}")

		var checkedHere = 0 as PrintedNumber

		for row in dumpSectionRows(withoutCarriageReturns(dumpRun.stdout), heading: DumpFunctionsHeading) 'eachRow'
			_ = try originOfRow(row) otherwise continue
			checkedHere = checkedHere + 1

			if not entryIsAligned(row, alignment: alignment) 'misaligned'
				findings.push("{target}: {row}")
			end 'misaligned'
		end 'eachRow'

		if checkedHere == 0 'nothingRead'
			unchecked.push(target)
		end 'nothingRead'

		let textBase = textBaseAddress(fileBytes(executable), target: target)

		if textBase == 0 'textBaseUnread'
			findings.push("{target}: the image header names no entry address, so its .text base could not be read")
		end 'textBaseUnread'

		if (textBase and (alignment - 1)) != 0 'textBaseOff'
			findings.push("{target}: .text starts at 0x{textBase:x}, off the {alignment}-byte boundary its functions are laid out on")
		end 'textBaseOff'
	end 'eachTarget'

	try Expect.isEmpty(joined(unchecked, separator: Space), message: "these targets' sidecars listed no function row, so nothing was checked for them.")
	try Expect.isEmpty(joined(findings, separator: LineFeed), message: "these functions start off their target's entry boundary of `.text` (x64 {X64EntryAlignmentBytes}, arm64 {Arm64EntryAlignmentBytes}), list no code range, or sit in an image whose `.text` is off it. An entry that shares a fetch group with the end of the function laid out before it makes a hot path's speed a function of how large every earlier function happens to be, so an edit that moves nothing on the path can change how fast it runs.")
end 'every function the sidecar lists starts on the entry boundary of its target, and so does the .text that holds them'
