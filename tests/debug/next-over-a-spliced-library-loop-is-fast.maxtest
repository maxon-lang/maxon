let SplicedLoopCaseLabel = "next-over-a-spliced-library-loop-is-fast"

test 'a next over a line whose library loop is spliced into the frame runs the loop rather than stepping it'
	let staged = builtFixture(SplicedLoopCaseLabel, fixture: SplicedLoopFixtureName)
	let scanLine = anchorLine(staged, anchor: "spliced-scan")
	let afterLine = anchorLine(staged, anchor: "after-scan")
	let commands = debugCommandLine(["{BreakCommand} {lineTarget(scanLine)}", RunCommand, NextCommand])
	let session = spawnDebugBatch(builtExecutable(staged), staged: staged, commands: commands, extraOptions: StringArray.create())
	let events = batchEvents(session.stdout)
	let said = renderedEvents(session.stdout, stderr: session.stderr)

	try Expect.equal(eventsOfKind(events, kind: TimeoutEventName).count() as AssertedInt, expected: 0, message: "⛔ LIBRARY CODE SPLICED INTO THE PROGRAM'S OWN FRAME IS RUN TO THE END OF THE SPLICE, NOT SINGLE-STEPPED. The scan visits three hundred thousand elements, and one trap per instruction of it outlasts the stop timeout. It printed: {renderedRows(eventKinds(events))}. {said}")

	let stops = eventsOfKind(events, kind: StopEventName)
	try Expect.equal(stops.count() as AssertedInt, expected: 2, message: "the breakpoint on the scan and the `{NextCommand}` are two stops. It printed: {renderedRows(eventKinds(events))}. {said}")

	let landed = eventAt(stops, index: 1)
	try Expect.equal(numberOf(landed, node: landed.root, key: LineKey) as AssertedInt, expected: afterLine as AssertedInt, message: "the `{NextCommand}` lands on the line after the scan. {said}")
end 'a next over a line whose library loop is spliced into the frame runs the loop rather than stepping it'
