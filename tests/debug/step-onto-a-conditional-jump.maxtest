let OntoTheJumpCaseLabel = "step-onto-a-conditional-jump"

let TestRowOfTheBranchLine = 0
let JumpRowOfTheBranchLine = 1
let StatementRowsOfTheBranchLine = 2
let StepsOntoAndOffTheJump = 2
let StopsOntoAndOffTheJump = 3

test 'a single step that lands on an armed conditional jump publishes it, and the step off it lands where the jump goes'
	let staged = builtFixture(OntoTheJumpCaseLabel, fixture: SteppingFixtureName)
	let branchLine = anchorLine(staged, anchor: "branch")
	let takenLine = anchorLine(staged, anchor: "branch-taken")
	let executable = builtExecutable(staged)
	let rows = statementOffsetsOfLine(executable, staged: staged, line: branchLine)

	try Expect.atLeast(rows.count() as AssertedInt, than: StatementRowsOfTheBranchLine, message: "this case needs the condition's TEST and its JUMP to be two statement rows of the branch line, so both can be armed; the line table gives it {rows.count()}")

	let comparison = try rows.get(TestRowOfTheBranchLine) otherwise panic("step-onto-a-conditional-jump: the row count was asserted on the line above")
	let jump = try rows.get(JumpRowOfTheBranchLine) otherwise panic("step-onto-a-conditional-jump: the row count was asserted on the line above")
	let commands = debugCommandLine(appendedCommands(["{BreakCommand} {exactOffsetTarget(comparison)}", "{BreakCommand} {exactOffsetTarget(jump)}", RunCommand], rest: repeatedCommand(StepCommand, times: StepsOntoAndOffTheJump)))
	let session = spawnDebugBatch(executable, staged: staged, commands: commands, extraOptions: StringArray.create())
	let events = batchEvents(session.stdout)
	let said = renderedEvents(session.stdout, stderr: session.stderr)
	let stops = eventsOfKind(events, kind: StopEventName)
	var walked = StringArray.create()

	for stop in stops 'eachStop'
		walked.push("{textOf(stop, node: stop.root, key: ReasonKey)} {textOf(stop, node: stop.root, key: FunctionKey)}:{numberOf(stop, node: stop.root, key: LineKey)} {textOf(stop, node: stop.root, key: OffsetKey)}")
	end 'eachStop'

	try Expect.equal(stops.count() as AssertedInt, expected: StopsOntoAndOffTheJump, message: "⛔ THE REGRESSION THIS GUARDS IS SILENCE. The first step is one instruction that LANDS on the armed jump, whose `int3` never runs; the second is a step off a byte the agent SIMULATES, which runs nothing and so has no trap to publish. The breakpoint on the test, the landing on the jump and the landing past it are three stops. The session stopped: {renderedRows(walked)}. It printed: {renderedRows(eventKinds(events))}. {said}")

	let onTheTest = eventAt(stops, index: 0)
	try Expect.equal(textOf(onTheTest, node: onTheTest.root, key: OffsetKey), expected: hexSpelling(comparison), message: "the first stop is the breakpoint on the condition's test. The session stopped: {renderedRows(walked)}. {said}")

	let onTheJump = eventAt(stops, index: 1)
	try Expect.equal(textOf(onTheJump, node: onTheJump.root, key: OffsetKey), expected: hexSpelling(jump), message: "the first step lands on the jump, one instruction on. The session stopped: {renderedRows(walked)}. {said}")

	let pastTheJump = eventAt(stops, index: 2)
	try Expect.equal(textOf(pastTheJump, node: pastTheJump.root, key: ReasonKey), expected: StepStopReason, message: "the stop off a simulated jump is the step's. The session stopped: {renderedRows(walked)}. {said}")
	try Expect.equal(numberOf(pastTheJump, node: pastTheJump.root, key: LineKey) as AssertedInt, expected: takenLine as AssertedInt, message: "the second step lands where the branch went, which for this fixture is the arm the condition takes. The session stopped: {renderedRows(walked)}. {said}")
end 'a single step that lands on an armed conditional jump publishes it, and the step off it lands where the jump goes'
