let ProcessListingTool = "ps"
let ProcessListingMs = 10000
let ProcessListingColumns = "pid,ppid,pgid,stat,etime,args"
let ProcessListingOption = "-axo"
let StubProcessName = "debugserver"
let ProcessStateColumn = 3
let DefunctState = "Z"
let SamplingTool = "sample"
let SamplingSeconds = "1"
let SamplingMs = 30000
let StateColumnCount = 4
let StateRowSeparator = "; "
let AliveStateRow = "alive"
export let GoneStateRow = "gone"

function listedProcesses() returns String throws SubprocessError
	let listed = try Subprocess.run(Executable.name(ProcessListingTool), arguments: [ProcessListingOption, ProcessListingColumns], timeoutMs: ProcessListingMs)

	return listed.stdout
end 'listedProcesses'

export function processSnapshot(matching String) returns String
	#if os(Windows)
		return "(this host has no process listing to search for {matching})"
	#else
		let listing = try listedProcesses() otherwise (e) 'noListing'
			return "(the process listing could not run: {e.displayReason()})"
		end 'noListing'

		var kept = StringArray.create(0)

		for line in outputLines(listing) 'eachProcess'
			if line.contains(matching) or line.contains(StubProcessName) or isDefunct(line) 'relevant'
				kept.push(line)
			end 'relevant'
		end 'eachProcess'

		return "{kept.count()} process(es) name {matching} or {StubProcessName}, or are defunct:{LineFeed}{listedLines(kept)}"
	#endif
end 'processSnapshot'

function isDefunct(line String) returns bool
	let tokens = whitespaceTokens(line)
	let state = try tokens.get(ProcessStateColumn as ElementIndex) otherwise return false

	return state.startsWith(DefunctState)
end 'isDefunct'

function leadingColumns(columns StringArray) returns String
	var kept = StringArray.create(0)

	for column in columns 'eachColumn'
		if kept.count() >= StateColumnCount 'enough'
			break
		end 'enough'

		kept.push(column)
	end 'eachColumn'

	return joined(kept, separator: Space)
end 'leadingColumns'

export function stateRowOf(process Pid) returns String
	if not Process.isAlive(process) 'ended'
		return GoneStateRow
	end 'ended'

	#if os(Windows)
		return AliveStateRow
	#else
		let listing = try listedProcesses() otherwise (e) 'noListing'
			return "(the process listing could not run: {e.displayReason()})"
		end 'noListing'

		var rows = StringArray.create(0)
		var listedItself = false

		for line in outputLines(listing) 'eachProcess'
			let columns = whitespaceTokens(line)
			let first = try columns.get(0 as ElementIndex) otherwise continue

			if first == "{process}" 'theProcess'
				rows.push("process {leadingColumns(columns)}")
				listedItself = true
			end 'theProcess' else if line.contains(StubProcessName) 'aStub'
				rows.push("stub {leadingColumns(columns)}")
			end 'aStub'
		end 'eachProcess'

		if not listedItself 'leftBetweenTheTwoReads'
			return GoneStateRow
		end 'leftBetweenTheTwoReads'

		return joined(rows, separator: StateRowSeparator)
	#endif
end 'stateRowOf'

export function sampledStubs() returns String
	#if os(Windows)
		return "(this host has no debug stub to sample)"
	#else
		let listing = try listedProcesses() otherwise (e) 'noListing'
			return "(the process listing could not run: {e.displayReason()})"
		end 'noListing'

		var report = ""

		for line in outputLines(listing) 'eachProcess'
			if not line.contains(StubProcessName) 'notAStub'
				continue
			end 'notAStub'

			let tokens = whitespaceTokens(line)
			let first = try tokens.get(0 as ElementIndex) otherwise continue
			let process = try int.fromString(first) otherwise continue

			report.append("{LineFeed}{line}{LineFeed}{sampledStack(process as Pid)}")
		end 'eachProcess'

		return report
	#endif
end 'sampledStubs'

export function sampledStack(process Pid) returns String
	#if os(Windows)
		return "(this host has no sampler to read process {process})"
	#else
		let sampled = try Subprocess.run(Executable.name(SamplingTool), arguments: ["{process}", SamplingSeconds], timeoutMs: SamplingMs) otherwise (e) 'noSample'
			return "(the sampler could not run: {e.displayReason()})"
		end 'noSample'

		return sampled.stdout
	#endif
end 'sampledStack'
