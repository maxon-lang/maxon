let BurstDetachCaseLabel = "a-program-detached-while-it-starts-threads-runs-to-its-own-end"

let BurstDetachLaps = 8
let BurstDetachStopTimeout = "0.01"
let BurstProcessorCount = "64"
let BurstProcessorVariable = "MAXON_MAX_PROCS"
let BurstEndDeadlineMs = 10000
let BurstLookGapMs = 1

#if os(Linux)
	typealias BurstLap = int(0 to 100)
#endif

test 'a program the session detaches from while it is starting threads runs on to its own end with every thread released'
	#if os(Linux)
		let staged = builtFixture(BurstDetachCaseLabel, fixture: ThreadBurstFixtureName)
		let marker = staged.join(BurstFinishedMarkerName)
		let options = ["{DebugStopTimeoutOptionPrefix}{BurstDetachStopTimeout}", targetEnvOption(BurstProcessorVariable, value: BurstProcessorCount)]
		var lap = 0 as BurstLap

		while lap < BurstDetachLaps 'eachLap'
			lap = lap + 1

			if File.exists(marker) 'leftByTheLapBefore'
				try File.delete(marker) otherwise panic("the gate could not run — the marker of the lap before could not be cleared")
			end 'leftByTheLapBefore'

			let session = spawnDebugBatch(builtExecutable(staged), staged: staged, commands: debugCommandLine([RunCommand, DetachCommand]), extraOptions: options)
			let events = batchEvents(session.stdout)
			let said = renderedEvents(session.stdout, stderr: session.stderr)

			Expect.equal(eventsOfKind(events, kind: ErrorEventName).count(), expected: 0, message: "lap {lap}: the detach of a program that was still starting threads was refused. {said}")

			let released = Clock.nowMs()

			while not File.exists(marker) and Clock.elapsedMs(released) < BurstEndDeadlineMs 'untilTheProgramEnds'
				sleep(BurstLookGapMs)
			end 'untilTheProgramEnds'

			Expect.isTrue(File.exists(marker), message: "⛔ lap {lap}: A DETACHED PROGRAM RUNS TO ITS OWN END, and {BurstFinishedMarkerName} never appeared. A thread the session was tracing when it detached and never released is killed with the session (`PTRACE_O_EXITKILL`), and a thread killed takes its process with it. The session ran {session.durationMs} ms and exited {session.exitCode()}. {said}")

			let program = burstProcessId(staged)
			let marked = Clock.nowMs()

			while Process.isAlive(program) and Clock.elapsedMs(marked) < BurstEndDeadlineMs 'untilTheProgramExits'
				sleep(BurstLookGapMs)
			end 'untilTheProgramExits'

			Expect.isFalse(Process.isAlive(program), message: "lap {lap}: the released program wrote {BurstFinishedMarkerName} and was still running {BurstEndDeadlineMs} ms later: {stateRowOf(program)}. {said}")
		end 'eachLap'

		discardStagedDir(staged)
	#endif
end 'a program the session detaches from while it is starting threads runs on to its own end with every thread released'
