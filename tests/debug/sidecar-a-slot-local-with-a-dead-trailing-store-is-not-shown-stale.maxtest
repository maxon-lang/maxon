let DeadStoreCaseLabel = "sidecar-a-slot-local-with-a-dead-trailing-store-is-not-shown-stale"

let DeadStoreLocalName = "limit"
let DeadStoreStaleValue = "5"

test 'a var held in a stack slot whose last assignment was optimised away is not read as its older value'
	let staged = builtFixture(DeadStoreCaseLabel, fixture: DeadStoreFixtureName)
	let dump = spawnDumpInfo(builtExecutable(staged), staged: staged, sections: StringArray.create(0))
	let functionRows = dumpSectionRows(withoutCarriageReturns(dump.stdout), heading: DumpFunctionsHeading)
	var slotRows = 0 as Count

	for row in localRowsOf(functionRows, name: MainFunctionName) 'eachLocal'
		slotRows = slotRows + 1 if firstToken(row) == DeadStoreLocalName and row.contains(StackSlotMark) else slotRows
	end 'eachLocal'

	Expect.notEqual(slotRows, expected: 0, message: "`{DeadStoreLocalName}` has no stack-slot row in `{MainFunctionName}`, so this case no longer asks about a SPILLED version. `main`'s locals were: {listedLines(localRowsOf(functionRows, name: MainFunctionName))}")

	let tailAt = anchorLine(staged.join(StagedProgramFileName), anchor: "tail")
	let commands = debugCommandLine(["{BreakCommand} {lineTarget(tailAt)}", RunCommand, "{PrintCommand} {DeadStoreLocalName}"])
	let session = spawnDebugBatch(builtExecutable(staged), staged: staged, commands: commands, extraOptions: StringArray.create(0))
	let events = batchEvents(session.stdout)
	let said = renderedEvents(session.stdout, stderr: session.stderr)
	let answers = eventsOfKind(events, kind: ValueEventName)

	Expect.equal(answers.count(), expected: 1, message: "`{PrintCommand} {DeadStoreLocalName}` printed no `{ValueEventName}` event. It printed: {listedLines(eventKinds(events))}. {said}")

	let answered = eventAt(answers, index: 0)
	let value = memberOf(answered, node: answered.root, key: ValueKey)

	Expect.notEqual(textOf(answered, node: nodeAt(value, index: 0), key: DisplayKey), expected: DeadStoreStaleValue, message: "`{DeadStoreLocalName} = 7` is the last statement that touches the name and nothing reads it after, so the optimiser deleted it and no value carries the new version. The older version's slot still holds {DeadStoreStaleValue}, and a row of it that covers the stop answers with that: a previous value wearing the current name. {said}")

	discardStagedDir(staged)
end 'a var held in a stack slot whose last assignment was optimised away is not read as its older value'
