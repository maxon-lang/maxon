let ByteIdenticalDebugInfoCaseLabel = "byte-identical-debug-info"

test 'every build of one source is the same executable, byte for byte, with no sanctioned exception'
	let identity = ImageIdentityCase.staging(ByteIdenticalDebugInfoCaseLabel, fixture: SpansFixtureName)

	let firstDefault = identity.built("the first default", extraArguments: StringArray.create(), retainedAs: FirstDefaultImageName)
	Expect.isTrue(firstDefault.wroteASidecar, message: "a default build writes `{identity.sidecar.filename()}` beside its executable — that is what every reader of debug info in this tree relies on, and a build that wrote none leaves the comparisons below comparing two binaries nobody can debug.")

	let secondDefault = identity.built("the second default", extraArguments: StringArray.create(), retainedAs: SecondDefaultImageName)

	identity.requireSameImage(firstDefault.retained, second: secondDefault.retained, why: "⭐ THE POSITIVE CONTROL. Two DEFAULT builds of one staged source to one output path must agree before any difference below can be attributed to a flag. No writer stamps a clock into an image, so a difference here is the build failing to be reproducible — and it would make the identity this case goes on to claim unprovable rather than false.")

	let withoutSidecar = identity.built("the `{NoDebugInfoBuildFlag}`", extraArguments: [NoDebugInfoBuildFlag], retainedAs: NoSidecarImageName)
	Expect.isFalse(withoutSidecar.wroteASidecar, message: "`{NoDebugInfoBuildFlag}` is the opt-out and it wrote `{identity.sidecar.filename()}` anyway, so the flag was accepted and did nothing.")

	identity.requireSameImage(firstDefault.retained, second: withoutSidecar.retained, why: "⭐⭐ THE HEADLINE: THE SIDECAR IS METADATA AND NEVER DECIDES AN INSTRUCTION. The binary you debug must be the binary you shipped, byte for byte — otherwise every reading taken under debug info is a reading of a different program, and `{NoDebugInfoBuildFlag}` becomes a flag nobody can safely leave off.")
end 'every build of one source is the same executable, byte for byte, with no sanctioned exception'
