let ReplTailSilenceMs = 300
let ReplTailCapMs = 5000
let ReplProcess = "the debug REPL"

type ReplSession implements ChildLineSink
	var child as StreamingSubprocess
	var pump as ChildPump
	var transcript as String
	var hungEvidence as String
	var staged as FilePath

	static function open(executable FilePath, staged FilePath, environment Environment = Environment.inherit, extraOptions StringArray = StringArray.create(0)) returns ReplSession
		let arguments = StringArray.create(0)
		arguments.push(DebugSubcommandName)
		arguments.push(executable.toString())

		for option in extraOptions 'eachOption'
			arguments.push(option)
		end 'eachOption'

		let child = try StreamingSubprocess.spawnWithEnvironment(Executable.path(testedCompilerPath()), arguments: arguments, workingDirectory: WorkingDirectory.at(staged), environment: environment) otherwise (e) 'spawnFailed'
			panic("the gate could not run — the debug REPL could not be spawned ({e.displayReason()}).")
		end 'spawnFailed'

		let pump = try ChildPump.of(child) otherwise (e) 'outputNotTaken'
			panic("the gate could not run — the debug REPL's output could not be taken ({e.displayReason()}).")
		end 'outputNotTaken'

		return Self{child: child, pump: pump, transcript: "", hungEvidence: "", staged: staged}
	end 'open'

	export function say(command String)
		try self.child.writeStdinLine(command) otherwise (e) 'writeFailed'
			panic("the gate could not run — the debug REPL refused the command `{command}` ({e.displayReason()}).")
		end 'writeFailed'
	end 'say'

	export function said() returns String
		return withoutCarriageReturns(self.transcript)
	end 'said'

	export function sayUntilThe(needle String, deadlineMs DurationMs) returns bool
		let started = Clock.nowMs()

		while Clock.remainingMs(started, deadlineMs: deadlineMs) > 0 and not self.transcript.contains(needle) 'untilItIsSaid'
			if not self.absorbNext(Clock.remainingMs(started, deadlineMs: deadlineMs)) 'streamsEnded'
				break
			end 'streamsEnded'
		end 'untilItIsSaid'

		return self.transcript.contains(needle)
	end 'sayUntilThe'

	export function finish(deadlineMs DurationMs) returns bool
		self.child.closeStdin()

		let ending = awaitChildEnd(self.pump, child: self.child, into: self, feed: StdinFeed.never(), started: Clock.nowMs(), deadlineMs: deadlineMs, endsWhen: RunEndsWhen.childExits)
		let inTime = self.endedInTime(ending)
		let survivors = concludeChild(self.pump, child: self.child, into: self, ending: ending, tailSilenceMs: ReplTailSilenceMs, tailCapMs: ReplTailCapMs)

		requireSurvivorsEnded(survivors, what: ReplProcess)

		return inTime
	end 'finish'

	function endedInTime(ending ChildEnd) returns bool
		match ending 'ending'
			exited then return true
			deadline then return self.hungAtTheDeadline()
			reapedElsewhere then panic("{lostStatusMessage(ReplProcess)}")
			waitFailed(e) then panic("{waitFailureMessage(ReplProcess, failure: e)}")
		end 'ending'
	end 'endedInTime'

	function hungAtTheDeadline() returns bool
		self.hungEvidence = self.evidenceOfAHang()

		return false
	end 'hungAtTheDeadline'

	export function processId() returns Pid
		return try self.child.processId() otherwise panic("the gate could not run — the debug REPL has no process id.")
	end 'processId'

	export function evidence() returns String
		return self.hungEvidence
	end 'evidence'

	function evidenceOfAHang() returns String
		let replProcess = try self.child.processId() otherwise return "(the hung REPL's process id is gone)"

		return "{processSnapshot(self.staged.toString())}{LineFeed}The hung REPL, sampled:{LineFeed}{sampledStack(replProcess)}{LineFeed}The debug stubs, sampled:{sampledStubs()}"
	end 'evidenceOfAHang'

	export function heard(_ StdioStream, text String)
		self.transcript.append("{text}{LineFeed}")
	end 'heard'

	export function broken(stream StdioStream, reason String)
		refuseBrokenRead(ReplProcess, stream: stream, reason: reason)
	end 'broken'

	function absorbNext(waitMs DurationMs) returns bool
		let event = self.pump.next(waitMs)
		event.deliverTo(self)

		return match event 'event'
			exhausted gives false
			said or
			closed or
			broke or
			silent gives true
		end 'event'
	end 'absorbNext'
end 'ReplSession'
