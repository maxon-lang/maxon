let StubProxyFixtureName = "stubproxy"
export let ProxiedSessionBoundMs = 60000

export let DebugServerName = "debugserver"
let RealStubVariable = "MAXON_PROXY_REAL_STUB"
let InjectAfterVariable = "MAXON_PROXY_INJECT_AFTER"
let InjectPayloadVariable = "MAXON_PROXY_INJECT"
let TraceVariable = "MAXON_PROXY_TRACE"
let ModeVariable = "MAXON_PROXY_MODE"
let PacketSizeVariable = "MAXON_PROXY_PACKET_SIZE"
let AdvertiseVariable = "MAXON_PROXY_ADVERTISE"
let AnswerMode = "answer"
let LateHaltMode = "late-halt"
let SilentMode = "silent"
let ProbeAnswerMode = "probe-answer"
let ProbeSwallowMode = "probe-swallow"
let SmallBufferMode = "small-buffer"
let AdvertiseYes = "yes"
let AdvertiseNo = "no"
export let ProxyRefusedMarker = "refused "
export let ProxyAnsweredMarker = "answered "
export let ProxySawMarker = "saw "
export let ProxySwallowedMarker = "swallowed "
export let ProxyInterruptWording = "interrupt"
export let ProxyResumeRequest = "vCont"
export let ProxyDetachRequest = "D\n"
let PathVariableName = "PATH"
let PathEntrySeparator = ":"

let CommandLineToolsStub = "/Library/Developer/CommandLineTools/Library/PrivateFrameworks/LLDB.framework/Versions/A/Resources/debugserver"
let DeveloperDirectoryCommand = "xcode-select"
let DeveloperDirectoryOption = "--print-path"
let DeveloperStubTail = "/../SharedFrameworks/LLDB.framework/Versions/A/Resources/debugserver"

export function stubProxyDirectory(caseLabel String) returns FilePath
	let staged = builtFixture("{caseLabel}-proxy", fixture: StubProxyFixtureName)
	let bytes = try File.readBinary(builtExecutable(staged)) otherwise panic("the gate could not run — the built stub proxy cannot be read.")

	try File.writeBinary(staged.join(DebugServerName), content: bytes, mode: FilePermission.executable) otherwise panic("the gate could not run — the stub proxy cannot be named {DebugServerName} beside its build.")

	return staged
end 'stubProxyDirectory'

export function answeringProxyEnvironment(proxyDirectory FilePath, trace FilePath, after String, answer String) returns Environment
	let overrides = proxyOverrides(proxyDirectory, trace: trace, mode: AnswerMode)
	overrides.upsert(InjectAfterVariable, value: after)
	overrides.upsert(InjectPayloadVariable, value: answer)

	return Environment.inheritUpdating(overrides)
end 'answeringProxyEnvironment'

export function silentProxyEnvironment(proxyDirectory FilePath, trace FilePath, after String) returns Environment
	let overrides = proxyOverrides(proxyDirectory, trace: trace, mode: SilentMode)
	overrides.upsert(InjectAfterVariable, value: after)

	return Environment.inheritUpdating(overrides)
end 'silentProxyEnvironment'

export typealias ProxiedPacketBytes = int(1 to 0xFFFF)

export enum ProxiedAdvertising
	advertised
	unadvertised
end 'ProxiedAdvertising'

export function smallBufferProxyEnvironment(proxyDirectory FilePath, trace FilePath, packetBytes ProxiedPacketBytes, advertising ProxiedAdvertising) returns Environment
	let overrides = proxyOverrides(proxyDirectory, trace: trace, mode: SmallBufferMode)
	overrides.upsert(PacketSizeVariable, value: "{packetBytes}")
	overrides.upsert(AdvertiseVariable, value: AdvertiseYes if advertising == ProxiedAdvertising.advertised else AdvertiseNo)

	return Environment.inheritUpdating(overrides)
end 'smallBufferProxyEnvironment'

export function traceAfterTheInterrupt(traced String) returns String
	return try traced.split("{ProxySawMarker}{ProxyInterruptWording}\n").get(1) otherwise ""
end 'traceAfterTheInterrupt'

export function probeAnsweredProxyEnvironment(proxyDirectory FilePath, trace FilePath, answer String) returns Environment
	let overrides = proxyOverrides(proxyDirectory, trace: trace, mode: ProbeAnswerMode)
	overrides.upsert(InjectPayloadVariable, value: answer)

	return Environment.inheritUpdating(overrides)
end 'probeAnsweredProxyEnvironment'

export function probeSwallowedProxyEnvironment(proxyDirectory FilePath, trace FilePath) returns Environment
	return Environment.inheritUpdating(proxyOverrides(proxyDirectory, trace: trace, mode: ProbeSwallowMode))
end 'probeSwallowedProxyEnvironment'

export function lateHaltProxyEnvironment(proxyDirectory FilePath, trace FilePath) returns Environment
	return Environment.inheritUpdating(proxyOverrides(proxyDirectory, trace: trace, mode: LateHaltMode))
end 'lateHaltProxyEnvironment'

function proxyOverrides(proxyDirectory FilePath, trace FilePath, mode String) returns EnvMap
	let inherited = try Process.environmentVariable(PathVariableName) otherwise ""
	let overrides = EnvMap.create()
	overrides.upsert(PathVariableName, value: "{proxyDirectory.toString()}{PathEntrySeparator}{inherited}")
	overrides.upsert(RealStubVariable, value: realDebugServer().toString())
	overrides.upsert(TraceVariable, value: trace.toString())
	overrides.upsert(ModeVariable, value: mode)

	return overrides
end 'proxyOverrides'

function realDebugServer() returns FilePath
	for candidate in realStubCandidates() 'eachCandidate'
		let path = try FilePath.from(candidate) otherwise continue

		if File.exists(path) 'thisOne'
			return path
		end 'thisOne'
	end 'eachCandidate'

	panic("the gate could not run — this host has no {DebugServerName} to put the stub proxy in front of.")
end 'realDebugServer'

function realStubCandidates() returns StringArray
	let candidates = StringArray.create(2, zeroed: false)
	candidates.push(CommandLineToolsStub)

	let asked = try Subprocess.run(Executable.name(DeveloperDirectoryCommand), arguments: [DeveloperDirectoryOption]) otherwise return candidates
	let developer = asked.stdout.trim()

	if not developer.isEmpty() 'thereIsADeveloperDirectory'
		candidates.push("{developer}{DeveloperStubTail}")
	end 'thereIsADeveloperDirectory'

	return candidates
end 'realStubCandidates'
