let LateStopCaseLabel = "a-stop-the-stub-reports-late-is-held-and-reported-and-not-taken-for-an-answer"

let LateStopAnchorName = "tick-body"
let LateStopFunctionName = "tick"
let LateStopTraceFileName = "proxy-trace.txt"
let LateStopLaneTriple = "arm64-macos"

test 'a stop the stub reports after the debugger gave up waiting for it is held and reported, and is not taken for the answer to the next request'
	#if os(Macos)
		let staged = builtFixture(LateStopCaseLabel, fixture: LiveSpinFixtureName)
		let proxies = stubProxyDirectory(LateStopCaseLabel)
		let trace = staged.join(LateStopTraceFileName)
		let tickLine = anchorLine(staged.join(StagedProgramFileName), anchor: LateStopAnchorName)
		let oneSecondStopTimeout = "{DebugStopTimeoutOptionPrefix}{OneSecond}"
		let commands = debugCommandLine([RunCommand, "{BreakCommand} {lineTarget(tickLine)}", ContinueCommand, QuitCommand])
		let session = boundedDebugBatch(builtExecutable(staged), staged: staged, commands: commands, extraOptions: [oneSecondStopTimeout], environment: lateHaltProxyEnvironment(proxies, trace: trace), timeoutMs: ProxiedSessionBoundMs)
		let events = batchEvents(session.stdoutText())
		let kinds = eventKinds(events)
		let said = renderedEvents(session.stdoutText(), stderr: session.stderrText())

		Expect.isTrue(session.endedInTime(), message: "the session {session.exitText()}. It printed: {listedLines(kinds)}. {said}")
		Expect.isTrue(File.exists(trace), message: "the stub proxy never held the halt that answers the interrupt, so the case measured nothing. It printed: {listedLines(kinds)}. {said}")
		Expect.equal(breakpointAnswersWithAction(events, action: SetAction), expected: 1, message: "the breakpoint armed in the running program must be reported set. It printed: {listedLines(kinds)}. {said}")

		let stops = eventsOfKind(events, kind: StopEventName)
		Expect.atLeast(stops.count(), than: 1, message: "⭐ A STOP THE STUB REPORTS IS THE PROGRAM'S, WHENEVER IT ARRIVES. The stub halted the program for the debugger's interrupt after the debugger had stopped waiting for it, and the report reached the debugger during its next request. That report was taken for the answer to the request, the program sat halted while the debugger believed it ran, and the continue never reached the breakpoint. It printed: {listedLines(kinds)}. {said}")

		let stopped = eventAt(stops, index: 0)
		Expect.equal(textOf(stopped, node: stopped.root, key: FunctionKey), expected: LateStopFunctionName, message: "the stop does not name the function the anchored line is in. {said}")
		Expect.equal(numberOf(stopped, node: stopped.root, key: LineKey), expected: tickLine as EventNumber, message: "the stop is not on the anchored line. {said}")
		Expect.equal(textOf(stopped, node: stopped.root, key: ReasonKey), expected: BreakpointStopReason, message: "the stop must be reported as a `{BreakpointStopReason}`. {said}")

		discardStagedDir(staged)
		discardStagedDir(proxies)
	#else
		Expect.isFalse(hostTargetTriple() == LateStopLaneTriple, message: "only the arm64-macos lane drives a program through a stub it can be put in front of, and runs the case above.")
	#endif
end 'a stop the stub reports after the debugger gave up waiting for it is held and reported, and is not taken for the answer to the next request'
