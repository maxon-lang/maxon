let HandedBackCaseLabel = "a-detached-programs-parent-is-the-session"

let HandedBackRounds = 8
let HandedBackEndDeadlineMs = 60000

test 'the program a session detached from is the session own child again, alive, by the time the debug stub is gone'
	#if os(Macos)
		let staged = builtFixture(HandedBackCaseLabel, fixture: ThreadBurstFixtureName)

		for round in 0 upto HandedBackRounds 'eachRound'
			let detached = DetachedRound.run(staged, environment: Environment.inherit, endWording: ProgramExitedWording, endDeadlineMs: HandedBackEndDeadlineMs)

			Expect.isTrue(detached.place.isALiveChildOf(detached.sessionId), message: "round {round}: ⛔ A STUB THAT IS ENDED BEFORE IT HAS HANDED THE PROGRAM BACK TAKES THE PROGRAM WITH IT, OR LEAVES IT TO A PARENT THAT NEVER WAITS FOR IT. The session ({detached.sessionId}) let go of process {detached.program}, and once the stub was gone {detached.place.displayReason()}. The session said: {detached.said}")
			Expect.isTrue(detached.roundEnd.hasEnded(), message: "round {round}: the released program runs on and the session reports its own end. {detached.roundEnd.displayReason(detached.program)}")
			Expect.isTrue(detached.finished, message: "round {round}: the session ends once it is told to quit. {detached.said} {detached.evidence}")
			Expect.isTrue(detached.markerPresent, message: "round {round}: the released program ran to its own end and wrote {BurstFinishedMarkerName}. The session said: {detached.said}")
		end 'eachRound'

		discardStagedDir(staged)
	#endif
end 'the program a session detached from is the session own child again, alive, by the time the debug stub is gone'
