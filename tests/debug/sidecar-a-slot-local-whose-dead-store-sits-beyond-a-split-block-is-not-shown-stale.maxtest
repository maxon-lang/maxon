let DeadSplitCaseLabel = "sidecar-a-slot-local-whose-dead-store-sits-beyond-a-split-block-is-not-shown-stale"

let DeadSplitLocalName = "limit"
let DeadSplitStaleValue = "8"

test 'a var held in a stack slot whose dead store lies beyond a split block is not read as its older value'
	let staged = builtFixture(DeadSplitCaseLabel, fixture: DeadSplitFixtureName)
	let dump = spawnDumpInfo(builtExecutable(staged), staged: staged, sections: StringArray.create(0))
	let functionRows = dumpSectionRows(withoutCarriageReturns(dump.stdout), heading: DumpFunctionsHeading)
	var slotRows = 0 as Count

	for row in localRowsOf(functionRows, name: MainFunctionName) 'eachLocal'
		slotRows = slotRows + 1 if firstToken(row) == DeadSplitLocalName and row.contains(StackSlotMark) else slotRows
	end 'eachLocal'

	Expect.notEqual(slotRows, expected: 0, message: "`{DeadSplitLocalName}` has no stack-slot row in `{MainFunctionName}`, so this case no longer asks about a SPILLED version. `main`'s locals were: {listedLines(localRowsOf(functionRows, name: MainFunctionName))}")

	let tailAt = anchorLine(staged.join(StagedProgramFileName), anchor: "tail")
	let commands = debugCommandLine(["{BreakCommand} {lineTarget(tailAt)}", RunCommand, "{PrintCommand} {DeadSplitLocalName}"])
	let session = spawnDebugBatch(builtExecutable(staged), staged: staged, commands: commands, extraOptions: StringArray.create(0))
	let events = batchEvents(session.stdout)
	let said = renderedEvents(session.stdout, stderr: session.stderr)
	let answers = eventsOfKind(events, kind: ValueEventName)

	Expect.equal(answers.count(), expected: 1, message: "`{PrintCommand} {DeadSplitLocalName}` printed no `{ValueEventName}` event. It printed: {listedLines(eventKinds(events))}. {said}")

	let answered = eventAt(answers, index: 0)
	let value = memberOf(answered, node: answered.root, key: ValueKey)

	Expect.notEqual(textOf(answered, node: nodeAt(value, index: 0), key: DisplayKey), expected: DeadSplitStaleValue, message: "`{DeadSplitLocalName} = 9` is the last statement that touches the name and nothing reads it after, so the optimiser deleted it, and a range-checked store before it left the live version in a block split off the one the deleted store was parsed in. The older version's slot still holds {DeadSplitStaleValue}, and a row of it that covers the stop answers with that: a previous value wearing the current name. {said}")

	discardStagedDir(staged)
end 'a var held in a stack slot whose dead store lies beyond a split block is not read as its older value'
