let CondUnknownCaseLabel = "cond-unknown-local-refused"

let AnchorName = "hit-body"
let CountedLinePrefix = "hit "
let UnknownLocalName = "nothere"
let ConditionText = "nothere == 1"

test 'a condition naming a local the stop pc has no record for is refused, and the breakpoint is not armed'
	let staged = builtFixture(CondUnknownCaseLabel, fixture: ConditionFixtureName)
	let undebugged = runBuiltProgram(staged)
	let hitLine = anchorLine(staged, anchor: AnchorName)
	let iterations = linesStartingWith(undebugged.stdout, prefix: CountedLinePrefix)

	Expect.equal(stagedLinesContaining(staged, needle: UnknownLocalName) as AssertedInt, expected: 0, message: "this case is about a name the fixture does not declare, and the staged source spells `{UnknownLocalName}`.")
	Expect.atLeast(iterations as AssertedInt, than: 1, message: "the anchored line must run, or an unarmed breakpoint would be indistinguishable from an unreached one. It ran it {iterations} times.")

	let commands = debugCommandLine([conditionalBreak(lineTarget(hitLine), condition: ConditionText), RunCommand])
	let session = spawnDebugBatch(builtExecutable(staged), staged: staged, commands: commands, extraOptions: StringArray.create())
	let events = batchEvents(session.stdout)
	let said = renderedEvents(session.stdout, stderr: session.stderr)

	let armings = eventsOfKind(events, kind: BreakpointEventName)
	Expect.equal(armings.count() as AssertedInt, expected: 1, message: "a refused condition is still an answer and must print one `{BreakpointEventName}` event. It printed: {renderedRows(eventKinds(events))}. {said}")

	let armed = eventAt(armings, index: 0)
	Expect.equal(textOf(armed, node: armed.root, key: ActionKey), expected: ConditionUnsupportedAction, message: "a condition is compiled from the local record covering the breakpoint pc, and there is no record for `{UnknownLocalName}` — so it is refused as `{ConditionUnsupportedAction}` rather than compiled against whatever slot happens to be nearby. {said}")

	Expect.equal(eventsOfKind(events, kind: StopEventName).count() as AssertedInt, expected: 0, message: "a refused condition must leave the breakpoint unarmed; armed anyway it would stop on every one of the {iterations} iterations. {said}")

	let exits = eventsOfKind(events, kind: ExitEventName)
	Expect.equal(exits.count() as AssertedInt, expected: 1, message: "the program did not reach its own end with nothing armed. {said}")

	let exited = eventAt(exits, index: 0)
	Expect.equal(numberOf(exited, node: exited.root, key: CodeKey) as AssertedInt, expected: undebugged.exitCode() as AssertedInt, message: "the program answered a different exit code than the same program run with nothing attached. {said}")
end 'a condition naming a local the stop pc has no record for is refused, and the breakpoint is not armed'
