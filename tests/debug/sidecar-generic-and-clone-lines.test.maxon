let GenericLinesCaseLabel = "sidecar-generic-and-clone-lines"

let TypeDeclarationPrefix = "type "
let TypeParameterClause = " uses "
let CloneFunctionPrefix = "__clone_"
let LineCountColumn = "lines="
let MainFunctionName = "main"
let MethodNameSeparator = "."

test 'a per-type generic body and a synthesized clone carry the line rows a stop inside them needs'
	let staged = builtFixture(GenericLinesCaseLabel, fixture: GenericsFixtureName)
	let dump = spawnDumpInfo(builtExecutable(staged), staged: staged, sections: StringArray.create())

	try Expect.equal(dump.exitCode() as AssertedInt, expected: 0, message: "`{DebugSubcommandName} {DumpInfoOptionName} <exe>` did not print the sidecar. It wrote to stderr: {dump.stderr}")

	let functionRows = declaredFunctionRows(dumpSectionRows(withoutCarriageReturns(dump.stdout), heading: DumpFunctionsHeading))
	let declaredTypes = declaredTypeNamesIn(staged)

	try Expect.notEqual(declaredTypes.count() as AssertedInt, expected: 0, message: "no `{TypeDeclarationPrefix}` declaration was found in the staged fixture, so this case would ask nothing of any body.")

	var owed = StringArray.create()
	var methodBodies = 0
	var cloneBodies = 0

	for row in functionRows 'eachFunction'
		let name = firstToken(row)
		var mine = name == MainFunctionName

		for declared in declaredTypes 'eachDeclaredType'
			let isMethod = name.startsWith("{declared}{MethodNameSeparator}")
			let isClone = name == "{CloneFunctionPrefix}{declared}"
			methodBodies = methodBodies + 1 if isMethod else methodBodies
			cloneBodies = cloneBodies + 1 if isClone else cloneBodies
			mine = true if isMethod or isClone else mine
		end 'eachDeclaredType'

		if mine and columnValueIn(row, column: LineCountColumn) == 0 'noLineRows'
			owed.push(row)
		end 'noLineRows'
	end 'eachFunction'

	try Expect.notEqual(methodBodies as AssertedInt, expected: 0, message: "the sidecar names no method of any type this fixture declares, so nothing here is a statement about a per-type generic body. The functions section held: {renderedRows(functionRows)}")
	try Expect.notEqual(cloneBodies as AssertedInt, expected: 0, message: "the sidecar names no `{CloneFunctionPrefix}<Type>` body, so nothing here is a statement about a synthesized clone. The functions section held: {renderedRows(functionRows)}")
	try Expect.isEmpty(renderedRows(owed), message: "a body with no line rows is a body a stop inside cannot be attributed to a source line — the debugger names the function and then has nothing to say about WHERE. These bodies are the program's own, synthesized ones included, and each of them published none: {renderedRows(owed)}")
end 'a per-type generic body and a synthesized clone carry the line rows a stop inside them needs'

// The types the staged source declares, read out of the source so a fixture that grows a type grows
// what is demanded of the sidecar. A generic declaration carries its parameter clause, which is not
// part of the name a function row spells.
function declaredTypeNamesIn(staged FilePath) returns StringArray
	var names = StringArray.create()

	for line in linesOfStagedSource(staged.join(StagedProgramFileName)) 'eachLine'
		if not line.startsWith(TypeDeclarationPrefix) 'notADeclaration'
			continue
		end 'notADeclaration'

		let spelled = line.replace(TypeDeclarationPrefix, with: "").trim()
		let parameterised = try spelled.findFirst(TypeParameterClause) otherwise 'plainType'
			names.push(spelled)
			continue
		end 'plainType'

		names.push(spelled.slice(spelled.startIndex(), endIndex: parameterised))
	end 'eachLine'

	return names
end 'declaredTypeNamesIn'
