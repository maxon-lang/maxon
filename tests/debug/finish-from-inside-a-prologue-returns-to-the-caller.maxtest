let FinishInPrologueCaseLabel = "finish-from-inside-a-prologue-returns-to-the-caller"
let CalleeFunctionName = "countdown"
let CallerFunctionName = "main"
let PushedFramePointerBytes = 1

test 'a finish from a stop between push rbp and mov rbp, rsp returns to the caller, not the caller of the caller'
	let staged = builtFixture(FinishInPrologueCaseLabel, fixture: RecursionFixtureName)
	let executable = builtExecutable(staged)
	let callLine = anchorLine(staged, anchor: "main-call")
	let afterThePush = exactOffsetTarget(functionCodeStart(executable, staged: staged, name: CalleeFunctionName) + PushedFramePointerBytes)
	let commands = debugCommandLine(["{BreakCommand} {afterThePush}", RunCommand, "{ClearCommand} {afterThePush}", FinishCommand])
	let session = spawnDebugBatch(executable, staged: staged, commands: commands, extraOptions: StringArray.create())
	let events = batchEvents(session.stdout)
	let said = renderedEvents(session.stdout, stderr: session.stderr)
	let stops = eventsOfKind(events, kind: StopEventName)

	try Expect.equal(stops.count() as AssertedInt, expected: 2, message: "the exact-offset breakpoint and the `{FinishCommand}` are two stops. It printed: {renderedRows(eventKinds(events))}. {said}")

	let returned = eventAt(stops, index: 1)
	try Expect.equal(textOf(returned, node: returned.root, key: FunctionKey), expected: CallerFunctionName, message: "⛔ BEFORE `mov rbp, rsp` THE FRAME POINTER IS STILL THE CALLER'S, so a walk that reads its identity from rbp returns past `{CallerFunctionName}` into the runtime that called it. {said}")
	try Expect.equal(numberOf(returned, node: returned.root, key: LineKey) as AssertedInt, expected: callLine as AssertedInt, message: "`{FinishCommand}` stops at the return address, on the call's line. {said}")
	try Expect.equal(textOf(returned, node: returned.root, key: ReasonKey), expected: StepStopReason, message: "the walk's own return is a `{StepStopReason}`. {said}")
end 'a finish from a stop between push rbp and mov rbp, rsp returns to the caller, not the caller of the caller'
