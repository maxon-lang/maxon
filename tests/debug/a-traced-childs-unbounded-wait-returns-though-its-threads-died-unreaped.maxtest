let TracedWaitCaseLabel = "a-traced-childs-unbounded-wait-returns-though-its-threads-died-unreaped"

let TracedWaitUnbounded = 0

let TracedWaitExitCode = 0

test 'an unbounded wait on a traced child whose threads died while their tracer was not waiting sees the child exit'
	#if os(Linux)
		let tracee = startedTracee(TracedWaitCaseLabel)
		let (returnedInTime, code) = traceeWaitOutcome(tracee, timeoutMs: TracedWaitUnbounded)

		Expect.isTrue(returnedInTime, message: "⛔ THE CHILD EXITED AND ITS THREADS DIED TRACED, SO LINUX HELD BACK THE LEADER'S STATUS UNTIL THEIR TRACER REAPED THEM, AND THE CHILD'S POLL SOURCE NEVER BECAME READABLE. A wait with no deadline parks on that source alone, so it never asked again. The wait had not returned after {TraceeWaitDeadlineMs} ms. The child's threads were: {listedLines(tracee.threads)}.")
		Expect.equal(code, expected: TracedWaitExitCode)

		tracee.release()
	#endif
end 'an unbounded wait on a traced child whose threads died while their tracer was not waiting sees the child exit'
