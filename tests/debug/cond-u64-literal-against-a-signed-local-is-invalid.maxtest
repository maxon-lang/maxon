let CondU64SignedCaseLabel = "cond-u64-literal-signed"

let AnchorName = "hit-body"
let CountedLinePrefix = "hit "
let ConditionText = "narrow == 18446744073709551615"
let ConditionInvalidAction = "condition-invalid"

test 'a literal above i64.max against a signed local is an invalid condition, and the breakpoint is not armed'
	let staged = builtFixture(CondU64SignedCaseLabel, fixture: WideConditionFixtureName)
	let undebugged = runBuiltProgram(staged)
	let hitLine = anchorLine(staged, anchor: AnchorName)
	let iterations = linesStartingWith(undebugged.stdout, prefix: CountedLinePrefix)

	Expect.atLeast(iterations, than: 1, message: "the anchored line must run, or an unarmed breakpoint would be indistinguishable from an unreached one. It ran it {iterations} times.")

	let commands = debugCommandLine([conditionalBreak(lineTarget(hitLine), condition: ConditionText), RunCommand])
	let session = spawnDebugBatch(builtExecutable(staged), staged: staged, commands: commands, extraOptions: StringArray.create())
	let events = batchEvents(session.stdout)
	let said = renderedEvents(session.stdout, stderr: session.stderr)

	let armings = eventsOfKind(events, kind: BreakpointEventName)
	Expect.equal(armings.count(), expected: 1, message: "a refused condition is still an answer and must print one `{BreakpointEventName}` event. It printed: {renderedRows(eventKinds(events))}. {said}")

	let armed = eventAt(armings, index: 0)
	Expect.equal(textOf(armed, node: armed.root, key: ActionKey), expected: ConditionInvalidAction, message: "a signed local cannot hold a value above i64.max, so a literal that large is not a number it can be compared with: the condition is invalid rather than read as the negative number sharing its bits. {said}")

	Expect.equal(eventsOfKind(events, kind: StopEventName).count(), expected: 0, message: "an invalid condition must leave the breakpoint unarmed; armed anyway it would stop where the signed local holds -1. {said}")

	let exits = eventsOfKind(events, kind: ExitEventName)
	Expect.equal(exits.count(), expected: 1, message: "the program did not reach its own end with nothing armed. {said}")

	let exited = eventAt(exits, index: 0)
	Expect.equal(numberOf(exited, node: exited.root, key: CodeKey), expected: undebugged.exitCode() as EventNumber, message: "the program answered a different exit code than the same program run with nothing attached. {said}")
end 'a literal above i64.max against a signed local is an invalid condition, and the breakpoint is not armed'
