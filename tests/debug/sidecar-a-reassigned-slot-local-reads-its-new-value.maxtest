let ReassignedSlotCaseLabel = "sidecar-a-reassigned-slot-local-reads-its-new-value"

let ReassignedLocalName = "limit"
let ReassignedLocalNewValue = "105"
let StackSlotLocationMark = "[rbp-"

test 'a var the allocator keeps in a stack slot reads its new value after it is assigned again'
	let staged = builtFixture(ReassignedSlotCaseLabel, fixture: SpilledVarFixtureName)
	let dump = spawnDumpInfo(builtExecutable(staged), staged: staged, sections: StringArray.create())
	let functionRows = dumpSectionRows(withoutCarriageReturns(dump.stdout), heading: DumpFunctionsHeading)
	var slotRows = 0 as Count

	for row in localRowsOf(functionRows, name: MainFunctionName) 'eachLocal'
		slotRows = slotRows + 1 if firstToken(row) == ReassignedLocalName and row.contains(StackSlotLocationMark) else slotRows
	end 'eachLocal'

	Expect.notEqual(slotRows, expected: 0, message: "`{ReassignedLocalName}` has no stack-slot row in `{MainFunctionName}`, so this case no longer asks what it was written to ask: whether an OLD version of a slot-resident var outranks the NEW one. `main`'s locals were: {listedLines(localRowsOf(functionRows, name: MainFunctionName))}")

	let shownAt = anchorLine(staged.join(StagedProgramFileName), anchor: "shown")
	let commands = debugCommandLine(["{BreakCommand} {lineTarget(shownAt)}", RunCommand, "{PrintCommand} {ReassignedLocalName}"])
	let session = spawnDebugBatch(builtExecutable(staged), staged: staged, commands: commands, extraOptions: StringArray.create())
	let events = batchEvents(session.stdout)
	let said = renderedEvents(session.stdout, stderr: session.stderr)
	let answers = eventsOfKind(events, kind: ValueEventName)

	Expect.equal(answers.count(), expected: 1, message: "`{PrintCommand} {ReassignedLocalName}` printed no `{ValueEventName}` event. It printed: {listedLines(eventKinds(events))}. {said}")

	let answered = eventAt(answers, index: 0)
	let value = memberOf(answered, node: answered.root, key: ValueKey)

	Expect.equal(textOf(answered, node: nodeAt(value, index: 0), key: DisplayKey), expected: ReassignedLocalNewValue, message: "`{ReassignedLocalName}` was 5 when its loop ended and is 105 after the assignment the stop sits behind. A row of the older, slot-resident version that outranks the newer one answers 5: the previous value, wearing the current name. {said}")
end 'a var the allocator keeps in a stack slot reads its new value after it is assigned again'
