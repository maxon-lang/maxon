let HeaplessAttachCaseLabel = "heapless-program-attaches"

test 'a program that allocates nothing still attaches, stops and resumes'
	let staged = builtFixture(HeaplessAttachCaseLabel, fixture: HeaplessFixtureName)
	let hotLine = anchorLine(staged, anchor: "hot")
	let commands = debugCommandLine(["{BreakCommand} {lineTarget(hotLine)}", RunCommand, ContinueCommand])
	let session = spawnDebugBatch(builtExecutable(staged), staged: staged, commands: commands, extraOptions: StringArray.create())
	let events = batchEvents(session.stdout)
	let said = renderedEvents(session.stdout, stderr: session.stderr)
	let breakpoints = eventsOfKind(events, kind: BreakpointEventName)
	let stops = eventsOfKind(events, kind: StopEventName)

	Expect.equal(breakpoints.count(), expected: 1, message: "`{BreakCommand} {lineTarget(hotLine)}` printed no `{BreakpointEventName}` event. It printed: {renderedRows(eventKinds(events))}. {said}")

	let armed = eventAt(breakpoints, index: 0)
	Expect.equal(textOf(armed, node: armed.root, key: ActionKey), expected: SetAction, message: "the breakpoint on the anchored line was not `{SetAction}`. {said}")
	Expect.atLeast(stops.count(), than: 1, message: "a program with no heap at all never stopped. A `{StopEventName}` here is what says the planted byte, the stop and the sidecar read all work on a program that never allocates. {said}")

	let stopped = eventAt(stops, index: 0)
	Expect.equal(numberOf(stopped, node: stopped.root, key: LineKey), expected: hotLine as EventNumber, message: "the stop is not on the anchored line. {said}")
	Expect.equal(textOf(stopped, node: stopped.root, key: ReasonKey), expected: BreakpointStopReason, message: "the stop does not name a breakpoint as its reason. {said}")
end 'a program that allocates nothing still attaches, stops and resumes'
