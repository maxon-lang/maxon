let OwnRingCaseLabel = "monitor-own-ring"
let OwnRingFixtureName = "ownring"
let OwnRingBuildLabel = "debugstream"

let OwnRingDebugStreamOption = "--debugstream"
let OwnRingMonitorSubcommand = "monitor"

let ParentAttachedLine = "parent attached=true"
let ChildDetachedLine = "child attached=false"

test 'a process a monitored debug stream program starts is not attached to the ring the program writes'
	let staged = stagedFixtureTree(FixturesDirName, stagingRootDir: StagingRootDirName, caseLabel: OwnRingCaseLabel, fixture: OwnRingFixtureName)

	let build = spawnBuild(staged.join(StagedProgramFileName), staged: staged, output: staged.join(OutputFileStem), label: OwnRingBuildLabel, extraArguments: [OwnRingDebugStreamOption])

	if build.exitCode() != 0 'buildFailed'
		panic("a-process-a-debug-stream-program-starts-does-not-attach-to-its-ring: the gate could not run — the `{OwnRingDebugStreamOption}` build failed with exit {build.exitCode()}: {build.stdout}{build.stderr}")
	end 'buildFailed'

	let monitored = spawnCompiler([OwnRingMonitorSubcommand, builtExecutable(staged).toString()], staged: staged, what: "`{OwnRingMonitorSubcommand}`")
	let stdout = withoutCarriageReturns(monitored.stdout)
	let said = "It wrote to stdout: {stdout} and to stderr: {withoutCarriageReturns(monitored.stderr)}"

	Expect.equal(monitored.exitCode(), expected: 0, message: "the monitored program did not exit 0. {said}")
	Expect.contains(stdout, needle: ParentAttachedLine, message: "the monitored program was not attached to the ring, so the gate says nothing about its child. {said}")
	Expect.contains(stdout, needle: ChildDetachedLine, message: "a process the monitored program started attached to the ring the program writes: two processes would then write one ring under two locks, and the monitor would decode entries neither wrote whole. {said}")
end 'a process a monitored debug stream program starts is not attached to the ring the program writes'
