let SidecarTablesCaseLabel = "a-sidecar-names-the-globals-and-layout-tables"

let GreenThreadStackPointerField = "GtOffSp"
let GreenThreadFramePointerField = "GtOffFp"
let GreenThreadStatusField = "GtOffStatus"
let GreenThreadStackGuardField = "GtOffStackGuard"
let GreenThreadPreemptRequestValue = "GtStackGuardPreempt"

test 'the sidecar of a build carrying the machinery names the globals a debugger reads and the record offsets it reads them by'
	let staged = builtFixture(SidecarTablesCaseLabel, fixture: WorkersFixtureName, extraArguments: [DebugStreamBuildOption])
	let dump = spawnDumpInfo(builtExecutable(staged), staged: staged, sections: StringArray.create())

	if dump.exitCode() != 0 'noSidecar'
		panic("{SidecarTablesCaseLabel}: the gate could not run — `{DebugSubcommandName} {DumpInfoOptionName} <exe>` exited {dump.exitCode()}, so there are no tables to read. It wrote to stderr: {dump.stderr}")
	end 'noSidecar'

	let printed = withoutCarriageReturns(dump.stdout)
	let globals = dumpSectionRows(printed, heading: DumpGlobalsSectionHeading)

	Expect.notEqual(globals.count(), expected: 0, message: "⭐⭐ NOTHING IN A BUILT IMAGE NAMES A DATA SYMBOL, SO THE SIDECAR MUST. There is no `{DumpGlobalsSectionHeading}…)` section at all: the object writers publish functions only, so a debugger handed this binary can find the code but not the scheduler's own state, and every reading it takes of a green thread would be taken at a guessed address. The dump printed: {printed}")
	Expect.isEmpty(renderedRows(sidecarTableNames(globals, names: [RosterGlobalName, RosterLengthGlobalName, DebugStreamGlobalName], published: false)), message: "the `{DumpGlobalsSectionHeading}…)` section names none of these. This fixture spawns green threads and is built with `{DebugStreamBuildOption}`, so its image holds every one of these words: `{RosterGlobalName}` and `{RosterLengthGlobalName}` are the whole roster of green threads a debugger can enumerate, and `{DebugStreamGlobalName}` is where a trace slice is read from — a table that omits one of them makes that answer unavailable rather than wrong. The section held: {renderedRows(globals)}")

	let layout = dumpSectionRows(printed, heading: DumpLayoutSectionHeading)

	Expect.notEqual(layout.count(), expected: 0, message: "⭐⭐ AN ADDRESS WITHOUT A LAYOUT IS AN OFFSET INTO NOTHING. There is no `{DumpLayoutSectionHeading}…)` section: the debugger knows where the green-thread records are and not what a field of one means, and a field moved by a later change would be read as its neighbour with nothing failing. The dump printed: {printed}")
	Expect.isEmpty(renderedRows(sidecarTableNames(layout, names: [GreenThreadStackPointerField, GreenThreadFramePointerField, GreenThreadStatusField, GreenThreadStackGuardField, GreenThreadPreemptRequestValue], published: false)), message: "the `{DumpLayoutSectionHeading}…)` section names none of these. A parked green thread's whole saved context is its stack pointer and its frame pointer, its status says whether it may be walked at all, and the guard word doubles as the preemption request — so these are exactly the figures an out-of-process walk cannot do without. The section held: {renderedRows(layout)}")
end 'the sidecar of a build carrying the machinery names the globals a debugger reads and the record offsets it reads them by'
