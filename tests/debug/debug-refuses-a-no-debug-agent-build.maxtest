let NoAgentCaseLabel = "debug-refuses-a-no-debug-agent-build"

let NoAgentWord = "agent"
let NoAgentSessionExitCode = 1

test 'a program built without the agent reports that nothing attached, by name'
	let staged = builtFixture(NoAgentCaseLabel, fixture: HeaplessFixtureName, extraArguments: [NoDebugAgentOption])
	let session = spawnDebugBatch(builtExecutable(staged), staged: staged, commands: RunCommand, extraOptions: StringArray.create())
	let said = renderedEvents(session.stdout, stderr: session.stderr)

	Expect.equal(session.exitCode() as AssertedInt, expected: NoAgentSessionExitCode, message: "`{NoDebugAgentOption}` is the one opt-out, so a session over a binary built with it cannot succeed. {said}")
	Expect.contains("{session.stdout}{session.stderr}", needle: NoAgentWord, message: "the session does not say that no agent attached, so a reader is left to guess why nothing stopped. {said}")
	Expect.equal(eventsOfKind(batchEvents(session.stdout), kind: StopEventName).count() as AssertedInt, expected: 0, message: "a binary with no agent in it reported a stop. {said}")
end 'a program built without the agent reports that nothing attached, by name'
