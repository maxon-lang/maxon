let ThreadBurstFixtureName = "threadburst"
let BurstSpinAnchorName = "spin-body"
let BurstFinishedMarkerName = "burst-ran-to-its-end.txt"
let BurstPidFileName = "burst-pid.txt"

#if os(Windows)
	let KillExecutableName = "taskkill"
	let KillForceFlag = "/F"
	let KillProcessFlag = "/PID"
#endif

function burstProcessId(staged FilePath) returns Pid
	let text = try File.readText(staged.join(BurstPidFileName)) otherwise panic("the gate could not run — the thread-burst program recorded no process id in {BurstPidFileName}")
	let id = try int.fromString(text.trim()) otherwise panic("the gate could not run — {BurstPidFileName} holds `{text}`, not a process id")

	return id as Pid
end 'burstProcessId'

function killedOutright(process Pid)
	#if os(Windows)
		let killer = Executable.name(KillExecutableName)
		let killerArguments = [KillForceFlag, KillProcessFlag, "{process}"]
	#else
		let killer = posixShell()
		let killerArguments = [PosixShellCommandFlag, "kill -9 {process}"]
	#endif

	let ran = try Subprocess.run(killer, arguments: killerArguments) otherwise (e) 'noKill'
		panic("the gate could not run — killing process {process} failed ({e.displayReason()}).")
	end 'noKill'

	if not ran.succeeded() 'refused'
		panic("the gate could not run — killing process {process} exited {ran.exitCode()}: {ran.stderr}")
	end 'refused'
end 'killedOutright'
