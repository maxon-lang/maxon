export let ThreadBurstFixtureName = "threadburst"
export let BurstSpinAnchorName = "spin-body"
export let BurstFinishedMarkerName = "burst-ran-to-its-end.txt"
let BurstPidFileName = "burst-pid.txt"
let KillShell = "sh"

export function burstProcessId(staged FilePath) returns Pid
	let text = try File.readText(staged.join(BurstPidFileName)) otherwise panic("the gate could not run — the thread-burst program recorded no process id in {BurstPidFileName}")
	let id = try int.fromString(text.trim()) otherwise panic("the gate could not run — {BurstPidFileName} holds `{text}`, not a process id")

	return id as Pid
end 'burstProcessId'

export function killedOutright(process Pid)
	let ran = try Subprocess.run(Executable.name(KillShell), arguments: ["-c", "kill -9 {process}"]) otherwise (e) 'noKill'
		panic("the gate could not run — killing process {process} failed ({e.displayReason()}).")
	end 'noKill'

	if not ran.succeeded() 'refused'
		panic("the gate could not run — `kill -9 {process}` exited {ran.exitCode()}: {ran.stderr}")
	end 'refused'
end 'killedOutright'
