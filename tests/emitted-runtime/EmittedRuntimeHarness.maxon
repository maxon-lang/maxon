let TestedCompilerStem = "maxon-bin/.maxon/maxon"

let FixturesDirName = "tests/emitted-runtime/fixtures"
let SpawnFixtureName = "spawn"
let StagingRootDirName = "temp/emitted-runtime"
let StoredFixtureSuffix = ".fixture"
let StagedProgramFileName = "main.maxon"
let PathSeparator = "/"

let BuildCommandName = "build"
let OutputOptionPrefix = "--output="
let TargetOptionPrefix = "--target="
let EmitIrRuntimeOptionPrefix = "--emit-ir-runtime="
let OutputStem = "out"
let IrFileSuffix = ".ir"

export let MacosTargetName = "arm64-macos"
export let LinuxTargetName = "arm64-linux"

let FunctionHeaderPrefix = "func @"
let FunctionHeaderSuffix = " \{"
let FunctionBodyEndLine = "\}"

let PlainLoadPrefix = "arm64.loadRegBaseDisp.word64 "
export let AcquireLoadMnemonic = "arm64.ldar.word64"
export let RegisterMovePrefix = "arm64.movRegReg "
export let ArgumentSeparator = ", "
export let NoFurtherDemand = ""
let WordSeparator = " "
let OperandSeparator = ","
let LineSeparator = "\n"
let DestinationWordIndex = 1

export typealias FieldOffset = int(0 to 65535)
export typealias LineIndex = int(0 to u64.max)
typealias LineTally = int(0 to u64.max)
typealias PathArray = Array with FilePath

export enum IrScanError implements Error
	noSuchLine
	noDestinationRegister
end 'IrScanError'

export function stagedProgram(caseLabel String) returns FilePath
	let staged = stagingDir("{StagingRootDirName}{PathSeparator}{caseLabel}")
	clearStagedFiles(staged)

	let stored = fixtureDir("{FixturesDirName}{PathSeparator}{SpawnFixtureName}").join("{StagedProgramFileName}{StoredFixtureSuffix}")
	let body = try File.readText(stored) otherwise panic("emitted-runtime tests: the gate could not run — could not read the stored fixture {stored.toString()}.")
	try File.writeText(staged.join(StagedProgramFileName), content: body) otherwise panic("emitted-runtime tests: the gate could not run — could not stage {StagedProgramFileName} into {staged.toString()}.")

	return staged
end 'stagedProgram'

export function buildStagedProgram(staged FilePath, target String, functionName String) returns FilePath
	let executable = staged.join("{OutputStem}-{functionName}-{target}")
	let ir = staged.join("{OutputStem}-{functionName}-{target}{IrFileSuffix}")

	var arguments = StringArray.create()
	arguments.push(BuildCommandName)
	arguments.push(staged.join(StagedProgramFileName).toString())
	arguments.push("{OutputOptionPrefix}{executable.toString()}")
	arguments.push("{TargetOptionPrefix}{target}")
	arguments.push("{EmitIrRuntimeOptionPrefix}{functionName}")

	let build = spawnCompiler(arguments, staged: staged)

	if build.exitCode() != 0 'buildFailed'
		panic("emitted-runtime tests: the gate could not run — `{BuildCommandName} … {TargetOptionPrefix}{target} {EmitIrRuntimeOptionPrefix}{functionName}` exited {build.exitCode()}, so no Target IR was written to read. It wrote to stderr: {build.stderr}")
	end 'buildFailed'

	if not File.exists(ir) 'nothingWritten'
		panic("emitted-runtime tests: the gate could not run — `{BuildCommandName} … {EmitIrRuntimeOptionPrefix}{functionName}` exited 0 and wrote no Target IR to {ir.toString()}.")
	end 'nothingWritten'

	return ir
end 'buildStagedProgram'

export function irLines(path FilePath) returns StringArray
	let text = try File.readText(path) otherwise panic("emitted-runtime tests: the gate could not run — could not read the Target IR the compiler wrote to {path.toString()}.")

	return text.split(LineSeparator)
end 'irLines'

export function functionBody(lines StringArray, functionName String, target String) returns StringArray
	let header = "{FunctionHeaderPrefix}{functionName}{FunctionHeaderSuffix}"
	var body = StringArray.create()
	var found = false

	for line in lines 'eachLine'
		let text = line.trim()

		if not found 'beforeTheFunction'
			found = text == header
			continue
		end 'beforeTheFunction'

		if text == FunctionBodyEndLine 'theEnd'
			break
		end 'theEnd'

		body.push(text)
	end 'eachLine'

	if not found 'neverRendered'
		panic("emitted-runtime tests: the gate could not run — the {target} Target IR holds no `{header}`, so that runtime body was never rendered. `{EmitIrRuntimeOptionPrefix}{functionName}` is what opts a withheld runtime body into that text, and a name nothing emits is refused rather than skipped.")
	end 'neverRendered'

	if body.isEmpty() 'renderedEmpty'
		panic("emitted-runtime tests: the gate could not run — the {target} Target IR renders `{functionName}` with an EMPTY body, and an empty body satisfies every absence demand a case makes by holding nothing at all.")
	end 'renderedEmpty'

	return body
end 'functionBody'

export function bodyLineCount(body StringArray, startingWith String, containing String, endingWith String) returns LineTally
	var found = 0 as LineTally

	for text in body 'eachLine'
		if lineMatches(text, startingWith: startingWith, containing: containing, endingWith: endingWith) 'theLine'
			found = found + 1
		end 'theLine'
	end 'eachLine'

	return found
end 'bodyLineCount'

export function firstLineIndex(body StringArray, startingWith String, containing String, endingWith String) returns LineIndex throws IrScanError
	for (iter, text) in body.withIterator() 'eachLine'
		if lineMatches(text, startingWith: startingWith, containing: containing, endingWith: endingWith) 'theLine'
			return iter.index()
		end 'theLine'
	end 'eachLine'

	throw IrScanError.noSuchLine
end 'firstLineIndex'

// The first line whose destination operand is `register`, read off the line itself rather than off a roster
// of the ops that write. A line that merely carries the register there — a compare — reads as a write, and
// that is the direction that costs a caller a refusal rather than a pass it did not earn.
export function firstWriteOfRegister(body StringArray, register String) returns LineIndex throws IrScanError
	for (iter, text) in body.withIterator() 'eachLine'
		let written = try destinationRegisterOf(text) otherwise continue

		if written == register 'theWrite'
			return iter.index()
		end 'theWrite'
	end 'eachLine'

	throw IrScanError.noSuchLine
end 'firstWriteOfRegister'

export function registerHoldingArgument(body StringArray, argument String) returns String throws IrScanError
	let moveSuffix = "{ArgumentSeparator}{argument}"
	let index = try firstLineIndex(body, startingWith: RegisterMovePrefix, containing: NoFurtherDemand, endingWith: moveSuffix)

	return try destinationRegisterOf(lineAt(body, index: index))
end 'registerHoldingArgument'

export function notePlainFieldLoad(findings StringArray, body StringArray, target String, register String, offset FieldOffset, functionName String, field String)
	let addressed = "[{register} + {offset}]"
	let index = try firstLineIndex(body, startingWith: PlainLoadPrefix, containing: addressed, endingWith: NoFurtherDemand) otherwise return

	findings.push("on {target}, `{functionName}` still reads {field} with a plain load — `{lineAt(body, index: index)}`")
end 'notePlainFieldLoad'

export function renderedFindings(findings StringArray) returns String
	var rendered = ""

	for finding in findings 'eachFinding'
		rendered.append("\n  • {finding}")
	end 'eachFinding'

	return rendered
end 'renderedFindings'

function lineMatches(text String, startingWith String, containing String, endingWith String) returns bool
	if not text.startsWith(startingWith) 'anotherOp'
		return false
	end 'anotherOp'

	if not containing.isEmpty() and not text.contains(containing) 'anotherOperand'
		return false
	end 'anotherOperand'

	return endingWith.isEmpty() or text.endsWith(endingWith)
end 'lineMatches'

function lineAt(body StringArray, index LineIndex) returns String
	return try body.get(index) otherwise panic("emitted-runtime tests: the gate could not run — line {index} was read out of a body of {body.count()} lines that a scan of that same body had just found it in.")
end 'lineAt'

function destinationRegisterOf(text String) returns String throws IrScanError
	let spelled = try text.split(WordSeparator).get(DestinationWordIndex) otherwise throw IrScanError.noDestinationRegister

	return try spelled.split(OperandSeparator).get(0) otherwise throw IrScanError.noDestinationRegister
end 'destinationRegisterOf'

function spawnCompiler(arguments StringArray, staged FilePath) returns CollectedOutput
	let binary = testedCompilerPath()

	if not File.exists(binary) 'noBinary'
		panic("emitted-runtime tests: the gate could not run — this case needs a compiler at {binary.toString()} and there is none. This corpus's paths are relative to the CHECKOUT ROOT, the working directory a test binary inherits from `maxon test`; run it from there, and build `{TestedCompilerStem}` first.")
	end 'noBinary'

	var config = Configuration.create(Executable.path(binary))
	config.arguments = arguments
	config.workingDirectory = staged

	return try config.run() otherwise (e) 'spawnFailed'
		panic("emitted-runtime tests: the gate could not run — could not spawn the `{BuildCommandName}` of the staged program ({e.displayReason()}).")
	end 'spawnFailed'
end 'spawnCompiler'

function testedCompilerPath() returns FilePath
	#if os(Windows)
		let spelled = "{TestedCompilerStem}.exe"
	#else
		let spelled = "{TestedCompilerStem}"
	#endif

	let relative = try FilePath.from(spelled) otherwise panic("emitted-runtime tests: the gate could not run — '{spelled}' is not a spellable path")

	return relative.resolve(Directory.currentPath())
end 'testedCompilerPath'

function clearStagedFiles(dir FilePath)
	for entry in listing(dir) 'eachEntry'
		if Directory.isDirectory(entry) 'aDirectory'
			clearStagedFiles(entry)
			continue
		end 'aDirectory'

		try File.delete(entry) otherwise panic("emitted-runtime tests: the gate could not run — could not clear {entry.toString()} from a previous run's staging tree.")
	end 'eachEntry'
end 'clearStagedFiles'

function fixtureDir(spelled String) returns FilePath
	let path = try FilePath.from(spelled) otherwise panic("emitted-runtime tests: the gate could not run — '{spelled}' is not a spellable path")

	if not Directory.isDirectory(path) 'notThere'
		panic("emitted-runtime tests: the gate could not run — there is no directory at '{spelled}'. Every path in this corpus is relative to the CHECKOUT ROOT, which is the working directory a test binary inherits from `maxon test`; a run started anywhere else finds nothing.")
	end 'notThere'

	return path
end 'fixtureDir'

function stagingDir(spelled String) returns FilePath
	var prefix = ""

	for component in spelled.split(PathSeparator) 'eachComponent'
		prefix = component if prefix.isEmpty() else "{prefix}{PathSeparator}{component}"
		let ancestor = try FilePath.from(prefix) otherwise panic("emitted-runtime tests: the gate could not run — '{prefix}' is not a spellable path")

		if not Directory.create(ancestor) 'couldNotCreate'
			panic("emitted-runtime tests: the gate could not run — could not create '{prefix}'. It is where the case's runnable copy is built; nothing can be staged without it.")
		end 'couldNotCreate'
	end 'eachComponent'

	let path = try FilePath.from(spelled) otherwise panic("emitted-runtime tests: the gate could not run — '{spelled}' is not a spellable path")

	return path.resolve(Directory.currentPath())
end 'stagingDir'

function listing(dir FilePath) returns PathArray
	return try Directory.list(dir) otherwise panic("emitted-runtime tests: the gate could not run — could not list {dir.toString()}")
end 'listing'
