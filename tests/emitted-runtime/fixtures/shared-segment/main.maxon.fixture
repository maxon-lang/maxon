function main() returns ExitCode
	var segment = try SharedSegment.create("maxon-emitted-runtime-shm", bytes: 4096) otherwise return 3
	try segment.writeWord(0, value: 1234567) otherwise return 4
	let stored = try segment.readWord(0) otherwise return 5
	segment.close()
	print("stored={stored}")
	return 0 as ExitCode
end 'main'
