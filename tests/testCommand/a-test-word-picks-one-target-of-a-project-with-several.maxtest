let PickedTargetCase = "a-test-word-picks-one-target-of-a-project-with-several"
let PickedTargetWord = "beta"
let PickedTargetTestName = "the chosen target is compiled"

test 'a test word picks one target of a project with several'
	let project = stagedCaseProject(PickedTargetCase)
	let run = runTestCommandOnTarget(PickedTargetWord, subject: project, caseName: PickedTargetCase)
	expectRanOnePassingTest(run, testName: PickedTargetTestName, caseName: PickedTargetCase)
end 'a test word picks one target of a project with several'
