let MissingCase = "test-file-missing-refused"
let MissingReason = "no such directory or `.maxtest` file: "

test 'test-file-missing-refused refuses a test file that does not exist'
	let run = runFixture(MissingCase)
	try Expect.contains(run.stderr, needle: "{MissingReason}", message: "a path naming nothing is refused by name. It said: {run.stderr}")
	try Expect.contains(run.stderr, needle: "{MissingCase}/absent.maxtest", message: "a path naming nothing is refused by name. It said: {run.stderr}")
	try checkFixtureRun(run, caseName: MissingCase)
end 'test-file-missing-refused refuses a test file that does not exist'
