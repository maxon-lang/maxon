let OutrankingCase = "a-lone-test-word-naming-a-target-outranks-a-directory-of-that-name"
let OutrankingWord = "checks"
let OutrankingTestName = "the target is compiled, not the directory of its name"

test 'a lone test word naming a target outranks a directory of that name'
	let project = stagedCaseProject(OutrankingCase)
	let run = runTestCommandWordIn(project, word: OutrankingWord, caseName: OutrankingCase)
	expectRanOnePassingTest(run, testName: OutrankingTestName, caseName: OutrankingCase)
end 'a lone test word naming a target outranks a directory of that name'
