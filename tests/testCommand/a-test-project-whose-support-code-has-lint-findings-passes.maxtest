let LintFindingsCase = "a-test-project-whose-support-code-has-lint-findings-passes"
let LintFindingsTestName = "the support answer is reached past its lint findings"

test 'a test project whose support code has only lint findings runs its test and passes'
	let project = stagedCaseProject(LintFindingsCase)
	let run = runTestCommandOn(project, caseName: LintFindingsCase)
	discardStagedDir(caseRootOf(project))
	expectRanOnePassingTest(run, testName: LintFindingsTestName, caseName: LintFindingsCase)
end 'a test project whose support code has only lint findings runs its test and passes'
