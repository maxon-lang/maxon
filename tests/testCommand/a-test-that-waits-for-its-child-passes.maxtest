let WaitsCase = "a-test-that-waits-for-its-child-passes"

test 'a test that waits for the processes it starts passes'
	let run = runFixture(WaitsCase)
	let report = withoutCarriageReturns("{run.stdout}{run.stderr}")

	Expect.equal(run.exitCode(), expected: 0, message: "both tests wait for the processes they start, so the run exits 0. It printed: {report}")
	Expect.contains(report, needle: " 2 pass\n 0 fail\n", message: "both tests pass. It printed: {report}")
end 'a test that waits for the processes it starts passes'
