let ListedSourcesCase = "a-test-project-compiles-the-sources-its-project-lists"
let SharedAnswerTestName = "the shared answer is reached"

test 'a test project compiles the sources its project lists'
	let project = stagedCaseProject(ListedSourcesCase)
	let run = runTestCommandOn(project, caseName: ListedSourcesCase)
	expectRanOnePassingTest(run, testName: SharedAnswerTestName, caseName: ListedSourcesCase)
end 'a test project compiles the sources its project lists'
