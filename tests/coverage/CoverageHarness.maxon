// CoverageHarness.maxon — the shared half every case under `tests/coverage/` reaches for: the compiler it
// spawns, staging a fixture, building it instrumented, running the tool at it, and reading back the report.
//
// `maxon coverage <run|report> <exe>` joins three artifacts produced at three different moments — the
// binary's own `.text` hash, the `.mxdbg` sidecar's coverage-point table, and the `.mxcov` counters the
// program wrote on its way out. Counters are anonymous indices and a point table is a stride, so a writer
// and a reader that disagree about either attribute real numbers to the wrong lines.
//
// ⭐⭐ **THE RUNNER AND THE SUBJECT ARE THE SAME BINARY, AND NOTHING OUTSIDE CLOSES THAT.** `maxon test
// tests/coverage` both runs these cases and provides the compiler they spawn — named by
// `TestedCompilerStem` and by nothing else — so a runner broken badly enough to report green having run
// nothing cannot detect itself. READ THE PASS COUNT.
//
// ⛔ **EVERY FREE FUNCTION IN A DIRECTORY SHARES ONE NAMESPACE, whatever its visibility** (E3006). So the
// corpus gets ONE shared half, exported from this file, and a case file beside it declares only what that
// case alone uses. A file-private `let` does NOT collide, so a constant declared twice is the half nothing
// catches: every constant this corpus shares is declared here.
//
// ⛔ **EVERYTHING THAT WOULD STOP A CASE RUNNING AT ALL PANICS RATHER THAN FAILING AN ASSERTION**: a
// missing compiler, an unspellable path, a spawn that never happened. A BUILD that exits non-zero is not
// in that class — `--coverage` is part of the surface under test — so it is asserted.
//
// ⛔ **THIS FILE'S PATHS ARE RELATIVE TO THE CHECKOUT ROOT**, which is the working directory a test
// binary inherits from `maxon test`. Everything handed to a child is made absolute first, because a
// relative path resolves against the child's directory on POSIX and the parent's on Windows.
//
// ⛔ **ONE SPAWNING `test` PER FILE, AND EVERY CASE STAGES INTO A DIRECTORY NAMED FOR ITSELF**, because
// `maxon test` runs files concurrently and two cases sharing a staging tree would race over one output
// path. A case that needs two programs takes two staging labels, never two names in one tree.

// Where the corpus lives and where runnable copies are built, both relative to the checkout root.
// Staging goes to gitignored `temp/`: a live `.maxon` under `tests/` is one `maxon fmt` over the
// checkout rewrites.
let FixturesDirName = "tests/coverage/fixtures"
let StagingRootDirName = "temp/coverage"

// The stored-name mapping, `tests/README.md` rule 1: `<name>.fixture -> <name>`.
let StoredFixtureSuffix = ".fixture"
let StagedProgramFileName = "main.maxon"

// The program this corpus stages: it carries every line state and both branch shapes.
export let StatesFixtureName = "states"

// The binary this directory spawns, relative to the checkout root and without its host suffix. It builds
// every binary this corpus measures and it is also the coverage tool under test. ONE constant, so the
// SUBJECT axis cannot move when the RUNNER does.
let TestedCompilerStem = "maxon-bin/.maxon/maxon"

// The driver surface under test, spelled as the command line takes it.
export let BuildCommandName = "build"
let CoverageCommandName = "coverage"
let RunVerbName = "run"
export let CoverageBuildFlag = "--coverage"
let OutputOption = "-o"

// The counter file an instrumented binary writes on its way out, named for the binary with its extension
// still on: `out.exe` -> `out.exe.mxcov`.
let CoverageDataSuffix = ".mxcov"

// What an instrumented binary is built as. One spelling, because every case that measures one builds it
// under this name and a second spelling would be a name two cases could come to disagree about.
export let CoveredOutputStem = "covered"

// The summary line every tally is read off, and the separator that splits a tally in two. Everything else
// about the report's shape belongs to the one case that reads it.
export let LinesSummaryKey = "lines: "
let RatioSeparator = "/"

// How the fixtures mark the lines a case asks about. The anchor is a comment, so it reaches neither the
// emitted code nor the line table — it exists so a case can name a LINE without writing a NUMBER that
// goes stale the moment the fixture grows a line.
export let AnchorPrefix = "// anchor: "

// The two markers that stand where a count would be, homed here because more than one case reads each.
// They are the report's vocabulary for the states a NUMBER cannot express, and the difference between
// them is the whole reason the fourth state exists: `#####` blames the RUN for not reaching code that is
// there to reach, `-----` says the optimizer emitted none, so there is nothing a test could ever cover.
export let NotCoveredMarker = "#####"
export let EliminatedMarker = "-----"

// The folds every reader in this directory applies to a captured stream: CR dropped, so a Windows
// console's line endings do not decide what a row says or where one ends; tabs folded to spaces, so a
// column written with either separates two words.
export let LineFeed = "\n"
let CarriageReturn = "\r"
let Space = " "
let Tab = "\t"

// The separator this corpus's own paths are spelled with, folded into the host's by `stagingDir`.
let PathSeparator = "/"

// The digits a report prints its numbers in.
let DecimalBase = 10
let AsciiDigitZero = 48

// A line of a staged fixture, found by anchor.
export typealias FixtureLineNumber = int(0 to u64.max)

// A number a report printed — an execution count, a tally, a ratio's half.
export typealias CoverageTally = int(0 to u64.max)

// A list of paths one directory walk produced. Stdlib's own `FilePathArray` is a member of `Directory`
// and has no file-scope spelling.
typealias PathArray = Array with FilePath

// ============================================================================================
// STAGING AND SPAWNING
// ============================================================================================

// A runnable copy of one fixture program under a directory named for the CASE, so concurrent case files
// never share a staging tree. Absolute, because it is handed to a child as its working directory. The
// previous run's files go first: a stale executable, sidecar or data file would let a step that produced
// none be read as though it had.
//
// The FIXTURE is a required parameter and the CASE LABEL is not the fixture's name: two cases staging the
// same program still need two trees, and one case needs two trees when it stages two programs.
export function stagedProgram(caseLabel String, fixture String) returns FilePath
	let staged = stagingDir("{StagingRootDirName}{PathSeparator}{caseLabel}")
	clearStagedFiles(staged)

	let stored = fixtureDir("{FixturesDirName}{PathSeparator}{fixture}").join("{StagedProgramFileName}{StoredFixtureSuffix}")
	let body = try File.readText(stored) otherwise panic("coverage tests: the gate could not run — could not read the stored fixture {stored.toString()}.")
	try File.writeText(staged.join("{StagedProgramFileName}"), content: body) otherwise panic("coverage tests: the gate could not run — could not stage {StagedProgramFileName} into {staged.toString()}.")

	return staged
end 'stagedProgram'

// Where one build's executable lands. A STEM is taken rather than fixed, because a case that needs two
// binaries in one tree needs two names — and the case that compares IMAGES passes one stem twice on
// purpose, since an output basename can reach the emitted image.
export function builtExecutable(staged FilePath, stem String) returns FilePath
	return staged.join("{stem}{executableSuffix()}")
end 'builtExecutable'

// The counter file a binary writes on exit: the WHOLE output name plus the suffix, which is how both the
// emitted runtime and every reader derive it.
export function coverageDataPath(executable FilePath) returns FilePath
	let spelled = "{executable.toString()}{CoverageDataSuffix}"

	return try FilePath.from(spelled) otherwise panic("coverage tests: the gate could not run — '{spelled}' is not a spellable path")
end 'coverageDataPath'

// Compile the staged program to a named output. `-o` is what keeps a build out of the tree lock, so
// concurrent case files can compile at once.
function spawnBuild(staged FilePath, output FilePath, extraArguments StringArray) returns CollectedOutput
	var arguments = StringArray.create()
	arguments.push(BuildCommandName)
	arguments.push(staged.join("{StagedProgramFileName}").toString())
	arguments.push(OutputOption)
	arguments.push(output.toString())
	for extra in extraArguments 'eachExtra'
		arguments.push(extra)
	end 'eachExtra'

	return spawnCompiler(arguments, staged: staged, what: "the `{BuildCommandName}` of the staged program")
end 'spawnBuild'

// An instrumented build, asserted rather than panicked: accepting `--coverage` and writing a binary for
// it is part of the surface this corpus gates, so a compiler that refuses the flag must FAIL a case
// rather than abort it as an environment problem.
export function requireCoverageBuild(staged FilePath, output FilePath) throws TestFailure
	var arguments = StringArray.create()
	arguments.push(CoverageBuildFlag)

	let build = spawnBuild(staged, output: output, extraArguments: arguments)
	try requireBuiltExecutable(build, output: output, what: "{BuildCommandName} … {CoverageBuildFlag}", reason: "Instrumenting is a BUILD flag: without it there are no counters, no `{CoverageDataSuffix}` and nothing for `{CoverageCommandName}` to report on.")
end 'requireCoverageBuild'

// An ORDINARY build of the same staged program — the control an instrumented one is measured against.
export function requirePlainBuild(staged FilePath, output FilePath) throws TestFailure
	let noArguments = StringArray.create()

	let build = spawnBuild(staged, output: output, extraArguments: noArguments)
	try requireBuiltExecutable(build, output: output, what: BuildCommandName, reason: "Every case here rests on an ordinary build of the same source succeeding, so a failure at this step is the fixture or the compiler rather than anything about coverage.")
end 'requirePlainBuild'

// What both builds above are held to: a zero exit, and a file where the exit says one is.
function requireBuiltExecutable(build CollectedOutput, output FilePath, what String, reason String) throws TestFailure
	try Expect.equal(build.exitCode() as AssertedInt, expected: 0, message: "`{what}` exited {build.exitCode()}. {reason} It wrote to stderr: {build.stderr}")
	try Expect.isTrue(File.exists(output), message: "`{what}` exited 0 and wrote no executable to {output.toString()}.")
end 'requireBuiltExecutable'

// The report a `coverage run` prints, asserted into existence: exit 0 because this tool's own status
// answers "did the MEASUREMENT complete", and NON-EMPTY because stdout is the report and nothing else,
// so an empty one is a measurement that produced no report at all.
//
// The executable comes FIRST on the command line and the options after it: the first argument that is
// not an option is the executable, and everything past it belongs to the target.
export function requireCoverageRunReport(staged FilePath, executable FilePath) returns String throws TestFailure
	var arguments = StringArray.create()
	arguments.push(CoverageCommandName)
	arguments.push(RunVerbName)
	arguments.push(executable.toString())

	let run = spawnCompiler(arguments, staged: staged, what: "`{TestedCompilerStem} {CoverageCommandName} {RunVerbName}`")
	try Expect.equal(run.exitCode() as AssertedInt, expected: 0, message: "`{CoverageCommandName} {RunVerbName}` exited {run.exitCode()} over a binary this compiler built with `{CoverageBuildFlag}`. This tool's own exit code answers ONE question — did the MEASUREMENT complete — so a non-zero here says the run never produced counters at all. It wrote to stderr: {run.stderr}")

	let report = withoutCarriageReturns(run.stdout)
	try Expect.isFalse(report.isEmpty(), message: "`{CoverageCommandName} {RunVerbName}` exited 0 and printed NOTHING to stdout. stdout is the report and nothing else — the measured program's own output goes to stderr — so every assertion a case makes about the report would then be made about an empty string.")

	return report
end 'requireCoverageRunReport'

// One child driver, run in the staging tree. A binary that is not there and a spawn that never happened
// both stop a case running at all, so both panic naming what was being asked for.
function spawnCompiler(arguments StringArray, staged FilePath, what String) returns CollectedOutput
	let binary = testedCompilerPath()
	if not File.exists(binary) 'noBinary'
		panic("coverage tests: the gate could not run — {what} needs a driver at {binary.toString()} and there is none. This file's paths are relative to the CHECKOUT ROOT (see the header); run it from there, and build `{TestedCompilerStem}` first.")
	end 'noBinary'

	var config = Configuration.create(Executable.path(binary))
	config.arguments = arguments
	config.workingDirectory = staged

	return try config.run() otherwise (e) 'spawnFailed'
		panic("coverage tests: the gate could not run — could not spawn {what} ({e.displayReason()}).")
	end 'spawnFailed'
end 'spawnCompiler'

// The compiler under test, absolute and with the suffix this host can spawn.
function testedCompilerPath() returns FilePath
	let spelled = "{TestedCompilerStem}{executableSuffix()}"
	let relative = try FilePath.from(spelled) otherwise panic("coverage tests: the gate could not run — '{spelled}' is not a spellable path")

	return relative.resolve(Directory.currentPath())
end 'testedCompilerPath'

function executableSuffix() returns String
	#if os(Windows)
		let suffix = ".exe"
	#else
		let suffix = ""
	#endif

	return suffix
end 'executableSuffix'

// ============================================================================================
// READING A CAPTURED STREAM
// ============================================================================================

function withoutCarriageReturns(raw String) returns String
	return raw.replace(CarriageReturn, with: "")
end 'withoutCarriageReturns'

export function outputLines(raw String) returns StringArray
	return withoutCarriageReturns(raw).split(LineFeed)
end 'outputLines'

// A row's words, with the runs of spacing a report lays its columns out with dropped.
export function whitespaceTokens(row String) returns StringArray
	var tokens = StringArray.create()
	for piece in row.replace(Tab, with: Space).split(Space) 'eachPiece'
		if not piece.isEmpty() 'aWord'
			tokens.push(piece)
		end 'aWord'
	end 'eachPiece'

	return tokens
end 'whitespaceTokens'

// The word that follows a summary key on the summary line — `15/17` for `lines:`, `2` for
// `eliminated:`. Empty when the key is absent, which fails the assertion that consumes it
// rather than standing in for a tally nobody printed.
export function summaryTokenAfter(report String, key String) returns String
	let keyWord = key.trim()
	for line in outputLines(report) 'eachLine'
		if not line.startsWith(LinesSummaryKey) 'notTheSummary'
			continue
		end 'notTheSummary'

		var takeNext = false
		for token in whitespaceTokens(line) 'eachToken'
			if takeNext 'theValue'
				return token
			end 'theValue'

			takeNext = token == keyWord
		end 'eachToken'
	end 'eachLine'

	return ""
end 'summaryTokenAfter'

// The halves of an `N/M` ratio. A token spelling no separator reads 0 on both sides, which fails the
// assertion that consumes it.
export function ratioNumerator(token String) returns CoverageTally
	let halves = token.split(RatioSeparator)
	let covered = try halves.get(0) otherwise ""

	return decimalValue(covered)
end 'ratioNumerator'

export function ratioDenominator(token String) returns CoverageTally
	let halves = token.split(RatioSeparator)
	let instrumented = try halves.get(1) otherwise ""

	return decimalValue(instrumented)
end 'ratioDenominator'

// A token's leading decimal digits. Digits are read until the first character that is not one, so a token
// spelling none reads 0 — which fails the assertion that consumes it rather than standing in for a number
// nobody published.
export function decimalValue(token String) returns CoverageTally
	var value = 0
	for c in token.trim() 'eachCharacter'
		if not Ascii.isDigit(c) 'pastTheDigits'
			break
		end 'pastTheDigits'

		value = value * DecimalBase + digitValue(c)
	end 'eachCharacter'

	return value
end 'decimalValue'

// A decimal digit's value. The caller has already classified `c`, so the conversion cannot fail.
function digitValue(c Character) returns CoverageTally
	let code = try c.asciiValue() otherwise panic("coverage tests: digitValue is reached only past a digit test")

	return code - AsciiDigitZero
end 'digitValue'

// ============================================================================================
// READING THE STAGED FIXTURE — the line numbers every case DERIVES rather than writes down
// ============================================================================================

// The staged program's lines, CR folded. Read on demand rather than held: every case that wants them has
// already paid for a spawned compile.
export function stagedSourceLines(staged FilePath) returns StringArray
	let path = staged.join("{StagedProgramFileName}")
	let body = try File.readText(path) otherwise panic("coverage tests: the gate could not run — could not read the staged program at {path.toString()}, which this process wrote moments ago.")

	return outputLines(body)
end 'stagedSourceLines'

// The 1-based line of the staged fixture carrying `anchor`. EXACTLY ONE line must carry it: zero means
// the case is asking about a line the fixture no longer has, and two means the case would silently pin
// whichever the walk saw last. Both stop the case rather than failing it — neither is the driver
// answering wrongly.
export function anchoredLineNumber(staged FilePath, anchor String) returns FixtureLineNumber
	let suffix = "{AnchorPrefix}{anchor}"
	var found = 0
	var hits = 0
	var position = 0
	for line in stagedSourceLines(staged) 'eachLine'
		position = position + 1
		if line.endsWith(suffix) 'theAnchor'
			found = position
			hits = hits + 1
		end 'theAnchor'
	end 'eachLine'

	if hits != 1 'notExactlyOne'
		panic("coverage tests: the gate could not run — {hits} lines of the staged fixture end with '{suffix}', and a case that names an anchor means exactly one. Add it back, or make it unique.")
	end 'notExactlyOne'

	return found
end 'anchoredLineNumber'

// ============================================================================================
// DIRECTORIES
// ============================================================================================

// Delete every file under a staging directory, leaving the directories. Enough for a re-run: a case
// stages the same shape every time, and the previous run's products must not survive into a comparison.
function clearStagedFiles(dir FilePath)
	for entry in listing(dir) 'eachEntry'
		if Directory.isDirectory(entry) 'aDirectory'
			clearStagedFiles(entry)
			continue
		end 'aDirectory'

		try File.delete(entry) otherwise panic("coverage tests: the gate could not run — could not clear {entry.toString()} from a previous run's staging tree.")
	end 'eachEntry'
end 'clearStagedFiles'

// A directory this corpus's paths name, refused loudly when it is not there: every such refusal is the
// working-directory contract in the header not being met.
function fixtureDir(spelled String) returns FilePath
	let path = try FilePath.from(spelled) otherwise panic("coverage tests: the gate could not run — '{spelled}' is not a spellable path")
	if not Directory.isDirectory(path) 'notThere'
		panic("coverage tests: the gate could not run — there is no directory at '{spelled}'. Every path in this corpus is relative to the CHECKOUT ROOT, which is the working directory a test binary inherits from `maxon test`; a run started anywhere else finds nothing.")
	end 'notThere'

	return path
end 'fixtureDir'

// A directory this run writes into, created ancestor by ancestor so a fresh checkout without `temp/` is
// not a failure, and absolute because it is handed to a child process as its working directory.
function stagingDir(spelled String) returns FilePath
	var prefix = ""
	for component in spelled.split(PathSeparator) 'eachComponent'
		prefix = component if prefix.isEmpty() else "{prefix}{PathSeparator}{component}"
		let ancestor = try FilePath.from(prefix) otherwise panic("coverage tests: the gate could not run — '{prefix}' is not a spellable path")
		if not Directory.create(ancestor) 'couldNotCreate'
			panic("coverage tests: the gate could not run — could not create '{prefix}'. It is where a case's runnable copy is built; nothing can be staged without it.")
		end 'couldNotCreate'
	end 'eachComponent'

	let path = try FilePath.from(spelled) otherwise panic("coverage tests: the gate could not run — '{spelled}' is not a spellable path")

	return path.resolve(Directory.currentPath())
end 'stagingDir'

// What one directory holds.
function listing(dir FilePath) returns PathArray
	return try Directory.list(dir) otherwise panic("coverage tests: the gate could not run — could not list {dir.toString()}")
end 'listing'
