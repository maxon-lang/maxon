// CoverageHarness.maxon — the shared half every case under `tests/coverage/` reaches for: building
// a staged fixture instrumented, running the tool at it, and reading back the report.
//
// `maxon coverage <run|report> <exe>` joins three artifacts produced at three different moments — the
// binary's own `.text` hash, the `.mxdbg` sidecar's coverage-point table, and the `.mxcov` counters the
// program wrote on its way out. Counters are anonymous indices and a point table is a stride, so a writer
// and a reader that disagree about either attribute real numbers to the wrong lines.
//
// ⭐⭐ **THE RUNNER AND THE SUBJECT ARE THE SAME BINARY, AND NOTHING OUTSIDE CLOSES THAT.** `maxon test
// tests/coverage` both runs these cases and provides the compiler they spawn — named by
// `TestedCompilerStem` and by nothing else — so a runner broken badly enough to report green having run
// nothing cannot detect itself. READ THE PASS COUNT.
//
// ⛔ **EVERY FREE FUNCTION IN A DIRECTORY SHARES ONE NAMESPACE, whatever its visibility** (E3006).
// So the corpus gets ONE shared half, exported from this file, and a case file beside it declares
// only what that case alone uses. A file-private `let` does NOT collide, so a constant declared
// twice is the half nothing catches: every constant this corpus shares is declared here or in
// `tests/support/`.
//
// ⛔ **EVERYTHING THAT WOULD STOP A CASE RUNNING AT ALL PANICS RATHER THAN FAILING AN ASSERTION**: a
// missing compiler, an unspellable path, a spawn that never happened. A BUILD that exits non-zero is not
// in that class — `--coverage` is part of the surface under test — so it is asserted.
//
// ⛔ **THIS FILE'S PATHS ARE RELATIVE TO THE CHECKOUT ROOT**, which is the working directory a test
// binary inherits from `maxon test`. Everything handed to a child is made absolute first, because a
// relative path resolves against the child's directory on POSIX and the parent's on Windows.
//
// ⛔ **ONE SPAWNING `test` PER FILE, AND EVERY CASE STAGES INTO A DIRECTORY NAMED FOR ITSELF**, because
// `maxon test` runs files concurrently and two cases sharing a staging tree would race over one output
// path. A case that needs two programs takes two staging labels, never two names in one tree.

// Where the corpus lives and where runnable copies are built, both relative to the checkout root.
// Staging goes to gitignored `temp/`: a live `.maxon` under `tests/` is one `maxon fmt` over the
// checkout rewrites.
export let FixturesDirName = "tests/coverage/fixtures"
export let StagingRootDirName = "temp/coverage"

// The program this corpus stages: it carries every line state and both branch shapes.
export let StatesFixtureName = "states"

// The driver surface under test, spelled as the command line takes it.
let CoverageCommandName = "coverage"
let RunVerbName = "run"
export let CoverageBuildFlag = "--coverage"

// The counter file an instrumented binary writes on its way out, named for the binary with its extension
// still on: `out.exe` -> `out.exe.mxcov`.
let CoverageDataSuffix = ".mxcov"

// What an instrumented binary is built as. One spelling, because every case that measures one builds it
// under this name and a second spelling would be a name two cases could come to disagree about.
export let CoveredOutputStem = "covered"

// The summary line every tally is read off, and the separator that splits a tally in two. Everything else
// about the report's shape belongs to the one case that reads it.
export let LinesSummaryKey = "lines: "
let RatioSeparator = "/"

// The two markers that stand where a count would be, homed here because more than one case reads each.
// They are the report's vocabulary for the states a NUMBER cannot express, and the difference between
// them is the whole reason the fourth state exists: `#####` blames the RUN for not reaching code that is
// there to reach, `-----` says the optimizer emitted none, so there is nothing a test could ever cover.
export let NotCoveredMarker = "#####"
export let EliminatedMarker = "-----"

// ============================================================================================
// STAGING AND SPAWNING
// ============================================================================================

// The counter file a binary writes on exit: the WHOLE output name plus the suffix, which is how both the
// emitted runtime and every reader derive it.
export function coverageDataPath(executable FilePath) returns FilePath
	let spelled = "{executable.toString()}{CoverageDataSuffix}"

	return try FilePath.from(spelled) otherwise panic("coverage tests: the gate could not run — '{spelled}' is not a spellable path")
end 'coverageDataPath'

// An instrumented build, asserted rather than panicked: accepting `--coverage` and writing a binary for
// it is part of the surface this corpus gates, so a compiler that refuses the flag must FAIL a case
// rather than abort it as an environment problem.
export function requireCoverageBuild(staged FilePath, output FilePath) throws TestFailure
	var arguments = StringArray.create()
	arguments.push(CoverageBuildFlag)

	let build = spawnBuild(staged.join(StagedProgramFileName), staged: staged, output: output, label: CoverageBuildFlag, extraArguments: arguments)
	try requireBuiltExecutable(build, output: output, what: "{BuildCommandName} … {CoverageBuildFlag}", reason: "Instrumenting is a BUILD flag: without it there are no counters, no `{CoverageDataSuffix}` and nothing for `{CoverageCommandName}` to report on.")
end 'requireCoverageBuild'

// An ORDINARY build of the same staged program — the control an instrumented one is measured against.
export function requirePlainBuild(staged FilePath, output FilePath) throws TestFailure
	let noArguments = StringArray.create()

	let build = spawnBuild(staged.join(StagedProgramFileName), staged: staged, output: output, label: BuildCommandName, extraArguments: noArguments)
	try requireBuiltExecutable(build, output: output, what: BuildCommandName, reason: "Every case here rests on an ordinary build of the same source succeeding, so a failure at this step is the fixture or the compiler rather than anything about coverage.")
end 'requirePlainBuild'

// The report a `coverage run` prints, asserted into existence: exit 0 because this tool's own status
// answers "did the MEASUREMENT complete", and NON-EMPTY because stdout is the report and nothing else,
// so an empty one is a measurement that produced no report at all.
//
// The executable comes FIRST on the command line and the options after it: the first argument that is
// not an option is the executable, and everything past it belongs to the target.
export function requireCoverageRunReport(staged FilePath, executable FilePath) returns String throws TestFailure
	var arguments = StringArray.create()
	arguments.push(CoverageCommandName)
	arguments.push(RunVerbName)
	arguments.push(executable.toString())

	let run = spawnCompiler(arguments, staged: staged, what: "`{TestedCompilerStem} {CoverageCommandName} {RunVerbName}`")
	try Expect.equal(run.exitCode(), expected: 0, message: "`{CoverageCommandName} {RunVerbName}` exited {run.exitCode()} over a binary this compiler built with `{CoverageBuildFlag}`. This tool's own exit code answers ONE question — did the MEASUREMENT complete — so a non-zero here says the run never produced counters at all. It wrote to stderr: {run.stderr}")

	let report = withoutCarriageReturns(run.stdout)
	try Expect.isFalse(report.isEmpty(), message: "`{CoverageCommandName} {RunVerbName}` exited 0 and printed NOTHING to stdout. stdout is the report and nothing else — the measured program's own output goes to stderr — so every assertion a case makes about the report would then be made about an empty string.")

	return report
end 'requireCoverageRunReport'

// ============================================================================================
// READING A CAPTURED STREAM
// ============================================================================================

// The word that follows a summary key on the summary line — `15/17` for `lines:`, `2` for
// `eliminated:`. Empty when the key is absent, which fails the assertion that consumes it
// rather than standing in for a tally nobody printed.
export function summaryTokenAfter(report String, key String) returns String
	let keyWord = key.trim()

	for line in outputLines(report) 'eachLine'
		if not line.startsWith(LinesSummaryKey) 'notTheSummary'
			continue
		end 'notTheSummary'

		var takeNext = false

		for token in whitespaceTokens(line) 'eachToken'
			if takeNext 'theValue'
				return token
			end 'theValue'

			takeNext = token == keyWord
		end 'eachToken'
	end 'eachLine'

	return ""
end 'summaryTokenAfter'

// The halves of an `N/M` ratio. A token spelling no separator reads 0 on both sides, which fails the
// assertion that consumes it.
export function ratioNumerator(token String) returns PrintedNumber
	let halves = token.split(RatioSeparator)
	let covered = try halves.get(0) otherwise ""

	return decimalValue(covered)
end 'ratioNumerator'

export function ratioDenominator(token String) returns PrintedNumber
	let halves = token.split(RatioSeparator)
	let instrumented = try halves.get(1) otherwise ""

	return decimalValue(instrumented)
end 'ratioDenominator'
