let AsyncShadowedCaseLabel = "scriptlib-an-async-call-on-a-shadowed-library-type-compiles"
let AsyncShadowedFunction = "stamp"
let AsyncShadowedPackageSource = "public function stamp() returns Count\n\tlet t = await async Clock.nowMs()\n\treturn 1 if t >= t else 0\nend 'stamp'\n"
let AsyncShadowedAnswer = "1"

test 'a scriptlib package spawns a static of a library type the script shadows'
	let staged = stageScriptlibCase(AsyncShadowedCaseLabel)
	writeScriptlibPackageFile(stagedTier(AsyncShadowedCaseLabel), package: MintProbePackageName, fileName: MintProbePackageFileName, content: AsyncShadowedPackageSource)
	let script = staged.sources.join(ScriptFileName)
	writeStagedFile(script, content: shadowingScriptSource(ShadowedClockTypeName, packageFunction: AsyncShadowedFunction))

	let run = runProgram(staged, program: script)

	let observedExit = run.exitCode()
	Expect.equal(observedExit, expected: 0, message: "a package awaiting `async Clock.nowMs()` did not run beside a script declaring a `type Clock` of its own. The package's `Clock` is the library's, spawned or called. It said: {run.stdout}{run.stderr}")

	let observedStdout = withoutCarriageReturns(run.stdout)
	Expect.equal(observedStdout, expected: "{AsyncShadowedAnswer}{LineFeed}", message: "the script did not print the answer the package returns")

	let observedStderr = withoutCarriageReturns(run.stderr)
	Expect.equal(observedStderr, expected: "", message: "the run wrote to stderr, and neither the script nor the package writes anything there")
end 'a scriptlib package spawns a static of a library type the script shadows'
