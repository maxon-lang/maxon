let QualifiedHeadCaseLabel = "scriptlib-a-qualified-library-type-head-compiles"
let QualifiedHeadFunction = "stamp"
let QualifiedHeadPackageSource = "public function stamp() returns Count\n\tlet t = stdlib.Clock.nowMs()\n\treturn 1 if t >= t else 0\nend 'stamp'\n"
let QualifiedHeadAnswer = "1"

test 'a scriptlib package names a library type the script shadows by its qualified name'
	let staged = stageScriptlibCase(QualifiedHeadCaseLabel)
	writeScriptlibPackageFile(stagedTier(QualifiedHeadCaseLabel), package: MintProbePackageName, fileName: MintProbePackageFileName, content: QualifiedHeadPackageSource)
	let script = staged.sources.join(ScriptFileName)
	writeStagedFile(script, content: shadowingScriptSource(ShadowedClockTypeName, packageFunction: QualifiedHeadFunction))

	let run = runProgram(staged, program: script)

	let observedExit = run.exitCode()
	Expect.equal(observedExit, expected: 0, message: "a package calling `stdlib.Clock.nowMs()` did not run beside a script declaring a `type Clock` of its own. It said: {run.stdout}{run.stderr}")

	let observedStdout = withoutCarriageReturns(run.stdout)
	Expect.equal(observedStdout, expected: "{QualifiedHeadAnswer}{LineFeed}", message: "the script did not print the answer the package returns")

	let observedStderr = withoutCarriageReturns(run.stderr)
	Expect.equal(observedStderr, expected: "", message: "the run wrote to stderr, and neither the script nor the package writes anything there")
end 'a scriptlib package names a library type the script shadows by its qualified name'
