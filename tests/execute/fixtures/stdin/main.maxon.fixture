// One line off stdin, echoed. A program reading stdin only works when `maxon run` hands the child the
// caller's own, so a driver that closed it would report the refusal below.

function main() returns ExitCode
	var input = Console.stdin()
	let line = try input.readLine() otherwise 'noInput'
		print("no stdin\n")
		return 1
	end 'noInput'

	print("echo {line}\n")
	return 0
end 'main'
