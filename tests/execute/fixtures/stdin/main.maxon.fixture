// One line off stdin, echoed. A program reading stdin only works when `maxon run` hands the child the
// caller's own, so a driver that closed it would report the refusal below.

function noInput() returns ExitCode
	print("no stdin\n")
	return 1
end 'noInput'

function main() returns ExitCode
	let input = Console.stdin()
	let read = try input.readLine() otherwise return noInput()

	match read 'read'
		line(text) then print("echo {text}\n")
		ended then return noInput()
	end 'read'

	return 0
end 'main'
