let CacheHitAcrossSpellingsCaseLabel = "cache-hit-across-spellings"

test 'two spellings of one program share its cached build'
	let staged = stageCase(CacheHitAcrossSpellingsCaseLabel, fixture: HelloFixtureName)
	let program = stagedMain(staged)
	let respelled = try FilePath.from("././/{program.filename()}") otherwise panic("run tests: the gate could not run — '././/{program.filename()}' is not a spellable path")

	let first = runProgram(staged, program: program)
	let firstExit = first.exitCode() as AssertedInt
	Expect.equal(firstExit, expected: 0, message: "the first run failed, so there is no build for a second one to reuse. It said: {first.stdout}{first.stderr}")

	removeSlotSidecar(staged)

	let second = runProgram(staged, program: respelled)
	let secondExit = second.exitCode() as AssertedInt
	Expect.equal(secondExit, expected: 0, message: "the run through `{respelled.toString()}` failed. It said: {second.stdout}{second.stderr}")

	let secondStdout = withoutCarriageReturns(second.stdout)
	Expect.equal(secondStdout, expected: "{HelloGreeting}{LineFeed}", message: "the run through `{respelled.toString()}` did not print what the program prints")

	let builds = slotExecutables(staged).count() as AssertedInt
	Expect.equal(builds, expected: 1, message: "`{program.toString()}` and `{respelled.toString()}`, run from the directory holding the program, left {builds} cached builds. Both name one file, and a spelling that differs only by `.` components and repeated separators must reach the build the other made rather than compile the program again into a slot of its own.")

	if builds != 1 'notOneSlot'
		return
	end 'notOneSlot'

	let recompiled = slotHasSidecar(staged)
	Expect.isFalse(recompiled, message: "the run through `{respelled.toString()}` COMPILED the program again: the debug sidecar removed after the run through `{program.toString()}` is back.")
end 'two spellings of one program share its cached build'
