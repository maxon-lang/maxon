// console-write-imports.test.maxon — WHICH WRITE MECHANISM an x64-windows program is built with.
//
// A Windows console decodes what a program writes, and there are two ways to make it decode UTF-8 text
// correctly. One switches the console's OUTPUT CODE PAGE at startup — a process-wide setting on a shared
// object the program does not own, which outlives the program on a console it did not create and which
// says nothing at all when the stream is a pipe or a file. The other asks, per standard stream, whether
// the handle IS a console, and writes UTF-16 through `WriteConsoleW` when it is. This corpus gates which
// of the two an emitted image was built with.
//
// ⭐⭐ **THE SUBJECT IS THE EMITTED IMAGE, NOT THIS HOST.** The bytes of the file the compiler just wrote
// answer both questions below — without running it, and without a console to run it on. That is the only
// place they ARE answerable: a running program's writes look the same from outside whichever API carried
// them, so no program can report how it was built.
//
// ⛔⛔ **WHAT IS GATED HERE, EXACTLY — AND WHAT IS NOT.** Two claims, and neither is about the conversion:
//
//   • **THE NEW MECHANISM IS PRESENT** — the image carries the SYMBOL `mrt_write_stream`, the emitted chunk
//     the whole write path goes through. A chunk's name reaches `__symtable` (the backtrace symbolizer's
//     table) only because the chunk was EMITTED, so the name is in the file when the mechanism is built in
//     and nowhere in it when it is not.
//   • **THE OLD MECHANISM IS ABSENT** — the image does not import `SetConsoleOutputCP`.
//
// ⛔ **AN IMPORT NAME COULD NOT CARRY THE FIRST CLAIM, AND AN EARLIER CUT OF THIS CASE TRIED.**
// `GetConsoleMode` and `WriteConsoleW` sit in kernel32's MANDATORY band (`PeWriter.isOptionalTrailingImport`),
// which every x64-windows image emits whether or not anything calls them — MEASURED: a hello-world that
// touches no file still imports `FindFirstFileA` and `CreateDirectoryA`. Asserting those names present
// would therefore assert that two enum cases exist, and would stay green with the write path reverted
// whole. The ABSENCE assertion has teeth for the same reason read the other way: a `SetConsoleOutputCP`
// that still existed would be in every image, so its absence proves the case is gone from the enum.
//
// ⛔ **THE IMPLEMENTATION MEANS ARE NOT PINNED.** `MultiByteToWideChar` is one way to get UTF-16 and it is
// not the behaviour; a case naming it would forbid an encoder written in Maxon that is just as correct.
// The chunk's NAME is pinned instead, which is a claim about the write path existing rather than about how
// it converts.
//
// ⛔⛔ **AND THE CONVERSION ITSELF IS GATED BY NOTHING, ANYWHERE.** Whether the bytes reaching a console are
// the right UTF-16 is decided by a road that runs only when a standard stream IS a console, and no
// automated gate in this repository ever puts one there: `maxon test` and `spec-test` both collect a
// child's output through a PIPE, which takes the NOT-A-CONSOLE road end to end. A spec case cannot ask
// either — it is a program, and a program cannot see which API carried its own writes. So the console road
// is covered by HAND, against a real console, and by nothing else; do not read a green run here as
// evidence that it converts correctly.
//
// ⛔ **EVERYTHING THAT WOULD STOP THE CASE RUNNING AT ALL PANICS RATHER THAN FAILING AN ASSERTION** — a
// missing compiler, an unspellable path, a spawn that never happened, a BUILD that produced no image.
// None of those is an image built with the wrong mechanism, so none may reach a reader as though it were.
//
// ⛔ **THIS FILE'S PATHS ARE RELATIVE TO THE CHECKOUT ROOT**, which is the working directory a test binary
// inherits from `maxon test`. Everything handed to the child is made absolute first, because a relative
// path resolves against the child's directory on POSIX and the parent's on Windows.
//
// ⛔ **ONE SPAWNING `test`, ONE FILE, ONE COMPILE**, which is what keeps this inside the 5,000 ms per-file
// deadline; staging goes to a directory named for this case, because `maxon test` runs files concurrently.

// Where the corpus lives and where the runnable copy is built, both relative to the checkout root. Staging
// goes to gitignored `temp/`: a live `.maxon` under `tests/` is one `maxon fmt` over the checkout rewrites.
let FixturesDirName = "tests/console-write/fixtures"
let HelloFixtureName = "hello"
let StagingRootDirName = "temp/console-write"
let CaseLabel = "console-write-imports"

// The stored-name mapping, `tests/README.md` rule 1: `<name>.fixture -> <name>`.
let StoredFixtureSuffix = ".fixture"
let StagedProgramFileName = "main.maxon"

// The binary this directory spawns, relative to the checkout root and without its host suffix: the
// compiler under test, which is also what emits the image every assertion here reads.
let TestedCompilerStem = "maxon-bin/.maxon/maxon"

// The command line the one build is run from. The output name carries `.exe` because the TARGET does, not
// because this host might.
let BuildCommandName = "build"
let OutputOption = "-o"
let WindowsTargetName = "x64-windows"
let TargetOptionPrefix = "--target="
let OutputFileName = "out.exe"

// The two names this corpus is about, and why each one is where it is.
//
// ⚠ They are read the SAME way — a byte search over the image — but they are not the same KIND of name.
// One is a chunk the compiler EMITS, so its presence is decided by the emitter; the other is a kernel32
// import, so its presence is decided by the `IatSlot` enum. See the header for why only that pairing
// gives each assertion teeth.
let WriteChunkName = "mrt_write_stream"
let WriteChunkReason = "It is the one chunk `print`, `printError` and the panic writer all reach, and the only place the per-stream console probe and the UTF-16 conversion exist. Its name is in `__symtable` because the chunk was emitted, so a build that reverted to writing raw bytes at the handle would not carry it."
let CodepageSwitchName = "SetConsoleOutputCP"
let CodepageSwitchReason = "It mutates a console the program does not own and cannot restore, it outlives the process on a console the process did not create, and it answers nothing at all when the stream is a pipe or a file. It is a MANDATORY kernel32 slot, so an image that still declared it would import it whether or not anything called it — which is what makes this absence a real reading."

// The separator this file's own paths are spelled with, folded into the host's by `stagingDir`.
let PathSeparator = "/"

// A list of paths one directory walk produced. Stdlib's own `FilePathArray` is a member of `Directory` and
// has no file-scope spelling.
typealias PathArray = Array with FilePath

// ============================================================================================
// THE CONTRACT
// ============================================================================================

test 'an x64-windows image carries the per-stream console writer and no code-page switch'
	let staged = stagedProgram()
	let image = fileBytes(buildStagedProgram(staged))

	// The control: an empty image would satisfy every ABSENCE demand below by holding nothing at all.
	try Expect.greaterThan(image.count() as AssertedInt, than: 0, message: "the {WindowsTargetName} build wrote an EMPTY file, so nothing read out of it means anything — an absent name and an absent image read alike.")

	var findings = StringArray.create()
	noteName(findings, image: image, name: WriteChunkName, present: true, why: WriteChunkReason)
	noteName(findings, image: image, name: CodepageSwitchName, present: false, why: CodepageSwitchReason)

	try Expect.isTrue(findings.isEmpty(), message: "the {WindowsTargetName} image the compiler just emitted was built with the wrong write mechanism:{renderedFindings(findings)}")
end 'an x64-windows image carries the per-stream console writer and no code-page switch'

// One name's presence, RECORDED rather than asserted, so one run reports the whole state of the image: an
// assertion per name stops at the first disagreement, and the one behind it is exactly what says whether
// the change landed halfway — a new writer beside a code-page switch nobody removed.
//
// What is read is a byte search, which serves both names because both reach the file as plain ASCII: a
// chunk's name through `__symtable`, an import's through the idata name table.
function noteName(findings StringArray, image ByteArray, name String, present bool, why String)
	let found = image.contains(asciiBytes(name))

	if found == present 'asDemanded'
		return
	end 'asDemanded'

	let demand = "must carry" if present else "must NOT carry"
	let observed = "the name is nowhere in the image" if present else "the name is still in the image"

	findings.push("a freshly built {WindowsTargetName} program {demand} `{name}`, and {observed}. {why}")
end 'noteName'

// The findings as the text a failure report shows. EMPTY for none, so the assertion above is an `isEmpty`
// over the very text a reader has to act on.
function renderedFindings(findings StringArray) returns String
	var rendered = ""

	for finding in findings 'eachFinding'
		rendered.append("\n  • {finding}")
	end 'eachFinding'

	return rendered
end 'renderedFindings'

// A name as the image holds it: ASCII, one byte per character.
function asciiBytes(name String) returns ByteArray
	var bytes = ByteArray.create()

	for octet in name.bytes() 'eachByte'
		bytes.push(octet)
	end 'eachByte'

	return bytes
end 'asciiBytes'

// ============================================================================================
// STAGING, BUILDING AND READING THE IMAGE
// ============================================================================================

// A runnable copy of the fixture under a directory named for this case. Absolute, because it is handed to
// the child as its working directory. The previous run's files go first: a stale executable would let a
// build that produced none be read as though it had.
function stagedProgram() returns FilePath
	let staged = stagingDir("{StagingRootDirName}{PathSeparator}{CaseLabel}")
	clearStagedFiles(staged)

	let stored = fixtureDir("{FixturesDirName}{PathSeparator}{HelloFixtureName}").join("{StagedProgramFileName}{StoredFixtureSuffix}")
	let body = try File.readText(stored) otherwise panic("console-write tests: the gate could not run — could not read the stored fixture {stored.toString()}.")
	try File.writeText(staged.join("{StagedProgramFileName}"), content: body) otherwise panic("console-write tests: the gate could not run — could not stage {StagedProgramFileName} into {staged.toString()}.")

	return staged
end 'stagedProgram'

// Compile the staged program for Windows and hand back the image. `-o` is what keeps the build out of the
// tree lock. A build that fails is not this corpus's subject — there is simply nothing to read — so both
// of its failure shapes panic.
function buildStagedProgram(staged FilePath) returns FilePath
	let executable = staged.join("{OutputFileName}")

	var arguments = StringArray.create()
	arguments.push(BuildCommandName)
	arguments.push(staged.join("{StagedProgramFileName}").toString())
	arguments.push(OutputOption)
	arguments.push(executable.toString())
	arguments.push("{TargetOptionPrefix}{WindowsTargetName}")

	let build = spawnCompiler(arguments, staged: staged)

	if build.exitCode() != 0 'buildFailed'
		panic("console-write tests: the gate could not run — `{BuildCommandName} … {TargetOptionPrefix}{WindowsTargetName}` exited {build.exitCode()}, so no image was emitted to read. It wrote to stderr: {build.stderr}")
	end 'buildFailed'

	if not File.exists(executable) 'nothingWritten'
		panic("console-write tests: the gate could not run — `{BuildCommandName} … {TargetOptionPrefix}{WindowsTargetName}` exited 0 and wrote no executable to {executable.toString()}.")
	end 'nothingWritten'

	return executable
end 'buildStagedProgram'

// One child compiler, run in the staging tree. A binary that is not there and a spawn that never happened
// both stop the case running at all, so both panic naming what was being asked for.
function spawnCompiler(arguments StringArray, staged FilePath) returns CollectedOutput
	let binary = testedCompilerPath()

	if not File.exists(binary) 'noBinary'
		panic("console-write tests: the gate could not run — this case needs a compiler at {binary.toString()} and there is none. This file's paths are relative to the CHECKOUT ROOT (see the header); run it from there, and build `{TestedCompilerStem}` first.")
	end 'noBinary'

	var config = Configuration.create(Executable.path(binary))
	config.arguments = arguments
	config.workingDirectory = staged

	return try config.run() otherwise (e) 'spawnFailed'
		panic("console-write tests: the gate could not run — could not spawn the `{BuildCommandName}` of the staged program ({e.displayReason()}).")
	end 'spawnFailed'
end 'spawnCompiler'

// The emitted image's bytes. Its absence is asked here rather than read as an empty file: a build that
// exited 0 and wrote nothing is a claim an exit-code check cannot see.
function fileBytes(path FilePath) returns ByteArray
	if not File.exists(path) 'notWritten'
		panic("console-write tests: the gate could not run — there is no executable at {path.toString()}, so there is nothing to read.")
	end 'notWritten'

	return try File.readBinary(path) otherwise panic("console-write tests: the gate could not run — could not read {path.toString()}.")
end 'fileBytes'

// The compiler under test, absolute and with the suffix THIS host can spawn — which is the one axis the
// pinned target does not decide, because the runner has to execute it.
function testedCompilerPath() returns FilePath
	#if os(Windows)
		let spelled = "{TestedCompilerStem}.exe"
	#else
		let spelled = "{TestedCompilerStem}"
	#endif

	let relative = try FilePath.from(spelled) otherwise panic("console-write tests: the gate could not run — '{spelled}' is not a spellable path")

	return relative.resolve(Directory.currentPath())
end 'testedCompilerPath'

// ============================================================================================
// DIRECTORIES
// ============================================================================================

// Delete every file under the staging directory, leaving the directories. Enough for a re-run: the case
// stages the same shape every time, and the previous run's image must not survive into this run's read.
function clearStagedFiles(dir FilePath)
	for entry in listing(dir) 'eachEntry'
		if Directory.isDirectory(entry) 'aDirectory'
			clearStagedFiles(entry)
			continue
		end 'aDirectory'

		try File.delete(entry) otherwise panic("console-write tests: the gate could not run — could not clear {entry.toString()} from a previous run's staging tree.")
	end 'eachEntry'
end 'clearStagedFiles'

// A directory this corpus's paths name, refused loudly when it is not there: every such refusal is the
// working-directory contract in the header not being met.
function fixtureDir(spelled String) returns FilePath
	let path = try FilePath.from(spelled) otherwise panic("console-write tests: the gate could not run — '{spelled}' is not a spellable path")

	if not Directory.isDirectory(path) 'notThere'
		panic("console-write tests: the gate could not run — there is no directory at '{spelled}'. Every path in this corpus is relative to the CHECKOUT ROOT, which is the working directory a test binary inherits from `maxon test`; a run started anywhere else finds nothing.")
	end 'notThere'

	return path
end 'fixtureDir'

// A directory this run writes into, created ancestor by ancestor so a fresh checkout without `temp/` is not
// a failure, and absolute because it is handed to a child process as its working directory.
function stagingDir(spelled String) returns FilePath
	var prefix = ""

	for component in spelled.split(PathSeparator) 'eachComponent'
		prefix = component if prefix.isEmpty() else "{prefix}{PathSeparator}{component}"
		let ancestor = try FilePath.from(prefix) otherwise panic("console-write tests: the gate could not run — '{prefix}' is not a spellable path")

		if not Directory.create(ancestor) 'couldNotCreate'
			panic("console-write tests: the gate could not run — could not create '{prefix}'. It is where the case's runnable copy is built; nothing can be staged without it.")
		end 'couldNotCreate'
	end 'eachComponent'

	let path = try FilePath.from(spelled) otherwise panic("console-write tests: the gate could not run — '{spelled}' is not a spellable path")

	return path.resolve(Directory.currentPath())
end 'stagingDir'

// What one directory holds.
function listing(dir FilePath) returns PathArray
	return try Directory.list(dir) otherwise panic("console-write tests: the gate could not run — could not list {dir.toString()}")
end 'listing'
