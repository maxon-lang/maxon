function f8(n Integer) returns Real
	var acc = 15.5 + (n as Real)
	var i = 0
	while i < n 'loop'
		let k = i and 7
		match k 'arm'
			0 then acc = acc * 16.5
			1 then acc = acc + 2.5
			2 then acc = acc - 1.0
			3 then acc = acc * 0.5
			4 then acc = acc + 3.0
			5 then acc = acc - 2.0
			6 then acc = acc * 2.0
			7 then acc = acc + 1.0
			default then acc = acc + 0.25
		end 'arm'
		i = i + 1
	end 'loop'
	print("f8 {acc}\n")
	return acc
end 'f8'

function main() returns ExitCode
	let total = f1(9) + f2(10) + f3(11) + f4(12) + f5(13) + f6(14) + f7(15) + f8(16) + f1(3) + f2(4) + f3(5) + f4(6) + f5(7) + f6(8) + f7(9) + f8(10)
	if total > 0.0 'positive'
		return 0
	end 'positive'

	return 1
end 'main'

typealias Integer = int(i64.min to i64.max)
typealias Real = float(f64.min to f64.max)
