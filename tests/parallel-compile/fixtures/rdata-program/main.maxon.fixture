// Eight functions that each register `.rdata` content the isel is the first to see — two float
// constants of their own, a dense eight-arm `match` that lowers to a jump table, and a string literal —
// so the pool has to put every function's registrations back in FUNCTION-INDEX order: a jump table's
// label and every island's `.rdata` offset are minted off one counter, in registration order, and a
// pool that registered in arrival order would move them between two builds.
//
// Every body loops over its argument and every function is called twice, so none is a leaf the inliner
// folds into its caller and none is a constant the folder evaluates away.

function f1(n Integer) returns Real
	var acc = 1.5 + (n as Real)
	var i = 0
	while i < n 'loop'
		let k = i and 7
		match k 'arm'
			0 then acc = acc * 1.25
			1 then acc = acc + 2.5
			2 then acc = acc - 1.0
			3 then acc = acc * 0.5
			4 then acc = acc + 3.0
			5 then acc = acc - 2.0
			6 then acc = acc * 2.0
			7 then acc = acc + 1.0
			default then acc = acc + 0.25
		end 'arm'
		i = i + 1
	end 'loop'
	print("f1 {acc}\n")
	return acc
end 'f1'

function f2(n Integer) returns Real
	var acc = 3.5 + (n as Real)
	var i = 0
	while i < n 'loop'
		let k = i and 7
		match k 'arm'
			0 then acc = acc * 4.5
			1 then acc = acc + 2.5
			2 then acc = acc - 1.0
			3 then acc = acc * 0.5
			4 then acc = acc + 3.0
			5 then acc = acc - 2.0
			6 then acc = acc * 2.0
			7 then acc = acc + 1.0
			default then acc = acc + 0.25
		end 'arm'
		i = i + 1
	end 'loop'
	print("f2 {acc}\n")
