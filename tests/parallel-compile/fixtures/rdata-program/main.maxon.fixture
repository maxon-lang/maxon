function f7(n Integer) returns Real
	var acc = 13.5 + (n as Real)
	var i = 0
	while i < n 'loop'
		let k = i and 7
		match k 'arm'
			0 then acc = acc * 14.5
			1 then acc = acc + 2.5
			2 then acc = acc - 1.0
			3 then acc = acc * 0.5
			4 then acc = acc + 3.0
			5 then acc = acc - 2.0
