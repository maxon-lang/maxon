function wide01(seed Integer) returns Integer
	let a01 = seed * 2 + 4
	let a02 = seed * 3 + 7
	let a03 = seed * 4 + 10
	let a04 = seed * 5 + 13
	let a05 = seed * 6 + 16
	let a06 = seed * 7 + 19
	let a07 = seed * 8 + 22
	let a08 = seed * 9 + 25
	let a09 = seed * 10 + 28
	let a10 = seed * 11 + 31
	let a11 = seed * 12 + 34
	let a12 = seed * 13 + 37
	let a13 = seed * 14 + 40
	let a14 = seed * 15 + 43
	let a15 = seed * 16 + 46
	let a16 = seed * 17 + 49
	let a17 = seed * 18 + 52
	let a18 = seed * 19 + 55
	let a19 = seed * 20 + 58
	let a20 = seed * 21 + 61
	let a21 = seed * 22 + 64
	let a22 = seed * 23 + 67
	let a23 = seed * 24 + 70
	let a24 = seed * 25 + 73
	let c01 = sink(a01 + a03)
	let c02 = sink(c01 + a06)
	let c03 = sink(c02 + a09)
	let c04 = sink(c03 + a12)
	let c05 = sink(c04 + a15)
	let c06 = sink(c05 + a18)
	let c07 = sink(c06 + a21)
	let c08 = sink(c07 + a24)
	return a01 + a02 + a03 + a04 + a05 + a06 + a07 + a08 + a09 + a10 + a11 + a12 + a13 + a14 + a15 + a16 + a17 + a18 + a19 + a20 + a21 + a22 + a23 + a24 + c01 + c02 + c03 + c04 + c05 + c06 + c07 + c08
end 'wide01'

