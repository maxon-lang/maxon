// The first file of the front-end fixture. `twin` hands a borrowed element to a constructor that keeps it, and
// whether that owes a reference depends on an instance of `Holder` only the OTHER file's parse mints — so this
// file is folded again with the whole program's answer, and the merge renumbers instances both files minted.

export typealias Tally = int(0 to 1000)

export type Holder uses Element
	typealias Items = Array with Element

	var items as Items

	export static function create(first Element) returns Self
		var items = Items.create()
		items.push(first)
		return Self{items: items}
	end 'create'

	export function twin() returns Holder
		let first = try items.get(0) otherwise panic("a holder is created holding one element")
		return Holder.create(first)
	end 'twin'

	export function size() returns Tally
		return items.count()
	end 'size'
end 'Holder'
