module typealias BravoTally = int(0 to 1000000)
typealias BravoTallyArray = Array with BravoTally
typealias BravoLabelMap = Map with (String, ElementIndex)
typealias BravoShapeArray = Array with BravoShape

enum BravoColor
	red
	green
	blue
	amber
	violet
end 'BravoColor'

enum BravoPhase
	idle = 10
	warming = 20
	running = 30
	cooling = 40
end 'BravoPhase'

union BravoShape
	circle(radius BravoTally)
	square(side BravoTally)
	strip(width BravoTally, height BravoTally)
	empty
end 'BravoShape'

type BravoBox uses Element
	typealias Items = Array with Element

	var items as Items

	static function create(first Element) returns Self
		var items = Items.create()
		items.push(first)
		return Self{items: items}
	end 'create'

	function add(item Element)
		items.push(item)
	end 'add'

	function size() returns BravoTally
		return items.count()
	end 'size'
end 'BravoBox'

typealias BravoTextBox = BravoBox with String
typealias BravoTallyBox = BravoBox with BravoTally

type BravoRecord
	var label as String
	var weight as BravoTally
	var color as BravoColor
	var samples as BravoTallyArray

	static function create(label String, weight BravoTally, color BravoColor) returns Self
		var samples = BravoTallyArray.create()
		samples.push(weight)
		return Self{label: label, weight: weight, color: color, samples: samples}
	end 'create'

	function sample(value BravoTally)
		samples.push(value mod 1000)
	end 'sample'

	function total() returns BravoTally
		var sum = 0 as BravoTally

		for value in samples 'eachSample'
			sum = (sum + value) mod 100000
		end 'eachSample'

		return sum
	end 'total'

	function isWarm() returns bool
		return match color 'warmth'
			red or
				amber gives true
			green or
				blue or
				violet gives false
		end 'warmth'
	end 'isWarm'

	function heft() returns BravoTally
		return weight
	end 'heft'

	function describe() returns String
		return "{label}:{weight}:{total()}"
	end 'describe'
end 'BravoRecord'

typealias BravoRecordArray = Array with BravoRecord

type BravoLedger
	var records as BravoRecordArray
	var index as BravoLabelMap

	static function create() returns Self
		return Self{records: BravoRecordArray.create(), index: BravoLabelMap.create()}
	end 'create'

	function enter(record BravoRecord)
		index.upsert(record.describe(), value: records.count())
		records.push(record)
	end 'enter'

	function warmCount() returns BravoTally
		var warm = 0 as BravoTally

		for record in records 'eachRecord'
			if record.isWarm() 'warm'
				warm = warm + 1
			end 'warm'
		end 'eachRecord'

		return warm
	end 'warmCount'

	function heaviest() returns BravoTally
		var heaviest = 0 as BravoTally

		for record in records 'eachRecord'
			let heft = record.heft()
			heaviest = heft if heft > heaviest else heaviest
		end 'eachRecord'

		return heaviest
	end 'heaviest'
end 'BravoLedger'

function bravoArea(shape BravoShape) returns BravoTally
	return match shape 'area'
		circle(radius) gives (radius * radius * 3) mod 100000
		square(side) gives (side * side) mod 100000
		strip(width, height) gives (width * height) mod 100000
		empty gives 0
	end 'area'
end 'bravoArea'

function bravoPhaseWeight(phase BravoPhase) returns BravoTally
	return match phase 'weight'
		idle gives 1
		warming gives 2
		running gives 3
		cooling gives 4
	end 'weight'
end 'bravoPhaseWeight'

function bravoShapes(seed BravoTally) returns BravoTally
	var shapes = BravoShapeArray.create()
	shapes.push(BravoShape.circle(seed mod 50))
	shapes.push(BravoShape.square(seed mod 40))
	shapes.push(BravoShape.strip(seed mod 30, height: seed mod 20))
	shapes.push(BravoShape.empty)

	var total = 0 as BravoTally

	for shape in shapes 'eachShape'
		total = (total + bravoArea(shape)) mod 100000
	end 'eachShape'

	return total
end 'bravoShapes'

function bravoBoxes(seed BravoTally) returns BravoTally
	var text = BravoTextBox.create("first {seed}")
	text.add("second {seed}")

	var tallies = BravoTallyBox.create(seed mod 100)
	tallies.add(seed mod 7)
	tallies.add(seed mod 11)

	return text.size() + tallies.size()
end 'bravoBoxes'

function bravoLedger(seed BravoTally) returns BravoTally
	var ledger = BravoLedger.create()

	for color in BravoColor.allCases 'eachColor'
		var record = BravoRecord.create("{color.name} {seed}", weight: (seed + color.ordinal) mod 1000, color: color)
		record.sample(seed mod 13)
		ledger.enter(record)
	end 'eachColor'

	return ledger.warmCount() + ledger.heaviest()
end 'bravoLedger'

module function bravoScore(seed BravoTally) returns BravoTally
	var score = 0 as BravoTally

	for phase in BravoPhase.allCases 'eachPhase'
		score = (score + bravoPhaseWeight(phase)) mod 100000
	end 'eachPhase'

	score = (score + bravoShapes(seed)) mod 100000
	score = (score + bravoBoxes(seed)) mod 100000
	return (score + bravoLedger(seed)) mod 100000
end 'bravoScore'
