module typealias AlphaTally = int(0 to 1000000)
typealias AlphaTallyArray = Array with AlphaTally
typealias AlphaLabelMap = Map with (String, ElementIndex)
typealias AlphaShapeArray = Array with AlphaShape

enum AlphaColor
	red
	green
	blue
	amber
	violet
end 'AlphaColor'

enum AlphaPhase
	idle = 10
	warming = 20
	running = 30
	cooling = 40
end 'AlphaPhase'

union AlphaShape
	circle(radius AlphaTally)
	square(side AlphaTally)
	strip(width AlphaTally, height AlphaTally)
	empty
end 'AlphaShape'

type AlphaBox uses Element
	typealias Items = Array with Element

	var items as Items

	static function create(first Element) returns Self
		var items = Items.create()
		items.push(first)
		return Self{items: items}
	end 'create'

	function add(item Element)
		items.push(item)
	end 'add'

	function size() returns AlphaTally
		return items.count()
	end 'size'
end 'AlphaBox'

typealias AlphaTextBox = AlphaBox with String
typealias AlphaTallyBox = AlphaBox with AlphaTally

type AlphaRecord
	var label as String
	var weight as AlphaTally
	var color as AlphaColor
	var samples as AlphaTallyArray

	static function create(label String, weight AlphaTally, color AlphaColor) returns Self
		var samples = AlphaTallyArray.create()
		samples.push(weight)
		return Self{label: label, weight: weight, color: color, samples: samples}
	end 'create'

	function sample(value AlphaTally)
		samples.push(value mod 1000)
	end 'sample'

	function total() returns AlphaTally
		var sum = 0 as AlphaTally

		for value in samples 'eachSample'
			sum = (sum + value) mod 100000
		end 'eachSample'

		return sum
	end 'total'

	function isWarm() returns bool
		return match color 'warmth'
			red or
				amber gives true
			green or
				blue or
				violet gives false
		end 'warmth'
	end 'isWarm'

	function heft() returns AlphaTally
		return weight
	end 'heft'

	function describe() returns String
		return "{label}:{weight}:{total()}"
	end 'describe'
end 'AlphaRecord'

typealias AlphaRecordArray = Array with AlphaRecord

type AlphaLedger
	var records as AlphaRecordArray
	var index as AlphaLabelMap

	static function create() returns Self
		return Self{records: AlphaRecordArray.create(), index: AlphaLabelMap.create()}
	end 'create'

	function enter(record AlphaRecord)
		index.upsert(record.describe(), value: records.count())
		records.push(record)
	end 'enter'

	function warmCount() returns AlphaTally
		var warm = 0 as AlphaTally

		for record in records 'eachRecord'
			if record.isWarm() 'warm'
				warm = warm + 1
			end 'warm'
		end 'eachRecord'

		return warm
	end 'warmCount'

	function heaviest() returns AlphaTally
		var heaviest = 0 as AlphaTally

		for record in records 'eachRecord'
			let heft = record.heft()
			heaviest = heft if heft > heaviest else heaviest
		end 'eachRecord'

		return heaviest
	end 'heaviest'
end 'AlphaLedger'

function alphaArea(shape AlphaShape) returns AlphaTally
	return match shape 'area'
		circle(radius) gives (radius * radius * 3) mod 100000
		square(side) gives (side * side) mod 100000
		strip(width, height) gives (width * height) mod 100000
		empty gives 0
	end 'area'
end 'alphaArea'

function alphaPhaseWeight(phase AlphaPhase) returns AlphaTally
	return match phase 'weight'
		idle gives 1
		warming gives 2
		running gives 3
		cooling gives 4
	end 'weight'
end 'alphaPhaseWeight'

function alphaShapes(seed AlphaTally) returns AlphaTally
	var shapes = AlphaShapeArray.create()
	shapes.push(AlphaShape.circle(seed mod 50))
	shapes.push(AlphaShape.square(seed mod 40))
	shapes.push(AlphaShape.strip(seed mod 30, height: seed mod 20))
	shapes.push(AlphaShape.empty)

	var total = 0 as AlphaTally

	for shape in shapes 'eachShape'
		total = (total + alphaArea(shape)) mod 100000
	end 'eachShape'

	return total
end 'alphaShapes'

function alphaBoxes(seed AlphaTally) returns AlphaTally
	var text = AlphaTextBox.create("first {seed}")
	text.add("second {seed}")

	var tallies = AlphaTallyBox.create(seed mod 100)
	tallies.add(seed mod 7)
	tallies.add(seed mod 11)

	return text.size() + tallies.size()
end 'alphaBoxes'

function alphaLedger(seed AlphaTally) returns AlphaTally
	var ledger = AlphaLedger.create()

	for color in AlphaColor.allCases 'eachColor'
		var record = AlphaRecord.create("{color.name} {seed}", weight: (seed + color.ordinal) mod 1000, color: color)
		record.sample(seed mod 13)
		ledger.enter(record)
	end 'eachColor'

	return ledger.warmCount() + ledger.heaviest()
end 'alphaLedger'

module function alphaScore(seed AlphaTally) returns AlphaTally
	var score = 0 as AlphaTally

	for phase in AlphaPhase.allCases 'eachPhase'
		score = (score + alphaPhaseWeight(phase)) mod 100000
	end 'eachPhase'

	score = (score + alphaShapes(seed)) mod 100000
	score = (score + alphaBoxes(seed)) mod 100000
	return (score + alphaLedger(seed)) mod 100000
end 'alphaScore'
