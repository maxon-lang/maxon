module typealias EchoTally = int(0 to 1000000)
typealias EchoTallyArray = Array with EchoTally
typealias EchoLabelMap = Map with (String, ElementIndex)
typealias EchoShapeArray = Array with EchoShape

enum EchoColor
	red
	green
	blue
	amber
	violet
end 'EchoColor'

enum EchoPhase
	idle = 10
	warming = 20
	running = 30
	cooling = 40
end 'EchoPhase'

union EchoShape
	circle(radius EchoTally)
	square(side EchoTally)
	strip(width EchoTally, height EchoTally)
	empty
end 'EchoShape'

type EchoBox uses Element
	typealias Items = Array with Element

	var items as Items

	static function create(first Element) returns Self
		var items = Items.create()
		items.push(first)
		return Self{items: items}
	end 'create'

	function add(item Element)
		items.push(item)
	end 'add'

	function size() returns EchoTally
		return items.count()
	end 'size'
end 'EchoBox'

typealias EchoTextBox = EchoBox with String
typealias EchoTallyBox = EchoBox with EchoTally

type EchoRecord
	var label as String
	var weight as EchoTally
	var color as EchoColor
	var samples as EchoTallyArray

	static function create(label String, weight EchoTally, color EchoColor) returns Self
		var samples = EchoTallyArray.create()
		samples.push(weight)
		return Self{label: label, weight: weight, color: color, samples: samples}
	end 'create'

	function sample(value EchoTally)
		samples.push(value mod 1000)
	end 'sample'

	function total() returns EchoTally
		var sum = 0 as EchoTally

		for value in samples 'eachSample'
			sum = (sum + value) mod 100000
		end 'eachSample'

		return sum
	end 'total'

	function isWarm() returns bool
		return match color 'warmth'
			red or
				amber gives true
			green or
				blue or
				violet gives false
		end 'warmth'
	end 'isWarm'

	function heft() returns EchoTally
		return weight
	end 'heft'

	function describe() returns String
		return "{label}:{weight}:{total()}"
	end 'describe'
end 'EchoRecord'

typealias EchoRecordArray = Array with EchoRecord

type EchoLedger
	var records as EchoRecordArray
	var index as EchoLabelMap

	static function create() returns Self
		return Self{records: EchoRecordArray.create(), index: EchoLabelMap.create()}
	end 'create'

	function enter(record EchoRecord)
		index.upsert(record.describe(), value: records.count())
		records.push(record)
	end 'enter'

	function warmCount() returns EchoTally
		var warm = 0 as EchoTally

		for record in records 'eachRecord'
			if record.isWarm() 'warm'
				warm = warm + 1
			end 'warm'
		end 'eachRecord'

		return warm
	end 'warmCount'

	function heaviest() returns EchoTally
		var heaviest = 0 as EchoTally

		for record in records 'eachRecord'
			let heft = record.heft()
			heaviest = heft if heft > heaviest else heaviest
		end 'eachRecord'

		return heaviest
	end 'heaviest'
end 'EchoLedger'

function echoArea(shape EchoShape) returns EchoTally
	return match shape 'area'
		circle(radius) gives (radius * radius * 3) mod 100000
		square(side) gives (side * side) mod 100000
		strip(width, height) gives (width * height) mod 100000
		empty gives 0
	end 'area'
end 'echoArea'

function echoPhaseWeight(phase EchoPhase) returns EchoTally
	return match phase 'weight'
		idle gives 1
		warming gives 2
		running gives 3
		cooling gives 4
	end 'weight'
end 'echoPhaseWeight'

function echoShapes(seed EchoTally) returns EchoTally
	var shapes = EchoShapeArray.create()
	shapes.push(EchoShape.circle(seed mod 50))
	shapes.push(EchoShape.square(seed mod 40))
	shapes.push(EchoShape.strip(seed mod 30, height: seed mod 20))
	shapes.push(EchoShape.empty)

	var total = 0 as EchoTally

	for shape in shapes 'eachShape'
		total = (total + echoArea(shape)) mod 100000
	end 'eachShape'

	return total
end 'echoShapes'

function echoBoxes(seed EchoTally) returns EchoTally
	var text = EchoTextBox.create("first {seed}")
	text.add("second {seed}")

	var tallies = EchoTallyBox.create(seed mod 100)
	tallies.add(seed mod 7)
	tallies.add(seed mod 11)

	return text.size() + tallies.size()
end 'echoBoxes'

function echoLedger(seed EchoTally) returns EchoTally
	var ledger = EchoLedger.create()

	for color in EchoColor.allCases 'eachColor'
		var record = EchoRecord.create("{color.name} {seed}", weight: (seed + color.ordinal) mod 1000, color: color)
		record.sample(seed mod 13)
		ledger.enter(record)
	end 'eachColor'

	return ledger.warmCount() + ledger.heaviest()
end 'echoLedger'

module function echoScore(seed EchoTally) returns EchoTally
	var score = 0 as EchoTally

	for phase in EchoPhase.allCases 'eachPhase'
		score = (score + echoPhaseWeight(phase)) mod 100000
	end 'eachPhase'

	score = (score + echoShapes(seed)) mod 100000
	score = (score + echoBoxes(seed)) mod 100000
	return (score + echoLedger(seed)) mod 100000
end 'echoScore'
