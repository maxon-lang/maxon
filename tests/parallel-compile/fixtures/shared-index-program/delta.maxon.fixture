module typealias DeltaTally = int(0 to 1000000)
typealias DeltaTallyArray = Array with DeltaTally
typealias DeltaLabelMap = Map with (String, ElementIndex)
typealias DeltaShapeArray = Array with DeltaShape

enum DeltaColor
	red
	green
	blue
	amber
	violet
end 'DeltaColor'

enum DeltaPhase
	idle = 10
	warming = 20
	running = 30
	cooling = 40
end 'DeltaPhase'

union DeltaShape
	circle(radius DeltaTally)
	square(side DeltaTally)
	strip(width DeltaTally, height DeltaTally)
	empty
end 'DeltaShape'

type DeltaBox uses Element
	typealias Items = Array with Element

	var items as Items

	static function create(first Element) returns Self
		var items = Items.create()
		items.push(first)
		return Self{items: items}
	end 'create'

	function add(item Element)
		items.push(item)
	end 'add'

	function size() returns DeltaTally
		return items.count()
	end 'size'
end 'DeltaBox'

typealias DeltaTextBox = DeltaBox with String
typealias DeltaTallyBox = DeltaBox with DeltaTally

type DeltaRecord
	var label as String
	var weight as DeltaTally
	var color as DeltaColor
	var samples as DeltaTallyArray

	static function create(label String, weight DeltaTally, color DeltaColor) returns Self
		var samples = DeltaTallyArray.create()
		samples.push(weight)
		return Self{label: label, weight: weight, color: color, samples: samples}
	end 'create'

	function sample(value DeltaTally)
		samples.push(value mod 1000)
	end 'sample'

	function total() returns DeltaTally
		var sum = 0 as DeltaTally

		for value in samples 'eachSample'
			sum = (sum + value) mod 100000
		end 'eachSample'

		return sum
	end 'total'

	function isWarm() returns bool
		return match color 'warmth'
			red or
				amber gives true
			green or
				blue or
				violet gives false
		end 'warmth'
	end 'isWarm'

	function heft() returns DeltaTally
		return weight
	end 'heft'

	function describe() returns String
		return "{label}:{weight}:{total()}"
	end 'describe'
end 'DeltaRecord'

typealias DeltaRecordArray = Array with DeltaRecord

type DeltaLedger
	var records as DeltaRecordArray
	var index as DeltaLabelMap

	static function create() returns Self
		return Self{records: DeltaRecordArray.create(), index: DeltaLabelMap.create()}
	end 'create'

	function enter(record DeltaRecord)
		index.upsert(record.describe(), value: records.count())
		records.push(record)
	end 'enter'

	function warmCount() returns DeltaTally
		var warm = 0 as DeltaTally

		for record in records 'eachRecord'
			if record.isWarm() 'warm'
				warm = warm + 1
			end 'warm'
		end 'eachRecord'

		return warm
	end 'warmCount'

	function heaviest() returns DeltaTally
		var heaviest = 0 as DeltaTally

		for record in records 'eachRecord'
			let heft = record.heft()
			heaviest = heft if heft > heaviest else heaviest
		end 'eachRecord'

		return heaviest
	end 'heaviest'
end 'DeltaLedger'

function deltaArea(shape DeltaShape) returns DeltaTally
	return match shape 'area'
		circle(radius) gives (radius * radius * 3) mod 100000
		square(side) gives (side * side) mod 100000
		strip(width, height) gives (width * height) mod 100000
		empty gives 0
	end 'area'
end 'deltaArea'

function deltaPhaseWeight(phase DeltaPhase) returns DeltaTally
	return match phase 'weight'
		idle gives 1
		warming gives 2
		running gives 3
		cooling gives 4
	end 'weight'
end 'deltaPhaseWeight'

function deltaShapes(seed DeltaTally) returns DeltaTally
	var shapes = DeltaShapeArray.create()
	shapes.push(DeltaShape.circle(seed mod 50))
	shapes.push(DeltaShape.square(seed mod 40))
	shapes.push(DeltaShape.strip(seed mod 30, height: seed mod 20))
	shapes.push(DeltaShape.empty)

	var total = 0 as DeltaTally

	for shape in shapes 'eachShape'
		total = (total + deltaArea(shape)) mod 100000
	end 'eachShape'

	return total
end 'deltaShapes'

function deltaBoxes(seed DeltaTally) returns DeltaTally
	var text = DeltaTextBox.create("first {seed}")
	text.add("second {seed}")

	var tallies = DeltaTallyBox.create(seed mod 100)
	tallies.add(seed mod 7)
	tallies.add(seed mod 11)

	return text.size() + tallies.size()
end 'deltaBoxes'

function deltaLedger(seed DeltaTally) returns DeltaTally
	var ledger = DeltaLedger.create()

	for color in DeltaColor.allCases 'eachColor'
		var record = DeltaRecord.create("{color.name} {seed}", weight: (seed + color.ordinal) mod 1000, color: color)
		record.sample(seed mod 13)
		ledger.enter(record)
	end 'eachColor'

	return ledger.warmCount() + ledger.heaviest()
end 'deltaLedger'

module function deltaScore(seed DeltaTally) returns DeltaTally
	var score = 0 as DeltaTally

	for phase in DeltaPhase.allCases 'eachPhase'
		score = (score + deltaPhaseWeight(phase)) mod 100000
	end 'eachPhase'

	score = (score + deltaShapes(seed)) mod 100000
	score = (score + deltaBoxes(seed)) mod 100000
	return (score + deltaLedger(seed)) mod 100000
end 'deltaScore'
