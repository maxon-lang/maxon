// Forty distinct functions, each with a loop and a few live values, so the register allocator sees
// more functions than any host has processors and a pool of one worker per processor is the full pool.
//
// They form a CALL CHAIN and the last one calls the stdlib: a call-free body of a few ops is a leaf the
// inliner folds into its caller, after which the allocator sees one function and no pool at all.

function f01(seed Integer) returns Integer
	var acc = seed
	var step = 1
	var i = 0
	while i < 9 'loop'
		acc = acc + step * 1
		step = step + 1
		i = i + 1
	end 'loop'
	return acc + f02(acc)
end 'f01'

function f02(seed Integer) returns Integer
	var acc = seed
	var step = 1
	var i = 0
	while i < 10 'loop'
		acc = acc + step * 2
		step = step + 1
		i = i + 1
	end 'loop'
	return acc + f03(acc)
end 'f02'

