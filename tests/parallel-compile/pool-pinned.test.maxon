// pool-pinned.test.maxon — `MAXON_MAX_PROCS=1` resolves the scheduler to one processor, and the pool
// built over one processor is one worker. This is the case that proves the count is the SCHEDULER's
// resolved count and not the machine's: the machine has not changed between this file and its neighbour.

test 'MAXON_MAX_PROCS=1 makes a pool of one worker'
	let staged = stagedProgram("pool-program", caseLabel: "pool-pinned")

	var arguments = StringArray.create()
	arguments.push(CodegenDebugLogFlag)
	let run = spawnBuild(staged, label: "single-processor", extraArguments: arguments, singleProcessor: true)

	let observedExit = run.exitCode()
	try Expect.equal(observedExit, expected: 0, message: "the pool program did not compile pinned to one processor. It wrote to stderr: {run.stderr}")

	let needle = singleProcessorPoolNeedle()
	try Expect.contains(run.stderr, needle: needle, message: "`{CodegenDebugLogFlag}` under MAXON_MAX_PROCS=1 did not report a pool of one worker over one processor. Either the pool is sized from the machine rather than from the scheduler's resolved count, or the marker never reached the child. It wrote to stderr: {run.stderr}")
end 'MAXON_MAX_PROCS=1 makes a pool of one worker'
