// byte-identical.maxtest — the executable the allocator emits does not depend on how many workers
// allocated it.
//
// Two compiles in one file is the budget `test-command/reserved-name-refused.maxtest` prices against
// the 5,000 ms deadline; a third case here would need its own file.

test 'the executable is byte-identical at one processor and at the default'
	let staged = stagedProgram("pool-program", caseLabel: "byte-identical")
	requireIdenticalImagesAcrossProcessorCounts(staged, programName: "pool program")
end 'the executable is byte-identical at one processor and at the default'
