// front-end-pool-pinned.test.maxon — `MAXON_MAX_PROCS=1` resolves the scheduler to one processor, and the
// front end's pool over one processor is one worker however many files it parses. The fixture and the stdlib
// span many files, so a pool sized from the file count or from the machine is red here.

test 'MAXON_MAX_PROCS=1 makes a front end of one worker'
	let staged = stagedProgram("front-end-program", caseLabel: "front-end-pool-pinned")

	var arguments = StringArray.create()
	arguments.push(CompilerDebugLogFlag)
	let run = spawnBuild(staged, label: "single-processor", extraArguments: arguments, singleProcessor: true, wholeDirectory: true)

	let observedExit = run.exitCode() as AssertedInt
	try Expect.equal(observedExit, expected: 0, message: "the front-end program did not compile pinned to one processor. It wrote to stderr: {run.stderr}")

	let needle = frontEndPoolNeedleSingleProcessor()
	try Expect.contains(run.stderr, needle: needle, message: "`{CompilerDebugLogFlag}` under MAXON_MAX_PROCS=1 did not report a front end of one worker over one processor. Either the front end does not report its pool, it is sized from the machine or the file count rather than from the scheduler's resolved count, or the marker never reached the child. It wrote to stderr: {run.stderr}")
end 'MAXON_MAX_PROCS=1 makes a front end of one worker'
