let FirstColdCacheDirName = "run-cache-a"
let SecondColdCacheDirName = "run-cache-b"

test 'two cold compiles report identical memory'
	let staged = stagedProgram("uneven-program", caseLabel: "identical-cold-compiles-report-identical-memory")

	let first = builtMetricsTable(staged, label: "first cold", runCacheDirName: FirstColdCacheDirName)
	let second = builtMetricsTable(staged, label: "second cold", runCacheDirName: SecondColdCacheDirName)

	requireIdenticalMemory(first, second: second, kind: "cold")
end 'two cold compiles report identical memory'
