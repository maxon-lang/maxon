let RecheckCommandName = "verify-recheck"

test 'a recheck of a program whose directories declare a type and a binding of one name agrees with itself and clears an undone edit'
	let staged = stagedFixtureTree(FixturesDirName, stagingRootDir: StagingRootDirName, caseLabel: "a-program-with-top-level-names-two-directories-declare-rechecks-cleanly", fixture: "contested-names")
	let run = spawnCompiler([RecheckCommandName, staged.toString()], staged: staged, what: "`{RecheckCommandName}`")

	Expect.equal(run.exitCode(), expected: 0, message: "`{TestedCompilerStem} {RecheckCommandName}` exited {run.exitCode()} on a program whose directories `a` and `b` each declare a `Box` and a `counter`. It printed: {run.stdout} — and wrote to stderr: {run.stderr}")
end 'a recheck of a program whose directories declare a type and a binding of one name agrees with itself and clears an undone edit'
