// WarmRebuildHarness.maxon — the shared half every case under `tests/warmRebuild/` reaches for:
// running `verify-warm-rebuild` at a staged fixture.
//
// ⛔ **EVERYTHING THAT WOULD STOP A CASE RUNNING AT ALL PANICS RATHER THAN FAILING AN ASSERTION** — a missing
// compiler, an unspellable path, a spawn that never happened.
//
// ⛔ **THIS FILE'S PATHS ARE RELATIVE TO THE CHECKOUT ROOT**, the working directory a test binary inherits from
// `maxon test`; everything handed to the child is made absolute first.

let FixturesDirName = "tests/warmRebuild/fixtures"

let VerifyCommandName = "verify-warm-rebuild"
let RecheckCommandName = "verify-recheck"

// What the driver prints for the verdict over every property.
let VerdictPassLine = "verify-warm-rebuild: PASS"

let ImmutablePassLine = "PASS immutable:"

let CachePassLine = "PASS cache:"
let InvalidationBytesOnlyPassLine = "PASS invalidation: bytes-only edit re-parsed 1 file;"
let ParseHitsFailureLabel = "rebuild parse re-query hits (parseHits)"
let NotRunDeterminismLine = "NOT RUN determinism:"
let NotRunWarmLine = "NOT RUN warm:"
let NotRunLibraryReuseLine = "NOT RUN library reuse:"

// `<compiler> verify-warm-rebuild <staged>`, run in the staging tree.
function spawnVerifyOnly(staged FilePath) returns CollectedOutput
	return spawnCompiler([VerifyCommandName, staged.toString()], staged: staged, what: "`{VerifyCommandName}`")
end 'spawnVerifyOnly'

function spawnRecheck(staged FilePath) returns CollectedOutput
	return spawnCompiler([RecheckCommandName, staged.toString()], staged: staged, what: "`{RecheckCommandName}`")
end 'spawnRecheck'

function spawnVerify(staged FilePath) returns CollectedOutput throws TestFailure
	let run = spawnVerifyOnly(staged)

	try Expect.contains(run.stdout, needle: ImmutablePassLine, message: "`{TestedCompilerStem} {VerifyCommandName}` did not report the reused parse artifacts unchanged. It printed: {run.stdout} — and wrote to stderr: {run.stderr}")
	return run
end 'spawnVerify'
