let ContestedNamesWarmLine = "PASS warm:"
let ContestedNamesDeterminismLine = "PASS determinism:"
let ContestedNamesLibraryReuseLine = "PASS library reuse:"

test 'a bytes-only edit rebuilds warm to what a cold compile emits in a program whose directories declare a type and a binding of one name'
	let staged = stagedFixtureTree(FixturesDirName, stagingRootDir: StagingRootDirName, caseLabel: "a-program-with-top-level-names-two-directories-declare-rebuilds-warm", fixture: "contested-names")
	let run = spawnVerify(staged)

	Expect.contains(run.stdout, needle: ContestedNamesDeterminismLine, message: "`{TestedCompilerStem} {VerifyCommandName}` did not report two cold compiles agreeing on a program whose directories `a` and `b` each declare a `Box` and a `counter`. It printed: {run.stdout} — and wrote to stderr: {run.stderr}")
	Expect.contains(run.stdout, needle: ContestedNamesWarmLine, message: "`{TestedCompilerStem} {VerifyCommandName}` did not report the warm-equals-cold property as holding on a program whose directories `a` and `b` each declare a `Box` and a `counter`. It printed: {run.stdout} — and wrote to stderr: {run.stderr}")
	Expect.contains(run.stdout, needle: ContestedNamesLibraryReuseLine, message: "`{TestedCompilerStem} {VerifyCommandName}` did not report every library parse reused across programs for a program whose directories `a` and `b` each declare a `Box` and a `counter`. It printed: {run.stdout} — and wrote to stderr: {run.stderr}")
end 'a bytes-only edit rebuilds warm to what a cold compile emits in a program whose directories declare a type and a binding of one name'
