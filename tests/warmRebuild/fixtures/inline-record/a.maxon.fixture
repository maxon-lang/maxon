typealias Channel = int(0 to 255)

type Pixel
	let red as Channel
	let green as Channel
	let blue as Channel

	static function create(red Channel, green Channel, blue Channel) returns Pixel
		return Self{red: red, green: green, blue: blue}
	end 'create'

	function brightness() returns Channel
		return self.red
	end 'brightness'
end 'Pixel'
