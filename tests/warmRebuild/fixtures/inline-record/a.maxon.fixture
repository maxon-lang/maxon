module typealias Channel = int(0 to 255)

module type Pixel
	module let red as Channel
	module let green as Channel
	module let blue as Channel

	module static function create(red Channel, green Channel, blue Channel) returns Pixel
		return Self{red: red, green: green, blue: blue}
	end 'create'

	module function brightness() returns Channel
		return self.red
	end 'brightness'
end 'Pixel'
