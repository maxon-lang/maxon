// The last file of the warm-rebuild fixture, and the one the gate edits. Its own read through a concrete holder
// mints the cell's instance at a DIFFERENT argument, so a re-parse against a rebuilt index can claim the id the
// first file's reused artifact holds.
typealias Score = int(0 to 1000)

typealias ScoreHolder = Holder with Score

function main() returns ExitCode
	let holder = ScoreHolder.create(3)
	let score = holder.cell.value
	return (score + (textLength() as Score)) as ExitCode
end 'main'
