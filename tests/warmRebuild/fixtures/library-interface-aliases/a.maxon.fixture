module typealias SlotIndex = int(0 to 1000) implements ElementIndex
module typealias Distance = float(2.2250738585072014e-308 to f64.max) implements FullRangeFloat

module type Tile
	module let slot as SlotIndex
	module let reach as Distance

	module static function create(slot SlotIndex, reach Distance) returns Tile
		return Self{slot: slot, reach: reach}
	end 'create'
end 'Tile'

module typealias TileArray = Array with Tile

module function farthest(tiles TileArray) returns Distance
	var best = 2.5 as Distance

	for tile in tiles 'eachTile'
		if tile.reach > best 'aFartherOne'
			best = tile.reach
		end 'aFartherOne'
	end 'eachTile'

	return best
end 'farthest'
