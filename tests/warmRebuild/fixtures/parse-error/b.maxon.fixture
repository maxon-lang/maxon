function doubledTotalOf(values TallyArray) returns Tally
	let total = totalOf(values) *
	return total
end 'doubledTotalOf'

function main() returns ExitCode
	var values = TallyArray.create(0)
	values.push(2)
	values.push(3)
	let report = "total {totalOf(values)}"
	return report.count() as ExitCode
end 'main'
