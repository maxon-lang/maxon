// The first file of the filed-type fixture. No declaration names an instance of `Box`, so the declarations alone
// say it is uninstantiated; `pack` stores a borrowed `T` into a tuple, which needs the layout descriptor only an
// instantiated type reserves. The front end files `Box` once a parse instantiates it.
module typealias Tally = int(0 to 1000)

module type Box uses T
	export let v as T

	module static function create(v T) returns Self
		return Self{v: v}
	end 'create'

	module function pack() returns Tally
		let t = (self.v, 1)
		return t.1
	end 'pack'
end 'Box'
