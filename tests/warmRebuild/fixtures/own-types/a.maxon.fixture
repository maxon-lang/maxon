typealias Tally = int(0 to 1000)
typealias Rank = int(0 to 9)

type Particle
	let weight as Tally
	let rank as Rank

	static function create(weight Tally, rank Rank) returns Particle
		return Self{weight: weight, rank: rank}
	end 'create'

	function heavy() returns bool
		return self.weight > 500 and self.rank > 5
	end 'heavy'
end 'Particle'

typealias ParticleArray = Array with Particle
typealias LabelMap = Map with (String, Tally)

enum Phase
	solid
	liquid
	gas
end 'Phase'

union Reading
	count(value Tally)
	missing
end 'Reading'

function totalWeight(particles ParticleArray) returns Tally
	var total = 0 as Tally

	for particle in particles 'eachParticle'
		if particle.heavy() 'aHeavyOne'
			total = total + 1
		end 'aHeavyOne'
	end 'eachParticle'

	return total
end 'totalWeight'
