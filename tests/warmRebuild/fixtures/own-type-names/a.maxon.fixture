typealias Voltage = int(0 to 480)
typealias Channel = int(0 to 15)

enum Waveform
	sine
	square
	sawtooth
end 'Waveform'

type Signal
	let volts as Voltage
	let channel as Channel
	let shape as Waveform

	static function create(volts Voltage, channel Channel, shape Waveform) returns Signal
		return Self{volts: volts, channel: channel, shape: shape}
	end 'create'

	function isLoud() returns bool
		return self.volts > 240
	end 'isLoud'
end 'Signal'

type Probe
	let reading as Voltage

	static function create(reading Voltage) returns Probe
		return Self{reading: reading}
	end 'create'
end 'Probe'

union Capture
	signal(value Signal)
	silence
end 'Capture'

typealias SignalArray = Array with Signal
typealias ProbeArray = Array with Probe
typealias ChannelMap = Map with (String, Channel)

function loudCount(signals SignalArray) returns Voltage
	var count = 0 as Voltage

	for signal in signals 'eachSignal'
		if signal.isLoud() 'aLoudOne'
			count = count + 1
		end 'aLoudOne'
	end 'eachSignal'

	return count
end 'loudCount'
