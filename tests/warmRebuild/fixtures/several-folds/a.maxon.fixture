module typealias Tally = int(0 to 1000)

module type Box uses T
	export let v as T

	module static function create(v T) returns Self
		return Self{v: v}
	end 'create'

	module function pack() returns Tally
		let t = (self.v, 1)
		return t.1
	end 'pack'
end 'Box'

module function doubled(n Tally) returns Tally
	return n + n
end 'doubled'

module function broken() returns Tally
	let total = doubled(2) *
	return total
end 'broken'
