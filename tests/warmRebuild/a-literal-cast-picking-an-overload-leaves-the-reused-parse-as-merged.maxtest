test 'a literal cast that picks an overload leaves the parse a warm compile reuses as the merge left it'
	let staged = stagedFixtureTree(FixturesDirName, stagingRootDir: StagingRootDirName, caseLabel: "a-literal-cast-picking-an-overload-leaves-the-reused-parse-as-merged", fixture: "literal-casts")
	let run = spawnVerify(staged)

	Expect.contains(run.stdout, needle: VerdictPassLine, message: "`{TestedCompilerStem} {VerifyCommandName}` did not pass as a whole. It printed: {run.stdout} — and wrote to stderr: {run.stderr}")
	Expect.equal(run.exitCode(), expected: 0, message: "`{TestedCompilerStem} {VerifyCommandName}` exited {run.exitCode()}. It wrote to stderr: {run.stderr}")
end 'a literal cast that picks an overload leaves the parse a warm compile reuses as the merge left it'
