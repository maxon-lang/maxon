// The whole passing report, and nothing else: two tests, one file, both green.
//
// ⚠ THE SUBJECT LIVES IN THIS FILE RATHER THAN IN AN ORDINARY `pricing.maxon` SIBLING, and that is
// the corpus's one structural rule — see the `no fixture holds a source an ordinary build would
// sweep up` test for the measurement behind it. Nothing else about this fixture depends on it: an
// ordinary declaration is legal in a `*.test.maxon` file, only the reverse is refused.
typealias Cents = int(0 to i64.max)

function totalCost(unitPrice Cents, quantity Cents) returns Cents
	let gross = unitPrice * quantity
	if quantity < 10 'noDiscount'
		return gross
	end 'noDiscount'

	return gross - gross / 10
end 'totalCost'

test 'a small order pays full price'
	try Expect.equal(totalCost(250, quantity: 4), expected: 1000)
end 'a small order pays full price'

test 'ten items take the bulk discount'
	try Expect.equal(totalCost(250, quantity: 10), expected: 2250)
end 'ten items take the bulk discount'
