typealias Tally = int(0 to 1000)

let DoubledInput = 4
let SupportAnswer = 42
let UnusedSupportAnswer = 43

function doubled(n Tally) returns Tally
	return n * 2
end 'doubled'

function leftover() returns ExitCode
	return 1
end 'leftover'

function supportAnswer() returns ExitCode
	doubled(DoubledInput)
	return SupportAnswer
end 'supportAnswer'

export function unusedSupportAnswer() returns ExitCode
	return UnusedSupportAnswer
end 'unusedSupportAnswer'
