let HeldFileName = "held.txt"

test 'a test that panics holding a scratch file'
	let outside = TestScratch.outsideCheckout()
	let inside = TestScratch.insideProject()
	File.writeText(outside.join(HeldFileName), content: "held\n")
	File.writeText(inside.join(HeldFileName), content: "held\n")
	printError("outside-scratch: {outside.toString()}\n")
	printError("project-scratch: {inside.toString()}\n")
	panic("the test dies holding a scratch file")
end 'a test that panics holding a scratch file'
