let StrayFileName = "stray.txt"
let StrayProjectFileName = "stray-in-project.txt"

test 'a test that fills its scratch directories and passes'
	let outside = TestScratch.outsideCheckout()
	let inside = TestScratch.insideProject()
	File.writeText(outside.join(StrayFileName), content: "left behind\n")
	File.writeText(inside.join(StrayProjectFileName), content: "left behind\n")
end 'a test that fills its scratch directories and passes'
