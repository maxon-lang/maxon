// A test discovery does find, so the refusal this case pins cannot be mistaken for a project that
// declares no tests at all.
typealias Length = int(0 to i64.max)

function perimeter(side Length) returns Length
	return side * 4
end 'perimeter'

test 'a square has four equal sides'
	Expect.equal(perimeter(3) as AssertedInt, expected: 12)
end 'a square has four equal sides'
