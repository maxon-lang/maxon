enum ParseError implements Error
	unreadable
end 'ParseError'

test 'a number that does not parse throws out of the test body'
	Expect.equal(ParseError.unreadable.name, expected: "unreadable")
	let value = int.fromString("seven")
	Expect.equal(value, expected: 7)
end 'a number that does not parse throws out of the test body'
