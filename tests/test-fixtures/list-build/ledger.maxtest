typealias Balance = int(0 to i64.max)

function deposit(balance Balance, amount Balance) returns Balance
	return balance + amount
end 'deposit'

test 'a deposit adds to the balance'
	print("ran: a deposit adds to the balance\n")
	try Expect.equal(deposit(10, amount: 5) as AssertedInt, expected: 15)
end 'a deposit adds to the balance'

test 'a deposit is counted twice'
	print("ran: a deposit is counted twice\n")
	try Expect.equal(deposit(10, amount: 5) as AssertedInt, expected: 20)
end 'a deposit is counted twice'
