typealias Length = int(0 to i64.max)

function perimeter(side Length, sides Length) returns Length
	return side * sides
end 'perimeter'

test 'a square has four equal sides'
	Expect.equal(perimeter(3, sides: 4) as AssertedInt, expected: 12)
end 'a square has four equal sides'

test 'a triangle has three sides'
	Expect.equal(perimeter(3, sides: 3) as AssertedInt, expected: 9)
end 'a triangle has three sides'

test 'the unselected one would FAIL if the filters let it run'
	Expect.equal(perimeter(3, sides: 5) as AssertedInt, expected: 99)
end 'the unselected one would FAIL if the filters let it run'
