// The SECOND file. Its name sorts after `loud.maxtest`, which is also the order the expectation
// carries: a report whose file order depended on the filesystem could not be pinned byte for byte.
function whisper(text String) returns String
	return text.toLower()
end 'whisper'

test 'whispering lower-cases'
	Expect.equal(whisper("HI"), expected: "hi")
end 'whispering lower-cases'
