// The FIRST of this fixture's two test files. Two files rather than two tests in one, because what
// is pinned here is the per-file header and the `N tests across 2 files.` line — neither of which a
// single-file run can show.
function shout(text String) returns String
	return text.toUpper()
end 'shout'

test 'shouting upper-cases'
	try Expect.equal(shout("hi"), expected: "HI")
end 'shouting upper-cases'
