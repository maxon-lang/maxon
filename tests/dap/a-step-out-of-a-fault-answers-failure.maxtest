let FaultStepOutCaseLabel = "a-step-out-of-a-fault-answers-failure"
let FaultIsTerminalText = "fault-is-terminal"

type FaultStepOutSession implements DapSession
	let executable as FilePath
	export var stopReason as String
	export var stepOutAnswered as bool
	export var stepOutRefusal as String
	export var nextAnswered as bool
	export var nextRefusal as String
	export var framesAfterRefusals as StringArray

	static function create(executable FilePath) returns FaultStepOutSession
		return Self{executable: executable, stopReason: "", stepOutAnswered: true, stepOutRefusal: "", nextAnswered: true, nextRefusal: "", framesAfterRefusals: StringArray.create()}
	end 'create'

	function drive(client DapClient) throws DapClientError
		_ = try client.request(InitializeCommand, argumentsJson: dapInitializeArguments())
		_ = try client.request(LaunchCommand, argumentsJson: dapLaunchArguments(self.executable))
		_ = try client.awaitEvent(InitializedEvent)
		_ = try client.request(ConfigurationDoneCommand)

		let stopped = try client.awaitEvent(StoppedEvent)
		self.stopReason = dapBodyString(stopped, key: "reason")

		let threadId = dapBodyNumber(stopped, key: "threadId")
		let steppedOut = try client.request(StepOutCommand, argumentsJson: dapThreadArguments(threadId))
		self.stepOutAnswered = dapSuccess(steppedOut)
		self.stepOutRefusal = dapRefusal(steppedOut) if not self.stepOutAnswered else ""

		let steppedOver = try client.request(NextCommand, argumentsJson: dapThreadArguments(threadId))
		self.nextAnswered = dapSuccess(steppedOver)
		self.nextRefusal = dapRefusal(steppedOver) if not self.nextAnswered else ""

		self.framesAfterRefusals = dapStackFrameNames(try client.request(StackTraceCommand, argumentsJson: dapThreadArguments(threadId)))

		_ = try client.request(DisconnectCommand)
	end 'drive'
end 'FaultStepOutSession'

test 'a stepOut and a next from a fault in a callee answer failure and leave the stop walkable'
	let staged = dapStagedFixture(FaultStepOutCaseLabel, fixture: FaultCalleeFixtureName)
	var session = FaultStepOutSession.create(dapBuildFixture(staged))
	try dapRunSession(session, completing: "refuse both walks from the fault and walk the stop")

	try Expect.equal(session.stopReason, expected: ExceptionReason, message: "the program's first stop is its fault; it said `{session.stopReason}`")
	try Expect.isFalse(session.stepOutAnswered, message: "⛔ A FAULT IS TERMINAL FOR `{StepOutCommand}` TOO. It plants a return point in the caller and resumes, and the resumed fault ends the program; it must answer `success: false` instead")
	try Expect.contains(session.stepOutRefusal, needle: FaultIsTerminalText, message: "the refused `{StepOutCommand}` names why; it said `{session.stepOutRefusal}`")
	try Expect.isFalse(session.nextAnswered, message: "a `{NextCommand}` from the fault is refused as well")
	try Expect.contains(session.nextRefusal, needle: FaultIsTerminalText, message: "the refused `{NextCommand}` names why; it said `{session.nextRefusal}`")
	try Expect.isFalse(session.framesAfterRefusals.count() == 0, message: "the refused walks leave the program stopped at its fault, so `{StackTraceCommand}` still walks it; it answered {dapRendered(session.framesAfterRefusals)}")
end 'a stepOut and a next from a fault in a callee answer failure and leave the stop walkable'
