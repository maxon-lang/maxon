let ConsoleBreakpointCaseLabel = "a-console-breakpoint-outlives-the-clients-clear"
let LoopAnchor = "inner-loop"
let ReplContext = "repl"
let NoFrame = 0

type ConsoleBreakpointSession implements DapSession
	let executable as FilePath
	let source as FilePath
	let anchored as SourceLine
	export var stopReason as String
	export var stoppedAt as DapNumber

	static function create(executable FilePath, source FilePath, anchored SourceLine) returns ConsoleBreakpointSession
		return Self{executable: executable, source: source, anchored: anchored, stopReason: "", stoppedAt: 0}
	end 'create'

	function drive(client DapClient) throws DapClientError
		_ = try client.request(InitializeCommand, argumentsJson: dapInitializeArguments())
		_ = try client.request(LaunchCommand, argumentsJson: dapLaunchArguments(self.executable))
		_ = try client.awaitEvent(InitializedEvent)
		_ = try client.request(SetBreakpointsCommand, argumentsJson: dapSetBreakpointsArguments(self.source, line: self.anchored))
		_ = try client.request(EvaluateCommand, argumentsJson: dapEvaluateArguments("break {self.source.filename()}:{self.anchored}", context: ReplContext, frameId: NoFrame))
		_ = try client.request(SetBreakpointsCommand, argumentsJson: dapClearBreakpointsArguments(self.source))
		_ = try client.request(ConfigurationDoneCommand)

		let stopped = try client.awaitEvent(StoppedEvent)
		self.stopReason = dapBodyString(stopped, key: "reason")

		let frames = try client.request(StackTraceCommand, argumentsJson: dapThreadArguments(dapBodyNumber(stopped, key: "threadId")))
		self.stoppedAt = dapFrameNumberAt(dapStackFrameLines(frames), frame: 0)

		_ = try client.request(DisconnectCommand)
	end 'drive'
end 'ConsoleBreakpointSession'

test 'a breakpoint typed in the debug console is not cleared when the editor clears its own on the same line'
	let staged = dapStagedFixture(ConsoleBreakpointCaseLabel, fixture: SteppingFixtureName)
	let anchored = dapAnchorLine(staged, anchor: LoopAnchor)
	var session = ConsoleBreakpointSession.create(dapBuildFixture(staged), source: dapStagedSource(staged), anchored: anchored)
	try dapRunSession(session, completing: "stop at the console's breakpoint after the editor cleared its own")

	try Expect.equal(session.stopReason, expected: BreakpointReason, message: "⛔ THE EDITOR'S `{SetBreakpointsCommand}` REPLACES THE EDITOR'S OWN BREAKPOINTS AND NO OTHERS. The console armed the same line by another spelling, and clearing the editor's must leave the console's standing; the stop said `{session.stopReason}`")
	try Expect.equal(session.stoppedAt as AssertedInt, expected: anchored as AssertedInt, message: "the stop is on the console's line")
end 'a breakpoint typed in the debug console is not cleared when the editor clears its own on the same line'
