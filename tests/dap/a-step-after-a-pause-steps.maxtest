let StepAfterPauseCaseLabel = "a-step-after-a-pause-steps"
let GrindFunctionName = "grind"
let GrindingSignal = "grinding"
let PausedThreadId = 1 as DapNumber

type StepAfterPauseSession implements DapSession
	let executable as FilePath
	export var pauseReason as String
	export var nextReason as String
	export var framesAfterNext as StringArray
	export var stepInReason as String
	export var framesAfterStepIn as StringArray

	static function create(executable FilePath) returns StepAfterPauseSession
		return Self{executable: executable, pauseReason: "", nextReason: "", framesAfterNext: StringArray.create(), stepInReason: "", framesAfterStepIn: StringArray.create()}
	end 'create'

	function drive(client DapClient) throws DapClientError
		_ = try client.request(InitializeCommand, argumentsJson: dapInitializeArguments())
		_ = try client.request(LaunchCommand, argumentsJson: dapLaunchArguments(self.executable))
		_ = try client.awaitEvent(InitializedEvent)
		_ = try client.request(ConfigurationDoneCommand)
		_ = try client.awaitOutputContaining(GrindingSignal)
		_ = try client.request(PauseCommand, argumentsJson: dapThreadArguments(PausedThreadId))

		let paused = try client.awaitEvent(StoppedEvent)
		self.pauseReason = dapBodyString(paused, key: "reason")

		let threadId = dapBodyNumber(paused, key: "threadId")
		_ = try client.request(NextCommand, argumentsJson: dapThreadArguments(threadId))
		self.nextReason = dapBodyString(try client.awaitEvent(StoppedEvent), key: "reason")
		self.framesAfterNext = dapStackFrameNames(try client.request(StackTraceCommand, argumentsJson: dapThreadArguments(threadId)))

		_ = try client.request(StepInCommand, argumentsJson: dapThreadArguments(threadId))
		self.stepInReason = dapBodyString(try client.awaitEvent(StoppedEvent), key: "reason")
		self.framesAfterStepIn = dapStackFrameNames(try client.request(StackTraceCommand, argumentsJson: dapThreadArguments(threadId)))

		_ = try client.request(DisconnectCommand)
	end 'drive'
end 'StepAfterPauseSession'

test 'next and stepIn from a pause stop each stop as a step in the paused frame'
	let staged = dapStagedFixture(StepAfterPauseCaseLabel, fixture: SpinSignalFixtureName)
	var session = StepAfterPauseSession.create(dapBuildFixture(staged))
	try dapRunSession(session, completing: "complete the steps after the pause")

	try Expect.equal(session.pauseReason, expected: PauseReason, message: "the first stop is the pause; it said `{session.pauseReason}`")
	try Expect.equal(session.nextReason, expected: StepReason, message: "⛔ A `{NextCommand}` FROM A PAUSE STOP MUST STEP, not let the program run on; the stop said `{session.nextReason}`")
	try Expect.equal(dapFrameNameAt(session.framesAfterNext, frame: 0), expected: GrindFunctionName, message: "`{NextCommand}` stays in the loop the pause interrupted; it landed in {dapRendered(session.framesAfterNext)}")
	try Expect.equal(session.stepInReason, expected: StepReason, message: "a `{StepInCommand}` after it is a step too; the stop said `{session.stepInReason}`")
	try Expect.equal(dapFrameNameAt(session.framesAfterStepIn, frame: 0), expected: GrindFunctionName, message: "`{StepInCommand}` in a loop that calls nothing stays in it; it landed in {dapRendered(session.framesAfterStepIn)}")
end 'next and stepIn from a pause stop each stop as a step in the paused frame'
