let PauseCaseLabel = "pause-stops-a-spinning-program"

type PauseSession implements DapSession
	let executable as FilePath
	export var pauseAnswered as bool
	export var stopReason as String
	export var frameNames as StringArray

	static function create(executable FilePath) returns PauseSession
		return Self{executable: executable, pauseAnswered: false, stopReason: "", frameNames: StringArray.create()}
	end 'create'

	function drive(client DapClient) throws DapClientError
		_ = try client.request(InitializeCommand, argumentsJson: dapInitializeArguments())
		_ = try client.request(LaunchCommand, argumentsJson: dapLaunchArguments(self.executable))
		_ = try client.awaitEvent(InitializedEvent)
		_ = try client.request(ConfigurationDoneCommand)

		let paused = try client.request(PauseCommand, argumentsJson: dapThreadArguments(FirstThreadId))
		self.pauseAnswered = dapSuccess(paused)

		let stopped = try client.awaitEvent(StoppedEvent)
		self.stopReason = dapBodyString(stopped, key: "reason")

		let threadId = dapBodyNumber(stopped, key: "threadId")
		self.frameNames = dapStackFrameNames(try client.request(StackTraceCommand, argumentsJson: dapThreadArguments(threadId)))

		_ = try client.request(DisconnectCommand)
	end 'drive'
end 'PauseSession'

test 'pause stops a program that would otherwise never stop'
	let staged = dapStagedFixture(PauseCaseLabel, fixture: SpinFixtureName)
	var session = PauseSession.create(dapBuildFixture(staged))
	try dapRunSession(session, completing: "complete")

	try Expect.isTrue(session.pauseAnswered, message: "`{PauseCommand}` must answer its own request successfully, before the stop arrives")
	try Expect.equal(session.stopReason, expected: PauseReason, message: "an editor shows a different reason for a pause than for a breakpoint, and nothing in this program can produce any other stop; it said `{session.stopReason}`")
	try Expect.isFalse(session.frameNames.count() == 0, message: "a paused program must be walkable like any other stop, or the editor's call stack is empty exactly when someone reached for pause to find out where they are")
end 'pause stops a program that would otherwise never stop'

// A program with no scheduler is thread `1`; no stop has named a thread yet when the pause is sent.
let FirstThreadId = 1 as DapNumber
