let TerminatedCaseLabel = "threads-after-terminate-answers-empty"
let OuterCallAnchor = "outer-call"
let NeverLaunchedWording = "launch"

type TerminatedSession implements DapSession
	let executable as FilePath
	let source as FilePath
	let anchored as SourceLine
	export var beforeLaunch as JsonDoc
	export var terminated as bool
	export var after as JsonDoc
	export var frames as JsonDoc

	static function create(executable FilePath, source FilePath, anchored SourceLine) returns TerminatedSession
		return Self{executable: executable, source: source, anchored: anchored, beforeLaunch: JsonDoc.create(), terminated: false, after: JsonDoc.create(), frames: JsonDoc.create()}
	end 'create'

	function drive(client DapClient) throws DapClientError
		_ = try client.request(InitializeCommand, argumentsJson: dapInitializeArguments())

		self.beforeLaunch = try client.request(ThreadsCommand)

		_ = try client.request(LaunchCommand, argumentsJson: dapLaunchArguments(self.executable))
		_ = try client.awaitEvent(InitializedEvent)
		_ = try client.request(SetBreakpointsCommand, argumentsJson: dapSetBreakpointsArguments(self.source, line: self.anchored))
		_ = try client.request(ConfigurationDoneCommand)

		let stopped = try client.awaitEvent(StoppedEvent)
		let threadId = dapBodyNumber(stopped, key: "threadId")

		self.terminated = dapSuccess(try client.request(TerminateCommand))
		self.after = try client.request(ThreadsCommand)
		self.frames = try client.request(StackTraceCommand, argumentsJson: dapThreadArguments(threadId))

		_ = try client.request(DisconnectCommand)
	end 'drive'
end 'TerminatedSession'

test 'threads sent after a terminate answer an empty list, and only an adapter that never launched says so'
	let staged = dapStagedFixture(TerminatedCaseLabel, fixture: SteppingFixtureName)
	var session = TerminatedSession.create(dapBuildFixture(staged), source: dapStagedSource(staged), anchored: dapAnchorLine(staged, anchor: OuterCallAnchor))
	try dapRunSession(session, completing: "complete")

	try Expect.isFalse(dapSuccess(session.beforeLaunch), message: "the control: `{ThreadsCommand}` before any `{LaunchCommand}` is refused, because there is no program to have threads")
	try Expect.contains(dapRefusal(session.beforeLaunch), needle: NeverLaunchedWording, message: "the control: the refusal before a launch tells the client to send `{LaunchCommand}`")
	try Expect.isTrue(session.terminated, message: "`{TerminateCommand}` of a stopped program must be answered successfully")
	try Expect.isTrue(dapSuccess(session.after), message: "an editor asks for the threads late, after the session it stopped has ended; a program that was launched and has ended has no threads, which is an empty answer and not a refusal telling the client to launch. It answered {dapDescribed(session.after)}")
	try Expect.equal(dapListLength(session.after, key: ThreadsKey) as AssertedInt, expected: 0, message: "a terminated program has no threads")
	try Expect.isTrue(dapSuccess(session.frames), message: "`{StackTraceCommand}` after a terminate is answered, with no frames. It answered {dapDescribed(session.frames)}")
end 'threads sent after a terminate answer an empty list, and only an adapter that never launched says so'
