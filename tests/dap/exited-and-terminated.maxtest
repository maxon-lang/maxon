let ExitCaseLabel = "exited-and-terminated"

// Nonzero on purpose: a 0 cannot be told from an `exitCode` the adapter never filled in.
let HeaplessExitCode = 7 as DapNumber
let HotAnchor = "hot"

type ExitSession implements DapSession
	let executable as FilePath
	let source as FilePath
	let anchored as SourceLine
	export var stopReason as String
	export var continued as bool
	export var exitCode as DapNumber
	export var sawTerminated as bool

	static function create(executable FilePath, source FilePath, anchored SourceLine) returns ExitSession
		return Self{executable: executable, source: source, anchored: anchored, stopReason: "", continued: false, exitCode: 0, sawTerminated: false}
	end 'create'

	function drive(client DapClient) throws DapClientError
		_ = try client.request(InitializeCommand, argumentsJson: dapInitializeArguments())
		_ = try client.request(LaunchCommand, argumentsJson: dapLaunchArguments(self.executable))
		_ = try client.awaitEvent(InitializedEvent)
		_ = try client.request(SetBreakpointsCommand, argumentsJson: dapSetBreakpointsArguments(self.source, line: self.anchored))
		_ = try client.request(ConfigurationDoneCommand)

		let stopped = try client.awaitEvent(StoppedEvent)
		self.stopReason = dapBodyString(stopped, key: "reason")
		let threadId = dapBodyNumber(stopped, key: "threadId")

		// Cleared so `continue` runs to the exit rather than to the next hit of a line that runs several
		// times.
		_ = try client.request(SetBreakpointsCommand, argumentsJson: dapClearBreakpointsArguments(self.source))
		self.continued = dapSuccess(try client.request(ContinueCommand, argumentsJson: dapThreadArguments(threadId)))

		self.exitCode = dapBodyNumber(try client.awaitEvent(ExitedEvent), key: "exitCode")
		_ = try client.awaitEvent(TerminatedEvent)
		self.sawTerminated = true
	end 'drive'
end 'ExitSession'

test 'a program continued to completion reports its exit code and then terminates the session'
	let staged = dapStagedFixture(ExitCaseLabel, fixture: HeaplessFixtureName)
	var session = ExitSession.create(dapBuildFixture(staged), source: dapStagedSource(staged), anchored: dapAnchorLine(staged, anchor: HotAnchor))
	try dapRunSession(session, completing: "run the program to its own exit")

	try Expect.equal(session.stopReason, expected: BreakpointReason, message: "the program must be stopped before it is continued, or `{ContinueCommand}` is not what ran it out; the stop said `{session.stopReason}`")
	try Expect.isTrue(session.continued, message: "`{ContinueCommand}` must answer its own request successfully")
	try Expect.equal(session.exitCode as AssertedInt, expected: HeaplessExitCode as AssertedInt, message: "the `{ExitedEvent}` event must carry the program's OWN exit code — the fixture returns {HeaplessExitCode} — not the adapter's or the driver's; it reported {session.exitCode}")
	try Expect.isTrue(session.sawTerminated, message: "`{TerminatedEvent}` must follow `{ExitedEvent}`; without it an editor leaves the debug session showing as live after the program is gone")
end 'a program continued to completion reports its exit code and then terminates the session'
