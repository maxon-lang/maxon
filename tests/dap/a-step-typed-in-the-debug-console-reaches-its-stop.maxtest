let ConsoleStepCaseLabel = "a-step-typed-in-the-debug-console-reaches-its-stop"
let LongCallFixtureName = "longcall"
let LongCallAnchor = "main-long-call"
let AfterAnchor = "main-after"
let ReplContextName = "repl"
let TypedNextWord = "next"

type ConsoleStepSession implements DapSession
	let executable as FilePath
	let source as FilePath
	let anchored as SourceLine
	export var evaluated as bool
	export var landedReason as String
	export var landedLines as DapNumberArray

	static function create(executable FilePath, source FilePath, anchored SourceLine) returns ConsoleStepSession
		return Self{executable: executable, source: source, anchored: anchored, evaluated: false, landedReason: "", landedLines: DapNumberArray.create()}
	end 'create'

	function drive(client DapClient) throws DapClientError
		_ = try client.request(InitializeCommand, argumentsJson: dapInitializeArguments())
		_ = try client.request(LaunchCommand, argumentsJson: dapLaunchArguments(self.executable))
		_ = try client.awaitEvent(InitializedEvent)
		_ = try client.request(SetBreakpointsCommand, argumentsJson: dapSetBreakpointsArguments(self.source, line: self.anchored))
		_ = try client.request(ConfigurationDoneCommand)

		let threadId = dapBodyNumber(try client.awaitEvent(StoppedEvent), key: "threadId")
		_ = try client.request(SetBreakpointsCommand, argumentsJson: dapClearBreakpointsArguments(self.source))

		let frameId = dapTopFrameId(try client.request(StackTraceCommand, argumentsJson: dapThreadArguments(threadId)))
		self.evaluated = dapSuccess(try client.request(EvaluateCommand, argumentsJson: dapEvaluateArguments(TypedNextWord, context: ReplContextName, frameId: frameId)))
		self.landedReason = dapBodyString(try client.awaitEvent(StoppedEvent), key: "reason")
		self.landedLines = dapStackFrameLines(try client.request(StackTraceCommand, argumentsJson: dapThreadArguments(threadId)))

		_ = try client.request(DisconnectCommand)
	end 'drive'
end 'ConsoleStepSession'

test 'a next typed in the debug console over a long call is watched until it lands'
	let staged = dapStagedFixture(ConsoleStepCaseLabel, fixture: LongCallFixtureName)
	let after = dapAnchorLine(staged, anchor: AfterAnchor)
	var session = ConsoleStepSession.create(dapBuildFixture(staged), source: dapStagedSource(staged), anchored: dapAnchorLine(staged, anchor: LongCallAnchor))
	try dapRunSession(session, completing: "land the console's next with a stopped event")

	try Expect.isTrue(session.evaluated, message: "`{TypedNextWord}` typed in the debug console is a debugger command, and `{EvaluateCommand}` must accept it")
	try Expect.equal(session.landedReason, expected: StepReason, message: "a walk started from the console runs over a long call, so its stop arrives only if the adapter watches that walk as it watches one started by `{NextCommand}`; it said `{session.landedReason}`")
	try Expect.equal(dapFrameNumberAt(session.landedLines, frame: 0) as AssertedInt, expected: after as AssertedInt, message: "the console's `{TypedNextWord}` lands on the line after the call")
end 'a next typed in the debug console over a long call is watched until it lands'
