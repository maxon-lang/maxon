let NotATestCase = "test-file-not-a-test-refused"
let NotATestReason = "not a directory or a `.maxtest` file: "

test 'test-file-not-a-test-refused refuses a file that is not a test file'
	let run = runFixture(NotATestCase)
	try Expect.contains(run.stderr, needle: "{NotATestReason}", message: "a file that is not a `.maxtest` is refused by name. It said: {run.stderr}")
	try Expect.contains(run.stderr, needle: "{NotATestCase}/notes.txt", message: "a file that is not a `.maxtest` is refused by name. It said: {run.stderr}")
	try checkFixtureRun(run, caseName: NotATestCase)
end 'test-file-not-a-test-refused refuses a file that is not a test file'
