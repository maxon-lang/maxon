test 'hovering a linear value names the finalizers that consume it'
	let rendering = try hoverAfterTheCheck(linearProgram(), line: 20, character: 2)

	try Expect.contains(rendering, needle: "linear: consume it with a finalizer (`fin`, `abandon`) on every path", message: "`Resp` declares two methods that take `consuming self` and contain `destruct self`, so a `Resp` is linear. Hover says so and names both.")
end 'hovering a linear value names the finalizers that consume it'
