let ManagedValueProbeFileName = "EditorManagedValueProbe.maxon"
let ManagedValueProbeSource = "module function editorManagedValueProbe() returns MachineWord\n\tlet s = \"hello\"\n\treturn s.count() as MachineWord\nend 'editorManagedValueProbe'\n"
let ManagedValueInRuntimeSourceCode = "E3153"
let ManagedValueProbeLine = 1 as LspCoordinate

test 'a runtime file naming a managed value is refused in the editor as in a build'
	let probe = probeRuntimeTierDiagnostics(ManagedValueProbeFileName, content: ManagedValueProbeSource)

	let reported = onlyProjectDiagnostic(probe, note: "a buffer under `runtime/` binds a `String`. A build refuses a managed value in a runtime source file, and the editor must say what the build says.")

	Expect.equal(reported.code, expected: ManagedValueInRuntimeSourceCode, message: "the refusal is the runtime tier's own rule; publishing nothing here means the editor checked the tier file as an author's file.")

	Expect.equal(reported.range.startLine as AssertedInt, expected: ManagedValueProbeLine as AssertedInt, message: "the binding is on line 1.")
end 'a runtime file naming a managed value is refused in the editor as in a build'
