let ProjectSiblingWitnessRangeDirName = "diagnostics-project-sibling-witness-range-error"
let ProjectSiblingWitnessRangeDeclaringFileName = "a.maxon"
let ProjectSiblingWitnessRangeBufferFileName = "b.maxon"
let ProjectSiblingWitnessRangeDeclaringSource = "module typealias Item = int(0 to 3)\n\nmodule interface Store\n\tfunction put(item Item) returns Item\nend 'Store'\n\nmodule type Shelf implements Store\n\tmodule static function create() returns Self\n\t\treturn Self\{\}\n\tend 'create'\n\n\tmodule function put(item Item) returns Item\n\t\treturn item\n\tend 'put'\nend 'Shelf'\n"
let ProjectSiblingWitnessRangeBufferSource = "function stock(store Store)\n\t_ = store.put(50)\nend 'stock'\n\nfunction main() returns ExitCode\n\tstock(Shelf.create())\n\treturn 0\nend 'main'\n"
let ProjectSiblingWitnessRangeCode = "E3005"
let ProjectSiblingWitnessRangeMessage = "Value 50 is outside the range of 'Item' (int(0 to 3))"
let ProjectSiblingWitnessRangeLine = 1
let ProjectSiblingWitnessRangeCharacter = 11
let ProjectSiblingWitnessRangeEndCharacter = 14

test 'a literal argument through an interface a sibling file declares is checked against that range'
	let root = stagedProjectDiagnosticsRoot(ProjectSiblingWitnessRangeDirName)
	writeCorpusFile(root, fileName: ProjectSiblingWitnessRangeDeclaringFileName, content: ProjectSiblingWitnessRangeDeclaringSource)
	writeCorpusFile(root, fileName: ProjectSiblingWitnessRangeBufferFileName, content: ProjectSiblingWitnessRangeBufferSource)

	let probe = probeProjectCheckDiagnostics(root, fileName: ProjectSiblingWitnessRangeBufferFileName, content: ProjectSiblingWitnessRangeBufferSource, edits: StringArray.create(0))

	discardStagedDir(root)

	let reported = try onlyProjectDiagnostic(probe, note: "the buffer passes `50` to `Store.put` through the interface, whose parameter is the sibling's `Item = int(0 to 3)`. A `maxon build` of the staged project reports exactly one `{ProjectSiblingWitnessRangeCode}` at that call and nothing else.")

	try Expect.equal(reported.code.describe(), expected: ProjectSiblingWitnessRangeCode, message: "the one error a build of this project reports is {ProjectSiblingWitnessRangeCode}; the server published {reported.code.describe()}: {reported.message}")
	try Expect.equal(reported.message, expected: ProjectSiblingWitnessRangeMessage, message: "the server must quote the range the build quotes, the one the interface's own file declares.")
	try Expect.equal(reported.range.startLine, expected: ProjectSiblingWitnessRangeLine, message: "the build anchors the error at the `store.put(50)` call on line 2.")
	try Expect.equal(reported.range.startCharacter, expected: ProjectSiblingWitnessRangeCharacter, message: "the build anchors the error at column 12, the method's name.")
	try Expect.equal(reported.range.endCharacter, expected: ProjectSiblingWitnessRangeEndCharacter, message: "the error spans the method's name, `put`.")
end 'a literal argument through an interface a sibling file declares is checked against that range'
