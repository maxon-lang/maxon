let AddedFolderFirstDirName = "maxon-tests-lsp-added-folder-one"
let AddedFolderSecondDirName = "maxon-tests-lsp-added-folder-two"

test 'project roots: a workspace folder added mid session becomes a root'
	let first = stagedDirectoryOutsideTheCheckout(AddedFolderFirstDirName)
	let second = stagedCrossDirectoryRoot(AddedFolderSecondDirName)

	writeCorpusFile(first, fileName: ProjectRootsFillerFileName, content: ProjectRootsFillerSource)

	let uri = crossDirectoryReaderUri(second)
	let probe = try definitionAcrossWorkspaceFolders(projectRootsFolders(first), addedFolders: projectRootsFolders(second), documents: projectRootsDocument(uri, content: ProjectRootsReaderSource), position: WorkspaceFolderProbePosition.create(uri, line: ProjectRootsCallLine, character: ProjectRootsCallCharacter))

	try expectDefinitionInFile(probe, fileTail: crossDirectoryHelperTail(AddedFolderSecondDirName), startLine: ProjectRootsDeclarationLine, note: "the client initialized with ONE workspace folder, then sent `workspace/didChangeWorkspaceFolders` adding a second sibling folder, then opened a document in the NEW folder calling an `export`ed declaration in a sibling directory of it. Neither staged tree holds a `project.maxon`, so only the added folder being a root can answer. A session outlives its `initialize`: an author who adds a folder to an open window must not have to restart the editor to get cross-file answers in it, and a server that handles no `workspace/*` message never learns the folder exists.")
end 'project roots: a workspace folder added mid session becomes a root'
