test 'hovering self inside a generic type answers'
	let rendering = try hoverAfterTheCheck(genericProgram(), line: 26, character: 10)

	try Expect.contains(rendering, needle: "Box", message: "`self` in `Box.get` is a `Box` over the type parameter `T`, and the hover must still answer.")
end 'hovering self inside a generic type answers'
