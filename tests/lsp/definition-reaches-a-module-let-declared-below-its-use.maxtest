let LetBelowUseLine = 1
let LetBelowUseCharacter = 13
let LetBelowDeclarationLine = 4

test 'definition reaches a module-level let declared below its use'
	expectDefinitionAt(letBelowFixture(), line: LetBelowUseLine, character: LetBelowUseCharacter, startLine: LetBelowDeclarationLine, note: "a bare `reading` above the file's module-level `let reading` did not resolve to it. A module-level binding is declared for the whole file, wherever it is written.")
end 'definition reaches a module-level let declared below its use'

function letBelowFixture() returns String
	return String.from(b"function run() returns ExitCode
    return reading
end 'run'

let reading = 0")
end 'letBelowFixture'
