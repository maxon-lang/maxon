let UnlocatedProjectsUri = "untitled:Untitled-1"
let UnlocatedProjectsUriScheme = "untitled:"
let UnlocatedProjectsSource = "function unlocatedProjectsMain() returns ExitCode\n\treturn 0\nend 'unlocatedProjectsMain'\n"

test 'non-file document: an untitled buffer is no project, and a stdlib document still is one'
	let library = libraryTierFilePathDocument()
	let probe = listProjectsIn(ProjectRootsSession.unrooted, documents: unlocatedProjectsDocuments(library))

	match probe 'probe'
		answered(result, _) then requireOnlyTheLibraryDocumentIsAProject(result, library: library)
		unanswered(reason) then Expect.fail("`maxon/listProjects` did not answer with `{UnlocatedProjectsUri}` and `{library.uri}` open: {reason}.")
	end 'probe'
end 'non-file document: an untitled buffer is no project, and a stdlib document still is one'

function unlocatedProjectsDocuments(library LibraryTierDocument) returns WorkspaceFolderDocumentArray
	var documents = projectRootsDocument(UnlocatedProjectsUri, content: UnlocatedProjectsSource)
	documents.push(WorkspaceFolderDocument.create(library.uri, content: library.content))

	return documents
end 'unlocatedProjectsDocuments'

function requireOnlyTheLibraryDocumentIsAProject(result ListProjectsResult, library LibraryTierDocument) throws TestFailure
	try requireNoProjectIsSpelledFromTheUri(result, scheme: UnlocatedProjectsUriScheme)

	let note = "two documents were open: `{UnlocatedProjectsUri}`, the unsaved scratch buffer every editor opens with a keystroke, and `{library.uri}`, a real file with a real directory above it. ⛔ `{UnlocatedProjectsUri}` SPELLS A PATH `FilePath.from` ACCEPTS — it carries no `://`, so nothing refuses it — and the only thing wrong with that path is that it sits in no directory, which is why the skip is keyed on having no parent rather than on the scheme. ⭐ The `stdlib/` half must not change: a fix that dropped every document the ladder roots in no project directory would leave an author editing `stdlib/` with a status bar reporting nothing at all."
	let project = try soleProject(result, note: note)

	try requireTheLibraryTierProject(project, document: library, note: note)
end 'requireOnlyTheLibraryDocumentIsAProject'
