let RuntimeClockFileName = "Clock.maxon"

test 'a runtime file opened in the editor publishes nothing a build of it does not report'
	let probe = probeRuntimeTierDiagnostics(RuntimeClockFileName, content: runtimeTierFileText(RuntimeClockFileName))

	try expectNoProjectDiagnostics(probe, note: "`{runtimeTierDocumentName(RuntimeClockFileName)}` is the runtime tier's own file, unedited, and every build compiles it clean: it declares the reserved `__clock_now_unix_s` and calls `__Raw`, which the tier may and no other file may.")
end 'a runtime file opened in the editor publishes nothing a build of it does not report'
