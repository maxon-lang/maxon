let TaskFileRootDirName = "projects-task-file-alone"
let TaskFileFileName = "dev.maxtasks"
let TaskFileSource = "export function hello() returns ExitCode\n\treturn 0\nend 'hello'\n"
let TaskFileSiblingFileName = "main.maxon"
let TaskFileSiblingSource = "function main() returns ExitCode\n\treturn 0\nend 'main'\n"

test 'project roots: a .maxtasks document under a workspace folder is a program of its own'
	let root = freshOutsideCheckoutDir(TaskFileRootDirName)
	writeCorpusFile(root, fileName: TaskFileFileName, content: TaskFileSource)
	writeCorpusFile(root, fileName: TaskFileSiblingFileName, content: TaskFileSiblingSource)

	let uri = fileUriOf(root.join(TaskFileFileName))
	let probe = listProjectsIn(ProjectRootsSession.atFolders(projectRootsFolders(root)), documents: projectRootsDocument(uri, content: TaskFileSource))

	discardOutsideCheckoutDir(root)

	match probe 'probe'
		answered(projects, notices) then requireADriverFileStandsAlone(projects, notices: notices, note: "`{TaskFileFileName}` was opened in a session whose one workspace folder holds it, a sibling `{TaskFileSiblingFileName}` and no `.maxproj`. `maxon run` compiles a task file ALONE, so its siblings are no part of its program, and the workspace folder — a whole checkout, for the file this repository keeps at its root — must not be swept and folded to check it.")
		unanswered(reason) then Expect.fail(reason)
	end 'probe'
end 'project roots: a .maxtasks document under a workspace folder is a program of its own'
