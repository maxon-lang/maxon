test 'hovering an isolated value after a branch moved it names the line of the move, not the last read'
	let rendering = try hoverAfterTheCheck(branchMergeProgram(), line: 29, character: 14)

	try Expect.contains(rendering, needle: "moved at line 26", message: "`hand(words)` on line 26 moves `words` on one path, and the other path only reads it on line 28. The join marks it moved, and hover names the line where the move happened.")
end 'hovering an isolated value after a branch moved it names the line of the move, not the last read'
