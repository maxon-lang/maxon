let SemanticTokenQuintupleWidth = 5

let SemanticTokenDeltaLineSlot = 0
let SemanticTokenDeltaCharacterSlot = 1
let SemanticTokenLengthSlot = 2
let SemanticTokenTypeSlot = 3

let SemanticTokenLineBreak = "\n"

typealias SemanticTokenTally = int(0 to i64.max)

type LocatedSemanticToken
	export var line as SemanticTokenValue
	export var character as SemanticTokenValue
	export var length as SemanticTokenValue
	export var tokenType as SemanticTokenValue

	static function create(line SemanticTokenValue, character SemanticTokenValue, length SemanticTokenValue, tokenType SemanticTokenValue) returns LocatedSemanticToken
		return Self{line: line, character: character, length: length, tokenType: tokenType}
	end 'create'
end 'LocatedSemanticToken'

typealias LocatedSemanticTokenArray = Array with LocatedSemanticToken

function locatedSemanticTokensOf(data SemanticTokenValueArray) returns LocatedSemanticTokenArray
	let tokens = LocatedSemanticTokenArray.create(0)
	var currentLine = 0 as SemanticTokenValue
	var currentCharacter = 0 as SemanticTokenValue
	var lineAdvanced = false
	var pendingLength = 0 as SemanticTokenValue

	for (position, value) in data.withIterator() 'eachValue'
		let slot = position.index() mod SemanticTokenQuintupleWidth

		if slot == SemanticTokenDeltaLineSlot 'delta'
			currentLine = currentLine + value
			lineAdvanced = value > 0
		end 'delta' else if slot == SemanticTokenDeltaCharacterSlot 'deltaCharacter'
			currentCharacter = value if lineAdvanced else currentCharacter + value
		end 'deltaCharacter' else if slot == SemanticTokenLengthSlot 'length'
			pendingLength = value
		end 'length' else if slot == SemanticTokenTypeSlot 'tokenType'
			tokens.push(LocatedSemanticToken.create(currentLine, character: currentCharacter, length: pendingLength, tokenType: value))
		end 'tokenType'
	end 'eachValue'

	return tokens
end 'locatedSemanticTokensOf'

function requireSemanticTokenType(tokens LocatedSemanticTokenArray, source String, line SemanticTokenValue, word String, expected SemanticTokenValue, what String) throws TestFailure
	let lines = source.split(SemanticTokenLineBreak)
	let text = try lines.get(line as ElementIndex) otherwise panic("requireSemanticTokenType: {what}: the fixture has {lines.count()} lines and the claim is about line {line}")
	let found = try text.findFirst(word) otherwise panic("requireSemanticTokenType: {what}: line {line} of the fixture, `{text}`, does not contain `{word}`")

	let character = found.charIndex() as SemanticTokenValue

	var matched = 0 as SemanticTokenTally
	var observed = -1 as SemanticTokenValue
	var observedLength = -1 as SemanticTokenValue

	for token in tokens 'eachToken'
		if token.line == line and token.character == character 'atThePosition'
			matched = matched + 1
			observed = token.tokenType
			observedLength = token.length
		end 'atThePosition'
	end 'eachToken'

	try Expect.equal(matched, expected: 1, message: "{what}: exactly one token should start at line {line}, column {character} (`{word}`), and {matched} did.")
	try Expect.equal(observedLength, expected: word.count() as SemanticTokenValue, message: "{what}: the token at line {line}, column {character} is {observedLength} wide and `{word}` is {word.count()}.")
	try Expect.equal(observed, expected: expected, message: "{what}: `{word}` on line {line} is expected to be token type {expected} and was {observed}.")
end 'requireSemanticTokenType'
