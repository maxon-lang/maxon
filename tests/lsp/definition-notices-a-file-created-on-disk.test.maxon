// definition-notices-a-file-created-on-disk.test.maxon — a file that appears on disk AFTER the corpus was
// built is eventually resolved into.
//
// ⭐⭐ **THIS IS THE ONLY CASE THAT PINS THE RE-SWEEP, AND WITHOUT IT THE INTERVAL IS A GATE THAT CANNOT
// FAIL.** The corpus caches the project's source LIST and re-walks the tree at most once per interval; a
// file's CONTENT changing is noticed every request (`definition-warm-corpus` pins that), but a file that
// did not exist when the list was taken is invisible until the next walk. Nothing else in this corpus
// creates a file mid-session, so an interval raised to an hour — or a re-sweep deleted outright — would
// leave every other case green.
//
// ⚠ It asserts the PROPERTY, not the interval: it retries to a deadline rather than sleeping for a
// constant, so tightening or loosening the re-sweep does not touch this file. It starts GREEN — it is a
// regression guard for a mechanism that works, not a red-first case.
//
// The staging, the session and the assertions are `definition-corpus-probe.test.maxon`'s.

let CreatedDirName = "temp/lsp/definition-notices-a-file-created-on-disk"
let CreatedReaderName = "main.maxon"
let CreatedHelperName = "helper.maxon"

// The reader calls a name nothing declares yet. The helper file is written only after the first request,
// so the first answer must be nothing and the later one must be the declaration.
let CreatedReaderSource = "function main() returns ExitCode\n\treturn appearsLater()\nend 'main'\n"
let CreatedHelperSource = "export function appearsLater() returns ExitCode\n\treturn 0\nend 'appearsLater'\n"

let CreatedCallLine = 1 as LspCoordinate
let CreatedCallCharacter = 12 as LspCoordinate
let CreatedDeclarationLine = 0 as LspCoordinate

// Generous against a loaded CI runner, and unrelated to the server's own interval: the case fails only if
// the file is NEVER noticed.
let CreatedDeadlineMs = 15000 as Milliseconds
let CreatedRetryPauseMs = 250 as Milliseconds

test 'a definition notices a file created on disk after the corpus was built'
	let directory = stagedCorpusDirectory(CreatedDirName)
	removeCreatedHelper(directory)
	writeCorpusFile(directory, fileName: CreatedReaderName, content: CreatedReaderSource)

	let uri = fileUriOf(directory.join(CreatedReaderName))

	let before = probeCorpusDefinitionWithRoot(CorpusSessionRoot.unrooted, uri: uri, content: CreatedReaderSource, line: CreatedCallLine, character: CreatedCallCharacter)
	try expectNoDefinitionInProject(before, note: "`appearsLater` is declared in no file yet, so the first request must answer nothing — otherwise this case cannot tell a re-sweep from a stale answer that happened to be right.")

	writeCorpusFile(directory, fileName: CreatedHelperName, content: CreatedHelperSource)

	let after = createdHelperResolved(uri)
	try expectDefinitionInFile(after, fileTail: CreatedHelperName, startLine: CreatedDeclarationLine, note: "`{CreatedHelperName}` was created on disk after the corpus had been built, and a definition asked repeatedly for {CreatedDeadlineMs}ms never resolved into it. The corpus caches the project's source LIST; a file that appears later is seen only when that list is walked again.")
end 'a definition notices a file created on disk after the corpus was built'

// Ask until the declaration is found or the deadline passes, and hand back the LAST answer either way so
// the failure reports what the server actually said rather than that a loop ended.
function createdHelperResolved(uri String) returns CorpusDefinitionProbe
	let started = Clock.nowMs()
	var latest = probeCorpusDefinitionWithRoot(CorpusSessionRoot.unrooted, uri: uri, content: CreatedReaderSource, line: CreatedCallLine, character: CreatedCallCharacter)

	while Clock.elapsedMs(started) < CreatedDeadlineMs 'untilNoticed'
		match latest 'answer'
			located then return latest
			absent then sleep(CreatedRetryPauseMs)
			refused then return latest
			broke then return latest
		end 'answer'

		latest = probeCorpusDefinitionWithRoot(CorpusSessionRoot.unrooted, uri: uri, content: CreatedReaderSource, line: CreatedCallLine, character: CreatedCallCharacter)
	end 'untilNoticed'

	return latest
end 'createdHelperResolved'

// The staging directory outlives a run, so a helper left by the previous one would make the first request
// resolve and the case would prove nothing.
function removeCreatedHelper(directory FilePath)
	let helper = directory.join(CreatedHelperName)

	if not File.exists(helper) 'alreadyAbsent'
		return
	end 'alreadyAbsent'

	try File.delete(helper) otherwise panic("definition notices a created file: the test could not run — could not remove {helper.toString()} left by a previous run")
end 'removeCreatedHelper'
