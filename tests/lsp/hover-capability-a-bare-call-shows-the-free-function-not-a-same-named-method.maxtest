test 'hovering a bare call shows the free function, not a same-named method declared between it and the function'
	let rendering = try hoverAfterTheCheck(freeFunctionAndMethodProgram(), line: 29, character: 34)

	try Expect.contains(rendering, needle: "function fin(code Count) returns Count", message: "`fin(1)` is a bare call at file scope, so it calls the free `fin`, not `Gauge.fin`.")

	Expect.isFalse(rendering.contains("function fin() returns Count"), message: "`Gauge.fin` is declared nearer the call than the free `fin`, and a bare call does not name a method.")
end 'hovering a bare call shows the free function, not a same-named method declared between it and the function'
