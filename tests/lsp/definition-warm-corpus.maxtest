// definition-warm-corpus.maxtest — TWO requests in ONE session, which is the only shape that reaches the
// cached corpus at all.
//
// ⭐⭐ **EVERY OTHER LSP CASE STARTS A SERVER, ASKS ONE QUESTION AND EXITS**, so every one of them answers
// from a COLD corpus. The whole of the caching — the held `Project`, the size+mtime stamp that skips a
// re-read, and the rule that switching which file is the reader must not disturb what is registered for the
// others — is unreachable from a single-request session, and a cache that returned a stale or wrong answer
// on the second request would pass the entire rest of this corpus.
//
// The two cases below are the second request: one where the READER moved, and one where a sibling changed
// ON DISK underneath the cache.
//
// The staging helpers are `definition-corpus-probe.maxtest`'s.

let WarmDirName = "temp/lsp/definition-warm-corpus"
let WarmAlphaName = "alpha.maxon"
let WarmBetaName = "beta.maxon"

// Each file declares its own name and calls the other's, so ONE project answers a jump in both directions
// and neither answer can come from the open buffer.
let WarmAlphaSource = "export function alphaAnswer() returns ExitCode\n\treturn 0\nend 'alphaAnswer'\n\nfunction alphaCallsBeta() returns ExitCode\n\treturn betaAnswer()\nend 'alphaCallsBeta'\n"
let WarmBetaSource = "export function betaAnswer() returns ExitCode\n\treturn 0\nend 'betaAnswer'\n\nfunction betaCallsAlpha() returns ExitCode\n\treturn alphaAnswer()\nend 'betaCallsAlpha'\n"

// The same declaration, pushed down two lines. A stamp that skipped the re-read would keep answering 0.
let WarmBetaRewritten = "// pushed down\n\n export function betaAnswer() returns ExitCode\n\treturn 0\nend 'betaAnswer'\n"
let WarmBetaMovedLine = 2 as LspCoordinate

let WarmFirstDeclarationLine = 0 as LspCoordinate

// Where each file's call to the OTHER file's function sits: `\treturn xAnswer()` on the second body's line.
let WarmCallLine = 5 as LspCoordinate
let WarmCallCharacter = 8 as LspCoordinate

// What one session's two requests answered, or why they could not be asked.
union WarmProbe
	answered(first CorpusDefinitionProbe, second CorpusDefinitionProbe)
	broke(detail String)
end 'WarmProbe'

test 'a second definition in the same session resolves against a different reader'
	let directory = stagedCorpusDirectory(WarmDirName)
	writeCorpusFile(directory, fileName: WarmAlphaName, content: WarmAlphaSource)
	writeCorpusFile(directory, fileName: WarmBetaName, content: WarmBetaSource)

	let probe = warmSession(directory, rewriteBetaBetween: false)

	match probe 'probe'
		answered(first, second) then requireReaderMoved(first, second: second)
		broke(detail) then Expect.fail(detail)
	end 'probe'
end 'a second definition in the same session resolves against a different reader'

test 'a definition sees a sibling that changed on disk mid-session'
	let directory = stagedCorpusDirectory(WarmDirName)
	writeCorpusFile(directory, fileName: WarmAlphaName, content: WarmAlphaSource)
	writeCorpusFile(directory, fileName: WarmBetaName, content: WarmBetaSource)

	let probe = warmSession(directory, rewriteBetaBetween: true)

	match probe 'probe'
		answered(first, second) then requireSiblingRefreshed(first, second: second)
		broke(detail) then Expect.fail(detail)
	end 'probe'
end 'a definition sees a sibling that changed on disk mid-session'

function requireReaderMoved(first CorpusDefinitionProbe, second CorpusDefinitionProbe) throws TestFailure
	try expectDefinitionInFile(first, fileTail: WarmBetaName, startLine: WarmFirstDeclarationLine, note: "the FIRST request of the session, from `{WarmAlphaName}` into `{WarmBetaName}`, did not resolve.")

	try expectDefinitionInFile(second, fileTail: WarmAlphaName, startLine: WarmFirstDeclarationLine, note: "the SECOND request of the session, after the reader moved to `{WarmBetaName}`, did not resolve back into `{WarmAlphaName}`. A corpus that registers the reader differently from every other file corrupts itself the moment the reader moves, and no single-request case can see it.")
end 'requireReaderMoved'

function requireSiblingRefreshed(first CorpusDefinitionProbe, second CorpusDefinitionProbe) throws TestFailure
	try expectDefinitionInFile(first, fileTail: WarmBetaName, startLine: WarmFirstDeclarationLine, note: "the FIRST request, before `{WarmBetaName}` was rewritten, did not resolve.")

	try expectDefinitionInFile(second, fileTail: WarmBetaName, startLine: WarmBetaMovedLine, note: "after `{WarmBetaName}` was rewritten on disk, the jump still landed on its OLD line. The corpus skips re-reading a file whose size and modification time are unchanged, so a stamp that certified this file wrongly serves a declaration that has moved.")
end 'requireSiblingRefreshed'

// One server, two `textDocument/definition` requests, released before anything is asserted.
function warmSession(directory FilePath, rewriteBetaBetween bool) returns WarmProbe
	var client = LspClient.start()
	let collected = collectWarmSession(client, directory: directory, rewriteBetaBetween: rewriteBetaBetween)
	client.release()
	return collected
end 'warmSession'

function collectWarmSession(client LspClient, directory FilePath, rewriteBetaBetween bool) returns WarmProbe
	var probe = WarmProbe.broke(UnreportedSessionEnding)

	let alphaUri = fileUriOf(directory.join(WarmAlphaName))
	let betaUri = fileUriOf(directory.join(WarmBetaName))

	try 'session'
		_ = client.initialize()
		client.initialized()

		client.openDocument(alphaUri, content: WarmAlphaSource)
		let first = corpusProbeOf(client.definition(alphaUri, line: WarmCallLine, character: WarmCallCharacter))

		if rewriteBetaBetween 'betaMoves'
			writeCorpusFile(directory, fileName: WarmBetaName, content: WarmBetaRewritten)
			let second = corpusProbeOf(client.definition(alphaUri, line: WarmCallLine, character: WarmCallCharacter))
			probe = WarmProbe.answered(first, second: second)
			return probe
		end 'betaMoves'

		client.openDocument(betaUri, content: WarmBetaSource)
		let second = corpusProbeOf(client.definition(betaUri, line: WarmCallLine, character: WarmCallCharacter))
		probe = WarmProbe.answered(first, second: second)
	end 'session' otherwise (e) 'failed'
		match e 'reason'
			transportFailed or
				malformedResponse or
				serverRefused then probe = WarmProbe.broke("while asking `textDocument/definition`: {e.explained()}")
		end 'reason'
	end 'failed'

	return probe
end 'collectWarmSession'
