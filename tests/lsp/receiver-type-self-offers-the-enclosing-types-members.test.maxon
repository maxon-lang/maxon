// receiver-type-self-offers-the-enclosing-types-members.test.maxon — the completion list after `self.`
// is the enclosing type's own surface: its fields and its methods.
//
// ⛔ **THE COMPLETION HALF READS `self` THROUGH THE SAME RECEIVER WALK HOVER DOES**, so this list and
// the hover its sibling case asserts stand or fall together — one walk, and no second answer about what
// `self` names.
//
// ⭐ The labels are asserted by NAME, never by count: a pinned total reddens the day a third member is
// added to the fixture for an unrelated reason, and says nothing about what the list got wrong.

let ReceiverSelfMembersLine = 4 as LspCoordinate
let ReceiverSelfMembersCharacter = 20 as LspCoordinate

test 'receiver type: self offers the enclosing types members'
	let labels = try completionLabelsFor(receiverSelfFixture(), line: ReceiverSelfMembersLine, character: ReceiverSelfMembersCharacter, after: "`self.`")

	try Expect.greaterThan(labels.count(), than: 0, message: "completion after `self.` offered nothing at all. Every member an editor user reaches inside a method is reached through `self`, so an empty list here is completion switched off for most of a type's own code.")

	try Expect.isTrue(completionOffersLabel(labels, label: "items"), message: "completion after `self.` did not offer the field `items`, which the enclosing type declares two lines above the cursor.")

	try Expect.isTrue(completionOffersLabel(labels, label: "isEmpty"), message: "completion after `self.` did not offer the method `isEmpty`, which is the very method the cursor is inside.")
end 'receiver type: self offers the enclosing types members'
