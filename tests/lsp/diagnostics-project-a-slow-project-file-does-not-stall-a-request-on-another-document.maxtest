let SlowProjectDirName = "diagnostics-project-slow-project-file"
let SlowMainFileName = "main.maxon"
let SlowOtherFileName = "other.maxon"
let SlowMainSource = "function main() returns ExitCode\n\treturn 0\nend 'main'\n"
let SlowOtherSource = "function other() returns ExitCode\n\treturn 0\nend 'other'\n"

test 'project diagnostics: a slow project file does not stall a request on another open document'
	let root = freshOutsideCheckoutDir(SlowProjectDirName)
	writeCorpusFile(root, fileName: GatedManifestFileName, content: GatedManifestSource)
	writeCorpusFile(root, fileName: SlowMainFileName, content: SlowMainSource)
	writeCorpusFile(root, fileName: SlowOtherFileName, content: SlowOtherSource)

	var client = LspClient.start()

	if let answered = try symbolsWhileResolving(client, root: root) 'answered'
		client.release()
		releaseGatedManifest(root)
		discardOutsideCheckoutDir(root)
		let (symbols, finishedMeanwhile) = answered
		expectAnsweredWhileResolving(symbols, finishedMeanwhile: finishedMeanwhile)
	end 'answered' else (e) 'failed'
		releaseGatedManifest(root)
		abandonedStagedSession(client, staged: root, failure: e, doing: "the session did not complete")
	end 'failed'
end 'project diagnostics: a slow project file does not stall a request on another open document'

function expectAnsweredWhileResolving(symbols ElementIndex, finishedMeanwhile bool) throws TestFailure
	try Expect.isFalse(finishedMeanwhile, message: "`{GatedManifestFileName}` waits for `{GatedReleaseFileName}`, which the test writes only after the request on `{SlowOtherFileName}` was answered, and it had finished by then: the server ran the project file on the thread that reads requests.")
	try Expect.equal(symbols, expected: 1, message: "`{SlowOtherFileName}` declares one function")
end 'expectAnsweredWhileResolving'

function symbolsWhileResolving(client LspClient, root FilePath) returns (ElementIndex, bool) throws LspClientError
	let mainUri = fileUriOf(root.join(SlowMainFileName))
	let otherUri = fileUriOf(root.join(SlowOtherFileName))

	_ = try client.initializeAtRoot(root)
	try client.initialized()
	try client.openDocument(otherUri, content: SlowOtherSource)
	try client.openDocument(mainUri, content: SlowMainSource)

	try awaitGatedManifestRunning(root)

	let answer = try client.documentSymbols(otherUri)

	return (answer.symbols.count(), File.exists(root.join(GatedFinishedFileName)))
end 'symbolsWhileResolving'
