let SlowProjectDirName = "diagnostics-project-slow-project-file"
let SlowManifestFileName = "app.maxproj"
let SlowMainFileName = "main.maxon"
let SlowOtherFileName = "other.maxon"
let SlowFinishedFileName = "finished.txt"
let SlowManifestSource = "export function build() returns ExitCode\n\tsleep(3000)\n\tlet marker = try FilePath.from(\"finished.txt\") otherwise return 1\n\ttry File.writeText(marker, content: \"done\") otherwise return 1\n\tBuild.build(\".\")\n\treturn 0\nend 'build'\n"
let SlowMainSource = "function main() returns ExitCode\n\treturn 0\nend 'main'\n"
let SlowOtherSource = "function other() returns ExitCode\n\treturn 0\nend 'other'\n"
let SlowAnswerBudgetMs = 2500
let SlowFinishBoundMs = 30000
let SlowFinishPollMs = 200

test 'project diagnostics: a slow project file does not stall a request on another open document'
	let root = freshOutsideCheckoutDir(SlowProjectDirName)
	writeCorpusFile(root, fileName: SlowManifestFileName, content: SlowManifestSource)
	writeCorpusFile(root, fileName: SlowMainFileName, content: SlowMainSource)
	writeCorpusFile(root, fileName: SlowOtherFileName, content: SlowOtherSource)

	var client = LspClient.start()

	if let answered = try symbolsWhileResolving(client, root: root) 'answered'
		client.release()
		waitForTheManifestToFinish(root.join(SlowFinishedFileName))
		discardOutsideCheckoutDir(root)
		let (symbols, tookMs, finishedMeanwhile) = answered
		expectAnsweredWhileResolving(symbols, tookMs: tookMs, finishedMeanwhile: finishedMeanwhile)
	end 'answered' else (e) 'failed'
		waitForTheManifestToFinish(root.join(SlowFinishedFileName))
		abandonedStagedSession(client, staged: root, failure: e, doing: "the session did not complete")
	end 'failed'
end 'project diagnostics: a slow project file does not stall a request on another open document'

function expectAnsweredWhileResolving(symbols ElementIndex, tookMs DurationMs, finishedMeanwhile bool) throws TestFailure
	try Expect.isFalse(finishedMeanwhile, message: "`{SlowManifestFileName}` sleeps for three seconds before it writes `{SlowFinishedFileName}`, and it had finished by the time the request on `{SlowOtherFileName}` was answered: the server ran the project file on the thread that reads requests.")
	try Expect.atMost(tookMs, than: SlowAnswerBudgetMs, message: "a `documentSymbol` request on `{SlowOtherFileName}` took {tookMs} ms while `{SlowManifestFileName}` was still being run for `{SlowMainFileName}`")
	try Expect.equal(symbols, expected: 1, message: "`{SlowOtherFileName}` declares one function")
end 'expectAnsweredWhileResolving'

function waitForTheManifestToFinish(marker FilePath)
	let started = Clock.nowMs()

	while not File.exists(marker) and Clock.elapsedMs(started) < SlowFinishBoundMs 'untilItFinishes'
		sleep(SlowFinishPollMs)
	end 'untilItFinishes'

	sleep(SlowFinishPollMs)
end 'waitForTheManifestToFinish'

function symbolsWhileResolving(client LspClient, root FilePath) returns (ElementIndex, DurationMs, bool) throws LspClientError
	let mainUri = fileUriOf(root.join(SlowMainFileName))
	let otherUri = fileUriOf(root.join(SlowOtherFileName))

	_ = try client.initializeAtRoot(root)
	try client.initialized()
	try client.openDocument(otherUri, content: SlowOtherSource)
	try client.openDocument(mainUri, content: SlowMainSource)

	let started = Clock.nowMs()
	let answer = try client.documentSymbols(otherUri)
	let took = Clock.elapsedMs(started)

	return (answer.symbols.count(), took, File.exists(root.join(SlowFinishedFileName)))
end 'symbolsWhileResolving'
