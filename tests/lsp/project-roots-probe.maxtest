let ProjectRootsBackslash = "\\"
let ProjectRootsSlash = "/"
export let ProjectRootsMaxonExtension = ".maxon"
let ProjectRootsFileUriPrefix = "file://"

let CeilingDecoyDirName = "decoy"
let CeilingFolderDirName = "inner"
let CeilingReaderDirName = "a"
let CeilingReaderFileName = "main.maxon"
let CeilingNeighbourFileName = "neighbour.maxon"
let CeilingDecoyFileName = "outer-only.maxon"
export let CeilingReaderSource = "function reachesOutside() returns ExitCode\n\treturn outerOnly()\nend 'reachesOutside'\n\nfunction main() returns ExitCode\n\treturn neighbour()\nend 'main'\n"
let CeilingNeighbourSource = "export function neighbour() returns ExitCode\n\treturn 0\nend 'neighbour'\n"
let CeilingDecoySource = "export function outerOnly() returns ExitCode\n\treturn 0\nend 'outerOnly'\n"
let CeilingOuterCallLine = 1 as LspCoordinate
let CeilingNeighbourCallLine = 5 as LspCoordinate
let CeilingCallCharacter = 12 as LspCoordinate
export let ProjectRootsUnsweptFileCount = 0
export let ProjectRootsFillerFileName = "filler.maxon"
export let ProjectRootsFillerSource = "export function firstFolderFiller() returns ExitCode\n\treturn 0\nend 'firstFolderFiller'\n"
export let ProjectRootsDeclarationLine = 0 as LspCoordinate

export union ListProjectsProbe
	answered(result ListProjectsResult, notices ProjectLoadingNoticeArray)
	unanswered(reason String)
end 'ListProjectsProbe'

export union ProjectRootsSession
	atFolders(folders WorkspaceFolderRootArray)
	atFoldersThenRemoved(folders WorkspaceFolderRootArray)
	unrooted
end 'ProjectRootsSession'

export union WorkspaceFolderDefinitionOutcome
	answered(probes CorpusDefinitionProbeArray)
	broke(detail String)
end 'WorkspaceFolderDefinitionOutcome'

export union WorkspaceFolderFollowUp
	none
	definitionAt(line LspCoordinate, character LspCoordinate)
end 'WorkspaceFolderFollowUp'

export type WorkspaceFolderDocument
	export var uri as String
	export var content as String
	export var followUp as WorkspaceFolderFollowUp

	export static function create(uri String, content String) returns WorkspaceFolderDocument
		return Self{uri: uri, content: content, followUp: WorkspaceFolderFollowUp.none}
	end 'create'

	export static function followedByDefinition(uri String, content String, line LspCoordinate, character LspCoordinate) returns WorkspaceFolderDocument
		return Self{uri: uri, content: content, followUp: WorkspaceFolderFollowUp.definitionAt(line, character: character)}
	end 'followedByDefinition'
end 'WorkspaceFolderDocument'

export typealias WorkspaceFolderDocumentArray = Array with WorkspaceFolderDocument

export function projectRootsFolders(first FilePath) returns WorkspaceFolderRootArray
	var folders = WorkspaceFolderRootArray.create()
	folders.push(first)

	return folders
end 'projectRootsFolders'

export function projectRootsFolderPair(first FilePath, second FilePath) returns WorkspaceFolderRootArray
	var folders = projectRootsFolders(first)
	folders.push(second)

	return folders
end 'projectRootsFolderPair'

export function projectRootsDocument(uri String, content String) returns WorkspaceFolderDocumentArray
	var documents = WorkspaceFolderDocumentArray.create()
	documents.push(WorkspaceFolderDocument.create(uri, content: content))

	return documents
end 'projectRootsDocument'

export function stagedUnmarkedTree(dirName String) returns FilePath
	let outer = freshOutsideCheckoutDir(dirName)
	let decoyDirectory = createdStagingDirectory(CeilingDecoyDirName, under: outer)
	let folder = createdStagingDirectory(CeilingFolderDirName, under: outer)
	let readerDirectory = createdStagingDirectory(CeilingReaderDirName, under: folder)

	writeCorpusFile(decoyDirectory, fileName: CeilingDecoyFileName, content: CeilingDecoySource)
	writeCorpusFile(readerDirectory, fileName: CeilingReaderFileName, content: CeilingReaderSource)
	writeCorpusFile(readerDirectory, fileName: CeilingNeighbourFileName, content: CeilingNeighbourSource)

	return outer
end 'stagedUnmarkedTree'

export function stagedCeilingTree(dirName String) returns FilePath
	let outer = stagedUnmarkedTree(dirName)
	markedAsAProject(outer)

	return outer
end 'stagedCeilingTree'

export function ceilingFolder(outer FilePath) returns FilePath
	return outer.join(CeilingFolderDirName)
end 'ceilingFolder'

export function ceilingReaderUri(outer FilePath) returns String
	return fileUriOf(ceilingFolder(outer).join(CeilingReaderDirName).join(CeilingReaderFileName))
end 'ceilingReaderUri'

export function ceilingPositions(uri String) returns CorpusProbePointArray
	var positions = projectRootsPosition(CorpusProbePoint.at(uri, line: CeilingOuterCallLine, character: CeilingCallCharacter))
	positions.push(CorpusProbePoint.at(uri, line: CeilingNeighbourCallLine, character: CeilingCallCharacter))

	return positions
end 'ceilingPositions'

export function ceilingProbePair(probes CorpusDefinitionProbeArray, offset ElementIndex) returns (CorpusDefinitionProbe, CorpusDefinitionProbe)
	let outerCall = try probes.get(offset) otherwise panic("project roots: the ceiling positions were probed in pairs and the session answered {probes.count()} probes")
	let neighbourCall = try probes.get(offset + 1) otherwise panic("project roots: the ceiling positions were probed in pairs and the session answered {probes.count()} probes")

	return (outerCall, neighbourCall)
end 'ceilingProbePair'

function ceilingTail(dirName String, path String) returns String
	return "{outsideCheckoutDirName(dirName)}{ProjectRootsSlash}{path}"
end 'ceilingTail'

function requireTheNeighbourResolves(neighbourCall CorpusDefinitionProbe, dirName String, note String) throws TestFailure
	try expectDefinitionInFile(neighbourCall, fileTail: ceilingTail(dirName, path: "{CeilingFolderDirName}{ProjectRootsSlash}{CeilingReaderDirName}{ProjectRootsSlash}{CeilingNeighbourFileName}"), startLine: ProjectRootsDeclarationLine, note: "{note} The call to `neighbour`, declared beside the open document, did not resolve, so the project was never built and the check proves nothing.")
end 'requireTheNeighbourResolves'

function requireTheDecoyResolves(outerCall CorpusDefinitionProbe, dirName String, note String) throws TestFailure
	try expectDefinitionInFile(outerCall, fileTail: ceilingTail(dirName, path: "{CeilingDecoyDirName}{ProjectRootsSlash}{CeilingDecoyFileName}"), startLine: ProjectRootsDeclarationLine, note: "{note} `outerOnly`, declared beside the `.maxproj` above the open document, did not resolve.")
end 'requireTheDecoyResolves'

export function requireTheDocumentIsASingleFile(control CorpusDefinitionProbe, outerCall CorpusDefinitionProbe, neighbourCall CorpusDefinitionProbe, dirName String, note String) throws TestFailure
	try requireTheDecoyResolves(control, dirName: dirName, note: "The control session named no workspace folder, so nothing stops the climb from reaching the `.maxproj` above the open document, and the fixture's `outerOnly` must resolve through it.")
	try expectNoDefinitionInProject(neighbourCall, note: "{note} `neighbour` is declared beside the open document and resolves, so the document's own directory was built for it. A document that no `.maxproj` reaches within its folder is a single file, and no directory is built for one.")
	try expectNoDefinitionInProject(outerCall, note: "{note} `outerOnly` resolves from an unbounded climb, and is declared outside the document's own directory: a document that no `.maxproj` reaches within its folder is a single file.")
end 'requireTheDocumentIsASingleFile'

export function requireClimbReachesTheMaxproj(outerCall CorpusDefinitionProbe, neighbourCall CorpusDefinitionProbe, dirName String, note String) throws TestFailure
	try requireTheNeighbourResolves(neighbourCall, dirName: dirName, note: note)
	try requireTheDecoyResolves(outerCall, dirName: dirName, note: "{note} With no workspace folder left to stop it, the climb reaches the `.maxproj` above.")
end 'requireClimbReachesTheMaxproj'

export function ceilingControl(outer FilePath) returns CorpusDefinitionProbe
	markedAsAProject(outer)

	return probeCorpusDefinitionWithRoot(CorpusSessionRoot.unrooted, uri: ceilingReaderUri(outer), content: CeilingReaderSource, line: CeilingOuterCallLine, character: CeilingCallCharacter)
end 'ceilingControl'

export function listProjectsIn(session ProjectRootsSession, documents WorkspaceFolderDocumentArray) returns ListProjectsProbe
	var client = LspClient.start()
	var probe = ListProjectsProbe.unanswered(UnreportedSessionEnding)

	try 'session'
		openProjectRootsSession(client, session: session)
		client.initialized()

		for document in documents 'eachDocument'
			client.openDocument(document.uri, content: document.content)
			followUpTheOpen(client, document: document)
		end 'eachDocument'

		removeTheSessionsFolders(client, session: session)

		// Asked before the stash is read: its reply follows every notice the opens sent, and a stash
		// read first can miss them, which a test expecting no load reads as a pass.
		let projects = client.listProjects()
		probe = ListProjectsProbe.answered(projects, notices: client.takeProjectLoadingNotices())
	end 'session' otherwise (e) 'failed'
		match e 'reason'
			transportFailed or
			malformedResponse or
			serverRefused then probe = ListProjectsProbe.unanswered("`maxon/listProjects`, which the VS Code extension sends for its status bar, got no answer: {e.explained()}")
		end 'reason'
	end 'failed'

	client.release()

	return probe
end 'listProjectsIn'

function openProjectRootsSession(client LspClient, session ProjectRootsSession) throws LspClientError
	match session 'session'
		atFolders(folders) then _ = try client.initializeAtWorkspaceFolders(folders)
		atFoldersThenRemoved(folders) then _ = try client.initializeAtWorkspaceFolders(folders)
		unrooted then _ = try client.initialize()
	end 'session'
end 'openProjectRootsSession'

function removeTheSessionsFolders(client LspClient, session ProjectRootsSession) throws LspClientError
	match session 'session'
		atFoldersThenRemoved(folders) then try client.changeWorkspaceFolders(WorkspaceFolderRootArray.create(), removed: folders)
		atFolders or
		unrooted then return
	end 'session'
end 'removeTheSessionsFolders'

function followUpTheOpen(client LspClient, document WorkspaceFolderDocument) throws LspClientError
	match document.followUp 'followUp'
		none then return
		definitionAt(line, character) then _ = try client.definition(document.uri, line: line, character: character)
	end 'followUp'
end 'followUpTheOpen'

export function projectRootsPosition(position CorpusProbePoint) returns CorpusProbePointArray
	var positions = CorpusProbePointArray.create()
	positions.push(position)

	return positions
end 'projectRootsPosition'

export function probesAnswered(outcome WorkspaceFolderDefinitionOutcome) returns CorpusDefinitionProbeArray throws TestFailure
	match outcome 'outcome'
		answered(probes) then return probes
		broke(detail) then try Expect.fail(detail)
	end 'outcome'

	panic("project roots: the `broke` arm always throws, so this line is unreachable")
end 'probesAnswered'

export function definitionsAcrossWorkspaceFolders(initialFolders WorkspaceFolderRootArray, addedFolders WorkspaceFolderRootArray, removedFolders WorkspaceFolderRootArray, documents WorkspaceFolderDocumentArray, positions CorpusProbePointArray) returns WorkspaceFolderDefinitionOutcome
	var client = LspClient.start()
	var probes = CorpusDefinitionProbeArray.create()
	var outcome = WorkspaceFolderDefinitionOutcome.broke(UnreportedSessionEnding)

	try 'session'
		_ = client.initializeAtWorkspaceFolders(initialFolders)
		client.initialized()

		if addedFolders.count() > 0 'announceTheAddition'
			client.changeWorkspaceFolders(addedFolders, removed: WorkspaceFolderRootArray.create())
		end 'announceTheAddition'

		for document in documents 'eachDocument'
			client.openDocument(document.uri, content: document.content)
		end 'eachDocument'

		for position in positions 'eachPosition'
			probes.push(corpusProbeOf(client.definition(position.uri, line: position.line, character: position.character)))
		end 'eachPosition'

		if removedFolders.count() > 0 'announceTheRemoval'
			client.changeWorkspaceFolders(WorkspaceFolderRootArray.create(), removed: removedFolders)

			for position in positions 'eachPositionAgain'
				probes.push(corpusProbeOf(client.definition(position.uri, line: position.line, character: position.character)))
			end 'eachPositionAgain'
		end 'announceTheRemoval'

		outcome = WorkspaceFolderDefinitionOutcome.answered(probes)
	end 'session' otherwise (e) 'failed'
		match e 'reason'
			transportFailed or
			malformedResponse then outcome = WorkspaceFolderDefinitionOutcome.broke("the session broke before an answer arrived: {e.explained()}")
			serverRefused(code, message) then outcome = WorkspaceFolderDefinitionOutcome.broke(corpusRefusalSentence(code, message: message))
		end 'reason'
	end 'failed'

	client.release()

	return outcome
end 'definitionsAcrossWorkspaceFolders'

export function soleProbeAnswered(outcome WorkspaceFolderDefinitionOutcome) returns CorpusDefinitionProbe throws TestFailure
	let probes = try probesAnswered(outcome)

	return try probes.get(0) otherwise panic("project roots: one position was probed and the session answered {probes.count()} probes")
end 'soleProbeAnswered'

export function soleProject(result ListProjectsResult, note String) returns ProjectEntry throws TestFailure
	try Expect.equal(result.projects.count(), expected: 1, message: "{note} The server answered {result.projects.count()} projects instead of one, which is what it does when it files every OPEN DOCUMENT as a project of its own instead of asking which project each document belongs to.")

	return try result.projects.get(0) otherwise panic("project roots: the count was just held to one")
end 'soleProject'

export function requireProjectRootedAtADirectory(project ProjectEntry, expectedTail String, note String) throws TestFailure
	let folded = foldedRootPath(project.rootPath)

	try Expect.isFalse(project.rootPath.startsWith(ProjectRootsFileUriPrefix), message: "{note} The rootPath is a URI, and the status bar shows a path: {project.rootPath}")
	try Expect.isFalse(folded.endsWith(ProjectRootsMaxonExtension), message: "{note} The rootPath names a SOURCE FILE rather than a project directory: {project.rootPath}. A project is a tree, and a status bar naming a `.maxon` file is telling the author that every buffer is its own program.")
	try Expect.isTrue(folded.endsWith(expectedTail), message: "{note} The rootPath does not end with the staged project directory {expectedTail}: {project.rootPath}")
	try Expect.isFalse(project.isSingleFile, message: "{note} The project was answered as a SINGLE FILE although it is a directory holding a `.maxproj` and several sources — which is the flag the extension reads to decide whether cross-file answers are available at all.")
end 'requireProjectRootedAtADirectory'

export function requireADriverFileStandsAlone(result ListProjectsResult, notices ProjectLoadingNoticeArray, note String) throws TestFailure
	try requireNoAnnouncedLoad(notices, note: note)

	let project = try soleProject(result, note: note)

	try Expect.isTrue(project.isSingleFile, message: "{note} The document was answered as part of a project rooted at {project.rootPath} rather than as a single file.")
end 'requireADriverFileStandsAlone'

export function requireListedAsTheSingleFile(result ListProjectsResult, notices ProjectLoadingNoticeArray, fileName String, note String) throws TestFailure
	try requireADriverFileStandsAlone(result, notices: notices, note: note)

	let project = try soleProject(result, note: note)

	try Expect.isTrue(foldedRootPath(project.rootPath).endsWith(fileName), message: "{note} The single file listed is {project.rootPath}, not {fileName}.")
end 'requireListedAsTheSingleFile'

export function projectsRootedAt(result ListProjectsResult, expectedTail String) returns ElementIndex
	var found = 0

	for project in result.projects 'eachProject'
		if foldedRootPath(project.rootPath).endsWith(expectedTail) 'thisOne'
			found = found + 1
		end 'thisOne'
	end 'eachProject'

	return found
end 'projectsRootedAt'

export function foldedRootPath(rootPath String) returns String
	return rootPath.replace(ProjectRootsBackslash, with: ProjectRootsSlash)
end 'foldedRootPath'
