let ProjectRootsBackslash = "\\"
let ProjectRootsSlash = "/"
export let ProjectRootsMaxonExtension = ".maxon"
let ProjectRootsFileUriPrefix = "file://"

let ProjectRootsReaderDirName = "reader"
let ProjectRootsHelperDirName = "helper"
let ProjectRootsReaderFileName = "main.maxon"
let ProjectRootsHelperFileName = "helper.maxon"
export let ProjectRootsReaderSource = "function main() returns ExitCode\n\treturn foldedHelper()\nend 'main'\n"
let ProjectRootsHelperSource = "export function foldedHelper() returns ExitCode\n\treturn 0\nend 'foldedHelper'\n"
export let ProjectRootsFillerFileName = "filler.maxon"
export let ProjectRootsFillerSource = "export function firstFolderFiller() returns ExitCode\n\treturn 0\nend 'firstFolderFiller'\n"
export let ProjectRootsCallLine = 1 as LspCoordinate
export let ProjectRootsCallCharacter = 12 as LspCoordinate
export let ProjectRootsDeclarationLine = 0 as LspCoordinate

export union ListProjectsProbe
	answered(result ListProjectsResult, notices ProjectLoadingNoticeArray)
	unanswered(reason String)
end 'ListProjectsProbe'

export union ProjectRootsSession
	atFolders(folders WorkspaceFolderRootArray)
	unrooted
end 'ProjectRootsSession'

export union WorkspaceFolderDefinitionOutcome
	answered(probes CorpusDefinitionProbeArray)
	broke(detail String)
end 'WorkspaceFolderDefinitionOutcome'

export union WorkspaceFolderFollowUp
	none
	definitionAt(line LspCoordinate, character LspCoordinate)
end 'WorkspaceFolderFollowUp'

export type WorkspaceFolderDocument
	export var uri as String
	export var content as String
	export var followUp as WorkspaceFolderFollowUp

	export static function create(uri String, content String) returns WorkspaceFolderDocument
		return Self{uri: uri, content: content, followUp: WorkspaceFolderFollowUp.none}
	end 'create'

	export static function followedByDefinition(uri String, content String, line LspCoordinate, character LspCoordinate) returns WorkspaceFolderDocument
		return Self{uri: uri, content: content, followUp: WorkspaceFolderFollowUp.definitionAt(line, character: character)}
	end 'followedByDefinition'
end 'WorkspaceFolderDocument'

export type WorkspaceFolderProbePosition
	export var uri as String
	export var line as LspCoordinate
	export var character as LspCoordinate

	export static function create(uri String, line LspCoordinate, character LspCoordinate) returns WorkspaceFolderProbePosition
		return Self{uri: uri, line: line, character: character}
	end 'create'
end 'WorkspaceFolderProbePosition'

export typealias WorkspaceFolderDocumentArray = Array with WorkspaceFolderDocument
export typealias WorkspaceFolderProbePositionArray = Array with WorkspaceFolderProbePosition
export typealias CorpusDefinitionProbeArray = Array with CorpusDefinitionProbe

export function projectRootsFolders(first FilePath) returns WorkspaceFolderRootArray
	var folders = WorkspaceFolderRootArray.create()
	folders.push(first)

	return folders
end 'projectRootsFolders'

export function projectRootsFolderPair(first FilePath, second FilePath) returns WorkspaceFolderRootArray
	var folders = projectRootsFolders(first)
	folders.push(second)

	return folders
end 'projectRootsFolderPair'

export function projectRootsDocument(uri String, content String) returns WorkspaceFolderDocumentArray
	var documents = WorkspaceFolderDocumentArray.create()
	documents.push(WorkspaceFolderDocument.create(uri, content: content))

	return documents
end 'projectRootsDocument'

export function stagedCrossDirectoryRoot(dirName String) returns FilePath
	let root = freshOutsideCheckoutDir(dirName)
	let readerDirectory = createdStagingDirectory(ProjectRootsReaderDirName, under: root)
	let helperDirectory = createdStagingDirectory(ProjectRootsHelperDirName, under: root)

	writeCorpusFile(helperDirectory, fileName: ProjectRootsHelperFileName, content: ProjectRootsHelperSource)
	writeCorpusFile(readerDirectory, fileName: ProjectRootsReaderFileName, content: ProjectRootsReaderSource)

	return root
end 'stagedCrossDirectoryRoot'

export function crossDirectoryReaderUri(root FilePath) returns String
	return fileUriOf(root.join("{ProjectRootsReaderDirName}").join("{ProjectRootsReaderFileName}"))
end 'crossDirectoryReaderUri'

export function crossDirectoryHelperTail(dirName String) returns String
	return "{outsideCheckoutDirName(dirName)}{ProjectRootsSlash}{ProjectRootsHelperDirName}{ProjectRootsSlash}{ProjectRootsHelperFileName}"
end 'crossDirectoryHelperTail'

export function listProjectsIn(session ProjectRootsSession, documents WorkspaceFolderDocumentArray) returns ListProjectsProbe
	var client = LspClient.start()
	var probe = ListProjectsProbe.unanswered(UnreportedSessionEnding)

	try 'session'
		openProjectRootsSession(client, session: session)
		client.initialized()

		for document in documents 'eachDocument'
			client.openDocument(document.uri, content: document.content)
			followUpTheOpen(client, document: document)
		end 'eachDocument'

		// Asked before the stash is read: its reply follows every notice the opens sent, and a stash
		// read first can miss them, which a test expecting no load reads as a pass.
		let projects = client.listProjects()
		probe = ListProjectsProbe.answered(projects, notices: client.takeProjectLoadingNotices())
	end 'session' otherwise (e) 'failed'
		match e 'reason'
			transportFailed or
				malformedResponse or
				serverRefused then probe = ListProjectsProbe.unanswered("`maxon/listProjects`, which the VS Code extension sends for its status bar, got no answer: {e.explained()}")
		end 'reason'
	end 'failed'

	client.release()

	return probe
end 'listProjectsIn'

function openProjectRootsSession(client LspClient, session ProjectRootsSession) throws LspClientError
	match session 'session'
		atFolders(folders) then _ = try client.initializeAtWorkspaceFolders(folders)
		unrooted then _ = try client.initialize()
	end 'session'
end 'openProjectRootsSession'

function followUpTheOpen(client LspClient, document WorkspaceFolderDocument) throws LspClientError
	match document.followUp 'followUp'
		none then return
		definitionAt(line, character) then _ = try client.definition(document.uri, line: line, character: character)
	end 'followUp'
end 'followUpTheOpen'

export function projectRootsPosition(position WorkspaceFolderProbePosition) returns WorkspaceFolderProbePositionArray
	var positions = WorkspaceFolderProbePositionArray.create()
	positions.push(position)

	return positions
end 'projectRootsPosition'

export function probesAnswered(outcome WorkspaceFolderDefinitionOutcome) returns CorpusDefinitionProbeArray throws TestFailure
	match outcome 'outcome'
		answered(probes) then return probes
		broke(detail) then try Expect.fail(detail)
	end 'outcome'

	panic("project roots: the `broke` arm always throws, so this line is unreachable")
end 'probesAnswered'

export function definitionsAcrossWorkspaceFolders(initialFolders WorkspaceFolderRootArray, addedFolders WorkspaceFolderRootArray, removedFolders WorkspaceFolderRootArray, documents WorkspaceFolderDocumentArray, positions WorkspaceFolderProbePositionArray) returns WorkspaceFolderDefinitionOutcome
	var client = LspClient.start()
	var probes = CorpusDefinitionProbeArray.create()
	var outcome = WorkspaceFolderDefinitionOutcome.broke(UnreportedSessionEnding)

	try 'session'
		_ = client.initializeAtWorkspaceFolders(initialFolders)
		client.initialized()

		if addedFolders.count() > 0 'announceTheAddition'
			client.changeWorkspaceFolders(addedFolders, removed: WorkspaceFolderRootArray.create())
		end 'announceTheAddition'

		for document in documents 'eachDocument'
			client.openDocument(document.uri, content: document.content)
		end 'eachDocument'

		for position in positions 'eachPosition'
			probes.push(corpusProbeOf(client.definition(position.uri, line: position.line, character: position.character)))
		end 'eachPosition'

		if removedFolders.count() > 0 'announceTheRemoval'
			client.changeWorkspaceFolders(WorkspaceFolderRootArray.create(), removed: removedFolders)

			for position in positions 'eachPositionAgain'
				probes.push(corpusProbeOf(client.definition(position.uri, line: position.line, character: position.character)))
			end 'eachPositionAgain'
		end 'announceTheRemoval'

		outcome = WorkspaceFolderDefinitionOutcome.answered(probes)
	end 'session' otherwise (e) 'failed'
		match e 'reason'
			transportFailed or
				malformedResponse then outcome = WorkspaceFolderDefinitionOutcome.broke("the session broke before an answer arrived: {e.explained()}")
			serverRefused(code, message) then outcome = WorkspaceFolderDefinitionOutcome.broke(corpusRefusalSentence(code, message: message))
		end 'reason'
	end 'failed'

	client.release()

	return outcome
end 'definitionsAcrossWorkspaceFolders'

export function soleProbeAnswered(outcome WorkspaceFolderDefinitionOutcome) returns CorpusDefinitionProbe throws TestFailure
	let probes = try probesAnswered(outcome)

	return try probes.get(0) otherwise panic("project roots: one position was probed and the session answered {probes.count()} probes")
end 'soleProbeAnswered'

export function soleProject(result ListProjectsResult, note String) returns ProjectEntry throws TestFailure
	try Expect.equal(result.projects.count() as AssertedInt, expected: 1, message: "{note} The server answered {result.projects.count()} projects instead of one, which is what it does when it files every OPEN DOCUMENT as a project of its own instead of asking which project each document belongs to.")

	return try result.projects.get(0) otherwise panic("project roots: the count was just held to one")
end 'soleProject'

export function requireProjectRootedAtADirectory(project ProjectEntry, expectedTail String, note String) throws TestFailure
	let folded = foldedRootPath(project.rootPath)

	try Expect.isFalse(project.rootPath.startsWith(ProjectRootsFileUriPrefix), message: "{note} The rootPath is a URI, and the status bar shows a path: {project.rootPath}")
	try Expect.isFalse(folded.endsWith(ProjectRootsMaxonExtension), message: "{note} The rootPath names a SOURCE FILE rather than a project directory: {project.rootPath}. A project is a tree, and a status bar naming a `.maxon` file is telling the author that every buffer is its own program.")
	try Expect.isTrue(folded.endsWith(expectedTail), message: "{note} The rootPath does not end with the staged project directory {expectedTail}: {project.rootPath}")
	try Expect.isFalse(project.isSingleFile, message: "{note} The project was answered as a SINGLE FILE although it is a directory holding a `.maxproj` and several sources — which is the flag the extension reads to decide whether cross-file answers are available at all.")
end 'requireProjectRootedAtADirectory'

export function projectsRootedAt(result ListProjectsResult, expectedTail String) returns AssertedInt
	var found = 0 as AssertedInt

	for project in result.projects 'eachProject'
		if foldedRootPath(project.rootPath).endsWith(expectedTail) 'thisOne'
			found = found + 1
		end 'thisOne'
	end 'eachProject'

	return found
end 'projectsRootedAt'

export function foldedRootPath(rootPath String) returns String
	return rootPath.replace(ProjectRootsBackslash, with: ProjectRootsSlash)
end 'foldedRootPath'
