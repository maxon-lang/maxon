let RootCapRootUriDirName = "root-cap-root-uri"
let RootCapFoldersOnlyDirName = "root-cap-folders-only"

enum RootCapShape
	rootUriOnly
	foldersOnly
end 'RootCapShape'

test 'definition does not root above a rootUri-only client root'
	let outer = stagedCeilingTree(RootCapRootUriDirName)

	let probes = rootCapProbes(outer, shape: RootCapShape.rootUriOnly)
	let control = ceilingControl(outer)

	discardOutsideCheckoutDir(outer)

	let (outerCall, neighbourCall) = ceilingProbePair(probes, offset: 0)

	requireTheDocumentIsASingleFile(control, outerCall: outerCall, neighbourCall: neighbourCall, dirName: RootCapRootUriDirName, note: "the client named the folder in `rootUri` alone, which is what every client written before LSP 3.6 sends.")
end 'definition does not root above a rootUri-only client root'

test 'definition does not root above a workspaceFolders-only client root'
	let outer = stagedCeilingTree(RootCapFoldersOnlyDirName)

	let probes = rootCapProbes(outer, shape: RootCapShape.foldersOnly)
	let control = ceilingControl(outer)

	discardOutsideCheckoutDir(outer)

	let (outerCall, neighbourCall) = ceilingProbePair(probes, offset: 0)

	requireTheDocumentIsASingleFile(control, outerCall: outerCall, neighbourCall: neighbourCall, dirName: RootCapFoldersOnlyDirName, note: "the client sent `rootUri: null` and named the folder in `workspaceFolders` alone, which is what every client written against LSP 3.6 or later sends.")
end 'definition does not root above a workspaceFolders-only client root'

function rootCapProbes(outer FilePath, shape RootCapShape) returns CorpusDefinitionProbeArray
	let folder = ceilingFolder(outer)
	let uri = ceilingReaderUri(outer)

	let sent = match shape 'shape'
		rootUriOnly gives CorpusSessionRoot.rootUriOnly(folder)
		foldersOnly gives CorpusSessionRoot.workspaceFolderOnly(folder)
	end 'shape'

	return probeCorpusDefinitionsWithRoot(sent, uri: uri, content: CeilingReaderSource, points: ceilingPositions(uri))
end 'rootCapProbes'
