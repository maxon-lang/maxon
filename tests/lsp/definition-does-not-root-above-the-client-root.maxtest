// definition-does-not-root-above-the-client-root.maxtest — the `.maxproj` climb may not walk PAST the
// root the client named.
//
// ⭐⭐ **WITHOUT THIS THE CLIENT'S ROOT IS DECORATIVE.** The marker climb is unbounded, so in any checkout
// carrying a manifest at its own root it finds one for every document — and a `rootUri` consulted only
// after it would never decide anything. The rule this pins is the order: the nearest manifest AT OR BELOW
// the client's root, and the client's root when there is none.
//
// The staged tree puts a manifest ABOVE the client root and a SECOND `export function capHelper` beside it,
// outside the root. Rooting too high puts both declarations in one program, which is two visible
// declarations of one bare name — E3095's shape — and the server answers nothing rather than picking.
// Rooting at the client's root sees only the one. So the case discriminates on the ANSWER, not on a
// timing, and it is the decoy that makes it discriminate at all.

let RootCapOuterDirName = "root-cap"
let RootCapDecoyDirName = "decoy"
let RootCapInnerDirName = "inner"
let RootCapReaderDirName = "a"
let RootCapHelperDirName = "b"

let RootCapManifestFileName = "app.maxproj"
let RootCapManifestSource = "export function build() returns ExitCode\n\treturn 0\nend 'build'\n"

let RootCapDecoyFileName = "decoy.maxon"
let RootCapDecoySource = "export function capHelper() returns ExitCode\n\treturn 1\nend 'capHelper'\n"

let RootCapHelperFileName = "helper.maxon"
let RootCapHelperSource = "export function capHelper() returns ExitCode\n\treturn 0\nend 'capHelper'\n"

let RootCapReaderFileName = "main.maxon"
let RootCapReaderSource = "function main() returns ExitCode\n\treturn capHelper()\nend 'main'\n"

let RootCapCallLine = 1 as LspCoordinate
let RootCapCallCharacter = 11 as LspCoordinate
let RootCapDeclarationLine = 0 as LspCoordinate

test 'definition does not root above the client root'
	let outer = freshOutsideCheckoutDir(RootCapOuterDirName)
	let decoyDirectory = createdStagingDirectory(RootCapDecoyDirName, under: outer)
	let inner = createdStagingDirectory(RootCapInnerDirName, under: outer)
	let readerDirectory = createdStagingDirectory(RootCapReaderDirName, under: inner)
	let helperDirectory = createdStagingDirectory(RootCapHelperDirName, under: inner)

	writeCorpusFile(outer, fileName: RootCapManifestFileName, content: RootCapManifestSource)
	writeCorpusFile(decoyDirectory, fileName: RootCapDecoyFileName, content: RootCapDecoySource)
	writeCorpusFile(helperDirectory, fileName: RootCapHelperFileName, content: RootCapHelperSource)
	writeCorpusFile(readerDirectory, fileName: RootCapReaderFileName, content: RootCapReaderSource)

	let uri = fileUriOf(readerDirectory.join(RootCapReaderFileName))
	let probe = probeCorpusDefinitionWithRoot(CorpusSessionRoot.clientRoot(inner), uri: uri, content: RootCapReaderSource, line: RootCapCallLine, character: RootCapCallCharacter)

	discardOutsideCheckoutDir(outer)

	expectDefinitionInFile(probe, fileTail: "{outsideCheckoutDirName(RootCapOuterDirName)}/{RootCapInnerDirName}/{RootCapHelperDirName}/{RootCapHelperFileName}", startLine: RootCapDeclarationLine, note: "a call to `capHelper` did not resolve to the declaration inside the root the client named. A manifest sits one directory ABOVE that root with a second `export function capHelper` beside it, so a walk that climbs past the client's root puts both in one program and answers nothing rather than choosing.")
end 'definition does not root above the client root'
