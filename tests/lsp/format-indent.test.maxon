// format-indent.test.maxon — `textDocument/formatting` on the INDENTATION rules: nesting, type fields,
// else blocks and spaces-instead-of-tabs. Four of the thirteen recovered formatting tests; the other nine
// are in `format-preserves.test.maxon`, `format-constructs.test.maxon` and `format-literals.test.maxon`,
// and all three drive them through the entry point this file exports.
//
// Release discipline — why every session is driven into a VALUE before anything is asserted — is
// stated once, in `LspClient.maxon`'s hazard 1.
//
// ⭐⭐ **THE FIXTURE BYTES ARE THE WHOLE RISK IN THIS FILE.** Every assertion below is a hard-coded
// COLUMN — `"\tvar x"`, `"\nend 'main'"`, `"\t]"` — so one added or trimmed newline, or one leading tab
// that should not be there, shifts all of them at once and the red that follows names nothing. A `b"…"`
// literal is byte-exact: a raw newline in one IS the byte it spells, indentation is neither stripped nor
// added, and the closing quote sits immediately after the last source character so there is no trailing
// newline. The fixtures below are therefore UNINDENTED in this file wherever the document they stand for
// is unindented — which, since the formatter's job here is to ADD indentation, is nearly everywhere.

// The one document every recovered test drives. Its uri never touches the filesystem: full-text sync
// carries the content, so the server is told the text rather than asked to read it.
let FormattingDocumentUri = "file:///test.maxon"

// Every recovered test asks for a tab width of 4. Only `formatting uses spaces when insertSpaces is
// true` asks for it to be spent on SPACES, which is why the width and the character are two arguments.
let FormattingTabSize = 4 as TabWidth

typealias FormattingEditTally = int(0 to i64.max)

// A formatter that changed nothing would legitimately answer with no edits — but every fixture here is
// unindented source the formatter is required to change, so an empty edit list is a wrong answer and not
// a no-op. The recovered harness got this check for free from its `error.NoFormatting`; here it is
// stated, because the port's `edits[0]` would otherwise throw and blame the array.
let MinimumFormattingEdits = 1 as FormattingEditTally

// What one `textDocument/formatting` request answered, or why it could not be asked.
union FormattingProbe
	formatted(editCount FormattingEditTally, text String)
	refused(code JsonRpcErrorCode, message String)
	broke(detail String)
end 'FormattingProbe'

// The formatted document, or a failure naming why there is none to read.
//
// ⚠ The recovered harness FLATTENED the reply, exposing only the first edit's `newText`. LSP returns a
// list, so the flattening is undone here and re-applied in one place: every recovered assertion is about
// the whole-document edit, which is the first and only one a full-document format produces.
export function formattedDocumentText(source String, insertSpaces bool) returns String throws TestFailure
	let probe = probeFormatting(source, insertSpaces: insertSpaces)
	var text = ""

	match probe 'probe'
		formatted(editCount, newText) then text = try wholeDocumentEdit(editCount, newText: newText)
		refused(code, message) then try Expect.fail(formattingRefusalSentence(code, message: message))
		broke(detail) then try Expect.fail("the session broke before an answer arrived: {detail}")
	end 'probe'

	return text
end 'formattedDocumentText'

function wholeDocumentEdit(editCount FormattingEditTally, newText String) returns String throws TestFailure
	let observedEdits = editCount
	let leastEdits = MinimumFormattingEdits
	try Expect.atLeast(observedEdits, than: leastEdits, message: "the server answered `textDocument/formatting` with no edits at all. Every fixture in this file is unindented source the formatter has work to do on, so an empty edit list is a wrong answer rather than 'already formatted'.")
	try Expect.isFalse(newText.isEmpty(), message: "the server answered with an edit whose replacement text is empty, which would delete the document rather than format it.")

	return newText
end 'wholeDocumentEdit'

// Spawn, drive, release. The probe is a VALUE, so no assertion can run before the handle is freed.
function probeFormatting(source String, insertSpaces bool) returns FormattingProbe
	var client = LspClient.start()
	let probe = collectFormatting(client, source: source, insertSpaces: insertSpaces)
	client.release()
	return probe
end 'probeFormatting'

function collectFormatting(client LspClient, source String, insertSpaces bool) returns FormattingProbe
	// Assigned on every path — the body's last statement and each arm of its handler. The sentence is
	// what a reader would be shown if a later edit added a path that reported nothing.
	var probe = FormattingProbe.broke("the request ended without saying how")

	try 'session'
		_ = client.initialize()
		client.initialized()
		client.openDocument(FormattingDocumentUri, content: source)
		let result = client.formatting(FormattingDocumentUri, tabSize: FormattingTabSize, insertSpaces: insertSpaces)
		probe = formattingProbeOf(result)
	end 'session' otherwise (e) 'failed'
		match e 'reason'
			transportFailed(detail) then probe = FormattingProbe.broke("the framed stream broke — {detail}")
			malformedResponse(detail) then probe = FormattingProbe.broke("a reply was not the shape LSP defines for `textDocument/formatting` — {detail}")
			serverRefused(code, message) then probe = FormattingProbe.refused(code, message: message)
		end 'reason'
	end 'failed'

	return probe
end 'collectFormatting'

function formattingProbeOf(result FormattingResult) returns FormattingProbe
	let editCount = result.edits.count()
	if editCount == 0 'noEdits'
		return FormattingProbe.formatted(0, text: "")
	end 'noEdits'

	let firstEdit = try result.edits.get(0) otherwise panic("format-indent: the first edit of a non-empty edit list cannot be out of bounds")
	return FormattingProbe.formatted(editCount, text: firstEdit.newText)
end 'formattingProbeOf'

// ⭐ `-32601` naming `textDocument/formatting` now means the handler STOPPED being served, so the
// sentence says which
// method was refused and what that means — a reader must not read it as a transport fault, and must not
// answer it by editing the assertion.
function formattingRefusalSentence(code JsonRpcErrorCode, message String) returns String
	return "`textDocument/formatting` was refused with JSON-RPC {code}: {message}. The formatting handler IS served, so a refusal here is a REGRESSION — either `formattingServedMethods()` stopped naming the method, or the dispatcher stopped routing it."
end 'formattingRefusalSentence'

// ============================================================================================
// FIXTURES — byte-exact, no trailing newline. Unindented on purpose: adding the indentation is the
// behaviour under test.
// ============================================================================================

function nestedFixture() returns String
	return String.from(b"function main() returns int
var x = 1
if x > 0 'check'
var y = 2
end 'check'
return x
end 'main'")
end 'nestedFixture'

function typeFieldsFixture() returns String
	return String.from(b"type Point
var x int
var y int
end 'Point'")
end 'typeFieldsFixture'

function elseBlockFixture() returns String
	return String.from(b"function test() returns int
if true 'check'
return 1
end 'check' else 'other'
return 0
end 'other'
return 0
end 'test'")
end 'elseBlockFixture'

function flatFixture() returns String
	return String.from(b"function main() returns int
var x = 1
return x
end 'main'")
end 'flatFixture'

// ============================================================================================
// THE TESTS
// ============================================================================================

test 'formatting indents nested code correctly'
	// Code with no indentation - formatter should add proper indentation
	let source = nestedFixture()
	let text = try formattedDocumentText(source, insertSpaces: false)

	// Check that var x is indented
	try Expect.contains(text, needle: "\tvar x", message: "a statement in the function body was not indented one tab.")
	try Expect.contains(text, needle: "\t\tvar y", message: "a statement inside the `if` was not indented two tabs.")
	try Expect.contains(text, needle: "\tend 'check'", message: "the `if`'s own `end` was not returned to the function's level.")
	try Expect.contains(text, needle: "\nend 'main'", message: "the function's `end` did not sit at column 0 on its own line.")
end 'formatting indents nested code correctly'

test 'formatting indents type fields correctly'
	// Type with no indentation on fields
	let source = typeFieldsFixture()
	let text = try formattedDocumentText(source, insertSpaces: false)

	try Expect.contains(text, needle: "\tvar x int", message: "a type's field was not indented one tab.")
	try Expect.contains(text, needle: "\tvar y int", message: "a type's second field was not indented one tab.")
	try Expect.contains(text, needle: "\nend 'Point'", message: "the type's `end` did not sit at column 0 on its own line.")
end 'formatting indents type fields correctly'

test 'formatting handles else blocks correctly'
	// Code with else block - uses correct Maxon syntax: end 'label' else 'else_label'
	let source = elseBlockFixture()
	let text = try formattedDocumentText(source, insertSpaces: false)

	try Expect.contains(text, needle: "\tif true", message: "the `if` was not indented one tab.")
	try Expect.contains(text, needle: "\t\treturn 1", message: "the `if` body was not indented two tabs.")
	try Expect.contains(text, needle: "\tend 'check' else 'other'", message: "the `end … else` line did not sit at the `if`'s own level; `else` shares the line with its `end`, so it cannot be indented as if it opened a new level.")
	try Expect.contains(text, needle: "\tend 'other'", message: "the else block's `end` did not sit at the `if`'s own level.")
end 'formatting handles else blocks correctly'

test 'formatting uses spaces when insertSpaces is true'
	// Code with no indentation
	// With insertSpaces=true and tabSize=4, indentation should be 4 spaces
	//
	// ⚠ The ONLY recovered formatting test that asks for spaces, and it names a gap rather than a
	// preference: shv2's `Formatter.format(source String) returns String` takes neither `tabSize` nor
	// `insertSpaces`, so the handler has to thread both through before this can be answered at all.
	let source = flatFixture()
	let text = try formattedDocumentText(source, insertSpaces: true)

	try Expect.contains(text, needle: "    var x", message: "a statement was not indented with four spaces even though the client asked for spaces at width 4.")
	try Expect.contains(text, needle: "    return x", message: "the `return` was not indented with four spaces.")
	try Expect.isFalse(text.contains("\tvar"), message: "a TAB survived a format the client asked to be done in spaces. An editor configured for spaces gets a file it will re-indent on the next save.")
end 'formatting uses spaces when insertSpaces is true'
