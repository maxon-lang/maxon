let OversizeCaseDirName = "relay-oversize"
let OversizeDocumentName = "one.maxon"
let OversizeDocumentText = "oversize"
let OversizeReportNeedle = "byte limit"

test 'relay: a message longer than the limit ends the compiler that announced it'
	let caseDir = stagedRelayCase(OversizeCaseDirName)
	installRelaySlot(caseDir, generation: 1)

	var client = LspClient.start()

	if let observed = try announcedAnOversizeMessage(client, caseDir: caseDir) 'observed'
		client.release()
		discardStagedDir(caseDir)

		try Expect.equal(observed.0, expected: "{RelayContentModifiedCode}", message: "the request in flight when the compiler announced an oversize message was not refused with the LSP ContentModified code.")
		try Expect.contains(observed.1, needle: OversizeReportNeedle, message: "the client was not told why the compiler was ended.")
	end 'observed' else (e) 'failed'
		abandonedStagedSession(client, staged: caseDir, failure: e, doing: "the session did not complete")
	end 'failed'
end 'relay: a message longer than the limit ends the compiler that announced it'

function announcedAnOversizeMessage(client LspClient, caseDir FilePath) returns (String, String) throws LspClientError
	let uri = fileUriOf(relayCheckout(caseDir).join(OversizeDocumentName))
	_ = try client.initializeAtRoot(relayCheckout(caseDir))

	try client.initialized()
	try client.openDocument(uri, content: OversizeDocumentText)
	_ = try awaitFakePublish(client, uri: uri, generation: 1, text: OversizeDocumentText)

	armRelayOversizeOnHover(caseDir)

	let answer = try relayHoverRefusal(client, uri: uri)
	let report = try client.awaitLogMessage(OversizeReportNeedle, polled: uri)

	return (answer, report)
end 'announcedAnOversizeMessage'
