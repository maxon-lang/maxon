let TierCallProbeFileName = "EditorTierCallProbe.maxon"
let TierCallProbeSource = "module function editorTierCallProbe() returns MachineWord\n\treturn __uptime_ms()\nend 'editorTierCallProbe'\n"

test 'a runtime file may call another tier entry in the editor as in a build'
	let probe = probeRuntimeTierDiagnostics(TierCallProbeFileName, content: TierCallProbeSource)

	expectNoProjectDiagnostics(probe, note: "a buffer under `runtime/` calls `__uptime_ms()`, the reserved entry `runtime/Clock.maxon` declares. A tier file may call a reserved name the program declares, so a build of the same file reports nothing.")
end 'a runtime file may call another tier entry in the editor as in a build'
