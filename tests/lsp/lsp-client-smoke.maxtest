// lsp-client-smoke.maxtest — ONE session that proves the client in `LspClient.maxon` actually talks
// to a real server: lifecycle, document sync, the refusal an unimplemented method answers, and the exit
// code LSP defines for a clean shutdown.
//
// ⭐⭐ **THE REFUSAL IS PART OF THE ASSERTION, NOT A GAP.** LSP requires a method the server does not
// serve to answer `-32601`, and this file pins that rule against a name reserved for the purpose. It is
// what a client relies on to tell "not implemented" apart from "answered nothing".
//
// Release discipline — why every session is driven into a VALUE before anything is asserted — is
// stated once, in `LspClient.maxon`'s hazard 1.
//
// ⛔ Anything that stops the session happening at all PANICS inside `LspClient.start()` (a missing
// binary, a refused spawn). Only a genuine wrong answer reaches an `Expect`.

// The document the session opens. Its URI never touches the filesystem: full-text sync carries the
// content, and the server is told the text rather than asked to read it.
let SmokeDocumentUri = "file:///lsp-client-smoke.maxon"

// The second version `didChange` announces. LSP requires the number to increase, and `didOpen` sent 1.
let SecondDocumentVersion = 2

// JSON-RPC's reserved code for a method the server does not implement, and the wording it answers with.
// A client displays the sentence, so the prefix is pinned alongside the code.
let MethodNotFoundCode = -32601 as JsonRpcErrorCode
let MethodNotFoundMessagePrefix = "Method not found"

// LSP's own rule: the process exits 0 only when the client asked for a shutdown before the session ended.
let CleanExitCode = 0 as ProcessExitCode

test 'the client round-trips a whole LSP session with the language server'
	var client = LspClient.start()

	if let observed = try smokeSession(client) 'completed'
		client.release()
		let (syncAdvertised, refusalCode, refusalMessage, exitCode) = observed
		assertSession(syncAdvertised, refusalCode: refusalCode, refusalMessage: refusalMessage, exitCode: exitCode)
	end 'completed' else (e) 'broke'
		abandonedSession(client, failure: e, doing: "the smoke session did not complete: during the session's lifecycle", afterwards: ". The client spawns `lsp-server` from the CHECKOUT ROOT and speaks Content-Length-framed JSON-RPC over its pipes; a break here is the transport, not a language feature.")
	end 'broke'
end 'the client round-trips a whole LSP session with the language server'

function assertSession(syncAdvertised bool, refusalCode JsonRpcErrorCode, refusalMessage String, exitCode ProcessExitCode) throws TestFailure
	try Expect.isTrue(syncAdvertised, message: "the server's `initialize` reply did not advertise `textDocumentSync`. The client declared support for it, and a server that does not offer it cannot be sent a document at all — so every one of the ten language methods is unreachable behind this one capability.")

	let observedRefusal = refusalCode
	let expectedRefusal = MethodNotFoundCode
	try Expect.equal(observedRefusal, expected: expectedRefusal, message: "an unserved method did not answer JSON-RPC's `method not found`. A server that answers a method it never advertised is answering something it does not implement, and a client has no way to tell. It said: {refusalMessage}")

	try Expect.startsWith(refusalMessage, needle: MethodNotFoundMessagePrefix, message: "the refusal carried the right code with the wrong sentence. A client displays this text.")

	let observedExit = exitCode
	let expectedExit = CleanExitCode
	try Expect.equal(observedExit, expected: expectedExit, message: "the server did not exit 0 after `shutdown` then `exit`. LSP reserves 0 for exactly that order, so a different code means the session ended some other way — and the exit code is the half of this a script reads.")
end 'assertSession'

function smokeSession(client LspClient) returns (bool, JsonRpcErrorCode, String, ProcessExitCode) throws LspClientError
	let advertised = try client.initialize()
	try client.initialized()
	try client.openDocument(SmokeDocumentUri, content: openedDocument())
	try client.changeDocument(SmokeDocumentUri, content: changedDocument(), version: SecondDocumentVersion)

	let (refusalCode, refusalMessage) = try smokeUnservedMethodRefusal(client)

	try client.closeDocument(SmokeDocumentUri)
	try client.shutdown()
	try client.exit()

	let exitCode = try client.waitForExit()

	return (advertised.hasTextDocumentSync, refusalCode, refusalMessage, exitCode)
end 'smokeSession'

// The code and sentence an UNSERVED method answers with. A method that ANSWERS instead is the finding,
// so it is reported as one rather than passing quietly.
//
// ⭐ The subject is the PROTOCOL RULE, which no implementation can retire — a test whose subject is a
// MISSING FEATURE stops being a test the moment someone supplies it. `unservedMethodRefusal` therefore
// sends a name reserved for exactly this and deliberately not an LSP method.
function smokeUnservedMethodRefusal(client LspClient) returns (JsonRpcErrorCode, String) throws LspClientError
	if let answered = try client.unservedMethodRefusal(SmokeDocumentUri) 'answered'
		throw LspClientError.malformedResponse("an UNSERVED method was ANSWERED (present: {answered.isPresent}) where the server must refuse it — a server that answers a method it never advertised is answering something it does not implement")
	end 'answered' else (e) 'refused'
		match e 'reason'
			serverRefused(code, message) then return (code, message)
			transportFailed or
			malformedResponse then throw e
		end 'reason'
	end 'refused'
end 'smokeUnservedMethodRefusal'

// ⚠ A `b"…"` byte literal, closing quote IMMEDIATELY after the last source character: it is byte-exact,
// a raw newline in one IS the byte it spells, and it neither strips indentation nor appends a trailing
// newline. A representation that did either would shift every column a formatting assertion pins.
function openedDocument() returns String
	return String.from(b"function main() returns ExitCode
	return 0
end 'main'")
end 'openedDocument'

function changedDocument() returns String
	return String.from(b"function main() returns ExitCode
	let answer = 41 + 1
	return 0
end 'main'")
end 'changedDocument'
