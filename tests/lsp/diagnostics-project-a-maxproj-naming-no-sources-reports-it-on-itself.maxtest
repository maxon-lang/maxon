let NoSourcesMaxprojDirName = "diagnostics-maxproj-naming-no-sources"
let NoSourcesMaxprojFileName = "app.maxproj"
let NoSourcesMaxprojSource = "export function build() returns ExitCode\n\tBuild.buildWithConfig(BuildConfig.create(StringArray.create(), output: \"program\"))\n\treturn 0\nend 'build'\n"
let NoSourcesRefusalNeedle = "named no sources to compile"
let NoSourcesOneDiagnostic = 1

test 'project diagnostics: a .maxproj whose build names no sources reports it on itself'
	let root = freshOutsideCheckoutDir(NoSourcesMaxprojDirName)
	writeCorpusFile(root, fileName: NoSourcesMaxprojFileName, content: NoSourcesMaxprojSource)

	var client = LspClient.start()

	if let items = try noSourcesRefusal(client, root: root) 'answered'
		client.release()
		discardOutsideCheckoutDir(root)
		expectTheRefusalOnTheProjectFile(items)
	end 'answered' else (e) 'failed'
		abandonedStagedSession(client, staged: root, failure: e, doing: "the session did not complete")
	end 'failed'
end 'project diagnostics: a .maxproj whose build names no sources reports it on itself'

function expectTheRefusalOnTheProjectFile(items PublishedDiagnosticArray) throws TestFailure
	try Expect.equal(items.count(), expected: NoSourcesOneDiagnostic, message: "`{NoSourcesMaxprojFileName}` has one target and it describes a build of no sources, which `maxon build` refuses, so the editor owes that refusal where the file's author is looking rather than a project quietly read as its whole directory.")

	let reported = try items.get(0) otherwise 'noItem'
		try Expect.fail("the count above was 1, so element 0 exists.")
		panic("expectTheRefusalOnTheProjectFile: `Expect.fail` always throws")
	end 'noItem'

	try Expect.contains(reported.message, needle: NoSourcesRefusalNeedle, message: "the one diagnostic published on the project file does not say the build names no sources: {reported.message}")
end 'expectTheRefusalOnTheProjectFile'

function noSourcesRefusal(client LspClient, root FilePath) returns PublishedDiagnosticArray throws LspClientError
	let uri = fileUriOf(root.join(NoSourcesMaxprojFileName))

	_ = try client.initializeAtRoot(root)
	try client.initialized()
	try client.openDocument(uri, content: NoSourcesMaxprojSource)

	let published = try client.awaitPublishOfSize(uri, size: NoSourcesOneDiagnostic)

	return published.items
end 'noSourcesRefusal'
