let RelayedServerCaseDirName = "relay-relayed-server"
let RelayedServerFlag = "--relayed"

test 'relay: a server started relayed serves in process however its checkouts slot compiler stands'
	let caseDir = stagedRelayCase(RelayedServerCaseDirName)
	installRelaySlot(caseDir, generation: 1)

	let client = LspClient.start(extraArguments: [RelayedServerFlag])

	if let served = try identityOfTheRelayedServer(client, caseDir: caseDir) 'served'
		client.release()
		discardStagedDir(caseDir)

		try Expect.notEqual(served, expected: RelayFakeServerName, message: "a server started relayed handed its session to the compiler its checkout's slot holds.")
	end 'served' else (e) 'failed'
		abandonedStagedSession(client, staged: caseDir, failure: e, doing: "the session did not complete")
	end 'failed'
end 'relay: a server started relayed serves in process however its checkouts slot compiler stands'

function identityOfTheRelayedServer(client LspClient, caseDir FilePath) returns String throws LspClientError
	let advertised = try client.initializeAtRoot(relayCheckout(caseDir))

	return try advertised.serverIdentity.serverName()
end 'identityOfTheRelayedServer'
