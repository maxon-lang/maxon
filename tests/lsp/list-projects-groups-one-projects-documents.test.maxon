let GroupedProjectDirName = "maxon-tests-lsp-projects-grouped"
let GroupedProjectReaderFileName = "main.maxon"
let GroupedProjectHelperFileName = "helper.maxon"
let GroupedProjectReaderSource = "function main() returns ExitCode\n\treturn groupedHelper()\nend 'main'\n"
let GroupedProjectHelperSource = "export function groupedHelper() returns ExitCode\n\treturn 0\nend 'groupedHelper'\n"
let GroupedProjectSourceFileCount = 2 as AssertedInt

test 'project roots: two documents of one project are one project'
	let root = stagedProjectDiagnosticsRoot(GroupedProjectDirName)

	writeCorpusFile(root, fileName: GroupedProjectReaderFileName, content: GroupedProjectReaderSource)
	writeCorpusFile(root, fileName: GroupedProjectHelperFileName, content: GroupedProjectHelperSource)

	var documents = projectRootsDocument(fileUriOf(root.join("{GroupedProjectReaderFileName}")), content: GroupedProjectReaderSource)
	documents.push(WorkspaceFolderDocument.create(fileUriOf(root.join("{GroupedProjectHelperFileName}")), content: GroupedProjectHelperSource))

	let probe = listProjectsIn(ProjectRootsSession.atFolders(projectRootsFolders(root)), documents: documents)

	match probe 'probe'
		answered(result) then try requireOneProjectOverBothDocuments(result)
		unanswered(reason) then try Expect.fail(reason)
	end 'probe'
end 'project roots: two documents of one project are one project'

function requireOneProjectOverBothDocuments(result ListProjectsResult) throws TestFailure
	let project = try soleProject(result, note: "two documents of ONE staged project — a `build.maxon` root holding both — were opened in one session, and the client named that directory as its workspace folder.")

	try requireProjectRootedAtADirectory(project, expectedTail: GroupedProjectDirName, note: "two documents of one staged project were opened in one session.")

	try Expect.equal(project.fileCount as AssertedInt, expected: GroupedProjectSourceFileCount, message: "the project reported {project.fileCount} files. The staged root holds exactly {GroupedProjectSourceFileCount} `.maxon` sources beside its `build.maxon` marker, and the server already sweeps that very list to build the corpus it answers definitions out of — so a count that is not {GroupedProjectSourceFileCount} is the status bar describing a program the server is not compiling.")
end 'requireOneProjectOverBothDocuments'
