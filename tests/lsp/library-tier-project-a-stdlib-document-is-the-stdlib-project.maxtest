test 'library tier project: a stdlib document is the one project rooted at the stdlib directory'
	let document = libraryTierFilePathDocument()
	let session = libraryTierSession(libraryTierDocuments(document))
	let note = "`{document.uri}` was opened in a session whose client named the checkout as its workspace folder, and a `textDocument/definition` on a name another stdlib file declares built its project."
	let project = soleProject(libraryTierProjects(session), note: note)

	requireTheLibraryTierProject(project, document: document, note: note)
end 'library tier project: a stdlib document is the one project rooted at the stdlib directory'
