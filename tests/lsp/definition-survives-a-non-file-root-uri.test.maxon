// definition-survives-a-non-file-root-uri.test.maxon — a `rootUri` whose scheme is not `file:` leaves the
// session standing.
//
// ⭐⭐ **THIS IS A CRASH CASE, NOT A RESOLUTION ONE.** Remote-SSH, WSL, dev containers and Codespaces all
// send `vscode-remote://…` as the workspace root, and a root reader that assumes `file:` takes the whole
// process down at `initialize` — before any document is opened, so the editor's language features go dark
// for the entire session rather than answering one request badly. The assertion is therefore that a LATER
// request still gets a real answer: a server that died reaches `expectDefinitionInFile`'s `broke` arm,
// because the framed stream ends instead of replying.
//
// The staged tree carries a `build.maxon`, so the answer rests on the manifest rung alone. That is what a
// client whose root cannot be used has left, and it is the rung this case pins as still working.

let RemoteRootUri = "vscode-remote://ssh-remote+box/work"
let RemoteRootDirName = "temp/lsp/definition-survives-a-non-file-root-uri"
let RemoteRootHelperFileName = "helper.maxon"
let RemoteRootMainFileName = "main.maxon"
let RemoteRootHelperSource = "export function remoteHelper() returns ExitCode\n\treturn 0\nend 'remoteHelper'\n"
let RemoteRootMainSource = "function main() returns ExitCode\n\treturn remoteHelper()\nend 'main'\n"
let RemoteRootHelperTail = "definition-survives-a-non-file-root-uri/helper.maxon"
let RemoteRootCallLine = 1 as LspCoordinate
let RemoteRootCallCharacter = 12 as LspCoordinate
let RemoteRootDeclarationLine = 0 as LspCoordinate

test 'a non-file rootUri does not kill the session'
	let directory = stagedCorpusDirectory(RemoteRootDirName)
	writeCorpusFile(directory, fileName: RemoteRootHelperFileName, content: RemoteRootHelperSource)
	writeCorpusFile(directory, fileName: RemoteRootMainFileName, content: RemoteRootMainSource)

	let uri = fileUriOf(directory.join(RemoteRootMainFileName))
	let probe = probeCorpusDefinitionWithRoot(CorpusSessionRoot.clientRootUri(RemoteRootUri), uri: uri, content: RemoteRootMainSource, line: RemoteRootCallLine, character: RemoteRootCallCharacter)

	try expectDefinitionInFile(probe, fileTail: RemoteRootHelperTail, startLine: RemoteRootDeclarationLine, note: "a session opened with `rootUri: {RemoteRootUri}` did not answer a cross-file definition that the staged `build.maxon` alone decides. A root the server cannot read is not a reason to answer nothing, and it is never a reason to stop serving: every Remote-SSH, WSL, dev container and Codespaces window sends one.")
end 'a non-file rootUri does not kill the session'
