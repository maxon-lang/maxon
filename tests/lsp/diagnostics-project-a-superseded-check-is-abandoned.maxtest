let SupersededCheckDirName = "diagnostics-project-superseded-check"
let SupersededCheckEditedSource = "function main() returns ExitCode\n\treturn 1\nend 'main'\n"
let SupersededCheckEditedVersion = 2

test 'a project check superseded by an edit is abandoned rather than finished first'
	let root = stagedBusyCheckProject(SupersededCheckDirName)

	var client = LspClient.start()

	if let reports = try supersedeTheRunningCheck(client, root: root) 'reported'
		client.release()
		discardOutsideCheckoutDir(root)

		try expectOneProjectCheckOutcome(reports, version: InitialDocumentVersion, outcome: ProjectCheckAbandoned, note: "the edit arrived while the check of the opened version was running past its debounce, so that check was working and must have stopped rather than run to the end.")
		try expectOneProjectCheckOutcome(reports, version: SupersededCheckEditedVersion, outcome: ProjectCheckPublished, note: "the edited version is current and nothing supersedes it, so its check runs and publishes.")
	end 'reported' else (e) 'failed'
		abandonedStagedSession(client, staged: root, failure: e, doing: "the session did not deliver the edited version's project publish and every outcome line through it")
	end 'failed'
end 'a project check superseded by an edit is abandoned rather than finished first'

function supersedeTheRunningCheck(client LspClient, root FilePath) returns ProjectCheckReportArray throws LspClientError
	let uri = fileUriOf(root.join(BusyCheckBufferFileName))

	_ = try client.initializeAtRoot(root)
	try client.initialized()
	try client.openDocument(uri, content: BusyCheckBufferSource)
	_ = try client.awaitPublishedDiagnostics(uri)
	sleep(BusyCheckPastTheDebounceMs)

	try client.changeDocument(uri, content: SupersededCheckEditedSource, version: SupersededCheckEditedVersion)
	_ = try client.awaitProjectCheckPublish(uri)

	return try client.awaitProjectCheckReports(uri, through: SupersededCheckEditedVersion)
end 'supersedeTheRunningCheck'
