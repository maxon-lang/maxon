test 'library tier project: a runtime document is the one project rooted at the runtime directory'
	let document = libraryTierClockDocument()
	let session = libraryTierSession(libraryTierDocuments(document))
	let note = "`{document.uri}` was opened in a session whose client named the checkout as its workspace folder, and a `textDocument/definition` on `MachineWord`, which `runtime/Word.maxon` declares, built its project."
	let project = soleProject(libraryTierProjects(session), note: note)

	requireTheLibraryTierProject(project, document: document, note: note)
end 'library tier project: a runtime document is the one project rooted at the runtime directory'
