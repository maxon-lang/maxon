let ScriptlibCaseDirName = "diagnostics-a-script-calling-a-scriptlib-package"
let ScriptlibScriptDirName = "script"
let ScriptlibScriptFileName = "script.maxon"
let ScriptlibGreetingPackageName = "greeting"
let ScriptlibGreetingPackageFileName = "Greeting.maxon"
let ScriptlibGreetingPackageSource = "public function greeting() returns String\n\treturn \"hello from scriptlib\"\nend 'greeting'\n"
let ScriptlibScriptSource = "#!/usr/bin/env maxon\n\nfunction main() returns ExitCode\n\tprint(\"\{greeting()\}\\n\")\n\treturn 0\nend 'main'\n"

test 'a script calling a scriptlib package function publishes no diagnostics'
	let dir = freshOutsideCheckoutDir(ScriptlibCaseDirName)
	let compiler = stagedLibraryTierCompiler(dir.join(StagedTierDirName), staged: dir)
	writeScriptlibPackageFile(dir.join(StagedTierDirName), package: ScriptlibGreetingPackageName, fileName: ScriptlibGreetingPackageFileName, content: ScriptlibGreetingPackageSource)

	let scriptDir = createdStagingDirectory(ScriptlibScriptDirName, under: dir)
	writeCorpusFile(scriptDir, fileName: ScriptlibScriptFileName, content: ScriptlibScriptSource)
	let uri = fileUriOf(scriptDir.join(ScriptlibScriptFileName))

	var client = LspClient.start(compiler)

	if let items = try scriptDiagnostics(client, uri: uri) 'answered'
		client.release()
		discardOutsideCheckoutDir(dir)
		Expect.equal(items.count(), expected: 0, message: "a script calling `greeting()`, which `scriptlib/{ScriptlibGreetingPackageName}/{ScriptlibGreetingPackageFileName}` beside the server's library declares `public`, published {items.count()} diagnostic(s):{describedScriptlibDiagnostics(items)}. An open script is checked with the scriptlib packages, as `maxon execute` of it compiles them.")
	end 'answered' else (e) 'failed'
		abandonedStagedSession(client, staged: dir, failure: e, doing: "the script was never published for")
	end 'failed'
end 'a script calling a scriptlib package function publishes no diagnostics'

function scriptDiagnostics(client LspClient, uri String) returns PublishedDiagnosticArray throws LspClientError
	_ = try client.initialize()
	try client.initialized()
	try client.openDocument(uri, content: ScriptlibScriptSource)

	let published = try client.awaitPublishedDiagnostics(uri)

	return published.items
end 'scriptDiagnostics'

function describedScriptlibDiagnostics(items PublishedDiagnosticArray) returns String
	var described = ""

	for item in items 'eachItem'
		described.append(" {item.code.describe()} {item.message};")
	end 'eachItem'

	return described
end 'describedScriptlibDiagnostics'
