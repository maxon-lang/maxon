test 'hovering a parameter that is only read shows the capabilities its callers pass'
	let rendering = try hoverAfterTheCheck(parameterProgram(), line: 17, character: 10)

	try Expect.contains(rendering, needle: "Words, any capability (only read) — called here with: mutable (main:24, live), immutable (main:25, frozen)", message: "`describe` only reads `table`, so the compiler infers that it takes any capability. Hover names the capability each call site passes: the live local on line 24 and the frozen one on line 25.")
end 'hovering a parameter that is only read shows the capabilities its callers pass'
