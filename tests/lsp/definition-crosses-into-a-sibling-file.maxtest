// definition-crosses-into-a-sibling-file.maxtest — a call whose `export`ed declaration lives in ANOTHER
// file of the same project resolves INTO that file: the answer's uri is the sibling's, not the open
// document's. The session, the staging and the assertions are `definition-corpus-probe.maxtest`'s.

let SiblingDirName = "temp/lsp/definition-crosses-into-a-sibling-file"
let SiblingHelperFileName = "helper.maxon"
let SiblingMainFileName = "main.maxon"
let SiblingHelperSource = "export function sharedHelper() returns ExitCode\n\treturn 0\nend 'sharedHelper'\n"
let SiblingMainSource = "function main() returns ExitCode\n\treturn sharedHelper()\nend 'main'\n"
let SiblingHelperTail = "definition-crosses-into-a-sibling-file/helper.maxon"
let SiblingCallLine = 1 as LspCoordinate
let SiblingCallCharacter = 12 as LspCoordinate
let SiblingDeclarationLine = 0 as LspCoordinate

test 'definition crosses into a sibling file'
	let directory = stagedCorpusDirectory(SiblingDirName)
	writeCorpusFile(directory, fileName: SiblingHelperFileName, content: SiblingHelperSource)

	let probe = probeCorpusDefinition(directory, fileName: SiblingMainFileName, content: SiblingMainSource, line: SiblingCallLine, character: SiblingCallCharacter)

	expectDefinitionInFile(probe, fileTail: SiblingHelperTail, startLine: SiblingDeclarationLine, note: "a call to an `export`ed declaration in a sibling file did not resolve into the file that declares it.")
end 'definition crosses into a sibling file'
