test 'hovering a method call does not show the prose of a same-named method of another type'
	let rendering = try hoverAfterTheCheck(sameNamedMethodsProgram(), line: 33, character: 15)

	try Expect.contains(rendering, needle: "function fin() returns Count", message: "`gauge.fin()` calls `Gauge.fin`, and the hover is the declaration of that method.")

	Expect.isFalse(rendering.contains("consuming self"), message: "`Gauge.fin` takes no `consuming self`; `Ticket.fin` is another type's method of the same name.")
end 'hovering a method call does not show the prose of a same-named method of another type'
