test 'hovering a binding outside a modify block names its capability'
	let rendering = try hoverAfterTheCheck(windowProgram(), line: 23, character: 16)

	try Expect.contains(rendering, needle: "Words — mutable", message: "`outer` is read after the `modify` block has closed, where it is the mutable local it was declared as. The checker recorded that read, and hover shows it.")

	try Expect.isFalse(rendering.contains("read-only"), message: "no block is open at this read, so nothing about it is read-only.")
end 'hovering a binding outside a modify block names its capability'
