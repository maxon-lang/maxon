let NonFileHoverUri = "git://host/repo/hover.maxon"

let NonFileHoverTypeLine = 1
let NonFileHoverTypeCharacter = 15

test 'hover on a path-less buffer renders a stdlib type'
	let rendering = hoverRenderingAtUri(NonFileHoverUri, source: corpusFilePathSource(), line: NonFileHoverTypeLine, character: NonFileHoverTypeCharacter)

	Expect.contains(rendering, needle: "type FilePath", message: "a cursor on the stdlib type `FilePath` in a buffer opened at `{NonFileHoverUri}` did not hover as the `type FilePath` that `stdlib/FilePath.maxon` declares. A path-less buffer has no project, and it reads the standard library all the same.")
end 'hover on a path-less buffer renders a stdlib type'
