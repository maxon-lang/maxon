let ReplacedCaseDirName = "relay-replaced"
let ReplacedDocumentName = "one.maxon"
let ReplacedClosedDocumentName = "two.maxon"
let ReplacedFirstText = "one"
let ReplacedCurrentText = "two"
let ReplacedClosedText = "gone"
let ReplacedExpectedMessage = "generation 2 saw: two"
let ReplacedExpectedClosedMessage = "generation 2 holds no document"
let ReplacedChangedVersion = 2

test 'relay: a slot compiler replaced mid-session takes over the open documents at their current text'
	let caseDir = stagedRelayCase(ReplacedCaseDirName)
	installRelaySlot(caseDir, generation: 1)

	let client = LspClient.start()

	if let observed = try replacedMidSession(client, caseDir: caseDir) 'replaced'
		client.release()
		discardStagedDir(caseDir)

		try Expect.equal(observed.0, expected: RelayFakeServerName, message: "the initialize reply came from the compiler that was launched, not from the compiler the checkout's slot holds.")
		try Expect.equal(observed.1, expected: ReplacedExpectedMessage, message: "after the slot was replaced, the diagnostics for the open document did not come from the replacement checking the document's current text.")
		try Expect.equal(observed.2, expected: ReplacedExpectedClosedMessage, message: "after the slot was replaced, the replacement was told about a document the client had closed.")
	end 'replaced' else (e) 'failed'
		abandonedStagedSession(client, staged: caseDir, failure: e, doing: "the session did not complete")
	end 'failed'
end 'relay: a slot compiler replaced mid-session takes over the open documents at their current text'

function replacedMidSession(client LspClient, caseDir FilePath) returns (String, String, String) throws LspClientError
	let uri = fileUriOf(relayCheckout(caseDir).join(ReplacedDocumentName))
	let closedUri = fileUriOf(relayCheckout(caseDir).join(ReplacedClosedDocumentName))
	let advertised = try client.initializeAtRoot(relayCheckout(caseDir))
	let served = try advertised.serverIdentity.serverName()

	if served != RelayFakeServerName 'notTheSlot'
		return (served, "", "")
	end 'notTheSlot'

	try client.initialized()
	try client.openDocument(uri, content: ReplacedFirstText)
	_ = try awaitFakePublish(client, uri: uri, generation: 1, text: ReplacedFirstText)

	try client.openDocument(closedUri, content: ReplacedClosedText)
	_ = try awaitFakePublish(client, uri: closedUri, generation: 1, text: ReplacedClosedText)
	try client.closeDocument(closedUri)

	try client.changeDocument(uri, content: ReplacedCurrentText, version: ReplacedChangedVersion)
	_ = try awaitFakePublish(client, uri: uri, generation: 1, text: ReplacedCurrentText)

	replaceRelaySlot(caseDir, generation: 2)
	try relaySlotChanged(client, caseDir: caseDir)

	let current = relayFirstMessage(try awaitFakePublish(client, uri: uri, generation: 2, text: ReplacedCurrentText))
	let closed = relayFirstMessage(try awaitFakeNoDocument(client, uri: closedUri, generation: 2))

	return (served, current, closed)
end 'replacedMidSession'
