let WaitedCaseDirName = "relay-waited"
let WaitedDocumentName = "one.maxon"
let WaitedDocumentText = "waiting"

test 'relay: a checkout with no slot compiler yet is served by the compiler built there later'
	let caseDir = stagedRelayCase(WaitedCaseDirName)

	var client = LspClient.start()

	if let observed = try servedOnceTheSlotAppears(client, caseDir: caseDir) 'waited'
		client.release()
		discardStagedDir(caseDir)

		try Expect.notEqual(observed.0, expected: RelayFakeServerName, message: "a checkout with no slot compiler cannot have been answered by one.")
		try Expect.equal(observed.1, expected: "{RelayContentModifiedCode}", message: "a request made while no compiler served the checkout was not refused with the LSP ContentModified code.")
		try Expect.equal(observed.2, expected: "generation 1 saw: waiting", message: "the compiler built into the slot after the session began did not take over the open document.")
	end 'waited' else (e) 'failed'
		abandonedStagedSession(client, staged: caseDir, failure: e, doing: "the session did not complete")
	end 'failed'
end 'relay: a checkout with no slot compiler yet is served by the compiler built there later'

function servedOnceTheSlotAppears(client LspClient, caseDir FilePath) returns (String, String, String) throws LspClientError
	let uri = fileUriOf(relayCheckout(caseDir).join(WaitedDocumentName))
	let advertised = try client.initializeAtRoot(relayCheckout(caseDir))
	let served = try advertised.serverIdentity.serverName()

	try client.initialized()
	try client.openDocument(uri, content: WaitedDocumentText)

	let refusal = try relayHoverRefusal(client, uri: uri)

	if refusal != "{RelayContentModifiedCode}" 'notWaiting'
		return (served, refusal, "")
	end 'notWaiting'

	installRelaySlot(caseDir, generation: 1)

	return (served, refusal, relayFirstMessage(try awaitFakePublish(client, uri: uri, generation: 1, text: WaitedDocumentText)))
end 'servedOnceTheSlotAppears'
