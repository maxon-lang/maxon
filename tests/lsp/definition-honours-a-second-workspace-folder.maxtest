let SecondFolderFirstDirName = "second-folder-one"
let SecondFolderSecondDirName = "second-folder-two"

test 'project roots: a second workspace folder is a root of its own'
	let first = freshOutsideCheckoutDir(SecondFolderFirstDirName)
	let second = stagedCrossDirectoryRoot(SecondFolderSecondDirName)

	writeCorpusFile(first, fileName: ProjectRootsFillerFileName, content: ProjectRootsFillerSource)

	let uri = crossDirectoryReaderUri(second)
	let outcome = definitionsAcrossWorkspaceFolders(projectRootsFolderPair(first, second: second), addedFolders: WorkspaceFolderRootArray.create(), removedFolders: WorkspaceFolderRootArray.create(), documents: projectRootsDocument(uri, content: ProjectRootsReaderSource), positions: projectRootsPosition(WorkspaceFolderProbePosition.create(uri, line: ProjectRootsCallLine, character: ProjectRootsCallCharacter)))

	discardOutsideCheckoutDir(first)
	discardOutsideCheckoutDir(second)

	let probe = soleProbeAnswered(outcome)

	expectDefinitionInFile(probe, fileTail: crossDirectoryHelperTail(SecondFolderSecondDirName), startLine: ProjectRootsDeclarationLine, note: "the client named TWO workspace folders and the open document sits in the SECOND of them, calling an `export`ed declaration in a sibling directory of that same folder. Nothing in either staged tree holds a `.maxproj`, so the marker climb cannot answer this and the document's own directory does not hold the file — only the second folder being a root can. A server that reads `workspaceFolders[0]` and nothing else leaves every folder but the first out of the workspace entirely, which is every multi-root window an editor opens.")
end 'project roots: a second workspace folder is a root of its own'
