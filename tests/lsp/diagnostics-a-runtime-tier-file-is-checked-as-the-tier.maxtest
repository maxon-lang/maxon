let RuntimeTierDirName = "runtime"
let RuntimeTierFileName = "DebugAgent.maxon"

test 'a runtime tier file opened in the editor publishes no diagnostics'
	let tier = try FilePath.from(RuntimeTierDirName) otherwise panic("runtime tier: '{RuntimeTierDirName}' is not a spellable path")
	let root = tier.resolve(Directory.currentPath())
	let file = root.join(RuntimeTierFileName)
	let content = try File.readText(file) otherwise panic("runtime tier: could not read {file.toString()}")

	let probe = probeProjectDiagnostics(root, fileName: RuntimeTierFileName, content: content)

	try expectNoProjectDiagnostics(probe, note: "`{RuntimeTierDirName}/{RuntimeTierFileName}` is compiled into every program as it stands on disk, so a buffer holding exactly those bytes has nothing wrong with it. A diagnostic here is the editor checking the file as a program of its own rather than as the tier it is.")
end 'a runtime tier file opened in the editor publishes no diagnostics'
