test 'hovering a method that takes consuming self says a call moves the receiver'
	let rendering = try hoverAfterTheCheck(linearProgram(), line: 9, character: 11)

	try Expect.contains(rendering, needle: "takes `consuming self`: a call moves the receiver", message: "`fin` declares `consuming self`, so a call to it consumes the value it is called on.")
end 'hovering a method that takes consuming self says a call moves the receiver'
