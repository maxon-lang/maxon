let UntrustedProjectDirName = "diagnostics-project-untrusted"
let UntrustedProjectSubdirName = "proj"
let UntrustedManifestFileName = "app.maxproj"
let UntrustedMarkerFileName = "manifest-ran.txt"
let UntrustedManifestSource = "export function build() returns ExitCode\n\tlet marker = try FilePath.from(\"manifest-ran.txt\") otherwise return 1\n\ttry File.writeText(marker, content: \"ran\") otherwise return 1\n\tBuild.buildWithConfig(BuildConfig.create([\".\", \"../shared\"], output: \"program\"))\n\treturn 0\nend 'build'\n"
let UntrustedNoteNeedle = "once the workspace is trusted"

test 'project diagnostics: an untrusted workspace never runs the project file and says its source list waits for trust'
	let staged = freshOutsideCheckoutDir(UntrustedProjectDirName)
	let project = staged.join(UntrustedProjectSubdirName)

	if not Directory.create(project) 'couldNotCreate'
		panic("the test could not run: could not create {project.toString()}")
	end 'couldNotCreate'

	writeCorpusFile(project, fileName: UntrustedManifestFileName, content: UntrustedManifestSource)

	var client = LspClient.start()

	if let items = try untrustedManifestDiagnostics(client, project: project) 'answered'
		client.release()

		let ran = File.exists(project.join(UntrustedMarkerFileName))

		discardOutsideCheckoutDir(staged)

		expectOneInformationNote(items)
		Expect.isFalse(ran, message: "an untrusted workspace never runs `{UntrustedManifestFileName}`, but it wrote `{UntrustedMarkerFileName}` beside itself")
	end 'answered' else (e) 'failed'
		abandonedStagedSession(client, staged: staged, failure: e, doing: "the session did not complete")
	end 'failed'
end 'project diagnostics: an untrusted workspace never runs the project file and says its source list waits for trust'

function expectOneInformationNote(items PublishedDiagnosticArray) throws TestFailure
	try Expect.equal(items.count(), expected: 1, message: "an untrusted workspace publishes ONE diagnostic on the project file. It published {items.count()}")

	let note = try items.get(0) otherwise 'noItem'
		try Expect.fail("the count above was 1, so element 0 exists.")
		panic("expectOneInformationNote: `Expect.fail` always throws")
	end 'noItem'

	try Expect.equal(note.severity, expected: PublishedInformationSeverity, message: "the note is informational, not an error: {note.message}")
	try Expect.contains(note.message, needle: UntrustedNoteNeedle, message: "the note does not say the source list applies once the workspace is trusted: {note.message}")
end 'expectOneInformationNote'

function untrustedManifestDiagnostics(client LspClient, project FilePath) returns PublishedDiagnosticArray throws LspClientError
	let uri = fileUriOf(project.join(UntrustedManifestFileName))

	_ = try client.initializeAtRootWithTrust(project, trusted: false)
	try client.initialized()
	try client.openDocument(uri, content: UntrustedManifestSource)

	let published = try client.awaitPublishedDiagnostics(uri)

	return published.items
end 'untrustedManifestDiagnostics'
