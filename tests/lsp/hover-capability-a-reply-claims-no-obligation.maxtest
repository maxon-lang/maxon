test 'hovering a reply held by a parameter claims no obligation the compiler does not track'
	let rendering = try hoverAfterTheCheck(replyProgram(), line: 12, character: 3)

	try Expect.contains(rendering, needle: "TallyReply", message: "`waiting` is a parameter of the alias `TallyReply`, and hover still shows its type.")

	Expect.isFalse(rendering.contains("owed"), message: "the compiler records no answered state for a `Reply` a parameter holds, so hover does not say whether it is still owed.")
end 'hovering a reply held by a parameter claims no obligation the compiler does not track'
