let OpenAnnouncedDirName = "project-loading-on-open"
let OpenAnnouncedFirstFileName = "main.maxon"
let OpenAnnouncedSecondFileName = "helper.maxon"
let OpenAnnouncedFirstSource = "function main() returns ExitCode\n\treturn 0\nend 'main'\n"
let OpenAnnouncedSecondSource = "export function openAnnouncedHelper() returns ExitCode\n\treturn 0\nend 'openAnnouncedHelper'\n"

test 'project loading is announced when a document of an unheld project opens, and not again for its sibling'
	let root = stagedProjectDiagnosticsRoot(OpenAnnouncedDirName)

	writeCorpusFile(root, fileName: OpenAnnouncedFirstFileName, content: OpenAnnouncedFirstSource)
	writeCorpusFile(root, fileName: OpenAnnouncedSecondFileName, content: OpenAnnouncedSecondSource)

	var client = LspClient.start()

	if let notices = try noticesOfTwoOpens(client, root: root) 'observed'
		client.release()
		discardOutsideCheckoutDir(root)
		let (firstOpen, secondOpen) = notices
		requireLoadAnnouncedOnlyByTheFirstOpen(firstOpen, secondOpen: secondOpen)
	end 'observed' else (e) 'failed'
		abandonedStagedSession(client, staged: root, failure: e, doing: "the session broke before the `maxon/projectLoading` notices could be read")
	end 'failed'
end 'project loading is announced when a document of an unheld project opens, and not again for its sibling'

function noticesOfTwoOpens(client LspClient, root FilePath) returns (ProjectLoadingNoticeArray, ProjectLoadingNoticeArray) throws LspClientError
	let firstUri = fileUriOf(root.join(OpenAnnouncedFirstFileName))
	let secondUri = fileUriOf(root.join(OpenAnnouncedSecondFileName))

	_ = try client.initializeAtRoot(root)
	try client.initialized()

	try client.openDocument(firstUri, content: OpenAnnouncedFirstSource)
	_ = try client.awaitPublishedDiagnostics(firstUri)

	let firstOpen = try client.takeProjectLoadingNotices()

	try client.openDocument(secondUri, content: OpenAnnouncedSecondSource)
	_ = try client.awaitPublishedDiagnostics(secondUri)

	let secondOpen = try client.takeProjectLoadingNotices()

	return (firstOpen, secondOpen)
end 'noticesOfTwoOpens'

function requireLoadAnnouncedOnlyByTheFirstOpen(firstOpen ProjectLoadingNoticeArray, secondOpen ProjectLoadingNoticeArray) throws TestFailure
	try requireOneAnnouncedLoad(firstOpen, expectedTail: outsideCheckoutDirName(OpenAnnouncedDirName), note: "`{OpenAnnouncedFirstFileName}`, a clean document in a project the server did not yet hold, was opened and nothing else was asked. The notices were read once its `textDocument/publishDiagnostics` had arrived, and the project is built before the document is checked.")

	try requireNoAnnouncedLoad(secondOpen, note: "`{OpenAnnouncedSecondFileName}`, a second document of the project the first open built, and of the same production view, was opened.")
end 'requireLoadAnnouncedOnlyByTheFirstOpen'
