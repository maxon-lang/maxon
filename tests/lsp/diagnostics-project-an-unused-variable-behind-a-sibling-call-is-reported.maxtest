let ProjectSiblingUnusedDirName = "diagnostics-project-sibling-unused-variable"
let ProjectSiblingUnusedDeclaringFileName = "a.maxon"
let ProjectSiblingUnusedBufferFileName = "b.maxon"
let ProjectSiblingUnusedDeclaringSource = "module function one() returns ExitCode\n\treturn 1\nend 'one'\n"
let ProjectSiblingUnusedBufferSource = "function main() returns ExitCode\n\tlet unused = 5\n\treturn one()\nend 'main'\n"
let ProjectSiblingUnusedCode = "E3012"
let ProjectSiblingUnusedMessage = "unused variable: 'unused'"
let ProjectSiblingUnusedLine = 1 as AssertedInt
let ProjectSiblingUnusedCharacter = 5 as AssertedInt

test 'an unused variable in a buffer that calls a sibling function is reported'
	let root = stagedProjectDiagnosticsRoot(ProjectSiblingUnusedDirName)
	writeCorpusFile(root, fileName: ProjectSiblingUnusedDeclaringFileName, content: ProjectSiblingUnusedDeclaringSource)
	writeCorpusFile(root, fileName: ProjectSiblingUnusedBufferFileName, content: ProjectSiblingUnusedBufferSource)

	let probe = probeProjectCheckDiagnostics(root, fileName: ProjectSiblingUnusedBufferFileName, content: ProjectSiblingUnusedBufferSource, edits: StringArray.create())

	discardOutsideCheckoutDir(root)

	let reported = try onlyProjectDiagnostic(probe, note: "the buffer binds `unused` and never reads it, and returns `one()`, which only the sibling declares. A `maxon build` of the staged project reports exactly one `{ProjectSiblingUnusedCode}` and nothing else.")

	try Expect.equal(reported.code.describe(), expected: ProjectSiblingUnusedCode, message: "the one error a build of this project reports is {ProjectSiblingUnusedCode}; the server published {reported.code.describe()}: {reported.message}")
	try Expect.equal(reported.message, expected: ProjectSiblingUnusedMessage, message: "the server must say what the build says.")
	try Expect.equal(reported.range.startLine as AssertedInt, expected: ProjectSiblingUnusedLine, message: "the build anchors the error on line 2.")
	try Expect.equal(reported.range.startCharacter as AssertedInt, expected: ProjectSiblingUnusedCharacter, message: "the build anchors the error at column 6, the variable's name.")
end 'an unused variable in a buffer that calls a sibling function is reported'
