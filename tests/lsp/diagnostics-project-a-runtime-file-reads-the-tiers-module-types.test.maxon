let RuntimeSlabFileName = "SlabRuntime.maxon"

test 'a runtime file naming another tier files module types is checked cleanly in the editor'
	let probe = probeRuntimeTierDiagnostics(RuntimeSlabFileName, content: runtimeTierFileText(RuntimeSlabFileName))

	try expectNoProjectDiagnostics(probe, note: "`{runtimeTierDocumentName(RuntimeSlabFileName)}` is the runtime tier's own file, unedited, and it names `MachineWord`, which `runtime/Word.maxon` declares `module`. The tier's files share one module directory, so a build of it reports nothing.")
end 'a runtime file naming another tier files module types is checked cleanly in the editor'
