let QuickFixCleanUri = "file:///quick-fix-clean-document.maxon"
let QuickFixCleanSource = "function main() returns ExitCode\n\tlet total = 1\n\treturn total\nend 'main'\n"
let QuickFixCleanLines = 4

test 'a clean document is offered no quick fix'
	let session = runRangeCodeActionSession(QuickFixCleanUri, text: QuickFixCleanSource, range: LspRange.create(0, startCharacter: 0, endLine: QuickFixCleanLines, endCharacter: 0))

	try expectNoActionAtRange(session, note: "the document compiles cleanly, so the server has published nothing to fix, and a code-action request over the whole document must answer no action, a fix-all action included.")
end 'a clean document is offered no quick fix'
