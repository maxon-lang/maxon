// definition-honours-the-client-root.test.maxon — the root the CLIENT sends in `initialize` is what the
// project is rooted at, in BOTH shapes a client sends it: `rootUri`, and the `workspaceFolders` array that
// has superseded it since LSP 3.6. The staged tree carries NO `project.maxon` anywhere, and the declaration
// sits in a SIBLING DIRECTORY of the open document's, so the marker climb has nothing to find and the
// document's own directory does not hold the file: the jump can only land if the client's root is honoured.
//
// ⭐ The two cases differ in ONE thing — the lifecycle call — and share the tree, the position and the
// expectation, because the rule is that the two shapes are the same root. `initialize` still sends
// `rootUri: null` with no folders at all and is the control that keeps the marker climb honest.
//
// The staging is `stagedDirectoryOutsideTheCheckout`'s and the assertions are
// `definition-corpus-probe.test.maxon`'s.

let ClientRootDirName = "maxon-tests-lsp-client-root"
let ClientRootReaderDirName = "maxon-tests-lsp-client-root/a"
let ClientRootHelperDirName = "maxon-tests-lsp-client-root/b"
let ClientRootReaderFileName = "main.maxon"
let ClientRootHelperFileName = "helper.maxon"
let ClientRootReaderSource = "function main() returns ExitCode\n\treturn rootHelper()\nend 'main'\n"
let ClientRootHelperSource = "export function rootHelper() returns ExitCode\n\treturn 0\nend 'rootHelper'\n"
let ClientRootHelperTail = "maxon-tests-lsp-client-root/b/helper.maxon"
let ClientRootCallLine = 1 as LspCoordinate
let ClientRootCallCharacter = 12 as LspCoordinate
let ClientRootDeclarationLine = 0 as LspCoordinate

enum ClientRootShape
	rootUriAndFolders
	foldersOnly
end 'ClientRootShape'

test 'definition honours the client root'
	let probe = clientRootDefinitionProbe(ClientRootShape.rootUriAndFolders)

	try expectDefinitionInFile(probe, fileTail: ClientRootHelperTail, startLine: ClientRootDeclarationLine, note: "a call to an `export`ed declaration in a sibling DIRECTORY of the open document's did not resolve, although the client named their common ancestor as the workspace root. Nothing in the staged tree holds a `project.maxon`, so the marker climb cannot answer this and the document's own directory does not hold the file — the root the client sent is the only thing that can.")
end 'definition honours the client root'

test 'definition honours a workspaceFolders-only client root'
	let probe = clientRootDefinitionProbe(ClientRootShape.foldersOnly)

	try expectDefinitionInFile(probe, fileTail: ClientRootHelperTail, startLine: ClientRootDeclarationLine, note: "the same tree the `rootUri` case resolves did not resolve when the client sent `rootUri: null` and named the root in `workspaceFolders` alone. That is what every client written against LSP 3.6 or later sends, and `rootUri` has been deprecated the whole time; a server that reads only `rootUri` is rooted at nothing for all of them.")
end 'definition honours a workspaceFolders-only client root'

function clientRootDefinitionProbe(shape ClientRootShape) returns CorpusDefinitionProbe
	let root = stagedDirectoryOutsideTheCheckout(ClientRootDirName)
	let readerDirectory = stagedDirectoryOutsideTheCheckout(ClientRootReaderDirName)
	let helperDirectory = stagedDirectoryOutsideTheCheckout(ClientRootHelperDirName)

	writeCorpusFile(helperDirectory, fileName: ClientRootHelperFileName, content: ClientRootHelperSource)
	writeCorpusFile(readerDirectory, fileName: ClientRootReaderFileName, content: ClientRootReaderSource)

	let sent = match shape 'shape'
		rootUriAndFolders gives CorpusSessionRoot.clientRoot(root)
		foldersOnly gives CorpusSessionRoot.workspaceFolderOnly(root)
	end 'shape'

	return probeCorpusDefinitionWithRoot(sent, uri: fileUriOf(readerDirectory.join(ClientRootReaderFileName)), content: ClientRootReaderSource, line: ClientRootCallLine, character: ClientRootCallCharacter)
end 'clientRootDefinitionProbe'
