test 'library tier project: two stdlib documents are listed as one project'
	let first = libraryTierFilePathDocument()
	let second = libraryTierPrintDocument()
	let session = libraryTierSession(libraryTierDocumentPair(first, second: second), asking: LibraryTierAsking.nothingBeyondTheOpen)
	let note = "`{first.uri}` and `{second.uri}` were both opened, and nothing else was asked before `maxon/listProjects`. Both sit in `stdlib/`, which is one project."
	let project = soleProject(libraryTierProjects(session), note: note)

	requireTheLibraryTierProject(project, document: first, note: note)
end 'library tier project: two stdlib documents are listed as one project'
