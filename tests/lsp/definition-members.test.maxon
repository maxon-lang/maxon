// definition-members.test.maxon — `textDocument/definition` on what a TYPE declares: the type name in a
// struct literal, a field reached through one, and an interface named in a conformance. Three of the
// thirteen recovered definition tests; `definition-symbols.test.maxon` holds four and
// `definition-scope.test.maxon` six.
//
// The session, the release discipline and the entry points are `definition-probe.test.maxon`'s.
//
// ⚠ **THE FIXTURES ARE BYTE-EXACT AND SPACE-INDENTED**, because the recovered `(line, character)` pairs
// were hand-counted against exactly that text.

function pointLiteralFixture() returns String
	return String.from(b"type Point
    var x int
    var y int
end 'Point'

function test() returns int
    var p = Point{x: 0, y: 0}
    return 0
end 'test'")
end 'pointLiteralFixture'

function pointFieldWriteFixture() returns String
	return String.from(b"type Point
    var x int
    var y int
end 'Point'

function test() returns int
    var p = Point{x: 0, y: 0}
    p.x = 10
    return p.x
end 'test'")
end 'pointFieldWriteFixture'

function printableFixture() returns String
	return String.from(b"interface Printable
    function print() returns int
end 'Printable'

type Message is Printable
    var text string

    function Printable.print() returns int
        return 42
    end 'print'
end 'Message'")
end 'printableFixture'

test 'definition for struct type'
	// Go to definition on 'Point' type in struct literal (line 6, col 12)
	let source = pointLiteralFixture()
	try expectDefinitionAt(source, line: 6, character: 12, startLine: 0, note: "a type name in a struct literal did not resolve to the type's declaration.")
end 'definition for struct type'

test 'definition for struct field'
	// Go to definition on 'x' field access (line 7, col 6)
	// The answer is the field DECLARATION `    var x int`, not the type's own first line.
	let source = pointFieldWriteFixture()
	try expectDefinitionAt(source, line: 7, character: 6, startLine: 1, note: "a field access did not resolve to the field's declaration line.")
end 'definition for struct field'

test 'definition for interface type'
	// Go to definition on 'Printable' in conformance (line 4, col 18)
	let source = printableFixture()
	try expectDefinitionAt(source, line: 4, character: 18, startLine: 0, note: "an interface named in a conformance did not resolve to the interface's declaration.")
end 'definition for interface type'
