test 'hovering a parameter of a generic function with a witness constraint answers'
	let rendering = try hoverAfterTheCheck(genericProgram(), line: 33, character: 4)

	try Expect.contains(rendering, needle: "Parameter of `larger`.", message: "`a` is typed by the type parameter `T`, which has no type of its own, and the hover must still answer.")
end 'hovering a parameter of a generic function with a witness constraint answers'
