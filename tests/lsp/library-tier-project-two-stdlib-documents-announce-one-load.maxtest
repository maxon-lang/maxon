test 'library tier project: opening two stdlib documents and asking in each announces one load'
	let first = libraryTierFilePathDocument()
	let second = libraryTierPrintDocument()
	let notices = libraryTierNotices(libraryTierSession(libraryTierDocumentPair(first, second: second), asking: LibraryTierAsking.aDefinitionInEach))

	requireOneAnnouncedLoad(notices, expectedTail: libraryTierDirTail(first), note: "`{first.uri}` and `{second.uri}` were opened, each followed by a `textDocument/definition` there. Both reach ONE project, `stdlib/`, which the first open builds and nothing after it builds again.")
end 'library tier project: opening two stdlib documents and asking in each announces one load'
