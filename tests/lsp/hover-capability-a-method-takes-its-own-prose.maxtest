test 'hovering a method call shows the prose of that type method, not a same-named declaration above it'
	let rendering = try hoverAfterTheCheck(sameNamedMethodsProgram(), line: 29, character: 9)

	try Expect.contains(rendering, needle: "takes `consuming self`: a call moves the receiver", message: "`ticket.fin()` calls `Ticket.fin`, which takes `consuming self`. `Gauge.fin` and a free `fin` are declared between it and the call, and neither is the callee.")
end 'hovering a method call shows the prose of that type method, not a same-named declaration above it'
