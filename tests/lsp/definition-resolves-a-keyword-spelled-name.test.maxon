// definition-resolves-a-keyword-spelled-name.test.maxon — a declaration whose NAME is a word the language
// also uses as a keyword resolves like any other. `from` is `TokenKind.from`, and `stdlib/FilePath.maxon`
// declares `public static function from` with it, so a resolver that demanded `TokenKind.identifier` under
// the cursor answered nothing for a name the language explicitly admits (`specs/keyword-as-a-declared-name.md`).
//
// The cross-file half of the same rule is `definition-crosses-into-a-stdlib-member.test.maxon`; this case is
// the IN-BUFFER half, which falls to a different guard.
//
// The session, the release discipline and the entry points are `definition-probe.test.maxon`'s.

function keywordNamedDeclarationFixture() returns String
	return String.from(b"function from(value int) returns int
	return value
end 'from'

function main() returns ExitCode
	return from(0) as ExitCode
end 'main'")
end 'keywordNamedDeclarationFixture'

test 'definition on a call to a keyword-spelled declaration'
	let source = keywordNamedDeclarationFixture()
	expectDefinitionAt(source, line: 5, character: 9, startLine: 0, note: "a call to `from`, a function whose name the language also uses as a keyword, did not resolve to its declaration. `stdlib/FilePath.maxon` declares one, so a resolver that refuses the cursor on it answers nothing for the standard library's own surface.")
end 'definition on a call to a keyword-spelled declaration'
