let AnnouncedLoadDirName = "project-loading-announced"
let AnnouncedLoadHelperFileName = "helper.maxon"
let AnnouncedLoadMainFileName = "main.maxon"
let AnnouncedLoadHelperSource = "export function announcedLoadHelper() returns ExitCode\n\treturn 0\nend 'announcedLoadHelper'\n"
let AnnouncedLoadMainSource = "function main() returns ExitCode\n\treturn announcedLoadHelper()\nend 'main'\n"
let AnnouncedLoadCallLine = 1
let AnnouncedLoadCallCharacter = 12

test 'project loading is announced around the first load'
	let root = stagedProjectDiagnosticsRoot(AnnouncedLoadDirName)

	writeCorpusFile(root, fileName: AnnouncedLoadHelperFileName, content: AnnouncedLoadHelperSource)
	writeCorpusFile(root, fileName: AnnouncedLoadMainFileName, content: AnnouncedLoadMainSource)

	var client = LspClient.start()

	if let notices = try noticesAroundTheFirstLoad(client, root: root, uri: fileUriOf(root.join(AnnouncedLoadMainFileName))) 'observed'
		client.release()
		discardOutsideCheckoutDir(root)
		let (firstLoad, heldProject) = notices
		requireLoadAnnouncedOnlyAroundTheFirstLoad(firstLoad, heldProject: heldProject)
	end 'observed' else (e) 'failed'
		abandonedStagedSession(client, staged: root, failure: e, doing: "the session broke before the `maxon/projectLoading` notices could be read")
	end 'failed'
end 'project loading is announced around the first load'

function noticesAroundTheFirstLoad(client LspClient, root FilePath, uri String) returns (ProjectLoadingNoticeArray, ProjectLoadingNoticeArray) throws LspClientError
	_ = try client.initializeAtRoot(root)
	try client.initialized()
	try client.openDocument(uri, content: AnnouncedLoadMainSource)
	_ = try client.definition(uri, line: AnnouncedLoadCallLine, character: AnnouncedLoadCallCharacter)

	let firstLoad = try client.takeProjectLoadingNotices()

	_ = try client.definition(uri, line: AnnouncedLoadCallLine, character: AnnouncedLoadCallCharacter)

	let heldProject = try client.takeProjectLoadingNotices()

	return (firstLoad, heldProject)
end 'noticesAroundTheFirstLoad'

function requireLoadAnnouncedOnlyAroundTheFirstLoad(firstLoad ProjectLoadingNoticeArray, heldProject ProjectLoadingNoticeArray) throws TestFailure
	try requireOneAnnouncedLoad(firstLoad, expectedTail: outsideCheckoutDirName(AnnouncedLoadDirName), note: "a document was opened in a project the server did not yet hold, and a `textDocument/definition` was asked there; the notices were read once its reply had arrived. The open builds the project and the definition is answered out of it.")

	try requireNoAnnouncedLoad(heldProject, note: "the same `textDocument/definition` was repeated against the project the server already holds.")
end 'requireLoadAnnouncedOnlyAroundTheFirstLoad'
