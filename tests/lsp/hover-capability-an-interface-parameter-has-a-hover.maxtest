test 'hovering a parameter typed by an interface answers'
	let rendering = try hoverAfterTheCheck(genericProgram(), line: 41, character: 9)

	try Expect.contains(rendering, needle: "Parameter of `measure`.", message: "`item` is typed by the interface `Sized`, and the function carries witness positions beside its declared parameters.")
end 'hovering a parameter typed by an interface answers'
