let SecondFolderFirstDirName = "maxon-tests-lsp-second-folder-one"
let SecondFolderSecondDirName = "maxon-tests-lsp-second-folder-two"

test 'project roots: a second workspace folder is a root of its own'
	let first = stagedDirectoryOutsideTheCheckout(SecondFolderFirstDirName)
	let second = stagedCrossDirectoryRoot(SecondFolderSecondDirName)

	writeCorpusFile(first, fileName: ProjectRootsFillerFileName, content: ProjectRootsFillerSource)

	let uri = crossDirectoryReaderUri(second)
	let probe = try definitionAcrossWorkspaceFolders(projectRootsFolderPair(first, second: second), addedFolders: WorkspaceFolderRootArray.create(), documents: projectRootsDocument(uri, content: ProjectRootsReaderSource), position: WorkspaceFolderProbePosition.create(uri, line: ProjectRootsCallLine, character: ProjectRootsCallCharacter))

	try expectDefinitionInFile(probe, fileTail: crossDirectoryHelperTail(SecondFolderSecondDirName), startLine: ProjectRootsDeclarationLine, note: "the client named TWO workspace folders and the open document sits in the SECOND of them, calling an `export`ed declaration in a sibling directory of that same folder. Nothing in either staged tree holds a `build.maxon`, so the marker climb cannot answer this and the document's own directory does not hold the file — only the second folder being a root can. A server that reads `workspaceFolders[0]` and nothing else leaves every folder but the first out of the workspace entirely, which is every multi-root window an editor opens.")
end 'project roots: a second workspace folder is a root of its own'
