let ProjectSemanticErrorDirName = "diagnostics-project-semantic-error"
let ProjectSemanticErrorBufferFileName = "main.maxon"
let ProjectSemanticErrorBufferSource = "function main()\n\treturn\nend 'main'\n"
let ProjectSemanticErrorCode = "E3002"

test 'a semantic error the parse cannot see is still published'
	let root = stagedProjectDiagnosticsRoot(ProjectSemanticErrorDirName)
	writeCorpusFile(root, fileName: ProjectSemanticErrorBufferFileName, content: ProjectSemanticErrorBufferSource)

	let probe = probeProjectDiagnostics(root, fileName: ProjectSemanticErrorBufferFileName, content: ProjectSemanticErrorBufferSource)

	discardOutsideCheckoutDir(root)

	let reported = try onlyProjectDiagnostic(probe, note: "the buffer holds exactly the disk's bytes and LEXES AND PARSES CLEANLY — `main` is a well-formed declaration, and every refusal of it is raised after the parse. A `maxon build` of this very project reports E3002 and nothing else.")

	try Expect.equal(reported.code, expected: ProjectSemanticErrorCode, message: "⛔ AN EMPTY PUBLISH IS A POSITIVE CLAIM THAT THE FILE IS CLEAN. A project view that answers out of the PARSE alone never runs `SemanticCheck`, `TypeResolution`, `ConformanceCheck`, `BorrowCheck` or any other pass below `queryAllModule`, so every error those passes own vanishes the moment the buffer matches disk — the author is told their file is fine while `maxon build` refuses it.")
end 'a semantic error the parse cannot see is still published'
