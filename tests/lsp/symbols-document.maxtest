// symbols-document.maxtest — the recovered `documentSymbol` test: the flat, top-level outline an
// editor draws from a file.
//
// ⚠ **NO REFERENCE IMPLEMENTATION OF THIS METHOD EXISTS ANYWHERE**, so there is no oracle for the
// field values; the numbers below are the whole specification. They are transcribed, not
// re-derived.
//
// Release discipline — why every session is driven into a VALUE before anything is asserted — is
// stated once, in `LspClient.maxon`'s hazard 1.

let SymbolsUri = "file:///test.maxon"

// SymbolKind: struct = 23, function = 12
// Both are LSP's OWN numbers, not indices into anything this server declares — which is what makes the
// literals the assertion rather than a restatement of whatever the server happens to send.
let SymbolsStructKind = 23
let SymbolsFunctionKind = 12

test 'documentSymbol returns symbols'
	var client = LspClient.start()

	if let symbols = try outlineOfPointAndMain(client) 'outlined'
		client.release()
		assertSymbolsOutline(symbols)
	end 'outlined' else (e) 'failed'
		abandonedSession(client, failure: e, doing: "the document-symbol request did not complete")
	end 'failed'
end 'documentSymbol returns symbols'

function outlineOfPointAndMain(client LspClient) returns DocumentSymbolArray throws LspClientError
	_ = try client.initialize()
	try client.initialized()
	try client.openDocument(SymbolsUri, content: symbolsPointAndMainFixture())

	let outline = try client.documentSymbols(SymbolsUri)

	return outline.symbols
end 'outlineOfPointAndMain'

function assertSymbolsOutline(symbols DocumentSymbolArray) throws TestFailure
	// Should have exactly Point type and main function
	//
	// ⚠ The struct's FIELDS `x` and `y` are deliberately not counted: this pins a FLAT, top-level-only
	// outline, so a server that flattened nested members into the same list would fail here.
	let observedCount = symbols.count()
	let expectedCount = 2
	try Expect.equal(observedCount, expected: expectedCount, message: "the outline of a file declaring one type and one function did not hold exactly two top-level symbols.")

	try Expect.isTrue(symbolsContain(symbols, name: "Point", kind: SymbolsStructKind), message: "the outline did not carry `Point` as a struct (SymbolKind 23). The name and the kind are asserted together because a symbol with the right name and the wrong kind draws the wrong icon and sorts into the wrong group.")
	try Expect.isTrue(symbolsContain(symbols, name: "main", kind: SymbolsFunctionKind), message: "the outline did not carry `main` as a function (SymbolKind 12).")
end 'assertSymbolsOutline'

function symbolsContain(symbols DocumentSymbolArray, name String, kind SymbolKindCode) returns bool
	for symbol in symbols 'eachSymbol'
		if symbol.name == name and symbol.kind == kind 'hit'
			return true
		end 'hit'
	end 'eachSymbol'

	return false
end 'symbolsContain'

// ⚠ A `b"…"` byte literal, closing quote IMMEDIATELY after the last source character: it is byte-exact,
// a raw newline in one IS the byte it spells, and it neither strips indentation nor appends a trailing
// newline.
function symbolsPointAndMainFixture() returns String
	return String.from(b"type Point
    var x int
    var y int
end 'Point'

function main() returns int
    return 0
end 'main'")
end 'symbolsPointAndMainFixture'
