// hover-types.test.maxon — hover over a composite TYPE and over the type a call yields: an array of
// structs, a struct literal, a user function's signature, and a local whose type comes from a callee's
// return rather than from its own initializer.
//
// Four of the twenty-four recovered hover tests. `hover-docs.test.maxon` holds the four that hover over
// what a symbol is DOCUMENTED as; the harness is `hover-probe.test.maxon`'s.
//
// ⚠ **POSITIONS AND PINNED STRINGS ARE TRANSCRIBED, NEVER RE-DERIVED.** The pinned substrings ARE the
// specification — there is no other one, so re-baselining them to whatever shv2 emits would be inventing
// the spec and then passing it.

test 'hover shows array of struct type'
	let document = pointsArrayDocument()
	let rendering = try hoverRendering(document, line: 6, character: 8)

	try Expect.contains(rendering, needle: "points", message: "the rendering names the variable it resolved.")

	// ⭐ DIVERGENCE from the recovered `Array of Point`, ruled 2026-09-02 with `Array of int` in
	// `hover-declarations.test.maxon` and for the reason recorded there: `with` is Maxon's own spelling.
	try Expect.contains(rendering, needle: "Array with Point", message: "an array of a USER type names that type as its element. Element rendering that only worked for primitives would pass the `Array with int` case and fail here.")
end 'hover shows array of struct type'

test 'hover shows struct definition'
	let document = pointLiteralDocument()
	let rendering = try hoverRendering(document, line: 6, character: 12)

	try Expect.contains(rendering, needle: "Point", message: "the TYPE NAME in a struct literal hovers as the type. `definition for struct type` asks this same fixture at this same position and expects a jump, so hover and definition agree about what is under the cursor.")
end 'hover shows struct definition'

test 'hover shows user function signature'
	let document = multiplyDocument()
	let rendering = try hoverRendering(document, line: 5, character: 11)

	try Expect.contains(rendering, needle: "function", message: "a call hovers as the function it resolves to.")

	try Expect.contains(rendering, needle: "multiply", message: "the rendering names that function.")

	// ⚠ WEAK, and kept verbatim: single-character needles match almost any rendering — `"y"` matches
	// inside the word `multiply` itself. Recorded so their passing is never mistaken for coverage.
	try Expect.contains(rendering, needle: "x", message: "the first parameter's name is in the signature.")

	try Expect.contains(rendering, needle: "y", message: "the second parameter's name is in the signature.")
end 'hover shows user function signature'

test 'hover shows variable type from intrinsic function call'
	// Line 3: "    var name = String.fromCString(filename)"
	//          0         1         2         3
	//          0123456789012345678901234567890123456789
	//
	// ⭐ RE-POINTED BY RULING, 2026-09-02: the recovered fixture bound `filename` from `__find_filename`,
	// an intrinsic no live compiler has and which shv2 refuses to let an author name at all. `String.cstr`
	// is a live declaration returning `cstring`, so the claim — a binding's type is its CALLEE'S declared
	// return — is asked unchanged. Only lines 1 and 2 changed; line 3 is byte-identical to the recovered
	// one, so the position below is too.
	let document = calleeReturnDocument()
	let rendering = try hoverRendering(document, line: 3, character: 34)

	try Expect.contains(rendering, needle: "filename", message: "the rendering names the variable it resolved.")

	try Expect.contains(rendering, needle: "cstring", message: "a variable's inferred type is the one flowing OUT of the callee that produced it. Inference that stopped at the call boundary would leave this position untyped.")
end 'hover shows variable type from intrinsic function call'

function pointsArrayDocument() returns String
	return String.from(b"type Point
    var x int
    var y int
end 'Point'

function main() returns int
    var points = [Point{x: 1, y: 2}, Point{x: 3, y: 4}]
    return 0
end 'main'")
end 'pointsArrayDocument'

function pointLiteralDocument() returns String
	return String.from(b"type Point
    var x int
    var y int
end 'Point'

function test() returns int
    var p = Point{x: 0, y: 0}
    return 0
end 'test'")
end 'pointLiteralDocument'

function multiplyDocument() returns String
	return String.from(b"function multiply(x int, y int) returns int
    return x * y
end 'multiply'

function main() returns int
    return multiply(3, 4)
end 'main'")
end 'multiplyDocument'

// ⚠ `path` is a bare string literal and `filename` is a call on it, in that order, because BOTH steps are
// the subject: the first is a type a literal gives, the second is a type only the callee's declaration
// can give. Collapsing them into `var filename = \"test\".cstr()` would leave the test passing on the
// literal alone.
function calleeReturnDocument() returns String
	return String.from(b"function test()
    var path = \"test\"
    var filename = path.cstr()
    var name = String.fromCString(filename)
end 'test'")
end 'calleeReturnDocument'
