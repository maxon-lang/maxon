let TierValueProbeFileName = "EditorTierValueProbe.maxon"
let TierValueProbeSource = "module function editorTierValueProbe() returns MachineWord\n\tlet read = __uptime_ms\n\treturn read()\nend 'editorTierValueProbe'\n"

test 'a runtime file may name another tier entry as a value in the editor as in a build'
	let probe = probeRuntimeTierDiagnostics(TierValueProbeFileName, content: TierValueProbeSource)

	expectNoProjectDiagnostics(probe, note: "a buffer under `runtime/` names `__uptime_ms` as a function value. The value door admits a reserved name exactly where the call door does, so a build of the same file reports nothing.")
end 'a runtime file may name another tier entry as a value in the editor as in a build'
