test 'hovering a union after a match moved its payload out names the line of the arm'
	let rendering = try hoverAfterTheCheck(partialMoveProgram(), line: 28, character: 14)

	try Expect.contains(rendering, needle: "moved at line 27", message: "the `holding(words)` arm on line 27 moves the managed payload out of `slot`, so the read after the match is refused. Hover names the line of the arm.")
end 'hovering a union after a match moved its payload out names the line of the arm'
