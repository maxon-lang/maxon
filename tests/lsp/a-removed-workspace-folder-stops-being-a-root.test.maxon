let RemovedFolderFirstDirName = "maxon-tests-lsp-removed-folder-one"
let RemovedFolderSecondDirName = "maxon-tests-lsp-removed-folder-two"

test 'project roots: a removed workspace folder stops being a root'
	let first = stagedDirectoryOutsideTheCheckout(RemovedFolderFirstDirName)
	let second = stagedCrossDirectoryRoot(RemovedFolderSecondDirName)

	writeCorpusFile(first, fileName: ProjectRootsFillerFileName, content: ProjectRootsFillerSource)

	let uri = crossDirectoryReaderUri(second)
	let probes = try definitionsAcrossAWorkspaceFolderRemoval(projectRootsFolderPair(first, second: second), removedFolders: projectRootsFolders(second), documents: projectRootsDocument(uri, content: ProjectRootsReaderSource), position: WorkspaceFolderProbePosition.create(uri, line: ProjectRootsCallLine, character: ProjectRootsCallCharacter))

	let beforeRemoval = try probes.get(0) otherwise panic("project roots: one position was probed on each side of the removal and the session answered {probes.count()} probes")
	let afterRemoval = try probes.get(1) otherwise panic("project roots: one position was probed on each side of the removal and the session answered {probes.count()} probes")

	try expectDefinitionInFile(beforeRemoval, fileTail: crossDirectoryHelperTail(RemovedFolderSecondDirName), startLine: ProjectRootsDeclarationLine, note: "the client named TWO workspace folders and the open document sits in the SECOND of them, calling an `export`ed declaration in a sibling directory of that folder. This is the BEFORE half of the removal, and it is asserted so that the AFTER half is a statement about the removal rather than about a fixture that never resolved: a case whose first answer is already nothing would report an empty second answer as a working removal.")

	try expectNoDefinitionInProject(afterRemoval, note: "the client then sent `workspace/didChangeWorkspaceFolders` REMOVING the folder the open document sits in, and the SAME position still answers. Nothing in either staged tree holds a `build.maxon` and the document's own directory does not hold the declaration, so the only thing that could have answered it a moment ago was that folder being a root — and the server is still treating it as one. A folder an author drops out of an open window must stop deciding what that window can see, both in the named-root list and in the projects already built under it, or the editor keeps answering out of a workspace the author has left.")
end 'project roots: a removed workspace folder stops being a root'
