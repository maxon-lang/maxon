// codeaction-unused.maxtest — the recovered `codeAction` test: that an editor is offered a fix on the
// line holding an unused variable.
//
// ⚠ **THE ACTION'S TITLE IS DELIBERATELY NOT PINNED.** The recovered `CodeActionResult` carried both a
// title and a kind and the test read neither; the suggested wording ("remove unused variable") lived only
// in a comment. Asserting it here would be inventing a specification and then passing it, so the claim
// stays where it was: at least one action is offered. The comment's wording is recorded below so a later
// strengthening has a starting point rather than a blank page.
//
// Release discipline — why every session is driven into a VALUE before anything is asserted — is
// stated once, in `LspClient.maxon`'s hazard 1.

let CodeActionUri = "file:///test.maxon"

test 'code action offers fix for unused variable'
	var client = LspClient.start()

	if let actions = try codeActionsOnTheUnusedLine(client) 'answered'
		client.release()
		assertCodeActionOffered(actions)
	end 'answered' else (e) 'failed'
		abandonedSession(client, failure: e, doing: "the code-action request did not complete")
	end 'failed'
end 'code action offers fix for unused variable'

function codeActionsOnTheUnusedLine(client LspClient) returns CodeActionItemArray throws LspClientError
	_ = try client.initialize()
	try client.initialized()
	try client.openDocument(CodeActionUri, content: codeActionUnusedVariableFixture())

	// Request code actions on the unused variable line
	let offered = try client.codeAction(CodeActionUri, startLine: 1, startCharacter: 4, endLine: 1, endCharacter: 19)

	return offered.actions
end 'codeActionsOnTheUnusedLine'

function assertCodeActionOffered(actions CodeActionItemArray) throws TestFailure
	// Should have at least one code action (e.g., remove unused variable)
	try Expect.greaterThan(actions.count(), than: 0, message: "no code action was offered on the line declaring an unused variable. `var unused = 42` is E3012 in Maxon, so this is the most ordinary quick fix the language has — a server offering nothing here offers nothing anywhere.")
end 'assertCodeActionOffered'

// ⚠ A `b"…"` byte literal, closing quote IMMEDIATELY after the last source character: byte-exact, a raw
// newline in one IS the byte it spells, no indentation stripped and no trailing newline. The requested
// range 1,4 to 1,19 is counted against exactly these bytes.
function codeActionUnusedVariableFixture() returns String
	return String.from(b"function test() returns int
    var unused = 42
    return 0
end 'test'")
end 'codeActionUnusedVariableFixture'
