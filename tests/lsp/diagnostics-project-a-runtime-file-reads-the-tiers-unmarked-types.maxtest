let RuntimeSlabFileName = "SlabRuntime.maxon"

test 'a runtime file naming another tier files unmarked types is checked cleanly in the editor'
	let probe = probeRuntimeTierDiagnostics(RuntimeSlabFileName, content: runtimeTierFileText(RuntimeSlabFileName))

	expectNoProjectDiagnostics(probe, note: "`{runtimeTierDocumentName(RuntimeSlabFileName)}` is the runtime tier's own file, unedited, and it names `MachineWord`, which `runtime/Word.maxon` declares unmarked. The tier's files share one directory, so a build of it reports nothing.")
end 'a runtime file naming another tier files unmarked types is checked cleanly in the editor'
