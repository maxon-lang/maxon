// completion-members.test.maxon — what an editor offers after a dot on an ARRAY and on a STRING. Two of
// the four recovered completion tests; `completion-declarations.test.maxon` holds the struct and enum
// pair, and the session is `completion-probe.test.maxon`'s.
//
// ⛔ **`completion for array methods` DOES NOT PIN THE RECOVERED NAME LIST.** The Zig test pinned 21
// names and asserted the count equalled 21; four of them cannot be offered here — `ensureCapacity`
// (`stdlib/Array.maxon:295`, declared without `public`), `init` (:133, a `public static`, and a static is
// not a member of an instance), and `iterIndex` / `next`, which `Array` no longer has at all. The eight
// names asserted below are a re-verified sample of the surface; the negative is the claim the recovered
// list had backwards.
//
// ⭐ **THE COUNT IS PINNED EXACTLY**, because `greaterThan(0)` is satisfied by a server that offers one
// keyword. It is a fact about THIS TREE — `Array`'s public surface plus what `stdlib/helpers/sort/`
// extends it with — so a stdlib change moves it: RE-MEASURE and re-date `CompletionArrayMemberCount`,
// never widen it back into an inequality.

// How many names the server offers after `arr.` in `completionArrayFixture`. MEASURED 2026-09-02.
let CompletionArrayMemberCount = 49

test 'completion for array methods'
	// Line 2 = "    arr.push(4)" - after "arr." is column 8
	let labels = try completionLabelsFor(completionArrayFixture(), line: 2, character: 8, after: "`arr.`")

	// A SHRUNKEN list (a filter that dropped a real method) and a GROWN one (a private helper leaking
	// through) both land here. Neither reaches an inequality, which is the whole reason the count is exact.
	let observedCount = labels.count()
	let expectedCount = CompletionArrayMemberCount
	try Expect.equal(observedCount, expected: expectedCount, message: "completion after `arr.` offered {observedCount} names where this tree's `Array` surface is {expectedCount}. If the stdlib's public surface genuinely changed, re-measure the constant and re-date it; do not widen this back into `> 0`.")

	try assertCompletionOffersEach(labels, wanted: completionArrayMethodsOfferedToday(), after: "`arr.`")

	// `ensureCapacity` is declared at `stdlib/Array.maxon:295` WITHOUT `public`. It is therefore a
	// negative with teeth rather than the vacuous one the recovered list made of it: the claim is that
	// the server filters by visibility, not that the method is gone.
	try Expect.isFalse(completionOffersLabel(labels, label: "ensureCapacity"), message: "completion after `arr.` offered `ensureCapacity`, which `stdlib/Array.maxon` declares without `public`. A completion list that ignores visibility teaches a caller to write code that will not compile.")
end 'completion for array methods'

test 'completion for string methods'
	let labels = try completionLabelsFor(completionStringFixture(), line: 2, character: 13, after: "`s.`")

	try Expect.greaterThan(labels.count(), than: 0, message: "completion after `s.` offered nothing at all.")

	// `stdlib/String.maxon:223` — `public function cstr() returns cstring`, verified 2026-09-02.
	try Expect.isTrue(completionOffersLabel(labels, label: "cstr"), message: "completion after `s.` did not offer `cstr`, which the third line of the document actually calls.")
end 'completion for string methods'

// Eight names, each verified as a `public function` in `stdlib/Array.maxon` on 2026-09-02 at the line
// noted: push :305, pop :345, count :172, clear :390, insert :355, remove :385, capacity :179,
// isEmpty :184. They are a sample of the surface, not a census of it — pinning the whole list is what
// made the recovered test stale.
function completionArrayMethodsOfferedToday() returns StringArray
	return ["push", "pop", "count", "clear", "insert", "remove", "capacity", "isEmpty"]
end 'completionArrayMethodsOfferedToday'

// ⚠ A `b"…"` byte literal, closing quote IMMEDIATELY after the last source character: it is byte-exact,
// a raw newline in one IS the byte it spells, and it neither strips indentation nor appends a trailing
// newline. Every column above is counted against these bytes.
function completionArrayFixture() returns String
	return String.from(b"function main() returns int
    var arr = [1, 2, 3]
    arr.push(4)
    return 0
end 'main'")
end 'completionArrayFixture'

function completionStringFixture() returns String
	return String.from(b"function main() returns int
    var s = \"hello\"
    return s.cstr()
end 'main'")
end 'completionStringFixture'
