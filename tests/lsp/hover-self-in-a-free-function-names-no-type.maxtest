let FreeSelfFieldLine = 5
let FreeSelfFieldCharacter = 17

test 'hover: self in a free function after a closed type names no type'
	expectNoHover(freeSelfFixture(), line: FreeSelfFieldLine, character: FreeSelfFieldCharacter, note: "hovering `items` in `self.items` inside a free function rendered a member. `Shelf` is closed by its `end` above the function, so `self` there names no type.")
end 'hover: self in a free function after a closed type names no type'

function freeSelfFixture() returns String
	return String.from(b"type Shelf
    var items as StringArray
end 'Shelf'

function peek() returns ExitCode
    return self.items
end 'peek'")
end 'freeSelfFixture'
