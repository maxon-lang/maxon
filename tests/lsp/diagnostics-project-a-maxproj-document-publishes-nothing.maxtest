let MaxprojDocumentDirName = "diagnostics-maxproj-document"
let MaxprojFileName = "app.maxproj"
let MaxprojSource = "export function app() returns ExitCode\n\tBuild.build(\".\")\n\treturn 0\nend 'app'\n\nexport function release_build() returns ExitCode\n\tBuild.build(\".\", output: \"release\")\n\treturn 0\nend 'release_build'\n"
let MaxprojMainFileName = "main.maxon"
let MaxprojMainSource = "function main() returns ExitCode\n\treturn app()\nend 'main'\n\nfunction app() returns ExitCode\n\treturn 0\nend 'app'\n"

test 'project diagnostics: an open .maxproj publishes no diagnostics'
	let root = freshOutsideCheckoutDir(MaxprojDocumentDirName)
	writeCorpusFile(root, fileName: MaxprojFileName, content: MaxprojSource)
	writeCorpusFile(root, fileName: MaxprojMainFileName, content: MaxprojMainSource)

	let probe = probeProjectDiagnostics(root, fileName: MaxprojFileName, content: MaxprojSource)

	discardOutsideCheckoutDir(root)

	expectNoProjectDiagnostics(probe, note: "`{MaxprojFileName}` exports two targets, `app` building `.` with no output and `release_build`, beside a `{MaxprojMainFileName}` that declares a function `app` of its own. It is a well-formed project file: a target states its output or takes the project's name, both targets are entry points the driver calls, and the file is a program of its own rather than a source of the one it describes.")
end 'project diagnostics: an open .maxproj publishes no diagnostics'
