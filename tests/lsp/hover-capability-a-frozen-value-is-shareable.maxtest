test 'hovering a frozen value says it is shareable with other threads'
	let rendering = try hoverAfterTheCheck(frozenProgram(), line: 18, character: 14)

	try Expect.contains(rendering, needle: "immutable Words — frozen: read-only, shareable with other threads", message: "`frozen` holds the result of `freeze`, which the checker records as immutable data at the read.")
end 'hovering a frozen value says it is shareable with other threads'
