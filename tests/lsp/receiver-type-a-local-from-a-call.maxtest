// receiver-type-a-local-from-a-call.maxtest — a local bound by a plain CALL carries the callee's
// declared return type, so a dot on it offers that type's members and a cursor on one of them hovers as
// its declaration. `FilePath.empty` is `stdlib/FilePath.maxon:51`, `public static function empty()
// returns FilePath`; `toString` is `stdlib/FilePath.maxon:195`, `public function toString() returns
// String`.
//
// ⛔ **A CALL IS AN INITIALIZER LIKE ANY OTHER, AND IT IS HOW MOST LOCALS IN THIS TREE GET THEIR
// VALUE.** A walk that types only literal initializers has nothing to say about the majority of a file's
// bindings. Both answers below rest on the callee's DECLARED return type, which is a fact sitting in the
// token stream rather than an inference.
//
// ⭐⭐ **THE TWO HALVES MUST AGREE, WHICH IS WHY BOTH ARE ASSERTED ON ONE BUFFER.** Completion and hover
// reach `FilePath` through the same receiver walk; asserting only one of them would leave the other free
// to answer differently about the same line with nothing reporting it.
//
// ⚠ A `b"…"` byte literal, closing quote IMMEDIATELY after the last source character: byte-exact, no
// indentation stripped or added and no trailing newline. Both columns below are counted against these
// bytes.

let ReceiverCallLine = 2 as LspCoordinate
let ReceiverCallMemberListCharacter = 12 as LspCoordinate
let ReceiverCallMemberNameCharacter = 15 as LspCoordinate

test 'receiver type: a local from a call offers its members'
	let labels = completionLabelsFor(receiverCallFixture(), line: ReceiverCallLine, character: ReceiverCallMemberListCharacter, after: "`p.`, where `p` is bound by `FilePath.empty()`")

	Expect.greaterThan(labels.count(), than: 0, message: "completion after `p.` offered nothing at all, where `p` is bound by `FilePath.empty()`. A call is how most locals in this tree get their value.")

	Expect.isTrue(completionOffersLabel(labels, label: "toString"), message: "completion after `p.` did not offer `toString`, which `stdlib/FilePath.maxon` declares `public` and which the very next characters of the fixture call.")
end 'receiver type: a local from a call offers its members'

test 'receiver type: a member of a local from a call hovers'
	let rendering = hoverRendering(receiverCallFixture(), line: ReceiverCallLine, character: ReceiverCallMemberNameCharacter)

	Expect.contains(rendering, needle: "toString", message: "hovering `toString` in `p.toString()` did not name it. Hover and completion reach `p` through ONE walk, so the case above and this one must agree about what `p` is — a red in only one of them is the two doors come apart.")

	Expect.contains(rendering, needle: "function toString", message: "the hover did not render the declaration `stdlib/FilePath.maxon` holds for `toString`. It rendered: {rendering}")
end 'receiver type: a member of a local from a call hovers'

function receiverCallFixture() returns String
	return String.from(b"function main() returns ExitCode
    let p = FilePath.empty()
    print(p.toString())
    return 0
end 'main'")
end 'receiverCallFixture'
