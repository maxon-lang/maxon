// receiver-type-a-loop-variable.maxtest — the variable a `for … in` binds carries the ELEMENT type
// of the collection it walks, so hovering it names that type.
//
// ⛔ **A `for` HEADER IS A BINDING SITE THOUGH IT IS NEITHER A `let` NOR A `var` LINE.** A loop variable
// is the receiver the body of every loop is written against, so a walk that reads only the two keyword
// forms has nothing to say anywhere inside a loop.
//
// ⭐ The claim is the ELEMENT type, matched to what hover renders for a local whose type IS known:
// `hover shows array of struct type` reads `Array with Point` off `var points = [Point{…}, …]`, so a
// collection's element is something the server can name. `names` here is bound by an ARRAY LITERAL,
// which the walk types directly — leaving the loop header as the only thing this case puts under test.
//
// ⚠ A `b"…"` byte literal, closing quote IMMEDIATELY after the last source character: byte-exact, no
// indentation stripped or added and no trailing newline. The column below is counted against these bytes.

let ReceiverLoopLine = 2 as LspCoordinate
let ReceiverLoopCharacter = 9 as LspCoordinate

test 'receiver type: a loop variable names its element type'
	let rendering = hoverRendering(receiverLoopFixture(), line: ReceiverLoopLine, character: ReceiverLoopCharacter)

	Expect.contains(rendering, needle: "item", message: "hovering the loop variable `item` did not name it.")

	Expect.contains(rendering, needle: "String", message: "the hover did not name the ELEMENT type of the collection the loop walks. `names` is an array of string literals, so `item` is a `String`, and a loop variable with no type is a loop body with no completion. It rendered: {rendering}")
end 'receiver type: a loop variable names its element type'

function receiverLoopFixture() returns String
	return String.from(b"function main() returns ExitCode
    let names = [\"alpha\", \"beta\"]
    for item in names 'each'
        print(item)
    end 'each'
    return 0
end 'main'")
end 'receiverLoopFixture'
