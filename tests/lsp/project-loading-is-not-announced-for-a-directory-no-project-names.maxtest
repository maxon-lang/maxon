let BareDirectoryDirName = "project-loading-bare-directory"
let BareDirectoryMainFileName = "main.maxon"
let BareDirectoryHelperFileName = "helper.maxon"
let BareDirectoryMainSource = "function main() returns ExitCode\n\treturn 0\nend 'main'\n"
let BareDirectoryHelperSource = "export function bareDirectoryHelper() returns ExitCode\n\treturn 0\nend 'bareDirectoryHelper'\n"

test 'project loading: opening a document in a directory no maxproj names is a single file and builds nothing'
	let root = freshOutsideCheckoutDir(BareDirectoryDirName)

	writeCorpusFile(root, fileName: BareDirectoryMainFileName, content: BareDirectoryMainSource)
	writeCorpusFile(root, fileName: BareDirectoryHelperFileName, content: BareDirectoryHelperSource)

	let probe = listProjectsIn(ProjectRootsSession.unrooted, documents: projectRootsDocument(fileUriOf(root.join(BareDirectoryMainFileName)), content: BareDirectoryMainSource))

	discardOutsideCheckoutDir(root)

	match probe 'probe'
		answered(projects, notices) then requireTheDocumentStandsAlone(notices, projects: projects)
		unanswered(reason) then Expect.fail(reason)
	end 'probe'
end 'project loading: opening a document in a directory no maxproj names is a single file and builds nothing'

function requireTheDocumentStandsAlone(notices ProjectLoadingNoticeArray, projects ListProjectsResult) throws TestFailure
	let note = "`{BareDirectoryMainFileName}` was opened in a session that named no workspace folder, in a staged directory holding a sibling `{BareDirectoryHelperFileName}` and no `.maxproj`, and `maxon/listProjects` was asked after it. Only a `.maxproj` marks a project, so the document's own directory is not one: the document is a single file, checked against the library alone, and nothing is built for it."

	try requireListedAsTheSingleFile(projects, notices: notices, fileName: BareDirectoryMainFileName, note: note)
end 'requireTheDocumentStandsAlone'
