test 'hovering self.fin() shows the method, not the free function of the same name'
	let rendering = try hoverAfterTheCheck(freeFunctionAndMethodProgram(), line: 20, character: 15)

	try Expect.contains(rendering, needle: "function fin() returns Count", message: "`self.fin()` calls the method `Gauge.fin`.")

	Expect.isFalse(rendering.contains("function fin(code Count) returns Count"), message: "The free `fin` is not what a call through `self` names.")
end 'hovering self.fin() shows the method, not the free function of the same name'
