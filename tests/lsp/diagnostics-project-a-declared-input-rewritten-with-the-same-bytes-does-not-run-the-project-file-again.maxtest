test 'project diagnostics: a declared input rewritten with the same bytes does not run the project file again'
	let staged = stagedDeclaredInputsProject(InputDeclaration.declaredAndGated, plan: PlanFile.listing(DeclaredInputsNoListing))

	let runs = runsAfterAnIdenticalRewrite(staged)

	Expect.equal(runs, expected: 1, message: "`{DeclaredInputsPlanFileName}` was rewritten with the bytes it already held, so its modified time moved and its content did not. The project file ran {runs} time(s); the answer it produced still holds.")
end 'project diagnostics: a declared input rewritten with the same bytes does not run the project file again'
