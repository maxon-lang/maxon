let MaxprojDeclaresDirName = "diagnostics-maxproj-declares-nothing-for-its-project"
let MaxprojFileName = "app.maxproj"
let MaxprojSource = "export function app() returns ExitCode\n\treturn 0\nend 'app'\n"
let MaxprojMainFileName = "main.maxon"
let MaxprojMainSource = "function main() returns ExitCode\n\treturn app()\nend 'main'\n"
let MaxprojMainPublished = "E3004@1"

test 'project diagnostics: a function a .maxproj declares is not declared for the project it marks'
	let root = freshOutsideCheckoutDir(MaxprojDeclaresDirName)
	writeCorpusFile(root, fileName: MaxprojFileName, content: MaxprojSource)
	writeCorpusFile(root, fileName: MaxprojMainFileName, content: MaxprojMainSource)

	var client = LspClient.start()
	let probe = collectMainAfterTheProjectFile(client, root: root)
	client.release()

	discardOutsideCheckoutDir(root)

	expectProjectDiagnosticCodesAndLines(probe, expected: MaxprojMainPublished, note: "`{MaxprojFileName}` was opened, then the project's `{MaxprojMainFileName}`, which calls `app`. Only the project file declares `app`, and a project file is a program of its own that no build of the project compiles, so `maxon build` refuses the call and the editor must too.")
end 'project diagnostics: a function a .maxproj declares is not declared for the project it marks'

function collectMainAfterTheProjectFile(client LspClient, root FilePath) returns ProjectDiagnosticsProbe
	if let items = try mainDiagnosticsAfterTheProjectFile(client, root: root) 'answered'
		return ProjectDiagnosticsProbe.published(items)
	end 'answered' else (e) 'failed'
		return ProjectDiagnosticsProbe.broke(e.explained())
	end 'failed'
end 'collectMainAfterTheProjectFile'

function mainDiagnosticsAfterTheProjectFile(client LspClient, root FilePath) returns PublishedDiagnosticArray throws LspClientError
	let projectFileUri = fileUriOf(root.join(MaxprojFileName))
	let mainUri = fileUriOf(root.join(MaxprojMainFileName))

	_ = try client.initializeAtRootUri(fileUriOf(root))
	try client.initialized()

	try client.openDocument(projectFileUri, content: MaxprojSource)
	_ = try client.awaitPublishedDiagnostics(projectFileUri)

	try client.openDocument(mainUri, content: MaxprojMainSource)

	let published = try client.awaitPublishedDiagnostics(mainUri)

	return published.items
end 'mainDiagnosticsAfterTheProjectFile'
