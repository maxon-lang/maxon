let ProjectSiblingConformanceDirName = "diagnostics-project-sibling-partial-implementation"
let ProjectSiblingConformanceDeclaringFileName = "a.maxon"
let ProjectSiblingConformanceBufferFileName = "b.maxon"
let ProjectSiblingConformanceDeclaringSource = "module interface Shape\n\tfunction area() returns ExitCode\nend 'Shape'\n"
let ProjectSiblingConformanceBufferSource = "type Square implements Shape\n\tlet side as ExitCode\n\n\tfunction area() returns bool\n\t\treturn true\n\tend 'area'\nend 'Square'\n\nfunction main() returns ExitCode\n\treturn 0\nend 'main'\n"
let ProjectSiblingConformanceCode = "E3016"
let ProjectSiblingConformanceMessage = "Partial interface implementation: type 'Square' has 1 method(s) with wrong signature:\n  - area() returns bool (expected area() returns ExitCode)"
let ProjectSiblingConformanceLine = 0
let ProjectSiblingConformanceCharacter = 5

test 'a partial implementation of an interface a sibling file declares is reported'
	let root = stagedProjectDiagnosticsRoot(ProjectSiblingConformanceDirName)
	writeCorpusFile(root, fileName: ProjectSiblingConformanceDeclaringFileName, content: ProjectSiblingConformanceDeclaringSource)
	writeCorpusFile(root, fileName: ProjectSiblingConformanceBufferFileName, content: ProjectSiblingConformanceBufferSource)

	let probe = probeProjectCheckDiagnostics(root, fileName: ProjectSiblingConformanceBufferFileName, content: ProjectSiblingConformanceBufferSource, edits: StringArray.create())

	discardOutsideCheckoutDir(root)

	let reported = try onlyProjectDiagnostic(probe, note: "`Square` implements the sibling's `Shape` with an `area()` returning `bool` where `Shape` requires `ExitCode`. A `maxon build` of the staged project reports exactly one `{ProjectSiblingConformanceCode}` and nothing else — in particular no unknown interface, since the sibling declares `Shape`.")

	try Expect.equal(reported.code.describe(), expected: ProjectSiblingConformanceCode, message: "the one error a build of this project reports is {ProjectSiblingConformanceCode}; the server published {reported.code.describe()}: {reported.message}")
	try Expect.equal(reported.message, expected: ProjectSiblingConformanceMessage, message: "the server must say what the build says.")
	try Expect.equal(reported.range.startLine, expected: ProjectSiblingConformanceLine, message: "the build anchors the error on line 1.")
	try Expect.equal(reported.range.startCharacter, expected: ProjectSiblingConformanceCharacter, message: "the build anchors the error at column 6, the type's name.")
end 'a partial implementation of an interface a sibling file declares is reported'
