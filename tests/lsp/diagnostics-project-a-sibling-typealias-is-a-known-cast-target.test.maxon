// diagnostics-project-a-sibling-typealias-is-a-known-cast-target.test.maxon — a `typealias` a SIBLING FILE
// `export`s is a type this buffer may cast to, so `1 as Slot` publishes NOTHING.
//
// ⛔ **THE SAME CAUSE AS THE SIBLING-ENUM CASE, RENDERED AS A DIFFERENT CODE.** Both are `ParseError`s
// gated on `Parser.signatures`; here `denotedNamedType` finds no registry arm and throws `unknownTypeName`,
// which reaches the author as `E3011: Unknown type '…'`. MEASURED on this repository's own source, at
// `maxon-bin/Compiler/Lsp/LspHover.maxon:43:24`, against `export typealias ColumnNumber` in
// `maxon-bin/Compiler/Lexer.maxon`.
//
// The staged project is a REAL one: it builds, so a red here cannot mean the fixture is broken. The
// session, the staging and the assertions are `diagnostics-project-probe.test.maxon`'s.

let ProjectSiblingAliasDirName = "diagnostics-project-sibling-alias"
let ProjectSiblingAliasDeclaringFileName = "slot.maxon"
let ProjectSiblingAliasBufferFileName = "main.maxon"
let ProjectSiblingAliasDeclaringSource = "export typealias ProjectSiblingSlot = int(0 to u64.max)\n"
let ProjectSiblingAliasBufferSource = "function main() returns ExitCode\n\tlet n = 1 as ProjectSiblingSlot\n\treturn n as ExitCode\nend 'main'\n"

test 'a typealias a sibling file exports is a known cast target'
	let root = stagedProjectDiagnosticsRoot(ProjectSiblingAliasDirName)
	writeCorpusFile(root, fileName: ProjectSiblingAliasDeclaringFileName, content: ProjectSiblingAliasDeclaringSource)
	writeCorpusFile(root, fileName: ProjectSiblingAliasBufferFileName, content: ProjectSiblingAliasBufferSource)

	let probe = probeProjectDiagnostics(root, fileName: ProjectSiblingAliasBufferFileName, content: ProjectSiblingAliasBufferSource)

	discardOutsideCheckoutDir(root)

	expectNoProjectDiagnostics(probe, note: "`ProjectSiblingSlot` is `export typealias`ed by the sibling file of this project, and a `maxon build` of the staged project compiles the cast. A buffer compiled against `stdlib/` and `runtime/` ALONE cannot see the declaration, so every `as` onto a project's own type carries a red squiggle.")
end 'a typealias a sibling file exports is a known cast target'
