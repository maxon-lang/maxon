let PrivateLetSiblingDirName = "definition-refuses-an-unmarked-let-of-a-sibling-directory"
let PrivateLetSiblingHiddenFileName = "lib/private.maxon"
let PrivateLetSiblingMainFileName = "main.maxon"
let PrivateLetSiblingUseLine = 1
let PrivateLetSiblingUseCharacter = 13

test 'definition refuses an unmarked module-level let of a sibling directory'
	let directory = stagedCorpusDirectory(PrivateLetSiblingDirName)
	writeCorpusFile(directory, fileName: PrivateLetSiblingHiddenFileName, content: privateLetSiblingHiddenSource())

	let probe = probeCorpusDefinition(directory, fileName: PrivateLetSiblingMainFileName, content: privateLetSiblingMainSource(), line: PrivateLetSiblingUseLine, character: PrivateLetSiblingUseCharacter)

	discardStagedDir(directory)

	expectNoDefinitionInProject(probe, note: "a bare `reading` named an unmarked `let` of `lib/`, which nothing outside that directory may see, and the server jumped to it anyway.")
end 'definition refuses an unmarked module-level let of a sibling directory'

function privateLetSiblingHiddenSource() returns String
	return String.from(b"let reading = 0
")
end 'privateLetSiblingHiddenSource'

function privateLetSiblingMainSource() returns String
	return String.from(b"function main() returns ExitCode
    return reading
end 'main'
")
end 'privateLetSiblingMainSource'
