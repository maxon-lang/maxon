// hover-crosses-into-the-stdlib.test.maxon — a cursor on a bare call to a stdlib FREE function
// hovers as that function. `stdlib/Print.maxon` declares `public function print(value String)`, and
// a free function has no owner TYPE to name a file after — so the door keyed on an owner cannot
// reach it, and only the project corpus can. The session is `hover-probe.test.maxon`'s.

let HoverStdlibFreeSource = "function main() returns ExitCode\n\tprint(\"x\")\n\treturn 0\nend 'main'\n"
let HoverStdlibFreeLine = 1 as LspCoordinate
let HoverStdlibFreeCharacter = 3 as LspCoordinate

test 'hover crosses into the stdlib'
	let rendering = try hoverRendering(HoverStdlibFreeSource, line: HoverStdlibFreeLine, character: HoverStdlibFreeCharacter)

	try Expect.contains(rendering, needle: "print", message: "a call to the stdlib free function `print` did not hover as `print`. An editor shows nothing at all over the most-typed name in the language.")

	try Expect.contains(rendering, needle: "function print(value String)", message: "the hover did not render the declaration `stdlib/Print.maxon` holds. `arr.push` already reaches `stdlib/Array.maxon` because the rendering is reached through the OWNER TYPE's file; a free function has no owner, so nothing names the file to open.")
end 'hover crosses into the stdlib'
