let EditedProjectDirName = "diagnostics-project-run-once"
let EditedManifestFileName = "app.maxproj"
let EditedMainFileName = "main.maxon"
let EditedMarkerFileName = "runs.txt"
let EditedManifestSource = "export function build() returns ExitCode\n\tlet marker = try FilePath.from(\"runs.txt\") otherwise return 1\n\tvar earlier = \"\"\n\n\tif File.exists(marker) 'ranBefore'\n\t\tearlier = try File.readText(marker) otherwise return 1\n\tend 'ranBefore'\n\n\ttry File.writeText(marker, content: \"\{earlier\}ran\\n\") otherwise return 1\n\tBuild.build(\".\")\n\treturn 0\nend 'build'\n"
let EditedEditCount = 13
let EditedEditPauseMs = 1000
let EditedSettleMs = 2000
let EditedOpeningVersion = 1

function editedMainSource(edit ElementIndex) returns String
	return "function main() returns ExitCode\n\treturn {edit}\nend 'main'\n"
end 'editedMainSource'

test 'project diagnostics: a settled project file is not run again while a source of the project is edited'
	let root = freshOutsideCheckoutDir(EditedProjectDirName)
	writeCorpusFile(root, fileName: EditedManifestFileName, content: EditedManifestSource)
	writeCorpusFile(root, fileName: EditedMainFileName, content: editedMainSource(0))

	var client = LspClient.start()

	if let _ = try editTheSource(client, root: root) 'finished'
		client.release()
	end 'finished' else (e) 'failed'
		abandonedStagedSession(client, staged: root, failure: e, doing: "the session did not complete")
	end 'failed'

	let runs = markerRuns(root.join(EditedMarkerFileName))

	discardOutsideCheckoutDir(root)

	Expect.equal(runs, expected: 1, message: "`{EditedManifestFileName}` states a project that did not change, so the server runs it once while a source of the project is opened and edited for longer than the retry interval of a project that failed to load. It ran {runs} times.")
end 'project diagnostics: a settled project file is not run again while a source of the project is edited'

function markerRuns(marker FilePath) returns ElementIndex
	if not File.exists(marker) 'neverRan'
		return 0
	end 'neverRan'

	let text = try File.readText(marker) otherwise panic("the test could not run: could not read {marker.toString()}")
	var runs = 0 as ElementIndex

	for line in text.split("\n") 'eachLine'
		if not line.isEmpty() 'aRun'
			runs = runs + 1
		end 'aRun'
	end 'eachLine'

	return runs
end 'markerRuns'

function editTheSource(client LspClient, root FilePath) returns DocumentSymbolArray throws LspClientError
	let uri = fileUriOf(root.join(EditedMainFileName))

	_ = try client.initializeAtRoot(root)
	try client.initialized()
	try client.openDocument(uri, content: editedMainSource(0))

	for edit in 1 to EditedEditCount 'eachEdit'
		sleep(EditedEditPauseMs)
		try client.changeDocument(uri, content: editedMainSource(edit as ElementIndex), version: (EditedOpeningVersion + edit) as DocumentVersion)
		_ = try client.documentSymbols(uri)
	end 'eachEdit'

	sleep(EditedSettleMs)

	let outline = try client.documentSymbols(uri)

	return outline.symbols
end 'editTheSource'
