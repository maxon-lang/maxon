test 'hovering a binding inside a modify block says it is read-only while the block is open'
	let rendering = try hoverAfterTheCheck(windowProgram(), line: 20, character: 16)

	try Expect.contains(rendering, needle: "Words — read-only while 'fill' is open (mutable outside it)", message: "`outer` is read inside `modify words 'fill'`, where only the opened region is writable. The checker recorded the block's label with the read, and hover shows both the restriction and what the binding is outside the block.")
end 'hovering a binding inside a modify block says it is read-only while the block is open'
