let BareFieldUseLine = 1
let BareFieldUseCharacter = 13

test 'definition: a bare name outside a type does not reach the type field of that name'
	expectNoDefinitionAt(bareFieldFixture(), line: BareFieldUseLine, character: BareFieldUseCharacter)
end 'definition: a bare name outside a type does not reach the type field of that name'

function bareFieldFixture() returns String
	return String.from(b"function run() returns ExitCode
    return reading
end 'run'

type Gauge
    var reading as ExitCode
end 'Gauge'")
end 'bareFieldFixture'
