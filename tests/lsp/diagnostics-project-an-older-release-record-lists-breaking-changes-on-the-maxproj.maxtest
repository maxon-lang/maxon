let OlderRecordDirName = "diagnostics-project-older-release-record"

test 'project diagnostics: a record of an older release lists the breaking changes since it on the .maxproj'
	let staged = freshOutsideCheckoutDir(OlderRecordDirName)
	let record = stageRecordedProject(staged, recording: recordLine(OlderRelease))

	var client = startedOverRecordedCache(staged)

	if let items = try recordedManifestDiagnostics(client, staged: staged) 'answered'
		client.release()

		let kept = fileText(record)

		discardOutsideCheckoutDir(staged)

		expectBreakingChangeNotices(items)
		Expect.equal(kept, expected: recordLine(OlderRelease), message: "the language server rewrote the compiler-version record {record.toString()}, which only `maxon build` writes.")
	end 'answered' else (e) 'failed'
		abandonedStagedSession(client, staged: staged, failure: e, doing: "the session did not complete")
	end 'failed'
end 'project diagnostics: a record of an older release lists the breaking changes since it on the .maxproj'
