let ProjectMemberBehindCallDirName = "diagnostics-project-member-behind-call"
let ProjectMemberBehindCallDeclaringFileName = "tally.maxon"
let ProjectMemberBehindCallDriverFileName = "driver.maxon"
let ProjectMemberBehindCallBufferFileName = "box.maxon"
let ProjectMemberBehindCallDeclaringSource = "module function projectMemberBehindCallTotal() returns ExitCode\n\treturn 0 as ExitCode\nend 'projectMemberBehindCallTotal'\n"
let ProjectMemberBehindCallDriverSource = "function main() returns ExitCode\n\tlet total = projectMemberBehindCallTotal()\n\n\treturn (total + projectMemberBehindCallMake()) as ExitCode\nend 'main'\n"
let ProjectMemberBehindCallBoxSource = "type ProjectMemberBehindCallBox\n\tlet kept as ExitCode\n\n\tstatic function create() returns ProjectMemberBehindCallBox\n\t\treturn Self\{kept: 0\}\n\tend 'create'\n\n\tfunction keptValue() returns ExitCode\n\t\treturn self.kept\n\tend 'keptValue'\nend 'ProjectMemberBehindCallBox'\n\nmodule function projectMemberBehindCallMake() returns ExitCode\n\treturn ProjectMemberBehindCallBox.create()"
let ProjectMemberBehindCallSavedTail = ".keptValue()\nend 'projectMemberBehindCallMake'\n"
let ProjectMemberBehindCallTypedTail = ".projectMemberBehindCallTotal\nend 'projectMemberBehindCallMake'\n"
let ProjectMemberBehindCallCode = "E3018"

test 'a member error behind a call is still reported when a sibling declares the member name'
	let root = stagedProjectDiagnosticsRoot(ProjectMemberBehindCallDirName)
	let saved = "{ProjectMemberBehindCallBoxSource}{ProjectMemberBehindCallSavedTail}"
	let typed = "{ProjectMemberBehindCallBoxSource}{ProjectMemberBehindCallTypedTail}"
	writeCorpusFile(root, fileName: ProjectMemberBehindCallDeclaringFileName, content: ProjectMemberBehindCallDeclaringSource)
	writeCorpusFile(root, fileName: ProjectMemberBehindCallDriverFileName, content: ProjectMemberBehindCallDriverSource)
	writeCorpusFile(root, fileName: ProjectMemberBehindCallBufferFileName, content: saved)

	let probes = probeProjectDiagnosticsAcrossAnEdit(root, fileName: ProjectMemberBehindCallBufferFileName, content: saved, editedContent: typed)

	discardOutsideCheckoutDir(root)

	try expectNoProjectDiagnostics(try projectDiagnosticsPublish(probes, index: ProjectDiagnosticsAtOpen), note: "the buffer opened holding exactly the disk's bytes, and a `maxon build` of the staged project exits 0. This publish is the CONTROL: a diagnostic here is the unedited answer already wrong, and says nothing about the edit below.")

	let reported = try onlyProjectDiagnostic(try projectDiagnosticsPublish(probes, index: ProjectDiagnosticsAfterTheEdit), note: "the `didChange` reads a member named after a function the sibling `tally.maxon` declares, off the result of a CALL. A `maxon build` of the staged tree holding the edited text reports exactly one `E3018` about that member and nothing else.")

	try Expect.equal(reported.code, expected: ProjectMemberBehindCallCode, message: "the token before the member is a `)`, so the access has no identifier base to attribute the diagnostic to. Falling back to the MEMBER's own name hands the oracle a name the sibling declares, and the author's mistake is silenced — whichever road publishes this diagnostic, it must be published.")
end 'a member error behind a call is still reported when a sibling declares the member name'
