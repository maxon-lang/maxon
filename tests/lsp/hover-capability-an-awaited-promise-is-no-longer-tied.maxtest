test 'hovering a promise after it was awaited says where, and not that it is still tied'
	let rendering = try hoverAfterTheCheck(awaitedProgram(), line: 24, character: 20)

	try Expect.contains(rendering, needle: "moved at line 24", message: "the first `await pending` on line 24 consumes the promise, so the second read on line 25 is refused and hover names the first await.")

	Expect.isFalse(rendering.contains("tied promise"), message: "an awaited promise is no longer tied to the values it was started with.")
end 'hovering a promise after it was awaited says where, and not that it is still tied'
