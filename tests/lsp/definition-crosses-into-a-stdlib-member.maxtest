// definition-crosses-into-a-stdlib-member.maxtest — the same cursor one member further: `from` in
// `FilePath.from("x")` resolves to the `public static function from` in `stdlib/FilePath.maxon`, not to
// the type's own line. The session, the staging and the assertions are `definition-corpus-probe.maxtest`'s.

let StdlibMemberDirName = "temp/lsp/definition-crosses-into-a-stdlib-member"
let StdlibMemberFileName = "main.maxon"
let StdlibMemberUseLine = 1 as LspCoordinate
let StdlibMemberUseCharacter = 23 as LspCoordinate
let StdlibMemberDeclarationLineNeedle = "	public static function from"

test 'definition crosses into a stdlib member'
	let directory = stagedCorpusDirectory(StdlibMemberDirName)
	let source = corpusFilePathSource()

	let probe = probeCorpusDefinition(directory, fileName: StdlibMemberFileName, content: source, line: StdlibMemberUseLine, character: StdlibMemberUseCharacter)

	expectDefinitionInFile(probe, fileTail: CorpusStdlibFilePathTail, startLine: corpusLineDeclaring(corpusStdlibFilePath(), needle: StdlibMemberDeclarationLineNeedle), note: "a cursor on the stdlib member `FilePath.from` did not resolve to the `public static function from` that declares it.")
end 'definition crosses into a stdlib member'
