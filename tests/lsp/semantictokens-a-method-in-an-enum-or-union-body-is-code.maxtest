let MethodBodyUri = "file:///test.maxon"

let MethodBodyKeywordType = 0
let MethodBodyTypeType = 1
let MethodBodyFunctionType = 5
let MethodBodyEnumMemberType = 10

test 'semantic tokens colour a method of an enum or union as code and its cases as cases'
	let client = LspClient.start()

	if let data = try methodBodyTokensOf(client) 'tokens'
		client.release()
		assertMethodBodyColours(locatedSemanticTokensOf(data))
	end 'tokens' else (e) 'failed'
		abandonedSession(client, failure: e, doing: "the semantic-tokens request did not complete")
	end 'failed'
end 'semantic tokens colour a method of an enum or union as code and its cases as cases'

function methodBodyTokensOf(client LspClient) returns SemanticTokenValueArray throws LspClientError
	_ = try client.initialize()
	try client.initialized()
	try client.openDocument(MethodBodyUri, content: methodBodyFixture())

	let tokens = try client.semanticTokensFull(MethodBodyUri)

	return tokens.data
end 'methodBodyTokensOf'

function assertMethodBodyColours(tokens LocatedSemanticTokenArray) throws TestFailure
	let source = methodBodyFixture()

	try requireSemanticTokenType(tokens, source: source, line: 1, word: "light", expected: MethodBodyEnumMemberType, what: "the case `light` of `enum Shade`")
	try requireSemanticTokenType(tokens, source: source, line: 2, word: "dark", expected: MethodBodyEnumMemberType, what: "the case `dark` of `enum Shade`")
	try requireSemanticTokenType(tokens, source: source, line: 4, word: "function", expected: MethodBodyKeywordType, what: "the `function` keyword that opens a method inside an enum body")
	try requireSemanticTokenType(tokens, source: source, line: 4, word: "flipped", expected: MethodBodyFunctionType, what: "the name of the method declared in an enum body")
	try requireSemanticTokenType(tokens, source: source, line: 4, word: "returns", expected: MethodBodyKeywordType, what: "the `returns` keyword of a method declared in an enum body")
	try requireSemanticTokenType(tokens, source: source, line: 4, word: "Shade", expected: MethodBodyTypeType, what: "the return type of a method declared in an enum body")
	try requireSemanticTokenType(tokens, source: source, line: 5, word: "return", expected: MethodBodyKeywordType, what: "the `return` statement inside a method of an enum")
	try requireSemanticTokenType(tokens, source: source, line: 6, word: "end", expected: MethodBodyKeywordType, what: "the `end` that closes a method declared in an enum body")

	try requireSemanticTokenType(tokens, source: source, line: 10, word: "clear", expected: MethodBodyEnumMemberType, what: "the case `clear` of `union Reading`")
	try requireSemanticTokenType(tokens, source: source, line: 11, word: "cloudy", expected: MethodBodyEnumMemberType, what: "the case `cloudy` of `union Reading`")
	try requireSemanticTokenType(tokens, source: source, line: 13, word: "function", expected: MethodBodyKeywordType, what: "the `function` keyword that opens a method inside a union body")
	try requireSemanticTokenType(tokens, source: source, line: 13, word: "level", expected: MethodBodyFunctionType, what: "the name of the method declared in a union body")
	try requireSemanticTokenType(tokens, source: source, line: 13, word: "returns", expected: MethodBodyKeywordType, what: "the `returns` keyword of a method declared in a union body")
	try requireSemanticTokenType(tokens, source: source, line: 14, word: "return", expected: MethodBodyKeywordType, what: "the `return` statement inside a method of a union")
	try requireSemanticTokenType(tokens, source: source, line: 15, word: "end", expected: MethodBodyKeywordType, what: "the `end` that closes a method declared in a union body")
end 'assertMethodBodyColours'

function methodBodyFixture() returns String
	return String.from(b"enum Shade
    light
    dark

    function flipped() returns Shade
        return Shade.light
    end 'flipped'
end 'Shade'

union Reading
    clear
    cloudy(depth Count)

    function level() returns Count
        return 0
    end 'level'
end 'Reading'")
end 'methodBodyFixture'
