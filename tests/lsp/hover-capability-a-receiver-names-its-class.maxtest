test 'hovering self names the capability the method needs of its receiver'
	let rendering = try hoverAfterTheCheck(parameterProgram(), line: 12, character: 10)

	try Expect.contains(rendering, needle: "Words, any capability (only read)", message: "`size` only reads `self.total`, so the compiler infers that it takes a receiver of any capability.")
end 'hovering self names the capability the method needs of its receiver'
