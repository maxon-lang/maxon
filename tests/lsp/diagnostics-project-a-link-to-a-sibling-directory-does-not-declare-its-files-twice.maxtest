#if not os(Windows)
	let ProjectSiblingLinkDirName = "diagnostics-project-sibling-link"
	let ProjectSiblingLinkLibraryDirName = "lib"
	let ProjectSiblingLinkName = "mirror"
	let ProjectSiblingLinkMainFileName = "main.maxon"
	let ProjectSiblingLinkLibraryFileName = "Answer.maxon"
	let ProjectSiblingLinkMainSource = "function main() returns ExitCode\n\treturn answer()\nend 'main'\n"
	let ProjectSiblingLinkLibrarySource = "export function answer() returns ExitCode\n\treturn 0\nend 'answer'\n"

	test 'a link to a sibling directory does not make the editor read its files as declared twice'
		let root = stagedProjectDiagnosticsRoot(ProjectSiblingLinkDirName)
		let library = stagingDir(root.join(ProjectSiblingLinkLibraryDirName).toString())
		writeCorpusFile(root, fileName: ProjectSiblingLinkMainFileName, content: ProjectSiblingLinkMainSource)
		writeCorpusFile(library, fileName: ProjectSiblingLinkLibraryFileName, content: ProjectSiblingLinkLibrarySource)

		let link = root.join(ProjectSiblingLinkName)
		_ = runSystemTool("ln", arguments: ["-s", ProjectSiblingLinkLibraryDirName, link.toString()], what: "`ln -s` making a link to a sibling directory in the staged project")

		let probe = probeProjectDiagnostics(root, fileName: ProjectSiblingLinkMainFileName, content: ProjectSiblingLinkMainSource)

		try File.delete(link) otherwise panic("the gate could not run — could not remove the link {link.toString()}.")

		discardOutsideCheckoutDir(root)

		expectNoProjectDiagnostics(probe, note: "`{ProjectSiblingLinkName}` is a link to `{ProjectSiblingLinkLibraryDirName}`, so `{ProjectSiblingLinkLibraryDirName}/{ProjectSiblingLinkLibraryFileName}` is one file, and a `maxon build` of the staged project reports nothing.")
	end 'a link to a sibling directory does not make the editor read its files as declared twice'
#endif
