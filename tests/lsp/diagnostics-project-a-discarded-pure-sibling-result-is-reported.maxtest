let ProjectSiblingDiscardDirName = "diagnostics-project-sibling-discarded-pure-result"
let ProjectSiblingDiscardDeclaringFileName = "a.maxon"
let ProjectSiblingDiscardBufferFileName = "b.maxon"
let ProjectSiblingDiscardDeclaringSource = "module function twice(n ExitCode) returns ExitCode\n\treturn n\nend 'twice'\n"
let ProjectSiblingDiscardBufferSource = "function main() returns ExitCode\n\ttwice(1)\n\treturn 0\nend 'main'\n"
let ProjectSiblingDiscardCode = "E3064"
let ProjectSiblingDiscardMessage = "result of pure function 'twice' must be used"
let ProjectSiblingDiscardLine = 1
let ProjectSiblingDiscardCharacter = 1

test 'a discarded result of a pure function a sibling file declares is reported'
	let root = stagedProjectDiagnosticsRoot(ProjectSiblingDiscardDirName)
	writeCorpusFile(root, fileName: ProjectSiblingDiscardDeclaringFileName, content: ProjectSiblingDiscardDeclaringSource)
	writeCorpusFile(root, fileName: ProjectSiblingDiscardBufferFileName, content: ProjectSiblingDiscardBufferSource)

	let probe = probeProjectCheckDiagnostics(root, fileName: ProjectSiblingDiscardBufferFileName, content: ProjectSiblingDiscardBufferSource, edits: StringArray.create())

	discardOutsideCheckoutDir(root)

	let reported = try onlyProjectDiagnostic(probe, note: "the buffer calls the sibling's pure `twice` as a bare statement. A `maxon build` of the staged project reports exactly one `{ProjectSiblingDiscardCode}` and nothing else.")

	try Expect.equal(reported.code.describe(), expected: ProjectSiblingDiscardCode, message: "the one error a build of this project reports is {ProjectSiblingDiscardCode}; the server published {reported.code.describe()}: {reported.message}")
	try Expect.equal(reported.message, expected: ProjectSiblingDiscardMessage, message: "the server must say what the build says.")
	try Expect.equal(reported.range.startLine, expected: ProjectSiblingDiscardLine, message: "the build anchors the error on line 2.")
	try Expect.equal(reported.range.startCharacter, expected: ProjectSiblingDiscardCharacter, message: "the build anchors the error at column 2, the call.")
end 'a discarded result of a pure function a sibling file declares is reported'
