// definition-prefers-the-open-buffer.test.maxon — when the open document declares the name itself, a call
// to it resolves IN THE BUFFER, even though a sibling file `export`s the same name. The sibling's copy sits
// on a different line, so the uri and the line both say which one answered.
// ⚠ GREEN TODAY: the server walks only the open buffer and writes only the request's own uri. It is the
// regression guard for that rule surviving cross-file resolution.

let OpenBufferDirName = "temp/lsp/definition-prefers-the-open-buffer"
let OpenBufferHelperFileName = "helper.maxon"
let OpenBufferMainFileName = "main.maxon"
let OpenBufferHelperSource = "function unrelatedPadding() returns ExitCode\n\treturn 0\nend 'unrelatedPadding'\n\nexport function bothDeclareThis() returns ExitCode\n\treturn 0\nend 'bothDeclareThis'\n"
let OpenBufferMainSource = "function bothDeclareThis() returns ExitCode\n\treturn 1\nend 'bothDeclareThis'\n\nfunction main() returns ExitCode\n\treturn bothDeclareThis()\nend 'main'\n"
let OpenBufferMainTail = "definition-prefers-the-open-buffer/main.maxon"
let OpenBufferCallLine = 5 as LspCoordinate
let OpenBufferCallCharacter = 12 as LspCoordinate
let OpenBufferDeclarationLine = 0 as LspCoordinate

test 'definition prefers the open buffer'
	let directory = stagedCorpusDirectory(OpenBufferDirName)
	writeCorpusFile(directory, fileName: OpenBufferHelperFileName, content: OpenBufferHelperSource)

	let probe = probeCorpusDefinition(directory, fileName: OpenBufferMainFileName, content: OpenBufferMainSource, line: OpenBufferCallLine, character: OpenBufferCallCharacter)

	try expectDefinitionInFile(probe, fileTail: OpenBufferMainTail, startLine: OpenBufferDeclarationLine, note: "the open document declares the name it calls, and the answer named a sibling file's `export`ed copy instead.")
end 'definition prefers the open buffer'
