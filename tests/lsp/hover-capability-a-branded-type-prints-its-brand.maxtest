test 'hovering a re-branded container names the brand it carries'
	let rendering = try hoverAfterTheCheck(brandedProgram(), line: 7, character: 13)

	try Expect.contains(rendering, needle: "TallyRow — mutable", message: "`row` is a `TallyList` re-branded `TallyRow`, two brands over one `Array with Tally`, and the capability line prints the type the way a diagnostic does.")
end 'hovering a re-branded container names the brand it carries'
