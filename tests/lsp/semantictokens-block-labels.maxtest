let BlockLabelUri = "file:///test.maxon"

let BlockLabelStringType = 12
let BlockLabelLabelType = 17

test 'semantic tokens colour a block label as a label and a character literal as a string'
	let client = LspClient.start()

	if let data = try blockLabelTokensOf(client, source: blockLabelFixture()) 'tokens'
		client.release()
		assertBlockLabelColours(locatedSemanticTokensOf(data))
	end 'tokens' else (e) 'failed'
		abandonedSession(client, failure: e, doing: "the semantic-tokens request did not complete")
	end 'failed'
end 'semantic tokens colour a block label as a label and a character literal as a string'

function blockLabelTokensOf(client LspClient, source String) returns SemanticTokenValueArray throws LspClientError
	_ = try client.initialize()
	try client.initialized()
	try client.openDocument(BlockLabelUri, content: source)

	let tokens = try client.semanticTokensFull(BlockLabelUri)

	return tokens.data
end 'blockLabelTokensOf'

function assertBlockLabelColours(tokens LocatedSemanticTokenArray) throws TestFailure
	let source = blockLabelFixture()

	try requireSemanticTokenType(tokens, source: source, line: 1, word: "a", expected: BlockLabelStringType, what: "the character literal in `let letter = 'a'`")
	try requireSemanticTokenType(tokens, source: source, line: 2, word: "positive", expected: BlockLabelLabelType, what: "the opening label of `if code > 0 'positive'`")
	try requireSemanticTokenType(tokens, source: source, line: 4, word: "positive", expected: BlockLabelLabelType, what: "the closing label in `end 'positive' else 'other'`")
	try requireSemanticTokenType(tokens, source: source, line: 4, word: "other", expected: BlockLabelLabelType, what: "the opening label in `end 'positive' else 'other'`")
	try requireSemanticTokenType(tokens, source: source, line: 6, word: "other", expected: BlockLabelLabelType, what: "the closing label in `end 'other'`")
	try requireSemanticTokenType(tokens, source: source, line: 7, word: "pick", expected: BlockLabelLabelType, what: "the function's closing label in `end 'pick'`")
	try requireSemanticTokenType(tokens, source: source, line: 11, word: "Box", expected: BlockLabelLabelType, what: "the type's closing label in `end 'Box'`")
	try requireSemanticTokenType(tokens, source: source, line: 14, word: "a", expected: BlockLabelLabelType, what: "the one-letter opening label of `for item in items 'a'`")
	try requireSemanticTokenType(tokens, source: source, line: 16, word: "a", expected: BlockLabelLabelType, what: "the one-letter closing label in `end 'a'`")
	try requireSemanticTokenType(tokens, source: source, line: 20, word: "stray", expected: BlockLabelLabelType, what: "the label of an `end 'stray'` that closes no open block")
end 'assertBlockLabelColours'

function blockLabelFixture() returns String
	return String.from(b"function pick(code int) returns int
    let letter = 'a'
    if code > 0 'positive'
        return 1
    end 'positive' else 'other'
        return 2
    end 'other'
end 'pick'

type Box
    let size as int
end 'Box'

function walk(items IntArray)
    for item in items 'a'
        print(item)
    end 'a'
end 'walk'

function gone()
    end 'stray'
end 'gone'")
end 'blockLabelFixture'
