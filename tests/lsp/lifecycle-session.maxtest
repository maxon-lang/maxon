// lifecycle-session.maxtest — the four lifecycle tests: what `initialize` advertises, that
// `shutdown` then `exit` terminates the process cleanly, and the two whole-session workflows.
//
// ⚠ These four are the suite's cross-area canaries: `initialize returns capabilities` reads the
// COMPLETION capability, and two of the workflows drive completion and hover. So a regression in an area
// that has no lifecycle code of its own still reddens this file — which is why they are worth reading
// first when the suite goes red.
//
// Release discipline — why every session is driven into a VALUE before anything is asserted — is
// stated once, in `LspClient.maxon`'s hazard 1.

// The one uri this suite drives. It never touches the filesystem — full-text sync carries the content,
// so the server is told the text rather than asked to read it.
let LifecycleUri = "file:///test.maxon"

// The version `didChange` announces. LSP requires it to increase, and `didOpen` sent 1.
let LifecycleSecondVersion = 2

// LSP reserves exit 0 for a session the client shut down first. This server gives 0 for `exit` after
// `shutdown`, and 1 for both `exit` without one and stdin EOF.
let LifecycleCleanExitCode = 0 as ProcessExitCode

test 'initialize returns capabilities'
	var client = LspClient.start()

	if let advertised = try advertisedCapabilities(client) 'advertised'
		client.release()
		assertLifecycleAdvertisement(advertised.hasTextDocumentSync, completionProvider: advertised.hasCompletionProvider)
	end 'advertised' else (e) 'failed'
		abandonedSession(client, failure: e, doing: "the `initialize` handshake did not complete")
	end 'failed'
end 'initialize returns capabilities'

test 'shutdown and exit terminate cleanly'
	var client = LspClient.start()

	if let code = try exitCodeAfterShutdown(client) 'exited'
		client.release()
		assertLifecycleCleanExit(code)
	end 'exited' else (e) 'failed'
		abandonedSession(client, failure: e, doing: "the shutdown sequence did not complete", afterwards: ". `waitForExit` carries its own deadline, so this sentence also covers a server that had to be waited out rather than exiting on its own.")
	end 'failed'
end 'shutdown and exit terminate cleanly'

test 'server handles full workflow'
	var client = LspClient.start()

	if let labels = try labelsOfTheWorkflow(client) 'offered'
		client.release()
		assertLifecycleArrayCompletion(labels)
	end 'offered' else (e) 'failed'
		abandonedSession(client, failure: e, doing: "the open / change / complete / close workflow did not complete")
	end 'failed'
end 'server handles full workflow'

test 'full lifecycle with document'
	var client = LspClient.start()

	if let hovered = try hoverAcrossTheLifecycle(client) 'hovered'
		client.release()
		assertLifecycleVariableHover(hovered.isPresent, contents: hovered.contents)
	end 'hovered' else (e) 'failed'
		abandonedSession(client, failure: e, doing: "the open / hover / change / close session did not complete")
	end 'failed'
end 'full lifecycle with document'

function advertisedCapabilities(client LspClient) returns InitializeResult throws LspClientError
	let advertised = try client.initialize()
	try client.initialized()

	return advertised
end 'advertisedCapabilities'

function exitCodeAfterShutdown(client LspClient) returns ProcessExitCode throws LspClientError
	_ = try client.initialize()
	try client.initialized()
	try client.shutdown()
	try client.exit()

	return try client.waitForExit()
end 'exitCodeAfterShutdown'

function labelsOfTheWorkflow(client LspClient) returns StringArray throws LspClientError
	_ = try client.initialize()
	try client.initialized()
	try client.openDocument(LifecycleUri, content: lifecycleMainWithVariable())
	try client.changeDocument(LifecycleUri, content: lifecycleMainWithArray(), version: LifecycleSecondVersion)

	// Request completion after "arr." (line 2, column 8)
	let answered = try client.completionWithTrigger(LifecycleUri, line: 2, character: 8, triggerCharacter: ".")

	try client.closeDocument(LifecycleUri)

	return lifecycleLabelsOf(answered)
end 'labelsOfTheWorkflow'

function hoverAcrossTheLifecycle(client LspClient) returns HoverResult throws LspClientError
	_ = try client.initialize()
	try client.initialized()
	try client.openDocument(LifecycleUri, content: lifecycleMainWithXOne())

	// Request hover on 'x' variable at line 1, character 8
	// Line 1: "    var x = 1" - 'x' is at position 8
	let answered = try client.hover(LifecycleUri, line: 1, character: 8)

	try client.changeDocument(LifecycleUri, content: lifecycleMainWithXTwo(), version: LifecycleSecondVersion)
	try client.closeDocument(LifecycleUri)

	return answered
end 'hoverAcrossTheLifecycle'

function assertLifecycleAdvertisement(textDocumentSync bool, completionProvider bool) throws TestFailure
	try Expect.isTrue(textDocumentSync, message: "the `initialize` reply did not advertise `textDocumentSync`. The client declared support for it, and without it no document can be sent at all — so every language method is unreachable behind this one capability.")
	try Expect.isTrue(completionProvider, message: "the `initialize` reply did not advertise `completionProvider`. The client declared completion support, so a server that offers completion must say so here; a client reading this field will never ask a silent server for completions.")
end 'assertLifecycleAdvertisement'

function assertLifecycleCleanExit(code ProcessExitCode) throws TestFailure
	let observed = code
	let expected = LifecycleCleanExitCode
	try Expect.equal(observed, expected: expected, message: "the server did not exit 0 after `shutdown` then `exit`. LSP reserves 0 for exactly that order — `exit` without a preceding `shutdown` is 1 — so a different code means the session ended some other way, and the exit code is the half of this a script reads.")
end 'assertLifecycleCleanExit'

function assertLifecycleArrayCompletion(labels StringArray) throws TestFailure
	try Expect.greaterThan(labels.count(), than: 0, message: "completion after `arr.` offered nothing. The document was opened and then REPLACED by `didChange`, so this also asks whether the server completes against the changed text rather than the opened text.")
	try Expect.isTrue(lifecycleOffersLabel(labels, label: "push"), message: "completion after `arr.` did not offer `push`. It is the method the third line of the changed document actually calls, so an Array completion list without it is not an Array completion list.")
end 'assertLifecycleArrayCompletion'

function assertLifecycleVariableHover(isPresent bool, contents String) throws TestFailure
	try Expect.isTrue(isPresent, message: "hover over `x` answered nothing. A hover that is absent and a hover that renders emptily are different failures, so they are asserted separately.")
	try Expect.isFalse(contents.isEmpty(), message: "hover over `x` was present but rendered nothing.")
	try Expect.contains(contents, needle: "int", message: "hover over `x` did not name its type. `var x = 1` infers `int`, and the type is the reason an editor shows a hover at all.")
end 'assertLifecycleVariableHover'

function lifecycleOffersLabel(labels StringArray, label String) returns bool
	for offered in labels 'eachLabel'
		if offered == label 'hit'
			return true
		end 'hit'
	end 'eachLabel'

	return false
end 'lifecycleOffersLabel'

function lifecycleLabelsOf(answered CompletionResult) returns StringArray
	var labels = StringArray.create()

	for item in answered.items 'eachItem'
		labels.push(item.label)
	end 'eachItem'

	return labels
end 'lifecycleLabelsOf'

// ⚠ A `b"…"` byte literal, closing quote IMMEDIATELY after the last source character: it is byte-exact,
// a raw newline in one IS the byte it spells, and it neither strips indentation nor appends a trailing
// newline. A representation that did either would shift every hard-coded column above.
function lifecycleMainWithVariable() returns String
	return String.from(b"function main() returns int
    var x = 42
    return x
end 'main'")
end 'lifecycleMainWithVariable'

function lifecycleMainWithArray() returns String
	return String.from(b"function main() returns int
    var arr = [1, 2, 3]
    arr.push(4)
    return 0
end 'main'")
end 'lifecycleMainWithArray'

function lifecycleMainWithXOne() returns String
	return String.from(b"function main() returns int
    var x = 1
    return x
end 'main'")
end 'lifecycleMainWithXOne'

function lifecycleMainWithXTwo() returns String
	return String.from(b"function main() returns int
    var x = 2
    return x
end 'main'")
end 'lifecycleMainWithXTwo'
