test 'hovering an isolated value after it moved says where it moved'
	let rendering = try hoverAfterTheCheck(movedProgram(), line: 23, character: 15)

	try Expect.contains(rendering, needle: "moved at line 23", message: "`hand(words)` on line 23 takes `words` by an `isolated` parameter, which moves it; the later read on line 24 is refused, and its hover names the move.")
end 'hovering an isolated value after it moved says where it moved'
