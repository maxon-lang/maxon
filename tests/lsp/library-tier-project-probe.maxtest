let LibraryTierStdlibDirName = "stdlib"
let LibraryTierRuntimeDirName = "runtime"
let LibraryTierLineSeparator = "\n"
let LibraryTierPathSlash = "/"

let LibraryTierFilePathFileName = "FilePath.maxon"
let LibraryTierFilePathLine = "\tstatic function normalizeSeparators(path String) returns String"
let LibraryTierPrintFileName = "Print.maxon"
let LibraryTierPrintLine = "public function print(value String)"
let LibraryTierClockFileName = "Clock.maxon"
let LibraryTierClockLine = "module function __uptime_ms() returns MachineWord"
let LibraryTierStringName = "String"
let LibraryTierMachineWordName = "MachineWord"

let LibraryTierSingleFileCount = 1 as JsonInteger

export enum LibraryTierAsking
	nothingBeyondTheOpen
	aDefinitionInEach
end 'LibraryTierAsking'

export type LibraryTierDocument
	module let uri as String
	module let content as String
	module let line as LspCoordinate
	module let character as LspCoordinate
	export let tierDirName as String

	static function at(tierDirName String, fileName String, lineNeedle String, name String) returns LibraryTierDocument
		let file = Directory.currentPath().join(tierDirName).join(fileName)
		let content = try File.readText(file) otherwise panic("library tier project: could not read {file.toString()}, which an editor opening it would have sent as the buffer's text")
		var line = 0 as LspCoordinate

		for candidate in content.split(LibraryTierLineSeparator) 'eachLine'
			if candidate.startsWith(lineNeedle) 'thisOne'
				let before = try candidate.split(name).get(0) otherwise panic("library tier project: the line of {file.toString()} beginning '{lineNeedle}' was split on '{name}', which it holds")

				return Self{uri: fileUriOf(file), content: content, line: line, character: before.count() as LspCoordinate, tierDirName: tierDirName}
			end 'thisOne'

			line = line + 1
		end 'eachLine'

		panic("library tier project: no line of {file.toString()} begins with '{lineNeedle}'")
	end 'at'

	function opened(asking LibraryTierAsking) returns WorkspaceFolderDocument
		return match asking 'asking'
			nothingBeyondTheOpen gives WorkspaceFolderDocument.create(self.uri, content: self.content)
			aDefinitionInEach gives WorkspaceFolderDocument.followedByDefinition(self.uri, content: self.content, line: self.line, character: self.character)
		end 'asking'
	end 'opened'
end 'LibraryTierDocument'

export typealias LibraryTierDocumentArray = Array with LibraryTierDocument

export function libraryTierFilePathDocument() returns LibraryTierDocument
	return LibraryTierDocument.at(LibraryTierStdlibDirName, fileName: LibraryTierFilePathFileName, lineNeedle: LibraryTierFilePathLine, name: LibraryTierStringName)
end 'libraryTierFilePathDocument'

export function libraryTierPrintDocument() returns LibraryTierDocument
	return LibraryTierDocument.at(LibraryTierStdlibDirName, fileName: LibraryTierPrintFileName, lineNeedle: LibraryTierPrintLine, name: LibraryTierStringName)
end 'libraryTierPrintDocument'

export function libraryTierClockDocument() returns LibraryTierDocument
	return LibraryTierDocument.at(LibraryTierRuntimeDirName, fileName: LibraryTierClockFileName, lineNeedle: LibraryTierClockLine, name: LibraryTierMachineWordName)
end 'libraryTierClockDocument'

function libraryTierDocuments(first LibraryTierDocument) returns LibraryTierDocumentArray
	var documents = LibraryTierDocumentArray.create()
	documents.push(first)

	return documents
end 'libraryTierDocuments'

export function libraryTierDocumentPair(first LibraryTierDocument, second LibraryTierDocument) returns LibraryTierDocumentArray
	var documents = libraryTierDocuments(first)
	documents.push(second)

	return documents
end 'libraryTierDocumentPair'

export function libraryTierSession(documents LibraryTierDocumentArray, asking LibraryTierAsking) returns ListProjectsProbe
	var opened = WorkspaceFolderDocumentArray.create()

	for document in documents 'eachDocument'
		opened.push(document.opened(asking))
	end 'eachDocument'

	return listProjectsIn(ProjectRootsSession.atFolders(projectRootsFolders(Directory.currentPath())), documents: opened)
end 'libraryTierSession'

export function libraryTierProjects(session ListProjectsProbe) returns ListProjectsResult throws TestFailure
	match session 'session'
		answered(projects, _) then return projects
		unanswered(detail) then try Expect.fail("the session broke before `maxon/listProjects` answered: {detail}")
	end 'session'

	panic("library tier project: the `unanswered` arm always throws, so this line is unreachable")
end 'libraryTierProjects'

export function libraryTierNotices(session ListProjectsProbe) returns ProjectLoadingNoticeArray throws TestFailure
	match session 'session'
		answered(_, notices) then return notices
		unanswered(detail) then try Expect.fail("the session broke before the `maxon/projectLoading` notices could be read: {detail}")
	end 'session'

	panic("library tier project: the `unanswered` arm always throws, so this line is unreachable")
end 'libraryTierNotices'

export function libraryTierDirTail(document LibraryTierDocument) returns String
	return "{LibraryTierPathSlash}{document.tierDirName}"
end 'libraryTierDirTail'

export function requireTheLibraryTierProject(project ProjectEntry, document LibraryTierDocument, note String) throws TestFailure
	let expectedTail = libraryTierDirTail(document)

	try Expect.isTrue(foldedRootPath(project.rootPath).endsWith(expectedTail), message: "{note} The project is rooted at {project.rootPath}, not at the `{document.tierDirName}/` directory: a library tier is ONE project, and a root naming a source file files every library document as a program of its own.")
	try Expect.isFalse(project.isSingleFile, message: "{note} The `{document.tierDirName}/` project was answered as a SINGLE FILE, although it is the whole tier.")
	try Expect.isTrue(project.fileCount > LibraryTierSingleFileCount, message: "{note} The `{document.tierDirName}/` project reported {project.fileCount} files. Opening a document of the tier builds its project, so the count is the tier's own, and the tier holds many.")
end 'requireTheLibraryTierProject'

export function requireTheOnlyOpenedLibraryTierProject(document LibraryTierDocument) throws TestFailure
	let note = "`{document.uri}` was opened in a session whose client named the checkout as its workspace folder, and nothing else was asked before `maxon/listProjects`. The document is clean, so no diagnostic correction reached the project either: the open alone is what builds it."
	let session = libraryTierSession(libraryTierDocuments(document), asking: LibraryTierAsking.nothingBeyondTheOpen)
	let project = try soleProject(try libraryTierProjects(session), note: note)

	try requireTheLibraryTierProject(project, document: document, note: note)
end 'requireTheOnlyOpenedLibraryTierProject'
