test 'hovering a function that may wait names the call chain to the wait'
	let rendering = try hoverAfterTheCheck(waitingProgram(), line: 22, character: 11)

	try Expect.contains(rendering, needle: "may wait: it calls 'transfer', which acquires services at line 16", message: "`settle` only calls `transfer`, and `transfer` holds an `acquire` block, so `settle` may wait. Hover shows the chain the holder-may-wait refusal prints.")
end 'hovering a function that may wait names the call chain to the wait'
