let ModuleLetCallDirName = "diagnostics-project-module-let-call"
let ModuleLetCallFileName = "main.maxon"
let ModuleLetCallSource = "typealias Num = int(0 to 1000)\n\ntype Counter\n\texport var n as Num\n\n\tstatic function create(n Num) returns Counter\n\t\treturn Self\{n: n\}\n\tend 'create'\nend 'Counter'\n\nlet Start = Counter.create(4)\n\nfunction main() returns ExitCode\n\treturn Start.n as ExitCode\nend 'main'\n"
let ModuleLetCallCode = "E3220"
let ModuleLetCallMessage = "the initializer of 'Start' calls 'Counter.create': a module-level or static `let` initializer calls nothing, so write a literal, or build the value where it is used"
let ModuleLetCallLine = 10
let ModuleLetCallCharacter = 12

test 'a module let initializer that calls a function is reported in the file that wrote it'
	let root = stagedProjectDiagnosticsRoot(ModuleLetCallDirName)
	writeCorpusFile(root, fileName: ModuleLetCallFileName, content: ModuleLetCallSource)

	let session = probeProjectCheckSession(root, fileName: ModuleLetCallFileName, content: ModuleLetCallSource, edits: StringArray.create(0))

	discardStagedDir(root)

	let reported = try onlyProjectDiagnostic(session.diagnostics, note: "`let Start = Counter.create(4)` calls a function in a module-level initializer. A `maxon build` reports exactly one `{ModuleLetCallCode}` at the call, in this file.")

	try Expect.equal(reported.code.describe(), expected: ModuleLetCallCode, message: "the one error a build of this project reports is {ModuleLetCallCode}; the server published {reported.code.describe()}: {reported.message}")
	try Expect.equal(reported.message, expected: ModuleLetCallMessage, message: "the server must quote the refusal the build quotes.")
	try Expect.equal(reported.range.startLine, expected: ModuleLetCallLine, message: "the build anchors the error on line 11, the `let Start` declaration.")
	try Expect.equal(reported.range.startCharacter, expected: ModuleLetCallCharacter, message: "the build anchors the error at column 13, the `Counter.create` the declaration calls.")
end 'a module let initializer that calls a function is reported in the file that wrote it'
