test 'hovering Self.make() shows the static method, not the free function of the same name'
	let rendering = try hoverAfterTheCheck(freeFunctionAndMethodProgram(), line: 20, character: 28)

	try Expect.contains(rendering, needle: "static function make() returns Count", message: "`Self.make()` calls the static method `Gauge.make`.")

	Expect.isFalse(rendering.contains("function make(code Count) returns Count"), message: "The free `make` is not what a call through `Self` names.")
end 'hovering Self.make() shows the static method, not the free function of the same name'
