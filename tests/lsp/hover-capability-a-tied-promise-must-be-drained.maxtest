test 'hovering a promise tied to the caller data says it must be drained'
	let rendering = try hoverAfterTheCheck(tiedProgram(), line: 23, character: 20)

	try Expect.contains(rendering, needle: "tied promise: await or cancel it before the values it was started with are used again", message: "`bump(words)` hands the caller's mutable `words` to a coroutine, so `pending` is tied to it until the promise is awaited or cancelled.")
end 'hovering a promise tied to the caller data says it must be drained'
