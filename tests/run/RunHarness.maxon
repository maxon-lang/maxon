// RunHarness.maxon — the shared half every case under `tests/run/` reaches for: the driver it spawns,
// staging a fixture into a tree of its own, confining that run's build cache to that tree, and reading
// back what one run said and what it left in the cache.
//
// ⭐⭐ **THE RUNNER AND THE SUBJECT ARE THE SAME BINARY, AND NOTHING OUTSIDE CLOSES THAT.** `maxon test
// tests/run` both runs these cases and provides the `maxon run` they spawn — named by `TestedCompilerStem`
// and by nothing else — so a runner broken badly enough to report green having run nothing cannot detect
// itself. READ THE PASS COUNT.
//
// ⛔⛔ **EVERY CASE GETS ITS OWN CACHE ROOT, AND THAT IS TWO FACTS AT ONCE.** `maxon test` runs files
// CONCURRENTLY, so two cases sharing a cache would race over one slot; and the cache the driver reaches
// for by default is the developer's own temp area, which a test must neither write into nor read a
// previous run out of. The override travels as `CacheRootVariable` in the child's environment.
//
// ⛔ **EVERY FREE FUNCTION IN A DIRECTORY SHARES ONE NAMESPACE, whatever its visibility** (E3006). So the
// corpus gets ONE shared half, exported from this file, and a case file beside it declares only what that
// case alone uses. A file-private `let` does NOT collide, so a constant declared twice is the half nothing
// catches: every constant this corpus shares is declared here.
//
// ⛔ **EVERYTHING THAT WOULD STOP A CASE RUNNING AT ALL PANICS RATHER THAN FAILING AN ASSERTION**: a
// missing compiler, an unspellable path, a spawn that never happened, a fixture that could not be staged.
// None of those is the driver answering wrongly.
//
// ⛔ **THIS FILE'S PATHS ARE RELATIVE TO THE CHECKOUT ROOT**, which is the working directory a test binary
// inherits from `maxon test`. Everything handed to a child is made absolute first, because a relative path
// resolves against the child's directory on POSIX and the parent's on Windows.

// The binary this directory spawns, relative to the checkout root and without its host suffix. It is the
// compiler under test AND the driver under test.
let TestedCompilerStem = "maxon-bin/.maxon/maxon"

// The command word under test, and the variable that tells it where to keep its builds.
//
// ⚠ **SPELLED AGAIN HERE, WHICH IS FORCED**: this corpus is a separate program and cannot read the
// driver's own constants. Every such respelling is in THIS file — the command word and the cache variable
// below, and the slot layout further down — so a rename in the driver is one file to follow it into, and
// it goes red rather than quiet: a case cannot find its slot, or finds an entry it cannot classify.
export let RunCommandName = "run"
let CacheRootVariable = "MAXON_RUN_CACHE_ROOT"

// ⭐ **THE FIXTURE ROSTER.** `corpus.test.maxon` compares it against the directories actually on disk, so a
// fixture nobody stages and a name no directory answers to are both red. Every case names its fixture
// through one of these.
export let HelloFixtureName = "hello"
export let ExitCodeFixtureName = "exit-code"
export let ArgvFixtureName = "argv"
export let StdinFixtureName = "stdin"
export let BrokenFixtureName = "broken"
export let ProjectFixtureName = "project"

export function fixtureNames() returns StringArray
	var names = StringArray.create()
	names.push(HelloFixtureName)
	names.push(ExitCodeFixtureName)
	names.push(ArgvFixtureName)
	names.push(StdinFixtureName)
	names.push(BrokenFixtureName)
	names.push(ProjectFixtureName)

	return names
end 'fixtureNames'

// What the fixtures print and return. Spelled here because several cases stage one fixture and each
// asserts what it saw; a drift between a fixture and one of these goes red in the case that reads it.
export let HelloGreeting = "hello from maxon run"
export let ProjectGreeting = "two files, one program"
export let ForwardedExitCode = 7

// Where the corpus lives and where a runnable copy is built, both relative to the checkout root. Staging
// goes to gitignored `temp/`: a live `.maxon` under `tests/` is one `maxon fmt` over the checkout rewrites.
export let FixturesDirName = "tests/run/fixtures"
export let ProjectDirName = "tests/run"
let StagingRootDirName = "temp/run"

// The stored-name mapping, `tests/README.md` rule 1: `<name>.fixture -> <name>`.
export let StoredFixtureSuffix = ".fixture"
let StagedProgramFileName = "main.maxon"

// The two halves of a case's staging tree. Separate directories rather than one, so the cache's own files
// can never reach the source walk the command under test performs.
let StagedSourcesDirName = "program"
let StagedCacheDirName = "cache"

// The layout the driver keeps its slots in, which is the whole of how a case finds one without respelling
// the key rule: `<cache>/maxon/run/<one directory per program>`.
let CacheVendorDirName = "maxon"
let CacheCommandDirName = "run"

// What a slot holds beside the executable, and the marker a build still being written carries. The
// executable is the entry that is NEITHER, derived rather than named, so no case has to know what the
// driver calls a build.
let SidecarSuffix = ".mxdbg"
let PendingBuildMarker = ".tmp"

// The suffix that marks a source file as test code, what an ordinary Maxon source is called, and the one
// ordinary source allowed to sit in this corpus. Read by the guards in `corpus.test.maxon`.
export let TestSourceSuffix = ".test.maxon"
export let MaxonSourceSuffix = ".maxon"
export let SharedHelperFileName = "RunHarness.maxon"

// The separator this file's own paths are spelled with, folded into the host's by `FilePath`.
let PathSeparator = "/"

// The fold every reader here applies to a captured stream: CR dropped, so a Windows console's line endings
// do not decide what a line says or where one ends.
export let LineFeed = "\n"
let CarriageReturn = "\r"

// A file's size in bytes, as a case compares two of them, and how many files one staging produced.
typealias StagedFileSize = int(0 to u64.max)
typealias StagedFileTally = int(0 to u32.max)

// A list of paths one directory walk produced. Stdlib's own `FilePathArray` is a member of `Directory` and
// has no file-scope spelling.
export typealias PathArray = Array with FilePath
typealias StreamingChildArray = Array with StreamingSubprocess

// ============================================================================================
// STAGING
// ============================================================================================

// One case's tree: the program's sources, and the build cache that run is confined to.
export type StagedCase
	export let sources as FilePath
	export let cache as FilePath

	static function create(sources FilePath, cache FilePath) returns StagedCase
		return Self{sources: sources, cache: cache}
	end 'create'
end 'StagedCase'

// A runnable copy of one fixture under a directory named for the CASE, with an empty cache beside it. The
// previous run's files go first, both halves: a stale executable in the cache is exactly what a cache case
// must not inherit, and a stale source is a program nobody wrote.
//
// The FIXTURE is a required parameter and is not the case label: several cases stage `hello` and each
// needs a tree of its own.
export function stageCase(caseLabel String, fixture String) returns StagedCase
	let root = stagingDir("{StagingRootDirName}{PathSeparator}{caseLabel}")
	clearStagedFiles(root)

	let sources = stagingDir("{StagingRootDirName}{PathSeparator}{caseLabel}{PathSeparator}{StagedSourcesDirName}")
	let cache = stagingDir("{StagingRootDirName}{PathSeparator}{caseLabel}{PathSeparator}{StagedCacheDirName}")

	var staged = 0 as StagedFileTally

	for entry in listing(fixtureDir("{FixturesDirName}{PathSeparator}{fixture}")) 'eachStoredFile'
		let name = entry.filename()

		if not name.endsWith(StoredFixtureSuffix) 'notAFixtureFile'
			continue
		end 'notAFixtureFile'

		let body = try File.readText(entry) otherwise panic("run tests: the gate could not run — could not read the stored fixture {entry.toString()}.")
		let liveName = name.replace(StoredFixtureSuffix, with: "")
		try File.writeText(sources.join("{liveName}"), content: body) otherwise panic("run tests: the gate could not run — could not stage {liveName} into {sources.toString()}.")
		staged = staged + 1
	end 'eachStoredFile'

	if staged == 0 'anEmptyFixture'
		panic("run tests: the gate could not run — the '{fixture}' fixture staged no file. Every fixture directory holds at least one `<name>{StoredFixtureSuffix}`, and a case that staged nothing would run whatever the last one left behind.")
	end 'anEmptyFixture'

	return StagedCase.create(sources, cache: cache)
end 'stageCase'

// The staged program's entry file, which is what a FILE case hands the driver.
export function stagedMain(staged StagedCase) returns FilePath
	return staged.sources.join("{StagedProgramFileName}")
end 'stagedMain'

// Rewrite the staged program, replacing one piece of its text. What a cache case needs and nothing else
// can express: an EDIT, made after a build, that the next run must notice.
export function rewriteStagedMain(staged StagedCase, replacing String, becoming String)
	let path = stagedMain(staged)
	let body = try File.readText(path) otherwise panic("run tests: the gate could not run — could not read {path.toString()}, which this process staged moments ago.")

	if not body.contains(replacing) 'nothingToReplace'
		panic("run tests: the gate could not run — the staged program does not contain '{replacing}', so the edit this case is about would change nothing and the run after it would be a cache HIT for the wrong reason.")
	end 'nothingToReplace'

	try File.writeText(path, content: body.replace(replacing, with: becoming)) otherwise panic("run tests: the gate could not run — could not rewrite {path.toString()}.")
end 'rewriteStagedMain'

// ============================================================================================
// SPAWNING
// ============================================================================================

// `maxon run <program>` — the ordinary command line, with the program made absolute.
export function runArguments(program FilePath) returns StringArray
	var arguments = StringArray.create()
	arguments.push(RunCommandName)
	arguments.push(program.toString())

	return arguments
end 'runArguments'

// One child driver, run in the case's staging tree with its cache confined to that tree. A binary that is
// not there and a spawn that never happened both stop a case running at all, so both panic naming what
// was being asked for.
export function spawnDriver(staged StagedCase, arguments StringArray, standardInput InputSource) returns CollectedOutput
	var config = Configuration.create(Executable.path(requireTestedCompiler()))
	config.arguments = arguments
	config.workingDirectory = staged.sources
	config.standardInput = standardInput
	config.environment = Environment.inheritUpdating([CacheRootVariable: staged.cache.toString()])

	return try config.run() otherwise (e) 'spawnFailed'
		panic("run tests: the gate could not run — could not spawn the driver ({e.displayReason()}). These cases pin what it does, and a run nothing observed is a claim.")
	end 'spawnFailed'
end 'spawnDriver'

// The shape almost every case wants: `maxon run <program>`, with stdin closed.
export function runProgram(staged StagedCase, program FilePath) returns CollectedOutput
	return spawnDriver(staged, arguments: runArguments(program), standardInput: InputSource.none)
end 'runProgram'

// ============================================================================================
// SPAWNING SEVERAL AT ONCE
// ============================================================================================

// How many children one concurrent case launches, and what one of them reported.
export typealias ConcurrentRunTally = int(1 to 64)
typealias ChildExitCode = int(i64.min to i64.max)

export type ConcurrentRun
	export let exitCode as ChildExitCode
	export let stdout as String
	export let stderr as String

	static function create(exitCode ChildExitCode, stdout String, stderr String) returns ConcurrentRun
		return Self{exitCode: exitCode, stdout: stdout, stderr: stderr}
	end 'create'
end 'ConcurrentRun'

export typealias ConcurrentRunArray = Array with ConcurrentRun

// ⭐⭐ **EVERY CHILD IS SPAWNED BEFORE ANY OF THEM IS WAITED ON, WHICH IS WHAT MAKES THIS CONCURRENT.**
// `Configuration.run()` cannot express it — it spawns and waits in one call, so a loop over it is a
// QUEUE — and a case built on a queue would be green against a driver that no two runs may share.
//
// The streams are drained to end-of-stream and only then is the child waited on. Both are pipes with a
// buffer the OS chooses, so a child left unread while its sibling is waited on could fill one and block
// forever; these children write one line and nothing.
export function spawnConcurrentRuns(staged StagedCase, program FilePath, howMany ConcurrentRunTally) returns ConcurrentRunArray
	let binary = requireTestedCompiler()
	let arguments = runArguments(program)
	let environment = Environment.inheritUpdating([CacheRootVariable: staged.cache.toString()])

	var children = StreamingChildArray.create()

	for _ in 1 to howMany 'eachChild'
		var child = try StreamingSubprocess.spawnWithEnvironment(Executable.path(binary), arguments: arguments, workingDirectory: staged.sources, environment: environment) otherwise (e) 'spawnFailed'
			panic("run tests: the gate could not run — could not spawn a concurrent driver ({e.displayReason()}). This case pins what several simultaneous runs do, and a run nothing observed is a claim.")
		end 'spawnFailed'

		// These children read nothing, and an open write end would leave one waiting on stdin forever.
		child.closeStdin()
		children.push(child)
	end 'eachChild'

	var reported = ConcurrentRunArray.create()

	for child in children 'eachChild'
		let stdout = drainStream(child, stderr: false)
		let stderr = drainStream(child, stderr: true)
		let code = try child.wait() otherwise (e) 'waitFailed'
			panic("run tests: the gate could not run — could not wait for a concurrent driver ({e.displayReason()}).")
		end 'waitFailed'

		child.release()
		reported.push(ConcurrentRun.create(code as ChildExitCode, stdout: stdout, stderr: stderr))
	end 'eachChild'

	return reported
end 'spawnConcurrentRuns'

// One child stream read to end-of-stream, terminators restored. The reader answers `""` at end of stream
// and strips the terminator from every line, so a line has to have one put back for a case to compare
// what it reads against what a program prints.
function drainStream(child StreamingSubprocess, stderr bool) returns String
	var collected = ""

	while true 'untilEndOfStream'
		let line = try readOneLine(child, stderr: stderr) otherwise (e) 'readFailed'
			panic("run tests: the gate could not run — could not read a concurrent driver's output ({e.displayReason()}).")
		end 'readFailed'

		if line.isEmpty() 'endOfStream'
			break
		end 'endOfStream'

		collected.append("{line}{LineFeed}")
	end 'untilEndOfStream'

	return collected
end 'drainStream'

function readOneLine(child StreamingSubprocess, stderr bool) returns String throws SubprocessError
	if stderr 'theErrorStream'
		return try child.readStderrLine()
	end 'theErrorStream'

	return try child.readStdoutLine()
end 'readOneLine'

// The compiler under test, absolute and with the suffix this host can spawn.
function requireTestedCompiler() returns FilePath
	let spelled = "{TestedCompilerStem}{executableSuffix()}"
	let relative = try FilePath.from(spelled) otherwise panic("run tests: the gate could not run — '{spelled}' is not a spellable path")
	let binary = relative.resolve(Directory.currentPath())

	if not File.exists(binary) 'noBinary'
		panic("run tests: the gate could not run — this corpus needs a compiler at {binary.toString()} and there is none. Its paths are relative to the CHECKOUT ROOT (see the header); run it from there, and build `{TestedCompilerStem}` first.")
	end 'noBinary'

	return binary
end 'requireTestedCompiler'

function executableSuffix() returns String
	#if os(Windows)
		let suffix = ".exe"
	#else
		let suffix = ""
	#endif

	return suffix
end 'executableSuffix'

// ============================================================================================
// READING THE CACHE
// ============================================================================================

// ⭐ **THE SLOT IS FOUND BY BEING THE ONLY ONE, NOT BY RESPELLING THE KEY RULE.** A case's cache is private
// and holds one program's build, so a listing of exactly one entry both locates the slot and checks that
// the driver put its build where its own layout says. Anything else is the instrument being wrong about
// the run it has just performed.
export function soleSlotDir(staged StagedCase) returns FilePath
	let slots = staged.cache.join("{CacheVendorDirName}").join("{CacheCommandDirName}")

	if not Directory.isDirectory(slots) 'nothingCached'
		panic("run tests: the gate could not run — the driver cached nothing under {slots.toString()}. Every run in this corpus is pointed at a private cache through {CacheRootVariable}.")
	end 'nothingCached'

	let entries = listing(slots)

	if entries.count() != 1 'notExactlyOne'
		panic("run tests: the gate could not run — {slots.toString()} holds {entries.count()} slots and a case's cache is one program's. More than one means a staging tree was shared with another case.")
	end 'notExactlyOne'

	return try entries.get(0) otherwise panic("run tests: the count is 1 on the line above")
end 'soleSlotDir'

// The executables a slot holds: every entry that is neither a debug sidecar nor a build still being
// written. Derived by elimination rather than by name, so no case has to know what the driver calls a
// build, and returned as a LIST because one case's whole subject is that there is none.
//
// ⭐ **A PENDING NAME IS EXCLUDED HERE AND MUST BE**, because it is excluded from the driver's hit test
// too: counting one would make a run that CRASHED mid-build read exactly like a cached one.
export function slotExecutables(staged StagedCase) returns PathArray
	var found = PathArray.create()

	for entry in listing(soleSlotDir(staged)) 'eachEntry'
		let name = entry.filename()

		if name.endsWith(SidecarSuffix) or name.endsWith(pendingBuildSuffix()) 'notAPublishedBuild'
			continue
		end 'notAPublishedBuild'

		found.push(entry)
	end 'eachEntry'

	return found
end 'slotExecutables'

// What an in-flight build's name ends in, which is how one is told from a published build: a published
// name ends in the key's hex digits.
function pendingBuildSuffix() returns String
	return "{PendingBuildMarker}{executableSuffix()}"
end 'pendingBuildSuffix'

// The entries a slot holds whose names end in `suffix`.
function slotEntriesEndingIn(staged StagedCase, suffix String) returns PathArray
	var found = PathArray.create()

	for entry in listing(soleSlotDir(staged)) 'eachEntry'
		if entry.filename().endsWith(suffix) 'thisOne'
			found.push(entry)
		end 'thisOne'
	end 'eachEntry'

	return found
end 'slotEntriesEndingIn'

// The one entry a slot holds of a kind it holds exactly one of. Any other count is the instrument being
// wrong about the run it has just performed, never the driver answering wrongly, so it panics.
function soleSlotEntry(staged StagedCase, found PathArray, what String) returns FilePath
	if found.count() != 1 'notExactlyOne'
		panic("run tests: the gate could not run — {soleSlotDir(staged).toString()} holds {found.count()} entries that could be {what}, and a slot holds one.")
	end 'notExactlyOne'

	return try found.get(0) otherwise panic("run tests: the count is 1 on the line above")
end 'soleSlotEntry'

function soleSlotExecutable(staged StagedCase) returns FilePath
	return soleSlotEntry(staged, found: slotExecutables(staged), what: "the cached executable")
end 'soleSlotExecutable'

// The cached executable's size, as a case compares two of them. NOT its modification time: a rebuild
// landing in the same whole second as the build it replaced ties, which is the very ambiguity the driver's
// content-hash key exists to remove.
export function slotExecutableSize(staged StagedCase) returns StagedFileSize
	let executable = soleSlotExecutable(staged)
	let info = try File.info(executable) otherwise panic("run tests: the gate could not run — could not read {executable.toString()}, which this run wrote moments ago.")

	return info.size as StagedFileSize
end 'slotExecutableSize'

// ⭐⭐ **THE CACHED BUILD'S NAME, WHICH IS THE KEY IT WAS BUILT UNDER.** The driver keeps nothing beside
// the executable and compares nothing: a build's name carries the hash of everything it was made from, so
// two runs reaching one name is a hit and a name that moved is a miss.
export function slotExecutableName(staged StagedCase) returns String
	return soleSlotExecutable(staged).filename()
end 'slotExecutableName'

// ⭐⭐ **THE ONE THING A CASE CAN REMOVE TO ASK WHETHER THE NEXT RUN COMPILED.** A build writes the debug
// sidecar beside its executable; nothing reads it back and it is not part of the cache key, so taking it
// away changes no answer the driver gives — except that a REBUILD writes it again and a reused build does
// not. Without it, "the binary did not change" is equally true of a cache that recompiled the same source
// to the same bytes.
export function removeSlotSidecar(staged StagedCase)
	let sidecar = soleSlotEntry(staged, found: slotEntriesEndingIn(staged, suffix: SidecarSuffix), what: "the debug sidecar")
	try File.delete(sidecar) otherwise panic("run tests: the gate could not run — could not remove {sidecar.toString()}, which is how this case asks whether the next run compiled.")
end 'removeSlotSidecar'

export function slotHasSidecar(staged StagedCase) returns bool
	return slotEntriesEndingIn(staged, suffix: SidecarSuffix).count() > 0
end 'slotHasSidecar'

// ============================================================================================
// READING A CAPTURED STREAM
// ============================================================================================

export function withoutCarriageReturns(raw String) returns String
	return raw.replace(CarriageReturn, with: "")
end 'withoutCarriageReturns'

// ============================================================================================
// DIRECTORIES
// ============================================================================================

// Delete every file under a staging tree, leaving the directories. A case stages the same shape every
// time, and the previous run's products must not survive into a comparison.
function clearStagedFiles(dir FilePath)
	for entry in listing(dir) 'eachEntry'
		if Directory.isDirectory(entry) 'aDirectory'
			clearStagedFiles(entry)
			continue
		end 'aDirectory'

		try File.delete(entry) otherwise panic("run tests: the gate could not run — could not clear {entry.toString()} from a previous run's staging tree.")
	end 'eachEntry'
end 'clearStagedFiles'

// A directory this corpus's paths name, refused loudly when it is not there: every such refusal is the
// working-directory contract in the header not being met.
export function fixtureDir(spelled String) returns FilePath
	let path = try FilePath.from(spelled) otherwise panic("run tests: the gate could not run — '{spelled}' is not a spellable path")

	if not Directory.isDirectory(path) 'notThere'
		panic("run tests: the gate could not run — there is no directory at '{spelled}'. Every path in this corpus is relative to the CHECKOUT ROOT, which is the working directory a test binary inherits from `maxon test`; a run started anywhere else finds nothing.")
	end 'notThere'

	return path
end 'fixtureDir'

// A directory this run writes into, created with its missing ancestors so a fresh checkout without `temp/`
// is not a failure, and absolute because it is handed to a child process.
function stagingDir(spelled String) returns FilePath
	let path = try FilePath.from(spelled) otherwise panic("run tests: the gate could not run — '{spelled}' is not a spellable path")

	if not Directory.create(path) 'couldNotCreate'
		panic("run tests: the gate could not run — could not create '{spelled}'. It is where a case's runnable copy and its private build cache live; nothing can be staged without it.")
	end 'couldNotCreate'

	return path.resolve(Directory.currentPath())
end 'stagingDir'

// What one directory holds.
export function listing(dir FilePath) returns PathArray
	return try Directory.list(dir) otherwise panic("run tests: the gate could not run — could not list {dir.toString()}")
end 'listing'
