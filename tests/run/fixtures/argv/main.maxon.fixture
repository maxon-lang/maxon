// Every argument this program was given, one per line. `args()` opens with the executable's own path,
// which the driver supplies and no caller typed, so what is printed is exactly what was forwarded.

function main() returns ExitCode
	let arguments = CommandLine.args()
	for position in 1 upto arguments.count() 'eachArgument'
		let argument = try arguments.get(position) otherwise panic("argv fixture: position < args().count() but get failed")
		print("{argument}\n")
	end 'eachArgument'

	return 0
end 'main'
