let LintFixQuotientOverflowCaseDirName = "lint-fix-quotient-overflow"
let LintFixQuotientOverflowFixture = "lint-fix-unused-quotient-that-can-overflow"
let LintFixQuotientOverflowCode = "E3012"
let LintFixQuotientOverflowSite = "main.maxon:4:6"
let LintFixQuotientOverflowMessage = "unused variable: 'q'"

test 'lint --fix leaves an unused local bound to a quotient of two negative-only values, which can overflow and abort, and reports it'
	let outcome = lintFixRefusedWith(ExpectedDiagnostic.at(LintFixQuotientOverflowCode, site: LintFixQuotientOverflowSite, message: LintFixQuotientOverflowMessage))
	requireHeldOutsideCheckout(LintFixQuotientOverflowCaseDirName, check: LintFixCase.of(LintFixQuotientOverflowFixture, arguments: [AppDirName], fixed: LintFixedFileArray.create(0), outcome: outcome))
end 'lint --fix leaves an unused local bound to a quotient of two negative-only values, which can overflow and abort, and reports it'
