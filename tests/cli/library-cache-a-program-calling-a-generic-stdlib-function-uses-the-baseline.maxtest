let CaseDirName = "library-cache-generic-stdlib-call"
let ProgramDirName = "app"
let OutputName = "program"
let Subject = "a program calling a generic stdlib function"

let GenericCallProgramSource = "function main() returns ExitCode\n\ttry Expect.equal(1, expected: 1) otherwise return 1\n\ttry Expect.equal(\"a\", expected: \"a\") otherwise return 1\n\treturn 42\nend 'main'\n"

test 'a program that calls a generic stdlib function builds warm on the library baseline and writes the bytes a cold build writes'
	requireHeldOutsideCheckout(CaseDirName, check: GenericCallUsesTheBaseline.create())
end 'a program that calls a generic stdlib function builds warm on the library baseline and writes the bytes a cold build writes'

type GenericCallUsesTheBaseline implements OutsideCheckoutCase
	static function create() returns GenericCallUsesTheBaseline
		return Self{}
	end 'create'

	export function requireHeldIn(dir FilePath) throws TestFailure
		stageProgram(dir, name: ProgramDirName, source: GenericCallProgramSource)

		let builds = try requireWarmBuildMatchesCold(dir, program: ProgramDirName, output: OutputName, subject: Subject)

		let cold = try libraryCacheReportOf(builds.cold, which: "the cold build of {Subject}")
		try Expect.equal(cold.baseline, expected: LibraryBaseline.built, message: "the cold build of {Subject} did not build the library baseline: the program must be one the baseline serves, whatever generic functions it instantiates. It wrote: {cold.line}")

		let warm = builds.warm
		try Expect.equal(warm.written, expected: 0, message: "the warm build of {Subject} wrote library cache entries the cold build had already written. It wrote: {warm.line}")
		try Expect.equal(warm.rejected, expected: 0, message: "the warm build of {Subject} rejected entries the cold build had just written. It wrote: {warm.line}")
		try Expect.equal(warm.parsed, expected: 0, message: "the warm build of {Subject} parsed library files itself instead of loading them. It wrote: {warm.line}")
	end 'requireHeldIn'
end 'GenericCallUsesTheBaseline'
