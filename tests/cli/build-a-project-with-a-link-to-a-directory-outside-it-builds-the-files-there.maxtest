#if not os(Windows)
	let OutsideLinkCaseDirName = "build-link-outside-the-root"
	let OutsideProjectDirName = "project"
	let OutsideLibraryDirName = "shared"
	let OutsideLinkName = "external"
	let OutsideLinkMainSource = "function main() returns ExitCode\n\treturn answer()\nend 'main'\n"
	let OutsideLinkLibrarySource = "export function answer() returns ExitCode\n\treturn 0\nend 'answer'\n"

	test 'a project holding a link to a directory outside its root builds the files there'
		requireHeldOutsideCheckout(OutsideLinkCaseDirName, check: LinkOutsideTheRootIsFollowed.create())
	end 'a project holding a link to a directory outside its root builds the files there'

	type LinkOutsideTheRootIsFollowed implements OutsideCheckoutCase
		static function create() returns LinkOutsideTheRootIsFollowed
			return Self{}
		end 'create'

		export function requireHeldIn(dir FilePath) throws TestFailure
			let project = stagingDir(dir.join(OutsideProjectDirName).toString())
			let shared = stagingDir(dir.join(OutsideLibraryDirName).toString())

			writeStagedFile(project.join(StagedProgramFileName), content: OutsideLinkMainSource)
			writeStagedFile(shared.join("Answer.maxon"), content: OutsideLinkLibrarySource)

			let link = project.join(OutsideLinkName)
			_ = runSystemTool("ln", arguments: ["-s", "../{OutsideLibraryDirName}", link.toString()], what: "`ln -s` making a link from the project to a directory outside it")

			let build = spawnCompiler([BuildCommandWord, "."], staged: project)

			try File.delete(link) otherwise panic("the gate could not run — could not remove the link {link.toString()}.")

			let said = "It wrote to stdout: {build.stdout} and to stderr: {build.stderr}"

			try Expect.equal(build.exitCode(), expected: 0, message: "a project whose only declaration of `answer` is in a directory outside its root, reached through a link, did not build. {said}")

			let named = project.join("{OutsideProjectDirName}{executableSuffix()}")
			try Expect.isTrue(File.exists(named), message: "the build exited 0 and wrote no {named.toString()}. {said}")
		end 'requireHeldIn'
	end 'LinkOutsideTheRootIsFollowed'
#endif
