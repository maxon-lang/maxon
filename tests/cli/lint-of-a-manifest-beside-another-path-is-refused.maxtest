let LintOfAManifestBesideAPathCaseDirName = "lint-of-a-manifest-beside-a-path"
let LintOfAManifestBesideAPathFixture = "lint-manifest-program-clean"
let LintOfAManifestBesideAPathManifest = "app.maxproj"
let LintOfAManifestBesideAPathSource = "src/main.maxon"
let LintOfAManifestBesideAPathWords = "is a manifest, which is linted alone"

test 'lint of a manifest file named beside another path is refused as a usage error and lints nothing'
	requireHeldOutsideCheckout(LintOfAManifestBesideAPathCaseDirName, check: LintUsageRefusalCase.of(LintOfAManifestBesideAPathFixture, arguments: [LintOfAManifestBesideAPathManifest, LintOfAManifestBesideAPathSource], words: [LintOfAManifestBesideAPathWords, LintOfAManifestBesideAPathManifest]))
end 'lint of a manifest file named beside another path is refused as a usage error and lints nothing'
