let LibraryCacheExtensionMethodWithALibraryFunctionSignatureCaseDirName = "library-cache-extension-method-signature"
let ExtensionMethodWithALibraryFunctionSignatureProgramSource = "extension String\n\tpublic function needleOccursIn(haystack String, len BytePos, needle String) returns bool\n\t\treturn len > haystack.byteLength() + needle.byteLength()\n\tend 'needleOccursIn'\nend 'String'\n\ntypealias Tally = int(0 to 1000)\n\nfunction main() returns ExitCode\n\tlet seed = 21\n\tlet words = \"seed \{seed\} grows\".split(\" \")\n\twords.insert(0, value: \"then\")\n\tlet word = try words.get(2) otherwise \"\"\n\tlet length = word.byteLength() as Tally\n\tlet found = 8 if word.contains(\"2\") else 0\n\tlet missed = 4 if word.contains(\"z\") else 0\n\tlet own = 2 if word.needleOccursIn(word, len: 2, needle: \"2\") else 0\n\treturn (length + seed + found + missed + own) as ExitCode\nend 'main'\n"
let ExtensionMethodWithALibraryFunctionSignatureProgramExitCode = 31

test 'a program that adds an extension method with the signature of a function a library method calls is served the library parses of the program before it'
	requireHeldOutsideCheckout(LibraryCacheExtensionMethodWithALibraryFunctionSignatureCaseDirName, check: BuiltInSequenceMatchesCold.create([SequencedProgram.create(ExtensionMethodWithALibraryFunctionSignatureProgramSource, exitCode: ExtensionMethodWithALibraryFunctionSignatureProgramExitCode, subject: "a program that extends `String` with a method named `needleOccursIn` taking what the free function `contains` calls bare takes, and answering otherwise", expectation: LibraryCacheExpectation.servedEveryParse)]))
end 'a program that adds an extension method with the signature of a function a library method calls is served the library parses of the program before it'
