let LintOfAManifestUnusedCaseDirName = "lint-of-a-manifest-unused"
let LintOfAManifestUnusedFixture = "lint-manifest-program-unused-unexported"
let LintOfAManifestUnusedFile = "app.maxproj"
let LintOfAManifestUnusedSite = "app.maxproj:6:10"
let LintOfAManifestUnusedBuiltExit = 0

test 'lint of a manifest file lints the manifest program and reports an unexported function nothing live names'
	let findings = ExpectedDiagnosticArray.create(0)
	findings.push(ExpectedDiagnostic.at(UnusedUnexportedCode, site: LintOfAManifestUnusedSite, message: UnusedLeftoverMessage))
	requireHeldOutsideCheckout(LintOfAManifestUnusedCaseDirName, check: LintOfAManifestProgramCase.of(LintOfAManifestUnusedFixture, manifest: LintOfAManifestUnusedFile, proof: [BuildCommandWord], provedExit: LintOfAManifestUnusedBuiltExit, findings: findings))
end 'lint of a manifest file lints the manifest program and reports an unexported function nothing live names'
