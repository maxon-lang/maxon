let LintFixPureOfAnEffectCaseDirName = "lint-fix-pure-of-an-effect"
let LintFixPureOfAnEffectFixture = "lint-fix-discarded-pure-result-of-an-effect"
let LintFixPureOfAnEffectSite = "main.maxon:15:2"
let LintFixPureOfAnEffectMessage = "result of pure function 'doubled' must be used"

test 'lint --fix leaves a discarded pure call whose argument has an effect of its own, and reports it as lint does'
	let outcome = lintFixRefusedWith(ExpectedDiagnostic.at(DiscardedPureResultCode, site: LintFixPureOfAnEffectSite, message: LintFixPureOfAnEffectMessage))
	requireHeldOutsideCheckout(LintFixPureOfAnEffectCaseDirName, check: LintFixCase.of(LintFixPureOfAnEffectFixture, arguments: [AppDirName], fixed: LintFixedFileArray.create(0), outcome: outcome))
end 'lint --fix leaves a discarded pure call whose argument has an effect of its own, and reports it as lint does'
