let LintFixQualifiedMatchCaseFixture = "lint-fix-qualified-match-case"
let LintFixQualifiedMatchCaseFindings = 1

test 'lint --fix writes a qualified match case as its bare name, and the program still runs'
	requireHeldOutsideCheckout(LintFixQualifiedMatchCaseFixture, check: lintFixRunningCase(LintFixQualifiedMatchCaseFixture, findings: LintFixQualifiedMatchCaseFindings))
end 'lint --fix writes a qualified match case as its bare name, and the program still runs'
