let LintFixCrlfOrChainCaseDirName = "lint-fix-crlf-or-chain"
let LintFixCrlfOrChainFixture = "lint-fix-packed-or-chain"
let LintFixCrlfOrChainFindings = 1

test 'lint --fix breaks an or-chain packed on one line of a file written with CRLF line endings with a CRLF of its own, and the program still runs'
	requireHeldOutsideCheckout(LintFixCrlfOrChainCaseDirName, check: lintFixRunningCase(LintFixCrlfOrChainFixture, findings: LintFixCrlfOrChainFindings, lineEndings: LintFixLineEndings.carriageReturnLineFeeds))
end 'lint --fix breaks an or-chain packed on one line of a file written with CRLF line endings with a CRLF of its own, and the program still runs'
