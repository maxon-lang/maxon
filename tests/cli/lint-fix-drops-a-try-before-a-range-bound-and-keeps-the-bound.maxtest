let LintFixTryBeforeRangeFixture = "lint-fix-try-before-a-range-bound"
let LintFixTryBeforeRangeFindings = 2
let LintFixTryBeforeRangePrinted = "1\n2\n1\n2\n3\n"

test 'lint --fix drops a try and its otherwise value from the start of an upto and of a to range in a for head and keeps the bound after it, and the program prints what it printed'
	requireHeldOutsideCheckout(LintFixTryBeforeRangeFixture, check: lintFixRunningCase(LintFixTryBeforeRangeFixture, findings: LintFixTryBeforeRangeFindings, printed: LintFixPrinted.exactly(LintFixTryBeforeRangePrinted)))
end 'lint --fix drops a try and its otherwise value from the start of an upto and of a to range in a for head and keeps the bound after it, and the program prints what it printed'
