// cache-clear-sweeps-every-root.test.maxon — ONE `maxon cache clear` empties every cache root this host
// names, and not only the one the next run would use.
//
// ⭐⭐ **A CACHE PUBLISHED UNDER A LOWER-RANKED CANDIDATE IS UNREACHABLE AND STILL ON DISK.** The roster is
// consulted in order and the first root that resolves wins, so every build a machine made before
// `MAXON_RUN_CACHE_ROOT` was set sits under its home directory where nothing looks again — and a clear
// that stopped at the winner would be the last thing that could have reached it.
//
// ⛔ **THE CLEAR STILL STOPS AT THE ROOT.** `<home>/.maxon` is where the install script puts `bin/` and
// `stdlib/`; only the `cache` under it is the cache.

let CaseDirName = "cache-clear-sweeps-every-root"
let HomeDirName = "home"

test 'cache clear empties every cache root this host names'
	let dir = freshCaseDir(CaseDirName)
	let cacheRoot = cacheRootIn(dir)
	let home = dir.join(HomeDirName)

	publishCachedBuild(dir, cacheRoot: cacheRoot)
	publishCachedBuildInHome(dir, home: home)

	let owned = cacheRoot.join(CacheVendorDirName)
	let homeOwned = homeCacheRoot(home)

	var naming = EnvMap.create()
	naming.upsert(CacheRootVariable, value: cacheRoot.toString())
	naming.upsert(HomeDirectoryVariable, value: home.toString())

	let cleared = runWithCacheRoots([CacheCommandWord, CacheClearVerb], naming: naming, workingDirectory: dir)
	let said = "It wrote to stdout: {cleared.stdout} and to stderr: {cleared.stderr}"

	Expect.equal(cleared.exitCode() as AssertedInt, expected: 0, message: "`maxon {CacheCommandWord} {CacheClearVerb}` did not succeed over two roots that each held a build. {said}")

	Expect.isFalse(Directory.exists(owned), message: "`maxon {CacheCommandWord} {CacheClearVerb}` left {owned.toString()} standing, which is the root {CacheRootVariable} names and the one the next run would use. {said}")

	Expect.isFalse(Directory.exists(homeOwned), message: "`maxon {CacheCommandWord} {CacheClearVerb}` left {homeOwned.toString()} standing. {CacheRootVariable} outranks {HomeDirectoryVariable}, so a build made before the override was set is stranded there and nothing else will ever look for it. {said}")

	Expect.isTrue(Directory.isDirectory(cacheRoot), message: "`maxon {CacheCommandWord} {CacheClearVerb}` removed {cacheRoot.toString()}, which the CALLER named through {CacheRootVariable} and Maxon did not create. {said}")

	Expect.isTrue(Directory.isDirectory(home.join(MaxonUserDirName)), message: "`maxon {CacheCommandWord} {CacheClearVerb}` removed {home.join(MaxonUserDirName).toString()}, which is where an install puts `{ScriptInstallBinDirName}/` and `{StdlibDirName}/`. Only the cache under it is the cache. {said}")
end 'cache clear empties every cache root this host names'
