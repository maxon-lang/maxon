let LibraryCacheStringableMethodNamedGetCaseDirName = "library-cache-method-get"
let StringableMethodNamedGetProgramSource = "typealias Tally = int(0 to 1000)\n\ntype Job implements Stringable\n\tlet weight as Tally\n\n\tstatic function create(weight Tally) returns Job\n\t\treturn Self\{weight: weight\}\n\tend 'create'\n\n\tfunction doubled() returns Tally\n\t\treturn self.weight * 2\n\tend 'doubled'\n\n\tfunction get() returns Tally\n\t\treturn self.doubled()\n\tend 'get'\n\n\tfunction toString() returns String\n\t\treturn \"job\"\n\tend 'toString'\nend 'Job'\n\nfunction main() returns ExitCode\n\tlet seed = 21\n\tlet words = \"seed \{seed\} grows\".split(\" \")\n\twords.insert(0, value: \"then\")\n\tlet word = try words.get(2) otherwise \"\"\n\tlet length = word.byteLength() as Tally\n\tlet extra = Job.create(5).get()\n\treturn (length + seed + extra) as ExitCode\nend 'main'\n"
let StringableMethodNamedGetProgramExitCode = 33

test 'a program that adds a Stringable type with a method named get whose body returns a call is served the library parses of the program before it'
	requireHeldOutsideCheckout(LibraryCacheStringableMethodNamedGetCaseDirName, check: BuiltInSequenceMatchesCold.create([SequencedProgram.create(StringableMethodNamedGetProgramSource, exitCode: StringableMethodNamedGetProgramExitCode, subject: "a program that adds a type conforming to `Stringable` with a method named `get` whose body returns a call", expectation: LibraryCacheExpectation.servedEveryParse)]))
end 'a program that adds a Stringable type with a method named get whose body returns a call is served the library parses of the program before it'
