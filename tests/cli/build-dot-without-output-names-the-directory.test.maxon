// build-dot-without-output-names-the-directory.test.maxon - `maxon build .` with no `-o` names the executable
// for the directory `.` is, never `..exe` and never for a source file inside it.
//
// Staged outside the checkout: a build without `-o` inside it would take the checkout's tree lock.

let CaseDirName = "build-dot-without-output"
let AppDirName = "app"
let CurrentDirectorySpelling = "."
let MainSourceFileName = "zeta.maxon"
let MainSourceStem = "zeta"
let MainSource = "function main() returns ExitCode\n\treturn 0\nend 'main'\n"

test 'a directory built as . without -o is named for the directory'
	let dir = freshOutsideCheckoutDir(CaseDirName)
	let app = dir.join(AppDirName)

	if not Directory.create(app) and not Directory.isDirectory(app) 'couldNotCreate'
		panic("build-dot-without-output: the gate could not run - could not create {app.toString()}")
	end 'couldNotCreate'

	let source = app.join(MainSourceFileName)
	try File.writeText(source, content: MainSource) otherwise panic("build-dot-without-output: the gate could not run - could not write {source.toString()}")

	let build = runDriver([BuildCommandWord, CurrentDirectorySpelling], workingDirectory: app)
	let said = "It wrote to stdout: {build.stdout} and to stderr: {build.stderr}"
	try Expect.equal(build.exitCode() as AssertedInt, expected: 0, message: "a one-file directory did not build as `.`. {said}")

	let named = app.join("{AppDirName}{executableSuffix()}")
	try Expect.isTrue(File.exists(named), message: "`maxon build .` in {app.toString()} wrote no {named.toString()}. {said}")
	try Expect.isFalse(File.exists(app.join("{MainSourceStem}{executableSuffix()}")), message: "`maxon build .` named its executable for a source file. {said}")
end 'a directory built as . without -o is named for the directory'
