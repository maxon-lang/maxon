let LibraryCacheFreeFunctionNamedSleepCaseDirName = "library-cache-free-sleep"
let FreeFunctionNamedSleepProgramSource = "typealias Tally = int(0 to 1000)\n\nfunction sleep(amount Tally) returns Tally\n\treturn amount + 2\nend 'sleep'\n\nfunction main() returns ExitCode\n\tlet seed = 21\n\tlet words = \"seed \{seed\} grows\".split(\" \")\n\twords.insert(0, value: \"then\")\n\tlet word = try words.get(2) otherwise \"\"\n\tlet length = word.byteLength() as Tally\n\tlet extra = sleep(5)\n\treturn (length + seed + extra) as ExitCode\nend 'main'\n"
let FreeFunctionNamedSleepProgramExitCode = 30

test 'a program that adds a free function named like a free function the library declares sweeps the library itself and builds the bytes a cold build writes'
	requireHeldOutsideCheckout(LibraryCacheFreeFunctionNamedSleepCaseDirName, check: BuiltInSequenceMatchesCold.create([SequencedProgram.create(FreeFunctionNamedSleepProgramSource, exitCode: FreeFunctionNamedSleepProgramExitCode, subject: "a program that adds a free function named `sleep`, the name of a free function the library declares", expectation: LibraryCacheExpectation.leavesTheBaselineUnused)]))
end 'a program that adds a free function named like a free function the library declares sweeps the library itself and builds the bytes a cold build writes'
