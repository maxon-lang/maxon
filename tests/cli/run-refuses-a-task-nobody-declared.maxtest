let RunRefusesATaskNobodyDeclaredCaseDirName = "run-refuses-a-task-nobody-declared"
let RunRefusesATaskNobodyDeclaredTaskFileName = "tasks.maxtasks"
let RunRefusesATaskNobodyDeclaredAskedFor = "nosuchtask"

let RunRefusesATaskNobodyDeclaredTasksSource = "export typealias ExitCode = int(0 to 255)\n\nexport function report() returns ExitCode\n\treturn 0\nend 'report'\n"

test 'a task nobody declared is refused and the tasks that are there are listed'
	let dir = freshCaseDir(RunRefusesATaskNobodyDeclaredCaseDirName)
	let tasks = dir.join(RunRefusesATaskNobodyDeclaredTaskFileName)
	writeStagedFile(tasks, content: RunRefusesATaskNobodyDeclaredTasksSource)

	let refused = spawnCompiler([RunCommandWord, RunRefusesATaskNobodyDeclaredAskedFor], staged: dir)
	let said = "It wrote to stdout: {refused.stdout} and to stderr: {refused.stderr}"

	Expect.equal(refused.exitCode(), expected: 1, message: "`maxon {RunCommandWord}` accepted a task the {RunRefusesATaskNobodyDeclaredTaskFileName} does not declare. {said}")
	Expect.contains(refused.stderr, needle: RunRefusesATaskNobodyDeclaredAskedFor, message: "the refusal did not name the task that was asked for. {said}")
	Expect.contains(refused.stdout, needle: "report", message: "the refusal did not list the tasks that ARE there, which is the only thing that tells the reader what to type instead. {said}")
end 'a task nobody declared is refused and the tasks that are there are listed'
