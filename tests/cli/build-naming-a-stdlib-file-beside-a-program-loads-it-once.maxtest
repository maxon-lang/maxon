test 'a build naming a stdlib file beside a program compiles that file once, as the librarys'
	expectALibraryFileBesideAProgramIsReadOnce("build-naming-a-stdlib-file-beside-a-program-loads-it-once", libraryFile: "stdlib/Clock.maxon", whoseFile: "the standard library's own file, in a project not rooted in `stdlib/`")
end 'a build naming a stdlib file beside a program compiles that file once, as the librarys'
