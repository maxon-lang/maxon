let LintFixUnusedExportCaseDirName = "lint-fix-unused-export"
let LintFixUnusedExportFixture = "lint-fix-unused-export"
let LintFixUnusedExportFile = "app/helper.maxon"
let LintFixUnusedExportFindings = 1

test 'lint --fix drops an export that only a file of its own directory uses, and then lints clean'
	let fixed = lintFixFixedFiles(LintFixUnusedExportFile, findings: LintFixUnusedExportFindings)
	requireHeldOutsideCheckout(LintFixUnusedExportCaseDirName, check: LintFixCase.of(LintFixUnusedExportFixture, arguments: [AppDirName], fixed: fixed, outcome: LintFixOutcome.linted(AppDirName)))
end 'lint --fix drops an export that only a file of its own directory uses, and then lints clean'
