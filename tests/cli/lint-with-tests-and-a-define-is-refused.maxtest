let LintWithTestsAndADefineCaseDirName = "lint-with-tests-and-a-define"
let LintWithTestsAndADefineFixture = "lint-tests-declaring-channel"
let LintWithTestsAndADefineOption = "--tests"
let LintWithTestsAndADefineDirectory = "."
let LintWithTestsAndADefineOptionPrefix = "--define="
let LintWithTestsAndADefineBinding = "Channel=nightly"

test 'lint --tests with --define= is refused as a usage error, since maxon test takes no defines'
	requireHeldOutsideCheckout(LintWithTestsAndADefineCaseDirName, check: LintUsageRefusalCase.of(LintWithTestsAndADefineFixture, arguments: [LintWithTestsAndADefineOption, LintWithTestsAndADefineDirectory, "{LintWithTestsAndADefineOptionPrefix}{LintWithTestsAndADefineBinding}"], words: [LintWithTestsAndADefineOptionPrefix, LintWithTestsAndADefineOption]))
end 'lint --tests with --define= is refused as a usage error, since maxon test takes no defines'
