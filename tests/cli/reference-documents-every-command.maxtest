// reference-documents-every-command.maxtest — every command `maxon help` documents has a section in the
// CLI reference, and every option spelling it lists appears there.
//
// ⭐ BOTH ROSTERS ARE READ OFF `maxon help`, so a command or option added to the driver is demanded of the
// document without this file naming it.
//
// A section is a line starting `### ` that contains `` `maxon <command>` `` — one heading may name two
// commands. An option is named when the document spells it as a unit (`spellingsIn`), so `--output=` is
// not satisfied by `--output-dir`.

let SectionHeadingPrefix = "### "

test 'the CLI reference has a section for every command and names every option help lists'
	let reference = runOneArgument(HelpCommandWord)

	let observedExit = reference.exitCode() as AssertedInt
	Expect.equal(observedExit, expected: 0, message: "`maxon {HelpCommandWord}` printed the reference and then failed. It said: {reference.stdout}{reference.stderr}")

	let commands = sectionedCommandsIn(reference.stdout)

	// ⚠ Both differences below are vacuous over an empty reading, so this comes first.
	let missingAnchors = anchorsMissingFrom(commands)
	Expect.isEmpty(missingAnchors, message: "`maxon {HelpCommandWord}` has no section for these commands: {missingAnchors}. It showed: {listed(commands)}")

	let options = optionSpellingsIn(reference.stdout)
	Expect.isTrue(options.count() > 0, message: "no option was read off `maxon {HelpCommandWord}`, so the comparison below would be vacuous. It said: {reference.stdout}")

	let document = cliReferenceText()
	let headings = sectionHeadingsIn(document)
	var unsectioned = ListedWordArray.create()

	for command in commands 'eachCommand'
		if not anyHeadingNames(headings, command: command) 'noSection'
			unsectioned.push(command)
		end 'noSection'
	end 'eachCommand'

	let unnamed = wordsNotIn(options, right: spellingsIn(document))

	// Both lists are reported by one failure, because each is half of the work the document owes.
	var findings = ""

	if unsectioned.count() > 0 'missingSections'
		findings.append("these commands have no `{SectionHeadingPrefix}{CodeSpanMark}{DriverInvocation}<command>{CodeSpanMark}` heading: {listed(unsectioned)}. ")
	end 'missingSections'

	if unnamed.count() > 0 'missingOptions'
		findings.append("these option spellings appear nowhere: {listed(unnamed)}.")
	end 'missingOptions'

	Expect.isEmpty(findings, message: "{CliReferenceDocument} does not document everything `maxon {HelpCommandWord}` lists - {findings}")
end 'the CLI reference has a section for every command and names every option help lists'

function sectionHeadingsIn(document String) returns ListedWordArray
	var headings = ListedWordArray.create()

	for line in document.split("\n") 'eachLine'
		if line.startsWith(SectionHeadingPrefix) 'aSectionHeading'
			headings.push(line)
		end 'aSectionHeading'
	end 'eachLine'

	return headings
end 'sectionHeadingsIn'

function anyHeadingNames(headings ListedWordArray, command String) returns bool
	for heading in headings 'eachHeading'
		if heading.contains("{CodeSpanMark}{DriverInvocation}{command}{CodeSpanMark}") 'namesIt'
			return true
		end 'namesIt'
	end 'eachHeading'

	return false
end 'anyHeadingNames'
