let LintFixManifestProjectCaseDirName = "lint-fix-manifest-project"
let LintFixManifestProjectFixture = "lint-fix-manifest-project"
let LintFixManifestProjectFile = "src/main.maxon"
let LintFixManifestProjectFindings = 1
let LintFixManifestProjectSubject = "src"

test 'lint --fix with no path in a manifest project fixes the sources its build target selects and leaves a stray directory alone'
	let fixed = lintFixFixedFiles(LintFixManifestProjectFile, findings: LintFixManifestProjectFindings)
	requireHeldOutsideCheckout(LintFixManifestProjectCaseDirName, check: LintFixCase.of(LintFixManifestProjectFixture, arguments: StringArray.create(0), fixed: fixed, outcome: LintFixOutcome.linted(LintFixManifestProjectSubject), place: LintFixPlace.insideTheProject))
end 'lint --fix with no path in a manifest project fixes the sources its build target selects and leaves a stray directory alone'
