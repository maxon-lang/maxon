let LibraryCacheAddsAByReferenceFunctionNamedLikeALibraryCalleeCaseDirName = "library-cache-adds-by-reference-library-callee"
let AddsAByReferenceFunctionNamedLikeALibraryCalleeProgramSource = "typealias Tally = int(0 to 1000)\n\nfunction set(total mutable Tally, amount Tally, times Tally)\n\ttotal = total + amount * times\nend 'set'\n\nfunction main() returns ExitCode\n\tlet seed = 21\n\tlet words = \"seed \{seed\} grows\".split(\" \")\n\twords.insert(0, value: \"then\")\n\tlet word = try words.get(2) otherwise \"\"\n\tlet length = word.byteLength() as Tally\n\tvar total = length\n\tset(total, amount: seed, times: 2)\n\treturn total as ExitCode\nend 'main'\n"
let AddsAByReferenceFunctionNamedLikeALibraryCalleeProgramExitCode = 44

test 'a program that adds a function taking a mutable parameter, named like a call the library spells, builds warm to the bytes a cold build writes'
	requireHeldOutsideCheckout(LibraryCacheAddsAByReferenceFunctionNamedLikeALibraryCalleeCaseDirName, check: BuiltAfterAnotherMatchesCold.create(AddsAByReferenceFunctionNamedLikeALibraryCalleeProgramSource, exitCode: AddsAByReferenceFunctionNamedLikeALibraryCalleeProgramExitCode, subject: "a program that adds a free function taking a `mutable` parameter, under a name a library file spells as the callee of a call"))
end 'a program that adds a function taking a mutable parameter, named like a call the library spells, builds warm to the bytes a cold build writes'
