let LibraryCacheRangedAliasCaseDirName = "library-cache-alias-ranged"
let RangedAliasFirstProgramSource = "typealias Tally = int(0 to 1000)\ntypealias Count = int(0 to 100)\n\nfunction doubled(value Count) returns Count\n\treturn value * 2\nend 'doubled'\n\nfunction main() returns ExitCode\n\tlet seed = 21\n\tlet words = \"seed \{seed\} grows\".split(\" \")\n\twords.insert(0, value: \"then\")\n\tlet word = try words.get(2) otherwise \"\"\n\tlet length = word.byteLength() as Tally\n\tlet held = words.count() as Tally\n\tlet extra = doubled(7) as Tally\n\treturn (length + seed + held + extra) as ExitCode\nend 'main'\n"
let RangedAliasFirstProgramExitCode = 41
let RangedAliasSecondProgramSource = "typealias Tally = int(0 to 1000)\ntypealias Count = int(0 to 300)\n\nfunction doubled(value Count) returns Count\n\treturn value * 2\nend 'doubled'\n\nfunction main() returns ExitCode\n\tlet seed = 21\n\tlet words = \"seed \{seed\} grows\".split(\" \")\n\twords.insert(0, value: \"then\")\n\tlet word = try words.get(2) otherwise \"\"\n\tlet length = word.byteLength() as Tally\n\tlet held = words.count() as Tally\n\tlet extra = doubled(9) as Tally\n\treturn (length + seed + held + extra) as ExitCode\nend 'main'\n"
let RangedAliasSecondProgramExitCode = 45

test 'a program declaring a ranged alias the library declares is served the library parses of another program declaring that alias'
	requireHeldOutsideCheckout(LibraryCacheRangedAliasCaseDirName, check: BuiltInSequenceMatchesCold.create([SequencedProgram.create(RangedAliasFirstProgramSource, exitCode: RangedAliasFirstProgramExitCode, subject: "a program that declares a `Count` alias of its own beside the library `Count` a `count()` returns, built after a program that declares none", expectation: LibraryCacheExpectation.loadsTheBaselineAndParsesTheLibrary), SequencedProgram.create(RangedAliasSecondProgramSource, exitCode: RangedAliasSecondProgramExitCode, subject: "a program that declares a `Count` alias of another range than the `Count` of the program before it", expectation: LibraryCacheExpectation.servedEveryParse)]))
end 'a program declaring a ranged alias the library declares is served the library parses of another program declaring that alias'
