export typealias ReportedTally = int(i64.min to i64.max)

// CliHarness.maxon — the shared half every case under `tests/cli/` reaches for: the compiler it spawns,
// one run of it, a copy of it staged where an install would put it, and the three readings of what it
// printed that let these cases assert WITHOUT keeping a list of commands of their own.
//
// ⭐⭐ **WHAT THIS CORPUS PROVES: THE DRIVER'S OWN FACE — `maxon` with no arguments, `maxon help`, and
// `maxon upgrade`, which answers from where the running binary sits, and what `maxon build` names, skips and
// reports.** Those are driver commands, so they
// are gated by spawning the compiler and asserting what it reports (`tests/README.md`), and they cannot be
// gated in `specs/`: a spec case is a Maxon PROGRAM the harness compiles and runs, which can reach
// `stdlib/` and nothing else.
//
// ⛔⛔ **NOT ONE BYTE OF THIS CORPUS IS A GOLDEN, AND THAT IS FORCED.** The reference embeds the commit
// the binary was built from, the day, the host target, the supported target list and this machine's
// default worker count — five values that differ between two correct checkouts. So every case here
// asserts a PROPERTY instead, and the sharpest ones compare the driver's two listings AGAINST EACH OTHER.
//
// ⛔⛔ **A CENSUS OF COMMANDS TYPED HERE WOULD ROT, so there is none.** A list of the driver's commands
// kept in this file would go stale the day one is added, and a gate that walks a stale list reports green
// about a command nobody wrote down. What is asked instead is the ROUND TRIP the driver's design
// promises: every command the short list advertises has a section in `maxon help`, and `maxon help <that
// word>` answers for it. The roster is read off the binary, every time.
//
// ⚠ **AND A ROUND TRIP OVER AN EMPTY SET PASSES.** Two parses that both found nothing agree perfectly,
// which is why `anchorCommands` exists: three words that must appear, so a reading that silently stopped
// working cannot report agreement. It is deliberately NOT a census — it is the proof that the census read
// off the binary is non-empty.
//
// ⛔ **EVERYTHING THAT WOULD STOP A CASE RUNNING AT ALL PANICS RATHER THAN FAILING AN ASSERTION**: a
// missing compiler, an unspellable path, a spawn that never happened. None of those is the driver
// answering wrongly.
//
// ⛔ **THIS FILE'S PATHS ARE RELATIVE TO THE CHECKOUT ROOT**, which is the working directory a test binary
// inherits from `maxon test`. A run started anywhere else fails loudly rather than finding nothing.

export let HelpCommandWord = "help"

export let BuildCommandWord = "build"
export let ScaleTestCommandWord = "scale-test"
export let TestCommandWord = "test"
export let VersionCommandWord = "version"

// The command that fills the cache, the command that empties it, and the variable naming the directory
// the cache is kept under. Respelled here because this corpus is a separate program and cannot read the
// driver's own constants.
export let ExecuteCommandWord = "execute"
export let CacheCommandWord = "cache"
export let CacheClearVerb = "clear"

// ⭐ **THE ONE DIRECTORY MAXON OWNS UNDER THE ROOT THAT VARIABLE NAMES.** Everything the cache holds sits
// below it and nothing else in that root is Maxon's, so a case asks about THIS directory rather than
// respelling the slot layout under it — and the caller's own root, which the cache may not touch, is the
// directory above.
export let CacheVendorDirName = "maxon"

// ⚠ **THE OTHER VARIABLES THE DRIVER CONSULTS FOR A CACHE ROOT, RESPELLED FOR THE REASON ABOVE**, and it
// reads a different set per host. `HomeDirectoryVariable` and `HostTempVariable` are exported because a
// case fills the cache one of them names, or points two of them at one directory.
#if os(Windows)
	export let HomeDirectoryVariable = "USERPROFILE"
	let WindowsCacheRootVariable = "LOCALAPPDATA"
#else
	export let HomeDirectoryVariable = "HOME"
#endif

// What the driver owns under a HOME directory: its own directory beside the `bin/` and `stdlib/` an
// install puts there, rather than a `maxon` directory in a scratch area. The install directory is
// exported because a clear must stop at the `cache` below it.
export let MaxonUserDirName = ".maxon"
let UserCacheDirName = "cache"

// What the header's second line says, beneath the version line.
export let EarlyPreviewWords = "early preview"

// ⭐ THREE WORDS THAT PROVE A READING IS NOT VACUOUS — see the header. Not a census: a command added to
// the driver belongs in neither this list nor any other list in this corpus.
function anchorCommands() returns StringArray
	return [BuildCommandWord, VersionCommandWord, HelpCommandWord]
end 'anchorCommands'

// ⭐ AND ONE THAT PROVES THE HIDING IS REAL. The short list leaves out the commands for working on the
// compiler itself; a split that hid NOTHING would satisfy every subset assertion here perfectly, so one
// word is named as a command that must be documented and must NOT be advertised. Not a census of the
// hidden set either — it is the proof that the set is not empty.
export let HiddenAnchorCommand = "spec-test"

// ⚠ A SECOND HIDDEN COMMAND, NAMED FOR ONE REASON: spawned with no argument it refuses INSTANTLY, where
// the anchor above would run the whole spec suite. `hidden-command-still-parses` needs a hidden command
// it can actually spawn.
export let HiddenCheapCommand = "verify-recheck"

// What a refusal says when a word reached the parser as a stranger — the failure hiding a command from a
// LISTING must never produce.
export let UnknownCommandPhrase = "unknown command"

// The command the `upgrade-*` cases are about, and the one option it takes.
export let UpgradeCommandWord = "upgrade"
export let DryRunFlag = "--dry-run"
export let McpServerCommandWord = "mcp-server"
export let DevFlag = "--dev"

// Where a case places a copy of the compiler, relative to the checkout root: gitignored, and one
// directory per case under it, because `maxon test` runs files concurrently.
let StagingRootDirName = "temp/cli"

// The directory a script install keeps its binary in - `<root>/bin/maxon` beside `<root>/stdlib` - and the
// spelling a staging call uses for the case's own directory. Respelled from the install script, which this
// corpus cannot read.
export let ScriptInstallBinDirName = "bin"
export let CaseDirItself = ""

// Where the install script is published, which every answer `upgrade` gives about it names.
export let InstallScriptAddress = "maxon.dev/install"

// The library root the compiler loads beside `stdlib/`, copied with it into an install-shaped stage.
let RuntimeDirName = "runtime"

let CheckScriptlibCommandWord = "check-scriptlib"

// Where a case keeps the cache it is about, under its own staging directory, and the program it caches a
// build of. The program is never inspected — only compiled, so that a build exists to be removed.
let CaseCacheDirName = "cache"
let CachedProgramFileName = "cached.maxon"
let CachedProgramSource = "function main() returns ExitCode\n\treturn 0\nend 'main'\n"

// A case that must stage outside the checkout goes under the host's temp area. The variable naming
// that area is `HostTempVariable`, which the driver's cache reads too.
let VendorDirName = "vendor"

// How the reference is laid out, and the whole of what these cases read it by. A COMMAND SECTION sits at
// the left margin of `maxon help`; a LABEL — a command under `Commands:`, an option under its section — is
// indented two spaces; wrapped prose starts in the text column, far to the right of either.
let LabelIndent = "  "
let DeeperThanALabel = "   "

// The two left-margin lines of a listing that are not command sections: the usage line, and a heading
// over a run of sections. ⚠ **A HEADING ENDS IN A COLON AND A COMMAND LABEL NEVER DOES** — that is the
// whole of how the two are told apart, and the driver's `CompilerWorkHeading` says so from its side.
export let UsageLinePrefix = "Usage:"
let HeadingSuffix = ":"

// What an option's spelling always begins with, and a command word never does.
let OptionPrefix = "-"

// How a label lays out its spellings: alternatives are comma-separated, a flag taking a value names it
// after `=`, and the description column starts after a gap of two spaces or more.
let LabelAlternativeSeparator = ", "

// Declared in both arms because its reader outside this file is itself gated out on wasm32-wasi: exported
// everywhere, it is an export with nothing to reference it on that lane, and E3092 refuses the whole
// corpus there.
#if not os(Wasi)
	export let OptionValueSeparator = "="
#else
	let OptionValueSeparator = "="
#endif

let DescriptionColumnGap = "  "

// What a run of an option spelling is made of beside letters and digits; `OptionValueSeparator` may end one.
let SpellingHyphen = "-"
let SpellingUnderscore = "_"

// The document every command and option must be documented in, from the checkout root.
export let CliReferenceDocument = "docs/CLI_REFERENCE.md"

// How that document spells an invocation, and the mark around inline code.
export let DriverInvocation = "maxon "
export let CodeSpanMark = "`"

// The last byte that means the same thing under every code page a console might be set to.
let LastAsciiByte = 127

// A list of the words one listing showed, and how many of them a case is asking for.
export typealias WordTally = int(0 to u32.max)

// What a case's private directory for one candidate cache-root variable is called, named after the
// variable so a child's environment can be read back off the tree it wrote into.
let PrivateRootPrefix = "env-"

// Reading a decimal count out of a report.
let AsciiZero = 48
let AsciiNine = 57

// A report is one line per subject, and what a line says about its subject follows the path naming it.
let ReportLineSeparator = "\n"
let StateFollowsThePath = 1

// A report a case meant to read something out of and could not. A sentence stating no count at all and one
// naming none of the directories the case put a cache in are two different gaps, and a case reporting
// either has to say which.
export enum ReportReadingError implements Error
	statesNoCount
	namesNoSuchDirectory
end 'ReportReadingError'

// What `maxon version` prints: the line the header opens with.
export function versionLine() returns String
	let line = spawnCompiler([VersionCommandWord]).stdout.trim()

	if line.isEmpty() 'noVersion'
		panic("CliHarness: the gate could not run - `maxon {VersionCommandWord}` printed nothing to compare a header with.")
	end 'noVersion'

	return line
end 'versionLine'

// ⭐ **THE HEADER: THE FIRST TWO LINES OF STDOUT ARE THE VERSION, EXACTLY AS `maxon version` PRINTS IT,
// AND THE EARLY-PREVIEW WARNING.** Asked of `build` and of `maxon` alone, which open with the same two lines.
export function requireVersionHeader(stdout String, which String) throws TestFailure
	let lines = stdout.split("\n")
	let first = try lines.get(0) otherwise ""
	let second = try lines.get(1) otherwise ""

	try Expect.equal(first.trim(), expected: versionLine(), message: "{which} does not open with the version `maxon {VersionCommandWord}` prints. Its stdout was: {stdout}")
	try Expect.contains(second, needle: EarlyPreviewWords, message: "{which} does not warn, on its second line, that Maxon is an early preview. Its stdout was: {stdout}")
end 'requireVersionHeader'

// **A COPY OF THE COMPILER UNDER TEST, PLACED THE WAY AN INSTALL PLACES ONE, WITH AN EMPTY `stdlib/`.**
// The compiler takes the NEAREST `stdlib/` above its own executable, so the staged one is found before the
// checkout's, and whatever the copy concludes about how it was installed it reads off where it sits.
//
// `binaryIn` and `stdlibIn` name the directories holding the binary and `stdlib/`, relative to the case's
// own staging directory, which `CaseDirItself` names. The previous run's files go first, so a rerun stages
// the same tree. Only the files go: a directory is re-created before a case uses it, and an empty one
// holds nothing a compile could read.
export function stageCompiler(caseDirName String, binaryIn String, stdlibIn String) returns FilePath
	for component in [binaryIn, stdlibIn] 'eachSpelling'
		requireStaysInStaging(component)
	end 'eachSpelling'

	_ = freshCaseDir(caseDirName)
	_ = stagingDir("{caseRelative(caseDirName, relative: stdlibIn)}{PortablePathSeparator}{StdlibDirName}")

	let staged = stagingDir(caseRelative(caseDirName, relative: binaryIn)).join(testedCompilerPath().filename())
	let original = testedCompilerPath()
	copyFile(original, into: staged, mode: FilePermission.executable)

	return staged
end 'stageCompiler'

// A case's own staging directory, absolute, with the previous run's files cleared so a rerun starts from
// the same tree.
export function freshCaseDir(caseDirName String) returns FilePath
	requireOneDirectoryName(caseDirName)

	let dir = stagingDir(caseRelative(caseDirName, relative: CaseDirItself))
	clearStagedTree(dir)
	return dir
end 'freshCaseDir'

let BesideAProgramMainSource = "function main() returns ExitCode\n\tlet started = WallClock.nowUnixSeconds()\n\treturn 0 if started > 0 else 1\nend 'main'\n"
let BesideAProgramOutputStem = "program"
let DuplicateDefinitionCode = "E3006"

export type ProgramBuiltBesideALibraryFile
	export let executable as FilePath
	export let build as CollectedOutput

	static function create(executable FilePath, build CollectedOutput) returns ProgramBuiltBesideALibraryFile
		return Self{executable: executable, build: build}
	end 'create'
end 'ProgramBuiltBesideALibraryFile'

export function buildAProgramBesideALibraryFile(caseDirName String, libraryFile String, options StringArray) returns ProgramBuiltBesideALibraryFile
	let dir = freshCaseDir(caseDirName)
	let main = dir.join(StagedProgramFileName)
	writeStagedFile(main, content: BesideAProgramMainSource)

	var arguments = StringArray.create()
	arguments.push(BuildCommandWord)
	arguments.push(main.toString())
	arguments.push(libraryFile)

	for option in options 'eachOption'
		arguments.push(option)
	end 'eachOption'

	arguments.push("{OutputOptionPrefix}{dir.join(BesideAProgramOutputStem).toString()}")

	return ProgramBuiltBesideALibraryFile.create(dir.join("{BesideAProgramOutputStem}{executableSuffix()}"), build: spawnCompiler(arguments))
end 'buildAProgramBesideALibraryFile'

export function expectALibraryFileBesideAProgramIsReadOnce(caseDirName String, libraryFile String, whoseFile String) throws TestFailure
	let built = buildAProgramBesideALibraryFile(caseDirName, libraryFile: libraryFile, options: StringArray.create())
	let build = built.build
	let said = "It wrote to stdout: {build.stdout} and to stderr: {build.stderr}"

	try Expect.isFalse(build.stderr.contains(DuplicateDefinitionCode), message: "`{libraryFile}` was named on the command line and is also {whoseFile}, so the build loaded it twice and every declaration in it collided with itself. {said}")
	try Expect.equal(build.exitCode(), expected: 0, message: "a program built together with `{libraryFile}` did not build. The file is {whoseFile} whether or not a command line names it, and a build that reads it once compiles clean. {said}")
	try Expect.isTrue(File.exists(built.executable), message: "the build exited 0 and wrote no executable. {said}")
end 'expectALibraryFileBesideAProgramIsReadOnce'

// An interface rather than a closure, because a closure may not throw a `TestFailure` (E3101).
export interface OutsideCheckoutCase
	function requireHeldIn(dir FilePath) throws TestFailure
end 'OutsideCheckoutCase'

export function requireHeldOutsideCheckout(caseDirName String, check OutsideCheckoutCase) throws TestFailure
	try requireHeldThenDiscard(freshOutsideCheckoutDirWithoutVendor(caseDirName), check: check)
end 'requireHeldOutsideCheckout'

// An install-shaped copy of the compiler under test: `<dir>/bin/maxon` beside a full
// `<dir>/stdlib/` and `<dir>/runtime/`, copied from the checkout, so it compiles real programs and
// nothing it walks to — from its own image or from a working directory under `<dir>` — is the
// checkout.
export function requireHeldInAnInstallOutsideCheckout(caseDirName String, check OutsideCheckoutCase) throws TestFailure
	let dir = freshOutsideCheckoutDirWithoutVendor(caseDirName)

	for library in [StdlibDirName, RuntimeDirName] 'eachLibrary'
		copyTree(fixtureDir(library).resolve(Directory.currentPath()), into: dir.join(library))
	end 'eachLibrary'

	_ = stagingDir(dir.join(ScriptInstallBinDirName).toString())
	copyFile(testedCompilerPath(), into: installedCompilerIn(dir), mode: FilePermission.executable)

	try requireHeldThenDiscard(dir, check: check)
end 'requireHeldInAnInstallOutsideCheckout'

export function installedCompilerIn(installDir FilePath) returns FilePath
	return installDir.join(ScriptInstallBinDirName).join(testedCompilerPath().filename())
end 'installedCompilerIn'

export function runCheckScriptlib(installDir FilePath) returns CollectedOutput
	return runWithCacheRoot([CheckScriptlibCommandWord], cacheRoot: cacheRootIn(installDir), workingDirectory: installDir, binary: installedCompilerIn(installDir))
end 'runCheckScriptlib'

function freshOutsideCheckoutDirWithoutVendor(caseDirName String) returns FilePath
	let dir = freshOutsideCheckoutDir(caseDirectoryName(caseDirName))
	requireNoVendorAbove(dir)

	return dir
end 'freshOutsideCheckoutDirWithoutVendor'

function requireHeldThenDiscard(dir FilePath, check OutsideCheckoutCase) throws TestFailure
	try check.requireHeldIn(dir) otherwise (failure) 'failed'
		discardOutsideCheckoutDir(dir)
		throw failure
	end 'failed'

	discardOutsideCheckoutDir(dir)
end 'requireHeldThenDiscard'

// The cache root a case hands the driver: a directory under the case's own staging directory, so nothing
// here reads the developer's real cache or writes into it.
export function cacheRootIn(dir FilePath) returns FilePath
	return stagingDir(dir.join(CaseCacheDirName).toString())
end 'cacheRootIn'

// ⭐ **WHERE THE DRIVER CACHES UNDER A HOME DIRECTORY.** Respelled here for the reason the variables above
// are, and the whole of what a case needs to know about that candidate's layout.
export function homeCacheRoot(home FilePath) returns FilePath
	return home.join(MaxonUserDirName).join(UserCacheDirName)
end 'homeCacheRoot'

// A regular file rather than a permission bit: no permission survives a checkout, a copy or a
// foreign host, while a path that is a file refuses a directory create on every operating system
// there is.
let BlockedRootFileContent = "a regular file, so nothing can be created at this path or under it\n"

export function blockCacheRootAt(path FilePath)
	writeStagedFile(path, content: BlockedRootFileContent)
end 'blockCacheRootAt'

let BlockedRootFileName = "a-file-where-a-directory-would-go"
let FallThroughRootDirName = "fall-through"

export function rosterWithHighestRootBlocked(dir FilePath) returns EnvMap
	let blocked = blockedHighestRoot(dir)
	blockCacheRootAt(blocked)

	let fallThrough = stagingDir(dir.join(FallThroughRootDirName).toString())

	var naming = EnvMap.create()
	naming.upsert(HomeDirectoryVariable, value: blocked.toString())
	naming.upsert(rootRankedBelowHomeVariable(), value: fallThrough.toString())

	return naming
end 'rosterWithHighestRootBlocked'

export function blockedHighestRoot(dir FilePath) returns FilePath
	return dir.join(BlockedRootFileName)
end 'blockedHighestRoot'

export function fallThroughCacheRoot(dir FilePath) returns FilePath
	return dir.join(FallThroughRootDirName).join(CacheVendorDirName)
end 'fallThroughCacheRoot'

// ⭐⭐ **ONE DRIVER RUN WITH EVERY CANDIDATE CACHE ROOT INSIDE THE CASE'S OWN TREE.** `maxon cache clear`
// sweeps every root this host names rather than only the one in use, so a child left looking at the
// developer's home or temp area would have a case in this corpus delete the developer's own cache.
// `naming` gives the variables the case is about; every other candidate gets a private directory apiece.
//
// ⭐ **EVERY ROOT THE DRIVER CONSULTS IS ONE A VARIABLE NAMES, WHICH IS WHAT MAKES THE CONFINEMENT
// COMPLETE**: a child here can reach no cache directory outside the case's own tree, so no case can count
// or remove anything of the developer's.
export function runWithCacheRoots(arguments StringArray, naming EnvMap, workingDirectory FilePath, binary FilePath = testedCompilerPath()) returns CollectedOutput
	return spawnCompiler(arguments, binary: binary, environment: confinedCacheEnvironment(workingDirectory, naming: naming), staged: workingDirectory)
end 'runWithCacheRoots'

// One driver run whose cache is confined to `cacheRoot`.
export function runWithCacheRoot(arguments StringArray, cacheRoot FilePath, workingDirectory FilePath, binary FilePath = testedCompilerPath()) returns CollectedOutput
	var naming = EnvMap.create()
	naming.upsert(CacheRootVariable, value: cacheRoot.toString())

	return runWithCacheRoots(arguments, naming: naming, workingDirectory: workingDirectory, binary: binary)
end 'runWithCacheRoot'

let BlockedRootOrdinalSeparator = "-"

export function blockedRootFileIn(dir FilePath, ordinal ElementIndex) returns FilePath
	return dir.join("{BlockedRootFileName}{BlockedRootOrdinalSeparator}{ordinal}")
end 'blockedRootFileIn'

export function rosterWithEveryCandidateBlocked(dir FilePath) returns EnvMap
	var naming = EnvMap.create()

	for (iter, variable) in confinableCacheVariables().withIterator() 'eachCandidate'
		let blocked = blockedRootFileIn(dir, ordinal: iter.index())
		blockCacheRootAt(blocked)

		naming.upsert(variable, value: blocked.toString())
	end 'eachCandidate'

	return naming
end 'rosterWithEveryCandidateBlocked'

// ⛔ **`Environment.inheritUpdating` CANNOT REMOVE A VARIABLE**, so the whole environment is assembled
// here — which is also what lets a case run a child that sees no cache override at all.
//
// ⚠ Built from the INHERITED entries rather than from scratch: a child handed a bare environment can fail
// to start on Windows for want of `SystemRoot`.
//
// ⚠ Windows folds a variable name case-insensitively and this map does not, so a candidate is dropped
// case-insensitively there: the real environment may spell one in any case.
function confinedCacheEnvironment(dir FilePath, naming EnvMap) returns Environment
	let inherited = try Process.currentEnvironmentEntries() otherwise panic("CliHarness: the gate could not run - this process's environment could not be read, and a child inheriting the developer's own cache roots would clear the developer's cache.")

	var vars = EnvMap.create()

	for entry in inherited 'eachEntry'
		let name = Process.envEntryName(entry)

		if namesACacheRoot(name) 'aCandidate'
			continue
		end 'aCandidate'

		vars.upsert(name, value: Process.envEntryValue(entry))
	end 'eachEntry'

	for (variable, spelled) in naming 'eachNamed'
		vars.upsert(variable, value: spelled)
	end 'eachNamed'

	for variable in confinableCacheVariables() 'eachVariable'
		if vars.contains(variable) 'theCaseNamedIt'
			continue
		end 'theCaseNamedIt'

		vars.upsert(variable, value: privateRootFor(dir, variable: variable).toString())
	end 'eachVariable'

	return Environment.custom(vars)
end 'confinedCacheEnvironment'

// ⭐ **THE CANDIDATES A CASE MAY POINT SOMEWHERE ELSE.** The override is not one of them: a case that
// names nothing must reach a child that sees none, which is the only way to fill the cache a lower-ranked
// candidate keeps.
export function confinableCacheVariables() returns StringArray
	#if os(Windows)
		let variables = [HomeDirectoryVariable, WindowsCacheRootVariable, HostTempVariable]
	#else
		let variables = [HomeDirectoryVariable, HostTempVariable]
	#endif

	return variables
end 'confinableCacheVariables'

function variablesACallerCanSet() returns StringArray
	var variables = StringArray.create()

	for variable in confinableCacheVariables() 'eachCandidate'
		variables.push(variable)
	end 'eachCandidate'

	variables.push(CacheRootVariable)

	return variables
end 'variablesACallerCanSet'

// Callers must not name a fixture after a cache variable. The driver quotes the paths it walked, so
// a file called `TEMP` puts that spelling in the text and this reads the case's own fixture back as
// the driver naming the variable — a green answer about a refusal that named nothing. The blocking
// files are numbered for that reason.
export function variablesUnnamedIn(text String) returns String
	var missing = ""

	for variable in variablesACallerCanSet() 'eachVariable'
		if text.contains(variable) 'named'
			continue
		end 'named'

		missing.append("{variable} ")
	end 'eachVariable'

	return missing.trim()
end 'variablesUnnamedIn'

// Ranked directly below the home directory on the driver's own roster. A reordering there leaves
// this naming a root the driver reaches first, and a fall-through case then passes without falling
// through.
export function rootRankedBelowHomeVariable() returns String
	#if os(Windows)
		let variable = WindowsCacheRootVariable
	#else
		let variable = HostTempVariable
	#endif

	return variable
end 'rootRankedBelowHomeVariable'

function namesACacheRoot(name String) returns bool
	if foldedVariable(name) == foldedVariable(CacheRootVariable) 'theOverride'
		return true
	end 'theOverride'

	for variable in confinableCacheVariables() 'eachVariable'
		if foldedVariable(name) == foldedVariable(variable) 'theSame'
			return true
		end 'theSame'
	end 'eachVariable'

	return false
end 'namesACacheRoot'

// A directory of the case's own for one candidate variable. Created, because a child handed a temp area
// that is not there can fail at something other than the cache.
function privateRootFor(dir FilePath, variable String) returns FilePath
	return stagingDir(dir.join("{PrivateRootPrefix}{variable}").toString())
end 'privateRootFor'

// ⭐ **A CACHE WITH A REAL BUILD IN IT, PUT THERE BY THE DRIVER.** Only the driver knows the layout it
// publishes into, so a planted file would ask whether a clear can remove what the TEST put there — which
// is not the question. A run that does not land a build stops the case rather than failing it.
//
// ⚠ **`program` NAMES THE SOURCE FILE, AND TWO NAMES ARE TWO BUILDS.** A slot is keyed on the program's
// PATH, so publishing the same text twice under one name supersedes the first build rather than adding a
// second; a case that needs more than one build in a root names a second file.
export function publishCachedBuild(dir FilePath, cacheRoot FilePath, program String = CachedProgramFileName)
	var naming = EnvMap.create()
	naming.upsert(CacheRootVariable, value: cacheRoot.toString())

	publishCachedBuildUnder(dir, naming: naming, owned: cacheRoot.join(CacheVendorDirName), program: program)
end 'publishCachedBuild'

// The same build published under the cache a HOME directory names — the only way to fill a candidate the
// override outranks, and what a clear must reach as well as the one in use.
export function publishCachedBuildInHome(dir FilePath, home FilePath)
	var naming = EnvMap.create()
	naming.upsert(HomeDirectoryVariable, value: home.toString())

	publishCachedBuildUnder(dir, naming: naming, owned: homeCacheRoot(home), program: CachedProgramFileName)
end 'publishCachedBuildInHome'

function publishCachedBuildUnder(dir FilePath, naming EnvMap, owned FilePath, program String)
	let source = dir.join(program)
	writeStagedFile(source, content: CachedProgramSource)

	let run = runWithCacheRoots([ExecuteCommandWord, source.toString()], naming: naming, workingDirectory: dir)

	if run.exitCode() != 0 'didNotRun'
		panic("CliHarness: the gate could not run - `maxon {ExecuteCommandWord}` did not compile the staged program, so there is no cached build to act on. It wrote to stdout: {run.stdout} and to stderr: {run.stderr}")
	end 'didNotRun'

	if not Directory.isDirectory(owned) 'nothingCached'
		panic("CliHarness: the gate could not run - `maxon {ExecuteCommandWord}` left nothing under {owned.toString()}, so a case about clearing the cache would be about an empty one.")
	end 'nothingCached'
end 'publishCachedBuildUnder'

// ⭐ **WHAT A REPORT SAYS IT REMOVED, read as the first run of digits in it.** A case comparing the
// clear's answer against what was on disk asks the number and never the wording around it.
export function reportedTally(report String) returns ReportedTally throws ReportReadingError
	var value = 0 as ReportedTally
	var seen = false

	for byte in report.bytes() 'eachByte'
		if byte < AsciiZero or byte > AsciiNine 'notADigit'
			if seen 'theNumberEnded'
				break
			end 'theNumberEnded'

			continue
		end 'notADigit'

		value = value * DecimalBase + ((byte - AsciiZero) as ReportedTally)
		seen = true
	end 'eachByte'

	if not seen 'statesNoCount'
		throw ReportReadingError.statesNoCount
	end 'statesNoCount'

	return value
end 'reportedTally'

// ⭐ **WHAT A REPORT SAYS ABOUT ONE DIRECTORY: the text after that directory's path, on the line naming
// it.** A report with a line per root states several counts, and a case reading the whole of it would read
// a neighbour's; a path of its own may hold digits, and reading from after it cannot pick one up.
export function reportedStateOf(report String, directory FilePath) returns String throws ReportReadingError
	let spelled = directory.toString()

	for line in report.split(ReportLineSeparator) 'eachLine'
		if not line.contains(spelled) 'namesAnother'
			continue
		end 'namesAnother'

		return try line.split(spelled).get(StateFollowsThePath) otherwise throw ReportReadingError.namesNoSuchDirectory
	end 'eachLine'

	throw ReportReadingError.namesNoSuchDirectory
end 'reportedStateOf'

function requireNoVendorAbove(dir FilePath)
	var level = dir

	while true 'eachLevel'
		let vendor = level.join(VendorDirName)

		if Directory.isDirectory(vendor) 'vendorFound'
			panic("CliHarness: the gate could not run - {vendor.toString()} sits above {dir.toString()}, which a case stages there precisely to have none of.")
		end 'vendorFound'

		// The root is the last level probed: it has no parent, so the walk stops there rather than
		// stepping past it onto a relative path the checkout would answer for.
		let above = try level.parent() otherwise break

		level = above
	end 'eachLevel'
end 'requireNoVendorAbove'

function copyTree(from FilePath, into FilePath)
	_ = stagingDir(into.toString())

	let entries = listing(from)

	for entry in entries 'eachEntry'
		let destination = into.join(entry.filename())

		if Directory.isDirectory(entry) 'aDirectory'
			copyTree(entry, into: destination)
			continue
		end 'aDirectory'

		copyFile(entry, into: destination, mode: FilePermission.normal)
	end 'eachEntry'
end 'copyTree'

function copyFile(from FilePath, into FilePath, mode FilePermission)
	rewrittenFile(into, bytes: fileBytes(from), mode: mode)
end 'copyFile'

// A case's staging directory, or a directory under it, spelled from the checkout root.
function caseRelative(caseDirName String, relative String) returns String
	let caseDir = "{StagingRootDirName}{PortablePathSeparator}{caseDirectoryName(caseDirName)}"
	return caseDir if relative.isEmpty() else "{caseDir}{PortablePathSeparator}{relative}"
end 'caseRelative'

let CaseNameWordSeparator = "-"
let CaseDirectoryWordSeparator = "_"

function caseDirectoryName(caseDirName String) returns String
	return caseDirName.replace(CaseNameWordSeparator, with: CaseDirectoryWordSeparator)
end 'caseDirectoryName'

// ⭐ **THE LABELS A LISTING SHOWS**, read off its layout: a label is indented exactly two spaces, so
// wrapped prose — which starts far to the right — is never mistaken for one. In the short list these are
// the COMMANDS; in a reference section they are that command's OPTIONS.
export function labelledWordsIn(listing String) returns StringArray
	var words = StringArray.create()

	for label in labelsIn(listing) 'eachLabel'
		words.push(firstWordOf(label))
	end 'eachLabel'

	return words
end 'labelledWordsIn'

// Each label whole — every spelling an option line gives, such as `--bail, --bail=N` — which
// ends where the gap before the description column starts.
function labelsIn(listing String) returns StringArray
	var labels = StringArray.create()

	for line in listing.split("\n") 'eachLine'
		if not line.startsWith(LabelIndent) 'notALabel'
			continue
		end 'notALabel'

		if line.startsWith(DeeperThanALabel) 'wrappedProse'
			continue
		end 'wrappedProse'

		let columns = line.trim().split(DescriptionColumnGap)
		labels.push(try columns.get(0) otherwise panic("CliHarness: a split always yields a first part"))
	end 'eachLine'

	return labels
end 'labelsIn'

// ⭐ **EVERY OPTION SPELLING A LISTING SHOWS, ONCE EACH**, cut the way a reader types them: a label's
// comma-separated alternatives each give their flag, and a flag taking a value keeps its `=` and drops the
// placeholder — `--output=<path>` gives `--output=`, `--bail, --bail=N` gives both.
export function optionSpellingsIn(listing String) returns StringArray
	var spellings = StringArray.create()

	for label in labelsIn(listing) 'eachLabel'
		if not label.startsWith(OptionPrefix) 'aCommand'
			continue
		end 'aCommand'

		for alternative in label.split(LabelAlternativeSeparator) 'eachAlternative'
			let spelling = optionSpellingOf(alternative)

			if not spellings.contains(spelling) 'unseen'
				spellings.push(spelling)
			end 'unseen'
		end 'eachAlternative'
	end 'eachLabel'

	return spellings
end 'optionSpellingsIn'

// Exported only where its outside reader is compiled, for `OptionValueSeparator`'s reason. The body is
// one text, spelled once: `optionSpellingOf` below calls it on every lane.
#if not os(Wasi)
	export function optionSpellingOf(alternative String) returns String
		return spellingOfAlternative(alternative)
	end 'optionSpellingOf'
#else
	function optionSpellingOf(alternative String) returns String
		return spellingOfAlternative(alternative)
	end 'optionSpellingOf'
#endif

function spellingOfAlternative(alternative String) returns String
	if alternative.contains(OptionValueSeparator) 'takesAValue'
		let name = try alternative.split(OptionValueSeparator).get(0) otherwise panic("CliHarness: a split of a string containing its separator has a first part")
		return "{name}{OptionValueSeparator}"
	end 'takesAValue'

	return firstWordOf(alternative)
end 'spellingOfAlternative'

// ⭐ **THE UNITS AN OPTION IS SPELLED IN, READ OUT OF FREE TEXT**: maximal runs of letters, digits, `-` and
// `_`, each carrying an `=` that directly follows it. Membership in this list is what "the text names
// `--output=`" means, so `--output-dir` and `x--output=` never count as naming it.
export function spellingsIn(text String) returns StringArray
	var spellings = StringArray.create()
	var current = ""

	for c in text 'eachCharacter'
		let spelled = c.toString()

		if Ascii.isAlphanumeric(c) or spelled == SpellingHyphen or spelled == SpellingUnderscore 'insideARun'
			current.append(spelled)
			continue
		end 'insideARun'

		if current.isEmpty() 'noRun'
			continue
		end 'noRun'

		if spelled == OptionValueSeparator 'carriesAValue'
			current.append(spelled)
		end 'carriesAValue'

		spellings.push(current)
		current = ""
	end 'eachCharacter'

	if not current.isEmpty() 'runAtTheEnd'
		spellings.push(current)
	end 'runAtTheEnd'

	return spellings
end 'spellingsIn'

export function linesOpeningIn(text String, prefix String) returns StringArray
	var lines = StringArray.create()

	for line in text.split("\n") 'eachLine'
		if line.startsWith(prefix) 'opensWithIt'
			lines.push(line.trim())
		end 'opensWithIt'
	end 'eachLine'

	return lines
end 'linesOpeningIn'

// The CLI reference document, with Windows line endings folded so a line is the same line on every host.
export function cliReferenceText() returns String
	let path = try FilePath.from(CliReferenceDocument) otherwise panic("CliHarness: the gate could not run - '{CliReferenceDocument}' is not a spellable path")
	let text = fileText(path)

	return withoutCarriageReturns(text)
end 'cliReferenceText'

// ⭐ **THE COMMANDS THE FULL REFERENCE HAS A SECTION FOR**, read off ITS layout: a section label is the
// only thing at the left margin apart from the `Usage:` line.
export function sectionedCommandsIn(reference String) returns StringArray
	var words = StringArray.create()

	for line in reference.split("\n") 'eachLine'
		if line.trim().isEmpty() 'blank'
			continue
		end 'blank'

		if line.startsWith(LabelIndent) or line.startsWith(UsageLinePrefix) 'notASectionLabel'
			continue
		end 'notASectionLabel'

		if line.trim().endsWith(HeadingSuffix) 'aHeadingOverARun'
			continue
		end 'aHeadingOverARun'

		words.push(firstWordOf(line))
	end 'eachLine'

	return words
end 'sectionedCommandsIn'

// The labels that ARE option spellings, or the ones that are not — which is what tells the short list
// apart from the reference without either being pinned to the byte. ONE selector taking the answer it
// wants, because the two questions are one question and its negation.
export function labelsWhereOptionhoodIs(words StringArray, isOption bool) returns StringArray
	var selected = StringArray.create()

	for word in words 'eachWord'
		if word.startsWith(OptionPrefix) == isOption 'wanted'
			selected.push(word)
		end 'wanted'
	end 'eachWord'

	return selected
end 'labelsWhereOptionhoodIs'

// The anchors a listing did NOT advertise, as one string — named rather than counted, because a reader
// looking at a red gate needs to know which word went missing. Empty is the pass.
export function anchorsMissingFrom(words StringArray) returns String
	var missing = ""

	for anchor in anchorCommands() 'eachAnchor'
		if not words.contains(anchor) 'absent'
			missing.append("{anchor} ")
		end 'absent'
	end 'eachAnchor'

	return missing.trim()
end 'anchorsMissingFrom'

// The words in `left` that `right` does not have, IN ORDER. Both a set difference a case asserts is
// empty and the hidden run one asserts is not, so it returns the words rather than a count or a
// rendering — `listed` is what turns it into a report.
export function wordsNotIn(left StringArray, right StringArray) returns StringArray
	var missing = StringArray.create()

	for word in left 'eachWord'
		if not right.contains(word) 'absent'
			missing.push(word)
		end 'absent'
	end 'eachWord'

	return missing
end 'wordsNotIn'

// The first `count` words, which is how a case takes the run a listing prints FIRST.
export function firstFew(words StringArray, count WordTally) returns StringArray
	var taken = StringArray.create()

	for word in words 'eachWord'
		if taken.count() >= count as ElementIndex 'enough'
			break
		end 'enough'

		taken.push(word)
	end 'eachWord'

	return taken
end 'firstFew'

// ⭐ **THE PAIRS THAT BREAK ASCENDING ORDER**, named rather than counted. Empty is the pass, and the
// listing being sorted is the one ordering rule a gate can check — see this file's header.
export function outOfOrderIn(words StringArray) returns String
	var broken = ""
	var previous = ""

	for word in words 'eachWord'
		if not previous.isEmpty() and not sortsAhead(previous, after: word) 'notAscending'
			broken.append("{previous} before {word}; ")
		end 'notAscending'

		previous = word
	end 'eachWord'

	return broken.trim()
end 'outOfOrderIn'

// Whether `before` sorts strictly ahead of `after`, byte by byte. Written out because a String is a byte
// record with NO ordering in this language (E3005) — `==` and `!=` are its only comparisons — so the
// order this corpus asserts has to be spelled somewhere, and one place is better than each case's own.
function sortsAhead(before String, after String) returns bool
	let left = bytesOfText(before)
	let right = bytesOfText(after)

	// ⚠ NOT the `min` builtin: it promotes to float, and a counted `for` needs an integer bound.
	let shared = left.count() if left.count() <= right.count() else right.count()

	for position in 0 upto shared 'eachByte'
		let leftByte = try left.get(position) otherwise panic("CliHarness: index {position} is inside the shorter of the two byte lists by the bound above")
		let rightByte = try right.get(position) otherwise panic("CliHarness: index {position} is inside the shorter of the two byte lists by the bound above")

		if leftByte != rightByte 'theyDifferHere'
			return leftByte < rightByte
		end 'theyDifferHere'
	end 'eachByte'

	// One is a prefix of the other, so the shorter sorts first; equal words are NOT ahead of each other,
	// which is what makes a duplicate in a listing an ordering failure rather than a pass.
	return left.count() < right.count()
end 'sortsAhead'

function bytesOfText(text String) returns ByteArray
	var collected = ByteArray.create()

	for one in text.bytes() 'eachByte'
		collected.push(one)
	end 'eachByte'

	return collected
end 'bytesOfText'

// The first line carrying a byte outside ASCII, or empty when there is none.
//
// ⭐⭐ **THE LISTINGS MUST BE PURE ASCII, AND THE REASON IS MEASURED.** A Maxon program writes UTF-8
// bytes straight to the handle, and NOTHING tells a Windows console which encoding that is — so a
// console left on its default code page decodes an em-dash as three Latin-1 letters and the reader gets
// mojibake in the one text this binary prints to explain itself. The reference is what somebody reads
// when they do not yet know anything, on whatever terminal they happen to have, so it stays inside the
// characters every code page agrees about.
//
// ⚠ **THIS IS A RULE ABOUT THE LISTING, NOT A FIX FOR THE ENCODING.** Diagnostics and `maxon test`'s
// report still carry non-ASCII and still land wrong on such a console; that is the driver's own
// stream-encoding defect and it is not this corpus's to assert.
export function nonAsciiLineIn(text String) returns String
	for line in text.split("\n") 'eachLine'
		for one in line.bytes() 'eachByte'
			if one > LastAsciiByte 'outsideAscii'
				return line
			end 'outsideAscii'
		end 'eachByte'
	end 'eachLine'

	return ""
end 'nonAsciiLineIn'

// The first whitespace-delimited word of a line, which is a label's command word or option spelling.
function firstWordOf(line String) returns String
	for part in line.trim().split(" ") 'eachPart'
		if not part.isEmpty() 'aWord'
			return part
		end 'aWord'
	end 'eachPart'

	panic("CliHarness: '{line}' was taken for a label but holds no word — the layout this corpus reads the roster by has changed, and every census here is now reading nothing.")
end 'firstWordOf'

export let CompilerDebugLogFlag = "--log=compiler:debug"
export let TargetOptionPrefix = "--target="
export let LibraryCacheDirName = "library"
export let TrivialProgramSource = "function main() returns ExitCode\n\treturn 42\nend 'main'\n"
let ColdImageName = "cold-image"
let ColdSidecarName = "cold-sidecar"

let LibraryCacheLinePrefix = "[CMP] DEBUG: library cache — "
let LibraryCacheFieldSeparator = ", "
let LibraryCacheBaselineLabel = "baseline "
let LibraryCacheCountSeparator = " "
let LibraryCacheLineShape = "baseline <loaded|built|unused>, <n> loaded, <n> written, <n> rejected, <n> library file(s) swept, <n> library file(s) parsed"

export enum LibraryBaseline
	loaded
	built
	unused
end 'LibraryBaseline'

enum LibraryCacheField
	baseline
	loaded
	written
	rejected
	swept
	parsed
end 'LibraryCacheField'

export type LibraryCacheReport
	export let baseline as LibraryBaseline
	export let loaded as ReportedTally
	export let written as ReportedTally
	export let rejected as ReportedTally
	export let swept as ReportedTally
	export let parsed as ReportedTally
	export let line as String

	static function create(baseline LibraryBaseline, loaded ReportedTally, written ReportedTally, rejected ReportedTally, swept ReportedTally, parsed ReportedTally, line String) returns LibraryCacheReport
		return Self{baseline: baseline, loaded: loaded, written: written, rejected: rejected, swept: swept, parsed: parsed, line: line}
	end 'create'
end 'LibraryCacheReport'

export function stageProgram(dir FilePath, name String, source String)
	_ = stagingDir(dir.join(name).toString())
	writeStagedFile(stagedProgramSource(dir, name: name), content: source)
end 'stageProgram'

export function stagedProgramSource(dir FilePath, name String) returns FilePath
	return dir.join(name).join(StagedProgramFileName)
end 'stagedProgramSource'

export function stageSettledProgram(dir FilePath, name String, source String)
	stageProgram(dir, name: name, source: source)
	waitPastTheModificationOf(stagedProgramSource(dir, name: name), probeIn: dir)
end 'stageSettledProgram'

export function libraryCacheDirIn(dir FilePath) returns FilePath
	return cacheRootIn(dir).join(CacheVendorDirName).join(LibraryCacheDirName)
end 'libraryCacheDirIn'

export function runLibraryCacheBuild(dir FilePath, program String, output String, options StringArray) returns CollectedOutput
	var logged = StringArray.create()
	logged.push(CompilerDebugLogFlag)

	for option in options 'eachOption'
		logged.push(option)
	end 'eachOption'

	return runRecordedBuild(dir, program: program, output: output, options: logged)
end 'runLibraryCacheBuild'

export let RebuildFlag = "--rebuild"
export let FirstBuildReason = "no record of a previous build"
export let ModifiedInputReason = "was modified at or after the last compile started"
export let NoBuildRecordReason = "no build record can be kept"

let CompiledLinePrefix = "Compiled -> "
let UpToDateLinePrefix = "Up to date -> "
let CompilingReasonLinePrefix = "[CMP] INFO: compiling "
let WroteCodeWording = "bytes of code to"

typealias ClockPollTally = int(0 to 100)

let ClockProbeFileName = "filesystem-clock-probe"
let ClockProbeContent = "written to read the filesystem's clock\n"
let ClockPollMs = 100 as Milliseconds
let ClockPollLimit = 100 as ClockPollTally

export let SettledProgramDirName = "app"

export function runRecordedBuild(dir FilePath, program String, output String, options StringArray, binary FilePath = testedCompilerPath()) returns CollectedOutput
	var arguments = StringArray.create()
	arguments.push(BuildCommandWord)
	arguments.push(program)
	arguments.push("{OutputOptionPrefix}{dir.join(output).toString()}")

	for option in options 'eachOption'
		arguments.push(option)
	end 'eachOption'

	return runWithCacheRoot(arguments, cacheRoot: cacheRootIn(dir), workingDirectory: dir, binary: binary)
end 'runRecordedBuild'

export function requireBuilt(build CollectedOutput, which String) throws TestFailure
	try Expect.equal(build.exitCode(), expected: 0, message: "{which} did not succeed. It wrote to stdout: {build.stdout} and to stderr: {build.stderr}")
end 'requireBuilt'

export function requireCompiled(build CollectedOutput, reason String, which String) throws TestFailure
	let said = "It wrote to stdout: {build.stdout} and to stderr: {build.stderr}"

	try requireBuilt(build, which: which)
	try Expect.contains(build.stdout, needle: CompiledLinePrefix, message: "{which} did not say `{CompiledLinePrefix}<path>`, and it was meant to compile. {said}")
	try Expect.isFalse(build.stdout.contains(UpToDateLinePrefix), message: "{which} said `{UpToDateLinePrefix}<path>`, and it was meant to compile. {said}")

	let compiling = linesOpeningIn(build.stderr, prefix: CompilingReasonLinePrefix)
	try Expect.equal(compiling.count(), expected: 1, message: "{which} logged {compiling.count()} line(s) opening `{CompilingReasonLinePrefix}`, where every build that compiles logs exactly one, naming why. {said}")

	let line = try compiling.get(0) otherwise panic("CliHarness: a list holding one line has a first line")
	try Expect.contains(line, needle: reason, message: "{which} compiled for another reason than `{reason}`. It logged: {line}")
	try Expect.contains(build.stderr, needle: WroteCodeWording, message: "{which} logged no `{WroteCodeWording}` line, so nothing says it wrote what it compiled. {said}")
end 'requireCompiled'

export function requireUpToDate(build CollectedOutput, which String) throws TestFailure
	let said = "It wrote to stdout: {build.stdout} and to stderr: {build.stderr}"

	try requireBuilt(build, which: which)
	try Expect.contains(build.stdout, needle: UpToDateLinePrefix, message: "{which} did not say `{UpToDateLinePrefix}<path>`, and nothing it reads had changed since the last compile. {said}")
	try Expect.isFalse(build.stdout.contains(CompiledLinePrefix), message: "{which} said `{CompiledLinePrefix}<path>`, and nothing it reads had changed since the last compile. {said}")
	try Expect.isFalse(build.stderr.contains(WroteCodeWording), message: "{which} logged a `{WroteCodeWording}` line, so it compiled a program that was up to date. {said}")
	try Expect.isFalse(build.stderr.contains(CompilingReasonLinePrefix), message: "{which} logged a reason to compile a program that was up to date. {said}")
end 'requireUpToDate'

let BuildRecordDirName = "build"
let BuildRecordExtension = ".mxbr"

export function soleBuildRecordIn(dir FilePath) returns FilePath throws TestFailure
	var records = FilePathArray.create()

	for file in filesUnder(cacheRootIn(dir).join(CacheVendorDirName).join(BuildRecordDirName)) 'eachCachedFile'
		if file.filename().endsWith(BuildRecordExtension) 'aRecord'
			records.push(file)
		end 'aRecord'
	end 'eachCachedFile'

	try Expect.equal(records.count(), expected: 1, message: "the first build under an empty cache root left {records.count()} build records, where one output has one.")

	return try records.get(0) otherwise panic("CliHarness: a list holding one record has a first")
end 'soleBuildRecordIn'

export let NothingRanExitCode = 2
export let OutputLockBusyWording = "holds its build lock"
export let OutputLockHolderRunningWording = "is running"
export let OutputLockEndedHolderWording = "has ended without releasing it"

let OutputLockSuffix = ".lock"
let BuildLocksDirName = "locks"
let OutputLockToken = "cli-output-lock"

export function buildLocksDirIn(dir FilePath) returns FilePath
	return cacheRootIn(dir).join(CacheVendorDirName).join(BuildRecordDirName).join(BuildLocksDirName)
end 'buildLocksDirIn'

export function outputLockOf(record FilePath) returns FilePath
	let directory = try record.parent() otherwise panic("CliHarness: the gate could not run - {record.toString()} has no directory the build records sit in.")
	let builds = try directory.parent() otherwise panic("CliHarness: the gate could not run - {directory.toString()} has no directory the build locks sit beside it in.")

	return builds.join(BuildLocksDirName).join("{record.stem()}{OutputLockSuffix}")
end 'outputLockOf'

export function plantLockOfALiveHolder(lock FilePath, caseLabel String)
	plantOutputLock(lock, content: lockRecordOf(Process.id(), host: thisHostIdentityText(caseLabel)))
end 'plantLockOfALiveHolder'

export function plantLockOfAnEndedHolder(lock FilePath, caseLabel String)
	plantOutputLock(lock, content: lockRecordOf(endedVersionRunProcessId(), host: thisHostIdentityText(caseLabel)))
end 'plantLockOfAnEndedHolder'

export function removePlantedLock(lock FilePath)
	try File.delete(lock) otherwise panic("CliHarness: the gate could not run - could not delete {lock.toString()}, which a case planted.")
end 'removePlantedLock'

function plantOutputLock(lock FilePath, content String)
	let locks = try lock.parent() otherwise panic("CliHarness: the gate could not run - {lock.toString()} has no directory.")

	_ = Directory.create(locks)

	writeStagedFile(lock, content: content)
end 'plantOutputLock'

function lockRecordOf(pid Pid, host String) returns String
	return "pid={pid}\ntoken={OutputLockToken}\nhost={host}\n"
end 'lockRecordOf'

export function endedVersionRunProcessId() returns Pid
	return spawnCompiler([VersionCommandWord]).pid
end 'endedVersionRunProcessId'

export function requireASecondBuildIsUpToDate(dir FilePath, output String, options StringArray) throws TestFailure
	stageSettledProgram(dir, name: SettledProgramDirName, source: TrivialProgramSource)

	try requireCompiled(runRecordedBuild(dir, program: SettledProgramDirName, output: output, options: options), reason: FirstBuildReason, which: "the first build under an empty cache root")

	let written = dir.join(output)
	waitPastTheModificationOf(written, probeIn: dir)
	let before = fileInfoOf(written)

	try requireUpToDate(runRecordedBuild(dir, program: SettledProgramDirName, output: output, options: options), which: "a second build of the unchanged program")

	let after = fileInfoOf(written)
	try Expect.equal(after.size, expected: before.size, message: "a build that reported the program up to date changed the size of {written.toString()}.")
	try Expect.equal(after.modifiedTime, expected: before.modifiedTime, message: "a build that reported the program up to date rewrote {written.toString()}.")
end 'requireASecondBuildIsUpToDate'

function fileInfoOf(path FilePath) returns FileInfo
	return try File.info(path) otherwise panic("CliHarness: the gate could not run - could not read the metadata of {path.toString()}.")
end 'fileInfoOf'

export function waitPastTheModificationOf(file FilePath, probeIn FilePath)
	let modified = fileInfoOf(file).modifiedTime
	let probe = probeIn.join(ClockProbeFileName)

	for _ in 0 upto ClockPollLimit 'eachPoll'
		writeStagedFile(probe, content: ClockProbeContent)

		if fileInfoOf(probe).modifiedTime > modified 'passed'
			try File.delete(probe) otherwise panic("CliHarness: the gate could not run - could not delete {probe.toString()}.")
			return
		end 'passed'

		sleep(ClockPollMs)
	end 'eachPoll'

	panic("CliHarness: the gate could not run - the filesystem clock under {probeIn.toString()} did not pass the modification time of {file.toString()} within {ClockPollLimit} polls {ClockPollMs} ms apart.")
end 'waitPastTheModificationOf'

export function requireLibraryCacheBuild(dir FilePath, program String, output String, which String) returns CollectedOutput throws TestFailure
	let built = runLibraryCacheBuild(dir, program: program, output: output, options: StringArray.create())
	try Expect.equal(built.exitCode(), expected: 0, message: "{which} did not succeed. It wrote to stdout: {built.stdout} and to stderr: {built.stderr}")

	return built
end 'requireLibraryCacheBuild'

export type ColdAndWarmBuilds
	export let cold as CollectedOutput
	export let warm as LibraryCacheReport

	static function create(cold CollectedOutput, warm LibraryCacheReport) returns ColdAndWarmBuilds
		return Self{cold: cold, warm: warm}
	end 'create'
end 'ColdAndWarmBuilds'

export function requireWarmBuildMatchesCold(dir FilePath, program String, output String, subject String) returns ColdAndWarmBuilds throws TestFailure
	let image = dir.join("{output}{executableSuffix()}")
	let sidecar = dir.join("{output}{executableSuffix()}{SidecarSuffix}")

	let cold = try requireLibraryCacheBuild(dir, program: program, output: output, which: "the cold build of {subject}")
	let coldImage = retainedAside(image, aside: dir.join(ColdImageName))
	let coldSidecar = retainedAside(sidecar, aside: dir.join(ColdSidecarName))

	let warm = try libraryCacheReportOf(runLibraryCacheBuild(dir, program: program, output: output, options: StringArray.create()), which: "the warm build of {subject}")
	try Expect.equal(warm.baseline, expected: LibraryBaseline.loaded, message: "the warm build of {subject} did not load the library baseline the cold build wrote, so comparing its bytes with the cold build's compares two cold builds. It wrote: {warm.line}")
	try Expect.greaterThan(warm.loaded, than: 0, message: "the warm build of {subject} loaded no library cache entry, so comparing its bytes with the cold build's compares two cold builds. It wrote: {warm.line}")

	try requireSameBytes(coldImage, second: image, why: "the warm build's executable of {subject} is not the cold build's, so loading the library from the cache changed the program.")
	try requireSameBytes(coldSidecar, second: sidecar, why: "the warm build's debug sidecar of {subject} is not the cold build's, so loading the library from the cache changed what the debugger is told.")

	return ColdAndWarmBuilds.create(cold, warm: warm)
end 'requireWarmBuildMatchesCold'

export function libraryCacheReportOf(build CollectedOutput, which String) returns LibraryCacheReport throws TestFailure
	try Expect.equal(build.exitCode(), expected: 0, message: "{which} did not succeed. It wrote to stdout: {build.stdout} and to stderr: {build.stderr}")

	return try libraryCacheReportIn(build, which: which)
end 'libraryCacheReportOf'

export function libraryCacheReportOfARefusedBuild(build CollectedOutput, which String) returns LibraryCacheReport throws TestFailure
	try Expect.notEqual(build.exitCode(), expected: 0, message: "{which} succeeded, and it was meant to be refused. It wrote to stdout: {build.stdout} and to stderr: {build.stderr}")

	return try libraryCacheReportIn(build, which: which)
end 'libraryCacheReportOfARefusedBuild'

function libraryCacheReportIn(build CollectedOutput, which String) returns LibraryCacheReport throws TestFailure
	let said = "It wrote to stdout: {build.stdout} and to stderr: {build.stderr}"
	let lines = linesOpeningIn(build.stderr, prefix: LibraryCacheLinePrefix)
	try Expect.equal(lines.count(), expected: 1, message: "{which} printed {lines.count()} line(s) opening `{LibraryCacheLinePrefix}` under `{CompilerDebugLogFlag}`, where every compile reports exactly once, after its front end, whether it loaded the library from the cache, built it or could not use it. {said}")

	let line = try lines.get(0) otherwise panic("CliHarness: a list holding one line has a first line")
	let rest = try line.split(LibraryCacheLinePrefix).get(1) otherwise panic("CliHarness: a line opening with a prefix splits after it")
	let fields = rest.split(LibraryCacheFieldSeparator)
	try Expect.equal(fields.count(), expected: LibraryCacheField.allCases.count(), message: "{which}'s library cache line does not read `{LibraryCacheLineShape}`. It wrote: {line}")

	let baselineText = libraryCacheFieldText(fields, field: LibraryCacheField.baseline)
	let baselineWord = try baselineText.split(LibraryCacheBaselineLabel).get(1) otherwise ""

	if let baseline = try LibraryBaseline.fromName(baselineWord) 'aBaseline'
		if baselineText == "{LibraryCacheBaselineLabel}{baselineWord}" 'labelled'
			let loaded = try libraryCacheCount(fields, field: LibraryCacheField.loaded, line: line, which: which)
			let written = try libraryCacheCount(fields, field: LibraryCacheField.written, line: line, which: which)
			let rejected = try libraryCacheCount(fields, field: LibraryCacheField.rejected, line: line, which: which)
			let swept = try libraryCacheCount(fields, field: LibraryCacheField.swept, line: line, which: which)
			let parsed = try libraryCacheCount(fields, field: LibraryCacheField.parsed, line: line, which: which)

			return LibraryCacheReport.create(baseline, loaded: loaded, written: written, rejected: rejected, swept: swept, parsed: parsed, line: line)
		end 'labelled'
	end 'aBaseline'

	try Expect.fail("{which}'s library cache line names no baseline state as `{LibraryCacheLineShape}` does. It wrote: {line}")
	panic("CliHarness: Expect.fail returned")
end 'libraryCacheReportIn'

function libraryCacheFieldText(fields StringArray, field LibraryCacheField) returns String
	return try fields.get(field.ordinal) otherwise panic("CliHarness: a library cache line already counted to hold every field has none at {field.ordinal}")
end 'libraryCacheFieldText'

function libraryCacheCount(fields StringArray, field LibraryCacheField, line String, which String) returns ReportedTally throws TestFailure
	let text = libraryCacheFieldText(fields, field: field)
	let word = try text.split(LibraryCacheCountSeparator).get(0) otherwise panic("CliHarness: a split always yields a first part")

	if let count = try int.fromString(word) 'aNumber'
		if text == "{count}{LibraryCacheCountSeparator}{libraryCacheLabelOf(field)}" 'labelled'
			return count
		end 'labelled'
	end 'aNumber'

	try Expect.fail("{which}'s library cache line does not state `<n> {libraryCacheLabelOf(field)}` where `{LibraryCacheLineShape}` does. It wrote: {line}")
	panic("CliHarness: Expect.fail returned")
end 'libraryCacheCount'

function libraryCacheLabelOf(field LibraryCacheField) returns String
	return match field 'label'
		loaded gives "loaded"
		written gives "written"
		rejected gives "rejected"
		swept gives "library file(s) swept"
		parsed gives "library file(s) parsed"
		default panic("CliHarness: the baseline field states a word, not a count")
	end 'label'
end 'libraryCacheLabelOf'

export function requireSameBytes(first FilePath, second FilePath, why String) throws TestFailure
	let firstBytes = fileBytes(first)
	let secondBytes = fileBytes(second)

	try Expect.notEqual(firstBytes.count(), expected: 0, message: "positive control: {first.toString()} is empty, and two empty files agree about nothing.")
	try Expect.isTrue(firstBytes.equals(secondBytes), message: "{why} {first.toString()} holds {firstBytes.count()} bytes and {second.toString()} {secondBytes.count()}, and they differ.")
end 'requireSameBytes'

let ViewsEntryPrefix = "views-"
export let AnotherSchemaReason = "the entry was written under another codec schema"
export let OutOfRangeReason = "a number in the entry is outside the range it is read into"
export let ForgedProducerMask = 99
let EntryWordByteCount = 8
let EntryFingerprintOffset = 4
let EntryChecksumOffset = 12
let EntryPayloadOffset = 20
let EntryRowKeyCount = 3
let ViewFlagByteCount = 1
let VarintContinuationBit = 0x80
let VarintPayloadMask = 0x7F
let VarintPayloadBits = 7
let VarintMostBytes = 10
let EntryByteMask = 0xFF
let EntryByteBits = 8

typealias EntryNumber = int(0 to u64.max)
typealias EntryLengthArray = Array with EntryNumber

type EntryNumberRead
	export let value as EntryNumber
	export let next as ElementIndex

	static function create(value EntryNumber, next ElementIndex) returns EntryNumberRead
		return Self{value: value, next: next}
	end 'create'
end 'EntryNumberRead'

export function viewsEntryIn(dir FilePath) returns FilePath
	for entry in filesUnder(libraryCacheDirIn(dir)) 'eachEntry'
		if entry.filename().startsWith(ViewsEntryPrefix) 'theViewsEntry'
			return entry
		end 'theViewsEntry'
	end 'eachEntry'

	panic("CliHarness: the gate could not run - the build wrote no `{ViewsEntryPrefix}` entry under {libraryCacheDirIn(dir).toString()}.")
end 'viewsEntryIn'

function entryNumberAt(image ByteArray, start ElementIndex) returns EntryNumberRead
	var value = 0 as EntryNumber
	var at = start
	var shift = 0 as Count

	for _ in 0 upto VarintMostBytes 'eachByte'
		let byte = try image.get(at) otherwise panic("CliHarness: the gate could not run - a number in the entry at {start} runs off its end.")
		value = value or (((byte and VarintPayloadMask) as EntryNumber) shl shift)
		at = at + 1
		shift = shift + VarintPayloadBits

		if (byte and VarintContinuationBit) == 0 'last'
			return EntryNumberRead.create(value, next: at)
		end 'last'
	end 'eachByte'

	panic("CliHarness: the gate could not run - a number in the entry at {start} does not end within {VarintMostBytes} bytes.")
end 'entryNumberAt'

// Walks the field order `encodedViewSection` writes; a field added ahead of the mask there moves it.
function producerMaskOffsetIn(image ByteArray, section ElementIndex) returns ElementIndex
	let afterDeclaredNames = byteArrayArrayEndsAt(image, start: section)
	let afterReservedSpellings = byteArrayArrayEndsAt(image, start: afterDeclaredNames)

	return afterReservedSpellings + ViewFlagByteCount
end 'producerMaskOffsetIn'

function byteArrayArrayEndsAt(image ByteArray, start ElementIndex) returns ElementIndex
	let elements = entryNumberAt(image, start: start)
	var at = elements.next

	for _ in 0 upto elements.value 'eachElement'
		let element = entryNumberAt(image, start: at)
		at = element.next + (element.value as ElementIndex)
	end 'eachElement'

	return at
end 'byteArrayArrayEndsAt'

export function entryWithEveryProducerMaskForged(image ByteArray) returns ByteArray
	let rowCount = entryNumberAt(image, start: EntryPayloadOffset)
	var at = rowCount.next
	var lengths = EntryLengthArray.create()

	for _ in 0 upto rowCount.value 'eachRow'
		for _ in 0 upto EntryRowKeyCount 'eachRowKey'
			at = entryNumberAt(image, start: at).next
		end 'eachRowKey'

		let length = entryNumberAt(image, start: at)
		at = length.next
		lengths.push(length.value)
	end 'eachRow'

	var forged = image.clone()

	for length in lengths 'eachSection'
		let offset = producerMaskOffsetIn(image, section: at)
		try forged.set(offset, value: ForgedProducerMask) otherwise panic("CliHarness: the gate could not run - byte {offset} lies outside the {image.count()}-byte entry.")
		at = at + (length as ElementIndex)
	end 'eachSection'

	return forged
end 'entryWithEveryProducerMaskForged'

export function entryWithChecksumOfItsPayload(image ByteArray) returns ByteArray
	let payload = try image.slice(EntryPayloadOffset, endIndex: image.count()) otherwise panic("CliHarness: the gate could not run - the entry is shorter than its header.")
	let checksum = Hasher.combined(Hasher.combined(Hasher.empty(), bytes: payload), value: payload.count() as HashDigest)
	var sealed = image.clone()

	for position in 0 upto EntryWordByteCount 'eachByte'
		try sealed.set(EntryChecksumOffset + position, value: ((checksum shr (position * EntryByteBits)) and EntryByteMask) as Byte) otherwise panic("CliHarness: the gate could not run - the entry has no checksum byte {position}.")
	end 'eachByte'

	return sealed
end 'entryWithChecksumOfItsPayload'

export function entryWithAnotherSchema(image ByteArray) returns ByteArray
	let first = try image.get(EntryFingerprintOffset) otherwise panic("CliHarness: the gate could not run - the entry is shorter than its header.")
	var altered = image.clone()
	try altered.set(EntryFingerprintOffset, value: ((first + 1) and EntryByteMask) as Byte) otherwise panic("CliHarness: the gate could not run - the entry is shorter than its header.")

	return altered
end 'entryWithAnotherSchema'

export function rewrittenFile(path FilePath, bytes ByteArray, mode FilePermission = FilePermission.normal)
	try File.writeBinary(path, content: bytes, mode: mode) otherwise panic("CliHarness: the gate could not run - could not write {path.toString()}.")
end 'rewrittenFile'

export typealias MetricsField = int(0 to 11)

let MetricsFileSuffix = "-metrics.tsv"
export let MetricsOptionPrefix = "--metrics="
let MetricsRowSeparator = "\n"
let MetricsFieldSeparator = "\t"
let MetricsCommentPrefix = "#"
let MetricsFieldCount = 12
let MetricsKindField = 0
let MetricsNameField = 1

export let MetricsAllocsField = 3 as MetricsField
let MetricsBytesField = 5
export let MetricsRegAllocKind = "regalloc"
let MetricsCodeKind = "code"
let MetricsUnnamedRow = "-"

export function stagedProgramMetrics(dir FilePath, name String, source String, described String) returns String throws TestFailure
	stageProgram(dir, name: name, source: source)

	let metricsFileName = "{name}{MetricsFileSuffix}"
	let built = spawnCompiler([BuildCommandWord, name, "{MetricsOptionPrefix}{metricsFileName}"], staged: dir)

	try Expect.equal(built.exitCode(), expected: 0, message: "{described} did not build, so it was never measured. It wrote to stderr: {built.stderr}")

	return fileText(dir.join(metricsFileName))
end 'stagedProgramMetrics'

export function metricsCell(table String, kind String, name String, field MetricsField) returns ReportedTally
	for row in table.split(MetricsRowSeparator) 'eachRow'
		let line = row.trimEnd()

		if line.isEmpty() or line.startsWith(MetricsCommentPrefix) 'notARow'
			continue
		end 'notARow'

		let fields = line.split(MetricsFieldSeparator)

		if fields.count() != MetricsFieldCount 'malformed'
			panic("CliHarness: the gate could not run - a metrics row carries {fields.count()} fields rather than {MetricsFieldCount}: {line}")
		end 'malformed'

		let rowKind = try fields.get(MetricsKindField as ElementIndex) otherwise panic("CliHarness: kind field OOB after the field count was checked")
		let rowName = try fields.get(MetricsNameField as ElementIndex) otherwise panic("CliHarness: name field OOB after the field count was checked")

		if rowKind != kind or rowName != name 'namesAnother'
			continue
		end 'namesAnother'

		let cell = try fields.get(field as ElementIndex) otherwise panic("CliHarness: field {field} OOB after the field count was checked")
		return try reportedTally(cell) otherwise panic("CliHarness: the gate could not run - field {field} of the `{kind}` row named `{name}` states no count: {line}")
	end 'eachRow'

	panic("CliHarness: the gate could not run - the metrics table carries no `{kind}` row named `{name}`, so it was never measured. The table was: {table}")
end 'metricsCell'

export enum ErrorPathExit
	propagatingTry
	throwStatement
	earlyReturn
end 'ErrorPathExit'

export enum SelfContainedErrorPath
	handedOffReturn
	freshReturn
	reassignedOwner
	routedThrow
	routedBoxThrow
end 'SelfContainedErrorPath'

union ErrorPathFixture
	guarded(exitKind ErrorPathExit)
	selfContained(path SelfContainedErrorPath)
end 'ErrorPathFixture'

typealias BindingTally = int(0 to 64)

let ErrorPathCaseDirNamePrefix = "error-path-drops-"
let ErrorPathAppDirNamePrefix = "bindings-"

let SmallBindings = 16 as BindingTally
let MediumBindings = 32 as BindingTally
let LargeBindings = 64 as BindingTally

// A linear term doubles the growth from one doubling to the next and a quadratic one quadruples
// it; the bound sits between them.
let LinearGrowthNumerator = 5
let LinearGrowthDenominator = 2

let ErrorPathFixturePrelude = "typealias Word = int(0 to u32.max)\n\n"
let RefusalDeclaration = "enum Refusal implements Error\n\trefused\nend 'Refusal'\n\n"
let BoxedFailureDeclaration = "union Failure implements Error\n\tdetail(message String)\nend 'Failure'\n\n"
let ThrowingMakeDeclaration = "function make(seed Word, index Word) returns String throws Refusal\n\tif seed == index 'refuse'\n\t\tthrow Refusal.refused\n\tend 'refuse'\n\n\treturn \"\{seed\}-\{index\}\"\nend 'make'\n\n"
let PlainMakeDeclaration = "function make(seed Word, index Word) returns String\n\treturn \"\{seed\}-\{index\}\"\nend 'make'\n\n"
let ThrowingWorkOpening = "function work(seed Word) returns Word throws Refusal\n"
let PlainWorkOpening = "function work(seed Word) returns Word\n"
let RefusalThrow = "throw Refusal.refused"
let TotalOpening = "\n\tvar total = seed\n"
let WorkClosing = "\n\treturn total\nend 'work'\n\n"
let ErrorPathMainOpening = "function main() returns ExitCode\n\tlet spelled = try Process.environmentVariable(\"PATH\") otherwise \"\"\n\tlet seed = (spelled.byteLength() and 0xFFFF) as Word\n"
let ThrowingWorkCall = "\tlet answer = try work(seed) otherwise 0\n"
let PlainWorkCall = "\tlet answer = work(seed)\n"
let ErrorPathMainClosing = "\n\treturn 0 if answer > 0 else 1\nend 'main'\n"

export function requireErrorPathDropsGrowLinearly(exitKind ErrorPathExit) throws TestFailure
	try requireFixtureDropsGrowLinearly(ErrorPathFixture.guarded(exitKind))
end 'requireErrorPathDropsGrowLinearly'

export function requireSelfContainedDropsGrowLinearly(path SelfContainedErrorPath) throws TestFailure
	try requireFixtureDropsGrowLinearly(ErrorPathFixture.selfContained(path))
end 'requireSelfContainedDropsGrowLinearly'

function requireFixtureDropsGrowLinearly(fixture ErrorPathFixture) throws TestFailure
	try requireHeldOutsideCheckout("{ErrorPathCaseDirNamePrefix}{errorPathFixtureName(fixture)}", check: ErrorPathDropsGrowLinearly.create(fixture))
end 'requireFixtureDropsGrowLinearly'

function errorPathFixtureName(fixture ErrorPathFixture) returns String
	return match fixture 'which'
		guarded(exitKind) gives exitKind.name
		selfContained(path) gives path.name
	end 'which'
end 'errorPathFixtureName'

function errorPathFixtureOpening(exitKind ErrorPathExit) returns String
	return match exitKind 'opening'
		propagatingTry gives "{ErrorPathFixturePrelude}{RefusalDeclaration}{ThrowingMakeDeclaration}{ThrowingWorkOpening}"
		throwStatement gives "{ErrorPathFixturePrelude}{RefusalDeclaration}{PlainMakeDeclaration}{ThrowingWorkOpening}"
		earlyReturn gives "{ErrorPathFixturePrelude}{PlainMakeDeclaration}{PlainWorkOpening}"
	end 'opening'
end 'errorPathFixtureOpening'

function errorPathBindingLines(exitKind ErrorPathExit, index BindingTally) returns String
	return match exitKind 'binding'
		propagatingTry gives "\tlet s{index} = try make(seed, index: {index})\n"
		throwStatement gives guardedBindingLines(index, exitStatement: RefusalThrow)
		earlyReturn gives guardedBindingLines(index, exitStatement: "return {index}")
	end 'binding'
end 'errorPathBindingLines'

function guardedBindingLines(index BindingTally, exitStatement String) returns String
	return "\tlet s{index} = make(seed, index: {index})\n\n\tif seed == {index} 'exit{index}'\n\t\t{exitStatement}\n\tend 'exit{index}'\n\n"
end 'guardedBindingLines'

function errorPathWorkCall(exitKind ErrorPathExit) returns String
	return match exitKind 'call'
		propagatingTry or
		throwStatement gives ThrowingWorkCall
		earlyReturn gives PlainWorkCall
	end 'call'
end 'errorPathWorkCall'

function guardedExitDescription(exitKind ErrorPathExit) returns String
	return match exitKind 'description'
		propagatingTry gives "a propagating `try`"
		throwStatement gives "a `throw`"
		earlyReturn gives "an early `return`"
	end 'description'
end 'guardedExitDescription'

function selfContainedDescription(path SelfContainedErrorPath) returns String
	return match path 'description'
		handedOffReturn gives "a `return` of one of them while the others are live"
		freshReturn gives "a `return` of a fresh value"
		reassignedOwner gives "a `return`, with a low owned `var` reassigned between the exits"
		routedThrow gives "a throwing call routed to one `try` block handler"
		routedBoxThrow gives "a `throw` of one bound boxed error from a `try` block"
	end 'description'
end 'selfContainedDescription'

function errorPathExitDescription(fixture ErrorPathFixture) returns String
	return match fixture 'which'
		guarded(exitKind) gives guardedExitDescription(exitKind)
		selfContained(path) gives selfContainedDescription(path)
	end 'which'
end 'errorPathExitDescription'

function appendLets(out String, bindings BindingTally, indent String)
	for index in 0 upto bindings 'eachBinding'
		out.append("{indent}let s{index} = make(seed, index: {index})\n")
	end 'eachBinding'
end 'appendLets'

function appendUses(out String, bindings BindingTally, indent String)
	for index in 0 upto bindings 'eachUse'
		out.append("{indent}total = (total + (s{index}.byteLength() as Word)) and 0xFFFF\n")
	end 'eachUse'
end 'appendUses'

function guardedFixtureSource(exitKind ErrorPathExit, bindings BindingTally) returns String
	var out = errorPathFixtureOpening(exitKind)

	for index in 0 upto bindings 'eachBinding'
		out.append(errorPathBindingLines(exitKind, index: index))
	end 'eachBinding'

	out.append(TotalOpening)
	appendUses(out, bindings: bindings, indent: "\t")
	out.append(WorkClosing)
	out.append(ErrorPathMainOpening)
	out.append(errorPathWorkCall(exitKind))
	out.append(ErrorPathMainClosing)
	return out
end 'guardedFixtureSource'

function stringAnswerMainClosing() returns String
	return "\n\treturn 0 if answer.byteLength() > 0 else 1\nend 'main'\n"
end 'stringAnswerMainClosing'

function handedOffReturnFixtureSource(bindings BindingTally) returns String
	var out = "{ErrorPathFixturePrelude}{PlainMakeDeclaration}function work(seed Word) returns String\n"
	appendLets(out, bindings: bindings, indent: "\t")
	out.append("\n")

	for index in 0 upto bindings 'eachReturn'
		out.append("\tif seed == {index} 'exit{index}'\n\t\treturn s{index}\n\tend 'exit{index}'\n\n")
	end 'eachReturn'

	out.append("\treturn \"\{seed\}\"\nend 'work'\n\n")
	out.append(ErrorPathMainOpening)
	out.append(PlainWorkCall)
	out.append(stringAnswerMainClosing())
	return out
end 'handedOffReturnFixtureSource'

function freshReturnFixtureSource(bindings BindingTally) returns String
	var out = "{ErrorPathFixturePrelude}{PlainMakeDeclaration}function work(seed Word) returns String\n"

	for index in 0 upto bindings 'eachBinding'
		out.append("\tlet s{index} = make(seed, index: {index})\n\n\tif seed == {index} 'exit{index}'\n\t\treturn make(seed, index: 1000)\n\tend 'exit{index}'\n\n")
	end 'eachBinding'

	out.append("\tvar total = seed\n")
	appendUses(out, bindings: bindings, indent: "\t")
	out.append("\n\treturn \"\{total\}\"\nend 'work'\n\n")
	out.append(ErrorPathMainOpening)
	out.append(PlainWorkCall)
	out.append(stringAnswerMainClosing())
	return out
end 'freshReturnFixtureSource'

function reassignedOwnerFixtureSource(bindings BindingTally) returns String
	var out = "{ErrorPathFixturePrelude}{PlainMakeDeclaration}{PlainWorkOpening}\tvar low = make(seed, index: 0)\n\n"

	for index in 0 upto bindings 'eachBinding'
		out.append("\tlet s{index} = make(seed, index: {index})\n\tlow = make(seed, index: 1000)\n\n\tif seed == {index} 'exit{index}'\n\t\treturn {index}\n\tend 'exit{index}'\n\n")
	end 'eachBinding'

	out.append("\tvar total = seed + (low.byteLength() as Word)\n")
	appendUses(out, bindings: bindings, indent: "\t")
	out.append(WorkClosing)
	out.append(ErrorPathMainOpening)
	out.append(PlainWorkCall)
	out.append(ErrorPathMainClosing)
	return out
end 'reassignedOwnerFixtureSource'

function routedThrowFixtureSource(bindings BindingTally) returns String
	var out = "{ErrorPathFixturePrelude}{RefusalDeclaration}{ThrowingMakeDeclaration}{PlainWorkOpening}\tvar total = seed\n\n\ttry 'block'\n"
	appendLets(out, bindings: bindings, indent: "\t\t")
	appendUses(out, bindings: bindings, indent: "\t\t")
	out.append("\tend 'block' otherwise (caught) 'handler'\n\t\tmatch caught 'kind'\n\t\t\trefused then total = total + 1\n\t\tend 'kind'\n\tend 'handler'\n")
	out.append(WorkClosing)
	out.append(ErrorPathMainOpening)
	out.append(PlainWorkCall)
	out.append(ErrorPathMainClosing)
	return out
end 'routedThrowFixtureSource'

function routedBoxThrowFixtureSource(bindings BindingTally) returns String
	var out = "{ErrorPathFixturePrelude}{BoxedFailureDeclaration}{PlainMakeDeclaration}{PlainWorkOpening}\tvar total = seed\n\n\ttry 'block'\n"

	for index in 0 upto bindings 'eachBox'
		out.append("\t\tlet e{index} = Failure.detail(make(seed, index: {index}))\n")
	end 'eachBox'

	appendLets(out, bindings: bindings, indent: "\t\t")
	out.append("\n")

	for index in 0 upto bindings 'eachThrow'
		out.append("\t\tif seed == {index} 'exit{index}'\n\t\t\tthrow e{index}\n\t\tend 'exit{index}'\n\n")
	end 'eachThrow'

	appendUses(out, bindings: bindings, indent: "\t\t")
	out.append("\tend 'block' otherwise (caught) 'handler'\n\t\tmatch caught 'kind'\n\t\t\tdetail(message) then total = total + (message.byteLength() as Word)\n\t\tend 'kind'\n\tend 'handler'\n")
	out.append(WorkClosing)
	out.append(ErrorPathMainOpening)
	out.append(PlainWorkCall)
	out.append(ErrorPathMainClosing)
	return out
end 'routedBoxThrowFixtureSource'

function selfContainedFixtureSource(path SelfContainedErrorPath, bindings BindingTally) returns String
	return match path 'source'
		handedOffReturn gives handedOffReturnFixtureSource(bindings)
		freshReturn gives freshReturnFixtureSource(bindings)
		reassignedOwner gives reassignedOwnerFixtureSource(bindings)
		routedThrow gives routedThrowFixtureSource(bindings)
		routedBoxThrow gives routedBoxThrowFixtureSource(bindings)
	end 'source'
end 'selfContainedFixtureSource'

function errorPathFixtureSource(fixture ErrorPathFixture, bindings BindingTally) returns String
	return match fixture 'which'
		guarded(exitKind) gives guardedFixtureSource(exitKind, bindings: bindings)
		selfContained(path) gives selfContainedFixtureSource(path, bindings: bindings)
	end 'which'
end 'errorPathFixtureSource'

function errorPathCodeBytes(dir FilePath, fixture ErrorPathFixture, bindings BindingTally) returns ReportedTally throws TestFailure
	let table = try stagedProgramMetrics(dir, name: "{ErrorPathAppDirNamePrefix}{bindings}", source: errorPathFixtureSource(fixture, bindings: bindings), described: "the {bindings}-binding fixture whose bindings are each followed by {errorPathExitDescription(fixture)}")
	return metricsCell(table, kind: MetricsCodeKind, name: MetricsUnnamedRow, field: MetricsBytesField)
end 'errorPathCodeBytes'

type ErrorPathDropsGrowLinearly implements OutsideCheckoutCase
	var fixture as ErrorPathFixture

	static function create(fixture ErrorPathFixture) returns ErrorPathDropsGrowLinearly
		return Self{fixture: fixture}
	end 'create'

	export function requireHeldIn(dir FilePath) throws TestFailure
		let small = try errorPathCodeBytes(dir, fixture: self.fixture, bindings: SmallBindings)
		let medium = try errorPathCodeBytes(dir, fixture: self.fixture, bindings: MediumBindings)
		let large = try errorPathCodeBytes(dir, fixture: self.fixture, bindings: LargeBindings)

		let firstGrowth = medium - small
		let secondGrowth = large - medium
		let description = errorPathExitDescription(self.fixture)

		if firstGrowth <= 0 'noGrowth'
			panic("error-path-drops: the gate could not run - a function of {SmallBindings} owned bindings, each followed by {description}, compiled to {small} bytes of code and one of {MediumBindings} to {medium}, so doubling the bindings grew no code and there is no growth to compare.")
		end 'noGrowth'

		try Expect.isTrue(secondGrowth * LinearGrowthDenominator < firstGrowth * LinearGrowthNumerator, message: "a function of {SmallBindings}, {MediumBindings} and {LargeBindings} owned bindings, each followed by {description}, compiled to {small}, {medium} and {large} bytes of code: the second doubling added {secondGrowth} bytes against the first's {firstGrowth}, at least {LinearGrowthNumerator}/{LinearGrowthDenominator} times as many. The error-path code grows faster than the bindings - every exit drops every binding in scope inline rather than joining one shared cascade of drops.")
	end 'requireHeldIn'
end 'ErrorPathDropsGrowLinearly'

export let DeclaredMemberCount = 65536
export let DeclarationPrelude = "typealias Count = int(0 to 1000)\n\n"
export let DeclarationMain = "function main() returns ExitCode\n\treturn 0\nend 'main'\n"

let DeclarationStem = "declaration"
let DeclarationSourceExtension = ".maxon"
let CompilerPanicPhrase = "panic at"

export function requireDeclarationRefused(caseDirName String, source String, refusal String) throws TestFailure
	let dir = freshCaseDir(caseDirName)
	let sourcePath = dir.join("{DeclarationStem}{DeclarationSourceExtension}")
	writeStagedFile(sourcePath, content: source)
	let run = spawnCompiler([BuildCommandWord, sourcePath.toString(), "{OutputOptionPrefix}{dir.join(DeclarationStem).toString()}"])

	try Expect.equal(run.exitCode(), expected: 1, message: "a declaration of {DeclaredMemberCount} members ({caseDirName}) was not refused. It said: {run.stdout}{run.stderr}")
	try Expect.isFalse(run.stderr.contains(CompilerPanicPhrase), message: "a declaration of {DeclaredMemberCount} members ({caseDirName}) panicked the compiler. It said: {run.stderr}")
	try Expect.contains(run.stderr, needle: refusal, message: "a declaration of {DeclaredMemberCount} members ({caseDirName}) is not refused as `{refusal}`. It said: {run.stderr}")
end 'requireDeclarationRefused'

export function requireScratchNameCheckPasses(check String) throws TestFailure
	var arguments = StringArray.create()
	arguments.push(check)
	arguments.push("{endedProcessId()}")
	arguments.push(debugStreamSegmentPrefix())

	let ran = scratchNameProbe("cli-scratch-name-{check}", arguments: arguments)

	try Expect.equal(ran.exitCode(), expected: 0, message: "the `{check}` check of maxon-bin/Run/ScratchName.maxon failed: {ran.stdout}{ran.stderr}")
	try Expect.equal(ran.stdout.trim(), expected: "ok", message: "the `{check}` check did not report ok: {ran.stdout}{ran.stderr}")
end 'requireScratchNameCheckPasses'
