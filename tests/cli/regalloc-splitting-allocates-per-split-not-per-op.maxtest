// regalloc-splitting-allocates-per-split-not-per-op.maxtest - the register allocator's `splitting`
// sub-phase allocates per function and per split, never per op of the pressure sweep.
//
// Two fixture sizes rather than one budget: an absolute allocation count drifts with every unrelated
// change and would have to be re-blessed, while the SLOPE across two bodies of the same shape is the
// property itself. A per-op term makes the extra allocations grow at least as fast as the extra
// statements, which is exactly what the assertion refuses.

let RegallocSplittingAllocatesPerSplitNotPerOpCaseDirName = "regalloc-splitting"

let RegallocSplittingAllocatesPerSplitNotPerOpLargeRepetitions = 64

let SplittingPhaseName = "splitting"

let RegallocSplittingAllocatesPerSplitNotPerOpStatementsPerBlock = 10
let RegallocSplittingAllocatesPerSplitNotPerOpFixtureSetupStatements = 10

let RegallocSplittingAllocatesPerSplitNotPerOpFixtureHeader = "typealias Word = int(0 to u32.max)\n\nfunction work(seed Word) returns Word\n\tvar v0 = (seed shr 0) and 0xFFFF\n\tvar v1 = (seed shr 1) and 0xFFFF\n\tvar v2 = (seed shr 2) and 0xFFFF\n\tvar v3 = (seed shr 3) and 0xFFFF\n\tvar v4 = (seed shr 4) and 0xFFFF\n\tvar v5 = (seed shr 5) and 0xFFFF\n\tvar v6 = (seed shr 6) and 0xFFFF\n\tvar v7 = (seed shr 7) and 0xFFFF\n\tvar v8 = (seed shr 8) and 0xFFFF\n\tvar v9 = (seed shr 9) and 0xFFFF\n"
let RegallocSplittingAllocatesPerSplitNotPerOpFixtureBlock = "\n\tv0 = (v0 + v1) and 0xFFFF\n\tv1 = (v1 xor v2) and 0xFFFF\n\tv2 = (v2 + v3) and 0xFFFF\n\tv3 = (v3 shl 1) and 0xFFFF\n\tv4 = (v4 + v5) and 0xFFFF\n\tv5 = (v5 xor v6) and 0xFFFF\n\tv6 = (v6 + v7) and 0xFFFF\n\tv7 = (v7 shl 1) and 0xFFFF\n\tv8 = (v8 + v9) and 0xFFFF\n\tv9 = (v9 xor v0) and 0xFFFF\n"
let RegallocSplittingAllocatesPerSplitNotPerOpFixtureFooter = "\n\treturn v0 + v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9\nend 'work'\n\nfunction main() returns ExitCode\n\tlet spelled = try Process.environmentVariable(\"PATH\") otherwise \"\"\n\tlet answer = work((spelled.byteLength() and 0xFFFF) as Word)\n\n\tif answer > 0 'produced'\n\t\treturn 0\n\tend 'produced'\n\n\treturn 1\nend 'main'\n"

function repetitionFixtureSource(repetitions BlockRepetition) returns String
	var out = RegallocSplittingAllocatesPerSplitNotPerOpFixtureHeader

	for _ in 0 upto repetitions 'eachBlock'
		out.append(RegallocSplittingAllocatesPerSplitNotPerOpFixtureBlock)
	end 'eachBlock'

	out.append(RegallocSplittingAllocatesPerSplitNotPerOpFixtureFooter)
	return out
end 'repetitionFixtureSource'

function fixtureStatements(repetitions BlockRepetition) returns StatementTally
	return RegallocSplittingAllocatesPerSplitNotPerOpFixtureSetupStatements + RegallocSplittingAllocatesPerSplitNotPerOpStatementsPerBlock * (repetitions as StatementTally)
end 'fixtureStatements'

function splittingAllocationsFor(dir FilePath, appDirName String, repetitions BlockRepetition) returns ReportedTally throws TestFailure
	let table = try stagedProgramMetrics(dir, name: appDirName, source: repetitionFixtureSource(repetitions), described: "the {repetitions}-block fixture")
	return metricsCell(table, kind: MetricsRegAllocKind, name: SplittingPhaseName, field: MetricsAllocsField)
end 'splittingAllocationsFor'

test 'the pressure sweep allocates per function rather than per op'
	requireHeldOutsideCheckout(RegallocSplittingAllocatesPerSplitNotPerOpCaseDirName, check: SplittingAllocatesPerSplit.create())
end 'the pressure sweep allocates per function rather than per op'

type SplittingAllocatesPerSplit implements OutsideCheckoutCase
	static function create() returns SplittingAllocatesPerSplit
		return Self{}
	end 'create'

	export function requireHeldIn(dir FilePath) throws TestFailure
		let smallAllocs = try splittingAllocationsFor(dir, appDirName: SmallAppDirName, repetitions: SmallRepetitions)
		let largeAllocs = try splittingAllocationsFor(dir, appDirName: LargeAppDirName, repetitions: RegallocSplittingAllocatesPerSplitNotPerOpLargeRepetitions)

		let smallStatements = fixtureStatements(SmallRepetitions) as ReportedTally
		let largeStatements = fixtureStatements(RegallocSplittingAllocatesPerSplitNotPerOpLargeRepetitions) as ReportedTally

		try Expect.isTrue(largeAllocs - smallAllocs < largeStatements - smallStatements, message: "the `{SplittingPhaseName}` sub-phase allocated {smallAllocs} boxes over a body of {smallStatements} statements and {largeAllocs} over a body of {largeStatements}, so {largeStatements - smallStatements} more statements cost {largeAllocs - smallAllocs} more allocations: the pressure sweep allocates at least one box per op it visits. Its verdicts must cost nothing per op - only per function and per split.")
	end 'requireHeldIn'
end 'SplittingAllocatesPerSplit'
