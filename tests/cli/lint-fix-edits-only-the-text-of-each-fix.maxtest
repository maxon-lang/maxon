let LintFixUnformattedCaseDirName = "lint-fix-unformatted"
let LintFixUnformattedFixture = "lint-fix-unformatted"
let LintFixUnformattedFile = "app/main.maxon"
let LintFixUnformattedFindings = 1

test 'lint --fix of a file maxon fmt would rewrite edits only the text of the fix and keeps the rest of its bytes'
	let fixed = lintFixFixedFiles(LintFixUnformattedFile, findings: LintFixUnformattedFindings)
	requireHeldOutsideCheckout(LintFixUnformattedCaseDirName, check: LintFixCase.of(LintFixUnformattedFixture, arguments: [AppDirName], fixed: fixed, outcome: LintFixOutcome.linted(AppDirName)))
end 'lint --fix of a file maxon fmt would rewrite edits only the text of the fix and keeps the rest of its bytes'
