// cache-does-not-count-a-staged-snippet.test.maxon — the directory Maxon owns holds more than builds, and
// bare `maxon cache` counts only the builds.
//
// ⭐⭐ **THE MCP SERVER STAGES AN INLINE SNIPPET'S SOURCE UNDER THAT SAME ROOT**, beside the run cache's own
// directory, because a clear has to reach it. So a count taken by ELIMINATION — everything that is not a
// `.mxdbg` sidecar and not a build still being written — reports one build more than the host holds, for
// every caller who has ever used the server. A build's NAME has a shape; a `.maxon` source does not.
//
// ⚠ **THE SNIPPET IS PLANTED AND THE BUILDS BESIDE IT ARE PUBLISHED BY THE DRIVER.** Where a build lands is
// the driver's own layout and a planted one would ask this case's arithmetic instead; where the snippet
// lands is a path the MCP server spells, which this corpus may respell like every other driver constant it
// names.

let CaseDirName = "cache-does-not-count-a-staged-snippet"

// What the MCP server calls the directory it stages into and the file it stages there, respelled here
// because this corpus is a separate program and cannot read the driver's own constants.
let SnippetStem = "mcp-snippet"
let SnippetExtension = ".maxon"
let SnippetSource = "// an inline snippet a tool call staged\n"

// A second program under a second NAME, because a slot is keyed on the program's path: the same file cached
// twice is one build superseding another. Two rather than one, because a count that is really the file
// count, or a constant, passes a one-build case perfectly.
let SecondProgramFileName = "second.maxon"
let PublishedBuilds = 2

test 'a snippet staged under the cache root is not counted as a build'
	let dir = freshCaseDir(CaseDirName)
	let cacheRoot = cacheRootIn(dir)

	publishCachedBuild(dir, cacheRoot: cacheRoot)
	publishCachedBuild(dir, cacheRoot: cacheRoot, program: SecondProgramFileName)

	let owned = cacheRoot.join(CacheVendorDirName)
	let builtFiles = filesUnder(owned).count() as AssertedInt

	stageSnippetUnder(owned)

	let withSnippet = filesUnder(owned).count() as AssertedInt
	try Expect.greaterThan(withSnippet, than: builtFiles, message: "the gate could not run - staging a snippet under {owned.toString()} left the file count at {withSnippet}, so there is nothing under the root for the report to miscount")

	let reported = runWithCacheRoot([CacheCommandWord], cacheRoot: cacheRoot, workingDirectory: dir)
	let said = "It wrote to stdout: {reported.stdout} and to stderr: {reported.stderr}"

	try Expect.equal(reported.exitCode() as AssertedInt, expected: 0, message: "`maxon {CacheCommandWord}` did not succeed over a root holding {PublishedBuilds} builds and a staged snippet. A file that is not a build is not a fault. {said}")
	try Expect.isEmpty(reported.stderr.trim(), message: "`maxon {CacheCommandWord}` wrote to stderr while answering over a root holding a staged snippet. {said}")

	let state = try reportedStateOf(reported.stdout, directory: owned) otherwise panic("{CaseDirName}: `maxon {CacheCommandWord}` named no line for {owned.toString()}, the root it was pointed at through {CacheRootVariable}. {said}")

	let counted = try reportedTally(state) otherwise panic("{CaseDirName}: `maxon {CacheCommandWord}` stated no count for {owned.toString()}, so there is no number to compare. It said of it: {state}")
	try Expect.equal(counted, expected: PublishedBuilds, message: "`maxon {CacheCommandWord}` reported {counted} builds for {owned.toString()} where {PublishedBuilds} were published and one snippet source was staged. A staged snippet is not a build. {said}")
end 'a snippet staged under the cache root is not counted as a build'

// A snippet where the MCP server stages one: its own directory under the root Maxon owns, and one source
// file in it.
function stageSnippetUnder(owned FilePath)
	let staged = owned.join(SnippetStem)

	if not Directory.create(staged) and not Directory.isDirectory(staged) 'couldNotCreate'
		panic("{CaseDirName}: the gate could not run - could not create {staged.toString()}, where the MCP server stages an inline snippet.")
	end 'couldNotCreate'

	let file = staged.join("{SnippetStem}{SnippetExtension}")
	try File.writeText(file, content: SnippetSource) otherwise panic("{CaseDirName}: the gate could not run - could not write {file.toString()}, the snippet source a staged tool call leaves under the cache root.")
end 'stageSnippetUnder'
