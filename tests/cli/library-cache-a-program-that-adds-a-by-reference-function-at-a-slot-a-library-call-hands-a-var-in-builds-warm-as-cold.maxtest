let LibraryCacheAddsAByReferenceFunctionAtALibraryCallSlotCaseDirName = "library-cache-adds-by-reference-call-slot"
let FunctionValuedFieldNamedLikeALibraryCalleeProgramSource = "typealias Tally = int(0 to 1000)\ntypealias Rescaling = function(Tally) returns Tally\n\ntype Gauge\n\tvar set as Rescaling\n\n\tstatic function create(rescale Rescaling) returns Gauge\n\t\treturn Gauge\{set: rescale\}\n\tend 'create'\n\n\tfunction reading(amount Tally) returns Tally\n\t\treturn self.set(amount)\n\tend 'reading'\nend 'Gauge'\n\nfunction main() returns ExitCode\n\tlet seed = 21\n\tlet words = \"seed \{seed\} grows\".split(\" \")\n\twords.insert(0, value: \"then\")\n\tlet word = try words.get(2) otherwise \"\"\n\tlet length = word.byteLength() as Tally\n\tlet gauge = Gauge.create(function(n Tally) gives n * 9)\n\treturn (gauge.reading(length) + seed) as ExitCode\nend 'main'\n"
let AddsAByReferenceFunctionAtALibraryCallSlotProgramSource = "typealias Tally = int(0 to 1000)\ntypealias Rescaling = function(Tally) returns Tally\n\ntype Gauge\n\tvar set as Rescaling\n\n\tstatic function create(rescale Rescaling) returns Gauge\n\t\treturn Gauge\{set: rescale\}\n\tend 'create'\n\n\tfunction reading(amount Tally) returns Tally\n\t\treturn self.set(amount)\n\tend 'reading'\nend 'Gauge'\n\nfunction accrue(total mutable Tally, amount Tally)\n\ttotal = total + amount\nend 'accrue'\n\nfunction main() returns ExitCode\n\tlet seed = 21\n\tlet words = \"seed \{seed\} grows\".split(\" \")\n\twords.insert(0, value: \"then\")\n\tlet word = try words.get(2) otherwise \"\"\n\tlet length = word.byteLength() as Tally\n\tlet gauge = Gauge.create(function(n Tally) gives n * 9)\n\tvar total = gauge.reading(length)\n\taccrue(total, amount: 40)\n\treturn (total + seed) as ExitCode\nend 'main'\n"
let AddsAByReferenceFunctionAtALibraryCallSlotProgramExitCode = 79

test 'a program that adds a function taking a mutable parameter, at a position where a library call that may hand a function value hands a var, builds warm to the bytes a cold build writes'
	requireHeldOutsideCheckout(LibraryCacheAddsAByReferenceFunctionAtALibraryCallSlotCaseDirName, check: BuiltAfterAnotherMatchesCold.create(AddsAByReferenceFunctionAtALibraryCallSlotProgramSource, exitCode: AddsAByReferenceFunctionAtALibraryCallSlotProgramExitCode, subject: "a program that adds a free function taking a `mutable` parameter, at the arity and position at which a library call spelled like a call of the program's function-valued field hands a `var`", before: FunctionValuedFieldNamedLikeALibraryCalleeProgramSource))
end 'a program that adds a function taking a mutable parameter, at a position where a library call that may hand a function value hands a var, builds warm to the bytes a cold build writes'
