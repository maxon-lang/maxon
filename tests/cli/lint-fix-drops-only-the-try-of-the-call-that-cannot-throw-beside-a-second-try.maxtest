let LintFixTryBesideTryFixture = "lint-fix-try-beside-a-second-try"
let LintFixTryBesideTryFindings = 1
let LintFixTryBesideTryPrinted = "5\n"

test 'lint --fix drops only the try of a call that cannot throw when a second try on the line owns the otherwise, keeps that fallback, and the program prints what it printed'
	requireHeldOutsideCheckout(LintFixTryBesideTryFixture, check: lintFixRunningCase(LintFixTryBesideTryFixture, findings: LintFixTryBesideTryFindings, printed: LintFixPrinted.exactly(LintFixTryBesideTryPrinted)))
end 'lint --fix drops only the try of a call that cannot throw when a second try on the line owns the otherwise, keeps that fallback, and the program prints what it printed'
