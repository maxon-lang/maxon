let LibraryCacheFreeFunctionNamedBuildCaseDirName = "library-cache-free-build"
let FreeFunctionNamedBuildProgramSource = "typealias Tally = int(0 to 1000)\n\ntype Job\n\tlet weight as Tally\n\n\tstatic function create(weight Tally) returns Job\n\t\treturn Self\{weight: weight\}\n\tend 'create'\n\n\tfunction doubled() returns Tally\n\t\treturn self.weight * 2\n\tend 'doubled'\nend 'Job'\n\nfunction build(weight Tally) returns Job\n\treturn Job.create(weight)\nend 'build'\n\nfunction main() returns ExitCode\n\tlet seed = 21\n\tlet words = \"seed \{seed\} grows\".split(\" \")\n\twords.insert(0, value: \"then\")\n\tlet word = try words.get(2) otherwise \"\"\n\tlet length = word.byteLength() as Tally\n\tlet extra = build(4).doubled()\n\treturn (length + seed + extra) as ExitCode\nend 'main'\n"
let FreeFunctionNamedBuildProgramExitCode = 31

test 'a program that adds a free function named build whose body returns a record of an author type built in the call is served the library parses of the program before it'
	requireHeldOutsideCheckout(LibraryCacheFreeFunctionNamedBuildCaseDirName, check: BuiltInSequenceMatchesCold.create([SequencedProgram.create(FreeFunctionNamedBuildProgramSource, exitCode: FreeFunctionNamedBuildProgramExitCode, subject: "a program that adds a free function named `build` whose body returns a record of an author type built in the call", expectation: LibraryCacheExpectation.servedEveryParse)]))
end 'a program that adds a free function named build whose body returns a record of an author type built in the call is served the library parses of the program before it'
