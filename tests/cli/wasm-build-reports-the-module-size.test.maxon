// wasm-build-reports-the-module-size.test.maxon - a wasm32-wasi build's `Wrote N bytes of code` line
// reports the core module it emitted, so N is not 0.
//
// Built from the checkout, whose `vendor/` holds the tools the component wrap needs.

let CaseDirName = "wasm-build-reports-the-module-size"
let SourceFileName = "main.maxon"
let OutputStem = "main"
let WasmTargetOption = "--target=wasm32-wasi"
let CompilerInfoLogOption = "--log=compiler:info"
let Source = "function main() returns ExitCode\n\tprint(\"hello\\n\")\n\treturn 0\nend 'main'\n"

// The progress line's words around the number (`Compiler.compileMeasured`).
let WroteWord = "Wrote "
let BytesWord = " bytes of code"

typealias ReportedBytes = int(i64.min to i64.max)

test 'a wasm build reports the size of the module it wrote'
	let dir = freshCaseDir(CaseDirName)
	let sourcePath = dir.join(SourceFileName)
	try File.writeText(sourcePath, content: Source) otherwise panic("wasm-build-reports-the-module-size: the gate could not run - could not write {sourcePath.toString()}")

	let build = runDriver([BuildCommandWord, sourcePath.toString(), OutputFlag, dir.join(OutputStem).toString(), WasmTargetOption, CompilerInfoLogOption])
	let said = "It wrote to stdout: {build.stdout} and to stderr: {build.stderr}"
	try Expect.equal(build.exitCode() as AssertedInt, expected: 0, message: "a one-line program did not build for wasm32-wasi. {said}")

	match wroteBytesIn(build.stderr) 'reading'
		reported(bytes) then try Expect.greaterThan(bytes as AssertedInt, than: 0, message: "a wasm build reported writing {bytes} bytes of code, and it wrote a module. {said}")
		unreadable(reason) then try Expect.fail("a wasm build's `{WroteWord}N{BytesWord}` line could not be read: {reason}. {said}")
	end 'reading'
end 'a wasm build reports the size of the module it wrote'

union ReportedSize
	reported(bytes ReportedBytes)
	unreadable(reason String)
end 'ReportedSize'

function wroteBytesIn(stderr String) returns ReportedSize
	for line in stderr.split("\n") 'eachLine'
		if not line.contains(WroteWord) or not line.contains(BytesWord) 'notTheLine'
			continue
		end 'notTheLine'

		let afterWrote = try line.split(WroteWord).get(1) otherwise panic("wasm-build-reports-the-module-size: a line containing the separator splits into two parts")
		let digits = (try afterWrote.split(BytesWord).get(0) otherwise panic("wasm-build-reports-the-module-size: a split always yields a first part")).trim()
		let parsed = try int.fromString(digits) otherwise 'notANumber'
			return ReportedSize.unreadable("`{digits}` is not a number")
		end 'notANumber'

		return ReportedSize.reported(parsed as ReportedBytes)
	end 'eachLine'

	return ReportedSize.unreadable("there is no such line")
end 'wroteBytesIn'
