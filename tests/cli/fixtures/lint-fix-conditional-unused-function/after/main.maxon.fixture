#if os(Linux)
function platformName() returns String
	return "linux"
end 'platformName'
#else
function platformName() returns String
	return "other"
end 'platformName'
#endif
function spare() returns ExitCode
	return 1
end 'spare'

function main() returns ExitCode
	print("{platformName()}\n")
	return 0
end 'main'
