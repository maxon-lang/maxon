typealias Tally = int(0 to 1000)

function counted(n Tally, flag bool) returns Tally
	var total = n
	total = total + 1

	if flag 'chosen'
#if os(Wasi)
		print("wasi\n")
#endif
		total = total
	end 'chosen'

	return total
end 'counted'

function main() returns ExitCode
	return counted(1, flag: false) as ExitCode
end 'main'
