typealias Tally = int(0 to 1000)

let Score = 2
let Limit = 1

function clamped(score Tally) returns Tally
	if score > Limit 'over'
		return Limit
	end 'over'

	return score
end 'clamped'

function graded(score Tally) returns String
	let grade = match score 'band'
		1 gives "low"
		default gives "other"
	end 'band'

	return grade
end 'graded'

function main() returns ExitCode
	print("{graded(clamped(Score))}\n")
	return 0
end 'main'
