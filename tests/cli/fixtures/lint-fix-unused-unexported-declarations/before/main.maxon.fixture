typealias Tally = int(0 to 1000)

/// The code main answers with.
let Answer = 0

// A note that belongs to no declaration.

/// Doubles a tally.
/// Nothing calls it.
function doubled(n Tally) returns Tally
	return n * 2
end 'doubled'

// Triples a tally.
// Nothing calls it either.
function tripled(n Tally) returns Tally
	return n * 3
end 'tripled'

/// Says what main answers.
function answered(n Tally) returns ExitCode
	return n as ExitCode
end 'answered'

function incremented(n Tally) returns Tally
	return n + 1
end 'incremented'

let UnusedLimit = 10

type Unused
	let count as Tally
end 'Unused'

// Where the program starts.
function main() returns ExitCode
	return answered(Answer)
end 'main'
