typealias Tally = int(0 to 1000)

let Base = 3

function weighed(first Tally, second Tally, flag bool) returns Tally
	let kept = first + 1
	let total = kept + second

	if flag 'flagged'
		let lonely = 7
	end 'flagged'

	return total
end 'weighed'

function main() returns ExitCode
	return 0 if weighed(Base, second: Base, flag: false) > Base else 1
end 'main'
