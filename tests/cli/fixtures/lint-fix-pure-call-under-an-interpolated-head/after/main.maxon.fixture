typealias Tally = int(0 to 1000)

function doubled(n Tally) returns Tally
	return n * 2
end 'doubled'

function considered(name String, n Tally) returns Tally
	if name == "{n}" 'same'
		// note
		doubled(n)
	end 'same'

	return n
end 'considered'

function main() returns ExitCode
	return considered("4", n: 4) as ExitCode
end 'main'
