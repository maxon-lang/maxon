typealias Wide = int(0 to 1000)
typealias Small = int(0 to 10)

let Count = 4

function narrowed(n Small) returns Small
	return n
end 'narrowed'

function considered(wide Wide) returns Wide
	narrowed(wide as Small)
	return wide
end 'considered'

function main() returns ExitCode
	return 0 if considered(Count) == Count else 1
end 'main'
