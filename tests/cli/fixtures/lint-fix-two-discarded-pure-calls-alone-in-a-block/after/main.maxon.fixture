typealias Tally = int(0 to 1000)

let Input = 4

function doubled(n Tally) returns Tally
	return n * 2
end 'doubled'

function spun(n Tally, flag bool) returns Tally
	while flag 'spinning'
		doubled(n)
	end 'spinning'

	return n
end 'spun'

function main() returns ExitCode
	return 0 if spun(Input, flag: false) == Input else 1
end 'main'
