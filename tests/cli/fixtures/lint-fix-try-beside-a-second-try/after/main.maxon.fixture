typealias Tally = int(0 to 1000)

let Input = 4
let Limit = 2

enum RiskError implements Error
	tooLarge
end 'RiskError'

function plain(n Tally) returns Tally
	return n + 1
end 'plain'

function fallible(n Tally) returns Tally throws RiskError
	if n > Limit 'tooLarge'
		throw RiskError.tooLarge
	end 'tooLarge'

	return n
end 'fallible'

function main() returns ExitCode
	let total = plain(Input) + try fallible(Input) otherwise 0
	print("{total}\n")
	return 0
end 'main'
