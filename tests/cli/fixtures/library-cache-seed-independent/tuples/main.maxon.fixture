function main() returns ExitCode
	let request = try HttpRequest.create(HttpMethod.get, url: "https://localhost:1/") otherwise return 2
	let pairs = bytePairA().0.count() + bytePairB().0.count() + bytePairC().0.count() + bytePairD().0.count()
	let triples = byteTripleA().2.count() + byteTripleB().2.count() + byteTripleC().2.count() + byteTripleD().2.count()
	let textFirst = textBytesA().1.count() + textBytesB().1.count() + textBytesC().1.count() + textBytesD().1.count()
	let bytesFirst = bytesTextA().1.count() + bytesTextB().1.count() + bytesTextC().1.count() + bytesTextD().1.count()

	if pairs + triples + textFirst + bytesFirst != 16 'wrong'
		return 1
	end 'wrong'

	let response = try HttpClient.send(request, tls: TlsClientOptions.create()) otherwise return 3

	print("{response.statusCode().number()}\n")
	return 0
end 'main'
