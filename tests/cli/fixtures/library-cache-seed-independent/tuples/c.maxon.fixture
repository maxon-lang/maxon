function bytePairC() returns (ByteArray, ByteArray)
	return ("c".toByteArray(), "c".toByteArray())
end 'bytePairC'

function byteTripleC() returns (ByteArray, ByteArray, ByteArray)
	return ("c".toByteArray(), "c".toByteArray(), "c".toByteArray())
end 'byteTripleC'

function textBytesC() returns (StringArray, ByteArray)
	return (["c"].clone(), "c".toByteArray())
end 'textBytesC'

function bytesTextC() returns (ByteArray, StringArray)
	return ("c".toByteArray(), ["c"].clone())
end 'bytesTextC'
