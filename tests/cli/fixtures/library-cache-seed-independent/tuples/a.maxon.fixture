function bytePairA() returns (ByteArray, ByteArray)
	return ("a".toByteArray(), "a".toByteArray())
end 'bytePairA'

function byteTripleA() returns (ByteArray, ByteArray, ByteArray)
	return ("a".toByteArray(), "a".toByteArray(), "a".toByteArray())
end 'byteTripleA'

function textBytesA() returns (StringArray, ByteArray)
	return (["a"].clone(), "a".toByteArray())
end 'textBytesA'

function bytesTextA() returns (ByteArray, StringArray)
	return ("a".toByteArray(), ["a"].clone())
end 'bytesTextA'
