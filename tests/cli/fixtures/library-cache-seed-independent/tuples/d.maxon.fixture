function bytePairD() returns (ByteArray, ByteArray)
	return ("d".toByteArray(), "d".toByteArray())
end 'bytePairD'

function byteTripleD() returns (ByteArray, ByteArray, ByteArray)
	return ("d".toByteArray(), "d".toByteArray(), "d".toByteArray())
end 'byteTripleD'

function textBytesD() returns (StringArray, ByteArray)
	return (["d"].clone(), "d".toByteArray())
end 'textBytesD'

function bytesTextD() returns (ByteArray, StringArray)
	return ("d".toByteArray(), ["d"].clone())
end 'bytesTextD'
