function bytePairB() returns (ByteArray, ByteArray)
	return ("b".toByteArray(), "b".toByteArray())
end 'bytePairB'

function byteTripleB() returns (ByteArray, ByteArray, ByteArray)
	return ("b".toByteArray(), "b".toByteArray(), "b".toByteArray())
end 'byteTripleB'

function textBytesB() returns (StringArray, ByteArray)
	return (["b"].clone(), "b".toByteArray())
end 'textBytesB'

function bytesTextB() returns (ByteArray, StringArray)
	return ("b".toByteArray(), ["b"].clone())
end 'bytesTextB'
