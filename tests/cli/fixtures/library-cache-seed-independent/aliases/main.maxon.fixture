typealias DurationMs = int(0 to 10)
typealias Value = int(0 to 200)

type Boxed
	export let value as Value

	static function create(value Value) returns Boxed
		return Self{value: value}
	end 'create'
end 'Boxed'

typealias FullRangeIntArray = Array with Boxed

function paused(d DurationMs) returns Value
	return d as Value
end 'paused'

function main() returns ExitCode
	let held = FullRangeIntArray.create(0)
	held.push(Boxed.create(3))

	var total = paused(2)

	for box in held 'eachHeld'
		total = total + box.value
	end 'eachHeld'

	return total as ExitCode
end 'main'
