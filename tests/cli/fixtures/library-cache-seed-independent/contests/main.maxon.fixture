typealias Value = int(0 to 200)

type Boxed
	export let value as Value

	static function create(value Value) returns Boxed
		return Self{value: value}
	end 'create'
end 'Boxed'

enum Colour
	red
	green
	blue
end 'Colour'

function main() returns ExitCode
	let literal = [Boxed.create(3), Boxed.create(4)]
	var total = 0 as Value

	for box in literal 'eachBox'
		total = total + box.value
	end 'eachBox'

	for colour in Colour.allCases 'eachColour'
		total = total + colour.ordinal as Value
	end 'eachColour'

	return (total + scaledInA(3) as Value + scaledInB(4) as Value) as ExitCode
end 'main'
