let ScaleStep = 3

type Widget
	let width as Count

	static function create(width Count) returns Widget
		return Self{width: width}
	end 'create'
end 'Widget'

type Gadget
	let size as Count

	static function create(size Count) returns Gadget
		return Self{size: size}
	end 'create'
end 'Gadget'

function scale(x Count) returns Count
	return Widget.create(Gadget.create(x).size * ScaleStep).width
end 'scale'

export function scaledInB(x Count) returns Count
	return scale(x)
end 'scaledInB'
