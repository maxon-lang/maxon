typealias Score = int(0 to 100)
typealias Tally = int(0 to 10)
typealias Entry = (Score, String)
typealias Flag = (String, bool)
typealias Mark = (bool, Score)

function echoed(value T) uses T returns T
	return value
end 'echoed'

function entryOf() returns Entry
	return (4, "four")
end 'entryOf'

function flagOf() returns Flag
	return ("on", true)
end 'flagOf'

function markOf() returns Mark
	return (true, 5)
end 'markOf'

function main() returns ExitCode
	try Expect.equal(3 as Score, expected: 3) otherwise return 1

	let entry = echoed(entryOf())
	let flag = echoed(flagOf())
	let mark = echoed(markOf())
	let total = entry.0 + mark.1

	if flag.1 and entry.1 == flag.0 'never'
		return 1
	end 'never'

	return (total as Tally) if mark.0 else 0
end 'main'
