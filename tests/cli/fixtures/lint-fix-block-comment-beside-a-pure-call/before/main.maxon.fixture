typealias Tally = int(0 to 1000)

let Input = 4

function doubled(n Tally) returns Tally
	return n * 2
end 'doubled'

function considered(n Tally, flag bool) returns Tally
	if flag 'chosen'
		/* note */
		doubled(n)
	end 'chosen'

	return n
end 'considered'

function main() returns ExitCode
	return 0 if considered(Input, flag: false) == Input else 1
end 'main'
