typealias Tally = int(0 to 1000)

let Input = 4
let Limit = 10

enum AppError implements Error
	failed
end 'AppError'

function announce(word String)
	print("{word}\n")
end 'announce'

function run(n Tally) throws AppError
	if n > Limit 'tooLarge'
		throw AppError.failed
	end 'tooLarge'

	announce("fourth")
end 'run'

function main() returns ExitCode
	try run(Input) otherwise panic("run failed")
	return 0
end 'main'
