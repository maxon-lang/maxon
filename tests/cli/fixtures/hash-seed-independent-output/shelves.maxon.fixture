typealias CrateArray = Array with Crate
typealias CargoArray = Array with Cargo

enum Weekday
	monday
	tuesday
	wednesday
end 'Weekday'

enum Suit
	clubs
	hearts
	spades
end 'Suit'

enum Instrument
	theorbo
	sackbut
	crumhorn
end 'Instrument'

type Shelf
	let items as StringArray
	let label as String

	static function create(label String) returns Shelf
		return Self{items: StringArray.create(0), label: label}
	end 'create'
end 'Shelf'

type Crate
	let contents as StringArray
	let stamp as String

	static function create(stamp String) returns Crate
		return Self{contents: StringArray.create(0), stamp: stamp}
	end 'create'
end 'Crate'

type Pallet
	let crates as CrateArray
	let dock as String

	static function create(dock String) returns Pallet
		return Self{crates: CrateArray.create(0), dock: dock}
	end 'create'
end 'Pallet'

type Manifest
	let pallet as Pallet
	let cargo as CargoArray

	static function create(pallet Pallet) returns Manifest
		return Self{pallet: pallet, cargo: CargoArray.create(0)}
	end 'create'
end 'Manifest'

union Cargo
	empty
	loose(text String)
	boxed(crate Crate)
	stacked(pallet Pallet)
end 'Cargo'
