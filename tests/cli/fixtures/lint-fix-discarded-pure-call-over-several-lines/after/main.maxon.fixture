typealias Tally = int(0 to 1000)

let SummedInput = 4

function summed(first Tally, second Tally, third Tally) returns Tally
	return first + second + third
end 'summed'

function main() returns ExitCode
	let total = summed(SummedInput, second: 0, third: 0)
	return 0 if total == SummedInput else 1
end 'main'
