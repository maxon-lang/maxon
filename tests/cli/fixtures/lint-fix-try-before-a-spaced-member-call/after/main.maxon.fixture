typealias Tally = int(0 to 1000)

type Parts
	let head as Tally

	static function of(head Tally) returns Parts
		return Self{head: head}
	end 'of'

	function first() returns Tally
		return self.head
	end 'first'
end 'Parts'

function main() returns ExitCode
	let parts = Parts.of(3)
	let leading = parts .first()
	print("{leading}\n")
	return 0
end 'main'
