typealias Tally = int(0 to 1000)

let Radius = 3

union Shape
	circle(radius Tally)
	square(side Tally)
	dot(size Tally)
end 'Shape'

function described(shape Shape) returns String
	let text = match shape 'kind'
		circle(radius) gives "circle of {radius}"
		square gives "square"
		dot gives "dot"
	end 'kind'

	return text
end 'described'

function main() returns ExitCode
	print("{described(Shape.circle(Radius))}\n")
	print("{described(Shape.square(Radius))}\n")
	print("{described(Shape.dot(Radius))}\n")
	return 0
end 'main'
