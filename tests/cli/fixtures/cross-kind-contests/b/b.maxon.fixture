typealias Widget = int(0 to 9)
typealias Gauge = int(0 to 99)
typealias Lever = int(0 to 999)
typealias Widgets = Array with Widget
typealias Gauges = Array with Gauge
typealias Levers = Array with Lever

export function measuredInB(x Count) returns Count
	let widgets = Widgets.create(0)
	widgets.push(3)

	let gauges = Gauges.create(0)
	gauges.push(40)

	let levers = Levers.create(0)
	levers.push(500)

	var total = x

	for w in widgets 'eachWidget'
		total = total + w as Count
	end 'eachWidget'

	for g in gauges 'eachGauge'
		total = total + g as Count
	end 'eachGauge'

	for l in levers 'eachLever'
		total = total + l as Count
	end 'eachLever'

	return total
end 'measuredInB'
