type Widget
	let width as Count

	static function create(width Count) returns Widget
		return Self{width: width}
	end 'create'
end 'Widget'

enum Gauge
	narrow = 1
	broad = 2
end 'Gauge'

type Lever
	let reach as Count

	static function create(reach Count) returns Lever
		return Self{reach: reach}
	end 'create'
end 'Lever'

export function measuredInA(x Count) returns Count
	return Widget.create(x).width + Gauge.broad.rawValue as Count + Lever.create(x).reach
end 'measuredInA'
