typealias Tally = int(0 to 1000)

let FirstInput = 1
let SecondInput = 2

enum LoadError implements Error
	missing
end 'LoadError'

function loaded(n Tally) returns Tally throws LoadError
	return n + 1
end 'loaded'

function first() returns Tally
	return try loaded(FirstInput) otherwise 0
end 'first'

function second() returns Tally
	return try loaded(SecondInput) otherwise 0
end 'second'

function main() returns ExitCode
	print("{first()} {second()}\n")
	return 0
end 'main'
