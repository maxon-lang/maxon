typealias Tally = int(0 to 1000)

let FirstInput = 1
let SecondInput = 2

function loaded(n Tally) returns Tally
	return n + 1
end 'loaded'

function first() returns Tally
	return loaded(FirstInput)
end 'first'

function second() returns Tally
	return loaded(SecondInput)
end 'second'

function main() returns ExitCode
	print("{first()} {second()}\n")
	return 0
end 'main'
