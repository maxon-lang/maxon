typealias Tally = int(0 to 1000)

let FirstInput = 3
let SecondInput = 4

function doubled(n Tally) returns Tally
	return n * 2
end 'doubled'

function summed(first Tally, second Tally) returns Tally
	return doubled(first) + doubled(second)
end 'summed'

function main() returns ExitCode
	let total = summed(FirstInput, second: SecondInput)
	print("{total} {tallied(FirstInput)}\n")
	return 0
end 'main'
