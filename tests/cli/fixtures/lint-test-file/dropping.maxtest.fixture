typealias Tally = int(0 to 1000)

let DoubledInput = 4
let ExpectedDoubled = 8

function doubled(n Tally) returns Tally
	return n * 2
end 'doubled'

test 'doubling answers past a dropped result'
	doubled(DoubledInput)
	Expect.equal(doubled(DoubledInput), expected: ExpectedDoubled)
end 'doubling answers past a dropped result'
