typealias Tally = int(0 to 1000)

let Limit = 3

function first() returns Tally
	return 1
end 'first'

function main() returns ExitCode
	for i in try first() otherwise 0 upto Limit 'each'
		print("{i}\n")
	end 'each'

	for j in try first() otherwise 0 to Limit 'every'
		print("{j}\n")
	end 'every'

	return 0
end 'main'
