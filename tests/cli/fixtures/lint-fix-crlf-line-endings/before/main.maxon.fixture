typealias Tally = int(0 to 1000)

let AnnouncedInput = 4

function announced(n Tally) returns Tally
	print("announcing {n}\n")
	return n
end 'announced'

// Doubles a tally.
// Nothing calls it.
function doubled(n Tally) returns Tally
	return n * 2
end 'doubled'

function tripled(n Tally) returns Tally
	return n * 3
end 'tripled'

function main() returns ExitCode
	tripled(AnnouncedInput)
	announced(AnnouncedInput)
	return 0 if tripled(AnnouncedInput) > AnnouncedInput else 1
end 'main'
