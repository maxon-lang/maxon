typealias Integer = int(i64.min to i64.max)
typealias IntVector = FixedArray with 3 Integer

enum SearchError implements Error
	absent
end 'SearchError'

function firstAbove(values IntVector, floor Integer) returns Integer throws SearchError
	for value in values 'each'
		if value > floor 'hit'
			return value
		end 'hit'
	end 'each'

	throw SearchError.absent
end 'firstAbove'

function announce(found Integer) returns Integer
	print("{found}\n")
	return found
end 'announce'

function main() returns ExitCode
	let values = IntVector.create()
	values.set(0, value: 4)
	values.set(1, value: 5)
	values.set(2, value: 6)

	let found = try firstAbove(values, floor: 3) otherwise return 1
	_ = announce(found)
	return 0
end 'main'
