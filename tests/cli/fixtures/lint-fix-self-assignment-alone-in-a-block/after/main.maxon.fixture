typealias Tally = int(0 to 1000)

let CountedInput = 0

function ifCounted(n Tally, flag bool) returns Tally
	var total = n
	total = total + 1

	if flag 'flagged'
		total = total
	end 'flagged'

	return total
end 'ifCounted'

function elseCounted(n Tally, flag bool) returns Tally
	var total = n

	if flag 'flagged'
		total = total + 1
	end 'flagged' else 'unflagged'
		total = total
	end 'unflagged'

	return total
end 'elseCounted'

function whileCounted(n Tally, flag bool) returns Tally
	var total = n
	total = total + 1

	while flag 'spinning'
		total = total
	end 'spinning'

	return total
end 'whileCounted'

function forCounted(n Tally) returns Tally
	var total = n
	total = total + 1

	for _ in 0 upto n 'eachTally'
		total = total
	end 'eachTally'

	return total
end 'forCounted'

function main() returns ExitCode
	let total = ifCounted(CountedInput, flag: false) + elseCounted(CountedInput, flag: true) + whileCounted(CountedInput, flag: false) + forCounted(CountedInput)
	return total as ExitCode
end 'main'
