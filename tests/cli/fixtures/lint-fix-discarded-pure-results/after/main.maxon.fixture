typealias Tally = int(0 to 1000)

let SplitInput = 4

function doubled(n Tally) returns Tally
	return n * 2
end 'doubled'

function split(n Tally) returns (Tally, Tally)
	return (n, n + 1)
end 'split'

function main() returns ExitCode
	let (low, high) = split(SplitInput)
	return 0 if doubled(low) < high else 1
end 'main'
