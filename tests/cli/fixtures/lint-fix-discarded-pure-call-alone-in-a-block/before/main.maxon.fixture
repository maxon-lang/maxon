typealias Tally = int(0 to 1000)

let ConsideredInput = 0

function doubled(n Tally) returns Tally
	return n * 2
end 'doubled'

function considered(n Tally, flag bool) returns Tally
	if flag 'flagged'
		doubled(n)
	end 'flagged' else 'unflagged'
		doubled(n)
	end 'unflagged'

	while flag 'spinning'
		doubled(n)
	end 'spinning'

	for i in 0 upto n 'eachTally'
		doubled(i)
	end 'eachTally'

	return n
end 'considered'

function main() returns ExitCode
	return considered(ConsideredInput, flag: false) as ExitCode
end 'main'
