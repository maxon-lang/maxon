typealias Tally = int(0 to 1000)

let Score = 5

function graded(score Tally) returns String
	let grade = match score 'band'
		7 gives "seven"
		7 gives "again"
		default gives "other"
	end 'band'

	return grade
end 'graded'

function main() returns ExitCode
	print("{graded(Score)}\n")
	return 0
end 'main'
