typealias Tally = int(0 to 1000)
typealias TallyArray = Array with Tally

function code() returns Tally
	return 3
end 'code'

function items() returns TallyArray
	return TallyArray from [1, 2]
end 'items'

function main() returns ExitCode
	match code() 'c'
		3 then print("three\n")
		default then print("other\n")
	end 'c'

	for x in items() 'each'
		print("{x}\n")
	end 'each'

	return 0
end 'main'
