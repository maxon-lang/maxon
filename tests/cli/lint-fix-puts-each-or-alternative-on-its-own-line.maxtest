let LintFixPackedOrChainFixture = "lint-fix-packed-or-chain"
let LintFixPackedOrChainFindings = 1

test 'lint --fix breaks an or-chain packed on one line after its or, at the indentation of the arm, and the program still runs'
	requireHeldOutsideCheckout(LintFixPackedOrChainFixture, check: lintFixRunningCase(LintFixPackedOrChainFixture, findings: LintFixPackedOrChainFindings))
end 'lint --fix breaks an or-chain packed on one line after its or, at the indentation of the arm, and the program still runs'
