let AnEnumOfMoreCasesThanSixteenBitsCanNumberIsRefusedCaseDirName = "declaration-limit-cases"
let AnEnumOfMoreCasesThanSixteenBitsCanNumberIsRefusedRefusal = "more than 65535 cases"

test 'an enum that declares 65,536 cases is refused where the 65,536th is declared'
	try requireDeclarationRefused(AnEnumOfMoreCasesThanSixteenBitsCanNumberIsRefusedCaseDirName, source: enumCasesSource(), refusal: AnEnumOfMoreCasesThanSixteenBitsCanNumberIsRefusedRefusal)
end 'an enum that declares 65,536 cases is refused where the 65,536th is declared'

function enumCasesSource() returns String
	var text = "{DeclarationPrelude}enum Big\n"

	for i in 0 upto DeclaredMemberCount 'eachCase'
		text.append("\tc{i}\n")
	end 'eachCase'

	text.append("end 'Big'\n\n{DeclarationMain}")
	return text
end 'enumCasesSource'
