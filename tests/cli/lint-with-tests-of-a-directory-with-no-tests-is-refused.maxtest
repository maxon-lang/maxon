let LintWithTestsOfNoTestsCaseDirName = "lint-with-tests-of-no-tests"
let LintWithTestsOfNoTestsFixture = "lint-clean"
let LintWithTestsOfNoTestsOption = "--tests"
let LintWithTestsOfNoTestsDirectory = "."
let LintWithTestsOfNoTestsWords = "no `test` declarations found under"

test 'lint --tests of a directory holding no test declaration is refused, saying so'
	requireHeldOutsideCheckout(LintWithTestsOfNoTestsCaseDirName, check: LintUsageRefusalCase.of(LintWithTestsOfNoTestsFixture, arguments: [LintWithTestsOfNoTestsOption, LintWithTestsOfNoTestsDirectory], words: [LintWithTestsOfNoTestsWords]))
end 'lint --tests of a directory holding no test declaration is refused, saying so'
