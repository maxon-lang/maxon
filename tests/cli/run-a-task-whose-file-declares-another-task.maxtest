let RunATaskWhoseFileDeclaresAnotherTaskCaseDirName = "run-a-task-whose-file-declares-another-task"
let RunATaskWhoseFileDeclaresAnotherTaskTaskFileName = "tasks.maxtasks"

let RunATaskWhoseFileDeclaresAnotherTaskTasksSource = "export typealias ExitCode = int(0 to 255)\n\nexport function report() returns ExitCode\n\tprint(\"reported\\n\")\n\treturn 7\nend 'report'\n\nexport function tidy() returns ExitCode\n\treturn 0\nend 'tidy'\n"

test 'a task runs while its file declares another task nothing calls'
	let dir = freshCaseDir(RunATaskWhoseFileDeclaresAnotherTaskCaseDirName)
	let tasks = dir.join(RunATaskWhoseFileDeclaresAnotherTaskTaskFileName)
	writeStagedFile(tasks, content: RunATaskWhoseFileDeclaresAnotherTaskTasksSource)

	let ran = spawnCompiler([RunCommandWord, "report"], staged: dir)
	let said = "It wrote to stdout: {ran.stdout} and to stderr: {ran.stderr}"

	Expect.equal(ran.exitCode(), expected: TaskExitCode, message: "`maxon {RunCommandWord} report` did not exit with the code the task returned. `tidy` is a task of the same file, which the runner enters by name exactly as it entered `report`, so it is no unused export. {said}")
end 'a task runs while its file declares another task nothing calls'
