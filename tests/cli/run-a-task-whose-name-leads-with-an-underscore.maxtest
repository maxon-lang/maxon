let RunATaskWhoseNameLeadsWithAnUnderscoreCaseDirName = "run-a-task-whose-name-leads-with-an-underscore"
let ListedWord = "_warm-up"
let RunATaskWhoseNameLeadsWithAnUnderscoreTaskExitCode = 5
let RunATaskWhoseNameLeadsWithAnUnderscoreTaskGreeting = "the warm-up task spoke"

let RunATaskWhoseNameLeadsWithAnUnderscoreTasksSource = "export function _warm_up() returns ExitCode\n\tprint(\"the warm-up task spoke\\n\")\n\treturn 5\nend '_warm_up'\n"

test 'a task whose name leads with an underscore is listed by a word that runs it'
	let dir = freshCaseDir(RunATaskWhoseNameLeadsWithAnUnderscoreCaseDirName)
	writeStagedFile(dir.join(TaskFileName), content: RunATaskWhoseNameLeadsWithAnUnderscoreTasksSource)

	let listed = spawnCompiler([RunCommandWord], staged: dir)
	let listedSaid = "It wrote to stdout: {listed.stdout} and to stderr: {listed.stderr}"

	Expect.equal(listed.exitCode(), expected: 0, message: "a bare `maxon {RunCommandWord}` beside `{TaskFileName}` did not succeed. {listedSaid}")
	Expect.contains(listed.stdout, needle: ListedWord, message: "the listing did not offer `{ListedWord}`: a leading `_` stays one, because a word leading with `-` is read as an option. {listedSaid}")

	let ran = spawnCompiler([RunCommandWord, ListedWord], staged: dir)
	let ranSaid = "It wrote to stdout: {ran.stdout} and to stderr: {ran.stderr}"

	Expect.equal(ran.exitCode(), expected: RunATaskWhoseNameLeadsWithAnUnderscoreTaskExitCode, message: "`maxon {RunCommandWord} {ListedWord}`, the word the listing offered, did not run `_warm_up`. {ranSaid}")
	Expect.contains(ran.stdout, needle: RunATaskWhoseNameLeadsWithAnUnderscoreTaskGreeting, message: "the task's own stdout did not reach the caller. {ranSaid}")

	discardStagedDir(dir)
end 'a task whose name leads with an underscore is listed by a word that runs it'
