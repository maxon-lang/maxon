// wasm-build-without-tools-is-an-error-not-a-panic.maxtest - a wasm32-wasi build that cannot find the
// `wasm-tools` it wraps the core module with is an ordinary error: exit 1, a message naming what is missing,
// and no panic.
//
// ⛔ **THE COMPILER AND ITS WORKING DIRECTORY ARE BOTH OUTSIDE THE CHECKOUT**, because the checkout holds
// `vendor/` and the driver walks up to it. An install-shaped copy is used rather than this checkout's
// binary, so a lookup anchored at the compiler's own image finds no `vendor/` either.

let CaseDirName = "wasm-build-without-tools"
let WorkDirName = "work"
let OutputStem = "main"
let WasmExtension = ".wasm"
let Source = "function main() returns ExitCode\n\treturn 0\nend 'main'\n"

let MissingToolWording = "wasm-tools"
let PanicWording = "panic"

test 'a wasm build without wasm-tools is an error, not a panic'
	requireHeldInAnInstallOutsideCheckout(CaseDirName, check: AnErrorNotAPanic.create())
end 'a wasm build without wasm-tools is an error, not a panic'

type AnErrorNotAPanic implements OutsideCheckoutCase
	static function create() returns AnErrorNotAPanic
		return Self{}
	end 'create'

	export function requireHeldIn(dir FilePath) throws TestFailure
		let work = stagingDir(dir.join(WorkDirName).toString())

		let sourcePath = work.join(StagedProgramFileName)
		writeStagedFile(sourcePath, content: Source)

		let output = work.join(OutputStem)
		let build = spawnCompiler([BuildCommandWord, sourcePath.toString(), "{OutputOptionPrefix}{output.toString()}", WasmTargetOption], binary: installedCompilerIn(dir), staged: work)
		let said = "It wrote to stdout: {build.stdout} and to stderr: {build.stderr}"

		try Expect.equal(build.exitCode(), expected: 1, message: "a wasm build with no `wasm-tools` anywhere exited {build.exitCode()}, where an ordinary error exits 1. {said}")
		try Expect.contains(build.stderr, needle: MissingToolWording, message: "a wasm build with no `wasm-tools` did not name what is missing. {said}")
		try Expect.isFalse(build.stderr.toLower().contains(PanicWording), message: "a wasm build with no `wasm-tools` panicked; a missing tool is the environment, not a compiler fault. {said}")
		try Expect.isFalse(File.exists(work.join("{OutputStem}{WasmExtension}")), message: "a wasm build with no `wasm-tools` still wrote a module. {said}")
	end 'requireHeldIn'
end 'AnErrorNotAPanic'
