let LintForATargetOfAManifestCaseDirName = "lint-for-a-target-of-a-manifest"
let LintForATargetOfAManifestFixture = "lint-manifest-program-clean"
let LintForATargetOfAManifestManifest = "app.maxproj"
let LintForATargetOfAManifestWords = "compiled for the host that runs it"

test 'lint --target= of a manifest file is refused as a usage error and lints nothing'
	requireHeldOutsideCheckout(LintForATargetOfAManifestCaseDirName, check: LintUsageRefusalCase.of(LintForATargetOfAManifestFixture, arguments: [WasmTargetOption, LintForATargetOfAManifestManifest], words: [LintForATargetOfAManifestWords, TargetOptionPrefix, LintForATargetOfAManifestManifest]))
end 'lint --target= of a manifest file is refused as a usage error and lints nothing'
