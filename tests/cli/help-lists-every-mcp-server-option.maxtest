let McpServerOptions = ["--dev", "--http", "--idle-timeout", "--max-sessions", "--exit-on-stdin-eof"]

test 'help mcp-server lists every option the parser accepts'
	let run = runHelpFor(McpServerCommandWord)

	let observedExit = run.exitCode() as AssertedInt
	try Expect.equal(observedExit, expected: 0, message: "`maxon {HelpCommandWord} {McpServerCommandWord}` was refused. It said: {run.stdout}{run.stderr}")

	var undocumented = ListedWordArray.create()

	for option in McpServerOptions 'eachOption'
		if not run.stdout.contains(option) 'unlisted'
			undocumented.push(option)
		end 'unlisted'
	end 'eachOption'

	try Expect.isEmpty(listed(undocumented), message: "`maxon {HelpCommandWord} {McpServerCommandWord}` does not list these options the parser accepts: {listed(undocumented)}. It said: {run.stdout}")
end 'help mcp-server lists every option the parser accepts'
