let LintReportsAnUnusedExportCaseDirName = "lint-reports-an-unused-export"
let LintReportsAnUnusedExportFixture = "lint-unused-export"
let LintReportsAnUnusedExportSite = "helper.maxon:1:17"
let LintReportsAnUnusedExportMessage = "exported function 'answer' is never referenced outside its declaring directory"

test 'lint reports an export only its own directory names and writes no executable'
	let expected = ExpectedDiagnostic.at(UnusedExportCode, site: LintReportsAnUnusedExportSite, message: LintReportsAnUnusedExportMessage)
	requireHeldOutsideCheckout(LintReportsAnUnusedExportCaseDirName, check: LintRefusalCase.reporting(LintReportsAnUnusedExportFixture, diagnostic: expected))
end 'lint reports an export only its own directory names and writes no executable'
