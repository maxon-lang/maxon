let LintFixTryInConditionalFixture = "lint-fix-try-in-a-conditional-expression"
let LintFixTryInConditionalFindings = 1
let LintFixTryInConditionalPrinted = "1\n"

test 'lint --fix drops a try and its otherwise value from the condition of a conditional expression and keeps its else, and the program prints what it printed'
	requireHeldOutsideCheckout(LintFixTryInConditionalFixture, check: lintFixRunningCase(LintFixTryInConditionalFixture, findings: LintFixTryInConditionalFindings, printed: LintFixPrinted.exactly(LintFixTryInConditionalPrinted)))
end 'lint --fix drops a try and its otherwise value from the condition of a conditional expression and keeps its else, and the program prints what it printed'
