// build-dot-without-output-names-the-directory.maxtest - `maxon build .` with no `--output=`
// names the executable for the directory `.` is, never `..exe` and never for a source file inside it.
//
// Staged outside the checkout: a build without `--output=` inside it would take the checkout's tree
// lock.

let CaseDirName = "build-dot-without-output"
let AppDirName = "app"
let CurrentDirectorySpelling = "."
let MainSourceFileName = "zeta.maxon"
let MainSourceStem = "zeta"
let MainSource = "function main() returns ExitCode\n\treturn 0\nend 'main'\n"

test 'a directory built as . without --output= is named for the directory'
	requireHeldOutsideCheckout(CaseDirName, check: DotNamedForTheDirectory.create())
end 'a directory built as . without --output= is named for the directory'

type DotNamedForTheDirectory implements OutsideCheckoutCase
	static function create() returns DotNamedForTheDirectory
		return Self{}
	end 'create'

	export function requireHeldIn(dir FilePath) throws TestFailure
		let app = createdStagedDirectory(dir.join(AppDirName))

		writeStagedFile(app.join(MainSourceFileName), content: MainSource)

		let build = runDriver([BuildCommandWord, CurrentDirectorySpelling], workingDirectory: app)
		let said = "It wrote to stdout: {build.stdout} and to stderr: {build.stderr}"
		try Expect.equal(build.exitCode() as AssertedInt, expected: 0, message: "a one-file directory did not build as `.`. {said}")

		let named = app.join("{AppDirName}{executableSuffix()}")
		try Expect.isTrue(File.exists(named), message: "`maxon build .` in {app.toString()} wrote no {named.toString()}. {said}")
		try Expect.isFalse(File.exists(app.join("{MainSourceStem}{executableSuffix()}")), message: "`maxon build .` named its executable for a source file. {said}")
	end 'requireHeldIn'
end 'DotNamedForTheDirectory'
