let LintFixUnreachableLiteralFixture = "lint-fix-unreachable-multi-line-literal"
let LintFixUnreachableLiteralFindings = 1
let LintFixUnreachableLiteralPrinted = "done\n"

test 'lint --fix deletes every line of an unreachable statement whose byte literal continues at the start of the next line, and the program prints what it printed'
	requireHeldOutsideCheckout(LintFixUnreachableLiteralFixture, check: lintFixRunningCase(LintFixUnreachableLiteralFixture, findings: LintFixUnreachableLiteralFindings, printed: LintFixPrinted.exactly(LintFixUnreachableLiteralPrinted)))
end 'lint --fix deletes every line of an unreachable statement whose byte literal continues at the start of the next line, and the program prints what it printed'
