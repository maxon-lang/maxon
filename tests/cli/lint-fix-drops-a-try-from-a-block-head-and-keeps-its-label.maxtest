let LintFixTryInBlockHeadFixture = "lint-fix-try-in-a-block-head"
let LintFixTryInBlockHeadFindings = 2
let LintFixTryInBlockHeadPrinted = "three\n1\n2\n"

test 'lint --fix drops a try and its otherwise value from the head of a match and of a for and keeps each label, and the program prints what it printed'
	requireHeldOutsideCheckout(LintFixTryInBlockHeadFixture, check: lintFixRunningCase(LintFixTryInBlockHeadFixture, findings: LintFixTryInBlockHeadFindings, printed: LintFixPrinted.exactly(LintFixTryInBlockHeadPrinted)))
end 'lint --fix drops a try and its otherwise value from the head of a match and of a for and keeps each label, and the program prints what it printed'
