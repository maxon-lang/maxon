let LintFixSelfAssignmentFixture = "lint-fix-self-assignment"
let LintFixSelfAssignmentFindings = 1
let LintFixSelfAssignmentCode = "E3067"
let LintFixSelfAssignmentSite = "main.maxon:6:2"
let LintFixSelfAssignmentMessage = "expected a function call"

test 'lint --fix deletes a self-assignment, then leaves a discarded expression, which has no single fix, and reports it'
	let outcome = lintFixRefusedWith(ExpectedDiagnostic.at(LintFixSelfAssignmentCode, site: LintFixSelfAssignmentSite, message: LintFixSelfAssignmentMessage))
	requireHeldOutsideCheckout(LintFixSelfAssignmentFixture, check: LintFixCase.of(LintFixSelfAssignmentFixture, arguments: [AppDirName], fixed: lintFixFixedFiles(LintFixAppMainFile, findings: LintFixSelfAssignmentFindings), outcome: outcome))
end 'lint --fix deletes a self-assignment, then leaves a discarded expression, which has no single fix, and reports it'
