let LibraryCacheFunctionAliasCaseDirName = "library-cache-alias-function"
let FunctionAliasFirstProgramSource = "typealias Tally = int(0 to 1000)\ntypealias CombTableBuild = function() returns Tally\n\nfunction make() returns CombTableBuild\n\treturn function() gives 5\nend 'make'\n\nfunction main() returns ExitCode\n\tlet seed = 21\n\tlet words = \"seed \{seed\} grows\".split(\" \")\n\twords.insert(0, value: \"then\")\n\tlet word = try words.get(2) otherwise \"\"\n\tlet length = word.byteLength() as Tally\n\tlet build = make()\n\tlet extra = build()\n\treturn (length + seed + extra) as ExitCode\nend 'main'\n"
let FunctionAliasFirstProgramExitCode = 28
let FunctionAliasSecondProgramSource = "typealias Tally = int(0 to 1000)\ntypealias CombTableBuild = function(n Tally) returns Tally\n\nfunction make() returns CombTableBuild\n\treturn function(n) gives n + 5\nend 'make'\n\nfunction main() returns ExitCode\n\tlet seed = 21\n\tlet words = \"seed \{seed\} grows\".split(\" \")\n\twords.insert(0, value: \"then\")\n\tlet word = try words.get(2) otherwise \"\"\n\tlet length = word.byteLength() as Tally\n\tlet build = make()\n\tlet extra = build(2)\n\treturn (length + seed + extra) as ExitCode\nend 'main'\n"
let FunctionAliasSecondProgramExitCode = 30

test 'a program declaring a function alias the library declares is served the library parses of another program declaring that alias'
	requireHeldOutsideCheckout(LibraryCacheFunctionAliasCaseDirName, check: BuiltInSequenceMatchesCold.create([SequencedProgram.create(FunctionAliasFirstProgramSource, exitCode: FunctionAliasFirstProgramExitCode, subject: "a program that declares a `CombTableBuild` function alias of its own, built after a program that declares none", expectation: LibraryCacheExpectation.loadsTheBaselineAndParsesTheLibrary), SequencedProgram.create(FunctionAliasSecondProgramSource, exitCode: FunctionAliasSecondProgramExitCode, subject: "a program that declares a `CombTableBuild` function alias of another shape than the `CombTableBuild` of the program before it", expectation: LibraryCacheExpectation.servedEveryParse)]))
end 'a program declaring a function alias the library declares is served the library parses of another program declaring that alias'
