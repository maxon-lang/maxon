let AnEmptyOptionValueIsRefusedCaseDirName = "an-empty-option-value-is-refused"
let InvalidValueRefusal = "invalid option value: "

test 'an option stated with an empty value is refused rather than read as unstated'
	let dir = freshCaseDir(AnEmptyOptionValueIsRefusedCaseDirName)
	let source = dir.join(StagedProgramFileName)
	writeStagedFile(source, content: MainSource)

	for option in [OutputOptionPrefix, MetricsOptionPrefix, TargetOptionPrefix] 'eachOption'
		let build = spawnCompiler([BuildCommandWord, source.toString(), option], staged: dir)
		let said = "It wrote to stdout: {build.stdout} and to stderr: {build.stderr}"
		Expect.equal(build.exitCode(), expected: 1, message: "`maxon {BuildCommandWord} main.maxon {option}` did not exit 1. {said}")
		Expect.contains(build.stderr, needle: "{InvalidValueRefusal}{option}", message: "`maxon {BuildCommandWord} main.maxon {option}` did not refuse the empty value. {said}")
	end 'eachOption'

	discardStagedDir(dir)
end 'an option stated with an empty value is refused rather than read as unstated'
