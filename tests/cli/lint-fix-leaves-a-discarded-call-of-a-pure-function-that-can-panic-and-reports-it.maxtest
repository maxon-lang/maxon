let LintFixPureThatPanicsCaseDirName = "lint-fix-pure-panics"
let LintFixPureThatPanicsFixture = "lint-fix-pure-call-that-can-panic"
let LintFixPureThatPanicsSite = "main.maxon:15:2"
let LintFixPureThatPanicsMessage = "result of pure function 'checked' must be used"

test 'lint --fix leaves a discarded call of a pure function that can panic, whose deletion would remove the abort, and reports it'
	let outcome = lintFixRefusedWith(ExpectedDiagnostic.at(DiscardedPureResultCode, site: LintFixPureThatPanicsSite, message: LintFixPureThatPanicsMessage))
	requireHeldOutsideCheckout(LintFixPureThatPanicsCaseDirName, check: LintFixCase.of(LintFixPureThatPanicsFixture, arguments: [AppDirName], fixed: LintFixedFileArray.create(0), outcome: outcome))
end 'lint --fix leaves a discarded call of a pure function that can panic, whose deletion would remove the abort, and reports it'
