let LintWithTestsDiscardedCaseDirName = "lint-with-tests-discarded"
let LintWithTestsDiscardedFixture = "lint-tests-discarded-pure-result"
let LintWithTestsDiscardedSite = "use.maxtest:5:2"
let LintWithTestsDiscardedMessage = "result of pure function 'doubled' must be used"

test 'lint --tests reports a pure result a test file drops, and lint without it and maxon test do not'
	let findings = ExpectedDiagnosticArray.create(0)
	findings.push(ExpectedDiagnostic.at(DiscardedPureResultCode, site: LintWithTestsDiscardedSite, message: LintWithTestsDiscardedMessage))
	requireHeldOutsideCheckout(LintWithTestsDiscardedCaseDirName, check: LintOfATestProjectCase.of(LintWithTestsDiscardedFixture, findings: findings))
end 'lint --tests reports a pure result a test file drops, and lint without it and maxon test do not'
