#if not os(Windows)
	let CycleCaseDirName = "build-link-cycle"
	let CycleLibraryDirName = "lib"
	let CycleLinkName = "back"
	let CycleMainSource = "function main() returns ExitCode\n\treturn answer()\nend 'main'\n"
	let CycleLibrarySource = "export function answer() returns ExitCode\n\treturn 0\nend 'answer'\n"

	test 'a project holding a link back to its own root builds, each file counted once'
		requireHeldOutsideCheckout(CycleCaseDirName, check: LinkBackToTheRootBuilds.create())
	end 'a project holding a link back to its own root builds, each file counted once'

	type LinkBackToTheRootBuilds implements OutsideCheckoutCase
		static function create() returns LinkBackToTheRootBuilds
			return Self{}
		end 'create'

		export function requireHeldIn(dir FilePath) throws TestFailure
			let library = stagingDir(dir.join(CycleLibraryDirName).toString())

			writeStagedFile(dir.join(StagedProgramFileName), content: CycleMainSource)
			writeStagedFile(library.join("Answer.maxon"), content: CycleLibrarySource)

			let link = library.join(CycleLinkName)
			_ = runSystemTool("ln", arguments: ["-s", "..", link.toString()], what: "`ln -s` making a link from a subdirectory back to the project root")

			let build = spawnCompiler([BuildCommandWord, "."], staged: dir)

			try File.delete(link) otherwise panic("the gate could not run — could not remove the link {link.toString()}.")

			let said = "It wrote to stdout: {build.stdout} and to stderr: {build.stderr}"

			try Expect.equal(build.exitCode(), expected: 0, message: "a project holding a link from `{CycleLibraryDirName}/` back to its own root did not build: the walk followed the cycle. {said}")

			let named = dir.join("{dir.filename()}{executableSuffix()}")
			try Expect.isTrue(File.exists(named), message: "the build exited 0 and wrote no {named.toString()}. {said}")
		end 'requireHeldIn'
	end 'LinkBackToTheRootBuilds'
#endif
