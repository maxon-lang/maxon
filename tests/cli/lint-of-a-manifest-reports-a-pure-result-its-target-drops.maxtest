let LintOfAManifestDroppingCaseDirName = "lint-of-a-manifest-dropping"
let LintOfAManifestDroppingFixture = "lint-manifest-program-discarded-pure-result"
let LintOfAManifestDroppingFile = "app.maxproj"
let LintOfAManifestDroppingSite = "app.maxproj:10:2"
let LintOfAManifestDroppingMessage = "result of pure function 'doubled' must be used"
let LintOfAManifestDroppingBuiltExit = 0

test 'lint of a manifest file reports a pure result its target drops, and nothing a manifest program does not owe'
	let findings = ExpectedDiagnosticArray.create(0)
	findings.push(ExpectedDiagnostic.at(DiscardedPureResultCode, site: LintOfAManifestDroppingSite, message: LintOfAManifestDroppingMessage))
	requireHeldOutsideCheckout(LintOfAManifestDroppingCaseDirName, check: LintOfAManifestProgramCase.of(LintOfAManifestDroppingFixture, manifest: LintOfAManifestDroppingFile, proof: [BuildCommandWord], provedExit: LintOfAManifestDroppingBuiltExit, findings: findings))
end 'lint of a manifest file reports a pure result its target drops, and nothing a manifest program does not owe'
