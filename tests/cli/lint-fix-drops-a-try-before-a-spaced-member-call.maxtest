let LintFixTrySpacedMemberFixture = "lint-fix-try-before-a-spaced-member-call"
let LintFixTrySpacedMemberFindings = 1
let LintFixTrySpacedMemberPrinted = "3\n"

test 'lint --fix drops a try and its otherwise value from a member call written with a space before its dot, and the program prints what it printed'
	requireHeldOutsideCheckout(LintFixTrySpacedMemberFixture, check: lintFixRunningCase(LintFixTrySpacedMemberFixture, findings: LintFixTrySpacedMemberFindings, printed: LintFixPrinted.exactly(LintFixTrySpacedMemberPrinted)))
end 'lint --fix drops a try and its otherwise value from a member call written with a space before its dot, and the program prints what it printed'
