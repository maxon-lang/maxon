let LintFixDiscardedPureCaseDirName = "lint-fix-discarded-pure"
let LintFixDiscardedPureFixture = "lint-fix-discarded-pure-results"
let LintFixDiscardedPureFile = "app/main.maxon"
let LintFixDiscardedPureFindings = 3

test 'lint --fix deletes a bare pure call, a discarded pure call and an all-discard destructure of a pure result'
	let fixed = lintFixFixedFiles(LintFixDiscardedPureFile, findings: LintFixDiscardedPureFindings)
	requireHeldOutsideCheckout(LintFixDiscardedPureCaseDirName, check: LintFixCase.of(LintFixDiscardedPureFixture, arguments: [AppDirName], fixed: fixed, outcome: LintFixOutcome.linted(AppDirName)))
end 'lint --fix deletes a bare pure call, a discarded pure call and an all-discard destructure of a pure result'
