// cache-reports-every-root.test.maxon — bare `maxon cache` names EVERY root this host keeps a cache under,
// and marks the one a run will use.
//
// ⭐⭐ **A CACHE UNDER A LOWER-RANKED CANDIDATE IS UNREACHABLE AND STILL ON DISK.** The roster is consulted
// in order and the first root that resolves wins, so every build made before `MAXON_RUN_CACHE_ROOT` was set
// sits under the home directory where nothing looks again — and a report stopping at the winner would never
// show the reader the disk it is holding.
//
// ⛔ **AND NAMING BOTH IS NOT ENOUGH.** Two directories listed with nothing to tell them apart leaves the
// reader unable to say which one the next `maxon run` will fill, which is the question the roster's order
// exists to answer.

let CaseDirName = "cache-reports-every-root"
let HomeDirName = "home"

// What the report says of the root a run uses. Respelled here because this corpus is a separate program and
// cannot read the driver's own constants.
let InUseWords = "in use"

test 'bare cache names every cache root and marks the one a run uses'
	let dir = freshCaseDir(CaseDirName)
	let cacheRoot = cacheRootIn(dir)
	let home = dir.join(HomeDirName)

	publishCachedBuild(dir, cacheRoot: cacheRoot)
	publishCachedBuildInHome(dir, home: home)

	let owned = cacheRoot.join(CacheVendorDirName)
	let homeOwned = homeCacheRoot(home)

	var naming = EnvMap.create()
	naming.upsert(CacheRootVariable, value: cacheRoot.toString())
	naming.upsert(HomeDirectoryVariable, value: home.toString())

	let reported = runWithCacheRoots([CacheCommandWord], naming: naming, workingDirectory: dir)
	let said = "It wrote to stdout: {reported.stdout} and to stderr: {reported.stderr}"

	Expect.equal(reported.exitCode() as AssertedInt, expected: 0, message: "`maxon {CacheCommandWord}` did not succeed over two roots that each held a build. {said}")

	let inUse = try reportedStateOf(reported.stdout, directory: owned) otherwise panic("{CaseDirName}: `maxon {CacheCommandWord}` named no line for {owned.toString()}, the root {CacheRootVariable} names and the one the next run would use. {said}")

	let stranded = try reportedStateOf(reported.stdout, directory: homeOwned) otherwise panic("{CaseDirName}: `maxon {CacheCommandWord}` named no line for {homeOwned.toString()}. {CacheRootVariable} outranks {HomeDirectoryVariable}, so a build made before the override was set is stranded there and a report that omits it is the reader's last chance to see it. {said}")

	Expect.contains(inUse, needle: InUseWords, message: "`maxon {CacheCommandWord}` said `{inUse}` of {owned.toString()} - the root the next run will fill - without marking it as the one in use. A reader cannot tell the roots apart. {said}")

	Expect.isFalse(stranded.contains(InUseWords), message: "`maxon {CacheCommandWord}` marked {homeOwned.toString()} as the root in use, saying `{stranded}` of it. {CacheRootVariable} outranks {HomeDirectoryVariable}, so nothing will be cached there again. {said}")
end 'bare cache names every cache root and marks the one a run uses'
