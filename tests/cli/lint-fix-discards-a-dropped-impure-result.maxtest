let LintFixDroppedImpureCaseDirName = "lint-fix-dropped-impure"
let LintFixDroppedImpureFixture = "lint-fix-dropped-impure-result"
let LintFixDroppedImpureFile = "app/main.maxon"
let LintFixDroppedImpureFindings = 1

test 'lint --fix discards a dropped impure result with _ = and then lints clean'
	let fixed = lintFixFixedFiles(LintFixDroppedImpureFile, findings: LintFixDroppedImpureFindings)
	requireHeldOutsideCheckout(LintFixDroppedImpureCaseDirName, check: LintFixCase.of(LintFixDroppedImpureFixture, arguments: [AppDirName], fixed: fixed, outcome: LintFixOutcome.linted(AppDirName)))
end 'lint --fix discards a dropped impure result with _ = and then lints clean'
