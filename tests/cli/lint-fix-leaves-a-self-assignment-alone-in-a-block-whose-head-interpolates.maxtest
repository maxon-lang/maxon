let LintFixInterpolatedHeadSelfCaseDirName = "lint-fix-interp-head-self"
let LintFixInterpolatedHeadSelfFixture = "lint-fix-self-assignment-under-an-interpolated-head"
let LintFixInterpolatedHeadSelfCode = "E3067"
let LintFixInterpolatedHeadSelfSite = "main.maxon:9:3"
let LintFixInterpolatedHeadSelfMessage = "self-assignment has no effect: 'total = total'"

test 'lint --fix leaves a self-assignment that is the only statement of a block whose head interpolates a string, beside a blank line, and reports it'
	let outcome = lintFixRefusedWith(ExpectedDiagnostic.at(LintFixInterpolatedHeadSelfCode, site: LintFixInterpolatedHeadSelfSite, message: LintFixInterpolatedHeadSelfMessage))
	requireHeldOutsideCheckout(LintFixInterpolatedHeadSelfCaseDirName, check: LintFixCase.of(LintFixInterpolatedHeadSelfFixture, arguments: [AppDirName], fixed: LintFixedFileArray.create(0), outcome: outcome))
end 'lint --fix leaves a self-assignment that is the only statement of a block whose head interpolates a string, beside a blank line, and reports it'
