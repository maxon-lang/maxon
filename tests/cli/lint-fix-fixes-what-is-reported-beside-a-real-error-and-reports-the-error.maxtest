let LintFixBesideAnErrorCaseDirName = "lint-fix-beside-an-error"
let LintFixBesideAnErrorFixture = "lint-fix-beside-a-real-error"
let LintFixBesideAnErrorFile = "app/main.maxon"
let LintFixBesideAnErrorFindings = 1
let LintFixBesideAnErrorCode = "E3004"
let LintFixBesideAnErrorSite = "broken.maxon:2:9"
let LintFixBesideAnErrorMessage = "call to undefined function 'undefinedHelper'"

test 'lint --fix fixes a dropped result reported beside a call to an undefined function, leaves that file alone and reports the error'
	let fixed = lintFixFixedFiles(LintFixBesideAnErrorFile, findings: LintFixBesideAnErrorFindings)
	let outcome = lintFixRefusedWith(ExpectedDiagnostic.at(LintFixBesideAnErrorCode, site: LintFixBesideAnErrorSite, message: LintFixBesideAnErrorMessage))
	requireHeldOutsideCheckout(LintFixBesideAnErrorCaseDirName, check: LintFixCase.of(LintFixBesideAnErrorFixture, arguments: [AppDirName], fixed: fixed, outcome: outcome))
end 'lint --fix fixes a dropped result reported beside a call to an undefined function, leaves that file alone and reports the error'
