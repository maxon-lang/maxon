let LintFixThrowsHandlerFixture = "lint-fix-try-block-with-a-throws-handler"
let LintFixThrowsHandlerFindings = 1
let LintFixThrowsHandlerPrinted = "second\n"

test 'lint --fix unwraps a try block whose body cannot throw and deletes its one-line otherwise throws handler with it, and the program prints what it printed'
	requireHeldOutsideCheckout(LintFixThrowsHandlerFixture, check: lintFixRunningCase(LintFixThrowsHandlerFixture, findings: LintFixThrowsHandlerFindings, printed: LintFixPrinted.exactly(LintFixThrowsHandlerPrinted)))
end 'lint --fix unwraps a try block whose body cannot throw and deletes its one-line otherwise throws handler with it, and the program prints what it printed'
