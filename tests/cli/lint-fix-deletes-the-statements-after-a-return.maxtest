let LintFixUnreachableStatementsFixture = "lint-fix-unreachable-statements"
let LintFixUnreachableStatementsFindings = 1

test 'lint --fix deletes every statement after a return to the end of its block, and the program still runs'
	requireHeldOutsideCheckout(LintFixUnreachableStatementsFixture, check: lintFixRunningCase(LintFixUnreachableStatementsFixture, findings: LintFixUnreachableStatementsFindings))
end 'lint --fix deletes every statement after a return to the end of its block, and the program still runs'
