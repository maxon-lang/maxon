let InternerCaseDirName = "interner-presize"
let InternerAppDirName = "app"

let InternerLogFlag = "--log=compiler:debug"

let InternerLinePrefix = "[CMP] DEBUG: typeNames "
let InternerNoRegrowthsSuffix = "regrowths 0"

let InternerShapeFileName = "shape.maxon"
let InternerLabelFileName = "label.maxon"

let InternerMainSource = "function main() returns ExitCode\n\tlet shape = Shape.create(3)\n\tlet label = Label.create(3)\n\n\tif label.rank == 3 and shape.side == 3 'matched'\n\t\treturn 0\n\tend 'matched'\n\n\treturn 1\nend 'main'\n"
let InternerShapeSource = "export typealias ShapeSide = int(0 to 4096)\n\nexport type Shape\n\texport var side as ShapeSide\n\n\texport static function create(side ShapeSide) returns Shape\n\t\treturn Shape\{side: side\}\n\tend 'create'\nend 'Shape'\n"
let InternerLabelSource = "export typealias LabelRank = int(0 to 4096)\n\nexport type Label\n\texport var rank as LabelRank\n\n\texport static function create(rank LabelRank) returns Label\n\t\treturn Label\{rank: rank\}\n\tend 'create'\nend 'Label'\n"

test 'the type-name interner is pre-sized and never regrows'
	requireHeldOutsideCheckout(InternerCaseDirName, check: InternerNeverRegrows.create())
end 'the type-name interner is pre-sized and never regrows'

type InternerNeverRegrows implements OutsideCheckoutCase
	static function create() returns InternerNeverRegrows
		return Self{}
	end 'create'

	export function requireHeldIn(dir FilePath) throws TestFailure
		let app = stagingDir(dir.join(InternerAppDirName).toString())

		writeStagedFile(app.join(StagedProgramFileName), content: InternerMainSource)
		writeStagedFile(app.join(InternerShapeFileName), content: InternerShapeSource)
		writeStagedFile(app.join(InternerLabelFileName), content: InternerLabelSource)

		let built = spawnCompiler([BuildCommandWord, InternerAppDirName, InternerLogFlag], staged: dir)
		let said = "It wrote to stderr: {built.stderr}"

		try Expect.equal(built.exitCode(), expected: 0, message: "a three-file directory did not build under {InternerLogFlag}. {said}")

		var seen = 0 as Count
		var regrown = ""

		for rawLine in built.stderr.split("\n") 'eachLine'
			let line = rawLine.trimEnd()

			if not line.startsWith(InternerLinePrefix) 'notOurs'
				continue
			end 'notOurs'

			seen = seen + 1

			if not line.endsWith(InternerNoRegrowthsSuffix) 'regrew'
				regrown.append("\n{line}")
			end 'regrew'
		end 'eachLine'

		try Expect.isTrue(seen >= 3, message: "{InternerLogFlag} printed {seen} lines starting `{InternerLinePrefix}`, and a three-file project interns type names in every one of its files, so there must be at least one per file. {said}")
		try Expect.isTrue(regrown.isEmpty(), message: "the type-name interner regrew for these files, so its pre-size heuristic did not hold: {regrown}")
	end 'requireHeldIn'
end 'InternerNeverRegrows'
