let LibraryCacheFreeFunctionNamedApplyCaseDirName = "library-cache-free-apply"
let FreeFunctionNamedApplyProgramSource = "typealias Tally = int(0 to 1000)\n\nfunction bumped(amount Tally) returns Tally\n\treturn amount + 1\nend 'bumped'\n\nfunction apply(amount Tally) returns Tally\n\treturn bumped(amount)\nend 'apply'\n\nfunction main() returns ExitCode\n\tlet seed = 21\n\tlet words = \"seed \{seed\} grows\".split(\" \")\n\twords.insert(0, value: \"then\")\n\tlet word = try words.get(2) otherwise \"\"\n\tlet length = word.byteLength() as Tally\n\tlet extra = apply(9)\n\treturn (length + seed + extra) as ExitCode\nend 'main'\n"
let FreeFunctionNamedApplyProgramExitCode = 33

test 'a program that adds a free function named apply whose body returns a call is served the library parses of the program before it'
	requireHeldOutsideCheckout(LibraryCacheFreeFunctionNamedApplyCaseDirName, check: BuiltInSequenceMatchesCold.create([SequencedProgram.create(FreeFunctionNamedApplyProgramSource, exitCode: FreeFunctionNamedApplyProgramExitCode, subject: "a program that adds a free function named `apply` whose body returns a call", expectation: LibraryCacheExpectation.servedEveryParse)]))
end 'a program that adds a free function named apply whose body returns a call is served the library parses of the program before it'
