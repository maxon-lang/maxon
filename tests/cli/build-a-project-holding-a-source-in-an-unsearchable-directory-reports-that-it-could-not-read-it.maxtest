#if not os(Windows)
	let UnsearchableCaseDirName = "build-unsearchable-directory"
	let UnsearchableDirName = "sealed"
	let UnsearchableSourceFileName = "locked.maxon"
	let UnsearchableMainSource = "function main() returns ExitCode\n\treturn 0\nend 'main'\n"
	let UnsearchableLockedSource = "module function locked() returns ExitCode\n\treturn 1\nend 'locked'\n"
	let UnsearchableMode = "444"
	let UnsearchableRestoredMode = "755"
	let UnsearchableWording = "could not read"

	test 'a project holding a source in a directory the process may list but not search is refused for reading it, not for identifying it'
		requireHeldOutsideCheckout(UnsearchableCaseDirName, check: UnsearchableSourceIsReportedAsUnreadable.create())
	end 'a project holding a source in a directory the process may list but not search is refused for reading it, not for identifying it'

	type UnsearchableSourceIsReportedAsUnreadable implements OutsideCheckoutCase
		static function create() returns UnsearchableSourceIsReportedAsUnreadable
			return Self{}
		end 'create'

		export function requireHeldIn(dir FilePath) throws TestFailure
			let sealed = stagingDir(dir.join(UnsearchableDirName).toString())

			writeStagedFile(dir.join(StagedProgramFileName), content: UnsearchableMainSource)
			writeStagedFile(sealed.join(UnsearchableSourceFileName), content: UnsearchableLockedSource)

			_ = runSystemTool("chmod", arguments: [UnsearchableMode, sealed.toString()], what: "`chmod` making {sealed.toString()} listable but not searchable")

			let build = spawnCompiler([BuildCommandWord, "."], staged: dir)

			_ = runSystemTool("chmod", arguments: [UnsearchableRestoredMode, sealed.toString()], what: "`chmod` restoring access to {sealed.toString()}")

			let said = "It wrote to stdout: {build.stdout} and to stderr: {build.stderr}"

			try Expect.equal(build.exitCode(), expected: 1, message: "a build over a source in an unsearchable directory did not fail with the driver's failure exit. {said}")
			try Expect.contains(build.stderr, needle: UnsearchableWording, message: "the build did not say it could not read {UnsearchableSourceFileName}. {said}")
			try Expect.contains(build.stderr, needle: UnsearchableSourceFileName, message: "the build did not name {UnsearchableSourceFileName}. {said}")
		end 'requireHeldIn'
	end 'UnsearchableSourceIsReportedAsUnreadable'
#endif
