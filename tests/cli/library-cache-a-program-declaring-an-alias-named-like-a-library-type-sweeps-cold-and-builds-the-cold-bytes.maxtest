let LibraryCacheAliasNamedLikeALibraryTypeCaseDirName = "library-cache-alias-like-library-type"
let AliasNamedLikeALibraryTypeFirstProgramSource = "typealias Tally = int(0 to 1000)\ntypealias Clock = int(0 to 500)\n\nfunction advanced(value Clock) returns Clock\n\treturn value + 2\nend 'advanced'\n\nfunction main() returns ExitCode\n\tlet seed = 21\n\tlet words = \"seed \{seed\} grows\".split(\" \")\n\twords.insert(0, value: \"then\")\n\tlet word = try words.get(2) otherwise \"\"\n\tlet length = word.byteLength() as Tally\n\tlet extra = advanced(7) as Tally\n\treturn (length + seed + extra) as ExitCode\nend 'main'\n"
let AliasNamedLikeALibraryTypeFirstProgramExitCode = 32

test 'a program declaring an alias named like a library type sweeps the library itself and builds the bytes a cold build writes'
	requireHeldOutsideCheckout(LibraryCacheAliasNamedLikeALibraryTypeCaseDirName, check: BuiltInSequenceMatchesCold.create([SequencedProgram.create(AliasNamedLikeALibraryTypeFirstProgramSource, exitCode: AliasNamedLikeALibraryTypeFirstProgramExitCode, subject: "a program that declares a `Clock` alias, the name of a library type", expectation: LibraryCacheExpectation.leavesTheBaselineUnused)]))
end 'a program declaring an alias named like a library type sweeps the library itself and builds the bytes a cold build writes'
