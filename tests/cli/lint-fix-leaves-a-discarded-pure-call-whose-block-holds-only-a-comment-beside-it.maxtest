let LintFixCommentBesidePureCaseDirName = "lint-fix-comment-beside-pure"
let LintFixCommentBesidePureFixture = "lint-fix-block-comment-beside-a-pure-call"
let LintFixCommentBesidePureSite = "main.maxon:12:3"
let LintFixCommentBesidePureMessage = "result of pure function 'doubled' must be used"

test 'lint --fix leaves a discarded pure call that is the only statement of its block beside a block comment, which is no statement, and reports it'
	let outcome = lintFixRefusedWith(ExpectedDiagnostic.at(DiscardedPureResultCode, site: LintFixCommentBesidePureSite, message: LintFixCommentBesidePureMessage))
	requireHeldOutsideCheckout(LintFixCommentBesidePureCaseDirName, check: LintFixCase.of(LintFixCommentBesidePureFixture, arguments: [AppDirName], fixed: LintFixedFileArray.create(0), outcome: outcome))
end 'lint --fix leaves a discarded pure call that is the only statement of its block beside a block comment, which is no statement, and reports it'
