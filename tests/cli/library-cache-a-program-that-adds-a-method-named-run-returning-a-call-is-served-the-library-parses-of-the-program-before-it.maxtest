let LibraryCacheMethodNamedRunCaseDirName = "library-cache-method-run"
let MethodNamedRunProgramSource = "typealias Tally = int(0 to 1000)\n\ntype Job\n\tlet weight as Tally\n\n\tstatic function create(weight Tally) returns Job\n\t\treturn Self\{weight: weight\}\n\tend 'create'\n\n\tfunction doubled() returns Tally\n\t\treturn self.weight * 2\n\tend 'doubled'\n\n\tfunction run() returns Tally\n\t\treturn self.doubled()\n\tend 'run'\nend 'Job'\n\nfunction main() returns ExitCode\n\tlet seed = 21\n\tlet words = \"seed \{seed\} grows\".split(\" \")\n\twords.insert(0, value: \"then\")\n\tlet word = try words.get(2) otherwise \"\"\n\tlet length = word.byteLength() as Tally\n\tlet extra = Job.create(3).run()\n\treturn (length + seed + extra) as ExitCode\nend 'main'\n"
let MethodNamedRunProgramExitCode = 29

test 'a program that adds a method named run whose body returns a call is served the library parses of the program before it'
	requireHeldOutsideCheckout(LibraryCacheMethodNamedRunCaseDirName, check: BuiltInSequenceMatchesCold.create([SequencedProgram.create(MethodNamedRunProgramSource, exitCode: MethodNamedRunProgramExitCode, subject: "a program that adds a type with a method named `run` whose body returns a call", expectation: LibraryCacheExpectation.servedEveryParse)]))
end 'a program that adds a method named run whose body returns a call is served the library parses of the program before it'
