let LintFixTryBlockLiteralFixture = "lint-fix-try-block-holding-a-multi-line-literal"
let LintFixTryBlockLiteralFindings = 1
let LintFixTryBlockLiteralPrinted = "first\n\t\tsecond\n"

test 'lint --fix unwraps a try block whose body cannot throw without re-indenting a line that begins inside a byte literal, and the program prints what it printed'
	requireHeldOutsideCheckout(LintFixTryBlockLiteralFixture, check: lintFixRunningCase(LintFixTryBlockLiteralFixture, findings: LintFixTryBlockLiteralFindings, printed: LintFixPrinted.exactly(LintFixTryBlockLiteralPrinted)))
end 'lint --fix unwraps a try block whose body cannot throw without re-indenting a line that begins inside a byte literal, and the program prints what it printed'
