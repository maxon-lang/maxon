let LintFixDuplicateMatchPatternFixture = "lint-fix-duplicate-match-pattern"
let LintFixDuplicateMatchPatternCode = "E2027"
let LintFixDuplicateMatchPatternSite = "main.maxon:8:3"
let LintFixDuplicateMatchPatternMessage = "duplicate pattern in match: '7'"

test 'lint --fix leaves a duplicate match pattern, which has no single fix, and reports it as lint does'
	let outcome = lintFixRefusedWith(ExpectedDiagnostic.at(LintFixDuplicateMatchPatternCode, site: LintFixDuplicateMatchPatternSite, message: LintFixDuplicateMatchPatternMessage))
	requireHeldOutsideCheckout(LintFixDuplicateMatchPatternFixture, check: LintFixCase.of(LintFixDuplicateMatchPatternFixture, arguments: [AppDirName], fixed: LintFixedFileArray.create(0), outcome: outcome))
end 'lint --fix leaves a duplicate match pattern, which has no single fix, and reports it as lint does'
