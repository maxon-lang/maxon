let LintFixCrlfFixture = "lint-fix-crlf-line-endings"
let LintFixCrlfFindings = 3

test 'lint --fix of a file written with CRLF line endings deletes an unused function with its comments and a discarded pure call, discards a dropped impure result, keeps every CRLF, and the program still runs'
	requireHeldOutsideCheckout(LintFixCrlfFixture, check: lintFixRunningCase(LintFixCrlfFixture, findings: LintFixCrlfFindings, lineEndings: LintFixLineEndings.carriageReturnLineFeeds))
end 'lint --fix of a file written with CRLF line endings deletes an unused function with its comments and a discarded pure call, discards a dropped impure result, keeps every CRLF, and the program still runs'
