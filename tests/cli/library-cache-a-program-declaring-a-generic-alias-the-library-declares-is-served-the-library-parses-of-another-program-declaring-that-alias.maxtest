let LibraryCacheGenericAliasCaseDirName = "library-cache-alias-generic"
let GenericAliasFirstProgramSource = "typealias Tally = int(0 to 1000)\ntypealias StringArray = Array with String\n\nfunction main() returns ExitCode\n\tlet seed = 21\n\tlet words = \"seed \{seed\} grows\".split(\" \")\n\twords.insert(0, value: \"then\")\n\tlet word = try words.get(2) otherwise \"\"\n\tlet length = word.byteLength() as Tally\n\tlet kept = StringArray.create(0)\n\tkept.insert(0, value: word)\n\tlet extra = try kept.get(0) otherwise \"\"\n\treturn (length + seed + extra.byteLength() as Tally) as ExitCode\nend 'main'\n"
let GenericAliasFirstProgramExitCode = 25
let GenericAliasSecondProgramSource = "typealias Tally = int(0 to 1000)\ntypealias StringArray = Array with Tally\n\nfunction main() returns ExitCode\n\tlet seed = 21\n\tlet words = \"seed \{seed\} grows\".split(\" \")\n\twords.insert(0, value: \"then\")\n\tlet word = try words.get(2) otherwise \"\"\n\tlet length = word.byteLength() as Tally\n\tlet kept = StringArray.create(0)\n\tkept.insert(0, value: 7)\n\tlet extra = try kept.get(0) otherwise 0\n\treturn (length + seed + extra) as ExitCode\nend 'main'\n"
let GenericAliasSecondProgramExitCode = 30

test 'a program declaring a generic alias the library declares is served the library parses of another program declaring that alias'
	requireHeldOutsideCheckout(LibraryCacheGenericAliasCaseDirName, check: BuiltInSequenceMatchesCold.create([SequencedProgram.create(GenericAliasFirstProgramSource, exitCode: GenericAliasFirstProgramExitCode, subject: "a program that declares a `StringArray` alias over `String` beside the library `StringArray` a `split` returns, built after a program that declares none", expectation: LibraryCacheExpectation.loadsTheBaselineAndParsesTheLibrary), SequencedProgram.create(GenericAliasSecondProgramSource, exitCode: GenericAliasSecondProgramExitCode, subject: "a program that declares a `StringArray` alias over another element type than the `StringArray` of the program before it", expectation: LibraryCacheExpectation.servedEveryParse)]))
end 'a program declaring a generic alias the library declares is served the library parses of another program declaring that alias'
