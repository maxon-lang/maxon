let LintFixBindingThrowsHandlerFixture = "lint-fix-try-block-with-a-binding-throws-handler"
let LintFixBindingThrowsHandlerFindings = 1
let LintFixBindingThrowsHandlerPrinted = "fourth\n"

test 'lint --fix unwraps a try block whose body cannot throw and deletes its one-line otherwise throws handler that binds the error with it, and the program prints what it printed'
	requireHeldOutsideCheckout(LintFixBindingThrowsHandlerFixture, check: lintFixRunningCase(LintFixBindingThrowsHandlerFixture, findings: LintFixBindingThrowsHandlerFindings, printed: LintFixPrinted.exactly(LintFixBindingThrowsHandlerPrinted)))
end 'lint --fix unwraps a try block whose body cannot throw and deletes its one-line otherwise throws handler that binds the error with it, and the program prints what it printed'
