let LibraryCacheAnotherLibraryAliasCaseDirName = "library-cache-alias-another-name"
let AnotherLibraryAliasFirstProgramSource = "typealias Tally = int(0 to 1000)\ntypealias Count = int(0 to 100)\n\nfunction doubled(value Count) returns Count\n\treturn value * 2\nend 'doubled'\n\nfunction main() returns ExitCode\n\tlet seed = 21\n\tlet words = \"seed \{seed\} grows\".split(\" \")\n\twords.insert(0, value: \"then\")\n\tlet word = try words.get(2) otherwise \"\"\n\tlet length = word.byteLength() as Tally\n\tlet held = words.count() as Tally\n\tlet extra = doubled(7) as Tally\n\treturn (length + seed + held + extra) as ExitCode\nend 'main'\n"
let AnotherLibraryAliasFirstProgramExitCode = 41
let AnotherLibraryAliasSecondProgramSource = "typealias Tally = int(0 to 1000)\ntypealias Byte = int(0 to 1000)\n\nfunction lowered(value Byte) returns Byte\n\treturn value - 290\nend 'lowered'\n\nfunction main() returns ExitCode\n\tlet seed = 21\n\tlet words = \"seed \{seed\} grows\".split(\" \")\n\twords.insert(0, value: \"then\")\n\tlet word = try words.get(2) otherwise \"\"\n\tlet length = word.byteLength() as Tally\n\tlet extra = lowered(300) as Tally\n\treturn (length + seed + extra) as ExitCode\nend 'main'\n"
let AnotherLibraryAliasSecondProgramExitCode = 33

test 'a program declaring another library alias than the program before it parses the library itself and builds the bytes a cold build writes'
	requireHeldOutsideCheckout(LibraryCacheAnotherLibraryAliasCaseDirName, check: BuiltInSequenceMatchesCold.create([SequencedProgram.create(AnotherLibraryAliasFirstProgramSource, exitCode: AnotherLibraryAliasFirstProgramExitCode, subject: "a program that declares a `Count` alias of its own, built after a program that declares none", expectation: LibraryCacheExpectation.loadsTheBaselineAndParsesTheLibrary), SequencedProgram.create(AnotherLibraryAliasSecondProgramSource, exitCode: AnotherLibraryAliasSecondProgramExitCode, subject: "a program that declares a `Byte` alias of its own, built after a program that declares a `Count` alias and none named `Byte`", expectation: LibraryCacheExpectation.loadsTheBaselineAndParsesTheLibrary)]))
end 'a program declaring another library alias than the program before it parses the library itself and builds the bytes a cold build writes'
