let AnInterfaceOfMoreMethodsThanSixteenBitsCanNumberIsRefusedCaseDirName = "declaration-limit-methods"
let AnInterfaceOfMoreMethodsThanSixteenBitsCanNumberIsRefusedRefusal = "more than 65535 methods and associated types"

test 'an interface that declares 65,536 methods is refused'
	try requireDeclarationRefused(AnInterfaceOfMoreMethodsThanSixteenBitsCanNumberIsRefusedCaseDirName, source: interfaceMethodsSource(), refusal: AnInterfaceOfMoreMethodsThanSixteenBitsCanNumberIsRefusedRefusal)
end 'an interface that declares 65,536 methods is refused'

function interfaceMethodsSource() returns String
	var text = "{DeclarationPrelude}interface Big\n"

	for i in 0 upto DeclaredMemberCount 'eachMethod'
		text.append("\tfunction m{i}()\n")
	end 'eachMethod'

	text.append("end 'Big'\n\n{DeclarationMain}")
	return text
end 'interfaceMethodsSource'
