let LintFixManifestCaseDirName = "lint-fix-manifest"
let LintFixManifestFixture = "lint-fix-manifest"
let LintFixManifestFile = "app.maxproj"
let LintFixManifestFindings = 1

test 'lint --fix of a manifest file deletes the unexported function nothing live names, and the project still builds'
	let fixed = lintFixFixedFiles(LintFixManifestFile, findings: LintFixManifestFindings)

	let proofs = LintFixProofArray.create(0)
	proofs.push([BuildCommandWord])

	requireHeldOutsideCheckout(LintFixManifestCaseDirName, check: LintFixCase.of(LintFixManifestFixture, arguments: [LintFixManifestFile], fixed: fixed, outcome: LintFixOutcome.linted(LintFixManifestFile), place: LintFixPlace.insideTheProject, proofs: proofs))
end 'lint --fix of a manifest file deletes the unexported function nothing live names, and the project still builds'
