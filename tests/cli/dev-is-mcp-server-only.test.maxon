// dev-is-mcp-server-only.test.maxon - `--dev` belongs to `mcp-server`, and every other command refuses
// it as an option it does not implement.
//
// A command that accepted it would take a word it never acts on, and say nothing about having ignored
// it — the same hole `--dry-run` is refused through.

let AnotherCommand = "version"

test 'a command other than mcp-server refuses --dev'
	let run = runDriver([AnotherCommand, DevFlag])

	let observedExit = run.exitCode() as AssertedInt
	try Expect.equal(observedExit, expected: 1, message: "`maxon {AnotherCommand} {DevFlag}` was answered. Only `{McpServerCommandWord}` has a contributor mode, and a command that ignores the flag accepts a word it never acts on. It said: {run.stdout}{run.stderr}")
	try Expect.contains(run.stderr, needle: DevFlag, message: "`maxon {AnotherCommand} {DevFlag}`'s refusal does not name the option that was typed. It said: {run.stderr}")
end 'a command other than mcp-server refuses --dev'
