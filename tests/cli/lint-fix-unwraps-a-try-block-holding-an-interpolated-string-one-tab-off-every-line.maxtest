let LintFixTryBlockInterpolatedFixture = "lint-fix-try-block-beside-an-interpolated-string"
let LintFixTryBlockInterpolatedFindings = 1
let LintFixTryBlockInterpolatedPrinted = "4\n1\n"

test 'lint --fix unwraps a try block whose body cannot throw and takes one tab off every body line, the one after an interpolated string included, and the program prints what it printed'
	requireHeldOutsideCheckout(LintFixTryBlockInterpolatedFixture, check: lintFixRunningCase(LintFixTryBlockInterpolatedFixture, findings: LintFixTryBlockInterpolatedFindings, printed: LintFixPrinted.exactly(LintFixTryBlockInterpolatedPrinted)))
end 'lint --fix unwraps a try block whose body cannot throw and takes one tab off every body line, the one after an interpolated string included, and the program prints what it printed'
