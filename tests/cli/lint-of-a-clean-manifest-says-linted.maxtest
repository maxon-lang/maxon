let LintOfACleanManifestCaseDirName = "lint-of-a-clean-manifest"
let LintOfACleanManifestFixture = "lint-manifest-program-clean"
let LintOfACleanManifestFile = "app.maxproj"
let LintOfACleanManifestBuiltExit = 0

test 'lint of a clean manifest file, which declares no main, exits 0 and prints one Linted line'
	requireHeldOutsideCheckout(LintOfACleanManifestCaseDirName, check: LintOfAManifestProgramCase.of(LintOfACleanManifestFixture, manifest: LintOfACleanManifestFile, proof: [BuildCommandWord], provedExit: LintOfACleanManifestBuiltExit, findings: ExpectedDiagnosticArray.create(0)))
end 'lint of a clean manifest file, which declares no main, exits 0 and prints one Linted line'
