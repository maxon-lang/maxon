let LintFixBindingPanicHandlerFixture = "lint-fix-try-block-with-a-binding-panic-handler"
let LintFixBindingPanicHandlerFindings = 1
let LintFixBindingPanicHandlerPrinted = "third\n"

test 'lint --fix unwraps a try block whose body cannot throw and deletes its one-line otherwise panic handler that binds the error with it, and the program prints what it printed'
	requireHeldOutsideCheckout(LintFixBindingPanicHandlerFixture, check: lintFixRunningCase(LintFixBindingPanicHandlerFixture, findings: LintFixBindingPanicHandlerFindings, printed: LintFixPrinted.exactly(LintFixBindingPanicHandlerPrinted)))
end 'lint --fix unwraps a try block whose body cannot throw and deletes its one-line otherwise panic handler that binds the error with it, and the program prints what it printed'
