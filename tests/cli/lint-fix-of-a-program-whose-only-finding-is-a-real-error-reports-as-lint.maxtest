let LintFixOnlyAnErrorCaseDirName = "lint-fix-only-an-error"
let LintFixOnlyAnErrorFixture = "lint-fix-only-a-real-error"
let LintFixOnlyAnErrorCode = "E3004"
let LintFixOnlyAnErrorSite = "main.maxon:2:9"
let LintFixOnlyAnErrorMessage = "call to undefined function 'undefinedHelper'"

test 'lint --fix of a program whose only finding is a call to an undefined function rewrites nothing and reports as lint does'
	let outcome = lintFixRefusedWith(ExpectedDiagnostic.at(LintFixOnlyAnErrorCode, site: LintFixOnlyAnErrorSite, message: LintFixOnlyAnErrorMessage))
	requireHeldOutsideCheckout(LintFixOnlyAnErrorCaseDirName, check: LintFixCase.of(LintFixOnlyAnErrorFixture, arguments: [AppDirName], fixed: LintFixedFileArray.create(0), outcome: outcome))
end 'lint --fix of a program whose only finding is a call to an undefined function rewrites nothing and reports as lint does'
