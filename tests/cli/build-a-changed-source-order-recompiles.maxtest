let BuildAChangedSourceOrderRecompilesCaseDirName = "build-a-changed-source-order-recompiles"
let ChangedSourceOrderVariable = "MAXON_SOURCE_ORDER"
let ChangedSourceOrderReversed = "reversed"
let SourceOrderChangedReason = "option sourceOrder changed"

test 'a build whose source order differs from the last compile is compiled again'
	requireHeldOutsideCheckout(BuildAChangedSourceOrderRecompilesCaseDirName, check: ChangedSourceOrderRecompiles.create())
end 'a build whose source order differs from the last compile is compiled again'

function runReversedOrderBuild(dir FilePath) returns CollectedOutput
	var arguments = StringArray.create(0)
	arguments.push(BuildCommandWord)
	arguments.push(SettledProgramDirName)
	arguments.push("{OutputOptionPrefix}{dir.join(OutputStem).toString()}")

	var naming = EnvMap.create()
	naming.upsert(CacheRootVariable, value: cacheRootIn(dir).toString())
	naming.upsert(ChangedSourceOrderVariable, value: ChangedSourceOrderReversed)

	return runWithCacheRoots(arguments, naming: naming, workingDirectory: dir)
end 'runReversedOrderBuild'

type ChangedSourceOrderRecompiles implements OutsideCheckoutCase
	static function create() returns ChangedSourceOrderRecompiles
		return Self{}
	end 'create'

	export function requireHeldIn(dir FilePath) throws TestFailure
		stageSettledProgram(dir, name: SettledProgramDirName, source: TrivialProgramSource)
		try requireBuilt(runRecordedBuild(dir, program: SettledProgramDirName, output: OutputStem, options: StringArray.create(0)), which: "the first build under an empty cache root")
		try requireUpToDate(runRecordedBuild(dir, program: SettledProgramDirName, output: OutputStem, options: StringArray.create(0)), which: "a second build in the natural source order")

		try requireCompiled(runReversedOrderBuild(dir), reason: SourceOrderChangedReason, which: "a build with {ChangedSourceOrderVariable}={ChangedSourceOrderReversed}")
		try requireUpToDate(runReversedOrderBuild(dir), which: "a second build with {ChangedSourceOrderVariable}={ChangedSourceOrderReversed}")

		try requireCompiled(runRecordedBuild(dir, program: SettledProgramDirName, output: OutputStem, options: StringArray.create(0)), reason: SourceOrderChangedReason, which: "a build with {ChangedSourceOrderVariable} unset again")
	end 'requireHeldIn'
end 'ChangedSourceOrderRecompiles'
