let LintFixTwoLocalsCaseDirName = "lint-fix-two-locals-in-a-block"
let LintFixTwoLocalsFixture = "lint-fix-two-unused-locals-alone-in-a-block"
let LintFixTwoLocalsFile = "app/main.maxon"
let LintFixTwoLocalsFindings = 1
let LintFixTwoLocalsCode = "E3012"
let LintFixTwoLocalsLeftSite = "main.maxon:7:7"
let LintFixTwoLocalsLeftMessage = "unused variable: 'second'"

test 'lint --fix deletes the first of two unused locals that are all of an if block, then leaves the second, now its only statement, and reports it'
	let fixed = lintFixFixedFiles(LintFixTwoLocalsFile, findings: LintFixTwoLocalsFindings)
	let outcome = lintFixRefusedWith(ExpectedDiagnostic.at(LintFixTwoLocalsCode, site: LintFixTwoLocalsLeftSite, message: LintFixTwoLocalsLeftMessage))
	requireHeldOutsideCheckout(LintFixTwoLocalsCaseDirName, check: LintFixCase.of(LintFixTwoLocalsFixture, arguments: [AppDirName], fixed: fixed, outcome: outcome))
end 'lint --fix deletes the first of two unused locals that are all of an if block, then leaves the second, now its only statement, and reports it'
