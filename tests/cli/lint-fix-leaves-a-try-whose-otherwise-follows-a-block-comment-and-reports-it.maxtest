let LintFixTryBeforeCommentCaseDirName = "lint-fix-try-before-a-comment"
let LintFixTryBeforeCommentFixture = "lint-fix-try-before-a-block-comment-with-a-quote"
let LintFixTryBeforeCommentCode = "E3055"
let LintFixTryBeforeCommentSite = "main.maxon:10:14"
let LintFixTryBeforeCommentMessage = "try requires a throwing function: 'plain' does not throw'"

test 'lint --fix leaves a try on a call that cannot throw when a block comment holding a quote stands between the call and its otherwise, and reports it'
	let outcome = lintFixRefusedWith(ExpectedDiagnostic.at(LintFixTryBeforeCommentCode, site: LintFixTryBeforeCommentSite, message: LintFixTryBeforeCommentMessage))
	requireHeldOutsideCheckout(LintFixTryBeforeCommentCaseDirName, check: LintFixCase.of(LintFixTryBeforeCommentFixture, arguments: [AppDirName], fixed: LintFixedFileArray.create(0), outcome: outcome))
end 'lint --fix leaves a try on a call that cannot throw when a block comment holding a quote stands between the call and its otherwise, and reports it'
