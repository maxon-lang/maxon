let LibraryCacheAddsAByReferenceFunctionCaseDirName = "library-cache-adds-by-reference-function"
let AddsAByReferenceFunctionProgramSource = "typealias Tally = int(0 to 1000)\n\nfunction accrue(total mutable Tally, amount Tally, times Tally)\n\ttotal = total + amount * times\nend 'accrue'\n\nfunction main() returns ExitCode\n\tlet seed = 21\n\tlet words = \"seed \{seed\} grows\".split(\" \")\n\twords.insert(0, value: \"then\")\n\tlet word = try words.get(2) otherwise \"\"\n\tlet length = word.byteLength() as Tally\n\tvar total = length\n\taccrue(total, amount: seed, times: 3)\n\treturn total as ExitCode\nend 'main'\n"
let AddsAByReferenceFunctionProgramExitCode = 65

test 'a program that adds a function taking a mutable parameter is served the library parses of the program before it'
	requireHeldOutsideCheckout(LibraryCacheAddsAByReferenceFunctionCaseDirName, check: AddedFactIsServedTheLibrary.create(AddsAByReferenceFunctionProgramSource, exitCode: AddsAByReferenceFunctionProgramExitCode, fact: "a free function taking a `mutable` parameter, under a name no library file spells"))
end 'a program that adds a function taking a mutable parameter is served the library parses of the program before it'
