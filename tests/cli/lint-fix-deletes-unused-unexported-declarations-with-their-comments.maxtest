let LintFixUnusedUnexportedCaseDirName = "lint-fix-unused-unexported"
let LintFixUnusedUnexportedFixture = "lint-fix-unused-unexported-declarations"
let LintFixUnusedUnexportedFile = "app/main.maxon"
let LintFixUnusedUnexportedFindings = 5

test 'lint --fix deletes each unused unexported declaration whole, with its attached comments and one blank line'
	let fixed = lintFixFixedFiles(LintFixUnusedUnexportedFile, findings: LintFixUnusedUnexportedFindings)
	requireHeldOutsideCheckout(LintFixUnusedUnexportedCaseDirName, check: LintFixCase.of(LintFixUnusedUnexportedFixture, arguments: [AppDirName], fixed: fixed, outcome: LintFixOutcome.linted(AppDirName)))
end 'lint --fix deletes each unused unexported declaration whole, with its attached comments and one blank line'
