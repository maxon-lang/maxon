let LintFixUnusedParameterFixture = "lint-fix-unused-parameter"
let LintFixUnusedParameterCode = "E3012"
let LintFixUnusedParameterSite = "main.maxon:5:18"
let LintFixUnusedParameterMessage = "unused variable: 'n'"

test 'lint --fix never rewrites an unused parameter, and reports it as lint does'
	let outcome = lintFixRefusedWith(ExpectedDiagnostic.at(LintFixUnusedParameterCode, site: LintFixUnusedParameterSite, message: LintFixUnusedParameterMessage))
	requireHeldOutsideCheckout(LintFixUnusedParameterFixture, check: LintFixCase.of(LintFixUnusedParameterFixture, arguments: [AppDirName], fixed: LintFixedFileArray.create(0), outcome: outcome))
end 'lint --fix never rewrites an unused parameter, and reports it as lint does'
