// build-walk-skips-a-case-folded-manifest.test.maxon - `maxon build <dir>` leaves a build manifest out of
// the program whatever case its name is spelled in, as `fmt` does. A `PROJECT.maxon` is a manifest on a
// case-insensitive filesystem, and compiling it into the program is a build that fails for a file the
// author never meant as source.

let CaseDirName = "build-walk-skips-a-case-folded-manifest"
let ProjectDirName = "project"
let OutputStem = "program"
let MainFileName = "main.maxon"
let CaseFoldedManifestName = "PROJECT.maxon"
let MainSource = "function main() returns ExitCode\n\treturn 0\nend 'main'\n"

// A manifest that does not compile as program source: it names a value nothing declares.
let ManifestSource = "export function build() returns ExitCode\n\treturn undeclaredOutput\nend 'build'\n"

test 'a directory build skips a manifest whose name is case-folded'
	let dir = freshCaseDir(CaseDirName)
	let project = dir.join(ProjectDirName)

	if not Directory.create(project) and not Directory.isDirectory(project) 'couldNotCreate'
		panic("build-walk-skips-a-case-folded-manifest: the gate could not run - could not create {project.toString()}")
	end 'couldNotCreate'

	for (name, content) in [(MainFileName, MainSource), (CaseFoldedManifestName, ManifestSource)] 'eachFile'
		let path = project.join(name)
		try File.writeText(path, content: content) otherwise panic("build-walk-skips-a-case-folded-manifest: the gate could not run - could not write {path.toString()}")
	end 'eachFile'

	let output = dir.join(OutputStem)
	let build = runDriver([BuildCommandWord, project.toString(), OutputFlag, output.toString()])
	let said = "It wrote to stdout: {build.stdout} and to stderr: {build.stderr}"

	try Expect.equal(build.exitCode() as AssertedInt, expected: 0, message: "a directory holding `{CaseFoldedManifestName}` beside its program did not build; the manifest was compiled as source. {said}")
	try Expect.isTrue(File.exists(dir.join("{OutputStem}{executableSuffix()}")), message: "the build exited 0 and wrote no executable. {said}")
end 'a directory build skips a manifest whose name is case-folded'
