test 'a build naming a runtime file beside a program compiles that file once, as the tiers'
	expectALibraryFileBesideAProgramIsReadOnce("build-naming-a-runtime-file-beside-a-program-loads-it-once", libraryFile: "runtime/Clock.maxon", whoseFile: "the runtime tier's own file")
end 'a build naming a runtime file beside a program compiles that file once, as the tiers'
