let LintFixConditionalFunctionCaseDirName = "lint-fix-cond-function"
let LintFixConditionalFunctionFixture = "lint-fix-conditional-unused-function"
let LintFixConditionalFunctionSite = "main.maxon:10:10"
let LintFixConditionalFunctionMessage = "unused function: 'spare' is not exported and nothing live in its directory names it; delete it"

test 'lint --fix rewrites nothing in a file holding a conditional-compilation directive, so an unused function directly below an endif is left and reported'
	let outcome = lintFixRefusedWith(ExpectedDiagnostic.at(UnusedUnexportedCode, site: LintFixConditionalFunctionSite, message: LintFixConditionalFunctionMessage))
	requireHeldOutsideCheckout(LintFixConditionalFunctionCaseDirName, check: LintFixCase.of(LintFixConditionalFunctionFixture, arguments: [AppDirName], fixed: LintFixedFileArray.create(0), outcome: outcome))
end 'lint --fix rewrites nothing in a file holding a conditional-compilation directive, so an unused function directly below an endif is left and reported'
