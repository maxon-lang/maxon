let LintOfAManifestWithADefineCaseDirName = "lint-of-a-manifest-with-a-define"
let LintOfAManifestWithADefineFixture = "lint-manifest-declaring-channel"
let LintOfAManifestWithADefineManifest = "app.maxproj"
let LintOfAManifestWithADefineOptionPrefix = "--define="
let LintOfAManifestWithADefineBinding = "Channel=nightly"

test 'lint of a manifest file with --define= is refused as a usage error, since the runner takes no defines'
	requireHeldOutsideCheckout(LintOfAManifestWithADefineCaseDirName, check: LintUsageRefusalCase.of(LintOfAManifestWithADefineFixture, arguments: [LintOfAManifestWithADefineManifest, "{LintOfAManifestWithADefineOptionPrefix}{LintOfAManifestWithADefineBinding}"], words: [LintOfAManifestWithADefineOptionPrefix, LintOfAManifestWithADefineManifest]))
end 'lint of a manifest file with --define= is refused as a usage error, since the runner takes no defines'
