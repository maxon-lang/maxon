let CaseDirName = "spec-test-refuses-rewrite-drifted-goldens-with-update-required"
let RewriteDriftedGoldensFlag = "--rewrite-drifted-goldens"
let UpdateRequiredFlag = "--update-required"
let AcceptedExitCode = 0

test 'spec-test refuses --rewrite-drifted-goldens beside --update-required, naming both'
	let dir = freshCaseDir(CaseDirName)
	let refused = runDriver([HiddenAnchorCommand, dir.toString(), RewriteDriftedGoldensFlag, UpdateRequiredFlag])
	let said = "It wrote to stdout: {refused.stdout} and to stderr: {refused.stderr}"

	Expect.notEqual(refused.exitCode(), expected: AcceptedExitCode, message: "`maxon {HiddenAnchorCommand} {RewriteDriftedGoldensFlag} {UpdateRequiredFlag}` was accepted. The two flags write goldens under different rules, and a run cannot honour both. {said}")
	Expect.contains(refused.stderr, needle: RewriteDriftedGoldensFlag, message: "the refusal does not name {RewriteDriftedGoldensFlag}. {said}")
	Expect.contains(refused.stderr, needle: UpdateRequiredFlag, message: "the refusal does not name {UpdateRequiredFlag}, the flag {RewriteDriftedGoldensFlag} cannot be combined with. {said}")
end 'spec-test refuses --rewrite-drifted-goldens beside --update-required, naming both'
