let LintFixConditionalAcrossExportCaseDirName = "lint-fix-cond-across-export"
let LintFixConditionalAcrossExportFixture = "lint-fix-conditional-cross-file-export"

test 'lint --fix counts an export another directory names only inside a branch inactive on this host as used, rewrites nothing and says linted'
	requireHeldOutsideCheckout(LintFixConditionalAcrossExportCaseDirName, check: LintFixCase.of(LintFixConditionalAcrossExportFixture, arguments: [AppDirName], fixed: LintFixedFileArray.create(0), outcome: LintFixOutcome.linted(AppDirName)))
end 'lint --fix counts an export another directory names only inside a branch inactive on this host as used, rewrites nothing and says linted'
