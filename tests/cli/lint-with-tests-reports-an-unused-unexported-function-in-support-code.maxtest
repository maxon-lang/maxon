let LintWithTestsUnusedCaseDirName = "lint-with-tests-unused"
let LintWithTestsUnusedFixture = "lint-tests-unused-unexported"
let LintWithTestsUnusedSite = "support.maxon:7:10"

test 'lint --tests reports an unexported function nothing live names in a test project, which maxon test still passes'
	let findings = ExpectedDiagnosticArray.create(0)
	findings.push(ExpectedDiagnostic.at(UnusedUnexportedCode, site: LintWithTestsUnusedSite, message: UnusedLeftoverMessage))
	requireHeldOutsideCheckout(LintWithTestsUnusedCaseDirName, check: LintOfATestProjectCase.of(LintWithTestsUnusedFixture, findings: findings))
end 'lint --tests reports an unexported function nothing live names in a test project, which maxon test still passes'
