let LintOfATaskFileCaseDirName = "lint-of-a-task-file"
let LintOfATaskFileFixture = "lint-task-file-unused-unexported"
let LintOfATaskFileName = "dev.maxtasks"
let LintOfATaskFileTask = "greet"
let LintOfATaskFileTaskExit = 7
let LintOfATaskFileSite = "dev.maxtasks:8:10"

test 'lint of a task file lints the task program and reports an unexported function nothing live names'
	let findings = ExpectedDiagnosticArray.create(0)
	findings.push(ExpectedDiagnostic.at(UnusedUnexportedCode, site: LintOfATaskFileSite, message: UnusedLeftoverMessage))
	requireHeldOutsideCheckout(LintOfATaskFileCaseDirName, check: LintOfAManifestProgramCase.of(LintOfATaskFileFixture, manifest: LintOfATaskFileName, proof: [RunCommandWord, LintOfATaskFileTask], provedExit: LintOfATaskFileTaskExit, findings: findings))
end 'lint of a task file lints the task program and reports an unexported function nothing live names'
