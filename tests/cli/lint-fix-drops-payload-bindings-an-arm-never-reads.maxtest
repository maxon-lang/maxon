let LintFixDiscardedPayloadBindingsFixture = "lint-fix-discarded-payload-bindings"
let LintFixDiscardedPayloadBindingsFindings = 3

test 'lint --fix drops a binding list of discards, and turns an unread payload binder into a discard whose list it then drops'
