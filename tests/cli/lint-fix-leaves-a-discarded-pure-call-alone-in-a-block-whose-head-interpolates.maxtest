let LintFixInterpolatedHeadPureCaseDirName = "lint-fix-interp-head-pure"
let LintFixInterpolatedHeadPureFixture = "lint-fix-pure-call-under-an-interpolated-head"
let LintFixInterpolatedHeadPureSite = "main.maxon:10:3"
let LintFixInterpolatedHeadPureMessage = "result of pure function 'doubled' must be used"

test 'lint --fix leaves a discarded pure call that is the only statement of a block whose head interpolates a string, beside a comment line, and reports it'
	let outcome = lintFixRefusedWith(ExpectedDiagnostic.at(DiscardedPureResultCode, site: LintFixInterpolatedHeadPureSite, message: LintFixInterpolatedHeadPureMessage))
	requireHeldOutsideCheckout(LintFixInterpolatedHeadPureCaseDirName, check: LintFixCase.of(LintFixInterpolatedHeadPureFixture, arguments: [AppDirName], fixed: LintFixedFileArray.create(0), outcome: outcome))
end 'lint --fix leaves a discarded pure call that is the only statement of a block whose head interpolates a string, beside a comment line, and reports it'
