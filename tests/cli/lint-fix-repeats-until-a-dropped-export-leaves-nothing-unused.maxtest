let LintFixCascadeCaseDirName = "lint-fix-cascade"
let LintFixCascadeFixture = "lint-fix-unused-export-cascade"
let LintFixCascadeFile = "app/main.maxon"
let LintFixCascadeFindings = 3

test 'lint --fix drops an export nothing uses, then deletes the function and the helper only it called'
	let fixed = lintFixFixedFiles(LintFixCascadeFile, findings: LintFixCascadeFindings)
	requireHeldOutsideCheckout(LintFixCascadeCaseDirName, check: LintFixCase.of(LintFixCascadeFixture, arguments: [AppDirName], fixed: fixed, outcome: LintFixOutcome.linted(AppDirName)))
end 'lint --fix drops an export nothing uses, then deletes the function and the helper only it called'
