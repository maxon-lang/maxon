let LintFixPanicHandlerFixture = "lint-fix-try-block-with-a-panic-handler"
let LintFixPanicHandlerFindings = 1
let LintFixPanicHandlerPrinted = "first\n"

test 'lint --fix unwraps a try block whose body cannot throw and deletes its one-line otherwise panic handler with it, and the program prints what it printed'
	requireHeldOutsideCheckout(LintFixPanicHandlerFixture, check: lintFixRunningCase(LintFixPanicHandlerFixture, findings: LintFixPanicHandlerFindings, printed: LintFixPrinted.exactly(LintFixPanicHandlerPrinted)))
end 'lint --fix unwraps a try block whose body cannot throw and deletes its one-line otherwise panic handler with it, and the program prints what it printed'
