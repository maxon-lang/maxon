let RunBesideOnlyAnOldTasksMaxonIsRefusedCaseDirName = "run-beside-only-an-old-tasks-maxon-is-refused"
let RunBesideOnlyAnOldTasksMaxonIsRefusedAskedFor = "report"

let OldTasksSource = "export function report() returns ExitCode\n\treturn 0\nend 'report'\n"

test 'a directory holding a tasks.maxon and no .maxtasks has no tasks'
	let dir = freshCaseDir(RunBesideOnlyAnOldTasksMaxonIsRefusedCaseDirName)
	writeStagedFile(dir.join(OldTaskFileName), content: OldTasksSource)

	let refused = spawnCompiler([RunCommandWord, RunBesideOnlyAnOldTasksMaxonIsRefusedAskedFor], staged: dir)
	let said = "It wrote to stdout: {refused.stdout} and to stderr: {refused.stderr}"

	Expect.equal(refused.exitCode(), expected: 1, message: "`maxon {RunCommandWord} {RunBesideOnlyAnOldTasksMaxonIsRefusedAskedFor}` beside a `{OldTaskFileName}` and no `{TasksFileExtension}` file did not refuse: `{OldTaskFileName}` is an ordinary source and declares no tasks. {said}")
	Expect.contains(refused.stderr, needle: TasksFileExtension, message: "the refusal did not name the `{TasksFileExtension}` file it looked for. {said}")

	discardStagedDir(dir)
end 'a directory holding a tasks.maxon and no .maxtasks has no tasks'
