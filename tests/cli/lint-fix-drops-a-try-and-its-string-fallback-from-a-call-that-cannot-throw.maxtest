let LintFixStringFallbackFixture = "lint-fix-try-with-a-string-fallback"
let LintFixStringFallbackFindings = 2
let LintFixStringFallbackPrinted = "tag tag\n"

test 'lint --fix drops a try and its string fallback, empty or not, from a call that cannot throw, and the program prints what it printed'
	requireHeldOutsideCheckout(LintFixStringFallbackFixture, check: lintFixRunningCase(LintFixStringFallbackFixture, findings: LintFixStringFallbackFindings, printed: LintFixPrinted.exactly(LintFixStringFallbackPrinted)))
end 'lint --fix drops a try and its string fallback, empty or not, from a call that cannot throw, and the program prints what it printed'
