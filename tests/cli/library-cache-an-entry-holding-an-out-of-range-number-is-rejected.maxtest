let CaseDirName = "library-cache-out-of-range-number"
let ProgramDirName = "app"
let OutputName = "program"
let ColdImageName = "cold-image"

test 'an entry whose checksum holds but whose number is outside its range is rejected, and the build is the cold one'
	requireHeldOutsideCheckout(CaseDirName, check: OutOfRangeNumberIsRejected.create())
end 'an entry whose checksum holds but whose number is outside its range is rejected, and the build is the cold one'

type OutOfRangeNumberIsRejected implements OutsideCheckoutCase
	static function create() returns OutOfRangeNumberIsRejected
		return Self{}
	end 'create'

	export function requireHeldIn(dir FilePath) throws TestFailure
		stageProgram(dir, name: ProgramDirName, source: TrivialProgramSource)

		let image = dir.join("{OutputName}{executableSuffix()}")

		let cold = try libraryCacheReportOf(runLibraryCacheBuild(dir, program: ProgramDirName, output: OutputName, options: ListedWordArray.create()), which: "the cold build")
		try Expect.greaterThan(cold.written, than: 0, message: "the cold build wrote nothing to the library cache, so there is no entry to forge. It wrote: {cold.line}")

		let coldImage = retainedAside(image, aside: dir.join(ColdImageName))
		let entry = viewsEntryIn(dir)
		let original = bytesOf(entry)

		rewrittenFile(entry, bytes: entryWithChecksumOfItsPayload(original))

		let control = try libraryCacheReportOf(runLibraryCacheBuild(dir, program: ProgramDirName, output: OutputName, options: ListedWordArray.create()), which: "the build over an entry sealed again with the checksum of its unchanged payload")
		try Expect.equal(control.rejected, expected: 0, message: "the build over an entry sealed again with the checksum of its unchanged payload rejected it, so a forged checksum cannot be told from a damaged one and this case proves nothing. It wrote: {control.line}")
		try Expect.greaterThan(control.loaded, than: 0, message: "the build over an entry sealed again with the checksum of its unchanged payload loaded nothing. It wrote: {control.line}")

		let forged = entryWithChecksumOfItsPayload(entryWithEveryProducerMaskForged(original))
		rewrittenFile(entry, bytes: forged)

		let rejectedBuild = runLibraryCacheBuild(dir, program: ProgramDirName, output: OutputName, options: ListedWordArray.create())
		let rejected = try libraryCacheReportOf(rejectedBuild, which: "the build over an entry holding a producer mask of {ForgedProducerMask}")
		try Expect.atLeast(rejected.rejected, than: 1, message: "the build over an entry holding a producer mask of {ForgedProducerMask} under a valid checksum rejected nothing. It wrote: {rejected.line}")
		try Expect.contains(rejectedBuild.stderr, needle: OutOfRangeReason, message: "the build rejected the forged entry for another reason than a number outside its range. It wrote to stderr: {rejectedBuild.stderr}")
		try requireSameBytes(coldImage, second: image, why: "the build over a forged entry wrote an executable that is not the cold build's.")

		let repaired = try libraryCacheReportOf(runLibraryCacheBuild(dir, program: ProgramDirName, output: OutputName, options: ListedWordArray.create()), which: "the build after the forged entry was rewritten")
		try Expect.equal(repaired.rejected, expected: 0, message: "the build after the forged entry was rewritten rejected entries again. It wrote: {repaired.line}")
	end 'requireHeldIn'
end 'OutOfRangeNumberIsRejected'
