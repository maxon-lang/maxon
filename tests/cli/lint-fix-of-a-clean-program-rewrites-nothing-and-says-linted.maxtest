let LintFixCleanCaseDirName = "lint-fix-clean"
let LintFixCleanFixture = "lint-fix-clean"

test 'lint --fix of a clean program rewrites nothing, prints no Fixed line and says Linted as lint does'
	requireHeldOutsideCheckout(LintFixCleanCaseDirName, check: LintFixCase.of(LintFixCleanFixture, arguments: [AppDirName], fixed: LintFixedFileArray.create(0), outcome: LintFixOutcome.linted(AppDirName)))
end 'lint --fix of a clean program rewrites nothing, prints no Fixed line and says Linted as lint does'
