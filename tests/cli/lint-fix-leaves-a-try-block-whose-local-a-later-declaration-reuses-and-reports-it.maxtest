let LintFixTryBlockRedeclaredCaseDirName = "lint-fix-try-block-redeclared"
let LintFixTryBlockRedeclaredFixture = "lint-fix-try-block-scope-then-redeclared"
let LintFixTryBlockRedeclaredCode = "E3083"
let LintFixTryBlockRedeclaredSite = "main.maxon:6:2"
let LintFixTryBlockRedeclaredMessage = "try block contains no throwing calls: 'work'"

test 'lint --fix leaves a try block whose body cannot throw when unwrapping it would put its local in one scope with a later declaration of the same name, and reports it'
	let outcome = lintFixRefusedWith(ExpectedDiagnostic.at(LintFixTryBlockRedeclaredCode, site: LintFixTryBlockRedeclaredSite, message: LintFixTryBlockRedeclaredMessage))
	requireHeldOutsideCheckout(LintFixTryBlockRedeclaredCaseDirName, check: LintFixCase.of(LintFixTryBlockRedeclaredFixture, arguments: [AppDirName], fixed: LintFixedFileArray.create(0), outcome: outcome))
end 'lint --fix leaves a try block whose body cannot throw when unwrapping it would put its local in one scope with a later declaration of the same name, and reports it'
