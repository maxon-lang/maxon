let LibraryCacheAddsAGenericFunctionCaseDirName = "library-cache-adds-generic-function"

test 'a program that adds a generic function of its own is served the library parses of the program before it'
	requireHeldOutsideCheckout(LibraryCacheAddsAGenericFunctionCaseDirName, check: AddedFactIsServedTheLibrary.create(OwnGenericFunctionProgramSource, exitCode: OwnGenericFunctionProgramExitCode, fact: "a generic function of its own and one instance of it"))
end 'a program that adds a generic function of its own is served the library parses of the program before it'
