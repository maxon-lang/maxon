let LibraryCacheAddsAGenericFunctionCaseDirName = "library-cache-adds-generic-function"

test 'a program that adds a generic function of its own is served the library parses of the program before it'
	requireHeldOutsideCheckout(LibraryCacheAddsAGenericFunctionCaseDirName, check: BuiltInSequenceMatchesCold.create([SequencedProgram.create(OwnGenericFunctionProgramSource, exitCode: OwnGenericFunctionProgramExitCode, subject: "a program that adds a generic function of its own and one instance of it", expectation: LibraryCacheExpectation.servedEveryParse)]))
end 'a program that adds a generic function of its own is served the library parses of the program before it'
