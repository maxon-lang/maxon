// The configuration this pins is a deployed one: Docker hands a container run with a numeric
// `--user` that has no passwd entry `HOME=/`, a home directory that exists and cannot be written
// under.

let CaseDirName = "run-falls-through-a-root-it-cannot-create"

let ProgramFileName = "fellthrough.maxon"
let ProgramSource = "function main() returns ExitCode\n\tprint(\"the build was kept\\n\")\n\treturn 0\nend 'main'\n"
let ProgramOutput = "the build was kept"

let NothingPublished = 0

test 'run falls through to the next root when the highest-ranked one cannot be created'
	let dir = freshCaseDir(CaseDirName)

	let naming = rosterWithHighestRootBlocked(dir)
	let blocked = blockedHighestRoot(dir)
	let owned = fallThroughCacheRoot(dir)

	let program = dir.join(ProgramFileName)
	try File.writeText(program, content: ProgramSource) otherwise panic("{CaseDirName}: the gate could not run - could not write {program.toString()}, the program the driver is asked to run.")

	let run = runWithCacheRoots([RunCommandWord, program.toString()], naming: naming, workingDirectory: dir)
	let said = "It wrote to stdout: {run.stdout} and to stderr: {run.stderr}"

	try Expect.equal(run.exitCode() as AssertedInt, expected: 0, message: "`maxon {RunCommandWord}` did not run a one-line program because {HomeDirectoryVariable} named {blocked.toString()}, a path no directory can be made under. {rootRankedBelowHomeVariable()} named a writable directory, and a roster is consulted in order precisely so that a candidate that does not work is not the end of it. {said}")

	try Expect.contains(run.stdout, needle: ProgramOutput, message: "`maxon {RunCommandWord}` did not print what the program prints. {said}")

	let published = filesUnder(owned).count() as AssertedInt

	try Expect.greaterThan(published, than: NothingPublished, message: "`maxon {RunCommandWord}` left nothing under {owned.toString()}, the root {rootRankedBelowHomeVariable()} names and the first one on this host's roster that can be created. The program ran, so its build is being kept somewhere this case did not name - and a cache outside the case's own tree is the developer's. {said}")
end 'run falls through to the next root when the highest-ranked one cannot be created'
