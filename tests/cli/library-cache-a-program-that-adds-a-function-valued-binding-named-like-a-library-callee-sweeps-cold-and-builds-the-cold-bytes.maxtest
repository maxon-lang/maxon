let LibraryCacheFunctionValuedBindingNamedRunCaseDirName = "library-cache-binding-run"
let FunctionValuedBindingNamedRunProgramSource = "typealias Tally = int(0 to 1000)\n\nlet run = function(amount Tally) gives amount + 3\n\nfunction main() returns ExitCode\n\tlet seed = 21\n\tlet words = \"seed \{seed\} grows\".split(\" \")\n\twords.insert(0, value: \"then\")\n\tlet word = try words.get(2) otherwise \"\"\n\tlet length = word.byteLength() as Tally\n\tlet extra = run(5)\n\treturn (length + seed + extra) as ExitCode\nend 'main'\n"
let FunctionValuedBindingNamedRunProgramExitCode = 31

test 'a program that adds a top-level function-valued binding named like a call the library forwards sweeps the library itself and builds the bytes a cold build writes'
	requireHeldOutsideCheckout(LibraryCacheFunctionValuedBindingNamedRunCaseDirName, check: BuiltInSequenceMatchesCold.create([SequencedProgram.create(FunctionValuedBindingNamedRunProgramSource, exitCode: FunctionValuedBindingNamedRunProgramExitCode, subject: "a program that adds a top-level function-valued binding named `run`, a name library functions return a call of", expectation: LibraryCacheExpectation.leavesTheBaselineUnused)]))
end 'a program that adds a top-level function-valued binding named like a call the library forwards sweeps the library itself and builds the bytes a cold build writes'
