let LintWithTestsCleanCaseDirName = "lint-with-tests-clean"
let LintWithTestsCleanFixture = "lint-tests-clean"

test 'lint --tests of a clean test project with no main exits 0 and prints one Linted line'
	requireHeldOutsideCheckout(LintWithTestsCleanCaseDirName, check: LintOfATestProjectCase.of(LintWithTestsCleanFixture, findings: ExpectedDiagnosticArray.create(0)))
end 'lint --tests of a clean test project with no main exits 0 and prints one Linted line'
