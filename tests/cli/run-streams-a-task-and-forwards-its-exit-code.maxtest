let RunStreamsATaskAndForwardsItsExitCodeCaseDirName = "run-streams-a-task-and-forwards-its-exit-code"
let RunStreamsATaskAndForwardsItsExitCodeTaskFileName = "tasks.maxtasks"
let RunStreamsATaskAndForwardsItsExitCodeTaskGreeting = "the task spoke"

let RunStreamsATaskAndForwardsItsExitCodeTasksSource = "export typealias ExitCode = int(0 to 255)\n\nexport function report() returns ExitCode\n\tfor argument in CommandLine.args() 'eachArgument'\n\t\tprint(argument)\n\t\tprint(\"\\n\")\n\tend 'eachArgument'\n\n\tprint(\"the task spoke\\n\")\n\treturn 7\nend 'report'\n"

test 'a task prints on the callers stdout and its exit code is the commands'
	let dir = freshCaseDir(RunStreamsATaskAndForwardsItsExitCodeCaseDirName)
	let tasks = dir.join(RunStreamsATaskAndForwardsItsExitCodeTaskFileName)
	writeStagedFile(tasks, content: RunStreamsATaskAndForwardsItsExitCodeTasksSource)

	let ran = spawnCompiler([RunCommandWord, "report", "alpha"], staged: dir)
	let said = "It wrote to stdout: {ran.stdout} and to stderr: {ran.stderr}"

	Expect.equal(ran.exitCode(), expected: TaskExitCode, message: "`maxon {RunCommandWord} report` did not exit with the code the task returned. {said}")
	Expect.contains(ran.stdout, needle: RunStreamsATaskAndForwardsItsExitCodeTaskGreeting, message: "the task's own stdout did not reach the caller. {said}")
	Expect.contains(ran.stdout, needle: "alpha", message: "the task did not receive the argument typed after its name. {said}")

	discardStagedDir(dir)
end 'a task prints on the callers stdout and its exit code is the commands'
