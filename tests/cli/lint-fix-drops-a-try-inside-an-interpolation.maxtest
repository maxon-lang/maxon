let LintFixTryInInterpolationFixture = "lint-fix-try-inside-an-interpolation"
let LintFixTryInInterpolationFindings = 1
let LintFixTryInInterpolationPrinted = "3 units\n"

test 'lint --fix drops a try and its otherwise value inside an interpolation and keeps the rest of the string, and the program prints what it printed'
	requireHeldOutsideCheckout(LintFixTryInInterpolationFixture, check: lintFixRunningCase(LintFixTryInInterpolationFixture, findings: LintFixTryInInterpolationFindings, printed: LintFixPrinted.exactly(LintFixTryInInterpolationPrinted)))
end 'lint --fix drops a try and its otherwise value inside an interpolation and keeps the rest of the string, and the program prints what it printed'
