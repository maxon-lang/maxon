// cache-reports-what-it-holds.maxtest — bare `maxon cache` ANSWERS: it names the root a run uses and
// states how many builds are cached there, and exits 0.
//
// ⭐⭐ **A BUILD IS THE EXECUTABLE, AND THE SIDECAR BESIDE IT IS NOT ONE.** Every published build carries a
// `.mxdbg`, so a count taken over FILES reports double what the cache holds — and double reads exactly
// like an honest number. Two builds are published rather than one, because a count that is really the file
// count, or a constant, passes a one-build case perfectly.

let CaseDirName = "cache-reports-what-it-holds"

// A second program under a second NAME, because a slot is keyed on the program's path: the same file
// cached twice is one build superseding another.
let SecondProgramFileName = "second.maxon"
let PublishedBuilds = 2

test 'bare cache names the root in use and states how many builds it holds'
	let dir = freshCaseDir(CaseDirName)
	let cacheRoot = cacheRootIn(dir)

	publishCachedBuild(dir, cacheRoot: cacheRoot)
	publishCachedBuild(dir, cacheRoot: cacheRoot, program: SecondProgramFileName)

	let owned = cacheRoot.join(CacheVendorDirName)
	let planted = filesUnder(owned).count() as AssertedInt

	// ⚠ Without this the assertion below cannot tell a build count from a file count, and a driver counting
	// sidecars would satisfy both.
	Expect.greaterThan(planted, than: PublishedBuilds, message: "the gate could not run - {owned.toString()} holds {planted} files for {PublishedBuilds} published builds, so a report counting FILES and one counting BUILDS state the same number here and this case cannot tell them apart")

	let reported = runWithCacheRoot([CacheCommandWord], cacheRoot: cacheRoot, workingDirectory: dir)
	let said = "It wrote to stdout: {reported.stdout} and to stderr: {reported.stderr}"

	Expect.equal(reported.exitCode() as AssertedInt, expected: 0, message: "`maxon {CacheCommandWord}` did not succeed over a cache holding {PublishedBuilds} builds. Asking what is cached is a question, not a mistake. {said}")
	Expect.isEmpty(reported.stderr.trim(), message: "`maxon {CacheCommandWord}` wrote to stderr while answering. The report is what the command was asked for and belongs on stdout. {said}")

	let state = try reportedStateOf(reported.stdout, directory: owned) otherwise panic("{CaseDirName}: `maxon {CacheCommandWord}` named no line for {owned.toString()}, the root it was pointed at through {CacheRootVariable}. {said}")

	let counted = try reportedTally(state) otherwise panic("{CaseDirName}: `maxon {CacheCommandWord}` stated no count for {owned.toString()}, so there is no number to compare. It said of it: {state}")
	Expect.equal(counted, expected: PublishedBuilds, message: "`maxon {CacheCommandWord}` reported {counted} for {owned.toString()} where {PublishedBuilds} builds and {planted} files are on disk. A `.mxdbg` sidecar is not a build. {said}")
end 'bare cache names the root in use and states how many builds it holds'
