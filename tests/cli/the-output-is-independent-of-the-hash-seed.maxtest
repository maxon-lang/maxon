let TheOutputIsIndependentOfTheHashSeedCaseDirName = "output-independent-of-hash-seed"
let TheOutputIsIndependentOfTheHashSeedFixtureDirName = "tests/cli/fixtures/hash-seed-independent-output"
let PlainBuildLabel = "plain"
let DebugStreamBuildLabel = "debugstream"
let EnumLookupHelpers = ["__enum_from_raw_Colour", "__enum_from_raw_Weekday", "__enum_from_name_Planet", "__enum_from_name_Suit", "__enum_from_name_Mineral", "__enum_from_name_Instrument", "__enum_from_name_Reading", "__enum_from_name_Reading#celsius"]

test 'builds of one program under three hash seeds write the same bytes'
	requireHeldOutsideCheckout(TheOutputIsIndependentOfTheHashSeedCaseDirName, check: OutputIsIndependentOfTheHashSeed.create())
end 'builds of one program under three hash seeds write the same bytes'

type OutputIsIndependentOfTheHashSeed implements OutsideCheckoutCase, EnvironmentCellCheck
	static function create() returns OutputIsIndependentOfTheHashSeed
		return Self{}
	end 'create'

	export function requireHeldIn(dir FilePath) throws TestFailure
		let app = stagingDir(dir.join(AppDirName).toString())
		stageStoredTree(fixtureDir(TheOutputIsIndependentOfTheHashSeedFixtureDirName), into: app)

		let programs = GateProgramArray.create(0)
		programs.push(GateProgram.built(PlainBuildLabel, program: AppDirName, options: StringArray.create(0)))
		programs.push(GateProgram.built(DebugStreamBuildLabel, program: AppDirName, options: [DebugStreamFlag]))

		try requireIndependentOfTheEnvironment(try processHashSeedAxis(dir), programs: programs, staged: dir, check: self)
	end 'requireHeldIn'

	function requireAfterRun(outcome GateOutcome) throws TestFailure
		requireEveryLookupHelperIn(outcome.sidecar)
	end 'requireAfterRun'

	function requireAfterEnvironment(_ EnvironmentRun) throws TestFailure
		return
	end 'requireAfterEnvironment'
end 'OutputIsIndependentOfTheHashSeed'

function requireEveryLookupHelperIn(sidecar FilePath)
	let bytes = fileBytes(sidecar)

	for helper in EnumLookupHelpers 'eachHelper'
		if not bytes.containsSequence(bytesOfText(helper)) 'notEmitted'
			panic("the-output-is-independent-of-the-hash-seed: the gate could not run - {sidecar.toString()} names no '{helper}', so the fixture no longer reaches the enum lookup helpers whose emission order this case exists to hold.")
		end 'notEmitted'
	end 'eachHelper'
end 'requireEveryLookupHelperIn'
