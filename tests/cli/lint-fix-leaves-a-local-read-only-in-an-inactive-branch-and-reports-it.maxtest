let LintFixConditionalLocalCaseDirName = "lint-fix-cond-local"
let LintFixConditionalLocalFixture = "lint-fix-conditional-unused-local"
let LintFixConditionalLocalCode = "E3012"
let LintFixConditionalLocalSite = "main.maxon:2:6"
let LintFixConditionalLocalMessage = "unused variable: 'n'"

test 'lint --fix rewrites nothing in a file holding a conditional-compilation directive, so a local read only inside a branch inactive on this host is left and reported'
	let outcome = lintFixRefusedWith(ExpectedDiagnostic.at(LintFixConditionalLocalCode, site: LintFixConditionalLocalSite, message: LintFixConditionalLocalMessage))
	requireHeldOutsideCheckout(LintFixConditionalLocalCaseDirName, check: LintFixCase.of(LintFixConditionalLocalFixture, arguments: [AppDirName], fixed: LintFixedFileArray.create(0), outcome: outcome))
end 'lint --fix rewrites nothing in a file holding a conditional-compilation directive, so a local read only inside a branch inactive on this host is left and reported'
