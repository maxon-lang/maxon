let LibraryCacheRangedAliasOfTheLibraryRangeCaseDirName = "library-cache-alias-library-range"
let RangedAliasOfTheLibraryRangeSleepingProgramSource = "typealias Tally = int(0 to 1000)\n\nfunction main() returns ExitCode\n\tlet seed = 21\n\tlet words = \"seed \{seed\} grows\".split(\" \")\n\twords.insert(0, value: \"then\")\n\tlet word = try words.get(2) otherwise \"\"\n\tlet length = word.byteLength() as Tally\n\tsleep(1)\n\treturn (length + seed) as ExitCode\nend 'main'\n"
let RangedAliasOfTheLibraryRangeFirstProgramSource = "typealias Tally = int(0 to 1000)\ntypealias Milliseconds = int(0 to u64.max)\n\nfunction narrowed(value Milliseconds) returns Tally\n\treturn value as Tally\nend 'narrowed'\n\nfunction main() returns ExitCode\n\tlet seed = 21\n\tlet words = \"seed \{seed\} grows\".split(\" \")\n\twords.insert(0, value: \"then\")\n\tlet word = try words.get(2) otherwise \"\"\n\tlet length = word.byteLength() as Tally\n\tsleep(1)\n\tlet extra = narrowed(7)\n\treturn (length + seed + extra) as ExitCode\nend 'main'\n"
let RangedAliasOfTheLibraryRangeFirstProgramExitCode = 30
let RangedAliasOfTheLibraryRangeSecondProgramSource = "typealias Tally = int(0 to 1000)\ntypealias Milliseconds = int(0 to 5000)\n\nfunction narrowed(value Milliseconds) returns Tally\n\treturn value as Tally\nend 'narrowed'\n\nfunction main() returns ExitCode\n\tlet seed = 21\n\tlet words = \"seed \{seed\} grows\".split(\" \")\n\twords.insert(0, value: \"then\")\n\tlet word = try words.get(2) otherwise \"\"\n\tlet length = word.byteLength() as Tally\n\tsleep(1)\n\tlet extra = narrowed(9)\n\treturn (length + seed + extra) as ExitCode\nend 'main'\n"
let RangedAliasOfTheLibraryRangeSecondProgramExitCode = 32

test 'a program declaring a ranged alias with the range the library gives it is served the library parses of another program declaring that alias'
	requireHeldOutsideCheckout(LibraryCacheRangedAliasOfTheLibraryRangeCaseDirName, check: BuiltInSequenceMatchesCold.create([SequencedProgram.create(RangedAliasOfTheLibraryRangeFirstProgramSource, exitCode: RangedAliasOfTheLibraryRangeFirstProgramExitCode, subject: "a program that declares a `Milliseconds` alias with the range of the library's, beside a `sleep` that takes the library's, built after a program that declares none", expectation: LibraryCacheExpectation.loadsTheBaselineAndParsesTheLibrary), SequencedProgram.create(RangedAliasOfTheLibraryRangeSecondProgramSource, exitCode: RangedAliasOfTheLibraryRangeSecondProgramExitCode, subject: "a program that declares a `Milliseconds` alias of another range than the `Milliseconds` of the program before it", expectation: LibraryCacheExpectation.servedEveryParse)], first: RangedAliasOfTheLibraryRangeSleepingProgramSource))
end 'a program declaring a ranged alias with the range the library gives it is served the library parses of another program declaring that alias'
