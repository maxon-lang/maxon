let LintFixConditionalAcrossUnexportedCaseDirName = "lint-fix-cond-across-unexported"
let LintFixConditionalAcrossUnexportedFixture = "lint-fix-conditional-cross-file-unexported"

test 'lint --fix counts an unexported function another file names only inside a branch inactive on this host as used, rewrites nothing and says linted'
	requireHeldOutsideCheckout(LintFixConditionalAcrossUnexportedCaseDirName, check: LintFixCase.of(LintFixConditionalAcrossUnexportedFixture, arguments: [AppDirName], fixed: LintFixedFileArray.create(0), outcome: LintFixOutcome.linted(AppDirName)))
end 'lint --fix counts an unexported function another file names only inside a branch inactive on this host as used, rewrites nothing and says linted'
