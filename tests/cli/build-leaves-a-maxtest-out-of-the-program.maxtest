let CaseDirName = "build-leaves-a-maxtest-out-of-the-program"
let ProjectDirName = "project"
let OutputStem = "program"
let TestFileName = "pricing.maxtest"
let MainSource = "function main() returns ExitCode\n\treturn 0\nend 'main'\n"
let TestSource = "function main() returns ExitCode\n\treturn 1\nend 'main'\n\ntest 'a test the program never carries'\n\tExpect.isTrue(true)\nend 'a test the program never carries'\n"

test 'a directory build compiles its .maxon sources and never a .maxtest beside them'
	let dir = freshCaseDir(CaseDirName)
	let project = stagingDir(dir.join(ProjectDirName).toString())

	for (name, content) in [(StagedProgramFileName, MainSource), (TestFileName, TestSource)] 'eachFile'
		writeStagedFile(project.join(name), content: content)
	end 'eachFile'

	let build = spawnCompiler([BuildCommandWord, project.toString(), "{OutputOptionPrefix}{dir.join(OutputStem).toString()}"])
	let said = "It wrote to stdout: {build.stdout} and to stderr: {build.stderr}"

	Expect.equal(build.exitCode(), expected: 0, message: "a directory build beside `{TestFileName}` did not succeed; a test file joined the program, where its second `main` collides with the program's own. {said}")
	Expect.isTrue(File.exists(dir.join("{OutputStem}{executableSuffix()}")), message: "the build exited 0 and wrote no executable. {said}")
end 'a directory build compiles its .maxon sources and never a .maxtest beside them'
