let CaseDirName = "library-cache-another-schema"
let ProgramDirName = "app"
let OutputName = "program"
let ColdImageName = "cold-image"

test 'an entry carrying the fingerprint of another codec schema is rejected, and the build is the cold one'
	requireHeldOutsideCheckout(CaseDirName, check: AnotherSchemaIsRejected.create())
end 'an entry carrying the fingerprint of another codec schema is rejected, and the build is the cold one'

type AnotherSchemaIsRejected implements OutsideCheckoutCase
	static function create() returns AnotherSchemaIsRejected
		return Self{}
	end 'create'

	export function requireHeldIn(dir FilePath) throws TestFailure
		stageProgram(dir, name: ProgramDirName, source: TrivialProgramSource)

		let image = dir.join("{OutputName}{executableSuffix()}")

		let cold = try libraryCacheReportOf(runLibraryCacheBuild(dir, program: ProgramDirName, output: OutputName, options: ListedWordArray.create()), which: "the cold build")
		try Expect.greaterThan(cold.written, than: 0, message: "the cold build wrote nothing to the library cache, so there is no entry to alter. It wrote: {cold.line}")

		let coldImage = retainedAside(image, aside: dir.join(ColdImageName))
		let entry = viewsEntryIn(dir)
		rewrittenFile(entry, bytes: entryWithAnotherSchema(bytesOf(entry)))

		let build = runLibraryCacheBuild(dir, program: ProgramDirName, output: OutputName, options: ListedWordArray.create())
		let rejected = try libraryCacheReportOf(build, which: "the build over an entry of another codec schema")
		try Expect.atLeast(rejected.rejected, than: 1, message: "the build over an entry carrying the fingerprint of another codec schema rejected nothing. It wrote: {rejected.line}")
		try Expect.contains(build.stderr, needle: AnotherSchemaReason, message: "the build rejected the entry for another reason than its codec schema. It wrote to stderr: {build.stderr}")
		try requireSameBytes(coldImage, second: image, why: "the build over an entry of another codec schema wrote an executable that is not the cold build's.")

		let repaired = try libraryCacheReportOf(runLibraryCacheBuild(dir, program: ProgramDirName, output: OutputName, options: ListedWordArray.create()), which: "the build after the entry was rewritten")
		try Expect.equal(repaired.rejected, expected: 0, message: "the build after the entry was rewritten rejected entries again. It wrote: {repaired.line}")
	end 'requireHeldIn'
end 'AnotherSchemaIsRejected'
