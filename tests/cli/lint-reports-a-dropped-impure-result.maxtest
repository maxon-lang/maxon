let LintReportsADroppedImpureResultCaseDirName = "lint-reports-a-dropped-impure-result"
let LintReportsADroppedImpureResultFixture = "lint-dropped-impure-result"
let LintReportsADroppedImpureResultSite = "main.maxon:11:2"
let LintReportsADroppedImpureResultMessage = "result of 'announced' is not used (use '_ = expr' to discard)"

test 'lint reports a dropped impure result and writes no executable'
	let expected = ExpectedDiagnostic.at(DroppedImpureResultCode, site: LintReportsADroppedImpureResultSite, message: LintReportsADroppedImpureResultMessage)
	requireHeldOutsideCheckout(LintReportsADroppedImpureResultCaseDirName, check: LintRefusalCase.reporting(LintReportsADroppedImpureResultFixture, diagnostic: expected))
end 'lint reports a dropped impure result and writes no executable'
