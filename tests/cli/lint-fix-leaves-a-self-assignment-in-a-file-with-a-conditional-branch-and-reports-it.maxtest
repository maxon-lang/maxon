let LintFixConditionalSelfCaseDirName = "lint-fix-cond-self"
let LintFixConditionalSelfFixture = "lint-fix-conditional-self-assignment"
let LintFixConditionalSelfCode = "E3067"
let LintFixConditionalSelfSite = "main.maxon:11:3"
let LintFixConditionalSelfMessage = "self-assignment has no effect: 'total = total'"

test 'lint --fix rewrites nothing in a file holding a conditional-compilation directive, so a self-assignment beside an inactive branch of its block is left and reported'
	let outcome = lintFixRefusedWith(ExpectedDiagnostic.at(LintFixConditionalSelfCode, site: LintFixConditionalSelfSite, message: LintFixConditionalSelfMessage))
	requireHeldOutsideCheckout(LintFixConditionalSelfCaseDirName, check: LintFixCase.of(LintFixConditionalSelfFixture, arguments: [AppDirName], fixed: LintFixedFileArray.create(0), outcome: outcome))
end 'lint --fix rewrites nothing in a file holding a conditional-compilation directive, so a self-assignment beside an inactive branch of its block is left and reported'
