// build-output-that-is-not-a-path-is-an-error.test.maxon - an `-o` value no path can be made of is refused
// like any other bad build input: exit 1 and a message naming the value, never a compiler panic. A URL whose
// scheme is not `file` is not a path on any host.

let CaseDirName = "build-output-that-is-not-a-path"
let MainFileName = "main.maxon"
let MainSource = "function main() returns ExitCode\n\treturn 0\nend 'main'\n"
let UnspellableOutput = "http://example.com/program"
let PanicMarker = "panic"

test 'an -o value that is not a path is an error, not a panic'
	let dir = freshCaseDir(CaseDirName)
	let source = dir.join(MainFileName)
	try File.writeText(source, content: MainSource) otherwise panic("build-output-that-is-not-a-path: the gate could not run - could not write {source.toString()}")

	let build = runDriver([BuildCommandWord, source.toString(), OutputFlag, UnspellableOutput])
	let said = "It wrote to stdout: {build.stdout} and to stderr: {build.stderr}"

	try Expect.equal(build.exitCode() as AssertedInt, expected: 1, message: "`-o {UnspellableOutput}` did not exit 1. {said}")
	try Expect.contains(build.stderr, needle: UnspellableOutput, message: "the refusal does not name the `-o` value it refused. {said}")
	try Expect.isFalse(build.stderr.contains(PanicMarker), message: "the refusal is a panic rather than an error. {said}")
end 'an -o value that is not a path is an error, not a panic'
