let LintReportsADiscardedPureResultCaseDirName = "lint-reports-a-discarded-pure-result"
let LintReportsADiscardedPureResultFixture = "lint-discarded-pure-result"
let LintReportsADiscardedPureResultSite = "main.maxon:10:2"
let LintReportsADiscardedPureResultMessage = "result of pure function 'doubled' must be used"

test 'lint reports a discarded pure result and writes no executable'
	let expected = ExpectedDiagnostic.at(DiscardedPureResultCode, site: LintReportsADiscardedPureResultSite, message: LintReportsADiscardedPureResultMessage)
	requireHeldOutsideCheckout(LintReportsADiscardedPureResultCaseDirName, check: LintRefusalCase.reporting(LintReportsADiscardedPureResultFixture, diagnostic: expected))
end 'lint reports a discarded pure result and writes no executable'
