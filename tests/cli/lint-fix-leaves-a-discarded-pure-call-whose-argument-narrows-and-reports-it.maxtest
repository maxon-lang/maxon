let LintFixPureThatNarrowsCaseDirName = "lint-fix-pure-narrows"
let LintFixPureThatNarrowsFixture = "lint-fix-pure-call-that-narrows"
let LintFixPureThatNarrowsSite = "main.maxon:11:2"
let LintFixPureThatNarrowsMessage = "result of pure function 'narrowed' must be used"

test 'lint --fix leaves a discarded pure call whose argument is a range-checked narrowing, whose deletion would remove the abort, and reports it'
	let outcome = lintFixRefusedWith(ExpectedDiagnostic.at(DiscardedPureResultCode, site: LintFixPureThatNarrowsSite, message: LintFixPureThatNarrowsMessage))
	requireHeldOutsideCheckout(LintFixPureThatNarrowsCaseDirName, check: LintFixCase.of(LintFixPureThatNarrowsFixture, arguments: [AppDirName], fixed: LintFixedFileArray.create(0), outcome: outcome))
end 'lint --fix leaves a discarded pure call whose argument is a range-checked narrowing, whose deletion would remove the abort, and reports it'
