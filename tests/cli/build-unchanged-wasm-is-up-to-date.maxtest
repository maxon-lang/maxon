let BuildUnchangedWasmIsUpToDateCaseDirName = "build-unchanged-wasm-is-up-to-date"
let OutputFileName = "program.wasm"

test 'a wasm build whose inputs are unchanged since the last compile is up to date and writes nothing'
	let dir = freshCaseDirInTree(BuildUnchangedWasmIsUpToDateCaseDirName)
	requireASecondBuildIsUpToDate(dir, output: OutputFileName, options: [WasmTargetOption])

	discardStagedDir(dir)
end 'a wasm build whose inputs are unchanged since the last compile is up to date and writes nothing'
