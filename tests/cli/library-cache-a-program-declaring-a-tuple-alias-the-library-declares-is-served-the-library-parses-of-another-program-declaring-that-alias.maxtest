let LibraryCacheTupleAliasCaseDirName = "library-cache-alias-tuple"
let TupleAliasFirstProgramSource = "typealias Tally = int(0 to 1000)\ntypealias AesPair = (Tally, Tally)\n\nfunction pair() returns AesPair\n\treturn (3, 4)\nend 'pair'\n\nfunction main() returns ExitCode\n\tlet seed = 21\n\tlet words = \"seed \{seed\} grows\".split(\" \")\n\twords.insert(0, value: \"then\")\n\tlet word = try words.get(2) otherwise \"\"\n\tlet length = word.byteLength() as Tally\n\tlet both = pair()\n\tlet extra = both.0 + both.1\n\treturn (length + seed + extra) as ExitCode\nend 'main'\n"
let TupleAliasFirstProgramExitCode = 30
let TupleAliasSecondProgramSource = "typealias Tally = int(0 to 1000)\ntypealias AesPair = (Tally, Tally, Tally)\n\nfunction pair() returns AesPair\n\treturn (3, 4, 5)\nend 'pair'\n\nfunction main() returns ExitCode\n\tlet seed = 21\n\tlet words = \"seed \{seed\} grows\".split(\" \")\n\twords.insert(0, value: \"then\")\n\tlet word = try words.get(2) otherwise \"\"\n\tlet length = word.byteLength() as Tally\n\tlet all = pair()\n\tlet extra = all.0 + all.1 + all.2\n\treturn (length + seed + extra) as ExitCode\nend 'main'\n"
let TupleAliasSecondProgramExitCode = 35

test 'a program declaring a tuple alias the library declares is served the library parses of another program declaring that alias'
	requireHeldOutsideCheckout(LibraryCacheTupleAliasCaseDirName, check: BuiltInSequenceMatchesCold.create([SequencedProgram.create(TupleAliasFirstProgramSource, exitCode: TupleAliasFirstProgramExitCode, subject: "a program that declares an `AesPair` tuple alias of its own, built after a program that declares none", expectation: LibraryCacheExpectation.loadsTheBaselineAndParsesTheLibrary), SequencedProgram.create(TupleAliasSecondProgramSource, exitCode: TupleAliasSecondProgramExitCode, subject: "a program that declares an `AesPair` tuple alias of another shape than the `AesPair` of the program before it", expectation: LibraryCacheExpectation.servedEveryParse)]))
end 'a program declaring a tuple alias the library declares is served the library parses of another program declaring that alias'
