let OneRungFlag = "--rungs=1"

test 'scale-test compiles and runs its generated rung 0, with every witness holding'
	let run = runDriver([ScaleTestCommandWord, OneRungFlag])

	Expect.equal(run.exitCode(), expected: 0, message: "`maxon {ScaleTestCommandWord} {OneRungFlag}` did not deliver rung 0. The ladder compiles the corpus it generates and runs it, so a generated program the compiler refuses, or a witness that does not hold, leaves the instrument measuring nothing. stdout:\n{run.stdout}\nstderr:\n{run.stderr}")
end 'scale-test compiles and runs its generated rung 0, with every witness holding'
