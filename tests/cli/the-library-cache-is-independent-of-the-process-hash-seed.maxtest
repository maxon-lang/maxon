let TheLibraryCacheIsIndependentOfTheProcessHashSeedCaseDirName = "library-cache-independent-of-process-hash-seed"
let TheLibraryCacheIsIndependentOfTheProcessHashSeedFixtureDirName = "tests/cli/fixtures/library-cache-seed-independent"
let TupleProgramDirName = "tuples"
let TemplateProgramDirName = "template"
let ContestsProgramDirName = "contests"
let AliasesProgramDirName = "aliases"
let TupleLintLabel = "tuples-lint"

test 'builds and a lint under three process hash seeds from one stored library hash seed write the same library cache packs'
	requireHeldOutsideCheckout(TheLibraryCacheIsIndependentOfTheProcessHashSeedCaseDirName, check: LibraryCacheIsIndependentOfTheProcessHashSeed.create())
end 'builds and a lint under three process hash seeds from one stored library hash seed write the same library cache packs'

type LibraryCacheIsIndependentOfTheProcessHashSeed implements OutsideCheckoutCase, EnvironmentCellCheck
	static function create() returns LibraryCacheIsIndependentOfTheProcessHashSeed
		return Self{}
	end 'create'

	export function requireHeldIn(dir FilePath) throws TestFailure
		stageStoredTree(fixtureDir(TheLibraryCacheIsIndependentOfTheProcessHashSeedFixtureDirName), into: dir)

		let programs = GateProgramArray.create(0)

		for program in [ContestsProgramDirName, TupleProgramDirName, TemplateProgramDirName, AliasesProgramDirName] 'eachBuiltProgram'
			programs.push(GateProgram.built(program, program: program, options: [CompilerDebugLogFlag]))
		end 'eachBuiltProgram'

		programs.push(GateProgram.linted(TupleLintLabel, program: TupleProgramDirName, options: [CompilerDebugLogFlag]))

		try requireIndependentOfTheEnvironment(try processHashSeedAxis(dir), programs: programs, staged: dir, check: self)
	end 'requireHeldIn'

	function requireAfterRun(outcome GateOutcome) throws TestFailure
		let report = try libraryCacheReportOf(outcome.output, which: outcome.which)
		try Expect.equal(report.rejected, expected: 0, message: "{outcome.which} rejected library cache entries, so it did not read them under the stored seed. It wrote: {report.line}")

		let label = outcome.program.label

		if label == ContestsProgramDirName 'theContests'
			try Expect.equal(report.baseline, expected: LibraryBaseline.built, message: "{outcome.which}, whose contests are between its own directories and name nothing the library declares, did not build the library baseline into its empty cache. It wrote: {report.line}")
			try Expect.isTrue(packsOfKindIn(outcome.environment.library(), prefix: ParsesEntryPrefix).count() > 0, message: "{outcome.which} wrote no `{ParsesEntryPrefix}` pack, so the library parses it settled reached no pack. It wrote: {report.line}")
		end 'theContests' else if label == TupleProgramDirName 'theTuples'
			try Expect.greaterThan(report.written, than: 0, message: "{outcome.which} wrote no library cache entry. It wrote: {report.line}")
		end 'theTuples' else if label == TemplateProgramDirName 'theTemplate'
			try Expect.equal(report.baseline, expected: LibraryBaseline.built, message: "{outcome.which}, which instantiates a library generic function, did not build the core library baseline. It wrote: {report.line}")
		end 'theTemplate' else if label == AliasesProgramDirName 'theAliases'
			try Expect.greaterThan(report.written, than: 0, message: "{outcome.which}, whose aliases contest the library's, wrote no library cache entry, so the library parses it settled under the contest reached no pack. It wrote: {report.line}")
		end 'theAliases' else if label != TupleLintLabel 'anUnknownProgram'
			panic("the-library-cache-is-independent-of-the-process-hash-seed: no check is written for the program labelled `{label}`")
		end 'anUnknownProgram'
	end 'requireAfterRun'

	function requireAfterEnvironment(run EnvironmentRun) throws TestFailure
		let library = run.environment.library()

		for prefix in [BaselineEntryPrefix, CoreEntryPrefix, ParsesEntryPrefix, ViewsEntryPrefix, AuditEntryPrefix] 'eachKind'
			let packs = packsOfKindIn(library, prefix: prefix)
			try Expect.isTrue(packs.count() > 0, message: "the runs {run.environment.description} wrote no `{prefix}` pack under {library.toString()}, so there is none to compare.")

			for pack in packs 'eachPack'
				try Expect.isTrue(fileBytes(pack).count() > 0, message: "the runs {run.environment.description} wrote the `{prefix}` pack {pack.toString()} empty, so there is nothing in it to compare.")
			end 'eachPack'
		end 'eachKind'
	end 'requireAfterEnvironment'
end 'LibraryCacheIsIndependentOfTheProcessHashSeed'
