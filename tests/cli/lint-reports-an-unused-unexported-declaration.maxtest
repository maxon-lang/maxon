let LintReportsAnUnusedUnexportedCaseDirName = "lint-reports-an-unused-unexported"
let LintReportsAnUnusedUnexportedFixture = "lint-unused-unexported"
let LintReportsAnUnusedUnexportedSite = "main.maxon:5:10"

test 'lint reports an unexported declaration nothing live in its directory names and writes no executable'
	let expected = ExpectedDiagnostic.at(UnusedUnexportedCode, site: LintReportsAnUnusedUnexportedSite, message: UnusedLeftoverMessage)
	requireHeldOutsideCheckout(LintReportsAnUnusedUnexportedCaseDirName, check: LintRefusalCase.reporting(LintReportsAnUnusedUnexportedFixture, diagnostic: expected))
end 'lint reports an unexported declaration nothing live in its directory names and writes no executable'
