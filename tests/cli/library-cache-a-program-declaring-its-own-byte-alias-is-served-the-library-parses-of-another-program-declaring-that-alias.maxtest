let LibraryCacheOwnByteAliasCaseDirName = "library-cache-alias-byte"
let OwnByteAliasReadingAByteProgramSource = "typealias Tally = int(0 to 1000)\n\nfunction main() returns ExitCode\n\tlet seed = 21\n\tlet words = \"seed \{seed\} grows\".split(\" \")\n\twords.insert(0, value: \"then\")\n\tlet word = try words.get(2) otherwise \"\"\n\tlet length = word.byteLength() as Tally\n\tlet first = (try word.toByteArray().get(0) otherwise 0) as Tally\n\treturn (length + seed + first) as ExitCode\nend 'main'\n"
let OwnByteAliasFirstProgramSource = "typealias Tally = int(0 to 1000)\ntypealias Byte = int(0 to 1000)\n\nfunction lowered(value Byte) returns Byte\n\treturn value - 290\nend 'lowered'\n\nfunction main() returns ExitCode\n\tlet seed = 21\n\tlet words = \"seed \{seed\} grows\".split(\" \")\n\twords.insert(0, value: \"then\")\n\tlet word = try words.get(2) otherwise \"\"\n\tlet length = word.byteLength() as Tally\n\tlet first = (try word.toByteArray().get(0) otherwise 0) as Tally\n\tlet extra = lowered(300) as Tally\n\treturn (length + seed + first + extra) as ExitCode\nend 'main'\n"
let OwnByteAliasFirstProgramExitCode = 83
let OwnByteAliasSecondProgramSource = "typealias Tally = int(0 to 1000)\ntypealias Byte = int(0 to 300)\n\nfunction lowered(value Byte) returns Byte\n\treturn value - 290\nend 'lowered'\n\nfunction main() returns ExitCode\n\tlet seed = 21\n\tlet words = \"seed \{seed\} grows\".split(\" \")\n\twords.insert(0, value: \"then\")\n\tlet word = try words.get(2) otherwise \"\"\n\tlet length = word.byteLength() as Tally\n\tlet first = (try word.toByteArray().get(0) otherwise 0) as Tally\n\tlet extra = lowered(295) as Tally\n\treturn (length + seed + first + extra) as ExitCode\nend 'main'\n"
let OwnByteAliasSecondProgramExitCode = 78

test 'a program declaring its own Byte alias is served the library parses of another program declaring that alias'
	requireHeldOutsideCheckout(LibraryCacheOwnByteAliasCaseDirName, check: BuiltInSequenceMatchesCold.create([SequencedProgram.create(OwnByteAliasFirstProgramSource, exitCode: OwnByteAliasFirstProgramExitCode, subject: "a program that declares a `Byte` alias ranged past the library's, beside a library `Byte` read from a string, built after a program that declares none", expectation: LibraryCacheExpectation.loadsTheBaselineAndParsesTheLibrary), SequencedProgram.create(OwnByteAliasSecondProgramSource, exitCode: OwnByteAliasSecondProgramExitCode, subject: "a program that declares a `Byte` alias of another range than the `Byte` of the program before it", expectation: LibraryCacheExpectation.servedEveryParse)], first: OwnByteAliasReadingAByteProgramSource))
end 'a program declaring its own Byte alias is served the library parses of another program declaring that alias'
