let LintWithTestsOfAManifestCaseDirName = "lint-with-tests-of-a-manifest"
let LintWithTestsOfAManifestFixture = "lint-manifest-program-clean"
let LintWithTestsOfAManifestManifest = "app.maxproj"
let LintWithTestsOfAManifestOption = "--tests"
let LintWithTestsOfAManifestWords = "whose program is not a test project"

test 'lint --tests of a manifest file is refused as a usage error and lints nothing'
	requireHeldOutsideCheckout(LintWithTestsOfAManifestCaseDirName, check: LintUsageRefusalCase.of(LintWithTestsOfAManifestFixture, arguments: [LintWithTestsOfAManifestOption, LintWithTestsOfAManifestManifest], words: [LintWithTestsOfAManifestWords, LintWithTestsOfAManifestOption, LintWithTestsOfAManifestManifest]))
end 'lint --tests of a manifest file is refused as a usage error and lints nothing'
