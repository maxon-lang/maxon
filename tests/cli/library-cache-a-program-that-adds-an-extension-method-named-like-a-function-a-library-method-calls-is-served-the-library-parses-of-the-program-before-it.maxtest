let LibraryCacheExtensionMethodNamedLikeALibraryFunctionCaseDirName = "library-cache-extension-method"
let ExtensionMethodNamedLikeALibraryFunctionProgramSource = "typealias Tally = int(0 to 1000)\n\nextension String\n\tfunction scanIsAscii() returns Tally\n\t\treturn 7\n\tend 'scanIsAscii'\nend 'String'\n\nfunction main() returns ExitCode\n\tlet seed = 21\n\tlet words = \"seed \{seed\} grows\".split(\" \")\n\twords.insert(0, value: \"then\")\n\tlet word = try words.get(2) otherwise \"\"\n\tlet length = word.byteLength() as Tally\n\tlet total = length + seed + word.scanIsAscii()\n\tlet ascii = \"a\\rb\".isAscii()\n\treturn (total + 1 if ascii else total) as ExitCode\nend 'main'\n"
let ExtensionMethodNamedLikeALibraryFunctionProgramExitCode = 31

test 'a program that adds an extension method named like a function a library method calls is served the library parses of the program before it'
	requireHeldOutsideCheckout(LibraryCacheExtensionMethodNamedLikeALibraryFunctionCaseDirName, check: BuiltInSequenceMatchesCold.create([SequencedProgram.create(ExtensionMethodNamedLikeALibraryFunctionProgramSource, exitCode: ExtensionMethodNamedLikeALibraryFunctionProgramExitCode, subject: "a program that extends `String` with a method named `scanIsAscii`, a free function the library's `isAscii` calls bare", expectation: LibraryCacheExpectation.servedEveryParse)]))
end 'a program that adds an extension method named like a function a library method calls is served the library parses of the program before it'
