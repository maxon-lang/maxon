let LibraryCacheAddsAnInterfaceWithAByReferenceMethodCaseDirName = "library-cache-adds-by-reference-interface"
let AddsAnInterfaceWithAByReferenceMethodProgramSource = "typealias Tally = int(0 to 1000)\n\ninterface Scorer\n\tfunction scoreInto(total mutable Tally)\nend 'Scorer'\n\ntype Bonus implements Scorer\n\tvar points as Tally\n\n\tstatic function create(points Tally) returns Bonus\n\t\treturn Bonus\{points: points\}\n\tend 'create'\n\n\tfunction scoreInto(total mutable Tally)\n\t\ttotal = total + self.points\n\tend 'scoreInto'\nend 'Bonus'\n\nfunction scorerFor(points Tally) returns Scorer\n\treturn Bonus.create(points)\nend 'scorerFor'\n\nfunction main() returns ExitCode\n\tlet seed = 21\n\tlet words = \"seed \{seed\} grows\".split(\" \")\n\twords.insert(0, value: \"then\")\n\tlet word = try words.get(2) otherwise \"\"\n\tlet length = word.byteLength() as Tally\n\tlet scorer = scorerFor(50)\n\tvar total = length\n\tscorer.scoreInto(total)\n\treturn (total + seed) as ExitCode\nend 'main'\n"
let AddsAnInterfaceWithAByReferenceMethodProgramExitCode = 73

test 'a program that adds an interface whose method takes a mutable parameter is served the library parses of the program before it'
	requireHeldOutsideCheckout(LibraryCacheAddsAnInterfaceWithAByReferenceMethodCaseDirName, check: AddedFactIsServedTheLibrary.create(AddsAnInterfaceWithAByReferenceMethodProgramSource, exitCode: AddsAnInterfaceWithAByReferenceMethodProgramExitCode, fact: "an interface whose method takes a `mutable` parameter, a type implementing it and a call through it"))
end 'a program that adds an interface whose method takes a mutable parameter is served the library parses of the program before it'
