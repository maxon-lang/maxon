let CaseDirName = "census-by-tag"
let AppDirName = "app"
let MainSourceStem = "main"
let MainSource = "function main() returns ExitCode\n\treturn 0\nend 'main'\n"

let DebugLogFlag = "--log=compiler:debug"
let CensusByTagFlag = "--census-by-tag"

let ResidencyHeadline = "compile residency"
let CensusHeadline = "census by size class"
let CensusColumnTitle = "size class"
let CensusSelfCheck = "slabLiveBytes ="
let CensusRawSlots = "live slots carry no box header"

test 'the tag census is printed only when it is asked for'
	requireHeldOutsideCheckout(CaseDirName, check: CensusOnlyWhenAskedFor.create())
end 'the tag census is printed only when it is asked for'

type CensusOnlyWhenAskedFor implements OutsideCheckoutCase
	static function create() returns CensusOnlyWhenAskedFor
		return Self{}
	end 'create'

	export function requireHeldIn(dir FilePath) throws TestFailure
		let app = stagingDir(dir.join(AppDirName).toString())

		writeStagedFile(app.join("{MainSourceStem}{MaxonSourceSuffix}"), content: MainSource)

		let plain = spawnCompiler([BuildCommandWord, AppDirName, DebugLogFlag], staged: dir)
		let plainSaid = "It wrote to stderr: {plain.stderr}"
		try Expect.equal(plain.exitCode(), expected: 0, message: "a one-file directory did not build under {DebugLogFlag}. {plainSaid}")
		try Expect.isTrue(plain.stderr.contains(ResidencyHeadline), message: "{DebugLogFlag} printed no residency table, so this case cannot tell the census apart from it. {plainSaid}")
		try Expect.isFalse(plain.stderr.contains(CensusHeadline), message: "a build without {CensusByTagFlag} printed the census anyway. {plainSaid}")

		let censused = spawnCompiler([BuildCommandWord, AppDirName, DebugLogFlag, CensusByTagFlag], staged: dir)
		let said = "It wrote to stderr: {censused.stderr}"
		try Expect.equal(censused.exitCode(), expected: 0, message: "a one-file directory did not build under {CensusByTagFlag}. {said}")
		try Expect.isTrue(censused.stderr.contains(CensusHeadline), message: "{CensusByTagFlag} printed no census headline. {said}")
		try Expect.isTrue(censused.stderr.contains(CensusColumnTitle), message: "{CensusByTagFlag} printed no census table. {said}")
		try Expect.isTrue(censused.stderr.contains(CensusRawSlots), message: "{CensusByTagFlag} printed no raw-slot bound. {said}")
		try Expect.isTrue(censused.stderr.contains(CensusSelfCheck), message: "{CensusByTagFlag} printed no self-check line. {said}")
	end 'requireHeldIn'
end 'CensusOnlyWhenAskedFor'
