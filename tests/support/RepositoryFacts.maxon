// The suffix that marks a source file as test code, which an ordinary build's directory walk leaves
// out.
public let TestSourceSuffix = ".maxtest"
public let StagedProgramFileName = "main.maxon"
public let CacheRootVariable = "MAXON_RUN_CACHE_ROOT"

// ⭐ **THE ONE DIRECTORY MAXON OWNS UNDER THE ROOT THAT VARIABLE NAMES.** Everything the cache holds sits
// below it and nothing else in that root is Maxon's, so a case asks about THIS directory rather than
// respelling the slot layout under it — and the caller's own root, which the cache may not touch, is the
// directory above.
public let CacheVendorDirName = "maxon"
public let VersionRecordSuffix = ".mxpv"
public let WasmTargetOption = "--target=wasm32-wasi"
public let StdlibDirName = "stdlib"
public let OutputFileStem = "out"
public let MaxProcsVariableName = "MAXON_MAX_PROCS"
