let ParentComponent = ".."

public function requireStaysInStaging(component String)
	if component.contains(ParentComponent) 'climbsOut'
		panic("the gate could not run — '{component}' climbs out of the directory it names, and a staging call clears files under what it names.")
	end 'climbsOut'
end 'requireStaysInStaging'

public function requireOneDirectoryName(name String)
	requireStaysInStaging(name)

	if name.isEmpty() or name.contains(PortablePathSeparator) or name.contains(WindowsPathSeparator) 'notOneDirectory'
		panic("the gate could not run — '{name}' is not one directory name. Every case stages under a directory of its own, and a staging call clears the files in it.")
	end 'notOneDirectory'
end 'requireOneDirectoryName'

public function testScratchDir() returns FilePath
	return try TestScratch.outsideCheckout() otherwise panic("the gate could not run — this process has no test scratch directory, and a case stages outside the checkout only in the one `maxon test` made for this process. Run the corpus with `maxon test`.")
end 'testScratchDir'

public function projectScratchDir() returns FilePath
	return try TestScratch.insideProject() otherwise panic("the gate could not run — this process has no test project scratch directory, and a case stages inside the project only in the one `maxon test` made for this process. Run the corpus with `maxon test`.")
end 'projectScratchDir'

public function outsideCheckoutPath(caseDirName String) returns FilePath
	requireOneDirectoryName(caseDirName)

	return testScratchDir().join(caseDirName)
end 'outsideCheckoutPath'

public function freshOutsideCheckoutDir(caseDirName String) returns FilePath
	let dir = outsideCheckoutPath(caseDirName)
	requireNoCheckoutAbove(dir)

	return stagingDir(dir.toString())
end 'freshOutsideCheckoutDir'
