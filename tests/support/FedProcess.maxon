let FedProgram = "the program"
let FedTailSilenceMs = 1000
let FedTailCapMs = 10000

public union StagedRunEnd
	exited(code ExitInt)
	killedAtDeadline
end 'StagedRunEnd'

public type FedRun
	public let ending as StagedRunEnd
	public let stdout as String
	public let stderr as String

	public static function create(ending StagedRunEnd, stdout String, stderr String) returns FedRun
		return FedRun{ending: ending, stdout: stdout, stderr: stderr}
	end 'create'
end 'FedRun'

function stagedRunEndOf(ending ChildEnd) returns StagedRunEnd
	return match ending 'ending'
		exited(code) gives StagedRunEnd.exited(code)
		deadline gives StagedRunEnd.killedAtDeadline
		reapedElsewhere panic("{lostStatusMessage(FedProgram)}")
		waitFailed(e) panic("{waitFailureMessage(FedProgram, failure: e)}")
	end 'ending'
end 'stagedRunEndOf'

function fedRunOf(report ChildRunReport) returns FedRun
	requireSurvivorsEnded(report.survivors, what: "the fed program")

	return FedRun.create(stagedRunEndOf(report.ending), stdout: report.stdout, stderr: report.stderr)
end 'fedRunOf'

public function runFedAfterLine(executable FilePath, workingDirectory FilePath, environment Environment, deadlineMs WaitDeadlineMs, afterLine String, feed String) returns FedRun
	let outcome = try runChildFedAfterLine(Executable.path(executable), argv: StringArray.create(0), workingDirectory: WorkingDirectory.at(workingDirectory), environment: environment, deadlineMs: deadlineMs as DurationMs, endsWhen: RunEndsWhen.childExits, tailSilenceMs: FedTailSilenceMs, tailCapMs: FedTailCapMs, anchor: afterLine, feed: feed) otherwise (e) 'notRun'
		panic("the gate could not run — could not start the program at {executable.toString()} and take its output ({e.displayReason()}).")
	end 'notRun'

	return match outcome 'outcome'
		ran(report) gives fedRunOf(report)
		outputBroken(stream, reason, _) panic("{brokenReadMessage(FedProgram, stream: stream, reason: reason)}")
	end 'outcome'
end 'runFedAfterLine'
