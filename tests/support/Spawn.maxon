public let BuildCommandName = "build"
public let OutputOptionPrefix = "--output="

let WindowsShellName = "powershell"
let WindowsShellNoProfileFlag = "-NoProfile"
let WindowsShellCommandFlag = "-Command"
let PosixTouchName = "touch"
let PosixTouchTimeFlag = "-t"
let PosixYear2000Stamp = "200001010000"
let ProcessEndPollMs = 20
let FileHolderAnnouncementPrefix = "holding "
let FileHolderUntilReleasedWord = "untilReleased"
let FileHolderEndMs = 10000
let FileHolderWhat = "the file holder"
let HeldRunLongestMs = 100000
let HeldRunEndMs = 10000
let RemovalRefusalWording = "could not remove "

#if os(Windows)
	let WindowsLinkToolName = "cmd"
	let WindowsLinkToolRunFlag = "/c"
	let WindowsLinkToolCommand = "mklink"
	let WindowsJunctionFlag = "/J"
	let ExecutionPolicyFlag = "-ExecutionPolicy"
	let ExecutionPolicyBypass = "Bypass"
	let ScriptFileFlag = "-File"
	let FileHolderFixtureName = "fileholder"
	let FileHolderScriptName = "fileholder.ps1"
#else
	let PosixLinkToolName = "ln"
	let PosixSymbolicFlag = "-s"
	let PosixShellCommandFlag = "-c"
	let FileHolderShellArgumentZero = "fileholder"
#endif

#if not os(Windows)
	public let PosixShellPath = "/bin/sh"
#endif

public let CompilerUnderTestName = "the compiler under test"

public function runIn(executable Executable, arguments StringArray, staged FilePath, environment Environment = Environment.inherit, standardInput InputSource = InputSource.none, deadline WaitDeadline = WaitDeadline.none) returns CollectedOutput throws SubprocessError
	let config = Configuration.create(executable, workingDirectory: WorkingDirectory.at(staged))
	config.arguments = arguments.clone()
	config.environment = environment
	config.standardInput = standardInput
	config.deadline = deadline

	return try config.run()
end 'runIn'

public function spawnFailureMessage(what String, failure SubprocessError) returns String
	return "the gate could not run — could not spawn {what} ({failure.displayReason()})."
end 'spawnFailureMessage'

public function spawnIn(executable Executable, arguments StringArray, staged FilePath, what String, environment Environment = Environment.inherit, standardInput InputSource = InputSource.none, deadline WaitDeadline = WaitDeadline.none) returns CollectedOutput
	return try runIn(executable, arguments: arguments, staged: staged, environment: environment, standardInput: standardInput, deadline: deadline) otherwise (e) 'spawnFailed'
		panic("{spawnFailureMessage(what, failure: e)}")
	end 'spawnFailed'
end 'spawnIn'

public function runCompiler(arguments StringArray, staged FilePath = Directory.currentPath(), binary FilePath = testedCompilerPath(), environment Environment = Environment.inherit, standardInput InputSource = InputSource.none, deadline WaitDeadline = WaitDeadline.none) returns CollectedOutput throws SubprocessError
	return try runIn(Executable.path(binary), arguments: arguments, staged: staged, environment: environment, standardInput: standardInput, deadline: deadline)
end 'runCompiler'

public function spawnCompiler(arguments StringArray, staged FilePath = Directory.currentPath(), what String = CompilerUnderTestName, binary FilePath = testedCompilerPath(), environment Environment = Environment.inherit, standardInput InputSource = InputSource.none, deadline WaitDeadline = WaitDeadline.none) returns CollectedOutput
	return try runCompiler(arguments, staged: staged, binary: binary, environment: environment, standardInput: standardInput, deadline: deadline) otherwise (e) 'spawnFailed'
		panic("{spawnFailureMessage(what, failure: e)}")
	end 'spawnFailed'
end 'spawnCompiler'

public function runSystemTool(tool String, arguments StringArray, what String) returns CollectedOutput
	let ran = spawnIn(Executable.name(tool), arguments: arguments, staged: Directory.currentPath(), what: what)

	if not ran.succeeded() 'failed'
		panic("the gate could not run — {what} exited {ran.exitCode()}: {ran.stderr}")
	end 'failed'

	return ran
end 'runSystemTool'

public function plantedDirectoryLink(link FilePath, target String)
	#if os(Windows)
		_ = runSystemTool(WindowsLinkToolName, arguments: [WindowsLinkToolRunFlag, WindowsLinkToolCommand, WindowsJunctionFlag, link.toString(), target], what: "linking {link.toString()} to {target}")
	#else
		_ = runSystemTool(PosixLinkToolName, arguments: [PosixSymbolicFlag, target, link.toString()], what: "linking {link.toString()} to {target}")
	#endif
end 'plantedDirectoryLink'

public function backdatedToTheYear2000(path FilePath)
	#if os(Windows)
		_ = runSystemTool(WindowsShellName, arguments: [WindowsShellNoProfileFlag, WindowsShellCommandFlag, "(Get-Item -LiteralPath '{path.toString()}').LastWriteTime = Get-Date -Year 2000 -Month 1 -Day 1"], what: "setting the modified time of {path.toString()}")
	#else
		_ = runSystemTool(PosixTouchName, arguments: [PosixTouchTimeFlag, PosixYear2000Stamp, path.toString()], what: "setting the modified time of {path.toString()}")
	#endif
end 'backdatedToTheYear2000'

public function buildArguments(source FilePath, output FilePath, extraArguments StringArray) returns StringArray
	let arguments = StringArray.create(0)
	arguments.push(BuildCommandName)
	arguments.push(source.toString())
	arguments.push("{OutputOptionPrefix}{output.toString()}")

	for extra in extraArguments 'eachExtra'
		arguments.push(extra)
	end 'eachExtra'

	return arguments
end 'buildArguments'

public function spawnBuild(source FilePath, staged FilePath, output FilePath, label String, extraArguments StringArray, binary FilePath = testedCompilerPath(), environment Environment = Environment.inherit) returns CollectedOutput
	return spawnCompiler(buildArguments(source, output: output, extraArguments: extraArguments), staged: staged, what: "the '{label}' build", binary: binary, environment: environment)
end 'spawnBuild'

public function requireTreeEnded(child StreamingSubprocess, what String)
	requireTreeEnd(child.endTree(), what: what)
end 'requireTreeEnded'

public function requireTreeEnd(treeEnd TreeEnd, what String)
	match treeEnd 'tree'
		ended then return
		survived or
		unconfirmed then panic("the gate could not run — the process tree of {what} could not be ended ({treeEnd.displayReason()}).")
	end 'tree'
end 'requireTreeEnd'

public function brokenReadMessage(what String, stream StdioStream, reason String) returns String
	return "the gate could not run — reading {what}'s {stream.name} failed ({reason})."
end 'brokenReadMessage'

public function refuseBrokenRead(what String, stream StdioStream, reason String)
	panic("{brokenReadMessage(what, stream: stream, reason: reason)}")
end 'refuseBrokenRead'

public function waitFailureMessage(what String, failure WaitRefusal) returns String
	return "the gate could not run — waiting for {what} to exit ended in {failure.displayReason()}."
end 'waitFailureMessage'

public function lostStatusMessage(what String) returns String
	return "the gate could not run — the exit status of {what} went to another process."
end 'lostStatusMessage'

public function requireSurvivorsEnded(survivors SurvivorEnd, what String)
	match survivors 'survivors'
		noneHeld then break
		ended(tree) then requireTreeEnd(tree, what: what)
	end 'survivors'
end 'requireSurvivorsEnded'

public function requireDeadlineKill(failure SubprocessError, what String)
	if not failure.timedOut() 'notAKill'
		panic("the gate could not run — waiting for {what} to exit ended in {failure.displayReason()}, not in the kill its deadline sends.")
	end 'notAKill'
end 'requireDeadlineKill'

public function endedProcessId() returns Pid
	#if os(Windows)
		let exe = Executable.name("cmd")
		let argv = ["/c", "exit", "0"]
	#else
		let exe = Executable.path(try FilePath.from(PosixShellPath) otherwise panic("{PosixShellPath} is a spellable path"))
		let argv = ["-c", "exit 0"]
	#endif

	let finished = try Subprocess.run(exe, arguments: argv) otherwise panic("the gate could not run — could not run a child to learn an ended process's id")

	return finished.pid
end 'endedProcessId'

public function endedWithin(process Pid, boundMs DurationMs) returns bool
	let begun = Clock.nowMs()

	while Process.isAlive(process) and Clock.elapsedMs(begun) < boundMs 'untilItEnds'
		sleep(ProcessEndPollMs)
	end 'untilItEnds'

	return not Process.isAlive(process)
end 'endedWithin'

public function requireBuiltOrPanic(build CollectedOutput, output FilePath, what String)
	if build.exitCode() != 0 'didNotBuild'
		panic("the gate could not run — {what} exited {build.exitCode()}. It wrote to stdout: {build.stdout} and to stderr: {build.stderr}")
	end 'didNotBuild'

	if not File.exists(output) 'nothingWritten'
		panic("the gate could not run — {what} exited 0 and wrote nothing to {output.toString()}.")
	end 'nothingWritten'
end 'requireBuiltOrPanic'

public function requireBuiltExecutable(build CollectedOutput, output FilePath, what String, reason String) throws TestFailure
	try Expect.equal(build.exitCode(), expected: 0, message: "`{what}` exited {build.exitCode()}. {reason} It wrote to stderr: {build.stderr}")
	try Expect.isTrue(File.exists(output), message: "`{what}` exited 0 and wrote no executable to {output.toString()}.")
end 'requireBuiltExecutable'

#if os(Windows)
	function supportFixtureScript(fixture String, script String) returns FilePath
		let spelled = "{SupportFixturesDirName}/{fixture}/{script}"

		return try FilePath.from(spelled) otherwise panic("the gate could not run — '{spelled}' is not a spellable path")
	end 'supportFixtureScript'

	function windowsScriptArguments(script FilePath) returns StringArray
		return [WindowsShellNoProfileFlag, ExecutionPolicyFlag, ExecutionPolicyBypass, ScriptFileFlag, script.resolve(Directory.currentPath()).toString()].clone()
	end 'windowsScriptArguments'
#else
	function fileHolderShellScript() returns String
		return "exec 3<\"$1\" || exit 1\necho \"{FileHolderAnnouncementPrefix}$$\"\nif [ \"$2\" = {FileHolderUntilReleasedWord} ]; then read -r _; else sleep \"$(($2 / 1000)).$(printf '%03d' $(($2 % 1000)))\"; fi\nexit 0\n"
	end 'fileHolderShellScript'
#endif

// Below `FileHolderEndMs`, so `FileHolder.ended` cannot time out on a hold that is still running.
public typealias FileHoldMs = int(1 to 5000)

public union FileHold
	forMs(holdMs FileHoldMs)
	untilReleased
end 'FileHold'

public type FileHolder
	var child as StreamingSubprocess
	export let pid as Pid

	static function over(child StreamingSubprocess, pid Pid) returns FileHolder
		return Self{child: child, pid: pid}
	end 'over'

	export function ended() returns ExitInt
		child.closeStdin()

		let status = exitWithin(child, deadlineMs: FileHolderEndMs, what: "{FileHolderWhat} ({pid})")
		child.release()

		return status
	end 'ended'
end 'FileHolder'

function exitWithin(child StreamingSubprocess, deadlineMs WaitDeadlineMs, what String) returns ExitInt
	return try child.wait(deadline: WaitDeadline.within(deadlineMs)) otherwise (failure) 'notEnded'
		panic("{unendedMessage(what, failure: failure)}")
	end 'notEnded'
end 'exitWithin'

function unendedMessage(what String, failure SubprocessError) returns String
	return "the gate could not run — waiting for {what} to end ended in {failure.displayReason()}."
end 'unendedMessage'

public union HolderRelease
	pastRemovalBy(holdMs FileHoldMs)
	afterTheRun
end 'HolderRelease'

public union MarkerRemoval
	removedAt(instantMs InstantMs)
	stayed
end 'MarkerRemoval'

public type TimedLine
	public let arrivedAtMs as InstantMs
	public let text as String

	static function of(arrivedAtMs InstantMs, text String) returns TimedLine
		return Self{arrivedAtMs: arrivedAtMs, text: text}
	end 'of'
end 'TimedLine'

public typealias TimedLineArray = Array with TimedLine

public type HeldRun
	public let output as CollectedOutput
	public let stderrLines as TimedLineArray
	public let markerRemoval as MarkerRemoval
	public let holderPid as Pid
	public let holderExit as ExitInt

	static function of(output CollectedOutput, stderrLines TimedLineArray, markerRemoval MarkerRemoval, holderPid Pid, holderExit ExitInt) returns HeldRun
		return Self{output: output, stderrLines: stderrLines, markerRemoval: markerRemoval, holderPid: holderPid, holderExit: holderExit}
	end 'of'

	public function removalRefusalsNaming(entry String) returns StringArray
		let refusals = StringArray.create(0)

		for line in stderrLines 'eachLine'
			if line.text.contains(RemovalRefusalWording) and line.text.contains(entry) 'refusesIt'
				refusals.push(line.text)
			end 'refusesIt'
		end 'eachLine'

		return refusals
	end 'removalRefusalsNaming'
end 'HeldRun'

union HolderState
	holding
	ended(exit ExitInt)
end 'HolderState'

type HolderWatch
	let holder as FileHolder
	let marker as FilePath
	let release as HolderRelease
	var removal as MarkerRemoval
	var state as HolderState

	static function over(holder FileHolder, marker FilePath, release HolderRelease) returns HolderWatch
		return Self{holder: holder, marker: marker, release: release, removal: MarkerRemoval.stayed, state: HolderState.holding}
	end 'over'

	function observe()
		self.noteRemoval()

		if self.releaseIsDue() 'due'
			_ = self.released()
		end 'due'
	end 'observe'

	function noteRemoval()
		match self.removal 'removal'
			removedAt then return
			stayed then self.removal = removalNow(self.marker)
		end 'removal'
	end 'noteRemoval'

	function releaseIsDue() returns bool
		return match self.release 'release'
			pastRemovalBy(holdMs) gives self.removedFor(holdMs)
			afterTheRun gives false
		end 'release'
	end 'releaseIsDue'

	function removedFor(holdMs FileHoldMs) returns bool
		return match self.removal 'removal'
			removedAt(instantMs) gives Clock.elapsedMs(instantMs) >= holdMs as DurationMs
			stayed gives false
		end 'removal'
	end 'removedFor'

	function released() returns ExitInt
		match self.state 'state'
			ended(exit) then return exit
			holding then break
		end 'state'

		let exit = self.holder.ended()
		self.state = HolderState.ended(exit)

		return exit
	end 'released'
end 'HolderWatch'

function removalNow(marker FilePath) returns MarkerRemoval
	return MarkerRemoval.stayed if File.exists(marker) else MarkerRemoval.removedAt(Clock.nowMs())
end 'removalNow'

type TimedCapture implements ChildLineSink
	let streams as StreamCapture
	let stderrLines as TimedLineArray

	static function create() returns TimedCapture
		return Self{streams: StreamCapture.create(), stderrLines: TimedLineArray.create(0)}
	end 'create'

	function heard(stream StdioStream, text String)
		let line = withoutCarriageReturns(text)
		self.streams.heard(stream, text: line)

		if stream == StdioStream.stderr 'onStderr'
			self.stderrLines.push(TimedLine.of(Clock.nowMs(), text: line))
		end 'onStderr'
	end 'heard'

	function broken(stream StdioStream, reason String)
		self.streams.broken(stream, reason: reason)
	end 'broken'
end 'TimedCapture'

public function runHoldingPastRemoval(arguments StringArray, staged FilePath, environment Environment, held FilePath, marker FilePath, release HolderRelease, what String) returns HeldRun
	let holder = fileHeldOpen(held, hold: FileHold.untilReleased)
	let holderPid = holder.pid
	let watch = HolderWatch.over(holder, marker: marker, release: release)
	let started = Clock.nowMs()

	let child = try StreamingSubprocess.spawnWithEnvironment(Executable.path(testedCompilerPath()), arguments: arguments, workingDirectory: WorkingDirectory.at(staged), environment: environment) otherwise (failure) 'notStarted'
		_ = watch.released()
		panic("{spawnFailureMessage(what, failure: failure)}")
	end 'notStarted'

	child.closeStdin()

	let pid = try child.processId() otherwise (failure) 'noPid'
		abandonedChild(child, watch: watch, what: what)
		panic("the gate could not run — {what} has no process id ({failure.displayReason()}).")
	end 'noPid'

	let pump = try ChildPump.of(child) otherwise (failure) 'outputNotTaken'
		abandonedChild(child, watch: watch, what: what)
		panic("the gate could not run — could not take the output of {what} ({failure.displayReason()}).")
	end 'outputNotTaken'

	let capture = TimedCapture.create()

	if not drainedWithinTheLongestRun(pump, capture: capture, watch: watch, started: started) 'overran'
		abandonedRun(pump, child: child, watch: watch, what: what)
		panic("{what} was still writing {HeldRunLongestMs} ms after it started, so its process tree was ended. It wrote to stdout: {capture.streams.stdout} and to stderr: {capture.streams.stderr}")
	end 'overran'

	let code = try child.wait(deadline: WaitDeadline.within(HeldRunEndMs)) otherwise (failure) 'notEnded'
		abandonedRun(pump, child: child, watch: watch, what: what)
		panic("{unendedMessage(what, failure: failure)}")
	end 'notEnded'

	let durationMs = Clock.elapsedMs(started)
	pump.release(child)

	let holderExit = watch.released()

	match capture.streams.health 'health'
		intact then break
		failed(stream, reason) then refuseBrokenRead(what, stream: stream, reason: reason)
	end 'health'

	return HeldRun.of(CollectedOutput.create(TerminationStatus.exited(code), stdout: capture.streams.stdout, stderr: capture.streams.stderr, pid: pid, durationMs: durationMs), stderrLines: capture.stderrLines, markerRemoval: watch.removal, holderPid: holderPid, holderExit: holderExit)
end 'runHoldingPastRemoval'

// The pump's reader services do every read of the child: a read on this thread parks it until bytes
// arrive, and the marker would go unwatched while the run is silent.
function drainedWithinTheLongestRun(pump ChildPump, capture TimedCapture, watch HolderWatch, started InstantMs) returns bool
	while Clock.remainingMs(started, deadlineMs: HeldRunLongestMs) > 0 'pumping'
		let event = pump.nextWithin(ProcessEndPollMs, started: started, deadlineMs: HeldRunLongestMs)
		event.deliverTo(capture)
		watch.observe()

		match event 'event'
			said or
			closed or
			broke or
			silent then continue
			exhausted then return true
		end 'event'
	end 'pumping'

	return false
end 'drainedWithinTheLongestRun'

function abandonedRun(pump ChildPump, child StreamingSubprocess, watch HolderWatch, what String)
	pump.stop()
	abandonedChild(child, watch: watch, what: what)
end 'abandonedRun'

function abandonedChild(child StreamingSubprocess, watch HolderWatch, what String)
	let treeEnd = child.endTree()
	child.release()
	_ = watch.released()
	requireTreeEnd(treeEnd, what: what)
end 'abandonedChild'

public function fileHeldOpen(path FilePath, hold FileHold) returns FileHolder
	#if os(Windows)
		let executable = Executable.name(WindowsShellName)
		let arguments = windowsScriptArguments(supportFixtureScript(FileHolderFixtureName, script: FileHolderScriptName))
	#else
		let executable = Executable.path(try FilePath.from(PosixShellPath) otherwise panic("{PosixShellPath} is a spellable path"))
		let arguments = [PosixShellCommandFlag, fileHolderShellScript(), FileHolderShellArgumentZero].clone()
	#endif

	arguments.push(path.toString())
	arguments.push(fileHoldWord(hold))

	let child = try StreamingSubprocess.spawn(executable, arguments: arguments) otherwise (failure) 'notStarted'
		panic("{spawnFailureMessage(FileHolderWhat, failure: failure)}")
	end 'notStarted'

	let announcements = try child.takeStdout() otherwise (failure) 'notTaken'
		panic("{brokenReadMessage(FileHolderWhat, stream: StdioStream.stdout, reason: failure.displayReason())}")
	end 'notTaken'

	let announcement = try announcements.readLine() otherwise (failure) 'unread'
		panic("{brokenReadMessage(FileHolderWhat, stream: StdioStream.stdout, reason: failure.displayReason())}")
	end 'unread'

	let said = match announcement 'announcement'
		line(text) gives withoutCarriageReturns(text)
		ended panic("the gate could not run — {FileHolderWhat} ended without announcing that it holds {path.toString()}.")
	end 'announcement'

	if not said.startsWith(FileHolderAnnouncementPrefix) 'notAnAnnouncement'
		panic("the gate could not run — {FileHolderWhat} announced '{said}', not `{FileHolderAnnouncementPrefix}<pid>`.")
	end 'notAnAnnouncement'

	let holder = try int.fromString(said.replaceFirst(FileHolderAnnouncementPrefix, with: "")) otherwise panic("the gate could not run — {FileHolderWhat} announced '{said}', whose pid is not a number.")

	return FileHolder.over(child, pid: holder as Pid)
end 'fileHeldOpen'

function fileHoldWord(hold FileHold) returns String
	return match hold 'hold'
		forMs(holdMs) gives "{holdMs}"
		untilReleased gives FileHolderUntilReleasedWord
	end 'hold'
end 'fileHoldWord'
