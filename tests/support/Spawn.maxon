public let BuildCommandName = "build"
public let OutputOptionPrefix = "--output="

let WindowsShellName = "powershell"
let WindowsShellNoProfileFlag = "-NoProfile"
let WindowsShellCommandFlag = "-Command"
let PosixTouchName = "touch"
let PosixTouchTimeFlag = "-t"
let PosixYear2000Stamp = "200001010000"

#if not os(Windows)
	public let PosixShellPath = "/bin/sh"
#endif

public let NoTimeoutMs = 0 as DurationMs
public let CompilerUnderTestName = "the compiler under test"

public function spawnIn(executable Executable, arguments StringArray, staged FilePath, what String, environment Environment = Environment.inherit, standardInput InputSource = InputSource.none, timeoutMs DurationMs = NoTimeoutMs) returns CollectedOutput
	var config = Configuration.create(executable, workingDirectory: staged)
	config.arguments = arguments.clone()
	config.environment = environment
	config.standardInput = standardInput
	config.timeoutMs = timeoutMs

	return try config.run() otherwise (e) 'spawnFailed'
		panic("the gate could not run — could not spawn {what} ({e.displayReason()}).")
	end 'spawnFailed'
end 'spawnIn'

public function spawnCompiler(arguments StringArray, staged FilePath = Directory.currentPath(), what String = CompilerUnderTestName, binary FilePath = testedCompilerPath(), environment Environment = Environment.inherit, standardInput InputSource = InputSource.none, timeoutMs DurationMs = NoTimeoutMs) returns CollectedOutput
	return spawnIn(Executable.path(binary), arguments: arguments, staged: staged, what: what, environment: environment, standardInput: standardInput, timeoutMs: timeoutMs)
end 'spawnCompiler'

public function runSystemTool(tool String, arguments StringArray, what String) returns CollectedOutput
	let ran = spawnIn(Executable.name(tool), arguments: arguments, staged: Directory.currentPath(), what: what)

	if not ran.succeeded() 'failed'
		panic("the gate could not run — {what} exited {ran.exitCode()}: {ran.stderr}")
	end 'failed'

	return ran
end 'runSystemTool'

public function backdatedToTheYear2000(path FilePath)
	#if os(Windows)
		_ = runSystemTool(WindowsShellName, arguments: [WindowsShellNoProfileFlag, WindowsShellCommandFlag, "(Get-Item -LiteralPath '{path.toString()}').LastWriteTime = Get-Date -Year 2000 -Month 1 -Day 1"], what: "setting the modified time of {path.toString()}")
	#else
		_ = runSystemTool(PosixTouchName, arguments: [PosixTouchTimeFlag, PosixYear2000Stamp, path.toString()], what: "setting the modified time of {path.toString()}")
	#endif
end 'backdatedToTheYear2000'

public function buildArguments(source FilePath, output FilePath, extraArguments StringArray) returns StringArray
	var arguments = StringArray.create(0)
	arguments.push(BuildCommandName)
	arguments.push(source.toString())
	arguments.push("{OutputOptionPrefix}{output.toString()}")

	for extra in extraArguments 'eachExtra'
		arguments.push(extra)
	end 'eachExtra'

	return arguments
end 'buildArguments'

public function spawnBuild(source FilePath, staged FilePath, output FilePath, label String, extraArguments StringArray, binary FilePath = testedCompilerPath(), environment Environment = Environment.inherit) returns CollectedOutput
	return spawnCompiler(buildArguments(source, output: output, extraArguments: extraArguments), staged: staged, what: "the '{label}' build", binary: binary, environment: environment)
end 'spawnBuild'

public function requireTreeEnded(child StreamingSubprocess, what String)
	let treeEnd = child.endTree()

	match treeEnd 'tree'
		ended then return
		survived or
		unconfirmed then panic("the gate could not run — the process tree of {what} could not be ended ({treeEnd.displayReason()}).")
	end 'tree'
end 'requireTreeEnded'

public function requireDeadlineKill(failure SubprocessError, what String)
	if not failure.timedOut() 'notAKill'
		panic("the gate could not run — waiting for {what} to exit ended in {failure.displayReason()}, not in the kill its deadline sends.")
	end 'notAKill'
end 'requireDeadlineKill'

public function endedProcessId() returns Pid
	#if os(Windows)
		let exe = Executable.name("cmd")
		let argv = ["/c", "exit", "0"]
	#else
		let exe = Executable.path(try FilePath.from(PosixShellPath) otherwise panic("{PosixShellPath} is a spellable path"))
		let argv = ["-c", "exit 0"]
	#endif

	let finished = try Subprocess.run(exe, arguments: argv) otherwise panic("the gate could not run — could not run a child to learn an ended process's id")

	return finished.pid
end 'endedProcessId'

public function requireBuiltOrPanic(build CollectedOutput, output FilePath, what String)
	if build.exitCode() != 0 'didNotBuild'
		panic("the gate could not run — {what} exited {build.exitCode()}. It wrote to stdout: {build.stdout} and to stderr: {build.stderr}")
	end 'didNotBuild'

	if not File.exists(output) 'nothingWritten'
		panic("the gate could not run — {what} exited 0 and wrote nothing to {output.toString()}.")
	end 'nothingWritten'
end 'requireBuiltOrPanic'

public function requireBuiltExecutable(build CollectedOutput, output FilePath, what String, reason String) throws TestFailure
	try Expect.equal(build.exitCode(), expected: 0, message: "`{what}` exited {build.exitCode()}. {reason} It wrote to stderr: {build.stderr}")
	try Expect.isTrue(File.exists(output), message: "`{what}` exited 0 and wrote no executable to {output.toString()}.")
end 'requireBuiltExecutable'
