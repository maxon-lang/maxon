public let FunctionHeaderPrefix = "func @"
public let MainFunctionName = "main"
public let MainFunctionHeader = "{FunctionHeaderPrefix}{MainFunctionName}"

public let X64OpPrefix = "x64."
public let Arm64OpPrefix = "arm64."
public let X64CallDirectMnemonic = "callDirect"
public let Arm64BranchLinkMnemonic = "bl"
public let X64DirectCallPrefix = "{X64OpPrefix}{X64CallDirectMnemonic} "
public let Arm64DirectCallPrefix = "{Arm64OpPrefix}{Arm64BranchLinkMnemonic} "

public function functionHeader(name String) returns String
	return "{FunctionHeaderPrefix}{name}"
end 'functionHeader'

public function hostDirectCallLine(callee String) returns String
	#if arch(x64)
		return "{X64DirectCallPrefix}{callee}"
	#else
		return "{Arm64DirectCallPrefix}{callee}"
	#endif
end 'hostDirectCallLine'
