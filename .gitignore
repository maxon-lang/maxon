/specs/fragments-x64-windows/.spec-cache/
/specs/fragments-wasm32-wasi/.spec-cache/
/maxon-selfhosted/.maxon/
# Phase 2 (libraries): the shared stdlib cache now lives in the stdlib's own dir.
/stdlib/.maxon/
# Any library's per-dir cache, wherever a library root sits.
**/.maxon/cache/
# Built example executables (artifacts of compiling examples/*.maxon in place).
examples/*.exe
examples/async-repro/
examples/lexer-bench/
