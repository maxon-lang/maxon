/bin/
/temp/
/scratch.txt
/todo.md
/scripts/lldb.sh
/examples/llvm/
/.vscode/settings.json
/.claude/settings.local.json
/.claude/worktrees/
/llvm-source
/llvm-project
/.maxon/
.maxon/cache/
# Per-directory build caches created when compiling a single .maxon file
# in-place (e.g. `maxon-selfhosted.exe build <subdir>/file.maxon`) — these
# `.maxon/` dirs can appear at any depth and must never be tracked.
**/.maxon/
/maxon-sharp/bin/
/maxon-sharp/obj/
/specs/fragments-arm64-macos/.spec-cache/
/specs/fragments-arm64-linux/.spec-cache/
/specs/fragments-x64-linux/.spec-cache/
/specs/fragments-x64-windows/.spec-cache/
/specs/fragments-wasm32-wasi/.spec-cache/
/maxon-selfhosted/.maxon/
# Phase 2 (libraries): the shared stdlib cache now lives in the stdlib's own dir.
/stdlib/.maxon/
# Any library's per-dir cache, wherever a library root sits.
**/.maxon/cache/
# Build artifacts of compiling examples/*.maxon in place are listed in
# examples/.gitignore, beside the sources they come from.
examples/async-repro/
examples/lexer-bench/
.claude/scheduled_tasks.lock
/maxon-sharp/MaxonSharp.csproj.lscache
maxon-dev-mcp/mcp/.maxon/
maxon-dev-mcp/test/.maxon/
scratchpad/

# maxon-shv2 spec-test runner scratch (per-test fragments/exes, cleaned per run)
**/.spec-tmp/

# maxon-shv2 scale-test corpus + per-rung metrics (regenerated deterministically every run —
# the generator IS the corpus, so committing it would be megabytes of pure git noise)
**/.scale-tmp/

# maxon-shv2 --emit-ir diagnostic sidecars (build artifacts)
*.ir

# DebugStream stress harness scratch: the built producer, and traces that run to ~130 MB of
# 16 KB text lines per pacing. Regenerated by tools/debugstream-stress/validate.sh on every run.
tools/debugstream-stress/.work/
tools/debugstream-stress/ds-race.exe
