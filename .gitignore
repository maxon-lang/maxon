/bin/
/temp/
/scratch.txt
/todo.md
/scripts/lldb.sh
/examples/llvm/
/.vscode/settings.json
/.claude/settings.local.json
/.claude/worktrees/
/llvm-source
/llvm-project
/.maxon/
.maxon/cache/
# Per-directory build caches created when compiling a single .maxon file
# in-place (e.g. `maxon-selfhosted.exe build <subdir>/file.maxon`) — these
# `.maxon/` dirs can appear at any depth and must never be tracked.
**/.maxon/
/maxon-sharp/bin/
/maxon-sharp/obj/
/specs/fragments-arm64-macos/.spec-cache/
/specs/fragments-x64-windows/.spec-cache/
/specs/fragments-wasm32-wasi/.spec-cache/
/maxon-selfhosted/.maxon/
# Phase 2 (libraries): the shared stdlib cache now lives in the stdlib's own dir.
/stdlib/.maxon/
# Any library's per-dir cache, wherever a library root sits.
**/.maxon/cache/
# Build artifacts of compiling examples/*.maxon in place are listed in
# examples/.gitignore, beside the sources they come from.
examples/async-repro/
examples/lexer-bench/
.claude/scheduled_tasks.lock
/maxon-sharp/MaxonSharp.csproj.lscache
maxon-dev-mcp/mcp/.maxon/
maxon-dev-mcp/test/.maxon/
scratchpad/

# This checkout's TREE LOCK — one file, written by whichever `build`/`spec-test`/`scale-test` is
# running here and removed when it exits (see maxon-shv2/Compiler/TreeLock.maxon). It describes a
# process on THIS machine, so it belongs to nobody else's checkout.
/.maxon-tree.lock

# maxon-shv2 spec-test runner scratch (per-test fragments/exes, cleaned per run)
**/.spec-tmp/

# maxon-shv2 scale-test corpus + per-rung metrics (regenerated deterministically every run —
# the generator IS the corpus, so committing it would be megabytes of pure git noise)
**/.scale-tmp/

# maxon-shv2 --emit-ir diagnostic sidecars (build artifacts)
*.ir

# DebugStream stress harness scratch: the built producer, and traces that run to ~130 MB of
# 16 KB text lines per pacing. Regenerated by tools/debugstream-stress/validate.sh on every run.
tools/debugstream-stress/.work/
tools/debugstream-stress/ds-race.exe

# Python bytecode from scripts/ (compare-spec-coverage.py and the LSP test helpers).
__pycache__/

# netpoll park driver: the binary, its debug sidecar and its build cache. scripts/…/run.sh rebuilds
# them on every invocation, so leaving them untracked keeps a measurement from dirtying the tree.
# ⚠ BOTH platforms' names, because this block used to carry only the POSIX ones and Windows'
# artifacts are spelled differently: `main.exe` / `main.exe.mxdbg` match neither `main` nor
# `main.mxdbg`. Measured 2026-08-01 — a `git add -A` after building the driver on Windows swept
# 282 KB of binary into a commit, which is how the gap was found. Same shape as the driver itself
# having no Windows arm: nothing in this instrument's toolchain had ever been run here.
scripts/netpoll-park-driver/main
scripts/netpoll-park-driver/main.mxdbg
scripts/netpoll-park-driver/main.exe
scripts/netpoll-park-driver/main.exe.mxdbg
scripts/netpoll-park-driver/.maxon/

# Go source, vendored locally as the reference for the allocator/scheduler port.
# NOT committed: it is ~640 MB. `scripts/gen-slab-classes.sh --check` reads one file from it and
# SKIPS (exit 0, with a reason) when it is absent, so a clone without it still builds and tests —
# it just cannot re-verify the size-class table against upstream Go.
vendor/go/

# track0 harness scratch: each driver compiles its programs into a working directory beside itself
# and leaves per-run logs there. Regenerated on every invocation.
# ⚠ THE `.work/` LINE IS A PRE-EXISTING GAP CLOSED HERE, not new debt: `validate.sh` has written
# `maxon-shv2/track0/.work/` (two compiler binaries and their debug sidecars) and
# `maxon-shv2/track0/alloc-torture.exe` since W212, and neither was ignored — the same shape the
# netpoll-park-driver block above records, found the same way.
maxon-shv2/track0/.work/
maxon-shv2/track0/.pin-matrix/
maxon-shv2/track0/.refcount-race/
maxon-shv2/track0/*.exe
maxon-shv2/track0/*.mxdbg
