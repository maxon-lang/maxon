// REGISTRY CONFORMANCE — one format, both readers, and they must never disagree.
//
// `docs/error-codes.txt` is the authored source of truth for the error-code space. It briefly had
// TWO hand-written parsers — the build gate in `maxon-sharp/Compiler/ErrorCodeRegistry.cs`, and the
// MCP's `lookup_error_code` — and they disagreed on five inputs. A blank line inside an entry made
// the gate shrug and made the tool answer `emittedBy: {}` — "no compiler emits this code" — about a
// code the bootstrap declares. An instrument that lies.
//
// The fix DELETED the second parser: the tool now reads `docs/error-codes.json`, which the gate
// generates, and verifies an FNV-1a hash of the registry's bytes before trusting a word of it. Two
// readers can no longer hold different opinions about the grammar, because only one of them reads
// the grammar.
//
// THIS FILE IS WHAT KEEPS THAT TRUE. For each fixture registry it runs BOTH readers over the SAME
// bytes and asserts the safety property — which is CHECKED, never authored:
//
//     THE TOOL ANSWERS ONLY WHAT THE GATE SANCTIONED, FOR THE BYTES ON DISK NOW.
//
//   - the gate REJECTED the registry  => the tool must REFUSE
//                                        (`duplicate-key`, `missing-doc`)
//   - the gate ACCEPTED it            => the tool must ANSWER, and its `emittedBy` must equal the
//                                        gate's OWN generated `emittedBy`
//                                        (`blank-line-in-entry`, `indented-comment`,
//                                         `tab-separated-key` — the three that used to diverge)
//   - the gate accepted, then the registry CHANGED under the artifact => the tool must REFUSE
//     (`stale-after-generate`) — the case no amount of parser agreement could ever have caught, and
//     the one that a stale generated file turns into a confident wrong answer.
//
// A fixture is `<name>.txt` (the registry both readers see), an optional `<name>.after.txt`
// (written over it AFTER generation, to strand the artifact), and `<name>.expect.json`.

let ConformanceFixtureDir = "maxon-dev-mcp/test/fixtures/registry"

// Scratch checkouts live under the test project's gitignored build dir — never in a real tree,
// because `error-codes generate` WRITES into whatever root it is pointed at.
let ConformanceWorkDir = "maxon-dev-mcp/test/.maxon/conformance"

let RegistryRelativePath = "docs/error-codes.txt"
let InterchangeRelativePath = "docs/error-codes.json"

let RegistryFixtureSuffix = ".txt"
let ExpectationSuffix = ".expect.json"

// `<name>.after.txt` is a MUTATION applied part-way through another fixture's case, not a case of
// its own — so it is excluded from fixture DISCOVERY while remaining part of what a case does.
let MutationSuffix = ".after.txt"

// What the gate did with a registry, and what it said while doing it. Its diagnosis is on STDERR —
// every refusal in ErrorCodeRegistry.cs goes through `Console.Error` — so that is the stream the
// fixtures match against and the one a failure prints.
type GateOutcome
	export var accepted as bool
	export var stderr as String

	export static function create(accepted bool, stderr String) returns GateOutcome
		return GateOutcome{accepted: accepted, stderr: stderr}
	end 'create'
end 'GateOutcome'

// What the tool did with the same registry. `answered` is the whole safety question: an answer is a
// claim about what a code MEANS, and a claim has to be earned.
type ToolVerdict
	export var answered as bool
	export var errorMessage as String
	export var emittedBy as StringArray

	export static function create(answered bool, errorMessage String, emittedBy StringArray) returns ToolVerdict
		return ToolVerdict{answered: answered, errorMessage: errorMessage, emittedBy: emittedBy}
	end 'create'
end 'ToolVerdict'

export type Conformance
	/// Run one conformance fixture: both readers over the same bytes, then the safety property.
	export static function check(name String, file String = __file__, line SourceLineNumber = __line__) throws TestFailure
		let site = AssertSite.create(file, line: line)
		let repoRoot = resolveRepoRoot()
		let fixturesDir = joinPath(repoRoot, segment: ConformanceFixtureDir)

		let expect = try readJsonFile(joinPath(fixturesDir, segment: "{name}{ExpectationSuffix}")) otherwise 'noExpect'
			try Expect.fail("cannot read or parse {name}{ExpectationSuffix}", file: file, line: line)
			return
		end 'noExpect'

		let code = try expect.getInt(expect.root, key: "code") otherwise 'noCode'
			try Expect.fail("{name}{ExpectationSuffix} has no integer `code`", file: file, line: line)
			return
		end 'noCode'

		let workRoot = try materializeScratchCheckout(name, repoRoot: repoRoot, fixturesDir: fixturesDir) otherwise (err) 'noWork'
			try Expect.fail("could not build the scratch checkout for {name} ({err.name})", file: file, line: line)
			return
		end 'noWork'

		// READER A: the gate. It parses, validates, and — when it accepts — GENERATES the artifact
		// the tool will read. The tool's input is literally reader A's output.
		let gate = runGate(repoRoot, workRoot: workRoot)

		// The registry changes UNDER the artifact, if the fixture says so. Nothing regenerates.
		try applyMutation(name, fixturesDir: fixturesDir, workRoot: workRoot) otherwise 'mutErr'
			try Expect.fail("could not apply {name}{MutationSuffix}", file: file, line: line)
			return
		end 'mutErr'

		// READER B: the tool, pointed at exactly the same tree.
		let tool = try runLookup(locateBinary(repoRoot), workRoot: workRoot, code: code, site: site)

		try judgeCase(expect, code: code, gate: gate, tool: tool, workRoot: workRoot, site: site)
	end 'check'

	/// Assert that every conformance fixture on disk is named by a test in the CALLING file.
	/// `<name>.after.txt` is skipped by the same rule discovery uses — a mutation belongs to a
	/// case rather than being one.
	export static function requireEveryFixtureHasATest(file String = __file__, line SourceLineNumber = __line__) throws TestFailure
		var mutations = StringArray.create()
		mutations.push(MutationSuffix)

		let dir = joinPath(resolveRepoRoot(), segment: ConformanceFixtureDir)
		try requireEveryFixtureIsNamed(dir, suffix: RegistryFixtureSuffix, skipping: mutations, site: AssertSite.create(file, line: line))
	end 'requireEveryFixtureHasATest'
end 'Conformance'

// THE ASSERTION. The computed invariant is checked FIRST, ahead of every authored expectation: if
// the safety property breaks, this must fail even for someone who has helpfully updated the
// expectation file to match the new behaviour.
function judgeCase(expect JsonDoc, code JsonInt, gate GateOutcome, tool ToolVerdict, workRoot FilePath, site AssertSite) throws TestFailure
	// (1) THE INVARIANT — never authored, always checked. An answer must be sanctioned.
	if tool.answered and not gate.accepted 'unsanctioned'
		try Expect.fail("READERS DISAGREE: the gate REJECTED this registry and the tool ANSWERED for E{code} regardless. gate said: {gate.stderr.trim()}", file: site.file, line: site.line)
	end 'unsanctioned'

	// (2) The gate's verdict is the one the fixture documents.
	let wantGate = try stringField(expect, key: "gate") otherwise panic("judgeCase: the expectation file has no `gate`")
	try Expect.equal(gate.accepted, expected: wantGate.equals(GateAcceptWord), message: "the gate should {wantGate} this registry. It said: {gate.stderr.trim()}", file: site.file, line: site.line)
	try requireOptionalContains(expect, key: "gateStderrContains", actual: gate.stderr, what: "gate stderr", site: site)

	// (3) The tool's verdict is the one the fixture documents.
	let wantTool = try stringField(expect, key: "tool") otherwise panic("judgeCase: the expectation file has no `tool`")
	try Expect.equal(tool.answered, expected: wantTool.equals(ToolAnswerWord), message: "the tool should {wantTool}. It said: {tool.errorMessage.trim()}", file: site.file, line: site.line)
	try requireOptionalContains(expect, key: "toolErrorContains", actual: tool.errorMessage, what: "tool refusal", site: site)

	if not tool.answered 'refused'
		return
	end 'refused'

	// (4) CONTENT AGREEMENT, computed. The tool answered — so what it said must be what the gate
	// PARSED, not merely something plausible. Checked against the gate's own generated artifact AND
	// against the fixture's authored expectation, so neither can drift alone.
	let gateEmittedBy = try readGeneratedEmittedBy(workRoot, code: code) otherwise 'noGen'
		try Expect.fail("the gate accepted but wrote no readable {InterchangeRelativePath} to compare against", file: site.file, line: site.line)
		return
	end 'noGen'
	try requireSameStrings(tool.emittedBy, expected: gateEmittedBy, what: "READERS DISAGREE on E{code}: gate-parsed vs tool-reported emittedBy", site: site)

	let wantEmitted = try stringArrayField(expect, key: "emittedBy") otherwise panic("judgeCase: an answering case must document its `emittedBy`")
	try requireSameStrings(tool.emittedBy, expected: wantEmitted, what: "E{code} emittedBy, as both readers report it", site: site)
end 'judgeCase'

// The words a `<name>.expect.json` uses for the two verdicts. Spelled once here rather than at each
// comparison, so a fixture and the code reading it cannot disagree about the vocabulary.
let GateAcceptWord = "accept"
let ToolAnswerWord = "answer"

// An optional `<key>Contains` expectation: absent means "do not care".
function requireOptionalContains(expect JsonDoc, key String, actual String, what String, site AssertSite) throws TestFailure
	let needle = try expect.getString(expect.root, key: key) otherwise 'absent'
		return
	end 'absent'

	try Expect.contains(actual, needle: needle, message: what, file: site.file, line: site.line)
end 'requireOptionalContains'

// Element-wise, and deliberately NOT a comparison of the two rendered strings: `["a,b"]` and
// `["a","b"]` render alike, and a false PASS in the one assertion that says the two readers agree
// is exactly the failure this file exists to catch. The renderings appear in the MESSAGE, where
// they are a description and never the test.
function requireSameStrings(actual StringArray, expected StringArray, what String, site AssertSite) throws TestFailure
	let both = "{render(actual)} vs expected {render(expected)}"
	try Expect.equal(actual.count(), expected: expected.count(), message: "{what} — {both}", file: site.file, line: site.line)

	let n = expected.count()
	for i in 0 upto n 'each'
		let a = try actual.get(i) otherwise panic("requireSameStrings: actual.get OOB — the counts were asserted equal")
		let e = try expected.get(i) otherwise panic("requireSameStrings: expected.get OOB — i bounded by n")
		try Expect.equal(a, expected: e, message: "{what}, position {i} — {both}", file: site.file, line: site.line)
	end 'each'
end 'requireSameStrings'

// =============================================================================
// Plumbing
// =============================================================================

enum ScratchError implements Error
	cannotCreate
	cannotWrite
	cannotRead
end 'ScratchError'

// A throwaway checkout holding nothing but the fixture registry. `error-codes generate` WRITES into
// the root it is given, which is exactly why it is never given a real one.
function materializeScratchCheckout(name String, repoRoot FilePath, fixturesDir FilePath) returns FilePath throws ScratchError
	let workRoot = joinPath(joinPath(repoRoot, segment: ConformanceWorkDir), segment: name)

	for marker in checkoutMarkerDirs() 'eachMarker'
		if not Directory.create(joinPath(workRoot, segment: marker)) 'markerFailed'
			throw ScratchError.cannotCreate
		end 'markerFailed'
	end 'eachMarker'

	if not Directory.create(joinPath(workRoot, segment: "docs")) 'docsFailed'
		throw ScratchError.cannotCreate
	end 'docsFailed'

	// Wipe the previous run's artifact. Without this, a REJECTED registry could be answered from a
	// generated file left behind by an earlier ACCEPTED one — and the test would pass for the wrong
	// reason, which is the only way a test can do real harm.
	let interchange = joinPath(workRoot, segment: InterchangeRelativePath)
	if File.exists(interchange) 'priorRun'
		try File.delete(interchange) otherwise throw ScratchError.cannotWrite
	end 'priorRun'

	let registry = try File.readText(joinPath(fixturesDir, segment: "{name}{RegistryFixtureSuffix}")) otherwise throw ScratchError.cannotRead
	try File.writeText(joinPath(workRoot, segment: RegistryRelativePath), content: registry) otherwise throw ScratchError.cannotWrite

	return workRoot
end 'materializeScratchCheckout'

// Overwrite the scratch registry AFTER the gate has generated from it, stranding the artifact. Most
// fixtures have no `.after.txt` and this does nothing — the mutation is what makes
// `stale-after-generate` a different case from its siblings, not a case of its own.
function applyMutation(name String, fixturesDir FilePath, workRoot FilePath) throws ScratchError
	let afterPath = joinPath(fixturesDir, segment: "{name}{MutationSuffix}")
	if not File.exists(afterPath) 'noMutation'
		return
	end 'noMutation'

	let mutated = try File.readText(afterPath) otherwise throw ScratchError.cannotRead
	try File.writeText(joinPath(workRoot, segment: RegistryRelativePath), content: mutated) otherwise throw ScratchError.cannotWrite
end 'applyMutation'

// `maxon error-codes generate <workRoot>` — parse, validate, and (on acceptance) write the
// artifact. Deliberately `generate` and not `check`: `check` ALSO enforces claim liveness, which
// asks whether a real compiler tree emits the member, and a scratch root has no compiler in it.
// Liveness is a rule about the WORLD; these fixtures are about the FORMAT. (Liveness is gated on
// the real tree, by every build.)
function runGate(repoRoot FilePath, workRoot FilePath) returns GateOutcome
	let gateExe = joinPath(repoRoot, segment: "bin/maxon{exeSuffix()}")
	if not File.exists(gateExe) 'noGate'
		panic("runGate: the C# bootstrap is not built at {gateExe.path}. This test runs the REAL gate against the fixtures — without it there is nothing to compare the tool against, and a conformance test that silently skips the other reader is worse than none.")
	end 'noGate'

	var argv = StringArray.create()
	argv.push("error-codes")
	argv.push("generate")
	argv.push(workRoot.path)

	var c = Configuration.create(Executable.path(gateExe))
	c.arguments = argv
	// The gate answers with a verdict and a diagnostic, never a transcript — on both streams.
	c.standardOutput = OutputDestination.collect(diagnosticCaptureBytes)
	c.standardError = OutputDestination.collect(diagnosticCaptureBytes)
	c.timeoutMs = subprocessTimeoutMs

	let collected = try c.run() otherwise (err) 'runErr'
		panic("runGate: could not run the gate: {err.displayReason()}")
	end 'runErr'

	return GateOutcome.create(collected.exitCode() == 0, stderr: collected.stderr)
end 'runGate'

// The JSON-RPC request, assembled with the same serializer the server answers with rather than
// pasted together as text. A hand-built request would have to escape a Windows path's backslashes
// into a JSON string by hand — and a fixture that escapes its own path wrongly does not fail, it
// silently tests a DIFFERENT tree, which is the failure this whole afternoon is about. (It also
// cannot be pasted: `{` opens an interpolation in a Maxon string, so a literal JSON object does not
// survive the lexer.)
//
// `repoRootOrEmpty` empty means the argument is OMITTED — not sent as `""`. That is a materially
// different request, and `RootWalk.maxon` is built on the difference: naming no tree is what makes
// the server derive one from its own binary.
export function buildLookupRequest(code JsonInt, repoRootOrEmpty String) returns String
	var doc = JsonDoc.create()

	var argKeys = StringArray.create()
	var argVals = JsonNodeIdArray.create()
	argKeys.push("code")
	argVals.push(doc.add(JsonNode.numberNode(code)))
	if not repoRootOrEmpty.isEmpty() 'namesATree'
		argKeys.push("repoRoot")
		argVals.push(doc.add(JsonNode.stringNode(repoRootOrEmpty)))
	end 'namesATree'
	let argsId = doc.add(JsonNode.objectNode(argKeys, children: argVals))

	var paramKeys = StringArray.create()
	var paramVals = JsonNodeIdArray.create()
	paramKeys.push("name")
	paramVals.push(doc.add(JsonNode.stringNode("lookup_error_code")))
	paramKeys.push("arguments")
	paramVals.push(argsId)
	let paramsId = doc.add(JsonNode.objectNode(paramKeys, children: paramVals))

	var keys = StringArray.create()
	var vals = JsonNodeIdArray.create()
	keys.push("jsonrpc")
	vals.push(doc.add(JsonNode.stringNode("2.0")))
	keys.push("id")
	vals.push(doc.add(JsonNode.numberNode(1)))
	keys.push("method")
	vals.push(doc.add(JsonNode.stringNode("tools/call")))
	keys.push("params")
	vals.push(paramsId)
	doc.root = doc.add(JsonNode.objectNode(keys, children: vals))

	return "{Json.stringify(doc)}\n"
end 'buildLookupRequest'

// One `lookup_error_code` call against the scratch tree, through the real server binary.
function runLookup(binary FilePath, workRoot FilePath, code JsonInt, site AssertSite) returns ToolVerdict throws TestFailure
	var c = Configuration.create(Executable.path(binary))
	c.standardInput = InputSource.bytes(buildLookupRequest(code, repoRootOrEmpty: workRoot.path))
	c.standardOutput = OutputDestination.collect(transcriptCaptureBytes)
	c.standardError = OutputDestination.collect(diagnosticCaptureBytes)
	c.timeoutMs = subprocessTimeoutMs

	let collected = try c.run() otherwise (err) 'runErr'
		panic("runLookup: could not run the MCP server: {err.displayReason()}")
	end 'runErr'

	let responses = try splitJsonLines(collected.stdout, site: site)
	try Expect.greaterThan(responses.count(), than: 0, message: "the server produced no JSON-RPC response. stderr: {collected.stderr.trim()}", file: site.file, line: site.line)

	let response = try responses.get(0) otherwise panic("runLookup: responses.get(0) OOB — a non-zero count was just asserted")
	let errId = try response.getChild(response.root, key: "error") otherwise 'answered'
		return ToolVerdict.create(true, errorMessage: "", emittedBy: toolEmittedBy(response))
	end 'answered'

	let message = try response.getString(errId, key: "message") otherwise panic("runLookup: a JSON-RPC error must carry a `message`")
	return ToolVerdict.create(false, errorMessage: message, emittedBy: StringArray.create())
end 'runLookup'

// The tool's answer arrives as MCP's `content[0].text` — a JSON document inside a string.
function toolEmittedBy(response JsonDoc) returns StringArray
	let resultId = try response.getChild(response.root, key: "result") otherwise panic("toolEmittedBy: a non-error response must carry `result`")
	let contentId = try response.getChild(resultId, key: "content") otherwise panic("toolEmittedBy: a tools/call result must carry `content`")
	let firstId = try response.get(contentId).children.get(0) otherwise panic("toolEmittedBy: `content` is empty")
	let text = try response.getString(firstId, key: "text") otherwise panic("toolEmittedBy: `content[0]` has no `text`")
	let payload = try Json.parse(text) otherwise panic("toolEmittedBy: the tool's `text` is not JSON: {text}")
	let emittedId = try payload.getChild(payload.root, key: "emittedBy") otherwise panic("toolEmittedBy: the tool's answer has no `emittedBy`")
	return objectKeys(payload, id: emittedId)
end 'toolEmittedBy'

// The GATE's own parse of the same entry, read back out of the artifact it generated.
function readGeneratedEmittedBy(workRoot FilePath, code JsonInt) returns StringArray throws NotFound
	let doc = try readJsonFile(joinPath(workRoot, segment: InterchangeRelativePath)) otherwise throw NotFound.notFound
	let codesId = try doc.getChild(doc.root, key: "codes") otherwise throw NotFound.notFound

	for entryId in doc.get(codesId).children 'scan'
		let number = try doc.getInt(entryId, key: "code") otherwise throw NotFound.notFound
		if number != code 'otherCode'
			continue
		end 'otherCode'

		let emittedId = try doc.getChild(entryId, key: "emittedBy") otherwise throw NotFound.notFound
		return objectKeys(doc, id: emittedId)
	end 'scan'

	throw NotFound.notFound
end 'readGeneratedEmittedBy'

function objectKeys(doc JsonDoc, id JsonNodeId) returns StringArray
	var out = StringArray.create()
	for key in doc.get(id).keys 'each'
		out.push(key)
	end 'each'

	return out
end 'objectKeys'

function readJsonFile(path FilePath) returns JsonDoc throws NotFound
	let text = try File.readText(path) otherwise throw NotFound.notFound
	return try Json.parse(text) otherwise throw NotFound.notFound
end 'readJsonFile'

function stringField(doc JsonDoc, key String) returns String throws NotFound
	return try doc.getString(doc.root, key: key) otherwise throw NotFound.notFound
end 'stringField'

function stringArrayField(doc JsonDoc, key String) returns StringArray throws NotFound
	let id = try doc.getChild(doc.root, key: key) otherwise throw NotFound.notFound
	var out = StringArray.create()
	for childId in doc.get(id).children 'each'
		out.push(doc.get(childId).stringValue)
	end 'each'

	return out
end 'stringArrayField'

function render(items StringArray) returns String
	var out = ""
	for (iter, item) in items.withIterator() 'each'
		if iter.index() > 0 'sep'
			out.append(",")
		end 'sep'

		out.append(item)
	end 'each'

	return "[{out}]"
end 'render'
