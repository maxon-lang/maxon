// `spec_test_outcome` MCP tool. Runs the spec-test suite with a filter, then parses
// the per-test PASS/FAIL lines and each failure's message into structured output.
// Useful when the LLM wants "did test X pass? if not, what was the message?"
// without re-scraping the rawTail itself.
//
// The two runners report differently and each gets its own parser:
//   csharp: needs `--verbose` to print a line per test, emits
//     `[TST] [W1] [PASS] spec/test (820ms)`, and groups failures into
//     `[TST] [FAIL] <spec> (P/T)` blocks.
//   shv2: always prints every verdict (it has no `--verbose` and rejects the
//     flag), emits `PASS spec/test` / `FAIL spec/test: <reason>`, and reports no
//     per-test duration.
//
// Inputs (JSON):
//   filter: String          — required; passed to `--filter=<filter>`
//   network?: bool          — → --network  (shv2 only; runs the live-network fragments)
//   compiler?: "csharp" | "shv2"   (default "csharp")
//   target?: String         — passed to `--target=<value>` (shv2 too, since 2026-07-18)
//
// Output (JSON):
//   compiler, filter, total, passed, failed, durationMs, memoryLeak,
//   tests: [{spec, test, status, durationMs?}],
//   failures: [{spec, message}],
//   rawTail.

// `Byte` / `ByteArray` come from `File.maxon`'s exported aliases — see `Util.maxon`.
typealias TestDurationMs = int(0 to u64.max)

let specOutcomeTimeoutMs = 600000
let rawTailMaxBytes = 4096
let memoryLeakExitCode = 101

/// Entry point called by Server.maxon's dispatch table. `repoRoot` is the tree whose
/// binary is run against whose specs — resolved and validated by the dispatcher.
export function specOutcomeHandler(argsDoc JsonDoc, argsId JsonNodeId, repoRoot FilePath) returns ToolOutcome
	let filter = try argsDoc.getString(argsId, key: "filter") otherwise 'noFilter'
		return ToolOutcome.error(RpcStandardErrorCode.invalidParams.rawValue, message: "spec_test_outcome: missing required `filter` argument (a pattern matching test names)")
	end 'noFilter'

	let compiler = try optionalCompiler(argsDoc, argsId: argsId) otherwise (err) 'badCompiler'
		return ToolOutcome.error(RpcStandardErrorCode.invalidParams.rawValue, message: "spec_test_outcome: {compilerArgErrorReason(err)}")
	end 'badCompiler'

	try checkSpecTestFlags(argsDoc, argsId: argsId, compiler: compiler) otherwise (flag) 'unsupported'
		return ToolOutcome.error(RpcStandardErrorCode.invalidParams.rawValue, message: "spec_test_outcome: {unsupportedFlagReason(flag, compiler: compiler)}")
	end 'unsupported'

	let binary = try compilerBinary(repoRoot, compiler: compiler) otherwise 'noBin'
		return ToolOutcome.error(RpcStandardErrorCode.invalidRequest.rawValue, message: "spec_test_outcome {compiler.name}: required binary missing. Build it first via the `build` tool (target: \"{compiler.name}\").")
	end 'noBin'

	var argv = StringArray.create()
	argv.push("spec-test")
	argv.push("--filter={filter}")
	// See `SpecTestTool`'s arm for why this is a flag rather than a default.
	let network = try argsDoc.getBool(argsId, key: "network") otherwise false
	if network 'haveNetwork'
		argv.push("--network")
	end 'haveNetwork'

	// shv2 reports every verdict unconditionally and rejects `--verbose` outright;
	// the bootstrap runner stays silent without it.
	if specTestNeedsVerbose(compiler) 'needsVerbose'
		argv.push("--verbose")
	end 'needsVerbose'

	// `target` is passed straight through to `--target=<value>`; both compilers accept
	// it (shv2's `wasm32-wasi` runs the emitted component under the vendored wasmtime).
	let target = try argsDoc.getString(argsId, key: "target") otherwise ""
	if not target.isEmpty() 'haveTarget'
		argv.push("--target={target}")
	end 'haveTarget'

	let timing = Clock.nowMs()
	let result = try Subprocess.run(Executable.path(binary), arguments: argv, workingDirectory: repoRoot, timeoutMs: specOutcomeTimeoutMs) otherwise (err) 'spawn'
		return ToolOutcome.error(RpcStandardErrorCode.internalError.rawValue, message: "spec_test_outcome: subprocess: {err.displayReason()}")
	end 'spawn'
	let elapsed = Clock.elapsedMs(timing)

	let combined = combineStreams(result.stdout, stderr: result.stderr)
	let memoryLeak = result.exitCode() == memoryLeakExitCode
	let report = parseReport(combined, compiler: compiler)

	return buildOutcome(compiler, filter: filter, exitCode: result.exitCode(), durationMs: elapsed, memoryLeak: memoryLeak, tests: report.tests, failures: report.failures, combined: combined)
end 'specOutcomeHandler'

// The per-test verdicts plus the failure messages scraped from one spec-test run.
// The two are produced together (shv2's failure message is a continuation of the
// same FAIL line that carries the verdict), so they are returned together.
type SpecReport
	export let tests as SpecTestEntryArray
	export let failures as SpecFailureSummaryArray

	export static function create(tests SpecTestEntryArray, failures SpecFailureSummaryArray) returns SpecReport
		return Self{tests: tests, failures: failures}
	end 'create'
end 'SpecReport'

function parseReport(combined String, compiler Compiler) returns SpecReport
	return match compiler 'pick'
		csharp gives SpecReport.create(parseTests(combined), failures: parseFailureBlocks(combined))
		shv2 gives parseShv2Report(combined)
	end 'pick'
end 'parseReport'

// =============================================================================
// Per-test parsing
// =============================================================================

type SpecTestEntry
	export var spec as String
	export var name as String
	export var passed as bool
	export var durationMs as TestDurationMs
	// shv2's runner times no individual test. `durationMs` is omitted from that
	// compiler's JSON rather than reported as 0 — a test that took no measurable
	// time and a test that was never timed are different claims, and only one of
	// them is true.
	export var durationReported as bool

	export static function timed(spec String, name String, passed bool, durationMs TestDurationMs) returns SpecTestEntry
		return Self{spec: spec, name: name, passed: passed, durationMs: durationMs, durationReported: true}
	end 'timed'

	export static function untimed(spec String, name String, passed bool) returns SpecTestEntry
		return Self{spec: spec, name: name, passed: passed, durationMs: 0, durationReported: false}
	end 'untimed'
end 'SpecTestEntry'

typealias SpecTestEntryArray = Array with SpecTestEntry

// Parse lines like:
//   `[TST] [W6] [PASS] float-type/float-arithmetic (743ms)`
//   `[TST] [W1] [FAIL] arithmetic/division (820ms)`
// Anything else (banner, summary, FAIL block messages) is ignored here —
// those are surfaced via `parseFailureBlocks` / `parseSummary`.
function parseTests(combined String) returns SpecTestEntryArray
	var out = SpecTestEntryArray.create()
	let lines = combined.split("\n")
	let n = lines.count()
	for i in 0 upto n 'each'
		let raw = try lines.get(i) otherwise panic("parseTests: lines.get OOB — i bounded by n")
		let line = raw.trim()
		let parsed = try parseTestLine(line) otherwise 'skip'
			continue
		end 'skip'
		out.push(parsed)
	end 'each'
	return out
end 'parseTests'

function parseTestLine(line String) returns SpecTestEntry throws NotFound
	// Required prefix `[TST] [W<n>] [<status>] `.
	let bytes = line.toByteArray()
	if not line.startsWith("[TST] [W") 'notTst'
		throw NotFound.notFound
	end 'notTst'
	// Skip `[TST] [W` and consume worker digits until `] `.
	let workerStart = "[TST] [W".byteLength()
	var i = workerStart
	let total = bytes.count()
	while i < total 'wDigits'
		let b = try bytes.get(i) otherwise panic("parseTestLine: bytes.get OOB during worker digits")
		if not isAsciiDigit(b) 'stopW'
			break
		end 'stopW'
		i = i + 1
	end 'wDigits'
	if i == workerStart 'noDigits'
		throw NotFound.notFound
	end 'noDigits'
	// Expect `] `.
	if i + 1 >= total 'short1'
		throw NotFound.notFound
	end 'short1'
	let rbracket = try bytes.get(i) otherwise panic("parseTestLine: bytes.get OOB at ']'")
	let space = try bytes.get(i + 1) otherwise panic("parseTestLine: bytes.get OOB at ' '")
	if rbracket != 0x5D or space != 0x20 'notClose'
		throw NotFound.notFound
	end 'notClose'
	i = i + 2

	// Expect `[PASS] ` or `[FAIL] `.
	if i + 7 > total 'shortStatus'
		throw NotFound.notFound
	end 'shortStatus'
	let statusSlice = sliceBytes(bytes, from: i, until: i + 7)
	var passed = false
	if statusSlice.equals("[PASS] ") 'p'
		passed = true
	end 'p' else 'maybeFail'
		if not statusSlice.equals("[FAIL] ") 'nope'
			throw NotFound.notFound
		end 'nope'
	end 'maybeFail'
	i = i + 7

	// `spec/test (<dur>ms)`. Find the trailing ` (` from the right.
	let parenSpace = findFromRight(bytes, needle: " (", from: i)
	if parenSpace < 0 'noParen'
		throw NotFound.notFound
	end 'noParen'
	let identStart = i
	let identEnd = parenSpace as BytePos
	let identSlice = sliceBytes(bytes, from: identStart, until: identEnd)
	let slashIdx = firstSlash(identSlice)
	if slashIdx < 0 'noSlash'
		throw NotFound.notFound
	end 'noSlash'
	let identBytes = identSlice.toByteArray()
	let spec = sliceBytes(identBytes, from: 0, until: slashIdx as BytePos)
	let name = sliceBytes(identBytes, from: (slashIdx + 1) as BytePos, until: identBytes.count())

	// Duration: parse decimal between `(` and `ms)`.
	let durStart = (parenSpace + 2) as BytePos
	var j = durStart
	var dur = 0
	while j < total 'durDigits'
		let b = try bytes.get(j) otherwise panic("parseTestLine: bytes.get OOB during duration")
		if not isAsciiDigit(b) 'stop'
			break
		end 'stop'
		dur = dur * 10 + (b - 0x30)
		j = j + 1
	end 'durDigits'

	return SpecTestEntry.timed(spec, name: name, passed: passed, durationMs: dur as TestDurationMs)
end 'parseTestLine'

// =============================================================================
// shv2 parsing
// =============================================================================

// shv2's runner prints one line per test, unconditionally:
//   `PASS arithmetic/addition`
//   `FAIL arithmetic/division: exit code mismatch: expected 3, got 4`
// and closes with `N passed, M failed`.
//
// A FAIL's reason is interpolated VERBATIM and routinely spans lines — a golden
// mismatch renders a three-line diff, and a failed compile embeds the compiler's
// whole stderr. So the reason is not "the rest of the line": it runs on until the
// next verdict or the summary. Column position can't be the terminator either,
// since captured stderr is itself unindented.
let Shv2PassPrefix = "PASS "
let Shv2FailPrefix = "FAIL "

function parseShv2Report(combined String) returns SpecReport
	var tests = SpecTestEntryArray.create()
	var failures = SpecFailureSummaryArray.create()

	let lines = combined.split("\n")
	let n = lines.count()
	var i = 0
	while i < n 'eachLine'
		let line = try lines.get(i) otherwise panic("parseShv2Report: lines.get OOB — i bounded by n")
		i = i + 1

		if line.startsWith(Shv2PassPrefix) 'passed'
			let label = try parseShv2Label(line, prefix: Shv2PassPrefix) otherwise 'notALabel'
				continue
			end 'notALabel'
			tests.push(SpecTestEntry.untimed(label.spec, name: label.name, passed: true))
			continue
		end 'passed'

		if not line.startsWith(Shv2FailPrefix) 'notAVerdict'
			continue
		end 'notAVerdict'

		let label = try parseShv2Label(line, prefix: Shv2FailPrefix) otherwise 'notALabel'
			continue
		end 'notALabel'
		tests.push(SpecTestEntry.untimed(label.spec, name: label.name, passed: false))

		var reason = StringArray.create()
		reason.push(label.rest)

		// Absorb the reason's continuation lines, stopping at the next verdict or
		// the trailing summary.
		while i < n 'reasonLines'
			let next = try lines.get(i) otherwise panic("parseShv2Report: lines.get OOB (reason) — i bounded by n")
			if next.startsWith(Shv2PassPrefix) or next.startsWith(Shv2FailPrefix) 'nextVerdict'
				break
			end 'nextVerdict'

			if isShv2SummaryLine(next.trim()) 'summary'
				break
			end 'summary'

			reason.push(next)
			i = i + 1
		end 'reasonLines'

		failures.push(SpecFailureSummary.create(label.spec, message: "{label.name}: {joinLines(reason).trim()}"))
	end 'eachLine'

	return SpecReport.create(tests, failures: failures)
end 'parseShv2Report'

// A shv2 verdict line split into its `<spec>`, `<test>`, and whatever trailed the
// label (a FAIL's `: <reason>`, empty for a PASS).
type Shv2Label
	export let spec as String
	export let name as String
	export let rest as String

	export static function create(spec String, name String, rest String) returns Shv2Label
		return Self{spec: spec, name: name, rest: rest}
	end 'create'
end 'Shv2Label'

// Split `PASS spec/test` or `FAIL spec/test: reason` after the verdict prefix. A
// line with no `/` in its label did not come from the runner's verdict printer
// (compiler output echoed into a reason can start with anything) — it is skipped,
// not guessed at.
function parseShv2Label(line String, prefix String) returns Shv2Label throws NotFound
	let bytes = line.toByteArray()
	let body = sliceBytes(bytes, from: prefix.byteLength(), until: bytes.count())
	let bodyBytes = body.toByteArray()

	let slash = firstSlash(body)
	if slash < 0 'noSlash'
		throw NotFound.notFound
	end 'noSlash'
	let spec = sliceBytes(bodyBytes, from: 0, until: slash as BytePos)

	// The test name runs to the `:` that opens a FAIL's reason, or to end-of-line
	// for a PASS. Test names never contain `:`.
	let nameStart = (slash + 1) as BytePos
	let total = bodyBytes.count()
	var colon = nameStart
	while colon < total 'findColon'
		let b = try bodyBytes.get(colon) otherwise panic("parseShv2Label: get OOB — colon bounded by total")
		if b == 0x3A 'foundColon'
			break
		end 'foundColon'
		colon = colon + 1
	end 'findColon'

	let name = sliceBytes(bodyBytes, from: nameStart, until: colon).trim()
	if name.isEmpty() 'noName'
		throw NotFound.notFound
	end 'noName'

	// `colon` sits on the `:` opening a FAIL's reason, or at end-of-line for a PASS
	// (which carries no reason at all).
	let reasonStart = colon + 1 if colon < total else total
	let rest = sliceBytes(bodyBytes, from: reasonStart, until: total).trim()
	return Shv2Label.create(spec, name: name, rest: rest)
end 'parseShv2Label'

// Is this shv2's closing `N passed, M failed`? Used only to stop a multi-line
// failure reason from swallowing the summary.
function isShv2SummaryLine(line String) returns bool
	let digits = try parseLeadingShv2Int(line) otherwise 'notANumber'
		return false
	end 'notANumber'

	return digits.startsWith(" passed, ")
end 'isShv2SummaryLine'

// The remainder of `line` after its leading run of ASCII digits; throws when it
// does not start with one.
function parseLeadingShv2Int(line String) returns String throws NotFound
	let bytes = line.toByteArray()
	let n = bytes.count()
	var i = 0
	while i < n 'digits'
		let b = try bytes.get(i) otherwise panic("parseLeadingShv2Int: get OOB — i bounded by n")
		if not isAsciiDigit(b) 'endOfDigits'
			break
		end 'endOfDigits'
		i = i + 1
	end 'digits'

	if i == 0 'noDigits'
		throw NotFound.notFound
	end 'noDigits'

	return sliceBytes(bytes, from: i, until: n)
end 'parseLeadingShv2Int'

// Sentinel typealias for "no match" — kept in this file so the parser
// helpers stay self-contained.
typealias FindResult = int(-1 to i64.max)

function findFromRight(bytes ByteArray, needle String, from BytePos) returns FindResult
	let needleBytes = needle.toByteArray()
	let nLen = needleBytes.count()
	let total = bytes.count()
	if nLen == 0 'empty'
		return 0
	end 'empty'
	if total < nLen + from 'tooShort'
		return -1
	end 'tooShort'
	var i = total - nLen
	while i >= from 'scan'
		var matched = true
		for k in 0 upto nLen 'inner'
			let hb = try bytes.get(i + k) otherwise panic("findFromRight: bytes.get OOB")
			let nb = try needleBytes.get(k) otherwise panic("findFromRight: needleBytes.get OOB")
			if hb != nb 'ne'
				matched = false
				break
			end 'ne'
		end 'inner'
		if matched 'hit'
			return i as FindResult
		end 'hit'
		if i == from 'reachedStart'
			break
		end 'reachedStart'
		i = i - 1
	end 'scan'
	return -1
end 'findFromRight'

function firstSlash(s String) returns FindResult
	let bytes = s.toByteArray()
	let n = bytes.count()
	var i = 0
	while i < n 'scan'
		let b = try bytes.get(i) otherwise panic("firstSlash: bytes.get OOB")
		if b == 0x2F or b == 0x5C 'sep'
			return i as FindResult
		end 'sep'
		i = i + 1
	end 'scan'
	return -1
end 'firstSlash'

// =============================================================================
// Failure-block parsing
// =============================================================================

type SpecFailureSummary
	export var spec as String
	export var message as String

	export static function create(spec String, message String) returns SpecFailureSummary
		return Self{spec: spec, message: message}
	end 'create'
end 'SpecFailureSummary'

typealias SpecFailureSummaryArray = Array with SpecFailureSummary

// Capture every `[FAIL] <spec> (P/T)` line plus the contiguous block of
// indented (`  <msg>`) message lines beneath it. The runner emits the
// indented lines via `Logger.Error(... "  {msg}")`, then continues with
// the next `[FAIL]` block. Lines that don't fit either shape break the
// current block.
function parseFailureBlocks(combined String) returns SpecFailureSummaryArray
	var out = SpecFailureSummaryArray.create()
	let lines = combined.split("\n")
	let n = lines.count()
	var i = 0
	while i < n 'each'
		let raw = try lines.get(i) otherwise panic("parseFailureBlocks: lines.get OOB")
		let trimmed = raw.trim()
		if not trimmed.startsWith("[TST] [FAIL] ") 'notFail'
			i = i + 1
			continue
		end 'notFail'
		let header = trimmed
		var bodyLines = StringArray.create()
		i = i + 1
		while i < n 'body'
			let next = try lines.get(i) otherwise panic("parseFailureBlocks: lines.get OOB (body)")
			let nextTrim = next.trim()
			// Body lines: `[TST]   <message>` (two leading spaces after [TST]).
			if not nextTrim.startsWith("[TST]   ") 'stopBody'
				break
			end 'stopBody'
			bodyLines.push(nextTrim)
			i = i + 1
		end 'body'
		let specName = extractSpecFromFailHeader(header)
		let message = joinLines(bodyLines)
		out.push(SpecFailureSummary.create(specName, message: message))
	end 'each'
	return out
end 'parseFailureBlocks'

// Extract `<spec>` from `[TST] [FAIL] <spec> (P/T)`. The closing `(P/T)` is
// optional from the parser's standpoint — if it's missing we return
// everything after the prefix.
function extractSpecFromFailHeader(line String) returns String
	let prefix = "[TST] [FAIL] "
	let bytes = line.toByteArray()
	let total = bytes.count()
	let startBp = prefix.byteLength()
	let parenSpace = findFromRight(bytes, needle: " (", from: startBp)
	let endBp = match parenSpace 'pick'
		-1 gives total
		default gives parenSpace as BytePos
	end 'pick'
	return sliceBytes(bytes, from: startBp, until: endBp)
end 'extractSpecFromFailHeader'

function joinLines(lines StringArray) returns String
	var out = ""
	let n = lines.count()
	for i in 0 upto n 'each'
		let line = try lines.get(i) otherwise panic("joinLines: lines.get OOB")
		if not out.isEmpty() 'sep'
			out.append("\n")
		end 'sep'
		out.append(line)
	end 'each'
	return out
end 'joinLines'

// =============================================================================
// Outcome construction
// =============================================================================

function buildOutcome(compiler Compiler, filter String, exitCode ExitInt, durationMs DurationMs, memoryLeak bool, tests SpecTestEntryArray, failures SpecFailureSummaryArray, combined String) returns ToolOutcome
	var passed = 0
	var failed = 0
	let testCount = tests.count()
	for i in 0 upto testCount 'tally'
		let entry = try tests.get(i) otherwise panic("buildOutcome: tests.get OOB")
		if entry.passed 'p'
			passed = passed + 1
		end 'p' else 'f'
			failed = failed + 1
		end 'f'
	end 'tally'

	var doc = JsonDoc.create()
	let compilerId = doc.add(JsonNode.stringNode(compiler.name))
	let filterId = doc.add(JsonNode.stringNode(filter))
	let exitCodeId = doc.add(JsonNode.numberNode(exitCode as JsonFloat))
	let durId = doc.add(JsonNode.numberNode(durationMs as JsonFloat))
	let memoryLeakId = doc.add(JsonNode.boolNode(memoryLeak))
	let totalId = doc.add(JsonNode.numberNode((passed + failed) as JsonFloat))
	let passedId = doc.add(JsonNode.numberNode(passed as JsonFloat))
	let failedId = doc.add(JsonNode.numberNode(failed as JsonFloat))
	let testsArrId = testsArrayJson(doc, tests: tests)
	let failuresArrId = failuresArrayJson(doc, failures: failures)
	let rawTailId = doc.add(JsonNode.stringNode(lastBytes(combined, max: rawTailMaxBytes)))

	var keys = StringArray.create()
	var children = JsonNodeIdArray.create()
	keys.push("compiler")
	children.push(compilerId)
	keys.push("filter")
	children.push(filterId)
	keys.push("total")
	children.push(totalId)
	keys.push("passed")
	children.push(passedId)
	keys.push("failed")
	children.push(failedId)
	keys.push("durationMs")
	children.push(durId)
	keys.push("exitCode")
	children.push(exitCodeId)
	keys.push("memoryLeak")
	children.push(memoryLeakId)
	keys.push("tests")
	children.push(testsArrId)
	keys.push("failures")
	children.push(failuresArrId)
	keys.push("rawTail")
	children.push(rawTailId)
	doc.root = doc.add(JsonNode.objectNode(keys, children: children))

	return ToolOutcome.success(doc, root: doc.root)
end 'buildOutcome'

function testsArrayJson(doc JsonDoc, tests SpecTestEntryArray) returns JsonNodeId
	var ids = JsonNodeIdArray.create()
	let n = tests.count()
	for i in 0 upto n 'each'
		let t = try tests.get(i) otherwise panic("testsArrayJson: tests.get OOB")
		let specId = doc.add(JsonNode.stringNode(t.spec))
		let testId = doc.add(JsonNode.stringNode(t.name))
		let statusId = doc.add(JsonNode.stringNode("PASS" if t.passed else "FAIL"))
		var keys = StringArray.create()
		var children = JsonNodeIdArray.create()
		keys.push("spec")
		children.push(specId)
		keys.push("test")
		children.push(testId)
		keys.push("status")
		children.push(statusId)

		// Omitted entirely when the runner never timed the test — see
		// `SpecTestEntry.untimed`.
		if t.durationReported 'timed'
			let durId = doc.add(JsonNode.numberNode(t.durationMs as JsonFloat))
			keys.push("durationMs")
			children.push(durId)
		end 'timed'

		ids.push(doc.add(JsonNode.objectNode(keys, children: children)))
	end 'each'
	return doc.add(JsonNode.arrayNode(ids))
end 'testsArrayJson'

function failuresArrayJson(doc JsonDoc, failures SpecFailureSummaryArray) returns JsonNodeId
	var ids = JsonNodeIdArray.create()
	let n = failures.count()
	for i in 0 upto n 'each'
		let f = try failures.get(i) otherwise panic("failuresArrayJson: failures.get OOB")
		let specId = doc.add(JsonNode.stringNode(f.spec))
		let msgId = doc.add(JsonNode.stringNode(f.message))
		var keys = StringArray.create()
		var children = JsonNodeIdArray.create()
		keys.push("spec")
		children.push(specId)
		keys.push("message")
		children.push(msgId)
		ids.push(doc.add(JsonNode.objectNode(keys, children: children)))
	end 'each'
	return doc.add(JsonNode.arrayNode(ids))
end 'failuresArrayJson'
