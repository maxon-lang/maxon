// `lookup_error_code` MCP tool. Given a 4-digit Maxon error code (e.g. `3014`,
// `"3014"`, or `"E3014"`), returns its ONE meaning — naming, per compiler, the member
// each spells it with, which compilers do NOT emit it, whether the number is merely
// RESERVED, and the spec files that exercise it.
//
// ⚠ THIS FILE DOES NOT PARSE THE REGISTRY, AND MUST NEVER LEARN HOW.
//
// It used to. `docs/error-codes.txt` is the authored source of truth, and for a while it
// had TWO hand-written parsers: `maxon-sharp/Compiler/ErrorCodeRegistry.cs` (which
// validates it and generates the enums) and this file. They disagreed on five inputs:
//   - a BLANK LINE inside an entry: the gate said OK; this file ended the entry there and
//     answered `emittedBy: {}` — "no compiler emits this code" — about a code the
//     bootstrap declares. An instrument that lies.
//   - an indented `#` COMMENT: the gate said OK; this file PANICKED, tearing down the
//     stdio connection the way the comment three paragraphs down swears it never would.
//   - a TAB between key and value: this file was happy; the gate FAILED `dotnet build`.
// The file that exists BECAUSE a number was written down three times had come to be READ
// by a format written down twice. So: the grammar has ONE parser, in C#, and this tool
// reads `docs/error-codes.json` — which that parser GENERATES — with the stdlib's JSON
// parser. There is no registry grammar in this file to drift.
//
// It is still a pure DATA READ, which was the reason the second parser existed and is a
// reason that still holds: a tool that needs a working compiler in order to explain the
// compiler's own errors is useless at exactly the moment you need it. (v1 has not built
// since 2026-07-13, and this lookup still answers for it.) Both files are committed, so
// the tool needs nothing built, and it needs nothing generated at call time.
//
// The two files are tied together by a HASH, not by trust. `error-codes.json` carries the
// FNV-1a of the registry bytes it was made from; this tool hashes those bytes itself and
// REFUSES if they differ. So a hand-edited registry, or a stale generated file, produces a
// REFUSAL naming the fix — never a confident answer from a copy nobody checked. The answer
// this tool gives is, by construction, the answer the gate sanctioned, or no answer.

// `Byte` / `ByteArray` come from `File.maxon`'s exported aliases — see `Util.maxon`.
typealias CodeNumber = int(1000 to 9999)

// The authored registry. Read here ONLY as bytes, to hash — never parsed.
let ErrorCodeRegistryPath = "docs/error-codes.txt"

// The generated projection of it. This is the file this tool actually reads.
let ErrorCodeInterchangePath = "docs/error-codes.json"

/// Entry point called by Server.maxon's dispatch table. `repoRoot` is the tree whose
/// registry and specs are read — resolved and validated by the dispatcher.
export function lookupErrorCodeHandler(argsDoc JsonDoc, argsId JsonNodeId, repoRoot FilePath) returns ToolOutcome
	let code = try resolveCode(argsDoc, argsId: argsId) otherwise (err) 'bad'
		return ToolOutcome.error(RpcStandardErrorCode.invalidParams.rawValue, message: "lookup_error_code: {errorReason(err)}")
	end 'bad'

	let registry = try loadRegistry(repoRoot) otherwise (err) 'noRegistry'
		return ToolOutcome.error(RpcStandardErrorCode.invalidParams.rawValue, message: "lookup_error_code: {registryErrorReason(err, code: code)}")
	end 'noRegistry'

	let entryId = try findCode(registry, code: code) otherwise 'absent'
		return ToolOutcome.error(RpcStandardErrorCode.invalidParams.rawValue, message: "lookup_error_code: {registryErrorReason(RegistryError.codeAbsent, code: code)}")
	end 'absent'

	let specFiles = collectSpecFilesReferencing(repoRoot, code: code)
	return buildOutcome(registry, entryId: entryId, specFiles: specFiles)
end 'lookupErrorCodeHandler'

// =============================================================================
// Input parsing
// =============================================================================

enum LookupArgError implements Error
	missing
	wrongType
	notFourDigits
	outOfRange
end 'LookupArgError'

function errorReason(err LookupArgError) returns String
	return match err 'r'
		missing gives "missing required `code` argument (number or string like \"E3014\")"
		wrongType gives "`code` must be a number or a string"
		notFourDigits gives "`code` must be a 4-digit value (e.g. 3014 or E3014)"
		outOfRange gives "`code` is outside the 1000..9999 range"
	end 'r'
end 'errorReason'

function resolveCode(argsDoc JsonDoc, argsId JsonNodeId) returns CodeNumber throws LookupArgError
	// Numeric form: `{"code": 3014}`.
	let numeric = try argsDoc.getInt(argsId, key: "code") otherwise 'notNum'
		// Fall through to the string form below.
		return try resolveStringCode(argsDoc, argsId: argsId)
	end 'notNum'
	return try clampToCodeRange(numeric)
end 'resolveCode'

function resolveStringCode(argsDoc JsonDoc, argsId JsonNodeId) returns CodeNumber throws LookupArgError
	let s = try argsDoc.getString(argsId, key: "code") otherwise 'notStr'
		throw LookupArgError.missing
	end 'notStr'
	let bytes = s.toByteArray()
	var start = 0
	let n = bytes.count()
	if n == 0 'empty'
		throw LookupArgError.notFourDigits
	end 'empty'
	let first = try bytes.get(0) otherwise 'gErr'
		panic("resolveStringCode: bytes.get(0) OOB — n > 0 just checked")
	end 'gErr'
	if first == 0x45 or first == 0x65 'leadingE'
		start = 1
	end 'leadingE'
	let digitCount = n - start
	if digitCount != 4 'wrongLen'
		throw LookupArgError.notFourDigits
	end 'wrongLen'
	var value = 0
	for i in start upto n 'each'
		let b = try bytes.get(i) otherwise 'gErr2'
			panic("resolveStringCode: bytes.get OOB — i bounded by n")
		end 'gErr2'
		if not isAsciiDigit(b) 'badDigit'
			throw LookupArgError.notFourDigits
		end 'badDigit'
		value = value * 10 + (b - 0x30)
	end 'each'
	return try clampToCodeRange(value)
end 'resolveStringCode'

function clampToCodeRange(value JsonInt) returns CodeNumber throws LookupArgError
	if value < 1000 or value > 9999 'oob'
		throw LookupArgError.outOfRange
	end 'oob'
	return value as CodeNumber
end 'clampToCodeRange'

// =============================================================================
// The registry hash — the handshake with the gate
// =============================================================================

// FNV-1a, 64-bit, over the registry's raw bytes, as 16 lowercase hex digits. The exact
// algorithm `ErrorCodeRegistry.HashBytes` uses in C#, and the ONE fact these two files
// share.
//
// Sharing it is safe in a way that sharing the GRAMMAR was not, and the difference is the
// whole design: hashing a byte string has a single right answer, so the two
// implementations cannot quietly hold different opinions the way two parsers did. And if
// they somehow did, the failure is a REFUSAL — the hashes would never match and this tool
// would answer nothing — not a wrong answer delivered with confidence.
//
// No length tag: C# folds the bytes and stops, so this folds the bytes and stops.
function registryHash(bytes ByteArray) returns HashDigest
	var hasher = Hasher.create()
	hasher.combine(bytes)
	return hasher.finalize()
end 'registryHash'

// =============================================================================
// Loading the generated registry
// =============================================================================

// Why the registry could not answer. These are DIFFERENT FACTS and get different
// messages: reporting an unreadable registry as "no such code" would be a wrong answer,
// not merely an unhelpful one — and reporting a STALE one as an answer at all would be
// the bug this whole design exists to make unrepresentable.
enum RegistryError implements Error
	registryUnreadable
	interchangeUnreadable
	interchangeMalformed
	interchangeStale
	codeAbsent
end 'RegistryError'

function registryErrorReason(err RegistryError, code CodeNumber) returns String
	return match err 'r'
		registryUnreadable gives "cannot read `{ErrorCodeRegistryPath}` in the tree being used. That file is the single source of truth for the 4-digit code space; a checkout without it cannot answer this."
		interchangeUnreadable gives "cannot read `{ErrorCodeInterchangePath}` in the tree being used. It is GENERATED from `{ErrorCodeRegistryPath}` and committed alongside it; run `maxon error-codes generate` in that tree."
		interchangeMalformed gives "`{ErrorCodeInterchangePath}` is not the shape this tool expects. It is generated — do not hand-edit it. Run `maxon error-codes generate`."
		interchangeStale gives "`{ErrorCodeInterchangePath}` is STALE: it does not match `{ErrorCodeRegistryPath}` as it stands on disk, so it cannot be trusted to say what E{code} means. REFUSING TO ANSWER rather than answering from a registry nobody checked. Run `maxon error-codes generate` in that tree and commit the result."
		codeAbsent gives "E{code} is not in `{ErrorCodeRegistryPath}`. The number is FREE: no compiler declares it and nothing reserves it."
	end 'r'
end 'registryErrorReason'

// The generated registry, parsed by the stdlib's JSON parser — the only parser involved.
type LoadedRegistry
	export var doc as JsonDoc
	export var codesId as JsonNodeId

	export static function create(doc JsonDoc, codesId JsonNodeId) returns LoadedRegistry
		return Self{doc: doc, codesId: codesId}
	end 'create'
end 'LoadedRegistry'

// Reads out of the CALLER'S tree, which is why every failure here is an error and not a
// panic: `repoRoot` comes from the wire, and a panic would tear down the stdio connection
// for every subsequent request on behalf of one bad lookup.
function loadRegistry(repoRoot FilePath) returns LoadedRegistry throws RegistryError
	let authoredBytes = try File.readBinary(childPath(repoRoot, segment: ErrorCodeRegistryPath)) otherwise 'noAuthored'
		throw RegistryError.registryUnreadable
	end 'noAuthored'

	let text = try File.readText(childPath(repoRoot, segment: ErrorCodeInterchangePath)) otherwise 'noJson'
		throw RegistryError.interchangeUnreadable
	end 'noJson'

	let doc = try Json.parse(text) otherwise 'badJson'
		throw RegistryError.interchangeMalformed
	end 'badJson'

	// THE HANDSHAKE. Everything below this line is trusted; nothing above it is.
	let stamped = try doc.getString(doc.root, key: "sourceHash") otherwise 'noHash'
		throw RegistryError.interchangeMalformed
	end 'noHash'
	if not stamped.equals("{registryHash(authoredBytes):016x}") 'stale'
		throw RegistryError.interchangeStale
	end 'stale'

	let codesId = try doc.getChild(doc.root, key: "codes") otherwise 'noCodes'
		throw RegistryError.interchangeMalformed
	end 'noCodes'
	if doc.get(codesId).kind != JsonKind.jsonArray 'notArray'
		throw RegistryError.interchangeMalformed
	end 'notArray'

	return LoadedRegistry.create(doc, codesId: codesId)
end 'loadRegistry'

function findCode(registry LoadedRegistry, code CodeNumber) returns JsonNodeId throws NotFound
	let codes = registry.doc.get(registry.codesId)
	let n = codes.children.count()
	for i in 0 upto n 'scan'
		let entryId = try codes.children.get(i) otherwise 'gErr'
			panic("findCode: codes.children.get OOB — i bounded by n")
		end 'gErr'
		let number = try registry.doc.getInt(entryId, key: "code") otherwise 'noNumber'
			panic("findCode: a generated `codes` entry has no integer `code` — {ErrorCodeInterchangePath} is not the file this tool was generated against")
		end 'noNumber'
		if number == code 'hit'
			return entryId
		end 'hit'
	end 'scan'
	throw NotFound.notFound
end 'findCode'

// =============================================================================
// Spec-file scan
// =============================================================================

// Both suites: `specs/` is the bootstrap's, `specs-shv2/` is shv2's. Scanning only the
// first was part of the same bug — it made shv2's codes look unexercised.
function collectSpecFilesReferencing(repoRoot FilePath, code CodeNumber) returns StringArray
	var matches = StringArray.create()
	var suites = StringArray.create()
	suites.push("specs")
	suites.push("specs-shv2")
	for suite in suites 'eachSuite'
		appendSpecMatches(repoRoot, suite: suite, code: code, into: matches)
	end 'eachSuite'
	return matches
end 'collectSpecFilesReferencing'

function appendSpecMatches(repoRoot FilePath, suite String, code CodeNumber, into StringArray)
	let specsDir = childPath(repoRoot, segment: suite)
	let files = try Directory.list(specsDir) otherwise 'listErr'
		return
	end 'listErr'
	let needle = "E{code}"
	let n = files.count()
	for i in 0 upto n 'each'
		let entry = try files.get(i) otherwise 'gErr'
			panic("appendSpecMatches: files.get OOB — i bounded by n")
		end 'gErr'
		if not entry.path.endsWith(".md") 'notMd'
			continue
		end 'notMd'
		let content = try File.readText(entry) otherwise 'readErr'
			continue
		end 'readErr'
		if content.contains(needle) 'hit'
			into.push(entry.path)
		end 'hit'
	end 'each'
end 'appendSpecMatches'

// =============================================================================
// Outcome construction
// =============================================================================

// The answer IS the generated entry, copied out whole, plus the one thing the registry
// cannot know: which specs exercise the code in THIS tree.
//
// Nothing is recomputed on the way out — not the stage, not `notEmittedBy`, not the tag.
// The generator writes all of them, and a derivation performed here as well would be one
// more fact held in two places, which is the disease this file was treated for.
function buildOutcome(registry LoadedRegistry, entryId JsonNodeId, specFiles StringArray) returns ToolOutcome
	var doc = JsonDoc.create()
	let entryCopy = copyJsonNode(registry.doc, srcId: entryId, dst: doc)
	let entry = doc.get(entryCopy)
	if entry.kind != JsonKind.jsonObject 'notObject'
		panic("buildOutcome: a `codes` entry must be a JSON object, got {entry.kind.name}")
	end 'notObject'

	var specIds = JsonNodeIdArray.create()
	let sn = specFiles.count()
	for i in 0 upto sn 'eachSpec'
		let path = try specFiles.get(i) otherwise 'gErr'
			panic("buildOutcome: specFiles.get OOB — i bounded by sn")
		end 'gErr'
		specIds.push(doc.add(JsonNode.stringNode(path)))
	end 'eachSpec'

	var keys = StringArray.create()
	var children = JsonNodeIdArray.create()
	let n = entry.keys.count()
	for i in 0 upto n 'eachKey'
		let key = try entry.keys.get(i) otherwise 'kErr'
			panic("buildOutcome: entry.keys.get OOB — i bounded by n")
		end 'kErr'
		let childId = try entry.children.get(i) otherwise 'cErr'
			panic("buildOutcome: entry.children.get OOB — parallel arrays out of sync")
		end 'cErr'
		keys.push(key)
		children.push(childId)
	end 'eachKey'
	keys.push("specFiles")
	children.push(doc.add(JsonNode.arrayNode(specIds)))

	doc.root = doc.add(JsonNode.objectNode(keys, children: children))
	return ToolOutcome.success(doc, root: doc.root)
end 'buildOutcome'
