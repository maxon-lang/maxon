// `lookup_error_code` MCP tool. Given a 4-digit Maxon error code (`3014`, `"3014"`,
// `"E3014"`) or a case name (`"semanticUnneededCast"`), returns the code, its
// canonical name, the registry's own documentation of it, and the spec files that
// exercise it.
//
// `maxon-bin/Compiler/ErrorCodeRegistry.maxon` IS the registry: an AUTHORED enum
// whose cases carry the number, the name and the doc text. This file is its only
// reader outside the compiler, so the grammar it reads is described in one place
// and there is nothing for a second opinion to drift from.
//
// It is a pure DATA READ, and that is the point: a tool that needs a working
// compiler in order to explain the compiler's own errors is useless at exactly the
// moment you need it. The registry is committed, so this needs nothing built and
// nothing generated at call time.

typealias CodeNumber = int(1000 to 9999)

// The authored registry, read as text and parsed here.
let ErrorCodeRegistryPath = "maxon-bin/Compiler/ErrorCodeRegistry.maxon"

/// Entry point called by Server.maxon's dispatch table. `repoRoot` is the tree whose
/// registry and specs are read — resolved and validated by the dispatcher.
export function lookupErrorCodeHandler(argsDoc JsonDoc, argsId JsonNodeId, repoRoot FilePath) returns ToolOutcome
	let key = try resolveKey(argsDoc, argsId: argsId) otherwise (err) 'bad'
		return ToolOutcome.error(RpcStandardErrorCode.invalidParams.rawValue, message: "lookup_error_code: {argErrorReason(err)}")
	end 'bad'

	// Reads out of the CALLER'S tree, so an unreadable registry is an error and never a
	// panic: `repoRoot` comes from the wire, and a panic would tear down the stdio
	// connection for every subsequent request on behalf of one bad lookup.
	let text = try File.readText(childPath(repoRoot, segment: ErrorCodeRegistryPath)) otherwise 'unreadable'
		return ToolOutcome.error(RpcStandardErrorCode.invalidParams.rawValue, message: "lookup_error_code: cannot read `{ErrorCodeRegistryPath}` in the tree being used. That file IS the registry of the 4-digit code space; a checkout without it cannot answer this.")
	end 'unreadable'

	let entry = try findEntry(parseRegistry(text), key: key) otherwise 'absent'
		return ToolOutcome.error(RpcStandardErrorCode.invalidParams.rawValue, message: "lookup_error_code: {absentReason(key)}")
	end 'absent'

	return buildOutcome(entry, specFiles: collectSpecFilesReferencing(repoRoot, code: entry.code))
end 'lookupErrorCodeHandler'

// =============================================================================
// Input parsing
// =============================================================================

/// What the caller asked to look up. A `code` argument that is number-shaped names a
/// NUMBER; anything else is taken as a case name, so a caller who has the member in
/// front of them does not have to find its digits first.
union LookupKey
	number(value CodeNumber)
	name(value String)
end 'LookupKey'

enum LookupArgError implements Error
	missing
	notFourDigits
	outOfRange
end 'LookupArgError'

function argErrorReason(err LookupArgError) returns String
	return match err 'r'
		missing gives "missing required `code` argument (a number, a string like \"E3014\", or a case name)"
		notFourDigits gives "a numeric `code` must have 4 digits (e.g. 3014 or E3014)"
		outOfRange gives "`code` is outside the 1000..9999 range"
	end 'r'
end 'argErrorReason'

function resolveKey(argsDoc JsonDoc, argsId JsonNodeId) returns LookupKey throws LookupArgError
	// Numeric form: `{"code": 3014}`.
	let numeric = try argsDoc.getInt(argsId, key: "code") otherwise 'notNum'
		return try resolveStringKey(argsDoc, argsId: argsId)
	end 'notNum'

	return LookupKey.number(try clampToCodeRange(numeric))
end 'resolveKey'

function resolveStringKey(argsDoc JsonDoc, argsId JsonNodeId) returns LookupKey throws LookupArgError
	let raw = try argsDoc.getString(argsId, key: "code") otherwise 'notStr'
		throw LookupArgError.missing
	end 'notStr'

	let token = raw.trim()
	if token.isEmpty() 'empty'
		throw LookupArgError.missing
	end 'empty'

	// A number-shaped token that the code space cannot hold is a MISTAKE and is
	// refused; a token that is not number-shaped at all is a name, and misses (or
	// hits) the registry on its own merits.
	if isCodeToken(token) 'numeric'
		return LookupKey.number(try parseCodeToken(token))
	end 'numeric'

	return LookupKey.name(token)
end 'resolveStringKey'

// `E3014` / `3014`: an optional leading `E`, then nothing but ASCII digits.
function isCodeToken(token String) returns bool
	let bytes = token.toByteArray()
	let n = bytes.count()
	var i = codeDigitsStart(bytes)
	if i >= n 'noDigits'
		return false
	end 'noDigits'

	while i < n 'scan'
		let b = try bytes.get(i) otherwise panic("isCodeToken: bytes.get OOB — i bounded by n")
		if not isAsciiDigit(b) 'notDigit'
			return false
		end 'notDigit'
		i = i + 1
	end 'scan'

	return true
end 'isCodeToken'

// Where the digits begin: past a leading `E` or `e` when there is one.
function codeDigitsStart(bytes ByteArray) returns BytePos
	let first = try bytes.get(0) otherwise 'empty'
		return 0
	end 'empty'

	return 1 if first == 0x45 or first == 0x65 else 0
end 'codeDigitsStart'

// Only ever called on a token `isCodeToken` has already accepted, so the digits are
// known good and only their COUNT and VALUE can still be wrong.
function parseCodeToken(token String) returns CodeNumber throws LookupArgError
	let bytes = token.toByteArray()
	let n = bytes.count()
	let start = codeDigitsStart(bytes)
	if n - start != 4 'wrongLen'
		throw LookupArgError.notFourDigits
	end 'wrongLen'

	var value = 0
	for i in start upto n 'each'
		let b = try bytes.get(i) otherwise panic("parseCodeToken: bytes.get OOB — i bounded by n")
		value = value * 10 + (b - 0x30)
	end 'each'

	return try clampToCodeRange(value)
end 'parseCodeToken'

function clampToCodeRange(value JsonInt) returns CodeNumber throws LookupArgError
	if value < 1000 or value > 9999 'oob'
		throw LookupArgError.outOfRange
	end 'oob'

	return value as CodeNumber
end 'clampToCodeRange'

// =============================================================================
// Reading the registry
// =============================================================================

// One case of the `ErrorCode` enum: the name it is spelled with, the number it
// carries, and the doc comment written above it.
type RegistryEntry
	export var name as String
	export var code as CodeNumber
	// Filled in by `parseRegistry` from the comment run above the case; the line
	// parser sees only the case line itself.
	export var doc as String = ""

	export static function create(name String, code CodeNumber) returns RegistryEntry
		return Self{name: name, code: code}
	end 'create'
end 'RegistryEntry'

typealias RegistryEntryArray = Array with RegistryEntry

let CommentMarker = "//"
let CaseMarker = " = \"E"

// The registry is Maxon source, and the shape this reads is the only shape it is
// written in: a run of `//` lines documenting the case, then `<name> = "E<nnnn>"`.
//
// Any other line ENDS the run — that is what keeps the file's own header, and the
// blank line between stage groups, from being attached to the case that follows.
function parseRegistry(text String) returns RegistryEntryArray
	var out = RegistryEntryArray.create()
	var docLines = StringArray.create()

	let lines = text.split("\n")
	let n = lines.count()
	for i in 0 upto n 'each'
		let raw = try lines.get(i) otherwise panic("parseRegistry: lines.get OOB — i bounded by n")
		let line = raw.trim()

		if line.startsWith(CommentMarker) 'docLine'
			docLines.push(sliceString(line, from: CommentMarker.byteLength(), until: line.byteLength()).trim())
			continue
		end 'docLine'

		var entry = try parseCaseLine(line) otherwise 'notACase'
			docLines = StringArray.create()
			continue
		end 'notACase'

		entry.doc = joinLines(docLines)
		out.push(entry)
		docLines = StringArray.create()
	end 'each'

	return out
end 'parseRegistry'

// `<name> = "E<nnnn>"`, and nothing else on the line.
function parseCaseLine(line String) returns RegistryEntry throws NotFound
	let bytes = line.toByteArray()
	let total = bytes.count()
	let pos = try findByteSequence(bytes, needle: CaseMarker)

	let name = sliceBytes(bytes, from: 0, until: pos)
	if name.isEmpty() 'noName'
		throw NotFound.notFound
	end 'noName'

	// Four digits and a closing quote, then end of line.
	let digitsStart = pos + CaseMarker.byteLength()
	let digitsEnd = digitsStart + 4
	if digitsEnd + 1 != total 'notACaseShape'
		throw NotFound.notFound
	end 'notACaseShape'

	let closing = try bytes.get(digitsEnd) otherwise panic("parseCaseLine: bytes.get OOB — digitsEnd < total")
	if closing != 0x22 'noCloseQuote'
		throw NotFound.notFound
	end 'noCloseQuote'

	var value = 0
	for i in digitsStart upto digitsEnd 'digits'
		let b = try bytes.get(i) otherwise panic("parseCaseLine: bytes.get OOB — i bounded by digitsEnd")
		if not isAsciiDigit(b) 'notDigit'
			throw NotFound.notFound
		end 'notDigit'
		value = value * 10 + (b - 0x30)
	end 'digits'

	if value < 1000 or value > 9999 'outOfBand'
		throw NotFound.notFound
	end 'outOfBand'

	return RegistryEntry.create(name, code: value as CodeNumber)
end 'parseCaseLine'

// =============================================================================
// Lookup
// =============================================================================

function findEntry(entries RegistryEntryArray, key LookupKey) returns RegistryEntry throws NotFound
	let n = entries.count()
	for i in 0 upto n 'scan'
		let entry = try entries.get(i) otherwise panic("findEntry: entries.get OOB — i bounded by n")
		if matchesKey(entry, key: key) 'hit'
			return entry
		end 'hit'
	end 'scan'

	throw NotFound.notFound
end 'findEntry'

// Names are matched case-INSENSITIVELY: the same diagnostic has been spelled in more
// than one casing convention over the code space's life, and a caller quoting the one
// they have in front of them should not have to know which.
function matchesKey(entry RegistryEntry, key LookupKey) returns bool
	return match key 'k'
		number(value) gives entry.code == value
		name(value) gives entry.name.toLower().equals(value.toLower())
	end 'k'
end 'matchesKey'

function absentReason(key LookupKey) returns String
	return match key 'k'
		number(value) gives "E{value} is not in `{ErrorCodeRegistryPath}`. The number is FREE: no case declares it."
		name(value) gives "`{value}` names no case in `{ErrorCodeRegistryPath}`. Pass the 4-digit code (\"E3014\") or the case name as the enum spells it."
	end 'k'
end 'absentReason'

// =============================================================================
// Spec-file scan
// =============================================================================

let SpecSuiteDir = "specs"

function collectSpecFilesReferencing(repoRoot FilePath, code CodeNumber) returns StringArray
	var matches = StringArray.create()
	let files = try Directory.list(childPath(repoRoot, segment: SpecSuiteDir)) otherwise 'listErr'
		return matches
	end 'listErr'

	let needle = "E{code}"
	let n = files.count()
	for i in 0 upto n 'each'
		let entry = try files.get(i) otherwise panic("collectSpecFilesReferencing: files.get OOB — i bounded by n")
		if not entry.path.endsWith(".md") 'notMd'
			continue
		end 'notMd'

		let content = try File.readText(entry) otherwise 'readErr'
			continue
		end 'readErr'

		if content.contains(needle) 'hit'
			matches.push(entry.path)
		end 'hit'
	end 'each'

	return matches
end 'collectSpecFilesReferencing'

// =============================================================================
// Outcome construction
// =============================================================================

function buildOutcome(entry RegistryEntry, specFiles StringArray) returns ToolOutcome
	var doc = JsonDoc.create()

	var specIds = JsonNodeIdArray.create()
	let sn = specFiles.count()
	for i in 0 upto sn 'eachSpec'
		let path = try specFiles.get(i) otherwise panic("buildOutcome: specFiles.get OOB — i bounded by sn")
		specIds.push(doc.add(JsonNode.stringNode(path)))
	end 'eachSpec'

	var keys = StringArray.create()
	var children = JsonNodeIdArray.create()
	keys.push("code")
	children.push(doc.add(JsonNode.numberNode(entry.code as JsonFloat)))
	keys.push("tag")
	children.push(doc.add(JsonNode.stringNode("E{entry.code}")))
	keys.push("name")
	children.push(doc.add(JsonNode.stringNode(entry.name)))
	keys.push("doc")
	children.push(doc.add(JsonNode.stringNode(entry.doc)))
	keys.push("specFiles")
	children.push(doc.add(JsonNode.arrayNode(specIds)))

	doc.root = doc.add(JsonNode.objectNode(keys, children: children))
	return ToolOutcome.success(doc, root: doc.root)
end 'buildOutcome'
