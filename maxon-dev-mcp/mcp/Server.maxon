// MCP server dispatch loop. Reads requests, routes by method name, writes
// responses. Tools live in `toolRegistry()` at the bottom of this file — one row
// per tool, carrying everything `tools/list` and `tools/call` need from it.

// Outcome of a tool invocation. A clean union keeps the response writer
// uniform: it always either splices a result doc into the envelope or emits
// a typed error.
//
// Exported because the per-tool handlers in `BuildTool.maxon`, etc., return
// values of this type.
export union ToolOutcome
	success(doc JsonDoc, root JsonNodeId)
	error(code RpcErrorCode, message String)
end 'ToolOutcome'

// Graceful JSON-RPC error returned when a tool can't locate the Maxon repo
// root (no `bin/maxon` above the server binary — the C# bootstrap hasn't been
// built, or the server was launched from outside a checkout). Centralised so
// every handler reports it identically. Previously `repoRootPath` panicked
// here, which crashed the server process and closed the stdio connection,
// surfacing to clients as an opaque "Connection closed" on every tool call.
export function repoRootErrorOutcome(tool String) returns ToolOutcome
	return ToolOutcome.error(RpcStandardErrorCode.invalidRequest.rawValue, message: "{tool}: could not locate the Maxon repo root — no `bin/maxon{exeSuffix()}` found above the server binary. Build the C# bootstrap first (run `dotnet build` in maxon-sharp).")
end 'repoRootErrorOutcome'

// =============================================================================
// What a tool IS
// =============================================================================

// Builds one tool's input-schema FIELDS — its arguments, and nothing else. The
// object that wraps them (and, decisively, the `description` on that object) is
// put on by `buildToolDescriptor`, which is the only code that ever names a
// description. A `schemaFieldsFor*` builder therefore CANNOT describe its own
// tool a second time: it never sees the object it will be wrapped in.
typealias SchemaFieldsBuilder = function(JsonDoc) returns SchemaFieldArray

// Runs one tool: (the doc holding `arguments`, the `arguments` node) -> outcome.
// Every handler in BuildTool.maxon, SpecTestTool.maxon, ... has this shape.
typealias ToolHandler = function(JsonDoc, JsonNodeId) returns ToolOutcome

// One tool: its name, its ONE description, its arguments, and the code that runs
// it. `tools/list` and `tools/call` both walk the same rows, so a tool cannot be
// half-registered — the shape that used to ship a tool with a missing or wrong
// half when only one of two parallel `name.equals(...)` ladders got updated.
type ToolSpec
	export let name as String
	export let description as String
	export let schemaFields as SchemaFieldsBuilder
	export let handler as ToolHandler

	export static function create(name String, description String, schemaFields SchemaFieldsBuilder, handler ToolHandler) returns ToolSpec
		return Self{name: name, description: description, schemaFields: schemaFields, handler: handler}
	end 'create'
end 'ToolSpec'

typealias ToolSpecArray = Array with ToolSpec

export function runServer()
	var stdin = Console.stdin()
	let tools = toolRegistry()

	while true 'mainLoop'
		let result = readRpcRequest(stdin)
		match result 'r'
			request(req) then handleRequest(req, tools: tools)
			eof then return
			protocolError(msg) then writeRpcParseError(msg)
		end 'r'
	end 'mainLoop'
end 'runServer'

function handleRequest(req RpcRequest, tools ToolSpecArray)
	let idIsNull = isJsonNull(req.doc, id: req.idNodeId)

	if req.method.equals("initialize") 'init'
		let resultDoc = buildInitializeResult()
		writeRpcResult(req.doc, idNodeId: req.idNodeId, resultDoc: resultDoc, resultRoot: resultDoc.root)
		return
	end 'init'

	if req.method.equals("notifications/initialized") 'initd'
		return
	end 'initd'

	if req.method.equals("tools/list") 'tl'
		let resultDoc = buildToolsListResult(tools)
		writeRpcResult(req.doc, idNodeId: req.idNodeId, resultDoc: resultDoc, resultRoot: resultDoc.root)
		return
	end 'tl'

	if req.method.equals("tools/call") 'tc'
		dispatchToolCall(req, tools: tools)
		return
	end 'tc'

	if idIsNull 'ignoreNotif'
		return
	end 'ignoreNotif'
	writeRpcError(req.doc, idNodeId: req.idNodeId, code: RpcStandardErrorCode.methodNotFound.rawValue, message: "method not found: {req.method}")
end 'handleRequest'

function isJsonNull(doc JsonDoc, id JsonNodeId) returns bool
	let node = doc.get(id)
	return match node.kind 'k'
		jsonNull gives true
		jsonBool gives false
		jsonNumber gives false
		jsonString gives false
		jsonArray gives false
		jsonObject gives false
	end 'k'
end 'isJsonNull'

// =============================================================================
// initialize
// =============================================================================

function buildInitializeResult() returns JsonDoc
	var doc = JsonDoc.create()
	let protocolVersion = doc.add(JsonNode.stringNode("2024-11-05"))

	// Capabilities: { "tools": {} } — we only advertise tools in v1.
	var emptyKeys = StringArray.create()
	var emptyChildren = JsonNodeIdArray.create()
	let emptyToolsObj = doc.add(JsonNode.objectNode(emptyKeys, children: emptyChildren))

	var capKeys = StringArray.create()
	var capChildren = JsonNodeIdArray.create()
	capKeys.push("tools")
	capChildren.push(emptyToolsObj)
	let capabilities = doc.add(JsonNode.objectNode(capKeys, children: capChildren))

	let serverName = doc.add(JsonNode.stringNode("maxon-dev-mcp"))
	let serverVersion = doc.add(JsonNode.stringNode("0.1.0"))
	var infoKeys = StringArray.create()
	var infoChildren = JsonNodeIdArray.create()
	infoKeys.push("name")
	infoChildren.push(serverName)
	infoKeys.push("version")
	infoChildren.push(serverVersion)
	let serverInfo = doc.add(JsonNode.objectNode(infoKeys, children: infoChildren))

	var keys = StringArray.create()
	var children = JsonNodeIdArray.create()
	keys.push("protocolVersion")
	children.push(protocolVersion)
	keys.push("capabilities")
	children.push(capabilities)
	keys.push("serverInfo")
	children.push(serverInfo)
	doc.root = doc.add(JsonNode.objectNode(keys, children: children))
	return doc
end 'buildInitializeResult'

// =============================================================================
// tools/list
// =============================================================================

function buildToolsListResult(tools ToolSpecArray) returns JsonDoc
	var doc = JsonDoc.create()
	var toolNodes = JsonNodeIdArray.create()

	let n = tools.count()
	for i in 0 upto n 'each'
		let spec = try tools.get(i) otherwise 'getErr'
			panic("buildToolsListResult: tools.get OOB — i bounds-checked")
		end 'getErr'
		toolNodes.push(buildToolDescriptor(doc, name: spec.name, description: spec.description, schemaFields: spec.schemaFields))
	end 'each'

	let toolsArr = doc.add(JsonNode.arrayNode(toolNodes))

	var keys = StringArray.create()
	var children = JsonNodeIdArray.create()
	keys.push("tools")
	children.push(toolsArr)
	doc.root = doc.add(JsonNode.objectNode(keys, children: children))
	return doc
end 'buildToolsListResult'

// Tool descriptor: name + human description + JSON Schema describing the shape
// of `arguments` for tools/call. Clients (Claude Code, MCP Inspector) use the
// schema to populate completion and validate arguments before they hit our
// handler.
//
// `tools/list` carries a tool's description in TWO places — the descriptor's
// `description`, and the one on its input-schema object. Both are written here,
// from the SAME argument. That is the single site `toolRegistry`'s comment is
// about; keep it single.
//
// The spec is destructured into three parameters instead of being passed whole
// because the C# bootstrap cannot CALL a function-typed FIELD: `spec.schemaFields(doc)`
// is `E9001: Cannot determine function type from MaxonFieldAccessOp`. The same
// value, arriving as a PARAMETER, calls fine — which is the idiom the language
// reference itself uses (`function apply(f UnaryOp, x Integer)`).
function buildToolDescriptor(doc JsonDoc, name String, description String, schemaFields SchemaFieldsBuilder) returns JsonNodeId
	let nameId = doc.add(JsonNode.stringNode(name))
	let descriptionId = doc.add(JsonNode.stringNode(description))
	let schemaId = schemaObject(doc, fields: schemaFields(doc), description: description)

	var keys = StringArray.create()
	var children = JsonNodeIdArray.create()
	keys.push("name")
	children.push(nameId)
	keys.push("description")
	children.push(descriptionId)
	keys.push("inputSchema")
	children.push(schemaId)
	return doc.add(JsonNode.objectNode(keys, children: children))
end 'buildToolDescriptor'

// =============================================================================
// The tools: one description + one argument list each, in registry order
// =============================================================================

// -----------------------------------------------------------------------------
// build
// -----------------------------------------------------------------------------
let BuildDescription = "Build a Maxon compiler. Target is csharp (the bootstrap, via dotnet build) or shv2 (built by the bootstrap). One compiler per call."

function schemaFieldsForBuild(doc JsonDoc) returns SchemaFieldArray
	let targetSchema = schemaStringEnum(doc, choices: compilerTokens(), description: "Which compiler to build. One per call: csharp is built by `dotnet build`; shv2 is built BY the csharp bootstrap, so build csharp first if it is stale.")
	var fields = SchemaFieldArray.create()
	fields.push(SchemaField.create("target", schemaId: targetSchema, required: true))
	return fields
end 'schemaFieldsForBuild'

// -----------------------------------------------------------------------------
// run_spec_test
// -----------------------------------------------------------------------------
let RunSpecTestDescription = "Run a Maxon spec-test suite, optionally filtered, returning structured pass/fail counts. compiler=shv2 runs the specs-shv2 suite."

function schemaFieldsForRunSpecTest(doc JsonDoc) returns SchemaFieldArray
	let compilerSchema = schemaStringEnum(doc, choices: compilerTokens(), description: "Which compiler's spec-test runner to invoke. Default csharp. `shv2` runs the specs-shv2 suite.")
	let filterSchema = schemaString(doc, description: "Optional pattern passed to --filter=<pattern>; matches test names. For shv2 it is a substring of the `<spec>/<test>` label.")
	let updateRequiredSchema = schemaBoolean(doc, description: "Pass --update-required to regenerate RequiredIR blocks (csharp) or the committed .test goldens (shv2) in place. Pair it with `filter` — unfiltered, it rewrites the whole suite.")
	let logSchema = schemaString(doc, description: "Optional logging spec passed to --log=<value> (e.g. \"codegen:trace\").")
	let mmTraceSchema = schemaBoolean(doc, description: "Pass --mm-trace to enable runtime memory-manager trace output. Not supported by shv2.")
	let targetSchema = schemaString(doc, description: "Optional cross-compile target passed to --target=<value> (not supported by shv2, which only builds for the host). Examples: \"x64-windows\", \"arm64-macos\", \"wasm32-wasi\", \"all\".")

	var fields = SchemaFieldArray.create()
	fields.push(SchemaField.create("compiler", schemaId: compilerSchema, required: false))
	fields.push(SchemaField.create("filter", schemaId: filterSchema, required: false))
	fields.push(SchemaField.create("updateRequired", schemaId: updateRequiredSchema, required: false))
	fields.push(SchemaField.create("log", schemaId: logSchema, required: false))
	fields.push(SchemaField.create("mmTrace", schemaId: mmTraceSchema, required: false))
	fields.push(SchemaField.create("target", schemaId: targetSchema, required: false))
	return fields
end 'schemaFieldsForRunSpecTest'

// -----------------------------------------------------------------------------
// lookup_error_code
// -----------------------------------------------------------------------------
let LookupErrorCodeDescription = "Look up a 4-digit Maxon error code (e.g. E3014) by its numeric value, returning the source-of-truth doc comment and the spec files that exercise it."

function schemaFieldsForLookupErrorCode(doc JsonDoc) returns SchemaFieldArray
	let intAlt = schemaInteger(doc, description: "Numeric error code, e.g. 3014.")
	let strAlt = schemaString(doc, description: "Error code as a string, e.g. \"E3014\" or \"3014\".")
	var alts = JsonNodeIdArray.create()
	alts.push(intAlt)
	alts.push(strAlt)
	let codeSchema = schemaOneOf(doc, alternatives: alts, description: "4-digit error code, given as either a number or a string with optional E prefix.")

	var fields = SchemaFieldArray.create()
	fields.push(SchemaField.create("code", schemaId: codeSchema, required: true))
	return fields
end 'schemaFieldsForLookupErrorCode'

// -----------------------------------------------------------------------------
// dump_ir
// -----------------------------------------------------------------------------
let DumpIrDescription = "Compile a snippet or file with --emit-ir using the chosen compiler (csharp | shv2) and return the resulting .ir text (optionally per-stage when dumpStages=true; shv2 emits no stages)."

function schemaFieldsForDumpIr(doc JsonDoc) returns SchemaFieldArray
	let compilerSchema = schemaStringEnum(doc, choices: compilerTokens(), description: "Which compiler to build with. Required — there is no default.")
	let sourceSchema = schemaSource(doc)
	let dumpStagesSchema = schemaBoolean(doc, description: "When true, also emit per-stage IR artifacts (.1-maxon.ir, .2-hir.ir, etc.). Not supported by shv2.")

	var fields = SchemaFieldArray.create()
	fields.push(SchemaField.create("compiler", schemaId: compilerSchema, required: true))
	fields.push(SchemaField.create("source", schemaId: sourceSchema, required: true))
	fields.push(SchemaField.create("dumpStages", schemaId: dumpStagesSchema, required: false))
	return fields
end 'schemaFieldsForDumpIr'

// -----------------------------------------------------------------------------
// run_program
// -----------------------------------------------------------------------------
let RunProgramDescription = "Compile and execute a Maxon snippet or file with the chosen compiler (csharp | shv2), returning build + run exit codes, durations, and stdout/stderr."

function schemaFieldsForRunProgram(doc JsonDoc) returns SchemaFieldArray
	let compilerSchema = schemaStringEnum(doc, choices: compilerTokens(), description: "Which compiler to build the program with. Required — there is no default.")
	let sourceSchema = schemaSource(doc)
	let argvItemSchema = schemaString(doc, description: "One argv entry.")
	let argsSchema = schemaArrayOf(doc, itemSchema: argvItemSchema, description: "Optional argv to pass to the compiled program.")
	let stdinSchema = schemaString(doc, description: "Optional bytes piped to the program's stdin.")
	let timeoutSchema = schemaInteger(doc, description: "Per-run timeout in milliseconds. Default 30000.")

	var fields = SchemaFieldArray.create()
	fields.push(SchemaField.create("compiler", schemaId: compilerSchema, required: true))
	fields.push(SchemaField.create("source", schemaId: sourceSchema, required: true))
	fields.push(SchemaField.create("args", schemaId: argsSchema, required: false))
	fields.push(SchemaField.create("stdin", schemaId: stdinSchema, required: false))
	fields.push(SchemaField.create("timeoutMs", schemaId: timeoutSchema, required: false))
	return fields
end 'schemaFieldsForRunProgram'

// -----------------------------------------------------------------------------
// fmt
// -----------------------------------------------------------------------------
//
// NO `compiler` FIELD — `maxon fmt` is a C# bootstrap command and shv2 has no
// formatter, so the tool is fixed to the bootstrap rather than offering a choice
// one of the two answers with a usage dump.
let FmtDescription = "Format a Maxon snippet or file via `maxon fmt` (C# bootstrap). Files are formatted in-place; snippets return the formatted text."

function schemaFieldsForFmt(doc JsonDoc) returns SchemaFieldArray
	let sourceSchema = schemaSource(doc)

	var fields = SchemaFieldArray.create()
	fields.push(SchemaField.create("source", schemaId: sourceSchema, required: true))
	return fields
end 'schemaFieldsForFmt'

// -----------------------------------------------------------------------------
// spec_test_outcome
// -----------------------------------------------------------------------------
let SpecTestOutcomeDescription = "Run spec-tests with a filter, returning structured per-test PASS/FAIL entries plus a per-spec failure summary. Works against csharp or shv2."

function schemaFieldsForSpecTestOutcome(doc JsonDoc) returns SchemaFieldArray
	let filterSchema = schemaString(doc, description: "Pattern passed to --filter=<pattern>. Typically a single test name like `arithmetic/addition`.")
	let compilerSchema = schemaStringEnum(doc, choices: compilerTokens(), description: "Which compiler. Default csharp.")
	let targetSchema = schemaString(doc, description: "Optional cross-compile target passed to --target=<value> (not supported by shv2, which only builds for the host). Examples: \"x64-windows\", \"arm64-macos\", \"wasm32-wasi\", \"all\".")

	var fields = SchemaFieldArray.create()
	fields.push(SchemaField.create("filter", schemaId: filterSchema, required: true))
	fields.push(SchemaField.create("compiler", schemaId: compilerSchema, required: false))
	fields.push(SchemaField.create("target", schemaId: targetSchema, required: false))
	return fields
end 'schemaFieldsForSpecTestOutcome'

// -----------------------------------------------------------------------------
// mm_trace_analyze
// -----------------------------------------------------------------------------
let MmTraceAnalyzeDescription = "Build a snippet/file with --mm-trace, run it, pipe the trace through scripts/analyze_mm_trace.py, and return the analyzer's JSON report."

function schemaFieldsForMmTraceAnalyze(doc JsonDoc) returns SchemaFieldArray
	let sourceSchema = schemaSource(doc)
	let argvItemSchema = schemaString(doc, description: "One argv entry.")
	let argsSchema = schemaArrayOf(doc, itemSchema: argvItemSchema, description: "Optional argv to pass to the compiled program.")
	let stdinSchema = schemaString(doc, description: "Optional bytes piped to the program's stdin.")
	let timeoutSchema = schemaInteger(doc, description: "Per-run timeout in milliseconds. Default 60000.")

	var fields = SchemaFieldArray.create()
	fields.push(SchemaField.create("source", schemaId: sourceSchema, required: true))
	fields.push(SchemaField.create("args", schemaId: argsSchema, required: false))
	fields.push(SchemaField.create("stdin", schemaId: stdinSchema, required: false))
	fields.push(SchemaField.create("timeoutMs", schemaId: timeoutSchema, required: false))
	return fields
end 'schemaFieldsForMmTraceAnalyze'

// -----------------------------------------------------------------------------
// run_scale_test
// -----------------------------------------------------------------------------
//
// NO `compiler` FIELD. Only shv2 has a `scale-test` command, so the tool is fixed to it — exactly
// as `fmt` is fixed to the C# bootstrap. Offering the field would invite `compiler: "csharp"`
// and answer it with a usage dump; see Compilers.maxon's header on never handing a compiler a flag
// it has never heard of.
//
// NO `updateRequired` EITHER. It rewrote committed memory goldens, and there are none: scale-test is
// an instrument, not a gate. `note` is what RECORDS a run now, and it stands alone.
let ScaleTestDescription = "Run the maxon-shv2 MEMORY-scaling instrument (shv2 only): compile a ladder of generated programs, each rung DOUBLE the last, and report per-rung and per-phase MEMORY — allocations, frees, bytes — plus the delta from the last run recorded in docs/optimization-log.md, which is the trend it feeds. IT COLLECTS NO TIME AND FITS NO CURVES, and both are deliberate. Memory is bit-for-bit reproducible (the same source makes the same allocations on an idle box or a loaded one), so a number that MOVED, moved for a reason; wall time is machine-dependent and cannot be trended at all — for the milliseconds of a single compile, pass log=\"compiler:debug\" and read the COMPILER's own table. And because the ladder DOUBLES, the RATIO between two rungs IS the growth: x2.00 is linear, x4.00 is quadratic, read straight off the counts, so there is nothing to fit and no exponent, residual or share to interpret. It renders NO VERDICT — there is nothing to pass and no green light to chase, and a surprising number is a reading to EXPLAIN. A non-zero exitCode means the RUN BROKE and measured nothing (a rung would not compile, or the generated corpus folded away); it is never a judgement about the numbers."

function schemaFieldsForScaleTest(doc JsonDoc) returns SchemaFieldArray
	let rungsSchema = schemaInteger(doc, description: "How many rungs of the ladder to climb (1-8, default 6). Each rung DOUBLES the generated program, so this is exponential in cost: 6 rungs is a 32x span and about 20 seconds.")
	let noteSchema = schemaString(doc, description: "RECORD this run in docs/optimization-log.md — one dated row of the per-rung allocations and bytes, with this text as the reason. Without it a run reports and records nothing, because scale-test is run dozens of times a day against dirty trees and a log of all of them is a log nobody reads. WITH it the row is ALWAYS written, moved or not: it is an instruction, and you are the only party who knows whether the run is a datapoint. The instrument can see exactly WHAT moved and can never see why: that has to come from you, now.")
	let perTypeSchema = schemaBoolean(doc, description: "Also run the --mm-trace pass, which attributes allocations to the TYPE allocated AND to the SCOPE that allocated it — the scope table is the one that finds things, because a `String` row can never tell you 150 of them came from one function. Off by default: it is a differently-compiled binary from the one being measured, and it traces every allocation individually.")
	let emitCorpusSchema = schemaString(doc, description: "Dump the generated corpus to this directory for inspection and compile NOTHING. The corpus is otherwise built into a gitignored temp dir and thrown away. WARNING: <dir>/rung0..N are owned and pruned by the generator.")
	let logSchema = schemaString(doc, description: "Optional logging spec passed to --log=<value> (e.g. \"compiler:debug\", which prints the COMPILER's own per-phase time and memory tables for each rung's compile — that is where wall-clock milliseconds live, and scale-test itself never collects them).")

	var fields = SchemaFieldArray.create()
	fields.push(SchemaField.create("rungs", schemaId: rungsSchema, required: false))
	fields.push(SchemaField.create("note", schemaId: noteSchema, required: false))
	fields.push(SchemaField.create("perType", schemaId: perTypeSchema, required: false))
	fields.push(SchemaField.create("emitCorpus", schemaId: emitCorpusSchema, required: false))
	fields.push(SchemaField.create("log", schemaId: logSchema, required: false))
	return fields
end 'schemaFieldsForScaleTest'

// =============================================================================
// tools/call
// =============================================================================

function dispatchToolCall(req RpcRequest, tools ToolSpecArray)
	if not req.paramsPresent 'noPar'
		writeRpcError(req.doc, idNodeId: req.idNodeId, code: RpcStandardErrorCode.invalidParams.rawValue, message: "tools/call requires `params`")
		return
	end 'noPar'

	let toolName = try req.doc.getString(req.paramsNodeId, key: "name") otherwise 'noName'
		writeRpcError(req.doc, idNodeId: req.idNodeId, code: RpcStandardErrorCode.invalidParams.rawValue, message: "tools/call params missing `name`")
		return
	end 'noName'

	let spec = try findTool(tools, name: toolName) otherwise 'unknown'
		writeRpcError(req.doc, idNodeId: req.idNodeId, code: RpcStandardErrorCode.methodNotFound.rawValue, message: "unknown tool: {toolName}")
		return
	end 'unknown'

	// `arguments` is optional in the MCP wire format; a handler reading a JSON
	// null finds every one of its keys missing, which is exactly what a call
	// with no arguments means.
	let argsId = try req.doc.getChild(req.paramsNodeId, key: "arguments") otherwise req.doc.add(JsonNode.nullNode())
	invokeAndEmit(spec.handler, req: req, argsId: argsId)
end 'dispatchToolCall'

function findTool(tools ToolSpecArray, name String) returns ToolSpec throws NotFound
	let n = tools.count()
	for i in 0 upto n 'scan'
		let spec = try tools.get(i) otherwise 'gErr'
			panic("findTool: tools.get OOB — i bounds-checked")
		end 'gErr'
		if spec.name.equals(name) 'hit'
			return spec
		end 'hit'
	end 'scan'
	throw NotFound.notFound
end 'findTool'

// Run the tool and write whatever it produced. The handler arrives as a PARAMETER
// rather than being reached through `spec.handler(...)` for the reason spelled out
// on `buildToolDescriptor`: the bootstrap cannot call a function-typed field.
function invokeAndEmit(handler ToolHandler, req RpcRequest, argsId JsonNodeId)
	let outcome = handler(req.doc, argsId)
	match outcome 'o'
		success(doc, root) then emitToolSuccess(doc, root: root, req: req)
		error(code, message) then writeRpcError(req.doc, idNodeId: req.idNodeId, code: code, message: message)
	end 'o'
end 'invokeAndEmit'

// MCP's `tools/call` response shape is `{ content: [{type, text}], isError? }`,
// not the bare structured result a JSON-RPC envelope would otherwise carry.
// We wrap the tool's result doc by stringifying it and shipping it as one
// `type: "text"` content block — that's how MCP clients render structured
// JSON output today.
function emitToolSuccess(resultDoc JsonDoc, root JsonNodeId, req RpcRequest)
	let payload = Json.stringifyPrettyNode(resultDoc, root: root)
	var envelope = JsonDoc.create()
	let textId = envelope.add(JsonNode.stringNode(payload))
	let typeId = envelope.add(JsonNode.stringNode("text"))

	var contentItemKeys = StringArray.create()
	var contentItemChildren = JsonNodeIdArray.create()
	contentItemKeys.push("type")
	contentItemChildren.push(typeId)
	contentItemKeys.push("text")
	contentItemChildren.push(textId)
	let contentItem = envelope.add(JsonNode.objectNode(contentItemKeys, children: contentItemChildren))

	var contentArr = JsonNodeIdArray.create()
	contentArr.push(contentItem)
	let contentArrId = envelope.add(JsonNode.arrayNode(contentArr))

	var keys = StringArray.create()
	var children = JsonNodeIdArray.create()
	keys.push("content")
	children.push(contentArrId)
	envelope.root = envelope.add(JsonNode.objectNode(keys, children: children))

	writeRpcResult(req.doc, idNodeId: req.idNodeId, resultDoc: envelope, resultRoot: envelope.root)
end 'emitToolSuccess'

/// Deep-copy a JSON subtree across arenas. Used to assemble responses
/// whose pieces were built in different `JsonDoc`s (e.g. an analyzer's
/// reply that needs to be embedded in the wrapper outcome doc).
export function copyJsonNode(src JsonDoc, srcId JsonNodeId, dst JsonDoc) returns JsonNodeId
	let node = src.get(srcId)
	match node.kind 'k'
		jsonNull then return dst.add(JsonNode.nullNode())
		jsonBool then return dst.add(JsonNode.boolNode(node.boolValue))
		jsonNumber then return dst.add(JsonNode.numberNode(node.numberValue))
		jsonString then return dst.add(JsonNode.stringNode(node.stringValue))
		jsonArray then return copyJsonArray(src, node: node, dst: dst)
		jsonObject then return copyJsonObject(src, node: node, dst: dst)
	end 'k'
end 'copyJsonNode'

function copyJsonArray(src JsonDoc, node JsonNode, dst JsonDoc) returns JsonNodeId
	var ids = JsonNodeIdArray.create()
	let n = node.children.count()
	for i in 0 upto n 'each'
		let childId = try node.children.get(i) otherwise 'gErr'
			panic("copyJsonArray: children.get OOB — i bounded by n")
		end 'gErr'
		ids.push(copyJsonNode(src, srcId: childId, dst: dst))
	end 'each'
	return dst.add(JsonNode.arrayNode(ids))
end 'copyJsonArray'

function copyJsonObject(src JsonDoc, node JsonNode, dst JsonDoc) returns JsonNodeId
	var keys = StringArray.create()
	var children = JsonNodeIdArray.create()
	let n = node.keys.count()
	for i in 0 upto n 'each'
		let k = try node.keys.get(i) otherwise 'kErr'
			panic("copyJsonObject: keys.get OOB — i bounded by n")
		end 'kErr'
		let childId = try node.children.get(i) otherwise 'cErr'
			panic("copyJsonObject: children.get OOB — parallel arrays out of sync")
		end 'cErr'
		keys.push(k)
		children.push(copyJsonNode(src, srcId: childId, dst: dst))
	end 'each'
	return dst.add(JsonNode.objectNode(keys, children: children))
end 'copyJsonObject'

// =============================================================================
// Tool registry
// =============================================================================

// ⚠ A TOOL IS DESCRIBED ONCE — HERE — AND THAT IS DELIBERATE. Do not helpfully
// add a second description anywhere; there is nowhere left to put one, and that
// is the point.
//
// `tools/list` ships a tool's description TWICE: once as the descriptor's
// `description`, and once on its input-schema object. Both used to be written by
// hand, in two parallel `name.equals(...)` ladders, with nothing making them
// agree — and a model reading two different accounts of the same tool cannot tell
// which one is current.
//
// That is not a hypothetical failure. `run_scale_test`'s two copies drifted: the
// schema went on telling callers that scale-test "checks the per-rung memory
// goldens exactly" and "returns PASS / FAIL / VOID / NOISY" long after the goldens
// and the verdicts had been deleted from the code. A model read it, believed it,
// and built a whole mental model on it — chasing a green light that no longer
// existed, and at one point editing the instrument to make a number look better.
// THE MCP DESCRIPTION IS WHAT A MODEL READS INSTEAD OF THE SOURCE: it is the
// highest-leverage documentation in this repo and the easiest to leave stale,
// because its audience cannot go and check.
//
// So: one row per tool, one description per row, and one list — walked by
// `tools/list` to describe the tool and by `tools/call` to run it. Registering a
// tool is one edit, and half-registering it is not expressible.
function toolRegistry() returns ToolSpecArray
	var tools = ToolSpecArray.create()
	tools.push(ToolSpec.create("build", description: BuildDescription, schemaFields: schemaFieldsForBuild, handler: buildToolHandler))
	tools.push(ToolSpec.create("run_spec_test", description: RunSpecTestDescription, schemaFields: schemaFieldsForRunSpecTest, handler: specTestHandler))
	tools.push(ToolSpec.create("lookup_error_code", description: LookupErrorCodeDescription, schemaFields: schemaFieldsForLookupErrorCode, handler: lookupErrorCodeHandler))
	tools.push(ToolSpec.create("dump_ir", description: DumpIrDescription, schemaFields: schemaFieldsForDumpIr, handler: dumpIrHandler))
	tools.push(ToolSpec.create("run_program", description: RunProgramDescription, schemaFields: schemaFieldsForRunProgram, handler: runProgramHandler))
	tools.push(ToolSpec.create("fmt", description: FmtDescription, schemaFields: schemaFieldsForFmt, handler: fmtHandler))
	tools.push(ToolSpec.create("spec_test_outcome", description: SpecTestOutcomeDescription, schemaFields: schemaFieldsForSpecTestOutcome, handler: specOutcomeHandler))
	tools.push(ToolSpec.create("mm_trace_analyze", description: MmTraceAnalyzeDescription, schemaFields: schemaFieldsForMmTraceAnalyze, handler: mmTraceAnalyzeHandler))
	tools.push(ToolSpec.create("run_scale_test", description: ScaleTestDescription, schemaFields: schemaFieldsForScaleTest, handler: scaleTestHandler))
	return tools
end 'toolRegistry'
