// The maxon-dev MCP server, built from inside its own directory. The repository root declares this same
// build as its `dev-mcp` target.
//
// ⚠ THE SERVER HOLDS AN OPEN HANDLE ON ITS OWN BINARY WHILE IT RUNS, so a rebuild over a live server
// answers E6002. Kill the server, build, then restart it.

export function build() returns ExitCode
	Build.build(".", output: ".maxon/maxon-dev-mcp")
	return 0
end 'build'
