// `build` MCP tool. Invokes the canonical Maxon build commands so MCP clients can
// drive `dotnet build`, `./bin/maxon build maxon-selfhosted`, and `./bin/maxon
// build maxon-shv2` through one structured tool call — no more re-deriving the
// commands each session.
//
// `target` names either one compiler or a chain: `both` = csharp then selfhosted,
// `all` = csharp, selfhosted, then shv2. A chain stops at the first FAILED build.

// Local byte alias — kept file-private so byte arithmetic in the error
// parsers below doesn't have to qualify Util's exported aliases.
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

// Default per-target timeout: 5 minutes. dotnet build on a clean cache plus
// the self-hosted bootstrap can take a couple of minutes each, so a 5-minute
// ceiling per step is generous but not infinite.
let defaultBuildTimeoutMs = 300000

// Tail of captured output we surface in `rawTail`. Long enough to include
// the error summary at the end of a failed dotnet build without flooding
// the MCP response. ~4 KiB.
let rawTailMaxBytes = 4096

// The two multi-compiler `target` values. `both` keeps its established meaning
// (csharp then selfhosted); `all` extends the chain to shv2. Named rather than
// spelled inline because `buildTargetTokens` renders them into the schema and into
// the "unknown target" message, and those must not drift from what `buildStepsFor`
// actually accepts.
let BothTarget = "both"
let AllTarget = "all"

/// Entry point called by Server.maxon's dispatch table.
export function buildToolHandler(argsDoc JsonDoc, argsId JsonNodeId) returns ToolOutcome
	let target = try argsDoc.getString(argsId, key: "target") otherwise 'noTarget'
		return ToolOutcome.error(RpcStandardErrorCode.invalidParams.rawValue, message: "build: missing required `target` (one of {buildTargetList()})")
	end 'noTarget'

	let steps = try buildStepsFor(target) otherwise 'unknownTarget'
		return ToolOutcome.error(RpcStandardErrorCode.invalidParams.rawValue, message: "build: unknown target `{target}` (expected {buildTargetList()})")
	end 'unknownTarget'

	let repoRoot = try repoRootPath() otherwise 'noRoot'
		return repoRootErrorOutcome("build")
	end 'noRoot'

	let lastStep = steps.count() - 1
	for (iter, compiler) in steps.withIterator() 'chain'
		let step = runBuildStep(repoRoot, compiler: compiler)

		// Stop at the first FAILED build, and report it — every later step is built
		// BY the compiler this step was supposed to produce, so continuing would
		// compile the next one with the stale binary left over from a previous run
		// and report that as a success.
		if not step.succeeded 'failed'
			return step.outcome
		end 'failed'

		if iter.index() == lastStep 'chainComplete'
			return step.outcome
		end 'chainComplete'
	end 'chain'

	panic("buildToolHandler: buildStepsFor('{target}') returned an empty chain")
end 'buildToolHandler'

/// The build steps a `target` token selects, in the order they must run.
function buildStepsFor(target String) returns CompilerArray throws CompilerArgError
	var steps = CompilerArray.create()

	if target.equals(BothTarget) or target.equals(AllTarget) 'chained'
		steps.push(Compiler.csharp)
		steps.push(Compiler.selfhosted)

		if target.equals(AllTarget) 'includeShv2'
			steps.push(Compiler.shv2)
		end 'includeShv2'

		return steps
	end 'chained'

	steps.push(try compilerFromToken(target))
	return steps
end 'buildStepsFor'

// `"csharp" | "selfhosted" | "shv2" | "both" | "all"` — every accepted `target`,
// for the schema and the rejection message.
function buildTargetList() returns String
	var out = compilerChoiceList()
	out.append(" | \"{BothTarget}\" | \"{AllTarget}\"")
	return out
end 'buildTargetList'

/// The accepted `target` tokens as a list, for the JSON-Schema `enum`.
export function buildTargetTokens() returns StringArray
	var tokens = compilerTokens()
	tokens.push(BothTarget)
	tokens.push(AllTarget)
	return tokens
end 'buildTargetTokens'

// =============================================================================
// Build steps
// =============================================================================

// One step of a build chain: the JSON envelope to hand back, plus whether the
// build it describes actually SUCCEEDED.
//
// Those are NOT the same thing, and conflating them was a live bug. A failed
// compile still produces a perfectly well-formed envelope — exit code 2, a
// populated `errors` array, and `ToolOutcome.success`, because the tool call itself
// worked fine. `both` matched on the ToolOutcome alone, so a C# bootstrap that
// failed to compile still let the self-hosted build proceed, against the stale
// `bin/maxon.exe` from the previous run.
type BuildStep
	export let outcome as ToolOutcome
	export let succeeded as bool

	export static function create(outcome ToolOutcome, succeeded bool) returns BuildStep
		return Self{outcome: outcome, succeeded: succeeded}
	end 'create'

	// A step that never got as far as an exit code (spawn failure, timeout, or a
	// missing prerequisite): there is no build envelope to report, only the error.
	export static function aborted(outcome ToolOutcome) returns BuildStep
		return Self{outcome: outcome, succeeded: false}
	end 'aborted'
end 'BuildStep'

function runBuildStep(repoRoot FilePath, compiler Compiler) returns BuildStep
	return match compiler 'pick'
		csharp gives runCsharpBuild(repoRoot)
		selfhosted gives runBootstrappedBuild(repoRoot, compiler: compiler, project: "maxon-selfhosted")
		shv2 gives runBootstrappedBuild(repoRoot, compiler: compiler, project: "maxon-shv2")
	end 'pick'
end 'runBuildStep'

// The C# bootstrap is the one compiler not built by a Maxon compiler — MSBuild
// builds it, from `maxon-sharp/`.
function runCsharpBuild(repoRoot FilePath) returns BuildStep
	let cwd = childPath(repoRoot, segment: "maxon-sharp")
	let timing = Clock.nowMs()
	var argv = StringArray.create()
	argv.push("build")
	let result = try Subprocess.run(Executable.name("dotnet"), arguments: argv, workingDirectory: cwd, timeoutMs: defaultBuildTimeoutMs) otherwise (err) 'spawn'
		return BuildStep.aborted(subprocessErrorOutcome("csharp", err: err, durationMs: Clock.elapsedMs(timing)))
	end 'spawn'
	let elapsed = Clock.elapsedMs(timing)

	let binaryPath = compilerBinaryPath(repoRoot, compiler: Compiler.csharp)
	return BuildStep.create(buildOutcome("csharp", result: result, durationMs: elapsed, expectedBinary: binaryPath), succeeded: result.succeeded())
end 'runCsharpBuild'

// `selfhosted` and `shv2` are both compiled BY the C# bootstrap from a project
// directory — same command, same prerequisite, same failure modes. Only the project
// name and the binary it should leave behind differ, so they share one body.
function runBootstrappedBuild(repoRoot FilePath, compiler Compiler, project String) returns BuildStep
	let csharpBinary = compilerBinaryPath(repoRoot, compiler: Compiler.csharp)
	if not File.exists(csharpBinary) 'noCsharp'
		return BuildStep.aborted(ToolOutcome.error(RpcStandardErrorCode.invalidRequest.rawValue, message: "build {compiler.name}: `{csharpBinary.path}` does not exist. Build the C# bootstrap first via target=csharp."))
	end 'noCsharp'

	let timing = Clock.nowMs()
	var argv = StringArray.create()
	argv.push("build")
	argv.push(project)
	let result = try Subprocess.run(Executable.path(csharpBinary), arguments: argv, workingDirectory: repoRoot, timeoutMs: defaultBuildTimeoutMs) otherwise (err) 'spawn'
		return BuildStep.aborted(subprocessErrorOutcome(compiler.name, err: err, durationMs: Clock.elapsedMs(timing)))
	end 'spawn'
	let elapsed = Clock.elapsedMs(timing)

	let binaryPath = compilerBinaryPath(repoRoot, compiler: compiler)
	return BuildStep.create(buildOutcome(compiler.name, result: result, durationMs: elapsed, expectedBinary: binaryPath), succeeded: result.succeeded())
end 'runBootstrappedBuild'

// =============================================================================
// Outcome construction
// =============================================================================

// Build the success/error JSON envelope for one build invocation. Shared
// between csharp and selfhosted because the shape is identical.
function buildOutcome(target String, result CollectedOutput, durationMs DurationMs, expectedBinary FilePath) returns ToolOutcome
	var doc = JsonDoc.create()
	let targetId = doc.add(JsonNode.stringNode(target))
	let exitCodeId = doc.add(JsonNode.numberNode(result.exitCode()))
	let durationId = doc.add(JsonNode.numberNode(durationMs))
	let successId = doc.add(JsonNode.boolNode(result.succeeded()))

	let combinedOutput = combineStreams(result.stdout, stderr: result.stderr)
	let errors = parseBuildErrors(combinedOutput)
	let errorsArr = buildErrorsArray(doc, errors: errors)
	let rawTail = lastBytes(combinedOutput, max: rawTailMaxBytes)
	let rawTailId = doc.add(JsonNode.stringNode(rawTail))

	var keys = StringArray.create()
	var children = JsonNodeIdArray.create()
	keys.push("target")
	children.push(targetId)
	keys.push("exitCode")
	children.push(exitCodeId)
	keys.push("durationMs")
	children.push(durationId)
	keys.push("success")
	children.push(successId)
	if result.succeeded() 'haveBinary'
		let binaryId = doc.add(JsonNode.stringNode(expectedBinary.path))
		keys.push("binaryPath")
		children.push(binaryId)
	end 'haveBinary'
	keys.push("errors")
	children.push(errorsArr)
	keys.push("rawTail")
	children.push(rawTailId)
	doc.root = doc.add(JsonNode.objectNode(keys, children: children))

	return ToolOutcome.success(doc, root: doc.root)
end 'buildOutcome'

// Surface a Subprocess spawn / timeout / I/O failure as a JSON-RPC error. We
// can't construct the success-shaped buildOutcome here because we never got an
// exit code — there was no child to inspect.
function subprocessErrorOutcome(target String, err SubprocessError, durationMs DurationMs) returns ToolOutcome
	return ToolOutcome.error(RpcStandardErrorCode.internalError.rawValue, message: "build {target}: {err.displayReason()} (after {durationMs}ms)")
end 'subprocessErrorOutcome'

// =============================================================================
// Error parsing
// =============================================================================

type BuildError
	export var message as String
	export var code as String = ""
	export var file as String = ""

	export static function fromMessage(message String) returns BuildError
		return Self{message: message}
	end 'fromMessage'
end 'BuildError'

typealias BuildErrorArray = Array with BuildError

// Walk the combined build output line by line. Two formats:
//   - Maxon compiler emits `error E3014: <file>:<line>:<col>: <message>`
//   - MSBuild emits `<file>(<line>,<col>): error CS1234: <message>`
// We scan for both. Anything not matching is ignored — the rawTail field
// already captures full context for ad-hoc inspection.
function parseBuildErrors(combined String) returns BuildErrorArray
	var errors = BuildErrorArray.create()
	let lines = combined.split("\n")
	let n = lines.count()
	for i in 0 upto n 'each'
		let line = try lines.get(i) otherwise 'gErr'
			panic("parseBuildErrors: lines.get OOB — i bounds-checked")
		end 'gErr'
		// Skip blank lines and the spec-test progress chatter (`[TST] ...`).
		if line.isEmpty() 'empty'
			break
		end 'empty'
		extractMaxonError(line, errors: errors)
	end 'each'
	return errors
end 'parseBuildErrors'

// Match the Maxon compiler's `error EXXXX: file:line:col: message` shape.
function extractMaxonError(line String, errors BuildErrorArray)
	let marker = " error E"
	let bytes = line.toByteArray()
	let total = bytes.count()
	let pos = try findByteSequence(bytes, needle: marker) otherwise 'noMaxon'
		// MSBuild form starts with the file path before " error ".
		extractMsbuildError(line, errors: errors)
		return
	end 'noMaxon'
	// Everything after "error E" up to the first colon is the code.
	let afterMarker = pos + marker.byteLength()
	var codeEnd = afterMarker
	while codeEnd < total 'scanCode'
		let b = try bytes.get(codeEnd) otherwise 'gErr'
			panic("extractMaxonError: bytes.get OOB — codeEnd bounded")
		end 'gErr'
		if b == 0x3A 'colon'
			break
		end 'colon'
		codeEnd = codeEnd + 1
	end 'scanCode'
	// `pos` points to the leading space. ` error ` is 7 chars, so `pos + 7`
	// lands on the `E` itself — codeStr already includes the leading `E`.
	let codeStr = sliceString(line, from: pos + 7, until: codeEnd)
	let message = sliceString(line, from: codeEnd + 1, until: total).trim()
	var err = BuildError.fromMessage(message)
	err.code = codeStr
	errors.push(err)
end 'extractMaxonError'

// Match the MSBuild `file(line,col): error CSxxxx: message` shape.
function extractMsbuildError(line String, errors BuildErrorArray)
	let marker = ": error "
	let bytes = line.toByteArray()
	let total = bytes.count()
	let pos = try findByteSequence(bytes, needle: marker) otherwise 'notFound'
		return
	end 'notFound'
	var err = BuildError.fromMessage(sliceString(line, from: pos + marker.byteLength(), until: total))
	// The file/line/col portion ends at the `(` just before " error ".
	// If no `(` precedes it (rare — MSBuild's format always has one — but
	// we keep the lookup total), the file field stays empty.
	let parenPos = try findOpenParenBefore(bytes, endPos: pos) otherwise 'noParen'
		errors.push(err)
		return
	end 'noParen'
	err.file = sliceString(line, from: 0, until: parenPos)
	errors.push(err)
end 'extractMsbuildError'

function findOpenParenBefore(bytes ByteArray, endPos BytePos) returns BytePos throws NotFound
	if endPos == 0 'atZero'
		throw NotFound.notFound
	end 'atZero'
	var i = endPos
	while i > 0 'scan'
		i = i - 1
		let b = try bytes.get(i) otherwise 'gErr'
			panic("findOpenParenBefore: bytes.get OOB — i bounded by endPos < count")
		end 'gErr'
		if b == 0x28 'lparen'
			return i
		end 'lparen'
	end 'scan'
	throw NotFound.notFound
end 'findOpenParenBefore'

// =============================================================================
// JSON helpers
// =============================================================================

function buildErrorsArray(doc JsonDoc, errors BuildErrorArray) returns JsonNodeId
	var ids = JsonNodeIdArray.create()
	let n = errors.count()
	for i in 0 upto n 'each'
		let err = try errors.get(i) otherwise 'gErr'
			panic("buildErrorsArray: errors.get OOB — i bounds-checked")
		end 'gErr'
		let messageId = doc.add(JsonNode.stringNode(err.message))
		var keys = StringArray.create()
		var children = JsonNodeIdArray.create()
		if not err.code.isEmpty() 'haveCode'
			let codeId = doc.add(JsonNode.stringNode(err.code))
			keys.push("code")
			children.push(codeId)
		end 'haveCode'
		if not err.file.isEmpty() 'haveFile'
			let fileId = doc.add(JsonNode.stringNode(err.file))
			keys.push("file")
			children.push(fileId)
		end 'haveFile'
		keys.push("message")
		children.push(messageId)
		ids.push(doc.add(JsonNode.objectNode(keys, children: children)))
	end 'each'
	return doc.add(JsonNode.arrayNode(ids))
end 'buildErrorsArray'
