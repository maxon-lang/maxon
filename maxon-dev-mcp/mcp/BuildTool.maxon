// `build` MCP tool. Runs the repository's own build — `maxon build` at the root,
// which compiles `build.maxon` and does what it says — so a client drives the same
// build a human does through one structured call.
//
// ⭐ THE BUILD IS THE MANIFEST'S, NOT THIS TOOL'S. `build.maxon` names what is
// compiled and where it lands; the compiler writes to its own slot and, when that
// slot holds the image it is running from, vacates it first. Neither fact is
// re-spelled here, so there is nothing for this tool to disagree with.
//
// ⛔ THE ONE THING IT MUST DECIDE IS WHICH COMPILER TO BUILD *WITH*, because Maxon
// compiles Maxon and this repository contains no second implementation. The order
// is the binary in the slot, then a release the user placed in `.bootstrap/` — and
// a caller's `from` overrides both, which is how a slot a failed build emptied is
// recovered.

// A full compile is minutes on its own, and the ceiling sits well clear of that
// rather than at it: a build that runs long should be reported with its elapsed
// time, not killed at the moment it becomes interesting.
let buildTimeoutMs = 1800000

// Where a released compiler is placed to seed a tree that has none. The BINARY
// alone: the compiler resolves `stdlib/` by walking up from its own executable, so
// an archive unpacked whole here would leave a RELEASED stdlib one directory above
// it and this tree's would never be read.
let bootstrapRelativePath = "maxon"

// The manifest target that builds the compiler.
let CompilerTargetName = "maxon-bin"

// Tail of captured output we surface in `rawTail`. Long enough to include
// the error summary at the end of a failed build without flooding the MCP
// response. ~4 KiB.
let rawTailMaxBytes = 4096

// The compiler to build WITH: the binary in the slot, else a release seed. Absence
// is `NotFound.notFound`, the shape `compilerBinary` next door already uses.
//
// A caller's `from` is NOT resolved here — it is a different failure with a
// different remedy (a path that was named and is wrong, rather than no path at
// all), and folding the two together would answer one with the other's message.
function seedCompiler(repoRoot FilePath) returns FilePath throws NotFound
	let slot = compilerBinaryPath(repoRoot)
	if File.exists(slot) 'haveSlot'
		return slot
	end 'haveSlot'

	let seed = childPath(repoRoot, segment: ".bootstrap/{bootstrapRelativePath}{exeSuffix()}")
	if File.exists(seed) 'haveSeed'
		return seed
	end 'haveSeed'

	throw NotFound.notFound
end 'seedCompiler'

/// Entry point called by Server.maxon's dispatch table. `repoRoot` is the tree to
/// build IN — resolved and validated by the dispatcher, never by this tool.
export function buildToolHandler(argsDoc JsonDoc, argsId JsonNodeId, repoRoot FilePath) returns ToolOutcome
	let manifest = childPath(repoRoot, segment: "build.maxon")
	if not File.exists(manifest) 'noManifest'
		return ToolOutcome.error(RpcStandardErrorCode.invalidRequest.rawValue, message: "build: `{manifest.path}` does not exist, so this checkout has no build to run.")
	end 'noManifest'

	let fromArg = try argsDoc.getString(argsId, key: "from") otherwise ""

	var builtWith = compilerBinaryPath(repoRoot)
	if fromArg.isEmpty() 'seeded'
		builtWith = try seedCompiler(repoRoot) otherwise 'noCompiler'
			return ToolOutcome.error(RpcStandardErrorCode.invalidRequest.rawValue, message: "build: no compiler to build with. Maxon is written in Maxon and this repo holds no second implementation — the slot {compilerBinaryPath(repoRoot).path} is empty and there is no .bootstrap/{bootstrapRelativePath}{exeSuffix()}. Install a release and put its `maxon` binary — the BINARY ALONE, not the unpacked archive — at .bootstrap/, or pass `from` naming a compiler you already have.")
		end 'noCompiler'
	end 'seeded' else 'explicit'
		builtWith = try FilePath.from(fromArg) otherwise 'badPath'
			return ToolOutcome.error(RpcStandardErrorCode.invalidParams.rawValue, message: "build: `from` is not a usable path: {fromArg}")
		end 'badPath'
		if not File.exists(builtWith) 'missingFrom'
			return ToolOutcome.error(RpcStandardErrorCode.invalidParams.rawValue, message: "build: `from` names no file: {builtWith.path}")
		end 'missingFrom'
	end 'explicit'

	// No path argument: `build` with none compiles `build.maxon` in the working
	// directory and runs the build it describes.
	var argv = StringArray.create()
	argv.push("build")
	// ⚠ THE TARGET IS NAMED, because the root manifest declares more than one and a bare `build` there
	// LISTS them rather than picking. This tool builds the compiler.
	argv.push(CompilerTargetName)

	let timing = Clock.nowMs()
	let result = try Subprocess.run(Executable.path(builtWith), arguments: argv, workingDirectory: repoRoot, timeoutMs: buildTimeoutMs) otherwise (err) 'spawn'
		// There was no child to inspect, so there is no exit code and no success-shaped
		// envelope to fill.
		return ToolOutcome.error(RpcStandardErrorCode.internalError.rawValue, message: "build: {err.displayReason()} (after {Clock.elapsedMs(timing)}ms)")
	end 'spawn'
	let elapsed = Clock.elapsedMs(timing)

	return buildOutcome(result, durationMs: elapsed, expectedBinary: compilerBinaryPath(repoRoot), builtWith: builtWith.path)
end 'buildToolHandler'

// =============================================================================
// Outcome construction
// =============================================================================

// Build the success/error JSON envelope for one build invocation.
//
// `builtWith` is the compiler this build ran, echoed back because the choice was
// made here and a caller cannot otherwise tell a self-rebuild from a seeded one.
// It carries no default: four other tools here declare a file-private
// `buildOutcome`, and a default published under a name several declarations share
// cannot be resolved at parse time (E2015).
function buildOutcome(result CollectedOutput, durationMs DurationMs, expectedBinary FilePath, builtWith String) returns ToolOutcome
	var doc = JsonDoc.create()
	let exitCodeId = doc.add(JsonNode.numberNode(result.exitCode() as JsonFloat))
	let durationId = doc.add(JsonNode.numberNode(durationMs as JsonFloat))
	let successId = doc.add(JsonNode.boolNode(result.succeeded()))

	let combinedOutput = combineStreams(result.stdout, stderr: result.stderr)
	let errors = parseBuildErrors(combinedOutput)
	let errorsArr = buildErrorsArray(doc, errors: errors)
	let rawTail = lastBytes(combinedOutput, max: rawTailMaxBytes)
	let rawTailId = doc.add(JsonNode.stringNode(rawTail))

	var keys = StringArray.create()
	var children = JsonNodeIdArray.create()
	keys.push("exitCode")
	children.push(exitCodeId)
	keys.push("durationMs")
	children.push(durationId)
	keys.push("success")
	children.push(successId)
	if result.succeeded() 'haveBinary'
		let binaryId = doc.add(JsonNode.stringNode(expectedBinary.path))
		keys.push("binaryPath")
		children.push(binaryId)
	end 'haveBinary'
	let builtWithId = doc.add(JsonNode.stringNode(builtWith))
	keys.push("builtWith")
	children.push(builtWithId)
	keys.push("errors")
	children.push(errorsArr)
	keys.push("rawTail")
	children.push(rawTailId)
	doc.root = doc.add(JsonNode.objectNode(keys, children: children))

	return ToolOutcome.success(doc, root: doc.root)
end 'buildOutcome'

// =============================================================================
// Error parsing
// =============================================================================

type BuildError
	export var message as String
	export var code as String = ""

	export static function fromMessage(message String) returns BuildError
		return Self{message: message}
	end 'fromMessage'
end 'BuildError'

typealias BuildErrorArray = Array with BuildError

// Walk the combined build output line by line for the compiler's
// `error E3014: <file>:<line>:<col>: <message>`. Anything not matching is ignored
// — `rawTail` already carries the full context for ad-hoc inspection.
function parseBuildErrors(combined String) returns BuildErrorArray
	var errors = BuildErrorArray.create()
	let lines = combined.split("\n")
	let n = lines.count()
	for i in 0 upto n 'each'
		let line = try lines.get(i) otherwise 'gErr'
			panic("parseBuildErrors: lines.get OOB — i bounds-checked")
		end 'gErr'
		if line.isEmpty() 'empty'
			continue
		end 'empty'
		extractMaxonError(line, errors: errors)
	end 'each'
	return errors
end 'parseBuildErrors'

// Match the Maxon compiler's `error EXXXX: file:line:col: message` shape.
function extractMaxonError(line String, errors BuildErrorArray)
	let marker = " error E"
	let bytes = line.toByteArray()
	let total = bytes.count()
	let pos = try findByteSequence(bytes, needle: marker) otherwise 'noMaxon'
		return
	end 'noMaxon'
	// Everything after "error E" up to the first colon is the code.
	let afterMarker = pos + marker.byteLength()
	var codeEnd = afterMarker
	while codeEnd < total 'scanCode'
		let b = try bytes.get(codeEnd) otherwise 'gErr'
			panic("extractMaxonError: bytes.get OOB — codeEnd bounded")
		end 'gErr'
		if b == 0x3A 'colon'
			break
		end 'colon'
		codeEnd = codeEnd + 1
	end 'scanCode'
	// `pos` points to the leading space. ` error ` is 7 chars, so `pos + 7`
	// lands on the `E` itself — codeStr already includes the leading `E`.
	let codeStr = sliceString(line, from: pos + 7, until: codeEnd)
	let message = sliceString(line, from: codeEnd + 1, until: total).trim()
	var err = BuildError.fromMessage(message)
	err.code = codeStr
	errors.push(err)
end 'extractMaxonError'

// =============================================================================
// JSON helpers
// =============================================================================

function buildErrorsArray(doc JsonDoc, errors BuildErrorArray) returns JsonNodeId
	var ids = JsonNodeIdArray.create()
	let n = errors.count()
	for i in 0 upto n 'each'
		let err = try errors.get(i) otherwise 'gErr'
			panic("buildErrorsArray: errors.get OOB — i bounds-checked")
		end 'gErr'
		let messageId = doc.add(JsonNode.stringNode(err.message))
		var keys = StringArray.create()
		var children = JsonNodeIdArray.create()
		if not err.code.isEmpty() 'haveCode'
			let codeId = doc.add(JsonNode.stringNode(err.code))
			keys.push("code")
			children.push(codeId)
		end 'haveCode'
		keys.push("message")
		children.push(messageId)
		ids.push(doc.add(JsonNode.objectNode(keys, children: children)))
	end 'each'
	return doc.add(JsonNode.arrayNode(ids))
end 'buildErrorsArray'
