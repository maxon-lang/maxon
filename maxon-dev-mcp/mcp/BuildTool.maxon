// `build` MCP tool. Invokes the canonical Maxon build commands so MCP clients can
// drive `dotnet build` and `scripts/build-shv2.sh` through one structured tool
// call — no more re-deriving the commands each session.
//
// The shv2 arm does NOT re-spell that build. The tree's shv2 is the compiler shv2
// EMITS, so producing it is two compiles and a swap; that sequence is written once,
// in the script, which humans run directly and which this tool spawns.
//
// `target` names exactly ONE compiler. The old `both` / `all` chains existed to
// sequence the bootstrap ahead of the deprecated v1 self-hosted compiler; with two
// compilers left, a caller who wants both makes two calls and sees each verdict on
// its own, rather than a chain that silently stops at the first failure.

// `Byte` and `ByteArray` resolve to `File.maxon`'s exported aliases — see the note in
// `Util.maxon`. A file-private copy no longer unifies with `String.toByteArray()`.

// `dotnet build` on a clean cache takes a couple of minutes, so a 5-minute ceiling
// is generous but not infinite.
let csharpBuildTimeoutMs = 300000

// shv2's build is TWO full compiles — the seed, then the seed compiling the tree
// binary — plus the swap between them, and each half is minutes on its own. The
// ceiling is set well clear of their sum rather than at it: a build that runs long
// should be reported with its elapsed time, not killed at the moment it becomes
// interesting.
let shv2BuildTimeoutMs = 1800000

// The one place the two-compile sequence is written. Humans run it directly; this
// tool spawns it, so there is a single implementation to be wrong.
let shv2BuildScriptRelativePath = "scripts/build-shv2.sh"

// Where the script is asked to leave its structured result. It sits in the
// compiler's own output directory, which is already gitignored and already holds
// everything else this build produces.
let shv2BuildResultRelativePath = "maxon-shv2/.maxon/build-shv2-result.json"

// Tail of captured output we surface in `rawTail`. Long enough to include
// the error summary at the end of a failed dotnet build without flooding
// the MCP response. ~4 KiB.
let rawTailMaxBytes = 4096

/// Entry point called by Server.maxon's dispatch table. `repoRoot` is the tree to
/// build IN — resolved and validated by the dispatcher, never by this tool.
export function buildToolHandler(argsDoc JsonDoc, argsId JsonNodeId, repoRoot FilePath) returns ToolOutcome
	let target = try argsDoc.getString(argsId, key: "target") otherwise 'noTarget'
		return ToolOutcome.error(RpcStandardErrorCode.invalidParams.rawValue, message: "build: missing required `target` (one of {compilerChoiceList()})")
	end 'noTarget'

	let compiler = try compilerFromToken(target) otherwise 'unknownTarget'
		return ToolOutcome.error(RpcStandardErrorCode.invalidParams.rawValue, message: "build: unknown target `{target}` (expected {compilerChoiceList()})")
	end 'unknownTarget'

	return match compiler 'pick'
		csharp gives runCsharpBuild(repoRoot)
		shv2 gives runShv2Build(repoRoot)
	end 'pick'
end 'buildToolHandler'

// =============================================================================
// Build steps
// =============================================================================

// The C# bootstrap is the one compiler not built by a Maxon compiler — MSBuild
// builds it, from `maxon-sharp/`.
function runCsharpBuild(repoRoot FilePath) returns ToolOutcome
	let cwd = childPath(repoRoot, segment: "maxon-sharp")
	let timing = Clock.nowMs()
	var argv = StringArray.create()
	argv.push("build")
	let result = try Subprocess.run(Executable.name("dotnet"), arguments: argv, workingDirectory: cwd, timeoutMs: csharpBuildTimeoutMs) otherwise (err) 'spawn'
		return subprocessErrorOutcome(Compiler.csharp.name, err: err, durationMs: Clock.elapsedMs(timing))
	end 'spawn'
	let elapsed = Clock.elapsedMs(timing)

	let binaryPath = compilerBinaryPath(repoRoot, compiler: Compiler.csharp)
	return buildOutcome(Compiler.csharp.name, result: result, durationMs: elapsed, expectedBinary: binaryPath, stagesJson: "")
end 'runCsharpBuild'

// The tree's shv2 is the compiler shv2 EMITS, so building it is the seed compile,
// the seed compiling the tree binary, and a rename swap between them. That sequence
// lives in `scripts/build-shv2.sh` and is spawned, never re-spelled here — including
// its prerequisite check, so "the bootstrap has not been built" is answered in one
// place whether a human or this tool asked.
function runShv2Build(repoRoot FilePath) returns ToolOutcome
	let script = childPath(repoRoot, segment: shv2BuildScriptRelativePath)
	if not File.exists(script) 'noScript'
		return ToolOutcome.error(RpcStandardErrorCode.invalidRequest.rawValue, message: "build shv2: `{script.path}` does not exist, so this checkout has no shv2 build to run.")
	end 'noScript'

	// A STALE result document is worse than none: read back after a run that broke
	// before writing one, it would report the PREVIOUS build's binaries and durations
	// as this one's. Deleting it up front makes its absence mean something.
	let resultPath = childPath(repoRoot, segment: shv2BuildResultRelativePath)
	try File.delete(resultPath) otherwise ignore

	var argv = StringArray.create()
	argv.push(shv2BuildScriptRelativePath)
	argv.push("--result-json={resultPath.path}")

	let timing = Clock.nowMs()
	let result = try Subprocess.run(Executable.name("bash"), arguments: argv, workingDirectory: repoRoot, timeoutMs: shv2BuildTimeoutMs) otherwise (err) 'spawn'
		return subprocessErrorOutcome(Compiler.shv2.name, err: err, durationMs: Clock.elapsedMs(timing))
	end 'spawn'
	let elapsed = Clock.elapsedMs(timing)

	let binaryPath = compilerBinaryPath(repoRoot, compiler: Compiler.shv2)
	let stagesJson = try File.readText(resultPath) otherwise ""
	return buildOutcome(Compiler.shv2.name, result: result, durationMs: elapsed, expectedBinary: binaryPath, stagesJson: stagesJson)
end 'runShv2Build'

// =============================================================================
// Outcome construction
// =============================================================================

// Build the success/error JSON envelope for one build invocation. Shared by every
// target because the shape is identical.
//
// `stagesJson` is the build script's own result document, empty for a target that
// produces one binary and has nothing further to say. It carries no default: four
// other tools here declare a file-private `buildOutcome`, and a default published
// under a name several declarations share cannot be resolved at parse time (E2015).
function buildOutcome(target String, result CollectedOutput, durationMs DurationMs, expectedBinary FilePath, stagesJson String) returns ToolOutcome
	var doc = JsonDoc.create()
	let targetId = doc.add(JsonNode.stringNode(target))
	let exitCodeId = doc.add(JsonNode.numberNode(result.exitCode()))
	let durationId = doc.add(JsonNode.numberNode(durationMs))
	let successId = doc.add(JsonNode.boolNode(result.succeeded()))

	let combinedOutput = combineStreams(result.stdout, stderr: result.stderr)
	let errors = parseBuildErrors(combinedOutput)
	let errorsArr = buildErrorsArray(doc, errors: errors)
	let rawTail = lastBytes(combinedOutput, max: rawTailMaxBytes)
	let rawTailId = doc.add(JsonNode.stringNode(rawTail))

	var keys = StringArray.create()
	var children = JsonNodeIdArray.create()
	keys.push("target")
	children.push(targetId)
	keys.push("exitCode")
	children.push(exitCodeId)
	keys.push("durationMs")
	children.push(durationId)
	keys.push("success")
	children.push(successId)
	if result.succeeded() 'haveBinary'
		let binaryId = doc.add(JsonNode.stringNode(expectedBinary.path))
		keys.push("binaryPath")
		children.push(binaryId)
	end 'haveBinary'
	if not stagesJson.isEmpty() 'haveStages'
		pushStages(doc, keys: keys, children: children, stagesJson: stagesJson)
	end 'haveStages'
	keys.push("errors")
	children.push(errorsArr)
	keys.push("rawTail")
	children.push(rawTailId)
	doc.root = doc.add(JsonNode.objectNode(keys, children: children))

	return ToolOutcome.success(doc, root: doc.root)
end 'buildOutcome'

// Splice the build script's own result document — each binary it produced and how
// long that compile took — into the envelope. The script is the only party that
// knows those paths, so they are echoed from it rather than re-derived here.
//
// A document that will not parse gets its own key rather than a half-filled
// `stages`: the two facts are "the script reported this" and "the script reported
// something unreadable", and a reader must not have to tell them apart by shape.
function pushStages(doc JsonDoc, keys StringArray, children JsonNodeIdArray, stagesJson String)
	let parsed = try Json.parse(stagesJson) otherwise (err) 'badJson'
		keys.push("stagesError")
		children.push(doc.add(JsonNode.stringNode("the build script's result document is not valid JSON ({err.name})")))
		return
	end 'badJson'

	keys.push("stages")
	children.push(copyJsonNode(parsed, srcId: parsed.root, dst: doc))
end 'pushStages'

// Surface a Subprocess spawn / timeout / I/O failure as a JSON-RPC error. We
// can't construct the success-shaped buildOutcome here because we never got an
// exit code — there was no child to inspect.
function subprocessErrorOutcome(target String, err SubprocessError, durationMs DurationMs) returns ToolOutcome
	return ToolOutcome.error(RpcStandardErrorCode.internalError.rawValue, message: "build {target}: {err.displayReason()} (after {durationMs}ms)")
end 'subprocessErrorOutcome'

// =============================================================================
// Error parsing
// =============================================================================

type BuildError
	export var message as String
	export var code as String = ""
	export var file as String = ""

	export static function fromMessage(message String) returns BuildError
		return Self{message: message}
	end 'fromMessage'
end 'BuildError'

typealias BuildErrorArray = Array with BuildError

// Walk the combined build output line by line. Two formats:
//   - Maxon compiler emits `error E3014: <file>:<line>:<col>: <message>`
//   - MSBuild emits `<file>(<line>,<col>): error CS1234: <message>`
// We scan for both. Anything not matching is ignored — the rawTail field
// already captures full context for ad-hoc inspection.
function parseBuildErrors(combined String) returns BuildErrorArray
	var errors = BuildErrorArray.create()
	let lines = combined.split("\n")
	let n = lines.count()
	for i in 0 upto n 'each'
		let line = try lines.get(i) otherwise 'gErr'
			panic("parseBuildErrors: lines.get OOB — i bounds-checked")
		end 'gErr'
		// Skip blank lines and the spec-test progress chatter (`[TST] ...`).
		if line.isEmpty() 'empty'
			break
		end 'empty'
		extractMaxonError(line, errors: errors)
	end 'each'
	return errors
end 'parseBuildErrors'

// Match the Maxon compiler's `error EXXXX: file:line:col: message` shape.
function extractMaxonError(line String, errors BuildErrorArray)
	let marker = " error E"
	let bytes = line.toByteArray()
	let total = bytes.count()
	let pos = try findByteSequence(bytes, needle: marker) otherwise 'noMaxon'
		// MSBuild form starts with the file path before " error ".
		extractMsbuildError(line, errors: errors)
		return
	end 'noMaxon'
	// Everything after "error E" up to the first colon is the code.
	let afterMarker = pos + marker.byteLength()
	var codeEnd = afterMarker
	while codeEnd < total 'scanCode'
		let b = try bytes.get(codeEnd) otherwise 'gErr'
			panic("extractMaxonError: bytes.get OOB — codeEnd bounded")
		end 'gErr'
		if b == 0x3A 'colon'
			break
		end 'colon'
		codeEnd = codeEnd + 1
	end 'scanCode'
	// `pos` points to the leading space. ` error ` is 7 chars, so `pos + 7`
	// lands on the `E` itself — codeStr already includes the leading `E`.
	let codeStr = sliceString(line, from: pos + 7, until: codeEnd)
	let message = sliceString(line, from: codeEnd + 1, until: total).trim()
	var err = BuildError.fromMessage(message)
	err.code = codeStr
	errors.push(err)
end 'extractMaxonError'

// Match the MSBuild `file(line,col): error CSxxxx: message` shape.
function extractMsbuildError(line String, errors BuildErrorArray)
	let marker = ": error "
	let bytes = line.toByteArray()
	let total = bytes.count()
	let pos = try findByteSequence(bytes, needle: marker) otherwise 'notFound'
		return
	end 'notFound'
	var err = BuildError.fromMessage(sliceString(line, from: pos + marker.byteLength(), until: total))
	// The file/line/col portion ends at the `(` just before " error ".
	// If no `(` precedes it (rare — MSBuild's format always has one — but
	// we keep the lookup total), the file field stays empty.
	let parenPos = try findOpenParenBefore(bytes, endPos: pos) otherwise 'noParen'
		errors.push(err)
		return
	end 'noParen'
	err.file = sliceString(line, from: 0, until: parenPos)
	errors.push(err)
end 'extractMsbuildError'

function findOpenParenBefore(bytes ByteArray, endPos BytePos) returns BytePos throws NotFound
	if endPos == 0 'atZero'
		throw NotFound.notFound
	end 'atZero'
	var i = endPos
	while i > 0 'scan'
		i = i - 1
		let b = try bytes.get(i) otherwise 'gErr'
			panic("findOpenParenBefore: bytes.get OOB — i bounded by endPos < count")
		end 'gErr'
		if b == 0x28 'lparen'
			return i
		end 'lparen'
	end 'scan'
	throw NotFound.notFound
end 'findOpenParenBefore'

// =============================================================================
// JSON helpers
// =============================================================================

function buildErrorsArray(doc JsonDoc, errors BuildErrorArray) returns JsonNodeId
	var ids = JsonNodeIdArray.create()
	let n = errors.count()
	for i in 0 upto n 'each'
		let err = try errors.get(i) otherwise 'gErr'
			panic("buildErrorsArray: errors.get OOB — i bounds-checked")
		end 'gErr'
		let messageId = doc.add(JsonNode.stringNode(err.message))
		var keys = StringArray.create()
		var children = JsonNodeIdArray.create()
		if not err.code.isEmpty() 'haveCode'
			let codeId = doc.add(JsonNode.stringNode(err.code))
			keys.push("code")
			children.push(codeId)
		end 'haveCode'
		if not err.file.isEmpty() 'haveFile'
			let fileId = doc.add(JsonNode.stringNode(err.file))
			keys.push("file")
			children.push(fileId)
		end 'haveFile'
		keys.push("message")
		children.push(messageId)
		ids.push(doc.add(JsonNode.objectNode(keys, children: children)))
	end 'each'
	return doc.add(JsonNode.arrayNode(ids))
end 'buildErrorsArray'
