// Shared utilities used by multiple tools. Kept small — anything that grows
// past one obvious shape (e.g. JSON-builder helpers, command-line parsing)
// should get its own file rather than accreting here.
//
// `Byte` and `ByteArray` are NOT declared here — they resolve to `File.maxon`'s
// EXPORTED aliases. A file-private `typealias ByteArray = Array with Byte` used to
// live here, but since a generic's ranged element type became part of its type
// (commit e4146cf8e), a locally-declared `Array with int(0 to u8.max)` no longer
// unifies with the one `String.toByteArray()` returns from the stdlib — the two are
// distinct types despite identical ranges. Using the stdlib's own exported alias is
// the single canonical byte-array type, so every `.toByteArray()` result flows in
// without a mismatch.

/// Byte position into a ByteArray. Used as the result type of search helpers
/// when a match is found; absence is signalled by throwing `NotFound.notFound`.
export typealias BytePos = int(0 to i64.max)

export enum NotFound implements Error
	notFound
end 'NotFound'

export function isAsciiDigit(b Byte) returns bool
	return b >= 0x30 and b <= 0x39
end 'isAsciiDigit'

// The bytes every path scanner in this file looks for. BOTH separators count wherever one
// does: Windows accepts either and normalizes to `\`, POSIX takes `/` and treats `\` as an
// ordinary character — so a scan that means "a separator" has to accept both to be right on
// either host, and the three scanners here (`parentDirOrThrow`, `lastSegment`, `stripExtension`)
// must agree on that. They did, as a copy of `0x2F` and `0x5C` apiece.
let SlashByte = 0x2F as Byte
let BackslashByte = 0x5C as Byte

// The extension separator — `stripExtension`'s only reason to stop.
let DotByte = 0x2E as Byte

/// Search for `needle` as a byte subsequence of `haystack`. Returns the
/// starting byte index. Throws `NotFound.notFound` if no match.
export function findByteSequence(haystack ByteArray, needle String) returns BytePos throws NotFound
	let needleBytes = needle.toByteArray()
	let nLen = needleBytes.count()
	let hLen = haystack.count()
	if nLen == 0 'empty'
		return 0
	end 'empty'
	if nLen > hLen 'tooLong'
		throw NotFound.notFound
	end 'tooLong'
	let maxStart = hLen - nLen
	for start in 0 upto maxStart + 1 'scan'
		var matched = true
		for k in 0 upto nLen 'inner'
			let hb = try haystack.get(start + k) otherwise 'hErr'
				panic("findByteSequence: haystack.get OOB — bounded by start + nLen <= hLen")
			end 'hErr'
			let nb = try needleBytes.get(k) otherwise 'nErr'
				panic("findByteSequence: needleBytes.get OOB — k bounded by nLen")
			end 'nErr'
			if hb != nb 'ne'
				matched = false
				break
			end 'ne'
		end 'inner'
		if matched 'hit'
			return start
		end 'hit'
	end 'scan'
	throw NotFound.notFound
end 'findByteSequence'

/// Slice a string by byte range. Caller guarantees the range is valid.
export function sliceString(s String, from BytePos, until BytePos) returns String
	let bytes = s.toByteArray()
	return sliceBytes(bytes, from: from, until: until)
end 'sliceString'

/// Slice a byte array by [from, until). Caller guarantees the range is valid.
export function sliceBytes(bytes ByteArray, from BytePos, until BytePos) returns String
	var out = ByteArray.create()
	for i in from upto until 'copy'
		let b = try bytes.get(i) otherwise 'gErr'
			panic("sliceBytes: get OOB — i bounded by `until`")
		end 'gErr'
		out.push(b)
	end 'copy'
	return String.from(out)
end 'sliceBytes'

/// Return up to the last `max` bytes of a string. Used for `rawTail` output
/// fields where we want a bounded snippet of build/test stdout.
export function lastBytes(s String, max BytePos) returns String
	let bytes = s.toByteArray()
	let n = bytes.count()
	if n <= max 'fits'
		return s
	end 'fits'
	let start = n - max
	return sliceBytes(bytes, from: start, until: n)
end 'lastBytes'

/// Join `stdout` and `stderr` into one combined string. When either side is
/// empty the other is returned unchanged so we don't introduce a stray
/// separator line.
export function combineStreams(stdout String, stderr String) returns String
	if stderr.isEmpty() 'noErr'
		return stdout
	end 'noErr'
	if stdout.isEmpty() 'noOut'
		return stderr
	end 'noOut'
	return "{stdout}\n{stderr}"
end 'combineStreams'

/// Build a child FilePath by appending `segment` to `parent`. The forward
/// slash is normalized to the platform separator by `FilePath.from`.
export function childPath(parent FilePath, segment String) returns FilePath
	let joined = "{parent.path}/{segment}"
	return try FilePath.from(joined) otherwise panic("childPath: joined path '{joined}' is invalid")
end 'childPath'

// =============================================================================
// Host executable suffix
// =============================================================================

/// The host platform's executable-file suffix, including the leading dot:
/// `.exe` on Windows, empty on Linux/macOS/Wasi. The MCP tools resolve and
/// invoke the Maxon compiler binaries, whose on-disk names carry this suffix
/// only on Windows. Hardcoding `.exe` made every repo-relative binary path —
/// and the repo-root probe — miss on non-Windows hosts, panicking the server.
export function exeSuffix() returns String
	#if os(Windows)
		return ".exe"
	#else
		return ""
	#endif
end 'exeSuffix'

/// Append the host platform's executable suffix to `base`. On Windows this
/// yields `<base>.exe`; elsewhere the compiler emits an extension-less binary,
/// so `base` is returned unchanged. Use for compiler-produced output binaries
/// (e.g. a built snippet) whose base path is already known.
export function withExeSuffix(base FilePath) returns FilePath
	#if os(Windows)
		return changeExtension(base, ext: "exe")
	#else
		return base
	#endif
end 'withExeSuffix'

// =============================================================================
// Repo root resolution — THE ONE PLACE THAT ANSWERS "WHICH TREE?"
// =============================================================================
//
// Every tool in this server shells out to a compiler, or reads a file, IN SOME
// TREE. Which one is the single most consequential fact about a tool call, and
// for a long time nothing in the wire protocol said it: the root was derived
// from `Process.executablePath()` — the SERVER's own binary — and the server
// lives in the main checkout, so every call drove the main checkout. A caller in
// a git worktree got a `build` that "succeeded" against a tree holding none of
// their work, a spec suite that never saw their change, and (with
// `updateRequired`) a rewrite of the MAIN tree's committed goldens.
//
// It could not have worked any other way: ONE stdio server process is shared by
// every agent in every worktree, and its working directory belongs to the MCP
// host, not to the caller. The server cannot GUESS the tree. So the caller names
// it — `repoRoot` — and when they don't, the server-derived root is the
// (correct, unchanged) default for main-checkout use.
//
// Both halves hold a root to the SAME bar — ABSOLUTE, and a checkout (`isMaxonCheckout`)
// — so a directory can never be a root for one and not the other. The absolute half was
// once asked only of the CALLER's path, which is precisely backwards: a relative path is
// refused because it resolves against the SERVER's working directory instead of the
// caller's, and a relative path the server DERIVED is no safer for having been derived
// here. See `parentDirOrThrow` for the `.` that used to come back out of the walk.

/// The JSON key every tool accepts to name the tree it must act on. Spelled once:
/// the schema builder, the parser and the echo all read it from here.
export let RepoRootArgKey = "repoRoot"

/// Why a repo root could not be established for a tool call. Each case names what
/// is wrong precisely enough that the caller can fix it without reading this file.
export union RepoRootError
	/// No `repoRoot` was given, and the walk up from the server's own binary found
	/// no checkout — the server is running from outside one.
	undiscoverable
	/// `repoRoot` was present but not a string. The caller MEANT to name a tree, so
	/// this is refused rather than treated as an omission.
	notAString(kind String)
	/// `repoRoot` is a string that is not a usable filesystem path.
	malformed(raw String)
	/// `repoRoot` is a RELATIVE path. It cannot be honoured: a relative path would
	/// resolve against the SERVER's working directory, which belongs to the MCP host
	/// and has nothing to do with the caller's — the exact confusion `repoRoot` exists
	/// to end.
	relative(raw String)
	/// `repoRoot` is an absolute path that is not a Maxon checkout.
	notACheckout(path String)
end 'RepoRootError'

// The two directories every Maxon checkout has at its root, and that no directory
// on the path from the server's binary up to that root has: the standard library
// both compilers compile against, and the bootstrap's own source.
//
// Both are COMMITTED, and that is the whole point — see `isMaxonCheckout`.
let StdlibMarkerDir = "stdlib"
let BootstrapMarkerDir = "maxon-sharp"

/// Is `dir` the root of a Maxon checkout? The ONE answer to that question, asked
/// by the walk up from the server's binary and by the validation of a
/// caller-supplied `repoRoot` alike.
///
/// The markers are SOURCE directories, not build output. The obvious probe —
/// `bin/maxon`, which is what the walk originally looked for — is the wrong one:
/// `/bin/` is GITIGNORED, so a freshly-created worktree does not have it. Judging
/// a checkout by it would refuse a brand-new worktree as "not a Maxon repo", and
/// the call it would refuse first is `build target=csharp`, the one call that
/// CREATES `bin/maxon`. A tree is a checkout because of what was checked out into
/// it, never because of what has been built in it.
function isMaxonCheckout(dir FilePath) returns bool
	if not Directory.exists(childPath(dir, segment: StdlibMarkerDir)) 'noStdlib'
		return false
	end 'noStdlib'

	return Directory.exists(childPath(dir, segment: BootstrapMarkerDir))
end 'isMaxonCheckout'

/// What `isMaxonCheckout` looks for, rendered for prose. A refusal quotes it, so a
/// rejected `repoRoot` says what was missing instead of merely saying no.
function repoRootMarkerList() returns String
	return "`{StdlibMarkerDir}/` and `{BootstrapMarkerDir}/`"
end 'repoRootMarkerList'

/// The default tree: the checkout containing the RUNNING SERVER's own binary,
/// found by walking up from it. Correct — and only correct — for a caller working
/// in that same checkout.
///
/// Throws `NotFound` when no checkout turns up within `MaxRepoRootWalkDepth`
/// levels (or the executable path is unavailable). Callers translate that into a
/// graceful per-request JSON-RPC error rather than panicking, which would tear
/// down the whole stdio connection for every subsequent request.
export function repoRootPath() returns FilePath throws NotFound
	let exe = try Process.executablePath() otherwise 'noExe'
		throw NotFound.notFound
	end 'noExe'

	var dir = try parentDirOrThrow(exe) otherwise 'noParent'
		throw NotFound.notFound
	end 'noParent'

	for _ in 0 upto MaxRepoRootWalkDepth 'walk'
		// ABSOLUTE **and** a checkout — the same bar `resolveRepoRoot` holds a CALLER's `repoRoot`
		// to, applied here so the two halves cannot disagree about what a root IS. That symmetry
		// is the point: this half was the unvalidated one.
		//
		// It fires on exactly one path, at the top of the walk: on Windows the parent of
		// `C:\Users` is `C:`, a DRIVE SPEC rather than a directory, and `isAbsolute()` rejects it
		// (it wants `X:\`). Adopting it would put a root nobody can act on into every `repoRoot`
		// echo. It is not the CWD-adoption bug — that one came from `parentDir` answering `.`,
		// and is dead where it was born, in `parentDirOrThrow`.
		if dir.isAbsolute() and isMaxonCheckout(dir) 'found'
			return dir
		end 'found'

		// THE WALK ENDS BECAUSE THE PATH GRAMMAR SAYS IT HAS ENDED, and `parentDirOrThrow` is
		// the one thing that knows where that is. It used to end on `parent.path.equals(dir.path)`
		// — "have I stopped moving?" — which never fired, because the twin this replaced
		// answered `.` rather than standing still. See `parentDirOrThrow`.
		dir = try parentDirOrThrow(dir) otherwise 'atFilesystemRoot'
			throw NotFound.notFound
		end 'atFilesystemRoot'
	end 'walk'

	throw NotFound.notFound
end 'repoRootPath'

// Deep enough for any plausible `<repo>/…/.maxon/<binary>` layout (the canonical
// one is 3 levels) plus a side-built copy under `temp/`, and shallow enough that a
// server started outside a checkout fails fast instead of walking to the filesystem
// root of a deeply-nested directory.
let MaxRepoRootWalkDepth = 16

/// Resolve the tree THIS tool call must act on. Every tool goes through here, and
/// there is no other way to obtain a repo root — which is the point: a second way
/// is how the first one came to be wrong in silence.
///
/// An explicit `repoRoot` that is not a checkout is REFUSED. Falling back to the
/// server's own tree there would rebuild the exact failure this argument exists to
/// end — a tool acting on a tree the caller never named, and reporting success —
/// only now wearing the disguise of a caller who thought they had said otherwise.
export function resolveRepoRoot(argsDoc JsonDoc, argsId JsonNodeId) returns FilePath throws RepoRootError
	let node = try argsDoc.getChild(argsId, key: RepoRootArgKey) otherwise 'absent'
		return try repoRootPath() otherwise throw RepoRootError.undiscoverable
	end 'absent'

	let raw = try argsDoc.getString(argsId, key: RepoRootArgKey) otherwise 'notAString'
		throw RepoRootError.notAString(argsDoc.get(node).kind.name)
	end 'notAString'

	let candidate = try FilePath.from(raw) otherwise throw RepoRootError.malformed(raw)
	if not candidate.isAbsolute() 'relative'
		throw RepoRootError.relative(raw)
	end 'relative'

	if not isMaxonCheckout(candidate) 'notACheckout'
		throw RepoRootError.notACheckout(candidate.path)
	end 'notACheckout'

	return candidate
end 'resolveRepoRoot'

/// Human-readable reason for a `RepoRootError`, returned verbatim to the caller.
export function repoRootErrorReason(err RepoRootError) returns String
	return match err 'e'
		undiscoverable gives "could not locate a Maxon checkout above the server's own binary — no directory with {repoRootMarkerList()} was found. Either the server was launched from outside a checkout, or its binary was moved. Pass `{RepoRootArgKey}` with the absolute path of the tree to act on."
		notAString(kind) gives "`{RepoRootArgKey}` must be a string holding the absolute path of a Maxon checkout, got {kind}."
		malformed(raw) gives "`{RepoRootArgKey}` \"{raw}\" is not a usable filesystem path."
		relative(raw) gives "`{RepoRootArgKey}` \"{raw}\" is relative. It must be ABSOLUTE: a relative path would be resolved against the SERVER's working directory — the MCP host's, not yours — which is the confusion `{RepoRootArgKey}` exists to end."
		notACheckout(path) gives "`{RepoRootArgKey}` \"{path}\" is not a Maxon checkout — it has no {repoRootMarkerList()}. Pass the absolute path of your worktree's ROOT (the directory holding those), not a subdirectory of it."
	end 'e'
end 'repoRootErrorReason'

/// The JSON-RPC code a `RepoRootError` is reported under. A `repoRoot` the caller
/// GAVE and got wrong is an argument error (`invalidParams`); a server that can
/// find no checkout at all was asked to do something it is not positioned to do at
/// all (`invalidRequest`).
export function repoRootErrorCode(err RepoRootError) returns RpcErrorCode
	return match err 'e'
		undiscoverable gives RpcStandardErrorCode.invalidRequest.rawValue
		notAString gives RpcStandardErrorCode.invalidParams.rawValue
		malformed gives RpcStandardErrorCode.invalidParams.rawValue
		relative gives RpcStandardErrorCode.invalidParams.rawValue
		notACheckout gives RpcStandardErrorCode.invalidParams.rawValue
	end 'e'
end 'repoRootErrorCode'

// =============================================================================
// Path manipulation
// =============================================================================

/// The parent directory of `path`, or `NotFound.notFound` when it HAS no parent —
/// when `path` is a filesystem root, or names something with no directory part at all.
///
/// **THE THROW IS WHAT ENDS A WALK UP THE TREE, and it is the only thing that can.**
///
/// This had a twin, `parentDir`, which answered `.` for a path with no separator so that
/// "callers can keep walking without special-casing the root". That is exactly backwards:
/// `.` is not the parent of anything — it is the process's WORKING DIRECTORY, which for
/// this server belongs to the MCP host and to no caller. `parentDir("C:")` returned `.`,
/// and `.` does not equal `"C:"`, so `repoRootPath`'s "have I stopped moving?" guard never
/// fired at a Windows drive root. The walk took one more turn and probed `./stdlib` —
/// asking whether the HOST's working directory was a Maxon checkout, and adopting it if so,
/// echoing `"repoRoot": "."` back to a caller who never named a tree.
///
/// The irony was the bug: `resolveRepoRoot` REFUSES a caller's relative `repoRoot`, loudly
/// and correctly, because it would resolve against the server's working directory rather
/// than theirs — while this half handed exactly such a path back unvalidated. One half of
/// one question was checked.
///
/// So: one function, it says NO when there is no parent, and a walk ends because the path
/// grammar says it has ended rather than because a sentinel happened to compare equal to
/// itself.
export function parentDirOrThrow(path FilePath) returns FilePath throws NotFound
	let bytes = path.path.toByteArray()
	let n = bytes.count()
	var i = n
	while i > 0 'scan'
		i = i - 1
		let b = try bytes.get(i) otherwise 'gErr'
			panic("parentDirOrThrow: bytes.get OOB — i bounded by n")
		end 'gErr'
		if b != SlashByte and b != BackslashByte 'notSep'
			continue
		end 'notSep'

		// A separator at index 0 is a POSIX absolute path's leading `/`. The parent of
		// `/usr` is `/` — NOT the empty string, which is not a path at all and which
		// `FilePath.from` would reject. And `/` itself is the root: no parent, which is
		// what the throw is for.
		if i == 0 'leadingSep'
			if n == 1 'isPosixRoot'
				throw NotFound.notFound
			end 'isPosixRoot'

			let root = sliceBytes(bytes, from: 0, until: 1)
			return try FilePath.from(root) otherwise panic("parentDirOrThrow: a lone separator '{root}' is always a valid path")
		end 'leadingSep'

		let parentStr = sliceBytes(bytes, from: 0, until: i)
		return try FilePath.from(parentStr) otherwise panic("parentDirOrThrow: derived parent '{parentStr}' is invalid")
	end 'scan'

	// No separator anywhere: a bare name (`maxon.exe`), or a Windows DRIVE SPEC (`C:`, which
	// is what the loop above yields for `C:\Users`). Neither has a parent to walk to, and a
	// drive spec is emphatically not the drive's ROOT — `C:` names the current directory on
	// drive C. Answering `.` here, or `C:`, hands the walk a path whose meaning depends on
	// where the process happens to be standing. There is nothing above this; say so.
	throw NotFound.notFound
end 'parentDirOrThrow'

/// Return the final path segment (basename) of `path`. If the path has no
/// separator the whole string is returned unchanged.
export function lastSegment(path FilePath) returns String
	let s = path.path
	let bytes = s.toByteArray()
	let n = bytes.count()
	var i = n
	while i > 0 'scan'
		i = i - 1
		let b = try bytes.get(i) otherwise panic("lastSegment: bytes.get OOB — i bounded by n")
		if b == SlashByte or b == BackslashByte 'sep'
			return sliceBytes(bytes, from: i + 1, until: n)
		end 'sep'
	end 'scan'
	return s
end 'lastSegment'

/// Strip the last `.<ext>` from a path's final segment. `foo/main.maxon`
/// becomes `foo/main`; `foo/no_ext` is returned unchanged. A dot in an
/// earlier segment is not touched.
export function stripExtension(file FilePath) returns FilePath
	let s = file.path
	let bytes = s.toByteArray()
	let n = bytes.count()
	var i = n
	while i > 0 'scan'
		i = i - 1
		let b = try bytes.get(i) otherwise panic("stripExtension: bytes.get OOB — i bounded by n")
		if b == DotByte 'dot'
			let base = sliceBytes(bytes, from: 0, until: i)
			return try FilePath.from(base) otherwise panic("stripExtension: derived base '{base}' is invalid")
		end 'dot'
		if b == SlashByte or b == BackslashByte 'sep'
			break
		end 'sep'
	end 'scan'
	return file
end 'stripExtension'

/// Append `.<ext>` to a path. The caller is responsible for stripping any
/// existing extension first (see `stripExtension`).
export function changeExtension(base FilePath, ext String) returns FilePath
	let joined = "{base.path}.{ext}"
	return try FilePath.from(joined) otherwise panic("changeExtension: '{joined}' is invalid")
end 'changeExtension'
