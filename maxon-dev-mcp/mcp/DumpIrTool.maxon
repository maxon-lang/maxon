// `dump_ir` MCP tool. Compiles a snippet or file with `--emit-ir` and returns the
// produced .ir artifact inline.
//
// Inputs (JSON):
//   source: { kind: "file", path } | { kind: "snippet", code }
//   dumpStages?: bool   — REFUSED: the driver emits no per-stage IR. It is a
//                         field so that asking for it is answered, not dropped.
//
// The artifact carries `{ label, path, content, truncated }`. `path` is the
// on-disk location the IR was written to. For `kind: "file"` sources this is a
// stable path the caller can re-read; for `kind: "snippet"` sources it points
// into the per-call `temp/` scratch dir, which is deleted once the tool
// returns, so the snippet `path` is informational only.
//
// Asm emission and `-O` toggling are a straight extension when the driver exposes
// them; this tool tracks only the flags it actually has.

// IR can be large (single-pass IR for a non-trivial file is easily 10s of
// KB). Cap at 200 KiB so MCP clients don't get a megabyte of text in a single
// response; surface a `truncated` flag when we trim.
let irMaxBytes = 204800

// Default per-build timeout: a single-file compile finishes in well under a
// second; 30s is generous for cold-cache stdlib parses.
let dumpIrTimeoutMs = 30000

/// Entry point called by Server.maxon's dispatch table: resolve the source, run
/// `build --emit-ir`, and package the produced .ir artifact. `repoRoot` is the tree
/// whose compiler is used — resolved and validated by the dispatcher.
export function dumpIrHandler(argsDoc JsonDoc, argsId JsonNodeId, repoRoot FilePath) returns ToolOutcome
	let dumpStages = try argsDoc.getBool(argsId, key: "dumpStages") otherwise false
	try checkDumpStagesSupported(dumpStages) otherwise (flag) 'unsupported'
		return ToolOutcome.error(RpcStandardErrorCode.invalidParams.rawValue, message: "dump_ir: {unsupportedFlagReason(flag)}")
	end 'unsupported'

	let mainFile = try resolveProjectSource(argsDoc, argsId: argsId, snippetPrefix: "dump-ir", repoRoot: repoRoot) otherwise (err) 'badSrc'
		return ToolOutcome.error(RpcStandardErrorCode.invalidParams.rawValue, message: "dump_ir: {sourceArgErrorReason(err)}")
	end 'badSrc'

	let binary = try compilerBinary(repoRoot) otherwise 'noBin'
		cleanupResolvedSource(mainFile, repoRoot: repoRoot)
		return ToolOutcome.error(RpcStandardErrorCode.invalidRequest.rawValue, message: "dump_ir: the compiler binary does not exist. Build it first via the `build` tool.")
	end 'noBin'

	var argv = StringArray.create()
	argv.push("build")
	argv.push(mainFile.projectDir.path)
	argv.push("--emit-ir")

	let result = try Subprocess.run(Executable.path(binary), arguments: argv, workingDirectory: repoRoot, timeoutMs: dumpIrTimeoutMs) otherwise (err) 'spawn'
		cleanupResolvedSource(mainFile, repoRoot: repoRoot)
		return ToolOutcome.error(RpcStandardErrorCode.internalError.rawValue, message: "dump_ir: {err.displayReason()}")
	end 'spawn'

	let outcome = buildOutcome(mainFile, result: result)
	cleanupResolvedSource(mainFile, repoRoot: repoRoot)
	return outcome
end 'dumpIrHandler'

// =============================================================================
// Artifact collection
// =============================================================================

type IrArtifact
	export var label as String
	export var path as String
	export var content as String
	export var truncated as bool = false

	export static function create(label String, path String, content String, truncated bool) returns IrArtifact
		return Self{label: label, path: path, content: content, truncated: truncated}
	end 'create'
end 'IrArtifact'

typealias IrArtifactArray = Array with IrArtifact

function collectArtifacts(mainFile FilePath) returns IrArtifactArray
	var out = IrArtifactArray.create()
	let mainIr = changeExtension(stripExtension(mainFile), ext: "ir")
	addArtifactIfPresent(out, label: "ir", path: mainIr)
	return out
end 'collectArtifacts'

function addArtifactIfPresent(out IrArtifactArray, label String, path FilePath)
	if not File.exists(path) 'absent'
		return
	end 'absent'
	let raw = try File.readText(path) otherwise 'readErr'
		return
	end 'readErr'
	let bytes = raw.toByteArray()
	let n = bytes.count()
	if n <= irMaxBytes 'fits'
		out.push(IrArtifact.create(label, path: path.path, content: raw, truncated: false))
		return
	end 'fits'
	let trimmed = sliceBytes(bytes, from: 0, until: irMaxBytes)
	out.push(IrArtifact.create(label, path: path.path, content: trimmed, truncated: true))
end 'addArtifactIfPresent'

// =============================================================================
// Outcome construction
// =============================================================================

function buildOutcome(mainFile ResolvedSource, result CollectedOutput) returns ToolOutcome
	let combined = combineStreams(result.stdout, stderr: result.stderr)
	let artifacts = collectArtifacts(mainFile.mainFile)

	var doc = JsonDoc.create()
	let exitCodeId = doc.add(JsonNode.numberNode(result.exitCode() as JsonFloat))
	let successId = doc.add(JsonNode.boolNode(result.succeeded()))
	let rawTailId = doc.add(JsonNode.stringNode(combined))

	var artifactNodes = JsonNodeIdArray.create()
	let an = artifacts.count()
	for i in 0 upto an 'each'
		let art = try artifacts.get(i) otherwise 'gErr'
			panic("buildOutcome: artifacts.get OOB — i bounded by an")
		end 'gErr'
		let labelId = doc.add(JsonNode.stringNode(art.label))
		let pathId = doc.add(JsonNode.stringNode(art.path))
		let contentId = doc.add(JsonNode.stringNode(art.content))
		let truncId = doc.add(JsonNode.boolNode(art.truncated))
		var aKeys = StringArray.create()
		var aChildren = JsonNodeIdArray.create()
		aKeys.push("label")
		aChildren.push(labelId)
		aKeys.push("path")
		aChildren.push(pathId)
		aKeys.push("content")
		aChildren.push(contentId)
		aKeys.push("truncated")
		aChildren.push(truncId)
		artifactNodes.push(doc.add(JsonNode.objectNode(aKeys, children: aChildren)))
	end 'each'
	let artifactsArr = doc.add(JsonNode.arrayNode(artifactNodes))

	var keys = StringArray.create()
	var children = JsonNodeIdArray.create()
	keys.push("exitCode")
	children.push(exitCodeId)
	keys.push("success")
	children.push(successId)
	keys.push("artifacts")
	children.push(artifactsArr)
	keys.push("rawTail")
	children.push(rawTailId)
	doc.root = doc.add(JsonNode.objectNode(keys, children: children))

	return ToolOutcome.success(doc, root: doc.root)
end 'buildOutcome'
