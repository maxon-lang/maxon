{
  "search.exclude": {
    "**/.claude/worktrees/**": true
  },
  "files.watcherExclude": {
    "**/.claude/worktrees/**": true,
    "**/.maxon/**": true,
    "**/.scale-tmp/**": true,
    "**/.spec-tmp/**": true,
    "**/.vscode-test/**": true,
    "**/vendor/**": true,
    "bench/*/out/**": true,
    "scripts/multicore-stress/.*/**": true,
    "temp/**": true
  },
  "files.exclude": {
    "**/.claude/worktrees": true,
    "vscode-extension/.vscode-test": true,
    "vscode-extension/out": true
  },
  "terminal.integrated.env.windows": {
    "PATH": "${workspaceFolder}\\maxon-bin\\.maxon;${env:PATH}"
  },
  "terminal.integrated.env.linux": {
    "PATH": "${workspaceFolder}/maxon-bin/.maxon:${env:PATH}"
  },
  "terminal.integrated.env.osx": {
    "PATH": "${workspaceFolder}/maxon-bin/.maxon:${env:PATH}"
  }
}