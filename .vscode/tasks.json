{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Extension",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "bundle"
      ],
      "options": {
        "cwd": "${workspaceFolder}/vscode-extension"
      },
      "problemMatcher": "$tsc",
      "presentation": {
        "reveal": "silent"
      },
      "group": "build"
    },
    {
      "type": "npm",
      "script": "watch",
      "path": "vscode-extension",
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "npm",
      "script": "compile",
      "path": "vscode-extension",
      "problemMatcher": "$tsc",
      "isBackground": false,
      "presentation": {
        "reveal": "never"
      },
      "group": "build"
    },
    {
      "type": "npm",
      "script": "test",
      "path": "vscode-extension",
      "problemMatcher": [],
      "isBackground": false,
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Build hello-world.maxon",
      "type": "shell",
      "command": "maxon.exe",
      "args": [
        "build",
        "examples/hello-world.maxon",
        "-g"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Preview Website",
      "detail": "Serve website/ with Astro's dev server, rebuilding as its sources change",
      "type": "npm",
      "script": "dev",
      "path": "website",
      "isBackground": true,
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "astro",
        "fileLocation": [
          "relative",
          "${workspaceFolder}/website"
        ],
        "pattern": {
          "regexp": "^\\s*(.*):(\\d+):(\\d+)\\s+-\\s+(warning|error)\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "astro\\s+dev|astro\\s+v",
          "endsPattern": "Dev server running|watching for file changes|Local\\s+http"
        }
      }
    },
    {
      "label": "Build Website",
      "detail": "Build website/ once, which also runs the internal link validator",
      "type": "npm",
      "script": "build",
      "path": "website",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Build Compiler",
      "type": "shell",
      "command": "./maxon-bin/.maxon/maxon build maxon-bin",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Spec Tests",
      "type": "shell",
      "command": "./maxon-bin/.maxon/maxon.exe",
      "args": [
        "spec-test"
      ],
      "group": "test",
      "problemMatcher": []
    }
  ]
}
