// ScaleHistory — `docs/optimization-log.md`. The trend IS the deliverable.
//
// This instrument renders no verdict, so it needs a reference point, and the reference point is the
// log: THE LAST ROW OF EACH TABLE IS THE PREVIOUS DATAPOINT. Every run reads it and reports the
// delta from it, so you still see exactly what moved — without anything passing or failing. There is
// no separate baseline file, and there is nothing to "accept".
//
// WHY A RUN DOES NOT RECORD ITSELF, and `--note=<text>` does.
//
// scale-test is run dozens of times a day against dirty trees, half-finished experiments and
// abandoned branches. A log that recorded every one of them would be mostly noise — which is to say,
// a log nobody reads and nobody can trust. `--note` is the moment a human says "this run is a
// datapoint worth keeping, and here is what changed".
//
// AND WHEN IT IS GIVEN, THE ROW IS WRITTEN — even if not one allocation moved. The operator asked
// for the datapoint; declining it because the instrument could not see what was interesting about it
// is the tool overruling the only party who knows why the run was made. The report still says
// plainly that the memory did not move.
//
// AND THE NOTE IS THE POINT, not a formality. The instrument can see precisely WHAT moved and can
// never see WHY. Six months from now "allocations fell 8% at rung 5" is worth almost nothing without
// the sentence naming the change that did it — and that sentence exists only in the head of whoever
// ran the command, at the moment they ran it. So it is demanded there, rather than left as a
// placeholder that would be committed unfilled.
//
// TWO TABLES, each read DOWNWARDS: one row per recorded change, one column per RUNG.
//
//   allocations  Exact and bit-for-bit reproducible.
//   bytes        Likewise.
//
// AND NOTHING ELSE — no time, and no fitted exponents. There WAS a third table of per-curve growth
// exponents, `time / allocations`, and it is gone. Time is machine-dependent, so a dated column of it
// compares a loaded box in July against an idle one in August and concludes nothing. And an exponent
// added nothing to a ladder that DOUBLES: rung over rung, x2.00 is linear and x4.00 is quadratic, and
// that is a division a reader can do on the numbers already in these tables. The row that exists
// carries the raw counts, which is the thing that cannot go out of date.
//
// (The exponents table's rows are still in the document, under a heading that says they are CLOSED.
// Deleting recorded history to tidy up a format change would be the worst of both: the numbers were
// honestly measured, and they are simply no longer extended.)
//
// A new row goes immediately BEFORE the marker that closes its table. Anchoring on a marker rather
// than appending to the end of the file is what lets the document keep prose after the tables — the
// commentary explaining WHY a number moved, which is the whole reason this is markdown and not a TSV.

export let OptimizationLogRelativePath = "docs/optimization-log.md"

let AllocationsTableMarker = "<!-- scale-history:allocations -->"
let BytesTableMarker = "<!-- scale-history:bytes -->"

// What both markers above begin with, and the ONE thing a `--note` is checked against — see
// `assertRecordable`. A note is written verbatim into the row inserted above each marker in turn, so
// a note that carried a marker's own text would forge one: the row for the first table would contain
// an anchor the second table's insert then found. Screening the shared PREFIX refuses that whole
// family — including any marker a later table adds — rather than two literals a third could silently
// escape. (`insertRowBefore` is the backstop, and it reads the document rather than the note.)
let TableMarkerPrefix = "<!-- scale-history:"

// The two fixed leading columns every table carries. The rest are rungs, which is what
// `LeadingColumns` is subtracted to find.
let DateColumnHeading = "date"
let NoteColumnHeading = "change"
let LeadingColumns = 2

// The counts as the tables print them. Signed because a delta is, and because `groupDigits` walks a
// rendered number that may carry a minus sign.
export typealias Delta = int(i64.min to i64.max)

typealias CivilPart = int(0 to u64.max)
typealias DayCount = int(0 to u64.max)
typealias GroupIndex = int(0 to u64.max)

// A column of one of the log's markdown tables: 0 is `date`, 1 is `change`, and the rest are rungs.
typealias ColumnIndex = int(0 to u64.max)

let SecondsPerDay = 86400 as UnixSeconds
let DigitGroupSize = 3 as GroupIndex

// EVERYTHING THE LOG HAS TO SAY ABOUT THE RUN BEFORE THIS ONE — which, now that the exponents table
// is closed, is exactly its memory.
//
// This was a `ScaleTrend` struct wrapping this union plus two maps of per-curve exponents. With the
// exponents gone it would have been a struct with one field, which is a wrapper that makes every
// caller write `.memory` to say nothing.
//
// A union rather than an empty-array sentinel, because here the distinction is real: "the log has no
// rows yet" is a first datapoint, and "the log's last row was all zeroes" would be a broken compiler.
// An empty array would say both.
export union LoggedMemory
	absent
	present(date String, note String, allocs AllocCountArray, bytes ByteCountArray)

	// How many rungs the memory tables are keyed by. A run with a different ladder length cannot be
	// appended to them without going ragged — see `assertRecordable`.
	export function loggedRungCount() returns RungCount throws ScaleError
		match self 'm'
			absent then throw ScaleError.reason("the log has no rows, so it pins no ladder length")
			present(_, _, allocs, _) then return allocs.count() as RungCount
		end 'm'
	end 'loggedRungCount'
end 'LoggedMemory'

// ===========================================================================================
// Reading the log
// ===========================================================================================

// One table of the log, as parsed. `last` is the row this run is differenced against.
type LogTable
	export let header as StringArray
	export let last as LogTableRow

	static function create(header StringArray, last LogTableRow) returns LogTable
		return Self{header: header, last: last}
	end 'create'
end 'LogTable'

union LogTableRow
	none
	cells(values StringArray)
end 'LogTableRow'

// Read the trend: the last row of the two memory tables, which are written together and must
// therefore describe the same run.
//
// NOTHING IS READ BACK BUT NUMBERS. The exponents table is closed, so there is no longer a cell to
// parse into a fitted value, no `n/a` token to round-trip, and no table header whose columns have to
// be checked against the phases this compiler happens to have. Every one of those was a way for a
// document to be written in a shape it could not be read in — the class of bug that produced a
// write-only log — and they are gone because the thing they carried is gone.
export function loadScaleTrend() returns LoggedMemory throws ScaleError
	let path = try FilePath.from(OptimizationLogRelativePath) otherwise throw ScaleError.reason("'{OptimizationLogRelativePath}' is not a valid path")

	// The log is hand-written prose with machine-appended table rows. The instrument extends it and
	// never creates it: if it is missing, the likely cause is a run from the wrong directory, and
	// minting a fresh file would bury the real history rather than continue it.
	let text = try File.readText(path) otherwise throw ScaleError.reason("could not read {OptimizationLogRelativePath} — it is the trend this run is measured against, not a file the instrument creates. Run scale-test from the repo root.")

	let allocations = try readTable(text, marker: AllocationsTableMarker)
	let bytes = try readTable(text, marker: BytesTableMarker)

	return try readMemoryRow(allocations, bytesTable: bytes)
end 'loadScaleTrend'

// The table that ends at `marker`: the contiguous run of `|`-leading lines immediately above it.
//
// Bottom-up from the marker, because that is the ONE anchor the document guarantees. Searching
// top-down from a heading would tie the parser to prose the author is free to rewrite; the marker is
// there precisely so they can.
function readTable(text String, marker String) returns LogTable throws ScaleError
	let lines = text.split("\n")

	var markerLine = lines.count()
	for i in 0 upto lines.count() 'findMarker'
		let line = try lines.get(i) otherwise panic("readTable: i < count but lines.get({i}) failed")
		if line.trim() == marker 'found'
			markerLine = i
			break
		end 'found'
	end 'findMarker'

	if markerLine >= lines.count() 'noMarker'
		throw ScaleError.reason("{OptimizationLogRelativePath} is missing the table marker `{marker}`. A row is inserted immediately before it; without it there is no table to extend.")
	end 'noMarker'

	// Walk up over the table's rows to its header. The block is header, separator, then zero or more
	// data rows — so the topmost `|` line is the header and the bottommost is the row we want.
	var top = markerLine
	while top > 0 'toTop'
		let line = try lines.get(top - 1) otherwise panic("readTable: top > 0 but lines.get({top - 1}) failed")
		if not line.startsWith("|") 'aboveTheTable'
			break
		end 'aboveTheTable'
		top = top - 1
	end 'toTop'

	let rowCount = markerLine - top
	if rowCount < TableHeaderLines 'noHeader'
		throw ScaleError.reason("the table above `{marker}` in {OptimizationLogRelativePath} has no header row and separator — it must be `| {DateColumnHeading} | {NoteColumnHeading} | ... |` followed by `| --- | ... |`")
	end 'noHeader'

	let header = splitRow(try lines.get(top) otherwise panic("readTable: header line is inside the block"))
	try assertSeparatorRow(splitRow(try lines.get(top + 1) otherwise panic("readTable: the separator line is inside the block")), header: header, marker: marker)

	if rowCount == TableHeaderLines 'headerOnly'
		return LogTable.create(header, last: LogTableRow.none)
	end 'headerOnly'

	let lastCells = splitRow(try lines.get(markerLine - 1) otherwise panic("readTable: the last row is inside the block"))
	if lastCells.count() != header.count() 'ragged'
		throw ScaleError.reason("the last row of the table above `{marker}` has {lastCells.count()} cell(s) but its header has {header.count()} — the table is ragged, and a column read out of it would be the wrong column")
	end 'ragged'

	return LogTable.create(header, last: LogTableRow.cells(lastCells))
end 'readTable'

// A markdown table always opens with a heading row and a `| --- |` separator; data rows come after.
let TableHeaderLines = 2

// The second line of the block IS the separator — CHECKED, never assumed.
//
// `readTable` finds the header by walking UP from the marker to the topmost `|` line, so a separator
// that has been damaged (deleted, blanked, or pushed apart by a stray blank line) does not fail: it
// yields a table one line shorter, in which the first DATA row is read as the header and every row
// below it is discarded. The log then cheerfully reports "no rows yet — this run is the first
// datapoint" over a document full of history, `assertRecordable` stops pinning the ladder's width
// because it believes there is nothing to be ragged against, and a `--note` appends a row to a table
// nobody read correctly. Every one of those is silent, which is why this is a throw and not a repair.
function assertSeparatorRow(cells StringArray, header StringArray, marker String) throws ScaleError
	if cells.count() != header.count() 'wrongWidth'
		throw ScaleError.reason("the separator under the header of the table above `{marker}` in {OptimizationLogRelativePath} has {cells.count()} cell(s) and the header has {header.count()}")
	end 'wrongWidth'

	for cell in cells 'eachCell'
		if not isSeparatorCell(cell) 'notASeparator'
			throw ScaleError.reason("the second line of the table above `{marker}` in {OptimizationLogRelativePath} is not a `| --- | ---: |` separator — its cell '{cell}' is not one. A markdown header is followed by exactly one separator, and without it the first DATA row is read as the header and every row below it is silently lost.")
		end 'notASeparator'
	end 'eachCell'
end 'assertSeparatorRow'

// `---`, `:---`, `---:`, `:---:` — a markdown alignment cell is dashes and colons, and nothing else.
function isSeparatorCell(cell String) returns bool
	if cell.isEmpty() 'empty'
		return false
	end 'empty'

	for ch in cell.toByteArray() 'eachByte'
		if ch != AsciiDash and ch != AsciiColon 'notAlignment'
			return false
		end 'notAlignment'
	end 'eachByte'

	return true
end 'isSeparatorCell'

let AsciiDash = 0x2D
let AsciiColon = 0x3A

// `| a | b | c |` -> ["a", "b", "c"]. The leading and trailing pipes each produce an empty field,
// which is what the two drops are for.
function splitRow(line String) returns StringArray
	let raw = line.split("|")
	var cells = StringArray.create()
	for i in 1 upto raw.count() - 1 'eachCell'
		cells.push((try raw.get(i) otherwise panic("splitRow: i < count-1 but get({i}) failed")).trim())
	end 'eachCell'
	return cells
end 'splitRow'

// The last allocations row and the last bytes row, which are written together and must therefore
// describe the same run. If they do not, someone hand-edited one of them, and differencing this run
// against two different pasts would be worse than not differencing it at all.
function readMemoryRow(allocations LogTable, bytesTable LogTable) returns LoggedMemory throws ScaleError
	match allocations.last 'a'
		none then return LoggedMemory.absent
		cells(allocCells) then return try memoryRowFrom(allocCells, byteCells: try lastBytesRow(bytesTable))
	end 'a'
end 'readMemoryRow'

function lastBytesRow(bytesTable LogTable) returns StringArray throws ScaleError
	match bytesTable.last 'b'
		none then throw ScaleError.reason("the allocations table has rows but the bytes table has none — they are written together, so one of them has been hand-edited")
		cells(values) then return values
	end 'b'
end 'lastBytesRow'

function memoryRowFrom(allocCells StringArray, byteCells StringArray) returns LoggedMemory throws ScaleError
	let date = try cellAt(allocCells, index: 0)
	let note = try cellAt(allocCells, index: 1)
	let byteDate = try cellAt(byteCells, index: 0)
	let byteNote = try cellAt(byteCells, index: 1)
	if date != byteDate or note != byteNote 'differentRuns'
		throw ScaleError.reason("the last allocations row ({date}) and the last bytes row ({byteDate}) describe different runs — they are written together, so one of them has been hand-edited")
	end 'differentRuns'

	let allocs = try rungCounts(allocCells)
	let bytes = try rungCounts(byteCells)
	if allocs.count() != bytes.count() 'differentLadders'
		throw ScaleError.reason("the last allocations row has {allocs.count()} rung(s) and the last bytes row has {bytes.count()} — they measure the same ladder, so one of them has been hand-edited")
	end 'differentLadders'

	return LoggedMemory.present(date, note: note, allocs: allocs, bytes: bytes)
end 'memoryRowFrom'

// The rung columns of a memory row. `AllocCountArray` for both tables: an allocation count and a
// byte volume are the same unsigned counter, and a second array type differing only in its name
// would buy nothing but a cast at every use.
function rungCounts(cells StringArray) returns AllocCountArray throws ScaleError
	var counts = AllocCountArray.create()
	for i in LeadingColumns upto cells.count() 'eachRung'
		counts.push(try parseGroupedCount(try cellAt(cells, index: i)))
	end 'eachRung'
	return counts
end 'rungCounts'

// One cell of an already-parsed row, as a THROW rather than a panic: every caller is reading a file a
// human may have edited, so a cell that is not there is bad input, not a bug in this file.
function cellAt(cells StringArray, index ColumnIndex) returns String throws ScaleError
	return try cells.get(index) otherwise throw ScaleError.reason("a row in {OptimizationLogRelativePath} has {cells.count()} cell(s); column {index} was expected")
end 'cellAt'

// `19,261,978` -> 19261978. The tables carry digit groups because a column of seven-figure numbers is
// unreadable without them, and the reader has to undo exactly what the writer did.
function parseGroupedCount(cell String) returns ParsedCount throws ScaleError
	return try parseCount(cell.replace(",", with: ""))
end 'parseGroupedCount'

// ===========================================================================================
// Writing the log
// ===========================================================================================

// Did this run's numbers move against the last logged row?
//
// This is a READING, and nothing branches on it: a `--note` records the run whether it moved or not,
// because a note is an instruction from the operator (see `recordRun`). It decides one sentence of
// prose — whether the run is told that its allocations and bytes are unchanged.
//
// Everything this instrument measures is bit-for-bit reproducible, so the same compiler on the same
// corpus produces the same digits and a difference here is a REAL difference in what the compiler
// does, every time. There is nothing else to ask about: the machine-dependent half of the old suite,
// which would have "moved" on every run without the compiler changing at all, is not measured any
// more.
export function anyMemoryMoved(trend LoggedMemory, results RungResultArray) returns bool
	return match trend 'm'
		absent gives true
		present(_, _, allocs, bytes) gives memoryDiffers(results, loggedAllocs: allocs, loggedBytes: bytes)
	end 'm'
end 'anyMemoryMoved'

function memoryDiffers(results RungResultArray, loggedAllocs AllocCountArray, loggedBytes ByteCountArray) returns bool
	if results.count() != loggedAllocs.count() 'differentLadder'
		return true
	end 'differentLadder'

	for i in 0 upto results.count() 'eachRung'
		let result = try results.get(i) otherwise panic("memoryDiffers: i < count but results.get({i}) failed")
		let allocs = try loggedAllocs.get(i) otherwise panic("memoryDiffers: the ladders are the same length")
		let bytes = try loggedBytes.get(i) otherwise panic("memoryDiffers: the ladders are the same length")
		if result.total.allocs != allocs or result.total.bytes != bytes 'moved'
			return true
		end 'moved'
	end 'eachRung'

	return false
end 'memoryDiffers'

// Refuse a `--note` this run could not honestly record — BEFORE the ladder is climbed, not after.
// Rejecting the command line once the run has already spent thirty seconds compiling six rungs would
// be a rude way to report a typo.
export function assertRecordable(trend LoggedMemory, note String, rungs RungCount) throws ScaleError
	// A `|` in the note would close the cell it sits in and shift every column after it; a newline
	// would end the row entirely. Both produce a table that still renders — as the wrong numbers.
	if note.contains("|") or note.contains("\n") 'wouldBreakTheTable'
		throw ScaleError.reason("a --note may not contain `|` or a newline: the tables in {OptimizationLogRelativePath} are markdown rows, and either would silently shift the columns rather than fail")
	end 'wouldBreakTheTable'

	// And it may not forge a table marker — the anchor every row is inserted above.
	if note.contains(TableMarkerPrefix) 'wouldForgeAMarker'
		throw ScaleError.reason("a --note may not contain `{TableMarkerPrefix}`: the table markers in {OptimizationLogRelativePath} begin with it, the note is written verbatim into the row inserted above each of them, and a forged marker would decide where the NEXT row landed")
	end 'wouldForgeAMarker'

	match trend 'm'
		absent then return
		present then break 'm'
	end 'm'

	let logged = try trend.loggedRungCount()
	if rungs != logged 'differentLadder'
		throw ScaleError.reason("the log's tables have {logged} rung column(s) and this run climbed {rungs}. A row of a different width would make the tables RAGGED, and a rung's column — which is the whole point of reading them downwards — would stop meaning one rung. Re-run with --rungs={logged}.")
	end 'differentLadder'
end 'assertRecordable'

// Append this run to both tables.
//
// The file is re-read here rather than carried down from `loadScaleTrend`. It is a document a human
// edits, and the edit that matters most — a paragraph of prose explaining the row about to be
// written — is one they may well make WHILE the six rungs are compiling. Writing back a copy read
// thirty seconds ago would silently discard it.
export function recordScaleRun(results RungResultArray, note String) throws ScaleError
	let path = try FilePath.from(OptimizationLogRelativePath) otherwise panic("recordScaleRun: '{OptimizationLogRelativePath}' parsed as a path when the trend was loaded")
	let existing = try File.readText(path) otherwise throw ScaleError.reason("could not re-read {OptimizationLogRelativePath}")

	let today = todayUtc()
	var updated = try insertRowBefore(existing, marker: AllocationsTableMarker, row: renderMemoryRow(results, note: note, date: today, ofBytes: false))
	updated = try insertRowBefore(updated, marker: BytesTableMarker, row: renderMemoryRow(results, note: note, date: today, ofBytes: true))

	try File.writeText(path, content: updated) otherwise throw ScaleError.reason("could not write {OptimizationLogRelativePath}")

	print("\nscale-test: recorded '{note}' ({today}) in {OptimizationLogRelativePath}\n")
end 'recordScaleRun'

// Insert one row immediately above one marker — THE way a row reaches any of the three tables.
//
// THE MARKER MUST APPEAR EXACTLY ONCE, and that is now checked rather than assumed. This was three
// calls to `String.replace`, which replaces EVERY occurrence, against a reader (`readTable`) that
// anchors on the FIRST — so the writer and the reader did not even agree on where a table was, and
// two things fell out of that:
//
//   - A marker that had gone MISSING (the file is a document a human edits, and this re-reads it
//     after the ladder has been climbed) made `replace` a silent no-op. The file was rewritten
//     unchanged and the tool then printed `recorded '<note>'`. A lie, and the kind that is only
//     discovered six months later when the row is not there.
//   - A `--note` carrying a marker's text was written into the row inserted for the FIRST table, and
//     the replacement for the SECOND then matched it — injecting a bytes row into the middle of the
//     allocations table. (`assertRecordable` refuses such a note up front; this is the backstop that
//     makes the document itself, rather than a guess about what a note might contain, the thing that
//     decides.)
//
// It throws BEFORE anything is written — the three inserts all run against a string, and the file is
// written once, at the end — so a log that fails here is left exactly as it was.
function insertRowBefore(text String, marker String, row String) returns String throws ScaleError
	let parts = text.split(marker)
	if parts.count() != MarkerSplitParts 'notExactlyOnce'
		throw ScaleError.reason("`{marker}` appears {parts.count() - 1} time(s) in {OptimizationLogRelativePath} and must appear exactly once — a row is inserted immediately above it, and `readTable` reads the table immediately above it")
	end 'notExactlyOnce'

	let before = try parts.get(0) otherwise panic("insertRowBefore: split gave {MarkerSplitParts} parts but get(0) failed")
	let after = try parts.get(1) otherwise panic("insertRowBefore: split gave {MarkerSplitParts} parts but get(1) failed")
	return "{before}{row}{marker}{after}"
end 'insertRowBefore'

// Splitting on a needle that occurs exactly once yields exactly two parts, one of which may be empty.
let MarkerSplitParts = 2

// One memory row: the date, the reason, then this run's number at every rung.
//
// The rows carry ABSOLUTE numbers, not deltas. A delta answers "did this change help", which the
// report already told you at the moment you ran it; the column answers "where are we now, and how did
// we get here", which is the only question worth keeping a log to answer. Reading a rung's column
// downwards IS the progression.
//
// FREES ARE NOT LOGGED, and their absence is deliberate. They track allocations almost exactly, so a
// third table of them would be a near-duplicate paid for in width. They are measured, reported, and
// carried in `--result-json` for anyone who wants them.
function renderMemoryRow(results RungResultArray, note String, date String, ofBytes bool) returns String
	var cells = StringArray.create()
	cells.push(date)
	cells.push(note)

	for result in results 'eachRung'
		cells.push(groupDigits(measureOf(result.total, ofBytes: ofBytes) as Delta))
	end 'eachRung'

	return renderRow(cells)
end 'renderMemoryRow'

function renderRow(cells StringArray) returns String
	var row = "|"
	for cell in cells 'each'
		row.append(" {cell} |")
	end 'each'
	row.append("\n")
	return row
end 'renderRow'

// ===========================================================================================
// Formatting
// ===========================================================================================

// 19261978 -> "19,261,978". Six-figure allocation counts stacked in a column are unreadable without
// separators, and these tables exist to be read at a glance.
export function groupDigits(value Delta) returns String
	if value < 0 'negative'
		return "-{groupDigits(0 - value)}"
	end 'negative'

	let digits = "{value}"
	let count = digits.count()

	var grouped = ""
	var index = 0 as GroupIndex
	for digit in digits 'eachDigit'
		// A separator goes before every digit whose distance from the END is a multiple of three —
		// except the first, which would otherwise produce a leading comma.
		if index > 0 and (count - index) mod DigitGroupSize == 0 'boundary'
			grouped.append(",")
		end 'boundary'

		grouped.append("{digit}")
		index = index + 1
	end 'eachDigit'

	return grouped
end 'groupDigits'

// ===========================================================================================
// The calendar
// ===========================================================================================

// Today, as YYYY-MM-DD in UTC.
//
// UTC, NOT local time, and that is a real decision rather than laziness: the log is committed and
// read by whoever picks the work up next, and a local date silently means something different
// depending on who ran the command. An entry stamped a day "early" because the machine was in
// Sydney is worse than one stamped in a timezone everyone can agree on.
function todayUtc() returns String
	let days = WallClock.nowUnixSeconds() / SecondsPerDay
	let civil = civilFromDays(days)
	return "{civil.year}-{padTwo(civil.month)}-{padTwo(civil.day)}"
end 'todayUtc'

type CivilDate
	export let year as CivilPart
	export let month as CivilPart
	export let day as CivilPart

	static function create(year CivilPart, month CivilPart, day CivilPart) returns CivilDate
		return Self{year: year, month: month, day: day}
	end 'create'
end 'CivilDate'

// Days-since-the-Unix-epoch to a civil (proleptic Gregorian) date.
//
// This is Howard Hinnant's `civil_from_days`, and the reason it looks like nothing is because it is
// doing something genuinely awkward: the Gregorian calendar's leap rule repeats on a 400-year ERA of
// exactly 146097 days, but the year does not START where that cycle is easiest to count from. The
// trick is to shift the epoch to 0000-03-01 (the +719468) so that the leap day lands at the END of
// the year, which makes February's irregularity fall off the end of the arithmetic instead of
// sitting in the middle of it. March is then month 0, and the last two lines put January and
// February back where humans expect them.
//
// It is branch-free integer arithmetic, exact for every date, and it is not worth re-deriving. See
// https://howardhinnant.github.io/date_algorithms.html#civil_from_days
function civilFromDays(days DayCount) returns CivilDate
	let shifted = days + 719468
	let era = shifted / 146097
	let dayOfEra = shifted - era * 146097
	let yearOfEra = (dayOfEra - dayOfEra / 1460 + dayOfEra / 36524 - dayOfEra / 146096) / 365
	let year = yearOfEra + era * 400
	let dayOfYear = dayOfEra - (365 * yearOfEra + yearOfEra / 4 - yearOfEra / 100)

	// Months counted from March, so a leap day cannot land in the middle of the sequence.
	let marchMonth = (5 * dayOfYear + 2) / 153
	let day = dayOfYear - (153 * marchMonth + 2) / 5 + 1

	var month = marchMonth + 3
	var calendarYear = year
	if marchMonth >= 10 'januaryOrFebruary'
		// March-relative months 10 and 11 are January and February — of the NEXT calendar year.
		month = marchMonth - 9
		calendarYear = year + 1
	end 'januaryOrFebruary'

	return CivilDate.create(calendarYear as CivilPart, month: month, day: day)
end 'civilFromDays'

function padTwo(value CivilPart) returns String
	if value < 10 'single'
		return "0{value}"
	end 'single'

	return "{value}"
end 'padTwo'
