// LspPositionSelfTest — the assertion table under `LspPosition`, run by `maxon-shv2 lsp-selftest`.
//
// ⭐ **WHY A SELFTEST AND NOT A SPEC CASE.** A `specs-shv2` case is a Maxon PROGRAM that shv2 compiles
// and runs; it can call `stdlib/` and nothing else. `LspPosition` lives in `Compiler/`, so the corpus
// is structurally unable to reach it — the same reason `fmt-selftest`, `stdlib-target-selftest` and
// `spec-run-selftest` exist in the bootstrap. This is that pattern, on this side of the tree.
//
// ⭐⭐ **EVERY CASE THAT MATTERS IS NON-ASCII, AND THAT IS THE WHOLE DESIGN.** A byte offset, a
// codepoint index and a UTF-16 code-unit index are THE SAME NUMBER for ASCII, so an ASCII-only table
// passes against an implementation that confuses all three — which is precisely the implementation
// everyone writes first. The discriminating rows are:
//
//   • **2-byte** (`é`, U+00E9)   — 2 bytes, 1 codepoint, 1 unit  → separates BYTES from units
//   • **3-byte** (`世`, U+4E16)  — 3 bytes, 1 codepoint, 1 unit  → same, wider
//   • **4-byte** (`😀`, U+1F600) — 4 bytes, 1 codepoint, **2** units → separates CODEPOINTS from units
//
// The last one is the row nothing else catches: an implementation that counts codepoints is correct
// on the first two and wrong only here.
//
// ⚠ **EACH CASE ASSERTS ITS OWN BYTE LENGTH FIRST.** These literals are non-ASCII in a UTF-8 source
// file, and a re-encoded or mangled file would leave the table testing a different string than it
// names while still reading green. The length assertion is what makes the rest of the row mean what
// it says.

typealias FailureCount = int(0 to i64.max)

// U+00E9, U+4E16, U+1F600 — named so a row says which character it is about rather than showing a
// glyph a terminal may not render.
let TwoByteChar = "é"
let ThreeByteChar = "世"
let FourByteChar = "😀"

export function runLspPositionSelfTest() returns bool
	var failures = 0

	failures = failures + checkLiteralEncodings()
	failures = failures + checkAsciiSingleLine()
	failures = failures + checkMultipleLines()
	failures = failures + checkTwoByteCharacter()
	failures = failures + checkThreeByteCharacter()
	failures = failures + checkSupplementaryCharacter()
	failures = failures + checkCrlfLineEndings()
	failures = failures + checkEmptyAndEndOfBuffer()
	failures = failures + checkRoundTrip()

	if failures == 0 'allPassed'
		print("lsp-position-selftest: OK - line index and UTF-16 position conversion over ASCII, 2-, 3- and 4-byte characters, CRLF and buffer edges\n")
		return true
	end 'allPassed'

	printError("lsp-position-selftest: FAILED - {failures} assertion(s)\n")
	return false
end 'runLspPositionSelfTest'

// ⚠ THE TABLE'S OWN PREMISE: these literals must be the byte widths every row below assumes. A source
// file re-saved in another encoding would otherwise leave every case testing a string it does not name.
function checkLiteralEncodings() returns FailureCount
	var failures = 0
	failures = failures + expectCount("literal 'é' is 2 UTF-8 bytes", got: TwoByteChar.byteLength(), want: 2)
	failures = failures + expectCount("literal '世' is 3 UTF-8 bytes", got: ThreeByteChar.byteLength(), want: 3)
	failures = failures + expectCount("literal '😀' is 4 UTF-8 bytes", got: FourByteChar.byteLength(), want: 4)
	failures = failures + expectCount("literal '😀' is 2 UTF-16 code units", got: FourByteChar.utf16().count(), want: 2)

	return failures
end 'checkLiteralEncodings'

// The baseline. Every one of these is ALSO satisfied by an implementation that treats a byte offset as
// a character index, which is why nothing here can stand alone.
function checkAsciiSingleLine() returns FailureCount
	let source = "hello"
	let index = LspLineIndex.build(source)

	var failures = 0
	failures = failures + expectCount("ascii: one line", got: index.lineCount(), want: 1)
	failures = failures + expectPosition("ascii: start", index: index, source: source, offset: 0, line: 0, character: 0)
	failures = failures + expectPosition("ascii: middle", index: index, source: source, offset: 3, line: 0, character: 3)
	failures = failures + expectPosition("ascii: end", index: index, source: source, offset: 5, line: 0, character: 5)

	return failures
end 'checkAsciiSingleLine'

// The first thing the stub gets wrong: a character index is measured from the LINE start, not the
// buffer start.
function checkMultipleLines() returns FailureCount
	let source = "ab\ncd\nef"
	let index = LspLineIndex.build(source)

	var failures = 0
	failures = failures + expectCount("lines: three", got: index.lineCount(), want: 3)
	failures = failures + expectPosition("lines: first line", index: index, source: source, offset: 1, line: 0, character: 1)
	failures = failures + expectPosition("lines: second line start", index: index, source: source, offset: 3, line: 1, character: 0)
	failures = failures + expectPosition("lines: second line middle", index: index, source: source, offset: 4, line: 1, character: 1)
	failures = failures + expectPosition("lines: third line start", index: index, source: source, offset: 6, line: 2, character: 0)
	failures = failures + expectOffset("lines: offset of 1:1", index: index, source: source, line: 1, character: 1, offset: 4)
	failures = failures + expectOffset("lines: offset of 2:0", index: index, source: source, line: 2, character: 0, offset: 6)

	return failures
end 'checkMultipleLines'

// `aéb`: bytes 0,1..2,3 — the `b` is at BYTE 3 and CHARACTER 2.
function checkTwoByteCharacter() returns FailureCount
	let source = "a{TwoByteChar}b"
	let index = LspLineIndex.build(source)

	var failures = 0
	failures = failures + expectCount("2-byte: source is 4 bytes", got: source.byteLength(), want: 4)
	failures = failures + expectPosition("2-byte: before", index: index, source: source, offset: 0, line: 0, character: 0)
	failures = failures + expectPosition("2-byte: at the character", index: index, source: source, offset: 1, line: 0, character: 1)
	failures = failures + expectPosition("2-byte: after it", index: index, source: source, offset: 3, line: 0, character: 2)
	failures = failures + expectOffset("2-byte: offset of character 2", index: index, source: source, line: 0, character: 2, offset: 3)

	return failures
end 'checkTwoByteCharacter'

// `世界` — two 3-byte characters, so character 1 is at byte 3 and the end is character 2 at byte 6.
function checkThreeByteCharacter() returns FailureCount
	let source = "{ThreeByteChar}{ThreeByteChar}"
	let index = LspLineIndex.build(source)

	var failures = 0
	failures = failures + expectCount("3-byte: source is 6 bytes", got: source.byteLength(), want: 6)
	failures = failures + expectPosition("3-byte: second character", index: index, source: source, offset: 3, line: 0, character: 1)
	failures = failures + expectPosition("3-byte: end", index: index, source: source, offset: 6, line: 0, character: 2)
	failures = failures + expectOffset("3-byte: offset of character 1", index: index, source: source, line: 0, character: 1, offset: 3)

	return failures
end 'checkThreeByteCharacter'

// ⭐⭐ THE ROW NOTHING ELSE CATCHES. `a😀b`: the emoji is 4 bytes and **2** UTF-16 code units, so `b`
// is at BYTE 5 and CHARACTER 3 — not character 2, which is what counting codepoints gives.
function checkSupplementaryCharacter() returns FailureCount
	let source = "a{FourByteChar}b"
	let index = LspLineIndex.build(source)

	var failures = 0
	failures = failures + expectCount("supplementary: source is 6 bytes", got: source.byteLength(), want: 6)
	failures = failures + expectPosition("supplementary: before", index: index, source: source, offset: 0, line: 0, character: 0)
	failures = failures + expectPosition("supplementary: at the emoji", index: index, source: source, offset: 1, line: 0, character: 1)
	failures = failures + expectPosition("supplementary: AFTER it is character 3, not 2", index: index, source: source, offset: 5, line: 0, character: 3)
	failures = failures + expectPosition("supplementary: end of buffer", index: index, source: source, offset: 6, line: 0, character: 4)
	failures = failures + expectOffset("supplementary: offset of character 3", index: index, source: source, line: 0, character: 3, offset: 5)

	return failures
end 'checkSupplementaryCharacter'

// CRLF is ONE terminator: the `\r` is the last byte of the line it ends, so the next line starts after
// the `\n` and its character 0 is the byte following it.
function checkCrlfLineEndings() returns FailureCount
	let source = "ab\r\ncd"
	let index = LspLineIndex.build(source)

	var failures = 0
	failures = failures + expectCount("crlf: two lines", got: index.lineCount(), want: 2)
	failures = failures + expectPosition("crlf: second line starts after the LF", index: index, source: source, offset: 4, line: 1, character: 0)
	failures = failures + expectPosition("crlf: the CR belongs to the first line", index: index, source: source, offset: 2, line: 0, character: 2)
	failures = failures + expectOffset("crlf: offset of 1:1", index: index, source: source, line: 1, character: 1, offset: 5)

	return failures
end 'checkCrlfLineEndings'

// An empty buffer still has ONE line an editor can put a cursor in, and a position past the end clamps
// rather than throwing: an editor legitimately asks about the position one past the last character.
function checkEmptyAndEndOfBuffer() returns FailureCount
	let empty = ""
	let emptyIndex = LspLineIndex.build(empty)

	var failures = 0
	failures = failures + expectCount("empty: still one line", got: emptyIndex.lineCount(), want: 1)
	failures = failures + expectPosition("empty: position 0", index: emptyIndex, source: empty, offset: 0, line: 0, character: 0)

	let source = "ab"
	let index = LspLineIndex.build(source)
	failures = failures + expectOffset("clamp: character past the line end", index: index, source: source, line: 0, character: 99, offset: 2)
	failures = failures + expectOffset("clamp: line past the buffer end", index: index, source: source, line: 99, character: 0, offset: 2)

	return failures
end 'checkEmptyAndEndOfBuffer'

// ⭐ THE PROPERTY, not a table row: for every byte offset that begins a character, converting to a
// position and back must return the offset. It covers combinations the hand-written rows do not name,
// and it is what would catch a conversion that is self-consistently wrong in one direction only.
function checkRoundTrip() returns FailureCount
	let source = "a{TwoByteChar}b\n{ThreeByteChar}{FourByteChar}\nx{FourByteChar}{TwoByteChar}"
	let index = LspLineIndex.build(source)

	var failures = 0
	var offset = 0
	let length = source.byteLength()
	while offset < length 'eachCharacter'
		let position = index.positionOf(source, offset: offset)
		let back = index.offsetOf(source, position: position)
		if back != offset 'roundTripBroke'
			printError("lsp-position-selftest FAIL round-trip: byte {offset} -> {position.render()} -> byte {back}\n")
			failures = failures + 1
		end 'roundTripBroke'

		offset = offset + utf8ByteLengthAt(source, pos: offset)
	end 'eachCharacter'

	return failures
end 'checkRoundTrip'

// --- assertion helpers: one failure line each, naming got AND wanted, because a bare "failed" makes
// the reader re-run the thing by hand to learn what it did. ---

function expectCount(label String, got FailureCount, want FailureCount) returns FailureCount
	if got == want 'match'
		return 0
	end 'match'

	printError("lsp-position-selftest FAIL {label}: got {got}, expected {want}\n")
	return 1
end 'expectCount'

function expectPosition(label String, index LspLineIndex, source String, offset LspByteOffset, line LspLineNumber, character LspCharacter) returns FailureCount
	let got = index.positionOf(source, offset: offset)
	let want = LspPosition.create(line, character: character)
	if got.equals(want) 'match'
		return 0
	end 'match'

	printError("lsp-position-selftest FAIL {label}: byte {offset} -> {got.render()}, expected {want.render()}\n")
	return 1
end 'expectPosition'

function expectOffset(label String, index LspLineIndex, source String, line LspLineNumber, character LspCharacter, offset LspByteOffset) returns FailureCount
	let got = index.offsetOf(source, position: LspPosition.create(line, character: character))
	if got == offset 'match'
		return 0
	end 'match'

	printError("lsp-position-selftest FAIL {label}: {line}:{character} -> byte {got}, expected byte {offset}\n")
	return 1
end 'expectOffset'
