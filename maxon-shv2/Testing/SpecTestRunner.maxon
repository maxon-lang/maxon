// Testing/SpecTestRunner.maxon — run every active test in a specs-shv2 directory
// through the shv2 compiler and collect PASS/FAIL results.
//
// Each test is driven end-to-end through the REAL CLI as a SUBPROCESS:
// `<compilerExe> build <fragment> -o <exeBase> --emit-ir`. Spawning (rather than compiling
// in-process) is deliberate — a compiler crash is isolated to the one test that triggered it
// instead of killing the whole runner, and the actual `build` command path (arg parsing,
// output-path derivation) is exercised, not bypassed. A panic inside the compiler exits that
// build non-zero, which surfaces as a FAILED test rather than a dead runner.
//
// Trimmed HARD from v1's SpecTestRunner: no fragment cache, no per-target run-command
// building, no wasm/wasmtime path. Those return when a milestone needs them. What IS
// here: the committed `.test` goldens (`checkTestFragment`), `--update-required` to
// regenerate them, and `--filter` to scope a run to one spec or one test.
//
// The parallel worker pool — the one omission that DID come back — lives next door in
// SpecWorkerPool.maxon. This file no longer walks the spec directory itself: `runOneSpec`
// runs exactly ONE spec, because that is the unit the pool dispatches (one job, one spec,
// one worker). The pool builds the ordered spec list from `specFilePaths` and reassembles
// the workers' answers back into that order.

let SpecFileExtension = ".md"
let MaxonFragmentExtension = ".maxon"
let TempSubdirName = ".spec-tmp"
let DraftStatus = "draft"
let BuildSubcommand = "build"
let OutputFlag = "-o"

// `--emit-ir` makes the subprocess build write a Target-IR sidecar next to the
// exe (`<exeBase>.ir`); the runner reads it back to embed in a codegen fragment.
// The extension must match the driver's `IrFileExtension` (Compiler.maxon).
let EmitIrFlag = "--emit-ir"
let IrFileExtension = ".ir"

// Committed-fragment layout: `<specDir>/fragments/<target>/<specName>/<testName>.test`.
//
// These `.test` files are GATES, not outputs (see `checkTestFragment`): the emitted Target IR is
// compared against the committed golden and a mismatch FAILS the test. `--update-required`
// regenerates them, and that diff is the review.
//
// TOGETHER WITH THE RUN, these two ARE the register allocator's gate — there is no in-compiler
// allocation checker any more, and none is needed. The suite needs both, because they answer
// different questions:
//   * RUNNING the test proves the allocation is CORRECT — a value left in the wrong register
//     computes the wrong answer, and the exit-code assertion catches it.
//   * The GOLDEN proves the code did not get WORSE. An extra spill, a lost coalesce, a live range
//     needlessly widened: every one of those still returns the right answer, so a suite that only
//     runs the program stays green while the codegen quietly rots. The golden also reaches where the
//     run cannot — a test executes ONE path, but the golden pins every block of the function.
//
// Named, not inline, because the layout + the section punctuation below are a format contract
// shared with spec review.
let FragmentsSubdir = "fragments"
let FragmentExtension = ".test"
let FragmentTestPrefix = "// Test: "
let FragmentSectionSep = "---"
let ExitCodeLabel = "ExitCode: "
let CompilerErrorLabel = "CompilerError:"

// Stand-in for the IR section when the sidecar could not be read — only reachable
// if a supposed exitCode test failed to compile (the run then FAILs regardless),
// so it is a visible signal in the fragment, never the normal path.
let MissingIrPlaceholder = "// (no Target IR: compile produced no sidecar)\n"

// The placeholder that replaces a fragment's absolute on-disk path in captured
// compiler output. Machine/run independent, so an expected ```maxoncstderr block
// authored with `<fragment>:L:C` matches regardless of where the temp file lives.
let FragmentPathToken = "<fragment>"

typealias FilePathArray = Array with FilePath

// PASS, or FAIL carrying a human-readable reason. A union (not a `bool` + a
// message field) so a passing result has no vestigial empty-string message.
export union TestOutcome
	pass
	fail(reason String)

	export function isPass() returns bool
		return match self 'p'
			pass gives true
			fail gives false
		end 'p'
	end 'isPass'
end 'TestOutcome'

// One test's verdict, tagged with which spec it came from for the report.
export type SpecTestResult
	export let specName as String
	export let testName as String
	export let outcome as TestOutcome

	export static function create(specName String, testName String, outcome TestOutcome) returns SpecTestResult
		return Self{specName: specName, testName: testName, outcome: outcome}
	end 'create'
end 'SpecTestResult'

export typealias SpecTestResultArray = Array with SpecTestResult

// Captured result of one spawned process: exit code + both streams. The single
// spawn/capture choke point that BOTH the compile step and the run step go
// through, so there is exactly one place that talks to `Subprocess`.
//
// Exported because the scale-test runner spawns compiles too (one per rung) and must go through
// the SAME choke point. A second, private copy of "spawn and capture" is how the two runners would
// drift into disagreeing about what a captured stream is.
export type ProcessCapture
	export let exitCode as ExitCodeValue
	export let stdout as String
	export let stderr as String

	export static function create(exitCode ExitCodeValue, stdout String, stderr String) returns ProcessCapture
		return Self{exitCode: exitCode, stdout: stdout, stderr: stderr}
	end 'create'
end 'ProcessCapture'

export function runProcess(exe FilePath, argv StringArray) returns ProcessCapture throws SubprocessError
	let collected = try Subprocess.run(Executable.path(exe), arguments: argv)
	return ProcessCapture.create(collected.exitCode(), stdout: collected.stdout, stderr: collected.stderr)
end 'runProcess'

// Run the active tests of ONE spec — `<specDir>/<specName>.md` — through `compilerExe`,
// returning one result per test that `filter` selects, in DECLARATION order (a `draft`
// spec yields none). Throws only on a spec-file IO failure; a per-test compile or run
// failure is captured as a FAIL result, never thrown, so one bad test can't abort the run.
//
// One spec is the unit of work the pool dispatches (see SpecWorkerPool): a worker gets a
// spec NAME on stdin and calls exactly this. Nothing above this function walks a directory
// — the pool does that once, in the parent, because the listing ORDER is also the report
// order and only one process may own it.
export function runOneSpec(compilerExe FilePath, specDir FilePath, specName String, filter String, updateRequired bool) returns SpecTestResultArray throws CompileError
	var results = SpecTestResultArray.create()

	let specFile = try parseSpecFile(specDir.join("{specName}{SpecFileExtension}"))
	if isDraftSpec(specFile) 'draftSpec'
		return results
	end 'draftSpec'

	let tempDir = specTempDirFor(specDir, specName: specName)
	if not Directory.create(tempDir) 'noTempDir'
		throw CompileError.directoryNotFound(tempDir)
	end 'noTempDir'

	let host = detectHostTarget()
	let exeExtension = executableExtension(host)
	let fragmentDir = fragmentsRootDir(specDir, target: host).join(specName)
	// mkdir -p; a create failure just means fragments for this spec won't be written
	// (checkTestFragment swallows the ensuing write error) — never a test gate.
	_ = Directory.create(fragmentDir)

	for test in specFile.tests 'eachTest'
		if not selectedByFilter(specName, testName: test.name, filter: filter) 'notSelected'
			continue
		end 'notSelected'

		let outcome = runOneTest(compilerExe, test: test, tempDir: tempDir, exeExtension: exeExtension, fragmentDir: fragmentDir, updateRequired: updateRequired)
		results.push(SpecTestResult.create(specName, testName: test.name, outcome: outcome))
	end 'eachTest'

	return results
end 'runOneSpec'

// A `draft` spec is not run. The rule lives here, not at each call site, because BOTH halves
// of the pool ask it — the parent when it decides what the run will report, the worker when
// it runs a job — and a disagreement would leave the parent waiting for results the worker
// was never going to produce.
export function isDraftSpec(specFile SpecFile) returns bool
	return specFile.status == DraftStatus
end 'isDraftSpec'

// This spec's private scratch directory: `<specDir>/.spec-tmp/<specName>/`.
//
// PER-SPEC, and that is a CORRECTNESS requirement, not tidiness. Test names are unique WITHIN
// a spec but not ACROSS specs, so a single shared scratch directory has two workers writing,
// compiling and deleting the same `<testName>.maxon` at the same time — a race that shows up
// as an unreproducible compile failure in whichever worker lost. One spec is only ever in
// flight on one worker, so keying the directory by spec name makes the collision impossible by
// construction, and needs no worker id on the wire to do it.
export function specTempDirFor(specDir FilePath, specName String) returns FilePath
	return specTempRootDir(specDir).join(specName)
end 'specTempDirFor'

// The root the per-spec scratch directories hang off. The pool creates it once, in the parent,
// so N workers don't race `Directory.create`'s mkdir -p on the shared parent.
//
// Built through a FilePath component (not the String overload): `TempSubdirName` is a fixed
// valid relative path, and a FilePath argument picks `join(FilePath)` unambiguously (a bare
// String constant is ambiguous between join's String/FilePath overloads).
export function specTempRootDir(specDir FilePath) returns FilePath
	let tempSub = try FilePath.from(TempSubdirName) otherwise panic("SpecTestRunner: TempSubdirName '{TempSubdirName}' must be a valid relative path")
	return specDir.join(tempSub)
end 'specTempRootDir'

// Does `--filter=<pattern>` select this test? The pattern is matched as a
// SUBSTRING of the `<spec>/<test>` label the runner reports — the same string a
// reader sees in a PASS/FAIL line — so one rule covers every way you would want to
// narrow a run: a bare spec name takes that whole spec, a bare test name takes that
// test wherever it lives, and `spec/test` takes exactly one. An empty pattern
// (no `--filter` given) selects everything.
//
// Exported because the parent and the worker must select the SAME tests: the parent counts
// them to build its report, the worker runs them. One rule, one function.
export function selectedByFilter(specName String, testName String, filter String) returns bool
	if filter.isEmpty() 'wholeSuite'
		return true
	end 'wholeSuite'

	return "{specName}/{testName}".contains(filter)
end 'selectedByFilter'

// The committed-fragment root for this host target: `<specDir>/fragments/<target>`
// (e.g. `specs-shv2/fragments/x64-windows`). Each spec's `.test` files hang off a
// per-spec subdirectory of this root.
//
// Exported for the same reason as `specTempRootDir`: the pool creates this shared parent once,
// in the parent process, rather than letting N workers race to make it.
export function fragmentsRootDir(specDir FilePath, target Target) returns FilePath
	let rel = "{FragmentsSubdir}/{targetToString(target)}"
	let relPath = try FilePath.from(rel) otherwise panic("SpecTestRunner: fragments path '{rel}' must be a valid relative path")
	return specDir.join(relPath)
end 'fragmentsRootDir'

// The `*.md` spec files directly under `specDir`, in directory-listing order —
// deterministic per host filesystem (String is not Comparable, so there is no
// portable key to sort on; NTFS returns names in a stable order).
//
// THIS ORDER IS THE REPORT ORDER. The pool reassembles every worker's out-of-order answers
// back into it, which is how `--workers=1` and `--workers=N` print the same bytes.
export function specFilePaths(specDir FilePath) returns FilePathArray throws CompileError
	let entries = try Directory.list(specDir) otherwise throw CompileError.directoryNotFound(specDir)
	var specs = FilePathArray.create()
	for entry in entries 'eachEntry'
		if entry.fileExtension() == SpecFileExtension 'isSpec'
			specs.push(entry)
		end 'isSpec'
	end 'eachEntry'
	return specs
end 'specFilePaths'

// Compile one test's fragment via a subprocess build (with `--emit-ir` so the
// Target-IR sidecar is produced), check its expectation, then check the emitted IR
// against the committed `.test` golden. The temp fragment / exe / IR sidecar are
// cleaned up before returning.
function runOneTest(compilerExe FilePath, test SpecTest, tempDir FilePath, exeExtension String, fragmentDir FilePath, updateRequired bool) returns TestOutcome
	let fragmentPath = tempDir.join("{test.name}{MaxonFragmentExtension}")
	let exeBase = tempDir.join(test.name)
	// The driver appends the platform extension to the `-o` value
	// (resolveOutputPath), so the produced exe is `<exeBase><ext>` — reconstruct
	// that exact path to spawn it for the exit-code check.
	let exePath = try FilePath.from("{exeBase.toString()}{exeExtension}") otherwise 'badExePath'
		return TestOutcome.fail("could not form output path for {test.name}")
	end 'badExePath'
	// `--emit-ir` writes `<output>.ir` (Compiler.writeTargetIr uses the same
	// changeExtension), so the sidecar sits beside the exe under `.ir`.
	let irPath = exePath.changeExtension(IrFileExtension)

	if not writeFragment(fragmentPath, source: test.source) 'writeFailed'
		return TestOutcome.fail("could not write fragment {fragmentPath.toString()}")
	end 'writeFailed'

	var compileArgv = StringArray.create()
	compileArgv.push(BuildSubcommand)
	compileArgv.push(fragmentPath.toString())
	compileArgv.push(OutputFlag)
	compileArgv.push(exeBase.toString())
	compileArgv.push(EmitIrFlag)

	let compile = try runProcess(compilerExe, argv: compileArgv) otherwise (e) 'compileSpawnFailed'
		cleanup(fragmentPath, exePath: exePath, irPath: irPath)
		return TestOutcome.fail("compiler spawn failed: {e.displayReason()}")
	end 'compileSpawnFailed'

	let outcome = checkExpectation(test.expectation, compile: compile, fragmentPath: fragmentPath, exePath: exePath)

	// The BEHAVIOUR gate ran above: the program compiled, ran, and returned what it should. The
	// fragment is the CODE-QUALITY gate, and it only makes sense to ask "is this still the code we
	// agreed on?" of a test whose behaviour is already right — a failing test's IR is noise, and
	// reporting a golden mismatch on top of it would bury the real failure. Run it before cleanup,
	// while the `--emit-ir` sidecar is still on disk.
	if not outcome.isPass() 'behaviourAlreadyFailed'
		cleanup(fragmentPath, exePath: exePath, irPath: irPath)
		return outcome
	end 'behaviourAlreadyFailed'

	let fragmentOutcome = checkTestFragment(fragmentDir, test: test, compile: compile, fragmentPath: fragmentPath, irPath: irPath, updateRequired: updateRequired)

	cleanup(fragmentPath, exePath: exePath, irPath: irPath)
	return fragmentOutcome
end 'runOneTest'

// The committed `.test` fragment for one test — its source plus either the generated Target IR
// (exitCode tests) or the normalized compiler error (compilerError tests) — checked AS A GATE
// against what the compiler just produced.
//
// THIS IS THE CODE-QUALITY GATE, and it is the reason the fragments are committed. Running the test
// proves the allocation is CORRECT (a value in the wrong register computes the wrong answer and the
// exit-code assertion fails). It cannot prove the allocation is still GOOD: an extra spill, a lost
// coalesce, a wider live range — all of them still compute the right answer, and a suite that only
// runs the program reports green while the code silently gets worse. Pinning the IR turns every such
// change into a FAILING TEST that has to be looked at and either justified or fixed.
//
// It also reaches where the run cannot. A test executes ONE path; a function's other blocks are never
// entered, so a bad allocation in them is invisible to the exit code. The fragment pins the WHOLE
// function, every block, taken or not.
//
// `--update-required` regenerates instead of comparing. That is the one door through which a change
// enters, and it is deliberately a door you have to open: the diff is the review.
function checkTestFragment(fragmentDir FilePath, test SpecTest, compile ProcessCapture, fragmentPath FilePath, irPath FilePath, updateRequired bool) returns TestOutcome
	let content = match test.expectation 'e'
		exitCode(expected) gives buildExitCodeFragment(test, expected: expected, irPath: irPath)
		compilerError gives buildErrorFragment(test, compile: compile, fragmentPath: fragmentPath)
	end 'e'

	let outPath = fragmentDir.join("{test.name}{FragmentExtension}")

	// No committed fragment yet — a NEW test. Record it; there is nothing to compare against, and a
	// first run that failed for want of a golden it cannot have would be a rite, not a gate.
	let committed = try File.readText(outPath) otherwise 'noGolden'
		try File.writeText(outPath, content: content) otherwise 'writeFailed'
			return TestOutcome.fail("could not write new golden fragment {outPath.toString()}")
		end 'writeFailed'
		return TestOutcome.pass
	end 'noGolden'

	if updateRequired 'regenerate'
		try File.writeText(outPath, content: content) otherwise 'updateFailed'
			return TestOutcome.fail("could not update golden fragment {outPath.toString()}")
		end 'updateFailed'
		return TestOutcome.pass
	end 'regenerate'

	if committed == content 'unchanged'
		return TestOutcome.pass
	end 'unchanged'

	return TestOutcome.fail("codegen changed — golden fragment mismatch\n{firstDifference(committed, actual: content)}\n    If the new output is INTENDED, re-run with --update-required and REVIEW the diff:\n    {outPath.toString()}")
end 'checkTestFragment'

// The first line at which the committed golden and the freshly generated fragment diverge, rendered
// for a test failure. A whole-fragment dump would bury the one line that matters under a hundred that
// did not move.
function firstDifference(committed String, actual String) returns String
	let oldLines = committed.split("\n")
	let newLines = actual.split("\n")
	let shared = oldLines.count() if oldLines.count() < newLines.count() else newLines.count()

	for i in 0 upto shared 'eachLine'
		let o = try oldLines.get(i) otherwise panic("firstDifference: oldLines.get OOB at {i}")
		let n = try newLines.get(i) otherwise panic("firstDifference: newLines.get OOB at {i}")
		if o != n 'diverged'
			return "    line {i + 1}:\n      golden: {o}\n      actual: {n}"
		end 'diverged'
	end 'eachLine'

	return "    golden has {oldLines.count()} lines, actual has {newLines.count()} — one is a prefix of the other"
end 'firstDifference'

// The shared fragment head both expectation kinds carry: the test name, its
// source verbatim, and the section separator that closes the source block.
function fragmentHeader(test SpecTest) returns String
	return "{FragmentTestPrefix}{test.name}\n{test.source}\n{FragmentSectionSep}\n"
end 'fragmentHeader'

// An exitCode test's fragment: the shared head, the expected exit code, and the
// generated Target IR read back from the `--emit-ir` sidecar.
function buildExitCodeFragment(test SpecTest, expected ExitCodeValue, irPath FilePath) returns String
	let irText = try File.readText(irPath) otherwise MissingIrPlaceholder
	return "{fragmentHeader(test)}{ExitCodeLabel}{expected}\n{FragmentSectionSep}\n{irText}"
end 'buildExitCodeFragment'

// A compilerError test's fragment: the shared head plus the compiler's normalized
// stderr (the ACTUAL diagnostic the compiler produced — what the fragment exists
// to track — with the temp fragment's absolute path replaced by `<fragment>`).
function buildErrorFragment(test SpecTest, compile ProcessCapture, fragmentPath FilePath) returns String
	let normalizedError = normalizeFragmentPath(compile.stderr, fragmentPath: fragmentPath).trim()
	return "{fragmentHeader(test)}{CompilerErrorLabel}\n{normalizedError}\n"
end 'buildErrorFragment'

function checkExpectation(expectation SpecExpectation, compile ProcessCapture, fragmentPath FilePath, exePath FilePath) returns TestOutcome
	return match expectation 'e'
		exitCode(expected) gives checkExitCode(expected, compile: compile, exePath: exePath)
		compilerError(text) gives checkCompilerError(text, compile: compile, fragmentPath: fragmentPath)
	end 'e'
end 'checkExpectation'

// A ```maxoncstderr test: the compile MUST fail, and its stderr — with the
// fragment's absolute path replaced by the stable `<fragment>` token — must
// equal the expected text (authored with the same token). The line:col are NOT
// normalized: they are shv2-native (headerless fragment → code at line 1) and
// part of what the test asserts.
function checkCompilerError(expectedText String, compile ProcessCapture, fragmentPath FilePath) returns TestOutcome
	if compile.exitCode == 0 'unexpectedSuccess'
		return TestOutcome.fail("expected a compile error but compilation succeeded")
	end 'unexpectedSuccess'

	let actual = normalizeFragmentPath(compile.stderr, fragmentPath: fragmentPath).trim()
	let expected = expectedText.trim()
	if actual == expected 'matched'
		return TestOutcome.pass
	end 'matched'

	return TestOutcome.fail("compiler-error mismatch\n    expected: {expected}\n    actual:   {actual}")
end 'checkCompilerError'

// An ```exitcode test: the compile MUST succeed, then the produced exe is
// spawned and its process exit code compared to the expected value.
function checkExitCode(expected ExitCodeValue, compile ProcessCapture, exePath FilePath) returns TestOutcome
	if compile.exitCode != 0 'compileFailed'
		return TestOutcome.fail("compilation failed (exit {compile.exitCode}): {compile.stderr.trim()}")
	end 'compileFailed'

	let run = try runProcess(exePath, argv: StringArray.create()) otherwise (e) 'runSpawnFailed'
		return TestOutcome.fail("program spawn failed: {e.displayReason()}")
	end 'runSpawnFailed'

	if run.exitCode == expected 'matched'
		return TestOutcome.pass
	end 'matched'

	return TestOutcome.fail("exit code mismatch: expected {expected}, got {run.exitCode}")
end 'checkExitCode'

// Write the test's ```maxon block to `fragmentPath` VERBATIM, appending a single
// trailing newline if absent (the lexer needs a final newline so it doesn't hit
// EOF mid-statement). The verbatim body keeps code at line 1, so shv2-native
// error positions line up with the expected `<fragment>:L:C`.
function writeFragment(fragmentPath FilePath, source String) returns bool
	let body = source if source.endsWith("\n") else "{source}\n"
	try File.writeText(fragmentPath, content: body) otherwise return false
	return true
end 'writeFragment'

// Replace the fragment's absolute on-disk path with the `<fragment>` token. The
// driver renders the path via `FilePath.from(arg).toString()` where `arg` IS
// `fragmentPath.toString()` (already separator-normalized), and that round-trip
// is idempotent, so the exact string emitted is `fragmentPath.toString()`.
function normalizeFragmentPath(text String, fragmentPath FilePath) returns String
	return text.replace(fragmentPath.toString(), with: FragmentPathToken)
end 'normalizeFragmentPath'

// Best-effort removal of the per-test temp fragment + produced exe + IR sidecar.
// A stale temp file never affects correctness (the next test with this name
// overwrites it), so a delete failure — e.g. the exe/IR were never produced
// because the compile failed — is ignored.
function cleanup(fragmentPath FilePath, exePath FilePath, irPath FilePath)
	try File.delete(fragmentPath) otherwise ignore
	try File.delete(exePath) otherwise ignore
	try File.delete(irPath) otherwise ignore
end 'cleanup'
