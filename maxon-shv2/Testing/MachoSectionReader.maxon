// Testing/MachoSectionReader.maxon — read a named section's bytes back out of a linked Mach-O
// executable, the arm64-macOS sibling of `PeSectionReader.readPeSectionData`.
//
// It exists for the SAME reason the PE reader does (see `PeSectionReader.maxon:1-16`): the `.data`
// gate is the spec suite's ONLY look at what was actually LINKED, so it must read the section back
// out of the image rather than ask the compiler what it thinks it wrote. And it is held to the same
// discipline — it shares NO code with `Targets/Macos/MachOWriter.maxon`. A gate that decoded the
// bytes with the very code that encoded them could only prove the writer agrees with itself; an
// independent reading is the only kind that can disagree.
//
// That independence is also why this reader carries its own little-endian primitives instead of
// reaching into `PeSectionReader`'s: the two are DELIBERATELY separate readers of two different
// formats (the PE reader's `.data` path is frozen — it cannot even be executed on this arm64-macOS
// host, only on Windows — so it is not refactored here), and each re-deriving the four trivial reads
// it needs is exactly the "independent reading" the header above argues for, not accidental
// duplication. The field OFFSETS below mirror the LAYOUT `MachOWriter.writeSegmentCommand` /
// `writeMachoSectionHeader` lay down, but nothing here calls that code.
//
// Mach-O section headers carry a section's file offset and size DIRECTLY (there is no PE
// virtual/raw split), so the reader walks: mach_header_64 → the LC_SEGMENT_64 named `__DATA` →
// its `__data` section header → the `size` bytes at `offset`.

// The `__DATA,__data` pair a top-level `var`'s image lives in on macOS — the Mach-O analog of PE's
// `.data`. Named here rather than inlined at the dispatch site because it is a contract with
// `MachOWriter`'s `__data` section header, not a bare pair of strings.
export let MachoDataSegmentName = "__DATA"
export let MachoDataSectionName = "__data"

// --- Mach-O structural constants (the reader's own; see the header on why they are not shared) ---

// MH_MAGIC_64, at file offset 0 of a 64-bit little-endian Mach-O.
let MhMagic64 = 0xFEEDFACF

// mach_header_64 is 32 bytes; `ncmds` (the load-command count) sits at this offset within it.
let MachHeaderSize = 32
let MhNcmdsOffset = 16

// LC_SEGMENT_64. Every load command opens with `cmd` then `cmdsize`, at these offsets.
let LcSegment64 = 0x19
let LcCmdOffset = 0
let LcCmdSizeOffset = 4

// segment_command_64 field offsets, measured from the command's start. Its header is 72 bytes;
// the `section_64` headers follow immediately after.
let SegSegnameOffset = 8
let SegNsectsOffset = 64
let SegmentCommandBaseSize = 72

// section_64 is 80 bytes; its fields sit at these offsets within it. `size` is a u64, `offset`
// (the section's FILE offset) is a u32 — carried directly, no virtual/raw split.
let SectionHeaderSize = 80
let SectSectnameOffset = 0
let SectSegnameOffset = 16
let SectSizeOffset = 40
let SectFileOffsetOffset = 48

// Segment and section names are 16-byte, NUL-padded ASCII fields.
let MachoNameBytes = 16

// Why a Mach-O could not be read. A union rather than an empty-array sentinel, for the same reason
// `PeReadError` is one: "this image has no __data section" and "its __data section is empty" are
// different facts, and a spec pinning an empty layout must be able to tell them apart.
export union MachoReadError implements Error
	unreadable(path FilePath)
	notAMachoFile(path FilePath)
	segmentMissing(path FilePath, segmentName String)
	sectionMissing(path FilePath, segmentName String, sectionName String)
	truncated(path FilePath, sectionName String)

	/// Human-readable rendering, following `PeReadError.displayReason`'s convention so every
	/// spec-runner section-read failure reads the same way whichever format it came from.
	export function displayReason() returns String
		return match self 'k'
			unreadable(path) gives "cannot open {path.toString()}"
			notAMachoFile(path) gives "{path.toString()} is not a Mach-O image (bad MH_MAGIC_64)"
			segmentMissing(path, segmentName) gives "{path.toString()} has no {segmentName} segment"
			sectionMissing(path, segmentName, sectionName) gives "{path.toString()} has no {segmentName},{sectionName} section"
			truncated(path, sectionName) gives "{path.toString()}'s {sectionName} section runs past the end of the file"
		end 'k'
	end 'displayReason'
end 'MachoReadError'

// The bytes of the `sectname` section within the `segname` segment of the Mach-O at `path`.
//
// It reads the section header's FILE `offset` + `size` directly (Mach-O carries both, unlike PE's
// virtual/raw split), so there is no alignment guess to make — the `__data` section header names
// exactly the `preludeSize` bytes `MachOWriter` wrote, and the page padding that follows in the
// segment is outside the section and never read. The `runsPastEof` guard catches a malformed
// header claiming more than the file holds.
export function readMachoSectionData(path FilePath, segname String, sectname String) returns ByteArray throws MachoReadError
	let image = try File.readBinary(path) otherwise throw MachoReadError.unreadable(path)

	if machoReadU32(image, at: 0) != MhMagic64 'notMacho'
		throw MachoReadError.notAMachoFile(path)
	end 'notMacho'

	let ncmds = machoReadU32(image, at: MhNcmdsOffset)
	var cmdStart = MachHeaderSize as ByteOffset
	for _ in 0 upto ncmds 'eachCommand'
		let cmd = machoReadU32(image, at: cmdStart + LcCmdOffset)
		let cmdSize = machoReadU32(image, at: cmdStart + LcCmdSizeOffset)

		if cmd == LcSegment64 and machoNameAt(image, at: cmdStart + SegSegnameOffset) == segname 'thisSegment'
			let nsects = machoReadU32(image, at: cmdStart + SegNsectsOffset)
			for s in 0 upto nsects 'eachSection'
				let sectStart = cmdStart + SegmentCommandBaseSize + s * SectionHeaderSize
				if machoNameAt(image, at: sectStart + SectSectnameOffset) != sectname 'notThisSection'
					continue
				end 'notThisSection'

				let size = machoReadU64(image, at: sectStart + SectSizeOffset)
				let fileOffset = machoReadU32(image, at: sectStart + SectFileOffsetOffset)
				if fileOffset + size > image.count() 'runsPastEof'
					throw MachoReadError.truncated(path, sectionName: sectname)
				end 'runsPastEof'

				return machoSlice(image, start: fileOffset, count: size)
			end 'eachSection'

			throw MachoReadError.sectionMissing(path, segmentName: segname, sectionName: sectname)
		end 'thisSegment'

		cmdStart = cmdStart + cmdSize
	end 'eachCommand'

	throw MachoReadError.segmentMissing(path, segmentName: segname)
end 'readMachoSectionData'

// A 16-byte segment/section name field, NUL-padding stripped. The Mach-O twin of PE's 8-byte
// `sectionNameAt`; the widths differ (Mach-O names are 16 bytes), which is the concrete reason
// this is its own function rather than a shared one.
function machoNameAt(image ByteArray, at ByteOffset) returns String
	var name = ByteArray.create()
	for i in 0 upto MachoNameBytes 'each'
		let b = try image.get(at + i) otherwise return ""
		if b == 0 'nulPad'
			break
		end 'nulPad'
		name.push(b)
	end 'each'
	return String.from(name)
end 'machoNameAt'

// --- Little-endian scalar reads over a byte image ---
//
// The reader's own, per the independence note in the header. A read past the end answers 0 rather
// than throwing: every caller has already established the file is a Mach-O, and a truncated header
// is caught by the `runsPastEof` guard with a message that names the file. `readU64` is the one
// width the PE reader never needs (a section's `size` is a u64); the rest mirror its composition.

function machoByteAt(image ByteArray, at ByteOffset) returns MachineWord
	return try image.get(at) otherwise 0
end 'machoByteAt'

function machoReadU16(image ByteArray, at ByteOffset) returns MachineWord
	return machoByteAt(image, at: at) or (machoByteAt(image, at: at + 1) shl 8)
end 'machoReadU16'

function machoReadU32(image ByteArray, at ByteOffset) returns MachineWord
	return machoReadU16(image, at: at) or (machoReadU16(image, at: at + 2) shl 16)
end 'machoReadU32'

function machoReadU64(image ByteArray, at ByteOffset) returns MachineWord
	return machoReadU32(image, at: at) or (machoReadU32(image, at: at + 4) shl 32)
end 'machoReadU64'

function machoSlice(image ByteArray, start ByteOffset, count ByteCount) returns ByteArray
	var out = ByteArray.create()
	for i in 0 upto count 'each'
		out.push(try image.get(start + i) otherwise panic("machoSlice: get OOB at {start + i} — the caller checked start+count <= image.count()"))
	end 'each'
	return out
end 'machoSlice'

// --- Format dispatch: read the linked binary's `.data` regardless of executable format ---

// A read failure from whichever executable format the host produced — the PE reader's error on a
// Windows host, the Mach-O reader's on a macOS host — joined so the one `.data`-gate call site
// (`SpecTestRunner.compareDataSection`) catches a single type. It exists only to unify two
// independent format readers under one `throws`; each arm delegates rendering to the reader that
// raised it.
export union DataSectionReadError implements Error
	pe(inner PeReadError)
	macho(inner MachoReadError)

	export function displayReason() returns String
		return match self 'k'
			pe(inner) gives inner.displayReason()
			macho(inner) gives inner.displayReason()
		end 'k'
	end 'displayReason'
end 'DataSectionReadError'

// Read the top-level-`var` storage section out of the linked test binary, dispatching on the HOST
// os because the runner only ever inspects a binary it built for its own host: Mach-O `__DATA,__data`
// on macOS, PE `.data` everywhere else (the suite runs only on macOS and Windows hosts today). The
// PE branch is the ORIGINAL call, unchanged — the Mach-O branch is purely additive.
export function readLinkedDataSection(exePath FilePath) returns ByteArray throws DataSectionReadError
	if detectHostTarget().os == Os.macos 'macho'
		return try readMachoSectionData(exePath, segname: MachoDataSegmentName, sectname: MachoDataSectionName) otherwise (e) 'machoErr'
			throw DataSectionReadError.macho(e)
		end 'machoErr'
	end 'macho'

	return try readPeSectionData(exePath, sectionName: DataSectionName) otherwise (e) 'peErr'
		throw DataSectionReadError.pe(e)
	end 'peErr'
end 'readLinkedDataSection'
