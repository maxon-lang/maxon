// Testing/SpecWorkerPool.maxon — run the specs-shv2 suite on a pool of PERSISTENT worker
// subprocesses, driven by `async` / `await` / `Promise` over the green-thread runtime.
//
// ============================================================================================
// WHY THIS EXISTS, AND IT IS NOT THE SECONDS
// ============================================================================================
//
// The serial suite took ~3 s, and that was fine. The pool is here because `async` is a HARD
// MECHANISM shv2 must eventually implement in its own backend — a value captured into a green
// thread ESCAPES, exactly as a closure capturing into a heap env block does — and this harness
// is that mechanism's dogfood and its acceptance test. A "parallel" runner that fanned out N
// children and blocking-`wait()`ed each one in turn would need no green threads at all, and
// would therefore prove nothing about the thing being built. `Subprocess` offers exactly that
// API. This file does not use it.
//
// ============================================================================================
// THE CONTRACT: `--workers=1` AND `--workers=N` PRINT BYTE-IDENTICAL STDOUT
// ============================================================================================
//
// That is the sharpest test of async correctness there is — a dropped capture, a double-freed
// Promise or a raced result buffer surfaces as a FLAKE, and a flake is a bug — and it dictates
// the design rather than merely being checked afterwards:
//
//   * The parent NEVER prints a result as it arrives. Workers complete out of order.
//   * Before it dispatches anything, the parent already knows the exact ordered list of tests
//     each spec will report: it parses the specs itself to weight the job queue, so the
//     selection is in hand anyway. A worker's drained lines are therefore not merely collected,
//     they are CHECKED against that list, name for name, in order. A record that goes missing,
//     arrives twice, arrives out of order, or names a test the parent never selected — the exact
//     symptom of a flag the parent forgot to forward — is a PANIC, not a quiet miscount.
//   * Results are reassembled into serial order (spec-directory-listing order, then declaration
//     order within a spec) and printed by Main's ONE reporter, `reportResults`.
//
// `--workers=1` is this same pool with one worker in it, not a separate serial branch that could
// drift away from the parallel one.
//
// ============================================================================================
// THE PROTOCOL
// ============================================================================================
//
//   parent -> worker (stdin, one line each):
//       JOB:singles:<spec>                            run every selected test of <spec>
//       EXIT                                          shut down cleanly
//
//   worker -> parent (stdout, one line each):
//       WORKER_READY                                  at startup, and again after every job
//       WORKER_SINGLE_RESULT:<spec>:<test>            that test PASSED
//       WORKER_SINGLE_FAIL:<spec>:<test>:<payload>    that test FAILED; <payload> is its reason,
//                                                     escaped onto this one line
//       WORKER_SINGLE_DRIFT:<spec>:<test>:<payload>   that test PASSED and its committed golden no
//                                                     longer matches; <payload> is the difference,
//                                                     escaped the same way. NOT A FAILURE — see
//                                                     SpecTestRunner's `GoldenDrift`
//       WORKER_SINGLE_SKIP:<spec>:<test>:<payload>    that test did NOT RUN here: the compiler refused
//                                                     a construct this target has no implementation
//                                                     for. <payload> is its E3104 text, escaped the
//                                                     same way. NOT A PASS AND NOT A FAILURE — see
//                                                     SpecTestRunner's `targetRefusalIn`
//       WORKER_JOB_CPU:<ticks>:<reported>:<unreported>
//                                                     exactly once per job, immediately BEFORE that
//                                                     job's WORKER_READY: what compiling this spec's
//                                                     tests cost (see SpecTestRunner's
//                                                     cumulative-CPU indicator)
//
// ⚠ DRIFT RIDES THE RESULT RECORD RATHER THAN ADDING A LINE, and the count check below is why: the
// parent matches a job's records against its plan ONE PER TEST, and an extra line per drifted golden
// would have to weaken that into "one or two". Four kinds over two independent facts costs nothing
// because the combinations that would need more cannot occur — a FAILING test never reaches the golden
// step at all (`recordFragmentAndCleanup`), and neither does a SKIPPED one — so every record still
// names exactly one test, exactly once.
//
// ⚠ A SKIP IS A RECORD, NOT AN ABSENCE, and that is the whole safety of the mechanism: a case the
// target cannot express is still SELECTED by the parent, still planned, still reported, and still
// counted. Dropping it from the plan instead would be a case that vanished, which is the failure this
// project spends whole rungs deleting.
//
// ⚠ THE CPU RECORD IS ITS OWN LINE KIND, not a field bolted onto a result record, and it is the LAST
// line of a job. The parent's drain checks a job's result records against its plan NAME FOR NAME and
// panics on a record it never selected — that check is what catches a flag the parent forgot to
// forward — so a per-job number carried inside a result line would have had to weaken it. Taken off
// the end as a distinct kind, the check is untouched: the CPU line is removed first and the records
// are still counted and named exactly as before.
//
// INVARIANT, and the drain leans on it: a worker NEVER writes an empty line to stdout. The five
// lines above are the only ones it can write and all five are non-empty — so an empty line back
// from `readStdoutLine()` is unambiguously EOF, i.e. the worker died. Keeping stdout clean takes
// no effort here: the compiles and the compiled test programs a worker spawns all run under
// `Subprocess.run` with COLLECTED output, so their streams are captured, never inherited.
//
// ============================================================================================
// WHAT WAS DELIBERATELY LEFT IN v1
// ============================================================================================
//
// * The STDERR DRAIN IS SYNCHRONOUS, at shutdown. v1 drained it continuously from an `async` GT
//   and leaked one MM allocation per worker (the Promise box + the GT's arg buffer never
//   returned to the slab). See `shutdownAndDrainStderr`.
// * NO PER-JOB TIMEOUT. v1 needed one because its workers compiled IN-PROCESS, so a compiler
//   infinite loop hung the worker with no way out. Here every compile is a grandchild subprocess,
//   and a compiler that hangs hangs the serial runner too — a per-job timeout in the pool would
//   only disguise where the bug is. What the pool DOES have is a wedge watchdog, which is not the
//   same thing: it does not bound a job, it bounds the DISPATCH LOOP's own idleness, and it never
//   reroutes or retries — it panics with every slot's state. See `WedgeWatchdogMs`.
// * NO `WORKER_COMPILING:` BREADCRUMBS. Same root cause: v1's worker WAS the compiler, so a
//   compiler panic killed it and the parent needed a breadcrumb to say which fragment did it.
//   Here a compiler panic is a non-zero exit from a grandchild, which `prepareOneTest` already turns
//   into an ordinary FAIL result naming the test.

// --- The CLI the pool speaks -----------------------------------------------------------------
//
// A worker is THIS executable, re-launched. The flag spellings it is launched with are declared
// in Main.maxon, where the parser that reads them back also lives, so the two halves of the
// command line cannot drift apart into a hang.

// --- The wire protocol -----------------------------------------------------------------------
//
// Named, never inlined: these strings are a contract between two PROCESSES built from this one
// file, and a typo in one half would be a deadlock rather than a compile error.
let WorkerReadyMarker = "WORKER_READY"
let WorkerResultMarker = "WORKER_SINGLE_RESULT:"
let WorkerJobCpuMarker = "WORKER_JOB_CPU:"
let JobSinglesPrefix = "JOB:singles:"
let ExitCommand = "EXIT"
let ProtocolFieldSep = ":"

// ⭐⭐ **ONE RECORD SHAPE, TWO TOKEN FIELDS — BECAUSE A RESULT IS TWO INDEPENDENT FACTS.**
//
// `WORKER_SINGLE_RESULT:<verdict>:<golden>:<spec>:<test>:<payload>`
//
// ⛔ **A MARKER PER COMBINATION DOES NOT SCALE, AND THAT IS MEASURED RATHER THAN PREDICTED.** The wire
// carried four markers for four (verdict, golden) pairs. Adding ONE verdict (`notRunHere`) and the three
// golden answers that were folded into a single `none` (compared / minted / unrecorded) turns those four
// into TEN — the same distinction, drift, spelled once per verdict, in a decode chain where the copies
// could only be kept in agreement by hand. The two facts are orthogonal in `SpecTestRunner`
// (`TestOutcome` and `GoldenDrift` are deliberately separate types); they are orthogonal here too.
//
// ⚠ **THERE IS EXACTLY ONE PAYLOAD SLOT AND AT MOST ONE OWNER FOR IT, BY CONSTRUCTION.** A verdict owns
// it when it carries text (`fail`'s reason, `skipped`'s refusals); the golden owns it when it drifted;
// nothing owns it otherwise. The two can never both want it, because a case that FAILED or was SKIPPED
// never reaches the golden step at all (`recordFragmentAndCleanup`). `recordPayload` asks the verdict
// first and the golden second; `decodeWorkerLine` reads it back in the same order and PANICS on a
// combination that claims two owners or leaves an unclaimed field non-empty — a protocol break between
// two halves of this one file, not a field to be silently read by the wrong half.
let VerdictPassToken = "PASS"
let VerdictFailToken = "FAIL"
let VerdictSkipToken = "SKIP"
let VerdictNotRunToken = "NOTRUN"
let GoldenNotPinnedToken = "NOPIN"
let GoldenComparedToken = "SAME"
let GoldenDriftedToken = "DRIFT"
let GoldenMintedToken = "MINT"
let GoldenUnrecordedToken = "NOREC"

// How long the dispatcher parks when no worker has an answer ready.
//
// This is a POLL, and it is deliberately NOT a busy-spin. `sleep` parks the dispatcher green thread
// on the runtime's timer heap and hands the scheduler to the drain GTs, which are blocked on genuinely
// overlapped IOCP reads of their workers' stdout (`maxon_pipe_overlapped_read`) — so the parent burns
// no CPU while it waits, and every drain progresses while it does. The deadline is honest, too: the
// timer heap is anchored to the monotonic NANOSECOND clock, not the ~15.6 ms `GetTickCount64` tick
// that once made `sleep(N)` return EARLY.
//
// It is reached only when NO slot is idle and NO drain has finished, so its entire cost is up to one
// millisecond of added latency before a finished worker is re-fed — against jobs that take tens to
// hundreds of milliseconds. The alternative, `await`ing one chosen slot, needs no timer at all but
// reintroduces exactly the head-of-line blocking that `findReadyDrain` exists to prevent: a worker
// that finished early would sit idle until the awaited one came back.
let PollYieldMs = 1

// Milliseconds in a second. Named because the watchdog below is stated in SECONDS (the unit an
// operator thinks in) and measured in MILLISECONDS (the unit `Clock` counts in), and one of those
// two spellings has to be derived from the other rather than written down twice.
//
// ⚠ EXPORTED because `SpecSpawnTimeoutMs` needs the same conversion for the same reason, in the other
// direction: it is spent as a `Subprocess` deadline in milliseconds AND written into the batch script
// as a coreutils `timeout` duration in seconds. A second copy of `1000` next door is exactly the
// "one fact written twice" this constant was created to prevent.
export let MillisPerSecond = 1000

// The one fractional digit `formatSeconds` keeps.
let TenthsPerSecond = 10

// The headroom the pool's deadline keeps OVER the worker's per-spawn deadline. See below: this is
// the whole reason `WedgeWatchdogMs` is a sum and not a number.
//
// It has to cover the rest of one job after a spawn of that job has already burned the worker's full
// deadline: the remaining tests of that spec, plus the worker's write of the result records and the
// parent's decode of them. Measured on the 8-core arm64-macOS host, 2026-07-30: the slowest SINGLE
// spec run on its own — `arrays`, 93 tests — takes 1.27 s end to end (host lane) / 1.70 s (wasm), so
// three minutes is a hundredfold over the entire job it needs to outlast.
let WedgeWatchdogGraceMs = 180 * MillisPerSecond

// How long the dispatch loop tolerates making NO progress at all — nothing dispatched, nothing
// collected — before it declares the pool wedged and panics with every slot's state.
//
// ⚠ IT IS DERIVED FROM `SpecSpawnTimeoutMs`, AND THAT IS THE LOAD-BEARING PART, not the measured
// headroom underneath it. The two deadlines are nested — the worker bounds ONE subprocess, the pool
// bounds the LOOP that waits on the worker — so the outer one must be strictly the longer, or it
// pre-empts the inner one and reports the inner one's failure as its own. Written as two independent
// literals they were EQUAL (both 120 s), and the collision was not theoretical: a hung compile or run
// is bounded by `SpecSpawnTimeoutMs` and surfaces as `TestOutcome.fail("compiler spawn failed: timed
// out after …")` — one named FAIL naming the test — but only if the worker gets to report it. With the
// pool's deadline equal to the worker's, the pool's clock starts EARLIER (at dispatch, whereas the
// worker's starts at whichever test within that job hung) and therefore fires first, killing the whole
// run with "this is a HARNESS bug, RETRY" for what is actually a bounded, named, per-test failure.
// That is a wrong answer pointed at the wrong file, and it lands hardest on the one lane where the
// hang is documented and measured — `runProcess`'s comment records an external runner blocking
// 18m35s at ~1 exec in 700 on the cross lane, which is exactly what `SpecSpawnTimeoutMs` exists to
// convert into a test failure.
//
// ⚠ WHAT THIS IS NOT: a bound on how long a JOB may take. A job is a whole SPEC, so its structural
// ceiling is (tests in the spec) x (spawns per test) x `SpecSpawnTimeoutMs` — hours, not seconds — and
// no threshold short enough to be useful can outlast that. It bounds ONE hung spawn, which is the
// failure that actually happens; a spec whose every test hangs trips it, and should.
//
// The measured margin against a HEALTHY run, on the 8-core arm64-macOS host, 2026-07-30: the whole
// 210-spec suite takes 5.5 s on the host lane and 8.2 s on the wasm lane; the slowest single spec on
// its own is `arrays` at 1.27 s / 1.70 s; and the 210 specs sum to 50.1 s of solo work that the pool
// retires in 5.5 s, so a job under full 12-worker contention runs at well under 2x its solo time.
// Five minutes is ~55x the entire suite and ~150x the slowest job.
//
// The one non-absurd way to trip it without a hang is a machine SUSPENDED mid-run for longer than
// this: Darwin's CLOCK_MONOTONIC is boottime-based and keeps counting across a lid-close. That is not
// a slow run, it is a stopped one. It is NOT reliably self-identifying — the suggestion that "every
// slot reads the same age" holds only while several slots are busy, and the tail of a run has exactly
// one — so the report prints the ACTUAL idle interval in its header, and a header reading far past
// this threshold is the nap's own length rather than a wedge's.
//
// WHY IT EXISTS AT ALL: the dispatch loop's fallthrough is a POLL, not a block, so a pool that stops
// making progress does not deadlock loudly — it parks and re-scans forever, at a couple of percent
// CPU, and an unattended gate is then indistinguishable from a slow one. It has happened: measured at
// 2 wedges in 75 back-to-back suite runs on this host, on both lanes, green on retry with the same
// binary. A LOUD failure is retryable and diagnosable; a silent hang is neither.
//
// ⚠ IT IS NOT A WORKAROUND FOR THE WEDGE IT WAS WRITTEN FOR, and it does not retire when that is
// fixed. The 2026-07-30 wedges were traced OUT of this file — a lost kqueue wakeup in the arm64
// green-thread runtime — and the case for a deadline on a poll loop is independent of them: a loop
// that cannot deadlock can only fail by never finishing, and that failure has no symptom unless
// something is counting.
//
// ⚠ EXPORTED BECAUSE IT IS ALSO THE ANSWER TO "HOW LONG CAN THIS TREE'S BINARY STAY LOCKED?" — it is
// the only bound that exists on an abandoned run's lifetime, so it is the number `E6002` quotes when
// it tells an operator whether to wait or to kill (see `Compiler.discardPreviousOutput`). Quoted, not
// re-spelled: a prose "~5 min" in that message would be a second copy of this sum, free to drift.
export let WedgeWatchdogMs = SpecSpawnTimeoutMs + WedgeWatchdogGraceMs

// How long a worker gets to exit after it has been sent EXIT and had its stdin closed. By the time
// `shutdownPool` runs, every worker has already printed its last WORKER_READY and is parked on a
// read, so the honest expectation is milliseconds — this is not tuned to an observed time, it is
// wide enough that no healthy shutdown can reach it and finite enough that an unhealthy one is
// reported instead of waited on forever.
let WorkerShutdownTimeoutMs = 30 * MillisPerSecond

// A leak-gated Maxon program exits with this when it leaked. A worker IS such a program, so this
// code coming back from one means the HARNESS leaked while servicing that worker's tests — a
// suite failure even if every test it ran passed.
let LeakCheckExitCode = 101

// The bytes `encodeRecordPayload` escapes and `decodeRecordPayload` puts back. Named rather than
// written as character literals so the escape table reads as one table.
let AsciiBackslash = 0x5C
let AsciiLowerN = 0x6E
let AsciiLowerR = 0x72
let AsciiLineFeed = 0x0A
let AsciiCarriageReturn = 0x0D

// A pool SIZE: at least one, because a pool of zero workers runs nothing — which is why
// `--workers=0` is a refused command line rather than a silently empty run. There is no honest
// upper bound (it is the OS process table), so the range is as wide as a process count can be.
export typealias WorkerCount = int(1 to u32.max)

// A worker's slot in the pool. Also the round-robin cursors, which are slot numbers.
typealias WorkerId = int(0 to u32.max)

// A TALLY of workers, which — unlike a pool size — may legitimately be zero ("no worker exited
// non-zero"). A separate alias precisely because `WorkerCount` may not be.
typealias WorkerTally = int(0 to u32.max)

// A tally of JOBS — dispatched, completed, still queued. The dispatch loop's own bookkeeping, and
// what the wedge report leads with.
typealias JobTally = int(0 to u64.max)

// A job's dispatch weight: the total source bytes of the tests it will run. BYTES, not test
// count — a spec's cost tracks how much source the compiler must chew, and 15 one-liners are
// cheaper than 6 register-pressure monsters.
typealias JobWeight = int(0 to u64.max)

// A spec's index into the parent's plan array, which IS the report order. Every job carries it,
// so an answer that comes back out of order still lands in its place.
typealias PlanIndex = int(0 to u64.max)

export let DefaultWorkerCount = 12 as WorkerCount

// The largest pool `--workers=` will accept. Not a technical limit — it is the point past which
// the request is more plausibly a typo than an intent, and every worker is a real OS process.
let MaxWorkerCount = 1024

// The outcome of parsing `--workers=<n>`. A union rather than a throw, because the caller is
// inside the argument loop and must neither diverge nor invent a value: `invalid` is recorded as
// a bad option and the driver then refuses to run at all.
export union WorkerCountArg
	valid(count WorkerCount)
	invalid
end 'WorkerCountArg'

// Parse `--workers=<n>`.
//
// Zero (or a non-number) is REFUSED, never clamped. `--workers=0` asks for a pool that can run
// nothing; quietly running the default instead would answer a question the caller never asked,
// and they would believe they had measured a pool size they had not.
export function parseWorkerCount(raw String) returns WorkerCountArg
	let value = try int.fromString(raw) otherwise 'notANumber'
		return WorkerCountArg.invalid
	end 'notANumber'

	if value < 1 or value > MaxWorkerCount 'outOfRange'
		return WorkerCountArg.invalid
	end 'outOfRange'

	return WorkerCountArg.valid(value as WorkerCount)
end 'parseWorkerCount'

// ============================================================================================
// THE PLAN — what the parent decides BEFORE anything is dispatched
// ============================================================================================

// One spec's worth of the answer, as the parent expects it: the spec's name, the ordered names of
// the tests `--filter` selects, and the weight of running them.
//
// `testNames` is the load-bearing field. It is the parent's ORACLE — the drained records are
// checked against it name for name — and its order is the order the results are printed in, so
// reassembling out-of-order answers needs no sorting and no comparison operator on String.
type SpecPlan
	export let specName as String
	export let testNames as StringArray
	export let weight as JobWeight

	export static function create(specName String, testNames StringArray, weight JobWeight) returns SpecPlan
		return Self{specName: specName, testNames: testNames, weight: weight}
	end 'create'
end 'SpecPlan'

typealias SpecPlanArray = Array with SpecPlan

// One bucket of results per plan, filled OUT OF ORDER by whichever worker finished that spec, and
// concatenated in plan order at the end. This is where worker-count invariance is actually won.
typealias SpecResultBuckets = Array with SpecTestResultArray

// The parent's whole answer about the run: one plan per spec that has work, and the cases the run left
// out on purpose across ALL of them. The second half is a run-level fact and belongs to the run-level
// walk — the workers each see one spec and could never assemble it.
type SuitePlan
	export let plans as SpecPlanArray
	export let networkExcluded as ExcludedCaseArray

	export static function create(plans SpecPlanArray, networkExcluded ExcludedCaseArray) returns SuitePlan
		return Self{plans: plans, networkExcluded: networkExcluded}
	end 'create'
end 'SuitePlan'

// Decide, before a single worker starts, exactly what this run will report — and what it will report
// NOT running. Specs are visited in directory-listing order — which is the report order — and a spec
// that selects no test gets no plan, and therefore no job.
//
// ⚠ **A SPEC WITH NO PLAN CAN STILL OWE THE CENSUS AN ENTRY**, which is why the excluded cases are
// collected BEFORE the `selectsNothing` skip. `--filter=http-client.get` selects nothing at all on a
// default run: every case it matched is live-network. Collecting after the skip would make that run say
// only "no tests selected", which is true and tells the reader nothing about WHY.
//
// The parent parses the specs even though every worker will parse its own again, and the
// redundancy is the point: the parent's list is the oracle the answers are checked against. It is
// also nearly free — parsing nineteen markdown files costs less than one of the compiles it is
// about to dispatch.
function buildPlans(specDir FilePath, filter String, effectiveTarget Target, includeNetwork bool) returns SuitePlan throws CompileError
	var plans = SpecPlanArray.create()
	var networkExcluded = ExcludedCaseArray.create()

	let specPaths = try specFilePaths(specDir)
	for specPath in specPaths 'eachSpec'
		let specFile = try parseSpecFile(specPath, effectiveTargetKey: targetToString(effectiveTarget))
		let specName = specPath.stem()
		let selection = selectedTests(specFile, specName: specName, filter: filter, effectiveTarget: effectiveTarget, includeNetwork: includeNetwork)

		for excludedCase in selection.networkExcluded 'eachExcluded'
			networkExcluded.push(excludedCase)
		end 'eachExcluded'

		let tests = selection.selected
		if tests.count() == 0 'selectsNothing'
			continue
		end 'selectsNothing'

		var testNames = StringArray.create()
		var weight = 0 as JobWeight
		for test in tests 'eachTest'
			testNames.push(test.name)
			weight = weight + test.source.byteLength()
		end 'eachTest'

		plans.push(SpecPlan.create(specName, testNames: testNames, weight: weight))
	end 'eachSpec'

	return SuitePlan.create(plans, networkExcluded: networkExcluded)
end 'buildPlans'

// ============================================================================================
// THE JOB QUEUE
// ============================================================================================

// One dispatchable unit of work: everything the worker needs (the spec NAME — a path would bind
// the wire format to the parent's working directory) plus everything the parent needs to file the
// answer away (`planIndex`) and to order the queue (`weight`).
type SpecJob
	export let planIndex as PlanIndex
	export let specName as String
	export let weight as JobWeight

	export static function create(planIndex PlanIndex, specName String, weight JobWeight) returns SpecJob
		return Self{planIndex: planIndex, specName: specName, weight: weight}
	end 'create'

	// The placeholder that pre-fills the per-slot in-flight array, so that array is the same length
	// as `busy` from the start and the two are indexed by the same slot number. Never sent and never
	// read: `busy[slot]` is the guard, and `inFlight[slot]` is overwritten by a real job in the same
	// breath as `busy[slot]` is set (see `sendAndDrain`, which orders those writes deliberately).
	export static function idle() returns SpecJob
		return Self{planIndex: 0, specName: "", weight: 0}
	end 'idle'

	// Shallow copy. `popHeaviestJob` and the drain path both need a value that has cut its borrow
	// on the array's storage before they mutate that array.
	export function clone() returns SpecJob
		return Self{planIndex: planIndex, specName: specName, weight: weight}
	end 'clone'

	// The wire line the worker reads off its stdin.
	export function toJobLine() returns String
		return "{JobSinglesPrefix}{specName}"
	end 'toJobLine'
end 'SpecJob'

typealias SpecJobArray = Array with SpecJob

// Pop the heaviest job, backfilling its slot from the queue's tail.
//
// SLOWEST-FIRST, so the long-pole specs start first and overlap with everything else instead of
// turning up last and gating wall time on their own. Ties go to the lower index, which keeps the
// dispatch order deterministic for a given corpus.
function popHeaviestJob(queue SpecJobArray) returns SpecJob
	let n = queue.count()
	if n == 0 'emptyQueue'
		panic("popHeaviestJob: the dispatch loop only pops from a queue it has proved non-empty")
	end 'emptyQueue'

	var bestIdx = 0
	var bestWeight = 0 as JobWeight
	for i in 0 upto n 'scan'
		let candidate = try queue.get(i) otherwise panic("popHeaviestJob: queue.get({i}) is in bounds by construction")
		if candidate.weight > bestWeight 'heavier'
			bestIdx = i
			bestWeight = candidate.weight
		end 'heavier'
	end 'scan'

	// `.clone()` cuts the borrow on the queue's storage, without which the `set` below is refused.
	let chosen = (try queue.get(bestIdx) otherwise panic("popHeaviestJob: queue.get({bestIdx}) is in bounds by construction")).clone()
	let lastIdx = n - 1
	if bestIdx != lastIdx 'notAlreadyLast'
		let last = (try queue.get(lastIdx) otherwise panic("popHeaviestJob: queue.get({lastIdx}) is in bounds by construction")).clone()
		try queue.set(bestIdx, value: last) otherwise panic("popHeaviestJob: queue.set({bestIdx}) is in bounds by construction")
	end 'notAlreadyLast'
	_ = try queue.pop() otherwise panic("popHeaviestJob: pop() on a queue proved non-empty above")

	return chosen
end 'popHeaviestJob'

// ============================================================================================
// THE WORKER SIDE
// ============================================================================================

// A worker process. Print READY, then read one JOB line at a time from stdin, run it, print one
// record per test, print READY again. `EXIT` — or stdin EOF, which is what a vanished parent
// looks like — ends the loop.
//
// THE READY/JOB PAIRING IS THE WHOLE PROTOCOL, and this loop is where it is honoured. The parent's
// drain reads this worker's stdout until it sees READY, so every path through the loop that CONSUMED
// A JOB LINE must print exactly one READY afterwards — the paths that could not run the job
// included. Print none and the parent waits forever on a line that is never coming; print two and
// the NEXT job's drain ends early, with that job's records read as the job after it. A blank line,
// which consumed no job, therefore owes no READY. All three READY sites are below.
export function runPersistentWorker(compilerExe FilePath, specDir FilePath, filter String, updateRequired bool, effectiveTarget Target, includeNetwork bool) returns ExitCode
	var stdin = Console.stdin()
	print("{WorkerReadyMarker}\n")

	while true 'jobLoop'
		let line = try stdin.readLine() otherwise 'parentGone'
			// EOF on stdin: the parent exited without sending EXIT. Nothing left to serve.
			break
		end 'parentGone'

		let job = line.trim()
		if job == ExitCommand 'shutDown'
			break
		end 'shutDown'

		// Consumed no job, so it owes no READY — printing one here would end the drain of a job this
		// worker has not been given yet.
		if job.isEmpty() 'blankLine'
			continue
		end 'blankLine'

		if not job.startsWith(JobSinglesPrefix) 'unknownJob'
			// Surface it on stderr — where the parent's shutdown drain will forward it — and still
			// print the READY this loop now owes. Silently dropping the line would deadlock the
			// parent instead of diagnosing it.
			printError("spec worker: unknown job line: '{job}'\n")
			print("{WorkerReadyMarker}\n")
			continue
		end 'unknownJob'

		runSinglesJob(compilerExe, specDir: specDir, specName: sliceAfterPrefix(job, prefix: JobSinglesPrefix), filter: filter, updateRequired: updateRequired, effectiveTarget: effectiveTarget, includeNetwork: includeNetwork)
		print("{WorkerReadyMarker}\n")
	end 'jobLoop'

	return 0
end 'runPersistentWorker'

// Run every selected test of one spec and emit one record per test, in declaration order.
//
// A spec this worker cannot run is a PANIC, not a job that quietly produces nothing. The parent
// parsed this same spec moments ago to build its plan, so a failure here means something underneath
// broke — the file vanished, the scratch directory cannot be made — and there is no useful work
// left to do. Dying is also the only way to get the reason OUT: the parent drains a worker's stderr
// when it dies, so panicking routes this diagnostic through `abortOnDeadWorker`, which prints it.
// Returning quietly instead would leave the parent to notice a missing record and abort with no
// idea why.
function runSinglesJob(compilerExe FilePath, specDir FilePath, specName String, filter String, updateRequired bool, effectiveTarget Target, includeNetwork bool)
	let run = try runOneSpec(compilerExe, specDir: specDir, specName: specName, filter: filter, updateRequired: updateRequired, effectiveTarget: effectiveTarget, includeNetwork: includeNetwork) otherwise (e) 'specFailed'
		reportCompileError(e)
		panic("spec worker: could not run spec '{specName}' — see the error above")
	end 'specFailed'

	for result in run.results 'eachResult'
		print("{recordLine(specName, result: result)}\n")
	end 'eachResult'

	// LAST, after every record — the parent takes it off the end of the drained lines before it
	// checks the records against its plan. See this file's protocol note.
	print("{WorkerJobCpuMarker}{run.cpu.ticks}{ProtocolFieldSep}{run.cpu.reported}{ProtocolFieldSep}{run.cpu.unreported}\n")
end 'runSinglesJob'

// The wire line for ONE result — the one place a result becomes bytes. Its inverse is
// `decodeWorkerLine`, which reads the same five fields back in the same order.
function recordLine(specName String, result SpecTestResult) returns String
	let verdict = verdictToken(result.outcome)
	let golden = goldenToken(result.golden)
	return "{WorkerResultMarker}{verdict}{ProtocolFieldSep}{golden}{ProtocolFieldSep}{specName}{ProtocolFieldSep}{result.testName}{ProtocolFieldSep}{encodeRecordPayload(recordPayload(result))}"
end 'recordLine'

function verdictToken(outcome TestOutcome) returns String
	return match outcome 'verdict'
		pass gives VerdictPassToken
		fail gives VerdictFailToken
		skipped gives VerdictSkipToken
		notRunHere gives VerdictNotRunToken
	end 'verdict'
end 'verdictToken'

function goldenToken(golden GoldenDrift) returns String
	return match golden 'reference'
		notPinned gives GoldenNotPinnedToken
		matched gives GoldenComparedToken
		drifted gives GoldenDriftedToken
		minted gives GoldenMintedToken
		unrecorded gives GoldenUnrecordedToken
	end 'reference'
end 'goldenToken'

// The record's one text field, taken from whichever axis owns it. The verdict is asked FIRST and the
// golden only when the verdict declined it — the ownership rule in the protocol note above, executed
// rather than restated: a verdict that carries text is one that never reached the golden step.
function recordPayload(result SpecTestResult) returns String
	return match result.outcome 'verdict'
		fail(reason) gives reason
		skipped(refusals) gives refusals
		pass gives goldenPayload(result.golden)
		notRunHere gives goldenPayload(result.golden)
	end 'verdict'
end 'recordPayload'

// A golden's text, which only `drifted` has. Every other arm is a bare fact about whether a comparison
// happened, and an empty field is exactly what "nothing to say" is on this wire.
function goldenPayload(golden GoldenDrift) returns String
	return match golden 'reference'
		drifted(detail) gives detail
		notPinned gives ""
		matched gives ""
		minted gives ""
		unrecorded gives ""
	end 'reference'
end 'goldenPayload'

// ============================================================================================
// THE RECORD PAYLOAD — a multi-line message on a line-based wire
// ============================================================================================

// Escape a record's message onto ONE line. Both payload-carrying kinds need it: a failure reason and
// a golden-drift report are each genuinely multi-line (see `checkCompilerError` and
// `checkTestFragment`), and an un-escaped newline in one would not corrupt a single record — it would
// desynchronise the parent's reader for the rest of the job.
//
// Backslash FIRST, so the newline and CR rules that follow cannot double-escape the backslashes
// this rule just inserted.
function encodeRecordPayload(message String) returns String
	var escaped = message.replace("\\", with: "\\\\")
	escaped = escaped.replace("\n", with: "\\n")
	escaped = escaped.replace("\r", with: "\\r")
	return escaped
end 'encodeRecordPayload'

// The inverse. Walks the bytes ONCE rather than running three `replace`s, because a replace-based
// decode re-expands what it just produced: `\\n` (an escaped backslash followed by an `n`) would
// come back as a newline instead of the two characters it started as.
function decodeRecordPayload(payload String) returns String
	let bytes = payload.toByteArray()
	let n = bytes.count()
	var decoded = ByteArray.create()
	var i = 0

	while i < n 'walk'
		let b = try bytes.get(i) otherwise panic("decodeRecordPayload: bytes.get({i}) is in bounds by construction")
		if b != AsciiBackslash or i + 1 >= n 'literalByte'
			decoded.push(b)
			i = i + 1
			continue
		end 'literalByte'

		let escaped = try bytes.get(i + 1) otherwise panic("decodeRecordPayload: bytes.get({i} + 1) is in bounds by the guard above")
		if escaped == AsciiLowerN 'newline'
			decoded.push(AsciiLineFeed as Byte)
			i = i + 2
			continue
		end 'newline'

		if escaped == AsciiLowerR 'carriageReturn'
			decoded.push(AsciiCarriageReturn as Byte)
			i = i + 2
			continue
		end 'carriageReturn'

		if escaped == AsciiBackslash 'backslash'
			decoded.push(AsciiBackslash as Byte)
			i = i + 2
			continue
		end 'backslash'

		// A backslash that begins no escape this encoder emits. It can only have come from the
		// reason text itself, so it IS the text: pass it through untouched.
		decoded.push(b)
		i = i + 1
	end 'walk'

	return String.from(decoded)
end 'decodeRecordPayload'

// The remainder of `line` after a literal ASCII `prefix` the caller has already matched with
// `startsWith`. Byte position equals character position for every marker in this protocol, so
// advancing `prefix.byteLength()` indices lands exactly past it.
//
// It deliberately does NOT trim: what follows a FAIL record's markers is the failure reason
// VERBATIM, and trimming it would quietly rewrite the text a spec author reads.
function sliceAfterPrefix(line String, prefix String) returns String
	var pos = line.startIndex()
	for _ in 0 upto prefix.byteLength() 'skipPrefix'
		pos = try line.indexAfter(pos) otherwise panic("sliceAfterPrefix: '{line}' is shorter than the prefix '{prefix}' it startsWith")
	end 'skipPrefix'
	return line.slice(pos, endIndex: line.endIndex())
end 'sliceAfterPrefix'

// ============================================================================================
// DECODING A WORKER'S RECORDS
// ============================================================================================

// One decoded result record — the two axes and the names they are about. A TYPE rather than a union:
// there are no longer several KINDS of record, only one shape whose two token fields each name an arm
// of a union `SpecTestRunner` already owns. That is what stopped the kinds multiplying (see the
// protocol note above), and it is also why the dispatcher's name check below reads two plain fields
// instead of a match per accessor.
type WorkerRecord
	export let specName as String
	export let testName as String
	export let outcome as TestOutcome
	export let golden as GoldenDrift

	static function create(specName String, testName String, outcome TestOutcome, golden GoldenDrift) returns WorkerRecord
		return Self{specName: specName, testName: testName, outcome: outcome, golden: golden}
	end 'create'
end 'WorkerRecord'

// `WORKER_SINGLE_RESULT:<verdict>:<golden>:<spec>:<test>:<payload>` — four structural cuts, then the
// payload whole. Only the first four separators are structural; the payload keeps every colon it
// contains, which a failure reason and a golden difference are both full of.
//
// Neither name field can contain the separator — a spec name is a FILE STEM and a test name comes from
// a `<!-- test: NAME -->` marker — so the cuts are unambiguous.
function decodeWorkerLine(line String) returns WorkerRecord
	if not line.startsWith(WorkerResultMarker) 'notARecord'
		panic("spec worker pool: a worker emitted a line that is not a {WorkerResultMarker} record: '{line}'")
	end 'notARecord'

	let verdict = splitAtFieldSep(sliceAfterPrefix(line, prefix: WorkerResultMarker), expected: "golden", line: line)
	let golden = splitAtFieldSep(verdict.rest, expected: "spec", line: line)
	let spec = splitAtFieldSep(golden.rest, expected: "test", line: line)
	let test = splitAtFieldSep(spec.rest, expected: "payload", line: line)
	let payload = decodeRecordPayload(test.rest)

	// ⚠ THE VERDICT IS ASKED FIRST, EXACTLY AS `recordPayload` WROTE IT. A verdict that owns the payload
	// leaves the golden with none, and `decodeGolden` is told so — that is the ownership rule read back,
	// and the only place it could be got wrong.
	let outcome = decodeVerdict(verdict.field, payload: payload, line: line)
	let claimed = match outcome 'claim'
		fail gives true
		skipped gives true
		pass gives false
		notRunHere gives false
	end 'claim'

	return WorkerRecord.create(spec.field, testName: test.field, outcome: outcome, golden: decodeGolden(golden.field, payload: payload, verdictClaimedIt: claimed, line: line))
end 'decodeWorkerLine'

function decodeVerdict(token String, payload String, line String) returns TestOutcome
	if token == VerdictPassToken 'isPass'
		return TestOutcome.pass
	end 'isPass'

	if token == VerdictFailToken 'isFail'
		return TestOutcome.fail(payload)
	end 'isFail'

	if token == VerdictSkipToken 'isSkip'
		return TestOutcome.skipped(payload)
	end 'isSkip'

	if token == VerdictNotRunToken 'isNotRun'
		return TestOutcome.notRunHere
	end 'isNotRun'

	panic("spec worker pool: '{token}' is not one of the {VerdictPassToken}/{VerdictFailToken}/{VerdictSkipToken}/{VerdictNotRunToken} verdict tokens: '{line}'")
end 'decodeVerdict'

// `verdictClaimedIt` is how the ONE payload slot stays unambiguous without a second copy of the rule:
// a golden that would take the payload while the verdict already has it is the protocol break the note
// above says cannot happen, so it is a panic rather than a silently duplicated field.
function decodeGolden(token String, payload String, verdictClaimedIt bool, line String) returns GoldenDrift
	if token == GoldenDriftedToken 'isDrift'
		if verdictClaimedIt 'twoOwners'
			panic("spec worker pool: a record claims BOTH a payload-carrying verdict and {GoldenDriftedToken}, so its one payload field has two owners: '{line}'")
		end 'twoOwners'
		return GoldenDrift.drifted(payload)
	end 'isDrift'

	if not verdictClaimedIt and not payload.isEmpty() 'unclaimedPayload'
		panic("spec worker pool: a record carries a payload no field owns — neither its verdict nor its '{token}' golden takes one: '{line}'")
	end 'unclaimedPayload'

	if token == GoldenNotPinnedToken 'isNotPinned'
		return GoldenDrift.notPinned
	end 'isNotPinned'

	if token == GoldenComparedToken 'isCompared'
		return GoldenDrift.matched
	end 'isCompared'

	if token == GoldenMintedToken 'isMinted'
		return GoldenDrift.minted
	end 'isMinted'

	if token == GoldenUnrecordedToken 'isUnrecorded'
		return GoldenDrift.unrecorded
	end 'isUnrecorded'

	panic("spec worker pool: '{token}' is not one of the {GoldenNotPinnedToken}/{GoldenComparedToken}/{GoldenDriftedToken}/{GoldenMintedToken}/{GoldenUnrecordedToken} golden tokens: '{line}'")
end 'decodeGolden'

// One structural separator consumed: the field in front of it, and everything behind it.
type RecordSplit
	export let field as String
	export let rest as String

	export static function create(field String, rest String) returns RecordSplit
		return Self{field: field, rest: rest}
	end 'create'
end 'RecordSplit'

// Cut `body` at its FIRST separator. A record is a run of these — four structural cuts, then the
// payload — so the field walk is written once here rather than once per field, where the copies would
// have to agree about what a field is. The CPU record is a run of the same cuts.
//
// It cuts at the first separator ONLY, which is what makes the last cut right: the remainder is an
// escaped compiler diagnostic, full of colons, and it is carried out whole in `rest` rather than being
// split again.
//
// `expected` names the field that should have followed the separator, so a malformed record reads
// as the protocol break it is instead of a string-index failure.
function splitAtFieldSep(body String, expected String, line String) returns RecordSplit
	let sep = try body.findFirst(ProtocolFieldSep) otherwise panic("spec worker pool: record has no {expected} field: '{line}'")
	let restStart = try body.indexAfter(sep) otherwise panic("spec worker pool: record ends at the separator before its {expected} field: '{line}'")

	return RecordSplit.create(body.slice(body.startIndex(), endIndex: sep), rest: body.slice(restStart, endIndex: body.endIndex()))
end 'splitAtFieldSep'

// Take the job's CPU record OFF THE END of its drained lines, leaving only the result records.
//
// The record is MANDATORY and its position is exact: `runSinglesJob` prints it after the last result
// and before the WORKER_READY that ends the drain, so it is always the final line of a job that ran at
// all. A drain that does not end with one is a worker built from a different version of this file —
// the same protocol break the record checks below panic on, and treated the same way, because the
// alternative is an indicator that silently loses whole specs.
//
// Removing it here rather than teaching `resultsFromLines` to skip it keeps that function's count
// check exact: it still compares record count against plan count with no allowance for an extra line.
function takeJobCpuRecord(lines StringArray, specName String) returns SuiteCpuTally
	let last = try lines.pop() otherwise panic("spec worker pool: '{specName}' returned no lines at all, so it cannot have printed its {WorkerJobCpuMarker} record")

	if not last.startsWith(WorkerJobCpuMarker) 'notTheCpuRecord'
		panic("spec worker pool: '{specName}' ended with '{last}' where its {WorkerJobCpuMarker} record should be")
	end 'notTheCpuRecord'

	let ticks = splitAtFieldSep(sliceAfterPrefix(last, prefix: WorkerJobCpuMarker), expected: "reported-count", line: last)
	let reported = splitAtFieldSep(ticks.rest, expected: "unreported-count", line: last)

	return SuiteCpuTally.create(decodeCpuField(ticks.field, what: "tick total", line: last), reported: decodeCpuField(reported.field, what: "reported count", line: last) as TestTally, unreported: decodeCpuField(reported.rest, what: "unreported count", line: last) as TestTally)
end 'takeJobCpuRecord'

// One decimal field of the CPU record. `parseCount` is the suite's ONE decimal parser (see
// ScaleTestRunner, where its `ScaleError` is named for the harness that first needed it); the numbers
// it reads here were printed by this same file moments ago, so a failure is a protocol break rather
// than bad input. The caller narrows: the three fields are one tick total and two test counts.
function decodeCpuField(raw String, what String, line String) returns ParsedCount
	return try parseCount(raw) otherwise (e) 'unreadableField'
		panic("spec worker pool: a {WorkerJobCpuMarker} record carries an unreadable {what}: '{line}' ({scaleErrorText(e)})")
	end 'unreadableField'
end 'decodeCpuField'

// Turn one worker's drained lines into that spec's results, in the order the parent decided they
// must appear.
//
// THIS IS THE INVARIANCE GATE, enforced rather than assumed. Every record is matched against the
// plan name for name, in order, and a mismatch is a panic: a lost record (a broken pipe), an extra
// one, a reordered one, or one naming a test the parent never selected (a flag that failed to
// reach the worker) would otherwise show up as a suite that quietly reported a different set of
// tests than the one it claims to have run.
function resultsFromLines(lines StringArray, plan SpecPlan) returns SpecTestResultArray
	var results = SpecTestResultArray.create()

	if lines.count() != plan.testNames.count() 'wrongRecordCount'
		panic("spec worker pool: '{plan.specName}' returned {lines.count()} record(s), expected {plan.testNames.count()} — a result was lost, or the worker selected different tests than the parent did")
	end 'wrongRecordCount'

	for i in 0 upto lines.count() 'eachRecord'
		let line = try lines.get(i) otherwise panic("resultsFromLines: lines.get({i}) is in bounds by construction")
		let expectedTest = try plan.testNames.get(i) otherwise panic("resultsFromLines: testNames.get({i}) is in bounds by construction")
		let record = decodeWorkerLine(line)

		if record.specName != plan.specName or record.testName != expectedTest 'wrongTest'
			panic("spec worker pool: expected a record for '{plan.specName}/{expectedTest}', got '{record.specName}/{record.testName}' — the parent and the worker disagree about which tests this spec runs, or in what order")
		end 'wrongTest'

		// Built from the PARENT's own names, which the check above has just proved equal to the
		// worker's. The report is therefore assembled entirely from the parent's plan; nothing
		// that crossed a pipe reaches the printed line but the failure reason.
		results.push(SpecTestResult.create(plan.specName, testName: expectedTest, outcome: record.outcome, golden: record.golden))
	end 'eachRecord'

	return results
end 'resultsFromLines'

// ============================================================================================
// THE DRAIN — the one green thread in the design
// ============================================================================================

// Promise carrying one worker's drained records. The dispatcher holds one per slot. Every drain is
// spawned AT DISPATCH TIME, so all N overlapped stdout reads sit pending in the runtime at once
// and a slow worker never gates a fast one.
//
// It names BOTH types the drain can come back with: the records on success, and the
// SubprocessError on failure. Naming the error is what lets the dispatcher bind it below — and
// what makes its payload get RELEASED. A `Promise with StringArray` names the result only, so
// boxing a drain into one used to erase `SubprocessError`; the box kept a single bit saying
// whether the error was a heap pointer, that bit read `false` for a union, and every dead
// worker leaked the String inside its error. A green suite never showed it: the drain only
// throws when a worker dies.
typealias DrainPromise = Promise with (StringArray, SubprocessError)
typealias DrainPromiseArray = Array with DrainPromise

// When each slot's in-flight job was handed to its worker. Read ONLY by the wedge report, where the
// spread between the slots is the diagnosis: twelve slots dispatched within milliseconds of each
// other says the whole pool stalled at once, while one slot far older than the rest names the single
// worker that stopped answering.
typealias DispatchInstantArray = Array with InstantMs

// Read record lines from `child` until its next WORKER_READY. Throws on EOF before READY — the
// worker exited mid-job — so the dispatcher's `otherwise 'workerDied` fires.
//
// A FREE FUNCTION, not a method on PersistentWorkerHandle, and deliberately so: `async
// handle.drain()` would capture the handle STRUCT, which the dispatcher must keep mutating while
// the green thread runs. Passing the inner `child` by value hands the GT its own copy —
// StreamingSubprocess copies share the runtime-side pipe by handle, so the GT and the parent still
// address the same OS object.
function drainResultsThunk(child StreamingSubprocess) returns StringArray throws SubprocessError
	var lines = StringArray.create()

	while true 'lineLoop'
		let line = try child.readStdoutLine()
		if line.isEmpty() 'eof'
			// Workers never print an empty line (see the protocol note at the top of this file),
			// so this IS EOF: the worker died with the job unfinished.
			throw SubprocessError.ioFailed("stdout reached EOF before {WorkerReadyMarker}")
		end 'eof'

		if line.trim() == WorkerReadyMarker 'jobDone'
			return lines
		end 'jobDone'

		lines.push(line)
	end 'lineLoop'

	panic("drainResultsThunk: the loop above is only left by `return` or `throw`")
end 'drainResultsThunk'

// Everything a (now-exited) worker left in its stderr pipe, joined. Shared by the clean-shutdown
// path and the crash-abort path so both consume stderr the same way.
//
// ONLY EVER CALLED ON A CHILD THAT HAS EXITED, and that is what makes it terminate: the write end
// of the pipe is closed, so the reads hand back what was buffered and then EOF. Called on a live
// worker it would block until that worker exited. It stops on EOF or on the first read error — a
// read error here means the handle is already gone, and there is nothing left to say about a worker
// whose pipe we can no longer read.
function drainChildStderr(child StreamingSubprocess) returns String
	var out = LineJoiner.create()

	while true 'lineLoop'
		let line = try child.readStderrLine() otherwise break
		if line.isEmpty() 'eof'
			break
		end 'eof'

		out.push(line)
	end 'lineLoop'

	return out.build()
end 'drainChildStderr'

// ============================================================================================
// THE WORKER HANDLE
// ============================================================================================

type PersistentWorkerHandle
	export var child as StreamingSubprocess
	export var workerId as WorkerId

	// Spawn the child WITHOUT waiting for its WORKER_READY hello.
	//
	// Two-phase startup: the caller fires all N spawns back to back and only then drains the N
	// hellos, so every worker's process creation and runtime init OVERLAP under a single readiness
	// barrier instead of each one queueing behind the previous worker's hello.
	//
	// ⚠ TWO PATHS, AND THEY ARE NOT THE SAME FACT. `workerExe` is SPAWNED — it is the harness a
	// worker process is. `compilerExe` is FORWARDED — it is the compiler that worker will spawn to
	// build each fragment. In-tree they are one file, which is why one parameter served both until
	// 2026-07-29; the 🚩 Phase 1 gate is the configuration that separates them, and there it would
	// have made a harness compiled by maxon.exe delegate every verdict back to maxon-shv2.exe's own
	// in-tree harness and call the resulting agreement a pass.
	//
	// `filter`, `updateRequired`, `includeNetwork` (`--network`), the COMPILER and the effective TARGET
	// MUST be forwarded. A worker that selected a different set of tests than the parent counted would
	// return records the parent never asked for and omit ones it did — `resultsFromLines` turns that
	// into a panic, but forwarding is the actual fix, and the panic is only there to make forgetting it
	// impossible to miss.
	//
	// ⚠ **THE LIST IS THIS FUNCTION'S PARAMETERS AND NOTHING ELSE — READ IT AGAINST THE SIGNATURE.**
	// `--network` was added below and NOT added here, so the one header whose whole job is naming what a
	// worker must hear about went a whole slice without mentioning the flag that changes what it selects.
	// A new selection input belongs in this sentence in the same edit that gives it a parameter.
	export static function spawnNoWait(compilerExe FilePath, workerExe FilePath, workerId WorkerId, specDir FilePath, filter String, updateRequired bool, effectiveTarget Target, includeNetwork bool) returns PersistentWorkerHandle throws SubprocessError
		var argv = StringArray.create()
		argv.push(SpecTestCommandName)
		argv.push(WorkerPersistentFlag)
		// The RESOLVED spec directory, not the default the worker would otherwise re-derive from
		// its inherited working directory. The parent already decided which directory this run is
		// about; a worker that decided again could decide differently.
		argv.push(specDir.toString())

		// The RESOLVED compiler under test — the same argument as the spec directory above, applied
		// to the fact nobody had applied it to. Forwarded UNCONDITIONALLY, and that is the whole
		// point: a worker with no `--compiler` re-derives one from its own `Process.executablePath()`
		// and gets the WORKER binary, which is right only while the harness and the compiler happen
		// to be the same file. Unconditional unlike `--target` below, whose conditionality exists for
		// a specific hazard (a host spelling `parseBuildTarget` does not list would reject its own
		// forwarded flag and never come up); a path carries no such hazard, and the parent has
		// already proved this one exists.
		argv.push("{CompilerFlagPrefix}{compilerExe.toString()}")

		if not filter.isEmpty() 'hasFilter'
			argv.push("{FilterFlagPrefix}{filter}")
		end 'hasFilter'

		if updateRequired 'isUpdate'
			argv.push(UpdateRequiredFlag)
		end 'isUpdate'

		// ⭐ FORWARDED FOR THE REASON `--filter` IS, and it is the same failure if it is not: the parent
		// counted the live-network cases in its plan, and a worker that never heard about the flag would
		// select a DIFFERENT set and answer with records the parent never asked for. Conditional like
		// `--update-required` above rather than unconditional, so a default run's worker command line is
		// byte-identical to what it was before this flag existed.
		if includeNetwork 'wantsLiveNetwork'
			argv.push(NetworkFlag)
		end 'wantsLiveNetwork'

		// Forward the effective target ONLY when it differs from the host the worker would otherwise
		// default to. A worker is this exe relaunched; with no `--target` it resolves
		// `detectHostTarget()`, which on the same machine is exactly the parent's target for an
		// ordinary (host) run — so a native run adds nothing to the argv and `--workers=N` stays
		// byte-identical to `--workers=1`, as it always has. A CROSS run (`--target=wasm32-wasi`)
		// differs, so it IS forwarded, and the worker re-parses it through Main's arg parser to reach
		// the SAME effectiveTarget the parent's plan used. It is NOT forwarded unconditionally: a host
		// whose `targetToString` spelling `Main.parseBuildTarget` does not list (e.g. x64-linux) would
		// then reject its own `--target` and never come up.
		if targetToString(effectiveTarget) != targetToString(detectHostTarget()) 'nonHostTarget'
			argv.push("{TargetFlagPrefix}{targetToString(effectiveTarget)}")
		end 'nonHostTarget'

		let child = try StreamingSubprocess.spawn(Executable.path(workerExe), arguments: argv)
		return Self{child: child, workerId: workerId}
	end 'spawnNoWait'

	// Drain the startup hello. Pairs with `spawnNoWait`'s two-phase startup.
	//
	// EVERY failing path releases the handle before it throws — the unreadable-pipe path included,
	// which used to propagate the read error with the handle still open. A worker that never says
	// hello is a worker nobody will hold a handle to again, and the caller's job is to report that,
	// not to clean up after this one.
	export function awaitReady() throws SubprocessError
		let hello = try child.readStdoutLine() otherwise (e) 'helloUnreadable'
			child.release()
			throw e
		end 'helloUnreadable'

		if hello.trim() != WorkerReadyMarker 'badHello'
			child.release()
			throw SubprocessError.ioFailed("worker {workerId} startup: expected {WorkerReadyMarker}, got '{hello}'")
		end 'badHello'
	end 'awaitReady'

	export function sendJob(jobLine String) throws SubprocessError
		try child.writeStdinLine(jobLine)
	end 'sendJob'

	// EXIT, close stdin, wait, drain stderr, release. Returns the child's exit code, which the
	// caller must inspect: 101 is the leak gate.
	//
	// The stderr drain is SYNCHRONOUS, after `wait()`, and that is not an oversight. v1 drained it
	// continuously from an `async` GT and leaked one MM allocation per worker — the Promise box and
	// the GT's argument buffer never returned to the slab. By the time we get here the child has
	// exited, so its write end is closed: the read loop consumes what the pipe buffered and then
	// sees EOF. A worker emits nothing on stderr on the happy path, so deferring the drain costs
	// nothing and cannot fill the pipe.
	//
	// A FAILED shutdown releases the handle TOO, and it must: `shutdownPool` merely reports that
	// error and moves on to the next worker, so a handle abandoned here would be an OS handle held
	// for the rest of the run — in a parent that is itself leak-gated. The stderr drain is skipped
	// on that path: it terminates only because the child has EXITED, and a shutdown that failed is
	// exactly the case where we cannot say that it has.
	export function shutdownAndDrainStderr() returns ExitInt throws SubprocessError
		let code = try requestExitAndWait() otherwise (e) 'shutdownFailed'
			child.release()
			throw e
		end 'shutdownFailed'

		let stderr = drainChildStderr(child)
		if not stderr.isEmpty() 'workerSpoke'
			printError("{stderr}\n")
		end 'workerSpoke'

		child.release()
		return code
	end 'shutdownAndDrainStderr'

	// Ask the worker to leave, close its stdin so an unresponsive one still sees EOF, and wait for
	// it. Split out from the above so that BOTH of its throwing calls land on one failure path, and
	// that path can release the handle before it rethrows.
	//
	// ⚠ THE WAIT CARRIES A DEADLINE, and it is the same argument the dispatch loop's watchdog rests
	// on, applied to the one blocking wait that sits OUTSIDE that loop. `child.wait()` is
	// `waitWithTimeout(0)` — wait forever — so a worker that stops responding after its last job
	// hangs the suite HERE, past the watchdog's reach, with the run's every verdict already computed
	// and no symptom but a gate that never returns. That is precisely the failure this slice exists
	// to abolish, and it does not stop being one because it happens two lines after the loop.
	// `waitWithTimeout` forcibly terminates the child when the deadline fires, so the timeout leaves
	// no orphan; `shutdownPool` turns the throw into a named per-worker error and a non-zero suite.
	function requestExitAndWait() returns ExitInt throws SubprocessError
		try child.writeStdinLine(ExitCommand)
		child.closeStdin()
		return try child.waitWithTimeout(WorkerShutdownTimeoutMs)
	end 'requestExitAndWait'
end 'PersistentWorkerHandle'

typealias PersistentWorkerHandleArray = Array with PersistentWorkerHandle

// A worker died. Print whatever it managed to write to stderr — its panic message and stack trace,
// if it panicked — and take the whole run down with it.
//
// There is deliberately no recovery. A dead worker is not a flaky test to be retried: it is the
// harness itself crashing, and rerouting its job to a surviving worker would turn a hard bug into
// an intermittently green suite. The panic tears the process down, so the handle is not released
// here — the OS reclaims it.
function abortOnDeadWorker(handle PersistentWorkerHandle, job SpecJob, reason String)
	printError("\n=== spec worker {handle.workerId} died on '{job.specName}' — aborting the run ===\n")
	printError("{reason}\n")

	let stderr = drainChildStderr(handle.child)
	if stderr.isEmpty() 'silent'
		printError("(the worker wrote nothing to stderr before dying)\n")
	end 'silent' else 'spoke'
		printError("{stderr}\n")
	end 'spoke'

	panic("spec worker {handle.workerId} died while running '{job.specName}'; see stderr above")
end 'abortOnDeadWorker'

// `1234` as `1.2 s`. The wedge report's numbers span three orders of magnitude — a slot re-dispatched
// milliseconds ago sits beside one outstanding for two minutes — and a raw millisecond count buries
// the only digit that separates them. Exported for the same reason `WedgeWatchdogMs` is: `E6002`
// quotes that deadline at an operator, and an operator-facing duration has exactly one spelling here.
export function formatSeconds(ms DurationMs) returns String
	let whole = ms / MillisPerSecond
	// Scaled by the tenths-per-second BEFORE the divide, so the one divisor in this function is
	// `MillisPerSecond` twice over rather than a second constant derived from it.
	let tenths = (ms - whole * MillisPerSecond) * TenthsPerSecond / MillisPerSecond
	return "{whole}.{tenths} s"
end 'formatSeconds'

// Has this slot's drain green thread produced its answer yet? ONE spelling of the predicate, because
// two places ask it for opposite reasons: `findReadyDrain` SERVES on it, and `abortOnWedgedPool`
// REPORTS on it — and the report's entire diagnostic value is the claim that a busy slot printing
// `drain complete: yes` means the scan missed an answer it should have served. That claim is only
// true while the two ask the same question. Written twice they agreed, and nothing made them agree:
// a clause added to the scan and not to the report would not fail to compile, it would make the
// report confidently accuse the wrong half of the harness.
function drainHasAnswered(drain DrainPromise) returns bool
	return __Builtins.gtIsComplete(drain.inner) != 0
end 'drainHasAnswered'

// The pool has stopped moving. Print what every slot was doing and take the run down.
//
// THE REPORT IS THE POINT. A wedge is not reproducible on demand — the measured rate is a couple of
// runs in a hundred, and the same binary runs green on the retry — so the ONE moment the state is
// knowable is the moment it is detected, and a watchdog that merely said "timed out" would throw away
// the only evidence anybody will ever get. The three facts below each rule out a different cause:
//
//   * WHICH SLOTS ARE BUSY, and the spread of their ages. All twelve stalled together is a parent-
//     side or scheduler-side stall; one slot far older than the rest names a single stuck worker.
//   * WHAT JOB each busy slot holds, so the spec can be run on its own.
//   * WHETHER THE DRAIN PROMISE IS COMPLETE. Every busy slot should read `no` here, because a
//     completed drain is exactly what `findReadyDrain` would have served instead of parking. A `yes`
//     would mean the answer arrived and the SCAN missed it — a different bug entirely, in this file
//     rather than under it, and one nothing else would ever surface.
//
// There is deliberately no recovery, for the same reason `abortOnDeadWorker` has none: rerouting or
// retrying inside the harness would turn a hard bug into an intermittently green suite.
// `idleFor` is the interval actually MEASURED, not the threshold that was crossed. The two differ by
// at most one poll on a real wedge and by an unbounded amount on a suspended machine, which is the
// case the header exists to let an operator tell apart: a run idle for 4000 s did not wedge, it slept.
function abortOnWedgedPool(busy BoolArray, inFlight SpecJobArray, drains DrainPromiseArray, dispatchedAt DispatchInstantArray, idleFor DurationMs, queued JobTally, dispatched JobTally, completed JobTally)
	var report = LineJoiner.create()
	report.push("\n=== spec worker pool WEDGED: nothing dispatched or collected for {formatSeconds(idleFor)} (limit {formatSeconds(WedgeWatchdogMs)}) ===")
	report.push("{dispatched} job(s) dispatched, {completed} collected, {queued} still queued")

	for slot in 0 upto busy.count() 'eachSlot'
		let isBusy = try busy.get(slot) otherwise panic("abortOnWedgedPool: busy.get({slot}) is in bounds by construction")
		if not isBusy 'idleSlot'
			report.push("  slot {slot}: idle")
			continue
		end 'idleSlot'

		let job = try inFlight.get(slot) otherwise panic("abortOnWedgedPool: inFlight.get({slot}) is in bounds by construction")
		let since = try dispatchedAt.get(slot) otherwise panic("abortOnWedgedPool: dispatchedAt.get({slot}) is in bounds by construction")
		let drain = try drains.get(slot) otherwise panic("abortOnWedgedPool: a busy slot always has a drain promise, and slot {slot} is busy")
		let answered = "yes" if drainHasAnswered(drain) else "no"
		report.push("  slot {slot}: '{job.specName}' sent {formatSeconds(Clock.elapsedMs(since))} ago, drain complete: {answered}")
	end 'eachSlot'

	printError("{report.build()}\n")
	panic("spec worker pool wedged — see the per-slot report above. This is a HARNESS bug, not a test failure: RETRY the run. If it reproduces, `scripts/spec-wedge-repro.sh` loops the suite and captures the parked stacks of the parent and its workers the next time it happens.")
end 'abortOnWedgedPool'

// ============================================================================================
// THE DISPATCHER
// ============================================================================================

// What one pool run produced: every test's verdict in report order, how many workers exited
// NON-ZERO, and what the whole run's compiles cost.
//
// The worker exit codes are carried out rather than acted on in here, because they are not a TEST
// result and must never reach the reporter — but they still have to fail the suite. A worker is
// itself a leak-gated Maxon program: exit 101 means the harness leaked while servicing its tests,
// and a green suite that swallowed that would be a leak gate that never fires.
//
// `cpu` is carried out for the opposite reason: it must never fail anything. It is a trend indicator
// with no verdict attached (see SpecTestRunner), reported beside the summary and acted on by nobody.
//
// `poolSize` travels WITH it and only for it: the tick total is 1.66x larger at twelve workers than at
// one for identical work, so a reading without the count it was taken at is not comparable to anything.
// It is the EFFECTIVE size — the pool that actually ran, which a narrow `--filter` can shrink below the
// requested count — because contention is what the number absorbs, and contention is a property of the
// workers that existed rather than of the ones that were asked for.
export type PoolRun
	export let results as SpecTestResultArray
	export let failedWorkers as WorkerTally
	export let cpu as SuiteCpuTally
	export let poolSize as WorkerCount
	// The live-network cases this run passed over, from the parent's own plan walk. It rides HERE rather
	// than being re-derived by the reporter because deciding it a second time would need a second parse of
	// every spec — and a second copy of the selection rules to decide it with.
	export let networkExcluded as ExcludedCaseArray

	export static function create(results SpecTestResultArray, failedWorkers WorkerTally, cpu SuiteCpuTally, poolSize WorkerCount, networkExcluded ExcludedCaseArray) returns PoolRun
		return Self{results: results, failedWorkers: failedWorkers, cpu: cpu, poolSize: poolSize, networkExcluded: networkExcluded}
	end 'create'
end 'PoolRun'

// Raised by the slot scans when no slot qualifies. A THROW rather than a sentinel index: "no worker
// is idle" and "no worker has answered yet" are routine, expected states of the dispatch loop, and
// `if let` reads them directly.
enum NoSlot implements Error
	none
end 'NoSlot'

// Run the whole suite on a pool of `workerCount` persistent workers and return every verdict in
// report order.
//
// `compilerExe` is what each test is BUILT with; `workerExe` is what each worker process IS. See
// `spawnNoWait` for why those are two parameters and not one.
export function runSpecPool(compilerExe FilePath, workerExe FilePath, specDir FilePath, filter String, updateRequired bool, workerCount WorkerCount, effectiveTarget Target, includeNetwork bool) returns PoolRun throws CompileError
	// ⭐ **THE TREND LOG'S OWN REFUSALS, PROVEN TO FIRE.** `ScaleHistory` reads a document a human edits
	// and refuses around thirty ways it can be edited into a lie; nothing in the tree ran one of them.
	// It is wired here rather than into `scale-test` because a gate only the instrument's own command
	// reaches is a gate nobody runs on the way to a merge — and unlike the harness fixtures below, this
	// one spawns nothing: those refusals are catchable throws, so this is a few hundred string
	// comparisons.
	//
	// ⚠ **IT GOES FIRST, AND THAT ORDER IS LOAD-BEARING.** The harness self-test below drives its
	// fixtures by SPAWNING this harness, and a sub-run reaches this same function — so a broken trend
	// refusal panics inside EVERY sub-run (one per fixture directory, plus the network gate's two), and the
	// parent reads each fixture one as a harness fixture that "failed for the WRONG REASON". Measured when
	// there were eight fixtures: the suite's headline became `8 of 8 harness refusals did not fire`, which
	// was false, with the real cause buried eight times in the body.
	// Asking this question before any sub-run exists means the parent panics on its own terms and says
	// exactly what broke. (A green run still answers it once per sub-run, which is string work on a
	// document of a few hundred bytes.)
	requireScaleHistoryRefusalsFire()

	// ⭐ **AND THE HARNESS'S OWN REFUSALS, BEFORE THE HARNESS IS TRUSTED TO JUDGE ANYTHING ELSE.** It
	// runs here rather than in `Main` because this is the one function only the PARENT of a pool reaches
	// (a worker goes to `runPersistentWorker`), and it runs ahead of `buildPlans`, which is itself one of
	// the things under test — so a `--filter`ed run gets the same door an unfiltered one does. See
	// `HarnessSelfTest` for why a committed malformed spec cannot do this job.
	requireHarnessRefusalsFire(workerExe, compilerExe: compilerExe, specDir: specDir)

	// ⭐ **AND THAT THE LIVE-NETWORK GATE STILL GATES**, in the same slot and driven the same way. It is
	// the other half of "the harness selects what it says it selects": the sweep above proves the harness
	// REFUSES what it must, this proves it LEAVES OUT what it must — and says so. Ahead of `buildPlans`
	// for that function's reason: the selection it checks is the one about to be made.
	requireNetworkGateHolds(workerExe, compilerExe: compilerExe, specDir: specDir)

	let suitePlan = try buildPlans(specDir, filter: filter, effectiveTarget: effectiveTarget, includeNetwork: includeNetwork)
	let plans = suitePlan.plans
	if plans.count() == 0 'selectsNothing'
		// Main owns the "no tests selected" diagnostic and reads it off an empty result array.
		// Spawning a pool only to tell it there is nothing to do would add a way for that message
		// to go missing, and nothing else.
		//
		// `poolSize` is the REQUESTED count here, and it is the same kind of placeholder as
		// `SpecJob.idle()`: no pool was sized because none was spawned, and Main returns on the empty
		// result array before anything reads it.
		// The excluded census rides out even here — ESPECIALLY here. A run whose whole selection was
		// live-network reaches exactly this return, and "no tests selected" on its own would state the
		// consequence and hide the cause.
		return PoolRun.create(SpecTestResultArray.create(), failedWorkers: 0, cpu: SuiteCpuTally.zero(), poolSize: workerCount, networkExcluded: suitePlan.networkExcluded)
	end 'selectsNothing'

	try prepareSharedDirs(specDir, effectiveTarget: effectiveTarget)

	var jobQueue = SpecJobArray.create()
	for i in 0 upto plans.count() 'enqueue'
		let plan = try plans.get(i) otherwise panic("runSpecPool: plans.get({i}) is in bounds by construction")
		jobQueue.push(SpecJob.create(i, specName: plan.specName, weight: plan.weight))
	end 'enqueue'

	// A worker with no job would spawn, say hello, and be shut down again — pure cost, and one more
	// process to go wrong.
	var poolSize = workerCount
	if jobQueue.count() < poolSize 'moreWorkersThanJobs'
		poolSize = jobQueue.count() as WorkerCount
	end 'moreWorkersThanJobs'

	var workers = spawnPool(compilerExe, workerExe: workerExe, count: poolSize, specDir: specDir, filter: filter, updateRequired: updateRequired, effectiveTarget: effectiveTarget, includeNetwork: includeNetwork)

	// Per-slot state as PARALLEL ARRAYS rather than one array of slot structs: the in-flight drain
	// Promise cannot live inside a struct the loop also keeps mutating (see `drainResultsThunk`),
	// and splitting out only that one field would read worse than splitting all of them.
	//
	// THE FOUR ARE INDEXED BY THE SAME SLOT NUMBER AND `busy` IS THE GUARD FOR THE OTHER THREE:
	// `inFlight[slot]`, `drains[slot]` and `dispatchedAt[slot]` are read ONLY where `busy[slot]` is
	// true, and `sendAndDrain` establishes all three before it sets the guard — so a slot is never
	// observable as busy with a stale job or a missing promise.
	var busy = BoolArray.create()
	var inFlight = SpecJobArray.create()
	var drains = DrainPromiseArray.create()
	var dispatchedAt = DispatchInstantArray.create()
	let idleJob = SpecJob.idle()
	// The placeholder instant, like `SpecJob.idle()` beside it: never read, because an idle slot's
	// age is not a thing the report prints. It only keeps this array the same length as `busy` from
	// the start, so the two are indexed by the same slot number.
	let idleInstant = Clock.nowMs()
	for _ in 0 upto poolSize 'initSlots'
		busy.push(false)
		inFlight.push(idleJob)
		dispatchedAt.push(idleInstant)
	end 'initSlots'

	// One bucket per plan, filled out of order and concatenated in plan order at the end. THIS is
	// where worker-count invariance is won: nothing is reported as it arrives.
	var buckets = SpecResultBuckets.create()
	for _ in 0 upto plans.count() 'initBuckets'
		buckets.push(SpecTestResultArray.create())
	end 'initBuckets'

	// Round-robin cursors. Without them the loop re-dispatches to the slot it just drained and then
	// drains that same slot again, while every other worker sits on a finished job nobody reads.
	var dispatchCursor = 0 as WorkerId
	var drainCursor = 0 as WorkerId
	var dispatched = 0 as JobTally
	var completed = 0 as JobTally

	// The run's compile cost, summed as each job's answer is decoded. Summing per JOB rather than
	// per worker is what makes it independent of the pool size: which worker ran which spec changes
	// with the scheduling, the set of jobs does not.
	var cpu = SuiteCpuTally.zero()

	// The watchdog's whole state. `dispatched + completed` counts every progress event this loop can
	// make, so a poll that finds it unchanged since the previous poll found nothing moving — which is
	// exactly the condition to time, and it is measured HERE rather than at the three places progress
	// happens, so there is one clock read per park and no way to add a fourth progress path that
	// forgets to reset the timer.
	var lastProgress = 0 as JobTally
	var lastProgressMs = Clock.nowMs()

	while true 'dispatchLoop'
		// This loop turning is what the tree lock's heartbeat means by "the holder is still there" —
		// so it is refreshed HERE, at the top, rather than at the three places progress happens. A
		// suite parked on its last slow spec is still a live holder, and one placed on completions
		// alone would age out under exactly that tail. The write is throttled to one every few
		// seconds, so a poll loop pays a clock read (see `touchTreeLock`).
		touchTreeLock()

		// Feed the pool before draining it: the parallelism does not exist until every worker has a
		// job, so an idle slot always outranks a ready answer.
		if let idleSlot = try findIdleSlot(busy, cursor: dispatchCursor) 'haveIdleWorker'
			if jobQueue.count() > 0 'haveWork'
				sendAndDrain(workers, slot: idleSlot, job: popHeaviestJob(jobQueue), busy: busy, inFlight: inFlight, drains: drains, dispatchedAt: dispatchedAt)
				dispatched = dispatched + 1
				dispatchCursor = wrapSlot(idleSlot + 1, poolSize: poolSize)
				continue
			end 'haveWork'

			// The queue is empty. If nobody is still working, every job has been accounted for.
			if not anySlotBusy(busy) 'runComplete'
				break
			end 'runComplete'
		end 'haveIdleWorker'

		// Serve whichever busy worker has ALREADY answered, rather than awaiting slots in order.
		// The queue is slowest-first, so slot 0 holds the heaviest spec — a parent that awaited in
		// slot order would park on it while every other worker sat idle with its answer already in
		// the pipe. That is head-of-line blocking, and it is what the non-blocking peek prevents.
		if let readySlot = try findReadyDrain(busy, drains: drains, cursor: drainCursor) 'haveAnswer'
			var handle = try workers.get(readySlot) otherwise panic("runSpecPool: workers.get({readySlot}) is in bounds by construction")
			// Cloned out of the array so the borrow does not pin `inFlight` for the re-dispatch
			// below, which overwrites this very slot.
			let job = (try inFlight.get(readySlot) otherwise panic("runSpecPool: inFlight.get({readySlot}) is in bounds by construction")).clone()
			let drain = try drains.get(readySlot) otherwise panic("runSpecPool: a busy slot always has a drain promise, and slot {readySlot} is busy")

			// `DrainPromise` names its error type, so `e` here is the real SubprocessError the
			// drain threw — through an array, through a re-dispatch, all the way from the `async`
			// that spawned it. It reports WHICH failure killed the worker instead of the generic
			// guess this site used to print, and binding it is also what RELEASES it: a union's
			// payload is a heap pointer, and the binding is what decrefs it.
			var lines = try await drain otherwise (e) 'workerDied'
				abortOnDeadWorker(handle, job: job, reason: "its stdout died before {WorkerReadyMarker}: {e.displayReason()}")
			end 'workerDied'

			// Keep the slot fed BEFORE decoding what it just said. The worker has been idle since
			// the instant it printed WORKER_READY, so the next job overlaps with the parent's
			// decode — and with a slowest-first queue, the next job is the best one left.
			if jobQueue.count() > 0 'moreWork'
				sendAndDrain(workers, slot: readySlot, job: popHeaviestJob(jobQueue), busy: busy, inFlight: inFlight, drains: drains, dispatchedAt: dispatchedAt)
				dispatched = dispatched + 1
			end 'moreWork' else 'queueDrained'
				try busy.set(readySlot, value: false) otherwise panic("runSpecPool: busy.set({readySlot}) is in bounds by construction")
			end 'queueDrained'

			// Taken off the END of the drained lines, before anything counts them: what remains is
			// exactly the result records `resultsFromLines` checks against the plan.
			cpu = cpu.plus(takeJobCpuRecord(lines, specName: job.specName))

			let plan = try plans.get(job.planIndex) otherwise panic("runSpecPool: plans.get({job.planIndex}) is in bounds by construction")
			try buckets.set(job.planIndex, value: resultsFromLines(lines, plan: plan)) otherwise panic("runSpecPool: buckets.set({job.planIndex}) is in bounds by construction")
			completed = completed + 1
			drainCursor = wrapSlot(readySlot + 1, poolSize: poolSize)
			continue
		end 'haveAnswer'

		// Nobody idle, nobody answered. Before parking again, ask how long that has been true: a poll
		// loop cannot deadlock, so without this the only symptom of a pool that has stopped moving is
		// a gate that never returns.
		let progress = dispatched + completed
		if progress != lastProgress 'movedSincePreviousPark'
			lastProgress = progress
			lastProgressMs = Clock.nowMs()
		end 'movedSincePreviousPark'

		let idleFor = Clock.elapsedMs(lastProgressMs)
		if idleFor >= WedgeWatchdogMs 'wedged'
			abortOnWedgedPool(busy, inFlight: inFlight, drains: drains, dispatchedAt: dispatchedAt, idleFor: idleFor, queued: jobQueue.count(), dispatched: dispatched, completed: completed)
		end 'wedged'

		// Park, so the scheduler can run the drain green threads — every one of them blocked on an
		// overlapped read of its worker's stdout.
		sleep(PollYieldMs)
	end 'dispatchLoop'

	if dispatched != completed 'jobLost'
		panic("runSpecPool: dispatched {dispatched} job(s) but completed {completed} — a job was lost in the dispatch loop")
	end 'jobLost'

	let failedWorkers = shutdownPool(workers)
	let results = concatBuckets(buckets)

	// The indicator covers EVERY test this run reported, or it is not an indicator of this run. Each
	// test contributes exactly one reading (`SpecTestRunner.TestRun` carries the verdict and the cost
	// together), so a disagreement here means a job's CPU record was decoded against the wrong job — for the
	// same reason `resultsFromLines` checks its records, and it costs one comparison.
	if cpu.tests() != results.count() 'cpuCoverageGap'
		panic("runSpecPool: the compile-CPU tally covers {cpu.tests()} test(s) but the run reported {results.count()} — a job's {WorkerJobCpuMarker} record was counted against the wrong job")
	end 'cpuCoverageGap'

	return PoolRun.create(results, failedWorkers: failedWorkers, cpu: cpu, poolSize: poolSize, networkExcluded: suitePlan.networkExcluded)
end 'runSpecPool'

// The buckets, in plan order — the suite's report, assembled at last from answers that arrived in
// whatever order the workers happened to finish.
function concatBuckets(buckets SpecResultBuckets) returns SpecTestResultArray
	var results = SpecTestResultArray.create()

	for bucket in buckets 'eachSpec'
		for result in bucket 'eachResult'
			results.push(result)
		end 'eachResult'
	end 'eachSpec'

	return results
end 'concatBuckets'

// Create the directories every worker writes into, ONCE, in the parent. Each worker owns a private
// per-spec subdirectory under each root, so the only thing they could race on is the creation of
// the shared parent — and `Directory.create`'s mkdir -p from N processes at once is exactly that
// race.
function prepareSharedDirs(specDir FilePath, effectiveTarget Target) throws CompileError
	let tempRoot = specTempRootDir(specDir)
	if not Directory.create(tempRoot) 'noTempRoot'
		throw CompileError.directoryNotFound(tempRoot)
	end 'noTempRoot'

	// ⭐ The cwd every TEST BINARY is spawned with (`SpecTestRunner.specRunWorkingDir`). Unlike the two
	// roots around it this one holds no harness artifact at all — it is where a spec case's OWN relative
	// paths land, which is why the corpus can assert things about it and why a failure to create it is
	// as fatal as the scratch root's: every case that touches the filesystem would then run somewhere
	// nobody chose.
	let runWorkingDir = specRunWorkingDir()
	if not Directory.create(runWorkingDir) 'noRunWorkingDir'
		throw CompileError.directoryNotFound(runWorkingDir)
	end 'noRunWorkingDir'

	// A fragments root that cannot be created is NOT a gate — `checkTestFragment` swallows the
	// ensuing write error and the behaviour tests still run — so unlike the scratch root, a failure
	// here is not fatal. It is created up front only so that N workers do not race to make it.
	//
	// ⚠ BOTH CONDITIONS MIRROR `runOneSpec` EXACTLY, and they have to: this is the parent's half of a
	// path whose other half the workers compute in their own processes. Keyed off a different target,
	// the parent would create the host's root while the workers wrote into the target's; gated on a
	// different predicate, it would scaffold a tree for a target that writes no goldens at all.
	if emitsTargetIr(effectiveTarget) 'hasGoldens'
		_ = Directory.create(fragmentsRootDir(specDir, target: effectiveTarget))
	end 'hasGoldens'
end 'prepareSharedDirs'

// Two-phase startup: fire all N spawns back to back, THEN drain the N hellos.
//
// A worker that cannot be spawned, or that says anything other than WORKER_READY, is a PANIC.
// There is no degraded mode to fall back to, and a pool that quietly ran with fewer workers than
// it was asked for would be a harness lying about what it did.
function spawnPool(compilerExe FilePath, workerExe FilePath, count WorkerCount, specDir FilePath, filter String, updateRequired bool, effectiveTarget Target, includeNetwork bool) returns PersistentWorkerHandleArray
	var workers = PersistentWorkerHandleArray.create()

	for i in 0 upto count 'spawnPhase'
		let handle = try PersistentWorkerHandle.spawnNoWait(compilerExe, workerExe: workerExe, workerId: i, specDir: specDir, filter: filter, updateRequired: updateRequired, effectiveTarget: effectiveTarget, includeNetwork: includeNetwork) otherwise (e) 'spawnFailed'
			panic("spec worker pool: could not spawn worker {i}: {e.displayReason()}")
		end 'spawnFailed'
		workers.push(handle)
	end 'spawnPhase'

	for i in 0 upto count 'readyPhase'
		var handle = try workers.get(i) otherwise panic("spawnPool: workers.get({i}) is in bounds by construction")
		try handle.awaitReady() otherwise (e) 'noHello'
			panic("spec worker pool: worker {i} never said {WorkerReadyMarker}: {e.displayReason()}")
		end 'noHello'
	end 'readyPhase'

	return workers
end 'spawnPool'

// Hand `job` to slot `slot` and immediately spawn the green thread that will drain its answer.
//
// The drain is spawned AT DISPATCH, not when the parent gets round to reading: that is what puts
// all N overlapped stdout reads in flight at once. The promise array grows by PUSH on a slot's
// first dispatch and by SET on every dispatch after — the initial dispatches go out in slot order
// (the idle scan starts at cursor 0 and every slot starts idle), so the push always lands at the
// right index, and the strict split below turns any future reordering into a panic rather than a
// silently mis-indexed promise.
//
// THE ORDER OF THE FOUR SLOT WRITES IS DELIBERATE, and `busy` goes LAST. `busy[slot]` is the guard
// that tells the two scans below that `inFlight[slot]`, `drains[slot]` and `dispatchedAt[slot]` may
// be read, so it is set only once all three hold this job's values. Setting it first — as this used
// to — leaves a window in which the slot claims to be busy while its promise is still the PREVIOUS
// job's, and that window is safe today only because nothing between the writes happens to yield to
// another green thread. That is a property of the current code, not of the invariant, so it is not
// one to rest on.
//
// `dispatchedAt` is stamped AFTER the send rather than before it, so it dates the job from the moment
// the worker could first have seen it. The distinction matters in exactly the case it is read in: a
// wedge report whose ages included a blocked write would be timing the parent, not the worker.
function sendAndDrain(workers PersistentWorkerHandleArray, slot WorkerId, job SpecJob, busy BoolArray, inFlight SpecJobArray, drains DrainPromiseArray, dispatchedAt DispatchInstantArray)
	var handle = try workers.get(slot) otherwise panic("sendAndDrain: workers.get({slot}) is in bounds by construction")

	try handle.sendJob(job.toJobLine()) otherwise (e) 'sendFailed'
		// A broken stdin pipe means the worker is already gone. Rerouting the job to a surviving
		// worker would mask a death that must never happen.
		abortOnDeadWorker(handle, job: job, reason: "could not send it the job: {e.displayReason()}")
	end 'sendFailed'

	try dispatchedAt.set(slot, value: Clock.nowMs()) otherwise panic("sendAndDrain: dispatchedAt.set({slot}) is in bounds by construction")
	try inFlight.set(slot, value: job) otherwise panic("sendAndDrain: inFlight.set({slot}) is in bounds by construction")

	let drain = async drainResultsThunk(handle.child)
	if slot == drains.count() 'firstDispatchToThisSlot'
		drains.push(drain)
	end 'firstDispatchToThisSlot' else if slot < drains.count() 'redispatch'
		try drains.set(slot, value: drain) otherwise panic("sendAndDrain: drains.set({slot}) is in bounds by construction")
	end 'redispatch' else 'indexGap'
		panic("sendAndDrain: slot {slot} has no promise slot yet and is not the next one ({drains.count()}) — the initial dispatch went out of slot order")
	end 'indexGap'

	try busy.set(slot, value: true) otherwise panic("sendAndDrain: busy.set({slot}) is in bounds by construction")
end 'sendAndDrain'

// EXIT every worker, wait for it, forward whatever it left on stderr, release its handle — and
// count the ones that exited NON-ZERO. Releasing is not optional: a leaked handle is a leaked OS
// process slot.
function shutdownPool(workers PersistentWorkerHandleArray) returns WorkerTally
	var failed = 0 as WorkerTally

	for i in 0 upto workers.count() 'eachWorker'
		var handle = try workers.get(i) otherwise panic("shutdownPool: workers.get({i}) is in bounds by construction")

		let code = try handle.shutdownAndDrainStderr() otherwise (e) 'shutdownFailed'
			printError("error: spec worker {i} did not shut down cleanly: {e.displayReason()}\n")
			failed = failed + 1
			continue
		end 'shutdownFailed'

		if code != 0 'nonZeroExit'
			let leakHint = " — the leak gate: this worker's compiles leaked memory" if code == LeakCheckExitCode else ""
			printError("error: spec worker {i} exited with code {code}{leakHint}\n")
			failed = failed + 1
		end 'nonZeroExit'
	end 'eachWorker'

	return failed
end 'shutdownPool'

// The next idle slot at or after `cursor`, wrapping. Round-robin rather than always-from-zero, so
// the pool does not pin its work to the low-numbered workers. Both scans below sweep all `poolSize`
// slots before giving up, so the cursor's position can never starve a slot — it only chooses which
// of several eligible slots is served first.
function findIdleSlot(busy BoolArray, cursor WorkerId) returns WorkerId throws NoSlot
	let poolSize = busy.count()

	for offset in 0 upto poolSize 'scan'
		let slot = wrapSlot(cursor + offset, poolSize: poolSize)
		let isBusy = try busy.get(slot) otherwise panic("findIdleSlot: busy.get({slot}) is in bounds by construction")
		if not isBusy 'isIdle'
			return slot
		end 'isIdle'
	end 'scan'

	throw NoSlot.none
end 'findIdleSlot'

// The next BUSY slot at or after `cursor` whose drain green thread has already COMPLETED — a
// non-blocking peek at the promise, which is what lets the loop serve whoever finished first
// instead of whoever it happened to await first.
function findReadyDrain(busy BoolArray, drains DrainPromiseArray, cursor WorkerId) returns WorkerId throws NoSlot
	let poolSize = busy.count()

	for offset in 0 upto poolSize 'scan'
		let slot = wrapSlot(cursor + offset, poolSize: poolSize)
		let isBusy = try busy.get(slot) otherwise panic("findReadyDrain: busy.get({slot}) is in bounds by construction")
		if not isBusy 'skipIdle'
			continue
		end 'skipIdle'

		let drain = try drains.get(slot) otherwise panic("findReadyDrain: a busy slot always has a drain promise, and slot {slot} is busy")
		if drainHasAnswered(drain) 'hasAnswered'
			return slot
		end 'hasAnswered'
	end 'scan'

	throw NoSlot.none
end 'findReadyDrain'

function anySlotBusy(busy BoolArray) returns bool
	for isBusy in busy 'eachSlot'
		if isBusy 'stillWorking'
			return true
		end 'stillWorking'
	end 'eachSlot'

	return false
end 'anySlotBusy'

// `slot` reduced modulo the pool size. Spelled as a subtract-divide because Maxon has no remainder
// operator; `poolSize` is never zero, since a pool with no workers never reaches the dispatch loop.
function wrapSlot(slot WorkerId, poolSize WorkerCount) returns WorkerId
	return slot - (slot / poolSize) * poolSize
end 'wrapSlot'
