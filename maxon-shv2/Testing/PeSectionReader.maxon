// Testing/PeSectionReader.maxon — read a named section's bytes back out of a linked PE, and parse
// a spec's ```RequiredData block into the bytes it claims.
//
// **THIS IS THE SPEC SUITE'S ONLY LOOK AT WHAT WAS ACTUALLY LINKED.** Every other gate reads
// something the compiler produced ON PURPOSE — an exit code, a diagnostic, an IR dump. Those catch
// a wrong DECISION. They cannot catch a section header with the wrong RVA, a raw data pointer off
// by one file alignment, or an image the writer padded where it meant to write: the compiler is
// perfectly happy, the IR is perfectly right, and the bytes on disk are wrong. Reading the PE back
// is the one gate that sees that layer, which is exactly why `specs/static-variables.md` pins its
// six layouts this way rather than as an IR block.
//
// A faithful port of `maxon-sharp/Testing/TestRunner.cs`'s `ParsePeSections` / `ReadPeSectionData`
// / `ParseTypedSectionValues`. It is deliberately a SEPARATE reader from `Targets/Windows/
// PeWriter.maxon` and not a shared codec: a gate that formatted the bytes with the very code that
// wrote them could only ever prove the writer agrees with itself. The duplication is the test — an
// independent reading is the only kind that can disagree.
//
// That argument is about the WRITER, and it does not reach the little-endian arithmetic underneath:
// `imageReadU16` and friends come from `BinaryImageReader`, shared with the Mach-O and ELF readers.
// See that file's header — three copies of "byte n+1 is the high half" cannot catch a writer bug one
// copy would miss, they can only drift.

// The section a top-level `var`'s image lives in. Named here rather than inlined at the call site
// because it is a contract with `PeWriter.writeSectionHeader`, not a string.
export let DataSectionName = ".data"

// --- PE structural constants (the reader's own; see the header on why they are not shared) ---

// "MZ" — the DOS header's magic, at file offset 0.
let DosHeaderMagic = 0x5A4D

// Where the DOS header stores the file offset of the PE signature.
let PeSignatureOffsetField = 0x3C

// "PE\0\0".
let PeSignature = 0x00004550

// COFF header field offsets, measured from the PE signature's end.
let CoffNumberOfSectionsOffset = 2
let CoffSizeOfOptionalHeaderOffset = 16
let CoffHeaderSize = 20

// One IMAGE_SECTION_HEADER is 40 bytes; its fields sit at these offsets within it.
let SectionHeaderSize = 40
let SectionNameBytes = 8
let SectionVirtualSizeOffset = 8
let SectionRawSizeOffset = 16
let SectionRawPointerOffset = 20

// Why a PE could not be read. A union rather than an empty-array sentinel: "this exe has no .data
// section" and "this exe's .data section is empty" are different facts, and a spec pinning an empty
// layout must be able to tell them apart.
export union PeReadError implements Error
	unreadable(path FilePath)
	notAPeFile(path FilePath)
	sectionMissing(path FilePath, sectionName String)
	truncated(path FilePath, sectionName String)

	/// Human-readable rendering, following `SubprocessError.displayReason`'s convention so every
	/// spec-runner failure reads the same way whatever went wrong.
	export function displayReason() returns String
		return match self 'k'
			unreadable(path) gives "cannot open {path.toString()}"
			notAPeFile(path) gives "{path.toString()} is not a PE image (bad MZ/PE signature)"
			sectionMissing(path, sectionName) gives "{path.toString()} has no {sectionName} section"
			truncated(path, sectionName) gives "{path.toString()}'s {sectionName} section runs past the end of the file"
		end 'k'
	end 'displayReason'
end 'PeReadError'

// Why a ```RequiredData block could not be turned into bytes.
export union TypedValueError implements Error
	missingValue(line String)
	unknownType(typeName String)
	badNumber(typeName String, text String)

	export function displayReason() returns String
		return match self 'k'
			missingValue(line) gives "line '{line}' is not `<type> <value>`"
			unknownType(typeName) gives "unknown type '{typeName}' (expected i8/i16/i32/i64/f64)"
			badNumber(typeName, text) gives "'{text}' is not a valid {typeName}"
		end 'k'
	end 'displayReason'
end 'TypedValueError'

// The bytes of `sectionName` in the PE at `path`.
//
// It reads VIRTUAL size, not raw size, and the distinction is the whole reason a reader can catch
// a writer bug: raw size is FILE-ALIGNED (rounded up to 512 and zero-padded), so comparing against
// it would compare a spec's four bytes against 512 and drown the answer in padding. Virtual size is
// what the image actually contains. `min` of the two guards a malformed header claiming more
// virtual than it stored.
export function readPeSectionData(path FilePath, sectionName String) returns ByteArray throws PeReadError
	let image = try File.readBinary(path) otherwise throw PeReadError.unreadable(path)

	if imageReadU16(image, at: 0) != DosHeaderMagic 'notDos'
		throw PeReadError.notAPeFile(path)
	end 'notDos'

	let peOffset = imageReadU32(image, at: PeSignatureOffsetField)
	if imageReadU32(image, at: peOffset) != PeSignature 'notPe'
		throw PeReadError.notAPeFile(path)
	end 'notPe'

	let coffStart = peOffset + 4
	let sectionCount = imageReadU16(image, at: coffStart + CoffNumberOfSectionsOffset)
	let optionalHeaderSize = imageReadU16(image, at: coffStart + CoffSizeOfOptionalHeaderOffset)
	let firstSectionHeader = coffStart + CoffHeaderSize + optionalHeaderSize

	for i in 0 upto sectionCount 'eachSection'
		let header = firstSectionHeader + i * SectionHeaderSize
		if imageNameAt(image, at: header, maxBytes: SectionNameBytes) != sectionName 'notThisOne'
			continue
		end 'notThisOne'

		let virtualSize = imageReadU32(image, at: header + SectionVirtualSizeOffset)
		let rawSize = imageReadU32(image, at: header + SectionRawSizeOffset)
		let rawPointer = imageReadU32(image, at: header + SectionRawPointerOffset)
		let size = virtualSize if virtualSize < rawSize else rawSize

		if not imageRangeFits(image, start: rawPointer, count: size) 'runsPastEof'
			throw PeReadError.truncated(path, sectionName: sectionName)
		end 'runsPastEof'

		return imageSlice(image, start: rawPointer, count: size)
	end 'eachSection'

	throw PeReadError.sectionMissing(path, sectionName: sectionName)
end 'readPeSectionData'

// ⭐ Parse a ```RequiredData block — `<type> <value>` per line — into the bytes it claims.
// Little-endian, matching both the x64 image and the reference's `BitConverter.GetBytes`.
//
// Blank lines are skipped, exactly as the reference's `StringSplitOptions.RemoveEmptyEntries` does.
//
// It covers `i8`/`i16`/`i32`/`i64` and `f64` — the reference additionally parses `f32`, `u16` and
// `i64[]`, and those are DELIBERATELY absent rather than stubbed: an array global needs P1.7 and
// Maxon's `float` is f64 so nothing produces an f32, which makes a spec using either a spec shv2
// cannot compile anyway. An unknown type THROWS (naming it), which is what keeps this honest — the
// failure of the block this gate replaces was precisely that an unhandled thing passed silently.
//
// ⭐ `f64` ARRIVED WITH P1.0d.4, WHICH IS WHAT THIS COMMENT SAID IT WAS WAITING FOR. It was shelved
// because a float global could not be compiled at all; it can now, and the two `data-section-f64-*`
// cases that were parked behind it are the gate on the eight bytes `3.14` actually lays down.
export function parseTypedSectionValues(block String) returns ByteArray throws TypedValueError
	var out = ByteArray.create()
	for rawLine in block.split("\n") 'eachLine'
		let line = rawLine.trim()
		if line.isEmpty() 'blank'
			continue
		end 'blank'

		let sepIdx = try line.findFirst(" ") otherwise throw TypedValueError.missingValue(line)
		let typeName = line.slice(line.startIndex(), endIndex: sepIdx)
		let valueStart = try line.indexAfter(sepIdx) otherwise throw TypedValueError.missingValue(line)
		let valueText = line.slice(valueStart, endIndex: line.endIndex()).trim()

		// The WIDTH first, so an unknown type is reported as one rather than as whatever its value
		// failed to parse as.
		let byteCount = try typedValueByteCount(typeName)
		appendLittleEndian(out, value: try parseTypedValueBits(typeName, text: valueText), byteCount: byteCount)
	end 'eachLine'

	return out
end 'parseTypedSectionValues'

// The type name whose value is a FLOAT literal rather than an integer one. Named because two
// places ask it — the width and the parse — and they must agree.
let F64TypeName = "f64"

// The BITS of one line's value, little-endian-ready.
//
// ⭐ AN `f64` GOES THROUGH THE COMPILER'S OWN LITERAL PARSER, and that is the whole point of this
// gate rather than an implementation detail of it: a spec writes `f64 3.14` in the SAME spelling
// the source writes `3.14`, so the bytes this expects have to be the bytes that literal MEANS.
// Re-deriving them here — a second opinion about what `3.14` is, rounding and all — would let the
// gate and the compiler agree on a wrong answer, or disagree on a right one. `int.fromString`
// cannot read it at all, which is the reported reason these two cases sat disabled.
function parseTypedValueBits(typeName String, text String) returns ParsedInt throws TypedValueError
	if typeName == F64TypeName 'float'
		return try parseFloatBits(text.toByteArray()) otherwise throw TypedValueError.badNumber(typeName, text: text)
	end 'float'
	return try int.fromString(text) otherwise throw TypedValueError.badNumber(typeName, text: text)
end 'parseTypedValueBits'

// The byte width of a `RequiredData` type name.
function typedValueByteCount(typeName String) returns ByteCount throws TypedValueError
	if typeName == "i8" 'i8'
		return 1
	end 'i8'
	if typeName == "i16" 'i16'
		return 2
	end 'i16'
	if typeName == "i32" 'i32'
		return 4
	end 'i32'
	if typeName == "i64" 'i64'
		return 8
	end 'i64'
	if typeName == F64TypeName 'f64'
		return 8
	end 'f64'

	throw TypedValueError.unknownType(typeName)
end 'typedValueByteCount'

function appendLittleEndian(out ByteArray, value ParsedInt, byteCount ByteCount)
	// The value is SIGNED and the shift-and-mask is defined on the unsigned word, so it crosses
	// once, explicitly, here — the same cast `GlobalDataTable.appendScalar` makes for the same
	// reason, in the code this gate exists to check independently.
	let bits = value as MachineWord
	for i in 0 upto byteCount 'eachByte'
		out.push((bits shr (i * 8)) and 0xFF)
	end 'eachByte'
end 'appendLittleEndian'

// --- Hex rendering for a mismatch message ---
//
// A `.data` mismatch is a BYTE-level failure, so it is reported in bytes: "expected 2a 00 00 00 00
// 00 00 00, got 00 00 …" is a diff a reader can act on, where "the layout differs" is not.

export function formatHexBytes(bytes ByteArray) returns String
	var out = StringBuilder.create()
	for (iter, b) in bytes.withIterator() 'each'
		if iter.index() > 0 'separator'
			out.append(" ")
		end 'separator'
		out.append(hexByte(b))
	end 'each'
	return out.build()
end 'formatHexBytes'

export function hexByte(b MachineWord) returns String
	return "{hexDigit((b shr 4) and 0xF)}{hexDigit(b and 0xF)}"
end 'hexByte'

// One lowercase hex digit. A `ByteArray` lookup rather than a `String` index: the digits are ASCII
// bytes and `String.from` of a one-byte array is the shortest honest route to a one-character
// String in a language whose String is UTF-8 and whose indices are byte positions.
function hexDigit(nibble MachineWord) returns String
	let digits = b"0123456789abcdef"
	var one = ByteArray.create()
	one.push(try digits.get(nibble) otherwise panic("hexDigit: nibble {nibble} is out of range — every caller masks with 0xF"))
	return String.from(one)
end 'hexDigit'
