// Testing/PeSectionReader.maxon — read a named section's bytes back out of a linked PE, and parse
// a spec's ```RequiredData block into the bytes it claims.
//
// **THIS IS THE SPEC SUITE'S ONLY LOOK AT WHAT WAS ACTUALLY LINKED.** Every other gate reads
// something the compiler produced ON PURPOSE — an exit code, a diagnostic, an IR dump. Those catch
// a wrong DECISION. They cannot catch a section header with the wrong RVA, a raw data pointer off
// by one file alignment, or an image the writer padded where it meant to write: the compiler is
// perfectly happy, the IR is perfectly right, and the bytes on disk are wrong. Reading the PE back
// is the one gate that sees that layer, which is exactly why `specs/static-variables.md` pins its
// six layouts this way rather than as an IR block.
//
// A faithful port of `maxon-sharp/Testing/TestRunner.cs`'s `ParsePeSections` / `ReadPeSectionData`
// / `ParseTypedSectionValues`. It is deliberately a SEPARATE reader from `Targets/Windows/
// PeWriter.maxon` and not a shared codec: a gate that formatted the bytes with the very code that
// wrote them could only ever prove the writer agrees with itself. The duplication is the test — an
// independent reading is the only kind that can disagree.
//
// That argument is about the WRITER, and it does not reach the little-endian arithmetic underneath:
// `imageReadU16` and friends come from `BinaryImageReader`, shared with the Mach-O and ELF readers.
// See that file's header — three copies of "byte n+1 is the high half" cannot catch a writer bug one
// copy would miss, they can only drift.

// What a PE calls each section a spec can pin. Named here rather than inlined at the call site
// because they are a contract with `PeWriter.writeSectionHeader`, not strings.
let DataSectionName = ".data"
let RdataSectionName = ".rdata"

// The PE spelling of a `LinkedSectionKind` — this format's half of the one name table
// `LinkedSection.linkedSectionName` reads. Exhaustive, so a third section cannot be added to the
// kind without a PE name for it.
export function peSectionName(section LinkedSectionKind) returns String
	return match section 'k'
		globals gives DataSectionName
		readOnly gives RdataSectionName
	end 'k'
end 'peSectionName'

// --- PE structural constants (the reader's own; see the header on why they are not shared) ---

// "MZ" — the DOS header's magic, at file offset 0.
let DosHeaderMagic = 0x5A4D

// Where the DOS header stores the file offset of the PE signature.
let PeSignatureOffsetField = 0x3C

// "PE\0\0".
let PeSignature = 0x00004550

// COFF header field offsets, measured from the PE signature's end.
let CoffNumberOfSectionsOffset = 2
let CoffSizeOfOptionalHeaderOffset = 16
let CoffHeaderSize = 20

// One IMAGE_SECTION_HEADER is 40 bytes; its fields sit at these offsets within it.
let SectionHeaderSize = 40
let SectionNameBytes = 8
let SectionVirtualSizeOffset = 8
let SectionRawSizeOffset = 16
let SectionRawPointerOffset = 20

// Why a PE could not be read. A union rather than an empty-array sentinel: "this exe has no .data
// section" and "this exe's .data section is empty" are different facts, and a spec pinning an empty
// layout must be able to tell them apart.
export union PeReadError implements Error
	unreadable(path FilePath)
	notAPeFile(path FilePath)
	sectionMissing(path FilePath, sectionName String)
	truncated(path FilePath, sectionName String)

	/// Human-readable rendering, following `SubprocessError.displayReason`'s convention so every
	/// spec-runner failure reads the same way whatever went wrong.
	export function displayReason() returns String
		return match self 'k'
			unreadable(path) gives "cannot open {path.toString()}"
			notAPeFile(path) gives "{path.toString()} is not a PE image (bad MZ/PE signature)"
			sectionMissing(path, sectionName) gives "{path.toString()} has no {sectionName} section"
			truncated(path, sectionName) gives "{path.toString()}'s {sectionName} section runs past the end of the file"
		end 'k'
	end 'displayReason'
end 'PeReadError'

// ⭐⭐ **WHAT A SECTION PIN CLAIMS — AND THE TWO SPELLINGS CLAIM DIFFERENT THINGS.** The distinction is
// about what a line NAMES, not about convenience:
//
//   • a SCALAR or ARRAY line (`i64 42`, `u8[] 0, 1, 2`) describes FIELDS OF ONE PAYLOAD. Several such
//     lines are one blob written across several lines, so their bytes are contiguous BY CONSTRUCTION and
//     the claim includes where that blob sits — compared as a run from byte 0.
//   • a `utf8` line names ONE INTERNED STRING BLOB: a separately-registered payload with its own label,
//     which the table is free to place anywhere. Two such blobs being ADJACENT is not a property of the
//     language, the compiler or the program — it is an artifact of what else happened to register between
//     them — so pinning it would be pinning the artifact. Each is located independently, in order.
//
// ⛔ **A BLOCK MAY NOT MIX THEM**, and that is a REFUSAL rather than a guess: the two forms disagree about
// whether a block's lines are one payload or many, so a mixed block has no meaning to compute. Guessing one
// is the "reads as coverage, pins nothing" shape this file refuses everywhere else.
export union SectionPinExpectation
	// One payload, compared as a run from byte 0 — see `compareSectionPrefix` for why a PREFIX and not an
	// equality.
	contiguousRun(bytes ByteArray)
	// N independently-placed blobs, each found at or after the end of the previous one.
	locatedPayloads(payloads ByteArrayArray)
end 'SectionPinExpectation'

// Why a ```RequiredData block could not be turned into bytes.
export union TypedValueError implements Error
	missingValue(line String)
	unknownType(typeName String)
	badNumber(typeName String, text String)
	unquotedText(typeName String, text String)
	unknownEscape(escape String)
	mixedPinForms
	emptyTextPayload

	export function displayReason() returns String
		return match self 'k'
			missingValue(line) gives "line '{line}' is not `<type> <value>`"
			unquotedText(typeName, text) gives "a {typeName} value is a DOUBLE-QUOTED string, and '{text}' is not one"
			unknownEscape(escape) gives "unknown escape sequence '{escape}' in a {Utf8TypeName} value"
			emptyTextPayload gives "a `{Utf8TypeName}` line decodes to NO bytes, which pins nothing — the empty run occurs in every image ever linked, so the line could not fail. Give it the payload it means, or delete it"
			mixedPinForms gives "the block mixes `{Utf8TypeName}` lines with scalar/array lines, and the two cannot be combined — a `{Utf8TypeName}` line names ONE interned blob and is located independently, while scalar and array lines describe fields of a SINGLE payload compared from byte 0, so a mixed block does not say whether its lines are one payload or several. Write them as separate blocks"
			// ⚠ **THE ROSTER IS BUILT FROM THE TABLE, NOT TRANSCRIBED BESIDE IT.** A spec author reading this
			// message needs to know which names exist, and it said `i8/i16/i32/i64/f64` for as long as `u8`
			// had been accepted — a stale list is worse than none, because it reads as an authority. So the
			// sentence is joined from `TypedValueTypes`, the same rows `typedValueByteCount` walks: add a
			// width there and this message says so, which a second hand-kept list could not promise.
			unknownType(typeName) gives "unknown type '{typeName}' (expected {typedValueTypeRoster()}, each also as an array: `u8[] 1, 2, 3`)"
			badNumber(typeName, text) gives "'{text}' is not a valid {typeName}"
		end 'k'
	end 'displayReason'
end 'TypedValueError'

// The bytes of `sectionName` in the PE at `path`.
//
// It reads VIRTUAL size, not raw size, and the distinction is the whole reason a reader can catch
// a writer bug: raw size is FILE-ALIGNED (rounded up to 512 and zero-padded), so comparing against
// it would compare a spec's four bytes against 512 and drown the answer in padding. Virtual size is
// what the image actually contains. `min` of the two guards a malformed header claiming more
// virtual than it stored.
export function readPeSectionData(path FilePath, sectionName String) returns ByteArray throws PeReadError
	let image = try File.readBinary(path) otherwise throw PeReadError.unreadable(path)

	if imageReadU16(image, at: 0) != DosHeaderMagic 'notDos'
		throw PeReadError.notAPeFile(path)
	end 'notDos'

	let peOffset = imageReadU32(image, at: PeSignatureOffsetField)
	if imageReadU32(image, at: peOffset as ByteOffset) != PeSignature 'notPe'
		throw PeReadError.notAPeFile(path)
	end 'notPe'

	let coffStart = peOffset + 4
	let sectionCount = imageReadU16(image, at: ((coffStart + CoffNumberOfSectionsOffset) as ByteOffset))
	let optionalHeaderSize = imageReadU16(image, at: ((coffStart + CoffSizeOfOptionalHeaderOffset) as ByteOffset))
	let firstSectionHeader = coffStart + CoffHeaderSize + optionalHeaderSize

	for i in 0 upto sectionCount 'eachSection'
		let header = firstSectionHeader + i * SectionHeaderSize
		if imageNameAt(image, at: header as ByteOffset, maxBytes: SectionNameBytes) != sectionName 'notThisOne'
			continue
		end 'notThisOne'

		let virtualSize = imageReadU32(image, at: ((header + SectionVirtualSizeOffset) as ByteOffset))
		let rawSize = imageReadU32(image, at: ((header + SectionRawSizeOffset) as ByteOffset))
		let rawPointer = imageReadU32(image, at: ((header + SectionRawPointerOffset) as ByteOffset))
		let size = virtualSize if virtualSize < rawSize else rawSize

		if not imageRangeFits(image, start: rawPointer as ByteOffset, count: size as BytePos) 'runsPastEof'
			throw PeReadError.truncated(path, sectionName: sectionName)
		end 'runsPastEof'

		return imageSlice(image, start: rawPointer as ByteOffset, count: size as BytePos)
	end 'eachSection'

	throw PeReadError.sectionMissing(path, sectionName: sectionName)
end 'readPeSectionData'

// ⭐ Parse a ```RequiredData block — `<type> <value>` per line — into the bytes it claims.
// Little-endian, matching both the x64 image and the reference's `BitConverter.GetBytes`.
//
// Blank lines are skipped, exactly as the reference's `StringSplitOptions.RemoveEmptyEntries` does.
//
// It covers both signs at every integer width and `f64` (see `typedValueByteCount` for the roster).
// `f32` is the one type the reference parses and this does not, DELIBERATELY rather than stubbed: Maxon's
// `float` IS f64, so nothing this compiler emits produces an f32 and a spec pinning one could not be
// compiled anyway. An unknown type THROWS (naming it), which is what keeps this honest — the failure of the
// block this gate replaces was precisely that an unhandled thing passed silently.
//
// ⚠ **`u16`/`u32` ARRIVED WITH `enum-narrow-storage`, whose ladder writes them** (`u16[] 100, 1000, 10000`).
// Before it, an unpinnable width was reported as a MALFORMED PIN rather than as a byte mismatch — which is
// the right failure, and is why the two cases needing them failed differently from the four that did not.
//
// ⭐ `f64` ARRIVED WITH P1.0d.4, WHICH IS WHAT THIS COMMENT SAID IT WAS WAITING FOR. It was shelved
// because a float global could not be compiled at all; it can now, and the two `data-section-f64-*`
// cases that were parked behind it are the gate on the eight bytes `3.14` actually lays down.
export function parseTypedSectionValues(block String) returns SectionPinExpectation throws TypedValueError
	var out = ByteArray.create()
	var payloads = ByteArrayArray.create()
	// Tracked rather than inferred from `out.count()`: an array line with no elements contributes zero
	// bytes, and "a scalar line was written" is the question the mixed-form refusal asks.
	var sawFieldLine = false
	for rawLine in block.split("\n") 'eachLine'
		let line = rawLine.trim()
		if line.isEmpty() 'blank'
			continue
		end 'blank'

		let sepIdx = try line.findFirst(" ") otherwise throw TypedValueError.missingValue(line)
		let typeName = line.slice(line.startIndex(), endIndex: sepIdx)
		let valueStart = try line.indexAfter(sepIdx) otherwise throw TypedValueError.missingValue(line)
		let valueText = line.slice(valueStart, endIndex: line.endIndex()).trim()

		// ⭐ **AN `[]` SUFFIX MAKES THE LINE A COMMA-SEPARATED RUN OF THAT TYPE** — `u8[] 33, 243, 8` is
		// three bytes, laid down in order. It is a suffix on the existing type rather than a separate
		// spelling so the element width, the value parse and the little-endian append are the SAME three
		// functions a scalar line uses; the only thing an array adds is how many times they run.
		//
		// ⭐ **IT ARRIVED WITH `ranged-int-bit-packing`, WHICH IS WHAT THIS FILE'S HEADER SAID IT WAS
		// WAITING FOR.** The reference parses `i64[]` and shv2 deliberately did not, on the recorded
		// argument that an array global needed P1.7. A packed array literal's `.rdata` blob is now a RUN OF
		// BYTES with no scalar spelling at all — `[0 as Q, 1 as Q, 2 as Q, 3 as Q]` at 2 bits is the single
		// byte `0b11_10_01_00` — and pinning it byte-for-byte is the only way a spec can prove the bit
		// ORDER and the `ceil(count·bits/8)` sizing rather than merely the values that read back out.
		// ⭐ **`utf8 "…"` IS A LINE OF TEXT, NOT A WIDTH** — the one spelling in the notation whose length
		// comes from the VALUE rather than from the type name, which is why it branches ahead of the width
		// lookup instead of taking a row in `typedValueTypes`. A string literal's `.rdata` blob is the bytes
		// of its source text plus the NUL the compiler appends, and `\0` is how a pin says that NUL —
		// `specs/codegen-internals.md`'s six string cases are the whole of its use in the canonical corpus.
		if typeName == Utf8TypeName 'aTextPayload'
			payloads.push(try utf8PinBytes(valueText))
			continue
		end 'aTextPayload'

		sawFieldLine = true
		let elementType = arrayElementTypeName(typeName)
		let byteCount = try typedValueByteCount(elementType)
		if elementType == typeName 'oneScalarValue'
			appendLittleEndian(out, value: try parseTypedValueBits(typeName, text: valueText), byteCount: byteCount)
			continue
		end 'oneScalarValue'

		for rawElement in valueText.split(TypedValueArraySeparator) 'eachElement'
			let element = rawElement.trim()
			if element.isEmpty() 'trailingSeparator'
				continue
			end 'trailingSeparator'

			appendLittleEndian(out, value: try parseTypedValueBits(elementType, text: element), byteCount: byteCount)
		end 'eachElement'
	end 'eachLine'

	// ⛔ The two forms answer "is this block one payload or several?" differently, so a block written in both
	// answers it twice. Refused by name rather than resolved — see `SectionPinExpectation`.
	if sawFieldLine and payloads.count() > 0 'mixedForms'
		throw TypedValueError.mixedPinForms
	end 'mixedForms'

	if payloads.count() > 0 'everyLineNamedABlob'
		return SectionPinExpectation.locatedPayloads(payloads)
	end 'everyLineNamedABlob'

	return SectionPinExpectation.contiguousRun(out)
end 'parseTypedSectionValues'

// Where a payload sits in a section, or that it is not there at all. A union rather than a `-1`: "found at
// offset 0" and "absent" are different answers and a sentinel would let the first read as the second.
export union SectionPayloadMatch
	found(offset ByteOffset)
	absent
end 'SectionPayloadMatch'

// ⭐ The first occurrence of `needle` in `haystack` at or after `from`. Plain byte-by-byte scan: a section
// is kilobytes and a pin has a handful of payloads, so the scan is not worth an index.
//
// An EMPTY needle answers `found(from)` — the empty run does occur, everywhere. It is unreachable from a pin
// (`SpecParser` refuses an empty block and a `utf8 ""` line still carries no bytes only if a spec writes
// one), and answering `absent` for it would be the wrong sentence about a real question.
export function findByteRun(haystack ByteArray, needle ByteArray, from ByteOffset) returns SectionPayloadMatch
	if needle.count() == 0 'theEmptyRunIsEverywhere'
		return SectionPayloadMatch.found(from)
	end 'theEmptyRunIsEverywhere'

	if needle.count() > haystack.count() 'longerThanTheSection'
		return SectionPayloadMatch.absent
	end 'longerThanTheSection'

	for start in from upto haystack.count() - needle.count() + 1 'eachStart'
		if byteRunMatchesAt(haystack, needle: needle, start: start) 'thisOne'
			return SectionPayloadMatch.found(start)
		end 'thisOne'
	end 'eachStart'

	return SectionPayloadMatch.absent
end 'findByteRun'

// Does `needle` sit at exactly `start`? The caller's bound guarantees the window fits, which is why both
// reads panic rather than answering false — a miss here would be an index error wearing a mismatch's clothes.
function byteRunMatchesAt(haystack ByteArray, needle ByteArray, start ByteOffset) returns bool
	for i in 0 upto needle.count() 'eachByte'
		let want = try needle.get(i) otherwise panic("byteRunMatchesAt: needle.get OOB at {i} despite the upto bound")
		let got = try haystack.get(start + i) otherwise panic("byteRunMatchesAt: haystack.get OOB at {start + i} — the caller's bound keeps the window inside the section")
		if want != got 'differs'
			return false
		end 'differs'
	end 'eachByte'

	return true
end 'byteRunMatchesAt'

// What separates the elements of an array line, and what marks a type name as one. Named together
// because they are one notation and a reader deciding whether `u8[] 1, 2` is an array reads both.
let TypedValueArraySuffix = "[]"
let TypedValueArraySeparator = ","

// The ELEMENT type a line's type name describes — `u8` for `u8[]`, and the name itself for a scalar.
// Returning the name unchanged for a scalar is what lets the caller tell the two apart with one
// comparison instead of a second `endsWith` test that could disagree with this one.
function arrayElementTypeName(typeName String) returns String
	if not typeName.endsWith(TypedValueArraySuffix) 'aScalar'
		return typeName
	end 'aScalar'

	return typeName.slice(typeName.startIndex(), length: typeName.count() - TypedValueArraySuffix.count())
end 'arrayElementTypeName'

// The type name whose value is a FLOAT literal rather than an integer one. Named because two
// places ask it — the width and the parse — and they must agree.
let F64TypeName = "f64"

// --- `utf8 "…"`: the one pin spelling whose LENGTH comes from its value ---

// The type name a text payload is written under. It has no row in `typedValueTypes` on purpose: that
// table answers a WIDTH, and this line's width is however many bytes its string decodes to.
let Utf8TypeName = "utf8"

// A `utf8` value is a double-quoted string; the shortest legal one is the empty `""`.
let QuoteMark = "\""
let ShortestQuotedValue = 2 as BytePos

// ⭐ **THE BYTES A `utf8` PIN CLAIMS — a SECOND escape decoder, and this file's header is the argument
// for it.** `Parser.decodeEscapes` turns a SOURCE literal into the bytes the compiler then lays down; if
// this gate resolved the pin's escapes through that same function, a bug in it would move the expectation
// and the image together and the pin could never see it. Reading independently is the only reading that
// can disagree, which is the whole reason this reader is not the writer's codec.
//
// ⚠ It stays SMALL by covering only what the notation needs — the one-byte escapes. `\xNN` and `\uNNNN`
// are REFUSED BY NAME rather than half-implemented: no canonical pin writes one (`\0` is the only escape
// in the corpus, and only `specs/codegen-internals.md`'s six string cases use the spelling at all), and a
// named refusal is what this file already does with every other thing it cannot express.
function utf8PinBytes(valueText String) returns ByteArray throws TypedValueError
	if valueText.count() < ShortestQuotedValue or not valueText.startsWith(QuoteMark) or not valueText.endsWith(QuoteMark) 'notQuoted'
		throw TypedValueError.unquotedText(Utf8TypeName, text: valueText)
	end 'notQuoted'

	// ⛔ **AN EMPTY PAYLOAD IS A PIN THAT CANNOT FAIL, which is what `rdata-section.md` refuses an empty
	// BLOCK for — the same hole one line down.** `findByteRun` answers `found` for an empty needle, correctly
	// (the empty run does occur, everywhere), so a `utf8 ""` line would pass against every image ever linked
	// and say nothing. Refused here, by name, rather than left to read as coverage.
	if valueText.count() == ShortestQuotedValue 'nothingPinned'
		throw TypedValueError.emptyTextPayload
	end 'nothingPinned'

	let raw = valueText.toByteArray()
	let bodyEnd = raw.count() - 1
	var out = ByteArray.create()
	var i = 1 as ByteOffset
	while i < bodyEnd 'eachByte'
		let ch = try raw.get(i) otherwise panic("utf8PinBytes: i < bodyEnd just held but get({i}) failed")
		if ch != PinBackslash 'aPlainByte'
			out.push(ch)
			i = i + 1
			continue
		end 'aPlainByte'

		if i + 1 >= bodyEnd 'danglingBackslash'
			throw TypedValueError.unknownEscape(pinEscapeText(PinBackslash))
		end 'danglingBackslash'

		let marker = try raw.get(i + 1) otherwise panic("utf8PinBytes: i + 1 < bodyEnd just held but get({i + 1}) failed")
		out.push(try pinEscapeByte(marker))
		i = i + 2
	end 'eachByte'

	return out
end 'utf8PinBytes'

// The escapes a `utf8` pin accepts, in `Parser.escapeByte`'s order and shape: the named control bytes, then
// the self-escapes — a backslash and the delimiters a quoted body must be able to contain.
//
// ⚠ **AN IF-CHAIN AND NOT A TABLE, WHICH MIRRORS THE DECODER IT IS INDEPENDENT OF AND ALLOCATES NOTHING.**
// It was a 9-row `Array` built inside this function, so every escape in every pin constructed the whole
// table to walk it once. The rows carried no data the chain does not; a constant is not worth an allocation,
// and a top-level `let` cannot hold one here (a global initializer may not call a function).
function pinEscapeByte(marker Byte) returns Byte throws TypedValueError
	if marker == LowerNMarker 'newline'
		return NewlineByte
	end 'newline'
	if marker == LowerTMarker 'tab'
		return TabByte
	end 'tab'
	if marker == LowerRMarker 'carriageReturn'
		return CarriageReturnByte
	end 'carriageReturn'
	if marker == DigitZeroMarker 'nul'
		return NulByte
	end 'nul'
	if marker == PinBackslash or marker == SingleQuoteByte or marker == DoubleQuoteByte or marker == LeftBraceByte or marker == RightBraceByte 'selfEscape'
		return marker
	end 'selfEscape'

	throw TypedValueError.unknownEscape(pinEscapeText(marker))
end 'pinEscapeByte'

// How an escape reads back in a diagnostic — the backslash plus what followed it.
function pinEscapeText(marker Byte) returns String
	var text = ByteArray.create()
	text.push(PinBackslash)
	text.push(marker)
	return String.from(text)
end 'pinEscapeText'

// The ASCII bytes the pin decoder recognizes and produces. Named rather than spelled as bare numbers for
// `Parser.maxon`'s reason at its own copy of this table: a decoder of escape syntax cannot define its
// table in the syntax it decodes.
let PinBackslash = 92 as Byte
let SingleQuoteByte = 39 as Byte
let DoubleQuoteByte = 34 as Byte
let LeftBraceByte = 123 as Byte
let RightBraceByte = 125 as Byte
let LowerNMarker = 110 as Byte
let LowerTMarker = 116 as Byte
let LowerRMarker = 114 as Byte
let DigitZeroMarker = 48 as Byte
let NewlineByte = 10 as Byte
let TabByte = 9 as Byte
let CarriageReturnByte = 13 as Byte
let NulByte = 0 as Byte

// The BITS of one line's value, little-endian-ready.
//
// ⭐ AN `f64` GOES THROUGH THE COMPILER'S OWN LITERAL PARSER, and that is the whole point of this
// gate rather than an implementation detail of it: a spec writes `f64 3.14` in the SAME spelling
// the source writes `3.14`, so the bytes this expects have to be the bytes that literal MEANS.
// Re-deriving them here — a second opinion about what `3.14` is, rounding and all — would let the
// gate and the compiler agree on a wrong answer, or disagree on a right one. `int.fromString`
// cannot read it at all, which is the reported reason these two cases sat disabled.
//
// ⭐⭐ **IT REACHES THAT ONE PARSER THROUGH `float.fromString`, NOT THROUGH `__float_bitsFromText`
// DIRECTLY, AND THE DIFFERENCE IS A NAMESPACE RULE RATHER THAN A CONVERSION (G17 defect 3).** The
// reader IS `__float_bitsFromText` either way: `stdlib/Builtins.maxon:276`'s `__float_fromString` is
// nothing but that call plus a `__Builtins.bitsToFloat`, so `floatToBits(float.fromString(t))` is a
// bitcast round trip around the identical bits — exact for a signed zero, a subnormal and a
// 21-significant-digit literal alike, because a bitcast pair cannot round. What the direct spelling
// costs is COMPILABILITY: shv2's `requireCalleeIsNotReservedName` exempts the reserved `__` space only
// for calls made from inside `Builtins.maxon` itself, so this file — user code as far as the compiler
// is concerned — was refused with `E3004`, one of the eight defects between shv2 and its own harness.
// `__Builtins.`-qualified callees short-circuit that check, which is why the second half stays direct.
//
// ⚠ **THE TWO FAILURE ARMS STILL COLLAPSE TO ONE THROW, AND THEY STILL HAVE TO.** `__FloatTextResult`
// distinguishes `overflow` from `malformed`; `ParseError` — which `float.fromString` throws — has the
// single `invalidFormat` arm and may not grow another (an error enum in `stdlib/` is language surface).
// That loses nothing here for the reason the previous shape stated outright: a `RequiredData f64` line
// whose text is not a number is a bad line however it is bad.
//
// ⚠ **AN ACCEPTED, STATED RISK: `float.fromString` SEGFAULTS ON arm64-macOS** (PLAN row `A5b`) while
// answering correctly on every other lane. arm64 is a remote, opt-in, never-blocking lane, so this does
// not gate the change — but the `RequiredData` gate now inherits that defect on that host, knowingly.
function parseTypedValueBits(typeName String, text String) returns ParsedInt throws TypedValueError
	if typeName == F64TypeName 'float'
		let value = try float.fromString(text) otherwise throw TypedValueError.badNumber(typeName, text: text)
		return __Builtins.floatToBits(value)
	end 'float'
	return try int.fromString(text) otherwise throw TypedValueError.badNumber(typeName, text: text)
end 'parseTypedValueBits'

// ⭐⭐ **THE TYPE ROSTER — ONE ROW PER SPELLING A `RequiredData`/`RequiredRdata` LINE MAY USE, AND THE ONLY
// PLACE EITHER THE NAMES OR THE WIDTHS ARE WRITTEN DOWN.** Two readers walk it: `typedValueByteCount`, which
// answers the width, and `typedValueTypeRoster`, which joins the names into the `unknownType` message. It
// existed as two hand-kept lists for one tick and the message was already stale when it was written — it
// promised `i8/i16/i32/i64/f64` while `u8` had been accepted for a rung — which is the shape a table removes.
//
// ⭐ **THE SIGNED AND UNSIGNED SPELLINGS OF ONE WIDTH ARE TWO ROWS, because the width is all this answers.**
// `appendLittleEndian` masks to `byteCount` either way, so `i8 -1` and `u8 255` lay down the same byte —
// what the two names buy is a spelling a spec author can write without lying about the sign of the value
// being pinned. `specs/enum-narrow-storage.md` writes both halves of the ladder (`u8[] 0, 1, 2` beside
// `i8[] -1, 0, 1`), which is what makes the pair a notation rather than a preference.
//
// ⚠ `f64` is a row like any other here — its width is 8 — and only its VALUE parse differs, which
// `parseTypedValueBits` decides by name against `F64TypeName`. `f32` is absent DELIBERATELY: Maxon's `float`
// IS f64, so nothing this compiler emits produces one.
type TypedValueType
	export let name as String
	export let byteCount as BytePos

	export static function create(name String, byteCount BytePos) returns TypedValueType
		return Self{name: name, byteCount: byteCount}
	end 'create'
end 'TypedValueType'

export typealias TypedValueTypeArray = Array with TypedValueType

// The roster itself, in the order the message lists it: narrowest first, signed before unsigned.
function typedValueTypes() returns TypedValueTypeArray
	var rows = TypedValueTypeArray.create()
	rows.push(TypedValueType.create("i8", byteCount: 1))
	rows.push(TypedValueType.create("u8", byteCount: 1))
	rows.push(TypedValueType.create("i16", byteCount: 2))
	rows.push(TypedValueType.create("u16", byteCount: 2))
	rows.push(TypedValueType.create("i32", byteCount: 4))
	rows.push(TypedValueType.create("u32", byteCount: 4))
	rows.push(TypedValueType.create("i64", byteCount: 8))
	rows.push(TypedValueType.create("u64", byteCount: 8))
	rows.push(TypedValueType.create(F64TypeName, byteCount: 8))
	return rows
end 'typedValueTypes'

// The roster's names as the `unknownType` message lists them — the SECOND reader of the table, and the
// reason the table exists at all.
function typedValueTypeRoster() returns String
	var out = StringBuilder.create()
	for (iter, row) in typedValueTypes().withIterator() 'eachRow'
		if iter.index() > 0 'separator'
			out.append("/")
		end 'separator'
		out.append(row.name)
	end 'eachRow'
	return out.build()
end 'typedValueTypeRoster'

// The byte width of a `RequiredData` type name — the FIRST reader of the table.
function typedValueByteCount(typeName String) returns BytePos throws TypedValueError
	for row in typedValueTypes() 'eachRow'
		if row.name == typeName 'thisOne'
			return row.byteCount
		end 'thisOne'
	end 'eachRow'

	throw TypedValueError.unknownType(typeName)
end 'typedValueByteCount'

function appendLittleEndian(out ByteArray, value ParsedInt, byteCount BytePos)
	// The value is SIGNED and the shift-and-mask is defined on the unsigned word, so it crosses
	// once, explicitly, here — the same cast `GlobalDataTable.appendScalar` makes for the same
	// reason, in the code this gate exists to check independently.
	let bits = value as MachineWord
	for i in 0 upto byteCount 'eachByte'
		out.push((bits shr (i * 8)) and 0xFF)
	end 'eachByte'
end 'appendLittleEndian'

// --- Hex rendering for a mismatch message ---
//
// A `.data` mismatch is a BYTE-level failure, so it is reported in bytes: "expected 2a 00 00 00 00
// 00 00 00, got 00 00 …" is a diff a reader can act on, where "the layout differs" is not.
//
// ⚠ **`hexByte`/`hexDigit` LIVE IN THE COMPILER, NOT HERE.** A chunk golden's hex dump
// (`TargetPrinter.printChunkBytes`) is the same rendering one tier down, and this file used to carry
// its own copy of it. The harness may call INTO the compiler and does (`targetToString`,
// `emitsTargetIr`); the compiler may not call out here — so the one spelling sits on the lower side
// and this reads it from there.

export function formatHexBytes(bytes ByteArray) returns String
	var out = StringBuilder.create()
	for (iter, b) in bytes.withIterator() 'each'
		if iter.index() > 0 'separator'
			out.append(" ")
		end 'separator'
		out.append(hexByte(b))
	end 'each'
	return out.build()
end 'formatHexBytes'
