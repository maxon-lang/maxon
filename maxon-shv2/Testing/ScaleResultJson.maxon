// ScaleResultJson — `--result-json=<path>`: the whole run as a structured document.
//
// The MCP tool that drives this instrument must not SCRAPE the report. The report is a padded ASCII
// table whose columns exist to be read by a person, and the day a phase name outgrows its column a
// scrape would silently mis-parse rather than fail — which is exactly the failure mode the metrics
// TSV was introduced to avoid one level down (see MetricsEmit's header). A caller that wants data
// gets data.
//
// THERE IS NO `verdict` FIELD, and there is no `budget` and no `gated`. This suite renders no
// verdict: it reports numbers and their deltas from the last recorded run, and the caller — a person
// or a model — reads them. A field named `verdict` would invite exactly the reflex the whole redesign
// removed: look for the green light, and if it is not green, make it green.
//
// AND THERE IS NO TIME, AND NO EXPONENT. Not `nanos`, not `ms`, not a fitted growth curve, not a
// residual, not a share. The ladder DOUBLES, so the ratio between two rungs IS the growth and a
// consumer can take it from the counts in this document with a division; and wall time is
// machine-dependent, so any number derived from it would say more about what else the box was doing
// than about the compiler. Everything here is bit-for-bit reproducible, which is what makes
// differencing two of these documents mean anything at all.
//
// Shape:
//   {
//     "rungs":  [ { rung, sourceBytes, codeBytes, allocs, frees, bytes,
//                   allocsDelta?, bytesDelta?,        // vs the last logged run; ABSENT if there is none
//                   phases:   [ {name, allocs, frees, bytes} ],
//                   regalloc: [ {name, allocs, frees, bytes} ] } ],
//     "corpus": { grew, minGrowthPermille?, floorPermille, reason? },
//     "previous": { present, date?, note? }
//   }

export function writeResultJson(path String, results RungResultArray, trend LoggedMemory) throws ScaleError
	let target = try FilePath.from(path) otherwise throw ScaleError.reason("'{path}' is not a valid --result-json path")

	var doc = JsonDoc.create()
	var keys = StringArray.create()
	var children = JsonNodeIdArray.create()

	keys.push("rungs")
	children.push(rungsNode(doc, results: results, trend: trend))

	keys.push("corpus")
	children.push(corpusNode(doc, results: results))

	keys.push("previous")
	children.push(previousNode(doc, trend: trend))

	doc.root = doc.add(JsonNode.objectNode(keys, children: children))

	// A FAILURE HERE IS A BROKEN RUN, and it throws.
	//
	// It used to log and return, leaving the process to exit 0 — and the caller that asked for this
	// document is a MACHINE. The MCP tool deletes any stale result file before the run precisely so
	// that its absence is meaningful, then reports `error: scale-test wrote no result document` beside
	// an `exitCode` of 0: two halves of one envelope contradicting each other, with the exit code — the
	// half a script reads — saying everything was fine. A run that was asked for its measurements in a
	// file and could not put them there is a run that broke, exactly as a trend log it cannot write is.
	try File.writeText(target, content: Json.stringifyPrettyNode(doc, root: doc.root)) otherwise throw ScaleError.reason("could not write the result document to {path}")
end 'writeResultJson'

// ===========================================================================================
// Rungs
// ===========================================================================================

function rungsNode(doc JsonDoc, results RungResultArray, trend LoggedMemory) returns JsonNodeId
	var items = JsonNodeIdArray.create()
	for i in 0 upto results.count() 'eachRung'
		let result = try results.get(i) otherwise panic("rungsNode: i < count but results.get({i}) failed")

		var keys = StringArray.create()
		var children = JsonNodeIdArray.create()

		pushNumber(doc, keys: keys, children: children, key: "rung", value: result.rung as JsonFloat)
		pushNumber(doc, keys: keys, children: children, key: "sourceBytes", value: result.sourceBytes as JsonFloat)
		pushNumber(doc, keys: keys, children: children, key: "codeBytes", value: result.codeBytes as JsonFloat)
		addMetricFields(doc, keys: keys, children: children, metric: result.total)

		// The deltas the report prints, so a consumer never has to re-derive them from the log. ABSENT
		// rather than zero when there is nothing to compare against: a zero delta means "identical",
		// which is a strong claim, and it must not be what "no previous run" looks like.
		addMemoryDeltas(doc, keys: keys, children: children, result: result, rung: i, trend: trend)

		// The per-phase breakdown, off the ONE phase enumeration the human table also walks
		// (ScaleTestRunner.scalePhaseSources) — so a phase added to `CompilePhase` appears in the report
		// and in this document together, or in neither.
		var phases = JsonNodeIdArray.create()
		var subs = JsonNodeIdArray.create()
		for source in scalePhaseSources() 'eachPhase'
			let node = metricNode(doc, name: phaseSourceName(source), metric: phaseMetricOf(source, result: result))
			match source 'src'
				compilePhase then phases.push(node)
				regAllocPhase then subs.push(node)
			end 'src'
		end 'eachPhase'

		keys.push("phases")
		children.push(doc.add(JsonNode.arrayNode(phases)))
		keys.push("regalloc")
		children.push(doc.add(JsonNode.arrayNode(subs)))

		items.push(doc.add(JsonNode.objectNode(keys, children: children)))
	end 'eachRung'
	return doc.add(JsonNode.arrayNode(items))
end 'rungsNode'

function addMemoryDeltas(doc JsonDoc, keys StringArray, children JsonNodeIdArray, result RungResult, rung LadderIndex, trend LoggedMemory)
	match trend 'm'
		absent then return
		present(_, _, allocs, bytes) then addLoggedDeltas(doc, keys: keys, children: children, result: result, rung: rung, loggedAllocs: allocs, loggedBytes: bytes)
	end 'm'
end 'addMemoryDeltas'

function addLoggedDeltas(doc JsonDoc, keys StringArray, children JsonNodeIdArray, result RungResult, rung LadderIndex, loggedAllocs AllocCountArray, loggedBytes ByteCountArray)
	let beforeAllocs = try loggedAllocs.get(rung) otherwise 'notLogged'
		// This run climbed further than the logged one. The extra rungs have no past, and saying so by
		// omission is exactly right.
		return
	end 'notLogged'
	let beforeBytes = try loggedBytes.get(rung) otherwise panic("addLoggedDeltas: the two logged columns are the same length — loadScaleTrend refuses a log where they are not")

	pushNumber(doc, keys: keys, children: children, key: "allocsDelta", value: (result.total.allocs as Delta) - beforeAllocs)
	pushNumber(doc, keys: keys, children: children, key: "bytesDelta", value: (result.total.bytes as Delta) - beforeBytes)
end 'addLoggedDeltas'

function metricNode(doc JsonDoc, name String, metric PhaseMetric) returns JsonNodeId
	var keys = StringArray.create()
	var children = JsonNodeIdArray.create()
	keys.push("name")
	children.push(doc.add(JsonNode.stringNode(name)))
	addMetricFields(doc, keys: keys, children: children, metric: metric)
	return doc.add(JsonNode.objectNode(keys, children: children))
end 'metricNode'

// The three numbers a PhaseMetric IS, written by ONE function — so the whole-rung object and the
// per-phase objects cannot drift into carrying different fields for the same measurement.
function addMetricFields(doc JsonDoc, keys StringArray, children JsonNodeIdArray, metric PhaseMetric)
	pushNumber(doc, keys: keys, children: children, key: "allocs", value: metric.allocs)
	pushNumber(doc, keys: keys, children: children, key: "frees", value: metric.frees)
	pushNumber(doc, keys: keys, children: children, key: "bytes", value: metric.bytes)
end 'addMetricFields'

// ===========================================================================================
// The corpus self-check, and what this run is measured against
// ===========================================================================================

// Exposed so a consumer can see the NUMBER rather than trust a flag. `grew: false` is the one
// condition the runner exits non-zero for — the corpus folded away, so nothing was measured — and a
// consumer looking at a set of impossibly tidy numbers deserves to see why they are not to be
// believed.
//
// `minGrowthPermille` is the WEAKEST rung-over-rung growth of emitted code on the ladder, in
// thousandths: 2000 is x2.00, which is what a doubling ladder that really compiles produces. The
// weakest, and not the average, because one rung that folded is one rung that measured nothing, and an
// average would hide it behind five rungs that did not.
function corpusNode(doc JsonDoc, results RungResultArray) returns JsonNodeId
	var keys = StringArray.create()
	var children = JsonNodeIdArray.create()
	pushNumber(doc, keys: keys, children: children, key: "floorPermille", value: (MinCodeGrowthRatio * PermillePerHundredth) as JsonFloat)

	match weakestCodeGrowth(results) 'g'
		noBaseline then addNoGrowthReading(doc, keys: keys, children: children)
		measured(ratio) then addCorpusGrowth(doc, keys: keys, children: children, ratio: ratio)
	end 'g'

	return doc.add(JsonNode.objectNode(keys, children: children))
end 'corpusNode'

// The document reports growth in THOUSANDTHS where ScaleRatio counts in hundredths. One conversion, in
// one place: a consumer that differences two documents wants the extra digit, and a human reading a
// table at a glance does not.
let PermillePerHundredth = 10

// The weakest rung-over-rung growth on the ladder — the rung most likely to have folded.
function weakestCodeGrowth(results RungResultArray) returns GrowthReading
	var weakest = GrowthReading.noBaseline

	for i in 1 upto results.count() 'eachRung'
		match codeGrowthAt(results, rung: i) 'h'
			noBaseline then continue
			measured(ratio) then weakest = weakerOf(weakest, ratio: ratio)
		end 'h'
	end 'eachRung'

	return weakest
end 'weakestCodeGrowth'

function weakerOf(current GrowthReading, ratio GrowthRatio) returns GrowthReading
	match current 'c'
		noBaseline then return GrowthReading.measured(ratio)
		measured(soFar) then return GrowthReading.measured(minRatio(soFar, other: ratio))
	end 'c'
end 'weakerOf'

function minRatio(one GrowthRatio, other GrowthRatio) returns GrowthRatio
	if other < one 'smaller'
		return other
	end 'smaller'

	return one
end 'minRatio'

// A one-rung ladder. NOTHING GREW, because nothing had anything to grow from — which is a different
// claim from "the corpus folded away", and the runner does not fail the run for it either: `--rungs=1`
// is a legal thing to ask for, and its counts are as exact as any other run's.
function addNoGrowthReading(doc JsonDoc, keys StringArray, children JsonNodeIdArray)
	keys.push("grew")
	children.push(doc.add(JsonNode.boolNode(false)))
	keys.push("reason")
	children.push(doc.add(JsonNode.stringNode("a ladder of one rung has nothing below it to have grown from — a growth reading needs {MinRungsForGrowth} rungs")))
end 'addNoGrowthReading'

function addCorpusGrowth(doc JsonDoc, keys StringArray, children JsonNodeIdArray, ratio GrowthRatio)
	pushNumber(doc, keys: keys, children: children, key: "minGrowthPermille", value: (ratio * PermillePerHundredth) as JsonFloat)
	keys.push("grew")
	children.push(doc.add(JsonNode.boolNode(ratio >= MinCodeGrowthRatio)))
end 'addCorpusGrowth'

// Which recorded run every delta above is a delta FROM. Without it the deltas are unattributed, and a
// consumer comparing two result documents could not tell they had different reference points.
function previousNode(doc JsonDoc, trend LoggedMemory) returns JsonNodeId
	match trend 'm'
		absent then return noPreviousNode(doc)
		present(date, note, _, _) then return previousRunNode(doc, date: date, note: note)
	end 'm'
end 'previousNode'

function noPreviousNode(doc JsonDoc) returns JsonNodeId
	var keys = StringArray.create()
	var children = JsonNodeIdArray.create()
	keys.push("present")
	children.push(doc.add(JsonNode.boolNode(false)))
	return doc.add(JsonNode.objectNode(keys, children: children))
end 'noPreviousNode'

function previousRunNode(doc JsonDoc, date String, note String) returns JsonNodeId
	var keys = StringArray.create()
	var children = JsonNodeIdArray.create()
	keys.push("present")
	children.push(doc.add(JsonNode.boolNode(true)))
	keys.push("date")
	children.push(doc.add(JsonNode.stringNode(date)))
	keys.push("note")
	children.push(doc.add(JsonNode.stringNode(note)))
	return doc.add(JsonNode.objectNode(keys, children: children))
end 'previousRunNode'

// ===========================================================================================
// The one place a key and its value are appended
// ===========================================================================================

// `keys` and `children` are PARALLEL arrays that `JsonNode.objectNode` zips, so a push to one without
// the other silently shifts every field after it — a document whose values belong to the wrong names.
// Every number in this document goes through here.
function pushNumber(doc JsonDoc, keys StringArray, children JsonNodeIdArray, key String, value JsonFloat)
	keys.push(key)
	children.push(doc.add(JsonNode.numberNode(value)))
end 'pushNumber'
