// `--list` prints the roster and compiles nothing, so nothing here is ever built or run. The two
// tests would both pass if they were — a roster that quietly ran what it listed would then be
// invisible in the exit code, so the expectation has to catch it in the OUTPUT.
typealias Tally = int(0 to i64.max)

function twice(n Tally) returns Tally
	return n * 2
end 'twice'

test 'doubling one gives two'
	try Expect.equal(twice(1), expected: 2)
end 'doubling one gives two'

test 'doubling zero gives zero'
	try Expect.equal(twice(0), expected: 0)
end 'doubling zero gives zero'
