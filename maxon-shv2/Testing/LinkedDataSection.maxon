// Testing/LinkedDataSection.maxon — read the top-level-`var` storage section out of a linked test
// binary, whichever executable format the TARGET produces.
//
// The `.data` gate (`SpecTestRunner.checkRequiredData`) asks one question — "what bytes did the
// linker actually lay down for this program's globals?" — and three formats answer it: PE `.data`,
// Mach-O `__DATA,__data`, ELF `.data`. This file is the seam between that one question and those
// three readers, and it holds nothing else: every byte of format knowledge lives in
// `PeSectionReader` / `MachoSectionReader` / `ElfSectionReader`.
//
// ⚠ IT DISPATCHES ON THE TARGET, NOT THE HOST. It used to key off `detectHostTarget()`, which was
// true only while the runner exclusively inspected binaries built for its own host. A cross-native
// run (`--target=arm64-linux` from an arm64-macOS host) breaks that assumption outright: the file on
// disk is an ELF and the host is macOS, so a host-keyed dispatch would parse an ELF as a Mach-O and
// report `notAMachoFile` for a perfectly good image. The FORMAT is a property of what was BUILT.

// A read failure from whichever executable format the target produces, joined so the one `.data`-gate
// call site (`SpecTestRunner.compareDataSection`) catches a single type. It exists only to unify
// three independent format readers under one `throws`; each arm delegates rendering to the reader
// that raised it, so a failure reads the same way whichever format it came from.
export union DataSectionReadError implements Error
	pe(inner PeReadError)
	macho(inner MachoReadError)
	elf(inner ElfReadError)

	export function displayReason() returns String
		return match self 'k'
			pe(inner) gives inner.displayReason()
			macho(inner) gives inner.displayReason()
			elf(inner) gives inner.displayReason()
		end 'k'
	end 'displayReason'
end 'DataSectionReadError'

// Read `target`'s globals section out of the binary at `exePath`.
//
// EXHAUSTIVE over `Os`, with no bare `else`. The previous shape — `if macos … else <PE>` — quietly
// made PE the answer for every os nobody had thought about, which is precisely how an ELF came to be
// parsed as a PE. `wasi` panics rather than guessing: a wasm component has no native globals section
// at all, so there is no reading to attempt, and the only way to reach it is a `RequiredData` spec
// that was allowed to run under wasm — a gating bug in the spec, which the panic names.
export function readLinkedDataSection(exePath FilePath, target Target) returns ByteArray throws DataSectionReadError
	match target.os 'format'
		windows then return try peGlobalsSection(exePath)
		macos then return try machoGlobalsSection(exePath)
		linux then return try elfGlobalsSection(exePath)
		wasi then panic("readLinkedDataSection: a wasm component has no native globals section, so a `RequiredData` block cannot be checked under {targetToString(target)} — the spec carrying it must restrict itself to the targets that have one")
	end 'format'
end 'readLinkedDataSection'

// --- One per format: where that format keeps globals, and how its failure joins the shared union ---
//
// Three functions rather than three arms of the match above, because a match arm may not BIND the
// error it catches (`E2049`) and the bound error is the entire point — `displayReason()` is what
// turns "the `.data` gate could not read the binary" into "…is not an ELF64 image (bad magic or
// EI_CLASS)". Each carries one fact its caller should not have to know: the section naming that
// format uses for a top-level `var`'s storage, which is a contract with that format's WRITER.

function peGlobalsSection(exePath FilePath) returns ByteArray throws DataSectionReadError
	return try readPeSectionData(exePath, sectionName: DataSectionName) otherwise (e) 'peErr'
		throw DataSectionReadError.pe(e)
	end 'peErr'
end 'peGlobalsSection'

function machoGlobalsSection(exePath FilePath) returns ByteArray throws DataSectionReadError
	return try readMachoSectionData(exePath, segname: MachoDataSegmentName, sectname: MachoDataSectionName) otherwise (e) 'machoErr'
		throw DataSectionReadError.macho(e)
	end 'machoErr'
end 'machoGlobalsSection'

function elfGlobalsSection(exePath FilePath) returns ByteArray throws DataSectionReadError
	return try readElfSectionData(exePath, sectionName: ElfDataSectionName) otherwise (e) 'elfErr'
		throw DataSectionReadError.elf(e)
	end 'elfErr'
end 'elfGlobalsSection'
