// ScaleCurves — every curve this instrument fits, enumerated ONCE.
//
// A CURVE is one measured cost plotted against program size and fitted as a power law (CurveFit).
// Every compile phase, every register-allocator sub-phase, and the whole compile has TWO of them:
// its wall TIME and its ALLOCATIONS. The two are carried together, in one row, rather than as two
// independent lists — a phase's time and its memory are answers to the same question about the same
// code, and splitting them made three separate consumers walk the enums three separate times.
//
// THAT is why this file exists. The human report, the `--result-json` document and the trend log all
// need the same set of fitted curves, and each used to build it for itself: three copies of "for
// every phase, for every regalloc sub-phase, then the aggregate", three copies of the series-
// gathering loop, and three chances for one of them to quietly stop covering a phase somebody added.
// They now all take `fitScaleCurves`, so a phase added to `CompilePhase` appears in all three at
// once, or in none of them.
//
// SHARES ARE MEASURED AT THE TOP RUNG, not averaged over the ladder. The whole question is how costs
// behave as programs get big, and a phase that is 0.2% of rung 0 and 30% of rung 5 is exactly the
// phase worth looking at; an average would dilute it back into the noise. The share is a READING —
// "this phase is a third of the compile" — and nothing branches on it.

// The one curve that is not a phase: the whole compile. Its time is the compile's wall time and its
// allocations are the compile's allocations, so it is the row every other row is a fraction of.
export let AggregateCurveName = "aggregate"

let PhaseCurvePrefix = "phase:"
let RegAllocCurvePrefix = "regalloc:"

// THE one place a curve's name is built, so the report, the JSON document and the trend log's
// column headings cannot disagree about what a row is called.
export function phaseCurveName(phase CompilePhase) returns String
	return "{PhaseCurvePrefix}{phase.name}"
end 'phaseCurveName'

export function regAllocCurveName(sub RegAllocPhase) returns String
	return "{RegAllocCurvePrefix}{sub.name}"
end 'regAllocCurveName'

// Thousandths of the top rung — the unit every share here is in. `Milli` because it is the same
// fixed-point convention the exponents use, and a report that mixed percent and per-mille would be
// a report nobody could read a column of.
let PermilleFull = 1000 as Milli

// One curve: its name, and what fitting its two series said.
export type ScaleCurve
	export let name as String
	export let time as FitResult
	// This curve's share of the top rung's WALL TIME, in thousandths.
	export let timeShare as Milli
	export let allocs as FitResult
	// And of the top rung's ALLOCATIONS. It must be its own number rather than the time share reused:
	// a phase can be a rounding error in wall time and a large fraction of the allocations, or the
	// reverse, and a single "share" column would hide whichever of the two was interesting.
	export let allocShare as Milli

	static function create(name String, time FitResult, timeShare Milli, allocs FitResult, allocShare Milli) returns ScaleCurve
		return Self{name: name, time: time, timeShare: timeShare, allocs: allocs, allocShare: allocShare}
	end 'create'
end 'ScaleCurve'

export typealias ScaleCurveArray = Array with ScaleCurve

// Fit every curve of one ladder. The order is the enums' order, and it is the order the report
// prints, the JSON lists, and the trend log's columns are in.
export function fitScaleCurves(results RungResultArray) returns ScaleCurveArray
	let sizes = sourceSizes(results)
	let top = try results.get(results.count() - 1) otherwise panic("fitScaleCurves: the ladder is empty — the runner climbs at least one rung or fails the run")

	var curves = ScaleCurveArray.create()

	for phase in CompilePhase.allCases 'eachPhase'
		var nanos = FitPointArray.create()
		var allocs = FitPointArray.create()
		for result in results 'eachRung'
			nanos.push(result.phaseAt(phase).nanos as Real)
			allocs.push(result.phaseAt(phase).allocs as Real)
		end 'eachRung'
		let timeShare = shareOf(top.phaseAt(phase).nanos, total: top.total.nanos)
		let allocShare = shareOf(top.phaseAt(phase).allocs, total: top.total.allocs)
		curves.push(ScaleCurve.create(phaseCurveName(phase), time: fitPowerLaw(sizes, costs: nanos), timeShare: timeShare, allocs: fitPowerLaw(sizes, costs: allocs), allocShare: allocShare))
	end 'eachPhase'

	for sub in RegAllocPhase.allCases 'eachSub'
		var nanos = FitPointArray.create()
		var allocs = FitPointArray.create()
		for result in results 'eachRung'
			nanos.push(result.regAllocAt(sub).nanos as Real)
			allocs.push(result.regAllocAt(sub).allocs as Real)
		end 'eachRung'
		let timeShare = shareOf(top.regAllocAt(sub).nanos, total: top.total.nanos)
		let allocShare = shareOf(top.regAllocAt(sub).allocs, total: top.total.allocs)
		curves.push(ScaleCurve.create(regAllocCurveName(sub), time: fitPowerLaw(sizes, costs: nanos), timeShare: timeShare, allocs: fitPowerLaw(sizes, costs: allocs), allocShare: allocShare))
	end 'eachSub'

	var totalNanos = FitPointArray.create()
	var totalAllocs = FitPointArray.create()
	for result in results 'eachRung'
		totalNanos.push(result.total.nanos as Real)
		totalAllocs.push(result.total.allocs as Real)
	end 'eachRung'
	curves.push(ScaleCurve.create(AggregateCurveName, time: fitPowerLaw(sizes, costs: totalNanos), timeShare: PermilleFull, allocs: fitPowerLaw(sizes, costs: totalAllocs), allocShare: PermilleFull))

	return curves
end 'fitScaleCurves'

// The ladder's x-axis: bytes of generated source per rung. Every curve in this file is fitted
// against it, and so is the corpus self-check in ScaleCorpus.
export function sourceSizes(results RungResultArray) returns FitPointArray
	var sizes = FitPointArray.create()
	for result in results 'each'
		sizes.push(result.sourceBytes as Real)
	end 'each'
	return sizes
end 'sourceSizes'

// A part of the top rung, in thousandths of the whole. `TopRungMeasure` is deliberately one type for
// both nanoseconds and allocation counts: the arithmetic is identical and a second copy of it,
// differing only in the name of its parameter, is the duplication this file was written to remove.
export typealias TopRungMeasure = int(0 to u64.max)

function shareOf(part TopRungMeasure, total TopRungMeasure) returns Milli
	if total == 0 'nothingMeasured'
		return 0
	end 'nothingMeasured'
	return ((part * PermilleFull) / total) as Milli
end 'shareOf'

// A share as the report prints it: thousandths to one decimal place of a percent.
export function shareText(share Milli) returns String
	return "{share / 10}.{share mod 10}%"
end 'shareText'
