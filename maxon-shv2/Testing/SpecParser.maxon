// Testing/SpecParser.maxon — parse a `specs-shv2/*.md` spec file into a list of
// runnable tests. Trimmed HARD from v1's SpecParser: shv2 needs only the
// `<!-- test: NAME -->` marker, the ```maxon source block, and one expected
// block (```exitcode or ```maxoncstderr), plus the `status:` frontmatter. Every
// v1 feature the specs-shv2 corpus does not use — fragment caching, RequiredIR /
// RequiredRdata / RequiredLowering, per-target `Stdout:<target>`, mm-trace,
// `Args`/`TimeoutMs` directives, multi-file markers, doc-example extraction — is
// dropped; each returns when a spec first needs it.
//
// DEFERRED-SKIP CONVENTION (why a `## Deferred` section, not a comment):
// HTML comments do NOT nest. The obvious way to shelve a test —
// `<!-- … <!-- test: NAME --> … -->` — is a trap: the FIRST `-->` (the one on
// the inner `<!-- test: … -->` line) closes the OUTER comment, so the inner test
// marker + its code blocks are exposed as live markup and a naive parser
// extracts and RUNS a deferred test. Rather than depend on comment nesting, the
// active-test region is bounded by markdown headings: it runs from the
// `## Tests` heading to the NEXT `## ` heading. Deferred tests live under a
// `## Deferred` heading (as plain `### name` subsections, carrying NO
// `<!-- test: … -->` marker), so they are both out of the scanned region AND
// carry no marker — belt and suspenders. The specs-shv2 files were rewritten to
// this convention in lockstep with this parser.

// --- Spec-markdown grammar tokens ---
// Named (not inline literals) because these strings are a format contract shared
// with spec authors, and because the ORDER two of them are matched in is
// load-bearing: "```maxoncstderr" startsWith "```maxon", so the compiler-error
// fence MUST be tested before the source fence or the source check swallows it.
let FrontmatterFence = "---"
let StatusKey = "status:"
let DraftStatus = "draft"
let TestsHeading = "## Tests"
let SectionHeadingPrefix = "## "
let TestMarker = "<!-- test:"
let TestMarkerNameSep = ": "
let TestMarkerEnd = " -->"
let SourceFence = "```maxon"
let ExitCodeFence = "```exitcode"
let CompilerErrorFence = "```maxoncstderr"
let FenceClose = "```"

// --- The AllocChecker opt-OUT ---
//
// `checkAlloc` is an OPT-OUT, never an opt-in, and it DEFAULTS TO ON for every test of every
// spec (`DefaultCheckAlloc`). That polarity is the whole design: the checker's value is that it
// runs over code nobody thought to check. Every allocator bug it has caught surfaced where no
// author would have ticked a box — the parameter-capture read-after-clobber (a real, shipped
// miscompile) in `functions.md`, the two-sequential-loops colorer panic in `while-loops.md`, the
// false-E5001 class in ordinary loop code — none of them in an allocator-focused spec. An opt-in
// would arm the checker exactly where someone already suspected a problem, i.e. where it is
// least needed, and disarm it everywhere else. So the suite runs it everywhere and a spec must
// deliberately SAY it does not want it.
//
// Two granularities, both spelled as the value `true` or `false` (anything else is a hard
// `specError` — an unreadable gate directive must never be guessed at):
//   * per SPEC — a `checkAlloc: false` key in the YAML frontmatter, alongside `status:`. Applies
//     to every test in the file.
//   * per TEST — a `<!-- checkAlloc: false -->` marker on a line AFTER that test's
//     `<!-- test: NAME -->` marker (i.e. inside the test's own block region). Overrides the
//     spec-level value for that one test. It is its own HTML-comment marker rather than an
//     extra field inside the `<!-- test: … -->` marker precisely so `markerValue` reads both
//     with one routine and the test's NAME stays the whole of its marker's value.
let CheckAllocKey = "checkAlloc:"
let CheckAllocMarker = "<!-- checkAlloc:"
let TrueValue = "true"
let FalseValue = "false"
let DefaultCheckAlloc = true

typealias LineIndex = int(0 to u64.max)

// A process exit code — shared by the EXPECTED value parsed here and the OBSERVED
// value the runner reads back, so they compare without a cast. Exported so the
// runner names the `SpecExpectation.exitCode` payload in its own signatures.
export typealias ExitCodeValue = int(i64.min to i64.max)

// The expected outcome of one test. A UNION (not a struct with presence flags)
// so a test asserts EXACTLY one of two mutually exclusive things — the compiled
// program exits with `value`, OR the compiler rejects the source with `text` (a
// ```maxoncstderr block) — with no sentinel "unset" state.
export union SpecExpectation
	exitCode(value ExitCodeValue)
	compilerError(text String)
end 'SpecExpectation'

// One active test: its name, its ```maxon source VERBATIM, its expectation, and whether the
// runner compiles it with the AllocChecker on. `checkAlloc` is the EFFECTIVE value — the spec's
// frontmatter setting with this test's own `<!-- checkAlloc: … -->` marker applied over it — so
// the runner reads one field and never re-derives the precedence.
export type SpecTest
	export let name as String
	export let source as String
	export let expectation as SpecExpectation
	export let checkAlloc as bool

	export static function create(name String, source String, expectation SpecExpectation, checkAlloc bool) returns SpecTest
		return Self{name: name, source: source, expectation: expectation, checkAlloc: checkAlloc}
	end 'create'
end 'SpecTest'

export typealias SpecTestArray = Array with SpecTest

// A parsed spec file: its frontmatter `status` (the runner skips `draft`) and
// every active test. (The path is deliberately NOT stored — the caller already
// holds the FilePath it passed to `parseSpecFile`, so a copy here would be dead.
// The frontmatter `checkAlloc` is likewise not stored: it has already been folded
// into each test's own effective `checkAlloc`, so a copy here would be dead too.)
export type SpecFile
	export let status as String
	export let tests as SpecTestArray

	export static function create(status String, tests SpecTestArray) returns SpecFile
		return Self{status: status, tests: tests}
	end 'create'
end 'SpecFile'

// The spec's YAML frontmatter: the `status:` tier and the `checkAlloc:` opt-out. Both keys come
// out of ONE scan of the frontmatter block — a second key must not mean a second walk of the
// same lines.
type SpecFrontmatter
	export let status as String
	export let checkAlloc as bool

	static function create(status String, checkAlloc bool) returns SpecFrontmatter
		return Self{status: status, checkAlloc: checkAlloc}
	end 'create'
end 'SpecFrontmatter'

// One fenced code block: its content (fence lines excluded), and the line index
// immediately AFTER its closing ``` — the single unit the block reader returns
// so every block type (source / exitcode / maxoncstderr) shares one routine
// instead of copy-pasted fence walking.
type FenceBlock
	export let text as String
	export let nextIndex as LineIndex

	export static function create(text String, nextIndex LineIndex) returns FenceBlock
		return Self{text: text, nextIndex: nextIndex}
	end 'create'
end 'FenceBlock'

// Read the spec file at `path` and extract its frontmatter status + active
// tests. Throws `readError` when the file cannot be read (the runner surfaces
// it), reusing the driver's IO error union rather than inventing a parallel one.
export function parseSpecFile(path FilePath) returns SpecFile throws CompileError
	let content = try File.readText(path) otherwise throw CompileError.readError(path)
	let lines = content.split("\n")
	let frontmatter = try parseFrontmatter(lines, path: path)
	let tests = try extractTests(lines, path: path, specCheckAlloc: frontmatter.checkAlloc)
	return SpecFile.create(frontmatter.status, tests: tests)
end 'parseSpecFile'

// Read the YAML frontmatter (the leading `--- … ---` block) in ONE pass. `status` is "" when
// there is no frontmatter or no status key — the runner skips only the literal "draft", so ""
// runs normally. `checkAlloc` defaults to ON (see DefaultCheckAlloc): a spec that says nothing
// gets the safety net.
function parseFrontmatter(lines StringArray, path FilePath) returns SpecFrontmatter throws CompileError
	var status = ""
	var checkAlloc = DefaultCheckAlloc

	let lineCount = lines.count()
	if lineCount == 0 'noLines'
		return SpecFrontmatter.create(status, checkAlloc: checkAlloc)
	end 'noLines'

	let firstLine = try lines.get(0) otherwise ""
	if firstLine.trim() != FrontmatterFence 'noFrontmatter'
		return SpecFrontmatter.create(status, checkAlloc: checkAlloc)
	end 'noFrontmatter'

	var i = 1
	while i < lineCount 'scan'
		let line = try lines.get(i) otherwise panic("SpecParser.parseFrontmatter: index {i} >= lineCount {lineCount} despite the while guard i<lineCount")

		let trimmed = line.trim()
		if trimmed == FrontmatterFence 'endFrontmatter'
			break
		end 'endFrontmatter'

		if trimmed.startsWith(StatusKey) 'isStatus'
			status = valueAfterKey(trimmed, key: StatusKey)
		end 'isStatus' else if trimmed.startsWith(CheckAllocKey) 'isCheckAlloc'
			checkAlloc = try parseBoolDirective(valueAfterKey(trimmed, key: CheckAllocKey), path: path, directive: trimmed)
		end 'isCheckAlloc'

		i = i + 1
	end 'scan'

	return SpecFrontmatter.create(status, checkAlloc: checkAlloc)
end 'parseFrontmatter'

// Read a `checkAlloc` directive's value. ONLY the literals `true` and `false` are accepted;
// anything else THROWS rather than falling back to a default. This directive decides whether the
// allocator's one real safety net runs, so an unreadable value is not a thing to guess at — a
// typo'd `checkAlloc: no` must abort the run loudly, not silently disarm (or silently arm) the
// checker for a whole spec file.
function parseBoolDirective(value String, path FilePath, directive String) returns bool throws CompileError
	if value == TrueValue 'isTrue'
		return true
	end 'isTrue'
	if value == FalseValue 'isFalse'
		return false
	end 'isFalse'

	throw CompileError.specError("{path.toString()}: malformed checkAlloc directive '{directive}': expected '{TrueValue}' or '{FalseValue}', got '{value}'")
end 'parseBoolDirective'

// The trimmed remainder of `line` after a literal `key` prefix. `line` is known
// to start with `key` (the caller gates on `startsWith`), so advancing
// `key.byteLength()` ASCII positions lands exactly past the key.
function valueAfterKey(line String, key String) returns String
	var pos = line.startIndex()
	for _ in 0 upto key.byteLength() 'skipKey'
		pos = try line.indexAfter(pos) otherwise return ""
	end 'skipKey'
	return line.slice(pos, endIndex: line.endIndex()).trim()
end 'valueAfterKey'

// Extract every ACTIVE test. The scanned region is the `## Tests` section only:
// from the line after the `## Tests` heading to the next `## ` heading (or EOF).
// A `## Deferred` heading therefore ends scanning, so no deferred test is ever
// reached — see the deferred-skip convention at the top of this file.
function extractTests(lines StringArray, path FilePath, specCheckAlloc bool) returns SpecTestArray throws CompileError
	var tests = SpecTestArray.create()
	let lineCount = lines.count()

	// Locate the `## Tests` heading; the active-test region begins on the next line.
	var i = 0
	var inTests = false
	while i < lineCount 'find'
		let line = try lines.get(i) otherwise panic("SpecParser.extractTests: index {i} >= lineCount {lineCount} despite the while guard i<lineCount")

		if line.startsWith(TestsHeading) 'foundTests'
			inTests = true
			i = i + 1
			break
		end 'foundTests'

		i = i + 1
	end 'find'

	if not inTests 'noTestsSection'
		return tests
	end 'noTestsSection'

	while i < lineCount 'scan'
		let line = try lines.get(i) otherwise panic("SpecParser.extractTests: index {i} >= lineCount {lineCount} despite the while guard i<lineCount")

		// A new `## ` section (e.g. `## Deferred`) ends the active-test region.
		if line.startsWith(SectionHeadingPrefix) 'sectionEnd'
			break
		end 'sectionEnd'

		if line.contains(TestMarker) 'isMarker'
			i = try appendTestFromMarker(lines, markerIndex: i, markerLine: line, tests: tests, path: path, specCheckAlloc: specCheckAlloc)
		end 'isMarker' else if line.contains(CheckAllocMarker) 'strayCheckAlloc'
			// A `<!-- checkAlloc: … -->` marker reached by the OUTER scan belongs to no test:
			// `appendTestFromMarker` consumes every line of the test it opened, so a marker
			// surfacing here sits before the first `<!-- test: … -->` (or after a section
			// boundary). Silently ignoring it would leave an author believing a test was
			// opted out when it was not — exactly the false sense of coverage this checker
			// exists to prevent. Use the frontmatter key to opt a whole file out.
			throw CompileError.specError("{path.toString()}: stray '{line.trim()}' marker: a per-test checkAlloc marker must FOLLOW a '{TestMarker} NAME -->' marker; to opt out a whole spec use the frontmatter '{CheckAllocKey}' key")
		end 'strayCheckAlloc' else 'notMarker'
			i = i + 1
		end 'notMarker'
	end 'scan'

	return tests
end 'extractTests'

// Parse one test starting at its `<!-- test: NAME -->` marker and push it onto
// `tests`, returning the line index to resume the outer scan from. The test is
// pushed ONLY when both a ```maxon source block and one expected block were seen
// before the next marker / section boundary (the "marker + source + expected,
// contiguous" active-test contract) — an incomplete run of blocks is not a
// runnable test and is silently left out rather than half-built.
function appendTestFromMarker(lines StringArray, markerIndex LineIndex, markerLine String, tests SpecTestArray, path FilePath, specCheckAlloc bool) returns LineIndex throws CompileError
	let lineCount = lines.count()
	let name = markerValue(markerLine)
	var source = ""
	var haveSource = false
	// Seeded from the SPEC's frontmatter value, so a file-level `checkAlloc: false` covers every
	// test in it; a per-test marker below overrides just this one.
	var checkAlloc = specCheckAlloc
	var i = markerIndex + 1

	while i < lineCount 'blocks'
		let line = try lines.get(i) otherwise panic("SpecParser.appendTestFromMarker: index {i} >= lineCount {lineCount} despite the while guard i<lineCount")

		// The next marker / section boundary ends this test. Leave `i` ON that
		// line so the outer scan re-examines it.
		if line.startsWith(SectionHeadingPrefix) 'sectionEnd'
			break
		end 'sectionEnd'
		if line.contains(TestMarker) 'nextMarker'
			break
		end 'nextMarker'

		// This test's own AllocChecker opt-out, e.g. `<!-- checkAlloc: false -->`. Checked
		// before the fences because it is a marker line, not a block.
		if line.contains(CheckAllocMarker) 'checkAllocMarker'
			checkAlloc = try parseBoolDirective(markerValue(line), path: path, directive: line.trim())
			i = i + 1
			continue
		end 'checkAllocMarker'

		// CompilerError MUST be checked before Source: "```maxoncstderr" also
		// startsWith "```maxon", so the source arm would otherwise consume it.
		if line.startsWith(CompilerErrorFence) 'compilerErr'
			let block = readFence(lines, openIndex: i)
			if haveSource 'errComplete'
				tests.push(SpecTest.create(name, source: source, expectation: SpecExpectation.compilerError(block.text.trim()), checkAlloc: checkAlloc))
			end 'errComplete'
			return block.nextIndex
		end 'compilerErr'

		if line.startsWith(ExitCodeFence) 'exitCode'
			let block = readFence(lines, openIndex: i)
			let parsed = try int.fromString(block.text.trim()) otherwise 'badExitCode'
				return block.nextIndex
			end 'badExitCode'
			if haveSource 'exitComplete'
				tests.push(SpecTest.create(name, source: source, expectation: SpecExpectation.exitCode(parsed), checkAlloc: checkAlloc))
			end 'exitComplete'
			return block.nextIndex
		end 'exitCode'

		if line.startsWith(SourceFence) 'source'
			let block = readFence(lines, openIndex: i)
			source = block.text
			haveSource = true
			i = block.nextIndex
			continue
		end 'source'

		i = i + 1
	end 'blocks'

	return i
end 'appendTestFromMarker'

// The VALUE of an HTML-comment marker line: the text between the first ": " and the trailing
// " -->", trimmed. Shared by both marker kinds — it reads NAME out of `<!-- test: NAME -->` and
// `false` out of `<!-- checkAlloc: false -->`, which is exactly why the per-test opt-out is its
// own marker rather than a second field inside the test marker (a `<!-- test: NAME checkAlloc:
// false -->` would make the name run to the end of the line).
function markerValue(line String) returns String
	// Advance one index past the ':' and let trim() drop the surrounding spaces — this avoids
	// measuring the module-const separator's length, because a method call directly on a
	// top-level `let` constant is a parse error in the bootstrap.
	let colonIdx = try line.findFirst(TestMarkerNameSep) otherwise return ""
	let valueStart = try line.indexAfter(colonIdx) otherwise return ""
	let endIdx = try line.findFirst(TestMarkerEnd) otherwise line.endIndex()
	return line.slice(valueStart, endIndex: endIdx).trim()
end 'markerValue'

// Read the fenced block whose opening ``` is at `openIndex`. Content lines are
// joined with "\n" and NO trailing newline, so a ```maxon block is reproduced
// VERBATIM with its first line at fragment line 1 — the header-free layout the
// shv2-native error `line:col` numbers are calibrated against. A missing closing
// fence treats EOF as the close (robust against a malformed spec rather than
// looping).
function readFence(lines StringArray, openIndex LineIndex) returns FenceBlock
	let lineCount = lines.count()
	var text = ""
	var first = true
	var i = openIndex + 1

	while i < lineCount 'read'
		let line = try lines.get(i) otherwise panic("SpecParser.readFence: index {i} >= lineCount {lineCount} despite the while guard i<lineCount")

		if line.startsWith(FenceClose) 'close'
			return FenceBlock.create(text, nextIndex: i + 1)
		end 'close'

		if first 'firstLine'
			text = line
			first = false
		end 'firstLine' else 'moreLines'
			text = "{text}\n{line}"
		end 'moreLines'

		i = i + 1
	end 'read'

	return FenceBlock.create(text, nextIndex: lineCount)
end 'readFence'
