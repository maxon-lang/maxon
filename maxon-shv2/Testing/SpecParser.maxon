// Testing/SpecParser.maxon — parse a `specs-shv2/*.md` spec file into a list of
// runnable tests. Trimmed HARD from v1's SpecParser: shv2 needs only the
// `<!-- test: NAME -->` marker, the ```maxon source block, and one expected
// block (```exitcode or ```maxoncstderr), plus the `status:` frontmatter. Every
// v1 feature the specs-shv2 corpus does not use — fragment caching, RequiredIR /
// RequiredRdata / RequiredLowering, per-target `Stdout:<target>`, mm-trace,
// `Args`/`TimeoutMs` directives, doc-example extraction — is dropped; each
// returns when a spec first needs it.
//
// MULTI-FILE TESTS — `// --- file: <name>` (added for the cross-file signature rung).
//
// ⚠ **THIS CONVENTION IS PORTED, NOT INVENTED, AND THAT IS THE WHOLE POINT.** It already exists
// and the corpus already uses it: **650 occurrences across 236 files** in `/specs` and its
// committed fragments, implemented by the C# reference in `SpecParser.cs`'s
// `SplitMultiFileSource()` + `FileMarkerRegex()`. shv2 simply did not read it. A second,
// shv2-only multi-file syntax would be this project's signature bug — one fact written down twice
// — in the one place it would be hardest to notice, because both would "work".
//
// The rules, mirrored exactly (`SpecParser.cs:273`):
//   • the marker is a COMMENT LINE inside the ```maxon block: `// --- file: app/main.maxon`;
//   • a block with NO marker is a single-file test (this is the common case, and it is unchanged);
//   • a file's text runs from its marker to the next one (or the end), TRIMMED;
//   • anything before the FIRST marker is discarded;
//   • forward slashes make subdirectories — and a `.` or `..` segment is REJECTED, because these
//     names are written to a temp directory and `..` walks out of it (the reference rejects it at
//     parse; shv2 rejects it at the WRITE, which is the point where the escape would actually
//     happen — see SpecTestRunner.writeSourceFiles).
//
// The golden `.test` fragment still shows the MERGED block, markers and all — again the
// reference's behaviour — so what a reviewer reads is what a spec author wrote.
//
// DEFERRED-SKIP CONVENTION (why a `## Deferred` section, not a comment):
// HTML comments do NOT nest. The obvious way to shelve a test —
// `<!-- … <!-- test: NAME --> … -->` — is a trap: the FIRST `-->` (the one on
// the inner `<!-- test: … -->` line) closes the OUTER comment, so the inner test
// marker + its code blocks are exposed as live markup and a naive parser
// extracts and RUNS a deferred test. Rather than depend on comment nesting, the
// active-test region is bounded by markdown headings: it runs from the
// `## Tests` heading to the NEXT `## ` heading. Deferred tests live under a
// `## Deferred` heading (as plain `### name` subsections, carrying NO
// `<!-- test: … -->` marker), so they are both out of the scanned region AND
// carry no marker — belt and suspenders. The specs-shv2 files were rewritten to
// this convention in lockstep with this parser.
//
// DISABLED TESTS — the per-CASE shelf, and the mechanism Workstream S runs on.
// `## Deferred` shelves at the wrong granularity for a ported spec: a real
// `/specs` file mixes cases shv2 can already pass with cases it cannot, so
// deferring the FILE strands the former behind the latter. A case shv2 cannot
// yet pass is therefore marked `<!-- disabled-test: NAME -->` — the marker the
// project ALREADY has (v1 skips it at SpecTestRunner.maxon:2233; the C# runner's
// regex is `<!--\s*(?:disabled-)?test:\s*\S+\s*-->`) — with the RUNG THAT
// UNLOCKS IT on the following comment line:
//
//     <!-- disabled-test: arithmetic.string-concat -->
//     <!-- P1.2 String -->
//
// A disabled case is parsed as a full test BOUNDARY (its blocks are consumed
// exactly as an active test's are, by the same routine, so the two can never
// drift on where a test ends) and then discarded: never compiled, never run, and
// — because it never reaches `SpecFile.tests` — NO `.test` golden is generated
// for it. Goldens therefore accrete only as cases are ENABLED, which is what
// keeps the fragment diff reviewable instead of a ten-thousand-file dump.
//
// The reasons are the roadmap: `grep -A1 disabled-test:` groups the entire
// remaining language surface by the milestone that unlocks it, ranked by cases
// that must actually PASS. And the ratchet is free: an ENABLED case may never be
// re-disabled.

// --- Spec-markdown grammar tokens ---
// Named (not inline literals) because these strings are a format contract shared
// with spec authors, and because the ORDER two of them are matched in is
// load-bearing: "```maxoncstderr" startsWith "```maxon", so the compiler-error
// fence MUST be tested before the source fence or the source check swallows it.
let FrontmatterFence = "---"
let StatusKey = "status:"
let TestsHeading = "## Tests"
let SectionHeadingPrefix = "## "
let TestMarker = "<!-- test:"

// A case shv2 cannot yet pass — same grammar, opposite verdict. It is NOT a
// superstring of `TestMarker` ("<!-- disabled-test:" does not contain
// "<!-- test:"), so the two match orders are independent and neither can swallow
// the other. Both are still tested explicitly, in one place, so that stays true
// if either literal is ever edited.
let DisabledTestMarker = "<!-- disabled-test:"
let TestMarkerNameSep = ": "
let TestMarkerEnd = " -->"
let SourceFence = "```maxon"
let ExitCodeFence = "```exitcode"
let CompilerErrorFence = "```maxoncstderr"

// The RUN's stderr — what the COMPILED PROGRAM printed, not what the compiler said about
// it. That distinction is the whole reason this is a separate fence from
// `CompilerErrorFence` and not a spelling of it: `maxoncstderr` asserts the compile FAILED
// and pins the diagnostic, while this asserts the compile SUCCEEDED, the program RAN, and
// pins what it wrote — the panic path. 32 blocks in `/specs` use it.
//
// It is order-INDEPENDENT of the other three: "```stderr" is neither a prefix nor an
// extension of "```maxon" / "```maxoncstderr" / "```exitcode", so unlike the
// maxoncstderr-before-maxon rule above, no arm can swallow it and it can swallow none.
// (Checked explicitly rather than assumed, because the fence order is exactly the kind of
// thing that is true until someone edits a literal.)
let RuntimeStderrFence = "```stderr"

// ⭐ THE `.data` SECTION'S BYTES, as typed values — `i64 42` / `i8 1` / `f64 3.14`, one per line.
// The gate on a top-level `var`'s STORAGE: not what the compiler thinks it laid out, but what the
// linked binary actually contains, read back out of the PE (`SpecTestRunner.checkRequiredData`).
//
// ⚠ **IT WAS SILENTLY IGNORED UNTIL P1.0d.5b, AND THAT IS WHY IT IS HERE.** This parser dropped
// every ```RequiredData block on the floor — the outer scan, finding no marker in it, walked over
// it line by line — so the SIX cases in `specs/static-variables.md` that carry one would have
// passed on their exit code alone while CLAIMING to check their layout. A gate that cannot see its
// own property must not report PASS; that is this project's own rule, and `verify-warm-rebuild`
// had just been caught breaking it. Implemented rather than refused, because the reference already
// implements it (`TestRunner.cs:CheckRequiredData` → `CheckRequiredSection`) and porting it costs
// less than explaining why shv2 would not.
//
// It is order-independent of the other four fences (no prefix relation), like ```stderr.
let RequiredDataFence = "```RequiredData"
let FenceClose = "```"

// The multi-file marker, and the ONE line the `// Test: <name>` fragment header adds above a
// block's first line. The header is why a file's line 1 is not the block's line 1 — see
// `SpecSourceFile.mergedLineOffset`, and `SpecTestRunner.fragmentSource`, which writes it.
export let FileMarker = "// --- file:"
let FragmentHeaderLines = 1 as LineIndex

// What would let a `// --- file:` marker escape the temp directory it is written into: a `.`/`..`
// segment, a rooted name, or a Windows drive letter. Checked at the write
// (SpecTestRunner.isSafeRelativeName), named here beside the marker they qualify.
export let DotSegment = "."
export let ParentSegment = ".."
export let PathSeparator = "/"
export let WindowsPathSeparator = "\\"
export let DriveLetterSeparator = ":"

// A 0-based line index into a spec file — and, on `SpecSourceFile.mergedLineOffset`, the distance
// between a compiled file's line numbers and the merged fragment's. Exported because the RUNNER is
// what applies that distance to a diagnostic.
export typealias LineIndex = int(0 to u64.max)

// How many cases in one spec file are shelved behind `<!-- disabled-test: … -->`.
// Carried (not discarded) because it is the project's progress metric: a rung is
// DONE when the cases it unlocks have moved out of this count and into the run.
export typealias DisabledTestCount = int(0 to u64.max)

// A process exit code — shared by the EXPECTED value parsed here and the OBSERVED
// value the runner reads back, so they compare without a cast. Exported so the
// runner names the `SpecExpectation.exitCode` payload in its own signatures.
export typealias ExitCodeValue = int(i64.min to i64.max)

// What a spec pins about the RUN's stderr. A UNION, not an empty `String`: "this spec
// says nothing about stderr" and "this spec says stderr is EMPTY" are different claims,
// and an empty String cannot tell them apart — it would be exactly the sentinel the
// project forbids. Most tests pin nothing; the panic specs pin the diagnostic.
export union SpecStderr
	unpinned
	pinned(text String)
end 'SpecStderr'

// What a spec pins about the emitted `.data` section — `SpecStderr`'s exact shape, and a union for
// the identical reason: "this spec says nothing about `.data`" and "this spec says `.data` is
// EMPTY" are different claims, and an empty String cannot tell them apart.
export union SpecRequiredData
	unpinned
	pinned(text String)
end 'SpecRequiredData'

// The expected outcome of one test. A UNION (not a struct with presence flags)
// so a test asserts EXACTLY one of two mutually exclusive things — the compiled
// program RAN, OR the compiler rejected the source with `text` (a ```maxoncstderr
// block) — with no sentinel "unset" state.
//
// The `run` arm carries ALL THREE halves of a run expectation, because none of them replaces an
// ```exitcode block — each ACCOMPANIES one. `specs/safety.md` asserts that `100 / zero` exits 1 AND
// prints a panic; `specs/static-variables.md` asserts that `data-section-i64-8byte` exits 0 AND
// lays down `i64 42`. Each is one indivisible claim about one build-and-run. Modelling stderr or
// requiredData as parallel arms would let a test assert an exit code or a layout but never both,
// which is precisely what those six cases do assert. The C# reference says the same thing with
// independent nullable fields (`SpecParser.cs:171` — a success expectation has optional
// ExitCode/Stdout/Stderr/RequiredData, mutually exclusive with a compile-error expectation); this
// is that shape with the "unset" states the reference leaves as `null` made unrepresentable.
export union SpecExpectation
	run(exitCode ExitCodeValue, stderr SpecStderr, requiredData SpecRequiredData)
	compilerError(text String)
end 'SpecExpectation'

// One FILE of a multi-file test — the `// --- file: <name>` sections of one ```maxon block.
export type SpecSourceFile
	// The path from the marker, RELATIVE (`app/main.maxon`). Written under the test's own scratch
	// directory, subdirectories and all.
	export let name as String
	// The file's own text, trimmed — exactly what is written to disk and compiled.
	export let source as String
	// Add this to a line number the COMPILER reports for this file, and you get the line number in
	// the MERGED fragment — which is what the golden shows and what every `/specs` expectation was
	// authored against (`specs/fragments/<spec>/<test>.test:11:9`). Without it a multi-file
	// diagnostic names a line nobody can find: the compiler saw `main.maxon:2`, the reviewer is
	// holding a merged file where that line is 11.
	//
	// It counts the marker line, everything above it, and the one `// Test: <name>` header line the
	// fragment carries — the same arithmetic the C# reference does in `TestRunner.ComputeSplitFileMap`.
	export let mergedLineOffset as LineIndex

	export static function create(name String, source String, mergedLineOffset LineIndex) returns SpecSourceFile
		return Self{name: name, source: source, mergedLineOffset: mergedLineOffset}
	end 'create'
end 'SpecSourceFile'

export typealias SpecSourceFileArray = Array with SpecSourceFile

// One active test: its name, its ```maxon source VERBATIM, and its expectation.
export type SpecTest
	export let name as String
	// The block VERBATIM — markers and all. This is what the golden `.test` fragment shows and, for
	// a single-file test, what is compiled. It is never re-derived from `sourceFiles`: the merged
	// text is the thing the spec author wrote, and a round-trip through the split would let the two
	// drift.
	export let source as String
	export let expectation as SpecExpectation
	// The `// --- file:` sections, or EMPTY for the ordinary single-file test. Empty is not a
	// sentinel — it is the literal count of file markers in the block, and "no markers" is exactly
	// what a single-file test is.
	export let sourceFiles as SpecSourceFileArray

	// The split is derived HERE, from the very source that will be compiled, so a test can never
	// exist with a file list that disagrees with its text.
	export static function create(name String, source String, expectation SpecExpectation) returns SpecTest
		return Self{name: name, source: source, expectation: expectation, sourceFiles: splitSourceFiles(source)}
	end 'create'

	// True when this test's block declares `// --- file:` sections — i.e. it compiles as a
	// DIRECTORY of files rather than as one fragment file.
	export function isMultiFile() returns bool
		return self.sourceFiles.count() > 0
	end 'isMultiFile'
end 'SpecTest'

export typealias SpecTestArray = Array with SpecTest

// A parsed spec file: its frontmatter `status` (the runner skips `draft`), every
// ACTIVE test, and how many cases were shelved behind `<!-- disabled-test: … -->`.
// (The path is deliberately NOT stored — the caller already holds the FilePath it
// passed to `parseSpecFile`, so a copy here would be dead.)
export type SpecFile
	export let status as String
	export let tests as SpecTestArray
	export let disabledCount as DisabledTestCount

	export static function create(status String, tests SpecTestArray, disabledCount DisabledTestCount) returns SpecFile
		return Self{status: status, tests: tests, disabledCount: disabledCount}
	end 'create'
end 'SpecFile'

// What one pass over a spec's `## Tests` region found: the runnable tests, and the
// count of cases deliberately shelved. Two values, one traversal — returning both
// keeps `extractTests` a single scan rather than a scan plus a separate re-count,
// which could disagree with it.
type ExtractedTests
	export let tests as SpecTestArray
	export let disabledCount as DisabledTestCount

	export static function create(tests SpecTestArray, disabledCount DisabledTestCount) returns ExtractedTests
		return Self{tests: tests, disabledCount: disabledCount}
	end 'create'
end 'ExtractedTests'

// One fenced code block: its content (fence lines excluded), and the line index
// immediately AFTER its closing ``` — the single unit the block reader returns
// so every block type (source / exitcode / maxoncstderr) shares one routine
// instead of copy-pasted fence walking.
type FenceBlock
	export let text as String
	export let nextIndex as LineIndex

	export static function create(text String, nextIndex LineIndex) returns FenceBlock
		return Self{text: text, nextIndex: nextIndex}
	end 'create'
end 'FenceBlock'

// Read the spec file at `path` and extract its frontmatter status + active
// tests. Throws `readError` when the file cannot be read (the runner surfaces
// it), reusing the driver's IO error union rather than inventing a parallel one.
export function parseSpecFile(path FilePath) returns SpecFile throws CompileError
	let content = try File.readText(path) otherwise throw CompileError.readError(path)
	let lines = content.split("\n")
	let extracted = extractTests(lines)
	return SpecFile.create(parseStatus(lines), tests: extracted.tests, disabledCount: extracted.disabledCount)
end 'parseSpecFile'

// Read the `status:` key out of the YAML frontmatter (the leading `--- … ---` block). "" when
// there is no frontmatter or no status key — the runner skips only the literal "draft", so ""
// runs normally.
function parseStatus(lines StringArray) returns String
	var status = ""

	let lineCount = lines.count()
	if lineCount == 0 'noLines'
		return status
	end 'noLines'

	let firstLine = try lines.get(0) otherwise ""
	if firstLine.trim() != FrontmatterFence 'noFrontmatter'
		return status
	end 'noFrontmatter'

	var i = 1
	while i < lineCount 'scan'
		let line = try lines.get(i) otherwise panic("SpecParser.parseStatus: index {i} >= lineCount {lineCount} despite the while guard i<lineCount")

		let trimmed = line.trim()
		if trimmed == FrontmatterFence 'endFrontmatter'
			break
		end 'endFrontmatter'

		if trimmed.startsWith(StatusKey) 'isStatus'
			status = valueAfterKey(trimmed, key: StatusKey)
		end 'isStatus'

		i = i + 1
	end 'scan'

	return status
end 'parseStatus'

// The trimmed remainder of `line` after a literal `key` prefix. `line` is known
// to start with `key` (the caller gates on `startsWith`), so advancing
// `key.byteLength()` ASCII positions lands exactly past the key.
function valueAfterKey(line String, key String) returns String
	var pos = line.startIndex()
	for _ in 0 upto key.byteLength() 'skipKey'
		pos = try line.indexAfter(pos) otherwise return ""
	end 'skipKey'
	return line.slice(pos, endIndex: line.endIndex()).trim()
end 'valueAfterKey'

// Extract every ACTIVE test, and count the disabled ones. The scanned region is the
// `## Tests` section only: from the line after the `## Tests` heading to the next
// `## ` heading (or EOF). A `## Deferred` heading therefore ends scanning, so no
// deferred test is ever reached — see the deferred-skip convention at the top of
// this file.
function extractTests(lines StringArray) returns ExtractedTests
	var tests = SpecTestArray.create()
	var disabledCount = 0 as DisabledTestCount
	let lineCount = lines.count()

	// Locate the `## Tests` heading; the active-test region begins on the next line.
	var i = 0
	var inTests = false
	while i < lineCount 'find'
		let line = try lines.get(i) otherwise panic("SpecParser.extractTests: index {i} >= lineCount {lineCount} despite the while guard i<lineCount")

		if line.startsWith(TestsHeading) 'foundTests'
			inTests = true
			i = i + 1
			break
		end 'foundTests'

		i = i + 1
	end 'find'

	if not inTests 'noTestsSection'
		return ExtractedTests.create(tests, disabledCount: disabledCount)
	end 'noTestsSection'

	while i < lineCount 'scan'
		let line = try lines.get(i) otherwise panic("SpecParser.extractTests: index {i} >= lineCount {lineCount} despite the while guard i<lineCount")

		// A new `## ` section (e.g. `## Deferred`) ends the active-test region.
		if line.startsWith(SectionHeadingPrefix) 'sectionEnd'
			break
		end 'sectionEnd'

		// A DISABLED case is scanned by the very same routine as an active one — it
		// is a full test boundary, just one whose result is thrown away. Sharing the
		// scan is the point: a second "skip a disabled test" walker would be free to
		// disagree with this one about where a test's blocks end, and the failure
		// mode of that disagreement is a shelved case silently RUNNING.
		if line.contains(DisabledTestMarker) 'isDisabledMarker'
			disabledCount = disabledCount + 1
			i = scanTestFromMarker(lines, markerIndex: i, markerLine: line, tests: tests, active: false)
		end 'isDisabledMarker' else if line.contains(TestMarker) 'isMarker'
			i = scanTestFromMarker(lines, markerIndex: i, markerLine: line, tests: tests, active: true)
		end 'isMarker' else 'notMarker'
			i = i + 1
		end 'notMarker'
	end 'scan'

	return ExtractedTests.create(tests, disabledCount: disabledCount)
end 'extractTests'

// Scan one test starting at its marker line, returning the line index to resume the
// outer scan from. When `active`, the parsed test is pushed onto `tests`; when not
// (a `<!-- disabled-test: … -->` case) it is scanned identically and DISCARDED, so
// the shelved case is skipped by consuming exactly the blocks a live test would
// have consumed rather than by a separate, driftable walker.
//
// A test is pushed ONLY when both a ```maxon source block and one expected block
// were seen before the next marker / section boundary (the "marker + source +
// expected, contiguous" active-test contract) — an incomplete run of blocks is not
// a runnable test and is silently left out rather than half-built.
//
// The scan reads the test's WHOLE block run and builds the expectation once at the end,
// rather than returning at the first expected block it recognizes. It has to: a run
// expectation is spread across TWO fences (```exitcode then ```stderr — see
// `SpecExpectation`), so a scan that returned at the exitcode would leave the stderr
// block to the outer loop, which — finding no marker in it — would walk over it line by
// line and silently drop the assertion. A spec that pins a panic would then pass on the
// exit code alone, which is the one failure mode a panic spec exists to catch.
function scanTestFromMarker(lines StringArray, markerIndex LineIndex, markerLine String, tests SpecTestArray, active bool) returns LineIndex
	let lineCount = lines.count()
	let name = markerValue(markerLine)
	var source = ""
	var haveSource = false
	var compilerError = ""
	var haveCompilerError = false
	var exitCode = 0 as ExitCodeValue
	var haveExitCode = false
	var stderr = SpecStderr.unpinned
	var requiredData = SpecRequiredData.unpinned
	var i = markerIndex + 1

	while i < lineCount 'blocks'
		let line = try lines.get(i) otherwise panic("SpecParser.scanTestFromMarker: index {i} >= lineCount {lineCount} despite the while guard i<lineCount")

		// The next marker of EITHER kind, or a section boundary, ends this test. Leave
		// `i` ON that line so the outer scan re-examines it. Disabled markers must end
		// a test just as active ones do, or an active case followed by a shelved one
		// would swallow the shelved case's blocks and mis-read its expectation.
		if line.startsWith(SectionHeadingPrefix) 'sectionEnd'
			break
		end 'sectionEnd'
		if line.contains(TestMarker) or line.contains(DisabledTestMarker) 'nextMarker'
			break
		end 'nextMarker'

		// CompilerError MUST be checked before Source: "```maxoncstderr" also
		// startsWith "```maxon", so the source arm would otherwise consume it. The
		// runtime-stderr fence is order-independent of all three (see RuntimeStderrFence).
		if line.startsWith(CompilerErrorFence) 'compilerErr'
			let block = readFence(lines, openIndex: i)
			compilerError = block.text.trim()
			haveCompilerError = true
			i = block.nextIndex
			continue
		end 'compilerErr'

		if line.startsWith(RuntimeStderrFence) 'runtimeStderr'
			let block = readFence(lines, openIndex: i)
			stderr = SpecStderr.pinned(block.text.trim())
			i = block.nextIndex
			continue
		end 'runtimeStderr'

		if line.startsWith(RequiredDataFence) 'requiredDataBlock'
			let block = readFence(lines, openIndex: i)
			requiredData = SpecRequiredData.pinned(block.text.trim())
			i = block.nextIndex
			continue
		end 'requiredDataBlock'

		if line.startsWith(ExitCodeFence) 'exitCodeBlock'
			let block = readFence(lines, openIndex: i)
			let parsed = try int.fromString(block.text.trim()) otherwise 'badExitCode'
				i = block.nextIndex
				continue
			end 'badExitCode'
			exitCode = parsed
			haveExitCode = true
			i = block.nextIndex
			continue
		end 'exitCodeBlock'

		if line.startsWith(SourceFence) 'source'
			let block = readFence(lines, openIndex: i)
			source = block.text
			haveSource = true
			i = block.nextIndex
			continue
		end 'source'

		i = i + 1
	end 'blocks'

	// A DISABLED case has now consumed exactly the blocks a live one would have, which was
	// the entire point of scanning it; it contributes no test. A case with no source block
	// is not runnable either.
	if not active or not haveSource 'notRunnable'
		return i
	end 'notRunnable'

	// A ```maxoncstderr block WINS over an ```exitcode one: the two are mutually exclusive,
	// and a spec carrying both is asserting the compile FAILS — which no exit code of the
	// program it never produced could also be true of.
	if haveCompilerError 'rejected'
		tests.push(SpecTest.create(name, source: source, expectation: SpecExpectation.compilerError(compilerError)))
		return i
	end 'rejected'

	// An ```exitcode block, plus whatever ```stderr accompanied it, is ONE claim about ONE
	// execution.
	if haveExitCode 'ran'
		tests.push(SpecTest.create(name, source: source, expectation: SpecExpectation.run(exitCode, stderr: stderr, requiredData: requiredData)))
	end 'ran'

	return i
end 'scanTestFromMarker'

// Split a ```maxon block into its `// --- file:` sections. EMPTY when the block has no marker —
// the ordinary single-file test, which is most of them.
//
// A faithful port of the C# reference's `SplitMultiFileSource` (`SpecParser.cs:273`), including
// the two things about it that are easy to get subtly different and would silently misreport a
// diagnostic's line for ever after:
//   • the text BEFORE the first marker is DISCARDED (a block that opens with prose or a stray
//     blank line loses it, and no file inherits it);
//   • each section is TRIMMED, but its line OFFSET is measured from the line right after its
//     marker — not from its first non-blank line. Both compilers therefore agree on what line a
//     multi-file diagnostic sits on, which is the only property that matters here, and it is what
//     makes a `/specs` expectation portable byte-for-byte.
function splitSourceFiles(source String) returns SpecSourceFileArray
	var files = SpecSourceFileArray.create()
	let lines = source.split("\n")
	let lineCount = lines.count()

	var name = ""
	var body = ""
	var haveMarker = false
	var offset = 0 as LineIndex

	for i in 0 upto lineCount 'eachLine'
		let line = try lines.get(i) otherwise panic("SpecParser.splitSourceFiles: index {i} >= lineCount {lineCount} despite the upto bound")

		if not line.startsWith(FileMarker) 'notAMarker'
			if haveMarker 'insideAFile'
				body = "{body}\n{line}"
			end 'insideAFile'
			continue
		end 'notAMarker'

		if haveMarker 'flushPrevious'
			files.push(SpecSourceFile.create(name, source: body.trim(), mergedLineOffset: offset))
		end 'flushPrevious'

		name = valueAfterKey(line, key: FileMarker)
		body = ""
		haveMarker = true
		// This file's first line is the one AFTER the marker: 0-based block index `i + 1`, which is
		// block LINE NUMBER `i + 2`, which is fragment line number `i + 2 + FragmentHeaderLines - 1`.
		// The file's own line 1 must land there, so the offset added to a per-file line is that minus
		// one. (Checked against the corpus: `export-keyword`'s `error.non-exported-function-cross-file`
		// expects `:11:9`, and this yields exactly 11.)
		offset = i + FragmentHeaderLines + 1
	end 'eachLine'

	if haveMarker 'flushLast'
		files.push(SpecSourceFile.create(name, source: body.trim(), mergedLineOffset: offset))
	end 'flushLast'

	return files
end 'splitSourceFiles'

// The VALUE of an HTML-comment marker line: the text between the first ": " and the trailing
// " -->", trimmed — i.e. NAME out of `<!-- test: NAME -->`.
function markerValue(line String) returns String
	// Advance one index past the ':' and let trim() drop the surrounding spaces — this avoids
	// measuring the module-const separator's length, because a method call directly on a
	// top-level `let` constant is a parse error in the bootstrap.
	let colonIdx = try line.findFirst(TestMarkerNameSep) otherwise return ""
	let valueStart = try line.indexAfter(colonIdx) otherwise return ""
	let endIdx = try line.findFirst(TestMarkerEnd) otherwise line.endIndex()
	return line.slice(valueStart, endIndex: endIdx).trim()
end 'markerValue'

// Lines joined by "\n", with no leading and no trailing newline.
//
// The suite accumulates line-oriented text in exactly two places — a spec's fenced blocks
// (`readFence`, below) and a worker's whole stderr (`drainChildStderr`, SpecWorkerPool) — and both used
// to hand-roll this dance identically. Both are also UNBOUNDED in the input: a fence is a whole test
// program, a drain is everything a crashed child said. So both must accumulate into a `StringBuilder`,
// because a `String` owns exactly the bytes it holds and its `append` recopies all of them
// (stdlib/String.maxon), making a join Θ(n²) in its own output.
//
// `hasLine` is NOT `out.isEmpty()`. A first line that is itself EMPTY leaves the builder empty and must
// still be separated from the line after it — a spec fence opening on a blank line is ordinary, and
// inferring the flag from the buffer would silently eat that newline.
export type LineJoiner
	var out as StringBuilder
	var hasLine as bool

	export static function create() returns LineJoiner
		return LineJoiner{out: StringBuilder.create(), hasLine: false}
	end 'create'

	export function push(line String)
		if hasLine 'separator'
			out.append("\n")
		end 'separator'

		out.append(line)
		hasLine = true
	end 'push'

	/// The joined text. CONSUMING, as `StringBuilder.build` is: the joiner is empty afterwards.
	export function build() returns String
		hasLine = false
		return out.build()
	end 'build'
end 'LineJoiner'

// Read the fenced block whose opening ``` is at `openIndex`. Content lines are
// joined with "\n" and NO trailing newline, so a ```maxon block is reproduced
// VERBATIM — the runner prepends the one `// Test: <name>` line the C# reference
// prepends and nothing else, which is what puts a spec's code at the same fragment
// line number under both compilers (SpecTestRunner's `fragmentSource`). A missing
// closing fence treats EOF as the close (robust against a malformed spec rather
// than looping).
function readFence(lines StringArray, openIndex LineIndex) returns FenceBlock
	let lineCount = lines.count()
	var text = LineJoiner.create()
	var i = openIndex + 1

	while i < lineCount 'read'
		let line = try lines.get(i) otherwise panic("SpecParser.readFence: index {i} >= lineCount {lineCount} despite the while guard i<lineCount")

		if line.startsWith(FenceClose) 'close'
			return FenceBlock.create(text.build(), nextIndex: i + 1)
		end 'close'

		text.push(line)
		i = i + 1
	end 'read'

	return FenceBlock.create(text.build(), nextIndex: lineCount)
end 'readFence'
