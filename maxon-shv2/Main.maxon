// maxon-shv2 compiler entry point (M1 driver).
//
// Parses the command line, dispatches a command, and maps the driver's
// CompileError outcomes to an exit code. `build` reads the input file/directory,
// runs the pipeline, and writes an executable. `verify-warm-rebuild` is the M2
// warm-rebuild gate: it asserts the query spine is deterministic + incremental for
// a file and exits 0 iff both properties hold. Diagnostics (E3001/E3002) are
// printed by `compile`/`compileToCodeResult`; Main stays silent on the
// `compileError` arm so a failing build's stderr is EXACTLY the reported
// diagnostics (the `maxoncstderr` spec contract).
//
// CLI (documented):
//   maxon-shv2 build <file|directory> [-o <output>] [--emit-ir] [--target=<cpu>-<os>]
//   maxon-shv2 verify-warm-rebuild <file>
//   maxon-shv2 spec-test [dir] [--filter=<pattern>] [--update-required] [--workers=<n>] [--target=<cpu>-<os>] [--compiler=<path>]

// The default spec directory `spec-test` scans when no directory is given
// (resolved against the process cwd — the runner is invoked from the repo root).
let DefaultSpecDir = "specs-shv2"

// The CLI spellings the spec-test WORKER POOL has to re-emit, because a worker is this same
// executable re-launched with this same command line (see SpecWorkerPool). Named here — where the
// parser that reads them back also lives — so the two halves of that command line cannot drift
// apart into a hang. The rest of the driver's flags are matched inline: they are read here and
// nowhere else.
export let SpecTestCommandName = "spec-test"
export let WorkerPersistentFlag = "--worker-persistent"
export let FilterFlagPrefix = "--filter="
export let UpdateRequiredFlag = "--update-required"

// `--compiler=<path>` — THE COMPILER UNDER TEST, which is a different fact from "the executable a
// worker process is", and this constant exists because the two were one value until 2026-07-29.
//
// A worker IS this harness relaunched; the compiler it spawns to build each fragment need not be.
// In-tree they are the same file, so nothing ever distinguished them — see runSpecTest. It is in
// the re-emitted set because the parent forwards it to every worker: the child must be TOLD which
// compiler this run is about rather than re-deriving one from its own `Process.executablePath()`,
// which would answer with the worker binary and be right only by coincidence.
export let CompilerFlagPrefix = "--compiler="

// `--target=` is in this re-emitted set (not with `build`'s options) because a cross-target
// spec run forwards it to every worker's command line — see SpecWorkerPool.spawnNoWait. The
// parser below reads it back through this same constant, so the two halves cannot drift.
export let TargetFlagPrefix = "--target="
let WorkersFlagPrefix = "--workers="

function main() returns ExitCode
	let args = MaxonArgs.parse()

	// An option the driver does not implement aborts BEFORE any command runs. Every
	// command below would otherwise proceed as though the flag had been honoured,
	// which is the one outcome a caller can neither see nor recover from.
	if not args.badOption.isEmpty() 'badOption'
		printError("error: unknown option: {args.badOption}\n")
		printUsage()
		return 1
	end 'badOption'

	return match args.command 'cmd'
		build gives runBuild(args)
		verifyWarmRebuild gives runVerifyWarmRebuild(args)
		specTest gives runSpecTest(args)
		scaleTest gives runScaleTest(args)
		unknown gives unknownCommand()
	end 'cmd'
end 'main'

// The outcome of resolving a `--target=<cpu>-<os>` spelling: either the Target it
// names, or the raw spelling for the error message when it names no known target.
union TargetResolution
	resolved(target Target)
	unrecognized(spec String)
end 'TargetResolution'

// Resolve a `--target` spelling to a Target, or report it unrecognized. The targets
// maxon-shv2 can build for are listed once, and matched by their own `targetToString`
// spelling — so the parser and the printer read the same table and cannot drift into
// accepting a spelling the compiler cannot name back. A spec that names none of them
// is rejected; the list grows as backends land.
function parseBuildTarget(spec String) returns TargetResolution
	let supported = [Target.create(CpuArch.x64, os: Os.windows), Target.create(CpuArch.x64, os: Os.linux), Target.create(CpuArch.arm64, os: Os.macos), Target.create(CpuArch.arm64, os: Os.linux), Target.create(CpuArch.wasm32, os: Os.wasi)]
	for candidate in supported 'each'
		if targetToString(candidate) == spec 'match'
			return TargetResolution.resolved(candidate)
		end 'match'
	end 'each'
	return TargetResolution.unrecognized(spec)
end 'parseBuildTarget'

// Resolve the optional `--target` flag shared by `build` and `spec-test`: the host target
// (`detectHostTarget`) when the flag is empty, otherwise whatever `parseBuildTarget` makes of the
// spelling (`unrecognized` when it names no known target). Folding the host default into one place
// keeps the two commands from drifting on what "no --target" means.
function resolveTargetFlag(spec String) returns TargetResolution
	if spec.isEmpty() 'host'
		return TargetResolution.resolved(detectHostTarget())
	end 'host'
	return parseBuildTarget(spec)
end 'resolveTargetFlag'

// Report a `--target` spelling that names no known target, as an exit code the
// build command returns directly. Separate from the match arm because a match arm
// is one statement, and this one both prints and yields the code.
function reportUnknownTarget(spec String) returns ExitCode
	printError("error: unknown --target '{spec}' (expected e.g. x64-windows, x64-linux or arm64-macos)\n")
	return 1
end 'reportUnknownTarget'

function runBuild(args MaxonArgs) returns ExitCode
	if args.path.isEmpty() 'noPath'
		printError("Usage: maxon-shv2 build <file|directory> [-o <output>] [--emit-ir] [--target=<cpu>-<os>]\n")
		return 1
	end 'noPath'

	let inputPath = try FilePath.from(args.path) otherwise 'badPath'
		printError("error: invalid path: {args.path}\n")
		return 1
	end 'badPath'

	var target = detectHostTarget()
	match resolveTargetFlag(args.targetSpec) 'targetSel'
		resolved(t) then target = t
		unrecognized(spec) then return reportUnknownTarget(spec)
	end 'targetSel'
	let outputPath = try compile(inputPath, target: target, outputOverride: args.outputOverride, emitIr: args.emitIr, metricsPath: args.metricsPath) otherwise (e) 'compileErr'
		reportCompileError(e)
		return 1
	end 'compileErr'

	print("Compiled -> {outputPath}\n")
	return 0
end 'runBuild'

// The M2 warm-rebuild gate: assert the query spine is deterministic and
// incremental for `<file>`. Exit 0 iff both properties hold. On a file/IO error
// the specific message is printed; a `compileError` stays silent (its diagnostics
// were already printed by the pipeline).
function runVerifyWarmRebuild(args MaxonArgs) returns ExitCode
	if args.path.isEmpty() 'noPath'
		printError("Usage: maxon-shv2 verify-warm-rebuild <file>\n")
		return 1
	end 'noPath'

	let inputPath = try FilePath.from(args.path) otherwise 'badPath'
		printError("error: invalid path: {args.path}\n")
		return 1
	end 'badPath'

	let target = detectHostTarget()
	let bothPass = try verifyWarmRebuild(inputPath, target: target) otherwise (e) 'verifyErr'
		reportCompileError(e)
		return 1
	end 'verifyErr'

	if bothPass 'passed'
		return 0
	end 'passed'

	return 1
end 'runVerifyWarmRebuild'

// The `spec-test [dir]` command: run every active test in `dir` (default `specs-shv2`) on a pool of
// persistent worker subprocesses, print per-test PASS/FAIL + an `N passed, M failed` summary, and
// exit non-zero iff any test failed.
//
// ⚠ TWO EXECUTABLES, NOT ONE — and they were one value until 2026-07-29:
//
//   workerExe    what a pool worker IS. ALWAYS this process (`Process.executablePath`), because a
//                worker is this harness relaunched with `--worker-persistent`. Not settable: a flag
//                that spawned some OTHER harness as a worker has no caller and could only lie.
//   compilerExe  the COMPILER UNDER TEST — the binary each selected test is built with. This
//                process unless `--compiler=<path>` names another.
//
// In-tree they are the same file: the harness IS the compiler, so a freshly built maxon-shv2.exe
// tests itself and both readings land on it. That is why the conflation was invisible — it has
// never once been wrong here. The 🚩 Phase 1 gate is precisely the configuration that separates
// them (a harness compiled by maxon.exe, driving maxon-shv2.exe as the compiler), and with one
// value it would not have failed loudly: it would have PASSED, with both harnesses delegating every
// verdict to the same in-tree binary and agreeing perfectly about nothing.
//
// There is ONE path through the pool, taken by every worker count including `--workers=1`. A serial
// in-process branch for the single-worker case would be a second implementation of "run the suite",
// and the two would drift — which is exactly what the worker-count-invariance gate exists to catch.
function runSpecTest(args MaxonArgs) returns ExitCode
	let specDir = try resolveSpecDir(args) otherwise 'badSpecDir'
		printError("error: invalid spec directory: {args.path}\n")
		return 1
	end 'badSpecDir'

	// What a worker IS. Never `--compiler`: see this function's header.
	let workerExe = try Process.executablePath() otherwise 'noExe'
		printError("error: could not determine the running executable's path\n")
		return 1
	end 'noExe'

	let compilerExe = try resolveCompilerUnderTest(args.compilerPath, workerExe: workerExe) otherwise 'badCompiler'
		printError("error: --compiler must name an existing executable: {args.compilerPath}\n")
		return 1
	end 'badCompiler'

	// The effective target for this run: the host unless `--target` overrode it. Resolved up front so
	// BOTH sides run the SAME target — the dispatcher's pool AND a relaunched worker, which re-parses
	// the same `--target` from its own command line (SpecWorkerPool.spawnNoWait forwards it) and
	// reaches this same resolution. A bad spelling fails once, here. The target reaches each selected
	// test's build (`--target=<cpu>-<os>`) and, for a cross target, its run under the vendored runtime.
	// Resolving before the worker branch prints nothing on the success path (only an unrecognized
	// spelling prints, to stderr, and returns), so the worker's stdout wire stays untouched.
	var effectiveTarget = detectHostTarget()
	match resolveTargetFlag(args.targetSpec) 'targetSel'
		resolved(t) then effectiveTarget = t
		unrecognized(spec) then return reportUnknownTarget(spec)
	end 'targetSel'

	// A WORKER, not a dispatcher: this process was spawned by a parent's pool and speaks the job
	// protocol on stdin/stdout instead of running a suite and reporting on it. It must be checked
	// before anything is printed — a worker's stdout is a wire, not a report.
	if args.workerPersistent 'isPoolWorker'
		return runPersistentWorker(compilerExe, specDir: specDir, filter: args.filter, updateRequired: args.updateRequired, effectiveTarget: effectiveTarget)
	end 'isPoolWorker'

	// Whether the binaries this run is ABOUT to draw conclusions from are older than the tree they
	// were built from, asked before anything is selected. A stale binary reports a verdict about code
	// that is not here — a false red, or the same lie as a false green — so the honest answer is to
	// run nothing at all. Asked by the PARENT for `requireRunnerAvailable`'s reason, and asked AFTER
	// the worker branch above so a worker never re-asks it: one fact, reported once, on the process
	// whose stdout is a report rather than a wire.
	let freshnessExit = refuseIfSpecTestStale(workerExe, compilerExe: compilerExe)
	if freshnessExit != 0 'staleBinary'
		return freshnessExit
	end 'staleBinary'

	// Whether this host can EXECUTE what it is about to build, asked once and by the PARENT. A
	// cross-target run whose runner is missing fails identically for every test, so discovering it
	// per test turns one fact into hundreds of failures — and inside a worker, into a dead pipe whose
	// real message is in another process's stderr. The workers inherit the answer by never starting.
	requireRunnerAvailable(effectiveTarget)

	// The hand-built ladders' index against the ladders themselves, asked once and by the PARENT for
	// `requireRunnerAvailable`'s reason. It rides the suite because the suite is the thing that already
	// runs: a check nobody runs is exactly the drift it exists to catch, one level up (see LadderIndex).
	requireLadderIndexComplete()

	let run = try runSpecPool(compilerExe, workerExe: workerExe, specDir: specDir, filter: args.filter, updateRequired: args.updateRequired, workerCount: args.workers, effectiveTarget: effectiveTarget) otherwise (e) 'runErr'
		reportCompileError(e)
		return 1
	end 'runErr'

	// A run that selected NOTHING is a failure, not a pass. A mistyped `--filter`
	// would otherwise report "0 passed, 0 failed" and exit 0 — a green suite that
	// tested nothing, which is the most expensive kind of lie a test runner can
	// tell. It is worse still under `--update-required`, where an empty selection
	// silently regenerates no goldens while looking like it did the work.
	if run.results.count() == 0 'selectedNothing'
		printError("error: no tests selected{filterSuffix(args.filter)}\n")
		return 1
	end 'selectedNothing'

	let testsExit = reportResults(run.results)
	if testsExit != 0 'someTestFailed'
		return testsExit
	end 'someTestFailed'

	// Every test passed — and a worker that exited NON-ZERO is still a suite failure. A worker is
	// itself a leak-gated Maxon program, so exit 101 means the harness leaked memory while
	// servicing its tests. Green tests must never be allowed to mask that.
	if run.failedWorkers > 0 'workerFailed'
		printError("error: {run.failedWorkers} spec worker(s) exited non-zero (see above) — failing the suite despite {run.results.count()} passing tests\n")
		return 1
	end 'workerFailed'

	return 0
end 'runSpecTest'

// The trailing ` matching --filter=<pattern>` clause of the "no tests selected"
// message, omitted entirely when no filter was given (an empty spec directory and
// a filter that matched nothing are different failures and read differently).
function filterSuffix(filter String) returns String
	if filter.isEmpty() 'noFilter'
		return ""
	end 'noFilter'
	return " matching --filter={filter}"
end 'filterSuffix'

// Resolve the spec directory: an explicit positional argument wins; otherwise
// the default `specs-shv2`, anchored at the current working directory so the
// runner works from the repo root regardless of the absolute cwd.
function resolveSpecDir(args MaxonArgs) returns FilePath throws FilePathError
	if args.path.isEmpty() 'useDefault'
		// Join a FilePath component (not the String overload): a bare String
		// constant is ambiguous between join's String/FilePath overloads. Bind the
		// FilePath to a local first — an inline `try` expression in the argument
		// position does not disambiguate.
		let defaultDir = try FilePath.from(DefaultSpecDir)
		return Directory.currentPath().join(defaultDir)
	end 'useDefault'
	return try FilePath.from(args.path)
end 'resolveSpecDir'

// Raised when `--compiler=<path>` names something that is not there. A THROW rather than a sentinel
// FilePath: there is no path value that means "no path", and falling back to the running executable
// on a bad spelling would run the entire suite against a compiler the caller never named — which is
// the exact failure this flag exists to make impossible.
enum BadCompilerPath implements Error
	none
end 'BadCompilerPath'

// Resolve the COMPILER UNDER TEST: `--compiler=<path>` when given, else the running executable
// (the in-tree case, where the harness IS the compiler).
//
// An EMPTY `spec` means the flag was ABSENT, and only that: a `--compiler=` typed with no value is
// refused by the parser as a bad option (see MaxonArgs.parse), because it would otherwise arrive
// here indistinguishable from "not given" and be answered with the running executable — the same
// wrong answer this function throws on, reached through the argument parser instead of the
// filesystem.
//
// The path is validated HERE — once, in the parent, before a worker exists. That is the same
// discipline `requireRunnerAvailable` and the `--target` spelling already follow, and for the same
// measured reason: a bad compiler path discovered per test turns ONE fact into hundreds of
// identical failures, and discovered inside a worker it turns into a dead pipe whose real message
// is in another process's stderr.
function resolveCompilerUnderTest(spec String, workerExe FilePath) returns FilePath throws BadCompilerPath
	if spec.isEmpty() 'runningExe'
		return workerExe
	end 'runningExe'

	let named = try FilePath.from(spec) otherwise throw BadCompilerPath.none

	if not File.exists(named) 'missing'
		throw BadCompilerPath.none
	end 'missing'

	return named
end 'resolveCompilerUnderTest'

// Print each test's verdict and the summary, returning the process exit code (1
// iff any test failed). The PASS/FAIL line is built via a match EXPRESSION (both
// arms yield a real string) so the fail reason is extracted without a sentinel.
function reportResults(results SpecTestResultArray) returns ExitCode
	var passed = 0
	var failed = 0

	for result in results 'each'
		let label = "{result.specName}/{result.testName}"
		let line = match result.outcome 'verdict'
			pass gives "PASS {label}"
			fail(reason) gives "FAIL {label}: {reason}"
		end 'verdict'
		print("{line}\n")

		if result.outcome.isPass() 'countPass'
			passed = passed + 1
		end 'countPass' else 'countFail'
			failed = failed + 1
		end 'countFail'
	end 'each'

	print("\n{passed} passed, {failed} failed\n")

	if failed > 0 'anyFailed'
		return 1
	end 'anyFailed'
	return 0
end 'reportResults'

// The FIRST bad option wins. A command line can be wrong in several ways at once, and reporting the
// last one found would point at whichever flag happened to be typed rightmost rather than at the one
// the reader would look for first.
function firstBadOption(current String, arg String) returns String
	if current.isEmpty() 'firstBad'
		return arg
	end 'firstBad'
	return current
end 'firstBadOption'

// Print the user-facing message for a file/IO CompileError. The `compileError` arm
// is SILENT: its diagnostics were already printed by the pipeline, so stderr stays
// exactly those diagnostic lines (the `maxoncstderr` spec contract). Shared by
// every command's failure path so the mapping lives in one place — including the
// scale-test runner, which is why it is exported.
export function reportCompileError(e CompileError)
	match e 'report'
		fileNotFound(p) then printError("error: file not found: {p}\n")
		directoryNotFound(p) then printError("error: directory not found: {p}\n")
		noSourceFiles(r) then printError("error: no source files under {r}\n")
		readError(p) then printError("error: could not read {p}\n")
		stdlibNotFound then printError("error: could not locate the stdlib/ directory (every compile loads stdlib source)\n")
		compileError then break 'report'
	end 'report'
end 'reportCompileError'

function unknownCommand() returns ExitCode
	printUsage()
	return 1
end 'unknownCommand'

function printUsage()
	print("Usage: maxon-shv2 <command> [options]\n")
	print("\n")
	print("Commands:\n")
	print("  build <file|directory>        Compile a Maxon program to an executable\n")
	print("  verify-warm-rebuild <file>    Assert the query spine is deterministic + incremental\n")
	print("  spec-test [dir]               Run the specs-shv2 suite (default dir: specs-shv2)\n")
	print("  scale-test                    Compile a ladder of generated programs, each rung double the\n")
	print("                                last, and report the per-phase MEMORY — allocations, frees and\n")
	print("                                bytes — plus the CPU TICKS the compiling thread spent. It does\n")
	print("                                NOT collect WALL time: wall time counts every other process on\n")
	print("                                the box, so a dated table of it would compare a loaded machine\n")
	print("                                in July against an idle one in August. The ladder doubles, so\n")
	print("                                the ratio between rungs IS the growth (x2.00 linear, x4.00\n")
	print("                                quadratic) and nothing is fitted. An INSTRUMENT, not a gate: it\n")
	print("                                renders no verdict, and it exits non-zero only when the RUN\n")
	print("                                broke. The trend it feeds is {OptimizationLogRelativePath}.\n")
	print("\n")
	print("Options:\n")
	print("  -o, --output=<path>           Output executable path (default: derived from input)\n")
	print("  --emit-ir                     Also write the lowered Target IR beside the exe as <output>.ir\n")
	print("  --target=<cpu>-<os>           (build, spec-test) Use this target instead of the host, e.g.\n")
	print("                                x64-windows, x64-linux, arm64-macos or wasm32-wasi (default: the host\n")
	print("                                target). For spec-test a cross target cross-compiles each\n")
	print("                                selected test and runs it under the vendored runtime.\n")
	print("  --compiler=<path>             (spec-test) Build each selected test with THIS compiler instead\n")
	print("                                of the running executable. The pool's workers are still this\n")
	print("                                executable relaunched — the two are different facts, identical\n")
	print("                                in-tree and separate wherever the harness is not the compiler.\n")
	print("  --metrics=<path>              (build) Write this compile's per-phase time + memory\n")
	print("                                attribution to <path> as TSV. `--log=compiler:debug` prints\n")
	print("                                the same numbers as a human-readable table.\n")
	print("  --filter=<pattern>            (spec-test) Run only tests whose `<spec>/<test>` label contains\n")
	print("                                <pattern>. A bare spec name selects that whole spec.\n")
	print("  --update-required             (spec-test) Rewrite the committed .test goldens instead of\n")
	print("                                checking against them. Running a test proves its allocation\n")
	print("                                is CORRECT; only the pinned IR proves the code did not get\n")
	print("                                WORSE. REVIEW THE RESULTING DIFF. Pair it with --filter: an\n")
	print("                                unfiltered run rewrites EVERY golden in the suite.\n")
	print("  --workers=<n>                 (spec-test) Run the suite on <n> persistent worker\n")
	print("                                subprocesses (default {DefaultWorkerCount}). 1 is this same pool with one\n")
	print("                                worker in it, NOT a serial path — every worker count must\n")
	print("                                print BYTE-IDENTICAL output, and that invariance is the\n")
	print("                                pool's sharpest gate.\n")
	print("  --rungs=<n>                   (scale-test) Climb <n> rungs (default {DefaultRungCount},\n")
	print("                                range {MinRungCount}-{MaxRungCount}). Each rung DOUBLES the\n")
	print("                                program, so this is exponential in cost.\n")
	print("  --repeat=<n>                  (scale-test) Compile every rung <n> times (default\n")
	print("                                {DefaultRepeatCount}, range {MinRepeatCount}-{MaxRepeatCount}) and report the LEAST CPU ticks\n")
	print("                                any of them spent in each phase — the least-disturbed sample,\n")
	print("                                since noise can only ADD to a CPU reading and a mean would be\n")
	print("                                dragged by one stall. The MEMORY columns take nothing from a\n")
	print("                                repeat: they are exact, so they come from the first compile and\n")
	print("                                are CROSS-CHECKED for equality against the rest. A memory number\n")
	print("                                that differs between two compiles of one rung is a BROKEN RUN.\n")
	print("  --note=<text>                 (scale-test) Record this run in {OptimizationLogRelativePath}\n")
	print("                                — one dated row of the per-rung allocations and bytes, with\n")
	print("                                <text> as the reason. Without it a run reports and records\n")
	print("                                nothing; WITH it the row is written, moved or not, because it is\n")
	print("                                an INSTRUCTION. The instrument can see exactly WHAT moved and can\n")
	print("                                never see why; you are the only one who knows, and only now.\n")
	print("  --per-type                    (scale-test) Also run the --mm-trace pass, attributing\n")
	print("                                allocations to the TYPE allocated AND to the SCOPE that\n")
	print("                                allocated it — the scope table is the one that finds things. Off\n")
	print("                                by default: it is slow, and it is a different binary from the\n")
	print("                                one being measured.\n")
	print("  --emit-corpus=<dir>           (scale-test) Dump the generated corpus to <dir> for inspection\n")
	print("                                (it is otherwise built into a temp dir and thrown away).\n")
	print("  --result-json=<path>          (scale-test) Write the whole run — per-rung and per-phase memory,\n")
	print("                                and the deltas from the last recorded run — to <path> as JSON, so\n")
	print("                                a tool never has to scrape the human report.\n")
end 'printUsage'

// The parsed command the driver dispatches on.
enum MaxonCommand
	build
	verifyWarmRebuild
	specTest
	scaleTest
	unknown
end 'MaxonCommand'

// Thin M1 argument model: a command, an input path, an optional output override,
// and the `--emit-ir` toggle. Grows into v1's full option set (targets, logging,
// cache flags, ...) as the driver gains those capabilities.
// Exported: the scale-test runner lives in Testing/ and takes the parsed args, exactly as the
// spec-test runner takes them from inside Main.
export type MaxonArgs
	export let command as MaxonCommand
	export let path as String
	export let outputOverride as String
	export let emitIr as bool
	// `--filter=<pattern>` (spec-test only): run only the tests whose `<spec>/<test>` label
	// contains <pattern>. Empty selects the whole suite.
	export let filter as String
	// `--update-required` (spec-test only): REWRITE the committed `.test` goldens instead of
	// checking the emitted IR against them. The goldens are a code-quality gate — running a test
	// proves its allocation is CORRECT, but only the pinned IR can say the code did not get WORSE
	// (an extra spill still computes the right answer). So regenerating them is the one way a
	// codegen change enters the tree, and it is deliberately an explicit act: the diff is the review.
	export let updateRequired as bool
	// `--workers=<n>` (spec-test only): how many persistent worker subprocesses the pool runs. 1 is
	// the SAME pool with one worker in it, not a serial in-process branch — see runSpecTest.
	export let workers as WorkerCount
	// `--worker-persistent` (spec-test only, INTERNAL): this process IS a pool worker. Set by the
	// parent dispatcher on the command line it spawns, never typed by a person, and therefore left
	// out of the usage text. Undocumented but PARSED: an unrecognized flag aborts the run, so a
	// worker whose own flag was not understood would fail to start at all.
	export let workerPersistent as bool
	// `--compiler=<path>` (spec-test only): the COMPILER UNDER TEST — the binary each selected test
	// is built with. Empty means the flag was ABSENT — "the running executable", the in-tree case
	// where the harness IS the compiler and a freshly built maxon-shv2.exe tests itself. A
	// `--compiler=` with no value never reaches this field: `parse` records it as a bad option, so
	// empty cannot mean two things.
	//
	// It is a SEPARATE fact from the executable a pool worker is relaunched as (always this process;
	// see runSpecTest). The Phase 1 gate is the configuration that separates them — a harness
	// compiled by maxon.exe driving maxon-shv2.exe as the compiler — and without this flag that gate
	// would pass while every verdict came from the in-tree harness.
	export let compilerPath as String
	// `--metrics=<path>` (build only): write this compile's per-phase time + memory attribution as
	// TSV to <path> (see MetricsEmit). The scale-test harness reads it back; a human wants
	// `--log=compiler:debug`, which prints the same numbers as a table.
	export let metricsPath as String
	// `--emit-corpus=<dir>` (scale-test only): dump the generated scaling corpus to <dir> for
	// inspection instead of the temp directory it is otherwise built into and thrown away.
	export let emitCorpus as String
	// `--rungs=<n>` (scale-test only): how many rungs of the ladder to climb. Each doubles the
	// program, so this is exponential in cost — see ScaleCorpus.
	export let rungs as RungCount
	// `--repeat=<n>` (scale-test only): how many times each rung is compiled. The CPU column takes
	// the MINIMUM of the repeats (the least-disturbed sample); the memory columns take the first and
	// are cross-checked for equality across the rest, since they are bit-for-bit reproducible and a
	// difference is a broken run — see ScaleTestRunner's header.
	export let repeat as RepeatCount
	// `--per-type` (scale-test only): also run the untimed `--mm-trace` pass, which attributes
	// allocations to the TYPE allocated AND to the SCOPE that allocated it. Off by default: it traces
	// every allocation individually and is far slower than the timed run.
	export let perType as bool
	// `--note=<text>` (scale-test only): RECORD this run in docs/optimization-log.md, with <text> as
	// the reason. A run without it reports and records nothing — scale-test is run dozens of times a
	// day against dirty trees, and a log of all of them would be a log nobody reads. WITH it the row is
	// written, whether or not a number moved: it is an INSTRUCTION from the operator, who is the only
	// party who knows whether the run is a datapoint. The instrument can see exactly WHAT moved and can
	// never see why, so the reason is demanded at the one moment it is still known — see
	// Testing/ScaleHistory.maxon.
	export let note as String
	// `--result-json=<path>` (scale-test only): write the run's full result — per-rung and per-phase
	// memory, and the deltas from the last recorded run — as JSON.
	//
	// This exists so the MCP tool does not SCRAPE the human report. The report's columns are padded
	// to be read by a person; the day a phase name outgrows its column, a scrape would silently
	// mis-parse rather than fail. A caller that wants data gets data.
	export let resultJson as String
	// `--target=<cpu>-<os>` (build, spec-test): use this target instead of the host
	// (`detectHostTarget`). Empty selects the host. Resolved to a Target via `resolveTargetFlag` in
	// both `runBuild` and `runSpecTest`; an unknown spelling aborts. Needed to cross-compile
	// x64-windows on an arm64 host for golden verification, to select arm64-macos explicitly, and to
	// drive the spec suite through the wasm32-wasi backend (cross-compile-and-run under wasmtime).
	export let targetSpec as String
	// Set when an argument could not be understood. The driver refuses to run rather
	// than proceed on a command line it only partly parsed — see `parse`.
	export let badOption as String

	// Parse the process command line. argv[0] is the executable path (skipped).
	// The first `build` token selects the command; the first bare (non-flag)
	// argument is the input path; `-o <path>` / `--output=<path>` set the output;
	// `--emit-ir` requests the Target-IR sidecar; `--filter=<pattern>` narrows the
	// spec-test selection; `--update-required` regenerates the spec-test goldens.
	//
	// An unrecognized `-`-leading argument is RECORDED, not ignored. It used to fall
	// through to the positional branch and become the input path, so `spec-test
	// --mm-trace` quietly looked for a spec directory literally named `--mm-trace`
	// and reported an empty suite. A flag the driver does not implement must fail
	// loudly, not be absorbed into an unrelated slot.
	export static function parse() returns MaxonArgs
		var command = MaxonCommand.unknown
		var path = ""
		var outputOverride = ""
		var emitIr = false
		var filter = ""
		var updateRequired = false
		var workers = DefaultWorkerCount
		var workerPersistent = false
		var compilerPath = ""
		var metricsPath = ""
		var emitCorpus = ""
		var rungs = DefaultRungCount
		var repeat = DefaultRepeatCount
		var perType = false
		var note = ""
		var resultJson = ""
		var targetSpec = ""
		var badOption = ""

		let args = CommandLine.args()
		var i = 1
		while i < args.count() 'each'
			let arg = try args.get(i) otherwise panic("MaxonArgs.parse: index {i} >= args.count() despite the while guard i<args.count()")
			if arg == "build" 'buildCmd'
				command = MaxonCommand.build
			end 'buildCmd' else if arg == "verify-warm-rebuild" 'verifyCmd'
				command = MaxonCommand.verifyWarmRebuild
			end 'verifyCmd' else if arg == SpecTestCommandName 'specTestCmd'
				command = MaxonCommand.specTest
			end 'specTestCmd' else if arg == "scale-test" 'scaleTestCmd'
				command = MaxonCommand.scaleTest
			end 'scaleTestCmd' else if arg == "-o" 'dashOutput'
				i = i + 1
				outputOverride = try args.get(i) otherwise ""
			end 'dashOutput' else if arg.startsWith("--output=") 'longOutput'
				outputOverride = try CommandLine.optionValue(arg) otherwise ""
			end 'longOutput' else if arg == "--emit-ir" 'emitIrFlag'
				emitIr = true
			end 'emitIrFlag' else if arg.startsWith(FilterFlagPrefix) 'filterFlag'
				filter = try CommandLine.optionValue(arg) otherwise ""
			end 'filterFlag' else if arg == UpdateRequiredFlag 'updateRequiredFlag'
				updateRequired = true
			end 'updateRequiredFlag' else if arg.startsWith(WorkersFlagPrefix) 'workersFlag'
				let raw = try CommandLine.optionValue(arg) otherwise ""
				// A bad value is a BAD OPTION, not a clamp — the same door as `--rungs`. `--workers=0`
				// asks for a pool that can run nothing; quietly running the default instead would
				// answer a question the caller never asked. See SpecWorkerPool.parseWorkerCount.
				match parseWorkerCount(raw) 'workersArg'
					valid(count) then workers = count
					invalid then badOption = firstBadOption(badOption, arg: arg)
				end 'workersArg'
			end 'workersFlag' else if arg == WorkerPersistentFlag 'workerPersistentFlag'
				workerPersistent = true
			end 'workerPersistentFlag' else if arg.startsWith(CompilerFlagPrefix) 'compilerFlag'
				let named = try CommandLine.optionValue(arg) otherwise ""
				// A VALUELESS `--compiler=` is a BAD OPTION, not "no flag" — the same door as
				// `--workers=` and `--rungs=` above. Empty is how this field spells "the caller named no
				// compiler", so letting an empty VALUE reach it would run the whole suite against the
				// running executable under a command line that named some other one — the exact failure
				// `resolveCompilerUnderTest` refuses a MISSPELLED path for, arrived at by a different
				// door. It is the reachable form, not the theoretical one: a wrapper whose
				// `--compiler=$CUT` expanded empty gets a GREEN suite that tested the wrong binary, and
				// green is the one answer nobody re-reads.
				if named.isEmpty() 'noCompilerValue'
					badOption = firstBadOption(badOption, arg: arg)
				end 'noCompilerValue' else 'hasCompilerValue'
					compilerPath = named
				end 'hasCompilerValue'
			end 'compilerFlag' else if arg.startsWith("--metrics=") 'metricsFlag'
				metricsPath = try CommandLine.optionValue(arg) otherwise ""
			end 'metricsFlag' else if arg.startsWith("--emit-corpus=") 'emitCorpusFlag'
				emitCorpus = try CommandLine.optionValue(arg) otherwise ""
			end 'emitCorpusFlag' else if arg.startsWith("--rungs=") 'rungsFlag'
				let raw = try CommandLine.optionValue(arg) otherwise ""
				// A bad value is recorded as a BAD OPTION, not clamped to the default. `main` refuses
				// to run on a command line it only partly understood, which is the only honest
				// response to `--rungs=99`: the caller asked for a ladder this suite will not climb
				// (each rung DOUBLES the program), and quietly climbing a different one would answer
				// a question they never asked. See ScaleCorpus.parseRungCount.
				match parseRungCount(raw) 'rungsArg'
					valid(count) then rungs = count
					invalid then badOption = firstBadOption(badOption, arg: arg)
				end 'rungsArg'
			end 'rungsFlag' else if arg.startsWith("--repeat=") 'repeatFlag'
				let raw = try CommandLine.optionValue(arg) otherwise ""
				// The same door as `--rungs` and `--workers`: a bad value is a BAD OPTION, not a
				// clamp. `--repeat=0` asks for a rung that is never compiled, and quietly compiling
				// it three times would answer a question the caller never asked — the run they get
				// back would then differ from the one they typed in the column that is least able to
				// prove it. See ScaleTestRunner.parseRepeatCount.
				match parseRepeatCount(raw) 'repeatArg'
					valid(count) then repeat = count
					invalid then badOption = firstBadOption(badOption, arg: arg)
				end 'repeatArg'
			end 'repeatFlag' else if arg == "--per-type" 'perTypeFlag'
				perType = true
			end 'perTypeFlag' else if arg.startsWith("--note=") 'noteFlag'
				note = try CommandLine.optionValue(arg) otherwise ""
			end 'noteFlag' else if arg.startsWith("--result-json=") 'resultJsonFlag'
				resultJson = try CommandLine.optionValue(arg) otherwise ""
			end 'resultJsonFlag' else if arg.startsWith(TargetFlagPrefix) 'targetFlag'
				targetSpec = try CommandLine.optionValue(arg) otherwise ""
			end 'targetFlag' else if arg.startsWith("--log=") 'logFlag'
				var spec = try CommandLine.optionValue(arg) otherwise ""
				if not parseLogOption(spec) 'badSpec'
					printError("Unrecognized --log spec '{spec}' (expected <level> or <category>:<level>)\n")
				end 'badSpec'
			end 'logFlag' else if arg.startsWith("-") 'unknownFlag'
				if badOption.isEmpty() 'firstBad'
					badOption = arg
				end 'firstBad'
			end 'unknownFlag' else 'positional'
				if path.isEmpty() 'firstPositional'
					path = arg
				end 'firstPositional'
			end 'positional'
			i = i + 1
		end 'each'

		return Self{command: command, path: path, outputOverride: outputOverride, emitIr: emitIr, filter: filter, updateRequired: updateRequired, workers: workers, workerPersistent: workerPersistent, compilerPath: compilerPath, metricsPath: metricsPath, emitCorpus: emitCorpus, rungs: rungs, repeat: repeat, perType: perType, note: note, resultJson: resultJson, targetSpec: targetSpec, badOption: badOption}
	end 'parse'
end 'MaxonArgs'
