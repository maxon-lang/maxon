// Queries — the typed, memoized query functions, one per frontend phase. Each
// follows the classic memo pattern: record the caller's dependency on this
// query, return the cached value if still valid (content-hash compare), else
// push self onto the active-query stack, clear+rebuild deps, compute, pop, and
// cache. The mechanics live in QueryEngine.maxon.
//
// The chain is:
//   querySourceFile  (input; never computed)
//     -> queryTokens   (per-file memo; tokenize)
//       -> queryParseOps (per-file memo; Parser -> FileParseArtifact)
//         -> queryAllModule (whole-program; mergeArtifact fold)
//
// The load-bearing shv2 differences from v1: (1) memo validity is a content-hash
// compare, not a revision walk; (2) queryParseOps produces a `FileParseArtifact`
// and touches NO `Project` state — the parser is a pure function; (3)
// queryAllModule rebuilds the derived registries from artifacts on every miss
// (resetMergeTargets), so there is no ParseDelta rollback dance.

// --- Input query: source content (records the source-file dependency) ---
function querySourceFile(project Project, path FilePath) returns String throws CompileError
	recordDependency(project, dependency: QueryKey.sourceFile(path))
	let entry = try project.db.sourceFiles.get(path) otherwise throw CompileError.fileNotFound(path)
	return entry.content
end 'querySourceFile'

// --- Per-file query: tokenize ---
function queryTokens(project Project, path FilePath) returns TokenArray throws CompileError
	let key = QueryKey.tokens(path)
	recordDependency(project, dependency: key)

	if tokensCacheValid(project, path: path) 'hit'
		let memo = try project.db.tokenCache.get(path) otherwise panic("queryTokens: tokensCacheValid true but tokenCache.get({path}) failed")
		project.db.tokenHits = project.db.tokenHits + 1
		return memo.value
	end 'hit'
	project.db.tokenMisses = project.db.tokenMisses + 1

	pushQuery(project, key: key)
	clearDepsFor(project, key: key)

	let content = try querySourceFile(project, path: path)

	// The `lex` phase is probed HERE, around `tokenize` alone — the leaf. `queryParseOps`
	// calls this query BEFORE it opens its own `parse` probe, so the two phases are
	// disjoint by construction and neither has to subtract the other out. A cache hit
	// returned above does no lexing and is correctly billed nothing.
	let lexProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.lex)
	let tokens = try tokenize(content) otherwise (lexErr) 'lexFail'
		reportLexerError(project, path: path, error: lexErr)
		popQuery(project)
		// A failed tokenize is NOT cached — the diagnostic gates the build, and
		// the next attempt must re-run against corrected source.
		return TokenArray.create()
	end 'lexFail'
	recordPhase(project, phase: CompilePhase.lex, probe: lexProbe)

	popQuery(project)

	let entry = try project.db.sourceFiles.get(path) otherwise panic("queryTokens: source entry for {path} vanished after querySourceFile")
	project.db.tokenCache.upsert(path, value: TokenMemo.create(tokens, keyHash: entry.contentHash))
	return tokens
end 'queryTokens'

// --- Per-file query: parse into a FileParseArtifact ---
function queryParseOps(project Project, path FilePath) returns FileParseArtifact throws CompileError
	let key = QueryKey.parseOps(path)
	recordDependency(project, dependency: key)

	if parseCacheValid(project, path: path) 'hit'
		let memo = try project.db.parseCache.get(path) otherwise panic("queryParseOps: parseCacheValid true but parseCache.get({path}) failed")
		project.db.parseHits = project.db.parseHits + 1
		return memo.value
	end 'hit'
	project.db.parseMisses = project.db.parseMisses + 1

	pushQuery(project, key: key)
	clearDepsFor(project, key: key)

	let tokens = try queryTokens(project, path: path)

	// The `parse` probe opens only NOW — after the tokens query has returned — so it bills
	// the parse alone and never absorbs the lexing it depends on. (The alternative,
	// wrapping the whole query body and subtracting `lex` back out, is what the register
	// allocator has to do for liveness; here the call order makes it unnecessary.) It
	// spans everything the parse query itself does: building the parser, the parse
	// proper, the termination assert, and the memo write.
	let parseProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.parse)

	// M1 single-file build: namespace is empty (no cross-file qualification).
	// Namespace derivation from the path grows with multi-file builds at M2.
	var parser = Parser.create(tokens, filePath: path, namespace: "")
	let errorCountBefore = project.diagnostics.count()
	let artifact = try parser.parseModule() otherwise (parseErr) 'parseFail'
		reportParseError(project, path: path, error: parseErr)
		popQuery(project)
		// A failed parse is never cached (preserves v1's invariant): the empty
		// artifact is returned so the caller rolls forward to the error gate.
		return FileParseArtifact.create(path)
	end 'parseFail'

	popQuery(project)

	// Only cache a clean parse — a parse that reported a diagnostic must re-run.
	let hadErrors = project.diagnostics.count() > errorCountBefore
	if not hadErrors 'cacheOk'
		artifact.module.assertAllBlocksTerminated()
		let entry = try project.db.sourceFiles.get(path) otherwise panic("queryParseOps: source entry for {path} vanished")
		project.db.parseCache.upsert(path, value: ParseMemo.create(artifact, keyHash: entry.contentHash))
	end 'cacheOk'

	recordPhase(project, phase: CompilePhase.parse, probe: parseProbe)
	return artifact
end 'queryParseOps'

// --- Whole-program query: merge every file's artifact ---
export function queryAllModule(project Project) returns MaxonModule throws CompileError
	recordDependency(project, dependency: QueryKey.allModule)

	if allModuleCacheValid(project) 'hit'
		project.db.allModuleHits = project.db.allModuleHits + 1
		return project.db.allModuleCache.value
	end 'hit'
	project.db.allModuleMisses = project.db.allModuleMisses + 1

	pushQuery(project, key: QueryKey.allModule)
	clearDepsFor(project, key: QueryKey.allModule)

	// Artifacts are the source of truth for the derived registries; a miss
	// rebuilds them from scratch so a warm re-run never double-commits. This is
	// the shv2 replacement for v1's per-file beginFileParse rollback — a clean
	// reset, since the parser wrote nothing to Project speculatively.
	resetMergeTargets(project)

	// `merge` is probed around `mergeArtifact` ALONE: `queryParseOps` is called outside
	// the probe on each iteration, so the fold's cost never absorbs the parse's (the
	// leaf-timing discipline in CompileTimings' header).
	var merged = MaxonModule.create()
	for path in project.db.sourcePaths 'eachFile'
		let artifact = try queryParseOps(project, path: path)

		let mergeProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.merge)
		mergeArtifact(project, target: merged, artifact: artifact)
		recordPhase(project, phase: CompilePhase.merge, probe: mergeProbe)
	end 'eachFile'

	popQuery(project)

	project.db.allModuleCache = ModuleMemo.create(merged, keyHash: compositeSourceHash(project), computed: true)
	return merged
end 'queryAllModule'

// Re-run the per-file queries (tokens, then parse) for every source file. The M2
// warm-rebuild gate uses this to PROVE the per-file memos survived a whole-program
// rebuild: after `queryAllModule` has populated them on a cold pass, a subsequent
// `queryAllModule` is a whole-program HIT that returns early and never revisits the
// per-file caches — so to observe those caches are still hot, the gate re-queries
// them directly. Each re-query must land as a cache HIT (content-hash re-validated,
// not recomputed), moving `tokenHits`/`parseHits` up while their MISS counts hold.
//
// `queryTokens`/`queryParseOps` stay file-private; this is the one exported entry
// the gate needs. Called at top level the active-query stack is empty, so the
// `recordDependency` calls inside these queries are no-ops — no spurious edges.
export function probeRebuildCacheHits(project Project) throws CompileError
	for path in project.db.sourcePaths 'each'
		// Both queries must run: a queryParseOps HIT returns before it would reach
		// queryTokens, so querying tokens separately is what moves `tokenHits`.
		_ = try queryTokens(project, path: path)
		_ = try queryParseOps(project, path: path)
	end 'each'
end 'probeRebuildCacheHits'

// Clear the registries that `mergeArtifact` rebuilds from artifacts, so a
// queryAllModule miss re-derives them cleanly rather than compounding a prior
// run's commits.
function resetMergeTargets(project Project)
	project.funcReturnTypes = FuncReturnTypeMap.create()
	project.funcSignatures = FuncSignatureMap.create()
	project.typeAliases = RangedTypeAliasMap.create()
	project.typeNames = TypeNameInterner.create()
	// Must reset with the others: `mergeArtifact` appends spans to this table and
	// asserts its count tracks the merged module's op count. The module accumulator
	// (`merged`) is rebuilt from empty on every miss, so a span table carried over
	// from a prior run would start out of step and trip that assert.
	project.opRanges = SourceRangeTable.create()
end 'resetMergeTargets'

// Map a fatal LexerError to a project diagnostic. M1 reports every kind under a
// single generic lexer code (the authored specs never trigger these; specific
// codes grow when a spec needs a particular lexer diagnostic).
function reportLexerError(project Project, path FilePath, error LexerError)
	match error 'kind'
		unexpectedEof(line, column) then reportPositioned(project, code: ErrorCode.lexerError, message: "Unexpected end of input", line: line, column: column, filePath: path)
		unterminatedString(line, column) then reportPositioned(project, code: ErrorCode.lexerError, message: "Unterminated string literal", line: line, column: column, filePath: path)
		unterminatedBlockComment(line, column) then reportPositioned(project, code: ErrorCode.lexerError, message: "Unterminated block comment", line: line, column: column, filePath: path)
		unescapedBrace(line, column) then reportPositioned(project, code: ErrorCode.lexerError, message: "Unescaped '\{' in string literal", line: line, column: column, filePath: path)
		unknownDirective(name, line, column) then reportPositioned(project, code: ErrorCode.lexerError, message: "Unknown compiler directive '#{name}'", line: line, column: column, filePath: path)
	end 'kind'
end 'reportLexerError'

// Map a ParseError to a project diagnostic. The unexpected-token case is the
// spec-gated E2010 (`parserExpectedToken`) — its exact `Expected '<x>' but got
// '<y>'` text + positioned prefix is compared byte-for-byte by `variables.md`'s
// type-annotation-rejection tests. `undefinedVariable` joins `expectedExpression`
// under E2004: both are EXPRESSION-level parse failures, and E2004 is the code the
// corpus (and both reference compilers) use for a name with no binding in scope —
// see ErrorCode. The remaining arms have no spec-gated text yet, so they report
// under the generic parser code and split off as specs need them (mirrors
// reportLexerError).
function reportParseError(project Project, path FilePath, error ParseError)
	match error 'kind'
		unexpectedToken(expected, got, line, column) then reportPositioned(project, code: ErrorCode.parserExpectedToken, message: "Expected '{expected}' but got '{got}'", line: line, column: column, filePath: path)
		expectedExpression(got, line, column) then reportPositioned(project, code: ErrorCode.parserExpressionError, message: "Expected expression but got '{got}'", line: line, column: column, filePath: path)
		unexpectedEof(line, column) then reportPositioned(project, code: ErrorCode.parserError, message: "Unexpected end of input", line: line, column: column, filePath: path)
		integerOverflow(line, column) then reportPositioned(project, code: ErrorCode.parserError, message: "Integer literal out of range", line: line, column: column, filePath: path)
		unsupported(feature, line, column) then reportPositioned(project, code: ErrorCode.parserError, message: "Unsupported: {feature}", line: line, column: column, filePath: path)
		duplicateParameter(name, line, column) then reportPositioned(project, code: ErrorCode.duplicateParameter, message: "duplicate parameter name '{name}'", line: line, column: column, filePath: path)
		undefinedVariable(name, line, column) then reportPositioned(project, code: ErrorCode.parserExpressionError, message: "Undefined variable '{name}'", line: line, column: column, filePath: path)
		missingReturn(name, line, column) then reportPositioned(project, code: ErrorCode.missingReturn, message: "missing return statement: '{name}'", line: line, column: column, filePath: path)
		returnValueFromVoid(name, line, column) then reportPositioned(project, code: ErrorCode.typeMismatch, message: "type mismatch: '{name}' declares no return type, so it cannot return a value", line: line, column: column, filePath: path)
		returnWithoutValue(name, line, column) then reportPositioned(project, code: ErrorCode.missingReturn, message: "missing return value: '{name}' declares a return type, so every 'return' must carry a value", line: line, column: column, filePath: path)
		assignToImmutable(name, line, column) then reportPositioned(project, code: ErrorCode.assignToImmutable, message: "cannot assign to immutable variable: '{name}'", line: line, column: column, filePath: path)
		controlOutsideLoop(keyword, line, column) then reportPositioned(project, code: ErrorCode.controlOutsideLoop, message: "'{keyword}' can only be used inside a loop", line: line, column: column, filePath: path)
		labelTargetsOwnLoop(keyword, label, line, column) then reportPositioned(project, code: ErrorCode.labelTargetsOwnLoop, message: "'{keyword}' with label '{label}' targets its own loop; use '{keyword}' without a label, or '{keyword}' with the label of an outer loop", line: line, column: column, filePath: path)
		unknownLoopLabel(keyword, label, line, column) then reportPositioned(project, code: ErrorCode.controlOutsideLoop, message: "'{keyword}' targets no enclosing loop with label '{label}'", line: line, column: column, filePath: path)
		firstArgNamed(line, column) then reportPositioned(project, code: ErrorCode.callFirstArgNamed, message: "the first argument cannot be named; only the second and later arguments take 'name:' labels", line: line, column: column, filePath: path)
		argMissingLabel(line, column) then reportPositioned(project, code: ErrorCode.callArgMissingLabel, message: "the second and later arguments must be named ('name: value')", line: line, column: column, filePath: path)
		operandTypeMismatch(op, line, column) then reportPositioned(project, code: ErrorCode.typeMismatch, message: "operator '{op}' requires both operands to be the same type (both bool or both int)", line: line, column: column, filePath: path)
		nonNumericOperands(left, right, line, column) then reportPositioned(project, code: ErrorCode.parserExpressionError, message: "Cannot operate on {left} and {right}", line: line, column: column, filePath: path)
		nonNumericNegation(operand, line, column) then reportPositioned(project, code: ErrorCode.parserExpressionError, message: "Cannot negate {operand}", line: line, column: column, filePath: path)
		comparisonTypeMismatch(left, right, line, column) then reportPositioned(project, code: ErrorCode.typeMismatch, message: "type mismatch: 'cannot compare {left} with {right}'", line: line, column: column, filePath: path)
		nonBoolCondition(keyword, got, line, column) then reportPositioned(project, code: ErrorCode.typeMismatch, message: "'{keyword}' requires a bool condition, got '{got}'", line: line, column: column, filePath: path)
		assignTypeMismatch(name, got, expected, line, column) then reportPositioned(project, code: ErrorCode.typeMismatch, message: "cannot assign '{got}' to variable '{name}' of type '{expected}'", line: line, column: column, filePath: path)
		returnTypeMismatch(got, expected, line, column) then reportPositioned(project, code: ErrorCode.typeMismatch, message: "Cannot return '{got}' from function declared to return '{expected}'", line: line, column: column, filePath: path)
		invalidCharacterLiteral(reason, line, column) then reportPositioned(project, code: ErrorCode.parserError, message: "invalid character literal: {reason}", line: line, column: column, filePath: path)
		notOnUnknownType(line, column) then reportPositioned(project, code: ErrorCode.typeMismatch, message: "'not' needs its operand's type: `not` is a bit-flip on a bool and a 64-bit complement on an int, and this operand's type is not known in this file (it is a call to a function declared elsewhere)", line: line, column: column, filePath: path)
	end 'kind'
end 'reportParseError'
