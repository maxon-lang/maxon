// Queries — the typed, memoized query functions, one per frontend phase. Each is the
// memo pattern with nothing else in it: return the cached value if still valid
// (content-hash compare), else compute and cache. The mechanics live in QueryEngine.maxon.
//
// There is no dependency bookkeeping around the compute — no edge recorded, no active-query
// stack pushed and popped — because nothing read what that bookkeeping produced, and a memo's
// inputs are named where its KEY is computed rather than observed as it runs. See
// QueryDatabase.maxon's header.
//
// The chain is:
//   db.sourceFiles   (input; never computed — registered by `fileChanged`)
//     -> queryTokens   (per-file memo; tokenize)
//       -> queryProgramSignatures (whole-program memo; every file's DECLARATIONS, from tokens)
//         -> queryParseOps (per-file memo; Parser -> FileParseArtifact)
//           -> queryAllModule (whole-program; mergeArtifact fold)
//
// `queryProgramSignatures` is a WHOLE-PROGRAM query sitting UNDER a per-file one, which is
// unusual and is the shape of the problem: a call's result type must be exact at parse time
// (a bool `and` is control flow), and the callee may be in another file. It reads TOKENS, never
// parses, so the chain stays acyclic. Its consequence is the one thing to get right in this file:
// **a parse memo is keyed on the file's bytes AND on that index's hash** (QueryEngine.parseMemoKey).
//
// The load-bearing shv2 differences from v1: (1) memo validity is a content-hash
// compare, not a revision walk; (2) queryParseOps produces a `FileParseArtifact`
// and touches NO `Project` state — the parser is a pure function; (3)
// queryAllModule rebuilds the derived registries from artifacts on every miss
// (resetMergeTargets), so there is no ParseDelta rollback dance.

// --- Per-file query: tokenize ---
//
// Tokenizing reads ONE input — the file — so the memo's key is that file's content hash and nothing
// else. (Contrast `queryParseOps`, whose key mixes in the signature index.)
function queryTokens(project Project, path FilePath) returns TokenArray throws CompileError
	// ONE `sourceFiles` probe for the whole query: `entry` carries both the bytes to lex and the hash
	// that validates and stamps the memo. See `sourceEntryOf` for why a probe is worth not repeating.
	let entry = try sourceEntryOf(project, path: path)

	if let memo = try project.db.tokenCache.get(path) 'memoized'
		if memo.keyHash == entry.contentHash 'hit'
			project.db.tokenHits = project.db.tokenHits + 1
			return memo.value
		end 'hit'
	end 'memoized'
	project.db.tokenMisses = project.db.tokenMisses + 1

	// The `lex` phase is probed HERE, around `tokenize` alone — the leaf. `queryParseOps`
	// calls this query BEFORE it opens its own `parse` probe, so the two phases are
	// disjoint by construction and neither has to subtract the other out. A cache hit
	// returned above does no lexing and is correctly billed nothing.
	let lexProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.lex)
	let tokens = try tokenize(entry.content) otherwise (lexErr) 'lexFail'
		reportLexerError(project, path: path, error: lexErr)
		// A failed tokenize is NOT cached — the diagnostic gates the build, and
		// the next attempt must re-run against corrected source.
		return TokenArray.create()
	end 'lexFail'
	recordPhase(project, phase: CompilePhase.lex, probe: lexProbe)

	project.db.tokenCache.upsert(path, value: TokenMemo.create(tokens, keyHash: entry.contentHash))
	return tokens
end 'queryTokens'

// --- Per-file query: the tokens THIS BUILD READS, with `#if` resolved ---
//
// ⭐⭐ **THE ONE DOOR EVERY TOKEN CONSUMER GOES THROUGH, AND THAT IS THE WHOLE POINT.** shv2 reads a
// file's tokens TWICE — once for the whole-program declaration sweep (`queryProgramSignatures`) and
// once for the real parse (`queryParseOps`) — and those two walks are different code. Handing them
// the same filtered array is what makes it IMPOSSIBLE for them to disagree about which declarations
// a `#if` leaves in the file; see ConditionalCompilation.maxon's header for the measured wrong
// answers the alternative produces, one of them silent.
//
// Layered OVER `queryTokens` rather than folded INTO it, deliberately: `queryTokens`' `lex` probe
// brackets `tokenize` alone and its comment explains that disjointness, so filtering inside it would
// silently bill conditional compilation to the lexer in `scale-test` and `--metrics`. This has its
// own `CompilePhase.directives`.
//
// A directive-free file — every file in the scale corpus, and all but four in `stdlib/` — is
// returned untouched by `filterConditionalTokens`, so the two caches then hold the SAME array rather
// than two copies of it.
//
// ⚠ **THE FILTERED STREAM IS TARGET-DEPENDENT AND THIS MEMO'S KEY IS NOT, WHICH IS SOUND ONLY
// BECAUSE A `Project` HAS EXACTLY ONE TARGET FOR ITS WHOLE LIFE.** `Project.target` is a `let` set
// by `Project.create` and re-aiming a live `Project` does not compile (Project.maxon says so at the
// field, which is the line that would have to change first), and this cache lives on `project.db` —
// so two targets are two `Project`s and two databases, and one cache can never be asked a question
// about a target it was not filled for. Should a `Project` ever need re-aiming, THIS memo's key is
// what becomes wrong: mix the target into it, do not simply invalidate.
function queryActiveTokens(project Project, path FilePath) returns TokenArray throws CompileError
	// ONE `sourceFiles` probe, validating and stamping from the same hash — see `sourceEntryOf`.
	let entry = try sourceEntryOf(project, path: path)

	if let memo = try project.db.activeTokenCache.get(path) 'memoized'
		if memo.keyHash == entry.contentHash 'hit'
			project.db.activeTokenHits = project.db.activeTokenHits + 1
			return memo.value
		end 'hit'
	end 'memoized'
	project.db.activeTokenMisses = project.db.activeTokenMisses + 1

	// Outside the probe, exactly as `queryParseOps` keeps `queryTokens` outside its `parse` probe:
	// the tokens query does its own `lex` timing, and a phase that absorbed another's is the defect
	// CompileTimings' header is about.
	let tokens = try queryTokens(project, path: path)

	let probe = PhaseProbe.beginPhase(project, phase: CompilePhase.directives)
	// ⚠ **THE FAILURE IS MEMOIZED TOO, AND THAT IS WHAT MAKES THE DIAGNOSTIC APPEAR ONCE.** This query
	// has TWO callers per file — the declaration sweep and the real parse — with no error gate between
	// them, so anything not cached here is computed twice and any diagnostic raised here is REPORTED
	// twice. Measured: `error.unterminated-if` rendered its E2063 on two lines before this returned
	// through the shared cache write below.
	//
	// Caching a failure is sound because the key is the file's CONTENT HASH: the empty stream can only
	// ever be served back for the very bytes that produced it, corrected source changes the hash and
	// invalidates the entry, and the diagnostic is already on `project.diagnostics` — which is
	// cumulative for the whole compile, so the build still fails, once. (This is also exactly what
	// already happens to a failed TOKENIZE, whose empty array reaches the same cache write below.)
	let active = activeTokensOrReported(project, path: path, tokens: tokens)
	recordPhase(project, phase: CompilePhase.directives, probe: probe)

	// ⚠ The stamp that carries this query's soundness argument: a TARGET-DEPENDENT value under a key
	// that names only the file. Read the target note in this function's header before changing it.
	project.db.activeTokenCache.upsert(path, value: TokenMemo.create(active, keyHash: entry.contentHash))
	return active
end 'queryActiveTokens'

// The filtered stream, or an EMPTY one with the fault reported. Its own function purely so the
// caller has a single success path to memoize through — see the cache-the-failure note there for
// why returning early instead reported every directive fault twice.
function activeTokensOrReported(project Project, path FilePath, tokens TokenArray) returns TokenArray
	return try filterConditionalTokens(tokens, target: project.target) otherwise (directiveErr) 'directiveFail'
		reportDirectiveError(project, path: path, error: directiveErr)
		return TokenArray.create()
	end 'directiveFail'
end 'activeTokensOrReported'

// --- Whole-program query: the DECLARED SIGNATURE of every function, from TOKENS ---
//
// Sits between `queryTokens` and `queryParseOps` in the chain, and it is what makes a call's
// result type exact ACROSS FILES (SignatureIndex.maxon has the wrong answer it exists to kill).
// Built from tokens, never from parses — which is what keeps it from being circular: a parse
// needs the index, so the index cannot need a parse.
//
// COST: one token-level sweep of every file, per miss. It is linear in the program's tokens and
// it re-reads them from the TOKEN memo, so an unchanged file is not re-lexed — only re-swept.
// (A per-file signature memo would save that sweep and buy nothing else: the whole-program fold
// it feeds is itself O(all declarations), so the two are the same order. Add one if a file count
// ever makes the sweep visible; do not add one on principle.)
//
// ⚠ **THIS IS A WHOLE-PROGRAM QUERY SITTING UNDER A PER-FILE ONE, SO ANYTHING O(FILES) INSIDE IT
// WOULD BE O(FILES²).** It is not: the memo makes it run once per build (`signaturesCacheValid`,
// itself O(1) after the first call because `compositeSourceHash` carries a dirty flag), and the
// constant evaluation below is O(declarations), not O(files) per file.
//
// ⚠ **`scale-test` DOES NOT MEASURE THAT, AND STRUCTURALLY CANNOT — ITS CORPUS CONTAINS NO
// TOP-LEVEL `let` AT ALL.** Every `let` the generator emits is body-local, so on every rung this
// arena is EMPTY, `evaluateInitializers` walks nothing, and no DFS, no lookup and no `mixConstant`
// ever runs. What the instrument reads is the P1.0d.5a slice's INERT cost: a dead-flat
// `2 × files + 1` allocations in this phase (25/33/49/81/145/273 against 12/16/24/40/72/136 files,
// exact on all six rungs; `+48 × files + 672` bytes, exact) — which is the one EMPTY per-file
// `TopLevelDeclArray` the sweep contributes, plus this index's own two tables. That number is
// real and it is worth having (it proves the sweep is linear in files, and `phase:parse` moves by
// exactly 0), but it is the signature of an empty arena and it says nothing whatever about the
// evaluator. Do not read it as if it did.
//
// The evaluator's linearity is MEASURED, off-instrument, because the instrument is blind to it
// (optimizer, 2026-07-15 — ladders in the report, not committed):
//   • 400 → 12,800 constants in one file: x2.00 allocations and x2.00 bytes per doubling, flat
//     across a 32x span. The memo on `TopLevelConstant` holds; a memo that did not stick would
//     re-walk per reference and bend immediately.
//   • 8 → 128 FILES at 50 constants each, with cross-file `export let` references and a NON-empty
//     arena — the shape this warning is actually about: x2.00 allocations and x2.00 bytes. Under
//     the once-per-file bug this reads x4.00. The hazard is refuted by measurement, not by reading.
//
// ⚠ WHAT IS NOT BOUNDED IS THE DFS's RECURSION DEPTH, and it is a live crash rather than a curve:
// a FORWARD-reference chain ~700 deep exhausts the stack and the compiler dies with SIGSEGV and no
// diagnostic (800 constants at depth 800 faults; the same 800 constants as 8 chains of depth 100
// compile fine, so it is depth and not count). A cycle that long faults before `recordCycle` can
// raise E2012. The bootstrap has the identical unbounded recursion in the code shv2 ported this
// from — it overflows on the same inputs at ~385 frames of `Parser.EvalConstAsCast` — so this is
// an inherited property of the design and not an shv2 regression. Fixing it needs an explicit
// worklist or a depth cap plus a diagnostic, in both compilers; it is not an optimization and it
// is recorded here rather than silently carried.
export function queryProgramSignatures(project Project) returns ProgramSignatures throws CompileError
	if signaturesCacheValid(project) 'hit'
		project.db.signatureHits = project.db.signatureHits + 1
		return project.db.signatureCache.value
	end 'hit'
	project.db.signatureMisses = project.db.signatureMisses + 1

	var signatures = ProgramSignatures.create()
	// ⭐ **THE ONE PROBE THIS COMPILE MAKES OF THE PROJECT ROOT** — set before any file is swept, so every
	// reader below (and every `Parser.create` in every later query) sees the answer rather than the seeded
	// `false`. It is what lets `livesUnderStdlibDirectory` be a derivation instead of a per-file path probe;
	// see that function for the proof and for the ladder measurement that rejected the per-file version.
	signatures.rootIsUnderStdlibDirectory = rootIsUnderStdlibDirectory(project, cwd: Directory.currentPath())

	// ⭐⭐ **THE SWEEP IS PARTITIONED BY PROVENANCE — USER FILES FIRST, STDLIB FILES SECOND (A1s wave 2).**
	// The shadow contest is decided BETWEEN the two halves, and that placement is the whole reason the
	// partition exists: deciding it needs both sides known, and a stdlib file must already know the answer
	// when it is folded, because the fold is what records its declarations AND every name its own
	// signatures reference. A single pass could satisfy at most one of those two.
	//
	// ⚠ **THIS IS NOT A DEPENDENCE ON FILE ORDER, WHICH `StdlibLoader`'s HEADER RULES OUT.** That rule is
	// about the FILESYSTEM's order, and it is kept: within each half the walk's own order is untouched and
	// unsorted, so a latent order dependence still surfaces rather than being hidden. What is fixed here is
	// a PROVENANCE order, derived from a fact the loader already recorded, and stated rather than relied on
	// — the previous arrangement happened to visit user files first (the loader appends stdlib after the
	// user's sources) and the contest would have silently depended on that.
	//
	// Each path is classified ONCE. `isStdlibSourceFile` costs about four String allocations a call
	// (Windows `canonicalForCompare` clones and lower-cases both sides), which is why asking it per file is
	// affordable and asking it twice per file would not be — the number `StdlibSource`'s header rejects.
	var userPaths = MaxonSourcePathArray.create()
	var stdlibPaths = MaxonSourcePathArray.create()
	for path in project.db.sourcePaths 'eachFile'
		if isStdlibSourceFile(project, path: path) 'stdlibSource'
			stdlibPaths.push(path)
			continue
		end 'stdlibSource'
		userPaths.push(path)
	end 'eachFile'

	for path in userPaths 'eachUserFile'
		try foldOneFileInto(project, signatures: signatures, path: path, isStdlibSource: false)
	end 'eachUserFile'

	try contestStdlibDeclarationsAgainstUserNames(project, signatures: signatures, stdlibPaths: stdlibPaths)

	for path in stdlibPaths 'eachStdlibFile'
		try foldOneFileInto(project, signatures: signatures, path: path, isStdlibSource: true)
	end 'eachStdlibFile'

	// ⭐ **THE INDEX IS NOW WHOLE-PROGRAM, AND IT SAYS SO.** Every reader below this line — the constant
	// evaluator, the real parse — gets an index in which an absence MEANS the program does not declare
	// the name. Above it, inside the loop, an absence means only that the declaring file has not been
	// swept yet, which is why the parser's whole-program semantic checks read this flag before spending
	// anything on a verdict they would have to throw away. See `ProgramSignatures.allFilesFolded`.
	signatures.allFilesFolded = true

	// ⭐ EVERY FILE IS FOLDED IN; NOW the top-level constants can be evaluated — and not one moment
	// earlier. A constant's initializer may name a constant declared LATER in its own file or in a file
	// not yet swept, so evaluation has to wait until every declaration in the program is known. This is
	// the whole reason a forward reference works (see `ProgramSignatures.evaluateInitializers`).
	//
	// Billed to `signatures`, the phase whose index this completes, and INSIDE the query — its answers
	// are part of the memoized value and of the hash that keys every parse on it.
	//
	// It reports NOTHING. A defective initializer is recorded on its declaration and raised, with a
	// position, by the real parse when it reaches that line — which keeps this sweep tolerant (see
	// `Parser.foldDeclaredSignaturesInto`) and keeps this memo cacheable: a query that reported would
	// have to suppress on a hit, exactly as `queryParseOps` must.
	let constProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.signatures)
	// ⭐ And the `Array with <every declared struct/union>` over-interning a `[<identifier>…]` array literal
	// needs (P1.7 slice 3) — HERE, for the same "the whole program is known now" reason, and because doing it
	// at each such file re-walked tables that were still growing: O(files × types), measured at ×3.03
	// allocations per doubling on 1024 files. Before `deriveInstanceNames`, which names every instance.
	signatures.internArrayLiteralAggregateInstances()
	signatures.evaluateInitializers()
	// ⭐ And every declared `interface`'s REQUIREMENTS (R8) — for the same "the whole program is known now"
	// reason, and here it is the reason the pass exists at all rather than merely where it is cheapest. See
	// `foldInterfaceDeclarations`.
	//
	// BEFORE `deriveInstanceNames`, deliberately: reading a requirement's parameter types can INTERN a generic
	// instance no other declaration named (`interface Summer … function total(xs IntArray)` in a program whose
	// only `Array with Integer` is that formal), and an instance interned after the warming walk would have its
	// two name memos derived LAZILY — by the parse, which must only ever read them.
	try foldInterfaceDeclarations(project, signatures: signatures)
	// ⭐ And every instantiation's COMPILED and CANONICAL names, for the same "the whole program is known
	// now" reason — the parse READS both (a generic instance's nominal identity, P1.7) and each memo behind
	// them is a WRITE, which a per-file fan-out must never make. See `deriveInstanceNames`.
	signatures.deriveInstanceNames()
	recordPhase(project, phase: CompilePhase.signatures, probe: constProbe)

	project.db.signatureCache = SignatureMemo.create(signatures, keyHash: compositeSourceHash(project), computed: true)
	return signatures
end 'queryProgramSignatures'

// Sweep ONE file's declarations into the index. Split out of `queryProgramSignatures` when the sweep was
// partitioned by provenance, so the two halves are one body rather than two copies of it — and so the
// `isStdlibSource` bit each half already knows is PASSED rather than re-derived per file.
function foldOneFileInto(project Project, signatures ProgramSignatures, path FilePath, isStdlibSource bool) throws CompileError
	// Outside the probe, exactly as `queryAllModule` keeps `queryParseOps` outside its `merge`
	// probe: the tokens query does its own `lex` timing, and a phase that absorbed another's is
	// the defect CompileTimings' header is about.
	let tokens = try queryActiveTokens(project, path: path)

	let probe = PhaseProbe.beginPhase(project, phase: CompilePhase.signatures)
	// A `Parser` IS the sweeper — same cursor, same `parseOptionalReturnType` — so the sweep and
	// the real parse cannot drift on what `returns X` means (see `foldDeclaredSignaturesInto`). It
	// is handed the index it is BUILDING, which is safe because a sweep types no call and so never
	// reads it; nothing else in the Parser needs a signature.
	var scanner = Parser.create(tokens, filePath: path, namespace: "", signatures: signatures, isStdlibSource: isStdlibSource, declaresCompilerInternalNames: declaresCompilerInternalNames(project, path: path), livesUnderStdlibDirectory: livesUnderStdlibDirectory(signatures, isStdlibSource: isStdlibSource))
	scanner.foldDeclaredSignaturesInto(signatures)
	recordPhase(project, phase: CompilePhase.signatures, probe: probe)
end 'foldOneFileInto'

// ⭐⭐ **DECIDE THE STDLIB/USER SHADOW CONTEST — between the two halves of the sweep (A1s wave 2).** Every
// NOMINAL type name a listed stdlib module declares is offered to `contestStdlibTypeName`, which keeps only
// the ones a user file has already claimed. See `SignatureIndex.StdlibShadowRenameMap` for the rule and for
// the measurement that made a rename necessary rather than a tie-break.
//
// ⚠ **IT READS THE TOKENS RATHER THAN THE SWEPT DECLARATIONS, AND THAT IS FORCED BY THE ORDERING** — the
// stdlib fold is what has to KNOW the answer, so the answer cannot come from it. The grammar it relies on
// is the narrowest one that exists: a declaration keyword followed by an identifier, which is exactly what
// `readTypeHeader` and its enum/interface twins consume. Over-approximating is safe and under-approximating
// is not, so it takes every such pair and lets `contestStdlibTypeName` discard the uncontested ones — which
// is all of them for the whole existing corpus.
//
// ⚠ **THE FOUR NOMINAL KINDS ONLY, AND `typealias` IS ABSENT ON PURPOSE.** Those four are what a user
// declaration collides with today (E3006); an alias FORM is already file-local (`TypeNameRegistry`'s one
// carve-out), so a user's own ranged `typealias DurationMs` already coexists with `stdlib/Clock.maxon`'s and
// already answers for the user's file — MEASURED, including for its RANGE. Contesting an alias would move a
// name that already works, for nothing.
//
// ⚠ **COLLECTED WHOLE, THEN CONTESTED — the two phases are not a style choice (A1s wave 2 review).** Minting
// a reserved name has to avoid every name the stdlib itself declares (`shadowRenameIsTaken`), and a walk that
// contested as it went could only ask about the modules it had already passed. So the first phase names the
// whole stdlib side and the second decides against a complete picture — which also makes the mint independent
// of the order the loader happened to enumerate `stdlib/` in, the property `StdlibLoader`'s header requires of
// everything downstream of it.
//
// The array is the walk's own order rather than the set's, so the contest is decided in source order.
function contestStdlibDeclarationsAgainstUserNames(project Project, signatures ProgramSignatures, stdlibPaths MaxonSourcePathArray) throws CompileError
	var declaredNames = ByteArrayArray.create()
	for path in stdlibPaths 'eachStdlibFile'
		// A memo HIT in every case: the fold below asks for the same file's tokens moments later, and the
		// user half has already primed nothing of this file — so this is the miss and the fold is the hit.
		let tokens = try queryActiveTokens(project, path: path)
		for i in 0 upto tokens.count() 'eachToken'
			let tok = try tokens.get(i) otherwise panic("contestStdlibDeclarationsAgainstUserNames: tokens.get OOB at {i} below count {tokens.count()}")
			if not declaresANominalTypeName(tok.kind) 'notADeclarationKeyword'
				continue
			end 'notADeclarationKeyword'

			let nameTok = try tokens.get(i + 1) otherwise break
			if nameTok.kind != TokenKind.identifier 'malformedDeclaration'
				continue
			end 'malformedDeclaration'

			declaredNames.push(nameTok.value)
		end 'eachToken'
	end 'eachStdlibFile'

	signatures.noteStdlibDeclaredTypeNames(declaredNames)
	for name in declaredNames 'eachDeclaredName'
		signatures.contestStdlibTypeName(name)
	end 'eachDeclaredName'

	if not signatures.hasStdlibShadowRenames() 'nothingContested'
		return
	end 'nothingContested'

	try refuseContestedNamesUsedAsMembers(project, signatures: signatures, stdlibPaths: stdlibPaths)
end 'contestStdlibDeclarationsAgainstUserNames'

// The four keywords that mint a NOMINAL type name — the set `contestStdlibDeclarationsAgainstUserNames`
// contests over. `typealias` is deliberately not among them; see that function.
function declaresANominalTypeName(kind TokenKind) returns bool
	return kind == TokenKind.type or kind == TokenKind.enum or kind == TokenKind.union or kind == TokenKind.interface
end 'declaresANominalTypeName'

// ⚠⚠ **THE ONE HAZARD THE RENAME HAS, REFUSED RATHER THAN RISKED (A1s wave 2).**
//
// The rename is applied to a stdlib file's IDENTIFIER TOKENS (`Parser.shadowRenamedTokens`), which is what
// makes it reach every spelling of the name at once — the declaration, every type reference, a qualified
// case value, a `Type.method` callee, a struct literal head — with no roster of doors to keep complete. It
// is sound because it is UNIFORM over stdlib source: a name renamed at its declaration is renamed at every
// stdlib use of it, so anything stdlib-internal is unaffected and only the CROSS-FILE reachability of the
// bare name changes, which is the rule.
//
// The one thing that argument does not cover is a MEMBER of a stdlib type spelled exactly like a contested
// TYPE name — a field, a method, or a parameter label. Those are reachable from USER code, whose tokens are
// never rewritten, so the two sides would disagree about one name: the stdlib declaration `var ParseError`
// would become `__ParseError` while a user's `x.ParseError` stayed bare. That is a silent wrong answer, and
// it is the shape this project refuses to ship however unlikely — so it is DETECTED here and the program is
// refused, naming the collision.
//
// Both member shapes are token-shaped and need no parse: a member access is an identifier PRECEDED by `.`,
// and an argument label is one FOLLOWED by `:`. Scanned only when something is actually contested, i.e.
// never for the whole existing corpus.
function refuseContestedNamesUsedAsMembers(project Project, signatures ProgramSignatures, stdlibPaths MaxonSourcePathArray) throws CompileError
	for path in stdlibPaths 'eachStdlibFile'
		let tokens = try queryActiveTokens(project, path: path)
		for i in 0 upto tokens.count() 'eachToken'
			let tok = try tokens.get(i) otherwise panic("refuseContestedNamesUsedAsMembers: tokens.get OOB at {i} below count {tokens.count()}")
			if tok.kind != TokenKind.identifier 'notAName'
				continue
			end 'notAName'

			if signatures.stdlibShadowRenameOf(tok.value).equals(tok.value) 'notContested'
				continue
			end 'notContested'

			if not tokenIsAMemberSpelling(tokens, index: i) 'notAMember'
				continue
			end 'notAMember'

			reportDiagnostic(project, diagnostic: Diagnostic.create(ErrorCode.stdlibShadowedNameIsAlsoAMember, message: "'{String.from(tok.value)}' cannot be shadowed: this program declares it as a type, and a stdlib module also uses it as a MEMBER name (a field, a method or an argument label). Shadowing moves the stdlib TYPE into the reserved space, which would leave that member reachable from user code under a name the stdlib side no longer spells — rename the type in this program"))
			return
		end 'eachToken'
	end 'eachStdlibFile'
end 'refuseContestedNamesUsedAsMembers'

// Is the identifier at `index` written in a MEMBER position — preceded by `.` (a field or method access) or
// followed by `:` (an argument label)? The two token shapes a member name has; see the caller.
function tokenIsAMemberSpelling(tokens TokenArray, index TokenIndex) returns bool
	if index > 0 'hasPredecessor'
		let previous = try tokens.get(index - 1) otherwise panic("tokenIsAMemberSpelling: tokens.get OOB at {index - 1}")
		if previous.kind == TokenKind.dot 'memberAccess'
			return true
		end 'memberAccess'
	end 'hasPredecessor'

	let next = try tokens.get(index + 1) otherwise return false
	return next.kind == TokenKind.colon
end 'tokenIsAMemberSpelling'

// ⭐⭐ **EVERY DECLARED `interface`'s REQUIREMENTS, READ ONLY ONCE THE WHOLE PROGRAM IS KNOWN (R8).** The
// second half of the declaration sweep, and it is a SECOND PASS for a reason that is a correctness property
// rather than a convenience:
//
// An interface requirement's types are stored as RENDERED SOURCE STRINGS, and one of those renderings —
// `IrInterface.renderDeclaredTypeName`'s `genericInstance` arm — answers `ProgramSignatures.canonicalInstanceName`,
// a question only the COMPLETE index can answer. Inside the per-file loop above, `signatures.isGenericAlias`
// still says "no" for an alias whose file has not folded, so `function total(xs IntArray)` would render its
// formal as the raw alias name `IntArray` here and as the canonical `Array_int` at the real parse. A rendered
// type name is an IDENTITY at both ends of a conformance (`signatureMatches` compares two of these strings),
// so two spellings of one type is a FALSE ACCEPT — the exact hole the R5 review measured for the
// `genericInstance` arm — plus a formal a witness dispatch would then check its actuals against wrongly.
// Reading here, after `allFilesFolded`, makes the two renderings identical BY CONSTRUCTION rather than by luck:
// this reader sees the same index the parse will. `specs-shv2/where-clauses.md`'s
// `constraint-interface-generic-alias-formal` is the pin.
//
// ⭐ **AND THE TWO RENDERINGS REALLY DO DISAGREE — MEASURED THREE WAYS ON ONE PROGRAM** (an interface
// requirement `make() returns IntArray`, dispatched through a `where` constraint;
// `specs-shv2/where-clauses.md`'s disabled `witness-return-generic-instance` carries it):
//   • the pre-R8 compiler, which read the interface out of `artifact.interfaces` — i.e. the REAL PARSE's
//     rendering — reports `E3011 … Unknown type 'Array_Integer'`;
//   • this pass reports the IDENTICAL diagnostic, which is the evidence it renders as the real parse does;
//   • the same pass moved INTO the per-file sweep COMPILES the program and returns 42, because the
//     incomplete index renders the formal as the raw alias `IntArray`, a name that happens to resolve.
// The sabotage looking "better" is exactly the trap: it is two spellings of one type living in one index,
// the shape the R5 review measured as a false ACCEPT on a conformance. (The E3011 itself is a separate,
// PRE-EXISTING gap — `Parser.interfaceReturnMaxonType` has no generic-instance arm — and is recorded at
// that spec case.)
//
// ⚠ **IT JUMPS TO SITES RATHER THAN WALKING TOKENS, AND THAT IS WHAT KEEPS IT OFF THE COST CURVE.** The sweep
// already decided which tokens open a declaration and recorded the position of each `interface`
// (`InterfaceDeclSite`), so this is O(interfaces in the program) — not a second walk of every token, and not a
// re-decision of what a declaration is. `queryActiveTokens` is memoized, so a file's tokens are a map hit.
// MEASURED on the scale ladder, against the same tree without this pass, in this checkout: the WHOLE delta is
// `phase:signatures` (+1,778/+2,667/+4,444/+7,997/+15,102/+29,311 against a total delta of
// +1,780/+2,669/+4,446/+7,999/+15,104/+29,313 — the other two allocations are `phase:load`'s checkout-path
// artefact) and it is **DEAD FLAT PER INTERFACE at every rung** against a corpus declaring 8/12/20/36/68/132
// of them. Flat-per-declaration is the shape that says there is no per-file or per-site multiplier hiding in
// it.
//
// ⭐ **ONE READER PER FILE, NOT PER SITE, AND `enterTypeScope` IS THE WHOLE SAFETY ARGUMENT.** Reading a
// declaration can throw part-way, and a `Parser` carries type-param scope state a throw leaves un-popped — but
// `readInterfaceDeclaration` OPENS with `enterTypeScope`, which assigns all five of those fields
// unconditionally rather than merging into them, and `foldInterfaceDeclarationInto` seats the cursor itself. So
// the next site in the same file cannot observe the failed one, and the tolerance stays per-DECLARATION with no
// isolation to buy. Sharing the artifact is not merely harmless either — it is what the REAL parse does, one
// local interner per file. A `Parser` per site instead cost **222 allocations per interface** where this costs
// 130 (measured, same ladder), the difference being pure construction of a `Parser` and a `FileParseArtifact`
// that the file's first site had already built.
//
// The sites arrive grouped by file — the sweep visits files in source-path order and appends within each — so
// the grouping is a WALK and not a map: an inner loop consumes the run of sites sharing a path.
function foldInterfaceDeclarations(project Project, signatures ProgramSignatures) throws CompileError
	let sites = signatures.interfaceDeclSites
	var i = 0 as ElementCount
	while i < sites.count() 'eachFile'
		let path = (try sites.get(i) otherwise panic("foldInterfaceDeclarations: sites.get OOB at {i} below count {sites.count()}")).path
		let tokens = try queryActiveTokens(project, path: path)
		// ONE classification, read twice: `isStdlibSourceFile` is the four-String-allocation probe its own
		// header prices, and `livesUnderStdlibDirectory` is a derivation over its answer, not a second one.
		let isStdlibSource = isStdlibSourceFile(project, path: path)
		var reader = Parser.create(tokens, filePath: path, namespace: "", signatures: signatures, isStdlibSource: isStdlibSource, declaresCompilerInternalNames: declaresCompilerInternalNames(project, path: path), livesUnderStdlibDirectory: livesUnderStdlibDirectory(signatures, isStdlibSource: isStdlibSource))

		while i < sites.count() 'eachSiteInFile'
			let site = try sites.get(i) otherwise panic("foldInterfaceDeclarations: sites.get OOB at {i} below count {sites.count()}")
			if not site.path.equals(path) 'nextFile'
				break
			end 'nextFile'

			reader.foldInterfaceDeclarationInto(signatures, tokenPos: site.tokenPos)
			i = i + 1
		end 'eachSiteInFile'
	end 'eachFile'
end 'foldInterfaceDeclarations'

// --- Per-file query: parse into a FileParseArtifact ---
export function queryParseOps(project Project, path FilePath) returns FileParseArtifact throws CompileError
	// BEFORE the memo check, because HALF THE MEMO'S KEY IS THIS (see QueryEngine.parseMemoKey):
	// a parse reads this file's tokens AND every other file's declarations, so a memo validated
	// against the file's bytes alone would serve a stale parse after a return type changed
	// elsewhere. The call is a memo hit for every file after the first.
	let signatures = try queryProgramSignatures(project)

	// The key this parse must carry, computed ONCE: it validates the memo below and stamps the new one
	// at the end of the query, so the check and the stamp are the same value rather than two
	// computations that have to agree. See `currentParseMemoKey`.
	let keyHash = try currentParseMemoKey(project, path: path, signatureHash: signatures.hash)

	if let memo = try project.db.parseCache.get(path) 'memoized'
		if memo.keyHash == keyHash 'hit'
			project.db.parseHits = project.db.parseHits + 1
			return memo.value
		end 'hit'
	end 'memoized'
	project.db.parseMisses = project.db.parseMisses + 1

	let tokens = try queryActiveTokens(project, path: path)

	// The `parse` probe opens only NOW — after the tokens query has returned — so it bills
	// the parse alone and never absorbs the lexing it depends on. (The alternative,
	// wrapping the whole query body and subtracting `lex` back out, is what the register
	// allocator has to do for liveness; here the call order makes it unnecessary.) It
	// spans everything the parse query itself does: building the parser, the parse
	// proper, the termination assert, and the memo write.
	let parseProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.parse)

	// M1 single-file build: namespace is empty (no cross-file qualification).
	// Namespace derivation from the path grows with multi-file builds at M2.
	// ONE classification, read twice — see `foldInterfaceDeclarations` for why the second read is a
	// derivation over the first and not a second probe.
	let isStdlibSource = isStdlibSourceFile(project, path: path)
	var parser = Parser.create(tokens, filePath: path, namespace: "", signatures: signatures, isStdlibSource: isStdlibSource, declaresCompilerInternalNames: declaresCompilerInternalNames(project, path: path), livesUnderStdlibDirectory: livesUnderStdlibDirectory(signatures, isStdlibSource: isStdlibSource))
	let errorCountBefore = project.diagnostics.count()
	let artifact = try parser.parseModule() otherwise (parseErr) 'parseFail'
		reportParseError(project, path: path, error: parseErr)
		// A failed parse is never cached (preserves v1's invariant). What IS returned carries only the
		// type names the file had declared before it stopped — see `Parser.abortedParseArtifact`, which
		// states why that one registry crosses an abort and the rest cannot. Everything else is empty,
		// so the caller rolls forward to the error gate exactly as before.
		return parser.abortedParseArtifact()
	end 'parseFail'

	// Only cache a clean parse — a parse that reported a diagnostic must re-run. The memo is
	// stamped with BOTH inputs this parse read (the file's bytes and the signature index's
	// declarations), through the VERY `keyHash` VALUE that failed to validate above — not a second
	// computation of it, so the stamp and the check cannot disagree about what a parse depends on.
	// Neither input can move while the parse runs: the parser is a pure function of the two.
	let hadErrors = project.diagnostics.count() > errorCountBefore
	if not hadErrors 'cacheOk'
		artifact.module.assertAllBlocksTerminated()
		project.db.parseCache.upsert(path, value: ParseMemo.create(artifact, keyHash: keyHash))
	end 'cacheOk'

	recordPhase(project, phase: CompilePhase.parse, probe: parseProbe)
	return artifact
end 'queryParseOps'

// --- Whole-program query: merge every file's artifact ---
export function queryAllModule(project Project) returns MaxonModule throws CompileError
	if allModuleCacheValid(project) 'hit'
		project.db.allModuleHits = project.db.allModuleHits + 1
		return project.db.allModuleCache.value
	end 'hit'
	project.db.allModuleMisses = project.db.allModuleMisses + 1

	// Artifacts are the source of truth for the derived registries; a miss
	// rebuilds them from scratch so a warm re-run never double-commits. This is
	// the shv2 replacement for v1's per-file beginFileParse rollback — a clean
	// reset, since the parser wrote nothing to Project speculatively.
	resetMergeTargets(project)

	// `merge` is probed around `mergeArtifact` ALONE: `queryParseOps` is called outside
	// the probe on each iteration, so the fold's cost never absorbs the parse's (the
	// leaf-timing discipline in CompileTimings' header).
	var merged = MaxonModule.create()
	for path in project.db.sourcePaths 'eachFile'
		let artifact = try queryParseOps(project, path: path)

		let mergeProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.merge)
		mergeArtifact(project, target: merged, artifact: artifact)
		recordPhase(project, phase: CompilePhase.merge, probe: mergeProbe)
	end 'eachFile'

	project.db.allModuleCache = ModuleMemo.create(merged, keyHash: compositeSourceHash(project), computed: true)
	return merged
end 'queryAllModule'

// ⭐ **WHOLE-PROGRAM FUNCTION-VALUE MERGE SIGNATURE AGREEMENT (P1.5 #81).** Every function-value ternary /
// match EXPRESSION recorded a `PendingFnMergeCheck` at parse — its arms' governing names, the anchor, and
// the noun — because a FORWARD-REFERENCED or CROSS-FILE arm's signature is not knowable at parse (the
// whole-program `funcSignatures` is not assembled until merge). This drains those records: after
// `queryAllModule` has merged every file's signatures, and BEFORE the pipeline's `resolveTypes` erases the
// alias names (`Integer`→`int`) the diagnostic prints, so a same-file, forward-referenced and cross-file
// arm are all checked identically. Agreement is NOMINAL — the `fn(…) returns …` display strings — matching
// the reference oracle's `MergeTernaryArmFnTypes` (2-Parser.cs:16149), which rejects two DISTINCT same-range
// aliases. The diagnostic lands in `project.diagnostics`; `compileToCodeResult`'s pipeline gate stops the
// build before lowering. Called once per compile from `compileToCodeResult` (NOT inside the memoized
// `queryAllModule`, so a warm rebuild re-reports).
export function checkValueMergeSignatures(project Project)
	for check in project.pendingFnMergeChecks 'eachCheck'
		checkOneValueMergeSignature(project, check: check)
	end 'eachCheck'
end 'checkValueMergeSignatures'

// One recorded merge: compare the FIRST arm's fn-type display against every other arm's, reporting the
// FIRST mismatch (as the parse-time give-type check reported its first). An arm whose governing name is not
// a declared function/closure — a function-typed parameter, field, or call result, whose full type shv2
// does not carry on the value — cannot be compared and is REJECTED (never silently accepted), because a
// silent pass is the very wrong-answer this check exists to close.
function checkOneValueMergeSignature(project Project, check PendingFnMergeCheck)
	let firstName = try check.armNames.get(0) otherwise panic("checkOneValueMergeSignature: a recorded function-value merge has no arms")
	if not armFnTypeResolvable(project, name: firstName) 'firstUnverifiable'
		reportUnverifiableFnMerge(project, check: check)
		return
	end 'firstUnverifiable'
	let firstDisplay = armFnTypeDisplay(project, name: firstName)

	for i in 1 upto check.armNames.count() 'eachArm'
		let otherName = try check.armNames.get(i) otherwise panic("checkOneValueMergeSignature: armNames.get OOB at {i}")
		if not armFnTypeResolvable(project, name: otherName) 'otherUnverifiable'
			reportUnverifiableFnMerge(project, check: check)
			return
		end 'otherUnverifiable'
		let otherDisplay = armFnTypeDisplay(project, name: otherName)
		if not firstDisplay.equals(otherDisplay) 'mismatch'
			// The construct→E2028/E3005 noun is decided by the ONE shared mapping (`valueMergeMismatchError`),
			// the same the parse-time give-type mismatch (#80) uses — so a whole-program function-signature
			// mismatch and a parse-time give mismatch read identically for the same construct.
			reportParseError(project, path: check.filePath, error: valueMergeMismatchError(check.isTernary, expectedDisplay: firstDisplay, gotDisplay: otherDisplay, line: check.line, column: check.column))
			return
		end 'mismatch'
	end 'eachArm'
end 'checkOneValueMergeSignature'

// Can `name` — a function value's governing name — be resolved to a comparable function TYPE? True for a
// declared function/closure (its signature is in `funcSignatures`) OR a function-TYPED value whose name is
// a function alias (`f UnaryOp` names `UnaryOp` — see `Parser.functionValueReturnType`, which recovers its
// return the same way). False only for a function value with no nameable type (recovered from a field or a
// call result), which the check refuses rather than silently accept.
function armFnTypeResolvable(project Project, name ByteArray) returns bool
	return project.funcSignatures.contains(name) or project.functionTypeAliases.contains(name)
end 'armFnTypeResolvable'

// The `fn(…) returns …` display for a resolvable arm (guarded by `armFnTypeResolvable`). A declared
// function/closure's is built from its whole-program (still UNRESOLVED) parameter signature + return type;
// a function-alias arm's is the `display` string the parser stored on the alias (params included). Both
// build the same canonical string, so `f UnaryOp` and a `triple` that fits it compare EQUAL.
function armFnTypeDisplay(project Project, name ByteArray) returns String
	if let sig = try project.funcSignatures.get(name) 'declaredFn'
		let returnType = try project.funcReturnTypes.get(name) otherwise panic("armFnTypeDisplay: '{String.from(name)}' is in funcSignatures but not funcReturnTypes — the two are committed together per function")
		return formatFnTypeDisplay(sig.paramTypes, returnType: returnType, typeNames: project.typeNames)
	end 'declaredFn'

	let alias = try project.functionTypeAliases.get(name) otherwise panic("armFnTypeDisplay: '{String.from(name)}' is armFnTypeResolvable but in neither registry — this and armFnTypeResolvable disagree")
	return String.from(alias.display)
end 'armFnTypeDisplay'

// Reject a function-value merge whose branches are not both NAMED functions — shv2 carries no full function
// type on a value, so a function-typed parameter/field/call-result branch has no signature to compare.
// Rejected rather than accepted (the coordinator's rule: never silently accept an unverifiable merge).
function reportUnverifiableFnMerge(project Project, check PendingFnMergeCheck)
	reportParseError(project, path: check.filePath, error: ParseError.unsupported("a conditional or match whose branches are function values that are not both NAMED functions (a top-level function or a closure) — shv2 cannot yet compare the signatures of function values recovered from a parameter, field, or call result, so it refuses the merge rather than risk one branch's signature standing in for the other's", line: check.line, column: check.column))
end 'reportUnverifiableFnMerge'

// Re-run the per-file queries (tokens, then parse) for every source file. The M2
// warm-rebuild gate uses this to PROVE the per-file memos survived a whole-program
// rebuild: after `queryAllModule` has populated them on a cold pass, a subsequent
// `queryAllModule` is a whole-program HIT that returns early and never revisits the
// per-file caches — so to observe those caches are still hot, the gate re-queries
// them directly. Each re-query must land as a cache HIT (content-hash re-validated,
// not recomputed), moving `tokenHits`/`parseHits` up while their MISS counts hold.
//
// `queryTokens`/`queryParseOps` stay file-private; this is the one exported entry
// the gate needs.
export function probeRebuildCacheHits(project Project) throws CompileError
	for path in project.db.sourcePaths 'each'
		// All three queries must run: a queryParseOps HIT returns before it would reach
		// queryActiveTokens, which in turn returns on its own hit before it would reach
		// queryTokens — so each must be asked directly to move its own counter.
		_ = try queryTokens(project, path: path)
		_ = try queryActiveTokens(project, path: path)
		_ = try queryParseOps(project, path: path)
	end 'each'
end 'probeRebuildCacheHits'

// ⭐ **IS THIS SOURCE FILE `stdlib/`'s (P1.9)?** Asked ONCE PER FILE, by the three places that need a file's
// provenance: the two queries that build a `Parser` for a real parse, and `queryProgramSignatures`'s
// PARTITION of the declaration sweep, which asks it once and then hands the answer down rather than letting
// `foldOneFileInto` re-derive it.
//
// ⚠ **IT IS NO LONGER ONLY A VISIBILITY QUESTION (A1s wave 2).** It was read by a `typealias` declaration
// alone (`Parser.typeAliasVisibility`); it now also decides whether a file's tokens are rewritten by the
// stdlib/user shadow rename (`Parser.shadowRenamedTokens`) and whether the `__`-reservation doors admit this
// compile's own mints (`Parser.requireUnreservedName`, `requireCalleeIsNotReservedName`). Everything below
// about resolving both sides before comparing therefore governs more than one rule now.
//
// ⚠ **THE PER-FILE FORM IS THE AFFORDABLE ONE, AND `StdlibSource`'s HEADER IS ABOUT THE OTHER TWO.**
// `FilePath.isInside` costs about four String allocations (Windows `canonicalForCompare` clones and
// lower-cases both sides), which is why deriving stdlib-ness per FUNCTION was measured at +3,633…+48,273
// on the scale ladder and rejected outright. This is per FILE inside two O(files) loops — one of them
// memoized to once per build — so it is the same shape as the walk the loader already makes.
//
// It asks the DIRECTORY rather than `project.stdlibSourcePaths` deliberately: that record is an ARRAY,
// so a membership test over it is a linear scan of ~49 `FilePath.equals`, each allocating two Strings —
// an order of magnitude worse than one `isInside` — and it would go on being worse as the loader's
// whitelist grows toward the whole of `stdlib/`.
// ⚠ **RESOLVE BOTH SIDES FIRST — `isInside` compares SPELLINGS, not files.** Before that it answered
// differently for one file depending only on how the command line named it: `build stdlib/p19rev`
// read the project's own sources as the USER's (correct), and `build C:/…/stdlib/p19rev` read the
// same files as STDLIB, silently promoting a private typealias to `Visibility.global` and dropping
// the E3062 it was owed. `StdlibLoader.registeredPathsWhenTheRootIsInsideStdlib` already resolves
// against the cwd for exactly this reason; this door did not, and P1.9 made it load-bearing.
//
// The root-inside-`stdlib/` arm is that same function's ruling, restated where this door can act on
// it: a project ROOTED under `stdlib/` keeps its own files as the user's, so only what the loader
// pulled in from OUTSIDE that root is stdlib. It stays a directory test rather than a membership
// test over `project.stdlibSourcePaths` for the reason given above — and it ASKS
// `Project.rootIsUnderStdlibDirectory` rather than spelling the test out, because
// `livesUnderStdlibDirectory` below is derived from the same predicate and its proof is a claim about
// THIS arm. Two spellings would be two things free to drift while the proof read as if it held.
function isStdlibSourceFile(project Project, path FilePath) returns bool
	let cwd = Directory.currentPath()
	let resolvedPath = path.resolve(cwd)

	if rootIsUnderStdlibDirectory(project, cwd: cwd) 'rootInsideStdlib'
		return not resolvedPath.isInside(project.rootPath.resolve(cwd))
	end 'rootInsideStdlib'

	return resolvedPath.isInside(project.stdlibDir)
end 'isStdlibSourceFile'

// ⭐⭐ **IS THIS FILE PHYSICALLY INSIDE `stdlib/` (BATCH2 slice 1)?** Read by
// `Parser.requireStdlibOnlyStringMethod`, the gate on the two `module`-visible `String` methods
// (`addressableBytes`, `byteAtOrPanic`) that `stdlib/URL.maxon` and its helper cone need.
//
// ⚠⚠ **IT IS DELIBERATELY NOT `isStdlibSourceFile`, AND THIS IS D6's DISTINCTION ONE DOOR OVER — ASKED
// AND ANSWERED WRONG ONCE ALREADY.** That function decides VISIBILITY, and its root-inside-`stdlib/` arm
// hands a project ROOTED under `stdlib/` its own files back as the USER's, which is correct for
// visibility (A1t bar 2) and is exactly the ruling `StdlibLoader.registeredPathsWhenTheRootIsInsideStdlib`
// makes. Gated on THAT answer, the two methods' refusal told
// `maxon-shv2 build stdlib/URL.maxon` that `stdlib\URL.maxon` "is not stdlib source" — a false sentence
// about a file whose path says otherwise, and it broke the command this workstream measures its blockers
// WITH, for precisely the modules the workstream is about. `Parser.declaresCompilerInternalNames`
// predicted it in prose ("would have made `maxon-shv2 build stdlib/Builtins.maxon` … refuse the very
// module the loader is about to list"); this is that sentence coming true for the second door.
//
// ⭐⭐ **AND IT IS A DERIVATION, NOT A SECOND PATH PROBE — WHICH IS THE WHOLE OF WHY IT IS AFFORDABLE.**
// The two answers differ in exactly ONE situation, and it is a property of the COMPILE rather than of the
// file: when the project ROOT is itself under `stdlib/`, every source the compile loads is under `stdlib/`
// too — the project's own because the root is, and the loader's because it walks `stdlib/`. Off that path
// the two COINCIDE, because `isStdlibSourceFile` is then literally `path.isInside(stdlibDir)`. So:
//
//     livesUnderStdlib(path)  ==  isStdlibSource(path)  OR  rootIsUnderStdlibDirectory
//
// and the right-hand term is asked ONCE PER COMPILE (`ProgramSignatures.rootIsUnderStdlibDirectory`,
// set in `queryProgramSignatures`), never per file.
//
// ⚠ **THE PROOF ABOVE IS A CLAIM ABOUT `isStdlibSourceFile`'s ROOT ARM, so both must be the SAME
// PREDICATE and not two spellings of it** — `Project.rootIsUnderStdlibDirectory` is that one home, and
// `StdlibLoader.registeredPathsWhenTheRootIsInsideStdlib`, the third rule turning on the same fact,
// reads it too. See its header.
//
// ⚠ **MEASURED, because the obvious version — a second `resolve` + `isInside` per file — is the shape
// `isStdlibSourceFile`'s own header rules out ("asking it twice per file would not be [affordable]").**
// Shipped that way for one build, the scale ladder read **+2,438 allocations at rung 0 rising to +13,350
// at rung 5** ON TOP of this rung's whitelist cost, growing with the file count — a per-file term bought
// to answer a per-compile question. As a derivation over one root probe it is **+32 allocations, EXACTLY
// FLAT at all six rungs**: the probe itself, once, and nothing that scales.
function livesUnderStdlibDirectory(signatures ProgramSignatures, isStdlibSource bool) returns bool
	return isStdlibSource or signatures.rootIsUnderStdlibDirectory
end 'livesUnderStdlibDirectory'

// The one module whose declarations MAY carry the reserved `__` prefix — `stdlib/Builtins.maxon`, the
// type-system bridge to the compiler's intrinsics (the error enums a builtin throws, the parse helpers
// `int.fromString` rewrites to). Named RELATIVE to `stdlib/` and joined against `project.stdlibDir`, the
// same construction `StdlibLoader.listWhitelistedModule` uses, so the two spell one file one way.
//
// ⚠ **EXPORTED, BECAUSE THE SENTENCE ABOVE USED TO BE A CLAIM AND IS NOW A MECHANISM (A1s review).** Until
// A1s the loader did not mention this file at all, so "the two spell one file one way" was true of ONE
// spelling. A1s LISTED it, which put a second bare `"Builtins.maxon"` literal in `StdlibLoader`'s whitelist
// — a second spelling of the one fact, at the rung whose whole thesis is that a fact belongs in one place.
// The loader now reads this constant instead. What it buys is narrow and worth stating: a rename is loud
// either way (the loader would throw `fileNotFound`, or the parser would refuse the module's own `__`
// declarations with E2051), but the exemption and the listing can no longer be given DIFFERENT files.
export let CompilerInternalDeclaringModule = "Builtins.maxon"

// ⭐ **IS THIS FILE THE ONE THAT DECLARES THE RESERVED NAMESPACE (D6)?** Read by the parser's single
// declaration choke point (`Parser.requireUnreservedName`, where the rule and its bootstrap lineage are
// stated in full).
//
// ⚠ **AN IDENTITY TEST, NOT A CONTAINMENT ONE, AND NOT `isStdlibSourceFile`'s ANSWER.** That function
// decides VISIBILITY and deliberately hands a project rooted under `stdlib/` its own files back as the
// USER's; being the compiler's internal bridge is a property of the FILE, so it must not turn on how a
// command line spelled it — see `Parser.declaresCompilerInternalNames`. Both sides are resolved before
// comparing, for the reason `isStdlibSourceFile` states: `FilePath.equals` compares SPELLINGS.
// ⚠ **THE NAME TEST GUARDS THE PATH TEST, AND THAT ORDER IS THE WHOLE COST OF THIS DOOR.** It is asked
// TWICE PER FILE (the declaration sweep and the real parse), and the identity test underneath it is the
// expensive shape `StdlibSource`'s header measured and rejected — a `Directory.currentPath()`, two
// `resolve`s, an interpolated `join`, and a `FilePath.equals` whose Windows arm clones and lower-cases
// BOTH sides. MEASURED unguarded, on the scale ladder: **+1,440 allocations at rung 0 rising to +8,260 at
// rung 5**, doubling with the file count — a per-file term paid by every compile to answer about ONE file
// that is not in it. The basename compare is a byte scan over a string the `FilePath` already holds
// (`toString` returns the field), it allocates nothing, and it is false for every file in any real
// program — so the identity test runs for `Builtins.maxon` and for nothing else.
//
// It is a PREFILTER and not the answer: a user's own `src/Builtins.maxon` passes it and is then refused by
// the path compare, which is exactly the case `Parser.declaresCompilerInternalNames` must get right.
function declaresCompilerInternalNames(project Project, path FilePath) returns bool
	if not path.toString().endsWith(CompilerInternalDeclaringModule) 'notEvenTheName'
		return false
	end 'notEvenTheName'

	// Interpolated so the argument is a committed `String`: a bare module-`let` literal stays untyped and
	// matches BOTH `FilePath.join` overloads (String / FilePath) — an E3007 ambiguity — exactly as
	// `StdlibSource.locateStdlibDir` records for `StdlibDirName`.
	return path.resolve(Directory.currentPath()).equals(project.stdlibDir.join("{CompilerInternalDeclaringModule}"))
end 'declaresCompilerInternalNames'

// Clear the registries that `mergeArtifact` rebuilds from artifacts, so a
// queryAllModule miss re-derives them cleanly rather than compounding a prior
// run's commits.
function resetMergeTargets(project Project)
	project.funcReturnTypes = FuncReturnTypeMap.create()
	project.funcSignatures = FuncSignatureMap.create()
	project.pendingFnMergeChecks = PendingFnMergeCheckArray.create()
	project.pendingFunctionTypeDoors = PendingFunctionTypeDoorArray.create()
	// The two deferred name-diagnostic lists and the collision set they are suppressed by: all three
	// are PUSH/INSERT targets of the merge, so a warm rebuild that re-merged the same files would
	// double every entry (`pendingFnMergeChecks`' reason, one line up).
	project.unusedTypeAliasDiagnostics = DeferredNameDiagnosticArray.create()
	project.hiddenTypeNameDiagnostics = DeferredNameDiagnosticArray.create()
	project.collidedTypeNames = CollidedTypeNameSet.create()
	// `conformances` is a PUSH array (like `pendingFnMergeChecks`): a warm rebuild that re-merges the
	// same files would DOUBLE it without this reset. `interfaces` is an upsert map, reset with it for
	// consistency so a queryAllModule miss re-derives both from the artifacts cleanly.
	project.conformances = ConformanceDeclArray.create()
	// The `<Type> from "…"` construction sites, a PUSH array for `conformances`' reason.
	project.literalInitSites = LiteralInitSiteArray.create()
	project.interfaces = IrInterfaceMap.create()
	// The accepted-member filing is DERIVED from those two and is FIRST-WINS, not an upsert
	// (`recordWitnessSlotImpl` returns early on a key it already holds, because two routes to one slot must
	// agree). Carried across a re-merge, a previous fold's selection would beat the new one — see
	// `WitnessSlotImplMap`, whose header claimed the opposite until R10c.
	project.witnessSlotImpls = WitnessSlotImplMap.create()
	project.typeAliases = RangedAliasRegistry.create()
	// FIRST-WINS, so it must reset: a warm rebuild that re-merged the same files would find every
	// name already claimed by its own declaration and report the whole program as duplicates.
	project.typeNameDecls = TypeNameRegistry.create()
	project.rangeChecks = RangeCheckPlanMap.create()
	project.structTypes = StructLayoutMap.create()
	project.typeNames = TypeNameInterner.create()
	// Must reset with the others: `mergeArtifact` appends spans to this table and
	// asserts its count tracks the merged module's op count. The module accumulator
	// (`merged`) is rebuilt from empty on every miss, so a span table carried over
	// from a prior run would start out of step and trip that assert.
	project.opRanges = SourceRangeTable.create()
end 'resetMergeTargets'

// Map a fatal LexerError to a project diagnostic. Each kind reports under the code
// that means exactly it. These used to share one generic `lexerError` code, which
// happened to be E1001 - the number the other two compilers spend on
// `LexerUnexpectedCharacter`. Three of the five kinds already HAD codes in the shared
// number space (E1002/E1006/E1007); shv2 was simply not using them.
function reportLexerError(project Project, path FilePath, error LexerError)
	match error 'kind'
		unexpectedEof(line, column) then reportPositioned(project, code: ErrorCode.lexerUnexpectedEof, message: "Unexpected end of input", line: line, column: column, filePath: path)
		unterminatedString(line, column) then reportPositioned(project, code: ErrorCode.lexerUnterminatedString, message: "Unterminated string literal", line: line, column: column, filePath: path)
		unterminatedBlockComment(line, column) then reportPositioned(project, code: ErrorCode.lexerUnterminatedBlockComment, message: "Unterminated block comment", line: line, column: column, filePath: path)
		unescapedBrace(line, column) then reportPositioned(project, code: ErrorCode.lexerUnescapedBrace, message: "Unescaped '\{' in string literal", line: line, column: column, filePath: path)
		unknownDirective(name, line, column) then reportPositioned(project, code: ErrorCode.lexerUnknownDirective, message: "Unknown compiler directive '#{name}'", line: line, column: column, filePath: path)
	end 'kind'
end 'reportLexerError'

// Map a DirectiveError to a project diagnostic. THREE codes, split by what the author got wrong
// rather than by where the filter noticed:
//
//   • E2063 — the REGION's structure does not close. Nothing is wrong with any condition.
//   • E2064 — the condition reads fine and the FUNCTION IT CALLS does not exist. The fix is a name,
//     and the message lists the names there are.
//   • E2065 — the condition cannot be READ, either because it does not parse or because text follows
//     it on its line. There is no name to look up.
//
// ⚠ E2064 and E2065 shipped as ONE code, on the argument that "a condition the grammar has no
// production for names no predicate the compiler knows". That does not survive contact with a
// missing `)`: the reader is told their predicate name is unknown when the name was fine, and
// `lookup_error_code E2064` -- whose registry text says "names a predicate that does not exist" --
// confirms the wrong diagnosis. Two faults, two fixes, two codes.
function reportDirectiveError(project Project, path FilePath, error DirectiveError)
	match error 'kind'
		unterminatedIf(line, column) then reportPositioned(project, code: ErrorCode.directiveUnbalanced, message: "Unterminated '#if' -- the region is still open at end of file. Every '#if' needs a matching '#endif'", line: line, column: column, filePath: path)
		unmatchedDirective(spelling, line, column) then reportPositioned(project, code: ErrorCode.directiveUnbalanced, message: "'{spelling}' has no matching '#if'", line: line, column: column, filePath: path)
		unknownPredicate(name, line, column) then reportPositioned(project, code: ErrorCode.directiveUnknownPredicate, message: "Unknown conditional compilation function '{name}'. Expected {acceptedPredicateList()}.", line: line, column: column, filePath: path)
		malformedCondition(line, column) then reportPositioned(project, code: ErrorCode.directiveMalformedCondition, message: "Malformed '#if' condition. Expected a predicate call -- {acceptedPredicateList()} -- optionally combined with 'and', 'or', 'not' and parentheses", line: line, column: column, filePath: path)
		trailingConditionTokens(line, column) then reportPositioned(project, code: ErrorCode.directiveMalformedCondition, message: "Unexpected text after the '#if' condition -- a condition ends at the end of its own line", line: line, column: column, filePath: path)
	end 'kind'
end 'reportDirectiveError'

// The E2003 an `as` cast target that names a typealias the reading file cannot see reports (P1.9).
// Worded ONCE because it has two producers that must not drift: the `hiddenCastTargetType` arm below
// (a TOP-LEVEL constant's cast, re-raised at the declaration) and
// `TypeResolution.reportDeferredNameDiagnostics` (a BODY cast, deferred so the report order does not
// depend on the file walk). It is the reference oracle's exact text, which it also gives a name that no
// declaration binds anywhere — a case shv2 reports more sharply as E3011
// (`specs-shv2/cast-target-type-resolution.md`).
export let HiddenTypeNameMessage = "Expected type name after 'as'"

// Map a ParseError to a project diagnostic. The unexpected-token case is the
// spec-gated E2010 (`parserExpectedToken`) — its exact `Expected '<x>' but got
// '<y>'` text + positioned prefix is compared byte-for-byte by `variables.md`'s
// type-annotation-rejection tests. `undefinedVariable` joins `expectedExpression`
// under E2004: both are EXPRESSION-level parse failures, and E2004 is the code the
// corpus (and both reference compilers) use for a name with no binding in scope —
// see the registry (docs/error-codes.txt). The arms that once shared a generic
// `parserError` code now each report under the code that means them: that generic code
// was E3010, a SEMANTIC-band number the other two compilers spend on
// `SemanticUnneededCast` - a parser error wearing a semantic number, and colliding
// while it did so.
function reportParseError(project Project, path FilePath, error ParseError)
	match error 'kind'
		unexpectedToken(expected, got, line, column) then reportPositioned(project, code: ErrorCode.parserExpectedToken, message: "Expected '{expected}' but got '{got}'", line: line, column: column, filePath: path)
		expectedExpression(got, line, column) then reportPositioned(project, code: ErrorCode.parserExpressionError, message: "Expected expression but got '{got}'", line: line, column: column, filePath: path)
		unexpectedEof(line, column) then reportPositioned(project, code: ErrorCode.parserUnexpectedEof, message: "Unexpected end of input", line: line, column: column, filePath: path)
		// The literal is quoted VERBATIM — `0x1ff_ffffffffffffff`, separators and radix prefix intact —
		// because the source's own spelling is what the reader has to find, and the decoded value does
		// not exist (that is the failure). The span is `I64MinBound`/`I64MaxBound`, the very constants
		// `parseInt` enforces, so the limit the message names cannot drift from the limit that fired.
		integerOverflow(literal, line, column) then reportPositioned(project, code: ErrorCode.parserLiteralOverflow, message: "Integer literal '{literal}' is outside the range of int ({I64MinBound} to {I64MaxBound})", line: line, column: column, filePath: path)
		// The same CODE as its integer twin — a literal outside its type's range is one meaning,
		// and the registry keys a code to a meaning — with a message that names the right type and
		// the right limit. `1e400` is not an integer and does not overflow an integer's range; its
		// limit is `f64.max`, which no i64 span describes, so the float wording names the TYPE and
		// stops there rather than spelling out a bound.
		floatLiteralOverflow(literal, line, column) then reportPositioned(project, code: ErrorCode.parserLiteralOverflow, message: "Float literal '{literal}' is outside the range of float", line: line, column: column, filePath: path)
		// `E3005 SemanticTypeMismatch` — a type mismatch, and not a missing feature. It reads
		// "requires integer operands" rather than "does not support floats" because that is the
		// permanent shape of the rule: `mod` and the bit operators have no float meaning to add
		// later (TypeRules.operatorIsIntegral).
		nonIntegralOperands(op, operand, line, column) then reportPositioned(project, code: ErrorCode.typeMismatch, message: "operator '{op}' requires integer operands, but this one is {operand}", line: line, column: column, filePath: path)
		// ⭐ E3009, the SAME code the explicit `5.0 as int` gets — because it is the same fact, and
		// their disagreeing is the bug this rung removed. `SemanticCheck.checkArgTypes` emits this
		// exact code and message for a call argument, so the four coercion sites speak with one
		// voice. `implicitNarrowingMessage` is where the words live, once.
		implicitNarrowing(sourceType, targetType, line, column) then reportPositioned(project, code: ErrorCode.semanticUnsafeCast, message: implicitNarrowingMessage(sourceType, targetType: targetType), line: line, column: column, filePath: path)
		builtinArity(name, expected, got, line, column) then reportPositioned(project, code: ErrorCode.callArgCountMismatch, message: "'{name}' takes exactly {expected} argument, but {got} were given", line: line, column: column, filePath: path)
		builtinOperandType(name, required, got, line, column) then reportPositioned(project, code: ErrorCode.typeMismatch, message: "'{name}' requires a {required}, but its argument is {got}", line: line, column: column, filePath: path)
		// ⭐ The SIGNATURE-checked builtins (the `__Managed*` family) report through the sentence
		// `SemanticCheck` already uses for an ordinary call argument, not through the operand wording above —
		// because their arguments ARE a signature check: both references register real parameter names and
		// types for them (`2-Parser.cs:1414-1440`) and run them through the ordinary argument checker, which is
		// why `builtin-type-checking` pins that exact sentence. `argTypeMismatchSentence` is its one producer.
		builtinArgumentType(paramName, expected, got, line, column) then reportPositioned(project, code: ErrorCode.typeMismatch, message: argTypeMismatchSentence(quotedParamLabel(paramName), expected: expected, got: got), line: line, column: column, filePath: path)
		unsupported(feature, line, column) then reportPositioned(project, code: ErrorCode.parserUnsupportedFeature, message: "Unsupported: {feature}", line: line, column: column, filePath: path)
		duplicateParameter(name, line, column) then reportPositioned(project, code: ErrorCode.duplicateParameter, message: "duplicate parameter name '{name}'", line: line, column: column, filePath: path)
		undefinedVariable(name, line, column) then reportPositioned(project, code: ErrorCode.parserExpressionError, message: "Undefined variable '{name}'", line: line, column: column, filePath: path)
		missingReturn(name, line, column) then reportPositioned(project, code: ErrorCode.missingReturn, message: "missing return statement: '{name}'", line: line, column: column, filePath: path)
		returnValueFromVoid(name, line, column) then reportPositioned(project, code: ErrorCode.typeMismatch, message: "type mismatch: '{name}' declares no return type, so it cannot return a value", line: line, column: column, filePath: path)
		returnWithoutValue(name, line, column) then reportPositioned(project, code: ErrorCode.missingReturn, message: "missing return value: '{name}' declares a return type, so every 'return' must carry a value", line: line, column: column, filePath: path)
		assignToImmutable(name, line, column) then reportPositioned(project, code: ErrorCode.assignToImmutable, message: "cannot assign to immutable variable: '{name}'", line: line, column: column, filePath: path)
		// Wave C, static single-owner. shv2-only — the reference compilers refcount and have no move
		// model, so there is no bootstrap text to match. Positioned on the use.
		useAfterMove(name, line, column) then reportPositioned(project, code: ErrorCode.useAfterMove, message: "use of moved value '{name}': its ownership moved to another binding at an earlier bind or assignment", line: line, column: column, filePath: path)
		// `targets` rather than a hardcoded "loop": a `break` may also leave a MATCH statement, so the old
		// shared wording was FALSE for one of the two keywords. `Parser.controlTargetNoun` is where the
		// noun is decided, from the same bit that decides which stacks the resolution searches.
		controlOutsideLoop(keyword, targets, line, column) then reportPositioned(project, code: ErrorCode.controlOutsideLoop, message: "'{keyword}' can only be used inside a {targets}", line: line, column: column, filePath: path)
		labelTargetsOwnLoop(keyword, label, line, column) then reportPositioned(project, code: ErrorCode.labelTargetsOwnLoop, message: "'{keyword}' with label '{label}' targets its own loop; use '{keyword}' without a label, or '{keyword}' with the label of an outer loop", line: line, column: column, filePath: path)
		unknownLoopLabel(keyword, targets, label, line, column) then reportPositioned(project, code: ErrorCode.controlOutsideLoop, message: "'{keyword}' targets no enclosing {targets} with label '{label}'", line: line, column: column, filePath: path)
		firstArgNamed(line, column) then reportPositioned(project, code: ErrorCode.callFirstArgNamed, message: "the first argument cannot be named; only the second and later arguments take 'name:' labels", line: line, column: column, filePath: path)
		argMissingLabel(line, column) then reportPositioned(project, code: ErrorCode.callArgMissingLabel, message: "the second and later arguments must be named ('name: value')", line: line, column: column, filePath: path)
		// P1.7a slice 2b-vi. The three codes AND the three messages are the ones a DIRECT call's slotting
		// failure gets (`SemanticCheck.validateCall`), because it is the same rule met at a witness
		// dispatch — see the `ParseError` arms' header for why the parser is what raises them.
		witnessArgCountMismatch(callee, expected, got, line, column) then reportPositioned(project, code: ErrorCode.callArgCountMismatch, message: argArityMismatchMessage(callee, expected: expected, got: got), line: line, column: column, filePath: path)
		witnessUnknownArgLabel(callee, label, line, column) then reportPositioned(project, code: ErrorCode.callUnknownArgLabel, message: argUnknownLabelMessage(callee, label: label), line: line, column: column, filePath: path)
		witnessDuplicateArg(callee, paramName, line, column) then reportPositioned(project, code: ErrorCode.callDuplicateArg, message: argDuplicateMessage(callee, paramName: paramName), line: line, column: column, filePath: path)
		// R10c. Both name the DECLARING interface of every requirement they mention, which is the interface
		// the author has to edit — `renderWitnessRequirement` is the one place a requirement is spelled.
		ambiguousWitnessDispatch(method, typeParamName, argCount, first, second, line, column) then reportPositioned(project, code: ErrorCode.semanticAmbiguousWitnessDispatch, message: "'{method}' taking {argCount} argument(s) is provided by both {first} and {second} through the constraints on type parameter '{typeParamName}' — a witness dispatch binds ONE table slot, and these are two, so there is nothing to choose by. Rename one requirement, or drop one of the constraints", line: line, column: column, filePath: path)
		noWitnessRequirementOfArity(method, typeParamName, argCount, available, line, column) then reportPositioned(project, code: ErrorCode.semanticNoWitnessRequirementForArgCount, message: "no requirement named '{method}' provided by the constraints on type parameter '{typeParamName}' takes {argCount} argument(s); they provide {available}", line: line, column: column, filePath: path)
		staticRequirementNotDispatchable(requirement, typeParamName, line, column) then reportPositioned(project, code: ErrorCode.semanticStaticRequirementNotDispatchable, message: "'{requirement}' is a `static` requirement, and a `static` member has no receiver to dispatch on — so a value of type parameter '{typeParamName}' cannot reach it. Call a `static` member on a concrete type", line: line, column: column, filePath: path)
		operandTypeMismatch(op, line, column) then reportPositioned(project, code: ErrorCode.typeMismatch, message: "operator '{op}' requires both operands to be the same type (both bool or both int)", line: line, column: column, filePath: path)
		nonNumericOperands(left, right, line, column) then reportPositioned(project, code: ErrorCode.parserExpressionError, message: "Cannot operate on {left} and {right}", line: line, column: column, filePath: path)
		nonNumericNegation(operand, line, column) then reportPositioned(project, code: ErrorCode.parserExpressionError, message: "Cannot negate {operand}", line: line, column: column, filePath: path)
		// ⚠ Byte-for-byte the bootstrap's text (ShiftSemantics.NegativeCountMessage) — the specs gate
		// stderr exactly, in both suites, so the two must not drift. It names what is still LEGAL as
		// well as what is not: `shl 64` was rejected before this rule was narrowed to Go's, and is
		// now a perfectly good way to say "shift every bit out".
		shiftCountNegative(count, line, column) then reportPositioned(project, code: ErrorCode.shiftCountNegative, message: "Shift count {count} is negative: a shift distance must be {MinShiftCount} or greater (a count of {ShiftCountBits} or more is legal — it shifts every bit out)", line: line, column: column, filePath: path)
		comparisonTypeMismatch(left, right, line, column) then reportPositioned(project, code: ErrorCode.typeMismatch, message: "type mismatch: 'cannot compare {left} with {right}'", line: line, column: column, filePath: path)
		operatorRequiresConformance(op, typeParamName, interfaceName, line, column) then reportPositioned(project, code: ErrorCode.typeMismatch, message: "Operator '{op}' requires type parameter '{typeParamName}' to be constrained with 'where {typeParamName} is {interfaceName}'", line: line, column: column, filePath: path)
		witnessSelfArgNotTypeParam(what, typeParamName, got, line, column) then reportPositioned(project, code: ErrorCode.typeMismatch, message: "'{what}' on type parameter '{typeParamName}' requires an argument of type '{typeParamName}' (the `Self` its constraint provides), not {got}", line: line, column: column, filePath: path)
		structEqualsResultNotBool(structName, got, op, line, column) then reportPositioned(project, code: ErrorCode.typeMismatch, message: "Operator '{op}' dispatches '{structName}.equals', which returns '{got}' — an equality operator requires the 'bool' result 'Equatable' declares", line: line, column: column, filePath: path)
		nonBoolCondition(keyword, got, line, column) then reportPositioned(project, code: ErrorCode.typeMismatch, message: "'{keyword}' requires a bool condition, got '{got}'", line: line, column: column, filePath: path)
		assignTypeMismatch(name, got, expected, line, column) then reportPositioned(project, code: ErrorCode.typeMismatch, message: "cannot assign '{got}' to variable '{name}' of type '{expected}'", line: line, column: column, filePath: path)
		returnTypeMismatch(got, expected, line, column) then reportPositioned(project, code: ErrorCode.typeMismatch, message: "Cannot return '{got}' from function declared to return '{expected}'", line: line, column: column, filePath: path)
		functionValueIntoNonFunction(noun, name, heldType, line, column) then reportPositioned(project, code: ErrorCode.typeMismatch, message: "cannot assign a value of type 'function' to {noun} '{name}', which holds '{heldType}': {FunctionValueMisuseSuffix}", line: line, column: column, filePath: path)
		functionValueReturned(returnType, line, column) then reportPositioned(project, code: ErrorCode.typeMismatch, message: "Cannot return 'function' from function declared to return '{returnType}': {FunctionValueMisuseSuffix}", line: line, column: column, filePath: path)
		// E3009, the SAME code the explicit lossy `5.0 as int` gets — one fact (a cast that is not a
		// legal conversion), one code. Byte-for-byte the bootstrap's `ValidateCast` text, so the two
		// compilers reject an incompatible-kind cast identically (`Cannot cast from String to int`).
		invalidCast(sourceType, targetType, line, column) then reportPositioned(project, code: ErrorCode.semanticUnsafeCast, message: "Cannot cast from {sourceType} to {targetType}", line: line, column: column, filePath: path)
		// E3011 and `unknownTypeMessage` — the SAME code and the SAME wording `TypeResolution` gives an
		// undeclared type met at a parameter, a return type or a field, because it is ONE FACT met wherever
		// a type name can be written. Only the ANCHOR differs, and in this direction: the declaration sites
		// record no span for a type REFERENCE, and every raiser of this arm holds a token. See the
		// `ParseError` arm for the routes (the two `as` casts, the three member-access doors) and for why a
		// parse-time door has to report a code the authority also reports — a thrown `ParseError` discards
		// this file's artifact diagnostics, so on those routes nothing else ever says it.
		unknownTypeName(typeName, line, column) then reportPositioned(project, code: ErrorCode.unknownType, message: unknownTypeMessage(typeName), line: line, column: column, filePath: path)
		throwingFunctionAsValue(name, errorType, line, column) then reportPositioned(project, code: ErrorCode.throwingFunctionAsValue, message: "Cannot use throwing function '{name}' as a value: it throws '{errorType}', and a function type cannot express 'throws'. Wrap the call in a non-throwing function that handles the error with 'try'.", line: line, column: column, filePath: path)
		capturingClosureEscapes(message, line, column) then reportPositioned(project, code: ErrorCode.capturingClosureEscapes, message: message, line: line, column: column, filePath: path)
		giveTypeMismatch(got, expected, line, column) then reportPositioned(project, code: ErrorCode.typeMismatch, message: "match arms give incompatible types: '{got}' vs '{expected}'", line: line, column: column, filePath: path)
		// P1.5 #80/#81 — the E2028 registry doc already covers "a ternary's two branches produce different
		// types (or a ternary condition is not bool)". Both anchor at the `if`.
		ternaryValueTypeMismatch(trueType, falseType, line, column) then reportPositioned(project, code: ErrorCode.matchTypeMismatch, message: "ternary expression type mismatch: true branch is '{trueType}' but false branch is '{falseType}'", line: line, column: column, filePath: path)
		ternaryNonBoolCondition(got, line, column) then reportPositioned(project, code: ErrorCode.matchTypeMismatch, message: "ternary expression requires a bool condition, got '{got}'", line: line, column: column, filePath: path)
		invalidCharacterLiteral(reason, line, column) then reportPositioned(project, code: ErrorCode.parserInvalidCharacterLiteral, message: "invalid character literal: {reason}", line: line, column: column, filePath: path)
		// The message is built at the decode site (`Parser.invalidUnicodeEscapeError`) because the LITERAL
		// FORM is known there and not here; both reference compilers word it identically and
		// `specs-shv2/unicode-escape.md` compares stderr byte-for-byte.
		invalidUnicodeEscape(message, line, column) then reportPositioned(project, code: ErrorCode.lexerInvalidEscape, message: message, line: line, column: column, filePath: path)
		notOnUnknownType(line, column) then reportPositioned(project, code: ErrorCode.typeMismatch, message: "'not' needs its operand's type: `not` is a bit-flip on a bool and a 64-bit complement on an int, and this operand's type is not known (it is a call to a function no file in the program declares)", line: line, column: column, filePath: path)
		voidCallResultUsed(name, line, column) then reportPositioned(project, code: ErrorCode.parserExpressionError, message: "Function '{name}' does not return a value", line: line, column: column, filePath: path)
		duplicateTopLevelDeclaration(name, line, column) then reportPositioned(project, code: ErrorCode.duplicateDefinition, message: "duplicate definition of '{name}'", line: line, column: column, filePath: path)
		// ⚠ The three top-level-constant arms carry the BOOTSTRAP'S EXACT TEXT — `specs-shv2/top-level-let.md`
		// gates two of them byte-for-byte, and both suites compare stderr exactly, so the two compilers
		// must not drift. (2-Parser.cs:4955-4957, :5281-5283, :4984-4986.)
		circularConstants(names, line, column) then reportPositioned(project, code: ErrorCode.parserCircularDependency, message: "Circular dependency detected among global constants: {names}", line: line, column: column, filePath: path)
		functionCallInConstant(callee, line, column) then reportPositioned(project, code: ErrorCode.parserNonConstantInitializer, message: "Function calls are not allowed in global variable initializers; '{callee}()' is not a constant expression", line: line, column: column, filePath: path)
		nonConstantInitializer(name, leftover, line, column) then reportPositioned(project, code: ErrorCode.parserNonConstantInitializer, message: "Global initializer for '{name}' is not a constant expression: '{leftover}' cannot be evaluated at compile time", line: line, column: column, filePath: path)
		undefinedConstant(name, line, column) then reportPositioned(project, code: ErrorCode.parserExpressionError, message: "Undefined constant '{name}'", line: line, column: column, filePath: path)
		constantDivisionByZero(op, line, column) then reportPositioned(project, code: ErrorCode.parserNonConstantInitializer, message: "'{op}' by zero has no value: a global initializer is folded at compile time, so there is no run time for it to trap in", line: line, column: column, filePath: path)
		// E3103 for a BODY divide whose divisor the compiler holds as 0 (A1). The wording is the
		// bootstrap's own (`2-Parser.cs:23623-23625`), byte-for-byte, because both suites compare stderr
		// exactly and this diagnostic exists in both.
		divisionByProvableZero(op, line, column) then reportPositioned(project, code: ErrorCode.semanticDivisionByZero, message: "division by zero: the divisor of '{op}' is always 0", line: line, column: column, filePath: path)
		// E3005 for a top-level `let` cast whose literal is outside its ranged alias — the same code, the
		// same words (`literalOutOfRangeMessage`) and the same anchor a body cast gets from
		// `InsertRangeChecks`; only the tier that noticed differs (see `Parser.constantCastOutOfRange`).
		constantCastOutOfRange(value, aliasName, low, high, isFloat, line, column) then reportPositioned(project, code: ErrorCode.typeMismatch, message: literalOutOfRangeMessage(value, aliasName: aliasName, low: low, high: high, isFloat: isFloat), line: line, column: column, filePath: path)
		// The struct arms (P1.0r, plus `assignToImmutableField` at P1.1a wave 2). Each carries the
		// code its meaning is registered under in `docs/error-codes.txt` — never a number spelled here.
		constructorRestricted(typeName, line, column) then reportPositioned(project, code: ErrorCode.semanticConstructorRestriction, message: "'{typeName}' can only be constructed inside its own methods; use a static factory such as '{typeName}.create(...)'", line: line, column: column, filePath: path)
		builtinTypeConstruction(typeName, line, column) then reportPositioned(project, code: ErrorCode.semanticBuiltinTypeConstruction, message: "'{typeName}' is a compiler builtin type and cannot be constructed directly", line: line, column: column, filePath: path)
		unknownField(typeName, fieldName, line, column) then reportPositioned(project, code: ErrorCode.semanticUnknownField, message: "type '{typeName}' has no field named '{fieldName}'", line: line, column: column, filePath: path)
		fieldNotInitialized(typeName, fieldName, line, column) then reportPositioned(project, code: ErrorCode.semanticFieldNotInitialized, message: "field '{fieldName}' of '{typeName}' is not initialized by this literal, and it has no default value", line: line, column: column, filePath: path)
		// The SAME code as `unknownField`, and deliberately: a literal whose field list does not
		// correspond one-to-one with the type's is one defect, seen from its two sides.
		duplicateFieldInitializer(typeName, fieldName, line, column) then reportPositioned(project, code: ErrorCode.semanticUnknownField, message: "field '{fieldName}' of '{typeName}' is initialized twice by this literal", line: line, column: column, filePath: path)
		// ⚠ The SAME code as `assignToImmutable` — one rule, two sides (see the ParseError arm) —
		// and byte-for-byte the bootstrap's text, because `structs.md` and
		// `challenge-struct-field-assign.md` both gate this stderr exactly, in both suites.
		assignToImmutableField(typeName, fieldName, line, column) then reportPositioned(project, code: ErrorCode.assignToImmutable, message: "cannot assign to field '{typeName}.{fieldName}' because it is immutable (declare with 'var' to make it mutable)", line: line, column: column, filePath: path)
		// The instance-method arms (P1.1a wave 3).
		//
		// ⚠ Byte-for-byte the bootstrap's text for both, because `export-var-fields.md` gates this
		// stderr exactly and the two suites run the same spec file.
		localShadowsSelfField(name, typeName, line, column) then reportPositioned(project, code: ErrorCode.duplicateDefinition, message: "local '{name}' shadows self field '{typeName}.{name}' — rename the local to avoid silent type confusion at every read/write keyed on the name", line: line, column: column, filePath: path)
		unexportedFieldAccess(typeName, fieldName, line, column) then reportPositioned(project, code: ErrorCode.unexportedFieldAccess, message: "cannot access unexported field: '{fieldName}' outside of type '{typeName}'", line: line, column: column, filePath: path)
		immutableMutatingCall(name, functionName, line, column) then reportPositioned(project, code: ErrorCode.semanticImmutableRefToMutatingParam, message: immutableMutatingCallMessage(name, paramName: SelfParamDisplayName, functionName: functionName), line: line, column: column, filePath: path)
		// The scalar-match arms (P1.1b wave A). Each carries the code its meaning is registered under
		// in `docs/error-codes.txt`, and each message is byte-for-byte the reference compilers' — the
		// `maxoncstderr` goldens in `match-statements.md`/`match-simple.md` gate them exactly.
		matchExpressionStrayToken(got, line, column) then reportPositioned(project, code: ErrorCode.parserUnexpectedToken, message: "unexpected token: '{got}'", line: line, column: column, filePath: path)
		matchFallthroughWithReturn(line, column) then reportPositioned(project, code: ErrorCode.matchFallthroughWithReturn, message: "match fallthrough with return: 'cannot combine 'fallthrough' with 'return''", line: line, column: column, filePath: path)
		matchNotExhaustive(subject, line, column) then reportPositioned(project, code: ErrorCode.matchNotExhaustive, message: "{subject} is not exhaustive: add a 'default' arm", line: line, column: column, filePath: path)
		matchDuplicatePattern(pattern, line, column) then reportPositioned(project, code: ErrorCode.matchDuplicatePattern, message: "duplicate pattern in match: '{pattern}'", line: line, column: column, filePath: path)
		matchPatternTypeMismatch(patternType, scrutineeType, line, column) then reportPositioned(project, code: ErrorCode.matchTypeMismatch, message: "pattern type '{patternType}' does not match scrutinee type '{scrutineeType}'", line: line, column: column, filePath: path)
		matchDefaultNotLast(line, column) then reportPositioned(project, code: ErrorCode.matchDefaultNotLast, message: "'default' case must be the last case in match", line: line, column: column, filePath: path)
		matchMissingBlockId(line, column) then reportPositioned(project, code: ErrorCode.matchMissingBlockId, message: "missing block identifier", line: line, column: column, filePath: path)
		matchMismatchedBlockId(expected, got, line, column) then reportPositioned(project, code: ErrorCode.matchMismatchedBlockId, message: "block identifier mismatch: expected '{expected}', got '{got}'", line: line, column: column, filePath: path)
		matchBlockStatement(keyword, line, column) then reportPositioned(project, code: ErrorCode.matchBlockStatement, message: "block-opening statement '{keyword}' is not allowed in a match arm; use a function call instead", line: line, column: column, filePath: path)
		// The enum/union arms (P1.1b wave B). For an ENUM every message is byte-for-byte the reference
		// compilers' — the ported `maxoncstderr` goldens gate them exactly. For a UNION the messages
		// that name the construct print the DECLARED keyword via `kindWord`: E3034 (unknown-case) is
		// conditional in the bootstrap too, so it matches; E2026/E2046 print "union" where the
		// bootstrap hardcodes "enum" (a `{"enum"}` literal in 2-Parser.cs, an apparent oversight, since
		// its own E3034 is conditional). No union `maxoncstderr` golden gates these yet.
		enumDuplicateCase(caseName, line, column) then reportPositioned(project, code: ErrorCode.enumDuplicateCase, message: "duplicate enum case: '{caseName}'", line: line, column: column, filePath: path)
		enumDuplicateRawValue(rawValue, line, column) then reportPositioned(project, code: ErrorCode.enumDuplicateRawValue, message: "duplicate raw value: '{rawValue}'", line: line, column: column, filePath: path)
		enumRawValueTypeMismatch(detail, line, column) then reportPositioned(project, code: ErrorCode.enumRawValueTypeMismatch, message: "raw value type mismatch: '{detail}'", line: line, column: column, filePath: path)
		enumUnknownCase(kindWord, caseName, line, column) then reportPositioned(project, code: ErrorCode.enumUnknownCase, message: "unknown {kindWord} case: '{caseName}'", line: line, column: column, filePath: path)
		matchQualifiedCaseName(bare, qualified, line, column) then reportPositioned(project, code: ErrorCode.matchQualifiedCaseName, message: "use '{bare}' instead of '{qualified}' in match", line: line, column: column, filePath: path)
		matchDiscardedBindings(caseName, discardList, line, column) then reportPositioned(project, code: ErrorCode.semanticMatchDiscardedBindings, message: "use '{caseName}' instead of '{caseName}({discardList})' to ignore associated values", line: line, column: column, filePath: path)
		matchDefaultEnumMustThrow(kindWord, typeName, line, column) then reportPositioned(project, code: ErrorCode.matchDefaultEnumMustThrow, message: "'default' in a match on {kindWord} '{typeName}' must be followed by 'throws <error>' or 'panic(\"message\")'", line: line, column: column, filePath: path)
		enumMatchNotExhaustive(kindWord, typeName, missing, line, column) then reportPositioned(project, code: ErrorCode.matchNotExhaustive, message: "match on {kindWord} '{typeName}' is not exhaustive, missing: {missing}", line: line, column: column, filePath: path)
		matchOverlappingCase(caseName, line, column) then reportPositioned(project, code: ErrorCode.matchDuplicatePattern, message: "overlapping pattern in match: '{caseName}' is already covered", line: line, column: column, filePath: path)
		matchEmptyRange(low, high, line, column) then reportPositioned(project, code: ErrorCode.matchDuplicatePattern, message: "range pattern '{low} to {high}' is empty: '{high}' is declared before '{low}'", line: line, column: column, filePath: path)
		// A `union` value compared with `==`/`!=` (E3066). Byte-for-byte the bootstrap's text — the
		// ported `enum-match-only.md` `maxoncstderr` goldens gate this stderr exactly, so the two
		// compilers must not drift.
		unionNotComparable(op, line, column) then reportPositioned(project, code: ErrorCode.semanticEnumNotComparable, message: "cannot compare union values using '{op}', use 'match' instead", line: line, column: column, filePath: path)
		// The reserved-name arm (P1.2 follow-up). Byte-for-byte the bootstrap's text — the ported
		// `reserved-double-underscore.md` `maxoncstderr` goldens gate this stderr exactly, so the two
		// compilers must not drift.
		reservedIdentifier(name, line, column) then reportPositioned(project, code: ErrorCode.reservedIdentifier, message: "identifier '{name}' is reserved: declarations starting with '__' are reserved for compiler internals", line: line, column: column, filePath: path)
		declarationTakesCompilerOwnedTypeName(name, line, column) then reportPositioned(project, code: ErrorCode.parserUnsupportedFeature, message: "Unsupported: a declaration of the type name '{name}', which the compiler owns — shv2 synthesizes that declaration rather than reading it from the stdlib, and has no namespace to tell a user declaration of the name apart from the builtin one", line: line, column: column, filePath: path)
		// The scalar-error arms (P1.4b). E3058/E3059/E2049 render the parser's error-handling diagnostics
		// (the `ParseError` variants are declared in `Parser.maxon`; this is their render half). Each
		// message is byte-for-byte the reference compiler's — the `error-handling.md`/`match-statements.md`
		// `maxoncstderr` goldens gate them exactly.
		otherwiseWithoutTry(line, column) then reportPositioned(project, code: ErrorCode.otherwiseRequiresTry, message: "otherwise requires try expression", line: line, column: column, filePath: path)
		errorTypeMismatch(detail, line, column) then reportPositioned(project, code: ErrorCode.errorTypeMismatch, message: "type mismatch: '{detail}'", line: line, column: column, filePath: path)
		tryBlockFormInMatchArm(isOtherwiseForm, line, column) then reportPositioned(project, code: ErrorCode.matchBlockStatement, message: tryBlockFormMessage(isOtherwiseForm), line: line, column: column, filePath: path)
		tryOnNonThrowing(callee, line, column) then reportPositioned(project, code: ErrorCode.tryRequiresThrowingFunction, message: "try requires a throwing function: '{callee}' does not throw'", line: line, column: column, filePath: path)
		// The BUILTIN half of E3055 — one code, a second message. The reference names the builtin
		// (`'stdlib.Array.count' does not throw'`); shv2 holds only the emitted runtime symbol
		// (`__arr_count`), which is reserved namespace the user never wrote, so it names the class instead.
		tryOnNonThrowingBuiltin(line, column) then reportPositioned(project, code: ErrorCode.tryRequiresThrowingFunction, message: "try requires a throwing function: this builtin call cannot fail", line: line, column: column, filePath: path)
		// A1x — it names the OPERATOR and the reason the divide is total, because the divisor's range is the
		// thing the author would have to change to make it fallible, and there is nothing here to catch.
		tryOnTotalDivision(operator, line, column) then reportPositioned(project, code: ErrorCode.tryRequiresThrowingFunction, message: "try requires a throwing function: this `{operator}` cannot fail — its divisor is already proven non-zero, so there is no divide-by-zero error to catch", line: line, column: column, filePath: path)
		// P1.5-B2b: a plain `await` of a throwing promise (E3057), and a `try …` propagate whose error type
		// differs from the enclosing function's (E3059). E3057 shares SemanticCheck's throwing-call-needs-try
		// code; E3059 shares the `errorTypeMismatch` code with its own full-sentence message.
		awaitThrowingPromiseNeedsTry(callee, line, column) then reportPositioned(project, code: ErrorCode.throwingFunctionRequiresTry, message: "throwing function requires try: 'await' on a promise from throwing '{callee}' drops the error — use 'try await'", line: line, column: column, filePath: path)
		byteStringCodepointRange(message) then reportPositioned(project, code: ErrorCode.lexerInvalidEscape, message: message, line: 0, column: 0, filePath: path)
		propagateTypeMismatch(propagated, enclosing, line, column) then reportPositioned(project, code: ErrorCode.errorTypeMismatch, message: "try propagates '{propagated}' but enclosing function throws '{enclosing}' — add 'otherwise' to convert", line: line, column: column, filePath: path)
		// The oracle's own sentence, verbatim — see `ParseError.thrownValueNotAnErrorEnum`.
		thrownValueNotAnErrorEnum(line, column) then reportPositioned(project, code: ErrorCode.typeMismatch, message: "throw requires an error enum value", line: line, column: column, filePath: path)
		// ⭐ E3004, the SAME code `SemanticCheck.validateCall` gives an undeclared ordinary function, because
		// it is the same fact — the call names something that does not exist. It shares the code and not the
		// wording: the message must say WHY no declaration could ever supply this one, since `__` is the
		// prefix the user is forbidden to declare (E2051) and a "did you mean to define it?" reading would
		// send them at a wall.
		unknownCompilerIntrinsic(callee, line, column) then reportPositioned(project, code: ErrorCode.callUnknownFunction, message: "call to undefined function '{callee}': the '__' prefix names a compiler intrinsic, and no intrinsic of that name exists", line: line, column: column, filePath: path)
		// ⭐ The words are the BOOTSTRAP's, verbatim (SemanticCheckPass.CheckDenseArrayGrowth), minus the
		// `growFilled`/`truncate` suggestions — shv2 synthesizes neither method, so naming them would
		// send the reader to something that is not there.
		arrayResizeManagedElement(elementType, line, column) then reportPositioned(project, code: ErrorCode.semanticArrayResizeManagedElement, message: "'resize' cannot grow an array of '{elementType}': a grown slot holds NO element — Maxon has no default constructor — so 'count()' would not agree with 'get()'. Append with 'push(value)'", line: line, column: column, filePath: path)
		// ⭐ It names the REPLACEMENT, not just the refusal, because there is an exact one: the array
		// surface's own `set` covers `[0, length)` and owns what it stores. See `E3109`'s registry entry.
		bufferSetManagedElement(elementType, line, column) then reportPositioned(project, code: ErrorCode.semanticBufferSetManagedElement, message: "'managed.set' cannot store an element of '{elementType}': it is bounded by the CAPACITY, so it writes slots no length has published, and nothing owns a managed element staged there until 'setLength' publishes it. Use the array's own 'set(index, value:)', which is bounded by the length", line: line, column: column, filePath: path)
		// ⚠ It names NO replacement, and the omission is the message: byte access to a pointer is not a thing
		// a correct program wants, so there is nothing to redirect the reader to. Contrast the arm above,
		// which has an exact one. Same predicate, different reason — see `requireBufferBytesAreNotAPointer`.
		bufferByteAccessManagedElement(member, elementType, line, column) then reportPositioned(project, code: ErrorCode.semanticBufferByteAccessManagedElement, message: "'managed.{member}' cannot address the bytes of an element of '{elementType}': a managed element is stored as a POINTER, so those bytes are a heap ADDRESS, not data — reading them discloses one and writing them corrupts it. Raw byte access is for a buffer of trivial elements", line: line, column: column, filePath: path)
		// ⭐ E3082, wording verbatim from the reference bootstrap (`empty block: '<label>'`) — the code is
		// the SEMANTIC band's because that is where the registry has always homed it and where the other
		// two compilers emit it from; shv2 raises it in the parser only because `parseBlockBody` is the
		// one place that knows a nested block consumed no statements.
		emptyBlock(label, line, column) then reportPositioned(project, code: ErrorCode.semanticEmptyBlock, message: "empty block: '{label}'", line: line, column: column, filePath: path)
		// The P1.9 DECLARATION-SITE typealias arms. Every message is byte-for-byte the reference
		// oracle's (2-Parser.cs:4794, :4831, :4838, :9840, :5782) — `ranged-typealias.md` and
		// `export-keyword.md` compare this stderr exactly, in both suites.
		bareSizedTypeAlias(typeName, line, column) then reportPositioned(project, code: ErrorCode.parserExpectedType, message: "Bare sized type '{typeName}' is not allowed. Use explicit range syntax, e.g. 'int({typeName}.min to {typeName}.max)'", line: line, column: column, filePath: path)
		mismatchedRangeBoundTypes(low, high, line, column) then reportPositioned(project, code: ErrorCode.typeMismatch, message: "Mismatched type bounds: '{low}' and '{high}' must reference the same type", line: line, column: column, filePath: path)
		unrepresentableIntegerRange(low, line, column) then reportPositioned(project, code: ErrorCode.typeMismatch, message: "Integer range cannot span both negative values and above i64.max: 'int({low} to u64.max)' is not representable in 64 bits; use 'i64.min to i64.max' or '0 to u64.max' instead", line: line, column: column, filePath: path)
		// The RANGE spells through `formatRangeDisplay`, the one place a range renders, so this and the
		// cast/return E3005s cannot come to print one alias's bounds two ways. The VALUE is spelled
		// plainly and deliberately NOT through that file's `formatBound`: an `otherwise` default is an
		// integer LITERAL the author wrote, never the wrapped `u64.max` sentinel that helper exists to
		// un-wrap, and the oracle prints it plainly too.
		otherwiseOutsideRangedReturn(value, aliasName, low, high, line, column) then reportPositioned(project, code: ErrorCode.typeMismatch, message: "otherwise value {value} is outside the range of '{aliasName}' ({formatRangeDisplay(low, high: high, isFloat: false)})", line: line, column: column, filePath: path)
		hiddenCastTargetType(line, column) then reportPositioned(project, code: ErrorCode.parserExpectedType, message: HiddenTypeNameMessage, line: line, column: column, filePath: path)
	end 'kind'
end 'reportParseError'

// The two E2049 block-form-in-match-arm messages (P1.4b), split out so the `reportParseError` arm stays a
// single expression. A block-form `try 'label' … end` (grouping multiple calls) versus a block-handler
// `otherwise 'label' … end` — both name the single-statement alternatives an arm may use instead.
function tryBlockFormMessage(isOtherwiseForm bool) returns String
	if isOtherwiseForm 'otherwiseForm'
		return "block-form 'try ... otherwise 'label' ... end' is not allowed in a match arm; use 'otherwise panic(\"...\")', 'otherwise ignore', or 'otherwise return/throw/...' instead"
	end 'otherwiseForm'
	return "block-form 'try ... end' is not allowed in a match arm; use a single-statement try form (e.g. 'try call()' or 'try call() otherwise panic(...)') instead"
end 'tryBlockFormMessage'
