// Compilation target: CPU architecture and operating system.
//
// THIN for maxon-shv2 M1: only the fields + queries the walking-skeleton backend
// needs (`target.cpu` / `target.os` dispatch in the PE writer + backend). v1's
// cache codecs, the argv-cache/networking capability queries, and the target-
// string parser GROW back at their milestones (Chunk C driver, M6 runtime, wasm).
// M1 builds only x64-windows, so `detectHostTarget` is the single constructor a
// caller needs today.

export enum CpuArch
	x64
	arm64
	wasm32
end 'CpuArch'

export enum Os
	windows
	linux
	macos
	wasi
end 'Os'

export type Target
	export let cpu as CpuArch
	export let os as Os

	export static function create(cpu CpuArch, os Os) returns Target
		return Self{cpu: cpu, os: os}
	end 'create'
end 'Target'

export function detectHostTarget() returns Target
	#if os(Windows)
		let hostOs = Os.windows
	#else
		#if os(Macos)
			let hostOs = Os.macos
		#else
			let hostOs = Os.linux
		#endif
	#endif

	#if arch(x64)
		let hostCpu = CpuArch.x64
	#else
		let hostCpu = CpuArch.arm64
	#endif

	return Target.create(hostCpu, os: hostOs)
end 'detectHostTarget'

export function targetToString(t Target) returns String
	let cpuStr = match t.cpu 'cpu'
		x64 gives "x64"
		arm64 gives "arm64"
		wasm32 gives "wasm32"
	end 'cpu'

	let osStr = match t.os 'os'
		windows gives "windows"
		linux gives "linux"
		macos gives "macos"
		wasi gives "wasi"
	end 'os'

	return "{cpuStr}-{osStr}"
end 'targetToString'

export function executableExtension(t Target) returns String
	return match t.os 'os'
		windows gives ".exe"
		linux gives ""
		macos gives ""
		wasi gives ".wasm"
	end 'os'
end 'executableExtension'
