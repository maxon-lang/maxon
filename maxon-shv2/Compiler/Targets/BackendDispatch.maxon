// BackendDispatch — the Phase-7 backend driver: it takes a lowered StdModule to
// a runnable executable. `buildBackend` runs the fixed Std→Target→CodeResult
// sequence; `augmentWithRuntime` supplies the OS entry point; `writeExecutable`
// dispatches the CodeResult to the per-OS object writer.
//
// Std, not MIR: shv2 has no MIR tier (see StdDialect's header). The backend's
// input is the Std module the pipeline produced, and `lowerStdToX64` asserts on
// entry that no Std-only `sugar` op survived to reach it.
//
// These stages are driven as ordered function calls rather than PassKind entries
// (the pipeline in PassPipeline stops at StdModule): the backend produces a
// CodeResult, which is not an IR module, so it does not fit the module-field
// dispatch model. This mirrors v1, where Phase 7 is backend-direct.
//
// THIN for maxon-shv2 M1 (x64-windows only). `augmentWithRuntime` installs the
// `mrt_start` entry stub; the PANIC RUNTIME it calls into (the `#DE` fault handler
// and its symbolized backtrace) is appended as hand-assembled chunks during the
// encode phase — see `buildBackend` and X64Runtime's header for why it cannot be
// TargetOps. A `return 42` program still allocates nothing and spawns nothing, so it
// carries none of the REST of v1's unconditional x64-windows runtime floor (no
// slab/MM init, no green-thread scheduler, no IOCP). Both halves are designed to
// GROW: M6 prepends slab/MM init, Phase F the green-thread scheduler.
// Linux/macOS/wasi entry stubs + `writeElf`/`writeMachO` dispatch arrive at their
// milestones.

// The user program's entry function — `mrt_start` calls it, then bridges its
// R8 return value to ExitProcess.
export let UserEntryName = "main"

// `mrt_start`'s frame: 32 bytes of Win64 shadow space for the calls it makes, and
// NOTHING else. The OS enters the stub with rsp ≡ 8 (mod 16), as if via `call`; the
// stub's own `push rbp` moves it to ≡ 0, so an exact-multiple-of-16 reservation keeps
// it aligned at each `call` and no odd 8 is needed.
//
// ⚠ This USED to be 0x28 (32 + 8) — the 8 was the alignment correction for a stub that
// pushed nothing. The frame pointer's push now supplies that parity, so the same
// arithmetic `computeFrameBytes` does for every other function (entry ≡ 8, one push ⇒ an
// even reservation) gives 0x20 here. Keeping 0x28 would leave rsp ≡ 8 AT the call — a
// misalignment nothing on this path reads today, and that would start corrupting the
// moment anything below it spills an XMM register (P1.0d.4 floats).
let EntryStubFrameBytes = 0x20

// Run the full backend: Std → Target → register allocation → prologue/epilogue →
// runtime augmentation → machine-code emission → CodeResult.
//
// `throws CompileError` because register allocation can now FAIL for a real reason the
// user must fix: a loop that needs more registers than exist (E5001, reported onto
// `project.diagnostics`). `project` also carries the `opRanges`/`valueOrigins` tables the
// allocator maps a Target ValueId back to its source span through. Every other backend
// stage is infallible — a failure there is a compiler bug and still panics.
// Each stage below is bracketed by one `PhaseProbe`, which measures its wall time AND its
// allocations at the same two instants (see PhaseProbe's header for why that is one type
// and not two). The stages are strictly sequential and none calls another, so the phases
// are disjoint by construction and nothing has to be subtracted back out (unlike the
// allocator's internals, which nest — see CompileTimings' header). `regalloc`'s own seven
// sub-phases are recorded into `project.timings.regAlloc` / `project.memory.regAlloc` and
// nest UNDER this phase in both reports; they are a breakdown of what is measured here,
// never additional phases.
// Run the backend for `target`, dispatched on its CPU: the x64 pipeline, or the arm64 one
// (`Arm64Backend`, wave 1). Both share the register allocator, the runtime augmentation and the
// per-OS writer; they differ in isel + encoder + frame, which is exactly the per-ISA split the
// unified `TargetOp` was chosen to allow (USER RULING). The sugar gate is target-neutral and runs
// here, once, so every backend inherits it.
export function buildBackend(stdModule StdModule, target Target, globalData GlobalDataTable, project Project) returns CodeResult throws CompileError
	let sugarProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.sugarGate)
	assertNoSugarOps(stdModule)
	recordPhase(project, phase: CompilePhase.sugarGate, probe: sugarProbe)

	match target.cpu 'cpu'
		x64 then return try buildX64Backend(stdModule, target: target, globalData: globalData, project: project)
		arm64 then return try buildArm64Backend(stdModule, target: target, globalData: globalData, project: project)
		wasm32 then return buildWasmBackend(stdModule, globalData: globalData, project: project)
	end 'cpu'
end 'buildBackend'

// The wasm backend: Std → a WASI-Preview2 CORE module (bytes). Unlike x64/arm64 it consumes the
// StdModule DIRECTLY — no register allocation, no prologue/epilogue, no Target dialect (see
// StdToWasm's header) — so this backend's isel, encode and link work is fused into the single
// `buildWasmCoreModule` call and billed together to `encode`. The `$run` entry (and the `wasi:cli/exit`
// import it calls) are synthesized inside that call, so `augmentWithRuntime` is NOT run for wasm and
// its `wasi` arm stays unreached. `globalData` reaches it because a top-level `var` is a `.data` slot
// this backend lays into an active linear-memory segment and resolves every `globalAddr` against —
// the same laid-out table the native writers serialize into their `.data` section. The bytes ride in
// the CodeResult's `wasmCoreModule` field; every machine-code field is empty (see
// `CodeResult.forWasm`), and `writeWasm` wraps the bytes into a component. It takes no `target`: the
// sole wasm target is wasm32-wasi, and `buildBackend` has already dispatched on it.
function buildWasmBackend(module StdModule, globalData GlobalDataTable, project Project) returns CodeResult
	let encodeProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.encode)
	let coreModule = buildWasmCoreModule(module, globalData: globalData)
	recordPhase(project, phase: CompilePhase.encode, probe: encodeProbe)

	return CodeResult.forWasm(module, wasmCoreModule: coreModule)
end 'buildWasmBackend'

// The x64 backend: Std → Target → register allocation → prologue/epilogue → runtime augmentation →
// machine-code emission → CodeResult.
function buildX64Backend(stdModule StdModule, target Target, globalData GlobalDataTable, project Project) returns CodeResult throws CompileError
	let iselProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.isel)
	// `globalData` reaches ISel because a float CONSTANT is `.rdata` content the lowering is the
	// first to see (`lowerFloatConst`). It is the same table concat resolves those labels against
	// once sections are laid out — see `lowerStdToX64`.
	// THE CLASS COLUMN CROSSES THE TIER BOUNDARY HERE, and it travels FORWARD, WITH the module: this
	// call is the last pass that can see a Std type, so it is the only one that can say which register
	// FILE a value lives in. The allocator consumes that answer and never re-derives it — `movRegReg`,
	// `loadRegSlot` and `xchgRegReg` are class-agnostic by design, so a copy's class is knowable only
	// from its source (see TargetDialect's `ValueClassColumn`).
	//
	// The two come back TOGETHER because a `TargetModule` alone is not a complete answer: it carries no
	// types, so nothing downstream could say what file any of its values belongs in. Returning the pair
	// is what makes it impossible to hand the allocator one without the other.
	var (targetModule, valueClasses) = lowerStdToX64(stdModule, target: target, globalData: globalData)
	recordPhase(project, phase: CompilePhase.isel, probe: iselProbe)

	let regAllocProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.regalloc)
	try allocateRegisters(targetModule, target: target, project: project, valueClasses: valueClasses)
	recordPhase(project, phase: CompilePhase.regalloc, probe: regAllocProbe)

	let prologueProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.prologueEpilogue)
	insertPrologueEpilogue(targetModule, target: target)
	recordPhase(project, phase: CompilePhase.prologueEpilogue, probe: prologueProbe)

	let runtimeProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.runtimeAugment)
	augmentWithRuntime(targetModule, target: target)
	recordPhase(project, phase: CompilePhase.runtimeAugment, probe: runtimeProbe)

	let encodeProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.encode)
	var chunks = FunctionCodeChunkArray.create()
	for func in targetModule.functions 'eachFunc'
		chunks.push(emitFunctionChunk(targetModule, func: func))
	end 'eachFunc'
	// The panic runtime is hand-assembled bytes, not TargetOps, so it joins here rather than
	// in `augmentWithRuntime` — there is no Std or Target spelling of "read CONTEXT.Rip" or
	// "walk a saved-RBP chain" at this milestone (see X64Runtime's header). It appends AFTER
	// user code, which keeps `mrt_start` at `.text` offset 0 where the backtrace needs it.
	//
	// ⚠ WINDOWS ONLY. The panic runtime installs a Windows Vectored Exception Handler and terminates
	// through ExitProcess — both x64-windows facts. Linux's scalar core has no fault handler (the
	// divide-by-zero and force-segfault tests are windows-gated) and reaches the OS through raw syscalls,
	// so it appends no runtime floor at all — exactly as the arm64-linux backend appends only its entry
	// stub. macos/wasi never reach here for an x64 module: `augmentWithRuntime` above already rejected them.
	match target.os 'panicRuntime'
		windows then appendX64RuntimeChunks(chunks)
		linux then break 'panicRuntime'
		macos to wasi then panic("buildX64Backend: augmentWithRuntime should have rejected {targetToString(target)} before the encode phase")
	end 'panicRuntime'
	recordPhase(project, phase: CompilePhase.encode, probe: encodeProbe)

	let linkProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.link)
	let codeResult = concatX64FunctionChunks(targetModule, stdModule: stdModule, chunks: chunks, globalData: globalData)
	recordPhase(project, phase: CompilePhase.link, probe: linkProbe)

	return codeResult
end 'buildX64Backend'

// Install the OS entry point at the MODULE level. x64-windows prepends `mrt_start` as a module
// function (all-physical registers, its own explicit frame), which concat lays out first; it runs
// AFTER register allocation and prologue/epilogue so the hand-built stub is never reprocessed. This
// pass is WINDOWS-ONLY: the arm64 backend has no module-level entry, because its macOS stub calls
// `_exit` through a GOT import that has no TargetOp channel, so it is hand-assembled as a
// FunctionCodeChunk in the encode phase instead (see `Arm64Backend.buildArm64Backend` /
// `Arm64Runtime`); arm64-linux shares that chunk, differing only in its exit route. So both non-wasi
// non-windows arms answer the same thing and are consolidated into one.
export function augmentWithRuntime(module TargetModule, target Target)
	match target.os 'os'
		windows then prependEntryStub(module, checkLeaks: moduleHasFunction(module, name: MmLeakCheckName))
		linux then prependLinuxEntryStub(module, checkLeaks: moduleHasFunction(module, name: MmLeakCheckName))
		macos then panic("augmentWithRuntime: there is no x64-macOS backend — `buildBackend` dispatches macOS to the arm64 backend, whose entry stub is a hand-assembled chunk (Arm64Backend.buildArm64Backend), not a module function")
		wasi then panic("augmentWithRuntime: wasm32-wasi does not use the x64 backend — the wasm backend synthesizes its own $run entry (buildWasmCoreModule), so this module-level pass is never reached for it")
	end 'os'
end 'augmentWithRuntime'

// Whether the MM runtime was installed — i.e. whether the program reaches the heap at all. The
// entry stub asks the MODULE rather than being told, because by this point the module IS the
// answer: `installMmRuntime` put the function there, and a second flag threaded down from
// `compileToCodeResult` would be the same fact written down twice, free to disagree. Exported so the
// arm64 backend's chunk-built entry stub decides its leak gate from the same one question.
export function moduleHasFunction(module TargetModule, name ByteArray) returns bool
	for func in module.functions 'eachFunc'
		if func.name == name 'found'
			return true
		end 'found'
	end 'eachFunc'
	return false
end 'moduleHasFunction'

// Build `mrt_start` and lay it out FIRST so its `.text` offset is the PE entry
// point. The stub bridges Maxon's custom ABI (primary return in R8) to Win64's
// ExitProcess (UINT arg in ECX):
//   push rbp           open the saved-RBP chain (see below)
//   mov rbp, rsp       … so a backtrace can name mrt_start and then stop
//   sub rsp, 0x20      reserve shadow space (rsp is already 16-aligned by the push)
//   call mrt_runtime_init   install the fault handler BEFORE any user code can fault
//   call main          main returns its ExitCode in R8 (custom ABI)
//   mov ecx, r8d       hand R8's low 32 bits to ExitProcess's ECX arg (Win64 ABI)
//   call [ExitProcess] terminate the process with that code
//   add rsp, 0x20      release the frame — dead, but the mirror must be total
//   pop rbp            restore the caller's frame pointer
//   ret                dead (ExitProcess never returns); kept for well-formedness
//
// This stub is built AFTER `insertPrologueEpilogue`, so it does not inherit that pass's
// frame and must lay its own. It builds the SAME frame that pass builds — `push rbp` /
// `mov rbp, rsp` through the shared `framePointerSetupOp`, so the chain's defining
// instruction is spelled in one place — because `mrt_start` is the frame the chain ENDS
// at: `main`'s saved rbp points here, and a walk that arrives with no frame to read stops
// one frame short of the `in mrt_start` every backtrace in the corpus expects. Its own
// saved rbp is whatever the loader left, and the walk's `.text` bound is what discards it.
function prependEntryStub(module TargetModule, checkLeaks bool)
	var func = IrFunction.createFromStd(EntryPointName, returnType: StdReturnType.void, paramCount: 0, paramTypes: StdTypeArray.create(), returnLine: 0)
	var block = module.addBlock(func, label: b"entry")

	module.appendOp(block, op: TargetOp.pushReg(X64Register.rbp))
	module.appendOp(block, op: framePointerSetupOp())
	module.appendOp(block, op: TargetOp.prologue(EntryStubFrameBytes))
	module.appendOp(block, op: TargetOp.callDirect(RuntimeInitName))
	module.appendOp(block, op: TargetOp.callDirect(UserEntryName))

	// ⭐ THE LEAK GATE (P1.0r) — the one seam on the exit path, and the reason `__mm_decref` has a
	// reason to be right at all. `main` has returned its ExitCode in R8; `__mm_leak_check` takes
	// that code and gives back either the same code (nothing outstanding) or 101 (something was
	// allocated and never freed). Every program that touches the heap therefore checks itself, and
	// a missing decref is a FAILING TEST rather than an invisible one.
	//
	// It sits between `call main` and the ExitProcess bridge because that is the only point where
	// the program is finished AND has not yet exited. It is skipped entirely for a program with no
	// allocator, which cannot leak — there is nothing to count.
	//
	// The argument goes in RCX and the result comes back in R8: `__mm_leak_check` is an ordinary
	// Maxon-ABI function (arg 0 = rcx, primary return = r8), not a Win64 import.
	appendLeakGate(module, block: block, checkLeaks: checkLeaks)

	module.appendOp(block, op: TargetOp.movReg32Reg32(x64PhysReg(X64Register.rcx), srcReg: x64PhysReg(X64Register.r8)))
	module.appendOp(block, op: TargetOp.iatCall(iatSlotIndex(IatSlot.ExitProcess)))
	module.appendOp(block, op: TargetOp.epilogue(EntryStubFrameBytes))
	module.appendOp(block, op: TargetOp.popReg(X64Register.rbp))
	module.setTerminator(block, op: TargetOp.ret)

	prependFunction(module, func: func)
end 'prependEntryStub'

// ⭐ THE LEAK GATE (P1.0r) — the one seam on the exit path, shared by both entry stubs. `main` has
// returned its ExitCode in R8; `__mm_leak_check` takes that code (arg 0 in RCX, custom Maxon ABI) and
// gives back either the same code (nothing outstanding) or 101 (something was allocated and never
// freed), in R8. The value flow r8 -> rcx -> (adjusted) r8 is identical on Windows and Linux — only the
// surrounding process-exit primitive differs — so the gate is written once here. It is skipped entirely
// for a program with no allocator (`checkLeaks` false), which cannot leak; every program that touches
// the heap therefore checks itself, and a missing decref is a FAILING TEST rather than an invisible one.
function appendLeakGate(module TargetModule, block IrBlock, checkLeaks bool)
	if checkLeaks 'leakGate'
		module.appendOp(block, op: TargetOp.movRegReg(x64PhysReg(X64Register.rcx), srcReg: x64PhysReg(X64Register.r8)))
		module.appendOp(block, op: TargetOp.callDirect(MmLeakCheckName))
	end 'leakGate'
end 'appendLeakGate'

// Build the x64-LINUX entry stub `mrt_start` as a module function and lay it out FIRST — its `.text`
// offset is the ELF entry point (`writeElf`'s `entryPoint = textVAddr + mainCallFixupOffset`, and concat
// asserts the stub leads `.text`). The Linux twin of `prependEntryStub`, and CARRYING NO FRAME, for
// reasons that all point the same way:
//
//   call main            main returns its ExitCode in R8 (custom ABI)
//   [leak gate]          mov rcx, r8 ; call __mm_leak_check  ->  adjusted code / 101 in R8
//   mov edi, r8d         hand R8's low 32 bits to exit_group's rdi (Linux syscall arg 0)
//   x64Syscall(exit_group)   mov eax, 231 ; syscall  — terminates the process
//   ret                  dead (exit_group never returns); kept as the block's terminator for
//                        well-formedness, exactly as the Windows stub's trailing `ret` is.
//
// ⚠ NO `push rbp`, AND THAT IS DELIBERATE — IT IS THE ALIGNMENT. The Linux kernel enters `_start` with
// rsp ≡ 0 (mod 16) (argc at `[rsp]`, NO return address), where the Windows loader enters ≡ 8 (as if via
// `call`). So `call main` from the kernel's alignment lands `main` at rsp ≡ 8 (mod 16) — exactly what a
// shv2 function expects — with no push to invert the parity. The Windows stub's `push rbp` (which opens
// the backtrace chain) would flip it the WRONG way here and misalign `main`. And the stub needs no
// frame: there is no panic-runtime backtrace to chain this rung, no Win64 shadow space to reserve (raw
// syscalls carry no imports, and shv2 functions spill to their OWN frames), and exit_group never
// returns. The kernel also zeroes rbp at entry (SysV ABI), so any callee's saved-rbp chain terminates
// cleanly without this stub setting one up.
function prependLinuxEntryStub(module TargetModule, checkLeaks bool)
	var func = IrFunction.createFromStd(EntryPointName, returnType: StdReturnType.void, paramCount: 0, paramTypes: StdTypeArray.create(), returnLine: 0)
	var block = module.addBlock(func, label: b"entry")

	module.appendOp(block, op: TargetOp.callDirect(UserEntryName))
	appendLeakGate(module, block: block, checkLeaks: checkLeaks)

	// ExitCode (R8, custom ABI) -> EDI (Linux syscall arg 0). A 32-bit move, exactly as the Windows stub
	// hands R8 to ECX for ExitProcess: an exit status is the low 8 bits, and the zero-extending `mov r32`
	// clears the high half.
	module.appendOp(block, op: TargetOp.movReg32Reg32(x64PhysReg(X64Register.rdi), srcReg: x64PhysReg(X64Register.r8)))
	module.appendOp(block, op: TargetOp.x64Syscall(LinuxSyscallExitGroup))
	module.setTerminator(block, op: TargetOp.ret)

	prependFunction(module, func: func)
end 'prependLinuxEntryStub'

// Move `func` to the front of the module's function list so it lays out first in
// `.text`. Block refs are flat `module.blocks` indices, so reordering the
// function list never invalidates them.
function prependFunction(module TargetModule, func IrFunction)
	var reordered = IrFunctionArray.create()
	reordered.push(func)
	for existing in module.functions 'eachFunc'
		reordered.push(existing)
	end 'eachFunc'
	module.functions = reordered
end 'prependFunction'

// Write the CodeResult to a runnable executable, dispatched on target OS: an x64-windows PE, an
// arm64-macOS Mach-O, an arm64-linux static ELF, or a wasm32-wasi component (`writeWasm`).
export function writeExecutable(codeResult CodeResult, target Target, outputPath FilePath)
	match target.os 'os'
		windows then writePe(outputPath, codeResult: codeResult, target: target)
		macos then writeMachO(outputPath, codeResult: codeResult, target: target)
		linux then writeElf(outputPath, codeResult: codeResult, target: target)
		wasi then writeWasm(outputPath, codeResult: codeResult)
	end 'os'
end 'writeExecutable'

// Write the wasm backend's output: emit the CORE module bytes to `outputPath`, then post-process it
// IN PLACE into a WASI-Preview2 component (`wasm-tools component embed` + `component new` — see
// WasmComponent). The core module already exports `wasi:cli/run` and imports `wasi:cli/exit`; the
// component step lifts/lowers those against the `maxon:app/command` world so wasmtime can run it. A
// failed write is logged and aborts before wrapping — wrapping a file that was never written would
// panic in wasm-tools with a less useful message. No `target` param: the sole wasm target is
// wasm32-wasi, so the emitted format is target-invariant.
function writeWasm(outputPath FilePath, codeResult CodeResult)
	try File.writeBinary(outputPath, content: codeResult.wasmCoreModule) otherwise 'writeErr'
		logError(LogCategory.binary, message: function() gives "Failed to write wasm core module: {outputPath}")
		return
	end 'writeErr'

	wrapWasmComponent(outputPath)
end 'writeWasm'
