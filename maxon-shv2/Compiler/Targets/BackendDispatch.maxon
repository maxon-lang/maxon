// BackendDispatch — the Phase-7 backend driver: it takes a lowered StdModule to
// a runnable executable. `buildBackend` runs the fixed Std→Target→CodeResult
// sequence; `augmentWithRuntime` supplies the OS entry point; `writeExecutable`
// dispatches the CodeResult to the per-OS object writer.
//
// Std, not MIR: shv2 has no MIR tier (see StdDialect's header). The backend's
// input is the Std module the pipeline produced, and `lowerStdToX64` asserts on
// entry that no Std-only `sugar` op survived to reach it.
//
// These stages are driven as ordered function calls rather than PassKind entries
// (the pipeline in PassPipeline stops at StdModule): the backend produces a
// CodeResult, which is not an IR module, so it does not fit the module-field
// dispatch model. This mirrors v1, where Phase 7 is backend-direct.
//
// THIN for maxon-shv2 M1 (x64-windows only). `augmentWithRuntime` installs the
// `mrt_start` entry stub; the PANIC RUNTIME it calls into (the `#DE` fault handler
// and its symbolized backtrace) is appended as hand-assembled chunks during the
// encode phase — see `buildBackend` and X64Runtime's header for why it cannot be
// TargetOps. A `return 42` program still allocates nothing and spawns nothing, so it
// carries none of the REST of v1's unconditional x64-windows runtime floor (no
// slab/MM init, no green-thread scheduler, no IOCP). Both halves are designed to
// GROW: M6 prepends slab/MM init, Phase F the green-thread scheduler.
// Linux/macOS/wasi entry stubs + `writeElf`/`writeMachO` dispatch arrive at their
// milestones.

// The user program's entry function — `mrt_start` calls it, then bridges its
// R8 return value to ExitProcess.
export let UserEntryName = "main"

// `mrt_start`'s frame: 32 bytes of Win64 shadow space for the calls it makes, and
// NOTHING else. The OS enters the stub with rsp ≡ 8 (mod 16), as if via `call`; the
// stub's own `push rbp` moves it to ≡ 0, so an exact-multiple-of-16 reservation keeps
// it aligned at each `call` and no odd 8 is needed.
//
// ⚠ This USED to be 0x28 (32 + 8) — the 8 was the alignment correction for a stub that
// pushed nothing. The frame pointer's push now supplies that parity, so the same
// arithmetic `computeFrameBytes` does for every other function (entry ≡ 8, one push ⇒ an
// even reservation) gives 0x20 here. Keeping 0x28 would leave rsp ≡ 8 AT the call — a
// misalignment nothing on this path reads today, and that would start corrupting the
// moment anything below it spills an XMM register (P1.0d.4 floats).
let EntryStubFrameBytes = 0x20

// Run the full backend: Std → Target → register allocation → prologue/epilogue →
// runtime augmentation → machine-code emission → CodeResult.
//
// `throws CompileError` because register allocation can now FAIL for a real reason the
// user must fix: a loop that needs more registers than exist (E5001, reported onto
// `project.diagnostics`). `project` also carries the `opRanges`/`valueOrigins` tables the
// allocator maps a Target ValueId back to its source span through. Every other backend
// stage is infallible — a failure there is a compiler bug and still panics.
// Each stage below is bracketed by one `PhaseProbe`, which measures its wall time AND its
// allocations at the same two instants (see PhaseProbe's header for why that is one type
// and not two). The stages are strictly sequential and none calls another, so the phases
// are disjoint by construction and nothing has to be subtracted back out (unlike the
// allocator's internals, which nest — see CompileTimings' header). `regalloc`'s own seven
// sub-phases are recorded into `project.timings.regAlloc` / `project.memory.regAlloc` and
// nest UNDER this phase in both reports; they are a breakdown of what is measured here,
// never additional phases.
export function buildBackend(stdModule StdModule, target Target, globalData GlobalDataTable, project Project) returns CodeResult throws CompileError
	// The sugar gate lives HERE, not in the per-target lowering: it is a property of
	// the Std tier, not of x64, so installing it at the one target-neutral entry
	// means arm64/wasm inherit it instead of each having to re-add it. See
	// StdDialect's sugar-band contract.
	let sugarProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.sugarGate)
	assertNoSugarOps(stdModule)
	recordPhase(project, phase: CompilePhase.sugarGate, probe: sugarProbe)

	let iselProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.isel)
	// `globalData` reaches ISel because a float CONSTANT is `.rdata` content the lowering is the
	// first to see (`lowerFloatConst`). It is the same table concat resolves those labels against
	// once sections are laid out — see `lowerStdToX64`.
	var targetModule = lowerStdToX64(stdModule, globalData: globalData)
	recordPhase(project, phase: CompilePhase.isel, probe: iselProbe)

	let regAllocProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.regalloc)
	try allocateRegisters(targetModule, target: target, project: project)
	recordPhase(project, phase: CompilePhase.regalloc, probe: regAllocProbe)

	let prologueProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.prologueEpilogue)
	insertPrologueEpilogue(targetModule, target: target)
	recordPhase(project, phase: CompilePhase.prologueEpilogue, probe: prologueProbe)

	let runtimeProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.runtimeAugment)
	augmentWithRuntime(targetModule, target: target)
	recordPhase(project, phase: CompilePhase.runtimeAugment, probe: runtimeProbe)

	let encodeProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.encode)
	var chunks = FunctionCodeChunkArray.create()
	for func in targetModule.functions 'eachFunc'
		chunks.push(emitFunctionChunk(targetModule, func: func))
	end 'eachFunc'
	// The panic runtime is hand-assembled bytes, not TargetOps, so it joins here rather than
	// in `augmentWithRuntime` — there is no Std or Target spelling of "read CONTEXT.Rip" or
	// "walk a saved-RBP chain" at this milestone (see X64Runtime's header). It appends AFTER
	// user code, which keeps `mrt_start` at `.text` offset 0 where the backtrace needs it.
	appendX64RuntimeChunks(chunks)
	recordPhase(project, phase: CompilePhase.encode, probe: encodeProbe)

	let linkProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.link)
	let codeResult = concatX64FunctionChunks(targetModule, stdModule: stdModule, chunks: chunks, globalData: globalData)
	recordPhase(project, phase: CompilePhase.link, probe: linkProbe)

	return codeResult
end 'buildBackend'

// Install the OS entry point. M1 = "prepend the `mrt_start` entry stub + register
// the ExitProcess import." Runs AFTER register allocation and prologue/epilogue so
// the hand-built stub (all-physical registers, its own explicit frame) is never
// reprocessed by those passes.
export function augmentWithRuntime(module TargetModule, target Target)
	if target.os != Os.windows 'unsupportedOs'
		panic("augmentWithRuntime: maxon-shv2 M1 emits an entry stub for x64-windows only (got {targetToString(target)})")
	end 'unsupportedOs'
	prependEntryStub(module)
end 'augmentWithRuntime'

// Build `mrt_start` and lay it out FIRST so its `.text` offset is the PE entry
// point. The stub bridges Maxon's custom ABI (primary return in R8) to Win64's
// ExitProcess (UINT arg in ECX):
//   push rbp           open the saved-RBP chain (see below)
//   mov rbp, rsp       … so a backtrace can name mrt_start and then stop
//   sub rsp, 0x20      reserve shadow space (rsp is already 16-aligned by the push)
//   call mrt_runtime_init   install the fault handler BEFORE any user code can fault
//   call main          main returns its ExitCode in R8 (custom ABI)
//   mov ecx, r8d       hand R8's low 32 bits to ExitProcess's ECX arg (Win64 ABI)
//   call [ExitProcess] terminate the process with that code
//   add rsp, 0x20      release the frame — dead, but the mirror must be total
//   pop rbp            restore the caller's frame pointer
//   ret                dead (ExitProcess never returns); kept for well-formedness
//
// This stub is built AFTER `insertPrologueEpilogue`, so it does not inherit that pass's
// frame and must lay its own. It builds the SAME frame that pass builds — `push rbp` /
// `mov rbp, rsp` through the shared `framePointerSetupOp`, so the chain's defining
// instruction is spelled in one place — because `mrt_start` is the frame the chain ENDS
// at: `main`'s saved rbp points here, and a walk that arrives with no frame to read stops
// one frame short of the `in mrt_start` every backtrace in the corpus expects. Its own
// saved rbp is whatever the loader left, and the walk's `.text` bound is what discards it.
function prependEntryStub(module TargetModule)
	var func = IrFunction.createFromStd(EntryPointName, returnType: StdReturnType.void, paramCount: 0, paramTypes: StdTypeArray.create(), returnLine: 0)
	var block = module.addBlock(func, label: b"entry")

	module.appendOp(block, op: TargetOp.pushReg(X64Register.rbp))
	module.appendOp(block, op: framePointerSetupOp())
	module.appendOp(block, op: TargetOp.prologue(EntryStubFrameBytes))
	module.appendOp(block, op: TargetOp.callDirect(RuntimeInitName))
	module.appendOp(block, op: TargetOp.callDirect(UserEntryName))
	module.appendOp(block, op: TargetOp.movReg32Reg32(X64VReg.physical(X64Register.rcx), srcReg: X64VReg.physical(X64Register.r8)))
	module.appendOp(block, op: TargetOp.iatCall(iatSlotIndex(IatSlot.ExitProcess)))
	module.appendOp(block, op: TargetOp.epilogue(EntryStubFrameBytes))
	module.appendOp(block, op: TargetOp.popReg(X64Register.rbp))
	module.setTerminator(block, op: TargetOp.ret)

	prependFunction(module, func: func)
end 'prependEntryStub'

// Move `func` to the front of the module's function list so it lays out first in
// `.text`. Block refs are flat `module.blocks` indices, so reordering the
// function list never invalidates them.
function prependFunction(module TargetModule, func IrFunction)
	var reordered = IrFunctionArray.create()
	reordered.push(func)
	for existing in module.functions 'eachFunc'
		reordered.push(existing)
	end 'eachFunc'
	module.functions = reordered
end 'prependFunction'

// Write the CodeResult to a runnable executable, dispatched on target OS. M1
// writes an x64-windows PE; the ELF / Mach-O / WASM writers arrive at their
// milestones.
export function writeExecutable(codeResult CodeResult, target Target, outputPath FilePath)
	match target.os 'os'
		windows then writePe(outputPath, codeResult: codeResult, target: target)
		default panic("writeExecutable: maxon-shv2 M1 writes x64-windows PE only (got {targetToString(target)})")
	end 'os'
end 'writeExecutable'
