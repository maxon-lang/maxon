// Arm64PrologueEpilogue — inserts the arm64 frame setup/teardown after register allocation, the
// arm64 twin of `X64PrologueEpilogue.insertPrologueEpilogue`.
//
// ⭐ WAVE-1 STUB (arm64-macOS foundation rung). Wave 1 emits, per function: `stp x29, x30, [sp,
// #-16]!` + `mov x29, sp` to open the saved-FP chain (the same chain the x64 side keeps, needed by
// the panic backtrace and growable green-thread stacks), the callee-saved `stp`/`ldp` pairs the
// coloring actually used (x19..x28, d8..d15), and the frame reservation via `sub sp` — with the
// `arm64EmitStackAlloc` split for frames past the STP pre-index reach (M1 encoding notes). It emits
// the neutral `arm64Prologue`/`arm64Epilogue` ops the encoder expands.
export function insertArm64PrologueEpilogue(module TargetModule, target Target)
	panic("arm64 insertArm64PrologueEpilogue: not yet implemented (wave 1) [{module.funcCount()} fn, {targetToString(target)}]")
end 'insertArm64PrologueEpilogue'
