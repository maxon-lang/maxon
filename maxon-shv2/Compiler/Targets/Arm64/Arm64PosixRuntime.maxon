// Arm64PosixRuntime — what the TWO arm64 POSIX host surfaces SHARE: the symbol names the isel branches to,
// the POSIX facts both lanes read, and the chunks whose body is the same on both once the one thing that
// genuinely differs — the layout of `struct stat` — is a parameter.
//
// ⭐⭐ **IT EXISTS BECAUSE THERE ARE NOW TWO OF THEM.** `Arm64DarwinRuntime` was written when arm64-macOS was
// the only arm64 lane with a filesystem, and its header says outright that a Linux lane "writes its own
// chunks against its own syscall numbers — it does not inherit these". That is TRUE OF THE CALLS and FALSE
// OF EVERYTHING ELSE: `FindFirstFileA`'s glob split, the `dwFileAttributes` mask a `st_mode` becomes, the
// FILETIME a whole second becomes and the 320-byte record all three fill are Win32-shaped facts that neither
// OS has any say in. Copying them into a second file is this project's signature bug — ONE FACT WRITTEN DOWN
// TWICE — in the one place where a drift shows up as a wrong SIZE or a wrong TIMESTAMP rather than as a
// compile error.
//
// ⭐ **THE SYMBOLS ARE `mrt_host_*`, NOT `mrt_darwin_*`/`mrt_linux_*`, AND THAT IS WHY THE ISEL HAS NO NAME
// TABLE.** Exactly ONE lane's chunks are appended to any image (`buildArm64Backend` picks by
// `target.os`), so a shared name cannot collide — it can only ever have one body — and it is what lets
// `lowerHostChunkValue(chunk: HostReadFileName)` stay a single unconditional lowering. The alternative,
// per-lane names, needs a second table mapping `(os, verb)` to a symbol, which is a table that can disagree
// with the builders. `mrt_start` and `mrt_panic` already work this way: one name, a per-OS body.
//
// ⚠ **A LANE-PRIVATE HELPER KEEPS ITS LANE'S INFIX.** `mrt_darwin_dup_cstring` is a `malloc`, and
// `mrt_linux_glob_match` exists only because a raw static image has no `fnmatch` — neither has a counterpart
// on the other lane, so neither may wear the shared prefix.

// ==========================================================================
// The shared chunk symbols
// ==========================================================================

// The ones the isel branches to (`StdToArm64Conversion`), plus the four the two find-first walks are built
// out of. Each is built by whichever lane's `append…RuntimeChunks` ran.
//
// ⚠ **`mrt_host_file_open` AND `mrt_host_cpu_count` ARE THE TWO ONLY THE LINUX LANE BUILDS**, and the isel
// is what keeps that honest: it `bl`s each on the SYSCALL route alone, because the macOS route has no chunk
// to call — an `open` there is one inline import (`lowerOsFileOpen` carries the vararg argument for why) and
// a processor count is one `sysconf`. They still wear the SHARED prefix rather than a `_linux_` infix
// because the test is whether the VERB is a shared host-surface verb, not whether both lanes happen to spell
// it as a chunk today; `mrt_linux_glob_match` is lane-private because `fnmatch` has no counterpart at all.
export let HostLastErrorName = b"mrt_host_last_error"
export let HostReadFileName = b"mrt_host_read_file"
export let HostWriteFileName = b"mrt_host_write_file"
export let HostFileOpenName = b"mrt_host_file_open"
export let HostFileSizeName = b"mrt_host_file_size"
export let HostFileDeleteName = b"mrt_host_file_delete"
export let HostFileRenameName = b"mrt_host_file_rename"
export let HostDirCreateName = b"mrt_host_dir_create"
export let HostFileAttributesName = b"mrt_host_file_attributes"
export let HostDirCurrentPathName = b"mrt_host_dir_current_path"
export let HostDirFindFirstName = b"mrt_host_dir_find_first"
export let HostDirFindNextName = b"mrt_host_dir_find_next"
export let HostDirFindCloseName = b"mrt_host_dir_find_close"

// --- L3: the two non-scheduler CLOCKS, the executable path and the processor count ---
//
// ⭐⭐ **THESE FOUR WORE A `mrt_darwin_` INFIX UNTIL arm64-LINUX GREW BODIES FOR THEM (L3), AND THE RENAME IS
// WHAT KEPT THE ISEL FREE OF A NAME TABLE.** Their verbs — read the calendar, read this thread's CPU, name
// the running image, count the processors — are host-surface verbs in exactly the sense this file's header
// defines, so per-lane names would have needed a second table mapping `(os, verb)` to a symbol, which is a
// table that can disagree with the builders.
//
// ⚠ **THIS BLOCK USED TO EXCLUDE `mrt_darwin_monotonic_clock` AND `mrt_darwin_sleep_ms` BY NAME**, on the
// argument that both are reached only through SCHEDULER entries which arm64-linux refused, so each had
// exactly one body. L4 built the second body, and the exclusion went with it — the test this file states is
// whether the VERB is a shared host-surface verb, and both were always that.
export let HostWallClockName = b"mrt_host_wall_clock"
export let HostThreadCpuName = b"mrt_host_thread_cpu"
export let HostExePathName = b"mrt_host_exe_path"
export let HostCpuCountName = b"mrt_host_cpu_count"

// --- L4: the GREEN-THREAD FLOOR's host objects, and the two clocks the scheduler reaches ---
//
// ⭐⭐ **TEN VERBS, TWO BODIES EACH.** macOS answers every one of them with a libSystem sequence (a pthread
// key, a mutex, a condvar, a thread, `getenv`, `nanosleep`, `clock_gettime_nsec_np`); Linux answers each with
// a raw `svc #0` against `futex`, `mmap` and `clock_gettime`, plus the writable thread pointer nothing else on
// that lane touches. The verbs are identical and the primitives share nothing, which is exactly the split
// this file's `mrt_host_` prefix exists for.
//
// ⚠ **`osLockEnter`/`osLockLeave` ARE NOT HERE, AND THAT IS THE LANE-PRIVATE RULE APPLIED HONESTLY.** On
// macOS the region the Std tier allocated IS a `pthread_mutex_t`, so those two ops lower to a bare import
// call with no chunk at all; only Linux needs a body, and a body only one lane builds is
// `mrt_linux_lock_enter` (see `Arm64LinuxRuntime`). The same is true of `tlsSetValue`, which is one
// `pthread_setspecific` there and a guarded store through `TPIDR_EL0` here.
export let HostMonotonicClockName = b"mrt_host_monotonic_clock"
export let HostSleepMsName = b"mrt_host_sleep_ms"
export let HostWaitNewName = b"mrt_host_wait_new"
export let HostEventSetName = b"mrt_host_event_set"
export let HostThreadCreateName = b"mrt_host_thread_create"
export let HostWaitOneName = b"mrt_host_wait_one"
export let HostWaitCloseName = b"mrt_host_wait_close"
export let HostLockInitName = b"mrt_host_lock_init"
export let HostEnvReadName = b"mrt_host_env_read"
export let HostTlsAllocName = b"mrt_host_tls_alloc"

// ⭐ **THE WAIT OBJECT'S KIND, AS THE ISEL SPELLS IT.** `osEventCreate` lowers to `mrt_host_wait_new(kind)`
// on BOTH lanes and must name the same number on each, so the value is a shared protocol rather than either
// lane's private constant. The other kinds are not here because no isel lowering names one: a thread object
// is minted inside `mrt_host_thread_create` and a child process inside `mrt_host_spawn`, each of which knows
// its own kind (`Arm64DarwinRuntime`'s layout header enumerates all three).
export let PosixWaitKindEvent = 1

// ==========================================================================
// The HANDLE TAG — POSIX's answer to `HANDLE`, and both lanes give it
// ==========================================================================

// ⭐⭐⭐ **`StdOp.osCloseHandle` CLOSES FOUR DIFFERENT THINGS AND POSIX HAS NO TYPE IN COMMON FOR THEM.** On
// Windows a wake event, a worker thread, a pipe end, an opened file and a child process are all one opaque
// `HANDLE`, and one `CloseHandle` serves every one of them. On either POSIX lane the first two and the last
// are heap objects the backend mints, the middle two are DESCRIPTORS, and "close" means `free`/`munmap` for
// one and `close` for the other. A value that is only a number cannot say which — and the numbers OVERLAP,
// because a small descriptor and an allocated pointer are both just integers.
//
// ⇒ **A handle on either lane carries its kind in bits 48 and up**, which a user virtual address never
// occupies on arm64-macOS (47-bit) or on arm64-Linux (48-bit, so bit 47 is the highest one used).
// `mrt_host_wait_close` reads those bits and dispatches; everything that consumes a DESCRIPTOR masks them
// off, which costs two instructions and is a no-op for the untagged descriptors `osFileOpenRead` and
// `osStdHandle` already answer.
//
// ⚠ **KIND 0 IS THE DESCRIPTOR KIND ON PURPOSE**, so a raw fd from any other family is already a valid
// handle and needs no tagging at its source — and so that the Std tier's `0 means no handle` sentinel
// (which `emitSubpCloseSlotHandles` relies on, and which is `CloseHandle(NULL)`'s Win32 no-op) keeps
// meaning exactly that.
let PosixHandleKindShift = 48 as ShiftCount
let PosixHandleKindDescriptor = 0
export let PosixHandleKindObject = 1

// `dest = handle >> 48` — the kind field, for the two ops that dispatch on it.
export function arm64PosixHandleKind(asm Arm64RuntimeAsm, dest Arm64Register, handle Arm64Register)
	arm64EmitLsrImm(asm.code, rd: arm64RuntimeReg(dest), rn: arm64RuntimeReg(handle), sh: PosixHandleKindShift)
end 'arm64PosixHandleKind'

// `reg = reg & ((1 << 48) - 1)` — the payload, as a shift pair rather than an AND with a materialised mask,
// because that needs no scratch register and every caller is already holding its arguments in place.
//
// ⚠ **IT SHIFTS BY THE KIND FIELD's WIDTH, NOT BY ITS POSITION**, and getting that backwards is not a
// compile error: `lsl #48` keeps the low SIXTEEN bits of a pointer, so every handle became a small integer
// and the first field store through one segfaulted. Derived from the two rather than written down, so the
// pair cannot come apart.
export function arm64PosixUntagHandle(asm Arm64RuntimeAsm, reg Arm64Register)
	arm64EmitLslImm(asm.code, rd: arm64RuntimeReg(reg), rn: arm64RuntimeReg(reg), sh: PosixHandleKindBits)
	arm64EmitLsrImm(asm.code, rd: arm64RuntimeReg(reg), rn: arm64RuntimeReg(reg), sh: PosixHandleKindBits)
end 'arm64PosixUntagHandle'

// How WIDE the kind field is — the bits above the 48-bit payload, which on either arm64 POSIX lane is every
// bit a user virtual address cannot reach.
let PosixHandleKindBits = (MachineWordBits - PosixHandleKindShift) as ShiftCount

// `reg = reg | (kindObject << 48)` — what `mrt_host_wait_new` hands back, so every object handle in the
// program carries its kind from the moment it exists.
export function arm64PosixTagObject(asm Arm64RuntimeAsm, reg Arm64Register, scratch Arm64Register)
	arm64EmitMovRuntimeImm(asm, dest: scratch, value: PosixHandleKindObject * PosixHandleKindUnit)
	arm64EmitRuntimeRrr(asm, opcode: Arm64OpOrr, dest: reg, lhs: reg, rhs: scratch)
end 'arm64PosixTagObject'

// `1 << PosixHandleKindShift` as a value rather than a shift, so a kind can be turned into a tag by a
// multiply the `movz #imm, lsl #48` ladder encodes in one instruction.
let PosixHandleKindUnit = 0x0001000000000000

// ==========================================================================
// `GetEnvironmentVariableA`'s ANSWER, once, for both lanes
// ==========================================================================

// ⭐⭐ **THE HALF OF `osEnvRead` THAT IS NOT THE LOOKUP.** The two lanes find a variable's value in ways with
// nothing in common — macOS calls `getenv`, Linux walks the `envp` vector its entry stub captured, because a
// static image links no libc to have one — but once each holds a `char*` the REST is one contract, and it is
// Windows's: answer the byte count NOT counting the NUL, copy only if the value fits, and report the REQUIRED
// size when it does not so the caller's retry can read it.
//
// ⚠ **THE COUNT IS THE ANSWER ON BOTH EXITS AND THAT IS NOT AN ACCIDENT.** On a fit it is what was written;
// on a too-small buffer it is what WOULD have been written, which is `GetEnvironmentVariableA`'s convention
// and what `SchedRuntime.emitResolveMaxProcs` — the one caller — decodes. An unset variable never reaches
// here: its answer is the 0 the caller seeded `writtenSlot` with.
//
// ⚠ It clobbers x1..x5 and ENDS by branching to `finish`; the caller places that label and loads its own
// answer out of `writtenSlot`.
export function arm64PosixEmitEnvValueCopy(asm Arm64RuntimeAsm, valueSlot StackSize, bufPtrSlot StackSize, bufLenSlot StackSize, writtenSlot StackSize, finish BlockId)
	let copyLoop = asm.newLabel()

	// len = strlen(value) — a C string carries no length and neither lookup answers one.
	arm64EmitLoadSlot(asm, reg: Arm64Register.x0, slot: valueSlot)
	arm64EmitCStringLength(asm, src: Arm64Register.x0, dest: Arm64Register.x2, cursor: Arm64Register.x1, scratch: Arm64Register.x2)
	arm64EmitStoreSlot(asm, reg: Arm64Register.x2, slot: writtenSlot)
	// STRICTLY less than the capacity, because the NUL needs the last byte — the same test
	// `emitFilledBufferVerdict` calls a fit.
	arm64EmitLoadSlot(asm, reg: Arm64Register.x3, slot: bufLenSlot)
	arm64EmitCmpRuntimeReg(asm, lhs: Arm64Register.x2, rhs: Arm64Register.x3)
	arm64EmitCondBranchTo(asm, cond: Arm64CondCode.hs, label: finish)

	arm64EmitLoadSlot(asm, reg: Arm64Register.x1, slot: valueSlot)
	arm64EmitLoadSlot(asm, reg: Arm64Register.x4, slot: bufPtrSlot)

	asm.placeLabel(copyLoop)
	arm64EmitLoadByte(asm, dest: Arm64Register.x5, base: Arm64Register.x1)
	arm64EmitStoreByte(asm, src: Arm64Register.x5, base: Arm64Register.x4)
	arm64EmitCbzTo(asm, reg: Arm64Register.x5, label: finish)
	arm64EmitAddRuntimeImm(asm, dest: Arm64Register.x1, base: Arm64Register.x1, imm: 1)
	arm64EmitAddRuntimeImm(asm, dest: Arm64Register.x4, base: Arm64Register.x4, imm: 1)
	arm64EmitBranchTo(asm, label: copyLoop)
end 'arm64PosixEmitEnvValueCopy'

// The byte count an unset variable answers — `GetEnvironmentVariableA`'s own 0, and the value both lanes seed
// `writtenSlot` with before their lookup so the not-found arm needs no branch of its own.
export let PosixEnvUnset = 0

// ==========================================================================
// A relative timeout, in the shape every POSIX call that takes one wants
// ==========================================================================

// ⭐ **MILLISECONDS INTO A `struct timespec` IN TWO ADJACENT FRAME SLOTS.** `secs = ms / 1000` and
// `nanos = (ms - secs*1000) * 1e6` — `msub` takes the remainder from the quotient with no second divide,
// the same fold `StdToArm64Conversion.lowerDivMod` makes. The two slots must be CONSECUTIVE, because a
// `timespec` is `{tv_sec, tv_nsec}` and `&slot(sec)` is what the callee reads it through — two 64-bit words
// on BOTH lanes, which is why this is shared rather than per-lane.
//
// Its callers are every chunk that hands the host a relative time: the OS-thread park (`nanosleep` on macOS,
// the `clock_nanosleep` syscall on Linux), the timed event wait (`pthread_cond_timedwait_relative_np` there,
// `FUTEX_WAIT` here). One conversion, because two of them lowering the same millisecond count differently is
// a wait that runs for a thousandth of its timeout.
//
// ⚠ It CLOBBERS x1..x4. Every caller places its own arguments after it, never before.
export function arm64PosixMillisToTimespec(asm Arm64RuntimeAsm, ms Arm64Register, secSlot StackSize, nsecSlot StackSize)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x1, value: PosixMillisPerSecond)
	arm64EmitRuntimeRrr(asm, opcode: Arm64OpUdiv, dest: Arm64Register.x2, lhs: ms, rhs: Arm64Register.x1)
	arm64EmitMsub(asm.code, rd: arm64RuntimeReg(Arm64Register.x3), rn: arm64RuntimeReg(Arm64Register.x2), rm: arm64RuntimeReg(Arm64Register.x1), ra: arm64RuntimeReg(ms))
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x4, value: PosixNanosPerMilli)
	arm64EmitRuntimeRrr(asm, opcode: Arm64OpMul, dest: Arm64Register.x3, lhs: Arm64Register.x3, rhs: Arm64Register.x4)

	arm64EmitStoreSlot(asm, reg: Arm64Register.x2, slot: secSlot)
	arm64EmitStoreSlot(asm, reg: Arm64Register.x3, slot: nsecSlot)
end 'arm64PosixMillisToTimespec'

let PosixMillisPerSecond = 1000

// The other direction of the same fact, and the unit `arm64PosixMillisToTimespec` turns a millisecond
// remainder into. ⚠ `mrt_host_tick_ms` does NOT use it: that chunk derives its divisor from the FREQUENCY
// `mrt_host_monotonic_clock` reports, so a lane that ever answered raw counter ticks would still be right.
let PosixNanosPerMilli = 1000000

// The shared walkers behind them. They are runtime FUNCTIONS rather than emit fragments because each has more
// than one caller and each is a LOOP: inlining a loop at three sites is three copies of a termination
// condition.
export let HostBaseNameName = b"mrt_host_base_name"
export let HostHasWildcardName = b"mrt_host_has_wildcard"
export let HostAttrsFromModeName = b"mrt_host_attrs_from_mode"
export let HostFillFindDataName = b"mrt_host_fill_find_data"

// ==========================================================================
// The POSIX facts both lanes read
// ==========================================================================

// ⭐ **THESE ARE POSIX-COMMON AND WERE MEASURED AS SUCH, NOT ASSUMED.** `S_IFMT`/`S_IFDIR`/`S_IWUSR` are the
// same octal on Darwin and on Linux — unlike the `clockid_t` values one file over, which are NOT and which is
// why that block stays with its lane.
let PosixFileTypeMask = 0o170000
let PosixFileTypeDirectory = 0o40000
let PosixOwnerWriteBit = 0o200

// `st_mode` is a `mode_t`. Darwin's is SIXTEEN bits inside the 32-bit word at its offset (the other half is
// `st_nlink`); Linux's is a full 32-bit `unsigned int`. One mask serves both because every bit either lane
// reads — the type field and the owner's write bit — is inside the low 16, so masking a Linux mode to 16 bits
// discards nothing this surface asks about.
let PosixModeMask = 0xFFFF

// The two bytes that make a pattern a GLOB rather than a name, and the byte a path is split at. `*` and `?`
// are the only two wildcard characters `FindFirstFileA` honours; a pattern with neither is a plain path and
// takes the single-`stat` route.
export let PosixGlobStarByte = 0x2A
export let PosixGlobQuestionByte = 0x3F
let PosixPathSeparatorByte = 0x2F

// `fstatat`'s flag word: 0 means FOLLOW a symbolic link, which is what `FindFirstFileA` reports for one and
// what every other `stat` in this surface does.
export let PosixFollowSymlinks = 0

// `O_RDONLY` — zero on both lanes, and named because a bare 0 in an open's flag position says nothing.
export let PosixOpenReadOnly = 0

// The permission masks a newly created file is given, before the process umask. 0644 is `CreateFileA`'s
// ordinary file; 0755 is what `openWriteExecutable` adds and the whole reason that method has an op of its own.
export let PosixCreateFileMode = 0o644
export let PosixCreateExecutableFileMode = 0o755

// `mkdir(path, 0777)` — `CreateDirectoryA`'s "inherit whatever the environment permits", which under POSIX is
// a full mask handed to the process umask to narrow. The bootstrap's own directory create says 0777 and v1's
// says 0755; 0777 is the one that leaves the DECISION with the umask instead of taking it here.
export let PosixDirectoryMode = 0o777

// ⭐⭐ **THE errno VALUES `mrt_host_last_error` TRANSLATES — AND ALL FIVE AGREE ACROSS THE TWO LANES.**
// MEASURED on Darwin (`<errno.h>`) and read off Linux's `asm-generic/errno-base.h`: `EPERM = 1`,
// `ENOENT = 2`, `EACCES = 13`, `ENOTDIR = 20`, `ERANGE = 34` on both. That agreement is what lets the
// TRANSLATION be shared while the FETCH stays per-lane (`*__error()` on Darwin, a `.data` word on Linux).
//
// ⛔⛔ **ONLY `ENOENT` AGREES WITH ITS Win32 TWIN BY LUCK, AND THE OTHER TWO WOULD MISCLASSIFY.** The Std
// tier tests 2 / 3 / 5 (`ManagedFileRuntime.emitErrnoClassifiedThrow`); 3 is `ESRCH` and 5 is `EIO` under
// POSIX, so handing it a raw errno would report a hardware read error as `accessDenied` and would never
// report a missing directory component at all. The translation therefore happens in the CHUNK, exactly as
// `mrt_darwin_wall_clock` translates nanoseconds into a FILETIME — one lane's vocabulary becoming the op's
// contract, rather than the op's contract becoming per-lane.
export let PosixErrnoNoSuchFileOrDirectory = 2
let PosixErrnoOperationNotPermitted = 1
let PosixErrnoPermissionDenied = 13
let PosixErrnoNotADirectory = 20
export let PosixErrnoResultTooLarge = 34

// ⭐⭐ **A CLEARED errno MEANS "THE WALK RAN OUT", AND THAT IS WHAT MAKES `ERROR_NO_MORE_FILES` REACHABLE
// WITHOUT A PRIVATE SENTINEL.** `FindNextFileA` reports end-of-iteration by FAILING with
// `ERROR_NO_MORE_FILES`; POSIX reports it by an exhausted enumeration that sets no errno at all. So each
// lane's walk clears errno before every step and the classifier reads a zero as exactly that
// end-of-iteration — which is sound because `osLastError` is only ever consumed on a path where a call has
// just FAILED, and the one failure in this whole surface that sets no errno is this one.
export let PosixErrnoCleared = 0

// The catch-all an errno with no Win32 twin becomes — `ERROR_GEN_FAILURE`. It deliberately is not one of the
// three the Std classifier tests, so every unmapped failure takes that classification's per-operation
// fallback (`openFailed`, `readFailed`, …) instead of impersonating one of the three named variants.
let ErrorGenericFailure = 31

// ⭐ **HOW MANY NANOSECONDS A SECOND HAS.** Both POSIX lanes read clocks whose unit is the nanosecond, and
// the Linux thread-CPU chunk needs this outright: `clock_gettime` answers a `timespec` while
// `__thread_cpu_ticks` promises one number, so that chunk scales the seconds half by this. Darwin's twin
// needs no such step — `clock_gettime_nsec_np` already answers nanoseconds.
//
// ⚠ `Arm64DarwinRuntime`'s `DarwinMonotonicTicksPerSecond` is the same digits and a DIFFERENT fact — the
// frequency that chunk REPORTS through an out-param — which is why the two are not one name.
export let PosixNanosPerSecond = 1000000000

// ⭐⭐ **NANOSECONDS PER FILETIME TICK — the one FILETIME fact the Std tier does not already export, and it
// is DERIVED rather than written down.** Both POSIX wall clocks must hand `osReadWallClock`'s consumer a
// Win32 FILETIME, so both divide a nanosecond reading by this; the OTHER two facts of that encoding
// (`FileTimeTicksPerSecond`, `FileTimeTicksFrom1601To1970`) are `ClockRuntime`'s exports and are read from
// there rather than restated.
//
// ⛔ **ALL THREE USED TO BE RESTATED HERE-ISH, WITH AN ASSERT HOLDING THE COPIES TOGETHER**
// (`Arm64DarwinRuntime`'s `DarwinFileTimeTicksPerSecond` / `DarwinNanosPerFileTimeTick` /
// `DarwinFileTimeEpochOffset` and `assertDarwinFileTimeConstants`). A second POSIX lane would have made that
// three copies and two asserts. The copies are gone and the assert with them: an emitter that reads the
// consumer's own constants cannot be a second calendar, and a quotient that is COMPUTED cannot disagree with
// its operands — which is this project's cure ladder taking its top rung instead of its middle one.
//
// ⚠ **IT IS A FUNCTION AND NOT A `let` FOR A LANGUAGE REASON, NOT A STYLE ONE**: a global initializer is a
// constant expression, and `/` there folds as a FLOAT (E3009 on the cast, measured). Inside a body it is the
// integer divide the two constants deserve — `posixStatSlotCount` above derives its own count the same way.
export function posixNanosPerFileTimeTick() returns MachineWord
	return (PosixNanosPerSecond / FileTimeTicksPerSecond) as MachineWord
end 'posixNanosPerFileTimeTick'

// ⭐ **HOW MANY BYTES OF A PATH-SHAPED STRING FIT BESIDE ITS TERMINATOR.** Three things are bounded by it and
// all three are `char[MAX_PATH]` in the Win32 surface being emulated: `WIN32_FIND_DATAA`'s `cFileName`, the
// copy of the pattern a search owns for its lifetime, and the directory prefix a glob is split into. One
// name, because they are one number for one reason.
export let PosixPathStringCapacity = MaxPathBytes - 1

// The mode word an open that CREATES NOTHING must carry. ⛔ It is not merely "unused": Linux REFUSES an
// `openat` whose mode is non-zero without `O_CREAT` (`build_open_flags`, -EINVAL), so this is a required
// argument value rather than a placeholder — which is why it is named rather than left as a bare 0 beside
// the `O_RDONLY` that is also 0 and is a different fact.
export let PosixNoFileMode = 0

// ⭐ **`INVALID_HANDLE_VALUE` as the two's-complement word a `mov` materialises.**
// `ManagedFileRuntime.InvalidHandleValue` is the same -1 expressed for the Std tier, and `MmapAnonFd` is the
// same spelling one file over for the same reason: `MachineWord` is unsigned.
export let PosixInvalidHandle = 0xFFFFFFFFFFFFFFFF

// ==========================================================================
// struct stat — the ONE thing that is not shared
// ==========================================================================

// ⭐⭐ **THE FIVE FIELDS THIS SURFACE READS, AND WHERE EACH LANE PUTS THEM.** Every offset was MEASURED (the
// Darwin set with a probe on this host; the Linux set is `asm-generic/stat.h`'s, which AArch64 uses), and
// they agree on NOTHING — `st_size` is at 96 on one and 48 on the other. So the two chunks that read a
// `struct stat` take this as a parameter instead of being written twice around two sets of literals.
//
// ⚠ **A `timespec` FIELD'S OFFSET IS ITS `tv_sec`**, because `tv_sec` comes first — so the three time
// offsets address SECONDS directly and the nanosecond half is simply never read: a FILETIME's consumer
// (`ManagedFileRuntime.emitFileTimeToUnixSeconds`) divides back down to whole seconds anyway.
//
// ⚠ **`creationTimeOffset` IS THE ONE FIELD THE TWO OSes DISAGREE ABOUT IN MEANING, NOT MERELY IN PLACE.**
// Darwin has a real birth time (`st_birthtime`); Linux's `struct stat` has none at all — only `statx` does —
// so its lane names `st_ctime`, the inode's last status change, which is the closest thing a `stat` can
// answer and is what `File.info().createdTime` reports there.
export type PosixStatLayout
	// `sizeof(struct stat)`, from which the frame slots it occupies are derived.
	export let bytes as ParsedInt
	// `st_mode`, read as a 32-bit word and masked by `PosixModeMask`. Must be 4-aligned.
	export let modeOffset as MachineWord
	// The remaining four are 64-bit reads and must be 8-aligned.
	export let sizeOffset as MachineWord
	export let creationTimeOffset as MachineWord
	export let accessTimeOffset as MachineWord
	export let modifyTimeOffset as MachineWord

	export static function create(bytes ParsedInt, modeOffset MachineWord, sizeOffset MachineWord, creationTimeOffset MachineWord, accessTimeOffset MachineWord, modifyTimeOffset MachineWord) returns PosixStatLayout
		return Self{bytes: bytes, modeOffset: modeOffset, sizeOffset: sizeOffset, creationTimeOffset: creationTimeOffset, accessTimeOffset: accessTimeOffset, modifyTimeOffset: modifyTimeOffset}
	end 'create'
end 'PosixStatLayout'

// How many 8-byte frame slots a `struct stat` occupies. Derived from the measured size rather than written
// out, so a platform that widens the struct moves one number.
//
// ⚠ The quotient needs no cast: `MachineWord` and `StackSize` are the SAME range (`int(0 to u64.max)`), and
// E3010 refuses a cast between two spellings of one range. It carried one until L3 gave every caller a
// `StackSize` context (`arm64EmitZeroSlots`), at which point the cast became visibly redundant.
export function posixStatSlotCount(layout PosixStatLayout) returns StackSize
	return layout.bytes / SpillSlotBytes
end 'posixStatSlotCount'

// ⭐⭐ **ZERO `slotCount` CONSECUTIVE FRAME SLOTS, STARTING AT `firstSlot`.** Three chunks across the two
// lanes need a kernel-facing buffer to start empty, and each had been writing the same six-instruction loop
// out longhand:
//
//   • Both find-next walks zero their `struct stat` before an `fstatat` whose verdict may be DISCARDED (a
//     dangling symbolic link is a real directory entry that Win32 reports), so the PREVIOUS entry's size and
//     timestamps cannot be published for it.
//   • The Linux processor count zeroes its 128-byte `cpu_set_t` so the popcount may sweep the whole extent
//     rather than only the prefix `sched_getaffinity` reports filling.
//
// ⚠ **IT CLOBBERS x1, x2 AND x3**, which is what all three call sites already used — the loop is instruction
// for instruction what two of them held inline, and it is here because the third copy is the one that would
// have drifted.
export function arm64EmitZeroSlots(asm Arm64RuntimeAsm, firstSlot StackSize, slotCount StackSize)
	let step = asm.newLabel()
	let zeroed = asm.newLabel()

	arm64EmitSlotAddr(asm, dest: Arm64Register.x1, slot: firstSlot)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x2, value: slotCount)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x3, value: 0)

	asm.placeLabel(step)
	arm64EmitCbzTo(asm, reg: Arm64Register.x2, label: zeroed)
	arm64EmitStoreWord64At(asm, src: Arm64Register.x3, base: Arm64Register.x1, byteOffset: 0)
	arm64EmitAddRuntimeImm(asm, dest: Arm64Register.x1, base: Arm64Register.x1, imm: SpillSlotBytes as Imm32)
	arm64EmitAddRuntimeImm(asm, dest: Arm64Register.x2, base: Arm64Register.x2, imm: -1)
	arm64EmitBranchTo(asm, label: step)

	asm.placeLabel(zeroed)
end 'arm64EmitZeroSlots'

// ==========================================================================
// Shared emit fragments
// ==========================================================================

// ⭐ **A POSIX `0`/`-1` STATUS IN x0 BECOMING THE Win32 BOOL THE Std TIER TESTS.** Every path operation in
// this family — the delete, the rename, the directory create — reports failure the POSIX way and is consumed
// the Win32 way (`Win32False` is the failure), so the conversion is written once here rather than at each of
// them.
//
// ⚠ **IT TESTS THE WHOLE 64-BIT REGISTER AGAINST ZERO, WHICH IS WHY THE NARROWING IS THE CALLER'S.** A
// Darwin libSystem call answers a C `int` whose upper half AAPCS64 leaves unspecified, so that lane narrows
// first; a Linux `svc` answers a full 64-bit `-errno` and narrowing it would be a second opinion about a
// value the kernel already settled.
export function arm64EmitWin32BoolFromZeroStatus(asm Arm64RuntimeAsm)
	arm64EmitCmpRuntimeImm(asm, reg: Arm64Register.x0, imm: PosixCallSucceeded as Imm32)
	arm64EmitCset(asm.code, rd: arm64RuntimeReg(Arm64Register.x0), cond: Arm64CondCode.eq)
end 'arm64EmitWin32BoolFromZeroStatus'

// What a POSIX call that reports only success or failure answers on success.
let PosixCallSucceeded = 0

// ⭐ **AN errno IN x0 BECOMING THE Win32 CODE THE Std TIER CLASSIFIES — the whole body of
// `mrt_host_last_error` except for where the errno came FROM.** Each lane fetches it its own way and then
// branches here; the mapping itself has no lane in it (see `PosixErrnoNoSuchFileOrDirectory`).
//
// ⚠ **THE MAPPING IS NOT THE IDENTITY AND CANNOT BE**, even though `ENOENT` and `ERROR_FILE_NOT_FOUND` are
// both 2. ⚠ **A CLEARED errno ANSWERS `ERROR_NO_MORE_FILES`** — see `PosixErrnoCleared`.
export function arm64EmitErrnoToWin32(asm Arm64RuntimeAsm)
	let notFound = asm.newLabel()
	let pathNotFound = asm.newLabel()
	let denied = asm.newLabel()
	let noMoreFiles = asm.newLabel()
	let answered = asm.newLabel()

	arm64EmitCbzTo(asm, reg: Arm64Register.x0, label: noMoreFiles)
	arm64EmitCmpRuntimeImm(asm, reg: Arm64Register.x0, imm: PosixErrnoNoSuchFileOrDirectory as Imm32)
	arm64EmitCondBranchTo(asm, cond: Arm64CondCode.eq, label: notFound)
	arm64EmitCmpRuntimeImm(asm, reg: Arm64Register.x0, imm: PosixErrnoNotADirectory as Imm32)
	arm64EmitCondBranchTo(asm, cond: Arm64CondCode.eq, label: pathNotFound)
	arm64EmitCmpRuntimeImm(asm, reg: Arm64Register.x0, imm: PosixErrnoPermissionDenied as Imm32)
	arm64EmitCondBranchTo(asm, cond: Arm64CondCode.eq, label: denied)
	arm64EmitCmpRuntimeImm(asm, reg: Arm64Register.x0, imm: PosixErrnoOperationNotPermitted as Imm32)
	arm64EmitCondBranchTo(asm, cond: Arm64CondCode.eq, label: denied)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x0, value: ErrorGenericFailure as MachineWord)
	arm64EmitBranchTo(asm, label: answered)

	asm.placeLabel(notFound)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x0, value: ErrorFileNotFound as MachineWord)
	arm64EmitBranchTo(asm, label: answered)

	asm.placeLabel(pathNotFound)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x0, value: ErrorPathNotFound as MachineWord)
	arm64EmitBranchTo(asm, label: answered)

	asm.placeLabel(denied)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x0, value: ErrorAccessDenied as MachineWord)
	arm64EmitBranchTo(asm, label: answered)

	asm.placeLabel(noMoreFiles)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x0, value: ErrorNoMoreFiles as MachineWord)

	asm.placeLabel(answered)
end 'arm64EmitErrnoToWin32'

// Whole SECONDS since the Unix epoch becoming the FILETIME `WIN32_FIND_DATAA` carries.
//
// ⚠ **IT READS `ClockRuntime`'s OWN TWO CONSTANTS RATHER THAN A PRODUCER-SIDE COPY OF THEM.** The Std graph
// that DECODES a FILETIME (`emitFileTimeToUnixSeconds`) is built from those, so reading them here makes the
// producer and the consumer one fact instead of a pair something has to check.
//
// ⭐ **THE LINUX WALL CLOCK CALLS IT TOO, AND THAT IS WHY IT IS HERE RATHER THAN WITH THE `stat` FILL.**
// `clock_gettime` answers a `timespec`, whose SECONDS half is exactly this conversion and whose nanoseconds
// half is one `udiv` by `posixNanosPerFileTimeTick()` on top. The Darwin wall clock reads nanoseconds outright
// and so does the division alone — it is the one caller of that constant that needs no seconds step.
export function arm64EmitSecondsToFileTime(asm Arm64RuntimeAsm, reg Arm64Register, scratch Arm64Register)
	arm64EmitMovRuntimeImm(asm, dest: scratch, value: FileTimeTicksPerSecond as MachineWord)
	arm64EmitRuntimeRrr(asm, opcode: Arm64OpMul, dest: reg, lhs: reg, rhs: scratch)
	arm64EmitMovRuntimeImm(asm, dest: scratch, value: FileTimeTicksFrom1601To1970 as MachineWord)
	arm64EmitAddRuntimeReg(asm, dest: reg, lhs: reg, rhs: scratch)
end 'arm64EmitSecondsToFileTime'

// ==========================================================================
// mrt_host_base_name(x0 = path) -> x0 = the byte after the last '/'
// mrt_host_has_wildcard(x0 = cstr) -> x0 = 1 | 0
// ==========================================================================

// ⭐⭐ **WHY `FindFirstFileA` NEEDS AN EMULATION AT ALL, ON EITHER LANE.** It takes a GLOB —
// `"temp/things/*.txt"` — and POSIX has no call that does: a directory is OPENED by name and a name is
// matched against a pattern one at a time. So the pattern is split at its last `/`, the prefix is opened and
// the suffix is matched against every entry.
//
// ⛔ **THE PATTERN CANNOT BE CHANGED TO SUIT EITHER LANE**: it is written in USER SOURCE
// (`__ManagedDirectory.openSearch("{dirPath}/*.txt")`, `specs-shv2/managed-directory.md`), so the split is
// the backend's work and not the caller's. ⚠ v1 does NOT do this — it STRIPS a trailing `/*` and treats the
// rest as a directory path (`runtime.std:mrt_strip_trailing_dir_glob`), which answers every entry for
// `*.txt` and is why that reference is read here and not copied.

// Where a path's FINAL COMPONENT starts: just past the last `/`, or the path itself when it has none. It is a
// pointer INTO the caller's string and owns nothing.
export function buildArm64PosixBaseNameChunk() returns FunctionCodeChunk
	var asm = Arm64RuntimeAsm.beginFunction(0)

	let step = asm.newLabel()
	let notSeparator = asm.newLabel()
	let scanned = asm.newLabel()

	arm64EmitMovRuntimeReg(asm, dest: Arm64Register.x1, src: Arm64Register.x0)
	arm64EmitMovRuntimeReg(asm, dest: Arm64Register.x2, src: Arm64Register.x0)

	asm.placeLabel(step)
	arm64EmitLoadByte(asm, dest: Arm64Register.x3, base: Arm64Register.x1)
	arm64EmitCbzTo(asm, reg: Arm64Register.x3, label: scanned)
	arm64EmitCmpRuntimeImm(asm, reg: Arm64Register.x3, imm: PosixPathSeparatorByte as Imm32)
	arm64EmitCondBranchTo(asm, cond: Arm64CondCode.ne, label: notSeparator)
	arm64EmitAddRuntimeImm(asm, dest: Arm64Register.x2, base: Arm64Register.x1, imm: 1)

	asm.placeLabel(notSeparator)
	arm64EmitAddRuntimeImm(asm, dest: Arm64Register.x1, base: Arm64Register.x1, imm: 1)
	arm64EmitBranchTo(asm, label: step)

	asm.placeLabel(scanned)
	arm64EmitMovRuntimeReg(asm, dest: Arm64Register.x0, src: Arm64Register.x2)
	return asm.finishFunction(HostBaseNameName)
end 'buildArm64PosixBaseNameChunk'

// Does this base name carry a wildcard? A pattern with neither `*` nor `?` names ONE path, and answering it
// with a single `stat` rather than a directory walk is both faster — `__mf_exists` on a file in a large
// directory would otherwise be linear in that directory — and MORE FAITHFUL: `FindFirstFileA` matches a
// literal name the way the FILESYSTEM does, which on a case-insensitive volume is case-insensitively, while
// both lanes' pattern matchers are case-sensitive. Handing the literal to `stat` lets the filesystem answer.
export function buildArm64PosixHasWildcardChunk() returns FunctionCodeChunk
	var asm = Arm64RuntimeAsm.beginFunction(0)

	let step = asm.newLabel()
	let found = asm.newLabel()
	let plain = asm.newLabel()
	let answered = asm.newLabel()

	asm.placeLabel(step)
	arm64EmitLoadByte(asm, dest: Arm64Register.x1, base: Arm64Register.x0)
	arm64EmitCbzTo(asm, reg: Arm64Register.x1, label: plain)
	arm64EmitCmpRuntimeImm(asm, reg: Arm64Register.x1, imm: PosixGlobStarByte as Imm32)
	arm64EmitCondBranchTo(asm, cond: Arm64CondCode.eq, label: found)
	arm64EmitCmpRuntimeImm(asm, reg: Arm64Register.x1, imm: PosixGlobQuestionByte as Imm32)
	arm64EmitCondBranchTo(asm, cond: Arm64CondCode.eq, label: found)
	arm64EmitAddRuntimeImm(asm, dest: Arm64Register.x0, base: Arm64Register.x0, imm: 1)
	arm64EmitBranchTo(asm, label: step)

	asm.placeLabel(found)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x0, value: 1)
	arm64EmitBranchTo(asm, label: answered)

	asm.placeLabel(plain)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x0, value: 0)

	asm.placeLabel(answered)
	return asm.finishFunction(HostHasWildcardName)
end 'buildArm64PosixHasWildcardChunk'

// ==========================================================================
// mrt_host_attrs_from_mode(x0 = statBufPtr) -> x0 = dwFileAttributes
// mrt_host_fill_find_data(x0 = findDataPtr, x1 = statBufPtr, x2 = namePtr)
// ==========================================================================

// The `dwFileAttributes` mask a `st_mode` becomes. Only the two bits the corpus can observe are produced —
// `__mf_exists` reads DIRECTORY, `__mf_stat` publishes DIRECTORY and READ-ONLY — and an ordinary file gets
// `FILE_ATTRIBUTE_NORMAL` rather than 0, because 0 is not a mask Win32 ever answers.
//
// ⚠ **READ-ONLY IS THE OWNER'S WRITE BIT AND NOTHING FINER.** POSIX has three write bits and Win32 has one
// flag; the owner's is the one that decides whether the process that just created the file can write it,
// which is the question `readOnly` is asked to answer.
export function buildArm64PosixAttrsFromModeChunk(layout PosixStatLayout) returns FunctionCodeChunk
	var asm = Arm64RuntimeAsm.beginFunction(0)

	arm64EmitLoadWord32At(asm, dest: Arm64Register.x1, base: Arm64Register.x0, byteOffset: layout.modeOffset)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x2, value: PosixModeMask)
	arm64EmitRuntimeRrr(asm, opcode: Arm64OpAnd, dest: Arm64Register.x1, lhs: Arm64Register.x1, rhs: Arm64Register.x2)

	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x2, value: PosixFileTypeMask)
	arm64EmitRuntimeRrr(asm, opcode: Arm64OpAnd, dest: Arm64Register.x3, lhs: Arm64Register.x1, rhs: Arm64Register.x2)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x2, value: PosixFileTypeDirectory)
	arm64EmitCmpRuntimeReg(asm, lhs: Arm64Register.x3, rhs: Arm64Register.x2)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x3, value: FileAttributeDirectory as MachineWord)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x4, value: FileAttributeNormal as MachineWord)
	arm64EmitCsel(asm.code, dest: arm64RuntimeReg(Arm64Register.x0), ifTrue: arm64RuntimeReg(Arm64Register.x3), ifFalse: arm64RuntimeReg(Arm64Register.x4), cond: Arm64CondCode.eq)

	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x2, value: PosixOwnerWriteBit)
	arm64EmitRuntimeRrr(asm, opcode: Arm64OpAnd, dest: Arm64Register.x3, lhs: Arm64Register.x1, rhs: Arm64Register.x2)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x4, value: FileAttributeReadOnly as MachineWord)
	arm64EmitRuntimeRrr(asm, opcode: Arm64OpOrr, dest: Arm64Register.x4, lhs: Arm64Register.x0, rhs: Arm64Register.x4)
	arm64EmitCmpRuntimeImm(asm, reg: Arm64Register.x3, imm: 0)
	arm64EmitCsel(asm.code, dest: arm64RuntimeReg(Arm64Register.x0), ifTrue: arm64RuntimeReg(Arm64Register.x4), ifFalse: arm64RuntimeReg(Arm64Register.x0), cond: Arm64CondCode.eq)

	return asm.finishFunction(HostAttrsFromModeName)
end 'buildArm64PosixAttrsFromModeChunk'

// ⭐⭐ **SYNTHESIZE THE 320-BYTE `WIN32_FIND_DATAA` FROM A `struct stat` AND A NAME.** Windows fills this
// record itself; every field here has to be produced, and the offsets come from `ManagedFileRuntime` — the
// file that READS them back — rather than being transcribed, because a second copy of "cFileName is at 44"
// is a number nothing checks.
//
// ⚠ **THE ATTRIBUTE STORE COMES FIRST AND THE ORDER IS LOAD-BEARING.** The mask is a DWORD at offset 0 and
// this assembler's narrowest 64-bit store writes eight bytes, so it also clears 4..7 — which is the low half
// of `ftCreationTime`. Writing the creation time SECOND repairs that by construction; writing it first would
// leave a timestamp with a zeroed low word and a plausible-looking value.
//
// ⚠ **THE TWO SIZE DWORDS ARE ONE UNALIGNED 64-BIT STORE**, and the halves are swapped to get there:
// `nFileSizeHigh` sits at 28 and `nFileSizeLow` at 32, so on a little-endian machine the word that lands
// correctly is `(low << 32) | high` — a 64-bit rotate of the size by 32.
export function buildArm64PosixFillFindDataChunk(layout PosixStatLayout) returns FunctionCodeChunk
	let SlotFindData = 0 as StackSize
	let SlotStat = 1 as StackSize
	let SlotName = 2 as StackSize
	var asm = Arm64RuntimeAsm.beginFunction(3)

	arm64EmitStoreSlot(asm, reg: Arm64Register.x0, slot: SlotFindData)
	arm64EmitStoreSlot(asm, reg: Arm64Register.x1, slot: SlotStat)
	arm64EmitStoreSlot(asm, reg: Arm64Register.x2, slot: SlotName)

	arm64EmitLoadSlot(asm, reg: Arm64Register.x0, slot: SlotStat)
	arm64EmitBranchLink(asm.code, callFixups: asm.callFixups, targetName: HostAttrsFromModeName)
	arm64EmitLoadSlot(asm, reg: Arm64Register.x1, slot: SlotFindData)
	arm64EmitStoreWord64At(asm, src: Arm64Register.x0, base: Arm64Register.x1, byteOffset: FindDataAttributesOffset as MachineWord)

	arm64PosixFillFindDataTime(asm, statSlot: SlotStat, findSlot: SlotFindData, statOffset: layout.creationTimeOffset, findOffset: FindDataCreationTimeOffset as MachineWord)
	arm64PosixFillFindDataTime(asm, statSlot: SlotStat, findSlot: SlotFindData, statOffset: layout.accessTimeOffset, findOffset: FindDataLastAccessTimeOffset as MachineWord)
	arm64PosixFillFindDataTime(asm, statSlot: SlotStat, findSlot: SlotFindData, statOffset: layout.modifyTimeOffset, findOffset: FindDataLastWriteTimeOffset as MachineWord)

	arm64EmitLoadSlot(asm, reg: Arm64Register.x1, slot: SlotStat)
	arm64EmitLoadWord64At(asm, dest: Arm64Register.x0, base: Arm64Register.x1, byteOffset: layout.sizeOffset)
	arm64EmitLsrImm(asm.code, rd: arm64RuntimeReg(Arm64Register.x2), rn: arm64RuntimeReg(Arm64Register.x0), sh: Arm64NarrowResultShift as ShiftCount)
	arm64EmitLslImm(asm.code, rd: arm64RuntimeReg(Arm64Register.x3), rn: arm64RuntimeReg(Arm64Register.x0), sh: Arm64NarrowResultShift as ShiftCount)
	arm64EmitRuntimeRrr(asm, opcode: Arm64OpOrr, dest: Arm64Register.x0, lhs: Arm64Register.x3, rhs: Arm64Register.x2)
	arm64EmitLoadSlot(asm, reg: Arm64Register.x1, slot: SlotFindData)
	arm64EmitStoreWord64Unaligned(asm, src: Arm64Register.x0, base: Arm64Register.x1, byteOffset: FindDataSizeHighOffset as MachineWord, scratch: Arm64Register.x2)

	arm64EmitLoadSlot(asm, reg: Arm64Register.x1, slot: SlotName)
	arm64EmitLoadSlot(asm, reg: Arm64Register.x2, slot: SlotFindData)
	arm64EmitAddRuntimeImm(asm, dest: Arm64Register.x2, base: Arm64Register.x2, imm: FindDataFileNameOffset as Imm32)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x3, value: PosixPathStringCapacity as MachineWord)
	arm64EmitCopyCStringBounded(asm, src: Arm64Register.x1, dest: Arm64Register.x2, limit: Arm64Register.x3, scratch: Arm64Register.x4)

	return asm.finishFunction(HostFillFindDataName)
end 'buildArm64PosixFillFindDataChunk'

// One `struct stat` timestamp into one `WIN32_FIND_DATAA` FILETIME field. Three fields, one fragment: the
// conversion is the same arithmetic each time and the only thing that varies is which pair of offsets.
function arm64PosixFillFindDataTime(asm Arm64RuntimeAsm, statSlot StackSize, findSlot StackSize, statOffset MachineWord, findOffset MachineWord)
	arm64EmitLoadSlot(asm, reg: Arm64Register.x1, slot: statSlot)
	arm64EmitLoadWord64At(asm, dest: Arm64Register.x0, base: Arm64Register.x1, byteOffset: statOffset)
	arm64EmitSecondsToFileTime(asm, reg: Arm64Register.x0, scratch: Arm64Register.x2)
	arm64EmitLoadSlot(asm, reg: Arm64Register.x1, slot: findSlot)
	arm64EmitStoreWord64Unaligned(asm, src: Arm64Register.x0, base: Arm64Register.x1, byteOffset: findOffset, scratch: Arm64Register.x2)
end 'arm64PosixFillFindDataTime'

// ==========================================================================
// L5/MAC8 — the CHILD-PROCESS band, and why almost all of it is HERE
// ==========================================================================

// ⭐⭐⭐ **THE SUBPROCESS FAMILY IS THE ONE HOST SURFACE WHOSE TWO LANES SHARE THE ALGORITHM AND NOT THE
// CALLS.** Every other family in this file splits the other way round: `FindFirstFileA`'s glob is one shape
// over two entirely different directory readers. Here the reverse holds — `waitpid` and `wait4` decode the
// SAME status word, `poll` and `ppoll` fill the SAME `struct pollfd`, and the three loops on top (the
// bounded child await, the netpoll's multi-wait, the exit-code read) contain no OS call of their own at all:
// they are `bl`s to the two chunks below them plus a millisecond sleep. So the bodies live here and the two
// lanes contribute only their CALL, through `PosixHostCall`.
//
// ⚠ **THE ONE MEMBER THAT IS NOT SHARED IS THE SPAWN, AND IT IS NOT SHARED IN THE STRONGEST WAY.** Darwin
// has `posix_spawnp` — one call, a file-actions builder and `POSIX_SPAWN_CLOEXEC_DEFAULT`. AArch64-Linux has
// no spawn primitive at all (and no legacy `fork`, `pipe`, `dup2` or `poll` either), so its body is a raw
// `clone(SIGCHLD)` and a hand-built child. There is nothing in common to lift; each lane writes
// `mrt_host_spawn` itself, under this file's shared name.

// The child-process band's shared symbols. `mrt_host_proc_reap` and `mrt_host_proc_await` are internal to
// the band — no isel lowering names either — but they are `bl`'d from bodies BOTH lanes lay out, so they
// wear the shared prefix for the same reason every name above does: a per-lane infix would need a table
// mapping `(os, verb)` to a symbol.
export let HostPipeName = b"mrt_host_pipe"
export let HostPipePeekName = b"mrt_host_pipe_peek"
export let HostSpawnName = b"mrt_host_spawn"
export let HostProcReapName = b"mrt_host_proc_reap"
export let HostProcAwaitName = b"mrt_host_proc_await"
export let HostProcExitCodeName = b"mrt_host_proc_exit_code"
export let HostProcTerminateName = b"mrt_host_proc_terminate"
export let HostWaitAnyName = b"mrt_host_wait_any"
export let HostTickMsName = b"mrt_host_tick_ms"

// ⭐ **A CHILD PROCESS IS A WAIT OBJECT KIND, AND BOTH LANES NOW MINT ONE**, so it joins `PosixWaitKindEvent`
// here rather than staying either lane's private constant: `mrt_host_spawn` writes it and `mrt_host_wait_one`
// and `mrt_host_wait_close` both dispatch on it, in bodies this file owns.
export let PosixWaitKindProcess = 3

// ⭐⭐ **AND SO IS A WORKER M's OS THREAD, AS OF THE arm64-LINUX `clone`.** This constant was
// `Arm64DarwinRuntime.DarwinWaitKindThread` for exactly as long as *"only that lane can create one"* was
// true — `osThreadCreate` was a runtime abort on the Linux lane, so the kind could never reach its
// `mrt_host_wait_new`. `mrt_host_thread_create` is a real `clone` there now, both lanes mint the kind and
// both dispatch on it, so it is a shared protocol number like the two above rather than either lane's
// private constant. ⚠ The three kinds are 1, 2 and 3 and none is 0, so an object whose kind field was never
// written cannot be mistaken for any of them.
export let PosixWaitKindThread = 2

// ==========================================================================
// The WAIT OBJECT's shared prefix
// ==========================================================================

// ⭐⭐ **SIX FIELDS AT SIX FIXED OFFSETS, IDENTICAL ON BOTH LANES — which is what lets the reap, the await,
// the exit-code read and the multi-wait be ONE body each.** What the two lanes disagree about is what sits
// ABOVE these: Darwin follows them with a `pthread_mutex_t` and a `pthread_cond_t` (an event there is a
// condition variable); Linux follows them with nothing at all (a futex needs no mutex, and the object is one
// `mmap`'d page).
//
// ⭐⭐ **0x10 WAS A HOLE ON THE LINUX LANE AND IS NOW THE SIXTH SHARED FIELD: THE OS THREAD's OWN IDENTITY.**
// It held Darwin's `pthread_t` and this header said it was Darwin's alone *"because only that lane can hold
// one"*; the arm64-linux `clone` falsified that. What sits there differs — a `pthread_t` that `pthread_join`
// takes on one lane, the `CLONE_CHILD_CLEARTID` word the kernel zeroes and wakes on the other — but the ROLE
// is identical (it is what `mrt_host_wait_one`'s THREAD arm joins through), so the offset is one fact
// written once rather than two lanes agreeing by hand. ⚠ Only a THREAD object gives it a MEANING; on the
// other two kinds it is a zero, written explicitly on the lane whose allocator does not zero (`malloc`) and
// inherited from the page on the lane whose does (`mmap`).
export let PosixWaitOffKind = 0x00 as MachineWord
export let PosixWaitOffSignal = 0x08 as MachineWord
export let PosixWaitOffThread = 0x10 as MachineWord
export let PosixWaitOffChildPid = 0x18 as MachineWord
export let PosixWaitOffChildStatus = 0x20 as MachineWord
export let PosixWaitOffChildKilled = 0x28 as MachineWord

// The two states of the signal word above. They are HERE rather than once per lane because the field is
// shared and `mrt_host_proc_reap` — a shared body — publishes into it; each lane's own event protocol reads
// the same two values through its own primitive (a condvar predicate there, a `FUTEX_WAIT` comparand here).
export let PosixWaitNotSignalled = 0
export let PosixWaitSignalled = 1

// ==========================================================================
// `PosixHostCall` — the ONE thing a shared body takes from its lane
// ==========================================================================

// ⭐ **THE ROUTE FORK, AS DATA RATHER THAN AS A SECOND COPY OF A BODY.** It is the runtime-chunk twin of
// `StdToArm64Conversion.emitOsPrimitiveCall`'s `(importSlot, syscallNumber)` pair, and it exists for the same
// reason: the two lanes reach the identical primitive through different doors, and a body written twice
// around that difference is this project's signature bug.
export union PosixHostCall
	// A GOT-indirect libSystem call — the arm64-macOS route, where every primitive in this band is a libc
	// function.
	importCall(slot OsImportSlot)
	// A raw `svc #0` — the arm64-Linux route, where a static image links no libc and the AArch64 syscall
	// table is the only door.
	syscall(number MachineWord)
end 'PosixHostCall'

function arm64PosixEmitHostCall(asm Arm64RuntimeAsm, call PosixHostCall)
	match call 'route'
		importCall(slot) then arm64EmitImportCall(asm.code, iatRelocs: asm.iatRelocs, slotIndex: osImportSlotIndex(slot))
		syscall(number) then arm64EmitSyscall(asm.code, number: number)
	end 'route'
end 'arm64PosixEmitHostCall'

// The same call, followed by whatever that route owes before a `cmp x0, #0` reads its answer correctly.
//
// ⚠ **THE NARROWING IS THE IMPORT ROUTE'S ALONE AND MUST NOT BE BLANKET.** A libSystem call answers a C
// `int` whose upper half AAPCS64 leaves unspecified, so that half is shifted out; a `svc` answers a full
// 64-bit `-errno` the kernel already settled, and a second opinion about it would be
// `arm64LinuxEmitStashIfFailed`'s note in reverse. ⛔ It is a SHIFT and not a sign-extend, so it destroys the
// value — which is why `mrt_host_proc_reap`, whose answer is a `pid_t` it must still compare, calls
// `arm64PosixEmitHostCall` above and masks instead.
function arm64PosixEmitHostCallStatus(asm Arm64RuntimeAsm, call PosixHostCall)
	arm64PosixEmitHostCall(asm, call: call)

	match call 'route'
		importCall then arm64PosixNarrowIntStatus(asm, reg: Arm64Register.x0)
		syscall then break 'route'
	end 'route'
end 'arm64PosixEmitHostCallStatus'

// Discard the unspecified upper half of a register holding a C `int` return, leaving the low 32 bits where a
// following `cbz`/`cbnz`/`cmp` tests them — `mrt_host_exe_path`'s trap, and the same shift.
export function arm64PosixNarrowIntStatus(asm Arm64RuntimeAsm, reg Arm64Register)
	arm64EmitLslImm(asm.code, rd: arm64RuntimeReg(reg), rn: arm64RuntimeReg(reg), sh: Arm64NarrowResultShift as ShiftCount)
end 'arm64PosixNarrowIntStatus'

// ==========================================================================
// The POSIX facts the child-process band reads — MEASURED on BOTH lanes
// ==========================================================================

// `struct pollfd` is `{int fd; short events; short revents;}` — EIGHT bytes, MEASURED on Darwin and on an
// aarch64 Linux guest, which is why the whole descriptor is written and read as ONE 64-bit word rather than
// through three stores of three widths. Little-endian: `fd` is the low half, `events` the third halfword,
// `revents` the fourth.
let PosixPollIn = 1
let PosixPollEventsUnit = 0x0000000100000000
let PosixPollReventsShift = 48 as ShiftCount
let PosixPollOneDescriptor = 1

// `poll`'s revents bits, MEASURED on both. Only the two that mean *"this descriptor is unusable"* are tested
// — `POLLHUP` (0x10) is deliberately NOT among them, because a pipe whose writer has closed reports it
// ALONGSIDE `POLLIN` while bytes are still buffered (MEASURED: `revents = 0x11` on both lanes), and treating
// it as broken would discard them.
let PosixPollErr = 8
let PosixPollNval = 32
let PosixPollBrokenBits = PosixPollErr or PosixPollNval

// ⭐⭐ **WHAT `mrt_host_pipe_peek` REPORTS AS "AVAILABLE", AND WHY IT IS NOT THE TRUE COUNT.**
// `PeekNamedPipe` answers a byte count; the honest POSIX twin would be `ioctl(fd, FIONREAD, &n)`, whose third
// argument is a VARARG that AAPCS64 passes on the STACK — a frame these chunks do not have
// (`Arm64RuntimeAsm`: *"none of them passes an argument on the stack"*).
//
// It costs nothing, because of what the ONE consumer does with the answer. `emitSubpDrainStream` uses it only
// to (a) decide whether to read at all and (b) size one pass, which it immediately clamps to
// `SubpReadChunkBytes`; the bytes actually moved come from the READ. So reporting "a pipe-buffer's worth"
// makes the pass exactly one clamped chunk and the read reports the truth — while a peek that answered `1`
// would drip one byte per pass and turn an N-byte capture into N round trips.
//
// ⚠ **AND IT IS WHY EOF ARRIVES THROUGH THE READ RATHER THAN THROUGH THE PEEK.** `emitSubpDrainStream` has
// two edges into `markDone`: a FAILED peek (Win32's broken-pipe reading) and a read of 0 bytes. A pipe whose
// writer has closed polls READABLE on both lanes — MEASURED `0x11` with bytes buffered and `0x10` once
// drained — so this answers "readable", the read answers 0, and the second edge fires.
//
// ⚠ The number is also the pipe's real capacity on both (MEASURED: 65536 on aarch64 Linux, and the threshold
// at which a wait-before-drain deadlocks on either).
let PosixPipeReadyBytes = 65536

// The two ways to ask `mrt_host_proc_reap` for a status, and the "do not block" option it hands the wait.
export let PosixReapWithoutBlocking = 0
let PosixReapBlocking = 1
let PosixWaitNoHang = 1

// Decoding a wait status, which POSIX defines by macro rather than by field: the low seven bits are the
// terminating SIGNAL and are zero for a normal exit, in which case bits 8..15 are the exit code. MEASURED
// identical on both lanes (`0x700` for exit 7, `0x9` for SIGKILL).
let PosixWaitStatusSignalMask = 0x7F
let PosixWaitStatusExitShift = 8 as ShiftCount
let PosixWaitStatusExitMask = 0xFF

// ⚠ **A SIGNAL-KILLED CHILD REPORTS `128 + signal`, WHICH IS THE SHELL'S CONVENTION AND NOT WIN32's.** There
// is no exit code for a process the kernel killed, and every POSIX shell answers this. The one place the two
// lanes WOULD have disagreed with Windows is the deadline kill, and they do not:
// `TerminateProcess(h, code)` names the code the handle must then report, and `mrt_host_proc_terminate`
// records it (`childKilled`) so the reap below hands back that code rather than `128 + SIGKILL`.
let PosixSignalExitCodeBase = 128
let PosixSigKill = 9

// The two answers the reap gives, named because a bare 0/1 at four call sites says nothing about which
// direction it reads.
let PosixChildSignalled = 1
let PosixChildStillRunning = 0

// A C `int`'s worth of bits — `pid_t`'s width, which is what a wait's answer must be compared at.
let PosixChildPidMask = 0xFFFFFFFF

// How long the two bounded child waits sleep between scans — the netpoll's multi-wait and a
// `waitWithTimeout` deadline. Both run where the M is meant to be idle, so a millisecond is a poll rate
// rather than a spin, and one number keeps the two from drifting into different responsiveness.
let PosixChildPollMs = 1

// `GtProcHandlesBaseLabel`'s array is one 64-bit handle per entry, so an index scales by 8 — as a SHIFT,
// which is what an indexed load off a base wants.
let PosixHandleArrayStrideShift = 3 as ShiftCount

// The child's three standard descriptors, named because a bare 0/1/2 in an argument position says nothing.
export let PosixChildStdinFd = 0
export let PosixChildStdoutFd = 1
export let PosixChildStderrFd = 2

// `PROCESS_INFORMATION.hThread` on either POSIX lane. Neither hands back a thread handle for a spawned
// process, and the Std graph closes this field unconditionally — which `mrt_host_wait_close` reads as
// "no handle".
export let PosixNoThreadHandle = 0

// ==========================================================================
// mrt_host_tick_ms() -> x0 = milliseconds since boot
// ==========================================================================

// `GetTickCount64`, in the unit `StdOp.osTickCountMs`'s consumers measure deadlines in — so a subprocess
// timeout and a scheduler deadline cannot drift apart by being read off two different clocks.
//
// ⭐ **IT ASKS `mrt_host_monotonic_clock` RATHER THAN READING A CLOCK ITSELF, WHICH IS WHAT MAKES THAT
// GUARANTEE STRUCTURAL.** The scheduler's deadlines come from that chunk; a second, independent read here —
// which is what this used to be on the Darwin lane — is a second clock choice that can silently become a
// different clock. The conversion is DERIVED from the frequency that chunk reports rather than assuming the
// 1e9 both lanes happen to answer today, so a lane that ever reports raw counter ticks needs no edit here.
export function buildArm64PosixTickMsChunk() returns FunctionCodeChunk
	let SlotTicks = 0 as StackSize
	let SlotFreq = 1 as StackSize
	var asm = Arm64RuntimeAsm.beginFunction(2)

	arm64EmitSlotAddr(asm, dest: Arm64Register.x0, slot: SlotTicks)
	arm64EmitSlotAddr(asm, dest: Arm64Register.x1, slot: SlotFreq)
	arm64EmitBranchLink(asm.code, callFixups: asm.callFixups, targetName: HostMonotonicClockName)

	arm64EmitLoadSlot(asm, reg: Arm64Register.x1, slot: SlotFreq)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x2, value: PosixMillisPerSecond)
	arm64EmitRuntimeRrr(asm, opcode: Arm64OpUdiv, dest: Arm64Register.x1, lhs: Arm64Register.x1, rhs: Arm64Register.x2)
	arm64EmitLoadSlot(asm, reg: Arm64Register.x0, slot: SlotTicks)
	arm64EmitRuntimeRrr(asm, opcode: Arm64OpUdiv, dest: Arm64Register.x0, lhs: Arm64Register.x0, rhs: Arm64Register.x1)

	return asm.finishFunction(HostTickMsName)
end 'buildArm64PosixTickMsChunk'

// ==========================================================================
// mrt_host_pipe(x0 = readOutPtr, x1 = writeOutPtr)
// ==========================================================================

// `CreatePipe` — an ANONYMOUS pair, where Windows needs a uniquely NAMED one to get overlapped reads.
//
// ⚠ **THE `name`, `SECURITY_ATTRIBUTES` AND `iocp` OPERANDS OF `StdOp.osPipeCreate` ARE IGNORED HERE, AND
// THAT IS A SHAPE DIFFERENCE RATHER THAN AN OMISSION.** The name exists so two concurrent overlapped reads
// cannot collide on one pipe name; the SA exists to make the ends inheritable; the port exists so a
// completion packet has somewhere to land. POSIX needs none of the three — a pipe is anonymous, inheritance
// is the spawn's business, and a read on either lane completes in its caller.
//
// ⭐⭐ **`flags` IS WHERE THE TWO LANES' INHERITANCE MODELS MEET.** Darwin passes 0 and marks nothing:
// `posix_spawnp` runs under `POSIX_SPAWN_CLOEXEC_DEFAULT`, which inverts the POSIX default so that NOTHING
// crosses the exec except the descriptors the file actions name. AArch64-Linux has no spawn primitive to
// carry such a flag, so the marking happens HERE instead — `pipe2(O_CLOEXEC)` — and the child's `dup3` onto
// 0/1/2 is what CLEARS it for the three that must survive. Either way the property is the same one, and it
// is not optional: without it a child keeps a copy of the parent's stdin WRITE end and never sees EOF when
// `subprocessCloseStdin` closes the parent's, which is a HANG rather than a wrong answer.
//
// ⚠ **A FAILED pipe LEAVES BOTH OUT-WORDS ZERO**, which is the Std tier's own "no pipe" reading
// (`emitSubpDrainStream` tests `readEnd == 0`). A pipe cannot answer descriptor 0 in a process that still
// holds its standard streams, so a real end is never mistaken for the absence of one.
export function buildArm64PosixPipeChunk(call PosixHostCall, flags MachineWord) returns FunctionCodeChunk
	let SlotReadOut = 0 as StackSize
	let SlotWriteOut = 1 as StackSize
	let SlotFds = 2 as StackSize
	var asm = Arm64RuntimeAsm.beginFunction(3)

	let created = asm.newLabel()
	let published = asm.newLabel()

	arm64EmitStoreSlot(asm, reg: Arm64Register.x0, slot: SlotReadOut)
	arm64EmitStoreSlot(asm, reg: Arm64Register.x1, slot: SlotWriteOut)
	arm64EmitSlotAddr(asm, dest: Arm64Register.x0, slot: SlotFds)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x1, value: flags)
	arm64PosixEmitHostCallStatus(asm, call: call)
	arm64EmitCbzTo(asm, reg: Arm64Register.x0, label: created)

	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x2, value: 0)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x3, value: 0)
	arm64EmitBranchTo(asm, label: published)

	asm.placeLabel(created)
	arm64EmitSlotAddr(asm, dest: Arm64Register.x4, slot: SlotFds)
	arm64EmitLoadWord32At(asm, dest: Arm64Register.x2, base: Arm64Register.x4, byteOffset: 0)
	arm64EmitLoadWord32At(asm, dest: Arm64Register.x3, base: Arm64Register.x4, byteOffset: PosixPipeWriteEndOffset)

	asm.placeLabel(published)
	arm64EmitLoadSlot(asm, reg: Arm64Register.x0, slot: SlotReadOut)
	arm64EmitStoreWord64At(asm, src: Arm64Register.x2, base: Arm64Register.x0, byteOffset: 0)
	arm64EmitLoadSlot(asm, reg: Arm64Register.x1, slot: SlotWriteOut)
	arm64EmitStoreWord64At(asm, src: Arm64Register.x3, base: Arm64Register.x1, byteOffset: 0)

	return asm.finishFunction(HostPipeName)
end 'buildArm64PosixPipeChunk'

// `int fds[2]` — the WRITE end is the second `int`, four bytes past the first.
let PosixPipeWriteEndOffset = 4

// ==========================================================================
// mrt_host_pipe_peek(x0 = handle, x1 = availOutPtr) -> x0 = BOOL
// ==========================================================================

// `PeekNamedPipe` — "are there bytes to read, without committing to a read". `PosixPipeReadyBytes` above
// carries the whole argument for the count this answers and for where EOF is reported.
export function buildArm64PosixPipePeekChunk(poll PosixPollCall) returns FunctionCodeChunk
	let SlotAvailOut = 0 as StackSize
	let SlotPollfd = 1 as StackSize
	let SlotTsSec = 2 as StackSize
	let SlotTsNsec = 3 as StackSize
	var asm = Arm64RuntimeAsm.beginFunction(4)

	let notReady = asm.newLabel()
	let broken = asm.newLabel()
	let publish = asm.newLabel()
	let answered = asm.newLabel()

	arm64EmitStoreSlot(asm, reg: Arm64Register.x1, slot: SlotAvailOut)
	arm64PosixUntagHandle(asm, reg: Arm64Register.x0)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x2, value: PosixPollEventsUnit * PosixPollIn)
	arm64EmitRuntimeRrr(asm, opcode: Arm64OpOrr, dest: Arm64Register.x0, lhs: Arm64Register.x0, rhs: Arm64Register.x2)
	arm64EmitSlotAddr(asm, dest: Arm64Register.x3, slot: SlotPollfd)
	arm64EmitStoreWord64At(asm, src: Arm64Register.x0, base: Arm64Register.x3, byteOffset: 0)

	arm64PosixEmitPollNoWait(asm, poll: poll, pollfdSlot: SlotPollfd, secSlot: SlotTsSec, nsecSlot: SlotTsNsec)
	arm64EmitCmpRuntimeImm(asm, reg: Arm64Register.x0, imm: 0)
	arm64EmitCondBranchTo(asm, cond: Arm64CondCode.lt, label: broken)
	arm64EmitCondBranchTo(asm, cond: Arm64CondCode.eq, label: notReady)

	// Ready — unless the descriptor itself is unusable, which is `PeekNamedPipe`'s own failure and the Std
	// tier's other route to `markDone`.
	arm64EmitSlotAddr(asm, dest: Arm64Register.x3, slot: SlotPollfd)
	arm64EmitLoadWord64At(asm, dest: Arm64Register.x1, base: Arm64Register.x3, byteOffset: 0)
	arm64EmitLsrImm(asm.code, rd: arm64RuntimeReg(Arm64Register.x1), rn: arm64RuntimeReg(Arm64Register.x1), sh: PosixPollReventsShift)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x2, value: PosixPollBrokenBits)
	arm64EmitRuntimeRrr(asm, opcode: Arm64OpAnd, dest: Arm64Register.x1, lhs: Arm64Register.x1, rhs: Arm64Register.x2)
	arm64EmitCbnzTo(asm, reg: Arm64Register.x1, label: broken)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x2, value: PosixPipeReadyBytes)
	arm64EmitBranchTo(asm, label: publish)

	asm.placeLabel(notReady)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x2, value: 0)

	asm.placeLabel(publish)
	arm64EmitLoadSlot(asm, reg: Arm64Register.x1, slot: SlotAvailOut)
	arm64EmitStoreWord64At(asm, src: Arm64Register.x2, base: Arm64Register.x1, byteOffset: 0)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x0, value: Win32True as MachineWord)
	arm64EmitBranchTo(asm, label: answered)

	asm.placeLabel(broken)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x0, value: Win32False as MachineWord)

	asm.placeLabel(answered)
	return asm.finishFunction(HostPipePeekName)
end 'buildArm64PosixPipePeekChunk'

// ⭐⭐ **HOW A LANE SPELLS "POLL ONE DESCRIPTOR AND ANSWER NOW", WHICH THE TWO DO NOT AGREE ABOUT EVEN IN
// ARITY.** Darwin has `poll(fds, nfds, timeoutMs)` and asks for no wait with an integer 0. ⛔ **AArch64
// DROPPED THE LEGACY `poll` SYSCALL ENTIRELY**, so the Linux lane has only `ppoll`, whose timeout is a
// `struct timespec *` — and whose NULL is the exact INVERSE of Darwin's 0: it means block for ever. So the
// no-wait request is a zeroed `timespec` in two of the caller's frame slots, and the call carries two further
// arguments (a NULL signal mask and its size) that `poll` does not have at all.
//
// This is a union rather than two parameters because the route and the timeout's shape are ONE fact: there is
// no lane that spells the call one way and the timeout the other.
export union PosixPollCall
	// `poll(fds, 1, 0)` — libSystem's.
	pollImport(slot OsImportSlot)
	// `ppoll(fds, 1, &timespec{0,0}, NULL, sigsetBytes)`.
	ppollSyscall(number MachineWord, sigsetBytes MachineWord)
end 'PosixPollCall'

// ⚠ It leaves x0 as a status a `cmp #0` reads: negative is a failure, 0 is "not ready", positive is the
// number of ready descriptors. `arm64PosixEmitHostCallStatus`' narrowing rule applies to the import arm for
// its own reason.
//
// ⚠ Each arm is its own function for this file's usual reason: a `match` arm carries one expression and each
// of these is five or eight — `StdToArm64Conversion.lowerOsFileOpenDarwin`'s split, for its reason.
function arm64PosixEmitPollNoWait(asm Arm64RuntimeAsm, poll PosixPollCall, pollfdSlot StackSize, secSlot StackSize, nsecSlot StackSize)
	match poll 'route'
		pollImport(slot) then arm64PosixEmitPollImport(asm, slot: slot, pollfdSlot: pollfdSlot)
		ppollSyscall(number, sigsetBytes) then arm64PosixEmitPpoll(asm, number: number, sigsetBytes: sigsetBytes, pollfdSlot: pollfdSlot, secSlot: secSlot, nsecSlot: nsecSlot)
	end 'route'
end 'arm64PosixEmitPollNoWait'

function arm64PosixEmitPollImport(asm Arm64RuntimeAsm, slot OsImportSlot, pollfdSlot StackSize)
	arm64EmitSlotAddr(asm, dest: Arm64Register.x0, slot: pollfdSlot)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x1, value: PosixPollOneDescriptor)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x2, value: PosixPollNoWaitMillis)
	arm64PosixEmitHostCallStatus(asm, call: PosixHostCall.importCall(slot))
end 'arm64PosixEmitPollImport'

// The zeroed `timespec` goes in the caller's two frame slots, which must be CONSECUTIVE for the same reason
// `arm64PosixMillisToTimespec`'s are: `&slot(sec)` is what the kernel reads the pair through.
function arm64PosixEmitPpoll(asm Arm64RuntimeAsm, number MachineWord, sigsetBytes MachineWord, pollfdSlot StackSize, secSlot StackSize, nsecSlot StackSize)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x0, value: 0)
	arm64EmitStoreSlot(asm, reg: Arm64Register.x0, slot: secSlot)
	arm64EmitStoreSlot(asm, reg: Arm64Register.x0, slot: nsecSlot)
	arm64EmitSlotAddr(asm, dest: Arm64Register.x2, slot: secSlot)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x3, value: PosixPollNoSignalMask)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x4, value: sigsetBytes)
	arm64EmitSlotAddr(asm, dest: Arm64Register.x0, slot: pollfdSlot)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x1, value: PosixPollOneDescriptor)
	arm64EmitSyscall(asm.code, number: number)
end 'arm64PosixEmitPpoll'

// `poll`'s "answer now" timeout, as the `int` milliseconds it takes.
let PosixPollNoWaitMillis = 0

// `ppoll`'s `sigmask` argument. NULL leaves the calling thread's signal mask alone, which is what `poll` does
// and all this surface wants — this backend installs no signal handlers at all.
let PosixPollNoSignalMask = 0

// ==========================================================================
// mrt_host_proc_reap(x0 = object, x1 = blocking) -> x0 = signalled
// ==========================================================================

// ⭐⭐⭐ **THE ONE PLACE A CHILD's STATUS IS TAKEN, BECAUSE A POSIX WAIT CONSUMES IT AND WIN32's TWO CALLS DO
// NOT.** `WaitForSingleObject(hProcess)` and `GetExitCodeProcess(hProcess)` are both repeatable and
// independent; POSIX fuses them into one call that can be answered exactly ONCE — MEASURED on both lanes, a
// second wait on the same pid answers -1/`ECHILD`. Every Std graph in the subprocess family polls the handle
// and reads the code separately, and several do both more than once.
//
// ⇒ the status is CACHED in the handle's own object the first time it is taken, and every later ask is served
// from there. That is the whole reason a child process handle on either lane is an object rather than the
// bare pid it could otherwise have been.
//
// ⚠ **A KILLED CHILD KEEPS THE CODE THE KILL NAMED.** `mrt_host_proc_terminate` writes `childStatus` and
// raises `childKilled` BEFORE the signal lands, so this decodes nothing for it — see `PosixSignalExitCodeBase`
// for why the lanes would otherwise answer a different number for a deadline than Windows does.
//
// ⚠ **x3 IS SET FOR A FOURTH ARGUMENT ONLY ONE ROUTE HAS.** Linux's `wait4` takes a `struct rusage *` there
// and NULL discards it; Darwin's `waitpid` is a three-argument call that never reads the register. Setting it
// on both is one instruction and is what lets the two share this body.
export function buildArm64PosixProcReapChunk(wait PosixHostCall) returns FunctionCodeChunk
	let SlotObj = 0 as StackSize
	let SlotBlocking = 1 as StackSize
	let SlotStatus = 2 as StackSize
	var asm = Arm64RuntimeAsm.beginFunction(3)

	let alreadySignalled = asm.newLabel()
	let stillRunning = asm.newLabel()
	let statusChosen = asm.newLabel()
	let bySignal = asm.newLabel()
	let publish = asm.newLabel()
	let answered = asm.newLabel()

	arm64EmitStoreSlot(asm, reg: Arm64Register.x0, slot: SlotObj)
	arm64EmitStoreSlot(asm, reg: Arm64Register.x1, slot: SlotBlocking)
	arm64EmitLoadWord64At(asm, dest: Arm64Register.x2, base: Arm64Register.x0, byteOffset: PosixWaitOffSignal)
	arm64EmitCbnzTo(asm, reg: Arm64Register.x2, label: alreadySignalled)

	arm64EmitLoadWord64At(asm, dest: Arm64Register.x0, base: Arm64Register.x0, byteOffset: PosixWaitOffChildPid)
	arm64EmitSlotAddr(asm, dest: Arm64Register.x1, slot: SlotStatus)
	// `options = blocking ? 0 : WNOHANG`, as a compare and a `cset` — no branch for a two-valued argument.
	arm64EmitLoadSlot(asm, reg: Arm64Register.x2, slot: SlotBlocking)
	arm64EmitCmpRuntimeImm(asm, reg: Arm64Register.x2, imm: PosixReapWithoutBlocking)
	arm64EmitCset(asm.code, rd: arm64RuntimeReg(Arm64Register.x2), cond: Arm64CondCode.eq)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x3, value: PosixReapDiscardsRusage)
	arm64PosixEmitHostCall(asm, call: wait)

	// The wait answers the reaped pid, 0 (nothing to report yet, `WNOHANG`) or -1. Only the pid means the
	// child has been taken, and the comparison is on the low 32 bits because `pid_t` is a C `int`.
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x3, value: PosixChildPidMask)
	arm64EmitRuntimeRrr(asm, opcode: Arm64OpAnd, dest: Arm64Register.x0, lhs: Arm64Register.x0, rhs: Arm64Register.x3)
	arm64EmitLoadSlot(asm, reg: Arm64Register.x1, slot: SlotObj)
	arm64EmitLoadWord64At(asm, dest: Arm64Register.x1, base: Arm64Register.x1, byteOffset: PosixWaitOffChildPid)
	arm64EmitCmpRuntimeReg(asm, lhs: Arm64Register.x0, rhs: Arm64Register.x1)
	arm64EmitCondBranchTo(asm, cond: Arm64CondCode.ne, label: stillRunning)

	arm64EmitLoadSlot(asm, reg: Arm64Register.x1, slot: SlotObj)
	arm64EmitLoadWord64At(asm, dest: Arm64Register.x4, base: Arm64Register.x1, byteOffset: PosixWaitOffChildKilled)
	arm64EmitCbnzTo(asm, reg: Arm64Register.x4, label: statusChosen)

	arm64EmitSlotAddr(asm, dest: Arm64Register.x2, slot: SlotStatus)
	arm64EmitLoadWord32At(asm, dest: Arm64Register.x3, base: Arm64Register.x2, byteOffset: 0)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x2, value: PosixWaitStatusSignalMask)
	arm64EmitRuntimeRrr(asm, opcode: Arm64OpAnd, dest: Arm64Register.x5, lhs: Arm64Register.x3, rhs: Arm64Register.x2)
	arm64EmitCbnzTo(asm, reg: Arm64Register.x5, label: bySignal)
	arm64EmitLsrImm(asm.code, rd: arm64RuntimeReg(Arm64Register.x5), rn: arm64RuntimeReg(Arm64Register.x3), sh: PosixWaitStatusExitShift)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x2, value: PosixWaitStatusExitMask)
	arm64EmitRuntimeRrr(asm, opcode: Arm64OpAnd, dest: Arm64Register.x5, lhs: Arm64Register.x5, rhs: Arm64Register.x2)
	arm64EmitBranchTo(asm, label: publish)

	asm.placeLabel(bySignal)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x2, value: PosixSignalExitCodeBase)
	arm64EmitAddRuntimeReg(asm, dest: Arm64Register.x5, lhs: Arm64Register.x5, rhs: Arm64Register.x2)

	asm.placeLabel(publish)
	arm64EmitStoreWord64At(asm, src: Arm64Register.x5, base: Arm64Register.x1, byteOffset: PosixWaitOffChildStatus)

	asm.placeLabel(statusChosen)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x2, value: PosixWaitSignalled)
	arm64EmitStoreWord64At(asm, src: Arm64Register.x2, base: Arm64Register.x1, byteOffset: PosixWaitOffSignal)

	asm.placeLabel(alreadySignalled)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x0, value: PosixChildSignalled)
	arm64EmitBranchTo(asm, label: answered)

	asm.placeLabel(stillRunning)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x0, value: PosixChildStillRunning)

	asm.placeLabel(answered)
	return asm.finishFunction(HostProcReapName)
end 'buildArm64PosixProcReapChunk'

// `wait4`'s `struct rusage *` out-param, which NULL discards — and the register `waitpid` never reads.
let PosixReapDiscardsRusage = 0

// ==========================================================================
// mrt_host_proc_await(x0 = object, x1 = timeoutMs) -> x0 = WAIT_OBJECT_0 | WAIT_TIMEOUT
// ==========================================================================

// ⭐⭐ **`WaitForSingleObject` ON A CHILD, AND ALL THREE TIMEOUTS ITS CALLERS ACTUALLY USE.** They are three
// different questions and answering them with one poll is a WRONG ANSWER rather than a slow one — MEASURED:
// with the infinite arm polling once, `StreamingSubprocess.wait()` reported `WAIT_TIMEOUT` for a child that
// was merely still exiting, and `__gt_subp_wait_exit` read that as a fired deadline, KILLED the child and
// threw `SubprocessError.timeout`.
//
//   • **0 — a POLL.** `__gt_proc_check` and `__gt_subp_wait_collect`'s exit test drive their own loop and want
//     the state, not a wait.
//   • **INFINITE — a real block**, inside the wait syscall itself. `__gt_subp_wait` and
//     `__gt_subp_wait_exit(h, 0)` mean "until it exits", and there is nothing to poll for: the kernel already
//     has the notification.
//   • **anything else — a bounded poll.** A deadline neither lane can hand to a POSIX wait, so it is a scan
//     and a millisecond sleep, exactly as the netpoll's multi-wait below does it.
//
// ⚠ **THE INFINITE ARM BLOCKS THE OS THREAD**, which is the same property the blocking pipe read has and for
// the same missing mechanism: without a `SIGCHLD` handler or a netpoll there is nothing for a green thread to
// park on. Its callers have already drained the child's output, so the block is bounded by the child's own
// exit rather than by anything this scheduler owes it.
//
// ⚠ **IT CONTAINS NO OS CALL AT ALL**, which is why one body serves both lanes: two `bl`s and a compare.
export function buildArm64PosixProcAwaitChunk() returns FunctionCodeChunk
	let SlotObj = 0 as StackSize
	let SlotTimeout = 1 as StackSize
	let SlotElapsed = 2 as StackSize
	var asm = Arm64RuntimeAsm.beginFunction(3)

	let bounded = asm.newLabel()
	let boundedStep = asm.newLabel()
	let signalled = asm.newLabel()
	let notSignalled = asm.newLabel()
	let answered = asm.newLabel()

	arm64EmitStoreSlot(asm, reg: Arm64Register.x0, slot: SlotObj)
	arm64EmitStoreSlot(asm, reg: Arm64Register.x1, slot: SlotTimeout)

	// INFINITE: one blocking reap, and the answer cannot be anything but signalled.
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x2, value: WaitInfinite)
	arm64EmitCmpRuntimeReg(asm, lhs: Arm64Register.x1, rhs: Arm64Register.x2)
	arm64EmitCondBranchTo(asm, cond: Arm64CondCode.ne, label: bounded)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x1, value: PosixReapBlocking)
	arm64EmitBranchLink(asm.code, callFixups: asm.callFixups, targetName: HostProcReapName)
	arm64EmitBranchTo(asm, label: signalled)

	// 0 and everything else share one loop: it reaps FIRST and tests the deadline second, so a zero timeout
	// makes exactly one non-blocking reap and then answers.
	asm.placeLabel(bounded)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x2, value: 0)
	arm64EmitStoreSlot(asm, reg: Arm64Register.x2, slot: SlotElapsed)

	asm.placeLabel(boundedStep)
	arm64EmitLoadSlot(asm, reg: Arm64Register.x0, slot: SlotObj)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x1, value: PosixReapWithoutBlocking)
	arm64EmitBranchLink(asm.code, callFixups: asm.callFixups, targetName: HostProcReapName)
	arm64EmitCbnzTo(asm, reg: Arm64Register.x0, label: signalled)
	arm64EmitLoadSlot(asm, reg: Arm64Register.x2, slot: SlotElapsed)
	arm64EmitLoadSlot(asm, reg: Arm64Register.x1, slot: SlotTimeout)
	arm64EmitCmpRuntimeReg(asm, lhs: Arm64Register.x2, rhs: Arm64Register.x1)
	arm64EmitCondBranchTo(asm, cond: Arm64CondCode.ge, label: notSignalled)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x0, value: PosixChildPollMs)
	arm64EmitBranchLink(asm.code, callFixups: asm.callFixups, targetName: HostSleepMsName)
	arm64EmitLoadSlot(asm, reg: Arm64Register.x2, slot: SlotElapsed)
	arm64EmitAddRuntimeImm(asm, dest: Arm64Register.x2, base: Arm64Register.x2, imm: PosixChildPollMs as Imm32)
	arm64EmitStoreSlot(asm, reg: Arm64Register.x2, slot: SlotElapsed)
	arm64EmitBranchTo(asm, label: boundedStep)

	asm.placeLabel(signalled)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x0, value: WaitObject0)
	arm64EmitBranchTo(asm, label: answered)

	asm.placeLabel(notSignalled)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x0, value: WaitTimeout)

	asm.placeLabel(answered)
	return asm.finishFunction(HostProcAwaitName)
end 'buildArm64PosixProcAwaitChunk'

// ==========================================================================
// mrt_host_proc_exit_code(x0 = handle, x1 = codeOutPtr)
// ==========================================================================

// `GetExitCodeProcess`. It BLOCKS if the child has not been reaped yet, which is exactly what its Win32
// twin's callers already guarantee is safe: every one of them has either just seen the handle signalled or is
// `__gt_subp_wait`, whose whole contract is to wait.
//
// ⚠ **A REAP THAT CANNOT HAPPEN LEAVES THE CACHED STATUS UNTOUCHED**, which is 0 for a handle whose child some
// other path already took. Answering the last known status beats inventing one, and there is no route in this
// runtime that reaps a child twice.
export function buildArm64PosixProcExitCodeChunk() returns FunctionCodeChunk
	let SlotCodeOut = 0 as StackSize
	let SlotObj = 1 as StackSize
	var asm = Arm64RuntimeAsm.beginFunction(2)

	arm64EmitStoreSlot(asm, reg: Arm64Register.x1, slot: SlotCodeOut)
	arm64PosixUntagHandle(asm, reg: Arm64Register.x0)
	arm64EmitStoreSlot(asm, reg: Arm64Register.x0, slot: SlotObj)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x1, value: PosixReapBlocking)
	arm64EmitBranchLink(asm.code, callFixups: asm.callFixups, targetName: HostProcReapName)

	arm64EmitLoadSlot(asm, reg: Arm64Register.x1, slot: SlotObj)
	arm64EmitLoadWord64At(asm, dest: Arm64Register.x2, base: Arm64Register.x1, byteOffset: PosixWaitOffChildStatus)
	arm64EmitLoadSlot(asm, reg: Arm64Register.x0, slot: SlotCodeOut)
	arm64EmitStoreWord64At(asm, src: Arm64Register.x2, base: Arm64Register.x0, byteOffset: 0)

	return asm.finishFunction(HostProcExitCodeName)
end 'buildArm64PosixProcExitCodeChunk'

// ==========================================================================
// mrt_host_proc_terminate(x0 = handle, x1 = exitCode)
// ==========================================================================

// `TerminateProcess(h, exitCode)` — `kill(pid, SIGKILL)`, plus the one thing POSIX cannot carry across a
// signal: the CODE the caller named. It is recorded in the object first, so the reap that follows reports it
// instead of decoding `128 + SIGKILL` from the status. See `PosixSignalExitCodeBase`.
export function buildArm64PosixProcTerminateChunk(kill PosixHostCall) returns FunctionCodeChunk
	var asm = Arm64RuntimeAsm.beginFunction(0)

	arm64PosixUntagHandle(asm, reg: Arm64Register.x0)
	arm64EmitStoreWord64At(asm, src: Arm64Register.x1, base: Arm64Register.x0, byteOffset: PosixWaitOffChildStatus)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x2, value: PosixChildSignalled)
	arm64EmitStoreWord64At(asm, src: Arm64Register.x2, base: Arm64Register.x0, byteOffset: PosixWaitOffChildKilled)

	arm64EmitLoadWord64At(asm, dest: Arm64Register.x0, base: Arm64Register.x0, byteOffset: PosixWaitOffChildPid)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x1, value: PosixSigKill)
	arm64PosixEmitHostCall(asm, call: kill)

	return asm.finishFunction(HostProcTerminateName)
end 'buildArm64PosixProcTerminateChunk'

// ==========================================================================
// mrt_host_wait_any(x0 = handlesBase, x1 = count, x2 = timeoutMs)
// ==========================================================================

// ⭐ `WaitForMultipleObjects(handles, count, FALSE, timeoutMs)` — the NETPOLL's block on the parked children.
// Its answer is DISCARDED by the one caller (`GtRuntime.emitProcWait` re-scans through `__gt_proc_check`
// straight afterwards), so this reports nothing and only has to RETURN at the right moment: as soon as any
// child has exited, or when the timeout runs out.
//
// ⚠ **IT POLLS, AND POLLING IS THE RIGHT ANSWER HERE RATHER THAN A COMPROMISE.** The alternative is a
// `SIGCHLD` handler, and this backend installs no signal handlers at all (`Arm64Runtime`'s header). Blocking
// the M is what the netpoll is FOR — it runs only when nothing is runnable — so a millisecond scan costs an
// idle thread a syscall per millisecond and nothing else.
//
// ⚠ **A ZERO COUNT WITH AN INFINITE TIMEOUT WOULD NEVER RETURN**, and cannot arise: `emitProcWait` is reached
// only under `pc > 0`.
export function buildArm64PosixWaitAnyChunk() returns FunctionCodeChunk
	let SlotBase = 0 as StackSize
	let SlotCount = 1 as StackSize
	let SlotTimeout = 2 as StackSize
	let SlotElapsed = 3 as StackSize
	let SlotIndex = 4 as StackSize
	var asm = Arm64RuntimeAsm.beginFunction(5)

	let scanRound = asm.newLabel()
	let scanStep = asm.newLabel()
	let scanned = asm.newLabel()
	let sleepStep = asm.newLabel()
	let done = asm.newLabel()

	arm64EmitStoreSlot(asm, reg: Arm64Register.x0, slot: SlotBase)
	arm64EmitStoreSlot(asm, reg: Arm64Register.x1, slot: SlotCount)
	arm64EmitStoreSlot(asm, reg: Arm64Register.x2, slot: SlotTimeout)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x3, value: 0)
	arm64EmitStoreSlot(asm, reg: Arm64Register.x3, slot: SlotElapsed)

	asm.placeLabel(scanRound)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x3, value: 0)
	arm64EmitStoreSlot(asm, reg: Arm64Register.x3, slot: SlotIndex)

	asm.placeLabel(scanStep)
	arm64EmitLoadSlot(asm, reg: Arm64Register.x4, slot: SlotIndex)
	arm64EmitLoadSlot(asm, reg: Arm64Register.x1, slot: SlotCount)
	arm64EmitCmpRuntimeReg(asm, lhs: Arm64Register.x4, rhs: Arm64Register.x1)
	arm64EmitCondBranchTo(asm, cond: Arm64CondCode.ge, label: scanned)
	arm64EmitLslImm(asm.code, rd: arm64RuntimeReg(Arm64Register.x5), rn: arm64RuntimeReg(Arm64Register.x4), sh: PosixHandleArrayStrideShift)
	arm64EmitLoadSlot(asm, reg: Arm64Register.x0, slot: SlotBase)
	arm64EmitAddRuntimeReg(asm, dest: Arm64Register.x0, lhs: Arm64Register.x0, rhs: Arm64Register.x5)
	arm64EmitLoadWord64At(asm, dest: Arm64Register.x0, base: Arm64Register.x0, byteOffset: 0)
	arm64PosixUntagHandle(asm, reg: Arm64Register.x0)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x1, value: PosixReapWithoutBlocking)
	arm64EmitBranchLink(asm.code, callFixups: asm.callFixups, targetName: HostProcReapName)
	arm64EmitCbnzTo(asm, reg: Arm64Register.x0, label: done)
	arm64EmitLoadSlot(asm, reg: Arm64Register.x4, slot: SlotIndex)
	arm64EmitAddRuntimeImm(asm, dest: Arm64Register.x4, base: Arm64Register.x4, imm: 1)
	arm64EmitStoreSlot(asm, reg: Arm64Register.x4, slot: SlotIndex)
	arm64EmitBranchTo(asm, label: scanStep)

	asm.placeLabel(scanned)
	arm64EmitLoadSlot(asm, reg: Arm64Register.x2, slot: SlotTimeout)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x3, value: WaitInfinite)
	arm64EmitCmpRuntimeReg(asm, lhs: Arm64Register.x2, rhs: Arm64Register.x3)
	arm64EmitCondBranchTo(asm, cond: Arm64CondCode.eq, label: sleepStep)
	arm64EmitLoadSlot(asm, reg: Arm64Register.x3, slot: SlotElapsed)
	arm64EmitCmpRuntimeReg(asm, lhs: Arm64Register.x3, rhs: Arm64Register.x2)
	arm64EmitCondBranchTo(asm, cond: Arm64CondCode.ge, label: done)

	asm.placeLabel(sleepStep)
	arm64EmitMovRuntimeImm(asm, dest: Arm64Register.x0, value: PosixChildPollMs)
	arm64EmitBranchLink(asm.code, callFixups: asm.callFixups, targetName: HostSleepMsName)
	arm64EmitLoadSlot(asm, reg: Arm64Register.x3, slot: SlotElapsed)
	arm64EmitAddRuntimeImm(asm, dest: Arm64Register.x3, base: Arm64Register.x3, imm: PosixChildPollMs as Imm32)
	arm64EmitStoreSlot(asm, reg: Arm64Register.x3, slot: SlotElapsed)
	arm64EmitBranchTo(asm, label: scanRound)

	asm.placeLabel(done)
	return asm.finishFunction(HostWaitAnyName)
end 'buildArm64PosixWaitAnyChunk'
