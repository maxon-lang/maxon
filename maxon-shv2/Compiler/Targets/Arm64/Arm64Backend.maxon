// Arm64Backend — the arm64 half of the Phase-7 backend: Std → arm64 Target ops → register
// allocation → arm64 prologue/epilogue → runtime augmentation → machine-code emission → CodeResult.
//
// This is the arm64 twin of `X64Backend`: `emitArm64FunctionChunk` maps each colored `TargetOp`
// (its neutral `RegNum` operands resolved to an `Arm64Register`) to its 32-bit AArch64 encoding,
// `concatArm64FunctionChunks` lays the chunks out into `.text` and resolves the intra-module `bl`
// and code→data relocations, and `buildArm64Backend` drives the shared pipeline stages. The
// ISA-specific traps the M1 notes list live HERE: the ADRP+ADD address-materialisation pair (never
// a bare ADR), the STUR simm9 / scaled-STR spill threshold, the movz/movk immediate ladder, the
// NaN-safe float compare's condition mapping, and the SP-vs-XZR MOV disambiguation.
//
// ⚠ CLASS DETECTION IS PER-ISA, AND `regClassOf` DOES NOT SERVE HERE. `regClassOf` splits at the
// x64 boundary (`FirstXmmRegisterNumber` = 16); on arm64 that would misread x19..x28 (colored GPRs)
// as SIMD. The arm64 boundary is `arm64RegisterFile().firstVector` (31) — GPRs are RegNum 0..30,
// the SIMD file d0..d31 is 31..62 — so every class question here is asked against that boundary
// (`arm64VRegIsGpr`), never against the shared `regClassOf`.

// ==========================================================================
// AArch64 instruction encoding primitives
// ==========================================================================

// A single 32-bit AArch64 instruction word, little-endian. Every encoder below funnels through here
// so the byte order is spelled once.
function emitArm64Insn(code ByteArray, insn MachineWord)
	writeDword(code, value: insn)
end 'emitArm64Insn'

// The AArch64 register-field bit positions. Rd is the low 5 bits; Rn, Rm and Rt2 sit at their fixed
// offsets in every data-processing form, so the R-R-R / R-R encoders spell the layout once here.
let Arm64RnShift = 5
let Arm64RmShift = 16
let Arm64Rt2Shift = 10

// The base register field in a load/store / frame op names SP as 31 (the same field value XZR takes
// in a data-processing op — context, not the number, tells them apart; see the MOV-involving-SP note
// on `arm64Prologue`). x29/x30 are the frame-record pair.
let Arm64SpBaseField = 31

// EXPORTED as a `RegNum` twin (`Arm64FramePointerRegNum`) because the prologue pass builds a real
// `[x29 + disp]` load when it resolves an incoming stack argument, and a second literal 29 over there
// would be this fact written down twice.
let Arm64Fp = 29
export let Arm64FramePointerRegNum = Arm64Fp as RegNum
let Arm64Lr = 30

// The IP scratch registers (x16/x17) — never in the allocatable pool, so the encoder clobbers them
// freely for immediate materialisation, the `xchg` cycle-break and the ADRP scratch of a float load.
let Arm64Ip0 = 16

// x17 — the second intra-procedure-call scratch register (IP1), outside the arm64 allocatable pool. The
// jump table holds the table base then the computed target address in it; x16 (Arm64Ip0) holds the case
// count then the loaded slot entry. Both are declared clobbered by `arm64JumpTable`'s implicitDefs.
//
// It is ALSO the base a frame reference past the scaled load/store field folds into — deliberately not
// x16, which the isel mints spliceable producer/consumer pairs in (`arm64EmitWideFrameSlot` carries that
// argument). EXPORTED as a `RegNum` twin for the same reason `Arm64FramePointerRegNum` is: the prologue
// pass builds a real `add x17, x29, #hi` op for a wide incoming stack argument, and a second literal 17
// over there would be this fact written down twice.
let Arm64Ip1 = 17
export let Arm64Ip1RegNum = Arm64Ip1 as RegNum

// A 3-register data-processing instruction `op Rd, Rn, Rm` — the shape ADD/SUB/MUL/AND/ORR/… share.
export function emitArm64Rrr(code ByteArray, opcode MachineWord, rd MachineWord, rn MachineWord, rm MachineWord)
	emitArm64Insn(code, insn: opcode or (rm shl Arm64RmShift) or (rn shl Arm64RnShift) or rd)
end 'emitArm64Rrr'

// A 2-register instruction `op Rd, Rn` (NEG/MVN/FMOV/SCVTF/FCVTZS/FSQRT/FRINT and the ORR-based
// MOV) — Rm is fixed in the opcode (XZR for NEG/MVN, none for the FP unary/convert forms).
function emitArm64Rr(code ByteArray, opcode MachineWord, rd MachineWord, rn MachineWord)
	emitArm64Insn(code, insn: opcode or (rn shl Arm64RnShift) or rd)
end 'emitArm64Rr'

// The `FRINT<r>` word for a rounding mode — the arm64 half of the mapping x64's `roundsdImm8` is the
// other half of, and the ONE place the target-neutral `FloatRoundMode` becomes AArch64 bits.
function arm64FrintOpcode(mode FloatRoundMode) returns MachineWord
	let rmode = match mode 'm'
		nearestTiesToEven gives Arm64FrintRmodeNearest
		towardNegative gives Arm64FrintRmodeDown
		towardPositive gives Arm64FrintRmodeUp
	end 'm'
	return Arm64OpFrintDBase or (rmode shl Arm64FrintRmodeShift)
end 'arm64FrintOpcode'

// --- Data-processing (register) base opcodes, 64-bit ---
export let Arm64OpAdd = 0x8B000000
export let Arm64OpSub = 0xCB000000
export let Arm64OpMul = 0x9B007C00
let Arm64OpSdiv = 0x9AC00C00
export let Arm64OpUdiv = 0x9AC00800
export let Arm64OpAnd = 0x8A000000
export let Arm64OpOrr = 0xAA000000
let Arm64OpEor = 0xCA000000
let Arm64OpLslv = 0x9AC02000
let Arm64OpAsrv = 0x9AC02800
let Arm64OpLsrv = 0x9AC02400

// MSUB Xd, Xn, Xm, Xa => Xd = Xa - Xn*Xm (the remainder builder). Ra sits at bit 10.
let Arm64OpMsub = 0x9B008000
let Arm64MsubRaShift = 10

// --- F2: the ARMv8.0 exclusive-access pair, and the Darwin thread pointer ---
//
// ⭐⭐ **LDAXR/STLXR ARE A RESERVATION, NOT A LOCK, WHICH IS WHY EVERY USE IS A RETRY LOOP.** `LDAXR`
// loads and marks the address as exclusively reserved for this core; `STLXR` stores ONLY IF the
// reservation still holds and reports whether it did in its status register. Anything that can clear a
// reservation — another core's store, an interrupt, even an unrelated exclusive access — makes the store
// fail, so the loop must go round again. A single unretried STLXR is not an atomic operation; it is a
// store that sometimes does nothing.
//
// The two are also the ORDERING: `LDAXR` is load-ACQUIRE and `STLXR` is store-RELEASE, which is what lets
// `StdOp.atomicCas` promise a Treiber-stack publish needs no separate fence.
//
// `LDAXR Xt, [Xn]` — 64-bit, no offset form.
let Arm64OpLdaxr = 0xC85FFC00

// `STLXR Ws, Xt, [Xn]` — the STATUS register `Ws` sits in the Rs field at bit 16 (0 = stored, 1 = failed).
// ⚠ `Ws` must differ from BOTH `Xt` and `Xn`; sharing them is CONSTRAINED UNPREDICTABLE. The two encoders
// below hold that by construction — the status is always x17 and the other two are x16 or an allocatable
// register, and x17 is in neither pool.
let Arm64OpStlxr = 0xC800FC00
let Arm64StlxrRsShift = 16

// `MRS Xt, TPIDRRO_EL0` — the READ-ONLY thread ID register. On Darwin the kernel points it at the current
// thread's TSD base and stores the CPU number in the low three bits, which is why the read is masked.
let Arm64OpMrsTpidrro = 0xD53BD060

// ⭐⭐ **`MRS Xt, TPIDR_EL0` / `MSR TPIDR_EL0, Xt` — THE WRITABLE THREAD POINTER, AND arm64-LINUX OWNS IT
// OUTRIGHT (L4).** The three words differ from the pair above only in `op2` (2 rather than 3) and, for the
// write, in the L bit (0xD53 ⇒ 0xD51). ⚠ **This block used to say the register "is not set at all on shv2's
// raw-static Linux lane"; that was true and is the REASON it became this lane's, not an argument against it.**
// A static image links no libc, so nothing else on Linux reads or writes TPIDR_EL0 — which makes it the one
// per-OS-thread word the scheduler may define for itself, and `mrt_host_tls_alloc` does
// (`Arm64LinuxRuntime`). `StdOp.currentThreadToken` still takes `gettid` there rather than this register: an
// identity must be non-zero on EVERY thread, including one that never asked the scheduler for a slot.
let Arm64OpMrsTpidr = 0xD53BD040
let Arm64OpMsrTpidr = 0xD51BD040

// `LDR Xt, [Xn, Xm, LSL #0]` — the register-offset 64-bit load (size=11, opc=01, option=011 LSL, S=0).
// MAC3's Darwin TSD read is its only producer; every other access in this compiler has an immediate
// displacement.
let Arm64OpLdrRegOffset = 0xF8606800

// `CSEL Xd, Xn, Xm, cond` (64-bit). The condition rides bits 15..12 — `Arm64CondFieldShift`, the same field
// the `FCSEL` and `CSINC` forms below carry it in.
let Arm64OpCsel = 0x9A800000

// The CPU number Darwin packs into TPIDRRO_EL0's low bits, cleared by a shift-down/shift-up pair. Three
// bits, so the thread pointer itself is 8-byte aligned — which is what makes the masking lossless.
let Arm64ThreadPointerCpuBits = 3

// MOV Xd, Xn is ORR Xd, XZR, Xn — the register move both files' `movRegReg` lowers to (GPR side).
let Arm64OpMovReg = 0xAA0003E0

// ORN Xd, XZR, Xn = MVN Xd, Xn. NEG Xd, Xn is SUB Xd, XZR, Xn (reuses `Arm64OpSub`). Both read their
// SOURCE through the Rm field (bit 16) with XZR in the Rn field — the zero register is NOT folded into
// the opcode, so the source must land at Rm, not Rn.
let Arm64OpOrn = 0xAA200000

// The XZR register field value in a data-processing op (31 — the same field value SP takes in a
// load/store base, context deciding which; named apart from `Arm64SpBaseField` for readability).
let Arm64XzrField = 31

// --- Data-processing (immediate) ---
let Arm64OpAddImm = 0x91000000
export let Arm64OpSubImm = 0xD1000000
let Arm64ImmShift = 10

// The WIDTH of the imm12 field. It is TWO facts in one number and they cannot be allowed to drift: how
// many bits the field holds, and how far the `sh` bit below shifts it — so the mask and the hi/lo split's
// shift are both derived from it rather than each written as a literal.
let Arm64Imm12FieldBits = 12
let Arm64ImmMask = (1 shl Arm64Imm12FieldBits) - 1

// The `sh` bit (22): a set `sh` shifts the 12-bit immediate left by 12, extending ADD/SUB-immediate
// reach to a full 24-bit frame/offset in a hi/lo split.
let Arm64ImmShiftHiBit = 0x400000

// The largest value the SHIFTED imm12 field alone carries — `0xFFF000`. Derived from the plain field
// rather than written out, because the two are one fact seen at two shifts: widen `Arm64ImmMask` and a
// derived ceiling follows while a literal silently would not.
let Arm64ShiftedImm12Max = Arm64ImmMask shl Arm64Imm12FieldBits

// The bitmask-immediate logical ops (AND/ORR/EOR #bimm). N:immr:imms occupy bits 22:10.
let Arm64OpAndImm = 0x92000000
let Arm64OpOrrImm = 0xB2000000
let Arm64OpEorImm = 0xD2000000
let Arm64LogicalNShift = 22
let Arm64LogicalImmrShift = 16
let Arm64LogicalImmsShift = 10

// The constant-shift bitfield ops. LSL/LSR are UBFM aliases, ASR is an SBFM alias; immr:imms at 21:10.
let Arm64OpUbfm = 0xD3400000
let Arm64OpSbfm = 0x93400000
let Arm64BitfieldImmrShift = 16
let Arm64BitfieldImmsShift = 10
let Arm64WordBitMax = 63

// The machine word is 64 bits wide — the iteration cap of the leading/trailing bit-count loops.
let Arm64WordBits = 64

// ⭐ **THE SHIFT THAT WIDENS A 32-BIT C RESULT INTO THE 64-BIT VALUE THE Std TIER READS.** AAPCS64
// leaves the UPPER half of a register holding an `int` return UNSPECIFIED, so a libSystem call that
// answers `int` — `getpid`, `getpriority`, `_NSGetExecutablePath` — must be widened at the call site
// before its answer is a number: `lsl #32` then `asr #32` sign-extends it, and `lsl #32` alone is
// enough when all that follows is a test against zero. EXPORTED because the isel spells that in
// `TargetOp`s and a runtime chunk spells it in raw encoders, and neither may pick its own 32.
export let Arm64NarrowResultShift = 32

// The 64-bit word's sign bit (bit 63), as an UNSIGNED `MachineWord` — the number 9223372036854775808,
// which is what both readers below want: a mask to `and` against, and the threshold above which an
// unsigned displacement denotes a negative one.
//
// ⛔ **IT WAS SPELLED `i64.min as MachineWord`, AND THAT IS THE ONE SPELLING THIS CONSTANT MAY NOT
// HAVE.** `i64.min` denotes −9223372036854775808; `MachineWord` is `int(0 to u64.max)` and declares
// `≥ 0`. The two share a bit pattern and nothing else, and the compile-time range check now says so
// (E3005) — this was the ONE site in the whole tree the new refusal caught, and it was found by
// shv2's self-compile rather than by any suite. The hex literal is the honest spelling: a
// NON-NEGATIVE number whose pattern happens to have bit 63 set, which is exactly what it is.
//
// ⚠ The comment this replaces argued for `i64.min` on the grounds that "the bootstrap types that
// `>i64.max` literal as a SIGNED i64, and a `shr` on a signed value is ARITHMETIC (sign-filling),
// which is the trap that made the old `arm64CountLeadingOnes` loop forever". That trap is about a
// value with NO declared range: the shift rule reads the DECLARED type, and `as MachineWord` supplies
// a non-negative one whichever way the number is written. `arm64CountLeadingOnes` has since stopped
// shifting a mask at all — it shifts the VALUE left, which is 0-filling — so neither half of the
// argument reaches this line. MEASURED: the self-compile and both suites are green with the hex.
let Arm64WordSignBit = 0x8000000000000000 as MachineWord

// --- Move-wide immediate (movz/movk ladder) ---
let Arm64OpMovz = 0xD2800000
let Arm64OpMovk = 0xF2800000
let Arm64MoveWideHwShift = 21
let Arm64MoveWideImm16Shift = 5
let Arm64HalfwordBits = 16
let Arm64HalfwordMask = 0xFFFF

// --- Compare (SUBS/ADDS into XZR) ---
let Arm64OpCmpReg = 0xEB00001F

// `CMP Xn, #imm` IS `SUBS XZR, Xn, #imm` and `CMN Xn, #imm` IS `ADDS XZR, Xn, #imm` — so the two are
// named as what they encode and go through the SAME `arm64EmitAddSubImm12` field builder every other
// immediate form uses, with XZR in the Rd field. (The register compare above keeps its baked-in `1F`:
// it is a 2-register form with no field builder to share.)
//
// ⭐ CMN IS WHY A NEGATIVE COMPARE-IMMEDIATE HAS A FORM AT ALL. `x − (−m)` IS `x + m`: the same 64-bit
// result, so the same NZCV — including the carry the UNSIGNED conditions read, since subtracting `K`
// computes `x + not K + 1` and for `K = −m` that is `x + m` with the identical carry out. Without it a
// comparison against `-1` costs a FOUR-instruction movz/movk ladder (all four halfwords of the two's
// complement are live) plus a register compare.
let Arm64OpSubsImm = 0xF1000000
let Arm64OpAddsImm = 0xB1000000

// CSET Xd, cond = CSINC Xd, XZR, XZR, invert(cond). The condition field is at bit 12; CSET inverts
// the condition it is given (the true value comes from the +1 of XZR).
let Arm64OpCsinc = 0x9A9F07E0
let Arm64CondFieldShift = 12
let Arm64CondInvertBit = 0x1

// --- Branches ---
let Arm64OpB = 0x14000000
let Arm64OpBl = 0x94000000
let Arm64OpBcond = 0x54000000
let Arm64OpCbz = 0xB4000000
let Arm64OpCbnz = 0xB5000000
let Arm64OpBlr = 0xD63F0000

// BR Xn — register-indirect branch (the jump table's computed-target jump). `0xD61F0000 | (Rn << 5)`.
let Arm64OpBr = 0xD61F0000

// LDRSW Xt, [Xn, Xm, LSL #2] — sign-extend a 32-bit word loaded from `[Xn + Xm*4]` into a 64-bit Xt (the
// jump table's signed i32 slot load). `0xB8A07800 | (Rm << 16) | (Rn << 5) | Rt`.
let Arm64OpLdrswRegLsl2 = 0xB8A07800

// The SHIFT AMOUNT field (imm6, bits 15-10) of a DATA-PROCESSING SHIFTED-REGISTER form —
// `ADD Xd, Xn, Xm, LSL #amount`, EC16's scaled-index address computation. It sits at the same bit
// position as `Arm64ImmShift` and is a DIFFERENT field of a DIFFERENT instruction (that one is the
// imm12 of ADD/SUB-immediate), so it is named separately rather than shared: an encoding coincidence
// is not a fact, and merging the two would make a change to either silently move the other.
//
// The SHIFT TYPE (bits 23-22) stays 00 = LSL, which is `Arm64OpAdd`'s own base value — the only type
// an address scale can want.
let Arm64ShiftedRegAmountShift = 10

// RET returns through x30 (LR); the LR is baked into this fully-formed encoding.
let Arm64OpRet = 0xD65F03C0

// BRK #0 — a software breakpoint (raises SIGTRAP, terminating the process); the entry stub's guard
// after the exit primitive. imm16 is 0 (the conventional abort breakpoint), baked into this
// fully-formed word.
let Arm64OpBrk = 0xD4200000

// SVC #0 — the Linux supervisor call. imm16 is 0 (AArch64 Linux ignores it and reads the syscall
// number from x8), baked into this fully-formed word. NEVER emitted for macOS, which forbids raw
// syscalls and routes every OS primitive through a libSystem GOT import instead.
let Arm64OpSvc = 0xD4000001

// x8 — where the AArch64 Linux syscall ABI reads the syscall number from. It is inside the
// caller-saved half `arm64Syscall`'s call clobber declares, so writing it here forbids nothing.
let Arm64SyscallNumberReg = 8
let Arm64Imm26Mask = 0x3FFFFFF
let Arm64Imm19Mask = 0x7FFFF
let Arm64Imm19Shift = 5

// --- Address materialisation (ADRP + ADD/LDR) ---
let Arm64OpAdrp = 0x90000000

// --- Loads / stores ---
// Scaled unsigned-offset forms (imm12 * transfer size). Xn = base, Rt = data reg.
export let Arm64OpStrX = 0xF9000000
export let Arm64OpLdrX = 0xF9400000

// LDR Wt, [Xn, #imm12*4] — a 32-bit load, which ZERO-EXTENDS into the full X register. The
// `__symtable` columns are u32, so the panic runtime reads them with this and never with a
// 64-bit load (which would drag in the neighbouring column) or a sign-extending one.
export let Arm64OpLdrW = 0xB9400000

// STR Wt, [Xn, #imm12*4] — the 32-bit STORE twin, and it exists because a C `int` really is four
// bytes: the Darwin host surface publishes `errno` through `*__error()`, and a 64-bit store there
// would write four bytes past a field the C library owns.
export let Arm64OpStrW = 0xB9000000
let Arm64OpStrD = 0xFD000000
let Arm64OpLdrD = 0xFD400000

// STRB Wt / LDRB Wt, [Xn, #imm12] — the byte pair, EXPORTED because a runtime chunk assembles a C
// string one byte at a time (`Arm64RuntimeAsm`'s `arm64EmitLoadByte`/`arm64EmitStoreByte`) and this
// file's declarations are otherwise file-private.
export let Arm64OpStrB = 0x39000000
export let Arm64OpLdrB = 0x39400000
let Arm64LoadStoreImm12Shift = 10
let Arm64LoadStoreImm12Mask = 0xFFF

// An `LDRB`/`STRB` transfers one byte, so its imm12 field counts bytes — the scale that makes the byte
// forms an ordinary case of the scaled builder (`arm64AccessScale`) rather than a hand-written second
// range check that could come to disagree with the ISEL's predicate.
let Arm64ByteAccessScale = 1

// Unscaled signed-offset forms (STUR/LDUR, simm9 at bit 12, ±256). Below the 256-byte threshold a
// spill/reload uses these; at or above it the scaled form is MANDATORY — STUR's 9-bit field silently
// truncates any offset ≥ 256 and would spill to the wrong slot (M1 trap).
//
// ⚠ BITS 31:30 ARE THE SIZE FIELD, AND FOR THE FP PAIR THEY MUST BE `11` (64-bit D), NOT `10` (32-bit
// S). The two spellings differ in ONE HEX DIGIT and BOTH ASSEMBLE, so the wrong one is not a crash —
// it is a `stur s0` where a `stur d0` was meant, which writes the low HALF of the double and leaves
// the reload to invent the rest. A spilled `9.0` (0x4022000000000000) round-trips as its low word,
// which is 0x00000000, i.e. **0.0** — a silently wrong ANSWER with no fault to find it by. It hid
// because the SCALED forms below (`Arm64OpStrD`/`Arm64OpLdrD`, size=11) were always correct and the
// unscaled pair is chosen only under the 256-byte threshold, which is where nearly every frame lives.
// The same truncation hits the callee-saved d8–d15 preserve/restore, so a callee destroys the top
// half of a double its CALLER left there and never touched itself. The spill half is pinned by
// `register-spill/a-reload-inherits-its-victims-register-file`; the callee-save half was pinned by
// NOTHING and is now `register-spill/callee-saved-double-survives-a-callee`.
let Arm64OpSturX = 0xF8000000
let Arm64OpLdurX = 0xF8400000
let Arm64OpSturD = 0xFC000000
let Arm64OpLdurD = 0xFC400000
let Arm64UnscaledImm9Shift = 12
let Arm64UnscaledImm9Mask = 0x1FF
let Arm64UnscaledSpillThreshold = 256

// --- Frame-record pair (STP/LDP) ---
// Pre/post-indexed frame-record forms and the plain signed-offset forms. imm7 is signed, scaled by 8.
let Arm64OpStpPreX = 0xA9800000
let Arm64OpLdpPostX = 0xA8C00000
let Arm64OpStpOffX = 0xA9000000
let Arm64OpLdpOffX = 0xA9400000

// ⭐ **THE SIMD&FP TWINS (MAC3), FOR THE GREEN-THREAD CONTEXT SWITCH.** Same instruction class, `V=1` and
// `opc=01` (the 64-bit D form): `STP Dt1, Dt2, [Xn, #imm]!` and `LDP Dt1, Dt2, [Xn], #imm`. The imm7 field
// and its scale are IDENTICAL to the X forms above — a D register is 8 bytes too — which is why
// `arm64EmitPairOffset` serves all four with no width parameter.
//
// ⚠ They exist because d8..d15 are CALLEE-SAVED and the switch must preserve exactly what a call preserves.
// The ordinary prologue spills them to frame slots one at a time (`Arm64PrologueEpilogue`'s header says why);
// the switch cannot, having no frame — it lays a fixed 160-byte block whose size `__gt_spawn` must byte-match.
let Arm64OpStpPreD = 0x6D800000
let Arm64OpLdpPostD = 0x6CC00000

let Arm64PairImm7Shift = 15
let Arm64PairImm7Mask = 0x7F

// The STP/LDP imm7 counts units of ONE transferred register (8 bytes for the X forms), not bytes — the
// scale the frame record's offset and the fill ladder's pair displacements both divide by.
let Arm64PairScaleBytes = 8

// The STP pre-index / LDP post-index imm7 reaches -512..+504 (scaled by 8). The smaller bound
// governs both so one threshold decides the compact-vs-split frame form (M1 trap: larger frames use
// a SUB-sp split).
let Arm64FramePairIndexMax = 504

// --- Floating-point (double precision — the scalar core's only float width) ---
let Arm64OpFaddD = 0x1E602800
let Arm64OpFsubD = 0x1E603800
let Arm64OpFmulD = 0x1E600800
let Arm64OpFdivD = 0x1E601800
let Arm64OpFcmpD = 0x1E602000
let Arm64OpScvtfD = 0x9E620000
let Arm64OpFcvtzsD = 0x9E780000
let Arm64OpFmovD = 0x1E604000

// ⭐ `FMOV Xd, Dn` (P1.7a's last slice) — the GENERAL↔VECTOR 64-bit transfer, `float.hash`'s bit
// reinterpretation. It is a DIFFERENT instruction from `Arm64OpFmovD` above, which is `FMOV Dd, Dn`,
// an FP→FP copy: this one's `rmode=00, opcode=110` names the vector-to-general direction and its
// `sf=1, ftype=01` the 64-bit width. Reusing the FP→FP word here would assemble a copy between two FP
// registers and leave the GPR untouched — legal bytes, silently wrong answer. The word matches
// `maxon-selfhosted`'s Arm64CodeEmitter.maxon:2144-2163.
let Arm64OpFmovGprFromFp = 0x9E660000

// ⭐ `FMOV Dd, Xn` — the SAME general↔vector transfer read the other way, `bitcastI64ToF64`'s
// instruction. `opcode` is 111 rather than 110 and every other field is identical, so the two words are
// 0x00010000 apart: `sf=1, ftype=01, rmode=00, opcode=111`. Written as a second CONSTANT rather than as
// the first one with a bit set at the call site — a direction is a name, not an arithmetic adjustment,
// and a poked bit is exactly the kind of thing that reads as correct while pointing the wrong way.
let Arm64OpFmovFpFromGpr = 0x9E670000

// The MATH INTRINSICS (P1.0d.4-C). `FSQRT Dd, Dn` is its own opcode; the three roundings are ONE
// instruction, `FRINT<r> Dd, Dn`, whose rounding rides a 3-bit `rmode` field at [17:15] — so the
// base opcode is written once and `arm64FrintOpcode` ORs in the mode. (Spelling the three as three
// full constants would state the shared 29 bits three times, and the ROUNDING is the only thing
// that differs.)
//
// The resulting words are the ones the references pin: `frintn` 0x1E644000, `frintp` 0x1E64C000,
// `frintm` 0x1E654000 (maxon-sharp ARM64CodeEmitter.cs), and `fsqrt` 0x1E61C000.
//
// `FABS Dd, Dn` 0x1E60C000 joins them with `specs/abs.md` — another plain FP-to-FP 2-register form, and
// the same word the bootstrap emits (ARM64CodeEmitter.cs:453). ⚠ It is the intrinsic x64 has NO
// instruction for; that asymmetry lives in `TargetOp.absF64RegReg` and reaches nothing here.
let Arm64OpFsqrtD = 0x1E61C000
let Arm64OpFabsD = 0x1E60C000

// `FNEG Dd, Dn` 0x1E614000 — the same FP-to-FP 2-register form as `fabs` (opcode field 000010 where
// `fabs` is 000001 and `fsqrt` 000011), and the instruction `StdUnaryOpcode.fneg` IS here. The word
// matches `maxon-selfhosted`'s `arm64EmitFneg`. ⚠ Like `fabs`, it is an instruction x64 lacks; that
// asymmetry lives in `TargetOp.negF64RegReg` and reaches nothing here.
let Arm64OpFnegD = 0x1E614000
let Arm64OpFrintDBase = 0x1E644000
let Arm64FrintRmodeShift = 15
let Arm64FrintRmodeNearest = 0  // frintn — to nearest, TIES TO EVEN
let Arm64FrintRmodeUp = 1  // frintp — toward +inf (`ceil`)
let Arm64FrintRmodeDown = 2  // frintm — toward -inf (`floor`)

// `FCSEL Dd, Dn, Dm, cond` 0x1E600C00 — the double-precision conditional select, and the second half
// of `min` on this target (`fcmp` sets the flags, this reads them). Its condition sits in the SAME
// 4-bit field at bit 12 that `CSET` uses, so it reuses `Arm64CondFieldShift` — but UNLIKE `CSET` it
// does NOT invert: `fcsel` picks `Dn` when the condition HOLDS, which is the direct reading, so the
// isel's `mi` is encoded verbatim. Getting that backwards would answer `max`.
//
// ⚠ shv2 emits this pair where both reference compilers emit the single `fmin` (0x1E605800), and that
// is deliberate: `fmin` computes a different function on NaN and on ±0. See `TargetOp.arm64Fcsel`.
let Arm64OpFcselD = 0x1E600C00

// Vector EOR (8B) — a scratch-free three-instruction register SWAP for a SIMD pair, the `xchg`
// cycle-break's float arm (AArch64 has no `fmov`-based swap and no reserved FP scratch, exactly as
// x64 has no `xchg xmm` and swaps XMMs with a triple-xorpd).
let Arm64OpEorVec8b = 0x2E201C00

// The largest immediate `arm64EmitAddSubImmWide`'s hi/lo split encodes — 24 bits, as two imm12 fields,
// which is exactly the two fields above OR'd together. It bounds BOTH of that helper's callers, and they
// answer an over-large value differently: the ALU add/sub-immediate has a REGISTER form to fall back to,
// so its isel asks `arm64ImmIsEncodableAddSub` and never selects the immediate form for a wider constant;
// a FRAME past this has no encodable form at all (SP cannot be a shifted-register operand), so the split
// panics rather than truncate.
let Arm64AddSubImmWideMax = Arm64ShiftedImm12Max or Arm64ImmMask

// The reach of a `b`/`bl` (imm26 scaled by 4 = ±128 MiB) and of a `b.cond`/`cbz`/`cbnz` (imm19 scaled
// by 4 = ±1 MiB), as byte counts. Guarded on resolution so an out-of-range branch is a loud link
// error, never a silently wrapped displacement.
let Arm64BranchByteReach = 0x8000000
let Arm64CondBranchByteReach = 0x100000

// ==========================================================================
// Register resolution (colored RegNum → AArch64 register field)
// ==========================================================================

// The `RegNum` a colored operand carries. A virtual reg here is an allocator bug — register
// allocation colors every operand before emission.
function arm64ResolveRegNum(vreg TargetVReg) returns RegNum
	match vreg 'resolve'
		physical(reg) then return reg
		virtual(id) then panic("arm64 emitter: unresolved virtual register v{id} — register allocation did not color it before emission")
	end 'resolve'
end 'arm64ResolveRegNum'

// True when a colored `RegNum` names a GPR (x0..x30 = 0..30) rather than a SIMD register (d0..d31 =
// 31..62). The boundary is the arm64 file's `firstVector`, NOT `regClassOf`'s x64 one. Read as the
// `Arm64FirstVectorRegister` CONSTANT, never `arm64RegisterFile().firstVector`: this is the encoder's
// per-operand hot path, and building a `RegisterFile` here to read one constant allocated a throwaway
// heap object on every operand of every op (see `Arm64FirstVectorRegister`).
function arm64RegNumIsGpr(reg RegNum) returns bool
	return reg < Arm64FirstVectorRegister
end 'arm64RegNumIsGpr'

function arm64VRegIsGpr(vreg TargetVReg) returns bool
	return arm64RegNumIsGpr(arm64ResolveRegNum(vreg))
end 'arm64VRegIsGpr'

// The GPR field value (0..30) of a colored operand, panicking if it is a SIMD register — the arm64
// twin of `X64Backend.resolveGpr`. The `Arm64Register` mapping is the brief's `fromRawValue` path;
// its `rawValue` IS the GPR field for x0..x30, so the round-trip validates the class in one place.
export function arm64GprField(vreg TargetVReg) returns MachineWord
	let reg = arm64ResolveRegNum(vreg)
	if not arm64RegNumIsGpr(reg) 'notGpr'
		panic("arm64 emitter: register number {reg} is a SIMD register where a GPR is required — this encoding would name the wrong register file")
	end 'notGpr'
	let named = try Arm64Register.fromRawValue(reg) otherwise panic("arm64 emitter: colored register number {reg} is not a valid Arm64Register")
	return named.rawValue
end 'arm64GprField'

// The SIMD field value (0..31) of a colored operand, panicking if it is a GPR. d`k` has RegNum
// `firstVector + k`, so the field is `RegNum − Arm64FirstVectorRegister` — the constant, not a
// freshly-built `arm64RegisterFile()`, for the per-operand-allocation reason `arm64RegNumIsGpr` gives.
export function arm64FpField(vreg TargetVReg) returns MachineWord
	let reg = arm64ResolveRegNum(vreg)
	if arm64RegNumIsGpr(reg) 'notFp'
		panic("arm64 emitter: register number {reg} is a GPR where a SIMD register is required — this encoding would name the wrong register file")
	end 'notFp'
	return reg - Arm64FirstVectorRegister
end 'arm64FpField'

// ==========================================================================
// Move-wide immediate materialisation (movz / movk ladder)
// ==========================================================================

// MOVZ Rd, #imm16, LSL (hw*16) — zeroes the rest of the register.
function arm64EmitMovz(code ByteArray, rd MachineWord, imm16 MachineWord, hw MachineWord)
	emitArm64Insn(code, insn: Arm64OpMovz or (hw shl Arm64MoveWideHwShift) or ((imm16 and Arm64HalfwordMask) shl Arm64MoveWideImm16Shift) or rd)
end 'arm64EmitMovz'

// MOVK Rd, #imm16, LSL (hw*16) — keeps the other halfwords.
function arm64EmitMovk(code ByteArray, rd MachineWord, imm16 MachineWord, hw MachineWord)
	emitArm64Insn(code, insn: Arm64OpMovk or (hw shl Arm64MoveWideHwShift) or ((imm16 and Arm64HalfwordMask) shl Arm64MoveWideImm16Shift) or rd)
end 'arm64EmitMovk'

// Materialise a full 64-bit immediate into `rd`: MOV Xd, XZR for zero, then the first non-zero
// halfword as a MOVZ (so a single-halfword constant is one instruction) and every subsequent
// non-zero halfword as a MOVK. Correct for any value; the redundant leading MOVZ #0 the naive ladder
// emits for e.g. 0x10000 is avoided by starting the MOVZ at the first live halfword.
export function arm64EmitMovImm(code ByteArray, rd MachineWord, value MachineWord)
	if value == 0 'zero'
		emitArm64Insn(code, insn: Arm64OpMovReg or (Arm64XzrField shl Arm64RmShift) or rd)
		return
	end 'zero'

	var firstEmitted = false
	for hw in 0 upto 4 'eachHalfword'
		let chunk = (value shr (hw * Arm64HalfwordBits)) and Arm64HalfwordMask
		if chunk != 0 'live'
			if firstEmitted 'notFirst'
				arm64EmitMovk(code, rd: rd, imm16: chunk, hw: hw)
			end 'notFirst' else 'first'
				arm64EmitMovz(code, rd: rd, imm16: chunk, hw: hw)
				firstEmitted = true
			end 'first'
		end 'live'
	end 'eachHalfword'
end 'arm64EmitMovImm'

// ==========================================================================
// Logical bitmask-immediate encoding (AND/ORR/EOR #imm)
// ==========================================================================

// The (N, immr, imms) encoding of a 64-bit logical bitmask immediate, or a report that `value` is
// not an encodable bitmask (AArch64 logical immediates are rotated runs of set bits, NOT arbitrary
// constants — 0 and all-ones are excluded). A non-encodable immediate is an ISEL obligation: it must
// have materialised the constant into a register and used the register form, so an inencodable value
// reaching here is a loud bug, not a silent wrong instruction.
union Arm64LogicalImmResult
	encodable(n MachineWord, immr MachineWord, imms MachineWord)
	notEncodable
end 'Arm64LogicalImmResult'

// The number of low-order set bits of `value` (trailing ones).
function arm64CountTrailingOnes(value MachineWord) returns MachineWord
	var count = 0
	var v = value
	while (v and 0x1) == 0x1 'each'
		count = count + 1
		v = v shr 1
	end 'each'
	return count
end 'arm64CountTrailingOnes'

// The number of low-order clear bits of `value` (trailing zeros), capped at 64 for value 0.
function arm64CountTrailingZeros(value MachineWord) returns MachineWord
	if value == 0 'allZero'
		return Arm64WordBits
	end 'allZero'
	var count = 0
	var v = value
	while (v and 0x1) == 0x0 'each'
		count = count + 1
		v = v shr 1
	end 'each'
	return count
end 'arm64CountTrailingZeros'

// The number of high-order set bits of `value` (leading ones), over the full 64-bit width.
//
// Counts by shifting the VALUE LEFT (`shl` is 0-filling, hence sign-safe) and testing bit 63 each
// step — NOT by walking a `shr`-moved single-bit mask. A mask right-shifted with `shr` is ARITHMETIC
// on the sign-bit-set word the bootstrap types as signed, sign-filling into an all-ones mask that
// never clears — the old form here looped forever on any wrapped-run logical immediate. The
// `count < Arm64WordBits` cap bounds the walk even for an all-ones input.
function arm64CountLeadingOnes(value MachineWord) returns MachineWord
	var count = 0
	var v = value
	while count < Arm64WordBits and (v and Arm64WordSignBit) != 0 'each'
		count = count + 1
		v = v shl 1
	end 'each'
	return count
end 'arm64CountLeadingOnes'

// True when `value`'s set bits form ONE contiguous run anywhere (a "shifted mask", no wrap) — the run
// need not touch bit 0. `(value - 1) | value` fills every bit below the run's bottom; if the run is
// contiguous that fill is a bit-0-anchored mask (`(x & (x+1)) == 0`). Distinct from a bit-0-anchored
// run: `0xFF00` is a shifted mask but not a low-anchored one, and it IS an encodable rotation.
function arm64IsShiftedMask(value MachineWord) returns bool
	if value == 0 'zero'
		return false
	end 'zero'
	let filled = (value - 1) or value
	return (filled and (filled + 1)) == 0
end 'arm64IsShiftedMask'

// Encode a 64-bit logical bitmask immediate to its (N, immr, imms) fields, or report it inencodable.
// Finds the element size (a power of two 2..64) the pattern repeats over, then requires the reduced
// element to be a ROTATION of a low run of ones — either a shifted mask directly (run does not wrap
// the element) or one whose complement is (run wraps). Mirrors LLVM's `processLogicalImmediate`; the
// `imms` size prefix and `N` fall straight out of `~(size-1) << 1`.
function arm64EncodeLogicalImm(value MachineWord) returns Arm64LogicalImmResult
	if value == 0 or value == u64.max 'degenerate'
		return Arm64LogicalImmResult.notEncodable
	end 'degenerate'

	// Find the repeating element size: halve until the two halves of the candidate element differ.
	var size = 64
	while size > 2 'shrink'
		let half = size / 2
		let mask = (1 shl half) - 1
		if (value and mask) != ((value shr half) and mask) 'differ'
			break
		end 'differ'
		size = half
	end 'shrink'

	let elementMask = fullMaskOfSize(size)
	var imm = value and elementMask

	var rotationStart = 0
	var runLength = 0
	if arm64IsShiftedMask(imm) 'directRun'
		// The run does not wrap: its bottom is at the trailing-zero count, its length the ones above.
		rotationStart = arm64CountTrailingZeros(imm)
		runLength = arm64CountTrailingOnes(imm shr rotationStart)
	end 'directRun' else 'wrappedRun'
		// The run wraps the element boundary. Fill the high bits outside the element and require the
		// COMPLEMENT to be a shifted mask (the gap between the two run fragments is itself one run).
		imm = imm or not elementMask
		if not arm64IsShiftedMask(not imm) 'notMask'
			return Arm64LogicalImmResult.notEncodable
		end 'notMask'
		let leadingOnes = arm64CountLeadingOnes(imm)
		rotationStart = 64 - leadingOnes
		runLength = leadingOnes + arm64CountTrailingOnes(imm) - (64 - size)
	end 'wrappedRun'

	// immr is the right-rotation that returns the run to bit 0; imms carries the element-size prefix
	// (`~(size-1) << 1`) OR'd with (runLength − 1); N is that prefix's bit 6, inverted (1 iff size 64).
	let immr = (size - rotationStart) and (size - 1)
	let nImms = (not (size - 1)) shl 1
	let imms = (nImms or (runLength - 1)) and 0x3F
	let n = ((nImms shr 6) and 0x1) xor 0x1
	return Arm64LogicalImmResult.encodable(n, immr: immr, imms: imms)
end 'arm64EncodeLogicalImm'

// Whether `imm` — widened exactly as the encoder widens it (`imm32ToWord`) — is an encodable
// AArch64 logical bitmask immediate. The ISEL asks this to choose the `#bimm` form vs materialising
// the constant into a register: it is the SAME predicate `arm64EmitLogicalImm` enforces, so the two
// can never disagree (one fact, one home — the encoder's). A non-bitmask value (e.g. 10 = 0b1010)
// returns false and the ISEL emits the register form instead.
export function arm64ImmIsEncodableLogical(imm Imm32) returns bool
	match arm64EncodeLogicalImm(imm32ToWord(imm)) 'enc'
		encodable then return true
		notEncodable then return false
	end 'enc'
end 'arm64ImmIsEncodableLogical'

// The all-ones mask of a given power-of-two bit width (64 handled without a 1<<64 overflow).
function fullMaskOfSize(size MachineWord) returns MachineWord
	if size >= 64 'full'
		return u64.max
	end 'full'
	return (1 shl size) - 1
end 'fullMaskOfSize'

// Emit a logical bitmask-immediate op `op Rd, Rn, #imm`. `value` is the immediate two's-complement
// low bits; a non-encodable value panics (ISEL must materialise it — see `arm64EncodeLogicalImm`).
function arm64EmitLogicalImm(code ByteArray, opcode MachineWord, rd MachineWord, rn MachineWord, value MachineWord)
	match arm64EncodeLogicalImm(value) 'enc'
		encodable(n, immr, imms) then emitArm64Insn(code, insn: opcode or (n shl Arm64LogicalNShift) or (immr shl Arm64LogicalImmrShift) or (imms shl Arm64LogicalImmsShift) or (rn shl Arm64RnShift) or rd)
		notEncodable then panic("arm64 emitter: logical immediate {value} is not an encodable AArch64 bitmask — ISel must materialise a non-bitmask logical immediate into a register and use the register form")
	end 'enc'
end 'arm64EmitLogicalImm'

// ==========================================================================
// Add/sub immediate (with the hi/lo split for offsets past 12 bits)
// ==========================================================================

// ADD/SUB Rd, Rn, #imm12 [, LSL #12] — one instruction, imm12 field.
function arm64EmitAddSubImm12(code ByteArray, opcode MachineWord, rd MachineWord, rn MachineWord, imm12 MachineWord, shiftHi bool)
	let shBit = Arm64ImmShiftHiBit if shiftHi else 0
	emitArm64Insn(code, insn: opcode or shBit or ((imm12 and Arm64ImmMask) shl Arm64ImmShift) or (rn shl Arm64RnShift) or rd)
end 'arm64EmitAddSubImm12'

// Whether a signed `Imm32` has an ADD/SUB-immediate form at all — i.e. whether its MAGNITUDE fits the
// 24 bits the hi/lo split below encodes. The MAGNITUDE is the question because `arm64EmitAddImmSigned`
// turns a negative immediate into a SUB of its magnitude (and vice versa), so `+ -1000000007` is as
// inencodable as `- 1000000007`.
//
// The ISEL asks this to choose the `#imm` form vs materialising the constant into a register: it is the
// SAME ceiling `arm64EmitAddSubImmWide` enforces, so the two can never disagree (one fact, one home —
// the encoder's), exactly as `arm64ImmIsEncodableLogical` pairs with `arm64EncodeLogicalImm`. It has to
// be asked at all because the constant fold that produces these immediates is TARGET-NEUTRAL and sized
// for x64's `lea [base ± imm32]`, which carries the whole `Imm32` domain verbatim; AArch64's reaches
// 24 bits.
export function arm64ImmIsEncodableAddSub(imm Imm32) returns bool
	return arm64AddSubImmMagnitude(imm) <= Arm64AddSubImmWideMax
end 'arm64ImmIsEncodableAddSub'

// The MAGNITUDE of a signed ADD/SUB immediate — the number the imm12 fields actually carry, because
// the SIGN rides the OPCODE here rather than the field: a negative literal on the ADD side is a SUB
// of its magnitude, and vice versa.
//
// That rule was written out three times — once in the predicate above and once in each of the two
// signed emitters below — and the three had to agree on the ARITHMETIC as well as the direction, or
// the predicate would answer "encodable" for a value the emitter then panics on. It is stated once,
// so a future change to what "magnitude" means (a wider `Imm32`, a saturating band) moves all three
// at once instead of leaving a divergence that reads as correct at every site.
function arm64AddSubImmMagnitude(imm Imm32) returns MachineWord
	if imm >= 0 'nonNeg'
		return imm as MachineWord
	end 'nonNeg'
	return -imm
end 'arm64AddSubImmMagnitude'

// Whether a magnitude fits ONE imm12 field — plain, or shifted left by 12 with an empty low half.
//
// ⚠ A STRICTLY SMALLER BAND THAN `arm64ImmIsEncodableAddSub`'s, and the difference is the whole reason
// this is a separate question. That one admits the hi/lo PAIR `arm64EmitAddSubImmWide` splits a 24-bit
// magnitude into; a COMPARE cannot use a pair, because the flags it exists to set would then describe
// only the second half of the subtraction. So `x + 16777215` has an immediate form and
// `x == 16777215` does not.
function arm64MagnitudeFitsOneImm12(magnitude MachineWord) returns bool
	if magnitude <= Arm64ImmMask 'plainField'
		return true
	end 'plainField'
	return (magnitude and Arm64ImmMask) == 0 and magnitude <= Arm64ShiftedImm12Max
end 'arm64MagnitudeFitsOneImm12'

// Whether a signed `Imm32` has a COMPARE-immediate form at all. The MAGNITUDE decides, because the SIGN
// rides the OPCODE here exactly as it does on add/sub — a negative compare-immediate is a `cmn` of its
// magnitude — so `arm64AddSubImmMagnitude` answers for both.
//
// The ISEL asks this to choose `cmp #imm` vs materialising the constant into a register: it is the SAME
// band `arm64EmitCmpImm` enforces, so the two can never disagree (one fact, one home — the encoder's),
// exactly as `arm64ImmIsEncodableAddSub` and `arm64ImmIsEncodableLogical` pair with their encoders.
export function arm64ImmIsEncodableCmp(imm Imm32) returns bool
	return arm64MagnitudeFitsOneImm12(arm64AddSubImmMagnitude(imm))
end 'arm64ImmIsEncodableCmp'

// ADD/SUB Rd, Rn, #imm for an immediate that may exceed the 12-bit field: a plain 12-bit form
// silently truncates any value ≥ 0x1000, corrupting a large stack-slot address or frame size (M1
// trap). Splits into a high (<<12) and low part; `rd` doubles as the running accumulator, so it is
// safe even when `rd == rn`. `opcode` selects ADD (`Arm64OpAddImm`) or SUB (`Arm64OpSubImm`).
export function arm64EmitAddSubImmWide(code ByteArray, opcode MachineWord, rd MachineWord, rn MachineWord, imm MachineWord)
	if imm > Arm64AddSubImmWideMax 'tooLarge'
		panic("arm64EmitAddSubImmWide: immediate {imm} exceeds the {Arm64AddSubImmWideMax} the hi/lo imm12 split reaches — an ALU immediate this wide is the ISEL's obligation (it asks `arm64ImmIsEncodableAddSub` and materialises the constant into a register: StdToArm64Conversion.lowerAddSubImm), and a FRAME this large has no encodable form at all")
	end 'tooLarge'
	let high = (imm shr Arm64Imm12FieldBits) and Arm64ImmMask
	let low = imm and Arm64ImmMask
	if high == 0 'smallImm'
		arm64EmitAddSubImm12(code, opcode: opcode, rd: rd, rn: rn, imm12: low, shiftHi: false)
		return
	end 'smallImm'
	arm64EmitAddSubImm12(code, opcode: opcode, rd: rd, rn: rn, imm12: high, shiftHi: true)
	if low > 0 'hasLow'
		arm64EmitAddSubImm12(code, opcode: opcode, rd: rd, rn: rd, imm12: low, shiftHi: false)
	end 'hasLow'
end 'arm64EmitAddSubImmWide'

// The immediate form of `arm64AddImm`/`arm64SubImm`: a signed `Imm32`. A negative literal on the ADD
// side is a SUB of its magnitude (and vice versa), and a magnitude past the 12-bit field routes
// through the hi/lo split. `rd`/`rn` are independent (arm64's ADD-immediate is 3-address), so this is
// never a two-address reuse.
export function arm64EmitAddImmSigned(code ByteArray, rd MachineWord, rn MachineWord, imm Imm32)
	arm64EmitAddSubImmWide(code, opcode: Arm64OpAddImm if imm >= 0 else Arm64OpSubImm, rd: rd, rn: rn, imm: arm64AddSubImmMagnitude(imm))
end 'arm64EmitAddImmSigned'

function arm64EmitSubImmSigned(code ByteArray, rd MachineWord, rn MachineWord, imm Imm32)
	arm64EmitAddSubImmWide(code, opcode: Arm64OpSubImm if imm >= 0 else Arm64OpAddImm, rd: rd, rn: rn, imm: arm64AddSubImmMagnitude(imm))
end 'arm64EmitSubImmSigned'

// ==========================================================================
// Constant shifts (LSL/LSR via UBFM, ASR via SBFM)
// ==========================================================================

function arm64EmitBitfield(code ByteArray, opcode MachineWord, rd MachineWord, rn MachineWord, immr MachineWord, imms MachineWord)
	emitArm64Insn(code, insn: opcode or ((immr and 0x3F) shl Arm64BitfieldImmrShift) or ((imms and 0x3F) shl Arm64BitfieldImmsShift) or (rn shl Arm64RnShift) or rd)
end 'arm64EmitBitfield'

// LSL Xd, Xn, #sh = UBFM Xd, Xn, #(-sh mod 64), #(63-sh).
export function arm64EmitLslImm(code ByteArray, rd MachineWord, rn MachineWord, sh ShiftCount)
	let shift = shiftCountBits(sh)
	arm64EmitBitfield(code, opcode: Arm64OpUbfm, rd: rd, rn: rn, immr: (64 - shift) and Arm64WordBitMax, imms: Arm64WordBitMax - shift)
end 'arm64EmitLslImm'

// LSR Xd, Xn, #sh = UBFM Xd, Xn, #sh, #63.
export function arm64EmitLsrImm(code ByteArray, rd MachineWord, rn MachineWord, sh ShiftCount)
	let shift = shiftCountBits(sh)
	arm64EmitBitfield(code, opcode: Arm64OpUbfm, rd: rd, rn: rn, immr: shift, imms: Arm64WordBitMax)
end 'arm64EmitLsrImm'

// ASR Xd, Xn, #sh = SBFM Xd, Xn, #sh, #63.
function arm64EmitAsrImm(code ByteArray, rd MachineWord, rn MachineWord, sh ShiftCount)
	let shift = shiftCountBits(sh)
	arm64EmitBitfield(code, opcode: Arm64OpSbfm, rd: rd, rn: rn, immr: shift, imms: Arm64WordBitMax)
end 'arm64EmitAsrImm'

// A shift count as a machine word, clamped into the 0..63 the 64-bit shift forms accept — a count
// out of that range is an ISel bug (a shift-by-≥64 is unspecified and was never a valid Std op).
function shiftCountBits(sh ShiftCount) returns MachineWord
	let bits = sh as MachineWord
	if bits > Arm64WordBitMax 'outOfRange'
		panic("arm64 emitter: shift count {bits} out of the 0..63 range a 64-bit shift accepts")
	end 'outOfRange'
	return bits
end 'shiftCountBits'

// ==========================================================================
// Compare / conditional-set
// ==========================================================================

// CMP Xn, Xm = SUBS XZR, Xn, Xm.
export function arm64EmitCmpReg(code ByteArray, rn MachineWord, rm MachineWord)
	emitArm64Insn(code, insn: Arm64OpCmpReg or (rm shl Arm64RmShift) or (rn shl Arm64RnShift))
end 'arm64EmitCmpReg'

// `CMP Xn, #imm` / `CMN Xn, #imm` — the compare-immediate, in whichever of the two single-field shapes
// its magnitude takes: the plain imm12, or the imm12 shifted left by 12 when the low half is empty.
//
// A magnitude with NO single-field form is the ISEL's obligation (`StdToArm64Conversion.lowerCmpImm`
// asks `arm64ImmIsEncodableCmp` and materialises the constant into the IP scratch, comparing
// register-to-register), so this PANICS rather than truncate — a masked field would compare against a
// different constant with nothing anywhere to notice. The materialisation used to live HERE, invisible
// to the register allocator and the liveness model that must see every write of x16.
export function arm64EmitCmpImm(code ByteArray, rn MachineWord, imm Imm32)
	let magnitude = arm64AddSubImmMagnitude(imm)
	if not arm64MagnitudeFitsOneImm12(magnitude) 'noForm'
		panic("arm64EmitCmpImm: compare immediate {imm} fits neither the plain imm12 field nor the shifted one, and a compare has no hi/lo split to fall back on — the ISEL must materialise it into a register and compare register-to-register (StdToArm64Conversion.lowerCmpImm)")
	end 'noForm'

	let shiftHi = magnitude > Arm64ImmMask
	let field = (magnitude shr Arm64Imm12FieldBits) if shiftHi else magnitude
	let opcode = Arm64OpAddsImm if imm < 0 else Arm64OpSubsImm
	arm64EmitAddSubImm12(code, opcode: opcode, rd: Arm64XzrField, rn: rn, imm12: field, shiftHi: shiftHi)
end 'arm64EmitCmpImm'

// A signed `Imm32` as its 64-bit two's-complement pattern — the value `movz`/`movk` must materialise
// so a negative compare/immediate operand reads with its sign extended.
function imm32ToWord(imm Imm32) returns MachineWord
	if imm >= 0 'nonNeg'
		return imm as MachineWord
	end 'nonNeg'
	return u64.max - (-imm) + 1
end 'imm32ToWord'

// CSET Xd, cond = CSINC Xd, XZR, XZR, invert(cond) — one register set from the flags.
export function arm64EmitCset(code ByteArray, rd MachineWord, cond Arm64CondCode)
	let inverted = (cond.rawValue as MachineWord) xor Arm64CondInvertBit
	emitArm64Insn(code, insn: Arm64OpCsinc or (inverted shl Arm64CondFieldShift) or rd)
end 'arm64EmitCset'

// ==========================================================================
// Register moves and register swap (SSA-destruction cycle break)
// ==========================================================================

// A GPR reg-reg move: ORR Xd, XZR, Xn.
export function arm64EmitMovGpr(code ByteArray, rd MachineWord, rn MachineWord)
	emitArm64Insn(code, insn: Arm64OpMovReg or (rn shl Arm64RmShift) or rd)
end 'arm64EmitMovGpr'

// An FP reg-reg move: FMOV Dd, Dn.
function arm64EmitFmovD(code ByteArray, rd MachineWord, rn MachineWord)
	emitArm64Rr(code, opcode: Arm64OpFmovD, rd: rd, rn: rn)
end 'arm64EmitFmovD'

// `movRegReg` is CLASS-AGNOSTIC (one op, both files): a GPR pair moves through ORR, a SIMD pair
// through FMOV. The instruction is chosen from the resolved registers, never from the op — the x64
// side does the same with `mov`/`movsd`. The two must be the SAME class (a copy never crosses files);
// a mismatch is an allocator bug.
function arm64EmitRegRegMove(code ByteArray, dest TargetVReg, src TargetVReg)
	let destGpr = arm64VRegIsGpr(dest)
	if destGpr != arm64VRegIsGpr(src) 'classMismatch'
		panic("arm64 emitter: movRegReg between different register files (dest gpr={destGpr}) — a copy never crosses the GPR/SIMD boundary")
	end 'classMismatch'
	if destGpr 'gpr'
		arm64EmitMovGpr(code, rd: arm64GprField(dest), rn: arm64GprField(src))
	end 'gpr' else 'fp'
		arm64EmitFmovD(code, rd: arm64FpField(dest), rn: arm64FpField(src))
	end 'fp'
end 'arm64EmitRegRegMove'

// `xchgRegReg` is a POST-COLORING physical swap SSA-destruction splices in to break a copy cycle
// (there is no scratch to spare). AArch64 has no `xchg`, so a GPR pair swaps through the IP scratch
// x16 in three moves; a SIMD pair swaps scratch-free with a triple vector-EOR (the float twin of
// x64's triple-xorpd). Both operands share one file — a cross-file swap is meaningless.
function arm64EmitRegRegSwap(code ByteArray, a TargetVReg, b TargetVReg)
	let aGpr = arm64VRegIsGpr(a)
	if aGpr != arm64VRegIsGpr(b) 'classMismatch'
		panic("arm64 emitter: xchgRegReg between different register files — a swap never crosses the GPR/SIMD boundary")
	end 'classMismatch'
	if aGpr 'gpr'
		let ra = arm64GprField(a)
		let rb = arm64GprField(b)
		arm64EmitMovGpr(code, rd: Arm64Ip0, rn: ra)
		arm64EmitMovGpr(code, rd: ra, rn: rb)
		arm64EmitMovGpr(code, rd: rb, rn: Arm64Ip0)
	end 'gpr' else 'fp'
		let va = arm64FpField(a)
		let vb = arm64FpField(b)
		arm64EmitVectorEor(code, rd: va, rn: va, rm: vb)
		arm64EmitVectorEor(code, rd: vb, rn: vb, rm: va)
		arm64EmitVectorEor(code, rd: va, rn: va, rm: vb)
	end 'fp'
end 'arm64EmitRegRegSwap'

// EOR Vd.8B, Vn.8B, Vm.8B — a 64-bit-lane bitwise XOR of two SIMD registers (covers a d-register's
// full 64 bits), the swap primitive above builds its three-XOR exchange from.
function arm64EmitVectorEor(code ByteArray, rd MachineWord, rn MachineWord, rm MachineWord)
	emitArm64Rrr(code, opcode: Arm64OpEorVec8b, rd: rd, rn: rn, rm: rm)
end 'arm64EmitVectorEor'

// ==========================================================================
// Spill / reload and base+disp loads/stores
// ==========================================================================

// The `[x29 + disp]` displacement of a colored spill slot. x29 points at the saved frame record, and
// the spill/callee-save area opens at `+16` (past the saved x29/x30 pair); every slot is 8 bytes.
// The ONE place the arm64 frame-slot arithmetic is spelled, shared by the allocator's spills, the
// prologue pass's callee-save slots and the hand-assembled runtime chunks' locals
// (`Arm64PanicRuntime.slotOffset`) — all three address the same frame the same way.
export function arm64SlotDisplacement(slot SpillSlot) returns MachineWord
	return Arm64FrameRecordBytes + slot * SpillSlotBytes
end 'arm64SlotDisplacement'

// Access a frame slot at `[x29 + byteOffset]`. Below 256 bytes an unscaled STUR/LDUR encodes the
// offset directly; at or above it the SCALED form is MANDATORY (the unscaled simm9 truncates ≥ 256 —
// M1 trap). `unscaledOp` / `scaledOp` select the GPR (STUR·STR / LDUR·LDR X) or FP (·D) opcode pair —
// the class-agnostic slot store and reload each pass their own.
//
// ⚠ THE SCALED FORM DOES NOT REACH THE WHOLE FRAME, AND THIS DOOR IS THE ONLY PLACE THAT CAN KNOW IT.
// The 12-bit field counts ACCESS UNITS, so an 8-byte slot reaches `4095 * 8 = 32760` bytes off x29 and
// not one further — i.e. slot 4093 is the last with a direct form. A frame with more slots than that is
// an ordinary consequence of enough simultaneously-live values (`wide-spill-frames.md` reaches it with
// 4111), so the third arm is a REACHABLE case, not a defensive one, and it folds the address into the
// IP1 scratch instead (`arm64EmitWideFrameSlot`).
function arm64EmitFrameSlot(code ByteArray, rt MachineWord, byteOffset MachineWord, unscaledOp MachineWord, scaledOp MachineWord)
	if byteOffset < Arm64UnscaledSpillThreshold 'unscaled'
		arm64EmitUnscaledMem(code, opcode: unscaledOp, rt: rt, baseReg: Arm64Fp, byteOffset: byteOffset as Imm32)
	end 'unscaled' else if arm64ByteOffsetFitsScaledImm12(byteOffset, scale: SpillSlotBytes as NonZeroWord) 'scaled'
		arm64EmitScaledMem(code, opcode: scaledOp, rt: rt, baseReg: Arm64Fp, byteOffset: byteOffset, scale: SpillSlotBytes)
	end 'scaled' else 'wide'
		arm64EmitWideFrameSlot(code, rt: rt, byteOffset: byteOffset, scaledOp: scaledOp)
	end 'wide'
end 'arm64EmitFrameSlot'

// A frame slot past the scaled field's reach: `add x17, x29, #hi, lsl #12` puts a 4 KiB-aligned base
// within reach of the slot into the IP1 scratch, and the access carries the REMAINDER — at most 4095
// bytes, so always inside the 12-bit field — off it. Two instructions for any frame the prologue can
// open, and the `add` is always a single one (its low imm12 half is zero by construction).
//
// ⭐⭐ **WHY x17 AND NOT x16, WHICH THE REST OF THIS BACKEND USES FOR EXACTLY THIS.** A spill or a reload
// is an op a POST-ISEL pass SPLICES INTO A BLOCK, and the isel mints `x16` producer/consumer PAIRS that
// those same passes demonstrably splice between (MEASURED: 16 straddled pairs of 1,144 — see
// `StdToArm64Conversion.Arm64Scratch`, whose header is the full argument). An encoder-tier `x16`
// materialisation HERE would therefore land inside a pending `add x16, base, #off` → `ldr [x16]` fold and
// destroy its address. x17 is the one scratch that cannot be straddled: it is likewise outside the
// allocatable pool, so no VALUE is ever coloured into it, and its ONLY other writer in this backend is
// `arm64EmitJumpTable`, which produces AND consumes it inside a single terminator's encoding — there is
// no x17 pair spanning two ops for anything to be spliced between. ⇒ **a future isel that mints an x17
// producer/consumer pair breaks this**, exactly as an x16 one would; the two scratches are not
// interchangeable, and which one is spliceable is the whole distinction.
//
// The scratch is NOT declared on `storeSlotReg`/`loadRegSlot`'s `implicitDefs`, and cannot be: those are
// SHARED x64+arm64 union arms, and `RegNum` 17 is x64's `xmm1`. It needs no declaration for the same
// reason `arm64JumpTable`'s is documentation only — x17 is not allocatable, so there is nothing for the
// allocator to keep out of it.
//
// A displacement past the 24 bits the hi/lo split reaches has no form here, and `arm64EmitAddSubImmWide`
// panics on it rather than truncating — correctly, and unreachably: a slot displacement never exceeds the
// frame, and `arm64EmitStackAlloc` cannot open a frame that large either (it goes through the SAME split,
// and the prologue is emitted before any slot access).
function arm64EmitWideFrameSlot(code ByteArray, rt MachineWord, byteOffset MachineWord, scaledOp MachineWord)
	let scratchBase = arm64WideFrameScratchBase(byteOffset)
	arm64EmitAddSubImmWide(code, opcode: Arm64OpAddImm, rd: Arm64Ip1, rn: Arm64Fp, imm: scratchBase)
	arm64EmitScaledMem(code, opcode: scaledOp, rt: rt, baseReg: Arm64Ip1, byteOffset: byteOffset - scratchBase, scale: SpillSlotBytes)
end 'arm64EmitWideFrameSlot'

// ⭐ **A SIGNED BYTE OFFSET AS ITS `bits`-WIDE TWO'S-COMPLEMENT FIELD, IN `scale`-BYTE UNITS.** The one
// place the two signed-offset memory forms below turn an `Imm32` into the immediate their encoding carries:
// STUR/LDUR's simm9 (scale 1, 9 bits) and STP/LDP's imm7 (scale 8 — one transferred register — 7 bits).
//
// ⛔⛔ **THIS USED TO SAY THE OBVIOUS SPELLING "FAILS AT RUN TIME IN THIS FILE" AND "COULD NOT BE
// REDUCED". THE PANIC WAS REAL AND BOTH EXPLANATIONS WERE WRONG** — replaced rather than deleted,
// because the shape is still worth knowing. MEASURED, then: `byteOffset = -64` produced a quotient that
// PRINTED as `-8` and was refused by the very next `Imm32` parameter bind, *"Range check failed"*. It was
// about neither this file nor `imm32ToWord`: the BOOTSTRAP that compiles shv2 narrowed a `/` whose two
// operand ranges both fit `i32` into a 32-bit `idiv`, and `idiv r/m32` defines only `EAX` — a 32-bit write
// ZERO-extends, so a NEGATIVE quotient read as `4294967288` at 64 bits. The range check was merely the
// first consumer to look; a consumer that sign-extended first (an interpolation does) saw `-8`, which is
// how one value printed correctly and was rejected one line later. Fixed at the instruction that breaks
// the invariant (`RegisterManager.EmitIdivOperation32`) and pinned by `specs/ranged-typealias.md`.
//
// ⚠ **THE "COULD NOT BE REDUCED" HALF DID NOT HOLD EITHER, AND WHY THAT REDUCTION PASSED IS NOT
// RECOVERABLE.** The shape it describes — an `Imm32` parameter, divided by a positive constant,
// re-narrowed and handed to another `Imm32` parameter — IS `specs/ranged-typealias.md`'s case, and it
// fails. What is measurable is which divisors license the narrowing, and that answer names this
// signature: a literal, a module-level `let` and a local `let` all fold to a range fitting `i32` and take
// the 32-bit `idiv`, while a `NonZeroWord` divisor — `int(1 to u64.max)`, which has no signed reading to
// union with `Imm32` — keeps the divide at 64 bits. So the parameter below would not trip it today; the
// failing draft must have divided by one of this file's folded scale constants.
//
// ⭐ The magnitude spelling stays, now on its merits rather than as a route around that. It reuses
// `arm64AddSubImmMagnitude` — the idiom `arm64EmitCmpImm` already uses for a signed immediate, and the one
// home of the magnitude rule — and it folds the sign through `modulus`, the number this field genuinely
// wraps at. `imm32ToWord((byteOffset / scale) as Imm32) and (modulus - 1)` is correct too, but only while
// every modulus is a power of two, and nothing here says that.
function arm64SignedMemField(byteOffset Imm32, scale NonZeroWord, modulus MachineWord) returns MachineWord
	let units = arm64AddSubImmMagnitude(byteOffset) / scale
	if byteOffset < 0 'negative'
		return modulus - units
	end 'negative'
	return units
end 'arm64SignedMemField'

// The two's-complement wrap-arounds of the two fields: 2^9 for STUR/LDUR's simm9, 2^7 for STP/LDP's imm7.
// Each is exactly `mask + 1`, stated as its own name because it is the MODULUS the sign is folded through,
// not the mask that trims the result.
let Arm64UnscaledImm9Modulus = 512
let Arm64PairImm7Modulus = 128

// An UNSCALED SIGNED-offset load/store `op Rt, [Xn, #simm9]` — the ±256-byte form. Two callers, and they
// want it for opposite reasons: a small frame slot uses it because the scaled form's alignment rule is not
// worth the check there, and the byte-fill ladder because the scaled form has NO SIGN and the ladder's tail
// stores are anchored BACKWARD off the region's end. The offset counts BYTES, so its scale is 1.
function arm64EmitUnscaledMem(code ByteArray, opcode MachineWord, rt MachineWord, baseReg MachineWord, byteOffset Imm32)
	let field = arm64SignedMemField(byteOffset, scale: Arm64ByteAccessScale as NonZeroWord, modulus: Arm64UnscaledImm9Modulus)
	emitArm64Insn(code, insn: opcode or ((field and Arm64UnscaledImm9Mask) shl Arm64UnscaledImm9Shift) or (baseReg shl Arm64RnShift) or rt)
end 'arm64EmitUnscaledMem'

// An STP/LDP with a SIGNED byte offset: `op Rt1, Rt2, [Xn, #imm7*8]`. The imm7 counts 8-byte units, which is
// what `Arm64PairScaleBytes` divides out, and it is signed — the property that lets the fill ladder anchor a
// pair store backward off the region's end, and the reason this is not folded into the scaled builder above.
function arm64EmitPairOffset(code ByteArray, opcode MachineWord, rt1 MachineWord, rt2 MachineWord, baseReg MachineWord, byteOffset Imm32)
	let field = arm64SignedMemField(byteOffset, scale: Arm64PairScaleBytes as NonZeroWord, modulus: Arm64PairImm7Modulus)
	emitArm64Insn(code, insn: opcode or ((field and Arm64PairImm7Mask) shl Arm64PairImm7Shift) or (rt2 shl Arm64Rt2Shift) or (baseReg shl Arm64RnShift) or rt1)
end 'arm64EmitPairOffset'

// A scaled unsigned-offset load/store `op Rt, [Xn, #imm12*scale]`. The offset must be scale-aligned
// and fit the 12-bit field — a spill/callee-save or data-field offset always is; a violation is a bug.
export function arm64EmitScaledMem(code ByteArray, opcode MachineWord, rt MachineWord, baseReg MachineWord, byteOffset MachineWord, scale MachineWord)
	emitArm64Insn(code, insn: opcode or (arm64ScaledImm12(byteOffset, scale: scale) shl Arm64LoadStoreImm12Shift) or (baseReg shl Arm64RnShift) or rt)
end 'arm64EmitScaledMem'

// Whether `byteOffset` has a scaled imm12 form at this access `scale`: scale-aligned, and the scaled
// count inside the 12-bit field.
//
// ⭐ THE ONE STATEMENT OF THAT RULE. The ISEL's question (`arm64DispHasScaledForm`) and the encoder's
// assertion that it was asked (`arm64ScaledImm12`) both read it, so widening the reach — a narrow-width
// access at scale 2 or 4, the unscaled signed form for a negative offset — moves both at once. Written
// out at both doors instead, the predicate could come to admit exactly what the encoder then panics on,
// which is the defect A5e exists to have removed rather than relocated. It is the pairing
// `arm64MagnitudeFitsOneImm12` gives the compare immediate one screen up.
function arm64ByteOffsetFitsScaledImm12(byteOffset MachineWord, scale NonZeroWord) returns bool
	return byteOffset mod scale == 0 and byteOffset / scale <= Arm64LoadStoreImm12Mask
end 'arm64ByteOffsetFitsScaledImm12'

// The 4 KiB-aligned part of a frame displacement past the scaled field: the base an `add`'s SHIFTED
// imm12 puts into the IP1 scratch in ONE instruction, leaving a remainder of at most 4095 bytes that the
// access's own 12-bit field then carries. The ONE statement of that split, so the two doors that fold a
// wide frame address — the encoder's spill/reload (`arm64EmitWideFrameSlot`) and the prologue pass's
// incoming stack argument (`Arm64PrologueEpilogue.resolveArm64IncomingArgs`) — cannot come to disagree
// about where the cut falls. Both then hand the base to `arm64EmitAddSubImmWide`, whose 24-bit ceiling is
// the ONLY ceiling either has, and which no frame the prologue can open reaches.
//
// The cut at 4096 BYTES serves every access width, not just the 64-bit one: the residue is at most 4095
// bytes and inherits the offset's alignment, so at scale 1 it is 4095 units and at any wider scale fewer —
// inside the 12-bit field either way. A narrow-width frame access (P1.9) therefore needs no second split.
export function arm64WideFrameScratchBase(byteOffset MachineWord) returns MachineWord
	return (byteOffset shr Arm64Imm12FieldBits) shl Arm64Imm12FieldBits
end 'arm64WideFrameScratchBase'

// The scaled imm12 field of a load/store: `byteOffset / scale`, asserting scale-alignment and range.
//
// The panic is an ASSERTION OF ITS CALLER'S OBLIGATION, not a reachable diagnostic, and there are two
// callers who owe it. A DATA access whose offset has no scaled form is folded into the IP scratch
// upstream (`StdToArm64Conversion.addressFor` asks `arm64DispHasScaledForm`, and addresses
// `[scratch + 0]` when the answer is no); a FRAME-SLOT access past the field is folded HERE, by
// `arm64EmitWideFrameSlot` — the slot number does not exist until register allocation, so the isel has
// nothing to fold. Either way what arrives fits. Masking either condition away would read or WRITE THE
// WRONG FIELD with nothing anywhere to notice — which is why it stays a panic rather than becoming a clamp.
//
// The alignment half has no reachable caller today and that is a property of the LAYOUT, not luck: every
// 64-bit access offset in this compiler is slot-derived (`Project.FieldSlotBytes` = 8 per slot,
// `UnionTagBytes` = 8, `IrInterface.InterfaceWitnessHalfOffset` = 8, the layout-descriptor columns) and
// every 8-byte multiple divides 8, while a byte access has scale 1 and divides everything. It is the
// assertion that stays true only while that holds.
function arm64ScaledImm12(byteOffset MachineWord, scale MachineWord) returns MachineWord
	// `scale` is a load/store access width (1/2/4/8), always non-zero; cast so the divide and
	// remainder are provably safe (integer `/`/`mod` throw for a possibly-zero divisor).
	let s = scale as NonZeroWord
	if not arm64ByteOffsetFitsScaledImm12(byteOffset, scale: s) 'noScaledForm'
		panic("arm64 emitter: load/store byte offset {byteOffset} has no {scale}-scaled imm12 form — it is either not {scale}-aligned or its scaled count exceeds the 12-bit unsigned field — and the ISEL must have folded it into a scratch base (StdToArm64Conversion.addressFor)")
	end 'noScaledForm'
	return byteOffset / s
end 'arm64ScaledImm12'

// The byte-offset SCALE of a `[base + disp]` data access at this width: `LDRB`/`STRB` scale by 1, the
// 64-bit forms by 8. The ONE place the two widths' scales are named — the ISEL's "does this offset have
// a direct form" predicate and the encoders below both read it, so the reach they agree on is one fact.
function arm64AccessScale(width X64AccessWidth) returns MachineWord
	let scale = match width 'w'
		byte gives Arm64ByteAccessScale
		word64 gives SpillSlotBytes
	end 'w'
	return scale
end 'arm64AccessScale'

// Whether a `[base + disp]` data access at this width has a DIRECT scaled form — the offset is
// non-negative, scale-aligned, and its scaled value fits the 12-bit field. That reaches 4095 bytes for a
// byte access and 32760 for a 64-bit one, and NOTHING between there and the `Imm32` a Std
// `loadIndirect`/`storeIndirect` offset carries (`StdLoweringShared.memoryDisplacement` is sized for
// x64's `[base + disp32]`, which takes the whole domain verbatim).
//
// The ISEL asks this to choose the direct form vs folding `base + offset` into the IP scratch. It reads
// `arm64ByteOffsetFitsScaledImm12` — the SAME predicate `arm64ScaledImm12` asserts on — so the two cannot
// disagree, rather than merely agreeing today because the same rule was typed twice.
//
// The negative arm is the one condition that is this door's alone: `memoryDisplacement` narrows an
// UNSIGNED `ByteOffset`, so nothing produces one today, and a future signed displacement gets the scratch
// fold (an `add` of a negative immediate is a `sub` of its magnitude) rather than the STUR/LDUR simm9
// form this predicate does not model.
export function arm64DispHasScaledForm(disp Imm32, width X64AccessWidth) returns bool
	if disp < 0 'negative'
		return false
	end 'negative'

	return arm64ByteOffsetFitsScaledImm12(disp as MachineWord, scale: arm64AccessScale(width) as NonZeroWord)
end 'arm64DispHasScaledForm'

// A `[base + disp]` load at the op's width (the data-section access forms). A `word64` load moves
// through a GPR ldr or an FP ldr per the dest's class (an f64 global is 64 bits either way); a `byte`
// load is LDRB (zero-extending — a bool must arrive zero-extended, or the upper bits are garbage) and
// GPR-only.
//
// Both widths go through the SAME scaled-field builder, at their own scale: a byte access is the scaled
// form with scale 1, so its 0..4095 reach is `arm64ScaledImm12`'s range check rather than a second
// hand-written one that could come to disagree with the ISEL's predicate.
function arm64EmitDataLoad(code ByteArray, dest TargetVReg, base MachineWord, disp Imm32, width X64AccessWidth)
	let byteOffset = arm64NonNegDisp(disp)
	match width 'w'
		byte then arm64EmitScaledMem(code, opcode: Arm64OpLdrB, rt: arm64GprField(dest), baseReg: base, byteOffset: byteOffset, scale: arm64AccessScale(width))
		word64 then arm64EmitWord64Load(code, dest: dest, base: base, byteOffset: byteOffset)
	end 'w'
end 'arm64EmitDataLoad'

function arm64EmitDataStore(code ByteArray, base MachineWord, disp Imm32, src TargetVReg, width X64AccessWidth)
	let byteOffset = arm64NonNegDisp(disp)
	match width 'w'
		byte then arm64EmitScaledMem(code, opcode: Arm64OpStrB, rt: arm64GprField(src), baseReg: base, byteOffset: byteOffset, scale: arm64AccessScale(width))
		word64 then arm64EmitWord64Store(code, base: base, byteOffset: byteOffset, src: src)
	end 'w'
end 'arm64EmitDataStore'

// A 64-bit `[base + byteOffset]` load, class-dispatched: GPR through LDR Xt, SIMD through LDR Dt. The
// offset is scaled by 8 (both widths are 8 bytes).
function arm64EmitWord64Load(code ByteArray, dest TargetVReg, base MachineWord, byteOffset MachineWord)
	if arm64VRegIsGpr(dest) 'gpr'
		arm64EmitScaledMem(code, opcode: Arm64OpLdrX, rt: arm64GprField(dest), baseReg: base, byteOffset: byteOffset, scale: SpillSlotBytes)
	end 'gpr' else 'fp'
		arm64EmitScaledMem(code, opcode: Arm64OpLdrD, rt: arm64FpField(dest), baseReg: base, byteOffset: byteOffset, scale: SpillSlotBytes)
	end 'fp'
end 'arm64EmitWord64Load'

function arm64EmitWord64Store(code ByteArray, base MachineWord, byteOffset MachineWord, src TargetVReg)
	if arm64VRegIsGpr(src) 'gpr'
		arm64EmitScaledMem(code, opcode: Arm64OpStrX, rt: arm64GprField(src), baseReg: base, byteOffset: byteOffset, scale: SpillSlotBytes)
	end 'gpr' else 'fp'
		arm64EmitScaledMem(code, opcode: Arm64OpStrD, rt: arm64FpField(src), baseReg: base, byteOffset: byteOffset, scale: SpillSlotBytes)
	end 'fp'
end 'arm64EmitWord64Store'

function arm64NonNegDisp(disp Imm32) returns MachineWord
	if disp < 0 'neg'
		panic("arm64 emitter: negative base+disp {disp} — a data-section field offset is non-negative")
	end 'neg'
	return disp as MachineWord
end 'arm64NonNegDisp'

// ==========================================================================
// Chunk-local block branches (b / b.cond / cbz / cbnz)
// ==========================================================================

// A pending within-function branch: the chunk-local offset of the branch instruction and the block
// it targets. `wide` selects the field width — an unconditional `b` carries a 26-bit imm (±128 MiB),
// a `b.cond`/`cbz`/`cbnz` a 19-bit imm (±1 MiB). A function's blocks are contiguous within its one
// chunk, so these resolve HERE (like x64's `resolveChunkRel32Fixups`), independent of concat.
type Arm64BlockBranchFixup
	export var codeOffset as CodeOffset
	export var targetBlock as BlockId
	export var wide as bool

	static function create(codeOffset CodeOffset, targetBlock BlockId, wide bool) returns Arm64BlockBranchFixup
		return Self{codeOffset: codeOffset, targetBlock: targetBlock, wide: wide}
	end 'create'
end 'Arm64BlockBranchFixup'

export typealias Arm64BlockBranchFixupArray = Array with Arm64BlockBranchFixup

// The four branch instructions with a PLACEHOLDER displacement, each returning its own chunk offset.
//
// ⚠ **THE PLACEHOLDER IS THE SHARED HALF, AND WHO RESOLVES IT IS THE DIFFERENCE.** A branch to a BLOCK
// records a fixup and is patched by `arm64ResolveBlockBranches` once the block layout is known; a branch
// inside ONE macro-op's instruction sequence has no block to name (the Std→Target lowerings cannot create
// blocks — see `TargetOp.arm64MemFill`) and is patched by that encoder itself, against a byte offset in this
// same buffer. Both spell the instruction here, once, so the two cannot come to disagree about its bytes.
function arm64EmitLocalBranch(code ByteArray) returns CodeOffset
	let site = code.count()
	emitArm64Insn(code, insn: Arm64OpB)
	return site
end 'arm64EmitLocalBranch'

function arm64EmitLocalCondBranch(code ByteArray, cond Arm64CondCode) returns CodeOffset
	let site = code.count()
	emitArm64Insn(code, insn: Arm64OpBcond or (cond.rawValue as MachineWord))
	return site
end 'arm64EmitLocalCondBranch'

function arm64EmitLocalCbz(code ByteArray, reg MachineWord) returns CodeOffset
	let site = code.count()
	emitArm64Insn(code, insn: Arm64OpCbz or reg)
	return site
end 'arm64EmitLocalCbz'

function arm64EmitLocalCbnz(code ByteArray, reg MachineWord) returns CodeOffset
	let site = code.count()
	emitArm64Insn(code, insn: Arm64OpCbnz or reg)
	return site
end 'arm64EmitLocalCbnz'

// `b` to a block — placeholder imm26, fixup recorded.
export function arm64EmitBranch(code ByteArray, fixups Arm64BlockBranchFixupArray, targetBlock BlockId)
	fixups.push(Arm64BlockBranchFixup.create(arm64EmitLocalBranch(code), targetBlock: targetBlock, wide: true))
end 'arm64EmitBranch'

// `b.cond` to a block — placeholder imm19, condition in the low nibble.
export function arm64EmitCondBranch(code ByteArray, fixups Arm64BlockBranchFixupArray, cond Arm64CondCode, targetBlock BlockId)
	fixups.push(Arm64BlockBranchFixup.create(arm64EmitLocalCondBranch(code, cond: cond), targetBlock: targetBlock, wide: false))
end 'arm64EmitCondBranch'

// `cbz`/`cbnz Xt` to a block — a fused zero-test with no preceding compare, placeholder imm19.
export function arm64EmitCbz(code ByteArray, fixups Arm64BlockBranchFixupArray, reg MachineWord, targetBlock BlockId)
	fixups.push(Arm64BlockBranchFixup.create(arm64EmitLocalCbz(code, reg: reg), targetBlock: targetBlock, wide: false))
end 'arm64EmitCbz'

export function arm64EmitCbnz(code ByteArray, fixups Arm64BlockBranchFixupArray, reg MachineWord, targetBlock BlockId)
	fixups.push(Arm64BlockBranchFixup.create(arm64EmitLocalCbnz(code, reg: reg), targetBlock: targetBlock, wide: false))
end 'arm64EmitCbnz'

// Patch every pending block branch to its target's chunk-local offset. A branch's displacement is
// PC-relative from the branch itself (not the end of a field, as on x64) and scaled by 4.
export function arm64ResolveBlockBranches(code ByteArray, blockOffsets BlockOffsetTable, fixups Arm64BlockBranchFixupArray)
	for fixup in fixups 'resolve'
		let targetOffset = try blockOffsets.get(fixup.targetBlock) otherwise panic("arm64ResolveBlockBranches: branch to block {fixup.targetBlock} with no recorded offset")
		if fixup.wide 'uncond'
			arm64PatchBranch26(code, codeOffset: fixup.codeOffset, targetOffset: targetOffset)
		end 'uncond' else 'cond'
			arm64PatchBranch19(code, codeOffset: fixup.codeOffset, targetOffset: targetOffset)
		end 'cond'
	end 'resolve'
end 'arm64ResolveBlockBranches'

// True when a two's-complement byte displacement falls outside the ±`reach` window — its value is
// either too-large positive or (as an unsigned wrap) too-large negative. A `String`-free arithmetic
// helper so each caller keeps its own specific overflow message without paying an eager allocation.
function arm64BranchOutOfReach(rel MachineWord, reach MachineWord) returns bool
	return rel > reach - 1 and rel < u64.max - reach + 1
end 'arm64BranchOutOfReach'

// Patch a 26-bit branch (`b`/`bl`) imm26 field, preserving the opcode bits [31:26]. Guards the
// ±128 MiB reach — an out-of-range branch is a loud link error, never a wrapped displacement.
function arm64PatchBranch26(code ByteArray, codeOffset CodeOffset, targetOffset CodeOffset)
	let rel = arm64RelBytes(targetOffset, codeOffset: codeOffset)
	if arm64BranchOutOfReach(rel, reach: Arm64BranchByteReach) 'overflow'
		panic("arm64PatchBranch26: branch displacement out of ±128 MiB (codeOffset={codeOffset}, target={targetOffset}) — relocation overflow")
	end 'overflow'
	let relInsns = arm64RelInstructions(rel)
	let orig = try readDword(code, offset: codeOffset) otherwise panic("arm64PatchBranch26: codeOffset {codeOffset} past end of code (count={code.count()})")
	patchDword(code, offset: codeOffset, value: (orig and (not Arm64Imm26Mask)) or (relInsns and Arm64Imm26Mask))
end 'arm64PatchBranch26'

// Patch a 19-bit branch (`b.cond`/`cbz`/`cbnz`) imm19 field at bit 5, preserving bits [31:24] (the
// opcode + condition/op) and [4:0] (the Rt of a cbz/cbnz). Guards the ±1 MiB reach.
function arm64PatchBranch19(code ByteArray, codeOffset CodeOffset, targetOffset CodeOffset)
	let rel = arm64RelBytes(targetOffset, codeOffset: codeOffset)
	if arm64BranchOutOfReach(rel, reach: Arm64CondBranchByteReach) 'overflow'
		panic("arm64PatchBranch19: conditional-branch displacement out of ±1 MiB (codeOffset={codeOffset}, target={targetOffset}) — relocation overflow")
	end 'overflow'
	let relInsns = arm64RelInstructions(rel)
	let orig = try readDword(code, offset: codeOffset) otherwise panic("arm64PatchBranch19: codeOffset {codeOffset} past end of code (count={code.count()})")
	patchDword(code, offset: codeOffset, value: (orig and 0xFF00001F) or ((relInsns and Arm64Imm19Mask) shl Arm64Imm19Shift))
end 'arm64PatchBranch19'

// The signed byte displacement `target − instr`, wrapped into u64 two's-complement.
function arm64RelBytes(targetOffset CodeOffset, codeOffset CodeOffset) returns MachineWord
	if targetOffset >= codeOffset 'forward'
		return targetOffset - codeOffset
	end 'forward'
	return u64.max - (codeOffset - targetOffset) + 1
end 'arm64RelBytes'

// A byte displacement as a count of instructions (÷4), sign-preserving on the two's-complement value.
function arm64RelInstructions(relBytes MachineWord) returns MachineWord
	if relBytes < Arm64WordSignBit 'nonNeg'
		return relBytes / 4
	end 'nonNeg'
	// Negative: arithmetic shift by dividing the magnitude and re-wrapping.
	let magnitude = u64.max - relBytes + 1
	return u64.max - (magnitude / 4) + 1
end 'arm64RelInstructions'

// ==========================================================================
// The per-op encoder
// ==========================================================================

// Encode one arm64 `TargetOp` into `code`, recording call / rdata / func-address / block-branch fixups.
// `callFixups` collects `bl` sites concat resolves by name; `rdataRelocs` collects the ADRP+ADD/LDR
// code→data references the writer patches; `funcAdrpRelocs` collects `leaFuncAddr` code→`.text`-function
// address pairs (concat resolves the target offset, the writer patches the pair); `branchFixups` collects
// within-function branches resolved once every block's offset is known. EXHAUSTIVE over `TargetOp`: the
// x64-only arms panic (the x64 encoder owns them — `buildBackend` dispatches on `target.cpu`), and the
// SHARED arms arm64 reuses (`movRegReg`, the spill/reload and base+disp forms, `xchgRegReg`) are encoded
// here.
function emitArm64TargetOp(op TargetOp, code ByteArray, callFixups CallFixupArray, rdataRelocs RdataRelocationArray, iatRelocs RelocationArray, funcAdrpRelocs Arm64FuncAdrpRelocArray, branchFixups Arm64BlockBranchFixupArray, jumpTables JumpTablePendingArray, shimmed bool)
	match op 'emit'
		// --- x64-only control/frame band ---
		prologue to movRegImm32 then panic("emitArm64TargetOp: an x64 control/frame op reached the arm64 encoder — the x64 encoder owns the x64 band (buildBackend dispatches on target.cpu)")
		// --- shared: reg-reg move ---
		movRegReg(dest, src) then arm64EmitRegRegMove(code, dest: dest, src: src)
		// --- x64-only ALU band ---
		movReg32Reg32 to cmpRegImm32 then panic("emitArm64TargetOp: an x64 ALU op reached the arm64 encoder")
		// --- shared: post-coloring swap ---
		xchgRegReg(a, b) then arm64EmitRegRegSwap(code, a: a, b: b)
		// --- x64-only call/div/frame band ---
		callDirect to popReg then panic("emitArm64TargetOp: an x64 call/idiv/push/pop op reached the arm64 encoder")
		// --- shared: spill / reload ---
		storeSlotReg(slot, srcReg) then arm64EmitStoreSlot(code, slot: slot, srcReg: srcReg)
		loadRegSlot(destReg, slot) then arm64EmitLoadSlot(code, destReg: destReg, slot: slot)
		// --- x64-only word ALU / shift / setcc / lea-global band ---
		andRegReg to leaRegGlobal then panic("emitArm64TargetOp: an x64 word-ALU/shift/setcc op reached the arm64 encoder")
		// --- shared: base+disp data access ---
		loadRegBaseDisp(dest, base, disp, width) then arm64EmitDataLoad(code, dest: dest, base: arm64GprField(base), disp: disp, width: width)
		storeBaseDispReg(base, disp, src, width) then arm64EmitDataStore(code, base: arm64GprField(base), disp: disp, src: src, width: width)
		// --- x64-only SSE band ---
		// The endpoint MOVED when `movqXmmGpr` was appended to the end of the x64 SSE band: this range
		// means "the x64 float ops", and its last member is whichever one that band currently ends on.
		addsdRegReg to negF64RegReg then panic("emitArm64TargetOp: an x64 SSE op reached the arm64 encoder")
		// `minsd`/`maxsd` are inside the range above; the arm64 spelling of `min`/`max` is `fcmp` +
		// `fcsel`, not one op.
		// --- arm64 band ---
		arm64Ret then emitArm64Insn(code, insn: Arm64OpRet)
		arm64Branch(targetBlockId) then arm64EmitBranch(code, fixups: branchFixups, targetBlock: targetBlockId)
		arm64CondBranch(cond, targetBlockId) then arm64EmitCondBranch(code, fixups: branchFixups, cond: cond, targetBlock: targetBlockId)
		arm64Cbz(reg, targetBlockId) then arm64EmitCbz(code, fixups: branchFixups, reg: arm64GprField(reg), targetBlock: targetBlockId)
		arm64Cbnz(reg, targetBlockId) then arm64EmitCbnz(code, fixups: branchFixups, reg: arm64GprField(reg), targetBlock: targetBlockId)
		arm64MovImm(dest, value) then arm64EmitMovImm(code, rd: arm64GprField(dest), value: value)
		arm64Prologue(stackSize, recordOffset) then arm64EmitPrologue(code, frameSize: stackSize, recordOffset: recordOffset)
		arm64Epilogue(stackSize, recordOffset) then arm64EmitEpilogue(code, frameSize: stackSize, recordOffset: recordOffset)
		arm64Add(dest, lhs, rhs) then emitArm64Rrr(code, opcode: Arm64OpAdd, rd: arm64GprField(dest), rn: arm64GprField(lhs), rm: arm64GprField(rhs))
		arm64Sub(dest, lhs, rhs) then emitArm64Rrr(code, opcode: Arm64OpSub, rd: arm64GprField(dest), rn: arm64GprField(lhs), rm: arm64GprField(rhs))
		arm64Mul(dest, lhs, rhs) then emitArm64Rrr(code, opcode: Arm64OpMul, rd: arm64GprField(dest), rn: arm64GprField(lhs), rm: arm64GprField(rhs))
		arm64Sdiv(dest, lhs, rhs) then emitArm64Rrr(code, opcode: Arm64OpSdiv, rd: arm64GprField(dest), rn: arm64GprField(lhs), rm: arm64GprField(rhs))
		arm64Udiv(dest, lhs, rhs) then emitArm64Rrr(code, opcode: Arm64OpUdiv, rd: arm64GprField(dest), rn: arm64GprField(lhs), rm: arm64GprField(rhs))
		arm64Msub(dest, mulLhs, mulRhs, minuend) then arm64EmitMsub(code, rd: arm64GprField(dest), rn: arm64GprField(mulLhs), rm: arm64GprField(mulRhs), ra: arm64GprField(minuend))
		arm64And(dest, lhs, rhs) then emitArm64Rrr(code, opcode: Arm64OpAnd, rd: arm64GprField(dest), rn: arm64GprField(lhs), rm: arm64GprField(rhs))
		arm64Orr(dest, lhs, rhs) then emitArm64Rrr(code, opcode: Arm64OpOrr, rd: arm64GprField(dest), rn: arm64GprField(lhs), rm: arm64GprField(rhs))
		arm64Eor(dest, lhs, rhs) then emitArm64Rrr(code, opcode: Arm64OpEor, rd: arm64GprField(dest), rn: arm64GprField(lhs), rm: arm64GprField(rhs))
		arm64Lslv(dest, lhs, rhs) then emitArm64Rrr(code, opcode: Arm64OpLslv, rd: arm64GprField(dest), rn: arm64GprField(lhs), rm: arm64GprField(rhs))
		arm64Asrv(dest, lhs, rhs) then emitArm64Rrr(code, opcode: Arm64OpAsrv, rd: arm64GprField(dest), rn: arm64GprField(lhs), rm: arm64GprField(rhs))
		arm64Lsrv(dest, lhs, rhs) then emitArm64Rrr(code, opcode: Arm64OpLsrv, rd: arm64GprField(dest), rn: arm64GprField(lhs), rm: arm64GprField(rhs))
		arm64Neg(dest, src) then emitArm64Rrr(code, opcode: Arm64OpSub, rd: arm64GprField(dest), rn: Arm64XzrField, rm: arm64GprField(src))
		arm64Mvn(dest, src) then emitArm64Rrr(code, opcode: Arm64OpOrn, rd: arm64GprField(dest), rn: Arm64XzrField, rm: arm64GprField(src))
		arm64AddImm(dest, src, imm) then arm64EmitAddImmSigned(code, rd: arm64GprField(dest), rn: arm64GprField(src), imm: imm)
		arm64SubImm(dest, src, imm) then arm64EmitSubImmSigned(code, rd: arm64GprField(dest), rn: arm64GprField(src), imm: imm)
		arm64AndImm(dest, src, imm) then arm64EmitLogicalImm(code, opcode: Arm64OpAndImm, rd: arm64GprField(dest), rn: arm64GprField(src), value: imm32ToWord(imm))
		arm64OrrImm(dest, src, imm) then arm64EmitLogicalImm(code, opcode: Arm64OpOrrImm, rd: arm64GprField(dest), rn: arm64GprField(src), value: imm32ToWord(imm))
		arm64EorImm(dest, src, imm) then arm64EmitLogicalImm(code, opcode: Arm64OpEorImm, rd: arm64GprField(dest), rn: arm64GprField(src), value: imm32ToWord(imm))
		arm64LslImm(dest, src, imm) then arm64EmitLslImm(code, rd: arm64GprField(dest), rn: arm64GprField(src), sh: imm)
		arm64AsrImm(dest, src, imm) then arm64EmitAsrImm(code, rd: arm64GprField(dest), rn: arm64GprField(src), sh: imm)
		arm64LsrImm(dest, src, imm) then arm64EmitLsrImm(code, rd: arm64GprField(dest), rn: arm64GprField(src), sh: imm)
		arm64Cmp(lhs, rhs) then arm64EmitCmpReg(code, rn: arm64GprField(lhs), rm: arm64GprField(rhs))
		arm64CmpImm(reg, imm) then arm64EmitCmpImm(code, rn: arm64GprField(reg), imm: imm)
		arm64Cset(dest, cond) then arm64EmitCset(code, rd: arm64GprField(dest), cond: cond)
		arm64LeaFuncAddr(dest, funcName) then arm64EmitLeaFuncAddr(code, funcAdrpRelocs: funcAdrpRelocs, dest: arm64GprField(dest), funcName: funcName)
		arm64LeaRdata(dest, label) then arm64EmitAdrpAddPair(code, rdataRelocs: rdataRelocs, dest: arm64GprField(dest), label: label, adrpKind: RdataRelocKind.arm64Adrp, pageOffKind: RdataRelocKind.arm64PageOff)
		arm64LeaGlobal(dest, label) then arm64EmitAdrpAddPair(code, rdataRelocs: rdataRelocs, dest: arm64GprField(dest), label: label, adrpKind: RdataRelocKind.dataSectionArm64Adrp, pageOffKind: RdataRelocKind.dataSectionArm64PageOff)
		arm64BranchLink(targetName) then arm64EmitBranchLink(code, callFixups: callFixups, targetName: targetName)
		arm64BranchLinkReg(reg) then emitArm64Insn(code, insn: Arm64OpBlr or (arm64GprField(reg) shl Arm64RnShift))
		arm64Fadd(dest, lhs, rhs) then emitArm64Rrr(code, opcode: Arm64OpFaddD, rd: arm64FpField(dest), rn: arm64FpField(lhs), rm: arm64FpField(rhs))
		arm64Fsub(dest, lhs, rhs) then emitArm64Rrr(code, opcode: Arm64OpFsubD, rd: arm64FpField(dest), rn: arm64FpField(lhs), rm: arm64FpField(rhs))
		arm64Fmul(dest, lhs, rhs) then emitArm64Rrr(code, opcode: Arm64OpFmulD, rd: arm64FpField(dest), rn: arm64FpField(lhs), rm: arm64FpField(rhs))
		arm64Fdiv(dest, lhs, rhs) then emitArm64Rrr(code, opcode: Arm64OpFdivD, rd: arm64FpField(dest), rn: arm64FpField(lhs), rm: arm64FpField(rhs))
		arm64Fcmp(lhs, rhs) then emitArm64Insn(code, insn: Arm64OpFcmpD or (arm64FpField(rhs) shl Arm64RmShift) or (arm64FpField(lhs) shl Arm64RnShift))
		arm64Scvtf(dest, src) then emitArm64Rr(code, opcode: Arm64OpScvtfD, rd: arm64FpField(dest), rn: arm64GprField(src))
		arm64Fcvtzs(dest, src) then emitArm64Rr(code, opcode: Arm64OpFcvtzsD, rd: arm64GprField(dest), rn: arm64FpField(src))
		// The MATH INTRINSICS — all three are FP-to-FP 2-register forms, so all three ride `emitArm64Rr`
		// unchanged; only `frint`'s rounding rides an opcode field.
		arm64Fsqrt(dest, src) then emitArm64Rr(code, opcode: Arm64OpFsqrtD, rd: arm64FpField(dest), rn: arm64FpField(src))
		arm64Fabs(dest, src) then emitArm64Rr(code, opcode: Arm64OpFabsD, rd: arm64FpField(dest), rn: arm64FpField(src))
		arm64Fneg(dest, src) then emitArm64Rr(code, opcode: Arm64OpFnegD, rd: arm64FpField(dest), rn: arm64FpField(src))
		arm64Frint(dest, src, mode) then emitArm64Rr(code, opcode: arm64FrintOpcode(mode), rd: arm64FpField(dest), rn: arm64FpField(src))
		// `fcsel` is an ordinary FP 3-register form once its condition is folded into the opcode word,
		// so it rides `emitArm64Rrr` unchanged — the same trick `arm64Frint` uses for its rounding mode.
		// `ifTrue` is `Rn` and `ifFalse` is `Rm`, matching `FCSEL Dd, Dn, Dm, cond`'s "Dn when cond".
		arm64Fcsel(dest, ifTrue, ifFalse, cond) then emitArm64Rrr(code, opcode: Arm64OpFcselD or ((cond.rawValue as MachineWord) shl Arm64CondFieldShift), rd: arm64FpField(dest), rn: arm64FpField(ifTrue), rm: arm64FpField(ifFalse))
		arm64FpLoadRdata(dest, label) then arm64EmitFpLoadRdata(code, rdataRelocs: rdataRelocs, dest: arm64FpField(dest), label: label)
		// The GOT-indirect libSystem import call (`osAllocPages`→mmap, `osWriteStdout`→write). The same
		// `arm64EmitImportCall` the hand-assembled entry stub uses for `_exit`, so a call inside a
		// register-allocated function and one in the stub file the SAME relocation shape.
		arm64ImportCall(slotIndex) then emitArm64GtGatedImportCall(code, rdataRelocs: rdataRelocs, iatRelocs: iatRelocs, slotIndex: slotIndex, shimmed: shimmed)
		// The Linux raw supervisor call (`osExit`/`osWriteStdout`/`osAllocPages` on arm64-linux). The
		// same `arm64EmitSyscall` the hand-assembled entry stub uses for `exit_group`, so a syscall
		// inside a register-allocated function and one in the stub encode identically.
		arm64Syscall(number) then arm64EmitSyscall(code, number: number)
		// --- x64-only tail bands (P1.5-A1 function values, x64-linux syscall) ---
		// `leaRegFunc`/`callReg` are the x64 isel's function-value ops (`lea dest, [rip+func]` and
		// `call reg`), and `x64Syscall` is the x64-linux raw syscall; reaching the arm64 encoder is the
		// same target-dispatch bug the x64-only bands above panic on. arm64's own function-value ops are
		// `arm64LeaFuncAddr`/`arm64BranchLinkReg`, and its syscall is `arm64Syscall`.
		leaRegFunc to x64Syscall then panic("emitArm64TargetOp: an x64-only op (`leaRegFunc`/`callReg`/`x64Syscall`) reached the arm64 encoder — the x64 encoder owns the x64 band (buildBackend dispatches on target.cpu)")
		callMem then panic("emitArm64TargetOp: the x64-only `callMem` (the fused memory-indirect witness call) reached the arm64 encoder — arm64 LOWERS a witness dispatch instead, to `loadRegBaseDisp` of the slot followed by `arm64BranchLinkReg`, so it never mints one of these")
		// The dense-match jump table: the imm12-safe cmp/b.hs/adrp+add/ldrsw/add/br sequence, its default-edge
		// b.hs fixup and table-address ADRP+ADD reloc filed inline, its per-slot block-address relocs recorded
		// in `jumpTables`. The x64 jump table never reaches the arm64 encoder.
		arm64JumpTable(indexReg, defaultTarget, caseTargets, tableLabel) then arm64EmitJumpTable(code, rdataRelocs: rdataRelocs, branchFixups: branchFixups, jumpTables: jumpTables, indexReg: arm64GprField(indexReg), defaultTarget: defaultTarget, caseTargets: caseTargets, tableLabel: tableLabel)
		x64JumpTable then panic("emitArm64TargetOp: an x64 jump table reached the arm64 encoder — the x64 backend encodes `x64JumpTable`")
		arm64StoreOutgoingArg(slot, srcReg) then arm64EmitStoreOutgoingArg(code, slot: slot, srcReg: srcReg)
		// `Arm64PrologueEpilogue.resolveArm64IncomingArgs` rewrites every one of these into a concrete
		// `[x29 + disp]` load, because only that pass knows the final frame size. One reaching here means the
		// pass did not run or missed a block — a guess at the displacement would be a silent wrong read.
		arm64LoadIncomingArg(_, slot) then panic("emitArm64TargetOp: an unresolved `arm64LoadIncomingArg` (slot {slot}) reached the encoder — Arm64PrologueEpilogue must rewrite each into `[x29 + frameSize - outgoingArgSize + slot*8]` before emission")
		// The BIT REINTERPRETATION (`float.hash`) — `FMOV Xd, Dn`. The ONE arm here reading `arm64FpField`
		// for its source and `arm64GprField` for its destination in a form that is not a convert:
		// `fcvtzs` above shares that pair of doors, this one shares nothing else with it.
		arm64FmovGprFp(dest, src) then emitArm64Rr(code, opcode: Arm64OpFmovGprFromFp, rd: arm64GprField(dest), rn: arm64FpField(src))
		// The INVERSE, `FMOV Dd, Xn` — the same two doors swapped, which is why it is a separate arm and
		// not a widened one: `arm64GprField`/`arm64FpField` assert the class of the register they name,
		// so which door each end goes through IS the direction. `scvtf` above is its converting neighbour
		// (same files, same order) and shares nothing else with it.
		arm64FmovFpGpr(dest, src) then emitArm64Rr(code, opcode: Arm64OpFmovFpFromGpr, rd: arm64FpField(dest), rn: arm64GprField(src))
		// `add destReg, x29, #slotDisp` — the ADDRESS of a frame slot, through the SAME
		// `arm64SlotDisplacement` the spill/reload pair resolve their slots with.
		leaRegSlot(destReg, slot) then arm64EmitSlotAddress(code, destReg: destReg, slot: slot)
		// F1b: the byte-fill size ladder. The two operands are already in x0/x1 (the isel's pre-moves), so
		// the op carries only the broadcast pattern — see `arm64EmitMemFill`.
		arm64MemFill(fillByte) then arm64EmitMemFill(code, fillByte: fillByte)
		x64MemFill then panic("emitArm64TargetOp: an x64 fill ladder reached the arm64 encoder — the x64 backend encodes `x64MemFill`")
		// F2: the two LL/SC retry loops and the masked thread-pointer read. Each expands to a self-contained
		// instruction sequence with locally patched branches — see `arm64EmitAtomicCas`.
		arm64AtomicCas(dest, addrReg, expectedReg, replacementReg) then arm64EmitAtomicCas(code, dest: arm64GprField(dest), addrReg: arm64GprField(addrReg), expectedReg: arm64GprField(expectedReg), replacementReg: arm64GprField(replacementReg))
		arm64AtomicRmw(dest, addrReg, operandReg, opcode) then arm64EmitAtomicRmw(code, dest: arm64GprField(dest), addrReg: arm64GprField(addrReg), operandReg: arm64GprField(operandReg), opcode: opcode)
		arm64ThreadPointer(dest, source) then arm64EmitThreadPointer(code, dest: arm64GprField(dest), source: source)
		// x64's atomics never reach the arm64 encoder, exactly as its fill ladder and jump table do not.
		x64LockCmpxchg to x64GsLoadRegBase then panic("emitArm64TargetOp: an x64-only atomic or TEB read reached the arm64 encoder — arm64's atomics are `arm64AtomicCas`/`arm64AtomicRmw` and its thread token is `arm64ThreadPointer`")
		// EC16 — x64's scaled-index band. arm64 spells the same address as `arm64AddLsl` below, and has no
		// equivalent of the indexed load/store here at all (see `TargetDialect.arm64AddLsl`).
		leaRegBaseIndexScale to storeBaseIndexScaleReg then panic("emitArm64TargetOp: an x64 scaled-index address or access reached the arm64 encoder — arm64's scaled-index address is `arm64AddLsl`, and its loads and stores carry no index")
		// `ADD Xd, Xn, Xm, LSL #amount` — the shifted-register form of the `add` one band up, and the same
		// three-register emitter: the shift amount is a FIELD of the opcode word (bits 15-10), not a fourth
		// operand, so nothing about the register encoding changes.
		arm64AddLsl(dest, base, index, scale) then emitArm64Rrr(code, opcode: Arm64OpAdd or (memoryIndexScaleShift(scale) shl Arm64ShiftedRegAmountShift), rd: arm64GprField(dest), rn: arm64GprField(base), rm: arm64GprField(index))
		// EC18 — x64's one-operand `imul`. arm64's equivalent is `SMULH Xd, Xn, Xm`, a THREE-operand
		// instruction with no fixed-register pair, which is a different op of its own and does not exist
		// in this dialect yet; `StrengthReduceDivision` asks `targetLowersMulHigh` and reduces nothing on
		// this lane, so no arm64 program can contain one.
		imulHighReg then panic("emitArm64TargetOp: an x64 one-operand `imul` reached the arm64 encoder — AArch64 spells the high half of a signed product as `SMULH`, which this dialect does not carry")
	end 'emit'
end 'emitArm64TargetOp'

// ⭐ **THE arm64 JUMP-TABLE SEQUENCE (imm12-safe).** `movz x16, #N` / `cmp idx, x16` / `b.hs default`;
// `adrp x17, table` + `add x17, x17, #pageoff`; `ldrsw x16, [x17, idx, LSL #2]`; `add x17, x17, x16`;
// `br x17`. ⚠⚠ The count N is MATERIALISED into x16 and compared register-to-register — NEVER `cmp idx, #N`.
// The CMP imm12 field holds only 0..4095, but the density selector admits a span of EXACTLY 4096, and 4096
// (0x1000) spills into the shifted-imm12 (LSL #12) bit: `cmp idx, #4096` silently assembles as `cmp idx, #0
// << 12`, comparing against 0, sending EVERY value to the default. The register form is correct for any
// count and does not tie this encoder's correctness to the span-cap constant (the exact bug the bootstrap
// review caught). x16/x17 are the IP scratch pair (outside the allocatable pool), so the live index reg is
// provably neither — no aliasing guard needed, unlike x64's r10/r11.
function arm64EmitJumpTable(code ByteArray, rdataRelocs RdataRelocationArray, branchFixups Arm64BlockBranchFixupArray, jumpTables JumpTablePendingArray, indexReg MachineWord, defaultTarget BlockId, caseTargets BlockIdArray, tableLabel ByteArray)
	arm64EmitMovImm(code, rd: Arm64Ip0, value: caseTargets.count())
	arm64EmitCmpReg(code, rn: indexReg, rm: Arm64Ip0)
	arm64EmitCondBranch(code, fixups: branchFixups, cond: Arm64CondCode.hs, targetBlock: defaultTarget)
	arm64EmitAdrpAddPair(code, rdataRelocs: rdataRelocs, dest: Arm64Ip1, label: tableLabel, adrpKind: RdataRelocKind.arm64Adrp, pageOffKind: RdataRelocKind.arm64PageOff)
	emitArm64Insn(code, insn: Arm64OpLdrswRegLsl2 or (indexReg shl Arm64RmShift) or (Arm64Ip1 shl Arm64RnShift) or Arm64Ip0)
	emitArm64Rrr(code, opcode: Arm64OpAdd, rd: Arm64Ip1, rn: Arm64Ip1, rm: Arm64Ip0)
	emitArm64Insn(code, insn: Arm64OpBr or (Arm64Ip1 shl Arm64RnShift))
	jumpTables.push(JumpTablePending.create(String.from(tableLabel), caseTargets: caseTargets))
end 'arm64EmitJumpTable'

// --- F1b: the byte-fill SIZE LADDER (arm64) ---

// The four FIXED registers `arm64EmitMemFill` owns — the first four AAPCS64 argument registers, which is
// what the isel's pre-moves already use for a syscall's arguments. The isel puts the destination in the
// cursor and the byte count in the count register (`lowerMemFill`); the ladder then writes all four.
//
// ⭐⭐ **DELIBERATELY NOT x16/x17, WHICH IS WHERE THIS BACKEND'S OTHER ENCODER-TIER SCRATCH LIVES.** Two
// reasons, and either alone would decide it: the ladder needs FOUR registers and the IP pair is two, and
// `arm64EmitWideFrameSlot`'s header records that x16 is straddled by isel-minted producer/consumer pairs, so
// only x17 is safe there at all. x0..x3 are ALLOCATABLE instead — which means the clobber must be DECLARED,
// and it is, on `TargetOp.arm64MemFill`'s `implicitDefs`, held equal to `arm64MemFillScratchMask()` by
// `assertEncoderScratchMasks`. That is the same bargain x64's ladder makes, for the same reason.
let Arm64MemFillCursor = 0  // x0 — advances through the region
let Arm64MemFillCount = 1  // x1 — bytes remaining
let Arm64MemFillEnd = 2  // x2 — pinned to the region's END, so every arm can anchor a backward store
let Arm64MemFillPattern = 3  // x3 — the broadcast fill word

// The two the ISEL pre-moves into, in the allocator's currency, so the isel and this encoder name ONE set of
// registers rather than two spellings that could drift (the shape `Arm64Ip1RegNum` already takes).
export let Arm64MemFillCursorRegNum = Arm64MemFillCursor as RegNum
export let Arm64MemFillCountRegNum = Arm64MemFillCount as RegNum

// The ladder's clobber, as the allocator's currency. `TargetOp.arm64MemFill`'s inline `implicitDefs` literal
// is checked against this (`assertEncoderScratchMasks`).
export function arm64MemFillScratchMask() returns RegMask
	var mask = 0 as RegMask
	mask = regMaskAdd(mask, regNum: Arm64MemFillCursorRegNum)
	mask = regMaskAdd(mask, regNum: Arm64MemFillCountRegNum)
	mask = regMaskAdd(mask, regNum: Arm64MemFillEnd as RegNum)
	mask = regMaskAdd(mask, regNum: Arm64MemFillPattern as RegNum)
	return mask
end 'arm64MemFillScratchMask'

// The ladder's band edges, in bytes — x64's, minus the `rep stosq` rung it has no analogue for. Each
// straight-line band is covered by `edge / 16` overlapping STP pairs from EACH end, so the edge and the
// store count are one number rather than two that could disagree.
let Arm64MemFillWordBytes = 8  // one STR — the 8..15 band, too narrow for a pair to fit twice
let Arm64MemFillPairBytes = 16  // one STP of the pattern pair: 16 bytes, a single micro-op
let Arm64MemFillTwoPairBytes = 32

// Bytes per iteration of the bulk loop (4 STP pairs), and the lower edge of the loop band. With no `rep`
// analogue on this ISA the bulk loop IS the large path — there is no third arm above it.
let Arm64MemFillLoopStride = 64

// `count` consecutive `stp pattern, pattern` pairs (16 bytes each) from `[base + startOffset]` upward.
//
// ⭐ STP rather than STR: an STP retires as a SINGLE micro-op writing 16 bytes, so it halves the instruction
// count at identical store bandwidth. And no `dc zva` anywhere in this ladder — it needs the block size read
// from DCZID_EL0, wants 64-byte alignment, can be turned off by DCZID_EL0.DZP, and buys nothing at the 8..64
// byte sizes that dominate the allocator's hot path.
function arm64EmitFillPairRun(code ByteArray, baseReg MachineWord, startOffset Imm32, count MachineWord)
	for i in 0 upto count 'pairs'
		// ⚠ The cast brackets the WHOLE sum. `a + b as Imm32` casts only `b` — `as` binds tighter than `+` —
		// which leaves the sum at whatever wider type the operands join to and pushes the narrowing onto the
		// callee's parameter bind. Stated as its own `let` so the reading cannot be mistaken.
		let byteOffset = (startOffset + i * Arm64MemFillPairBytes) as Imm32
		arm64EmitPairOffset(code, opcode: Arm64OpStpOffX, rt1: Arm64MemFillPattern, rt2: Arm64MemFillPattern, baseReg: baseReg, byteOffset: byteOffset)
	end 'pairs'
end 'arm64EmitFillPairRun'

// The OVERLAP trick, arm64's spelling — see `encodeMemFillOverlappingSpan` (x64) for the full argument. For
// a length at least `spanBytes` and under twice it, `spanBytes/16` pairs forward from the cursor and
// `spanBytes/16` pairs backward from the end cover the whole region with straight-line code, the middle
// written twice and no ragged tail to test for.
function arm64EmitFillOverlappingSpan(code ByteArray, spanBytes MachineWord)
	let pairs = spanBytes / Arm64MemFillPairBytes
	arm64EmitFillPairRun(code, baseReg: Arm64MemFillCursor, startOffset: 0, count: pairs)
	arm64EmitFillPairRun(code, baseReg: Arm64MemFillEnd, startOffset: -(spanBytes as Imm32), count: pairs)
end 'arm64EmitFillOverlappingSpan'

// ⭐⭐ **THE FILL LADDER, arm64.** The counterpart of `encodeX64MemFill` and the same shape — a size dispatch
// inside ONE macro-op's encoder, with locally patched branches, because the Std→Target lowerings cannot
// create blocks. The bands are ARCHITECTURE.md's:
//
//   < 8       byte loop
//   8..15     one STR forward, one STUR backward off the end
//   16..63    straight-line OVERLAPPING STP pairs, 1 or 2 from each end
//   >= 64     4-pair (64 byte) store loop, then one overlapping 64-byte block
//
// x2 is pinned to the region's END before anything mutates x0/x1, and left alone.
//
// A count of 0 falls into the `< 8` arm and its `cbz` exits at once, writing nothing.
function arm64EmitMemFill(code ByteArray, fillByte ParsedInt)
	arm64EmitMovImm(code, rd: Arm64MemFillPattern, value: memFillPatternWord(fillByte))
	emitArm64Rrr(code, opcode: Arm64OpAdd, rd: Arm64MemFillEnd, rn: Arm64MemFillCursor, rm: Arm64MemFillCount)

	// UNSIGNED (`lo`/`hs`) throughout — a byte count is a length, and a signed compare would send a
	// >= 2^63 count down the wrong arm rather than simply being unreachable.
	arm64EmitCmpImm(code, rn: Arm64MemFillCount, imm: Arm64MemFillWordBytes)
	let toByteLoop = arm64EmitLocalCondBranch(code, cond: Arm64CondCode.lo)
	arm64EmitCmpImm(code, rn: Arm64MemFillCount, imm: Arm64MemFillPairBytes)
	let toOneWord = arm64EmitLocalCondBranch(code, cond: Arm64CondCode.lo)
	arm64EmitCmpImm(code, rn: Arm64MemFillCount, imm: Arm64MemFillTwoPairBytes)
	let toOnePair = arm64EmitLocalCondBranch(code, cond: Arm64CondCode.lo)
	arm64EmitCmpImm(code, rn: Arm64MemFillCount, imm: Arm64MemFillLoopStride)
	let toTwoPairs = arm64EmitLocalCondBranch(code, cond: Arm64CondCode.lo)

	// >= 64: whole 64-byte blocks, then ONE overlapping 64-byte block anchored at the end. The count is at
	// least 64 on entry, so `[end-64, end)` is always inside the region and needs no remainder test.
	let loopTop = code.count()
	arm64EmitFillPairRun(code, baseReg: Arm64MemFillCursor, startOffset: 0, count: Arm64MemFillLoopStride / Arm64MemFillPairBytes)
	arm64EmitAddImmSigned(code, rd: Arm64MemFillCursor, rn: Arm64MemFillCursor, imm: Arm64MemFillLoopStride)
	arm64EmitSubImmSigned(code, rd: Arm64MemFillCount, rn: Arm64MemFillCount, imm: Arm64MemFillLoopStride)
	arm64EmitCmpImm(code, rn: Arm64MemFillCount, imm: Arm64MemFillLoopStride)
	arm64PatchBranch19(code, codeOffset: arm64EmitLocalCondBranch(code, cond: Arm64CondCode.hs), targetOffset: loopTop)
	arm64EmitFillPairRun(code, baseReg: Arm64MemFillEnd, startOffset: -(Arm64MemFillLoopStride as Imm32), count: Arm64MemFillLoopStride / Arm64MemFillPairBytes)
	let doneFromLoop = arm64EmitLocalBranch(code)

	arm64PatchBranch19(code, codeOffset: toTwoPairs, targetOffset: code.count())
	arm64EmitFillOverlappingSpan(code, spanBytes: Arm64MemFillTwoPairBytes)
	let doneFromTwoPairs = arm64EmitLocalBranch(code)

	arm64PatchBranch19(code, codeOffset: toOnePair, targetOffset: code.count())
	arm64EmitFillOverlappingSpan(code, spanBytes: Arm64MemFillPairBytes)
	let doneFromOnePair = arm64EmitLocalBranch(code)

	// 8..15: one word from each end. A PAIR does not fit twice here, so this is the one band the STP run
	// above cannot serve — hence the STR/STUR spelling, and hence `Arm64MemFillWordBytes` existing at all.
	arm64PatchBranch19(code, codeOffset: toOneWord, targetOffset: code.count())
	arm64EmitScaledMem(code, opcode: Arm64OpStrX, rt: Arm64MemFillPattern, baseReg: Arm64MemFillCursor, byteOffset: 0, scale: SpillSlotBytes)
	arm64EmitUnscaledMem(code, opcode: Arm64OpSturX, rt: Arm64MemFillPattern, baseReg: Arm64MemFillEnd, byteOffset: -(Arm64MemFillWordBytes as Imm32))
	let doneFromOneWord = arm64EmitLocalBranch(code)

	// 0..7: a byte loop. There is no whole word to anchor an overlap on, and this band is the rare one.
	arm64PatchBranch19(code, codeOffset: toByteLoop, targetOffset: code.count())
	let doneFromEmpty = arm64EmitLocalCbz(code, reg: Arm64MemFillCount)
	let byteLoopTop = code.count()
	arm64EmitScaledMem(code, opcode: Arm64OpStrB, rt: Arm64MemFillPattern, baseReg: Arm64MemFillCursor, byteOffset: 0, scale: Arm64ByteAccessScale)
	arm64EmitAddImmSigned(code, rd: Arm64MemFillCursor, rn: Arm64MemFillCursor, imm: 1)
	arm64EmitSubImmSigned(code, rd: Arm64MemFillCount, rn: Arm64MemFillCount, imm: 1)
	arm64PatchBranch19(code, codeOffset: arm64EmitLocalCbnz(code, reg: Arm64MemFillCount), targetOffset: byteLoopTop)

	let done = code.count()
	arm64PatchBranch26(code, codeOffset: doneFromLoop, targetOffset: done)
	arm64PatchBranch26(code, codeOffset: doneFromTwoPairs, targetOffset: done)
	arm64PatchBranch26(code, codeOffset: doneFromOnePair, targetOffset: done)
	arm64PatchBranch26(code, codeOffset: doneFromOneWord, targetOffset: done)
	arm64PatchBranch19(code, codeOffset: doneFromEmpty, targetOffset: done)
end 'arm64EmitMemFill'

// storeSlotReg / loadRegSlot are CLASS-AGNOSTIC (an 8-byte slot holds a GPR or an f64); the
// instruction is chosen from the resolved register's file.
function arm64EmitStoreSlot(code ByteArray, slot SpillSlot, srcReg TargetVReg)
	let disp = arm64SlotDisplacement(slot)
	if arm64VRegIsGpr(srcReg) 'gpr'
		arm64EmitFrameSlot(code, rt: arm64GprField(srcReg), byteOffset: disp, unscaledOp: Arm64OpSturX, scaledOp: Arm64OpStrX)
	end 'gpr' else 'fp'
		arm64EmitFrameSlot(code, rt: arm64FpField(srcReg), byteOffset: disp, unscaledOp: Arm64OpSturD, scaledOp: Arm64OpStrD)
	end 'fp'
end 'arm64EmitStoreSlot'

// `add destReg, x29, #slotDisp` — the ADDRESS of frame slot `slot`, the address twin of
// `arm64EmitStoreSlot`/`arm64EmitLoadSlot` above. It reads the SAME `arm64SlotDisplacement`, so the
// address a promoted record is given and the address a spill of the same slot would use are one number.
//
// It goes through `arm64EmitAddSubImmWide` rather than the 12-bit `arm64EmitAddSubImm12`, for the reason
// that helper exists: a slot displacement is `16 + slot*8` and a function with more than 511 slots takes
// it past 4095, which the single-instruction form cannot reach. The wide form emits the hi/lo pair.
//
// The dest is always a GPR — an address is a pointer, and `recordOpResultClass` classifies
// `stackRecordAddr`'s result `gpr` — so there is no FP arm to mirror the two slot helpers' class split.
function arm64EmitSlotAddress(code ByteArray, destReg TargetVReg, slot SpillSlot)
	arm64EmitAddSubImmWide(code, opcode: Arm64OpAddImm, rd: arm64GprField(destReg), rn: Arm64Fp, imm: arm64SlotDisplacement(slot))
end 'arm64EmitSlotAddress'

// ==========================================================================
// F2: the LL/SC atomics, and the Darwin thread pointer
// ==========================================================================
//
// ⭐⭐ **THE TWO SEQUENCES SHARE ONE SAFETY ARGUMENT, AND IT IS ABOUT WHEN `Xd` IS WRITTEN.** A late def
// may be coloured onto the register of a use that DIES at the op (`allocateDef`'s `dyingRegs`), so `Xd`
// can legitimately BE `Xaddr` or an operand register. Both loops re-read every operand on every retry, so
// each encoder keeps its whole working state in x16/x17 and touches `Xd` EXACTLY ONCE, at the end, after
// the last read of every operand. `TargetDialect.arm64AtomicCas` states this as the op's contract; these
// are the two encoders that must honour it.
//
// ⭐ **x16 AND x17, AND x16 IS SAFE HERE FOR `arm64EmitJumpTable`'s REASON.** `StdToArm64Conversion`'s
// `Arm64Scratch` header gives the rule: x16 is unsafe only where something SPLICES a write to it between
// an isel-minted x16 producer/consumer pair, and nothing a post-ISEL pass splices writes x16 (a wide frame
// access deliberately folds into x17 instead — `arm64EmitWideFrameSlot`). These are isel-emitted macro-ops
// that nothing splices and `opIsConstMaterialization` refuses to rematerialize, so no pair can span them.
// Both are declared on the ops' `implicitDefs` and held equal to these registers by
// `assertEncoderScratchMasks`.

// The observed/running value of an LL/SC loop. x16 (IP0).
let Arm64AtomicValue = Arm64Ip0

// The STLXR status register. x17 (IP1) — distinct from `Arm64AtomicValue` and from every allocatable
// register, which is what keeps the `Ws != Xt, Xn` constraint true by construction.
let Arm64AtomicStatus = Arm64Ip1

// `LDAXR x16, [Xn]` — the head of both loops.
function arm64EmitLdaxr(code ByteArray, rn MachineWord)
	emitArm64Insn(code, insn: Arm64OpLdaxr or (rn shl Arm64RnShift) or Arm64AtomicValue)
end 'arm64EmitLdaxr'

// `STLXR w17, Xt, [Xn]` — the tail of both loops, status into x17.
function arm64EmitStlxr(code ByteArray, rt MachineWord, rn MachineWord)
	emitArm64Insn(code, insn: Arm64OpStlxr or (Arm64AtomicStatus shl Arm64StlxrRsShift) or (rn shl Arm64RnShift) or rt)
end 'arm64EmitStlxr'

// `arm64AtomicCas(dest, addr, expected, replacement)`:
//
//   loop:  LDAXR x16, [Xaddr]        ; x16 = the observed word, load-acquire exclusive
//          CMP   x16, Xexpected      ; sets the flags the closing CSET reads
//          B.NE  exit                ; mismatch — leave the flags NE and bail without storing
//          STLXR w17, Xrepl, [Xaddr] ; store-release exclusive; w17 = 0 iff it landed
//          CBNZ  x17, loop           ; reservation lost — observe again
//   exit:  CSET  Xd, EQ              ; 1 on the stored path, 0 on the mismatch path
//
// ⭐ **THE CSET READS THE `CMP`'s FLAGS ON BOTH PATHS, AND THAT IS WHY THERE IS NO SECOND COMPARE.**
// Neither `STLXR` nor `CBNZ` writes NZCV, so the flags at `exit` are still the last `CMP`'s: EQ when the
// loop fell through (matched, and the store landed) and NE when the `B.NE` was taken. v1's
// `arm64EmitAtomicCasMem` records the same property; it is the whole reason the success boolean costs one
// instruction rather than a re-load and a re-compare.
//
// ⚠ **A RETRY RE-READS `Xexpected`, NOT x16.** The comparand must be the caller's value on every trip —
// re-comparing against the last observation would make the loop succeed against whatever it just saw.
export function arm64EmitAtomicCas(code ByteArray, dest MachineWord, addrReg MachineWord, expectedReg MachineWord, replacementReg MachineWord)
	let loopTop = code.count()
	arm64EmitLdaxr(code, rn: addrReg)
	arm64EmitCmpReg(code, rn: Arm64AtomicValue, rm: expectedReg)
	let toExit = arm64EmitLocalCondBranch(code, cond: Arm64CondCode.ne)
	arm64EmitStlxr(code, rt: replacementReg, rn: addrReg)
	arm64PatchBranch19(code, codeOffset: arm64EmitLocalCbnz(code, reg: Arm64AtomicStatus), targetOffset: loopTop)
	arm64PatchBranch19(code, codeOffset: toExit, targetOffset: code.count())
	arm64EmitCset(code, rd: dest, cond: Arm64CondCode.eq)
end 'arm64EmitAtomicCas'

// `arm64AtomicRmw(dest, addr, operand, opcode)`:
//
//   loop:  LDAXR x16, [Xaddr]        ; x16 = the prior word
//          ADD   x16, x16, Xoperand  ; x16 = the new word
//          STLXR w17, x16, [Xaddr]
//          CBNZ  x17, loop
//          SUB   Xd, x16, Xoperand   ; recover the PRIOR word — the op's stated result
//
// ⛔⛔ **THIS IS WHERE v1's arm64 `atomicXadd` GAVE UP AND SHIPPED A NON-ATOMIC LOAD-ADD-STORE**, because
// it kept the prior value AND the new value AND the status live at once and so wanted a third scratch —
// reaching for x18, the Apple platform register, which corrupted thread state and double-allocated slab
// slots (`Arm64CodeEmitter.arm64EmitAtomicXaddMem` in `maxon-selfhosted`). Applying the operation's
// INVERSE after the loop removes the third register entirely: only the RUNNING value need be live across
// the store, and the prior one is one `SUB` away. Two scratches, a real reservation loop, x18 untouched.
//
// ⚠ The inverse is chosen by the opcode and MUST stay its true inverse — an appended `xchg` or `and` has
// no inverse at all and needs a different sequence (keep the prior value in `Xd` and the new one in x16),
// which is exactly what the exhaustive match here forces the next author to confront.
export function arm64EmitAtomicRmw(code ByteArray, dest MachineWord, addrReg MachineWord, operandReg MachineWord, opcode StdAtomicRmwOpcode)
	let (applyOpcode, inverseOpcode) = match opcode 'op'
		add gives (Arm64OpAdd, Arm64OpSub)
	end 'op'
	let loopTop = code.count()
	arm64EmitLdaxr(code, rn: addrReg)
	emitArm64Rrr(code, opcode: applyOpcode, rd: Arm64AtomicValue, rn: Arm64AtomicValue, rm: operandReg)
	arm64EmitStlxr(code, rt: Arm64AtomicValue, rn: addrReg)
	arm64PatchBranch19(code, codeOffset: arm64EmitLocalCbnz(code, reg: Arm64AtomicStatus), targetOffset: loopTop)
	emitArm64Rrr(code, opcode: inverseOpcode, rd: dest, rn: Arm64AtomicValue, rm: operandReg)
end 'arm64EmitAtomicRmw'

// ⭐⭐ **THIS OS THREAD'S PER-THREAD BASE — AND WHICH REGISTER HOLDS IT IS A PER-OS FACT (L4).**
// The two arms are not two spellings of one read; they name two different system registers, for two
// reasons that do not generalise:
//
//   • **Darwin — `TPIDRRO_EL0`, MASKED.** v1's owner token (`arm64GtOwnerToken`): the kernel points the
//     READ-ONLY register at the current thread's TSD base and packs the CPU number into its low three bits,
//     so the read shifts them out. Measured on this host: `tsd[key] == (TPIDRRO_EL0 & ~7) + key*8`.
//   • **Linux — `TPIDR_EL0`, UNMASKED.** The kernel writes NEITHER register for a static image with no libc,
//     so the writable one is free and `mrt_host_tls_alloc` makes it this thread's TLS block base
//     (`Arm64LinuxRuntime`). Nothing packs anything into it, so masking would clear three real address bits.
//
// It needs no scratch at all: every instruction reads and writes `dest`, so there is no operand for a
// premature write to destroy — the property the two LL/SC loops above have to work for.
//
// ⭐ EXPORTED: the hand-assembled green-thread chunks and the `tlsSlotLoad` lowering read a thread's slots
// through the SAME sequence, so a second spelling could only drift.
export function arm64EmitThreadPointer(code ByteArray, dest MachineWord, source Arm64ThreadPointerSource)
	match source 'source'
		darwinMaskedReadOnly then arm64EmitDarwinThreadPointer(code, dest: dest)
		linuxWritable then emitArm64Insn(code, insn: Arm64OpMrsTpidr or dest)
	end 'source'
end 'arm64EmitThreadPointer'

// `MRS Xd, TPIDRRO_EL0` then `LSR Xd,#3` / `LSL Xd,#3` — its own function only because a `match` arm carries
// ONE statement and this arm is three; the Linux arm is one instruction and stays inline above.
function arm64EmitDarwinThreadPointer(code ByteArray, dest MachineWord)
	emitArm64Insn(code, insn: Arm64OpMrsTpidrro or dest)
	arm64EmitLsrImm(code, rd: dest, rn: dest, sh: Arm64ThreadPointerCpuBits)
	arm64EmitLslImm(code, rd: dest, rn: dest, sh: Arm64ThreadPointerCpuBits)
end 'arm64EmitDarwinThreadPointer'

// `MSR TPIDR_EL0, Xn` — POINT this OS thread's writable thread pointer at `src`. Linux's alone, and it has
// exactly one writer: `mrt_host_tls_alloc`, which maps this thread's slot block and publishes its base here.
// There is deliberately no Darwin twin — `TPIDRRO_EL0` is read-only at EL0 and libSystem owns what it holds.
export function arm64EmitSetThreadPointer(code ByteArray, src MachineWord)
	emitArm64Insn(code, insn: Arm64OpMsrTpidr or src)
end 'arm64EmitSetThreadPointer'

function arm64EmitLoadSlot(code ByteArray, destReg TargetVReg, slot SpillSlot)
	let disp = arm64SlotDisplacement(slot)
	if arm64VRegIsGpr(destReg) 'gpr'
		arm64EmitFrameSlot(code, rt: arm64GprField(destReg), byteOffset: disp, unscaledOp: Arm64OpLdurX, scaledOp: Arm64OpLdrX)
	end 'gpr' else 'fp'
		arm64EmitFrameSlot(code, rt: arm64FpField(destReg), byteOffset: disp, unscaledOp: Arm64OpLdurD, scaledOp: Arm64OpLdrD)
	end 'fp'
end 'arm64EmitLoadSlot'

// MSUB Xd, Xn, Xm, Xa => Xd = Xa − Xn*Xm (the remainder builder — `rem = dividend − quotient*divisor`).
export function arm64EmitMsub(code ByteArray, rd MachineWord, rn MachineWord, rm MachineWord, ra MachineWord)
	emitArm64Insn(code, insn: Arm64OpMsub or (rm shl Arm64RmShift) or (ra shl Arm64MsubRaShift) or (rn shl Arm64RnShift) or rd)
end 'arm64EmitMsub'

// `bl` to a named function — placeholder imm26, `CallFixup` recorded (concat resolves it by name to a
// PC-relative 26-bit displacement). Exported so the hand-assembled entry stub (`Arm64Runtime`) emits
// its `bl main` through the same primitive the isel does.
export function arm64EmitBranchLink(code ByteArray, callFixups CallFixupArray, targetName ByteArray)
	callFixups.push(CallFixup.create(code.count(), targetName: targetName))
	emitArm64Insn(code, insn: Arm64OpBl)
end 'arm64EmitBranchLink'

// A GOT-indirect import call — the macOS twin of x64's `iatCall`. `adrp x16, <got page>; ldr x16,
// [x16, <page off>]; blr x16` calls the libSystem import dyld bound into GOT slot `slotIndex`. The
// Mach-O writer patches the ADRP+LDR pair against the resolved GOT-entry VA — it reads the pair at the
// Relocation's `codeOffset` and `codeOffset + 4` — so the Relocation is filed AT the ADRP. x16 is the
// IP scratch, free to clobber for the trampoline; the import reads its arguments from x0.. as usual.
export function arm64EmitImportCall(code ByteArray, iatRelocs RelocationArray, slotIndex RelocSlotIndex)
	iatRelocs.push(Relocation.create(code.count(), slotIndex: slotIndex))
	emitArm64Insn(code, insn: Arm64OpAdrp or Arm64Ip0)
	arm64EmitScaledMem(code, opcode: Arm64OpLdrX, rt: Arm64Ip0, baseReg: Arm64Ip0, byteOffset: 0, scale: SpillSlotBytes)
	emitArm64Insn(code, insn: Arm64OpBlr or (Arm64Ip0 shl Arm64RnShift))
end 'arm64EmitImportCall'

// A raw Linux supervisor call: `movz x8, #number` then `svc #0`. The AArch64 Linux syscall ABI puts
// the number in x8 and arguments in x0..x5 (which the isel pre-moved, exactly as it pre-moves a
// call's arguments), and returns the result in x0. Exported so the hand-assembled entry stub
// (`Arm64Runtime`) emits its `exit_group` through the same primitive the isel does.
//
// The number goes through the shared `arm64EmitMovImm` ladder rather than a bare `movz`: every Linux
// syscall number in use fits one halfword, but a hard-coded single `movz` would SILENTLY TRUNCATE a
// future number above 0xFFFF, and the ladder that handles it correctly already exists. It costs
// nothing — for a one-halfword value the ladder emits exactly the single `movz` by construction.
export function arm64EmitSyscall(code ByteArray, number MachineWord)
	arm64EmitMovImm(code, rd: Arm64SyscallNumberReg, value: number)
	emitArm64Insn(code, insn: Arm64OpSvc)
end 'arm64EmitSyscall'

// RET — return through x30. Exported for the hand-assembled runtime chunks; a MODULE function's
// return is the `arm64Ret` TargetOp, encoded from the same word.
export function arm64EmitRet(code ByteArray)
	emitArm64Insn(code, insn: Arm64OpRet)
end 'arm64EmitRet'

// BRK #0 — the entry stub's trap after the exit primitive, in case it ever returns (it does not).
export function arm64EmitBrk(code ByteArray)
	emitArm64Insn(code, insn: Arm64OpBrk)
end 'arm64EmitBrk'

// ==========================================================================
// The primitives the hand-assembled GREEN-THREAD chunks need (MAC3)
// ==========================================================================
//
// ⭐ **EVERY ONE OF THESE NAMES SP OR A REGISTER PAIR, WHICH IS WHY IT IS HERE AND NOT A `TargetOp`.** The
// allocator has no SP (`Arm64Register.sp` is above the register file — see `TargetDialect`), and the register
// pairs the context switch moves are fixed by an ABI list rather than by a colouring. So the green-thread
// chunks call the encoder directly, exactly as the panic runtime and the Darwin host surface do.

// `MOV Xd, SP` — and it MUST be the `ADD Xd, SP, #0` alias, never the ORR/XZR MOV: field value 31 is SP in
// an ADD and XZR in an ORR, so the ORR form would move the ZERO register (the M1 trap `arm64EmitAddFpFromSp`
// records one screen down, in the direction that matters here as well).
export function arm64EmitMovFromSp(code ByteArray, dest MachineWord)
	arm64EmitAddSubImm12(code, opcode: Arm64OpAddImm, rd: dest, rn: Arm64SpBaseField, imm12: 0, shiftHi: false)
end 'arm64EmitMovFromSp'

// `MOV SP, Xn` — the same alias in the other direction, and the same trap: `ORR SP, XZR, Xn` does not exist.
export function arm64EmitMovToSp(code ByteArray, src MachineWord)
	arm64EmitAddSubImm12(code, opcode: Arm64OpAddImm, rd: Arm64SpBaseField, rn: src, imm12: 0, shiftHi: false)
end 'arm64EmitMovToSp'

// `STP Xt1, Xt2, [SP, #-16]!` — the pre-indexed GPR push the context switch lays its saved block with.
export function arm64EmitPushPairGpr(code ByteArray, rt1 MachineWord, rt2 MachineWord)
	arm64EmitPairOffset(code, opcode: Arm64OpStpPreX, rt1: rt1, rt2: rt2, baseReg: Arm64SpBaseField, byteOffset: -Arm64GtPairBytes as Imm32)
end 'arm64EmitPushPairGpr'

// `LDP Xt1, Xt2, [SP], #16` — its post-indexed mirror.
export function arm64EmitPopPairGpr(code ByteArray, rt1 MachineWord, rt2 MachineWord)
	arm64EmitPairOffset(code, opcode: Arm64OpLdpPostX, rt1: rt1, rt2: rt2, baseReg: Arm64SpBaseField, byteOffset: Arm64GtPairBytes as Imm32)
end 'arm64EmitPopPairGpr'

// `STP Dt1, Dt2, [SP, #-16]!` / `LDP Dt1, Dt2, [SP], #16` — the SIMD&FP twins, for the callee-saved d8..d15.
export function arm64EmitPushPairFp(code ByteArray, rt1 MachineWord, rt2 MachineWord)
	arm64EmitPairOffset(code, opcode: Arm64OpStpPreD, rt1: rt1, rt2: rt2, baseReg: Arm64SpBaseField, byteOffset: -Arm64GtPairBytes as Imm32)
end 'arm64EmitPushPairFp'

export function arm64EmitPopPairFp(code ByteArray, rt1 MachineWord, rt2 MachineWord)
	arm64EmitPairOffset(code, opcode: Arm64OpLdpPostD, rt1: rt1, rt2: rt2, baseReg: Arm64SpBaseField, byteOffset: Arm64GtPairBytes as Imm32)
end 'arm64EmitPopPairFp'

// The bytes ONE pushed register pair moves SP by — two 8-byte registers. Named because it is the stride the
// context switch's frame is DERIVED from (`Arm64GtRuntime.assertArm64GtFrameConsistent` multiplies it by the
// pair count), and a bare 16 in that derivation would be indistinguishable from the stack's 16-byte ALIGNMENT,
// which is a different fact that happens to share the number.
export let Arm64GtPairBytes = 2 * SpillSlotBytes

// `str`/`ldr Xt, [SP, #byteOffset]` — a hand-assembled chunk addressing its own frame off SP. The ONE pair
// that names SP as a load/store base outside this file's own frame ops, and the reason it is here rather
// than beside its caller: SP is encoding field 31 — the same value XZR takes in a data-processing
// instruction — and a chunk restating that 31 would be the M1 trap this file's frame ops already document,
// written down a second time.
//
// ⚠ Its one caller is `__gt_morestack`, the single runtime chunk with a frame and no frame RECORD: it
// switches to the P's system stack itself, so there is no x29 for `arm64EmitStoreSlot` to address off.
export function arm64EmitStoreWord64Sp(code ByteArray, src MachineWord, byteOffset MachineWord)
	arm64EmitScaledMem(code, opcode: Arm64OpStrX, rt: src, baseReg: Arm64SpBaseField, byteOffset: byteOffset, scale: SpillSlotBytes)
end 'arm64EmitStoreWord64Sp'

export function arm64EmitLoadWord64Sp(code ByteArray, dest MachineWord, byteOffset MachineWord)
	arm64EmitScaledMem(code, opcode: Arm64OpLdrX, rt: dest, baseReg: Arm64SpBaseField, byteOffset: byteOffset, scale: SpillSlotBytes)
end 'arm64EmitLoadWord64Sp'

// The SIMD twins, for the relocating grower's float-argument save area.
export function arm64EmitStoreFpSp(code ByteArray, src MachineWord, byteOffset MachineWord)
	arm64EmitScaledMem(code, opcode: Arm64OpStrD, rt: src, baseReg: Arm64SpBaseField, byteOffset: byteOffset, scale: SpillSlotBytes)
end 'arm64EmitStoreFpSp'

export function arm64EmitLoadFpSp(code ByteArray, dest MachineWord, byteOffset MachineWord)
	arm64EmitScaledMem(code, opcode: Arm64OpLdrD, rt: dest, baseReg: Arm64SpBaseField, byteOffset: byteOffset, scale: SpillSlotBytes)
end 'arm64EmitLoadFpSp'

// `BLR Xn` — an indirect call through a register. The trampoline calls the spawned function through a pointer
// it loaded out of the GT struct; `arm64EmitImportCall` above uses the same instruction through x16.
export function arm64EmitBranchLinkReg(code ByteArray, reg MachineWord)
	emitArm64Insn(code, insn: Arm64OpBlr or (reg shl Arm64RnShift))
end 'arm64EmitBranchLinkReg'

// `LDR Xt, [Xn, Xm]` — a 64-bit load at a REGISTER offset (option=LSL, S=0, so the index is unscaled bytes).
// The one access in this compiler whose displacement is not an immediate: Darwin's TSD read indexes the
// thread pointer by a per-thread slot offset the program computed at run time (`lowerTlsSlotLoad`).
export function arm64EmitLoadRegOffset(code ByteArray, dest MachineWord, base MachineWord, index MachineWord)
	emitArm64Insn(code, insn: Arm64OpLdrRegOffset or (index shl Arm64RmShift) or (base shl Arm64RnShift) or dest)
end 'arm64EmitLoadRegOffset'

// `CSEL Xd, Xn, Xm, cond` — Xd = cond ? Xn : Xm, branchlessly. The TSD read's pre-initialisation gate uses it
// to answer NULL for a slot offset of zero, which is the "the scheduler has not run yet" case (see
// `StdToArm64Conversion.lowerTlsSlotLoad`).
export function arm64EmitCsel(code ByteArray, dest MachineWord, ifTrue MachineWord, ifFalse MachineWord, cond Arm64CondCode)
	emitArm64Insn(code, insn: Arm64OpCsel or (ifFalse shl Arm64RmShift) or ((cond.rawValue as MachineWord) shl Arm64CondFieldShift) or (ifTrue shl Arm64RnShift) or dest)
end 'arm64EmitCsel'

// ADRP Rd, page(label) + ADD Rd, Rd, #pageoff(label) — the ±4 GiB PIE address-materialisation pair
// the M1 traps mandate for ALL func/global/rdata addresses (NEVER a bare ADR, whose ±1 MiB reach
// silently truncates). The ADRP files the page reloc, the ADD the within-page reloc; the writer
// patches both fields once section VAs are known (`patchArm64Adrp`/`patchArm64PageOff`).
export function arm64EmitAdrpAddPair(code ByteArray, rdataRelocs RdataRelocationArray, dest MachineWord, label ByteArray, adrpKind RdataRelocKind, pageOffKind RdataRelocKind)
	rdataRelocs.push(RdataRelocation.create(code.count(), rdataLabel: String.from(label), kind: adrpKind))
	emitArm64Insn(code, insn: Arm64OpAdrp or dest)
	rdataRelocs.push(RdataRelocation.create(code.count(), rdataLabel: String.from(label), kind: pageOffKind))
	arm64EmitAddSubImm12(code, opcode: Arm64OpAddImm, rd: dest, rn: dest, imm12: 0, shiftHi: false)
end 'arm64EmitAdrpAddPair'

// Load an f64 `.rdata` constant: materialise its address into the IP scratch x16 with the ADRP+ADD
// pair (±4 GiB reach), then LDR Dd, [x16]. Reuses the address pair rather than an FP LDR-literal so
// the constant island is reachable at any distance and the within-page reloc lands on an ADD (0x91),
// which `patchArm64PageOff` already handles.
function arm64EmitFpLoadRdata(code ByteArray, rdataRelocs RdataRelocationArray, dest MachineWord, label ByteArray)
	arm64EmitAdrpAddPair(code, rdataRelocs: rdataRelocs, dest: Arm64Ip0, label: label, adrpKind: RdataRelocKind.arm64Adrp, pageOffKind: RdataRelocKind.arm64PageOff)
	arm64EmitScaledMem(code, opcode: Arm64OpLdrD, rt: dest, baseReg: Arm64Ip0, byteOffset: 0, scale: SpillSlotBytes)
end 'arm64EmitFpLoadRdata'

// leaFuncAddr materialises a FUNCTION's `.text` address into `dest` as the mandated ADRP+ADD pair
// (`ADRP dest, page(func)` + `ADD dest, dest, #pageoff(func)`; NEVER a bare ADR, whose ±1 MiB reach
// silently truncates). It files ONE `Arm64FuncAdrpReloc` AT THE ADRP naming the target function; the
// concat pass resolves the target's `.text` offset from the function-label map, and both arm64 writers
// patch the pair against `.text`'s VMADDR (`patchArm64FuncAdrpRelocs`). The `.text`-function twin of
// `arm64EmitAdrpAddPair`, which materialises `.rdata`/`.data` addresses — same instruction pair, a
// function symbol rather than a data label, so a dedicated code→`.text` reloc channel (P1.5-A1 / OPEN
// #67) rather than the section-targeting `rdataRelocs`.
export function arm64EmitLeaFuncAddr(code ByteArray, funcAdrpRelocs Arm64FuncAdrpRelocArray, dest MachineWord, funcName ByteArray)
	funcAdrpRelocs.push(Arm64FuncAdrpReloc.create(code.count(), funcName: funcName))
	emitArm64Insn(code, insn: Arm64OpAdrp or dest)
	arm64EmitAddSubImm12(code, opcode: Arm64OpAddImm, rd: dest, rn: dest, imm12: 0, shiftHi: false)
end 'arm64EmitLeaFuncAddr'

// ==========================================================================
// Prologue / epilogue expansion (the frame ops the prologue pass inserts)
// ==========================================================================

// The saved frame record (x29/x30) occupies the first 16 bytes of every frame; the spill/callee-save
// slot area opens above it. The single source of the arm64 frame-record size, shared with
// `arm64SlotDisplacement` and the prologue pass.
export let Arm64FrameRecordBytes = 16

// Open the frame: STP x29, x30, [sp, #-N]! + MOV x29, sp for a frame within the pre-index reach, else
// a SUB-sp split (the imm7 field cannot encode a large frame) with the record stored at the new sp.
// The `mov x29, sp` is ADD x29, sp, #0 — a MOV involving SP MUST be the ADD alias, never the ORR/XZR
// form (register 31 is SP here, not XZR — M1 trap).
//
// ⭐ `recordOffset` is where the x29/x30 record sits within the frame — 0 unless this function makes a call
// with OUTGOING STACK ARGUMENTS, which must occupy `[SP + 0 .. outgoing)` because that is where the callee's
// entry SP finds them. A nonzero offset forces the SUB-sp form whatever the frame size: the pre-indexed STP
// allocates and stores in one instruction and so can only put the record AT the new SP. `add x29, sp,
// #recordOffset` then keeps x29 pointing at the record, which is what leaves `[x29 + 16 + slot*8]` spill
// addressing identical in both shapes.
export function arm64EmitPrologue(code ByteArray, frameSize StackSize, recordOffset StackSize)
	if frameSize <= Arm64FramePairIndexMax and recordOffset == 0 'compact'
		arm64EmitStpPreIndex(code, frameSize: frameSize)
		arm64EmitAddFpFromSp(code, offset: recordOffset)
	end 'compact' else 'explicitAlloc'
		arm64EmitStackAlloc(code, amount: frameSize)
		arm64EmitFrameRecordPair(code, opcode: Arm64OpStpOffX, offset: recordOffset)
		arm64EmitAddFpFromSp(code, offset: recordOffset)
	end 'explicitAlloc'
end 'arm64EmitPrologue'

// Close the frame: LDP x29, x30, [sp], #N for a compact frame, else reload the record and free the
// frame with an ADD-sp split. The `ret` is the separate `arm64Ret` terminator, exactly as x64's
// `epilogue` releases the frame and leaves the `ret` to the terminator. A nonzero `recordOffset` takes the
// explicit form for the mirror of the prologue's reason: the post-indexed LDP reloads from the OLD SP,
// which is the outgoing-argument region rather than the record.
export function arm64EmitEpilogue(code ByteArray, frameSize StackSize, recordOffset StackSize)
	if frameSize <= Arm64FramePairIndexMax and recordOffset == 0 'compact'
		arm64EmitLdpPostIndex(code, frameSize: frameSize)
	end 'compact' else 'explicitFree'
		arm64EmitFrameRecordPair(code, opcode: Arm64OpLdpOffX, offset: recordOffset)
		arm64EmitStackFree(code, amount: frameSize)
	end 'explicitFree'
end 'arm64EmitEpilogue'

// `str <Xt|Dt>, [SP, #slot*8]` — one OUTGOING stack argument into the region at the bottom of this frame.
// SP is base field 31 here (not XZR — the M1 trap this file's header names), which is exactly why the op
// exists rather than reusing `storeBaseDispReg`: SP has no `RegNum` and so cannot be a `TargetVReg`.
// Class-dispatched on the SOURCE like every other 64-bit store, so a float argument stores through `STR Dt`.
//
// ⚠ THE THIRD DOOR ONTO THE SCALED FIELD, AND THE ONLY ONE THAT IS UNREACHABLE — asserted here rather
// than left to `arm64ScaledImm12`, WHOSE MESSAGE WOULD BE FALSE OF THIS CALLER. That panic tells a reader
// "the ISEL must have folded it into a scratch base (StdToArm64Conversion.addressFor)", which is true of a
// DATA access and false of this one: an outgoing argument addresses SP, not a value's base, and no isel
// fold exists or could. Sending a reader to that file would send them to the wrong one.
//
// It cannot fire, and not narrowly: the region is at most `arm64OutgoingArgRegionBytes()` = 448 bytes, i.e.
// 56 of the field's 4095 units, because the LANGUAGE refuses a signature past `MaxAbiArgs` before any of
// this runs. It is the SP twin of the imm7 and imm12 assertions the two frame ops below make about the
// same region, and all three quote the one derivation instead of restating its number.
//
// ⚠ AND IT IS THE LAST OF THE THREE TO FIRE, WHICH MEANS IT NEVER DOES — raising `MaxAbiArgs` does NOT
// reach this door. `arm64EmitFrameRecordPair`'s signed STP/LDP imm7 binds the SAME region at 504 bytes,
// 65x sooner, from a prologue that is encoded before any body op; the true headroom is SEVEN argument
// slots, and `arm64OutgoingArgRegionBytes`'s header carries the measurement and what to do about it.
// So this message states the field it guards and sends the reader THERE rather than proposing a fix for
// a door that opens second.
function arm64EmitStoreOutgoingArg(code ByteArray, slot SpillSlot, srcReg TargetVReg)
	let byteOffset = slot * SpillSlotBytes
	if not arm64ByteOffsetFitsScaledImm12(byteOffset, scale: SpillSlotBytes as NonZeroWord) 'unencodable'
		panic("arm64EmitStoreOutgoingArg: outgoing argument slot {slot} sits at byte {byteOffset} of this frame's argument region, past the {Arm64LoadStoreImm12Mask} 8-byte units the scaled STR field reaches — the region can hold at most {arm64OutgoingArgRegionBytes()} bytes while `MaxAbiArgs` caps a signature. Reaching THIS door before `arm64EmitFrameRecordPair`'s 504-byte STP/LDP imm7, which binds the same region 65x sooner from the prologue, means the frame record no longer rides that field — so read `arm64OutgoingArgRegionBytes`'s header for which ceiling moved, and expect the answer to be `arm64EmitWideFrameSlot`'s x17 fold rewritten against SP")
	end 'unencodable'

	arm64EmitWord64Store(code, base: Arm64SpBaseField, byteOffset: byteOffset, src: srcReg)
end 'arm64EmitStoreOutgoingArg'

// STP x29, x30, [sp, #-frameSize]! (pre-indexed). imm7 is signed, scaled by 8.
function arm64EmitStpPreIndex(code ByteArray, frameSize StackSize)
	let imm7 = (-frameSize / 8) and Arm64PairImm7Mask
	emitArm64Insn(code, insn: Arm64OpStpPreX or (imm7 shl Arm64PairImm7Shift) or (Arm64Lr shl Arm64Rt2Shift) or (Arm64SpBaseField shl Arm64RnShift) or Arm64Fp)
end 'arm64EmitStpPreIndex'

// LDP x29, x30, [sp], #frameSize (post-indexed).
function arm64EmitLdpPostIndex(code ByteArray, frameSize StackSize)
	let imm7 = (frameSize / 8) and Arm64PairImm7Mask
	emitArm64Insn(code, insn: Arm64OpLdpPostX or (imm7 shl Arm64PairImm7Shift) or (Arm64Lr shl Arm64Rt2Shift) or (Arm64SpBaseField shl Arm64RnShift) or Arm64Fp)
end 'arm64EmitLdpPostIndex'

// STP/LDP x29, x30, [sp, #offset] (plain signed offset) — the large-frame record store/reload.
// `opcode` selects STP (`Arm64OpStpOffX`) or LDP (`Arm64OpLdpOffX`).
//
// ⚠ THE imm7 IS SIGNED, AND MASKING IS NOT CLAMPING. `Arm64PairImm7Mask` keeps 7 bits, so an offset whose
// scaled value reaches 64 encodes as a NEGATIVE displacement: the prologue would write the x29/x30 record
// BELOW sp and the epilogue would reload x30 from there, returning to whatever the outgoing-argument
// region happened to hold. `offset` was a literal 0 until stack arguments made it the outgoing-argument
// size, so this became reachable arithmetic rather than a constant — and the ceiling that keeps it in
// range is `arm64OutgoingArgRegionBytes()` (448 today) ≤ `Arm64FramePairIndexMax`, a fact derived in
// another file entirely. Assert it where it is RELIED ON rather than inferring it three files away.
function arm64EmitFrameRecordPair(code ByteArray, opcode MachineWord, offset MachineWord)
	if offset > Arm64FramePairIndexMax 'unencodable'
		panic("arm64EmitFrameRecordPair: frame-record offset {offset} exceeds the {Arm64FramePairIndexMax}-byte reach of the signed STP/LDP imm7 — the outgoing stack-argument region has outgrown it, and a masked immediate would place the frame record below sp")
	end 'unencodable'

	arm64EmitPairOffset(code, opcode: opcode, rt1: Arm64Fp, rt2: Arm64Lr, baseReg: Arm64SpBaseField, byteOffset: offset as Imm32)
end 'arm64EmitFrameRecordPair'

// ADD x29, sp, #offset — point the frame pointer at the frame record, wherever in the frame it was put.
// At offset 0 this IS `mov x29, sp`, and it must be the ADD alias rather than the ORR/XZR MOV (register 31
// is SP here, not XZR — see the SP-vs-XZR note); a nonzero offset is the same instruction with the same
// alias, so the two frame shapes share one encoder.
//
// ⚠ THE 12-BIT FIELD IS CHECKED, NOT ASSUMED. `arm64EmitAddSubImm12` masks, so an offset past 0xFFF would
// be SILENTLY TRUNCATED and x29 would point into the middle of the outgoing-argument region — every spill,
// every callee-saved save and every incoming stack argument then addressed off a wrong frame pointer, with
// no diagnostic anywhere. The offset IS the outgoing-argument region, so today it is at most
// `arm64OutgoingArgRegionBytes()` = 448 and cannot reach the field; that is a conclusion about numbers in
// other files, not a property of this one, so it is asserted where it is relied on.
// (`arm64EmitAddSubImmWide` exists for exactly this trap on the frame-size path.)
function arm64EmitAddFpFromSp(code ByteArray, offset StackSize)
	if offset > Arm64ImmMask 'unencodable'
		panic("arm64EmitAddFpFromSp: frame-record offset {offset} exceeds the 12-bit ADD immediate — the outgoing stack-argument region has outgrown what `add x29, sp, #imm` can reach, and a masked immediate would silently point the frame pointer inside that region")
	end 'unencodable'

	arm64EmitAddSubImm12(code, opcode: Arm64OpAddImm, rd: Arm64Fp, rn: Arm64SpBaseField, imm12: offset, shiftHi: false)
end 'arm64EmitAddFpFromSp'

// SUB sp, sp, #amount — reserve a large frame, splitting across the imm12 limit (a frame past 4 KiB
// needs the hi/lo pair; the pre-index STP could not encode it at all). SP cannot be a shifted-register
// operand, so the ADD/SUB-immediate `sh` split is the only scratch-free form.
export function arm64EmitStackAlloc(code ByteArray, amount StackSize)
	arm64EmitAddSubImmWide(code, opcode: Arm64OpSubImm, rd: Arm64SpBaseField, rn: Arm64SpBaseField, imm: amount)
end 'arm64EmitStackAlloc'

// ADD sp, sp, #amount — free the frame (mirror of `arm64EmitStackAlloc`).
export function arm64EmitStackFree(code ByteArray, amount StackSize)
	arm64EmitAddSubImmWide(code, opcode: Arm64OpAddImm, rd: Arm64SpBaseField, rn: Arm64SpBaseField, imm: amount)
end 'arm64EmitStackFree'

// ==========================================================================
// Per-function chunk emission
// ==========================================================================

// Emit one function into a FunctionCodeChunk with CHUNK-LOCAL fixup offsets — the arm64 twin of
// `X64Backend.emitFunctionChunk`. Inter-function `bl` fixups (`callFixups`), code→data references
// (`rdataRelocs`) and `leaFuncAddr` code→`.text`-function pairs (`funcAdrpRelocs`) are rebased by concat;
// within-function block branches are resolved HERE, since a function's blocks are contiguous within its
// one chunk.
// ⭐ **`usesGt` DECIDES TWO INLINE INSERTIONS (MAC3), BOTH BELOW THE `TargetOp` TIER**, exactly as the x64
// twin's does: the prologue STACK GUARD at a guarded function's entry, and the import-call STACK SHIM around
// every `arm64ImportCall`. It is `RuntimeUsage.usesGt` — the bit `installGtRuntime` was gated on — read once
// by the caller and never re-derived per function, so this stays O(1) per function.
//
// ⚠ **THIS BLOCK USED TO SAY "BOTH ARE macOS-ONLY, AND THE CALLER FOLDS THAT IN", AND L4 REMOVED THE FOLD.**
// Its argument was that each reads this OS thread's slot through Darwin's TSD layout and *"an arm64-Linux
// image has no libc to have written a thread pointer, so the sequence would read garbage rather than fail"*.
// The second half is what changed: `mrt_host_tls_alloc` writes `TPIDR_EL0` on that lane, and the read is
// routed by `arm64ThreadPointerSource` rather than assuming Darwin's register. So `greenThreads` is now the
// `usesGt` bit alone — the SHIM is still macOS-only, but by construction rather than by this fold, because
// only the import-call route emits an `arm64ImportCall` for it to wrap.
function emitArm64FunctionChunk(module TargetModule, func IrFunction, greenThreads bool, target Target) returns FunctionCodeChunk
	var code = ByteArray.create()
	var callFixups = CallFixupArray.create()
	var rdataRelocs = RdataRelocationArray.create()
	// A `leaFuncAddr`'s ADRP+ADD pair, chunk-local like the others; concat resolves each to its target
	// function's `.text` offset and both writers patch the pair. Empty for a function that takes no
	// function value.
	var funcAdrpRelocs = Arm64FuncAdrpRelocArray.create()
	// The libSystem GOT import calls this function makes (`osAllocPages`→mmap, `osWriteStdout`→write).
	// Chunk-local like the others; concat rebases each into the writer's slot-indexed relocations, the
	// same channel the entry stub's `_exit` rides. Empty for a function that touches no OS primitive.
	var iatRelocs = RelocationArray.create()
	var branchFixups = Arm64BlockBranchFixupArray.create()
	// Dense-match jump tables encoded in this chunk, awaiting their per-slot block-address relocations —
	// resolved after the block loop, when `blockOffsets` holds every block's chunk-local offset.
	var jumpTables = JumpTablePendingArray.create()
	var blockOffsets = BlockOffsetTable.forBlockCount(func.nextBlockId)
	let guarded = greenThreads and not skipsGreenThreadStackGuard(func)
	var isFirstBlock = true

	for blockRef in func.blockRefs 'eachBlock'
		let block = try module.blocks.get(blockRef) otherwise panic("emitArm64FunctionChunk: blockRef from func.blockRefs not in module.blocks")

		blockOffsets.place(block.id, value: code.count())

		// ⭐ THE GREEN-THREAD STACK GUARD, at the very START of a guarded function's entry block — BEFORE the
		// prologue — so a green thread whose stack would overflow grows and relocates it first. It is EXEMPT
		// for the compiler's own scaffolding: the scheduler core must never trip the grower, and its own
		// libSystem calls are already moved onto the P's system stack by the shim below. ⚠ The exemption is
		// asked of the FUNCTION's PROVENANCE and never of its name — `skipsGreenThreadStackGuard`'s header
		// carries the measurement (a `__`-name test handed the guard to a user function declared in
		// `stdlib/Builtins.maxon` and segfaulted a green thread) and the split from `isRuntimeFunction`.
		if isFirstBlock and guarded 'guard'
			emitArm64GtStackGuard(code, callFixups: callFixups, rdataRelocs: rdataRelocs, frameBytes: arm64PrologueFrameBytes(module, block: block), margin: gtStackGuardMargin(target), os: target.os)
		end 'guard'
		isFirstBlock = false

		for opIdx in block.opRefs 'eachOp'
			let op = try module.ops.get(opIdx) otherwise panic("emitArm64FunctionChunk: opIdx {opIdx} not in module.ops")
			emitArm64TargetOp(op, code: code, callFixups: callFixups, rdataRelocs: rdataRelocs, iatRelocs: iatRelocs, funcAdrpRelocs: funcAdrpRelocs, branchFixups: branchFixups, jumpTables: jumpTables, shimmed: greenThreads)
		end 'eachOp'

		if block.hasTerminatorOp() 'hasTerm'
			let termOp = try module.ops.get(block.terminatorIndex()) otherwise panic("emitArm64FunctionChunk: terminator not in module.ops")
			emitArm64TargetOp(termOp, code: code, callFixups: callFixups, rdataRelocs: rdataRelocs, iatRelocs: iatRelocs, funcAdrpRelocs: funcAdrpRelocs, branchFixups: branchFixups, jumpTables: jumpTables, shimmed: greenThreads)
		end 'hasTerm'
	end 'eachBlock'

	arm64ResolveBlockBranches(code, blockOffsets: blockOffsets, fixups: branchFixups)

	// The scalar core registers no rdata constants inside a function chunk (float islands are
	// registered upstream by the lowering); the field stays empty, exactly as x64's does this rung.
	// `funcAdrpRelocs` is assigned after the fact so `createWith`'s signature — shared with the x64
	// runtimes — stays unchanged (only arm64 chunks carry any).
	var chunk = FunctionCodeChunk.createWith(func.name, code: code, callFixups: callFixups, rdataRelocs: rdataRelocs, iatRelocs: iatRelocs, rdataConstants: GlobalDataTable.create())
	chunk.funcAdrpRelocs = funcAdrpRelocs
	chunk.jumpTableRelocs = resolveJumpTableRelocs(jumpTables, blockOffsets: blockOffsets)
	return chunk
end 'emitArm64FunctionChunk'

// ⭐ **THE FRAME THE GUARD PROJECTS, READ OFF THE PROLOGUE OP RATHER THAN RE-DERIVED.** x64's guard
// recomputes the number with `computeGuardFrameBytes`, because its prologue is a `push`/`sub` sequence with
// no single op carrying the total. arm64's IS one op — `insertArm64PrologueAtEntry` prepends
// `arm64Prologue(frameSize, recordOffset)` at index 0 of the entry block — so the guard reads the very word
// the prologue will reserve. That is DERIVE rather than CHECK: the two cannot come to disagree, where two
// derivations of one frame size could.
//
// ⚠ Every arm64 function is framed (`Arm64PrologueEpilogue`'s first paragraph — leaves included, because a
// chain with a hole is not a chain), so the op is always there and its size is never 0. The guard therefore
// has no "reserves no frame" exemption to make, which is the one arm x64's `emitGuard` needs and this does not.
function arm64PrologueFrameBytes(module TargetModule, block IrBlock) returns StackSize
	let opIdx = try block.opRefs.get(0) otherwise panic("arm64PrologueFrameBytes: the entry block of '{String.from(block.label)}' has no ops — `insertArm64PrologueAtEntry` prepends an `arm64Prologue` to every function's entry block, so an empty entry block means the frame pass did not run")
	let op = try module.ops.get(opIdx) otherwise panic("arm64PrologueFrameBytes: opIdx {opIdx} not in module.ops")
	return match op 'prologue'
		arm64Prologue(frameSize, _) gives frameSize
		default panic("arm64PrologueFrameBytes: the entry block's first op is not an `arm64Prologue` — the green-thread stack guard must project the frame the prologue is about to reserve, and it reads that number off the prologue itself rather than deriving a second one")
	end 'prologue'
end 'arm64PrologueFrameBytes'

// Append the hand-assembled arm64 runtime chunks. At the scalar core the runtime is JUST the entry
// stub `mrt_start` (no fault handler — arm64 `sdiv`-by-0 is defined to return 0; no MM/scheduler
// floor — the scalar core allocates and spawns nothing). It is appended to the STILL-EMPTY chunk list
// so it LEADS `.text` and `LC_MAIN.entryoff = 0` — the opposite placement from x64's
// `appendX64RuntimeChunks`, whose appended runtime is the TRAILING panic handler (x64's `mrt_start` is
// a module function already laid out first). The panic/software runtime GROWS back here at its
// milestone. `leakCheck` gates the entry stub's future MM leak bridge (false at the scalar core),
// `initGlobals` its managed-global init/release bracket (P1.7 slice 2a — false for a program with no
// managed top-level `var`), and
// `os` picks the stub's exit route — a libSystem GOT call on macOS, a raw `svc #0` on Linux (see
// `Arm64Runtime.arm64OsCallKind`).
function appendArm64RuntimeChunks(chunks FunctionCodeChunkArray, leakCheck bool, initGlobals bool, drainGreenThreads bool, captureArgv bool, captureEnvp bool, os Os)
	chunks.push(buildArm64EntryStubChunk(leakCheck, initGlobals: initGlobals, drainGreenThreads: drainGreenThreads, captureArgv: captureArgv, captureEnvp: captureEnvp, os: os))
end 'appendArm64RuntimeChunks'

// ==========================================================================
// Concatenation: lay out .text, rebase fixups, resolve intra-module calls
// ==========================================================================

// Concatenate the per-function chunks into `.text`, rebase each chunk's CHUNK-LOCAL fixups to absolute
// offsets, resolve the intra-module `bl` calls to 26-bit displacements (`bl main` among them), rebase
// the GOT import calls (the entry stub's `_exit`) into the writer's slot-indexed `relocations`, and
// resolve every code→data reference to its section offset (the writer adds the section VA) — the arm64
// twin of `concatX64FunctionChunks`.
//
// `mrt_start` MUST lead `.text` so `LC_MAIN.entryoff` (= `mainCallFixupOffset`) is its offset, 0;
// `appendArm64RuntimeChunks` appends it first, and the guard below asserts that layout at the one
// place that decides it. `__symtable` CLOSES `.text` after everything else, exactly as x64's concat
// closes its own — the arm64 panic runtime's backtrace symbolizes every frame against it, and reads
// `__symtable - mrt_start` as the size of the code.
function concatArm64FunctionChunks(targetModule TargetModule, stdModule StdModule, chunks FunctionCodeChunkArray, globalData GlobalDataTable, project Project, funcNames FunctionNameIndex) returns CodeResult throws CompileError
	var code = ByteArray.create()
	var callFixups = CallFixupArray.create()
	var relocations = RelocationArray.create()
	var labelOffsets = FuncLabelOffsetMap.create()
	var debugSymbols = DebugSymbolArray.create()
	var rdataRelocations = RdataRelocationArray.create()
	var funcAdrpRelocs = Arm64FuncAdrpRelocArray.create()
	var jumpTableRelocs = JumpTableRelocArray.create()

	// A label claimed twice is a wrong `.text` address, never a near miss — see `recordChunkLabel`, which
	// owns the rule and the refusal for both native backends. `__symtable` goes through the same door
	// after the loop.
	var labelsLaid = 0 as ChunkLabelCount
	for chunk in chunks 'eachChunk'
		let funcStart = code.count()
		try recordChunkLabel(labelOffsets, name: chunk.funcName, offset: funcStart, laidOut: labelsLaid, project: project, funcNames: funcNames)
		labelsLaid = labelsLaid + 1
		debugSymbols.push(DebugSymbol.create(chunk.funcName, codeOffset: funcStart))
		code.append(chunk.code)

		for fx in chunk.callFixups 'rebaseCalls'
			callFixups.push(CallFixup.create(funcStart + fx.codeOffset, targetName: fx.targetName))
		end 'rebaseCalls'
		// GOT import calls (the entry stub's `_exit`) rebase into the writer's slot-indexed relocations,
		// the same channel as x64's IAT relocations. The writer patches the ADRP+LDR pair at each.
		for r in chunk.iatRelocs 'rebaseImports'
			relocations.push(Relocation.create(funcStart + r.codeOffset, slotIndex: r.slotIndex))
		end 'rebaseImports'
		for rr in chunk.rdataRelocs 'rebaseRdata'
			var reloc = RdataRelocation.create(funcStart + rr.codeOffset, rdataLabel: rr.rdataLabel, kind: rr.kind)
			reloc.rdataOffset = arm64SectionOffsetOfReloc(globalData, reloc: rr)
			rdataRelocations.push(reloc)
		end 'rebaseRdata'
		// `leaFuncAddr` pairs rebase their ADRP `codeOffset` here; the target's `.text` offset can only
		// be resolved once EVERY chunk is laid out (a `leaFuncAddr` may name a function placed later), so
		// `textOffset` is filled by `arm64ResolveFuncAdrpRelocs` after the loop — the same reason
		// `arm64ResolveCallFixups` runs there.
		for fr in chunk.funcAdrpRelocs 'rebaseFuncAddr'
			funcAdrpRelocs.push(Arm64FuncAdrpReloc.create(funcStart + fr.codeOffset, funcName: fr.funcName))
		end 'rebaseFuncAddr'
		// Rebase each jump-table reloc's per-slot target offsets from chunk-local to whole-`.text` (the crux
		// step: a block's offset is `funcStart + its chunk-local offset`), exactly as x64's concat does.
		for jt in chunk.jumpTableRelocs 'rebaseJumpTables'
			jumpTableRelocs.push(rebaseJumpTableReloc(jt, funcStart: funcStart))
		end 'rebaseJumpTables'
	end 'eachChunk'

	// `__symtable` CLOSES `.text`, after the last chunk — the placement the panic runtime's
	// `textSize = __symtable - mrt_start` depends on. Appending it here, from the loop's own output, is
	// what makes that structural: every symbol's offset is known because the loop just assigned it, and
	// nothing can be laid out after it because nothing follows. It is registered in `labelOffsets` (so
	// the walker's `leaFuncAddr __symtable` resolves like any other chunk reference) but deliberately
	// NOT in `debugSymbols` — it is DATA, not a function, and an entry for it would let a walk symbolize
	// a stray return address INTO the table. It is exempt from being a function, not from being unique:
	// a second claim would move the bound `textSize` reads, silently mis-sizing every backtrace.
	padTo(code, size: alignUp(code.count(), alignment: SymbolTableAlignment))
	try recordChunkLabel(labelOffsets, name: SymbolTableName, offset: code.count(), laidOut: labelsLaid, project: project, funcNames: funcNames)
	code.append(buildSymbolTableBytes(debugSymbols))

	arm64ResolveCallFixups(code, labelOffsets: labelOffsets, callFixups: callFixups)
	arm64ResolveFuncAdrpRelocs(funcAdrpRelocs, labelOffsets: labelOffsets)

	// `mrt_start` is the entry point; `LC_MAIN.entryoff` is its `.text` offset. It MUST be laid out
	// first (`appendArm64RuntimeChunks` appends it before user code); the guard turns "the entry stub is
	// first" from a cosmetic property of the chunk list into a checked invariant at the point of layout.
	let entryOffset = try labelOffsets.get(EntryPointName) otherwise panic("concatArm64FunctionChunks: '{String.from(EntryPointName)}' was not laid out — appendArm64RuntimeChunks did not run before emission")
	if entryOffset != 0 'entryNotFirst'
		panic("concatArm64FunctionChunks: '{String.from(EntryPointName)}' must lead .text but is at offset {entryOffset} — LC_MAIN.entryoff is its offset, so anything below it would move the process entry off the stub")
	end 'entryNotFirst'

	var result = CodeResult.create(code, mainCallFixupOffset: entryOffset, relocations: relocations, globalData: globalData, targetModule: targetModule, stdModule: stdModule, rdata: globalData.rdataImage(), rdataRelocations: rdataRelocations, symdata: globalData.symdataImage, covDataSectionBytes: ByteArray.create())
	result.debugSymbols = debugSymbols
	result.dataPrelude = globalData.dataSectionImage()
	result.arm64FuncAdrpRelocs = funcAdrpRelocs
	result.jumpTableRelocs = jumpTableRelocs
	// The chunks' own PRE-LINK bytes, for the one reader `code` cannot serve: a ```RequiredRuntime
	// golden over a hand-assembled chunk (here, the entry stub — arm64 builds it as bytes, not as a
	// Target function). See `CodeResult.codeChunks`.
	result.codeChunks = chunks
	return result
end 'concatArm64FunctionChunks'

// The offset of a code→data reference's target WITHIN ITS OWN SECTION — the arm64 twin of x64's
// `sectionOffsetOfReloc`. The kind names the section: the ADRP/ADD `.rdata` pair resolves against
// rdata, the `.data` pair against the data section. A kind the arm64 encoder never files panics
// rather than defaulting to either section (they answer different small integers — a wrong-section
// resolve, not a near miss).
function arm64SectionOffsetOfReloc(globalData GlobalDataTable, reloc RdataRelocation) returns CodeOffset
	return match reloc.kind 'kind'
		arm64Adrp gives globalData.rdataOffsetOf(reloc.rdataLabel)
		arm64PageOff gives globalData.rdataOffsetOf(reloc.rdataLabel)
		dataSectionArm64Adrp gives globalData.dataSectionOffsetOf(reloc.rdataLabel)
		dataSectionArm64PageOff gives globalData.dataSectionOffsetOf(reloc.rdataLabel)
		ripRelDisp32 to covdataRipRelDisp32 panic("arm64SectionOffsetOfReloc: '{reloc.rdataLabel}' carries an x64 RIP-relative reloc kind in the arm64 backend")
		arm64Adr to covdataArm64Adr panic("arm64SectionOffsetOfReloc: '{reloc.rdataLabel}' is a single-ADR reloc kind, which the arm64 encoder does not file (it uses the ADRP+ADD pair — M1 trap)")
		covdataArm64Adrp to covdataArm64PageOff panic("arm64SectionOffsetOfReloc: '{reloc.rdataLabel}' is a `.covdata` reference, and the scalar-core backend emits no coverage — covdata grows back at its milestone")
	end 'kind'
end 'arm64SectionOffsetOfReloc'

// Patch every code→section reference (ADR / ADRP+page-off / LDR-literal) against the resolved
// section addresses — the WRITER-side twin of `arm64SectionOffsetOfReloc` above, which answers
// which section a kind names; this one applies it. `arm64*` kinds reach the read-only constant
// section (float islands, String literal records); `dataSection*` kinds reach the top-level `var`
// globals. Every other arm is named and PANICS: the x64 kinds cannot appear in an arm64 image, and
// `symdata`/`covdata` are not emitted at this milestone. (A witness-table method slot, and a
// managed-opaque descriptor's `destroyFunc@40`/`copyFunc@32`, are not `RdataRelocKind`s at all — they ride
// `GlobalDataTable.pendingRdataRelocs`, filled by `bakeFuncAbs64Relocs` on the static arm64-linux ELF and
// by `writeMachoRdataRebases` as a dyld rebase on the always-PIE arm64-macOS.)
// Naming them one by one makes the day one is emitted a loud failure rather than a silently unpatched
// displacement — PeWriter's discipline.
//
// SHARED BY BOTH arm64 OBJECT WRITERS. `writeMachO` (`__const`/`__data` vmaddrs) and `writeElf`
// (`.rodata`/`.data` vaddrs) differ only in what they pass as the three addresses; the patch
// arithmetic is pure AArch64 instruction knowledge, so it is spelled here once instead of once
// per format — a second copy is exactly how two writers drift on which kinds they honour.
export function patchArm64SectionRelocations(code ByteArray, rdataRelocs RdataRelocationArray, textVmAddr MachineWord, rdataVmAddr MachineWord, dataVmAddr MachineWord)
	for reloc in rdataRelocs 'patch'
		let instrVa = textVmAddr + reloc.codeOffset
		match reloc.kind 'kind'
			ripRelDisp32 then panic("patchArm64SectionRelocations: x64 RIP-relative relocation in an arm64 image — target/emitter mismatch")
			symdataRipRelDisp32 then panic("patchArm64SectionRelocations: x64 symdata relocation in an arm64 image — target/emitter mismatch")
			dataSectionRipRelDisp32 then panic("patchArm64SectionRelocations: x64 data-section relocation in an arm64 image — target/emitter mismatch")
			covdataRipRelDisp32 then panic("patchArm64SectionRelocations: x64 covdata relocation in an arm64 image — target/emitter mismatch")
			arm64Adr then patchArm64Adr(code, codeOffset: reloc.codeOffset, instrAddr: instrVa, targetAddr: rdataVmAddr + reloc.rdataOffset)
			arm64LdrLiteral then patchArm64LdrLiteral(code, codeOffset: reloc.codeOffset, instrAddr: instrVa, targetAddr: rdataVmAddr + reloc.rdataOffset)
			symdataArm64Adr then panic("patchArm64SectionRelocations: the symdata section is empty at this milestone — a symdataArm64Adr relocation has no section to reach; it arrives at the reflection milestone")
			dataSectionArm64Adr then patchArm64Adr(code, codeOffset: reloc.codeOffset, instrAddr: instrVa, targetAddr: dataVmAddr + reloc.rdataOffset)
			covdataArm64Adr then panic("patchArm64SectionRelocations: coverage is not emitted for arm64 yet — no .covdata section")
			arm64Adrp then patchArm64Adrp(code, codeOffset: reloc.codeOffset, instrAddr: instrVa, targetAddr: rdataVmAddr + reloc.rdataOffset)
			arm64PageOff then patchArm64PageOff(code, codeOffset: reloc.codeOffset, targetAddr: rdataVmAddr + reloc.rdataOffset)
			dataSectionArm64Adrp then patchArm64Adrp(code, codeOffset: reloc.codeOffset, instrAddr: instrVa, targetAddr: dataVmAddr + reloc.rdataOffset)
			dataSectionArm64PageOff then patchArm64PageOff(code, codeOffset: reloc.codeOffset, targetAddr: dataVmAddr + reloc.rdataOffset)
			covdataArm64Adrp then panic("patchArm64SectionRelocations: coverage is not emitted for arm64 yet — no .covdata section")
			covdataArm64PageOff then panic("patchArm64SectionRelocations: coverage is not emitted for arm64 yet — no .covdata section")
		end 'kind'
	end 'patch'
end 'patchArm64SectionRelocations'

// Patch an ADRP + following (ADD/LDR) page-relative address pair against `targetVa`: the ADRP at
// `adrpOffset` (whose own VA is `instrVa`) takes the target's PAGE, and the instruction at
// `adrpOffset + 4` takes the 12-bit within-page offset — an ADD-imm for a materialised address, an LDR
// for a GOT load, which `patchArm64PageOff` tells apart from the opcode. The ONE place the AArch64
// "the second half of the pair is 4 bytes past the ADRP" convention is spelled: shared by the
// `.text`-function relocs (`patchArm64FuncAdrpRelocs`) and the macOS GOT import calls
// (`patchImportRelocations`). `patchArm64Adrp`/`patchArm64PageOff` guard the ±4 GiB reach, so an
// out-of-reach pair is a loud link error, not a wrong page.
export function patchArm64AdrpPair(code ByteArray, adrpOffset CodeOffset, instrVa MachineWord, targetVa MachineWord)
	patchArm64Adrp(code, codeOffset: adrpOffset, instrAddr: instrVa, targetAddr: targetVa)
	patchArm64PageOff(code, codeOffset: adrpOffset + 4, targetAddr: targetVa)
end 'patchArm64AdrpPair'

// Patch every `leaFuncAddr` ADRP+ADD pair against its target function's absolute `.text` VA — the
// SHARED func-address twin of `patchArm64SectionRelocations`, called by both arm64 writers with their
// own `.text` VMADDR. `arm64EmitLeaFuncAddr` filed the reloc AT THE ADRP (`codeOffset`); the paired ADD
// is patched by `patchArm64AdrpPair`. Both target and instruction sit in `.text`, so the page delta is
// invariant under a page-aligned image base and a PIE slide moves them together — no dyld rebase entry,
// unlike a data pointer.
export function patchArm64FuncAdrpRelocs(code ByteArray, funcAdrpRelocs Arm64FuncAdrpRelocArray, textVmAddr MachineWord)
	for reloc in funcAdrpRelocs 'patch'
		let instrVa = textVmAddr + reloc.codeOffset
		let targetVa = textVmAddr + reloc.textOffset
		patchArm64AdrpPair(code, adrpOffset: reloc.codeOffset, instrVa: instrVa, targetVa: targetVa)
	end 'patch'
end 'patchArm64FuncAdrpRelocs'

// Patch every `bl` to the 26-bit PC-relative displacement of its named target (the arm64 twin of
// `resolveCallFixups`). A bare stdlib-qualified/unqualified fallback is not needed this rung —
// scalar-core calls resolve directly by name.
function arm64ResolveCallFixups(code ByteArray, labelOffsets FuncLabelOffsetMap, callFixups CallFixupArray)
	for fixup in callFixups 'resolve'
		let targetOffset = try labelOffsets.get(fixup.targetName) otherwise panic("arm64ResolveCallFixups: bl to unknown function '{String.from(fixup.targetName)}'")
		arm64PatchBranch26(code, codeOffset: fixup.codeOffset, targetOffset: targetOffset)
	end 'resolve'
end 'arm64ResolveCallFixups'

// Resolve every `leaFuncAddr` ADRP+ADD pair to its target function's `.text` offset — the func-address
// twin of `arm64ResolveCallFixups`, and it runs beside it AFTER the layout loop for the same reason: a
// `leaFuncAddr` may name a function laid out later, so the name→offset map must be complete first. Unlike
// `arm64ResolveCallFixups`, this does NOT touch `code` — the section VMADDR is unknown here, so it only
// fills each reloc's `textOffset`; the writers add `.text`'s base and patch (`patchArm64FuncAdrpRelocs`),
// exactly as they add a section VMADDR to a resolved `RdataRelocation.rdataOffset`. `textOffset` is
// written THROUGH the array's reference (`Arm64FuncAdrpReloc` is a `type`), so the by-index `var` get is
// the same in-place mutation idiom `GlobalDataTable.layOut` uses.
function arm64ResolveFuncAdrpRelocs(funcAdrpRelocs Arm64FuncAdrpRelocArray, labelOffsets FuncLabelOffsetMap)
	for i in 0 upto funcAdrpRelocs.count() 'resolve'
		var reloc = try funcAdrpRelocs.get(i) otherwise panic("arm64ResolveFuncAdrpRelocs: index {i} OOB despite the upto bound")
		reloc.textOffset = try labelOffsets.get(reloc.funcName) otherwise panic("arm64ResolveFuncAdrpRelocs: leaFuncAddr of unknown function '{String.from(reloc.funcName)}'")
	end 'resolve'
end 'arm64ResolveFuncAdrpRelocs'

// ==========================================================================
// Backend driver
// ==========================================================================

// Run the arm64 backend — the arm64 twin of `BackendDispatch.buildX64Backend`. The register allocator
// (`allocateRegisters`) is reused as-is (the one-allocator / unified-`TargetOp` design); the
// ISA-specific stages are the arm64 isel (`lowerStdToArm64`), frame (`insertArm64PrologueEpilogue`),
// encoder and link. There is NO module-level `augmentWithRuntime` step (x64's, which prepends
// `mrt_start` as a module function): the arm64 entry stub calls `_exit` through a GOT import with no
// TargetOp channel, so it is hand-assembled as a chunk in the encode phase (`appendArm64RuntimeChunks`)
// and laid out first. `throws CompileError` because register allocation can fail for a real reason
// (E5001), exactly as the x64 backend does.
export function buildArm64Backend(stdModule StdModule, target Target, globalData GlobalDataTable, project Project, usage RuntimeUsage, funcNames FunctionNameIndex) returns CodeResult throws CompileError
	let iselProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.isel)
	// `target` reaches the ISEL because the three OS-primitive lowerings differ per OS: macOS routes
	// them through libSystem GOT imports, Linux through raw `svc #0` (see `arm64OsCallKind`), and the
	// mmap anonymous-mapping flag word is a different number on each.
	var (targetModule, valueClasses) = lowerStdToArm64(stdModule, target: target, globalData: globalData, funcNames: funcNames)
	recordPhase(project, phase: CompilePhase.isel, probe: iselProbe)

	let regAllocProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.regalloc)
	try allocateRegisters(targetModule, target: target, project: project, valueClasses: valueClasses)
	recordPhase(project, phase: CompilePhase.regalloc, probe: regAllocProbe)

	let prologueProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.prologueEpilogue)
	insertArm64PrologueEpilogue(targetModule, target: target)
	recordPhase(project, phase: CompilePhase.prologueEpilogue, probe: prologueProbe)

	let encodeProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.encode)
	var chunks = FunctionCodeChunkArray.create()
	// The entry stub `mrt_start`. It is hand-assembled (its macOS `_exit` GOT call has no TargetOp
	// channel — see Arm64Runtime) and appended FIRST so it LEADS `.text` and the image's entry offset
	// is 0, exactly as x64's `mrt_start` leads `.text`. There is NO module-level `augmentWithRuntime`
	// step here — the stub is a chunk, not a module function, so it cannot be prepended to the module
	// the way x64's is; it is assembled in the encode phase alongside the user chunks.
	//
	// ⚠ It is no longer the WHOLE arm64 runtime: the panic runtime below is the rest of it, and this
	// comment said "the scalar core needs no panic handler" until A3n landed one three lines away.
	appendArm64RuntimeChunks(chunks, leakCheck: usage.usesHeap, initGlobals: usage.usesManagedGlobals, drainGreenThreads: usage.usesGt, captureArgv: usage.usesCommandLine, captureEnvp: usage.usesGt and target.os == Os.linux, os: target.os)
	for func in targetModule.functions 'eachFunc'
		chunks.push(emitArm64FunctionChunk(targetModule, func: func, greenThreads: usage.usesGt, target: target))
	end 'eachFunc'
	// The panic runtime lays out ABOVE user code (x64's placement, and for x64's reason: only the entry
	// stub has to lead `.text`). Its four chunks and the `__symtable` concat appends after them are what
	// make a violated range guard — or a user `panic("…")` — print its message and a symbolized
	// backtrace on arm64 instead of exiting bare.
	appendArm64PanicRuntimeChunks(chunks, globalData: globalData, os: target.os)
	// The HOST SURFACE — the sequences behind the `os*` ops whose only implementation used to be
	// x64-windows's. EXACTLY ONE lane's chunks are appended, which is what lets both build under the shared
	// `mrt_host_*` names (`Arm64PosixRuntime`'s header): macOS's are libSystem calls through a GOT, Linux's
	// are raw `svc #0` against a table no import is needed for.
	match target.os 'hostSurface'
		macos then appendArm64DarwinRuntimeChunks(chunks, usage: usage, globalData: globalData)
		linux then appendArm64LinuxRuntimeChunks(chunks, usage: usage, globalData: globalData)
		windows then panic("buildArm64Backend: there is no arm64-Windows lane in this compiler — `Target` admits the pair only through `arm64OsCallKind`'s two OSes")
		wasi then panic("buildArm64Backend: `wasm32-wasi` is not an arm64 lane — a WASI component has no arm64 `.text` at all, so an `Os.wasi` reaching this backend is a target-construction bug")
	end 'hostSurface'
	// MAC3: the three hand-assembled green-thread chunks, on the same `usesGt` bit `installGtRuntime` was
	// gated on rather than a probe of the module — the reason `BackendDispatch` gives for the x64 twin.
	if usage.usesGt 'gtChunks'
		appendArm64GtRuntimeChunks(chunks, target: target)
	end 'gtChunks'
	recordPhase(project, phase: CompilePhase.encode, probe: encodeProbe)

	let linkProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.link)
	let codeResult = try concatArm64FunctionChunks(targetModule, stdModule: stdModule, chunks: chunks, globalData: globalData, project: project, funcNames: funcNames)
	recordPhase(project, phase: CompilePhase.link, probe: linkProbe)

	return codeResult
end 'buildArm64Backend'
