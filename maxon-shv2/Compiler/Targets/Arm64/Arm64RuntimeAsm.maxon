// Arm64RuntimeAsm — the assembler the arm64 RUNTIME CHUNKS are hand-written with: a frame, locals,
// chunk-local labels, and the emit fragments every such chunk repeats.
//
// ⭐ **IT WAS `Arm64PanicRuntime`'s PRIVATE HARNESS UNTIL THERE WERE TWO RUNTIMES.** The panic runtime was
// the first hand-assembled arm64 code in the tree, so its assembler lived beside it; `Arm64DarwinRuntime`
// is the second, and a `type` declared in one file is invisible to the other — Maxon's top-level namespace
// is flat, but a non-`export`ed declaration is file-private. Copying the harness would have been the
// project's own signature bug (ONE FACT WRITTEN DOWN TWICE) reproduced in the frame layout, where a drift
// between two copies is a corrupted stack rather than a compile error. So it moved here, whole, and the
// two runtimes are its two consumers.
//
// ⚠ **WHAT DID NOT MOVE, AND WHY.** `arm64EmitPrintConstant` stayed with the panic runtime: it branches to
// `mrt_write_cstr_stderr`, which is that runtime's own symbol, so it is a fragment OF a runtime rather than
// a fragment every runtime shares. The test is whether a second consumer could use it unchanged.

// The 5-bit encoding field of a NAMED physical GPR. It goes through the same `arm64GprField` every
// colored operand does (via `arm64PhysReg`) rather than reading the ordinal here, so the GPR/SIMD
// class check that guards every other encoding guards these too.
export function arm64RuntimeReg(reg Arm64Register) returns MachineWord
	return arm64GprField(arm64PhysReg(reg))
end 'arm64RuntimeReg'

// The 5-bit encoding field of a NAMED physical SIMD register — the `d`-side twin, through the same
// class-checking door (`arm64FpField` panics on a GPR exactly as `arm64GprField` panics on a SIMD
// register). The green-thread context switch and the relocating grower are its readers: both move
// d-registers by name rather than by colouring.
export function arm64RuntimeFpReg(reg Arm64Register) returns MachineWord
	return arm64FpField(arm64PhysReg(reg))
end 'arm64RuntimeFpReg'

// ==========================================================================
// The chunk assembler
// ==========================================================================

// Assembles ONE hand-written arm64 runtime function into a `FunctionCodeChunk`: the buffers the
// encoders file into, a chunk-local label allocator for its branches, and the frame.
//
// It carries no per-instruction methods, for `X64RuntimeAsm`'s reason: `Arm64Backend`'s encoders ARE
// the instruction vocabulary and are called directly. What lives here is only what needs STATE — the
// frame, and the labels.
export type Arm64RuntimeAsm
	export var code as ByteArray
	export var callFixups as CallFixupArray
	export var iatRelocs as RelocationArray
	export var rdataRelocs as RdataRelocationArray
	export var funcAdrpRelocs as Arm64FuncAdrpRelocArray
	export var labelOffsets as BlockOffsetTable
	export var branchFixups as Arm64BlockBranchFixupArray
	export var nextLabel as BlockId
	export var frameBytes as StackSize
	export var slotCount as StackSize

	// Open a function: a real frame record (`stp x29, x30, [sp, #-N]!; mov x29, sp`) plus `slots`
	// 8-byte locals above it. EVERY chunk here is framed, and not merely because it calls something:
	// `mrt_panic` SEEDS the walk from its own x29, and a chunk with no record would leave a hole in
	// the very chain it is about to print.
	export static function beginFunction(slots StackSize) returns Arm64RuntimeAsm
		let frameBytes = alignUpStack(Arm64FrameRecordBytes + slots * SpillSlotBytes, alignment: StackFrameAlignment)

		var code = ByteArray.create()
		arm64EmitPrologue(code, frameSize: frameBytes, recordOffset: NoOutgoingArgRegion)

		return Self{
			code: code,
			callFixups: CallFixupArray.create(),
			iatRelocs: RelocationArray.create(),
			rdataRelocs: RdataRelocationArray.create(),
			funcAdrpRelocs: Arm64FuncAdrpRelocArray.create(),
			labelOffsets: BlockOffsetTable.create(),
			branchFixups: Arm64BlockBranchFixupArray.create(),
			nextLabel: 0,
			frameBytes: frameBytes,
			slotCount: slots
		}
	end 'beginFunction'

	// ⭐⭐ **OPEN A FUNCTION WITH NO FRAME AT ALL (MAC3) — the shape the GREEN-THREAD chunks need, and the
	// one `beginFunction` above structurally cannot give them.**
	//
	// `__gt_context_switch` MOVES SP between two green threads' stacks and `__gt_trampoline` is entered by a
	// `ret` into a frame no prologue built; a frame record opened here would be laid on one stack and torn
	// down on another. `__gt_morestack` is frameless for a third reason: its frame lives on the P's SYSTEM
	// stack, which it switches to itself, so the record must go there rather than on the near-overflow green
	// thread stack it exists to rescue.
	//
	// ⚠ **A RAW CHUNK HAS NO LOCALS**: `slotOffset` panics for every index, because `slotCount` is 0 and the
	// only base it could address off is an x29 this function never established. A chunk that wants a local
	// wants `beginFunction`.
	//
	// ⚠ **AND IT IS NOT A LINK IN THE BACKTRACE CHAIN.** `Arm64PrologueEpilogue`'s header states the rule
	// these three break — every function is framed, so the saved-x29 chain has no hole — and each breaks it
	// deliberately: the switch and the trampoline sit at a green thread's stack BOUNDARY, where the chain
	// legitimately ends (`__gt_spawn` seeds a fresh GT's x29 slot to 0, which is what stops the walk), and
	// morestack runs off the chain entirely. `mrt_start` is frameless for the same class of reason.
	export static function beginRawFunction() returns Arm64RuntimeAsm
		return Self{
			code: ByteArray.create(),
			callFixups: CallFixupArray.create(),
			iatRelocs: RelocationArray.create(),
			rdataRelocs: RdataRelocationArray.create(),
			funcAdrpRelocs: Arm64FuncAdrpRelocArray.create(),
			labelOffsets: BlockOffsetTable.create(),
			branchFixups: Arm64BlockBranchFixupArray.create(),
			nextLabel: 0,
			frameBytes: 0,
			slotCount: 0
		}
	end 'beginRawFunction'

	// Close a RETURNING function: the epilogue (the exact mirror of the prologue, so sp comes home by
	// balanced arithmetic and x30 is restored) and the `ret`.
	export function finishFunction(name ByteArray) returns FunctionCodeChunk
		arm64EmitEpilogue(self.code, frameSize: self.frameBytes, recordOffset: NoOutgoingArgRegion)
		arm64EmitRet(self.code)
		return self.finishChunk(name)
	end 'finishFunction'

	// Resolve the branches and seal the chunk — the tail `finishFunction` runs after its epilogue, and
	// ALSO the whole closer for a DIVERGING function, one that ends in a process exit and a `brk`. Such a
	// function tears down no frame: restoring it would be reachable only if the exit primitive returned,
	// and RETURNING there is strictly worse than trapping. A diverging chunk therefore calls this
	// directly rather than passing `finishFunction` a flag — whether the frame comes down at all is the
	// whole of what a closer decides.
	export function finishChunk(name ByteArray) returns FunctionCodeChunk
		arm64ResolveBlockBranches(self.code, blockOffsets: self.labelOffsets, fixups: self.branchFixups)

		var chunk = FunctionCodeChunk.createWith(name, code: self.code, callFixups: self.callFixups, rdataRelocs: self.rdataRelocs, iatRelocs: self.iatRelocs, rdataConstants: GlobalDataTable.create())
		chunk.funcAdrpRelocs = self.funcAdrpRelocs
		return chunk
	end 'finishChunk'

	// Mint a fresh chunk-local label id.
	export function newLabel() returns BlockId
		let id = self.nextLabel
		self.nextLabel = id + 1
		return id
	end 'newLabel'

	// Fix `label` at the current offset. Every branch to it — already emitted or not — is patched by
	// the closer.
	export function placeLabel(label BlockId)
		self.labelOffsets.place(label, value: self.code.count())
	end 'placeLabel'

	// The `[x29 + off]` byte offset of local slot `index`. arm64 slots grow UPWARD from the frame
	// record (unlike x64's, which grow down from rbp), so a runtime chunk's local is at the SAME
	// displacement the allocator's spills are — read from `arm64SlotDisplacement` rather than respelled,
	// which is what keeps a future change to the frame layout from moving one and not the other.
	export function slotOffset(index StackSize) returns MachineWord
		if index >= self.slotCount 'outOfFrame'
			panic("Arm64RuntimeAsm.slotOffset: slot {index} is outside the {self.slotCount} this frame reserved — `beginFunction` was asked for too few slots")
		end 'outOfFrame'
		return arm64SlotDisplacement(index as SpillSlot)
	end 'slotOffset'
end 'Arm64RuntimeAsm'

// The scale a BYTE access divides its immediate offset by. One, because a `strb`/`ldrb` immediate
// counts bytes — named rather than written as a bare `1` beside the 8s and 4s of the wider forms,
// where a lone digit says nothing about which of them it is.
let ByteAccessStride = 1

// A runtime chunk's frame record sits at SP: none of them passes an argument on the stack, so there
// is no outgoing-argument region to displace it (see `Arm64PrologueEpilogue`'s `recordOffset`).
let NoOutgoingArgRegion = 0 as StackSize

// ==========================================================================
// Shared emit fragments
// ==========================================================================

// `str Xt, [x29, #slot]` / `ldr Xt, [x29, #slot]` — a runtime chunk's locals. Slot offsets are
// positive and 8-aligned by construction, so the scaled unsigned form always encodes.
export function arm64EmitStoreSlot(asm Arm64RuntimeAsm, reg Arm64Register, slot StackSize)
	arm64EmitScaledMem(asm.code, opcode: Arm64OpStrX, rt: arm64RuntimeReg(reg), baseReg: arm64RuntimeReg(Arm64Register.x29), byteOffset: asm.slotOffset(slot), scale: SpillSlotBytes)
end 'arm64EmitStoreSlot'

export function arm64EmitLoadSlot(asm Arm64RuntimeAsm, reg Arm64Register, slot StackSize)
	arm64EmitScaledMem(asm.code, opcode: Arm64OpLdrX, rt: arm64RuntimeReg(reg), baseReg: arm64RuntimeReg(Arm64Register.x29), byteOffset: asm.slotOffset(slot), scale: SpillSlotBytes)
end 'arm64EmitLoadSlot'

// `ldr Xt, [Xn, #byteOffset]` — a 64-bit load through an arbitrary base (a frame record's two words,
// a chain link).
export function arm64EmitLoadWord64At(asm Arm64RuntimeAsm, dest Arm64Register, base Arm64Register, byteOffset MachineWord)
	arm64EmitScaledMem(asm.code, opcode: Arm64OpLdrX, rt: arm64RuntimeReg(dest), baseReg: arm64RuntimeReg(base), byteOffset: byteOffset, scale: SpillSlotBytes)
end 'arm64EmitLoadWord64At'

// `str Xt, [Xn, #byteOffset]` — the 64-bit STORE twin. Every hand-assembled arm64 runtime writes through a
// pointer it was handed: the Darwin host surface's out-params, the green-thread chunks' GT struct fields and
// the relocating grower's chain links. It lives beside its load rather than three times over.
export function arm64EmitStoreWord64At(asm Arm64RuntimeAsm, src Arm64Register, base Arm64Register, byteOffset MachineWord)
	arm64EmitScaledMem(asm.code, opcode: Arm64OpStrX, rt: arm64RuntimeReg(src), baseReg: arm64RuntimeReg(base), byteOffset: byteOffset, scale: SpillSlotBytes)
end 'arm64EmitStoreWord64At'

// ⭐⭐⭐ **THE STORE-RELEASE TWIN — `add scratch, Xn, #byteOffset` then `stlr Xt, [scratch]` (G3).** A plain
// `str` announces nothing: on this ISA the stores before it may still be invisible to another core when it
// lands. `STLR` orders every earlier memory access before itself, which is what a hand-assembled runtime
// needs at the exact moment it publishes a word another OS thread polls.
//
// ⚠ **THE `add` IS NOT AVOIDABLE AND THE SCRATCH IS THE CALLER'S.** `STLR` is a load/store-exclusive-group
// encoding with no displacement field at all (`TargetOp.arm64LoadAcquire` states why the `FEAT_LRCPC2`
// offset forms are not used), so the field address has to exist in a register first. The scratch is a
// PARAMETER rather than a fixed x16 for `arm64EmitStoreWord64Unaligned`'s reason: a hand-assembled chunk
// knows which of its own registers is dead and the helper cannot.
//
// ⚠ It is the SAME encoder the isel uses (`arm64EmitOrderedAccess`), so a change to the instruction reaches
// the compiled and the hand-assembled publication together.
export function arm64EmitStoreReleaseWord64At(asm Arm64RuntimeAsm, src Arm64Register, base Arm64Register, byteOffset Imm32, scratch Arm64Register)
	arm64EmitAddRuntimeImm(asm, dest: scratch, base: base, imm: byteOffset)
	arm64EmitOrderedAccess(asm.code, byteOpcode: Arm64OpStlrB, rt: arm64RuntimeReg(src), rn: arm64RuntimeReg(scratch), width: X64AccessWidth.word64)
end 'arm64EmitStoreReleaseWord64At'

// ⭐ **THE ADDRESS OF A NUL-TERMINATED `.rdata` CONSTANT IN x0** — the shared half of "hand libSystem, or the
// panic runtime, a fixed string". The constant rides the SAME immortal, byte-deduped blob channel a String
// literal's payload takes (`registerStringBlob`), addressed with the mandated ADRP+ADD pair, so no runtime
// needs a data channel of its own. It registers during the ENCODE phase, after every user literal, so it
// APPENDS to `.rdata` and moves no label id and no pinned prefix (see `specs-shv2/rdata-section.md`).
//
// ⚠ It stops at the ARGUMENT. What follows differs by runtime and by intent — the panic runtime WRITES the
// string and returns, the green-thread floor ABORTS through `mrt_panic` and does not — so the branch is each
// caller's and only the materialisation is shared.
export function arm64EmitCStringArg(asm Arm64RuntimeAsm, globalData GlobalDataTable, bytes ByteArray)
	let label = registerStringBlob(globalData, bytes: bytes)
	arm64EmitAdrpAddPair(asm.code, rdataRelocs: asm.rdataRelocs, dest: arm64RuntimeReg(Arm64Register.x0), label: label.toByteArray(), adrpKind: RdataRelocKind.arm64Adrp, pageOffKind: RdataRelocKind.arm64PageOff)
end 'arm64EmitCStringArg'

// `ldr Wt, [Xn, #byteOffset]` — a `__symtable` column. 32 bits, ZERO-extended into the full X
// register, which is what makes the count and both entry fields read as the u32s the writer emitted.
export function arm64EmitLoadColumn(asm Arm64RuntimeAsm, dest Arm64Register, base Arm64Register, byteOffset Imm32)
	arm64EmitScaledMem(asm.code, opcode: Arm64OpLdrW, rt: arm64RuntimeReg(dest), baseReg: arm64RuntimeReg(base), byteOffset: byteOffset as MachineWord, scale: SymbolTableColumnBytes)
end 'arm64EmitLoadColumn'

// `ldrb Wt, [Xn, #0]` — one byte of a C string, zero-extended, so the `cbz` that follows tests the
// whole register against the NUL.
export function arm64EmitLoadByte(asm Arm64RuntimeAsm, dest Arm64Register, base Arm64Register)
	arm64EmitScaledMem(asm.code, opcode: Arm64OpLdrB, rt: arm64RuntimeReg(dest), baseReg: arm64RuntimeReg(base), byteOffset: 0, scale: ByteAccessStride)
end 'arm64EmitLoadByte'

// `strb Wt, [Xn, #0]` — the store twin, and the second half of a byte-at-a-time C-string copy. The
// register's upper 56 bits are ignored by the encoding, so a byte read with `arm64EmitLoadByte` can be
// written straight back with no masking step.
export function arm64EmitStoreByte(asm Arm64RuntimeAsm, src Arm64Register, base Arm64Register)
	arm64EmitScaledMem(asm.code, opcode: Arm64OpStrB, rt: arm64RuntimeReg(src), baseReg: arm64RuntimeReg(base), byteOffset: 0, scale: ByteAccessStride)
end 'arm64EmitStoreByte'

export function arm64EmitMovRuntimeReg(asm Arm64RuntimeAsm, dest Arm64Register, src Arm64Register)
	arm64EmitMovGpr(asm.code, rd: arm64RuntimeReg(dest), rn: arm64RuntimeReg(src))
end 'arm64EmitMovRuntimeReg'

// `mov Xd, #value` — the movz/movk ladder, which already answers zero with `mov Xd, XZR`.
export function arm64EmitMovRuntimeImm(asm Arm64RuntimeAsm, dest Arm64Register, value MachineWord)
	arm64EmitMovImm(asm.code, rd: arm64RuntimeReg(dest), value: value)
end 'arm64EmitMovRuntimeImm'

// `add Xd, Xn, Xm` / `sub Xd, Xn, Xm`.
export function arm64EmitAddRuntimeReg(asm Arm64RuntimeAsm, dest Arm64Register, lhs Arm64Register, rhs Arm64Register)
	emitArm64Rrr(asm.code, opcode: Arm64OpAdd, rd: arm64RuntimeReg(dest), rn: arm64RuntimeReg(lhs), rm: arm64RuntimeReg(rhs))
end 'arm64EmitAddRuntimeReg'

export function arm64EmitSubRuntimeReg(asm Arm64RuntimeAsm, dest Arm64Register, lhs Arm64Register, rhs Arm64Register)
	emitArm64Rrr(asm.code, opcode: Arm64OpSub, rd: arm64RuntimeReg(dest), rn: arm64RuntimeReg(lhs), rm: arm64RuntimeReg(rhs))
end 'arm64EmitSubRuntimeReg'

// `add Xd, Xn, #imm` — a signed immediate, so a negative one encodes as the SUB form.
export function arm64EmitAddRuntimeImm(asm Arm64RuntimeAsm, dest Arm64Register, base Arm64Register, imm Imm32)
	arm64EmitAddImmSigned(asm.code, rd: arm64RuntimeReg(dest), rn: arm64RuntimeReg(base), imm: imm)
end 'arm64EmitAddRuntimeImm'

export function arm64EmitCmpRuntimeReg(asm Arm64RuntimeAsm, lhs Arm64Register, rhs Arm64Register)
	arm64EmitCmpReg(asm.code, rn: arm64RuntimeReg(lhs), rm: arm64RuntimeReg(rhs))
end 'arm64EmitCmpRuntimeReg'

export function arm64EmitCmpRuntimeImm(asm Arm64RuntimeAsm, reg Arm64Register, imm Imm32)
	arm64EmitCmpImm(asm.code, rn: arm64RuntimeReg(reg), imm: imm)
end 'arm64EmitCmpRuntimeImm'

export function arm64EmitBranchTo(asm Arm64RuntimeAsm, label BlockId)
	arm64EmitBranch(asm.code, fixups: asm.branchFixups, targetBlock: label)
end 'arm64EmitBranchTo'

export function arm64EmitCondBranchTo(asm Arm64RuntimeAsm, cond Arm64CondCode, label BlockId)
	arm64EmitCondBranch(asm.code, fixups: asm.branchFixups, cond: cond, targetBlock: label)
end 'arm64EmitCondBranchTo'

export function arm64EmitCbzTo(asm Arm64RuntimeAsm, reg Arm64Register, label BlockId)
	arm64EmitCbz(asm.code, fixups: asm.branchFixups, reg: arm64RuntimeReg(reg), targetBlock: label)
end 'arm64EmitCbzTo'

// The complement. A chunk that has both spellings can branch on the case it wants to LEAVE rather than
// emitting a `cbz` over an unconditional `b`, which is two instructions and an extra label to say one thing.
export function arm64EmitCbnzTo(asm Arm64RuntimeAsm, reg Arm64Register, label BlockId)
	arm64EmitCbnz(asm.code, fixups: asm.branchFixups, reg: arm64RuntimeReg(reg), targetBlock: label)
end 'arm64EmitCbnzTo'

// The OS door every terminal step in this file goes through — the same one `StdToArm64Conversion`'s
// `lowerOsExit` uses, so the panic runtime cannot grow a second opinion about which OSes this backend
// serves or how each one is reached.
export function arm64EmitOsPrimitive(asm Arm64RuntimeAsm, os Os, importSlot OsImportSlot, syscallNumber MachineWord)
	match arm64OsCallKind(os) 'route'
		importCall then arm64EmitImportCall(asm.code, iatRelocs: asm.iatRelocs, slotIndex: osImportSlotIndex(importSlot))
		syscall then arm64EmitSyscall(asm.code, number: syscallNumber)
	end 'route'
end 'arm64EmitOsPrimitive'

// ==========================================================================
// The POSIX host surfaces' shared fragments
// ==========================================================================

// ⭐ **THESE SEVEN WERE `Arm64DarwinRuntime`'s PRIVATE FRAGMENTS UNTIL THERE WERE TWO POSIX LANES.** They
// carry no Darwin content at all — a `str` at an unaligned offset, a `strlen`, a bounded copy — and the
// arm64-LINUX host surface (`Arm64LinuxRuntime`) needs every one of them. They moved here whole for the
// reason this file exists at all: a copied frame-layout or copied loop-termination fragment drifts into a
// corrupted stack rather than into a compile error. The test each one passes is the header's: a second
// consumer can use it UNCHANGED.

// `add Xd, x29, #<slot>` — the ADDRESS of a frame local, for the out-param calls that fill one.
export function arm64EmitSlotAddr(asm Arm64RuntimeAsm, dest Arm64Register, slot StackSize)
	arm64EmitAddRuntimeImm(asm, dest: dest, base: Arm64Register.x29, imm: asm.slotOffset(slot) as Imm32)
end 'arm64EmitSlotAddr'

// `<op> Xd, Xn, Xm` for the three-register arithmetic these chunks need (`mul`, `udiv`, `and`, `orr`). The
// register-name spelling goes through `arm64RuntimeReg` like every other operand in a runtime chunk, so the
// GPR class check that guards an allocated operand guards these too.
export function arm64EmitRuntimeRrr(asm Arm64RuntimeAsm, opcode MachineWord, dest Arm64Register, lhs Arm64Register, rhs Arm64Register)
	emitArm64Rrr(asm.code, opcode: opcode, rd: arm64RuntimeReg(dest), rn: arm64RuntimeReg(lhs), rm: arm64RuntimeReg(rhs))
end 'arm64EmitRuntimeRrr'

// `ldr Wt, [Xn, #byteOffset]` — a 32-bit ZERO-EXTENDING load, for the C `int`s and `mode_t`s these surfaces
// read out of structures the OS owns. The offset must be 4-aligned, which every field read through it is.
export function arm64EmitLoadWord32At(asm Arm64RuntimeAsm, dest Arm64Register, base Arm64Register, byteOffset MachineWord)
	arm64EmitScaledMem(asm.code, opcode: Arm64OpLdrW, rt: arm64RuntimeReg(dest), baseReg: arm64RuntimeReg(base), byteOffset: byteOffset, scale: RuntimeWord32Bytes)
end 'arm64EmitLoadWord32At'

// `str Wt, [Xn, #byteOffset]` — the store twin, and the ONLY width that may be used on a C `int` the OS
// owns: `*__error()` on Darwin is one, and a 64-bit store there would write four bytes into whatever the C
// library placed after it.
export function arm64EmitStoreWord32At(asm Arm64RuntimeAsm, src Arm64Register, base Arm64Register, byteOffset MachineWord)
	arm64EmitScaledMem(asm.code, opcode: Arm64OpStrW, rt: arm64RuntimeReg(src), baseReg: arm64RuntimeReg(base), byteOffset: byteOffset, scale: RuntimeWord32Bytes)
end 'arm64EmitStoreWord32At'

// A C `int` is four bytes wide.
let RuntimeWord32Bytes = 4

// `str Xt, [Xn, #byteOffset]` for an offset that is NOT 8-aligned — the address is formed first and the
// store then uses offset 0. `WIN32_FIND_DATAA` begins with a DWORD, so three of its four 64-bit fields sit
// at 4, 12 and 20; the scaled store form cannot encode any of them and the unscaled one is not exposed.
export function arm64EmitStoreWord64Unaligned(asm Arm64RuntimeAsm, src Arm64Register, base Arm64Register, byteOffset MachineWord, scratch Arm64Register)
	arm64EmitAddRuntimeImm(asm, dest: scratch, base: base, imm: byteOffset as Imm32)
	arm64EmitStoreWord64At(asm, src: src, base: scratch, byteOffset: 0)
end 'arm64EmitStoreWord64Unaligned'

// ⭐ **`dest = strlen(src)`** — a C string carries no length and none of the APIs that hand one over here
// answers one either.
//
// ⚠ **IT WAS WRITTEN OUT TWICE BEFORE MAC4** (`mrt_host_exe_path` and `mrt_host_env_read` each had a
// copy) and MAC4 would have made it four. Both of those call this, which is why the fragment takes its
// registers as parameters rather than fixing them: the two callers had already chosen different ones.
export function arm64EmitCStringLength(asm Arm64RuntimeAsm, src Arm64Register, dest Arm64Register, cursor Arm64Register, scratch Arm64Register)
	let walk = asm.newLabel()
	let atNul = asm.newLabel()

	arm64EmitMovRuntimeReg(asm, dest: cursor, src: src)

	asm.placeLabel(walk)
	arm64EmitLoadByte(asm, dest: scratch, base: cursor)
	arm64EmitCbzTo(asm, reg: scratch, label: atNul)
	arm64EmitAddRuntimeImm(asm, dest: cursor, base: cursor, imm: 1)
	arm64EmitBranchTo(asm, label: walk)

	asm.placeLabel(atNul)
	arm64EmitSubRuntimeReg(asm, dest: dest, lhs: cursor, rhs: src)
end 'arm64EmitCStringLength'

// ⭐ **COPY BYTES FROM `src` TO `dest` UNTIL A NUL OR UNTIL `limit` BYTES HAVE MOVED, AND ALWAYS TERMINATE.**
// Callers with different reasons for a bound: a directory prefix is cut at a `/` the source does not mark, a
// duplicated string is bounded by its own length, and a `cFileName` is bounded by `MAX_PATH`. One loop,
// because the part that is easy to get silently wrong — writing the terminator on BOTH exits — is the part
// they share.
//
// ⚠ It CONSUMES `src`, `dest` and `limit` (all three are stepped) and clobbers `scratch`.
export function arm64EmitCopyCStringBounded(asm Arm64RuntimeAsm, src Arm64Register, dest Arm64Register, limit Arm64Register, scratch Arm64Register)
	let step = asm.newLabel()
	let terminate = asm.newLabel()

	asm.placeLabel(step)
	arm64EmitCbzTo(asm, reg: limit, label: terminate)
	arm64EmitLoadByte(asm, dest: scratch, base: src)
	arm64EmitCbzTo(asm, reg: scratch, label: terminate)
	arm64EmitStoreByte(asm, src: scratch, base: dest)
	arm64EmitAddRuntimeImm(asm, dest: src, base: src, imm: 1)
	arm64EmitAddRuntimeImm(asm, dest: dest, base: dest, imm: 1)
	arm64EmitAddRuntimeImm(asm, dest: limit, base: limit, imm: -1)
	arm64EmitBranchTo(asm, label: step)

	asm.placeLabel(terminate)
	arm64EmitMovRuntimeImm(asm, dest: scratch, value: NulByte as MachineWord)
	arm64EmitStoreByte(asm, src: scratch, base: dest)
end 'arm64EmitCopyCStringBounded'
