// Shared byte-writing utilities and typealiases used across emitters and writers.

// `BytePos` is NOT declared here: `stdlib/String.maxon` exports it, identically, and a count of
// bytes is one fact. Two more copies lived here and in `Compiler/PhaseProbe.maxon` until the flat
// namespace check refused them.
export typealias ByteOffset = int(0 to u64.max)

// Dense column of byte offsets — the two span columns of `SourceRangeTable`.
export typealias ByteOffsetArray = Array with ByteOffset

// ⚠ A SECOND `MachineWord` EXISTS AND IT NOW AGREES WITH THIS ONE. `stdlib/Internals.maxon` also
// declares `MachineWord = int(0 to u64.max)`, for the same reason: an address, a size, a file
// offset, a raw bit pattern is unsigned by nature.
//
// ⛔ **THAT WAS NOT ALWAYS TRUE, AND THIS COMMENT USED TO ARGUE THE OPPOSITE.** It said the two had
// "the OPPOSITE DOMAIN" and that the runtime's had to admit negatives for "an atomic delta or a
// pointer step". The atomic delta was real; putting it under the SAME name as an address was the
// defect. That file now splits the facts it was carrying at once into `MachineWord`,
// `BufferCoordinate`, `ElementStride` and `RefCountDelta` — so the disagreement described here was
// never between two `MachineWord`s, it was inside one of them. The two names still do not collide,
// because that one is module-private while this one is `export`ed.
//
export typealias MachineWord = int(0 to u64.max)

// A signed 32-bit immediate / displacement operand — the value an x64 instruction
// carries in a `id` (imm32) or a `disp32` field: a group-1 immediate ALU op's
// literal, an `imul r, r/m, imm32` multiplier, an `lea`'s address displacement.
// Signed because a displacement can be negative (`a - imm` lowers to `lea dest,
// [base - imm]`, a negative disp). The Std tier's `binOpImm`/`cmpImm` and the
// Target tier's immediate ops carry this; the encoder writes its two's-complement
// low 32 bits (see writeImm32Signed).
export typealias Imm32 = int(i32.min to i32.max)

export typealias CodeOffset = int(0 to u64.max)
export typealias CodeOffsetArray = Array with CodeOffset
export typealias StackSize = int(0 to u64.max)

export function writeWord(buf ByteArray, value MachineWord)
	buf.push(value and 0xFF)
	buf.push((value shr 8) and 0xFF)
end 'writeWord'

export function writeDword(buf ByteArray, value MachineWord)
	buf.push(value and 0xFF)
	buf.push((value shr 8) and 0xFF)
	buf.push((value shr 16) and 0xFF)
	buf.push((value shr 24) and 0xFF)
end 'writeDword'

export function writeQword(buf ByteArray, value MachineWord)
	buf.push(value and 0xFF)
	buf.push((value shr 8) and 0xFF)
	buf.push((value shr 16) and 0xFF)
	buf.push((value shr 24) and 0xFF)
	buf.push((value shr 32) and 0xFF)
	buf.push((value shr 40) and 0xFF)
	buf.push((value shr 48) and 0xFF)
	buf.push((value shr 56) and 0xFF)
end 'writeQword'

export function writeZeros(buf ByteArray, n BytePos)
	for _ in 0 upto n 'zeros'
		buf.push(0)
	end 'zeros'
end 'writeZeros'

function writeAscii(buf ByteArray, text String)
	for ch in text 'chars'
		// Callers pass known-ASCII text (mnemonics, symbol/section labels), so a non-ASCII
		// char is a programmer error, not recoverable input — fail loudly rather than
		// silently emitting a null byte that would corrupt the output.
		let b = try ch.asciiValue() otherwise panic("writeAscii: non-ASCII character in an ASCII-only context")
		buf.push(b)
	end 'chars'
	buf.push(0)
end 'writeAscii'

export function padTo(buf ByteArray, size BytePos)
	while buf.count() < size 'pad'
		buf.push(0)
	end 'pad'
end 'padTo'

// Raised when a byte-reader would run past the end of its buffer. Readers
// deserialize data that may be CORRUPT or TRUNCATED (e.g. a damaged on-disk
// cache file), so an out-of-range read is a recoverable condition the caller
// must decide on — NOT a panic buried in the helper. Each caller handles it
// explicitly: code emitters, where a short buffer is a guaranteed compiler bug,
// use `otherwise panic(...)` so the bug surfaces at the call site with context;
// deserializers of untrusted bytes (the cache decoder) translate it into their
// own recoverable error (e.g. `CacheCorruption.invalidEncoding`) and rebuild.
export union ByteReadError implements Error
	// A read crossed `buf.count()`. `offset`/`width`/`available` pin down the
	// overrun for the caller's panic/log message.
	outOfRange(offset ByteOffset, width BytePos, available BytePos)
end 'ByteReadError'

export function readDword(buf ByteArray, offset ByteOffset) returns MachineWord throws ByteReadError
	if offset + 4 > buf.count() 'oob'
		throw ByteReadError.outOfRange(offset, width: 4, available: buf.count())
	end 'oob'
	var result = 0
	try 'readBytes'
		let b0 = buf.get(offset)
		let b1 = buf.get(offset + 1)
		let b2 = buf.get(offset + 2)
		let b3 = buf.get(offset + 3)
		result = (b0 as MachineWord) or ((b1 as MachineWord) shl 8) or ((b2 as MachineWord) shl 16) or ((b3 as MachineWord) shl 24)
	end 'readBytes' otherwise (e) 'badRead'
		match e 'kind'
			// Bounds were just checked, so an OOB here is impossible; an empty slot
			// would be a push-init invariant break, which IS a local bug.
			indexOutOfBounds then panic("readDword: offset+4 <= buf.count() checked but get OOB (offset={offset}, buf.count={buf.count()})")
			emptySlot then panic("readDword: byte slot empty (push-init invariant)")
		end 'kind'
	end 'badRead'
	return result
end 'readDword'

function readQword(buf ByteArray, offset ByteOffset) returns MachineWord throws ByteReadError
	let lo = try readDword(buf, offset: offset)
	let hi = try readDword(buf, offset: offset + 4)
	return lo or (hi shl 32)
end 'readQword'

export function patchWord(buf ByteArray, offset ByteOffset, value MachineWord)
	// Caller's contract: offset+2 <= buf.count(). Both byte writes share this single invariant.
	try 'writeBytes'
		buf.set(offset, value: value and 0xFF)
		buf.set(offset + 1, value: (value shr 8) and 0xFF)
	end 'writeBytes' otherwise (e) 'badWrite'
		match e 'kind'
			indexOutOfBounds then panic("patchWord: caller must ensure offset+2 <= buf.count() (offset={offset}, buf.count={buf.count()})")
			emptySlot then panic("patchWord: byte slot empty (push-init invariant)")
		end 'kind'
	end 'badWrite'
end 'patchWord'

export function patchDword(buf ByteArray, offset ByteOffset, value MachineWord)
	// Caller's contract: offset+4 <= buf.count(). All four byte writes share this single invariant.
	try 'writeBytes'
		buf.set(offset, value: value and 0xFF)
		buf.set(offset + 1, value: (value shr 8) and 0xFF)
		buf.set(offset + 2, value: (value shr 16) and 0xFF)
		buf.set(offset + 3, value: (value shr 24) and 0xFF)
	end 'writeBytes' otherwise (e) 'badWrite'
		match e 'kind'
			indexOutOfBounds then panic("patchDword: caller must ensure offset+4 <= buf.count() (offset={offset}, buf.count={buf.count()})")
			emptySlot then panic("patchDword: byte slot empty (push-init invariant)")
		end 'kind'
	end 'badWrite'
end 'patchDword'

export function patchQword(buf ByteArray, offset ByteOffset, value MachineWord)
	patchDword(buf, offset: offset, value: value and 0xFFFFFFFF)
	patchDword(buf, offset: offset + 4, value: (value shr 32) and 0xFFFFFFFF)
end 'patchQword'

export function writeDwordBE(buf ByteArray, value MachineWord)
	buf.push((value shr 24) and 0xFF)
	buf.push((value shr 16) and 0xFF)
	buf.push((value shr 8) and 0xFF)
	buf.push(value and 0xFF)
end 'writeDwordBE'

export function writeQwordBE(buf ByteArray, value MachineWord)
	writeDwordBE(buf, value: (value shr 32) and 0xFFFFFFFF)
	writeDwordBE(buf, value: value and 0xFFFFFFFF)
end 'writeQwordBE'

export function alignUp(value BytePos, alignment BytePos) returns BytePos
	return (value + alignment - 1) and not (alignment - 1)
end 'alignUp'

// Assert a signed PC-relative displacement fits in `bits` two's-complement bits.
// `byteOff` arrives as a u64 (MachineWord is unsigned), so a negative displacement
// shows up as a value near u64.max; check both the small-positive and the
// wrapped-large-negative ends of the encodable window and panic loudly otherwise —
// a relocation that overflowed its instruction's reach is a hard link-time error,
// never a silent address truncation.
// The relocation site a patch is being applied at — an ENUM, not a String tag. It exists
// only to name the site in the overflow panic below, and a String parameter is evaluated
// EAGERLY: every patched jump, call and IAT entry allocated a heap String to carry a
// compile-time constant into a message that almost never prints. An enum is an int, so it
// costs nothing to pass, and `.name` inside the panic string stays lazy.
export enum PatchSite
	x64BlockJumpRel32
	x64CallRel32
	x64IatDisp32
	x64RdataDisp32
	// A hand-assembled runtime function's `lea r64, [rip + <chunk-local label>]` — how it
	// takes the address of a string it laid down at the end of its own chunk.
	x64RuntimeLabelDisp32
	// The `ja` closing the prologue's guard-page walk (`encodeStackProbe`). Its target is a byte
	// offset in the same buffer rather than a block, so it is patched the instant it is emitted —
	// it is here because the ±2 GiB guard names the site it fired on.
	x64StackProbeRel32
	// A branch INSIDE the byte-fill size ladder (`encodeX64MemFill`) — the same shape as the stack
	// probe's, and here for the same reason: its target is a byte offset in this buffer rather than a
	// block, so it is patched the instant the arm it selects has been laid down, and the ±2 GiB guard
	// needs a name for the site.
	x64MemFillRel32
	arm64Adr
	arm64LdrLiteral
	arm64Adrp
end 'PatchSite'

function assertSignedReach(byteOff MachineWord, bits MachineWord, what PatchSite, codeOffset CodeOffset, targetAddr MachineWord)
	let posMax = (1 shl (bits - 1)) - 1  // largest positive displacement
	let negMin = u64.max - (1 shl (bits - 1)) + 1  // smallest (most negative) two's-complement value, unsigned-wrapped
	if byteOff > posMax and byteOff < negMin 'overflow'
		panic("{what.name}: displacement out of ±{1 shl (bits - 1)} byte range (codeOffset={codeOffset}, target={targetAddr}, disp={byteOff}) — relocation overflow")
	end 'overflow'
end 'assertSignedReach'

// Width in bytes of an x64 rel32 / disp32 field (call rel32, jcc/jmp rel32,
// RIP-relative disp32). The single source of truth for the "+4" every consumer
// applies to reach the end of the instruction (rel32 and RIP-relative
// displacements are both measured from the byte past the 4-byte field).
export let X64Disp32Width = 4

// Patch an x64 rel32/disp32 field (call rel32, jcc/jmp rel32, RIP-relative
// disp32). Guards the ±2 GiB reach so an overflow is a loud link error, never a
// silently wrapped displacement — the x64 mirror of the ARM64 patchers below,
// which grew the same guards when the single-ADR leaFuncAddr truncation
// miscompiled function addresses past ±1 MiB.
export function patchX64Rel32(code ByteArray, codeOffset CodeOffset, rel MachineWord, what PatchSite, targetAddr MachineWord)
	assertSignedReach(rel, bits: 32, what: what, codeOffset: codeOffset, targetAddr: targetAddr)
	patchDword(code, offset: codeOffset as ByteOffset, value: rel)
end 'patchX64Rel32'

// Patch an ARM64 ADR instruction (imm21, byte-scaled, ±1 MiB) to point to a target
// address. Guards the ±1 MiB reach so an overflow is a loud link error, not a wrong
// address. Used by the small-reach single-ADR data/symdata/covdata global accessors.
export function patchArm64Adr(code ByteArray, codeOffset CodeOffset, instrAddr MachineWord, targetAddr MachineWord)
	let byteOff = targetAddr - instrAddr
	assertSignedReach(byteOff, bits: 21, what: PatchSite.arm64Adr, codeOffset: codeOffset, targetAddr: targetAddr)
	let immlo = byteOff and 0x3
	let immhi = (byteOff shr 2) and 0x7FFFF
	let origInsn = try readDword(code, offset: codeOffset as ByteOffset) otherwise panic("patchArm64Adr: codeOffset {codeOffset} past end of emitted code (count={code.count()}) — emitter bug")
	let rd = origInsn and 0x1F
	let patched = (immlo shl 29) or 0x10000000 or (immhi shl 5) or rd
	patchDword(code, offset: codeOffset as ByteOffset, value: patched)
end 'patchArm64Adr'

// Patch an ARM64 LDR-literal instruction (imm19, word-scaled, ±1 MiB) to point to a
// target address. Guards the ±1 MiB reach like patchArm64Adr.
export function patchArm64LdrLiteral(code ByteArray, codeOffset CodeOffset, instrAddr MachineWord, targetAddr MachineWord)
	let byteOff = targetAddr - instrAddr
	assertSignedReach(byteOff, bits: 21, what: PatchSite.arm64LdrLiteral, codeOffset: codeOffset, targetAddr: targetAddr)
	let wordOff = byteOff / 4
	let imm19 = wordOff and 0x7FFFF
	let origInsn = try readDword(code, offset: codeOffset as ByteOffset) otherwise panic("patchArm64LdrLiteral: codeOffset {codeOffset} past end of emitted code (count={code.count()}) — emitter bug")
	let patched = (origInsn and 0xFF00001F) or (imm19 shl 5)
	patchDword(code, offset: codeOffset as ByteOffset, value: patched)
end 'patchArm64LdrLiteral'

// Patch an ARM64 ADRP instruction (imm21, 4 KiB-page-scaled, ±4 GiB) to the page of
// `targetAddr`. The companion within-page byte offset goes into the FOLLOWING
// ADD/LDR/STR via patchArm64PageOff. Together they give data-global access ±4 GiB of
// reach — the import GOT path (patchRelocationsMachO) uses this exact ADRP shape.
// The ±4 GiB page reach is guarded so any future code-to-data blowup is a loud link
// error rather than a silent wrong page.
export function patchArm64Adrp(code ByteArray, codeOffset CodeOffset, instrAddr MachineWord, targetAddr MachineWord)
	let instrPage = instrAddr and not 0xFFF
	let targetPage = targetAddr and not 0xFFF
	let pageOff = targetPage - instrPage
	// ADRP's imm21 is scaled by the 4 KiB page, so its byte reach is 21+12 = 33 bits.
	assertSignedReach(pageOff, bits: 33, what: PatchSite.arm64Adrp, codeOffset: codeOffset, targetAddr: targetAddr)
	let pageOffShifted = pageOff shr 12
	let immlo = pageOffShifted and 0x3
	let immhi = (pageOffShifted shr 2) and 0x7FFFF
	let origInsn = try readDword(code, offset: codeOffset as ByteOffset) otherwise panic("patchArm64Adrp: codeOffset {codeOffset} past end of emitted code (count={code.count()}) — emitter bug")
	let rd = origInsn and 0x1F
	let patched = (immlo shl 29) or 0x90000000 or (immhi shl 5) or rd
	patchDword(code, offset: codeOffset as ByteOffset, value: patched)
end 'patchArm64Adrp'

// Patch the within-page byte offset of `targetAddr` into the imm12 of an ADD/LDR/STR
// that follows an ADRP (see patchArm64Adrp). The instruction's own opcode picks the
// imm12 scale: an ADD-immediate (top byte 0x91) carries the raw byte offset; an
// unsigned-offset LDR/STR Xn (0xF9...) carries byteOffset/8. The 4 KiB within-page
// offset always fits the 12-bit field for both scales (0xFFF unscaled, 0xFFF*8 =
// 0x7FF8 scaled covers the whole page), so no range guard is needed.
export function patchArm64PageOff(code ByteArray, codeOffset CodeOffset, targetAddr MachineWord)
	let pageOffset = targetAddr and 0xFFF
	let origInsn = try readDword(code, offset: codeOffset as ByteOffset) otherwise panic("patchArm64PageOff: codeOffset {codeOffset} past end of emitted code (count={code.count()}) — emitter bug")
	let topByte = (origInsn shr 24) and 0xFF
	let scale = 8 if topByte == 0xF9 else 1  // 0xF9 = LDR/STR Xn (scaled by 8); 0x91 = ADD imm (unscaled)
	if topByte != 0xF9 and topByte != 0x91 'badOpcode'
		panic("patchArm64PageOff: instruction at codeOffset {codeOffset} is neither ADD-imm (0x91) nor LDR/STR Xn (0xF9) — opcode top byte 0x{topByte} — emitter/reloc mismatch")
	end 'badOpcode'
	// `scale` is 1 or 8, never zero; `otherwise panic` is the project's form for a `try` that must not fail.
	let imm12 = (try (pageOffset / scale) otherwise panic("patchArm64PageOff: scale was 0 past its own two-valued choice")) and 0xFFF
	let patched = (origInsn and 0xFFC003FF) or (imm12 shl 10)
	patchDword(code, offset: codeOffset as ByteOffset, value: patched)
end 'patchArm64PageOff'
