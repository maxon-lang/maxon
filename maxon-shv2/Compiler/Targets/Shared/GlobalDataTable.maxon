// GlobalDataTable — the backend's .rdata/.rodata table: maps names to byte
// payloads for the read-only data section. LowerMaxonToStd registers string /
// byte-string literals here; the PE/ELF writers serialize `names`/`values` into
// the .rdata section and resolve code→rdata relocations against them.
//
// THIN for maxon-shv2 M1: the `return 42` slice registers NO rdata (no strings,
// no arrays, no layout descriptors), so the table exists only as the empty
// container the backend/writer boundary (`CodeResult`, `FunctionCodeChunk`)
// requires. It carries the core name→payload arrays plus the O(1) dedup indexes
// (kept from v1, where per-entry linear scans drove a quadratic build cost) so
// the append/lookup helpers B2 GROWS in stay O(1) from the start.
//
// P1.0d.5b GREW THE `.data` HALF BACK, exactly as this header said it would:
// `dataSection` + `dataIndex` below are the top-level-mutable-globals milestone
// arriving. v1's coverage-counter entries and rdata-internal pending relocations
// (CovDataEntry / pendingRdataRelocs) are still OMITTED until their milestones
// (coverage, layout descriptors) need them — they grow back the same way.

// `nameIndex`: registered global name → its index in `names`/`values` (O(1)
// membership + lookup). `valueDedup`: a previously-registered byte payload →
// its synthetic name, so a repeat registration of identical content returns the
// existing entry in O(1) instead of scanning every prior value.
export typealias GlobalNameIndexMap = Map with (String, MachineWord)
export typealias GlobalDedupMap = Map with (ByteArray, String)

// The synthetic-label prefix a dense-`match` jump table's `.rdata` blob is minted under
// (`registerJumpTable`). Distinct from the float/String prefixes so a jump table is recognisable in a
// fragment golden and never collides with them.
let JumpTableLabelPrefix = "__jumptable_"

// An `.rdata` label → its byte offset within the section. The read-only twin of `dataIndex`, and
// it exists for that field's reason: answering "where does this constant live?" with a linear sum
// over every prior payload would be Θ(constants × references), which is precisely the shape this
// file's header calls out in v1 and `sortBySizeDescendingStable` was rewritten to kill.
export typealias RdataOffsetMap = Map with (String, ByteOffset)

// ⭐ A DATA→DATA FIXUP for a String literal's record (P1.2 wave A): the record's `buffer@0` field must
// hold the ABSOLUTE VA of its byte blob, and no VA exists until the PE writer lays out `.rdata`. So the
// `LowerMaxonToStd` lowering emits `buffer@0 = 0` and records this `(record, blob)` pair; the writer
// patches `record`'s first 8 bytes with `ImageBase + rdataRva + blobOffset` once `rdataRva` is known.
// Both labels are `.rdata` labels this same table minted, so their offsets come from `rdataOffsetOf`.
//
// This is the DATA→DATA sibling of `PendingRdataReloc` (the code→text-VA-in-rdata patch that fills a
// witness-table method slot or a layout descriptor's function slots); like it, this fixup is carried on the
// data table (not the code relocation list) because it patches the rdata IMAGE, not the `.text` bytes.
export type StringBufferFixup
	export let recordLabel as String
	export let blobLabel as String

	export static function create(recordLabel String, blobLabel String) returns StringBufferFixup
		return Self{recordLabel: recordLabel, blobLabel: blobLabel}
	end 'create'
end 'StringBufferFixup'

export typealias StringBufferFixupArray = Array with StringBufferFixup

// ⭐ THE DATA→TEXT SIBLING of `StringBufferFixup`: a slot INSIDE a `.rdata` blob must hold the ABSOLUTE VA
// of a `.text` function, and no `.text` VA exists until the writer lays out the code section. THREE slots
// need it — a WITNESS-TABLE method slot (P1.7a slice 2a, one per interface method per conformance, and by far
// the most numerous), and a managed-opaque-`T` layout descriptor's `destroyFunc@40` (slice 3b-ii) and
// `copyFunc@32` (slice 3b-vi-b-β) — so the type is named for the CHANNEL and not for any one of them; a
// comment naming only the descriptor sent readers hunting for a managed opaque array in programs that had
// none. The emitter (`ensureWitnessTable` / `ensureLayoutDescriptor`) leaves the slot 0 and records this triple;
// EVERY writer patches the 8 bytes at
// `rdataOffsetOf(rdataLabel) + offsetInLabel` with `funcName`'s runtime address once `.text`'s base is
// known. `funcName` is a `.text` function this table's writer resolves through the debug-symbol map (as
// `Arm64FuncAdrpReloc.funcName` resolves to `textOffset`); `rdataLabel` is a `.rdata` label this same table
// minted (offset via `rdataOffsetOf`). It is carried on the DATA TABLE, not the code-relocation list,
// because it patches the rdata IMAGE, not the `.text` bytes — the exact reason its String-buffer sibling is.
export type PendingRdataReloc
	export let funcName as ByteArray
	export let rdataLabel as String
	export let offsetInLabel as ByteOffset

	export static function create(funcName ByteArray, rdataLabel String, offsetInLabel ByteOffset) returns PendingRdataReloc
		return Self{funcName: funcName, rdataLabel: rdataLabel, offsetInLabel: offsetInLabel}
	end 'create'
end 'PendingRdataReloc'

export typealias PendingRdataRelocArray = Array with PendingRdataReloc

// ⭐⭐ **THE DATA→**DATA** SIBLING, AND THE ONE THAT NEEDS NO WRITER AT ALL.** A slot inside a `.rdata` blob
// must hold the location of ANOTHER `.rdata` blob — today exactly one thing wants that, a witness table's
// associated slot naming the nested table `__witness_<binding>.<heldAt>` (see
// `IrInterface.witnessAssociatedSlotOffset`).
//
// ⚠ **IT HOLDS A DISTANCE, NOT AN ADDRESS, AND THAT IS WHAT MAKES IT FORMAT-FREE.** The `.text` channel
// above is format-specific in three incompatible ways — an absolute VA on fixed-base PE/ELF
// (`bakeFuncAbs64Relocs`), a funcref-TABLE INDEX on wasm (`StdToWasm.bakeFuncTableIndexRelocs`), and a dyld
// CHAINED-FIXUP REBASE on Mach-O (`MachOWriter.writeMachoRdataRebases`) — so a fourth spelling of "an
// absolute `.rdata` VA" would have been a fourth entry in each of those three, plus a PE base relocation and
// an ELF `R_X86_64_RELATIVE` this compiler emits for nothing today. Two labels in ONE section are a
// different question: their DISTANCE is fixed the moment the image is concatenated, it is the same number
// under a fixed base and under PIE, and on wasm it is the same number again because the blob is one run of
// linear memory. So the reader adds the slot to the table address it already holds, and nothing anywhere has
// to know which format it is being loaded by.
//
// ⇒ it is baked in `rdataImage`, which is the ONE place the section is assembled and therefore the only
// place that cannot be forgotten by a writer. `targetLabel` and `rdataLabel` are both labels this table
// minted; the value written is `rdataOffsetOf(targetLabel) - rdataOffsetOf(rdataLabel)`, the distance from
// the blob's OWN base — so the reader, which already holds that base as the address it loaded the slot
// through, adds once.
//
// ⚠ **THE DISTANCE IS SIGNED AND BOTH DIRECTIONS GENUINELY OCCUR, so it is written as a 64-bit two's
// complement and the reader's add WRAPS.** Which blob is registered first is a fact about mint ORDER, not
// about the program: a nested table minted by this very call lands after its referrer, and one an earlier
// conformance already minted lands before it. Forcing the order was considered and cannot be done — two
// interfaces may hold each other's positions, and the mint's own memo (which is what stops that recursing
// forever) is exactly what leaves the second reference pointing forward.
type PendingRdataSelfRelReloc
	export let targetLabel as String
	export let rdataLabel as String
	export let offsetInLabel as ByteOffset

	export static function create(targetLabel String, rdataLabel String, offsetInLabel ByteOffset) returns PendingRdataSelfRelReloc
		return Self{targetLabel: targetLabel, rdataLabel: rdataLabel, offsetInLabel: offsetInLabel}
	end 'create'
end 'PendingRdataSelfRelReloc'

export typealias PendingRdataSelfRelRelocArray = Array with PendingRdataSelfRelReloc

// `to - from` as the 64-bit pattern a WRAPPING add reproduces — the backward case written as its two's
// complement, because `ByteOffset` is `int(0 to u64.max)` and cannot hold a negative at all. `to == from`
// cannot occur (two distinct labels never share an offset) but is answered anyway, as 0, rather than being
// asserted about: the identity `from + result == to` (mod 2^64) is what every reader depends on, and it holds
// for all three cases without a special one.
function twosComplementDistance(to ByteOffset, from ByteOffset) returns MachineWord
	if to >= from 'forward'
		return to - from
	end 'forward'

	// `(u64.max - d) + 1` rather than `0 - d`, which the range would refuse. `d >= 1` here, so the sum is at
	// most `u64.max` and the addition cannot overflow either.
	return (u64.max - (from - to)) + 1
end 'twosComplementDistance'

// The rdata payloads themselves — one raw byte blob per registered global.
export typealias ByteArrayArray = Array with ByteArray

// Does `bytes` begin with `prefix`? The byte-slice twin of `String.startsWith`, for the
// name comparisons that now run on source slices rather than heap Strings.
export function bytesStartWith(bytes ByteArray, prefix ByteArray) returns bool
	if prefix.count() > bytes.count() 'tooShort'
		return false
	end 'tooShort'

	for i in 0 upto prefix.count() 'each'
		let b = try bytes.get(i) otherwise panic("bytesStartWith: i < prefix.count() <= bytes.count() by the guard above, but get({i}) failed")
		let p = try prefix.get(i) otherwise panic("bytesStartWith: i < prefix.count() by the loop bound, but get({i}) failed")
		if b != p 'differs'
			return false
		end 'differs'
	end 'each'

	return true
end 'bytesStartWith'

// --- The `.data` section: writable globals (P1.0d.5b) ---

// `dataIndex`: a data-section label → its index in `dataSection`. The O(1) membership +
// lookup twin of `nameIndex`, and it exists for that field's reason: v1 answered "where does
// this label live?" with a linear scan per reference, which is Θ(globals × references).
export typealias DataSectionIndexMap = Map with (String, MachineWord)

// ONE writable `.data` slot: a top-level `var`.
//
// ⚠ IT CARRIES THE VALUE, NOT THE BYTES. The image is rendered from `(value, valueType)` by
// `dataSectionImage`, once, at write time. Storing both a value and its serialized bytes
// would be this project's signature bug — one fact written down twice — with the two free to
// disagree about what `i8 1` is; and the RequiredData gate reads the same pair the image
// does, so a spec cannot pin a layout the writer does not emit.
//
// `offset` is assigned by `layOutDataSection`, which is also the only writer of it.
export type DataSectionEntry
	export var label as String
	export var valueType as StdType
	export var value as ParsedInt
	export var offset as ByteOffset

	export static function create(label String, valueType StdType, value ParsedInt) returns DataSectionEntry
		return Self{label: label, valueType: valueType, value: value, offset: 0}
	end 'create'
end 'DataSectionEntry'

export typealias DataSectionEntryArray = Array with DataSectionEntry

export type GlobalDataTable
	export var names as StringArray
	export var values as ByteArrayArray
	// Monotonic id for minting synthetic `__str_<id>` names for ad-hoc payloads.
	export var nextStringId as MachineWord
	export var nameIndex as GlobalNameIndexMap
	export var valueDedup as GlobalDedupMap
	// The `.data` slots, IN LAYOUT ORDER — which is the order the image is written in and the
	// order `RequiredData` pins. `layOutDataSection` is the single writer of both this array's
	// order and every entry's `offset`.
	export var dataSection as DataSectionEntryArray
	export var dataIndex as DataSectionIndexMap
	// Each `.rdata` payload's offset, assigned AT REGISTRATION — see RdataOffsetMap and
	// `registerRdataConstant`. `.rdata` needs no `layOut` twin: unlike `.data`, whose slots are
	// REORDERED by size to kill padding, these are laid out in registration order and their offsets
	// are known the moment they are appended.
	export var rdataOffsets as RdataOffsetMap
	// The running total bytes registered so far — the offset the NEXT `.rdata` payload lands at,
	// maintained beside every push rather than re-summed. It is a SECOND copy of a fact `values`
	// already holds (the concatenated length), so `rdataImage`'s drift assert is what keeps the two
	// honest: it walks the payloads and panics if any recorded offset disagrees with the actual image
	// position. See `registerRdataConstant` for why the copy is worth its guard.
	var rdataSizeSoFar as ByteOffset
	// The `(record, blob)` pairs the PE writer patches to bake each String literal's `buffer@0` — see
	// StringBufferFixup. Empty for a program with no string literal, which is most of the corpus.
	export var stringBufferFixups as StringBufferFixupArray
	// The `(funcName, rdataLabel, offsetInLabel)` triples the x64 writers patch to bake a `.rdata` slot with a
	// `.text` function's VA — a witness-table method slot, or a managed-opaque-`T` descriptor's
	// `destroyFunc@40`/`copyFunc@32`. See PendingRdataReloc. Empty for a program that conforms nothing to an
	// interface and holds no managed-opaque-`T` array (all but the P1.7-generics corpus).
	export var pendingRdataRelocs as PendingRdataRelocArray
	// Every  slot holding a distance to ANOTHER  blob — see PendingRdataSelfRelReloc.
	export var pendingRdataSelfRelRelocs as PendingRdataSelfRelRelocArray
	// ⭐ **THE `.symtab` IMAGE — the FOURTH emitted section this table renders**, beside `.rdata`, `.data`
	// and the string fixups. EMPTY for every ordinary build, and the section is then omitted entirely by
	// the PE writer, so a normal program's binary is byte-for-byte what it was before this field existed.
	//
	// Its one payload today is the DebugStream `MXDS_TAGS` name blob, which `maxon monitor` finds by
	// scanning the executable (see `DebugStreamRuntime`). It is a whole IMAGE rather than a registry of
	// payloads because nothing REFERENCES it: no relocation points into `.symtab` — the consumer parses
	// the file — so there are no offsets to hand out and nothing for a label to name.
	export var symdataImage as ByteArray
	// ⭐ **THE DEBUGSTREAM TAG TABLE — `names[i]` is the type name wire tag `i` resolves to.** It lives
	// here rather than beside its format because this is the object every writer and the one reader
	// already hold: the LOWERING that interns a user type's name has it as `self.globalData`, the runtime
	// installs have it threaded, and the backend renders the blob out of it. Seeded with the fixed roster
	// (`mmTagRosterNames`) so a runtime chunk's tag is a compile-time constant and needs no interning.
	//
	// ⚠ Seeded UNCONDITIONALLY, even for a build with `--debugstream` off. It is ten strings, and making
	// the seeding conditional would put a flag test into this constructor — which every compile runs — to
	// save them. Nothing renders the blob unless the flag is on, and `userTagIndex` refuses to grow the
	// table in an untraced build, so the cost stops here.
	export var debugStreamTags as DebugStreamNameTable
	// ⭐⭐ **THE INTERNED-NAME TABLE — `names[i]` is what a Log event's u16 name field resolves to.** Its
	// entries come from `__DebugStream.nameId("…")`, a compile-time NAME rather than a runtime value, which
	// is what keeps the structured trace tier zero-alloc: the call becomes this index and the text exists
	// only in `MXDS_STRS`.
	//
	// ⚠⚠ **IT IS GROWN UNCONDITIONALLY, WHERE THE TAG TABLE ABOVE IS NOT, AND THE ASYMMETRY IS THE WHOLE
	// CONTRACT.** A tag index is chosen BY the compiler for a box the program never sees, so an untraced
	// build can decline to mint one (`userTagIndex`). A name id is a VALUE the program computes and may
	// print — so it may not depend on a compiler flag, or `--debugstream` would change what a program
	// answers. Only the BLOB is gated; the numbering is not. This is the bootstrap's rule stated the same
	// way (*"Interned unconditionally: the index must be stable whether or not the blob is emitted"*).
	export var debugStreamNames as DebugStreamNameTable

	export static function create() returns GlobalDataTable
		return Self{names: StringArray.create(), values: ByteArrayArray.create(), nextStringId: 0, nameIndex: GlobalNameIndexMap.create(), valueDedup: GlobalDedupMap.create(), dataSection: DataSectionEntryArray.create(), dataIndex: DataSectionIndexMap.create(), rdataOffsets: RdataOffsetMap.create(), rdataSizeSoFar: 0, stringBufferFixups: StringBufferFixupArray.create(), pendingRdataRelocs: PendingRdataRelocArray.create(), pendingRdataSelfRelRelocs: PendingRdataSelfRelRelocArray.create(), symdataImage: ByteArray.create(), debugStreamTags: DebugStreamNameTable.create(mmTagRosterNames()), debugStreamNames: DebugStreamNameTable.create(debugStreamNameRosterSeed())}
	end 'create'

	// ⭐ REGISTER a read-only constant payload, returning the label that names it — the `.rdata`
	// twin of the `.data` half below, and the door P1.0d.4's float constants come through.
	//
	// IDENTICAL CONTENT RETURNS THE EXISTING LABEL, in O(1), through `valueDedup`. That is not a
	// micro-optimization: a program mentioning `3.14` in fifty places gets ONE 8-byte island and
	// fifty references to it, and the dedup is keyed on the rendered BYTES, so two constants that
	// are the same number written differently (`2.0` and `2.00`) still share one island.
	//
	// The offset is assigned HERE, as `rdataSizeSoFar` — the running total of everything registered
	// before it, advanced by this payload's own length AS it is pushed. That keeps both
	// `rdataOffsetOf` AND the registration itself O(1): re-deriving the offset by summing every prior
	// payload made the build of N distinct constants Θ(N²), which the field this replaces flagged as
	// debt to pay "if `.rdata` ever holds thousands of entries (P1.2 strings)" — and a String literal
	// registers TWO constants (blob + record) with literals-per-program unbounded, so P1.2 is that
	// moment. `rdataImage` walks the same array in the same order and ASSERTS the recorded offset
	// agrees with the image position, so the running total and the bytes it names cannot drift.
	export function registerRdataConstant(prefix String, bytes ByteArray) returns String
		return try self.valueDedup.get(bytes) otherwise 'fresh'
			let label = "{prefix}{self.nextStringId}"
			self.nextStringId = self.nextStringId + 1
			self.appendRdataPayload(label, bytes: bytes)
			self.valueDedup.upsert(bytes, value: label)
			return label
		end 'fresh'
	end 'registerRdataConstant'

	// Append one FRESH `.rdata` payload under `label`: assign its offset (the running total), advance the
	// total by this payload's length, and index it by name. The ONE writer of a new rdata slot's offset/name
	// bookkeeping — shared by `registerRdataConstant`'s fresh path and `registerRdataConstantLabeled` so the
	// two cannot come to disagree about how a slot is recorded. The byte-keyed `valueDedup` pool is
	// deliberately NOT touched here: only the label-minting caller joins it (a structural descriptor label
	// must never be handed back as a later bytes-dedup answer), so pool membership — the sole real difference
	// between the two callers — stays with the caller that owns it.
	function appendRdataPayload(label String, bytes ByteArray)
		self.rdataOffsets.upsert(label, value: self.rdataSizeSoFar)
		self.rdataSizeSoFar = self.rdataSizeSoFar + bytes.count()
		self.nameIndex.upsert(label, value: self.names.count())
		self.names.push(label)
		self.values.push(bytes)
	end 'appendRdataPayload'

	// ⭐ RESERVE an `.rdata` jump-table blob of `slotCount` i32 slots, returning the UNIQUE label that names
	// it. The `nextStringId`-minted label makes each switch's table distinct (a byte-dedup would fuse two
	// different tables — every table is all-zero placeholders at registration, patched per-slot by the WRITER
	// once section addresses are known, so it MUST NOT join the bytes-keyed `valueDedup` pool). Reserving the
	// zero bytes fixes the blob's `.rdata` offset now, so `rdataOffsetOf(label)` answers before the writer
	// patches. The offset/name bookkeeping is the shared `appendRdataPayload`, so `rdataImage`'s drift assert
	// covers it too.
	export function registerJumpTable(slotCount ElementCount) returns String
		let label = "{JumpTableLabelPrefix}{self.nextStringId}"
		self.nextStringId = self.nextStringId + 1
		var bytes = ByteArray.create()
		bytes.growFilled(slotCount * JumpTableSlotBytes, value: 0)
		self.appendRdataPayload(label, bytes: bytes)
		return label
	end 'registerJumpTable'

	// ⭐ REGISTER a read-only constant under an EXACT, caller-supplied label — the layout-descriptor
	// twin of `registerRdataConstant` (P1.6-B1). A descriptor's label is STRUCTURAL
	// (`__layout_Sizer_bool`, from the instance's base + argument names), so it must be the label
	// verbatim — not a `{prefix}{nextStringId}` mint, whose numeric suffix is a build-order artifact the
	// golden fragments and `verify-warm-rebuild` would see move. Idempotent by LABEL: a second call for
	// the same instance (a descriptor referenced at two call sites) returns without re-registering.
	//
	// ⚠ It deliberately does NOT participate in the bytes-keyed `valueDedup` pool: a descriptor and a
	// String literal that happened to share bytes must keep their own labels, and a descriptor must never
	// be handed back as the dedup answer to a later `registerRdataConstant`. The offset/name bookkeeping is
	// the shared `appendRdataPayload` — `registerRdataConstant`'s fresh path minus the dedup join, so
	// `rdataImage`'s drift assert covers it too.
	export function registerRdataConstantLabeled(label String, bytes ByteArray) returns String
		if self.rdataOffsets.contains(label) 'alreadyRegistered'
			self.requireIdenticalPayload(label, bytes: bytes)
			return label
		end 'alreadyRegistered'

		self.appendRdataPayload(label, bytes: bytes)
		return label
	end 'registerRdataConstantLabeled'

	// ⭐ **IDEMPOTENT MEANS *THE SAME BYTES*, AND UNTIL THIS EXISTED THE TABLE NEVER ASKED.** Every label
	// reaching `registerRdataConstantLabeled` is STRUCTURAL — derived from the thing it names — so a second
	// registration under one label is exactly one of two things: the SAME payload (the idempotence the
	// function's contract promises), or TWO payloads whose derivations produced one name. The second is a
	// label-space collision, and first-write-wins made it a silently wrong constant: the newcomer's bytes are
	// dropped, every reference to its label resolves to the incumbent's, and nothing is reported.
	//
	// ⚠ **BOTH OF TODAY'S CALLERS MEMOIZE BEFORE THEY ASK** (`ensureWitnessTable` on the label,
	// `ensureLayoutDescriptor` on the gid), so a repeat under one label is not the hot path this walks — it is
	// the case that should not happen. The byte compare is therefore free in practice AND it is the only thing
	// standing between a colliding derivation and a wrong `.rdata` constant, which is why it is not left to
	// the callers: a caller's memo protects that caller, and this protects the TABLE.
	//
	// ⚠ **THE ASYMMETRY IS WHAT THIS CLOSES.** `rdataOffsetOf` and `dataSectionOffsetOf` both PANIC BY NAME
	// on a label that is MISSING — an invariant break they refuse to paper over — while the write side
	// accepted a label already taken without so much as comparing it. One end of the same map held two
	// opposite opinions about how much it could be trusted.
	//
	// ⚠ **IT IS A BACKSTOP, NOT THE CURE FOR ANY PARTICULAR COLLISION, and the witness-label join is the
	// case that proves the difference.** Two witness tables of equal method count carry BYTE-IDENTICAL
	// zero-filled blobs — what distinguishes them is their RELOCATIONS, which are not payload — and the
	// mint's own label-keyed memo returns before this is ever reached. Injectivity has to be a property of
	// the LABEL (`IrInterface.witnessTableLabel`); what this catches is the residue: two derivations of one
	// name whose CONTENT also disagrees, which is the `__layout_` family's shape.
	function requireIdenticalPayload(label String, bytes ByteArray)
		let index = try self.nameIndex.get(label) otherwise panic("GlobalDataTable.requireIdenticalPayload: '{label}' has a recorded offset but no name index — `appendRdataPayload` writes both in one call, so the two cannot disagree")
		let existing = try self.values.get(index) otherwise panic("GlobalDataTable.requireIdenticalPayload: nameIndex maps '{label}' to {index}, which values does not hold — the two columns are pushed together and cannot disagree")
		if not existing.equals(bytes) 'differs'
			panic("GlobalDataTable.requireIdenticalPayload: '{label}' is registered twice with DIFFERENT payloads ({existing.count()} bytes, then {bytes.count()}) — a structural .rdata label names its content, so two payloads under one label means two derivations produced one name and the second would be silently dropped")
		end 'differs'
	end 'requireIdenticalPayload'

	// Record that `recordLabel`'s `buffer@0` must be patched with `blobLabel`'s absolute VA — see
	// StringBufferFixup. Both are `.rdata` labels this table minted; the writer resolves their offsets
	// through `rdataOffsetOf`.
	export function recordStringBufferFixup(recordLabel String, blobLabel String)
		self.stringBufferFixups.push(StringBufferFixup.create(recordLabel, blobLabel: blobLabel))
	end 'recordStringBufferFixup'

	// Record that `rdataLabel`'s slot at `offsetInLabel` must be patched with `funcName`'s absolute `.text`
	// VA — see PendingRdataReloc. `rdataLabel` is a `.rdata` label this table minted (offset via
	// `rdataOffsetOf`); `funcName` is a `.text` function the writer resolves through the debug-symbol map.
	export function recordFuncAbs64InRdata(funcName ByteArray, rdataLabel String, offsetInLabel ByteOffset)
		self.pendingRdataRelocs.push(PendingRdataReloc.create(funcName, rdataLabel: rdataLabel, offsetInLabel: offsetInLabel))
	end 'recordFuncAbs64InRdata'

	// Record that `rdataLabel`'s slot at `offsetInLabel` must be patched with `targetLabel`'s distance from
	// `rdataLabel`'s own base — see PendingRdataSelfRelReloc. Both are `.rdata` labels this table minted, and
	// neither offset need be known yet: the bake runs when the section is assembled.
	export function recordRdataBlobRelativeOffset(targetLabel String, rdataLabel String, offsetInLabel ByteOffset)
		self.pendingRdataSelfRelRelocs.push(PendingRdataSelfRelReloc.create(targetLabel, rdataLabel: rdataLabel, offsetInLabel: offsetInLabel))
	end 'recordRdataBlobRelativeOffset'

	// The byte image of `.rdata` — the payloads concatenated in registration order, with every
	// BLOB-RELATIVE slot baked (see `PendingRdataSelfRelReloc`). That bake lives here, and not in each
	// writer beside the three format-specific ones, precisely because it is NOT format-specific: a distance
	// within one section is the same number under every image format and every base, so giving each writer
	// its own copy would be one fact written four times with nothing keeping them honest — and a wrong copy
	// would be 8 opaque bytes in a witness table on ONE target, with no diagnostic anywhere.
	//
	// The `dataSectionImage` twin, including its drift assert and for the same reason: an entry
	// whose recorded offset disagrees with the running position means the offsets a relocation
	// resolves against and the bytes the writer emits have parted company, which is a silently
	// wrong constant rather than a crash.
	//
	// No alignment and no padding: a scalar SSE load (`movsd`) tolerates any address, so a float
	// island needs none — the section's own RVA alignment is the PE writer's business.
	export function rdataImage() returns ByteArray
		var image = ByteArray.create()
		for (iter, payload) in self.values.withIterator() 'each'
			let label = try self.names.get(iter.index()) otherwise panic("GlobalDataTable.rdataImage: values has {self.values.count()} payloads but names has {self.names.count()} — the two columns are pushed together and cannot disagree")
			let offset = try self.rdataOffsets.get(label) otherwise panic("GlobalDataTable.rdataImage: '{label}' has no recorded offset — every label registerRdataConstant mints gets one in the same call")
			if image.count() != offset 'drift'
				panic("GlobalDataTable.rdataImage: '{label}' is recorded at offset {offset} but the image has reached {image.count()} — the offsets relocations resolve against and the bytes this places have drifted")
			end 'drift'
			image.append(payload)
		end 'each'

		self.bakeBlobRelativeOffsets(image)
		return image
	end 'rdataImage'

	// Write each blob-relative slot's distance into the assembled image. IDEMPOTENT — it writes an absolute
	// distance rather than adjusting one — so a second `rdataImage()` (the wasm backend builds its own image
	// beside the native one) produces the identical bytes.
	function bakeBlobRelativeOffsets(image ByteArray)
		for reloc in self.pendingRdataSelfRelRelocs 'each'
			let base = self.rdataOffsetOf(reloc.rdataLabel)
			let target = self.rdataOffsetOf(reloc.targetLabel)
			patchQword(image, offset: base + reloc.offsetInLabel, value: twosComplementDistance(target, from: base))
		end 'each'
	end 'bakeBlobRelativeOffsets'

	// The byte offset of `label`'s payload within `.rdata` — the door the x64 relocation resolver
	// asks through, and the exact mirror of `dataSectionOffsetOf`. A miss is an invariant break,
	// not a case: every label reaching here came from a `movsdRegRip` this table minted.
	export function rdataOffsetOf(label String) returns ByteOffset
		return try self.rdataOffsets.get(label) otherwise panic("GlobalDataTable.rdataOffsetOf: no .rdata constant is labelled '{label}' — every label a `movsdRegRip` carries is one registerRdataConstant minted")
	end 'rdataOffsetOf'

	// ⭐ LAY OUT THE `.data` SECTION: order the slots, then assign each its offset. The SINGLE
	// writer of `dataSection`, `dataIndex` and every entry's `offset` — so the image, the
	// relocation resolver and the RequiredData gate cannot hold three opinions of where a
	// global lives.
	//
	// **SORTED BY STORAGE SIZE, LARGEST FIRST — which is what makes the padding zero.** Every
	// size here is a power of two and no larger than 8, so laying the widest out first means
	// each slot's offset is already a multiple of its own size when it is reached: the 8-byte
	// slots fill offsets 0,8,16…, and the 1-byte slots that follow need no alignment at all.
	// Declaration order would not do it — `var flag = false` then `var counter = 42` would put
	// an 8-byte slot at offset 1 and force 7 bytes of padding to fix it. This is exactly what
	// `specs/static-variables.md`'s six `RequiredData` cases pin, and the spec says so in its
	// own words ("sorted largest-first, no padding needed").
	//
	// **THE SORT IS STABLE, and that is part of the contract too**: `data-section-multiple-bools`
	// pins three equal-sized slots in DECLARATION order (`i8 1`, `i8 0`, `i8 1` for `a`,`b`,`c`).
	// An unstable sort would order them by whatever the algorithm did that day, and the layout
	// of a program would stop being a function of its source.
	export function layOut(declared DataSectionEntryArray)
		self.dataSection = sortBySizeDescendingStable(declared)
		self.dataIndex = DataSectionIndexMap.create()

		var offset = 0 as ByteOffset
		for i in 0 upto self.dataSection.count() 'each'
			// A `var` binding, so the entry's `offset` is written THROUGH the reference the array
			// holds — `DataSectionEntry` is a `type`, so this is the very object the array stores,
			// not a copy of it.
			var entry = try self.dataSection.get(i) otherwise panic("GlobalDataTable.layOut: dataSection.get OOB at {i} despite the upto bound")
			entry.offset = offset
			self.dataIndex.upsert(entry.label, value: i)
			offset = offset + stdTypeStorageBytes(entry.valueType)
		end 'each'
	end 'layOut'

	// The byte image of the `.data` section — rendered from each slot's `(value, valueType)`,
	// in layout order. Little-endian, matching every other integer this backend writes.
	//
	// It needs no padding logic and asserts that it needs none: `layOut` ordered the slots so
	// that each lands naturally aligned, so the image is simply the concatenation. An entry
	// whose offset disagrees with the running position means the layout and the image have
	// drifted, which panics rather than emitting a silently misaligned global.
	export function dataSectionImage() returns ByteArray
		var image = ByteArray.create()
		for entry in self.dataSection 'each'
			if image.count() != entry.offset 'drift'
				panic("GlobalDataTable.dataSectionImage: '{entry.label}' is laid out at offset {entry.offset} but the image has reached {image.count()} — layOut's ordering and this rendering disagree")
			end 'drift'
			appendLittleEndianScalar(image, value: entry.value, byteCount: stdTypeStorageBytes(entry.valueType))
		end 'each'
		return image
	end 'dataSectionImage'

	// The byte offset of `label`'s slot within `.data` — the door the x64 relocation resolver
	// asks through. A miss is an invariant break, not a case: every label reaching here came
	// from a `globalAddr` the parser emitted off the very arena `layOut` was fed.
	export function dataSectionOffsetOf(label String) returns ByteOffset
		let index = try self.dataIndex.get(label) otherwise panic("GlobalDataTable.dataSectionOffsetOf: no .data slot is labelled '{label}' — every label a `globalAddr` carries is one the top-level `var` arena declared")
		let entry = try self.dataSection.get(index) otherwise panic("GlobalDataTable.dataSectionOffsetOf: dataIndex maps '{label}' to {index}, which dataSection does not hold — the two fell out of lockstep")
		return entry.offset
	end 'dataSectionOffsetOf'
end 'GlobalDataTable'

// The widest a `.data` slot can be. `StdTypeInfo.storageBytes` tops out at 8 (`i64`/`u64`/`f64`)
// and every value it can take is a power of two — the SAME fact `GlobalDataTable.layOut` already
// rests its zero-padding claim on, named here because `sortBySizeDescendingStable` is the code
// that walks the size classes and would otherwise re-state the bound as a literal.
let MaxDataSlotBytes = 8 as ByteCount

// `declared` ordered by storage size, LARGEST FIRST, preserving declaration order among equal
// sizes — see `GlobalDataTable.layOut` for why both halves are load-bearing.
//
// ⭐ **ONE STABLE PASS PER SIZE CLASS — O(globals), not Θ(globals²).** The sizes are not an open
// set to be compared pairwise: `StdTypeInfo.storageBytes` is one of 1, 2, 4, 8 and nothing else
// (see `MaxDataSlotBytes`), so "largest first" is FOUR appends-in-order, not a sort. Each pass
// appends the entries of one class in declaration order, which is what makes it stable by
// construction — `data-section-multiple-bools` pins three equal-sized slots in declaration order,
// and nothing here can reorder them because nothing here compares them.
//
// ⚠ IT WAS AN INSERTION SORT, AND THAT WAS Θ(n²) IN THE ORDINARY CASE, NOT THE PATHOLOGICAL ONE.
// The old scan stopped at the first STRICTLY smaller entry, so a program whose globals are all
// one size — every global an `int`, the commonest program there is — never stopped early and
// rescanned the whole placed list for every entry. MEASURED at 500→8000 all-`i64` globals: the
// compile's unattributed bucket read 30/120/460 ms for n=2000/4000/8000, x3.98 then x3.83 per
// doubling. This shape reads x2.0. The old comment defended the cost as "a program's top-level
// `var` count is a handful" — which is the same appeal to a property of the corpus that
// `topLevelStorageKey` refuses on v1's behalf three files away, and it is worth no more here.
function sortBySizeDescendingStable(declared DataSectionEntryArray) returns DataSectionEntryArray
	var sorted = DataSectionEntryArray.create()
	var size = MaxDataSlotBytes
	while size > 0 'eachSizeClass'
		for entry in declared 'each'
			if stdTypeStorageBytes(entry.valueType) == size 'thisClass'
				sorted.push(entry)
			end 'thisClass'
		end 'each'
		size = size shr 1
	end 'eachSizeClass'

	// Every entry landed in exactly one class, or the walk above does not cover the type table.
	// It cannot today — the passes are 8/4/2/1 and `StdTypeInfo` declares nothing else — but a
	// dropped entry would be SILENT and it would be a wrong answer, not a crash: the slot would
	// vanish from `dataSection` while `dataIndex` never learned it, and the first `globalAddr`
	// naming it would panic somewhere else entirely. The day a 16-byte `StdType` is declared, this
	// says so here, where the fix is.
	if sorted.count() != declared.count() 'droppedAnEntry'
		panic("sortBySizeDescendingStable: laid out {sorted.count()} of {declared.count()} .data slot(s) — a global's storage size is not one of the {MaxDataSlotBytes}/4/2/1-byte classes this walks, so StdTypeInfo has grown a width the layout does not cover")
	end 'droppedAnEntry'

	return sorted
end 'sortBySizeDescendingStable'

// `value` rendered as a standalone `byteCount`-byte little-endian payload — what
// `registerRdataConstant` is handed for a float island.
//
// ⭐ It goes through `LayoutDescriptor.appendLittleEndianScalar`, the SAME serializer the `.data` image
// above and a constant array literal's `.rdata` blob both use, which is the point: an f64 constant in
// `.rdata` and an f64 global in `.data` are the same 8 bytes of IEEE pattern, and there is exactly one piece
// of code that decides what those bytes are. A second renderer here would be this project's signature bug —
// one fact written twice — with the two free to disagree about what `3.14` is.
export function scalarImage(value ParsedInt, byteCount ByteCount) returns ByteArray
	var bytes = ByteArray.create()
	appendLittleEndianScalar(bytes, value: value, byteCount: byteCount)
	return bytes
end 'scalarImage'
