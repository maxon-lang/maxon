// TargetLiveness — the pass that decides whether the register allocator is fast:
// the per-function CFG (built ONCE), loop structure from back edges, and live-in/live-out by
// SSA PATH EXPLORATION. Everything is dense (design §"Data representation"): `Array`-indexed
// columns keyed by the dense function-local block index / value id, live-in/out as one SPARSE,
// editable value list per block, one-bit-per-register `RegMask` words — NO `Map` and NO hashing in
// the hot path.
//
// **There is NO dataflow fixpoint.** In strict SSA a value's def dominates every use, so liveness
// is exactly "the CFG paths running backward from each use up to the def" — walk them and stop.
// Nothing iterates, nothing converges. See `solveLivenessSsa`, which also explains why a back edge
// needs no special case and why a phi is where the walk stops (and a phi ARG is where one starts).
// The old iterative fixpoint re-swept every block's FULL value-space row every round and was the
// last superlinear term in register allocation.

// ==========================================================================
// THE ALLOCATOR'S INDEX SPACES
// ==========================================================================
//
// Every quantity below is a non-negative integer, and that is exactly the problem: nothing stops a
// BIT index being passed where an OP SEQUENCE number belongs, or a CSR record index where a word
// offset does. They are named apart so the SITE reads correctly and a mismatch is legible on the
// page — which is the only place it can be caught, since a Maxon `typealias` is transparent (two
// aliases over the same range are the same type, so the compiler enforces nothing between them; only
// a NARROWER range, like `RegNum`, is checked, and then at run time).
//
// The columns all share ONE representation — a flat `Array` of non-negative ints — which is what
// lets `filledColumn` / `zeroColumn` / `buildCsr` be one implementation each rather than one per
// column. The names say what the ENTRIES MEAN; the representation is common on purpose.

// The non-negative-integer REPRESENTATION every index space in this file shares, and the dense
// column built out of it. Every purpose-named column below IS a `DenseColumn` under a name that says
// what its entries mean, and they interconvert freely.
//
// A QUANTITY is always spelled with its purpose alias. `DenseInt` appears only where the code is
// deliberately generic OVER those spaces and has no one purpose to name — the column builders, which
// fill a colour column and a Hall matching alike, and `maxOf`, which takes the larger of a value id
// or of a register pressure.
typealias DenseInt = int(0 to u64.max)
export typealias DenseColumn = Array with DenseInt

// How many entries a dense column has — the argument the builders below size one with, and the
// cursor a worklist walks one with.
export typealias ColumnLength = int(0 to u64.max)

// A dense function-local index: a block's position in `func.blockRefs`, or a count of blocks.
export typealias CfgIndex = int(0 to u64.max)
export typealias CfgIndexArray = Array with CfgIndex

// A block's LOOP NESTING DEPTH: 0 outside every loop, +1 per enclosing natural loop. Rule 2 turns on
// it — a COLD spill may only be placed where this is 0 — so it is not a block index and must not be
// mistaken for one.
export typealias LoopDepth = int(0 to u64.max)
export typealias LoopDepthArray = Array with LoopDepth

// The FORWARD LAYOUT SEQUENCE number of an op within one function: blocks in `func.blockRefs` order,
// each block's body ops then its terminator (the `collectBlockOps` numbering). It is the ONE
// numbering the `UseIndex`, the splitter's peak, and the colorer's reuse-copy plan all key on, so
// they can compare "before/after the peak" at all — and it is GLOBAL to the function, unlike
// `BlockOpPos`, which restarts at every block. `UseIndex.seqLimit` is strictly above every one it can
// produce (and therefore doubles as the "no later use" sentinel Belady ranks with).
export typealias OpSeq = int(0 to u64.max)
export typealias OpSeqArray = Array with OpSeq

// An `OpSeq` is `blockLocal * SeqStride + positionInBlock` — BLOCK-RELATIVE, not a dense global
// counter, and that is what makes the splitter's per-split cost proportional to what it changed.
//
// A dense counter numbers ops 0,1,2,… straight through the function, so INSERTING one op (which is
// what a split does) renumbers every op after it, in every later block. Every `useSeq` in the
// function goes stale at once, and the only repair is to rebuild the whole index — which is the
// O(function × splits) the splitter's driver used to pay. With a stride, an insert into block `b`
// shifts positions only WITHIN `b`: every other block's numbers are exactly what they were.
//
// Nothing reads a sequence number as an INDEX; every consumer only ORDERS by it (Belady's next-use
// distance, the before/after-the-peak partition). So the numbering may be sparse, and only its total
// order has to match the layout — which it does, because blocks are numbered in layout order and
// positions within a block are unchanged.
//
// The stride bounds a block at 2^32 ops. A block that big is not a program, so it panics rather than
// silently aliasing into the next block's sequence space (which would make a use in block b+1 look
// EARLIER than one in block b, and Belady would evict the wrong value — a silent miscompile).
let SeqStride = 4294967296 as OpSeq

// The sequence number of the op at forward position `pos` of local block `blockLocal`.
export function seqAt(blockLocal CfgIndex, pos BlockOpPos) returns OpSeq
	if pos >= SeqStride 'blockTooLong'
		panic("seqAt: block {blockLocal} has more than {SeqStride} ops — the sequence stride cannot separate it from the next block")
	end 'blockTooLong'

	return blockLocal * SeqStride + pos
end 'seqAt'

// Strictly greater than every real sequence number in a function of `numBlocks` blocks — Belady's
// "no later use" sentinel. It must NOT be `u64.max`: on `int(0 to u64.max)` that all-ones pattern
// compares as negative under `>`, so Belady would collapse to first-fit and evict the lowest id
// rather than the farthest next use.
function seqLimitFor(numBlocks CfgIndex) returns OpSeq
	return numBlocks * SeqStride
end 'seqLimitFor'

// `BlockOpPos` — an op's position within one block — is an index into `block.opRefs` and so
// belongs with the IR, not the target tier. It lives in `IrValueId.maxon`.

// A BLOCK-ARG's position among a block's phis — which is also the position of the value each
// predecessor passes it on an edge, because `blockArgs` and an edge's `argIds` are paired
// POSITIONALLY (`PhiEdgeView`). A count of phis, as an exclusive bound.
export typealias PhiIndex = int(0 to u64.max)

// An index into the `UseIndex`'s parallel USE-RECORD columns — one record per (op, value) use site
// of the whole function. This is what the `UseIndex`'s per-value and per-block lists hold.
export typealias UseRecordIndex = int(0 to u64.max)
export typealias UseRecordIndexArray = Array with UseRecordIndex

// HOW MANY uses one value has, or one block holds — the BOUND of a walk of the `UseIndex`'s threads
// (`useCount` / `blockUseCount`), never an index into anything. A record's identity is its
// `UseRecordIndex`; there is no "k-th use" address, because the uses of one value are a linked thread
// rather than a contiguous run, and an addressable k would be an O(k) walk pretending to be an index.
export typealias UseOrdinal = int(0 to u64.max)
export typealias UseOrdinalArray = Array with UseOrdinal

// A count of things the allocator DID: functions allocated, copies inserted, hints honoured, values
// split, liveness mark-steps taken, splitter iterations run. A statistic, never an index into
// anything — so it is named apart from every index space above.
export typealias EventCount = int(0 to u64.max)

// A VERSION STAMP: the 1-BASED id of the thing last written to a slot, so 0 means "never written"
// and the column needs no clearing between passes over it (clearing is the O(blocks × values) cost
// the stamps exist to remove). It is deliberately NOT the id itself — `stamp == v + 1` is the test,
// and a stamp read as a bare id is off by one everywhere.
typealias VersionStamp = int(0 to u64.max)
typealias VersionStampColumn = Array with VersionStamp

// A dense column of physical register NUMBERS, indexed by value id or by parallel-move slot — a
// coloring, a fixed-register hint, or an edge-move operand list.
export typealias RegNumColumn = Array with RegNum

// A dense column of REGISTER COUNTS (a pressure, an effective-pool size, a dead-phi tally), indexed
// by value id, by block, or by pool size. Its entries are quantities of REGISTERS — it was a
// `CfgIndexArray`, which said "block index" about numbers that are nothing of the sort.
export typealias RegCountColumn = Array with RegCount

// (A dense per-value register-class column is `ValueClassColumn`, and it is declared with `RegClass`
// in TargetDialect rather than here: the lowering PRODUCES it and the allocator only consumes it, so
// it is a dialect fact that crosses the tier boundary, not an allocator-local one.)

// ==========================================================================
// Per-class rows — every register-count question, answered per FILE
// ==========================================================================
//
// TWO FILES, ONE SWEEP. Every figure the allocator compares against a pool — a live population, an
// op's pressure, a block's demand, a function's peak — is now a ROW with one entry per register
// class, because the files are independent: 15 live ints do not fit 14 GPRs however many XMMs are
// idle. One MIXED figure against one MIXED pool (30) cannot see that, and it does not fail quietly —
// it panicked the colorer on 19 pressure tests the moment the pool was widened.
//
// ⭐ WHAT MUST NOT FORK IS THE SWEEP. These rows are per-class DATA threaded through the SAME single
// backward walk; nothing here runs twice, once per class. v1 buckets its interval events once and
// then runs a class pass over them per file; this never runs a second pass at all, because
// `stepRowBackwardOverOperands` already knows each flip INLINE (it is the code that flips the bit),
// so a per-class tally costs one array read per FLIPPED operand and zero extra walks.

// How many register FILES there are — the width of every class row and the stride of every
// per-(block, class) row.
//
// ⚠⚠ RESPELLED AS A LITERAL, AND `RegClass.allCases.count()` IS THE BUG IT REPLACES. `allCases`
// BUILDS A FRESH HEAP ARRAY ON EVERY EVALUATION (the bootstrap's `EmitEnumAllCases` emits an array
// literal, not a constant), so naming it in a per-op loop puts a heap allocation on the allocator's
// hottest path. Measured, on the scale corpus: `allCases` in the sweeps and in `classRowIndex` cost
// **+5.6 MILLION allocations at rung 5, +66%** — the growth stayed linear (x1.99) because it is a
// constant factor, which is exactly why no exponent could have caught it.
//
// This is the same trap `MaxonDialect`'s ValueTypeTag column documents ("a Maxon union value is a heap
// object — every case, not just the ones with a payload... put one on the compiler's hottest path"),
// and the same answer `RegisterFileSize` gives: state the number, and ASSERT it against the thing it
// mirrors (`assertRegisterFileMatchesEnum`, RegBits). `assertRegClassCountMatches` below does that for
// this constant, once per module, so it and the enum cannot drift.
//
// ⚠ `RegNum`'s bound is the one respelled number NO assert reaches — a typealias range bound is
// readable by no expression — so it is not in this discipline and this comment used to claim it was.
// It moves by hand; see `RegisterFileSize`.
export let RegClassCount = 2

// The register file with this ordinal — the allocation-free way to walk the files. `for class in
// RegClass.allCases` allocates an array per evaluation (see `RegClassCount`); this is a range loop over
// `0 upto RegClassCount` plus one `fromRawValue`, which allocates nothing.
export function regClassAt(ordinal RegCount) returns RegClass
	return try RegClass.fromRawValue(ordinal) otherwise panic("regClassAt: {ordinal} is not a register-class ordinal — RegClassCount ({RegClassCount}) and the RegClass enum have drifted apart")
end 'regClassAt'

// `RegClassCount` is a respelled literal; this is what keeps it honest. Once per module, so free.
export function assertRegClassCountMatches()
	if RegClassCount != RegClass.allCases.count() 'drift'
		panic("assertRegClassCountMatches: RegClassCount is {RegClassCount} but the RegClass enum has {RegClass.allCases.count()} cases — a register file was added and every class row is now too narrow, so each would silently read its neighbour's cell. Widen RegClassCount with the enum.")
	end 'drift'
end 'assertRegClassCountMatches'

// The index of one (block, class) cell in a per-block PER-CLASS row (`deadPhis`, `blockPressure`).
// This is the one place the layout is stated; every reader goes through the accessors on
// `LivenessResult`.
export function classRowIndex(local CfgIndex, class RegClass) returns ColumnLength
	return local * RegClassCount + class.ordinal
end 'classRowIndex'

// A zeroed per-CLASS row: one entry per register file, indexed by `RegClass.ordinal`.
export function zeroClassRow() returns RegCountColumn
	return zeroColumn(RegClassCount)
end 'zeroClassRow'

export function classRowGet(row RegCountColumn, class RegClass) returns RegCount
	return try row.get(class.ordinal) otherwise panic("classRowGet: row has no entry for the {class.name} file")
end 'classRowGet'

export function classRowSet(row RegCountColumn, class RegClass, value RegCount)
	try row.set(class.ordinal, value: value) otherwise panic("classRowSet: row has no entry for the {class.name} file")
end 'classRowSet'

export function classRowZero(row RegCountColumn)
	for classOrdinal in 0 upto RegClassCount 'eachClass'
		let class = regClassAt(classOrdinal)
		classRowSet(row, class: class, value: 0)
	end 'eachClass'
end 'classRowZero'

// The largest entry across every file — the "how hard was this?" summary, for a REPORT. It is never a
// feasibility test: two files do not pool their registers, so a max is a description and never a
// denominator.
export function classRowMax(row RegCountColumn) returns RegCount
	var widest = 0 as RegCount
	for n in row 'eachClass'
		widest = maxOf(widest, b: n)
	end 'eachClass'
	return widest
end 'classRowMax'

// The population across every file. Derived rather than carried alongside, so there is no second
// counter to drift out of step with the per-class row it summarises.
function classRowTotal(row RegCountColumn) returns RegCount
	var total = 0 as RegCount
	for n in row 'eachClass'
		total = total + n
	end 'eachClass'
	return total
end 'classRowTotal'

// The register FILE a VIRTUAL operand's value lives in — its declared class.
//
// ⚠ ONLY VIRTUAL OPERANDS REACH HERE, AND THAT IS WHY IT NEEDS NO TARGET FILE. Every caller guards on
// `operandIsVirtual` before asking (`recordDefLiveAfter`, `addOpTransientPressure` and its
// `anyVirtualUseDiesAt` — the census tracks only value ids, never physical registers), so a PHYSICAL
// operand is a bug, not the "classify
// a register number" case this used to also handle. It did so against the x64 boundary
// unconditionally (`regClassOf(operandRegister(o).rawValue)`), which would misclassify an arm64 GPR in
// x19..x28 and panic on an arm64 SIMD number (>31) that `X64Register.fromRawValue` cannot name — a
// latent per-ISA hazard on a branch nothing reaches. A physical register's class is the ENCODER's
// concern (`regClassIn` on the target file), not the pressure census's; here it panics loudly.
export function operandClass(o Operand, classes ValueClassColumn) returns RegClass
	if not operandIsVirtual(o) 'physical'
		panic("operandClass: a PHYSICAL operand (payload {operandPayload(o)}) reached the pressure census — its two callers guard on `operandIsVirtual`, so this is a bug. A physical register's file is classified by the encoder (`regClassIn` on the target file), never here.")
	end 'physical'
	return valueClass(operandValueId(o), classes: classes)
end 'operandClass'

// The same lookup for a caller that holds the VALUE and no operand — which is what
// `opTransientDefOf`'s callers hold, deliberately: the transient's selection rule is stated once and
// hands back an id, so the class read may not be a second `classes.get` spelled beside each use.
function valueClass(v ValueId, classes ValueClassColumn) returns RegClass
	return try classes.get(v) otherwise panic("valueClass: value {v} has no recorded register class — the lowering's class column does not cover it")
end 'valueClass'

// Move `v` into or out of ITS OWN file's live tally. ONE implementation for both directions: the
// direction is the only thing that differs, and two functions would be the same read-modify-write
// written twice.
//
// The underflow panic mirrors `RegPoolCensus.remove`'s and exists for the same reason: this tally is
// MAINTAINED, never rebuilt, so a drift from the row it mirrors would silently corrupt every pressure
// figure downstream of it rather than fail where it happened.
export function stepClassLive(liveByClass RegCountColumn, classes ValueClassColumn, v ValueId, entering bool)
	let class = try classes.get(v) otherwise panic("stepClassLive: value {v} has no recorded register class — the lowering's class column does not cover it")
	let cur = classRowGet(liveByClass, class: class)
	if entering 'entered'
		classRowSet(liveByClass, class: class, value: cur + 1)
		return
	end 'entered'

	if cur == 0 'underflow'
		panic("stepClassLive: value {v} left the live set of the {class.name} file but that file's tally is already zero — the per-class live tally has drifted from the bit row it mirrors")
	end 'underflow'
	classRowSet(liveByClass, class: class, value: cur - 1)
end 'stepClassLive'

// Seed a per-class live tally from a sparse live list — the O(live) counterpart of seeding the bit
// row, and the only honest way to start a tally whose decrements panic on underflow.
export function seedClassLive(liveByClass RegCountColumn, classes ValueClassColumn, values ValueIdArray)
	classRowZero(liveByClass)
	for v in values 'eachLive'
		stepClassLive(liveByClass, classes: classes, v: v, entering: true)
	end 'eachLive'
end 'seedClassLive'

// Build a dense column of `count` entries, every entry set to `value` — the "resize a column then
// fill a sentinel" pattern the allocator's color/hint columns, the flat BlockId index, and the Hall
// matching's two inverse maps all share. The result unifies with every purpose-named column above.
export function filledColumn(count ColumnLength, value DenseInt) returns DenseColumn
	var col = DenseColumn.create()
	col.refill(count, value: value)
	return col
end 'filledColumn'

// RE-FILLING A COLUMN THE CALLER ALREADY OWNS IS `Array.refill` (`stdlib/Array.maxon`).
//
// It is what lets a per-iteration buffer become a per-FUNCTION one. The splitter rebuilds several
// value-space columns on every split — and the value space itself grows with every split — so
// allocating them per iteration was Θ(splits × values) of pure allocator traffic for columns whose
// contents are recomputed from scratch each time anyway. Only the STORAGE is reused; never a value:
// `refill` writes EVERY entry in [0, count), so nothing is inherited from the column's last life.
//
// It replaced THREE hand-written copies of itself — `refillColumn` (an 8-byte int column),
// `refillBoolColumn` (a bool one), and `resetRow` in SplitLiveRanges (a bit-word one) — which existed
// only because a free function cannot be generic over an array's element type, and which nothing made
// agree. A METHOD knows its own element type, so one of it serves every column here.
//
// (The pair ALSO carried a width trap, and that half of the story is now history: passing a
// one-byte-per-entry `RegNumColumn` to a `DenseColumn`-typed free function used to be silent memory
// corruption — "it cost a day here" — but a generic's ranged element type is part of its type as of
// e4146cf8e, so the bootstrap now rejects it outright with E3005. Verified. The DUPLICATION was the
// live problem; the corruption was already dead.)

// A dense column of `count` ZEROES — just the resize, because a `resize` that lengthens ALWAYS exposes
// zeroes, where `filledColumn(n, 0)` would walk the whole column doing bounds-checked writes to store
// zeroes over zeroes. The counting sorts and version stamps allocate several of these per function, so
// on the many-small-functions shape (which is what a real codebase, and this compiler's own source,
// looks like) that redundant pass is pure loss.
//
// ⚠ THIS FILE USED TO SAY "FRESH IS LOAD-BEARING" — that a REUSED column keeps its capacity and so
// hands `resize` the previous occupant's bytes rather than zeroes, "measured: after `clear()` then
// `resize(8)`, all 8 entries still held their old values". THAT IS NOT TRUE OF THE RUNTIME WE RUN, and
// the claim was propagated into five comments before anyone re-ran it. THE CAPACITY-SLOT INVARIANT
// (stdlib/Internals.maxon) says every slot in [length, capacity) reads ZERO, and it is upheld by
// zeroing on the way OUT — `clear`, `remove`/`pop`, and a shrinking `resize` each erase what they
// vacate. The C# bootstrap's emitted runtime implements the same invariant independently
// (MaxonToStandardConversion.EmitVacateElementRange). Verified on the bootstrap, which is what compiles
// this compiler: `push` × 4 → `clear()` → `resize(4)` reads back `0 0 0 0`, and the same after a
// shrinking `resize` and after popping every element.
//
// So `resize` alone is SAFE for zeroes on a reused column, and the reason to reach for `refill`
// instead is that you want a NON-zero value in every entry (a sentinel, a `numBlocks` "unset"), or
// that you want the length shortened as well. Not memory safety.
export function zeroColumn(count ColumnLength) returns DenseColumn
	var col = DenseColumn.create()
	col.resize(count)
	return col
end 'zeroColumn'

// EXTENDING A COLUMN IS `Array.growFilled`, NEVER `resize`. The value space grows whenever a split
// mints reload ids, so every column keyed by value id has to follow it — and so does the WORKING ROW
// the pressure sweeps step with, whose width follows the value space too.
//
// `resize` reserves EXACTLY the length asked for, so a column extended a few ids at a time — which is
// what every split does — is reallocated and copied IN FULL on every growth: Θ(splits × values) BYTES,
// quadratic on precisely the shape that splits most. `growFilled` grows capacity geometrically and
// initialises only the entries the growth added, which is what this allocator wants at every one of
// its call sites. It is on `Array` (`stdlib/Array.maxon`) rather than here because a METHOD knows its
// own element type: the pair of hand-rolled `DenseColumn`/`BoolArray` helpers this replaced existed
// only because a free function cannot be generic over one — which is the same reason `Array.refill`
// replaced the THREE hand-rolled copies of the whole-column fill (see `filledColumn` above).
//
// It hid because the allocation COUNT stays low: one realloc per split, not thousands. The ladder's
// BYTE column is what caught it (`regalloc:splitting` grew ×6.75 per doubling of the program, where
// linear is ×2), which is the reason that column is read and not just the alloc one.

// Sort `list` ASCENDING, in place, using `scratch` as the merge buffer.
//
// The splitter's dirty region is a list of block indices that the index rebuild must walk in ascending
// order (a value's use thread is held ascending by SEQUENCE, and a sequence number leads with its
// block). The region is usually a handful of blocks, but nothing BOUNDS it — a value idle across half
// the function is live in half the blocks — so an insertion sort's O(n²) is not a bound this code is
// entitled to assume. Bottom-up merge sort: O(n log n), and the scratch buffer is the caller's, so the
// sort allocates nothing per split.
function sortColumnAscending(list DenseColumn, scratch DenseColumn)
	let n = list.count()
	if n < 2 'nothingToDo'
		return
	end 'nothingToDo'

	scratch.resize(n)
	var width = 1 as ColumnLength
	while width < n 'eachWidth'
		var lo = 0 as ColumnLength
		while lo < n 'eachPair'
			let mid = minOf(lo + width, b: n)
			let hi = minOf(lo + width + width, b: n)
			mergeRuns(list, scratch: scratch, lo: lo, mid: mid, hi: hi)
			lo = hi
		end 'eachPair'

		for i in 0 upto n 'copyBack'
			try list.set(i, value: try scratch.get(i) otherwise panic("sortColumnAscending: scratch.get OOB")) otherwise panic("sortColumnAscending: list.set OOB")
		end 'copyBack'
		width = width + width
	end 'eachWidth'
end 'sortColumnAscending'

// Merge the sorted runs `[lo, mid)` and `[mid, hi)` of `list` into `scratch[lo, hi)`.
function mergeRuns(list DenseColumn, scratch DenseColumn, lo ColumnLength, mid ColumnLength, hi ColumnLength)
	var a = lo
	var b = mid
	var k = lo
	while k < hi 'each'
		var takeLeft = a < mid
		if a < mid and b < hi 'bothRunsLive'
			let left = try list.get(a) otherwise panic("mergeRuns: list.get OOB")
			let right = try list.get(b) otherwise panic("mergeRuns: list.get OOB")
			takeLeft = left <= right
		end 'bothRunsLive'

		if takeLeft 'fromLeft'
			try scratch.set(k, value: try list.get(a) otherwise panic("mergeRuns: list.get OOB")) otherwise panic("mergeRuns: scratch.set OOB")
			a = a + 1
		end 'fromLeft' else 'fromRight'
			try scratch.set(k, value: try list.get(b) otherwise panic("mergeRuns: list.get OOB")) otherwise panic("mergeRuns: scratch.set OOB")
			b = b + 1
		end 'fromRight'
		k = k + 1
	end 'each'
end 'mergeRuns'

// A dense column of LISTS — one EDITABLE list per key of a dense key space, which is what the
// per-block live sets are: a flat CSR row is cheaper to build, but adding or removing ONE value in ONE
// block shifts every later block's entries, and that O(function) edit is what a split must not pay.
//
// ⚠ ONE HEAP OBJECT PER KEY, so the key space must be SMALL. Blocks are; VALUES ARE NOT. The
// `UseIndex` keys its use records by value, and a heap list per value cost a heap allocation per value
// per liveness build — with the driver still rebuilding liveness once per split, that is
// `splits × values` allocations (measured: +16.8M and +15% compile time at scale rung 5). Its lists
// are therefore INTRUSIVE THREADS through flat integer columns instead, and it allocates nothing per
// value. Reach for this only where the keys are few.
export typealias DenseListColumn = Array with DenseColumn

// `count` empty lists — the shape a per-key index is allocated as, ONCE per function. The key space
// never grows afterwards: blocks are fixed by the time liveness runs, and it is the VALUE space a
// split extends, which is not keyed here (see the alias).
function emptyListColumn(count ColumnLength) returns DenseListColumn
	var lists = DenseListColumn.create()
	for _ in 0 upto count 'eachKey'
		lists.push(DenseColumn.create())
	end 'eachKey'
	return lists
end 'emptyListColumn'

// Remove the first occurrence of `value` from `list`; a no-op if it is not there. O(list) — and every
// list it is used on is SHORT (the values live at one block boundary; the use sites in one block), so
// the scan is the right implementation rather than a compromise.
//
// It stays a free function because it is not generic over anything it needs to be: every list it is
// used on IS a `DenseColumn`. Handing it a narrower column is a compile error (E3005), not the silent
// width corruption the old `refillColumn` could be tricked into — see `HallScratch.regOfValue`.
function removeFromDenseList(list DenseColumn, value DenseInt)
	for i in 0 upto list.count() 'each'
		let entry = try list.get(i) otherwise panic("removeFromDenseList: list.get({i}) OOB")
		if entry == value 'found'
			_ = try list.remove(i) otherwise panic("removeFromDenseList: list.remove({i}) OOB")
			return
		end 'found'
	end 'each'
end 'removeFromDenseList'

// A physical-register mask per value id (`forbiddenPhys`): the registers a value
// may NOT be colored into because an op writes them while the value is live across.
export typealias RegMaskColumn = Array with RegMask

// The CFG SKELETON of one function: the block set, the dense local numbering, and the
// successor/predecessor edges — and NOTHING derived from them. Local block indices are dense
// (0..numBlocks-1); `blockRefByLocal` maps them to flat `module.blocks` indices and
// `localByBlockId` maps a function-local `BlockId` back to a local index — both flat arrays,
// never a `Map` in a fixpoint (the O(B²·iters) trap v1 fell into).
//
// Building one is O(BLOCKS + EDGES), not O(total ops): a block's two control ops are ADDRESSED
// (`IrBlock.condBranch` / `IrBlock.terminator`), never searched for. Finding the `jcc` by
// scanning every op of the block made a skeleton build a full pass over every op of the
// function — and the allocator builds two per function (the critical-edge split, then the RPO
// reorder), which is what put `blockOrder` + `criticalEdges` on the profile at all. The ops are
// still the ground truth for every EDGE (see `collectBlockSuccessorIds`); only the SEARCH is
// gone.
//
// This is a TYPE, and not merely a `FuncCfg` with two columns left empty, because the two
// passes that run BEFORE allocation — the RPO block reorder and the critical-edge split —
// read only the skeleton, and building the rest for them cost 12% of the WHOLE COMPILE:
// `valueCount` walks every operand of every op, and `loopDepth` is a DFS plus a BFS per
// natural loop, once per function, for an answer neither pass ever looks at.
//
// Handing those passes a `FuncCfg` with `valueCount = 0` and a zeroed `loopDepth` column
// would be the cheaper edit and the wrong one: nothing would stop a later consumer from
// reading `loopDepth` off it, every block would then look like straight-line code, and the
// splitter's Rule 2 would place spills inside loops it could not see — silently, with no
// error anywhere. Separating the types is what makes "read what was not computed"
// unspellable rather than merely unlikely.
// `blockIdByLocal` (local -> BlockId) is deliberately NOT a field. It is scaffolding the build
// needs to derive `localByBlockId`, and nothing outside the build ever read it back — carrying
// it meant allocating and filling a column per topology build, and permuting it on every
// reorder, for a column with no reader. The one direction consumers do need is the inverse
// (`localByBlockId`), and a local index's BlockId is one hop away via `blockAt`.
export type FuncTopology
	export var numBlocks as CfgIndex
	export var blockRefByLocal as BlockRefArray
	export var localByBlockId as CfgIndexArray
	export var succ as CsrGraph
	export var pred as CsrGraph

	export static function create(numBlocks CfgIndex, blockRefByLocal BlockRefArray, localByBlockId CfgIndexArray, succ CsrGraph, pred CsrGraph) returns FuncTopology
		return Self{numBlocks: numBlocks, blockRefByLocal: blockRefByLocal, localByBlockId: localByBlockId, succ: succ, pred: pred}
	end 'create'
end 'FuncTopology'

// The full per-function CFG the ALLOCATOR consumes: the skeleton (`topo`) plus the two
// analyses derived from it that only the allocator needs — per-block loop nesting depth and
// the function's value-space size. Built ONCE per function and reused across every split
// iteration (see `splitLiveRanges`).
export type FuncCfg
	export var topo as FuncTopology
	export var loopDepth as LoopDepthArray
	export var valueCount as ValueId

	export static function create(topo FuncTopology, loopDepth LoopDepthArray, valueCount ValueId) returns FuncCfg
		return Self{topo: topo, loopDepth: loopDepth, valueCount: valueCount}
	end 'create'

	// The maximum loop nesting depth over all blocks (a stat + a health check that
	// the parser's structured loops were recognised).
	export function maxLoopDepth() returns LoopDepth
		var m = 0 as LoopDepth
		for d in self.loopDepth 'each'
			if d > m 'deeper'
				m = d
			end 'deeper'
		end 'each'
		return m
	end 'maxLoopDepth'
end 'FuncCfg'

// The live-in / live-out sets of every block, SPARSE and EDITABLE: `inSets[b]` holds the value ids
// live on entry to block `b`, `outSets[b]` those live on exit. One list per block per direction —
// never a bitset.
//
// **Sparse is the point.** A dense `blocks × ceil(values/64)` bitset matrix is proportional to the
// value space, not to the information: a function with 19,200 blocks and 12,800 values allocates
// and zeroes 61 MB of live sets EVEN WHEN ONLY ONE VALUE IS EVER LIVE, and every consumer then
// scans 200 words per block to find the handful of live values in it. That was the last superlinear
// term in register allocation. These lists are proportional to the liveness that actually exists —
// which is what the SSA path exploration computes directly, so nothing is thrown away to build them.
//
// **EDITABLE is the other point, and it is why these are lists and not CSR.** Compressed sparse row
// — one flat array per direction plus per-block offsets — is the cheaper thing to BUILD, but adding
// or removing ONE value in ONE block shifts every later block's entries in the flat array: an
// O(function) edit. A live-range split changes the liveness of only the few blocks it touches, so
// paying O(function) per split is what forced the splitter to throw the whole result away and
// recompute liveness from scratch after every split — an O(function × splits) quadratic. Per-block
// lists make that same edit O(1) amortised. The price is one heap object per block, allocated ONCE
// by the walk and then mutated in place, never per split.
export type LiveSets
	// One live list per block — `[b]` is block `b`'s. A block's list is SHORT: it is bounded by the
	// values SIMULTANEOUSLY LIVE at that block boundary (tens), never by the value space, which is what
	// makes a linear scan through one the right way to find or remove a member rather than a compromise.
	export var inSets as DenseListColumn
	export var outSets as DenseListColumn

	// Empty sets for a function of `numBlocks` blocks — the shape `solveLivenessSsa` fills in place.
	export static function create(numBlocks CfgIndex) returns LiveSets
		return Self{inSets: emptyListColumn(numBlocks), outSets: emptyListColumn(numBlocks)}
	end 'create'

	// The values live on ENTRY to `blockLocal`. THE LIST ITSELF, not a copy: a caller that only reads
	// it (seeds a bitset from it, counts it) needs no copy, and one that must hold it across an edit
	// copies it explicitly (`LivenessResult.liveInInto`).
	export function liveIn(blockLocal CfgIndex) returns ValueIdArray
		return try self.inSets.get(blockLocal) otherwise panic("LiveSets.liveIn: block {blockLocal} out of range")
	end 'liveIn'

	// The values live on EXIT from `blockLocal`. The list itself — see `liveIn`.
	export function liveOut(blockLocal CfgIndex) returns ValueIdArray
		return try self.outSets.get(blockLocal) otherwise panic("LiveSets.liveOut: block {blockLocal} out of range")
	end 'liveOut'

	// Add `v` to a block's live-in / live-out set, IDEMPOTENTLY: these are SETS, and a duplicate is
	// not merely redundant — every consumer either seeds a bitset from a list (where it is harmless)
	// or takes the list's COUNT as the block's register demand, where a second copy of a value
	// invents a register that is not needed and can push a function to a false E5001.
	export function addLiveIn(blockLocal CfgIndex, v ValueId)
		var list = self.liveIn(blockLocal)
		addToLiveList(list, v: v)
	end 'addLiveIn'

	export function addLiveOut(blockLocal CfgIndex, v ValueId)
		var list = self.liveOut(blockLocal)
		addToLiveList(list, v: v)
	end 'addLiveOut'

	// Remove `v` from a block's live-in / live-out set; a no-op if it is not in it.
	export function removeLiveIn(blockLocal CfgIndex, v ValueId)
		var list = self.liveIn(blockLocal)
		removeFromDenseList(list, value: v)
	end 'removeLiveIn'

	export function removeLiveOut(blockLocal CfgIndex, v ValueId)
		var list = self.liveOut(blockLocal)
		removeFromDenseList(list, value: v)
	end 'removeLiveOut'
end 'LiveSets'

// Add `v` to one block's live list unless it is already there. O(list), and a live list holds the
// values live at ONE block boundary — tens of entries — so the membership scan is a constant beside
// the path exploration that discovered the value in the first place.
function addToLiveList(list ValueIdArray, v ValueId)
	for u in list 'each'
		if u == v 'alreadyPresent'
			return
		end 'alreadyPresent'
	end 'each'
	list.push(v)
end 'addToLiveList'

// Copy one block's live list into `out` (cleared first) — the O(live) read a consumer does into a
// scratch buffer it reuses across blocks, for the cases that must not alias the stored list.
function copyLiveList(src ValueIdArray, out ValueIdArray)
	out.clear()
	out.append(src)
end 'copyLiveList'

// The liveness result the colorer and the cold-spill splitter consume. `live` holds the sparse per-block
// live-in/live-out sets; `forbidden` is the per-value register mask; `maxPressure` is the exact
// per-program-point maxlive (χ = ω) the E5001 feasibility decision rests on; `livenessMarkSteps` is
// the path-exploration cost counter.
export type LivenessResult
	export var cfg as FuncCfg
	export var valueCount as ValueId
	export var wordsPerRow as BitWordCount
	export var live as LiveSets
	export var forbidden as RegMaskColumn
	// ⛔⛔ THE PHYSICAL REGISTERS ALREADY ESTABLISHED, AND NOT YET DESTROYED, AT EACH VALUE'S DEF —
	// the ONE register fact that is not "what did this value's live range cross?", and the reason it
	// needs a column of its own rather than riding `forbidden` alone: `clearForbidden` zeroes that
	// mask on every victim and every fresh id, and this fact does not change when a live range is cut.
	//
	// A call's arguments are placed by a run of plain physical pre-moves (`mov argReg[0], v0; mov
	// argReg[1], v1; …; call`) with no parallel-copy sequencer, and NOTHING marks an argument register
	// live from its move to the call. The sweep keeps the run apart by forbidding each pre-move's
	// destination to every value live ACROSS it — which covers everything the LOWERING can emit,
	// because the lowering puts nothing between the members of a run (the same fact
	// `emitArgMovesByFloatMask` states when it emits every outgoing STACK store ahead of every
	// register move). A SPLIT CAN. A reload is anchored immediately before the first use of the run it
	// serves and a remat re-emits before each use, and either use may be an argument pre-move that is
	// not the call's first — so the fresh value is DEFINED between two pre-moves, live across neither,
	// forbidden neither, and free to take an argument register an EARLIER pre-move already loaded.
	//
	// (MEASURED before this column existed: on arm64-macOS every `float.fromString` SIGSEGV'd —
	// `__float_magnitudeBitsFromText` reloaded a `bool` into x0 between the pre-moves of a four-
	// argument call and handed the callee that `false` in place of the array it had already put there
	// for argument 0. The x64 half of the same hole is recorded at `markRunStarts`, which stopped the
	// splitter from BREAKING a run at a pre-move; a run whose own first use IS one was never covered.)
	//
	// ⚠ THE CURE IS NOT TO MOVE THE SPLICE. Backing a defining splice out to the head of the run was
	// tried and is WRONG: k reloads serving k different arguments all become live at the run head at
	// once, so the pressure the split was relieving RISES, and the driver re-picks for ever
	// (MEASURED: `splitLiveRanges: 'main' did not converge after 33938 splits`). A forbid changes no
	// live range and no pressure, so it cannot do that — and it puts the constraint where the
	// splitter's own feasibility machinery reads it, rather than only where the colorer does.
	export var establishedAtDef as RegMaskColumn
	// Which register FILE each value lives in — dense, by value id. PRODUCED BY THE LOWERING and
	// handed to the allocator (see `allocateRegisters`); the allocator never derives it.
	//
	// ⭐ ITS OWN COLUMN, NOT A FORBIDDEN MASK, AND THE DISTINCTION IS THE WHOLE POINT. Encoding "not
	// a GPR" as 16 set bits in `forbidden` costs no new column and is WRONG: `clearForbidden` ZEROES
	// that mask, and the splitter calls it on every spill victim and every fresh id, so the class
	// would be WIPED mid-allocation and a float would be coloured into a GPR. The wipe is CORRECT and
	// must stay (see `clearForbidden`). The class is what a value IS — intrinsic, permanent, fixed by
	// its Std type at birth. `forbidden` is what the ops it crosses TOOK AWAY — contextual, and
	// recomputable precisely BECAUSE a split cuts the live range that earned it. Two facts with two
	// different lifetimes cannot share one column.
	export var valueClass as ValueClassColumn
	// The TARGET's register file — its GPR/vector boundary (16 for x64, 31 for arm64) and width. It
	// rides here because it is the natural travelling companion of `valueClass`: every per-value class
	// question the splitter/census/colorer ask (`poolOfClass`, `classPoolSizeOf`, `allowedRegistersOf`)
	// needs this file, and every one of those sites already holds a `LivenessResult`. Sourced once in
	// `allocateRegisters` (`registerFileFor(target)`) and threaded here through `computeLivenessOn` so
	// the boundary is stated per-ISA rather than hardcoded to x64's 16.
	export var registerFile as RegisterFile
	// Peak simultaneous register demand PER CLASS (a class row) — the exact χ = ω each register file
	// must satisfy on its own.
	export var maxPressure as RegCountColumn
	// Block-marking steps taken by the SSA path exploration — the honest cost counter. (There is
	// no fixpoint, so there is no iteration count to report.)
	export var livenessMarkSteps as EventCount
	// Per-block, PER-CLASS DEAD block-arg count — a block-arg with no use in the block and not
	// live-out. The colorer still reserves a register for each across the WHOLE block (a dead phi
	// never appears as an operand, so it never dies and its register frees only at the block
	// boundary), so it counts toward that block's true demand FOR ITS OWN FILE even though it is
	// never "live".
	//
	// Recorded HERE, for free, by the backward sweep that already computes it — the splitter's
	// peak-finder needs the same number at every op of every block, and recomputing it per block
	// meant re-sweeping the whole block and heap-allocating two arrays per call.
	//
	// A 2-WIDE ROW PER BLOCK (`classRowIndex`), not a column per class: same allocation count as the
	// single column it replaces, and the stride is derived from the enum.
	export var deadPhis as RegCountColumn
	// Per-block, PER-CLASS REGISTER DEMAND: the block's peak simultaneous live count of that file
	// (carrying the reuse-copy transient, in the file the transient's own destination register
	// belongs to) plus that file's dead-phi reservations. `maxPressure` is the MAX over this column,
	// per class. Same 2-wide row as `deadPhis`.
	//
	// It is kept as a column, and not merely folded away, because a split changes the demand of only
	// the blocks it touched — so the splitter re-derives those few and takes the max ONCE, at the end,
	// instead of re-sweeping every block to learn a number that did not move (`refreshMaxPressure`).
	export var blockPressure as RegCountColumn
	// The function's per-value index — def sites, use sites, per-value flags, the layout op
	// numbering. The liveness walk builds it (it needs the use lists), and the cold-spill splitter
	// answers EVERY per-value question from it rather than re-walking the function per candidate.
	export var useIndex as UseIndex
	// The per-VARIANT static op facts, memoized (see `OpVariantFacts`). It rides here for the reason
	// `registerFile` does: every walk that asks one of those questions — the pressure sweep, the
	// splitter's peak-finder, its use-rewriter, the index rebuild — already holds a `LivenessResult`,
	// and the memo must be the SAME object across all of them or each pays the derivation again.
	export var opFacts as OpVariantFacts

	export static function create(cfg FuncCfg, valueCount ValueId, wordsPerRow BitWordCount, live LiveSets, forbidden RegMaskColumn, establishedAtDef RegMaskColumn, valueClass ValueClassColumn, registerFile RegisterFile, maxPressure RegCountColumn, livenessMarkSteps EventCount, deadPhis RegCountColumn, blockPressure RegCountColumn, useIndex UseIndex, opFacts OpVariantFacts) returns LivenessResult
		return Self{cfg: cfg, valueCount: valueCount, wordsPerRow: wordsPerRow, live: live, forbidden: forbidden, establishedAtDef: establishedAtDef, valueClass: valueClass, registerFile: registerFile, maxPressure: maxPressure, livenessMarkSteps: livenessMarkSteps, deadPhis: deadPhis, blockPressure: blockPressure, useIndex: useIndex, opFacts: opFacts}
	end 'create'

	// The dead block-arg count of local block `local`, for ONE register file.
	export function deadPhiCountOf(local CfgIndex, class RegClass) returns RegCount
		return try self.deadPhis.get(classRowIndex(local, class: class)) otherwise panic("LivenessResult.deadPhiCountOf: block {local} out of range")
	end 'deadPhiCountOf'

	// ----------------------------------------------------------------------
	// EDITS — what a live-range split changes, and nothing else
	// ----------------------------------------------------------------------

	// Re-derive `maxPressure` from the per-block demands, PER CLASS. O(blocks), and the splitter calls
	// it ONCE, after its last split — never per split, which is the whole point of keeping the column.
	//
	// ONE walk of the 2-wide rows, not one walk per class: the row index carries the class, so every
	// entry is read once and folded into its own file's max.
	export function refreshMaxPressure()
		classRowZero(self.maxPressure)
		for local in 0 upto self.cfg.topo.numBlocks 'eachBlock'
			for classOrdinal in 0 upto RegClassCount 'eachClass'
				let class = regClassAt(classOrdinal)
				classRowSet(self.maxPressure, class: class, value: maxOf(self.maxPressureOf(class), b: self.blockPressureOf(local, class: class)))
			end 'eachClass'
		end 'eachBlock'
	end 'refreshMaxPressure'

	// The function's peak simultaneous demand for ONE register file.
	export function maxPressureOf(class RegClass) returns RegCount
		return classRowGet(self.maxPressure, class: class)
	end 'maxPressureOf'

	// One block's register demand for ONE file.
	export function blockPressureOf(local CfgIndex, class RegClass) returns RegCount
		return try self.blockPressure.get(classRowIndex(local, class: class)) otherwise panic("LivenessResult.blockPressureOf: block {local} out of range")
	end 'blockPressureOf'

	// Record one block's re-derived register demand for ONE file (`sweepBlockPressure`'s answer).
	export function setBlockPressure(local CfgIndex, class RegClass, demand RegCount)
		try self.blockPressure.set(classRowIndex(local, class: class), value: demand) otherwise panic("LivenessResult.setBlockPressure: block {local} out of range")
	end 'setBlockPressure'

	// Grow the value space to the ids a split MINTED. Every value-keyed column follows it, and the
	// working rows widen with `wordsPerRow`. A fresh id forbids nothing until the dirty-region sweep
	// says otherwise, so the added entries are zero.
	//
	// ⭐ `class` IS REQUIRED, AND THAT IS WHY IT IS A PARAMETER RATHER THAN A DEFAULT. Every id one
	// split mints derives from that split's ONE victim — a reload of it, or a rematerialization of it
	// — so it holds the victim's value and therefore its class. THIS IS THE ONLY PLACE A NEW VALUE'S
	// CLASS COMES FROM, because the ops a split inserts cannot say: `loadRegSlot` is
	// class-POLYMORPHIC (it is `mov r64, [slot]` for an int and `movsd xmm, [slot]` for a float), so
	// classifying a reload by its own op would answer GPR for a float and colour it into the wrong
	// file. Defaulting the added entries to `gpr` would make that a SILENT wrong answer; making the
	// caller name the class makes forgetting it a compile error.
	//
	// ⚠⚠ THE CLASS COLUMN IS TRUNCATED TO THE VALUE SPACE BEFORE IT IS EXTENDED, AND THAT ONE LINE IS
	// A SHIPPED MISCOMPILE, NOT A NICETY. **THE COLUMN CAN ALREADY BE LONGER THAN THE VALUE SPACE**:
	// the allocator's `valueCount` is `scanFunctionValueCount`, which counts values a Target OPERAND
	// names, while the lowering's column records a class for every value an op DEFINES — and a fused
	// compare's boolean lives only in EFLAGS, so it is defined, never an operand, and (for
	// `InsertRangeChecks`, which mints its cascade last) carries the function's HIGHEST id. Two honest
	// counts of two different sets, so `column.count() > valueCount` is normal. A BARE `growFilled` is
	// then a silent NO-OP for exactly the ids this call exists to classify, and the split's fresh
	// reload keeps the column's `gpr` fill: an f64 reload coloured into a GPR, surfacing far away as a
	// cross-file `mov xmm1, rax` (`emitRegRegMove`) or a `cvttsd2si` whose source is `rcx`
	// (`requireClass`) — one defect, two crash sites.
	//
	// Cutting the column back to `valueCount` first makes the extension's own fill cover the WHOLE
	// minted range `[valueCount, newValueCount)`, so **the fill IS the classification** rather than a
	// plausible-looking second answer sitting beside a loop that quietly does the real work. That is
	// the shape this had, and its hazard was that the loop reads as redundant with the fill: deleting
	// it — the obvious "simplification" — restores the miscompile exactly. The discarded tail entries
	// are ids this call is about to overwrite anyway, so nothing is lost that the loop did not already
	// destroy.
	export function growValueSpace(newValueCount ValueId, class RegClass)
		if newValueCount < self.valueCount 'shrink'
			panic("LivenessResult.growValueSpace: cannot shrink the value space from {self.valueCount} to {newValueCount}")
		end 'shrink'

		self.forbidden.growFilled(newValueCount, value: 0)
		// A fresh id establishes nothing until the dirty-block re-sweep says what was pending where the
		// split put its def (`sweepEstablishedRegisters`), which runs before its mask is rebuilt.
		self.establishedAtDef.growFilled(newValueCount, value: 0)
		self.valueClass.resize(self.valueCount)
		self.valueClass.growFilled(newValueCount, value: class)

		self.valueCount = newValueCount
		self.wordsPerRow = bitsetWordsFor(newValueCount)
	end 'growValueSpace'

	// Forget everything `v` was forbidden, so the caller can REBUILD its mask.
	//
	// `forbidden` is otherwise a pure OR-accumulation, which is what lets an incremental update
	// re-sweep a dirty block without disturbing the values it did not change. The ONE mask that can
	// SHRINK is the split victim's: its live range is cut at the peak, so it is no longer live across
	// the call that forbade it the caller-saved registers. A mask that only ever grows would keep
	// saying it was — and the value would be denied a register it can now legally take.
	//
	// ⚠ THIS IS EXACTLY WHY A VALUE'S CLASS IS NOT IN THIS MASK (see `valueClass`). This zeroing is
	// correct and load-bearing, and it runs on every victim and every fresh id — so a class encoded
	// here would be erased mid-allocation, and the float that lost it would be coloured into a GPR.
	export function clearForbidden(v ValueId)
		try self.forbidden.set(v, value: 0) otherwise panic("LivenessResult.clearForbidden: value {v} out of range (valueCount={self.valueCount})")
	end 'clearForbidden'

	// Add `mask` to `v`'s forbidden registers.
	export function addForbidden(v ValueId, mask RegMask)
		try self.forbidden.set(v, value: self.forbiddenOf(v) or mask) otherwise panic("LivenessResult.addForbidden: value {v} out of range (valueCount={self.valueCount})")
	end 'addForbidden'

	// The values live on ENTRY to `local`, into `out` (cleared first). O(live) — this is the seed
	// the colorer's in-use mask is built from. `out` is meant to be a scratch buffer reused across
	// blocks.
	export function liveInInto(local CfgIndex, out ValueIdArray)
		copyLiveList(self.live.liveIn(local), out: out)
	end 'liveInInto'

	// The values live on EXIT from `local`, into `out` (cleared first). O(live).
	export function liveOutInto(local CfgIndex, out ValueIdArray)
		copyLiveList(self.live.liveOut(local), out: out)
	end 'liveOutInto'

	// Seed a dense working ROW with `local`'s live-out set. One dense row (not a matrix) is the
	// right shape for a backward per-op sweep inside a block — bits flip at every op — but it must
	// be seeded and cleared in O(live), never by copying a full value-space row per block. Pair with
	// `clearRowOfLiveOut`, which removes exactly the bits this set.
	export function seedRowFromLiveOut(local CfgIndex, row BitWordArray, scratch ValueIdArray)
		self.liveOutInto(local, out: scratch)
		for v in scratch 'each'
			bitsetAdd(row, base: 0, bit: v)
		end 'each'
	end 'seedRowFromLiveOut'

	// Clear a dense working row that `seedRowFromLiveOut` seeded and a backward block sweep then
	// mutated. What such a row holds at the end of the sweep is the block's LIVE-IN set plus any of
	// its own block-args that are live (the sweep re-adds a phi when an op in the block reads it),
	// so removing exactly those two sets returns the row to zero in O(live + phis). Clearing the
	// full row instead would be O(values/64) per block — the very term the sparse sets remove.
	export function clearRowAfterSweep(local CfgIndex, block IrBlock, row BitWordArray, scratch ValueIdArray)
		self.liveInInto(local, out: scratch)
		for v in scratch 'eachLiveIn'
			bitsetRemove(row, base: 0, bit: v)
		end 'eachLiveIn'
		for arg in block.blockArgs 'eachPhi'
			bitsetRemove(row, base: 0, bit: arg.valueId)
		end 'eachPhi'
	end 'clearRowAfterSweep'

	// The register mask value `v` must avoid: the registers an op writes while `v` is live across it,
	// UNIONED with everything `nonSweptForbidOf` contributes.
	export function forbiddenOf(v ValueId) returns RegMask
		return try self.forbidden.get(v) otherwise panic("LivenessResult.forbiddenOf: value {v} out of range (valueCount={self.valueCount})")
	end 'forbiddenOf'

	// The register FILE `v` lives in. Every per-value pool question — what may it take, is it
	// confined, is its pool full — is asked against THIS class's registers and never against the
	// whole machine (see `RegBits.classRegisterMask`).
	export function classOf(v ValueId) returns RegClass
		return try self.valueClass.get(v) otherwise panic("LivenessResult.classOf: value {v} out of range (valueCount={self.valueCount})")
	end 'classOf'
end 'LivenessResult'

// The local index of a function-local `BlockId`, via the O(1) flat `FuncTopology` index —
// NEVER `IrModule.getBlockByIdIn` (an O(blocks) scan, the O(B²) trap the design
// forbids inside per-block/per-edge loops). Panics if the id is not in this function.
//
// Takes the TOPOLOGY, not the `FuncCfg`: it resolves a block id, which is a question about
// the skeleton alone. That is what lets the critical-edge split — which has no loop depths
// and no value count — call the same one implementation the allocator calls.
export function localOfBlockId(topo FuncTopology, blockId BlockId) returns CfgIndex
	let local = try topo.localByBlockId.get(blockId) otherwise panic("localOfBlockId: block id {blockId} out of id range")
	if local == topo.numBlocks 'notInFunc'
		panic("localOfBlockId: block id {blockId} is not in this function")
	end 'notInFunc'
	return local
end 'localOfBlockId'

// A resolved phi-carrying edge: the target block's block-args (phis) paired
// positionally with the incoming values a predecessor passes on the edge. Built once
// per edge — arity-checked HERE, the one place that check lives — then indexed by the
// consumers that each walk the (phi, incoming) pairs differently: SSA-destruction plan
// building, the colorer's biased-coloring hints, and the E5001 diagnostic's phi
// resolution. Holds references to the existing arrays (no per-element copy).
// Which of the three consumers is resolving a phi edge — see PhiEdgeView.resolve.
export enum PhiEdgeConsumer
	coloringHints
	ssaDestruction
	registerPressureDiagnostic
end 'PhiEdgeConsumer'

export type PhiEdgeView
	export var blockArgs as IrBlockArgArray
	export var argIds as ValueIdArray
	export var count as PhiIndex

	// Resolve + arity-check the phi edge into `targetBlock` carrying `argIds`. `context`
	// names the caller for the panic. A mismatch is a malformed SSA edge — the ONE
	// arity assertion for all three consumers.
	//
	// An ENUM, not a String tag: `resolve` runs once per CFG EDGE inside the register
	// allocator, and a String argument is evaluated eagerly, so a literal here allocated a
	// heap String per edge to name a caller in a panic that fires only on malformed SSA.
	export static function resolve(targetBlock IrBlock, argIds ValueIdArray, context PhiEdgeConsumer) returns PhiEdgeView
		let phiCount = targetBlock.blockArgs.count()
		if argIds.count() != phiCount 'arity'
			panic("PhiEdgeView.resolve ({context.name}): edge to '{String.from(targetBlock.label)}' carries {argIds.count()} args but the block has {phiCount} phis")
		end 'arity'
		return Self{blockArgs: targetBlock.blockArgs, argIds: argIds, count: phiCount}
	end 'resolve'

	// The value id of the k-th phi (block-arg) of the target block.
	export function phiValueIdAt(k PhiIndex) returns ValueId
		let arg = try self.blockArgs.get(k) otherwise panic("PhiEdgeView.phiValueIdAt: OOB")
		return arg.valueId
	end 'phiValueIdAt'

	// The value id the predecessor passes to the k-th phi on this edge.
	export function incomingAt(k PhiIndex) returns ValueId
		return try self.argIds.get(k) otherwise panic("PhiEdgeView.incomingAt: OOB")
	end 'incomingAt'
end 'PhiEdgeView'

// DFS coloring for back-edge detection: WHITE = not yet reached, GRAY = still on the current DFS
// path (an edge to one is a retreating edge, i.e. a back edge in a reducible CFG), BLACK = closed.
// Three states and no more, which is the whole bound.
typealias DfsColor = int(0 to 2)
typealias DfsColorArray = Array with DfsColor

let DfsWhite = 0 as DfsColor
let DfsGray = 1 as DfsColor
let DfsBlack = 2 as DfsColor

// Compute liveness on a CFG the CALLER owns, and whose `valueCount` the caller keeps current.
//
// This is what lets the cold-spill splitter recompute liveness after every split without
// rebuilding the CFG each time: a split inserts only body ops and rewrites operands, so the block
// set, the successor/predecessor edges and the loop depths are all INVARIANT under it — only the
// value space grows, and the splitter knows exactly how (it minted the ids). Rebuilding the CFG
// per split re-scanned the whole function, re-derived both CSR graphs, and re-walked one natural
// loop per loop header, for an answer that could not have changed.
export function computeLivenessOn(module TargetModule, cfg FuncCfg, func IrFunction, valueClass ValueClassColumn, file RegisterFile, opFacts OpVariantFacts) returns LivenessResult
	let valueCount = cfg.valueCount
	let wordsPerRow = bitsetWordsFor(valueCount)
	let numBlocks = cfg.topo.numBlocks

	if numBlocks != func.blockRefs.count() 'cfgStale'
		panic("computeLivenessOn: '{String.from(func.name)}' now has {func.blockRefs.count()} blocks but the caller's FuncCfg was built with {numBlocks} — a pass added or removed a block, which the reused-CFG contract forbids")
	end 'cfgStale'

	// The variant memo is the CALLER's — one per MODULE, made in `allocateRegisters` and threaded down.
	// Its contents are a property of the DIALECT (which registers a `callDirect` clobbers, whether a
	// `loadRegSlot` touches a slot), so a per-FUNCTION memo made every function re-derive the ~30 cases
	// its own ops name and pay a handful of column reallocations to hold them. Every walk below shares
	// this one, so a variant's facts are derived on the first op of that case the whole COMPILE meets and
	// read from then on (see `OpVariantFacts`).
	let useIndex = buildUseIndex(module, cfg: cfg, valueCount: valueCount, opFacts: opFacts)
	var marks = LivenessMarkScratch.create()
	marks.begin(numBlocks)
	var touched = BlockSet.create()
	touched.begin(numBlocks)
	let walk = solveLivenessSsa(cfg.topo, useIndex: useIndex, valueCount: valueCount, marks: marks, touched: touched)

	var forbidden = makeRegMaskColumn(valueCount)
	var establishedAtDef = makeRegMaskColumn(valueCount)
	assertClassColumnCovers(valueClass, valueCount: valueCount, func: func)
	let classRowWidth = RegClassCount
	var deadPhis = zeroColumn(numBlocks * classRowWidth)
	var blockPressure = zeroColumn(numBlocks * classRowWidth)
	var sweep = PressureSweepScratch.create()
	sweep.widenRow(wordsPerRow)

	var maxPressure = zeroClassRow()
	var demand = zeroClassRow()
	for i in 0 upto numBlocks 'eachBlock'
		sweepBlockPressure(module, topo: cfg.topo, blockLocal: i, live: walk.live, forbidden: forbidden, classes: valueClass, deadPhis: deadPhis, wordsPerRow: wordsPerRow, scratch: sweep, demandOut: demand, opFacts: opFacts)
		sweepEstablishedRegisters(module, topo: cfg.topo, blockLocal: i, establishedAtDef: establishedAtDef, scratch: sweep, opFacts: opFacts)
		for classOrdinal in 0 upto RegClassCount 'eachClass'
			let class = regClassAt(classOrdinal)
			try blockPressure.set(classRowIndex(i, class: class), value: classRowGet(demand, class: class)) otherwise panic("computeLivenessOn: blockPressure.set OOB for block {i}")
			classRowSet(maxPressure, class: class, value: maxOf(classRowGet(maxPressure, class: class), b: classRowGet(demand, class: class)))
		end 'eachClass'
	end 'eachBlock'

	let paramCross = ParamCrossForbid.resolve(module, topo: cfg.topo, paramCount: func.paramCount)

	// The contributions no block sweep produces, folded in ONE pass through the ONE function that
	// lists them — the same function the splitter's `rebuildForbiddenOf` asks after it zeroes a mask.
	for v in 0 upto valueCount 'theContributionsNoSweepMakes'
		let nonSwept = nonSweptForbidOf(v, paramCross: paramCross, establishedAtDef: establishedAtDef)
		if nonSwept != 0 'hasOne'
			try forbidden.set(v, value: (try forbidden.get(v) otherwise panic("computeLivenessOn: forbidden.get OOB for value {v}")) or nonSwept) otherwise panic("computeLivenessOn: forbidden.set OOB for value {v}")
		end 'hasOne'
	end 'theContributionsNoSweepMakes'

	return LivenessResult.create(cfg, valueCount: valueCount, wordsPerRow: wordsPerRow, live: walk.live, forbidden: forbidden, establishedAtDef: establishedAtDef, valueClass: valueClass, registerFile: file, maxPressure: maxPressure, livenessMarkSteps: walk.markSteps, deadPhis: deadPhis, blockPressure: blockPressure, useIndex: useIndex, opFacts: opFacts)
end 'computeLivenessOn'

// A zeroed per-value register-mask column.
function makeRegMaskColumn(valueCount ValueId) returns RegMaskColumn
	var col = RegMaskColumn.create()
	col.resize(valueCount)
	return col
end 'makeRegMaskColumn'

// The class column the LOWERING produced must name every value this function has.
//
// It is a real check on real data, not a formality: the column is written as each vreg is minted, and
// the allocator's own `scanFunctionValueCount` is an INDEPENDENT count of the same value space. A
// producer that mints a vreg without recording its class leaves a SHORT column, and every read past
// its end is a value whose file nobody stated. Catching that here — once per function, O(1) — is what
// makes "the class is produced, never derived" an enforced invariant rather than a convention.
//
// ⚠ It cannot catch a column that is long enough but WRONG (an f64 recorded as `gpr`). Nothing
// downstream can: `assertColouredInClass` compares a colour against the DECLARED class, so a wrong
// declaration is self-consistent all the way to `addsd rax, rcx`. Stating the class correctly, from
// the Std type, at the moment the vreg is minted, is the whole defence.
function assertClassColumnCovers(valueClass ValueClassColumn, valueCount ValueId, func IrFunction)
	if valueClass.count() < valueCount 'shortColumn'
		panic("computeLivenessOn: '{String.from(func.name)}' has {valueCount} values but the lowering recorded classes for only {valueClass.count()} of them. Every virtual register's class is written as it is minted (StdToX64Conversion); a short column means a vreg was minted without one, and the values past the end have no register file stated. The allocator cannot derive it — `movRegReg`/`loadRegSlot`/`xchgRegReg` are class-agnostic by design, so a copy's class is knowable only from its source.")
	end 'shortColumn'
end 'assertClassColumnCovers'

// ==========================================================================
// CFG construction
// ==========================================================================

// Reorder `func.blockRefs` into REVERSE-POSTORDER so LAYOUT order matches EXECUTION order
// (a block that runs after another sits later). The cold-spill splitter classifies a value's
// uses as before/after a pressure peak by their layout SEQUENCE, and that is sound only when
// layout order is a topological order of the forward CFG — i.e. RPO. The parser emits a
// NESTED loop's exit/continuation block BEFORE the inner loop's blocks, so without this an
// idle value's post-loop use gets a LOWER sequence than the inner-loop peak, is misclassified
// as a before-peak use, and is never split out of the loop — a FALSE E5001 on a loop that does
// not genuinely need the registers.
//
// Successors are walked in REVERSE add-order. `collectBlockSuccessorIds` adds the `then`
// (=loop body / if-then) edge before the `else` (=loop exit / if-continuation) edge, and
// exploring the else edge FIRST lands a structured loop's exit AFTER its whole body in the
// resulting RPO — which is exactly the property the splitter's sequence needs. For a single
// loop, an `if`, or straight-line code this RPO already equals the parser's block order, so
// those functions (every current spec) are UNCHANGED; only genuinely nested CFGs reorder.
//
// Unreachable blocks — a parser `dead` continuation with no predecessor — are not reached by
// the DFS, so they are appended in their original relative order to preserve them (they still
// hold ops that get emitted). Entry (local 0) is the DFS root, so it stays first (its prologue
// must lead `.text`). Runs before the splitter in `allocateFunction`.
//
// RETURNS the reordered topology, which the splitter then completes into its `FuncCfg` — the
// only pass between the two is nothing, so the skeleton this built is still exactly the
// function's. Throwing it away meant the very next thing the allocator did was re-derive the
// same graph from the IR, for a graph already in hand.
export function reorderFuncBlocksRpo(module TargetModule, func IrFunction) returns FuncTopology
	let topo = buildFuncTopology(module, func: func)
	if topo.numBlocks == 0 'empty'
		return topo
	end 'empty'

	var visited = BoolArray.create()
	visited.resize(topo.numBlocks)
	var postorder = CfgIndexArray.create()
	rpoDfs(topo, root: 0, visited: visited, postorder: postorder)

	// `oldByNew[i]` — the OLD local index of the block that lands at NEW local index `i`. Built
	// in lockstep with `newRefs`, so it IS the permutation the block list just underwent, and
	// `permuteTopology` re-indexes the skeleton by it rather than rebuilding it.
	var oldByNew = CfgIndexArray.create()
	var newRefs = BlockRefArray.create()
	for ri in 0 upto postorder.count() 'reverse'
		let local = try postorder.get(postorder.count() - 1 - ri) otherwise panic("reorderFuncBlocksRpo: postorder.get OOB")
		oldByNew.push(local)
		newRefs.push(try topo.blockRefByLocal.get(local) otherwise panic("reorderFuncBlocksRpo: blockRefByLocal.get OOB"))
	end 'reverse'
	for i in 0 upto topo.numBlocks 'appendUnreachable'
		if not (try visited.get(i) otherwise panic("reorderFuncBlocksRpo: visited.get OOB")) 'unreached'
			oldByNew.push(i)
			newRefs.push(try topo.blockRefByLocal.get(i) otherwise panic("reorderFuncBlocksRpo: blockRefByLocal.get OOB (unreachable)"))
		end 'unreached'
	end 'appendUnreachable'

	func.blockRefs = newRefs
	return permuteTopology(topo, oldByNew: oldByNew)
end 'reorderFuncBlocksRpo'

// Re-index a topology whose blocks were REORDERED — not added to, not removed. It is the same
// graph under a new dense numbering, so nothing has to be re-read from the IR: `oldByNew[i]`
// is the old local index of the block now at new local index `i`, and every column and both
// CSR graphs are permuted through it in O(blocks + edges).
//
// The result is IDENTICAL to `buildFuncTopology` on the reordered function — including the
// ORDER of every node's neighbour list, which is load-bearing and easy to lose here:
//
//  • SUCCESSORS keep their block's own op order, because they are copied out of one old node's
//    list in order. `rpoDfs` explores successors in REVERSE add-order to land a loop's exit
//    after its body, so a permutation that reshuffled them would silently change the RPO — and
//    with it the splitter's before/after-peak classification.
//  • PREDECESSORS come out in ascending NEW predecessor index, because the edges are pushed in
//    ascending new-source order and `buildCsr` preserves push order within a key — which is
//    exactly the order a fresh scan of the reordered block list produces.
function permuteTopology(old FuncTopology, oldByNew CfgIndexArray) returns FuncTopology
	let numBlocks = old.numBlocks

	// The inverse permutation. Every old local appears exactly once in `oldByNew` (the DFS
	// covers the reachable blocks and the unreachable sweep covers the rest), so this is total.
	var newByOld = zeroColumn(numBlocks)
	for i in 0 upto numBlocks 'invert'
		let o = try oldByNew.get(i) otherwise panic("permuteTopology: oldByNew.get OOB")
		try newByOld.set(o, value: i) otherwise panic("permuteTopology: newByOld.set OOB")
	end 'invert'

	var blockRefByLocal = BlockRefArray.create()
	for i in 0 upto numBlocks 'permuteColumns'
		let o = try oldByNew.get(i) otherwise panic("permuteTopology: oldByNew.get OOB")
		blockRefByLocal.push(try old.blockRefByLocal.get(o) otherwise panic("permuteTopology: blockRefByLocal.get OOB"))
	end 'permuteColumns'

	// BlockId -> new local. The id space is unchanged (the same blocks are present), and
	// `numBlocks` stays the "not in this function" sentinel, so only real entries are remapped.
	let idSpace = old.localByBlockId.count()
	var localByBlockId = filledColumn(idSpace, value: numBlocks)
	for bid in 0 upto idSpace 'remapIds'
		let oldLocal = try old.localByBlockId.get(bid) otherwise panic("permuteTopology: localByBlockId.get OOB")
		if oldLocal == numBlocks 'notInFunc'
			continue
		end 'notInFunc'
		let newLocal = try newByOld.get(oldLocal) otherwise panic("permuteTopology: newByOld.get OOB")
		try localByBlockId.set(bid, value: newLocal) otherwise panic("permuteTopology: localByBlockId.set OOB")
	end 'remapIds'

	var edgeFrom = CfgIndexArray.create()
	var edgeTo = CfgIndexArray.create()
	for u in 0 upto numBlocks 'eachNewBlock'
		let oldU = try oldByNew.get(u) otherwise panic("permuteTopology: oldByNew.get OOB")
		for k in 0 upto old.succ.degree(oldU) 'eachSucc'
			let oldV = old.succ.neighbour(oldU, k: k)
			edgeFrom.push(u)
			edgeTo.push(try newByOld.get(oldV) otherwise panic("permuteTopology: newByOld.get OOB"))
		end 'eachSucc'
	end 'eachNewBlock'

	let succ = buildCsr(edgeFrom, to: edgeTo, nodeCount: numBlocks)
	let pred = buildCsr(edgeTo, to: edgeFrom, nodeCount: numBlocks)

	return FuncTopology.create(numBlocks, blockRefByLocal: blockRefByLocal, localByBlockId: localByBlockId, succ: succ, pred: pred)
end 'permuteTopology'

// Postorder DFS from `root`, pushing each block AFTER its whole subtree. Successors are explored in
// REVERSE add-order (see `reorderFuncBlocksRpo`).
//
// ITERATIVE, with an explicit stack. The recursive form recursed once per block, and its comment
// claimed "the CFGs it runs on are small" — that assumption SEGFAULTED the compiler on a
// 19,200-block function, before a single instruction was allocated. Block counts are bounded by the
// program, not by anything we control, so no traversal here may recurse. The stack holds a
// (node, next-successor-index) pair per open node — the explicit form of a recursive call's resume
// point — so a node is emitted to the postorder only once its whole subtree is done.
function rpoDfs(topo FuncTopology, root CfgIndex, visited BoolArray, postorder CfgIndexArray)
	var stackNode = CfgIndexArray.create()
	var stackNextSucc = CfgIndexArray.create()

	try visited.set(root, value: true) otherwise panic("rpoDfs: visited.set(root) OOB")
	stackNode.push(root)
	stackNextSucc.push(0)

	while stackNode.count() > 0 'dfs'
		let top = stackNode.count() - 1
		let u = try stackNode.get(top) otherwise panic("rpoDfs: stackNode.get OOB")
		let k = try stackNextSucc.get(top) otherwise panic("rpoDfs: stackNextSucc.get OOB")
		let deg = topo.succ.degree(u)

		if k >= deg 'subtreeDone'
			postorder.push(u)
			_ = try stackNode.pop() otherwise panic("rpoDfs: stackNode.pop on non-empty failed")
			_ = try stackNextSucc.pop() otherwise panic("rpoDfs: stackNextSucc.pop on non-empty failed")
			continue
		end 'subtreeDone'

		try stackNextSucc.set(top, value: k + 1) otherwise panic("rpoDfs: stackNextSucc.set OOB")

		let s = topo.succ.neighbour(u, k: deg - 1 - k)
		if not (try visited.get(s) otherwise panic("rpoDfs: visited.get OOB")) 'unvisited'
			try visited.set(s, value: true) otherwise panic("rpoDfs: visited.set OOB")
			stackNode.push(s)
			stackNextSucc.push(0)
		end 'unvisited'
	end 'dfs'
end 'rpoDfs'

// Build the CFG SKELETON: the block set, the dense numbering, and the edges. This is all the
// RPO reorder and the critical-edge split need, and it is deliberately all they can get — see
// `FuncTopology`. The allocator's `buildFuncCfg` adds the two analyses on top.
export function buildFuncTopology(module TargetModule, func IrFunction) returns FuncTopology
	var blockRefByLocal = BlockRefArray.create()
	var blockIdByLocal = CfgIndexArray.create()
	var maxBlockId = 0 as CfgIndex
	for blockRef in func.blockRefs 'eachRef'
		let block = try module.blocks.get(blockRef) otherwise panic("buildFuncTopology: blockRef {blockRef} from func.blockRefs not in module.blocks")
		blockRefByLocal.push(blockRef)
		blockIdByLocal.push(block.id)
		if block.id > maxBlockId 'higher'
			maxBlockId = block.id
		end 'higher'
	end 'eachRef'

	let numBlocks = blockRefByLocal.count()

	// BlockId -> local index; sentinel `numBlocks` marks an id not in this function.
	//
	// BlockIds must be UNIQUE within a function. This index is how every edge resolves its target,
	// so a duplicate id silently makes the LAST block with that id win — every branch to the first
	// one is then re-pointed at the second, and the CFG the allocator sees is not the CFG the
	// program has. Liveness, loop depth and pressure all follow it off a cliff, so the failure
	// surfaces far away (values from one loop appearing live inside another) and looks like an
	// allocator bug. Assert it here, at the one place the collision would be absorbed.
	var localByBlockId = filledColumn(maxBlockId + 1, value: numBlocks)
	for i in 0 upto numBlocks 'mapIds'
		let bid = try blockIdByLocal.get(i) otherwise panic("buildFuncTopology: blockIdByLocal.get OOB")
		let prior = try localByBlockId.get(bid) otherwise panic("buildFuncTopology: localByBlockId.get(bid) OOB")
		if prior != numBlocks 'duplicateId'
			panic("buildFuncTopology: function '{String.from(func.name)}' has TWO blocks with BlockId {bid} (local {prior} and local {i}) — BlockIds must be unique within a function, because every branch target resolves through this index and a duplicate silently re-points edges at the wrong block")
		end 'duplicateId'
		try localByBlockId.set(bid, value: i) otherwise panic("buildFuncTopology: localByBlockId.set(bid) OOB")
	end 'mapIds'

	// Edge list (fromLocal, toLocal), then CSR for succ and its inverse for pred.
	var edgeFrom = CfgIndexArray.create()
	var edgeTo = CfgIndexArray.create()
	// Scratch reused across every block. Created per block, this was one heap allocation per
	// block of every function — and the skeleton is built twice per function (the critical-edge
	// split, then the RPO reorder), so it was two per block per compile for a buffer that never
	// outlives its iteration. Same hoist-and-clear the pressure sweep's `ordered` uses.
	var succIds = BlockIdArray.create()
	for i in 0 upto numBlocks 'eachBlock'
		let block = try module.blocks.get(try blockRefByLocal.get(i) otherwise panic("buildFuncTopology: blockRefByLocal.get OOB")) otherwise panic("buildFuncTopology: block ref not in blocks")
		succIds.clear()
		collectBlockSuccessorIds(module, block: block, out: succIds)
		for sid in succIds 'eachSucc'
			let j = try localByBlockId.get(sid) otherwise panic("buildFuncTopology: successor block id {sid} out of id range")
			if j == numBlocks 'notInFunc'
				panic("buildFuncTopology: block '{String.from(block.label)}' branches to block id {sid} which is not in function '{String.from(func.name)}'")
			end 'notInFunc'
			edgeFrom.push(i)
			edgeTo.push(j)
		end 'eachSucc'
	end 'eachBlock'

	let succ = buildCsr(edgeFrom, to: edgeTo, nodeCount: numBlocks)
	let pred = buildCsr(edgeTo, to: edgeFrom, nodeCount: numBlocks)

	return FuncTopology.create(numBlocks, blockRefByLocal: blockRefByLocal, localByBlockId: localByBlockId, succ: succ, pred: pred)
end 'buildFuncTopology'

// Complete a topology into the CFG the ALLOCATOR consumes, by adding the two analyses only it
// needs: the function's value-space size (an operand scan of every op) and the per-block loop
// nesting depth (a DFS plus a BFS per natural loop).
//
// The topology is an ARGUMENT rather than something built here, so that the caller must have
// one already — which is the point: the RPO reorder has just built one, and its skeleton is
// still exactly this function's, so the allocator completes it instead of re-deriving it.
export function buildFuncCfg(module TargetModule, func IrFunction, topo FuncTopology) returns FuncCfg
	assertCondBranchIndicesComplete(module, func: func, topo: topo)
	let valueCount = scanFunctionValueCount(module, func: func)
	let loopDepth = computeLoopDepth(topo.succ, pred: topo.pred, numBlocks: topo.numBlocks)
	return FuncCfg.create(topo, loopDepth: loopDepth, valueCount: valueCount)
end 'buildFuncCfg'

// THE COMPLETENESS half of the `condBranch`-index invariant: assert, against the OPS, that every
// block's cached index names EXACTLY the conditional branches the block actually has. The O(1)
// half (`condBranchTargetOf`, below) checks the converse — that the op AT the recorded index IS a
// `jcc` — and the two together are what let the successor derivation ADDRESS a block's second
// branch instead of searching for it.
//
// WHY IT IS STILL NEEDED, given `IrModule`'s two O(1) guards. `appendCondBranch` refuses a SECOND
// conditional branch, and `appendOp` refuses to append anything PAST a recorded one — but neither
// can refuse the case this catches: `IrModule` is generic over `Op` and therefore cannot ask
// whether an op IS a conditional branch (its own comment says so), so `appendOp(block, jcc)` on a
// block that has not recorded one yet is accepted, silently. The `jcc`'s then-edge would then be
// missing from every CFG built from that block, and liveness, loop depth, pressure and spill
// placement would all follow a CFG the program does not have — surfacing far from the cause, as an
// allocator bug. `SplitLiveRanges` additionally mints its ops through its OWN append (append to
// `module.ops`, then `opRefs.insert`), which bypasses `IrModule.appendOp`'s guard entirely. This
// sweep is the only thing that makes the whole class unspellable rather than merely unlikely.
//
// WHERE IT RUNS. Here, once per function, on EVERY build — `buildFuncCfg` is the sole constructor
// of the CFG the allocator consumes, so the invariant is checked exactly where it is relied on.
// It is asymptotically free: `scanFunctionValueCount` beside it already walks every op of the
// function, so this adds one op-kind match per op and no new traversal.
function assertCondBranchIndicesComplete(module TargetModule, func IrFunction, topo FuncTopology)
	for local in 0 upto topo.numBlocks 'eachBlock'
		checkCondBranchIndex(module, block: blockAt(module, topo: topo, local: local), funcName: func.name)
	end 'eachBlock'
end 'assertCondBranchIndicesComplete'

// One block's half of the sweep. The index records only WHERE the branch is — what it TARGETS is
// always dereferenced from the op — so an in-place retarget (`retargetJcc`) has no cache to go
// stale, and the only things that CAN go wrong are the four this asserts.
function checkCondBranchIndex(module TargetModule, block IrBlock, funcName ByteArray)
	var seen = 0 as OpCount
	var seenIdx = 0 as OpIndex
	for opIdx in block.opRefs 'eachOp'
		let op = try module.ops.get(opIdx) otherwise panic("checkCondBranchIndex: opIdx {opIdx} not in module.ops")
		if opIsCondBranch(op) 'isCond'
			seen = seen + 1
			seenIdx = opIdx
		end 'isCond'
	end 'eachOp'

	if not block.hasCondBranchOp() 'recordsNone'
		if seen > 0 'unrecorded'
			panic("checkCondBranchIndex: '{String.from(funcName)}' block '{String.from(block.label)}' holds {seen} conditional-branch op(s) but records NONE — a conditional branch reached the block without IrModule.appendCondBranch, so its then-edge is missing from every CFG the allocator builds")
		end 'unrecorded'
		return
	end 'recordsNone'

	let recorded = block.condBranchIndex()
	if seen != 1 'notExactlyOne'
		panic("checkCondBranchIndex: '{String.from(funcName)}' block '{String.from(block.label)}' records a conditional branch at op {recorded} but its body holds {seen} conditional-branch op(s) — the index must name the one branch the block has")
	end 'notExactlyOne'
	if seenIdx != recorded 'stale'
		panic("checkCondBranchIndex: '{String.from(funcName)}' block '{String.from(block.label)}' records its conditional branch at op {recorded}, but the conditional branch in its body is op {seenIdx} — the recorded index is stale")
	end 'stale'

	// A conditional branch names only the THEN edge; the else edge is the unconditional-branch
	// terminator (`jmp` / `arm64Branch`). Without one, the block would contribute a single successor to
	// the CFG while branching two ways at run time.
	if not terminatorIsUnconditionalBranch(module, block: block) 'noBranchTerminator'
		panic("checkCondBranchIndex: '{String.from(funcName)}' block '{String.from(block.label)}' has a conditional branch but its terminator is not an unconditional branch — a conditional branch carries only the then-edge, so the else-edge has nowhere to come from")
	end 'noBranchTerminator'
end 'checkCondBranchIndex'

function opIsCondBranch(op TargetOp) returns bool
	return match op 'check'
		prologue to jmp gives false
		jcc gives true
		movRegImm to divideReg gives false
		pushReg to popReg gives false
		storeSlotReg to loadRegSlot gives false
		andRegReg to movqXmmGpr gives false
		// The arm64 conditional branches — a flag test (`arm64CondBranch`) or a register zero-test
		// (`arm64Cbz`/`arm64Cbnz`) — are the twins of `jcc`: each carries only the THEN edge, paired
		// with an `arm64Branch` terminator for the else edge. `arm64Ret`/`arm64Branch` and the ALU band
		// are not conditional branches.
		arm64Ret to arm64Branch gives false
		arm64CondBranch to arm64Cbnz gives true
		arm64MovImm to arm64Fcsel gives false
		// `leaRegFunc`/`callReg` (P1.5-A1) are a `lea` and a call, and the Linux `x64Syscall` a call —
		// none is a conditional branch.
		leaRegFunc to x64Syscall gives false
		// The jump tables are MULTIWAY terminators, not two-way conditional branches: their successors come
		// straight off the op (`collectBlockSuccessorIds`), not via a `condBranch`+`jmp` pairing.
		x64JumpTable to arm64JumpTable gives false
		// The witness call is a body op, not a conditional branch.
		callMem gives false
		// Both stack-argument ops are body ops, not branches.
		arm64StoreOutgoingArg to arm64LoadIncomingArg gives false
		// Both arm64 bit reinterpretations are body ops, not branches.
		arm64FmovGprFp to arm64FmovFpGpr gives false
		// A frame address is a body op, not a branch.
		leaRegSlot gives false
		// F1b: a fill ladder is a body op, not a branch — its branches are internal to its own encoding.
		x64MemFill to arm64MemFill gives false
		// F2: every atomic is a body op, not a branch — the arm64 retry loop's branches are internal to its own
		// encoding, exactly as the fill ladder's are.
		x64LockCmpxchg to arm64ThreadPointer gives false
		// EC16: every scaled-index form is a body op, not a branch.
		leaRegBaseIndexScale to arm64AddLsl gives false
	end 'check'
end 'opIsCondBranch'

// The block a terminator branches to UNCONDITIONALLY — `jmp` for x64, `arm64Branch` for arm64 — or
// `none` for a terminator that is neither (a `ret`, a multiway jump table, an op-less `dead` slot).
//
// ⭐ THE ONE ROSTER FOR "IS THIS THE ISA'S UNCONDITIONAL BRANCH, AND WHERE DOES IT GO?". Two callers
// need the two halves of that answer and neither may restate the arm list: `terminatorIsUnconditionalBranch`
// below wants only the yes/no (it is the else-edge carrier a `condBranch` must be paired with), and
// `X64BranchCleanup` wants the target (to compare it against the physically next block). A second
// enumeration of `TargetOp` would be a copy that goes stale at the next op added to the dialect.
export union UnconditionalBranchTarget
	none
	blockId(id BlockId)
end 'UnconditionalBranchTarget'

export function unconditionalBranchTargetOf(module TargetModule, block IrBlock) returns UnconditionalBranchTarget
	if not block.hasTerminatorOp() 'noTerm'
		return UnconditionalBranchTarget.none
	end 'noTerm'
	let op = try module.ops.get(block.terminatorIndex()) otherwise panic("unconditionalBranchTargetOf: terminator not in module.ops")
	return match op 'check'
		prologue to ret gives UnconditionalBranchTarget.none
		jmp(target) gives UnconditionalBranchTarget.blockId(target)
		jcc to divideReg gives UnconditionalBranchTarget.none
		pushReg to popReg gives UnconditionalBranchTarget.none
		storeSlotReg to loadRegSlot gives UnconditionalBranchTarget.none
		andRegReg to movqXmmGpr gives UnconditionalBranchTarget.none
		arm64Ret gives UnconditionalBranchTarget.none
		arm64Branch(target) gives UnconditionalBranchTarget.blockId(target)
		arm64CondBranch to arm64Fcsel gives UnconditionalBranchTarget.none
		// `leaRegFunc`/`callReg` (P1.5-A1) and the Linux `x64Syscall` are value-producing body ops,
		// never a terminator — so never the ISA's unconditional branch.
		leaRegFunc to x64Syscall gives UnconditionalBranchTarget.none
		// A jump table IS a terminator, but a MULTIWAY one — not the ISA's UNconditional single-target
		// branch that a `condBranch` op's else-edge needs, so `none` (a jump-table block records no
		// `condBranch`, so this is never consulted for one, but the classifier must be exhaustive).
		x64JumpTable to arm64JumpTable gives UnconditionalBranchTarget.none
		// The witness call is a body op, not an unconditional branch.
		callMem gives UnconditionalBranchTarget.none
		// Both stack-argument ops are body ops, not branches.
		arm64StoreOutgoingArg to arm64LoadIncomingArg gives UnconditionalBranchTarget.none
		// Both arm64 bit reinterpretations are body ops, not branches.
		arm64FmovGprFp to arm64FmovFpGpr gives UnconditionalBranchTarget.none
		// A frame address is a body op, not a branch.
		leaRegSlot gives UnconditionalBranchTarget.none
		// F1b: a fill ladder is a body op, not a branch — its branches are internal to its own encoding.
		x64MemFill to arm64MemFill gives UnconditionalBranchTarget.none
		// F2: every atomic is a body op, not a branch.
		x64LockCmpxchg to arm64ThreadPointer gives UnconditionalBranchTarget.none
		// EC16: every scaled-index form is a body op, not a branch.
		leaRegBaseIndexScale to arm64AddLsl gives UnconditionalBranchTarget.none
	end 'check'
end 'unconditionalBranchTargetOf'

// True iff the block's terminator is the ISA's UNCONDITIONAL branch — `jmp` for x64, `arm64Branch`
// for arm64. This is the else-edge carrier that must accompany a conditional branch (whose op names
// only the then-edge); without it a two-way block would contribute one CFG successor.
function terminatorIsUnconditionalBranch(module TargetModule, block IrBlock) returns bool
	return match unconditionalBranchTargetOf(module, block: block) 'check'
		none gives false
		blockId gives true
	end 'check'
end 'terminatorIsUnconditionalBranch'

// A block's successor BlockIds: the `jcc` conditional-branch op names the then-target; the
// `jmp` terminator names the (unconditional / else) target; `ret` names none.
//
// Every target here is read OFF THE OP — the ops are the ground truth for the CFG, and
// `branchEdges` are NOT a substitute (they exist only for phi-CARRYING edges, so a CFG
// derived from them would silently lose every non-phi edge). What the block caches is only
// WHERE its two control ops are (`condBranch`, `terminator`), never what they target, so an
// in-place retarget cannot leave a stale successor behind.
//
// That is the whole point: this used to find the `jcc` by SCANNING EVERY OP OF THE BLOCK,
// so building the CFG skeleton was a full pass over every op of the function — and the
// allocator builds one twice per function (the critical-edge split, then the RPO reorder).
// It is now O(1) per block, making a topology build O(blocks + edges).
// `checkCondBranchIndex` (above) asserts, against the ops, that the two indices name every
// branch the block actually has.
function collectBlockSuccessorIds(module TargetModule, block IrBlock, out BlockIdArray)
	if block.hasCondBranchOp() 'hasCond'
		let opIdx = block.condBranchIndex()
		let op = try module.ops.get(opIdx) otherwise panic("collectBlockSuccessorIds: conditional branch of block '{String.from(block.label)}' is op {opIdx}, which is not in module.ops")
		out.push(condBranchTargetOf(op, block: block))
	end 'hasCond'

	if block.hasTerminatorOp() 'hasTerm'
		let op = try module.ops.get(block.terminatorIndex()) otherwise panic("collectBlockSuccessorIds: terminator not in module.ops")
		match op 'termCtrl'
			jmp(target) then out.push(target)
			ret then break 'termCtrl'
			prologue to epilogue then panic("collectBlockSuccessorIds: block '{String.from(block.label)}' terminator is a frame op, not a branch/return")
			jcc then panic("collectBlockSuccessorIds: `jcc` reached as a terminator — it must be a body op paired with a `jmp` terminator")
			movRegImm to divideReg then panic("collectBlockSuccessorIds: block '{String.from(block.label)}' has a non-terminator op as its terminator")
			pushReg to popReg then panic("collectBlockSuccessorIds: block '{String.from(block.label)}' has a pushReg/popReg as its terminator — those are post-regalloc body ops")
			storeSlotReg to loadRegSlot then panic("collectBlockSuccessorIds: block '{String.from(block.label)}' has a spill/reload as its terminator — the splitter inserts them as body ops")
			andRegReg to movqXmmGpr then panic("collectBlockSuccessorIds: block '{String.from(block.label)}' has a non-terminator op as its terminator")
			// The arm64 terminators: `arm64Branch` names the (unconditional / else) target, `arm64Ret`
			// names none — the exact mirror of `jmp`/`ret`. The conditional branches
			// (`arm64CondBranch`/`arm64Cbz`/`arm64Cbnz`) are BODY ops paired with an `arm64Branch`
			// terminator (their then-target is read via `condBranchTargetOf`), never terminators here.
			arm64Ret then break 'termCtrl'
			arm64Branch(target) then out.push(target)
			arm64CondBranch to arm64Fcsel then panic("collectBlockSuccessorIds: block '{String.from(block.label)}' has a non-terminator arm64 op as its terminator")
			// `leaRegFunc`/`callReg` (P1.5-A1) and the Linux `x64Syscall` are value-producing x64 body
			// ops, never a terminator — the same non-terminator panic the x64 ALU/data bands above raise.
			leaRegFunc to x64Syscall then panic("collectBlockSuccessorIds: block '{String.from(block.label)}' has a non-terminator op as its terminator")
			callMem then panic("collectBlockSuccessorIds: block '{String.from(block.label)}' has a `callMem` (witness call) body op as its terminator")
			arm64StoreOutgoingArg to arm64LoadIncomingArg then panic("collectBlockSuccessorIds: block '{String.from(block.label)}' has a stack-argument body op as its terminator")
			arm64FmovGprFp to arm64FmovFpGpr then panic("collectBlockSuccessorIds: block '{String.from(block.label)}' has an arm64 general↔vector `fmov` (a bit reinterpretation) body op as its terminator")
			leaRegSlot then panic("collectBlockSuccessorIds: block '{String.from(block.label)}' has a `leaRegSlot` (a frame address) body op as its terminator")
			x64MemFill to arm64MemFill then panic("collectBlockSuccessorIds: block '{String.from(block.label)}' has a fill ladder body op as its terminator")
			x64LockCmpxchg to arm64ThreadPointer then panic("collectBlockSuccessorIds: block '{String.from(block.label)}' has an atomic or a thread-token read as its terminator")
			// A jump table's successors are every DISTINCT case target plus the default — see `pushJumpTableSuccessors`.
			x64JumpTable(_, defaultTarget, caseTargets, _) then pushJumpTableSuccessors(out, defaultTarget: defaultTarget, caseTargets: caseTargets)
			arm64JumpTable(_, defaultTarget, caseTargets, _) then pushJumpTableSuccessors(out, defaultTarget: defaultTarget, caseTargets: caseTargets)
			leaRegBaseIndexScale to arm64AddLsl then panic("collectBlockSuccessorIds: block '{String.from(block.label)}' has a scaled-index address or access body op as its terminator")
		end 'termCtrl'
	end 'hasTerm'
end 'collectBlockSuccessorIds'

// A jump table's successor set: every DISTINCT case-target block plus the default, each pushed ONCE. A
// dense table repeats a block across many slots (a range/`or` arm fills several), but the CFG has ONE edge
// per distinct successor — pushing a block per slot would inflate its predecessor degree and wrongly
// classify every fall-through edge into it as critical. The default is pushed first (it is always a
// successor — an out-of-range value reaches it), then each fresh case target in first-appearance order via
// the shared O(slots) `distinctSwitchTargets` (a per-slot linear membership scan here was O(slots ×
// distinct) — quadratic in the arm count of an all-distinct dense match, and this runs on every CFG build).
function pushJumpTableSuccessors(out BlockIdArray, defaultTarget BlockId, caseTargets BlockIdArray)
	out.push(defaultTarget)
	for target in distinctSwitchTargets(caseTargets, exclude: defaultTarget) 'eachDistinct'
		out.push(target)
	end 'eachDistinct'
end 'pushJumpTableSuccessors'

// The then-target of the op a block's `condBranch` names. Panics if it is not a `jcc`: the
// index names the block's conditional branch and nothing else, so any other op there means
// the index went stale or was set by something that is not a branch. This is the O(1) half
// of the invariant check — it fires on every CFG build, for every block that has a
// conditional branch, and needs no scan.
function condBranchTargetOf(op TargetOp, block IrBlock) returns BlockId
	match op 'cond'
		jcc(_, target) then return target
		// The arm64 conditional branches — a flag test (`arm64CondBranch`) or a register zero-test
		// (`arm64Cbz`/`arm64Cbnz`) — each names its then-target the same way the `jcc` does.
		arm64CondBranch(_, target) then return target
		arm64Cbz(_, target) then return target
		arm64Cbnz(_, target) then return target
		default panic("condBranchTargetOf: block '{String.from(block.label)}' records its conditional branch at op {block.condBranchIndex()}, but that op is not a `jcc`/`arm64CondBranch`/`arm64Cbz`/`arm64Cbnz`")
	end 'cond'
end 'condBranchTargetOf'

// The number of distinct value ids in the function (columns for the dense state):
// max id appearing as an op operand, block-arg, or branch-edge arg, plus one. A
// function always has at least a return value, so the count is never zero.
// The function's value space: one past the highest ValueId any of its blocks, edges or ops names.
// Exported because it is also the width the LOWERING's class column must cover — an INDEPENDENT count
// of the same value space, which is what lets `assertClassColumnCovers` catch a vreg minted without a
// class rather than read past the end of the column.
export function scanFunctionValueCount(module TargetModule, func IrFunction) returns ValueId
	var maxId = 0 as ValueId
	var buf = OperandList.create()
	for blockRef in func.blockRefs 'eachBlock'
		let block = try module.blocks.get(blockRef) otherwise panic("scanFunctionValueCount: blockRef not in module.blocks")

		for arg in block.blockArgs 'eachArg'
			maxId = maxOf(maxId, b: arg.valueId)
		end 'eachArg'
		for edge in block.branchEdges 'eachEdge'
			for argId in edge.argIds 'eachEdgeArg'
				maxId = maxOf(maxId, b: argId)
			end 'eachEdgeArg'
		end 'eachEdge'

		for opIdx in block.opRefs 'eachOp'
			let op = try module.ops.get(opIdx) otherwise panic("scanFunctionValueCount: opIdx not in module.ops")
			targetOpOperands(op, buf: buf)
			for o in buf 'eachOperand'
				if operandIsVirtual(o) 'virt'
					maxId = maxOf(maxId, b: operandValueId(o))
				end 'virt'
			end 'eachOperand'
		end 'eachOp'
	end 'eachBlock'
	return maxId + 1
end 'scanFunctionValueCount'

// ==========================================================================
// Loop structure (back edges -> natural loops -> per-block depth)
// ==========================================================================

// Per-block loop nesting depth. The CFG the structured parser emits is reducible,
// so every DFS retreating edge is a genuine back edge; each back edge's natural
// loop is the header plus every block that reaches the tail without leaving through
// the header. Back edges sharing a header (a loop with `continue`) form ONE loop.
function computeLoopDepth(succ CsrGraph, pred CsrGraph, numBlocks CfgIndex) returns LoopDepthArray
	var depth = LoopDepthArray.create()
	depth.resize(numBlocks)
	if numBlocks == 0 'empty'
		return depth
	end 'empty'

	var backTails = CfgIndexArray.create()
	var backHeads = CfgIndexArray.create()
	dfsBackEdges(succ, numBlocks: numBlocks, backTails: backTails, backHeads: backHeads)

	// NO BACK EDGE, NO LOOP — and that is MOST functions, so the header sweep's two columns are not
	// allocated for them. This is asked once per function on every build.
	if backHeads.count() == 0 'loopless'
		return depth
	end 'loopless'

	for h in distinctLoopHeaders(backHeads, numBlocks: numBlocks) 'eachLoop'
		let member = naturalLoopMembers(pred, header: h, backTails: backTails, backHeads: backHeads, numBlocks: numBlocks)
		for b in 0 upto numBlocks 'bump'
			let isMember = try member.get(b) otherwise panic("computeLoopDepth: member.get OOB")
			if isMember 'inLoop'
				let d = try depth.get(b) otherwise panic("computeLoopDepth: depth.get OOB")
				try depth.set(b, value: d + 1) otherwise panic("computeLoopDepth: depth.set OOB")
			end 'inLoop'
		end 'bump'
	end 'eachLoop'

	return depth
end 'computeLoopDepth'

// The blocks of the loop NEST enclosing `blockLocal` — the OUTERMOST natural loop that contains it,
// which is the UNION of every natural loop that does (in a reducible CFG two loops sharing a block are
// nested, so that family is a chain and its union is its largest member).
//
// ⭐ IT ANSWERS "WHICH LOOP", WHICH `loopDepth` STRUCTURALLY CANNOT. A depth column says how many loops
// a block is in, never WHICH — so a consumer holding only depths can ask no better question than "is
// this block in SOME loop", and every loop in the function answers yes. That is what the E5001
// diagnostic asked, and in a multi-loop function it therefore anchored its message on the earliest loop
// in the file whatever had actually overflowed (`RegisterPressureDiagnostic.collectRegionOps`).
//
// ⭐ WHY THE OUTERMOST AND NOT THE INNERMOST, for a peak inside a nest: a cold split's store is anchored
// at its value's DEF and must land at depth 0 (`assertPlacementLegal`), so relief at an inner peak
// requires the value to be idle across the WHOLE nest, not merely across the inner loop. The nest is
// therefore the region a peak's working set is measured over and the region its remedy has to be
// applied to, so it is the region the diagnostic names.
//
// It re-derives the back edges rather than reading a cached loop forest, because there is none: the
// allocator's own consumers need only depths, and building a forest for every function to serve a
// message that is emitted on a compile that is already failing would be a cost on every build. This
// costs the same shape as `computeLoopDepth` itself — one DFS plus one BFS per distinct header — and
// runs at most once per compile.
export function enclosingLoopBlocks(topo FuncTopology, blockLocal CfgIndex) returns BoolArray
	var backTails = CfgIndexArray.create()
	var backHeads = CfgIndexArray.create()
	dfsBackEdges(topo.succ, numBlocks: topo.numBlocks, backTails: backTails, backHeads: backHeads)

	var nest = BoolArray.create()
	nest.resize(topo.numBlocks)
	var found = false
	for h in distinctLoopHeaders(backHeads, numBlocks: topo.numBlocks) 'eachLoop'
		let member = naturalLoopMembers(topo.pred, header: h, backTails: backTails, backHeads: backHeads, numBlocks: topo.numBlocks)
		let holdsBlock = try member.get(blockLocal) otherwise panic("enclosingLoopBlocks: member.get OOB for block {blockLocal}")
		if not holdsBlock 'otherLoop'
			continue
		end 'otherLoop'

		found = true
		for b in 0 upto topo.numBlocks 'union'
			let isMember = try member.get(b) otherwise panic("enclosingLoopBlocks: member.get OOB")
			if isMember 'inLoop'
				try nest.set(b, value: true) otherwise panic("enclosingLoopBlocks: nest.set OOB")
			end 'inLoop'
		end 'union'
	end 'eachLoop'

	if not found 'notInAnyLoop'
		panic("enclosingLoopBlocks: block local {blockLocal} is in no natural loop — the caller asked for its enclosing nest, so it read a non-zero loop depth for it, and the two derivations come from the same back edges and cannot disagree")
	end 'notInAnyLoop'

	return nest
end 'enclosingLoopBlocks'

// The distinct natural-loop HEADERS, in back-edge discovery order. Back edges sharing a header (a loop
// with `continue`, whose every `continue` is one) name ONE loop, so a header must be answered once:
// `computeLoopDepth` would otherwise count that loop's nesting twice, and `enclosingLoopBlocks` would
// re-walk its member set once per back edge.
function distinctLoopHeaders(backHeads CfgIndexArray, numBlocks CfgIndex) returns CfgIndexArray
	var headers = CfgIndexArray.create()
	var seen = BoolArray.create()
	seen.resize(numBlocks)
	for k in 0 upto backHeads.count() 'eachBackEdge'
		let h = try backHeads.get(k) otherwise panic("distinctLoopHeaders: backHeads.get OOB")
		let already = try seen.get(h) otherwise panic("distinctLoopHeaders: seen.get OOB")
		if already 'sameLoop'
			continue
		end 'sameLoop'
		try seen.set(h, value: true) otherwise panic("distinctLoopHeaders: seen.set OOB")
		headers.push(h)
	end 'eachBackEdge'
	return headers
end 'distinctLoopHeaders'

// Depth-first search from the ENTRY block, recording every RETREATING edge (an edge to a GRAY — still-
// open — node), which in a reducible CFG is exactly a back edge. The root is block 0 by construction
// (`FuncTopology` is built in RPO from the entry), and the visit colours are scratch nothing outside
// this walk reads, so neither is a parameter.
//
// ITERATIVE, with an explicit stack, because the recursive form recursed once per block and
// SEGFAULTED the compiler on a large function: a 19,200-block function overflowed the native stack
// before it could be allocated. Depth here is bounded by the block count, and a generated or
// heavily-branching function reaches thousands of blocks easily, so recursion is simply not
// available. (`naturalLoopMembers`, `blocksReachableFromPeak` and the SSA liveness walk are all
// worklist-driven for the same reason.)
//
// The stack holds a (node, next-successor-index) pair per open node — the explicit form of a
// recursive call's resume point — so a node turns BLACK only once every successor has been visited,
// which is what makes the GRAY test mean "still on the current DFS path".
function dfsBackEdges(succ CsrGraph, numBlocks CfgIndex, backTails CfgIndexArray, backHeads CfgIndexArray)
	var colors = DfsColorArray.create()
	colors.resize(numBlocks)
	var stackNode = CfgIndexArray.create()
	var stackNextSucc = CfgIndexArray.create()

	let root = 0 as CfgIndex
	try colors.set(root, value: DfsGray) otherwise panic("dfsBackEdges: colors.set(root) OOB")
	stackNode.push(root)
	stackNextSucc.push(0)

	while stackNode.count() > 0 'dfs'
		let top = stackNode.count() - 1
		let u = try stackNode.get(top) otherwise panic("dfsBackEdges: stackNode.get OOB")
		let k = try stackNextSucc.get(top) otherwise panic("dfsBackEdges: stackNextSucc.get OOB")

		if k >= succ.degree(u) 'exhausted'
			// Every successor visited — close the node and resume its parent.
			try colors.set(u, value: DfsBlack) otherwise panic("dfsBackEdges: colors.set black OOB")
			_ = try stackNode.pop() otherwise panic("dfsBackEdges: stackNode.pop on non-empty failed")
			_ = try stackNextSucc.pop() otherwise panic("dfsBackEdges: stackNextSucc.pop on non-empty failed")
			continue
		end 'exhausted'

		try stackNextSucc.set(top, value: k + 1) otherwise panic("dfsBackEdges: stackNextSucc.set OOB")

		let v = succ.neighbour(u, k: k)
		let c = try colors.get(v) otherwise panic("dfsBackEdges: colors.get OOB")
		if c == DfsWhite 'unvisited'
			try colors.set(v, value: DfsGray) otherwise panic("dfsBackEdges: colors.set gray OOB")
			stackNode.push(v)
			stackNextSucc.push(0)
		end 'unvisited' else if c == DfsGray 'retreating'
			backTails.push(u)
			backHeads.push(v)
		end 'retreating'
	end 'dfs'
end 'dfsBackEdges'

// Membership of the natural loop of `header` (the union over all back edges targeting `header`): the
// header, plus everything reaching a tail through predecessors without passing back through the
// header. One entry per block, so a caller reads it as a set of blocks.
function naturalLoopMembers(pred CsrGraph, header CfgIndex, backTails CfgIndexArray, backHeads CfgIndexArray, numBlocks CfgIndex) returns BoolArray
	var member = BoolArray.create()
	member.resize(numBlocks)
	try member.set(header, value: true) otherwise panic("naturalLoopMembers: member.set(header) OOB")

	var worklist = CfgIndexArray.create()
	for k in 0 upto backHeads.count() 'seedTails'
		let h = try backHeads.get(k) otherwise panic("naturalLoopMembers: backHeads.get OOB")
		if h != header 'otherLoop'
			continue
		end 'otherLoop'
		let t = try backTails.get(k) otherwise panic("naturalLoopMembers: backTails.get OOB")
		let isMember = try member.get(t) otherwise panic("naturalLoopMembers: member.get(t) OOB")
		if not isMember 'newTail'
			try member.set(t, value: true) otherwise panic("naturalLoopMembers: member.set(t) OOB")
			worklist.push(t)
		end 'newTail'
	end 'seedTails'

	while worklist.count() > 0 'bfs'
		let n = try worklist.pop() otherwise panic("naturalLoopMembers: worklist.pop on non-empty failed")
		let deg = pred.degree(n)
		for k in 0 upto deg 'eachPred'
			let p = pred.neighbour(n, k: k)
			let isMember = try member.get(p) otherwise panic("naturalLoopMembers: member.get(p) OOB")
			if not isMember 'newMember'
				try member.set(p, value: true) otherwise panic("naturalLoopMembers: member.set(p) OOB")
				worklist.push(p)
			end 'newMember'
		end 'eachPred'
	end 'bfs'

	return member
end 'naturalLoopMembers'

// ==========================================================================
// Liveness by SSA PATH EXPLORATION — no fixpoint, no local sets
// ==========================================================================
//
// This REPLACES the classic iterative dataflow fixpoint (`liveIn = use ∪ (liveOut ∖ def)`, swept to
// convergence over `blocks × values` bitsets). The fixpoint is the wrong algorithm for an SSA
// program, and it was the last superlinear term in register allocation: it re-swept every block's
// FULL value-space row every round, so a function with 9,600 blocks and 6,400 values touched 100
// words per block per round — even when only ONE value was ever live. It cost ~60% of allocation.
//
// **In strict SSA the def DOMINATES every use, so liveness needs no iteration at all.** A value is
// live exactly on the CFG paths running backward from each of its uses up to its (single) def. Cost is
// therefore O(size of the liveness information itself), not O(blocks × values) — the pathological
// function above does almost no work, because almost nothing is live.
//
// The walk is `LivenessMarkScratch.walkValue`, which states it in full — and which is also what the
// SPLITTER runs to move one value's range after a split, because there is exactly one implementation
// and it is the same one.
//
// It returns the number of block-marking steps — the honest cost counter, replacing the fixpoint's
// iteration count (which no longer exists).

// What reads a value at a use site.
//
//  • `op` — an ordinary operand of an op in the block's body.
//  • `edge` — a branch-edge ARG (a phi operand). It is read on the EDGE, i.e. after every body op
//    of the predecessor: SSA destruction materializes it as a parallel copy at the predecessor's
//    end. An edge arg is therefore a genuine use, and one the cold-spill splitter MUST rewrite — a
//    reload that fixes up only the op uses leaves the edge still naming the ORIGINAL value, which
//    keeps that original live to the block's end. It would then STILL be live across the peak, the
//    spill would not lower the pressure there, and the splitter would re-pick the same value
//    forever. This is the exact shape of every loop-carried accumulator (`sum = sum + f(i)`), so it
//    is the common case, not a corner.
export enum UseKind
	op
	edge
end 'UseKind'

// Where a value comes into existence — the ONE classification unifying the two ways a Target value is
// defined, so the liveness walk's stop test, the splitter's store anchor, and its spillability gate
// cannot drift on it.
//
//  • `opDef`  — an ordinary operand write, at a known op in a known block (`requireDefOp`, `defBlockOf`).
//  • `phiDef` — a block-arg. Its def is its block's ENTRY (`defBlockOf`): it arrives in its register via
//    the edge copies SSA destruction places at the predecessors' ends, so there is no op to point at.
//
// Every value in a function is one or the other, so `none` means it is not defined here at all.
//
// ⚠ AN ENUM, AND IT USED TO BE A PAYLOAD-CARRYING UNION — the same change `OpSlotRole` made against the
// same cost, for the same reason. Maxon heap-boxes EVERY value of a payload-carrying union, `none`
// included, and this is asked of EVERY VALUE CROSSING THE PEAK, at EVERY SPLIT: `isRematerializable`,
// `hasStoreAnchor` and `storeFitsPool` each ask it once per candidate, so a block holding Θ(N) live
// values across Θ(N) splits paid Θ(N²) HEAP ALLOCATIONS to read a three-way tag. MEASURED on
// `genwidelive 400 sum`: ~0.5 allocations per candidate per split, 80,000 of the splitter's 106,000
// allocations at N=400, growing ×3.6 then ×3.8 over a doubling ladder. The PAYLOAD is read only where
// the tag has already said there is one — exactly as `slotOfSlotOp` is reached only behind `slotRoleOf`.
export enum ValueDefKind
	none
	opDef
	phiDef
end 'ValueDefKind'

// The stack slot a value has already been spilled into, or `none` for a value no `storeSlotReg`
// writes. A union rather than a sentinel index — slot 0 is a real slot and would be
// indistinguishable from "not spilled".
//
// The splitter reads this to relieve a value at a SECOND peak: the value's store is anchored at
// its DEF, which dominates every reload wherever it lands, so a second relief adds only reloads
// out of the slot the first one already wrote. Re-storing it would burn a second slot writing a
// value the first store already wrote.
export union ValueSpillSlot
	none
	slot(slot SpillSlot)
end 'ValueSpillSlot'

// THE function's per-value index: every question the allocator asks about a value, answered from a
// dense column or one short list instead of a walk of the function.
//
// Built in ONE pass over the function (`buildUseIndex`) and consumed by BOTH clients:
//
//  • the SSA liveness walk, which asks which BLOCKS read a value and where its def is;
//  • the cold-spill splitter, which asks all of that plus the op and the layout SEQUENCE of each
//    use, and the handful of per-value flags its victim-eligibility gates test.
//
// It is ONE index because those are one traversal of the function. The splitter previously answered
// every one of its questions with its own walk — per candidate value, per split — which made it
// O(candidates × blocks × ops) per split and 61% of register allocation whenever it ran.
//
// It is EDITABLE, which is the other half of that. A split changes almost nothing about a function —
// one value's live range shrinks, a few reload ids appear, a few ops are inserted into a few blocks —
// so an index that could only be REBUILT made the splitter pay O(function) to learn O(1) of new facts,
// once per split. Every representation choice below (the append-only record columns, the per-value and
// per-block record lists, the growable value-space columns) is there so the edits a split makes cost
// what a split changed.
//
// USE granularity is per-OP, not per-operand: an op reading a value twice yields ONE use site, and a
// block passing a value to several phis (or on several edges) yields ONE edge use, emitted LAST for
// that block at the terminator's sequence number — where the edge is genuinely read. That is the
// granularity a split's before/after-the-peak partition is stated in, and it is strictly less work
// for the liveness walk, whose memo would have discarded the duplicates anyway.
export type UseIndex
	export var valueCount as ValueId
	export var numBlocks as CfgIndex
	// Layout-ordered op count: body ops + terminators, over all blocks. A COUNT, not a bound on the
	// sequence space — sequence numbers are block-relative and sparse (see `seqAt`), so the two are
	// no longer the same number. This one bounds the splitter's runaway check; `seqLimit` is what
	// Belady's "no later use" sentinel needs.
	export var opCount as OpSeq
	// Strictly greater than every sequence number this function can produce (`seqLimitFor`).
	export var seqLimit as OpSeq

	// THE RECORD ARENA. A RECORD is one (op, value) use site. Its INDEX into these columns is its
	// identity, and the two threads below are what address it.
	//
	// The columns are APPEND-ONLY. `removeUseRecordsOf` unthreads a record and leaves the arena alone:
	// compacting it would renumber every later record, and renumbering the function to drop one use is
	// exactly the O(function) edit this representation exists to avoid.
	//
	// There is no `useBlock` column: a record's BLOCK is `useSeq / SeqStride` (see `seqAt` — a sequence
	// number IS `block × SeqStride + position`). Storing it as well would be storing the same fact twice
	// and leaving room for the two to disagree.
	var useOpIdx as OpIndexArray
	var useSeq as OpSeqArray
	var useOnEdge as BoolArray

	// THE TWO THREADS. Each record is on exactly two singly-linked lists — its VALUE's and its BLOCK's —
	// and both are threaded INTRUSIVELY through flat integer columns: `nextUseOfValue[r]` is the record
	// after `r` on its value's thread, `nextUseInBlock[r]` the record after `r` on its block's.
	//
	// **Flat columns, not an array of arrays.** One heap `Array` per VALUE would be a heap allocation
	// per value per liveness build, and the driver still builds liveness once per split — that is
	// `splits × values` allocations, which makes the quadratic BIGGER in the name of enabling its
	// removal. (Measured, and this is why the shape is what it is: an `Array`-per-value cost +16.8M
	// allocations and +15% compile time at scale rung 5.) A list per BLOCK is affordable — blocks are
	// comparatively few, which is why `LiveSets` is an array of arrays and this is not. Threading costs
	// NOTHING per value: six integer columns for the whole function, and `growTo` is a `resize`.
	//
	// **A value's thread is CIRCULAR and ASCENDING BY SEQUENCE, and the order is a contract**, not an
	// accident of the build: consumers stop at the first record they want (`nextUseAfterPeak` returns the
	// FIRST use past the peak; the before/after-the-peak partition is a prefix and a suffix), so a record
	// out of order is a wrong ANSWER, not a slow one. Order is kept by APPENDING AT THE TAIL, and
	// `buildUseIndex` records uses in layout order, so it comes for free. `addUseRecord` PANICS on a
	// record that would land out of order rather than accept it silently; a split REBUILDS a value's
	// thread (`removeUseRecordsOf`, then re-add in layout order) instead of inserting into the middle.
	//
	// Only the TAIL is stored, because the thread is circular: the head is `nextUseOfValue[tail]`. A
	// circular list knows where it starts from where it ends, so a head column would be a second copy of
	// a fact already there.
	var useCountOfValue as UseOrdinalArray
	var lastUseOfValue as UseRecordIndexArray
	var nextUseOfValue as UseRecordIndexArray

	// The BLOCK thread. This is the index an op INSERT needs: a sequence number is
	// `block × SeqStride + position`, so inserting an op at position `p` of block `b` shifts the
	// position of every op after it IN `b` and of nothing anywhere else — but that still restates the
	// sequence number of every use record sited in `b` past `p`. Without this thread, finding those
	// records means scanning the function's uses; with it, the repair costs only the block that changed.
	//
	// It is UNORDERED, which is why it is pushed at the HEAD and needs no tail column: nothing asks a
	// block for its first use, only for all of them.
	//
	// ⚠ It holds every record ever SITED in the block, including ones `removeUseRecordsOf` has detached
	// from their value. That is deliberate, and it is what the thread is for — REPAIRING SEQUENCE
	// NUMBERS, which there is no point doing selectively. It is NOT an answer to "who uses what in this
	// block": a detached record still names the op it used to be read at. Nothing can currently mistake
	// one for a live use, because no record carries its value and no walk of this thread reaches one —
	// but a consumer that wants the LIVE uses of a block would need a per-record liveness flag, which
	// does not exist because nothing needs it yet.
	var useCountInBlock as UseOrdinalArray
	var firstUseInBlock as UseRecordIndexArray
	var nextUseInBlock as UseRecordIndexArray

	// Def site: an op def (`hasOpDef` + where), a phi (`isPhi` + its block), or neither.
	var hasOpDef as BoolArray
	var defOpIdx as OpIndexArray
	var defOpBlock as CfgIndexArray
	var isPhi as BoolArray
	var phiBlock as CfgIndexArray

	// Passed to a phi on some branch edge.
	var edgePassed as BoolArray
	// Some `storeSlotReg` already spills THIS id — an earlier splitter iteration split it and wrote it
	// out. It is the tier-2 discriminator ONLY (`isSpillVictim` routes such a value to tier 4's
	// reloads-only relief); what a spill needs to know about the STORE it is about to emit is
	// `slotResident` below, which is a strictly wider set.
	var spillStored as BoolArray
	// MEMORY ALREADY HOLDS THIS VALUE, and the slot it is in. True for a stored value AND for a
	// RELOAD's destination: `loadRegSlot(f, slot: s)` means `f` IS the content of slot `s`, so slot `s`
	// still holds `f` afterwards and a further relief of `f` needs no store at all — only more loads,
	// out of that same slot.
	//
	// ⚠ WITHOUT THE RELOAD HALF, EVERY RE-SPLIT OF A RELOAD WRITES MEMORY BACK TO MEMORY. The fresh id
	// a split mints had no `storeSlotReg` of its own, so the next split treated it as a FIRST spill:
	// it emitted `loadRegSlot rcx, slot22` / `storeSlotReg slot23, rcx` — a value copied out of one
	// stack slot straight into another — and burned a second 8-byte slot on the same value. 36
	// committed goldens carried that pair.
	//
	// ⚠ IT IS SOUND BECAUSE A SLOT BELONGS TO ONE LINEAGE. `slotForSpillOf` hands back an existing slot
	// only to a value already resident in it, and `nextSlot` only ever increments — so the only writer
	// of slot `s` is the def-anchored store of the value the lineage started from. That store dominates
	// the `loadRegSlot` that defines `f` (it is at the def, and the def dominates every use by Rule 1),
	// hence it dominates every reload of `f` placed at one of `f`'s uses.
	var slotResident as BoolArray
	var spillSlot as SpillSlotArray
	// Appears as an operand — def OR use — of an op in a block at loop depth > 0.
	var touchesLoop as BoolArray

	// An EMPTY index over a `valueCount`-value, `numBlocks`-block function — the shape `buildUseIndex`
	// fills in place, through the very same mutators a split edits it with.
	static function create(valueCount ValueId, numBlocks CfgIndex) returns UseIndex
		return Self{valueCount: valueCount, numBlocks: numBlocks, opCount: 0 as OpSeq, seqLimit: seqLimitFor(numBlocks), useOpIdx: OpIndexArray.create(), useSeq: OpSeqArray.create(), useOnEdge: BoolArray.create(), useCountOfValue: zeroColumn(valueCount), lastUseOfValue: zeroColumn(valueCount), nextUseOfValue: UseRecordIndexArray.create(), useCountInBlock: zeroColumn(numBlocks), firstUseInBlock: zeroColumn(numBlocks), nextUseInBlock: UseRecordIndexArray.create(), hasOpDef: falseColumn(valueCount), defOpIdx: zeroColumn(valueCount), defOpBlock: zeroColumn(valueCount), isPhi: falseColumn(valueCount), phiBlock: zeroColumn(valueCount), edgePassed: falseColumn(valueCount), spillStored: falseColumn(valueCount), slotResident: falseColumn(valueCount), spillSlot: zeroColumn(valueCount), touchesLoop: falseColumn(valueCount)}
	end 'create'

	// How many use sites `valueId` has — the BOUND of the walk below, and the only thing that says a
	// thread is empty (there is no end-of-list sentinel; see the fields).
	export function useCount(valueId ValueId) returns UseOrdinal
		return try self.useCountOfValue.get(valueId) otherwise panic("UseIndex.useCount: value {valueId} out of range (valueCount={self.valueCount})")
	end 'useCount'

	// Value `valueId`'s FIRST use record — the earliest by sequence, and the head of its thread, which
	// a circular list holds one step past its tail. Walk the rest with `nextUseOf`, `useCount` times:
	//
	//     let useSites = index.useCount(v)
	//     if useSites > 0 'used'
	//         var record = index.firstUseOf(v)
	//         for _ in 0 upto useSites 'eachUse'
	//             …
	//             record = index.nextUseOf(record)
	//         end 'eachUse'
	//     end 'used'
	//
	// It PANICS on a value with no uses rather than hand back a sentinel to be tested: the COUNT is the
	// emptiness test, and a caller that walks without it is asking for the first of nothing.
	export function firstUseOf(valueId ValueId) returns UseRecordIndex
		if self.useCount(valueId) == 0 'neverUsed'
			panic("UseIndex.firstUseOf: value {valueId} has no uses — walks are bounded by useCount()")
		end 'neverUsed'
		let tail = try self.lastUseOfValue.get(valueId) otherwise panic("UseIndex.firstUseOf: lastUseOfValue.get OOB for value {valueId}")
		return self.nextUseOf(tail)
	end 'firstUseOf'

	// The record after `record` on its VALUE's thread. The thread is circular, so stepping off the last
	// record hands back the first — harmless, because a walk is bounded by `useCount` and stops before
	// it can look at what the wrap returned.
	export function nextUseOf(record UseRecordIndex) returns UseRecordIndex
		return try self.nextUseOfValue.get(record) otherwise panic("UseIndex.nextUseOf: use record {record} out of range")
	end 'nextUseOf'

	// How many use records are sited in `blockLocal` — the bound of the block walk. It counts every
	// record ever sited there, including ones detached from their value (see the fields).
	export function blockUseCount(blockLocal CfgIndex) returns UseOrdinal
		return try self.useCountInBlock.get(blockLocal) otherwise panic("UseIndex.blockUseCount: block {blockLocal} out of range (numBlocks={self.numBlocks})")
	end 'blockUseCount'

	// The head of `blockLocal`'s record thread; walk the rest with `nextUseInBlockOf`, `blockUseCount`
	// times, exactly as `firstUseOf` / `nextUseOf` walk a value's. Panics on a block with no records.
	export function firstUseInBlockOf(blockLocal CfgIndex) returns UseRecordIndex
		if self.blockUseCount(blockLocal) == 0 'noUses'
			panic("UseIndex.firstUseInBlockOf: block {blockLocal} has no use records — walks are bounded by blockUseCount()")
		end 'noUses'
		return try self.firstUseInBlock.get(blockLocal) otherwise panic("UseIndex.firstUseInBlockOf: firstUseInBlock.get OOB for block {blockLocal}")
	end 'firstUseInBlockOf'

	// The record after `record` on its BLOCK's thread. The last record's entry points at ITSELF, which
	// a `blockUseCount`-bounded walk never follows — the same discipline as `nextUseOf`.
	export function nextUseInBlockOf(record UseRecordIndex) returns UseRecordIndex
		return try self.nextUseInBlock.get(record) otherwise panic("UseIndex.nextUseInBlockOf: use record {record} out of range")
	end 'nextUseInBlockOf'

	// The block a use is sited in — DERIVED from its sequence number, not stored (see the arena).
	export function useBlockAt(record UseRecordIndex) returns CfgIndex
		return self.useSeqAt(record) / SeqStride
	end 'useBlockAt'

	// The `collectBlockOps` POSITION a use sits at within its block — derived from its sequence number
	// exactly as `useBlockAt` is, and by the same identity: a number IS `block × SeqStride + position`,
	// so this is literally `seqAt` read backwards.
	//
	// It is what lets a splitter anchor a reload without SEARCHING its block for the anchor op. That
	// search was O(block) at every single reload, so a split placing K of them into one block cost
	// Θ(K × block) — while the answer was sitting in the record that asked for the reload. It is exact
	// only while nothing has moved, which is precisely the window a split materializes in: the
	// insertions are held back and every position it computes is stated in the block's PRE-SPLIT
	// layout (see `SplitEdits`).
	//
	// A position EQUAL to the block's `opRefs` count is the block's TERMINATOR — `collectBlockOps`
	// numbers it one past the body, and every EDGE use is anchored there.
	export function usePosAt(record UseRecordIndex) returns BlockOpPos
		return self.useSeqAt(record) - self.useBlockAt(record) * SeqStride
	end 'usePosAt'

	// The op the use reads through; for an EDGE use, the block's LAST op (its sequence anchor —
	// the edge is read after every body op).
	export function useOpAt(record UseRecordIndex) returns OpIndex
		return try self.useOpIdx.get(record) otherwise panic("UseIndex.useOpAt: use record {record} out of range")
	end 'useOpAt'

	export function useSeqAt(record UseRecordIndex) returns OpSeq
		return try self.useSeq.get(record) otherwise panic("UseIndex.useSeqAt: use record {record} out of range")
	end 'useSeqAt'

	export function useKindAt(record UseRecordIndex) returns UseKind
		let onEdge = try self.useOnEdge.get(record) otherwise panic("UseIndex.useKindAt: use record {record} out of range")
		return UseKind.edge if onEdge else UseKind.op
	end 'useKindAt'

	// True iff `valueId` is a block-arg (phi) of any block in the function.
	export function isPhiValue(valueId ValueId) returns bool
		return try self.isPhi.get(valueId) otherwise panic("UseIndex.isPhiValue: value {valueId} out of range")
	end 'isPhiValue'

	// True iff `valueId` is passed to a phi on some branch edge (a use on an edge, not at an op).
	export function isEdgePassed(valueId ValueId) returns bool
		return try self.edgePassed.get(valueId) otherwise panic("UseIndex.isEdgePassed: value {valueId} out of range")
	end 'isEdgePassed'

	// True iff some `storeSlotReg` already spills `valueId` — the tier-2 discriminator. Ask
	// `isSlotResident` instead when the question is "must this spill emit a store?".
	export function hasSpillStore(valueId ValueId) returns bool
		return try self.spillStored.get(valueId) otherwise panic("UseIndex.hasSpillStore: value {valueId} out of range")
	end 'hasSpillStore'

	// True iff memory already holds `valueId` — it was stored, or it IS a reload's destination (see
	// `slotResident`). A spill of such a value emits reloads only.
	export function isSlotResident(valueId ValueId) returns bool
		return try self.slotResident.get(valueId) otherwise panic("UseIndex.isSlotResident: value {valueId} out of range")
	end 'isSlotResident'

	// The slot memory already holds `valueId` in, or `none` (see `ValueSpillSlot`).
	export function spillSlotOf(valueId ValueId) returns ValueSpillSlot
		if not self.isSlotResident(valueId) 'notInASlot'
			return ValueSpillSlot.none
		end 'notInASlot'
		return ValueSpillSlot.slot(try self.spillSlot.get(valueId) otherwise panic("UseIndex.spillSlotOf: spillSlot.get OOB for value {valueId}"))
	end 'spillSlotOf'

	// True iff `valueId`'s def block and every block that touches it — as an OP OPERAND *or* as a
	// BRANCH-EDGE ARG — are at loop depth 0, which is exactly the shape a COLD spill needs: the store
	// after its def and every reload before an after-peak use then lie outside every loop.
	//
	// ⚠ **THE EDGE HALF USED TO BE MISSING HERE AND MADE UP FOR BY A BLANKET BAR**, and that bar was a
	// FALSE E5001 generator. `isColdSpillable` refused every edge-passed value outright — the only safe
	// reading available while this column saw op operands only — so a value merely handed across a
	// depth-0 `if` join (which is what EVERY `var` assigned in one arm of a branch is) counted as part
	// of the working set of an unrelated loop it never touched. MEASURED on `stdlib/URL.maxon`'s
	// `URL.parse`: 23 values "must be held in registers at once inside this loop", NINETEEN of them
	// used ZERO times in it. The fact a cold spill actually needs is a DEPTH, and a depth is what this
	// column now holds for both kinds of use.
	export function defAndUsesAtDepthZero(valueId ValueId) returns bool
		return not (try self.touchesLoop.get(valueId) otherwise panic("UseIndex.defAndUsesAtDepthZero: value {valueId} out of range"))
	end 'defAndUsesAtDepthZero'

	// WHICH of the two ways `valueId` is defined, or `none` — a tag, never a boxed payload (see
	// `ValueDefKind`). The payload accessors below are reached only behind it.
	export function defKindOf(valueId ValueId) returns ValueDefKind
		let opDefined = try self.hasOpDef.get(valueId) otherwise panic("UseIndex.defKindOf: value {valueId} out of range")
		if opDefined 'opDefined'
			return ValueDefKind.opDef
		end 'opDefined'
		return ValueDefKind.phiDef if self.isPhiValue(valueId) else ValueDefKind.none
	end 'defKindOf'

	// The block a value is defined in (an op def's block, or a phi's own block); panics for a value
	// this function does not define at all.
	export function defBlockOf(valueId ValueId) returns CfgIndex
		match self.defKindOf(valueId) 'kind'
			opDef then return try self.defOpBlock.get(valueId) otherwise panic("UseIndex.defBlockOf: defOpBlock.get OOB for value {valueId}")
			phiDef then return try self.phiBlock.get(valueId) otherwise panic("UseIndex.defBlockOf: phiBlock.get OOB for value {valueId}")
			none then panic("UseIndex.defBlockOf: value {valueId} has neither an op def nor a phi block")
		end 'kind'
	end 'defBlockOf'

	// The block a value is defined in, or `numBlocks` when this function does not define it — the
	// liveness walk's stop test, which must terminate on a value it never sees a def for rather than
	// panic (an undefined value is simply live all the way up to the entry).
	export function defBlockOrNone(valueId ValueId) returns CfgIndex
		if self.defKindOf(valueId) == ValueDefKind.none 'notDefinedHere'
			return self.numBlocks
		end 'notDefinedHere'
		return self.defBlockOf(valueId)
	end 'defBlockOrNone'

	// The module op index of the value's def, panicking if absent (callers have already established
	// the value has an op def).
	export function requireDefOp(valueId ValueId) returns OpIndex
		match self.defKindOf(valueId) 'kind'
			opDef then return try self.defOpIdx.get(valueId) otherwise panic("UseIndex.requireDefOp: defOpIdx.get OOB for value {valueId}")
			phiDef then panic("UseIndex.requireDefOp: value {valueId} is a phi, not an op def")
			none then panic("UseIndex.requireDefOp: value {valueId} has no op def")
		end 'kind'
	end 'requireDefOp'

	// ----------------------------------------------------------------------
	// EDITS — what a split changes, and nothing else
	// ----------------------------------------------------------------------
	//
	// The index is built through these and edited through these. Building it through its own mutators
	// is not tidiness: it is what keeps them honest. Every compile of the compiler threads every use
	// record through `addUseRecord`, so a bug in the threading is a wrong program at once — not a wrong
	// program only in the functions that happen to overflow their register pool and split.

	// Count `n` more ops into the function's op total (`opCount`). `buildUseIndex` counts each block's
	// ops as it walks; a split that INSERTS ops raises it, which is why it is added to rather than
	// handed to the constructor.
	export function addOps(n OpSeq)
		self.opCount = self.opCount + n
	end 'addOps'

	// Append a use record to the arena and thread it onto BOTH lists — its value's and its block's.
	// O(1), and it allocates nothing but the six flat column pushes.
	//
	// It APPENDS at each tail, which is why the value threads come out ascending by sequence for free:
	// `buildUseIndex` records uses in layout order, and a split rebuilds a value's thread in layout
	// order too (`removeUseRecordsOf`, then re-add). An append that would land OUT of order is a bug in
	// the caller, not a case to handle, so it panics — silently accepting it would give
	// `nextUseAfterPeak` a wrong answer, not a slow one.
	//
	// EQUAL sequence numbers are legal and do occur: an op use and an edge use of the same value in the
	// same block both sit at the terminator's sequence number. The append keeps them in insertion order,
	// so the op use stays first — which is right, because the edge is read after every body op.
	export function addUseRecord(valueId ValueId, blockLocal CfgIndex, opIdx OpIndex, seq OpSeq, onEdge bool)
		if seq / SeqStride != blockLocal 'wrongBlock'
			panic("UseIndex.addUseRecord: use of value {valueId} is claimed to be in block {blockLocal} but its sequence number {seq} places it in block {seq / SeqStride} — a record's block IS its sequence number's block")
		end 'wrongBlock'

		if self.useCount(valueId) > 0 'appendMustNotGoBackwards'
			let tail = try self.lastUseOfValue.get(valueId) otherwise panic("UseIndex.addUseRecord: lastUseOfValue.get OOB for value {valueId}")
			if seq < self.useSeqAt(tail) 'outOfOrder'
				panic("UseIndex.addUseRecord: use of value {valueId} at sequence {seq} lands before that value's last use (sequence {self.useSeqAt(tail)}) — a value's uses must be added in layout order")
			end 'outOfOrder'
		end 'appendMustNotGoBackwards'

		let record = self.useSeq.count()
		self.useOpIdx.push(opIdx)
		self.useSeq.push(seq)
		self.useOnEdge.push(onEdge)
		// A record starts as its OWN successor on both threads — which is exactly a one-record circular
		// list, so seating the first record on an empty thread needs no special case beyond the head.
		self.nextUseOfValue.push(record)
		self.nextUseInBlock.push(record)

		self.appendToValueThread(valueId, record: record)
		self.pushOntoBlockThread(blockLocal, record: record)
	end 'addUseRecord'

	// Append `record` at the TAIL of `valueId`'s circular thread — the order-preserving link, and the
	// reason the thread stays ascending by sequence (`addUseRecord` has already refused a record that
	// would go backwards).
	function appendToValueThread(valueId ValueId, record UseRecordIndex)
		let count = self.useCount(valueId)
		if count > 0 'hasUses'
			let tail = try self.lastUseOfValue.get(valueId) otherwise panic("UseIndex.appendToValueThread: lastUseOfValue.get OOB for value {valueId}")
			let head = self.nextUseOf(tail)
			try self.nextUseOfValue.set(tail, value: record) otherwise panic("UseIndex.appendToValueThread: nextUseOfValue.set OOB for record {tail}")
			try self.nextUseOfValue.set(record, value: head) otherwise panic("UseIndex.appendToValueThread: nextUseOfValue.set OOB for record {record}")
		end 'hasUses'

		try self.lastUseOfValue.set(valueId, value: record) otherwise panic("UseIndex.appendToValueThread: lastUseOfValue.set OOB for value {valueId}")
		try self.useCountOfValue.set(valueId, value: count + 1) otherwise panic("UseIndex.appendToValueThread: useCountOfValue.set OOB for value {valueId}")
	end 'appendToValueThread'

	// Push `record` at the HEAD of `blockLocal`'s thread. A block's records have no order to keep, so
	// the cheap end is the right end — and it is why the block thread needs no tail column.
	function pushOntoBlockThread(blockLocal CfgIndex, record UseRecordIndex)
		let count = self.blockUseCount(blockLocal)
		if count > 0 'hasUses'
			let head = self.firstUseInBlockOf(blockLocal)
			try self.nextUseInBlock.set(record, value: head) otherwise panic("UseIndex.pushOntoBlockThread: nextUseInBlock.set OOB for record {record}")
		end 'hasUses'

		try self.firstUseInBlock.set(blockLocal, value: record) otherwise panic("UseIndex.pushOntoBlockThread: firstUseInBlock.set OOB for block {blockLocal}")
		try self.useCountInBlock.set(blockLocal, value: count + 1) otherwise panic("UseIndex.pushOntoBlockThread: useCountInBlock.set OOB for block {blockLocal}")
	end 'pushOntoBlockThread'

	// Does `blockLocal` already hold an EDGE use of `valueId`? A block passing one value to several phis
	// — or to phis on several edges — must still yield exactly ONE edge use, the granularity a split's
	// partition needs.
	//
	// It is answered from the value's TAIL, in O(1), and that is exact rather than lucky: edge uses are
	// recorded LAST for a block, so if this block has already recorded one for this value, it is the most
	// recent record the value has. A tail in an earlier block, or a tail that is an op use, both mean
	// this block has not.
	function blockHasEdgeUseOf(valueId ValueId, blockLocal CfgIndex) returns bool
		if self.useCount(valueId) == 0 'neverUsed'
			return false
		end 'neverUsed'

		let tail = try self.lastUseOfValue.get(valueId) otherwise panic("UseIndex.blockHasEdgeUseOf: lastUseOfValue.get OOB for value {valueId}")
		if self.useBlockAt(tail) != blockLocal 'earlierBlock'
			return false
		end 'earlierBlock'

		return match self.useKindAt(tail) 'kind'
			edge gives true
			op gives false
		end 'kind'
	end 'blockHasEdgeUseOf'

	// Detach every use record of `valueId`. A split rewrites the uses past the peak to FRESH reload ids,
	// so the value's thread is REBUILT rather than edited record by record — which is also why there is
	// no remove-one-record: no caller wants one.
	//
	// O(1): the count IS the list, so zeroing it detaches the whole thread. The records stay in the
	// append-only arena and stay on their BLOCK threads, which is correct — a block thread exists to
	// repair sequence numbers, and a record no value points at is reachable from no value ever again
	// (`addUseRecord` always mints a new record; a detached one is never re-threaded).
	export function removeUseRecordsOf(valueId ValueId)
		try self.useCountOfValue.set(valueId, value: 0) otherwise panic("UseIndex.removeUseRecordsOf: value {valueId} out of range (valueCount={self.valueCount})")
	end 'removeUseRecordsOf'

	// Repoint one record's sequence number — what an op INSERTED into a block costs its uses.
	//
	// It cannot disturb the ascending order the value threads are held in, and that is a property of the
	// numbering rather than a thing to be careful about: a sequence number is
	// `block × SeqStride + position`, so an op inserted at position `p` of block `b` shifts a SUFFIX of
	// `b`'s records by exactly one each and touches no other block at all. A uniform shift of a suffix
	// reorders nothing.
	//
	// A record may NOT be moved to another block, and this refuses to: the block a record is sited in is
	// DERIVED from this number (there is no `useBlock` column), so a sequence number that crossed a
	// stride boundary would silently move the use into the next block.
	export function setUseSeq(record UseRecordIndex, seq OpSeq)
		if seq / SeqStride != self.useBlockAt(record) 'crossesBlocks'
			panic("UseIndex.setUseSeq: sequence {seq} would move use record {record} from block {self.useBlockAt(record)} into block {seq / SeqStride} — a resequenced use stays in its own block")
		end 'crossesBlocks'

		try self.useSeq.set(record, value: seq) otherwise panic("UseIndex.setUseSeq: use record {record} out of range")
	end 'setUseSeq'

	// One op LEFT the function — a fully rematerialized constant's def, which nothing reads any more.
	// The counterpart of `addOps`, and the only thing that ever lowers the count.
	export function removeOp()
		if self.opCount == 0 'noOps'
			panic("UseIndex.removeOp: the function has no ops left to remove")
		end 'noOps'
		self.opCount = self.opCount - 1
	end 'removeOp'

	// Forget EVERYTHING about `valueId` — its whole use thread and every per-value flag — so the caller
	// can re-derive them from the IR.
	//
	// This is what a split needs and what a set-only index cannot give it. The victim's after-peak uses
	// are rewritten to fresh ids, so it may STOP being edge-passed, STOP touching a loop, or (a fully
	// rematerialized constant, whose def is then dropped) stop being defined at all. A fact that only
	// ever gets SET would keep asserting the opposite, and `isColdSpillable` / `isRematerializable`
	// would go on believing it of a value that is no longer that shape.
	//
	// `defOpIdx` / `phiBlock` / `spillSlot` are left alone: each is read only behind the flag cleared
	// here, so a stale one is unreachable, and rewriting it would be work with no reader.
	export function resetValue(valueId ValueId)
		self.removeUseRecordsOf(valueId)
		try self.hasOpDef.set(valueId, value: false) otherwise panic("UseIndex.resetValue: value {valueId} out of range (valueCount={self.valueCount})")
		try self.isPhi.set(valueId, value: false) otherwise panic("UseIndex.resetValue: isPhi.set OOB for value {valueId}")
		try self.edgePassed.set(valueId, value: false) otherwise panic("UseIndex.resetValue: edgePassed.set OOB for value {valueId}")
		try self.spillStored.set(valueId, value: false) otherwise panic("UseIndex.resetValue: spillStored.set OOB for value {valueId}")
		try self.slotResident.set(valueId, value: false) otherwise panic("UseIndex.resetValue: slotResident.set OOB for value {valueId}")
		try self.touchesLoop.set(valueId, value: false) otherwise panic("UseIndex.resetValue: touchesLoop.set OOB for value {valueId}")
	end 'resetValue'

	// Record `valueId`'s def: an op at `opIdx`, in block `blockLocal`. A split MINTS values — each
	// reload defines a fresh id — and a fresh id has no def site until this gives it one.
	export function setOpDef(valueId ValueId, opIdx OpIndex, blockLocal CfgIndex)
		try self.hasOpDef.set(valueId, value: true) otherwise panic("UseIndex.setOpDef: value {valueId} out of range (valueCount={self.valueCount})")
		try self.defOpIdx.set(valueId, value: opIdx) otherwise panic("UseIndex.setOpDef: defOpIdx.set OOB for value {valueId}")
		try self.defOpBlock.set(valueId, value: blockLocal) otherwise panic("UseIndex.setOpDef: defOpBlock.set OOB for value {valueId}")
	end 'setOpDef'

	// Record that a `storeSlotReg` spills `valueId`. A stored value is also RESIDENT — memory holds it
	// — so this is strictly a refinement of `recordSlotResidency`, which the caller has already run.
	function setSpillStore(valueId ValueId)
		try self.spillStored.set(valueId, value: true) otherwise panic("UseIndex.setSpillStore: value {valueId} out of range (valueCount={self.valueCount})")
	end 'setSpillStore'

	// Record that memory holds `valueId` in `slot` — the two facts a LATER relief of the same value
	// needs (skip the redundant second store; reload out of the slot it already has).
	function setSlotResidency(valueId ValueId, slot SpillSlot)
		try self.slotResident.set(valueId, value: true) otherwise panic("UseIndex.setSlotResidency: value {valueId} out of range (valueCount={self.valueCount})")
		try self.spillSlot.set(valueId, value: slot) otherwise panic("UseIndex.setSlotResidency: spillSlot.set OOB for value {valueId}")
	end 'setSlotResidency'

	// The op-level answer: a `spillStore` wrote the value into its slot and a `slotReload` read it out of
	// one, and BOTH leave it sitting there afterwards — so either role makes the operand's value
	// resident. The slot is read out of the op only here, where the role has already said there is one.
	function recordSlotResidency(role OpSlotRole, op TargetOp, valueId ValueId)
		if role == OpSlotRole.touchesNoSlot 'noSlotInvolved'
			return
		end 'noSlotInvolved'
		self.setSlotResidency(valueId, slot: slotOfSlotOp(op))
	end 'recordSlotResidency'

	// `setSpillStore` for the op-level answer: a `storeSlotReg`'s source, and nothing else. A RELOAD
	// leaves its value resident (above) without the function ever having STORED it.
	function recordSpillStore(role OpSlotRole, valueId ValueId)
		if role != OpSlotRole.spillStore 'didNotStoreIt'
			return
		end 'didNotStoreIt'
		self.setSpillStore(valueId)
	end 'recordSpillStore'

	// Record `valueId` as a block-arg (phi) of `blockLocal`.
	function setPhiDef(valueId ValueId, blockLocal CfgIndex)
		try self.isPhi.set(valueId, value: true) otherwise panic("UseIndex.setPhiDef: isPhi.set OOB for phi {valueId}")
		try self.phiBlock.set(valueId, value: blockLocal) otherwise panic("UseIndex.setPhiDef: phiBlock.set OOB for phi {valueId}")
	end 'setPhiDef'

	// Record that `valueId` is passed to a phi on some branch edge.
	function setEdgePassed(valueId ValueId)
		try self.edgePassed.set(valueId, value: true) otherwise panic("UseIndex.setEdgePassed: edgePassed.set OOB for value {valueId}")
	end 'setEdgePassed'

	// Record that `valueId` is an operand — def or use — of an op in a block at loop depth > 0.
	function setTouchesLoop(valueId ValueId)
		try self.touchesLoop.set(valueId, value: true) otherwise panic("UseIndex.setTouchesLoop: touchesLoop.set OOB for value {valueId}")
	end 'setTouchesLoop'

	// Grow the value space to `newValueCount`, keeping every column's contents. A split MINTS value ids
	// — one per reload — and every column here is keyed by value id, so this is what lets the index
	// SURVIVE a split instead of being rebuilt for the ids it has never heard of.
	//
	// The BLOCK space does not grow with it: a split inserts ops into blocks that already exist and
	// never adds one.
	export function growTo(newValueCount ValueId)
		if newValueCount < self.valueCount 'shrink'
			panic("UseIndex.growTo: cannot shrink the value space from {self.valueCount} to {newValueCount}")
		end 'shrink'

		// The value THREADS: a fresh value has no uses, and a zero count is what says so — the tail entry
		// beside it is never read until an `addUseRecord` writes it.
		self.useCountOfValue.growFilled(newValueCount, value: 0)
		self.lastUseOfValue.growFilled(newValueCount, value: 0)

		self.hasOpDef.growFilled(newValueCount, value: false)
		self.defOpIdx.growFilled(newValueCount, value: 0)
		self.defOpBlock.growFilled(newValueCount, value: 0)
		self.isPhi.growFilled(newValueCount, value: false)
		self.phiBlock.growFilled(newValueCount, value: 0)
		self.edgePassed.growFilled(newValueCount, value: false)
		self.spillStored.growFilled(newValueCount, value: false)
		self.slotResident.growFilled(newValueCount, value: false)
		self.spillSlot.growFilled(newValueCount, value: 0)
		self.touchesLoop.growFilled(newValueCount, value: false)

		self.valueCount = newValueCount
	end 'growTo'
end 'UseIndex'

// A fresh BoolArray of `count` false entries (`resize` zero-fills).
function falseColumn(count ColumnLength) returns BoolArray
	var col = BoolArray.create()
	col.resize(count)
	return col
end 'falseColumn'

// The value ids ONE split touched: the VICTIM it rewrote, and the half-open range of fresh reload /
// remat ids it minted. They are the only values whose index facts, liveness or forbidden mask a split
// can change, so they are the only ones re-derived afterwards.
export type SplitValues
	export var victim as ValueId
	export var freshFrom as ValueId
	export var freshTo as ValueId

	export static function create(victim ValueId, freshFrom ValueId, freshTo ValueId) returns SplitValues
		return Self{victim: victim, freshFrom: freshFrom, freshTo: freshTo}
	end 'create'

	export function holds(valueId ValueId) returns bool
		if valueId == self.victim 'theVictim'
			return true
		end 'theVictim'
		return valueId >= self.freshFrom and valueId < self.freshTo
	end 'holds'
end 'SplitValues'

// WHICH values a block scan concerns — the one difference between building a per-value structure over
// the whole function and REBUILDING the part of it a split invalidated, so each scan is one
// implementation rather than two that can drift on what a use site (or a clobber) is.
//
// ONE scan takes it — `indexBlockFacts`, which records use/def facts for these values. A split CLEARS
// exactly the victim's and the fresh ids' entries and leaves every other value's alone, so a rebuild
// that covers more than these is not merely wasted work: it is the same work, done again, on data that
// already holds the answer. (`sweepBlockPressure` took it too, until the splitter stopped re-deriving
// `forbidden` by walking a block at all — see `PressureIndex.clobberOr`.)
union ScannedValues
	all
	split(values SplitValues)
end 'ScannedValues'

function scannedValuesHold(which ScannedValues, valueId ValueId) returns bool
	return match which 'w'
		all gives true
		split(values) gives values.holds(valueId)
	end 'w'
end 'scannedValuesHold'

// Record ONE block's index facts — its phi defs, every op def/use of a `which` value, its edge args —
// and return the block's op count.
//
// Uses are recorded in LAYOUT ORDER, which is what the value threads' ascending-sequence contract
// rests on: `addUseRecord` appends at the tail, so recording them in order IS keeping them in order.
// A caller that walks several blocks must therefore walk them in ASCENDING block index — a sequence
// number leads with its block.
function indexBlockFacts(module TargetModule, cfg FuncCfg, index UseIndex, blockLocal CfgIndex, which ScannedValues, buf OperandList, ordered OpIndexArray, opFacts OpVariantFacts) returns OpSeq
	let block = blockAt(module, topo: cfg.topo, local: blockLocal)
	indexBlockArgDefs(index, cfg: cfg, block: block, blockLocal: blockLocal, which: which)

	ordered.clear()
	collectBlockOps(block, out: ordered)
	let opCount = ordered.count()
	for pos in 0 upto opCount 'eachOp'
		indexOneOpFacts(module, cfg: cfg, index: index, blockLocal: blockLocal, pos: pos, opIdx: try ordered.get(pos) otherwise panic("indexBlockFacts: ordered.get OOB"), which: which, buf: buf, opFacts: opFacts)
	end 'eachOp'

	indexBlockEdgeUses(index, cfg: cfg, block: block, blockLocal: blockLocal, opCount: opCount, which: which)
	return opCount
end 'indexBlockFacts'

// The block-arg DEFS of one block. A block-arg's def is its block's entry, so it carries no position and
// no ordering constraint.
function indexBlockArgDefs(index UseIndex, cfg FuncCfg, block IrBlock, blockLocal CfgIndex, which ScannedValues)
	// A phi's DEF is its own block's entry, so a phi of a block inside a loop is (re)defined once per
	// iteration — the same fact `touchesLoop` records for an op def, and the reason a loop-carried
	// accumulator must never be cold-spilled. Recorded here so `isColdSpillable` can ask ONE question
	// about depth instead of barring every phi outright (see `defAndUsesAtDepthZero`).
	let inLoop = (try cfg.loopDepth.get(blockLocal) otherwise panic("indexBlockArgDefs: loopDepth.get OOB")) != 0

	for arg in block.blockArgs 'eachPhi'
		if scannedValuesHold(which, valueId: arg.valueId) 'recorded'
			index.setPhiDef(arg.valueId, blockLocal: blockLocal)
			if inLoop 'insideLoop'
				index.setTouchesLoop(arg.valueId)
			end 'insideLoop'
		end 'recorded'
	end 'eachPhi'
end 'indexBlockArgDefs'

// ONE op's index facts — its defs, its uses and the per-value flags they imply. Factored out of the
// whole-block walk so a SPLIT can run it over the handful of ops that can name a value it moved instead
// of over every op of every block it dirtied (`reindexSplitValues`).
//
// ⚠ THE CALLER OWNS THE ORDER. `addUseRecord` appends at each value's tail and REFUSES a record that
// would land out of sequence, so ops must be offered in ascending (block, position) — which the
// whole-block walk gets from its own loop and the split gets by sorting its candidate positions.
function indexOneOpFacts(module TargetModule, cfg FuncCfg, index UseIndex, blockLocal CfgIndex, pos BlockOpPos, opIdx OpIndex, which ScannedValues, buf OperandList, opFacts OpVariantFacts)
	let inLoop = (try cfg.loopDepth.get(blockLocal) otherwise panic("indexOneOpFacts: loopDepth.get OOB")) != 0
	let op = try module.ops.get(opIdx) otherwise panic("indexOneOpFacts: opIdx not in module.ops")
	targetOpOperands(op, buf: buf)
	// ONE question now, where there used to be two: the wider "is the value resident in a slot after
	// this op?" and the narrower "did this op STORE it there?" are two readings of one role.
	let slotRole = opFacts.slotRoleOf(op)

	for k in 0 upto buf.count() 'eachOperand'
		let o = try buf.get(k) otherwise panic("indexOneOpFacts: buf.get OOB")
		if not operandIsVirtual(o) 'physical'
			continue
		end 'physical'
		let v = operandValueId(o)
		if not scannedValuesHold(which, valueId: v) 'notRecorded'
			continue
		end 'notRecorded'

		if inLoop 'insideLoop'
			index.setTouchesLoop(v)
		end 'insideLoop'

		// Residency is recorded for the op's ONE virtual operand whichever side it is on: a
		// `storeSlotReg`'s source (a use) and a `loadRegSlot`'s destination (a def) both end with
		// the value sitting in that slot. Every other op touches no slot.
		index.recordSlotResidency(slotRole, op: op, valueId: v)

		if operandIsDef(o) 'def'
			index.setOpDef(v, opIdx: opIdx, blockLocal: blockLocal)
			continue
		end 'def'

		index.recordSpillStore(slotRole, valueId: v)

		if isFirstUseOfValueInOp(buf, upto: k, valueId: v) 'firstOccurrence'
			index.addUseRecord(v, blockLocal: blockLocal, opIdx: opIdx, seq: seqAt(blockLocal, pos: pos), onEdge: false)
		end 'firstOccurrence'
	end 'eachOperand'
end 'indexOneOpFacts'

// The EDGE uses of one block, which go LAST for it, at the terminator's sequence — where the edge is
// genuinely read (after every body op). That ordering is what lets the reload a split places before the
// block's first after-peak use dominate the edge too.
function indexBlockEdgeUses(index UseIndex, cfg FuncCfg, block IrBlock, blockLocal CfgIndex, opCount OpSeq, which ScannedValues)
	// An edge arg is READ at the end of this block, so a block inside a loop touches its args once per
	// iteration exactly as an op operand does — and `touchesLoop` is the one column that says so. It is
	// recorded here rather than left to `isColdSpillable`'s old blanket edge bar, which could not tell a
	// loop-carried arg from one handed across a depth-0 `if` join and refused both (see
	// `defAndUsesAtDepthZero`).
	let inLoop = (try cfg.loopDepth.get(blockLocal) otherwise panic("indexBlockEdgeUses: loopDepth.get OOB")) != 0

	for edge in block.branchEdges 'eachEdge'
		for argId in edge.argIds 'eachArg'
			if not scannedValuesHold(which, valueId: argId) 'notRecorded'
				continue
			end 'notRecorded'
			index.setEdgePassed(argId)
			if inLoop 'insideLoop'
				index.setTouchesLoop(argId)
			end 'insideLoop'
			if index.blockHasEdgeUseOf(argId, blockLocal: blockLocal) 'dedupe'
				continue
			end 'dedupe'
			if opCount == 0 'noTerminator'
				panic("indexBlockEdgeUses: block local {blockLocal} ('{String.from(block.label)}') passes value {argId} on a branch edge but has no ops to branch with")
			end 'noTerminator'
			index.addUseRecord(argId, blockLocal: blockLocal, opIdx: lastOpOf(block), seq: seqAt(blockLocal, pos: opCount - 1), onEdge: true)
		end 'eachArg'
	end 'eachEdge'
end 'indexBlockEdgeUses'

// The block's LAST op in execution order — its terminator, or its last body op when it has none. The
// sequence anchor every edge use of the block is recorded at.
function lastOpOf(block IrBlock) returns OpIndex
	if block.hasTerminatorOp() 'terminated'
		return block.terminatorIndex()
	end 'terminated'
	return try block.opRefs.get(block.opRefs.count() - 1) otherwise panic("lastOpOf: block '{String.from(block.label)}' has neither a terminator nor a body op to anchor an edge use at")
end 'lastOpOf'

// Build the index in ONE pass over the function: create it empty, then record every def, flag and use
// site on the way through — through the index's own mutators, which are the ones a SPLIT edits it with
// (see "EDITS" above).
function buildUseIndex(module TargetModule, cfg FuncCfg, valueCount ValueId, opFacts OpVariantFacts) returns UseIndex
	var index = UseIndex.create(valueCount, numBlocks: cfg.topo.numBlocks)

	var buf = OperandList.create()
	var ordered = OpIndexArray.create()

	// Hoisted for the reason `computeLivenessOn` hoists its own: a union value is a heap object, and one
	// built inside this loop is one allocation per block of every function the allocator sees.
	let everyValue = ScannedValues.all
	for i in 0 upto cfg.topo.numBlocks 'eachBlock'
		index.addOps(indexBlockFacts(module, cfg: cfg, index: index, blockLocal: i, which: everyValue, buf: buf, ordered: ordered, opFacts: opFacts))
	end 'eachBlock'

	return index
end 'buildUseIndex'

// Re-derive every index fact about the values a split TOUCHED — from the ops that can NAME one, not
// from the blocks that hold them. This is the `buildUseIndex` a split needs, restricted to what a split
// can change.
//
// ⭐ THE CANDIDATE OPS ARE KNOWN, AND THERE ARE O(uses of ONE value) OF THEM. Re-reading whole blocks
// was the third of the four O(block)-per-split walks, and on a function that is one basic block that is
// the whole function once per split. The set is exactly:
//
//  • every op that named the VICTIM before the split. Those are its use records — which are still on
//    its thread at this point, with their sequence numbers already repaired by `SplitEdits.commit` —
//    plus its defining op. After the split each of them names either the victim still (a before-peak
//    use it kept) or the fresh id it was rewritten to, and BOTH need re-recording.
//  • every op the split INSERTED (`SplitEdits.insertedSlots`): the spill store, which is a use of the
//    victim, and each reload or re-emitted constant, which DEFINES a fresh id.
//
// There is no third case. A split rewrites operands and splices ops; it never makes an op it did not
// touch name a value it minted, and `rewriteEdgeArgsIn` reaches only EDGES, which are re-scanned per
// dirty block below (an edge arg list is bounded by the successor's phi count, not by the block).
//
// ⚠ ORDER IS THE CONTRACT. A value's thread is held ascending by sequence and `addUseRecord` REFUSES a
// record that would land out of order, so the candidates are offered in ascending SLOT order — which is
// ascending (block, position), because `PressureIndex` lays a block's run out after every earlier
// block's and an op's slot rises with its position.
export function reindexSplitValues(module TargetModule, cfg FuncCfg, index UseIndex, dirty BlockSet, split SplitValues, pressure PressureIndex, edits SplitEdits, candidates DenseColumn, sortBuf DenseColumn, scratch PressureSweepScratch, opFacts OpVariantFacts)
	collectReindexCandidates(index, pressure: pressure, edits: edits, victim: split.victim, out: candidates)
	sortColumnAscending(candidates, scratch: sortBuf)

	index.resetValue(split.victim)
	for f in split.freshFrom upto split.freshTo 'eachFresh'
		index.resetValue(f)
	end 'eachFresh'

	let which = ScannedValues.split(split)
	var next = 0 as ColumnLength
	for k in 0 upto dirty.count() 'eachDirtyBlock'
		let blockLocal = dirty.at(k)
		let block = blockAt(module, topo: cfg.topo, local: blockLocal)
		indexBlockArgDefs(index, cfg: cfg, block: block, blockLocal: blockLocal, which: which)

		// The candidates sitting in THIS block. Both lists are ascending and every candidate is in some
		// dirty block, so one cursor walks them together — no search, no per-block filter.
		let runEnd = pressure.exitSlotOf(blockLocal)
		while next < candidates.count() 'eachCandidateHere'
			let slot = try candidates.get(next) otherwise panic("reindexSplitValues: candidates.get OOB at {next}")
			if slot > runEnd 'inALaterBlock'
				break
			end 'inALaterBlock'
			// A candidate BELOW this block's run belongs to an earlier block — and every earlier block that
			// is dirty has already consumed its own. So one that survives to here sits in a block the caller
			// never registered, and would be indexed against the wrong block's positions: a use record whose
			// sequence number names a block it is not in.
			if slot < pressure.firstSlotOf(blockLocal) 'inAnUnregisteredEarlierBlock'
				panic("reindexSplitValues: a candidate op of value {split.victim}'s split sits at slot {slot}, below block {blockLocal}'s run — its own block is not in the dirty region")
			end 'inAnUnregisteredEarlierBlock'
			if next == 0 or slot != (try candidates.get(next - 1) otherwise panic("reindexSplitValues: candidates.get OOB at {next - 1}")) 'notAlreadyDone'
				indexOneOpFacts(module, cfg: cfg, index: index, blockLocal: blockLocal, pos: pressure.positionOfSlot(blockLocal, slot: slot), opIdx: pressure.opAtSlot(slot), which: which, buf: scratch.buf, opFacts: opFacts)
			end 'notAlreadyDone'
			next = next + 1
		end 'eachCandidateHere'

		// `blockOpCount`, not the positional index's occupancy — the SAME source the whole-block walk
		// counts with. An edge use is anchored at `seqAt(block, opCount - 1)`, i.e. at the terminator's
		// BLOCK POSITION, and block positions are stated by `opRefs` + the terminator; the index's count
		// is a copy derived from that. Reading the copy here would put an edge record at a sequence the
		// block does not have the moment the two ever disagree.
		indexBlockEdgeUses(index, cfg: cfg, block: block, blockLocal: blockLocal, opCount: blockOpCount(block), which: which)
	end 'eachDirtyBlock'

	if next != candidates.count() 'candidatesOutsideTheDirtyRegion'
		panic("reindexSplitValues: {candidates.count() - next} candidate op(s) of value {split.victim}'s split sit outside the dirty region, so the region is not the superset the incremental update rests on — a mutator has placed an op, or moved a use, into a block the caller never registered")
	end 'candidatesOutsideTheDirtyRegion'
end 'reindexSplitValues'

// Every op the split can have made name the victim or one of the ids it minted, as SLOTS: the ops that
// named the victim BEFORE it (still on its thread, with repaired sequence numbers), its defining op, and
// the ops the split spliced in.
//
// ⚠ IT MUST RUN BEFORE `resetValue`, which is what detaches the victim's thread — the thread IS the
// record of where it was named.
function collectReindexCandidates(index UseIndex, pressure PressureIndex, edits SplitEdits, victim ValueId, out DenseColumn)
	out.clear()

	let useSites = index.useCount(victim)
	if useSites > 0 'used'
		var record = index.firstUseOf(victim)
		for _ in 0 upto useSites 'eachUse'
			// An EDGE use names no operand of the op it is anchored at; the per-block edge scan is what
			// re-records it.
			match index.useKindAt(record) 'kind'
				edge then break 'kind'
				op then out.push(pressure.slotOfPosition(index.useBlockAt(record), pos: index.usePosAt(record)))
			end 'kind'
			record = index.nextUseOf(record)
		end 'eachUse'
	end 'used'

	// The DEF, unless the split dropped it — a constant every one of whose uses was rematerialized has no
	// reader left, and `SplitEdits` removes it, vacating its slot.
	if index.defKindOf(victim) == ValueDefKind.opDef 'definedByAnOp'
		let defSlot = pressure.defSlotOf(victim)
		if pressure.slotHoldsOp(defSlot) 'stillThere'
			out.push(defSlot)
		end 'stillThere'
	end 'definedByAnOp'

	edits.appendInsertedSlots(out)
end 'collectReindexCandidates'

// Is operand `k` the FIRST virtual USE of its value in this op? An op reading one value twice must
// still yield ONE use site — the per-OP granularity a split's before/after-the-peak partition is
// stated in. Operand lists are at most four entries, so the inner scan is a constant.
function isFirstUseOfValueInOp(buf OperandList, upto OperandIndex, valueId ValueId) returns bool
	for j in 0 upto upto 'earlier'
		let o = try buf.get(j) otherwise panic("isFirstUseOfValueInOp: buf.get OOB")
		if (not operandIsDef(o)) and operandIsVirtual(o) and operandValueId(o) == valueId 'seenAlready'
			return false
		end 'seenAlready'
	end 'earlier'
	return true
end 'isFirstUseOfValueInOp'

// The number of block-marking steps a walk took — the cost counter that replaces the fixpoint's
// iteration count (there is no fixpoint). Returned alongside the sets.
type LivenessWalk
	export var live as LiveSets
	export var markSteps as EventCount

	static function create(live LiveSets, markSteps EventCount) returns LivenessWalk
		return Self{live: live, markSteps: markSteps}
	end 'create'
end 'LivenessWalk'

// The SPARSE per-block live-in/live-out sets: ONE backward path exploration per value, from its uses
// up to its def.
//
// The walk itself is `LivenessMarkScratch.walkValue` — THE SAME ONE the splitter unmarks a victim's
// old range and marks its new one with. That is not tidiness; it is the whole correctness argument of
// the incremental splitter. The splitter's unmark claims to remove EXACTLY the marks this build laid
// down, and the only thing that can make that true is the two being one function. Two copies would
// agree today and drift on the next edit to either — leaving a value in a block's live set it is not
// live in (an invented register demand) or, worse, out of one it IS live in (the colorer reuses its
// register while it is still live).
//
// `touched` is a scratch region the walk records into and this build throws away, one value at a time
// — `BlockSet.clear()` is O(1), so collecting it costs a stamp check per mark step and nothing else.
function solveLivenessSsa(topo FuncTopology, useIndex UseIndex, valueCount ValueId, marks LivenessMarkScratch, touched BlockSet) returns LivenessWalk
	var live = LiveSets.create(topo.numBlocks)
	var markSteps = 0 as EventCount

	for v in 0 upto valueCount 'eachValue'
		touched.clear()
		markSteps = markSteps + marks.walkValue(topo, index: useIndex, v: v, live: live, adding: true, touched: touched)
	end 'eachValue'

	return LivenessWalk.create(live, markSteps: markSteps)
end 'solveLivenessSsa'

// ==========================================================================
// The DIRTY REGION — one split's blast radius
// ==========================================================================

// A SET of blocks, and the list of them: the splitter's dirty region.
//
// Membership is a generation STAMP, not a cleared bitmap. Clearing a `numBlocks` column between splits
// would be O(blocks) per split — which is the O(function × splits) term the incremental splitter
// exists to remove, walking straight back in through its own bookkeeping.
export type BlockSet
	var members as CfgIndexArray
	var stamp as VersionStampColumn
	// The current membership stamp is `generation + 1`, so an all-zero column (a freshly sized one)
	// holds no member at generation 0 — the set is empty before anything is added to it, with no
	// initialisation pass to get it there.
	var generation as VersionStamp
	var sortBuf as CfgIndexArray

	export static function create() returns BlockSet
		return Self{members: CfgIndexArray.create(), stamp: VersionStampColumn.create(), generation: 0, sortBuf: CfgIndexArray.create()}
	end 'create'

	// Size the stamp column for a function. Deferred until the function turns out to need a SPLIT at
	// all — almost none do, and sizing it eagerly would put an O(blocks) allocation and fill on every
	// function the allocator sees.
	export function begin(numBlocks CfgIndex)
		self.stamp.refill(numBlocks, value: 0)
		self.generation = 0
		self.members.clear()
	end 'begin'

	export function clear()
		self.generation = self.generation + 1
		self.members.clear()
	end 'clear'

	export function add(blockLocal CfgIndex)
		let mark = self.generation + 1
		let cur = try self.stamp.get(blockLocal) otherwise panic("BlockSet.add: block {blockLocal} out of range")
		if cur == mark 'alreadyIn'
			return
		end 'alreadyIn'
		try self.stamp.set(blockLocal, value: mark) otherwise panic("BlockSet.add: stamp.set OOB for block {blockLocal}")
		self.members.push(blockLocal)
	end 'add'

	export function count() returns CfgIndex
		return self.members.count()
	end 'count'

	export function at(k CfgIndex) returns CfgIndex
		return try self.members.get(k) otherwise panic("BlockSet.at: position {k} out of range")
	end 'at'

	// Put the members in ASCENDING block order — which the index rebuild REQUIRES (see
	// `reindexSplitValues`).
	export function sortAscending()
		sortColumnAscending(self.members, scratch: self.sortBuf)
	end 'sortAscending'
end 'BlockSet'

// The memo ONE liveness walk needs — "is `v` already marked live-in to (respectively live-out of)
// block B on THIS walk?".
//
// VERSION STAMPS, not bitsets: clearing a `numBlocks` memo between walks would be O(blocks) per value,
// i.e. the very O(blocks × values) term the path exploration exists to remove. The stamp is a
// GENERATION, bumped once per walk. It used to be `v + 1`, which needs no clearing between VALUES —
// and that is exactly what will not do here, because a split walks the SAME value TWICE (once to unmark
// its old live range, once to mark its new one) and a `v + 1` stamp would make the second walk believe
// it had already run.
//
// The live-out stamp also DEDUPES: a block that is a predecessor of several blocks in which `v` is live
// is reached once per such successor, and without the stamp would record `v` in its live-out list every
// time.
export type LivenessMarkScratch
	var liveInStamp as VersionStampColumn
	var liveOutStamp as VersionStampColumn
	var generation as VersionStamp
	var worklist as CfgIndexArray

	export static function create() returns LivenessMarkScratch
		return Self{liveInStamp: VersionStampColumn.create(), liveOutStamp: VersionStampColumn.create(), generation: 0, worklist: CfgIndexArray.create()}
	end 'create'

	// Size the memo for a function — deferred to the first split, exactly as `BlockSet.begin` is.
	export function begin(numBlocks CfgIndex)
		self.liveInStamp.refill(numBlocks, value: 0)
		self.liveOutStamp.refill(numBlocks, value: 0)
		self.generation = 0
	end 'begin'

	// ONE VALUE'S LIVENESS, marked (`adding`) or UNMARKED, in place. This is THE liveness walk: the
	// whole-function build runs it once per value (`solveLivenessSsa`) and the splitter runs it on the
	// two kinds of value a split moves. There is deliberately no second copy — see `solveLivenessSsa`.
	//
	// **In strict SSA the def DOMINATES every use, so liveness needs no iteration at all.** A value is
	// live exactly on the CFG paths running backward from each of its uses up to its (single) def. So:
	// start at a use, walk up through predecessors marking the value live, and STOP at the def. Nothing
	// to converge — every block is visited at most once per value, and only the blocks where the value
	// is genuinely live are visited at all. (Boissinot et al., "Computing Liveness Sets for SSA-Form
	// Programs".) Cost is O(the size of the liveness information itself), not O(blocks × values).
	//
	// Two subtleties, and both are what make it exact:
	//
	//  • **A back edge needs no special handling.** Walking up from a use inside a loop reaches the loop
	//    header's predecessors — including the latch — and marks the value live around the back edge,
	//    all in the same walk. The live-in memo below is what makes it terminate.
	//
	//  • **A PHI is where the walk stops, and a phi ARG is where it starts.** A block-arg is defined at
	//    its block's entry, so the walk halts there and does NOT propagate into the predecessors: the
	//    incoming values, not the phi, are live on those edges. Symmetrically, a value passed on an edge
	//    is live at the END of the PREDECESSOR (not live-in to the phi's block), so its walk seeds at the
	//    predecessor. Getting this backwards is the classic phi-liveness bug; the two arms below are the
	//    whole of it.
	//
	// WHY IT IS THE WHOLE OF THE SPLITTER'S INCREMENTAL LIVENESS, and why that is EXACT rather than
	// approximate: a split changes the live range of exactly two kinds of value — the VICTIM (its range
	// shrinks, because its after-peak uses now read reloads) and the FRESH reload/remat ids (short new
	// ranges inside the block that minted them). No other value's liveness changes, because the walk is
	// PER VALUE and reads only that value's uses and def, so a value the split did not touch walks the
	// same blocks and marks the same sets by construction.
	//
	// Every block the walk touches is added to `touched`: a superset of the blocks whose live sets moved,
	// which is what the caller's dirty region is grown from.
	//
	// The UNMARK direction re-derives the value's OLD range from the PRE-split index and removes exactly
	// the marks the marking walk laid down — the same function, so "exactly" is structural — and it must
	// therefore run BEFORE the index is rebuilt.
	export function walkValue(topo FuncTopology, index UseIndex, v ValueId, live LiveSets, adding bool, touched BlockSet) returns EventCount
		let useSites = index.useCount(v)
		if useSites == 0 'neverUsed'
			// A value nothing reads is live nowhere — no walk to run, and nothing to unmark.
			return 0
		end 'neverUsed'

		self.generation = self.generation + 1
		let gen = self.generation
		let defBlock = index.defBlockOrNone(v)
		var pending = self.worklist
		pending.clear()

		var record = index.firstUseOf(v)
		for _ in 0 upto useSites 'eachUse'
			let useBlock = index.useBlockAt(record)
			match index.useKindAt(record) 'kind'
				edge then self.editLiveOut(live, gen: gen, blockLocal: useBlock, v: v, adding: adding, touched: touched)
				op then break 'kind'
			end 'kind'
			pending.push(useBlock)
			record = index.nextUseOf(record)
		end 'eachUse'

		var markSteps = 0 as EventCount
		while pending.count() > 0 'walkUp'
			let b = try pending.pop() otherwise panic("LivenessMarkScratch.walkValue: pending.pop on non-empty failed")
			markSteps = markSteps + 1

			// STOP at the def block, BEFORE marking. Above the def the value does not exist, and it is
			// not live-IN to the block that defines it — for EITHER kind of def:
			//
			//   • an ordinary op def: the value is born mid-block, and (Rule 1: def dominates every use)
			//     nothing in the block reads it earlier, so it is not live on entry.
			//   • a PHI def: the value is born at the block's ENTRY. `liveIn` EXCLUDES a block's own phi
			//     defs by convention — the colorer seeds its in-use mask from `liveIn` and THEN colors
			//     the block-args, so a phi appearing in its own `liveIn` would demand it be already
			//     colored (`seedInUse` panics exactly there). And the walk must not continue into the
			//     predecessors either: what they carry are the phi's incoming ARGS, which are different
			//     values with their own walks.
			//
			// One rule covers both, which is why the def's KIND never needs to be recorded.
			if defBlock == b 'reachedDef'
				continue
			end 'reachedDef'

			let stamp = try self.liveInStamp.get(b) otherwise panic("LivenessMarkScratch.walkValue: liveInStamp.get OOB")
			if stamp == gen 'alreadyWalked'
				continue
			end 'alreadyWalked'
			try self.liveInStamp.set(b, value: gen) otherwise panic("LivenessMarkScratch.walkValue: liveInStamp.set OOB")

			touched.add(b)
			if adding 'mark'
				live.addLiveIn(b, v: v)
			end 'mark' else 'unmark'
				live.removeLiveIn(b, v: v)
			end 'unmark'

			let deg = topo.pred.degree(b)
			for k in 0 upto deg 'eachPred'
				let p = topo.pred.neighbour(b, k: k)
				self.editLiveOut(live, gen: gen, blockLocal: p, v: v, adding: adding, touched: touched)
				pending.push(p)
			end 'eachPred'
		end 'walkUp'

		return markSteps
	end 'walkValue'

	// Record (or forget) `v` as live-out of `blockLocal`, at most once per walk. `LiveSets.addLiveOut` is
	// idempotent on its own, but it pays a scan of the block's list to be — so the O(1) stamp is what
	// keeps a mark step O(1).
	function editLiveOut(live LiveSets, gen VersionStamp, blockLocal CfgIndex, v ValueId, adding bool, touched BlockSet)
		let cur = try self.liveOutStamp.get(blockLocal) otherwise panic("LivenessMarkScratch.editLiveOut: liveOutStamp.get OOB")
		if cur == gen 'already'
			return
		end 'already'
		try self.liveOutStamp.set(blockLocal, value: gen) otherwise panic("LivenessMarkScratch.editLiveOut: liveOutStamp.set OOB")

		touched.add(blockLocal)
		if adding 'mark'
			live.addLiveOut(blockLocal, v: v)
		end 'mark' else 'unmark'
			live.removeLiveOut(blockLocal, v: v)
		end 'unmark'
	end 'editLiveOut'
end 'LivenessMarkScratch'

// ==========================================================================
// Pressure + forbiddenPhys (backward sweep over the converged live-out)
// ==========================================================================

// Everything ONE backward pressure sweep steps with: the single dense working ROW, and the operand /
// op-order / live-set buffers. Allocated once and reused across every block of a function — and, in
// the splitter, across every SPLIT of it.
//
// The row is zero on entry to a block sweep and zero again on the way out (`sweepBlockPressure` clears
// it in O(live), never a word at a time), so it is never wholesale-cleared. `widenRow` is what follows
// a value space that a split has GROWN.
export type PressureSweepScratch
	export var liveRow as BitWordArray
	export var buf as OperandList
	export var liveBuf as ValueIdArray
	export var ordered as OpIndexArray

	// The per-class working rows: the live population being swept, one op's pressure, and the block's
	// running max. Allocated once per function and reused across every block and every op — the same
	// scratch discipline the rest of the allocator follows, and the reason a per-class figure costs no
	// allocation at all.
	export var liveByClass as RegCountColumn
	export var opPressure as RegCountColumn
	export var blockMax as RegCountColumn

	export static function create() returns PressureSweepScratch
		return Self{liveRow: BitWordArray.create(), buf: OperandList.create(), liveBuf: ValueIdArray.create(), ordered: OpIndexArray.create(), liveByClass: zeroClassRow(), opPressure: zeroClassRow(), blockMax: zeroClassRow()}
	end 'create'

	// Widen the working row to `wordsPerRow`, ZEROING only the words the growth added — the rest of the
	// row is already zero, and re-zeroing it would be O(values/64) on every split.
	export function widenRow(wordsPerRow BitWordCount)
		self.liveRow.growFilled(wordsPerRow, value: 0)
	end 'widenRow'
end 'PressureSweepScratch'

// ONE block's FORWARD per-op sweep, filling `establishedAtDef` for every value the block defines: the
// physical registers written by name ahead of that def and not yet destroyed. See the field for the
// defect this exists to close and for why the cure is a forbid rather than a different splice point.
//
// A register enters the pending set at the op that WRITES IT BY NAME (`physicalDefMask`) and leaves it
// at the first op that DESTROYS it — its `implicitDefs`, which is the caller-saved half at a call and
// `RAX|RDX` at an `idiv`. That is the exact lifetime and it needs no list of which ops are "argument
// placement": a call's clobber mask covers every argument register by construction (the pool's
// caller-saved half IS `callDirect`'s `implicitDefs`, held so by `assertCallClobberConsistent`), so an
// argument register is pending from its pre-move to the call it was placed for and no further. It is
// deliberately NOT ended by an op that merely READS the register (`implicitUses`): `cqo` reads RAX
// between the dividend move and the `idiv` that consumes it, and ending the window there would leave a
// value defined in between free to take RAX.
//
// ⚠⚠ **A BLOCK STARTS WITH NOTHING PENDING, AND THAT IS AN ASSUMPTION ABOUT THE LOWERING, NOT A
// DERIVATION.** `pending` is seeded to 0 at every block rather than joined over the predecessors,
// which is correct only while no window ever crosses a block boundary — i.e. while every call's
// pre-moves sit in the same block as the call they place, which is how both `emitArgMovesByFloatMask`
// twins (x64's and arm64's) emit a run today, and while a split only ever anchors a reload in the
// block of the use it serves. Neither is checked here.
//
// ⛔ **IF THAT EVER STOPS BEING TRUE, THIS UNDER-FORBIDS — WHICH IS THE ORIGINAL DEFECT, RETURNING
// SILENTLY.** A joined answer is the sound one, and it is deliberately not paid for: a forward join
// over predecessors is a second dataflow fixpoint on a path that runs per split, to describe a
// program shape nothing emits. A lowering that ever splices a block between a pre-move and its call
// must add the join, not merely re-measure; the symptom would be a wrong ANSWER at one call site, not
// a failing build.
//
// ⚠ IT IS ASSIGNED, NOT OR-ED, so re-running it on a block a split dirtied RESTATES that block's
// answers instead of accumulating stale ones. Nothing a split inserts or removes is a physical def or
// carries an `implicitDefs` mask (`storeSlotReg` / `loadRegSlot` / a constant materialization all read
// 0), so the pending set at every PRE-EXISTING def is invariant under a split and only the fresh ids
// get a new entry — but the sweep does not depend on that being true, because it rewrites the block.
export function sweepEstablishedRegisters(module TargetModule, topo FuncTopology, blockLocal CfgIndex, establishedAtDef RegMaskColumn, scratch PressureSweepScratch, opFacts OpVariantFacts)
	let block = blockAt(module, topo: topo, local: blockLocal)
	var buf = scratch.buf
	var ordered = scratch.ordered

	ordered.clear()
	collectBlockOps(block, out: ordered)
	var pending = 0 as RegMask
	for opIdx in ordered 'eachOp'
		let op = try module.ops.get(opIdx) otherwise panic("sweepEstablishedRegisters: op {opIdx} of block {blockLocal} is not in module.ops")
		targetOpOperands(op, buf: buf)
		for o in buf 'eachOperand'
			if operandIsDef(o) and operandIsVirtual(o) 'virtualDef'
				try establishedAtDef.set(operandValueId(o), value: pending) otherwise panic("sweepEstablishedRegisters: establishedAtDef.set OOB for value {operandValueId(o)}")
			end 'virtualDef'
		end 'eachOperand'

		// This op's own physical defs join the pending set AFTER its defs are stated: a value defined by
		// the very op that establishes a register is not clobbered by it (nothing else writes it in
		// between), and today no op does both.
		pending = (pending and not opFacts.implicitDefsOf(op)) or physicalDefMask(buf)
	end 'eachOp'
end 'sweepEstablishedRegisters'

// ONE block's backward per-op sweep: track the exact live set at each program point, fold each op's
// physical/implicit register writes into `forbidden` for every value live ACROSS it, record the
// block's dead-phi count, and return the block's REGISTER DEMAND (its peak simultaneous live count,
// carrying the reuse-copy transient, plus its dead-phi reservations). `maxPressure` is the max of
// these over the function — the χ = ω the feasibility decision needs.
//
// ⚠ IT IS THE WHOLE-FUNCTION BUILD'S ONLY. It used to be per block because the SPLITTER re-ran it per
// dirty block — and on a function that is one basic block that is a walk of the whole function, once
// per split. All three of its outputs are now restated against what a split actually moved:
// `forbidden` from `PressureIndex.clobberOr` (a range OR per block of the value's range),
// the dead-phi count only for the one block a block-arg's liveness can move in, and the demand off the
// positional index in O(1). See `rebuildForbiddenOf`, `refreshDeadPhisFor` and `refreshBlockDemands`.
//
// It stays per block because the build calls it per block, and because that is the granularity its
// three outputs are keyed at.
//
// A DEAD block-arg phi (never used, not live-out — e.g. the continuation phi a merge mints for a value
// nothing reads after an `if`) is never "live", so the op sweep counts it as zero. But the colorer
// colors EVERY block-arg and holds its register for the WHOLE block — a dead phi never appears as an
// operand, so it never dies and its register is freed only at the block boundary. So the block's true
// simultaneous demand is `blockMax + (dead-phi count)`. Adding it keeps `maxPressure` equal to the
// exact χ the colorer needs, so the FULL-POOL half of the colorer's guarantee — and the E5001 deficit
// count — stay sound. The count is RECORDED per block, not just folded into the max: the splitter's
// peak-finder needs the same number at every op of the block.
//
// ⚠ THIS PARAGRAPH USED TO NAME A *"coloring cannot fail when maxPressure <= pool"* INVARIANT, AND NO
// SUCH INVARIANT EXISTS (A5g, 2026-08-04). `maxPressure <= pool` is NECESSARY and not SUFFICIENT: a
// forbidden set shrinks a value's pool, so the colorer can run out with pressure comfortably under the
// pool — measured on four programs whose failing points Hall's exact verdict calls FEASIBLE. What this
// number underwrites is the PIGEONHOLE half only. The confined half is `HallCondition`'s, and the
// residue neither can prevent — greedy is not exact for list colouring — is repaired by
// `SplitDriver.repairAtExhaustion` / `repairByEvictingOccupant`. Keeping the old sentence here would be
// the same one-fact-written-twice this rung corrected in `HallCondition.hallVerdictAt`'s own header.
function sweepBlockPressure(module TargetModule, topo FuncTopology, blockLocal CfgIndex, live LiveSets, forbidden RegMaskColumn, classes ValueClassColumn, deadPhis RegCountColumn, wordsPerRow BitWordCount, scratch PressureSweepScratch, demandOut RegCountColumn, opFacts OpVariantFacts)
	let block = blockAt(module, topo: topo, local: blockLocal)
	var liveRow = scratch.liveRow
	var buf = scratch.buf
	var liveBuf = scratch.liveBuf
	var ordered = scratch.ordered
	var liveByClass = scratch.liveByClass
	var opPressure = scratch.opPressure
	var blockMax = scratch.blockMax

	// The stored list itself, not a copy into a scratch buffer: this sweep only READS the live sets,
	// so there is nothing to copy it away from. The per-class tally is seeded from the same list, in
	// the same O(live) walk that seeds the bit row.
	let liveOutList = live.liveOut(blockLocal)
	for v in liveOutList 'seedLiveOut'
		bitsetAdd(liveRow, base: 0, bit: v)
	end 'seedLiveOut'
	seedClassLive(liveByClass, classes: classes, values: liveOutList)
	for classOrdinal in 0 upto RegClassCount 'seedMax'
		let class = regClassAt(classOrdinal)
		classRowSet(blockMax, class: class, value: classRowGet(liveByClass, class: class))
	end 'seedMax'

	ordered.clear()
	collectBlockOps(block, out: ordered)
	for ri in 0 upto ordered.count() 'eachOpRev'
		let opIdx = try ordered.get(ordered.count() - 1 - ri) otherwise panic("sweepBlockPressure: ordered.get OOB")
		stepBackwardOverOp(module, opIdx: opIdx, liveRow: liveRow, forbidden: forbidden, buf: buf, wordsPerRow: wordsPerRow, liveBuf: liveBuf, liveByClass: liveByClass, classes: classes, pressureOut: opPressure, opFacts: opFacts)
		for classOrdinal in 0 upto RegClassCount 'eachClass'
			let class = regClassAt(classOrdinal)
			classRowSet(blockMax, class: class, value: maxOf(classRowGet(blockMax, class: class), b: classRowGet(opPressure, class: class)))
		end 'eachClass'
	end 'eachOpRev'

	// After the backward sweep `liveRow` is the live-IN view: a block-arg is present iff it is live
	// (used here or live-out); a dead phi is absent.
	countDeadPhis(block, liveRow: liveRow, classes: classes, deadPhis: deadPhis, blockLocal: blockLocal)

	// Return the working row to zero for the next block, in O(live). What it holds now is the block's
	// LIVE-IN set plus any of its own block-args the sweep re-added (a phi read by an op in the block),
	// so removing exactly those two sets clears it. Clearing the whole row instead would be
	// O(values/64) per block — the term the sparse sets exist to remove.
	for v in live.liveIn(blockLocal) 'clearLiveIn'
		bitsetRemove(liveRow, base: 0, bit: v)
	end 'clearLiveIn'
	for arg in block.blockArgs 'clearPhis'
		bitsetRemove(liveRow, base: 0, bit: arg.valueId)
	end 'clearPhis'

	// The block's demand, per file: that file's peak simultaneous count plus its own dead-phi
	// reservations. A dead phi of one file reserves a register of THAT file and competes for nothing
	// in the other.
	for classOrdinal in 0 upto RegClassCount 'demand'
		let class = regClassAt(classOrdinal)
		classRowSet(demandOut, class: class, value: classRowGet(blockMax, class: class) + (try deadPhis.get(classRowIndex(blockLocal, class: class)) otherwise panic("sweepBlockPressure: deadPhis.get OOB for block {blockLocal}")))
	end 'demand'
end 'sweepBlockPressure'

// The DEAD block-arg phis of `block`, tallied PER FILE into `deadPhis`' row for this block:
// block-args absent from `liveRow` (the live-in view the backward sweep leaves), i.e. with no use in
// the block and not live-out. The colorer reserves a register for each across the whole block, so
// they count toward that file's true register demand even though they are never live.
//
// It WRITES the row rather than returning a count, because the answer is per class and a per-op
// return value would be a heap object on the sweep's hottest path.
function countDeadPhis(block IrBlock, liveRow BitWordArray, classes ValueClassColumn, deadPhis RegCountColumn, blockLocal CfgIndex)
	for classOrdinal in 0 upto RegClassCount 'zeroRow'
		let class = regClassAt(classOrdinal)
		try deadPhis.set(classRowIndex(blockLocal, class: class), value: 0) otherwise panic("countDeadPhis: deadPhis.set OOB for block {blockLocal}")
	end 'zeroRow'

	for arg in block.blockArgs 'each'
		if not bitsetTest(liveRow, base: 0, bit: arg.valueId) 'deadPhi'
			let class = try classes.get(arg.valueId) otherwise panic("countDeadPhis: block-arg value {arg.valueId} has no recorded register class")
			let idx = classRowIndex(blockLocal, class: class)
			try deadPhis.set(idx, value: (try deadPhis.get(idx) otherwise panic("countDeadPhis: deadPhis.get OOB")) + 1) otherwise panic("countDeadPhis: deadPhis.set OOB")
		end 'deadPhi'
	end 'each'
end 'countDeadPhis'

// ==========================================================================
// Entry parameter captures + cross-param register forbidding
// ==========================================================================

// A parameter's entry capture: the SSA value id the parameter binds to and the physical
// register NUMBER it arrives in. The entry block opens with one `mov virtual(v_i),
// physical(argReg[i])` per parameter — a PARALLEL COPY from the incoming ABI registers.
// Collected once (paramCount is capped at the register-arg count), then consumed by the
// cross-param register forbidding below.
type ParamCapture
	export var valueId as ValueId
	export var incomingReg as RegNum

	export static function create(valueId ValueId, incomingReg RegNum) returns ParamCapture
		return Self{valueId: valueId, incomingReg: incomingReg}
	end 'create'
end 'ParamCapture'

export typealias ParamCaptureArray = Array with ParamCapture

// Collect `func`'s entry parameter captures: each `mov virtual(v), physical(P)` in the
// ENTRY block whose destination value id is a parameter (`v < paramCount`). Parameter
// value ids are exactly [0, paramCount) (the parser reserves them) and each is defined
// ONLY by its capture, so this matches every capture exactly and excludes the call- and
// idiv-result `mov`s (whose destinations are >= paramCount). The incoming register is read
// straight from the IR — the copy's physical source — so this needs no target ABI table.
function collectEntryParamCaptures(module TargetModule, topo FuncTopology, paramCount ParamCount) returns ParamCaptureArray
	var captures = ParamCaptureArray.create()
	if paramCount == 0 'noParams'
		return captures
	end 'noParams'

	let entry = blockAt(module, topo: topo, local: 0)
	for opIdx in entry.opRefs 'eachOp'
		let op = try module.ops.get(opIdx) otherwise panic("collectEntryParamCaptures: opIdx not in module.ops")
		match op 'capture'
			movRegReg(dst, src) then recordParamCapture(captures, dst: dst, src: src, paramCount: paramCount)
			prologue to movRegImm32 then break 'capture'
			movReg32Reg32 to popReg then break 'capture'
			storeSlotReg to loadRegSlot then break 'capture'
			andRegReg to movqXmmGpr then break 'capture'
			arm64Ret to arm64Fcsel then break 'capture'
			// `leaRegFunc`/`callReg` (P1.5-A1) and the Linux `x64Syscall` are not a `movRegReg`, so none
			// is an entry param capture — skipped exactly like every other non-`movRegReg` op here.
			leaRegFunc to x64Syscall then break 'capture'
			// The jump tables are terminators, never an entry param-capture `movRegReg`.
			x64JumpTable to arm64JumpTable then break 'capture'
			// The witness call is a call, never an entry param-capture `movRegReg`.
			callMem then break 'capture'
			// ⭐ An incoming STACK parameter is materialized by `arm64LoadIncomingArg`, not by a `movRegReg` from a
			// physical source — so it is deliberately NOT a capture. That is CORRECT and not an omission: this set
			// exists to stop one parameter's capture DESTINATION from clobbering a sibling's incoming REGISTER, and
			// a parameter that arrives in the caller's frame has no incoming register to clobber.
			arm64StoreOutgoingArg to arm64LoadIncomingArg then break 'capture'
			// Neither arm64 bit reinterpretation is a `movRegReg`, so neither is ever an entry param capture.
			arm64FmovGprFp to arm64FmovFpGpr then break 'capture'
			// Not a `movRegReg`, so never an entry param capture.
			leaRegSlot then break 'capture'
			// F1b: not a `movRegReg`, so never an entry param capture.
			x64MemFill to arm64MemFill then break 'capture'
			// F2: not a `movRegReg`, so never an entry param capture.
			x64LockCmpxchg to arm64ThreadPointer then break 'capture'
			// EC16: not a `movRegReg`, so never an entry param capture.
			leaRegBaseIndexScale to arm64AddLsl then break 'capture'
		end 'capture'
	end 'eachOp'
	return captures
end 'collectEntryParamCaptures'

// Record a `mov dst, src` as a parameter capture iff `dst` is a parameter value (a
// virtual whose id is < paramCount) and `src` is a physical register (the incoming ABI
// register). Every other `movRegReg` in the entry block — a call/idiv result move, an
// arg-setup move — fails one of the two gates and is skipped.
function recordParamCapture(captures ParamCaptureArray, dst TargetVReg, src TargetVReg, paramCount ParamCount)
	match dst 'd'
		virtual(vid) then recordParamCaptureFromPhysSource(captures, vid: vid, src: src, paramCount: paramCount)
		physical then break 'd'
	end 'd'
end 'recordParamCapture'

function recordParamCaptureFromPhysSource(captures ParamCaptureArray, vid ValueId, src TargetVReg, paramCount ParamCount)
	if vid >= paramCount 'notParam'
		return
	end 'notParam'
	match src 's'
		physical(reg) then captures.push(ParamCapture.create(vid, incomingReg: reg))
		virtual then break 's'
	end 's'
end 'recordParamCaptureFromPhysSource'

// Each entry parameter's SIBLING incoming registers — the ones it must be forbidden, closing the
// param-capture read-after-clobber hole.
//
// The captures `mov color(v_i), argReg[i]` are emitted naively in slot order and form a parallel copy
// whose SOURCES are physical registers; unlike the arg-SETUP direction (physical DEFs the backward
// sweep already folds into `forbidden`), nothing otherwise stops an earlier capture's DESTINATION from
// being colored onto a later parameter's incoming SOURCE register, clobbering it before that capture
// reads it. Forbidding the sibling incoming registers forces v_i into its OWN argReg[i] (the capture
// self-move then elides) or a non-parameter register (whose write clobbers no sibling source) — so the
// in-order emit is safe regardless of coloring order.
//
// IT IS A TYPE, resolved once per function, because it is the ONE contribution to `forbidden` that
// does not come from a block sweep — so the splitter, which rebuilds the victim's mask from the blocks
// it is live in, has to re-apply it by hand when the victim is a parameter. Re-walking the entry block
// to find that out would put an O(entry block) term back on the per-split path.
export type ParamCrossForbid
	var captures as ParamCaptureArray
	// The union of every capture's incoming register. Left at 0 when there are fewer than two captures:
	// with one parameter there is no sibling to cross, so every mask below comes out empty.
	var allParamRegs as RegMask

	export static function resolve(module TargetModule, topo FuncTopology, paramCount ParamCount) returns ParamCrossForbid
		let captures = collectEntryParamCaptures(module, topo: topo, paramCount: paramCount)
		var allParamRegs = 0 as RegMask
		if captures.count() >= 2 'haveSiblings'
			for cap in captures 'union'
				allParamRegs = regMaskAdd(allParamRegs, regNum: cap.incomingReg)
			end 'union'
		end 'haveSiblings'
		return Self{captures: captures, allParamRegs: allParamRegs}
	end 'resolve'

	// The registers `valueId` must avoid because a SIBLING parameter arrives in them — 0 for every
	// value that is not an entry parameter capture.
	//
	// The `allParamRegs == 0` exit is not an optimization of the scan, it is the scan's own answer
	// stated once instead of `captures` times: `resolve` leaves that union at 0 exactly when there are
	// fewer than two captures, and with fewer than two the loop below returns `regMaskRemove(0, …)` —
	// which IS 0 — for every value it could match. It is what keeps this callable per VALUE rather than
	// only per capture, and `nonSweptForbidOf` is why that matters.
	export function maskFor(valueId ValueId) returns RegMask
		if self.allParamRegs == 0 'noSiblingToCross'
			return 0
		end 'noSiblingToCross'

		for cap in self.captures 'each'
			if cap.valueId == valueId 'itsCapture'
				return regMaskRemove(self.allParamRegs, regNum: cap.incomingReg)
			end 'itsCapture'
		end 'each'
		return 0
	end 'maskFor'
end 'ParamCrossForbid'

// ⭐⭐ **EVERY CONTRIBUTION TO A VALUE'S `forbidden` THAT IS NOT "WHAT DID ITS LIVE RANGE CROSS?" —
// THE LIST, IN ONE PLACE.**
//
// Two passes must apply it and they run in different worlds: `computeLivenessOn` folds it into a mask
// the block sweeps have just built, and the splitter's `rebuildForbiddenOf` folds it into a mask it
// has just ZEROED (`clearForbidden`) and is re-deriving from the blocks the victim is live in. Neither
// can get it from the other, because neither is a block fact.
//
// ⛔ **IT IS ONE FUNCTION BECAUSE A THIRD CONTRIBUTION MUST NOT BE ABLE TO REACH ONE PASS AND NOT THE
// OTHER.** Spelled twice, adding one and forgetting the other compiles, passes every test whose split
// count is zero, and shows up as a value coloured into a register something else already owns — a
// silent wrong answer, at a call, in code the golden gate does not pin. `VerifyIncrementalSplit`
// catches it and is OFF in a shipping compiler; this makes the question not arise.
//
// It is asked per VALUE, so `ParamCrossForbid.maskFor` answers in O(1) for the functions that have no
// sibling parameters at all and O(captures) — at most one per parameter — for the rest.
export function nonSweptForbidOf(v ValueId, paramCross ParamCrossForbid, establishedAtDef RegMaskColumn) returns RegMask
	let established = try establishedAtDef.get(v) otherwise panic("nonSweptForbidOf: establishedAtDef.get OOB for value {v}")

	return paramCross.maskFor(v) or established
end 'nonSweptForbidOf'

// Process one op backward: fold its register clobbers into `forbidden` for values
// live across it, then transform `liveRow` from live-after to live-before. Returns the
// pressure this op contributes — the live-before population, PLUS this op's transient
// register (see `addOpTransientPressure`).
function stepBackwardOverOp(module TargetModule, opIdx OpIndex, liveRow BitWordArray, forbidden RegMaskColumn, buf OperandList, wordsPerRow BitWordCount, liveBuf ValueIdArray, liveByClass RegCountColumn, classes ValueClassColumn, pressureOut RegCountColumn, opFacts OpVariantFacts)
	let op = try module.ops.get(opIdx) otherwise panic("stepBackwardOverOp: opIdx not in module.ops")
	// This also fills `buf` with the op's operands, which everything below reads.
	let clobberMask = opClobberMask(op, buf: buf, opFacts: opFacts)

	// Read the op's transient BEFORE the backward step mutates `liveRow` — it still holds the
	// live-AFTER set here, which is where both "does the reuse input outlive the op?" and "is this
	// def dead?" are decided. `pressureOut` starts as the transient alone and the live-before
	// population is added after the step, so the two halves are each counted in the file they
	// actually occupy.
	classRowZero(pressureOut)
	addOpTransientPressure(buf, liveRow: liveRow, classes: classes, pressureOut: pressureOut)

	if clobberMask != 0 'hasClobber'
		applyForbidden(liveRow, forbidden: forbidden, buf: buf, clobberMask: clobberMask, wordsPerRow: wordsPerRow, liveBuf: liveBuf)
	end 'hasClobber'

	// An op's EXPLICIT virtual operands must additionally avoid the op's IMPLICIT
	// registers (its implicit reads AND writes). `applyForbidden` above only covers
	// values LIVE ACROSS the op (present in the live-after set); an operand that DIES at
	// the op — the common case for `idiv`'s divisor — is absent from that set, so it
	// would otherwise be free to color into RAX/RDX. But at the `idiv` the divisor cannot
	// be RAX (holds the dividend) or RDX (the cqo sign-extension, then the remainder), so
	// it must avoid implicitUses ∪ implicitDefs = {RAX, RDX}. This mask is 0 for every op
	// without implicit registers, so the loop is a no-op except at `idiv`.
	let implicitTouch = opFacts.implicitUsesOf(op) or opFacts.implicitDefsOf(op)
	if implicitTouch != 0 'hasImplicit'
		forbidOperandsFromImplicit(forbidden, buf: buf, implicitMask: implicitTouch)
	end 'hasImplicit'

	stepRowBackwardOverOperands(liveRow, base: 0, buf: buf, liveByClass: liveByClass, classes: classes)

	// This op's pressure, per file: the live-BEFORE population of that file, plus the op's transient
	// already folded in above if the register it holds belongs to that file.
	for classOrdinal in 0 upto RegClassCount 'eachClass'
		let class = regClassAt(classOrdinal)
		classRowSet(pressureOut, class: class, value: classRowGet(pressureOut, class: class) + classRowGet(liveByClass, class: class))
	end 'eachClass'
end 'stepBackwardOverOp'

// Every register `op` WRITES without being a virtual def: its implicit-def mask (a call's 9
// caller-saved plus all 16 XMMs, an `idiv`'s RAX/RDX) plus each PHYSICAL def operand (an argument
// pre-move's `mov argReg, v`). A value live ACROSS the op must avoid every one of them, which is
// exactly what `forbidden` accumulates.
//
// ⚠ IT IS ONE FUNCTION BECAUSE IT IS ONE FACT. The liveness sweep folds this mask into `forbidden`;
// the splitter asks the same question in the other direction — "would a reload spanning this op be
// left with NO register at all?" (`opStrandsClass`). Written twice, the two would drift, and the
// splitter would then mint reloads it believes are free of a clobber the sweep has already forbidden
// them — which is a value the driver re-picks for ever, not a wrong answer any test would notice.
//
// `buf` is filled with `op`'s operands as a side effect, which every caller wants anyway.
export function opClobberMask(op TargetOp, buf OperandList, opFacts OpVariantFacts) returns RegMask
	targetOpOperands(op, buf: buf)
	return opFacts.implicitDefsOf(op) or physicalDefMask(buf)
end 'opClobberMask'

// The registers `buf`'s operands write BY NAME rather than by allocation — every PHYSICAL def (a
// call's `mov argReg[k], v` pre-move, the return move, an `idiv`'s `mov rax, dividend`). It is the
// operand half of `opClobberMask`, split out because `sweepEstablishedRegisters` asks for it ALONE:
// that sweep OPENS a pending window at a named write and CLOSES it at an implicit def, so the two
// halves of a clobber mask arrive at opposite ends of the window and cannot be handed over as one
// number. Asking `opClobberMask` there would open a window on every call — whose implicit-def mask is
// the entire caller-saved half — for registers that call has just destroyed.
//
// ⚠ IT DOES NOT FILL `buf`; `opClobberMask` does, and every other caller must (`targetOpOperands`).
// The split is what makes that asymmetry possible, so it is stated rather than left to be discovered.
//
// A physical DEF's register number is a target-neutral `RegNum`, NOT an `X64Register`: this SHARED
// census sees arm64 SIMD arg registers (d1..d7 = 32..38) a multi-float-argument call emits, which
// the x64 `operandRegister`/`X64Register.fromRawValue` door range-check-panicked on. `regMaskAdd`
// forms the same clobber bit from the `RegNum` directly — bit-identical for the x64 registers this
// already handled (an `X64Register.rawValue` IS its `RegNum`).
function physicalDefMask(buf OperandList) returns RegMask
	var mask = 0 as RegMask
	for o in buf 'physDefs'
		if operandIsDef(o) and not operandIsVirtual(o) 'physDef'
			mask = regMaskAdd(mask, regNum: operandPhysicalRegNum(o))
		end 'physDef'
	end 'physDefs'
	return mask
end 'physicalDefMask'

// Add this op's TRANSIENT register demand to `pressureOut`, in the FILE the register belongs to: the
// registers the colorer holds AT the op that are in NO live set, and which the op-boundary popcounts
// therefore cannot see. There are two, they are mutually exclusive, and they are the same fact about
// one operand — "this op's def needs a register that this op does not free":
//
//  • THE REUSE-COPY TRANSIENT. The allocator materializes `mov dest, input` BEFORE an op whose reuse
//    INPUT is live AFTER it (`allocateReuseDef`), so `dest` co-exists with everything live entering
//    the op — a pressure of |live-before-op| + 1.
//
//  • ⭐ THE DEAD-DEF TRANSIENT. A def that is live at NO program point still gets a real register:
//    `mov rax, [rbp+96]` CLOBBERS rax whether or not anything ever reads the value, so the colorer
//    must hand it one (`allocateDef` is called for every virtual def, dead or not). Being in neither
//    the live-before nor the live-after set, such a value is invisible to every popcount — so the
//    splitter saw no overflow, declared the function relieved, and the colorer then died with every
//    register blocked. This is the OP-DEF twin of the DEAD-PHI reservation the block-level correction
//    already carries; only the phi half existed. (Measured: a 15-parameter function whose LAST
//    parameter is unused panicked `chooseRegister` on x64, and 27 on arm64 — one past each pool. Every
//    `__fnref_` env-thunk is that shape by construction, its trailing `__env` parameter being
//    materialized and never read, which is why an INDIRECT call panicked one arity EARLIER than a
//    direct one: `specs-shv2/register-pressure.md`.)
//
//    It is charged only when the op frees NO register OF THE DEF'S OWN FILE. A def may take the
//    register of a use that DIES here (`allocateDef`'s `dyingRegs`), so `lea dead, a, b` with `a` dying
//    costs nothing extra; with both uses live-after it costs one. And a def that is LIVE after the op is
//    charged NOTHING here — it is already counted as live-before at the next op (or as live-out of the
//    block), which is where this model has always billed it, so nothing that compiled before moves.
//
//    ⚠ THE FILE IS PART OF "FREES A REGISTER", AND LEAVING IT OUT LEFT THE PANIC REACHABLE. `dyingRegs`
//    names every dying operand's register whatever file it is in, but `allocateDef` ORs
//    `fullRegisterMask() and not classPool` into `blocked`, so a def can only ever inherit one of its
//    OWN file's. A dying XMM therefore frees nothing a dead GPR def can use: `cvttsd2si dead, x` with
//    `x` dying still wants a fifteenth GPR, and a class-blind test scored it zero and walked the
//    colorer straight back into `chooseRegister`'s panic — the same wrong answer this correction
//    exists to remove, one register file over. (Measured both ways: 14 live ints + `x as int`, and 16
//    live floats + `y as float`.)
//
// `liveRow` must still be the live-AFTER set (call it BEFORE the backward step, where a live-after
// input is present and a use has not yet been re-added). Def-ness, reuse-ness and the input value all
// come from the operand model, never from hardcoded opcodes.
//
// THE TRANSIENT IS THE DEF'S REGISTER, so it belongs to the DEF's file — not the reuse input's, and
// not "the pool". They are the same file for every two-address op, but the fact that decides it is the
// one the allocation actually consumes.
//
// It ADDS to a row rather than returning a bool, so the splitter's peak-finder, the index build and
// this pass call the ONE implementation and cannot disagree about where the transient lands — they
// must agree or the splitter false-panics (see SplitLiveRanges.analyzePressure). At most one is added,
// which `opTransientDefOf` below decides and states once.
export function addOpTransientPressure(buf OperandList, liveRow BitWordArray, classes ValueClassColumn, pressureOut RegCountColumn)
	let (found, defId, isReuse, reuseInputId) = opTransientDefOf(buf)
	if not found 'noVirtualDef'
		return
	end 'noVirtualDef'

	let defClass = valueClass(defId, classes: classes)
	if isReuse 'reuseDef'
		// Against the FULL pool a reuse def whose input DIES here simply inherits the input's register
		// and costs nothing; one whose input outlives the op needs a register of its own.
		if bitsetTest(liveRow, base: 0, bit: reuseInputId) 'inputLiveAfter'
			classRowSet(pressureOut, class: defClass, value: classRowGet(pressureOut, class: defClass) + 1)
		end 'inputLiveAfter'
		return
	end 'reuseDef'

	if bitsetTest(liveRow, base: 0, bit: defId) 'defLiveAfter'
		return
	end 'defLiveAfter'
	if anyVirtualUseDiesAt(buf, liveRow: liveRow, classes: classes, class: defClass) 'thisOpFreesARegister'
		return
	end 'thisOpFreesARegister'
	classRowSet(pressureOut, class: defClass, value: classRowGet(pressureOut, class: defClass) + 1)
end 'addOpTransientPressure'

// ⭐⭐ **THE OP'S ONE TRANSIENT-HOLDING DEF, SELECTED IN EXACTLY ONE PLACE.** Both transient questions
// — the FULL-POOL one above and the CONFINED one below — begin by finding the same operand under the
// same rule, and each used to walk `buf` for it with its own copy of that rule.
//
// ⛔ That was one fact written twice, in the file whose most reliable bug signature it is. The premise
// *"no `TargetOp` defines more than one value, so the FIRST virtual def decides the whole answer"* lived
// in two loops; `refreshTransientAt` PANICS when a second virtual def appears (it counts them), while
// the second copy would silently have taken the first and answered for an op it does not describe. A
// clause added to one walk and not the other is a wrong pressure figure — a colorer panic or an
// unrelieved point — never a compile error.
//
// The tuple is `(found, defId, isReuse, reuseInputId)`: `defId` and `isReuse` are meaningless unless
// `found`, and `reuseInputId` unless `isReuse`. A discriminated record, not a sentinel.
function opTransientDefOf(buf OperandList) returns (bool, ValueId, bool, ValueId)
	for o in buf 'each'
		if not (operandIsDef(o) and operandIsVirtual(o)) 'notAVirtualDef'
			continue
		end 'notAVirtualDef'

		if not operandIsReuseDef(o) 'plainDef'
			return (true, operandValueId(o), false, 0)
		end 'plainDef'
		return (true, operandValueId(o), true, operandReuseInputValueId(o, buf: buf))
	end 'each'
	return (false, 0, false, 0)
end 'opTransientDefOf'

// ⭐⭐ **THE SAME REGISTER, ASKED ABOUT THE CONFINED POOL — AND THE ANSWER IS NOT THE SAME.**
// `addOpTransientPressure` above answers for the FULL pool, where a reuse def whose input DIES here
// simply takes the input's register and costs nothing. Against a CONFINED pool that inheritance is
// not free: the def may only hold registers in its own admissible set, and the register the input
// was holding need not be in it. A `carry` that is live across the next call may live only in the 5
// callee-saved registers, while the `widened` it reuses crosses no call and was very likely coloured
// into a caller-saved one — so the def must find a SIXTH callee-saved register, and there are five.
//
// ⛔ The confined census used to see none of this, on the premise recorded at `analyzeBlockPressure`
// that *"a transient is not a value, so it is not CONFINED by anything"*. A reuse def IS a value. The
// result was a point that overflowed the callee-saved subset invisibly: the splitter relieved
// nothing, and the colorer died with `forbidden` covering the caller-saved half and the held set
// covering the rest (`specs-shv2/register-pressure.md`'s `reuse-def-confined-by-a-later-call`).
//
// The inheritance test is a MASK CONTAINMENT and therefore exact without knowing any colour yet:
// the def can be guaranteed the input's register only when EVERY register the input may hold is one
// the def may hold too (`forbidden(def) ⊆ forbidden(input)`). Anything less is a maybe, and a
// pressure analysis that answers "maybe" has to answer "yes, it competes".
//
// The pair is `(competes, v)`, `v` meaningful only when `competes` — a discriminated pair, not a
// sentinel. It selects the op's def through `opTransientDefOf`, the same one the full-pool answer
// uses, so the two can differ in their RULE and never in which register they are talking about.
export function opConfinedTransient(buf OperandList, liveRow BitWordArray, liveness LivenessResult) returns (bool, ValueId)
	let (found, defId, isReuse, reuseInputId) = opTransientDefOf(buf)
	if not found 'noVirtualDef'
		return (false, 0)
	end 'noVirtualDef'

	if not isReuse 'plainDef'
		// ⛔⛔ **A PLAIN DEF THAT IS LIVE NOWHERE IS THE OTHER HALF OF THIS HOLE, AND IT IS NOT COVERED
		// BY BEING "its own live range's demand".** A def the census sees at every op of its range needs
		// nothing here; a def with NO range is seen at no op, while its register is as real as any
		// other — which is the sentence `chooseRegister`'s exhaustion panic already carried about the
		// FULL pool ("a reuse copy and a DEAD DEF are the two"). The full-pool half of it was closed
		// when `addReuseTransientPressure` became `addOpTransientPressure`; this is the confined half,
		// which was left behind because the premise this arm used to state — *"its confined demand is
		// its own live range's"* — is vacuously true of a value that has no live range.
		//
		// The mask is what makes it a CONFINED competitor rather than merely a full-pool one: a dead
		// def admissible everywhere competes for the machine and `addOpTransientPressure` bills it, but
		// one carrying a non-empty `forbidden` set competes for a SUBSET that no popcount over a live
		// population can see.
		//
		// ⚠⚠ **NO SPEC PINS THIS ARM, DELIBERATELY, AND A READER MUST NOT MISTAKE THAT FOR COVERAGE.**
		// The SHAPE was measured reachable — a temporary detector fired on seven programs, each an
		// UNUSED PARAMETER whose mask comes from `ParamCrossForbid` (its siblings' incoming argument
		// registers), reaching this arm with the census running. A FAILING program could not be built:
		// `E3012 unused variable` forbids an unused parameter in source, so every one of those seven is
		// a compiler-SYNTHESIZED function (a closure thunk, a witness shim, a first-class-function
		// trampoline), and those are far too small to over-subscribe a confined pool. A discarded
		// `idiv` result is elided by the front end, and a 13-in-12 construction on
		// `idiv-under-loop-pressure`'s one register of slack does not fail either.
		//
		// So this arm is a demand that is REAL and was UNACCOUNTED, closed on that ground and measured
		// behaviour-neutral across the corpus — not a fix with a regression test behind it. If a future
		// change makes a synthesized function big enough, or lets a user write an unused parameter,
		// nothing here will turn red first.
		//
		// ⚠ NO "a use dies here" RELIEF, unlike the full-pool arm below. The register a dying use
		// vacates need not be one this def may hold — the same argument the reuse arm makes — and a
		// pressure analysis that cannot prove the inheritance has to assume the competition.
		return (not bitsetTest(liveRow, base: 0, bit: defId) and liveness.forbiddenOf(defId) != 0, defId)
	end 'plainDef'

	if bitsetTest(liveRow, base: 0, bit: reuseInputId) 'inputLiveAfter'
		return (true, defId)
	end 'inputLiveAfter'
	return (not neederMayTakeAnyRegisterOf(liveness, holder: reuseInputId, needer: defId), defId)
end 'opConfinedTransient'

// Is every register `holder` may hold one that `needer` may hold too? A subset test on the FORBIDDEN
// masks, which run the other way: `A(v) = pool \ forbidden(v)`, so `A(holder) ⊆ A(needer)` is exactly
// `forbidden(needer) ⊆ forbidden(holder)`. Both must also be of the same FILE — an int can never
// inherit an XMM — which the class test states rather than leaving to the masks.
function neederMayTakeAnyRegisterOf(liveness LivenessResult, holder ValueId, needer ValueId) returns bool
	if liveness.classOf(holder) != liveness.classOf(needer) 'differentFiles'
		return false
	end 'differentFiles'
	return (liveness.forbiddenOf(needer) and not liveness.forbiddenOf(holder)) == 0
end 'neederMayTakeAnyRegisterOf'

// Does any of `buf`'s VIRTUAL uses OF `class` die at this op — i.e. is it absent from the live-AFTER
// row? Those are the registers `BlockDeaths` hands the colorer as `dyingRegs` MINUS the ones
// `allocateDef`'s class filter then puts straight back into `blocked`, so this is exactly the set a def
// of `class` can actually inherit. One dying use is enough: no `TargetOp` defines more than one value,
// so one freed register covers the whole demand.
function anyVirtualUseDiesAt(buf OperandList, liveRow BitWordArray, classes ValueClassColumn, class RegClass) returns bool
	for o in buf 'each'
		if (not operandIsDef(o)) and operandIsVirtual(o) and operandClass(o, classes: classes) == class 'virtualUseOfThisFile'
			if not bitsetTest(liveRow, base: 0, bit: operandValueId(o)) 'diesHere'
				return true
			end 'diesHere'
		end 'virtualUseOfThisFile'
	end 'each'
	return false
end 'anyVirtualUseDiesAt'

// Transform a live/seen bitset ROW from live-AFTER an op to live-BEFORE it: remove the
// op's virtual defs, then add its virtual uses. Defs are removed FIRST so a read-
// modify-write value (removed by its def, re-added by its own use) stays live. `buf`
// must already hold the op's operands. Shared by the liveness pressure sweep
// (`stepBackwardOverOp`) and the colorer's per-block death computation — an identical
// backward SSA transfer that must not drift between the two.
// (`OpPressure` is gone. It paired an op's PRESSURE with the live POPULATION before it, as two
// scalars, when both are now per-class ROWS: `liveByClass` IS the live-before population — the step
// leaves it there — and `pressureOut` is the pressure. Two caller-owned rows, mutated in place, and a
// per-op heap object off the allocator's hottest path.)

// Takes the row's live POPULATION before the step and returns it after — maintained INCREMENTALLY,
// by counting only the bits that actually flip. Recomputing it with a popcount over the whole row
// instead would be O(values/64) at EVERY op — O(ops × values/64) per function, the last quadratic in
// the allocator and, on a large function, the single biggest remaining cost. A step flips at most
// the op's own operands, so the count is O(operands).
// ⭐ THE PER-CLASS TALLY COSTS ZERO EXTRA WALKS, and that is why it lives HERE rather than in a
// second pass. This function IS the code that flips the bit, so it already knows — inline, at the
// only place the fact exists — which values entered and left. A tally maintained here is one array
// read per FLIPPED operand; the alternatives are a snapshot/compare pass (a second walk) or a
// re-derivation of "def && was live" somewhere else, which would duplicate this transfer function
// into a second place and let the two drift silently apart. That drift is the class of pressure bug
// the whole sparse design exists to end.
//
// `liveByClass` IS the population — the caller reads it after the step, and the total is
// `classRowTotal`. There is no separate count to return and therefore no second counter to disagree
// with the row it summarises.
export function stepRowBackwardOverOperands(row BitWordArray, base BitWordIndex, buf OperandList, liveByClass RegCountColumn, classes ValueClassColumn)
	for o in buf 'removeDefs'
		if operandIsDef(o) and operandIsVirtual(o) 'vd'
			let v = operandValueId(o)
			if bitsetTest(row, base: base, bit: v) 'wasLive'
				bitsetRemove(row, base: base, bit: v)
				stepClassLive(liveByClass, classes: classes, v: v, entering: false)
			end 'wasLive'
		end 'vd'
	end 'removeDefs'

	for o in buf 'addUses'
		if (not operandIsDef(o)) and operandIsVirtual(o) 'vu'
			let v = operandValueId(o)
			if not bitsetTest(row, base: base, bit: v) 'wasDead'
				bitsetAdd(row, base: base, bit: v)
				stepClassLive(liveByClass, classes: classes, v: v, entering: true)
			end 'wasDead'
		end 'vu'
	end 'addUses'
end 'stepRowBackwardOverOperands'

// For each value LIVE ACROSS this op (in `liveRow`, and not one of the op's own defs), add
// `clobberMask` to its forbidden registers.
//
// ⚠ IT IS THE WHOLE-FUNCTION BUILD'S ONLY, and it used to take a SCOPE so a split could re-derive just
// the handful of masks it invalidated by re-walking every op of every dirty block. That is what the
// splitter now reads off `PressureIndex.clobberOr` — one RANGE OR per block of the value's live range
// instead of a walk of each — so the narrow scope has no caller left and the parameter went with it.
//
// It walks the SET BITS of the live row, not the value space: this runs at every CLOBBER op, so testing
// each value id would be O(clobber-ops × values). `liveBuf` is scratch reused across ops.
function applyForbidden(liveRow BitWordArray, forbidden RegMaskColumn, buf OperandList, clobberMask RegMask, wordsPerRow BitWordCount, liveBuf ValueIdArray)
	bitsetCollectRow(liveRow, base: 0, wordsPerRow: wordsPerRow, out: liveBuf)
	for v in liveBuf 'eachTarget'
		if operandDefinesValue(buf, v: v) 'ownDef'
			continue
		end 'ownDef'
		let cur = try forbidden.get(v) otherwise panic("applyForbidden: forbidden.get OOB")
		try forbidden.set(v, value: cur or clobberMask) otherwise panic("applyForbidden: forbidden.set OOB")
	end 'eachTarget'
end 'applyForbidden'

function operandDefinesValue(buf OperandList, v ValueId) returns bool
	for o in buf 'each'
		if operandIsDef(o) and operandIsVirtual(o) and operandValueId(o) == v 'match'
			return true
		end 'match'
	end 'each'
	return false
end 'operandDefinesValue'

// Add `implicitMask` (the op's implicit reads ∪ writes) to the forbidden set of every
// EXPLICIT VIRTUAL operand of the op. Unlike `applyForbidden` (which forbids values live
// ACROSS the op), this forbids the op's OWN operands regardless of whether they outlive
// it — so `idiv`'s divisor, which dies at the op and is thus absent from the live-across
// set, is still kept out of the implicit RAX/RDX pair.
//
// CORRECT ONLY for ops whose implicit registers conflict SIMULTANEOUSLY with the operand —
// `idiv` reads RAX/RDX in the SAME instruction that reads the divisor, so the divisor
// genuinely cannot occupy them. It is NOT correct for a LATE-clobber op such as a call:
// a call's `implicitDefs` clobber AFTER its args are consumed, so an arg (an EARLY use)
// may legally sit in a caller-saved (clobbered) arg register.
//
// M5.6 SIDESTEPS this rather than making the helper position-aware: the call (`callDirect`)
// carries NO explicit register operands — its arguments are PRE-MOVED into their physical
// ABI registers by separate `mov argReg[k], arg_k` ops (see StdToX64Conversion.lowerCall),
// so `targetOpOperands(callDirect)` is empty and this helper iterates nothing on a call.
// The call's caller-saved `implicitDefs` still flow, correctly, ONLY through `applyForbidden`
// (values LIVE ACROSS the call, never the call's own — non-existent — operands). So the only
// caller whose operands this touches is `idiv`/`cqo` (simultaneous-conflict), for which the
// simple form is sound. Reads the operand model rather than hardcoding opcodes.
function forbidOperandsFromImplicit(forbidden RegMaskColumn, buf OperandList, implicitMask RegMask)
	for o in buf 'each'
		if operandIsVirtual(o) 'virt'
			let v = operandValueId(o)
			let cur = try forbidden.get(v) otherwise panic("forbidOperandsFromImplicit: forbidden.get OOB")
			try forbidden.set(v, value: cur or implicitMask) otherwise panic("forbidOperandsFromImplicit: forbidden.set OOB")
		end 'virt'
	end 'each'
end 'forbidOperandsFromImplicit'

// ==========================================================================
// THE PER-VARIANT OP FACTS — asked at every op of every re-swept block, derived ONCE
// ==========================================================================

// What role an op plays in the SPILL-SLOT model — the ONE place "did the splitter put a value in a
// stack slot here, and did this op WRITE it there?" is decided, so no consumer can drift on it.
//
// It replaces a pair of `ValueSpillSlot`-returning classifiers (`spillStoreSlotOf` and its wider twin
// `slotResidencyOf`) that answered the two halves of this question separately. THREE cases is what
// they were between them, and stating it as three has two consequences neither had:
//
//  • THE SLOT LEAVES THE ANSWER. A `ValueSpillSlot` is a payload-carrying union, so Maxon heap-boxes
//    EVERY value of it — `ValueSpillSlot.none` included (measured: a payload-free case of such a union
//    lowers to `mm_alloc` + `mm_incref`). `indexBlockFacts` asked both questions of every op of every
//    DIRTY block of every split, so the two `none`s were TWO HEAP ALLOCATIONS PER OP PER SPLIT, for the
//    ~98% of ops that touch no slot at all. An enum allocates nothing, and the SLOT — the only part
//    that needs the op's payload — is now read only where there is one (`slotOfSlotOp`).
//  • IT IS A FUNCTION OF THE VARIANT ALONE, so it memoizes (see `OpVariantFacts`).
export enum OpSlotRole
	// Neither writes a value into a spill slot nor reads one out of one. Every op but the two below.
	touchesNoSlot
	// `storeSlotReg`: the splitter spilled a value to a stack SLOT here. `buildUseIndex` records the
	// value the store reads as already-spilled AND the slot it went to (the splitter reloads out of that
	// same slot when it relieves the value again at a second peak). The use-rewriter reads the same
	// answer to leave a store ALONE — a store deliberately reads the ORIGINAL value, so repointing it at
	// the reload would make it read a value defined later.
	spillStore
	// `loadRegSlot`: the value was read OUT of its slot here — and a read does not vacate a stack slot,
	// so the value is still resident in it afterwards.
	slotReload
end 'OpSlotRole'

typealias OpSlotRoleColumn = Array with OpSlotRole

// A `TargetOp` case's zero-based DECLARATION POSITION (`op.ordinal`) — the key `OpVariantFacts` is
// indexed by. Dense over the union's own cases, and the space is the case count, so a column over it is
// a constant however large the module is. Wide because the case count has no literal to bound it with.
typealias TargetOpVariant = int(0 to u64.max)

// THE STATIC FACTS OF A `TargetOp` VARIANT, derived on first sight of that variant and then read.
//
// ⚠ IT IS KEYED BY THE VARIANT, NOT BY THE OP, AND THAT IS THE WHOLE DESIGN. Every fact here is
// `op.rawValue.<field>` or a `match` over the op's case with no payload read — i.e. a pure function of
// which CASE the op is. So the key is `op.ordinal`, the memo is the size of the union (112 cases today)
// rather than the size of the program, and there is no staleness class to reason about: an op's case
// cannot change (the splitter's `substituteValueInOp` rebuilds each op as the IDENTICAL case), and even
// if one somehow did, the answer would be re-derived under its own key rather than served stale.
//
// ⚠⚠ AN OP-KEYED CACHE WOULD HAVE BEEN THE WRONG SHAPE, and not by a little: `OpIndex` indexes
// `module.ops`, which is the WHOLE MODULE's flat op array, while every buffer the allocator owns is
// per FUNCTION. A dense column over that index space, built per function, is Θ(module ops) per
// function — Θ(functions × module ops) over a compile — and there is no cheaper sizing available,
// because a function's op indices are NOT contiguous: `splitCriticalEdges` appends one terminator per
// split edge of EVERY function before the allocator's per-function loop starts, so a function whose own
// ops begin at index 0 still names an op near the end of the array.
//
// ⭐ WHY IT CANNOT COST MORE THAN NOT HAVING IT. The fill IS the computation the caller would have made
// anyway — the first op of a given case pays exactly the derivation it always paid, and every later op
// of that case pays an array read. There is no eager pass, no warm-up, and nothing to invalidate.
//
// ⚠ IT IS BUILT PER FUNCTION AND ITS CONTENTS ARE PROGRAM-WIDE, which is a lifetime the allocator's
// SHAPE imposes rather than one this type wants: `computeLivenessOn` is the first place both consumers
// (the index build and the pressure sweep) can share one, and it is entered once per function. So every
// function re-derives the ~30 cases its own ops name and pays a handful of column reallocations to hold
// them. Hoisting it to the module — one memo for the whole compile, four allocations in total, each
// case derived once ever — is a strictly better lifetime and needs the object created in
// `allocateRegisters` and threaded through `allocateFunction`, i.e. a change in RegisterAllocator.maxon.
//
// WHAT IT REPLACES, and why it is worth a type: `op.rawValue.<field>` on a struct-backed union lowers
// to a SELECT CHAIN over every case — the bootstrap emits `const`/`cmp`/`const`/`select` per case, and
// the chain is branchless, so ALL of it runs on every read. At 112 cases that is ~450 instructions to
// fetch one integer, and the allocator's hot walks fetch it at every op of every dirty block of every
// split. (`opClobberMask` 7.7% / `opIsFixedRegisterPoint` 2.7% / `slotResidencyOf` 2.8% of a whole
// compile, measured on `Testing/ladders/genwidelive.sh 400 sum`.)
export type OpVariantFacts
	// Registers the variant WRITES without naming them as an explicit operand (a call's caller-saved
	// set, an `idiv`'s RAX/RDX), and those it READS the same way (`ret`'s R8).
	var implicitDefs as RegMaskColumn
	var implicitUses as RegMaskColumn
	var slotRole as OpSlotRoleColumn
	// Has this variant been seen? A parallel flag rather than an out-of-band value in the columns
	// above: 0 is a legitimate implicit mask (every op but a call and `idiv` has one), so no mask can
	// mean "not derived yet".
	var known as BoolArray

	export static function create() returns OpVariantFacts
		return Self{implicitDefs: RegMaskColumn.create(), implicitUses: RegMaskColumn.create(), slotRole: OpSlotRoleColumn.create(), known: BoolArray.create()}
	end 'create'

	// Registers `op` clobbers implicitly — a call's caller-saved set, an `idiv`'s RAX/RDX; 0 for every
	// other op.
	export function implicitDefsOf(op TargetOp) returns RegMask
		return try self.implicitDefs.get(self.learn(op)) otherwise panic("OpVariantFacts.implicitDefsOf: implicitDefs.get OOB — `learn` grows every column to the variant it returns")
	end 'implicitDefsOf'

	// Registers `op` READS without naming them as an explicit operand — `ret`'s R8, an `idiv`'s
	// RAX/RDX; 0 for every other op.
	export function implicitUsesOf(op TargetOp) returns RegMask
		return try self.implicitUses.get(self.learn(op)) otherwise panic("OpVariantFacts.implicitUsesOf: implicitUses.get OOB — `learn` grows every column to the variant it returns")
	end 'implicitUsesOf'

	// What `op` does to a spill slot — see `OpSlotRole`.
	export function slotRoleOf(op TargetOp) returns OpSlotRole
		return try self.slotRole.get(self.learn(op)) otherwise panic("OpVariantFacts.slotRoleOf: slotRole.get OOB — `learn` grows every column to the variant it returns")
	end 'slotRoleOf'

	// `op`'s variant, with every column holding that variant's answers. The ONE derivation site, so a
	// fact cannot be memoized under one rule and read under another.
	function learn(op TargetOp) returns TargetOpVariant
		let variant = op.ordinal as TargetOpVariant
		if variant >= self.known.count() 'aWiderVariantSpaceThanSeenSoFar'
			// TIGHT, to the highest variant this function has actually met — not to a chunk covering the
			// whole union. MEASURED both ways on the scale corpus's rung 0 (78 functions): growing in
			// 128-slot chunks saves ~16 reallocations per function and costs ~2.6 KB per function,
			// because a real function names only 30-40 of the 112 cases and the rest of the chunk is
			// never read. It is a wash in allocations and a loss in bytes, so the columns stay tight.
			//
			// The reallocations it does cost are a per-FUNCTION term, and they exist only because this
			// memo is built per function while its CONTENTS are a property of the DIALECT — see the type
			// header's note on lifetime.
			self.implicitDefs.growFilled(variant + 1, value: 0)
			self.implicitUses.growFilled(variant + 1, value: 0)
			self.slotRole.growFilled(variant + 1, value: OpSlotRole.touchesNoSlot)
			self.known.growFilled(variant + 1, value: false)
		end 'aWiderVariantSpaceThanSeenSoFar'

		let derived = try self.known.get(variant) otherwise panic("OpVariantFacts.learn: known.get OOB at variant {variant}, which the growth above covers")
		if derived 'alreadyDerived'
			if VerifyOpVariantFacts 'checkAgainstTheOpItself'
				self.verifyAgainst(op, variant: variant)
			end 'checkAgainstTheOpItself'
			return variant
		end 'alreadyDerived'

		try self.implicitDefs.set(variant, value: op.rawValue.implicitDefs) otherwise panic("OpVariantFacts.learn: implicitDefs.set OOB at variant {variant}")
		try self.implicitUses.set(variant, value: op.rawValue.implicitUses) otherwise panic("OpVariantFacts.learn: implicitUses.set OOB at variant {variant}")
		try self.slotRole.set(variant, value: deriveSlotRole(op)) otherwise panic("OpVariantFacts.learn: slotRole.set OOB at variant {variant}")
		try self.known.set(variant, value: true) otherwise panic("OpVariantFacts.learn: known.set OOB at variant {variant}")
		return variant
	end 'learn'

	// VERIFY MODE's whole body: re-derive all three facts from the op in hand and compare them against
	// what this variant's entry holds. See `VerifyOpVariantFacts`.
	function verifyAgainst(op TargetOp, variant TargetOpVariant)
		requireMaskUnchanged(try self.implicitDefs.get(variant) otherwise panic("OpVariantFacts.verifyAgainst: implicitDefs.get OOB at variant {variant}"), reread: op.rawValue.implicitDefs, field: "implicitDefs", variant: variant)
		requireMaskUnchanged(try self.implicitUses.get(variant) otherwise panic("OpVariantFacts.verifyAgainst: implicitUses.get OOB at variant {variant}"), reread: op.rawValue.implicitUses, field: "implicitUses", variant: variant)

		let memoRole = try self.slotRole.get(variant) otherwise panic("OpVariantFacts.verifyAgainst: slotRole.get OOB at variant {variant}")
		let rederivedRole = deriveSlotRole(op)
		if memoRole != rederivedRole 'roleDiverged'
			panic("OpVariantFacts: variant {variant} memoized slot role {memoRole.name} but this op classifies as {rederivedRole.name} — `deriveSlotRole` must read the op's CASE and never its payload")
		end 'roleDiverged'
	end 'verifyAgainst'
end 'OpVariantFacts'

// One VERIFY-MODE mask comparison. The two implicit-register masks are checked identically and the
// failure is one sentence with one word changed, so the sentence is written once — a second copy is the
// shape that lets a later edit improve one message and leave the other saying something else.
function requireMaskUnchanged(memoized RegMask, reread RegMask, field String, variant TargetOpVariant)
	if memoized != reread 'diverged'
		panic("OpVariantFacts: variant {variant} memoized {field} {memoized} but this op reads {reread} — the memo's premise is that a variant's metadata is a property of the CASE, and it is not")
	end 'diverged'
end 'requireMaskUnchanged'

// VERIFY MODE for the variant memo. Flip to `true`, rebuild, and every memoized answer is re-derived
// from the op it was asked about and compared, on every lookup; a divergence PANICS at the op that
// caused it.
//
// It exists because the memo rests on ONE premise — that these three facts depend on an op's CASE and
// on nothing else — and a premise that fails does not fail a test. A variant whose real clobber mask
// differed from the first instance's would hand a value a caller-saved register across a call, and the
// program would miscompile silently, in a way no spec test is obliged to notice. The premise is
// STRUCTURAL today (`op.rawValue.<field>` is per-case metadata by the language's own construction, and
// `deriveSlotRole` matches on the case without reading a payload), which is exactly why this ships off:
// with the premise structural, the check can only fire if someone rewrites one of those into something
// that reads an op's operands.
//
// Off in a shipping compiler because it re-derives the very select chain the memo exists to skip, on
// every lookup — i.e. it makes the memo strictly slower than not having one.
let VerifyOpVariantFacts = false

// The role `op`'s CASE plays in the spill-slot model. Reads the case and never a payload, which is what
// makes it memoizable by variant.
function deriveSlotRole(op TargetOp) returns OpSlotRole
	return match op 'k'
		storeSlotReg gives OpSlotRole.spillStore
		prologue to popReg gives OpSlotRole.touchesNoSlot
		loadRegSlot gives OpSlotRole.slotReload
		// ⚠ `storeBaseDispReg` is a STORE and is deliberately NOT a spill store. This asks "did the
		// splitter spill a value to a stack SLOT here?", and a `.data` store answers no: it writes a
		// global at a link-time address, not a `SpillSlot` this function's frame owns. Claiming a slot
		// for it would hand the allocator a spill record for a value it never spilled.
		andRegReg to movqXmmGpr gives OpSlotRole.touchesNoSlot
		// arm64 spills go through the SHARED `storeSlotReg` (handled above), so the arm64 band never
		// carries a spill store — `touchesNoSlot` is unreachable this rung AND correct.
		arm64Ret to arm64Fcsel gives OpSlotRole.touchesNoSlot
		// `leaRegFunc`/`callReg` (P1.5-A1) and the Linux `x64Syscall` write no stack slot — a `lea`, a
		// call and a syscall are not spill stores, exactly like the `.data` store above.
		leaRegFunc to x64Syscall gives OpSlotRole.touchesNoSlot
		// The jump tables write no stack slot — a multiway terminator is not a spill store.
		x64JumpTable to arm64JumpTable gives OpSlotRole.touchesNoSlot
		// The witness call writes no stack slot — a call is not a spill store.
		callMem gives OpSlotRole.touchesNoSlot
		// ⚠ `arm64StoreOutgoingArg` writes a frame slot but is NOT a SPILL store, exactly as
		// `storeBaseDispReg` is not: this asks "did this op save a VALUE to its spill slot?", and the
		// argument region is a different area with a different index space. Answering `spillStore` would
		// let the splitter treat an argument store as a spill and elide a real one. An incoming-argument
		// load reads the CALLER's frame for the same reason, so it is no reload either.
		arm64StoreOutgoingArg to arm64LoadIncomingArg gives OpSlotRole.touchesNoSlot
		// Neither arm64 bit reinterpretation touches a stack slot — each is a register-to-register transfer.
		arm64FmovGprFp to arm64FmovFpGpr gives OpSlotRole.touchesNoSlot
		// ⭐⭐ **`touchesNoSlot`, AND THAT IS THE POINT RATHER THAN AN OMISSION.** This role column answers
		// "which value does memory hold, and where?" for the SPILLER's residency model. A promoted record is
		// not a spilled value: it is storage the frame owns outright, in a slot RESERVED out of the
		// spiller's range (`SplitDriver.create` seeds `nextSlot` past the promoted region), so no split can
		// ever be handed the slot this op names. Calling it a `spillStore` would tell the residency model
		// that a value lives there and let a later reload read a record as if it were that value.
		leaRegSlot gives OpSlotRole.touchesNoSlot
		// F1b: a fill ladder touches no stack SLOT — it writes a heap region through a register the isel loaded.
		x64MemFill to arm64MemFill gives OpSlotRole.touchesNoSlot
		// F2: an atomic touches no stack SLOT — it reads and writes the word its address operand names, which is
		// a heap or global address the isel handed it, and the two thread-token reads touch no memory the
		// residency model tracks at all.
		x64LockCmpxchg to arm64ThreadPointer gives OpSlotRole.touchesNoSlot
		// EC16: a scaled-index access touches no stack SLOT — it addresses the heap or global region its
		// base register names, exactly as `loadRegBaseDisp`/`storeBaseDispReg` do.
		leaRegBaseIndexScale to arm64AddLsl gives OpSlotRole.touchesNoSlot
	end 'k'
end 'deriveSlotRole'

// The stack slot of an op whose ROLE says it has one — the ONE place the payload is read, reached only
// behind `slotRoleOf`, which is why every other case is a panic rather than a `none` nobody can act on.
//
// ⚠ IT NAMES THE SAME TWO CASES `deriveSlotRole` SINGLES OUT, and the two must gain a case together.
// The pairing is not a comment alone: a new spill-slot op forces an arm in `deriveSlotRole` at COMPILE
// time (appending to the union leaves its last range arm stale), and if that arm says `spillStore` or
// `slotReload` while this function was not extended, the FIRST op of that case to reach the index build
// lands here and panics by name. Loud on both halves, and a wrong slot is unreachable either way.
function slotOfSlotOp(op TargetOp) returns SpillSlot
	match op 'slot'
		storeSlotReg(slot, _) then return slot
		loadRegSlot(_, slot) then return slot
		default panic("slotOfSlotOp: this op has no spill slot — only `storeSlotReg` and `loadRegSlot` do. Either the caller reached here without asking `OpVariantFacts.slotRoleOf` first, or a new slot-touching op was classified in `deriveSlotRole` and this match was not extended with the arm that reads its slot")
	end 'slot'
end 'slotOfSlotOp'

// How many ops a block lays out in execution order — its body plus its terminator.
export function blockOpCount(block IrBlock) returns BlockOpPos
	return block.opRefs.count() + (1 if block.hasTerminatorOp() else 0)
end 'blockOpCount'

// The op at forward position `pos` — THE one statement of a block's execution order, which is its body
// `opRefs` followed by its terminator.
//
// ⚠ IT IS WHAT `collectBlockOps` IS BUILT FROM, and that is the point rather than a convenience. A
// consumer that wants a SUFFIX of a block (the splitter's `fillLiveBeforeOp`, walking back from the end
// to the peak) must not build the whole list to reach it, and must not spell the order out a second
// time either: a positional accessor that put the terminator anywhere else would hand back an op the
// list-building consumers never see there, and the two would disagree silently about which op the peak
// is.
export function blockOpAt(block IrBlock, pos BlockOpPos) returns OpIndex
	if pos < block.opRefs.count() 'aBodyOp'
		return try block.opRefs.get(pos) otherwise panic("blockOpAt: opRefs.get OOB at {pos} of block '{String.from(block.label)}'")
	end 'aBodyOp'
	if pos >= blockOpCount(block) 'pastTheEnd'
		panic("blockOpAt: position {pos} is past the end of block '{String.from(block.label)}', which lays out {blockOpCount(block)} op(s)")
	end 'pastTheEnd'
	return block.terminatorIndex()
end 'blockOpAt'

// The block's ops in execution order.
export function collectBlockOps(block IrBlock, out OpIndexArray)
	for pos in 0 upto blockOpCount(block) 'eachOp'
		out.push(blockOpAt(block, pos: pos))
	end 'eachOp'
end 'collectBlockOps'

// Larger of two non-negative integers. Stated in the shared REPRESENTATION (`DenseInt`) rather than
// in any one index space, because it is genuinely generic over several: the value-count scan takes
// the max of two ValueIds with it, the pressure sweep the max of two RegCounts. See `DenseInt`.
export function maxOf(a DenseInt, b DenseInt) returns DenseInt
	return a if a >= b else b
end 'maxOf'

// Smaller of two non-negative integers — `maxOf`'s twin, and generic over the same index spaces.
function minOf(a DenseInt, b DenseInt) returns DenseInt
	return a if a <= b else b
end 'minOf'

// Fetch the IrBlock for a local block index. Takes the TOPOLOGY (see `localOfBlockId`), so
// the pre-allocation passes and the allocator share the one implementation.
export function blockAt(module TargetModule, topo FuncTopology, local CfgIndex) returns IrBlock
	let blockRef = try topo.blockRefByLocal.get(local) otherwise panic("blockAt: local {local} out of range")
	return try module.blocks.get(blockRef) otherwise panic("blockAt: blockRef {blockRef} not in module.blocks")
end 'blockAt'
