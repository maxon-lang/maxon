// TargetLiveness — the pass that decides whether the register allocator is fast:
// the per-function CFG (built ONCE), loop structure from back edges, and live-in/live-out by
// SSA PATH EXPLORATION. Everything is dense (design §"Data representation"): `Array`-indexed
// columns keyed by the dense function-local block index / value id, live-in/out as a
// `blocks × words` BITSET matrix, u16 register masks — NO `Map` and NO hashing in the hot path.
//
// **There is NO dataflow fixpoint.** In strict SSA a value's def dominates every use, so liveness
// is exactly "the CFG paths running backward from each use up to the def" — walk them and stop.
// Nothing iterates, nothing converges. See `solveLivenessSsa`, which also explains why a back edge
// needs no special case and why a phi is where the walk stops (and a phi ARG is where one starts).
// The old iterative fixpoint re-swept every block's FULL value-space row every round and was the
// last superlinear term in register allocation.

// A dense function-local index: a block's position in `func.blockRefs`, or a count.
export typealias CfgIndex = int(0 to u64.max)
export typealias CfgIndexArray = Array with CfgIndex

// A dense column of physical register NUMBERS (0..15), indexed by value id or by
// parallel-move slot — a coloring, a fixed-register hint, or an edge-move operand
// list. Same dense-int representation as `CfgIndexArray` (they interconvert freely),
// named apart because it holds register numbers, not CFG indices (the misleading reuse
// the review flagged).
export typealias RegNumColumn = Array with MachineWord

// Build a dense `CfgIndexArray` of `count` entries, every entry set to `value` — the
// "resize a column then fill a sentinel" pattern the allocator's color/hint columns,
// the flat BlockId index, and the checker's register-state rows all share. The result
// unifies with any `Array with <non-negative int>` column (RegNumColumn, RegStateRow).
export function filledColumn(count ByteCount, value CfgIndex) returns CfgIndexArray
	var col = CfgIndexArray.create()
	col.resize(count)
	for i in 0 upto count 'fill'
		try col.set(i, value: value) otherwise panic("filledColumn: set OOB")
	end 'fill'
	return col
end 'filledColumn'

// A dense column of `count` ZEROES. `resize` already zero-fills (every bitset in the allocator
// depends on that), so this is just the resize — whereas `filledColumn(n, 0)` would walk the whole
// column doing bounds-checked writes to store zeroes over zeroes. The counting sorts and version
// stamps allocate several of these per function, so on the many-small-functions shape (which is what
// a real codebase, and this compiler's own source, looks like) that redundant pass is pure loss.
export function zeroColumn(count ByteCount) returns CfgIndexArray
	var col = CfgIndexArray.create()
	col.resize(count)
	return col
end 'zeroColumn'

// A physical-register mask per value id (`forbiddenPhys`): the registers a value
// may NOT be colored into because an op writes them while the value is live across.
export typealias RegMaskColumn = Array with RegMask

// The per-function CFG + loop structure, built ONCE. Local block indices are dense
// (0..numBlocks-1); `blockRefByLocal` maps them to flat `module.blocks` indices and
// `localByBlockId` maps a function-local `BlockId` back to a local index — both
// flat arrays, never a `Map` in a fixpoint (the O(B²·iters) trap v1 fell into).
export type FuncCfg
	export var numBlocks as CfgIndex
	export var blockRefByLocal as BlockRefArray
	export var blockIdByLocal as CfgIndexArray
	export var localByBlockId as CfgIndexArray
	export var succ as CsrGraph
	export var pred as CsrGraph
	export var loopDepth as CfgIndexArray
	export var valueCount as ValueId

	export static function create(numBlocks CfgIndex, blockRefByLocal BlockRefArray, blockIdByLocal CfgIndexArray, localByBlockId CfgIndexArray, succ CsrGraph, pred CsrGraph, loopDepth CfgIndexArray, valueCount ValueId) returns FuncCfg
		return Self{numBlocks: numBlocks, blockRefByLocal: blockRefByLocal, blockIdByLocal: blockIdByLocal, localByBlockId: localByBlockId, succ: succ, pred: pred, loopDepth: loopDepth, valueCount: valueCount}
	end 'create'

	// The maximum loop nesting depth over all blocks (a stat + a health check that
	// the parser's structured loops were recognised).
	export function maxLoopDepth() returns CfgIndex
		var m = 0 as CfgIndex
		for d in self.loopDepth 'each'
			if d > m 'deeper'
				m = d
			end 'deeper'
		end 'each'
		return m
	end 'maxLoopDepth'
end 'FuncCfg'

// The live-in / live-out sets of every block, SPARSE: `inList[inStart[b] .. inStart[b+1])` are the
// value ids live on entry to block `b`, and likewise `outList`/`outStart` on exit. Compressed
// sparse row — two flat columns per direction, never an array-of-arrays (one heap object per block)
// and never a bitset.
//
// **Sparse is the point.** A dense `blocks × ceil(values/64)` bitset matrix is proportional to the
// value space, not to the information: a function with 19,200 blocks and 12,800 values allocates
// and zeroes 61 MB of live sets EVEN WHEN ONLY ONE VALUE IS EVER LIVE, and every consumer then
// scans 200 words per block to find the handful of live values in it. That was the last superlinear
// term in register allocation. These lists are proportional to the liveness that actually exists —
// which is what the SSA path exploration computes directly, so nothing is thrown away to build them.
export type LiveSets
	export var inStart as CfgIndexArray
	export var inList as ValueIdArray
	export var outStart as CfgIndexArray
	export var outList as ValueIdArray

	export static function create(inStart CfgIndexArray, inList ValueIdArray, outStart CfgIndexArray, outList ValueIdArray) returns LiveSets
		return Self{inStart: inStart, inList: inList, outStart: outStart, outList: outList}
	end 'create'
end 'LiveSets'

// The liveness result the colorer and AllocChecker consume. `live` holds the sparse per-block
// live-in/live-out sets; `forbidden` is the per-value register mask; `maxPressure` is the exact
// per-program-point maxlive (χ = ω) the E5001 feasibility decision rests on; `livenessMarkSteps` is
// the path-exploration cost counter.
export type LivenessResult
	export var cfg as FuncCfg
	export var valueCount as ValueId
	export var wordsPerRow as ByteCount
	export var live as LiveSets
	export var forbidden as RegMaskColumn
	export var maxPressure as RegCount
	// Block-marking steps taken by the SSA path exploration — the honest cost counter. (There is
	// no fixpoint, so there is no iteration count to report.)
	export var livenessMarkSteps as ByteCount
	// Per-block DEAD block-arg count — a block-arg with no use in the block and not live-out. The
	// colorer still reserves a register for each across the WHOLE block (a dead phi never appears
	// as an operand, so it never dies and its register frees only at the block boundary), so it
	// counts toward the block's true register demand even though it is never "live".
	//
	// Recorded HERE, for free, by the backward sweep that already computes it — the splitter's
	// peak-finder needs the same number at every op of every block, and recomputing it per block
	// meant re-sweeping the whole block and heap-allocating two arrays per call.
	export var deadPhis as CfgIndexArray

	export static function create(cfg FuncCfg, valueCount ValueId, wordsPerRow ByteCount, live LiveSets, forbidden RegMaskColumn, maxPressure RegCount, livenessMarkSteps ByteCount, deadPhis CfgIndexArray) returns LivenessResult
		return Self{cfg: cfg, valueCount: valueCount, wordsPerRow: wordsPerRow, live: live, forbidden: forbidden, maxPressure: maxPressure, livenessMarkSteps: livenessMarkSteps, deadPhis: deadPhis}
	end 'create'

	// The dead block-arg count of local block `local`.
	export function deadPhiCountOf(local CfgIndex) returns RegCount
		return try self.deadPhis.get(local) otherwise panic("LivenessResult.deadPhiCountOf: block {local} out of range")
	end 'deadPhiCountOf'

	// The values live on ENTRY to `local`, into `out` (cleared first). O(live) — this is the seed
	// the colorer's in-use mask and the AllocChecker's register state are built from. `out` is meant
	// to be a scratch buffer reused across blocks.
	export function liveInInto(local CfgIndex, out ValueIdArray)
		copyCsrRange(self.live.inStart, list: self.live.inList, node: local, out: out)
	end 'liveInInto'

	// The values live on EXIT from `local`, into `out` (cleared first). O(live).
	export function liveOutInto(local CfgIndex, out ValueIdArray)
		copyCsrRange(self.live.outStart, list: self.live.outList, node: local, out: out)
	end 'liveOutInto'

	// Seed a dense working ROW with `local`'s live-out set. One dense row (not a matrix) is the
	// right shape for a backward per-op sweep inside a block — bits flip at every op — but it must
	// be seeded and cleared in O(live), never by copying a full value-space row per block. Pair with
	// `clearRowOfLiveOut`, which removes exactly the bits this set.
	export function seedRowFromLiveOut(local CfgIndex, row BitWordArray, scratch ValueIdArray)
		self.liveOutInto(local, out: scratch)
		for v in scratch 'each'
			bitsetAdd(row, base: 0, bit: v)
		end 'each'
	end 'seedRowFromLiveOut'

	// Clear a dense working row that `seedRowFromLiveOut` seeded and a backward block sweep then
	// mutated. What such a row holds at the end of the sweep is the block's LIVE-IN set plus any of
	// its own block-args that are live (the sweep re-adds a phi when an op in the block reads it),
	// so removing exactly those two sets returns the row to zero in O(live + phis). Clearing the
	// full row instead would be O(values/64) per block — the very term the sparse sets remove.
	export function clearRowAfterSweep(local CfgIndex, block IrBlock, row BitWordArray, scratch ValueIdArray)
		self.liveInInto(local, out: scratch)
		for v in scratch 'eachLiveIn'
			bitsetRemove(row, base: 0, bit: v)
		end 'eachLiveIn'
		for arg in block.blockArgs 'eachPhi'
			bitsetRemove(row, base: 0, bit: arg.valueId)
		end 'eachPhi'
	end 'clearRowAfterSweep'

	// The register mask value `v` must avoid: the registers an op writes while `v` is live across it.
	export function forbiddenOf(v ValueId) returns RegMask
		return try self.forbidden.get(v) otherwise panic("LivenessResult.forbiddenOf: value {v} out of range (valueCount={self.valueCount})")
	end 'forbiddenOf'
end 'LivenessResult'

// Copy CSR node `node`'s range into `out` (cleared first).
function copyCsrRange(start CfgIndexArray, list ValueIdArray, node CfgIndex, out ValueIdArray)
	out.clear()
	let lo = try start.get(node) otherwise panic("copyCsrRange: start.get({node}) out of range")
	let hi = try start.get(node + 1) otherwise panic("copyCsrRange: start.get({node}+1) out of range")
	for k in lo upto hi 'each'
		out.push(try list.get(k) otherwise panic("copyCsrRange: list.get OOB"))
	end 'each'
end 'copyCsrRange'

// The local index of a function-local `BlockId`, via the O(1) flat `FuncCfg` index —
// NEVER `IrModule.getBlockByIdIn` (an O(blocks) scan, the O(B²) trap the design
// forbids inside per-block/per-edge loops). Panics if the id is not in this function.
export function localOfBlockId(cfg FuncCfg, blockId BlockId) returns CfgIndex
	let local = try cfg.localByBlockId.get(blockId) otherwise panic("localOfBlockId: block id {blockId} out of id range")
	if local == cfg.numBlocks 'notInFunc'
		panic("localOfBlockId: block id {blockId} is not in this function")
	end 'notInFunc'
	return local
end 'localOfBlockId'

// A resolved phi-carrying edge: the target block's block-args (phis) paired
// positionally with the incoming values a predecessor passes on the edge. Built once
// per edge — arity-checked HERE, the one place that check lives — then indexed by the
// three consumers that each walk the (phi, incoming) pairs differently: SSA-destruction
// plan building, the colorer's biased-coloring hints, and the AllocChecker's edge
// simulation. Holds references to the existing arrays (no per-element copy).
export type PhiEdgeView
	export var blockArgs as IrBlockArgArray
	export var argIds as ValueIdArray
	export var count as ByteCount

	// Resolve + arity-check the phi edge into `targetBlock` carrying `argIds`. `context`
	// names the caller for the panic. A mismatch is a malformed SSA edge — the ONE
	// arity assertion for all three consumers.
	export static function resolve(targetBlock IrBlock, argIds ValueIdArray, context String) returns PhiEdgeView
		let phiCount = targetBlock.blockArgs.count()
		if argIds.count() != phiCount 'arity'
			panic("PhiEdgeView.resolve {context}: edge to '{targetBlock.label}' carries {argIds.count()} args but the block has {phiCount} phis")
		end 'arity'
		return Self{blockArgs: targetBlock.blockArgs, argIds: argIds, count: phiCount}
	end 'resolve'

	// The value id of the k-th phi (block-arg) of the target block.
	export function phiValueIdAt(k ByteCount) returns ValueId
		let arg = try self.blockArgs.get(k) otherwise panic("PhiEdgeView.phiValueIdAt: OOB")
		return arg.valueId
	end 'phiValueIdAt'

	// The value id the predecessor passes to the k-th phi on this edge.
	export function incomingAt(k ByteCount) returns ValueId
		return try self.argIds.get(k) otherwise panic("PhiEdgeView.incomingAt: OOB")
	end 'incomingAt'
end 'PhiEdgeView'

// DFS coloring for back-edge detection.
let DfsWhite = 0
let DfsGray = 1
let DfsBlack = 2

// Public entry: compute the full liveness result for one function.
export function computeLiveness(module TargetModule, func IrFunction) returns LivenessResult
	let cfg = buildFuncCfg(module, func: func)
	let valueCount = cfg.valueCount
	let wordsPerRow = bitsetWordsFor(valueCount)
	let numBlocks = cfg.numBlocks

	let walk = solveLivenessSsa(module, cfg: cfg, valueCount: valueCount)

	var forbidden = makeRegMaskColumn(valueCount)
	var deadPhis = zeroColumn(numBlocks)
	let maxPressure = computePressureAndForbidden(module, cfg: cfg, live: walk.live, forbidden: forbidden, wordsPerRow: wordsPerRow, deadPhis: deadPhis)
	forbidEntryParamCrossRegisters(module, cfg: cfg, forbidden: forbidden, paramCount: func.paramCount)

	return LivenessResult.create(cfg, valueCount: valueCount, wordsPerRow: wordsPerRow, live: walk.live, forbidden: forbidden, maxPressure: maxPressure, livenessMarkSteps: walk.markSteps, deadPhis: deadPhis)
end 'computeLiveness'

// A zeroed word matrix of `wordCount` words.
function makeMatrix(wordCount ByteCount) returns BitWordArray
	var m = BitWordArray.create()
	m.resize(wordCount)
	return m
end 'makeMatrix'

// A zeroed per-value register-mask column.
function makeRegMaskColumn(valueCount ValueId) returns RegMaskColumn
	var col = RegMaskColumn.create()
	col.resize(valueCount)
	return col
end 'makeRegMaskColumn'

// ==========================================================================
// CFG construction
// ==========================================================================

// Reorder `func.blockRefs` into REVERSE-POSTORDER so LAYOUT order matches EXECUTION order
// (a block that runs after another sits later). The cold-spill splitter classifies a value's
// uses as before/after a pressure peak by their layout SEQUENCE, and that is sound only when
// layout order is a topological order of the forward CFG — i.e. RPO. The parser emits a
// NESTED loop's exit/continuation block BEFORE the inner loop's blocks, so without this an
// idle value's post-loop use gets a LOWER sequence than the inner-loop peak, is misclassified
// as a before-peak use, and is never split out of the loop — a FALSE E5001 on a loop that does
// not genuinely need the registers.
//
// Successors are walked in REVERSE add-order. `collectBlockSuccessorIds` adds the `then`
// (=loop body / if-then) edge before the `else` (=loop exit / if-continuation) edge, and
// exploring the else edge FIRST lands a structured loop's exit AFTER its whole body in the
// resulting RPO — which is exactly the property the splitter's sequence needs. For a single
// loop, an `if`, or straight-line code this RPO already equals the parser's block order, so
// those functions (every current spec) are UNCHANGED; only genuinely nested CFGs reorder.
//
// Unreachable blocks — a parser `dead` continuation with no predecessor — are not reached by
// the DFS, so they are appended in their original relative order to preserve them (they still
// hold ops that get emitted). Entry (local 0) is the DFS root, so it stays first (its prologue
// must lead `.text`). Runs before the splitter in `allocateFunction`.
export function reorderFuncBlocksRpo(module TargetModule, func IrFunction)
	let cfg = buildFuncCfg(module, func: func)
	if cfg.numBlocks == 0 'empty'
		return
	end 'empty'

	var visited = BoolArray.create()
	visited.resize(cfg.numBlocks)
	var postorder = CfgIndexArray.create()
	rpoDfs(cfg, root: 0, visited: visited, postorder: postorder)

	var newRefs = BlockRefList.create()
	for ri in 0 upto postorder.count() 'reverse'
		let local = try postorder.get(postorder.count() - 1 - ri) otherwise panic("reorderFuncBlocksRpo: postorder.get OOB")
		newRefs.append(try cfg.blockRefByLocal.get(local) otherwise panic("reorderFuncBlocksRpo: blockRefByLocal.get OOB"))
	end 'reverse'
	for i in 0 upto cfg.numBlocks 'appendUnreachable'
		if not (try visited.get(i) otherwise panic("reorderFuncBlocksRpo: visited.get OOB")) 'unreached'
			newRefs.append(try cfg.blockRefByLocal.get(i) otherwise panic("reorderFuncBlocksRpo: blockRefByLocal.get OOB (unreachable)"))
		end 'unreached'
	end 'appendUnreachable'

	func.blockRefs = newRefs
end 'reorderFuncBlocksRpo'

// Postorder DFS from `root`, pushing each block AFTER its whole subtree. Successors are explored in
// REVERSE add-order (see `reorderFuncBlocksRpo`).
//
// ITERATIVE, with an explicit stack. The recursive form recursed once per block, and its comment
// claimed "the CFGs it runs on are small" — that assumption SEGFAULTED the compiler on a
// 19,200-block function, before a single instruction was allocated. Block counts are bounded by the
// program, not by anything we control, so no traversal here may recurse. The stack holds a
// (node, next-successor-index) pair per open node — the explicit form of a recursive call's resume
// point — so a node is emitted to the postorder only once its whole subtree is done.
function rpoDfs(cfg FuncCfg, root CfgIndex, visited BoolArray, postorder CfgIndexArray)
	var stackNode = CfgIndexArray.create()
	var stackNextSucc = CfgIndexArray.create()

	try visited.set(root, value: true) otherwise panic("rpoDfs: visited.set(root) OOB")
	stackNode.push(root)
	stackNextSucc.push(0)

	while stackNode.count() > 0 'dfs'
		let top = stackNode.count() - 1
		let u = try stackNode.get(top) otherwise panic("rpoDfs: stackNode.get OOB")
		let k = try stackNextSucc.get(top) otherwise panic("rpoDfs: stackNextSucc.get OOB")
		let deg = cfg.succ.degree(u)

		if k >= deg 'subtreeDone'
			postorder.push(u)
			_ = try stackNode.pop() otherwise panic("rpoDfs: stackNode.pop on non-empty failed")
			_ = try stackNextSucc.pop() otherwise panic("rpoDfs: stackNextSucc.pop on non-empty failed")
			continue
		end 'subtreeDone'

		try stackNextSucc.set(top, value: k + 1) otherwise panic("rpoDfs: stackNextSucc.set OOB")

		let s = cfg.succ.neighbour(u, k: deg - 1 - k)
		if not (try visited.get(s) otherwise panic("rpoDfs: visited.get OOB")) 'unvisited'
			try visited.set(s, value: true) otherwise panic("rpoDfs: visited.set OOB")
			stackNode.push(s)
			stackNextSucc.push(0)
		end 'unvisited'
	end 'dfs'
end 'rpoDfs'

export function buildFuncCfg(module TargetModule, func IrFunction) returns FuncCfg
	var blockRefByLocal = BlockRefArray.create()
	var blockIdByLocal = CfgIndexArray.create()
	var maxBlockId = 0 as CfgIndex
	for blockRef in func.blockRefs 'eachRef'
		let block = try module.blocks.get(blockRef) otherwise panic("buildFuncCfg: blockRef {blockRef} from func.blockRefs not in module.blocks")
		blockRefByLocal.push(blockRef)
		blockIdByLocal.push(block.id)
		if block.id > maxBlockId 'higher'
			maxBlockId = block.id
		end 'higher'
	end 'eachRef'

	let numBlocks = blockRefByLocal.count()

	// BlockId -> local index; sentinel `numBlocks` marks an id not in this function.
	//
	// BlockIds must be UNIQUE within a function. This index is how every edge resolves its target,
	// so a duplicate id silently makes the LAST block with that id win — every branch to the first
	// one is then re-pointed at the second, and the CFG the allocator sees is not the CFG the
	// program has. Liveness, loop depth and pressure all follow it off a cliff, so the failure
	// surfaces far away (values from one loop appearing live inside another) and looks like an
	// allocator bug. Assert it here, at the one place the collision would be absorbed.
	var localByBlockId = filledColumn(maxBlockId + 1, value: numBlocks)
	for i in 0 upto numBlocks 'mapIds'
		let bid = try blockIdByLocal.get(i) otherwise panic("buildFuncCfg: blockIdByLocal.get OOB")
		let prior = try localByBlockId.get(bid) otherwise panic("buildFuncCfg: localByBlockId.get(bid) OOB")
		if prior != numBlocks 'duplicateId'
			panic("buildFuncCfg: function '{func.name}' has TWO blocks with BlockId {bid} (local {prior} and local {i}) — BlockIds must be unique within a function, because every branch target resolves through this index and a duplicate silently re-points edges at the wrong block")
		end 'duplicateId'
		try localByBlockId.set(bid, value: i) otherwise panic("buildFuncCfg: localByBlockId.set(bid) OOB")
	end 'mapIds'

	// Edge list (fromLocal, toLocal), then CSR for succ and its inverse for pred.
	var edgeFrom = CfgIndexArray.create()
	var edgeTo = CfgIndexArray.create()
	for i in 0 upto numBlocks 'eachBlock'
		let block = try module.blocks.get(try blockRefByLocal.get(i) otherwise panic("buildFuncCfg: blockRefByLocal.get OOB")) otherwise panic("buildFuncCfg: block ref not in blocks")
		var succIds = BlockIdArray.create()
		collectBlockSuccessorIds(module, block: block, out: succIds)
		for sid in succIds 'eachSucc'
			let j = try localByBlockId.get(sid) otherwise panic("buildFuncCfg: successor block id {sid} out of id range")
			if j == numBlocks 'notInFunc'
				panic("buildFuncCfg: block '{block.label}' branches to block id {sid} which is not in function '{func.name}'")
			end 'notInFunc'
			edgeFrom.push(i)
			edgeTo.push(j)
		end 'eachSucc'
	end 'eachBlock'

	let succ = buildCsr(edgeFrom, to: edgeTo, nodeCount: numBlocks)
	let pred = buildCsr(edgeTo, to: edgeFrom, nodeCount: numBlocks)

	let valueCount = scanFunctionValueCount(module, func: func)
	let loopDepth = computeLoopDepth(succ, pred: pred, numBlocks: numBlocks)

	return FuncCfg.create(numBlocks, blockRefByLocal: blockRefByLocal, blockIdByLocal: blockIdByLocal, localByBlockId: localByBlockId, succ: succ, pred: pred, loopDepth: loopDepth, valueCount: valueCount)
end 'buildFuncCfg'

// A block's successor BlockIds: a `jcc` body op names the then-target; the `jmp`
// terminator names the (unconditional / else) target; `ret` names none. Derived
// from the ops themselves (the ground truth), NOT from `branchEdges` (which exist
// only for phi-carrying edges).
function collectBlockSuccessorIds(module TargetModule, block IrBlock, out BlockIdArray)
	for opIdx in block.opRefs 'eachOp'
		let op = try module.ops.get(opIdx) otherwise panic("collectBlockSuccessorIds: opIdx {opIdx} not in module.ops")
		match op 'bodyCtrl'
			jcc(_, target) then out.push(target)
			prologue to jmp then break 'bodyCtrl'
			movRegImm to idivReg then break 'bodyCtrl'
			pushReg to popReg then break 'bodyCtrl'
			storeSlotReg to loadRegSlot then break 'bodyCtrl'
		end 'bodyCtrl'
	end 'eachOp'

	if block.hasTerminatorOp() 'hasTerm'
		let op = try module.ops.get(block.terminatorIndex()) otherwise panic("collectBlockSuccessorIds: terminator not in module.ops")
		match op 'termCtrl'
			jmp(target) then out.push(target)
			ret then break 'termCtrl'
			prologue to epilogue then panic("collectBlockSuccessorIds: block '{block.label}' terminator is a frame op, not a branch/return")
			jcc then panic("collectBlockSuccessorIds: `jcc` reached as a terminator — it must be a body op paired with a `jmp` terminator")
			movRegImm to idivReg then panic("collectBlockSuccessorIds: block '{block.label}' has a non-terminator op as its terminator")
			pushReg to popReg then panic("collectBlockSuccessorIds: block '{block.label}' has a pushReg/popReg as its terminator — those are post-regalloc body ops")
			storeSlotReg to loadRegSlot then panic("collectBlockSuccessorIds: block '{block.label}' has a spill/reload as its terminator — the splitter inserts them as body ops")
		end 'termCtrl'
	end 'hasTerm'
end 'collectBlockSuccessorIds'

// The number of distinct value ids in the function (columns for the dense state):
// max id appearing as an op operand, block-arg, or branch-edge arg, plus one. A
// function always has at least a return value, so the count is never zero.
function scanFunctionValueCount(module TargetModule, func IrFunction) returns ValueId
	var maxId = 0 as ValueId
	var buf = OperandList.create()
	for blockRef in func.blockRefs 'eachBlock'
		let block = try module.blocks.get(blockRef) otherwise panic("scanFunctionValueCount: blockRef not in module.blocks")

		for arg in block.blockArgs 'eachArg'
			maxId = maxOf(maxId, b: arg.valueId)
		end 'eachArg'
		for edge in block.branchEdges 'eachEdge'
			for argId in edge.argIds 'eachEdgeArg'
				maxId = maxOf(maxId, b: argId)
			end 'eachEdgeArg'
		end 'eachEdge'

		for opIdx in block.opRefs 'eachOp'
			let op = try module.ops.get(opIdx) otherwise panic("scanFunctionValueCount: opIdx not in module.ops")
			targetOpOperands(op, buf: buf)
			for o in buf 'eachOperand'
				if operandIsVirtual(o) 'virt'
					maxId = maxOf(maxId, b: operandValueId(o))
				end 'virt'
			end 'eachOperand'
		end 'eachOp'
	end 'eachBlock'
	return maxId + 1
end 'scanFunctionValueCount'

// ==========================================================================
// Loop structure (back edges -> natural loops -> per-block depth)
// ==========================================================================

// Per-block loop nesting depth. The CFG the structured parser emits is reducible,
// so every DFS retreating edge is a genuine back edge; each back edge's natural
// loop is the header plus every block that reaches the tail without leaving through
// the header. Back edges sharing a header (a loop with `continue`) form ONE loop.
function computeLoopDepth(succ CsrGraph, pred CsrGraph, numBlocks CfgIndex) returns CfgIndexArray
	var depth = CfgIndexArray.create()
	depth.resize(numBlocks)
	if numBlocks == 0 'empty'
		return depth
	end 'empty'

	var colors = CfgIndexArray.create()
	colors.resize(numBlocks)
	var backTails = CfgIndexArray.create()
	var backHeads = CfgIndexArray.create()
	dfsBackEdges(succ, root: 0, colors: colors, backTails: backTails, backHeads: backHeads)

	var headHandled = BoolArray.create()
	headHandled.resize(numBlocks)
	for k in 0 upto backHeads.count() 'eachBackEdge'
		let h = try backHeads.get(k) otherwise panic("computeLoopDepth: backHeads.get OOB")
		let already = try headHandled.get(h) otherwise panic("computeLoopDepth: headHandled.get OOB")
		if already 'seen'
			continue
		end 'seen'
		try headHandled.set(h, value: true) otherwise panic("computeLoopDepth: headHandled.set OOB")
		bumpNaturalLoopDepth(pred, header: h, backTails: backTails, backHeads: backHeads, numBlocks: numBlocks, depth: depth)
	end 'eachBackEdge'

	return depth
end 'computeLoopDepth'

// Depth-first search from `root`, recording every RETREATING edge (an edge to a GRAY — still-open —
// node), which in a reducible CFG is exactly a back edge.
//
// ITERATIVE, with an explicit stack, because the recursive form recursed once per block and
// SEGFAULTED the compiler on a large function: a 19,200-block function overflowed the native stack
// before it could be allocated. Depth here is bounded by the block count, and a generated or
// heavily-branching function reaches thousands of blocks easily, so recursion is simply not
// available. (`bumpNaturalLoopDepth`, `blocksReachableFromPeak` and the SSA liveness walk are all
// worklist-driven for the same reason.)
//
// The stack holds a (node, next-successor-index) pair per open node — the explicit form of a
// recursive call's resume point — so a node turns BLACK only once every successor has been visited,
// which is what makes the GRAY test mean "still on the current DFS path".
function dfsBackEdges(succ CsrGraph, root CfgIndex, colors CfgIndexArray, backTails CfgIndexArray, backHeads CfgIndexArray)
	var stackNode = CfgIndexArray.create()
	var stackNextSucc = CfgIndexArray.create()

	try colors.set(root, value: DfsGray) otherwise panic("dfsBackEdges: colors.set(root) OOB")
	stackNode.push(root)
	stackNextSucc.push(0)

	while stackNode.count() > 0 'dfs'
		let top = stackNode.count() - 1
		let u = try stackNode.get(top) otherwise panic("dfsBackEdges: stackNode.get OOB")
		let k = try stackNextSucc.get(top) otherwise panic("dfsBackEdges: stackNextSucc.get OOB")

		if k >= succ.degree(u) 'exhausted'
			// Every successor visited — close the node and resume its parent.
			try colors.set(u, value: DfsBlack) otherwise panic("dfsBackEdges: colors.set black OOB")
			_ = try stackNode.pop() otherwise panic("dfsBackEdges: stackNode.pop on non-empty failed")
			_ = try stackNextSucc.pop() otherwise panic("dfsBackEdges: stackNextSucc.pop on non-empty failed")
			continue
		end 'exhausted'

		try stackNextSucc.set(top, value: k + 1) otherwise panic("dfsBackEdges: stackNextSucc.set OOB")

		let v = succ.neighbour(u, k: k)
		let c = try colors.get(v) otherwise panic("dfsBackEdges: colors.get OOB")
		if c == DfsWhite 'unvisited'
			try colors.set(v, value: DfsGray) otherwise panic("dfsBackEdges: colors.set gray OOB")
			stackNode.push(v)
			stackNextSucc.push(0)
		end 'unvisited' else if c == DfsGray 'retreating'
			backTails.push(u)
			backHeads.push(v)
		end 'retreating'
	end 'dfs'
end 'dfsBackEdges'

// Bump `depth` by 1 for every block in the natural loop of `header` (the union over
// all back edges targeting `header`): the header, plus everything reaching a tail
// through predecessors without passing back through the header.
function bumpNaturalLoopDepth(pred CsrGraph, header CfgIndex, backTails CfgIndexArray, backHeads CfgIndexArray, numBlocks CfgIndex, depth CfgIndexArray)
	var member = BoolArray.create()
	member.resize(numBlocks)
	try member.set(header, value: true) otherwise panic("bumpNaturalLoopDepth: member.set(header) OOB")

	var worklist = CfgIndexArray.create()
	for k in 0 upto backHeads.count() 'seedTails'
		let h = try backHeads.get(k) otherwise panic("bumpNaturalLoopDepth: backHeads.get OOB")
		if h != header 'otherLoop'
			continue
		end 'otherLoop'
		let t = try backTails.get(k) otherwise panic("bumpNaturalLoopDepth: backTails.get OOB")
		let isMember = try member.get(t) otherwise panic("bumpNaturalLoopDepth: member.get(t) OOB")
		if not isMember 'newTail'
			try member.set(t, value: true) otherwise panic("bumpNaturalLoopDepth: member.set(t) OOB")
			worklist.push(t)
		end 'newTail'
	end 'seedTails'

	while worklist.count() > 0 'bfs'
		let n = try worklist.pop() otherwise panic("bumpNaturalLoopDepth: worklist.pop on non-empty failed")
		let deg = pred.degree(n)
		for k in 0 upto deg 'eachPred'
			let p = pred.neighbour(n, k: k)
			let isMember = try member.get(p) otherwise panic("bumpNaturalLoopDepth: member.get(p) OOB")
			if not isMember 'newMember'
				try member.set(p, value: true) otherwise panic("bumpNaturalLoopDepth: member.set(p) OOB")
				worklist.push(p)
			end 'newMember'
		end 'eachPred'
	end 'bfs'

	for b in 0 upto numBlocks 'bump'
		let isMember = try member.get(b) otherwise panic("bumpNaturalLoopDepth: member.get(b) OOB")
		if isMember 'inLoop'
			let d = try depth.get(b) otherwise panic("bumpNaturalLoopDepth: depth.get OOB")
			try depth.set(b, value: d + 1) otherwise panic("bumpNaturalLoopDepth: depth.set OOB")
		end 'inLoop'
	end 'bump'
end 'bumpNaturalLoopDepth'

// ==========================================================================
// Liveness by SSA PATH EXPLORATION — no fixpoint, no local sets
// ==========================================================================
//
// This REPLACES the classic iterative dataflow fixpoint (`liveIn = use ∪ (liveOut ∖ def)`, swept to
// convergence over `blocks × values` bitsets). The fixpoint is the wrong algorithm for an SSA
// program, and it was the last superlinear term in register allocation: it re-swept every block's
// FULL value-space row every round, so a function with 9,600 blocks and 6,400 values touched 100
// words per block per round — even when only ONE value was ever live. It cost ~60% of allocation.
//
// **In strict SSA the def DOMINATES every use, so liveness needs no iteration at all.** A value is
// live exactly on the CFG paths running backward from each of its uses up to its (single) def. So:
// start at a use, walk up through predecessors marking the value live, and STOP at the def. Nothing
// to converge — every block is visited at most once per value, and only the blocks where the value
// is genuinely live are visited at all. (Boissinot et al., "Computing Liveness Sets for SSA-Form
// Programs".)
//
// Cost is therefore O(size of the liveness information itself), not O(blocks × values). The
// pathological function above does almost no work, because almost nothing is live.
//
// Two subtleties, and both are what make it exact:
//
//  • **A back edge needs no special handling.** Walking up from a use inside a loop reaches the loop
//    header's predecessors — including the latch — and marks the value live around the back edge,
//    all in the same walk. The `liveIn` memo below is what makes it terminate.
//
//  • **A PHI is where the walk stops, and a phi ARG is where it starts.** A block-arg is defined at
//    its block's entry, so the walk halts there and does NOT propagate into the predecessors: the
//    incoming values, not the phi, are live on those edges. Symmetrically, a value passed on an edge
//    is live at the END of the PREDECESSOR (not live-in to the phi's block), so its walk seeds at
//    the predecessor. Getting this backwards is the classic phi-liveness bug; the two arms below are
//    the whole of it.
//
// Returns the number of block-marking steps — the honest cost counter, replacing the fixpoint's
// iteration count (which no longer exists).

// Every value's USE sites, as a compressed-sparse-row index by value id: `blocks[start[v] ..
// start[v+1])` are the blocks where `v` is read, and the parallel `onEdge` flags say whether the
// read is a branch-edge ARG (consumed at the END of that block, on the edge) rather than an op
// operand. One flat pair of columns — never an array-of-arrays, which would be one heap object per
// value.
type UseIndex
	export var start as CfgIndexArray
	export var blocks as CfgIndexArray
	export var onEdge as BoolArray
	// Each value's DEF BLOCK — the walk's stop test. Collected HERE rather than in its own scan
	// because it needs the same walk over every operand of every op: a separate pass cost a third
	// traversal of the function per liveness computation, which the many-small-functions shape (a
	// real codebase, and this compiler's own source) pays on every function. `numBlocks` is the
	// "not defined in this function" sentinel — no real block index equals it.
	export var defBlock as CfgIndexArray

	static function create(start CfgIndexArray, blocks CfgIndexArray, onEdge BoolArray, defBlock CfgIndexArray) returns UseIndex
		return Self{start: start, blocks: blocks, onEdge: onEdge, defBlock: defBlock}
	end 'create'

	export function defBlockOf(v ValueId) returns CfgIndex
		return try self.defBlock.get(v) otherwise panic("UseIndex.defBlockOf: value {v} out of range")
	end 'defBlockOf'
end 'UseIndex'

// Build the use index AND the def-block column: count uses per value (recording defs on the way),
// prefix-sum, then fill. Two passes over the function, no sorting, no hashing.
function buildUseIndex(module TargetModule, cfg FuncCfg, valueCount ValueId) returns UseIndex
	var start = zeroColumn(valueCount + 1)
	var defBlock = filledColumn(valueCount, value: cfg.numBlocks)
	var buf = OperandList.create()
	var ordered = OpIndexArray.create()

	// Pass 1 — degree of each value into start[v+1], and each value's def block.
	for i in 0 upto cfg.numBlocks 'countBlock'
		let block = blockAt(module, cfg: cfg, local: i)
		for arg in block.blockArgs 'eachPhi'
			try defBlock.set(arg.valueId, value: i) otherwise panic("buildUseIndex: defBlock.set OOB for phi {arg.valueId}")
		end 'eachPhi'

		ordered.clear()
		collectBlockOps(block, out: ordered)
		for opIdx in ordered 'eachOp'
			let op = try module.ops.get(opIdx) otherwise panic("buildUseIndex: opIdx not in module.ops")
			targetOpOperands(op, buf: buf)
			for o in buf 'eachOperand'
				if not operandIsVirtual(o) 'physical'
					continue
				end 'physical'
				if operandIsDef(o) 'def'
					try defBlock.set(operandValueId(o), value: i) otherwise panic("buildUseIndex: defBlock.set OOB")
				end 'def' else 'use'
					bumpCount(start, at: operandValueId(o) + 1)
				end 'use'
			end 'eachOperand'
		end 'eachOp'
		for edge in block.branchEdges 'eachEdge'
			for argId in edge.argIds 'eachArg'
				bumpCount(start, at: argId + 1)
			end 'eachArg'
		end 'eachEdge'
	end 'countBlock'

	for v in 0 upto valueCount 'prefix'
		let a = try start.get(v) otherwise panic("buildUseIndex: prefix start.get(v) OOB")
		let b = try start.get(v + 1) otherwise panic("buildUseIndex: prefix start.get(v+1) OOB")
		try start.set(v + 1, value: a + b) otherwise panic("buildUseIndex: prefix start.set OOB")
	end 'prefix'

	let useCount = try start.get(valueCount) otherwise panic("buildUseIndex: start.get(valueCount) OOB")
	var blocks = zeroColumn(useCount)
	var onEdge = BoolArray.create()
	onEdge.resize(useCount)

	// A running fill cursor per value, seeded from start[v].
	var fill = zeroColumn(valueCount)
	for v in 0 upto valueCount 'seedFill'
		try fill.set(v, value: try start.get(v) otherwise panic("buildUseIndex: seedFill start.get OOB")) otherwise panic("buildUseIndex: seedFill set OOB")
	end 'seedFill'

	// Pass 2 — place each use.
	for i in 0 upto cfg.numBlocks 'placeBlock'
		let block = blockAt(module, cfg: cfg, local: i)
		ordered.clear()
		collectBlockOps(block, out: ordered)
		for opIdx in ordered 'eachOp'
			let op = try module.ops.get(opIdx) otherwise panic("buildUseIndex: opIdx not in module.ops")
			targetOpOperands(op, buf: buf)
			for o in buf 'eachOperand'
				if (not operandIsDef(o)) and operandIsVirtual(o) 'use'
					placeUse(fill, blocks: blocks, onEdge: onEdge, v: operandValueId(o), blockLocal: i, edge: false)
				end 'use'
			end 'eachOperand'
		end 'eachOp'
		for edge in block.branchEdges 'eachEdge'
			for argId in edge.argIds 'eachArg'
				placeUse(fill, blocks: blocks, onEdge: onEdge, v: argId, blockLocal: i, edge: true)
			end 'eachArg'
		end 'eachEdge'
	end 'placeBlock'

	return UseIndex.create(start, blocks: blocks, onEdge: onEdge, defBlock: defBlock)
end 'buildUseIndex'

function bumpCount(column CfgIndexArray, at ByteCount)
	let cur = try column.get(at) otherwise panic("bumpCount: index {at} out of range")
	try column.set(at, value: cur + 1) otherwise panic("bumpCount: index {at} out of range")
end 'bumpCount'

function placeUse(fill CfgIndexArray, blocks CfgIndexArray, onEdge BoolArray, v ValueId, blockLocal CfgIndex, edge bool)
	let pos = try fill.get(v) otherwise panic("placeUse: fill.get OOB for value {v}")
	try blocks.set(pos, value: blockLocal) otherwise panic("placeUse: blocks.set OOB")
	try onEdge.set(pos, value: edge) otherwise panic("placeUse: onEdge.set OOB")
	try fill.set(v, value: pos + 1) otherwise panic("placeUse: fill.set OOB")
end 'placeUse'

// A (block, value) membership pair, accumulated flat during the walk and bucketed into CSR at the
// end — the cheapest way to build a sparse set whose size is not known in advance. Two parallel
// columns, never an array-of-arrays.
type LivePairs
	export var blocks as CfgIndexArray
	export var values as ValueIdArray

	static function create() returns LivePairs
		return Self{blocks: CfgIndexArray.create(), values: ValueIdArray.create()}
	end 'create'

	export function add(blockLocal CfgIndex, v ValueId)
		self.blocks.push(blockLocal)
		self.values.push(v)
	end 'add'
end 'LivePairs'

// The number of block-marking steps a walk took — the cost counter that replaces the fixpoint's
// iteration count (there is no fixpoint). Returned alongside the sets.
type LivenessWalk
	export var live as LiveSets
	export var markSteps as ByteCount

	static function create(live LiveSets, markSteps ByteCount) returns LivenessWalk
		return Self{live: live, markSteps: markSteps}
	end 'create'
end 'LivenessWalk'

// Compute the SPARSE per-block live-in/live-out sets by walking backward from every use to its def.
function solveLivenessSsa(module TargetModule, cfg FuncCfg, valueCount ValueId) returns LivenessWalk
	let useIndex = buildUseIndex(module, cfg: cfg, valueCount: valueCount)

	// "Is v already marked live-in to (respectively live-out of) block B?" — VERSION STAMPS, not
	// bitsets. Storing `v + 1` means the memo needs no clearing between values; clearing would be
	// O(blocks) per value, i.e. the very O(blocks × values) term this algorithm exists to remove.
	// 0 means "never marked". The live-out stamp also DEDUPES: a block that is a predecessor of
	// several blocks in which `v` is live would otherwise record `v` in its live-out set repeatedly.
	var liveInStamp = zeroColumn(cfg.numBlocks)
	var liveOutStamp = zeroColumn(cfg.numBlocks)
	var inPairs = LivePairs.create()
	var outPairs = LivePairs.create()
	var worklist = CfgIndexArray.create()
	var markSteps = 0 as ByteCount

	for v in 0 upto valueCount 'eachValue'
		let useStart = try useIndex.start.get(v) otherwise panic("solveLivenessSsa: useIndex.start.get OOB")
		let useEnd = try useIndex.start.get(v + 1) otherwise panic("solveLivenessSsa: useIndex.start.get(v+1) OOB")
		if useStart == useEnd 'neverUsed'
			// A dead value (a def nothing reads). It is live nowhere — no walk to run.
			continue
		end 'neverUsed'

		worklist.clear()
		for k in useStart upto useEnd 'eachUse'
			let useBlock = try useIndex.blocks.get(k) otherwise panic("solveLivenessSsa: useIndex.blocks.get OOB")
			let isEdgeUse = try useIndex.onEdge.get(k) otherwise panic("solveLivenessSsa: useIndex.onEdge.get OOB")
			if isEdgeUse 'edgeArg'
				// Read ON the edge, so it is live at the END of this predecessor — and the walk up
				// starts HERE, not in the phi's block (the phi is a different value).
				markLiveOut(outPairs, stamp: liveOutStamp, blockLocal: useBlock, v: v)
			end 'edgeArg'
			worklist.push(useBlock)
		end 'eachUse'

		while worklist.count() > 0 'walkUp'
			let b = try worklist.pop() otherwise panic("solveLivenessSsa: worklist.pop on non-empty failed")
			markSteps = markSteps + 1

			// STOP at the def block, BEFORE marking. Above the def the value does not exist, and it
			// is not live-IN to the block that defines it — for EITHER kind of def:
			//
			//   • an ordinary op def: the value is born mid-block, and (Rule 1: def dominates every
			//     use) nothing in the block reads it earlier, so it is not live on entry.
			//   • a PHI def: the value is born at the block's ENTRY. `liveIn` EXCLUDES a block's own
			//     phi defs by convention — the colorer seeds its in-use mask from `liveIn` and THEN
			//     colors the block-args, so a phi appearing in its own `liveIn` would demand it be
			//     already colored (`seedInUse` panics exactly there). And the walk must not continue
			//     into the predecessors either: what they carry are the phi's incoming ARGS, which
			//     are different values with their own walks.
			//
			// One rule covers both, which is why the def's KIND never needs to be recorded.
			if useIndex.defBlockOf(v) == b 'reachedDef'
				continue
			end 'reachedDef'

			let stamp = try liveInStamp.get(b) otherwise panic("solveLivenessSsa: liveInStamp.get OOB")
			if stamp == v + 1 'alreadyMarked'
				// Already walked for this value — this is what terminates a loop's back edge.
				continue
			end 'alreadyMarked'
			try liveInStamp.set(b, value: v + 1) otherwise panic("solveLivenessSsa: liveInStamp.set OOB")
			inPairs.add(b, v: v)

			let deg = cfg.pred.degree(b)
			for k in 0 upto deg 'eachPred'
				let p = cfg.pred.neighbour(b, k: k)
				markLiveOut(outPairs, stamp: liveOutStamp, blockLocal: p, v: v)
				worklist.push(p)
			end 'eachPred'
		end 'walkUp'
	end 'eachValue'

	// The walk discovers (block, value) memberships in walk order; `buildCsr`'s counting sort
	// buckets each direction by block in O(pairs + blocks) — no comparison sort, no hashing, and no
	// per-block heap object.
	let liveInCsr = buildCsr(inPairs.blocks, to: inPairs.values, nodeCount: cfg.numBlocks)
	let liveOutCsr = buildCsr(outPairs.blocks, to: outPairs.values, nodeCount: cfg.numBlocks)
	return LivenessWalk.create(LiveSets.create(liveInCsr.start, inList: liveInCsr.list, outStart: liveOutCsr.start, outList: liveOutCsr.list), markSteps: markSteps)
end 'solveLivenessSsa'

// Record `v` as live-out of `blockLocal`, at most once (the version stamp dedupes).
function markLiveOut(outPairs LivePairs, stamp CfgIndexArray, blockLocal CfgIndex, v ValueId)
	let cur = try stamp.get(blockLocal) otherwise panic("markLiveOut: stamp.get OOB")
	if cur == v + 1 'already'
		return
	end 'already'
	try stamp.set(blockLocal, value: v + 1) otherwise panic("markLiveOut: stamp.set OOB")
	outPairs.add(blockLocal, v: v)
end 'markLiveOut'

// ==========================================================================
// Pressure + forbiddenPhys (backward sweep over the converged live-out)
// ==========================================================================

// Backward per-op sweep: track the exact live set at each program point, taking
// `maxPressure` (the χ = ω the feasibility decision needs) and folding each op's
// physical/implicit register writes into `forbidden` for every value live across.
function computePressureAndForbidden(module TargetModule, cfg FuncCfg, live LiveSets, forbidden RegMaskColumn, wordsPerRow ByteCount, deadPhis CfgIndexArray) returns RegCount
	// ONE dense working row (not a matrix) — bits flip at every op, so a bitset is the right shape
	// INSIDE a block. It is seeded from the sparse live-out list and cleared back to zero in
	// O(live) at the end of the block, never copied or cleared a full value-space row at a time.
	var liveRow = makeMatrix(wordsPerRow)
	var buf = OperandList.create()
	var maxPressure = 0 as RegCount
	// Scratch reused across every block/op — otherwise one allocation per block.
	var liveBuf = ValueIdArray.create()
	var seedBuf = ValueIdArray.create()
	var ordered = OpIndexArray.create()

	for i in 0 upto cfg.numBlocks 'eachBlock'
		let block = blockAt(module, cfg: cfg, local: i)
		copyCsrRange(live.outStart, list: live.outList, node: i, out: seedBuf)
		for v in seedBuf 'seedLiveOut'
			bitsetAdd(liveRow, base: 0, bit: v)
		end 'seedLiveOut'
		var blockMax = seedBuf.count()

		ordered.clear()
		collectBlockOps(block, out: ordered)
		var liveCount = blockMax
		for ri in 0 upto ordered.count() 'eachOpRev'
			let opIdx = try ordered.get(ordered.count() - 1 - ri) otherwise panic("computePressureAndForbidden: ordered.get OOB")
			let at = stepBackwardOverOp(module, opIdx: opIdx, liveRow: liveRow, forbidden: forbidden, buf: buf, wordsPerRow: wordsPerRow, liveBuf: liveBuf, liveCount: liveCount)
			liveCount = at.liveBefore
			blockMax = maxOf(blockMax, b: at.pressure)
		end 'eachOpRev'

		// A DEAD block-arg phi (never used, not live-out — e.g. the continuation phi a
		// merge mints for a value nothing reads after an `if`) is never "live", so the
		// sweep above counts it as zero. But the colorer colors EVERY block-arg and
		// holds its register for the WHOLE block — a dead phi never appears as an
		// operand, so it never dies and its register is freed only at the block
		// boundary. So the colorer's true simultaneous demand in this block is
		// `blockMax + (dead-phi count)`. Adding it keeps `maxPressure` equal to the
		// exact χ the colorer needs, so the "coloring cannot fail when maxPressure <=
		// pool" invariant — and the future E5001 deficit count — stay sound. After the
		// backward sweep `liveRow` is the live-in view: a block-arg is present iff it is
		// live (used here or live-out); a dead phi is absent.
		// Recorded per block, not just folded into the max: the splitter's peak-finder needs the
		// same number at every op of this block, and recomputing it there meant re-sweeping the
		// whole block (and allocating two arrays) once per block.
		let blockDeadPhis = countDeadPhis(block, liveRow: liveRow)
		try deadPhis.set(i, value: blockDeadPhis) otherwise panic("computePressureAndForbidden: deadPhis.set OOB")
		maxPressure = maxOf(maxPressure, b: blockMax + blockDeadPhis)

		// Return the working row to zero for the next block, in O(live). What it holds now is the
		// block's LIVE-IN set plus any of its own block-args the sweep re-added (a phi read by an op
		// in the block), so removing exactly those two sets clears it. Clearing the whole row instead
		// would be O(values/64) per block — the term the sparse sets exist to remove.
		copyCsrRange(live.inStart, list: live.inList, node: i, out: seedBuf)
		for v in seedBuf 'clearLiveIn'
			bitsetRemove(liveRow, base: 0, bit: v)
		end 'clearLiveIn'
		for arg in block.blockArgs 'clearPhis'
			bitsetRemove(liveRow, base: 0, bit: arg.valueId)
		end 'clearPhis'
	end 'eachBlock'

	return maxPressure
end 'computePressureAndForbidden'

// The number of DEAD block-arg phis of `block`: block-args absent from `liveRow` (the
// live-in view the backward sweep leaves), i.e. with no use in the block and not
// live-out. The colorer reserves a register for each across the whole block, so they
// count toward the block's true register demand even though they are never live.
function countDeadPhis(block IrBlock, liveRow BitWordArray) returns RegCount
	var dead = 0 as RegCount
	for arg in block.blockArgs 'each'
		if not bitsetTest(liveRow, base: 0, bit: arg.valueId) 'deadPhi'
			dead = dead + 1
		end 'deadPhi'
	end 'each'
	return dead
end 'countDeadPhis'

// ==========================================================================
// Entry parameter captures + cross-param register forbidding
// ==========================================================================

// A parameter's entry capture: the SSA value id the parameter binds to and the physical
// register NUMBER it arrives in. The entry block opens with one `mov virtual(v_i),
// physical(argReg[i])` per parameter — a PARALLEL COPY from the incoming ABI registers.
// Collected once (paramCount is capped at the register-arg count), then consumed by the
// cross-param forbidding here and the AllocChecker's entry seed + capture verification.
export type ParamCapture
	export var valueId as ValueId
	export var incomingReg as MachineWord

	export static function create(valueId ValueId, incomingReg MachineWord) returns ParamCapture
		return Self{valueId: valueId, incomingReg: incomingReg}
	end 'create'
end 'ParamCapture'

export typealias ParamCaptureArray = Array with ParamCapture

// Collect `func`'s entry parameter captures: each `mov virtual(v), physical(P)` in the
// ENTRY block whose destination value id is a parameter (`v < paramCount`). Parameter
// value ids are exactly [0, paramCount) (the parser reserves them) and each is defined
// ONLY by its capture, so this matches every capture exactly and excludes the call- and
// idiv-result `mov`s (whose destinations are >= paramCount). The incoming register is read
// straight from the IR — the copy's physical source — so this needs no target ABI table.
export function collectEntryParamCaptures(module TargetModule, cfg FuncCfg, paramCount ParamCount) returns ParamCaptureArray
	var captures = ParamCaptureArray.create()
	if paramCount == 0 'noParams'
		return captures
	end 'noParams'

	let entry = blockAt(module, cfg: cfg, local: 0)
	for opIdx in entry.opRefs 'eachOp'
		let op = try module.ops.get(opIdx) otherwise panic("collectEntryParamCaptures: opIdx not in module.ops")
		match op 'capture'
			movRegReg(dst, src) then recordParamCapture(captures, dst: dst, src: src, paramCount: paramCount)
			prologue to movRegImm32 then break 'capture'
			movReg32Reg32 to popReg then break 'capture'
			storeSlotReg to loadRegSlot then break 'capture'
		end 'capture'
	end 'eachOp'
	return captures
end 'collectEntryParamCaptures'

// Record a `mov dst, src` as a parameter capture iff `dst` is a parameter value (a
// virtual whose id is < paramCount) and `src` is a physical register (the incoming ABI
// register). Every other `movRegReg` in the entry block — a call/idiv result move, an
// arg-setup move — fails one of the two gates and is skipped.
function recordParamCapture(captures ParamCaptureArray, dst X64VReg, src X64VReg, paramCount ParamCount)
	match dst 'd'
		virtual(vid) then recordParamCaptureFromPhysSource(captures, vid: vid, src: src, paramCount: paramCount)
		physical then break 'd'
	end 'd'
end 'recordParamCapture'

function recordParamCaptureFromPhysSource(captures ParamCaptureArray, vid ValueId, src X64VReg, paramCount ParamCount)
	if vid >= paramCount 'notParam'
		return
	end 'notParam'
	match src 's'
		physical(reg) then captures.push(ParamCapture.create(vid, incomingReg: reg.rawValue))
		virtual then break 's'
	end 's'
end 'recordParamCaptureFromPhysSource'

// Forbid each entry parameter from every OTHER parameter's incoming register, closing the
// param-capture read-after-clobber hole. The captures `mov color(v_i), argReg[i]` are
// emitted naively in slot order and form a parallel copy whose SOURCES are physical
// registers; unlike the arg-SETUP direction (physical DEFs the backward sweep already folds
// into `forbidden`), nothing otherwise stops an earlier capture's DESTINATION from being
// colored onto a later parameter's incoming SOURCE register, clobbering it before that
// capture reads it. Forbidding the sibling incoming registers forces v_i into its OWN
// argReg[i] (the capture self-move then elides) or a non-parameter register (whose write
// clobbers no sibling source) — so the in-order emit is safe regardless of coloring order.
function forbidEntryParamCrossRegisters(module TargetModule, cfg FuncCfg, forbidden RegMaskColumn, paramCount ParamCount)
	let captures = collectEntryParamCaptures(module, cfg: cfg, paramCount: paramCount)
	if captures.count() < 2 'nothingToCross'
		return
	end 'nothingToCross'

	var allParamRegs = 0 as RegMask
	for cap in captures 'union'
		allParamRegs = regMaskAdd(allParamRegs, regNum: cap.incomingReg)
	end 'union'

	for cap in captures 'forbid'
		let siblingRegs = regMaskRemove(allParamRegs, regNum: cap.incomingReg)
		let cur = try forbidden.get(cap.valueId) otherwise panic("forbidEntryParamCrossRegisters: forbidden.get OOB for value {cap.valueId}")
		try forbidden.set(cap.valueId, value: cur or siblingRegs) otherwise panic("forbidEntryParamCrossRegisters: forbidden.set OOB for value {cap.valueId}")
	end 'forbid'
end 'forbidEntryParamCrossRegisters'

// Process one op backward: fold its register clobbers into `forbidden` for values
// live across it, then transform `liveRow` from live-after to live-before. Returns the
// pressure this op contributes — the live-before population, PLUS one for the reuse-copy
// transient when the op's reuse input outlives it (see reuseInputOutlivesOp).
function stepBackwardOverOp(module TargetModule, opIdx OpIndex, liveRow BitWordArray, forbidden RegMaskColumn, buf OperandList, wordsPerRow ByteCount, liveBuf ValueIdArray, liveCount RegCount) returns OpPressure
	let op = try module.ops.get(opIdx) otherwise panic("stepBackwardOverOp: opIdx not in module.ops")
	targetOpOperands(op, buf: buf)

	// Read the reuse-copy transient BEFORE the backward step mutates `liveRow` — it still
	// holds the live-AFTER set here, which is where "does the reuse input outlive the op?"
	// is decided.
	let reuseTransient = reuseInputOutlivesOp(buf, liveRow: liveRow)

	// Registers this op writes without being a virtual def: physical def operands +
	// the implicit-def mask (a call's clobbers, M5; `idiv`'s RAX/RDX). Values live
	// across must avoid them.
	var clobberMask = op.rawValue.implicitDefs
	for o in buf 'physDefs'
		if operandIsDef(o) and not operandIsVirtual(o) 'physDef'
			clobberMask = clobberMask or regMaskOf(operandRegister(o))
		end 'physDef'
	end 'physDefs'
	if clobberMask != 0 'hasClobber'
		applyForbidden(liveRow, forbidden: forbidden, buf: buf, clobberMask: clobberMask, wordsPerRow: wordsPerRow, liveBuf: liveBuf)
	end 'hasClobber'

	// An op's EXPLICIT virtual operands must additionally avoid the op's IMPLICIT
	// registers (its implicit reads AND writes). `applyForbidden` above only covers
	// values LIVE ACROSS the op (present in the live-after set); an operand that DIES at
	// the op — the common case for `idiv`'s divisor — is absent from that set, so it
	// would otherwise be free to color into RAX/RDX. But at the `idiv` the divisor cannot
	// be RAX (holds the dividend) or RDX (the cqo sign-extension, then the remainder), so
	// it must avoid implicitUses ∪ implicitDefs = {RAX, RDX}. This mask is 0 for every op
	// without implicit registers, so the loop is a no-op except at `idiv`.
	let implicitTouch = op.rawValue.implicitUses or op.rawValue.implicitDefs
	if implicitTouch != 0 'hasImplicit'
		forbidOperandsFromImplicit(forbidden, buf: buf, implicitMask: implicitTouch)
	end 'hasImplicit'

	let liveBefore = stepRowBackwardOverOperands(liveRow, base: 0, buf: buf, liveCount: liveCount)

	var pressure = liveBefore
	if reuseTransient 'reuseCopyTransient'
		// The allocator inserts `mov dest, input` BEFORE the op, where `dest` holds
		// input's value while input (outliving), the other operand, and every value live
		// across are all still live — a pressure of |live-before-op| + 1 that the op-
		// boundary popcounts alone would miss (the analogue of the dead-phi undercount the
		// block-level correction handles).
		pressure = pressure + 1
	end 'reuseCopyTransient'
	return OpPressure.create(pressure, liveBefore: liveBefore)
end 'stepBackwardOverOp'

// True iff `buf` (an op's operands) holds a reuse def whose reuse INPUT (operand 0) is
// live AFTER the op — the case where the allocator materializes `mov dest, input` BEFORE
// the op (`allocateReuseDef`), so `dest` co-exists with everything live entering the op.
// `liveRow` must still be the live-AFTER set (test it BEFORE the backward step, where a
// live-after input is present and a use has not yet been re-added). Reuse-ness and the
// input value come from the operand model, never from hardcoded opcodes. Exported so the
// cold-spill splitter's peak-finder counts the SAME reuse-copy transient this pass folds
// into `maxPressure` — the two must agree or the splitter false-panics (see
// SplitLiveRanges.analyzePressure).
export function reuseInputOutlivesOp(buf OperandList, liveRow BitWordArray) returns bool
	for o in buf 'each'
		if operandIsReuseDef(o) 'reuseDef'
			let inputId = operandReuseInputValueId(o, buf: buf)
			if bitsetTest(liveRow, base: 0, bit: inputId) 'inputLiveAfter'
				return true
			end 'inputLiveAfter'
		end 'reuseDef'
	end 'each'
	return false
end 'reuseInputOutlivesOp'

// Transform a live/seen bitset ROW from live-AFTER an op to live-BEFORE it: remove the
// op's virtual defs, then add its virtual uses. Defs are removed FIRST so a read-
// modify-write value (removed by its def, re-added by its own use) stays live. `buf`
// must already hold the op's operands. Shared by the liveness pressure sweep
// (`stepBackwardOverOp`) and the colorer's per-block death computation — an identical
// backward SSA transfer that must not drift between the two.
// What one backward step over an op yields: the op's register PRESSURE (which carries the +1 for a
// reuse-copy transient), and the row's true live POPULATION before the op (which does NOT — the
// transient is a register the colorer holds, not a live value). Keeping them apart is what lets the
// live count be maintained incrementally across ops while the pressure figure stays exact.
type OpPressure
	export var pressure as RegCount
	export var liveBefore as RegCount

	static function create(pressure RegCount, liveBefore RegCount) returns OpPressure
		return Self{pressure: pressure, liveBefore: liveBefore}
	end 'create'
end 'OpPressure'

// Takes the row's live POPULATION before the step and returns it after — maintained INCREMENTALLY,
// by counting only the bits that actually flip. Recomputing it with a popcount over the whole row
// instead would be O(values/64) at EVERY op — O(ops × values/64) per function, the last quadratic in
// the allocator and, on a large function, the single biggest remaining cost. A step flips at most
// the op's own operands, so the count is O(operands).
export function stepRowBackwardOverOperands(row BitWordArray, base ByteCount, buf OperandList, liveCount RegCount) returns RegCount
	var count = liveCount

	for o in buf 'removeDefs'
		if operandIsDef(o) and operandIsVirtual(o) 'vd'
			let v = operandValueId(o)
			if bitsetTest(row, base: base, bit: v) 'wasLive'
				bitsetRemove(row, base: base, bit: v)
				count = count - 1
			end 'wasLive'
		end 'vd'
	end 'removeDefs'

	for o in buf 'addUses'
		if (not operandIsDef(o)) and operandIsVirtual(o) 'vu'
			let v = operandValueId(o)
			if not bitsetTest(row, base: base, bit: v) 'wasDead'
				bitsetAdd(row, base: base, bit: v)
				count = count + 1
			end 'wasDead'
		end 'vu'
	end 'addUses'

	return count
end 'stepRowBackwardOverOperands'

// For each value LIVE ACROSS this op (in `liveRow`, and not one of the op's own
// defs), add `clobberMask` to its forbidden registers.
//
// Walks the SET BITS of the live row, not the value space. This runs at every CLOBBER op — every
// call, every `idiv` — so testing each value id here would be O(clobber-ops × values), which on a
// call-heavy function (this compiler's own) is a quadratic and measurably the dominant cost of the
// liveness pass. A live set is sparse; the walk is O(live). `liveBuf` is scratch reused across ops.
function applyForbidden(liveRow BitWordArray, forbidden RegMaskColumn, buf OperandList, clobberMask RegMask, wordsPerRow ByteCount, liveBuf ValueIdArray)
	bitsetCollectRow(liveRow, base: 0, wordsPerRow: wordsPerRow, out: liveBuf)
	for v in liveBuf 'eachLive'
		if operandDefinesValue(buf, v: v) 'ownDef'
			continue
		end 'ownDef'
		let cur = try forbidden.get(v) otherwise panic("applyForbidden: forbidden.get OOB")
		try forbidden.set(v, value: cur or clobberMask) otherwise panic("applyForbidden: forbidden.set OOB")
	end 'eachLive'
end 'applyForbidden'

function operandDefinesValue(buf OperandList, v ValueId) returns bool
	for o in buf 'each'
		if operandIsDef(o) and operandIsVirtual(o) and operandValueId(o) == v 'match'
			return true
		end 'match'
	end 'each'
	return false
end 'operandDefinesValue'

// Add `implicitMask` (the op's implicit reads ∪ writes) to the forbidden set of every
// EXPLICIT VIRTUAL operand of the op. Unlike `applyForbidden` (which forbids values live
// ACROSS the op), this forbids the op's OWN operands regardless of whether they outlive
// it — so `idiv`'s divisor, which dies at the op and is thus absent from the live-across
// set, is still kept out of the implicit RAX/RDX pair.
//
// CORRECT ONLY for ops whose implicit registers conflict SIMULTANEOUSLY with the operand —
// `idiv` reads RAX/RDX in the SAME instruction that reads the divisor, so the divisor
// genuinely cannot occupy them. It is NOT correct for a LATE-clobber op such as a call:
// a call's `implicitDefs` clobber AFTER its args are consumed, so an arg (an EARLY use)
// may legally sit in a caller-saved (clobbered) arg register.
//
// M5.6 SIDESTEPS this rather than making the helper position-aware: the call (`callDirect`)
// carries NO explicit register operands — its arguments are PRE-MOVED into their physical
// ABI registers by separate `mov argReg[k], arg_k` ops (see StdToX64Conversion.lowerCall),
// so `targetOpOperands(callDirect)` is empty and this helper iterates nothing on a call.
// The call's caller-saved `implicitDefs` still flow, correctly, ONLY through `applyForbidden`
// (values LIVE ACROSS the call, never the call's own — non-existent — operands). So the only
// caller whose operands this touches is `idiv`/`cqo` (simultaneous-conflict), for which the
// simple form is sound. Reads the operand model rather than hardcoding opcodes.
function forbidOperandsFromImplicit(forbidden RegMaskColumn, buf OperandList, implicitMask RegMask)
	for o in buf 'each'
		if operandIsVirtual(o) 'virt'
			let v = operandValueId(o)
			let cur = try forbidden.get(v) otherwise panic("forbidOperandsFromImplicit: forbidden.get OOB")
			try forbidden.set(v, value: cur or implicitMask) otherwise panic("forbidOperandsFromImplicit: forbidden.set OOB")
		end 'virt'
	end 'each'
end 'forbidOperandsFromImplicit'

// The block's ops in execution order: body `opRefs` then the terminator op.
export function collectBlockOps(block IrBlock, out OpIndexArray)
	for opIdx in block.opRefs 'eachOp'
		out.push(opIdx)
	end 'eachOp'
	if block.hasTerminatorOp() 'hasTerm'
		out.push(block.terminatorIndex())
	end 'hasTerm'
end 'collectBlockOps'

// Larger of two non-negative counts (a value id and a count share the same
// `int(0 to u64.max)` type, so this serves the value-count scan and maxPressure both).
function maxOf(a ByteCount, b ByteCount) returns ByteCount
	return a if a >= b else b
end 'maxOf'

// Fetch the IrBlock for a local block index.
export function blockAt(module TargetModule, cfg FuncCfg, local CfgIndex) returns IrBlock
	let blockRef = try cfg.blockRefByLocal.get(local) otherwise panic("blockAt: local {local} out of range")
	return try module.blocks.get(blockRef) otherwise panic("blockAt: blockRef {blockRef} not in module.blocks")
end 'blockAt'
