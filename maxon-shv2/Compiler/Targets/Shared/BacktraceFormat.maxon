// BacktraceFormat — everything a PANIC BACKTRACE is, that is not an instruction set: the `__symtable`
// wire format, the frame-record layout the walk follows, the words a trace prints, and the names its
// runtime functions answer to.
//
// ⭐ **IT EXISTS BECAUSE THERE ARE NOW TWO WALKERS.** Every constant here was declared inside
// `Targets/X64/` while x64 was the only backend that could symbolize a frame. The arm64 panic runtime
// (`Targets/Arm64/Arm64PanicRuntime`) reads the SAME table, prints the SAME words and answers to the
// SAME `mrt_` names — so leaving them in the x64 files would have meant either an arm64 file reaching
// into `Targets/X64/` for a format, or (far worse, and this project's signature bug) a second copy of
// the layout that agrees today and is free to drift tomorrow. A backtrace format that two backends
// spell separately is a backtrace that lies on one of them.
//
// What stays behind is what is genuinely one ISA's or one OS's: the VEH thunk and its
// `EXCEPTION_POINTERS` offsets, each `ucontext` layout, and each hex writer's instructions. What a
// FAULT DIAGNOSTIC SAYS is not one of those, so the fault vocabulary lives here beside the backtrace
// vocabulary — both lanes classify a fault, both print the same words, both bound the walk to the same
// window, and both format an address as the same 16 hex digits.

// --- `__symtable`: the backtrace's function-name table ---
//
// The panic runtime symbolizes a frame by looking its `.text` offset up in this table.
// It is emitted as the LAST chunk of `.text` — not into `.symtab` — and that placement
// buys three things at once:
//   - It is reachable by an ordinary PC-relative address materialization filed as a chunk
//     reference (x64: a `lea r64, [rip + disp32]` as a `CallFixup`, because a RIP-relative
//     disp32 and a `call rel32` share the end-of-field convention; arm64: the ADRP+ADD
//     `leaFuncAddr` pair), because both concats already resolve those by name. No new
//     relocation kind, no symdata pipeline, no rdata pipeline.
//   - `textSize = __symtable - mrt_start` becomes STRUCTURALLY the size of the code (the
//     walker's upper bound on a symbolizable return address) rather than an accident of
//     which section the writer happened to lay down next.
//   - `.text` is READ|EXECUTE, so a read-only table living in it needs no new section.
//
// Format (byte-identical to the C# bootstrap's — X86CodeEmitter.EmitSymbolTable):
//   count(4) | entries[count] of { codeOffset(4), nameOffset(4) } | NUL-terminated names
// `nameOffset` is relative to the START of the table; the header is `4 + 8*count` bytes.
export let SymbolTableName = b"__symtable"

// The format's ONE definition. It has THREE parties — `buildSymbolTableBytes` below writes it,
// and the two panic runtimes READ it out of the emitted program (`X64Runtime.buildPrintFrameChunk`
// and `Arm64PanicRuntime.buildArm64PrintFrameChunk`, whose reader-side offsets are derived from
// these and from nothing else). That is exactly the shape this project keeps getting burned by:
// copies of one layout, agreeing today, with nothing that MAKES them agree. Widen the count here
// against a walker that still adds 4 and every frame symbolizes to the wrong function — no compile
// error, no failing assert, just a backtrace that lies.
export let SymbolTableColumnBytes = 4  // every column is a u32: the count, and each entry field
let SymbolTableEntryColumns = 2  // an entry is { codeOffset, nameOffset }
let SymbolTableCountBytes = SymbolTableColumnBytes
let SymbolTableEntryBytes = SymbolTableColumnBytes * SymbolTableEntryColumns

// `__symtable`'s alignment within `.text`. x64 tolerates unaligned DWORD loads and AArch64's
// `ldr w` does too for this table's naturally-aligned columns, so this is not a correctness
// requirement of either reader — it matches the C# emitter's contract
// (`DefineSymdata("__symtable", table, 4)`) so the tables stay byte-comparable.
export let SymbolTableAlignment = 4

// --- The READER's view of the same table ---
//
// Every offset here is DERIVED from the writer above and from nothing else. The two sides are a
// contract, and the emitter is the party that defines it; a reader that restated `4` and `8` in
// its own words would be the same layout written down twice, free to disagree the moment either
// side moved — and the disagreement is not a compile error but a walker striding through the
// table at the wrong pitch, naming the wrong function for every frame.
export let SymtabOffEntries = SymbolTableCountBytes as Imm32  // the entry array starts just past the count
export let SymtabEntryOffCodeOffset = 0 as Imm32  // an entry's first column
export let SymtabEntryOffNameOffset = SymbolTableColumnBytes as Imm32  // … and its second

// log2 of the entry stride: both walkers index the entry array by a left shift, not by a multiply.
// A SHIFT COUNT, not a size — the two are only interchangeable by accident, so this is the
// one value that cannot be spelled as a byte count, and `assertSymtabStride` is what keeps
// it honest against `SymbolTableEntryBytes` rather than trusting the two to stay in step.
export let SymtabEntryShift = 3

// The stride the walkers actually index by, recomputed from the shift above. Guards the one
// number in the reader's view that duplicates the writer and cannot be derived from it.
export function assertSymtabStride()
	let stride = 1 shl SymtabEntryShift
	if stride != SymbolTableEntryBytes 'strideDrift'
		panic("assertSymtabStride: a walker strides {stride} bytes per symbol-table entry (shift {SymtabEntryShift}) but `buildSymbolTableBytes` writes {SymbolTableEntryBytes} — the emitter and the walker disagree about the format, and every backtrace would name the wrong function")
	end 'strideDrift'
end 'assertSymtabStride'

// --- Frame walking ---
//
// Cap on printed frames: a backtrace is a diagnostic, not a transcript, and the cap is
// also what stops a chain that survives every validity check from looping forever.
export let MaxBacktraceFrames = 32

// A frame record's two words: the CALLER's saved frame pointer at +0 and the return address at
// +8. x64 builds it with `push rbp; mov rbp, rsp` and AArch64 with `stp x29, x30, [sp, #-N]!;
// mov x29, sp` — different instructions, IDENTICAL layout — which is why one pair of offsets
// serves both walkers and why every function on both backends is framed (a chain with a hole is
// not a chain).
export let FrameOffSavedFramePointer = 0
export let FrameOffReturnAddr = 8

// A return address points at the instruction AFTER the call, so when that call is a
// function's LAST instruction the raw address lands at the start of the NEXT function.
// Biasing by one byte resolves the frame to the calling function. Frame 0 of a FAULT
// backtrace takes no bias — a faulting RIP already IS the faulting instruction.
export let ReturnAddrSymbolBias = 1

// --- The words a trace prints ---
//
// ONE spelling per line, for EVERY producer: x64's hardware-fault path (`mrt_fault_backtrace`),
// x64's software panic and arm64's software panic. A reader is entitled to one trace format from
// one runtime, and nothing but these constants would make three emitters agree.
export let BacktraceHeader = b"Stack trace:\n"
export let FrameLinePrefix = b"  in "
export let UnknownFrameName = b"<unknown>"
export let FrameLineTerminator = b"\n"

// --- The FAULT diagnostic: what a HARDWARE trap prints ---
//
// A fault's first line is `<kind's words> at rip=0x… diag_base=0x…`, then the ordinary backtrace above.
// The two ADDRESSES recover the ASLR slide: `diag_base` is the runtime address of a known function, so
// an operator subtracts it out and resolves the faulting instruction against `llvm-objdump -d`.

// The hardware faults a handler converts. The vocabulary the CLASSIFICATION and the DIAGNOSTIC share:
// what the OS hands over differs per platform (an NTSTATUS on Windows, a signal number on POSIX), but
// what gets printed must not, so the mapping to words is asked once, of `faultPanicLinePrefix`.
//
// ⚠ **THE FIRST TWO ARE ONE INSTRUCTION'S AND THE THIRD IS EVERY INSTRUCTION'S.** x64's `idiv` raises the
// same `#DE` for a zero divisor and for an unrepresentable quotient and the OS tells them apart by code,
// while an access violation is what a bad address does wherever it is dereferenced.
export enum HardwareFaultKind
	divideByZero
	overflow
	accessViolation
end 'HardwareFaultKind'

// The tag that closes a fault panic line and opens its addresses. Written once because the RUNTIME
// emits it and `SpecTestRunner.stripFaultRipSuffix` recognizes exactly it — a second spelling would
// silently stop the harness stripping one of the lines.
let FaultRipTag = b" at rip=0x"

// The second address's tag, and the newline that closes the line. Named for `FaultRipTag`'s reason: two
// lanes emit them and a drift between the two spellings is a diagnostic that reads differently
// depending on which backend built the program.
export let FaultDiagBaseTag = b" diag_base=0x"
export let FaultLineTerminator = b"\n"

// The whole fixed prefix of `kind`'s panic line, up to the ASLR-dependent hex. ONE answer to "which
// fault prints what", asked by every handler in the tree. The words are the bootstrap's
// (`__gt_panic_msg_*`), so a fault reads the same whichever compiler built the program.
export function faultPanicLinePrefix(kind HardwareFaultKind) returns ByteArray
	let message = match kind 'kind'
		divideByZero gives b"panic: integer divide by zero"
		overflow gives b"panic: integer overflow"
		accessViolation gives b"panic: nil pointer or invalid memory access"
	end 'kind'

	var line = ByteArray.create()
	line.append(message)
	line.append(FaultRipTag)
	return line
end 'faultPanicLinePrefix'

// The window above the faulting stack pointer a frame pointer must lie in to be believed: 64 MiB,
// larger than any thread stack either OS hands out. A fault that corrupted the frame pointer then
// yields a SHORT trace instead of a wild read that faults again inside the diagnostic.
export let StackWindowBytes = 0x4000000

// --- The fault line's hex fields ---
//
// 16 fixed zero-padded digits, no leading-zero suppression to get wrong. The spec harness strips from
// `FaultRipTag` to end-of-line, so the FORM is free; what is not free is the two writers agreeing.
export let HexDigitsPerWord = 16
export let HexBitsPerDigit = 4

// Brings the TOP nibble down to bit 0. Derived, because a writer that shifted by a stale 60 against a
// widened digit count would print the same 16 digits of the WRONG nibbles.
export let HexTopDigitShift = (HexDigitsPerWord - 1) * HexBitsPerDigit
export let HexDigitTen = 10  // the nibble at which '0'+n stops working and 'a'+n-10 starts
export let HexAsciiZero = 0x30
export let HexAsciiLowerAMinusTen = 0x57  // 'a' - 10, so 'a'..'f' is one add from a 10..15 nibble
export let HexBufferBytes = HexDigitsPerWord + 1  // the digits and the NUL

// --- Runtime function names ---
//
// `mrt_` mirrors v1's runtime prefix. These are the names each backend's intra-`.text` call fixup
// resolves against, and they are ALSO what a backtrace prints, so they are the diagnostic's
// user-visible vocabulary. Declared here rather than per backend because `mrt_panic` in particular
// is named from THREE sides — the chunk that defines it, the isel that calls it, and the trace that
// may print it — on each of two backends.
export let WriteStderrName = b"mrt_write_cstr_stderr"
export let PrintFrameName = b"mrt_panic_print_frame"
export let WalkFramesName = b"mrt_panic_walk_frames"

// The callable SOFTWARE panic entry (a P1.9 range check, and a user `panic("…")`). Named here so
// each backend's `lowerPanic` targets the SAME chunk its own runtime defines — one string, one fixup.
export let PanicName = b"mrt_panic"

// The fault path's own three. `mrt_runtime_init` is what an entry stub calls before user code to
// install whatever the OS needs installed; `mrt_fault_handler` is the POSIX signal entry both POSIX
// lanes register (Windows registers `mrt_fault_thunk`, whose name is a VEH fact and stays with x64);
// `mrt_fault_backtrace` and `mrt_write_hex64` are the diagnostic body each backend assembles under.
// Exactly one lane's chunks are laid out in any one image, so one name per role is one symbol.
export let RuntimeInitName = b"mrt_runtime_init"
export let FaultHandlerName = b"mrt_fault_handler"
export let FaultBacktraceName = b"mrt_fault_backtrace"
export let WriteHexName = b"mrt_write_hex64"

// STDERR_FILENO is NOT here. It is `StdLoweringShared.StderrFd`, beside its stdout twin, because a
// descriptor is a target-independent fact two mechanisms name — this file's writers and the Std tier's
// `printError` — and one spelling is what keeps them from drifting. This file holds vocabulary only.

// Serialize the symbol table. `symbols` MUST already be in ascending `codeOffset` order:
// the runtime's lookup keeps the LAST entry satisfying `text_offset >= codeOffset`, which
// is the greatest such entry ONLY if the table ascends. Concat lays chunks out in order,
// so the order is a fact of the layout — asserted here rather than re-established by a
// sort, because a sort would silently paper over a layout that had stopped ascending.
export function buildSymbolTableBytes(symbols DebugSymbolArray) returns ByteArray
	let headerSize = SymbolTableCountBytes + SymbolTableEntryBytes * symbols.count()
	var names = ByteArray.create()
	var table = ByteArray.create()
	table.reserve(headerSize)
	writeDword(table, value: symbols.count())

	var prevOffset = 0 as CodeOffset
	for (iter, sym) in symbols.withIterator() 'entries'
		if iter.index() > 0 and sym.codeOffset <= prevOffset 'notAscending'
			panic("buildSymbolTableBytes: '{String.from(sym.name)}' is at .text offset {sym.codeOffset}, which does not exceed its predecessor's {prevOffset} — the symbol table must ascend, because the runtime's lookup takes the LAST matching entry and would otherwise symbolize a frame to the wrong function")
		end 'notAscending'
		prevOffset = sym.codeOffset

		let entryStart = table.count()
		writeDword(table, value: sym.codeOffset as MachineWord)
		writeDword(table, value: headerSize + names.count())

		// These two writes are POSITIONAL — they are the only place an entry's column order
		// is stated — so this ties them back to the declared width the walker sizes its
		// stride from. Add a third column without widening `SymbolTableEntryColumns` and the
		// header arithmetic above silently under-counts, putting every `nameOffset` in the
		// table out by a multiple of the symbol count.
		if table.count() - entryStart != SymbolTableEntryBytes 'entryWidth'
			panic("buildSymbolTableBytes: wrote {table.count() - entryStart} bytes for '{String.from(sym.name)}' but SymbolTableEntryBytes declares {SymbolTableEntryBytes} — the emitted columns and the width the walker strides by have drifted")
		end 'entryWidth'

		names.append(sym.name)
		names.push(0)
	end 'entries'

	table.append(names)
	return table
end 'buildSymbolTableBytes'
