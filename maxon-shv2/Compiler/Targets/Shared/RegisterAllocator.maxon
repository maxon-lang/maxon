// Register allocator — the real M5 core (pure Design B: SSA chordal coloring + gap
// splitting + E5001; canonical design in ARCHITECTURE.md's register-allocator section). Spine: liveness
// → biased forward-sweep coloring → SSA destruction → AllocChecker. M5.2 adopted the
// `Reuse` operand model to DELETE the pre-emitted two-address seed `mov`: ISel now
// emits ONE reuse-def op (`sub`/`imul`/`neg`) and THIS pass materializes the copy only
// when the reuse input outlives the op (`allocateReuseDef`). It REPLACES the M1
// `MinimalColorer` (no liveness; a fresh register per distinct value, forever).
//
// The pieces:
//   • liveness/loops/pressure           — TargetLiveness.maxon
//   • dense bitsets + register masks     — RegBits.maxon
//   • the operand model                  — TargetOperands.maxon (Def/Use, Reuse)
//   • biased forward-sweep colorer       — this file
//   • SSA destruction (edge copies/xchg) — SsaDestruction.maxon
//   • the symbolic verifier              — AllocChecker.maxon
//
// TWO RULES this rests on (design):
//   RULE 1 (SSA). Every value has one def dominating its uses, so live ranges are
//     dominance-closed, the interference graph is CHORDAL, and dominance-order
//     greedy coloring is EXACT (χ = ω = maxPressure). Layout order is a perfect
//     elimination order, ASSERTED by "every use is already colored" at each op.
//   RULE 2 (biased coloring is CORRECTNESS, not optimization). Copy-related values
//     (a phi and its back-edge arg; a reuse def and its two-address input) hold the
//     same value; coloring them together (a) keeps a loop's back-edge / reuse copy
//     from landing IN the loop and (b) stops a false E5001 by not counting one value
//     as two. Hints come from block-arg/branch-arg pairs (collectPhiEdgeHints) and
//     from reuse-def/input pairs (collectReuseHints).
//
// BUILT through M5.4: immediate operand forms + 3-operand lea + the `Reuse`-based
// seed-`mov` deletion (M5.2); idiv/mod FIXED registers (M5.4) — RAX/RDX pinned via
// implicit masks + `forbidOperandsFromImplicit` + the clobber→forbidden path.
//
// The COLD-SPILL SPLITTER (M5.3, SplitLiveRanges) runs BEFORE this colorer and relieves
// every over-pool program point — full-pool overflow at a normal op AND reduced-pool
// overflow at a FIXED-REGISTER point. `maxPressure ≤ pool` alone is NECESSARY but NOT
// SUFFICIENT at such a point: at an `idiv`, values live across it are forbidden {RAX,RDX}
// (effective pool `pool ∖ {RAX,RDX}`); at a call, the callee-saved subset (ARCHITECTURE.md's
// register-allocator "Known limits" #2). The splitter's peak-finder checks each op against its OWN
// reduced pool (`pool ∖ op.implicitDefs`) and splits values live across it, so by the time
// this colorer runs no point — normal or fixed-register — overflows its pool, and coloring
// CANNOT fail. If `chooseRegister` still runs out of registers, the splitter left a point
// unrelieved — a splitter bug, which the panic below names.
//
// A HOT overflow the splitter cannot relieve (a loop whose own working set does not fit) is
// NOT a panic: it is the E5001 compile error, source-mapped via `ValueOrigin` and rendered by
// `RegisterPressureDiagnostic`. Hence `throws CompileError` down this whole path.

// The color column's "not yet colored" sentinel: one past the last real register.
let Uncolored = RegisterFileSize

// A per-function coloring: value id → physical register number (0..15), dense. With
// no live-range splitting at M5.1 a value holds ONE register for its whole range, so
// the column is a total function.
export type Allocation
	export var color as RegNumColumn
	export var valueCount as ValueId

	export static function create(valueCount ValueId) returns Allocation
		return Self{color: filledColumn(valueCount, value: Uncolored), valueCount: valueCount}
	end 'create'

	export function isColored(v ValueId) returns bool
		return (try self.color.get(v) otherwise panic("Allocation.isColored: value {v} out of range")) != Uncolored
	end 'isColored'

	// The register NUMBER assigned to `v` (panics if uncolored — a coloring bug).
	export function regNumOf(v ValueId) returns MachineWord
		let c = try self.color.get(v) otherwise panic("Allocation.regNumOf: value {v} out of range")
		if c == Uncolored 'uncolored'
			panic("Allocation.regNumOf: value {v} is uncolored — a use was reached before its def was colored (dominance-order violation)")
		end 'uncolored'
		return c
	end 'regNumOf'

	// The physical register assigned to `v`.
	export function colorOf(v ValueId) returns X64Register
		return try X64Register.fromRawValue(self.regNumOf(v)) otherwise panic("Allocation.colorOf: value {v} colored to invalid register number")
	end 'colorOf'

	export function assign(v ValueId, regNum MachineWord)
		try self.color.set(v, value: regNum) otherwise panic("Allocation.assign: value {v} out of range")
	end 'assign'
end 'Allocation'

// A reuse-def copy the allocator must MATERIALIZE: `mov destReg, srcReg` spliced in
// BEFORE op `opIdx`. Recorded when a two-address reuse def (`sub`/`imul`/`neg`) could
// NOT be colored into its input's register — because the input OUTLIVES the op (its
// register is still occupied), or because a fixed hint (the R8 return value) claimed
// the destination first. The input must therefore be preserved in its own register and
// copied into the destination before the op runs on it. When the input DIES at the op
// and no fixed hint intervenes, biased coloring lands the destination in the input's
// register and NO copy is recorded — the common case, and the whole point of the reuse
// model. `destReg != srcReg` always (a same-register copy is a no-op, never recorded).
export type ReuseCopy
	export var opIdx as OpIndex
	export var destReg as MachineWord
	export var srcReg as MachineWord

	export static function create(opIdx OpIndex, destReg MachineWord, srcReg MachineWord) returns ReuseCopy
		return Self{opIdx: opIdx, destReg: destReg, srcReg: srcReg}
	end 'create'
end 'ReuseCopy'

export typealias ReuseCopyArray = Array with ReuseCopy

// The reuse copy to splice before op `opIdx`, or `none`. A reuse def coalesced into
// its input's register records nothing, so the array is SPARSE and a linear scan is
// cheap (one op carries at most one reuse copy). Mirrors AllocChecker.findPlanIndex's
// sparse-plan lookup.
export union ReuseCopyLookup
	none
	copy(destReg MachineWord, srcReg MachineWord)
end 'ReuseCopyLookup'

export function reuseCopyForOp(reuseCopies ReuseCopyArray, opIdx OpIndex) returns ReuseCopyLookup
	for rc in reuseCopies 'each'
		if rc.opIdx == opIdx 'match'
			return ReuseCopyLookup.copy(rc.destReg, srcReg: rc.srcReg)
		end 'match'
	end 'each'
	return ReuseCopyLookup.none
end 'reuseCopyForOp'

// The sub-phases the timers + counters attribute time to (design §"Stats": v1's
// "74% of self-compile" figure stood for months with ZERO sub-phase attribution).
export enum RegAllocPhase
	splitting
	liveness
	coloring
	ssaDestruction
	checking
	rewrite
end 'RegAllocPhase'

export typealias DurationMsArray = Array with DurationMs

// Per-run counters + timers, logged under LogCategory.codegen. Counters matter more
// than the clock at M5.1's sub-millisecond functions (design §"Stats").
export type RegAllocStats
	export var phaseMs as DurationMsArray
	export var functionsAllocated as ByteCount
	// SSA path-exploration cost (there is no liveness fixpoint — see TargetLiveness).
	export var livenessMarkStepsTotal as ByteCount
	export var livenessMarkStepsMax as ByteCount
	export var maxPressure as RegCount
	export var maxPressureFunc as String
	export var maxLoopDepth as CfgIndex
	export var copiesInserted as ByteCount
	export var hintsHonoured as ByteCount
	export var hintsMissed as ByteCount
	export var valuesColored as ByteCount
	export var registersUsed as RegMask
	// Cold-spill splitter (M5.3) counters: values spilled to a slot, reloads emitted for
	// them (one per use-block), and constants rematerialized instead of spilled.
	export var valuesSplit as ByteCount
	export var reloadsInserted as ByteCount
	export var rematerialized as ByteCount
	// Of `valuesSplit`, how many were FORCED spills at a fixed-register point (a call / `idiv`)
	// rather than COLD splits of an idle value — the amended Rule 2's mechanism. These are the
	// spills permitted INSIDE a loop, so this is the counter to watch: it is the number of
	// store/reload brackets in hot code, and each one is a program that would otherwise have been
	// a FALSE E5001.
	export var forcedSpills as ByteCount

	export static function create() returns RegAllocStats
		var phaseMs = DurationMsArray.create()
		phaseMs.resize(RegAllocPhase.allCases.count())
		return Self{phaseMs: phaseMs, functionsAllocated: 0, livenessMarkStepsTotal: 0, livenessMarkStepsMax: 0, maxPressure: 0, maxPressureFunc: "", maxLoopDepth: 0, copiesInserted: 0, hintsHonoured: 0, hintsMissed: 0, valuesColored: 0, registersUsed: 0, valuesSplit: 0, reloadsInserted: 0, rematerialized: 0, forcedSpills: 0}
	end 'create'

	export function addPhaseMs(phase RegAllocPhase, ms DurationMs)
		let idx = phase.ordinal
		let cur = try self.phaseMs.get(idx) otherwise panic("RegAllocStats.addPhaseMs: phase index OOB")
		try self.phaseMs.set(idx, value: cur + ms) otherwise panic("RegAllocStats.addPhaseMs: phase index OOB")
	end 'addPhaseMs'

	export function phaseMsOf(phase RegAllocPhase) returns DurationMs
		return try self.phaseMs.get(phase.ordinal) otherwise panic("RegAllocStats.phaseMsOf: phase index OOB")
	end 'phaseMsOf'

	export function recordLivenessMarkSteps(steps ByteCount)
		self.livenessMarkStepsTotal = self.livenessMarkStepsTotal + steps
		if steps > self.livenessMarkStepsMax 'newMax'
			self.livenessMarkStepsMax = steps
		end 'newMax'
	end 'recordLivenessMarkSteps'

	export function recordPressure(pressure RegCount, funcName String)
		if pressure > self.maxPressure 'newMax'
			self.maxPressure = pressure
			self.maxPressureFunc = funcName
		end 'newMax'
	end 'recordPressure'

	export function recordLoopDepth(depth CfgIndex)
		if depth > self.maxLoopDepth 'newMax'
			self.maxLoopDepth = depth
		end 'newMax'
	end 'recordLoopDepth'

	export function noteRegisterUse(regNum MachineWord)
		self.registersUsed = regMaskAdd(self.registersUsed, regNum: regNum)
	end 'noteRegisterUse'
end 'RegAllocStats'

// The allocatable register pool for `target`. M5.6 GREW the pool to the full 14 GPRs
// (every register except rsp/rbp, the frame): the 9 CALLER-saved {rax, rcx, rdx, rsi,
// rdi, r8, r9, r10, r11} PLUS the 5 CALLEE-saved {rbx, r12–r15}. The callee-saved half
// is what makes calls colorable: a value live ACROSS a call is forbidden every caller-
// saved register (`callDirect`'s `implicitDefs`), so its only home is a callee-saved
// register — the prologue/epilogue pass then push/pops exactly the callee-saved registers
// a function's coloring actually used. R8 is admitted because `ret`'s implicit-use mask
// proves nothing is live across the `mov r8, retval` return move. r10/r11 stay in the
// pool — shv2 needs no reserved scratch (SSA destruction breaks copy cycles with `xchg`,
// and the IAT call is RIP-relative), so the doc's r10/r11-as-scratch is a FUTURE tuning.
// The pool is a property of the target — arm64 declares its own when its backend lands.
export function allocatablePool(target Target) returns RegMask
	if target.os != Os.windows 'unsupported'
		panic("allocatablePool: maxon-shv2 allocates for x64-windows only (got {targetToString(target)})")
	end 'unsupported'
	return callerSavedMask() or calleeSavedMask()
end 'allocatablePool'

// Guard the load-bearing invariant that `callDirect`'s inline `implicitDefs` clobber
// mask (which the liveness pass forbids for every value live across a call) equals the
// CALLER-saved half of the allocatable pool: a value live across a call is forbidden the
// former and must find a home in `pool ∖ caller-saved` = the callee-saved half. If they
// drift, such a value is mis-constrained — a false E5001 later, or a real clobber. The
// mask is read from the op's own metadata (not re-spelled), and rbx is checked out of it
// explicitly (a shipped v1 bug — project_regalloc_crosscall_spill_fixes). Runs once per
// module, so the check is free.
function assertCallClobberConsistent()
	let clobber = TargetOp.callDirect("").rawValue.implicitDefs
	if clobber != callerSavedMask() 'drift'
		panic("assertCallClobberConsistent: callDirect clobber mask {clobber} != caller-saved pool {callerSavedMask()} — TargetDialect.callDirect's implicitDefs and RegisterAllocator.callerSavedMask drifted apart")
	end 'drift'
	if regMaskContains(clobber, regNum: X64Register.rbx.rawValue) 'rbxClobbered'
		panic("assertCallClobberConsistent: callDirect clobber mask wrongly includes rbx, which is CALLEE-saved (project_regalloc_crosscall_spill_fixes shipped exactly this bug in v1)")
	end 'rbxClobbered'
end 'assertCallClobberConsistent'

// The 9 CALLER-saved GPRs the custom ABI clobbers across a call — the same set
// `callDirect`'s `implicitDefs` mask (0xFC7) names, kept in ONE place so the pool and
// the clobber mask cannot drift (asserted equal by `assertCallClobberConsistent`). A
// value live across a call is forbidden all of these.
export function callerSavedMask() returns RegMask
	var mask = 0 as RegMask
	mask = mask or regMaskOf(X64Register.rax)
	mask = mask or regMaskOf(X64Register.rcx)
	mask = mask or regMaskOf(X64Register.rdx)
	mask = mask or regMaskOf(X64Register.rsi)
	mask = mask or regMaskOf(X64Register.rdi)
	mask = mask or regMaskOf(X64Register.r8)
	mask = mask or regMaskOf(X64Register.r9)
	mask = mask or regMaskOf(X64Register.r10)
	mask = mask or regMaskOf(X64Register.r11)
	return mask
end 'callerSavedMask'

// The 5 CALLEE-saved GPRs a function must preserve across its own body — the effective
// pool for a value live across a call. The prologue/epilogue pass push/pops exactly the
// ones a function's coloring used. rsp/rbp are the frame and are never allocatable.
export function calleeSavedMask() returns RegMask
	var mask = 0 as RegMask
	mask = mask or regMaskOf(X64Register.rbx)
	mask = mask or regMaskOf(X64Register.r12)
	mask = mask or regMaskOf(X64Register.r13)
	mask = mask or regMaskOf(X64Register.r14)
	mask = mask or regMaskOf(X64Register.r15)
	return mask
end 'calleeSavedMask'

// Color every function's virtual registers into physical GPRs, in place. Only USER
// functions are present here — `mrt_start` is prepended AFTER this pass by
// augmentWithRuntime (it is hand-built in physical registers). `throws CompileError`
// because a genuine hot-loop overflow is E5001, reported onto `project.diagnostics`.
export function allocateRegisters(module TargetModule, target Target, project Project) throws CompileError
	logDebug(LogCategory.codegen, message: function() gives "Register allocation ({targetToString(target)}): {module.funcCount()} function(s)")
	assertCallClobberConsistent()
	var stats = RegAllocStats.create()
	let pool = allocatablePool(target)

	// Split every phi-carrying CRITICAL edge before coloring, so SSA destruction
	// always has a safe home for its parallel copies. This runs OUTSIDE the
	// per-function loop (it mutates `func.blockRefs`, which the loop's `func` borrow
	// would forbid).
	splitCriticalEdges(module)

	// Index-based (not `for func in ...`) because the loop index IS the function's
	// Maxon-tier index: function indices are 1:1 across Maxon -> Std -> Target, and
	// `mrt_start` is prepended only AFTER this pass, so `module.functions` here is the
	// user functions in their Maxon declaration order. The E5001 diagnostic passes this
	// index to `ValueOriginTable.lookup` to map a value back to its source op.
	for funcIndex in 0 upto module.funcCount() 'eachFunc'
		var func = try module.functions.get(funcIndex) otherwise panic("allocateRegisters: functions.get OOB at {funcIndex}")
		try allocateFunction(module, func: func, funcIndex: funcIndex, pool: pool, stats: stats, project: project)
	end 'eachFunc'
	logDebug(LogCategory.codegen, message: function() gives regAllocStatsMessage(stats))
end 'allocateRegisters'

function allocateFunction(module TargetModule, func IrFunction, funcIndex FuncIndex, pool RegMask, stats RegAllocStats, project Project) throws CompileError
	// Lay the blocks out in reverse-postorder FIRST, so layout order matches execution order.
	// The cold-spill splitter's before/after-peak classification (and the colorer's dominance
	// walk) rest on that; the parser emits a nested loop's exit before its inner blocks, which
	// would otherwise misclassify an idle value's post-loop use and false-E5001 (single-loop /
	// straight-line CFGs are already in RPO, so they are untouched). See reorderFuncBlocksRpo.
	reorderFuncBlocksRpo(module, func: func)

	// Cold-spill live-range splitting (M5.3): where register pressure exceeds the pool, split
	// idle values out (store in a cold, dominating spot and reload at their uses) or
	// rematerialize constants, so the colorer below always finds `maxPressure ≤ pool`. HOT
	// pressure a loop genuinely cannot fit is raised as E5001 from inside the splitter.
	// It runs FIRST because it MUTATES the IR — adding spill/reload/remat ops and
	// fresh reload values that the liveness, coloring, and checker below then all consume. The
	// splitter recomputes liveness internally and returns the final result (`maxPressure ≤
	// pool` guaranteed), so no separate liveness pass is needed here.
	// The splitter OWNS every liveness computation (one up front, one after each split), and it bills
	// them to RegAllocPhase.liveness itself. Subtract that from the wall time here so the two phases
	// are DISJOINT and the six of them sum to the true total — otherwise `splitting` silently
	// includes `liveness` and the biggest cost in the allocator hides inside the wrong bucket, which
	// is exactly the "74% with zero sub-phase attribution" failure this instrumentation exists to
	// prevent.
	let tSplit = Clock.nowMs()
	let livenessMsBefore = stats.phaseMsOf(RegAllocPhase.liveness)
	let outcome = try splitLiveRanges(module, func: func, funcIndex: funcIndex, pool: pool, stats: stats, project: project)
	let splitWallMs = Clock.elapsedMs(tSplit)
	let livenessMs = stats.phaseMsOf(RegAllocPhase.liveness) - livenessMsBefore
	stats.addPhaseMs(RegAllocPhase.splitting, ms: splitWallMs - livenessMs)
	let liveness = outcome.liveness
	stats.recordLivenessMarkSteps(liveness.livenessMarkSteps)
	stats.recordPressure(liveness.maxPressure, funcName: func.name)
	stats.recordLoopDepth(liveness.cfg.maxLoopDepth())

	// Reuse-def copies the colorer materializes (two-address inputs that outlive their
	// op) — consumed by BOTH the checker (which simulates them) and the rewrite (which
	// splices them). Populated during coloring.
	var reuseCopies = ReuseCopyArray.create()

	let tColor = Clock.nowMs()
	let alloc = colorFunction(module, liveness: liveness, pool: pool, stats: stats, reuseCopies: reuseCopies)
	stats.addPhaseMs(RegAllocPhase.coloring, ms: Clock.elapsedMs(tColor))

	let tPlan = Clock.nowMs()
	let plans = buildSsaDestructionPlan(module, alloc: alloc, liveness: liveness, stats: stats)
	stats.addPhaseMs(RegAllocPhase.ssaDestruction, ms: Clock.elapsedMs(tPlan))

	let tCheck = Clock.nowMs()
	checkFunctionAllocation(module, func: func, alloc: alloc, liveness: liveness, plans: plans, reuseCopies: reuseCopies, spillPlan: outcome.plan)
	stats.addPhaseMs(RegAllocPhase.checking, ms: Clock.elapsedMs(tCheck))

	let tRewrite = Clock.nowMs()
	applyAllocation(module, func: func, alloc: alloc, plans: plans, reuseCopies: reuseCopies)
	stats.addPhaseMs(RegAllocPhase.rewrite, ms: Clock.elapsedMs(tRewrite))

	stats.functionsAllocated = stats.functionsAllocated + 1
end 'allocateFunction'

// ==========================================================================
// Register hints (biased coloring) — a CORRECTNESS obligation, not an optimization
// ==========================================================================

// The "no fixed-register hint" sentinel (a copy-partner uses valueCount).
let NoFixedHint = RegisterFileSize

// Per-value coloring hints: a FIXED physical register (a value copied to/from a
// pinned register — the R8 return value), and a COPY PARTNER value (a two-address
// seed's source, or the value on the other end of a phi edge). At a def the fixed
// register is tried first, then the partner's register; taking one collapses
// copy-related values into a single register so the copy elides — for a loop back
// edge, that keeps the copy OUT of the loop.
type ColorHints
	export var fixedHint as RegNumColumn
	export var copyHint as ValueIdArray
	export var noPartner as ValueId

	export static function create(valueCount ValueId) returns ColorHints
		let fixedHint = filledColumn(valueCount, value: NoFixedHint)
		let copyHint = filledColumn(valueCount, value: valueCount)
		return Self{fixedHint: fixedHint, copyHint: copyHint, noPartner: valueCount}
	end 'create'

	function setFixedIfUnset(v ValueId, regNum MachineWord)
		let cur = try self.fixedHint.get(v) otherwise panic("ColorHints.setFixedIfUnset: OOB")
		if cur == NoFixedHint 'unset'
			try self.fixedHint.set(v, value: regNum) otherwise panic("ColorHints.setFixedIfUnset: set OOB")
		end 'unset'
	end 'setFixedIfUnset'

	function setCopyIfUnset(v ValueId, partner ValueId)
		if v == partner 'selfPartner'
			return
		end 'selfPartner'
		let cur = try self.copyHint.get(v) otherwise panic("ColorHints.setCopyIfUnset: OOB")
		if cur == self.noPartner 'unset'
			try self.copyHint.set(v, value: partner) otherwise panic("ColorHints.setCopyIfUnset: set OOB")
		end 'unset'
	end 'setCopyIfUnset'

	export function fixedOf(v ValueId) returns MachineWord
		return try self.fixedHint.get(v) otherwise panic("ColorHints.fixedOf: OOB")
	end 'fixedOf'

	export function copyOf(v ValueId) returns ValueId
		return try self.copyHint.get(v) otherwise panic("ColorHints.copyOf: OOB")
	end 'copyOf'

	export function hasFixed(v ValueId) returns bool
		return self.fixedOf(v) != NoFixedHint
	end 'hasFixed'

	export function hasCopy(v ValueId) returns bool
		return self.copyOf(v) != self.noPartner
	end 'hasCopy'
end 'ColorHints'

// Collect hints by scanning ops (seed copies + the R8 return move) and phi edges.
// Blocks are scanned in layout order so a phi's stored copy partner is its
// FORWARD-edge incoming (defined in a dominator) — the one already colored when the
// phi is reached.
function computeHints(module TargetModule, cfg FuncCfg, valueCount ValueId) returns ColorHints
	var hints = ColorHints.create(valueCount)
	var buf = OperandList.create()
	for local in 0 upto cfg.numBlocks 'eachBlock'
		let block = blockAt(module, cfg: cfg, local: local)

		var ordered = OpIndexArray.create()
		collectBlockOps(block, out: ordered)
		for opIdx in ordered 'eachOp'
			let op = try module.ops.get(opIdx) otherwise panic("computeHints: opIdx not in module.ops")
			collectOpHints(op, hints: hints)
			collectReuseHints(op, hints: hints, buf: buf)
		end 'eachOp'

		collectPhiEdgeHints(module, cfg: cfg, predBlock: block, hints: hints)
	end 'eachBlock'
	return hints
end 'computeHints'

// A `movRegReg`/`movReg32Reg32` carries a coloring hint: a copy to a FIXED register
// hints its virtual source to that register (the R8 return move → the return value
// elides). (With the two-address seed `mov` retired, no virtual-to-virtual copy op
// exists at coloring time; the two-address hint now comes from `collectReuseHints`.)
function collectOpHints(op TargetOp, hints ColorHints)
	match op 'hint'
		movRegReg(dst, src) then addCopyHint(dst, src: src, hints: hints)
		movReg32Reg32(dst, src) then addCopyHint(dst, src: src, hints: hints)
		prologue to jcc then break 'hint'
		movRegImm to movRegImm32 then break 'hint'
		subRegReg to idivReg then break 'hint'
		pushReg to popReg then break 'hint'
		storeSlotReg to loadRegSlot then break 'hint'
	end 'hint'
end 'collectOpHints'

// The two-address biased-coloring hint (Phase 5, a CORRECTNESS obligation): for each
// REUSE def, hint the def and its reuse input to each other's register, so the colorer
// coalesces them and NO copy is materialized when the input dies at the op. Read
// straight off the operand model, so it covers every reuse op (`sub`/`imul`/`neg`)
// without a per-op arm.
function collectReuseHints(op TargetOp, hints ColorHints, buf OperandList)
	targetOpOperands(op, buf: buf)
	for o in buf 'eachOperand'
		if operandIsReuseDef(o) and operandIsVirtual(o) 'reuseDef'
			let destId = operandValueId(o)
			let inputId = operandReuseInputValueId(o, buf: buf)
			hints.setCopyIfUnset(destId, partner: inputId)
			hints.setCopyIfUnset(inputId, partner: destId)
		end 'reuseDef'
	end 'eachOperand'
end 'collectReuseHints'

function addCopyHint(dst X64VReg, src X64VReg, hints ColorHints)
	match dst 'd'
		physical(dReg) then addFixedFromPhysDst(dReg, src: src, hints: hints)
		virtual(dId) then addCopyFromVirtualDst(dId, src: src, hints: hints)
	end 'd'
end 'addCopyHint'

// `mov <fixed physical>, <virtual src>`: the source wants that fixed register.
function addFixedFromPhysDst(dReg X64Register, src X64VReg, hints ColorHints)
	match src 's'
		virtual(sId) then hints.setFixedIfUnset(sId, regNum: dReg.rawValue)
		physical then break 's'
	end 's'
end 'addFixedFromPhysDst'

// `mov <virtual dst>, <src>`: dst wants src's register (virtual src) or src's fixed
// register (physical src). No such op survives to coloring today (the two-address seed
// `mov` is retired and edge copies are post-coloring), but the handler stays general so
// a future virtual-to-virtual copy op is hinted correctly.
function addCopyFromVirtualDst(dId ValueId, src X64VReg, hints ColorHints)
	match src 's'
		virtual(sId) then hints.setCopyIfUnset(dId, partner: sId)
		physical(sReg) then hints.setFixedIfUnset(dId, regNum: sReg.rawValue)
	end 's'
end 'addCopyFromVirtualDst'

// Each phi and the value a predecessor passes it on an edge are copy-related — hint
// them to each other so the parallel edge copy elides (the loop back edge especially,
// where a surviving copy would land inside the loop body).
function collectPhiEdgeHints(module TargetModule, cfg FuncCfg, predBlock IrBlock, hints ColorHints)
	for edge in predBlock.branchEdges 'eachEdge'
		let targetBlock = blockAt(module, cfg: cfg, local: localOfBlockId(cfg, blockId: edge.targetBlockId))
		let view = PhiEdgeView.resolve(targetBlock, argIds: edge.argIds, context: "(coloring hints)")
		for k in 0 upto view.count 'eachPhi'
			let phi = view.phiValueIdAt(k)
			let incoming = view.incomingAt(k)
			hints.setCopyIfUnset(phi, partner: incoming)
			hints.setCopyIfUnset(incoming, partner: phi)
		end 'eachPhi'
	end 'eachEdge'
end 'collectPhiEdgeHints'

// ==========================================================================
// The colorer — a forward sweep over a `u16` in-use mask, per block
// ==========================================================================

function colorFunction(module TargetModule, liveness LivenessResult, pool RegMask, stats RegAllocStats, reuseCopies ReuseCopyArray) returns Allocation
	let cfg = liveness.cfg
	let valueCount = liveness.valueCount
	let wordsPerRow = liveness.wordsPerRow
	var alloc = Allocation.create(valueCount)
	let hints = computeHints(module, cfg: cfg, valueCount: valueCount)
	var buf = OperandList.create()
	// Scratch reused across every block — the live-set walks, the op list, and the death sweep's
	// working row would otherwise each allocate once per block. `seenBelow` is ONE dense row (not a
	// matrix); `computeBlockDeaths` returns it to zero in O(live) before the next block.
	var liveBuf = ValueIdArray.create()
	var seedBuf = ValueIdArray.create()
	var ordered = OpIndexArray.create()
	var seenBelow = BitWordArray.create()
	seenBelow.resize(wordsPerRow)

	for local in 0 upto cfg.numBlocks 'eachBlock'
		let block = blockAt(module, cfg: cfg, local: local)

		// Seed occupancy from the non-phi live-ins (each already colored in a
		// dominator), then allocate the block-arg phis defined at entry.
		var inUse = seedInUse(liveness, local: local, alloc: alloc, liveBuf: liveBuf)
		for arg in block.blockArgs 'eachPhi'
			inUse = allocateDef(arg.valueId, working: inUse, dyingRegs: 0, hints: hints, alloc: alloc, liveness: liveness, pool: pool, stats: stats)
		end 'eachPhi'

		ordered.clear()
		collectBlockOps(block, out: ordered)
		let deaths = computeBlockDeaths(module, ordered: ordered, liveness: liveness, local: local, block: block, buf: buf, seenBelow: seenBelow, seedBuf: seedBuf)

		for pos in 0 upto ordered.count() 'eachOp'
			let opIdx = try ordered.get(pos) otherwise panic("colorFunction: ordered.get OOB")
			inUse = colorOpForward(module, opIdx: opIdx, pos: pos, inUse: inUse, deaths: deaths, hints: hints, alloc: alloc, liveness: liveness, pool: pool, stats: stats, buf: buf, reuseCopies: reuseCopies)
		end 'eachOp'
	end 'eachBlock'

	return alloc
end 'colorFunction'

// The in-use mask at a block's entry: every non-phi live-in value occupies its
// color. A live-in value must already be colored (its def dominates) — the
// dominance-order assertion.
//
// Walks the SET BITS of the live-in row, not the value space. Testing every value id here would be
// O(blocks × values) — the quadratic that dominated register allocation on a large function — and
// a live set holds a handful of values out of thousands of ids. `liveBuf` is a scratch buffer
// reused across blocks, so this allocates nothing.
function seedInUse(liveness LivenessResult, local CfgIndex, alloc Allocation, liveBuf ValueIdArray) returns RegMask
	liveness.liveInInto(local, out: liveBuf)

	var mask = 0 as RegMask
	for v in liveBuf 'eachLiveIn'
		if not alloc.isColored(v) 'notColored'
			panic("seedInUse: value {v} is live-in to block {local} but was never colored — a use dominates its def (structured-layout invariant broken)")
		end 'notColored'
		mask = regMaskAdd(mask, regNum: alloc.regNumOf(v))
	end 'eachLiveIn'
	return mask
end 'seedInUse'

// Allocate a register for `v`. Every value has exactly ONE def (RULE 1), so `v` is
// never already colored here — that would be a double-def bug, which asserts. `blocked`
// = the currently-in-use registers (minus those DYING at this op, which a def may
// reuse) ∪ `v`'s forbidden set ∪ the non-pool registers. Returns `working` with the
// assigned register added, so the next def at the same op avoids it.
function allocateDef(v ValueId, working RegMask, dyingRegs RegMask, hints ColorHints, alloc Allocation, liveness LivenessResult, pool RegMask, stats RegAllocStats) returns RegMask
	if alloc.isColored(v) 'doubleDef'
		panic("allocateDef: value {v} is already colored — a value has two defs, violating the single-def SSA invariant (RULE 1)")
	end 'doubleDef'
	let blocked = (working and not dyingRegs) or liveness.forbiddenOf(v) or (fullRegisterMask() and not pool)
	let reg = chooseRegister(v, blocked: blocked, hints: hints, alloc: alloc, stats: stats)
	alloc.assign(v, regNum: reg)
	stats.valuesColored = stats.valuesColored + 1
	stats.noteRegisterUse(reg)
	return regMaskAdd(working, regNum: reg)
end 'allocateDef'

// Pick a register for `v`: the hinted register FIRST (fixed, then the copy
// partner's), falling back to the lowest free pool register. This one biased choice
// is what collapses copy-related values so their copy elides.
function chooseRegister(v ValueId, blocked RegMask, hints ColorHints, alloc Allocation, stats RegAllocStats) returns MachineWord
	if hints.hasFixed(v) 'fixed'
		let fr = hints.fixedOf(v)
		if not regMaskContains(blocked, regNum: fr) 'fixedFree'
			stats.hintsHonoured = stats.hintsHonoured + 1
			return fr
		end 'fixedFree'
	end 'fixed'
	if hints.hasCopy(v) 'copy'
		let p = hints.copyOf(v)
		if alloc.isColored(p) 'partnerColored'
			let cr = alloc.regNumOf(p)
			if not regMaskContains(blocked, regNum: cr) 'copyFree'
				stats.hintsHonoured = stats.hintsHonoured + 1
				return cr
			end 'copyFree'
		end 'partnerColored'
	end 'copy'

	if hints.hasFixed(v) or hints.hasCopy(v) 'missed'
		stats.hintsMissed = stats.hintsMissed + 1
	end 'missed'

	let reg = pickPreferredRegister(blocked)
	if reg == RegisterFileSize 'exhausted'
		panic("chooseRegister: no free register for value {v} (blocked mask {blocked}) — the cold-spill splitter (M5.3) is supposed to relieve EVERY over-pool point before coloring, including the REDUCED pool at a FIXED-REGISTER point (a value live across a call is confined to the {regMaskPopcount(calleeSavedMask())} callee-saved registers; an idiv reserves RAX/RDX for its own operands). Reaching this means the splitter left a point unrelieved — a SPLITTER BUG (its `analyzePressure` reduced-pool check, `pool ∖ op.implicitDefs`, missed this op), not a colorer limitation.")
	end 'exhausted'
	return reg
end 'chooseRegister'

// Pick a free register, preferring a CALLER-saved one — it needs no prologue push/pop,
// so a value that does NOT outlive a call stays cheap. A value live ACROSS a call is
// forbidden every caller-saved register (it is in `blocked`), so none is free here and
// the pick falls through to the full pool — landing it in the callee-saved half, which
// the prologue then preserves. This is the standard "allocate volatiles first" bias; it
// keeps leaf and call-free functions off the callee-saved registers entirely.
function pickPreferredRegister(blocked RegMask) returns MachineWord
	let nonCallerSaved = fullRegisterMask() and not callerSavedMask()
	let callerPick = lowestClearRegister(blocked or nonCallerSaved)
	if callerPick != RegisterFileSize 'gotCaller'
		return callerPick
	end 'gotCaller'
	return lowestClearRegister(blocked)
end 'pickPreferredRegister'

// Color one op: assert its uses are already colored (dominance), free the operands
// that die here (so a def may reuse a dying use's register), allocate the def (a reuse
// def goes through `allocateReuseDef`, which may record a copy), then return the
// block's in-use mask for the point AFTER the op.
function colorOpForward(module TargetModule, opIdx OpIndex, pos ByteCount, inUse RegMask, deaths BlockDeaths, hints ColorHints, alloc Allocation, liveness LivenessResult, pool RegMask, stats RegAllocStats, buf OperandList, reuseCopies ReuseCopyArray) returns RegMask
	let op = try module.ops.get(opIdx) otherwise panic("colorOpForward: opIdx not in module.ops")
	targetOpOperands(op, buf: buf)

	for o in buf 'assertUses'
		if (not operandIsDef(o)) and operandIsVirtual(o) 'vu'
			if not alloc.isColored(operandValueId(o)) 'notColored'
				panic("colorOpForward: use of value {operandValueId(o)} before it was colored — dominance-order violation (a future block-reordering pass would need to preserve dominance layout)")
			end 'notColored'
		end 'vu'
	end 'assertUses'

	let dyingRegs = deaths.dyingRegsAt(pos, alloc: alloc)

	var working = inUse
	for o in buf 'allocDefs'
		if operandIsDef(o) and operandIsVirtual(o) 'vd'
			if operandIsReuseDef(o) 'reuse'
				working = allocateReuseDef(o, opIdx: opIdx, pos: pos, deaths: deaths, buf: buf, working: working, hints: hints, alloc: alloc, liveness: liveness, pool: pool, stats: stats, reuseCopies: reuseCopies)
			end 'reuse' else 'plain'
				working = allocateDef(operandValueId(o), working: working, dyingRegs: dyingRegs, hints: hints, alloc: alloc, liveness: liveness, pool: pool, stats: stats)
			end 'plain'
		end 'vd'
	end 'allocDefs'

	// in-use after the op: drop the dying operands, keep the LIVE defs (a def that
	// is dead the instant it is written frees its register too, via `dyingRegs`).
	var liveDefRegs = 0 as RegMask
	for o in buf 'liveDefs'
		if operandIsDef(o) and operandIsVirtual(o) 'vd2'
			let v = operandValueId(o)
			if not deaths.dies(pos, v: v) 'stillLive'
				liveDefRegs = regMaskAdd(liveDefRegs, regNum: alloc.regNumOf(v))
			end 'stillLive'
		end 'vd2'
	end 'liveDefs'

	return (inUse and not dyingRegs) or liveDefRegs
end 'colorOpForward'

// Allocate a REUSE def and, when it could not coalesce into its input's register,
// record the `mov dest, input` the encoder needs. The subtlety the whole rework rests
// on: the copy runs BEFORE the op, at a point where nothing has died yet, so `dest`
// must be a register that is free THERE. So the dest may reuse ONLY the input's dying
// register (never another dying operand's — a copy into it would clobber a value the op
// still reads); when the input OUTLIVES, no operand register is free before the op, so
// the dest may reuse none. `defDyingRegs` encodes exactly that.
function allocateReuseDef(o Operand, opIdx OpIndex, pos ByteCount, deaths BlockDeaths, buf OperandList, working RegMask, hints ColorHints, alloc Allocation, liveness LivenessResult, pool RegMask, stats RegAllocStats, reuseCopies ReuseCopyArray) returns RegMask
	let destId = operandValueId(o)
	let inputId = operandReuseInputValueId(o, buf: buf)
	let inputReg = alloc.regNumOf(inputId)
	let inputDies = deaths.dies(pos, v: inputId)

	// The reuse copy (if the coalescing hint misses) runs BEFORE the op, so the dest
	// must be free at that point: it may reuse ONLY the input's dying register (never
	// another dying operand's, which the op still reads after the copy), and none at all
	// when the input outlives.
	var defDyingRegs = 0 as RegMask
	if inputDies 'inputDiesHere'
		defDyingRegs = regMaskAdd(defDyingRegs, regNum: inputReg)
	end 'inputDiesHere'

	let updated = allocateDef(destId, working: working, dyingRegs: defDyingRegs, hints: hints, alloc: alloc, liveness: liveness, pool: pool, stats: stats)

	let destReg = alloc.regNumOf(destId)
	if destReg != inputReg 'needsCopy'
		reuseCopies.push(ReuseCopy.create(opIdx, destReg: destReg, srcReg: inputReg))
		stats.copiesInserted = stats.copiesInserted + 1
	end 'needsCopy'

	return updated
end 'allocateReuseDef'

// Which values DIE at each op of a block — i.e. whose live range ENDS there (its last use, or a
// dead def) — as a CSR list keyed by the op's position: `list[start[pos] .. start[pos+1])`.
//
// **Not a bitset.** The obvious shape is an `ops × ceil(values/64)` matrix, one row of the whole
// value space per op — and that is what this was, allocated fresh for EVERY block, costing
// O(ops × values/64) memory and time per function. It was never needed: a value can only die where
// it APPEARS, so every query is about one of the op's own operands, of which there are at most a
// handful. The list is O(operands) per op and answers the same questions.
type BlockDeaths
	export var start as CfgIndexArray
	export var list as ValueIdArray

	static function create(start CfgIndexArray, list ValueIdArray) returns BlockDeaths
		return Self{start: start, list: list}
	end 'create'

	// True iff `v` dies at op position `pos`. A linear scan of the op's dying values — at most the
	// op's operand count, so this is O(1) in practice.
	export function dies(pos ByteCount, v ValueId) returns bool
		let lo = try self.start.get(pos) otherwise panic("BlockDeaths.dies: start.get({pos}) OOB")
		let hi = try self.start.get(pos + 1) otherwise panic("BlockDeaths.dies: start.get({pos}+1) OOB")
		for k in lo upto hi 'each'
			if (try self.list.get(k) otherwise panic("BlockDeaths.dies: list.get OOB")) == v 'match'
				return true
			end 'match'
		end 'each'
		return false
	end 'dies'

	// The register mask of every COLORED value dying at op `pos` — the registers a def at this op
	// may reuse. (An uncolored dead def is handled by the caller's live-def computation, not here.)
	export function dyingRegsAt(pos ByteCount, alloc Allocation) returns RegMask
		var mask = 0 as RegMask
		let lo = try self.start.get(pos) otherwise panic("BlockDeaths.dyingRegsAt: start.get({pos}) OOB")
		let hi = try self.start.get(pos + 1) otherwise panic("BlockDeaths.dyingRegsAt: start.get({pos}+1) OOB")
		for k in lo upto hi 'each'
			let v = try self.list.get(k) otherwise panic("BlockDeaths.dyingRegsAt: list.get OOB")
			if alloc.isColored(v) 'colored'
				mask = regMaskAdd(mask, regNum: alloc.regNumOf(v))
			end 'colored'
		end 'each'
		return mask
	end 'dyingRegsAt'
end 'BlockDeaths'

// A backward scan from the block's live-out: a value dies at an op iff it is an operand there and
// is not live below it. `seenBelow` is a single dense row (bits flip at every op, so a bitset is the
// right shape INSIDE a block) — seeded from the SPARSE live-out list and cleared back to zero in
// O(live) by the caller, never copied a full value-space row at a time.
function computeBlockDeaths(module TargetModule, ordered OpIndexArray, liveness LivenessResult, local CfgIndex, block IrBlock, buf OperandList, seenBelow BitWordArray, seedBuf ValueIdArray) returns BlockDeaths
	let n = ordered.count()

	liveness.liveOutInto(local, out: seedBuf)
	for v in seedBuf 'seed'
		bitsetAdd(seenBelow, base: 0, bit: v)
	end 'seed'
	// The death scan does not use the live count, but `stepRowBackwardOverOperands` maintains one and
	// a count may never go negative — so seed it truthfully from the live-out population.
	var liveCount = seedBuf.count()

	// Collected backward as (pos, value) pairs, then bucketed by position — the scan discovers them
	// in reverse, and a counting sort restores order in O(pairs + ops).
	var posOf = CfgIndexArray.create()
	var valueOf = ValueIdArray.create()

	for ri in 0 upto n 'eachOpRev'
		let pos = n - 1 - ri
		let opIdx = try ordered.get(pos) otherwise panic("computeBlockDeaths: ordered.get OOB")
		let op = try module.ops.get(opIdx) otherwise panic("computeBlockDeaths: opIdx not in module.ops")
		targetOpOperands(op, buf: buf)

		for o in buf 'markDeaths'
			if operandIsVirtual(o) 'virt'
				let v = operandValueId(o)
				if not bitsetTest(seenBelow, base: 0, bit: v) 'dies'
					posOf.push(pos)
					valueOf.push(v)
					// Mark it seen, so the SAME value appearing twice in this op (`sub x, x`) is
					// recorded as dying ONCE.
					bitsetAdd(seenBelow, base: 0, bit: v)
				end 'dies'
			end 'virt'
		end 'markDeaths'

		// Transform `seenBelow` from live-below-this-op to live-below-the-op-above it —
		// the same backward SSA transfer the liveness pressure sweep uses.
		liveCount = stepRowBackwardOverOperands(seenBelow, base: 0, buf: buf, liveCount: liveCount)
	end 'eachOpRev'

	// Return the row to zero for the next block, in O(live + phis): what it holds now is this
	// block's live-in set plus any of its own block-args an op re-added.
	liveness.liveInInto(local, out: seedBuf)
	for v in seedBuf 'clearLiveIn'
		bitsetRemove(seenBelow, base: 0, bit: v)
	end 'clearLiveIn'
	for arg in block.blockArgs 'clearPhis'
		bitsetRemove(seenBelow, base: 0, bit: arg.valueId)
	end 'clearPhis'

	return bucketDeathsByPos(posOf, valueOf: valueOf, opCount: n)
end 'computeBlockDeaths'

// Counting-sort the (pos, value) death pairs into CSR by op position.
function bucketDeathsByPos(posOf CfgIndexArray, valueOf ValueIdArray, opCount ByteCount) returns BlockDeaths
	var start = zeroColumn(opCount + 1)
	for p in posOf 'count'
		let cur = try start.get(p + 1) otherwise panic("bucketDeathsByPos: start.get OOB")
		try start.set(p + 1, value: cur + 1) otherwise panic("bucketDeathsByPos: start.set OOB")
	end 'count'
	for p in 0 upto opCount 'prefix'
		let a = try start.get(p) otherwise panic("bucketDeathsByPos: prefix start.get(p) OOB")
		let b = try start.get(p + 1) otherwise panic("bucketDeathsByPos: prefix start.get(p+1) OOB")
		try start.set(p + 1, value: a + b) otherwise panic("bucketDeathsByPos: prefix start.set OOB")
	end 'prefix'

	let total = posOf.count()
	var list = ValueIdArray.create()
	list.resize(total)
	var fill = zeroColumn(opCount)
	for p in 0 upto opCount 'seedFill'
		try fill.set(p, value: try start.get(p) otherwise panic("bucketDeathsByPos: seedFill start.get OOB")) otherwise panic("bucketDeathsByPos: seedFill set OOB")
	end 'seedFill'

	for k in 0 upto total 'place'
		let p = try posOf.get(k) otherwise panic("bucketDeathsByPos: posOf.get OOB")
		let v = try valueOf.get(k) otherwise panic("bucketDeathsByPos: valueOf.get OOB")
		let at = try fill.get(p) otherwise panic("bucketDeathsByPos: fill.get OOB")
		try list.set(at, value: v) otherwise panic("bucketDeathsByPos: list.set OOB")
		try fill.set(p, value: at + 1) otherwise panic("bucketDeathsByPos: fill.set OOB")
	end 'place'

	return BlockDeaths.create(start, list: list)
end 'bucketDeathsByPos'

// ==========================================================================
// Applying a coloring to an op (used by the rewrite in SsaDestruction.maxon)
// ==========================================================================

// Resolve one operand: a physical register passes through (the R8 return target); a
// virtual register becomes its assigned physical register.
export function colorVRegWith(vreg X64VReg, alloc Allocation) returns X64VReg
	return match vreg 'v'
		physical gives vreg
		virtual(id) gives X64VReg.physical(alloc.colorOf(id))
	end 'v'
end 'colorVRegWith'

// Rebuild an op with its X64VReg operands colored to physical registers. EXHAUSTIVE
// over every TargetOp — control/frame/call ops with no register operands pass
// through. `xchgRegReg` is spliced in AFTER this rewrite, so its operands are already
// physical (pass through).
export function colorTargetOp(op TargetOp, alloc Allocation) returns TargetOp
	match op 'rewrite'
		prologue to jcc then return op
		movRegImm(dest, value) then return TargetOp.movRegImm(colorVRegWith(dest, alloc: alloc), value: value)
		movRegImm32(dest, value) then return TargetOp.movRegImm32(colorVRegWith(dest, alloc: alloc), value: value)
		movRegReg(destReg, srcReg) then return TargetOp.movRegReg(colorVRegWith(destReg, alloc: alloc), srcReg: colorVRegWith(srcReg, alloc: alloc))
		movReg32Reg32(destReg, srcReg) then return TargetOp.movReg32Reg32(colorVRegWith(destReg, alloc: alloc), srcReg: colorVRegWith(srcReg, alloc: alloc))
		subRegReg(dest, lhs, rhs) then return TargetOp.subRegReg(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		imulRegReg(dest, lhs, rhs) then return TargetOp.imulRegReg(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		negReg(dest, src) then return TargetOp.negReg(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc))
		cmpRegReg(lhsReg, rhsReg) then return TargetOp.cmpRegReg(colorVRegWith(lhsReg, alloc: alloc), rhsReg: colorVRegWith(rhsReg, alloc: alloc))
		leaRegRegReg(dest, base, index) then return TargetOp.leaRegRegReg(colorVRegWith(dest, alloc: alloc), base: colorVRegWith(base, alloc: alloc), index: colorVRegWith(index, alloc: alloc))
		leaRegRegImm32(dest, base, disp) then return TargetOp.leaRegRegImm32(colorVRegWith(dest, alloc: alloc), base: colorVRegWith(base, alloc: alloc), disp: disp)
		imulRegRegImm32(dest, src, imm) then return TargetOp.imulRegRegImm32(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc), imm: imm)
		cmpRegImm32(reg, imm) then return TargetOp.cmpRegImm32(colorVRegWith(reg, alloc: alloc), imm: imm)
		xchgRegReg to iatCall then return op
		cqo then return op
		idivReg(divisor) then return TargetOp.idivReg(colorVRegWith(divisor, alloc: alloc))
		pushReg to popReg then return op
		storeSlotReg(slot, srcReg) then return TargetOp.storeSlotReg(slot, srcReg: colorVRegWith(srcReg, alloc: alloc))
		loadRegSlot(destReg, slot) then return TargetOp.loadRegSlot(colorVRegWith(destReg, alloc: alloc), slot: slot)
	end 'rewrite'
end 'colorTargetOp'

// ==========================================================================
// Stats logging
// ==========================================================================

function regAllocStatsMessage(stats RegAllocStats) returns String
	var msg = "regalloc stats: {stats.functionsAllocated} func(s), {stats.valuesColored} values colored, {regMaskPopcount(stats.registersUsed)} distinct regs used\n"
	msg.append("  pressure: maxPressure={stats.maxPressure} (in '{stats.maxPressureFunc}'); maxLoopDepth={stats.maxLoopDepth}; liveness mark-steps total={stats.livenessMarkStepsTotal} max={stats.livenessMarkStepsMax}\n")
	msg.append("  splitter: valuesSplit={stats.valuesSplit} (forced at fixed-reg points={stats.forcedSpills}); reloadsInserted={stats.reloadsInserted}; rematerialized={stats.rematerialized}\n")
	msg.append("  copies inserted={stats.copiesInserted}; hints honoured={stats.hintsHonoured} missed={stats.hintsMissed}\n")
	msg.append("  phase ms: splitting={stats.phaseMsOf(RegAllocPhase.splitting)} liveness={stats.phaseMsOf(RegAllocPhase.liveness)} coloring={stats.phaseMsOf(RegAllocPhase.coloring)} ssaDestruction={stats.phaseMsOf(RegAllocPhase.ssaDestruction)} checking={stats.phaseMsOf(RegAllocPhase.checking)} rewrite={stats.phaseMsOf(RegAllocPhase.rewrite)}")
	return msg
end 'regAllocStatsMessage'
