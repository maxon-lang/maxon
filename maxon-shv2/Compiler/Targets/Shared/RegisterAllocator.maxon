// Register allocator — the real M5 core (pure Design B: SSA chordal coloring + gap
// splitting + E5001; canonical design in ARCHITECTURE.md's register-allocator section). Spine:
// cold-spill splitting → liveness → biased forward-sweep coloring → SSA destruction. M5.2 adopted
// the `Reuse` operand model to DELETE the pre-emitted two-address seed `mov`: ISel now
// emits ONE reuse-def op (`sub`/`imul`/`neg`) and THIS pass materializes the copy only
// when the reuse input outlives the op (`allocateReuseDef`). It REPLACES the M1
// `MinimalColorer` (no liveness; a fresh register per distinct value, forever).
//
// WHAT GATES IT. Two things, and they are the SUITE, not a pass inside the compiler:
//   * RUNNING a spec test proves the allocation is CORRECT. A value left in the wrong register
//     computes the wrong answer, and the test's exit-code assertion catches it end-to-end.
//   * The committed `.test` GOLDENS prove the code did not get WORSE. An extra spill, a lost
//     coalesce, a needlessly widened live range: each still returns the right answer, so only the
//     pinned Target IR can see it. The goldens also reach where the run cannot — one execution
//     takes ONE path, but the golden pins EVERY block of the function. `SpecTestRunner.
//     checkTestFragment` compares them and FAILS on a mismatch; `--update-required` regenerates.
// (M5 carried a symbolic AllocChecker as the third gate, back when the fragments were regenerated
// outputs rather than compared goldens. Once they became gates it was verifying, at ~10% of every
// compile, a property the two above already decide — so it was removed. Its one non-allocation
// check, the CFG `condBranch`-index sweep, lives on in `TargetLiveness.checkCondBranchIndex`,
// where it now runs on EVERY build rather than only under `spec-test`.)
//
// The pieces:
//   • liveness/loops/pressure           — TargetLiveness.maxon
//   • dense bitsets + register masks     — RegBits.maxon
//   • the operand model                  — TargetOperands.maxon (Def/Use, Reuse)
//   • cold-spill live-range splitting    — SplitLiveRanges.maxon
//   • biased forward-sweep colorer       — this file
//   • SSA destruction (edge copies/xchg) — SsaDestruction.maxon
//
// TWO RULES this rests on (design):
//   RULE 1 (SSA). Every value has one def dominating its uses, so live ranges are
//     dominance-closed, the interference graph is CHORDAL, and dominance-order
//     greedy coloring is EXACT (χ = ω = maxPressure). Layout order is a perfect
//     elimination order, ASSERTED by "every use is already colored" at each op.
//   RULE 2 (biased coloring is CORRECTNESS, not optimization). Copy-related values
//     (a phi and its back-edge arg; a reuse def and its two-address input) hold the
//     same value; coloring them together (a) keeps a loop's back-edge / reuse copy
//     from landing IN the loop and (b) stops a false E5001 by not counting one value
//     as two. Hints come from block-arg/branch-arg pairs (collectPhiEdgeHints) and
//     from reuse-def/input pairs (collectReuseHints).
//
// BUILT through M5.4: immediate operand forms + 3-operand lea + the `Reuse`-based
// seed-`mov` deletion (M5.2); idiv/mod FIXED registers (M5.4) — RAX/RDX pinned via
// implicit masks + `forbidOperandsFromImplicit` + the clobber→forbidden path.
//
// The COLD-SPILL SPLITTER (M5.3, SplitLiveRanges) runs BEFORE this colorer and relieves
// every over-pool program point — full-pool overflow at a normal op AND reduced-pool
// overflow at a FIXED-REGISTER point. `maxPressure ≤ pool` alone is NECESSARY but NOT
// SUFFICIENT at such a point: at an `idiv`, values live across it are forbidden {RAX,RDX}
// (effective pool `pool ∖ {RAX,RDX}`); at a call, the callee-saved subset (ARCHITECTURE.md's
// register-allocator "Known limits" #2). The splitter's peak-finder checks each op against its OWN
// reduced pool (`pool ∖ op.implicitDefs`) and splits values live across it, so by the time
// this colorer runs no point — normal or fixed-register — overflows its pool, and coloring
// CANNOT fail. If `chooseRegister` still runs out of registers, the splitter left a point
// unrelieved — a splitter bug, which the panic below names.
//
// A HOT overflow the splitter cannot relieve (a loop whose own working set does not fit) is
// NOT a panic: it is the E5001 compile error, source-mapped via `ValueOrigin` and rendered by
// `RegisterPressureDiagnostic`. Hence `throws CompileError` down this whole path.

// The color column's "not yet colored" sentinel: one past the last real register — the one value a
// `RegNum` holds that is not a register (see `RegNum`).
let Uncolored = RegisterFileSize as RegNum

// A per-function coloring: value id → physical register number (0..15), dense. With
// no live-range splitting at M5.1 a value holds ONE register for its whole range, so
// the column is a total function.
export type Allocation
	export var color as RegNumColumn
	export var valueCount as ValueId

	export static function create(valueCount ValueId) returns Allocation
		return Self{color: filledColumn(valueCount, value: Uncolored), valueCount: valueCount}
	end 'create'

	export function isColored(v ValueId) returns bool
		return (try self.color.get(v) otherwise panic("Allocation.isColored: value {v} out of range")) != Uncolored
	end 'isColored'

	// The register NUMBER assigned to `v` (panics if uncolored — a coloring bug).
	export function regNumOf(v ValueId) returns RegNum
		let c = try self.color.get(v) otherwise panic("Allocation.regNumOf: value {v} out of range")
		if c == Uncolored 'uncolored'
			panic("Allocation.regNumOf: value {v} is uncolored — a use was reached before its def was colored (dominance-order violation)")
		end 'uncolored'
		return c
	end 'regNumOf'

	// The physical register assigned to `v`.
	export function colorOf(v ValueId) returns X64Register
		return try X64Register.fromRawValue(self.regNumOf(v)) otherwise panic("Allocation.colorOf: value {v} colored to invalid register number")
	end 'colorOf'

	export function assign(v ValueId, regNum RegNum)
		try self.color.set(v, value: regNum) otherwise panic("Allocation.assign: value {v} out of range")
	end 'assign'
end 'Allocation'

// The reuse copy to splice before an op, or `none`. A reuse def coalesced into its
// input's register records nothing, so most ops have none.
export union ReuseCopyLookup
	none
	copy(destReg RegNum, srcReg RegNum)
end 'ReuseCopyLookup'

// The reuse-def copies the allocator must MATERIALIZE: `mov destReg, srcReg` spliced in BEFORE
// an op. One is recorded when a two-address reuse def (`sub`/`imul`/`neg`) could NOT be colored
// into its input's register — because the input OUTLIVES the op (its register is still
// occupied), or because a fixed hint (the R8 return value) claimed the destination first. The
// input must therefore be preserved in its own register and copied into the destination before
// the op runs on it. When the input DIES at the op and no fixed hint intervenes, biased coloring
// lands the destination in the input's register and NO copy is recorded — the common case, and
// the whole point of the reuse model. `destReg != srcReg` always (a same-register copy is a
// no-op, never recorded).
//
// KEYED BY THE OP'S LAYOUT SEQUENCE within the function (blocks in order, each block's body ops
// then its terminator — the `collectBlockOps` numbering), so the lookup is a column index rather
// than a scan. The colorer records at that sequence and `applyAllocation`'s splice walks the
// function in exactly that order and reads at exactly that sequence. It cannot be keyed by
// `module.ops` index instead: op
// indices are module-global and a function's are not contiguous (the splitter appends its spill
// ops at the end of the table), so a column keyed by them would be the size of the whole module,
// per function. A list scanned per op was O(ops × copies) — the same quadratic shape the splitter
// had.
export type ReuseCopyPlan
	var present as BoolArray
	var destRegs as RegNumColumn
	var srcRegs as RegNumColumn

	export static function create() returns ReuseCopyPlan
		return Self{present: BoolArray.create(), destRegs: RegNumColumn.create(), srcRegs: RegNumColumn.create()}
	end 'create'

	// Record the copy for the op at layout sequence `seq`. The columns grow to fit rather than
	// being sized up front: a function with no reuse copy at all then allocates nothing.
	//
	// `growFilled`, NEVER `resize`. The colorer walks the function in layout order, so `seq` ARRIVES
	// INCREASING and these columns are extended one copy at a time — the exact shape `resize` is
	// quadratic on, because it reserves EXACTLY the length asked and so reallocates and copies the
	// whole column on every extension: Θ(copies × ops) BYTES for columns that end up Θ(ops) long.
	// `growFilled` grows the capacity geometrically and initialises what it added; `at()` still reads
	// `count()` as "past the last copy", which is unchanged (the length is still `seq + 1`).
	//
	// The register columns are filled with the out-of-file sentinel rather than register 0, so an entry
	// whose `present` flag is false names no real register (`RegNum` is `int(0 to 16)` precisely so that
	// `RegisterFileSize` is representable and is not one of the 0..15 the file holds). Nothing READS it
	// — `at()` returns `none` on a false `present` before it touches either register column — so this is
	// a defence against a future reader, not a value any decision depends on today.
	export function record(seq OpSeq, destReg RegNum, srcReg RegNum)
		let noRegister = RegisterFileSize as RegNum
		self.present.growFilled(seq + 1, value: false)
		self.destRegs.growFilled(seq + 1, value: noRegister)
		self.srcRegs.growFilled(seq + 1, value: noRegister)

		try self.present.set(seq, value: true) otherwise panic("ReuseCopyPlan.record: present.set OOB at sequence {seq}")
		try self.destRegs.set(seq, value: destReg) otherwise panic("ReuseCopyPlan.record: destRegs.set OOB at sequence {seq}")
		try self.srcRegs.set(seq, value: srcReg) otherwise panic("ReuseCopyPlan.record: srcRegs.set OOB at sequence {seq}")
	end 'record'

	// The copy to splice before the op at layout sequence `seq`, or `none`. A sequence past the
	// last recorded copy carries none by construction (the columns only grow to the last one).
	export function at(seq OpSeq) returns ReuseCopyLookup
		if seq >= self.present.count() 'pastLastCopy'
			return ReuseCopyLookup.none
		end 'pastLastCopy'
		let has = try self.present.get(seq) otherwise panic("ReuseCopyPlan.at: present.get OOB at sequence {seq}")
		if not has 'coalesced'
			return ReuseCopyLookup.none
		end 'coalesced'
		let destReg = try self.destRegs.get(seq) otherwise panic("ReuseCopyPlan.at: destRegs.get OOB at sequence {seq}")
		return ReuseCopyLookup.copy(destReg, srcReg: try self.srcRegs.get(seq) otherwise panic("ReuseCopyPlan.at: srcRegs.get OOB at sequence {seq}"))
	end 'at'
end 'ReuseCopyPlan'

// The sub-phases the timers + counters attribute time to (design §"Stats": v1's
// "74% of self-compile" figure stood for months with ZERO sub-phase attribution).
//
// In EXECUTION order, which is the order the whole-compile report prints them under
// the `regalloc` phase. They must together account for ALL of that phase's wall time:
// `criticalEdges` and `blockOrder` exist because they were once un-timed, and the
// module-wide edge split plus a per-function RPO reorder over thousands of blocks is
// not free — leaving them out put ~10% of the compile in a nameless remainder, the
// same "big cost hiding in the wrong bucket" defect this instrumentation exists to
// catch. Whatever these arms still do not claim surfaces as an explicit
// `(unattributed)` row (see CompileTimings.regAllocUnattributedNanos), never as silence.
//
// Ordinals index a per-run array and are persisted nowhere, so this list may be
// reordered freely — but every arm must stay a DISJOINT interval (see `allocateFunction`,
// which subtracts liveness back out of the splitter's wall).
export enum RegAllocPhase
	criticalEdges
	blockOrder
	splitting
	liveness
	coloring
	ssaDestruction
	rewrite
end 'RegAllocPhase'

export typealias DurationNanosArray = Array with DurationNanos

// The function name whose pressure was worst, per register class — a class row of names. `stdlib`'s
// `StringArray` is namespaced to Build and not visible here, and a name is not a `RegCount`, so the
// class rows above cannot carry it.
export typealias PressureFuncByClass = Array with String

// Per-run counters + timers, logged under LogCategory.codegen. Counters matter more
// than the clock at M5.1's sub-millisecond functions (design §"Stats").
export type RegAllocStats
	export var phaseNanos as DurationNanosArray
	export var functionsAllocated as EventCount
	// SSA path-exploration cost (there is no liveness fixpoint — see TargetLiveness).
	export var livenessMarkStepsTotal as EventCount
	export var livenessMarkStepsMax as EventCount
	// The worst per-FILE pressure seen, and the function it was seen in — one entry per register
	// class, because the peak of a mixed figure is no file's peak. `maxPressureFunc` names the
	// function per class for the same reason.
	export var maxPressure as RegCountColumn
	export var maxPressureFunc as PressureFuncByClass
	export var maxLoopDepth as LoopDepth
	export var copiesInserted as EventCount
	export var hintsHonoured as EventCount
	export var hintsMissed as EventCount
	export var valuesColored as EventCount
	export var registersUsed as RegMask
	// Cold-spill splitter (M5.3) counters: values spilled to a slot, reloads emitted for
	// them (one per use-block), and constants rematerialized instead of spilled.
	export var valuesSplit as EventCount
	export var reloadsInserted as EventCount
	export var rematerialized as EventCount
	// Of `valuesSplit`, how many were FORCED spills at a fixed-register point (a call / `idiv`)
	// rather than COLD splits of an idle value — the amended Rule 2's mechanism. These are the
	// spills permitted INSIDE a loop, so this is the counter to watch: it is the number of
	// store/reload brackets in hot code, and each one is a program that would otherwise have been
	// a FALSE E5001.
	export var forcedSpills as EventCount

	export static function create() returns RegAllocStats
		var phaseNanos = DurationNanosArray.create()
		phaseNanos.resize(RegAllocPhase.allCases.count())
		var maxPressureFunc = PressureFuncByClass.create()
		for _ in 0 upto RegClassCount 'eachClass'
			maxPressureFunc.push("")
		end 'eachClass'
		return Self{phaseNanos: phaseNanos, functionsAllocated: 0, livenessMarkStepsTotal: 0, livenessMarkStepsMax: 0, maxPressure: zeroClassRow(), maxPressureFunc: maxPressureFunc, maxLoopDepth: 0, copiesInserted: 0, hintsHonoured: 0, hintsMissed: 0, valuesColored: 0, registersUsed: 0, valuesSplit: 0, reloadsInserted: 0, rematerialized: 0, forcedSpills: 0}
	end 'create'

	export function addPhaseNanos(phase RegAllocPhase, nanos DurationNanos)
		let idx = phase.ordinal
		let cur = try self.phaseNanos.get(idx) otherwise panic("RegAllocStats.addPhaseNanos: phase index OOB")
		try self.phaseNanos.set(idx, value: cur + nanos) otherwise panic("RegAllocStats.addPhaseNanos: phase index OOB")
	end 'addPhaseNanos'

	export function phaseNanosOf(phase RegAllocPhase) returns DurationNanos
		return try self.phaseNanos.get(phase.ordinal) otherwise panic("RegAllocStats.phaseNanosOf: phase index OOB")
	end 'phaseNanosOf'

	export function recordLivenessMarkSteps(steps EventCount)
		self.livenessMarkStepsTotal = self.livenessMarkStepsTotal + steps
		if steps > self.livenessMarkStepsMax 'newMax'
			self.livenessMarkStepsMax = steps
		end 'newMax'
	end 'recordLivenessMarkSteps'

	export function recordPressure(pressure RegCount, class RegClass, funcName ByteArray)
		if pressure > classRowGet(self.maxPressure, class: class) 'newMax'
			classRowSet(self.maxPressure, class: class, value: pressure)
			try self.maxPressureFunc.set(class.ordinal, value: String.from(funcName)) otherwise panic("RegAllocStats.recordPressure: no maxPressureFunc entry for the {class.name} file")
		end 'newMax'
	end 'recordPressure'

	export function recordLoopDepth(depth LoopDepth)
		if depth > self.maxLoopDepth 'newMax'
			self.maxLoopDepth = depth
		end 'newMax'
	end 'recordLoopDepth'

	export function noteRegisterUse(regNum RegNum)
		self.registersUsed = regMaskAdd(self.registersUsed, regNum: regNum)
	end 'noteRegisterUse'
end 'RegAllocStats'

// The allocatable register pool for `target`. M5.6 GREW the pool to the full 14 GPRs
// (every register except rsp/rbp, the frame): the 9 CALLER-saved {rax, rcx, rdx, rsi,
// rdi, r8, r9, r10, r11} PLUS the 5 CALLEE-saved {rbx, r12–r15}. The callee-saved half
// is what makes calls colorable: a value live ACROSS a call is forbidden every caller-
// saved register (`callDirect`'s `implicitDefs`), so its only home is a callee-saved
// register — the prologue/epilogue pass then push/pops exactly the callee-saved registers
// a function's coloring actually used. R8 is admitted because `ret`'s implicit-use mask
// proves nothing is live across the `mov r8, retval` return move. r10/r11 stay in the
// pool — shv2 needs no reserved scratch (SSA destruction breaks copy cycles with `xchg`,
// and the IAT call is RIP-relative), so the doc's r10/r11-as-scratch is a FUTURE tuning.
// The pool is a property of the target — arm64 declares its own when its backend lands.
export function allocatablePool(target Target) returns RegMask
	if target.os != Os.windows 'unsupported'
		panic("allocatablePool: maxon-shv2 allocates for x64-windows only (got {targetToString(target)})")
	end 'unsupported'
	return callerSavedMask() or calleeSavedMask() or classRegisterMask(RegClass.xmm)
end 'allocatablePool'

// The registers of ONE class that `pool` makes available — and the pool EVERY per-value question must
// be asked against, because a value can only ever take a register from its own file.
//
// ⚠ `allocatablePool` is the WHOLE MACHINE's pool, spanning both files. Asking a per-value question
// against it answers about registers the value can never have, and the two failures are OPPOSITE: an
// int's 14 allowed registers measured against a 30-register pool read CONSTRAINED forever (a
// permanent census over every operand of every op — a pure TIME cost, which `scale-test` measures no
// part of), while a 15-live-int pigeonhole measured against the same 30 never fires at all and lets
// the colorer run out of registers. Both are the same mistake: a class-agnostic denominator.
export function poolOfClass(pool RegMask, class RegClass) returns RegMask
	return pool and classRegisterMask(class)
end 'poolOfClass'

// How many registers a value of `class` could take if nothing were blocked — the denominator of every
// "is this value constrained?" and "is this point over its pool?" test.
//
// ⚠ IT TAKES THE POOL, AND THAT IS THE WHOLE POINT: A FILE'S WIDTH IS NOT A POOL'S. The GPR file is
// 16 wide, but rsp/rbp are the frame and are never allocatable, so a GPR value's pool is FOURTEEN.
// A `classPoolSize(class)` reading the width off `classRegisterMask` alone briefly lived in RegBits
// and returned 16 — under a comment that itself said "an int's 14 allowed registers". Measuring
// `constrained` against it reports every unconstrained int as constrained (14 < 16), which is the
// exact permanent-census regression the per-class denominator exists to prevent, reintroduced by a
// denominator off by two. v1 reaches the same shape independently: its `poolSizeFor(regClass, desc)`
// reads the pool size off the TARGET DESCRIPTOR, never off the register file.
export function classPoolSizeOf(pool RegMask, class RegClass) returns RegCount
	return regMaskPopcount(poolOfClass(pool, class: class))
end 'classPoolSizeOf'

// Guard the load-bearing invariant that `callDirect`'s inline `implicitDefs` clobber
// mask (which the liveness pass forbids for every value live across a call) equals the
// CALLER-saved half of the allocatable pool: a value live across a call is forbidden the
// former and must find a home in `pool ∖ caller-saved` = the callee-saved half. If they
// drift, such a value is mis-constrained — a false E5001 later, or a real clobber. The
// mask is read from the op's own metadata (not re-spelled), and rbx is checked out of it
// explicitly (a shipped v1 bug — project_regalloc_crosscall_spill_fixes). Runs once per
// module, so the check is free.
function assertCallClobberConsistent()
	let clobber = TargetOp.callDirect("").rawValue.implicitDefs
	if clobber != callerSavedMask() 'drift'
		panic("assertCallClobberConsistent: callDirect clobber mask {clobber} != caller-saved pool {callerSavedMask()} — TargetDialect.callDirect's implicitDefs and RegisterAllocator.callerSavedMask drifted apart")
	end 'drift'
	if regMaskContains(clobber, regNum: X64Register.rbx.rawValue) 'rbxClobbered'
		panic("assertCallClobberConsistent: callDirect clobber mask wrongly includes rbx, which is CALLEE-saved (project_regalloc_crosscall_spill_fixes shipped exactly this bug in v1)")
	end 'rbxClobbered'
end 'assertCallClobberConsistent'

// Every CALLER-saved register the custom ABI clobbers across a call — the same set
// `callDirect`'s `implicitDefs` mask (0xFFFF0FC7) names, kept in ONE place so the pool and
// the clobber mask cannot drift (asserted equal by `assertCallClobberConsistent`). A
// value live across a call is forbidden all of these.
//
// ⭐ ALL SIXTEEN XMMs ARE CALLER-SAVED (Wave 1), so a float live across a call is forbidden its
// ENTIRE file, has NO register left, and force-spills. That is bought deliberately: it is what makes
// an EMPTY allowed set reachable, which is the case `valueConfinedTo` exists to guard (∅ is a subset
// of every set, so an empty allowed set must never read as confined to a GPR witness). Taking
// xmm6-15 as callee-saved is Wave 2 and is not a tweak — Win64 preserves all 128 bits of them while
// `movsd` zeroes bits 64-127, so it needs 16-byte spill slots and leaf frame alignment together.
export function callerSavedMask() returns RegMask
	var mask = classRegisterMask(RegClass.xmm)
	mask = mask or regMaskOf(X64Register.rax)
	mask = mask or regMaskOf(X64Register.rcx)
	mask = mask or regMaskOf(X64Register.rdx)
	mask = mask or regMaskOf(X64Register.rsi)
	mask = mask or regMaskOf(X64Register.rdi)
	mask = mask or regMaskOf(X64Register.r8)
	mask = mask or regMaskOf(X64Register.r9)
	mask = mask or regMaskOf(X64Register.r10)
	mask = mask or regMaskOf(X64Register.r11)
	return mask
end 'callerSavedMask'

// The 5 CALLEE-saved GPRs a function must preserve across its own body — the effective
// pool for a value live across a call. The prologue/epilogue pass push/pops exactly the
// ones a function's coloring used. rsp/rbp are the frame and are never allocatable.
export function calleeSavedMask() returns RegMask
	var mask = 0 as RegMask
	mask = mask or regMaskOf(X64Register.rbx)
	mask = mask or regMaskOf(X64Register.r12)
	mask = mask or regMaskOf(X64Register.r13)
	mask = mask or regMaskOf(X64Register.r14)
	mask = mask or regMaskOf(X64Register.r15)
	return mask
end 'calleeSavedMask'

// Color every function's virtual registers into physical GPRs, in place. Only USER
// functions are present here — `mrt_start` is prepended AFTER this pass by
// augmentWithRuntime (it is hand-built in physical registers). `throws CompileError`
// because a genuine hot-loop overflow is E5001, reported onto `project.diagnostics`.
// One `ValueClassColumn` PER FUNCTION, indexed by the same function index `module.functions` is —
// the shape the allocator's entry point takes the lowering's class output in.
//
// ⚠ IT IS PER FUNCTION BECAUSE A ValueId IS. "Function-local and dense, allocated from a per-function
// counter" (IrValueId) — so function 0's value 3 and function 1's value 3 are different values, and a
// single module-wide column indexed by ValueId would alias them onto one class. The `ValueClassColumn`
// the contract declares is therefore ONE function's; this is the carrier that says which.
export typealias ValueClassColumns = Array with ValueClassColumn

// Every value of every function classified `gpr` — the placeholder the lowering's real class output
// replaces.
//
// ⚠ THIS IS A TEMPORARY STAND-IN FOR A PRODUCER THAT DOES NOT EXIST YET, and it is correct ONLY while
// no float can reach the backend. It is honest today for a checkable reason: `StdToX64Conversion`
// still PANICS on a float const, and the parser has no float arm at all, so every value the Target
// tier can currently hold is an i64/bool/char in a GPR. It is a lie the instant either changes.
//
// ⇒ WHEN `StdToX64Conversion` LEARNS TO LOWER A FLOAT, IT MUST RECORD THE CLASS AS IT MINTS EACH VREG
// (`stdTypeIsFloat` → `RegClass.xmm`) AND THIS FUNCTION MUST DIE. Leaving it in place would classify
// every f64 as `gpr`, and that failure is SILENT all the way to `addsd rax, rcx` — the allocator's
// asserts compare a colour against the DECLARED class, so a uniformly-wrong declaration agrees with
// itself. See `TargetDialect.ValueClassColumn`, which states the producer/consumer direction, and
// `assertClassColumnCovers`, which catches a SHORT column but cannot catch a wrong one.
export function allGprValueClasses(module TargetModule) returns ValueClassColumns
	var columns = ValueClassColumns.create()
	for funcIndex in 0 upto module.funcCount() 'eachFunc'
		let func = try module.functions.get(funcIndex) otherwise panic("allGprValueClasses: functions.get OOB at {funcIndex}")
		var column = ValueClassColumn.create()
		column.refill(scanFunctionValueCount(module, func: func), value: RegClass.gpr)
		columns.push(column)
	end 'eachFunc'
	return columns
end 'allGprValueClasses'

export function allocateRegisters(module TargetModule, target Target, project Project, valueClasses ValueClassColumns) throws CompileError
	logDebug(LogCategory.codegen, message: function() gives "Register allocation ({targetToString(target)}): {module.funcCount()} function(s)")
	assertCallClobberConsistent()
	assertRegClassCountMatches()

	// The stats object is the PROJECT's, not a fresh one: its sub-phase timers are a
	// breakdown of the `regalloc` phase `buildBackend` measures around this call, and the
	// whole-compile report nests them under it and reconciles the two (any regalloc time
	// they do not claim — the driver loop itself — surfaces as a nested `(unattributed)`
	// row rather than vanishing). A locally-created stats object would be a second,
	// disconnected accounting of the same wall time.
	var stats = project.timings.regAlloc
	let pool = allocatablePool(target)

	// Split every phi-carrying CRITICAL edge before coloring, so SSA destruction
	// always has a safe home for its parallel copies. This runs OUTSIDE the
	// per-function loop (it mutates `func.blockRefs`, which the loop's `func` borrow
	// would forbid).
	let edgeProbe = PhaseProbe.beginRegAllocPhase(project, phase: RegAllocPhase.criticalEdges)
	splitCriticalEdges(module)
	recordRegAllocPhase(project, phase: RegAllocPhase.criticalEdges, probe: edgeProbe)

	// Index-based (not `for func in ...`) because the loop index IS the function's
	// Maxon-tier index: function indices are 1:1 across Maxon -> Std -> Target, and
	// `mrt_start` is prepended only AFTER this pass, so `module.functions` here is the
	// user functions in their Maxon declaration order. The E5001 diagnostic passes this
	// index to `ValueOriginTable.lookup` to map a value back to its source op.
	for funcIndex in 0 upto module.funcCount() 'eachFunc'
		var func = try module.functions.get(funcIndex) otherwise panic("allocateRegisters: functions.get OOB at {funcIndex}")
		let classes = try valueClasses.get(funcIndex) otherwise panic("allocateRegisters: the lowering produced class columns for {valueClasses.count()} function(s) but the module has {module.funcCount()} — every function's vregs are classified as they are minted, so the two counts are the same walk of the same module")
		try allocateFunction(module, func: func, funcIndex: funcIndex, pool: pool, valueClass: classes, stats: stats, project: project)
	end 'eachFunc'
	logDebug(LogCategory.codegen, message: function() gives regAllocStatsMessage(stats))
end 'allocateRegisters'

function allocateFunction(module TargetModule, func IrFunction, funcIndex FuncIndex, pool RegMask, valueClass ValueClassColumn, stats RegAllocStats, project Project) throws CompileError
	// Lay the blocks out in reverse-postorder FIRST, so layout order matches execution order.
	// The cold-spill splitter's before/after-peak classification (and the colorer's dominance
	// walk) rest on that; the parser emits a nested loop's exit before its inner blocks, which
	// would otherwise misclassify an idle value's post-loop use and false-E5001 (single-loop /
	// straight-line CFGs are already in RPO, so they are untouched). See reorderFuncBlocksRpo.
	//
	// It hands back the REORDERED skeleton, which the splitter completes into its `FuncCfg`
	// rather than re-deriving from the IR. Nothing runs between the two, and the splitter never
	// adds or removes a block, so the skeleton stays exactly this function's for the whole of
	// allocation. (`splitCriticalEdges` DID add blocks — which is why it runs before this, and
	// why its own skeleton cannot be carried forward.)
	let orderProbe = PhaseProbe.beginRegAllocPhase(project, phase: RegAllocPhase.blockOrder)
	let topo = reorderFuncBlocksRpo(module, func: func)
	recordRegAllocPhase(project, phase: RegAllocPhase.blockOrder, probe: orderProbe)

	// Cold-spill live-range splitting (M5.3): where register pressure exceeds the pool, split
	// idle values out (store in a cold, dominating spot and reload at their uses) or
	// rematerialize constants, so the colorer below always finds `maxPressure ≤ pool`. HOT
	// pressure a loop genuinely cannot fit is raised as E5001 from inside the splitter.
	// It runs FIRST because it MUTATES the IR — adding spill/reload/remat ops and
	// fresh reload values that the liveness and coloring below then both consume. The
	// splitter computes liveness internally and returns the final result (`maxPressure ≤
	// pool` guaranteed), so no separate liveness pass is needed here.
	// The splitter OWNS the liveness computation (one whole-function build, which it then REPAIRS
	// incrementally after each split), and it bills that build to RegAllocPhase.liveness itself.
	// Subtract it back out here so the two phases are DISJOINT and the sub-phases sum to the true
	// total — otherwise `splitting` silently includes `liveness` and the biggest cost in the allocator
	// hides inside the wrong bucket, which is exactly the "74% with zero sub-phase attribution"
	// failure this instrumentation exists to prevent.
	//
	// The subtraction now covers ALL FOUR quantities, not just the clock: liveness allocates as well
	// as costs time, and billing the splitter for liveness's allocations would put the allocator's
	// memory in the wrong bucket the same way the original bug put its time there. `recordPhaseExcluding`
	// does it in one place for all four (see PhaseProbe).
	let livenessBefore = regAllocAccumulated(project, phase: RegAllocPhase.liveness)
	let splitProbe = PhaseProbe.beginRegAllocPhase(project, phase: RegAllocPhase.splitting)
	let liveness = try splitLiveRanges(module, func: func, funcIndex: funcIndex, topo: topo, pool: pool, valueClass: valueClass, stats: stats, project: project)
	recordPhaseExcluding(project, phase: RegAllocPhase.splitting, probe: splitProbe, innerPhase: RegAllocPhase.liveness, innerBefore: livenessBefore)

	stats.recordLivenessMarkSteps(liveness.livenessMarkSteps)
	// PER CLASS, so the report names the file that was tight rather than a mixed figure that is no
	// file's peak. A function with 14 live ints and 14 live floats is at its limit in BOTH files and
	// over its limit in neither; one number cannot say that.
	for classOrdinal in 0 upto RegClassCount 'eachClass'
		let class = regClassAt(classOrdinal)
		stats.recordPressure(liveness.maxPressureOf(class), class: class, funcName: func.name)
	end 'eachClass'
	stats.recordLoopDepth(liveness.cfg.maxLoopDepth())

	// Reuse-def copies the colorer materializes (two-address inputs that outlive their
	// op) — consumed by the rewrite, which splices them. Populated during coloring.
	var reuseCopies = ReuseCopyPlan.create()

	let colorProbe = PhaseProbe.beginRegAllocPhase(project, phase: RegAllocPhase.coloring)
	let alloc = colorFunction(module, liveness: liveness, pool: pool, stats: stats, reuseCopies: reuseCopies)
	recordRegAllocPhase(project, phase: RegAllocPhase.coloring, probe: colorProbe)

	let planProbe = PhaseProbe.beginRegAllocPhase(project, phase: RegAllocPhase.ssaDestruction)
	let plans = buildSsaDestructionPlan(module, alloc: alloc, liveness: liveness, stats: stats)
	recordRegAllocPhase(project, phase: RegAllocPhase.ssaDestruction, probe: planProbe)

	let rewriteProbe = PhaseProbe.beginRegAllocPhase(project, phase: RegAllocPhase.rewrite)
	applyAllocation(module, func: func, alloc: alloc, plans: plans, reuseCopies: reuseCopies)
	recordRegAllocPhase(project, phase: RegAllocPhase.rewrite, probe: rewriteProbe)

	stats.functionsAllocated = stats.functionsAllocated + 1

	// PER-FUNCTION allocator facts, on the wire. The two numbers that decide whether this
	// function was hard — peak pressure, and how many values had to leave a register — are
	// exactly what you want when hunting a spill regression or a false E5001, and until now
	// there was NO way to see them per function: the counters are aggregated over the module,
	// and a formatted log line here would run once per function and allocate a String into the
	// very `mm` stream a memory investigation is reading.
	//
	// This event allocates NOTHING. `__DebugStream.nameId` is folded to a u16 by the compiler,
	// so the name below never exists at runtime — which is the whole reason the structured tier
	// exists, and why it can sit on a per-function path at all.
	let event = __DebugStream.nameId("regalloc.functionAllocated") as TraceName
	logEvent(LogCategory.codegen, level: LogLevel.TRACE, name: event, arg0: classRowMax(liveness.maxPressure), arg1: stats.valuesSplit)
end 'allocateFunction'

// ==========================================================================
// Register hints (biased coloring) — a CORRECTNESS obligation, not an optimization
// ==========================================================================

// The "no fixed-register hint" sentinel (a copy-partner uses valueCount) — the same
// one-past-the-last-register value `Uncolored` uses, and the reason `RegNum` runs to 16.
let NoFixedHint = RegisterFileSize as RegNum

// Per-value coloring hints: a FIXED physical register (a value copied to/from a
// pinned register — the R8 return value), and a COPY PARTNER value (a two-address
// seed's source, or the value on the other end of a phi edge). At a def the fixed
// register is tried first, then the partner's register; taking one collapses
// copy-related values into a single register so the copy elides — for a loop back
// edge, that keeps the copy OUT of the loop.
type ColorHints
	export var fixedHint as RegNumColumn
	export var copyHint as ValueIdArray
	export var noPartner as ValueId

	export static function create(valueCount ValueId) returns ColorHints
		let fixedHint = filledColumn(valueCount, value: NoFixedHint)
		let copyHint = filledColumn(valueCount, value: valueCount)
		return Self{fixedHint: fixedHint, copyHint: copyHint, noPartner: valueCount}
	end 'create'

	function setFixedIfUnset(v ValueId, regNum RegNum)
		let cur = try self.fixedHint.get(v) otherwise panic("ColorHints.setFixedIfUnset: OOB")
		if cur == NoFixedHint 'unset'
			try self.fixedHint.set(v, value: regNum) otherwise panic("ColorHints.setFixedIfUnset: set OOB")
		end 'unset'
	end 'setFixedIfUnset'

	function setCopyIfUnset(v ValueId, partner ValueId)
		if v == partner 'selfPartner'
			return
		end 'selfPartner'
		let cur = try self.copyHint.get(v) otherwise panic("ColorHints.setCopyIfUnset: OOB")
		if cur == self.noPartner 'unset'
			try self.copyHint.set(v, value: partner) otherwise panic("ColorHints.setCopyIfUnset: set OOB")
		end 'unset'
	end 'setCopyIfUnset'

	export function fixedOf(v ValueId) returns RegNum
		return try self.fixedHint.get(v) otherwise panic("ColorHints.fixedOf: OOB")
	end 'fixedOf'

	export function copyOf(v ValueId) returns ValueId
		return try self.copyHint.get(v) otherwise panic("ColorHints.copyOf: OOB")
	end 'copyOf'

	export function hasFixed(v ValueId) returns bool
		return self.fixedOf(v) != NoFixedHint
	end 'hasFixed'

	export function hasCopy(v ValueId) returns bool
		return self.copyOf(v) != self.noPartner
	end 'hasCopy'
end 'ColorHints'

// Collect hints by scanning ops (seed copies + the R8 return move) and phi edges.
// Blocks are scanned in layout order so a phi's stored copy partner is its
// FORWARD-edge incoming (defined in a dominator) — the one already colored when the
// phi is reached.
function computeHints(module TargetModule, topo FuncTopology, valueCount ValueId) returns ColorHints
	var hints = ColorHints.create(valueCount)
	var buf = OperandList.create()
	for local in 0 upto topo.numBlocks 'eachBlock'
		let block = blockAt(module, topo: topo, local: local)

		var ordered = OpIndexArray.create()
		collectBlockOps(block, out: ordered)
		for opIdx in ordered 'eachOp'
			let op = try module.ops.get(opIdx) otherwise panic("computeHints: opIdx not in module.ops")
			collectOpHints(op, hints: hints)
			collectReuseHints(op, hints: hints, buf: buf)
		end 'eachOp'

		collectPhiEdgeHints(module, topo: topo, predBlock: block, hints: hints)
	end 'eachBlock'
	return hints
end 'computeHints'

// A `movRegReg`/`movReg32Reg32` carries a coloring hint: a copy to a FIXED register
// hints its virtual source to that register (the R8 return move → the return value
// elides). (With the two-address seed `mov` retired, no virtual-to-virtual copy op
// exists at coloring time; the two-address hint now comes from `collectReuseHints`.)
function collectOpHints(op TargetOp, hints ColorHints)
	match op 'hint'
		movRegReg(dst, src) then addCopyHint(dst, src: src, hints: hints)
		movReg32Reg32(dst, src) then addCopyHint(dst, src: src, hints: hints)
		prologue to jcc then break 'hint'
		movRegImm to movRegImm32 then break 'hint'
		subRegReg to idivReg then break 'hint'
		pushReg to popReg then break 'hint'
		storeSlotReg to loadRegSlot then break 'hint'
		// The bit band carries no COPY hint: none of these ops is a move. Their two-address
		// `dest ⟸ lhs` bias is a REUSE hint, which `collectReuseHints` reads straight off
		// the operand model — so it covers every one of them without an arm here.
		// The data-section band carries no COPY hint either: a `lea`, a load and a store are
		// none of them a move, so no two of their operands want the same register.
		andRegReg to cvttsd2siRegReg then break 'hint'
	end 'hint'
end 'collectOpHints'

// The two-address biased-coloring hint (Phase 5, a CORRECTNESS obligation): for each
// REUSE def, hint the def and its reuse input to each other's register, so the colorer
// coalesces them and NO copy is materialized when the input dies at the op. Read
// straight off the operand model, so it covers every reuse op (`sub`/`imul`/`neg`)
// without a per-op arm.
function collectReuseHints(op TargetOp, hints ColorHints, buf OperandList)
	targetOpOperands(op, buf: buf)
	for o in buf 'eachOperand'
		if operandIsReuseDef(o) and operandIsVirtual(o) 'reuseDef'
			let destId = operandValueId(o)
			let inputId = operandReuseInputValueId(o, buf: buf)
			hints.setCopyIfUnset(destId, partner: inputId)
			hints.setCopyIfUnset(inputId, partner: destId)
		end 'reuseDef'
	end 'eachOperand'
end 'collectReuseHints'

function addCopyHint(dst X64VReg, src X64VReg, hints ColorHints)
	match dst 'd'
		physical(dReg) then addFixedFromPhysDst(dReg, src: src, hints: hints)
		virtual(dId) then addCopyFromVirtualDst(dId, src: src, hints: hints)
	end 'd'
end 'addCopyHint'

// `mov <fixed physical>, <virtual src>`: the source wants that fixed register.
function addFixedFromPhysDst(dReg X64Register, src X64VReg, hints ColorHints)
	match src 's'
		virtual(sId) then hints.setFixedIfUnset(sId, regNum: dReg.rawValue)
		physical then break 's'
	end 's'
end 'addFixedFromPhysDst'

// `mov <virtual dst>, <src>`: dst wants src's register (virtual src) or src's fixed
// register (physical src). No such op survives to coloring today (the two-address seed
// `mov` is retired and edge copies are post-coloring), but the handler stays general so
// a future virtual-to-virtual copy op is hinted correctly.
function addCopyFromVirtualDst(dId ValueId, src X64VReg, hints ColorHints)
	match src 's'
		virtual(sId) then hints.setCopyIfUnset(dId, partner: sId)
		physical(sReg) then hints.setFixedIfUnset(dId, regNum: sReg.rawValue)
	end 's'
end 'addCopyFromVirtualDst'

// Each phi and the value a predecessor passes it on an edge are copy-related — hint
// them to each other so the parallel edge copy elides (the loop back edge especially,
// where a surviving copy would land inside the loop body).
function collectPhiEdgeHints(module TargetModule, topo FuncTopology, predBlock IrBlock, hints ColorHints)
	for edge in predBlock.branchEdges 'eachEdge'
		let targetBlock = blockAt(module, topo: topo, local: localOfBlockId(topo, blockId: edge.targetBlockId))
		let view = PhiEdgeView.resolve(targetBlock, argIds: edge.argIds, context: PhiEdgeConsumer.coloringHints)
		for k in 0 upto view.count 'eachPhi'
			let phi = view.phiValueIdAt(k)
			let incoming = view.incomingAt(k)
			hints.setCopyIfUnset(phi, partner: incoming)
			hints.setCopyIfUnset(incoming, partner: phi)
		end 'eachPhi'
	end 'eachEdge'
end 'collectPhiEdgeHints'

// ==========================================================================
// The colorer — a forward sweep over a `u16` in-use mask, per block
// ==========================================================================

function colorFunction(module TargetModule, liveness LivenessResult, pool RegMask, stats RegAllocStats, reuseCopies ReuseCopyPlan) returns Allocation
	let topo = liveness.cfg.topo
	let valueCount = liveness.valueCount
	let wordsPerRow = liveness.wordsPerRow
	var alloc = Allocation.create(valueCount)
	let hints = computeHints(module, topo: topo, valueCount: valueCount)
	var buf = OperandList.create()
	// Scratch reused across every block — the live-set walks, the op list, and the death sweep's
	// working row would otherwise each allocate once per block. `seenBelow` is ONE dense row (not a
	// matrix); `computeBlockDeaths` returns it to zero in O(live) before the next block.
	var liveBuf = ValueIdArray.create()
	var seedBuf = ValueIdArray.create()
	var ordered = OpIndexArray.create()
	var seenBelow = BitWordArray.create()
	seenBelow.resize(wordsPerRow)
	// The death scan's per-class live tally. It is never READ — the scan wants the row alone — but the
	// backward step maintains it as it flips bits and its decrements panic on underflow, so it must be
	// real and truthfully seeded. Allocated HERE and reused across every block, like every other
	// buffer in this sweep.
	var deathsLiveByClass = zeroClassRow()
	// The op's LAYOUT SEQUENCE across the whole function — the key `reuseCopies` is recorded
	// under, and the same numbering the rewrite re-derives from `collectBlockOps`.
	var blockBaseSeq = 0 as OpSeq

	for local in 0 upto topo.numBlocks 'eachBlock'
		let block = blockAt(module, topo: topo, local: local)

		// Seed occupancy from the non-phi live-ins (each already colored in a
		// dominator), then allocate the block-arg phis defined at entry.
		var inUse = seedInUse(liveness, local: local, alloc: alloc, liveBuf: liveBuf)
		for arg in block.blockArgs 'eachPhi'
			inUse = allocateDef(arg.valueId, working: inUse, dyingRegs: 0, hints: hints, alloc: alloc, liveness: liveness, pool: pool, stats: stats)
		end 'eachPhi'

		ordered.clear()
		collectBlockOps(block, out: ordered)
		let deaths = computeBlockDeaths(module, ordered: ordered, liveness: liveness, local: local, block: block, buf: buf, seenBelow: seenBelow, seedBuf: seedBuf, liveByClass: deathsLiveByClass)

		for pos in 0 upto ordered.count() 'eachOp'
			let opIdx = try ordered.get(pos) otherwise panic("colorFunction: ordered.get OOB")
			inUse = colorOpForward(module, opIdx: opIdx, pos: pos, seq: blockBaseSeq + pos, inUse: inUse, deaths: deaths, hints: hints, alloc: alloc, liveness: liveness, pool: pool, stats: stats, buf: buf, reuseCopies: reuseCopies)
		end 'eachOp'

		blockBaseSeq = blockBaseSeq + ordered.count()
	end 'eachBlock'

	return alloc
end 'colorFunction'

// The in-use mask at a block's entry: every non-phi live-in value occupies its
// color. A live-in value must already be colored (its def dominates) — the
// dominance-order assertion.
//
// Walks the SET BITS of the live-in row, not the value space. Testing every value id here would be
// O(blocks × values) — the quadratic that dominated register allocation on a large function — and
// a live set holds a handful of values out of thousands of ids. `liveBuf` is a scratch buffer
// reused across blocks, so this allocates nothing.
function seedInUse(liveness LivenessResult, local CfgIndex, alloc Allocation, liveBuf ValueIdArray) returns RegMask
	liveness.liveInInto(local, out: liveBuf)

	var mask = 0 as RegMask
	for v in liveBuf 'eachLiveIn'
		if not alloc.isColored(v) 'notColored'
			panic("seedInUse: value {v} is live-in to block {local} but was never colored — a use dominates its def (structured-layout invariant broken)")
		end 'notColored'
		mask = regMaskAdd(mask, regNum: alloc.regNumOf(v))
	end 'eachLiveIn'
	return mask
end 'seedInUse'

// Allocate a register for `v`. Every value has exactly ONE def (RULE 1), so `v` is
// never already colored here — that would be a double-def bug, which asserts. `blocked`
// = the currently-in-use registers (minus those DYING at this op, which a def may
// reuse) ∪ `v`'s forbidden set ∪ the non-pool registers. Returns `working` with the
// assigned register added, so the next def at the same op avoids it.
function allocateDef(v ValueId, working RegMask, dyingRegs RegMask, hints ColorHints, alloc Allocation, liveness LivenessResult, pool RegMask, stats RegAllocStats) returns RegMask
	if alloc.isColored(v) 'doubleDef'
		panic("allocateDef: value {v} is already colored — a value has two defs, violating the single-def SSA invariant (RULE 1)")
	end 'doubleDef'

	// `v`'s POOL IS ITS OWN FILE'S, and blocking everything outside it is the ONE structural guard
	// that keeps an int out of an XMM. Every register `v` could take flows from this mask: the hint
	// paths test it (`hintIsTakeable`), and the fallback picks the lowest bit CLEAR in it
	// (`lowestClearRegister` scans both files and trusts the caller to have excluded the other one).
	// So a class filter here covers every route to a register, and the alternative — filtering at each
	// route — is the same fact written down four times, one of which will be forgotten.
	let class = liveness.classOf(v)
	let classPool = poolOfClass(pool, class: class)
	let blocked = (working and not dyingRegs) or liveness.forbiddenOf(v) or (fullRegisterMask() and not classPool)
	let reg = chooseRegister(v, classPool: classPool, blocked: blocked, dyingRegs: dyingRegs, hints: hints, alloc: alloc, liveness: liveness, stats: stats)
	assertColouredInClass(v, reg: reg, class: class)
	alloc.assign(v, regNum: reg)
	stats.valuesColored = stats.valuesColored + 1
	stats.noteRegisterUse(reg)
	return regMaskAdd(working, regNum: reg)
end 'allocateDef'

// The colour `v` just took must be a register of `v`'s OWN file. This is the backstop on the class
// filter in `allocateDef`: every route to a register runs through that one `blocked` mask, so this
// can only fire if a route learned to bypass it — which is precisely what `pickPreferredRegister` and
// the hint path did when they each spelled "the whole pool" as `fullRegisterMask()`.
//
// ⚠ IT CANNOT CATCH A MIS-DECLARED CLASS. It compares the colour against the DECLARED class, so a
// float that was never declared `xmm` is coloured into a GPR and agrees with itself here. Declaring
// the class correctly is the op's job and nothing downstream can check it — see
// `TargetLiveness.makeRegClassColumn`.
function assertColouredInClass(v ValueId, reg RegNum, class RegClass)
	if regClassOf(reg) != class 'wrongFile'
		panic("assertColouredInClass: value {v} is a {class.name} value but was coloured into register {reg}, which is in the {regClassOf(reg).name} file — a route to a register bypassed the class filter in `allocateDef`'s `blocked` mask. An int in an XMM (or a float in a GPR) encodes to a different instruction, so this is a silent miscompile, not a performance bug.")
	end 'wrongFile'
end 'assertColouredInClass'

// Pick a register for `v`. The hints come first, in this order — each is the register `v` must take
// for SOME copy to elide, most-certain first:
//
//   1. `v`'s OWN fixed hint — a physical operand pins it (the `mov r8, retval` return move).
//   2. its copy partner's REGISTER, when the partner is already colored (the back-edge arg taking
//      over the phi's register: this is what keeps a loop body copy-free).
//   3. its copy partner's PIN, when the partner is NOT yet colored (`pinnedPartnerRegister`).
//
// and the fallback is the lowest free register of `v`'s COPY GROUP's preferred VOLATILITY
// (`copyGroupBlocked`). Hints 3 and the group volatility are the BACKWARD half: a forward sweep in
// dominance order colors the def before the phi, so without them a phi's constraints can never
// reach the value that feeds it, and the pair costs two registers.
//
// **A hint may not ALLOCATE a register outside that class while the class still has one free — but
// it may always TRANSFER one that is being vacated at this very op.** Those are different acts and
// only the first one is harmful:
//
//  • TRANSFER (`hintReg ∈ dyingRegs`) — the partner dies right here, so `v` inherits the register it
//    was already holding. Total registers used: unchanged. This is the whole point of biased
//    coloring: a loop-carried accumulator's update takes over the phi's register, so SSA
//    destruction emits NO back-edge copy and the loop body stays copy-free. Always allow it.
//
//  • ALLOCATION (the register is merely idle) — `v` consumes a register nothing was holding. If
//    that register is CALLEE-SAVED and `v`'s copy group does not need one (nothing in it survives a
//    call), it has taken one of only FIVE registers that are the sole home for values which cross a
//    call. A value that can live NOWHERE else then finds none, and the colorer dies with every
//    register blocked. Gate this by the copy group's preferred volatility.
//
// The failure is not a pressure problem and the splitter cannot see it: at the failing point the
// values FIT (five confined values, five callee-saved registers). It is a COLORING ORDER problem —
// the place the chordal-exactness argument does not reach. χ = ω is a theorem for the UNCONSTRAINED
// problem; forbidden sets make this LIST colouring, where greedy is exact only if the scarce
// callee-saved half is protected. Two sequential loops containing calls were enough to hit it
// (`while-loops.sequential-loops-across-a-call`).
function chooseRegister(v ValueId, classPool RegMask, blocked RegMask, dyingRegs RegMask, hints ColorHints, alloc Allocation, liveness LivenessResult, stats RegAllocStats) returns RegNum
	// The volatility preference is the COPY GROUP's, not `v`'s alone — see `copyGroupBlocked`.
	let groupBlocked = copyGroupBlocked(v, blocked: blocked, hints: hints, alloc: alloc, liveness: liveness)
	let takeable = preferredVolatilityMask(groupBlocked, classPool: classPool) or dyingRegs

	if hints.hasFixed(v) 'fixed'
		let fr = hints.fixedOf(v)
		if hintIsTakeable(fr, blocked: blocked, takeable: takeable) 'fixedFree'
			stats.hintsHonoured = stats.hintsHonoured + 1
			return fr
		end 'fixedFree'
	end 'fixed'
	if hints.hasCopy(v) 'copy'
		let p = hints.copyOf(v)
		if alloc.isColored(p) 'partnerColored'
			let cr = alloc.regNumOf(p)
			if hintIsTakeable(cr, blocked: blocked, takeable: takeable) 'copyFree'
				stats.hintsHonoured = stats.hintsHonoured + 1
				return cr
			end 'copyFree'
		end 'partnerColored'
	end 'copy'

	// The partner is not colored yet, but it is PINNED — take its register now (see
	// `pinnedPartnerRegister`).
	let pinned = pinnedPartnerRegister(v, hints: hints, alloc: alloc, liveness: liveness)
	if pinned != NoFixedHint and hintIsTakeable(pinned, blocked: blocked, takeable: takeable) 'pinnedFree'
		stats.hintsHonoured = stats.hintsHonoured + 1
		return pinned
	end 'pinnedFree'

	if hints.hasFixed(v) or hints.hasCopy(v) 'missed'
		stats.hintsMissed = stats.hintsMissed + 1
	end 'missed'

	// Prefer the copy group's volatility. If nothing in it is free, `v` cannot coalesce with its
	// partner however it is colored, so fall back to `v`'s OWN constraint and let SSA destruction
	// emit the copy — which is strictly what would have happened without the group at all.
	let grouped = pickPreferredRegister(groupBlocked, classPool: classPool)
	if grouped != RegisterFileSize 'gotGrouped'
		return grouped
	end 'gotGrouped'

	let reg = pickPreferredRegister(blocked, classPool: classPool)
	if reg == RegisterFileSize 'exhausted'
		// AN EMPTY CLASS POOL IS NOT A SPLITTER BUG, and blaming one would send the reader to the
		// wrong pass entirely. No amount of spilling can free a register from a file the pool does not
		// offer, so this is a MISSING POOL, diagnosed apart from a genuine over-pool point.
		if classPool == 0 'noPoolForThisClass'
			panic("chooseRegister: value {v} is a {liveness.classOf(v).name} value but the allocatable pool offers NO register of that file (pool mask {classPool}). This is not pressure and no split can relieve it — the {liveness.classOf(v).name} pool is simply not enabled. If this is an XMM value, `allocatablePool` is still GPR-only: enabling the XMM half requires the 16 XMM bits in BOTH `callerSavedMask` and `TargetDialect.callDirect`'s `implicitDefs` (they are asserted equal), or a float would silently survive a call in a register the callee clobbers.")
		end 'noPoolForThisClass'
		panic("chooseRegister: no free register for value {v} (blocked mask {blocked}, {liveness.classOf(v).name} pool {classPool}) — the cold-spill splitter (M5.3) is supposed to relieve EVERY over-pool point before coloring, including the REDUCED pool at a FIXED-REGISTER point (a value live across a call is confined to the {regMaskPopcount(calleeSavedMask())} callee-saved registers; an idiv reserves RAX/RDX for its own operands). Reaching this means the splitter left a point unrelieved — a SPLITTER BUG (its `analyzePressure` reduced-pool check, `pool ∖ op.implicitDefs`, missed this op), not a colorer limitation.")
	end 'exhausted'
	return reg
end 'chooseRegister'

// The register `v`'s copy partner is PINNED to and will therefore take if it is free: the partner's
// OWN fixed hint, when the partner is not yet colored and is not forbidden that register.
// `NoFixedHint` when there is no such register — the same "no hint" sentinel `ColorHints.fixedOf`
// returns.
//
// This is the other half of `copyGroupBlocked`, and it exists for the same reason: the forward sweep
// colors the DEF before the phi, so a pin on the PHI can only reach the value that feeds it by being
// read AHEAD of time. `return sum` after a loop pins `sum`'s phi to R8 (the `mov r8, sum` return
// move); the initial `sum = 0` in the entry block is colored first, cannot see that pin, lands
// somewhere else, and the loop-entry edge copy survives — one value, two registers, for the second
// time. Predicting the pin removes it.
//
// It is safe even when the prediction is WRONG (the partner's pin turns out to be occupied at its
// own def, so the two do not coalesce after all): `v` still only ever takes a register that
// `hintIsTakeable` has cleared for `v` itself, so the worst case is the copy we already had.
function pinnedPartnerRegister(v ValueId, hints ColorHints, alloc Allocation, liveness LivenessResult) returns RegNum
	if not hints.hasCopy(v) 'noPartner'
		return NoFixedHint
	end 'noPartner'

	let p = hints.copyOf(v)
	if alloc.isColored(p) 'partnerColored'
		return NoFixedHint
	end 'partnerColored'
	if not hints.hasFixed(p) 'partnerNotPinned'
		return NoFixedHint
	end 'partnerNotPinned'

	let pr = hints.fixedOf(p)
	if regMaskContains(liveness.forbiddenOf(p), regNum: pr) 'partnerCannotTakeIt'
		return NoFixedHint
	end 'partnerCannotTakeIt'
	return pr
end 'pinnedPartnerRegister'

// `blocked`, WIDENED by the forbidden set of the copy partner `v` has not been colored with yet —
// so `v` picks a register its partner can also take, and the two coalesce.
//
// **A copy-related pair must be colored out of the registers BOTH ends can hold, or it costs two
// registers instead of one — and a wasted register is a false E5001 waiting to happen.** The hint
// path above can only fire when the partner is ALREADY colored, and a forward sweep in dominance
// order colors the DEFINITION first: a loop-carried accumulator's initial value is defined in the
// entry block, its loop-header phi later. So at the moment that matters there is no register to
// copy, only a constraint — and the constraint is the whole story:
//
//   var sum = 0                 // not live across any call -> prefers CALLER-saved -> rax
//   while i < n 'L'
//       sum = sum + f(i)        // the phi IS live across the call -> forbidden every caller-saved
//   end 'L'                     //   register -> must take a CALLEE-saved one -> r12
//
// The hint then misses (rax is forbidden for the phi), SSA destruction materializes `mov r12, rax`
// on the loop-entry edge, and the ONE value `sum` holds TWO registers. Widening the const's blocked
// mask by the phi's forbidden set makes it pick r12 directly, the edge copy self-elides, and the
// pair costs one register. Nothing else changes: a partner with no forbidden registers (the common
// case) widens nothing, and an ALREADY-colored partner is left to the hint path — which is what
// keeps M5.12's scarce-class protection exactly as it was.
//
// It cannot over-constrain: the widened mask is only a PREFERENCE (`chooseRegister` falls back to
// `blocked` when the group's preferred volatility is full), never a legality claim.
function copyGroupBlocked(v ValueId, blocked RegMask, hints ColorHints, alloc Allocation, liveness LivenessResult) returns RegMask
	if not hints.hasCopy(v) 'noPartner'
		return blocked
	end 'noPartner'

	let p = hints.copyOf(v)
	if alloc.isColored(p) 'partnerColored'
		return blocked
	end 'partnerColored'

	return blocked or liveness.forbiddenOf(p)
end 'copyGroupBlocked'

// The registers a value with this `blocked` mask should take from, BY VOLATILITY: the CALLER-saved
// (volatile) part of its own class pool when any of it is free (nothing in the value's copy group
// survives a call, so none of it needs a callee-saved register), otherwise the whole class pool (the
// group is confined, and the callee-saved half is its only home).
//
// This is `pickPreferredRegister`'s choice, named — so a HINT can be held to the same preference. The
// two must agree, or the hint path quietly bypasses the very protection the fallback path provides.
//
// ⚠ "VOLATILITY", NOT "CLASS", AND THE RENAME IS THE POINT. This pair used to say "class" for the
// caller/callee-saved split, which now collides head-on with a register's CLASS — the file it lives
// in — and the collision is not cosmetic: both functions spelled "the whole pool" as
// `fullRegisterMask()`, which was harmless while the file was 16 wide and the pool was every GPR, and
// becomes "hand an int an XMM" the moment the file spans two classes. `classPool` is now the pool
// argument and `fullRegisterMask()` appears here only as the complement base — the one honest
// whole-machine use, complementing a mask to block everything outside it.
function preferredVolatilityMask(blocked RegMask, classPool RegMask) returns RegMask
	let volatilePart = classPool and callerSavedMask()
	let anyVolatileFree = lowestClearRegister(blocked or (fullRegisterMask() and not volatilePart)) != RegisterFileSize
	return volatilePart if anyVolatileFree else classPool
end 'preferredVolatilityMask'

// A hinted register is takeable iff it is free AND either inside the value's preferred volatility or
// being VACATED at this op — those are different acts, and only allocating outside the preference is
// harmful (see `chooseRegister`).
//
// It needs no class filter of its own: `blocked` already excludes every register outside the value's
// class pool (`allocateDef`), so a hint naming a foreign-file register is refused as "not free". The
// `takeable` mask may name foreign registers via `dyingRegs` — a value of the other class dying at
// this very op — and `blocked` is what stops one being taken.
function hintIsTakeable(reg RegNum, blocked RegMask, takeable RegMask) returns bool
	if regMaskContains(blocked, regNum: reg) 'notFree'
		return false
	end 'notFree'
	return regMaskContains(takeable, regNum: reg)
end 'hintIsTakeable'

// Pick a free register of the value's OWN class, preferring a CALLER-saved (volatile) one — it needs
// no prologue push/pop, so a value that does NOT outlive a call stays cheap. A value live ACROSS a
// call is forbidden every caller-saved register (it is in `blocked`), so none is free here and the
// pick falls through to the whole class pool — landing it in the callee-saved half, which the
// prologue then preserves. This is the standard "allocate volatiles first" bias; it keeps leaf and
// call-free functions off the callee-saved registers entirely.
//
// The final fallback scans `blocked` alone and is class-safe BECAUSE of it: `allocateDef` put
// `fullRegisterMask() and not classPool` into that mask, so every foreign-file register is already
// blocked and `lowestClearRegister` — which scans all 32 — cannot reach one.
//
// It ASKS `preferredVolatilityMask` rather than re-deriving the same preference, so the hint path and
// this one cannot disagree about what a value should take. They used to spell the volatile probe
// twice, which is what made "the two must agree" a comment instead of a property — and a second
// spelling of a pool is exactly how `fullRegisterMask()` came to stand in for "the whole pool" in one
// of them and not the other.
function pickPreferredRegister(blocked RegMask, classPool RegMask) returns RegNum
	let preferred = preferredVolatilityMask(blocked, classPool: classPool)
	let pick = lowestClearRegister(blocked or (fullRegisterMask() and not preferred))
	if pick != RegisterFileSize 'gotPreferred'
		return pick
	end 'gotPreferred'
	return lowestClearRegister(blocked)
end 'pickPreferredRegister'

// Color one op: assert its uses are already colored (dominance), free the operands
// that die here (so a def may reuse a dying use's register), allocate the def (a reuse
// def goes through `allocateReuseDef`, which may record a copy), then return the
// block's in-use mask for the point AFTER the op.
function colorOpForward(module TargetModule, opIdx OpIndex, pos BlockOpPos, seq OpSeq, inUse RegMask, deaths BlockDeaths, hints ColorHints, alloc Allocation, liveness LivenessResult, pool RegMask, stats RegAllocStats, buf OperandList, reuseCopies ReuseCopyPlan) returns RegMask
	let op = try module.ops.get(opIdx) otherwise panic("colorOpForward: opIdx not in module.ops")
	targetOpOperands(op, buf: buf)

	for o in buf 'assertUses'
		if (not operandIsDef(o)) and operandIsVirtual(o) 'vu'
			if not alloc.isColored(operandValueId(o)) 'notColored'
				panic("colorOpForward: use of value {operandValueId(o)} before it was colored — dominance-order violation (a future block-reordering pass would need to preserve dominance layout)")
			end 'notColored'
		end 'vu'
	end 'assertUses'

	let dyingRegs = deaths.dyingRegsAt(pos, alloc: alloc)

	var working = inUse
	for o in buf 'allocDefs'
		if operandIsDef(o) and operandIsVirtual(o) 'vd'
			if operandIsReuseDef(o) 'reuse'
				working = allocateReuseDef(o, seq: seq, pos: pos, deaths: deaths, buf: buf, working: working, hints: hints, alloc: alloc, liveness: liveness, pool: pool, stats: stats, reuseCopies: reuseCopies)
			end 'reuse' else 'plain'
				working = allocateDef(operandValueId(o), working: working, dyingRegs: dyingRegs, hints: hints, alloc: alloc, liveness: liveness, pool: pool, stats: stats)
			end 'plain'
		end 'vd'
	end 'allocDefs'

	// in-use after the op: drop the dying operands, keep the LIVE defs (a def that
	// is dead the instant it is written frees its register too, via `dyingRegs`).
	var liveDefRegs = 0 as RegMask
	for o in buf 'liveDefs'
		if operandIsDef(o) and operandIsVirtual(o) 'vd2'
			let v = operandValueId(o)
			if not deaths.dies(pos, v: v) 'stillLive'
				liveDefRegs = regMaskAdd(liveDefRegs, regNum: alloc.regNumOf(v))
			end 'stillLive'
		end 'vd2'
	end 'liveDefs'

	return (inUse and not dyingRegs) or liveDefRegs
end 'colorOpForward'

// Allocate a REUSE def and, when it could not coalesce into its input's register,
// record the `mov dest, input` the encoder needs. The subtlety the whole rework rests
// on: the copy runs BEFORE the op, at a point where nothing has died yet, so `dest`
// must be a register that is free THERE. So the dest may reuse ONLY the input's dying
// register (never another dying operand's — a copy into it would clobber a value the op
// still reads); when the input OUTLIVES, no operand register is free before the op, so
// the dest may reuse none. `defDyingRegs` encodes exactly that.
function allocateReuseDef(o Operand, seq OpSeq, pos BlockOpPos, deaths BlockDeaths, buf OperandList, working RegMask, hints ColorHints, alloc Allocation, liveness LivenessResult, pool RegMask, stats RegAllocStats, reuseCopies ReuseCopyPlan) returns RegMask
	let destId = operandValueId(o)
	let inputId = operandReuseInputValueId(o, buf: buf)
	let inputReg = alloc.regNumOf(inputId)
	let inputDies = deaths.dies(pos, v: inputId)

	// The reuse copy (if the coalescing hint misses) runs BEFORE the op, so the dest
	// must be free at that point: it may reuse ONLY the input's dying register (never
	// another dying operand's, which the op still reads after the copy), and none at all
	// when the input outlives.
	var defDyingRegs = 0 as RegMask
	if inputDies 'inputDiesHere'
		defDyingRegs = regMaskAdd(defDyingRegs, regNum: inputReg)
	end 'inputDiesHere'

	let updated = allocateDef(destId, working: working, dyingRegs: defDyingRegs, hints: hints, alloc: alloc, liveness: liveness, pool: pool, stats: stats)

	let destReg = alloc.regNumOf(destId)
	if destReg != inputReg 'needsCopy'
		reuseCopies.record(seq, destReg: destReg, srcReg: inputReg)
		stats.copiesInserted = stats.copiesInserted + 1
	end 'needsCopy'

	return updated
end 'allocateReuseDef'

// Which values DIE at each op of a block — i.e. whose live range ENDS there (its last use, or a
// dead def) — as a CSR list keyed by the op's position: `list[start[pos] .. start[pos+1])`.
//
// **Not a bitset.** The obvious shape is an `ops × ceil(values/64)` matrix, one row of the whole
// value space per op — and that is what this was, allocated fresh for EVERY block, costing
// O(ops × values/64) memory and time per function. It was never needed: a value can only die where
// it APPEARS, so every query is about one of the op's own operands, of which there are at most a
// handful. The list is O(operands) per op and answers the same questions.
type BlockDeaths
	export var byPos as CsrGraph

	static function create(byPos CsrGraph) returns BlockDeaths
		return Self{byPos: byPos}
	end 'create'

	// True iff `v` dies at op position `pos`. A linear scan of the op's dying values — at most the
	// op's operand count, so this is O(1) in practice.
	export function dies(pos BlockOpPos, v ValueId) returns bool
		for k in 0 upto self.byPos.degree(pos) 'each'
			if self.byPos.neighbour(pos, k: k) == v 'match'
				return true
			end 'match'
		end 'each'
		return false
	end 'dies'

	// The register mask of every COLORED value dying at op `pos` — the registers a def at this op
	// may reuse. (An uncolored dead def is handled by the caller's live-def computation, not here.)
	export function dyingRegsAt(pos BlockOpPos, alloc Allocation) returns RegMask
		var mask = 0 as RegMask
		for k in 0 upto self.byPos.degree(pos) 'each'
			let v = self.byPos.neighbour(pos, k: k)
			if alloc.isColored(v) 'colored'
				mask = regMaskAdd(mask, regNum: alloc.regNumOf(v))
			end 'colored'
		end 'each'
		return mask
	end 'dyingRegsAt'
end 'BlockDeaths'

// A backward scan from the block's live-out: a value dies at an op iff it is an operand there and
// is not live below it. `seenBelow` is a single dense row (bits flip at every op, so a bitset is the
// right shape INSIDE a block) — seeded from the SPARSE live-out list and cleared back to zero in
// O(live) by the caller, never copied a full value-space row at a time.
function computeBlockDeaths(module TargetModule, ordered OpIndexArray, liveness LivenessResult, local CfgIndex, block IrBlock, buf OperandList, seenBelow BitWordArray, seedBuf ValueIdArray, liveByClass RegCountColumn) returns BlockDeaths
	let n = ordered.count()

	liveness.liveOutInto(local, out: seedBuf)
	for v in seedBuf 'seed'
		bitsetAdd(seenBelow, base: 0, bit: v)
	end 'seed'
	// ⚠ `liveByClass` HERE TALLIES THE ROW, AND THIS ROW IS NOT A LIVE SET. `seenBelow` means "seen
	// below this op", and the death scan ADDS to it itself (below) for values that die — so its
	// population is not the live population and its tally is not a pressure. Nothing reads it: the
	// scan wants the row alone.
	//
	// It is maintained anyway, exactly, because `stepRowBackwardOverOperands` maintains a tally OF THE
	// ROW as it flips bits, and that tally's decrements PANIC on underflow. That guard is not
	// negotiable — it is what makes the per-class figures elsewhere trustworthy — so the contract is
	// simply that every mutator of a row keeps its tally in step, including this one. Seeding it
	// truthfully and bumping it on the scan's own adds costs one class read per death and keeps the
	// invariant exact; the alternative is a second step function that skips the tally, which is the
	// forked sweep this design exists to avoid.
	seedClassLive(liveByClass, classes: liveness.valueClass, values: seedBuf)

	// Collected backward as (pos, value) pairs, then bucketed by position — the scan discovers them
	// in reverse, and a counting sort restores order in O(pairs + ops). `posOf` is the CSR KEY column
	// (its entries are `BlockOpPos`), `valueOf` the value column.
	var posOf = CsrColumn.create()
	var valueOf = ValueIdArray.create()

	for ri in 0 upto n 'eachOpRev'
		let pos = n - 1 - ri
		let opIdx = try ordered.get(pos) otherwise panic("computeBlockDeaths: ordered.get OOB")
		let op = try module.ops.get(opIdx) otherwise panic("computeBlockDeaths: opIdx not in module.ops")
		targetOpOperands(op, buf: buf)

		for o in buf 'markDeaths'
			if operandIsVirtual(o) 'virt'
				let v = operandValueId(o)
				if not bitsetTest(seenBelow, base: 0, bit: v) 'dies'
					posOf.push(pos)
					valueOf.push(v)
					// Mark it seen, so the SAME value appearing twice in this op (`sub x, x`) is
					// recorded as dying ONCE. The row's tally follows the row — see the note above.
					bitsetAdd(seenBelow, base: 0, bit: v)
					stepClassLive(liveByClass, classes: liveness.valueClass, v: v, entering: true)
				end 'dies'
			end 'virt'
		end 'markDeaths'

		// Transform `seenBelow` from live-below-this-op to live-below-the-op-above it —
		// the same backward SSA transfer the liveness pressure sweep uses.
		stepRowBackwardOverOperands(seenBelow, base: 0, buf: buf, liveByClass: liveByClass, classes: liveness.valueClass)
	end 'eachOpRev'

	// Return the row to zero for the next block, in O(live + phis): what it holds now is this
	// block's live-in set plus any of its own block-args an op re-added.
	liveness.liveInInto(local, out: seedBuf)
	for v in seedBuf 'clearLiveIn'
		bitsetRemove(seenBelow, base: 0, bit: v)
	end 'clearLiveIn'
	for arg in block.blockArgs 'clearPhis'
		bitsetRemove(seenBelow, base: 0, bit: arg.valueId)
	end 'clearPhis'

	// The scan discovered the deaths in REVERSE op order; the counting sort in `buildCsr`
	// restores forward order in O(pairs + ops), keyed by the op's position in the block.
	return BlockDeaths.create(buildCsr(posOf, to: valueOf, nodeCount: n))
end 'computeBlockDeaths'

// ==========================================================================
// Applying a coloring to an op (used by the rewrite in SsaDestruction.maxon)
// ==========================================================================

// Resolve one operand: a physical register passes through (the R8 return target); a
// virtual register becomes its assigned physical register.
export function colorVRegWith(vreg X64VReg, alloc Allocation) returns X64VReg
	return match vreg 'v'
		physical gives vreg
		virtual(id) gives X64VReg.physical(alloc.colorOf(id))
	end 'v'
end 'colorVRegWith'

// Rebuild an op with its X64VReg operands colored to physical registers. EXHAUSTIVE
// over every TargetOp — control/frame/call ops with no register operands pass
// through. `xchgRegReg` is spliced in AFTER this rewrite, so its operands are already
// physical (pass through).
export function colorTargetOp(op TargetOp, alloc Allocation) returns TargetOp
	match op 'rewrite'
		prologue to jcc then return op
		movRegImm(dest, value) then return TargetOp.movRegImm(colorVRegWith(dest, alloc: alloc), value: value)
		movRegImm32(dest, value) then return TargetOp.movRegImm32(colorVRegWith(dest, alloc: alloc), value: value)
		movRegReg(destReg, srcReg) then return TargetOp.movRegReg(colorVRegWith(destReg, alloc: alloc), srcReg: colorVRegWith(srcReg, alloc: alloc))
		movReg32Reg32(destReg, srcReg) then return TargetOp.movReg32Reg32(colorVRegWith(destReg, alloc: alloc), srcReg: colorVRegWith(srcReg, alloc: alloc))
		subRegReg(dest, lhs, rhs) then return TargetOp.subRegReg(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		imulRegReg(dest, lhs, rhs) then return TargetOp.imulRegReg(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		negReg(dest, src) then return TargetOp.negReg(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc))
		cmpRegReg(lhsReg, rhsReg) then return TargetOp.cmpRegReg(colorVRegWith(lhsReg, alloc: alloc), rhsReg: colorVRegWith(rhsReg, alloc: alloc))
		leaRegRegReg(dest, base, index) then return TargetOp.leaRegRegReg(colorVRegWith(dest, alloc: alloc), base: colorVRegWith(base, alloc: alloc), index: colorVRegWith(index, alloc: alloc))
		leaRegRegImm32(dest, base, disp) then return TargetOp.leaRegRegImm32(colorVRegWith(dest, alloc: alloc), base: colorVRegWith(base, alloc: alloc), disp: disp)
		imulRegRegImm32(dest, src, imm) then return TargetOp.imulRegRegImm32(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc), imm: imm)
		cmpRegImm32(reg, imm) then return TargetOp.cmpRegImm32(colorVRegWith(reg, alloc: alloc), imm: imm)
		xchgRegReg to iatCall then return op
		cqo then return op
		idivReg(divisor) then return TargetOp.idivReg(colorVRegWith(divisor, alloc: alloc))
		pushReg to popReg then return op
		storeSlotReg(slot, srcReg) then return TargetOp.storeSlotReg(slot, srcReg: colorVRegWith(srcReg, alloc: alloc))
		loadRegSlot(destReg, slot) then return TargetOp.loadRegSlot(colorVRegWith(destReg, alloc: alloc), slot: slot)
		andRegReg(dest, lhs, rhs) then return TargetOp.andRegReg(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		orRegReg(dest, lhs, rhs) then return TargetOp.orRegReg(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		xorRegReg(dest, lhs, rhs) then return TargetOp.xorRegReg(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		notReg(dest, src) then return TargetOp.notReg(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc))
		andRegImm32(dest, lhs, imm) then return TargetOp.andRegImm32(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), imm: imm)
		orRegImm32(dest, lhs, imm) then return TargetOp.orRegImm32(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), imm: imm)
		xorRegImm32(dest, lhs, imm) then return TargetOp.xorRegImm32(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), imm: imm)
		shlRegImm8(dest, lhs, imm) then return TargetOp.shlRegImm8(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), imm: imm)
		sarRegImm8(dest, lhs, imm) then return TargetOp.sarRegImm8(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), imm: imm)
		shrRegImm8(dest, lhs, imm) then return TargetOp.shrRegImm8(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), imm: imm)
		shlRegCl(dest, lhs) then return TargetOp.shlRegCl(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc))
		sarRegCl(dest, lhs) then return TargetOp.sarRegCl(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc))
		shrRegCl(dest, lhs) then return TargetOp.shrRegCl(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc))
		setccReg(dest, cond) then return TargetOp.setccReg(colorVRegWith(dest, alloc: alloc), cond: cond)
		// The data-section band. `label`, `disp` and `width` are not registers and pass through; the
		// vregs are colored exactly as every other op's are.
		leaRegGlobal(dest, label) then return TargetOp.leaRegGlobal(colorVRegWith(dest, alloc: alloc), label: label)
		loadRegBaseDisp(dest, base, disp, width) then return TargetOp.loadRegBaseDisp(colorVRegWith(dest, alloc: alloc), base: colorVRegWith(base, alloc: alloc), disp: disp, width: width)
		storeBaseDispReg(base, disp, src, width) then return TargetOp.storeBaseDispReg(colorVRegWith(base, alloc: alloc), disp: disp, src: colorVRegWith(src, alloc: alloc), width: width)
		// The SSE band. Coloring is CLASS-BLIND by construction: `colorVRegWith` substitutes
		// whatever register the allocator assigned, and the class column is what guaranteed that
		// register is an XMM. So these arms are shape-for-shape identical to their GPR twins, and
		// that identity is the one-enum design paying out.
		addsdRegReg(dest, lhs, rhs) then return TargetOp.addsdRegReg(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		subsdRegReg(dest, lhs, rhs) then return TargetOp.subsdRegReg(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		mulsdRegReg(dest, lhs, rhs) then return TargetOp.mulsdRegReg(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		divsdRegReg(dest, lhs, rhs) then return TargetOp.divsdRegReg(colorVRegWith(dest, alloc: alloc), lhs: colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		ucomisdRegReg(lhs, rhs) then return TargetOp.ucomisdRegReg(colorVRegWith(lhs, alloc: alloc), rhs: colorVRegWith(rhs, alloc: alloc))
		movsdRegRip(dest, label) then return TargetOp.movsdRegRip(colorVRegWith(dest, alloc: alloc), label: label)
		cvtsi2sdRegReg(dest, src) then return TargetOp.cvtsi2sdRegReg(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc))
		cvttsd2siRegReg(dest, src) then return TargetOp.cvttsd2siRegReg(colorVRegWith(dest, alloc: alloc), src: colorVRegWith(src, alloc: alloc))
	end 'rewrite'
end 'colorTargetOp'

// ==========================================================================
// Stats logging
// ==========================================================================

function regAllocStatsMessage(stats RegAllocStats) returns String
	var msg = StringBuilder.create()
	msg.append("regalloc stats: {stats.functionsAllocated} func(s), {stats.valuesColored} values colored, {regMaskPopcount(stats.registersUsed)} distinct regs used\n")
	// Iterated per class, not hand-listed: a hand-written pair of lines silently omits any register
	// file added later, which is the same way an unmeasured cost hides in the phase table below.
	msg.append("  pressure:")
	for classOrdinal in 0 upto RegClassCount 'eachClass'
		let class = regClassAt(classOrdinal)
		msg.append(" max {class.name}={classRowGet(stats.maxPressure, class: class)} (in '{try stats.maxPressureFunc.get(class.ordinal) otherwise panic("regAllocStatsMessage: no maxPressureFunc entry for the {class.name} file")}');")
	end 'eachClass'
	msg.append(" maxLoopDepth={stats.maxLoopDepth}; liveness mark-steps total={stats.livenessMarkStepsTotal} max={stats.livenessMarkStepsMax}\n")
	msg.append("  splitter: valuesSplit={stats.valuesSplit} (forced at fixed-reg points={stats.forcedSpills}); reloadsInserted={stats.reloadsInserted}; rematerialized={stats.rematerialized}\n")
	msg.append("  copies inserted={stats.copiesInserted}; hints honoured={stats.hintsHonoured} missed={stats.hintsMissed}\n")
	// Iterated, not hand-listed: a hand-written line silently omits any phase added
	// later, which is how an unmeasured cost hides in the first place.
	msg.append("  phase ms:")
	for phase in RegAllocPhase.allCases 'eachPhase'
		msg.append(" {phase.name}={stats.phaseNanosOf(phase)}")
	end 'eachPhase'
	return msg.build()
end 'regAllocStatsMessage'
