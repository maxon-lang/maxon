// SsaDestruction — the register allocator's back half: turn the phi model
// (`blockArgs` / `branchEdges`) into machine code AFTER coloring, and commit the
// coloring in place. Two products:
//   1. buildSsaDestructionPlan — per phi-carrying edge, the ordered PHYSICAL moves
//      (`mov` / `xchg`) that deliver each predecessor's value to the phi's register,
//      classified by where they may safely go (pred end / succ start / a split block
//      on a critical edge). Copy CYCLES are broken with `xchgRegReg` — no scratch.
//   2. applyAllocation — rewrite every op to physical registers at its SAME
//      `module.ops` index (the in-place-coloring invariant), drop the `mov r, r`
//      self-moves biased coloring produced, splice the edge moves, and clear the
//      phi model (the backend, which has no phi, must not see a block-arg).
//
// A mis-ordered parallel copy is caught by the suite: the moved value reaches the wrong
// register, the phi's consumer computes the wrong answer, and the test's exit-code assertion
// fails — and, before that, the `.test` golden of every affected function stops matching.

// Which MOVE of a sequenced parallel copy — an index into an `EdgeMovePlan`'s / `MoveSequence`'s
// three parallel columns, or a count of them. Not an op position and not a phi position: the copy is
// RESEQUENCED (leaves first, cycles broken with `xchg`), so a move's index says nothing about which
// phi it serves.
// ⚠ NOT exported: the move columns are built and drained inside this file, and shv2's own
// `checkUnusedExports` (E3092) is what says so — the SELF-COMPILE runs that pass and the bootstrap does not.
typealias MoveIndex = int(0 to u64.max)

// Where an edge's parallel copy may be placed without running on a sibling edge.
enum EdgePlacement
	// Pred has ONE successor: the moves run at the predecessor's end.
	predEnd
	// Succ has ONE predecessor: the moves run at the successor's start.
	succStart
	// A CRITICAL edge (pred has >1 successor AND succ has >1 predecessor): a fresh
	// block on the edge holds the moves, so they run on exactly this edge.
	split
end 'EdgePlacement'

// One edge's parallel copy, sequenced into ordered physical moves. `moveDsts[i]` ←
// `moveSrcs[i]` is a `mov` unless `moveIsSwap[i]` (a SWAP breaking a cycle). All values are
// physical register NUMBERS (0..31 — GPRs at 0-15, XMMs at 16-31; the width moved with
// `RegisterFileSize` at P1.0d.4).
//
// ⭐ THIS PLAN IS CLASS-AGNOSTIC AND STAYS THAT WAY. A move is a move and a swap is a swap
// whichever file the register names; which INSTRUCTION each becomes is decided far below, by the
// encoder, from `regClassOf` of the register (`emitRegRegMove` / `emitRegRegSwap` in X64Backend).
// That is why floats needed no case here: a `mov` becomes a `movsd`, and a `swap` — which x64
// has no `xchg` form of for XMMs — becomes a triple-`xorpd`, without this file knowing either.
type EdgeMovePlan
	export var predLocal as CfgIndex
	export var succLocal as CfgIndex
	export var predBlockId as BlockId
	export var succBlockId as BlockId
	// Flat `module.blocks` indices — the splice mutates `module` while holding the
	// block, which requires a FIELD-level borrow (`module.blocks.get`), not the
	// whole-module borrow `getBlockByIdIn` takes.
	export var predBlockRef as BlockRef
	export var succBlockRef as BlockRef
	export var moveDsts as RegNumColumn
	export var moveSrcs as RegNumColumn
	export var moveIsSwap as BoolArray
	export var placement as EdgePlacement

	export static function create(predLocal CfgIndex, succLocal CfgIndex, predBlockId BlockId, succBlockId BlockId, predBlockRef BlockRef, succBlockRef BlockRef, moves MoveSequence, placement EdgePlacement) returns EdgeMovePlan
		return Self{predLocal: predLocal, succLocal: succLocal, predBlockId: predBlockId, succBlockId: succBlockId, predBlockRef: predBlockRef, succBlockRef: succBlockRef, moveDsts: moves.dsts, moveSrcs: moves.srcs, moveIsSwap: moves.isSwap, placement: placement}
	end 'create'

	export function moveCount() returns MoveIndex
		return self.moveDsts.count()
	end 'moveCount'

	export function moveDstAt(i MoveIndex) returns RegNum
		return try self.moveDsts.get(i) otherwise panic("EdgeMovePlan.moveDstAt: OOB")
	end 'moveDstAt'

	export function moveSrcAt(i MoveIndex) returns RegNum
		return try self.moveSrcs.get(i) otherwise panic("EdgeMovePlan.moveSrcAt: OOB")
	end 'moveSrcAt'

	export function moveIsSwapAt(i MoveIndex) returns bool
		return try self.moveIsSwap.get(i) otherwise panic("EdgeMovePlan.moveIsSwapAt: OOB")
	end 'moveIsSwapAt'
end 'EdgeMovePlan'

export typealias EdgeMovePlanArray = Array with EdgeMovePlan

// A sequenced parallel copy: `dsts[i]` ← `srcs[i]`, a swap when `isSwap[i]`.
type MoveSequence
	export var dsts as RegNumColumn
	export var srcs as RegNumColumn
	export var isSwap as BoolArray

	export static function create() returns MoveSequence
		return Self{dsts: RegNumColumn.create(), srcs: RegNumColumn.create(), isSwap: BoolArray.create()}
	end 'create'

	export function pushMove(dst RegNum, src RegNum, swap bool)
		self.dsts.push(dst)
		self.srcs.push(src)
		self.isSwap.push(swap)
	end 'pushMove'

	export function count() returns MoveIndex
		return self.dsts.count()
	end 'count'
end 'MoveSequence'

// Build the per-edge SSA-destruction plan for a function. A fully-coalesced edge
// (every phi shares its incoming value's register) produces no moves and no plan.
export function buildSsaDestructionPlan(module TargetModule, alloc Allocation, liveness LivenessResult, stats RegAllocStats) returns EdgeMovePlanArray
	let topo = liveness.cfg.topo
	var plans = EdgeMovePlanArray.create()

	for predLocal in 0 upto topo.numBlocks 'eachPred'
		let predBlock = blockAt(module, topo: topo, local: predLocal)
		for edge in predBlock.branchEdges 'eachEdge'
			let plan = buildEdgePlan(module, topo: topo, predBlock: predBlock, predLocal: predLocal, edge: edge, alloc: alloc)
			if plan.moveCount() > 0 'hasMoves'
				stats.copiesInserted = stats.copiesInserted + plan.moveCount()
				plans.push(plan)
			end 'hasMoves'
		end 'eachEdge'
	end 'eachPred'

	return plans
end 'buildSsaDestructionPlan'

function buildEdgePlan(module TargetModule, topo FuncTopology, predBlock IrBlock, predLocal CfgIndex, edge BranchEdge, alloc Allocation) returns EdgeMovePlan
	let succLocal = localOfBlockId(topo, blockId: edge.targetBlockId)
	let targetBlock = blockAt(module, topo: topo, local: succLocal)
	let view = PhiEdgeView.resolve(targetBlock, argIds: edge.argIds, context: PhiEdgeConsumer.ssaDestruction)

	var dsts = RegNumColumn.create()
	var srcs = RegNumColumn.create()
	for k in 0 upto view.count 'eachPhi'
		let dstReg = alloc.regNumOf(view.phiValueIdAt(k))
		let srcReg = alloc.regNumOf(view.incomingAt(k))
		if dstReg != srcReg 'needsMove'
			dsts.push(dstReg)
			srcs.push(srcReg)
		end 'needsMove'
	end 'eachPhi'

	let moves = sequenceParallelCopy(dsts, srcs: srcs)
	let placement = classifyPlacement(topo, predLocal: predLocal, succLocal: succLocal)
	let predBlockRef = try topo.blockRefByLocal.get(predLocal) otherwise panic("buildEdgePlan: predLocal out of range")
	let succBlockRef = try topo.blockRefByLocal.get(succLocal) otherwise panic("buildEdgePlan: succLocal out of range")
	return EdgeMovePlan.create(predLocal, succLocal: succLocal, predBlockId: predBlock.id, succBlockId: edge.targetBlockId, predBlockRef: predBlockRef, succBlockRef: succBlockRef, moves: moves, placement: placement)
end 'buildEdgePlan'

// Where the edge's moves may go: at the predecessor's end when it has one
// successor; at the successor's start when it has one predecessor; otherwise the
// edge is CRITICAL and gets its own split block.
function classifyPlacement(topo FuncTopology, predLocal CfgIndex, succLocal CfgIndex) returns EdgePlacement
	if topo.succ.degree(predLocal) == 1 'predSingleSucc'
		return EdgePlacement.predEnd
	end 'predSingleSucc'
	if topo.pred.degree(succLocal) == 1 'succSinglePred'
		return EdgePlacement.succStart
	end 'succSinglePred'
	return EdgePlacement.split
end 'classifyPlacement'

// Sequence a parallel copy (`dsts[i]` ← `srcs[i]`, dsts distinct) into ordered
// moves. Repeatedly emit a move whose dst is no other move's source (a leaf); when
// only cycles remain, break one with an `xchg` and rewrite the remaining sources
// through the swap. This is the standard parallel-move algorithm.
//
// CONSUMES ITS ARGUMENTS: `dsts`/`srcs` ARE the worklists — each move is removed as
// it is emitted, so both are EMPTY on return. `buildEdgePlan`, the sole caller,
// builds them for this call alone and never reads them again, so they are handed
// over rather than copied. A second caller must likewise pass arrays it owns and is
// finished with.
function sequenceParallelCopy(dsts RegNumColumn, srcs RegNumColumn) returns MoveSequence
	var moves = MoveSequence.create()

	while dsts.count() > 0 'sequence'
		// Drop moves already satisfied (dst == src) — the initial ones the caller may
		// leave, and the one a preceding `xchg` just fulfilled (its source, rewritten
		// through the swap, now equals its dst). Emitting `xchg r, r` would be a no-op.
		removeSatisfiedMoves(dsts, ps: srcs)
		if dsts.count() == 0 'allDone'
			break
		end 'allDone'

		let leaf = findLeafMove(dsts, ps: srcs)
		if leaf < dsts.count() 'foundLeaf'
			let d = try dsts.get(leaf) otherwise panic("sequenceParallelCopy: dsts.get OOB")
			let s = try srcs.get(leaf) otherwise panic("sequenceParallelCopy: srcs.get OOB")
			moves.pushMove(d, src: s, swap: false)
			removeMoveAt(dsts, ps: srcs, idx: leaf)
		end 'foundLeaf' else 'cycle'
			let a = try dsts.get(0) otherwise panic("sequenceParallelCopy: dsts.get(0) OOB")
			let b = try srcs.get(0) otherwise panic("sequenceParallelCopy: srcs.get(0) OOB")
			moves.pushMove(a, src: b, swap: true)
			removeMoveAt(dsts, ps: srcs, idx: 0)
			rewriteSourcesThroughSwap(srcs, a: a, b: b)
		end 'cycle'
	end 'sequence'

	return moves
end 'sequenceParallelCopy'

// Index of a move whose dst is NOT any pending move's source (safe to emit now), or
// `pd.count()` if every remaining dst is still needed as a source (a pure cycle).
function findLeafMove(pd RegNumColumn, ps RegNumColumn) returns MoveIndex
	for i in 0 upto pd.count() 'eachMove'
		let d = try pd.get(i) otherwise panic("findLeafMove: pd.get OOB")
		if not isAnySource(ps, reg: d) 'leaf'
			return i
		end 'leaf'
	end 'eachMove'
	return pd.count()
end 'findLeafMove'

// Remove every pending move whose dst already equals its src (an already-satisfied
// copy). Scans back-to-front so removals do not shift not-yet-visited indices.
function removeSatisfiedMoves(pd RegNumColumn, ps RegNumColumn)
	let n = pd.count()
	for ri in 0 upto n 'each'
		let i = n - 1 - ri
		let d = try pd.get(i) otherwise panic("removeSatisfiedMoves: pd.get OOB")
		let s = try ps.get(i) otherwise panic("removeSatisfiedMoves: ps.get OOB")
		if d == s 'satisfied'
			removeMoveAt(pd, ps: ps, idx: i)
		end 'satisfied'
	end 'each'
end 'removeSatisfiedMoves'

function isAnySource(ps RegNumColumn, reg RegNum) returns bool
	for s in ps 'each'
		if s == reg 'match'
			return true
		end 'match'
	end 'each'
	return false
end 'isAnySource'

function removeMoveAt(pd RegNumColumn, ps RegNumColumn, idx MoveIndex)
	_ = try pd.remove(idx) otherwise panic("removeMoveAt: pd.remove OOB")
	_ = try ps.remove(idx) otherwise panic("removeMoveAt: ps.remove OOB")
end 'removeMoveAt'

// After `xchg a, b`, registers a and b hold each other's old contents, so a pending
// move reading a now finds its value in b and vice-versa.
function rewriteSourcesThroughSwap(ps RegNumColumn, a RegNum, b RegNum)
	for i in 0 upto ps.count() 'each'
		let s = try ps.get(i) otherwise panic("rewriteSourcesThroughSwap: ps.get OOB")
		if s == a 'wasA'
			try ps.set(i, value: b) otherwise panic("rewriteSourcesThroughSwap: ps.set OOB")
		end 'wasA' else if s == b 'wasB'
			try ps.set(i, value: a) otherwise panic("rewriteSourcesThroughSwap: ps.set OOB")
		end 'wasB'
	end 'each'
end 'rewriteSourcesThroughSwap'

// ==========================================================================
// Commit: rewrite ops to physical, drop self-moves, splice edge moves, clear phis
// ==========================================================================

export function applyAllocation(module TargetModule, func IrFunction, alloc Allocation, plans EdgeMovePlanArray, reuseCopies ReuseCopyPlan)
	colorAndDropSelfMoves(module, func: func, alloc: alloc, reuseCopies: reuseCopies)

	for plan in plans 'eachPlan'
		spliceEdgeMoves(module, plan: plan)
	end 'eachPlan'

	clearPhiModel(module, func: func)
end 'applyAllocation'

// Rewrite every op in place at its `module.ops` index (opRefs / terminator indices
// stay valid), dropping any `mov r, r` self-move biased coloring produced, and
// splicing each reuse-def copy `mov dest, input` immediately BEFORE its op (the
// two-address input that outlived, so the destination is a different register).
// `seq` re-derives the op's LAYOUT SEQUENCE — blocks in `func.blockRefs` order, each block's body
// ops then its terminator. That is the `collectBlockOps` numbering the colorer recorded its reuse
// copies under, so a copy is spliced before exactly the op that could not coalesce into its input.
function colorAndDropSelfMoves(module TargetModule, func IrFunction, alloc Allocation, reuseCopies ReuseCopyPlan)
	var seq = 0 as OpSeq
	for blockRef in func.blockRefs 'eachBlock'
		var block = try module.blocks.get(blockRef) otherwise panic("colorAndDropSelfMoves: blockRef not in module.blocks")
		let bodyCount = block.opRefs.count()

		var newRefs = OpIndexArray.create()
		// ⭐ **THE TWO-RESULT CAPTURE OF A `tryCall`** — a call op followed by TWO virtual-dest /
		// physical-src moves (`result ← R8/x0`, `flag ← R10/x9`). A single-result call is followed by
		// ONE; parameter moves have the same shape but are at function entry, never after a call — so
		// the `prevWasCall` gate discriminates them. The two moves form a PARALLEL COPY: coloring them
		// onto each other's source registers (result→R10, flag→R8) makes a naive `mov;mov` collapse
		// value and flag into one register (v1's array-sort miscompile). `sequenceParallelCopy` orders
		// them safely, breaking a cycle with `xchg` (no scratch), exactly as the phi-edge copies do.
		var prevWasCall = false
		var skipNext = false
		for pos in 0 upto bodyCount 'eachOp'
			let opIdx = try block.opRefs.get(pos) otherwise panic("colorAndDropSelfMoves: opRefs.get OOB")
			if skipNext 'flagCaptureHandled'
				skipNext = false
				continue
			end 'flagCaptureHandled'

			// ⚠⚠ **THE PAIR IS SETTLED AND EMITTED BEFORE THE OP IS BOUND, AND THE ORDER IS THE WHOLE POINT.**
			// An op read out of `module.ops` is a BORROW of `module` (E3070), the sequencer PUSHES its moves
			// onto that same array, and a borrow's liveness is its last use in SOURCE order — so a single
			// `uncolored` binding serving both the pair test and the coloring below would still be live
			// across the push however the arguments were computed. Both halves therefore read the ops
			// themselves, each releasing its borrow before it writes.
			//
			// A `tryCall` capture pair is resequenced through the parallel-copy sequencer, using the
			// UNCOLORED ops (their dests are still virtual, so their ids can be looked up in `alloc`).
			if prevWasCall and pos + 1 < bodyCount and isCaptureMovePairAt(module, block: block, pos: pos) 'isPair'
				emitResequencedCaptureAt(module, block: block, pos: pos, alloc: alloc, newRefs: newRefs)
				skipNext = true
				prevWasCall = false
				continue
			end 'isPair'

			let uncolored = try module.ops.get(opIdx) otherwise panic("colorAndDropSelfMoves: opIdx not in module.ops")
			let colored = colorTargetOp(uncolored, alloc: alloc)
			try module.ops.set(opIdx, value: colored) otherwise panic("colorAndDropSelfMoves: ops.set OOB")
			prevWasCall = colored.rawValue.isCall
			if isPhysicalSelfMove(colored) 'selfMove'
				continue
			end 'selfMove'
			spliceReuseCopyBefore(module, reuseCopies: reuseCopies, seq: seq + pos, newRefs: newRefs)
			newRefs.push(opIdx)
		end 'eachOp'
		block.opRefs = newRefs
		seq = seq + bodyCount

		if block.hasTerminatorOp() 'hasTerm'
			let ti = block.terminatorIndex()
			try module.ops.set(ti, value: colorTargetOp(try module.ops.get(ti) otherwise panic("colorAndDropSelfMoves: terminator not in module.ops"), alloc: alloc)) otherwise panic("colorAndDropSelfMoves: terminator ops.set OOB")
			seq = seq + 1
		end 'hasTerm'
	end 'eachBlock'
end 'colorAndDropSelfMoves'

// True for a `movRegReg` whose DEST is still virtual and whose SRC is a physical register — the shape of
// a call-result capture (`virtual(result) ← physical(returnReg)`). Read on the UNCOLORED op, before its
// dest is rewritten to a physical register.
function isCaptureMove(op TargetOp) returns bool
	return match op 'm'
		movRegReg(dst, src) gives vregIsVirtual(dst) and vregIsPhysical(src)
		prologue to movRegImm32 gives false
		movReg32Reg32 to negF64RegReg gives false
		arm64Ret to arm64Fcsel gives false
		// `leaRegFunc`/`callReg` (P1.5-A1) and the Linux `x64Syscall` are not a `movRegReg`, so none is a
		// call-result capture move — the same `false` every non-`movRegReg` op gets here.
		leaRegFunc to x64Syscall gives false
		// The jump tables are multiway terminators, not a `movRegReg`, so neither is a capture move.
		x64JumpTable to arm64JumpTable gives false
		// The witness call is a call, not a `movRegReg`, so it is not a capture move.
		callMem gives false
		// Neither stack-argument op is a `movRegReg`, so neither is a call-result capture move.
		arm64StoreOutgoingArg to arm64LoadIncomingArg gives false
		// Neither arm64 bit reinterpretation is a `movRegReg`, so neither is a call-result capture move.
		arm64FmovGprFp to arm64FmovFpGpr gives false
		// A frame address is not a `movRegReg`, so it is not a call-result capture move.
		leaRegSlot gives false
		// F1b: a fill ladder is not a `movRegReg`, so it is not a call-result capture move.
		x64MemFill to arm64MemFill gives false
		// F2: no atomic is a `movRegReg`, so none is a call-result capture move.
		x64LockCmpxchg to arm64ThreadPointer gives false
		// EC16: no scaled-index form is a `movRegReg`, so none is a call-result capture move.
		leaRegBaseIndexScale to arm64AddLsl gives false
		// EC18: the high multiply is not a `movRegReg`, so it is not a call-result capture move.
		imulHighReg gives false
		// arm64 `fneg` is not a `movRegReg`, so it is not a call-result capture move.
		arm64Fneg gives false
		// G3: an ordered access is not a `movRegReg`, so it is not a call-result capture move.
		arm64LoadAcquire or arm64StoreRelease gives false
	end 'm'
end 'isCaptureMove'

function vregIsVirtual(vreg TargetVReg) returns bool
	return match vreg 'v'
		virtual gives true
		physical gives false
	end 'v'
end 'vregIsVirtual'

function vregIsPhysical(vreg TargetVReg) returns bool
	return match vreg 'v'
		virtual gives false
		physical gives true
	end 'v'
end 'vregIsPhysical'

// Resequence a `tryCall`'s two capture moves as a parallel copy and splice the ordered result into
// `newRefs`. The two DESTS are colored via `alloc`; the two SRCS are the physical return registers the
// lowering already fixed. `sequenceParallelCopy` drops a self-move (a hint-satisfied capture emits
// nothing) and breaks a value/flag swap with `xchg` — the whole point of routing through it.
// Are the ops at `pos` and `pos + 1` of `block` BOTH capture moves? The caller has already established that
// the previous op was a call and that `pos + 1` is in range; this reads the two ops and answers, holding
// neither — see the caller for why that matters.
function isCaptureMovePairAt(module TargetModule, block IrBlock, pos ElementCount) returns bool
	let opIdx = try block.opRefs.get(pos) otherwise panic("isCaptureMovePairAt: opRefs.get OOB at {pos}")
	let op = try module.ops.get(opIdx) otherwise panic("isCaptureMovePairAt: opIdx {opIdx} not in module.ops")
	if not isCaptureMove(op) 'notTheFirstHalf'
		return false
	end 'notTheFirstHalf'

	let nextIdx = try block.opRefs.get(pos + 1) otherwise panic("isCaptureMovePairAt: opRefs.get OOB at {pos + 1}")
	let nextOp = try module.ops.get(nextIdx) otherwise panic("isCaptureMovePairAt: opIdx {nextIdx} not in module.ops")
	return isCaptureMove(nextOp)
end 'isCaptureMovePairAt'

// The pair at `pos`, resequenced. The FOUR NUMBERS are read out first and the ops released, because the
// sequencer below pushes onto the very array they were borrowed from — and four numbers is all a capture
// move ever contributed: one destination register and one source register each.
function emitResequencedCaptureAt(module TargetModule, block IrBlock, pos ElementCount, alloc Allocation, newRefs OpIndexArray)
	let opIdx = try block.opRefs.get(pos) otherwise panic("emitResequencedCaptureAt: opRefs.get OOB at {pos}")
	let op = try module.ops.get(opIdx) otherwise panic("emitResequencedCaptureAt: opIdx {opIdx} not in module.ops")
	let resultDst = alloc.regNumOf(captureMoveDestId(op))
	let resultSrc = captureMoveSrcReg(op)

	let nextIdx = try block.opRefs.get(pos + 1) otherwise panic("emitResequencedCaptureAt: opRefs.get OOB at {pos + 1}")
	let nextOp = try module.ops.get(nextIdx) otherwise panic("emitResequencedCaptureAt: opIdx {nextIdx} not in module.ops")
	let flagDst = alloc.regNumOf(captureMoveDestId(nextOp))
	let flagSrc = captureMoveSrcReg(nextOp)

	emitResequencedCapture(module, resultDst: resultDst, resultSrc: resultSrc, flagDst: flagDst, flagSrc: flagSrc, newRefs: newRefs)
end 'emitResequencedCaptureAt'

function emitResequencedCapture(module TargetModule, resultDst RegNum, resultSrc RegNum, flagDst RegNum, flagSrc RegNum, newRefs OpIndexArray)
	var dsts = RegNumColumn.create()
	var srcs = RegNumColumn.create()
	dsts.push(resultDst)
	srcs.push(resultSrc)
	dsts.push(flagDst)
	srcs.push(flagSrc)

	let moves = sequenceParallelCopy(dsts, srcs: srcs)
	for i in 0 upto moves.count() 'eachMove'
		let dst = TargetVReg.physical(try moves.dsts.get(i) otherwise panic("emitResequencedCapture: dsts.get OOB"))
		let src = TargetVReg.physical(try moves.srcs.get(i) otherwise panic("emitResequencedCapture: srcs.get OOB"))
		let swap = try moves.isSwap.get(i) otherwise panic("emitResequencedCapture: isSwap.get OOB")
		let opIdx = module.ops.count()
		module.ops.push(TargetOp.xchgRegReg(dst, b: src) if swap else TargetOp.movRegReg(dst, srcReg: src))
		newRefs.push(opIdx)
	end 'eachMove'
end 'emitResequencedCapture'

// The virtual DEST id of a capture move (guarded by `isCaptureMove`, so the dest is always virtual).
function captureMoveDestId(op TargetOp) returns ValueId
	match op 'm'
		movRegReg(dst, _) then return virtualIdOf(dst)
		default panic("captureMoveDestId: not a movRegReg")
	end 'm'
end 'captureMoveDestId'

// The physical SRC register-number of a capture move (guarded by `isCaptureMove`, so the src is physical).
function captureMoveSrcReg(op TargetOp) returns RegNum
	match op 'm'
		movRegReg(_, src) then return physicalRegOf(src)
		default panic("captureMoveSrcReg: not a movRegReg")
	end 'm'
end 'captureMoveSrcReg'

function virtualIdOf(vreg TargetVReg) returns ValueId
	match vreg 'v'
		virtual(id) then return id
		physical then panic("virtualIdOf: expected a virtual register")
	end 'v'
end 'virtualIdOf'

function physicalRegOf(vreg TargetVReg) returns RegNum
	match vreg 'v'
		physical(reg) then return reg
		virtual then panic("physicalRegOf: expected a physical register")
	end 'v'
end 'physicalRegOf'

// If the op at layout sequence `seq` is a reuse def whose input outlived it, splice the physical
// `mov dest, input` the allocator recorded into `newRefs` BEFORE the op's own index —
// so at run time the destination register holds the reuse input when the two-address
// op executes. A new op index is minted at the end of `module.ops`.
function spliceReuseCopyBefore(module TargetModule, reuseCopies ReuseCopyPlan, seq OpSeq, newRefs OpIndexArray)
	match reuseCopies.at(seq) 'rc'
		none then break 'rc'
		copy(destReg, srcReg) then appendReuseCopyOp(module, destReg: destReg, srcReg: srcReg, newRefs: newRefs)
	end 'rc'
end 'spliceReuseCopyBefore'

function appendReuseCopyOp(module TargetModule, destReg RegNum, srcReg RegNum, newRefs OpIndexArray)
	let copyOp = TargetOp.movRegReg(TargetVReg.physical(destReg), srcReg: TargetVReg.physical(srcReg))
	let copyIdx = module.ops.count()
	module.ops.push(copyOp)
	newRefs.push(copyIdx)
end 'appendReuseCopyOp'

// True for a `mov r, r` — a no-op the biased coloring produced (a coalesced seed
// copy, or the R8 return move when the return value landed in R8).
function isPhysicalSelfMove(op TargetOp) returns bool
	match op 'sm'
		movRegReg(dst, src) then return vregsSamePhysical(dst, b: src)
		prologue to movRegImm32 then return false
		movReg32Reg32 to divideReg then return false
		pushReg to popReg then return false
		storeSlotReg to loadRegSlot then return false
		// None of the data-section band is a register-to-register move, so none can be a self-move.
		andRegReg to negF64RegReg then return false
		// arm64 reg-reg moves are the SHARED `movRegReg` (handled above), so the arm64 band — arm64's
		// own ALU / control / call ops — is never a register-to-register move, hence never a self-move.
		arm64Ret to arm64Fcsel then return false
		// `leaRegFunc`/`callReg` (P1.5-A1) and the Linux `x64Syscall` are not register-to-register moves
		// (a `lea`, a call, a syscall), so none can be a `mov r, r` self-move.
		leaRegFunc to x64Syscall then return false
		// The jump tables are terminators, not register-to-register moves, so neither is a self-move.
		x64JumpTable to arm64JumpTable then return false
		// The witness call is a call, not a register-to-register move, so it is not a self-move.
		callMem then return false
		// Neither stack-argument op is a register-to-register move (one touches memory at each end), so
		// neither can be a `mov r, r` self-move.
		arm64StoreOutgoingArg to arm64LoadIncomingArg then return false
		// The arm64 bit reinterpretation is not a `movRegReg`, so it is not a self-move — the same
		// structural reason every arm above returns `false`. Only the `movRegReg` arm compares two
		// register NUMBERS at all; nothing here ever asks whether `fmov`'s two ends are equal.
		//
		// ⚠ AND THE NUMBER COINCIDENCE THAT WOULD MAKE THAT COMPARISON DANGEROUS CANNOT ARISE, which
		// is worth stating because it reads backwards: `Arm64Register` is ONE `RegNum` space whose two
		// classes occupy DISJOINT ranges (`x0..x30` = 0..30, `d0..d31` = 31..62), so `fmov x3, d3` is
		// `RegNum` 3 and `RegNum` 34 and the two can never compare equal. It is precisely BECAUSE the
		// numbering is one space that a GPR and an FP register cannot collide; the hazard would be real
		// under v1's TWO-enum design, where `x3` and `d3` are both 3. x64 is the same shape (GPRs 0..15,
		// XMMs 16..31), which is why its `movqGprXmm` twin needs nothing here and is correctly answered
		// `false` by the `andRegReg to negF64RegReg` arm above — which covers its inbound twin `movqXmmGpr`
		// too, that arm's endpoint being the x64 band's last member.
		//
		// The arm is not optional: `arm64FmovFpGpr` is the LAST union member, so no range covers it and
		// the match would not be exhaustive without it.
		arm64FmovGprFp to arm64FmovFpGpr then return false
		// Not a move at all, so never a physical self-move.
		leaRegSlot then return false
		// F1b: not a move at all, so never a physical self-move.
		x64MemFill to arm64MemFill then return false
		// F2: not a move at all, so never a physical self-move.
		x64LockCmpxchg to arm64ThreadPointer then return false
		// EC16: not a move at all, so never a physical self-move.
		leaRegBaseIndexScale to arm64AddLsl then return false
		// EC18: not a move at all, so never a physical self-move.
		imulHighReg then return false
		// arm64 `fneg` is not a move at all, so never a physical self-move.
		arm64Fneg then return false
		// G3: an ordered access is not a move at all, so never a physical self-move.
		arm64LoadAcquire or arm64StoreRelease then return false
	end 'sm'
end 'isPhysicalSelfMove'

function vregsSamePhysical(a TargetVReg, b TargetVReg) returns bool
	return match a 'a'
		physical(ra) gives physicalEquals(b, ra: ra)
		virtual gives false
	end 'a'
end 'vregsSamePhysical'

function physicalEquals(b TargetVReg, ra RegNum) returns bool
	return match b 'b'
		physical(rb) gives ra == rb
		virtual gives false
	end 'b'
end 'physicalEquals'

// Splice one edge's moves at the placement chosen for it.
function spliceEdgeMoves(module TargetModule, plan EdgeMovePlan)
	match plan.placement 'place'
		predEnd then splicePredEnd(module, plan: plan)
		succStart then spliceSuccStart(module, plan: plan)
		split then spliceSplitUnreachable(plan)
	end 'place'
end 'spliceEdgeMoves'

// Pred has one successor: append the moves to its body (they run before the
// terminator, on the only edge out). The block is re-fetched per move via a
// FIELD-level borrow (`module.blocks.get`) so `appendOp` may mutate `module.ops`.
function splicePredEnd(module TargetModule, plan EdgeMovePlan)
	for i in 0 upto plan.moveCount() 'eachMove'
		var predBlock = try module.blocks.get(plan.predBlockRef) otherwise panic("splicePredEnd: predBlockRef {plan.predBlockRef} not in module.blocks")
		module.appendOp(predBlock, op: moveOpOf(plan, i: i))
	end 'eachMove'
end 'splicePredEnd'

// Succ has one predecessor: insert the moves at the front of its body (they run on
// entry, which can only be reached via this edge).
function spliceSuccStart(module TargetModule, plan EdgeMovePlan)
	for i in 0 upto plan.moveCount() 'eachMove'
		let opIdx = module.ops.count()
		module.ops.push(moveOpOf(plan, i: i))
		var succBlock = try module.blocks.get(plan.succBlockRef) otherwise panic("spliceSuccStart: succBlockRef {plan.succBlockRef} not in module.blocks")
		insertOpRef(succBlock, at: i, opIdx: opIdx)
	end 'eachMove'
end 'spliceSuccStart'

// A CRITICAL EDGE must never reach here: `splitCriticalEdges` (below) runs BEFORE
// coloring and splits every phi-carrying critical edge, so by the time SSA
// destruction places moves, every phi edge is either from a single-successor block
// or into a single-predecessor block.
function spliceSplitUnreachable(plan EdgeMovePlan)
	panic("spliceEdgeMoves: a critical edge (block id {plan.predBlockId} → {plan.succBlockId}) reached SSA destruction — splitCriticalEdges must run before coloring and eliminate it")
end 'spliceSplitUnreachable'

// ==========================================================================
// Critical-edge splitting — a PRE-PASS run before coloring
// ==========================================================================

// The label every spliced edge block carries. Built ONCE: this is on the hot path — a split
// happens per critical edge — and a global holds the one slice every split block shares.
let CritSplitLabel = b"critsplit"

// Split every phi-carrying critical edge in the module, so SSA destruction always
// has a safe home for its moves (a block reached from exactly this edge). A critical
// edge — a `branchEdge` (i.e. carrying phis) from a block with >1 successor into a
// block with >1 predecessor — gets a fresh block spliced onto it: `pred → split →
// succ`, with the phi `branchEdge` MOVED onto `split` (which has one successor, so
// SSA destruction places the moves at its end).
//
// Run before coloring so the mutation of `func.blockRefs`/`func.nextBlockId` happens
// OUTSIDE the per-function coloring loop's borrow of `func`. Each function is driven
// by INDEX and re-fetched inside `addSplitBlock`, so no `func` borrowed from
// `module.functions` is ever passed to a function that mutates it.
export function splitCriticalEdges(module TargetModule, target Target)
	for funcIdx in 0 upto module.funcCount() 'eachFunc'
		splitCriticalEdgesInFunc(module, funcIdx: funcIdx, target: target)
	end 'eachFunc'
end 'splitCriticalEdges'

function splitCriticalEdgesInFunc(module TargetModule, funcIdx FuncIndex, target Target)
	// The SKELETON is built through a helper so `func`'s borrow is scoped to it — the
	// split loop below mutates `module.functions[funcIdx]` (adding block refs), which
	// must not overlap a live borrow of that function.
	//
	// A `FuncTopology`, not a `FuncCfg`: classifying a critical edge asks only for the
	// successor and predecessor DEGREES. It has no use for the loop depths or the value count,
	// and building them here — an operand scan of every op, plus a DFS and a BFS per natural
	// loop, per function — was most of this pass's cost.
	let topo = buildFuncTopologyByIndex(module, funcIdx: funcIdx)

	// Collect the critical phi edges first (reads), then split them (writes) — the
	// splits are independent (each only redirects its own edge through a new block),
	// so the original CFG's classification stays valid across all of them.
	var predRefs = BlockRefArray.create()
	var succIds = BlockIdArray.create()
	for predLocal in 0 upto topo.numBlocks 'eachPred'
		if topo.succ.degree(predLocal) <= 1 'singleSucc'
			continue
		end 'singleSucc'
		let predBlock = blockAt(module, topo: topo, local: predLocal)
		for edge in predBlock.branchEdges 'eachEdge'
			let succLocal = try topo.localByBlockId.get(edge.targetBlockId) otherwise panic("splitCriticalEdgesInFunc: succ block id out of range")
			if topo.pred.degree(succLocal) > 1 'critical'
				predRefs.push(try topo.blockRefByLocal.get(predLocal) otherwise panic("splitCriticalEdgesInFunc: predLocal out of range"))
				succIds.push(edge.targetBlockId)
			end 'critical'
		end 'eachEdge'
	end 'eachPred'

	for k in 0 upto predRefs.count() 'eachSplit'
		let predRef = try predRefs.get(k) otherwise panic("splitCriticalEdgesInFunc: predRefs.get OOB")
		let succId = try succIds.get(k) otherwise panic("splitCriticalEdgesInFunc: succIds.get OOB")
		performCriticalSplit(module, funcIdx: funcIdx, predRef: predRef, succId: succId, target: target)
	end 'eachSplit'
end 'splitCriticalEdgesInFunc'

function performCriticalSplit(module TargetModule, funcIdx FuncIndex, predRef BlockRef, succId BlockId, target Target)
	let newRef = addSplitBlock(module, funcIdx: funcIdx, succId: succId, target: target)
	let newBlock = try module.blocks.get(newRef) otherwise panic("performCriticalSplit: newRef not in module.blocks")
	let newId = newBlock.id
	moveBranchEdgeToSplit(module, predRef: predRef, succId: succId, splitRef: newRef)
	retargetControlOp(module, predRef: predRef, oldTarget: succId, newTarget: newId)
end 'performCriticalSplit'

// Create the split block (an unconditional-branch terminator to `succId`) and register it in
// `module.blocks` + `func.blockRefs`. `func` is fetched HERE by index and mutated
// directly, so its borrow never escapes to a caller (which would clash with the
// split loop mutating the same function). The branch op is the TARGET's — `jmp` for x64,
// `arm64Branch` for arm64 — so the split block speaks the same ISA as the code around it.
function addSplitBlock(module TargetModule, funcIdx FuncIndex, succId BlockId, target Target) returns BlockRef
	var func = module.getFunc(funcIdx)
	let newId = func.nextBlockId
	func.nextBlockId = func.nextBlockId + 1
	module.blocks.push(IrBlock.create(newId, label: CritSplitLabel))
	let newRef = module.blocks.count() - 1
	func.blockRefs.push(newRef)
	var splitBlock = try module.blocks.get(newRef) otherwise panic("addSplitBlock: newRef not in module.blocks")
	module.setTerminator(splitBlock, op: unconditionalBranchTo(target, blockId: succId))
	return newRef
end 'addSplitBlock'

// The TARGET's unconditional branch to `blockId` — the one op an edge-split block terminates with.
function unconditionalBranchTo(target Target, blockId BlockId) returns TargetOp
	return match target.cpu 'cpu'
		x64 gives TargetOp.jmp(blockId)
		arm64 gives TargetOp.arm64Branch(blockId)
		wasm32 panic("unconditionalBranchTo: maxon-shv2 has no branch op for wasm32 (got {targetToString(target)})")
	end 'cpu'
end 'unconditionalBranchTo'

// Move the predecessor's `branchEdge` to `succId` (its phi args) onto the split
// block. The phi args now flow pred → split → succ, and the split block (one
// successor) is where SSA destruction places their moves. The pred and split block
// borrows are scoped to separate helpers so two live borrows of `module.blocks`
// never coexist.
function moveBranchEdgeToSplit(module TargetModule, predRef BlockRef, succId BlockId, splitRef BlockRef)
	let movedArgs = extractPredEdge(module, predRef: predRef, succId: succId)
	addSplitEdge(module, splitRef: splitRef, succId: succId, argIds: movedArgs)
end 'moveBranchEdgeToSplit'

// Remove the predecessor's `branchEdge` to `succId` and return its phi args.
function extractPredEdge(module TargetModule, predRef BlockRef, succId BlockId) returns ValueIdArray
	var movedArgs = ValueIdArray.create()
	var found = false
	var keptEdges = BranchEdgeArray.create()
	var predBlock = try module.blocks.get(predRef) otherwise panic("extractPredEdge: predRef not in module.blocks")
	for edge in predBlock.branchEdges 'eachEdge'
		if (not found) and edge.targetBlockId == succId 'moveThis'
			movedArgs = edge.argIds
			found = true
		end 'moveThis' else 'keep'
			keptEdges.push(edge)
		end 'keep'
	end 'eachEdge'
	if not found 'noEdge'
		panic("extractPredEdge: predecessor block ref {predRef} has no branch edge to block id {succId}")
	end 'noEdge'
	predBlock.branchEdges = keptEdges
	return movedArgs
end 'extractPredEdge'

// Give the split block its outgoing phi `branchEdge` to `succId`.
function addSplitEdge(module TargetModule, splitRef BlockRef, succId BlockId, argIds ValueIdArray)
	var splitBlock = try module.blocks.get(splitRef) otherwise panic("addSplitEdge: splitRef not in module.blocks")
	splitBlock.branchEdges.push(BranchEdge.create(succId, argIds: argIds))
end 'addSplitEdge'

// Build a function's CFG skeleton by INDEX, so the `func` borrow it needs is scoped to this
// helper and never held across the caller's mutation of the same function.
function buildFuncTopologyByIndex(module TargetModule, funcIdx FuncIndex) returns FuncTopology
	let func = module.getFunc(funcIdx)
	return buildFuncTopology(module, func: func)
end 'buildFuncTopologyByIndex'

// Redirect the predecessor's branch to `oldTarget` (its `jcc` conditional branch or its
// `jmp` terminator) so it targets `newTarget` instead. Exactly one control op matches.
//
// ⭐ THE ONE PLACE AN EDGE IS RE-POINTED, and it has TWO callers with opposite intents: the
// critical-edge split above INSERTS a block onto an edge, and `X64BranchCleanup` (which runs on
// fully allocated ops) REMOVES one. Both ask the same question of the same op roster — which is why
// there is one implementation and neither writes its own walk over the branch-carrying op kinds.
// Every kind that names a block is covered here, the multiway `x64JumpTable`/`arm64JumpTable`
// included, so a caller cannot silently miss an edge.
//
// Both branches are addressed DIRECTLY, off the block's own `condBranch` / `terminator`
// indices — the `jcc` used to be found by scanning every op of the predecessor, the same
// O(ops-in-block) search the CFG builder paid (see `CondBranch`). The rewrite is in place at
// the op's existing index, so the recorded index stays valid and there is no cached target
// to invalidate.
export function retargetControlOp(module TargetModule, predRef BlockRef, oldTarget BlockId, newTarget BlockId)
	var retargeted = false
	// ⚠ **THE PREDECESSOR IS READ OUT AND LET GO BEFORE THE FIRST WRITE.** `module.blocks.get` hands back a
	// BORROW of `module` (E3070), and every `retarget*` below writes `module.ops` — so holding the block
	// across them is refused, and rightly: the block record belongs to the array being written through.
	// Everything this function needs from it is three values that outlive the borrow — the two terminator
	// slots (scalar-payload unions, copied out) and the id the conditional half's panic cites. That id
	// REPLACES the label that panic used to quote, which was a borrowed `ByteArray` and could not be held
	// either; it is also the better citation, since a block's label is not its identity.
	//
	// ⭐ The two halves moved into functions of their own at the same time, and not for tidiness: a `match`
	// arm takes ONE statement, so reading the slot as the union it is — rather than through a
	// `hasCondBranchOp()`/`condBranchIndex()` pair whose second half panics if the first was not asked —
	// needs the arm's work to be a call. The pair is now unspellable in the wrong order here.
	let predBlock = try module.blocks.get(predRef) otherwise panic("retargetControlOp: predRef not in module.blocks")
	let condBranch = predBlock.condBranch
	let terminator = predBlock.terminator
	let predBlockId = predBlock.id

	match condBranch 'condSlot'
		none then break 'condSlot'
		opIndex(opIdx) then retargeted = retargetCondBranchOp(module, opIdx: opIdx, predBlockId: predBlockId, oldTarget: oldTarget, newTarget: newTarget) or retargeted
	end 'condSlot'

	match terminator 'termSlot'
		unset to fallthrough then break 'termSlot'
		opIndex(ti) then retargeted = retargetTerminatorOp(module, opIdx: ti, oldTarget: oldTarget, newTarget: newTarget) or retargeted
	end 'termSlot'

	if not retargeted 'noMatch'
		panic("retargetControlOp: predecessor block ref {predRef} has no branch to block id {oldTarget} to redirect")
	end 'noMatch'
end 'retargetControlOp'

// The CONDITIONAL half of the retarget above — the block's `condBranch` op, whichever of the four spellings
// this target uses. `predBlockId` is carried only for the panic, because the block itself may not be held
// across the writes these arms make (see the caller).
function retargetCondBranchOp(module TargetModule, opIdx OpIndex, predBlockId BlockId, oldTarget BlockId, newTarget BlockId) returns bool
	let op = try module.ops.get(opIdx) otherwise panic("retargetCondBranchOp: conditional branch op {opIdx} not in module.ops")
	match op 'cond'
		jcc(cond, target) then return retargetJcc(module, opIdx: opIdx, cond: cond, target: target, oldTarget: oldTarget, newTarget: newTarget)
		// The arm64 conditional branches: a flag test (`b.cond`) or a register zero-test (`cbz`/`cbnz`).
		// Each carries its own target block id, retargeted the same way the `jcc` is.
		arm64CondBranch(cond, target) then return retargetArm64CondBranch(module, opIdx: opIdx, cond: cond, target: target, oldTarget: oldTarget, newTarget: newTarget)
		arm64Cbz(reg, target) then return retargetArm64Cbz(module, opIdx: opIdx, reg: reg, target: target, oldTarget: oldTarget, newTarget: newTarget)
		arm64Cbnz(reg, target) then return retargetArm64Cbnz(module, opIdx: opIdx, reg: reg, target: target, oldTarget: oldTarget, newTarget: newTarget)
		default panic("retargetCondBranchOp: block {predBlockId} records its conditional branch at op {opIdx}, but that op is not a `jcc`/`arm64CondBranch`/`arm64Cbz`/`arm64Cbnz`")
	end 'cond'
end 'retargetCondBranchOp'

// The TERMINATOR half — the block's terminator op. Every arm that is not a real terminator panics, which is
// the roster the caller used to carry inline.
function retargetTerminatorOp(module TargetModule, opIdx OpIndex, oldTarget BlockId, newTarget BlockId) returns bool
	let op = try module.ops.get(opIdx) otherwise panic("retargetTerminatorOp: terminator not in module.ops")
	match op 'term'
		jmp(target) then return retargetJmp(module, opIdx: opIdx, target: target, oldTarget: oldTarget, newTarget: newTarget)
		ret then return false
		prologue to epilogue then panic("retargetTerminatorOp: pred terminator is a frame op")
		jcc then panic("retargetTerminatorOp: jcc reached as a terminator")
		movRegImm to divideReg then panic("retargetTerminatorOp: non-terminator op as terminator")
		pushReg to popReg then panic("retargetTerminatorOp: pushReg/popReg reached as a terminator — they are body ops inserted post-regalloc")
		storeSlotReg to loadRegSlot then panic("retargetTerminatorOp: a spill/reload reached as a terminator — the splitter inserts them as body ops, never as terminators")
		andRegReg to negF64RegReg then panic("retargetTerminatorOp: non-terminator op as terminator")
		// The arm64 band: `arm64Branch` is the unconditional terminator (retargeted like `jmp`);
		// `arm64Ret` is the ret terminator (like x64 `ret`). Everything else — the conditional
		// branches, ALU, frame, call ops — is not a terminator here.
		arm64Ret then return false
		arm64Branch(target) then return retargetArm64Branch(module, opIdx: opIdx, target: target, oldTarget: oldTarget, newTarget: newTarget)
		arm64CondBranch to arm64Fcsel then panic("retargetTerminatorOp: an arm64 non-terminator op reached as a terminator")
		// `leaRegFunc`/`callReg` (P1.5-A1) and the Linux `x64Syscall` are value-producing x64 body
		// ops, never a terminator — the same non-terminator panic the x64 ALU/data bands above raise.
		leaRegFunc to x64Syscall then panic("retargetTerminatorOp: non-terminator op as terminator")
		callMem then panic("retargetTerminatorOp: a `callMem` (witness call) is a body op, not a terminator")
		arm64StoreOutgoingArg to arm64LoadIncomingArg then panic("retargetTerminatorOp: a stack-argument op is a body op, not a terminator")
		arm64FmovGprFp to arm64FmovFpGpr then panic("retargetTerminatorOp: an arm64 general↔vector `fmov` (a bit reinterpretation) is a body op, not a terminator")
		leaRegSlot then panic("retargetTerminatorOp: a `leaRegSlot` (a frame address) is a body op, not a terminator")
		x64MemFill to arm64MemFill then panic("retargetTerminatorOp: a fill ladder is a body op, not a terminator — its branches are internal to its own encoding and name no block")
		x64LockCmpxchg to arm64ThreadPointer then panic("retargetTerminatorOp: an atomic or a thread-token read is a body op, not a terminator — the arm64 retry loop's branches are internal to its own encoding and name no block")
		// A jump table is a multiway terminator: redirect EVERY case slot (and the default) that names
		// `oldTarget` — a range/`or` arm fills several slots with one block, so the split of that single
		// CFG edge redirects all of them through the one split block.
		x64JumpTable(indexReg, defaultTarget, caseTargets, tableLabel) then return retargetJumpTableX64(module, opIdx: opIdx, indexReg: indexReg, defaultTarget: defaultTarget, caseTargets: caseTargets, tableLabel: tableLabel, oldTarget: oldTarget, newTarget: newTarget)
		arm64JumpTable(indexReg, defaultTarget, caseTargets, tableLabel) then return retargetJumpTableArm64(module, opIdx: opIdx, indexReg: indexReg, defaultTarget: defaultTarget, caseTargets: caseTargets, tableLabel: tableLabel, oldTarget: oldTarget, newTarget: newTarget)
		leaRegBaseIndexScale to arm64AddLsl then panic("retargetTerminatorOp: a scaled-index address or access is a body op, not a terminator — it names no block")
		imulHighReg then panic("retargetTerminatorOp: a high multiply is a body op, not a terminator — it names no block")
		arm64Fneg then panic("retargetTerminatorOp: a float negate is a body op, not a terminator — it names no block")
		arm64LoadAcquire or arm64StoreRelease then panic("retargetTerminatorOp: an ordered load/store is a body op, not a terminator — it names no block")
	end 'term'
end 'retargetTerminatorOp'

function retargetJcc(module TargetModule, opIdx OpIndex, cond X64CondCode, target BlockId, oldTarget BlockId, newTarget BlockId) returns bool
	if target != oldTarget 'notThis'
		return false
	end 'notThis'
	try module.ops.set(opIdx, value: TargetOp.jcc(cond, targetBlockId: newTarget)) otherwise panic("retargetJcc: ops.set OOB")
	return true
end 'retargetJcc'

function retargetJmp(module TargetModule, opIdx OpIndex, target BlockId, oldTarget BlockId, newTarget BlockId) returns bool
	if target != oldTarget 'notThis'
		return false
	end 'notThis'
	try module.ops.set(opIdx, value: TargetOp.jmp(newTarget)) otherwise panic("retargetJmp: ops.set OOB")
	return true
end 'retargetJmp'

// The arm64 twins of `retargetJcc`/`retargetJmp`: rewrite an arm64 branch's target block id when it
// is the edge being redirected, preserving the branch's other operands (its condition or its register
// zero-test). Same in-place rewrite at the recorded op index, so the CFG's branch indices stay valid.
function retargetArm64CondBranch(module TargetModule, opIdx OpIndex, cond Arm64CondCode, target BlockId, oldTarget BlockId, newTarget BlockId) returns bool
	if target != oldTarget 'notThis'
		return false
	end 'notThis'
	try module.ops.set(opIdx, value: TargetOp.arm64CondBranch(cond, targetBlockId: newTarget)) otherwise panic("retargetArm64CondBranch: ops.set OOB")
	return true
end 'retargetArm64CondBranch'

function retargetArm64Cbz(module TargetModule, opIdx OpIndex, reg TargetVReg, target BlockId, oldTarget BlockId, newTarget BlockId) returns bool
	if target != oldTarget 'notThis'
		return false
	end 'notThis'
	try module.ops.set(opIdx, value: TargetOp.arm64Cbz(reg, targetBlockId: newTarget)) otherwise panic("retargetArm64Cbz: ops.set OOB")
	return true
end 'retargetArm64Cbz'

function retargetArm64Cbnz(module TargetModule, opIdx OpIndex, reg TargetVReg, target BlockId, oldTarget BlockId, newTarget BlockId) returns bool
	if target != oldTarget 'notThis'
		return false
	end 'notThis'
	try module.ops.set(opIdx, value: TargetOp.arm64Cbnz(reg, targetBlockId: newTarget)) otherwise panic("retargetArm64Cbnz: ops.set OOB")
	return true
end 'retargetArm64Cbnz'

function retargetArm64Branch(module TargetModule, opIdx OpIndex, target BlockId, oldTarget BlockId, newTarget BlockId) returns bool
	if target != oldTarget 'notThis'
		return false
	end 'notThis'
	try module.ops.set(opIdx, value: TargetOp.arm64Branch(newTarget)) otherwise panic("retargetArm64Branch: ops.set OOB")
	return true
end 'retargetArm64Branch'

// Redirect a jump table's `oldTarget` edges to `newTarget` (a spliced critical-edge block). Rebuilds the
// case-target table and default with every occurrence remapped, and re-writes the op in place only when
// something matched — the same "did I retarget?" bool the branch retargeters return, so the caller's
// no-match panic still fires for an edge the table does not name. The two arms differ only in the op they
// reconstruct (x64 vs arm64); the remap itself is the shared `remapJumpTargets`.
function retargetJumpTableX64(module TargetModule, opIdx OpIndex, indexReg TargetVReg, defaultTarget BlockId, caseTargets BlockIdArray, tableLabel ByteArray, oldTarget BlockId, newTarget BlockId) returns bool
	if not jumpTableNamesTarget(defaultTarget, caseTargets: caseTargets, oldTarget: oldTarget) 'notThis'
		return false
	end 'notThis'
	let newDefault = newTarget if defaultTarget == oldTarget else defaultTarget
	let newTargets = remapJumpTargets(caseTargets, oldTarget: oldTarget, newTarget: newTarget)
	try module.ops.set(opIdx, value: TargetOp.x64JumpTable(indexReg, defaultTarget: newDefault, caseTargets: newTargets, tableLabel: tableLabel)) otherwise panic("retargetJumpTableX64: ops.set OOB")
	return true
end 'retargetJumpTableX64'

function retargetJumpTableArm64(module TargetModule, opIdx OpIndex, indexReg TargetVReg, defaultTarget BlockId, caseTargets BlockIdArray, tableLabel ByteArray, oldTarget BlockId, newTarget BlockId) returns bool
	if not jumpTableNamesTarget(defaultTarget, caseTargets: caseTargets, oldTarget: oldTarget) 'notThis'
		return false
	end 'notThis'
	let newDefault = newTarget if defaultTarget == oldTarget else defaultTarget
	let newTargets = remapJumpTargets(caseTargets, oldTarget: oldTarget, newTarget: newTarget)
	try module.ops.set(opIdx, value: TargetOp.arm64JumpTable(indexReg, defaultTarget: newDefault, caseTargets: newTargets, tableLabel: tableLabel)) otherwise panic("retargetJumpTableArm64: ops.set OOB")
	return true
end 'retargetJumpTableArm64'

// Does the jump table have any edge to `oldTarget` — a case slot or the default? Guards the retarget so
// the op is left untouched (and `retargeted` stays false) when the split edge belongs to a DIFFERENT
// predecessor's terminator.
function jumpTableNamesTarget(defaultTarget BlockId, caseTargets BlockIdArray, oldTarget BlockId) returns bool
	return defaultTarget == oldTarget or blockIdArrayContains(caseTargets, value: oldTarget)
end 'jumpTableNamesTarget'

// The case-target table with every `oldTarget` slot rewritten to `newTarget`, others verbatim.
function remapJumpTargets(caseTargets BlockIdArray, oldTarget BlockId, newTarget BlockId) returns BlockIdArray
	var out = BlockIdArray.create()
	for t in caseTargets 'eachSlot'
		out.push(newTarget if t == oldTarget else t)
	end 'eachSlot'
	return out
end 'remapJumpTargets'

// The physical op for move `i` of a plan: an `xchg` for a cycle-break, else a `mov`.
function moveOpOf(plan EdgeMovePlan, i MoveIndex) returns TargetOp
	let dst = TargetVReg.physical(plan.moveDstAt(i))
	let src = TargetVReg.physical(plan.moveSrcAt(i))
	if plan.moveIsSwapAt(i) 'swap'
		return TargetOp.xchgRegReg(dst, b: src)
	end 'swap'
	return TargetOp.movRegReg(dst, srcReg: src)
end 'moveOpOf'

// Drop every block's phi model now that it is realized as edge moves — the backend
// has no phi and must not see a block-arg or branch-edge.
function clearPhiModel(module TargetModule, func IrFunction)
	for blockRef in func.blockRefs 'eachBlock'
		var block = try module.blocks.get(blockRef) otherwise panic("clearPhiModel: blockRef not in module.blocks")
		block.blockArgs = IrBlockArgArray.create()
		block.branchEdges = BranchEdgeArray.create()
	end 'eachBlock'
end 'clearPhiModel'
