// AllocChecker — the symbolic verifier the design calls "the single highest-value
// safety net available here." `SpecTestRunner` treats the committed fragments as
// OUTPUTS, not gates, so the suite would otherwise go GREEN on a wrong-but-self-
// consistent allocator. This abstractly interprets the ALLOCATED program and asserts
// every use reads the register that actually holds its value — catching the exact
// bug class a plausible fragment hides: two simultaneously-live values aliased to
// one register, and a mis-ordered / mis-placed SSA-destruction edge copy (the v1
// "phi-copy trampoline" miscompile).
//
// WHERE IT RUNS. It runs on every function of every compile that sets `Project.checkAlloc`
// — ALWAYS under `spec-test` and `verify-warm-rebuild` (the dev gates, where it is the only
// real check on the allocator), and on a normal `build` only via `--check-alloc`. A failure
// PANICS the build, which under `spec-test` FAILS the test that triggered it.
//
// The split is safe because this pass is PURE: it reads the IR + the allocation plan and
// either panics or does nothing. It cannot change an emitted byte, so a `build` without it
// emits exactly what a `build` with it emits — the flag decides whether a wrong byte is
// CAUGHT, never which byte is produced. What must never happen is the inverse: turning it
// off where the fragments are regenerated (they would then agree with a broken allocator and
// the suite would go green on a miscompile), which is why `spec-test` hard-codes it on rather
// than inheriting a default. Verification of a `build` is worth ~10% of compile time only to
// someone changing the allocator; correctness of the SUITE is worth it always.
//
// It runs on the still-VIRTUAL program plus the coloring, the edge move PLAN, and the
// reuse-copy list — i.e. BEFORE applyAllocation commits them — so it validates the plan
// before it is shipped. Each ORIGINAL value holds one register for its whole range, and the
// M5.3 splitter's spills split a live range into memory-across-a-peak + fresh reload ids; the
// abstract state stays precise because at any point a live value `v` resides in `color[v]` and
// a spilled value additionally lives in its slot. The only in-block state change beyond an op's
// own def is a reuse-def copy (`mov dest, input`, simulated by `applyReuseCopy`) — a transient
// the op immediately overwrites — so the invariant holds at every value's own program points.
//
// Three checks, no CFG fixpoint:
//   A (interference). Per block, seed the abstract state from the live-in values +
//     phis (each in its color) — distinct colors, or ALIASING — then walk the ops
//     asserting each use reads its value and each def writes its register.
//   B (edge copies). Per phi-carrying edge, simulate the parallel copy from the
//     predecessor's exit state and assert each phi's register ends holding the value
//     the edge passes and each live-through value flows undisturbed.
//   C (spill chain). Track `slot → value` alongside `register → value`, and assert the
//     store→slot→reload chain preserves value identity FROM BOTH ENDS: a store supplies
//     exactly the value every reload of its slot expects (`recordSpill`), and a reload
//     reads the slot holding the value its `ReloadOrigin` names (`confirmReload`). This is
//     what catches a wrong value reaching a use through a slot chain that is internally
//     self-consistent op-by-op yet does not carry the original value's identity.

// The abstract register state: `regState[r]` is the value id currently in register
// `r`, or the `noValue` sentinel (= valueCount) when the register holds nothing the
// checker tracks.
typealias RegStateRow = Array with CfgIndex

export function checkFunctionAllocation(module TargetModule, func IrFunction, alloc Allocation, liveness LivenessResult, plans EdgeMovePlanArray, reuseCopies ReuseCopyArray, spillPlan SpillPlan)
	let cfg = liveness.cfg
	let valueCount = liveness.valueCount
	let noValue = valueCount
	let paramCount = func.paramCount

	// Per-block EXIT states (numBlocks rows of RegisterFileSize registers), so each
	// edge can be simulated from its predecessor's exit.
	var exitStates = filledColumn(cfg.numBlocks * RegisterFileSize, value: noValue)

	// SLOT tracking (M5.3): the value currently in each spill slot, or `noValue` (empty). Unlike
	// `regState`, `slotState` PERSISTS across blocks — a store dominates its reload but may live
	// in an earlier block (the design's dominating-reload: store in the depth-0 def/preheader,
	// reload in a later use-block). Blocks are walked in local order, which respects that
	// dominance for shv2's structured CFG, so a slot is always written before it is read; a
	// reload of an unwritten slot reads `noValue` and fails `checkReload` (its teeth).
	var slotState = filledColumn(spillPlan.slotCount, value: noValue)

	var buf = OperandList.create()
	// Scratch reused across every block — the live-in walk and the op list would otherwise each
	// allocate once per block. Worth keeping tight even though the checker is now opt-in on a
	// `build`: it still runs over every function of every test in the suite, on every run.
	var liveBuf = ValueIdArray.create()
	var ordered = OpIndexArray.create()

	for local in 0 upto cfg.numBlocks 'eachBlock'
		let block = blockAt(module, cfg: cfg, local: local)
		var regState = freshRegState(noValue)
		seedRegState(regState, module: module, liveness: liveness, local: local, alloc: alloc, block: block, noValue: noValue, paramCount: paramCount, funcName: func.name, liveBuf: liveBuf)

		ordered.clear()
		collectBlockOps(block, out: ordered)
		for opIdx in ordered 'eachOp'
			// Simulate any reuse-def copy `mov dest, input` the allocator will splice
			// before this op (the two-address input outlived), so the op then reads its
			// input from the destination register — exactly what the machine does.
			applyReuseCopy(reuseCopies, opIdx: opIdx, regState: regState)
			let op = try module.ops.get(opIdx) otherwise panic("AllocChecker: opIdx not in module.ops")
			checkOp(op, regState: regState, alloc: alloc, buf: buf, noValue: noValue, paramCount: paramCount, funcName: func.name, blockLabel: block.label, slotState: slotState, origins: spillPlan.origins)
		end 'eachOp'

		copyRegState(exitStates, dstBase: local * RegisterFileSize, src: regState, srcBase: 0)
	end 'eachBlock'

	// Validate EVERY CFG edge, not only the move-producing plans. A fully-coalesced
	// edge (dstReg == srcReg for every phi → no move, no plan) is otherwise never
	// checked, so a value clobbered in a predecessor whose only remaining "use" is that
	// edge — the coalesced loop back-edge this design relies on most — would slip
	// through. Each edge is simulated from its predecessor's exit, applying its plan's
	// moves if it has one (else none).
	for predLocal in 0 upto cfg.numBlocks 'eachPred'
		let deg = cfg.succ.degree(predLocal)
		for k in 0 upto deg 'eachSucc'
			let succLocal = cfg.succ.neighbour(predLocal, k: k)
			checkEdge(module, func: func, cfg: cfg, predLocal: predLocal, succLocal: succLocal, exitStates: exitStates, alloc: alloc, liveness: liveness, plans: plans, noValue: noValue, liveBuf: liveBuf)
		end 'eachSucc'
	end 'eachPred'
end 'checkFunctionAllocation'

function freshRegState(noValue ValueId) returns RegStateRow
	return filledColumn(RegisterFileSize, value: noValue)
end 'freshRegState'

function copyRegState(dst RegStateRow, dstBase ByteCount, src RegStateRow, srcBase ByteCount)
	for r in 0 upto RegisterFileSize 'each'
		let v = try src.get(srcBase + r) otherwise panic("AllocChecker.copyRegState: src.get OOB")
		try dst.set(dstBase + r, value: v) otherwise panic("AllocChecker.copyRegState: dst.set OOB")
	end 'each'
end 'copyRegState'

function regStateGet(regState RegStateRow, reg MachineWord) returns ValueId
	return try regState.get(reg) otherwise panic("AllocChecker.regStateGet: register {reg} out of range")
end 'regStateGet'

function regStateSet(regState RegStateRow, reg MachineWord, value ValueId)
	try regState.set(reg, value: value) otherwise panic("AllocChecker.regStateSet: register {reg} out of range")
end 'regStateSet'

// Seed a block's entry state: every non-phi live-in value and every phi resides in
// its color. Two of them sharing a color would be simultaneously live in one
// register — the aliasing bug, caught right here. The ENTRY block additionally seeds
// each parameter's INCOMING register (see seedEntryParamIncomingRegs).
// Walks the SET BITS of the live-in row, not the value space. Testing every value id here would be
// O(blocks × values) — it was the single largest line item in register allocation on a large
// function back when the checker ran unconditionally. Keep it live-set-proportional regardless:
// the suite pays this cost on every test of every run. `liveBuf` is scratch reused across blocks.
function seedRegState(regState RegStateRow, module TargetModule, liveness LivenessResult, local CfgIndex, alloc Allocation, block IrBlock, noValue ValueId, paramCount ParamCount, funcName String, liveBuf ValueIdArray)
	if local == 0 'entry'
		seedEntryParamIncomingRegs(regState, module: module, cfg: liveness.cfg, paramCount: paramCount)
	end 'entry'

	liveness.liveInInto(local, out: liveBuf)
	for v in liveBuf 'eachLiveIn'
		placeValueAtColor(regState, v: v, alloc: alloc, noValue: noValue, funcName: funcName, blockLabel: block.label, what: "live-in")
	end 'eachLiveIn'

	for arg in block.blockArgs 'eachPhi'
		placeValueAtColor(regState, v: arg.valueId, alloc: alloc, noValue: noValue, funcName: funcName, blockLabel: block.label, what: "phi")
	end 'eachPhi'
end 'seedRegState'

// Seed the ENTRY block's abstract state with each parameter residing in its INCOMING ABI
// register — the ABI delivers parameter i in argReg[i] before the entry capture `mov
// color(v_i), argReg[i]` copies it out. Establishing that fact is what gives the checker
// teeth against the F1 read-after-clobber class: each capture then reads a register the
// checker knows holds its parameter and VERIFIES it (checkCopyOp), so if an earlier
// capture's destination clobbered that incoming register, the checker sees the wrong value
// and PANICS instead of shipping a silent miscompile.
function seedEntryParamIncomingRegs(regState RegStateRow, module TargetModule, cfg FuncCfg, paramCount ParamCount)
	let captures = collectEntryParamCaptures(module, cfg: cfg, paramCount: paramCount)
	for cap in captures 'eachParam'
		regStateSet(regState, reg: cap.incomingReg, value: cap.valueId)
	end 'eachParam'
end 'seedEntryParamIncomingRegs'

function placeValueAtColor(regState RegStateRow, v ValueId, alloc Allocation, noValue ValueId, funcName String, blockLabel String, what String)
	let reg = alloc.regNumOf(v)
	let occupant = regStateGet(regState, reg: reg)
	if occupant != noValue and occupant != v 'aliased'
		panic("AllocChecker: register aliasing in '{funcName}' block '{blockLabel}': {what} value {v} and value {occupant} are both live in register {reg} — the colorer gave two simultaneously-live values the same register")
	end 'aliased'
	regStateSet(regState, reg: reg, value: v)
end 'placeValueAtColor'

// A `mov`/`mov32` is a COPY (special-cased): its virtual source must hold its value,
// and its destination register receives the copied value's identity. Every other op
// is interpreted generically from the operand model + implicit-register masks.
function checkOp(op TargetOp, regState RegStateRow, alloc Allocation, buf OperandList, noValue ValueId, paramCount ParamCount, funcName String, blockLabel String, slotState RegStateRow, origins ReloadOriginArray)
	match op 'chk'
		movRegReg(dst, src) then checkCopyOp(dst, src: src, regState: regState, alloc: alloc, paramCount: paramCount, funcName: funcName, blockLabel: blockLabel)
		movReg32Reg32(dst, src) then checkCopyOp(dst, src: src, regState: regState, alloc: alloc, paramCount: paramCount, funcName: funcName, blockLabel: blockLabel)
		prologue to movRegImm32 then checkGenericOp(op, regState: regState, alloc: alloc, buf: buf, noValue: noValue, funcName: funcName, blockLabel: blockLabel)
		subRegReg to idivReg then checkGenericOp(op, regState: regState, alloc: alloc, buf: buf, noValue: noValue, funcName: funcName, blockLabel: blockLabel)
		pushReg to popReg then panic("AllocChecker.checkOp: pushReg/popReg are inserted by the prologue/epilogue pass AFTER the checker runs, so they must never reach it")
		storeSlotReg(slot, srcReg) then checkStoreSlot(slot, srcReg: srcReg, regState: regState, alloc: alloc, slotState: slotState, origins: origins, funcName: funcName, blockLabel: blockLabel)
		loadRegSlot(destReg, slot) then checkLoadSlot(destReg, slot: slot, regState: regState, alloc: alloc, slotState: slotState, origins: origins, funcName: funcName, blockLabel: blockLabel)
	end 'chk'
end 'checkOp'

// A `storeSlotReg(slot, srcReg)` (spill): its source register must currently hold the spilled
// value (`srcReg` is the value's own virtual register), and the slot then records that value.
// The source is untouched (a store does not clobber its source), so `regState` is unchanged.
function checkStoreSlot(slot SpillSlot, srcReg X64VReg, regState RegStateRow, alloc Allocation, slotState RegStateRow, origins ReloadOriginArray, funcName String, blockLabel String)
	match srcReg 's'
		virtual(v) then recordSpill(slot, v: v, regState: regState, alloc: alloc, slotState: slotState, origins: origins, funcName: funcName, blockLabel: blockLabel)
		physical then panic("AllocChecker: storeSlotReg in '{funcName}' block '{blockLabel}' has a PHYSICAL source — the splitter always spills a virtual value")
	end 's'
end 'checkStoreSlot'

function recordSpill(slot SpillSlot, v ValueId, regState RegStateRow, alloc Allocation, slotState RegStateRow, origins ReloadOriginArray, funcName String, blockLabel String)
	let reg = alloc.regNumOf(v)
	let held = regStateGet(regState, reg: reg)
	if held != v 'wrong'
		panic("AllocChecker: bad spill in '{funcName}' block '{blockLabel}': value {v} was colored to register {reg}, but that register holds value {held} at its storeSlotReg — a clobber before the spill")
	end 'wrong'

	// STORE-SIDE identity check (the other half of the slot-chain invariant; the reload side is
	// `confirmReload`). A store to slot `s` supplies the value that EVERY reload of slot `s` will
	// later claim to reload — so the value it stores (`v`) MUST equal each such reload's
	// ReloadOrigin.originalValueId. If it does not, a reload of `s` would hand its uses `v`'s value
	// while the program treats it as a different value's — the exact "wrong value through a
	// self-consistent-looking chain" the reload-side check alone catches only at the reload (and
	// only if that reload's block is reached in the walk). Verifying it HERE catches a mis-targeted
	// store at its source, with a store-site diagnostic, and flags a store whose split lineage was
	// corrupted even when its reload is elsewhere. (Every spilled value gets its OWN slot, so all
	// origins for a slot legitimately share one `originalValueId`; a future slot-coalescing pass
	// that packs distinct values into one slot must revisit this — noted, not yet reachable.)
	assertStoreMatchesReloadOrigins(origins, slot: slot, storedValue: v, funcName: funcName, blockLabel: blockLabel)

	slotStateSet(slotState, slot: slot, value: v)
end 'recordSpill'

// Assert every reload of `slot` reloads exactly `storedValue` — the store-side half of the
// slot-chain identity invariant (see `recordSpill`).
function assertStoreMatchesReloadOrigins(origins ReloadOriginArray, slot SpillSlot, storedValue ValueId, funcName String, blockLabel String)
	for o in origins 'eachOrigin'
		if o.slot == slot and o.originalValueId != storedValue 'mismatch'
			panic("AllocChecker: broken split chain in '{funcName}' block '{blockLabel}': the store to slot {slot} writes value {storedValue}, but reload {o.reloadValueId} claims to reload value {o.originalValueId} from that slot — the store→slot→reload chain does not preserve value identity (a mis-targeted store or a reload with the wrong ReloadOrigin)")
		end 'mismatch'
	end 'eachOrigin'
end 'assertStoreMatchesReloadOrigins'

// A `loadRegSlot(destReg, slot)` (reload): the slot must currently hold the ORIGINAL value the
// reload reloads (from its ReloadOrigin), and the op's slot must be the one the splitter
// assigned — a wrong-slot reload, or a slot never written by a matching store, fails HERE
// rather than reading stale bytes at run time. It then DEFINES the fresh reload value in its
// register (subsequent uses were rewritten to it, so the normal use checks carry from here).
function checkLoadSlot(destReg X64VReg, slot SpillSlot, regState RegStateRow, alloc Allocation, slotState RegStateRow, origins ReloadOriginArray, funcName String, blockLabel String)
	match destReg 'd'
		virtual(freshId) then verifyReload(freshId, slot: slot, regState: regState, alloc: alloc, slotState: slotState, origins: origins, funcName: funcName, blockLabel: blockLabel)
		physical then panic("AllocChecker: loadRegSlot in '{funcName}' block '{blockLabel}' has a PHYSICAL destination — the splitter always reloads into a fresh virtual value")
	end 'd'
end 'checkLoadSlot'

function verifyReload(freshId ValueId, slot SpillSlot, regState RegStateRow, alloc Allocation, slotState RegStateRow, origins ReloadOriginArray, funcName String, blockLabel String)
	match reloadOriginOf(origins, reloadValueId: freshId) 'o'
		none then panic("AllocChecker: loadRegSlot in '{funcName}' block '{blockLabel}' defines value {freshId} with no recorded ReloadOrigin — a splitter bug (every reload must record what it reloads)")
		origin(expectedSlot, originalValueId) then confirmReload(freshId, slot: slot, expectedSlot: expectedSlot, originalValueId: originalValueId, regState: regState, alloc: alloc, slotState: slotState, funcName: funcName, blockLabel: blockLabel)
	end 'o'
end 'verifyReload'

function confirmReload(freshId ValueId, slot SpillSlot, expectedSlot SpillSlot, originalValueId ValueId, regState RegStateRow, alloc Allocation, slotState RegStateRow, funcName String, blockLabel String)
	if slot != expectedSlot 'wrongSlot'
		panic("AllocChecker: reload of value {originalValueId} in '{funcName}' block '{blockLabel}' reads slot {slot}, but its ReloadOrigin says slot {expectedSlot} — a wrong-slot reload")
	end 'wrongSlot'
	let held = slotStateGet(slotState, slot: slot)
	if held != originalValueId 'stale'
		panic("AllocChecker: reload in '{funcName}' block '{blockLabel}': slot {slot} holds value {held}, not the reloaded value {originalValueId} — a missing/mis-targeted store, or a wrong-slot reload")
	end 'stale'
	regStateSet(regState, reg: alloc.regNumOf(freshId), value: freshId)
end 'confirmReload'

function slotStateGet(slotState RegStateRow, slot SpillSlot) returns ValueId
	return try slotState.get(slot) otherwise panic("AllocChecker.slotStateGet: slot {slot} out of range (a spill/reload used a slot beyond the plan's count)")
end 'slotStateGet'

function slotStateSet(slotState RegStateRow, slot SpillSlot, value ValueId)
	try slotState.set(slot, value: value) otherwise panic("AllocChecker.slotStateSet: slot {slot} out of range (a spill/reload used a slot beyond the plan's count)")
end 'slotStateSet'

// Simulate a reuse-def copy `mov dest, input` before its op: the destination register
// receives the value currently in the input's register. A no-op when the op has no
// reuse copy (the coalesced common case). The subsequent generic-op check then verifies
// the input use still reads its own (undisturbed) register and the def overwrites the
// destination — so a reuse copy that clobbered a live value surfaces as a later bad use.
function applyReuseCopy(reuseCopies ReuseCopyArray, opIdx OpIndex, regState RegStateRow)
	match reuseCopyForOp(reuseCopies, opIdx: opIdx) 'rc'
		none then break 'rc'
		copy(destReg, srcReg) then regStateSet(regState, reg: destReg, value: regStateGet(regState, reg: srcReg))
	end 'rc'
end 'applyReuseCopy'

// `mov dst, src`: assert src holds its value, then dst receives that value. A
// virtual dst is a fresh SSA value (its own identity now sits in its register); a
// physical dst (the R8 return move) receives the SOURCE value's identity, so the
// implicit-R8 use at `ret` can confirm the return value is there.
function checkCopyOp(dst X64VReg, src X64VReg, regState RegStateRow, alloc Allocation, paramCount ParamCount, funcName String, blockLabel String)
	let srcReg = physRegNumOf(src, alloc: alloc)
	assertSourceHolds(src, srcReg: srcReg, regState: regState, funcName: funcName, blockLabel: blockLabel)
	let dstReg = physRegNumOf(dst, alloc: alloc)

	match dst 'd'
		virtual(did) then defineCopyVirtualDst(did, src: src, srcReg: srcReg, dstReg: dstReg, regState: regState, paramCount: paramCount, funcName: funcName, blockLabel: blockLabel)
		physical then regStateSet(regState, reg: dstReg, value: regStateGet(regState, reg: srcReg))
	end 'd'
end 'checkCopyOp'

// A copy into a virtual (SSA) destination establishes the destination value in its
// register. For a PARAMETER CAPTURE — a copy from a physical source into a parameter value
// (`did < paramCount`) — additionally VERIFY the source (incoming) register still holds
// that parameter: the entry seed placed parameter `did` in its incoming register, so if an
// earlier capture's destination clobbered it, a different value sits there now and this
// assertion fires. This is the check that was missing when the F1 silent miscompile shipped
// — a physical copy source was UNCONDITIONALLY untracked (assertSourceHolds skips it), so a
// clobbered incoming register was never noticed.
function defineCopyVirtualDst(did ValueId, src X64VReg, srcReg MachineWord, dstReg MachineWord, regState RegStateRow, paramCount ParamCount, funcName String, blockLabel String)
	if isParamCaptureSource(did, src: src, paramCount: paramCount) 'paramCapture'
		let held = regStateGet(regState, reg: srcReg)
		if held != did 'clobbered'
			panic("AllocChecker: parameter-capture clobber in '{funcName}' block '{blockLabel}': parameter {did} arrives in register {srcReg}, but that register holds value {held} at its capture — an earlier parameter capture's destination was colored onto this incoming register and clobbered it before the capture read it (a read-after-clobber miscompile)")
		end 'clobbered'
	end 'paramCapture'
	regStateSet(regState, reg: dstReg, value: did)
end 'defineCopyVirtualDst'

// True iff `mov virtual(did), src` is a parameter capture: `did` is a parameter value
// (< paramCount, the ids the parser reserves for parameters) and `src` is a physical
// register (the incoming ABI register). A physical source that is NOT a parameter capture
// (the call- and idiv-result `mov`s) names a register, not a value the entry seed tracks,
// so it stays unverified — its register was clobbered to `noValue` by the call / idiv.
function isParamCaptureSource(did ValueId, src X64VReg, paramCount ParamCount) returns bool
	if did >= paramCount 'notParam'
		return false
	end 'notParam'
	return match src 's'
		physical gives true
		virtual gives false
	end 's'
end 'isParamCaptureSource'

// Generic op: every USE reads a register that must hold its value (explicit virtual
// operands, and the implicit-use registers like R8 at `ret`); every DEF writes its
// register with its value; implicit defs clobber their registers to `noValue`.
function checkGenericOp(op TargetOp, regState RegStateRow, alloc Allocation, buf OperandList, noValue ValueId, funcName String, blockLabel String)
	targetOpOperands(op, buf: buf)

	for o in buf 'uses'
		if not operandIsDef(o) 'isUse'
			assertOperandUse(o, regState: regState, alloc: alloc, noValue: noValue, funcName: funcName, blockLabel: blockLabel)
		end 'isUse'
	end 'uses'

	let implicitUses = op.rawValue.implicitUses
	for reg in 0 upto RegisterFileSize 'implUse'
		if regMaskContains(implicitUses, regNum: reg) 'reads'
			if regStateGet(regState, reg: reg) == noValue 'undefined'
				panic("AllocChecker: implicit use of register {reg} in '{funcName}' block '{blockLabel}' but it holds no value — the return value never reached R8, or was clobbered before `ret`")
			end 'undefined'
		end 'reads'
	end 'implUse'

	for o in buf 'defs'
		if operandIsDef(o) 'isDef'
			if operandIsReuseDef(o) and operandIsVirtual(o) 'reuseDef'
				assertReuseInvariant(o, buf: buf, regState: regState, alloc: alloc, funcName: funcName, blockLabel: blockLabel)
			end 'reuseDef'
			applyOperandDef(o, regState: regState, alloc: alloc, noValue: noValue)
		end 'isDef'
	end 'defs'

	let implicitDefs = op.rawValue.implicitDefs
	for reg in 0 upto RegisterFileSize 'implDef'
		if regMaskContains(implicitDefs, regNum: reg) 'writes'
			regStateSet(regState, reg: reg, value: noValue)
		end 'writes'
	end 'implDef'
end 'checkGenericOp'

function assertOperandUse(o Operand, regState RegStateRow, alloc Allocation, noValue ValueId, funcName String, blockLabel String)
	if operandIsVirtual(o) 'virt'
		let v = operandValueId(o)
		let reg = alloc.regNumOf(v)
		let held = regStateGet(regState, reg: reg)
		if held != v 'wrong'
			panic("AllocChecker: bad use in '{funcName}' block '{blockLabel}': value {v} was colored to register {reg}, but that register holds value {held} at the use — a clobber or aliasing")
		end 'wrong'
	end 'virt' else 'phys'
		let reg = operandRegister(o).rawValue
		if regStateGet(regState, reg: reg) == noValue 'undefined'
			panic("AllocChecker: physical use of register {reg} in '{funcName}' block '{blockLabel}' but it holds no value")
		end 'undefined'
	end 'phys'
end 'assertOperandUse'

// THE reuse-copy verification: a two-address reuse def's DESTINATION register must
// already hold its reuse INPUT's value (by coalescing, or by the materialized
// `mov dest, input` applyReuseCopy simulated) at the point the op executes — because
// the encoder emits `<op> dest, rhs`, reading the destination as the input. This is the
// Early-vs-Late distinction made concrete: the input is read (Early) from the register
// the Late def then overwrites. A missing or mis-targeted reuse copy is caught right
// here rather than shipped as a wrong-value miscompile.
function assertReuseInvariant(o Operand, buf OperandList, regState RegStateRow, alloc Allocation, funcName String, blockLabel String)
	let inputValue = operandReuseInputValueId(o, buf: buf)
	let destReg = alloc.regNumOf(operandValueId(o))
	let held = regStateGet(regState, reg: destReg)
	if held != inputValue 'brokenReuse'
		panic("AllocChecker: reuse def value {operandValueId(o)} in '{funcName}' block '{blockLabel}': its destination register {destReg} holds value {held}, not its reuse input {inputValue} — the two-address op would compute on the wrong value (a missing or mis-targeted reuse-def copy `mov dest, input`)")
	end 'brokenReuse'
end 'assertReuseInvariant'

function applyOperandDef(o Operand, regState RegStateRow, alloc Allocation, noValue ValueId)
	if operandIsVirtual(o) 'virt'
		let v = operandValueId(o)
		regStateSet(regState, reg: alloc.regNumOf(v), value: v)
	end 'virt' else 'phys'
		regStateSet(regState, reg: operandRegister(o).rawValue, value: noValue)
	end 'phys'
end 'applyOperandDef'

// Assert a copy's SOURCE register holds its value (virtual source only — a physical
// source names a register, not a tracked value).
function assertSourceHolds(src X64VReg, srcReg MachineWord, regState RegStateRow, funcName String, blockLabel String)
	match src 's'
		virtual(sid) then assertHolds(regState, reg: srcReg, expected: sid, funcName: funcName, blockLabel: blockLabel)
		physical then break 's'
	end 's'
end 'assertSourceHolds'

function assertHolds(regState RegStateRow, reg MachineWord, expected ValueId, funcName String, blockLabel String)
	let held = regStateGet(regState, reg: reg)
	if held != expected 'wrong'
		panic("AllocChecker: bad copy source in '{funcName}' block '{blockLabel}': register {reg} should hold value {expected} but holds {held}")
	end 'wrong'
end 'assertHolds'

// The physical register number of an operand: a virtual register's color, or a
// physical register's own number.
function physRegNumOf(vreg X64VReg, alloc Allocation) returns MachineWord
	return match vreg 'v'
		virtual(id) gives alloc.regNumOf(id)
		physical(reg) gives reg.rawValue
	end 'v'
end 'physRegNumOf'

// ==========================================================================
// Check B — edge copies
// ==========================================================================

// Simulate one CFG edge from the predecessor's exit state and assert it establishes
// the successor's entry: every phi register ends holding the value the edge passes,
// and every live-through (non-phi) value flows undisturbed. Blocks are resolved by the
// O(1) flat FuncCfg index (never `getBlockByIdIn`). The edge's moves come from its plan
// if it has one; a fully-coalesced edge has none, and the assertions below still catch
// a predecessor clobber whose only remaining "use" was this edge.
function checkEdge(module TargetModule, func IrFunction, cfg FuncCfg, predLocal CfgIndex, succLocal CfgIndex, exitStates RegStateRow, alloc Allocation, liveness LivenessResult, plans EdgeMovePlanArray, noValue ValueId, liveBuf ValueIdArray)
	var sim = freshRegState(noValue)
	copyRegState(sim, dstBase: 0, src: exitStates, srcBase: predLocal * RegisterFileSize)

	let planIdx = findPlanIndex(plans, predLocal: predLocal, succLocal: succLocal)
	if planIdx < plans.count() 'hasPlan'
		applyPlanMoves(sim, plan: try plans.get(planIdx) otherwise panic("checkEdge: plans.get OOB"))
	end 'hasPlan'

	let predBlock = blockAt(module, cfg: cfg, local: predLocal)
	let succBlock = blockAt(module, cfg: cfg, local: succLocal)

	if succBlock.blockArgs.count() > 0 'hasPhis'
		let view = PhiEdgeView.resolve(succBlock, argIds: edgeArgIds(predBlock, succBlockId: succBlock.id), context: "(edge check)")
		for k in 0 upto view.count 'eachPhi'
			let incoming = view.incomingAt(k)
			let reg = alloc.regNumOf(view.phiValueIdAt(k))
			let held = regStateGet(sim, reg: reg)
			if held != incoming 'wrongPhi'
				panic("AllocChecker: bad edge copy from '{predBlock.label}' to '{succBlock.label}' in '{func.name}': phi {view.phiValueIdAt(k)} (register {reg}) should receive the incoming value {incoming} but the edge moves left {held} there — a mis-ordered parallel copy")
			end 'wrongPhi'
		end 'eachPhi'
	end 'hasPhis'

	// Walk the SET BITS of the successor's live-in row. Testing every value id per edge would be
	// O(edges × values) — the same quadratic as `seedRegState`, once more.
	liveness.liveInInto(succLocal, out: liveBuf)
	for v in liveBuf 'liveThrough'
		if isPhiValue(succBlock, v: v) 'phiNotLiveThrough'
			continue
		end 'phiNotLiveThrough'
		let reg = alloc.regNumOf(v)
		let held = regStateGet(sim, reg: reg)
		if held != v 'disturbed'
			panic("AllocChecker: bad edge from '{predBlock.label}' to '{succBlock.label}' in '{func.name}': live-through value {v} (register {reg}) was clobbered by the edge (now holds {held})")
		end 'disturbed'
	end 'liveThrough'
end 'checkEdge'

// Apply a plan's ordered parallel moves (`mov` / `xchg`) to the abstract state.
function applyPlanMoves(sim RegStateRow, plan EdgeMovePlan)
	for i in 0 upto plan.moveCount() 'applyMoves'
		let dst = plan.moveDstAt(i)
		let src = plan.moveSrcAt(i)
		if plan.moveIsSwapAt(i) 'swap'
			let tmp = regStateGet(sim, reg: dst)
			regStateSet(sim, reg: dst, value: regStateGet(sim, reg: src))
			regStateSet(sim, reg: src, value: tmp)
		end 'swap' else 'copy'
			regStateSet(sim, reg: dst, value: regStateGet(sim, reg: src))
		end 'copy'
	end 'applyMoves'
end 'applyPlanMoves'

// The index of the move-plan for edge `predLocal -> succLocal`, or `plans.count()` when
// the edge has no plan (fully coalesced — no moves to apply).
function findPlanIndex(plans EdgeMovePlanArray, predLocal CfgIndex, succLocal CfgIndex) returns ByteCount
	for i in 0 upto plans.count() 'each'
		let p = try plans.get(i) otherwise panic("findPlanIndex: plans.get OOB")
		if p.predLocal == predLocal and p.succLocal == succLocal 'match'
			return i
		end 'match'
	end 'each'
	return plans.count()
end 'findPlanIndex'

// The values a predecessor passes on its edge to `succBlockId`.
function edgeArgIds(predBlock IrBlock, succBlockId BlockId) returns ValueIdArray
	for edge in predBlock.branchEdges 'eachEdge'
		if edge.targetBlockId == succBlockId 'match'
			return edge.argIds
		end 'match'
	end 'eachEdge'
	panic("edgeArgIds: predecessor '{predBlock.label}' has no branch edge to block id {succBlockId}")
end 'edgeArgIds'

function isPhiValue(block IrBlock, v ValueId) returns bool
	for arg in block.blockArgs 'each'
		if arg.valueId == v 'match'
			return true
		end 'match'
	end 'each'
	return false
end 'isPhiValue'
