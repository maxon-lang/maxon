// StdToWasm — the wasm backend's Std-module → WASI-Preview2 CORE-module lowering.
//
// ⭐ A SIBLING OF x64/arm64, NOT A DESCENDANT. The register-allocating backends run
// Std → Target (isel) → colour → SSA-destruction → encode. The wasm backend skips ALL of
// that: wasm's operand stack has an unbounded local file, so every SSA `ValueId` simply
// IS a wasm local (v1's identity model), there is no register pressure to allocate for, and
// there is no Target dialect to lower into. This file consumes the `StdModule` directly and
// emits the byte-encoded module through A1's `WasmBinary` seam. That is why the `wasm32`
// arms in RegisterAllocator/RegBits/SsaDestruction/TargetPrinter stay dead-but-exhaustive:
// the wasm path never reaches them.
//
// ⭐ WHAT IS DELIBERATELY NOT REUSED FROM shv2's SHARED BACKEND CODE, AND WHY:
//   • `SsaDestruction.sequenceParallelCopy` — it is module-private (not exported), typed on
//     physical `RegNum`s (this tier has only `ValueId`s), and breaks copy cycles with `xchg`,
//     which wasm has no instruction for. wasm breaks a cycle by staging through a SCRATCH
//     local per valtype (v1's `WasmCopyEmitter` did exactly this: `hasXchg = false`). So the
//     algorithm is re-implemented here over local indices with scratch-local cycle breaking —
//     the SAME standard parallel-move algorithm, a different cycle primitive.
//   • `PhiEdgeView.resolve` — its `PhiEdgeConsumer` context enum names only the three
//     register-allocator consumers; the edge/arg pairing is resolved locally instead so a
//     wasm arity mismatch reports against wasm, not a mislabelled `ssaDestruction`.
//
// ⭐ CONTROL FLOW IS A `loop`+`br_table` STATE MACHINE, NOT A RELOOPER. Each block gets a
// dispatch index; a single outer `loop` wrapped in one `block` per basic block re-enters and
// `br_table`s to the current block. It handles ANY reducible CFG shape with no structural
// analysis. Reference: v1 `maxon-selfhosted/Compiler/Targets/Wasm/MirToWasm.maxon`
// `emitStructuredCfg` (:2004) and its phi-copy handling (:2092-2183) — the shapes are taken;
// v1's 42-func Preview2 import table and its heap/print/async paths are not (this slice needs
// only `exit-with-code`).
//
// SCOPE grows the way v1's did: scalar core, then f64, then top-level-`var` globals + String
// literals (`.data`/`.rdata` active segments, `print`), the HEAP — `osAllocPages` →
// `memory.grow`, the narrow BYTE load/store band a String's per-byte access needs, and the leak gate
// (`__mm_leak_check`) on the exit path — scalar ERROR HANDLING (`throws`/`try`/`throw`/`panic`), and now
// CONSTRAINED-TYPE-PARAMETER DISPATCH: a `.rdata` slot naming a function (a witness-table method, a layout
// descriptor's `destroyFunc@40`/`copyFunc@32`) is baked with the callee's funcref-TABLE INDEX rather than the
// `.text` VA the x64 writers bake, and the fused witness call reads it back and `call_indirect`s through it
// (`bakeFuncTableIndexRelocs` / `emitWitnessCall`) — and, since W3, a PANIC RUNTIME: `appendPanicRuntime`
// writes the message to WASI stderr and traps, which is the whole of what a target with no walkable frame
// chain can do in-program (read its header for what the host supplies and why nothing else can).
// The allocator/refcount/String builders themselves are Std-IR runtime functions emitted through the
// ordinary function path, not hand-written here.
//
// ⭐ THE ERROR-HANDLING ABI — shv2's native DUAL-REGISTER model mapped onto wasm MULTI-VALUE. A
// throwing function returns its primary value in R8/x0 AND an i64 error flag in R10/x9 on the native
// backends; wasm has no second return register, so the flag rides a SECOND RESULT in the function's
// multi-value signature: a value-returning throwing function is `(params) -> (resultVt, i64)`, a
// void-returning one `(params) -> (i64)`. There is no separate success-`ret` path to augment — the
// frontend routes EVERY exit of a throwing function through `errorReturn` (a normal return carries a
// zero flag, a `throw` a non-zero one), so `ret`/`retVoid` never appear inside a throwing function and
// `emitRet`/`emitRetVoid` are untouched. `tryCall` reads both results off the callee's multi-value
// return (flag on top of the stack); `osExit` (from `panic`) calls `exit-with-code` and traps. What
// remains beyond the backend (`sugar` ops and the narrow-integer `as` cast) still `panic` in the
// exhaustive matches below — unreachable given the spec-runner gating, mirroring the dead-but-exhaustive
// native target arms.

// Wasm indices/counts are u32 in the format; this backend uses A1's exported `Wasm32Index`
// (= int(0 to u32.max)) and `Wasm32IndexArray` for every function/type/local/dispatch index,
// so the values flow into the `WasmBinary` seam's params with no cast. The narrowings are the two
// places a value crosses in from an IR-tier id space: the `ValueId → local index` boundary, and
// `dispatchIndexOf`'s read of the shared `BlockRefIndex` table. Both always fit u32.

// The cycle-break scratch local reserved for each valtype that appears among a function's
// block-args — the local a phi-copy cycle stages through (wasm has no register exchange).
typealias ScratchLocalMap = Map with (WasmValType, Wasm32Index)

// The set of valtypes present among a function's block-args, used to reserve exactly the
// scratch locals a phi cycle in that function could need.
typealias PhiValTypeSet = Set with WasmValType

// Callee name → its parameter valtypes, in declaration order. The one per-callee map this backend
// still builds: `funcParamValTypes` FOLDS a signature into a fresh array, so memoizing it is a real
// saving, where a map of func INDICES or of RETURN TYPES was storing something `FunctionNameIndex`
// already answers in two O(1) steps (see `wasmFuncIdxOf` — both are gone, A2l).
typealias CalleeParamTypesMap = Map with (ByteArray, WasmValTypeArray)

// An indirect call's ENCODED FUNCTYPE (its `encodeFuncType` bytes) → the interned wasm functype index for
// that signature. Keyed by the SIGNATURE, not the arg count, because a function value now carries floats
// (P1.5 #78): `(f64) -> f64` and `(i64) -> i64` are distinct functypes of the same arity, and
// `call_indirect` runtime-checks the funcref against exactly the declared type. Each call's signature comes
// from the `resultType`/`argFloatMask` the Std op carries (`indirectCallArgValType` reads the one
// per-argument bit; the trailing uniform-ABI env pointer is a plain i64), plus the trailing i64
// error flag for a THROWING one. THREE ops
// populate it: `callIndirect`, and the two fused witness calls (P1.7a slice 2b-iv-B), whose callee is a
// table index loaded out of a witness-table method slot. Built once per module — pre-interned into the
// WasmModuleBuilder before body emission — and read by each emitter, which recovers the index by the SAME
// key without mutating the shared builder mid-emit.
typealias IndirectCallTypeIdxMap = Map with (ByteArray, Wasm32Index)

// FOUR functions are imported, in this fixed order — so their func indices are the constants
// below and every DEFINED function is offset by `WasmImportCount`. `buildWasmCoreModule` MUST
// `addImportFunc` them in exactly this order for the indices to hold; `wasmFuncIdxOf`
// derives each defined function's index as `WasmImportCount + position` on the same assumption. The
// component embed maps imports by NAME, so their ORDER is otherwise free — only this
// index bookkeeping must be exact.
//   0  wasi:cli/exit@0.2.6 exit-with-code                              (param i32) -> ()
//   1  wasi:cli/stdout@0.2.6 get-stdout                               () -> (result i32)
//   2  wasi:io/streams@0.2.6 [method]output-stream.blocking-write-and-flush  (i32,i32,i32,i32) -> ()
//   3  wasi:cli/stderr@0.2.6 get-stderr                               () -> (result i32)
//
// ⚠ `get-stderr` is APPENDED, not slotted in beside its stdout twin, for the reason a `StdOp` variant
// is appended at the end of its band: the three indices above are read from a dozen emit sites and a
// renumber is invisible at every one of them — the module would still validate and would call the
// wrong import. Appending costs only the ONE derived offset (`WasmImportCount`), which every defined
// function's index already goes through.
let WasmImportCount = 4 as Wasm32Index
let ExitImportFuncIdx = 0 as Wasm32Index
let GetStdoutImportFuncIdx = 1 as Wasm32Index
let BlockingWriteFlushImportFuncIdx = 2 as Wasm32Index
let GetStderrImportFuncIdx = 3 as Wasm32Index

// ⭐ The wasm half of `StdLoweringShared.posixStreamFd` — which `wasi:cli` accessor hands over the
// output-stream a write targets (W35). Exhaustive over `OsOutputStream` for that door's reason: a third
// stream must fail to compile here rather than silently take one of these two.
function wasmStreamAccessorImportFuncIdx(stream OsOutputStream) returns Wasm32Index
	return match stream 's'
		standardOutput gives GetStdoutImportFuncIdx
		standardError gives GetStderrImportFuncIdx
	end 's'
end 'wasmStreamAccessorImportFuncIdx'

// The canonical-ABI RETURN AREA `osWriteStdout` hands `blocking-write-and-flush` its
// `result<_, stream-error>` into. It sits in the low scratch region BELOW the `.data` base
// (1024) and within page 0, so it never overlaps real data. The write result is ignored
// (fire-and-forget), so the area is written but never read — 256 leaves ample room to the
// data base. Mirrors v1's `wasiRetAreaBase` (MirToWasm.maxon:324).
let WasmRetAreaBase = 256 as Imm32

// `blocking-write-and-flush(handle, ptr, len, retArea)` takes four i32 params — the stream handle,
// the contents pointer, the contents length, and the canonical-ABI return area.
let WasmWriteFlushParamCount = 4

// The linear-memory address the top-level-`var` `.data` image is laid at. Low memory below it is
// a NULL GUARD — no global's address is ever 0 — matching v1's convention and keeping any future
// null/None sentinel distinct from real data. 8-aligned (1024 = 128·8), so every word64 global
// slot lands naturally aligned; the exact value is otherwise free (nothing else in this slice
// touches linear memory). A `globalAddr` resolves to `base + the global's `.data` offset`.
let WasmDataBaseOffset = 1024 as Wasm32Index

// A wasm linear-memory page is 64 KiB. The memory's declared minimum must cover the whole `.data`
// image (`base + size`); the page size is a power of two, so rounding up is a shift, not a divide
// (a divide would desugar to a throwing checked-division call — see the throwing-division rung).
let WasmPageSizeLog2 = 16
let WasmPageSizeMask = 0xFFFF as ByteCount

// `memory.grow` returns the previous page count, or this sentinel — -1 as an i32, which
// `emitOsAllocPages` sign-extends to -1 in i64 — on OOM. The allocator lowering tests for it and
// traps.
let WasmMemoryGrowOom = -1 as ParsedInt

// F2 — the atomic word's memarg offset. An atomic names the address it operates on and nothing else:
// unlike `loadIndirect`/`storeIndirect`, whose Std op carries a field displacement, `StdOp.atomicCas` and
// `StdOp.atomicRmw` have no offset field at all, so the memarg is always zero. Named rather than a bare 0
// so the reason it can never be anything else is stated where the instruction is written.
let WasmAtomicWordOffset = 0 as Wasm32Index

// F2 — the token `currentThreadToken` answers on a lane with exactly one thread. It is `1` because the op's
// contract is "per-OS-thread stable and NON-ZERO"; the value is otherwise arbitrary, and that is precisely
// why it is named rather than spelled as a bare literal at the emitter.
let WasmSingleThreadToken = 1 as ParsedInt

// The minimum page count a memory must declare to hold a `.data` image ending at `base +
// dataSize`, rounded up to whole 64 KiB pages. `base` is a positive constant, so the count is
// always at least one — the WASI `run` skeleton requires a memory export whether or not the
// program has any global.
function wasmMemoryMinPages(base Wasm32Index, dataSize ByteCount) returns Wasm32Index
	let endByte = base + dataSize
	return ((endByte + WasmPageSizeMask) shr WasmPageSizeLog2) as Wasm32Index
end 'wasmMemoryMinPages'

// The `run` result value pushed after `call $exit`: `exit-with-code` never returns, so this
// i32 is unreachable, but the validator requires the `(result i32)` on the stack at the end.
let RunOkResult = 0 as Imm32

// The entry function the synthesized `$run` calls. `main` returns `ExitCode`; `$run` wraps it
// to i32 and hands it to `exit-with-code`.
let WasmMainFunctionName = b"main"

// The Preview2 import and the component export names — the exact interface identifiers the
// golden component skeleton was built and run against (CONTRACT §5).
let WasiExitModuleName = b"wasi:cli/exit@0.2.6"
let WasiExitFieldName = b"exit-with-code"
let WasiRunExportName = b"wasi:cli/run@0.2.6#run"
let WasmMemoryExportName = b"memory"

// The Preview2 stdout-write imports (P1.2 wave A — `print`). `osWriteStdout` gets the stdout
// output-stream handle via `wasi:cli/stdout` `get-stdout`, then writes+flushes via
// `wasi:io/streams` `[method]output-stream.blocking-write-and-flush`. The versioned interface
// ids and the `[method]…` field spelling are what `wasm-tools component new` matches against the
// WIT world — verbatim from v1 (`MirToWasm.maxon:1134-1153`).
let WasiStdoutModuleName = b"wasi:cli/stdout@0.2.6"
let WasiGetStdoutFieldName = b"get-stdout"
let WasiStreamsModuleName = b"wasi:io/streams@0.2.6"
let WasiBlockingWriteFlushFieldName = b"[method]output-stream.blocking-write-and-flush"

// The Preview2 STDERR accessor (W3 — the panic runtime). Its stream is written through the SAME
// `blocking-write-and-flush` method above: a `wasi:io/streams` output-stream is one type whichever
// `wasi:cli` accessor handed it over, so the panic path needs a new accessor and no new writer.
// `wasi:cli/stderr@0.2.6` is already in the WIT world the component is built against
// (`vendor/wasi-wit/world.wit`), so nothing outside this file changes to reach it.
let WasiStderrModuleName = b"wasi:cli/stderr@0.2.6"
let WasiGetStderrFieldName = b"get-stderr"

// The imports' backtrace names. A WIT field name is not one — `[method]output-stream.blocking-write-
// and-flush` is an interface path, and wasmtime would print it verbatim in a frame line — so each
// import carries a short alias for the "name" section instead. They match v1's (`MirToWasm.maxon:1470-
// 1478`), which is what makes a wasm backtrace read the same under either compiler.
let WasiExitDebugName = b"exit"
let WasiGetStdoutDebugName = b"get_stdout"
let WasiBlockingWriteFlushDebugName = b"blocking_write_and_flush"
let WasiGetStderrDebugName = b"get_stderr"

// The `.rdata` image (String-literal records + blobs) is laid in linear memory immediately
// after the `.data` image, rounded up to 8 so every 8-byte record field lands naturally
// aligned. The base is otherwise free — nothing else in this slice touches linear memory
// above the `.data` image.
let WasmRdataAlignment = 8 as ByteCount

// ==========================================================================
// Seam 2 — the whole-module entry (the ONLY external symbol)
// ==========================================================================

// Lower a fully-compiled Std module to a WASI-Preview2 CORE wasm module. The module imports
// `exit-with-code`, defines every function in `module.functions` under the identity-local
// model, synthesizes the `wasi:cli/run@0.2.6#run` entry (`call $main; i32.wrap_i64; call
// $exit; i32.const 0`), and exports `memory` + `run`. Deterministic: output is driven entirely
// by module/block/op/arg ORDER, never by map iteration, so worker-count byte-identity holds.
export function buildWasmCoreModule(module StdModule, globalData GlobalDataTable, checkLeaks bool, initGlobals bool, funcNames FunctionNameIndex) returns ByteArray
	let calleeParamTypes = buildCalleeParamTypesMap(funcNames)

	var builder = WasmModuleBuilder.create()

	// The WASI import functypes are interned FIRST (their indices are otherwise free but must precede any
	// interning that assumes them). Do it before pre-interning the indirect-call functypes below so the
	// type-section order stays deterministic.
	appendWasiImports(builder)

	// Pre-intern one wasm functype per distinct indirect-call SIGNATURE, so `emitCallIndirect` (and the two
	// witness emitters) read the type index out of a map instead of mutating the shared builder mid-body.
	//
	// ⭐ **THE TABLE IS ALSO NEEDED WHEN A `.rdata` SLOT NAMES A FUNCTION, EVEN IF NO OP IS AN INDIRECT
	// CALL.** A witness-table method slot and a layout descriptor's `destroyFunc@40`/`copyFunc@32` are baked
	// with a TABLE INDEX (`bakeFuncTableIndexRelocs`), so a module holding one must declare the table those
	// indices index into — the ops that read the slot back live in a runtime body that DCE may have kept for
	// a different reason. Gating on the op scan alone would ship an index into a table that does not exist.
	let indirectCallTypeIdx = buildIndirectCallTypeIdxMap(module, builder: builder)
	if indirectCallTypeIdx.count() > 0 or globalData.pendingRdataRelocs.count() > 0 'usesFuncrefTable'
		builder.enableFuncrefTable()
	end 'usesFuncrefTable'

	// The two linear-memory images, rendered ONCE in `GlobalDataTable`'s layout order
	// (deterministic — no map iteration):
	//   • `.data`  — the top-level-`var` slots, at `WasmDataBaseOffset`. Empty for a program with
	//     no top-level `var`.
	//   • `.rdata` — the String-literal records + blobs, at `rdataBase` (immediately after the
	//     `.data` image, 8-aligned). Empty for a program with no String literal.
	// Both are shared by the per-function emitters (a `globalAddr` resolves against `.data`, an
	// `rdataAddr` against `.rdata`) and by the module's memory + data sections.
	let dataImage = globalData.dataSectionImage()
	let rdataBase = wasmRdataBase(WasmDataBaseOffset, dataSize: dataImage.count())

	// A String literal's record carries `buffer@0` = the ABSOLUTE address of its byte blob, which
	// only exists once `rdataBase` is fixed. wasm is fixed-base, so that address is compile-time
	// computable (`rdataBase + blobOffset`); bake it into the `.rdata` IMAGE now, exactly as the
	// PE writer patches `.rdata` before writing it (`PeWriter.patchStringBufferFixups`).
	var rdataImage = globalData.rdataImage()
	applyStringBufferFixups(rdataImage, globalData: globalData, rdataBase: rdataBase)
	bakeFuncTableIndexRelocs(rdataImage, globalData: globalData, funcNames: funcNames)

	// The WASI imports were added FIRST (above), in the order the `*ImportFuncIdx` constants fix, so every
	// defined function gets the index `wasmFuncIdxOf` computes (`WasmImportCount + position`). Order
	// among imports is otherwise free (the component embed maps by name), but the func-index bookkeeping
	// depends on it.

	// Defined functions in the order `wasmFuncIdxOf` assumes — walked off the INDEX'S OWN ARRAY rather than
	// the module's, so the order the func indices are DERIVED from and the order they are EMITTED in are the
	// same array rather than two that must be kept in step (A2l).
	for func in funcNames.functions 'eachFunc'
		var emitter = WasmFuncEmitter.create(module, func: func, globalData: globalData, dataBase: WasmDataBaseOffset, rdataBase: rdataBase, funcNames: funcNames, calleeParamTypes: calleeParamTypes, indirectCallTypeIdx: indirectCallTypeIdx)
		emitter.emit()
		let typeIdx = builder.internFuncType(funcParamValTypes(func), results: funcSignatureResultValTypes(func))
		_ = builder.addFunction(typeIdx, localTypes: emitter.localTypes, body: emitter.body.bytes(), debugName: func.name)
	end 'eachFunc'

	// The two SYNTHETIC functions, appended in the order `wasmPanicFuncIdx` fixes: `mrt_panic` first
	// (its index is read by every panic site, which was emitted above), then the entry stub.
	appendPanicRuntime(builder, funcNames: funcNames)
	let runFuncIdx = appendRunEntry(builder, module: module, funcNames: funcNames, checkLeaks: checkLeaks, initGlobals: initGlobals)

	// The memory must cover BOTH images; `.rdata` sits above `.data`, so `rdataBase + rdataSize`
	// is the high-water mark (and `rdataBase >= WasmDataBaseOffset` even with no globals, so the
	// WASI `run` skeleton's mandatory memory export is always at least one page). Each non-empty
	// image is laid as its own active segment at its base — an empty image emits none.
	builder.exportMemory(WasmMemoryExportName, minPages: wasmMemoryMinPages(rdataBase, dataSize: rdataImage.count()))
	if dataImage.count() > 0 'hasGlobals'
		builder.addDataSegment(WasmDataBaseOffset, bytes: dataImage)
	end 'hasGlobals'
	if rdataImage.count() > 0 'hasRdata'
		builder.addDataSegment(rdataBase, bytes: rdataImage)
	end 'hasRdata'
	builder.exportFunc(WasiRunExportName, funcIdx: runFuncIdx)

	return builder.finish()
end 'buildWasmCoreModule'

// Add the four WASI imports in the order the `*ImportFuncIdx` constants pin: `exit-with-code`
// (0), `get-stdout` (1), `blocking-write-and-flush` (2), `get-stderr` (3). `exit-with-code` takes one
// i32 (the status) and returns nothing; each stream accessor takes nothing and returns the i32 stream
// handle; `blocking-write-and-flush` takes (handle, ptr, len, retArea) — four i32 — and returns nothing.
//
// All four are imported UNCONDITIONALLY, including by a program that never panics and never prints. A
// wasm import costs a name pair in the import section and nothing at run time (the host resolves it
// whether or not a `call` reaches it), whereas making one conditional would put the `*ImportFuncIdx`
// constants — and therefore `WasmImportCount`, and therefore EVERY defined function's index and every
// funcref-table slot baked into `.rdata` — behind a whole-module scan for a single op.
function appendWasiImports(builder WasmModuleBuilder)
	let exitTypeIdx = builder.internFuncType(singletonValTypes(WasmValType.i32), results: WasmValTypeArray.create())
	_ = builder.addImportFunc(WasiExitModuleName, fieldName: WasiExitFieldName, typeIdx: exitTypeIdx, debugName: WasiExitDebugName)

	// Both stream accessors have the same signature, so `internFuncType` hands them one type index.
	let getStreamTypeIdx = builder.internFuncType(WasmValTypeArray.create(), results: singletonValTypes(WasmValType.i32))
	_ = builder.addImportFunc(WasiStdoutModuleName, fieldName: WasiGetStdoutFieldName, typeIdx: getStreamTypeIdx, debugName: WasiGetStdoutDebugName)

	// `blocking-write-and-flush(handle, ptr, len, retArea)` — four i32 params, no result.
	var writeFlushParams = WasmValTypeArray.create()
	for _ in 0 upto WasmWriteFlushParamCount 'eachParam'
		writeFlushParams.push(WasmValType.i32)
	end 'eachParam'
	let writeFlushTypeIdx = builder.internFuncType(writeFlushParams, results: WasmValTypeArray.create())
	_ = builder.addImportFunc(WasiStreamsModuleName, fieldName: WasiBlockingWriteFlushFieldName, typeIdx: writeFlushTypeIdx, debugName: WasiBlockingWriteFlushDebugName)

	_ = builder.addImportFunc(WasiStderrModuleName, fieldName: WasiGetStderrFieldName, typeIdx: getStreamTypeIdx, debugName: WasiGetStderrDebugName)
end 'appendWasiImports'

// Bake each String literal's `buffer@0` field into the `.rdata` image: overwrite the record's
// first 8 bytes with the blob's absolute linear-memory address (`rdataBase + blobOffset`) in the
// low 4 bytes, the high 4 left zero — the slot is 8 bytes but a wasm address is an i32. The
// `.data`→`.data` twin of `PeWriter.patchStringBufferFixups`, over an absolute (fixed-base) wasm
// address rather than an `ImageBase`-relative VA. Deterministic: `stringBufferFixups` is in
// registration order.
function applyStringBufferFixups(rdataImage ByteArray, globalData GlobalDataTable, rdataBase Wasm32Index)
	for fixup in globalData.stringBufferFixups 'each'
		let recordOffset = globalData.rdataOffsetOf(fixup.recordLabel)
		let blobAddr = wasmLinearAddress(rdataBase, byteOffset: globalData.rdataOffsetOf(fixup.blobLabel))
		patchQword(rdataImage, offset: recordOffset + StringBufferOffset, value: blobAddr as MachineWord)
	end 'each'
end 'applyStringBufferFixups'

// ⭐ **BAKE EVERY `.rdata` SLOT THAT NAMES A FUNCTION — AS A WASM TABLE INDEX** (P1.7a slice 2b-iv-B). The
// wasm twin of `bakeFuncAbs64Relocs`, and the whole of what makes witness tables and managed-opaque-`T`
// `Array` descriptors work on this target: **the blob LAYOUT is target-agnostic and only the VALUE in the
// slot differs.** The x64 PE/ELF writers bake the target's absolute `.text` VA, because their reader
// DEREFERENCES it (`call qword [witness + 24 + 8*i]`); wasm has no code addresses at all, so its reader is a
// `call_indirect` through the module's one funcref table — and the value the slot must hold is therefore the
// callee's TABLE INDEX. `table[i] == funcIdx i` (`emitElementSection`), so that index IS `wasmFuncIdxOf`'s
// answer, known here from `module.functions` order alone with no writer-stage layout to wait for. v1 does
// exactly this (`patchFuncAbs64InRdataWasm`).
//
// ⚠ **A ZERO SLOT IS NOT INERT ON WASM.** Skipping a relocation would leave 0, which is a VALID table index
// naming the first import — so the call would dispatch to `exit-with-code` and trap "indirect call type
// mismatch" rather than fault. That is why a callee with no table index PANICS naming it (a DCE-root gap,
// exactly as `bakeFuncAbs64Relocs`'s missing-debug-symbol arm does) instead of being passed over.
//
// It runs beside `applyStringBufferFixups` for that function's reason — both patch the `.rdata` IMAGE before
// it becomes a data segment — and MUST precede `addDataSegment(rdataBase, rdataImage)`. Empty for every
// program that conforms nothing to an interface and holds no managed-opaque-`T` array, so those stay
// byte-identical.
function bakeFuncTableIndexRelocs(rdataImage ByteArray, globalData GlobalDataTable, funcNames FunctionNameIndex)
	for reloc in globalData.pendingRdataRelocs 'each'
		let funcIdx = try wasmFuncIdxOf(funcNames, callee: reloc.funcName) otherwise panic("bakeFuncTableIndexRelocs: .rdata slot '{reloc.rdataLabel}'+{reloc.offsetInLabel} references function '{String.from(reloc.funcName)}', which is in no wasm function index — it was never installed (a DCE-root gap where the slot's owner was built), so it has no table slot to name")
		// The slot's ADDRESS comes from the shared `rdataFuncSlotOffset` the x64 baker uses, because only the
		// VALUE below is target-specific — see that function.
		patchQword(rdataImage, offset: rdataFuncSlotOffset(globalData, reloc: reloc), value: funcIdx)
	end 'each'
end 'bakeFuncTableIndexRelocs'

// The `.rdata` base: the first 8-aligned linear-memory address at or after the end of the
// `.data` image. `WasmDataBaseOffset` is itself 8-aligned, so a program with no top-level `var`
// puts `.rdata` at `WasmDataBaseOffset`.
function wasmRdataBase(dataBase Wasm32Index, dataSize ByteCount) returns Wasm32Index
	return alignUp(dataBase + dataSize, alignment: WasmRdataAlignment) as Wasm32Index
end 'wasmRdataBase'

// ⭐⭐ **`mrt_panic` ON WASM — THE THIRD IMPLEMENTATION OF ONE CONTRACT, AND THE ONLY ONE THAT PRINTS
// NO FRAMES.**
//
// The contract is the two native runtimes' (`X64Runtime.buildPanicChunk`,
// `Arm64PanicRuntime.buildArm64PanicChunk`): take the address of a NUL-terminated, newline-suffixed
// `panic at <file>:<line>: …` line, print it to stderr, print `Stack trace:` and its frames, and end
// the process with `PanicExitCode`. This one does the FIRST half in the program and cannot do the
// second half at all, so it hands the second half to the host and says so:
//
//   * **THE FRAMES.** A native walk follows the saved-frame-pointer chain the prologues build
//     (`BacktraceFormat.FrameOffSavedFramePointer`). **wasm has no such chain and cannot be given
//     one** — the call stack is the ENGINE's, not addressable memory, and no wasm instruction reads
//     it. So the runtime does not walk: it executes `unreachable`, and wasmtime unwinds its own trap
//     and prints one frame line per wasm frame, symbolized from the "name" custom section
//     (`WasmBinary.emitNameSection`). v1 reached the identical conclusion for the identical reason —
//     it intercepts the shared `mrt_panic` and stubs `mrt_panic_print_frame` to a literal no-op
//     (`MirToWasm.maxon:1706-1715`, `emitWasmPanic` at `:3700`).
//
//   * **THE EXIT CODE.** A trap is not an exit, so this function never reaches `exit-with-code` and the
//     process status is whatever the host spends on a trap (wasmtime: 134). `PanicExitCode` is
//     therefore not written here — the ONE place on this target where the number cannot be spent, and
//     the reason `SpecTestRunner.wasmPanicReport` puts it back.
//
// ⭐ **WHY A FUNCTION AND NOT AN INLINE SEQUENCE AT EACH SITE.** The NUL scan is a loop, and a program
// panics from as many sites as it has range guards (`InsertRangeChecks` puts one on every ranged
// assignment) — so inlining would copy a `block`/`loop` into every one of them and give every enclosing
// function two more locals. The native backends have exactly one `mrt_panic` chunk for the same reason.
//
// The MESSAGE contract is byte-identical to theirs, which is what lets the two panic ops share this one
// entry point: both a baked `.rdata` blob (`StringRuntime.stringBlobBytes` NUL-terminates it) and an
// interpolated buffer (`Parser.renderedPanicMessagePointer` — the slab zeroes the byte past the payload)
// arrive as a C string.
function appendPanicRuntime(builder WasmModuleBuilder, funcNames FunctionNameIndex)
	var body = WasmBody.create()

	// param 0 = the message pointer; local 1 = the scan cursor, which ends at the NUL so that
	// `cursor - ptr` IS the byte length. One extra local, no separate length counter.
	body.localGet(WasmPanicMsgPtrLocal)
	body.localSet(WasmPanicCursorLocal)

	body.beginBlock()
	body.beginLoop()
	body.localGet(WasmPanicCursorLocal)
	body.i32Load8U(0)
	body.i32Eqz()
	// Depth 1 is the enclosing `block` (depth 0 is the `loop`, which would re-enter): leave the scan
	// the moment the byte under the cursor is the terminator.
	body.brIf(WasmPanicScanBreakDepth)
	body.localGet(WasmPanicCursorLocal)
	body.i32Const(1)
	body.i32Add()
	body.localSet(WasmPanicCursorLocal)
	body.br(WasmPanicScanContinueDepth)
	body.endOp()
	body.endOp()

	// `blocking-write-and-flush(get-stderr(), ptr, cursor - ptr, retArea)` — the same four-operand
	// shape and the same fire-and-forget return area as `emitOsWriteStdout`, over the stderr handle.
	body.call(GetStderrImportFuncIdx)
	body.localGet(WasmPanicMsgPtrLocal)
	body.localGet(WasmPanicCursorLocal)
	body.localGet(WasmPanicMsgPtrLocal)
	body.i32Sub()
	body.i32Const(WasmRetAreaBase)
	body.call(BlockingWriteFlushImportFuncIdx)

	// TRAP. This is the frame wasmtime reports as frame 0, and it is what makes every frame ABOVE it
	// reportable at all.
	body.unreachable()

	let typeIdx = builder.internFuncType(singletonValTypes(WasmValType.i32), results: WasmValTypeArray.create())
	let funcIdx = builder.addFunction(typeIdx, localTypes: singletonValTypes(WasmValType.i32), body: body.bytes(), debugName: PanicName)
	if funcIdx != wasmPanicFuncIdx(funcNames) 'indexDrift'
		panic("appendPanicRuntime: `{String.from(PanicName)}` landed at wasm function index {funcIdx}, but every panic site was emitted calling {wasmPanicFuncIdx(funcNames)} — the synthetic functions are no longer appended in the order `wasmPanicFuncIdx` derives")
	end 'indexDrift'
end 'appendPanicRuntime'

// ⭐ **WHERE `mrt_panic` SITS, DERIVED — because its callers are emitted BEFORE it is added.** Every
// panic site needs the index while `buildWasmCoreModule` is still walking the module's own functions,
// so the index cannot be the one `addFunction` returns. It is the FIRST index past the defined
// functions because `appendPanicRuntime` is the FIRST synthetic appended, and `appendPanicRuntime`
// asserts that rather than assuming it — a silent disagreement here would call the entry stub with a
// message pointer.
function wasmPanicFuncIdx(funcNames FunctionNameIndex) returns Wasm32Index
	return (WasmImportCount + funcNames.functions.count()) as Wasm32Index
end 'wasmPanicFuncIdx'

// `mrt_panic`'s locals. Local 0 is its one parameter (identity-local model: a wasm function's params
// occupy the first local indices), local 1 the scan cursor.
let WasmPanicMsgPtrLocal = 0 as Wasm32Index
let WasmPanicCursorLocal = 1 as Wasm32Index

// The two branch depths inside the NUL scan, relative to the innermost `loop`: 0 re-enters the loop,
// 1 exits the `block` that wraps it. Named because a wasm branch depth is a bare integer that no
// validator can tell from any other, and swapping these two makes the scan an infinite loop.
let WasmPanicScanContinueDepth = 0 as Wasm32Index
let WasmPanicScanBreakDepth = 1 as Wasm32Index

// Synthesize the component entry `wasi:cli/run@0.2.6#run() -> i32`: run `main`, hand its
// exit code to `exit-with-code`, and leave the ok-discriminant on the stack. Returns the
// entry's wasm function index (for the export).
function appendRunEntry(builder WasmModuleBuilder, module StdModule, funcNames FunctionNameIndex, checkLeaks bool, initGlobals bool) returns Wasm32Index
	let mainFuncIdx = try wasmFuncIdxOf(funcNames, callee: WasmMainFunctionName) otherwise panic("buildWasmCoreModule: no `main` function in the module — the wasm `run` entry has nothing to call")
	let mainReturnValType = mainReturnValueType(module)

	var runBody = WasmBody.create()

	appendModuleInitCall(runBody, funcNames: funcNames, initGlobals: initGlobals)

	runBody.call(mainFuncIdx)

	let afterCleanupVt = appendGlobalCleanupGate(runBody, exitCodeValType: mainReturnValType, funcNames: funcNames, initGlobals: initGlobals)

	// THE LEAK GATE — the sibling of the native backends' entry-stub gate
	// (BackendDispatch.prependEntryStub). When the MM runtime installed `__mm_leak_check`, main's
	// exit code is routed through it before exit; a leaked program comes back as 101. `exit-with-code`
	// takes an i32, so the resulting code — i64 after the gate, else main's own return width — is
	// wrapped last. `main` returns `ExitCode` (i64 in the corpus); a narrower ExitCode is already i32.
	// ⚠ Through `coerceOnStack` rather than a hand-rolled `i32WrapI64`, because "how does this backend
	// change a value's width?" is ONE fact and this used to be a third spelling of it. The two answers
	// happened to agree; nothing made them, and the hand-rolled one was the weaker of the two — it
	// passed an f64 through UNTOUCHED where the shared door panics naming the lowering bug.
	let exitCodeVt = appendLeakGate(runBody, exitCodeValType: afterCleanupVt, funcNames: funcNames, checkLeaks: checkLeaks)
	coerceOnStack(runBody, from: exitCodeVt, to: WasmValType.i32)
	runBody.call(ExitImportFuncIdx)
	runBody.i32Const(RunOkResult)

	// ⭐ **ITS DEBUG NAME IS `mrt_start`, AND THAT IS A DESCRIPTION, NOT A DISGUISE (W3).** Its EXPORT
	// name is and stays `wasi:cli/run@0.2.6#run` — the component contract, checked by the host. The name
	// section names a different thing: what the function IS, for a human reading a backtrace. And what
	// this function is, is the entry stub — the direct sibling of `BackendDispatch.prependEntryStub`,
	// which this one's own leak-gate comment already cites, doing the same four things in the same order
	// (module init, call `main`, global cleanup, leak gate, exit) and sitting in the same place: the
	// outermost frame, the one every `Stack trace:` in the corpus ends at. Calling it `run` here — v1's
	// choice, forced because v1's wasm ALSO had a real `mrt_start` above it, so its runner had to elide
	// `run` as "the component-model analog of `_start`" — would leave shv2's trace ending at a frame the
	// corpus does not name and would require SYNTHESIZING the `in mrt_start` line, which would be a
	// disguise. Reusing `EntryPointName` instead means the frame is reported, not invented, and the
	// entry stub's name is spelled in exactly one place for all three backends.
	let runTypeIdx = builder.internFuncType(WasmValTypeArray.create(), results: singletonValTypes(WasmValType.i32))
	return builder.addFunction(runTypeIdx, localTypes: WasmValTypeArray.create(), body: runBody.bytes(), debugName: EntryPointName)
end 'appendRunEntry'

// ⭐ **FILL EVERY EAGER managed global's `.data` SLOT BEFORE `main` (P1.7 slice 2a)** — a `static`
// member's is filled on first access instead (see `ModuleInit`) — the sibling of the
// native stubs' `appendModuleInitCall`. `__module_init` takes no argument and returns nothing, so it
// leaves the operand stack exactly as it found it (empty). `initGlobals` is
// `RuntimeUsage.usesManagedGlobals`, read for `appendLeakGate`'s stated reason: installation is decided in
// one place, and a missing function under that bit is an impossible state that PANICS rather than silently
// leaving every slot null.
function appendModuleInitCall(runBody WasmBody, funcNames FunctionNameIndex, initGlobals bool)
	if not initGlobals 'noManagedGlobals'
		return
	end 'noManagedGlobals'

	runBody.call(try wasmFuncIdxOf(funcNames, callee: ModuleInitName) otherwise panic("appendModuleInitCall: `RuntimeUsage.usesManagedGlobals` says this program declares a managed top-level `var`, so `__module_init` must be in this module — its absence means the ROOT was pruned (see DeadFunctionElimination's root set), which would leave every eager managed global's slot null"))
end 'appendModuleInitCall'

// ⭐ **THE GLOBAL-CLEANUP GATE on the wasm exit path (P1.7 slice 2a)** — the sibling of the native stubs'
// `appendGlobalCleanupGate`, and the leak gate's exact twin one step earlier on the same path.
//
// It runs AFTER `main` and BEFORE the leak gate, and the order is the property, not a preference: the leak
// gate counts what is still allocated, so a global released after it reads as a leak (exit 101) — which is
// what `static-variables.md`'s `top-level-var-string-mutate-cross-function` gates.
//
// `__maxon_global_cleanup` is an ordinary i64→i64 Std function that hands `main`'s exit code straight
// back, so a narrower ExitCode is widened first and the stack holds an i64 afterwards. `initGlobals` is
// `RuntimeUsage.usesManagedGlobals`, read for `appendLeakGate`'s stated reason: installation is decided in
// one place, and a missing function under that bit is an impossible state that PANICS rather than silently
// emitting no gate.
//
// Returns the valtype now on the stack: i64 after the gate, else the code's own valtype.
function appendGlobalCleanupGate(runBody WasmBody, exitCodeValType WasmValType, funcNames FunctionNameIndex, initGlobals bool) returns WasmValType
	if not initGlobals 'noManagedGlobals'
		return exitCodeValType
	end 'noManagedGlobals'

	let cleanupIdx = try wasmFuncIdxOf(funcNames, callee: GlobalCleanupName) otherwise panic("appendGlobalCleanupGate: `RuntimeUsage.usesManagedGlobals` says this program declares a managed top-level `var`, so `__maxon_global_cleanup` must be in this module — its absence means the ROOT was pruned (see DeadFunctionElimination's root set), which would leak every managed global")
	coerceOnStack(runBody, from: exitCodeValType, to: WasmValType.i64)
	runBody.call(cleanupIdx)
	return WasmValType.i64
end 'appendGlobalCleanupGate'

// THE LEAK GATE on the wasm exit path (P1.0r), ported from the native `prependEntryStub`
// (BackendDispatch:205). When the MM runtime installed `__mm_leak_check`, the exit code (on the
// stack) is routed through it: it returns the code UNCHANGED, or LeakExitCode (101) when any
// allocation outlived the program — so a leaking heap program FAILS with 101 rather than passing
// invisibly. `__mm_leak_check` is an ordinary i64→i64 Std function, so a narrower ExitCode is widened
// to i64 first. Without the MM runtime the program cannot leak (nothing was allocated), so the gate
// is skipped and the code passes straight through — keeping the non-heap path byte-identical.
//
// ⚠ **`checkLeaks` IS `RuntimeUsage.usesHeap` — THE SAME BIT THE NATIVE GATES READ, AND IT IS NOT
// OPTIONAL HERE.** Whether a gate belongs and which func index to call are two different questions, and
// this used to answer BOTH from a func-index lookup of `__mm_leak_check`: a miss silently meant "no heap, no
// gate". That is safe only while nothing can take an installed `__mm_leak_check` back out — the premise
// dead-function elimination removed. Because nothing CALLS the leak check, it survives DFE only by being
// an explicit root; had that root ever been narrowed, x64 and arm64 would have failed LOUD at their
// entry-stub `call`/`bl` fixup while wasm alone silently emitted no gate, turning every exit-101 leak
// test green on this target only. So installation is read from the one place it is decided, and a
// missing function under `usesHeap` is an impossible state that PANICS.
//
// ⚠ The code it is handed is `main`'s only when the program has no managed global: the global-cleanup
// gate runs FIRST and passes the code through (P1.7 slice 2a), so this reads whatever that left.
//
// Returns the valtype now on the stack: i64 after the gate, else the code's own valtype.
function appendLeakGate(runBody WasmBody, exitCodeValType WasmValType, funcNames FunctionNameIndex, checkLeaks bool) returns WasmValType
	if not checkLeaks 'noHeap'
		return exitCodeValType
	end 'noHeap'

	let leakCheckIdx = try wasmFuncIdxOf(funcNames, callee: MmLeakCheckName) otherwise panic("appendLeakGate: `RuntimeUsage.usesHeap` says the MM runtime was installed, so `__mm_leak_check` must be in this module — its absence means the leak-gate ROOT was pruned (see DeadFunctionElimination's root set), which would silently disable the 101 leak gate on wasm")
	coerceOnStack(runBody, from: exitCodeValType, to: WasmValType.i64)
	runBody.call(leakCheckIdx)
	return WasmValType.i64
end 'appendLeakGate'

// The valtype of `main`'s return value. `main` must return a value (`ExitCode`) — a void
// `main` would leave the run entry nothing to pass to `exit-with-code`.
function mainReturnValueType(module StdModule) returns WasmValType
	for func in module.functions 'eachFunc'
		if func.name == WasmMainFunctionName 'isMain'
			match func.returnType 'rt'
				void then panic("buildWasmCoreModule: `main` returns void, but the wasm `run` entry needs an ExitCode to pass to exit-with-code")
				value(inner) then return wasmMachineValTypeOf(inner)
			end 'rt'
		end 'isMain'
	end 'eachFunc'
	panic("buildWasmCoreModule: no `main` function in the module")
end 'mainReturnValueType'

// ==========================================================================
// Module-level maps (built once, looked up O(1) — never iterated for output)
// ==========================================================================

// ⭐⭐ **A DEFINED FUNCTION'S WASM FUNCTION INDEX — DERIVED, NOT STORED (A2l).** Defined functions land at
// `WasmImportCount + position` because `buildWasmCoreModule` adds the imports first and then the functions
// in `module.functions` order, so the index a `call` needs IS the position `FunctionNameIndex` already
// resolves, plus a constant.
//
// It used to be a map of its own — `buildCalleeFuncIdxMap`, a bare last-wins `upsert` over the same array,
// resting on the uniqueness guarantee `FunctionNameIndex` states without saying so. That is the most
// dangerous of the ten sites that did: the VALUE is a POSITION, so a silent last-wins does not degrade an
// answer, it binds every `call` to the WRONG FUNCTION. The map is gone; the offset is one addition, and the
// key set is now provably the one the duplicate check ran over.
function wasmFuncIdxOf(funcNames FunctionNameIndex, callee ByteArray) returns Wasm32Index throws MapError
	return (WasmImportCount + (try funcNames.byName.get(callee))) as Wasm32Index
end 'wasmFuncIdxOf'

// callee name → its parameter valtypes, in declaration order. Used by `emitCall` to coerce each
// argument to the width the callee's parameter declares — an `i64` literal passed to an `ExitCode`
// (i32) parameter needs an `i32.wrap_i64`, which the native backends never emit (64-bit registers).
//
// The one per-callee map this backend still builds, and it takes the CHECKED index rather than the module
// so its key set is provably the duplicate-free one (see `FunctionNameIndex`'s header). It stays a map
// because `funcParamValTypes` builds a fresh ARRAY per callee — a real computation, read once per call op,
// where the deleted func-index and return-type maps each stored something reachable in two O(1) steps.
function buildCalleeParamTypesMap(funcNames FunctionNameIndex) returns CalleeParamTypesMap
	var map = CalleeParamTypesMap.create()
	for func in funcNames.functions 'eachFunc'
		map.upsert(func.name, value: funcParamValTypes(func))
	end 'eachFunc'
	return map
end 'buildCalleeParamTypesMap'

// Scan every live op for an INDIRECT CALL — a `callIndirect` or either fused witness call — and pre-intern
// one wasm functype per distinct SIGNATURE (see `IndirectCallTypeIdxMap`). Pre-interning here, BEFORE any
// body is emitted, lets each emitter look the type index up by the signature key instead of mutating the
// shared `builder` while it is threading bytes into a body. Returns the signature → type-index map; empty
// when the module makes no indirect call.
function buildIndirectCallTypeIdxMap(module StdModule, builder WasmModuleBuilder) returns IndirectCallTypeIdxMap
	var map = IndirectCallTypeIdxMap.create()
	for funcIdx in 0 upto module.funcCount() 'eachFunc'
		let func = module.getFunc(funcIdx)
		for blockRef in func.blockRefs 'eachBlock'
			let block = try module.blocks.get(blockRef) otherwise panic("buildIndirectCallTypeIdxMap: blockRef {blockRef} not in module.blocks")
			for opIdx in block.opRefs 'eachOp'
				let op = try module.ops.get(opIdx) otherwise panic("buildIndirectCallTypeIdxMap: opIdx {opIdx} not in module.ops")
				internIndirectCallTypeFor(op, map: map, builder: builder)
			end 'eachOp'
		end 'eachBlock'
	end 'eachFunc'
	return map
end 'buildIndirectCallTypeIdxMap'

// If `op` is one of the THREE indirect calls — a `callIndirect` or either fused witness call — intern the
// functype for its SIGNATURE into `map`; ignore any other op. The range arms lean on the band-append
// invariant: every StdOp variant is covered by name or by a named band, so a newly-appended one FAILS TO
// COMPILE here rather than being silently swept into an ignore arm. Only body ops carry one of the three
// (never a terminator), so scanning `block.opRefs` alone is complete.
function internIndirectCallTypeFor(op StdOp, map IndirectCallTypeIdxMap, builder WasmModuleBuilder)
	match op 'k'
		const to funcAddr then break 'k'
		callIndirect(_, _, resultType, argFloatMask, args) then internIndirectCallType(map, builder: builder, resultType: resultType, argFloatMask: argFloatMask, argCount: args.count(), isThrowing: false)
		osPanic to osFreePages then break 'k'
		// The jump table makes no indirect call — it branches on an integer index.
		switch then break 'k'
		// ⭐ A witness call IS an indirect call on wasm (P1.7a slice 2b-iv-B): its callee is a funcref-table
		// index loaded out of a witness-table slot, so it needs a pre-interned functype exactly as
		// `callIndirect` does — through the SAME door, so the interned type and the call-site immediate cannot
		// disagree. The THROWING form differs in ONE respect: its callee's wasm signature carries the trailing
		// i64 error flag as a second result (`funcSignatureResultValTypes`), which `isThrowing` adds.
		witnessCall(_, _, _, resultType, argFloatMask, args) then internIndirectCallType(map, builder: builder, resultType: resultType, argFloatMask: argFloatMask, argCount: args.count(), isThrowing: false)
		witnessTryCall(_, _, _, _, resultType, argFloatMask, args) then internIndirectCallType(map, builder: builder, resultType: resultType, argFloatMask: argFloatMask, argCount: args.count(), isThrowing: true)
		// P1.5 dogfood slice 1a: the IOCP ops are x64-windows only and pull in no wasm import.
		osPipeCreate to osWriteFile then break 'k'
		// The wall clock is x64-windows only and makes no indirect call.
		osReadWallClock then break 'k'
		// R4.1 + R4.2: the file ops are x64-windows only (E3104 at the call site) and pull in no wasm import.
		osFileOpenRead to osFileAttributes then break 'k'
		// A rendered panic pulls in no import that `osPanic` does not.
		osPanicValue then break 'k'
		// The command line is x64-windows only (E3104 at the call site) and pulls in no wasm import.
		osCommandLine then break 'k'
		// W5: x64-windows only too, and neither pulls in a wasm import.
		osStdHandle then break 'k'
		osExecutablePath then break 'k'
		// W35: a stream write makes no INDIRECT call — it calls two IMPORTS by index.
		osWriteStderr then break 'k'
		// A frame address makes no call of any kind.
		stackRecordAddr then break 'k'
		osOpenNamedSegment to osTickCountMs then break 'k'
		// The rest of the appended band — the four attached-subprocess host primitives, the `ws2_32` socket
		// band, the machine query AND the thread-CPU read — makes no wasm call either: it is x64-windows only.
		osHandleSetInherit to osThreadCpuTicks then break 'k'
		// F1a: the decommit makes no call of ANY kind on this lane — it emits nothing at all (see `emitBodyOp`),
		// so there is no signature to intern.
		osDecommitPages then break 'k'
		// F1b: a byte fill is ONE `memory.fill` instruction — no call, so no signature to intern.
		memFill then break 'k'
		// F1c: the reserve is `memory.grow` and the commit is a local copy — instructions, not calls, so neither
		// has a signature to intern either.
		osCommitPages to osReservePages then break 'k'
		// F2: the two atomics and the thread token are plain instruction sequences on this lane — no call, so no
		// signature to intern.
		atomicCas to currentThreadToken then break 'k'
		// G1: the multi-M substrate names no wasm function and needs no import table entry — it is REFUSED at
		// emission (below), so it contributes nothing to collect here.
		tlsAlloc to osEnterBackgroundPriority then break 'k'
	end 'k'
end 'internIndirectCallTypeFor'

// Intern the wasm functype `(argValTypes) -> resultType` for one indirect-call signature and record its index
// under the encoded-functype key. `internFuncType` dedups by the encoded bytes, so a repeated signature
// re-derives the SAME index (and a signature that equals a real function's own type — e.g. a `__fnref_`
// thunk's — shares one type-section entry). The single door that builds an indirect call's wasm signature,
// so the pre-interned type and the call-site `call_indirect` immediate cannot disagree (P1.5 #78). The result
// list comes from `funcResultValTypes`, the SAME void|value(StdType) → valtypes mapping a whole function's
// signature uses: a VOID indirect callee (a raw element destructor) interns ZERO results, a value one its
// single valtype. `emitCallIndirect` rebuilds the sig key through the same helper, so intern and call-site
// cannot disagree on the void case either.
function internIndirectCallType(map IndirectCallTypeIdxMap, builder WasmModuleBuilder, resultType StdReturnType, argFloatMask ArgFloatMask, argCount ParamCount, isThrowing bool)
	let params = indirectCallParamValTypes(argFloatMask, argCount: argCount)
	let results = indirectCallResultValTypes(resultType, usesSecondarySlot: isThrowing)
	let typeIdx = builder.internFuncType(params, results: results)
	map.upsert(encodeFuncType(params, results: results), value: typeIdx)
end 'internIndirectCallType'

// The wasm parameter valtypes of an indirect call, one per argument in order (P1.5 #78).
function indirectCallParamValTypes(argFloatMask ArgFloatMask, argCount ParamCount) returns WasmValTypeArray
	var params = WasmValTypeArray.create()
	for k in 0 upto argCount 'each'
		params.push(indirectCallArgValType(argFloatMask, argIndex: k))
	end 'each'
	return params
end 'indirectCallParamValTypes'

// ⭐⭐ **THE ONE DOOR from an indirect call's per-argument ABI bit to a wasm valtype.** The float bit picks
// the register FILE, and that is the whole of it: an integer argument is a MACHINE WORD, exactly as it is in
// the CALLEE's own declared signature (`funcParamValTypes`, the same `wasmMachineValTypeOf`).
//
// ⚠ **BOTH THE DECLARED FUNCTYPE AND THE PUSHED ARGUMENT COME THROUGH HERE, AND THAT IS THE PROPERTY.**
// `indirectCallParamValTypes` builds the type `call_indirect` names; `pushIndirectArgs` coerces each operand to
// the valtype it will be checked against. Those were two spellings of one rule — the same drift
// `indirectCallResultValTypes` exists to prevent on the RESULT half — and a disagreement between them is not a
// compile error at either site, it is a `wasm trap: indirect call type mismatch` at run time.
//
// ⭐⭐ **THERE WAS A SECOND, PER-ARGUMENT *WIDTH* BIT HERE, AND ERASURE IS WHY IT COULD NOT WORK (WASM3).**
// `ArgNarrowMask` declared argument k an `i32` when the DECLARED parameter type was an `i1`/`u32`, so that the
// call site would name the same functype the target's real widths give. That is exact only while both ends read
// the SAME declaration — and a shared generic body does not. `Holder.apply(f Transform)` with
// `typealias Transform = function(Element) returns Element` is compiled ONCE for `Holder with Integer`,
// `Holder with bool` and `Holder with String`: inside it `Element` is opaque, so the call site declares a
// machine word, while `__fnref_flip` — minted from `flip(b bool) returns bool`'s own declaration — was typed
// `(i32, i64) -> i32`. MEASURED: `wasm trap: indirect call type mismatch`, on a program x64 answers correctly.
// A per-site width cannot be reconciled with an ABI that erases; a MACHINE WORD can, because it is what
// erasure already assumes and what the register targets already do. So the width bit is DELETED and the whole
// wasm ABI is the machine word — which is `maxon-selfhosted`'s wasm backend verbatim
// (`MirToWasm.stdTypeToWasmType`: `f64` for a float, `i64` for everything else, for every param, result and
// local it declares).
//
// ⚠ **THE REFUSAL THE WIDTH BIT REPLACED IS STILL GONE, AND MUST STAY GONE.**
// `requireIndirectlyReachableParamsAreMachineWords` used to reject any program with a `bool`/`ExitCode`
// parameter reachable through a `.rdata` function slot. It covered less than it looked like it did — a lifted
// CLOSURE's address is a `.text` `funcAddr` in no `.rdata` slot, so `function(loud bool) gives …` called
// through a `function(bool) returns int` typealias walked straight past it and trapped anyway — and the
// machine-word ABI closes both halves at once, because now NO function's wasm signature carries a narrow
// integer for a caller to disagree with.
//
// ⚠ **IT STATES NO valtype TABLE OF ITS OWN, AND THAT IS THE POINT.** The bit becomes the ABI class's
// canonical `StdType` (`stdTypeOfAbiClass`) and that goes through `wasmMachineValTypeOf` — the SAME door the
// CALLEE's own functype comes through (`funcParamValTypes`). It used to answer with a second float → valtype
// table written out here: the two agreed for every `StdType` and nothing made them, so an edit to either would
// have diverged silently into a run-time `indirect call type mismatch` — the one failure mode neither end of a
// `call_indirect` can report at compile time.
function indirectCallArgValType(argFloatMask ArgFloatMask, argIndex ParamCount) returns WasmValType
	return wasmMachineValTypeOf(stdTypeOfAbiClass(argMaskBit(argFloatMask, argIndex: argIndex)))
end 'indirectCallArgValType'

// ==========================================================================
// Std type → wasm valtype, and the function-signature valtype lists
// ==========================================================================

// ⭐ THE ONE DOOR from a Std type to a wasm valtype. Everything up to 32 bits lives in an
// i32 wasm local (wasm has no sub-word local); i64/u64 in an i64; the floats map straight
// across. `i1` (a bool) is an i32, which is what `condBranch`/`if` consume and what a compare
// produces. A Maxon `float` is an f64, so f64 is the float valtype every float op selects; the
// f32 mapping is total for classification completeness, but nothing produces an f32 value.
function wasmValTypeOf(t StdType) returns WasmValType
	return match t 'w'
		i1 gives WasmValType.i32
		i8 gives WasmValType.i32
		i16 gives WasmValType.i32
		i32 gives WasmValType.i32
		u8 gives WasmValType.i32
		u16 gives WasmValType.i32
		u32 gives WasmValType.i32
		i64 gives WasmValType.i64
		u64 gives WasmValType.i64
		f32 gives WasmValType.f32
		f64 gives WasmValType.f64
	end 'w'
end 'wasmValTypeOf'

// True when a value of type `t` OCCUPIES a full machine word rather than an i32 local. A STORAGE
// question, and no longer an arithmetic one: which instruction family an integer OPERATION selects is
// `wasmMachineValTypeOf`'s answer and is always i64. The two callers left are the ones genuinely asking
// about storage — a `const`'s encoded width, and `bitcastI64ToF64`'s refusal of a source that has no
// top half to reinterpret. A float `t` reaching here is a lowering bug, so it panics naming `what`.
function isWideInt(t StdType, what String) returns bool
	match wasmValTypeOf(t) 'w'
		i32 then return false
		i64 then return true
		f32 then panic("wasm: {what} on an f32 operand is not in the scalar slice")
		f64 then panic("wasm: {what} on an f64 operand — this integer-op emitter should have taken the float path first")
	end 'w'
end 'isWideInt'

// ⭐⭐ **AN INTEGER OPERATION IS COMPUTED AT THE MACHINE WORD, WHATEVER ITS OPERANDS' Std TYPE SAYS
// (X5 review).** The Std `operandType` is the operands' DECLARED type; it is not the width the
// language performs the arithmetic at. The native backends make that distinction invisible — every
// integer op is a 64-bit register form whatever the Std type says — so `ExitCode * 2` answers
// 8,000,000,000 there and nothing narrows. wasm's typed stack made the same field select the i32
// family, and every operation over a `u32` came out at 32 bits: MEASURED against x64 through a
// function-typealias call (the entrance W1 opened, which mints a genuinely `exitCode`-tagged value),
// `v * 2` answered 3,705,032,704 for 8,000,000,000, `not v` 294,967,295 for -4,000,000,001, `v shl 1`
// 3,705,032,704 for 8,000,000,000 and `v > 100` **le** for **gt**.
//
// It is the same sentence `emitDivMod` already writes for `div`/`mod` — computing at i64 is EXACT, not
// merely wider, because every narrow value shv2 mints is UNSIGNED and sits zero-extended in its i32
// (`coerceOnStack`'s header, which is also where the LIMIT of that claim is recorded: it is exact for
// every value INSIDE its declared type's range, and nothing enforces that range) — applied to the ops
// that HAVE an operand type instead of only to the two that do not.
// X5 gave `binOpImm`/`cmpImm` their `operandType` so the width would stop being GUESSED
// from `lhs`; this is the other half, that the width so obtained is a STORAGE class and not an
// arithmetic one. `wasmValTypeOf` still answers where a value LIVES; this answers where it is COMPUTED.
//
// ⭐ ONE DOOR FOR BOTH HALVES OF THE ANSWER: the valtype an ALU op COMPUTES in is also the valtype of
// the local it DEFINES, so `recordDefValtype` and the emitters ask the same function and cannot
// disagree about a value's width (a disagreement is a `local.set` of an i64 into an i32 local, which
// is a wasm VALIDATION failure rather than a wrong answer — but the point is that neither can drift).
// A FLOAT op keeps its own valtype: the float path is already exact at its declared width.
//
// ⭐⭐ **AND THE SAME SENTENCE IS THE WHOLE OF THE wasm CALLING CONVENTION (WASM3), WHICH IS WHY THIS IS
// ALSO THE ABI DOOR AND NOT A SECOND FUNCTION SPELLING THE SAME TABLE.** Every wasm signature this backend
// declares — a function's params (`funcParamValTypes`) and results (`funcResultValTypes`), and the functype a
// `call_indirect` names (`indirectCallArgValType` / `indirectCallResultValTypes`) — is built from THIS
// answer, so an integer crosses every call boundary as a machine word and a float as an f64. Narrow
// valtypes remain, but only INSIDE a body, on locals nothing outside the function can see: a compare's i32,
// a byte load's i32. `wasmValTypeOf` still answers where such a value LIVES; this answers both where a value
// is COMPUTED and how it TRAVELS, which the register targets have never been able to tell apart.
//
// ⚠ **A PER-SITE WIDTH AT A CALL BOUNDARY IS UNSOUND UNDER ERASURE, MEASURED** — see
// `indirectCallArgValType` for the shared generic body that declared one width while its callee's own
// declaration gave another, and for why `ArgNarrowMask` was deleted rather than repaired.
//
// ⛔⛔ **AND IT TAKES AN INSTRUMENT WITH IT: a Std-tier WIDTH disagreement is now invisible on every target.**
// Several fixes in this tree were FOUND because a wrong `StdType` on one end of a call surfaced as
// `wasm trap: indirect call type mismatch` while x64 went on answering correctly — `witnessCallResultType`
// reading an unresolved `named` as `i64` against a `u32` impl, `buildStrEq` declaring an `i64` result into an
// `i1` witness slot, `emitEquatableWitnessEquals`' reinterpretation. Every one of those rules is still
// correct and still enforced by the code; what is gone is the ONLY gate that reported the wrong answer. A
// change that gets a Std width wrong from here on will be silent on all four targets, so the width has to be
// argued at its declaration rather than caught at a call.
function wasmMachineValTypeOf(t StdType) returns WasmValType
	return wasmValTypeOf(t) if stdTypeIsFloat(t) else WasmValType.i64
end 'wasmMachineValTypeOf'

// Refuse a FLOAT operand type reaching an INTEGER-op emitter — a lowering bug (the float emitters are
// dispatched before this point, or, for the immediate forms, `foldConstOperands` never builds one),
// not an out-of-slice case. The twin of `requireF64` for the other domain, and what `isWideInt` used
// to say on the side while it was also being asked for a width the integer emitters no longer want.
function requireIntegerOperand(t StdType, what String)
	if stdTypeIsFloat(t) 'float'
		panic("wasm: {what} on {t.name} — this integer-op emitter should have taken the float path first; no float value reaches the integer ALU")
	end 'float'
end 'requireIntegerOperand'

// shv2's `float` is f64 THROUGHOUT — the wasm float path, like the native backends
// (arm64RequireScalarDouble / its x64 twin), is scalar-double only. Nothing in the frontend
// produces an f32 (a Maxon `float` is an f64), so an f32 reaching a float emitter is a
// lowering bug, not an unsupported-slice case — and `f64.const`/`f64.*` would encode the wrong
// width for one silently. This is the one door that says so.
function requireF64(t StdType, what String)
	if t != StdType.f64 'notDouble'
		panic("wasm: {what} on {t.name} — the wasm float path is f64-only (Maxon's `float` is f64); nothing produces an f32")
	end 'notDouble'
end 'requireF64'

// A function's declared wasm PARAMETER list — one MACHINE WORD per Std parameter (`wasmMachineValTypeOf`),
// which is also the local a `param` op defines, because in wasm a parameter IS local `k`. The two are one
// answer for the same reason `emitBinOp`'s width and `recordDefValtype`'s are: a `local.set` of an i64 into
// an i32 local is a validation failure, and here it would be a signature the body contradicts.
function funcParamValTypes(func IrFunction) returns WasmValTypeArray
	var params = WasmValTypeArray.create()
	for pt in func.paramTypes 'each'
		params.push(wasmMachineValTypeOf(pt))
	end 'each'
	return params
end 'funcParamValTypes'

// A function's declared wasm RESULT list — the machine-word image of its Std return type, and the width
// `emitRet`/`emitErrorReturn` coerce the returned value to. A void return declares no result at all.
function funcResultValTypes(returnType StdReturnType) returns WasmValTypeArray
	var results = WasmValTypeArray.create()
	match returnType 'r'
		void then break 'r'
		value(inner) then results.push(wasmMachineValTypeOf(inner))
	end 'r'
	return results
end 'funcResultValTypes'

// ⭐ **THE ONE DOOR from a (return type, throws?) pair to a wasm RESULT LIST** — the multi-value image of
// shv2's dual-register error ABI: a throwing function exits through `errorReturn`, which pushes the value
// then the flag (or, void, just the flag), so the wasm type must declare both. The native backends need no
// such split — the flag rides a fixed second register (R10/x9) outside the signature.
//
// ⚠ **BOTH ENDS OF AN INDIRECT CALL MUST COME THROUGH HERE, or wasmtime traps "indirect call type mismatch"
// at RUNTIME.** `call_indirect` checks the declared functype against the TARGET's own type exactly, and the
// target is a real emitted function typed by `funcSignatureResultValTypes` — which is this function, applied
// to the function's own declaration. A witness call's op-carried `resultType` + `isThrowing` therefore route
// through the identical helper, so the two derivations cannot drift apart.
//
// ⚠ **THE RESULT HALF NEEDS NO WIDTH MASK BECAUSE THE TWO ENDS AGREE — AND THAT AGREEMENT IS A CONVENTION
// FOUR SITES KEEP, NOT A MECHANISM ONE SITE ENFORCES (corrected at W1).** This IS the one door both ends come
// through, but what it is HANDED is a `resultType` the FRONT END derived, and that derivation used to be
// credited to `Parser.interfaceReturnMaxonType` alone. There were three more doors. A function typealias
// stores its return interner-free as a `(tag, NAME)` pair and rebuilt `ExitCode` as a width-free `named` — so
// a `call_indirect` declared `() -> i64` against a `__fnref_` thunk typed `() -> i32` and trapped at run time,
// which is the defect W1 fixed and which the paragraph asserting the result half was safe is why nobody looked
// for. All four doors now ask one table (`TypeResolution.builtinTypeNameTag`); a FIFTH interner-free store of
// a declared type would re-open it, and the only thing standing between that and a run-time trap is asking the
// same table. The PARAMETER half reached the same place by a different route — see `indirectCallArgValType`.
// ⚠ The parameter is `usesSecondarySlot` and NOT `isThrowing`, because since P1.7a slice 2 the two are
// different facts: an interface-returning function declares the second result to carry its WITNESS half, and
// a throwing one to carry the error flag. The three indirect shapes still answer with `throws` alone — a
// requirement's and a function type's interface return are both refused at their declaration — while a
// whole FUNCTION's signature answers with `functionUsesSecondaryReturnSlot`.
function indirectCallResultValTypes(returnType StdReturnType, usesSecondarySlot bool) returns WasmValTypeArray
	var results = funcResultValTypes(returnType)
	if usesSecondarySlot 'aSecondResult'
		results.push(WasmValType.i64)
	end 'aSecondResult'
	return results
end 'indirectCallResultValTypes'

// The wasm result signature of a whole FUNCTION — its declaration's view of the door above.
// `funcResultValTypes` alone still names the PRIMARY result the body's `errorReturn`/`ret` coerce to (see
// `emitErrorReturn`/`emitRet`); this is the signature-only view.
//
// ⭐ **THE SECOND RESULT IS NOT "THE ERROR FLAG", IT IS "THE SECONDARY RETURN SLOT" (P1.7a slice 2).** An
// interface-returning function writes the witness half into exactly the register/result a throwing one
// spends on the flag, so the question this signature must answer is `functionUsesSecondaryReturnSlot`'s and
// not `throwsClauseIsThrowing`'s. ⚠ It is asked HERE through the same one predicate the frontend's return
// emitters ask, because wasm is the lane where a disagreement is fatal rather than silent: a function whose
// BODY returns two values under a type declaring one does not validate, and a `call`/`call_indirect` against
// a functype the target does not have traps. On x64 the same disagreement merely drops a machine word.
//
// The parameter is `IrFunction` and both fields it reads survive into the Std module untouched — the SAME
// object is pushed there by `transferFuncs`, which only ADDS the collapsed `returnType`/`paramTypes`.
function funcSignatureResultValTypes(func IrFunction) returns WasmValTypeArray
	return indirectCallResultValTypes(func.returnType, usesSecondarySlot: functionUsesSecondaryReturnSlot(func.maxonReturnType, throws: func.throwsTypeName))
end 'funcSignatureResultValTypes'

function singletonValTypes(vt WasmValType) returns WasmValTypeArray
	var one = WasmValTypeArray.create()
	one.push(vt)
	return one
end 'singletonValTypes'

// Coerce the value on top of the stack from `from` to `to` when a value's width differs from the
// width the consuming context requires. The native backends never need this — every value sits in a
// 64-bit register, so a narrow `ExitCode` return of an `i64` arithmetic result is a no-op there — but
// wasm's typed stack rejects `i64` where `i32` is declared. A same-valtype coercion (including
// `f64 -> f64`) is a NO-OP, so a float that already sits at its own width passes through untouched.
// A CROSS-DOMAIN coercion (int <-> float) is never generated: the frontend inserts an explicit
// `siToFp`/`fpToSi` op for every domain change (int->int carries none, which is why the i32/i64 pair
// IS handled here), so an int<->float pair reaching this point is a lowering bug, and the panic
// names it as one.
//
// ⭐⭐ **THE WIDEN IS UNSIGNED, AND THAT IS THE WHOLE OF `ExitCode`'S VALUE ABOVE 2^31 (W1 review).** Every
// narrow int shv2 puts in a VALUE is UNSIGNED — `valueTagToStdType` produces exactly `i1`, `u32`, `i64` and
// `f64`, and the heap's byte band is `u8`; NOTHING in the tree constructs a `StdType.i8`/`i16`/`i32`. So the
// i32 a narrow value sits in holds a ZERO-extended number, and re-widening it with `i64.extend_i32_s` reads
// its top bit as a SIGN. MEASURED, on a `returns ExitCode` of 4,000,000,000: the host printed 4000000000 and
// wasm printed **-294967296** — a silent wrong answer, not a trap, through all three doors that widen a
// narrow call result (a DIRECT call, a witness dispatch, and — since W1 recovered the alias's width — a
// function typealias). All three are pinned: the direct and alias readings together in
// `first-class-function.exitcode-return-through-alias-high`, the witness one in
// `where-clauses.witness-exitcode-return-high`. Each reads the number BACK with `print` rather than returning
// it as a process status, because the OS truncates an exit code and an `exitcode` assertion could not see this.
//
// ⚠ It is unsigned because there is no SIGNED narrow type to be wrong about, not because a sign is never
// wanted: `emitOsAllocPages` widens `memory.grow`'s -1 OOM sentinel and calls `i64ExtendI32S` DIRECTLY for
// exactly that reason. If P1.9 (narrow int widths) ever gives a VALUE a signed sub-64 Std type, this
// function's `(from, to)` valtype pair stops carrying enough to decide — the source's signedness has to
// reach it, and `getValtype`'s table (WasmValType, not StdType) is where that information is dropped today.
//
// ⚠ **THE TWO CASES NAMED ABOVE ARE A WINDOWS-LANE READING SINCE BATCH27**, because 4,000,000,000 is no
// longer a legal `ExitCode` anywhere else — the range is `int(0 to 255)` on Linux, macOS and WASI. ⇒ **on
// the POSIX lanes THIS WIDEN IS NOW UNREACHABLE, and that is a closure by construction rather than a gap.**
//
// ⛔ **A `u32`-RANGED ARRAY ELEMENT DOES NOT RE-PIN IT, AND THE COORDINATOR'S FIRST MEASUREMENT SAYING IT
// DID WAS MEASURING A DIFFERENT PROPERTY.** That probe showed a 4-byte STORAGE slot and a correct
// round-trip of 4000000000 on both lanes — but a round-trip is a POSITIVE CONTROL: it passes whether or
// not this function is wrong. MEASURED by disassembly (`wasm-tools print`): `__managed_get` is
// `(param i64 i64) (result i64 i64)`, so a loaded element NEVER occupies an `i32` local, `coerceOnStack`
// is never asked, and the module's only `i64.extend_i32_s` is `emitOsAllocPages`' `memory.grow` sentinel.
// A case on that route would go green with this defect fully present.
//
// The structural reason is one line up the pipeline: **`valueTagToStdType` maps exactly ONE tag —
// `exitCode` — to `StdType.u32`** (`IR/Maxon/LowerMaxonToStd.maxon:123`); a user `typealias U32 =
// int(0 to u32.max)` is a `named` tag and lowers to `StdType.i64`. So only `ExitCode` mints a narrow
// VALUE, and on POSIX its range stops at 255 while a signed and an unsigned widening first disagree at
// 2^31. **Two independent premises, both required.** ⇒ what would REOPEN it: P1.9 giving a user type a
// narrow Std type, or widening `ExitCode`'s POSIX range past 2^31 — either one, and this widen needs a
// pin on the wasm lane again.
//
// ⛔⛔ **AND THE INVARIANT ABOVE IS ABOUT THE TYPE, NOT ABOUT THE VALUE — SO THE ZERO-EXTENSION IS EXACT
// ONLY INSIDE `[0, u32.max]`, WHICH IS THE SLOT'S DOMAIN AND NOT AUTOMATICALLY THE VALUE'S (X5 review,
// MEASURED).** No narrow Std type is SIGNED, which is what the paragraph above establishes; it does not
// establish that the number sitting in a `u32` slot is inside a `u32`. That second half is a RANGE
// obligation and was never this file's to discharge — and while nothing discharged it, six lines
// reproduced the divergence with no alias, no loop and no phi:
//
//     function negOne() returns ExitCode
//     	return -1
//     end 'negOne'
//     let v = negOne()   ⇒ host printed v=-1, plus10=9;   wasm printed v=4294967295, plus10=4294967305
//
// That reading was PRE-EXISTING and was measured on the pre-X5 binary too, so it was never the width
// work's — the widen has always read whatever bit pattern reached it.
//
// ⭐ **IT IS CLOSED, AND BY THE CURE THIS BLOCK NAMED: `InsertRangeChecks`, not a line in `wasmValTypeOf`.**
// X6 gave the builtin `ExitCode` a range the guards can read, so `return -1` is E3005 at the `return` on
// every target; BATCH27 made that range the compile TARGET's (`int(0 to u32.max)` on Windows,
// `int(0 to 255)` on Linux, macOS and WASI — `Project.exitCodeAliasHigh`, mirroring `stdlib/Process.maxon`),
// which is what closed the values between 256 and `u32.max` that the OS was silently masking on this lane.
// ⚠ **This block asserted the open defect in the PRESENT TENSE from X5 until BATCH27; it was already stale
// at X6, and the range work found it rather than caused it.**
//
// ⇒ What this function relies on is unchanged, and now has a guard standing behind it rather than a hope:
// `wasmMachineValTypeOf`'s and `emitDivMod`'s "computing at i64 is EXACT" is exact for every value inside the
// SLOT's domain — verified across `[0, u32.max]` including 2^31 and u32.max, host and wasm byte-identical
// on 14 readings — and the range checks are what stop a value outside it from ever arriving here.
//
// ⛔ **THE SLOT STAYS `u32` ON EVERY TARGET, AND THE NARROWED RANGE IS EXACTLY WHY IT MUST.** BATCH27
// narrowed the RANGE and deliberately not the width: the runtime half of the call-argument door is a guard
// at the CALLEE'S ENTRY, which reads the value out of the slot AFTER the ABI narrowed it, so it can only
// see a truncation while the slot is WIDER than the range. Give `ExitCode` a `u8` slot here and
// `takes(opaque(0) - 5)` arrives as 251, inside `int(0 to 255)`, and the guard passes — the wrong answer
// back, wearing a check. `Project.maxon`'s `ExitCode` seed states the argument in full.
//
// ⚠ Do not read the pre-X5 compiler as better here: its 32-bit arithmetic made a few of these readings
// AGREE with the host by coincidence (`v + 10` was `9` both ways), which is a wrapped answer that happened
// to land, not a property.
function coerceOnStack(body WasmBody, from WasmValType, to WasmValType)
	if from == to 'same'
		return
	end 'same'

	if from == WasmValType.i64 and to == WasmValType.i32 'narrow'
		body.i32WrapI64()
		return
	end 'narrow'

	if from == WasmValType.i32 and to == WasmValType.i64 'widen'
		body.i64ExtendI32U()
		return
	end 'widen'

	panic("coerceOnStack: {from.name} -> {to.name} crosses the int/float domain with no explicit conversion — the frontend inserts siToFp/fpToSi for every domain change, so this is a lowering bug")
end 'coerceOnStack'

// ==========================================================================
// Per-ValueId valtype table (dense 0..maxValueId), driving local declarations
// ==========================================================================

// Read a value's declared valtype from the table. Every value an op defines is recorded, so a
// read is always in range; `i64` is the fill for the padding slots of any value-id gaps DCE
// left behind (an unused local, never referenced).
function getValtype(valtypes WasmValTypeArray, v ValueId) returns WasmValType
	return try valtypes.get(v) otherwise WasmValType.i64
end 'getValtype'

// Write `vt` at `v`, extending the (i64-filled) table to reach it. `growFilled` grows the
// backing geometrically, so recording defs in id order is amortized-linear.
function setValtype(valtypes WasmValTypeArray, v ValueId, vt WasmValType)
	if v >= valtypes.count() 'extend'
		valtypes.growFilled(v + 1, value: WasmValType.i64)
	end 'extend'

	try valtypes.set(v, value: vt) otherwise panic("setValtype: v{v} OOB after growFilled — a grow that just ensured the slot cannot leave it missing")
end 'setValtype'

// The valtype of a unary op's RESULT. `neg`/`bitNot`/`logicalNot` compute what they consume;
// the two conversions INVERT (`operandType` is always the source — `siToFp` reads an int and
// yields f64, `fpToSi` reads f64 and yields an int), so their result type is NOT `operandType`.
// Reading `operandType` as the result here would put the conversion's result in the wrong local
// class (an f64 result recorded i64, or the reverse) — see StdUnaryOpcode's header.
function unaryResultValType(opcode StdUnaryOpcode, operandType StdType) returns WasmValType
	return match opcode 'k'
		// ⚠ MEASURED AND KEPT: naming these arms individually rather than collapsing them into a range
		// costs nothing and buys the bootstrap's jump table (it forms one only from 4+
		// INDIVIDUALLY-NAMED arms dense from ordinal 0, so a leading range would demote this to a
		// ≤4-compare chain). Compile-time only, wasm-lowering only.
		//
		// ⚠ `logicalNot` PARTS COMPANY WITH THE OTHER TWO, and asking `wasmValTypeOf(operandType)` for
		// it was a latent trap rather than a shorter spelling: `emitLogicalNotExpr` emits an `i32.xor`
		// and so ALWAYS defines an i32, while its `operandType` is the bool's — and a bool-returning
		// function lowers to an i64 return in this tier, so an `operandType` that is not `i1` would
		// declare the local i64 and fail wasm validation. `neg`/`bitNot` compute what they consume, at
		// the machine word (`wasmMachineValTypeOf`, which keeps a float `neg`'s f64 unchanged).
		neg to bitNot gives wasmMachineValTypeOf(operandType)
		logicalNot gives WasmValType.i32
		siToFp gives WasmValType.f64
		fpToSi gives WasmValType.i64
		// ⚠ The MATH INTRINSICS need their OWN arm even though `wasmValTypeOf(operandType)` would give
		// the same answer: they sit PAST `fpToSi`, so the arm that computes it cannot be extended to
		// reach them without swallowing both conversions. `f64` outright is also the stronger claim —
		// they are f64 → f64 by definition (`stdUnaryOperandIsFloat`).
		floor to abs gives WasmValType.f64
		// ⚠ The BITCAST is the only op here whose operand and result differ in CLASS without the
		// value changing: `i64.reinterpret_f64` reads an f64 local and writes an i64 one. Recording
		// it as f64 (which `wasmValTypeOf(operandType)` would) puts the result in the wrong local
		// class and the module fails validation, exactly as it would for the conversions.
		bitcastF64ToI64 gives WasmValType.i64
		// The INBOUND bitcast, and the same trap mirrored: `wasmValTypeOf(operandType)` would answer
		// i64 (the source IS an i64) and record the result in an integer local, which `f64.*`
		// consumers then fail validation against.
		bitcastI64ToF64 gives WasmValType.f64
	end 'k'
end 'unaryResultValType'

// The valtype of a `call`'s result — the callee's return type. A void callee still names a
// result value in the Std IR (nothing reads it in the scalar slice); i64 is a harmless
// placeholder for that unread local.
function callResultValType(callee ByteArray, funcNames FunctionNameIndex) returns WasmValType
	let rt = (try funcNames.funcNamed(callee) otherwise panic("callResultValType: no Std function named '{String.from(callee)}'")).returnType
	return match rt 'r'
		void gives WasmValType.i64
		value(inner) gives wasmMachineValTypeOf(inner)
	end 'r'
end 'callResultValType'

// Build the dense per-ValueId valtype table for `func`. Params own ids 0..paramCount-1;
// block-args and op results own the rest, and EVERY op names its own result's width — there is no
// longer any value whose width is copied from an operand, which is what makes a single pass in
// arbitrary block/op order enough.
//
// ⭐⭐ **THAT WAS THE X5 DEFECT, AND IT COST THREE OPS THEIR WIDTH.** `binOpImm`/`cmpImm` derived
// theirs from `lhs`, and `div`/`mod` were recorded DEPENDENT on `lhs` and resolved by a second walk.
// Both are the same mistake: **an operand's storage width is not the operation's width.** A Std value
// keeps the width its DEFINING op gave it while a consumer may treat it as a machine word — an
// int→int promotion emits no conversion op — so a `u32` `ExitCode` feeding a divide, or an `i1`
// compare result feeding the `mod` overflow guard's `add`, made the operation narrow. The two
// immediate forms now CARRY `operandType` (see StdDialect), and every integer op — `div`/`mod`
// included, which have no operand type at all — is computed at MACHINE WIDTH, which is what the
// native backends do with their 64-bit registers and what `wasmMachineValTypeOf` states in full.
function buildValtypeTable(module StdModule, func IrFunction, funcNames FunctionNameIndex) returns WasmValTypeArray
	var valtypes = WasmValTypeArray.create()

	// A parameter's local IS the wasm parameter, so its valtype is the SIGNATURE's — the machine word
	// `funcParamValTypes` declares, never the narrower storage class the Std type would give.
	for i in 0 upto func.paramCount 'eachParam'
		let pt = try func.paramTypes.get(i) otherwise panic("buildValtypeTable: paramTypes.get OOB at {i} (paramCount={func.paramCount})")
		setValtype(valtypes, v: i, vt: wasmMachineValTypeOf(pt))
	end 'eachParam'

	for blockRef in func.blockRefs 'eachBlock'
		let block = try module.blocks.get(blockRef) otherwise panic("buildValtypeTable: blockRef {blockRef} not in module.blocks")

		for arg in block.blockArgs 'eachArg'
			setValtype(valtypes, v: arg.valueId, vt: wasmValTypeOf(arg.argType))
		end 'eachArg'

		for opIdx in block.opRefs 'eachOp'
			recordDefValtype(try module.ops.get(opIdx) otherwise panic("buildValtypeTable: opIdx {opIdx} not in module.ops"), valtypes: valtypes, funcNames: funcNames)
		end 'eachOp'

		if block.hasTerminatorOp() 'hasTerm'
			recordDefValtype(try module.ops.get(block.terminatorIndex()) otherwise panic("buildValtypeTable: terminatorIndex not in module.ops"), valtypes: valtypes, funcNames: funcNames)
		end 'hasTerm'
	end 'eachBlock'

	return valtypes
end 'buildValtypeTable'

// Record one op's defined-value valtype. Exhaustive over `StdOp` with no bare `default`: a new
// value-defining op fails to compile here rather than defaulting a value to the wrong width.
// Terminators and the out-of-scope memory/system ops define nothing this backend declares a local
// for (a memory/system op present at all makes the body emitter panic before this table is ever
// consumed).
function recordDefValtype(op StdOp, valtypes WasmValTypeArray, funcNames FunctionNameIndex)
	match op 'def'
		const(resultId, _, valueType) then setValtype(valtypes, v: resultId, vt: wasmValTypeOf(valueType))
		binOp(resultId, _, _, _, operandType) then setValtype(valtypes, v: resultId, vt: wasmMachineValTypeOf(operandType))
		unaryOp(resultId, _, opcode, operandType) then setValtype(valtypes, v: resultId, vt: unaryResultValType(opcode, operandType: operandType))
		cmp(resultId, _, _, _, _) then setValtype(valtypes, v: resultId, vt: WasmValType.i32)
		// ⭐ The immediate forms carry their own width (X5), so a fold cannot change a value's
		// class: `binOpImm`'s result is `wasmMachineValTypeOf(operandType)`, exactly as `binOp`'s is, and
		// it is NOT dependent on `lhs` — which a fold does not promise agrees (see `emitBinOpImm`).
		binOpImm(resultId, _, _, _, operandType) then setValtype(valtypes, v: resultId, vt: wasmMachineValTypeOf(operandType))
		cmpImm(resultId, _, _, _, _) then setValtype(valtypes, v: resultId, vt: WasmValType.i32)
		// ⚠ The two ops with NO width of their own. They are computed at machine width and so define
		// an i64, whatever their operands' storage widths are — `emitDivMod` holds the argument.
		div(resultId, _, _, _) then setValtype(valtypes, v: resultId, vt: WasmValType.i64)
		mod(resultId, _, _, _) then setValtype(valtypes, v: resultId, vt: WasmValType.i64)
		condBranch then break 'def'
		branch then break 'def'
		ret then break 'def'
		// A parameter's local is the wasm PARAMETER, so it takes the signature's machine word — the same
		// answer the `func.paramTypes` sweep above already recorded for this id, and the same one
		// `funcParamValTypes` declares.
		param(resultId, _, paramType) then setValtype(valtypes, v: resultId, vt: wasmMachineValTypeOf(paramType))
		call(resultId, callee, _) then setValtype(valtypes, v: resultId, vt: callResultValType(callee, funcNames: funcNames))
		retVoid then break 'def'
		// ⚠ A wasm linear-memory ADDRESS IS AN i32, not the i64 pointer width the native backends
		// carry in a 64-bit register. `globalAddr` materializes an `i32.const`, so its result local
		// must be i32 — the width `loadIndirect`/`storeIndirect` then consume as the base address.
		globalAddr(resultId, _) then setValtype(valtypes, v: resultId, vt: WasmValType.i32)
		loadIndirect(resultId, _, _, valueType) then setValtype(valtypes, v: resultId, vt: wasmValTypeOf(valueType))
		storeIndirect then break 'def'
		osAllocPages(resultId, _) then setValtype(valtypes, v: resultId, vt: WasmValType.i64)
		// W35: a stream write defines the BYTE COUNT — an i64 like every other Std-tier integer, so the
		// emitter widens the i32 length it wrote back to the machine width (see `emitOsWriteStream`).
		osWriteStdout(resultId, _, _) then setValtype(valtypes, v: resultId, vt: WasmValType.i64)
		// A wasm linear-memory ADDRESS IS AN i32 (like `globalAddr`), not the i64 pointer width the
		// native backends carry. `rdataAddr` materializes an `i32.const`, so its result local is i32 —
		// the width `loadIndirect`/`osWriteStdout` then consume as the base address.
		rdataAddr(resultId, _) then setValtype(valtypes, v: resultId, vt: WasmValType.i32)
		// A `tryCall` defines TWO values (like `call` plus the flag); `errorReturn`/`osExit` define
		// none (a return terminator, a diverging exit). See `recordTryCallDefs`.
		tryCall(resultId, errorFlagId, callee, _) then recordTryCallDefs(valtypes, resultId: resultId, errorFlagId: errorFlagId, callee: callee, funcNames: funcNames)
		errorReturn then break 'def'
		osExit then break 'def'
		// P1.5-A1 non-capturing function values. A function value itself is a machine word (its Std type
		// collapses to i64 — valueTagToStdType), so a `funcAddr` (the callee's table index) is i64; it is
		// narrowed to the i32 `call_indirect` table-index operand only at the call itself
		// (`emitFuncAddr`/`emitCallIndirect`), so it FLOWS as i64 unlike a `globalAddr`/`rdataAddr` (an i32
		// address consumed in place). A `callIndirect` RESULT takes the function value's own return width
		// (P1.5 #78): f64 for a float-returning function value, else i64 — the `resultType` the op carries,
		// which is also the valtype the `call_indirect` functype declares as its result.
		funcAddr(resultId, _) then setValtype(valtypes, v: resultId, vt: WasmValType.i64)
		// A VOID indirect callee (a raw element destructor) leaves NOTHING on the stack, so its `resultId` is a
		// dead slot with no def — record no valtype (an unread i64-fill local, like any DCE gap). A value one
		// takes the function value's own return width (f64 for a float-returning value, else i64).
		callIndirect(resultId, _, resultType, _, _) then recordIndirectCallDefValtype(valtypes, resultId: resultId, resultType: resultType)
		osPanic to osFreePages then break 'def'
		// The jump table defines no value — a terminator has no result valtype to record.
		switch then break 'def'
		// A witness call defines exactly what a `callIndirect` does — the op-carried `resultType`'s width, and
		// nothing at all for a VOID interface method. Its THROWING form defines the second `errorFlagId` too,
		// always i64, exactly as a direct `tryCall`'s flag is.
		witnessCall(resultId, _, _, resultType, _, _) then recordIndirectCallDefValtype(valtypes, resultId: resultId, resultType: resultType)
		witnessTryCall(resultId, errorFlagId, _, _, resultType, _, _) then recordWitnessTryCallDefs(valtypes, resultId: resultId, errorFlagId: errorFlagId, resultType: resultType)
		// P1.5 dogfood slice 1a: the IOCP ops are x64-windows only — no wasm valtype to record.
		osPipeCreate to osWriteFile then break 'def'
		// The wall clock is x64-windows only and defines no value — no wasm valtype to record.
		osReadWallClock then break 'def'
		// R4.1 + R4.2: the file ops are x64-windows only, so no wasm valtype is ever recorded for their defs.
		osFileOpenRead to osFileAttributes then break 'def'
		// A rendered panic defines no value, exactly as `osPanic` defines none.
		osPanicValue then break 'def'
		// x64-windows only, so no wasm valtype is ever recorded for its def.
		osCommandLine then break 'def'
		// W5: x64-windows only too, so no wasm valtype is ever recorded for either def.
		osStdHandle then break 'def'
		osExecutablePath then break 'def'
		// W35: the stderr write defines the byte count at the Std tier width, exactly as its stdout twin does.
		osWriteStderr(resultId, _, _) then setValtype(valtypes, v: resultId, vt: WasmValType.i64)
		// Unreachable on this lane — stack promotion is gated OFF for wasm32-wasi
		// (`promoteStackRecords`): a wasm local has no address and the module emits no shadow-stack
		// global, so there is no frame for a slot to index. The valtype scan still runs over the whole
		// module ahead of emission, so it must classify the variant regardless; an i64 is what a pointer
		// would be.
		stackRecordAddr(resultId, _) then setValtype(valtypes, v: resultId, vt: WasmValType.i64)
		// O3: a HANDLE, a mapped ADDRESS and a tick COUNT are all machine words — typed here even though
		// `emitBodyOp` refuses them, because this column is built before any lowering decides anything.
		osOpenNamedSegment(resultId, _, _, _) then setValtype(valtypes, v: resultId, vt: WasmValType.i64)
		osMapNamedSegment(resultId, _, _) then setValtype(valtypes, v: resultId, vt: WasmValType.i64)
		osTickCountMs(resultId) then setValtype(valtypes, v: resultId, vt: WasmValType.i64)
		// The attached subprocess's two ANSWERING host primitives; the other two answer nothing, so they take
		// a `break` arm exactly as every other value-less op here does (`StdLoweringShared`'s twin note says
		// the same thing — and both said "absent rather than present with a `break`", one citing the other,
		// each directly above the `break` arms that made it false).
		osPipePeek(resultId, _, _) then setValtype(valtypes, v: resultId, vt: WasmValType.i64)
		osEnvRead(resultId, _, _, _) then setValtype(valtypes, v: resultId, vt: WasmValType.i64)
		osHandleSetInherit then break 'def'
		osProcessTerminate then break 'def'
		// The socket family's six answering primitives; the other two answer nothing. This column is built
		// before any lowering decides anything, which is why an x64-only family is classed here at all.
		osSocketStartup(resultId, _) then setValtype(valtypes, v: resultId, vt: WasmValType.i64)
		osSocketResolve(resultId, _, _, _) then setValtype(valtypes, v: resultId, vt: WasmValType.i64)
		osSocketFreeAddrInfo then break 'def'
		osSocketCreate(resultId) then setValtype(valtypes, v: resultId, vt: WasmValType.i64)
		osSocketConnect(resultId, _, _) then setValtype(valtypes, v: resultId, vt: WasmValType.i64)
		osSocketSend(resultId, _, _, _) then setValtype(valtypes, v: resultId, vt: WasmValType.i64)
		osSocketRecv(resultId, _, _, _) then setValtype(valtypes, v: resultId, vt: WasmValType.i64)
		osSocketClose then break 'def'
		// The machine query answers a processor count — an i64, exactly as `osGetPid` does. Classed here even
		// though this target refuses it, for the reason the socket family states one line up: this column is
		// built before any lowering decides anything.
		osCpuCount(resultId) then setValtype(valtypes, v: resultId, vt: WasmValType.i64)
		// The thread-CPU read DEFINES nothing — its answer lands in the caller's out-param word, exactly as
		// the wall-clock read's does, so there is no value to class.
		osThreadCpuTicks then break 'def'
		// F1a: the decommit defines no value on any target, so there is never a valtype to record.
		osDecommitPages then break 'def'
		// F1b: a fill defines no value either — it is a store.
		memFill then break 'def'
		// F1c: both define a page BASE — an i64, exactly as `osAllocPages` does, because the Std tier carries every
		// address at the machine width and this lane narrows to i32 only where an instruction demands one.
		osCommitPages(resultId, _, _) then setValtype(valtypes, v: resultId, vt: WasmValType.i64)
		osReservePages(resultId, _) then setValtype(valtypes, v: resultId, vt: WasmValType.i64)
		// F2: a CAS's success boolean, an RMW's prior word and a thread token are all i64 — the width every
		// machine word carries at the Std tier, narrowed to i32 only where an instruction demands one.
		atomicCas(resultId, _, _, _) then setValtype(valtypes, v: resultId, vt: WasmValType.i64)
		atomicRmw(resultId, _, _, _) then setValtype(valtypes, v: resultId, vt: WasmValType.i64)
		currentThreadToken(resultId) then setValtype(valtypes, v: resultId, vt: WasmValType.i64)
		// G1: the two value-defining TLS ops would answer i64 like every other machine word; the two void ones
		// declare nothing. They are refused at emission, so this only keeps the local map total.
		tlsAlloc(resultId) then setValtype(valtypes, v: resultId, vt: WasmValType.i64)
		tlsSetValue then break 'def'
		tlsSlotLoad(resultId, _) then setValtype(valtypes, v: resultId, vt: WasmValType.i64)
		osSetEvent then break 'def'
		// The priority door would answer an i64 like every other machine word. It is refused at emission on
		// this lane, so — exactly as for the TLS pair above — this arm exists only to keep the local map TOTAL.
		osEnterBackgroundPriority(resultId) then setValtype(valtypes, v: resultId, vt: WasmValType.i64)
	end 'def'
end 'recordDefValtype'

// Record a `tryCall`'s two defined values: its primary result — the callee's return width, exactly as
// a plain `call` (`callResultValType`) — and its error flag, always i64 (the dual-register flag the
// native backends carry in R10/x9). A void-returning throwing callee still names an (unread) result
// value; `callResultValType` gives it the same i64 placeholder a void `call` result gets.
function recordTryCallDefs(valtypes WasmValTypeArray, resultId ValueId, errorFlagId ValueId, callee ByteArray, funcNames FunctionNameIndex)
	setValtype(valtypes, v: resultId, vt: callResultValType(callee, funcNames: funcNames))
	setValtype(valtypes, v: errorFlagId, vt: WasmValType.i64)
end 'recordTryCallDefs'

// Record a THROWING witness call's two defined values: its primary result, typed off the op exactly as a
// `callIndirect`'s is (a VOID interface method defines nothing), and its error flag, always i64 — the same
// pair `recordTryCallDefs` records for a direct `tryCall`, differing only in where the primary's width comes
// from (the op, not the named callee — a witness call names no callee).
function recordWitnessTryCallDefs(valtypes WasmValTypeArray, resultId ValueId, errorFlagId ValueId, resultType StdReturnType)
	recordIndirectCallDefValtype(valtypes, resultId: resultId, resultType: resultType)
	setValtype(valtypes, v: errorFlagId, vt: WasmValType.i64)
end 'recordWitnessTryCallDefs'

// Record an indirect call's result valtype. A VALUE callee defines `resultId` at the function value's own
// return width; a VOID callee (a raw element destructor) leaves nothing on the stack, so `resultId` gets no
// def — its local reads as the i64 fill any unreferenced value id does, and nothing reads it.
function recordIndirectCallDefValtype(valtypes WasmValTypeArray, resultId ValueId, resultType StdReturnType)
	match resultType 'r'
		void then break 'r'
		value(inner) then setValtype(valtypes, v: resultId, vt: wasmMachineValTypeOf(inner))
	end 'r'
end 'recordIndirectCallDefValtype'

// ==========================================================================
// WasmFuncEmitter — per-function body + local-declaration emission
// ==========================================================================

type WasmFuncEmitter
	var module as StdModule
	var func as IrFunction
	// The laid-out data tables and the linear-memory bases their offsets are relative to: a
	// `globalAddr` resolves its label to a `.data` offset (base `dataBase`), an `rdataAddr` to a
	// `.rdata` offset (base `rdataBase`). All module-wide constants; each emitter holds them so an
	// address resolves in O(1) with no per-function setup.
	var globalData as GlobalDataTable
	var dataBase as Wasm32Index
	var rdataBase as Wasm32Index
	// The module's CHECKED name index (`FunctionNameIndex`, A2l), threaded down from `buildBackend`. It
	// answers both questions a direct `call` asks about its callee — which wasm function index to emit
	// (`wasmFuncIdxOf`) and whether the callee returns a value at all — in place of the two maps that used
	// to copy those facts out of the same function array without stating what made their keys unique.
	let funcNames as FunctionNameIndex
	var calleeParamTypes as CalleeParamTypesMap
	// Indirect-call SIGNATURE key → its pre-interned functype index, read by `emitIndirectCallOp` (see
	// `IndirectCallTypeIdxMap`). Module-wide; shared read-only by every emitter.
	var indirectCallTypeIdx as IndirectCallTypeIdxMap

	// Dense per-ValueId valtype table (0..maxValueId).
	var valtypes as WasmValTypeArray
	// The instruction-byte accumulator (no local decls, no trailing 0x0B — the module builder
	// frames the body around A2's bytes). Exported: `buildWasmCoreModule` reads `body.bytes()`.
	export var body as WasmBody
	// The valtypes of the declared locals (indices paramCount..lastLocal), in index order:
	// value locals, then the dispatch local, then the phi cycle-break scratch locals. Handed to
	// `WasmModuleBuilder.addFunction`, which run-length-encodes them. Exported: read from
	// `buildWasmCoreModule`.
	export var localTypes as WasmValTypeArray

	// Multi-block functions (and single-block self-loops) run under the loop+br_table
	// dispatcher; a lone straight-line block that ends in a return does not.
	var useDispatcher as bool
	// The i32 local holding the next block's dispatch index (only when `useDispatcher`).
	var dispatchLocal as Wasm32Index
	// Valtype → its reserved cycle-break scratch local (only for valtypes present among
	// block-args, only when `useDispatcher`).
	var scratchLocalByValType as ScratchLocalMap
	// Block id → dispatch index, for branch targets. The dispatch index IS the block's position in
	// `func.blockRefs`, so this is exactly `IrModule.blockIndexById` and not a second thing that
	// happens to agree with it.
	var blockDispatchById as BlockIndexById

	static function create(module StdModule, func IrFunction, globalData GlobalDataTable, dataBase Wasm32Index, rdataBase Wasm32Index, funcNames FunctionNameIndex, calleeParamTypes CalleeParamTypesMap, indirectCallTypeIdx IndirectCallTypeIdxMap) returns WasmFuncEmitter
		let valtypes = buildValtypeTable(module, func: func, funcNames: funcNames)
		let useDispatcher = decideDispatcher(module, func: func)

		var emitter = Self{
			module: module,
			func: func,
			globalData: globalData,
			dataBase: dataBase,
			rdataBase: rdataBase,
			funcNames: funcNames,
			calleeParamTypes: calleeParamTypes,
			indirectCallTypeIdx: indirectCallTypeIdx,
			valtypes: valtypes,
			body: WasmBody.create(),
			localTypes: WasmValTypeArray.create(),
			useDispatcher: useDispatcher,
			dispatchLocal: 0 as Wasm32Index,
			scratchLocalByValType: ScratchLocalMap.create(),
			blockDispatchById: module.blockIndexById(func)
		}

		emitter.buildLocalDeclarations()
		return emitter
	end 'create'

	// Local layout, in the order `localTypes` (and the wasm local index space) demands:
	//   0..paramCount-1        parameters (from the function SIGNATURE, NOT declared here)
	//   paramCount..maxValueId value locals (identity model: value id == local index)
	//   maxValueId+1           dispatch local (i32), when the dispatcher is used
	//   then                   one scratch local per block-arg valtype, when the dispatcher is used
	// A single running cursor assigns the reserved locals so adding one never renumbers another.
	function buildLocalDeclarations()
		let valueLocalCount = self.valtypes.count()

		for i in self.func.paramCount upto valueLocalCount 'valueLocals'
			self.localTypes.push(getValtype(self.valtypes, v: i))
		end 'valueLocals'

		if not self.useDispatcher 'noDispatcher'
			return
		end 'noDispatcher'

		self.dispatchLocal = valueLocalCount as Wasm32Index
		self.localTypes.push(WasmValType.i32)

		var nextScratch = (self.dispatchLocal + 1) as Wasm32Index
		let phiValTypes = self.collectPhiValTypes()
		for vt in WasmValType.allCases 'canonical'
			if phiValTypes.contains(vt) 'present'
				self.scratchLocalByValType.upsert(vt, value: nextScratch)
				self.localTypes.push(vt)
				nextScratch = (nextScratch + 1) as Wasm32Index
			end 'present'
		end 'canonical'
	end 'buildLocalDeclarations'

	// The distinct valtypes appearing among this function's block-args — the only valtypes a
	// phi-copy cycle can stage through, and so the only scratch locals worth reserving.
	function collectPhiValTypes() returns PhiValTypeSet
		var present = PhiValTypeSet.create()
		for blockRef in self.func.blockRefs 'eachBlock'
			let block = try self.module.blocks.get(blockRef) otherwise panic("collectPhiValTypes: blockRef {blockRef} not in module.blocks")
			for arg in block.blockArgs 'eachArg'
				present.insert(wasmValTypeOf(arg.argType))
			end 'eachArg'
		end 'eachBlock'
		return present
	end 'collectPhiValTypes'

	// ----------------------------------------------------------------------
	// Body emission
	// ----------------------------------------------------------------------

	function emit()
		let blockCount = self.func.blockRefs.count()
		if blockCount == 0 'empty'
			self.body.unreachable()
			return
		end 'empty'

		if self.useDispatcher 'dispatch'
			self.emitDispatcher(blockCount)
		end 'dispatch' else 'single'
			self.emitSingleBlock()
		end 'single'
	end 'emit'

	// A lone block that returns: straight-line body then its return terminator. No dispatcher,
	// no dispatch local, no wrapping structure.
	function emitSingleBlock()
		let blockRef = try self.func.blockRefs.get(0) otherwise panic("emitSingleBlock: blockRefs.get(0) OOB")
		let block = try self.module.blocks.get(blockRef) otherwise panic("emitSingleBlock: blockRef {blockRef} not in module.blocks")

		for opIdx in block.opRefs 'eachOp'
			self.emitBodyOp(try self.module.ops.get(opIdx) otherwise panic("emitSingleBlock: opIdx {opIdx} not in module.ops"))
		end 'eachOp'

		if block.hasTerminatorOp() 'hasTerm'
			self.emitStraightLineTerminator(try self.module.ops.get(block.terminatorIndex()) otherwise panic("emitSingleBlock: terminatorIndex not in module.ops"))
		end 'hasTerm' else 'noTerm'
			self.body.unreachable()
		end 'noTerm'
	end 'emitSingleBlock'

	function emitStraightLineTerminator(op StdOp)
		match op 'term'
			ret(retValId) then self.emitRet(retValId)
			retVoid then self.emitRetVoid()
			const to mod then panic("emitStraightLineTerminator: an arith op is not a terminator")
			condBranch then panic("emitStraightLineTerminator: a `condBranch` block should have taken the dispatcher path")
			branch then panic("emitStraightLineTerminator: a `branch` block should have taken the dispatcher path")
			param then panic("emitStraightLineTerminator: a `param` op is not a terminator")
			call then panic("emitStraightLineTerminator: a `call` op is not a terminator")
			globalAddr to rdataAddr then panic("emitStraightLineTerminator: a memory/system op is not a terminator")
			tryCall then panic("emitStraightLineTerminator: a `tryCall` is a value-producing body op, never a terminator")
			errorReturn(retValId, errorFlagId) then self.emitErrorReturn(retValId, errorFlagId: errorFlagId)
			osExit then panic("emitStraightLineTerminator: an `osExit` is a body op followed by a dead return, never a terminator")
			// A `funcAddr`/`callIndirect` is a value-producing body op, never a terminator — the exact
			// mirror of the `call`/`tryCall` arms above (P1.5-A1).
			funcAddr then panic("emitStraightLineTerminator: a `funcAddr` is a value-producing body op, never a terminator")
			callIndirect then panic("emitStraightLineTerminator: a `callIndirect` is a value-producing body op, never a terminator")
			osPanic to osFreePages then panic("emitStraightLineTerminator: an `osPanic` is a body op, never a terminator")
			// A jump table has multiple successors, so `decideDispatcher` always routes its function through
			// the loop+br_table dispatcher — it never reaches the straight-line terminator path.
			switch then panic("emitStraightLineTerminator: a `switch` (multiway) block always takes the dispatcher path, never straight-line")
			witnessCall then panic("emitStraightLineTerminator: a `witnessCall` is a value-producing body op, never a terminator")
			witnessTryCall then panic("emitStraightLineTerminator: a `witnessTryCall` is a value-producing body op, never a terminator")
			osPipeCreate to osWriteFile then panic("emitStraightLineTerminator: a P1.5 IOCP op is a body op, never a terminator")
			osReadWallClock then panic("emitStraightLineTerminator: an `osReadWallClock` is a body op, never a terminator")
			osFileOpenRead to osFileAttributes then panic("emitStraightLineTerminator: a file-IO op is a body op, never a terminator")
			osPanicValue then panic("emitStraightLineTerminator: an `osPanicValue` is a body op, never a terminator")
			osCommandLine then panic("emitStraightLineTerminator: an `osCommandLine` is a body op, never a terminator")
			osStdHandle then panic("emitStraightLineTerminator: an `osStdHandle` is a body op, never a terminator")
			osExecutablePath then panic("emitStraightLineTerminator: an `osExecutablePath` is a body op, never a terminator")
			osWriteStderr then panic("emitStraightLineTerminator: an `osWriteStderr` is a body op, never a terminator")
			stackRecordAddr then panic("emitStraightLineTerminator: a `stackRecordAddr` is a body op, never a terminator")
			osOpenNamedSegment to osTickCountMs then panic("emitStraightLineTerminator: a DebugStream host primitive is a body op, never a terminator")
			osHandleSetInherit to osProcessTerminate then panic("emitStraightLineTerminator: an attached-subprocess host primitive is a body op, never a terminator")
			osSocketStartup to osSocketClose then panic("emitStraightLineTerminator: a socket host primitive is a body op, never a terminator")
			osCpuCount then panic("emitStraightLineTerminator: an `osCpuCount` is a body op, never a terminator")
			osThreadCpuTicks then panic("emitStraightLineTerminator: an `osThreadCpuTicks` is a body op, never a terminator")
			osDecommitPages then panic("emitStraightLineTerminator: an `osDecommitPages` is a body op, never a terminator")
			osCommitPages to osReservePages then panic("emitStraightLineTerminator: a page reserve or commit is a body op, never a terminator")
			memFill then panic("emitStraightLineTerminator: a `memFill` is a body op, never a terminator")
			atomicCas to currentThreadToken then panic("emitStraightLineTerminator: an atomic or a thread-token read is a body op, never a terminator")
			tlsAlloc to osEnterBackgroundPriority then panic("emitStraightLineTerminator: a TLS op, an event signal or the priority door is a body op, never a terminator")
		end 'term'
	end 'emitStraightLineTerminator'

	// The loop+br_table dispatcher (CONTRACT §1, v1 `emitStructuredCfg`). One outer `loop`; one
	// `block` nested per basic block; a `br_table` off the dispatch local jumps to block N's
	// code (which sits just after the N-th nested `end`). Each block ends by either returning or
	// setting the dispatch local and branching back to the loop. Handles any reducible CFG.
	function emitDispatcher(blockCount BlockCount)
		self.body.beginLoop()

		for _ in 0 upto blockCount 'nest'
			self.body.beginBlock()
		end 'nest'

		self.body.localGet(self.dispatchLocal)
		var targets = Wasm32IndexArray.create()
		for i in 0 upto blockCount 'tableEntry'
			targets.push(i as Wasm32Index)
		end 'tableEntry'
		self.body.brTable(targets, defaultTarget: 0)

		for i in 0 upto blockCount 'eachBlock'
			// Close the i-th nested block; its `end` is exactly where block i's code begins, so
			// `br_table` entry i lands here.
			self.body.endOp()

			let blockRef = try self.func.blockRefs.get(i) otherwise panic("emitDispatcher: blockRefs.get OOB at {i}")
			let block = try self.module.blocks.get(blockRef) otherwise panic("emitDispatcher: blockRef {blockRef} not in module.blocks")

			for opIdx in block.opRefs 'eachOp'
				self.emitBodyOp(try self.module.ops.get(opIdx) otherwise panic("emitDispatcher: opIdx {opIdx} not in module.ops"))
			end 'eachOp'

			// The distance from block-code depth to the outer loop: after i+1 `end`s, the loop is
			// the (blockCount-1-i)-th enclosing structure.
			let loopDepth = (blockCount - 1 - i) as Wasm32Index
			if block.hasTerminatorOp() 'hasTerm'
				self.emitDispatcherTerminator(try self.module.ops.get(block.terminatorIndex()) otherwise panic("emitDispatcher: terminatorIndex not in module.ops"), currentBlock: block, loopDepth: loopDepth)
			end 'hasTerm' else 'noTerm'
				self.body.unreachable()
			end 'noTerm'
		end 'eachBlock'

		self.body.endOp()
		// After the loop: every block returns or branches back, so control never falls out —
		// but the validator checks the stack at the function end, and `unreachable` makes it
		// polymorphic, satisfying any result type (CONTRACT §4.4).
		self.body.unreachable()
	end 'emitDispatcher'

	function emitDispatcherTerminator(op StdOp, currentBlock IrBlock, loopDepth Wasm32Index)
		match op 'term'
			ret(retValId) then self.emitRet(retValId)
			retVoid then self.emitRetVoid()
			branch(targetBlockId) then self.emitDispatchBranch(targetBlockId, currentBlock: currentBlock, loopDepth: loopDepth)
			condBranch(condId, thenBlockId, elseBlockId) then self.emitDispatchCondBranch(condId, thenBlockId: thenBlockId, elseBlockId: elseBlockId, currentBlock: currentBlock, loopDepth: loopDepth)
			switch(subjectId, denseTargetBlockIds, defaultBlockId) then self.emitDispatchSwitch(subjectId, caseTargets: denseTargetBlockIds, defaultTarget: defaultBlockId, currentBlock: currentBlock, loopDepth: loopDepth)
			const to mod then panic("emitDispatcherTerminator: an arith op is not a terminator")
			param then panic("emitDispatcherTerminator: a `param` op is not a terminator")
			call then panic("emitDispatcherTerminator: a `call` op is not a terminator")
			globalAddr to rdataAddr then panic("emitDispatcherTerminator: a memory/system op is not a terminator")
			tryCall then panic("emitDispatcherTerminator: a `tryCall` is a value-producing body op, never a terminator")
			errorReturn(retValId, errorFlagId) then self.emitErrorReturn(retValId, errorFlagId: errorFlagId)
			osExit then panic("emitDispatcherTerminator: an `osExit` is a body op followed by a dead return, never a terminator")
			// A `funcAddr`/`callIndirect` is a value-producing body op, never a terminator — the exact
			// mirror of the `call`/`tryCall` arms above (P1.5-A1).
			funcAddr then panic("emitDispatcherTerminator: a `funcAddr` is a value-producing body op, never a terminator")
			callIndirect then panic("emitDispatcherTerminator: a `callIndirect` is a value-producing body op, never a terminator")
			osPanic to osFreePages then panic("emitDispatcherTerminator: an `osPanic` is a body op, never a terminator")
			witnessCall then panic("emitDispatcherTerminator: a `witnessCall` is a value-producing body op, never a terminator")
			witnessTryCall then panic("emitDispatcherTerminator: a `witnessTryCall` is a value-producing body op, never a terminator")
			osPipeCreate to osWriteFile then panic("emitDispatcherTerminator: a P1.5 IOCP op is a body op, never a terminator")
			osReadWallClock then panic("emitDispatcherTerminator: an `osReadWallClock` is a body op, never a terminator")
			osFileOpenRead to osFileAttributes then panic("emitDispatcherTerminator: a file-IO op is a body op, never a terminator")
			osPanicValue then panic("emitDispatcherTerminator: an `osPanicValue` is a body op, never a terminator")
			osCommandLine then panic("emitDispatcherTerminator: an `osCommandLine` is a body op, never a terminator")
			osStdHandle then panic("emitDispatcherTerminator: an `osStdHandle` is a body op, never a terminator")
			osExecutablePath then panic("emitDispatcherTerminator: an `osExecutablePath` is a body op, never a terminator")
			osWriteStderr then panic("emitDispatcherTerminator: an `osWriteStderr` is a body op, never a terminator")
			stackRecordAddr then panic("emitDispatcherTerminator: a `stackRecordAddr` is a body op, never a terminator")
			osOpenNamedSegment to osTickCountMs then panic("emitDispatcherTerminator: a DebugStream host primitive is a body op, never a terminator")
			osHandleSetInherit to osProcessTerminate then panic("emitDispatcherTerminator: an attached-subprocess host primitive is a body op, never a terminator")
			osSocketStartup to osSocketClose then panic("emitDispatcherTerminator: a socket host primitive is a body op, never a terminator")
			osCpuCount then panic("emitDispatcherTerminator: an `osCpuCount` is a body op, never a terminator")
			osThreadCpuTicks then panic("emitDispatcherTerminator: an `osThreadCpuTicks` is a body op, never a terminator")
			osDecommitPages then panic("emitDispatcherTerminator: an `osDecommitPages` is a body op, never a terminator")
			osCommitPages to osReservePages then panic("emitDispatcherTerminator: a page reserve or commit is a body op, never a terminator")
			memFill then panic("emitDispatcherTerminator: a `memFill` is a body op, never a terminator")
			atomicCas to currentThreadToken then panic("emitDispatcherTerminator: an atomic or a thread-token read is a body op, never a terminator")
			tlsAlloc to osEnterBackgroundPriority then panic("emitDispatcherTerminator: a TLS op, an event signal or the priority door is a body op, never a terminator")
		end 'term'
	end 'emitDispatcherTerminator'

	// ----------------------------------------------------------------------
	// Per-StdOp body emitters (arith + call bands)
	// ----------------------------------------------------------------------

	// Emit one non-terminator op. `ret`/`retVoid` are accepted here too (a Std `ret` is normally
	// the terminator, but is handled uniformly if it appears in a block body). Branch ops are
	// terminators and panic; the memory/system bands are out of the scalar slice and panic.
	function emitBodyOp(op StdOp)
		match op 'body'
			const(resultId, value, valueType) then self.emitConst(resultId, value: value, valueType: valueType)
			binOp(resultId, lhs, rhs, opcode, operandType) then self.emitBinOp(resultId, lhs: lhs, rhs: rhs, opcode: opcode, operandType: operandType)
			unaryOp(resultId, operand, opcode, operandType) then self.emitUnaryOp(resultId, operand: operand, opcode: opcode, operandType: operandType)
			cmp(resultId, lhs, rhs, pred, operandType) then self.emitCmp(resultId, lhs: lhs, rhs: rhs, pred: pred, operandType: operandType)
			binOpImm(resultId, lhs, imm, opcode, operandType) then self.emitBinOpImm(resultId, lhs: lhs, imm: imm, opcode: opcode, operandType: operandType)
			cmpImm(resultId, lhs, imm, pred, operandType) then self.emitCmpImm(resultId, lhs: lhs, imm: imm, pred: pred, operandType: operandType)
			div(resultId, lhs, rhs, signedness) then self.emitDivMod(resultId, lhs: lhs, rhs: rhs, isRemainder: false, signedness: signedness)
			mod(resultId, lhs, rhs, signedness) then self.emitDivMod(resultId, lhs: lhs, rhs: rhs, isRemainder: true, signedness: signedness)
			condBranch then panic("emitBodyOp: a `condBranch` is always a terminator, never a body op")
			branch then panic("emitBodyOp: a `branch` is always a terminator, never a body op")
			ret(retValId) then self.emitRet(retValId)
			param(resultId, index, _) then self.emitParam(resultId, index: index)
			call(resultId, callee, args) then self.emitCall(resultId, callee: callee, args: args)
			retVoid then self.emitRetVoid()
			globalAddr(resultId, label) then self.emitGlobalAddr(resultId, label: label)
			loadIndirect(resultId, addrId, offset, valueType) then self.emitLoadIndirect(resultId, addrId: addrId, offset: offset, valueType: valueType)
			storeIndirect(addrId, offset, valueId, valueType) then self.emitStoreIndirect(addrId, offset: offset, valueId: valueId, valueType: valueType)
			osAllocPages(resultId, sizeId) then self.emitOsAllocPages(resultId, sizeId: sizeId)
			osWriteStdout(resultId, bufId, lenId) then self.emitOsWriteStream(resultId, bufId: bufId, lenId: lenId, stream: OsOutputStream.standardOutput)
			rdataAddr(resultId, label) then self.emitRdataAddr(resultId, label: label)
			tryCall(resultId, errorFlagId, callee, args) then self.emitTryCall(resultId, errorFlagId: errorFlagId, callee: callee, args: args)
			// An `errorReturn` is normally the block terminator (like `ret`), but is handled here too for
			// the rare mid-block early-error return, exactly as `ret`/`retVoid` are above.
			errorReturn(retValId, errorFlagId) then self.emitErrorReturn(retValId, errorFlagId: errorFlagId)
			osExit(codeId) then self.emitOsExit(codeId)
			// P1.5-A1 non-capturing function values: materialize a function's table index (`funcAddr`) and
			// call THROUGH one (`callIndirect`). See the two emitters for the funcref-table lowering.
			funcAddr(resultId, funcName) then self.emitFuncAddr(resultId, funcName: funcName)
			callIndirect(resultId, calleeReg, resultType, argFloatMask, args) then self.emitCallIndirect(resultId, calleeReg: calleeReg, args: args, resultType: resultType, argFloatMask: argFloatMask)
			osPanic(label) then self.emitPanicLabel(label)
			// P1.5 mid-body-yield: the green-thread sleep substrate (`osReadClock`/`osSleepMs`) is x64-windows
			// only — its QueryPerformanceCounter clock and Windows `Sleep` have no wasm primitive, and a
			// `sleep` program is spec-gated to x64-windows, so neither op ever reaches the wasm emitter.
			osReadClock then panic("emitBodyOp: `osReadClock` is x64-windows only — the green-thread sleep substrate is x64-windows-gated at this rung")
			osSleepMs then panic("emitBodyOp: `osSleepMs` is x64-windows only — the green-thread sleep substrate is x64-windows-gated at this rung")
			// P1.5 subprocess: CreateProcessA and the wait/handle imports are x64-windows only, and an
			// `async runProcess` program is spec-gated to x64-windows, so none reaches the wasm emitter.
			osProcessSpawn to osWaitHandle then panic("emitBodyOp: the P1.5 subprocess ops are x64-windows only — the green-thread subprocess substrate is x64-windows-gated at this rung")
			// ⭐⭐ **F1a: THE THREE PAGE-LIFECYCLE OPS ARE PERMANENTLY INERT HERE — CORRECT NO-OPS, NOT STUBS AND NOT
			// GATES.** wasm linear memory only ever GROWS: `memory.grow` is the whole instruction set for it, there
			// is no shrink, no decommit and nothing to re-back. So "give this region back" translates to the EMPTY
			// instruction sequence, which is the honest lowering of a request the ISA cannot represent, and a
			// program that decommits simply keeps its bytes.
			//
			// ⛔ THIS IS SPELLED DIFFERENTLY FROM ITS NEIGHBOURS ON PURPOSE, and the arm it replaces welded the two
			// spellings together: it said `osFreePages` was x64-windows-gated (TEMPORARY — the green-thread
			// substrate will grow other lanes) AND that linear memory cannot shrink (PERMANENT — an ISA fact). Two
			// reasons of opposite lifetime in one message means the day the gate lifts, whoever reads it cannot tell
			// which half still holds. The split `osStdHandle` / `osExecutablePath` make a few arms down is the
			// model, and this is the same distinction: a WILL-NEVER, not a NOT-YET.
			//
			// ⚠ Emitting NOTHING is also stack-correct: this backend pushes operands explicitly per emitter
			// (`pushOperandAt`), so an op that emits no instruction leaves the wasm operand stack exactly as it
			// found it. There is no operand to drop.
			osFreePages then break 'body'
			osDecommitPages then break 'body'
			// F1b: the byte fill — ONE `memory.fill`, and this lane's whole size ladder. See `emitMemFill`.
			memFill(destId, byteCountId, value) then self.emitMemFill(destId, byteCountId: byteCountId, value: value)
			// ⭐⭐ **F1c: THERE IS NO RESERVATION ON THIS LANE, SO A RESERVE *IS* AN ALLOCATION AND A COMMIT IS A
			// COPY — AND BOTH ARE THE HONEST TRANSLATION RATHER THAN A STUB.** Linear memory is one contiguous
			// region whose only instruction is `memory.grow`, which takes the address range AND backs it in the
			// same step: there is no state between "not there" and "there" for a reservation to occupy. So
			// `osReservePages` routes to the SAME emitter `osAllocPages` does — not a copy of it, the same one —
			// and `osCommitPages` answers the address it was handed, because the pages it names are already
			// backed by the grow that "reserved" them.
			//
			// ⛔ THE PRICE IS REAL AND IT IS THE ARENA'S, NOT THIS EMITTER'S: a wasm reservation is CHARGED, so an
			// arena sized for a 64-bit address space is that many bytes of linear memory. Go answers the same
			// problem with a per-platform arena size (512 KiB on wasm, `vendor/go/src/runtime/malloc.go:259`);
			// see `SlabArena`'s header for why shv2 cannot yet and what the follow-up is.
			osCommitPages(resultId, addrId, _) then self.emitOsCommitPages(resultId, addrId: addrId)
			osReservePages(resultId, sizeId) then self.emitOsAllocPages(resultId, sizeId: sizeId)
			// The dense-match jump table is ALWAYS a block terminator, never a body op.
			switch then panic("emitBodyOp: a `switch` op appeared as a body op (lowering bug — the jump table is always a block terminator)")
			// P1.7a slice 2b-iv-B: constrained-type-parameter dispatch. The witness table's method slot holds a
			// funcref-TABLE INDEX on wasm (`bakeFuncTableIndexRelocs`) where the x64 writers bake a `.text` VA, so
			// the fused call is a `call_indirect` through a loaded slot. See `emitWitnessCall`.
			witnessCall(resultId, witnessAddr, methodIndex, resultType, argFloatMask, args) then self.emitWitnessCall(resultId, witnessAddr: witnessAddr, methodIndex: methodIndex, args: args, resultType: resultType, argFloatMask: argFloatMask)
			witnessTryCall(resultId, errorFlagId, witnessAddr, methodIndex, resultType, argFloatMask, args) then self.emitWitnessTryCall(resultId, errorFlagId: errorFlagId, witnessAddr: witnessAddr, methodIndex: methodIndex, args: args, resultType: resultType, argFloatMask: argFloatMask)
			// P1.5 dogfood slice 1a: the IOCP overlapped-read substrate is x64-windows only — wasm rejects rather
			// than inventing an untested lowering (it is emitted only inside the x64-windows-gated IOCP runtime).
			osPipeCreate to osWriteFile then panic("emitBodyOp: the P1.5 IOCP ops are x64-windows only — the async-subprocess-stdio substrate is x64-windows-gated at this rung")
			// The `__Builtins` WALL clock reads `GetSystemTimeAsFileTime`. WASI has `wasi:clocks/wall-clock.now`,
			// but its answer is a (seconds, nanoseconds) RECORD rather than a single 64-bit tick count, so a wasm
			// lowering is a different shape rather than a different import name — a later slice, not a rename.
			// SemanticCheck refuses a wall-clock program on wasm at its own source span (E3104), so this panic is
			// the backstop for a compiler bug that got one past that gate, not the user-facing rejection.
			osReadWallClock then panic("emitBodyOp: `osReadWallClock` is x64-windows only — the wall clock is x64-windows-gated at this rung")
			osFileOpenRead to osFileAttributes then panic("emitBodyOp: the file-IO ops are x64-windows only — file IO is x64-windows-gated at R4.1/R4.2, and SemanticCheck refuses such a program on wasm at its own source span (E3104), so this panic is the backstop for a compiler bug that got one past that gate, not the user-facing rejection")
			// The rendered message is a POINTER where the baked form names a label; both reach the one
			// `mrt_panic` this backend synthesizes (`appendPanicRuntime`), exactly as on x64 and arm64.
			osPanicValue(messagePtrId) then self.emitPanicValue(messagePtrId)
			// WASI DOES have `args_sizes_get`/`args_get`, so this one is not refused for want of a primitive — it is
			// refused because the wasm lane is SCALAR (no heap, no String, no `print`), and `CommandLine.args()`
			// answers an `Array with String`. The op could be lowered the day that lane grows those; until then a
			// lowering would be vocabulary with no reachable consumer.
			osCommandLine then panic("emitBodyOp: `osCommandLine` is x64-windows only — argv capture is x64-windows-gated, and SemanticCheck refuses such a program on wasm at its own source span (E3104), so this panic is the backstop for a compiler bug that got one past that gate, not the user-facing rejection")
			// ⚠ W5. THE TWO ARE REFUSED FOR DIFFERENT REASONS, and copying argv's sentence onto both would
			// hide the one that is permanent.
			//   • `osStdHandle`: WASI DOES have a standard input — `wasi:cli/stdin` plus a `read` on the
			//     input stream — so this is argv's case exactly. There is no HANDLE to fetch (the stream
			//     resource IS the handle), so the day the lane grows it, `__con_read_stdin` wants a different
			//     Std graph rather than a lowering for this op. That is a rung.
			//   • `osExecutablePath`: WASI has NO analogue AT ALL. A component has no image path to report,
			//     and `args_get[0]` is whatever the host chose to pass, not a resolved path — answering it
			//     would be a plausible wrong answer, which is the one thing worse than a refusal.
			osStdHandle then panic("emitBodyOp: `osStdHandle` is x64-windows only — standard input is x64-windows-gated, and SemanticCheck refuses such a program on wasm at its own source span (E3104), so this panic is the backstop for a compiler bug that got one past that gate, not the user-facing rejection")
			osExecutablePath then panic("emitBodyOp: `osExecutablePath` is x64-windows only — WASI has no executable-path primitive at all, and SemanticCheck refuses such a program on wasm at its own source span (E3104), so this panic is the backstop for a compiler bug that got one past that gate, not the user-facing rejection")
			// W35: the same emitter as the stdout write, one `wasi:cli` accessor over. Unlike its two W5
			// neighbours above this is NOT x64-windows-gated — Preview2 exports `get-stderr` beside
			// `get-stdout` and the writer is the same method, so `printError` runs on this lane.
			osWriteStderr(resultId, bufId, lenId) then self.emitOsWriteStream(resultId, bufId: bufId, lenId: lenId, stream: OsOutputStream.standardError)
			// ⛔ It cannot reach here, and a GUESS would be a wrong ANSWER rather than a missed
			// optimization: `promoteStackRecords` is gated off for this target because a wasm local has no
			// address and the module emits no shadow-stack global, so there is no frame for a slot to
			// index. If this panic ever fires, that gate was removed without giving wasm a shadow stack
			// first.
			stackRecordAddr then panic("emitBodyOp: a `stackRecordAddr` reached the wasm backend, which has no addressable frame for its slot to index — `promoteStackRecords` is gated off for wasm32-wasi precisely so this cannot happen")
			// ⛔ O3: the DebugStream producer opens a Win32 SECTION OBJECT; a WASI component has no such
			// thing and no route to one. `--debugstream` is refused at the command line for this target, so
			// this is a backstop for a compiler bug that got one past that gate.
			osOpenNamedSegment to osTickCountMs then panic("emitBodyOp: the DebugStream host primitives are x64-windows only — `--debugstream` is refused at the command line on every other target")
			// ⛔ The four attached-subprocess host primitives join the spawn/wait/pipe band above: WASI has no
			// process-spawn primitive at all, so there is nothing here to lower them to and nothing to fake.
			// `SemanticCheck.calleeNeedsWin32Substrate` refuses a program that reaches one at its own source
			// span (E3104), so this is the backstop for a compiler bug that got past that gate.
			osHandleSetInherit to osProcessTerminate then panic("emitBodyOp: the attached-subprocess host primitives are x64-windows only — WASI has no process-spawn primitive, and SemanticCheck refuses such a program on wasm at its own source span (E3104)")
			osSocketStartup to osSocketClose then panic("emitBodyOp: the socket host primitives are x64-windows only — this slice does not use WASI's `wasi:sockets`, and SemanticCheck refuses such a program on wasm at its own source span (E3104)")
			// ⛔ The MACHINE query is the strongest refusal in this match: WASI has no processor-count
			// primitive AT ALL — a component has no OS-thread concept to count — so unlike the file and
			// socket bands there is not even a preview API to wire up later. A lowering here could only
			// invent a number, and an invented core count is a silent WRONG ANSWER rather than a missing
			// feature. `SemanticCheck.calleeNeedsWin32Substrate` refuses such a program at its own source
			// span (E3104, `specs-shv2/builtins-cpu-parallel.md`'s two `rejected-on-wasm` cases), so this is
			// the backstop for a compiler bug that got past that gate.
			// ⚠ Its band-mate `__sched_max_active_workers` reaches NO op here at all: its body is a constant
			// return, so it lowers on this target through `const`/`ret` like any other function.
			osCpuCount then panic("emitBodyOp: `osCpuCount` is x64-windows only — WASI reports no processor count, and SemanticCheck refuses such a program on wasm at its own source span (E3104)")
			osThreadCpuTicks then panic("emitBodyOp: `osThreadCpuTicks` is x64-windows only — WASI exposes no per-thread CPU clock, and SemanticCheck refuses such a program on wasm at its own source span (E3104)")
			// F2: the atomics and the per-thread identity word — all three lower, and NONE is a stub.
			atomicCas(resultId, addrId, expectedId, replacementId) then self.emitAtomicCas(resultId, addrId: addrId, expectedId: expectedId, replacementId: replacementId)
			atomicRmw(resultId, addrId, operandId, opcode) then self.emitAtomicRmw(resultId, addrId: addrId, operandId: operandId, opcode: opcode)
			currentThreadToken(resultId) then self.emitCurrentThreadToken(resultId)
			// G1: a WASI component has ONE thread by construction, so per-OS-thread storage answers a question the
			// lane cannot ask, and there is no event object to signal. That is the same reason `currentThreadToken`
			// answers a constant here rather than reading anything — but a constant is the RIGHT answer for an
			// identity and a WRONG one for storage, which would silently hand every reader the same slot.
			tlsAlloc to osSetEvent then panic("emitBodyOp: the per-OS-thread storage ops and the event signal are x64-windows only — a WASI component has one thread and no kernel event object")
			// ⚠ ITS OWN ARM, and its refusal is STRONGER than "not yet" — the shape `process-id.md` records for
			// the pid. A WASI component has no process and no scheduler priority at all, so a lowering here
			// could not be incomplete, only a pretence: it would report success for something that never
			// happened. Refused at the call's own span with E3104 by the `__proc_` prefix, so this is a backstop.
			osEnterBackgroundPriority then panic("emitBodyOp: `osEnterBackgroundPriority` is x64-windows only — a WASI component has no process and no scheduler priority, so there is nothing here to lower it to")
		end 'body'
	end 'emitBodyOp'

	// ----------------------------------------------------------------------
	// F2: the atomics and the thread token, on a lane with exactly ONE thread
	// ----------------------------------------------------------------------
	//
	// ⭐⭐ **A PLAIN LOAD/COMPARE/STORE IS THE CORRECT LOWERING HERE, NOT A STUB, AND THE REASON IS
	// STRUCTURAL RATHER THAN "not implemented yet".** A `wasm32-wasi` PREVIEW-2 COMPONENT HAS ONE THREAD BY
	// CONSTRUCTION: there is no `wasi:threads`, no shared memory and no way for a component to create a
	// second thread, so no other agent can observe or interleave with these sequences. Atomicity is the
	// property "no other thread sees a torn intermediate state"; with no other thread, an ordinary load and
	// store already has it, and the `atomics` proposal's `i64.atomic.rmw.*` would encode a guarantee that
	// costs a fence to buy something nothing can contend for. ⇒ if this lane ever gains real threads, THESE
	// are the three emitters that must change, and the change is a real one — do not read the plain
	// instructions as an oversight already made.
	//
	// `atomicCas(result, addr, expected, replacement)` → load, compare, and store only on a match.
	// `result` is the SUCCESS BOOLEAN (1/0), never the prior value — see `StdOp.atomicCas`.
	function emitAtomicCas(resultId ValueId, addrId ValueId, expectedId ValueId, replacementId ValueId)
		self.pushOperandAt(addrId, targetVt: WasmValType.i32)
		self.body.i64Load(WasmAtomicWordOffset)
		self.pushOperandAt(expectedId, targetVt: WasmValType.i64)
		self.body.i64Eq()
		self.body.beginIf()
		self.pushOperandAt(addrId, targetVt: WasmValType.i32)
		self.pushOperandAt(replacementId, targetVt: WasmValType.i64)
		self.body.i64Store(WasmAtomicWordOffset)
		self.body.i64Const(AtomicCasSucceeded)
		self.body.localSet(resultId as Wasm32Index)
		self.body.elseClause()
		self.body.i64Const(AtomicCasFailed)
		self.body.localSet(resultId as Wasm32Index)
		self.body.endOp()
	end 'emitAtomicCas'

	// `atomicRmw(result, addr, operand, opcode)` → `result = *addr` then `*addr = result <op> operand`.
	// `result` is the PRIOR value, so it is captured BEFORE the update and then re-read as the update's
	// left operand — which is also why this needs no scratch local of its own.
	function emitAtomicRmw(resultId ValueId, addrId ValueId, operandId ValueId, opcode StdAtomicRmwOpcode)
		self.pushOperandAt(addrId, targetVt: WasmValType.i32)
		self.body.i64Load(WasmAtomicWordOffset)
		self.body.localSet(resultId as Wasm32Index)
		self.pushOperandAt(addrId, targetVt: WasmValType.i32)
		self.body.localGet(resultId as Wasm32Index)
		self.pushOperandAt(operandId, targetVt: WasmValType.i64)
		match opcode 'op'
			add then self.body.i64Add()
		end 'op'
		self.body.i64Store(WasmAtomicWordOffset)
	end 'emitAtomicRmw'

	// `currentThreadToken(result)` → the constant 1.
	//
	// ⭐ **THE CONSTANT SATISFIES THE WHOLE CONTRACT, WHICH IS WHY IT IS AN ANSWER AND NOT A PLACEHOLDER.**
	// The op promises a value that is per-OS-thread stable and NON-ZERO (`StdOp.currentThreadToken`); with
	// exactly one thread, a fixed non-zero word is stable across every call and distinct from every other
	// thread's token vacuously. A caller comparing two tokens for identity gets the right answer, and a
	// caller testing "is this lock owned" gets the right answer.
	function emitCurrentThreadToken(resultId ValueId)
		self.body.i64Const(WasmSingleThreadToken)
		self.body.localSet(resultId as Wasm32Index)
	end 'emitCurrentThreadToken'

	function emitConst(resultId ValueId, value ParsedInt, valueType StdType)
		if stdTypeIsFloat(valueType) 'float'
			self.emitFloatConst(value, valueType: valueType)
		end 'float' else 'int'
			self.emitIntConst(isWideInt(valueType, what: "const"), value: value)
		end 'int'
		self.body.localSet(resultId as Wasm32Index)
	end 'emitConst'

	// Materialize an f64 constant. `value` is the double's IEEE-754 bits reinterpreted as an
	// integer (the SAME ParsedInt the `.data`/`.rdata` serializer renders — see
	// GlobalDataTable.scalarImage), which `f64.const` takes as 8 raw little-endian bytes. NO
	// constant pool: unlike x64/arm64, which stash the bits in `.rdata` and load them, wasm has a
	// native f64 immediate.
	function emitFloatConst(value ParsedInt, valueType StdType)
		requireF64(valueType, what: "const")
		self.body.f64Const(value)
	end 'emitFloatConst'

	// Push an integer constant of the selected width. The i32 form takes the low 32 bits of the
	// value reinterpreted as signed, so a `u32`/negative literal encodes correctly.
	function emitIntConst(wide bool, value ParsedInt)
		if wide 'i64'
			self.body.i64Const(value)
		end 'i64' else 'i32'
			self.body.i32Const(narrowToImm32(value))
		end 'i32'
	end 'emitIntConst'

	// Push value `v` onto the stack at `targetVt`, coercing from its actual valtype when they differ.
	// A binary op's two operands must BOTH sit at the op's width, and the frontend can leave one a
	// different width — an int↔narrower change carries no Std conversion op, the same reason
	// `emitLocalCopy` coerces at a phi edge — so each operand is coerced as it is pushed. A no-op when
	// the widths already agree, so a same-width op stays byte-identical.
	function pushOperandAt(v ValueId, targetVt WasmValType)
		self.body.localGet(v as Wasm32Index)
		coerceOnStack(self.body, from: getValtype(self.valtypes, v: v), to: targetVt)
	end 'pushOperandAt'

	// Push both operands of a binary op (binOp/cmp/div/mod, integer AND float) at the op's chosen
	// width, in lhs-then-rhs order — the shape every wasm binary ALU/compare op wants on the stack.
	// The width choice is the caller's (`wasmMachineValTypeOf` for the ALU and compare ops, f64 for the
	// float path, the machine word for div/mod); this only guarantees BOTH operands are coerced to the
	// SAME `opVt` the opcode pops, so a new binary emitter cannot forget to coerce one side (the gap
	// `pushOperandAt`'s header names).
	function pushBinaryOperands(lhs ValueId, rhs ValueId, opVt WasmValType)
		self.pushOperandAt(lhs, targetVt: opVt)
		self.pushOperandAt(rhs, targetVt: opVt)
	end 'pushBinaryOperands'

	function emitBinOp(resultId ValueId, lhs ValueId, rhs ValueId, opcode StdBinOpcode, operandType StdType)
		if stdTypeIsFloat(operandType) 'float'
			self.emitFloatBinOp(resultId, lhs: lhs, rhs: rhs, opcode: opcode, operandType: operandType)
			return
		end 'float'

		self.pushBinaryOperands(lhs, rhs: rhs, opVt: wasmMachineValTypeOf(operandType))
		self.emitBinOpcode(opcode)
		self.body.localSet(resultId as Wasm32Index)
	end 'emitBinOp'

	// A FLOAT binary op — add/sub/mul, and `div` (float division rides `binOp` because it is
	// IEEE-754 pure, never a trap, unlike the integer `StdOp.div`). Both operands sit at f64; the
	// bitwise/shift opcodes have no float form and are a lowering bug here (rejected at the Maxon
	// tier for a float operand). Mirrors arm64's `lowerFloatBinOp`.
	function emitFloatBinOp(resultId ValueId, lhs ValueId, rhs ValueId, opcode StdBinOpcode, operandType StdType)
		requireF64(operandType, what: "binOp")

		// `min`/`max` are the float opcodes whose operands go on the stack TWICE, so they cannot share
		// the push-then-opcode shape the other four have — each is a compare-and-select, not an ALU op.
		// One `match` arm for the pair, exactly as arm64's `lowerFloatBinOp` routes them, so the three
		// backends read alike.
		// ⚠ `add to div` is EVERY opcode but those two — `div` is the last member before them and the bit
		// band sits inside that span, so the integer-only opcodes ride this arm too and are rejected once,
		// inside `emitFloatAluOp`, rather than by a second arm here.
		match opcode 'op'
			add to div then self.emitFloatAluOp(lhs, rhs: rhs, opcode: opcode)
			min to max then self.emitFloatMinMax(lhs, rhs: rhs, kind: floatMinMaxKindFor(opcode))
			// EC18's high multiply is INTEGER-ONLY, so it is the one opcode this dispatch cannot route
			// into `emitFloatAluOp`'s "everything else" arm — there is no float 128-bit product.
			mulHighSigned then panic("wasm: `mulHighSigned` is INTEGER-ONLY — it is the high half of a 128-bit integer product and no float form of it exists")
		end 'op'

		self.body.localSet(resultId as Wasm32Index)
	end 'emitFloatBinOp'

	// ⭐⭐ `min(a, b)` / `max(a, b)` AS A FLOAT COMPARE + `select`, WHICH IS THE LANGUAGE'S DEFINITION
	// SPELLED LITERALLY: "take `a` if `a < b` / if `a > b`, else `b`" (`StdBinOpcode`'s `min`/`max`
	// header). ONE function for both, because the two differ in the COMPARISON and in nothing else —
	// same stack discipline, same `select`, same operand order.
	//
	// ⭐ The comparison is DERIVED, not chosen here: `floatMinMaxSelectPred` says which predicate the
	// definition names and `emitFloatCmpPred` — the same door a source-level float `<` goes through —
	// emits `f64.lt` or `f64.gt`. So the intrinsics cannot drift from the operators on a NaN.
	//
	// ⚠ **wasm HAS `f64.min`/`f64.max` AND shv2 DELIBERATELY DOES NOT EMIT THEM.** `f64.min` is
	// NaN-PROPAGATING and returns −0.0 for `min(±0.0, ∓0.0)` in either operand order (and `f64.max` is
	// its mirror) — a DIFFERENT FUNCTION from the ones this language defines, and the same disagreement
	// arm64's `fmin`/`fmax` have with x64's `minsd`/`maxsd`. Rather than let the answer depend on which
	// target the program was built for (which is what both reference compilers ship — see
	// `StdBinOpcode`'s `min`/`max` header), all three targets emit the one definition.
	//
	// The sequence is EXACT, not approximate: `f64.lt`/`f64.gt` carry IEEE-754's unordered rule
	// natively — each is FALSE whenever either operand is a NaN, and FALSE when the operands compare
	// equal (where `+0.0` and `-0.0` land) — so `select` takes the second value in precisely the cases
	// x64's `minsd`/`maxsd` return their second source. No parity test or operand swap is needed.
	//
	// The stack discipline: [a, b] are the two SELECT candidates, then [a, b] again are consumed by the
	// compare to leave the i32 condition on top — `select` pops (cond, valueIfFalse, valueIfTrue) and
	// pushes `a` when cond ≠ 0. Both pushes go through `pushBinaryOperands`, so each operand is width-
	// coerced by the one helper that owns that.
	function emitFloatMinMax(lhs ValueId, rhs ValueId, kind FloatMinMaxKind)
		self.pushBinaryOperands(lhs, rhs: rhs, opVt: WasmValType.f64)
		self.pushBinaryOperands(lhs, rhs: rhs, opVt: WasmValType.f64)
		self.emitFloatCmpPred(floatMinMaxSelectPred(kind))
		self.body.select()
	end 'emitFloatMinMax'

	// The four float ALU opcodes: both operands pushed at f64, then the one native instruction.
	// `min`/`max` are not among them — each needs its operands twice — so this takes only the opcodes
	// that fit the shape, and `emitFloatBinOp`'s `match` is what decides which is which.
	function emitFloatAluOp(lhs ValueId, rhs ValueId, opcode StdBinOpcode)
		self.pushBinaryOperands(lhs, rhs: rhs, opVt: WasmValType.f64)
		match opcode 'op'
			add then self.body.f64Add()
			sub then self.body.f64Sub()
			mul then self.body.f64Mul()
			div then self.body.f64Div()
			bitAnd to shrLogical then panic("wasm: `binOp({opcode.rawValue})` has no float form — the bitwise/shift operators are integer-only and a float operand is rejected at the Maxon tier")
			min to max then panic("wasm: `{opcode.name}` is not an ALU opcode — it is a float compare + `select` (`emitFloatMinMax`), which needs each operand on the stack twice, and `emitFloatBinOp` routes it there")
			mulHighSigned then panic("wasm: `mulHighSigned` is INTEGER-ONLY and has no float form at all")
		end 'op'
	end 'emitFloatAluOp'

	// ⭐⭐ **THE WIDTH IS NEITHER `lhs`'s NOR THE OPERAND TYPE'S — IT IS THE MACHINE WORD (X5, and its
	// review).** It used to be `lhs`'s, on the reading that a folded `binOp` computes at the width of
	// the value it reads. That is what the fold DELETED rather than what it meant: `mod`'s overflow
	// mask is `add`ed onto an **i1** compare result at i64 width, so re-deriving gave a 32-bit `add`,
	// a mask recorded i32, and — through `coerceOnStack`'s zero-extend — an `and` that cleared the top
	// half of every dividend. X5 made the op CARRY `operandType` so the width would stop being guessed;
	// the review found the other half, that a narrow `operandType` is a STORAGE class and not an
	// arithmetic one, and `wasmMachineValTypeOf` is where that is now decided. `lhs` is COERCED like any
	// other binary operand, which is exactly what the unfolded `binOp` next door already did.
	function emitBinOpImm(resultId ValueId, lhs ValueId, imm Imm32, opcode StdBinOpcode, operandType StdType)
		// The immediate is pushed as a same-width const so wasm's typed ALU op is balanced
		// (`i64.shl` pops two i64s). A float `binOpImm` cannot exist — no SSE form takes an immediate,
		// so `foldConstOperands` never makes one — and the guard says so rather than letting an f64
		// operand type ride the integer ALU.
		requireIntegerOperand(operandType, what: "binOpImm")
		self.pushOperandAt(lhs, targetVt: wasmMachineValTypeOf(operandType))
		self.body.i64Const(imm)
		self.emitBinOpcode(opcode)
		self.body.localSet(resultId as Wasm32Index)
	end 'emitBinOpImm'

	// The integer ALU opcode. ONE family, because an integer op is computed at the machine word
	// (`wasmMachineValTypeOf`) — there is no width left to select on. `div` (StdBinOpcode) is FLOAT
	// division and out of the scalar slice; integer division is the separate `StdOp.div`, so a
	// `binOp(div)` here is a lowering bug.
	function emitBinOpcode(opcode StdBinOpcode)
		match opcode 'w'
			add then self.body.i64Add()
			sub then self.body.i64Sub()
			mul then self.body.i64Mul()
			bitAnd then self.body.i64And()
			bitOr then self.body.i64Or()
			bitXor then self.body.i64Xor()
			shl then self.body.i64Shl()
			shr then self.body.i64ShrS()
			shrLogical then self.body.i64ShrU()
			div to max then panic("wasm: `binOp({opcode.name})` is FLOAT-ONLY (`stdBinOpcodeIsFloatOnly`) and cannot reach the integer ALU; integer division is `StdOp.div` and there is no integer `min`/`max`")
			// ⭐⭐ **EC18 — WASM HAS NO 64x64 -> 128 MULTIPLY AT ALL, AND THAT IS WHY THE REDUCTION IS
			// TARGET-GATED RATHER THAN UNIVERSAL.** There is no `i64.mul_high_s`; the only way to spell
			// it here is four 32x32 products with carries, twenty-odd instructions against the ONE
			// `i64.div_s` the reduction would be replacing. So `StrengthReduceDivision` asks
			// `targetLowersMulHigh`, gets `false` for wasm32 and rewrites nothing — which is also why a
			// wasm golden cannot move for that row. Reaching here means the gate was bypassed.
			mulHighSigned then panic("wasm: `mulHighSigned` has no wasm form — there is no `i64.mul_high_s`, and emulating it costs ~20 instructions against the one `i64.div_s` it would replace. `StrengthReduceDivision` declines this target through `targetLowersMulHigh`; reaching here means that gate was bypassed")
		end 'w'
	end 'emitBinOpcode'

	function emitUnaryOp(resultId ValueId, operand ValueId, opcode StdUnaryOpcode, operandType StdType)
		match opcode 'op'
			neg then self.emitNegExpr(operand, operandType: operandType)
			bitNot then self.emitBitNotExpr(operand, operandType: operandType)
			logicalNot then self.emitLogicalNotExpr(operand)
			siToFp then self.emitSiToFp(operand, operandType: operandType)
			fpToSi then self.emitFpToSi(operand, operandType: operandType)
			// The MATH INTRINSICS. Each is ONE native wasm instruction over the same f64 operand, so
			// the operand push and the domain check are written once and only the opcode differs.
			floor to abs then self.emitMathIntrinsic(operand, operandType: operandType, opcode: opcode)
			bitcastF64ToI64 then self.emitBitcastF64ToI64(operand, operandType: operandType)
			bitcastI64ToF64 then self.emitBitcastI64ToF64(operand, operandType: operandType)
		end 'op'
		self.body.localSet(resultId as Wasm32Index)
	end 'emitUnaryOp'

	// int -> f64 (`promoteToFloat`). ⚠ `operandType` is the SOURCE, an INTEGER — the opcode names
	// the RESULT (see StdUnaryOpcode's header). `f64.convert_i64_s` reads a signed i64, so a
	// narrower int source (a promoted i32 ExitCode literal, say) is widened first — the same
	// width-gap `pushOperandAt` closes for a mixed-width binOp. The result is f64 (the valtype
	// table records `siToFp` -> f64).
	function emitSiToFp(operand ValueId, operandType StdType)
		if stdTypeIsFloat(operandType) 'notInt'
			panic("wasm: `siToFp` with a FLOAT operand type — a conversion's operandType is its SOURCE, which for siToFp is an integer (the Maxon tier's assertConversionCrossesDomain enforces this)")
		end 'notInt'
		self.pushOperandAt(operand, targetVt: WasmValType.i64)
		self.body.f64ConvertI64S()
	end 'emitSiToFp'

	// f64 -> int, TRUNCATING toward zero — the `trunc()` bridge nearly every float test ends on.
	// `operandType` is the SOURCE, an f64. `i64.trunc_f64_s` (the `_s`/trunc form, NOT a rounding
	// one — `trunc(3.99)` is 3, not 4) yields a signed i64; the result is recorded i64, and a
	// narrower consumer (`return trunc(x)` into an i32 ExitCode) narrows it through the usual `ret`
	// coercion.
	function emitFpToSi(operand ValueId, operandType StdType)
		requireF64(operandType, what: "fpToSi source")
		self.pushOperandAt(operand, targetVt: WasmValType.f64)
		self.body.i64TruncF64S()
	end 'emitFpToSi'

	// f64 → f64 — the five MATH INTRINSICS. Unlike the conversions above, `operandType` here is BOTH
	// the source and the result: these stay inside the float domain, which is what
	// `stdUnaryOperandIsFloat` says and what the valtype table records (`floor to abs` → f64).
	//
	// ⚠ `round` is `f64.nearest`, which is TIES TO EVEN — `round(2.5)` is 2. The three native
	// backends' instructions agree; there is no correction layer on any of them.
	//
	// ⭐ ALL FIVE ARE ONE INSTRUCTION HERE, INCLUDING `abs` — which is what makes wasm the target that
	// shows x64's `abs` gap for what it is. `f64.abs` clears the sign bit natively; SSE2 has no scalar
	// equivalent, so only the x64 isel has to synthesize it (`TargetOp.absF64RegReg`).
	function emitMathIntrinsic(operand ValueId, operandType StdType, opcode StdUnaryOpcode)
		requireF64(operandType, what: "math intrinsic source")
		self.pushOperandAt(operand, targetVt: WasmValType.f64)
		match opcode 'k'
			floor then self.body.f64Floor()
			ceil then self.body.f64Ceil()
			round then self.body.f64Nearest()
			sqrt then self.body.f64Sqrt()
			abs then self.body.f64Abs()
			neg to fpToSi then panic("emitMathIntrinsic: Std unary opcode {opcode.name} is not a math intrinsic — `emitUnaryOp` routes only floor/ceil/round/sqrt/abs here")
			// ONE arm for both directions: a reinterpretation computes nothing whichever way the bits
			// travel, and `emitUnaryOp` routes each to its own emitter.
			bitcastF64ToI64 to bitcastI64ToF64 then panic("emitMathIntrinsic: `{opcode.name}` computes nothing — it reinterprets the operand's bits, and `emitUnaryOp` routes it to `emitBitcastF64ToI64`/`emitBitcastI64ToF64`")
		end 'k'
	end 'emitMathIntrinsic'

	// f64 → i64 REINTERPRETATION (`float.hash`) — `i64.reinterpret_f64` (0xBD), one native instruction
	// with the same 64 bits on both sides. `operandType` is the f64 SOURCE, as on every cross-class
	// unary op here; the RESULT's i64 valtype is `unaryResultValType`'s to state, and the `localSet`
	// `emitUnaryOp` appends writes the i64 local that table declared.
	function emitBitcastF64ToI64(operand ValueId, operandType StdType)
		requireF64(operandType, what: "bitcast source")
		self.pushOperandAt(operand, targetVt: WasmValType.f64)
		self.body.i64ReinterpretF64()
	end 'emitBitcastF64ToI64'

	// i64 → f64 REINTERPRETATION (`__Builtins.bitsToFloat`) — `f64.reinterpret_i64` (0xBF), the exact
	// inverse of the emitter above and the only unary emitter here whose SOURCE is an integer and whose
	// result is a float without a conversion having happened.
	//
	// ⚠ IT REFUSES A NARROWER SOURCE rather than widening one, which is where it parts company with
	// `emitSiToFp` beside it. A conversion of an i32 to f64 is a well-defined number-preserving
	// operation, so widening first is right there; a reinterpretation of an i32 is not a smaller
	// version of anything — the missing 32 bits ARE the resulting double's sign and exponent, and
	// `pushOperandAt` would invent them as zeros. `isWideInt` already refuses a float source.
	function emitBitcastI64ToF64(operand ValueId, operandType StdType)
		if not isWideInt(operandType, what: "bitcast source") 'narrowSource'
			panic("wasm: `bitcastI64ToF64` on {operandType.name} — a reinterpretation is 64 bits for 64 bits, and a narrower integer source would leave the resulting double's exponent and sign invented rather than read")
		end 'narrowSource'
		self.pushOperandAt(operand, targetVt: WasmValType.i64)
		self.body.f64ReinterpretI64()
	end 'emitBitcastI64ToF64'

	// Integer negate as `0 - operand` (wasm has no unary negate), at the MACHINE WORD like every other
	// integer op. The operand is coerced rather than pushed bare: the frontend can leave it a
	// different width — `-r` on an `ExitCode` lives in an i32 — same gap as a mixed-width binOp, and
	// it faults the same way (`i64.sub` over an i32) without the coercion.
	function emitNegExpr(operand ValueId, operandType StdType)
		requireIntegerOperand(operandType, what: "neg")
		self.body.i64Const(0)
		self.pushOperandAt(operand, targetVt: wasmMachineValTypeOf(operandType))
		self.body.i64Sub()
	end 'emitNegExpr'

	// Bitwise complement as `operand xor -1` (all-ones flips every bit), at the machine word for
	// `emitNegExpr`'s reason — and with a sharper one of its own: an `xor -1` at 32 bits answers
	// 294,967,295 where the language answers -4,000,000,001, because the top half of the complement is
	// exactly what a narrow op drops.
	function emitBitNotExpr(operand ValueId, operandType StdType)
		requireIntegerOperand(operandType, what: "bitNot")
		self.pushOperandAt(operand, targetVt: wasmMachineValTypeOf(operandType))
		self.body.i64Const(-1)
		self.body.i64Xor()
	end 'emitBitNotExpr'

	// Logical NOT of a 0/1 bool as `operand xor 1` (flip bit 0), matching the native backends'
	// `eor #1` / `xor reg, 1` convention. ⚠ THE OPERAND IS COERCED TO i32, not pushed bare: a bool
	// is usually an i1 → i32 local, but a bool-RETURNING function lowers to an i64 return in this
	// tier (`__str_eq` returns i64), so `not (a == b)` on Strings hands this an i64 operand — and a
	// bare `i32.xor` over it faults the typed stack (i64 vs i32). `pushOperandAt` wraps the i64 to
	// i32 first (a no-op for an already-i32 bool, so the scalar case stays byte-identical) — the same
	// width gap `emitNegExpr`/`emitBitNotExpr` already close for their operands.
	function emitLogicalNotExpr(operand ValueId)
		self.pushOperandAt(operand, targetVt: WasmValType.i32)
		self.body.i32Const(1 as Imm32)
		self.body.i32Xor()
	end 'emitLogicalNotExpr'

	function emitCmp(resultId ValueId, lhs ValueId, rhs ValueId, pred StdCmpPred, operandType StdType)
		if stdTypeIsFloat(operandType) 'float'
			self.emitFloatCmp(resultId, lhs: lhs, rhs: rhs, pred: pred, operandType: operandType)
			return
		end 'float'

		self.pushBinaryOperands(lhs, rhs: rhs, opVt: wasmMachineValTypeOf(operandType))
		self.emitCmpPred(pred, isUnsigned: stdTypeIsUnsigned(operandType))
		self.body.localSet(resultId as Wasm32Index)
	end 'emitCmp'

	// A FLOAT compare pops two f64s and pushes an i32 (0/1) — the same i1->i32 bool an integer
	// compare yields, so its result local is i32 (the valtype table records every `cmp` as i32).
	// ⭐ NO OPERAND SWAP, NO PARITY TEST: wasm's f64 compares carry IEEE-754 unordered semantics
	// natively — each relational predicate is FALSE when either operand is NaN and `f64.ne` is TRUE
	// — which is exactly the NaN-safe answer x64's `ucomisd`/`jp` dance and arm64's float condition
	// family build by hand. One opcode delivers it. (There is no float `cmpImm`: `binOpImm`/`cmpImm`
	// are integer-only — no SSE/wasm compare takes an encoded immediate — so `foldConstOperands`
	// never folds a float rhs, and this emitter is the only float-compare path.)
	function emitFloatCmp(resultId ValueId, lhs ValueId, rhs ValueId, pred StdCmpPred, operandType StdType)
		requireF64(operandType, what: "cmp")
		self.pushBinaryOperands(lhs, rhs: rhs, opVt: WasmValType.f64)
		self.emitFloatCmpPred(pred)
		self.body.localSet(resultId as Wasm32Index)
	end 'emitFloatCmp'

	function emitFloatCmpPred(pred StdCmpPred)
		match pred 'p'
			eq then self.body.f64Eq()
			ne then self.body.f64Ne()
			lt then self.body.f64Lt()
			gt then self.body.f64Gt()
			le then self.body.f64Le()
			ge then self.body.f64Ge()
		end 'p'
	end 'emitFloatCmpPred'

	// The compare is at the MACHINE WORD, for `emitBinOpImm`'s reason and with its own worst case: a
	// `u32` value (an `ExitCode`) above `i32.max` sits in an i32 with its top bit set, so a compare at
	// 32 bits reads it as NEGATIVE — `e > 100` answered `le` here while x64 answered `gt`. X5 read that
	// width off `lhs`, its review off `operandType`; BOTH say 32 for an `ExitCode`, and the native
	// backends' 64-bit `cmp` over the same zero-extended register says `gt`. Widening `lhs` first is
	// what makes the three targets answer one question.
	function emitCmpImm(resultId ValueId, lhs ValueId, imm Imm32, pred StdCmpPred, operandType StdType)
		requireIntegerOperand(operandType, what: "cmpImm")
		self.pushOperandAt(lhs, targetVt: wasmMachineValTypeOf(operandType))
		self.body.i64Const(imm)
		self.emitCmpPred(pred, isUnsigned: stdTypeIsUnsigned(operandType))
		self.body.localSet(resultId as Wasm32Index)
	end 'emitCmpImm'

	// A wasm compare pops two operands and pushes an i32 (0/1) — exactly the i1→i32 bool the Std
	// `cmp`/`cmpImm` result is typed as, so no extension is needed. Both families are emitted over
	// MACHINE-WORD operands, which is what makes the answer right for a narrow value either way: it
	// arrives zero-extended, so its top bit is a value bit at 64 and only a sign bit at 32.
	//
	// ⭐⭐ **THE SIGNEDNESS RIDES IN THE OPCODE HERE, WHERE THE NATIVE TARGETS PUT IT IN A CONDITION
	// CODE.** wasm has no flags, so there is nothing for a second instruction to read: `i64.lt_s` and
	// `i64.lt_u` are two whole comparisons, and the choice between them is the entirety of what the
	// ordering rule decides on this target. The verdict arrives the same way it does on x64 and arm64 —
	// as the compare's `operandType` (`LowerMaxonToStd.lowerCompare`) — so the three backends read ONE
	// fact and cannot answer a `<` differently for the same two declared ranges.
	//
	// ⚠ `eq`/`ne` HAVE ONE OPCODE EACH AND TAKE IT IN BOTH FAMILIES, which is this target's own statement
	// of why the rule governs ORDERING only: wasm does not define an `i64.eq_u`, because there would be
	// nothing for it to do.
	function emitCmpPred(pred StdCmpPred, isUnsigned bool)
		if isUnsigned 'unsignedFamily'
			match pred 'u'
				eq then self.body.i64Eq()
				ne then self.body.i64Ne()
				lt then self.body.i64LtU()
				gt then self.body.i64GtU()
				le then self.body.i64LeU()
				ge then self.body.i64GeU()
			end 'u'
			return
		end 'unsignedFamily'

		match pred 'w'
			eq then self.body.i64Eq()
			ne then self.body.i64Ne()
			lt then self.body.i64LtS()
			gt then self.body.i64GtS()
			le then self.body.i64LeS()
			ge then self.body.i64GeS()
		end 'w'
	end 'emitCmpPred'

	// Integer division / remainder, AT MACHINE WIDTH, at the signedness the front end decided from
	// BOTH operands (`IntegerSignedness`). wasm traps natively on a zero divisor and — for the SIGNED
	// pair only — on INT_MIN/-1, matching the intended semantics; the Tier-1 division specs all use
	// non-zero divisors (CONTRACT §4.7). `i64.div_u`/`i64.rem_u` have no overflow trap at all, which
	// is the same asymmetry x64's zeroed RDX gives and arm64's `udiv` gives.
	//
	// ⭐⭐ **THE ONE OP PAIR WITH NO WIDTH OF ITS OWN, AND THE WIDTH IS NOT `lhs`'s (X5).** It was:
	// `div`/`mod` carry no `operandType` (x64's `idiv` needs none — every GPR is 64-bit), so the
	// width and the result's were copied from the left operand. That reads a value's STORAGE class
	// as if it were the operation's type, and the two part company exactly where an int→int
	// promotion does — which emits NO conversion op, so a `u32` `ExitCode` divided as a machine word
	// still SITS in an i32. `4000000000 / 7` was computed by `i32.div_s` over a bit pattern whose top
	// bit is set: `4252829111` here against x64's `571428571`. See `specs-shv2/division.md`
	// `divide-a-value-whose-declared-type-is-narrower-than-a-machine-word`.
	//
	// ⭐ Computing at i64 is EXACT rather than merely wider, and that rests on a property this
	// backend already states once: every narrow value shv2 mints is UNSIGNED and sits ZERO-EXTENDED
	// in its i32 (`coerceOnStack`'s header — read it for the LIMIT of that claim too: it is exact for
	// every value INSIDE its declared type's range, and nothing enforces that range). So widening
	// recovers the number itself, and the signed 64-bit
	// divide then answers what the native backends' 64-bit `idiv`/`sdiv` answer over the same
	// two registers — the three targets agree by construction instead of by coincidence. A narrow
	// CONSUMER of the quotient wraps it back at its own operand push, as any other i64 value would be.
	//
	// ⭐ THAT ARGUMENT IS NO LONGER THIS PAIR'S ALONE (X5 review): it is `wasmMachineValTypeOf`, and every
	// integer op obeys it. `div`/`mod` were merely the two that could not have done otherwise, having
	// no operand type to be misled by — the ops that HAVE one were being misled by it.
	function emitDivMod(resultId ValueId, lhs ValueId, rhs ValueId, isRemainder bool, signedness IntegerSignedness)
		self.pushBinaryOperands(lhs, rhs: rhs, opVt: WasmValType.i64)
		let unsigned = signedness == IntegerSignedness.unsigned
		if isRemainder 'rem'
			if unsigned 'remU'
				self.body.i64RemU()
			end 'remU' else 'remS'
				self.body.i64RemS()
			end 'remS'
		end 'rem' else 'div'
			if unsigned 'divU'
				self.body.i64DivU()
			end 'divU' else 'divS'
				self.body.i64DivS()
			end 'divS'
		end 'div'
		self.body.localSet(resultId as Wasm32Index)
	end 'emitDivMod'

	// A parameter already occupies its own local (id == index in the scalar ABI), so the copy is
	// emitted only for the general case where the two differ.
	function emitParam(resultId ValueId, index ParamCount)
		if resultId != index 'needsCopy'
			self.body.localGet(index as Wasm32Index)
			self.body.localSet(resultId as Wasm32Index)
		end 'needsCopy'
	end 'emitParam'

	// Push each argument (in parameter order — `lowerCall` already reordered any labelled args), each
	// coerced to the callee's declared parameter width, then emit the `call`. The argument marshalling
	// and the call itself are IDENTICAL for a plain `call` and a throwing `tryCall` — only the RESULT
	// capture differs (a plain call reads one value or none; a `tryCall` reads the value AND the error
	// flag off the callee's multi-value return), so both share this.
	function emitCallArgsAndCall(callee ByteArray, args ValueIdArray)
		let paramTypes = try self.calleeParamTypes.get(callee) otherwise panic("emitCall: no param types for callee '{String.from(callee)}'")
		for argIdx in 0 upto args.count() 'eachArg'
			let arg = try args.get(argIdx) otherwise panic("emitCall: args.get OOB at {argIdx}")
			self.body.localGet(arg as Wasm32Index)
			let paramVt = try paramTypes.get(argIdx) otherwise panic("emitCall: callee '{String.from(callee)}' declares fewer params than the {argIdx + 1} args passed")
			coerceOnStack(self.body, from: getValtype(self.valtypes, v: arg), to: paramVt)
		end 'eachArg'

		let funcIdx = try wasmFuncIdxOf(self.funcNames, callee: callee) otherwise panic("emitCall: no wasm function index for callee '{String.from(callee)}'")
		self.body.call(funcIdx)
	end 'emitCallArgsAndCall'

	// A plain (non-throwing) call: marshal the args, call, and store the single result only when the
	// callee returns a value (a void callee pushes nothing — a `local.set` would underflow).
	function emitCall(resultId ValueId, callee ByteArray, args ValueIdArray)
		self.emitCallArgsAndCall(callee, args: args)

		let rt = (try self.funcNames.funcNamed(callee) otherwise panic("emitCall: no return type for callee '{String.from(callee)}'")).returnType
		if not stdReturnTypeIsVoid(rt) 'hasResult'
			self.body.localSet(resultId as Wasm32Index)
		end 'hasResult'
	end 'emitCall'

	// A call to a callee that uses the SECONDARY RETURN SLOT — `resultId = try callee(args…)`, or since
	// P1.7a slice 2 an interface-returning `resultId = callee(args…)` whose second word is the WITNESS half.
	// Marshal + call exactly as `emitCall`, then capture the callee's MULTI-VALUE return. Such a callee's
	// wasm signature is `(params) -> (resultVt, i64)` (value-returning) or `(params) -> (i64)` (void), so its
	// results sit on the stack with the i64 SECOND WORD on TOP. `local.set` pops top-first, so that word is
	// captured FIRST, then the primary value — for a void-returning throwing callee the call pushes only the
	// second word, so there is no value to capture (the index answers with the callee's OWN return type,
	// void-vs-value). The two captures never need the native backends' parallel-copy resolver: a wasm stack
	// pop targets a distinct local, so there is no register-cycle to break. A `tryCall` reaches here only for
	// a callee whose signature declares the second result — `funcSignatureResultValTypes` and the frontend's
	// return emitters ask ONE predicate — so it is always present.
	function emitTryCall(resultId ValueId, errorFlagId ValueId, callee ByteArray, args ValueIdArray)
		self.emitCallArgsAndCall(callee, args: args)

		self.body.localSet(errorFlagId as Wasm32Index)

		let rt = (try self.funcNames.funcNamed(callee) otherwise panic("emitTryCall: no return type for callee '{String.from(callee)}'")).returnType
		if not stdReturnTypeIsVoid(rt) 'hasResult'
			self.body.localSet(resultId as Wasm32Index)
		end 'hasResult'
	end 'emitTryCall'

	// A function VALUE (`funcAddr`, P1.5-A1): its wasm value is the callee's TABLE INDEX. The module builds
	// one funcref table with table[i] == function i, so a function's table index equals its wasm funcIdx —
	// exactly what `wasmFuncIdxOf` derives. Materialized as an i64: a function value's Std type is a
	// machine word, so it flows through params/fields/returns/block-args as i64 like every other value, and
	// is narrowed to the i32 table-index operand only at the `call_indirect` (`emitCallIndirect`). This is
	// the `.text`-address sibling of `emitGlobalAddr`/`emitRdataAddr`, but a value that FLOWS rather than an
	// address consumed in place — which is why it is i64 here, not the i32 those two produce.
	function emitFuncAddr(resultId ValueId, funcName ByteArray)
		let funcIdx = try wasmFuncIdxOf(self.funcNames, callee: funcName) otherwise panic("emitFuncAddr: no wasm function index for function value '{String.from(funcName)}'")
		self.body.i64Const(funcIdx)
		self.body.localSet(resultId as Wasm32Index)
	end 'emitFuncAddr'

	// A call THROUGH a function value (`callIndirect`, P1.5-A1): `resultId = calleeReg(args…)`. Marshal each
	// argument coerced to ITS wasm valtype (`indirectCallArgValType`, off the op's two per-argument ABI bits),
	// push the table index (the function value, wrapped from its i64 flow-width down to the i32
	// `call_indirect` operand), then `call_indirect (type $sig) (table 0)`. `$sig` is the pre-interned
	// `(paramTypes) -> resultType` functype for THIS signature, which wasm checks at runtime against the
	// funcref's OWN type — and since the callee thunk / lifted closure declares the same param/return
	// valtypes, the two match. The result takes the function value's own return width.
	//
	// ⭐ WHY the signature reaches the wasm tier ON THE OP (P1.5 #78). A function value now carries floats,
	// so the old "every function value is `(i64^n) -> i64`" fact no longer holds: `(f64) -> f64` and
	// `(i64) -> i64` are distinct wasm functypes of the same arity, and pushing a float arg as i64 or
	// declaring the result i64 would mismatch the funcref's real type at the `call_indirect` type check. The
	// Std `callIndirect` therefore carries `resultType`/`argFloatMask`, the SAME facts x64/arm64 use to pick
	// the result's and each arg's register file, recovered by the front end from the callee's DECLARED
	// parameter types (`LowerMaxonToStd.paramFloatMask`). It carries no WIDTH: every wasm signature this
	// backend declares is at the machine word (`wasmMachineValTypeOf`), so an integer argument's width is not
	// a per-site fact and cannot disagree with the target's own. `pushIndirectArgs` coerces each value to the
	// declared arg valtype exactly as a direct `call` does; a value already at that width coerces to a
	// no-op.
	function emitCallIndirect(resultId ValueId, calleeReg ValueId, args ValueIdArray, resultType StdReturnType, argFloatMask ArgFloatMask)
		self.pushIndirectArgs(args, argFloatMask: argFloatMask)
		self.pushOperandAt(calleeReg, targetVt: WasmValType.i32)
		self.emitIndirectCallOp(resultType, argFloatMask: argFloatMask, argCount: args.count(), isThrowing: false, what: "emitCallIndirect")
		self.captureIndirectResult(resultId, resultType: resultType)
	end 'emitCallIndirect'

	// Push an indirect call's arguments, each coerced to ITS wasm valtype through `indirectCallArgValType` —
	// the SAME door `indirectCallParamValTypes` builds the interned functype's parameter list from, so an
	// operand can never be pushed at a width the declared type will then be checked against. Shared by the
	// function-value and witness call emitters, so those two cannot drift from each other either.
	function pushIndirectArgs(args ValueIdArray, argFloatMask ArgFloatMask)
		for argIdx in 0 upto args.count() 'eachArg'
			let arg = try args.get(argIdx) otherwise panic("pushIndirectArgs: args.get OOB at {argIdx}")
			self.pushOperandAt(arg, targetVt: indirectCallArgValType(argFloatMask, argIndex: argIdx))
		end 'eachArg'
	end 'pushIndirectArgs'

	// Emit the `call_indirect` itself, recovering the pre-interned type index by rebuilding the signature key
	// through the same two helpers `internIndirectCallType` built it with — the invariant that keeps the
	// call-site immediate and the interned type from disagreeing. The table index must already be on top of
	// the stack. `what` names the calling emitter so a missing intern reports against the op that has one.
	function emitIndirectCallOp(resultType StdReturnType, argFloatMask ArgFloatMask, argCount ParamCount, isThrowing bool, what String)
		let params = indirectCallParamValTypes(argFloatMask, argCount: argCount)
		let sigKey = encodeFuncType(params, results: indirectCallResultValTypes(resultType, usesSecondarySlot: isThrowing))
		let typeIdx = try self.indirectCallTypeIdx.get(sigKey) otherwise panic("{what}: no interned functype for this {argCount}-argument indirect call signature — buildIndirectCallTypeIdxMap missed it")
		self.body.callIndirect(typeIdx)
	end 'emitIndirectCallOp'

	// Store an indirect call's PRIMARY result. A VOID callee (a raw element destructor, a void interface
	// method) pushes nothing, so there is no result to store — storing would underflow the typed stack. A
	// value one leaves its result on top for the `local.set`.
	function captureIndirectResult(resultId ValueId, resultType StdReturnType)
		if not stdReturnTypeIsVoid(resultType) 'hasResult'
			self.body.localSet(resultId as Wasm32Index)
		end 'hasResult'
	end 'captureIndirectResult'

	// ⭐ **THE FUSED `witnessCall` (P1.7a slice 2b-iv-B) — a `call_indirect` whose table index is LOADED FROM
	// MEMORY.** The x64 lowering is a memory-indirect `call qword [witnessAddr + 24 + 8*i]`, where the loaded
	// function pointer is dereferenced by the call itself and never occupies a register; wasm's `call_indirect`
	// takes its callee off the operand stack, so the same shape is: push the args, then push the slot's
	// contents — the callee's funcref-TABLE INDEX, baked there by `bakeFuncTableIndexRelocs` — and call. The
	// loaded index likewise never occupies a LOCAL (v1's wasm witness lowering leaves it on the stack too).
	//
	// The slot is 8 bytes wide on every target (`WitnessSlotBytes`), so it is read with an `i64.load` and
	// narrowed to the i32 table-index operand — the same i64-flow/i32-operand split `emitFuncAddr` documents
	// for a function VALUE.
	function emitWitnessCall(resultId ValueId, witnessAddr ValueId, methodIndex WitnessMethodIndex, args ValueIdArray, resultType StdReturnType, argFloatMask ArgFloatMask)
		self.emitWitnessCallSequence(witnessAddr, methodIndex: methodIndex, args: args, resultType: resultType, argFloatMask: argFloatMask, isThrowing: false, what: "emitWitnessCall")
		self.captureIndirectResult(resultId, resultType: resultType)
	end 'emitWitnessCall'

	// ⭐ **THE THROWING FUSED `witnessTryCall`** — `emitWitnessCall` plus the one thing `emitTryCall` adds to
	// `emitCall`: the callee's SECOND multi-value result, the i64 error flag. It sits on TOP of the primary
	// (`errorReturn` pushes value-then-flag), and `local.set` pops top-first, so the flag is captured FIRST.
	// A VOID throwing interface method returns the flag alone, and `captureIndirectResult` stores nothing.
	function emitWitnessTryCall(resultId ValueId, errorFlagId ValueId, witnessAddr ValueId, methodIndex WitnessMethodIndex, args ValueIdArray, resultType StdReturnType, argFloatMask ArgFloatMask)
		self.emitWitnessCallSequence(witnessAddr, methodIndex: methodIndex, args: args, resultType: resultType, argFloatMask: argFloatMask, isThrowing: true, what: "emitWitnessTryCall")
		self.body.localSet(errorFlagId as Wasm32Index)
		self.captureIndirectResult(resultId, resultType: resultType)
	end 'emitWitnessTryCall'

	// The argument marshalling, the method-slot load and the `call_indirect` itself — everything a witness
	// call does BEFORE its results are captured. ONE home, shared by the throwing and non-throwing forms so
	// the two cannot drift on the slot offset or on argument slotting, mirroring x64's
	// `emitWitnessCallSequence` (a divergence there would be a silently mis-dispatched method, not a compile
	// error).
	function emitWitnessCallSequence(witnessAddr ValueId, methodIndex WitnessMethodIndex, args ValueIdArray, resultType StdReturnType, argFloatMask ArgFloatMask, isThrowing bool, what String)
		self.pushIndirectArgs(args, argFloatMask: argFloatMask)

		// The witness table's linear-memory address: an i32 whether it arrived as an `rdataAddr` (already i32)
		// or as a threaded witness PARAMETER (an i64 machine word, wrapped here).
		self.pushOperandAt(witnessAddr, targetVt: WasmValType.i32)
		self.body.i64Load(witnessMethodSlotOffset(methodIndex) as Wasm32Index)
		self.body.i32WrapI64()

		self.emitIndirectCallOp(resultType, argFloatMask: argFloatMask, argCount: args.count(), isThrowing: isThrowing, what: what)
	end 'emitWitnessCallSequence'

	// Value return: push the return value and `return`. A `void` return type here means a value
	// `ret` in a void function — the parser rejects that source, so it is a lowering bug.
	function emitRet(retValId ValueId)
		if stdReturnTypeIsVoid(self.func.returnType) 'void'
			panic("emitRet: a value `ret` in a void-returning function — a void return lowers to `retVoid`")
		end 'void'
		self.body.localGet(retValId as Wasm32Index)
		let resultTypes = funcResultValTypes(self.func.returnType)
		let resultVt = try resultTypes.get(0) otherwise panic("emitRet: value-returning function has no result valtype")
		coerceOnStack(self.body, from: getValtype(self.valtypes, v: retValId), to: resultVt)
		self.body.returnOp()
	end 'emitRet'

	// Void return: nothing on the stack, bare `return`. A value return type here would leave the
	// caller reading nothing — the parser rejects that source, so it is a lowering bug.
	function emitRetVoid()
		if not stdReturnTypeIsVoid(self.func.returnType) 'valueExpected'
			panic("emitRetVoid: a `retVoid` in a value-returning function — the caller would read nothing")
		end 'valueExpected'
		self.body.returnOp()
	end 'emitRetVoid'

	// The dual-register `errorReturn(retVal, second)` mapped onto wasm multi-value — the ONLY exit a function
	// using the SECONDARY RETURN SLOT takes. The frontend routes every return of such a function through this
	// op (a throwing one's normal return carries a ZERO flag and its `throw` a non-zero one; an
	// interface-returning one carries the WITNESS half — LowerMaxonToStd.emitRetOrErrorReturn /
	// lowerThrowError), so it never emits a plain `ret`/`retVoid`, and this
	// is the wasm twin of the native `lowerErrorReturn` (which writes R8 + R10). The signature declares
	// `(resultVt, i64)` for a value-returning function and `(i64)` for a void one (`funcSignature-
	// ResultValTypes`), so the stack must hold the value THEN the flag (value-returning) or just the
	// flag (void). The primary value is coerced to the result valtype exactly as `emitRet` does — the
	// same value-meets-declared-type width gap. For a void-returning throwing function the op still
	// carries a placeholder `retVal`, but the signature has no value result, so it is DROPPED (not
	// pushed): only the flag is returned.
	function emitErrorReturn(retValId ValueId, errorFlagId ValueId)
		if not stdReturnTypeIsVoid(self.func.returnType) 'value'
			self.body.localGet(retValId as Wasm32Index)
			let resultTypes = funcResultValTypes(self.func.returnType)
			let resultVt = try resultTypes.get(0) otherwise panic("emitErrorReturn: value-returning function has no result valtype")
			coerceOnStack(self.body, from: getValtype(self.valtypes, v: retValId), to: resultVt)
		end 'value'

		self.body.localGet(errorFlagId as Wasm32Index)
		// The flag is always i64 (a zero `const`, a scalar `ordinal + bias`, or a propagated `tryCall`
		// flag — all i64), so this coercion is a no-op; it is kept for the same value-meets-declared-type
		// robustness every other push in this file carries, and matches the i64 second result the
		// signature declares.
		coerceOnStack(self.body, from: getValtype(self.valtypes, v: errorFlagId), to: WasmValType.i64)
		self.body.returnOp()
	end 'emitErrorReturn'

	// `osExit(code)` — the process-exit primitive a `panic(...)` ends on (LowerMaxonToStd.lowerPanic-
	// Abort). Hand the code to the `exit-with-code` import (func idx 0), wrapped to the i32 the import
	// declares — `code` is an i64 in the Std IR, so `pushOperandAt` emits the `i32.wrap_i64`. wasmtime
	// masks the status to the low 8 bits, matching the native `ExitProcess`/`_exit`. `exit-with-code`
	// never returns, so `unreachable` follows: the process is gone and the dead return the parser emits
	// after this op is unreachable code (the trailing `unreachable` also makes the stack polymorphic, so
	// that dead terminator validates whatever result arity the function declares). Defines no value.
	function emitOsExit(codeId ValueId)
		self.pushOperandAt(codeId, targetVt: WasmValType.i32)
		self.body.call(ExitImportFuncIdx)
		self.body.unreachable()
	end 'emitOsExit'

	// `osPanic(label)` — a panic whose whole line was baked into `.rdata` at compile time (a P1.9
	// range-check violation, or a `panic("literal")`). The label's address is a compile-time i32 on
	// this fixed-base target, exactly as in `emitRdataAddr`, so the site is two instructions.
	//
	// ⚠ **THIS EMITTED A BARE `exit-with-code` AND PRINTED NOTHING UNTIL W3**, and the comment that
	// stood here said so — correctly, at the time: *"the real reason wasm exits bare is that nobody has
	// written a wasm `mrt_panic`."* Somebody now has (`appendPanicRuntime`), and both spellings of a
	// panic route to it, so this lane says as much as the other four.
	function emitPanicLabel(label ByteArray)
		self.body.i32Const(self.rdataLabelAddress(label))
		self.emitPanicCall()
	end 'emitPanicLabel'

	// `osPanicValue(messagePtr)` — the RENDERED twin (A3n): an interpolation assembled the whole line at
	// run time and this is its ADDRESS. The pointer is an i64 in the Std IR (a machine word on the
	// register backends) and an address is an i32 here, so `pushOperandAt` wraps it — the sole difference
	// from the baked form, mirroring x64's and arm64's `lowerPanicValue`, which likewise differ from
	// their `lowerPanic` only in how the first argument is produced.
	function emitPanicValue(messagePtrId ValueId)
		self.pushOperandAt(messagePtrId, targetVt: WasmValType.i32)
		self.emitPanicCall()
	end 'emitPanicValue'

	// The call both panic spellings end on, with the message pointer already on the stack.
	//
	// ⚠ **THE TRAILING `unreachable` IS FOR THE VALIDATOR, NOT FOR THE RUN.** `mrt_panic` ends in a trap
	// and can never return, but a wasm functype cannot say so: to the validator this is an ordinary
	// `(i32) -> ()` call, so the code after it is REACHABLE and the dead terminator the parser emits
	// after a diverging op must still type-check against the function's declared result arity. An
	// `unreachable` makes the stack polymorphic and it does. This is the same instruction, for the same
	// reason, that `emitOsExit` puts after `exit-with-code`.
	function emitPanicCall()
		self.body.call(wasmPanicFuncIdx(self.funcNames))
		self.body.unreachable()
	end 'emitPanicCall'

	// ----------------------------------------------------------------------
	// Memory band: top-level `var` globals (globalAddr / loadIndirect / storeIndirect)
	// ----------------------------------------------------------------------

	// `globalAddr` → `i32.const <base + the global's `.data` offset>`. On the native backends this
	// is a `lea` of a relocated address; on wasm a global's home is a fixed linear-memory byte, so
	// its address is a compile-time i32 CONSTANT — the base plus the offset `GlobalDataTable`
	// assigned the label at layout. The result local is i32 (recorded by `buildValtypeTable`), the
	// width `loadIndirect`/`storeIndirect` consume as the base address.
	function emitGlobalAddr(resultId ValueId, label ByteArray)
		let slotOffset = self.globalData.dataSectionOffsetOf(String.from(label))
		self.body.i32Const(wasmLinearAddress(self.dataBase, byteOffset: slotOffset))
		self.body.localSet(resultId as Wasm32Index)
	end 'emitGlobalAddr'

	// `loadIndirect` → push the base address as an i32, then `<width>.load offset=<offset>`. The
	// static `offset` (0 for a plain global, non-zero for a struct/heap-record field riding this op)
	// folds into the memarg. The width is `valueType`'s: a `u8`/`i1` BYTE (a heap String's bytes,
	// zero-extended) or an `i64`/`f64` WORD — the set `wasmMemAccessType` admits.
	//
	// ⚠ THE BASE IS COERCED TO i32 (`pushOperandAt`), NOT pushed bare. A `globalAddr`/`rdataAddr`
	// result is already i32, so the coercion is a no-op and this stays byte-identical — but a heap or
	// String pointer (an i64 in a register on the native backends) used as a load base needs an
	// `i32.wrap_i64`, and wasm's typed stack rejects the bare i64 under a `*.load`. Real addresses are
	// < 4 GiB, so the wrap is lossless.
	function emitLoadIndirect(resultId ValueId, addrId ValueId, offset ByteOffset, valueType StdType)
		self.pushOperandAt(addrId, targetVt: WasmValType.i32)
		let memOffset = wasmMemOffset(offset)
		// The access VALTYPE also names the width: i32 return ⟺ a BYTE access (the only i32-backed
		// types accepted are byte-width — see `wasmMemAccessType`), which zero-extends via
		// `i32.load8_u`; a word loads as i64/f64.
		match wasmMemAccessType(valueType, what: "loadIndirect") 'w'
			i32 then self.body.i32Load8U(memOffset)
			i64 then self.body.i64Load(memOffset)
			f64 then self.body.f64Load(memOffset)
			f32 then panic("emitLoadIndirect: wasmMemAccessType never returns f32")
		end 'w'
		self.body.localSet(resultId as Wasm32Index)
	end 'emitLoadIndirect'

	// `storeIndirect` → push the base address as an i32, then the value (coerced to the access
	// width), then `<width>.store offset=<offset>`. Address BELOW value is the order the store opcode
	// pops. `pushOperandAt` coerces BOTH: the base to i32 (a no-op for a `globalAddr`/`rdataAddr`
	// result, an `i32.wrap_i64` for an i64 heap/String pointer — the same reason `emitLoadIndirect`
	// coerces it) and the value to the store width (a value-meets-declared-type boundary, like
	// `ret`/call args). A byte store is the STRING-BUILDER path: an i64 char stored as one byte
	// (StringRuntime:921) is wrapped to i32 here, then written by `i32.store8`. Defines nothing, so
	// no `local.set`.
	// `memFill` → ONE `memory.fill`: push the destination as an i32, the constant fill byte as an i32, the
	// length as an i32, then the instruction. Defines nothing, so no `local.set`.
	//
	// ⭐⭐ **THIS LANE'S SIZE LADDER IS THE ENGINE'S, AND THAT IS THE RIGHT ANSWER RATHER THAN A GAP.** x64 and
	// arm64 dispatch on the length because a straight-line run of stores beats a call-shaped bulk primitive at
	// the small sizes the allocator actually asks for. On wasm the trade INVERTS: each `i64.store` is
	// bounds-checked independently, while one `memory.fill` is a single check plus an engine-tuned memset that
	// already special-cases short lengths. So unrolling here would very likely be SLOWER — see
	// `WasmBody.memoryFill`, and ARCHITECTURE.md → "The `memzero` the backend must emit", which states the
	// three targets' ladders side by side for exactly this reason.
	//
	// ⚠ The fill byte reaches wasm as a BYTE, not as the 64-bit broadcast the two native isels compute:
	// `memory.fill` takes the value it replicates, so `memFillPatternWord` has no caller on this lane.
	function emitMemFill(destId ValueId, byteCountId ValueId, value ParsedInt)
		self.pushOperandAt(destId, targetVt: WasmValType.i32)
		self.body.i32Const(memFillByte(value) as Imm32)
		self.pushOperandAt(byteCountId, targetVt: WasmValType.i32)
		self.body.memoryFill()
	end 'emitMemFill'

	function emitStoreIndirect(addrId ValueId, offset ByteOffset, valueId ValueId, valueType StdType)
		self.pushOperandAt(addrId, targetVt: WasmValType.i32)
		let storeVt = wasmMemAccessType(valueType, what: "storeIndirect")
		self.pushOperandAt(valueId, targetVt: storeVt)
		let memOffset = wasmMemOffset(offset)
		match storeVt 'w'
			i32 then self.body.i32Store8(memOffset)
			i64 then self.body.i64Store(memOffset)
			f64 then self.body.f64Store(memOffset)
			f32 then panic("emitStoreIndirect: wasmMemAccessType never returns f32")
		end 'w'
	end 'emitStoreIndirect'

	// ----------------------------------------------------------------------
	// rdata band + system band: String-literal records and the stdout write
	// ----------------------------------------------------------------------

	// `rdataAddr` → `i32.const <rdataBase + the record's `.rdata` offset>`. The `.rdata` twin of
	// `emitGlobalAddr`: a String literal's 56-byte record lives at a fixed linear-memory byte, so its
	// address is a compile-time i32 CONSTANT. The result local is i32 (recorded by
	// `buildValtypeTable`); it reaches `__print_string`'s i64 `strPtr` param through the
	// call-argument coercion (`i64.extend_i32`), and is wrapped back to i32 at the load base.
	function emitRdataAddr(resultId ValueId, label ByteArray)
		self.body.i32Const(self.rdataLabelAddress(label))
		self.body.localSet(resultId as Wasm32Index)
	end 'emitRdataAddr'

	// A `.rdata` label's absolute linear-memory address. wasm is fixed-base, so this is a compile-time
	// constant rather than the relocation the native writers file. Two callers want it for different
	// reasons — `emitRdataAddr` puts it in a value, `emitPanicLabel` passes it straight to `mrt_panic` —
	// and the layout arithmetic is the same fact for both.
	function rdataLabelAddress(label ByteArray) returns Imm32
		return wasmLinearAddress(self.rdataBase, byteOffset: self.globalData.rdataOffsetOf(String.from(label)))
	end 'rdataLabelAddress'

	// `osAllocPages(size) -> base` → `memory.grow` (v1 `emitOsAllocPages`, MirToWasm.maxon:3227,
	// ported verbatim). The slab allocator asks for `size` bytes; wasm grows linear memory a PAGE at
	// a time, so the size is rounded UP to whole 64 KiB pages, memory is grown, and the previous page
	// count `memory.grow` returns is shifted back to the BYTE base of the freshly-grown region — the
	// address `resultId` carries. `memory.grow` signals OOM by returning -1 (i32); the result is
	// sign-extended to i64 (so -1 stays -1 in the i64 world every ValueId lives in) and an OOM TRAPS
	// via `unreachable`, matching the native allocators' abort. `resultId` doubles as the scratch
	// across the OOM test, exactly as in v1.
	function emitOsAllocPages(resultId ValueId, sizeId ValueId)
		// pages = (size + 65535) >> 16  — ceil(size / 64 KiB)
		self.pushOperandAt(sizeId, targetVt: WasmValType.i64)
		self.body.i64Const(WasmPageSizeMask as ParsedInt)
		self.body.i64Add()
		self.body.i64Const(WasmPageSizeLog2 as ParsedInt)
		self.body.i64ShrU()
		self.body.i32WrapI64()
		// grow linear memory 0 by that page count → previous page count (or -1 on OOM)
		self.body.memoryGrow()
		// widen to i64 so the OOM test stays in the i64 world; -1 sign-extends to -1
		self.body.i64ExtendI32S()
		self.body.localSet(resultId as Wasm32Index)
		// if (base == -1) unreachable  — OOM traps, surfacing as a wasmtime runtime trap
		self.body.localGet(resultId as Wasm32Index)
		self.body.i64Const(WasmMemoryGrowOom)
		self.body.i64Eq()
		self.body.beginIf()
		self.body.unreachable()
		self.body.endOp()
		// base = prevPages << 16  — the byte base of the freshly-grown region
		self.body.localGet(resultId as Wasm32Index)
		self.body.i64Const(WasmPageSizeLog2 as ParsedInt)
		self.body.i64Shl()
		self.body.localSet(resultId as Wasm32Index)
	end 'emitOsAllocPages'

	// `osCommitPages(addr, size) -> addr` — the address, unchanged. The range was backed by the `memory.grow`
	// that answered it (see the `osReservePages` arm in `emitBodyOp`), so there is nothing to ask the machine
	// for and the op's whole content on this lane is its ANSWER: a commit that cannot fail reports the base it
	// was given, which is what every caller's guard then finds valid.
	//
	// `sizeId` is deliberately not read here — the three native lanes need it to name a sub-range, and this one
	// has no sub-range to name.
	function emitOsCommitPages(resultId ValueId, addrId ValueId)
		self.pushOperandAt(addrId, targetVt: WasmValType.i64)
		self.body.localSet(resultId as Wasm32Index)
	end 'emitOsCommitPages'

	// `osWriteStdout`/`osWriteStderr(result, buf, len)` → the WASI-Preview2 stream write. Stack-balanced:
	// the stream accessor pushes the i32 handle; the buffer address and the byte length are each wrapped
	// to i32 (a String's `buffer@0`/`length@8` are i64 in the Std IR — a 64-bit pointer/count in a
	// register on the native backends — but a wasm address/length is i32); the canonical-ABI return area
	// is a constant i32. `blocking-write-and-flush` writes its `result<_, stream-error>` into that area
	// and returns nothing, so the stack is empty after the call. The stream handle leaks, which is
	// acceptable: both streams are process-lived and the host reclaims them on exit (matches v1's
	// `emitOsWrite`).
	//
	// ⭐ ONE EMITTER FOR BOTH STREAMS: the accessor import is the whole difference — a `wasi:io/streams`
	// output-stream is one type whichever `wasi:cli` accessor produced it, which is why W3's `get-stderr`
	// needed no second writer and why this one needs no second emitter either.
	//
	// ⚠⚠ **THE BYTE COUNT IS `lenId`, AND ON THIS LANE THAT IS THE ABI'S ANSWER RATHER THAN A STAND-IN.**
	// The other three lanes read a count the OS reports (`WriteFile`'s out-param, `write`'s return);
	// `blocking-write-and-flush` reports none, because its contract is to write the WHOLE contents or fail
	// — so on success the count written IS the length asked for. The result is re-pushed from the operand
	// at the Std tier's i64 width, not from the i32 already consumed by the call, so no truncation is
	// carried into the count.
	function emitOsWriteStream(resultId ValueId, bufId ValueId, lenId ValueId, stream OsOutputStream)
		self.body.call(wasmStreamAccessorImportFuncIdx(stream))
		self.pushOperandAt(bufId, targetVt: WasmValType.i32)
		self.pushOperandAt(lenId, targetVt: WasmValType.i32)
		self.body.i32Const(WasmRetAreaBase)
		self.body.call(BlockingWriteFlushImportFuncIdx)

		self.pushOperandAt(lenId, targetVt: WasmValType.i64)
		self.body.localSet(resultId as Wasm32Index)
	end 'emitOsWriteStream'

	// ----------------------------------------------------------------------
	// Dispatcher terminators: branch / cond-branch (with phi copies)
	// ----------------------------------------------------------------------

	function emitDispatchBranch(targetBlockId BlockId, currentBlock IrBlock, loopDepth Wasm32Index)
		self.emitEdgePhiCopies(currentBlock, targetBlockId: targetBlockId)
		self.emitSetDispatch(self.dispatchIndexOf(targetBlockId))
		self.body.br(loopDepth)
	end 'emitDispatchBranch'

	// Two-way branch: test the condition, and inside each arm emit ONLY that edge's phi copies
	// (they are valid only on the path actually taken — emitting both unconditionally would
	// clobber the not-taken target's phi locals, v1's `String.trim` corruption), set the dispatch
	// index, then `br` back to the loop after the `if`/`end`.
	function emitDispatchCondBranch(condId ValueId, thenBlockId BlockId, elseBlockId BlockId, currentBlock IrBlock, loopDepth Wasm32Index)
		// `if` consumes an i32; a bool is already i32, but a condition widened to i64 must be narrowed
		// first — and BOTH of those are `pushOperandAt`'s answer, not a second one. This read the valtype
		// table for itself and wrapped by hand; the copy agreed with the door but nothing made it, and it
		// was the weaker one (an f64 condition passed through UNTOUCHED where `coerceOnStack` panics
		// naming the lowering bug). A condition CAN legitimately be i64 — an integer `binOp` over `i1`
		// operands is computed at the machine word like every other integer op (`wasmMachineValTypeOf`).
		self.pushOperandAt(condId, targetVt: WasmValType.i32)
		self.body.beginIf()

		self.emitEdgePhiCopies(currentBlock, targetBlockId: thenBlockId)
		self.emitSetDispatch(self.dispatchIndexOf(thenBlockId))

		self.body.elseClause()

		self.emitEdgePhiCopies(currentBlock, targetBlockId: elseBlockId)
		self.emitSetDispatch(self.dispatchIndexOf(elseBlockId))

		self.body.endOp()
		self.body.br(loopDepth)
	end 'emitDispatchCondBranch'

	function emitSetDispatch(dispatchIndex Wasm32Index)
		self.body.i32Const(dispatchIndex as Imm32)
		self.body.localSet(self.dispatchLocal)
	end 'emitSetDispatch'

	// ⭐ **THE DENSE-MATCH JUMP TABLE ON wasm** — a value `br_table` over the biased subject, wrapped in one
	// nested landing block per DISTINCT case target plus the default. wasm has no relocation to patch, so the
	// table is the `br_table` immediate itself; but a `br_table` cannot run per-edge phi copies, so each
	// landing runs `emitDispatchBranch` (its target's phi copies + set-dispatch + `br` to the loop) exactly
	// as the two-way dispatcher does. A native jump table's UNSIGNED bounds check has no `br_table` analog —
	// `br_table` bound-checks only the low 32 bits of an i64 index — so an explicit `i64.ge_u` guard routes a
	// wrapped-negative or high-bit-set index to the default first, matching x64's `jae` / arm64's `b.hs`.
	//
	// LANDING DEPTHS. Landings open outermost-first (`t0, t1, …, t_{m-1}, default`), so from the `br_table`
	// (innermost) the default landing is depth 0, `t_{m-1}` is depth 1, …, `t_j` is depth `m − j`. A hole
	// slot (target == default) routes to depth 0 too. After the `br_table`, closing the landings in order
	// exposes each landing's code at a loop depth one shallower than the last: default at `loopDepth + m`,
	// then `t_{m-1}` … `t_0` down to `loopDepth`.
	function emitDispatchSwitch(subjectId ValueId, caseTargets BlockIdArray, defaultTarget BlockId, currentBlock IrBlock, loopDepth Wasm32Index)
		let distinct = distinctSwitchTargets(caseTargets, exclude: defaultTarget)
		let m = distinct.count()

		// Open `m + 1` nested landing blocks (one per distinct target, plus the default). The loop is now at
		// `loopDepth + m + 1`.
		for _ in 0 upto (m + 1) 'openLandings'
			self.body.beginBlock()
		end 'openLandings'

		// ⭐ "DOES THIS SUBJECT HAVE A TOP HALF?" IS ASKED ONCE — because only ONE of the two emitters below
		// needs to ask it at all. It used to be read twice with opposite polarity, then hoisted to here and
		// handed to both; hoisting keeps two askers in step, but the INDEX does not need an answer — pushing
		// the subject at i32 IS the question, and `pushOperandAt` already answers it. So the guard reads the
		// table for itself and is the only reader; there is no second copy left to disagree with.
		//
		// The 64-bit UNSIGNED bounds check: a value outside `[0, span)` (a wrapped-negative index included)
		// branches to the default landing (innermost, depth 0). Only reached with an i64 subject — a bias
		// `subtract` mints an `integer`, and a zero-based match's enum/int subject is i64 too.
		self.emitSwitchBoundsGuard(subjectId, span: caseTargets.count())

		// In range: the low 32 bits ARE the index (the guard proved `< span < 2^32`). An i64 subject is
		// narrowed and an i32 one is already the index — exactly `pushOperandAt`'s contract, so it is ASKED
		// rather than restated (the `emitSwitchIndex` helper this replaced hand-rolled `localGet` +
		// `i32WrapI64`, a second spelling of the one coercion door and the weaker one: an f64 subject went
		// through untouched). `br_table` to each slot's landing depth; its own default is the default
		// landing (unreachable after the guard, correct anyway).
		self.pushOperandAt(subjectId, targetVt: WasmValType.i32)
		self.body.brTable(self.slotLandingDepths(caseTargets, distinct: distinct), defaultTarget: 0 as Wasm32Index)

		// Close each landing and emit its target's dispatch. `end` #1 exposes the default landing; `end` #(k+1)
		// exposes `distinct[m − k]`. The loop is `loopDepth + m − k` deep at the k-th code point.
		for k in 0 upto (m + 1) 'landings'
			self.body.endOp()
			let landingLoopDepth = (loopDepth + m - k) as Wasm32Index
			var target = defaultTarget
			if k > 0 'caseLanding'
				target = try distinct.get(m - k) otherwise panic("emitDispatchSwitch: distinct.get OOB at {m - k} (m={m}, k={k})")
			end 'caseLanding'
			self.emitDispatchBranch(target, currentBlock: currentBlock, loopDepth: landingLoopDepth)
		end 'landings'
	end 'emitDispatchSwitch'

	// The `i64.ge_u span` bounds guard `br_if`ing an out-of-range index to the default landing (depth 0). An
	// i32 subject (never produced for a switch today — every biased index is i64) needs no i64 guard: its own
	// value IS the index, so the `br_table`'s exact i32 bounds check suffices, and this emits nothing.
	function emitSwitchBoundsGuard(subjectId ValueId, span ElementCount)
		if getValtype(self.valtypes, v: subjectId) != WasmValType.i64 'notI64'
			return
		end 'notI64'
		self.body.localGet(subjectId as Wasm32Index)
		self.body.i64Const(span)
		self.body.i64GeU()
		self.body.brIf(0 as Wasm32Index)
	end 'emitSwitchBoundsGuard'

	// The per-slot `br_table` landing depths for a dense switch: for each of the `span` slots, the landing
	// depth of that slot's target — the default (and any hole slot) at depth 0, and `distinct[j]` at depth
	// `m − j` (landings open outermost-first, so the innermost default is 0). Each distinct target's depth is
	// stashed in a dense array indexed by its block id OFFSET FROM THE SMALLEST distinct target id, so both
	// the fill and the per-slot read are O(1). Keying on the distinct-target id RANGE (not absolute block id)
	// keeps the array O(distinct) wide — the arm bodies are minted together, so the range tracks the arm
	// count no matter where the match or its default block sit in the function; an absolute-id array would be
	// O(maxBlockId), reintroducing superlinearity for a function with many dense matches. A per-slot linear
	// scan of `distinct` would instead be O(slots × distinct), quadratic in an all-distinct dense match's arm
	// count. Depth 0 doubles as "not a distinct target": every distinct depth `m − j` is ≥ 1, so a hole or
	// default slot (its target absent from the range, or a 0 in it) correctly reads 0.
	function slotLandingDepths(caseTargets BlockIdArray, distinct BlockIdArray) returns Wasm32IndexArray
		let m = distinct.count()
		var out = Wasm32IndexArray.create()
		if m == 0 'onlyDefault'
			for _ in caseTargets 'allDefault'
				out.push(0 as Wasm32Index)
			end 'allDefault'
			return out
		end 'onlyDefault'

		var minTarget = try distinct.get(0) otherwise panic("slotLandingDepths: distinct.get(0) OOB with m={m}")
		var maxTarget = minTarget
		for target in distinct 'range'
			if target < minTarget 'lower'
				minTarget = target
			end 'lower'
			if target > maxTarget 'upper'
				maxTarget = target
			end 'upper'
		end 'range'

		var depthByOffset = Wasm32IndexArray.create()
		depthByOffset.growFilled((maxTarget - minTarget + 1) as ElementCount, value: 0 as Wasm32Index)
		var j = 0 as ElementCount
		for target in distinct 'depths'
			try depthByOffset.set((target - minTarget) as ElementCount, value: (m - j) as Wasm32Index) otherwise panic("slotLandingDepths: depth set OOB at block {target}")
			j = j + 1
		end 'depths'

		for target in caseTargets 'eachSlot'
			var depth = 0 as Wasm32Index
			if target >= minTarget and target <= maxTarget 'inRange'
				depth = try depthByOffset.get((target - minTarget) as ElementCount) otherwise panic("slotLandingDepths: depth get OOB at block {target}")
			end 'inRange'
			out.push(depth)
		end 'eachSlot'
		return out
	end 'slotLandingDepths'

	// The narrowing to `Wasm32Index` is at the READ and not in the table because the table is the
	// IR-tier `BlockRefIndex` column every backend shares; a `blockRefs` position always fits u32
	// for the same reason a function's block count does.
	function dispatchIndexOf(blockId BlockId) returns Wasm32Index
		let position = try self.blockDispatchById.get(blockId) otherwise panic("dispatchIndexOf: branch targets block id {blockId} not in func.blockRefs")
		return position as Wasm32Index
	end 'dispatchIndexOf'

	// ----------------------------------------------------------------------
	// Phi (block-arg) parallel copies on a branch edge
	// ----------------------------------------------------------------------

	// Copy the values `currentBlock` passes on its edge to `targetBlockId` into that block's
	// block-arg locals, as a SEQUENTIALIZED parallel copy (§4.1). The incoming values live on
	// the predecessor's `branchEdges` entry for the target; the destinations are the target's
	// `blockArgs`. A target with block-args must have a matching edge from every predecessor
	// (IrBlock's phi-model contract), so a missing edge is only valid when the target has none.
	function emitEdgePhiCopies(currentBlock IrBlock, targetBlockId BlockId)
		let targetBlock = self.blockById(targetBlockId)

		// A condBranch's then/else targets are distinct and a branch has one target, so a target
		// appears at most once among the predecessor's phi edges — the first match is the edge.
		for edge in currentBlock.branchEdges 'eachEdge'
			if edge.targetBlockId == targetBlockId 'thisEdge'
				self.emitPhiCopyForEdge(edge, currentBlock: currentBlock, targetBlock: targetBlock)
				return
			end 'thisEdge'
		end 'eachEdge'

		// No phi edge to this target: valid only when the target carries no block-args (a block
		// with block-args records an edge from every predecessor — IrBlock's phi-model contract).
		if targetBlock.blockArgs.count() > 0 'missingArgs'
			panic("emitEdgePhiCopies: block '{String.from(currentBlock.label)}' branches to '{String.from(targetBlock.label)}' which has {targetBlock.blockArgs.count()} block-args, but records no branch edge carrying them")
		end 'missingArgs'
	end 'emitEdgePhiCopies'

	function emitPhiCopyForEdge(edge BranchEdge, currentBlock IrBlock, targetBlock IrBlock)
		if edge.argIds.count() != targetBlock.blockArgs.count() 'arity'
			panic("emitPhiCopyForEdge: edge '{String.from(currentBlock.label)}' → '{String.from(targetBlock.label)}' carries {edge.argIds.count()} args but the block has {targetBlock.blockArgs.count()} block-args")
		end 'arity'

		var dsts = ValueIdArray.create()
		var srcs = ValueIdArray.create()
		for k in 0 upto targetBlock.blockArgs.count() 'eachPhi'
			let dst = (try targetBlock.blockArgs.get(k) otherwise panic("emitPhiCopyForEdge: blockArgs.get OOB at {k}")).valueId
			let src = try edge.argIds.get(k) otherwise panic("emitPhiCopyForEdge: argIds.get OOB at {k}")
			if dst != src 'realMove'
				dsts.push(dst)
				srcs.push(src)
			end 'realMove'
		end 'eachPhi'

		self.sequenceParallelCopy(dsts, srcs: srcs)
	end 'emitPhiCopyForEdge'

	function blockById(blockId BlockId) returns IrBlock
		let idx = self.dispatchIndexOf(blockId)
		let blockRef = try self.func.blockRefs.get(idx) otherwise panic("blockById: blockRefs.get OOB at {idx}")
		return try self.module.blocks.get(blockRef) otherwise panic("blockById: blockRef {blockRef} not in module.blocks")
	end 'blockById'

	// Sequence a parallel copy (`dsts[k]` ← `srcs[k]`, dsts distinct) into ordered local copies.
	// Repeatedly emit a leaf (a dst that is no other move's source); when only cycles remain,
	// break one by exchanging its two locals through a valtype-matched scratch local (wasm has
	// no `xchg`) and rewrite the remaining sources through the exchange. Consumes `dsts`/`srcs`
	// as worklists. The standard parallel-move algorithm, with a scratch-staged swap in place of
	// the register backends' `xchg`.
	function sequenceParallelCopy(dsts ValueIdArray, srcs ValueIdArray)
		while dsts.count() > 0 'seq'
			removeSatisfiedMoves(dsts, srcs: srcs)
			if dsts.count() == 0 'done'
				break
			end 'done'

			let leaf = findLeafMove(dsts, srcs: srcs)
			if leaf < dsts.count() 'foundLeaf'
				let d = try dsts.get(leaf) otherwise panic("sequenceParallelCopy: dsts.get OOB at leaf {leaf}")
				let s = try srcs.get(leaf) otherwise panic("sequenceParallelCopy: srcs.get OOB at leaf {leaf}")
				self.emitLocalCopy(d as Wasm32Index, srcLocal: s, fromVt: getValtype(self.valtypes, v: s), toVt: getValtype(self.valtypes, v: d))
				removeMoveAt(dsts, srcs: srcs, idx: leaf)
			end 'foundLeaf' else 'cycle'
				let a = try dsts.get(0) otherwise panic("sequenceParallelCopy: dsts.get(0) OOB")
				let b = try srcs.get(0) otherwise panic("sequenceParallelCopy: srcs.get(0) OOB")
				let aVt = getValtype(self.valtypes, v: a)
				let bVt = getValtype(self.valtypes, v: b)
				let scratch = self.scratchFor(aVt)
				// Exchange a and b via scratch, satisfying (a ← b): scratch←a; a←b; b←scratch. Each leg
				// coerces to the DESTINATION local's width: a and b are block-args whose declared
				// valtypes can differ (see emitLocalCopy), so a width-mixing swap round-trips through the
				// scratch (typed as a's width) with the same coercions a sequential assignment pair would.
				self.emitLocalCopy(scratch, srcLocal: a as Wasm32Index, fromVt: aVt, toVt: aVt)
				self.emitLocalCopy(a as Wasm32Index, srcLocal: b, fromVt: bVt, toVt: aVt)
				self.emitLocalCopy(b as Wasm32Index, srcLocal: scratch, fromVt: aVt, toVt: bVt)
				removeMoveAt(dsts, srcs: srcs, idx: 0)
				rewriteSourcesThroughSwap(srcs, a: a, b: b)
			end 'cycle'
		end 'seq'
	end 'sequenceParallelCopy'

	// Copy one local to another, coercing the source's valtype to the destination's when they
	// differ. The native backends never need this — every value sits in a 64-bit register — but a
	// phi edge is a value-meets-declared-type boundary exactly like a `ret` or a call argument
	// (both of which already `coerceOnStack`): the frontend leaves an int↔narrower width change
	// IMPLICIT (int→int carries no Std conversion op), so a loop-carried var whose declared valtype
	// — its block-arg slot — is narrower/wider than the value an edge assigns it arrives here as an
	// i32 into an i64 slot (or the reverse), which wasm's typed `local.set` rejects. `coerceOnStack`
	// is a no-op when the widths already agree, so a same-width copy stays byte-identical.
	function emitLocalCopy(dstLocal Wasm32Index, srcLocal Wasm32Index, fromVt WasmValType, toVt WasmValType)
		self.body.localGet(srcLocal)
		coerceOnStack(self.body, from: fromVt, to: toVt)
		self.body.localSet(dstLocal)
	end 'emitLocalCopy'

	function scratchFor(vt WasmValType) returns Wasm32Index
		return try self.scratchLocalByValType.get(vt) otherwise panic("scratchFor: no cycle-break scratch local reserved for valtype {vt.name} — collectPhiValTypes missed a block-arg type")
	end 'scratchFor'
end 'WasmFuncEmitter'

// ==========================================================================
// Free helpers: constant narrowing, dispatcher decision, parallel-copy worklist
// ==========================================================================

// The low 32 bits of `value`, reinterpreted as a signed i32 — what a wasm `i32.const` (an
// SLEB128 of a 32-bit two's-complement value) encodes. Lets a `u32`/negative literal round-trip
// through the signed `Imm32` the encoder carries.
function narrowToImm32(value ParsedInt) returns Imm32
	let low = value and 0xFFFFFFFF
	if low > i32.max 'negative'
		return (low - 0x100000000) as Imm32
	end 'negative'
	return low as Imm32
end 'narrowToImm32'

// The wasm valtype a `loadIndirect`/`storeIndirect` of `valueType` transfers — and, because a byte
// access and a word access take different opcodes, the ONE DOOR that also decides WHICH the callers
// emit. It mirrors the shared native `accessWidthFor`: the language can put only a BYTE (`i1`/`u8`)
// or a WORD (`i64`/`f64`) behind a load/store today, so a byte returns i32 (the `i32.load8_u` /
// `i32.store8` forms — everything ≤ 32 bits is an i32 local) and a word returns i64/f64. The
// returned valtype is UNAMBIGUOUS about width because the only i32-backed types admitted are
// byte-width: an i32 return ⟺ a byte access. Every other width panics rather than picking a nearby
// one — a narrow integer needs the `as` cast (P1.9), whose SIGNEDNESS then decides the
// sign/zero-extending load — exactly the line `accessWidthFor` draws for the native backends. An f32
// cannot occur (Maxon's `float` is f64). A `bool`/`u8` byte zero-extends, which is why the one byte
// load form (`i32.load8_u`) is unsigned; a signed byte (`i8`) is P1.9-gated below.
function wasmMemAccessType(valueType StdType, what String) returns WasmValType
	match valueType 'w'
		i1 then return WasmValType.i32
		u8 then return WasmValType.i32
		i64 then return WasmValType.i64
		f64 then return WasmValType.f64
		i8 to i32 then panic("wasm: {what} of {valueType.name} — a narrow signed integer needs the `as` cast (P1.9), whose signedness picks the sign/zero-extending load; only i1/u8 (byte) and i64/f64 (word) are lowered, mirroring the native accessWidthFor")
		u16 to u64 then panic("wasm: {what} of {valueType.name} — an unsigned integer wider than a byte needs the `as` cast (P1.9); only u8 (byte) and i64/f64 (word) are lowered")
		f32 then panic("wasm: {what} of an f32 — Maxon's `float` is f64, so nothing produces an f32")
	end 'w'
end 'wasmMemAccessType'

// A linear-memory ABSOLUTE address: a section base plus a byte offset within it, as the signed
// `Imm32` an `i32.const` carries. Shared by `globalAddr` (`.data`), `rdataAddr` and the String
// buffer fixup (`.rdata`) — all fixed-base wasm addresses. The whole image sits well below
// i32.max, so the address always fits; a violation is an invariant break (a section larger than 2
// GiB, which the single-page memory this slice declares cannot hold), not a user error.
function wasmLinearAddress(base Wasm32Index, byteOffset ByteOffset) returns Imm32
	let addr = (base as ByteOffset) + byteOffset
	if addr > i32.max 'tooFar'
		panic("wasmLinearAddress: address {addr} (base {base} + offset {byteOffset}) does not fit the signed i32 a wasm linear-memory address is — the data/rdata image exceeds 2 GiB, which the single-page memory this slice declares cannot hold")
	end 'tooFar'
	return addr as Imm32
end 'wasmLinearAddress'

// A memory-band byte offset as the ULEB `offset` a wasm memarg carries (a u32). Every offset in
// this slice is 0 (a plain global's load/store); the bound starts mattering at P1.1's struct
// fields. A value past u32.max is an invariant break — no single 64 KiB memory reaches that far.
function wasmMemOffset(offset ByteOffset) returns Wasm32Index
	if offset > u32.max 'tooFar'
		panic("wasmMemOffset: memarg offset {offset} exceeds the u32 a wasm memarg encodes — an access reaching that far past its base is outside a single linear memory")
	end 'tooFar'
	return offset as Wasm32Index
end 'wasmMemOffset'

// Whether `func` needs the loop+br_table dispatcher. Any multi-block function does; a
// single-block function does too when its terminator branches (a self-loop) rather than
// returning — a lone returning block emits straight-line.
function decideDispatcher(module StdModule, func IrFunction) returns bool
	let blockCount = func.blockRefs.count()
	if blockCount > 1 'multi'
		return true
	end 'multi'
	if blockCount == 0 'empty'
		return false
	end 'empty'

	let blockRef = try func.blockRefs.get(0) otherwise panic("decideDispatcher: blockRefs.get(0) OOB")
	let block = try module.blocks.get(blockRef) otherwise panic("decideDispatcher: blockRef {blockRef} not in module.blocks")
	if not block.hasTerminatorOp() 'noTerm'
		return false
	end 'noTerm'

	let term = try module.ops.get(block.terminatorIndex()) otherwise panic("decideDispatcher: terminatorIndex not in module.ops")
	match term 'k'
		const to mod then break 'k'
		condBranch then return true
		branch then return true
		ret then break 'k'
		param then break 'k'
		call then break 'k'
		retVoid then break 'k'
		globalAddr to rdataAddr then break 'k'
		// `errorReturn` is a non-branching (return) terminator — a throwing function's single block
		// ending in it is straight-line, exactly like `ret`. `tryCall`/`osExit` are never terminators.
		tryCall then panic("decideDispatcher: a `tryCall` is a value-producing body op, never a terminator")
		errorReturn then break 'k'
		osExit then panic("decideDispatcher: an `osExit` is a body op followed by a dead return, never a terminator")
		// A `funcAddr`/`callIndirect` is a value-producing body op, never a terminator — the same
		// invariant `tryCall`/`osExit` assert (P1.5-A1).
		funcAddr then panic("decideDispatcher: a `funcAddr` is a value-producing body op, never a terminator")
		callIndirect then panic("decideDispatcher: a `callIndirect` is a value-producing body op, never a terminator")
		osPanic to osFreePages then panic("decideDispatcher: an `osPanic` is a body op, never a terminator")
		// A jump table is a multiway branch — its function MUST use the loop+br_table dispatcher. (A `match`
		// always creates several arm-body blocks, so `blockCount > 1` catches this first; the arm is here so
		// a hypothetical single-block switch still forces the dispatcher rather than a straight-line path.)
		switch then return true
		// A witness call is a single-successor body op — it forces no dispatcher (it is refused at emission),
		// and the throwing form is a single-successor body op for the identical reason.
		witnessCall then break 'k'
		witnessTryCall then break 'k'
		osPipeCreate to osWriteFile then panic("decideDispatcher: a P1.5 IOCP op is a body op, never a terminator")
		osReadWallClock then panic("decideDispatcher: an `osReadWallClock` is a body op, never a terminator")
		osFileOpenRead to osFileAttributes then panic("decideDispatcher: a file-IO op is a body op, never a terminator")
		osPanicValue then panic("decideDispatcher: an `osPanicValue` is a body op, never a terminator")
		osCommandLine then panic("decideDispatcher: an `osCommandLine` is a body op, never a terminator")
		osStdHandle then panic("decideDispatcher: an `osStdHandle` is a body op, never a terminator")
		osExecutablePath then panic("decideDispatcher: an `osExecutablePath` is a body op, never a terminator")
		osWriteStderr then panic("decideDispatcher: an `osWriteStderr` is a body op, never a terminator")
		stackRecordAddr then panic("decideDispatcher: a `stackRecordAddr` is a body op, never a terminator")
		osOpenNamedSegment to osTickCountMs then panic("decideDispatcher: a DebugStream host primitive is a body op, never a terminator")
		osHandleSetInherit to osProcessTerminate then panic("decideDispatcher: an attached-subprocess host primitive is a body op, never a terminator")
		osSocketStartup to osSocketClose then panic("decideDispatcher: a socket host primitive is a body op, never a terminator")
		osCpuCount then panic("decideDispatcher: an `osCpuCount` is a body op, never a terminator")
		osThreadCpuTicks then panic("decideDispatcher: an `osThreadCpuTicks` is a body op, never a terminator")
		osDecommitPages then panic("decideDispatcher: an `osDecommitPages` is a body op, never a terminator")
		osCommitPages to osReservePages then panic("decideDispatcher: a page reserve or commit is a body op, never a terminator")
		memFill then panic("decideDispatcher: a `memFill` is a body op, never a terminator")
		atomicCas to currentThreadToken then panic("decideDispatcher: an atomic or a thread-token read is a body op, never a terminator")
		tlsAlloc to osEnterBackgroundPriority then panic("decideDispatcher: a TLS op, an event signal or the priority door is a body op, never a terminator")
	end 'k'
	return false
end 'decideDispatcher'

// Index of a move whose dst is not any pending move's source (safe to emit now), or the move
// count when every remaining dst is still needed as a source (a pure cycle).
function findLeafMove(dsts ValueIdArray, srcs ValueIdArray) returns ValueId
	for i in 0 upto dsts.count() 'each'
		let d = try dsts.get(i) otherwise panic("findLeafMove: dsts.get OOB at {i}")
		if not isAnySource(srcs, valueId: d) 'leaf'
			return i
		end 'leaf'
	end 'each'
	return dsts.count()
end 'findLeafMove'

function isAnySource(srcs ValueIdArray, valueId ValueId) returns bool
	for s in srcs 'each'
		if s == valueId 'match'
			return true
		end 'match'
	end 'each'
	return false
end 'isAnySource'

// Remove every move already satisfied (dst == src) — the self-copies a preceding scratch swap
// just fulfilled (a source rewritten through the exchange now equals its dst). Scans back-to-
// front so removals do not shift not-yet-visited indices.
function removeSatisfiedMoves(dsts ValueIdArray, srcs ValueIdArray)
	let n = dsts.count()
	for ri in 0 upto n 'each'
		let i = n - 1 - ri
		let d = try dsts.get(i) otherwise panic("removeSatisfiedMoves: dsts.get OOB at {i}")
		let s = try srcs.get(i) otherwise panic("removeSatisfiedMoves: srcs.get OOB at {i}")
		if d == s 'satisfied'
			removeMoveAt(dsts, srcs: srcs, idx: i)
		end 'satisfied'
	end 'each'
end 'removeSatisfiedMoves'

function removeMoveAt(dsts ValueIdArray, srcs ValueIdArray, idx ValueId)
	_ = try dsts.remove(idx) otherwise panic("removeMoveAt: dsts.remove OOB at {idx}")
	_ = try srcs.remove(idx) otherwise panic("removeMoveAt: srcs.remove OOB at {idx}")
end 'removeMoveAt'

// After exchanging locals a and b, a pending move reading a now finds its value in b and
// vice-versa.
function rewriteSourcesThroughSwap(srcs ValueIdArray, a ValueId, b ValueId)
	for i in 0 upto srcs.count() 'each'
		let s = try srcs.get(i) otherwise panic("rewriteSourcesThroughSwap: srcs.get OOB at {i}")
		if s == a 'wasA'
			try srcs.set(i, value: b) otherwise panic("rewriteSourcesThroughSwap: srcs.set OOB at {i}")
		end 'wasA' else if s == b 'wasB'
			try srcs.set(i, value: a) otherwise panic("rewriteSourcesThroughSwap: srcs.set OOB at {i}")
		end 'wasB'
	end 'each'
end 'rewriteSourcesThroughSwap'
