// StdToWasm — the wasm backend's Std-module → WASI-Preview2 CORE-module lowering.
//
// ⭐ A SIBLING OF x64/arm64, NOT A DESCENDANT. The register-allocating backends run
// Std → Target (isel) → colour → SSA-destruction → encode. The wasm backend skips ALL of
// that: wasm's operand stack has an unbounded local file, so every SSA `ValueId` simply
// IS a wasm local (v1's identity model), there is no register pressure to allocate for, and
// there is no Target dialect to lower into. This file consumes the `StdModule` directly and
// emits the byte-encoded module through A1's `WasmBinary` seam. That is why the `wasm32`
// arms in RegisterAllocator/RegBits/SsaDestruction/TargetPrinter stay dead-but-exhaustive:
// the wasm path never reaches them.
//
// ⭐ WHAT IS DELIBERATELY NOT REUSED FROM shv2's SHARED BACKEND CODE, AND WHY:
//   • `SsaDestruction.sequenceParallelCopy` — it is module-private (not exported), typed on
//     physical `RegNum`s (this tier has only `ValueId`s), and breaks copy cycles with `xchg`,
//     which wasm has no instruction for. wasm breaks a cycle by staging through a SCRATCH
//     local per valtype (v1's `WasmCopyEmitter` did exactly this: `hasXchg = false`). So the
//     algorithm is re-implemented here over local indices with scratch-local cycle breaking —
//     the SAME standard parallel-move algorithm, a different cycle primitive.
//   • `PhiEdgeView.resolve` — its `PhiEdgeConsumer` context enum names only the three
//     register-allocator consumers; the edge/arg pairing is resolved locally instead so a
//     wasm arity mismatch reports against wasm, not a mislabelled `ssaDestruction`.
//
// ⭐ CONTROL FLOW IS A `loop`+`br_table` STATE MACHINE, NOT A RELOOPER. Each block gets a
// dispatch index; a single outer `loop` wrapped in one `block` per basic block re-enters and
// `br_table`s to the current block. It handles ANY reducible CFG shape with no structural
// analysis. Reference: v1 `maxon-selfhosted/Compiler/Targets/Wasm/MirToWasm.maxon`
// `emitStructuredCfg` (:2004) and its phi-copy handling (:2092-2183) — the shapes are taken;
// v1's 42-func Preview2 import table and its heap/print/async paths are not (this slice needs
// only `exit-with-code`).
//
// SCOPE grows the way v1's did: scalar core, then f64, then top-level-`var` globals + String
// literals (`.data`/`.rdata` active segments, `print`), the HEAP — `osAllocPages` →
// `memory.grow`, the narrow BYTE load/store band a String's per-byte access needs, and the leak gate
// (`__mm_leak_check`) on the exit path — and now scalar ERROR HANDLING (`throws`/`try`/`throw`/`panic`).
// The allocator/refcount/String builders themselves are Std-IR runtime functions emitted through the
// ordinary function path, not hand-written here.
//
// ⭐ THE ERROR-HANDLING ABI — shv2's native DUAL-REGISTER model mapped onto wasm MULTI-VALUE. A
// throwing function returns its primary value in R8/x0 AND an i64 error flag in R10/x9 on the native
// backends; wasm has no second return register, so the flag rides a SECOND RESULT in the function's
// multi-value signature: a value-returning throwing function is `(params) -> (resultVt, i64)`, a
// void-returning one `(params) -> (i64)`. There is no separate success-`ret` path to augment — the
// frontend routes EVERY exit of a throwing function through `errorReturn` (a normal return carries a
// zero flag, a `throw` a non-zero one), so `ret`/`retVoid` never appear inside a throwing function and
// `emitRet`/`emitRetVoid` are untouched. `tryCall` reads both results off the callee's multi-value
// return (flag on top of the stack); `osExit` (from `panic`) calls `exit-with-code` and traps. What
// remains beyond the backend (`sugar` ops and the narrow-integer `as` cast) still `panic` in the
// exhaustive matches below — unreachable given the spec-runner gating, mirroring the dead-but-exhaustive
// native target arms.

// Wasm indices/counts are u32 in the format; this backend uses A1's exported `Wasm32Index`
// (= int(0 to u32.max)) and `Wasm32IndexArray` for every function/type/local/dispatch index,
// so the values flow into the `WasmBinary` seam's params with no cast. The one narrowing is at
// the `ValueId → local index` boundary (`as Wasm32Index`), where a value id always fits u32.

// Per-function block-id → dispatch-index map (position in `func.blockRefs`).
typealias BlockDispatchMap = Map with (BlockId, Wasm32Index)

// The cycle-break scratch local reserved for each valtype that appears among a function's
// block-args — the local a phi-copy cycle stages through (wasm has no register exchange).
typealias ScratchLocalMap = Map with (WasmValType, Wasm32Index)

// The set of valtypes present among a function's block-args, used to reserve exactly the
// scratch locals a phi cycle in that function could need.
typealias PhiValTypeSet = Set with WasmValType

// Callee name → its wasm function index, and → its Std return type. Both are built once per
// module (the index from the deterministic import-then-defined ordering, the return type from
// each function's signature) so a `call` op resolves its target and its void-ness in O(1).
typealias CalleeFuncIdxMap = Map with (ByteArray, Wasm32Index)
typealias CalleeReturnTypeMap = Map with (ByteArray, StdReturnType)
typealias CalleeParamTypesMap = Map with (ByteArray, WasmValTypeArray)

// An indirect call's ARG COUNT → the interned wasm functype index for its `(i64^n) -> i64` signature
// (P1.5-A1). The Std `callIndirect` op carries NO signature, and none needs to reach the wasm tier on it:
// every A1 function value is `(i64^n) -> i64` (its params and return are integer/named types, all of which
// collapse to i64; void and non-integer function values are out of the A1 slice), so the arg count fully
// determines the type. Built once per module — pre-interned into the WasmModuleBuilder before body emission
// — and read by `emitCallIndirect`, which cannot mutate the shared builder mid-emit. Empty ⟺ the module has
// no indirect call, in which case no funcref table is declared.
typealias IndirectCallTypeIdxMap = Map with (ParamCount, Wasm32Index)

// A dependent op's result value id → the value id whose width it inherits (its `lhs`). Only
// `binOpImm`/`div`/`mod` populate it — the three ops whose result width the Std tier does not
// carry on the op (see `buildValtypeTable`).
typealias DependentLhsMap = Map with (ValueId, ValueId)

// THREE functions are imported, in this fixed order — so their func indices are the constants
// below and every DEFINED function is offset by `WasmImportCount`. `buildWasmCoreModule` MUST
// `addImportFunc` them in exactly this order for the indices to hold; `buildCalleeFuncIdxMap`
// assigns each defined function `WasmImportCount + position` on the same assumption. The
// component embed maps imports by NAME, so their ORDER is otherwise free — only this
// index bookkeeping must be exact.
//   0  wasi:cli/exit@0.2.6 exit-with-code                              (param i32) -> ()
//   1  wasi:cli/stdout@0.2.6 get-stdout                               () -> (result i32)
//   2  wasi:io/streams@0.2.6 [method]output-stream.blocking-write-and-flush  (i32,i32,i32,i32) -> ()
let WasmImportCount = 3 as Wasm32Index
let ExitImportFuncIdx = 0 as Wasm32Index
let GetStdoutImportFuncIdx = 1 as Wasm32Index
let BlockingWriteFlushImportFuncIdx = 2 as Wasm32Index

// The canonical-ABI RETURN AREA `osWriteStdout` hands `blocking-write-and-flush` its
// `result<_, stream-error>` into. It sits in the low scratch region BELOW the `.data` base
// (1024) and within page 0, so it never overlaps real data. The write result is ignored
// (fire-and-forget), so the area is written but never read — 256 leaves ample room to the
// data base. Mirrors v1's `wasiRetAreaBase` (MirToWasm.maxon:324).
let WasmRetAreaBase = 256 as Imm32

// `blocking-write-and-flush(handle, ptr, len, retArea)` takes four i32 params — the stream handle,
// the contents pointer, the contents length, and the canonical-ABI return area.
let WasmWriteFlushParamCount = 4

// The linear-memory address the top-level-`var` `.data` image is laid at. Low memory below it is
// a NULL GUARD — no global's address is ever 0 — matching v1's convention and keeping any future
// null/None sentinel distinct from real data. 8-aligned (1024 = 128·8), so every word64 global
// slot lands naturally aligned; the exact value is otherwise free (nothing else in this slice
// touches linear memory). A `globalAddr` resolves to `base + the global's `.data` offset`.
let WasmDataBaseOffset = 1024 as Wasm32Index

// A wasm linear-memory page is 64 KiB. The memory's declared minimum must cover the whole `.data`
// image (`base + size`); the page size is a power of two, so rounding up is a shift, not a divide
// (a divide would desugar to a throwing checked-division call — see the throwing-division rung).
let WasmPageSizeLog2 = 16
let WasmPageSizeMask = 0xFFFF as ByteCount

// `memory.grow` returns the previous page count, or this sentinel — -1 as an i32, which
// `emitOsAllocPages` sign-extends to -1 in i64 — on OOM. The allocator lowering tests for it and
// traps.
let WasmMemoryGrowOom = -1 as ParsedInt

// The minimum page count a memory must declare to hold a `.data` image ending at `base +
// dataSize`, rounded up to whole 64 KiB pages. `base` is a positive constant, so the count is
// always at least one — the WASI `run` skeleton requires a memory export whether or not the
// program has any global.
function wasmMemoryMinPages(base Wasm32Index, dataSize ByteCount) returns Wasm32Index
	let endByte = (base as ByteCount) + dataSize
	return ((endByte + WasmPageSizeMask) shr WasmPageSizeLog2) as Wasm32Index
end 'wasmMemoryMinPages'

// The `run` result value pushed after `call $exit`: `exit-with-code` never returns, so this
// i32 is unreachable, but the validator requires the `(result i32)` on the stack at the end.
let RunOkResult = 0 as Imm32

// The status a range-check violation exits with — the wasm twin of x64's `PanicExitCode` (1). No
// message/backtrace (wasm has no panic runtime); see `emitRangePanic`.
let RangePanicExitCode = 1 as Imm32

// The entry function the synthesized `$run` calls. `main` returns `ExitCode`; `$run` wraps it
// to i32 and hands it to `exit-with-code`.
let WasmMainFunctionName = b"main"

// The Preview2 import and the component export names — the exact interface identifiers the
// golden component skeleton was built and run against (CONTRACT §5).
let WasiExitModuleName = b"wasi:cli/exit@0.2.6"
let WasiExitFieldName = b"exit-with-code"
let WasiRunExportName = b"wasi:cli/run@0.2.6#run"
let WasmMemoryExportName = b"memory"

// The Preview2 stdout-write imports (P1.2 wave A — `print`). `osWriteStdout` gets the stdout
// output-stream handle via `wasi:cli/stdout` `get-stdout`, then writes+flushes via
// `wasi:io/streams` `[method]output-stream.blocking-write-and-flush`. The versioned interface
// ids and the `[method]…` field spelling are what `wasm-tools component new` matches against the
// WIT world — verbatim from v1 (`MirToWasm.maxon:1134-1153`).
let WasiStdoutModuleName = b"wasi:cli/stdout@0.2.6"
let WasiGetStdoutFieldName = b"get-stdout"
let WasiStreamsModuleName = b"wasi:io/streams@0.2.6"
let WasiBlockingWriteFlushFieldName = b"[method]output-stream.blocking-write-and-flush"

// The `.rdata` image (String-literal records + blobs) is laid in linear memory immediately
// after the `.data` image, rounded up to 8 so every 8-byte record field lands naturally
// aligned. The base is otherwise free — nothing else in this slice touches linear memory
// above the `.data` image.
let WasmRdataAlignment = 8 as ByteCount

// ==========================================================================
// Seam 2 — the whole-module entry (the ONLY external symbol)
// ==========================================================================

// Lower a fully-compiled Std module to a WASI-Preview2 CORE wasm module. The module imports
// `exit-with-code`, defines every function in `module.functions` under the identity-local
// model, synthesizes the `wasi:cli/run@0.2.6#run` entry (`call $main; i32.wrap_i64; call
// $exit; i32.const 0`), and exports `memory` + `run`. Deterministic: output is driven entirely
// by module/block/op/arg ORDER, never by map iteration, so worker-count byte-identity holds.
export function buildWasmCoreModule(module StdModule, globalData GlobalDataTable) returns ByteArray
	let calleeFuncIdx = buildCalleeFuncIdxMap(module)
	let calleeReturnType = buildCalleeReturnTypeMap(module)
	let calleeParamTypes = buildCalleeParamTypesMap(module)

	var builder = WasmModuleBuilder.create()

	// The WASI import functypes are interned FIRST (their indices are otherwise free but must precede any
	// interning that assumes them). Do it before pre-interning the indirect-call functypes below so the
	// type-section order stays deterministic.
	appendWasiImports(builder)

	// Pre-intern one wasm functype per distinct indirect-call arg count (the `(i64^n) -> i64` shape every
	// A1 function value has), so `emitCallIndirect` reads the type index out of a map instead of mutating
	// the shared builder mid-body. When any indirect call exists, the module needs a funcref table covering
	// every function — enable it here, before the functions (and the run entry) are added.
	let indirectCallTypeIdx = buildIndirectCallTypeIdxMap(module, builder: builder)
	if indirectCallTypeIdx.count() > 0 'usesFunctionValues'
		builder.enableFuncrefTable()
	end 'usesFunctionValues'

	// The two linear-memory images, rendered ONCE in `GlobalDataTable`'s layout order
	// (deterministic — no map iteration):
	//   • `.data`  — the top-level-`var` slots, at `WasmDataBaseOffset`. Empty for a program with
	//     no top-level `var`.
	//   • `.rdata` — the String-literal records + blobs, at `rdataBase` (immediately after the
	//     `.data` image, 8-aligned). Empty for a program with no String literal.
	// Both are shared by the per-function emitters (a `globalAddr` resolves against `.data`, an
	// `rdataAddr` against `.rdata`) and by the module's memory + data sections.
	let dataImage = globalData.dataSectionImage()
	let rdataBase = wasmRdataBase(WasmDataBaseOffset, dataSize: dataImage.count())

	// A String literal's record carries `buffer@0` = the ABSOLUTE address of its byte blob, which
	// only exists once `rdataBase` is fixed. wasm is fixed-base, so that address is compile-time
	// computable (`rdataBase + blobOffset`); bake it into the `.rdata` IMAGE now, exactly as the
	// PE writer patches `.rdata` before writing it (`PeWriter.patchStringBufferFixups`).
	var rdataImage = globalData.rdataImage()
	applyStringBufferFixups(rdataImage, globalData: globalData, rdataBase: rdataBase)

	// The WASI imports were added FIRST (above), in the order the `*ImportFuncIdx` constants fix, so every
	// defined function gets the index `calleeFuncIdx` precomputed (`WasmImportCount + position`). Order
	// among imports is otherwise free (the component embed maps by name), but the func-index bookkeeping
	// depends on it.

	// Defined functions, in `module.functions` order — the order `calleeFuncIdx` assumes.
	for funcIdx in 0 upto module.funcCount() 'eachFunc'
		let func = module.getFunc(funcIdx)
		var emitter = WasmFuncEmitter.create(module, func: func, globalData: globalData, dataBase: WasmDataBaseOffset, rdataBase: rdataBase, calleeFuncIdx: calleeFuncIdx, calleeReturnType: calleeReturnType, calleeParamTypes: calleeParamTypes, indirectCallTypeIdx: indirectCallTypeIdx)
		emitter.emit()
		let typeIdx = builder.internFuncType(funcParamValTypes(func), results: funcSignatureResultValTypes(func))
		_ = builder.addFunction(typeIdx, localTypes: emitter.localTypes, body: emitter.body.bytes())
	end 'eachFunc'

	let runFuncIdx = appendRunEntry(builder, module: module, calleeFuncIdx: calleeFuncIdx)

	// The memory must cover BOTH images; `.rdata` sits above `.data`, so `rdataBase + rdataSize`
	// is the high-water mark (and `rdataBase >= WasmDataBaseOffset` even with no globals, so the
	// WASI `run` skeleton's mandatory memory export is always at least one page). Each non-empty
	// image is laid as its own active segment at its base — an empty image emits none.
	builder.exportMemory(WasmMemoryExportName, minPages: wasmMemoryMinPages(rdataBase, dataSize: rdataImage.count()))
	if dataImage.count() > 0 'hasGlobals'
		builder.addDataSegment(WasmDataBaseOffset, bytes: dataImage)
	end 'hasGlobals'
	if rdataImage.count() > 0 'hasRdata'
		builder.addDataSegment(rdataBase, bytes: rdataImage)
	end 'hasRdata'
	builder.exportFunc(WasiRunExportName, funcIdx: runFuncIdx)

	return builder.finish()
end 'buildWasmCoreModule'

// Add the three WASI imports in the order the `*ImportFuncIdx` constants pin: `exit-with-code`
// (0), `get-stdout` (1), `blocking-write-and-flush` (2). `exit-with-code` takes one i32 (the
// status) and returns nothing; `get-stdout` takes nothing and returns the i32 stream handle;
// `blocking-write-and-flush` takes (handle, ptr, len, retArea) — four i32 — and returns nothing.
function appendWasiImports(builder WasmModuleBuilder)
	let exitTypeIdx = builder.internFuncType(singletonValTypes(WasmValType.i32), results: WasmValTypeArray.create())
	_ = builder.addImportFunc(WasiExitModuleName, fieldName: WasiExitFieldName, typeIdx: exitTypeIdx)

	let getStdoutTypeIdx = builder.internFuncType(WasmValTypeArray.create(), results: singletonValTypes(WasmValType.i32))
	_ = builder.addImportFunc(WasiStdoutModuleName, fieldName: WasiGetStdoutFieldName, typeIdx: getStdoutTypeIdx)

	// `blocking-write-and-flush(handle, ptr, len, retArea)` — four i32 params, no result.
	var writeFlushParams = WasmValTypeArray.create()
	for _ in 0 upto WasmWriteFlushParamCount 'eachParam'
		writeFlushParams.push(WasmValType.i32)
	end 'eachParam'
	let writeFlushTypeIdx = builder.internFuncType(writeFlushParams, results: WasmValTypeArray.create())
	_ = builder.addImportFunc(WasiStreamsModuleName, fieldName: WasiBlockingWriteFlushFieldName, typeIdx: writeFlushTypeIdx)
end 'appendWasiImports'

// Bake each String literal's `buffer@0` field into the `.rdata` image: overwrite the record's
// first 8 bytes with the blob's absolute linear-memory address (`rdataBase + blobOffset`) in the
// low 4 bytes, the high 4 left zero — the slot is 8 bytes but a wasm address is an i32. The
// `.data`→`.data` twin of `PeWriter.patchStringBufferFixups`, over an absolute (fixed-base) wasm
// address rather than an `ImageBase`-relative VA. Deterministic: `stringBufferFixups` is in
// registration order.
function applyStringBufferFixups(rdataImage ByteArray, globalData GlobalDataTable, rdataBase Wasm32Index)
	for fixup in globalData.stringBufferFixups 'each'
		let recordOffset = globalData.rdataOffsetOf(fixup.recordLabel)
		let blobAddr = wasmLinearAddress(rdataBase, byteOffset: globalData.rdataOffsetOf(fixup.blobLabel))
		patchQword(rdataImage, offset: recordOffset + StringBufferOffset, value: blobAddr as MachineWord)
	end 'each'
end 'applyStringBufferFixups'

// The `.rdata` base: the first 8-aligned linear-memory address at or after the end of the
// `.data` image. `WasmDataBaseOffset` is itself 8-aligned, so a program with no top-level `var`
// puts `.rdata` at `WasmDataBaseOffset`.
function wasmRdataBase(dataBase Wasm32Index, dataSize ByteCount) returns Wasm32Index
	return alignUp((dataBase as ByteCount) + dataSize, alignment: WasmRdataAlignment) as Wasm32Index
end 'wasmRdataBase'

// Synthesize the component entry `wasi:cli/run@0.2.6#run() -> i32`: run `main`, hand its
// exit code to `exit-with-code`, and leave the ok-discriminant on the stack. Returns the
// entry's wasm function index (for the export).
function appendRunEntry(builder WasmModuleBuilder, module StdModule, calleeFuncIdx CalleeFuncIdxMap) returns Wasm32Index
	let mainFuncIdx = try calleeFuncIdx.get(WasmMainFunctionName) otherwise panic("buildWasmCoreModule: no `main` function in the module — the wasm `run` entry has nothing to call")
	let mainReturnValType = mainReturnValueType(module)

	var runBody = WasmBody.create()
	runBody.call(mainFuncIdx)

	// THE LEAK GATE — the sibling of the native backends' entry-stub gate
	// (BackendDispatch.prependEntryStub). When the MM runtime installed `__mm_leak_check`, main's
	// exit code is routed through it before exit; a leaked program comes back as 101. `exit-with-code`
	// takes an i32, so the resulting code — i64 after the gate, else main's own return width — is
	// wrapped last. `main` returns `ExitCode` (i64 in the corpus); a narrower ExitCode is already i32.
	let exitCodeVt = appendLeakGate(runBody, mainReturnValType: mainReturnValType, calleeFuncIdx: calleeFuncIdx)
	if exitCodeVt == WasmValType.i64 'wrap'
		runBody.i32WrapI64()
	end 'wrap'
	runBody.call(ExitImportFuncIdx)
	runBody.i32Const(RunOkResult)

	let runTypeIdx = builder.internFuncType(WasmValTypeArray.create(), results: singletonValTypes(WasmValType.i32))
	return builder.addFunction(runTypeIdx, localTypes: WasmValTypeArray.create(), body: runBody.bytes())
end 'appendRunEntry'

// THE LEAK GATE on the wasm exit path (P1.0r), ported from the native `prependEntryStub`
// (BackendDispatch:205). When the MM runtime installed `__mm_leak_check`, main's exit code (on the
// stack) is routed through it: it returns the code UNCHANGED, or LeakExitCode (101) when any
// allocation outlived the program — so a leaking heap program FAILS with 101 rather than passing
// invisibly. `__mm_leak_check` is an ordinary i64→i64 Std function, so a narrower ExitCode is widened
// to i64 first. Without the MM runtime the program cannot leak (nothing was allocated), so the gate
// is skipped and the code passes straight through — keeping the non-heap path byte-identical. The MM
// runtime is present ⟺ `__mm_leak_check` is a callee, so `calleeFuncIdx` answers the same question
// the native gate asks `moduleHasFunction`, and hands back the func index in one lookup. Returns the
// valtype now on the stack: i64 after the gate, else main's own return valtype.
function appendLeakGate(runBody WasmBody, mainReturnValType WasmValType, calleeFuncIdx CalleeFuncIdxMap) returns WasmValType
	let leakCheckIdx = try calleeFuncIdx.get(MmLeakCheckName) otherwise return mainReturnValType
	coerceOnStack(runBody, from: mainReturnValType, to: WasmValType.i64)
	runBody.call(leakCheckIdx)
	return WasmValType.i64
end 'appendLeakGate'

// The valtype of `main`'s return value. `main` must return a value (`ExitCode`) — a void
// `main` would leave the run entry nothing to pass to `exit-with-code`.
function mainReturnValueType(module StdModule) returns WasmValType
	for func in module.functions 'eachFunc'
		if func.name == WasmMainFunctionName 'isMain'
			match func.returnType 'rt'
				void then panic("buildWasmCoreModule: `main` returns void, but the wasm `run` entry needs an ExitCode to pass to exit-with-code")
				value(inner) then return wasmValTypeOf(inner)
			end 'rt'
		end 'isMain'
	end 'eachFunc'
	panic("buildWasmCoreModule: no `main` function in the module")
end 'mainReturnValueType'

// ==========================================================================
// Module-level maps (built once, looked up O(1) — never iterated for output)
// ==========================================================================

// Callee name → wasm function index. Defined functions land at `importCount + position`
// because `buildWasmCoreModule` adds the sole import first, then the functions in this exact
// order — so the index is computable here without depending on `addFunction`'s return.
function buildCalleeFuncIdxMap(module StdModule) returns CalleeFuncIdxMap
	var map = CalleeFuncIdxMap.create()
	for i in 0 upto module.funcCount() 'eachFunc'
		let func = module.getFunc(i)
		map.upsert(func.name, value: (WasmImportCount + i) as Wasm32Index)
	end 'eachFunc'
	return map
end 'buildCalleeFuncIdxMap'

// Callee name → Std return type, so a `call`'s result is stored only when the callee returns
// a value (a void callee pushes nothing on the wasm stack — a `local.set` there underflows).
function buildCalleeReturnTypeMap(module StdModule) returns CalleeReturnTypeMap
	var map = CalleeReturnTypeMap.create()
	for func in module.functions 'eachFunc'
		map.upsert(func.name, value: func.returnType)
	end 'eachFunc'
	return map
end 'buildCalleeReturnTypeMap'

// callee name → its parameter valtypes, in declaration order. Used by `emitCall` to coerce each
// argument to the width the callee's parameter declares — an `i64` literal passed to an `ExitCode`
// (i32) parameter needs an `i32.wrap_i64`, which the native backends never emit (64-bit registers).
function buildCalleeParamTypesMap(module StdModule) returns CalleeParamTypesMap
	var map = CalleeParamTypesMap.create()
	for func in module.functions 'eachFunc'
		map.upsert(func.name, value: funcParamValTypes(func))
	end 'eachFunc'
	return map
end 'buildCalleeParamTypesMap'

// Scan every live op for `callIndirect`s and pre-intern one wasm functype per distinct ARG COUNT — the
// `(i64^n) -> i64` shape every A1 function value has (see `IndirectCallTypeIdxMap`). Pre-interning here,
// BEFORE any body is emitted, lets `emitCallIndirect` look the type index up by arg count instead of
// mutating the shared `builder` while it is threading bytes into a body. Returns the arg-count → type-index
// map; empty when the module has no indirect call — the signal that no funcref table is needed.
function buildIndirectCallTypeIdxMap(module StdModule, builder WasmModuleBuilder) returns IndirectCallTypeIdxMap
	var map = IndirectCallTypeIdxMap.create()
	for funcIdx in 0 upto module.funcCount() 'eachFunc'
		let func = module.getFunc(funcIdx)
		for blockRef in func.blockRefs 'eachBlock'
			let block = try module.blocks.get(blockRef) otherwise panic("buildIndirectCallTypeIdxMap: blockRef {blockRef} not in module.blocks")
			for opIdx in block.opRefs 'eachOp'
				let op = try module.ops.get(opIdx) otherwise panic("buildIndirectCallTypeIdxMap: opIdx {opIdx} not in module.ops")
				internIndirectCallTypeFor(op, map: map, builder: builder)
			end 'eachOp'
		end 'eachBlock'
	end 'eachFunc'
	return map
end 'buildIndirectCallTypeIdxMap'

// If `op` is a `callIndirect`, intern the functype for its arg count into `map`; ignore any other op. The
// two-arm range match leans on the band-append invariant: `callIndirect` is the LAST StdOp variant, so
// `const to funcAddr` covers every other variant and a newly-appended one FAILS TO COMPILE here rather than
// being silently swept into the ignore arm. Only body ops carry a `callIndirect` (never a terminator), so
// scanning `block.opRefs` alone is complete.
function internIndirectCallTypeFor(op StdOp, map IndirectCallTypeIdxMap, builder WasmModuleBuilder)
	match op 'k'
		const to funcAddr then break 'k'
		callIndirect(_, _, args) then internIndirectCallType(map, builder: builder, argCount: args.count())
		osRangePanic to osFreePages then break 'k'
	end 'k'
end 'internIndirectCallTypeFor'

// Intern the wasm functype `(i64^argCount) -> i64` for indirect calls of `argCount` arguments and record
// its index in `map`. `internFuncType` dedups by the encoded bytes, so a repeated arg count re-derives the
// SAME index (and a signature that equals a real function's own type shares one type-section entry). The
// single door that builds an indirect call's wasm signature, so the pre-interned type and the call-site
// `call_indirect` immediate cannot disagree.
function internIndirectCallType(map IndirectCallTypeIdxMap, builder WasmModuleBuilder, argCount ParamCount)
	let typeIdx = builder.internFuncType(indirectCallParamValTypes(argCount), results: singletonValTypes(WasmValType.i64))
	map.upsert(argCount, value: typeIdx)
end 'internIndirectCallType'

// The wasm parameter valtypes of an A1 indirect call: `argCount` copies of i64 (see
// `IndirectCallTypeIdxMap` for why every function value is `(i64^n) -> i64`).
function indirectCallParamValTypes(argCount ParamCount) returns WasmValTypeArray
	var params = WasmValTypeArray.create()
	for _ in 0 upto argCount 'each'
		params.push(WasmValType.i64)
	end 'each'
	return params
end 'indirectCallParamValTypes'

// ==========================================================================
// Std type → wasm valtype, and the function-signature valtype lists
// ==========================================================================

// ⭐ THE ONE DOOR from a Std type to a wasm valtype. Everything up to 32 bits lives in an
// i32 wasm local (wasm has no sub-word local); i64/u64 in an i64; the floats map straight
// across. `i1` (a bool) is an i32, which is what `condBranch`/`if` consume and what a compare
// produces. A Maxon `float` is an f64, so f64 is the float valtype every float op selects; the
// f32 mapping is total for classification completeness, but nothing produces an f32 value.
function wasmValTypeOf(t StdType) returns WasmValType
	return match t 'w'
		i1 gives WasmValType.i32
		i8 gives WasmValType.i32
		i16 gives WasmValType.i32
		i32 gives WasmValType.i32
		u8 gives WasmValType.i32
		u16 gives WasmValType.i32
		u32 gives WasmValType.i32
		i64 gives WasmValType.i64
		u64 gives WasmValType.i64
		f32 gives WasmValType.f32
		f64 gives WasmValType.f64
	end 'w'
end 'wasmValTypeOf'

// True when an integer op of type `t` selects the i64.* instruction family rather than i32.*.
// A float `t` reaching here means an integer-op emitter did not take its float path first — a
// lowering bug, not an out-of-slice case — so it panics naming `what`.
function isWideInt(t StdType, what String) returns bool
	match wasmValTypeOf(t) 'w'
		i32 then return false
		i64 then return true
		f32 then panic("wasm: {what} on an f32 operand is not in the scalar slice")
		f64 then panic("wasm: {what} on an f64 operand — this integer-op emitter should have taken the float path first")
	end 'w'
end 'isWideInt'

// shv2's `float` is f64 THROUGHOUT — the wasm float path, like the native backends
// (arm64RequireScalarDouble / its x64 twin), is scalar-double only. Nothing in the frontend
// produces an f32 (a Maxon `float` is an f64), so an f32 reaching a float emitter is a
// lowering bug, not an unsupported-slice case — and `f64.const`/`f64.*` would encode the wrong
// width for one silently. This is the one door that says so.
function requireF64(t StdType, what String)
	if t != StdType.f64 'notDouble'
		panic("wasm: {what} on {t.name} — the wasm float path is f64-only (Maxon's `float` is f64); nothing produces an f32")
	end 'notDouble'
end 'requireF64'

function funcParamValTypes(func IrFunction) returns WasmValTypeArray
	var params = WasmValTypeArray.create()
	for pt in func.paramTypes 'each'
		params.push(wasmValTypeOf(pt))
	end 'each'
	return params
end 'funcParamValTypes'

function funcResultValTypes(returnType StdReturnType) returns WasmValTypeArray
	var results = WasmValTypeArray.create()
	match returnType 'r'
		void then break 'r'
		value(inner) then results.push(wasmValTypeOf(inner))
	end 'r'
	return results
end 'funcResultValTypes'

// The wasm result signature of a whole function: its value result (if any), plus — for a THROWING
// function — the i64 error flag as a SECOND result (or, for a void-throwing function, the sole one).
// This is the multi-value image of shv2's dual-register error ABI: a throwing function exits through
// `errorReturn`, which pushes the value then the flag (or, void, just the flag), so the wasm type must
// declare both. The native backends need no such split — the flag rides a fixed second register
// (R10/x9) outside the signature. `funcResultValTypes` alone still names the PRIMARY result the body's
// `errorReturn`/`ret` coerce to (see `emitErrorReturn`/`emitRet`); this is the signature-only view.
function funcSignatureResultValTypes(func IrFunction) returns WasmValTypeArray
	var results = funcResultValTypes(func.returnType)
	if throwsClauseIsThrowing(func.throwsTypeName) 'throwing'
		results.push(WasmValType.i64)
	end 'throwing'
	return results
end 'funcSignatureResultValTypes'

function singletonValTypes(vt WasmValType) returns WasmValTypeArray
	var one = WasmValTypeArray.create()
	one.push(vt)
	return one
end 'singletonValTypes'

// Coerce the value on top of the stack from `from` to `to` when a value's width differs from the
// width the consuming context requires. The native backends never need this — every value sits in a
// 64-bit register, so a narrow `ExitCode` return of an `i64` arithmetic result is a no-op there — but
// wasm's typed stack rejects `i64` where `i32` is declared. A same-valtype coercion (including
// `f64 -> f64`) is a NO-OP, so a float that already sits at its own width passes through untouched.
// A CROSS-DOMAIN coercion (int <-> float) is never generated: the frontend inserts an explicit
// `siToFp`/`fpToSi` op for every domain change (int->int carries none, which is why the i32/i64 pair
// IS handled here), so an int<->float pair reaching this point is a lowering bug, and the panic
// names it as one. A signed widen matches `int`'s signedness.
function coerceOnStack(body WasmBody, from WasmValType, to WasmValType)
	if from == to 'same'
		return
	end 'same'

	if from == WasmValType.i64 and to == WasmValType.i32 'narrow'
		body.i32WrapI64()
		return
	end 'narrow'

	if from == WasmValType.i32 and to == WasmValType.i64 'widen'
		body.i64ExtendI32S()
		return
	end 'widen'

	panic("coerceOnStack: {from.name} -> {to.name} crosses the int/float domain with no explicit conversion — the frontend inserts siToFp/fpToSi for every domain change, so this is a lowering bug")
end 'coerceOnStack'

// ==========================================================================
// Per-ValueId valtype table (dense 0..maxValueId), driving local declarations
// ==========================================================================

// Read a value's declared valtype from the table. Every value an op defines is recorded, so a
// read is always in range; `i64` is the fill for the padding slots of any value-id gaps DCE
// left behind (an unused local, never referenced).
function getValtype(valtypes WasmValTypeArray, v ValueId) returns WasmValType
	return try valtypes.get(v) otherwise WasmValType.i64
end 'getValtype'

// Write `vt` at `v`, extending the (i64-filled) table to reach it. `growFilled` grows the
// backing geometrically, so recording defs in id order is amortized-linear.
function setValtype(valtypes WasmValTypeArray, v ValueId, vt WasmValType)
	if v >= valtypes.count() 'extend'
		valtypes.growFilled(v + 1, value: WasmValType.i64)
	end 'extend'

	try valtypes.set(v, value: vt) otherwise panic("setValtype: v{v} OOB after growFilled — a grow that just ensured the slot cannot leave it missing")
end 'setValtype'

// The valtype of a unary op's RESULT. `neg`/`bitNot`/`logicalNot` compute what they consume;
// the two conversions INVERT (`operandType` is always the source — `siToFp` reads an int and
// yields f64, `fpToSi` reads f64 and yields an int), so their result type is NOT `operandType`.
// Reading `operandType` as the result here would put the conversion's result in the wrong local
// class (an f64 result recorded i64, or the reverse) — see StdUnaryOpcode's header.
function unaryResultValType(opcode StdUnaryOpcode, operandType StdType) returns WasmValType
	return match opcode 'k'
		neg gives wasmValTypeOf(operandType)
		bitNot gives wasmValTypeOf(operandType)
		logicalNot gives wasmValTypeOf(operandType)
		siToFp gives WasmValType.f64
		fpToSi gives WasmValType.i64
	end 'k'
end 'unaryResultValType'

// The valtype of a `call`'s result — the callee's return type. A void callee still names a
// result value in the Std IR (nothing reads it in the scalar slice); i64 is a harmless
// placeholder for that unread local.
function callResultValType(callee ByteArray, calleeReturnType CalleeReturnTypeMap) returns WasmValType
	let rt = try calleeReturnType.get(callee) otherwise panic("callResultValType: no Std function named '{String.from(callee)}'")
	return match rt 'r'
		void gives WasmValType.i64
		value(inner) gives wasmValTypeOf(inner)
	end 'r'
end 'callResultValType'

// Build the dense per-ValueId valtype table for `func`. Params own ids 0..paramCount-1;
// block-args and op results own the rest. Most ops carry their result's type directly; the
// three whose result width the Std tier does NOT carry — `binOpImm`/`div`/`mod`, whose result
// is exactly as wide as their `lhs` — are recorded as DEPENDENT and resolved afterward, so the
// table is correct regardless of block/op order (a single forward pass would need `blockRefs`
// to be in dominance order, which is not guaranteed here).
function buildValtypeTable(module StdModule, func IrFunction, calleeReturnType CalleeReturnTypeMap) returns WasmValTypeArray
	var valtypes = WasmValTypeArray.create()

	for i in 0 upto func.paramCount 'eachParam'
		let pt = try func.paramTypes.get(i) otherwise panic("buildValtypeTable: paramTypes.get OOB at {i} (paramCount={func.paramCount})")
		setValtype(valtypes, v: i, vt: wasmValTypeOf(pt))
	end 'eachParam'

	var depResult = ValueIdArray.create()
	var depLhs = ValueIdArray.create()

	for blockRef in func.blockRefs 'eachBlock'
		let block = try module.blocks.get(blockRef) otherwise panic("buildValtypeTable: blockRef {blockRef} not in module.blocks")

		for arg in block.blockArgs 'eachArg'
			setValtype(valtypes, v: arg.valueId, vt: wasmValTypeOf(arg.argType))
		end 'eachArg'

		for opIdx in block.opRefs 'eachOp'
			recordDefValtype(try module.ops.get(opIdx) otherwise panic("buildValtypeTable: opIdx {opIdx} not in module.ops"), valtypes: valtypes, depResult: depResult, depLhs: depLhs, calleeReturnType: calleeReturnType)
		end 'eachOp'

		if block.hasTerminatorOp() 'hasTerm'
			recordDefValtype(try module.ops.get(block.terminatorIndex()) otherwise panic("buildValtypeTable: terminatorIndex not in module.ops"), valtypes: valtypes, depResult: depResult, depLhs: depLhs, calleeReturnType: calleeReturnType)
		end 'hasTerm'
	end 'eachBlock'

	resolveDependents(valtypes, depResult: depResult, depLhs: depLhs)
	return valtypes
end 'buildValtypeTable'

// Record one op's defined-value valtype, or queue it as dependent. Exhaustive over `StdOp`
// with no bare `default`: a new value-defining op fails to compile here rather than defaulting
// a value to the wrong width. Terminators and the out-of-scope memory/system ops define
// nothing this backend declares a local for (a memory/system op present at all makes the body
// emitter panic before this table is ever consumed).
function recordDefValtype(op StdOp, valtypes WasmValTypeArray, depResult ValueIdArray, depLhs ValueIdArray, calleeReturnType CalleeReturnTypeMap)
	match op 'def'
		const(resultId, _, valueType) then setValtype(valtypes, v: resultId, vt: wasmValTypeOf(valueType))
		binOp(resultId, _, _, _, operandType) then setValtype(valtypes, v: resultId, vt: wasmValTypeOf(operandType))
		unaryOp(resultId, _, opcode, operandType) then setValtype(valtypes, v: resultId, vt: unaryResultValType(opcode, operandType: operandType))
		cmp(resultId, _, _, _, _) then setValtype(valtypes, v: resultId, vt: WasmValType.i32)
		binOpImm(resultId, lhs, _, _) then recordDependentValtype(valtypes, depResult: depResult, depLhs: depLhs, resultId: resultId, lhs: lhs)
		cmpImm(resultId, _, _, _) then setValtype(valtypes, v: resultId, vt: WasmValType.i32)
		div(resultId, lhs, _) then recordDependentValtype(valtypes, depResult: depResult, depLhs: depLhs, resultId: resultId, lhs: lhs)
		mod(resultId, lhs, _) then recordDependentValtype(valtypes, depResult: depResult, depLhs: depLhs, resultId: resultId, lhs: lhs)
		condBranch then break 'def'
		branch then break 'def'
		ret then break 'def'
		param(resultId, _, paramType) then setValtype(valtypes, v: resultId, vt: wasmValTypeOf(paramType))
		call(resultId, callee, _) then setValtype(valtypes, v: resultId, vt: callResultValType(callee, calleeReturnType: calleeReturnType))
		retVoid then break 'def'
		// ⚠ A wasm linear-memory ADDRESS IS AN i32, not the i64 pointer width the native backends
		// carry in a 64-bit register. `globalAddr` materializes an `i32.const`, so its result local
		// must be i32 — the width `loadIndirect`/`storeIndirect` then consume as the base address.
		globalAddr(resultId, _) then setValtype(valtypes, v: resultId, vt: WasmValType.i32)
		loadIndirect(resultId, _, _, valueType) then setValtype(valtypes, v: resultId, vt: wasmValTypeOf(valueType))
		storeIndirect then break 'def'
		osAllocPages(resultId, _) then setValtype(valtypes, v: resultId, vt: WasmValType.i64)
		osWriteStdout then break 'def'
		// A wasm linear-memory ADDRESS IS AN i32 (like `globalAddr`), not the i64 pointer width the
		// native backends carry. `rdataAddr` materializes an `i32.const`, so its result local is i32 —
		// the width `loadIndirect`/`osWriteStdout` then consume as the base address.
		rdataAddr(resultId, _) then setValtype(valtypes, v: resultId, vt: WasmValType.i32)
		// A `tryCall` defines TWO values (like `call` plus the flag); `errorReturn`/`osExit` define
		// none (a return terminator, a diverging exit). See `recordTryCallDefs`.
		tryCall(resultId, errorFlagId, callee, _) then recordTryCallDefs(valtypes, resultId: resultId, errorFlagId: errorFlagId, callee: callee, calleeReturnType: calleeReturnType)
		errorReturn then break 'def'
		osExit then break 'def'
		// P1.5-A1 non-capturing function values. A function value is a machine word (its Std type collapses
		// to i64 — valueTagToStdType), so BOTH a `funcAddr` (which materializes the callee's table index)
		// and a `callIndirect` result (the callee's i64 return — every A1 function value returns an
		// integer/named type) are i64. `funcAddr` is narrowed to the i32 `call_indirect` table-index operand
		// only at the call itself (`emitFuncAddr`/`emitCallIndirect`), so it FLOWS as i64 like every other
		// function value — unlike a `globalAddr`/`rdataAddr`, an i32 address consumed in place.
		funcAddr(resultId, _) then setValtype(valtypes, v: resultId, vt: WasmValType.i64)
		callIndirect(resultId, _, _) then setValtype(valtypes, v: resultId, vt: WasmValType.i64)
		osRangePanic to osFreePages then break 'def'
	end 'def'
end 'recordDefValtype'

// Record a `tryCall`'s two defined values: its primary result — the callee's return width, exactly as
// a plain `call` (`callResultValType`) — and its error flag, always i64 (the dual-register flag the
// native backends carry in R10/x9). A void-returning throwing callee still names an (unread) result
// value; `callResultValType` gives it the same i64 placeholder a void `call` result gets.
function recordTryCallDefs(valtypes WasmValTypeArray, resultId ValueId, errorFlagId ValueId, callee ByteArray, calleeReturnType CalleeReturnTypeMap)
	setValtype(valtypes, v: resultId, vt: callResultValType(callee, calleeReturnType: calleeReturnType))
	setValtype(valtypes, v: errorFlagId, vt: WasmValType.i64)
end 'recordTryCallDefs'

// Reserve `resultId`'s slot (i64 placeholder) and queue its width to be copied from `lhs`.
function recordDependentValtype(valtypes WasmValTypeArray, depResult ValueIdArray, depLhs ValueIdArray, resultId ValueId, lhs ValueId)
	setValtype(valtypes, v: resultId, vt: WasmValType.i64)
	depResult.push(resultId)
	depLhs.push(lhs)
end 'recordDependentValtype'

// Resolve every dependent op's width to its `lhs`'s width. A dependent op's `lhs` is either a
// self-typed value (already in the table) or another dependent op, and the chain is acyclic
// (SSA dominance, and a phi/param/const always terminates it), so a memoized walk resolves all
// of them in O(values).
function resolveDependents(valtypes WasmValTypeArray, depResult ValueIdArray, depLhs ValueIdArray)
	var depLhsByResult = DependentLhsMap.create()
	for k in 0 upto depResult.count() 'index'
		let r = try depResult.get(k) otherwise panic("resolveDependents: depResult.get OOB at {k}")
		let l = try depLhs.get(k) otherwise panic("resolveDependents: depLhs.get OOB at {k}")
		depLhsByResult.upsert(r, value: l)
	end 'index'

	var resolved = StdValueUseSet.create()
	for k in 0 upto depResult.count() 'resolve'
		let r = try depResult.get(k) otherwise panic("resolveDependents: depResult.get OOB at {k}")
		_ = widthOfValue(r, valtypes: valtypes, depLhsByResult: depLhsByResult, resolved: resolved)
	end 'resolve'
end 'resolveDependents'

// The valtype of `v`, resolving a dependent op's width through its `lhs` and memoizing the
// answer into the table so a shared prefix is walked once. A `v` not in the dependent map is
// self-typed and its table entry is already correct.
function widthOfValue(v ValueId, valtypes WasmValTypeArray, depLhsByResult DependentLhsMap, resolved StdValueUseSet) returns WasmValType
	if resolved.contains(v) 'memo'
		return getValtype(valtypes, v: v)
	end 'memo'

	let lhs = try depLhsByResult.get(v) otherwise return getValtype(valtypes, v: v)
	let w = widthOfValue(lhs, valtypes: valtypes, depLhsByResult: depLhsByResult, resolved: resolved)
	setValtype(valtypes, v: v, vt: w)
	resolved.insert(v)
	return w
end 'widthOfValue'

// ==========================================================================
// WasmFuncEmitter — per-function body + local-declaration emission
// ==========================================================================

type WasmFuncEmitter
	var module as StdModule
	var func as IrFunction
	// The laid-out data tables and the linear-memory bases their offsets are relative to: a
	// `globalAddr` resolves its label to a `.data` offset (base `dataBase`), an `rdataAddr` to a
	// `.rdata` offset (base `rdataBase`). All module-wide constants; each emitter holds them so an
	// address resolves in O(1) with no per-function setup.
	var globalData as GlobalDataTable
	var dataBase as Wasm32Index
	var rdataBase as Wasm32Index
	var calleeFuncIdx as CalleeFuncIdxMap
	var calleeReturnType as CalleeReturnTypeMap
	var calleeParamTypes as CalleeParamTypesMap
	// Indirect-call arg count → its pre-interned `(i64^n) -> i64` functype index, read by
	// `emitCallIndirect` (see `IndirectCallTypeIdxMap`). Module-wide; shared read-only by every emitter.
	var indirectCallTypeIdx as IndirectCallTypeIdxMap

	// Dense per-ValueId valtype table (0..maxValueId).
	var valtypes as WasmValTypeArray
	// The instruction-byte accumulator (no local decls, no trailing 0x0B — the module builder
	// frames the body around A2's bytes). Exported: `buildWasmCoreModule` reads `body.bytes()`.
	export var body as WasmBody
	// The valtypes of the declared locals (indices paramCount..lastLocal), in index order:
	// value locals, then the dispatch local, then the phi cycle-break scratch locals. Handed to
	// `WasmModuleBuilder.addFunction`, which run-length-encodes them. Exported: read from
	// `buildWasmCoreModule`.
	export var localTypes as WasmValTypeArray

	// Multi-block functions (and single-block self-loops) run under the loop+br_table
	// dispatcher; a lone straight-line block that ends in a return does not.
	var useDispatcher as bool
	// The i32 local holding the next block's dispatch index (only when `useDispatcher`).
	var dispatchLocal as Wasm32Index
	// Valtype → its reserved cycle-break scratch local (only for valtypes present among
	// block-args, only when `useDispatcher`).
	var scratchLocalByValType as ScratchLocalMap
	// Block id → dispatch index (position in `func.blockRefs`), for branch targets.
	var blockDispatchById as BlockDispatchMap

	static function create(module StdModule, func IrFunction, globalData GlobalDataTable, dataBase Wasm32Index, rdataBase Wasm32Index, calleeFuncIdx CalleeFuncIdxMap, calleeReturnType CalleeReturnTypeMap, calleeParamTypes CalleeParamTypesMap, indirectCallTypeIdx IndirectCallTypeIdxMap) returns WasmFuncEmitter
		let valtypes = buildValtypeTable(module, func: func, calleeReturnType: calleeReturnType)
		let useDispatcher = decideDispatcher(module, func: func)

		var emitter = Self{
			module: module,
			func: func,
			globalData: globalData,
			dataBase: dataBase,
			rdataBase: rdataBase,
			calleeFuncIdx: calleeFuncIdx,
			calleeReturnType: calleeReturnType,
			calleeParamTypes: calleeParamTypes,
			indirectCallTypeIdx: indirectCallTypeIdx,
			valtypes: valtypes,
			body: WasmBody.create(),
			localTypes: WasmValTypeArray.create(),
			useDispatcher: useDispatcher,
			dispatchLocal: 0 as Wasm32Index,
			scratchLocalByValType: ScratchLocalMap.create(),
			blockDispatchById: BlockDispatchMap.create()
		}

		emitter.buildBlockDispatchMap()
		emitter.buildLocalDeclarations()
		return emitter
	end 'create'

	// Local layout, in the order `localTypes` (and the wasm local index space) demands:
	//   0..paramCount-1        parameters (from the function SIGNATURE, NOT declared here)
	//   paramCount..maxValueId value locals (identity model: value id == local index)
	//   maxValueId+1           dispatch local (i32), when the dispatcher is used
	//   then                   one scratch local per block-arg valtype, when the dispatcher is used
	// A single running cursor assigns the reserved locals so adding one never renumbers another.
	function buildLocalDeclarations()
		let valueLocalCount = self.valtypes.count()

		for i in self.func.paramCount upto valueLocalCount 'valueLocals'
			self.localTypes.push(getValtype(self.valtypes, v: i))
		end 'valueLocals'

		if not self.useDispatcher 'noDispatcher'
			return
		end 'noDispatcher'

		self.dispatchLocal = valueLocalCount as Wasm32Index
		self.localTypes.push(WasmValType.i32)

		var nextScratch = (self.dispatchLocal + 1) as Wasm32Index
		let phiValTypes = self.collectPhiValTypes()
		for vt in WasmValType.allCases 'canonical'
			if phiValTypes.contains(vt) 'present'
				self.scratchLocalByValType.upsert(vt, value: nextScratch)
				self.localTypes.push(vt)
				nextScratch = (nextScratch + 1) as Wasm32Index
			end 'present'
		end 'canonical'
	end 'buildLocalDeclarations'

	// The distinct valtypes appearing among this function's block-args — the only valtypes a
	// phi-copy cycle can stage through, and so the only scratch locals worth reserving.
	function collectPhiValTypes() returns PhiValTypeSet
		var present = PhiValTypeSet.create()
		for blockRef in self.func.blockRefs 'eachBlock'
			let block = try self.module.blocks.get(blockRef) otherwise panic("collectPhiValTypes: blockRef {blockRef} not in module.blocks")
			for arg in block.blockArgs 'eachArg'
				present.insert(wasmValTypeOf(arg.argType))
			end 'eachArg'
		end 'eachBlock'
		return present
	end 'collectPhiValTypes'

	function buildBlockDispatchMap()
		for i in 0 upto self.func.blockRefs.count() 'eachBlock'
			let blockRef = try self.func.blockRefs.get(i) otherwise panic("buildBlockDispatchMap: blockRefs.get OOB at {i}")
			let block = try self.module.blocks.get(blockRef) otherwise panic("buildBlockDispatchMap: blockRef {blockRef} not in module.blocks")
			self.blockDispatchById.upsert(block.id, value: i as Wasm32Index)
		end 'eachBlock'
	end 'buildBlockDispatchMap'

	// ----------------------------------------------------------------------
	// Body emission
	// ----------------------------------------------------------------------

	function emit()
		let blockCount = self.func.blockRefs.count()
		if blockCount == 0 'empty'
			self.body.unreachable()
			return
		end 'empty'

		if self.useDispatcher 'dispatch'
			self.emitDispatcher(blockCount)
		end 'dispatch' else 'single'
			self.emitSingleBlock()
		end 'single'
	end 'emit'

	// A lone block that returns: straight-line body then its return terminator. No dispatcher,
	// no dispatch local, no wrapping structure.
	function emitSingleBlock()
		let blockRef = try self.func.blockRefs.get(0) otherwise panic("emitSingleBlock: blockRefs.get(0) OOB")
		let block = try self.module.blocks.get(blockRef) otherwise panic("emitSingleBlock: blockRef {blockRef} not in module.blocks")

		for opIdx in block.opRefs 'eachOp'
			self.emitBodyOp(try self.module.ops.get(opIdx) otherwise panic("emitSingleBlock: opIdx {opIdx} not in module.ops"))
		end 'eachOp'

		if block.hasTerminatorOp() 'hasTerm'
			self.emitStraightLineTerminator(try self.module.ops.get(block.terminatorIndex()) otherwise panic("emitSingleBlock: terminatorIndex not in module.ops"))
		end 'hasTerm' else 'noTerm'
			self.body.unreachable()
		end 'noTerm'
	end 'emitSingleBlock'

	function emitStraightLineTerminator(op StdOp)
		match op 'term'
			ret(retValId) then self.emitRet(retValId)
			retVoid then self.emitRetVoid()
			const to mod then panic("emitStraightLineTerminator: an arith op is not a terminator")
			condBranch then panic("emitStraightLineTerminator: a `condBranch` block should have taken the dispatcher path")
			branch then panic("emitStraightLineTerminator: a `branch` block should have taken the dispatcher path")
			param then panic("emitStraightLineTerminator: a `param` op is not a terminator")
			call then panic("emitStraightLineTerminator: a `call` op is not a terminator")
			globalAddr to rdataAddr then panic("emitStraightLineTerminator: a memory/system op is not a terminator")
			tryCall then panic("emitStraightLineTerminator: a `tryCall` is a value-producing body op, never a terminator")
			errorReturn(retValId, errorFlagId) then self.emitErrorReturn(retValId, errorFlagId: errorFlagId)
			osExit then panic("emitStraightLineTerminator: an `osExit` is a body op followed by a dead return, never a terminator")
			// A `funcAddr`/`callIndirect` is a value-producing body op, never a terminator — the exact
			// mirror of the `call`/`tryCall` arms above (P1.5-A1).
			funcAddr then panic("emitStraightLineTerminator: a `funcAddr` is a value-producing body op, never a terminator")
			callIndirect then panic("emitStraightLineTerminator: a `callIndirect` is a value-producing body op, never a terminator")
			osRangePanic to osFreePages then panic("emitStraightLineTerminator: an `osRangePanic` is a body op, never a terminator")
		end 'term'
	end 'emitStraightLineTerminator'

	// The loop+br_table dispatcher (CONTRACT §1, v1 `emitStructuredCfg`). One outer `loop`; one
	// `block` nested per basic block; a `br_table` off the dispatch local jumps to block N's
	// code (which sits just after the N-th nested `end`). Each block ends by either returning or
	// setting the dispatch local and branching back to the loop. Handles any reducible CFG.
	function emitDispatcher(blockCount BlockCount)
		self.body.beginLoop()

		for _ in 0 upto blockCount 'nest'
			self.body.beginBlock()
		end 'nest'

		self.body.localGet(self.dispatchLocal)
		var targets = Wasm32IndexArray.create()
		for i in 0 upto blockCount 'tableEntry'
			targets.push(i as Wasm32Index)
		end 'tableEntry'
		self.body.brTable(targets, defaultTarget: 0)

		for i in 0 upto blockCount 'eachBlock'
			// Close the i-th nested block; its `end` is exactly where block i's code begins, so
			// `br_table` entry i lands here.
			self.body.endOp()

			let blockRef = try self.func.blockRefs.get(i) otherwise panic("emitDispatcher: blockRefs.get OOB at {i}")
			let block = try self.module.blocks.get(blockRef) otherwise panic("emitDispatcher: blockRef {blockRef} not in module.blocks")

			for opIdx in block.opRefs 'eachOp'
				self.emitBodyOp(try self.module.ops.get(opIdx) otherwise panic("emitDispatcher: opIdx {opIdx} not in module.ops"))
			end 'eachOp'

			// The distance from block-code depth to the outer loop: after i+1 `end`s, the loop is
			// the (blockCount-1-i)-th enclosing structure.
			let loopDepth = (blockCount - 1 - i) as Wasm32Index
			if block.hasTerminatorOp() 'hasTerm'
				self.emitDispatcherTerminator(try self.module.ops.get(block.terminatorIndex()) otherwise panic("emitDispatcher: terminatorIndex not in module.ops"), currentBlock: block, loopDepth: loopDepth)
			end 'hasTerm' else 'noTerm'
				self.body.unreachable()
			end 'noTerm'
		end 'eachBlock'

		self.body.endOp()
		// After the loop: every block returns or branches back, so control never falls out —
		// but the validator checks the stack at the function end, and `unreachable` makes it
		// polymorphic, satisfying any result type (CONTRACT §4.4).
		self.body.unreachable()
	end 'emitDispatcher'

	function emitDispatcherTerminator(op StdOp, currentBlock IrBlock, loopDepth Wasm32Index)
		match op 'term'
			ret(retValId) then self.emitRet(retValId)
			retVoid then self.emitRetVoid()
			branch(targetBlockId) then self.emitDispatchBranch(targetBlockId, currentBlock: currentBlock, loopDepth: loopDepth)
			condBranch(condId, thenBlockId, elseBlockId) then self.emitDispatchCondBranch(condId, thenBlockId: thenBlockId, elseBlockId: elseBlockId, currentBlock: currentBlock, loopDepth: loopDepth)
			const to mod then panic("emitDispatcherTerminator: an arith op is not a terminator")
			param then panic("emitDispatcherTerminator: a `param` op is not a terminator")
			call then panic("emitDispatcherTerminator: a `call` op is not a terminator")
			globalAddr to rdataAddr then panic("emitDispatcherTerminator: a memory/system op is not a terminator")
			tryCall then panic("emitDispatcherTerminator: a `tryCall` is a value-producing body op, never a terminator")
			errorReturn(retValId, errorFlagId) then self.emitErrorReturn(retValId, errorFlagId: errorFlagId)
			osExit then panic("emitDispatcherTerminator: an `osExit` is a body op followed by a dead return, never a terminator")
			// A `funcAddr`/`callIndirect` is a value-producing body op, never a terminator — the exact
			// mirror of the `call`/`tryCall` arms above (P1.5-A1).
			funcAddr then panic("emitDispatcherTerminator: a `funcAddr` is a value-producing body op, never a terminator")
			callIndirect then panic("emitDispatcherTerminator: a `callIndirect` is a value-producing body op, never a terminator")
			osRangePanic to osFreePages then panic("emitDispatcherTerminator: an `osRangePanic` is a body op, never a terminator")
		end 'term'
	end 'emitDispatcherTerminator'

	// ----------------------------------------------------------------------
	// Per-StdOp body emitters (arith + call bands)
	// ----------------------------------------------------------------------

	// Emit one non-terminator op. `ret`/`retVoid` are accepted here too (a Std `ret` is normally
	// the terminator, but is handled uniformly if it appears in a block body). Branch ops are
	// terminators and panic; the memory/system bands are out of the scalar slice and panic.
	function emitBodyOp(op StdOp)
		match op 'body'
			const(resultId, value, valueType) then self.emitConst(resultId, value: value, valueType: valueType)
			binOp(resultId, lhs, rhs, opcode, operandType) then self.emitBinOp(resultId, lhs: lhs, rhs: rhs, opcode: opcode, operandType: operandType)
			unaryOp(resultId, operand, opcode, operandType) then self.emitUnaryOp(resultId, operand: operand, opcode: opcode, operandType: operandType)
			cmp(resultId, lhs, rhs, pred, operandType) then self.emitCmp(resultId, lhs: lhs, rhs: rhs, pred: pred, operandType: operandType)
			binOpImm(resultId, lhs, imm, opcode) then self.emitBinOpImm(resultId, lhs: lhs, imm: imm, opcode: opcode)
			cmpImm(resultId, lhs, imm, pred) then self.emitCmpImm(resultId, lhs: lhs, imm: imm, pred: pred)
			div(resultId, lhs, rhs) then self.emitDivMod(resultId, lhs: lhs, rhs: rhs, isRemainder: false)
			mod(resultId, lhs, rhs) then self.emitDivMod(resultId, lhs: lhs, rhs: rhs, isRemainder: true)
			condBranch then panic("emitBodyOp: a `condBranch` is always a terminator, never a body op")
			branch then panic("emitBodyOp: a `branch` is always a terminator, never a body op")
			ret(retValId) then self.emitRet(retValId)
			param(resultId, index, _) then self.emitParam(resultId, index: index)
			call(resultId, callee, args) then self.emitCall(resultId, callee: callee, args: args)
			retVoid then self.emitRetVoid()
			globalAddr(resultId, label) then self.emitGlobalAddr(resultId, label: label)
			loadIndirect(resultId, addrId, offset, valueType) then self.emitLoadIndirect(resultId, addrId: addrId, offset: offset, valueType: valueType)
			storeIndirect(addrId, offset, valueId, valueType) then self.emitStoreIndirect(addrId, offset: offset, valueId: valueId, valueType: valueType)
			osAllocPages(resultId, sizeId) then self.emitOsAllocPages(resultId, sizeId: sizeId)
			osWriteStdout(bufId, lenId) then self.emitOsWriteStdout(bufId, lenId: lenId)
			rdataAddr(resultId, label) then self.emitRdataAddr(resultId, label: label)
			tryCall(resultId, errorFlagId, callee, args) then self.emitTryCall(resultId, errorFlagId: errorFlagId, callee: callee, args: args)
			// An `errorReturn` is normally the block terminator (like `ret`), but is handled here too for
			// the rare mid-block early-error return, exactly as `ret`/`retVoid` are above.
			errorReturn(retValId, errorFlagId) then self.emitErrorReturn(retValId, errorFlagId: errorFlagId)
			osExit(codeId) then self.emitOsExit(codeId)
			// P1.5-A1 non-capturing function values: materialize a function's table index (`funcAddr`) and
			// call THROUGH one (`callIndirect`). See the two emitters for the funcref-table lowering.
			funcAddr(resultId, funcName) then self.emitFuncAddr(resultId, funcName: funcName)
			callIndirect(resultId, calleeReg, args) then self.emitCallIndirect(resultId, calleeReg: calleeReg, args: args)
			osRangePanic then self.emitRangePanic()
			// P1.5 mid-body-yield: the green-thread sleep substrate (`osReadClock`/`osSleepMs`) is x64-windows
			// only — its QueryPerformanceCounter clock and Windows `Sleep` have no wasm primitive, and a
			// `sleep` program is spec-gated to x64-windows, so neither op ever reaches the wasm emitter.
			osReadClock then panic("emitBodyOp: `osReadClock` is x64-windows only — the green-thread sleep substrate is x64-windows-gated at this rung")
			osSleepMs then panic("emitBodyOp: `osSleepMs` is x64-windows only — the green-thread sleep substrate is x64-windows-gated at this rung")
			// P1.5 subprocess: CreateProcessA and the wait/handle imports are x64-windows only, and an
			// `async runProcess` program is spec-gated to x64-windows, so none reaches the wasm emitter.
			osProcessSpawn to osWaitHandle then panic("emitBodyOp: the P1.5 subprocess ops are x64-windows only — the green-thread subprocess substrate is x64-windows-gated at this rung")
			// P1.5-B1a′ `osFreePages` (the relocating morestack's page release) is x64-windows only — it is emitted
			// ONLY inside the x64-windows-gated green-thread substrate, so it never reaches the wasm emitter; and
			// wasm linear memory cannot be shrunk anyway (`memory.grow` only grows).
			osFreePages then panic("emitBodyOp: `osFreePages` is x64-windows only (and wasm linear memory cannot shrink) — the green-thread substrate is x64-windows-gated at this rung")
		end 'body'
	end 'emitBodyOp'

	function emitConst(resultId ValueId, value ParsedInt, valueType StdType)
		if stdTypeIsFloat(valueType) 'float'
			self.emitFloatConst(value, valueType: valueType)
		end 'float' else 'int'
			self.emitIntConst(isWideInt(valueType, what: "const"), value: value)
		end 'int'
		self.body.localSet(resultId as Wasm32Index)
	end 'emitConst'

	// Materialize an f64 constant. `value` is the double's IEEE-754 bits reinterpreted as an
	// integer (the SAME ParsedInt the `.data`/`.rdata` serializer renders — see
	// GlobalDataTable.scalarImage), which `f64.const` takes as 8 raw little-endian bytes. NO
	// constant pool: unlike x64/arm64, which stash the bits in `.rdata` and load them, wasm has a
	// native f64 immediate.
	function emitFloatConst(value ParsedInt, valueType StdType)
		requireF64(valueType, what: "const")
		self.body.f64Const(value)
	end 'emitFloatConst'

	// Push an integer constant of the selected width. The i32 form takes the low 32 bits of the
	// value reinterpreted as signed, so a `u32`/negative literal encodes correctly.
	function emitIntConst(wide bool, value ParsedInt)
		if wide 'i64'
			self.body.i64Const(value)
		end 'i64' else 'i32'
			self.body.i32Const(narrowToImm32(value))
		end 'i32'
	end 'emitIntConst'

	// Push value `v` onto the stack at `targetVt`, coercing from its actual valtype when they differ.
	// A binary op's two operands must BOTH sit at the op's width, and the frontend can leave one a
	// different width — an int↔narrower change carries no Std conversion op, the same reason
	// `emitLocalCopy` coerces at a phi edge — so each operand is coerced as it is pushed. A no-op when
	// the widths already agree, so a same-width op stays byte-identical.
	function pushOperandAt(v ValueId, targetVt WasmValType)
		self.body.localGet(v as Wasm32Index)
		coerceOnStack(self.body, from: getValtype(self.valtypes, v: v), to: targetVt)
	end 'pushOperandAt'

	// Push both operands of a binary op (binOp/cmp/div/mod, integer AND float) at the op's chosen
	// width, in lhs-then-rhs order — the shape every wasm binary ALU/compare op wants on the stack.
	// The width choice is the caller's (i32/i64 by `isWideInt`, f64 for the float path, `lhs`'s width
	// for div/mod); this only guarantees BOTH operands are coerced to the SAME `opVt` the opcode pops,
	// so a new binary emitter cannot forget to coerce one side (the gap `pushOperandAt`'s header names).
	function pushBinaryOperands(lhs ValueId, rhs ValueId, opVt WasmValType)
		self.pushOperandAt(lhs, targetVt: opVt)
		self.pushOperandAt(rhs, targetVt: opVt)
	end 'pushBinaryOperands'

	function emitBinOp(resultId ValueId, lhs ValueId, rhs ValueId, opcode StdBinOpcode, operandType StdType)
		if stdTypeIsFloat(operandType) 'float'
			self.emitFloatBinOp(resultId, lhs: lhs, rhs: rhs, opcode: opcode, operandType: operandType)
			return
		end 'float'

		let wide = isWideInt(operandType, what: "binOp")
		let opVt = WasmValType.i64 if wide else WasmValType.i32
		self.pushBinaryOperands(lhs, rhs: rhs, opVt: opVt)
		self.emitBinOpcode(opcode, wide: wide)
		self.body.localSet(resultId as Wasm32Index)
	end 'emitBinOp'

	// A FLOAT binary op — add/sub/mul, and `div` (float division rides `binOp` because it is
	// IEEE-754 pure, never a trap, unlike the integer `StdOp.div`). Both operands sit at f64; the
	// bitwise/shift opcodes have no float form and are a lowering bug here (rejected at the Maxon
	// tier for a float operand). Mirrors arm64's `lowerFloatBinOp`.
	function emitFloatBinOp(resultId ValueId, lhs ValueId, rhs ValueId, opcode StdBinOpcode, operandType StdType)
		requireF64(operandType, what: "binOp")
		self.pushBinaryOperands(lhs, rhs: rhs, opVt: WasmValType.f64)
		self.emitFloatBinOpcode(opcode)
		self.body.localSet(resultId as Wasm32Index)
	end 'emitFloatBinOp'

	function emitFloatBinOpcode(opcode StdBinOpcode)
		match opcode 'op'
			add then self.body.f64Add()
			sub then self.body.f64Sub()
			mul then self.body.f64Mul()
			div then self.body.f64Div()
			bitAnd to shrLogical then panic("wasm: `binOp({opcode.rawValue})` has no float form — the bitwise/shift operators are integer-only and a float operand is rejected at the Maxon tier")
		end 'op'
	end 'emitFloatBinOpcode'

	function emitBinOpImm(resultId ValueId, lhs ValueId, imm Imm32, opcode StdBinOpcode)
		// `binOpImm` carries no operand type; its width is `lhs`'s (the immediate right operand
		// is folded in). The immediate is pushed as a same-width const so wasm's typed ALU op is
		// balanced (e.g. `i64.shl` pops two i64s).
		let wide = getValtype(self.valtypes, v: lhs) == WasmValType.i64
		self.body.localGet(lhs as Wasm32Index)
		self.emitIntConst(wide, value: imm)
		self.emitBinOpcode(opcode, wide: wide)
		self.body.localSet(resultId as Wasm32Index)
	end 'emitBinOpImm'

	// The integer ALU opcode of the selected width. `div` (StdBinOpcode) is FLOAT division and
	// out of the scalar slice; integer division is the separate `StdOp.div`, so a `binOp(div)`
	// here is a lowering bug.
	function emitBinOpcode(opcode StdBinOpcode, wide bool)
		if wide 'i64'
			match opcode 'w'
				add then self.body.i64Add()
				sub then self.body.i64Sub()
				mul then self.body.i64Mul()
				bitAnd then self.body.i64And()
				bitOr then self.body.i64Or()
				bitXor then self.body.i64Xor()
				shl then self.body.i64Shl()
				shr then self.body.i64ShrS()
				shrLogical then self.body.i64ShrU()
				div then panic("wasm: `binOp(div)` is float division (out of the scalar slice); integer division is `StdOp.div`")
			end 'w'
		end 'i64' else 'i32'
			match opcode 'n'
				add then self.body.i32Add()
				sub then self.body.i32Sub()
				mul then self.body.i32Mul()
				bitAnd then self.body.i32And()
				bitOr then self.body.i32Or()
				bitXor then self.body.i32Xor()
				shl then self.body.i32Shl()
				shr then self.body.i32ShrS()
				shrLogical then self.body.i32ShrU()
				div then panic("wasm: `binOp(div)` is float division (out of the scalar slice); integer division is `StdOp.div`")
			end 'n'
		end 'i32'
	end 'emitBinOpcode'

	function emitUnaryOp(resultId ValueId, operand ValueId, opcode StdUnaryOpcode, operandType StdType)
		match opcode 'op'
			neg then self.emitNegExpr(operand, wide: isWideInt(operandType, what: "neg"))
			bitNot then self.emitBitNotExpr(operand, wide: isWideInt(operandType, what: "bitNot"))
			logicalNot then self.emitLogicalNotExpr(operand)
			siToFp then self.emitSiToFp(operand, operandType: operandType)
			fpToSi then self.emitFpToSi(operand, operandType: operandType)
		end 'op'
		self.body.localSet(resultId as Wasm32Index)
	end 'emitUnaryOp'

	// int -> f64 (`promoteToFloat`). ⚠ `operandType` is the SOURCE, an INTEGER — the opcode names
	// the RESULT (see StdUnaryOpcode's header). `f64.convert_i64_s` reads a signed i64, so a
	// narrower int source (a promoted i32 ExitCode literal, say) is widened first — the same
	// width-gap `pushOperandAt` closes for a mixed-width binOp. The result is f64 (the valtype
	// table records `siToFp` -> f64).
	function emitSiToFp(operand ValueId, operandType StdType)
		if stdTypeIsFloat(operandType) 'notInt'
			panic("wasm: `siToFp` with a FLOAT operand type — a conversion's operandType is its SOURCE, which for siToFp is an integer (the Maxon tier's assertConversionCrossesDomain enforces this)")
		end 'notInt'
		self.pushOperandAt(operand, targetVt: WasmValType.i64)
		self.body.f64ConvertI64S()
	end 'emitSiToFp'

	// f64 -> int, TRUNCATING toward zero — the `trunc()` bridge nearly every float test ends on.
	// `operandType` is the SOURCE, an f64. `i64.trunc_f64_s` (the `_s`/trunc form, NOT a rounding
	// one — `trunc(3.99)` is 3, not 4) yields a signed i64; the result is recorded i64, and a
	// narrower consumer (`return trunc(x)` into an i32 ExitCode) narrows it through the usual `ret`
	// coercion.
	function emitFpToSi(operand ValueId, operandType StdType)
		requireF64(operandType, what: "fpToSi source")
		self.pushOperandAt(operand, targetVt: WasmValType.f64)
		self.body.i64TruncF64S()
	end 'emitFpToSi'

	// Integer negate as `0 - operand` (wasm has no unary negate). The operand is coerced to the op's
	// width (from `operandType`, which the result also carries): the frontend can leave it a different
	// width — e.g. `-r` on an ExitCode (i32) whose neg is typed int (i64) — same gap as a mixed-width
	// binOp, and it faults the same way (`i64.sub` over an i32) without the coercion.
	function emitNegExpr(operand ValueId, wide bool)
		let opVt = WasmValType.i64 if wide else WasmValType.i32
		self.emitIntConst(wide, value: 0)
		self.pushOperandAt(operand, targetVt: opVt)
		if wide 'i64'
			self.body.i64Sub()
		end 'i64' else 'i32'
			self.body.i32Sub()
		end 'i32'
	end 'emitNegExpr'

	// Bitwise complement as `operand xor -1` (all-ones flips every bit). The operand is coerced to the
	// op's width for the same reason as `emitNegExpr`.
	function emitBitNotExpr(operand ValueId, wide bool)
		let opVt = WasmValType.i64 if wide else WasmValType.i32
		self.pushOperandAt(operand, targetVt: opVt)
		self.emitIntConst(wide, value: -1)
		if wide 'i64'
			self.body.i64Xor()
		end 'i64' else 'i32'
			self.body.i32Xor()
		end 'i32'
	end 'emitBitNotExpr'

	// Logical NOT of a 0/1 bool as `operand xor 1` (flip bit 0), matching the native backends'
	// `eor #1` / `xor reg, 1` convention. ⚠ THE OPERAND IS COERCED TO i32, not pushed bare: a bool
	// is usually an i1 → i32 local, but a bool-RETURNING function lowers to an i64 return in this
	// tier (`__str_eq` returns i64), so `not (a == b)` on Strings hands this an i64 operand — and a
	// bare `i32.xor` over it faults the typed stack (i64 vs i32). `pushOperandAt` wraps the i64 to
	// i32 first (a no-op for an already-i32 bool, so the scalar case stays byte-identical) — the same
	// width gap `emitNegExpr`/`emitBitNotExpr` already close for their operands.
	function emitLogicalNotExpr(operand ValueId)
		self.pushOperandAt(operand, targetVt: WasmValType.i32)
		self.body.i32Const(1 as Imm32)
		self.body.i32Xor()
	end 'emitLogicalNotExpr'

	function emitCmp(resultId ValueId, lhs ValueId, rhs ValueId, pred StdCmpPred, operandType StdType)
		if stdTypeIsFloat(operandType) 'float'
			self.emitFloatCmp(resultId, lhs: lhs, rhs: rhs, pred: pred, operandType: operandType)
			return
		end 'float'

		let wide = isWideInt(operandType, what: "cmp")
		let opVt = WasmValType.i64 if wide else WasmValType.i32
		self.pushBinaryOperands(lhs, rhs: rhs, opVt: opVt)
		self.emitCmpPred(pred, wide: wide)
		self.body.localSet(resultId as Wasm32Index)
	end 'emitCmp'

	// A FLOAT compare pops two f64s and pushes an i32 (0/1) — the same i1->i32 bool an integer
	// compare yields, so its result local is i32 (the valtype table records every `cmp` as i32).
	// ⭐ NO OPERAND SWAP, NO PARITY TEST: wasm's f64 compares carry IEEE-754 unordered semantics
	// natively — each relational predicate is FALSE when either operand is NaN and `f64.ne` is TRUE
	// — which is exactly the NaN-safe answer x64's `ucomisd`/`jp` dance and arm64's float condition
	// family build by hand. One opcode delivers it. (There is no float `cmpImm`: `binOpImm`/`cmpImm`
	// are integer-only — no SSE/wasm compare takes an encoded immediate — so `foldConstOperands`
	// never folds a float rhs, and this emitter is the only float-compare path.)
	function emitFloatCmp(resultId ValueId, lhs ValueId, rhs ValueId, pred StdCmpPred, operandType StdType)
		requireF64(operandType, what: "cmp")
		self.pushBinaryOperands(lhs, rhs: rhs, opVt: WasmValType.f64)
		self.emitFloatCmpPred(pred)
		self.body.localSet(resultId as Wasm32Index)
	end 'emitFloatCmp'

	function emitFloatCmpPred(pred StdCmpPred)
		match pred 'p'
			eq then self.body.f64Eq()
			ne then self.body.f64Ne()
			lt then self.body.f64Lt()
			gt then self.body.f64Gt()
			le then self.body.f64Le()
			ge then self.body.f64Ge()
		end 'p'
	end 'emitFloatCmpPred'

	function emitCmpImm(resultId ValueId, lhs ValueId, imm Imm32, pred StdCmpPred)
		// Like `binOpImm`, `cmpImm` carries no operand type — the compare width is `lhs`'s.
		let wide = getValtype(self.valtypes, v: lhs) == WasmValType.i64
		self.body.localGet(lhs as Wasm32Index)
		self.emitIntConst(wide, value: imm)
		self.emitCmpPred(pred, wide: wide)
		self.body.localSet(resultId as Wasm32Index)
	end 'emitCmpImm'

	// A wasm compare pops two operands and pushes an i32 (0/1) — exactly the i1→i32 bool the Std
	// `cmp`/`cmpImm` result is typed as, so no extension is needed. Std compares are SIGNED (the
	// native backends treat every Std integer as signed), so the signed families are used.
	function emitCmpPred(pred StdCmpPred, wide bool)
		if wide 'i64'
			match pred 'w'
				eq then self.body.i64Eq()
				ne then self.body.i64Ne()
				lt then self.body.i64LtS()
				gt then self.body.i64GtS()
				le then self.body.i64LeS()
				ge then self.body.i64GeS()
			end 'w'
		end 'i64' else 'i32'
			match pred 'n'
				eq then self.body.i32Eq()
				ne then self.body.i32Ne()
				lt then self.body.i32LtS()
				gt then self.body.i32GtS()
				le then self.body.i32LeS()
				ge then self.body.i32GeS()
			end 'n'
		end 'i32'
	end 'emitCmpPred'

	// Signed integer division / remainder. Width from `lhs` (div/mod carry no operand type).
	// wasm traps natively on a zero divisor and on INT_MIN/-1, matching the intended semantics;
	// the Tier-1 division specs all use non-zero divisors (CONTRACT §4.7).
	function emitDivMod(resultId ValueId, lhs ValueId, rhs ValueId, isRemainder bool)
		// div/mod carry no operand type — the width, and the result's, are `lhs`'s (the dependent-width
		// model, see buildValtypeTable). Both operands are pushed at that width, coercing `rhs` when the
		// frontend left it a different width (same gap as a mixed-width `binOp`).
		let opVt = getValtype(self.valtypes, v: lhs)
		let wide = opVt == WasmValType.i64
		self.pushBinaryOperands(lhs, rhs: rhs, opVt: opVt)
		if isRemainder 'rem'
			if wide 'remWide'
				self.body.i64RemS()
			end 'remWide' else 'remNarrow'
				self.body.i32RemS()
			end 'remNarrow'
		end 'rem' else 'div'
			if wide 'divWide'
				self.body.i64DivS()
			end 'divWide' else 'divNarrow'
				self.body.i32DivS()
			end 'divNarrow'
		end 'div'
		self.body.localSet(resultId as Wasm32Index)
	end 'emitDivMod'

	// A parameter already occupies its own local (id == index in the scalar ABI), so the copy is
	// emitted only for the general case where the two differ.
	function emitParam(resultId ValueId, index ParamCount)
		if resultId != index 'needsCopy'
			self.body.localGet(index as Wasm32Index)
			self.body.localSet(resultId as Wasm32Index)
		end 'needsCopy'
	end 'emitParam'

	// Push each argument (in parameter order — `lowerCall` already reordered any labelled args), each
	// coerced to the callee's declared parameter width, then emit the `call`. The argument marshalling
	// and the call itself are IDENTICAL for a plain `call` and a throwing `tryCall` — only the RESULT
	// capture differs (a plain call reads one value or none; a `tryCall` reads the value AND the error
	// flag off the callee's multi-value return), so both share this.
	function emitCallArgsAndCall(callee ByteArray, args ValueIdArray)
		let paramTypes = try self.calleeParamTypes.get(callee) otherwise panic("emitCall: no param types for callee '{String.from(callee)}'")
		for argIdx in 0 upto args.count() 'eachArg'
			let arg = try args.get(argIdx) otherwise panic("emitCall: args.get OOB at {argIdx}")
			self.body.localGet(arg as Wasm32Index)
			let paramVt = try paramTypes.get(argIdx) otherwise panic("emitCall: callee '{String.from(callee)}' declares fewer params than the {argIdx + 1} args passed")
			coerceOnStack(self.body, from: getValtype(self.valtypes, v: arg), to: paramVt)
		end 'eachArg'

		let funcIdx = try self.calleeFuncIdx.get(callee) otherwise panic("emitCall: no wasm function index for callee '{String.from(callee)}'")
		self.body.call(funcIdx)
	end 'emitCallArgsAndCall'

	// A plain (non-throwing) call: marshal the args, call, and store the single result only when the
	// callee returns a value (a void callee pushes nothing — a `local.set` would underflow).
	function emitCall(resultId ValueId, callee ByteArray, args ValueIdArray)
		self.emitCallArgsAndCall(callee, args: args)

		let rt = try self.calleeReturnType.get(callee) otherwise panic("emitCall: no return type for callee '{String.from(callee)}'")
		if not stdReturnTypeIsVoid(rt) 'hasResult'
			self.body.localSet(resultId as Wasm32Index)
		end 'hasResult'
	end 'emitCall'

	// A throwing call `resultId = try callee(args…)`: marshal + call exactly as `emitCall`, then capture
	// the callee's MULTI-VALUE return. A throwing callee's wasm signature is `(params) -> (resultVt, i64)`
	// (value-returning) or `(params) -> (i64)` (void-returning), so its results sit on the stack with the
	// i64 error FLAG on TOP. `local.set` pops top-first, so the flag is captured FIRST, then the primary
	// value — for a void-returning throwing callee the call pushes only the flag, so there is no value to
	// capture (`calleeReturnType` is the callee's OWN return type, void-vs-value). The two captures never
	// need the native backends' parallel-copy resolver: a wasm stack pop targets a distinct local, so
	// there is no register-cycle to break. A `tryCall` only ever targets a THROWING callee (the parser
	// rejects a non-throwing `try` via E3055), so the flag is always present.
	function emitTryCall(resultId ValueId, errorFlagId ValueId, callee ByteArray, args ValueIdArray)
		self.emitCallArgsAndCall(callee, args: args)

		self.body.localSet(errorFlagId as Wasm32Index)

		let rt = try self.calleeReturnType.get(callee) otherwise panic("emitTryCall: no return type for callee '{String.from(callee)}'")
		if not stdReturnTypeIsVoid(rt) 'hasResult'
			self.body.localSet(resultId as Wasm32Index)
		end 'hasResult'
	end 'emitTryCall'

	// A function VALUE (`funcAddr`, P1.5-A1): its wasm value is the callee's TABLE INDEX. The module builds
	// one funcref table with table[i] == function i, so a function's table index equals its wasm funcIdx —
	// exactly what `calleeFuncIdx` already holds. Materialized as an i64: a function value's Std type is a
	// machine word, so it flows through params/fields/returns/block-args as i64 like every other value, and
	// is narrowed to the i32 table-index operand only at the `call_indirect` (`emitCallIndirect`). This is
	// the `.text`-address sibling of `emitGlobalAddr`/`emitRdataAddr`, but a value that FLOWS rather than an
	// address consumed in place — which is why it is i64 here, not the i32 those two produce.
	function emitFuncAddr(resultId ValueId, funcName ByteArray)
		let funcIdx = try self.calleeFuncIdx.get(funcName) otherwise panic("emitFuncAddr: no wasm function index for function value '{String.from(funcName)}'")
		self.body.i64Const(funcIdx as ParsedInt)
		self.body.localSet(resultId as Wasm32Index)
	end 'emitFuncAddr'

	// A call THROUGH a function value (`callIndirect`, P1.5-A1): `resultId = calleeReg(args…)`. Marshal each
	// argument coerced to i64 (the function-value parameter width), push the table index (the function value,
	// wrapped from its i64 flow-width down to the i32 `call_indirect` operand), then `call_indirect (type
	// $sig) (table 0)`. `$sig` is the pre-interned `(i64^n) -> i64` functype for this arg count, which wasm
	// checks at runtime against the funcref's OWN type — and since every target function's parameters and
	// return are the same integer/named types, the two match. The result is the callee's i64 return.
	//
	// ⭐ WHY the signature is derivable WITHOUT the function type on the op. The Std `callIndirect` carries no
	// signature (a cross-tier field would touch x64/arm64 too), and none is needed: a function value's
	// params and return are integer/named types, all of which the Maxon→Std collapse maps to i64
	// (valueTagToStdType), and void / non-integer function values are out of the A1 slice — so every A1
	// function value is `(i64^n) -> i64` for n = args.count(), a wasm-tier-local fact. This is the SAME
	// slice invariant x64's `lowerCallIndirect` relies on ("A1 function values pass INTEGER arguments and
	// return an INTEGER" → GPR arguments, R8 result).
	function emitCallIndirect(resultId ValueId, calleeReg ValueId, args ValueIdArray)
		for argIdx in 0 upto args.count() 'eachArg'
			let arg = try args.get(argIdx) otherwise panic("emitCallIndirect: args.get OOB at {argIdx}")
			self.pushOperandAt(arg, targetVt: WasmValType.i64)
		end 'eachArg'

		self.pushOperandAt(calleeReg, targetVt: WasmValType.i32)

		let typeIdx = try self.indirectCallTypeIdx.get(args.count()) otherwise panic("emitCallIndirect: no interned functype for a {args.count()}-argument indirect call — buildIndirectCallTypeIdxMap missed it")
		self.body.callIndirect(typeIdx)

		self.body.localSet(resultId as Wasm32Index)
	end 'emitCallIndirect'

	// Value return: push the return value and `return`. A `void` return type here means a value
	// `ret` in a void function — the parser rejects that source, so it is a lowering bug.
	function emitRet(retValId ValueId)
		if stdReturnTypeIsVoid(self.func.returnType) 'void'
			panic("emitRet: a value `ret` in a void-returning function — a void return lowers to `retVoid`")
		end 'void'
		self.body.localGet(retValId as Wasm32Index)
		let resultTypes = funcResultValTypes(self.func.returnType)
		let resultVt = try resultTypes.get(0) otherwise panic("emitRet: value-returning function has no result valtype")
		coerceOnStack(self.body, from: getValtype(self.valtypes, v: retValId), to: resultVt)
		self.body.returnOp()
	end 'emitRet'

	// Void return: nothing on the stack, bare `return`. A value return type here would leave the
	// caller reading nothing — the parser rejects that source, so it is a lowering bug.
	function emitRetVoid()
		if not stdReturnTypeIsVoid(self.func.returnType) 'valueExpected'
			panic("emitRetVoid: a `retVoid` in a value-returning function — the caller would read nothing")
		end 'valueExpected'
		self.body.returnOp()
	end 'emitRetVoid'

	// The dual-register `errorReturn(retVal, flag)` mapped onto wasm multi-value — the ONLY exit a
	// THROWING function takes. The frontend routes every return of a throwing function through this op
	// (a normal return carries a ZERO flag, a `throw` a non-zero one — LowerMaxonToStd.emitRetOrError-
	// Return / lowerThrowError), so a throwing function never emits a plain `ret`/`retVoid`, and this
	// is the wasm twin of the native `lowerErrorReturn` (which writes R8 + R10). The signature declares
	// `(resultVt, i64)` for a value-returning function and `(i64)` for a void one (`funcSignature-
	// ResultValTypes`), so the stack must hold the value THEN the flag (value-returning) or just the
	// flag (void). The primary value is coerced to the result valtype exactly as `emitRet` does — the
	// same value-meets-declared-type width gap. For a void-returning throwing function the op still
	// carries a placeholder `retVal`, but the signature has no value result, so it is DROPPED (not
	// pushed): only the flag is returned.
	function emitErrorReturn(retValId ValueId, errorFlagId ValueId)
		if not stdReturnTypeIsVoid(self.func.returnType) 'value'
			self.body.localGet(retValId as Wasm32Index)
			let resultTypes = funcResultValTypes(self.func.returnType)
			let resultVt = try resultTypes.get(0) otherwise panic("emitErrorReturn: value-returning function has no result valtype")
			coerceOnStack(self.body, from: getValtype(self.valtypes, v: retValId), to: resultVt)
		end 'value'

		self.body.localGet(errorFlagId as Wasm32Index)
		// The flag is always i64 (a zero `const`, a scalar `ordinal + bias`, or a propagated `tryCall`
		// flag — all i64), so this coercion is a no-op; it is kept for the same value-meets-declared-type
		// robustness every other push in this file carries, and matches the i64 second result the
		// signature declares.
		coerceOnStack(self.body, from: getValtype(self.valtypes, v: errorFlagId), to: WasmValType.i64)
		self.body.returnOp()
	end 'emitErrorReturn'

	// `osExit(code)` — the process-exit primitive a `panic(...)` ends on (LowerMaxonToStd.lowerPanic-
	// Abort). Hand the code to the `exit-with-code` import (func idx 0), wrapped to the i32 the import
	// declares — `code` is an i64 in the Std IR, so `pushOperandAt` emits the `i32.wrap_i64`. wasmtime
	// masks the status to the low 8 bits, matching the native `ExitProcess`/`_exit`. `exit-with-code`
	// never returns, so `unreachable` follows: the process is gone and the dead return the parser emits
	// after this op is unreachable code (the trailing `unreachable` also makes the stack polymorphic, so
	// that dead terminator validates whatever result arity the function declares). Defines no value.
	function emitOsExit(codeId ValueId)
		self.pushOperandAt(codeId, targetVt: WasmValType.i32)
		self.body.call(ExitImportFuncIdx)
		self.body.unreachable()
	end 'emitOsExit'

	// `osRangePanic` (a P1.9 range-check violation) on wasm — a BARE `exit-with-code 1`, no message or
	// backtrace (wasm has no panic runtime; the two runtime-panic spec cases are restricted to
	// x64-windows). Every case that RUNS on wasm keeps its guard's value in range, so this is dead code —
	// it exists only so the guard COMPILES. Same shape as `emitOsExit` with a constant status.
	function emitRangePanic()
		self.body.i32Const(RangePanicExitCode)
		self.body.call(ExitImportFuncIdx)
		self.body.unreachable()
	end 'emitRangePanic'

	// ----------------------------------------------------------------------
	// Memory band: top-level `var` globals (globalAddr / loadIndirect / storeIndirect)
	// ----------------------------------------------------------------------

	// `globalAddr` → `i32.const <base + the global's `.data` offset>`. On the native backends this
	// is a `lea` of a relocated address; on wasm a global's home is a fixed linear-memory byte, so
	// its address is a compile-time i32 CONSTANT — the base plus the offset `GlobalDataTable`
	// assigned the label at layout. The result local is i32 (recorded by `buildValtypeTable`), the
	// width `loadIndirect`/`storeIndirect` consume as the base address.
	function emitGlobalAddr(resultId ValueId, label ByteArray)
		let slotOffset = self.globalData.dataSectionOffsetOf(String.from(label))
		self.body.i32Const(wasmLinearAddress(self.dataBase, byteOffset: slotOffset))
		self.body.localSet(resultId as Wasm32Index)
	end 'emitGlobalAddr'

	// `loadIndirect` → push the base address as an i32, then `<width>.load offset=<offset>`. The
	// static `offset` (0 for a plain global, non-zero for a struct/heap-record field riding this op)
	// folds into the memarg. The width is `valueType`'s: a `u8`/`i1` BYTE (a heap String's bytes,
	// zero-extended) or an `i64`/`f64` WORD — the set `wasmMemAccessType` admits.
	//
	// ⚠ THE BASE IS COERCED TO i32 (`pushOperandAt`), NOT pushed bare. A `globalAddr`/`rdataAddr`
	// result is already i32, so the coercion is a no-op and this stays byte-identical — but a heap or
	// String pointer (an i64 in a register on the native backends) used as a load base needs an
	// `i32.wrap_i64`, and wasm's typed stack rejects the bare i64 under a `*.load`. Real addresses are
	// < 4 GiB, so the wrap is lossless.
	function emitLoadIndirect(resultId ValueId, addrId ValueId, offset ByteOffset, valueType StdType)
		self.pushOperandAt(addrId, targetVt: WasmValType.i32)
		let memOffset = wasmMemOffset(offset)
		// The access VALTYPE also names the width: i32 return ⟺ a BYTE access (the only i32-backed
		// types accepted are byte-width — see `wasmMemAccessType`), which zero-extends via
		// `i32.load8_u`; a word loads as i64/f64.
		match wasmMemAccessType(valueType, what: "loadIndirect") 'w'
			i32 then self.body.i32Load8U(memOffset)
			i64 then self.body.i64Load(memOffset)
			f64 then self.body.f64Load(memOffset)
			f32 then panic("emitLoadIndirect: wasmMemAccessType never returns f32")
		end 'w'
		self.body.localSet(resultId as Wasm32Index)
	end 'emitLoadIndirect'

	// `storeIndirect` → push the base address as an i32, then the value (coerced to the access
	// width), then `<width>.store offset=<offset>`. Address BELOW value is the order the store opcode
	// pops. `pushOperandAt` coerces BOTH: the base to i32 (a no-op for a `globalAddr`/`rdataAddr`
	// result, an `i32.wrap_i64` for an i64 heap/String pointer — the same reason `emitLoadIndirect`
	// coerces it) and the value to the store width (a value-meets-declared-type boundary, like
	// `ret`/call args). A byte store is the STRING-BUILDER path: an i64 char stored as one byte
	// (StringRuntime:921) is wrapped to i32 here, then written by `i32.store8`. Defines nothing, so
	// no `local.set`.
	function emitStoreIndirect(addrId ValueId, offset ByteOffset, valueId ValueId, valueType StdType)
		self.pushOperandAt(addrId, targetVt: WasmValType.i32)
		let storeVt = wasmMemAccessType(valueType, what: "storeIndirect")
		self.pushOperandAt(valueId, targetVt: storeVt)
		let memOffset = wasmMemOffset(offset)
		match storeVt 'w'
			i32 then self.body.i32Store8(memOffset)
			i64 then self.body.i64Store(memOffset)
			f64 then self.body.f64Store(memOffset)
			f32 then panic("emitStoreIndirect: wasmMemAccessType never returns f32")
		end 'w'
	end 'emitStoreIndirect'

	// ----------------------------------------------------------------------
	// rdata band + system band: String-literal records and the stdout write
	// ----------------------------------------------------------------------

	// `rdataAddr` → `i32.const <rdataBase + the record's `.rdata` offset>`. The `.rdata` twin of
	// `emitGlobalAddr`: a String literal's 48-byte record lives at a fixed linear-memory byte, so its
	// address is a compile-time i32 CONSTANT. The result local is i32 (recorded by
	// `buildValtypeTable`); it reaches `__print_string`'s i64 `strPtr` param through the
	// call-argument coercion (`i64.extend_i32`), and is wrapped back to i32 at the load base.
	function emitRdataAddr(resultId ValueId, label ByteArray)
		let recordOffset = self.globalData.rdataOffsetOf(String.from(label))
		self.body.i32Const(wasmLinearAddress(self.rdataBase, byteOffset: recordOffset))
		self.body.localSet(resultId as Wasm32Index)
	end 'emitRdataAddr'

	// `osAllocPages(size) -> base` → `memory.grow` (v1 `emitOsAllocPages`, MirToWasm.maxon:3227,
	// ported verbatim). The slab allocator asks for `size` bytes; wasm grows linear memory a PAGE at
	// a time, so the size is rounded UP to whole 64 KiB pages, memory is grown, and the previous page
	// count `memory.grow` returns is shifted back to the BYTE base of the freshly-grown region — the
	// address `resultId` carries. `memory.grow` signals OOM by returning -1 (i32); the result is
	// sign-extended to i64 (so -1 stays -1 in the i64 world every ValueId lives in) and an OOM TRAPS
	// via `unreachable`, matching the native allocators' abort. `resultId` doubles as the scratch
	// across the OOM test, exactly as in v1.
	function emitOsAllocPages(resultId ValueId, sizeId ValueId)
		// pages = (size + 65535) >> 16  — ceil(size / 64 KiB)
		self.pushOperandAt(sizeId, targetVt: WasmValType.i64)
		self.body.i64Const(WasmPageSizeMask as ParsedInt)
		self.body.i64Add()
		self.body.i64Const(WasmPageSizeLog2 as ParsedInt)
		self.body.i64ShrU()
		self.body.i32WrapI64()
		// grow linear memory 0 by that page count → previous page count (or -1 on OOM)
		self.body.memoryGrow()
		// widen to i64 so the OOM test stays in the i64 world; -1 sign-extends to -1
		self.body.i64ExtendI32S()
		self.body.localSet(resultId as Wasm32Index)
		// if (base == -1) unreachable  — OOM traps, surfacing as a wasmtime runtime trap
		self.body.localGet(resultId as Wasm32Index)
		self.body.i64Const(WasmMemoryGrowOom)
		self.body.i64Eq()
		self.body.beginIf()
		self.body.unreachable()
		self.body.endOp()
		// base = prevPages << 16  — the byte base of the freshly-grown region
		self.body.localGet(resultId as Wasm32Index)
		self.body.i64Const(WasmPageSizeLog2 as ParsedInt)
		self.body.i64Shl()
		self.body.localSet(resultId as Wasm32Index)
	end 'emitOsAllocPages'

	// `osWriteStdout(buf, len)` → the WASI-Preview2 stdout write, fire-and-forget (the result is
	// ignored). Stack-balanced: `get-stdout` pushes the i32 stream handle; the buffer address and the
	// byte length are each wrapped to i32 (a String's `buffer@0`/`length@8` are i64 in the Std IR — a
	// 64-bit pointer/count in a register on the native backends — but a wasm address/length is i32);
	// the canonical-ABI return area is a constant i32. `blocking-write-and-flush` writes its
	// `result<_, stream-error>` into that area and returns nothing, so the stack is empty after —
	// `osWriteStdout` defines no value. The stream handle leaks, which is acceptable: stdout is
	// process-lived and the host reclaims it on exit (matches v1's `emitOsWrite`).
	function emitOsWriteStdout(bufId ValueId, lenId ValueId)
		self.body.call(GetStdoutImportFuncIdx)
		self.pushOperandAt(bufId, targetVt: WasmValType.i32)
		self.pushOperandAt(lenId, targetVt: WasmValType.i32)
		self.body.i32Const(WasmRetAreaBase)
		self.body.call(BlockingWriteFlushImportFuncIdx)
	end 'emitOsWriteStdout'

	// ----------------------------------------------------------------------
	// Dispatcher terminators: branch / cond-branch (with phi copies)
	// ----------------------------------------------------------------------

	function emitDispatchBranch(targetBlockId BlockId, currentBlock IrBlock, loopDepth Wasm32Index)
		self.emitEdgePhiCopies(currentBlock, targetBlockId: targetBlockId)
		self.emitSetDispatch(self.dispatchIndexOf(targetBlockId))
		self.body.br(loopDepth)
	end 'emitDispatchBranch'

	// Two-way branch: test the condition, and inside each arm emit ONLY that edge's phi copies
	// (they are valid only on the path actually taken — emitting both unconditionally would
	// clobber the not-taken target's phi locals, v1's `String.trim` corruption), set the dispatch
	// index, then `br` back to the loop after the `if`/`end`.
	function emitDispatchCondBranch(condId ValueId, thenBlockId BlockId, elseBlockId BlockId, currentBlock IrBlock, loopDepth Wasm32Index)
		self.body.localGet(condId as Wasm32Index)
		// `if` consumes an i32; a bool is already i32, but a condition widened to i64 must be
		// narrowed first.
		if getValtype(self.valtypes, v: condId) == WasmValType.i64 'wideCond'
			self.body.i32WrapI64()
		end 'wideCond'
		self.body.beginIf()

		self.emitEdgePhiCopies(currentBlock, targetBlockId: thenBlockId)
		self.emitSetDispatch(self.dispatchIndexOf(thenBlockId))

		self.body.elseClause()

		self.emitEdgePhiCopies(currentBlock, targetBlockId: elseBlockId)
		self.emitSetDispatch(self.dispatchIndexOf(elseBlockId))

		self.body.endOp()
		self.body.br(loopDepth)
	end 'emitDispatchCondBranch'

	function emitSetDispatch(dispatchIndex Wasm32Index)
		self.body.i32Const(dispatchIndex as Imm32)
		self.body.localSet(self.dispatchLocal)
	end 'emitSetDispatch'

	function dispatchIndexOf(blockId BlockId) returns Wasm32Index
		return try self.blockDispatchById.get(blockId) otherwise panic("dispatchIndexOf: branch targets block id {blockId} not in func.blockRefs")
	end 'dispatchIndexOf'

	// ----------------------------------------------------------------------
	// Phi (block-arg) parallel copies on a branch edge
	// ----------------------------------------------------------------------

	// Copy the values `currentBlock` passes on its edge to `targetBlockId` into that block's
	// block-arg locals, as a SEQUENTIALIZED parallel copy (§4.1). The incoming values live on
	// the predecessor's `branchEdges` entry for the target; the destinations are the target's
	// `blockArgs`. A target with block-args must have a matching edge from every predecessor
	// (IrBlock's phi-model contract), so a missing edge is only valid when the target has none.
	function emitEdgePhiCopies(currentBlock IrBlock, targetBlockId BlockId)
		let targetBlock = self.blockById(targetBlockId)

		// A condBranch's then/else targets are distinct and a branch has one target, so a target
		// appears at most once among the predecessor's phi edges — the first match is the edge.
		for edge in currentBlock.branchEdges 'eachEdge'
			if edge.targetBlockId == targetBlockId 'thisEdge'
				self.emitPhiCopyForEdge(edge, currentBlock: currentBlock, targetBlock: targetBlock)
				return
			end 'thisEdge'
		end 'eachEdge'

		// No phi edge to this target: valid only when the target carries no block-args (a block
		// with block-args records an edge from every predecessor — IrBlock's phi-model contract).
		if targetBlock.blockArgs.count() > 0 'missingArgs'
			panic("emitEdgePhiCopies: block '{String.from(currentBlock.label)}' branches to '{String.from(targetBlock.label)}' which has {targetBlock.blockArgs.count()} block-args, but records no branch edge carrying them")
		end 'missingArgs'
	end 'emitEdgePhiCopies'

	function emitPhiCopyForEdge(edge BranchEdge, currentBlock IrBlock, targetBlock IrBlock)
		if edge.argIds.count() != targetBlock.blockArgs.count() 'arity'
			panic("emitPhiCopyForEdge: edge '{String.from(currentBlock.label)}' → '{String.from(targetBlock.label)}' carries {edge.argIds.count()} args but the block has {targetBlock.blockArgs.count()} block-args")
		end 'arity'

		var dsts = ValueIdArray.create()
		var srcs = ValueIdArray.create()
		for k in 0 upto targetBlock.blockArgs.count() 'eachPhi'
			let dst = (try targetBlock.blockArgs.get(k) otherwise panic("emitPhiCopyForEdge: blockArgs.get OOB at {k}")).valueId
			let src = try edge.argIds.get(k) otherwise panic("emitPhiCopyForEdge: argIds.get OOB at {k}")
			if dst != src 'realMove'
				dsts.push(dst)
				srcs.push(src)
			end 'realMove'
		end 'eachPhi'

		self.sequenceParallelCopy(dsts, srcs: srcs)
	end 'emitPhiCopyForEdge'

	function blockById(blockId BlockId) returns IrBlock
		let idx = self.dispatchIndexOf(blockId)
		let blockRef = try self.func.blockRefs.get(idx) otherwise panic("blockById: blockRefs.get OOB at {idx}")
		return try self.module.blocks.get(blockRef) otherwise panic("blockById: blockRef {blockRef} not in module.blocks")
	end 'blockById'

	// Sequence a parallel copy (`dsts[k]` ← `srcs[k]`, dsts distinct) into ordered local copies.
	// Repeatedly emit a leaf (a dst that is no other move's source); when only cycles remain,
	// break one by exchanging its two locals through a valtype-matched scratch local (wasm has
	// no `xchg`) and rewrite the remaining sources through the exchange. Consumes `dsts`/`srcs`
	// as worklists. The standard parallel-move algorithm, with a scratch-staged swap in place of
	// the register backends' `xchg`.
	function sequenceParallelCopy(dsts ValueIdArray, srcs ValueIdArray)
		while dsts.count() > 0 'seq'
			removeSatisfiedMoves(dsts, srcs: srcs)
			if dsts.count() == 0 'done'
				break
			end 'done'

			let leaf = findLeafMove(dsts, srcs: srcs)
			if leaf < dsts.count() 'foundLeaf'
				let d = try dsts.get(leaf) otherwise panic("sequenceParallelCopy: dsts.get OOB at leaf {leaf}")
				let s = try srcs.get(leaf) otherwise panic("sequenceParallelCopy: srcs.get OOB at leaf {leaf}")
				self.emitLocalCopy(d as Wasm32Index, srcLocal: s, fromVt: getValtype(self.valtypes, v: s), toVt: getValtype(self.valtypes, v: d))
				removeMoveAt(dsts, srcs: srcs, idx: leaf)
			end 'foundLeaf' else 'cycle'
				let a = try dsts.get(0) otherwise panic("sequenceParallelCopy: dsts.get(0) OOB")
				let b = try srcs.get(0) otherwise panic("sequenceParallelCopy: srcs.get(0) OOB")
				let aVt = getValtype(self.valtypes, v: a)
				let bVt = getValtype(self.valtypes, v: b)
				let scratch = self.scratchFor(aVt)
				// Exchange a and b via scratch, satisfying (a ← b): scratch←a; a←b; b←scratch. Each leg
				// coerces to the DESTINATION local's width: a and b are block-args whose declared
				// valtypes can differ (see emitLocalCopy), so a width-mixing swap round-trips through the
				// scratch (typed as a's width) with the same coercions a sequential assignment pair would.
				self.emitLocalCopy(scratch, srcLocal: a as Wasm32Index, fromVt: aVt, toVt: aVt)
				self.emitLocalCopy(a as Wasm32Index, srcLocal: b, fromVt: bVt, toVt: aVt)
				self.emitLocalCopy(b as Wasm32Index, srcLocal: scratch, fromVt: aVt, toVt: bVt)
				removeMoveAt(dsts, srcs: srcs, idx: 0)
				rewriteSourcesThroughSwap(srcs, a: a, b: b)
			end 'cycle'
		end 'seq'
	end 'sequenceParallelCopy'

	// Copy one local to another, coercing the source's valtype to the destination's when they
	// differ. The native backends never need this — every value sits in a 64-bit register — but a
	// phi edge is a value-meets-declared-type boundary exactly like a `ret` or a call argument
	// (both of which already `coerceOnStack`): the frontend leaves an int↔narrower width change
	// IMPLICIT (int→int carries no Std conversion op), so a loop-carried var whose declared valtype
	// — its block-arg slot — is narrower/wider than the value an edge assigns it arrives here as an
	// i32 into an i64 slot (or the reverse), which wasm's typed `local.set` rejects. `coerceOnStack`
	// is a no-op when the widths already agree, so a same-width copy stays byte-identical.
	function emitLocalCopy(dstLocal Wasm32Index, srcLocal Wasm32Index, fromVt WasmValType, toVt WasmValType)
		self.body.localGet(srcLocal)
		coerceOnStack(self.body, from: fromVt, to: toVt)
		self.body.localSet(dstLocal)
	end 'emitLocalCopy'

	function scratchFor(vt WasmValType) returns Wasm32Index
		return try self.scratchLocalByValType.get(vt) otherwise panic("scratchFor: no cycle-break scratch local reserved for valtype {vt.name} — collectPhiValTypes missed a block-arg type")
	end 'scratchFor'
end 'WasmFuncEmitter'

// ==========================================================================
// Free helpers: constant narrowing, dispatcher decision, parallel-copy worklist
// ==========================================================================

// The low 32 bits of `value`, reinterpreted as a signed i32 — what a wasm `i32.const` (an
// SLEB128 of a 32-bit two's-complement value) encodes. Lets a `u32`/negative literal round-trip
// through the signed `Imm32` the encoder carries.
function narrowToImm32(value ParsedInt) returns Imm32
	let low = value and 0xFFFFFFFF
	if low > i32.max 'negative'
		return (low - 0x100000000) as Imm32
	end 'negative'
	return low as Imm32
end 'narrowToImm32'

// The wasm valtype a `loadIndirect`/`storeIndirect` of `valueType` transfers — and, because a byte
// access and a word access take different opcodes, the ONE DOOR that also decides WHICH the callers
// emit. It mirrors the shared native `accessWidthFor`: the language can put only a BYTE (`i1`/`u8`)
// or a WORD (`i64`/`f64`) behind a load/store today, so a byte returns i32 (the `i32.load8_u` /
// `i32.store8` forms — everything ≤ 32 bits is an i32 local) and a word returns i64/f64. The
// returned valtype is UNAMBIGUOUS about width because the only i32-backed types admitted are
// byte-width: an i32 return ⟺ a byte access. Every other width panics rather than picking a nearby
// one — a narrow integer needs the `as` cast (P1.9), whose SIGNEDNESS then decides the
// sign/zero-extending load — exactly the line `accessWidthFor` draws for the native backends. An f32
// cannot occur (Maxon's `float` is f64). A `bool`/`u8` byte zero-extends, which is why the one byte
// load form (`i32.load8_u`) is unsigned; a signed byte (`i8`) is P1.9-gated below.
function wasmMemAccessType(valueType StdType, what String) returns WasmValType
	match valueType 'w'
		i1 then return WasmValType.i32
		u8 then return WasmValType.i32
		i64 then return WasmValType.i64
		f64 then return WasmValType.f64
		i8 to i32 then panic("wasm: {what} of {valueType.name} — a narrow signed integer needs the `as` cast (P1.9), whose signedness picks the sign/zero-extending load; only i1/u8 (byte) and i64/f64 (word) are lowered, mirroring the native accessWidthFor")
		u16 to u64 then panic("wasm: {what} of {valueType.name} — an unsigned integer wider than a byte needs the `as` cast (P1.9); only u8 (byte) and i64/f64 (word) are lowered")
		f32 then panic("wasm: {what} of an f32 — Maxon's `float` is f64, so nothing produces an f32")
	end 'w'
end 'wasmMemAccessType'

// A linear-memory ABSOLUTE address: a section base plus a byte offset within it, as the signed
// `Imm32` an `i32.const` carries. Shared by `globalAddr` (`.data`), `rdataAddr` and the String
// buffer fixup (`.rdata`) — all fixed-base wasm addresses. The whole image sits well below
// i32.max, so the address always fits; a violation is an invariant break (a section larger than 2
// GiB, which the single-page memory this slice declares cannot hold), not a user error.
function wasmLinearAddress(base Wasm32Index, byteOffset ByteOffset) returns Imm32
	let addr = (base as ByteOffset) + byteOffset
	if addr > i32.max 'tooFar'
		panic("wasmLinearAddress: address {addr} (base {base} + offset {byteOffset}) does not fit the signed i32 a wasm linear-memory address is — the data/rdata image exceeds 2 GiB, which the single-page memory this slice declares cannot hold")
	end 'tooFar'
	return addr as Imm32
end 'wasmLinearAddress'

// A memory-band byte offset as the ULEB `offset` a wasm memarg carries (a u32). Every offset in
// this slice is 0 (a plain global's load/store); the bound starts mattering at P1.1's struct
// fields. A value past u32.max is an invariant break — no single 64 KiB memory reaches that far.
function wasmMemOffset(offset ByteOffset) returns Wasm32Index
	if offset > u32.max 'tooFar'
		panic("wasmMemOffset: memarg offset {offset} exceeds the u32 a wasm memarg encodes — an access reaching that far past its base is outside a single linear memory")
	end 'tooFar'
	return offset as Wasm32Index
end 'wasmMemOffset'

// Whether `func` needs the loop+br_table dispatcher. Any multi-block function does; a
// single-block function does too when its terminator branches (a self-loop) rather than
// returning — a lone returning block emits straight-line.
function decideDispatcher(module StdModule, func IrFunction) returns bool
	let blockCount = func.blockRefs.count()
	if blockCount > 1 'multi'
		return true
	end 'multi'
	if blockCount == 0 'empty'
		return false
	end 'empty'

	let blockRef = try func.blockRefs.get(0) otherwise panic("decideDispatcher: blockRefs.get(0) OOB")
	let block = try module.blocks.get(blockRef) otherwise panic("decideDispatcher: blockRef {blockRef} not in module.blocks")
	if not block.hasTerminatorOp() 'noTerm'
		return false
	end 'noTerm'

	let term = try module.ops.get(block.terminatorIndex()) otherwise panic("decideDispatcher: terminatorIndex not in module.ops")
	match term 'k'
		const to mod then break 'k'
		condBranch then return true
		branch then return true
		ret then break 'k'
		param then break 'k'
		call then break 'k'
		retVoid then break 'k'
		globalAddr to rdataAddr then break 'k'
		// `errorReturn` is a non-branching (return) terminator — a throwing function's single block
		// ending in it is straight-line, exactly like `ret`. `tryCall`/`osExit` are never terminators.
		tryCall then panic("decideDispatcher: a `tryCall` is a value-producing body op, never a terminator")
		errorReturn then break 'k'
		osExit then panic("decideDispatcher: an `osExit` is a body op followed by a dead return, never a terminator")
		// A `funcAddr`/`callIndirect` is a value-producing body op, never a terminator — the same
		// invariant `tryCall`/`osExit` assert (P1.5-A1).
		funcAddr then panic("decideDispatcher: a `funcAddr` is a value-producing body op, never a terminator")
		callIndirect then panic("decideDispatcher: a `callIndirect` is a value-producing body op, never a terminator")
		osRangePanic to osFreePages then panic("decideDispatcher: an `osRangePanic` is a body op, never a terminator")
	end 'k'
	return false
end 'decideDispatcher'

// Index of a move whose dst is not any pending move's source (safe to emit now), or the move
// count when every remaining dst is still needed as a source (a pure cycle).
function findLeafMove(dsts ValueIdArray, srcs ValueIdArray) returns ValueId
	for i in 0 upto dsts.count() 'each'
		let d = try dsts.get(i) otherwise panic("findLeafMove: dsts.get OOB at {i}")
		if not isAnySource(srcs, valueId: d) 'leaf'
			return i
		end 'leaf'
	end 'each'
	return dsts.count()
end 'findLeafMove'

function isAnySource(srcs ValueIdArray, valueId ValueId) returns bool
	for s in srcs 'each'
		if s == valueId 'match'
			return true
		end 'match'
	end 'each'
	return false
end 'isAnySource'

// Remove every move already satisfied (dst == src) — the self-copies a preceding scratch swap
// just fulfilled (a source rewritten through the exchange now equals its dst). Scans back-to-
// front so removals do not shift not-yet-visited indices.
function removeSatisfiedMoves(dsts ValueIdArray, srcs ValueIdArray)
	let n = dsts.count()
	for ri in 0 upto n 'each'
		let i = n - 1 - ri
		let d = try dsts.get(i) otherwise panic("removeSatisfiedMoves: dsts.get OOB at {i}")
		let s = try srcs.get(i) otherwise panic("removeSatisfiedMoves: srcs.get OOB at {i}")
		if d == s 'satisfied'
			removeMoveAt(dsts, srcs: srcs, idx: i)
		end 'satisfied'
	end 'each'
end 'removeSatisfiedMoves'

function removeMoveAt(dsts ValueIdArray, srcs ValueIdArray, idx ValueId)
	_ = try dsts.remove(idx) otherwise panic("removeMoveAt: dsts.remove OOB at {idx}")
	_ = try srcs.remove(idx) otherwise panic("removeMoveAt: srcs.remove OOB at {idx}")
end 'removeMoveAt'

// After exchanging locals a and b, a pending move reading a now finds its value in b and
// vice-versa.
function rewriteSourcesThroughSwap(srcs ValueIdArray, a ValueId, b ValueId)
	for i in 0 upto srcs.count() 'each'
		let s = try srcs.get(i) otherwise panic("rewriteSourcesThroughSwap: srcs.get OOB at {i}")
		if s == a 'wasA'
			try srcs.set(i, value: b) otherwise panic("rewriteSourcesThroughSwap: srcs.set OOB at {i}")
		end 'wasA' else if s == b 'wasB'
			try srcs.set(i, value: a) otherwise panic("rewriteSourcesThroughSwap: srcs.set OOB at {i}")
		end 'wasB'
	end 'each'
end 'rewriteSourcesThroughSwap'
