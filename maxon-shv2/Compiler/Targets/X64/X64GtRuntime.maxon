// X64GtRuntime — the hand-assembled GREEN-THREAD backend code that MUST be raw bytes rather than Std ops
// (P1.5-B1a / B1a′). Everything else in the scheduler is a builder-built `StdModule` (Runtime/GtRuntime.maxon).
// Two standalone `FunctionCodeChunk`s — `__gt_context_switch` and `__gt_trampoline` — manipulate rsp/rbp and
// physical callee-saved registers or are entered by a `ret` into a frame no prologue built; plus the INLINE
// syscall shim (`emitGtShimmedIatCall`, P1.5-B1a′) that X64Backend wraps around every `iatCall` of a GT module.
// None is expressible in Std (no register/rsp/gs-segment spelling), so all are built by calling X64Backend's
// encoders directly, like the `mrt_*` panic runtime (X64Runtime.maxon).
//
// ⭐ THE TWO CHUNKS TOUCH NO `.data` GLOBAL. The context switch passes the `to` GT through in rdx unchanged, so
// the trampoline reads its own GT from rdx (not from `__gt_current_gt`); the drivers own the current-GT global
// (see GtRuntime.maxon's header). The context switch also repoints the NT_TIB stack bounds on every switch
// (`gs:[0x08]`/`gs:[0x10]`, and the `to`/`from` GTs' saved-bounds fields via their rdx/rcx pointers) — a SEGMENT
// and register-pointer accesses, still no rdata relocation, so both chunks stay pure register/stack/segment
// code exactly like the panic runtime. The INLINE shim, by contrast, DOES reference the `__gt_current_gt` /
// `__gt_system_stack_top` `.data` globals — through the ordinary `encodeLeaRegGlobal` rdata-relocation path the
// backend already resolves, so no new relocation machinery is added for it.
//
// CALLING CONVENTION — Maxon's internal ABI (StdToX64Conversion): integer arguments in
// [rcx, rdx, rax, r9, rsi, rdi], primary return in R8; callee-saved registers are the GPRs rbx, r12-r15
// and the XMMs xmm6-15 (RegisterAllocator.calleeSavedMask), plus rsp/rbp (the frame). The context switch
// saves EXACTLY that callee-saved set — a `call __gt_context_switch` is an ordinary call, so from a
// suspending function's view it must preserve precisely what any call preserves, no more (rsi/rdi/rax are
// ARGUMENT registers here, hence caller-saved, hence NOT saved — the one place shv2's ABI diverges from
// v1's, whose rsi/rdi are callee-saved).
//
// ⚠⚠ THE SWITCH IS THE ONE CALL WHOSE CALLEE-SAVED PROMISE IS KEPT BY HAND. Every register-allocated
// function keeps it by construction (its prologue preserves what its coloring used); this chunk has no
// prologue and no coloring, and — unlike any ordinary callee — it runs ANOTHER green thread's arbitrary
// code before control returns. So every register the colorer believes survives a call must be saved here
// EXPLICITLY, and that set is exactly the two ordered lists below. Wave 2 grew it by ten XMMs.

// The callee-saved registers the context switch saves and restores: the GPRs in push order (pop order is the
// exact reverse), then the XMMs into a `sub rsp` area written with `movsd` — the SAME `calleeSavedOrder` and
// `calleeSavedXmmOrder` the ordinary prologue/epilogue preserves (X64PrologueEpilogue), so the switch
// preserves EXACTLY what any call preserves, from two shared lists rather than second copies. Their sizes are
// the contract `__gt_spawn`'s initial frame layout byte-matches: `GtInitialFrameBytes` = the GPR words + the
// XMM words + the return-address word, and the trampoline address sits in that top word so the first
// switch-in's `ret` enters the trampoline. `assertGtFrameConsistent` (below) enforces that byte-match at
// chunk-build time, deriving it from BOTH lists.
//
// ⚠ ONE `XmmSaveSlotBytes` WORD PER XMM — the SAME constant the prologue's slots stride by, not a second 8
// that happens to agree. The low 64 bits ARE the value in shv2 (no type is wider, and nothing reads bits
// 64-127); the full argument and the condition that would invalidate it live once in `X64PrologueEpilogue`'s
// header, beside that constant. Widen it there and `assertGtFrameConsistent` — which now DERIVES from it,
// where it used to derive from `GtArgSlotBytes` (the async argument-buffer stride, a different fact that
// happens to be 8) and so could never have seen the prologue widen — panics on the next async compile.

// The register the context switch reads `from` (arg 0) and `to` (arg 1) from — the ABI's first two integer
// argument registers. `to` rides through UNMODIFIED so a fresh GT's trampoline reads its GT from rdx.
let GtSwitchFromReg = X64Register.rcx
let GtSwitchToReg = X64Register.rdx

// The scratch the context switch shuttles the NT_TIB stack bounds through (save `from`'s, load `to`'s). rax is
// caller-saved and is not read across a switch by any resumed continuation, so clobbering it here is invisible.
let GtSwitchTibScratchReg = X64Register.rax

// NT_TIB stack-bound fields in the GS segment (Win64). A kernel call probes these and faults when RSP is
// outside `[StackLimit, StackBase)`. Both the syscall shim (repoint at the system stack for a call) and the
// context switch (repoint at the resumed GT's stack) write them, so they are named once here.
let TibStackBaseDisp = 0x08 as Imm32  // NT_TIB.StackBase  — gs:[0x08]
let TibStackLimitDisp = 0x10 as Imm32  // NT_TIB.StackLimit — gs:[0x10]

// The NT_TIB stack bounds are a PAIR (base, limit); these two helpers spell that two-word structure ONCE for
// the three sites that move it — the context switch's save + load, and the shim's after-call restore (which is
// exactly a load). `scratch` shuttles each word (`gtReg` and `scratch` must differ); neither helper touches any
// other register.
function emitSaveTibIntoGt(code ByteArray, gtReg X64Register, scratch X64Register)
	encodeMovRegGsAbs(code, dest: scratch, disp: TibStackBaseDisp)
	encodeStoreBaseDispReg(code, base: gtReg, disp: GtOffTibStackBase as Imm32, srcReg: scratch)
	encodeMovRegGsAbs(code, dest: scratch, disp: TibStackLimitDisp)
	encodeStoreBaseDispReg(code, base: gtReg, disp: GtOffTibStackLimit as Imm32, srcReg: scratch)
end 'emitSaveTibIntoGt'

function emitLoadTibFromGt(code ByteArray, gtReg X64Register, scratch X64Register)
	encodeLoadRegBaseDisp(code, destReg: scratch, base: gtReg, disp: GtOffTibStackBase as Imm32, wide: true)
	encodeMovGsAbsReg(code, disp: TibStackBaseDisp, srcReg: scratch)
	encodeLoadRegBaseDisp(code, destReg: scratch, base: gtReg, disp: GtOffTibStackLimit as Imm32, wide: true)
	encodeMovGsAbsReg(code, disp: TibStackLimitDisp, srcReg: scratch)
end 'emitLoadTibFromGt'

// Repoint the NT_TIB at the single SYSTEM stack `[topReg - GtSystemStackSize, topReg)` — `gs:[0x08] = top`,
// `gs:[0x10] = top - size`. The two sites that switch a kernel call onto the system stack — the syscall shim
// (before an `iatCall`) and `__gt_morestack` (step 3, for its own VirtualAlloc/VirtualFree) — compute those
// TWO TIB words the SAME way, so the `top - size` structure is spelled ONCE here rather than open-coded twice,
// where an edit to one could silently repoint one stack differently from the other. `topReg` is DESTROYED (it
// becomes `top - size`); both callers hold `top` in a register they are otherwise done with.
function emitRepointTibToSystemStack(code ByteArray, topReg X64Register)
	encodeMovGsAbsReg(code, disp: TibStackBaseDisp, srcReg: topReg)
	encodeGrp1RegImm32(code, ext: Grp1ExtSub, reg: topReg, imm: GtSystemStackSize as Imm32)
	encodeMovGsAbsReg(code, disp: TibStackLimitDisp, srcReg: topReg)
end 'emitRepointTibToSystemStack'

// The scratch registers the trampoline holds across the straight-line body: r12 = the GT (callee-saved, so it
// survives the user call), r10 = the argument buffer, r11 = the function pointer. None is an argument register,
// so the six arg-register loads below cannot clobber them.
let GtTrampGtReg = X64Register.r12
let GtTrampArgBufReg = X64Register.r10
let GtTrampFuncPtrReg = X64Register.r11

// The bytes the context switch reserves below its GPR pushes for the callee-saved XMM half — one
// `XmmSaveSlotBytes` slot per register of `calleeSavedXmmOrder`, which IS the width the prologue's slots use
// because it is the same constant.
function gtXmmSaveAreaBytes() returns StackSize
	return calleeSavedXmmOrder.count() * XmmSaveSlotBytes
end 'gtXmmSaveAreaBytes'

// ⭐ Enforce the ONE fact the Std-tier frame builder (`__gt_spawn` in GtRuntime, which lays `GtInitialFrameBytes`)
// and this Target-tier byte code SHARE: a fresh GT's initial context-switch frame is every callee-saved
// register plus one return-address word. If a register is added to or removed from EITHER callee-saved list
// without moving `GtInitialFrameBytes` in lockstep, the first switch-in pops the wrong number of bytes and
// `ret`s into a WILD address. This turns that silent cross-tier drift into a compile-time panic on every
// async compile — a CHECK where the two sides were previously tied only by a comment (feedback: DERIVE >
// CHECK > COMMENT).
//
// ⚠⚠ IT IS DERIVED FROM **BOTH** LISTS, AND THAT IS THE WHOLE POINT AT WAVE 2. The GPRs are pushed words; the
// XMMs are `movsd` words in a `sub rsp` area, because x86-64 has no `push xmm`. Leaving this deriving from
// `calleeSavedOrder` ALONE would have kept it passing while covering only half the frame — and the GT hazard
// would have gone silent exactly as the callee-saved set grew. An assert that covers only the half that did
// not change is worse than none: it reads as protection.
//
// ⚠⚠ AND IT IS DERIVED FROM THE PROLOGUE'S OWN STRIDE (`XmmSaveSlotBytes`, via `gtXmmSaveAreaBytes`), which
// is the second half of the same lesson. It used to compute the XMM half from `GtArgSlotBytes` — 8 for an
// unrelated reason — so widening the prologue's slots to 16 would have left THIS still passing while the
// context switch saved 8 of every 16 bytes: the upper halves of xmm6-15 destroyed across every `await`,
// under a comment promising this assert would catch exactly that.
function assertGtFrameConsistent()
	let gprBytes = calleeSavedOrder.count() * StackWordBytes
	let framedBytes = gprBytes + gtXmmSaveAreaBytes() + StackWordBytes

	if framedBytes != GtInitialFrameBytes 'drift'
		panic("GT frame drift: the context switch saves {calleeSavedOrder.count()} callee-saved GPR words ({gprBytes} bytes) + {calleeSavedXmmOrder.count()} callee-saved XMM words ({gtXmmSaveAreaBytes()} bytes) + 1 return-address word = {framedBytes} bytes, but GtInitialFrameBytes (the frame __gt_spawn lays) is {GtInitialFrameBytes} — a mismatch is a wild ret on the first switch-in")
	end 'drift'
end 'assertGtFrameConsistent'

// `__gt_context_switch(from = rcx, to = rdx)` — save the current GT's callee-saved register + rsp/rbp state
// into `from`, restore `to`'s, and `ret` into `to`'s saved return address (a resumed GT's await-loop
// continuation, or — for a fresh GT — the trampoline). No frame, no `.data`.
function buildGtContextSwitchChunk() returns FunctionCodeChunk
	assertGtFrameConsistent()
	var code = ByteArray.create()

	// Save callee-saved on the current (from) stack, in push order.
	for reg in calleeSavedOrder 'push'
		encodePushReg(code, reg: reg)
	end 'push'

	// ⭐⭐ AND THE CALLEE-SAVED XMMs (Wave 2) — `sub rsp` + `movsd`, because there is no `push xmm`.
	//
	// THIS IS NOT OPTIONAL AND IT IS NOT SYMMETRY FOR ITS OWN SAKE. Ordinary user code reaches this chunk
	// through a normal `call` (`__gt_await` → `__gt_context_switch`), so the colorer treats it as a call
	// clobbering exactly `callerSavedMask()` — which, since Wave 2, EXCLUDES xmm6-15. The colorer therefore
	// believes a float in xmm6 survives this call. But this chunk does not return to its caller: it switches
	// to a DIFFERENT green thread's stack, that thread runs arbitrary user code, and control comes back here
	// only later. Without these saves the other thread's float work lands in xmm6-15 and the suspended
	// thread resumes reading it — a silent wrong answer with no crash to find it by. Every other register the
	// colorer believes survives a call is already saved above, for exactly this reason; Wave 2 added ten more
	// to that set and this is where they are honoured.
	// One slot per callee-saved XMM — bounded by that list, two orders of magnitude below the guard
	// page, so this reservation never walks and needs no scratch (see `encodePrologue`).
	encodePrologue(code, stackSize: gtXmmSaveAreaBytes(), probeScratchIsFree: false)
	for k in 0 upto calleeSavedXmmOrder.count() 'saveXmm'
		let reg = try calleeSavedXmmOrder.get(k) otherwise panic("buildGtContextSwitchChunk: save index derived from count is in range")
		encodeMovsdBaseDispReg(code, base: X64Register.rsp, disp: (k * XmmSaveSlotBytes) as Imm32, srcReg: reg)
	end 'saveXmm'

	// from->sp = rsp ; from->fp = rbp.
	encodeStoreBaseDispReg(code, base: GtSwitchFromReg, disp: GtOffSp as Imm32, srcReg: X64Register.rsp)
	encodeStoreBaseDispReg(code, base: GtSwitchFromReg, disp: GtOffFp as Imm32, srcReg: X64Register.rbp)
	// ⭐ SAVE the CURRENT NT_TIB stack bounds into `from`, so the TIB always describes the stack that is actually
	// executing. Without this, the syscall shim's after-call restore (which sets the TIB to `currentGt`'s bounds)
	// would leave the TIB describing the OUTGOING GT's stack after a switch, and the RESUMED GT's next kernel call
	// would probe a TIB that does not contain its RSP and fault. This is also what SEEDS GT0's bounds: GT0 never
	// runs the shim (its `stackBase == 0`), so the first switch AWAY from GT0 is the only place its real
	// main-thread TIB bounds are captured. Uses rax as scratch — caller-saved and not read across a switch.
	emitSaveTibIntoGt(code, gtReg: GtSwitchFromReg, scratch: GtSwitchTibScratchReg)

	// rsp = to->sp ; rbp = to->fp — now on the destination stack.
	encodeLoadRegBaseDisp(code, destReg: X64Register.rsp, base: GtSwitchToReg, disp: GtOffSp as Imm32, wide: true)
	encodeLoadRegBaseDisp(code, destReg: X64Register.rbp, base: GtSwitchToReg, disp: GtOffFp as Imm32, wide: true)
	// LOAD the resumed GT's saved TIB bounds into the NT_TIB, matching the stack we just switched to (`__gt_spawn`
	// seeds a fresh GT's bounds; the save above keeps every GT's fresh). The pair keeps `gs:[0x08]`/`gs:[0x10]`
	// consistent with RSP across every switch.
	emitLoadTibFromGt(code, gtReg: GtSwitchToReg, scratch: GtSwitchTibScratchReg)

	// Restore the callee-saved XMMs from the new stack FIRST — they sit BELOW the pushed GPR words, so rsp
	// addresses them before the `add rsp` that releases their area. Restore order is free (each register has
	// its own word rather than a stack position); only the GPR pops below are LIFO.
	for k in 0 upto calleeSavedXmmOrder.count() 'restoreXmm'
		let reg = try calleeSavedXmmOrder.get(k) otherwise panic("buildGtContextSwitchChunk: restore index derived from count is in range")
		encodeMovsdRegBaseDisp(code, destReg: reg, base: X64Register.rsp, disp: (k * XmmSaveSlotBytes) as Imm32)
	end 'restoreXmm'
	encodeEpilogue(code, stackSize: gtXmmSaveAreaBytes())

	// Restore callee-saved from the new stack, in reverse push order, then `ret` into to's saved return addr.
	for i in 0 upto calleeSavedOrder.count() 'pop'
		let reg = try calleeSavedOrder.get(calleeSavedOrder.count() - 1 - i) otherwise panic("buildGtContextSwitchChunk: pop index derived from count is in range")
		encodePopReg(code, reg: reg)
	end 'pop'
	code.push(OpcodeRet)

	return FunctionCodeChunk.createWith(GtContextSwitchName, code: code, callFixups: CallFixupArray.create(), rdataRelocs: RdataRelocationArray.create(), iatRelocs: RelocationArray.create(), rdataConstants: GlobalDataTable.create())
end 'buildGtContextSwitchChunk'

// `__gt_trampoline` — the entry a FRESH green thread `ret`s into on its first switch-in. NOT a normal call:
// no incoming register arguments and no prologue built for it. It reads its own GT from rdx (which the
// context switch left holding `to`), loads the async function + arg buffer from the GT, loads all
// MaxAsyncArgs argument slots into the ABI argument registers, calls the function, captures its R8 result
// and marks the GT completed, then context-switches to the GT's waiter (always set by the driver that ran it).
//
// The stack is 16-aligned on entry (`__gt_spawn` lays `gt.sp` so the switch-in `ret` lands with rsp = stack
// top, a page boundary), so `sub rsp, ShadowSpaceBytes` — a multiple of 16 — keeps every `call` below aligned
// while reserving the Win64 shadow space the user call may clobber.
function buildGtTrampolineChunk() returns FunctionCodeChunk
	var code = ByteArray.create()
	var callFixups = CallFixupArray.create()

	// gt = rdx (the context switch's `to`, unmodified). Held in a callee-saved register across the user call.
	encodeRmRegDirect(code, opcode: OpcodeMovRmReg, dest: GtTrampGtReg, src: GtSwitchToReg, wide: true)
	encodeLoadRegBaseDisp(code, destReg: GtTrampArgBufReg, base: GtTrampGtReg, disp: GtOffArgBuf as Imm32, wide: true)
	encodeLoadRegBaseDisp(code, destReg: GtTrampFuncPtrReg, base: GtTrampGtReg, disp: GtOffFuncPtr as Imm32, wide: true)

	// Reserve the user call's shadow space (see the alignment note above). 32 bytes, and r11 is
	// LIVE across it (it carries the callee's function pointer, called below) — so this must never
	// be the reservation that walks, and `probeScratchIsFree: false` is what says so.
	encodePrologue(code, stackSize: ShadowSpaceBytes, probeScratchIsFree: false)

	// Load every argument slot into its ABI argument register. The callee reads only the slots it declared;
	// the rest are the arg buffer's slab zeros in unread registers. `argRegisterAt` is the ABI's own
	// arg-register oracle, so this load order cannot drift from a call site's arg order.
	for k in 0 upto MaxAsyncArgs 'args'
		encodeLoadRegBaseDisp(code, destReg: argRegisterAt(k as ParamCount), base: GtTrampArgBufReg, disp: (k * GtArgSlotBytes) as Imm32, wide: true)
	end 'args'

	// Call the async function; capture its R8 result AND its R10 error flag into the GT; mark completed.
	// R8 (result) and R10 (the dual-register error flag) are the throws ABI's two return registers and are
	// NOT argument registers, so both survive the arg-register loads above and hold the thunk's return values
	// here. R10 is captured UNCONDITIONALLY: for a NON-throwing thunk it is garbage, but harmless — only
	// `__gt_try_await` ever reads `gt.threw`, and a non-throwing promise is awaited via `__gt_await`, which
	// does not. This is the same r10 the trampoline used as its arg-buffer scratch (`GtTrampArgBufReg`) before
	// the call; that use is finished once the args are loaded, so the register is free to receive the flag.
	encodeCallReg(code, reg: GtTrampFuncPtrReg)
	encodeStoreBaseDispReg(code, base: GtTrampGtReg, disp: GtOffResult as Imm32, srcReg: X64Register.r8)
	encodeStoreBaseDispReg(code, base: GtTrampGtReg, disp: GtOffThrew as Imm32, srcReg: X64Register.r10)
	encodeMovRegImm32(code, dest: X64Register.rax, value: GtStatusCompleted)
	encodeStoreBaseDispReg(code, base: GtTrampGtReg, disp: GtOffStatus as Imm32, srcReg: X64Register.rax)

	// context_switch(from = gt, to = gt.waiter) — never returns (the GT is completed).
	encodeLoadRegBaseDisp(code, destReg: GtSwitchToReg, base: GtTrampGtReg, disp: GtOffWaiter as Imm32, wide: true)
	encodeRmRegDirect(code, opcode: OpcodeMovRmReg, dest: GtSwitchFromReg, src: GtTrampGtReg, wide: true)
	encodeCallDirect(code, callFixups: callFixups, targetName: GtContextSwitchName)

	return FunctionCodeChunk.createWith(GtTrampolineName, code: code, callFixups: callFixups, rdataRelocs: RdataRelocationArray.create(), iatRelocs: RelocationArray.create(), rdataConstants: GlobalDataTable.create())
end 'buildGtTrampolineChunk'

// --- The Win32 syscall shim (P1.5-B1a′ slice 1) ---
//
// A green thread's kernel call runs on the single global 64 KB SYSTEM stack, not the GT's own small stack:
// heavy Win32 calls (CreateProcessA, WriteFile) use deep stack and probe the Windows TIB, and would fault a
// small GT stack. This slice keeps GT stacks at 1 MiB (kernel calls do not fault today), so it is TRANSPARENT
// infrastructure whose correctness proof is "every spec stays green through it"; slice 2's 2 KB GT stacks are
// what make the switch load-bearing. Emitted inline around EVERY `iatCall` of a GT module (the runtime gate
// makes it a no-op off a GT stack), so a program that never touches the scheduler is unchanged.
//
// ⭐ WHY IT COPIES THE STACK ARGS instead of writing them AFTER the switch (v1/bootstrap's way). v1 and the C#
// bootstrap switch RSP first, THEN write the call's stack args on the system stack — sound only because THEIR
// `__print_string`/subprocess runtime is HAND-ASSEMBLED, with no register allocator. shv2's are builder-built
// Std, REGISTER-ALLOCATED, and shv2 addresses both spills and outgoing args RSP-relative (X64Backend spills;
// `win64OutgoingArgDisp`). Switching RSP before the arg-setup ops would make any spill RELOAD the allocator
// inserts for an arg operand read the SYSTEM stack — a silent miscompile. So the shim wraps ONLY the `iatCall`
// with RSP unchanged through all arg-setup (spills/arg-stores land on the GT frame at `[rsp+0x20+k*8]` exactly
// as today), then COPIES the N outgoing stack-arg words onto the system stack after the switch. RSP moves only
// inside the shim's own bytes and is restored before the next TargetOp — invisible to the register allocator.
//
// ⭐ REGISTER DISCIPLINE. Win64 passes integer args in rcx/rdx/r8/r9 and returns in rax; the shim preserves
// those. It uses ONLY rax/rcx/r10/r11 as scratch — every one caller-saved and in `iatCall`'s `implicitDefs`
// (RegisterAllocator.callerSavedMask), so the allocator already treats them as call-destroyed and the shim's
// use is invisible. The args (rcx/rdx/r8/r9) are untouched BEFORE the call; the result (rax) is untouched
// AFTER it — the post-call TIB restore uses rcx, which is dead once the call has returned.
//
// ⚠ NO NESTING. The shim switches to the FIXED `__gt_system_stack_top` (reset every entry, not a bump
// pointer). Safe only because a kernel call is a LEAF that never re-enters guarded Maxon code, and single-M
// runs one thing at a time — a shimmed call must never reach another shimmed call on the same thread.

// A pushed 64-bit register is 8 bytes. The shim pushes two such words (the caller's r10 on the GT stack, then
// the saved GT rsp on the system stack). This is BOTH the offset from `r10` — which points at the first pushed
// word after `push r10 ; mov r10, rsp` — up to the original RSP where the GT-frame stack args sit, AND the pad
// the reserved system-stack frame adds so the second push leaves RSP 16-aligned at the `call`.
// It IS `StackWordBytes` — "what a `push r64` moves rsp by" is that constant's own definition — and says so
// rather than repeating an 8, for the reason `XmmSaveSlotBytes` does (X64PrologueEpilogue).
let ShimPushedWordBytes = StackWordBytes as StackSize

// The shim's scratch registers (see the header's register discipline). None is a Win64 argument register.
let ShimGtReg = X64Register.r11  // currentGt in the guard, then the stack-arg copy shuttle, then reloaded post-call
let ShimGtRspReg = X64Register.r10  // the GT's RSP across the switch (push/pop-balanced)
let ShimTibScratchReg = X64Register.rcx  // post-call TIB-restore scratch; dead after the call, so rax (the result) survives

// The shim's own forward-branch targets, resolved by `resolveChunkRel32Fixups` against a shim-LOCAL fixup list
// and offset map — the same machinery the panic runtime's assembler uses, scoped here so the ids are looked up
// only in the shim's own map and never collide with the enclosing function's block ids.
let ShimDirectLabel = 0 as BlockId
let ShimDoneLabel = 1 as BlockId

// The count of true Win64 stack arguments (args 5+) a shimmed import takes — the words the shim copies from the
// GT frame onto the system stack. Read from the ISEL's `*StackArgWords` single source (StdToX64Conversion), the
// SAME constant that sizes each call's outgoing-arg reservation — so the copy count is DERIVED from the arg
// layout it must match, never a second copy that could drift into a silent CreateProcessA/WriteFile miscompile
// (too few words copied ⇒ the kernel reads garbage stack args). A ≤4-arg (register-only) import passes nothing
// on the stack and copies nothing.
// ⭐⭐ **THE SHIM'S PER-IMPORT COPY COUNT — TOTAL OVER `IatSlot`, SO AN OMISSION IS A COMPILE ERROR (7a).**
//
// This was an int-keyed `if`-chain ending in a bare `return 0`: a table that must be COMPLETE, whose
// incompleteness was SILENT and whose silent answer was the dangerous one. It has already cost a wrong
// answer once — R4.1 added `CreateFileA` beside `CreateFileW` and did not add it here, so a
// `__ManagedFile.open*` reached from a SPAWNED green thread copied ZERO words onto the system stack and
// `dwCreationDisposition`, `dwFlagsAndAttributes` and `hTemplateFile` were whatever happened to be in that
// memory. Reachable only OFF the main thread, which is why a green suite never saw it (the corpus combines
// no `async` with file IO), and it is the project's own "no silent unhandled cases" rule broken in a table
// where the default is indistinguishable from a correct answer.
//
// ⇒ **The `match` below is EXHAUSTIVE over the enum, so adding an `IatSlot` does not compile until its
// count is stated.** That is the whole point of the rung: the next `CreateFileA` cannot be forgotten,
// because forgetting it is no longer expressible. There is no `default` arm and there must never be one —
// a `default gives 0` would restore the exact defect, wearing a `match`'s clothes.
//
// ⚠ **A `0` HERE IS A CLAIM, NOT A BLANK.** It says the import passes four or fewer arguments, so Win64
// puts every one in rcx/rdx/r8/r9 and there is nothing on the stack to copy. Each such arm carries its
// argument count so the claim can be checked against MSDN without reading the emitter.
//
// ⚠ **THE EIGHT NON-ZERO COUNTS ARE NOT SPELLED HERE.** They are the SAME constants
// `StdToX64Conversion.stdOpOutgoingArgBytes` reserves the GT frame with, so the copy and the reservation
// cannot disagree about how many words the kernel reads — the property those constants' own headers exist
// to hold. This function maps slots to them; it does not restate them.
function gtShimStackArgWords(slotIndex RelocSlotIndex) returns StackSize
	for slot in IatSlot.allCases 'each'
		if iatSlotIndex(slot) == slotIndex 'found'
			return gtShimStackArgWordsOf(slot)
		end 'found'
	end 'each'

	panic("gtShimStackArgWords: slot index {slotIndex} names no IatSlot — every `iatCall` relocation is minted from `iatSlotIndex(IatSlot.…)`, so an index outside the enum means the op carried a hand-built number")
end 'gtShimStackArgWords'

// The stack-argument word count of ONE import, exhaustive over `IatSlot`. See `gtShimStackArgWords`.
function gtShimStackArgWordsOf(slot IatSlot) returns StackSize
	return match slot 'k'
		// --- the imports the kernel reads stack arguments for: the counts live with the arg layout ---
		CreateProcessA gives CreateProcessStackArgWords
		WriteFile gives WriteFileStackArgWords
		CreateNamedPipeW gives CreateNamedPipeStackArgWords
		CreateFileW gives CreateFileStackArgWords
		// The `A` variant takes the SAME seven arguments as its `W` sibling, so it derives from the same
		// constant. This is the entry R4.1 omitted and R4.2 restored — the defect this rung makes unrepeatable.
		CreateFileA gives CreateFileStackArgWords
		CreateThread gives CreateThreadStackArgWords
		ReadFile gives ReadFileStackArgWords
		// O3. FIVE arguments, so one word on the stack — derived from the same constant
		// `stdOpOutgoingArgBytes` reserves the frame with, never restated here.
		MapViewOfFile gives MapViewOfFileStackArgWords

		// ⚠ FIVE arguments, so ONE lands on the stack — and this arm is why the enum is worth being exhaustive
		// over. It sat in the old `return 0` fallthrough, where the answer was WRONG but harmless because the
		// completion loop is hand-assembled and calls it DIRECTLY, never through the shim. Stated at its true
		// ABI count rather than at the 0 its current unreachability would excuse, so the answer stays right if
		// it is ever emitted as an `iatCall`.
		GetQueuedCompletionStatus gives GetQueuedCompletionStatusStackArgWords

		// --- four arguments or fewer: register-only, nothing on the stack ---
		ExitProcess gives 0  // 1: uExitCode
		GetStdHandle gives 0  // 1: nStdHandle
		AddVectoredExceptionHandler gives 0  // 2: First, Handler
		VirtualAlloc gives 0  // 4: lpAddress, dwSize, flAllocationType, flProtect
		QueryPerformanceCounter gives 0  // 1: lpPerformanceCount
		QueryPerformanceFrequency gives 0  // 1: lpFrequency
		Sleep gives 0  // 1: dwMilliseconds
		GetExitCodeProcess gives 0  // 2: hProcess, lpExitCode
		WaitForSingleObject gives 0  // 2: hHandle, dwMilliseconds
		WaitForMultipleObjects gives 0  // 4: nCount, lpHandles, bWaitAll, dwMilliseconds
		CloseHandle gives 0  // 1: hObject
		VirtualFree gives 0  // 3: lpAddress, dwSize, dwFreeType
		SetHandleInformation gives 0  // 3: hObject, dwMask, dwFlags
		CreateIoCompletionPort gives 0  // 4: FileHandle, ExistingCompletionPort, CompletionKey, NumberOfConcurrentThreads
		SetFileCompletionNotificationModes gives 0  // 2: FileHandle, Flags
		CreateEventA gives 0  // 4: lpEventAttributes, bManualReset, bInitialState, lpName
		SetEvent gives 0  // 1: hEvent
		InitializeCriticalSection gives 0  // 1: lpCriticalSection
		EnterCriticalSection gives 0  // 1: lpCriticalSection
		LeaveCriticalSection gives 0  // 1: lpCriticalSection
		GetLastError gives 0  // 0
		GetCurrentProcessId gives 0  // 0
		CancelIoEx gives 0  // 2: hFile, lpOverlapped
		GetSystemTimeAsFileTime gives 0  // 1: lpSystemTimeAsFileTime
		GetFileSizeEx gives 0  // 2: hFile, lpFileSize
		DeleteFileA gives 0  // 1: lpFileName
		MoveFileExA gives 0  // 3: lpExistingFileName, lpNewFileName, dwFlags
		FindFirstFileA gives 0  // 2: lpFileName, lpFindFileData
		FindClose gives 0  // 1: hFindFile
		FindNextFileA gives 0  // 2: hFindFile, lpFindFileData
		CreateDirectoryA gives 0  // 2: lpPathName, lpSecurityAttributes
		GetCurrentDirectoryA gives 0  // 2: nBufferLength, lpBuffer
		GetFileAttributesA gives 0  // 1: lpFileName
		GetCommandLineA gives 0  // 0
		GetModuleFileNameA gives 0  // 3: hModule, lpFilename, nSize
		// O3. Its fourth sibling `MapViewOfFile` takes five and is stated with the other non-zero counts above.
		GetEnvironmentVariableA gives 0  // 3: lpName, lpBuffer, nSize
		OpenFileMappingA gives 0  // 3: dwDesiredAccess, bInheritHandle, lpName
		GetTickCount64 gives 0  // 0
	end 'k'
end 'gtShimStackArgWordsOf'

// Emit an `iatCall`, wrapped in the system-stack shim iff the module carries the GT scheduler (see the header).
export function emitGtGatedIatCall(code ByteArray, iatRelocs RelocationArray, rdataRelocs RdataRelocationArray, slotIndex RelocSlotIndex, usesGt bool)
	if usesGt 'shim'
		emitGtShimmedIatCall(code, iatRelocs: iatRelocs, rdataRelocs: rdataRelocs, slotIndex: slotIndex)
	end 'shim' else 'plain'
		encodeIatCall(code, iatRelocs: iatRelocs, slotIndex: slotIndex)
	end 'plain'
end 'emitGtGatedIatCall'

// The shim itself. RSP is 16-aligned at entry (shv2's frame invariant at every call), and the switch makes RSP
// 16-aligned at the `call` INDEPENDENTLY of the caller's alignment (it sets RSP = the page-aligned system-stack
// top and reserves a frame chosen to land on 16). Disassembly of the CreateProcessA (6 stack args) path:
//   lea r11,[rip+__gt_current_gt] ; mov r11,[r11] ; test r11,r11 ; jz direct   (no scheduler → direct)
//   mov r11,[r11+0x18]            ; test r11,r11 ; jz direct                   (GT0/main, stackBase==0 → direct)
//   push r10 ; mov r10,rsp ; lea rax,[rip+__gt_system_stack_top] ; mov rax,[rax] ; mov rsp,rax
//   push r10 ; sub rsp,0x58                                                    (shadow 0x20 + 6 args 0x30 + pad 8)
//   (mov r11,[r10+0x28+k*8] ; mov [rsp+0x20+k*8],r11) for k in 0..6            (6 args → [rsp+0x20..0x48])
//   mov gs:[0x08],rax ; sub rax,0x10000 ; mov gs:[0x10],rax                    (repoint TIB at the system stack)
//   call [CreateProcessA]
//   lea r11,[rip+__gt_current_gt] ; mov r11,[r11]
//   mov rcx,[r11+0x90] ; mov gs:[0x08],rcx ; mov rcx,[r11+0x98] ; mov gs:[0x10],rcx   (restore TIB to this GT)
//   add rsp,0x58 ; pop r10 ; mov rsp,r10 ; pop r10 ; jmp done                  (switch back to the GT stack)
//   direct: call [CreateProcessA]
//   done:
function emitGtShimmedIatCall(code ByteArray, iatRelocs RelocationArray, rdataRelocs RdataRelocationArray, slotIndex RelocSlotIndex)
	let stackArgWords = gtShimStackArgWords(slotIndex)
	// reserve = (16-aligned shadow + stack args) + one pushed word — lands RSP 16-aligned at the `call` after
	// the two pushes. Matches the C# bootstrap's `EmitSystemStackEnter(frameSize)` doing `sub rsp, frameSize+8`.
	// ⚠ THE STRIDE IS `SpillSlotBytes` — the SAME constant `win64OutgoingArgDisp` places the ISEL's arg stores
	// with (StdToX64Conversion). The copy below must read and write the exact addresses that rule computed, so
	// the two ends are ONE number. It used to be `GtArgSlotBytes`, the async ARGUMENT-BUFFER stride, which is a
	// different fact that merely happens to be 8 — the confusion `StackWordBytes`/`XmmSaveSlotBytes` were split
	// out to end (GtRuntime.maxon, X64PrologueEpilogue.maxon), surviving here because the shim was not swept.
	// Widen the outgoing-arg grid and the shim now follows it; under the old spelling it silently would not,
	// copying from and to slots the isel never wrote and handing the kernel garbage stack arguments.
	// ⚠ **DELIBERATELY NOT `win64OutgoingArgDisp(stackArgWords)`, THOUGH THE ARITHMETIC IS IDENTICAL.** This is
	// a frame SIZE — how many bytes the shim must reserve — and that function answers a DISPLACEMENT, where one
	// named slot begins. They coincide today because the frame ends exactly where the next slot would start, and
	// folding them would make a size and an address one expression on the strength of a coincidence. That is the
	// error 7a's review found one function away, where `GtArgSlotBytes` and `SpillSlotBytes` were two facts
	// sharing the number 8 — and it is the error this rung exists to remove, not to commit in reverse. Both
	// derive from the same two constants, which is the part that has to be true.
	let frameSize = alignUp(ShadowSpaceBytes + (stackArgWords * SpillSlotBytes), alignment: StackFrameAlignment)
	let reserve = frameSize + ShimPushedWordBytes

	var shimFixups = ChunkRel32FixupArray.create()
	var shimLabels = BlockOffsetTable.create()

	// Guard: no scheduler yet (currentGt == 0) or GT0/main thread (stackBase == 0) → run the call directly.
	encodeLeaRegGlobal(code, rdataRelocs: rdataRelocs, dest: ShimGtReg, label: GtCurrentGtLabel)
	encodeLoadRegBaseDisp(code, destReg: ShimGtReg, base: ShimGtReg, disp: 0, wide: true)
	encodeRmRegDirect(code, opcode: OpcodeTestRmReg, dest: ShimGtReg, src: ShimGtReg, wide: true)
	encodeJcc(code, rel32Fixups: shimFixups, cond: X64CondCode.equal, targetBlockId: ShimDirectLabel)
	encodeLoadRegBaseDisp(code, destReg: ShimGtReg, base: ShimGtReg, disp: GtOffStackBase as Imm32, wide: true)
	encodeRmRegDirect(code, opcode: OpcodeTestRmReg, dest: ShimGtReg, src: ShimGtReg, wide: true)
	encodeJcc(code, rel32Fixups: shimFixups, cond: X64CondCode.equal, targetBlockId: ShimDirectLabel)

	// Switch RSP to the system stack. r10 = the GT rsp anchor (points at the pushed caller-r10 word); rax holds
	// the system-stack top through the copy and the TIB repoint below.
	encodePushReg(code, reg: ShimGtRspReg)
	encodeRmRegDirect(code, opcode: OpcodeMovRmReg, dest: ShimGtRspReg, src: X64Register.rsp, wide: true)
	encodeLeaRegGlobal(code, rdataRelocs: rdataRelocs, dest: X64Register.rax, label: GtSystemStackTopLabel)
	encodeLoadRegBaseDisp(code, destReg: X64Register.rax, base: X64Register.rax, disp: 0, wide: true)
	encodeRmRegDirect(code, opcode: OpcodeMovRmReg, dest: X64Register.rsp, src: X64Register.rax, wide: true)
	encodePushReg(code, reg: ShimGtRspReg)
	// sub rsp, reserve — the outgoing-arg frame on the system stack. Shadow space plus one import's
	// stack-argument words (`gtShimStackArgWords`, seven at the widest), so it is well inside one
	// page; r11 is LIVE across it (currentGt, reloaded from below after the call), hence no
	// certificate — a shim whose reservation ever reached a page would panic rather than eat it.
	encodePrologue(code, stackSize: reserve, probeScratchIsFree: false)

	// Copy the N true stack args from the GT frame (`[r10 + 8 + 0x20 + k*8]`, the anchor being 8 below the GT
	// rsp) to the system stack (`[rsp + 0x20 + k*8]`), so the kernel reads its args from where it runs.
	for k in 0 upto stackArgWords 'copyArg'
		// Both ends ask `win64OutgoingArgDisp` — the SAME rule the ISEL placed these words by — so the copy
		// cannot address a different slot than the store did. The source adds only `ShimPushedWordBytes`,
		// because the GT-frame anchor sits one pushed word below the GT rsp; that is a property of THIS shim's
		// prologue and not of the arg layout, which is why it is the one term added here rather than folded in.
		let dstDisp = win64OutgoingArgDisp(k)
		let srcDisp = (ShimPushedWordBytes + (dstDisp as StackSize)) as Imm32
		encodeLoadRegBaseDisp(code, destReg: ShimGtReg, base: ShimGtRspReg, disp: srcDisp, wide: true)
		encodeStoreBaseDispReg(code, base: X64Register.rsp, disp: dstDisp, srcReg: ShimGtReg)
	end 'copyArg'

	// Repoint the TIB at the system stack for the call (rax = system-stack top, destroyed here — it is dead
	// before the call, which clobbers the caller-saved rax anyway).
	emitRepointTibToSystemStack(code, topReg: X64Register.rax)

	encodeIatCall(code, iatRelocs: iatRelocs, slotIndex: slotIndex)

	// Restore the TIB to this GT's own bounds. Reload currentGt (the call clobbered r11) and use rcx as scratch,
	// so rax — the kernel call's result, read by the op after the shim — survives. The restore IS a TIB-from-GT
	// load, the same operation the context switch does on switch-in.
	encodeLeaRegGlobal(code, rdataRelocs: rdataRelocs, dest: ShimGtReg, label: GtCurrentGtLabel)
	encodeLoadRegBaseDisp(code, destReg: ShimGtReg, base: ShimGtReg, disp: 0, wide: true)
	emitLoadTibFromGt(code, gtReg: ShimGtReg, scratch: ShimTibScratchReg)

	// Switch RSP back to the GT stack, restore the caller's r10, and skip the direct-call path.
	encodeEpilogue(code, stackSize: reserve)  // add rsp, reserve
	encodePopReg(code, reg: ShimGtRspReg)  // r10 = the saved GT rsp (points at the pushed caller-r10)
	encodeRmRegDirect(code, opcode: OpcodeMovRmReg, dest: X64Register.rsp, src: ShimGtRspReg, wide: true)
	encodePopReg(code, reg: ShimGtRspReg)  // restore the caller's r10
	encodeJmp(code, rel32Fixups: shimFixups, targetBlockId: ShimDoneLabel)

	// direct: the non-switched call (main thread / no scheduler).
	shimLabels.place(ShimDirectLabel, value: code.count())
	encodeIatCall(code, iatRelocs: iatRelocs, slotIndex: slotIndex)

	// done: patch the shim's own forward branches now that both labels' offsets are known.
	shimLabels.place(ShimDoneLabel, value: code.count())
	resolveChunkRel32Fixups(code, labelOffsets: shimLabels, rel32Fixups: shimFixups)
end 'emitGtShimmedIatCall'

// --- The relocating stack GROWER (P1.5-B1a′ slice 2) ---
//
// ⭐ THE HIGHEST-RISK PIECE IN THE LADDER: a chain-walk bug is a silent stack-corruption use-after-free. Ported
// line-by-line from v1 `maxon-selfhosted/Compiler/Targets/X64/X64Backend.maxon:7102` (`emitX64GtMorestack`) and
// its walk `:7226` (`emitX64GtMorestackWalkBody`), adapted to shv2's single-M model and register discipline.
//
// SOUNDNESS (established, do not re-derive): shv2 has NO addressable stack slots — the spiller spills VALUES
// rsp-relative (never a stack pointer), rbp is non-allocatable and used ONLY as the saved-rbp chain link, and
// the only address-producing ops name non-stack sections. So the ONLY stack→stack pointers are (a) the saved-rbp
// chain links and (b) `gt.sp`/`gt.fp` in the heap GT struct; return addresses point into `.text` (unmoved).
// ⇒ Relocation = copy the stack + rebase the live rbp + WALK the saved-rbp chain adding the relocation offset to
// each interior link. Complete and sound — this is what frame-pointers-on-every-function was paid for. x64 does
// NOT fix `gt.sp`/`gt.fp` (they are stale-but-overwritten on the next context switch; only arm64 would).
//
// ENTRY CONTRACT (from the prologue guard): r11 = the current GT, r10 = the system-stack top (both non-arg
// scratch the guard loaded, so this chunk needs no `.data` of its own for them), rsp = the GT stack pointing at
// the return address the guard's `call` pushed. Everything it saves goes on the SYSTEM stack, so the tiny GT
// stack the guard is protecting never holds this frame, and it returns onto the RELOCATED (2x) stack.
//
// ⭐⭐ WHAT IT PRESERVES, AND WHY THAT SET AND NOT ANOTHER. The guard is emitted at offset 0 of the entry block
// — BEFORE `push rbp` and before the `param` captures (X64Backend.emitFunctionChunk) — so when it `call`s here
// the guarded function has established NOTHING yet: every incoming argument is still in its ABI register, and
// every callee-saved register still holds its CALLER's value. What must be saved is therefore
// (live at a function entry) ∩ (destroyed by this chunk or its callees):
//   • GPRs — the six integer arg registers, the five callee-saved whose caller values are unpushed, rbp (the
//     chain link) and r8: `morestackSavedGprOrder`, all thirteen, because this chunk's own body uses rbx/r12-r15
//     as its working registers and rax/rcx/rdx/rsi/rdi/r8/r9 as VirtualAlloc/VirtualFree argument registers.
//   • XMMs — the six FP ARGUMENT registers, `argFpRegisters` (xmm0-5). This chunk emits no SSE instruction at
//     all, but VirtualAlloc and VirtualFree are ordinary Win64 callees and xmm0-5 are Win64-VOLATILE, so they
//     come back destroyed. xmm6-15 need no save for the mirror-image reason: Win64 obliges kernel32 to preserve
//     them, which is the same guarantee `iatCall`'s clobber mask already rests on for every register-allocated
//     function in the program.
//
// ⚠⚠ THE XMM HALF WAS MISSING UNTIL THIS COMMIT, AND IT WAS A SILENT WRONG ANSWER, NOT A CRASH: a float
// PARAMETER of any function deep enough to trip the guard read 0 from that call downwards, on the green thread
// only. `specs-shv2/async-scheduler.md`'s `a-float-argument-survives-a-stack-grow` /
// `every-fp-argument-register-survives-a-stack-grow` are the two RUNS that say so — no golden fragment covers a
// hand-assembled chunk, and the sync form of the same program is correct because nothing grows a non-GT stack.

// The GPRs `__gt_morestack` saves on the system stack, in PUSH order (pop = reverse). v1's exact 13-register set
// (`X64Backend.maxon:7113`), a SUPERSET of everything live at a shv2 prologue: the six arg registers
// [rcx, rdx, rax, r9, rsi, rdi], the five callee-saved [rbx, r12-r15] whose CALLER values the guarded function
// has not yet pushed, and rbp (the chain link) + r8 (harmless to save). rbp MUST be first: its saved slot is read
// back by a fixed displacement to write the rebased live rbp (see `savedRbpDisp` in `buildGtMorestackChunk`).
let morestackSavedGprOrder = [X64Register.rbp, X64Register.rbx, X64Register.r12, X64Register.r13, X64Register.r14, X64Register.r15, X64Register.rcx, X64Register.rdx, X64Register.r8, X64Register.r9, X64Register.rsi, X64Register.rdi, X64Register.rax]

// The bytes `__gt_morestack` reserves below its GPR pushes: the Win64 shadow space its VirtualAlloc/VirtualFree
// calls owe their callees, plus one `XmmSaveSlotBytes` slot per FP argument register ABOVE it.
//
// ABOVE, and that ordering is the same one `spillSlotBaseDisp` decides for a register-allocated frame: a callee
// may freely clobber its caller's 32-byte shadow space, so a float parked inside it would be destroyed by the
// very call it is being saved across.
function gtMorestackFrameBytes() returns StackSize
	return ShadowSpaceBytes + (argFpRegisters.count() * XmmSaveSlotBytes)
end 'gtMorestackFrameBytes'

// The rsp displacement of FP argument slot `k` inside that frame — spelled once so the save and the restore
// cannot disagree, which for a hand-assembled chunk is the difference between a preserved float and a wild one.
function gtMorestackXmmSlotDisp(k RegCount) returns Imm32
	return (ShadowSpaceBytes + (k * XmmSaveSlotBytes)) as Imm32
end 'gtMorestackXmmSlotDisp'

// The ferried entry-rsp word sits one machine word below the system-stack top (`[systemStackTop - 8]`), and rsp
// is positioned there before the pushes begin.
let MorestackFerryDisp = (0 - StackWordBytes) as Imm32

// The `+8 rsp` that skips the ferried entry-rsp slot after the GPR pops, before switching to the new GT stack.
let MorestackFerrySkipBytes = StackWordBytes as Imm32

// The two frame-slot displacements are DERIVED from the saved-register count at build time (`morestackSavedGprOrder`
// is a runtime array, so its `.count()` cannot appear in a top-level `let`) — see `buildGtMorestackChunk`.

// The walk's own forward/backward branch targets, resolved against a WALK-LOCAL fixup list + offset map (the same
// machinery the shim and the block assembler use), scoped so the ids never collide with anything else.
let WalkHeadLabel = 0 as BlockId
let WalkNextLabel = 1 as BlockId
let WalkDoneLabel = 2 as BlockId

// The guard's single forward target (its two `skip` jumps), in a GUARD-LOCAL map — never collides with the
// enclosing function's block ids (the guard resolves against its own map before the function's blocks emit).
let GuardSkipLabel = 0 as BlockId

// The live-rbp rebase's single forward skip target (`__gt_morestack` step 7), in its OWN local map resolved
// before the chain walk — distinct from `WalkDoneLabel` so the two label scopes never read as one.
let RbpAdjustSkipLabel = 0 as BlockId

// The registers `__gt_morestack`'s body holds its persistent values in — all callee-saved (so they are among the
// 13 GPRs saved on the system stack) plus rax for the relocation offset, mirroring v1's assignment. Named so the
// steps read as data flow rather than raw register letters.
let GtMoreGtReg = X64Register.rbx  // the current GT (moved from r11 after the pushes)
let GtMoreOldBaseReg = X64Register.r12  // old stack base
let GtMoreOldSizeReg = X64Register.r13  // old stack size
let GtMoreNewSizeReg = X64Register.r14  // new stack size = old * 2
let GtMoreNewBaseReg = X64Register.r15  // new stack base (VirtualAlloc result)
let GtMoreOffsetReg = X64Register.rax  // the relocation offset = new_top - old_top

// The string-copy opcodes `__gt_morestack`'s memcpy uses — `cld` (clear DF, so `movsb` ascends), then the
// `rep movsb` pair (F3 prefix + A4). Nothing else in shv2 emits a string op, so they live here rather than in the
// shared opcode table.
let OpcodeCld = 0xFC
let OpcodeRepPrefix = 0xF3
let OpcodeMovsb = 0xA4

// `__gt_morestack` — grow the current GT's stack to 2x, copy the old stack to the TOP of the new one, rebase the
// saved-rbp chain + the entry rsp by the relocation offset, update the GT struct + TIB, free the old stack, and
// `ret` onto the new (larger) stack so the prologue guard that called us now passes. All of it runs on the system
// stack (entered r10 = system-stack top), so the near-overflow GT stack never holds this frame.
function buildGtMorestackChunk() returns FunctionCodeChunk
	var code = ByteArray.create()
	var iatRelocs = RelocationArray.create()

	// Two frame slots are read back by fixed displacement, both DERIVED from the saved-register count and the
	// frame size so a change to `morestackSavedGprOrder` or to the FP save area cannot leave a stale magic offset:
	//   • the rebased LIVE rbp is written to rbp's saved slot BEFORE the frame is released — the whole frame plus
	//     the `count-1` words below rbp (rbp is the FIRST push, so it is the top saved GPR).
	//   • the ferried ENTRY rsp is read AFTER the frame is released — `count` words above the post-release rsp.
	let savedGprCount = morestackSavedGprOrder.count()
	let frameBytes = gtMorestackFrameBytes()
	let savedRbpDisp = (frameBytes + ((savedGprCount - 1) * StackWordBytes)) as Imm32
	let entryRspDisp = (savedGprCount * StackWordBytes) as Imm32

	// ⭐ 16-byte alignment at the VirtualAlloc/VirtualFree calls, enforced so a future register added to
	// `morestackSavedGprOrder` — or a change to the FP save area's size — cannot silently break it (feedback:
	// DERIVE > CHECK > COMMENT). The ferry sets rsp to `systemStackTop - 8` (the top is 16-aligned, so rsp ≡ 8),
	// then `savedGprCount` pushes and the `sub rsp, frameBytes` move it further, so rsp lands 16-aligned at the
	// calls iff those two together are a whole number of 16-byte units. A misalignment is a crash inside
	// kernel32's SSE, arbitrarily far from the cause — so it is a compile-time panic here.
	//
	// ⚠ IT COUNTS THE RESERVATION, NOT JUST THE PUSHES. It used to test `1 + savedGprCount` alone, which was
	// sufficient only while the reservation was `ShadowSpaceBytes` and therefore always a multiple of 16. The
	// FP save area made the reservation VARIABLE — six 8-byte slots today, and an odd count would flip the
	// residue — so a check over the half that did not change would have read as protection while covering
	// nothing (the lesson `assertGtFrameConsistent` above records).
	let stackedWordBytes = (1 + savedGprCount) * StackWordBytes
	if (stackedWordBytes + frameBytes) mod StackFrameAlignment != 0 'alignment'
		panic("__gt_morestack misaligned: 1 ferried word + {savedGprCount} saved GPRs = {stackedWordBytes} bytes, plus a {frameBytes}-byte frame ({ShadowSpaceBytes} shadow + {argFpRegisters.count()} FP argument slots) = {stackedWordBytes + frameBytes}, which is not a multiple of {StackFrameAlignment} — rsp must be 16-aligned at the VirtualAlloc/VirtualFree calls. Restore the parity when changing morestackSavedGprOrder or the FP save area.")
	end 'alignment'

	// Step 1: switch to the system stack, ferrying the GT entry rsp (rsp on entry — the guard's return-addr slot)
	// as the top word of the system-stack frame. `[r10 - 8] = entryRsp` then `rsp = r10 - 8`. r11 = gt and
	// r10 = systemStackTop both survive (neither the store, the lea, nor the pushes below touch them).
	encodeStoreBaseDispReg(code, base: ShimGtRspReg, disp: MorestackFerryDisp, srcReg: X64Register.rsp)  // [r10-8] = entryRsp
	encodeLeaRegRegImm32(code, dest: X64Register.rsp, base: ShimGtRspReg, disp: MorestackFerryDisp)  // rsp = r10 - 8

	// Step 2: save the 13 GPRs, then reserve the frame — shadow space + the FP-argument save area — and write
	// the six FP argument registers into it. rsp lands 16-aligned at the calls below (asserted above).
	//
	// ⭐ THE XMM HALF IS NOT SYMMETRY FOR ITS OWN SAKE. `argFpRegisters` hold this function's incoming FLOAT
	// arguments (the guard runs before the `param` captures), and the two kernel calls below destroy exactly
	// them — see this chunk's ENTRY CONTRACT. Reading `argFpRegisters` rather than spelling xmm0-5 again is the
	// point: the ABI's FP argument file is stated once, in StdToX64Conversion, and a second copy here could only
	// ever drift into a float that silently reads 0.
	for reg in morestackSavedGprOrder 'push'
		encodePushReg(code, reg: reg)
	end 'push'
	// Shadow space + one slot per FP argument register — asserted 16-aligned above and far inside a
	// page. r11 still carries `gt` here (moved to rbx on the next line), so no certificate.
	encodePrologue(code, stackSize: frameBytes, probeScratchIsFree: false)
	for k in 0 upto argFpRegisters.count() 'saveXmm'
		let reg = try argFpRegisters.get(k) otherwise panic("buildGtMorestackChunk: save index derived from count is in range")
		encodeMovsdBaseDispReg(code, base: X64Register.rsp, disp: gtMorestackXmmSlotDisp(k as RegCount), srcReg: reg)
	end 'saveXmm'

	// gt is still in r11 (nothing above clobbered it) — move it to rbx for the body, freeing r11 for the walk.
	encodeRmRegDirect(code, opcode: OpcodeMovRmReg, dest: GtMoreGtReg, src: ShimGtReg, wide: true)  // rbx = gt

	// Step 3: repoint the TIB at the system stack for THIS routine's own VirtualAlloc/VirtualFree (r10 =
	// systemStackTop still). r10 is CONSUMED here — it is dead until the walk (step 8) clobbers it and step 12
	// reloads it, so the shared helper may destroy it rather than spend a scratch register preserving it.
	emitRepointTibToSystemStack(code, topReg: ShimGtRspReg)  // gs:[0x08] = top ; gs:[0x10] = top - size

	// Step 4: r12 = old_base ; r13 = old_size ; r14 = new_size = old_size * 2.
	encodeLoadRegBaseDisp(code, destReg: GtMoreOldBaseReg, base: GtMoreGtReg, disp: GtOffStackBase as Imm32, wide: true)
	encodeLoadRegBaseDisp(code, destReg: GtMoreOldSizeReg, base: GtMoreGtReg, disp: GtOffStackSize as Imm32, wide: true)
	encodeRmRegDirect(code, opcode: OpcodeMovRmReg, dest: GtMoreNewSizeReg, src: GtMoreOldSizeReg, wide: true)
	encodeRmRegDirect(code, opcode: OpcodeAddRmReg, dest: GtMoreNewSizeReg, src: GtMoreNewSizeReg, wide: true)  // r14 += r14

	// Step 5: new_base = VirtualAlloc(NULL, new_size, MEM_COMMIT|MEM_RESERVE, PAGE_READWRITE) ; r15 = new_base.
	encodeRmRegDirect(code, opcode: OpcodeXorRmReg, dest: X64Register.rcx, src: X64Register.rcx, wide: true)  // lpAddress = NULL
	encodeRmRegDirect(code, opcode: OpcodeMovRmReg, dest: X64Register.rdx, src: GtMoreNewSizeReg, wide: true)  // dwSize = new_size
	encodeMovRegImm32(code, dest: X64Register.r8, value: VirtualAllocCommitAndReserve)
	encodeMovRegImm32(code, dest: X64Register.r9, value: VirtualAllocPageReadWrite)
	encodeIatCall(code, iatRelocs: iatRelocs, slotIndex: iatSlotIndex(IatSlot.VirtualAlloc))
	encodeRmRegDirect(code, opcode: OpcodeMovRmReg, dest: GtMoreNewBaseReg, src: X64Register.rax, wide: true)  // r15 = new_base

	// Step 6: memcpy old → TOP of new. rdi = new_base + new_size - old_size (dst top), rsi = old_base, rcx = old_size.
	code.push(OpcodeCld)
	encodeRmRegDirect(code, opcode: OpcodeMovRmReg, dest: X64Register.rdi, src: GtMoreNewBaseReg, wide: true)
	encodeRmRegDirect(code, opcode: OpcodeAddRmReg, dest: X64Register.rdi, src: GtMoreNewSizeReg, wide: true)
	encodeRmRegDirect(code, opcode: OpcodeSubRmReg, dest: X64Register.rdi, src: GtMoreOldSizeReg, wide: true)
	encodeRmRegDirect(code, opcode: OpcodeMovRmReg, dest: X64Register.rsi, src: GtMoreOldBaseReg, wide: true)
	encodeRmRegDirect(code, opcode: OpcodeMovRmReg, dest: X64Register.rcx, src: GtMoreOldSizeReg, wide: true)
	code.push(OpcodeRepPrefix)
	code.push(OpcodeMovsb)

	// Step 7: offset (rax) = new_top - old_top = (r15 + r14) - (r12 + r13).
	encodeRmRegDirect(code, opcode: OpcodeMovRmReg, dest: GtMoreOffsetReg, src: GtMoreNewBaseReg, wide: true)
	encodeRmRegDirect(code, opcode: OpcodeAddRmReg, dest: GtMoreOffsetReg, src: GtMoreNewSizeReg, wide: true)
	encodeRmRegDirect(code, opcode: OpcodeSubRmReg, dest: GtMoreOffsetReg, src: GtMoreOldSizeReg, wide: true)
	encodeRmRegDirect(code, opcode: OpcodeSubRmReg, dest: GtMoreOffsetReg, src: GtMoreOldBaseReg, wide: true)

	// Rebase the LIVE rbp iff it is inside [old_base, old_top), then write it back to its saved slot so the pop
	// restores the relocated value. rcx = old_top for the upper-bound compare.
	var rbpFixups = ChunkRel32FixupArray.create()
	var rbpLabels = BlockOffsetTable.create()
	encodeRmRegDirect(code, opcode: OpcodeMovRmReg, dest: X64Register.rcx, src: GtMoreOldBaseReg, wide: true)
	encodeRmRegDirect(code, opcode: OpcodeAddRmReg, dest: X64Register.rcx, src: GtMoreOldSizeReg, wide: true)  // rcx = old_top
	encodeRmRegDirect(code, opcode: OpcodeCmpRmReg, dest: X64Register.rbp, src: GtMoreOldBaseReg, wide: true)  // rbp - old_base
	encodeJcc(code, rel32Fixups: rbpFixups, cond: X64CondCode.below, targetBlockId: RbpAdjustSkipLabel)  // rbp < old_base → skip
	encodeRmRegDirect(code, opcode: OpcodeCmpRmReg, dest: X64Register.rbp, src: X64Register.rcx, wide: true)  // rbp - old_top
	encodeJcc(code, rel32Fixups: rbpFixups, cond: X64CondCode.aboveEqual, targetBlockId: RbpAdjustSkipLabel)  // rbp >= old_top → skip
	encodeRmRegDirect(code, opcode: OpcodeAddRmReg, dest: X64Register.rbp, src: GtMoreOffsetReg, wide: true)  // rbp += offset
	rbpLabels.place(RbpAdjustSkipLabel, value: code.count())
	resolveChunkRel32Fixups(code, labelOffsets: rbpLabels, rel32Fixups: rbpFixups)
	encodeStoreBaseDispReg(code, base: X64Register.rsp, disp: savedRbpDisp, srcReg: X64Register.rbp)  // [rsp+rbpSlot] = rbp

	// Step 8: walk the saved-rbp chain on the new stack, adjusting each interior link. rcx = walker (= rbp),
	// r8 = new_low, r9 = new_high, rax = offset, r12 = old_base, r13 = old_size (all live for the walk body).
	encodeRmRegDirect(code, opcode: OpcodeMovRmReg, dest: X64Register.rcx, src: X64Register.rbp, wide: true)
	encodeRmRegDirect(code, opcode: OpcodeMovRmReg, dest: X64Register.r8, src: GtMoreNewBaseReg, wide: true)
	encodeRmRegDirect(code, opcode: OpcodeAddRmReg, dest: X64Register.r8, src: GtMoreNewSizeReg, wide: true)
	encodeRmRegDirect(code, opcode: OpcodeSubRmReg, dest: X64Register.r8, src: GtMoreOldSizeReg, wide: true)  // r8 = new_low
	encodeRmRegDirect(code, opcode: OpcodeMovRmReg, dest: X64Register.r9, src: GtMoreNewBaseReg, wide: true)
	encodeRmRegDirect(code, opcode: OpcodeAddRmReg, dest: X64Register.r9, src: GtMoreNewSizeReg, wide: true)  // r9 = new_high
	emitGtMorestackChainWalk(code)

	// Step 9: update the GT struct + TIB for the new stack. stackBase = r15, stackSize = r14,
	// stackGuard = new_base + margin, tib_base = new_top, tib_limit = new_base.
	encodeStoreBaseDispReg(code, base: GtMoreGtReg, disp: GtOffStackBase as Imm32, srcReg: GtMoreNewBaseReg)
	encodeStoreBaseDispReg(code, base: GtMoreGtReg, disp: GtOffStackSize as Imm32, srcReg: GtMoreNewSizeReg)
	encodeRmRegDirect(code, opcode: OpcodeMovRmReg, dest: X64Register.rcx, src: GtMoreNewBaseReg, wide: true)
	encodeGrp1RegImm32(code, ext: Grp1ExtAdd, reg: X64Register.rcx, imm: GtStackGuardMargin as Imm32)  // rcx = new_base + margin
	encodeStoreBaseDispReg(code, base: GtMoreGtReg, disp: GtOffStackGuard as Imm32, srcReg: X64Register.rcx)
	encodeRmRegDirect(code, opcode: OpcodeMovRmReg, dest: X64Register.rcx, src: GtMoreNewBaseReg, wide: true)
	encodeRmRegDirect(code, opcode: OpcodeAddRmReg, dest: X64Register.rcx, src: GtMoreNewSizeReg, wide: true)  // rcx = new_top
	encodeStoreBaseDispReg(code, base: GtMoreGtReg, disp: GtOffTibStackBase as Imm32, srcReg: X64Register.rcx)
	encodeStoreBaseDispReg(code, base: GtMoreGtReg, disp: GtOffTibStackLimit as Imm32, srcReg: GtMoreNewBaseReg)

	// Step 10: VirtualFree(old_base, 0, MEM_RELEASE). Stash the offset in rbp across the call (rbp's live value is
	// already saved at its stack slot, so the register is free scratch), restore it to rax afterwards. The TIB
	// still describes the system stack (set in step 3) and rsp is still on it, so this kernel call is consistent.
	encodeRmRegDirect(code, opcode: OpcodeMovRmReg, dest: X64Register.rbp, src: GtMoreOffsetReg, wide: true)  // rbp = offset (stash)
	encodeRmRegDirect(code, opcode: OpcodeMovRmReg, dest: X64Register.rcx, src: GtMoreOldBaseReg, wide: true)  // lpAddress = old_base
	encodeMovRegImm32(code, dest: X64Register.rdx, value: VirtualFreeSizeMustBeZero)  // dwSize = 0
	encodeMovRegImm32(code, dest: X64Register.r8, value: VirtualFreeMemRelease)  // dwFreeType = MEM_RELEASE
	encodeIatCall(code, iatRelocs: iatRelocs, slotIndex: iatSlotIndex(IatSlot.VirtualFree))
	encodeRmRegDirect(code, opcode: OpcodeMovRmReg, dest: GtMoreOffsetReg, src: X64Register.rbp, wide: true)  // rax = offset (restore)

	// Step 11: set the TIB to the NEW GT-stack bounds (reuse the slice-1 helper, reading the struct fields step 9
	// wrote) BEFORE we pop rbx=gt. rcx is free scratch. After this, gs:[] describes the stack we return onto.
	emitLoadTibFromGt(code, gtReg: GtMoreGtReg, scratch: X64Register.rcx)

	// Step 12: tear down + return onto the RELOCATED GT stack. new GT rsp = entry rsp (ferried) + offset.
	// The FP argument registers come back FIRST, while their slots are still inside the reserved frame — and
	// after the last kernel call (step 10's VirtualFree), which is the call that destroyed them. `movsd` touches
	// no GPR, so the offset in rax and the GT in rbx are untouched by this loop.
	for k in 0 upto argFpRegisters.count() 'restoreXmm'
		let reg = try argFpRegisters.get(k) otherwise panic("buildGtMorestackChunk: restore index derived from count is in range")
		encodeMovsdRegBaseDisp(code, destReg: reg, base: X64Register.rsp, disp: gtMorestackXmmSlotDisp(k as RegCount))
	end 'restoreXmm'
	encodeEpilogue(code, stackSize: frameBytes)  // add rsp, shadow + FP save area
	encodeLoadRegBaseDisp(code, destReg: ShimGtRspReg, base: X64Register.rsp, disp: entryRspDisp, wide: true)  // r10 = entryRsp
	encodeRmRegDirect(code, opcode: OpcodeAddRmReg, dest: ShimGtRspReg, src: GtMoreOffsetReg, wide: true)  // r10 += offset
	for i in 0 upto morestackSavedGprOrder.count() 'pop'
		let reg = try morestackSavedGprOrder.get(morestackSavedGprOrder.count() - 1 - i) otherwise panic("buildGtMorestackChunk: pop index derived from count is in range")
		encodePopReg(code, reg: reg)
	end 'pop'
	encodeGrp1RegImm32(code, ext: Grp1ExtAdd, reg: X64Register.rsp, imm: MorestackFerrySkipBytes)  // add rsp, 8 (skip ferried slot)
	encodeRmRegDirect(code, opcode: OpcodeMovRmReg, dest: X64Register.rsp, src: ShimGtRspReg, wide: true)  // rsp = relocated GT rsp
	code.push(OpcodeRet)  // ret into the copied return address, now on the new stack

	return FunctionCodeChunk.createWith(GtMorestackName, code: code, callFixups: CallFixupArray.create(), rdataRelocs: RdataRelocationArray.create(), iatRelocs: iatRelocs, rdataConstants: GlobalDataTable.create())
end 'buildGtMorestackChunk'

// The saved-rbp chain walk (P1.5-B1a′), ported from v1 `emitX64GtMorestackWalkBody` (:7226). Entered with
// rcx = walker (the rebased live rbp), r8 = new_low, r9 = new_high, rax = offset, r12 = old_base, r13 = old_size;
// clobbers rcx (walker) and r10/r11 (temps). For each frame whose rbp slot is in [old_base, old_top), it adds the
// relocation offset — so `[rbp]` links that pointed into the OLD stack now point into the copied NEW stack — then
// follows the (now-adjusted) link to the next frame. Terminates when the walker leaves [new_low, new_high) or hits
// a null/foreign saved rbp (the trampoline boundary, whose rbp is 0). This is the correctness crux; the branch
// targets resolve against a WALK-LOCAL fixup list so they never collide with the enclosing chunk's ids.
function emitGtMorestackChainWalk(code ByteArray)
	var walkFixups = ChunkRel32FixupArray.create()
	var walkLabels = BlockOffsetTable.create()

	// L_head: stop if the walker is null or outside the new stack; else load the saved rbp at [walker].
	walkLabels.place(WalkHeadLabel, value: code.count())
	encodeRmRegDirect(code, opcode: OpcodeTestRmReg, dest: X64Register.rcx, src: X64Register.rcx, wide: true)
	encodeJcc(code, rel32Fixups: walkFixups, cond: X64CondCode.equal, targetBlockId: WalkDoneLabel)  // jz done
	encodeRmRegDirect(code, opcode: OpcodeCmpRmReg, dest: X64Register.rcx, src: X64Register.r8, wide: true)  // walker - new_low
	encodeJcc(code, rel32Fixups: walkFixups, cond: X64CondCode.below, targetBlockId: WalkDoneLabel)  // jb done
	encodeRmRegDirect(code, opcode: OpcodeCmpRmReg, dest: X64Register.rcx, src: X64Register.r9, wide: true)  // walker - new_high
	encodeJcc(code, rel32Fixups: walkFixups, cond: X64CondCode.aboveEqual, targetBlockId: WalkDoneLabel)  // jae done
	encodeLoadRegBaseDisp(code, destReg: X64Register.r11, base: X64Register.rcx, disp: 0, wide: true)  // r11 = saved_rbp = [walker]

	// Adjust the saved rbp iff it points into [old_base, old_top); else leave it (a foreign/boundary link).
	encodeRmRegDirect(code, opcode: OpcodeCmpRmReg, dest: X64Register.r11, src: GtMoreOldBaseReg, wide: true)  // saved - old_base
	encodeJcc(code, rel32Fixups: walkFixups, cond: X64CondCode.below, targetBlockId: WalkNextLabel)  // jb next (below old_base)
	encodeRmRegDirect(code, opcode: OpcodeMovRmReg, dest: X64Register.r10, src: GtMoreOldBaseReg, wide: true)
	encodeRmRegDirect(code, opcode: OpcodeAddRmReg, dest: X64Register.r10, src: GtMoreOldSizeReg, wide: true)  // r10 = old_top
	encodeRmRegDirect(code, opcode: OpcodeCmpRmReg, dest: X64Register.r11, src: X64Register.r10, wide: true)  // saved - old_top
	encodeJcc(code, rel32Fixups: walkFixups, cond: X64CondCode.aboveEqual, targetBlockId: WalkNextLabel)  // jae next (>= old_top)
	encodeRmRegDirect(code, opcode: OpcodeAddRmReg, dest: X64Register.r11, src: GtMoreOffsetReg, wide: true)  // saved += offset
	encodeStoreBaseDispReg(code, base: X64Register.rcx, disp: 0, srcReg: X64Register.r11)  // [walker] = adjusted saved

	// L_next: advance to the next frame via the (possibly adjusted) link, then loop.
	walkLabels.place(WalkNextLabel, value: code.count())
	encodeLoadRegBaseDisp(code, destReg: X64Register.rcx, base: X64Register.rcx, disp: 0, wide: true)  // walker = [walker]
	encodeJmp(code, rel32Fixups: walkFixups, targetBlockId: WalkHeadLabel)  // jmp head

	// L_done.
	walkLabels.place(WalkDoneLabel, value: code.count())
	resolveChunkRel32Fixups(code, labelOffsets: walkLabels, rel32Fixups: walkFixups)
end 'emitGtMorestackChainWalk'

// The prologue stack GUARD (P1.5-B1a′), ported from v1 `emitX64GtStackGuard` (:7286). Emitted by X64Backend at the
// very START of a guarded function's entry block — BEFORE `push rbp` — iff the module carries the GT scheduler,
// the function is NOT a runtime (`__`/`mrt_`) function, and it reserves a frame. When the running GT's projected
// rsp would dip below its stack guard, it calls `__gt_morestack` to grow+relocate first; otherwise it is a handful
// of instructions that fall through. A no-op for GT0/main (stackGuard 0 ⇒ `jae` always taken) and off a GT
// entirely (currentGt 0 ⇒ `jz` taken). Clobbers ONLY r10/r11 (volatile, non-arg), so the incoming argument
// registers (rcx/rdx/rax/r9/rsi/rdi) are untouched, and `__gt_morestack` preserves everything.
export function emitGtStackGuard(code ByteArray, callFixups CallFixupArray, rdataRelocs RdataRelocationArray, frameBytes StackSize)
	var guardFixups = ChunkRel32FixupArray.create()
	var guardLabels = BlockOffsetTable.create()

	// r11 = currentGt ; no scheduler yet (0) → skip.
	encodeLeaRegGlobal(code, rdataRelocs: rdataRelocs, dest: ShimGtReg, label: GtCurrentGtLabel)
	encodeLoadRegBaseDisp(code, destReg: ShimGtReg, base: ShimGtReg, disp: 0, wide: true)
	encodeRmRegDirect(code, opcode: OpcodeTestRmReg, dest: ShimGtReg, src: ShimGtReg, wide: true)
	encodeJcc(code, rel32Fixups: guardFixups, cond: X64CondCode.equal, targetBlockId: GuardSkipLabel)

	// projectedRsp (r10) = rsp - (frameBytes + margin) ; enough room (>= stackGuard) → skip.
	encodeRmRegDirect(code, opcode: OpcodeMovRmReg, dest: ShimGtRspReg, src: X64Register.rsp, wide: true)
	encodeGrp1RegImm32(code, ext: Grp1ExtSub, reg: ShimGtRspReg, imm: (frameBytes + (GtStackGuardMargin as StackSize)) as Imm32)
	encodeCmpRegBaseDisp(code, destReg: ShimGtRspReg, base: ShimGtReg, disp: GtOffStackGuard as Imm32)  // projected - stackGuard
	encodeJcc(code, rel32Fixups: guardFixups, cond: X64CondCode.aboveEqual, targetBlockId: GuardSkipLabel)

	// Cold path: r10 = system-stack top (the scratch stack __gt_morestack runs on), then grow.
	encodeLeaRegGlobal(code, rdataRelocs: rdataRelocs, dest: ShimGtRspReg, label: GtSystemStackTopLabel)
	encodeLoadRegBaseDisp(code, destReg: ShimGtRspReg, base: ShimGtRspReg, disp: 0, wide: true)
	encodeCallDirect(code, callFixups: callFixups, targetName: GtMorestackName)

	// skip:
	guardLabels.place(GuardSkipLabel, value: code.count())
	resolveChunkRel32Fixups(code, labelOffsets: guardLabels, rel32Fixups: guardFixups)
end 'emitGtStackGuard'

// Append the three hand-assembled GT chunks — called by BackendDispatch when the module spawns a green thread,
// alongside `appendX64RuntimeChunks` for the panic runtime. They lay out above user code like every other
// runtime chunk, so `mrt_start` stays at `.text` offset 0.

// --- The IOCP completion-drain thread (P1.5 slice 1a-ii) ---
//
// ⭐ A HAND-ASSEMBLED chunk, NOT builder-built Std — like `__gt_context_switch`/`__gt_trampoline`/`__gt_morestack`,
// and for the same reason both references hand-assemble it: it runs OUTSIDE the GT model, on its OWN OS-thread stack,
// so its kernel calls must be DIRECT (never the syscall shim, which would read the main thread's `__gt_current_gt`
// and race the single system stack). A builder-built version would be shimmed and stack-guarded — both wrong here.
//
// `__io_completion_loop(rcx = lpParameter, ignored)` — the Win64 ThreadProc `__io_init` starts with CreateThread.
// It loops: `GetQueuedCompletionStatus` blocks until an overlapped read completes; the completing packet's
// lpOverlapped IS the reading GT's embedded OVERLAPPED, so `gt = lpOverlapped - GtOffOverlapped` (CONTAINING_RECORD).
// It writes the byte count to `gt.io_result`, then — THE HANDSHAKE — SPIN-WAITS on `gt.ioParked == 1` (the reading GT
// sets it only AFTER `status = waiting`, so this ordering guarantees the `status = ready` below lands AFTER the GT's
// own waiting-write: no torn status, no lost wakeup). It sets `status = ready`; for a SPAWNED GT (`stackBase != 0`)
// it re-enqueues under `__io_lock` (the run queue's sole cross-thread mutation); a GT0 self-driver (`stackBase == 0`)
// is left for its own drive loop to notice via `status`. Either way it `SetEvent`s `__io_done_event` to wake the
// netpoll's `WaitForSingleObject`. `__gt_enqueue` is PURE MEMORY (no shim), so calling it from this thread is safe.
//
// gt is spilled to a frame local (not a callee-saved register) and reloaded after each call, mirroring the bootstrap
// (`X86CodeEmitter.Runtime.cs` EmitIoCompletionLoop), which keeps the frame layout — and the 16-byte alignment at
// every `call` — trivial.

// Frame locals (rbp-relative) and the GQCS 5th-argument stack slot (rsp-relative). The frame is 0x50 bytes: with the
// `push rbp` it lands RSP 16-aligned at every `call` (entry RSP ≡ 8 mod 16; push rbp ⇒ 0; sub 0x50 ⇒ 0).
let IoLoopFrameBytes = 0x50 as StackSize
let IoLoopBytesLocalDisp = (0 - 0x08) as Imm32  // lpNumberOfBytesTransferred out-param
let IoLoopKeyLocalDisp = (0 - 0x10) as Imm32  // lpCompletionKey out-param (unused)
let IoLoopOverlappedLocalDisp = (0 - 0x18) as Imm32  // lpOverlapped out-param → the completing GT's OVERLAPPED
let IoLoopGtLocalDisp = (0 - 0x20) as Imm32  // the recovered GT pointer, spilled across the Win32/enqueue calls
let IoLoopInfiniteTimeout = 0xFFFFFFFF  // INFINITE

// The completion loop's own forward/backward branch targets, resolved against a LOOP-LOCAL fixup list + offset map
// (the same machinery the shim and the block assembler use), scoped so the ids never collide with anything else.
let IoLoopTopLabel = 0 as BlockId
let IoLoopSpinLabel = 1 as BlockId
let IoLoopSpunLabel = 2 as BlockId
let IoLoopSignalLabel = 3 as BlockId
let IoLoopExitLabel = 4 as BlockId
let IoLoopAbandonedLabel = 5 as BlockId

// The completion loop's scratch: r11 shuttles a `.data` global's address, rax/rcx are general scratch. None is read
// across the loop's own iterations (gt lives in the frame), so any caller-saved use is invisible.
let IoLoopGlobalPtrReg = X64Register.r11

// Load a `.data` global's VALUE into `dest` — `lea r11, [rip+label] ; mov dest, [r11]`. The completion loop reads
// `__io_iocp`/`__io_lock`/`__io_done_event` this way, through the ordinary rdata-relocation path.
function emitIoLoopLoadGlobal(code ByteArray, rdataRelocs RdataRelocationArray, dest X64Register, label ByteArray)
	encodeLeaRegGlobal(code, rdataRelocs: rdataRelocs, dest: IoLoopGlobalPtrReg, label: label)
	encodeLoadRegBaseDisp(code, destReg: dest, base: IoLoopGlobalPtrReg, disp: 0, wide: true)
end 'emitIoLoopLoadGlobal'

function buildIoCompletionLoopChunk() returns FunctionCodeChunk
	var code = ByteArray.create()
	var callFixups = CallFixupArray.create()
	var iatRelocs = RelocationArray.create()
	var rdataRelocs = RdataRelocationArray.create()
	var loopFixups = ChunkRel32FixupArray.create()
	var loopLabels = BlockOffsetTable.create()

	// Prologue: push rbp ; mov rbp, rsp ; sub rsp, 0x50.
	encodePushReg(code, reg: X64Register.rbp)
	encodeRmRegDirect(code, opcode: OpcodeMovRmReg, dest: X64Register.rbp, src: X64Register.rsp, wide: true)
	encodeGrp1RegImm32(code, ext: Grp1ExtSub, reg: X64Register.rsp, imm: IoLoopFrameBytes as Imm32)

	// loop_top:
	loopLabels.place(IoLoopTopLabel, value: code.count())
	// Zero the bytes slot (GQCS writes only the low DWORD; the runtime reads a full i64).
	encodeMovRegImm32(code, dest: X64Register.rax, value: 0)
	encodeStoreBaseDispReg(code, base: X64Register.rbp, disp: IoLoopBytesLocalDisp, srcReg: X64Register.rax)
	// GetQueuedCompletionStatus(iocp, &bytes, &key, &overlapped, INFINITE).
	emitIoLoopLoadGlobal(code, rdataRelocs: rdataRelocs, dest: X64Register.rcx, label: IoIocpLabel)
	encodeLeaRegRegImm32(code, dest: X64Register.rdx, base: X64Register.rbp, disp: IoLoopBytesLocalDisp)
	encodeLeaRegRegImm32(code, dest: X64Register.r8, base: X64Register.rbp, disp: IoLoopKeyLocalDisp)
	encodeLeaRegRegImm32(code, dest: X64Register.r9, base: X64Register.rbp, disp: IoLoopOverlappedLocalDisp)
	encodeMovRegImm32(code, dest: X64Register.rax, value: IoLoopInfiniteTimeout)
	// `GetQueuedCompletionStatus`'s 5th argument (dwMilliseconds) goes in outgoing stack SLOT 0 of this loop's
	// own frame, so the displacement is `win64OutgoingArgDisp(0)` — the SAME rule the ISEL and the GT shim place
	// their stack arguments by — and not the bare `0x20` it used to be. Asked HERE rather than bound to a global
	// `let`, which may hold no function call. This is also the site that makes 7a's
	// `GetQueuedCompletionStatusStackArgWords` load-bearing: that constant says this import has ONE stack
	// argument, and this is the one place that writes it.
	encodeStoreBaseDispReg(code, base: X64Register.rsp, disp: win64OutgoingArgDisp(0), srcReg: X64Register.rax)
	encodeIatCall(code, iatRelocs: iatRelocs, slotIndex: iatSlotIndex(IatSlot.GetQueuedCompletionStatus))
	// overlapped == NULL → shutdown sentinel → exit (defensive; the slice never posts one).
	encodeLoadRegBaseDisp(code, destReg: X64Register.rax, base: X64Register.rbp, disp: IoLoopOverlappedLocalDisp, wide: true)
	encodeRmRegDirect(code, opcode: OpcodeTestRmReg, dest: X64Register.rax, src: X64Register.rax, wide: true)
	encodeJcc(code, rel32Fixups: loopFixups, cond: X64CondCode.equal, targetBlockId: IoLoopExitLabel)
	// gt = overlapped - GtOffOverlapped ; spill to the frame.
	encodeGrp1RegImm32(code, ext: Grp1ExtSub, reg: X64Register.rax, imm: GtOffOverlapped as Imm32)
	encodeStoreBaseDispReg(code, base: X64Register.rbp, disp: IoLoopGtLocalDisp, srcReg: X64Register.rax)
	// ⭐ LOCK __io_lock, held across the WHOLE decision below — so the completion thread's abandoned-vs-normal
	// branch and the `__gt_promise_drop` IO arm's in-flight-vs-already-fired branch are SERIALIZED, guaranteeing
	// exactly one side frees the GT and neither dereferences it after free. `bytes` is still in [rbp-bytes]; gt in
	// [rbp-gt].
	emitIoLoopLoadGlobal(code, rdataRelocs: rdataRelocs, dest: X64Register.rcx, label: IoLockLabel)
	encodeIatCall(code, iatRelocs: iatRelocs, slotIndex: iatSlotIndex(IatSlot.EnterCriticalSection))

	// spin: wait until gt.ioParked != 0 — the reader committed to parking (state IoParkedInFlight, 1) or the drop
	// arm abandoned it (IoParkedAbandoned, 2). Holding __io_lock does not block the reader (it sets ioParked without
	// the lock), so this cannot deadlock; in practice ioParked is already set (the packet arrives long after park).
	loopLabels.place(IoLoopSpinLabel, value: code.count())
	encodeLoadRegBaseDisp(code, destReg: X64Register.rax, base: X64Register.rbp, disp: IoLoopGtLocalDisp, wide: true)
	encodeLoadRegBaseDisp(code, destReg: X64Register.rcx, base: X64Register.rax, disp: GtOffIoParked as Imm32, wide: true)
	encodeRmRegDirect(code, opcode: OpcodeTestRmReg, dest: X64Register.rcx, src: X64Register.rcx, wide: true)
	encodeJcc(code, rel32Fixups: loopFixups, cond: X64CondCode.notEqual, targetBlockId: IoLoopSpunLabel)
	code.push(0xF3)  // PAUSE (F3 90) — spin hint, reduces power and HT contention.
	code.push(0x90)
	encodeJmp(code, rel32Fixups: loopFixups, targetBlockId: IoLoopSpinLabel)

	// spun: rax = gt, rcx = gt.ioParked. ABANDONED (2) → the drop arm cancelled this read: signal drain-done and
	// touch the GT no further (the drop arm frees it). Else (1) → NORMAL completion.
	loopLabels.place(IoLoopSpunLabel, value: code.count())
	encodeGrp1RegImm32(code, ext: Grp1ExtCmp, reg: X64Register.rcx, imm: IoParkedAbandoned as Imm32)
	encodeJcc(code, rel32Fixups: loopFixups, cond: X64CondCode.equal, targetBlockId: IoLoopAbandonedLabel)
	// NORMAL: gt.io_result = bytes ; gt.status = ready.
	encodeLoadRegBaseDisp(code, destReg: X64Register.rcx, base: X64Register.rbp, disp: IoLoopBytesLocalDisp, wide: true)
	encodeStoreBaseDispReg(code, base: X64Register.rax, disp: GtOffIoResult as Imm32, srcReg: X64Register.rcx)
	encodeMovRegImm32(code, dest: X64Register.rcx, value: GtStatusReady)
	encodeStoreBaseDispReg(code, base: X64Register.rax, disp: GtOffStatus as Imm32, srcReg: X64Register.rcx)
	// A GT0 self-driver (stackBase == 0) is NOT enqueued — its drive loop notices `status` — but IS signalled.
	encodeLoadRegBaseDisp(code, destReg: X64Register.rcx, base: X64Register.rax, disp: GtOffStackBase as Imm32, wide: true)
	encodeRmRegDirect(code, opcode: OpcodeTestRmReg, dest: X64Register.rcx, src: X64Register.rcx, wide: true)
	encodeJcc(code, rel32Fixups: loopFixups, cond: X64CondCode.equal, targetBlockId: IoLoopSignalLabel)
	// Spawned GT → __gt_enqueue(gt) (under the outer __io_lock; __gt_enqueue is pure memory).
	encodeLoadRegBaseDisp(code, destReg: X64Register.rcx, base: X64Register.rbp, disp: IoLoopGtLocalDisp, wide: true)
	encodeCallDirect(code, callFixups: callFixups, targetName: GtEnqueueName)

	// signal (normal): gt.ioParked = IoParkedNormalDone(4) — so a drop RIGHT AFTER this completion reads 4 and
	// unlinks the enqueued GT — then Leave __io_lock and SetEvent __io_done_event → loop_top.
	loopLabels.place(IoLoopSignalLabel, value: code.count())
	encodeLoadRegBaseDisp(code, destReg: X64Register.rax, base: X64Register.rbp, disp: IoLoopGtLocalDisp, wide: true)
	encodeMovRegImm32(code, dest: X64Register.rcx, value: IoParkedNormalDone)
	encodeStoreBaseDispReg(code, base: X64Register.rax, disp: GtOffIoParked as Imm32, srcReg: X64Register.rcx)
	emitIoLoopLoadGlobal(code, rdataRelocs: rdataRelocs, dest: X64Register.rcx, label: IoLockLabel)
	encodeIatCall(code, iatRelocs: iatRelocs, slotIndex: iatSlotIndex(IatSlot.LeaveCriticalSection))
	emitIoLoopLoadGlobal(code, rdataRelocs: rdataRelocs, dest: X64Register.rcx, label: IoDoneEventLabel)
	encodeIatCall(code, iatRelocs: iatRelocs, slotIndex: iatSlotIndex(IatSlot.SetEvent))
	encodeJmp(code, rel32Fixups: loopFixups, targetBlockId: IoLoopTopLabel)

	// abandoned: gt.ioParked = IoParkedDrainDone(3) (the drop arm's spin target), Leave __io_lock, loop. No enqueue,
	// no SetEvent — the drop arm spins on ioParked==3 on the main thread and owns the free.
	loopLabels.place(IoLoopAbandonedLabel, value: code.count())
	encodeLoadRegBaseDisp(code, destReg: X64Register.rax, base: X64Register.rbp, disp: IoLoopGtLocalDisp, wide: true)
	encodeMovRegImm32(code, dest: X64Register.rcx, value: IoParkedDrainDone)
	encodeStoreBaseDispReg(code, base: X64Register.rax, disp: GtOffIoParked as Imm32, srcReg: X64Register.rcx)
	emitIoLoopLoadGlobal(code, rdataRelocs: rdataRelocs, dest: X64Register.rcx, label: IoLockLabel)
	encodeIatCall(code, iatRelocs: iatRelocs, slotIndex: iatSlotIndex(IatSlot.LeaveCriticalSection))
	encodeJmp(code, rel32Fixups: loopFixups, targetBlockId: IoLoopTopLabel)

	// exit: return 0.
	loopLabels.place(IoLoopExitLabel, value: code.count())
	encodeMovRegImm32(code, dest: X64Register.rax, value: 0)
	encodeGrp1RegImm32(code, ext: Grp1ExtAdd, reg: X64Register.rsp, imm: IoLoopFrameBytes as Imm32)
	encodePopReg(code, reg: X64Register.rbp)
	code.push(OpcodeRet)

	resolveChunkRel32Fixups(code, labelOffsets: loopLabels, rel32Fixups: loopFixups)

	return FunctionCodeChunk.createWith(IoCompletionLoopName, code: code, callFixups: callFixups, rdataRelocs: rdataRelocs, iatRelocs: iatRelocs, rdataConstants: GlobalDataTable.create())
end 'buildIoCompletionLoopChunk'

// Append the hand-assembled GT chunks — called by BackendDispatch when the module spawns a green thread, alongside
// `appendX64RuntimeChunks` for the panic runtime. They lay out above user code like every other runtime chunk, so
// `mrt_start` stays at `.text` offset 0. `usesIocp` (P1.5 slice 1a-ii) additionally appends the IOCP completion-drain
// thread entry.
export function appendX64GtRuntimeChunks(chunks FunctionCodeChunkArray, usesIocp bool)
	chunks.push(buildGtContextSwitchChunk())
	chunks.push(buildGtTrampolineChunk())
	chunks.push(buildGtMorestackChunk())

	if usesIocp 'io'
		chunks.push(buildIoCompletionLoopChunk())
	end 'io'
end 'appendX64GtRuntimeChunks'
