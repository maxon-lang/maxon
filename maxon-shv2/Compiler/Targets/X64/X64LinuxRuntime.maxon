// X64LinuxRuntime — the x64 OS boundary: HOW this backend reaches the kernel on each OS it serves, and
// the Linux syscall facts that answer it. The x64 twin of `Arm64Runtime`'s OS-boundary section.
//
// ⭐ ONE FACT SPLITS THE TWO x64 OSes, AND IT IS THE SYSCALL. **Windows forbids raw syscalls** (the ABI
// is the undocumented, version-shifting `ntdll` boundary): every OS primitive must go through an
// imported function, which forces an Import Address Table the PE loader binds. **Linux permits them**,
// so the same primitives become a bare `syscall` (0F 05) and NONE of that apparatus exists — no IAT, no
// import directory, a static `ET_EXEC` at a fixed base. That single difference is why the ELF writer is
// a third of the PE writer, and it is asked here, once, by `x64OsCallKind` — the exact mirror of
// `Arm64Runtime.arm64OsCallKind` (whose split is macOS-libSystem vs Linux-syscall).
//
// THE ENTRY STUB IS NOT HERE. Unlike arm64 — whose macOS stub terminates through a dyld-bound GOT slot
// that has no `TargetOp` channel, forcing a hand-assembled chunk in `Arm64Runtime` — the x64-linux exit
// route IS a `TargetOp` (`x64Syscall`), so the Linux entry stub `mrt_start` is built from `TargetOp`s in
// `BackendDispatch.prependLinuxEntryStub`, exactly as the Windows stub is. This file holds only the
// syscall-ABI facts that stub and the three OS-primitive lowerings consult.

// How the x64 backend reaches the OS. ONE door, asked by every OS-primitive lowering
// (`lowerOsExit`/`lowerOsWriteStdout`/`lowerOsAllocPages` in `StdToX64Conversion`), so those three sites
// cannot drift on which OSes this backend supports or on how each one gets there. The macho/wasi arms
// panic because x64 serves neither: macOS dispatches to the arm64 backend, and wasm has no Target tier.
export enum X64OsCallKind
	// An IAT-indirect import call (`call [rip + disp32]` through an Import Address Table slot the PE
	// writer binds — `iatCall`). Windows's only route.
	importCall
	// A raw Linux supervisor call (`mov eax, number; syscall`, the number named per-primitive). Linux's.
	syscall
end 'X64OsCallKind'

// Exported: the isel (`StdToX64Conversion`) asks it for every OS-primitive lowering — the one place
// either the Windows or the Linux route is chosen.
export function x64OsCallKind(os Os) returns X64OsCallKind
	return match os 'os'
		windows gives X64OsCallKind.importCall
		linux gives X64OsCallKind.syscall
		macos panic("x64OsCallKind: there is no x64-macOS backend — `buildBackend` dispatches macOS to the arm64 backend, whose OS boundary is `Arm64Runtime.arm64OsCallKind`")
		wasi panic("x64OsCallKind: wasm32-wasi is not an x64 target — the wasm backend reaches the OS through WASI imports, not through this file")
	end 'os'
end 'x64OsCallKind'

// ⭐⭐ **WHICH SEGMENT REGISTER ADDRESSES THIS OS'S PER-OS-THREAD BLOCK — the second fact that splits the
// two x64 OSes, and the reason it is a separate question from `x64OsCallKind`.** That one asks how the
// backend reaches the KERNEL; this one asks nothing of the kernel at all. `fs:`/`gs:` are the ISA's segment
// overrides, and each OS simply chose a different one: Windows points GS at the Thread Information Block
// (whose TLS slots `gs:[0x1480 + key*8]` ARE `TlsGetValue`), while the SysV ABI reserves FS for thread-local
// storage and leaves GS to the kernel.
//
// ⛔⛔ **x86-64 HAS NO WRITABLE THREAD-POINTER INSTRUCTION, WHICH IS THE WHOLE OF WHY LINUX NEEDS A CALL
// WHERE AArch64 NEEDS NONE.** `TPIDR_EL0` is an ordinary system register an `msr` writes; FS base is not
// addressable at all in user mode without `FSGSBASE`, so it is set through `arch_prctl(ARCH_SET_FS)` on the
// main thread and through `CLONE_SETTLS` on a worker M. Reading it back is free — the segment override on an
// ordinary `mov` — which is what keeps the current-P read cheap enough to sit in a prologue guard on both
// lanes.
//
// ⚠ **MEASURED UNDER ROSETTA, which is how the x64-linux lane executes on an arm64 host**: a hand-assembled
// static ELF set FS base by `arch_prctl` (158), read the value back with `ARCH_GET_FS`, and read a magic word
// through BOTH addressing forms — `mov rax, fs:[disp32]` and `mov rax, fs:[reg]`. All four steps answered
// correctly, so the translation layer models the segment base rather than ignoring it.
export enum X64ThreadPointerSegment
	// Windows: GS is the TIB.
	gs
	// Linux: FS is the SysV thread pointer, which on this lane is the scheduler's own slot block
	// (`mrt_host_tls_alloc` maps it and `arch_prctl` publishes it — nothing else on a static image reads FS).
	fs
end 'X64ThreadPointerSegment'

// Exported: the ONE door both tiers ask — the isel has no say (a segment override is not an OS call), so the
// question is answered where the bytes are chosen (`X64Backend.emitTargetOp`) and where the runtime chunks
// spell their own reads (`X64GtRuntime`). The macho/wasi arms panic for `x64OsCallKind`'s reasons.
export function x64ThreadPointerSegment(os Os) returns X64ThreadPointerSegment
	return match os 'os'
		windows gives X64ThreadPointerSegment.gs
		linux gives X64ThreadPointerSegment.fs
		macos panic("x64ThreadPointerSegment: there is no x64-macOS backend — `buildBackend` dispatches macOS to the arm64 backend, whose thread pointer is `Arm64ThreadPointerSource`")
		wasi panic("x64ThreadPointerSegment: wasm32-wasi is not an x64 target — a WASI component has no OS-thread concept for a segment to address")
	end 'os'
end 'x64ThreadPointerSegment'

// --- Linux syscall numbers (x86-64) ---
//
// The x86-64 table, NOT AArch64's: `write` is 1 here and 64 there, `mmap` 9 and 222. Named because a
// bare 1 at a call site is unreadable and the number IS the primitive's identity.
//
// ⚠⚠ **THE `X64` PREFIX IS LOAD-BEARING** — see the twin block in `Targets/Arm64/Arm64Runtime.maxon`,
// which carries the full account. Both tables were once exported under the SAME three unprefixed names;
// Maxon's top-level name space is flat, so the collision was resolved silently by file order and the
// arm64 backend emitted THESE numbers. The arch belongs in the name because the number is an arch fact.
//
// ⛔ `exit_group` (231), NOT `exit` (60), and the difference is LOAD-BEARING here rather than merely
// principled: this lane runs worker Ms through a real `clone` (`buildX64LinuxThreadCreateChunk`), so 60 at
// the end of `main` would end the calling thread and leave every parked M running. `exit` terminates the
// calling THREAD and `exit_group` the whole thread group, which is what `main` returning means and what a C
// `_exit` invokes. The arm64 side makes the same choice with its own pair (94 not 93).
export let X64LinuxSyscallWrite = 1
export let X64LinuxSyscallMmap = 9
export let X64LinuxSyscallExitGroup = 231

// F1a — the page-LIFECYCLE half of the mapping ABI: `munmap` releases a mapping, `madvise` drops its physical
// backing while keeping the mapping. Both carry the arch prefix for the reason above: they are 215 and 233 on
// AArch64 (`Arm64Runtime`'s twin block), so an unprefixed name is the collision that already miscompiled this
// backend once. There is deliberately NO recommit number — a `MADV_DONTNEED`ed page refaults on the next touch,
// so re-backing one is a Windows-only call (see `lowerOsRecommitPages`).
export let X64LinuxSyscallMunmap = 11
export let X64LinuxSyscallMadvise = 28

// F2 — the per-thread identity word. `gettid` answers the calling thread's kernel thread id, which is
// per-thread stable and never 0, i.e. exactly `StdOp.currentThreadToken`'s contract. It is asked instead of
// reading `fs:[0]` because shv2's Linux lane is a raw static binary with no libc, so nothing has set FS base
// and that load would dereference address 0 — the op's own header carries the full argument. 186 on x86-64,
// 178 on AArch64 (`Arm64Runtime`'s twin), which is exactly why these numbers wear the arch prefix.
export let X64LinuxSyscallGettid = 186

// --- L3/L4: the clocks, the identity, the machine query and the green-thread floor ---
//
// ⚠⚠ **MEASURED ON THIS LANE, not transcribed.** Each was invoked BY NUMBER from a hand-assembled static
// x86-64 ELF run under Rosetta inside the aarch64 guest, and checked against the behaviour it is supposed to
// have: both `clock_gettime` ids against a real calendar and a real uptime, `clock_nanosleep` against a 20 ms
// park that advanced the monotonic clock, `sched_getaffinity`'s popcount against a non-empty mask,
// `readlinkat` against a `/proc/self/exe` answering an absolute path, `gettid` against `getpid` on the main
// thread, `mprotect`/`munmap` against pages this same probe had mapped, and `arch_prctl`/`clone`/`futex`
// against the worker-M bring-up described at each of their blocks below.
//
// ⚠ **EVERY NUMBER DIFFERS FROM AArch64's AND THE PREFIX IS WHAT SAYS SO** — `clock_gettime` is 228 here and
// 113 there, `futex` 202 and 98, `clone` 56 and 220. Commit `a60543c9f1` is the incident where two tables
// shared unprefixed names and one backend emitted the other's numbers.
let X64LinuxSyscallClockGettime = 228
let X64LinuxSyscallSchedGetaffinity = 204
let X64LinuxSyscallReadlinkat = 267

// ⭐ **`getpid` NEEDS NO CHUNK AND SO NEEDS NO GATE** — no operands, no out-param, one `syscall` lowered
// inline (`StdToX64Conversion.lowerOsGetPidLinux`). Exported for that isel; 39 here and 172 on AArch64.
export let X64LinuxSyscallGetPid = 39

// ⛔⛔ **THE TWO PRIORITY CALLS ARE SWAPPED BETWEEN THE ARCHES — SAME NUMBERS, OPPOSITE VERBS.** x86-64
// numbers them from its own table (`getpriority` 140, `setpriority` 141) while AArch64 takes
// `asm-generic/unistd.h`'s order and has them the other way round, so a lane that reused the twin's
// constant would SET when it meant to READ and answer a value nothing wrote.
//
// ⚠ VERIFIED by invoking both on an x86-64 guest: `syscall(140, 0, 0)` answered 20 in a fresh process,
// `syscall(141, 0, 0, 7)` answered 0, and the next `syscall(140, 0, 0)` answered 13 — the read moved by
// exactly the nice value the write asked for, biased by `LinuxGetPriorityBias`.
export let X64LinuxSyscallGetPriority = 140
export let X64LinuxSyscallSetPriority = 141

// ⚠ **16 HERE AND 29 ON AArch64.** VERIFIED by invoking it: 16 with `TCGETS` answered 0 on a pty and
// `-ENOTTY` on a pipe, a regular file and `/dev/null`, while syscall 17 with the identical arguments
// answered `-ESPIPE` (`pread`), which is the control that says 16 is really `ioctl`.
let X64LinuxSyscallIoctl = 16

// ⭐ **THE GREEN-THREAD FLOOR'S OWN NUMBERS.** Each is spent by a chunk below: `futex` by every wait and
// wake, `clone` by the worker M and by the child process, `mprotect` by the M's stack guard, `arch_prctl` by
// the per-OS-thread slot block, `clock_nanosleep` by the OS-thread park and the thread-scoped `exit` by a
// worker M and by a child whose `execve` failed.
//
// ⛔⛔ **`clock_nanosleep` (230) AND NOT `nanosleep` (35).** The two are the same call for a RELATIVE
// request except that `nanosleep` is defined against `CLOCK_REALTIME`, so a settime during the sleep moves a
// park the scheduler measured against `CLOCK_MONOTONIC`.
//
// ⛔ **`exit` (60) IS THE THREAD-SCOPED ONE AND IS NEVER `exit_group` (231)** — see that constant's own
// block. A worker M and a failed-exec child each end THEMSELVES.
let X64LinuxSyscallArchPrctl = 158
let X64LinuxSyscallClone = 56
let X64LinuxSyscallFutex = 202
let X64LinuxSyscallMprotect = 10
let X64LinuxSyscallClockNanosleep = 230
let X64LinuxSyscallExit = 60

// ⛔⛔⛔ **`arch_prctl`'s TWO SUBFUNCTIONS, AND THE WHOLE OF WHY x86-64 NEEDS A CALL WHERE AArch64 NEEDS
// NONE.** `TPIDR_EL0` is an ordinary system register an `msr` writes; FS base is not addressable in user
// mode at all without `FSGSBASE`, so the only way to publish this OS thread's slot block is this syscall —
// and the only way to READ it back is `ARCH_GET_FS`, which writes through a pointer rather than answering in
// a register. Both are spent exclusively in `mrt_host_tls_alloc`, which runs once per OS thread at bring-up;
// every HOT read of the block goes through the segment override instead and enters no kernel.
let X64LinuxArchSetFs = 0x1002
let X64LinuxArchGetFs = 0x1003

// --- L5: the child-process band ---
//
// ⚠⚠ **MEASURED ON THIS LANE, each with a negative control that produced a DIFFERENT observable**: `pipe2`
// round-tripped a byte and answered exit 90 as 292; `dup3(w, 7, 0)` answered 7 and 91 as 291; `execve` ran
// `/bin/true` and `/bin/false` and answered 120 as 60 and 42 as 58; `wait4` reported a child's `exit(37)` as
// 37 and 255 as 60; `kill` SIGKILLed the caller to 137 and answered 11 as 61; `ppoll` reported `POLLIN` on a
// ready pipe and returned 0 on an empty one, answering 90 as 270.
let X64LinuxSyscallPipe2 = 293
let X64LinuxSyscallDup3 = 292
let X64LinuxSyscallExecve = 59
let X64LinuxSyscallWait4 = 61
let X64LinuxSyscallKill = 62
let X64LinuxSyscallPpoll = 271

// The child's two optional pre-`execve` steps: its own SESSION for a `DETACHED_PROCESS`, and its working
// directory for a non-NULL `lpCurrentDirectory`. Both are 157 and 49 on AArch64, which is why they carry the
// arch prefix like every number above.
let X64LinuxSyscallSetsid = 112
let X64LinuxSyscallChdir = 80

// --- Linux mmap parameters ---
//
// The `mmap(NULL, size, PROT_READ|PROT_WRITE, MAP_ANONYMOUS|MAP_PRIVATE, -1, 0)` `lowerOsAllocPages`
// emits on Linux — the raw-syscall twin of the Windows `VirtualAlloc(NULL, size, MEM_COMMIT|MEM_RESERVE,
// PAGE_READWRITE)`. The ABI constants (`MmapKernelChoosesBase`/`MmapProtReadWrite`/`MmapAnonPrivateLinux`/
// `MmapAnonFd`/`MmapNoOffset`) live in `Targets/Shared/PosixMmap.maxon`, shared with the arm64 isel so
// the mmap ABI is one fact, not two copies (OPEN #83).

// STDOUT_FILENO used to be spelled HERE as well, as `WriteStdoutFd`, read by this backend's stdout
// write. W35 gave that write a stderr twin and moved the descriptor to the ONE door both POSIX isels
// ask (`StdLoweringShared.posixStreamFd`), which left this declaration exported and read by nothing —
// a second spelling of a number whose only remaining purpose was to be able to disagree with the
// first. Removed at that rung's review. It now sits beside its stderr sibling as
// `StdLoweringShared.PosixStdoutFd`/`StderrFd`, both POSIX facts rather than x64-Linux ones for the
// reason the note below `X64LinuxSyscallRtSigaction` gives.

// --- Linux fault runtime (the SIGFPE handler for a divide-by-zero) ---
//
// The x64-linux twin of the Windows VEH fault handler (`X64Runtime.buildFaultThunkChunk`). On x86-64 an
// `idiv` by zero raises #DE, which the kernel delivers as SIGFPE; a handler registered here catches it,
// prints the panic diagnostic + symbolized backtrace, and `exit_group`s — so a divide-by-zero is a clean
// `exit 1`, not a process killed by signal. See `X64Runtime.appendX64RuntimeChunks` (the linux arm) and
// `BackendDispatch.prependLinuxEntryStub` (which calls `mrt_runtime_init` before `main`).
// These two are ROWS OF THE SAME x86-64 syscall table as `X64LinuxSyscall{Write,Mmap,ExitGroup}` above
// and carry the arch prefix for the same reason — they are 134 and 139 on AArch64, so an arm64 fault
// runtime would declare its own, and an unprefixed name here is the collision that already miscompiled
// this backend once. The signal NUMBER is not one of them: `LinuxSignalFpe` is arch-neutral and lives in
// `Targets/Shared/LinuxRuntime` beside `LinuxSigsetBytes`, which is the same case.
export let X64LinuxSyscallRtSigaction = 13
export let X64LinuxSyscallRtSigreturn = 15

// sa_flags = SA_SIGINFO (0x4 — the handler receives (sig, siginfo*, ucontext*)) | SA_RESTORER (0x04000000).
// ⚠ x86-64 has NO kernel-provided signal trampoline, so SA_RESTORER + a valid `sa_restorer` are MANDATORY:
// without them the kernel raises a KERNEL SIGSEGV building the signal return frame — BEFORE the handler
// runs, and even for a handler that never returns (measured: strace showed SIGFPE then SI_KERNEL SIGSEGV).
export let X64LinuxSigactionFlags = 0x04000004

// STDERR_FILENO — where the panic diagnostic goes — is `Targets/Shared/StdLoweringShared.StderrFd`. It
// is not an x64-Linux fact: arm64's two OSes name the same descriptor from their own panic runtime.

// x86-64 `ucontext_t` offsets to the general registers a backtrace needs. `uc_mcontext` sits at offset 40
// (past uc_flags/uc_link/uc_stack) and its `gregs[]` array starts there; the greg indices are REG_RBP=10,
// REG_RSP=15, REG_RIP=16, i.e. `40 + index*8` into the ucontext the handler receives in rdx.
export let X64LinuxUContextRipOffset = 168  // 40 + REG_RIP(16)*8 — the faulting instruction pointer.
export let X64LinuxUContextRbpOffset = 120  // 40 + REG_RBP(10)*8 — the faulting frame pointer (seeds the walk).
export let X64LinuxUContextRspOffset = 160  // 40 + REG_RSP(15)*8 — the faulting stack pointer (bounds the walk).

// ==========================================================================
// THE HOST SURFACE — the file, directory and standard-input bodies
// ==========================================================================
//
// ⭐⭐ **THE x86-64 TWIN OF `Arm64LinuxRuntime`'s L1/L2 BANDS, AGAINST THE SAME KERNEL.** Every `mrt_host_*`
// body below is that file's chunk with three things changed and nothing else: the SYSCALL NUMBERS (x86-64's
// table, not AArch64's), the REGISTER ABI (`rdi/rsi/rdx/r10/r8/r9` + `syscall`, where that lane has
// `x0..x5` + `svc`), and `struct stat`'s LAYOUT. The Win32-shaped facts these bodies produce — the
// `dwFileAttributes` a `st_mode` becomes, the FILETIME a whole second becomes, the 320-byte
// `WIN32_FIND_DATAA`, the errno→Win32 mapping, the glob split — are `Targets/Shared/PosixRuntime`'s and are
// READ from there rather than restated, which is also why the symbols are the shared `mrt_host_*` names:
// exactly one backend's chunks reach any image, so a shared name can only ever have one body. The Linux
// facts both arches agree on — `AT_FDCWD`, the generic `open` flags, the search object and
// `struct linux_dirent64` — are `Targets/Shared/LinuxRuntime`'s for the same reason.
//
// ⚠ **`syscall` CLOBBERS rcx AND r11**, which `svc` does not clobber at all. Nothing here may hold a live
// value in either across one; every value that must survive a call goes in a frame slot, which is the same
// discipline the arm64 bodies already keep for a different reason (an out-param must outlive the call).
//
// ⚠ **rsi AND rdi ARE FREE HERE AND WOULD NOT BE UNDER REAL Win64.** shv2's x64 register file makes only
// rbx and r12–r15 callee-saved (`RegisterAllocator.calleeSavedMask`), so the syscall argument registers are
// all caller-saved and no body below saves one.

// --- The x86-64 filesystem syscall numbers ---
//
// ⚠ **MEASURED ON THIS LANE, not transcribed** — each was invoked BY NUMBER from a hand-assembled static
// x86-64 ELF run on the OrbStack guest (the same Rosetta lane the spec suite runs this target under) and
// checked against what it did: `openat` answered a live descriptor for a real path, `read` returned the
// file's exact bytes, `getcwd` the process's real directory, `getdents64` a decodable `linux_dirent64`
// stream, `newfstatat`/`fstat` a `st_mode` of `0100644` and the file's real size, `readlinkat` the running
// image's path, and the `mkdirat`/`renameat`/`unlinkat`/`fsync` quartet created, renamed, synced and
// removed a real directory and file. That is the discipline `X64LinuxOpenDirectoryFlags` below exists to
// enforce, and it is why the arch prefix is on every name (see the F1a block above).
let X64LinuxSyscallRead = 0
export let X64LinuxSyscallClose = 3
let X64LinuxSyscallFstat = 5
let X64LinuxSyscallFsync = 74
let X64LinuxSyscallGetcwd = 79
let X64LinuxSyscallGetdents64 = 217
let X64LinuxSyscallOpenat = 257
let X64LinuxSyscallMkdirat = 258
let X64LinuxSyscallNewfstatat = 262
let X64LinuxSyscallUnlinkat = 263
let X64LinuxSyscallRenameat = 264

// --- The SOCKET band's syscalls ---
//
// ⚠ **MEASURED ON THIS LANE, not transcribed, and END TO END**: a probe run on the amd64 OrbStack guest
// called these four BY NUMBER and nothing else — `socket(AF_INET, SOCK_STREAM, IPPROTO_TCP)` answered a
// live descriptor, `connect` to a port nothing listens on answered `-ECONNREFUSED` and to a listening one
// answered 0, `sendto` moved five bytes and `recvfrom` read the same five back on the accepted end, and a
// second `close` of the same descriptor answered `-EBADF`.
// ⛔ **NEGATIVE CONTROL: AArch64's numbers (198/203/206/207) on this arch answered `-EFAULT` at the very
// first call**, which is what makes the positive run evidence rather than agreement.
//
// ⛔⛔ **THERE IS NO `send` OR `recv` SYSCALL ON x86-64 EITHER** — only `sendto`/`recvfrom` with a peer
// address a connected stream socket does not use (`LinuxSocketNoPeerAddress`). Both Linux lanes are
// constrained the same way here and the macOS lane is constrained the opposite way, which is why the two
// isels name an import slot AND a syscall number at every transfer site.
export let X64LinuxSyscallSocket = 41
export let X64LinuxSyscallConnect = 42
export let X64LinuxSyscallSendto = 44
export let X64LinuxSyscallRecvfrom = 45

// ⛔⛔ **`O_DIRECTORY` IS THE asm-generic `0o200000` HERE, NOT THE `0o40000` AArch64 USES.**
// `arch/arm64/include/uapi/asm/fcntl.h` overrides four flags before including the generic header and
// shifts them all down, so the two lanes disagree about this one bit pattern and about no other flag in
// this file. ⚠ **MEASURED, both ways, on the x86-64 lane**: `openat(AT_FDCWD, <a directory>, 0o200000)`
// answered a live descriptor and `openat(…, 0o40000)` answered **-EINVAL** — an errno with no Win32 twin,
// which would make every `Directory.list` report the catch-all `openSearchFailed` while `__mf_exists`, which
// never opens a directory, kept passing. `PosixOpenReadOnly` and `LinuxOpenCreateTruncateFlags` are
// `Targets/Shared/LinuxRuntime`'s because those three arms really are one asm-generic fact.
let X64LinuxOpenDirectoryFlags = 0o200000

// ⭐ **THE `.data` WORD THE HOST SURFACE STASHES INTO** (`LinuxErrnoLabel`). Gated on the FACILITIES that
// touch it rather than on the target alone: a Linux program that opens no file, lists no directory, reads no
// standard input and spawns nothing never writes it, so it does not carry it.
//
// ⭐⭐⭐ **THE WORD IS PER-OS-THREAD BECAUSE THIS LANE HAS A REAL `clone`.** With two Ms making syscalls at
// once, a `-errno` stashed by one and read by `mrt_host_last_error` on the other is a WRONG `FileError` — a
// silent wrong answer, not a crash. `x64LinuxEmitErrnoAddr` is the ONE address every reader and every writer
// goes through, and it answers this thread's own slot 0 whenever the thread has a block. This `.data` word is
// what is left: the storage for a thread that never asked the scheduler for one.
//
// ⚠ **NO OUTER BIT TEST AT THE CALL SITE** (`Compiler.maxon`), exactly as its arm64 twin arranges: the
// answer depends on the TARGET as well as on the bits, and asking that pair anywhere else would copy it.
export function x64LinuxRuntimeGlobals(usage RuntimeUsage, target Target) returns DataSectionEntryArray
	var out = DataSectionEntryArray.create()

	if target.cpu != CpuArch.x64 or target.os != Os.linux or not linuxTouchesErrnoWord(usage) 'notThisLane'
		return out
	end 'notThisLane'

	pushRuntimeGlobal(out, label: LinuxErrnoLabel, sharing: MultiMSharing.sealedBeforeWorkers)
	pushRuntimeGlobal(out, label: X64LinuxTlsReadyLabel, sharing: MultiMSharing.sealedBeforeWorkers)
	return out
end 'x64LinuxRuntimeGlobals'

// ⭐⭐ **THE WORD THAT SAYS WHETHER PER-OS-THREAD SLOT BLOCKS EXIST YET — an x86-64-only need, and its
// absence on the other lane is the measure of what a readable thread pointer buys.** arm64 answers the same
// question with one free `cbz` on `TPIDR_EL0`; here the equivalent load would go through FS with base 0,
// which is a wild read of the null page rather than a test. `mrt_host_tls_alloc` raises it on the first call
// of the process and nothing lowers it, which is why `sealedBeforeWorkers` is the honest class: the raise
// happens during `__sched_init_procs`, before any second thread can exist.
//
// ⚠ It is laid out on the same gate the errno word is, because it is only ever read to decide WHERE that
// word lives. A program with no scheduler carries it holding 0 for the whole run, which is the answer.
let X64LinuxTlsReadyLabel = b"__mrt_tls_ready"

// SLOT 0 of a per-OS-thread block is that thread's `errno`. It is not merely the first unissued key: the
// scheduler's own keys start at `LinuxTlsFirstKey` so that a slot offset of 0 keeps meaning *"the scheduler
// has not started"* to every current-P reader, and the word that offset addresses is therefore free for this.
// Both Linux lanes reserve it the same way.
let X64LinuxErrnoSlotOffset = 0

// ==========================================================================
// struct stat (x86-64)
// ==========================================================================

// ⭐ **144 BYTES, AND `st_mode` IS AT 24 WHERE AArch64 PUTS IT AT 16.** x86-64 has its own
// `arch/x86/include/uapi/asm/stat.h` rather than the asm-generic one, and it widens `st_nlink` to a full
// word and pads before `st_rdev`; the three timestamps and `st_size` happen to land at the same offsets,
// which is exactly the kind of partial agreement that makes copying the other lane's numbers survive
// testing until a `File.info()` reports a mode read out of `st_uid`.
//
// ⚠ **MEASURED, not transcribed**: `fstat` on a 22-byte `0644` file owned by uid 502 answered `0x81a4` in
// the low half of the word at 24 and `502` in its high half (`st_mode` then `st_uid`), `22` at 48, and
// three plausible epoch seconds at 72/88/104 with sub-second halves beside them. v1's own repack writes
// `st_mode` at 24 for AArch64, where it is `st_uid` — which is why every offset here was read off the
// running kernel rather than off the reference.
//
// ⚠ **THERE IS NO BIRTH TIME**: a creation time is `statx`'s `stx_btime`, a different syscall and a
// different structure, so `File.info().createdTime` reports `st_ctime` here exactly as it does on the
// other Linux lane.
let X64LinuxStatBytes = 144
let X64LinuxStatModeOffset = 24
let X64LinuxStatSizeOffset = 48
let X64LinuxStatAccessTimeOffset = 72
let X64LinuxStatModifyTimeOffset = 88
let X64LinuxStatStatusChangeTimeOffset = 104

function x64LinuxStatLayout() returns PosixStatLayout
	return PosixStatLayout.create(X64LinuxStatBytes, modeOffset: X64LinuxStatModeOffset, sizeOffset: X64LinuxStatSizeOffset, creationTimeOffset: X64LinuxStatStatusChangeTimeOffset, accessTimeOffset: X64LinuxStatAccessTimeOffset, modifyTimeOffset: X64LinuxStatModifyTimeOffset)
end 'x64LinuxStatLayout'

// ==========================================================================
// Shared emit fragments
// ==========================================================================

// The `[rbp + disp]` base of a MULTI-SLOT buffer that occupies `slotCount` consecutive slots starting at
// `firstSlot`. Slots grow DOWNWARD from rbp, so a structure's lowest address is its LAST slot's — the same
// arrangement `buildLinuxRuntimeInitChunk` lays its `struct sigaction` out in, stated once here because
// three chunks below place a `struct stat` or a path buffer this way.
function x64LinuxBufferDisp(asm X64RuntimeAsm, firstSlot StackSize, slotCount StackSize) returns Imm32
	return asm.slotDisp(firstSlot + slotCount - 1)
end 'x64LinuxBufferDisp'

// rax holds a FAILED syscall's `-errno`. Stash the POSITIVE errno where `mrt_host_last_error` reads it and
// leave that positive value in rsi for a caller that must also test it (`mrt_host_dir_current_path` does).
// rax is untouched, so the caller still has the kernel's own answer.
function x64LinuxEmitStashErrno(asm X64RuntimeAsm)
	encodeMovRegImm32(asm.code, dest: X64Register.rsi, value: 0)
	encodeRmRegDirect(asm.code, opcode: OpcodeSubRmReg, dest: X64Register.rsi, src: X64Register.rax, wide: true)
	x64LinuxEmitStoreErrno(asm, valueReg: X64Register.rsi)
end 'x64LinuxEmitStashErrno'

// Publish a KNOWN errno rather than one a syscall just answered — the walk's clear before each step
// (`PosixErrnoCleared`, which is how end-of-iteration reaches `ERROR_NO_MORE_FILES`), and the two places a
// reason has to be invented because no call failed.
function x64LinuxEmitPublishErrno(asm X64RuntimeAsm, value ParsedInt)
	encodeMovRegImm32(asm.code, dest: X64Register.rsi, value: value as MachineWord)
	x64LinuxEmitStoreErrno(asm, valueReg: X64Register.rsi)
end 'x64LinuxEmitPublishErrno'

// ⭐⭐⭐ **WRITE *THIS OS THREAD's* errno WORD — and it is a STORE HELPER rather than an address helper,
// which is the one place x86-64 forces a different shape from the arm64 twin.** `TPIDR_EL0` is readable as a
// VALUE, so that lane computes an address and every caller stores through it; FS base is not addressable in
// user mode at all, so a per-thread word here has an address only INSIDE an instruction carrying the segment
// override. The branch is therefore around the whole access rather than around the address computation.
//
// ⚠ **THE PREDICATE IS PROCESS-WIDE AND THAT IS SOUND RATHER THAN APPROXIMATE.** Every OS thread that runs
// code on this lane has a slot block: the MAIN thread gets one from `mrt_host_tls_alloc` inside
// `__sched_init_procs`, and every thread `mrt_host_thread_create` starts — a worker M or `__sysmon` — gets
// one through `CLONE_SETTLS` before it executes an instruction. `ioCompletionShape(linux)` is
// `inlineCompletion`, so nothing else is started at all.
// ⇒ once ANY thread has a block, EVERY thread has one, and the only window in which the flag reads 0 is the
// one before `__sched_init_procs` — where this process is single-threaded and the `.data` word is exactly
// right. The flag cannot be replaced by a load through FS: with FS base 0 that load is a wild read of the
// null page, which is the fault the test exists to prevent.
//
// ⚠ It clobbers rdi and the flags. rax is untouched, which is the contract every caller in this file rests
// on — `x64LinuxEmitStashIfFailed` takes its own `cmp` before the stash and every consumer re-compares after.
function x64LinuxEmitStoreErrno(asm X64RuntimeAsm, valueReg X64Register)
	let perThread = asm.newLabel()
	let stored = asm.newLabel()

	x64LinuxEmitTestTlsReady(asm, scratch: X64Register.rdi, whenReady: perThread)
	encodeLeaRegGlobal(asm.code, rdataRelocs: asm.rdataRelocs, dest: X64Register.rdi, label: LinuxErrnoLabel)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rdi, disp: 0, srcReg: valueReg)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: stored)

	asm.placeLabel(perThread)
	encodeMovRegImm32(asm.code, dest: X64Register.rdi, value: X64LinuxErrnoSlotOffset)
	encodeMovSegBaseReg(asm.code, base: X64Register.rdi, srcReg: valueReg, segment: x64ThreadPointerSegment(Os.linux))

	asm.placeLabel(stored)
end 'x64LinuxEmitStoreErrno'

// The read twin, and the one caller is `mrt_host_last_error`. `destReg` doubles as the branch's scratch,
// which is what keeps the sequence to one register.
function x64LinuxEmitLoadErrno(asm X64RuntimeAsm, destReg X64Register)
	let perThread = asm.newLabel()
	let loaded = asm.newLabel()

	x64LinuxEmitTestTlsReady(asm, scratch: destReg, whenReady: perThread)
	encodeLeaRegGlobal(asm.code, rdataRelocs: asm.rdataRelocs, dest: destReg, label: LinuxErrnoLabel)
	encodeLoadRegBaseDisp(asm.code, destReg: destReg, base: destReg, disp: 0, wide: true)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: loaded)

	asm.placeLabel(perThread)
	encodeMovRegImm32(asm.code, dest: destReg, value: X64LinuxErrnoSlotOffset)
	encodeMovRegSegBase(asm.code, dest: destReg, base: destReg, segment: x64ThreadPointerSegment(Os.linux))

	asm.placeLabel(loaded)
end 'x64LinuxEmitLoadErrno'

// `scratch = __mrt_tls_ready ; if (scratch) goto whenReady` — the shared head of the two above.
function x64LinuxEmitTestTlsReady(asm X64RuntimeAsm, scratch X64Register, whenReady BlockId)
	encodeLeaRegGlobal(asm.code, rdataRelocs: asm.rdataRelocs, dest: scratch, label: X64LinuxTlsReadyLabel)
	encodeLoadRegBaseDisp(asm.code, destReg: scratch, base: scratch, disp: 0, wide: true)
	encodeRmRegDirect(asm.code, opcode: OpcodeTestRmReg, dest: scratch, src: scratch, wide: true)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.notEqual, targetBlockId: whenReady)
end 'x64LinuxEmitTestTlsReady'

// ⭐ **THE TAIL OF EVERY SYSCALL IN THIS FILE: a negative answer is a failure, and the reason goes in the
// word.** rax is left exactly as the kernel wrote it, so a caller that wants a count, a descriptor or a
// sentinel decides that for itself immediately after.
function x64LinuxEmitStashIfFailed(asm X64RuntimeAsm)
	let succeeded = asm.newLabel()

	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.greaterEqual, targetBlockId: succeeded)
	x64LinuxEmitStashErrno(asm)

	asm.placeLabel(succeeded)
end 'x64LinuxEmitStashIfFailed'

// Leave `Win32True` in rax when the flags say the last compare was equal-to-zero, `Win32False` otherwise.
// x64 has `setcc`, but every consumer of this fragment wants a full 64-bit 0/1 and a branch pair says so
// without a second opinion about the upper half.
function x64LinuxEmitWin32BoolFromFlags(asm X64RuntimeAsm, cond X64CondCode)
	let succeeded = asm.newLabel()
	let answered = asm.newLabel()

	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: cond, targetBlockId: succeeded)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: Win32False as MachineWord)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: answered)

	asm.placeLabel(succeeded)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: Win32True as MachineWord)

	asm.placeLabel(answered)
end 'x64LinuxEmitWin32BoolFromFlags'

// The syscall's `0`/`-errno` status becoming the Win32 BOOL the Std tier tests, with the reason stashed on
// the way. NO narrowing: a `syscall` answers a full 64-bit word.
function x64LinuxEmitWin32BoolFromSyscall(asm X64RuntimeAsm)
	x64LinuxEmitStashIfFailed(asm)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	x64LinuxEmitWin32BoolFromFlags(asm, cond: X64CondCode.equal)
end 'x64LinuxEmitWin32BoolFromSyscall'

// Replace a negative rax with `sentinel`. The Std tier tests for EXACT sentinels — `InvalidHandleValue` is
// -1 and `INVALID_FILE_ATTRIBUTES` is 0xFFFFFFFF — and a raw `-errno` is `-2` for a missing file, which
// would read as a live descriptor.
function x64LinuxEmitFailureSentinel(asm X64RuntimeAsm, sentinel MachineWord)
	let kept = asm.newLabel()

	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.greaterEqual, targetBlockId: kept)
	encodeMovRegImm64(asm.code, dest: X64Register.rax, value: sentinel)

	asm.placeLabel(kept)
end 'x64LinuxEmitFailureSentinel'

// `newfstatat(dirFd, path, statBuf, PosixFollowSymlinks)` WITH THE PATH ALREADY IN r8 AND THE DIRECTORY
// DESCRIPTOR IN r9 — a fixed entry contract rather than two register parameters, because the three sites
// that describe a path all have their operands somewhere else anyway and a parameterised version would
// carry an aliasing rule (`r8`/`r9` must not be a syscall argument register) that nothing could check.
function x64LinuxEmitFstatat(asm X64RuntimeAsm, statDisp Imm32)
	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.rsi, src: X64Register.r8, wide: true)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rdx, base: X64Register.rbp, disp: statDisp)
	encodeMovRegImm32(asm.code, dest: X64Register.r10, value: PosixFollowSymlinks as MachineWord)
	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.rdi, src: X64Register.r9, wide: true)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallNewfstatat)
end 'x64LinuxEmitFstatat'

// Copy a NUL-terminated string, writing at most `limit` bytes plus the terminator. Clobbers all four
// registers it is given; the terminator is written unconditionally, so a truncated copy is still a string.
function x64LinuxEmitCopyCStringBounded(asm X64RuntimeAsm, src X64Register, dest X64Register, limit X64Register, scratch X64Register)
	let step = asm.newLabel()
	let terminate = asm.newLabel()

	asm.placeLabel(step)
	emitCmpRegImm(asm, reg: limit, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: terminate)
	encodeMovzxRegByteBaseDisp(asm.code, destReg: scratch, base: src, disp: 0)
	emitCmpRegImm(asm, reg: scratch, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: terminate)
	encodeStoreBaseDispReg8(asm.code, base: dest, disp: 0, srcReg: scratch)
	encodeGrp1RegImm32(asm.code, ext: Grp1ExtAdd, reg: src, imm: 1)
	encodeGrp1RegImm32(asm.code, ext: Grp1ExtAdd, reg: dest, imm: 1)
	encodeGrp1RegImm32(asm.code, ext: Grp1ExtSub, reg: limit, imm: 1)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: step)

	asm.placeLabel(terminate)
	encodeMovRegImm32(asm.code, dest: scratch, value: NulByte as MachineWord)
	encodeStoreBaseDispReg8(asm.code, base: dest, disp: 0, srcReg: scratch)
end 'x64LinuxEmitCopyCStringBounded'

// ⭐ **ZERO `slotCount` CONSECUTIVE FRAME SLOTS.** The walk zeroes its `struct stat` before an `fstatat`
// whose verdict may be DISCARDED (a dangling symbolic link is a real directory entry that Win32 reports),
// so the PREVIOUS entry's size and timestamps cannot be published for it. Clobbers rax, rsi and rdi.
function x64LinuxEmitZeroSlots(asm X64RuntimeAsm, firstSlot StackSize, slotCount StackSize)
	let step = asm.newLabel()
	let zeroed = asm.newLabel()

	encodeLeaRegRegImm32(asm.code, dest: X64Register.rsi, base: X64Register.rbp, disp: x64LinuxBufferDisp(asm, firstSlot: firstSlot, slotCount: slotCount))
	encodeMovRegImm32(asm.code, dest: X64Register.rdi, value: slotCount as MachineWord)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: 0)

	asm.placeLabel(step)
	emitCmpRegImm(asm, reg: X64Register.rdi, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: zeroed)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rsi, disp: 0, srcReg: X64Register.rax)
	encodeGrp1RegImm32(asm.code, ext: Grp1ExtAdd, reg: X64Register.rsi, imm: SpillSlotBytes as Imm32)
	encodeGrp1RegImm32(asm.code, ext: Grp1ExtSub, reg: X64Register.rdi, imm: 1)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: step)

	asm.placeLabel(zeroed)
end 'x64LinuxEmitZeroSlots'

// ⭐ **AN errno IN rax BECOMING THE Win32 CODE THE Std TIER CLASSIFIES** — the whole body of
// `mrt_host_last_error` except for where the errno came FROM. The five errno values and the four Win32
// codes are `Targets/Shared/PosixRuntime`'s and `ManagedFileRuntime`'s; only the branch shape is x64's.
//
// ⚠ **THE MAPPING IS NOT THE IDENTITY AND CANNOT BE**, even though `ENOENT` and `ERROR_FILE_NOT_FOUND` are
// both 2. ⚠ **A CLEARED errno ANSWERS `ERROR_NO_MORE_FILES`** — see `PosixErrnoCleared`.
function x64LinuxEmitErrnoToWin32(asm X64RuntimeAsm)
	let notFound = asm.newLabel()
	let pathNotFound = asm.newLabel()
	let denied = asm.newLabel()
	let noMoreFiles = asm.newLabel()
	let answered = asm.newLabel()

	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: noMoreFiles)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: PosixErrnoNoSuchFileOrDirectory as Imm32)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: notFound)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: PosixErrnoNotADirectory as Imm32)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: pathNotFound)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: PosixErrnoPermissionDenied as Imm32)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: denied)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: PosixErrnoOperationNotPermitted as Imm32)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: denied)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: ErrorGenericFailure as MachineWord)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: answered)

	asm.placeLabel(notFound)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: ErrorFileNotFound as MachineWord)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: answered)

	asm.placeLabel(pathNotFound)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: ErrorPathNotFound as MachineWord)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: answered)

	asm.placeLabel(denied)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: ErrorAccessDenied as MachineWord)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: answered)

	asm.placeLabel(noMoreFiles)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: ErrorNoMoreFiles as MachineWord)

	asm.placeLabel(answered)
end 'x64LinuxEmitErrnoToWin32'

// Whole SECONDS since the Unix epoch becoming the FILETIME `WIN32_FIND_DATAA` carries. It reads
// `ClockRuntime`'s own two constants rather than a producer-side copy, so the record's producer and the Std
// graph that decodes it (`ManagedFileRuntime.emitFileTimeToUnixSeconds`) are one fact.
function x64LinuxEmitSecondsToFileTime(asm X64RuntimeAsm, reg X64Register, scratch X64Register)
	encodeImulRegRegImm32(asm.code, dest: reg, src: reg, imm: FileTimeTicksPerSecond as Imm32)
	encodeMovRegImm64(asm.code, dest: scratch, value: FileTimeTicksFrom1601To1970 as MachineWord)
	encodeRmRegDirect(asm.code, opcode: OpcodeAddRmReg, dest: reg, src: scratch, wide: true)
end 'x64LinuxEmitSecondsToFileTime'

// ==========================================================================
// L3 — the `timespec`, the two non-scheduler clocks, the image path and the machine query
// ==========================================================================

// `struct timespec` — `tv_sec` then `tv_nsec`, two 64-bit words on x86-64, which is exactly two of this
// assembler's 8-byte frame slots side by side.
//
// ⚠ **THE SLOT IS FIXED HERE, NOT PER CHUNK, BECAUSE `x64LinuxReadClockTimespec` ADDRESSES IT.** Every clock
// chunk holds its out-param pointer in slot 0 and reserves these two above it, so the fragment can form the
// address without being told where. A chunk that reserved fewer is not subtly wrong: `X64RuntimeAsm.slotDisp`
// PANICS on a slot outside the frame it opened.
//
// ⛔⛔ **THE TWO FIELDS ARE ADDRESSED BY BYTE OFFSET FROM THE STRUCT'S BASE, NEVER BY SLOT INDEX, AND THAT IS
// THE WHOLE REASON THIS IS SHAPED AS IT IS.** Slots grow DOWNWARD from rbp, so a higher slot index is a LOWER
// address — which means the struct's FIRST field lives in its LAST slot and a pair of `slotDisp` reads named
// `…SecSlot`/`…NsecSlot` reads them backwards while still compiling, still running, and still answering a
// plausible time. (MEASURED as exactly that: `clock.wall-clock-is-a-calendar-time` failed with a calendar
// built from the nanoseconds half.) The arm64 twin CAN index by slot because its frame grows the other way;
// this one derives every field from the base, so the direction is stated once.
let X64LinuxTimespecFirstSlot = 1 as StackSize
let X64LinuxTimespecSecOffset = 0 as Imm32
let X64LinuxTimespecNsecOffset = SpillSlotBytes as Imm32

// `clock_gettime(clockId, &ts)` with the `timespec` in this chunk's own frame — the call every clock chunk
// opens with, and the reason each is a chunk at all: the caller's out-param pointer must survive a call that
// writes somewhere ELSE, so a frame has to hold both.
//
// ⚠ **NO STATUS TEST, AND THAT IS NOT THE OMISSION IT LOOKS LIKE.** `clock_gettime` fails only for an unknown
// `clockid_t` (`EINVAL`) or an unreadable buffer (`EFAULT`); the id is a compile-time constant this file owns
// and the buffer is this frame. Neither is reachable, and an out-param-shaped op with no failure channel
// would have nothing to report if they were.
function x64LinuxReadClockTimespec(asm X64RuntimeAsm, clockId MachineWord)
	encodeMovRegImm32(asm.code, dest: X64Register.rdi, value: clockId)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rsi, base: X64Register.rbp, disp: x64LinuxTimespecDisp(asm))
	encodeX64Syscall(asm.code, number: X64LinuxSyscallClockGettime)
end 'x64LinuxReadClockTimespec'

// The `[rbp + disp]` address of one FIELD of the frame's `timespec`, off the struct's own base — the single
// place the downward slot direction is accounted for.
function x64LinuxTimespecDisp(asm X64RuntimeAsm, byteOffset Imm32 = 0) returns Imm32
	return x64LinuxTimespecFieldDisp(asm, firstSlot: X64LinuxTimespecFirstSlot, byteOffset: byteOffset)
end 'x64LinuxTimespecDisp'

// The same address for a `timespec` a chunk placed SOMEWHERE ELSE in its frame. The three clock chunks all
// put theirs at `X64LinuxTimespecFirstSlot` and read it through the fixed spelling above; the sleep, the timed
// futex wait and the pipe peek each carry one beside other locals, so they name their own first slot.
function x64LinuxTimespecFieldDisp(asm X64RuntimeAsm, firstSlot StackSize, byteOffset Imm32) returns Imm32
	return x64LinuxBufferDisp(asm, firstSlot: firstSlot, slotCount: LinuxTimespecSlots) + byteOffset
end 'x64LinuxTimespecFieldDisp'

// `rax = sec * 1e9 + nsec` — the two halves of the frame's `timespec` combined into the ONE scalar both
// scheduler-facing clock chunks answer with. The WALL clock does not use it: a FILETIME converts each half
// separately, and recombining first would cost five centuries of range for an identical answer.
function x64LinuxEmitTimespecToNanos(asm X64RuntimeAsm)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rbp, disp: x64LinuxTimespecDisp(asm, byteOffset: X64LinuxTimespecSecOffset), wide: true)
	encodeMovRegImm64(asm.code, dest: X64Register.rcx, value: PosixNanosPerSecond as MachineWord)
	encodeImulRegReg(asm.code, dest: X64Register.rax, src: X64Register.rcx)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: x64LinuxTimespecDisp(asm, byteOffset: X64LinuxTimespecNsecOffset), wide: true)
	encodeRmRegDirect(asm.code, opcode: OpcodeAddRmReg, dest: X64Register.rax, src: X64Register.rcx, wide: true)
end 'x64LinuxEmitTimespecToNanos'

// ==========================================================================
// mrt_host_wall_clock(rcx = ftPtr)
// ==========================================================================

// Write the host's CALENDAR through `ftPtr`, as a Win32 FILETIME — 100-nanosecond ticks since 1601. The
// FILETIME encoding is the OP's contract rather than a Windows detail leaking onto a POSIX lane.
//
// The two halves are converted where they already are rather than recombined into nanoseconds first: that
// intermediate would buy nothing (`1e9 / 100` IS `1e7`, so the answer is identical) and would overflow a
// 64-bit word some five centuries sooner than the FILETIME it is on its way to.
function buildX64LinuxWallClockChunk() returns FunctionCodeChunk
	let SlotOutPtr = 0 as StackSize
	var asm = X64RuntimeAsm.beginFunction(1 + LinuxTimespecSlots)

	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotOutPtr), srcReg: X64Register.rcx)
	x64LinuxReadClockTimespec(asm, clockId: LinuxClockRealtime)

	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rbp, disp: x64LinuxTimespecDisp(asm, byteOffset: X64LinuxTimespecSecOffset), wide: true)
	x64LinuxEmitSecondsToFileTime(asm, reg: X64Register.rax, scratch: X64Register.rcx)

	// The nanoseconds half divides down to FILETIME ticks. `div` reads RDX:RAX, so the dividend moves into
	// rax and rdx is cleared — a stale high half faults (#DE) rather than answering wrongly.
	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.r8, src: X64Register.rax, wide: true)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rbp, disp: x64LinuxTimespecDisp(asm, byteOffset: X64LinuxTimespecNsecOffset), wide: true)
	encodeRmRegDirect(asm.code, opcode: OpcodeXorRmReg, dest: X64Register.rdx, src: X64Register.rdx, wide: true)
	encodeMovRegImm64(asm.code, dest: X64Register.rcx, value: posixNanosPerFileTimeTick())
	encodeGrp3Reg(asm.code, ext: Grp3ExtDiv, reg: X64Register.rcx)
	encodeRmRegDirect(asm.code, opcode: OpcodeAddRmReg, dest: X64Register.rax, src: X64Register.r8, wide: true)

	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotOutPtr), wide: true)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rcx, disp: 0, srcReg: X64Register.rax)

	return asm.finishFunction(HostWallClockName)
end 'buildX64LinuxWallClockChunk'

// ==========================================================================
// mrt_host_thread_cpu(rcx = outPtr)
// ==========================================================================

// Write THIS THREAD's consumed CPU time through `outPtr`, in the host's own unit — NANOSECONDS on every POSIX
// lane and TSC ticks on Windows, with nothing converting between them. That is `ClockRuntime`'s stated
// contract rather than this chunk's omission: `__thread_cpu_ticks` promises only that two readings may be
// SUBTRACTED, and scaling here to look like Windows would be a guess wearing a unit's name.
function buildX64LinuxThreadCpuChunk() returns FunctionCodeChunk
	let SlotOutPtr = 0 as StackSize
	var asm = X64RuntimeAsm.beginFunction(1 + LinuxTimespecSlots)

	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotOutPtr), srcReg: X64Register.rcx)
	x64LinuxReadClockTimespec(asm, clockId: LinuxClockThreadCpuTime)
	x64LinuxEmitTimespecToNanos(asm)

	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotOutPtr), wide: true)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rcx, disp: 0, srcReg: X64Register.rax)

	return asm.finishFunction(HostThreadCpuName)
end 'buildX64LinuxThreadCpuChunk'

// ==========================================================================
// mrt_host_exe_path(rcx = bufPtr, rdx = bufLen) -> rax = bytes written
// ==========================================================================

// ⭐⭐ **THE RUNNING IMAGE'S PATH, WHICH ON THIS LANE IS NOT A CALL BUT A SYMLINK.** `GetModuleFileNameA` has
// no Linux counterpart; the kernel publishes `/proc/self/exe`, a symbolic link whose TARGET is the path, so
// this chunk is one `readlinkat(AT_FDCWD, "/proc/self/exe", buf, bufLen)`.
//
// ⛔⛔ **`readlinkat` DOES NOT NUL-TERMINATE AND DOES NOT REPORT TRUNCATION**, and those are the two facts
// this chunk exists for. It answers the byte count it wrote, writes no terminator, and — when the link does
// not fit — SILENTLY TRUNCATES and answers exactly `bufLen`. Both are handled in the vocabulary
// `osExecutablePath` already speaks (`ManagedDirectoryRuntime.emitFilledBufferVerdict`):
//
//   * `n < 0` ⇒ answer **0**, which the Std verdict reads as "refused" and `__proc_exe_path` turns into
//     `pathUnavailable`. ⚠ No errno is stashed, deliberately: nothing consumes an `osLastError` after this
//     op, and stashing would put the `.data` word behind a facility bit that does not lay it out.
//   * `n >= bufLen` ⇒ answer **n unchanged**, which is NOT `< capacity`, so the Std loop doubles its buffer
//     and asks again. That is precisely why the terminator is written only on the fitting path: a `buf[n]`
//     store at `n == bufLen` is a one-byte overrun of a buffer the caller is about to throw away.
//   * otherwise ⇒ terminate at `buf[n]` and answer `n`.
function buildX64LinuxExePathChunk() returns FunctionCodeChunk
	let SlotBufPtr = 0 as StackSize
	let SlotBufLen = 1 as StackSize
	var asm = X64RuntimeAsm.beginFunction(2)

	let unavailable = asm.newLabel()
	let finish = asm.newLabel()

	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotBufPtr), srcReg: X64Register.rcx)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotBufLen), srcReg: X64Register.rdx)

	encodeMovRegImm64(asm.code, dest: X64Register.rdi, value: LinuxAtFdCwd)
	emitLeaString(asm, dest: X64Register.rsi, bytes: LinuxProcSelfExe)
	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.rdx, src: X64Register.rcx, wide: true)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.r10, base: X64Register.rbp, disp: asm.slotDisp(SlotBufLen), wide: true)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallReadlinkat)

	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.less, targetBlockId: unavailable)

	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotBufLen), wide: true)
	encodeRmRegDirect(asm.code, opcode: OpcodeCmpRmReg, dest: X64Register.rax, src: X64Register.rcx, wide: true)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.aboveEqual, targetBlockId: finish)

	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotBufPtr), wide: true)
	encodeRmRegDirect(asm.code, opcode: OpcodeAddRmReg, dest: X64Register.rcx, src: X64Register.rax, wide: true)
	encodeMovRegImm32(asm.code, dest: X64Register.rdx, value: NulByte as MachineWord)
	encodeStoreBaseDispReg8(asm.code, base: X64Register.rcx, disp: 0, srcReg: X64Register.rdx)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: finish)

	asm.placeLabel(unavailable)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: 0)

	asm.placeLabel(finish)
	return asm.finishFunction(HostExePathName)
end 'buildX64LinuxExePathChunk'

// ==========================================================================
// mrt_host_cpu_count() -> rax = usable processors | -1
// ==========================================================================

// ⭐⭐ **`sched_getaffinity` AND A POPCOUNT, BECAUSE `sysconf` IS A LIBC FUNCTION AND THIS IMAGE LINKS NO
// LIBC.** It needs no filesystem — `managedFile` is a separate facility precisely so a machine query does not
// drag one in — and it reports the CPUs THIS PROCESS MAY ACTUALLY USE rather than the CPUs the machine has,
// which is what a parallelism hint wants and what `nproc` itself answers.
//
// ⚠ **THE COUNT IS KERNIGHAN'S `x &= x - 1` RATHER THAN `popcnt`.** `popcnt` needs SSE4.2, which nothing else
// this backend emits requires, so using it here would raise the whole lane's baseline ISA for one
// instruction; the loop's iteration count is the number of SET bits, which on a real machine is the processor
// count itself. The arm64 twin reaches the same loop from the opposite direction (its `CNT` is a NEON op over
// a vector register).
//
// ⚠ **THE ANSWER IS NOT CLAMPED HERE.** A failed syscall reports `LinuxCpuCountUnavailable` (-1), which is
// `sysconf`'s own failure spelling and what `CpuParallelRuntime.buildCpuCount`'s signed `< 1 ⇒ 1` clamp
// already reads — the clamp must stay in exactly one place.
function buildX64LinuxCpuCountChunk() returns FunctionCodeChunk
	let SlotMask = 0 as StackSize
	var asm = X64RuntimeAsm.beginFunction(runtimeFrameSlots(LinuxCpuSetBytes))

	let count = asm.newLabel()
	let wordStep = asm.newLabel()
	let bitStep = asm.newLabel()
	let nextWord = asm.newLabel()
	let finish = asm.newLabel()

	x64LinuxEmitZeroSlots(asm, firstSlot: SlotMask, slotCount: runtimeFrameSlots(LinuxCpuSetBytes))

	encodeMovRegImm32(asm.code, dest: X64Register.rdi, value: LinuxAffinityWhoIsSelf)
	encodeMovRegImm32(asm.code, dest: X64Register.rsi, value: LinuxCpuSetBytes as MachineWord)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rdx, base: X64Register.rbp, disp: x64LinuxBufferDisp(asm, firstSlot: SlotMask, slotCount: runtimeFrameSlots(LinuxCpuSetBytes)))
	encodeX64Syscall(asm.code, number: X64LinuxSyscallSchedGetaffinity)

	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.greaterEqual, targetBlockId: count)
	encodeMovRegImm64(asm.code, dest: X64Register.rax, value: LinuxCpuCountUnavailable)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: finish)

	// rax = the running count, rcx = the cursor, rdx = words left, rsi = the word being drained, rdi = scratch.
	asm.placeLabel(count)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: 0)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rcx, base: X64Register.rbp, disp: x64LinuxBufferDisp(asm, firstSlot: SlotMask, slotCount: runtimeFrameSlots(LinuxCpuSetBytes)))
	encodeMovRegImm32(asm.code, dest: X64Register.rdx, value: runtimeFrameSlots(LinuxCpuSetBytes) as MachineWord)

	asm.placeLabel(wordStep)
	emitCmpRegImm(asm, reg: X64Register.rdx, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: finish)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rsi, base: X64Register.rcx, disp: 0, wide: true)

	asm.placeLabel(bitStep)
	emitCmpRegImm(asm, reg: X64Register.rsi, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: nextWord)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rdi, base: X64Register.rsi, disp: -1)
	encodeRmRegDirect(asm.code, opcode: OpcodeAndRmReg, dest: X64Register.rsi, src: X64Register.rdi, wide: true)
	encodeGrp1RegImm32(asm.code, ext: Grp1ExtAdd, reg: X64Register.rax, imm: 1)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: bitStep)

	asm.placeLabel(nextWord)
	encodeGrp1RegImm32(asm.code, ext: Grp1ExtAdd, reg: X64Register.rcx, imm: SpillSlotBytes as Imm32)
	encodeGrp1RegImm32(asm.code, ext: Grp1ExtSub, reg: X64Register.rdx, imm: 1)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: wordStep)

	asm.placeLabel(finish)
	return asm.finishFunction(HostCpuCountName)
end 'buildX64LinuxCpuCountChunk'

// ==========================================================================
// mrt_host_last_error() -> rax = a Win32 error code
// ==========================================================================

// `GetLastError()` on a lane with no `errno`: read the word every chunk here stashes into, and translate.
function buildX64LinuxLastErrorChunk() returns FunctionCodeChunk
	var asm = X64RuntimeAsm.beginFunction(0)

	x64LinuxEmitLoadErrno(asm, destReg: X64Register.rax)
	x64LinuxEmitErrnoToWin32(asm)

	return asm.finishFunction(HostLastErrorName)
end 'buildX64LinuxLastErrorChunk'

// ==========================================================================
// mrt_host_base_name(rcx = path) -> rax = the byte after the last '/'
// mrt_host_has_wildcard(rcx = cstr) -> rax = 1 | 0
// ==========================================================================

// ⭐⭐ **WHY `FindFirstFileA` NEEDS AN EMULATION AT ALL.** It takes a GLOB — `"temp/things/*.txt"` — and
// POSIX has no call that does: a directory is OPENED by name and a name is matched against a pattern one
// at a time. So the pattern is split at its last `/`, the prefix is opened and the suffix is matched
// against every entry. The pattern is written in USER SOURCE, so the split is the backend's work.
function buildX64LinuxBaseNameChunk() returns FunctionCodeChunk
	var asm = X64RuntimeAsm.beginFunction(0)

	let step = asm.newLabel()
	let notSeparator = asm.newLabel()
	let scanned = asm.newLabel()

	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.rdx, src: X64Register.rcx, wide: true)
	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.rax, src: X64Register.rcx, wide: true)

	asm.placeLabel(step)
	encodeMovzxRegByteBaseDisp(asm.code, destReg: X64Register.r8, base: X64Register.rdx, disp: 0)
	emitCmpRegImm(asm, reg: X64Register.r8, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: scanned)
	emitCmpRegImm(asm, reg: X64Register.r8, imm: PosixPathSeparatorByte as Imm32)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.notEqual, targetBlockId: notSeparator)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rax, base: X64Register.rdx, disp: 1)

	asm.placeLabel(notSeparator)
	encodeGrp1RegImm32(asm.code, ext: Grp1ExtAdd, reg: X64Register.rdx, imm: 1)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: step)

	asm.placeLabel(scanned)
	return asm.finishFunction(HostBaseNameName)
end 'buildX64LinuxBaseNameChunk'

// Does this base name carry a wildcard? A pattern with neither `*` nor `?` names ONE path, and answering
// it with a single `stat` rather than a directory walk is both faster and MORE FAITHFUL: `FindFirstFileA`
// matches a literal name the way the FILESYSTEM does, while the pattern matcher below is case-sensitive.
function buildX64LinuxHasWildcardChunk() returns FunctionCodeChunk
	var asm = X64RuntimeAsm.beginFunction(0)

	let step = asm.newLabel()
	let found = asm.newLabel()
	let plain = asm.newLabel()
	let answered = asm.newLabel()

	asm.placeLabel(step)
	encodeMovzxRegByteBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rcx, disp: 0)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: plain)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: PosixGlobStarByte as Imm32)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: found)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: PosixGlobQuestionByte as Imm32)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: found)
	encodeGrp1RegImm32(asm.code, ext: Grp1ExtAdd, reg: X64Register.rcx, imm: 1)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: step)

	asm.placeLabel(found)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: 1)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: answered)

	asm.placeLabel(plain)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: 0)

	asm.placeLabel(answered)
	return asm.finishFunction(HostHasWildcardName)
end 'buildX64LinuxHasWildcardChunk'

// ==========================================================================
// mrt_host_attrs_from_mode(rcx = statBufPtr) -> rax = dwFileAttributes
// ==========================================================================

// Only the two bits the corpus can observe are produced — `__mf_exists` reads DIRECTORY, `__mf_stat`
// publishes DIRECTORY and READ-ONLY — and an ordinary file gets `FILE_ATTRIBUTE_NORMAL` rather than 0,
// because 0 is not a mask Win32 ever answers.
//
// ⚠ **READ-ONLY IS THE OWNER'S WRITE BIT AND NOTHING FINER.** POSIX has three write bits and Win32 has one
// flag; the owner's is the one that decides whether the process that just created the file can write it.
function buildX64LinuxAttrsFromModeChunk(layout PosixStatLayout) returns FunctionCodeChunk
	var asm = X64RuntimeAsm.beginFunction(0)

	let isDirectory = asm.newLabel()
	let haveType = asm.newLabel()
	let answered = asm.newLabel()

	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdx, base: X64Register.rcx, disp: layout.modeOffset as Imm32, wide: false)
	encodeGrp1RegImm32(asm.code, ext: Grp1ExtAnd, reg: X64Register.rdx, imm: PosixModeMask as Imm32)

	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.r8, src: X64Register.rdx, wide: true)
	encodeGrp1RegImm32(asm.code, ext: Grp1ExtAnd, reg: X64Register.r8, imm: PosixFileTypeMask as Imm32)
	emitCmpRegImm(asm, reg: X64Register.r8, imm: PosixFileTypeDirectory as Imm32)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: isDirectory)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: FileAttributeNormal as MachineWord)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: haveType)

	asm.placeLabel(isDirectory)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: FileAttributeDirectory as MachineWord)

	asm.placeLabel(haveType)
	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.r8, src: X64Register.rdx, wide: true)
	encodeGrp1RegImm32(asm.code, ext: Grp1ExtAnd, reg: X64Register.r8, imm: PosixOwnerWriteBit as Imm32)
	emitCmpRegImm(asm, reg: X64Register.r8, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.notEqual, targetBlockId: answered)
	encodeGrp1RegImm32(asm.code, ext: Grp1ExtOr, reg: X64Register.rax, imm: FileAttributeReadOnly as Imm32)

	asm.placeLabel(answered)
	return asm.finishFunction(HostAttrsFromModeName)
end 'buildX64LinuxAttrsFromModeChunk'

// ==========================================================================
// mrt_host_fill_find_data(rcx = findDataPtr, rdx = statBufPtr, r8 = namePtr)
// ==========================================================================

// ⭐⭐ **SYNTHESIZE THE 320-BYTE `WIN32_FIND_DATAA` FROM A `struct stat` AND A NAME.** Windows fills this
// record itself; every field here has to be produced, and the offsets come from `ManagedFileRuntime` — the
// file that READS them back — rather than being transcribed.
//
// ⚠ **THE ATTRIBUTE STORE COMES FIRST AND THE ORDER IS LOAD-BEARING.** The mask is a DWORD at offset 0 and
// the narrowest store used here writes eight bytes, so it also clears 4..7 — the low half of
// `ftCreationTime`. Writing the creation time SECOND repairs that by construction.
//
// ⚠ **THE TWO SIZE DWORDS ARE ONE UNALIGNED 64-BIT STORE**, and the halves are swapped to get there:
// `nFileSizeHigh` sits at 28 and `nFileSizeLow` at 32, so on a little-endian machine the word that lands
// correctly is `(low << 32) | high` — a 64-bit rotate of the size by 32. x86-64 permits the unaligned
// store outright, where AArch64's twin has to route it through a scratch register.
function buildX64LinuxFillFindDataChunk(layout PosixStatLayout) returns FunctionCodeChunk
	let SlotFindData = 0 as StackSize
	let SlotStat = 1 as StackSize
	let SlotName = 2 as StackSize
	var asm = X64RuntimeAsm.beginFunction(3)

	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotFindData), srcReg: X64Register.rcx)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotStat), srcReg: X64Register.rdx)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotName), srcReg: X64Register.r8)

	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotStat), wide: true)
	encodeCallDirect(asm.code, callFixups: asm.callFixups, targetName: HostAttrsFromModeName)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdx, base: X64Register.rbp, disp: asm.slotDisp(SlotFindData), wide: true)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rdx, disp: FindDataAttributesOffset as Imm32, srcReg: X64Register.rax)

	x64LinuxFillFindDataTime(asm, statSlot: SlotStat, findSlot: SlotFindData, statOffset: layout.creationTimeOffset as Imm32, findOffset: FindDataCreationTimeOffset)
	x64LinuxFillFindDataTime(asm, statSlot: SlotStat, findSlot: SlotFindData, statOffset: layout.accessTimeOffset as Imm32, findOffset: FindDataLastAccessTimeOffset)
	x64LinuxFillFindDataTime(asm, statSlot: SlotStat, findSlot: SlotFindData, statOffset: layout.modifyTimeOffset as Imm32, findOffset: FindDataLastWriteTimeOffset)

	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdx, base: X64Register.rbp, disp: asm.slotDisp(SlotStat), wide: true)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rdx, disp: layout.sizeOffset as Imm32, wide: true)
	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.rsi, src: X64Register.rax, wide: true)
	encodeGrp2RegImm8(asm.code, ext: Grp2ExtShr, reg: X64Register.rsi, count: X64SizeHalfShift)
	encodeGrp2RegImm8(asm.code, ext: Grp2ExtShl, reg: X64Register.rax, count: X64SizeHalfShift)
	encodeRmRegDirect(asm.code, opcode: OpcodeOrRmReg, dest: X64Register.rax, src: X64Register.rsi, wide: true)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdx, base: X64Register.rbp, disp: asm.slotDisp(SlotFindData), wide: true)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rdx, disp: FindDataSizeHighOffset as Imm32, srcReg: X64Register.rax)

	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rsi, base: X64Register.rbp, disp: asm.slotDisp(SlotName), wide: true)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdi, base: X64Register.rbp, disp: asm.slotDisp(SlotFindData), wide: true)
	encodeGrp1RegImm32(asm.code, ext: Grp1ExtAdd, reg: X64Register.rdi, imm: FindDataFileNameOffset as Imm32)
	encodeMovRegImm32(asm.code, dest: X64Register.r10, value: PosixPathStringCapacity as MachineWord)
	x64LinuxEmitCopyCStringBounded(asm, src: X64Register.rsi, dest: X64Register.rdi, limit: X64Register.r10, scratch: X64Register.rax)

	return asm.finishFunction(HostFillFindDataName)
end 'buildX64LinuxFillFindDataChunk'

// How far a 64-bit size rotates to swap its halves — `nFileSizeHigh` precedes `nFileSizeLow` in the record.
let X64SizeHalfShift = 32 as ShiftCount

// One `struct stat` timestamp into one `WIN32_FIND_DATAA` FILETIME field.
function x64LinuxFillFindDataTime(asm X64RuntimeAsm, statSlot StackSize, findSlot StackSize, statOffset Imm32, findOffset Imm32)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdx, base: X64Register.rbp, disp: asm.slotDisp(statSlot), wide: true)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rdx, disp: statOffset, wide: true)
	x64LinuxEmitSecondsToFileTime(asm, reg: X64Register.rax, scratch: X64Register.rsi)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdx, base: X64Register.rbp, disp: asm.slotDisp(findSlot), wide: true)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rdx, disp: findOffset, srcReg: X64Register.rax)
end 'x64LinuxFillFindDataTime'

// ==========================================================================
// mrt_host_file_open(rcx = path, rdx = flags, r8 = mode) -> rax = fd | -1
// ==========================================================================

// `openat(AT_FDCWD, path, flags, mode)`. It is a CHUNK rather than an inline isel sequence for two
// reasons: the kernel answers `-errno` where the Std tier tests for exactly `-1`, and the reason has to be
// stashed for the `osLastError` that follows.
function buildX64LinuxFileOpenChunk() returns FunctionCodeChunk
	var asm = X64RuntimeAsm.beginFunction(0)

	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.r10, src: X64Register.r8, wide: true)
	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.rsi, src: X64Register.rcx, wide: true)
	encodeMovRegImm64(asm.code, dest: X64Register.rdi, value: LinuxAtFdCwd)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallOpenat)

	x64LinuxEmitStashIfFailed(asm)
	x64LinuxEmitFailureSentinel(asm, sentinel: PosixInvalidHandle)

	return asm.finishFunction(HostFileOpenName)
end 'buildX64LinuxFileOpenChunk'

// ==========================================================================
// mrt_host_read_file / mrt_host_write_file
//   (rcx = fd, rdx = buf, r8 = len, r9 = bytesOutPtr) -> rax = BOOL
// ==========================================================================

// ⭐⭐ **`ReadFile`/`WriteFile`'s SHAPE OVER A CALL THAT ANSWERS THE COUNT IN rax.** The Win32 pair return a
// BOOL and write the transferred count through a pointer; `read`/`write` return the count (or `-errno`)
// and write nothing. So the pointer has to OUTLIVE the syscall and the two answers separated afterwards.
//
// ⛔⛔ **A FAILURE STORES `0` THROUGH THE OUT-PARAM AND NEVER THE NEGATIVE.** `ConsoleRuntime`'s
// `__con_read_stdin` publishes that word directly as an `Array`'s LENGTH, and a negative length is a
// corrupt array rather than a failed read.
//
// ⚠ **ONE BUILDER, TWO CHUNKS**: read and write differ in a syscall number and in nothing else.
function buildX64LinuxTransferChunk(name ByteArray, syscallNumber MachineWord) returns FunctionCodeChunk
	let SlotOutPtr = 0 as StackSize
	var asm = X64RuntimeAsm.beginFunction(1)

	let transferred = asm.newLabel()
	let answered = asm.newLabel()

	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotOutPtr), srcReg: X64Register.r9)
	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.rdi, src: X64Register.rcx, wide: true)
	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.rsi, src: X64Register.rdx, wide: true)
	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.rdx, src: X64Register.r8, wide: true)
	encodeX64Syscall(asm.code, number: syscallNumber)

	x64LinuxEmitStashIfFailed(asm)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdx, base: X64Register.rbp, disp: asm.slotDisp(SlotOutPtr), wide: true)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.greaterEqual, targetBlockId: transferred)

	encodeMovRegImm32(asm.code, dest: X64Register.rsi, value: 0)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rdx, disp: 0, srcReg: X64Register.rsi)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: Win32False as MachineWord)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: answered)

	asm.placeLabel(transferred)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rdx, disp: 0, srcReg: X64Register.rax)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: Win32True as MachineWord)

	asm.placeLabel(answered)
	return asm.finishFunction(name)
end 'buildX64LinuxTransferChunk'

// ==========================================================================
// mrt_host_file_size(rcx = fd, rdx = sizeOutPtr) -> rax = BOOL
// ==========================================================================

// `GetFileSizeEx` — a BOOL plus a 64-bit size through a pointer, which is `fstat` plus one field read.
//
// ⚠ **NOTHING IS WRITTEN THROUGH THE POINTER ON FAILURE, AND THE CALLER ALREADY RELIES ON THAT.** The
// scratch word comes from `ManagedFileRuntime.emitWin32OutWord`, i.e. from `__mm_alloc`, which hands out
// ZEROED memory as a stated guarantee — and `emitWin32BoolOutcome` reads the word on both paths.
function buildX64LinuxFileSizeChunk() returns FunctionCodeChunk
	let SlotOutPtr = 0 as StackSize
	let SlotStat = 1 as StackSize
	let statSlots = runtimeFrameSlots(x64LinuxStatLayout().bytes)
	var asm = X64RuntimeAsm.beginFunction(1 + statSlots)
	let statDisp = x64LinuxBufferDisp(asm, firstSlot: SlotStat, slotCount: statSlots)

	let measured = asm.newLabel()
	let answered = asm.newLabel()

	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotOutPtr), srcReg: X64Register.rdx)
	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.rdi, src: X64Register.rcx, wide: true)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rsi, base: X64Register.rbp, disp: statDisp)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallFstat)
	x64LinuxEmitStashIfFailed(asm)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.greaterEqual, targetBlockId: measured)

	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: Win32False as MachineWord)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: answered)

	asm.placeLabel(measured)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rsi, base: X64Register.rbp, disp: statDisp)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rsi, disp: X64LinuxStatSizeOffset, wide: true)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rsi, base: X64Register.rbp, disp: asm.slotDisp(SlotOutPtr), wide: true)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rsi, disp: 0, srcReg: X64Register.rax)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: Win32True as MachineWord)

	asm.placeLabel(answered)
	return asm.finishFunction(HostFileSizeName)
end 'buildX64LinuxFileSizeChunk'

// ==========================================================================
// mrt_host_file_delete(rcx = pathPtr) -> rax = BOOL
// mrt_host_dir_create(rcx = pathPtr) -> rax = BOOL
// ==========================================================================

// `DeleteFileA` ⇒ `unlinkat(AT_FDCWD, path, 0)` and `CreateDirectoryA(path, NULL)` ⇒
// `mkdirat(AT_FDCWD, path, 0777)`. ONE BUILDER: both take a path and a third word — a flag word that must
// be zero for the unlink, a permission mask for the mkdir — and answer a verdict the same way.
//
// The Win32 directory create carries no permissions at all (a new directory inherits its parent's ACL), so
// the POSIX side hands the widest mask over and lets the process umask narrow it.
function buildX64LinuxPathOpChunk(name ByteArray, syscallNumber MachineWord, thirdArgument MachineWord) returns FunctionCodeChunk
	var asm = X64RuntimeAsm.beginFunction(0)

	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.rsi, src: X64Register.rcx, wide: true)
	encodeMovRegImm32(asm.code, dest: X64Register.rdx, value: thirdArgument)
	encodeMovRegImm64(asm.code, dest: X64Register.rdi, value: LinuxAtFdCwd)
	encodeX64Syscall(asm.code, number: syscallNumber)
	x64LinuxEmitWin32BoolFromSyscall(asm)

	return asm.finishFunction(name)
end 'buildX64LinuxPathOpChunk'

// ==========================================================================
// mrt_host_file_rename(rcx = oldPathPtr, rdx = newPathPtr) -> rax = BOOL
// ==========================================================================

// ⭐⭐ **`MoveFileExA(old, new, MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH)` IS TWO PROMISES AND
// `renameat` KEEPS ONLY ONE.** The REPLACE is free: POSIX `rename` replaces an existing destination
// atomically. The WRITE-THROUGH is not: POSIX records a rename's durability in the DESTINATION
// DIRECTORY's metadata, so keeping the second promise means opening that directory and `fsync`ing it.
//
// ⚠ **THE DURABILITY STEP IS BEST-EFFORT AND ITS FAILURES ARE DELIBERATELY NOT REPORTED.** The rename has
// already happened and is already visible; a caller told "the rename failed" because the parent directory
// could not be opened would delete or retry something that is in fact in place.
//
// ⚠ **AND NOTHING BELOW THE RENAME MAY STASH AN errno**, for the same reason: the word is read by an
// `osLastError` the Std tier emits immediately after this call, and a `fsync` that failed would be blamed
// for a rename that succeeded.
function buildX64LinuxFileRenameChunk() returns FunctionCodeChunk
	let SlotNewPath = 0 as StackSize
	let SlotDirFd = 1 as StackSize
	let SlotPrefix = 2 as StackSize
	let prefixSlots = runtimeFrameSlots(MaxPathBytes)
	var asm = X64RuntimeAsm.beginFunction(2 + prefixSlots)
	let prefixDisp = x64LinuxBufferDisp(asm, firstSlot: SlotPrefix, slotCount: prefixSlots)

	let renamed = asm.newLabel()
	let released = asm.newLabel()
	let answered = asm.newLabel()

	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotNewPath), srcReg: X64Register.rdx)
	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.r10, src: X64Register.rdx, wide: true)
	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.rsi, src: X64Register.rcx, wide: true)
	encodeMovRegImm64(asm.code, dest: X64Register.rdi, value: LinuxAtFdCwd)
	encodeMovRegImm64(asm.code, dest: X64Register.rdx, value: LinuxAtFdCwd)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallRenameat)
	x64LinuxEmitStashIfFailed(asm)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.greaterEqual, targetBlockId: renamed)

	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: Win32False as MachineWord)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: answered)

	asm.placeLabel(renamed)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotNewPath), wide: true)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rdx, base: X64Register.rbp, disp: prefixDisp)
	encodeCallDirect(asm.code, callFixups: asm.callFixups, targetName: LinuxDirPrefixName)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: released)

	encodeLeaRegRegImm32(asm.code, dest: X64Register.rsi, base: X64Register.rbp, disp: prefixDisp)
	encodeMovRegImm32(asm.code, dest: X64Register.rdx, value: PosixOpenReadOnly)
	encodeMovRegImm32(asm.code, dest: X64Register.r10, value: PosixNoFileMode as MachineWord)
	encodeMovRegImm64(asm.code, dest: X64Register.rdi, value: LinuxAtFdCwd)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallOpenat)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotDirFd), srcReg: X64Register.rax)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.less, targetBlockId: released)

	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.rdi, src: X64Register.rax, wide: true)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallFsync)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdi, base: X64Register.rbp, disp: asm.slotDisp(SlotDirFd), wide: true)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallClose)

	asm.placeLabel(released)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: Win32True as MachineWord)

	asm.placeLabel(answered)
	return asm.finishFunction(HostFileRenameName)
end 'buildX64LinuxFileRenameChunk'

// ==========================================================================
// mrt_host_file_attributes(rcx = pathPtr) -> rax = dwFileAttributes
// ==========================================================================

// `GetFileAttributesA` — the mask, or `INVALID_FILE_ATTRIBUTES` for a path that names nothing. It is a
// `stat` and the shared mask derivation, which is what keeps `__md_exists`'s answer and the DIRECTORY bit
// `__mf_stat` publishes derived from ONE reading of `st_mode`.
function buildX64LinuxFileAttributesChunk() returns FunctionCodeChunk
	let SlotStat = 0 as StackSize
	let statSlots = runtimeFrameSlots(x64LinuxStatLayout().bytes)
	var asm = X64RuntimeAsm.beginFunction(statSlots)
	let statDisp = x64LinuxBufferDisp(asm, firstSlot: SlotStat, slotCount: statSlots)

	let described = asm.newLabel()
	let answered = asm.newLabel()

	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.r8, src: X64Register.rcx, wide: true)
	encodeMovRegImm64(asm.code, dest: X64Register.r9, value: LinuxAtFdCwd)
	x64LinuxEmitFstatat(asm, statDisp: statDisp)
	x64LinuxEmitStashIfFailed(asm)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.greaterEqual, targetBlockId: described)

	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: InvalidFileAttributes as MachineWord)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: answered)

	asm.placeLabel(described)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rcx, base: X64Register.rbp, disp: statDisp)
	encodeCallDirect(asm.code, callFixups: asm.callFixups, targetName: HostAttrsFromModeName)

	asm.placeLabel(answered)
	return asm.finishFunction(HostFileAttributesName)
end 'buildX64LinuxFileAttributesChunk'

// ==========================================================================
// mrt_host_dir_current_path(rcx = bufPtr, rdx = bufLen) -> rax = bytes written
// ==========================================================================

// ⭐⭐ **`GetCurrentDirectoryA`'s THREE-WAY ANSWER.** The op's contract
// (`ManagedDirectoryRuntime.emitFilledBufferVerdict`) reads `0` as failure, `< capacity` as "it fits, NUL
// included" and anything else as "too small". Linux's `getcwd` SYSCALL answers the byte LENGTH INCLUDING
// the terminator, or `-errno`, so the fit case is one subtraction and the classification one compare
// against `ERANGE`.
//
// ⚠ **THE SUBTRACTION IS NOT COSMETIC.** Answering the kernel's count would report `capacity` for a path
// that exactly fills the buffer — which the contract reads as "too small" — and would send
// `__md_current_path` round its doubling loop for a path that had in fact fitted.
//
// ⛔ **REPORTING "TOO SMALL" FOR A REAL FAILURE WOULD SPIN THE CALLER'S DOUBLING LOOP FOREVER**, and
// reporting a failure for a too-small buffer would throw on a long path.
function buildX64LinuxDirCurrentPathChunk() returns FunctionCodeChunk
	let SlotBufLen = 0 as StackSize
	var asm = X64RuntimeAsm.beginFunction(1)

	let refused = asm.newLabel()
	let tooSmall = asm.newLabel()
	let answered = asm.newLabel()

	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotBufLen), srcReg: X64Register.rdx)
	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.rdi, src: X64Register.rcx, wide: true)
	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.rsi, src: X64Register.rdx, wide: true)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallGetcwd)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.less, targetBlockId: refused)

	encodeGrp1RegImm32(asm.code, ext: Grp1ExtSub, reg: X64Register.rax, imm: 1)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: answered)

	// `x64LinuxEmitStashErrno` leaves the POSITIVE errno in rsi, which is exactly the value the `ERANGE`
	// test needs — so the reason is published and classified from one negation.
	asm.placeLabel(refused)
	x64LinuxEmitStashErrno(asm)
	emitCmpRegImm(asm, reg: X64Register.rsi, imm: PosixErrnoResultTooLarge as Imm32)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: tooSmall)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: 0)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: answered)

	// The "too small" answer is the CAPACITY ITSELF and not a required size, because POSIX has no call that
	// reports the length of a working directory — `__md_current_path` therefore DOUBLES rather than
	// retrying at a named size.
	asm.placeLabel(tooSmall)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rbp, disp: asm.slotDisp(SlotBufLen), wide: true)

	asm.placeLabel(answered)
	return asm.finishFunction(HostDirCurrentPathName)
end 'buildX64LinuxDirCurrentPathChunk'

// ==========================================================================
// mrt_linux_glob_match(rcx = pattern, rdx = name) -> rax = 1 | 0
// ==========================================================================

// ⭐⭐ **`fnmatch(pattern, string, 0)`, WRITTEN OUT, BECAUSE A STATIC IMAGE LINKS NO libc.** The classic
// backtracking matcher over `*` and `?` — the only two wildcards `FindFirstFileA` honours and the only two
// the corpus writes.
//
// ⚠ **IT REPRODUCES `fnmatch`'s FLAG-ZERO BEHAVIOUR, NOT `FNM_PATHNAME`'s.** A `*` matches a leading dot
// (so `*` yields `.` and `..`, exactly as `FindFirstFileA` does, and the Std tier's dot filter removes
// them) and nothing here treats `/` specially — which costs nothing, because the pattern reaching it is
// always a BASE NAME.
//
// ⭐ **THE BACKTRACK IS A SAVED PAIR, NOT RECURSION.** `star` remembers the pattern position just past the
// last `*` and `resume` the name position it was first tried at; a mismatch rewinds to those and advances
// `resume` by one, which is what lets one `*` absorb any number of characters without a stack.
function buildX64LinuxGlobMatchChunk() returns FunctionCodeChunk
	var asm = X64RuntimeAsm.beginFunction(0)

	let pattern = X64Register.rcx
	let name = X64Register.rdx
	let star = X64Register.r8
	let resume = X64Register.r9
	let patternByte = X64Register.r10
	let nameByte = X64Register.rax

	let step = asm.newLabel()
	let notStar = asm.newLabel()
	let advance = asm.newLabel()
	let backtrack = asm.newLabel()
	let nameSpent = asm.newLabel()
	let matched = asm.newLabel()
	let refused = asm.newLabel()
	let answered = asm.newLabel()

	encodeMovRegImm32(asm.code, dest: star, value: 0)
	encodeMovRegImm32(asm.code, dest: resume, value: 0)

	asm.placeLabel(step)
	encodeMovzxRegByteBaseDisp(asm.code, destReg: nameByte, base: name, disp: 0)
	emitCmpRegImm(asm, reg: nameByte, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: nameSpent)
	encodeMovzxRegByteBaseDisp(asm.code, destReg: patternByte, base: pattern, disp: 0)

	emitCmpRegImm(asm, reg: patternByte, imm: PosixGlobQuestionByte as Imm32)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: advance)

	emitCmpRegImm(asm, reg: patternByte, imm: PosixGlobStarByte as Imm32)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.notEqual, targetBlockId: notStar)
	encodeGrp1RegImm32(asm.code, ext: Grp1ExtAdd, reg: pattern, imm: 1)
	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: star, src: pattern, wide: true)
	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: resume, src: name, wide: true)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: step)

	// A literal byte. It cannot be the pattern's NUL here — the name still has a byte, and a NUL never
	// equals it — so the equal case really is a match and the unequal case really is a mismatch.
	asm.placeLabel(notStar)
	encodeRmRegDirect(asm.code, opcode: OpcodeCmpRmReg, dest: patternByte, src: nameByte, wide: true)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.notEqual, targetBlockId: backtrack)

	asm.placeLabel(advance)
	encodeGrp1RegImm32(asm.code, ext: Grp1ExtAdd, reg: pattern, imm: 1)
	encodeGrp1RegImm32(asm.code, ext: Grp1ExtAdd, reg: name, imm: 1)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: step)

	asm.placeLabel(backtrack)
	emitCmpRegImm(asm, reg: star, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: refused)
	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: pattern, src: star, wide: true)
	encodeGrp1RegImm32(asm.code, ext: Grp1ExtAdd, reg: resume, imm: 1)
	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: name, src: resume, wide: true)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: step)

	// The name is spent: what is left of the pattern must be `*`s and nothing else.
	asm.placeLabel(nameSpent)
	encodeMovzxRegByteBaseDisp(asm.code, destReg: patternByte, base: pattern, disp: 0)
	emitCmpRegImm(asm, reg: patternByte, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: matched)
	emitCmpRegImm(asm, reg: patternByte, imm: PosixGlobStarByte as Imm32)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.notEqual, targetBlockId: refused)
	encodeGrp1RegImm32(asm.code, ext: Grp1ExtAdd, reg: pattern, imm: 1)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: nameSpent)

	asm.placeLabel(matched)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: 1)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: answered)

	asm.placeLabel(refused)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: 0)

	asm.placeLabel(answered)
	return asm.finishFunction(LinuxGlobMatchName)
end 'buildX64LinuxGlobMatchChunk'

// ==========================================================================
// mrt_linux_dir_prefix(rcx = path, rdx = destBuf) -> rax = 1 | 0
// ==========================================================================

// The DIRECTORY half of a path, written into a caller-supplied `MAX_PATH` buffer. Three shapes, and each
// is a real one the corpus writes:
//
//   `"temp/x/*.txt"` ⇒ `"temp/x"`   — the prefix without its trailing separator
//   `"/x"`           ⇒ `"/"`        — the root, which is the ONE case where the separator IS the directory
//   `"*.txt"`        ⇒ `"."`        — no separator at all means the CURRENT directory
//
// ⛔⛔ **A PREFIX THAT DOES NOT FIT IS A REFUSAL, NEVER A TRUNCATION.** A truncated directory path is not a
// path that fails to open — it can NAME A DIFFERENT DIRECTORY THAT EXISTS, and the walk would then list
// the wrong one and report success.
function buildX64LinuxDirPrefixChunk() returns FunctionCodeChunk
	let SlotPath = 0 as StackSize
	let SlotDest = 1 as StackSize
	let SlotLength = 2 as StackSize
	var asm = X64RuntimeAsm.beginFunction(3)

	let currentDirectory = asm.newLabel()
	let haveLength = asm.newLabel()
	let tooLong = asm.newLabel()
	let answered = asm.newLabel()

	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotPath), srcReg: X64Register.rcx)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotDest), srcReg: X64Register.rdx)
	encodeCallDirect(asm.code, callFixups: asm.callFixups, targetName: HostBaseNameName)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdx, base: X64Register.rbp, disp: asm.slotDisp(SlotPath), wide: true)
	encodeRmRegDirect(asm.code, opcode: OpcodeSubRmReg, dest: X64Register.rax, src: X64Register.rdx, wide: true)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: currentDirectory)

	// The prefix INCLUDES the separator, so the directory is one byte shorter — except at the root, where
	// dropping it would leave the empty string and an `openat("")` fails with ENOENT.
	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.rdx, src: X64Register.rax, wide: true)
	encodeGrp1RegImm32(asm.code, ext: Grp1ExtSub, reg: X64Register.rdx, imm: 1)
	emitCmpRegImm(asm, reg: X64Register.rdx, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.notEqual, targetBlockId: haveLength)
	encodeMovRegImm32(asm.code, dest: X64Register.rdx, value: 1)

	asm.placeLabel(haveLength)
	emitCmpRegImm(asm, reg: X64Register.rdx, imm: PosixPathStringCapacity as Imm32)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.greater, targetBlockId: tooLong)

	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rsi, base: X64Register.rbp, disp: asm.slotDisp(SlotPath), wide: true)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdi, base: X64Register.rbp, disp: asm.slotDisp(SlotDest), wide: true)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotLength), srcReg: X64Register.rdx)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.r10, base: X64Register.rbp, disp: asm.slotDisp(SlotLength), wide: true)
	x64LinuxEmitCopyCStringBounded(asm, src: X64Register.rsi, dest: X64Register.rdi, limit: X64Register.r10, scratch: X64Register.rax)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: 1)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: answered)

	// No separator: the two bytes `"."` — written directly rather than copied out of a constant, because a
	// two-byte string is shorter than the code that would address one.
	asm.placeLabel(currentDirectory)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdx, base: X64Register.rbp, disp: asm.slotDisp(SlotDest), wide: true)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: DotByte as MachineWord)
	encodeStoreBaseDispReg8(asm.code, base: X64Register.rdx, disp: 0, srcReg: X64Register.rax)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: NulByte as MachineWord)
	encodeStoreBaseDispReg8(asm.code, base: X64Register.rdx, disp: 1, srcReg: X64Register.rax)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: 1)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: answered)

	asm.placeLabel(tooLong)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: 0)

	asm.placeLabel(answered)
	return asm.finishFunction(LinuxDirPrefixName)
end 'buildX64LinuxDirPrefixChunk'

// ==========================================================================
// mrt_host_dir_find_next(rcx = search, rdx = findDataPtr) -> rax = BOOL
// ==========================================================================

// ⭐⭐ **`FindNextFileA` — AND ALSO THE WHOLE OF `FindFirstFileA`'s FIRST ENTRY**, which is why
// `find_first` below calls this rather than carrying a second copy of the walk. Win32's first and
// subsequent entries come from one enumeration; so do these.
//
// The loop: clear the errno word, take the next directory entry, match it against the pattern, and
// describe the first one that matches. An exhausted enumeration leaves the word CLEAR, which the caller
// reads as `ERROR_NO_MORE_FILES` (`PosixErrnoCleared`), and a `getdents64` that FAILS stashes its own
// reason — so the same FALSE carries both answers exactly as Win32's does.
//
// ⚠ **`getdents64` REFILLS A BUFFER, WHERE `readdir` ANSWERS ONE ENTRY.** The search carries a cursor and
// a filled count, and the syscall runs only when the cursor has caught up. A `0` from it is
// end-of-directory; a negative is a failure.
//
// ⚠ **A SEARCH WITH A NEGATIVE `dirfd` IS EXHAUSTED, NOT BROKEN** — the single-`stat` route already
// reported its one entry. The guard is INSIDE the loop head, after the errno clear, so that exit reports
// end-of-iteration rather than a stale failure.
//
// ⚠ **`fstatat`'s VERDICT IS DELIBERATELY DISCARDED AND THE BUFFER IS ZEROED FIRST.** A dangling symbolic
// link is a real directory entry that Win32 reports; skipping it would silently shorten a listing, and
// reading a stat buffer the call did not fill would report the PREVIOUS entry's size and timestamps.
function buildX64LinuxDirFindNextChunk() returns FunctionCodeChunk
	let SlotSearch = 0 as StackSize
	let SlotFindData = 1 as StackSize
	let SlotName = 2 as StackSize
	let SlotStat = 3 as StackSize
	let statSlots = runtimeFrameSlots(x64LinuxStatLayout().bytes)
	var asm = X64RuntimeAsm.beginFunction(3 + statSlots)
	let statDisp = x64LinuxBufferDisp(asm, firstSlot: SlotStat, slotCount: statSlots)

	let nextEntry = asm.newLabel()
	let haveEntry = asm.newLabel()
	let exhausted = asm.newLabel()
	let answered = asm.newLabel()

	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotSearch), srcReg: X64Register.rcx)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotFindData), srcReg: X64Register.rdx)

	asm.placeLabel(nextEntry)
	x64LinuxEmitPublishErrno(asm, value: PosixErrnoCleared)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.r8, base: X64Register.rbp, disp: asm.slotDisp(SlotSearch), wide: true)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.r9, base: X64Register.r8, disp: LinuxSearchDirFdOffset, wide: true)
	emitCmpRegImm(asm, reg: X64Register.r9, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.less, targetBlockId: exhausted)

	// Is there an entry left in the buffer? Cursor and filled are both byte counts into the entries region.
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.r10, base: X64Register.r8, disp: LinuxSearchCursorOffset, wide: true)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdx, base: X64Register.r8, disp: LinuxSearchFilledOffset, wide: true)
	encodeRmRegDirect(asm.code, opcode: OpcodeCmpRmReg, dest: X64Register.r10, src: X64Register.rdx, wide: true)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.less, targetBlockId: haveEntry)

	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.rdi, src: X64Register.r9, wide: true)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rsi, base: X64Register.r8, disp: LinuxSearchEntriesOffset)
	encodeMovRegImm32(asm.code, dest: X64Register.rdx, value: LinuxSearchEntriesBytes as MachineWord)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallGetdents64)
	x64LinuxEmitStashIfFailed(asm)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.lessEqual, targetBlockId: exhausted)

	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.r8, base: X64Register.rbp, disp: asm.slotDisp(SlotSearch), wide: true)
	encodeStoreBaseDispReg(asm.code, base: X64Register.r8, disp: LinuxSearchFilledOffset, srcReg: X64Register.rax)
	encodeMovRegImm32(asm.code, dest: X64Register.rdx, value: 0)
	encodeStoreBaseDispReg(asm.code, base: X64Register.r8, disp: LinuxSearchCursorOffset, srcReg: X64Register.rdx)

	// `entry = search + entriesOffset + cursor`, and the cursor steps by the entry's own `d_reclen`.
	asm.placeLabel(haveEntry)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.r8, base: X64Register.rbp, disp: asm.slotDisp(SlotSearch), wide: true)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.r10, base: X64Register.r8, disp: LinuxSearchCursorOffset, wide: true)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.r9, base: X64Register.r8, disp: LinuxSearchEntriesOffset)
	encodeRmRegDirect(asm.code, opcode: OpcodeAddRmReg, dest: X64Register.r9, src: X64Register.r10, wide: true)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdx, base: X64Register.r9, disp: LinuxDirentRecordLengthOffset, wide: false)
	encodeGrp1RegImm32(asm.code, ext: Grp1ExtAnd, reg: X64Register.rdx, imm: LinuxDirentRecordLengthMask)
	encodeRmRegDirect(asm.code, opcode: OpcodeAddRmReg, dest: X64Register.r10, src: X64Register.rdx, wide: true)
	encodeStoreBaseDispReg(asm.code, base: X64Register.r8, disp: LinuxSearchCursorOffset, srcReg: X64Register.r10)
	encodeGrp1RegImm32(asm.code, ext: Grp1ExtAdd, reg: X64Register.r9, imm: LinuxDirentNameOffset)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotName), srcReg: X64Register.r9)

	encodeLeaRegRegImm32(asm.code, dest: X64Register.rcx, base: X64Register.r8, disp: LinuxSearchPatternOffset)
	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.rdx, src: X64Register.r9, wide: true)
	encodeCallDirect(asm.code, callFixups: asm.callFixups, targetName: LinuxGlobMatchName)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: nextEntry)

	// Describe it, RELATIVE to the open directory — which is why this walk never builds a path and never
	// owns a path buffer.
	x64LinuxEmitZeroSlots(asm, firstSlot: SlotStat, slotCount: statSlots)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.r9, base: X64Register.rbp, disp: asm.slotDisp(SlotSearch), wide: true)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.r9, base: X64Register.r9, disp: LinuxSearchDirFdOffset, wide: true)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.r8, base: X64Register.rbp, disp: asm.slotDisp(SlotName), wide: true)
	x64LinuxEmitFstatat(asm, statDisp: statDisp)

	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotFindData), wide: true)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rdx, base: X64Register.rbp, disp: statDisp)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.r8, base: X64Register.rbp, disp: asm.slotDisp(SlotName), wide: true)
	encodeCallDirect(asm.code, callFixups: asm.callFixups, targetName: HostFillFindDataName)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: Win32True as MachineWord)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: answered)

	asm.placeLabel(exhausted)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: Win32False as MachineWord)

	asm.placeLabel(answered)
	return asm.finishFunction(HostDirFindNextName)
end 'buildX64LinuxDirFindNextChunk'

// ==========================================================================
// mrt_host_dir_find_first(rcx = patternPtr, rdx = findDataPtr) -> rax = search | -1
// ==========================================================================

// `FindFirstFileA` — open the enumeration a glob names and report its first entry, or answer
// `INVALID_HANDLE_VALUE` with the errno word telling the caller why.
//
// ⭐ **TWO ROUTES, AND WHICH ONE IS TAKEN IS A PROPERTY OF THE PATTERN**: a base name with no `*` or `?`
// names one path and is answered by one `stat`; anything else opens the directory and walks it.
//
// ⚠ **AN EMPTY MATCH IS `ERROR_FILE_NOT_FOUND`, WHICH IS Win32's ANSWER AND NOT THIS LANE'S INVENTION.** A
// walk that ended because `getdents64` FAILED keeps its own errno instead, so a real IO error is not
// reported as a missing file.
function buildX64LinuxDirFindFirstChunk() returns FunctionCodeChunk
	let SlotPattern = 0 as StackSize
	let SlotFindData = 1 as StackSize
	let SlotGlob = 2 as StackSize
	let SlotSearch = 3 as StackSize
	let SlotStat = 4 as StackSize
	let statSlots = runtimeFrameSlots(x64LinuxStatLayout().bytes)
	var asm = X64RuntimeAsm.beginFunction(4 + statSlots)
	let statDisp = x64LinuxBufferDisp(asm, firstSlot: SlotStat, slotCount: statSlots)

	let walk = asm.newLabel()
	let matched = asm.newLabel()
	let nameTooLong = asm.newLabel()
	let releaseAndRefuse = asm.newLabel()
	let publishReason = asm.newLabel()
	let refused = asm.newLabel()
	let answered = asm.newLabel()

	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotPattern), srcReg: X64Register.rcx)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotFindData), srcReg: X64Register.rdx)

	encodeCallDirect(asm.code, callFixups: asm.callFixups, targetName: HostBaseNameName)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotGlob), srcReg: X64Register.rax)
	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.rcx, src: X64Register.rax, wide: true)
	encodeCallDirect(asm.code, callFixups: asm.callFixups, targetName: HostHasWildcardName)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.notEqual, targetBlockId: walk)

	// One path: `stat` it, and hand back a search that is already exhausted.
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.r8, base: X64Register.rbp, disp: asm.slotDisp(SlotPattern), wide: true)
	encodeMovRegImm64(asm.code, dest: X64Register.r9, value: LinuxAtFdCwd)
	x64LinuxEmitFstatat(asm, statDisp: statDisp)
	x64LinuxEmitStashIfFailed(asm)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.less, targetBlockId: refused)
	x64LinuxEmitAllocateSearch(asm, searchSlot: SlotSearch)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: refused)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotFindData), wide: true)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rdx, base: X64Register.rbp, disp: statDisp)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.r8, base: X64Register.rbp, disp: asm.slotDisp(SlotGlob), wide: true)
	encodeCallDirect(asm.code, callFixups: asm.callFixups, targetName: HostFillFindDataName)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rbp, disp: asm.slotDisp(SlotSearch), wide: true)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: answered)

	// A glob: the page comes FIRST, because it is also where the directory prefix is built — this lane has
	// no `malloc` to borrow a scratch buffer from.
	asm.placeLabel(walk)
	x64LinuxEmitAllocateSearch(asm, searchSlot: SlotSearch)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: refused)

	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotPattern), wide: true)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.r8, base: X64Register.rbp, disp: asm.slotDisp(SlotSearch), wide: true)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rdx, base: X64Register.r8, disp: LinuxSearchPrefixOffset)
	encodeCallDirect(asm.code, callFixups: asm.callFixups, targetName: LinuxDirPrefixName)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: nameTooLong)

	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.r8, base: X64Register.rbp, disp: asm.slotDisp(SlotSearch), wide: true)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rsi, base: X64Register.r8, disp: LinuxSearchPrefixOffset)
	encodeMovRegImm32(asm.code, dest: X64Register.rdx, value: X64LinuxOpenDirectoryFlags)
	encodeMovRegImm32(asm.code, dest: X64Register.r10, value: PosixNoFileMode as MachineWord)
	encodeMovRegImm64(asm.code, dest: X64Register.rdi, value: LinuxAtFdCwd)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallOpenat)
	x64LinuxEmitStashIfFailed(asm)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.less, targetBlockId: releaseAndRefuse)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.r8, base: X64Register.rbp, disp: asm.slotDisp(SlotSearch), wide: true)
	encodeStoreBaseDispReg(asm.code, base: X64Register.r8, disp: LinuxSearchDirFdOffset, srcReg: X64Register.rax)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rsi, base: X64Register.rbp, disp: asm.slotDisp(SlotGlob), wide: true)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rdi, base: X64Register.r8, disp: LinuxSearchPatternOffset)
	encodeMovRegImm32(asm.code, dest: X64Register.r10, value: PosixPathStringCapacity as MachineWord)
	x64LinuxEmitCopyCStringBounded(asm, src: X64Register.rsi, dest: X64Register.rdi, limit: X64Register.r10, scratch: X64Register.rax)

	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotSearch), wide: true)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdx, base: X64Register.rbp, disp: asm.slotDisp(SlotFindData), wide: true)
	encodeCallDirect(asm.code, callFixups: asm.callFixups, targetName: HostDirFindNextName)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.notEqual, targetBlockId: matched)

	// Nothing matched. An exhausted walk left the word CLEAR; a failed one left its own reason there.
	encodeLeaRegGlobal(asm.code, rdataRelocs: asm.rdataRelocs, dest: X64Register.rdi, label: LinuxErrnoLabel)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rsi, base: X64Register.rdi, disp: 0, wide: true)
	emitCmpRegImm(asm, reg: X64Register.rsi, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.notEqual, targetBlockId: publishReason)
	x64LinuxEmitPublishErrno(asm, value: PosixErrnoNoSuchFileOrDirectory)

	asm.placeLabel(publishReason)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: releaseAndRefuse)

	asm.placeLabel(nameTooLong)
	x64LinuxEmitPublishErrno(asm, value: LinuxErrnoNameTooLong)

	asm.placeLabel(releaseAndRefuse)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotSearch), wide: true)
	encodeCallDirect(asm.code, callFixups: asm.callFixups, targetName: HostDirFindCloseName)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: refused)

	asm.placeLabel(matched)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rbp, disp: asm.slotDisp(SlotSearch), wide: true)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: answered)

	asm.placeLabel(refused)
	encodeMovRegImm64(asm.code, dest: X64Register.rax, value: PosixInvalidHandle)

	asm.placeLabel(answered)
	return asm.finishFunction(HostDirFindFirstName)
end 'buildX64LinuxDirFindFirstChunk'

// Map one page for a search, leaving it in rax AND in `searchSlot`, or 0 in both. `MAP_ANON` zeroes it, so
// the cursor, the filled count and the pattern's first byte are already right; only the descriptor is
// written, and it is written to the "no directory" sentinel so that a caller which never opens one still
// hands back an object `find_next` reads correctly.
//
// ⚠ **A REFUSED `mmap` ANSWERS A SMALL NEGATIVE, NOT NULL**, so the test is a sign test and the answer is
// normalised to 0 for the zero test every caller writes.
function x64LinuxEmitAllocateSearch(asm X64RuntimeAsm, searchSlot StackSize)
	let mapped = asm.newLabel()
	let recorded = asm.newLabel()

	encodeX64MmapAnon(asm.code, length: X64MapLength.fixed(LinuxSearchBytes as MachineWord))
	x64LinuxEmitStashIfFailed(asm)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.greater, targetBlockId: mapped)

	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: 0)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(searchSlot), srcReg: X64Register.rax)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: recorded)

	asm.placeLabel(mapped)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(searchSlot), srcReg: X64Register.rax)
	encodeMovRegImm64(asm.code, dest: X64Register.rsi, value: LinuxNoDirectory)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rax, disp: LinuxSearchDirFdOffset, srcReg: X64Register.rsi)

	asm.placeLabel(recorded)
end 'x64LinuxEmitAllocateSearch'

// ==========================================================================
// mrt_host_dir_find_close(rcx = search)
// ==========================================================================

// `FindClose` — release the enumeration and everything it owns, which on this lane is one descriptor and
// one mapping. Idempotence is the Std tier's (`__md_close` stamps its closed sentinel and never calls
// twice); what is here is that a search opened by the single-`stat` route has NO directory, so the `close`
// is guarded while the `munmap` is not.
//
// ⚠ **NEITHER SYSCALL STASHES.** `find_first`'s empty-match path reads the errno word AFTER calling this,
// and a `close` that failed would overwrite the reason it is about to publish.
function buildX64LinuxDirFindCloseChunk() returns FunctionCodeChunk
	let SlotSearch = 0 as StackSize
	var asm = X64RuntimeAsm.beginFunction(1)

	let unmap = asm.newLabel()

	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotSearch), srcReg: X64Register.rcx)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdi, base: X64Register.rcx, disp: LinuxSearchDirFdOffset, wide: true)
	emitCmpRegImm(asm, reg: X64Register.rdi, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.less, targetBlockId: unmap)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallClose)

	asm.placeLabel(unmap)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdi, base: X64Register.rbp, disp: asm.slotDisp(SlotSearch), wide: true)
	encodeMovRegImm32(asm.code, dest: X64Register.rsi, value: LinuxSearchBytes as MachineWord)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallMunmap)

	return asm.finishFunction(HostDirFindCloseName)
end 'buildX64LinuxDirFindCloseChunk'

// ==========================================================================
// mrt_host_handle_file_type(rcx = fd) -> rax = the GetFileType word
// ==========================================================================

// `GetFileType` on a lane whose descriptors carry no such enumeration, and whose static image links no libc
// to ask `isatty` with. `ioctl(fd, TCGETS, &termios)` IS what `isatty` is made of: it succeeds exactly on a
// terminal, so the kernel's status is the whole answer and the 36 bytes it writes are all discarded.
//
// ⚠ **THE FRAME EXISTS BECAUSE THE KERNEL WRITES THROUGH THE POINTER** — the buffer must be real memory the
// call may scribble on, which is what a chunk has and an inline `syscall` does not. The two words the
// caller compares against are `TerminalRuntime`'s, exactly as the errno map above answers in Win32's codes.
function buildX64LinuxHandleFileTypeChunk() returns FunctionCodeChunk
	let SlotTermios = 0 as StackSize
	var asm = X64RuntimeAsm.beginFunction(runtimeFrameSlots(LinuxTermiosBytes))

	let terminal = asm.newLabel()
	let answered = asm.newLabel()

	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.rdi, src: X64Register.rcx, wide: true)
	encodeMovRegImm32(asm.code, dest: X64Register.rsi, value: LinuxIoctlTcGets as MachineWord)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rdx, base: X64Register.rbp, disp: x64LinuxBufferDisp(asm, firstSlot: SlotTermios, slotCount: runtimeFrameSlots(LinuxTermiosBytes)))
	encodeX64Syscall(asm.code, number: X64LinuxSyscallIoctl)

	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: terminal)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: FileTypeDisk as MachineWord)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: answered)

	asm.placeLabel(terminal)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: FileTypeChar as MachineWord)

	asm.placeLabel(answered)
	return asm.finishFunction(HostHandleFileTypeName)
end 'buildX64LinuxHandleFileTypeChunk'

// ==========================================================================
// mrt_host_env_read(rcx = namePtr, rdx = bufPtr, r8 = bufLen) -> rax = bytes written
// ==========================================================================

// `GetEnvironmentVariableA` — copy an environment variable's value into the caller's buffer and answer the
// byte count, NOT counting the NUL.
//
// ⭐⭐ **THERE IS NO `getenv` ON THIS LANE, SO THE VECTOR IS WALKED.** A static image links no libc, and the
// kernel hands the environment to `mrt_start` on the stack rather than through any call — so the entry stub
// captures the vector's base (`BackendDispatch.appendLinuxEnvpCapture`) and this chunk walks it. Each entry
// is a `NAME=VALUE` C string, and a match is the name followed by `LinuxEnvSeparatorByte`.
//
// ⚠ **THE COUNT IS THE ANSWER ON BOTH EXITS.** On a fit it is what was written; on a too-small buffer it is
// what WOULD have been written, which is `GetEnvironmentVariableA`'s convention and what both callers decode.
// An unset variable answers the `PosixEnvUnset` the walk seeded, with no arm of its own.
function buildX64LinuxEnvReadChunk() returns FunctionCodeChunk
	let SlotBufPtr = 0 as StackSize
	let SlotBufLen = 1 as StackSize
	let SlotValue = 2 as StackSize
	let SlotWritten = 3 as StackSize
	let SlotCursor = 4 as StackSize
	let SlotName = 5 as StackSize
	var asm = X64RuntimeAsm.beginFunction(6)

	let scan = asm.newLabel()
	let compare = asm.newLabel()
	let nameEnded = asm.newLabel()
	let nextEntry = asm.newLabel()
	let copyLoop = asm.newLabel()
	let finish = asm.newLabel()

	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotName), srcReg: X64Register.rcx)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotBufPtr), srcReg: X64Register.rdx)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotBufLen), srcReg: X64Register.r8)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: PosixEnvUnset as MachineWord)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotWritten), srcReg: X64Register.rax)

	encodeLeaRegGlobal(asm.code, rdataRelocs: asm.rdataRelocs, dest: X64Register.rdi, label: LinuxEnvpLabel)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rdi, disp: 0, wide: true)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: finish)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotCursor), srcReg: X64Register.rax)

	// `rax = *cursor`, the next `NAME=VALUE` string, or NULL at the vector's terminator.
	asm.placeLabel(scan)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotCursor), wide: true)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rcx, disp: 0, wide: true)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: finish)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rsi, base: X64Register.rbp, disp: asm.slotDisp(SlotName), wide: true)

	asm.placeLabel(compare)
	encodeMovzxRegByteBaseDisp(asm.code, destReg: X64Register.rdi, base: X64Register.rsi, disp: 0)
	emitCmpRegImm(asm, reg: X64Register.rdi, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: nameEnded)
	encodeMovzxRegByteBaseDisp(asm.code, destReg: X64Register.r9, base: X64Register.rax, disp: 0)
	encodeRmRegDirect(asm.code, opcode: OpcodeCmpRmReg, dest: X64Register.rdi, src: X64Register.r9, wide: true)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.notEqual, targetBlockId: nextEntry)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rsi, base: X64Register.rsi, disp: 1)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rax, base: X64Register.rax, disp: 1)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: compare)

	// The name ran out: this is a match only if the entry's next byte is the separator. A NUL here — an entry
	// that IS the name with no `=` — is not a match either.
	asm.placeLabel(nameEnded)
	encodeMovzxRegByteBaseDisp(asm.code, destReg: X64Register.r9, base: X64Register.rax, disp: 0)
	emitCmpRegImm(asm, reg: X64Register.r9, imm: LinuxEnvSeparatorByte)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.notEqual, targetBlockId: nextEntry)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rax, base: X64Register.rax, disp: 1)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotValue), srcReg: X64Register.rax)

	// The measure-and-copy tail — Windows's contract rather than this lane's: answer `strlen(value)`, and copy
	// only when it fits STRICTLY inside the capacity, because the NUL needs the last byte.
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotValue), wide: true)
	emitCstrLenIntoRax(asm, cstrReg: X64Register.rcx)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotWritten), srcReg: X64Register.rax)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdx, base: X64Register.rbp, disp: asm.slotDisp(SlotBufLen), wide: true)
	encodeRmRegDirect(asm.code, opcode: OpcodeCmpRmReg, dest: X64Register.rax, src: X64Register.rdx, wide: true)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.aboveEqual, targetBlockId: finish)

	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rsi, base: X64Register.rbp, disp: asm.slotDisp(SlotValue), wide: true)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdi, base: X64Register.rbp, disp: asm.slotDisp(SlotBufPtr), wide: true)

	asm.placeLabel(copyLoop)
	encodeMovzxRegByteBaseDisp(asm.code, destReg: X64Register.r9, base: X64Register.rsi, disp: 0)
	encodeStoreBaseDispReg8(asm.code, base: X64Register.rdi, disp: 0, srcReg: X64Register.r9)
	emitCmpRegImm(asm, reg: X64Register.r9, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: finish)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rsi, base: X64Register.rsi, disp: 1)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rdi, base: X64Register.rdi, disp: 1)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: copyLoop)

	asm.placeLabel(nextEntry)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotCursor), wide: true)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rcx, base: X64Register.rcx, disp: SpillSlotBytes as Imm32)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotCursor), srcReg: X64Register.rcx)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: scan)

	asm.placeLabel(finish)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rbp, disp: asm.slotDisp(SlotWritten), wide: true)
	return asm.finishFunction(HostEnvReadName)
end 'buildX64LinuxEnvReadChunk'

// ==========================================================================
// L4 — THE GREEN-THREAD FLOOR'S HOST OBJECTS
// ==========================================================================
//
// ⭐⭐⭐ **THE x86-64 TWIN OF `Arm64LinuxRuntime`'s L4/L5 BANDS, AGAINST THE SAME KERNEL AND THE SAME
// PROTOCOL.** Every number these bodies read — the wait object's six fields, the handle tag, the futex
// operations, the clone flags, a worker M's stack geometry, `poll`'s bits and the wait-status decode — is
// `Targets/Shared/{Posix,Linux}Runtime`'s and is READ from there. What is genuinely x86-64's is the syscall
// table, the register ABI, `cmpxchg`/`xadd` in place of an LL/SC pair, and the two facts below.
//
// ⛔⛔ **FACT ONE: `clone`'s LAST TWO ARGUMENTS ARE `(ctid, tls)` HERE AND `(tls, ctid)` ON AArch64.** Both
// are NULL for a child process, so the disagreement cannot bite in the spawn; both are LIVE in
// `mrt_host_thread_create`, and getting them the wrong way round makes the kernel take the TLS page as the
// join word and the join word as the thread pointer. MEASURED: the AArch64 order on x86-64 HUNG to a
// two-minute bound rather than failing.
//
// ⛔⛔ **FACT TWO: THE THREAD POINTER IS NOT READABLE** — see `linuxTlsSlotCount`'s block for the price and
// `x64LinuxEmitStoreErrno` for the process-wide predicate that pays it.
//
// ⚠ **`syscall` CLOBBERS rcx AND r11**, which `svc` does not clobber at all, and the Win64-shaped incoming
// arguments arrive in rcx/rdx/r8/r9 while the syscall ABI reads rdi/rsi/rdx/r10/r8/r9. Both are why every
// body below stashes its arguments into frame slots before it calls anything.

// Where the LENGTH of a mapping comes from. A fixed-size host object knows it when the chunk is built, while
// `__gt_morestack`'s next stack is computed at run time and arrives in a register; the rest of the mapping
// ABI is the same either way, so the difference is one union rather than a second copy of the marshalling.
export union X64MapLength
	fixed(byteSize MachineWord)
	inRegister(reg X64Register)
end 'X64MapLength'

// `rax = mmap(NULL, length, PROT_READ|PROT_WRITE, MAP_ANONYMOUS|MAP_PRIVATE, -1, 0)` — the ONE anonymous
// mapping shape this lane has, and every page it ever gets comes through here: the wait object, the
// per-OS-thread slot block, a directory search, a worker M's region and a green thread's next stack. The
// parameters are `PosixMmap`'s, the same ones `lowerOsAllocPages` marshals, so no site can hold a second
// opinion about the mapping ABI.
//
// ⚠ **A REFUSED `mmap` ANSWERS A SMALL NEGATIVE, NOT NULL**, so every caller tests the SIGN of rax.
export function encodeX64MmapAnon(code ByteArray, length X64MapLength)
	encodeMovRegImm32(code, dest: X64Register.rdi, value: MmapKernelChoosesBase)
	encodeX64MoveLengthToRsi(code, length: length)
	encodeMovRegImm32(code, dest: X64Register.rdx, value: MmapProtReadWrite)
	encodeMovRegImm32(code, dest: X64Register.r10, value: MmapAnonPrivateLinux)
	encodeMovRegImm64(code, dest: X64Register.r8, value: MmapAnonFd)
	encodeMovRegImm32(code, dest: X64Register.r9, value: MmapNoOffset)
	encodeX64Syscall(code, number: X64LinuxSyscallMmap)
end 'encodeX64MmapAnon'

// `munmap(base, length)` with the base already in rdi — the only argument whose source genuinely differs
// (a register at the morestack site, a reloaded frame slot at every object close). The answer is never
// captured: nothing a caller could do about a refused release, and the mapping is unreachable either way.
export function encodeX64MunmapBaseInRdi(code ByteArray, length X64MapLength)
	encodeX64MoveLengthToRsi(code, length: length)
	encodeX64Syscall(code, number: X64LinuxSyscallMunmap)
end 'encodeX64MunmapBaseInRdi'

function encodeX64MoveLengthToRsi(code ByteArray, length X64MapLength)
	match length 'source'
		fixed(byteSize) then encodeMovRegImm32(code, dest: X64Register.rsi, value: byteSize)
		inRegister(reg) then encodeRmRegDirect(code, opcode: OpcodeMovRmReg, dest: X64Register.rsi, src: reg, wide: true)
	end 'source'
end 'encodeX64MoveLengthToRsi'

// `munmap(base, byteSize)` where the base is in a frame slot — the release every failure arm and every
// object close performs, written once because four sites do it and each had to reload the base first.
function x64LinuxEmitUnmapSlot(asm X64RuntimeAsm, baseSlot StackSize, byteSize MachineWord)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdi, base: X64Register.rbp, disp: asm.slotDisp(baseSlot), wide: true)
	encodeX64MunmapBaseInRdi(asm.code, length: X64MapLength.fixed(byteSize))
end 'x64LinuxEmitUnmapSlot'

// `futex(uaddr, op, val, timeout, uaddr2, val3)` — the one call shape all four users below marshal, with the
// address taken from a frame slot because every caller has just clobbered the register it arrived in.
//
// ⚠ **THE ANSWER IS DELIBERATELY NOT TESTED.** A `FUTEX_WAIT` returns for four reasons — woken, `EAGAIN`
// (the word had already changed), `EINTR` and `ETIMEDOUT` — and the correct response to ALL of them is to
// re-check the predicate. Every caller here does, in a loop, which is what makes a spurious return harmless.
function x64LinuxEmitFutex(asm X64RuntimeAsm, addrSlot StackSize, operation MachineWord, value MachineWord, timespecFirstSlot StackSize, hasTimeout bool)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdi, base: X64Register.rbp, disp: asm.slotDisp(addrSlot), wide: true)
	encodeMovRegImm32(asm.code, dest: X64Register.rsi, value: operation)
	encodeMovRegImm32(asm.code, dest: X64Register.rdx, value: value)

	if hasTimeout 'timed'
		encodeLeaRegRegImm32(asm.code, dest: X64Register.r10, base: X64Register.rbp, disp: x64LinuxTimespecFieldDisp(asm, firstSlot: timespecFirstSlot, byteOffset: X64LinuxTimespecSecOffset))
	end 'timed' else 'untimed'
		encodeMovRegImm32(asm.code, dest: X64Register.r10, value: LinuxFutexNoTimeout)
	end 'untimed'

	encodeMovRegImm32(asm.code, dest: X64Register.r8, value: LinuxFutexUnusedArg)
	encodeMovRegImm32(asm.code, dest: X64Register.r9, value: LinuxFutexUnusedArg)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallFutex)
end 'x64LinuxEmitFutex'

// ⭐⭐ **`lock cmpxchg [addrSlot], replacement` AGAINST `expected` — AND IT LEAVES ITS ANSWER IN THE FLAGS
// RATHER THAN IN A REGISTER, WHICH IS THE ONE PLACE THIS LANE'S SHAPE IS BETTER THAN THE arm64 TWIN'S.**
// That one builds a 0/1 out of an LL/SC pair because AArch64 has no flag-setting atomic; `cmpxchg` sets ZF
// iff the store landed, so every caller here branches on it directly and no boolean is ever materialised.
//
// ⚠ It clobbers rax (the comparand, and on failure the word it observed), rcx and rdi. No caller below holds
// anything in one across it.
function x64LinuxEmitCasImm(asm X64RuntimeAsm, addrSlot StackSize, expected MachineWord, replacement MachineWord)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdi, base: X64Register.rbp, disp: asm.slotDisp(addrSlot), wide: true)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: expected)
	encodeMovRegImm32(asm.code, dest: X64Register.rcx, value: replacement)
	encodeLockedRmwBaseDispReg(asm.code, twoByteEscape: true, opcode: OpcodeCmpxchgRmReg, base: X64Register.rdi, disp: 0, reg: X64Register.rcx)
end 'x64LinuxEmitCasImm'

// `dest = handle >> 48` — the kind field, for the two ops that dispatch on it.
function x64LinuxEmitHandleKind(asm X64RuntimeAsm, dest X64Register, handle X64Register)
	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: dest, src: handle, wide: true)
	encodeGrp2RegImm8(asm.code, ext: Grp2ExtShr, reg: dest, count: PosixHandleKindShift)
end 'x64LinuxEmitHandleKind'

// `reg = reg & ((1 << 48) - 1)` — the payload, as a shift pair rather than an AND with a materialised mask,
// because that needs no scratch register and every caller is already holding its arguments in place.
//
// ⚠ **IT SHIFTS BY THE KIND FIELD'S WIDTH, NOT BY ITS POSITION**, and getting that backwards is not a
// compile error — it would keep the low sixteen bits of a pointer. Derived from the pair rather than written
// down, so the two cannot come apart.
function x64LinuxEmitUntagHandle(asm X64RuntimeAsm, reg X64Register)
	encodeGrp2RegImm8(asm.code, ext: Grp2ExtShl, reg: reg, count: PosixHandleKindBits)
	encodeGrp2RegImm8(asm.code, ext: Grp2ExtShr, reg: reg, count: PosixHandleKindBits)
end 'x64LinuxEmitUntagHandle'

// `reg = reg | (kindObject << 48)` — what `mrt_host_wait_new` hands back, so every object handle in the
// program carries its kind from the moment it exists.
function x64LinuxEmitTagObject(asm X64RuntimeAsm, reg X64Register, scratch X64Register)
	encodeMovRegImm64(asm.code, dest: scratch, value: (PosixHandleKindObject * PosixHandleKindUnit))
	encodeRmRegDirect(asm.code, opcode: OpcodeOrRmReg, dest: reg, src: scratch, wide: true)
end 'x64LinuxEmitTagObject'

// `rcx = <a NUL-terminated constant>; call mrt_panic` — a bring-up failure naming its own reason. The
// message is a CHUNK-LOCAL string rather than an `.rdata` blob, which is what `X64RuntimeAsm`'s own string
// pool is for; `mrt_panic` prints, backtraces and EXITS, so nothing after it is reachable.
function x64LinuxEmitPanicConstant(asm X64RuntimeAsm, bytes ByteArray)
	emitLeaString(asm, dest: X64Register.rcx, bytes: bytes)
	encodeCallDirect(asm.code, callFixups: asm.callFixups, targetName: PanicName)
end 'x64LinuxEmitPanicConstant'

// ==========================================================================
// mrt_host_monotonic_clock(rcx = ticksPtr, rdx = freqPtr)
// ==========================================================================

// The MONOTONIC counter and its frequency — Windows's QueryPerformanceCounter/QueryPerformanceFrequency, and
// the reading `__gt_now_ns` computes every deadline in this scheduler from. The frequency it reports is
// `PosixNanosPerSecond`, for the reason stated there.
//
// ⚠ `CLOCK_MONOTONIC` is the id whose SEMANTICS match Darwin's `CLOCK_UPTIME_RAW`, not the one whose name
// does — see `LinuxClockMonotonic`.
function buildX64LinuxMonotonicClockChunk() returns FunctionCodeChunk
	let SlotTicksPtr = 0 as StackSize
	let SlotFreqPtr = 3 as StackSize
	var asm = X64RuntimeAsm.beginFunction(1 + LinuxTimespecSlots + 1)

	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotTicksPtr), srcReg: X64Register.rcx)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotFreqPtr), srcReg: X64Register.rdx)

	x64LinuxReadClockTimespec(asm, clockId: LinuxClockMonotonic)
	x64LinuxEmitTimespecToNanos(asm)

	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotTicksPtr), wide: true)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rcx, disp: 0, srcReg: X64Register.rax)

	encodeMovRegImm64(asm.code, dest: X64Register.rax, value: PosixNanosPerSecond)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotFreqPtr), wide: true)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rcx, disp: 0, srcReg: X64Register.rax)

	return asm.finishFunction(HostMonotonicClockName)
end 'buildX64LinuxMonotonicClockChunk'

// ==========================================================================
// mrt_host_sleep_ms(rcx = milliseconds)
// ==========================================================================

// Suspend the calling OS THREAD — Windows's `Sleep(ms)`.
//
// ⚠ **THIS IS THE OS PRIMITIVE, NOT `sleep(ms)` THE LANGUAGE FEATURE.** `__gt_sleep` parks a GREEN THREAD on
// the scheduler's timer heap and only bottoms out here when there is nothing else to run, which is why
// `sleep` and `greenThreads` are separate rows in `targetProvidesFacility`.
//
// ⭐ `clock_nanosleep` on the SAME clock the deadlines are computed from — see `X64LinuxSyscallClockNanosleep`.
//
// ⚠ **A SIGNAL CAN CUT IT SHORT (EINTR) AND THIS DOES NOT RESTART IT** — matching Windows's `Sleep`, and
// matching what the one consumer needs: the scheduler re-checks its deadline after every park.
function buildX64LinuxSleepMsChunk() returns FunctionCodeChunk
	let SlotTimespec = 0 as StackSize
	var asm = X64RuntimeAsm.beginFunction(LinuxTimespecSlots)

	x64LinuxEmitMillisToTimespec(asm, ms: X64Register.rcx, firstSlot: SlotTimespec)

	encodeMovRegImm32(asm.code, dest: X64Register.rdi, value: LinuxClockMonotonic)
	encodeMovRegImm32(asm.code, dest: X64Register.rsi, value: LinuxSleepIsRelative)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rdx, base: X64Register.rbp, disp: x64LinuxTimespecFieldDisp(asm, firstSlot: SlotTimespec, byteOffset: X64LinuxTimespecSecOffset))
	encodeMovRegImm32(asm.code, dest: X64Register.r10, value: LinuxSleepDiscardsRemainder)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallClockNanosleep)

	return asm.finishFunction(HostSleepMsName)
end 'buildX64LinuxSleepMsChunk'

// ⭐ **MILLISECONDS INTO A `struct timespec` IN TWO CONSECUTIVE FRAME SLOTS.** `sec = ms / 1000` and
// `nsec = (ms - sec*1000) * 1e6`, which x86-64's `div` answers in one step: the quotient lands in rax and the
// remainder in rdx, so the multiply-and-subtract the other lane spells as an `msub` is free here.
//
// ⛔ **IT TAKES AN OWNED COPY OF `ms` IN ITS FIRST INSTRUCTION, AND THAT IS NOT TIDINESS.** `div` destroys
// rax and rdx and needs its divisor in a third register, so a caller passing any of the three would have its
// timeout overwritten before it was read — which on the other lane was MEASURED as every bounded wait on
// both POSIX lanes sleeping for exactly 1.000 s whatever it asked for.
//
// ⚠ It clobbers rax, rcx, rdx and r8.
function x64LinuxEmitMillisToTimespec(asm X64RuntimeAsm, ms X64Register, firstSlot StackSize)
	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.r8, src: ms, wide: true)
	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.rax, src: X64Register.r8, wide: true)
	encodeRmRegDirect(asm.code, opcode: OpcodeXorRmReg, dest: X64Register.rdx, src: X64Register.rdx, wide: true)
	encodeMovRegImm32(asm.code, dest: X64Register.rcx, value: PosixMillisPerSecond)
	encodeGrp3Reg(asm.code, ext: Grp3ExtDiv, reg: X64Register.rcx)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: x64LinuxTimespecFieldDisp(asm, firstSlot: firstSlot, byteOffset: X64LinuxTimespecSecOffset), srcReg: X64Register.rax)

	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.rax, src: X64Register.rdx, wide: true)
	encodeMovRegImm32(asm.code, dest: X64Register.rcx, value: PosixNanosPerMilli)
	encodeImulRegReg(asm.code, dest: X64Register.rax, src: X64Register.rcx)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: x64LinuxTimespecFieldDisp(asm, firstSlot: firstSlot, byteOffset: X64LinuxTimespecNsecOffset), srcReg: X64Register.rax)
end 'x64LinuxEmitMillisToTimespec'

// ==========================================================================
// mrt_host_wait_new(rcx = kind) -> rax = the tagged object handle
// ==========================================================================

// Allocate and initialise one wait object. See `PosixWaitOffKind` for the layout and why it is one page.
//
// ⚠ **EVERY ADMITTED KIND NEEDS THE SAME INITIALISATION, WHICH IS NONE BEYOND THE KIND ITSELF.** A child's
// pid, cached status and killed flag are filled by the spawn and the reap, and a thread's join word by
// `mrt_host_thread_create`; the page is zero-filled and 0 is the right start for every one of them.
//
// ⚠ **A FAILED `mmap` IS A PANIC, NOT A SILENT NULL.** Scheduler bring-up cannot continue without its wake
// events, and the alternative is a store through a negative errno several instructions later.
function buildX64LinuxWaitNewChunk() returns FunctionCodeChunk
	let SlotKind = 0 as StackSize
	var asm = X64RuntimeAsm.beginFunction(1)

	let mapped = asm.newLabel()
	let kindOk = asm.newLabel()

	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotKind), srcReg: X64Register.rcx)
	encodeX64MmapAnon(asm.code, length: X64MapLength.fixed(LinuxHostObjectPageBytes))
	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.greaterEqual, targetBlockId: mapped)
	x64LinuxEmitPanicConstant(asm, bytes: LinuxWaitMapFailedMessage)

	asm.placeLabel(mapped)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotKind), wide: true)
	emitCmpRegImm(asm, reg: X64Register.rcx, imm: PosixWaitKindEvent as Imm32)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: kindOk)
	emitCmpRegImm(asm, reg: X64Register.rcx, imm: PosixWaitKindProcess as Imm32)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: kindOk)
	emitCmpRegImm(asm, reg: X64Register.rcx, imm: PosixWaitKindThread as Imm32)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: kindOk)
	x64LinuxEmitPanicConstant(asm, bytes: LinuxWaitKindMessage)

	// The signal word needs no store: `MAP_ANONYMOUS` hands back a zero-filled page, and 0 IS
	// `PosixWaitNotSignalled`.
	asm.placeLabel(kindOk)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rax, disp: PosixWaitOffKind as Imm32, srcReg: X64Register.rcx)
	x64LinuxEmitTagObject(asm, reg: X64Register.rax, scratch: X64Register.rcx)

	return asm.finishFunction(HostWaitNewName)
end 'buildX64LinuxWaitNewChunk'

// ==========================================================================
// mrt_host_thread_create(rcx = entry, rdx = arg) -> rax = the tagged object handle | 0
// ==========================================================================

// ⭐⭐⭐ **`CreateThread(NULL, 0, entry, arg, 0, NULL)` ON A LANE WITH NO `pthread_create`.** Everything a
// thread needs is built by hand: its stack, its guard page, its per-OS-thread slot block, the word its joiner
// will sleep on, and the two-word seed that is the only channel the child has to learn what to run.
//
// ⛔ **`clone`'s CHILD DOES NOT RETURN LIKE A CALL.** It resumes at the instruction after the `syscall` with
// rax = 0, on the stack this chunk chose, with NO return address and with rbp still pointing into the
// PARENT's frame. So the child path may not touch a frame slot, may not fall out of its block, and must end
// in a syscall rather than a `ret`. It reads its two words through its own rsp, zeroes rbp so the panic
// backtrace ends at this thread's boundary, and finishes with `exit`.
//
// ⛔⛔ **`exit` (60), NEVER `exit_group` (231).** `CLONE_THREAD` is precisely what makes the wrong one lethal:
// `exit_group` would end every thread of the process. The child path in `mrt_host_spawn` states the same trap.
//
// ⭐ **THE ENTRY POINT NEEDS NO THUNK, AND THAT IS AN ABI COINCIDENCE WORTH STATING.** shv2's internal ABI
// passes an integer argument in rcx and Win64 passes a `ThreadProc`'s `lpParameter` there too, so
// `__sched_worker_loop(p)` IS a valid start routine as compiled on all three lanes.
//
// ⚠ **THE JOIN WORD IS PUBLISHED BEFORE THE `clone` AND CLEARED BY THE KERNEL.** `CLONE_CHILD_CLEARTID`
// zeroes `PosixWaitOffThread` and wakes it when the thread ends; `mrt_host_wait_one`'s THREAD arm is the
// sleeper. Writing `LinuxThreadRunning` after the clone would race the exit of a thread that finished first.
//
// ⚠ **A WORKER M's STACK AND SLOT BLOCK ARE PROCESS-LIFETIME AND ARE NOT RELEASED ON A SUCCESSFUL START** —
// an exiting thread cannot unmap the stack it is standing on, and the one joiner runs on the way out of the
// process. Every FAILURE arm does release what it took.
function buildX64LinuxThreadCreateChunk() returns FunctionCodeChunk
	let SlotEntry = 0 as StackSize
	let SlotArg = 1 as StackSize
	let SlotObj = 2 as StackSize
	let SlotJoin = 3 as StackSize
	let SlotRegion = 4 as StackSize
	let SlotStack = 5 as StackSize
	let SlotTls = 6 as StackSize
	var asm = X64RuntimeAsm.beginFunction(7)

	let stackMapped = asm.newLabel()
	let guarded = asm.newLabel()
	let tlsMapped = asm.newLabel()
	let childPath = asm.newLabel()
	let cloneFailed = asm.newLabel()
	let releaseStack = asm.newLabel()
	let noThread = asm.newLabel()
	let done = asm.newLabel()

	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotEntry), srcReg: X64Register.rcx)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotArg), srcReg: X64Register.rdx)

	encodeX64MmapAnon(asm.code, length: X64MapLength.fixed(LinuxWorkerRegionBytes))
	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.greaterEqual, targetBlockId: stackMapped)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: noThread)

	asm.placeLabel(stackMapped)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotRegion), srcReg: X64Register.rax)
	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.rdi, src: X64Register.rax, wide: true)
	encodeMovRegImm32(asm.code, dest: X64Register.rsi, value: LinuxWorkerStackGuardBytes)
	encodeMovRegImm32(asm.code, dest: X64Register.rdx, value: MmapProtNone)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallMprotect)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.greaterEqual, targetBlockId: guarded)
	x64LinuxEmitPanicConstant(asm, bytes: LinuxWorkerGuardFailedMessage)

	// The child's initial rsp: the top of the region, less the two words it reads from there.
	asm.placeLabel(guarded)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rbp, disp: asm.slotDisp(SlotRegion), wide: true)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rax, base: X64Register.rax, disp: (LinuxWorkerRegionBytes - LinuxWorkerStackSeedBytes) as Imm32)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotStack), srcReg: X64Register.rax)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotEntry), wide: true)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rax, disp: LinuxWorkerSeedEntryOffset as Imm32, srcReg: X64Register.rcx)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotArg), wide: true)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rax, disp: LinuxWorkerSeedArgOffset as Imm32, srcReg: X64Register.rcx)

	// This M's per-OS-thread slot block, which `CLONE_SETTLS` publishes in its FS base.
	encodeX64MmapAnon(asm.code, length: X64MapLength.fixed(LinuxHostObjectPageBytes))
	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.greaterEqual, targetBlockId: tlsMapped)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: releaseStack)

	asm.placeLabel(tlsMapped)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotTls), srcReg: X64Register.rax)

	// The waitable handle, and the join word inside it, published RUNNING before the thread can clear it.
	encodeMovRegImm32(asm.code, dest: X64Register.rcx, value: PosixWaitKindThread)
	encodeCallDirect(asm.code, callFixups: asm.callFixups, targetName: HostWaitNewName)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotObj), srcReg: X64Register.rax)
	x64LinuxEmitUntagHandle(asm, reg: X64Register.rax)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rax, base: X64Register.rax, disp: PosixWaitOffThread as Imm32)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotJoin), srcReg: X64Register.rax)
	encodeMovRegImm32(asm.code, dest: X64Register.rcx, value: LinuxThreadRunning)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rax, disp: 0, srcReg: X64Register.rcx)

	// ⛔⛔ `clone(flags, stack, ptid, ctid, tls)` — x86-64's argument order, which is NOT AArch64's (that one
	// swaps the last two). Both are live here, and the wrong order is a HANG rather than an error.
	encodeMovRegImm32(asm.code, dest: X64Register.rdi, value: LinuxCloneWorkerFlags)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rsi, base: X64Register.rbp, disp: asm.slotDisp(SlotStack), wide: true)
	encodeMovRegImm32(asm.code, dest: X64Register.rdx, value: LinuxCloneNoParentTidOut)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.r10, base: X64Register.rbp, disp: asm.slotDisp(SlotJoin), wide: true)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.r8, base: X64Register.rbp, disp: asm.slotDisp(SlotTls), wide: true)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallClone)
	encodeRmRegDirect(asm.code, opcode: OpcodeTestRmReg, dest: X64Register.rax, src: X64Register.rax, wide: true)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: childPath)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.less, targetBlockId: cloneFailed)

	// PARENT: the tagged handle is the answer, and `__sched_wake_or_spawn` stores it in the P it just claimed.
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rbp, disp: asm.slotDisp(SlotObj), wide: true)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: done)

	// ⛔ THE CHILD. Frame slots are the parent's; rsp is this thread's own. It never falls out of this block.
	asm.placeLabel(childPath)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rsp, disp: LinuxWorkerSeedEntryOffset as Imm32, wide: true)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rsp, disp: LinuxWorkerSeedArgOffset as Imm32, wide: true)
	encodeRmRegDirect(asm.code, opcode: OpcodeXorRmReg, dest: X64Register.rbp, src: X64Register.rbp, wide: true)
	encodeCallReg(asm.code, reg: X64Register.rax)
	encodeMovRegImm32(asm.code, dest: X64Register.rdi, value: LinuxWorkerExitStatus)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallExit)
	asm.code.push(OpcodeInt3)

	// The clone failed — `EAGAIN` on a process at its thread limit is the reachable one. Give back everything
	// this call took, in the reverse of the order it took it, and answer the NULL handle `spawnIt` reads as
	// "no thread started" (it releases the P it claimed for this M).
	asm.placeLabel(cloneFailed)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotObj), wide: true)
	encodeCallDirect(asm.code, callFixups: asm.callFixups, targetName: HostWaitCloseName)
	x64LinuxEmitUnmapSlot(asm, baseSlot: SlotTls, byteSize: LinuxHostObjectPageBytes)

	asm.placeLabel(releaseStack)
	x64LinuxEmitUnmapSlot(asm, baseSlot: SlotRegion, byteSize: LinuxWorkerRegionBytes)

	asm.placeLabel(noThread)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: LinuxNoThreadStarted)

	asm.placeLabel(done)
	return asm.finishFunction(HostThreadCreateName)
end 'buildX64LinuxThreadCreateChunk'

// ==========================================================================
// mrt_host_event_set(rcx = object)
// ==========================================================================

// `SetEvent` — `PosixWaitSignalled`'s publish-and-wake, spelled here as a `lock cmpxchg` and a `FUTEX_WAKE`.
//
// ⚠ **x86-64 IS TOTAL STORE ORDER AND `lock cmpxchg` IS A FULL BARRIER**, so the release ordering the arm64
// twin buys with `STLXR` is free here and nothing extra is emitted.
function buildX64LinuxEventSetChunk() returns FunctionCodeChunk
	let SlotSignal = 0 as StackSize
	var asm = X64RuntimeAsm.beginFunction(1)

	x64LinuxEmitUntagHandle(asm, reg: X64Register.rcx)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rcx, base: X64Register.rcx, disp: PosixWaitOffSignal as Imm32)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotSignal), srcReg: X64Register.rcx)

	x64LinuxEmitCasImm(asm, addrSlot: SlotSignal, expected: PosixWaitNotSignalled, replacement: PosixWaitSignalled)
	x64LinuxEmitFutex(asm, addrSlot: SlotSignal, operation: LinuxFutexWakePrivate, value: LinuxFutexWakeOne, timespecFirstSlot: SlotSignal, hasTimeout: false)

	return asm.finishFunction(HostEventSetName)
end 'buildX64LinuxEventSetChunk'

// ==========================================================================
// mrt_host_wait_one(rcx = object, rdx = timeoutMs) -> rax = WAIT_OBJECT_0 | WAIT_TIMEOUT
// ==========================================================================

// `WaitForSingleObject`, dispatching on the object's KIND.
//
// ⭐⭐ **THE TAKE IS THE SAME `cmpxchg` THE PUBLISH IS, RUN THE OTHER WAY, AND IT IS WHAT MAKES THE EVENT
// AUTO-RESET.** `CAS(signal, 1 -> 0)` succeeds for exactly ONE waiter — the "one waiter released" half of
// the contract — and clears the word, which is the "auto" half.
//
// ⭐ **A CHILD PROCESS TAKES ONE ARM AND IT IS A SINGLE CALL**: `mrt_host_proc_await` honours all three
// timeouts its callers use.
//
// ⭐⭐ **A WORKER M TAKES ANOTHER, AND IT IS `pthread_join` SPELLED IN THE KERNEL'S OWN TERMS.** The join word
// holds `LinuxThreadRunning` until the thread ends, at which point the kernel zeroes it and wakes it
// (`CLONE_CHILD_CLEARTID`) — with the SHARED `FUTEX_WAIT`, because the kernel's wake is shared and a private
// waiter is never reached by it (see `LinuxFutexWaitShared`).
//
// ⚠ **A JOIN IGNORES THE TIMEOUT** and the one caller passes `WaitInfinite` anyway: `__sched_stop_workers`
// waits for ever by construction, because the worker has already been told to stop.
//
// ⛔ **A DESCRIPTOR IS NOT WAITABLE, AND SAYING SO LOUDLY IS THE POINT.** Dereferencing one for a kind field
// would be a wild load; answering `WAIT_TIMEOUT` would be a caller spinning on a handle nothing can signal.
function buildX64LinuxWaitOneChunk() returns FunctionCodeChunk
	let SlotSignal = 0 as StackSize
	let SlotTimeout = 1 as StackSize
	let SlotResult = 2 as StackSize
	let SlotTimespec = 3 as StackSize
	let SlotObj = 5 as StackSize
	var asm = X64RuntimeAsm.beginFunction(3 + LinuxTimespecSlots + 1)

	let isObject = asm.newLabel()
	let isEvent = asm.newLabel()
	let awaitChild = asm.newLabel()
	let joinThread = asm.newLabel()
	let joinTest = asm.newLabel()
	let joined = asm.newLabel()
	let testSignal = asm.newLabel()
	let waitTimed = asm.newLabel()
	let takeSignal = asm.newLabel()
	let finish = asm.newLabel()

	x64LinuxEmitHandleKind(asm, dest: X64Register.rax, handle: X64Register.rcx)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: PosixHandleKindObject as Imm32)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: isObject)
	x64LinuxEmitPanicConstant(asm, bytes: LinuxWaitOnDescriptorMessage)

	asm.placeLabel(isObject)
	x64LinuxEmitUntagHandle(asm, reg: X64Register.rcx)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotTimeout), srcReg: X64Register.rdx)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotObj), srcReg: X64Register.rcx)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rcx, disp: PosixWaitOffKind as Imm32, wide: true)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: PosixWaitKindEvent as Imm32)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: isEvent)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: PosixWaitKindProcess as Imm32)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: awaitChild)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: PosixWaitKindThread as Imm32)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: joinThread)
	x64LinuxEmitPanicConstant(asm, bytes: LinuxWaitKindMessage)

	// joinThread: sleep while the kernel has not yet cleared this M's join word. `SlotSignal` carries the
	// futex ADDRESS here exactly as it does on the event arm, so the one futex shape serves both.
	asm.placeLabel(joinThread)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotObj), wide: true)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rcx, base: X64Register.rcx, disp: PosixWaitOffThread as Imm32)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotSignal), srcReg: X64Register.rcx)

	asm.placeLabel(joinTest)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotSignal), wide: true)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rcx, disp: 0, wide: true)
	encodeRmRegDirect(asm.code, opcode: OpcodeTestRmReg, dest: X64Register.rax, src: X64Register.rax, wide: true)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: joined)
	x64LinuxEmitFutex(asm, addrSlot: SlotSignal, operation: LinuxFutexWaitShared, value: LinuxThreadRunning, timespecFirstSlot: SlotTimespec, hasTimeout: false)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: joinTest)

	asm.placeLabel(joined)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: WaitObject0)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotResult), srcReg: X64Register.rax)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: finish)

	// awaitChild: the child's own wait, in `mrt_host_proc_await` — which honours all three timeouts the
	// callers use, where the event arm below answers only its own kind of object.
	asm.placeLabel(awaitChild)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotObj), wide: true)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdx, base: X64Register.rbp, disp: asm.slotDisp(SlotTimeout), wide: true)
	encodeCallDirect(asm.code, callFixups: asm.callFixups, targetName: HostProcAwaitName)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotResult), srcReg: X64Register.rax)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: finish)

	asm.placeLabel(isEvent)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotObj), wide: true)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rcx, base: X64Register.rcx, disp: PosixWaitOffSignal as Imm32)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotSignal), srcReg: X64Register.rcx)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: WaitTimeout)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotResult), srcReg: X64Register.rax)

	asm.placeLabel(testSignal)
	x64LinuxEmitCasImm(asm, addrSlot: SlotSignal, expected: PosixWaitSignalled, replacement: PosixWaitNotSignalled)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: takeSignal)
	// A ZERO timeout is a POLL: the caller wants the state, not a wait. Answer the seeded `WAIT_TIMEOUT`
	// without entering the kernel at all.
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rbp, disp: asm.slotDisp(SlotTimeout), wide: true)
	encodeRmRegDirect(asm.code, opcode: OpcodeTestRmReg, dest: X64Register.rax, src: X64Register.rax, wide: true)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: finish)
	encodeMovRegImm64(asm.code, dest: X64Register.rcx, value: WaitInfinite)
	encodeRmRegDirect(asm.code, opcode: OpcodeCmpRmReg, dest: X64Register.rax, src: X64Register.rcx, wide: true)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.notEqual, targetBlockId: waitTimed)
	// Unbounded: sleep while the word is still unsignalled, then re-test. That IS the `while (!signalled)`
	// loop the primitive requires — a futex return is advisory, and re-testing is the only sound response.
	x64LinuxEmitFutex(asm, addrSlot: SlotSignal, operation: LinuxFutexWaitPrivate, value: PosixWaitNotSignalled, timespecFirstSlot: SlotTimespec, hasTimeout: false)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: testSignal)

	// waitTimed: ONE bounded wait, then a single re-test — the caller owns the deadline, and re-arming here
	// would silently double a timeout that expired spuriously.
	asm.placeLabel(waitTimed)
	x64LinuxEmitMillisToTimespec(asm, ms: X64Register.rax, firstSlot: SlotTimespec)
	x64LinuxEmitFutex(asm, addrSlot: SlotSignal, operation: LinuxFutexWaitPrivate, value: PosixWaitNotSignalled, timespecFirstSlot: SlotTimespec, hasTimeout: true)
	x64LinuxEmitCasImm(asm, addrSlot: SlotSignal, expected: PosixWaitSignalled, replacement: PosixWaitNotSignalled)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.notEqual, targetBlockId: finish)

	asm.placeLabel(takeSignal)
	encodeMovRegImm32(asm.code, dest: X64Register.rcx, value: WaitObject0)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotResult), srcReg: X64Register.rcx)

	asm.placeLabel(finish)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rbp, disp: asm.slotDisp(SlotResult), wide: true)
	return asm.finishFunction(HostWaitOneName)
end 'buildX64LinuxWaitOneChunk'

// ==========================================================================
// mrt_host_wait_close(rcx = handle)
// ==========================================================================

// `CloseHandle` — the ONE op that closes everything Win32 calls a handle, dispatching on the kind the value
// carries (`PosixHandleKindShift` for why it carries one at all).
//
// ⭐ **A ZERO DESCRIPTOR IS A NO-OP** — see `PosixHandleKindShift` for why that guard is load-bearing.
//
// ⚠ **A THREAD OBJECT RELEASES THE PAGE AND NOT THE M's STACK OR SLOT BLOCK**, which are process-lifetime.
//
// ⚠ **A CHILD IS REAPED FIRST.** Without a non-blocking `wait4` an exited child that nobody waited on stays
// a zombie for the parent's whole life, which a spawn/release loop turns into one per iteration.
function buildX64LinuxWaitCloseChunk() returns FunctionCodeChunk
	let SlotObj = 0 as StackSize
	var asm = X64RuntimeAsm.beginFunction(1)

	let releaseObject = asm.newLabel()
	let unmapObject = asm.newLabel()
	let closed = asm.newLabel()

	x64LinuxEmitHandleKind(asm, dest: X64Register.rax, handle: X64Register.rcx)
	x64LinuxEmitUntagHandle(asm, reg: X64Register.rcx)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: PosixHandleKindObject as Imm32)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: releaseObject)

	encodeRmRegDirect(asm.code, opcode: OpcodeTestRmReg, dest: X64Register.rcx, src: X64Register.rcx, wide: true)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: closed)
	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.rdi, src: X64Register.rcx, wide: true)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallClose)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: closed)

	// An OBJECT is one mapped page and nothing else — there are no primitives to destroy first, which is the
	// whole of what a futex buys over a mutex-and-condvar pair.
	asm.placeLabel(releaseObject)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotObj), srcReg: X64Register.rcx)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rcx, disp: PosixWaitOffKind as Imm32, wide: true)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: PosixWaitKindProcess as Imm32)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.notEqual, targetBlockId: unmapObject)
	encodeMovRegImm32(asm.code, dest: X64Register.rdx, value: PosixReapWithoutBlocking)
	encodeCallDirect(asm.code, callFixups: asm.callFixups, targetName: HostProcReapName)

	asm.placeLabel(unmapObject)
	x64LinuxEmitUnmapSlot(asm, baseSlot: SlotObj, byteSize: LinuxHostObjectPageBytes)

	asm.placeLabel(closed)
	return asm.finishFunction(HostWaitCloseName)
end 'buildX64LinuxWaitCloseChunk'

// ==========================================================================
// mrt_host_lock_init(rcx = region) / mrt_linux_lock_enter / mrt_linux_lock_leave
// ==========================================================================

// `InitializeCriticalSection` — a free, unowned, un-entered recursive mutex in the region the caller
// allocated. See `LinuxLockOffFutex` for the three words, why recursion is not optional and why all three are
// written rather than assumed zero.
function buildX64LinuxLockInitChunk() returns FunctionCodeChunk
	var asm = X64RuntimeAsm.beginFunction(0)

	assertLinuxLockFits()
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: LinuxMutexFree)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rcx, disp: LinuxLockOffFutex as Imm32, srcReg: X64Register.rax)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rcx, disp: LinuxLockOffOwner as Imm32, srcReg: X64Register.rax)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rcx, disp: LinuxLockOffDepth as Imm32, srcReg: X64Register.rax)

	return asm.finishFunction(HostLockInitName)
end 'buildX64LinuxLockInitChunk'

// `EnterCriticalSection`, running `LinuxMutexHeldContended`'s three-compare-and-swap acquire protocol.
//
// ⭐ **THE UNCONTENDED PATH IS ONE `lock cmpxchg` AND NO SYSCALL, WHICH IS THE WHOLE POINT OF A FUTEX.** The
// kernel is entered only when the word is already held.
function buildX64LinuxLockEnterChunk() returns FunctionCodeChunk
	let SlotRegion = 0 as StackSize
	let SlotTid = 1 as StackSize
	var asm = X64RuntimeAsm.beginFunction(2)

	let acquire = asm.newLabel()
	let contend = asm.newLabel()
	let owned = asm.newLabel()
	let done = asm.newLabel()

	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotRegion), srcReg: X64Register.rcx)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallGettid)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotTid), srcReg: X64Register.rax)

	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotRegion), wide: true)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdx, base: X64Register.rcx, disp: LinuxLockOffOwner as Imm32, wide: true)
	encodeRmRegDirect(asm.code, opcode: OpcodeCmpRmReg, dest: X64Register.rdx, src: X64Register.rax, wide: true)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.notEqual, targetBlockId: acquire)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdx, base: X64Register.rcx, disp: LinuxLockOffDepth as Imm32, wide: true)
	encodeGrp1RegImm32(asm.code, ext: Grp1ExtAdd, reg: X64Register.rdx, imm: 1)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rcx, disp: LinuxLockOffDepth as Imm32, srcReg: X64Register.rdx)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: done)

	// The futex word is at offset 0 of the region, so the region pointer IS its address.
	asm.placeLabel(acquire)
	x64LinuxEmitCasImm(asm, addrSlot: SlotRegion, expected: LinuxMutexFree, replacement: LinuxMutexHeld)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: owned)

	asm.placeLabel(contend)
	x64LinuxEmitCasImm(asm, addrSlot: SlotRegion, expected: LinuxMutexFree, replacement: LinuxMutexHeldContended)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: owned)
	x64LinuxEmitCasImm(asm, addrSlot: SlotRegion, expected: LinuxMutexHeld, replacement: LinuxMutexHeldContended)
	x64LinuxEmitFutex(asm, addrSlot: SlotRegion, operation: LinuxFutexWaitPrivate, value: LinuxMutexHeldContended, timespecFirstSlot: SlotRegion, hasTimeout: false)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: contend)

	asm.placeLabel(owned)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotRegion), wide: true)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdx, base: X64Register.rbp, disp: asm.slotDisp(SlotTid), wide: true)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rcx, disp: LinuxLockOffOwner as Imm32, srcReg: X64Register.rdx)
	encodeMovRegImm32(asm.code, dest: X64Register.rdx, value: LinuxMutexFirstEntry)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rcx, disp: LinuxLockOffDepth as Imm32, srcReg: X64Register.rdx)

	asm.placeLabel(done)
	return asm.finishFunction(LinuxLockEnterName)
end 'buildX64LinuxLockEnterChunk'

// `LeaveCriticalSection` — `LinuxMutexReleaseStep`'s decrement, spelled here as a `lock xadd` of -1 so the
// displaced word arrives in a register and the wake decision costs no second atomic.
function buildX64LinuxLockLeaveChunk() returns FunctionCodeChunk
	let SlotRegion = 0 as StackSize
	var asm = X64RuntimeAsm.beginFunction(1)

	let release = asm.newLabel()
	let wake = asm.newLabel()
	let done = asm.newLabel()

	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotRegion), srcReg: X64Register.rcx)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rcx, disp: LinuxLockOffDepth as Imm32, wide: true)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: LinuxMutexFirstEntry as Imm32)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.lessEqual, targetBlockId: release)
	encodeGrp1RegImm32(asm.code, ext: Grp1ExtSub, reg: X64Register.rax, imm: 1)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rcx, disp: LinuxLockOffDepth as Imm32, srcReg: X64Register.rax)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: done)

	asm.placeLabel(release)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: LinuxMutexFree)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rcx, disp: LinuxLockOffOwner as Imm32, srcReg: X64Register.rax)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rcx, disp: LinuxLockOffDepth as Imm32, srcReg: X64Register.rax)
	encodeMovRegImm64(asm.code, dest: X64Register.rdx, value: LinuxMutexReleaseStep)
	encodeLockedRmwBaseDispReg(asm.code, twoByteEscape: true, opcode: OpcodeXaddRmReg, base: X64Register.rcx, disp: LinuxLockOffFutex as Imm32, reg: X64Register.rdx)
	emitCmpRegImm(asm, reg: X64Register.rdx, imm: LinuxMutexHeld as Imm32)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.notEqual, targetBlockId: wake)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: done)

	asm.placeLabel(wake)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotRegion), wide: true)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: LinuxMutexFree)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rcx, disp: LinuxLockOffFutex as Imm32, srcReg: X64Register.rax)
	x64LinuxEmitFutex(asm, addrSlot: SlotRegion, operation: LinuxFutexWakePrivate, value: LinuxFutexWakeOne, timespecFirstSlot: SlotRegion, hasTimeout: false)

	asm.placeLabel(done)
	return asm.finishFunction(LinuxLockLeaveName)
end 'buildX64LinuxLockLeaveChunk'

// ==========================================================================
// mrt_host_tls_alloc() -> rax = the per-OS-thread slot key
// ==========================================================================

// `TlsAlloc()` — reserve one per-OS-thread slot and answer its index. On the first call from a given OS
// thread it also MAPS that thread's slot block and publishes its base in FS, because on this lane there is
// no libc to have done so.
//
// ⛔⛔ **THE "DOES THIS THREAD HAVE A BLOCK?" TEST IS A SYSCALL HERE AND ONE `cbz` ON THE OTHER LANE, AND
// THAT IS THE WHOLE COST OF AN UNREADABLE THREAD POINTER.** `arch_prctl(ARCH_GET_FS, &out)` writes the base
// through a pointer rather than answering in a register, so the test needs this chunk's frame. It is
// affordable exactly because this is bring-up: `__sched_init_procs` is the only caller and it runs once per
// key. Every HOT read of the block goes through the segment override and enters no kernel at all.
//
// ⚠ **THE KEY COUNTER IS PROCESS-WIDE WHILE THE BLOCK IS PER-THREAD**, which is `pthread_key_create`'s own
// arrangement: a key names the same offset in every thread's block. Its `sealedBeforeWorkers` class is what
// makes the plain read-modify-write below sound.
//
// ⭐ **KEY 0 IS REFUSED.** With a base of 0, key 0 would publish a slot offset of 0, which every reader treats
// as "the scheduler has not started" — a scheduler that silently never runs, with no crash to find it by.
// The counter pre-increments so the first key is 1; this is the check that says so out loud.
function buildX64LinuxTlsAllocChunk() returns FunctionCodeChunk
	let SlotFsBase = 0 as StackSize
	var asm = X64RuntimeAsm.beginFunction(1)

	let mapped = asm.newLabel()
	let published = asm.newLabel()
	let haveBlock = asm.newLabel()
	let keyOk = asm.newLabel()

	// ⚠ **THE SLOT IS ZEROED BEFORE THE READ BECAUSE `beginFunction` DOES NOT ZERO THE FRAME.** `arch_prctl`
	// writes it only on success, so a refused GET would otherwise leave the test reading stack garbage — and a
	// non-zero garbage word says "this thread already has a block" and skips the mapping. Zero routes a failed
	// GET to the map path, which is the answer a thread with no readable FS base needs.
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: 0)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotFsBase), srcReg: X64Register.rax)

	encodeMovRegImm32(asm.code, dest: X64Register.rdi, value: X64LinuxArchGetFs)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rsi, base: X64Register.rbp, disp: asm.slotDisp(SlotFsBase))
	encodeX64Syscall(asm.code, number: X64LinuxSyscallArchPrctl)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rbp, disp: asm.slotDisp(SlotFsBase), wide: true)
	encodeRmRegDirect(asm.code, opcode: OpcodeTestRmReg, dest: X64Register.rax, src: X64Register.rax, wide: true)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.notEqual, targetBlockId: haveBlock)

	encodeX64MmapAnon(asm.code, length: X64MapLength.fixed(LinuxHostObjectPageBytes))
	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.greaterEqual, targetBlockId: mapped)
	x64LinuxEmitPanicConstant(asm, bytes: LinuxTlsMapFailedMessage)

	asm.placeLabel(mapped)
	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.rsi, src: X64Register.rax, wide: true)
	encodeMovRegImm32(asm.code, dest: X64Register.rdi, value: X64LinuxArchSetFs)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallArchPrctl)

	// ⛔ **A REFUSED `ARCH_SET_FS` IS A PANIC, AND IT MUST BE CAUGHT BEFORE THE FLAG GOES UP.** The flag says
	// "every thread's slot block is reachable through FS"; raised over a base of 0 it sends every later errno
	// stash through the null page — precisely the fault the flag exists to prevent, and a SIGSEGV a long way
	// from its cause. This runs once per OS thread at bring-up, so the check costs nothing that matters.
	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.greaterEqual, targetBlockId: published)
	x64LinuxEmitPanicConstant(asm, bytes: X64LinuxTlsPublishFailedMessage)

	asm.placeLabel(published)
	// ⭐ RAISE THE PROCESS-WIDE FLAG the errno access reads (`x64LinuxEmitStoreErrno` carries why a per-thread
	// test is unaffordable there and why a process-wide one is sound). It is raised AFTER FS is published, so
	// no reader can be sent to a block that does not exist yet.
	encodeLeaRegGlobal(asm.code, rdataRelocs: asm.rdataRelocs, dest: X64Register.rdi, label: X64LinuxTlsReadyLabel)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: X64LinuxTlsBlocksAreLive)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rdi, disp: 0, srcReg: X64Register.rax)

	asm.placeLabel(haveBlock)
	encodeLeaRegGlobal(asm.code, rdataRelocs: asm.rdataRelocs, dest: X64Register.rdi, label: LinuxTlsNextKeyLabel)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rdi, disp: 0, wide: true)
	encodeGrp1RegImm32(asm.code, ext: Grp1ExtAdd, reg: X64Register.rax, imm: LinuxTlsFirstKey as Imm32)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: linuxTlsSlotCount() as Imm32)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.below, targetBlockId: keyOk)
	x64LinuxEmitPanicConstant(asm, bytes: LinuxTlsExhaustedMessage)

	asm.placeLabel(keyOk)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rdi, disp: 0, srcReg: X64Register.rax)
	return asm.finishFunction(HostTlsAllocName)
end 'buildX64LinuxTlsAllocChunk'

// What `mrt_host_tls_alloc` raises the flag to. A bare 1 at the one site that writes it says nothing about
// which of this file's several 1s it is.
let X64LinuxTlsBlocksAreLive = 1

// ==========================================================================
// mrt_linux_tls_set(rcx = key, rdx = value)
// ==========================================================================

// `TlsSetValue(key, value)` — `pthread_setspecific` on the Darwin lane, and there ONE import call with no
// chunk at all. It is a chunk here because it owes an assertion that lane does not: the store needs a slot
// BLOCK, and a thread that has none would write `key * 8` bytes into the null page.
//
// ⛔ **A MISSING BLOCK IS A PANIC, NOT A STORE THROUGH ZERO.** Every thread that reaches this call has one —
// the main thread from `mrt_host_tls_alloc`, a worker M from the `CLONE_SETTLS` in `mrt_host_thread_create` —
// so this is the check that keeps that true rather than assumed. It reads the same process-wide flag the
// errno access does, for that helper's stated reason: on x86-64 the per-thread question costs a syscall, and
// the process-wide one is exactly as strong for the two kinds of thread this lane has.
function buildX64LinuxTlsSetChunk() returns FunctionCodeChunk
	var asm = X64RuntimeAsm.beginFunction(0)

	let haveBlock = asm.newLabel()

	x64LinuxEmitTestTlsReady(asm, scratch: X64Register.rax, whenReady: haveBlock)
	x64LinuxEmitPanicConstant(asm, bytes: X64LinuxTlsNoBlockMessage)

	asm.placeLabel(haveBlock)
	encodeGrp2RegImm8(asm.code, ext: Grp2ExtShl, reg: X64Register.rcx, count: LinuxTlsKeyScaleBits)
	encodeMovSegBaseReg(asm.code, base: X64Register.rcx, srcReg: X64Register.rdx, segment: x64ThreadPointerSegment(Os.linux))

	return asm.finishFunction(LinuxTlsSetName)
end 'buildX64LinuxTlsSetChunk'

let X64LinuxTlsPublishFailedMessage = b"panic: the green-thread scheduler could not publish this OS thread's slot block (arch_prctl(ARCH_SET_FS) failed)\n"

let X64LinuxTlsNoBlockMessage = b"panic: an OS thread asked to write a scheduler slot before any slot block existed -- on x64-linux the FS base is the block base and only mrt_host_tls_alloc sets it\n"

// ==========================================================================
// L5 — THE CHILD-PROCESS BAND
// ==========================================================================
//
// ⭐⭐ **THE ALGORITHMS ARE `Arm64PosixRuntime`'s AND THE INSTRUCTIONS ARE NOT.** `waitpid` and `wait4` decode
// the same status word, `poll` and `ppoll` fill the same `struct pollfd`, and the reap, the bounded await,
// the exit-code read and the netpoll's multi-wait make no OS call of their own — so the two arm64 lanes share
// one body each, parameterised by a `PosixHostCall`. x86-64 has only ONE POSIX lane, so there is no second
// route to parameterise for and each body below issues its own `syscall` directly; what it shares with the
// arm64 pair is every NUMBER, which is `Targets/Shared/PosixRuntime`'s.

// ==========================================================================
// mrt_host_tick_ms() -> rax = milliseconds since boot
// ==========================================================================

// `GetTickCount64`, in the unit `StdOp.osTickCountMs`'s consumers measure deadlines in — so a subprocess
// timeout and a scheduler deadline cannot drift apart by being read off two different clocks.
//
// ⭐ **IT ASKS `mrt_host_monotonic_clock` RATHER THAN READING A CLOCK ITSELF, WHICH IS WHAT MAKES THAT
// GUARANTEE STRUCTURAL.** The conversion is DERIVED from the frequency that chunk reports rather than
// assuming the 1e9 every lane happens to answer today.
function buildX64LinuxTickMsChunk() returns FunctionCodeChunk
	let SlotTicks = 0 as StackSize
	let SlotFreq = 1 as StackSize
	var asm = X64RuntimeAsm.beginFunction(2)

	encodeLeaRegRegImm32(asm.code, dest: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotTicks))
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rdx, base: X64Register.rbp, disp: asm.slotDisp(SlotFreq))
	encodeCallDirect(asm.code, callFixups: asm.callFixups, targetName: HostMonotonicClockName)

	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rbp, disp: asm.slotDisp(SlotFreq), wide: true)
	encodeRmRegDirect(asm.code, opcode: OpcodeXorRmReg, dest: X64Register.rdx, src: X64Register.rdx, wide: true)
	encodeMovRegImm32(asm.code, dest: X64Register.rcx, value: PosixMillisPerSecond)
	encodeGrp3Reg(asm.code, ext: Grp3ExtDiv, reg: X64Register.rcx)
	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.rcx, src: X64Register.rax, wide: true)

	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rbp, disp: asm.slotDisp(SlotTicks), wide: true)
	encodeRmRegDirect(asm.code, opcode: OpcodeXorRmReg, dest: X64Register.rdx, src: X64Register.rdx, wide: true)
	encodeGrp3Reg(asm.code, ext: Grp3ExtDiv, reg: X64Register.rcx)

	return asm.finishFunction(HostTickMsName)
end 'buildX64LinuxTickMsChunk'

// ==========================================================================
// mrt_host_pipe(rcx = readOutPtr, rdx = writeOutPtr)
// ==========================================================================

// `CreatePipe` — an ANONYMOUS pair, where Windows needs a uniquely NAMED one to get overlapped reads.
//
// ⭐⭐ **`O_CLOEXEC` IS WHERE THE INHERITANCE MODEL LIVES ON THIS LANE.** There is no
// `POSIX_SPAWN_CLOEXEC_DEFAULT` to invert the default for the whole exec, so the marking happens here and the
// child's `dup3` onto 0/1/2 is what CLEARS it for the three that must survive. Without it a child keeps a
// copy of the parent's stdin WRITE end and never sees EOF when `subprocessCloseStdin` closes the parent's,
// which is a HANG rather than a wrong answer.
//
// ⚠ **A FAILED `pipe2` LEAVES BOTH OUT-WORDS ZERO**, which is the Std tier's own "no pipe" reading. A pipe
// cannot answer descriptor 0 in a process that still holds its standard streams.
function buildX64LinuxPipeChunk() returns FunctionCodeChunk
	let SlotReadOut = 0 as StackSize
	let SlotWriteOut = 1 as StackSize
	let SlotFds = 2 as StackSize
	var asm = X64RuntimeAsm.beginFunction(3)

	let created = asm.newLabel()
	let published = asm.newLabel()

	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotReadOut), srcReg: X64Register.rcx)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotWriteOut), srcReg: X64Register.rdx)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rdi, base: X64Register.rbp, disp: asm.slotDisp(SlotFds))
	encodeMovRegImm32(asm.code, dest: X64Register.rsi, value: LinuxOpenCloseOnExec)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallPipe2)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: created)

	encodeMovRegImm32(asm.code, dest: X64Register.r8, value: PosixNoPipeDescriptor)
	encodeMovRegImm32(asm.code, dest: X64Register.r9, value: PosixNoPipeDescriptor)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: published)

	asm.placeLabel(created)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotFds))
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.r8, base: X64Register.rcx, disp: 0, wide: false)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.r9, base: X64Register.rcx, disp: PosixPipeWriteEndOffset as Imm32, wide: false)

	asm.placeLabel(published)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotReadOut), wide: true)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rcx, disp: 0, srcReg: X64Register.r8)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotWriteOut), wide: true)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rcx, disp: 0, srcReg: X64Register.r9)

	return asm.finishFunction(HostPipeName)
end 'buildX64LinuxPipeChunk'

// ==========================================================================
// mrt_host_pipe_peek(rcx = handle, rdx = availOutPtr) -> rax = BOOL
// ==========================================================================

// `PeekNamedPipe` — "are there bytes to read, without committing to a read". `PosixPipeReadyBytes` carries
// the whole argument for the count this answers and for why EOF arrives through the READ instead.
//
// ⛔ **THERE IS NO `poll` TO CALL WITH AN INTEGER TIMEOUT HERE EITHER.** x86-64 still has the legacy call,
// but `ppoll` is what the arm64 lane uses and its timeout is a `struct timespec *` whose NULL means "block
// for ever" — the exact INVERSE of `poll`'s 0. A zeroed `timespec` in two frame slots is the no-wait request,
// and using the same call on both lanes keeps one shape rather than two.
function buildX64LinuxPipePeekChunk() returns FunctionCodeChunk
	let SlotAvailOut = 0 as StackSize
	let SlotPollfd = 1 as StackSize
	let SlotTimespec = 2 as StackSize
	var asm = X64RuntimeAsm.beginFunction(2 + LinuxTimespecSlots)

	let notReady = asm.newLabel()
	let broken = asm.newLabel()
	let publish = asm.newLabel()
	let answered = asm.newLabel()

	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotAvailOut), srcReg: X64Register.rdx)
	x64LinuxEmitUntagHandle(asm, reg: X64Register.rcx)
	encodeMovRegImm64(asm.code, dest: X64Register.rax, value: (PosixPollEventsUnit * PosixPollIn))
	encodeRmRegDirect(asm.code, opcode: OpcodeOrRmReg, dest: X64Register.rcx, src: X64Register.rax, wide: true)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotPollfd), srcReg: X64Register.rcx)

	// `ppoll(&pollfd, 1, &timespec{0,0}, NULL, sizeof(sigset_t))` — the zeroed pair is the no-wait request.
	encodeRmRegDirect(asm.code, opcode: OpcodeXorRmReg, dest: X64Register.rax, src: X64Register.rax, wide: true)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: x64LinuxTimespecFieldDisp(asm, firstSlot: SlotTimespec, byteOffset: X64LinuxTimespecSecOffset), srcReg: X64Register.rax)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: x64LinuxTimespecFieldDisp(asm, firstSlot: SlotTimespec, byteOffset: X64LinuxTimespecNsecOffset), srcReg: X64Register.rax)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rdi, base: X64Register.rbp, disp: asm.slotDisp(SlotPollfd))
	encodeMovRegImm32(asm.code, dest: X64Register.rsi, value: PosixPollOneDescriptor)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rdx, base: X64Register.rbp, disp: x64LinuxTimespecFieldDisp(asm, firstSlot: SlotTimespec, byteOffset: X64LinuxTimespecSecOffset))
	encodeMovRegImm32(asm.code, dest: X64Register.r10, value: PosixPollNoSignalMask)
	encodeMovRegImm32(asm.code, dest: X64Register.r8, value: LinuxSigsetBytes)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallPpoll)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.less, targetBlockId: broken)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: notReady)

	// Ready — unless the descriptor itself is unusable, which is `PeekNamedPipe`'s own failure and the Std
	// tier's other route to `markDone`.
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotPollfd), wide: true)
	encodeGrp2RegImm8(asm.code, ext: Grp2ExtShr, reg: X64Register.rcx, count: PosixPollReventsShift)
	encodeGrp1RegImm32(asm.code, ext: Grp1ExtAnd, reg: X64Register.rcx, imm: PosixPollBrokenBits as Imm32)
	encodeRmRegDirect(asm.code, opcode: OpcodeTestRmReg, dest: X64Register.rcx, src: X64Register.rcx, wide: true)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.notEqual, targetBlockId: broken)
	encodeMovRegImm32(asm.code, dest: X64Register.r8, value: PosixPipeReadyBytes)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: publish)

	asm.placeLabel(notReady)
	encodeMovRegImm32(asm.code, dest: X64Register.r8, value: PosixNoBytesReady)

	asm.placeLabel(publish)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotAvailOut), wide: true)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rcx, disp: 0, srcReg: X64Register.r8)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: Win32True as MachineWord)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: answered)

	asm.placeLabel(broken)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: Win32False as MachineWord)

	asm.placeLabel(answered)
	return asm.finishFunction(HostPipePeekName)
end 'buildX64LinuxPipePeekChunk'

// ==========================================================================
// mrt_host_proc_reap(rcx = object, rdx = blocking) -> rax = signalled
// ==========================================================================

// The ONE place a child's status is taken — `PosixWaitOffChildStatus` carries the reap-once rule that makes
// it one place, and the cache it is taken into.
//
// ⚠ **A KILLED CHILD KEEPS THE CODE THE KILL NAMED.** `mrt_host_proc_terminate` writes `childStatus` and
// raises `childKilled` BEFORE the signal lands, so this decodes nothing for it — see `PosixSignalExitCodeBase`.
function buildX64LinuxProcReapChunk() returns FunctionCodeChunk
	let SlotObj = 0 as StackSize
	let SlotBlocking = 1 as StackSize
	let SlotStatus = 2 as StackSize
	var asm = X64RuntimeAsm.beginFunction(3)

	let alreadySignalled = asm.newLabel()
	let stillRunning = asm.newLabel()
	let statusChosen = asm.newLabel()
	let bySignal = asm.newLabel()
	let publish = asm.newLabel()
	let blockingWait = asm.newLabel()
	let haveOptions = asm.newLabel()
	let answered = asm.newLabel()

	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotObj), srcReg: X64Register.rcx)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotBlocking), srcReg: X64Register.rdx)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rcx, disp: PosixWaitOffSignal as Imm32, wide: true)
	encodeRmRegDirect(asm.code, opcode: OpcodeTestRmReg, dest: X64Register.rax, src: X64Register.rax, wide: true)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.notEqual, targetBlockId: alreadySignalled)

	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdi, base: X64Register.rcx, disp: PosixWaitOffChildPid as Imm32, wide: true)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rsi, base: X64Register.rbp, disp: asm.slotDisp(SlotStatus))
	// `options = blocking ? 0 : WNOHANG`.
	encodeRmRegDirect(asm.code, opcode: OpcodeTestRmReg, dest: X64Register.rdx, src: X64Register.rdx, wide: true)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.notEqual, targetBlockId: blockingWait)
	encodeMovRegImm32(asm.code, dest: X64Register.rdx, value: PosixWaitNoHang)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: haveOptions)

	asm.placeLabel(blockingWait)
	encodeMovRegImm32(asm.code, dest: X64Register.rdx, value: LinuxReapUntilItExits)

	asm.placeLabel(haveOptions)
	encodeMovRegImm32(asm.code, dest: X64Register.r10, value: PosixReapDiscardsRusage)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallWait4)

	// The wait answers the reaped pid, 0 (nothing to report yet, `WNOHANG`) or -1. Only the pid means the
	// child has been taken, and the comparison is on the low 32 bits because `pid_t` is a C `int`.
	encodeMovRegImm64(asm.code, dest: X64Register.rcx, value: PosixChildPidMask)
	encodeRmRegDirect(asm.code, opcode: OpcodeAndRmReg, dest: X64Register.rax, src: X64Register.rcx, wide: true)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotObj), wide: true)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdx, base: X64Register.rcx, disp: PosixWaitOffChildPid as Imm32, wide: true)
	encodeRmRegDirect(asm.code, opcode: OpcodeCmpRmReg, dest: X64Register.rax, src: X64Register.rdx, wide: true)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.notEqual, targetBlockId: stillRunning)

	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rcx, disp: PosixWaitOffChildKilled as Imm32, wide: true)
	encodeRmRegDirect(asm.code, opcode: OpcodeTestRmReg, dest: X64Register.rax, src: X64Register.rax, wide: true)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.notEqual, targetBlockId: statusChosen)

	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdx, base: X64Register.rbp, disp: asm.slotDisp(SlotStatus), wide: false)
	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.rax, src: X64Register.rdx, wide: true)
	encodeGrp1RegImm32(asm.code, ext: Grp1ExtAnd, reg: X64Register.rax, imm: PosixWaitStatusSignalMask as Imm32)
	encodeRmRegDirect(asm.code, opcode: OpcodeTestRmReg, dest: X64Register.rax, src: X64Register.rax, wide: true)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.notEqual, targetBlockId: bySignal)
	encodeRmRegDirect(asm.code, opcode: OpcodeMovRmReg, dest: X64Register.rax, src: X64Register.rdx, wide: true)
	encodeGrp2RegImm8(asm.code, ext: Grp2ExtShr, reg: X64Register.rax, count: PosixWaitStatusExitShift)
	encodeGrp1RegImm32(asm.code, ext: Grp1ExtAnd, reg: X64Register.rax, imm: PosixWaitStatusExitMask as Imm32)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: publish)

	// rax already holds the terminating signal — the mask above left it there.
	asm.placeLabel(bySignal)
	encodeGrp1RegImm32(asm.code, ext: Grp1ExtAdd, reg: X64Register.rax, imm: PosixSignalExitCodeBase as Imm32)

	asm.placeLabel(publish)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rcx, disp: PosixWaitOffChildStatus as Imm32, srcReg: X64Register.rax)

	asm.placeLabel(statusChosen)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: PosixWaitSignalled)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rcx, disp: PosixWaitOffSignal as Imm32, srcReg: X64Register.rax)

	asm.placeLabel(alreadySignalled)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: PosixChildSignalled)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: answered)

	asm.placeLabel(stillRunning)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: PosixChildStillRunning)

	asm.placeLabel(answered)
	return asm.finishFunction(HostProcReapName)
end 'buildX64LinuxProcReapChunk'

// ==========================================================================
// mrt_host_proc_await(rcx = object, rdx = timeoutMs) -> rax = WAIT_OBJECT_0 | WAIT_TIMEOUT
// ==========================================================================

// ⭐⭐ **`WaitForSingleObject` ON A CHILD, AND ALL THREE TIMEOUTS ITS CALLERS ACTUALLY USE.** They are three
// different questions and answering them with one poll is a WRONG ANSWER rather than a slow one:
//
//   • **0 — a POLL.** `__gt_proc_check` and `__gt_subp_wait_collect`'s exit test drive their own loop.
//   • **INFINITE — a real block**, inside the wait syscall itself. There is nothing to poll for: the kernel
//     already has the notification.
//   • **anything else — a bounded poll.** A deadline no POSIX wait takes, so it is a scan and a millisecond
//     sleep, exactly as the netpoll's multi-wait below does it.
//
// ⚠ **THE INFINITE ARM BLOCKS THE OS THREAD**, which is the same property the blocking pipe read has and for
// the same missing mechanism: without a `SIGCHLD` handler there is nothing for a green thread to park on.
//
// ⚠ **IT CONTAINS NO OS CALL AT ALL** — two calls and a compare — which is why the arm64 pair share one body.
function buildX64LinuxProcAwaitChunk() returns FunctionCodeChunk
	let SlotObj = 0 as StackSize
	let SlotTimeout = 1 as StackSize
	let SlotElapsed = 2 as StackSize
	var asm = X64RuntimeAsm.beginFunction(3)

	let bounded = asm.newLabel()
	let boundedStep = asm.newLabel()
	let signalled = asm.newLabel()
	let notSignalled = asm.newLabel()
	let answered = asm.newLabel()

	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotObj), srcReg: X64Register.rcx)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotTimeout), srcReg: X64Register.rdx)

	// INFINITE: one blocking reap, and the answer cannot be anything but signalled.
	encodeMovRegImm64(asm.code, dest: X64Register.rax, value: WaitInfinite)
	encodeRmRegDirect(asm.code, opcode: OpcodeCmpRmReg, dest: X64Register.rdx, src: X64Register.rax, wide: true)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.notEqual, targetBlockId: bounded)
	encodeMovRegImm32(asm.code, dest: X64Register.rdx, value: PosixReapBlocking)
	encodeCallDirect(asm.code, callFixups: asm.callFixups, targetName: HostProcReapName)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: signalled)

	// 0 and everything else share one loop: it reaps FIRST and tests the deadline second, so a zero timeout
	// makes exactly one non-blocking reap and then answers.
	asm.placeLabel(bounded)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: 0)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotElapsed), srcReg: X64Register.rax)

	asm.placeLabel(boundedStep)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotObj), wide: true)
	encodeMovRegImm32(asm.code, dest: X64Register.rdx, value: PosixReapWithoutBlocking)
	encodeCallDirect(asm.code, callFixups: asm.callFixups, targetName: HostProcReapName)
	encodeRmRegDirect(asm.code, opcode: OpcodeTestRmReg, dest: X64Register.rax, src: X64Register.rax, wide: true)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.notEqual, targetBlockId: signalled)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rbp, disp: asm.slotDisp(SlotElapsed), wide: true)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotTimeout), wide: true)
	encodeRmRegDirect(asm.code, opcode: OpcodeCmpRmReg, dest: X64Register.rax, src: X64Register.rcx, wide: true)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.greaterEqual, targetBlockId: notSignalled)
	encodeMovRegImm32(asm.code, dest: X64Register.rcx, value: PosixChildPollMs)
	encodeCallDirect(asm.code, callFixups: asm.callFixups, targetName: HostSleepMsName)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rbp, disp: asm.slotDisp(SlotElapsed), wide: true)
	encodeGrp1RegImm32(asm.code, ext: Grp1ExtAdd, reg: X64Register.rax, imm: PosixChildPollMs as Imm32)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotElapsed), srcReg: X64Register.rax)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: boundedStep)

	asm.placeLabel(signalled)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: WaitObject0)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: answered)

	asm.placeLabel(notSignalled)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: WaitTimeout)

	asm.placeLabel(answered)
	return asm.finishFunction(HostProcAwaitName)
end 'buildX64LinuxProcAwaitChunk'

// ==========================================================================
// mrt_host_proc_exit_code(rcx = handle, rdx = codeOutPtr)
// ==========================================================================

// `GetExitCodeProcess`. It BLOCKS if the child has not been reaped yet, which is exactly what its Win32
// twin's callers already guarantee is safe: every one of them has either just seen the handle signalled or is
// `__gt_subp_wait`, whose whole contract is to wait.
//
// ⚠ **A REAP THAT CANNOT HAPPEN LEAVES THE CACHED STATUS UNTOUCHED**, which is 0 for a handle whose child
// some other path already took. Answering the last known status beats inventing one.
function buildX64LinuxProcExitCodeChunk() returns FunctionCodeChunk
	let SlotCodeOut = 0 as StackSize
	let SlotObj = 1 as StackSize
	var asm = X64RuntimeAsm.beginFunction(2)

	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotCodeOut), srcReg: X64Register.rdx)
	x64LinuxEmitUntagHandle(asm, reg: X64Register.rcx)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotObj), srcReg: X64Register.rcx)
	encodeMovRegImm32(asm.code, dest: X64Register.rdx, value: PosixReapBlocking)
	encodeCallDirect(asm.code, callFixups: asm.callFixups, targetName: HostProcReapName)

	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotObj), wide: true)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rcx, disp: PosixWaitOffChildStatus as Imm32, wide: true)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotCodeOut), wide: true)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rcx, disp: 0, srcReg: X64Register.rax)

	return asm.finishFunction(HostProcExitCodeName)
end 'buildX64LinuxProcExitCodeChunk'

// ==========================================================================
// mrt_host_proc_terminate(rcx = handle, rdx = exitCode)
// ==========================================================================

// `TerminateProcess(h, exitCode)` — `kill(pid, SIGKILL)`, plus the one thing POSIX cannot carry across a
// signal: the CODE the caller named. It is recorded in the object first, so the reap that follows reports it
// instead of decoding `128 + SIGKILL` from the status. See `PosixSignalExitCodeBase`.
function buildX64LinuxProcTerminateChunk() returns FunctionCodeChunk
	var asm = X64RuntimeAsm.beginFunction(0)

	x64LinuxEmitUntagHandle(asm, reg: X64Register.rcx)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rcx, disp: PosixWaitOffChildStatus as Imm32, srcReg: X64Register.rdx)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: PosixChildSignalled)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rcx, disp: PosixWaitOffChildKilled as Imm32, srcReg: X64Register.rax)

	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdi, base: X64Register.rcx, disp: PosixWaitOffChildPid as Imm32, wide: true)
	encodeMovRegImm32(asm.code, dest: X64Register.rsi, value: PosixSigKill)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallKill)

	return asm.finishFunction(HostProcTerminateName)
end 'buildX64LinuxProcTerminateChunk'

// ==========================================================================
// mrt_host_wait_any(rcx = handlesBase, rdx = count, r8 = timeoutMs)
// ==========================================================================

// ⭐ `WaitForMultipleObjects(handles, count, FALSE, timeoutMs)` — the NETPOLL's block on the parked children.
// Its answer is DISCARDED by the one caller (`GtRuntime.emitProcWait` re-scans through `__gt_proc_check`
// straight afterwards), so this reports nothing and only has to RETURN at the right moment: as soon as any
// child has exited, or when the timeout runs out.
//
// ⚠ **IT POLLS, AND POLLING IS THE RIGHT ANSWER HERE RATHER THAN A COMPROMISE.** The alternative is a
// `SIGCHLD` handler, and this backend installs none. Blocking the M is what the netpoll is FOR — it runs only
// when nothing is runnable — so a millisecond scan costs an idle thread a syscall per millisecond.
//
// ⚠ **A ZERO COUNT WITH AN INFINITE TIMEOUT WOULD NEVER RETURN**, and cannot arise: `emitProcWait` is
// reached only under `pc > 0`.
function buildX64LinuxWaitAnyChunk() returns FunctionCodeChunk
	let SlotBase = 0 as StackSize
	let SlotCount = 1 as StackSize
	let SlotTimeout = 2 as StackSize
	let SlotElapsed = 3 as StackSize
	let SlotIndex = 4 as StackSize
	var asm = X64RuntimeAsm.beginFunction(5)

	let scanRound = asm.newLabel()
	let scanStep = asm.newLabel()
	let scanned = asm.newLabel()
	let sleepStep = asm.newLabel()
	let done = asm.newLabel()

	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotBase), srcReg: X64Register.rcx)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotCount), srcReg: X64Register.rdx)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotTimeout), srcReg: X64Register.r8)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: 0)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotElapsed), srcReg: X64Register.rax)

	asm.placeLabel(scanRound)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: 0)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotIndex), srcReg: X64Register.rax)

	asm.placeLabel(scanStep)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rbp, disp: asm.slotDisp(SlotIndex), wide: true)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotCount), wide: true)
	encodeRmRegDirect(asm.code, opcode: OpcodeCmpRmReg, dest: X64Register.rax, src: X64Register.rcx, wide: true)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.greaterEqual, targetBlockId: scanned)
	encodeGrp2RegImm8(asm.code, ext: Grp2ExtShl, reg: X64Register.rax, count: PosixHandleArrayStrideShift)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotBase), wide: true)
	encodeRmRegDirect(asm.code, opcode: OpcodeAddRmReg, dest: X64Register.rcx, src: X64Register.rax, wide: true)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rcx, disp: 0, wide: true)
	x64LinuxEmitUntagHandle(asm, reg: X64Register.rcx)
	encodeMovRegImm32(asm.code, dest: X64Register.rdx, value: PosixReapWithoutBlocking)
	encodeCallDirect(asm.code, callFixups: asm.callFixups, targetName: HostProcReapName)
	encodeRmRegDirect(asm.code, opcode: OpcodeTestRmReg, dest: X64Register.rax, src: X64Register.rax, wide: true)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.notEqual, targetBlockId: done)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rbp, disp: asm.slotDisp(SlotIndex), wide: true)
	encodeGrp1RegImm32(asm.code, ext: Grp1ExtAdd, reg: X64Register.rax, imm: 1)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotIndex), srcReg: X64Register.rax)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: scanStep)

	asm.placeLabel(scanned)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rbp, disp: asm.slotDisp(SlotTimeout), wide: true)
	encodeMovRegImm64(asm.code, dest: X64Register.rcx, value: WaitInfinite)
	encodeRmRegDirect(asm.code, opcode: OpcodeCmpRmReg, dest: X64Register.rax, src: X64Register.rcx, wide: true)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: sleepStep)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotElapsed), wide: true)
	encodeRmRegDirect(asm.code, opcode: OpcodeCmpRmReg, dest: X64Register.rcx, src: X64Register.rax, wide: true)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.greaterEqual, targetBlockId: done)

	asm.placeLabel(sleepStep)
	encodeMovRegImm32(asm.code, dest: X64Register.rcx, value: PosixChildPollMs)
	encodeCallDirect(asm.code, callFixups: asm.callFixups, targetName: HostSleepMsName)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rbp, disp: asm.slotDisp(SlotElapsed), wide: true)
	encodeGrp1RegImm32(asm.code, ext: Grp1ExtAdd, reg: X64Register.rax, imm: PosixChildPollMs as Imm32)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotElapsed), srcReg: X64Register.rax)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: scanRound)

	asm.placeLabel(done)
	return asm.finishFunction(HostWaitAnyName)
end 'buildX64LinuxWaitAnyChunk'

// ==========================================================================
// mrt_host_spawn(rcx = argv, rdx = cwd, r8 = creationFlags, r9 = startupInfo,
//                [stack 0] = processInformation, [stack 1] = lpEnvironment)
// ==========================================================================

// ⭐⭐⭐ `CreateProcessA` ON A LANE WITH NO SPAWN PRIMITIVE AT ALL. ⛔ **THERE IS NO `posix_spawn` SYSCALL ON
// LINUX — it is a libc FUNCTION, and this image links no libc.** So the child is built by hand out of
// `clone`, `pipe2`, `dup3` and `execve`.
//
// ⭐⭐⭐ **THE STATUS PIPE IS WHAT MAKES `hProcess == 0` REACHABLE.** `posix_spawnp` reports a failed exec to
// the CALLER; a hand-built fork cannot, because by then the failure is in another process. So a
// `pipe2(O_CLOEXEC)` is opened before the clone and the parent READS it: a successful exec closes the child's
// end and the read sees EOF, while a failed one writes the `-errno` down it. Without this the Std tier's own
// spawn-failure test could never fire on this lane.
//
// ⚠ **A SECOND SPAWN CAN INTERLEAVE WITH THIS ONE, AND `O_CLOEXEC` IS WHAT MAKES THAT HARMLESS.** Both ends
// of the status pipe carry it, so a concurrent child's own `execve` drops its inherited copy and the reading
// parent still sees EOF.
//
// ⚠ **PATH RESOLUTION IS THE Std TIER'S AND IS NOT REDONE HERE.** `execve` takes a path where `posix_spawnp`
// searches `PATH`, and that search already happened one tier up through `__gt_subp_resolve_path`.
//
// ⭐⭐ **THE `envp` A CALLER BUILT ARRIVES FINISHED, WHICH IS WHY THE CHILD PATH STAYS ALLOCATION-FREE.**
// `lpEnvironment` is a NUL-separated BLOCK and `execve`'s third argument is a POINTER VECTOR, and the
// conversion runs in `SubprocessRuntime.buildSubpEnvVector` — Std-IR the PARENT executes before this chunk
// is called, so the `clone` copies a vector the child only reads.
function buildX64LinuxSpawnChunk() returns FunctionCodeChunk
	let SlotArgv = 0 as StackSize
	let SlotCwd = 1 as StackSize
	let SlotFlags = 2 as StackSize
	let SlotStartup = 3 as StackSize
	let SlotProcInfo = 4 as StackSize
	let SlotPid = 5 as StackSize
	let SlotHandle = 6 as StackSize
	let SlotStatusFds = 7 as StackSize
	let SlotStatusRead = 8 as StackSize
	let SlotStatusWrite = 9 as StackSize
	let SlotStatusWord = 10 as StackSize
	let SlotStatusCount = 11 as StackSize
	let SlotEnv = 12 as StackSize
	var asm = X64RuntimeAsm.beginFunction(13)

	let piped = asm.newLabel()
	let cloneFailed = asm.newLabel()
	let spawnFailed = asm.newLabel()
	let childPath = asm.newLabel()
	let spawned = asm.newLabel()
	let published = asm.newLabel()
	let noSession = asm.newLabel()
	let inheritCwd = asm.newLabel()
	let envChosen = asm.newLabel()

	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotArgv), srcReg: X64Register.rcx)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotCwd), srcReg: X64Register.rdx)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotFlags), srcReg: X64Register.r8)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotStartup), srcReg: X64Register.r9)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rbp, disp: win64IncomingArgDisp(SpawnProcInfoIncomingSlot), wide: true)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotProcInfo), srcReg: X64Register.rax)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rbp, disp: win64IncomingArgDisp(SpawnEnvironmentIncomingSlot), wide: true)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotEnv), srcReg: X64Register.rax)

	encodeLeaRegRegImm32(asm.code, dest: X64Register.rdi, base: X64Register.rbp, disp: asm.slotDisp(SlotStatusFds))
	encodeMovRegImm32(asm.code, dest: X64Register.rsi, value: LinuxOpenCloseOnExec)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallPipe2)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.greaterEqual, targetBlockId: piped)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: spawnFailed)

	asm.placeLabel(piped)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotStatusFds))
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rcx, disp: 0, wide: false)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotStatusRead), srcReg: X64Register.rax)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rcx, disp: PosixPipeWriteEndOffset as Imm32, wide: false)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotStatusWrite), srcReg: X64Register.rax)

	// ⛔ `clone(flags, stack, ptid, ctid, tls)` — x86-64's order. All four pointer arguments are NULL here, so
	// the AArch64 disagreement about the last two cannot bite; it bites in `mrt_host_thread_create`.
	encodeMovRegImm32(asm.code, dest: X64Register.rdi, value: LinuxCloneExitSignalChild)
	encodeMovRegImm32(asm.code, dest: X64Register.rsi, value: LinuxCloneParentStack)
	encodeMovRegImm32(asm.code, dest: X64Register.rdx, value: LinuxCloneNoParentTidOut)
	encodeMovRegImm32(asm.code, dest: X64Register.r10, value: LinuxCloneNoChildTidOut)
	encodeMovRegImm32(asm.code, dest: X64Register.r8, value: LinuxCloneNoThreadPointer)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallClone)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.less, targetBlockId: cloneFailed)
	encodeRmRegDirect(asm.code, opcode: OpcodeTestRmReg, dest: X64Register.rax, src: X64Register.rax, wide: true)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: childPath)

	// PARENT. Drop the write end so the read below can see EOF, then take the child's verdict.
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotPid), srcReg: X64Register.rax)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdi, base: X64Register.rbp, disp: asm.slotDisp(SlotStatusWrite), wide: true)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallClose)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdi, base: X64Register.rbp, disp: asm.slotDisp(SlotStatusRead), wide: true)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rsi, base: X64Register.rbp, disp: asm.slotDisp(SlotStatusWord))
	encodeMovRegImm32(asm.code, dest: X64Register.rdx, value: SpillSlotBytes as MachineWord)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallRead)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotStatusCount), srcReg: X64Register.rax)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdi, base: X64Register.rbp, disp: asm.slotDisp(SlotStatusRead), wide: true)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallClose)
	// ⛔ **ONLY A POSITIVE COUNT MEANS THE CHILD SPOKE.** 0 is the EOF a successful `execve` produces through
	// the close-on-exec pipe; a NEGATIVE is the read's own failure (`EINTR`), and treating either as a verdict
	// would publish `SlotStatusWord` — which the child never wrote — as the spawn's errno.
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rbp, disp: asm.slotDisp(SlotStatusCount), wide: true)
	emitCmpRegImm(asm, reg: X64Register.rax, imm: 0)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.lessEqual, targetBlockId: spawned)

	// The child could not exec. Reap it — it is already exiting, so this cannot block — publish the reason it
	// sent, and answer the null handle that IS this op's failure report.
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdi, base: X64Register.rbp, disp: asm.slotDisp(SlotPid), wide: true)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rsi, base: X64Register.rbp, disp: asm.slotDisp(SlotStatusCount))
	encodeMovRegImm32(asm.code, dest: X64Register.rdx, value: LinuxReapUntilItExits)
	encodeMovRegImm32(asm.code, dest: X64Register.r10, value: PosixReapDiscardsRusage)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallWait4)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rbp, disp: asm.slotDisp(SlotStatusWord), wide: true)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: spawnFailed)

	// The clone itself failed: close both ends of a pipe no child will ever hold, then report as above. The
	// reason has to be carried across the two closes, each of which writes rax.
	asm.placeLabel(cloneFailed)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotStatusWord), srcReg: X64Register.rax)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdi, base: X64Register.rbp, disp: asm.slotDisp(SlotStatusRead), wide: true)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallClose)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdi, base: X64Register.rbp, disp: asm.slotDisp(SlotStatusWrite), wide: true)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallClose)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rbp, disp: asm.slotDisp(SlotStatusWord), wide: true)

	// spawnFailed: rax holds the `-errno` of whichever call failed. Publish it where `mrt_host_last_error`
	// reads it and leave a ZERO `hProcess`, which is the Std tier's own spawn-failure test.
	asm.placeLabel(spawnFailed)
	x64LinuxEmitStashErrno(asm)
	encodeMovRegImm32(asm.code, dest: X64Register.r8, value: PosixNoProcessHandle)
	encodeMovRegImm32(asm.code, dest: X64Register.r9, value: PosixNoProcessId)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: published)

	asm.placeLabel(spawned)
	encodeMovRegImm32(asm.code, dest: X64Register.rcx, value: PosixWaitKindProcess)
	encodeCallDirect(asm.code, callFixups: asm.callFixups, targetName: HostWaitNewName)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotHandle), srcReg: X64Register.rax)
	x64LinuxEmitUntagHandle(asm, reg: X64Register.rax)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.r9, base: X64Register.rbp, disp: asm.slotDisp(SlotPid), wide: true)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rax, disp: PosixWaitOffChildPid as Imm32, srcReg: X64Register.r9)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.r8, base: X64Register.rbp, disp: asm.slotDisp(SlotHandle), wide: true)
	encodeJmp(asm.code, rel32Fixups: asm.rel32Fixups, targetBlockId: published)

	// ⛔ THE CHILD. From here to the `execve` nothing but raw syscalls runs — no allocation, no lock, no call
	// into anything the scheduler owns — which is the whole of what "async-signal-safe between fork and exec"
	// asks for. It never falls out of this block: a successful `execve` does not return, and a failed one ends
	// in `exit`, which is why `published` below can sit under it.
	asm.placeLabel(childPath)
	emitX64LinuxChildDup3(asm, startupSlot: SlotStartup, handleOffset: StartupInfoHStdInputOffset as Imm32, childDescriptor: PosixChildStdinFd)
	emitX64LinuxChildDup3(asm, startupSlot: SlotStartup, handleOffset: StartupInfoHStdOutputOffset as Imm32, childDescriptor: PosixChildStdoutFd)
	emitX64LinuxChildDup3(asm, startupSlot: SlotStartup, handleOffset: StartupInfoHStdErrorOffset as Imm32, childDescriptor: PosixChildStderrFd)

	// `DETACHED_PROCESS` ⇒ `setsid()`, which is what `POSIX_SPAWN_SETSID` asks the Darwin lane's spawnattr
	// for: a detached child gets its own SESSION and outlives the parent's terminal.
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rax, base: X64Register.rbp, disp: asm.slotDisp(SlotFlags), wide: true)
	encodeGrp1RegImm32(asm.code, ext: Grp1ExtAnd, reg: X64Register.rax, imm: DetachedProcess as Imm32)
	encodeRmRegDirect(asm.code, opcode: OpcodeTestRmReg, dest: X64Register.rax, src: X64Register.rax, wide: true)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: noSession)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallSetsid)

	// A NULL `lpCurrentDirectory` inherits the parent's, which is the absence of a `chdir`.
	asm.placeLabel(noSession)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdi, base: X64Register.rbp, disp: asm.slotDisp(SlotCwd), wide: true)
	encodeRmRegDirect(asm.code, opcode: OpcodeTestRmReg, dest: X64Register.rdi, src: X64Register.rdi, wide: true)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: inheritCwd)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallChdir)

	// `execve(argv[0], argv, envp)`. `envp` is the caller's own vector when it built one, and otherwise the
	// vector the entry stub captured — which is what a NULL `lpEnvironment` means, the parent's environment,
	// and the same one `mrt_host_env_read` walks. Both are finished vectors in the parent's address space, so
	// the child only reads.
	asm.placeLabel(inheritCwd)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rsi, base: X64Register.rbp, disp: asm.slotDisp(SlotArgv), wide: true)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdi, base: X64Register.rsi, disp: 0, wide: true)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdx, base: X64Register.rbp, disp: asm.slotDisp(SlotEnv), wide: true)
	encodeRmRegDirect(asm.code, opcode: OpcodeTestRmReg, dest: X64Register.rdx, src: X64Register.rdx, wide: true)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.notEqual, targetBlockId: envChosen)
	encodeLeaRegGlobal(asm.code, rdataRelocs: asm.rdataRelocs, dest: X64Register.rdx, label: LinuxEnvpLabel)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdx, base: X64Register.rdx, disp: 0, wide: true)
	asm.placeLabel(envChosen)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallExecve)

	// The exec failed. Send the parent the `-errno` the kernel just answered and stop.
	//
	// ⛔ **`exit` (60) AND NOT `exit_group` (231).** They are a whole process apart in meaning, and a child
	// that shares nothing with its parent still shares that call's NAME with the one the entry stub uses to
	// end the WHOLE program.
	encodeStoreBaseDispReg(asm.code, base: X64Register.rbp, disp: asm.slotDisp(SlotStatusWord), srcReg: X64Register.rax)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdi, base: X64Register.rbp, disp: asm.slotDisp(SlotStatusWrite), wide: true)
	encodeLeaRegRegImm32(asm.code, dest: X64Register.rsi, base: X64Register.rbp, disp: asm.slotDisp(SlotStatusWord))
	encodeMovRegImm32(asm.code, dest: X64Register.rdx, value: SpillSlotBytes as MachineWord)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallWrite)
	encodeMovRegImm32(asm.code, dest: X64Register.rdi, value: LinuxExecFailedExitCode)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallExit)
	asm.code.push(OpcodeInt3)

	// published: r8 = hProcess, r9 = dwProcessId. Both arms arrive with the pair already chosen, so the three
	// stores that fill the record are written once.
	asm.placeLabel(published)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rcx, base: X64Register.rbp, disp: asm.slotDisp(SlotProcInfo), wide: true)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rcx, disp: ProcInfoHProcessOffset as Imm32, srcReg: X64Register.r8)
	encodeMovRegImm32(asm.code, dest: X64Register.rax, value: PosixNoThreadHandle)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rcx, disp: ProcInfoHThreadOffset as Imm32, srcReg: X64Register.rax)
	encodeStoreBaseDispReg(asm.code, base: X64Register.rcx, disp: ProcInfoDwProcessIdOffset as Imm32, srcReg: X64Register.r9)

	return asm.finishFunction(HostSpawnName)
end 'buildX64LinuxSpawnChunk'

// The two arguments past the Win64 register file, in the order `StdOp.osProcessSpawn` names its operands.
// Named because the WRITER (`StdToX64Conversion.lowerOsProcessSpawnLinux`) and the READER above are in
// different files and a bare 0 and 1 at two sites is the one fact that pair must agree on.
export let SpawnProcInfoIncomingSlot = 0 as StackSize
export let SpawnEnvironmentIncomingSlot = 1 as StackSize

// `dup3(startup->handle, childDescriptor, 0)` — one of the three the child emits, and the whole of what
// `posix_spawn_file_actions_adddup2` does on the Darwin lane. See `LinuxDup3NoFlags` for the zero, for why
// the equal-descriptor guard below is required, and for why the handle is untagged first.
function emitX64LinuxChildDup3(asm X64RuntimeAsm, startupSlot StackSize, handleOffset Imm32, childDescriptor MachineWord)
	let alreadyThere = asm.newLabel()

	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdi, base: X64Register.rbp, disp: asm.slotDisp(startupSlot), wide: true)
	encodeLoadRegBaseDisp(asm.code, destReg: X64Register.rdi, base: X64Register.rdi, disp: handleOffset, wide: true)
	x64LinuxEmitUntagHandle(asm, reg: X64Register.rdi)
	encodeMovRegImm32(asm.code, dest: X64Register.rsi, value: childDescriptor)
	encodeRmRegDirect(asm.code, opcode: OpcodeCmpRmReg, dest: X64Register.rdi, src: X64Register.rsi, wide: true)
	encodeJcc(asm.code, rel32Fixups: asm.rel32Fixups, cond: X64CondCode.equal, targetBlockId: alreadyThere)
	encodeMovRegImm32(asm.code, dest: X64Register.rdx, value: LinuxDup3NoFlags)
	encodeX64Syscall(asm.code, number: X64LinuxSyscallDup3)

	asm.placeLabel(alreadyThere)
end 'emitX64LinuxChildDup3'

// ==========================================================================
// Assembly
// ==========================================================================

// ⭐ **ONE BIT, TWO TIERS.** Every gate below is the SAME `RuntimeUsage` bit the Std-tier installer that
// emits the calls was gated on, so a `call` into an absent chunk is unreachable rather than merely
// unlikely — the arrangement `appendArm64LinuxRuntimeChunks` states at length.
export function appendX64LinuxHostSurfaceChunks(chunks FunctionCodeChunkArray, usage RuntimeUsage)
	assertLinuxSearchGeometry()

	let usesFilesystem = usage.usesManagedFile or usage.usesManagedDirectory

	// ⭐ **L3 — FOUR CHUNKS ON FOUR INDEPENDENT BITS, EACH THE Std TIER'S OWN.** `installClockRuntime` builds
	// `__clock_now_unix_s` under `usesWallClock` and `__thread_cpu_ticks` under `usesThreadCpuTicks`;
	// `installProcessRuntime` builds `__proc_exe_path` under `usesExecutablePath`; `CpuParallelRuntime` builds
	// `__cpu_count` under `usesCpuCount`. One bit, two tiers — so a `call` into an absent chunk is
	// unreachable rather than merely unlikely (`concatX64FunctionChunks` PANICS on an unresolved CallFixup).
	if usage.usesWallClock 'wallClock'
		chunks.push(buildX64LinuxWallClockChunk())
	end 'wallClock'

	if usage.usesThreadCpuTicks 'threadCpu'
		chunks.push(buildX64LinuxThreadCpuChunk())
	end 'threadCpu'

	if usage.usesExecutablePath 'executablePath'
		chunks.push(buildX64LinuxExePathChunk())
	end 'executablePath'

	// ⚠ **THE PROCESSOR COUNT RIDES A UNION.** Every green-thread program reads `MAXON_MAX_PROCS` and clamps
	// it against the machine (`SchedRuntime.emitResolveMaxProcs`), so `usesGt` is a second producer of
	// `osCpuCount` behind `usesCpuCount`'s back — the arm64 lane measured that as an unresolved-symbol panic
	// on its first green-thread program.
	if usage.usesCpuCount or usage.usesGt 'cpuCount'
		chunks.push(buildX64LinuxCpuCountChunk())
	end 'cpuCount'

	if linuxUsesHostSurface(usage) 'lastError'
		chunks.push(buildX64LinuxLastErrorChunk())
	end 'lastError'

	// The terminal test, on `installTerminalRuntime`'s own bit — the detecting body it builds under exactly
	// this condition is the only producer of `osHandleFileType`.
	if usage.usesTerminalDetection 'terminalDetection'
		chunks.push(buildX64LinuxHandleFileTypeChunk())
	end 'terminalDetection'

	// The environment read rides the UNION of `osEnvRead`'s two producers (`posixReadsEnvironment`), because
	// a terminal-detecting program need not have a scheduler and a green-thread one need not detect a
	// terminal — and both emit the op.
	if posixReadsEnvironment(usage) 'envRead'
		chunks.push(buildX64LinuxEnvReadChunk())
	end 'envRead'

	// ⭐ **L4 — THE GREEN-THREAD FLOOR, ON ONE BIT.** `usesGt` is the bit `installGtRuntime` itself was gated
	// on, so every body that can `call` one of these is built under exactly the same condition — one bit, two
	// tiers, which is what makes a call into an absent chunk unreachable rather than merely unlikely. They are
	// NOT split finer: the P's wake event, the run-queue lock, the per-thread slot, the monotonic clock, the
	// OS-thread park and the `MAXON_MAX_PROCS` read are all reached from `__sched_init_procs` and `__gt_init`,
	// which a green-thread program always installs together.
	if usage.usesGt 'greenThreadFloor'
		chunks.push(buildX64LinuxMonotonicClockChunk())
		chunks.push(buildX64LinuxSleepMsChunk())
		chunks.push(buildX64LinuxWaitNewChunk())
		chunks.push(buildX64LinuxEventSetChunk())
		chunks.push(buildX64LinuxWaitOneChunk())
		chunks.push(buildX64LinuxWaitCloseChunk())
		chunks.push(buildX64LinuxLockInitChunk())
		chunks.push(buildX64LinuxLockEnterChunk())
		chunks.push(buildX64LinuxLockLeaveChunk())
		chunks.push(buildX64LinuxThreadCreateChunk())
		chunks.push(buildX64LinuxTlsAllocChunk())
		chunks.push(buildX64LinuxTlsSetChunk())
		// ⭐⭐ **L5's CHILD-PROCESS CORE RIDES `usesGt`, NOT A SUBPROCESS BIT, BECAUSE `installGtRuntime` BUILDS
		// `__gt_process_run` UNCONDITIONALLY.** Every green-thread program statically contains a spawn, an
		// exit-code read and the netpoll's multi-wait — the child store is merely EMPTY in one that never runs
		// a child — so a narrower gate here is a call to a symbol nothing laid out, which is a link failure
		// rather than a diagnostic.
		chunks.push(buildX64LinuxProcReapChunk())
		chunks.push(buildX64LinuxProcAwaitChunk())
		chunks.push(buildX64LinuxWaitAnyChunk())
		chunks.push(buildX64LinuxSpawnChunk())
		chunks.push(buildX64LinuxProcExitCodeChunk())
	end 'greenThreadFloor'

	// ⭐ **THE PIPE SURFACE AND THE DEADLINE, WHICH REALLY ARE NARROWER.** `usesIocp` is the bit
	// `installGtRuntime` builds the pipe substrate under (`__gt_io_read` and `__gt_subp_yield_read`), and
	// `usesStreaming` implies it — so a program that spawns a child WITHOUT reading from it pays for none of
	// these. `osPipePeek`, `osProcessTerminate` and `osTickCountMs` have producers only inside that band.
	if usage.usesIocp 'childPipes'
		chunks.push(buildX64LinuxPipeChunk())
		chunks.push(buildX64LinuxPipePeekChunk())
		chunks.push(buildX64LinuxProcTerminateChunk())
		chunks.push(buildX64LinuxTickMsChunk())
	end 'childPipes'

	if usesFilesystem 'filesystem'
		chunks.push(buildX64LinuxBaseNameChunk())
		chunks.push(buildX64LinuxHasWildcardChunk())
		chunks.push(buildX64LinuxFillFindDataChunk(x64LinuxStatLayout()))
		chunks.push(buildX64LinuxGlobMatchChunk())
		chunks.push(buildX64LinuxDirPrefixChunk())
		chunks.push(buildX64LinuxDirFindFirstChunk())
		chunks.push(buildX64LinuxDirFindNextChunk())
		chunks.push(buildX64LinuxDirFindCloseChunk())
	end 'filesystem'

	// ⚠ **THE OPEN HAS A SECOND PRODUCER, AND IT IS NOT A `File` CALL.** `GtRuntime`'s file-backed stdio arm
	// emits `osFileOpenRead`/`osFileOpenWrite` for a subprocess stream redirected to a path, so a program
	// that touches no `File` still branches here.
	if linuxOpensFiles(usage) 'fileOpen'
		chunks.push(buildX64LinuxFileOpenChunk())
	end 'fileOpen'

	if usage.usesManagedFile 'managedFile'
		chunks.push(buildX64LinuxFileSizeChunk())
		chunks.push(buildX64LinuxPathOpChunk(HostFileDeleteName, syscallNumber: X64LinuxSyscallUnlinkat, thirdArgument: LinuxUnlinkFileFlags))
		chunks.push(buildX64LinuxFileRenameChunk())
	end 'managedFile'

	// ⚠ `__gt_subp_write_all` and the collect loop's stdin push emit `StdOp.osWriteFile` on the child's stdin
	// pipe, so the write half rides the same union its read twin does.
	if usage.usesManagedFile or usage.usesIocp 'managedFileWrite'
		chunks.push(buildX64LinuxTransferChunk(HostWriteFileName, syscallNumber: X64LinuxSyscallWrite))
	end 'managedFileWrite'

	// ⚠ **THE READ CHUNK RIDES A UNION BECAUSE `StdOp.osReadFile` HAS THREE PRODUCERS.** `__mf_read`,
	// `__con_read_stdin` and `__gt_subp_yield_read` emit the identical op — standard input and a pipe are
	// descriptors like any other here — so gating it on `usesManagedFile` alone would leave a stdin-only
	// program calling a symbol nothing emitted, and pushing it under each bit would lay the same symbol out
	// more than once.
	if linuxReadsFiles(usage) 'transferIn'
		chunks.push(buildX64LinuxTransferChunk(HostReadFileName, syscallNumber: X64LinuxSyscallRead))
	end 'transferIn'

	if usage.usesManagedDirectory 'managedDirectory'
		chunks.push(buildX64LinuxPathOpChunk(HostDirCreateName, syscallNumber: X64LinuxSyscallMkdirat, thirdArgument: PosixDirectoryMode as MachineWord))
		chunks.push(buildX64LinuxDirCurrentPathChunk())
	end 'managedDirectory'

	// The mode→attribute-mask decoder is called by BOTH `mrt_host_fill_find_data` (the filesystem cluster
	// above) and `mrt_host_file_attributes` (below), so its gate is the union of theirs — which is what lifts
	// it out of the cluster it used to sit inside.
	if usesFilesystem or usage.usesIocp 'attrsFromMode'
		chunks.push(buildX64LinuxAttrsFromModeChunk(x64LinuxStatLayout()))
	end 'attrsFromMode'

	// ⚠ **`GetFileAttributesA` HAS A SECOND PRODUCER AND IT IS NOT A DIRECTORY OP.** `__gt_subp_resolve_path`
	// walks `PATH` testing each candidate with `StdOp.osFileAttributes`, so the executable lookup needs this
	// chunk with no `Directory` call anywhere in the program.
	if usage.usesManagedDirectory or usage.usesIocp 'fileAttributes'
		chunks.push(buildX64LinuxFileAttributesChunk())
	end 'fileAttributes'
end 'appendX64LinuxHostSurfaceChunks'
