// StdToX64Conversion — Std → Target (x64) lowering. Takes a StdModule and
// produces a fresh TargetModule of x64 `TargetOp`s. Each StdOp is lowered to its
// x64 op sequence; the result still uses VIRTUAL registers (X64VReg.virtual),
// which the register allocator colors to physical GPRs afterward.
//
// This is the ONLY tier boundary below Std — shv2 has no MIR tier (see
// StdDialect's header for why v1's was dropped). The virtual registers this pass
// consumes are Std's own `ValueId`s, which have BEEN SSA virtual registers since
// the Maxon→Std lowering minted them; v1's MIR tier never added a value model,
// only a copy of one.
//
// THIN for maxon-shv2 M1: lowers exactly the `return 42` slice —
//   StdOp.const(id, v, valueType) -> appendIntImmToReg  (movRegImm32 / movRegImm)
//   StdOp.ret(id)  terminator     -> mov R8, <retval>   + ret
// The primary return value goes to **R8**, not RAX — Maxon's self-designed
// calling convention (v1 does the same). Later milestones GROW the dispatch with
// the ALU / compare-branch / general-call / memory arms + the float (XMM) return
// path as the Std dialect grows. v1's per-function lowering structure (a skeleton
// clone of the block graph, then a per-function op walk) is preserved so the
// per-function fan-out driver (M5) can wrap one function at a time.
//
// NOTE ON FRAMES: unlike v1's ISel — which emits `epilogue` at every return and
// lets the prologue/epilogue pass strip/re-emit it — shv2's return lowering emits
// ONLY the R8 move + `ret`. Frame setup AND teardown are owned entirely by the
// prologue/epilogue pass (InsertPrologueEpilogue), which inserts `prologue` at
// entry and `epilogue` before the return terminator when the function needs a
// frame. This removes the emit-then-strip dance; at M1 no user function needs a
// frame, so main lowers to a flat `mov reg,42; mov r8,reg; ret`.

// Append the canonical x64 op for "load an integer immediate into a GPR".
// Centralizes the size choice so every caller produces the same shape:
//   0 <= value <= u32.max -> movRegImm32 (5-byte form; the imm32 zero-extends)
//   otherwise             -> movRegImm   (full 10-byte `mov r64, imm64`)
// GROWS the value==0 `xor reg,reg` zeroing idiom when a flag-neutral-vs-shorter
// tradeoff first matters (arithmetic, M3); at M1 `mov r32, 0` is correct and the
// only literal the slice materializes is 42.
export function appendIntImmToReg(module TargetModule, dstBlock IrBlock, dest X64VReg, value MachineWord)
	if value <= u32.max 'fitsU32'
		module.appendOp(dstBlock, op: TargetOp.movRegImm32(dest, value: value))
	end 'fitsU32' else 'wide'
		module.appendOp(dstBlock, op: TargetOp.movRegImm(dest, value: value))
	end 'wide'
end 'appendIntImmToReg'

// Maps the SSA value a `cmp` defines to the predicate it compared with. Populated
// when a `cmp` is lowered and consumed at the following `condBranch` — the two are
// FUSED into `cmp` + `jcc` rather than materializing a boolean (see lowerCmp). Keyed
// by ValueId, which is function-local, so the map is reset per function.
typealias CmpPredMap = Map with (ValueId, StdCmpPred)

// Map a Std comparison predicate to the x64 signed-jump condition code. ONE table
// (not one branch encoder per predicate): the fused `cmp`+`jcc` lowering reads the
// condition here. Signed conditions throughout — all Std integers are signed i64.
function condCodeForPred(pred StdCmpPred) returns X64CondCode
	return match pred 'map'
		eq gives X64CondCode.equal
		ne gives X64CondCode.notEqual
		lt gives X64CondCode.less
		gt gives X64CondCode.greater
		le gives X64CondCode.lessEqual
		ge gives X64CondCode.greaterEqual
	end 'map'
end 'condCodeForPred'

export function lowerStdToX64(stdModule StdModule) returns TargetModule
	var lowering = StdToX64Lowering.create(stdModule)
	lowering.prepareSkeleton()
	for srcFunc in stdModule.functions 'eachFunc'
		lowering.lowerFunction(srcFunc)
	end 'eachFunc'
	return lowering.targetModule
end 'lowerStdToX64'

type StdToX64Lowering
	var stdModule as StdModule
	// Exported so the free-function entry can read the finished module after
	// driving the per-function loop (M5's fan-out driver reads it too).
	export var targetModule as TargetModule
	// Per-function `cmp`-value → predicate table for the fused compare/branch
	// lowering. Reset at the start of each function (ValueIds are function-local).
	var cmpPreds as CmpPredMap

	static function create(stdModule StdModule) returns StdToX64Lowering
		return Self{stdModule: stdModule, targetModule: TargetModule.create(), cmpPreds: CmpPredMap.create()}
	end 'create'

	// Whole-module setup: clone every StdModule block 1:1 into `targetModule.blocks`
	// (preserving the flat-block indices `IrFunction.blockRefs` references) and
	// transfer every function (its StdReturnType / paramTypes carry across
	// unchanged). Must run before any lowerFunction call.
	//
	// Both `blockArgs` (the phis) AND `branchEdges` (each predecessor's per-phi
	// incoming values) are carried across: the register allocator consumes them
	// DIRECTLY and does SSA destruction after coloring (EliminatePhis is retired),
	// so the phi model must survive into the Target tier intact.
	function prepareSkeleton()
		for srcBlock in self.stdModule.blocks 'cloneBlocks'
			var dstBlock = IrBlock.create(srcBlock.id, label: srcBlock.label)
			for srcArg in srcBlock.blockArgs 'eachArg'
				dstBlock.blockArgs.push(IrBlockArg.cloneOf(srcArg))
			end 'eachArg'
			for srcEdge in srcBlock.branchEdges 'eachEdge'
				dstBlock.branchEdges.push(BranchEdge.create(srcEdge.targetBlockId, argIds: srcEdge.argIds.clone()))
			end 'eachEdge'
			self.targetModule.blocks.push(dstBlock)
		end 'cloneBlocks'

		for srcFunc in self.stdModule.functions 'transferFuncs'
			self.targetModule.functions.push(srcFunc)
		end 'transferFuncs'
	end 'prepareSkeleton'

	// Per-function lowering: walk the function's blocks and lower each op into the
	// matching target block (indexed by the same blockRef the function carries).
	// The function's StdReturnType drives whether the return materializes an R8 move.
	function lowerFunction(srcFunc IrFunction)
		// Fresh predicate table per function — a `cmp`'s ValueId only means anything
		// within its own function, and the fused branch that consumes it is in the
		// same function.
		self.cmpPreds = CmpPredMap.create()

		for blockRef in srcFunc.blockRefs 'eachBlock'
			let srcBlock = try self.stdModule.blocks.get(blockRef) otherwise panic("lowerStdToX64: blockRef from srcFunc.blockRefs not in stdModule.blocks")
			var dstBlock = try self.targetModule.blocks.get(blockRef) otherwise panic("lowerStdToX64: targetModule.blocks 1:1 with stdModule.blocks but get({blockRef}) failed")

			for opIdx in srcBlock.opRefs 'eachOp'
				let stdOp = try self.stdModule.ops.get(opIdx) otherwise panic("lowerStdToX64: opIdx from srcBlock.opRefs not in stdModule.ops")
				self.lowerBodyOp(stdOp, dstBlock: dstBlock, returnType: srcFunc.returnType)
			end 'eachOp'

			if srcBlock.hasTerminatorOp() 'hasTerm'
				let termOp = try self.stdModule.ops.get(srcBlock.terminatorIndex()) otherwise panic("lowerStdToX64: terminatorIndex not in stdModule.ops")
				self.lowerTerminatorOp(termOp, dstBlock: dstBlock, returnType: srcFunc.returnType)
			end 'hasTerm'
		end 'eachBlock'
	end 'lowerFunction'

	// Lower a regular (non-terminator) Std op. `ret` reaching here is the rare
	// mid-block form (LowerMaxonToStd emits it as a body op for a partially-
	// terminated block); it lowers the same as the terminator form, just appended.
	function lowerBodyOp(op StdOp, dstBlock IrBlock, returnType StdReturnType)
		match op 'lower'
			const(resultId, value, valueType) then self.lowerConst(resultId, value: value, valueType: valueType, dstBlock: dstBlock)
			binOp(resultId, lhs, rhs, opcode) then self.lowerBinOp(resultId, lhs: lhs, rhs: rhs, opcode: opcode, dstBlock: dstBlock)
			unaryOp(resultId, operand, opcode) then self.lowerUnaryOp(resultId, operand: operand, opcode: opcode, dstBlock: dstBlock)
			cmp(resultId, lhs, rhs, pred) then self.lowerCmp(resultId, lhs: lhs, rhs: rhs, pred: pred, dstBlock: dstBlock)
			ret(retValId) then self.lowerReturn(retValId, dstBlock: dstBlock, returnType: returnType, asTerminator: false)
			condBranch then panic("lowerStdToX64: a `condBranch` appeared as a body op (lowering bug — a branch is always a block terminator)")
			branch then panic("lowerStdToX64: a `branch` appeared as a body op (lowering bug — a branch is always a block terminator)")
		end 'lower'
	end 'lowerBodyOp'

	// Lower a block terminator. M4 adds the two branch terminators; `ret` stays. A
	// `const`/`binOp`/`unaryOp`/`cmp` terminator is a lowering bug (none is a terminator).
	function lowerTerminatorOp(op StdOp, dstBlock IrBlock, returnType StdReturnType)
		match op 'lower'
			ret(retValId) then self.lowerReturn(retValId, dstBlock: dstBlock, returnType: returnType, asTerminator: true)
			condBranch(condId, thenBlockId, elseBlockId) then self.lowerCondBranch(condId, thenBlockId: thenBlockId, elseBlockId: elseBlockId, dstBlock: dstBlock)
			branch(targetBlockId) then self.lowerBranch(targetBlockId, dstBlock: dstBlock)
			const then panic("lowerStdToX64: a `const` op appeared as a block terminator (lowering bug — a constant is never a terminator)")
			binOp then panic("lowerStdToX64: a `binOp` op appeared as a block terminator (lowering bug — a binary op is never a terminator)")
			unaryOp then panic("lowerStdToX64: a `unaryOp` op appeared as a block terminator (lowering bug — a unary op is never a terminator)")
			cmp then panic("lowerStdToX64: a `cmp` op appeared as a block terminator (lowering bug — a comparison is never a terminator)")
		end 'lower'
	end 'lowerTerminatorOp'

	// Materialize a constant into its virtual register. The op's own StdType picks
	// the register file (GP vs XMM) — this is what v1 encoded as a `constI64` /
	// `constF64` opcode pair and then re-encoded as MIR's `isFloat` bool.
	function lowerConst(resultId ValueId, value ParsedInt, valueType StdType, dstBlock IrBlock)
		if stdTypeIsFloat(valueType) 'float'
			panic("lowerStdToX64: float constants (XMM materialization) are not supported until M3 — the `return 42` slice is integer-only")
		end 'float'
		appendIntImmToReg(self.targetModule, dstBlock: dstBlock, dest: X64VReg.virtual(resultId), value: value)
	end 'lowerConst'

	// Lower a Std binary op to x64. x64 ALU ops are two-address (`dst = dst <op>
	// src`), so `result = lhs <op> rhs` lowers to the SEED copy `mov result, lhs`
	// then the in-place op against `rhs`. This kept two-address shape is described to
	// the register allocator by the OPERAND MODEL (TargetOperands): `result` is a
	// fresh value seeded from `lhs`, then read-modify-written by the ALU op. The
	// allocator's BIASED coloring gives `result` the same register as `lhs` when
	// `lhs` dies at the seed copy, and its rewrite then drops the resulting
	// `mov r, r` — so the seed never survives for a loop-carried update like
	// `sum = sum + i`, with NO Std-level coalescing needed (that is exactly what M5
	// deletes EliminatePhis for). Operand ORDER matters for the non-commutative
	// `sub`: dest=lhs then `sub dest, rhs` yields lhs−rhs (e.g. `20 - 8` → 12).
	function lowerBinOp(resultId ValueId, lhs ValueId, rhs ValueId, opcode StdBinOpcode, dstBlock IrBlock)
		let dest = X64VReg.virtual(resultId)
		self.emitInPlaceCopy(resultId, srcId: lhs, dstBlock: dstBlock)
		let src = X64VReg.virtual(rhs)
		match opcode 'op'
			add then self.targetModule.appendOp(dstBlock, op: TargetOp.addRegReg(dest, srcReg: src))
			sub then self.targetModule.appendOp(dstBlock, op: TargetOp.subRegReg(dest, srcReg: src))
			mul then self.targetModule.appendOp(dstBlock, op: TargetOp.imulRegReg(dest, srcReg: src))
		end 'op'
	end 'lowerBinOp'

	// Lower a Std unary op to x64. Mirrors lowerBinOp's seed-then-op-in-place shape:
	// x64 `neg` is one-operand in-place (`reg = -reg`), so `result = -operand` lowers
	// to the seed `mov result, operand` + `neg result`. The operand model marks
	// `result` a fresh value seeded from `operand`; the allocator elides the seed when
	// biased coloring lands both in one register (see lowerBinOp).
	function lowerUnaryOp(resultId ValueId, operand ValueId, opcode StdUnaryOpcode, dstBlock IrBlock)
		let dest = X64VReg.virtual(resultId)
		self.emitInPlaceCopy(resultId, srcId: operand, dstBlock: dstBlock)
		match opcode 'op'
			neg then self.targetModule.appendOp(dstBlock, op: TargetOp.negReg(dest))
		end 'op'
	end 'lowerUnaryOp'

	// Emit the `mov dest, src` seeding an in-place ALU op. `dest` (a fresh binOp/
	// unaryOp result) is a distinct SSA value from `src`, so the seed is ALWAYS
	// emitted; the register allocator drops it when biased coloring gives `dest` and
	// `src` the same physical register. Shared by lowerBinOp and lowerUnaryOp.
	function emitInPlaceCopy(destId ValueId, srcId ValueId, dstBlock IrBlock)
		self.targetModule.appendOp(dstBlock, op: TargetOp.movRegReg(X64VReg.virtual(destId), srcReg: X64VReg.virtual(srcId)))
	end 'emitInPlaceCopy'

	// Lower a Std `cmp` to an x64 `cmp reg, reg`, and REMEMBER its predicate keyed by
	// the value it defines. No boolean is materialized here: in the M4 slice a compare
	// exists only to feed the `condBranch` that immediately follows it, so the actual
	// `jcc` is emitted at the branch (lowerCondBranch). The `cmp` still emits its
	// instruction at this site — the last flag-setting op before the branch — so the
	// EFLAGS the branch reads are live and set by exactly this compare.
	function lowerCmp(resultId ValueId, lhs ValueId, rhs ValueId, pred StdCmpPred, dstBlock IrBlock)
		self.cmpPreds.upsert(resultId, value: pred)
		self.targetModule.appendOp(dstBlock, op: TargetOp.cmpRegReg(X64VReg.virtual(lhs), rhsReg: X64VReg.virtual(rhs)))
	end 'lowerCmp'

	// Lower a Std `condBranch` to the fused `jcc <then>` + `jmp <else>`. The `jcc`
	// condition is the predicate the compare that defined `condId` recorded; the `jcc`
	// is a body op and the `jmp` is the block's terminator (a two-instruction two-way
	// branch cannot fit one terminator slot). An unconditional `jmp` to the else/merge
	// target is emitted for EVERY layout so correctness never depends on block ordering
	// (a later pass may elide a fall-through). A `condId` with no recorded predicate
	// means the `if` condition was not a comparison — the only condition form the M4
	// slice supports — so it fails loudly rather than emitting a wrong branch.
	function lowerCondBranch(condId ValueId, thenBlockId BlockId, elseBlockId BlockId, dstBlock IrBlock)
		let pred = try self.cmpPreds.get(condId) otherwise panic("lowerStdToX64: `condBranch` on value v{condId} which no `cmp` defined — the M4 slice only supports comparison conditions in an `if` (boolean values arrive later)")
		self.targetModule.appendOp(dstBlock, op: TargetOp.jcc(condCodeForPred(pred), targetBlockId: thenBlockId))
		self.targetModule.setTerminator(dstBlock, op: TargetOp.jmp(elseBlockId))
	end 'lowerCondBranch'

	// Lower a Std unconditional `branch` to a single `jmp` terminator.
	function lowerBranch(targetBlockId BlockId, dstBlock IrBlock)
		self.targetModule.setTerminator(dstBlock, op: TargetOp.jmp(targetBlockId))
	end 'lowerBranch'

	// Return: move the value into the primary-return register (R8) then emit `ret`.
	// Void returns skip the move (callers never read the register). Frame teardown
	// (`epilogue`) is inserted separately by the prologue/epilogue pass.
	function lowerReturn(retValId ValueId, dstBlock IrBlock, returnType StdReturnType, asTerminator bool)
		self.emitPrimaryReturnMove(retValId, dstBlock: dstBlock, returnType: returnType)
		if asTerminator 'asTerm'
			self.targetModule.setTerminator(dstBlock, op: TargetOp.ret)
		end 'asTerm' else 'asBody'
			self.targetModule.appendOp(dstBlock, op: TargetOp.ret)
		end 'asBody'
	end 'lowerReturn'

	// Move the primary return value into R8 (Maxon's internal calling convention
	// returns in R8, NOT RAX). No-op for void returns. The float (XMM0) return
	// path GROWS in at M3 when floats land.
	function emitPrimaryReturnMove(retValId ValueId, dstBlock IrBlock, returnType StdReturnType)
		if stdReturnTypeIsVoid(returnType) 'void'
			return
		end 'void'
		if stdReturnTypeIsFloat(returnType) 'float'
			panic("lowerStdToX64: float return values (XMM0) are not supported until M3 — the `return 42` slice is integer-only")
		end 'float'
		self.targetModule.appendOp(dstBlock, op: TargetOp.movRegReg(X64VReg.physical(X64Register.r8), srcReg: X64VReg.virtual(retValId)))
	end 'emitPrimaryReturnMove'
end 'StdToX64Lowering'
