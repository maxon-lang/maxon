// ParseStaging — `FileParseArtifact` and the deterministic `mergeArtifact` fold.
//
// This is the load-bearing parallel-ready seam of the frontend (PLAN.md). v1's
// parser mutates the shared `Project` directly as it parses (inserting into ~28
// registries mid-parse), which forces per-file parse to be serial and needs a
// ParseDelta rollback dance to undo a stale prior parse. shv2 inverts that: the
// parser writes ONLY into a per-file `FileParseArtifact` — its own MaxonModule
// fragment, its own local type-name interner, and a recorded key+value bundle
// for every registry it would touch — so a file's parse is a pure function of
// its tokens with no shared state. `mergeArtifact` is then the SINGLE writer of
// the shared `Project`, folding artifacts in fixed source-path order so the
// result is deterministic regardless of the order files were parsed.
//
// For M1 the registry set is exactly one entry family (`funcReturnTypes`); v1's
// ParseDelta enumerates ~28. Each grows here, as an ordered entry array, at its
// milestone. The array (not a map) keeps the contribution insertion-ordered so
// the merge is byte-deterministic.

// ⭐ **THE SHARED EMPTY contribution arrays.** An artifact that records NONE of a family — a file with
// no `interface`/`implements` declaration, and (see below) any artifact that never records a type name
// at all — points its field at one of these shared, never-mutated singletons rather than allocating an
// empty array it will never push into. The matching `record*` copies on write at the first push
// (`count() == 0` uniquely identifies "still the shared empty", since each of those functions is its
// array's only writer). This is the same pay-for-use discipline `sharedEmptyInnerAliases`/`emptyTypeParams`
// follow, and it keeps the artifact allocation-neutral for a program that declares none (measured for the
// interface pair: the eager form cost +2 empty arrays per artifact, a linear delta scaling with the file
// count).
//
// ⚠ **`typeNameDecls` IS HERE FOR A STRONGER REASON THAN "OFTEN EMPTY" — TWO OF THE THREE `Parser`
// CONSTRUCTION SITES CAN NEVER FILL IT.** Only `recordTypeName`, reached from `dispatchTopLevel`, ever
// pushes one, and `dispatchTopLevel` runs on the REAL parse alone: the tolerant declaration sweep
// (`foldDeclaredSignaturesInto`, one `Parser` per file) walks tokens on its own and `walkConstInitializer`
// (one `Parser` per top-level constant) evaluates an expression. Eagerly creating the array in
// `FileParseArtifact.create` therefore billed one allocation to EVERY sweep and EVERY constant for a
// structure with no writer — measured at +1 per file and +1 per top-level constant in `phase:signatures`
// (rung 0: 30 files + 64 constants = +96; rung 5: 185 + 2,048 = +2,235), which was 38% of the whole
// type-name rung's memory cost, spent on nothing.
let sharedEmptyInterfaces = IrInterfaceArray.create()
let sharedEmptyConformances = ConformanceDeclArray.create()
let sharedEmptyTypeNameDecls = TypeNameDeclArray.create()
let sharedEmptyFunctionTypeDoors = PendingFunctionTypeDoorArray.create()
// Overloading a name is rare, so the overwhelming file contributes NO overload set. It is shared for
// `typeNameDecls`' stronger reason too: only the real parse can fill it, and the tolerant declaration
// sweep builds an artifact per file that would otherwise pay for an empty map each.
let sharedEmptyOverloadSets = OverloadSetMap.create()

// One `funcReturnTypes` registry contribution: a function's name and its
// declared return type, recorded by the parser. Ordered in an array so the
// merge order is the declaration order.
export type FuncReturnTypeEntry
	export var name as ByteArray
	export var returnType as MaxonReturnType

	export static function create(name ByteArray, returnType MaxonReturnType) returns FuncReturnTypeEntry
		return Self{name: name, returnType: returnType}
	end 'create'
end 'FuncReturnTypeEntry'

export typealias FuncReturnTypeEntryArray = Array with FuncReturnTypeEntry

// One `funcSignatures` registry contribution: a function's name paired with its
// parameter signature (names + types). Recorded by the parser alongside the return
// type. Ordered in an array (not a map) so the merge order is the declaration order
// — exactly the discipline `FuncReturnTypeEntry` follows. Carries the NAME's source
// position so `commitFuncSignatures` can anchor a duplicate-definition diagnostic
// (E3006) on the offending declaration.
export type FuncSignatureEntry
	export var name as ByteArray
	export var signature as FuncSignature
	export var nameLine as LineNumber
	export var nameColumn as ColumnNumber
	export var sourceFilePath as FilePath

	export static function create(name ByteArray, signature FuncSignature, nameLine LineNumber, nameColumn ColumnNumber, sourceFilePath FilePath) returns FuncSignatureEntry
		return Self{name: name, signature: signature, nameLine: nameLine, nameColumn: nameColumn, sourceFilePath: sourceFilePath}
	end 'create'
end 'FuncSignatureEntry'

export typealias FuncSignatureEntryArray = Array with FuncSignatureEntry

// One function's range-check contribution (P1.9): its name paired with the sites the parser
// recorded (see FunctionRangeChecks). Keyed by name, folded into `project.rangeChecks` by
// `commitRangeChecks` — the same NEVER-touch-Project discipline the other `*Entry` families
// follow. The alias/site NAMES are plain ByteArrays and the value ids are function-local, so —
// like a `FunctionTypeAlias` — this rides the merge with NO interner remap.
export type FunctionRangeCheckEntry
	export var name as ByteArray
	export var checks as FunctionRangeChecks

	export static function create(name ByteArray, checks FunctionRangeChecks) returns FunctionRangeCheckEntry
		return Self{name: name, checks: checks}
	end 'create'
end 'FunctionRangeCheckEntry'

export typealias FunctionRangeCheckEntryArray = Array with FunctionRangeCheckEntry

export type FileParseArtifact
	// The file this artifact was parsed from (its identity + merge order anchor).
	export var filePath as FilePath
	// This file's Maxon IR fragment. `IrModule.merge` offset-relocates it into
	// the whole-program module at merge time.
	export var module as MaxonModule
	// Source spans for `module.ops`, parallel by op index. NOT a field on the ops
	// themselves — see SourceRangeTable. `mergeArtifact` folds this into
	// `project.opRanges` in lockstep with the module merge.
	export var opRanges as SourceRangeTable
	// (funcIndex, ValueId) -> Maxon OpIndex for every value an op DEFINES in this file
	// (see ValueOrigin). Recorded inside the emit choke points below in the same
	// op/value lockstep `opRanges` uses, and folded into `project.valueOrigins` by
	// `mergeArtifact` with the merge's function + op offsets. What lets the backend's
	// E5001 map a Target ValueId back to its source span.
	export var valueOrigins as ValueOriginTable
	// This file's `funcReturnTypes` registry contributions, in declaration order.
	export var funcReturnTypes as FuncReturnTypeEntryArray
	// This file's `funcSignatures` registry contributions, in declaration order.
	export var funcSignatures as FuncSignatureEntryArray
	// ⭐ This file's OVERLOAD SETS (D7) — each overloaded bare name ⇒ its members' registration names, in
	// declaration order. Folded into `project.overloadSets` by `commitOverloadSets`.
	//
	// A MAP where the other contributions are ordered arrays, and for the reason those are arrays: what has
	// to be deterministic is the ORDER OF THE MEMBERS (the E3007 candidate list prints them, and the
	// resolver's tie-breaks read them), and that order lives inside each value. The KEY order decides
	// nothing — the commit is one independent upsert per name. Empty for every file that overloads nothing,
	// so the shared empty map keeps a non-overloading parse allocation-identical.
	export var overloadSets as OverloadSetMap
	// This file's recorded function-value merges awaiting whole-program signature agreement (P1.5 #81).
	// Appended to `project.pendingFnMergeChecks` by `commitPendingFnMergeChecks`; the check itself is
	// drained after merge, before resolution (see PendingFnMergeCheck).
	export var pendingFnMergeChecks as PendingFnMergeCheckArray
	// This file's recorded function-type doors awaiting whole-program shape agreement. Appended to
	// `project.pendingFunctionTypeDoors` by `commitPendingFunctionTypeDoors`; the check itself is drained
	// after RESOLUTION (see PendingFunctionTypeDoor).
	export var pendingFunctionTypeDoors as PendingFunctionTypeDoorArray
	// This file's range-check contributions (P1.9), one per function that has a cast into a
	// ranged alias or a ranged `return`. Folded into `project.rangeChecks` by `commitRangeChecks`.
	export var rangeChecks as FunctionRangeCheckEntryArray
	// This file's ranged-typealias declarations, in declaration order. Each carries its declaring file
	// and its name token's position: the file makes resolution file-scoped and the position anchors
	// the E3105 a cross-file underlying conflict earns (see RangedTypeAlias).
	export var typeAliases as RangedTypeAliasArray
	// This file's declared FUNCTION typealiases (P1.5-A1), in declaration order. The twin of
	// `typeAliases`, and remap-free: a function alias's whole declared signature is stored interner-free
	// (a tag + a name ByteArray per parameter and for the return), so `mergeArtifact` folds it by NAME
	// with no id rewrite.
	export var functionTypeAliases as FunctionTypeAliasArray
	// This file's declared struct types (`type Point`), in declaration order.
	export var structTypes as StructLayoutArray
	// This file's declared enum/union types, in declaration order. The twin of `structTypes`, but
	// UNLIKE it carries no type-name ids — a case is a plain NAME and a tag is a plain INT, so
	// `mergeArtifact` needs no remap for these (contrast `remapArtifact`, which rewrites struct
	// field types).
	export var enumTypes as EnumLayoutArray
	// This file's declared `interface` types (P1.7a slice 1), in declaration order. Remap-free like
	// `enumTypes`: an interface method's types are stored as rendered source STRINGS (see IrInterface),
	// not interner ids, so `mergeArtifact` folds it by name with no id rewrite.
	export var interfaces as IrInterfaceArray
	// ⭐ **EVERY DECLARATION THAT MINTED A TYPE NAME, IN SOURCE ORDER** — one entry per `type` /
	// `enum` / `union` / `interface` / `typealias`, carrying the kind and the name token's position
	// (see TypeNameDecl). It is what `commitTypeNameDecls` folds through `TypeNameRegistry` to decide
	// whether a name is declared twice.
	//
	// ⚠ It is a SEPARATE array and not a position bolted onto the five arrays above, because the fact
	// it holds is one none of them can hold: they are five arrays, so which of a file's `type Box` and
	// `typealias Box` came SECOND is nowhere in them, and a collision must blame the later one.
	export var typeNameDecls as TypeNameDeclArray
	// This file's `type X implements …` conformance declarations (P1.7a slice 1). Each carries the
	// type-name token position so the whole-program `checkConformance` can anchor an E3015/E3016 on it.
	// Remap-free (all names are plain ByteArrays). Folded into `project.conformances` by `mergeArtifact`.
	export var conformances as ConformanceDeclArray
	// This file's LOCAL type-name interner. Its ids are file-local; `mergeArtifact`
	// folds them into the project interner and remaps this artifact's ids.
	export var typeNames as TypeNameInterner
	// ⭐ **THE LOCAL INDEX OF THE FUNCTION CURRENTLY BEING PARSED** — the key `recordValueOrigin` /
	// `recordParamOrigin` file each value's origin under. It used to be read straight off
	// `module.funcCount()`, on the assumption that the function being parsed is always the NEXT one to be
	// pushed (funcCount() == its eventual index). That held while functions were parsed strictly one at a
	// time — until closure literals (P1.5-A2a), whose lifted top-level function is parsed and pushed in the
	// MIDDLE of its enclosing function's body. With two functions in flight, `funcCount()` no longer names
	// either one's final index, and the two would collide on it (the enclosing function's early values and
	// the closure's values both keyed to the same index — a corrupted origin table, an E5001 pointing at
	// the wrong source). `parseFunction` now pushes each function up front and stamps this field with the
	// index it landed at, and `parseClosureExpression` saves/sets/restores it around the lifted body — so
	// every value is filed under the index its function actually occupies. Zero for the tolerant
	// declaration sweep, which parses no bodies and records no origins.
	export var currentFuncIndex as FuncIndex
	// ⭐ DIAGNOSTICS THE PARSER RAISES WITHOUT UNWINDING (P1.6-A). The parser reports a malformed
	// construct by THROWING a `ParseError` (which aborts the file's parse), but a WHOLE-PROGRAM
	// SEMANTIC error a pure per-file parser detects — a generic instantiation whose base is not
	// generic, whose arity is wrong, or whose argument is managed — is not a reason to abort the
	// parse: it is a diagnostic that gates the build, exactly like `SemanticCheck`'s do. The parser
	// records it here rather than in `project.diagnostics` (which it must not touch — the pure-parser
	// invariant), and `mergeArtifact` folds this list into `project.diagnostics`, the single writer.
	// The tolerant declaration SWEEP uses a DIFFERENT artifact that is never merged, so a spurious
	// diagnostic it records against the still-building signature index is discarded for free.
	export var diagnostics as DiagnosticArray
	// ⭐ THE TWO DEFERRED NAME DIAGNOSTICS (P1.9) — an unused typealias, and an `as` target naming an
	// alias this file cannot see. They are kept OUT of `diagnostics` above and reported later, in a
	// fixed order, by `TypeResolution.reportDeferredNameDiagnostics`; `DeferredNameDiagnostic`'s header
	// carries the whole argument for why per-file reporting cannot give the order the corpus pins.
	//
	// Two lists rather than one with a kind tag, because the ORDER BETWEEN THEM is the entire reason
	// they are deferred: every unused-alias diagnostic in the program precedes every hidden-name one,
	// and a single list would have to re-derive that split at the drain.
	export var unusedTypeAliases as DeferredNameDiagnosticArray
	export var hiddenTypeNames as DeferredNameDiagnosticArray

	export static function create(filePath FilePath) returns FileParseArtifact
		return Self{
			filePath: filePath,
			module: MaxonModule.create(),
			opRanges: SourceRangeTable.create(),
			valueOrigins: ValueOriginTable.create(),
			funcReturnTypes: FuncReturnTypeEntryArray.create(),
			funcSignatures: FuncSignatureEntryArray.create(),
			overloadSets: sharedEmptyOverloadSets,
			pendingFnMergeChecks: PendingFnMergeCheckArray.create(),
			pendingFunctionTypeDoors: sharedEmptyFunctionTypeDoors,
			rangeChecks: FunctionRangeCheckEntryArray.create(),
			typeAliases: RangedTypeAliasArray.create(),
			functionTypeAliases: FunctionTypeAliasArray.create(),
			structTypes: StructLayoutArray.create(),
			enumTypes: EnumLayoutArray.create(),
			interfaces: sharedEmptyInterfaces,
			typeNameDecls: sharedEmptyTypeNameDecls,
			conformances: sharedEmptyConformances,
			typeNames: TypeNameInterner.create(),
			currentFuncIndex: 0,
			diagnostics: DiagnosticArray.create(),
			unusedTypeAliases: sharedEmptyDeferredNameDiagnostics,
			hiddenTypeNames: sharedEmptyDeferredNameDiagnostics
		}
	end 'create'

	// Record an alias this file declared and never named, and an `as` target naming an alias this file
	// cannot see. Both go through `appendDeferredNameDiagnostic`, the one copy-on-write writer for every
	// list that starts as the shared empty — so neither carries its own copy of the identity test.
	export function recordUnusedTypeAlias(entry DeferredNameDiagnostic)
		self.unusedTypeAliases = appendDeferredNameDiagnostic(self.unusedTypeAliases, entry: entry)
	end 'recordUnusedTypeAlias'

	export function recordHiddenTypeName(entry DeferredNameDiagnostic)
		self.hiddenTypeNames = appendDeferredNameDiagnostic(self.hiddenTypeNames, entry: entry)
	end 'recordHiddenTypeName'

	// THE emit choke point for a Maxon body op — the only way the parser creates
	// one. Appending the op and recording its span happen together here, so
	// `module.ops` and `opRanges` cannot drift apart: there is no path that adds a
	// Maxon op without a span. (Calling `module.appendOp` directly would be that
	// path, which is why nothing in the Maxon tier does.)
	//
	// `appendOp` assigns the op the index `opCount()` holds right now, so capture it
	// BEFORE the append. `record` then asserts that index equals the span table's
	// own count — which is exactly the parallelism invariant, checked on every
	// single op: if anything ever appended a Maxon op behind this function's back,
	// the two counts diverge and the NEXT emit panics rather than silently shifting
	// every later span by one.
	export function emitOp(block IrBlock, op MaxonOp, range SourceRange)
		let opIndex = self.module.opCount()
		self.module.appendOp(block, op: op)
		self.opRanges.record(opIndex, range: range)
		self.recordValueOrigin(op, opIndex: opIndex)
	end 'emitOp'

	// THE emit choke point for a Maxon block terminator. Same op/span lockstep as
	// `emitOp`; separate only because a terminator is stored on the block rather
	// than appended to its op list.
	export function emitTerminator(block IrBlock, op MaxonOp, range SourceRange)
		let opIndex = self.module.opCount()
		self.module.setTerminator(block, op: op)
		self.opRanges.record(opIndex, range: range)
		self.recordValueOrigin(op, opIndex: opIndex)
	end 'emitTerminator'

	// Record the origin of the value `op` defines (if any) as this file's contribution
	// to the whole-program `ValueOrigin` table. The current function's LOCAL index is
	// `self.currentFuncIndex`, stamped by `parseFunction` (and re-stamped by
	// `parseClosureExpression` around a lifted closure body): the function is pushed to
	// `module.functions` UP FRONT and this field records the index it landed at, so a closure
	// parsed in the middle of its enclosing function's body does not make `funcCount()` name
	// the wrong function. A `none`-result op (`ret`/`retVoid`/`condBranch`/`branch`) defines no
	// value and records nothing.
	function recordValueOrigin(op MaxonOp, opIndex OpIndex)
		match maxonOpResultValue(op) 'result'
			none then break 'result'
			value(id) then self.valueOrigins.record(self.currentFuncIndex, valueId: id, opIndex: opIndex)
		end 'result'
	end 'recordValueOrigin'

	// Record a PARAMETER's declaration span as this file's contribution to the whole-program
	// origin table. Called by the parser as it binds each parameter (a param is minted by no
	// op, so it has no `recordValueOrigin` entry — it needs this separate site). Keyed by the
	// current function's LOCAL index — `self.currentFuncIndex` — for `recordValueOrigin`'s reason.
	export function recordParamOrigin(valueId ValueId, range SourceRange)
		self.valueOrigins.recordParam(self.currentFuncIndex, valueId: valueId, range: range)
	end 'recordParamOrigin'

	// Stamp the local index of the function whose body the parser is about to emit into — the value
	// `recordValueOrigin`/`recordParamOrigin` file every origin under. `parseFunction` calls this with the
	// index the function was just pushed at; `parseClosureExpression` saves the current value, sets the
	// lifted closure's index for the body, and restores it afterwards.
	export function setCurrentFuncIndex(index FuncIndex)
		self.currentFuncIndex = index
	end 'setCurrentFuncIndex'

	// Record a function's return type as this file's contribution to the
	// project-wide `funcReturnTypes` registry. Called by the parser after it
	// builds a function — NEVER touching `Project`.
	export function recordFuncReturnType(name ByteArray, returnType MaxonReturnType)
		self.funcReturnTypes.push(FuncReturnTypeEntry.create(name, returnType: returnType))
	end 'recordFuncReturnType'

	// Record a function's parameter signature as this file's contribution to the
	// project-wide `funcSignatures` registry. Called by the parser after it builds
	// a function — NEVER touching `Project` (mirrors `recordFuncReturnType`). The
	// name's source position travels with the entry so a merge-time duplicate can be
	// positioned on the offending declaration.
	export function recordFuncSignature(name ByteArray, signature FuncSignature, nameLine LineNumber, nameColumn ColumnNumber, sourceFilePath FilePath)
		self.funcSignatures.push(FuncSignatureEntry.create(name, signature: signature, nameLine: nameLine, nameColumn: nameColumn, sourceFilePath: sourceFilePath))
	end 'recordFuncSignature'

	// Record the whole current member list of one overloaded bare name (D7). REPLACES rather than appends:
	// the parser hands back the complete list every time a member joins, which is what keeps this table a
	// projection of the parser's own records rather than a second accumulation to keep in step.
	export function recordOverloadSet(base ByteArray, members ByteArrayArray)
		// COPY-ON-WRITE off the shared empty table before this file's first overload — see
		// `sharedEmptyOverloadSets`.
		if self.overloadSets is sharedEmptyOverloadSets 'firstOverloadInThisFile'
			self.overloadSets = OverloadSetMap.create()
		end 'firstOverloadInThisFile'

		self.overloadSets.upsert(base, value: members)
	end 'recordOverloadSet'

	// Record a function's range-check sites as this file's contribution to `project.rangeChecks`
	// (P1.9). Called by the parser at function completion, and ONLY when the function actually has
	// a cast into a ranged alias or a ranged `return` — a function with neither files nothing, so
	// the registry stays proportional to the range checks a program contains, not its function count.
	export function recordFunctionRangeChecks(name ByteArray, checks FunctionRangeChecks)
		self.rangeChecks.push(FunctionRangeCheckEntry.create(name, checks: checks))
	end 'recordFunctionRangeChecks'

	// Record a ranged-typealias declaration as this file's contribution to the
	// project-wide `typeAliases` registry — the same NEVER-touch-Project discipline
	// `recordFuncReturnType` / `recordFuncSignature` follow.
	// The typealias arrays (`typeAliases` / `functionTypeAliases`) are PUSHED INTO DIRECTLY by
	// `Parser.readTypeAliasDeclaration`, which is handed the target array — the real parse passes the
	// artifact's, the declaration sweep passes its own — so one reader files a ranged alias in one array
	// and a function alias in the other with no boxed-union hop. `mergeArtifact` folds both into `Project`.

	// Record a declared struct type as this file's contribution to the project-wide `structTypes`
	// registry — the same NEVER-touch-Project discipline every `record*` above follows.
	export function recordStructType(layout StructLayout)
		self.structTypes.push(layout)
	end 'recordStructType'

	// Record a declared enum/union type as this file's contribution to the project-wide `enumTypes`
	// registry — the same NEVER-touch-Project discipline every `record*` above follows.
	export function recordEnumType(layout EnumLayout)
		self.enumTypes.push(layout)
	end 'recordEnumType'

	// Record a declared `interface` as this file's contribution to `project.interfaces` (P1.7a slice 1)
	// — the same NEVER-touch-Project discipline every `record*` above follows. Copy-on-write off the
	// shared empty on the first push (this is the array's only writer, so `count() == 0` means shared).
	export function recordInterface(iface IrInterface)
		if self.interfaces.count() == 0 'firstInterface'
			self.interfaces = IrInterfaceArray.create()
		end 'firstInterface'
		self.interfaces.push(iface)
	end 'recordInterface'

	// Record that a top-level declaration minted a TYPE NAME — the same NEVER-touch-Project discipline
	// every `record*` above follows. Called from `Parser.dispatchTopLevel`, the ONE place that sees all
	// five declaring keywords, so this array's order IS the file's source order across kinds.
	// Copy-on-write off the shared empty on the first push, exactly as `recordInterface` — and here it
	// buys more, because the two `Parser` sites that are not the real parse never reach this function at
	// all (see `sharedEmptyTypeNameDecls`).
	export function recordTypeNameDecl(decl TypeNameDecl)
		if self.typeNameDecls.count() == 0 'firstTypeNameDecl'
			self.typeNameDecls = TypeNameDeclArray.create()
		end 'firstTypeNameDecl'
		self.typeNameDecls.push(decl)
	end 'recordTypeNameDecl'

	// Record a `type X implements …` conformance as this file's contribution to `project.conformances`
	// (P1.7a slice 1). The type-name position travels with it so `checkConformance` anchors on the name.
	// Copy-on-write off the shared empty on the first push, exactly as `recordInterface`.
	export function recordConformance(conformance ConformanceDecl)
		if self.conformances.count() == 0 'firstConformance'
			self.conformances = ConformanceDeclArray.create()
		end 'firstConformance'
		self.conformances.push(conformance)
	end 'recordConformance'

	// Record a function VALUE meeting a function-typed PLACE (see PendingFunctionTypeDoor). Copy-on-write
	// off the shared empty on the first push, for the reason `recordTypeNameDecl` is: only the REAL parse
	// can reach a door, so eagerly creating the array would bill one allocation to every declaration SWEEP
	// and every top-level CONSTANT (`walkConstInitializer` builds a `Parser`, and so an artifact, per one)
	// for a structure they can never fill.
	export function recordFunctionTypeDoor(door PendingFunctionTypeDoor)
		if self.pendingFunctionTypeDoors.count() == 0 'firstDoor'
			self.pendingFunctionTypeDoors = PendingFunctionTypeDoorArray.create()
		end 'firstDoor'
		self.pendingFunctionTypeDoors.push(door)
	end 'recordFunctionTypeDoor'
end 'FileParseArtifact'

// Fold `artifact` into the whole-program build in source-path order:
//   1. reconcile the artifact's local type-name ids into the project interner,
//   2. offset-merge the artifact's MaxonModule fragment into `target`,
//   3. fold its op source spans onto `project.opRanges`, in lockstep with (2),
//   4. commit the artifact's registry contributions into `Project`.
// `target` is the accumulator module `queryAllModule` builds (and caches); the
// registries land on `Project`. This is the ONLY writer of `project.typeNames`,
// `project.funcReturnTypes`, and `project.opRanges` — the shv2 replacement for
// v1's mid-parse inserts + ParseDelta rollback, needing no rollback because
// nothing was ever written to `Project` speculatively.
export function mergeArtifact(project Project, target MaxonModule, artifact FileParseArtifact)
	let remap = project.typeNames.foldInto(artifact.typeNames)
	if not remap.isIdentity 'remapNeeded'
		// A prior file already interned some of these names under different ids
		// (the multi-file case, first exercised at M2). Rewrite this artifact's
		// module signatures + registry entries through the remap before merging
		// so every `named(id)` indexes the project interner. Identity (always
		// true for the first/only file) skips this entirely.
		remapArtifact(artifact, remap: remap)
	end 'remapNeeded'

	// `IrModule.merge` relocates the artifact's ops to `target.ops.count()` and up,
	// so the spans must land at exactly that offset in `project.opRanges` to stay
	// parallel. Both accumulate by appending in the same source-path order, so the
	// offsets agree by construction — assert it rather than trust it, because a
	// silent drift here misattributes every later op's diagnostics by a constant.
	let opOffset = target.ops.count()
	if project.opRanges.count() != opOffset 'spansOutOfStep'
		panic("mergeArtifact: project.opRanges holds {project.opRanges.count()} spans but the merged module holds {opOffset} ops — the span table drifted out of lockstep with the op array")
	end 'spansOutOfStep'

	// The function offset for the ValueOrigin fold: `IrModule.merge` appends the
	// artifact's functions after the existing ones, so its k-th function lands at
	// `funcOffset + k`. Captured BEFORE the merge, mirroring `opOffset`.
	let funcOffset = target.funcCount()

	target.merge(artifact.module)
	project.opRanges.appendFrom(artifact.opRanges)
	project.valueOrigins.appendFrom(artifact.valueOrigins, funcOffset: funcOffset, opOffset: opOffset)
	commitFuncReturnTypes(project, artifact: artifact)
	commitFuncSignatures(project, artifact: artifact)
	commitOverloadSets(project, artifact: artifact)
	commitPendingFnMergeChecks(project, artifact: artifact)
	commitPendingFunctionTypeDoors(project, artifact: artifact)
	commitRangeChecks(project, artifact: artifact)
	// BEFORE the five per-kind commits below, because it is the one that can REFUSE a declaration: a
	// name reported here is one whose meaning the registries beneath cannot agree on, and reporting it
	// first keeps a program's diagnostics in the order a reader meets the declarations.
	commitTypeNameDecls(project, artifact: artifact)
	commitTypeAliases(project, artifact: artifact)
	commitFunctionTypeAliases(project, artifact: artifact)
	commitStructTypes(project, artifact: artifact)
	commitEnumTypes(project, artifact: artifact)
	commitInterfaces(project, artifact: artifact)
	commitConformances(project, artifact: artifact)
	commitDiagnostics(project, artifact: artifact)
	commitDeferredNameDiagnostics(project, artifact: artifact)
end 'mergeArtifact'

// Fold this file's two DEFERRED name diagnostics into the project's own lists (P1.9). They are appended
// rather than reported, because their whole point is to be reported LATER and in a fixed order — see
// `DeferredNameDiagnostic` for why, and `TypeResolution.reportDeferredNameDiagnostics` for the drain.
function commitDeferredNameDiagnostics(project Project, artifact FileParseArtifact)
	for entry in artifact.unusedTypeAliases 'eachUnused'
		project.unusedTypeAliasDiagnostics.push(entry)
	end 'eachUnused'
	for entry in artifact.hiddenTypeNames 'eachHidden'
		project.hiddenTypeNameDiagnostics.push(entry)
	end 'eachHidden'
end 'commitDeferredNameDiagnostics'

// Fold this file's parser-raised diagnostics into `project.diagnostics` (P1.6-A) — the last
// contribution, and the one that carries no ids to remap (a `Diagnostic` is a finished
// (code, message, position) record). `reportDiagnostic` is the single project sink, so a
// parser-recorded diagnostic and a `SemanticCheck`-recorded one are indistinguishable downstream.
function commitDiagnostics(project Project, artifact FileParseArtifact)
	for diagnostic in artifact.diagnostics 'each'
		reportDiagnostic(project, diagnostic: diagnostic)
	end 'each'
end 'commitDiagnostics'

// ⭐ **COMMIT EVERY TYPE-NAME DECLARATION, AND REPORT A NAME DECLARED TWICE.** The whole-program
// duplicate check for the TYPE namespace, exactly as `commitFuncSignatures` is for functions and for
// the same reason it lives at the merge rather than in the parser: a file-local check cannot see a
// second file, and the parser must stay pure. The rule itself, and the one carve-out it has, are
// stated once on `TypeNameRegistry`; this function only chooses the CODE and writes the text.
//
// ⚠ **WHICH CODE IS A PROPERTY OF THE PAIR, NOT OF THIS SITE.** E3061 says "two typealiases in scope
// declare the same name", so it is right exactly when BOTH declarations are typealiases — including
// two different FORMS across two files, which is the pair the file-local carve-out does not cover.
// Everything else is E3006, the code a name declared twice already carries for a function and for a
// top-level `let`/`var` (`specs/static-variables.md`, where the kind of keyword is likewise
// irrelevant).
//
// Both arms blame the DECLARATION THE AUTHOR JUST WROTE — its own file, its own name token — and name
// the incumbent's KEYWORD, which is the half that is invisible from the line being reported. The
// incumbent's PATH is deliberately not in the text, for the reason E3105 states: a second absolute
// path inside a message is machine-dependent and unmatchable in a spec golden.
function commitTypeNameDecls(project Project, artifact FileParseArtifact)
	for decl in artifact.typeNameDecls 'each'
		match project.typeNameDecls.record(decl) 'collision'
			accepted then break 'collision'
			collides(winner) then reportTypeNameCollision(project, decl: decl, winner: winner)
		end 'collision'
	end 'each'
end 'commitTypeNameDecls'

// The two texts a collision can have, kept together because the CHOICE between them is the thing
// worth reading in one place.
function reportTypeNameCollision(project Project, decl TypeNameDecl, winner TypeNameDecl)
	// ⭐ **A NAME REPORTED HERE IS NOT ALSO REPORTED AS UNUSED (P1.9).** Both declarations of a
	// `typealias Score` declared twice in one file are genuinely unused, so the drain would add two
	// E3062s on top of the one E3061 that actually explains the file — three diagnostics for one
	// mistake, and the two extra pointing at the wrong thing. The reference suppresses it structurally
	// (its duplicate check THROWS, so its end-of-parse unused check never runs) and v1 by an explicit
	// set; shv2 needs the set, because its unused check runs at the parse and this one at the merge.
	//
	// ⚠ **KEYED PER DECLARING FILE, and that is not caution — a bare name would suppress the wrong
	// file's diagnostic.** Two files may each legally declare `typealias Byte` (`TypeNameRegistry`'s
	// carve-out; seven `stdlib/` files do), so one file declaring it twice would poison the name
	// project-wide and silently swallow another file's genuinely-unused `Byte`.
	project.collidedTypeNames.insert(fileScopedDeclKey(decl.name, declFilePath: decl.declFilePath))

	if isTypeAliasDecl(decl.kind) and isTypeAliasDecl(winner.kind) 'bothAreTypeAliases'
		reportPositioned(project, code: ErrorCode.semanticDuplicateTypeAlias, message: "Duplicate typealias '{String.from(decl.name)}'", line: decl.nameLine, column: decl.nameColumn, filePath: decl.declFilePath)
		return
	end 'bothAreTypeAliases'

	reportPositioned(project, code: ErrorCode.duplicateDefinition, message: "duplicate definition of '{String.from(decl.name)}' — already declared as `{typeDeclKeyword(winner.kind)} {String.from(winner.name)}`", line: decl.nameLine, column: decl.nameColumn, filePath: decl.declFilePath)
end 'reportTypeNameCollision'

// --- The COMPILED half of the same namespace: one emitted type name, one INSTANTIATION ---

// The compiled type names claimed so far by the instantiation walk, each holding the instance that
// claimed it FIRST — the incumbent a later instantiation of the same compiled name is reported
// against. Built only by `checkTypeSymbolNamespace`, and only for a program that instantiates a generic.
typealias CompiledTypeNameClaimMap = Map with (ByteArray, GenericInstanceId)

// Where a colliding instantiation was WRITTEN. A top-level `typealias X = Base with Args` records one
// (`ProgramSignatures.instantiationSites`); a NESTED instantiation and the compiler-synthesized array
// instances are interned without one.
union InstantiationAnchor
	anchored(site GenericInstantiationSite)
	unanchored
end 'InstantiationAnchor'

// ⭐⭐ **THE COMPILED TYPE-NAME NAMESPACE — one emitted name, one instantiation.** A generic
// instantiation has no source name, so the compiler builds one (`mangleGenericInstance` joins the base
// name to each argument's — `Box with String` ⇒ `Box_String`), and EVERY per-type symbol the backend
// emits is derived from that string — `__destruct_<name>`, `__layout_<name>`. Two instantiations that
// build the SAME string mint one symbol twice and the later install wins: measured, a **SIGSEGV** from a
// build that exited 0 with no diagnostic, because `_` is a legal name character and the join is
// therefore NOT injective — `Pair with (Box_Int, Str)` and `Pair with (Box, Int_Str)` both compile to
// `Pair_Box_Int_Str`.
//
// ⚠ **THE OTHER HALF OF THAT COLLISION — a DECLARED `type Box_String` claiming the same string — IS NOT
// CHECKED HERE, BECAUSE IT CANNOT HAPPEN.** `mangleGenericInstance` mints a contested name behind the
// reserved `__` prefix instead (`reservedIfDeclared`), which no declaration may take (E2051), so the
// declared and compiled halves are disjoint by construction. Reporting it was the P1.7 defect: a program
// that merely writes an `[Foo…]` array literal — which interns `Array with Foo` — had a legal
// `type Array_Foo` rejected with E3006, naming an instantiation that appears nowhere in its source.
// Neither reference compiler diagnoses a declaration contest; the bootstrap has no contest to diagnose
// (its instances are `__Array_Foo`), and v1 tolerates the duplicate label silently, first-write-wins.
// This pair check is the half BOTH references miss, and it is the half a prefix cannot cure — there is
// no declaration to move out of the way.
//
// ⚠ **DECIDED HERE, IN THE FRONT END, AND NOT WHERE THE SYMBOL IS MINTED.** The mangling is consumed by
// the backend, but the NAMESPACE is a source-level fact and a collision must land on the `typealias` the
// author wrote. A diagnostic raised at symbol-emission time has no user span to land on and would blame
// a file the author never opened — the defect E3104, E3061/E3105 and E3006 have each had fixed once
// already.
//
// Called once per compile from `compileToCodeResult`, after `queryProgramSignatures` has interned every
// instantiation — the same placement, and for the same reason, as `checkWhereConstraints`.
export function checkTypeSymbolNamespace(project Project, signatures ProgramSignatures)
	let instantiationCount = signatures.genericInstanceCount()
	// A program that instantiates no generic claims no compiled name and can contest nothing. That is
	// the whole generics-free corpus, and it leaves here having allocated nothing whatever.
	if instantiationCount == 0 'noInstantiations'
		return
	end 'noInstantiations'

	// A prior diagnostic leaves the instantiation registry INCOMPLETE — a file whose parse failed merged
	// nothing it declared — so refuse to check a malformed program, exactly as `checkConformance` and
	// `checkWhereConstraints` do. The real diagnostic already fails the build.
	if projectHasErrors(project) 'malformedProject'
		return
	end 'malformedProject'

	// Walked in gid order, which is intern order and therefore source-path order over the sweep — so
	// which instantiation of a colliding pair is the NEWCOMER is a property of the program rather than
	// of a map's iteration.
	var claimed = CompiledTypeNameClaimMap.create()
	for gid in 0 upto instantiationCount 'eachInstantiation'
		let compiled = signatures.mangleGenericInstance(gid)
		// A rejected newcomer is deliberately NOT recorded: the incumbent stays the one every later
		// instantiation is measured against, which is `TypeNameRegistry`'s own rule (a rejected
		// declaration never displaces) applied to the compiled half.
		if let incumbent = try claimed.get(compiled) 'earlierInstantiation'
			reportInstantiationPairCollision(project, signatures: signatures, compiled: compiled, incumbent: incumbent, newcomer: gid)
			continue
		end 'earlierInstantiation'

		claimed.upsert(compiled, value: gid)
	end 'eachInstantiation'
end 'checkTypeSymbolNamespace'

// ⭐ **A GENERIC ALIAS WHOSE TYPE ARGUMENTS LEAD BACK TO IT IS REFUSED (P1.7, E3091).** `typealias A = Box
// with A`, and the mutual `A = Box with B` / `B = Box with A`, describe INFINITE types: no finite layout and
// no finite compiled name. Both compiled with exit 0 and NO diagnostic, then SEGFAULTED — the same shape as
// this rung's original defect, one level up.
//
// Blamed at the DECLARATION rather than at a use, because the declaration is the ill-formed thing and a
// cycle is ill-formed whether or not anyone instantiates it. Run BEFORE the pipeline (so before
// `semanticCheck`), which is also what guarantees no later reader has to survive a cycle.
export function checkGenericAliasCycles(project Project, signatures ProgramSignatures)
	// A prior diagnostic leaves the registries INCOMPLETE, so a cycle "found" here could be an artifact of a
	// half-folded program — the same refusal `checkTypeSymbolNamespace` and `checkWhereConstraints` make.
	if projectHasErrors(project) 'malformedProject'
		return
	end 'malformedProject'

	match signatures.firstCyclicAliasDecl() 'cycle'
		none then return
		at(index) then reportGenericAliasCycle(project, entry: signatures.genericAliasDeclAt(index))
	end 'cycle'
end 'checkGenericAliasCycles'

// Report E3091 at the offending `typealias`. A SYNTHESIZED alias carries no anchor (line 0), so it falls back
// to the whole-program form `reportInstantiationPairCollision` uses for the same reason — pointing at line 0
// of a file the user never wrote would be worse than not pointing at all.
function reportGenericAliasCycle(project Project, entry GenericAliasEntry)
	let message = "typealias '{String.from(entry.aliasName)}' forms a type cycle: its type arguments refer back to '{String.from(entry.aliasName)}'"
	if entry.nameLine == 0 'synthesized'
		reportDiagnostic(project, diagnostic: Diagnostic.create(ErrorCode.semanticTypeResolutionCycle, message: message))
		return
	end 'synthesized'
	reportPositioned(project, code: ErrorCode.semanticTypeResolutionCycle, message: message, line: entry.nameLine, column: entry.nameColumn, filePath: entry.filePath)
end 'reportGenericAliasCycle'

// Two instantiations that compile to one name — the shape no declaration takes part in, which the
// join's non-injectivity makes possible on its own.
function reportInstantiationPairCollision(project Project, signatures ProgramSignatures, compiled ByteArray, incumbent GenericInstanceId, newcomer GenericInstanceId)
	let message = "duplicate definition of '{String.from(compiled)}' — the generic instantiations `{renderInstantiation(signatures, gid: incumbent)}` and `{renderInstantiation(signatures, gid: newcomer)}` compile to that same name"
	match instantiationAnchor(signatures, newcomer: newcomer, incumbent: incumbent) 'anchor'
		anchored(site) then reportPositioned(project, code: ErrorCode.duplicateDefinition, message: message, line: site.nameLine, column: site.nameColumn, filePath: site.filePath)
		// No `typealias` names EITHER instantiation, so both are nested (`Box with (Pair with …)`) and
		// neither was interned with an anchor. Whole-program then — the anchorless form E3001 uses —
		// rather than pointing at an enclosing alias whose own instantiation is fine.
		unanchored then reportDiagnostic(project, diagnostic: Diagnostic.create(ErrorCode.duplicateDefinition, message: message))
	end 'anchor'
end 'reportInstantiationPairCollision'

// The site a pair collision is reported at: the NEWCOMER's `typealias` if one names it, else the
// INCUMBENT's, else none. Preferring the newcomer mirrors `reportTypeNameCollision`, which blames the
// declaration the author wrote last.
//
// ⚠ **A LINEAR SCAN OF THE SITE LIST, DELIBERATELY.** It is asked only once a collision has already
// been found — never on a program that compiles — so a gid⇒site index would cost every build to serve
// none. One pass answers both halves: a newcomer hit returns at once, and an incumbent hit is retained
// as the fallback.
function instantiationAnchor(signatures ProgramSignatures, newcomer GenericInstanceId, incumbent GenericInstanceId) returns InstantiationAnchor
	var fallback = InstantiationAnchor.unanchored
	for site in signatures.instantiationSites() 'eachSite'
		if site.gid == newcomer 'namesTheNewcomer'
			return InstantiationAnchor.anchored(site)
		end 'namesTheNewcomer'

		if site.gid == incumbent 'namesTheIncumbent'
			fallback = InstantiationAnchor.anchored(site)
		end 'namesTheIncumbent'
	end 'eachSite'

	return fallback
end 'instantiationAnchor'

// A colliding instantiation spelled back out the way its author wrote it — `Box with String`,
// `Pair with (Box_Int, Str)`. A single argument takes no parentheses and a list does, matching the
// source form (`specs-shv2/generic-types.md`).
//
// The arguments come through `instanceArgTypeName`, so a NESTED instantiation appears in its own
// COMPILED spelling (`Box with Pair_Int_Bool`) rather than as `Box with (Pair with (Int, Bool))`. That
// is the right rendering and not a shortcut: the compiled spelling is what collided, and the source
// form would hide the very join the message is about.
function renderInstantiation(signatures ProgramSignatures, gid GenericInstanceId) returns String
	let argCount = signatures.genericInstanceArgCount(gid)
	var rendered = "{String.from(signatures.genericInstanceBaseName(gid))} with "
	if argCount > 1 'openArgumentList'
		rendered.append("(")
	end 'openArgumentList'

	for position in 0 upto argCount 'eachArgument'
		if position > 0 'afterFirst'
			rendered.append(", ")
		end 'afterFirst'
		rendered.append(String.from(signatures.instanceArgTypeName(gid, position: position)))
	end 'eachArgument'

	if argCount > 1 'closeArgumentList'
		rendered.append(")")
	end 'closeArgumentList'

	return rendered
end 'renderInstantiation'

// Commit the artifact's declared struct types into the project registry — the registry
// `TypeResolution.resolveNamedType` turns a `MaxonType.named` for a declared `type` into a
// `structRef` against.
//
// A plain upsert, and it stays one: a second `type` of the same name is refused by
// `commitTypeNameDecls` above, which runs first and fails the build, so the overwrite is never
// observed. That is the same relationship `commitFuncReturnTypes` has with `commitFuncSignatures`.
function commitStructTypes(project Project, artifact FileParseArtifact)
	for layout in artifact.structTypes 'each'
		project.structTypes.upsert(layout.name, value: layout)
	end 'each'
end 'commitStructTypes'

// Commit the artifact's declared enum/union types into the project registry — the registry
// `TypeResolution.resolveNamedType` reads to resolve a `MaxonType.named` naming a declared
// `enum`/`union` to `integer`. A plain upsert, matching `commitStructTypes` and unobservable on a
// collision for its reason.
function commitEnumTypes(project Project, artifact FileParseArtifact)
	for layout in artifact.enumTypes 'each'
		upsertDeclaredEnum(project.enumTypes, layout: layout)
	end 'each'
end 'commitEnumTypes'

// Commit the artifact's declared `interface`s into the project registry (P1.7a slice 1) — a plain
// upsert keyed by name, matching `commitEnumTypes` and unobservable on a collision for its reason.
function commitInterfaces(project Project, artifact FileParseArtifact)
	for iface in artifact.interfaces 'each'
		project.interfaces.upsert(iface.name, value: iface)
	end 'each'
end 'commitInterfaces'

// Commit the artifact's `implements` conformance declarations into `project.conformances` (P1.7a
// slice 1). A PUSH, not an upsert: each is a distinct declaration site (its own type-name position),
// and `checkConformance` drains them all. `resetMergeTargets` clears the array so a warm rebuild does
// not double it (the same discipline `commitPendingFnMergeChecks` follows).
function commitConformances(project Project, artifact FileParseArtifact)
	for conformance in artifact.conformances 'each'
		project.conformances.push(conformance)
	end 'each'
end 'commitConformances'

// Commit the artifact's range-check contributions into `project.rangeChecks` (P1.9) — a plain
// upsert keyed by function name, which is UNIQUE per program (the whole-program E3006 check runs
// in `commitFuncSignatures`), so no collision handling is needed. Read by `InsertRangeChecks`.
function commitRangeChecks(project Project, artifact FileParseArtifact)
	for entry in artifact.rangeChecks 'each'
		project.rangeChecks.upsert(entry.name, value: entry.checks)
	end 'each'
end 'commitRangeChecks'

// Commit the artifact's ranged-typealias declarations into the project registry, and raise E3105 —
// two FILES declaring one name over two different underlying primitives.
//
// ⭐ **THAT IS NOT "TWO FILES DECLARED THIS NAME", and the distinction is the whole point.** A
// non-exported typealias is FILE-LOCAL, so two FILES may each declare `MyInt` over their own RANGE
// and neither is an error (`specs/duplicate-typealias.md`, and `stdlib/` relies on it — seven files
// privately declare `Byte = int(0 to u8.max)`). What is rejected is the pair no reader downstream
// could pick a winner for: two PRIMITIVES for one name, which the file-less readers resolve through a
// bare door holding one entry (`RangedAliasRegistry.record`).
//
// ⚠ **A DUPLICATE DECLARATION IS NOT THIS FUNCTION'S** — `commitTypeNameDecls` reports it, for every
// declaration kind at once, which is why this one no longer has a same-file arm. This registry sees
// only ranged aliases, so it could never have decided a `type`/`typealias` pair, and two structures
// answering one question for overlapping inputs is how they come to disagree.
//
// ⚠ **WHOLE-PROGRAM, NOT PARSE-TIME.** It runs at the merge, where `commitFuncSignatures` raises
// E3006, and not in the parser — a file-local check cannot see a forward reference or a second file,
// and this project has already paid for that lesson once (the value-merge rung, #81). The parser
// records positions and nothing else.
function commitTypeAliases(project Project, artifact FileParseArtifact)
	for alias in artifact.typeAliases 'each'
		match project.typeAliases.record(alias) 'conflict'
			// Blames the DECLARATION THE USER JUST WROTE — its own name token, in its own file — and
			// never the incumbent, which is the line that was fine.
			//
			// ⚠ The other declaration's PATH is deliberately not in the text. A diagnostic names its file
			// once, in the position the runner rewrites to `<fragment>`; a second path inside the
			// message would be an absolute temp path in every spec golden, machine-dependent and
			// unmatchable. The alias name and the two underlying types are what makes it actionable.
			conflictingUnderlying(prior) then reportPositioned(project, code: ErrorCode.semanticTypeAliasUnderlyingConflict, message: "Typealias '{String.from(prior.name)}' is declared over '{maxonTypeName(alias.underlying, typeNames: project.typeNames)}' here and over '{maxonTypeName(prior.underlying, typeNames: project.typeNames)}' in another file — two files may declare one alias name over different RANGES, but not over different underlying types", line: alias.nameLine, column: alias.nameColumn, filePath: alias.declFilePath)
			accepted then break 'conflict'
		end 'conflict'
	end 'each'
end 'commitTypeAliases'

// Commit the artifact's FUNCTION typealiases into the project registry (P1.5-A1) — the twin of
// `commitTypeAliases`, a plain upsert and remap-free (a function alias carries no interner ids).
function commitFunctionTypeAliases(project Project, artifact FileParseArtifact)
	for alias in artifact.functionTypeAliases 'each'
		project.functionTypeAliases.upsert(alias.name, value: alias)
	end 'each'
end 'commitFunctionTypeAliases'

// Rewrite every file-local `named(id)` that a LATER pass will READ — the module's
// function return types + param types + per-value name column — to its project-global id. The
// `funcSignatures` registry's param types are deliberately NOT remapped here: `resolveTypes`
// (`syncResolvedSignature`) unconditionally OVERWRITES each signature's param types with
// the function's own (already-remapped, then resolved) `maxonParamTypes` before the merge
// output is ever consumed, and no consumer reads a signature's param types regardless
// (`slotCallArgs` uses only the param NAMES + count). Remapping them here would be dead work.
function remapArtifact(artifact FileParseArtifact, remap TypeNameRemap)
	// Index-based so `func`/`entry` are mutable bindings (a `for x in ...` loop
	// var is immutable; field assignment through it is rejected).
	for i in 0 upto artifact.module.functions.count() 'eachFunc'
		var func = try artifact.module.functions.get(i) otherwise panic("remapArtifact: functions.get OOB at {i}")
		func.maxonReturnType = remapMaxonReturnType(func.maxonReturnType, remap: remap)
		var remappedParams = MaxonTypeArray.create()
		for pt in func.maxonParamTypes 'eachParam'
			remappedParams.push(remapMaxonType(pt, remap: remap))
		end 'eachParam'
		func.maxonParamTypes = remappedParams

		// The per-value NAME column moves with the signature: a body value typed `structRef(SomeStruct)`
		// for a struct declared in ANOTHER file carries a file-local id this merge is moving, and
		// SemanticCheck's call-argument identity check (OPEN #54 Slice B) resolves that id against the
		// merged `project.typeNames`. Rebuilt tag-aware — a scalar slot keeps its `UnnamedTypeId` filler
		// (see `remapValueNameId`) — in lockstep with `valueTags`, which is interner-independent and so
		// is never remapped. Only the multi-file (non-identity) path reaches here.
		var remappedNames = TypeNameIdArray.create()
		for k in 0 upto func.valueNameIds.count() 'eachValue'
			let tag = try func.valueTags.get(k) otherwise panic("remapArtifact: valueTags.get OOB at {k} — the two type columns fell out of lockstep")
			let nameId = try func.valueNameIds.get(k) otherwise panic("remapArtifact: valueNameIds.get OOB at {k} — the two type columns fell out of lockstep")
			remappedNames.push(remapValueNameId(tag, nameId: nameId, remap: remap))
		end 'eachValue'
		func.valueNameIds = remappedNames
	end 'eachFunc'

	for j in 0 upto artifact.funcReturnTypes.count() 'eachEntry'
		var entry = try artifact.funcReturnTypes.get(j) otherwise panic("remapArtifact: funcReturnTypes.get OOB at {j}")
		entry.returnType = remapMaxonReturnType(entry.returnType, remap: remap)
	end 'eachEntry'

	// A declared struct's FIELD TYPES are remapped, and the contrast with `funcSignatures` two
	// paragraphs up is the whole reason to say so. That one is skipped because `syncResolvedSignature`
	// OVERWRITES every param type before anything reads it — the stale ids are provably erased. Nothing
	// erases these: they land in `project.structTypes` and stay. `TypeResolution` happens to read only
	// the registry's KEY today (`is this name a declared type?`), so a stale id would be silent — which
	// makes it a TRAP rather than dead data, and the difference between the two is a reader arriving
	// later. The cost is one pass over the types a file declares, on the multi-file path only.
	for layout in artifact.structTypes 'eachStruct'
		remapStructLayoutFieldTypes(layout, remap: remap)
	end 'eachStruct'

	// A declared union/enum's PAYLOAD field types are id-bearing (`walk(dir Direction)`) for the same
	// reason a struct's field types are, so they are reconciled the same way and land in
	// `project.enumTypes` the same way `structTypes` does above. (A payload-free enum's cases carry
	// no ids, so its loop body rewrites nothing.)
	for layout in artifact.enumTypes 'eachEnum'
		remapEnumLayoutPayloadTypes(layout, remap: remap)
	end 'eachEnum'
end 'remapArtifact'

// Commit the artifact's `funcReturnTypes` contributions into the project registry.
// A plain upsert: whole-program duplicate-function detection lives in the parallel
// `commitFuncSignatures` (every function records BOTH a return type and a signature, so
// one detection site covers all functions — see there). A duplicate reported there fails
// the build, so a last-wins overwrite of a return type here is never observed.
function commitFuncReturnTypes(project Project, artifact FileParseArtifact)
	for entry in artifact.funcReturnTypes 'each'
		project.funcReturnTypes.upsert(entry.name, value: entry.returnType)
	end 'each'
end 'commitFuncReturnTypes'

// Commit the artifact's `funcSignatures` contributions into the project registry,
// detecting DUPLICATE FUNCTION DEFINITIONS. A name already in the registry — from an
// earlier file, or an earlier declaration in THIS file (both entries sit in this array in
// declaration order) — is a duplicate: a plain `upsert` would SILENTLY overwrite the first
// entry, and a call would then validate against (and lower to) the WRONG signature. So the
// collision is reported positioned at the offending (later) declaration (E3006), and the
// first definition is kept. This is the single whole-program duplicate check: every
// function the parser builds records exactly one signature entry here.
function commitFuncSignatures(project Project, artifact FileParseArtifact)
	for entry in artifact.funcSignatures 'each'
		if project.funcSignatures.contains(entry.name) 'duplicate'
			reportPositioned(project, code: ErrorCode.duplicateDefinition, message: "duplicate definition of function '{String.from(entry.name)}'", line: entry.nameLine, column: entry.nameColumn, filePath: entry.sourceFilePath)
			continue
		end 'duplicate'
		project.funcSignatures.upsert(entry.name, value: entry.signature)
	end 'each'
end 'commitFuncSignatures'

// Commit this file's overload sets (D7). One independent upsert per overloaded bare name, so — unlike every
// other commit here — it needs no reset to survive a warm rebuild and the KEY iteration order decides
// nothing; see `OverloadSetMap` for both arguments. A file that overloads nothing carries the shared empty
// table and this loop does not run.
//
// ⚠ It does NOT detect a CROSS-FILE contest, and cannot: the members were chosen by a parser that saw one
// file. Two files declaring one name collide in `commitFuncSignatures` above (E3006) exactly as they did
// before this rung, which is the boundary `Parser.overloadRegistrationNameFor` states.
function commitOverloadSets(project Project, artifact FileParseArtifact)
	for (base, members) in artifact.overloadSets 'each'
		project.overloadSets.upsert(base, value: members)
	end 'each'
end 'commitOverloadSets'

// Append this file's recorded function-value merge checks to the whole-program list (P1.5 #81). Unlike
// the signature commit above there is NO dedup: each entry is a DISTINCT merge SITE (its own position),
// so every one is drained. Kept an array (not a map) for the same reason the `*Entry` families are —
// the drain order is the file/declaration order, deterministic and reviewable.
function commitPendingFnMergeChecks(project Project, artifact FileParseArtifact)
	for check in artifact.pendingFnMergeChecks 'each'
		project.pendingFnMergeChecks.push(check)
	end 'each'
end 'commitPendingFnMergeChecks'

// Append this file's recorded function-type doors to the whole-program list — the twin of the merge-check
// commit above, dedup-free for the same reason: each entry is a distinct SITE with its own position.
function commitPendingFunctionTypeDoors(project Project, artifact FileParseArtifact)
	for door in artifact.pendingFunctionTypeDoors 'each'
		project.pendingFunctionTypeDoors.push(door)
	end 'each'
end 'commitPendingFunctionTypeDoors'
