// Project.maxon — foundational compiler-wide types.
//
// THIN for maxon-shv2 M1. In v1 (`maxon-selfhosted`) this file also holds the
// ~90-field `Project` struct and its ~28 parser-written registries. shv2 splits
// that shared state into a per-file `FileParseArtifact` (see PLAN.md — parse
// staging), so the big `Project` struct + registries + `createProject` are a
// Chunk C deliverable that GROWS this file. What lives here now is the small set
// of foundational, cross-cutting types the type layer depends on that v1 happens
// to home in Project.maxon: the primitive-array aliases, the declaration
// `Visibility` tier, and the parser's `VarInfo` symbol-table record.
//
// GROWTH CONTRACT: Chunk C must ADD the `Project` struct and registries here —
// it must NOT redefine the symbols already defined below.

// Array aliases over primitives / String. Cross-cutting; used by the IR
// containers (StringArray for name lists, BoolArray for the compaction
// liveness bitmaps). v1 scatters these between Project.maxon and Parser.maxon;
// shv2 homes both here so the parser rebuild (Chunk C) doesn't re-declare them.
export typealias StringArray = Array with String
export typealias BoolArray = Array with bool

// Visibility tier of a top-level declaration. Stamped by the parser at
// declaration time; consumed by cross-file name resolution and the unused-export
// check. `file` is the default (positively widened to `module`/`global`).
//
// ⭐ **FOUR TIERS, AND THE MODIFIER THAT SELECTS EACH (N1a, `specs/module-keyword.md`;
// `public` added by `specs/public-keyword.md`):**
//   • `file`   — no modifier. Visible only inside the declaring FILE.
//   • `module` — the `module` modifier. Visible to every file in the declaring file's DIRECTORY and
//                in every subdirectory of it — i.e. every file whose NAMESPACE is the declaring
//                file's namespace or a descendant of it.
//   • `global` — the `export` modifier. Visible everywhere.
//   • `public` — the `public` modifier. Visible everywhere, EXACTLY as `global` is.
// The three modifiers are mutually exclusive (E2001, `Parser.consumeOptionalVisibility`).
//
// ⭐⭐ **`global` AND `public` ARE THE SAME VISIBILITY AND A DIFFERENT CLAIM, WHICH IS WHY THEY ARE TWO
// CASES AND NOT ONE.** `isVisibleFrom` answers `true` for both and always will; anything that asks *"can
// this file name that symbol?"* must treat them as identical, and a reader that distinguishes them there
// is a bug. The ONE question they answer differently is the unused-export family's:
//   • `export` — other files may see this, **and I expect this program to use it**. Linted: if nothing
//     outside the declaring file references it, that is E3092, and it is a real finding.
//   • `public` — this is **API surface**. Exempt from E3092/E3093, because "no caller in THIS
//     compilation" is not the same fact as "dead" — it could be a shared module an app happens not to
//     use. That objection is a 2026-08-03 user ruling which withdrew the lint entirely; `public` is what
//     answers it, by letting the author say which of the two things they meant.
//
// ⚠ **THERE IS DELIBERATELY NO `module public`.** E3094 (an unused `module` decl) keeps its full force; a
// `module` declaration that wants exemption is PROMOTED to `public`, which changes its visibility and
// says so. A tier and an exemption flag would be two axes, and every reader would then have to know it
// must ask about both — the `public` case exists precisely so there is one axis to ask about.
//
// ⚠ **`public` IS APPENDED LAST, AND MUST STAY LAST.** These ordinals feed the incremental-build content
// hash (`SignatureIndex.tierOrdinal`, `mixDeclaration`). Inserting a case mid-enum renumbers `global` and
// silently invalidates every cached signature under a name that still looks current.
//
// ⚠ **`export` USED TO MINT `Visibility.module`**, back when the enum had three cases and the
// language had two: every reader asked `!= Visibility.file` and the middle case merely happened to
// be the one `export` produced. It now means what its name says, and the ONE place a tier is turned
// into an answer is `ProgramSignatures.isVisibleFrom`.
//
// ⚠ **A FIELD'S `file` TIER MEANS ITS DECLARING TYPE, NOT ITS DECLARING FILE**, and that asymmetry
// is measured rather than chosen — see `Parser.requireFieldAccessible`, whose gate is the TYPE.
export enum Visibility
	file
	module
	global
	public
end 'Visibility'

// ⭐ **"IS THIS DECLARATION VISIBLE OUTSIDE ITS DECLARING FILE'S SUBTREE?" — ASKED ONCE.** `global` and
// `public` are the same visibility (see the header above), so every reader that cares about REACH rather
// than about the unused-export claim asks here instead of spelling `== global or == public`. That
// disjunction written out at N sites is a set written down N times, and the N+1th tier reaches N-1 of them.
// ⚠ `module`, not file-private: SV1's message-roster test asks it from `Parser.recordScannedSignature`,
// which is the whole point of the function — the disjunction written out at a second site is the set written
// down twice.
module function isProgramWideTier(visibility Visibility) returns bool
	return visibility == Visibility.global or visibility == Visibility.public
end 'isProgramWideTier'

// The three WORDS that select a tier — the source-level surface of `Visibility`, which the tier enum
// itself cannot carry because `file` has no word and `global` is not spelled "global".
//
// ⚠ **DECLARATION ORDER IS THE ORDER A COMBINED-MODIFIER DIAGNOSTIC NAMES THEM**, and it is NOT encounter
// order. `'export' and 'module' cannot be combined` is pinned byte-for-byte by six live cases, so
// `module export` has to render the same sentence as `export module`. `Parser.refuseSecondVisibilityModifier`
// sorts the pair by `.ordinal` before throwing, which is the only reason this order is load-bearing.
//
// Cases are prefixed `word` because the unprefixed spellings are keywords; v1's `UseKindTag` prefixes
// `kind_` for exactly this reason.
export enum VisibilityModifierWord
	wordExport
	wordModule
	wordPublic
end 'VisibilityModifierWord'

// The quoted spelling a diagnostic prints. The words themselves are reserved in `Lexer.keywordMap`
// (`export`, `public`) and in `Parser.ModuleModifierName` (`module`, which is contextual and so has no
// keyword entry) — two different mechanisms, which is why the display spelling is written here once
// rather than derived from whichever of them happens to hold a given word.
export function visibilityModifierSpelling(word VisibilityModifierWord) returns String
	match word 'word'
		wordExport then return "'export'"
		wordModule then return "'module'"
		wordPublic then return "'public'"
	end 'word'
end 'visibilityModifierSpelling'

// ⭐⭐ **WHAT JOINS A MODULE DIRECTORY'S SEGMENTS — AND IT IS `/`, NOT `.`, BECAUSE THE JOIN HAS TO BE
// INVERTIBLE.** `moduleDirectoryContains` is a SEGMENT test, and a segment test on a joined string is
// only sound if no segment can contain the joiner.
//
// ⚠ **THIS WAS `.` AND IT WAS A WRONG ANSWER (found in N1a review).** The claim written here was *"a
// directory name cannot contain one on any host the compiler targets"*, and it is false on all three —
// this very repository holds `.maxon/` and `.claude/`. Two failures, both MEASURED, both silent:
//
//   • `feature/` and `feature.extra/` are SIBLINGS. Joined with `.` the second reads as `feature.extra`,
//     which starts with `feature.` — so a `module` declaration in `feature/` was visible from
//     `feature.extra/`, the exact widening the separator guard exists to prevent.
//   • `my.dir/` and `my/dir/` both joined to `my.dir`, so two structurally different directories
//     became ONE module and each could see the other's `module` declarations.
//
// `/` cannot appear in a path SEGMENT on any host the compiler targets: it is the separator itself on
// Linux, macOS and WASI, and on Windows it is both an accepted separator and one of the characters a
// file or directory name may not contain. So the join is injective and the segment test is sound. The
// `.`-joined spelling the language shows a user is DERIVED from this one
// (`namespaceForModuleDirectory`) and is never what a visibility question is asked on.
// ⚠ EXPORTED since W72's review, for `Parser.sourceFileDisplayPath` — `__file__` expands to a module
// directory joined to a file name, so the joiner it uses IS this one, and a literal `/` there would be a
// second speller of the character this whole header is an argument about.
export let ModuleDirectorySeparator = "/"

// The one spelling that has to be rewritten: `FilePath` normalizes to the PLATFORM separator on
// construction, so a Windows host hands back `feature\sub` where a POSIX host hands back `feature/sub`,
// and a spec fixture's `// --- file: feature/sub/deep.maxon` must derive the same module directory on
// either. `/` needs no rewrite because it IS the joined form.
let WindowsPathSeparatorText = "\\"

// What joins a NAMESPACE's segments — the spelling `specs/namespaces.md` gives (`stdlib.fmt`) and the one
// a qualified reference will be written with. It is a RENDERING of a module directory and nothing reads a
// visibility answer off it; see `ModuleDirectorySeparator` for why the two cannot be the same character.
let NamespaceSeparator = "."

// ⭐ **A FILE'S MODULE DIRECTORY IS ITS DIRECTORY, RELATIVE TO ITS COMPILE ANCHOR, `/`-JOINED** —
// `math.maxon` at root ⇒ `""`, `utils/helpers.maxon` ⇒ `utils`, `stdlib/fmt/integer.maxon` ⇒ `stdlib/fmt`.
// It is the string every `Visibility.module` question is decided on.
//
// Ported from v1's `deriveNamespace` (`maxon-selfhosted/Compiler/Queries.maxon:88-102`), including its
// `notUnderRoot` fallback: a file outside its declared anchor falls back to its immediate parent's NAME,
// so a misconfigured anchor can never produce a `..` segment. shv2 reaches that arm for
// every stdlib file of a user build — `namespaceAnchorFor` gives stdlib its own anchor, so the arm covers
// only a genuinely misconfigured caller.
//
// ⚠ **THE ANCHOR IS THE ARGUMENT, AND GETTING IT WRONG IS SILENT** — every file would get a plausible
// module directory and the wrong one. `Queries.namespaceAnchorFor` is its single producer, and states the
// three anchors it derives.
export function deriveModuleDirectory(filePath FilePath, rootPath FilePath) returns String
	let relative = try filePath.relativeTo(rootPath) otherwise 'notUnderRoot'
		let parent = try filePath.parent() otherwise return ""
		return parent.filename()
	end 'notUnderRoot'

	// No separator left in the relative path ⇒ the file sits AT the anchor, which is the root module.
	let directory = try relative.parent() otherwise return ""
	return directory.toString().replace(WindowsPathSeparatorText, with: ModuleDirectorySeparator)
end 'deriveModuleDirectory'

// The `.`-joined NAMESPACE a module directory is shown as — `stdlib/fmt` ⇒ `stdlib.fmt`. Derived from the
// directory rather than stored beside it, so the two cannot come to disagree: the directory is the fact
// (it is invertible), and this is one rendering of it.
export function namespaceForModuleDirectory(moduleDirectory String) returns String
	if moduleDirectory.isEmpty() 'rootModule'
		return ""
	end 'rootModule'

	return moduleDirectory.replace(ModuleDirectorySeparator, with: NamespaceSeparator)
end 'namespaceForModuleDirectory'

// ⭐ **IS `inner` THE SAME MODULE AS `outer`, OR ONE BENEATH IT?** — the whole of what `Visibility.module`
// means, asked on module directories rather than on `FilePath`s.
//
// ⚠ **THE SEPARATOR IN THE PREFIX IS THE POINT, and v1 flags the same line as the fragile one**
// (`readerFileIsInModuleSubtree`, `maxon-selfhosted/Compiler/Project.maxon:213-227`): without it
// `feature` would contain `featureX`, a sibling directory that merely shares a character prefix. shv2
// asks it of a `/`-joined RELATIVE directory rather than of v1's stringified parent `FilePath` for one
// reason — it is derived ONCE PER FILE and indexed, where v1's version calls `FilePath.parent()` on both
// sides of every ask (a slice, a String and a FilePath per call, per side). The guard itself is v1's,
// character for character, and `ModuleDirectorySeparator` is what keeps it sound.
//
// The empty module directory is the ROOT, and every file in the program is under the root — so a
// `module` declaration in a root-level file is visible program-wide, which is what "same directory and
// every subdirectory" says when the directory is the root.
export function moduleDirectoryContains(outer String, inner String) returns bool
	if outer.isEmpty() 'rootIsEveryFilesModule'
		return true
	end 'rootIsEveryFilesModule'

	if inner.equals(outer) 'sameDirectory'
		return true
	end 'sameDirectory'

	return inner.startsWith("{outer}{ModuleDirectorySeparator}")
end 'moduleDirectoryContains'

// ⭐⭐ **THE NEAREST CANDIDATE DIRECTORY THAT ENCLOSES THE READER — OR THAT NONE DOES**, which are two
// different answers and not one answer with a sentinel (N1c). The ROOT module is the empty string and is a
// perfectly good enclosing scope, so "no candidate encloses the reader" cannot be spelled `""`.
//
// The distinction is the whole of v1's `restrictToNearestEnclosingScope` (`maxon-selfhosted/Compiler/
// Project.maxon:2677-2706`): when SOME candidate encloses the reader, only the deepest such candidates
// survive; when NONE does, every candidate survives — and it is that second arm that makes `api/` versus
// `legacy/`, read from `app/`, ambiguous at all.
export union EnclosingScope
	none
	nearest(directory String)
end 'EnclosingScope'

// Fold one candidate's directory into the running "nearest enclosing scope".
//
// ⚠ **DEEPEST IS LONGEST, and that is sound only because every candidate compared here already ENCLOSES
// the reader** — such directories form a nested chain, so the deeper one's string is strictly an extension
// of the shallower one's. v1 ranks by the same byte length and its `declarerDirLength` states the same
// precondition. Comparing lengths across directories that do NOT nest would be meaningless, which is why
// the containment test gates the comparison rather than sitting beside it.
export function deeperEnclosingScope(current EnclosingScope, declDirectory String, readerDirectory String) returns EnclosingScope
	if not moduleDirectoryContains(declDirectory, inner: readerDirectory) 'notEnclosing'
		return current
	end 'notEnclosing'

	match current 'sofar'
		none then return EnclosingScope.nearest(declDirectory)
		nearest(directory) then return EnclosingScope.nearest(declDirectory) if declDirectory.byteLength() > directory.byteLength() else EnclosingScope.nearest(directory)
	end 'sofar'
end 'deeperEnclosingScope'

// Does a candidate survive the nearest-enclosing narrowing? Everything survives when nothing encloses the
// reader; otherwise only the deepest enclosing directory's own declarations do — and TWO declarations in
// that one directory both survive, which keeps a genuine same-directory contest ambiguous.
export function scopeAdmits(scope EnclosingScope, declDirectory String) returns bool
	return match scope 'scope'
		none gives true
		nearest(directory) gives declDirectory.equals(directory)
	end 'scope'
end 'scopeAdmits'

// How a root-level declaration is shown in an ambiguity candidate list. v1's spelling
// (`renderTypealiasCandidateList`), and it exists because the alternative is a leading bare `.Score`,
// which reads as a typo rather than as "declared at the root".
let RootNamespaceDisplay = "(root)"

// ⭐ **ONE E3063 CANDIDATE, AS THE USER WOULD HAVE TO WRITE IT** — `api.Score`, `lib.fmt.Score`,
// `(root).Score`.
//
// ⚠ **E3095 DOES NOT USE THIS, and the asymmetry is the shapes' asymmetry.** A contested FUNCTION already
// carries its qualified spelling as its registration NAME (`ProgramSignatures.contestedFreeFunctions`), so
// its candidate list is read off the index; a contested ALIAS is filed under its bare name and the qualified
// form has to be RENDERED from the declaring file's directory. Handing the function side this renderer would
// have it re-derive a string it is already holding, and the two could then disagree.
//
// ⚠ **THE LAST JOIN GOES THROUGH `joinQualifiedName`, AND THE CONSTANT IT DOES *NOT* USE IS THE POINT
// (N1c review).** `NamespaceSeparator` is the byte a module DIRECTORY renders its own internal separators
// as (`namespaceForModuleDirectory`); `QualifiedAliasSeparator`, inside `joinQualifiedName`, is the byte
// that divides a namespace from the NAME it qualifies — the one `splitQualifiedName` inverts and the one a
// registry key actually carries. `namespaceQualifiedName` states that split and routes the last join the
// same way. Spelled here with the directory's constant instead, this renders a candidate the moment those
// two ever differ that no user could act on: the message would offer `api:Score` while the key that
// resolves is `api.Score` — a diagnostic whose whole content is a fix, prescribing one that does not work.
//
// The `(root)` substitution happens BEFORE the join, so the root's display form survives it.
export function qualifiedCandidateName(moduleDirectory String, bare ByteArray) returns String
	let namespace = namespaceForModuleDirectory(moduleDirectory)
	let shown = RootNamespaceDisplay if namespace.isEmpty() else namespace
	return String.from(joinQualifiedName(shown.toByteArray(), member: bare))
end 'qualifiedCandidateName'

// ⭐⭐ **CANDIDATES ARE RENDERED IN LEXICOGRAPHIC ORDER, AND THAT IS A DELIBERATE DIVERGENCE FROM v1**,
// which renders in map-iteration order with no sort and whose own spec records that the bootstrap has "a
// slightly different candidate-ordering guarantee".
//
// ⚠ **shv2 CANNOT INHERIT "unordered": its `Map` is OPEN-ADDRESSED, so iteration is SLOT order — a
// function of the hashes of two file paths.** An unsorted list would therefore reorder itself when a
// directory is renamed, when the table grows, or on a host whose paths hash differently, and the message
// is pinned by a golden. A diagnostic a user reads twice must read the same way twice; sorting is the
// cheapest property that makes that true of a set the compiler discovered in an arbitrary order.
//
// ⭐⭐ **AND THE LIST IS A SET: AN EXACT DUPLICATE IS DROPPED, WHICH IS A CORRECTNESS RULE AND NOT A TIDY-UP.**
// Two declarations can render the SAME candidate, and both diagnostics can reach it:
//
//   • **E3063** — two files in ONE directory may legally export one alias name over two RANGES, so a third
//     file's bare reference has two candidates that both spell `api.Score`. A message reading
//     *"Candidates: api.Score, api.Score"* would offer a fix that is not one: the qualified form is
//     contested between those same two files, so writing it changes nothing. Deduped, the count falls to
//     one, no ambiguity is claimed, and resolution proceeds exactly as it did before this rung — a case
//     this rung leaves where it found it rather than lying about. (v1 renders the doubled list.)
//   • **E3095** — a name contested across directories that is ALSO declared twice inside one of them files
//     that directory's spelling once per declaration. Whether it did so depended on the order the two
//     files were swept in, which is the filesystem's.
//
// Insertion sort into an array of at most a handful of entries, on a path that has already decided to fail
// the build — so the `toByteArray()` per comparison is paid only by a program that is about to be
// rejected, and never by one that compiles.
export function insertCandidateName(candidates StringArray, candidate String)
	var at = 0 as ElementCount
	while at < candidates.count() and stringBytesPrecede(try candidates.get(at) otherwise panic("insertCandidateName: get OOB at {at} inside its own count()"), later: candidate) 'findPosition'
		at = at + 1
	end 'findPosition'

	if at < candidates.count() and (try candidates.get(at) otherwise panic("insertCandidateName: get OOB at {at} inside its own count()")).equals(candidate) 'alreadyOffered'
		return
	end 'alreadyOffered'

	candidates.insert(at, value: candidate)
end 'insertCandidateName'

// ⭐ **BYTE-WISE `<` OVER TWO STRINGS — the compiler's ONE lexicographic order.** `String` declares no
// `Comparable` conformance and the byte door that would avoid these two conversions (`String.byteAt`) is
// `module`-scoped inside `stdlib/`, so the comparison is made on the byte arrays.
//
// ⚠ **BOTH READERS ARE ON A PATH THAT HAS ALREADY DECIDED TO FAIL THE BUILD**, which is what makes the
// per-comparison `toByteArray()` acceptable: `insertCandidateName` orders an ambiguity message's candidates,
// and `TypeCycleCheck.typeDeclEarlier` breaks the cross-file tie between two cyclic declarations. Neither
// runs on a program that compiles, and neither would be affordable if it did.
export function stringBytesPrecede(earlier String, later String) returns bool
	let a = earlier.toByteArray()
	let b = later.toByteArray()
	var i = 0 as ElementCount
	while i < a.count() and i < b.count() 'compareByte'
		let left = try a.get(i) otherwise panic("stringBytesPrecede: get OOB at {i} inside its own count()")
		let right = try b.get(i) otherwise panic("stringBytesPrecede: get OOB at {i} inside its own count()")
		if left != right 'decided'
			return left < right
		end 'decided'
		i = i + 1
	end 'compareByte'

	return a.count() < b.count()
end 'stringBytesPrecede'

// The `", "`-joined candidate trailer both ambiguity messages end with. One renderer, because the two
// diagnostics say the identical sentence about a different kind of declaration.
export function renderCandidateList(candidates StringArray) returns String
	var out = ""
	var first = true
	for candidate in candidates 'each'
		out = "{candidate}" if first else "{out}, {candidate}"
		first = false
	end 'each'
	return out
end 'renderCandidateList'

// ⭐ THE ONE EMPTY `StringArray` every UNAMBIGUOUS name answers with — so the common path allocates
// nothing. NEVER mutated: the only writer builds a fresh array.
export let sharedEmptyCandidateNames = StringArray.create()

// ⭐⭐ **IS THIS DECLARATION A LIBRARY LAYER'S? — the one ambiguity rule that is about PROVENANCE rather
// than about scope (N1c).** A stdlib declaration is dropped from an ambiguity candidate set OUTRIGHT,
// before the count, so a project `export typealias StringArray` SHADOWS `stdlib/Json.maxon`'s rather than
// colliding with it (`typealias-collision/project-export-shadows-stdlib-export`). Ported from v1's
// `dropStdlibTypealiasCandidates` / `isStdlibNamespace` (`maxon-selfhosted/Compiler/Project.maxon:201-206,
// 2653-2662`), which states the same rule and gives the same reason: the bootstrap seeds stdlib aliases as
// a separate lower-precedence layer and never lets them enter an ambiguity set at all.
//
// ⚠ **IT IS THE SAME SEGMENT-GUARDED TEST `Visibility.module` IS DECIDED BY, not a second one.** v1 asks
// `namespace == "stdlib" or namespace.startsWith("stdlib.")` — literally `moduleDirectoryContains` with the
// separator changed — so spelling it again here would be the one-fact-twice bug with `stdlib` as the fact.
// A user directory genuinely NAMED `stdlib/` is therefore read as the library layer; v1 has that exact
// property, and the alternative (a per-file provenance bit threaded to every candidate) buys nothing the
// anchor does not already give: `Queries.namespaceAnchorFor` puts the real stdlib at `stdlib`.
// ⚠ **IT IS NO LONGER "AND NOWHERE ELSE", AND THAT SENTENCE WAS EDITED RATHER THAN LEFT TO ROT.** Since
// the anchor became a PATH fact (`livesUnderStdlibDirectory`) rather than a VISIBILITY one, a
// `build stdlib/File.maxon` anchors its ROOT FILE at stdlib's parent too — so that file's module
// directory is `stdlib` while the compiler still classifies it as the USER's (A1t bar 2). It is the
// price of the repair and it is the right way round: the two files in one directory are now measured
// from one root, which is what stopped `String.addressableBytes` being refused as invisible from its own
// neighbour. The single consumer, `SignatureIndex.candidateIsReachable`, is unmoved — a compile rooted
// under `stdlib/` has every other file under `stdlib/` too, so the reachable-candidate count it gates on
// does not cross its `< 2` threshold either way.
export function isStdlibModuleDirectory(moduleDirectory String) returns bool
	return moduleDirectoryContains(StdlibDirName, inner: moduleDirectory)
end 'isStdlibModuleDirectory'

// A `Visibility` as a small dense number, for the one reader that must MIX a tier into a content hash
// (`ProgramSignatures.recordAlias`) rather than branch on it. Spelled here, beside the enum, so a fourth
// tier is one arm in one place instead of a silently stale literal in a hashing routine.
export function tierOrdinal(visibility Visibility) returns VisibilityTier
	return match visibility 'tier'
		file gives 0
		module gives 1
		global gives 2
		public gives 3
	end 'tier'
end 'tierOrdinal'

typealias VisibilityTier = int(0 to 3)

// One `Visibility` per struct field, in declaration order. See `StructLayout.fieldVisibility`.
export typealias VisibilityArray = Array with Visibility

// The declaring file of a type NO FILE DECLARES — the compiler-synthesized layouts (`StringIndex`,
// a tuple, `__ManagedFile`, `__ManagedDirectory`, `Ordering`, the builtin error enums).
// Each is `Visibility.global`, so no tier ever reads this path; it is the same "empty path means the
// compiler built it" statement `IrFunction.SourcePosition.synthesized` makes, spelled once for layouts.
//
// ⭐ **IT IS ALSO HOW A READER THAT DECLARES NOTHING ASKS (N2), and that is the same fact rather than a
// second use.** `RangedAliasRegistry.lookup` probes its by-file index with the reader's path, so an EMPTY
// path matches no declaration and falls through to the nameable tier and then to the bare one — which is
// exactly the rule a non-declaring file resolves a contested name by. A type the compiler built is a
// reader with no file, so it resolves like one; spelling a second empty path for that would be the same
// value written down twice.
export let CompilerOwnedDeclFilePath = FilePath from ""

// The `payloadStorage` of a binding that is not a match-arm payload binding — `unresolved`, the
// MaxonType arm that means "no type has been settled here", so a reader that ignored
// `isPayloadBinding` and used it as a store width would get a tag nothing lowers rather than a
// plausible `integer` that silently stores eight bytes at offset 0. Named rather than spelled at the
// default, so "what does a non-payload binding carry here" has one answer.
let NoPayloadStorage = MaxonType.unresolved

// VarInfo — one entry in a function's `Scope` symbol table.
//
// The parser tracks every local by its source-level `MaxonType`; that type is
// carried to lowerMaxonToStd, which resolves the concrete `StdType` (int vs
// float, width) through the typealias registry after resolution. The parser
// never branches on int-vs-float.
//
// `isSelfField` / `isPayloadBinding` mark the two non-slot binding shapes
// (self-field alias inside an instance method; match-arm payload binding on a
// union). Both are inert at M1 (no structs, no enums yet) but the record shape
// is kept whole so M9/M12 activate them without a struct migration.
export type VarInfo
	// A zero-copy slice of the source, straight off the declaring token — names are
	// KEYS, and ByteArray hashes/compares by content, so no String is ever built for one.
	export var name as ByteArray
	export var varType as MaxonType
	export var mutable as bool
	export var slot as VarSlot
	// The SSA ValueId this binding aliases, for M2's value-substitution model: a
	// `let`/`var x = <expr>` binds `x` directly to the ValueId its initializer
	// produced, so a reference to `x` resolves to that value at parse time and no
	// `x` op ever enters the IR (`let x = 42; return x` lowers identically to
	// `return 42`). Meaningful ONLY for value bindings — which is every name the parser
	// installs today, a match-arm PAYLOAD binding included (it aliases the value the
	// arm loaded out of the box). It is 0 and unread for a self-field alias, whose
	// reads and writes go through the receiver instead. When mutation + `mem2reg`
	// land, the slot model (above) supersedes this direct substitution.
	export var boundValue as ValueId
	// Ownership lattice kind for this binding — the M1 ownership scaffold's
	// per-binding attribute (see OwnershipKind in MaxonDialect.maxon). ALWAYS
	// `trivial` at M1 (all bindings are scalars); the Own tier (M6) sets it to
	// `owned`/`borrow`/`shared` during OwnershipInfer/EscapeAnalysis, and Scope's
	// per-frame owned-values list keys off it to place drops at scope exit.
	// Present-but-inert: designed in from the first commit, not retrofitted.
	export var ownership as OwnershipKind
	// ⭐ **THE ONE BIT WAVE C READS (static single-owner MOVES).** Set true when this binding has been
	// MOVED FROM — its owned heap value was transferred to another binding by a `let u = t` / `s = t`
	// whose RHS was a bare reference to it. A moved-from binding STAYS in `ownedBindings` (mid-stack
	// removal would desync the block/loop drop marks — see `reassignBindingValue`/`removeFromOwnedBindings`)
	// but is SKIPPED by `emitScopeDrops` (its value drops via its NEW owner, exactly once) and REJECTED
	// at EVERY use — a bare read, a field read/write through it, a method call on it (E3102 use-after-move,
	// via the one `Parser.requireBindingLive` guard both `parseVariableReference` and `requireStructBase`
	// ask). A FULL reassignment `t = <expr>` revives it (`reassignBindingValue` clears the bit — the
	// binding then owns the new value); a field store `t.x = …` is a USE, not a revive. Always false for a
	// trivial/scalar binding, because only an owned heap value is ever moved.
	export var movedFrom as bool
	// ⭐ **PARTIALLY MOVED (P1.3 slice 2 — a binding-match that moved a managed payload OUT of this
	// union).** Distinct from `movedFrom` in exactly one respect, and that respect is the whole reason it
	// is a second bit: a `partiallyMoved` union is REJECTED at every use (E3102 — a later `match`/read
	// would deref a nulled slot) via the SAME `requireBindingLive` guard, but it is STILL DROPPED at scope
	// exit (`emitScopeDrops` does NOT skip it). Its box, and any managed fields the match left in place,
	// are freed by its `__destruct_<U>` cascade — the moved-out slots were nulled, so the cascade skips
	// them. `movedFrom` means "another binding owns this value, drop nothing"; `partiallyMoved` means
	// "this binding still owns the box, but its contents may not be read again". Always false for a scalar
	// binding or a union whose match bound no managed payload.
	export var partiallyMoved as bool
	// True when this name is a self-field alias inside an instance method — the bare `width`
	// inside `function area()` of `type Rect`, which means `self.width`.
	//
	// Reads emit loadIndirect through `__self` at the field's offset; writes emit storeIndirect —
	// the SAME two ops `p.x` already rides (there is no `fieldLoad`/`fieldStore` op and there is
	// not going to be one; the memory band is the general pair, per StdDialect). Concretely they
	// ride the same two ROUTINES, `Parser.emitFieldLoad`/`emitFieldStore`, which is the stronger
	// statement and the one that matters: v1 has a SECOND pair of ops for this alias
	// (`selfFieldLoad`/`selfFieldStore`, receiver out-of-band) and paid for it twice — its
	// visibility walker inspects only the ordinary pair, so a bare-name access is structurally
	// invisible to E3014, and its closure lowering has to re-route because the hardcoded receiver
	// slot "would load garbage" inside one.
	//
	// ⭐ **IT CARRIES THE FIELD'S INDEX, NOT ITS OFFSET**, and that is what keeps the two spellings
	// on one path. The index IS the field's identity (see `FieldIndex`); the offset, the declared
	// type, the mutability and the `export` bit are all DERIVED from `(layout, index)` by the four
	// accessors `p.x` already asks. An offset here would answer only the first of those four, and
	// would answer it a SECOND time — `binding.fieldOffset` beside `layout.offsetOfField(index)`,
	// two numbers for one fact, with the write path left needing the index anyway to reach
	// `fieldMutable`. One number, one lookup, no column to keep in step.
	export var isSelfField as bool
	export var fieldIndex as FieldIndex
	// ⭐ **THIS NAME IS A MATCH-ARM PAYLOAD BINDING, AND A WRITE TO IT GOES BACK INTO THE BOX** — the
	// whole of `specs/mutable-enums.md`. `full(value) then value = 42` on a `var` union rebinds the
	// SSA name AND stores 42 into the scrutinee's heap block, so a later `match` reads the new value.
	//
	// ⭐ **KEYED ON THE SCRUTINEE'S SSA VALUE, NOT ON ITS NAME.** v1 carries the scrutinee's NAME plus
	// the case name and re-resolves both at the write; shv2 resolves names at parse time and passes
	// `ValueId`s everywhere else, so the box is named by the id the LOAD read from. A name would have
	// to be looked up again in a scope the write may have shadowed, and a scrutinee that has no name
	// at all (a temporary) would need a second answer.
	//
	// ⭐ **THE OFFSET AND THE STORAGE TYPE ARE CARRIED RATHER THAN RE-DERIVED, and that is the opposite
	// of `fieldIndex` above ON PURPOSE.** A self-field alias re-derives from `(layout, index)` because
	// its use site HOLDS the layout; an assignment holds nothing but the binding — reaching a layout
	// would mean re-resolving the union off the box AND re-classifying the slot, i.e. a second
	// derivation of the two numbers the load already committed to. The store must hit exactly the
	// address and width `emitUnionPayloadLoad` read, so they are computed ONCE, at the bind, from the
	// one `PayloadClass` that load classified.
	export var isPayloadBinding as bool
	export var payloadScrutBox as ValueId
	export var payloadSlotOffset as ByteOffset
	export var payloadStorage as MaxonType
	// ⭐ **IS THIS BINDING'S SLOT IN THE BOX CURRENTLY NULL?** True from the moment a MANAGED payload is
	// moved out of an OWNED scrutinee (`Parser.moveOutManagedPayload` nulls the slot) until a write-back
	// refills it. It is what lets the write-back answer the scrutinee's `partiallyMoved` question
	// HONESTLY: a case with two managed payloads of which only one is assigned still has a hole, and
	// clearing the scrutinee's bit there would hand a later match a null slot to dereference.
	export var payloadSlotVacated as bool
	// ⭐ **IS THIS NAME A PARAMETER?** — set only by `Parser.bindParameters`.
	//
	// It exists because `mutable` answers a DIFFERENT question and the two diverge on exactly one
	// binding kind. `mutable` is "may this NAME be rebound?", and a parameter's answer is NO (a
	// reassignment to one is E2013, and `ParametersAreMutable` is false for the loop-phi reason
	// `bindParameters` documents at length). But "may the CONTAINER this name denotes be written?" is
	// a different question, and a parameter's answer is YES: it is a borrowed reference to the
	// caller's record, and `dest.append(src)` inside a helper is ordinary Maxon.
	//
	// **MEASURED against the runnable oracle**: a mutating `String`/`Array`/`Set` method is accepted on a
	// PARAMETER receiver and rejected (E3019) on a `let` LOCAL — including a `let` that merely aliases a
	// field, another local, or THE PARAMETER ITSELF. Read by `Parser.immutableReceiverNameOf`, the one
	// home of that rule; without it every container-mutating helper in the corpus is rejected (measured:
	// 3 `array-append-managed-elements` cases).
	//
	// ⚠ It is deliberately NOT derived from the parameter ValueId convention (`boundValue < paramCount`,
	// `requireReceiverValue`), which looks like the same fact and is not: `let a = p` carries the
	// PARAMETER's ValueId while being a `let`, and `a.push(9)` is E3019 in the oracle. See
	// `Parser.immutableReceiverNameOf` for the measurement.
	export var isParameter as bool
	// ⭐ **THE TOKEN OF THIS BINDING'S LAST USE — the NON-LEXICAL half of E3070** (`BorrowCheck`).
	// Written at `Parser.requireBindingLive`, the one chokepoint every USE of a local binding funnels
	// through (a bare read, a field read or write through it, a method call on it), so "was this name
	// read?" is answered exactly once in the parser and never re-derived.
	//
	// ⭐ It lives on the BINDING and not on the borrow record because a borrow is recorded when it is
	// TAKEN and the last use happens later: a name copied onto the record at record time would be a
	// second fact, free to disagree with the binding it describes. A `BorrowRecord` therefore holds
	// the `VarInfo` itself and reads this through it.
	//
	// ⚠ **BOTH WRITERS MOVE IT FORWARD ONLY, AND THAT IS A CORRECTNESS RULE RATHER THAN TIDINESS.**
	// `requireBindingLive` records an ordinary use at the cursor; `attachPendingBorrows` SEEDS it when a
	// borrow is taken — to the activation for a `let`/`var` (so a name never read again is dead the instant
	// it is bound, which is what makes `borrow-checker.md:borrow-nll-allowed` compile) and to the LOOP'S
	// `end` for a `for … in` element, whose liveness is lexical. A writer that moved it BACKWARDS would
	// expire a borrow the program is still holding — a use-after-free with no diagnostic anywhere.
	//
	// Constructed 0, and left 0 for every binding kind no borrow can name, where nothing reads it.
	export var lastUseToken as TokenIndex
	// ⭐ **DOES THIS NAME DENOTE MODULE STORAGE — a top-level `var` — RATHER THAN A BINDING OF THIS
	// FRAME?** True only for the E3070 subject stand-in `Parser.topLevelBorrowSubjectOf` mints.
	//
	// ⚠ **IT IS READ TO SUPPRESS THE `boundValue` TEST, NOT MERELY TO LABEL THE BINDING.** A stand-in
	// has no SSA value at all, so its `boundValue` is 0 — and 0 is `self`'s own parameter id, the very
	// coincidence `receiverOwnerMask`'s ⚠ block records three measured miscompiles from. Without this
	// bit `Parser.receiverStorageMask` would read a global's write as a write of parameter 0's storage
	// and refuse every call that hands that parameter anywhere: a false rejection with no compile error.
	//
	// False for every binding a `Scope` holds, which is every other constructor here.
	export var namesModuleStorage as bool
	// ⭐ **WAS THIS BINDING EVER MENTIONED? — HALF of E3012's evidence** (`Parser.reportUnusedBindings`).
	//
	// ⚠ **THE OTHER HALF IS NAME-SCOPED, AND IT HAS TO BE.** "Referenced" is a fact about the NAME within the
	// enclosing function, not about the individual binding — MEASURED on the oracle, whose `_referencedVars`
	// is a `HashSet<string>` per function, so two sequential `for i` loops are legal when only the SECOND
	// reads `i`. This bit cannot express that (each loop mints its own `VarInfo`), so the parser also keeps
	// `referencedNames`, the per-function list of names a mention has recorded. The two cannot disagree:
	// `Parser.markBindingReferenced` is the SINGLE writer of both, and it appends the name exactly where it
	// flips this bit. This bit is what makes that append once-per-binding rather than once-per-mention.
	//
	// ⚠ **IT IS A SECOND BIT BESIDE `lastUseToken` RATHER THAN THAT FIELD TESTED AGAINST 0, and the two are
	// NOT the same question.** `attachPendingBorrows` SEEDS a last use ahead of any read — to the activation
	// for a `let`/`var`, to the loop's `end` for a `for … in` element — so a binding that is never read can
	// carry a non-zero `lastUseToken`, and E3012 would then wave through exactly the declarations it exists
	// to catch. The forward-only rule that field is written under is a BORROW's lifetime rule; this bit
	// answers "did the source mention it", and only a real mention sets it.
	//
	// ⭐ **THREE DOORS, BECAUSE A NAME CAN BE MENTIONED IN EXACTLY THREE PLACES THE OTHERS CANNOT SEE** — each
	// measured to matter, and all three routed through `Parser.markBindingReferenced` so the bit and the
	// name list are written together or not at all:
	//
	//   • `Parser.requireBindingLive` — every READ inside the declaring function (a bare reference, a field
	//     read or write through it, a method call on it). The chokepoint that already exists for that
	//     question.
	//   • `Parser.emitCaptureRead` — a CLOSURE BODY reading an enclosing binding. It deliberately does not
	//     route through the first (a capture is not subject to the move guard), and without this bit a
	//     parameter read ONLY inside a closure — `function f(x Integer)` whose body is
	//     `let g = function(n Integer) gives n + x` — is a false rejection.
	//   • `Parser.parseAssignment` — a WRITE, `x = 2`. It must not route through the first either: an
	//     assignment REVIVES a moved-from binding, and the guard would refuse it. MEASURED against the
	//     oracle: `var x = 1` alone is E3012 and `var x = 1` + `x = 2` compiles, so a write counts as a
	//     mention. ⚠ It cannot decide a verdict TODAY — shv2 parameters are immutable
	//     (`ParametersAreMutable`), so assigning one is E2013 before this bit is read — but the rule is the
	//     measured one and this is where it lives when `unused-variables.md` brings locals in.
	export var referenced as bool
	// ⭐⭐ **DID THIS BINDING EVER NEED TO BE WRITABLE? — E3077's evidence** (`Parser.reportVarShouldBeLet`).
	//
	// Set at every door that REQUIRES a binding to be writable and lets the program through: the assignment
	// / field-assignment door (`Parser.requireMutableBinding`), the method RECEIVER door (the dispatchers,
	// where a `let` receiver of a mutating method is E3019) and the call-ARGUMENT door (`parseCallArgs`,
	// where a `let` argument to a mutating parameter is E3019). A `var` none of them ever admitted could
	// have been written `let`, which is precisely what E3077 says.
	//
	// ⚠ **A RECEIVER AND AN ARGUMENT ARE MARKED WITHOUT ASKING WHETHER THE CALLEE ACTUALLY WRITES, and that
	// is the reference rule rather than an approximation shv2 settled for.** Whether a callee mutates its
	// parameter is a WHOLE-PROGRAM fact (`SemanticCheck.checkImmutableArgToMutatingParam` holds it, one
	// phase later); the parser cannot know it at the `end` this diagnostic is decided at. Both reference
	// compilers make the same choice — the bootstrap adds EVERY mutable-var call argument and method
	// receiver to `_reassignedVars`, v1's `markVarReassigned` the same — so being stricter here would make
	// shv2 refuse programs both of them accept. That matters concretely and not academically: `stdlib/` is
	// vetted by the bootstrap alone, so a stricter shv2 would fail to compile the library every program
	// links.
	//
	// ⚠ **IT IS THE DEDUP, NOT THE AUTHORITY.** The verdict is name-scoped for the reason `referenced`'s
	// note gives one door up — a shadowing inner `var x` that IS written must excuse the outer `x`, exactly
	// as both references' per-name sets do — so `Parser.mutabilityExercisedNames` holds the answer and this
	// bit only keeps the append once-per-binding instead of once-per-mention.
	export var mutabilityExercised as bool

	// ⭐⭐ **THIS NAME LIVES IN A HEAP CELL, NOT IN AN SSA VALUE (PBR-2) — the third memory-resident binding
	// kind, beside the self-field alias and the payload binding.**
	//
	// A cell is an 8-byte `__mm_alloc` box holding the binding's CURRENT value. A read is a `loadIndirect`
	// through `boundValue` at offset 0 and a rebind is a `storeIndirect`, so the name aliases no SSA value at
	// all and `boundValue` holds the CELL rather than the contents — which is why every reader of
	// `boundValue` on this path must test this bit first, exactly as the self-field alias made them test
	// `isSelfField`.
	//
	// ⚠ **THE CELL'S ADDRESS IS `boundValue` AND IS STORED ONCE.** It rode a second field (`cellValue`) until
	// the PBR-2 review: one address written down twice, kept equal by nothing but the one constructor that set
	// both. Every writer of `boundValue` — the loop-phi mint, the merge snapshots' restore — would have moved
	// one and left the other, and the two are read by different consumers (the LOAD/STORE took `cellValue`,
	// the drop and the alias scans took `boundValue`), so the divergence would have been a frame writing one
	// box and freeing another. Nothing today reaches a cell binding with those writers, which is an invariant
	// of `declareCellLocal`'s keeping it off `mutableVars` and not a property of this record — so the record
	// holds the address once and cannot express the disagreement.
	//
	// ⭐ **WHY A BINDING WOULD WANT ONE, and both reasons are "another frame must see the writes":**
	//
	//   * it is passed to a parameter some callee REASSIGNS, so the callee is handed the cell and its
	//     `x = 99` lands in this frame's cell (`ProgramSignatures.paramIsByRef`);
	//   * it is captured by a closure AND assigned, so the env slot holds the cell and the closure's read
	//     is two loads deep — capture stays BY VALUE for every binding that is not cell-resident, and that
	//     value is now the cell's address rather than a snapshot.
	//
	// ⚠ **IT IS ALSO WHAT TAKES THE BINDING OUT OF THE PHI-TRACKED CLASS, AND THAT IS LOAD-BEARING RATHER
	// THAN INCIDENTAL.** `assignedBindingsIn` decides a loop's carried vars by scanning tokens for
	// `identifier =`, which cannot see the write a callee performs through a by-reference argument
	// (`bindParameters`' tripwire states the hazard). A cell-resident binding needs no phi: the POINTER is
	// loop-invariant and the value is read out of memory at each use, so the phi the scan cannot mint is one
	// nothing wanted. This is why the design is cells and not a call-site write-back.
	//
	// ⚠ A PARAMETER that is by-reference is cell-resident too, and its cell is the CALLER's — `boundValue` is
	// the incoming parameter value itself. That is the one cell this frame does not own and must not drop.
	export var isCellBinding as bool

	// ⭐⭐ **THE ONE PLACE A `VarInfo` LITERAL IS SPELLED.** Every constructor below names ONLY the fields
	// its binding kind actually differs on; everything else — the whole inert tail, and every per-path bit
	// that starts cleared — comes from a default here.
	//
	// ⚠ **IT IS A DEFENCE, NOT A TIDY-UP.** This record has twenty fields and seven constructors, so the
	// literal was written out six times, and a field given the WRONG default in ONE of them is not a
	// compile error and not a crash — it is a binding that quietly claims to be a parameter, or a payload
	// binding pointing at box 0, in exactly one code path. (The rung that replaced four payload fields had
	// to make the identical six-site edit to add them, which is what put this here.) A new field is now one
	// default and one line, and the kinds that care name it.
	//
	// `ownership`, `movedFrom`, `partiallyMoved`, `payloadSlotVacated`, `lastUseToken`, `referenced` and
	// `mutabilityExercised` take no parameter at all: they are per-path STATE the parser writes as it goes,
	// and every binding starts with them clear. A constructor argument for one of them would be a way to
	// start a binding already moved-from, which nothing means.
	static function make(name ByteArray, varType MaxonType, mutable bool, slot VarSlot = 0, boundValue ValueId = 0, isSelfField bool = false, fieldIndex FieldIndex = 0, isPayloadBinding bool = false, payloadScrutBox ValueId = 0, payloadSlotOffset ByteOffset = 0, payloadStorage MaxonType = NoPayloadStorage, isParameter bool = false, namesModuleStorage bool = false, isCellBinding bool = false) returns VarInfo
		return Self{name: name, varType: varType, mutable: mutable, slot: slot, boundValue: boundValue, ownership: OwnershipKind.trivial, movedFrom: false, partiallyMoved: false, isSelfField: isSelfField, fieldIndex: fieldIndex, isPayloadBinding: isPayloadBinding, payloadScrutBox: payloadScrutBox, payloadSlotOffset: payloadSlotOffset, payloadStorage: payloadStorage, payloadSlotVacated: false, isParameter: isParameter, lastUseToken: 0, namesModuleStorage: namesModuleStorage, referenced: false, mutabilityExercised: false, isCellBinding: isCellBinding}
	end 'make'

	export static function create(name ByteArray, varType MaxonType, mutable bool, slot VarSlot) returns VarInfo
		return Self.make(name, varType: varType, mutable: mutable, slot: slot)
	end 'create'

	// ⭐⭐ **THE E3070 SUBJECT STAND-IN FOR A TOP-LEVEL `var`** — the ONE object a global's name is keyed
	// on, minted and interned by `Parser.topLevelBorrowSubjectOf`.
	//
	// It exists because a global has no `VarInfo` anywhere: `Scope` holds this frame's bindings, and the
	// parser mints a FRESH receiver `VarInfo` at every access to a global (`dispatchOnManagedReceiver`,
	// whose `boundValue` is that access's own load). Keying a subject on those would file one storage
	// under a new object at every mention — the same defect a self-field alias would have had, which
	// `Scope` cures for a local by holding ONE object per name.
	//
	// ⚠ Its `boundValue`/`slot` are 0 and MUST NOT be read: `namesModuleStorage` is what says so, and it
	// is the bit every reader of `boundValue` in the E3070 path tests first.
	export static function createModuleStorageSubject(name ByteArray, varType MaxonType) returns VarInfo
		return Self.make(name, varType: varType, mutable: true, namesModuleStorage: true)
	end 'createModuleStorageSubject'

	// A self-field alias: the name of field `fieldIndex` of the enclosing type, bound at
	// instance-method entry. It materializes NO stack slot and aliases NO SSA value — a read is a
	// `loadIndirect` through the receiver and a write is a `storeIndirect`, so there is nothing for
	// either to hold. `slot`/`boundValue` are 0 and unread, exactly as `slot` is for a value
	// binding.
	//
	// `mutable` is FALSE, and that is not the field's mutability — it is this BINDING's, and the
	// two are different questions with different homes. `count = count + 1` is legal iff the
	// FIELD accepts a write, which is `StructLayout.fieldIsMutable(index)`, the one column
	// `c.count = 1` already asks. A `true` here would be that column copied onto every alias, free
	// to disagree with it; a `false` states the honest fact that no reassignment of the alias
	// itself is ever legal, and leaves the field's own answer where it lives.
	export static function createSelfField(name ByteArray, varType MaxonType, fieldIndex FieldIndex) returns VarInfo
		return Self.make(name, varType: varType, mutable: false, isSelfField: true, fieldIndex: fieldIndex)
	end 'createSelfField'

	// The value binding a MATCH-ARM PAYLOAD gets — `createValueBinding` plus the box coordinates a write
	// back into the scrutinee needs (see `isPayloadBinding`). It is a VALUE binding like every other name
	// the parser installs: the payload is an SSA substitution, and `slot` is 0 and unread.
	//
	// `mutable` is the caller's, and it is a fact about the SCRUTINEE rather than about this name — a
	// payload bound out of a `let` union is read-only however the pattern spells it
	// (`Parser.declarePayloadBindings`).
	export static function createPayloadBinding(name ByteArray, varType MaxonType, mutable bool, boundValue ValueId, scrutBox ValueId, slotOffset ByteOffset, storage MaxonType) returns VarInfo
		return Self.make(name, varType: varType, mutable: mutable, boundValue: boundValue, isPayloadBinding: true, payloadScrutBox: scrutBox, payloadSlotOffset: slotOffset, payloadStorage: storage)
	end 'createPayloadBinding'

	// Construct a value binding for M2's substitution model: `name` aliases the SSA
	// value `boundValue`. No stack slot is materialized (SSA substitution needs
	// none), so `slot` is 0 — a value binding never reads it. The slot-backed
	// constructors above stay the home of the future mutable/mem2reg model.
	export static function createValueBinding(name ByteArray, varType MaxonType, mutable bool, boundValue ValueId) returns VarInfo
		return Self.make(name, varType: varType, mutable: mutable, boundValue: boundValue)
	end 'createValueBinding'

	// The value binding a PARAMETER gets — `createValueBinding` plus the one bit that distinguishes it
	// (`isParameter`). A separate constructor rather than a flag on the shared one because a parameter
	// is bound at exactly ONE site (`Parser.bindParameters`) while `createValueBinding` has many, and a
	// flag would have every one of those callers pass `false` to a question they are not asking.
	//
	// ⚠ `mutable` is still the CALLER's to pass, and deliberately not read from `ParametersAreMutable`
	// here: `bindParameters`'s tripwire panics on the flag it actually passes, and a constructor that
	// re-read the constant would take that flag out of the caller's hands — exactly the defeat that
	// tripwire's comment warns about.
	export static function createParameterBinding(name ByteArray, varType MaxonType, mutable bool, boundValue ValueId) returns VarInfo
		return Self.make(name, varType: varType, mutable: mutable, boundValue: boundValue, isParameter: true)
	end 'createParameterBinding'

	// The value binding a CELL-RESIDENT name gets (PBR-2) — see `isCellBinding` for what a cell is and which
	// two kinds of binding want one.
	//
	// ⭐ **`boundValue` IS THE CELL, NOT THE CONTENTS, AND THAT IS DELIBERATE RATHER THAN A SHORTCUT.** The
	// scope-exit drop (`Parser.emitScopeDrops`), the owned-binding enrolment and the alias scans all key on
	// `boundValue`, and for a cell-resident binding the object this frame owns IS the cell — so pointing
	// `boundValue` at it makes every one of them right by construction, where a `boundValue` holding a stale
	// snapshot of the contents would have each of them acting on a value the binding no longer holds. The
	// contents are never a fact the binding carries; they are read out of memory at each use.
	//
	// `mutable` is the caller's: a LOCAL cell is always a `var` (only a `var` can be rebound or handed to a
	// reassigning parameter), while a by-reference PARAMETER is bound immutable like every other parameter —
	// its rebind is permitted by the cell rank in `requireMutableBinding`, not by this flag. `isParameter`
	// rides for the same reason it does on `createParameterBinding`: it answers "may the container this name
	// denotes be written?", which a by-reference parameter still needs.
	export static function createCellBinding(name ByteArray, varType MaxonType, mutable bool, cell ValueId, isParameter bool) returns VarInfo
		return Self.make(name, varType: varType, mutable: mutable, boundValue: cell, isParameter: isParameter, isCellBinding: true)
	end 'createCellBinding'

	// ⭐ **IS THIS BINDING A LIVE NAME OF `value`?** — the predicate every symbol-table scan over "who else
	// is reading this value" filters on, and it lives on the binding because it is a fact ABOUT one.
	//
	// Two scans ask it and they do opposite things with the answer — `Parser.poisonValueAliases` MARKS every
	// such binding when the value is consumed, `Parser.promiseThreadHasLiveAlias` merely COUNTS whether one
	// exists before re-arming a promise — which is exactly why the predicate itself must be one thing. Written
	// twice, a refinement of what "a live name of a value" means (a second moved-from bit, a scope-depth
	// qualification) lands in one scan and not the other, and NOTHING fails to compile.
	export function isLiveNameOf(value ValueId) returns bool
		return self.boundValue == value and not self.movedFrom
	end 'isLiveNameOf'
end 'VarInfo'

export typealias VarInfoMap = Map with (ByteArray, VarInfo)

// What E3073 needs about one `async <call>` spawn and cannot get anywhere else: the text to quote and the
// place to point at. See `Project.asyncSpawnSites`.
//
// ⚠ **THE POSITION IS THE `async` KEYWORD'S, NOT THE `asyncCall` OP'S.** The op's own range anchors at the
// CALLEE token (`SourceRange.between(anchor, last: rparenTok)`, where the anchor is the callee), which is
// where the other async diagnostics correctly point. E3073 quotes the whole spawn INCLUDING the keyword, so it
// must point at the keyword too, or the caret sits six columns right of the text the message shows. Carrying
// the position here rather than moving the op's range keeps that difference local to this one diagnostic.
export type AsyncSpawnSite
	export let text as ByteArray
	export let line as LineNumber
	export let column as ColumnNumber

	export static function create(text ByteArray, line LineNumber, column ColumnNumber) returns AsyncSpawnSite
		return Self{text: text, line: line, column: column}
	end 'create'
end 'AsyncSpawnSite'

// `asyncCall` op index ⇒ that spawn's quotable text and position. See `Project.asyncSpawnSites`.
export typealias AsyncSpawnSiteMap = Map with (OpIndex, AsyncSpawnSite)

// ⭐⭐ **WHAT THE ACYCLIC BLOCKING GRAPH NEEDS ABOUT ONE `await` AND CANNOT GET AT ITS OWN TIER (SV2).**
// Whether an `await` blocks on a SERVICE — and on which — is `Parser.awaitedPromiseFacts`' answer, and that
// routine resolves the promise through the storage road, the spawn road and a merge PHI. Re-deriving it over
// the merged module would be a second resolver, free to disagree with the first about the one shape it is
// hardest to get right: a re-armed `var` awaited past a merge.
//
// ⇒ the parser records what it already knows, keyed by the `await`/`tryAwait` op it is about, exactly as
// `AsyncSpawnSite` is. The op index is what tells the check which FUNCTION the await sits in, so nothing
// here carries a function name.
export type ServiceAwaitSite
	// The SERVICE whose reply this await blocks on — the `A` in an `A -> B` edge's `B`.
	export let serviceTypeName as ByteArray
	export let line as LineNumber
	export let column as ColumnNumber
	export let declFilePath as FilePath

	export static function create(serviceTypeName ByteArray, line LineNumber, column ColumnNumber, declFilePath FilePath) returns ServiceAwaitSite
		return Self{serviceTypeName: serviceTypeName, line: line, column: column, declFilePath: declFilePath}
	end 'create'
end 'ServiceAwaitSite'

// `await`/`tryAwait` op index ⇒ the service its reply comes from. See `ServiceAwaitSite`.
export typealias ServiceAwaitSiteMap = Map with (OpIndex, ServiceAwaitSite)

// ⭐ `__mm_alloc` call op index ⇒ the mm-trace TAG that box carries. See `Project.allocTagSites`.
export typealias AllocTagSiteMap = Map with (OpIndex, MmTag)

// ⭐ `__ds_name_id` call op index ⇒ the compile-time NAME that call interns. See
// `Project.debugStreamNameSites`.
export typealias DebugStreamNameSiteMap = Map with (OpIndex, ByteArray)

// ⭐⭐ **STD** op index ⇒ the compile-time `element_size@24` stamp of the container that call operates on.
// ⚠ The three maps above are keyed by **MAXON** op indices and are folded by `mergeArtifact`; this one is
// keyed by an index into the **Std** module's `ops` and is never merged. The name says `stdOp` for that
// reason. See `Project.stdOpElementStrides`.
export typealias StdOpElementStrideMap = Map with (OpIndex, ElementStride)

// A list of BINDINGS, held by reference (VarInfo is a heap `type`). Scope keeps the
// bindings a frame displaced in one; the parser keeps its mutable bindings in one.
// Both need the binding OBJECT rather than its name — see Scope's header for why a
// name cannot address a binding a nested block has shadowed.
export typealias VarInfoArray = Array with VarInfo

// ⭐ **WHICH KIND OF DECLARATION AN E3012 CANDIDATE IS — and the only thing that turns on it is the
// INTERFACE WAIVER.** An implementer is forced to declare every parameter its contract names, so an unused
// PARAMETER of a contract-dictated method is waived; a `for` binding inside that same method is the author's
// own and is still refused. MEASURED on the oracle, which draws the identical line structurally — its
// `skipParamCheck` skips the parameter loop and never the locals loop — and reports
// `error E3012: unused variable: 'i'` for an unread `for i in 0 upto limit 'l'` inside an interface-dictated
// `tally`.
export enum UnusedBindingKind
	parameter
	// A `for x in …` element.
	loopVariable
	// ⭐⭐ **A body `var` the author wrote — and a body `let` is DELIBERATELY NOT ONE.**
	//
	// This kind exists because E3077 owes it: `var` locals are that rule's candidate set, and for a
	// candidate nothing mentions the honest sentence is not *"use `let`"* — the fix is to delete it — so it
	// reports E3012 instead. That IS the precedence `specs-shv2/var-should-be-let.md:unused-takes-precedence`
	// pins, and it is the whole of why a `var` local is checked here.
	//
	// ✅ **THE UNUSED-`let` HALF LANDED (user ruling, 2026-08-19), and the blocker written here was wrong
	// on BOTH of its claims.** It said admitting body `let`s costs 82 cases in EXPRESSIVENESS, because a
	// leak gate binds an owned value and deliberately never touches it, and because "adding a mention moves
	// the drop, so the test silently stops testing the drop". MEASURED at the IR, both are false:
	//
	//   • **A mention does not move the drop.** For the one shape that HAS a drop — a heap-allocated
	//     managed value, e.g. an interpolated `String` — the IR with `print(s)` added is byte-identical to
	//     the IR without it except for the two inserted instructions of the call. `__str_decref` stays the
	//     last thing in the block, in the same position. Reading a value does not re-home its drop.
	//   • **The named exemplars had no drop to move.** `block-scope-drops.owned-struct-in-block` emits NO
	//     `__mm_alloc` and NO decref at all on shv2 — the struct is a STACK SLOT — and a `String` bound from
	//     a literal is `.rdata` and immortal. Those cases were already inert as drop gates, which is the
	//     `spec-can-pass-without-testing-its-subject` shape, not an expressiveness cost.
	//
	// ⇒ The cases that DID trip the rule were rewritten to read their binding, because **the binding not
	// being read was never the test**. `specs-shv2/unused-variables.md` carries the rule.
	mutableLocal
	// ⭐ **A body `let` the author wrote.** Enrolled at the same door as `mutableLocal` above and exempt on
	// the same `_` discard; it is a separate KIND only because E3077 (`var` should be `let`) must never
	// speak about one — that rule's filter is `binding.mutable`, which a `let` fails, so the split costs no
	// test there.
	immutableLocal
	// ⭐ **THE OPTIONAL `(e)` OF A DIVERGENT `otherwise` — `otherwise (e) panic("…")` /
	// `otherwise (e) throws E.case`, AND NOTHING ELSE.** It is checked where a body `let` deliberately is
	// not, and the difference is that this binding is OPTIONAL: an author who declares one and never reads it
	// wrote the parentheses for nothing, which is a different sentence from the general unused-`let` rule the
	// kind above defers. `/specs/try-block-otherwise-divergent.md` states the rule for exactly this binding.
	//
	// ⚠⚠ **THE NAME IS THIS NARROW ON PURPOSE — IT IS ONE OF FOUR DOORS THAT DECLARE A CAUGHT ERROR, AND THE
	// OTHER THREE ARE NOT CHECKED.** `otherwise (e) 'h' … end 'h'` (block form and single-call alike) and a
	// catching `if`'s `else (e) 'err'` all bind one and all still accept it unread, which the ORACLE also
	// does. A name like `caughtError` would read as a class and make the gap look like an oversight for
	// someone to "finish" — widening the enrolment to `declareCaughtError` would newly refuse programs the
	// oracle accepts, which is a rung and not a tidy-up.
	//
	// ⚠ It is never `mutable`, so E3077's scan over this same list skips it without needing a kind test —
	// the filter there is `binding.mutable`, and a caught error is bound immutably at every catching door.
	divergentHandlerBinding
end 'UnusedBindingKind'

// ⭐ **ONE DECLARATION THE UNUSED CHECK (E3012) MUST ACCOUNT FOR** — paired with the span of the NAME the
// author wrote, which is where the diagnostic lands.
//
// It holds the `VarInfo` itself rather than the name, because one half of the verdict is
// `binding.referenced`, a bit written LATER (at every mention door) through the same heap object; a name
// copied here would have to be looked up again in a `Scope` an inner block may since have shadowed — and the
// shadow is a different declaration with its own answer.
//
// The RANGE rides here and not on `VarInfo` because only these binding kinds are candidates: a self-field
// alias, a payload binding, the destructuring temp and the module-storage stand-in all construct a
// `VarInfo` and none of them is checked, so a declaration span on the record would be a column most
// constructors fill with nothing.
//
// ⭐ **E3077 WALKS THIS SAME LIST** (`Parser.reportVarShouldBeLet`), and that is the shape that makes the
// precedence between the two rules structural rather than stated: "an unused `var` reports as UNUSED, not
// as should-be-let" is one list scanned twice in a fixed order, not two lists that could disagree about
// which declarations exist.
export type UnusedBindingCandidate
	export let binding as VarInfo
	export let nameRange as SourceRange
	export let kind as UnusedBindingKind

	export static function create(binding VarInfo, nameRange SourceRange, kind UnusedBindingKind) returns UnusedBindingCandidate
		return Self{binding: binding, nameRange: nameRange, kind: kind}
	end 'create'
end 'UnusedBindingCandidate'

export typealias UnusedBindingCandidateArray = Array with UnusedBindingCandidate

// --- Ranged typealiases ---
//
// `typealias Score = int(0 to 100)` — the declaration form nearly every real Maxon
// file opens with, and the reason `int` is almost never written bare in a type
// position. A DECLARATION, not an op: it contributes a registry entry, and
// TypeResolution collapses every `MaxonType.named(Score)` to the primitive below.
//
// TWO ALIASES OVER THE SAME RANGE ARE THE SAME TYPE — an alias creates no nominal
// distinction, so resolution needs only `underlying`. The BOUNDS are carried anyway
// because they ARE the alias's definition: they are what a narrowing conversion is
// checked against (the runtime range check — a later milestone), and a registry that
// forgot them would force that milestone to re-parse the declaration. This milestone
// emits no range check, so nothing reads them yet.
//
// `low`/`high` are INCLUSIVE and stored as the raw 64-bit pattern `ParsedInt` holds:
// `upto` (an exclusive upper bound) is normalized to `high - 1` at parse time so the
// registry has ONE representation, and an unsigned-domain bound such as `u64.max`
// rides as the signed value with the same bits (which is exactly how a cast against
// it must compare — see specs/ranged-typealias.md's sentinel case).
export type RangedTypeAlias
	export var name as ByteArray
	// The primitive the alias resolves to — the `int` / `float` keyword it was
	// declared over. What TypeResolution substitutes for `named(alias)`.
	export var underlying as MaxonType
	export var low as ParsedInt
	export var high as ParsedInt
	// WHERE it was declared. The file makes resolution file-scoped (`rangedAliasKeys` — a use resolves
	// to its OWN file's alias before anyone else's), and the name's position anchors the E3061 a
	// same-file redeclaration raises, exactly as `FuncSignatureEntry` carries both for E3006.
	//
	// ⚠ The position must be the alias NAME's, not the `typealias` keyword's: E3061 blames the
	// redeclaration the user wrote, and the reference compiler anchors on the name (`…:3:11` for
	// `typealias Score`, column 11 being the `S`).
	export var declFilePath as FilePath
	export var nameLine as LineNumber
	export var nameColumn as ColumnNumber
	// ⭐ **WHO MAY NAME IT (P1.9)** — `file` for a plain `typealias`, `module` for an `export typealias`,
	// and `global` for one the compiler supplies on the stdlib's behalf. It is what
	// `visibleFrom` resolves by, and it exists because the corpus requires a
	// non-exported alias to be UNNAMEABLE from another file
	// (`export-keyword/error.non-exported-typealias-cross-file`) while a stdlib-internal one stays
	// nameable everywhere (`ranged-typealias/cast-to-stdlib-internal-typealias`). Those two pull in
	// opposite directions only if "stdlib" is an exception; as a third TIER they are one rule.
	export var visibility as Visibility

	export static function create(name ByteArray, underlying MaxonType, low ParsedInt, high ParsedInt, visibility Visibility, declFilePath FilePath, nameLine LineNumber, nameColumn ColumnNumber) returns RangedTypeAlias
		return Self{name: name, underlying: underlying, low: low, high: high, visibility: visibility, declFilePath: declFilePath, nameLine: nameLine, nameColumn: nameColumn}
	end 'create'
end 'RangedTypeAlias'

// The `<declaring file>|<type name>` keys of every declaration a collision was reported for — see
// `Project.collidedTypeNames`.
export typealias CollidedTypeNameSet = Set with ByteArray

export typealias RangedTypeAliasArray = Array with RangedTypeAlias

// Registry: typealias name -> its declaration. Populated by `mergeArtifact` from each
// file's artifact (alongside `funcReturnTypes` / `funcSignatures`); read by
// TypeResolution to collapse `MaxonType.named` to a primitive.
export typealias RangedTypeAliasMap = Map with (ByteArray, RangedTypeAlias)

// ONE contested name's declarations, keyed by the path of the file that declared each — what a
// file-scoped lookup probes with the READER's path to find the reader's own.
//
// ⚠ Keyed by the path STRING and deliberately NOT by `FilePath`: `FilePath.hash` is case-folding on
// Windows (`canonicalForCompare` CLONES and lower-cases), so a `Map with (FilePath, V)` ALLOCATES A
// STRING PER PROBE — which is the entire cost this structure exists to remove. `FilePath.equals`
// allocates two. The String key also keeps ONE notion of "the same file" between this map and
// `record`'s same-file test, which must agree or a redeclaration is missed.
typealias RangedAliasByDeclaringFile = Map with (String, RangedTypeAlias)

// ⭐ THE ONE EMPTY `RangedAliasByDeclaringFile` every uncontested name answers with — so
// `RangedAliasRegistry.contestedDeclarations` costs one map probe and NO allocation for the names that
// are not contested, which is nearly every name in any program. NEVER mutated: its only reader iterates.
let sharedEmptyContestedDeclarations = RangedAliasByDeclaringFile.create()

// One name ⇒ the WIDEST storage width any file's declaration of it needs — the file-INDEPENDENT half of
// this registry, maintained by `record` alongside `multiplyDeclared`. See `storageBytesInEveryFile` for
// why the answer must be a fold over every declaration rather than a probe of one.
typealias AliasStorageBytesMap = Map with (ByteArray, ByteOffset)

// One name ⇒ the WIDEST sub-byte packed width any file's declaration of it needs, or `NotSubBytePacked` if
// any of them is a byte or wider. The map above's twin, folded by the same single writer in the same call,
// because they answer one question — "how much room does this name's element need?" — on either side of the
// byte boundary. See `packedBitsInEveryFile` for why the fold is a MAX and why a byte beats every packed
// width.
typealias AliasPackedBitsMap = Map with (ByteArray, PackedBitWidth)

// The names more than one FILE declares -> every declaration of each, by declaring file. Empty for
// a program where no name is declared twice, which is nearly every program — see `RangedAliasRegistry`.
typealias MultiplyDeclaredAliasMap = Map with (ByteArray, RangedAliasByDeclaringFile)

// Every name AT LEAST ONE declaration made nameable from any file — an `export`ed alias, or a
// compiler-supplied stdlib one — mapped to the LAST such declaration. See
// `RangedAliasRegistry.nameableFromAnyFile` for the membership question and `lookup` for the
// declaration, which is what a file that declares none of a contested name's declarations resolves to.
//
// ⚠ It holds the DECLARATION and not merely the name because one index has to answer both, and the two
// answers are the same fact: "some declaration of this name may be written down anywhere" and "here is
// one that may". A parallel name-only set beside it would be the same fact filed twice, which is the
// shape every cross-file alias defect in this file has had.
typealias NameableAliasMap = Map with (ByteArray, RangedTypeAlias)

// The names whose declarations disagree about the RANGE -> every distinct range-qualified spelling of each
// (N2). A strict SUBSET of `MultiplyDeclaredAliasMap`'s keys, and EMPTY for every program in the corpus —
// see `RangedAliasRegistry.settleRangeContests` for why that emptiness is what keeps every element name,
// every mangled symbol and every committed golden where it was.
typealias RangeContestedAliasMap = Map with (ByteArray, ByteArrayArray)

// ⭐ THE ONE EMPTY contest map every registry is born holding — so a program with no contest, which is every
// program in the corpus, allocates NO index for a question whose answer is "none". Measured: a real map per
// registry cost a FLAT ~432 allocations per compile in `phase:load`, paid by every build. Copy-on-write off
// this handle at the single writer (`settleRangeContests`); NEVER mutated.
let sharedEmptyRangeContests = RangeContestedAliasMap.create()

// What ONE `typealias` declaration conflicted with when it was filed — `RangedAliasRegistry.record`'s
// answer, and the ONLY thing that decides whether E3105 is raised.
//
// ⚠ **IT DOES NOT ANSWER "IS THIS NAME ALREADY DECLARED?"** — `TypeNameRegistry` does, for every
// declaration kind at once, and a duplicate typealias is reported from there. This registry knows
// only about ranged aliases, so it could never have decided a `type`/`typealias` pair, and two
// structures answering the same question for overlapping inputs is how they come to disagree.
//
// It is a separate union from `DeclaredAlias` rather than a case added to it because the two answer
// different questions: `DeclaredAlias` is what a LOOKUP found, asked once per named type reference,
// while this is what a WRITE conflicted with, asked once per declaration. Folding them would put a
// record-only case in front of every `aliasOf` caller's `match`.
export union AliasRecordOutcome
	// Nothing to report: the range is this declaration's own business, and a cross-file pair over two
	// RANGES is exactly what file scoping exists to serve (`specs/duplicate-typealias.md`).
	accepted
	// Two FILES declare one name over DIFFERENT underlying primitives — E3105. See `record`. It
	// carries the incumbent, because the reporter blames the NEWCOMER — its own file, its own name
	// token — and names what the incumbent was declared over.
	conflictingUnderlying(prior RangedTypeAlias)
end 'AliasRecordOutcome'

// ⭐ **THE RANGED-ALIAS REGISTRY — file-scoped resolution, and why a bare map was a wrong ANSWER.**
//
// A non-exported `typealias` is FILE-LOCAL (`specs/duplicate-typealias.md`), so two files may each
// declare `Limit` over a different range and neither disturbs the other. Filed under the bare name
// alone — which is what this was — the LAST file merged simply won, and its range silently replaced
// everyone else's: `600 as Limit` compiled clean in a file whose own `Limit` is `int(0 to 500)`
// because another file declared a wider one. Not a missing feature; a wrong answer, and an
// order-dependent one, since the stdlib loader deliberately does not sort.
//
// ⚠ **IT IS ALREADY LOAD-BEARING FOR `stdlib/`.** SEVEN files declare `Byte = int(0 to u8.max)`
// privately (Character, Console, File, `helpers/string/views`, Json, String, Subprocess) and agree —
// nine names in all are declared by more than one file — but `stdlib/helpers/string/` holds a pair
// that does NOT:
// `utf16.maxon` declares `Utf16UnitCount = int(1 to 2)` and `views.maxon` the same name as
// `int(0 to u64.max)`. Under one bare map, whichever merged last decided both files' range checks.
//
// **SCOPED FIRST, BARE SECOND** — the identical rule top-level `let`/`var` bindings resolve by
// (`ProgramSignatures.declFor`).
//
// ⚠ **BUT NOT BY `declFor`'s MECHANISM, and the divergence is MEASURED.** `declFor` files and probes
// a composite `fileScopedDeclKey` STRING (`"<path>|<name>"`), which allocates ~4 objects per probe.
// That is affordable there and was NOT affordable here: this is asked once per named type reference,
// and a name that several files declare would pay it on every USE. Measured on a program that uses a
// two-file alias N times (N = 100…800, one worktree, path length held constant): the composite-key
// form cost **24 allocations and 2,224 bytes per use**, linear in uses and invisible to
// `scale-test`, whose generated corpus gives every alias a unique name so no name is ever contested.
// `stdlib/` is not so kind — SEVEN files declare `Byte`, three declare `ByteCount` — so the cost
// arrives in full the day ALL of `stdlib/` loads. A two-level map answers the same question with
// no key to build: the probe that decides a name is contested IS the probe that holds the answer.
//
// ⚠ **AND NOT ITS VISIBILITY CONDITION EITHER, which stays a deliberate divergence even now that
// visibility IS load-bearing (P1.9).** `topLevelStorageKey` files a FILE-PRIVATE binding under the
// scoped key and an exported one under the bare name, so visibility is a property of the KEY. An alias
// may not be filed that way: `cast-to-stdlib-internal-typealias` requires a stdlib alias to be nameable
// "from any file, regardless of its source-level visibility modifier", so a NON-EXPORTED declaration
// still has to be reachable through the bare door — for the stdlib, and (below) for a name several
// files declare where only one exports it. So EVERY alias reaches `byName` whatever it wrote, and
// visibility is applied at the READ (`visibleFrom`), not at the write.
//
// ⭐ That placement is what lets the two requirements be ONE rule rather than a rule and an exception:
// a stdlib-supplied alias is `Visibility.global`, so the read-side test has no stdlib case in it at
// all — and no path probing, which is what v1 does here and what its own surveyor calls
// "fragile/environment-coupled" (`StdlibLoader.findStdlibPath`).
//
// **OUT OF SCOPE, deliberately** (coordinator ruling): when a name is declared in several OTHER
// files and MORE THAN ONE of them is nameable from the reader, the answer is still last-wins among
// those. That is the E3063 ambiguity case, and reporting it needs cross-file name resolution — the same
// rung that gives `export` its meaning as a key. What is NOT out of scope, and is fixed, is a candidate
// the reader may not name at all deciding the answer: see `lookup`.
// ⭐⭐ **THE ALIASES THE COMPILER SUPPLIES ON THE STDLIB'S BEHALF.** Each is declared, verbatim, in a
// `stdlib/` module shv2 cannot compile — `Character.maxon` because it also declares `type Character`, a
// name the compiler owns; `Array.maxon` because `Array` is a synthesized builtin — so the alias exists in
// the LANGUAGE and in no registry a reader can probe. Seeded, it exists in both.
//
// They are ordinary `record`ed declarations of ordinary files, not carve-outs: a user's own
// `typealias Codepoint = int(0 to 10)` simply contests one (`multiplyDeclared` files both, the user's file
// resolves to the user's bounds), and the DECL PATH is the module the line really comes from, so a
// diagnostic that ever prints it points at the truth. No file shv2 LOADS carries these paths, so neither
// can collide with a reader's own path.
//
// ⭐ Their visibility is `global`, and that is what `cast-to-stdlib-internal-typealias` needs: a
// stdlib-internal alias is nameable from any file "regardless of its source-level visibility modifier"
// (the spec), and `ElementCount` is declared without `export` in `stdlib/Array.maxon`. Stating it as a
// TIER rather than as an exception is what keeps `visibleFrom` free of a special case.

// `stdlib/Character.maxon`'s `export typealias Codepoint = int(0 to 1114111)`, transcribed — the highest
// Unicode scalar value, which is what makes the upper bound this number and not a round one.
let CodepointAliasLow = 0 as ParsedInt
let CodepointAliasHigh = 1114111 as ParsedInt
let CodepointAliasDeclPath = "stdlib/Character.maxon"

// `stdlib/Array.maxon:11`'s `typealias ElementCount = int(0 to u64.max)`, transcribed — the count and
// index domain of the public collection API, which user code has to be able to name in an `as` cast.
// The upper bound is the full unsigned span, which rides as the wrapped -1 exactly as a parsed
// `u64.max` bound does (`RangedTypeAlias`).
let ElementCountAliasLow = 0 as ParsedInt
let ElementCountAliasHigh = U64MaxBound
let ElementCountAliasName = b"ElementCount"
let ElementCountAliasDeclPath = "stdlib/Array.maxon"

// ⭐ **`stdlib/String.maxon:12-13`'s `export typealias GraphemeCount = int(0 to u64.max)` and
// `export typealias BytePos = int(0 to u64.max)`, transcribed (BATCH2 slice 6).** They arrive by exactly the
// route `Codepoint` did and for the identical reason: they are declared in a module shv2 can never LOAD,
// because it also declares `type String` and `String` is a name this compiler owns. So the aliases exist in
// the LANGUAGE and in no registry a reader can probe — and `stdlib/helpers/string/{utf8,hash,grapheme}.maxon`
// spell every byte position and every cluster count with them, which without this is `E3011 Unknown type
// 'BytePos'` twenty-two times over.
//
// ⚠ They share ONE range because the corpus gives them one — a byte position and a cluster count both span
// the full unsigned domain there — so the bounds are a single pair of constants rather than two identical
// pairs free to drift apart. It rides as the wrapped -1 exactly as `ElementCount`'s does.
//
// ⚠ `ByteCount`, the third alias those files' header comments name, is deliberately NOT seeded: it is
// mentioned in a COMMENT in each of them and spelled in no signature (checked at the source). Vocabulary
// does not ship ahead of its consumer, and the day one arrives it is one line here.
let StringPositionAliasLow = 0 as ParsedInt
let StringPositionAliasHigh = U64MaxBound
let BytePosAliasName = b"BytePos"
let GraphemeCountAliasName = b"GraphemeCount"
let StringPositionAliasDeclPath = "stdlib/String.maxon"

// ⭐⭐ **THE DECLARING FILES OF THE ALIASES THE COMPILER SUPPLIES ON THE STDLIB'S BEHALF — the files the
// SWEEP NEVER VISITS (N1c).** `RangedAliasRegistry.create` seeds `Codepoint` and `ElementCount` as
// declarations of two real `stdlib/` modules, but it SUPPLIES them rather than parsing them, so
// `Queries.foldOneFileInto` never stamps their module directory and every index keyed on a declaring path
// has a hole exactly where a seed is.
//
// ⛔ **MEASURED, and it surfaced as a PANIC rather than a wrong answer.** The first reader to ask a
// declaring-path question of a seed (`ProgramSignatures.ambiguousAliasCandidates`, which has to know
// whether a candidate is a library layer's) took `moduleDirectoryOf` straight into its "reached a
// visibility question without ever having been swept" panic — on three tests whose only sin is mentioning
// `Codepoint`. **That panic is correct and stays**; what was missing is the stamp, and stamping it in the
// one constructor closes the hole for every future reader rather than for this one caller.
//
// Listed here, beside the seeds themselves, so a third seed cannot be added without this list.
export function seededStdlibAliasDeclFiles() returns FilePathArray
	var files = FilePathArray.create()
	files.push(seedDeclFile(CodepointAliasDeclPath))
	files.push(seedDeclFile(ElementCountAliasDeclPath))
	// ONE entry for the two `stdlib/String.maxon` seeds — this list is of FILES, and both come from that one
	// file. Pushing the same path twice would stamp the same module directory twice.
	files.push(seedDeclFile(StringPositionAliasDeclPath))
	return files
end 'seededStdlibAliasDeclFiles'

// ⭐ **THE MODULE DIRECTORY A SEED'S DECLARING FILE SITS IN — DERIVED from the path, and SELF-CHECKING.**
// It refuses a seed that is not directly under `stdlib/`, because such a seed would stop being the library
// layer: `isStdlibModuleDirectory` would answer `false` for it and a compiler-supplied declaration would
// start COMPETING with a user's declaration of the same name instead of being shadowed by it. Deriving
// beats asserting `StdlibDirName` beside each path, which would be the same fact written twice.
export function seededStdlibAliasModuleDirectory(declPath FilePath) returns String
	let parent = try declPath.parent() otherwise panic("seededStdlibAliasModuleDirectory: seed path '{declPath.toString()}' has no parent directory — a seed's path is `stdlib/<file>.maxon` and names one by construction")
	let directory = parent.toString().replace(WindowsPathSeparatorText, with: ModuleDirectorySeparator)
	if not directory.equals(StdlibDirName) 'notTheLibraryLayer'
		panic("seededStdlibAliasModuleDirectory: seed path '{declPath.toString()}' derives module directory '{directory}', not '{StdlibDirName}' — a compiler-supplied alias outside the library layer would COMPETE with a user declaration of its name instead of being shadowed by it (see `isStdlibModuleDirectory`)")
	end 'notTheLibraryLayer'

	return directory
end 'seededStdlibAliasModuleDirectory'

// The `FilePath` behind one seed's literal path text — shared by the seed itself and by the declaring-file
// list above, so the alias and its module-directory stamp can never be built from two different paths.
function seedDeclFile(pathText String) returns FilePath
	return try FilePath.from(pathText) otherwise panic("seedDeclFile: '{pathText}' is a literal relative path with no invalid character in it")
end 'seedDeclFile'

// ⭐ **A RANGED INT ALIAS THE COMPILER SUPPLIES RATHER THAN A FILE — built HERE for every one of them
// (X6 review).** The two callers differ in exactly one thing, the DECLARING FILE (a seed names a stdlib
// path it stands in for; the `ExitCode` builtin names its READER's own — see each for why), and agree on
// everything else: `integer`, `global`, and positions 0.
//
// Positions are 0 because there is no source line in THIS program to blame, and the only diagnostics that
// read them (E3061 same-file redeclaration, E3105 cross-file primitive conflict) cannot fire against one —
// a user redeclaring the name is in a different file, and over `int`, which is a compiler-supplied alias's
// primitive too. That argument covers BOTH callers, which is why it is stated once, here.
function compilerSuppliedIntAlias(name ByteArray, low ParsedInt, high ParsedInt, declFilePath FilePath) returns RangedTypeAlias
	return RangedTypeAlias.create(name, underlying: MaxonType.integer, low: low, high: high, visibility: Visibility.global, declFilePath: declFilePath, nameLine: 0, nameColumn: 0)
end 'compilerSuppliedIntAlias'

// One stdlib seed — an alias the compiler supplies ON A STDLIB FILE'S BEHALF, so it carries that file's
// path (`seededStdlibAliasDeclFiles` patches the sweep for exactly these).
function builtinStdlibAlias(name ByteArray, low ParsedInt, high ParsedInt, declPathText String) returns RangedTypeAlias
	// Bound to a local rather than written inline as the argument: the bootstrap mislowers a
	// `try … otherwise panic(…)` in argument position (E9001, "not in valueMap" against the pin temp).
	let declPath = seedDeclFile(declPathText)

	return compilerSuppliedIntAlias(name, low: low, high: high, declFilePath: declPath)
end 'builtinStdlibAlias'

// ⭐⭐ **THE BUILTIN `ExitCode`'S RANGE, WRITTEN AS DATA (X6).** `ExitCode` is a NARROW DECLARED TYPE, and
// until X6 the values it admits existed nowhere a check could read them: they were a SENTENCE, in
// `Parser.valueIsUnsigned`'s header ("`exitCode` — `int(0 to u32.max)`"), beside a width chosen three
// tiers down.
//
// ⛔ **MEASURED, and the two targets did not even agree on the wrong answer.** `function negOne()
// returns ExitCode  return -1` compiled clean and printed **-1 on x64-windows** and **4294967295 on
// wasm32-wasi**, because the two disagree about how wide a register holding a `u32` is and neither was
// ever asked to hold a value the type admits. The DISAGREEMENT was the symptom; the missing check was
// the defect. (Widening wasm's `u32` to an i64 valtype would have made the two agree and left every
// out-of-range value silently accepted on both — the declared type made a lie about its own
// representation. It was considered and rejected.)
//
// It is the SAME defect `RangedAliasRegistry.create`'s `Codepoint` seed closed for a name shv2 could not
// load — *"`insertRangeChecks` guards a RETURN through a ranged alias and can only find a range a
// registry holds"* — arriving at the one narrow type the compiler declares for itself.
//
// ⭐⭐ **AND X6 WROTE DOWN ONE PLATFORM'S ANSWER (BATCH27).** `u32.max` is WINDOWS'.
// `stdlib/Process.maxon:7-16` declares the type under `#if os(Windows)` and gives every other OS
// `int(0 to 255)`: a POSIX exit status is a byte, and WASI shares that bound because
// `wasi:cli/exit.exit-with-code` takes a `u8` — v1 states it where it emits the call
// (`maxon-selfhosted/Targets/Wasm/MirToWasm.maxon:2675-2684`: *"wasmtime masks to the low 8 bits, so the
// maxon ExitCode (0..255) round-trips"*). ⛔ **MEASURED against the single bound this held before:
// `return 4294967295 as ExitCode` compiled clean for wasm32-wasi and the process exited 255.** The
// program declared one number, the OS got another, and no diagnostic named the difference.
//
// ⭐ **THIS IS A MIRROR OF A DECLARATION, NOT A SECOND AUTHORITY — and it retires without being edited.**
// `stdlib/Process.maxon` is not on shv2's stdlib whitelist (it is blocked on
// `__Builtins.executablePath`, and on declaring `ExitCode`, a name this compiler owns), so there is no
// loaded file to read the bound out of and the mirror is the only copy that can exist today. The builtin
// is the LAST arm of `lookup`, BELOW every declaration — so on the day that module is listed, its
// `typealias` answers and this stops being consulted.
//
// ⭐ **THE BOUND IS RESOLVED WHERE THE TARGET IS KNOWN — AT REGISTRY CONSTRUCTION.** `lookup` holds no
// project and no target; `Project` holds one, and its own header states the licence: a project *"is
// aimed once and never re-aimed — two targets are two `Project`s"*. The bootstrap oracle reached the
// same conclusion from the other end and paid for it first: `maxon-sharp/Compiler/0-Compiler.cs:1266-1281`
// keys its parsed-stdlib cache BY TARGET because *"a single shared module would bake the BUILD MACHINE's
// OS into a cross-compiled binary's stdlib"*, and its `#if os(...)` resolves against an injected target
// OS rather than the host (`2-Parser.cs:25883-25896`); `TargetRunHost.cs:48-56` records the host-baked
// version as a real bug it had to fix.
//
// ⛔⛔ **THE RANGE NARROWS; THE SLOT DOES NOT — AND THE ORACLE DIVERGES HERE, DELIBERATELY.**
// `maxon-sharp/Compiler/StdlibTargetSelfTest.cs:31-159` is a machine-checked self-test asserting that
// `main`'s IR return type is `u32` on Windows and **`u8`** on macOS/Linux: in the oracle the WIDTH follows
// the range. shv2 must not copy that, and `A1f` is the reason. The oracle guards at the COERCION POINT,
// at full width, BEFORE the truncation (`2-Parser.cs:16909-16911` → `ValidateAndEmitRangeCheck`
// `:19977-20029`), so a narrow slot costs it nothing. shv2 puts the runtime half of the call-argument
// door at the CALLEE'S ENTRY instead — one guard covering every call site, direct, indirect and witness
// alike (`IR/Std/InsertRangeChecks.maxon:385-397`) — and an entry guard reads the value out of the SLOT,
// after the ABI has already narrowed it. ⇒ **the slot must be WIDER than the range or the guard cannot
// see the truncation that already happened.** With a `u8` slot on wasm, `takes(opaque(0) - 5)` arrives as
// 251, which is INSIDE `0 to 255`; the guard would pass and the wrong answer would be silent again.
// (MEASURED, with a `typealias Wide = int(0 to 100000)` standing in for the type: range < slot panics at
// the entry on wasm32-wasi, which is exactly the mechanism this bound switches on.)
//
// ⇒ `valueTagToStdType` keeps `ExitCode` at `StdType.u32` and `primitiveTypeByteSize(exitCode)` keeps 4,
// on EVERY target, and neither may start to derive from the bounds below. A guard narrower than its slot
// is what every ranged alias in the language already is — `int(0 to 100)` rides an i64, and `lookup`'s
// header spells that argument out in full.
let ExitCodeAliasLow = 0 as ParsedInt

// The byte-sized POSIX status shared by Linux, macOS and WASI — the `#else` arm of the declaration
// mirrored above.
let PosixExitCodeAliasHigh = 255 as ParsedInt

// The platform shape, spelled ONCE. A `match` over `Os` rather than a "Windows or not" test, for
// `cpuCanonicalName`'s reason: a fifth OS must be unable to arrive without an arm being written here,
// where an `else` would quietly hand it Windows' bound or POSIX's.
function exitCodeAliasHigh(os Os) returns ParsedInt
	return match os 'os'
		windows gives U32MaxBound
		linux gives PosixExitCodeAliasHigh
		macos gives PosixExitCodeAliasHigh
		wasi gives PosixExitCodeAliasHigh
	end 'os'
end 'exitCodeAliasHigh'

// ⭐ **THE RANGE MUST FIT THE SLOT, AND THIS IS THE CHECK BETWEEN THE TWO COPIES.**
// `primitiveTypeByteSize(exitCode)` is the slot's width written in the layout's vocabulary, and nothing
// derives it from the bound above — so what keeps the two together is that a change to either is caught
// HERE rather than surfacing as a guard admitting values the storage cannot hold. Asked once per registry
// construction, every one of which is on a cold path.
//
// ⚠ **ITS SUBJECT CHANGED WITH THE BOUND (BATCH27): it demanded EQUALITY, and equality was only ever true
// because the range was Windows'.** On a POSIX target `0 to 255` needs ONE byte against a four-byte slot,
// and that inequality is the mechanism rather than a tolerance it has to forgive — the entry guard above
// can only separate a truncated value from an honest one while range < slot. (Equality is precisely the
// condition under which the two are the same bits, which is why Windows cannot separate them and does not
// need to: at u32 width nothing truncates on the way in.) What remains an error, and is what is tested, is
// a range the slot CANNOT hold — a guard admitting values that would be silently cut down on every store.
function requireExitCodeRangeFitsItsWidth(high ParsedInt)
	let rangeBytes = rangedAliasStorageBytes(ExitCodeAliasLow, high: high)
	let widthBytes = primitiveTypeByteSize(ValueTypeTag.exitCode)
	if rangeBytes > widthBytes 'rangeOutgrowsItsWidth'
		panic("requireExitCodeRangeFitsItsWidth: the builtin `ExitCode` range 0 to {high} needs a {rangeBytes}-byte slot but `primitiveTypeByteSize` gives the tag {widthBytes} — a range wider than its own storage guards nothing, because every value it admits is truncated on the way in")
	end 'rangeOutgrowsItsWidth'
end 'requireExitCodeRangeFitsItsWidth'

// ⭐ **THE BUILTIN ALIAS ITSELF — built from the caller's own name and the caller's own file.**
//
// The NAME is the one `lookup` was asked about rather than a fresh `b"ExitCode"`, because
// `builtinTypeNameTag` has already answered that the two are the same bytes and `ExitCodeBuiltinName` is
// FILE-PRIVATE to `TypeResolution` on purpose — its header says so outright: *"Nothing outside this file
// names the constant now; the doors ask the table."* Spelling it here would be the third hand-written
// copy that header exists to prevent.
//
// ⚠ **THE DECLARING FILE IS THE READER'S OWN, and that is the honest answer rather than a filler.** A
// builtin is declared in NO file and nameable from EVERY one, so the reader's path is the path at which
// it is in scope — which makes `isVisibleFrom` answer `true` at every tier, not merely at the `global`
// one it also carries. Two consequences, and both are the point: `everyDeclarationHidden` can never
// report E2003 against a builtin however `Visibility` grows a fourth case, and no reader of
// `alias.declFilePath` is ever handed a path the sweep did not visit — which is exactly the hole
// `seededStdlibAliasDeclFiles` exists to patch for the two aliases the compiler supplies on the
// STDLIB's behalf, and which a builtin therefore never opens.
//
// ⚠ **THE HIGH BOUND IS PASSED IN, not read from a constant, because it is the TARGET's** — see the seed
// above. It is the registry's, resolved once when the registry was built, so every lookup in one compile
// answers with one platform's range by construction rather than by every caller remembering to ask.
function builtinExitCodeAlias(name ByteArray, readerFilePath FilePath, high ParsedInt) returns RangedTypeAlias
	return compilerSuppliedIntAlias(name, low: ExitCodeAliasLow, high: high, declFilePath: readerFilePath)
end 'builtinExitCodeAlias'

// ⭐ **MAY `readerFilePath` NAME THIS DECLARATION (P1.9)?** Three tiers, no exceptions:
//
//   • its OWN declaring file always may — visibility governs who ELSE may see a declaration, never
//     whether the declaration is in scope where it was written;
//   • an `export`ed (`module`) or compiler-supplied stdlib (`global`) alias may be named anywhere;
//   • a plain `typealias` may not be named from another file.
//
// ⚠ **IT IS A SEPARATE QUESTION FROM `lookup`, AND NOT FOLDED INTO IT, because the two answers are
// wanted apart.** A hidden alias is still FOUND — that is exactly what tells "no declaration binds
// this name anywhere" (E3011, at the `as`) from "one does, elsewhere, and did not export it" (E2003,
// at the target name). Folding the test into `lookup` would collapse the two into the sharper one's
// wording and report the wrong mistake.
//
// ⚠ **AND IT IS ASKED ONLY AT AN `as` CAST TARGET TODAY** (`Parser.hiddenAliasCastTarget`), which is
// the position the corpus pins and the position v1 checks (`validateNamedTypeVisibility` walks
// `convert` ops and nothing else). A hidden alias written as a PARAMETER or FIELD type still
// resolves; widening that is a cross-file name-resolution rung, not a line here, because the message
// this reports names the `as` and there is no ported wording for the other positions.
// ⚠ **IT WAS A FREE FUNCTION AND IS NOW A `ProgramSignatures` METHOD** (`aliasVisibleFrom`), because the
// `module` tier needs the DECLARING FILE'S NAMESPACE and a namespace is derived once per file into that
// index. Spelling the tier walk here as well would be the second copy of a rule whose two copies
// disagreeing is exactly `A1f-aliasclash` restored — see `nameableFromAnywhere` below.

// ⭐⭐ **TIER 2 OF `visibleFrom`, SPELLED ONCE — "may ANY file write this declaration's name down?"**
// `RangedAliasRegistry.record` asks it to decide membership of `nameable`, and `visibleFrom` asks it as
// its second tier. They are the SAME question, and until this was extracted each spelled
// `alias.visibility != Visibility.file` for itself.
//
// ⚠ **THAT DUPLICATION STOPPED BEING COSMETIC WHEN `A1f-aliasclash` MADE `nameable` DECIDE BOUNDS.**
// Before it, `nameable` gated only a DIAGNOSTIC (E2003), so a drift between the two copies cost a
// wrong message. Now `lookup` resolves a third file's contested alias out of that same map, so a
// `Visibility` case added to one copy and not the other hands that file a declaration `visibleFrom`
// says it may not name — which is `A1f-aliasclash` itself, restored, and SILENT: the range would be
// wrong and E2003 would agree with whichever copy was wrong, because it reads the same map.
// `Visibility` has three cases today (`file`/`module`/`global`) and a fourth is the edit this guards.
//
// ⚠ **IT IS `== global`, NOT `!= file` (N1a).** The two were the same sentence while `export` minted
// `Visibility.module`; they are not once `module` means a DIRECTORY SUBTREE, because "may ANY file name
// this?" is false for a subtree-scoped declaration. Membership of `nameable` is unchanged for every
// program that existed before the `module` modifier — an `export`ed alias is now `global` and still in,
// a plain one is still out — so this is a widening of the QUESTION, not a change of the answer.
//
// ⚠ **IT TAKES A `Visibility`, NOT A DECLARATION, AND N3 IS WHY.** The generic-instance alias registry needs
// the identical tier-2 question (`ProgramSignatures.settleGenericAliasContest`, deciding which declaration a
// file that declares none of a contested name may mean), over a DIFFERENT record. Written as a second
// one-line predicate over `GenericAliasEntry` it was the third copy of the rule this header exists to keep
// at one — and the fourth `Visibility` case would now hand a file an INSTANCE it may not name, not merely a
// wrong diagnostic. The rule is about a tier; the record it was read off was never part of it.
export function nameableFromAnywhere(visibility Visibility) returns bool
	return visibility == Visibility.global
end 'nameableFromAnywhere'

// The prefix Maxon reserves for compiler-minted names, as R-1 reads it — see `identifiableRangeName` for
// why this tier has its own copy rather than sharing the parser's or the signature index's.
let ReservedElementNamePrefix = b"__"

export type RangedAliasRegistry
	// Every alias under its BARE name — the fallback, and on its own exactly the pre-existing
	// whole-program behaviour, which is what makes the bare probe safe to keep.
	var byName as RangedTypeAliasMap
	// ⭐ ONLY the names MORE THAN ONE FILE declares, each holding EVERY declaration of that name.
	//
	// **THE INVARIANT, and both halves are load-bearing:** a name is in here IFF at least two files
	// declare it, and when it is, every one of its declarations is (`record` files the incumbent
	// alongside the newcomer at the moment a second file appears). So a MISS is a complete answer —
	// "one file declares this, `byName` has it" — and a HIT never needs a second source.
	//
	// It is what makes a file-scoped lookup free to the names that do not need one: the miss costs
	// one hash of a short type name and no allocation whatever, which is what the whole-program map
	// cost before file scoping existed.
	var multiplyDeclared as MultiplyDeclaredAliasMap
	// ⭐ The WIDEST `rangedAliasStorageBytes` any declaration of a name needs — folded in by `record` as
	// each declaration arrives, so the file-less reader below answers in one probe and never walks.
	//
	// It is a derived INDEX over the same declarations `byName`/`multiplyDeclared` index, maintained by
	// the same single writer, for the same reason `multiplyDeclared` is: the question is asked far more
	// often than it is written. A width is asked once per array op site and once per `sizeof`; it is
	// written once per `typealias` declaration in the program.
	var storageBytes as AliasStorageBytesMap
	// ⭐ The widest `rangedAliasPackedBits` any declaration of a name needs — the index above's twin below
	// the byte boundary, written by the same single writer in the same call, so the two halves of one
	// element's width are never maintained by two rules that can come to cover different declarations.
	var packedBits as AliasPackedBitsMap
	// ⭐ **THE DECLARATIONS SOME FILE MADE NAMEABLE FROM ANY FILE** — `export`ed or compiler-supplied.
	// A second derived index over the same declarations, maintained by the same single writer, for the
	// reason `multiplyDeclared` is one: it answers a question `lookup` structurally cannot, because
	// `lookup` returns ONE declaration and this is about ALL of them (see `nameableFromAnyFile`).
	//
	// ⭐ **AND IT IS ALSO THE DOOR A THIRD FILE RESOLVES A CONTESTED NAME THROUGH** — see `lookup`.
	var nameable as NameableAliasMap
	// ⭐⭐ **THE NAMES WHOSE DECLARATIONS DISAGREE ABOUT THE RANGE (N2)** — a THIRD derived index over the
	// same declarations, and the only one that cannot be maintained by `record`: it is a fact about ALL of a
	// name's declarations at once, so it is settled in one pass after the last one lands
	// (`settleRangeContests`). Empty until then, and empty forever in a program with no contest.
	var rangeContested as RangeContestedAliasMap
	// ⭐⭐ **THE BUILTIN `ExitCode`'S HIGH BOUND, RESOLVED FROM THE COMPILE TARGET'S OS ONCE, HERE
	// (BATCH27).** `lookup` is handed a name and a reader's path and nothing else — no project, no target —
	// so the platform fact cannot be derived at the moment it is needed. It is derived at CONSTRUCTION,
	// where `Project.create` and `Queries.resetMergeTargets` and `ProgramSignatures.create` all have a
	// `Target` in hand, and carried on the structure that answers the question.
	//
	// A `let`, mirroring `Project.target`'s, and for its reason: a registry is aimed at one target when it
	// is built and re-aiming it mid-compile would make two lookups of one name disagree.
	let exitCodeHigh as ParsedInt

	// ⭐⭐ **EVERY REGISTRY IS BORN HOLDING `Codepoint`, AND THAT IS WHAT GIVES IT A RANGE (P1.8 Slice E
	// review).** `Codepoint` is declared, verbatim and with these bounds, in `stdlib/Character.maxon` —
	// a module shv2 cannot LOAD, because it also declares `type Character`, a name the compiler owns. So
	// the alias was answered by `isSynthesizedIntAliasName` instead, which supplies the ERASURE (`→
	// integer`) and has nowhere to put a RANGE.
	//
	// ⚠ **AND A RANGE IT HAD TO HAVE, because `insertRangeChecks` guards a RETURN through a ranged alias
	// and can only find a range a registry holds.** MEASURED before this seed, inside ONE stdlib module:
	// `utf16LeadSurrogate(1000000000)` — declared `returns CodeUnit16`, an ordinary registry alias
	// declared in `utf16.maxon` — panicked correctly, while `utf16DecodeSurrogates(0, low: 0)` — declared
	// `returns Codepoint` — returned **-56613888**, a negative number wearing a type whose declared range
	// starts at 0. Two behaviours for one kind of precondition violation, and the difference was an
	// implementation detail of how shv2 came by the name.
	//
	// ⭐ **SEEDED HERE, IN THE ONE CONSTRUCTOR, so there is ONE home for the fact and no per-file loop to
	// forget.** All three registries in the compiler are built through this function — `ProgramSignatures`'
	// (which `aliasOf` reads to PLAN a return check) and `Project`'s (which `InsertRangeChecks` reads to
	// get the BOUNDS, and `resolveNamedType` to erase the name), created at `Project.create` and again at
	// `Queries`' reset. A seed at either registry alone would have made the planner and the emitter
	// disagree about whether `Codepoint` has a range at all.
	//
	// It goes through `record`, not a bare upsert, for the reason the sweep does: this registry and the
	// project's must be BUILT by one function or a contested name resolves differently in each. And
	// because it is `record`ed as an ordinary declaration of an ordinary file, a USER's own
	// `typealias Codepoint = int(0 to 10)` simply contests it — `multiplyDeclared` files both, the user's
	// file resolves to the user's bounds, and `utf16.maxon` (which is neither file) falls through to
	// `byName`, where this seed sits because it was recorded first. No carve-out anywhere.
	//
	// ⚠ It is deliberately NOT folded into `ProgramSignatures`' content hash (that happens in
	// `recordAlias`, one level up). The seed is identical in every program, so it distinguishes nothing —
	// hashing it would invalidate every parse memo in the project to record a constant.
	//
	// ⚠ **AND IT TAKES THE TARGET'S `Os`, WHICH IS THE ONE THING A REGISTRY CANNOT LEARN LATER (BATCH27)** —
	// see `exitCodeHigh` above. Every construction site supplies it from the `Target` its own caller was
	// aimed with; none of them defaults, because a default at one site is a compile that silently uses the
	// build machine's platform for a cross-compiled binary's `ExitCode`.
	export static function create(os Os) returns RangedAliasRegistry
		let exitCodeHigh = exitCodeAliasHigh(os)
		requireExitCodeRangeFitsItsWidth(exitCodeHigh)
		var registry = Self{byName: RangedTypeAliasMap.create(), multiplyDeclared: MultiplyDeclaredAliasMap.create(), storageBytes: AliasStorageBytesMap.create(), packedBits: AliasPackedBitsMap.create(), nameable: NameableAliasMap.create(), rangeContested: sharedEmptyRangeContests, exitCodeHigh: exitCodeHigh}
		_ = registry.record(builtinStdlibAlias(CodepointTypeName, low: CodepointAliasLow, high: CodepointAliasHigh, declPathText: CodepointAliasDeclPath))
		_ = registry.record(builtinStdlibAlias(ElementCountAliasName, low: ElementCountAliasLow, high: ElementCountAliasHigh, declPathText: ElementCountAliasDeclPath))
		_ = registry.record(builtinStdlibAlias(BytePosAliasName, low: StringPositionAliasLow, high: StringPositionAliasHigh, declPathText: StringPositionAliasDeclPath))
		_ = registry.record(builtinStdlibAlias(GraphemeCountAliasName, low: StringPositionAliasLow, high: StringPositionAliasHigh, declPathText: StringPositionAliasDeclPath))
		return registry
	end 'create'

	// File one declaration, and answer whether its UNDERLYING PRIMITIVE conflicts with the one every
	// earlier declaration of the name shares — the one place that decides it, so the conflict test and
	// the insert sit on one structure and cannot come to disagree about which declarations conflict.
	export function record(alias RangedTypeAlias) returns AliasRecordOutcome
		self.widenElementWidthFor(alias)

		// Recorded here, ABOVE the first-declaration early return below, so every declaration passes
		// through it exactly once whatever else the name goes on to do.
		if nameableFromAnywhere(alias.visibility) 'nameableAnywhere'
			self.nameable.upsert(alias.name, value: alias)
		end 'nameableAnywhere'

		// The FIRST declaration of a name — which, in a program where nothing is redeclared, is every
		// single one of them — collides with nothing and contests nothing. It costs ONE probe and one
		// insert, and never touches `multiplyDeclared` or builds anything at all.
		let sole = try self.byName.get(alias.name) otherwise 'firstDeclarationOfThisName'
			self.byName.upsert(alias.name, value: alias)
			return AliasRecordOutcome.accepted
		end 'firstDeclarationOfThisName'

		let declPath = alias.declFilePath.toString()
		// EMPTY means no SECOND file has declared this name yet — the invariant puts at least two
		// declarations in every entry that exists — and it doubles as the map to fill if THIS
		// declaration is the one that makes the name contested.
		var byFile = try self.multiplyDeclared.get(alias.name) otherwise RangedAliasByDeclaringFile.create()
		var outcome = AliasRecordOutcome.accepted

		// The two arms below each answer the SAME question — is this newcomer's file already among the
		// files that declare this name — off two different sources, because "the files that declare
		// this name" lives in `byFile` once a name is contested and in `sole` alone before that. What
		// each arm records is that FACT; what the fact MEANS is decided once, after them.
		//
		// A SAME-FILE redeclaration is not this registry's to report (`TypeNameRegistry` owns it, for
		// every declaration kind), but it is still this registry's to CLASSIFY: it must not make the
		// name contested, because a name whose duplicate is already an error has exactly one meaning.
		var declaredByAnotherFile = false

		if byFile.count() > 0 'alreadyContested'
			declaredByAnotherFile = not byFile.contains(declPath)
		end 'alreadyContested' else 'secondDeclarationOfThisName'
			// `sole` is the ONLY other declaration of this name, so it settles the question on its own.
			let solePath = sole.declFilePath.toString()
			declaredByAnotherFile = not solePath.equals(declPath)

			if declaredByAnotherFile 'secondFileDeclaresIt'
				// The incumbent goes in WITH the newcomer: the invariant is "every declaration or
				// none", and an entry holding only the second file's would answer with the WRONG
				// file's range for the first file's own uses — the defect file scoping exists to fix.
				byFile.upsert(solePath, value: sole)
			end 'secondFileDeclaresIt'
		end 'secondDeclarationOfThisName'

		// ⭐ **WHAT MAKES `underlyingInAnyFile` ANSWERABLE AT ALL — the rule, written once.** A
		// cross-file pair over two RANGES is legal and stays legal; a pair over two PRIMITIVES is not,
		// because the range is resolved per declaring file and the primitive is not — the file-less
		// readers (type resolution of a struct field, union payload classification, generic and
		// conformance canonicalization) all take it from the bare door, which holds exactly one entry
		// per name. Refusing the pair turns that door's contract from a bet about today's corpus into a
		// property of every program that compiles: every declaration of a name shares one underlying
		// primitive, so the bare answer IS the answer a scoped lookup would give, for every reader,
		// always.
		//
		// ⚠ CROSS-FILE ONLY, and never for a same-file pair: a file that declares one name twice is a
		// duplicate (E3061, from `TypeNameRegistry`) whichever primitives it picked, and diagnosing
		// that as a cross-file conflict would blame the wrong thing. `sole` carries the comparison
		// because it is the last declaration recorded for this name, and by induction every earlier one
		// agrees with it — the first pair that disagreed stopped the program here.
		if declaredByAnotherFile and maxonTypeTag(alias.underlying) != maxonTypeTag(sole.underlying) 'underlyingConflict'
			outcome = AliasRecordOutcome.conflictingUnderlying(sole)
		end 'underlyingConflict'

		// Non-empty here means the name is contested — either it already was, or the branch above
		// just made it so by filing the incumbent. A same-file redeclaration of a name only one file
		// declares leaves it empty and un-filed, which is right: E3061 is reported against it and the
		// name still has exactly one meaning.
		if byFile.count() > 0 'contested'
			byFile.upsert(declPath, value: alias)
			self.multiplyDeclared.upsert(alias.name, value: byFile)
		end 'contested'

		self.byName.upsert(alias.name, value: alias)

		return outcome
	end 'record'

	// ⭐⭐ **DOES *SOME* DECLARATION OF `name` MAKE IT NAMEABLE FROM ANY FILE?** — a question about ALL
	// of a name's declarations, which is why it cannot be asked of `lookup`'s answer: `lookup` returns
	// exactly ONE declaration, and reading visibility off that one alone answers about the file walk
	// rather than about the program.
	//
	// ⚠ **SINCE `A1f-aliasclash` THIS PROBE ANSWERS `true` EVERYWHERE IT IS ASKED, AND IT IS KEPT ON
	// PURPOSE.** Its only caller is `Parser.everyDeclarationHidden`, which reaches it only after
	// `visibleFrom` said false of `lookup`'s answer — and `lookup` now hands a contested name's
	// non-declaring reader a NAMEABLE declaration whenever one exists, so that path is taken only when
	// this map holds no entry for the name at all. Deleting it would put the E2003 decision back on
	// `lookup`'s single answer, which is precisely the coupling that made the two deciders disagree
	// (see the MEASURED note below); it is one probe on a path that was already about to report an
	// error. ⛔ It also stops being a tautology the moment `lookup`'s nameable tier changes — which is
	// exactly what an E3063 rung does.
	//
	// ⚠ **MEASURED, and it is what this exists for** (P1.9 review). Two files declaring `Score`, one
	// `export`ed and one not, plus a third that casts to it: `a.maxon` exported + `b.maxon` private
	// REFUSED the third file with `E2003 Expected type name after 'as'`, while the identical program
	// with those two files renamed `aaa.maxon` private + `bbb.maxon` exported COMPILED. One program, two
	// answers, decided by two filenames — and the refusal was of the legal one, since an exported
	// declaration was in scope the whole time.
	//
	// It answers only the MEMBERSHIP half — "may some declaration of this name be named from anywhere?"
	// — and stops a diagnostic whose whole claim ("no declaration of this name is yours to name") is
	// false from being raised. WHICH declaration a third file then resolves to is `lookup`'s answer, out
	// of the same index: they are two questions over one fact, which is why one index carries both.
	export function nameableFromAnyFile(name ByteArray) returns bool
		return self.nameable.contains(name)
	end 'nameableFromAnyFile'

	// The alias `name` denotes when read FROM `readerFilePath`.
	//
	// ⚠ **THE CONTESTED TEST AND THE SCOPED ANSWER ARE ONE PROBE, and that is the point.** This is
	// asked once per named type reference — the parser's hot path — so nothing here may allocate.
	// A name only one file declares misses `multiplyDeclared` and falls straight through to the bare
	// answer, which is the same answer; a name several files declare is answered out of the very
	// entry that proved it contested, keyed by the reader's path with no composite key to build.
	//
	// ⭐⭐ **AND A THIRD FILE — one that names a CONTESTED alias and declares none of it — RESOLVES TO A
	// DECLARATION IT MAY ACTUALLY NAME.** This used to fall straight through to the bare `byName` door,
	// which is LAST-WINS, so whichever declaration merged last decided what a stranger's parameter,
	// return type and cast meant. It is not a tie between equals: a plain `typealias` is FILE-LOCAL, so a
	// declaration the third file is forbidden to write down cannot be the one it meant.
	//
	// ⛔ MEASURED, and the wrong answer went in the worst direction — a user's PRIVATE alias decided what
	// a STDLIB function accepts. A user `typealias Codepoint = int(0 to 100)` made
	// `stdlib/helpers/string/utf16.maxon`'s `utf16LeadSurrogate(codepoint Codepoint)` — whose `Codepoint`
	// is `stdlib/Character.maxon`'s EXPORTED `int(0 to 1114111)` — refuse a legal `70000`, quoting a range
	// from a file `utf16.maxon` has never seen. Pinned by `specs-shv2/typealias-file-scope.md`'s
	// `third-file-resolves-to-the-nameable-declaration` and its runtime twin.
	//
	// ⚠ **IT NARROWS THE LAST-WINS SET; IT DOES NOT ABOLISH IT, and that is the E3063 boundary this rung
	// deliberately does not cross.** Two files that both EXPORT one name still answer last-wins — on the
	// strictly smaller set of declarations the reader may name — because choosing between two legal
	// candidates is a cross-file name-resolution decision with its own diagnostic and its own
	// false-reject sweep. What is fixed here is only the case where one candidate was never a candidate.
	//
	// ⚠⚠ **TWO BOUNDARIES THE PARAGRAPH ABOVE HIDES, both MEASURED (BATCH6 review), because "a user's
	// private alias decided what a stdlib function accepts" reads wider than what moved:**
	//
	//   • **A contest ENTIRELY INSIDE `stdlib/` is untouched — the fix is a no-op there.**
	//     `Parser.typeAliasVisibility` gives EVERY alias in a stdlib source file `Visibility.global`,
	//     `export`ed or not, so every candidate is nameable and `nameable`'s last-wins winner IS
	//     `byName`'s. The `Byte`/`ByteCount`/`Utf16UnitCount` contests this file cites elsewhere are all
	//     of that shape. The case actually repaired is stdlib-vs-user-PRIVATE.
	//   • **A user `export`ed alias still displaces the stdlib seed, exactly as before.** `record`'s
	//     `nameable` is last-wins too, so `export typealias Codepoint = int(0 to 100)` in a user file
	//     still wins for any file that declares no `Codepoint` of its own. That is NOT a regression —
	//     `byName` did the same — and stdlib files that declare the name are unaffected, because
	//     `readersOwnFile` runs first. It is the same E3063 contest, and it is the reason the bullet
	//     above says "narrows", not "closes".
	//
	// ⚠ **AND THE FALLBACK TO `byName` IS NOT DEAD CODE — it is what the visibility diagnostics rest on.**
	// A name whose every declaration is file-private must still be FOUND from another file, because that
	// is exactly what tells "no declaration binds this name anywhere" (E3011) from "one does, elsewhere,
	// and did not export it" (E2003 — see `visibleFrom`). Hiding it here would collapse the two into the
	// blunter one's wording.
	//
	// ⚠ The extra probe is paid ONLY by a contested name whose reader declares none of it. An uncontested
	// name — nearly every name in any program — short-circuits on the `multiplyDeclared` miss exactly as
	// it did, so the hot path is unchanged.
	//
	// ⛔⛔ **THIS THREE-TIER RULE IS SPELLED TWICE, AND THE OTHER COPY IS
	// `ProgramSignatures.scopedGenericAliasInstance` (N3 review).** That one resolves a GENERIC-INSTANCE
	// alias — own file, then a declaration the reader may NAME, then bare last-wins — over
	// `contestedGenericAliases`/`nameableGenericAliases` instead of `multiplyDeclared`/`nameable`. The two
	// cannot be merged today: the tiers are identical but the VALUES are not (a `RangedTypeAlias` against a
	// `GenericInstanceId`) and this compiler's source has no generic FUNCTION to abstract over that, so what
	// stands in for one spelling is this pointer — and it must be read as an INSTRUCTION, not a note: **edit
	// this rule and you must edit that one.**
	//
	// ⚠ It is stated on BOTH sides deliberately. The generic copy already named this one; this one named
	// nothing, so an editor arriving at the older and more prominent door — which is where the next change
	// lands — had no reason to know a second copy existed. **And the next change is already known to be
	// coming to both**: the E3063 boundary each header stops at (choosing between two LEGAL candidates by
	// module-directory precedence) is owed by the ranged form and the generic form alike, and the failure
	// mode of teaching only one is a generic alias resolving last-wins where a ranged one resolves by
	// precedence — a wrong answer at one door, with no compile error at either.
	export function lookup(name ByteArray, readerFilePath FilePath) returns DeclaredAlias
		if let byFile = try self.multiplyDeclared.get(name) 'contested'
			if let own = try byFile.get(readerFilePath.toString()) 'readersOwnFile'
				return DeclaredAlias.declared(own)
			end 'readersOwnFile'

			if let nameableHere = try self.nameable.get(name) 'someDeclarationIsNameable'
				return DeclaredAlias.declared(nameableHere)
			end 'someDeclarationIsNameable'
		end 'contested'

		if let any = try self.byName.get(name) 'declaredSomewhere'
			return DeclaredAlias.declared(any)
		end 'declaredSomewhere'

		// ⭐⭐ **THE BUILTIN `ExitCode` — LAST, AS A FALLBACK, AND THE POSITION IS THE WHOLE ANSWER TO
		// "WHOSE `ExitCode`?" (X6 review).** It supplies a range for the name NO file declares, which is
		// every program in the corpus but twenty-nine; where a file DOES declare it, that declaration
		// answers, exactly as it answers for every other alias name.
		//
		// ⛔⛔ **IT WAS WRITTEN FIRST, AND FIRST WAS A MISCOMPILE — the rung's own signature bug, one name
		// with two authorities.** The registry does not hold the range alone: `storageBytesInEveryFile`
		// holds the SLOT WIDTH a declaration implies, it is fed by the same `record`, and nothing was going
		// to short-circuit IT. So `typealias ExitCode = int(0 to 125)` + `Array with ExitCode` had its
		// guard answered by the builtin (`0 to u32.max`, so `300` passed) and its stride answered by the
		// user (one byte, so `300` was stored as `44`). **MEASURED: it compiled clean and printed `44`;
		// with the bound `0 to 300` a `70000` printed `4464`.** Both compilers refuse the program — the
		// bootstrap oracle with `E3005 … outside the range of 'ExitCode' (int(0 to 125))`, and shv2 itself
		// before this rung. A silent wrong answer, on every target, in exchange for an ordering nothing
		// needed.
		//
		// ⚠ **AND THE ARGUMENT FOR PUTTING IT FIRST DOES NOT SURVIVE BEING WRITTEN OUT.** It ran: the TYPE
		// is the builtin's (`TypeResolution.denotedNamedType` erases the name from its own builtin arm
		// ahead of its registry arm), so the RANGE must be too, or a `main` declared `int(0 to 125)` would
		// be guarded against 125 while returning through a slot that holds u32. But a guard NARROWER than
		// the slot is what every ranged alias in the language is — `int(0 to 100)` rides an i64 — so the
		// pair is not a disagreement at all. The genuine coupling runs the other way: RANGE and WIDTH must
		// name one declaration, and only the fallback keeps them together for BOTH shapes (a declared
		// `ExitCode` ⇒ the user's range and the user's width; an undeclared one ⇒ `0 to u32.max` and the
		// machine word `undeclaredNamedElementSlot` gives).
		//
		// ⚠ It asks the TABLE (`builtinTypeNameTag`) rather than comparing bytes, for the reason
		// `ExitCodeBuiltinName`'s file-private header gives. Being last, that table's compares are paid
		// only on a lookup that was about to answer `undeclared` and never on the hot path — where, first,
		// they were paid on every named type reference in the program.
		if builtinTypeNameTag(name) == ValueTypeTag.exitCode 'theBuiltin'
			return DeclaredAlias.declared(builtinExitCodeAlias(name, readerFilePath: readerFilePath, high: self.exitCodeHigh))
		end 'theBuiltin'

		return DeclaredAlias.undeclared
	end 'lookup'

	// ⭐⭐ **EVERY DECLARATION OF A NAME MORE THAN ONE FILE DECLARES — the set an AMBIGUITY question is
	// decided on (N1c).** A name only one file declares answers the SHARED EMPTY map, and that is a
	// COMPLETE answer rather than a cheap one: one declaration is never ambiguous.
	//
	// ⭐ **IT HANDS BACK THE VERY ENTRY `lookup` SHORT-CIRCUITS ON**, so the ambiguity verdict and the
	// resolution it overrides read ONE index and cannot come to disagree about which declarations exist —
	// the coupling `lookup`'s own header asks for where it names the E3063 boundary it stops at.
	//
	// ⚠ **THE NARROWING IS NOT HERE, and could not be**: the two precedence rules are decided on MODULE
	// DIRECTORIES, which this registry does not hold and must not learn — see
	// `ProgramSignatures.ambiguousAliasCandidates`, which holds both indexes.
	export function contestedDeclarations(name ByteArray) returns RangedAliasByDeclaringFile
		return try self.multiplyDeclared.get(name) otherwise sharedEmptyContestedDeclarations
	end 'contestedDeclarations'

	// ⚠ **THE BARE PROBE, for the readers that HAVE no file to ask from** — type resolution's erasure
	// of a `named` to its primitive (`resolveNamedType`, reached for a `StructLayout` field type,
	// which records no declaring file), conformance-signature canonicalization, union payload
	// classification reached from the emitted runtime (`MmRuntime`/`ManagedMemoryRuntime` walk
	// `project.enumTypes`, which records no declaring file) and generic type-argument canonicalization
	// (`conformerTypeArgName`, which holds an instance id).
	//
	// It is spelled separately, and named for what it does, so that "this site cannot scope its
	// lookup" is greppable rather than hidden behind a path that LOOKS scoped.
	//
	// ⭐ **IT HANDS BACK `underlying` AND NOT THE ALIAS, and that is a CONTRACT, not a convenience.**
	// All four readers want the `int`/`float` keyword and none may read the RANGE — the range is
	// per-file and enforced where the file is known (`InsertRangeChecks`), so a reader with no file
	// reading it would be reading a stranger's bounds. Each of them used to say so in a comment;
	// now none of them CAN.
	//
	// ⭐ **AND THE ANSWER IT GIVES IS FILE-INDEPENDENT, BY CONSTRUCTION — see `record`'s E3105.** The
	// only way two declarations of one name could disagree about the `int`/`float` keyword is a
	// cross-file `int`/`float` pair, and `record` refuses to accept one. So this door's answer is the
	// SAME answer a scoped lookup would give, for every reader, in every program that compiles.
	// It was once merely true of `stdlib/` and the corpus, which is a bet and not a contract: while
	// it was only that, a user program declaring `Measure` as `int` in one file and `float` in
	// another made the parser (scoped) and this door (bare) disagree, and the x64 emitter panicked on
	// an xmm value in a gpr slot rather than diagnosing anything.
	//
	// ⚠ It also costs NOTHING, where a `DeclaredAlias` answer cost one allocation per call: a union
	// with an associated value is HEAP-BOXED, and `resolveNamedType` asks this once per named TYPE
	// REFERENCE. Measured on the scale ladder, that box was +36 x 2^n allocations — a term that grew
	// with the PROGRAM, where every other cost of alias resolution grows only with the DECLARATIONS.
	// Returning a field that already holds a `MaxonType` constructs nothing. The `throws` channel is
	// `Map.get`'s own and is likewise free.
	export function underlyingInAnyFile(name ByteArray) returns MaxonType throws MapError
		let any = try self.byName.get(name)
		return any.underlying
	end 'underlyingInAnyFile'

	// ⭐⭐ **THE RANGE ITSELF, AS A NAME — the one BOUNDS question a file-less reader may ask, and the door
	// R-1 resolves a generic instance's element identity through.**
	//
	// `underlyingInAnyFile` directly above refuses to hand out bounds at all, and its reason is exact: *a
	// reader with no file reading A file's bounds is reading a STRANGER's bounds.* **That reason reaches only
	// a CONTESTED name** — one whose declarations disagree about the range — **and this door refuses exactly
	// those**, so every name it answers for is a name every file in the program reads identically. There is no
	// stranger left to be wrong about.
	//
	// ⚠ **A NAME DECLARED TWICE OVER THE SAME RANGE IS NOT CONTESTED AND IS ANSWERED HERE.** That is the
	// distinction `settleRangeContests` draws (`holdsRange` compares BOUNDS, not declarations), and it is the
	// one this door needs: two declarations that agree are not two readings.
	//
	// ⚠⚠ **IT MAY NOT BE ASKED BEFORE `settleRangeContests` HAS RUN.** `rangeContested` is EMPTY until then,
	// so every name would look uncontested and this would hand out a stranger's bounds after all — silently,
	// and to every reader at once. Its caller gates on `ProgramSignatures.allFilesFolded`; see the ⚠⚠ note on
	// `canonicalTypeArgName`'s `named` arm for the 34 red cases the ungated version measured.
	export function uncontestedRangeName(name ByteArray) returns ByteArray throws MapError
		if self.rangeContested.contains(name) 'itsDeclarationsDisagreeAboutTheRange'
			throw MapError.keyNotFound
		end 'itsDeclarationsDisagreeAboutTheRange'

		let any = try self.byName.get(name)
		return rangeCanonicalTypeName(any.underlying, low: any.low, high: any.high)
	end 'uncontestedRangeName'

	// `uncontestedRangeName`'s DISPLAY twin -- `int(0 to 255)` rather than the key spelling. Same contested
	// refusal for the same reason: a name whose declarations disagree has no one range to be shown as.
	export function uncontestedRangeSourceSpelling(name ByteArray) returns ByteArray throws MapError
		if self.rangeContested.contains(name) 'itsDeclarationsDisagreeAboutTheRange'
			throw MapError.keyNotFound
		end 'itsDeclarationsDisagreeAboutTheRange'

		let any = try self.byName.get(name)
		return rangeSourceSpelling(any.underlying, low: any.low, high: any.high)
	end 'uncontestedRangeSourceSpelling'

	// ⭐⭐ **EVERY RANGED ALIAS THAT SHARES ITS RANGE WITH ANOTHER, PAIRED WITH THAT RANGE'S NAME (R-1).** The
	// substitution `GenericInstanceRegistry.instanceKey` applies, in the one form the registry can consume
	// without knowing what an alias is.
	//
	// ⚠ **A NAME WHOSE RANGE NO OTHER NAME SHARES IS ABSENT, AND THAT IS WHAT KEEPS THE COMMON PROGRAM FREE.**
	// Substituting it would be a no-op — it would map the only spelling of a type to a second spelling of the
	// same type — while making `rangeIdentity` non-empty, which is the flag every `instanceKey` tests. A
	// program declaring no two aliases over one range gets an EMPTY map here and pays a `count()` per argument
	// and nothing else.
	//
	// ⚠ **CONTESTED NAMES ARE SKIPPED, BY `uncontestedRangeName`'s REFUSAL AND NOT BY A SECOND TEST HERE.** A
	// name whose declarations disagree about the range has no single range to be identified by; N2 has already
	// split its instances per reading file, and that split is what must survive.
	export function rangeIdentityPairs() returns RangeIdentityNameMap
		// The range name is minted ONCE PER ALIAS and carried, not re-derived: it is the only allocation in this
		// walk, and deriving it again in the second pass doubled the cost of the whole R-1 step for nothing.
		var byAlias = RangeIdentityNameMap.create()
		var claimants = RangeClaimantCountMap.create()
		for (name, _) in self.byName 'eachRangedAlias'
			if let rangeName = try self.identifiableRangeName(name) 'itsRangeIdentifiesIt'
				byAlias.upsert(name, value: rangeName)
				let seen = try claimants.get(rangeName) otherwise 0
				claimants.upsert(rangeName, value: seen + 1)
			end 'itsRangeIdentifiesIt'
		end 'eachRangedAlias'

		// A name whose range NO other name claims is dropped: substituting it would map the only spelling of a
		// type to a second spelling of the same type, while making `rangeIdentity` non-empty — and that map's
		// emptiness is the flag every `instanceKey` tests.
		var pairs = RangeIdentityNameMap.create()
		for (name, rangeName) in byAlias 'eachIdentifiableAlias'
			let claimed = try claimants.get(rangeName) otherwise 0
			if claimed > 1 'someOtherAliasDenotesTheSameRange'
				pairs.upsert(name, value: rangeName)
			end 'someOtherAliasDenotesTheSameRange'
		end 'eachIdentifiableAlias'

		return pairs
	end 'rangeIdentityPairs'

	// `uncontestedRangeName` for a name R-1 is ALLOWED to identify by its range, and a refusal for one it is
	// not. Two names are refused, for two different reasons.
	//
	// A RANGE-CONTESTED name is refused by `uncontestedRangeName` itself: it has no single range to be
	// identified by, and N2 has already given its readings distinct spellings that must survive.
	//
	// A COMPILER-RESERVED name is refused HERE, and this is the rule rather than an exception to it.
	// R-1 says two aliases the AUTHOR wrote over one range are two spellings of one type. A `__`-prefixed
	// element is not a spelling of anything — it is unspellable in source, and it is minted for the express
	// purpose of being a DIFFERENT instance from the user-visible name beside it. `__ManagedByte` is the
	// case: a compiler-synthesized byte buffer wears it so that it is not a user's `Array with Byte`, and the
	// admission between the two is deliberately ONE-WAY through `ProgramSignatures.byteBufferBoundaryAdmits`
	// (see `Parser.requireSameArrayInstance`). Identify them and that door has no subject left — the one-way
	// admission becomes an identity, and a user's `Array with Byte` reaches a position nothing but the
	// compiler is supposed to mint a value at. MEASURED with the exclusion absent: `stdlib/String.maxon:188`
	// failed to compile and took three spec cases with it.
	//
	// ⚠ The reserved prefix is spelled here rather than shared with `Parser.ReservedNamePrefix` or
	// `SignatureIndex.ReservedTypeNamePrefix`, which is that pair's own stated design — see the header on the
	// latter: the three ask different questions (forbidding, minting, and now identifying) at different
	// tiers, and the language rule binds them rather than a symbol.
	function identifiableRangeName(name ByteArray) returns ByteArray throws MapError
		if bytesStartWith(name, prefix: ReservedElementNamePrefix) 'aCompilerMintExistsToBeDistinct'
			throw MapError.keyNotFound
		end 'aCompilerMintExistsToBeDistinct'

		return try self.uncontestedRangeName(name)
	end 'identifiableRangeName'

	// Does SOME file declare `name` as a ranged typealias — the membership half of `underlyingInAnyFile`,
	// over the identical table, so the two cannot come to disagree about what this registry holds. It is the
	// FORM question (`ProgramSignatures.declaredFormOf`) and deliberately not the bounds one: which file's
	// bounds a reader gets is `lookup`'s answer and needs a reader file, while "is this name a ranged alias
	// at all" is the same for every reader.
	//
	// ⚠ It does NOT answer for the builtin `ExitCode`, exactly as `underlyingInAnyFile` does not: the
	// builtin range is `lookup`'s LAST fallback, supplied for the name no file declares. A form derived
	// from it would report a `typealias` no program contains.
	export function containsInAnyFile(name ByteArray) returns bool
		return self.byName.contains(name)
	end 'containsInAnyFile'

	// ⭐ **THE STORAGE WIDTH THAT HOLDS EVERY FILE'S DECLARATION OF `name` — the other file-less door, and
	// the one range question a file-less reader IS allowed to ask.**
	//
	// `underlyingInAnyFile` above refuses to hand out bounds, and its reason is exact: a reader with no
	// file reading A file's bounds is reading a STRANGER's bounds. That reason does not reach this
	// question, because this answer is not any one file's — it is a width correct for every file's bounds
	// at once, and it is the MAX that makes it so. A wider slot holds a narrower one's values, so no
	// file's range is ever truncated by another file's width.
	//
	// ⚠ **THE FOLD IS NOT OPTIONAL, because a generic instance is interned on the NAME.**
	// `Array with Small` is ONE instance however many files declare `Small`, so its `element_size@24` is
	// ONE number — a record created in one file is pushed, appended, read and dropped in another, and they
	// must stride identically. A bare `byName` probe would answer with whichever file merged LAST:
	// `stdlib/helpers/string/`'s `Utf16UnitCount` pair (`utf16.maxon`'s `int(1 to 2)`, `views.maxon`'s
	// `int(0 to u64.max)`) would stride 1 or 8 by load order, and on the 1 the file that meant 8 would
	// truncate silently. That is the same order-dependent wrong answer file scoping was added to kill,
	// one door along.
	//
	// A name only ONE file declares — nearly every name — cost exactly one probe to fold and costs exactly
	// one probe to read. `throws` is `Map.get`'s own channel: a name no file declares is not a ranged
	// alias, which is the caller's case to handle, not a width to invent.
	export function storageBytesInEveryFile(name ByteArray) returns ByteOffset throws MapError
		return try self.storageBytes.get(name)
	end 'storageBytesInEveryFile'

	// ⭐ **THE SUB-BYTE PACKED WIDTH THAT HOLDS EVERY FILE'S DECLARATION OF `name`** — the door above's
	// twin below the byte boundary, and file-less for the identical reason: a generic instance is interned
	// on the NAME, so `Array with Q` is ONE instance with ONE `element_size@24` however many files declare
	// `Q`, and an answer that varied by reader would let one file's record stride 2 bits while another's
	// strode a byte.
	//
	// ⚠ **IT DOES NOT THROW, AND THE MISS IS AN ANSWER RATHER THAN A GAP.** A name no file declares as a
	// ranged alias is an enum, a boxed union's ordinal, or the `Byte` a `b"…"` literal mints for itself —
	// and NOT ONE OF THEM PACKS. So `NotSubBytePacked` is complete and correct for the whole miss arm,
	// where the width door has to throw because its miss splits two ways
	// (`ProgramSignatures.undeclaredNamedElementSlot`).
	//
	// ⭐⭐ **THAT IS ALSO WHERE ENUMS ARE EXCLUDED, AND IT COSTS NOTHING TO STATE.** v1 needs an explicit
	// `project.enumTypes.contains(name)` guard in its classifier, because its enums DO register an ordinal
	// range beside the typealiases and would otherwise pack a 3-case enum into 2 bits — which
	// `enum-narrow-storage` forbids. shv2's enums are not in this registry at all, so they miss here and
	// the exclusion is structural rather than a rule someone has to remember to keep.
	export function packedBitsInEveryFile(name ByteArray) returns PackedBitWidth
		return try self.packedBits.get(name) otherwise NotSubBytePacked
	end 'packedBitsInEveryFile'

	// ⭐ **DOES ANY FILE DECLARE `name` AS A RANGED ALIAS AT ALL? (A4c)** The door above's `throws` channel as
	// a plain bool, for the one reader that wants whether a declaration EXISTS and never what it says:
	// `ProgramSignatures.elementIsAByteNoFileDeclares` is asking whether an element's slot comes from
	// `undeclaredNamedElementSlot` — the miss arm — and therefore has no declared range for a raw byte
	// to fall outside of. It reads the SAME index for the same reason `storageBytesInEveryFile` does:
	// `widenElementWidthFor` is the only entry that writes it and runs on every declaration before any
	// branching, so "present here" and "some file declares it" are one fact.
	export function anyFileDeclares(name ByteArray) returns bool
		return self.storageBytes.contains(name)
	end 'anyFileDeclares'

	// Fold one declaration's width into the running max for its name — BOTH halves of it, above and below
	// the byte boundary. The ONLY writer of `storageBytes` and of `packedBits`, called by `record` before
	// any of its own branching, so both indices cover every declaration whatever that branching concludes
	// about contest or conflict.
	//
	// ⚠ **THE TWO FOLDS ARE ONE CALL BECAUSE THEY ARE ONE FACT.** A name's element width is a single answer
	// that happens to be spelled in bytes above the boundary and in bits below it; folding one here and the
	// other anywhere else would be two writers over the same declarations, free to cover different ones.
	//
	// ⚠ **THE FIRST DECLARATION IS WRITTEN IN ONE PLACE FOR BOTH INDICES, AND THAT IS WHAT MAKES THEM
	// LOCKSTEP.** `packedBits` has an entry for exactly the names `storageBytes` has one for, because this
	// is the only writer of either and it seeds both on the same event. The two `widen*` helpers below are
	// therefore only ever asked about a name that is already present — which is why each may `panic` on a
	// miss rather than quietly seeding a second time, and why they read as the two halves of one fold
	// instead of one inline arm and one helper.
	function widenElementWidthFor(alias RangedTypeAlias)
		if not self.storageBytes.contains(alias.name) 'firstDeclarationOfThisName'
			self.storageBytes.upsert(alias.name, value: rangedAliasStorageBytes(alias.low, high: alias.high))
			self.packedBits.upsert(alias.name, value: rangedAliasPackedBits(alias.low, high: alias.high))
			return
		end 'firstDeclarationOfThisName'

		self.widenStorageBytesFor(alias)
		self.widenPackedBitsFor(alias)
	end 'widenElementWidthFor'

	// The BYTE half of the fold, for the second and later declarations of a name: the widest slot any of
	// them needs, so no file's range is ever truncated by another file's width.
	function widenStorageBytesFor(alias RangedTypeAlias)
		let width = rangedAliasStorageBytes(alias.low, high: alias.high)
		let widest = try self.storageBytes.get(alias.name) otherwise panic("RangedAliasRegistry.widenStorageBytesFor: '{String.from(alias.name)}' has a later declaration and no first one — `widenElementWidthFor` seeds both indices together, so a miss here means something else wrote one of them")

		if width > widest 'wider'
			self.storageBytes.upsert(alias.name, value: width)
		end 'wider'
	end 'widenStorageBytesFor'

	// The PACKED half of the fold, for the second and later declarations of a name.
	//
	// ⚠ **A BYTE BEATS EVERY PACKED WIDTH, WHICH IS WHY `NotSubBytePacked` IS ABSORBING RATHER THAN
	// SMALLEST.** It is the same "widest wins" rule the byte fold above applies, read on the correct
	// ladder: a byte-strided slot holds every value a 4-bit field holds, so a name one file declares
	// `int(0 to 3)` and another `int(0 to 100)` must stride a BYTE — and `NotSubBytePacked` is 0, which
	// a naive `>` would treat as the narrowest answer and pack the name at 2 bits, truncating the file
	// that meant 100. Reached only when a name has a second declaration, which is nearly no name.
	function widenPackedBitsFor(alias RangedTypeAlias)
		let bits = rangedAliasPackedBits(alias.low, high: alias.high)
		let sofar = try self.packedBits.get(alias.name) otherwise panic("RangedAliasRegistry.widenPackedBitsFor: '{String.from(alias.name)}' has a byte width and no packed one — the two indices are seeded together by `widenElementWidthFor` and cannot disagree about which names they hold")

		if sofar == NotSubBytePacked 'alreadyAByteOrWider'
			return
		end 'alreadyAByteOrWider'

		if bits == NotSubBytePacked or bits > sofar 'wider'
			self.packedBits.upsert(alias.name, value: bits)
		end 'wider'
	end 'widenPackedBitsFor'

	// ⭐⭐ **CAN A VALUE OF `name` HOLD EVERY BYTE — 0 THROUGH 255 — WHICHEVER FILE'S DECLARATION YOU READ?**
	// The THIRD file-less door, and it is one for the SAME reason `storageBytesInEveryFile` is: the answer is
	// not any one file's. Where that door folds to the WIDEST width so no file's range is truncated, this one
	// demands the property of EVERY declaration, so no file's range is over-promised. `underlyingInAnyFile`'s
	// refusal to hand out bounds is untouched — a reader with no file may not learn what SOME file's `low`
	// and `high` are, and this reader never does; it learns only whether they all clear one fixed bar.
	//
	// ⚠ **THE BAR IS THE VALUE SET AND NOT THE WIDTH, AND THE TWO ARE A MEASURED WRONG ANSWER APART.**
	// `rangedAliasStorageBytes` gives EVERY non-negative range that fits `u8.max` a ONE-BYTE slot, so
	// `int(0 to 200)` strides one byte and cannot hold `223`. Its only reader is the byte-element boundary
	// (`ProgramSignatures.byteBufferBoundaryAdmits`), where a compiler-synthesized buffer — a run of RAW
	// bytes — is admitted into a declared `Array with Byte`: what receives one must admit every value a byte
	// has, and a slot that merely fits in one byte is not that.
	//
	// ⚠ It is asked only after two aggregate names have already DISAGREED, which is a rejected program's
	// path, so the walk over one name's declarations costs every compiling program nothing.
	//
	// `throws` is `Map.get`'s own channel: a name NO file declares is not a ranged alias at all, and what
	// the compiler's own two byte elements are worth is the caller's to state, not this index's to invent.
	// ⭐⭐ **IS `name` A PURE SECOND NAME FOR `int` — the WHOLE i64 span, whichever file's declaration you
	// read?** The `holdsEveryByte` twin one bar up, and its reader is the inferred-int-element boundary
	// (`ProgramSignatures.inferredIntColumnBoundaryAdmits`): an array a bare `[10, 20, 30]` built carries the
	// compiler's own `integer` element, and it may cross into a declared `Array with <alias>` exactly when
	// that alias adds NOTHING to `int` — no narrower value set to check, and (a consequence, not a second
	// condition) no narrower slot, since `rangedAliasStorageBytes` gives the full span the machine word.
	//
	// ⚠ **THE BAR IS BOTH ENDS EXACTLY, NOT "WIDE ENOUGH".** A range is compared as the RAW 64-bit pattern
	// (`RangedTypeAlias`'s header), so a `high` above `i64.max` is indistinguishable from a negative one —
	// `typealias Big = int(0 to u64.max)` would read as spanning everything while refusing every negative
	// element a literal may hold. Demanding the exact pair is the only reading those bits support, and it is
	// also the only one under which the crossing is observationally free.
	//
	// ⚠ Asked only after two aggregate names have already DISAGREED — a rejected program's path — so the walk
	// over one name's declarations costs every compiling program nothing, exactly as its twin does.
	export function spansEveryIntInEveryFile(name ByteArray) returns bool throws MapError
		if let byFile = try self.multiplyDeclared.get(name) 'declaredByMoreThanOneFile'
			for (_, alias) in byFile 'eachDeclaringFile'
				if not rangeSpansEveryInt(alias.low, high: alias.high) 'thisFilesDeclarationDoesNot'
					return false
				end 'thisFilesDeclarationDoesNot'
			end 'eachDeclaringFile'
			return true
		end 'declaredByMoreThanOneFile'

		let sole = try self.byName.get(name)
		return rangeSpansEveryInt(sole.low, high: sole.high)
	end 'spansEveryIntInEveryFile'

	export function holdsEveryByteInEveryFile(name ByteArray) returns bool throws MapError
		if let byFile = try self.multiplyDeclared.get(name) 'declaredByMoreThanOneFile'
			for (_, alias) in byFile 'eachDeclaringFile'
				if not rangeHoldsEveryByte(alias.low, high: alias.high) 'thisFilesDeclarationCannot'
					return false
				end 'thisFilesDeclarationCannot'
			end 'eachDeclaringFile'
			return true
		end 'declaredByMoreThanOneFile'

		let sole = try self.byName.get(name)
		return rangeHoldsEveryByte(sole.low, high: sole.high)
	end 'holdsEveryByteInEveryFile'

	// ⭐⭐ **DECIDE WHICH NAMES ARE RANGE-CONTESTED, AND MINT THE QUALIFIED DECLARATION EACH DISTINCT RANGE
	// GETS (N2)** — the answer the door above cannot give, made once, after every declaration is in.
	//
	// `widenStorageBytesFor`'s header states the constraint this settles: a generic instance is interned on
	// the element's NAME, so `Array with Byte` is ONE instance with ONE `element_size@24` however many files
	// declare `Byte`, and the fold to the widest is the only honest width for it. That is correct and it is
	// not enough — `stdlib/File.maxon` BUILDS a byte buffer through that instance (`__ManagedMemory.create(n,
	// 1)`), so a user's `typealias Byte = int(0 to 1000)` made the stdlib's own buffer stride two and
	// `file.read(managed, …)` refuse it (E3005 at `stdlib/File.maxon:74`, on a program that never mentions
	// `File`). **No width rule can fix that: the two `Array with Byte` must become two INSTANCES.**
	//
	// ⇒ a name whose declarations disagree about the range gets one MINTED declaration per distinct range —
	// `Byte$0_255` beside `Byte$0_1000` — and an instance's element is spelled with the mint its READER
	// resolves to (`rangeScopedName`).
	//
	// ⭐ **THE MINT IS AN ORDINARY REGISTRY DECLARATION, AND THAT IS THE WHOLE DESIGN.** Every door this
	// registry already has then answers for the qualified name with no new code and no special case: the
	// whole-program width (`storageBytesInEveryFile`, which now folds ONE range and so reads 1 for the
	// stdlib's element and 2 for the user's), the erasure (`underlyingInAnyFile`), the scoped `lookup` a
	// range check resolves through. A bare synthesized STRING would miss all of them — measured in the
	// design: `undeclaredNamedElementSlot` would stride the stdlib's byte array at 8.
	//
	// ⚠ **A NAME ONLY ONE FILE DECLARES CANNOT REACH HERE AT ALL**, because `multiplyDeclared` holds only
	// the names two or more files declare — and a name every declaration of which agrees about the range
	// falls out on the `< 2` test. That is the ENTIRE existing corpus: `int(0 to 255)` and `int(0 to u8.max)`
	// mint the identical spelling — `u8.max` is resolved to its value before the mint is spelled — so every
	// `stdlib/` file declaring `Byte` and every spec file declaring it are one claimant between them, this
	// map stays EMPTY, and no element name anywhere moves. (The corpus counts are deliberately NOT written
	// down: they move with every ported spec, and `grep -rho 'typealias Byte *= *[^ ]*([^)]*)' specs-shv2/`
	// answers the question that actually matters — how many DISTINCT ranges, not how many files.)
	//
	// ⚠ **THE CONTEST IS COLLECTED BEFORE ANY MINT IS RECORDED**, because `record` writes into the very map
	// this walks.
	//
	// ⚠ **AND NOT ONE NAME IS SPELLED UNTIL A CONTEST IS PROVEN, WHICH IS A MEASURED COST AND NOT A STYLE.**
	// The dedup below compares the BOUNDS; spelling each declaration to compare the STRINGS reads the same
	// and cost **+100/+164/+292/+548/+1,060/+2,084 allocations** across the scale ladder (A/B, both binaries
	// swapped into ONE path) — a `ByteArray` per declaration of every multiply-declared name, exactly
	// DOUBLING per rung. Every one of them was thrown away, because the corpus contests nothing.
	//
	// ⚠ **WHAT IS LEFT IS THE WALK ITSELF, AND IT IS MEASURED RATHER THAN ARGUED AWAY: +18…+266 allocations
	// over the same ladder, 0.0014% of the compile at rung 5, DEAD LINEAR.** Iterating a `Map` costs an entry
	// tuple per entry, so this is the price of looking at every multiply-declared name once — and the corpus
	// has plenty of those (`stdlib/`'s seven `Byte` declarations are one of them) even though none is
	// CONTESTED. Gating the walk on an accumulator `record` maintains was tried and buys ~2%: the array this
	// pass allocates per name is not the cost, the iteration is. It is left as a single readable structure
	// rather than split into a write-side flag and a read-side answer.
	// ⚠⚠ **THE CONTEST MAP IS PUBLISHED LAST, AFTER THE MINTS IT GUARDS ARE IN THE REGISTRY (N2 review).**
	// `anyRangeContest()` — hence `fileScopedInstance`, hence every qualified element name in the compiler —
	// is exactly the test `self.rangeContested.count() > 0`. The moment that answers true, a reader may ask
	// for `Byte$0_1000`, and a `Byte$0_1000` the registry does not hold answers the WIDTH FALLBACK
	// (`undeclaredNamedElementSlot`), which — since `isByteElementName` asks about the BASE name —
	// hands a 2-byte element a ONE-BYTE stride with no diagnostic. Building into a LOCAL and assigning at the
	// end makes "the mints exist before anything can name them" a property of the code rather than of the
	// fact that nothing currently runs between the two loops.
	export function settleRangeContests()
		var mints = RangedTypeAliasArray.create()
		// ⚠ **BUILT OWNED, AND THE SHARED EMPTY HANDLE IS WHAT THE FIELD KEEPS WHEN NOTHING IS CONTESTED.**
		// This used to start AS `sharedEmptyRangeContests` and copy-on-write on the first contest, guarded by
		// an `is`-identity test. That is a mutable name reaching a module-level `let`'s record, which single
		// ownership refuses (E3019 at the `upsert`) — the guard that made it safe is invisible to the rule,
		// and the rule is about what the name CAN reach. The publish below is already gated on `count() > 0`,
		// so an uncontested program still never touches the field; what it now costs is one empty map.
		var settled = RangeContestedAliasMap.create()
		for (name, byFile) in self.multiplyDeclared 'eachMultiplyDeclaredName'
			var claimants = RangedTypeAliasArray.create()
			for (_, alias) in byFile 'eachDeclaration'
				if not holdsRange(claimants, low: alias.low, high: alias.high) 'aRangeNoEarlierDeclarationClaimed'
					claimants.push(alias)
				end 'aRangeNoEarlierDeclarationClaimed'
			end 'eachDeclaration'

			if claimants.count() < 2 'everyDeclarationAgreesAboutTheRange'
				continue
			end 'everyDeclarationAgreesAboutTheRange'

			var spellings = ByteArrayArray.create()
			for claimant in claimants 'eachDistinctRange'
				let spelling = rangeQualifiedAliasName(name, low: claimant.low, high: claimant.high)
				spellings.push(spelling)
				mints.push(rangeQualifiedMint(claimant, spelling: spelling))
			end 'eachDistinctRange'

			settled.upsert(name, value: spellings)
		end 'eachMultiplyDeclaredName'

		// ⚠ RECORDED BEFORE THE PUBLISH BELOW, and separately from the walk above because `record` writes
		// `multiplyDeclared` — the very map that walk iterates.
		for mint in mints 'eachMint'
			// The outcome is `record`'s cross-file E3105 answer, and a mint can never be the right thing to
			// blame for one: two claimants of ONE spelling share a range, hence a primitive, and the only way
			// two ranges could mint one spelling is an `int`/`float` pair whose bounds share a bit pattern —
			// which the BASE name has already earned E3105 for, against the line the author wrote.
			_ = self.record(mint)
		end 'eachMint'

		// The PUBLISH. Guarded on `count()` so an uncontested program never reassigns the field at all — it
		// keeps the shared handle it was born with, rather than being handed the same handle a second time.
		if settled.count() > 0 'someNameIsContested'
			self.rangeContested = settled
		end 'someNameIsContested'
	end 'settleRangeContests'

	// ⭐ **DOES ANY NAME IN THIS PROGRAM HAVE DECLARATIONS THAT DISAGREE ABOUT THE RANGE?** The ONE bool
	// every scoping door short-circuits on, so an uncontested program — the whole corpus, and the compiler's
	// own source — pays a single map-emptiness test and nothing else, and no interned element name, no
	// mangled symbol and no committed golden can move.
	export function anyRangeContest() returns bool
		return self.rangeContested.count() > 0
	end 'anyRangeContest'

	// ⭐⭐ **EVERY DISTINCT READING ENVIRONMENT A RANGE-CONTESTED PROGRAM HAS (N2)** — one path per file that
	// declares a contested name, plus the EMPTY path, which is how a file that declares none of them reads
	// (`lookup` falls through `readersOwnFile` to the nameable tier and then to the bare one, and that answer
	// is the same for every such file).
	//
	// ⭐ **IT EXISTS SO THE PARSE CAN STAY A PURE READ.** A file's parse may not be the first to intern an
	// instance — the shared registry is written by the sweep and by nothing that fans out — so every
	// (instance, environment) pair a parse could ask for is interned in one pass beforehand
	// (`ProgramSignatures.settleRangeScopedInstances`), and this is the list that makes that pass COMPLETE:
	// a reader's answer is one of these declarations or the stranger's, and there is no third case.
	export function rangeContestEnvironments() returns FilePathArray
		var environments = FilePathArray.create()
		environments.push(CompilerOwnedDeclFilePath)
		for (name, _) in self.rangeContested 'eachContestedName'
			for (_, alias) in self.contestedDeclarations(name) 'eachDeclaration'
				environments.push(alias.declFilePath)
			end 'eachDeclaration'
		end 'eachContestedName'
		return environments
	end 'rangeContestEnvironments'

	// ⭐⭐ **WHAT `name` IS CALLED AS A GENERIC-INSTANCE ELEMENT WHEN READ FROM `readerFilePath` (N2)** —
	// the bare name for every name in an uncontested program, and the reader's OWN claimant's mint for a
	// contested one.
	//
	// ⭐ **IT RESOLVES THROUGH `lookup`, NOT THROUGH A SECOND RULE.** Which declaration a file means is
	// already decided in exactly one place, with its own precedence (own file, then a nameable one, then the
	// bare fallback) and its own measured wrong answers behind it. Deriving the element spelling from that
	// answer is what keeps "which `Byte` does this file mean?" and "which `Array with Byte` does it build?"
	// one question — the shape the whole rung exists to restore.
	export function rangeScopedName(name ByteArray, readerFilePath FilePath) returns ByteArray
		if not self.rangeContested.contains(name) 'everyDeclarationAgreesAboutTheRange'
			return name
		end 'everyDeclarationAgreesAboutTheRange'

		match self.lookup(name, readerFilePath: readerFilePath) 'resolved'
			// Unreachable while `rangeContested` is derived from `multiplyDeclared`, whose every entry is a
			// declaration `lookup` can find — but stated rather than assumed, because a contested name with
			// no declaration would mean the two indexes had come apart.
			undeclared then panic("RangedAliasRegistry.rangeScopedName: '{String.from(name)}' is range-contested but resolves to no declaration from '{readerFilePath.toString()}'")
			declared(alias) then return rangeQualifiedAliasName(name, low: alias.low, high: alias.high)
		end 'resolved'
	end 'rangeScopedName'
end 'RangedAliasRegistry'

// One MINTED declaration of a contested name's range — the same `underlying`, bounds and declaring file as
// the claimant it qualifies, under the qualified spelling.
//
// ⚠ **ITS TIER IS `global`, WHERE THE CLAIMANT'S MAY BE `file`.** The claimant is whichever declaration of
// this range `settleRangeContests` reached first, which is a map's iteration order; carrying its tier would
// make an unobservable field depend on that order. `global` is also the honest answer — a mint is
// compiler-supplied, exactly like the seeds `builtinStdlibAlias` builds, and its NAME is unspellable in
// source (`CompilerQualifiedAliasSeparator`), so no reader can be admitted or refused by the tier anyway.
function rangeQualifiedMint(claimant RangedTypeAlias, spelling ByteArray) returns RangedTypeAlias
	return RangedTypeAlias.create(spelling, underlying: claimant.underlying, low: claimant.low, high: claimant.high, visibility: Visibility.global, declFilePath: claimant.declFilePath, nameLine: claimant.nameLine, nameColumn: claimant.nameColumn)
end 'rangeQualifiedMint'

// Has an earlier claimant already taken this RANGE? A LINEAR scan and not a set, because the list holds one
// entry per DISTINCT range of one name — one for nearly every name in any program, two or three where there
// is a contest at all — and a `Set` would cost an allocation per multiply-declared name to spare a
// comparison of two. It compares the BOUNDS and never a rendered name, which is what keeps the uncontested
// walk allocation-free (see `settleRangeContests`).
function holdsRange(claimants RangedTypeAliasArray, low ParsedInt, high ParsedInt) returns bool
	for held in claimants 'each'
		if held.low == low and held.high == high 'alreadyClaimed'
			return true
		end 'alreadyClaimed'
	end 'each'
	return false
end 'holdsRange'

// ⭐ **DOES `low to high` CONTAIN EVERY BYTE VALUE, 0 THROUGH `u8.max`?**
// `holdsEveryByteInEveryFile`'s per-declaration test, spelled apart from it because it is a statement about
// a RANGE and not about the registry.
//
// ⚠ **IT HAS TWO READERS AND THEY ASK IT AT DIFFERENT QUANTIFIERS, WHICH IS WHY THE TEST ITSELF IS THE ONE
// EXPORTED THING (A4a).** `holdsEveryByteInEveryFile` above quantifies over every DECLARATION of a name,
// because its reader (`byteBufferBoundaryAdmits`) has only a name and no file. `Parser.requireRawByteFillFitsItsElement`
// holds a specific INSTANCE and therefore the reading file's own mint, so it asks about that one alias and
// nothing else. Two quantifiers over one predicate is the honest shape; a second spelling of `low == 0 and
// high >= u8.max` would be a second definition of what a byte is.
//
// ⚠⚠ **A NEGATIVE BOUND IS AMBIGUOUS AND IS ANSWERED NO — BOTH ENDS.** Bounds ride as the RAW 64-bit
// pattern (`RangedTypeAlias`'s header), so `-1` and `u64.max` are the SAME BITS: a negative `low` is either
// a genuine negative lower bound (which does contain 0) or a bound above `i64.max` (which does not), and
// nothing here can tell them apart. `rangedAliasStorageBytes` conflates them too and resolves it by taking
// the WIDEST slot, which is its safe direction; this door's safe direction is the opposite one — refuse —
// because its answer ADMITS a buffer of raw bytes into a declared element. So the lower bound must be
// EXACTLY zero, which is also the only lower bound a byte can honestly have, and a raw-negative `high`
// fails `>= u8.max` on the same bits for the same reason.
//
// ⚠ Nothing is lost by that: an element with a negative lower bound is not byte-packed either
// (`rangedAliasStorageBytes` gives it the machine word), so the boundary's stride test refuses it a second
// time. The two clauses agree here rather than one leaning on the other.
export function rangeHoldsEveryByte(low ParsedInt, high ParsedInt) returns bool
	return low == ByteValueSetLow and high >= ByteValueSetHigh
end 'rangeHoldsEveryByte'

// ⭐ **DOES THIS RANGE SPAN EVERY `int` — i.e. is the alias declaring it a pure second NAME for `int`?**
// EXACT on both ends, for the reason `spansEveryIntInEveryFile` states: the bounds are raw 64-bit patterns,
// so anything looser reads a bound above `i64.max` as one below zero. `I64MinBound`/`I64MaxBound` are the
// very constants `Parser.parseInt` enforces, so what "every int" means here cannot drift from what the lexer
// admits.
function rangeSpansEveryInt(low ParsedInt, high ParsedInt) returns bool
	return low == I64MinBound and high == I64MaxBound
end 'rangeSpansEveryInt'

// ⭐ **WHAT A BYTE'S VALUE SET IS, WRITTEN DOWN ONCE.** The test above measures a DECLARED element against
// these two bounds; `ProgramSignatures.elementIntegerValueRange` hands the same two out as the value set the
// COMPILER-OWNED byte element (`SynthesizedByteElementName`) admits, because a buffer the compiler minted is
// a run of raw bytes and has no declaration to read bounds off. Spelling `0` and `u8.max` at the second site
// would be a second definition of what a byte is — the thing this file's own header refuses at length.
export let ByteValueSetLow = 0 as ParsedInt
export let ByteValueSetHigh = u8.max as ParsedInt

// --- The TYPE-NAME namespace: one name, one declaration ---

// ⭐ **THE KIND OF DECLARATION THAT MINTED A TYPE NAME.** Five keywords mint one, and `typealias`
// mints THREE different things, so this is SEVEN cases and not five: the alias forms denote a
// primitive, a function type and a generic instance respectively, and only the first of them is
// resolved per declaring FILE. That difference is the whole axis the cross-file carve-out turns on
// (see `TypeNameRegistry`), so it may not be collapsed to the keyword.
//
// ⚠ **THE ALIAS FORMS ARE A CONTIGUOUS BAND, AND TWO RANGE ARMS READ IT** —
// `typeDeclKeyword` (they share one keyword) and `isTypeAliasDecl` (they share the carve-out and the
// code a collision earns). Append a new alias form INSIDE the band and any other kind BEFORE it; a
// kind inserted between `rangedAlias` and `genericAlias` is silently swallowed by both, with no
// missing-case error. This is `StdOp`'s band-append invariant, on a much smaller union.
export enum TypeDeclKind
	structType
	enumType
	unionType
	interfaceType
	rangedAlias
	functionAlias
	genericAlias
	// ⭐ `typealias Pair = (Num, Num)` (P1.10) — a name for a synthesized TUPLE type. Appended at the END of
	// the alias band, which is the invariant that keeps `rangedAlias to …` range arms honest: an insertion
	// between two endpoints is silently swallowed, so both arms below name the new endpoint explicitly.
	tupleAlias
end 'TypeDeclKind'

// The SOURCE KEYWORD that introduced a declaration of this kind — the word a diagnostic must call it
// by. The ONE place a `TypeDeclKind` is turned into that word (`EnumLayout.kindWord` reads it from
// here rather than spelling `enum`/`union` a second time). The three alias forms share `typealias`
// because that is what the author typed; the form distinction is a resolution fact, not a spelling
// one, and a message that invented `ranged typealias` would name a keyword no program contains.
//
// ⚠ **THESE FIVE LITERALS ARE A SECOND SPELLING OF `TokenKind`'s, AND THAT IS A MEASURED CHOICE, not
// an oversight.** `TokenKind.type.rawValue` and friends are where the language defines the words, and
// sourcing them from there was tried: it COMPILES and it costs **+26,503 code bytes** in the
// compiler (6,934,377 -> 6,960,880), because a string-backed enum's `rawValue` does not fold to its
// literal at a `gives` arm — it is a real accessor, not a constant. A rung whose whole claim is
// byte-neutral codegen does not spend 26 KB to delete five words. What holds the copies in step
// instead is the SUITE: `specs-shv2/type-name-collision.md` pins `type`, `typealias`, `interface` and
// `union` in a golden, and `EnumLayout.kindWord` — this function's only other reader — is golden-gated
// for `enum` and `union` across `specs-shv2/enum-match-exhaustive.md`. Rename a keyword: those fail.
export function typeDeclKeyword(kind TypeDeclKind) returns String
	return match kind 'k'
		structType gives "type"
		enumType gives "enum"
		unionType gives "union"
		interfaceType gives "interface"
		rangedAlias to tupleAlias gives "typealias"
	end 'k'
end 'typeDeclKeyword'

// Is this one of the `typealias` forms? It decides two things at once, which is why it is asked
// rather than re-derived: WHICH CODE a collision earns (E3061 is "two typealiases in scope declare
// the same name"; everything else is E3006) and whether a cross-file pair is legal at all.
export function isTypeAliasDecl(kind TypeDeclKind) returns bool
	return match kind 'k'
		structType to interfaceType gives false
		rangedAlias to tupleAlias gives true
	end 'k'
end 'isTypeAliasDecl'

// ONE declaration that minted a type name, with where it was written. The position is the NAME
// token's, never the keyword's — a collision blames the declaration the author just wrote, and
// `RangedTypeAlias` already anchors E3061 that way.
export type TypeNameDecl
	export let name as ByteArray
	export let kind as TypeDeclKind
	export let declFilePath as FilePath
	export let nameLine as LineNumber
	export let nameColumn as ColumnNumber

	export static function create(name ByteArray, kind TypeDeclKind, declFilePath FilePath, nameLine LineNumber, nameColumn ColumnNumber) returns TypeNameDecl
		return Self{name: name, kind: kind, declFilePath: declFilePath, nameLine: nameLine, nameColumn: nameColumn}
	end 'create'
end 'TypeNameDecl'

// One file's type-name declarations, IN SOURCE ORDER. The order is the point and it is why this is
// one array rather than a position added to each of the four layout types: `structTypes`,
// `enumTypes`, `interfaces` and `typeAliases` are separate arrays, so which of a file's `type Box`
// and `typealias Box` came SECOND is a fact none of them holds. Blaming the wrong one of a pair is
// exactly the misdiagnosis this rule exists to remove.
export typealias TypeNameDeclArray = Array with TypeNameDecl

// Type name -> the most recent ACCEPTED declaration of it. See `TypeNameRegistry`.
typealias TypeNameDeclMap = Map with (ByteArray, TypeNameDecl)

// What ONE declaration collided with, and therefore which diagnostic it earns. `accepted` covers
// both "first declaration of this name" and the legal cross-file alias case; the collision arm
// carries the INCUMBENT, because the reporter blames the newcomer and names the incumbent's keyword.
export union TypeNameRecordOutcome
	accepted
	collides(winner TypeNameDecl)
end 'TypeNameRecordOutcome'

// ⭐ **THE TYPE-NAME REGISTRY — the ONE decider of "is this type name already declared?".**
//
// Every one of `type` / `enum` / `union` / `interface` / `typealias` files its name in a whole-program
// map keyed by the BARE name, and nothing checked that two of them had not claimed the same one. A
// FIXED cascade then picked the winner (`denotedNamedType`: struct, then enum, then alias), so the
// answer was decided by the compiler's arm order and by the merge order, never by the author:
// `type Box` plus `typealias Box` compiled completely clean with the alias discarded, and the same
// pair written the other way round reported `E3009: Cannot cast from int to struct` — a consequence,
// not a diagnosis.
//
// **THE RULE: a type name is declared exactly once**, with ONE exception.
//
// ⚠ **THE EXCEPTION IS PER ALIAS FORM, NOT PER KEYWORD, and `stdlib/` needs both halves of that.**
// A non-exported `typealias` is FILE-LOCAL (`specs/duplicate-typealias.md`), so two files may each
// declare one — SEVEN stdlib files declare `Byte = int(0 to u8.max)` (ranged) and FIVE declare
// `ByteArray = Array with Byte` (generic-instance). So the carve-out must cover the generic form as
// well as the ranged one, or all of `stdlib/` stops loading.
//
// It must NOT cover a pair of DIFFERENT forms, and that is measured rather than assumed: only the
// RANGED registry is file-scoped, so a `typealias Handler = function() returns int` in one file
// answers for every file, and a file whose own `Handler` is `int(0 to 10)` had its own
// `5 as Handler` rejected with `Cannot cast from int to function`.
//
// **OUT OF SCOPE, and unchanged:** two SAME-FORM aliases in two files that do not AGREE — two
// function aliases with different signatures, two instance aliases over different instances — still
// resolve last-wins. That is cross-file name resolution (the rung that also owns E3063); the ranged
// form's half of it is already enforced as E3105.
//
// ⚠ **THIS REGISTRY HOLDS ONLY THE NAMES A DECLARATION SPELLS, AND THAT IS NOW THE WHOLE NAMESPACE.** A
// generic instantiation spells no name: it COMPILES to a string every per-type symbol is derived from
// (`Box_String` ⇒ `__destruct_Box_String`), and when that string is one a declaration already holds,
// `ProgramSignatures.mangleGenericInstance` mints it behind the reserved `__` prefix instead
// (`reservedIfDeclared`, P1.7). The compiled half is therefore DISJOINT from this one by construction,
// so nothing here is contestable and this registry has no instantiation reader at all — which is why it
// answers only `record`. `ParseStaging.checkTypeSymbolNamespace` still owns the compiled half, but it is
// now a check between two INSTANTIATIONS and never consults a declaration.
export type TypeNameRegistry
	// ⚠ **THE MOST RECENT *ACCEPTED* DECLARATION OF EACH NAME — NOT THE FIRST, AND THE DIFFERENCE IS
	// THE WHOLE SAME-FILE CHECK.** A file's declarations are contiguous in the record stream (one
	// artifact at a time, each file merged exactly once, its own decls in source order), so "the
	// newcomer's file is the last accepted declaration's file" is EXACTLY "this file already declared
	// this name" — the only question the same-file half of the rule asks, and one a map holding the
	// FIRST declaration structurally cannot answer. Keeping the first instead let a file declare one
	// name twice IN SILENCE whenever any OTHER file also declared it: each of the two was compared
	// against the far file, found legal-repeated-alias, and accepted. That is `stdlib/`'s own shape —
	// seven files declare `Byte` — so the hole was open for every name the rule was written to protect.
	// It is the induction `RangedAliasRegistry` makes with `sole` + `byFile.contains(declPath)`, which
	// is where this check used to live.
	//
	// A REJECTED declaration never displaces: the build is failing either way, and every later
	// declaration of the name should be reported against one settled incumbent rather than against a
	// predecessor that was itself refused. Only `kind` and `name` are ever read off the incumbent (see
	// `reportTypeNameCollision`), so which ACCEPTED declaration is held changes no diagnostic text.
	var winners as TypeNameDeclMap

	export static function create() returns TypeNameRegistry
		return Self{winners: TypeNameDeclMap.create()}
	end 'create'

	// File one declaration, and answer whether it COLLIDED. The single place the rule is applied, so
	// the legality test and the insert cannot come to disagree about which declarations collide.
	export function record(decl TypeNameDecl) returns TypeNameRecordOutcome
		let winner = try self.winners.get(decl.name) otherwise 'firstDeclarationOfThisName'
			self.winners.upsert(decl.name, value: decl)
			return TypeNameRecordOutcome.accepted
		end 'firstDeclarationOfThisName'

		if isLegalRepeatedAlias(winner, newcomer: decl) 'fileLocalAlias'
			// It is ACCEPTED, so it becomes the incumbent the NEXT declaration of this name is measured
			// against — which is what lets the next one be recognized as this file declaring it twice.
			self.winners.upsert(decl.name, value: decl)
			return TypeNameRecordOutcome.accepted
		end 'fileLocalAlias'

		return TypeNameRecordOutcome.collides(winner)
	end 'record'

	// ⭐ **WHERE A TYPE NAME WAS DECLARED** — the anchor a diagnostic about a whole DECLARATION (rather than
	// about a use of it) has to point at. `TypeCycleCheck` is the reader: E4014 blames `type Node`, at the
	// NAME token, and none of the four per-kind registries carries a position (`StructLayout` and `EnumLayout`
	// hold only `declFilePath`), which is precisely the gap this registry was built over.
	//
	// A name no declaration filed has no answer, which is why it throws rather than inventing a position —
	// the sentinel `0:0` would be indistinguishable from a compiler-synthesized declaration's real one.
	export function declarationOf(name ByteArray) returns TypeNameDecl throws MapError
		return try self.winners.get(name)
	end 'declarationOf'
end 'TypeNameRegistry'

// The ONE exception to "a type name is declared exactly once": the SAME alias form, in a DIFFERENT
// file. Both halves are load-bearing and each is stated where it is enforced —
//   • same FORM, because only the ranged registry is file-scoped and only same-form pairs of the two
//     bare registries agree by construction in `stdlib/` (see `TypeNameRegistry`);
//   • different FILE, because two declarations in ONE file are what no qualification could ever
//     disambiguate, which is exactly what E3061 has always said (`specs/export-keyword.md`).
//
// ⚠ `winner` must be the LAST ACCEPTED declaration of the name and not the first, or the file test
// asks the wrong question — see `TypeNameRegistry.winners`, where the reason is stated in full.
function isLegalRepeatedAlias(winner TypeNameDecl, newcomer TypeNameDecl) returns bool
	if not isTypeAliasDecl(winner.kind) or winner.kind != newcomer.kind 'notOneAliasForm'
		return false
	end 'notOneAliasForm'

	return not winner.declFilePath.equals(newcomer.declFilePath)
end 'isLegalRepeatedAlias'

// --- Range-check sites (P1.9) — the parser's carrier for `InsertRangeChecks` ---
//
// ⭐ WHY A SIDE TABLE AND NOT A MARKER OP. A value meeting a ranged alias produces nothing of its
// own — a narrowing `as` cast RETAGS its operand and flows it on unchanged, and a store writes the
// value the source already named — so there is nothing for an IR op to define, and every position
// that must be checked (an `as`-cast operand, a ranged `return`, a struct-literal field, a field
// store, a field's declared default, an array element, a call argument) is found by the parser at
// PARSE time, not by any later structural walk. A dedicated `MaxonOp` would ALSO force a new arm
// into every exhaustive `MaxonOp` match — including the escape-analysis functions the closures/async
// rung owns and is actively editing — so the site is recorded HERE instead, keyed by the enclosing
// function's (unique) name, and resolved by the Std-tier `InsertRangeChecks` pass.
//
// ⭐ **THE SIDE TABLE IS ALSO WHAT MAKES THE ERASURE SURVIVABLE, AND THAT IS THE WHOLE DESIGN.**
// `TypeResolution.resolveNamedType` collapses a plain ranged alias to its primitive and DROPS the
// range, and `syncResolvedSignature` writes that back into `project.funcSignatures` — so by
// `semanticCheck` a parameter's declared `Percent` is bare `int`. Both reference compilers check a
// call argument through a lossy projection of the type (the bootstrap's pre-fix `MaxonValueKind`, v1's
// `CastCategory`) and neither can see a range through it. Recording the NAME here, off the still-named
// `MaxonType`, is immune to that by construction.
//
// The bounds live only in `typeAliases` (an alias resolves AWAY to its primitive before the
// pass runs), so a site carries the alias NAME and the pass looks the bounds up — the linchpin
// the "retain the alias" requirement exists for. `value` is the flat Std `ValueId` the operand
// carries (ids pass through `lowerMaxonToStd` verbatim), never a name string. `line`/`column`
// anchor the E3005 diagnostic and the runtime panic message on the source position.

// ⭐ **WHICH HALVES OF THE RULE A POSITION OWES.** `range-check-panic.md` states both — a compile-time
// E3005 for a value the compiler can fold, and a runtime check where an unfoldable value LANDS — and
// **EVERY POSITION NOW OWES BOTH EXCEPT ONE: the CALL ARGUMENT AT A CONCRETE PARAMETER, which owes the
// compile-time half alone.**
//
// The reason that one position can owe only the first half is mechanical: a runtime check is a BRANCH, so
// it splits the block it lands in, and a call argument is evaluated part-way through building an argument
// list. shv2 emits its guards a tier later than the bootstrap does — so it never splits a block
// mid-argument-list and never hits the bootstrap's arg-pinning `E9001` — but it also has no alias to
// check against at the argument: the parameter belongs to a callee that may be declared in another file
// (`RangeCheckArgSite`), so no positioned site can be recorded there at all.
//
// ⭐⭐ **AN ARGUMENT AT AN *OPAQUE* PARAMETER IS THE EXCEPTION'S OWN EXCEPTION, AND IT OWES BOTH HALVES
// (ARRR).** The exemption above is not really "a call argument cannot be guarded" — it is "the CALLEE'S
// ENTRY guards it instead". A parameter declared `value T` has no range at that entry, because a generic
// body is compiled ONCE for every instantiation, so the exemption has nothing to hand the obligation to.
// The CALL SITE knows the substitution and therefore owes the whole rule; it records an ordinary
// alias-named site (below) at the position the `call` op is about to take, which puts the cascade exactly
// where the entry guard would have stood. See `Parser.recordOpaqueArgRangeChecks`.
//
// ⭐⭐ **A1f DID NOT DEFEAT THAT OBSTACLE — IT MOVED THE GUARD.** The runtime half of the argument door
// belongs to the CALLEE'S ENTRY instead: one guard per narrowed parameter per function, standing in front
// of every caller including the indirect ones (`RangeCheckParamSite`,
// `InsertRangeChecks.guardRangedParams`). So an argument site owes only the compile-time half, and the
// premise is enforced all the same.
//
// ⭐ **THE ARRAY ELEMENT WAS THE LAST POSITION LEFT OWING ONE HALF, AND `A1f-arrayelem` CLOSED IT FROM
// THE OTHER SIDE.** A1f's cure could not reach it — the element travels into a shared `Array` body whose
// parameter is the OPAQUE element type, so there is no narrowed parameter for an entry guard to stand
// behind. But the obstacle above never applied to it either: an element's alias is known at PARSE time,
// in the instance's declared element type, so it records an ordinary positioned site and its guard goes
// at the STORE, in front of the `__managed_*` call. See `Parser.requireContainerElementType`.
//
// ⚠ **WHAT IS STILL UNENFORCED IS NOT A POSITION** — it is the zero-initialized slot `Array.resize`
// EXPOSES, which no value ever crosses into. Pinned by `specs-shv2/safety.md`'s
// `divide-by-zero-fault-through-a-resized-array-slot`.
// ⚠ `module`, not `export`: `InsertRangeChecks` is the only reader and it sits under `Compiler/`, and
// shv2's own `checkUnusedExports` (E3093) is what says so — the SELF-COMPILE runs that pass and the
// bootstrap does not.
module enum RangeCheckGuard
	runtime
	compileTimeOnly
end 'RangeCheckGuard'

// One place a value MEETS a ranged alias whose name the parser already holds — an `as` cast, a
// struct-literal field, a field store, a field's declared default, an array element. `block` is the
// function-local BlockId the value is checked in (the parser's on-the-fly-SSA current block) — the guard
// must split THAT block, not the value's DEFINITION block. An int->int cast is a representational no-op
// with no Std op to anchor to, so without the block a cast of a value defined earlier (a parameter, or a
// value from a dominating block) would place its guard at the definition — which runs UNCONDITIONALLY,
// even when the cast sits in an unselected ternary arm / if-branch. BlockIds survive `lowerMaxonToStd`
// (blocks are cloned 1:1 keeping their id), so the Std pass finds the same block by id.
//
// ⚠ **THEY SURVIVE THE LOWERING; THEY DO NOT SURVIVE THE PARSER, AND ONE CONSTRUCT REWRITES THEM.** A
// ternary's TRUE ARM is parsed onto the unconditional path and then RELOCATED into a block minted
// afterwards, so a site recorded inside it names a block its value has left. `Parser.rehomeArmRangeSites`
// moves this pair with the ops — that function's header carries the two wrong answers it costs, one of
// which stopped shv2 compiling itself.
//
// ⭐⭐ **`maxonOpPos` IS WHERE IN THAT BLOCK, AND IT IS THE DIFFERENCE BETWEEN A PATH ANCHOR AND A
// STATEMENT ANCHOR.** The block alone says which path the guard runs on; without a position the guard
// can only go at the END of that block, so the whole rest of the block — every print, every call, every
// store and every division the out-of-range value reaches — runs BEFORE the check that forbids it.
// Measured against `maxon-sharp`: `b.v = bad` then `print("{b.v}")` printed the number 500 back out of a
// `Percent` field, and `z as NonZero` (z == 0) followed by `100 / d` died `integer divide by zero`
// instead of raising the range panic the language promises. Both exit 1, which is why no exit-code-only
// case could see either.
//
// It is the count of ops the recording block held at the moment the value was checked — i.e. the
// ordinal the CONSUMING op is about to take — because a cast is recorded BEFORE the store/call/division
// that spends its value is emitted. An int->int cast emits no op at all, so a MAXON ordinal is the only
// anchor there is.
//
// ⭐ **TWO POSITIONS, TWO TIERS, AND THE SITE CARRIES BOTH.** `maxonOpPos` is the PARSER's answer and
// means nothing at the Std tier, where each Maxon op has become N; `stdOpPos` is `LowerMaxonToStd`'s
// translation of it (`RangeSiteWalk`), and it is what `InsertRangeChecks` splits at. They are separate
// fields rather than one rewritten in place because a field that changes meaning at a tier boundary is
// a field the next reader has to date. `stdOpPos` is 0 until the lowering fills it, which
// `FunctionRangeChecks.positionsResolved` is the presence bit for — a `0` is a legitimate position (a
// guard at the very top of its block), so no value of it can mean "unset".
// ⚠ **IT CARRIES NO `RangeCheckGuard`, AND SINCE `A1f-arrayelem` IT CANNOT.** Every position that
// records one of these owes BOTH halves — the array element was the last that owed only the
// compile-time half, and its guard now goes at the STORE (`Parser.requireContainerElementType`). A field
// holding one value at every site is a fact written twice, and the copy that goes stale is the prose.
// The call-argument door is the one position that still owes the compile-time half alone, and it holds
// no site at all: it asks `guardVerdict` directly (`InsertRangeChecks.checkArgAgainstParamRange`).
// ⚠ **AN ARGUMENT AT AN OPAQUE `T` PARAMETER RECORDS ONE OF THESE (ARRR)**, and is not a counter-example to
// the paragraph above: its alias is not the CALLEE's to name — the callee has none — it is the receiver
// instance's substituted type argument, which the call site holds. So it is an ordinary alias-named door
// like every other, and it owes both halves like every other.
export type RangeCheckSite
	export var value as ValueId
	export var aliasName as ByteArray
	// ⭐⭐ **WHICH FILE'S DECLARATION OF `aliasName` THIS SITE RESOLVED — the site's own answer, not a
	// question left for the enforcer to re-ask.** `InsertRangeChecks` gets the BOUNDS by looking the name
	// up again (`guardVerdict`), and a lookup takes a READER, so the site has to say which reader it meant.
	// Recorded straight off the `RangedTypeAlias` the parser already resolved (`declFilePath`), so the
	// re-lookup lands on that same declaration by construction rather than by agreement.
	//
	// ⛔⛔ **IT USED NOT TO EXIST, AND `processSite` SUPPLIED THE SITE'S OWN FUNCTION'S FILE INSTEAD, ON THE
	// PREMISE THAT "every door here resolved its alias where it wrote it". THE ARM-SERVED DOOR BROKE THAT
	// PREMISE AND NOTHING NOTICED.** `recordArmServedIndexRangeCheck` resolves `ElementIndex` in
	// `stdlib/Array.maxon` — the CALLEE's file, because that is whose parameter it is — and then the name
	// alone travelled, so the enforcer re-resolved it against the CALLING file and got whatever
	// `RangedAliasRegistry.lookup` answers a stranger: the nameable tier, then bare last-wins.
	//
	// ⛔ **MEASURED 2026-08-30, and the wrong answer went in the worst direction — a user program's OWN
	// FILE-PRIVATE alias decided what `stdlib/Array.maxon`'s `set` accepts**, which is the exact defect
	// `lookup`'s nameable tier was built to close, reappearing at a door that never asked `lookup` the
	// reader it meant. A program declaring `typealias ElementIndex = int(0 to 3)` for its own use had
	// `a.set(9, value: 42)` on a 20-element array refused *"Value 9 is outside the range of 'ElementIndex'
	// (int(0 to 3))"*. With no user declaration, `stdlib/Vector.maxon`'s twin won — sabotage-proven both
	// ways: narrowing VECTOR's `ElementIndex` to `int(0 to 5)` refused an ARRAY index of 9, and narrowing
	// ARRAY's own had no effect whatsoever on `Array.get`/`set`/`resize`.
	//
	// ⚠ **IT CHANGES NO OTHER DOOR'S ANSWER, AND THAT IS MEASURED RATHER THAN ARGUED.** The argument alone:
	// every other site resolved through `lookup` with its own file as reader; whichever tier answered, the
	// declaration it returned was recorded from `declFilePath`, and a contested name files EVERY declaration
	// under `multiplyDeclared` — so re-asking with `declFilePath` hits that same declaration at the
	// `readersOwnFile` tier, and an uncontested name has one declaration for either reader to find.
	//
	// ⭐ **THE MEASUREMENT (2026-08-30), because an argument of that shape is exactly what this project keeps
	// finding to be wrong**: with the goldens minted against the CURED compiler, reverting `processSite`'s
	// one line and re-running the whole suite reported **0 of 6987 compared goldens differ**. The emitted
	// code of the entire corpus is byte-identical with and without this field; the only cases that move are
	// the two that pin the defect (`typealias-file-scope/*contested-element-index*`).
	export var aliasFilePath as FilePath
	export var block as BlockId
	export var maxonOpPos as BlockOpPos
	export var stdOpPos as BlockOpPos
	export var line as LineNumber
	export var column as ColumnNumber

	// `stdOpPos` is not a parameter: it is the LOWERING's to write, and the parser has no way to know it.
	export static function create(value ValueId, aliasName ByteArray, aliasFilePath FilePath, block BlockId, maxonOpPos BlockOpPos, line LineNumber, column ColumnNumber) returns RangeCheckSite
		return Self{value: value, aliasName: aliasName, aliasFilePath: aliasFilePath, block: block, maxonOpPos: maxonOpPos, stdOpPos: 0, line: line, column: column}
	end 'create'
end 'RangeCheckSite'

export typealias RangeCheckSiteArray = Array with RangeCheckSite

// ⭐ **THE ONE POSITION WHOSE ALIAS THE PARSER CANNOT NAME.** Every door above holds the DECLARED type
// with its alias still on it, so it resolves the name on the spot. A call argument does not: the
// parameter it lands on belongs to a callee that may be declared in another file, and a file's parse is
// a pure function of its own tokens plus the token-swept `ProgramSignatures` — which carries return
// types, not parameter types. So the site names the CALLEE and the argument's own position, and the
// whole-program `InsertRangeChecks` pass — which runs after every file has merged — reads the alias back
// off that callee's own `FunctionRangeChecks.paramSites`.
//
// `label` rides along unslotted because the label→position mapping has ONE home (`argSlotPosition`), and
// it needs the callee's `paramNames`, which is another whole-program read. Slotting it here would be a
// second copy of that mapping in the one place it is hardest to keep honest.
//
// ⚠ RECORDED ONLY FOR AN ARGUMENT THE PARSER HAS ALREADY FOLDED TO A CONSTANT. A call argument owes the
// compile-time half and nothing else, so an argument no constant folds to can produce no diagnostic and
// there is nothing for a site to say about it.
export type RangeCheckArgSite
	export var value as ValueId
	// ⭐⭐ **WHICH CALL THIS SITE CAME FROM — the name the SOURCE wrote, and the one field of the pair that is
	// never rewritten.** `callee` below is RETARGETED to the resolved overload member
	// (`SemanticCheck.retargetArgRangeSites`), so after the first retarget it no longer answers *"whose call
	// was this?"* — and that retarget finds its sites by matching the argument's `value`, which a `let`
	// binding passed to two different calls shares.
	//
	// ⛔⛔ **MEASURED ON THIS COMPILER'S OWN SOURCE, AND IT REFUSED A LEGAL PROGRAM.**
	// `arm64EmitStoreSlot(asm, reg: …, slot: SlotTextOffset)` followed by
	// `arm64EmitLoadSlot(asm, reg: …, slot: SlotTextOffset)` — two DIFFERENT functions, each with an
	// overload elsewhere in the tree, sharing one `let` — made the second call read the FIRST call's site as
	// *"claimed by another member"* and report **E2015 two calls to different overloads of
	// 'arm64EmitStoreSlot'**, naming a set the reported call is not even in. Twenty such refusals, all in
	// `Arm64PanicRuntime`, all on code the reference compilers accept.
	//
	// ⚠ The residual the retarget's own header describes is UNAFFECTED and still reported: two calls of the
	// SAME bare name resolving to two members share this field as well as the value, which is exactly the
	// case that cannot be told apart and the one the diagnostic is about.
	export let bareCallee as ByteArray
	export var callee as ByteArray
	export var argIndex as ParamCount
	export var label as ByteArray
	// ⚠ **WRITTEN AND NEVER READ, AND IT IS STALE FOR ONE CONSTRUCT IF A READER EVER APPEARS.** A call
	// argument owes the compile-time half alone, so nothing spends this block today. But it is recorded at
	// the parse, and a ternary's TRUE ARM is RELOCATED onto a block minted afterwards
	// (`Parser.parseTernaryExpression`), which is why the alias-named sites are re-homed with their ops
	// (`Parser.rehomeArmRangeSites`). This column is not, because re-homing a field with no reader would
	// only pretend one exists. ⇒ **A future reader that spends it as a position owes itself the same
	// re-home** — or, better, this field's deletion.
	export var block as BlockId
	export var line as LineNumber
	export var column as ColumnNumber

	// ⚠ `bareCallee` is a COPY and not a second store of the same record: one value written into two fields
	// of one literal is a repeated owning store, which single ownership refuses.
	export static function create(value ValueId, callee ByteArray, argIndex ParamCount, label ByteArray, block BlockId, line LineNumber, column ColumnNumber) returns RangeCheckArgSite
		return Self{value: value, bareCallee: callee.clone(), callee: callee, argIndex: argIndex, label: label, block: block, line: line, column: column}
	end 'create'
end 'RangeCheckArgSite'

export typealias RangeCheckArgSiteArray = Array with RangeCheckArgSite

// One `return <expr>` in a function whose declared return type is a ranged alias. The pass guards the
// `ret` terminator of `block` and reports against the function's `returnAliasName`.
//
// ⚠⚠ **`block` IS WHAT MAKES A SITE'S GUARD ITS OWN, AND IT IS NOT AN OPTIMIZATION.** A site used to
// name only its `value`, and `InsertRangeChecks` found "the first block still returning it" — an
// ORDINAL pairing, which silently mismatches the moment the blocks' order is not the sites' order.
// MEASURED against `maxon-sharp` on three shapes: a `return` inside a `while` body reported the line of
// the `return` AFTER the loop; a `return` in a branch that also holds an `as` cast reported the line of
// the `return` after the `if`, because the cast's own guard had moved that block's `ret` onto an
// `__rc_ok` block appended at the END of `blockRefs`. Recording the block makes the pairing an
// IDENTITY: a block carries exactly one terminator, so "the `ret` this site owns" has one answer that
// no ordering can permute. It is the same fact `RangeCheckSite.block` records, for the same reason.
//
// It is the block the `ret` terminator was EMITTED into, read after `emitOwnedValueReturn` has emitted
// it — not the block the `return` keyword was parsed in. The scope drops a hand-off emits first can
// branch, and a block a drop left behind carries no `ret`.
export type RangeCheckReturnSite
	export var value as ValueId
	export var block as BlockId
	export var line as LineNumber
	export var column as ColumnNumber

	export static function create(value ValueId, block BlockId, line LineNumber, column ColumnNumber) returns RangeCheckReturnSite
		return Self{value: value, block: block, line: line, column: column}
	end 'create'
end 'RangeCheckReturnSite'

export typealias RangeCheckReturnSiteArray = Array with RangeCheckReturnSite

// ⭐ Per-function map from a generic-INSTANCE value's function-local `ValueId` to the NAME of the
// instance alias it came from (`WrapperA`) — the parse-time provenance the value's shared
// `GenericInstanceId` cannot recover (P1.6-C). The NAME (not an interned id) so it survives merge with
// no remap, exactly as `returnAliasName` does. SemanticCheck's per-instance argument check reads it off
// the RECEIVER argument to re-qualify a method's inner-alias parameter (`WrapperB.setTag`'s `t Idx` ⇒
// `WrapperB.Idx`). It rides `FunctionRangeChecks` because that is the ONE per-function side table the
// parser fills and `mergeArtifact` copies whole (keyed by function name, id-stable) — a second such table
// would be the same channel written twice.
export typealias ValueInstanceAliasNameMap = Map with (ValueId, ByteArray)

// ⭐⭐ **A CLOSED INTEGER INTERVAL A VALUE IS PROVEN TO LIE IN, THAT NOTHING NAMES (EC7).** The counter of a
// `for i in a upto b` whose bounds are compile-time constants is in `[a, b-1]` throughout the loop body, and
// no `typealias` in the program says so — the value's own type is the bare `int` the bounds were written at.
//
// ⚠ **IT IS DELIBERATELY NOT A `RangedTypeAlias` WITH AN EMPTY NAME.** Half of what a `RangedTypeAlias`
// carries is a DECLARATION — the name, the declaring file, the position E3061 anchors on, the visibility
// `visibleFrom` resolves by — and every one of those would be a lie here. The two rules stated in terms of
// the type the program WROTE therefore cannot see this: E3010 (*"unneeded cast: 'A' already fits in 'B'"*,
// which quotes both names) and `safety.md`'s *"a ranged type whose range excludes 0 compiles to a bare
// divide"*. What CAN see it is every rule about whether a runtime GUARD can fail, because that is a question
// about the value's bounds and not about its spelling.
//
// `low`/`high` are INCLUSIVE and stored as the raw 64-bit patterns `ParsedInt` holds, exactly as
// `RangedTypeAlias`' bounds are, so one containment (`TypeRules.rangeCoversIntBounds`) answers for both.
export type ProvenIntRange
	export var low as ParsedInt
	export var high as ParsedInt

	export static function create(low ParsedInt, high ParsedInt) returns ProvenIntRange
		return Self{low: low, high: high}
	end 'create'
end 'ProvenIntRange'

// ⭐ Per-function map from a value's function-local `ValueId` to the interval above. SPARSE — one entry per
// counted-loop counter, and empty (the shared map) for every function that has none, which is most of them.
// It rides `FunctionRangeChecks` for `ValueInstanceAliasNameMap`'s reason: that is the ONE per-function side
// table the parser fills and `mergeArtifact` copies whole, and ValueIds pass through `LowerMaxonToStd`
// VERBATIM, so the Std tier reads the parser's own numbering with no remap.
export typealias ProvenIntRangeMap = Map with (ValueId, ProvenIntRange)

// ⭐⭐ **ONE NARROWED-RANGE PARAMETER OF A FUNCTION — AND IT IS A SITE, NOT MERELY A PUBLICATION (A1f).**
// It began as `paramAliasNames`, a name per parameter that no check in the declaring function read: the
// pre-erasure alias each PARAMETER was declared with, captured where `returnAliasName` is and for the
// identical reason (`TypeResolution.resolveNamedType` collapses a plain ranged alias to its primitive and
// drops the range), purely so a CALLER's `RangeCheckArgSite` could read the bounds back.
//
// ⭐ **IT IS NOW ALSO WHERE THE RUNTIME GUARD GOES**, which is what promoted it from a column of names to
// a site with a source position. A call argument is the one door whose runtime check cannot be emitted
// where it is written — a check is a BRANCH, and a call argument is evaluated part-way through building
// an argument list, so the guard would land PAST the call with the callee already run
// (`RangeCheckGuard`). The premise is therefore enforced at the CALLEE'S ENTRY instead: one guard per
// narrowed parameter per function, standing in front of every call, including a call through a function
// value that has no argument list to blame. `line`/`column` anchor its panic message on the parameter's
// own declaration — the line the premise is DECLARED on, which is the only line one shared guard can
// honestly name.
//
// ⚠ **SPARSE — one entry per RANGED parameter, never one per parameter.** `index` is the parameter's
// position in the DECLARED (user) list, which is both the ValueId the guard checks (the parser reserves
// ids `0..paramCount-1` for parameters, user parameters first) and the slot `argSlotPosition` maps an
// argument onto. A dense column would pad every unranged parameter with an entry carrying a position
// nothing may read; the sparse form has no padding to describe and no lie to tell.
export type RangeCheckParamSite
	export var index as ParamCount
	export var aliasName as ByteArray
	export var line as LineNumber
	export var column as ColumnNumber

	export static function create(index ParamCount, aliasName ByteArray, line LineNumber, column ColumnNumber) returns RangeCheckParamSite
		return Self{index: index, aliasName: aliasName, line: line, column: column}
	end 'create'
end 'RangeCheckParamSite'

export typealias RangeCheckParamSiteArray = Array with RangeCheckParamSite

// ⭐⭐ **ONE ENTRY CASCADE `InsertRangeChecks` ACTUALLY EMITTED FOR A NARROWED PARAMETER (EC7)** — the
// `RangeCheckParamSite` above says a guard is OWED; this says where the guard IS. Nothing recorded that
// until this row, and without it a cascade is indistinguishable from a hand-written `if`/`panic` the moment
// it reaches the Std tier: both are a compare, a conditional branch and a block that panics.
//
// ⭐ **IT CARRIES THE RESOLVED `alias`, NOT ITS NAME.** `guardRangedParam` holds the resolved declaration
// already (`guardVerdict` unwrapped it to decide the guard at all), and its reader — `InlineLeaves`, deep
// in the Std tier — has no file path to resolve a name against and must not acquire one: which range a name
// denotes is the CALLEE's file's answer, and re-resolving it in the caller's frame is exactly the defect
// `guardRangedParam`'s header records against `utf16LeadSurrogate`.
//
// `headBlockId` is the block the cascade's first compare stands in and `okBlockId` the block its in-range
// edge lands on. So an inliner that can prove the argument sends every edge into `headBlockId` to
// `okBlockId` instead, and copies none of `ownedBlockIds` — the ok block is the body and is copied as
// always.
module type RangeCheckParamGuard
	export var index as ParamCount
	export var alias as RangedTypeAlias
	export var headBlockId as BlockId
	export var okBlockId as BlockId
	// Every block this cascade OWNS — the head plus the `__rc_chk`s and the `__rc_panic` behind it, and NOT
	// the `__rc_ok` continuation, which holds the body. A reader that declines the cascade declines exactly
	// these, and it may not derive them for itself: "reachable from the head and not from the ok block" is a
	// second CFG walk that would have to model a block with no terminator op falling through PHYSICALLY, and
	// that is the modelling `docs/emitted-code-roadmap.md` files as a latent bug. This list is enumerated by
	// the one place that cannot get it wrong — the emitter, out of the ids it minted.
	export var ownedBlockIds as BlockIdArray

	export static function create(index ParamCount, alias RangedTypeAlias, headBlockId BlockId, okBlockId BlockId, ownedBlockIds BlockIdArray) returns RangeCheckParamGuard
		return Self{index: index, alias: alias, headBlockId: headBlockId, okBlockId: okBlockId, ownedBlockIds: ownedBlockIds}
	end 'create'
end 'RangeCheckParamGuard'

module typealias RangeCheckParamGuardArray = Array with RangeCheckParamGuard

// Every range-check site in one function. `filePath` is stamped by `mergeArtifact` (the
// function's file); `returnAliasName` is EMPTY unless the function returns a ranged INT alias.
export type FunctionRangeChecks
	export var filePath as FilePath
	export var sites as RangeCheckSiteArray
	// ⭐ **HAS `LowerMaxonToStd` FILLED EVERY SITE'S `stdOpPos` YET?** The presence bit `stdOpPos` cannot
	// carry itself, per function rather than per site because the lowering walks a function whole: it
	// fills all of that function's sites or none of them. `InsertRangeChecks` refuses to spend a position
	// without it, so a function that reached the guard pass unlowered fails LOUDLY instead of silently
	// anchoring every guard at the top of its block. A bool, not a column: an entry is filed for every
	// function that merely passes a constant argument, and a per-function ARRAY here would be one
	// allocation for each of them (MEASURED at +1,133/+31,079 across the scale ladder as exactly that).
	export var positionsResolved as bool
	export var argSites as RangeCheckArgSiteArray
	export var returnAliasName as ByteArray
	export var returnSites as RangeCheckReturnSiteArray
	// The function's narrowed-range parameters — see `RangeCheckParamSite`. Empty (the shared array) for a
	// function no parameter of which is a ranged alias, which is most of them.
	export var paramSites as RangeCheckParamSiteArray
	// P1.6-C — see `ValueInstanceAliasNameMap`. Empty for a function that constructs no generic instance,
	// which is every function outside the generics corpus.
	export var valueInstanceAliases as ValueInstanceAliasNameMap
	// EC7 — see `ProvenIntRangeMap`. Empty for a function with no counted loop over constant bounds.
	export var provenValueRanges as ProvenIntRangeMap

	// ⭐⭐ **WHICH OF THIS FUNCTION'S VALUES THE SOURCE WROTE AS NEGATIVE NUMBERS** — see
	// `Parser.writtenNegativeLiterals` for what the mark decides and why the value's 64 bits cannot say it.
	//
	// It rides HERE because the party that KNOWS is the parser and the party that ASKS is
	// `InsertRangeChecks` at the Std tier, and this is the one per-function side table that already crosses
	// that boundary (`ValueInstanceAliasNameMap`'s header states the same reason for the same channel). It
	// keys by `ValueId`, which survives the lowering verbatim, and it never travels between functions —
	// each entry is stamped with the file's own parse.
	//
	// ⚠ It is a SECOND such table beside `provenValueRanges`, and they answer opposite questions about the
	// same id space: that one says an interval a value is PROVEN to lie in, so a guard it covers is DEAD;
	// this one says the source WROTE a negative, so a compile-time refusal is OWED. Neither can be derived
	// from the other and neither may be read for the other's question.
	//
	// Empty (the parser's shared read-only anchor) for every function that writes no negative literal.
	export var writtenNegativeLiterals as ValueMarkSet

	export static function create(filePath FilePath, sites RangeCheckSiteArray, argSites RangeCheckArgSiteArray, returnAliasName ByteArray, returnSites RangeCheckReturnSiteArray, paramSites RangeCheckParamSiteArray, valueInstanceAliases ValueInstanceAliasNameMap, provenValueRanges ProvenIntRangeMap, writtenNegativeLiterals ValueMarkSet) returns FunctionRangeChecks
		return Self{filePath: filePath, sites: sites, positionsResolved: false, argSites: argSites, returnAliasName: returnAliasName, returnSites: returnSites, paramSites: paramSites, valueInstanceAliases: valueInstanceAliases, provenValueRanges: provenValueRanges, writtenNegativeLiterals: writtenNegativeLiterals}
	end 'create'
end 'FunctionRangeChecks'

// Registry: function name -> its range-check sites. Populated by `mergeArtifact` from each
// file's artifact; read by `InsertRangeChecks` (Std tier). Keyed by name — unique per program
// (E3006) — so it survives the merge with no id remap, exactly like `funcSignatures`.
export typealias RangeCheckPlanMap = Map with (ByteArray, FunctionRangeChecks)

// ⭐ **A FUNCTION TYPEALIAS (P1.5-A1)** — `typealias UnaryOp = function(Integer) returns Integer`. It is
// its OWN registry, NOT a `RangedTypeAlias`, because a function alias names a function TYPE, not a ranged
// numeric one: a value of it is a code pointer (`TypeClass.function`), and `Parser.parseTypeReference`
// resolves a reference to it as `MaxonType.function`, never `named` — so it must never be mistaken for a
// ranged alias (the `typeClassOf`/`fieldStorageType`/`resolveNamedType` consumers of the ranged registry
// all read a numeric `underlying`, which a function alias has none of).
//
// It carries the WHOLE declared signature — the return type AND the parameter types — because a
// function value's declared type is what every use of it is checked and lowered against: an indirect
// call's arity and argument types (`SemanticCheck.checkIndirectCall`), the int→float widening of its
// arguments (`LowerMaxonToStd.widenIndirectCallArgs`), and the agreement of a function VALUE with the
// function-typed place it flows into (`SemanticCheck.checkFunctionTypeDoors`). Both halves are stored
// INTERNER-FREE — a TAG plus the NAME behind a `named`/`structRef`/`function` type, empty for a
// primitive — so they ride the no-remap alias fold (`ProgramSignatures.recordFunctionTypeAlias` and
// `ParseStaging.commitFunctionTypeAliases` both key by name and rewrite no ids) and re-intern cleanly
// into any reader's own interner. `returnTag == void` means the function returns nothing.
export type FunctionTypeAlias
	export let name as ByteArray
	export let returnTag as ValueTypeTag
	export let returnTypeName as ByteArray
	// The RETURN slot's half of `FunctionAliasParam.typeParamToken` — see there. `NoTypeParamId` for every
	// tag but `typeParameter`, and NOT dropped on the SWEEP's copy the way `returnAggregateName` is: the
	// token is a PURE digest of two source names (W14), which is exactly the property that lets the sweep
	// and the real parse mint it identically without a registry.
	export let returnTypeParamToken as TypeParamId
	// The RETURN slot's half of `FunctionAliasParam.aggregateName` — see there. EMPTY for a `void` return and
	// for every type whose identity survives resolution, and EMPTY on the SWEEP's copy of an alias, which
	// cannot classify a name the registry it is still building has not reached (`Parser.readFunctionTypeAlias`
	// states the gate). The real parse's copy in `project.functionTypeAliases` is the one every shape reads.
	export let returnAggregateName as ByteArray
	// ⭐ **THE DECLARED PARAMETER TYPES**, in declaration order. EMPTY for an alias read by the
	// whole-program token SWEEP rather than by a real parse, and that is a property of the sweep and not
	// an omission: `Parser.parseTypeReference` answers a type spelling DIFFERENTLY there (the alias and
	// generic-instance registries it consults are the ones still being built), so a swept parameter type
	// can disagree with the real one. The sweep's copy therefore carries the return type — which it reads
	// identically — and nothing else, and every consumer of a parameter type reads
	// `project.functionTypeAliases`, the real parse's. See `Parser.readFunctionTypeAlias`.
	export let paramTypes as FunctionAliasParamArray
	// ⭐ **THE `fn(P1, P2) returns R` DISPLAY STRING (P1.5 #81).** The full canonical signature — parameter
	// types included — computed at parse (where the param types are still in hand, with THIS file's
	// interner, so a `named` alias reads as `Integer`) and stored as a plain ByteArray. It is what lets a
	// function-value merge whose arm is a function-TYPED PARAMETER (`f UnaryOp`) be signature-compared:
	// shv2 carries no full function type on a value, and the return type alone cannot tell `fn(Integer)`
	// from `fn(Integer, Integer)`. Interner-free, so it rides the no-remap alias fold exactly as the
	// return type does; the whole-program merge check (`checkValueMergeSignatures`) compares it by NAME
	// against a declared function's display built the same way.
	export let display as ByteArray

	export static function create(name ByteArray, returnTag ValueTypeTag, returnTypeName ByteArray, returnTypeParamToken TypeParamId, returnAggregateName ByteArray, display ByteArray, paramTypes FunctionAliasParamArray) returns FunctionTypeAlias
		return Self{name: name, returnTag: returnTag, returnTypeName: returnTypeName, returnTypeParamToken: returnTypeParamToken, returnAggregateName: returnAggregateName, display: display, paramTypes: paramTypes}
	end 'create'

	// ⭐⭐ **THE SAME DECLARATION UNDER ITS ENCLOSING TYPE'S NAME — `Config.FnTypeAlias1` (W49b).** A nested
	// function alias is published under BOTH keys; `Parser.publishNestedFunctionAlias` is the one home of why,
	// and this is the copy it mints for the qualified one. `GenericAliasEntry.scopedToEnclosingType`'s twin,
	// named alike because it is the same act on the other nested form.
	//
	// ⚠ Everything but the name is carried through UNCHANGED, and it must be: the SIGNATURE is what the two
	// keys disagree about only across separate folds (`extension Iterable` read once per conformer), never
	// between the two copies of ONE fold. A rebuild through `create` with anything defaulted would make the
	// qualified copy answer a different shape from the bare one for the same written declaration.
	export function scopedToEnclosingType(qualifiedName ByteArray) returns FunctionTypeAlias
		return Self{name: qualifiedName, returnTag: self.returnTag, returnTypeName: self.returnTypeName, returnTypeParamToken: self.returnTypeParamToken, returnAggregateName: self.returnAggregateName, display: self.display, paramTypes: self.paramTypes}
	end 'scopedToEnclosingType'
end 'FunctionTypeAlias'

// ONE parameter of a function typealias, stored the way the alias's RETURN type is and for the same
// reason: a function alias travels by NAME through both fold paths and is remapped by neither, so a
// `MaxonType` here would carry the DECLARING file's interner ids into registries that never rewrite
// them. The parameter's own NAME is deliberately absent — a function TYPE's parameter names are
// documentation (`Parser.readFunctionTypeParam` discards them, and `parseIndirectCall` passes arguments
// positionally because of it), so a diagnostic names the POSITION, which is the only thing that binds.
export type FunctionAliasParam
	export let tag as ValueTypeTag
	// The declared type's NAME for a `named`/`structRef`/`function` parameter, EMPTY for a primitive —
	// exactly `FunctionTypeAlias.returnTypeName`'s convention, produced by the same
	// `Parser.functionAliasTypeName`.
	export let typeName as ByteArray
	// ⭐ **THE IDENTITY RESOLUTION ERASES — this parameter's contribution to `FunctionShape.paramAggregateNames`.**
	// NOT the same thing as `typeName` above, and the difference is the point: `typeName` is what a reader's
	// interner must re-intern to rebuild the TYPE (a struct's name is there, a primitive's is not), while this
	// is what survives NOTHING and therefore has to be carried (a boxed union/enum, a per-instance ranged
	// alias). A struct is empty here and non-empty there. Filled by `Parser.erasedAggregateNameOf`, the one
	// extraction the declared-function tier fills `FuncSignature.paramAggregateNames` through — see there for
	// why sharing the EXTRACTION rather than loosening the comparison is what keeps the two tiers from
	// classifying one parameter two ways.
	export let aggregateName as ByteArray
	// ⭐⭐ **THE IDENTITY OF A TYPE-PARAMETER PARAMETER — `Element` in `typealias ElementTransform =
	// function(Element) returns Element`, written inside a generic type's body (F3).** `NoTypeParamId` for
	// every other tag, and read by nobody under one: the tag is what says whether this column means
	// anything, exactly as it says whether `typeName` does.
	//
	// ⭐ **IT IS A THIRD COLUMN RATHER THAN A NAME IN `typeName`, AND THAT IS WHAT `typeName` MEANS.** That
	// slot is "the name a reader's interner must re-intern to rebuild the type", and a type parameter has
	// none: its id is the W14 DIGEST of `(declaring type name, parameter name)`, minted by
	// `ProgramSignatures.typeParamTokenFor` and never looked up. Storing `Element` there would make every
	// reader intern a name that denotes no type and then rebuild `named("Element")` from it.
	//
	// ⛔ **THE ALTERNATIVE WAS THE SILENT WRONG ANSWER THIS COLUMN EXISTS TO CLOSE.** `Parser.functionAliasTypeName`
	// has no name to give for a `typeParameter` and still yields the EMPTY STRING (see its `typeParameter`
	// arm) — so until F3 the whole FORM was refused at the declaration, the alternative being an alias that
	// carried an empty declared parameter type which every later reader took at face value. That refusal
	// cost `stdlib/Interfaces.maxon`'s `extension Iterable` every GENERIC conformer, `Array` included, which
	// is what makes the identity worth a column of its own rather than a diagnostic.
	//
	// ⚠ It needs NO REMAP and rides the alias fold exactly as the names beside it do — a digest of two
	// source spellings is the same number in every file that computes it, which is precisely the property
	// W14 chose it for.
	export let typeParamToken as TypeParamId

	export static function create(tag ValueTypeTag, typeName ByteArray, typeParamToken TypeParamId, aggregateName ByteArray) returns FunctionAliasParam
		return Self{tag: tag, typeName: typeName, typeParamToken: typeParamToken, aggregateName: aggregateName}
	end 'create'
end 'FunctionAliasParam'

export typealias FunctionAliasParamArray = Array with FunctionAliasParam

export typealias FunctionTypeAliasArray = Array with FunctionTypeAlias
export typealias FunctionTypeAliasMap = Map with (ByteArray, FunctionTypeAlias)

// ⭐ **THE CALLABLE SHAPE OF A FUNCTION TYPE — RESOLVED.** What a call through a function value
// actually depends on: how many arguments it takes, what each one's concrete type is, and what comes
// back. Every parameter/return type in it has been through `TypeResolution.resolveType`, so a ranged
// alias has already collapsed to the `int`/`float` it is — which is exactly the property that makes it
// the right currency for BOTH consumers: the ABI question the widening asks (`is parameter k a float?`)
// and the agreement question the doors ask (`may this function value stand in this function-typed
// place?`) are both questions about the REPRESENTATION, not about which alias name was spelled.
//
// ⚠ **THAT IS A DELIBERATE DIFFERENCE FROM `checkValueMergeSignatures`, WHICH COMPARES NOMINALLY**, and
// the two are not in conflict — they ask the different questions the coercion-site section of TypeRules
// draws the line between. A MERGE is symmetric (`unary if c else binary` — are these two values the SAME
// type?) and matches the reference oracle's nominal `MergeTernaryArmFnTypes`. A DOOR is one-sided (may
// this value stand HERE?), and there a nominal rule is measurably wrong: a lifted closure's return type
// is INFERRED, so `function(x Ratio) gives x * 3.0` has return type `float` where the `ScaleFn` it is
// passed to spells `Ratio` — and both reference compilers accept that program.
export type FunctionShape
	export let paramTypes as MaxonTypeArray
	export let returnType as MaxonReturnType
	// ⭐⭐ **THE ONE IDENTITY `paramTypes` CANNOT CARRY — a boxed union/enum parameter's NAME — parallel to
	// `paramTypes`, `EmptySourceText` everywhere else.** It is `FuncSignature.paramAggregateNames` at the
	// function-TYPE tier, and it exists because a shape assembled from either registry was previously the one
	// currency in the compiler that could not answer *"which enum is this parameter?"*: `resolveType` collapses
	// a `named` union/enum to bare `integer`, so `function(Color)` and `function(Shade)` are the SAME
	// `paramTypes`. **MEASURED (BATCH18 review): `<Array with Color>.map(function(c Shade) gives Color.red)`
	// compiled clean and died `STATUS_STACK_OVERFLOW` — a 3-case ordinal matched against a 2-case `match` —
	// and the identical mismatch through a function ALIAS died `ACCESS_VIOLATION`.**
	//
	// ⚠ **A STRUCT PARAMETER IS DELIBERATELY EMPTY HERE, AND THAT IS NOT AN OMISSION** — the rule
	// `FuncSignature.paramAggregateNames` states one tier down. A struct keeps its `structRef(id)` through
	// resolution, so its identity is read LIVE off `paramTypes` and a reader consults this column only where
	// the live answer is empty. Filling it for a struct would put one name in two places for no reader.
	//
	// ⭐ **`functionShapesAgree` COMPARES IT (BATCH18-b), and until it did, the six doors that predicate
	// serves ALL had the hole** — `function(Shade)` accepted into a `function(Color)` cast, return, variable,
	// global, field or union payload, faulting on the call. It is not a widening of the "representational"
	// rule above but its completion: two positions agree when their REPRESENTATION agrees AND the identity
	// that representation destroyed agrees. The two halves are disjoint by construction, which is what makes
	// the conjunction safe — see the parameter loop in `TypeResolution.shapesAgreeUnder`.
	export let paramAggregateNames as ByteArrayArray
	// The RETURN slot's half of the same column, one name rather than an array. See
	// `FuncSignature.returnAggregateName` for the measurement that made it necessary.
	export let returnAggregateName as ByteArray

	export static function create(paramTypes MaxonTypeArray, returnType MaxonReturnType, paramAggregateNames ByteArrayArray, returnAggregateName ByteArray) returns FunctionShape
		return Self{paramTypes: paramTypes, returnType: returnType, paramAggregateNames: paramAggregateNames, returnAggregateName: returnAggregateName}
	end 'create'
end 'FunctionShape'

// Registry: FUNCTION-TYPEALIAS name -> its resolved shape. Built once by `TypeResolution.resolveTypes`
// from `project.functionTypeAliases`, which stores the alias's declared types interner-free and
// UNRESOLVED. A declared function or lifted closure needs no entry here — its resolved shape is already
// `funcSignatures` + `funcReturnTypes`, which `resolveTypes` re-syncs — so only aliases are materialized,
// and a program with none pays nothing.
export typealias FunctionShapeMap = Map with (ByteArray, FunctionShape)

// --- Declared struct types (P1.0r) ---

// The index of a field within its struct's declaration order. It IS the field's identity — the
// offset is derived from it (`StructLayout.offsetOfField`) rather than stored, so there is no
// second number to keep in step. Bounded by the fields a struct may declare.
export typealias FieldIndex = int(0 to 65535)

// The index of a case within its enum's declaration order — the enum twin of `FieldIndex`, and
// bounded the same way (the cases an enum may declare). It IS the case's identity: an enum RANGE
// arm is a slice of this index (OPEN #21), never of the tag, which is the whole point of storing
// cases in declaration order.
export typealias CaseIndex = int(0 to 65535)

// ⭐ **ONE 8-BYTE SLOT IS WHAT A FIELD OCCUPIES, AND THE LAYOUT COUNTS SLOTS RATHER THAN BYTES.** It is
// not an alignment convenience: a struct FIELD of struct type is a POINTER (`valueTagToStdType(structRef)`
// → i64), so `sizeof(Outer{p Point, n Integer})` is 16 rather than 24 — which is exactly what
// `specs-shv2/sizeof.md` pins.
//
// ⚠ **A PACKED layout would have to know each field's WIDTH, and that is still a Std-tier fact this
// Maxon-tier record deliberately does not carry.** What it DOES carry is each field's SLOT COUNT
// (`fieldSlotCount` below) — a strictly weaker question, and one the Maxon tier can answer from the
// declared type alone: *is this declared at an interface type?* Every field but that one takes one slot,
// so every struct that compiled before the existential slice landed is byte-identical.
//
// ⭐⭐ **`specs/enum-narrow-storage.md` ASKS FOR NARROW STRUCT FIELDS AND shv2 DELIBERATELY DOES NOT GIVE
// THEM — READ THIS BEFORE "FIXING" IT.** That spec says an enum's narrowest width applies to "memory
// representation everywhere — struct fields, array elements, `.rdata` constants". shv2 narrows the last
// two (`ProgramSignatures.trivialElementSlot`, and the constant blob `LayoutDescriptor.constArrayBlobOf` lays
// down) and leaves FIELDS at the slot above. That is a partial implementation, taken on purpose, for two
// reasons that are about this line rather than about enums:
//
//   • **NO FIELD IS NARROW HERE — not `bool`, not `ExitCode`, not a ranged alias.** Every one of them gets
//     the same 8 bytes, for the paragraph above. Narrowing an enum field ALONE would make it the only
//     narrow field in the language, which is an inconsistency wearing a spec's clothes; narrowing all of
//     them is a layout change to every struct in the corpus and is not one enum's rung.
//   • **NO TARGET CAN LOAD OR STORE ONE.** `Targets/Shared/StdLoweringShared.accessWidthFor` PANICS for
//     `i8` through `i32`, and `X64AccessWidth` has exactly two members (`byte`, `word64`); arm64 has
//     `ldrb`/`ldr` and wasm gates `i8` behind P1.9. So this is three new access widths in three backends —
//     and the array half needed NONE of that, because the element load is byte-granular and strides the
//     record at run time (`ManagedMemoryRuntime.emitLoadElemAt`). A field read has no such indirection.
//
// ⇒ it is a CROSS-TARGET CODEGEN rung with a cross-target gate, and two of its three lanes cannot be
// executed on the host that would write it (arm64 needs the Mac, wasm needs the vendored wasmtime sweep).
// The spec's own sentence is the record of what is owed; it is deliberately filed nowhere else.
let FieldSlotBytes = 8 as ByteOffset

// ⭐ **AN INTERFACE-TYPED FIELD IS THE ONE FIELD THAT TAKES TWO SLOTS (P1.7a-existentials slice 2).** A
// value held at its interface type is the 16-byte fat pointer `(value@+0, witness@+8)`
// (`IrInterface.InterfaceValueBytes`), and BOTH halves live in the box — the witness half is what the
// field's drop dispatches through, so there is nowhere else it could go. The offset a field read/write
// adds to reach the witness half is `IrInterface.InterfaceWitnessHalfOffset`, stated there beside the
// table it points at.
//
// ⚠ **THE `2` IS DERIVED AND NOT WRITTEN DOWN, BECAUSE IT IS THE SAME NUMBER `sizeof(<Interface>)` ANSWERS.**
// It shipped as a bare literal under a comment in `LayoutDescriptor.primitiveTypeByteSize` claiming
// *"`sizeof(Iface)` and a struct field's carve-out both read this number, so it is stated once here"* — which
// was false the moment it was written: that reader returned `InterfaceValueBytes` and this one returned `2`,
// two independent statements of one width with a comment asserting there was one. Widen a fat pointer (a
// third header word) and a derived carve-out follows while a literal silently does not, which is a field
// offset that lands mid-value.
function fieldSlotCount(declaredType MaxonType) returns ByteOffset
	if maxonTypeTag(declaredType) == ValueTypeTag.interfaceRef 'existential'
		return InterfaceValueBytes / FieldSlotBytes
	end 'existential'
	return 1
end 'fieldSlotCount'

// ⭐ **THE FIELD NAME THE ENVELOPE COLLAPSE KEYS ON.** Both references spell it `managed` and it is the
// corpus's own spelling in all four wrapper types (`stdlib/String.maxon:70`, `Character.maxon`,
// `Array.maxon:105`), so this is the corpus's name read back rather than a compiler invention — which is
// exactly why it may not be keyed on ALONE. See `StructLayout.isInlineManagedField`.
//
// Exported because a REFUSAL has to spell the shape it is asking for — `Parser.requireArrayMarkerDeclaresTheBuffer`
// tells an author to "declare exactly one field, `managed as …`" — and a message that spelled the name itself
// would be the second home of the corpus's own word.
export let InlineManagedFieldName = b"managed"

// ⭐⭐ **HOW MANY BYTES A COLLAPSED `managed` OCCUPIES — the SIX `__ManagedMemory` slots, DERIVED.** The
// buffer record is `buffer`, `length`, `capacity`, `element_size`, `parent`, `element_destroy`: six machine
// words, and every one of them is named at that offset by both fused records shv2 already builds
// (`StringRuntime`'s `StringBufferOffset`…`StringElementDestroyOffset` and `BufferOwnership`'s
// `ManagedRecordBufferOffset`…`ManagedRecordElementDestroyOffset`).
// Writing `48` here instead would be a third statement of a number those twelve constants already fix, and
// the one that no reader would check — so it is a product of the two facts it is made of.
//
// ⚠ **IT WAS FIVE UNTIL W157, AND THE SIXTH SLOT IS THE WHOLE OF THAT RUNG.** The collapsed `managed`
// deliberately STOPPED at `parent@32` and let `type String`'s own `singleByteGraphemesFlag` take `@40`,
// which is the slot an `__ManagedMemory` keeps `element_destroy` in — so a String record and a buffer
// record disagreed at exactly one offset and a String's bytes could only be handed to buffer code through a
// freshly minted 48-byte VIEW. Embedding the buffer record WHOLE (`element_destroy@40`, always 0: a
// String's bytes need no per-element destructor) and moving the flag to `@48` makes a String record a
// structurally valid buffer record, which is what lets `String.addressableBytes()` hand back the receiver
// instead of allocating.
//
// ✅ **AND THE PRODUCT IS NOW CHECKED AGAINST THE RECORD THE RUNTIME READS (W49 wave 9).** This header used
// to record a DEBT — *"there is nothing to check it against until `stdlib/String.maxon` is listed; the
// moment a corpus layout is registered under that name, it and `StringRuntime`'s six offsets become two
// descriptions of one record, and that assertion belongs with the listing"*. Both `String.maxon` and
// `Character.maxon` are listed unconditionally now, so both descriptions exist in every compile, and
// `ProgramSignatures.checkFusedWrapperRecordLayouts` — run once per program from the query spine — is what
// holds them together. It checks the FIELD COUNT as well as the offsets, which is the clause this constant
// could never have implied: a field the fused record has no slot for is discarded at construction in
// silence (see `Parser.requireFusedWrapperTag`, which carries that defect measured).
let ManagedMemorySlotCount = 6 as ByteOffset
let InlineManagedMemoryBytes = ManagedMemorySlotCount * FieldSlotBytes

// ⭐ **THE THREE MARKER INTERFACES, AND WHY THE PREDICATE IS A FUNCTION RATHER THAN A SET LOOKUP.** They are
// `stdlib/Builtins.maxon`'s (`:11`, `:18`, `:25`), where their whole stated purpose is to be *"marker
// interfaces the compiler scans for to resolve literal syntax"*. `BuiltinDictionaryLiteral` is deliberately
// ABSENT: its `init` takes TWO `__ManagedMemory`s (keys and values), so a `Map` is not its own buffer and
// nothing about it collapses — the reference omits it from the same list for the same reason.
function isBuiltinManagedWrapperInterface(interfaceName ByteArray) returns bool
	return interfaceName.equals(BuiltinStringLiteralInterfaceName) or interfaceName.equals(BuiltinCharLiteralInterfaceName) or interfaceName.equals(BuiltinArrayLiteralInterfaceName)
end 'isBuiltinManagedWrapperInterface'

let BuiltinStringLiteralInterfaceName = b"BuiltinStringLiteral"
let BuiltinCharLiteralInterfaceName = b"BuiltinCharLiteral"
export let BuiltinArrayLiteralInterfaceName = b"BuiltinArrayLiteral"

// The size of a struct with NO fields. A zero-byte allocation would hand two distinct empty
// structs the SAME address (the bump allocator advances by nothing), so identity would collapse
// and a decref of one would free the other. One slot is the floor, and it costs a program that
// declares an empty struct exactly 8 bytes it will never read.
let EmptyStructBytes = FieldSlotBytes

// The value a field declaration supplies when a `Self{…}` literal omits it — `export var value = 0`.
//
// The payload is a `ParsedInt` for a float exactly as for an integer — a float literal's value IS
// its IEEE-754 bit pattern (see `Parser.parseFloatLiteral`), which is why a defaulted float costs no
// second column and no second decoder.
//
// ⚠⚠ **AND THAT IS PRECISELY WHY THE LITERAL'S OWN TAG RIDES BESIDE IT.** Two `ParsedInt`s are
// indistinguishable once written down, so the payload alone cannot say which representation it is in:
// the integer `3` and the f64 bits of `3.0` are both just numbers here. `as float = 3` therefore has
// to be WIDENED before it fills the slot (`Parser.fillFieldDefault`), and the only fact that can
// decide that is what the source WROTE.
//
// It used to carry the payload alone, on the argument that "the default's type IS the field's declared
// type, so a default cannot come to disagree with the slot it fills". That argument had one silent
// hole and it is the reason for this field: the declaration SWEEP that records a layout may not read
// the alias registry it is still building (`Queries.queryProgramSignatures`), so a field declared with
// a ranged FLOAT alias reaches this record with its type still an unresolved NAME — and a name reads
// as an integer. The sweep therefore CANNOT normalize the payload, and it is the sweep's layout that a
// `Self{…}` literal reads its defaults out of. The tag is what carries the question across to the one
// place that can answer it.
export union FieldDefault
	// The declaration supplies none: `export var x as Integer`. A literal that omits this field is
	// E3086, and that is the rule field defaults exist to relax.
	none
	// `tag` is the LITERAL's own type as the source wrote it (`int` for `= 3`, `float` for `= 3.0`) —
	// NOT the field's declared type, which `StructLayout.fieldTypes` holds and which may still be an
	// unresolved alias name here. The pair travels together for `ConstValue`'s reason: a payload
	// without its tag is a number whose meaning has been thrown away.
	// ⚠ **`writtenNegative` IS THE THIRD MEMBER FOR THE REASON THE TAG IS THE SECOND**, one question
	// further out: `= -1` and `= 0xFFFFFFFFFFFFFFFE` both store a negative `ParsedInt`, and only the first
	// is a negative NUMBER — so whether a default fits an `int(0 to u64.max)` field cannot be judged from
	// the payload at all. `ConstValue.writtenNegative` is where the fact is decided and `literalInRange` is
	// what spends it; this member is how it reaches the reader, which may be another file entirely. It is a
	// declaration's own fact and therefore rides the layout's content hash beside the pair.
	literal(payload ParsedInt, tag ValueTypeTag, writtenNegative bool)
	// ⭐⭐ **ANY OTHER DEFAULT IS A SYNTHESIZED NULLARY FUNCTION, AND THIS IS ITS NAME (S2f).**
	// `export var items as IntArray = IntArray.create()` declares a second function,
	// `__fieldDefault#Bag#items`, whose whole body is `return IntArray.create()`; a `Self{…}` that omits
	// the field emits an ordinary call to it and stores the result. That is the SAME mechanism a
	// PARAMETER default is, reached through a second door — see `SignatureIndex.ParamDefaultInfo`, whose
	// header argues the design in full, and every one of its three consequences holds here unchanged.
	// The one that decides the design is ownership: a call RESULT is a shape the parser already owns and
	// drops (`mintOwnedCallResult`), so a managed field default needs no new ownership rule at all.
	//
	// ⚠ **THE EXPRESSION IS DELIBERATELY NOT HERE.** A default's tokens are read exactly once, by the file
	// that declares them; every other reader emits `call __fieldDefault#Bag#items`, byte-identical whatever
	// the expression says. See `ProgramSignatures.mixFieldDefault` for what therefore rides the hash.
	//
	// ⚠ **A LITERAL DEFAULT KEEPS THE `literal` ARM ABOVE AND DOES NOT COME THROUGH HERE**, which is a
	// deliberate divergence from the parameter twin's "one mechanism, one place a default is produced".
	// `Parser.fillFieldDefault` states the reason: a literal is folded away entirely by `InsertRangeChecks`
	// and a call result cannot be.
	helper(name ByteArray)
end 'FieldDefault'

export typealias FieldDefaultArray = Array with FieldDefault

// StructLayout — one declared `type T`: what it is called, and its fields IN DECLARATION ORDER.
//
// It is the struct twin of `FuncSignature` (parallel name/type arrays, a linear index-of lookup),
// and it is homed here for the same reason: it is a parse-staging registry entry, written by the
// parser into a `FileParseArtifact` and folded into `Project` by `mergeArtifact` — never touched
// by the parser on `Project` directly.
//
// ⚠ **IT LIVES IN TWO REGISTRIES, DELIBERATELY, AND THAT IS `RangedTypeAlias`'s ARRANGEMENT
// EXACTLY.** `ProgramSignatures.structOf` answers the PARSER, before any file is parsed, from the
// whole-program TOKEN sweep — because `p.x` needs the field's offset at PARSE time and the
// declaration may be below it or in another file. `Project.structTypes` answers TYPE RESOLUTION,
// after the real parse, and it is the AUTHORITY — a name in neither registry is E3011, and a
// tolerant token sweep must never own a veto (see SignatureIndex's `CalleeReturn.undeclared`).
// Two readers, two moments, one record type.
// ⭐ **ONE `where <T> is <Interface>` CONSTRAINT on a generic type (P1.7a slice 2a).** `type Box uses T
// where T is Digest` records one of these — `typeParamIndex` is the position of the constrained parameter
// in `typeParamNames` (the `T`), `interfaceName` is the required interface (`Digest`). A conjunction
// (`where T is A and B`) and a comma list (`where T is A, U is B`) each flatten to ONE entry per (param,
// interface) pair, IN SOURCE ORDER — and that order IS the witness-slot order (dictionary-passing threads a
// hidden witness pointer per constraint, index-aligned to this list). The instantiation-site check (E3017)
// reads it straight off `structOf`, exactly as the arity check reads `typeParamNames`.
//
// ⭐⭐ **AND IT MAY BIND THAT INTERFACE'S ASSOCIATED TYPES — `where Source is Iterator with Element` (G19).**
// The `with` clause an `implements` line already carries, written on the other side of the same conformance,
// and the currency is the same: one RENDERED type name per associated position, in the interface's `uses`
// order, exactly as `StructLayout.conformanceBindings` holds them (both come out of
// `Parser.parseConformanceWithArgs`, so a binding written on a constraint and the same binding written on a
// conformance are comparable as strings without a second resolution).
//
// ⭐ **WHAT IT BUYS IS THE ONE FACT A TYPE PARAMETER CANNOT CARRY.** Inside a shared generic body the receiver
// of a witness dispatch is a value of a type PARAMETER, which says nothing about what the conformance behind
// it bound — so a requirement returning an associated type had no type to give the result, and the position
// counted as UNCLAIMED for E3119. `ConformanceCheck.constrainedParamAssociatedBindings` is the one door that
// reads this list, and all three tiers ask it.
//
// ⚠ **THE BINDINGS ARE NOT PART OF A CONSTRAINT'S IDENTITY** (`whereConstraintsEqual`): the identity is the
// witness SLOT, which is the `(parameter, interface)` pair, and one slot holds one table however the
// associated positions are written.
export type WhereConstraint
	export let typeParamIndex as FieldIndex
	export let interfaceName as ByteArray
	export let associatedBindings as ByteArrayArray

	export static function create(typeParamIndex FieldIndex, interfaceName ByteArray, associatedBindings ByteArrayArray = sharedEmptyDeclaredConformances) returns WhereConstraint
		return Self{typeParamIndex: typeParamIndex, interfaceName: interfaceName, associatedBindings: associatedBindings}
	end 'create'
end 'WhereConstraint'

export typealias WhereConstraintArray = Array with WhereConstraint

// Do two constraint lists name the same constraints in the same ORDER? The order is what makes this the
// right question rather than set equality: the list IS the witness-slot numbering, so two lists agree only
// if slot `i` of one carries what slot `i` of the other does — which is exactly the premise a forwarded
// witness rests on (`LowerMaxonToStd.forwardCallerWitness`).
export function whereConstraintsMatch(constraints WhereConstraintArray, other WhereConstraintArray) returns bool
	if constraints.count() != other.count() 'differentLength'
		return false
	end 'differentLength'

	for i in 0 upto constraints.count() 'eachConstraint'
		let mine = try constraints.get(i) otherwise panic("whereConstraintsMatch: constraints.get OOB at {i} below count {constraints.count()}")
		let theirs = try other.get(i) otherwise panic("whereConstraintsMatch: other.get OOB at {i} below count {other.count()}")
		if not whereConstraintsEqual(mine, other: theirs) 'differs'
			return false
		end 'differs'
	end 'eachConstraint'

	return true
end 'whereConstraintsMatch'

// ⭐ **WHEN TWO CONSTRAINTS ARE ONE WITNESS SLOT — the (parameter, interface) pair, spelled once.** Two
// readers ask it and they must never disagree, because between them they decide the witness NUMBERING: the
// ordered comparison above (do these two lists agree slot for slot?) and the de-duplication below (does this
// list already reserve a slot for this constraint?). Written out at each, the pair test was the same
// expression in two files.
function whereConstraintsEqual(constraint WhereConstraint, other WhereConstraint) returns bool
	return constraint.typeParamIndex == other.typeParamIndex and constraint.interfaceName.equals(other.interfaceName)
end 'whereConstraintsEqual'

// Does `reserved` already carry a witness slot for `constraint`?
// `ProgramSignatures.typeExtensionWitnessConstraints`' de-duplication, which is what keeps an extension that
// restates one of its target's own constraints from reserving two slots for one witness.
//
// A linear scan for `whereConstraintsMatch`'s reason one level up: a `where` clause is a handful of entries,
// and it is walked once per (extension, method) rather than per call.
export function whereConstraintListReserves(reserved WhereConstraintArray, constraint WhereConstraint) returns bool
	for existing in reserved 'eachReserved'
		if whereConstraintsEqual(existing, other: constraint) 'sameSlot'
			return true
		end 'sameSlot'
	end 'eachReserved'
	return false
end 'whereConstraintListReserves'

// ⭐ **RENDER A CONSTRAINT LIST BACK TO THE CLAUSE THE AUTHOR WROTE** — `where T is A and B, U is C`. The
// flattening `readWhereClause` performs is LOSSLESS in source order (one entry per (param, interface) pair,
// params in the order they were written), so regrouping the consecutive run that shares a `typeParamIndex`
// reproduces the conjunction and the comma list exactly. Written once because a diagnostic that names the
// condition a conditional extension was withheld under has to name the WHOLE condition, and re-spelling the
// grammar at the message site is how a `where` form grows a second, stale renderer.
//
// `paramNames` is the declaration the indices are positions in — a type's `uses` list, or an interface's
// associated-type names.
// ⭐ **THE E4006 A CONDITIONAL TYPE EXTENSION'S UNMET CLAUSE EARNS — written once because TWO parties now
// render it.** `Queries.reportParseError` renders the parser's `conditionalExtensionWithheld` arm and
// `SemanticCheck.checkResolvedExtensionConstraints` renders the post-resolution one; they are the same
// refusal asked at two points (see `ConformanceCheck.receiverMeetsExtensionConstraints`), so the sentence
// lives beside `renderWhereConstraints`, which builds the `clause` both of them quote.
export function conditionalExtensionWithheldMessage(typeName String, methodName String, clause String, unmetInterfaceName String, bindingName String) returns String
	return "Type '{typeName}' has no field named '{methodName}' ('{methodName}' is available as a conditional extension {clause}, but '{bindingName}' does not implement '{unmetInterfaceName}')"
end 'conditionalExtensionWithheldMessage'

export function renderWhereConstraints(constraints WhereConstraintArray, paramNames ByteArrayArray) returns String
	var text = "where "
	var previousParam = 0 as FieldIndex
	for i in 0 upto constraints.count() 'eachConstraint'
		let constraint = try constraints.get(i) otherwise panic("renderWhereConstraints: constraints.get OOB at {i} below count {constraints.count()}")
		if i == 0 or constraint.typeParamIndex != previousParam 'newParam'
			let separator = "" if i == 0 else ", "
			let paramName = try paramNames.get(constraint.typeParamIndex) otherwise panic("renderWhereConstraints: a constraint names parameter position {constraint.typeParamIndex}, outside the declaration's own list of {paramNames.count()} — `readWhereClause` rejects a name that is not in it")
			text = "{text}{separator}{String.from(paramName)} is {String.from(constraint.interfaceName)}"
		end 'newParam' else 'sameParam'
			text = "{text} and {String.from(constraint.interfaceName)}"
		end 'sameParam'

		previousParam = constraint.typeParamIndex
	end 'eachConstraint'

	return text
end 'renderWhereConstraints'

// The SHARED EMPTY `whereConstraints` a StructLayout holds until a `where` clause is recorded (P1.7a slice
// 2a) — an unconstrained (or non-generic) type, which is every type on the scale corpus. `recordWhereConstraints`
// REPLACES the field wholesale (copy-on-write), and it is never mutated in place, so one allocation serves
// every unconstrained struct — the same discipline `sharedEmptyInnerAliases` / Slice 1's shared-empty
// `interfaces`/`conformances` use to keep the per-struct parse path allocation-free.
let sharedEmptyWhereConstraints = WhereConstraintArray.create()

// The SHARED EMPTY `messageMethodNames` every type that is not a service carries — which is every type in
// every program that never writes `spawn` (SV1). `recordMessageMethods` replaces it wholesale on the one
// declaration that has a roster and this is never mutated, exactly as `sharedEmptyWhereConstraints` above:
// a per-type array here would be one allocation per declared `type` to hold a list only a service has.
let sharedEmptyMessageMethods = ByteArrayArray.create()

export type StructLayout
	export var name as ByteArray
	// Parallel arrays, in DECLARATION order: field `i` is called `fieldNames[i]`, is declared
	// `fieldTypes[i]`, accepts a write iff `fieldMutable[i]`, is reachable from outside the type
	// iff `fieldVisibility[i]` admits the reader, and defaults to `fieldDefaults[i]`.
	// The declared type is NOT a resolved one — the sweep that records it cannot resolve anything
	// (the alias it names may be in a file not yet folded), and the parser resolves it at the use
	// site through the same `aliasOf` door the shift rule already asks.
	//
	// ⚠ **THE COLUMNS ARE NEVER APPENDED TO DIRECTLY — `addField` IS THE ONE WRITER**, and that is
	// what makes "the columns fell out of lockstep" unrepresentable rather than merely asserted. A
	// reader indexes every one of them by one `FieldIndex`, so a caller that pushed a name and forgot
	// a default would shift every later field's default onto the wrong field: a silent wrong answer
	// with no crash to find it by.
	export var fieldNames as ByteArrayArray
	export var fieldTypes as MaxonTypeArray
	export var fieldMutable as BoolArray
	// `export var n` / `module var n` / `var n` — the visibility column, read by
	// `Parser.requireFieldAccessible` (E3014). It is the twin of `fieldMutable` in every respect: one entry
	// per field, off the declaring keyword, written only by `addField`, and read only through an accessor
	// that decodes it for one `FieldIndex`.
	//
	// ⚠ **A FIELD'S `file` TIER IS ITS DECLARING TYPE, NOT ITS DECLARING FILE**, and that is measured rather
	// than chosen: `type B` reading `type A`'s unexported field is E3014 on the bootstrap IN THE SAME FILE
	// (see `Parser.requireFieldAccessible`). So this column reuses `Visibility` for its two WIDER tiers,
	// whose meanings are the ordinary ones, and reads the default tier against the enclosing TYPE.
	export var fieldVisibility as VisibilityArray
	export var fieldDefaults as FieldDefaultArray
	// ⭐ **THE FIELD's PRE-ERASURE SPELLING (A2j / A2m): where did it name `__ManagedMemory`?** It is a
	// column and not a property of `fieldTypes[i]` because `parseTypeReference` folds that spelling into the
	// SAME `genericInstance(Array with Byte)` a `ByteArray` field resolves to — so by the time the type
	// exists there is nothing left to ask. A read of a field declared the alias denotes the BUFFER and gets
	// the buffer's member roster (`Parser.markDeclaredSurface`); one declared `ByteArray` denotes the
	// `Array`. The two are the same record and different surfaces, and this column is what still tells them
	// apart. A2m widened the bit to a `DeclaredSurface` TREE so a field declared with a TUPLE type carries a
	// whole surface per SLOT, recursively. Plain — the shared EMPTY tree, which costs nothing — for every
	// compiler-synthesized layout, since none is written in source at all.
	//
	// ⚠ **THE WORD'S ELEMENT BIT IS NEVER SET HERE** — see `ProgramSignatures.fieldSurfaceOf`, which derives
	// it: this column is written by the declaration SWEEP, which runs before any generic alias is interned
	// and so cannot be asked whether `BufArray` holds buffers.
	export var fieldDeclaredSurfaces as DeclaredSurfaceArray
	// ⭐ **THE DERIVED SLOT GEOMETRY — the PREFIX SUM over `fieldSlotCount` (P1.7a-existentials slice 2), and
	// the box size that same sum ends at.** Two DERIVED columns, read by `offsetOfField`/`sizeBytes` in O(1).
	//
	// ⚠ **THEY ARE CACHED RATHER THAN COMPUTED ON DEMAND, AND THAT IS A COST DECISION.** `offsetOfField` is
	// asked once per field ACCESS the program writes — one of the hottest questions in the parser — and a
	// prefix sum computed there would walk `fieldTypes` up to `index` on every one of them, turning a
	// constant into a per-access walk of the declaring type's field list.
	//
	// ⚠⚠ **WHAT KEEPS THE CACHE HONEST IS THAT EVERY WRITER OF `fieldTypes` IS A METHOD OF THIS TYPE — and
	// when the columns landed that was ASSERTED rather than true.** The assertion read *"there are only two
	// writers of `fieldTypes`, and both are here"*; there were THREE. `TypeNameInterner.remapStructLayoutFieldTypes`
	// replaced the whole column from OUTSIDE the type and rebuilt nothing, so the offsets survived only
	// because `remapMaxonType` happens to be TAG-PRESERVING — a property of a function in another file that
	// nothing stated and nothing checked. One arm there that changed a tag (canonicalizing a tuple-alias
	// `named` to a `structRef`, which this codebase already does elsewhere) and every field after an
	// interface field would silently read the witness half, with no compile error anywhere. That third
	// writer now goes through `replaceFieldTypes` below, so the sentence is structural instead of hopeful:
	// `addField` appends one term, `retypeField` and `replaceFieldTypes` rebuild, and there is no fourth door.
	export var fieldOffsets as ByteOffsetArray
	// The total the prefix sum ends at — the box's payload bytes for a type with at least one field. NOT
	// `sizeBytes()`, which floors an EMPTY struct at one slot; see there for why that floor exists.
	export var slotBytes as ByteOffset
	// The GENERIC TYPE PARAMETERS this type declares (P1.6-A): `uses T` ⇒ `[T]`, `uses A, B` ⇒
	// `[A, B]`, empty for a non-generic type. Recorded IN DECLARATION ORDER, because the order is the
	// ARGUMENT BINDING: `Box with X` binds arg 0 to the param at position 0. It rides on the layout (which
	// already travels whole-program) so the instantiation-site arity check reads it straight off `structOf`,
	// needing no separate registry.
	//
	// ⚠ **THE ORDER IS THE BINDING AND IT IS NOT THE IDENTITY — THAT SENTENCE WAS HERE AND IT WAS THE BUG
	// (W14).** A `T` in a field or method type used to be `typeParameter(POSITION)`, which made every generic
	// type's first parameter ONE value; it now carries a digest of `(this type's name, the parameter's name)`
	// — see `ProgramSignatures.typeParamTokenFor`. This list is still what a position is READ OUT OF (a token
	// re-spells against it at `typeParamPositionIn`, and `recordStruct` files the pairing at the fold), which
	// is why it stays in declaration order and why it stays on the layout.
	export var typeParamNames as ByteArrayArray
	// The `where T is <Interface> …` CONSTRAINTS this generic type declares (P1.7a slice 2a), IN SOURCE
	// ORDER — empty for an unconstrained (or non-generic) type. The order is the witness-slot order the
	// dictionary-passing ABI threads: an instance method of a constrained type carries one hidden witness
	// pointer per entry here, index-aligned. It rides the layout (which travels whole-program) for
	// `typeParamNames`' reason — the E3017 instantiation check reads it straight off `structOf`.
	export var whereConstraints as WhereConstraintArray
	// ⭐ **THE INTERFACE NAMES THIS TYPE'S `implements` CLAUSE WRITES, IN SOURCE ORDER** — the twin of
	// `EnumLayout.conformsTo`, and the fact an INTERFACE EXTENSION is expanded against: `extension Countable`
	// declares a method on every type whose list holds `Countable`, so this column is the whole-program
	// relation `foldExtensionDeclarations` and `Parser.parseExtensionDeclaration` both walk.
	//
	// ⚠ **IT IS THE DECLARATION SWEEP'S COPY AND IT IS NOT THE CONFORMANCE CHECKER'S.** `ConformanceDecl`
	// (recorded by the REAL parse, into `project.conformances`) carries the same interface names PLUS their
	// `with` bindings and the source position an E3015/E3016 lands on — everything a conformance is VERIFIED
	// from. This column carries the names alone, because it is read at a moment the other record does not yet
	// exist: an extension's methods must be in the whole-program signature index before ANY file is parsed,
	// and a `type X implements Countable` may live in a file that has not been parsed yet. Two records of one
	// relation is exactly this project's signature bug, so the split is stated rather than assumed: this one
	// is the SWEEP's answer to "which interfaces does this type name?", used only to expand extensions, and
	// nothing verifies a conformance from it.
	export var conformsTo as ByteArrayArray
	// ⭐ **THE `with <TypeArgs>` EACH NAME IN `conformsTo` BINDS** — the associated-type bindings a
	// CONDITIONAL extension's `where` clause is evaluated against: `extension Holder where Item is Comparable`
	// asks what each conformer binds `Item` to, and that is the fact this column carries. Doubly positional —
	// `conformanceBindings[i]` is the list `conformsTo[i]` wrote, and within it position `j` binds that
	// interface's associated type `j`, which is the position a `WhereConstraint.typeParamIndex` names.
	//
	// ⚠ **IT IS EITHER EMPTY OR EXACTLY AS LONG AS `conformsTo`**, and `recordConformances` is the one writer
	// that can establish that. Empty means the clause wrote no `with` anywhere — the common case, which
	// allocates nothing (`sharedEmptyConformanceBindings`); otherwise every name has an entry, the shared
	// empty list standing at each position that bound nothing. A column that could be SHORT would make the
	// pairing a search over two lengths, which is the shape that answers with a neighbour's binding.
	//
	// ⚠ **IT USED TO BE ONE LIST BELONGING TO THE LAST NAME, BECAUSE THE READER COULD RECORD ONLY ONE (W95).**
	// `readOptionalImplementsClause` stopped the interface list at the first `with`, so one clause contributed
	// at most one bindings list — and the interfaces after that `with` were lost along with their extensions.
	// The reader now runs a second time, whole-program, where the arity that ends a `with` is known
	// (`Queries.foldConformanceClauses`), and a clause can contribute a binding at every name.
	export var conformanceBindings as ConformanceBindingArray
	// ⭐⭐ **THE TYPE'S MESSAGE ROSTER — its `export`/`public` INSTANCE methods, IN DECLARATION ORDER (SV1).**
	// A `spawn T.create()` anywhere in the program makes `T` a service, and this list IS the synthesized
	// `T.request` union's variant order after the compiler's own `__shutdown` at variant 0. The ORDER is
	// therefore a wire format: reordering two exported methods renumbers two variants.
	//
	// ⚠ **MEMBERSHIP IS `isProgramWideTier` AND `takesReceiver`, and each half excludes something different.**
	// The tier is the reach `export` and `public` share (see `isProgramWideTier`) — a `module` or file-private
	// method is reachable only through the value, never through the handle, which is what makes a self-send
	// unspellable rather than diagnosed. `takesReceiver` excludes every `static` STRUCTURALLY: a static has no
	// `self` to serialize against, and `spawn Calc.create()` calls one DIRECTLY rather than through a handle.
	//
	// ⚠ **THE DECLARATION SWEEP IS THE ONLY WRITER, AND THE REAL PARSE READS IT BACK.** The obvious symmetry —
	// have `parseTypeMember` fill it too, as it fills the field columns — would be ONE FACT WRITTEN TWICE, in
	// the one place a drift is a renumbered variant rather than a diagnostic. Every consumer asks
	// `ProgramSignatures.structOf`, which is whole-program and complete before any file is parsed.
	//
	// ⚠ **IT IS NOT MIXED INTO `recordStruct`'s HASH, and that is a derivation rather than an omission.** Every
	// input to this list — each method's NAME, its `visibility`, its `takesReceiver` and its declaration ORDER —
	// is already folded into `self.hash` by `mixDeclaration`, one entry per declared function, in fold order. A
	// second mix would be the same bytes hashed twice under a different shape.
	export var messageMethodNames as ByteArrayArray
	// ⭐ **THE DECLARATION'S OWN VISIBILITY (N1a)** — `type Point` vs `module type Point` vs
	// `export type Point`. Read by `Parser.typeNameVisibleHere`, the door a source-written type NAME in a
	// dotted primary goes through, and by `Parser.requireFieldAccessible`, which meets it at the first field
	// access on a value of the type.
	//
	// ⚠ It is `global` for every COMPILER-SYNTHESIZED layout (a tuple,
	// `__ManagedFile`, `__ManagedDirectory`): those are not written in any file, so no file may be refused
	// them — and `declFilePath` is correspondingly empty, which no tier but `file` ever reads.
	export var visibility as Visibility
	// The file this type was declared in — the anchor both wider tiers measure a reader against. Empty for a
	// compiler-synthesized layout, whose `visibility` is `global` and never consults it.
	export var declFilePath as FilePath

	// An EMPTY layout, filled by `addField` (and, for a generic type, `recordTypeParams`). It does not
	// take the columns, deliberately: handing pre-built parallel arrays across a call boundary is
	// exactly the shape that lets one arrive short.
	export static function create(name ByteArray, visibility Visibility, declFilePath FilePath) returns StructLayout
		return Self{name: name, fieldNames: ByteArrayArray.create(), fieldTypes: MaxonTypeArray.create(), fieldMutable: BoolArray.create(), fieldVisibility: VisibilityArray.create(), fieldDefaults: FieldDefaultArray.create(), fieldDeclaredSurfaces: DeclaredSurfaceArray.create(), fieldOffsets: ByteOffsetArray.create(), slotBytes: 0, typeParamNames: ByteArrayArray.create(), whereConstraints: sharedEmptyWhereConstraints, conformsTo: sharedEmptyDeclaredConformances, conformanceBindings: sharedEmptyConformanceBindings, messageMethodNames: sharedEmptyMessageMethods, visibility: visibility, declFilePath: declFilePath}
	end 'create'

	// The layout every COMPILER-SYNTHESIZED type takes: nameable from any file, declared in none. Spelled
	// once so the five synthesis sites cannot come to disagree about which tier a builtin wears.
	export static function createCompilerOwned(name ByteArray) returns StructLayout
		return StructLayout.create(name, visibility: Visibility.global, declFilePath: CompilerOwnedDeclFilePath)
	end 'createCompilerOwned'

	// Record the type's `uses` parameter names, in declaration order (P1.6-A). Replaces the column
	// wholesale rather than appending per name — the whole list is known at once (the `uses` clause is
	// parsed as a unit), and the parser and the tolerant sweep must record the SAME list.
	export function recordTypeParams(names ByteArrayArray)
		self.typeParamNames = names
	end 'recordTypeParams'

	// Record the type's `where` constraints, in source order (P1.7a slice 2a). Replaces the column
	// wholesale for `recordTypeParams`' reason — the whole `where` clause is parsed as a unit, and the
	// tolerant sweep and the real parse must record the SAME list (the witness-slot order depends on it).
	export function recordWhereConstraints(constraints WhereConstraintArray)
		self.whereConstraints = constraints
	end 'recordWhereConstraints'

	// Record the interface names the type's `implements` clause writes, and the `with` arguments each of them
	// binds. Replaces both columns wholesale for `recordTypeParams`' reason — the clause is read as a unit, by
	// the one reader every pass shares — and takes them TOGETHER because they are one read: a bindings list
	// recorded without the names it is positional against indexes nothing.
	//
	// ⚠ **THE LENGTH INVARIANT IS ASSERTED HERE, WHICH IS THE ONLY PLACE IT CAN BE.** `bindingsForInterface`
	// pairs the two columns by index and `mixConformanceBindings` walks them together; a column that arrived
	// short would make the first read a neighbour's binding and the second hash one declaration's clause as
	// another's. See `conformanceBindings` for the two admitted shapes.
	// Record the type's message roster, in declaration order (SV1). Replaces the column wholesale for
	// `recordTypeParams`' reason — the whole list is known at one moment, once every member has been read —
	// and a roster that turned out EMPTY (every type in every program that declares no service) keeps the
	// SHARED empty rather than retaining a per-type array of nothing.
	export function recordMessageMethods(methodNames ByteArrayArray)
		if methodNames.count() == 0 'noMessages'
			return
		end 'noMessages'

		self.messageMethodNames = methodNames
	end 'recordMessageMethods'

	// The number of messages on this type's roster — 0 for every type that is not a service, and for a
	// service that exports no instance method (which is legal: it can still be shut down).
	export function messageMethodCount() returns FieldIndex
		return self.messageMethodNames.count()
	end 'messageMethodCount'

	export function messageMethodAt(index FieldIndex) returns ByteArray
		return try self.messageMethodNames.get(index) otherwise panic("StructLayout.messageMethodAt: index {index} is out of range for `type {String.from(self.name)}`, whose roster holds {self.messageMethodNames.count()} message(s)")
	end 'messageMethodAt'

	export function recordConformances(names ByteArrayArray, bindings ConformanceBindingArray)
		if bindings.count() != 0 and bindings.count() != names.count() 'columnsDisagree'
			panic("StructLayout.recordConformances: `type {String.from(self.name)}` records {names.count()} interface name(s) against {bindings.count()} binding list(s) — the two columns are paired by INDEX, so a reader of the shorter one answers with the wrong conformance's `with` arguments")
		end 'columnsDisagree'

		self.conformsTo = names
		self.conformanceBindings = bindings
	end 'recordConformances'

	// What this type binds `interfaceName`'s associated types to, or an empty list when its clause binds
	// nothing at that interface (see `conformanceBindings`). The pairing is checked rather than assumed: a
	// caller that asked about an interface this type does not name must get "no bindings", never a
	// neighbour's.
	export function bindingsForInterface(interfaceName ByteArray) returns ByteArrayArray
		// Bounded by the BINDINGS column and not the names one, which is what makes the walk correct for both
		// admitted shapes: a declaration with no `implements` clause at all carries the shared empty here and
		// never enters the loop, while a declaration that has one carries an entry per name.
		for i in 0 upto self.conformanceBindings.count() 'eachConformance'
			let declared = try self.conformsTo.get(i) otherwise panic("StructLayout.bindingsForInterface: conformsTo.get OOB at {i} on a list of {self.conformsTo.count()}, which `recordConformances` pairs with {self.conformanceBindings.count()} binding list(s)")
			if not declared.equals(interfaceName) 'boundToAnother'
				continue
			end 'boundToAnother'

			return try self.conformanceBindings.get(i) otherwise panic("StructLayout.bindingsForInterface: conformanceBindings.get OOB at {i} below count {self.conformanceBindings.count()}")
		end 'eachConformance'

		return sharedEmptyDeclaredConformances
	end 'bindingsForInterface'

	// The number of `where` constraints (P1.7a slice 2a) — the number of hidden witness parameters an
	// instance method of this type carries under dictionary-passing. 0 for an unconstrained type.
	export function whereConstraintCount() returns FieldIndex
		return self.whereConstraints.count()
	end 'whereConstraintCount'

	// The number of generic type parameters (P1.6-A) — 0 for a non-generic type, the arity a
	// `Base with Args` instantiation must match.
	export function typeParamCount() returns FieldIndex
		return self.typeParamNames.count()
	end 'typeParamCount'

	// Append one declared field. THE one writer of the columns — every column, one push, so they
	// cannot drift.
	export function addField(fieldName ByteArray, declaredType MaxonType, mutable bool, tier Visibility, defaultValue FieldDefault, declaredSurface DeclaredSurface)
		self.fieldNames.push(fieldName)
		self.fieldTypes.push(declaredType)
		self.fieldMutable.push(mutable)
		self.fieldVisibility.push(tier)
		self.fieldDefaults.push(defaultValue)
		self.fieldDeclaredSurfaces.push(declaredSurface)
		// The prefix sum extends by one term: this field starts where the running total stands, and the total
		// advances by this field's own slot count. Same push, so the derived columns cannot fall out of the
		// lockstep the header above rests on.
		self.fieldOffsets.push(self.slotBytes)
		self.slotBytes = self.slotBytes + self.bytesOfField(fieldName, declaredType: declaredType)
	end 'addField'

	// ⭐⭐ **WHAT ONE FIELD OCCUPIES — the ONE answer `addField` and `rebuildSlotGeometry` share.** It used
	// to be `fieldSlotCount(declaredType) * FieldSlotBytes` written out at both, which was fine while the
	// answer depended on the declared TYPE alone. The ENVELOPE COLLAPSE below depends on the field's NAME
	// and on the enclosing type's `implements` clause as well, and a rule stated at only one of two
	// prefix-sum sites is a layout that changes under `retypeField` — i.e. a field offset that lands
	// mid-value, on exactly the types this rule exists for.
	function bytesOfField(fieldName ByteArray, declaredType MaxonType) returns ByteOffset
		if self.isInlineManagedField(fieldName) 'embeddedWhole'
			return InlineManagedMemoryBytes
		end 'embeddedWhole'
		return fieldSlotCount(declaredType) * FieldSlotBytes
	end 'bytesOfField'

	// ⭐⭐ **THE ENVELOPE COLLAPSE: a `managed` field of a BUILTIN LITERAL CONFORMER is the 48-byte
	// `__ManagedMemory` EMBEDDED WHOLE, not an 8-byte pointer to one.** `type String` declares exactly two
	// fields (`managed`, `singleByteGraphemesFlag`) and the record it must lay out as is the 56-byte one
	// `StringRuntime` reads — `buffer@0`, `length@8`, `capacity@16`, `element_size@24`, `parent@32`,
	// `element_destroy@40`, `singleByteGraphemes@48`. Those are the same bytes: the first SIX slots ARE a
	// `__ManagedMemory`, so the corpus's `managed` occupies 0..48 and its flag lands at 48. **A String IS its
	// own `__ManagedMemory`**, which is why the reference calls this the envelope collapse rather than an
	// embedding — and since W157 that is true of the WHOLE buffer record rather than of its first five
	// slots, which is what makes a String record servable to buffer code without a minted view.
	//
	// ⭐ **IT IS DETECTED BY CONFORMANCE, NOT BY THE FIELD NAME ALONE, AND THAT IS LOAD-BEARING.** Plain
	// pointer-valued `managed` fields exist and must stay 8 bytes — `StringIterator.managed`, and the
	// cursor source an `ArrayIter` holds — so keying on the name by itself would silently widen an
	// ordinary struct by 40 bytes. The marker interfaces are the reference's own discriminator
	// (`MlirType.ConformsToBuiltinManagedWrapper`), they are declared in `stdlib/Builtins.maxon`, which the
	// loader already lists, and they exist for precisely this purpose: *"marker interfaces the compiler
	// scans for to resolve literal syntax"*.
	//
	// ⚠ **`conformsTo` IS RECORDED BEFORE ANY FIELD IS, AND THE SWEEP IS WHERE BOTH HAPPEN.**
	// `Parser.recordScannedType` reads the `implements` clause into the layout (`recordConformances`) and
	// only then walks the body — so this question always has its answer by the time a field asks it. A
	// conformance recorded AFTER a field would silently lay that field out at the pointer width.
	function isInlineManagedField(fieldName ByteArray) returns bool
		if not fieldName.equals(InlineManagedFieldName) 'notTheManagedField'
			return false
		end 'notTheManagedField'
		return self.conformsToBuiltinManagedWrapper()
	end 'isInlineManagedField'

	// Does this type's `implements` clause name one of the three literal markers? A type that names none —
	// every user struct, and almost every stdlib one — takes the ordinary pointer width for every field.
	//
	// ⭐ Exported because the LAYOUT question and the CONSTRUCTION question are the same question: a type
	// whose `managed` is embedded whole is exactly a type whose literal may not store a pointer at offset 0
	// (`Parser.emitStructLiteral`). Two predicates would be two answers to "is this record fused?".
	export function conformsToBuiltinManagedWrapper() returns bool
		for interfaceName in self.conformsTo 'eachDeclared'
			if isBuiltinManagedWrapperInterface(interfaceName) 'aMarker'
				return true
			end 'aMarker'
		end 'eachDeclared'
		return false
	end 'conformsToBuiltinManagedWrapper'

	// ⭐ **WHICH marker this layout declares — the name the REFUSAL quotes.** `Parser.requireFusedWrapperTag`
	// admits a fused record only for the two names the compiler owns the record for, and the diagnostic it
	// raises for every other conformer names the `implements` clause the author actually wrote rather than the
	// three it might have been.
	//
	// ⚠ It is a SECOND walk of `conformsTo` beside the bool above, and deliberately: that one is asked at every
	// struct literal in the program and answers a LAYOUT question, this one is asked only on the refusal path
	// and builds a MESSAGE. Folding them would put a `ByteArray` result and a not-found encoding on the hot
	// question to save a loop on the cold one. Precondition: `conformsToBuiltinManagedWrapper()`, which the one
	// caller has already asked — so "declares none" is a caller bug and panics rather than answering.
	export function requireBuiltinManagedWrapperInterfaceName() returns ByteArray
		for declared in self.conformsTo 'eachDeclared'
			if isBuiltinManagedWrapperInterface(declared) 'aMarker'
				return declared
			end 'aMarker'
		end 'eachDeclared'
		panic("StructLayout.requireBuiltinManagedWrapperInterfaceName: `type {String.from(self.name)}` declares no builtin literal marker — the caller establishes conformance with `conformsToBuiltinManagedWrapper` before asking which one")
	end 'requireBuiltinManagedWrapperInterfaceName'

	// The declaration index of the inline `managed` field, or `fieldCount()` when this layout has none —
	// PAST-THE-END, which is `indexOfField`'s own spelling of "not found" two screens down, so the two
	// absent answers on this type are one convention rather than two. The construction needs the SOURCE
	// value the literal supplied for that field, and the field's position is the only way to find it in a
	// column parallel to the layout.
	export function inlineManagedFieldIndex() returns FieldIndex
		for i in 0 upto self.fieldCount() 'eachField'
			if self.isInlineManagedField(try self.fieldNames.get(i) otherwise panic("StructLayout.inlineManagedFieldIndex: fieldNames.get OOB at {i} for `type {String.from(self.name)}` below its own count")) 'found'
				return i
			end 'found'
		end 'eachField'
		return self.fieldCount()
	end 'inlineManagedFieldIndex'

	// ⭐⭐ **IS FIELD `index` THE INLINE `managed` WHOSE ADDRESS *IS* THE RECEIVER'S? — THE ONE HOME OF A
	// TEST THAT WAS SPELLED TWICE (W194 review).** Both halves matter and neither implies the other: the
	// marker says this declaration's `managed` is embedded WHOLE rather than as a pointer, and the index says
	// this particular field is that one.
	//
	// ⛔⛔ **THE TWO ASKERS ARE THE FUSED RECORD DOOR AND THE VIEW MINT, AND THEY MUST NOT COME TO DISAGREE
	// ABOUT WHICH FIELD THEY MEAN.** `Parser.selfFieldIsInlineManaged` decides whether a self-field alias
	// denotes the receiver itself; `Parser.emitFieldLoad`'s `inlineManagedIsTheReceiver` arm decides whether
	// a field READ is a load at all or the surface flip. The first function's own header already stated the
	// obligation — *"the same two questions `emitFieldLoad`'s own arm asks, in one place because the record
	// door above and the view mint below must agree about which field they are talking about"* — while the
	// arm went on spelling the conjunction itself, so the sentence was a promise and not a mechanism. A
	// wrapper that ever gains a second embedded field would be taught to one of them and not the other, and
	// the disagreement is a WRONG ANSWER rather than a compile error: one door hands back the receiver's own
	// record and the other emits a `loadIndirect` at that field's offset, which for field 0 reads `buffer@0`
	// — a raw byte pointer where a buffer RECORD is wanted.
	//
	// ⚠ **THE MARKER CONJUNCT IS NOT REDUNDANT AND IS ASKED FIRST.** A FIELDLESS layout answers
	// `fieldCount()` — zero — from the index above, which is its "not found" spelling; an index-only test
	// would therefore read `index == 0` as TRUE about a field that does not exist. Both callers relied on the
	// conjunction for that, separately, which is one more reason it belongs in one place.
	export function fieldIsTheInlineManagedRecord(index FieldIndex) returns bool
		return self.conformsToBuiltinManagedWrapper() and index == self.inlineManagedFieldIndex()
	end 'fieldIsTheInlineManagedRecord'

	// ⭐ **REPLACE FIELD `index`'s DECLARED TYPE — the ONE write that is not an append (N3).** The declaration
	// SWEEP records a field's type before any generic alias is interned, so a field declared with an alias two
	// files declare differently carries a name that cannot be resolved until every file has folded. That
	// resolution happens once, at `ProgramSignatures.resolveRecordedGenericAliasTypes`, and lands here.
	//
	// ⚠ It rewrites ONE DECLARED column, which is why it is not a violation of `addField`'s "one writer" rule:
	// the columns stay in lockstep because no length changes. It is deliberately not general — there is
	// exactly one caller per REASON, and a further reason to retype a recorded field would be a further reason
	// for two passes to disagree about what a declaration says. The reasons are the three facts the sweep
	// structurally cannot answer, each settled once with every file folded: N3's contested generic ALIAS
	// (above), the swept `named` that denotes an INTERFACE (`normalizeSweptInterfaceTypes`), and the swept
	// `named` that is a BARE GENERIC NAME at the declaring type's own parameters
	// (`normalizeSweptScopedGenericFields`).
	//
	// ⚠⚠ **AND IT REBUILDS THE DERIVED SLOT GEOMETRY, BECAUSE `normalizeSweptInterfaceTypes` CHANGES A
	// FIELD'S SLOT COUNT** (P1.7a-existentials slice 2). A swept `named` that denotes an interface is
	// re-tagged `interfaceRef` HERE, and that field goes from one slot to two — so every later field's offset
	// and the box's size move with it. Recomputed whole rather than patched from `index` on: this runs once
	// per retyped field on a program that declares an interface at all, and a partial rebuild would be a
	// second statement of the prefix sum.
	export function retypeField(index FieldIndex, declaredType MaxonType)
		try self.fieldTypes.set(index, value: declaredType) otherwise panic("StructLayout.retypeField: fieldTypes.set OOB at {index} for `type {String.from(self.name)}`, which declares {self.fieldCount()} — the caller walks `0 upto fieldCount()`")
		self.rebuildSlotGeometry()
	end 'retypeField'

	// ⭐ **REPLACE THE WHOLE DECLARED-TYPE COLUMN — the merge's door, and the reason it is a METHOD.**
	// `TypeNameInterner.remapStructLayoutFieldTypes` rewrites every field type through an id remap when a
	// file's layouts are folded into a bigger table, and it used to assign `layout.fieldTypes` directly from
	// outside this type, leaving the derived geometry stale. Nothing about a remap FORBIDS a tag change — it
	// only happens not to make one today — so the rebuild belongs on this side of the boundary, where the
	// columns are, rather than resting on a caller remembering. See `fieldOffsets`.
	//
	// The length is a precondition, not a case: a remap rewrites one column in place and pushes exactly what
	// it read, so a short one is a broken remap rather than a program this could report on.
	export function replaceFieldTypes(types MaxonTypeArray)
		if types.count() != self.fieldTypes.count() 'lengthChanged'
			panic("StructLayout.replaceFieldTypes: `type {String.from(self.name)}` declares {self.fieldCount()} field(s) and the replacement column holds a different number — a remap rewrites one column in place and cannot change its length")
		end 'lengthChanged'

		self.fieldTypes = types
		self.rebuildSlotGeometry()
	end 'replaceFieldTypes'

	// Recompute `fieldOffsets`/`slotBytes` from `fieldTypes` — the prefix sum, stated ONCE (`addField`
	// extends it by one term rather than restating it).
	function rebuildSlotGeometry()
		var offsets = ByteOffsetArray.create()
		var total = 0 as ByteOffset
		for i in 0 upto self.fieldTypes.count() 'eachField'
			offsets.push(total)
			let fieldName = try self.fieldNames.get(i) otherwise panic("StructLayout.rebuildSlotGeometry: fieldNames.get OOB at {i} for `type {String.from(self.name)}` below its own count")
			total = total + self.bytesOfField(fieldName, declaredType: try self.fieldTypes.get(i) otherwise panic("StructLayout.rebuildSlotGeometry: fieldTypes.get OOB at {i} for `type {String.from(self.name)}` below its own count"))
		end 'eachField'
		self.fieldOffsets = offsets
		self.slotBytes = total
	end 'rebuildSlotGeometry'

	// ⚠ **THE OOB PANIC SENTENCE BELOW IS REPEATED PER COLUMN, AND THE COPY IS FORCED BY THE
	// LANGUAGE, NOT CHOSEN.** `panic` takes a string LITERAL — `panic(msg)` for any String value,
	// even a `let`-bound one, is rejected outright ("panic requires a string argument", measured
	// against the bootstrap) — so the one text cannot be built by a shared helper and handed over.
	// A forced copy is worth saying so about: the cure for one-fact-twice is DERIVE > CHECK >
	// COMMENT, and this is the tier where only the comment is available. If `panic` ever takes an
	// expression, these collapse into one.

	// Does field `index` accept a write? `export var count` does; `export let version` does not, and
	// `c.version = 2` is E2013 (see `Parser.parseFieldAssignment`).
	export function fieldIsMutable(index FieldIndex) returns bool
		return try self.fieldMutable.get(index) otherwise panic("StructLayout.fieldIsMutable: fieldMutable.get OOB at {index} for `type {String.from(self.name)}`, which declares {self.fieldCount()} — every index handed out came from `indexOfField`")
	end 'fieldIsMutable'

	// Is field `index` reachable from outside this type? `export var n` is; a bare `var n` is not,
	// and `v.n` from anywhere but `type Value`'s own body is E3014 (see
	// `Parser.requireFieldAccessible`). The gate is the TYPE, not the file.
	export function fieldTier(index FieldIndex) returns Visibility
		return try self.fieldVisibility.get(index) otherwise panic("StructLayout.fieldTier: fieldVisibility.get OOB at {index} for `type {String.from(self.name)}`, which declares {self.fieldCount()} — every index handed out came from `indexOfField`")
	end 'fieldTier'

	// What field `index` defaults to when a `Self{…}` literal omits it.
	export function fieldDefault(index FieldIndex) returns FieldDefault
		return try self.fieldDefaults.get(index) otherwise panic("StructLayout.fieldDefault: fieldDefaults.get OOB at {index} for `type {String.from(self.name)}`, which declares {self.fieldCount()} — every index handed out came from `indexOfField`")
	end 'fieldDefault'

	// Where did field `index`'s declaration name `__ManagedMemory` (A2j / A2m)? `fieldIsMutable`'s twin in
	// every respect — one word per field, off the declared SPELLING, written only by `addField`, read only
	// through here for one `FieldIndex`. Its ONE reader outside the hash is `ProgramSignatures.fieldSurfaceOf`,
	// which completes it with the derived element bit before any field read sees it.
	export function fieldDeclaredSurface(index FieldIndex) returns DeclaredSurface
		return try self.fieldDeclaredSurfaces.get(index) otherwise panic("StructLayout.fieldDeclaredSurface: fieldDeclaredSurfaces.get OOB at {index} for `type {String.from(self.name)}`, which declares {self.fieldCount()} — every index handed out came from `indexOfField`")
	end 'fieldDeclaredSurface'

	export function fieldCount() returns FieldIndex
		return self.fieldNames.count()
	end 'fieldCount'

	// The declaration index of the field named `wanted`, or `fieldCount()` when the struct declares
	// no such field. A linear scan, for `indexOfParamIn`'s reason and with its
	// measurement behind it: field counts are tiny, and a per-layout name→index map would be a
	// heap object per declared type bought to serve a handful of lookups.
	export function indexOfField(wanted ByteArray) returns FieldIndex
		for i in 0 upto self.fieldNames.count() 'each'
			let fieldName = try self.fieldNames.get(i) otherwise panic("StructLayout.indexOfField: fieldNames.get OOB at {i}")
			if fieldName.equals(wanted) 'match'
				return i
			end 'match'
		end 'each'
		return self.fieldNames.count()
	end 'indexOfField'

	// The name of field `index` — `EnumLayout.caseNameAt`'s twin, and here so the OOB panic is written once
	// rather than at each site that renders a field's name into a diagnostic.
	export function fieldNameAt(index FieldIndex) returns ByteArray
		return try self.fieldNames.get(index) otherwise panic("StructLayout.fieldNameAt: fieldNames.get OOB at {index} for `type {String.from(self.name)}`, which declares {self.fieldCount()} field(s)")
	end 'fieldNameAt'

	// Does this type declare a field named `wanted`? — `EnumLayout.hasCase`'s twin, and here for its reason:
	// `indexOfField`'s "absent" answer is the SENTINEL `fieldCount()`, and every caller that only wants the
	// yes/no was re-spelling that comparison. Two had (`Parser.enumBackingFieldMember` as
	// `indexOfField(...) < fieldCount()`, `Parser.emitEnumBackingFieldSelect` as the `>=` throw), which is
	// the convention written down in three places and changeable in none.
	export function declaresField(wanted ByteArray) returns bool
		return self.indexOfField(wanted) < self.fieldCount()
	end 'declaresField'

	// The byte displacement of field `index` from the box's PAYLOAD pointer — which is what
	// `__mm_alloc` returns, so the header is invisible here and the first field sits at 0. Read straight off
	// the derived prefix sum; see `fieldOffsets` for why it is a column rather than a computation.
	export function offsetOfField(index FieldIndex) returns ByteOffset
		return try self.fieldOffsets.get(index) otherwise panic("StructLayout.offsetOfField: fieldOffsets.get OOB at {index} for `type {String.from(self.name)}`, which declares {self.fieldCount()} — every index handed out came from `indexOfField`")
	end 'offsetOfField'

	// The payload bytes `__mm_alloc` must be asked for. THE one place the size is computed, so the
	// allocation and the field stores that fill it cannot come to disagree about how big the box is.
	export function sizeBytes() returns ByteOffset
		if self.fieldNames.count() == 0 'empty'
			return EmptyStructBytes
		end 'empty'
		return self.slotBytes
	end 'sizeBytes'
end 'StructLayout'

export typealias StructLayoutArray = Array with StructLayout

// Registry: struct-type name -> its declaration. The twin of `RangedTypeAliasMap`, filled from
// each file's artifact by `mergeArtifact` and read by TypeResolution to turn `MaxonType.named` for
// a declared `type` into `MaxonType.structRef`.
export typealias StructLayoutMap = Map with (ByteArray, StructLayout)

// --- Union payload fields (P1.3 slice 1) ---

// One PAYLOAD FIELD of a `union`/`enum` case — `circle(radius Integer)` declares one named
// `radius` of declared type `named(Integer)`. Its SLOT is its position in the case's field list
// (`payload[j]` lives at byte offset `UnionTagBytes + j * FieldSlotBytes` in the box), so the
// index IS the slot and no second number is stored — the same "index is the identity" discipline
// `StructLayout.offsetOfField` rests on. The declared type is NOT resolved (the sweep that records
// it cannot resolve anything); the construct/extract sites resolve it through the same `aliasOf`/
// `enumOf`/`structOf` doors a struct field is resolved through, and reject the managed/float types
// slice 1 does not lower there.
export type PayloadField
	export let name as ByteArray
	export let declaredType as MaxonType

	// ⭐ **THE PRE-ERASURE `__ManagedMemory` SPELLING OF THIS PAYLOAD (BATCH22)** — `StructLayout`'s
	// `fieldDeclaredSurfaces` column, at the FIFTH declared position. A payload is spelled by the very type
	// reader a struct field and a parameter use, so `mem(m __ManagedMemory)` resolves to the identical
	// `genericInstance` a `ByteArray` payload does and `declaredType` above cannot carry the difference;
	// without this column the `match` binding was minted with no surface, i.e. the `Array` one. Read through
	// `ProgramSignatures.payloadSurfaceOf`, which ORs in the element bit the sweep could not answer.
	export let declaredSurface as DeclaredSurface

	export static function create(name ByteArray, declaredType MaxonType, declaredSurface DeclaredSurface) returns PayloadField
		return Self{name: name, declaredType: declaredType, declaredSurface: declaredSurface}
	end 'create'
end 'PayloadField'

export typealias PayloadFieldArray = Array with PayloadField
export typealias PayloadFieldArrayArray = Array with PayloadFieldArray

// ⭐⭐ **ONE ENTRY OF A CONSTANT STRUCT BACKING, AS THE DECLARATION COULD KNOW IT** — `value: 1` out of
// `add = Meta{value: 1}`, or the argument `1` out of `add = Meta.create(1)`.
//
// ⚠⚠ **IT IS DELIBERATELY NOT RESOLVED, AND THE REASON IS *WHEN* AN ENUM CASE IS READ.** The reader runs in
// the TOLERANT DECLARATION SWEEP — the pass that BUILDS the whole-program index — so at the moment a case is
// read there is no `structOf` to ask which field position 0 is, and no `enumOf` to ask what tag `Priority.low`
// carries. Both are answered at the USE (`Parser.emitEnumBackingFieldSelect`), where the index is complete.
// This is the same split the FUNCTION backing already makes for the same reason: the declaration records a
// NAME and the address is materialized per read (see `EnumBacking.functionRef`).
//
// ⭐⭐ **ONE CASE'S ENTRIES ARE A TREE, AND THE TREE IS HELD FLAT** (`/specs/enum-nested-struct-backing.md`):
// a field's value may itself be a constant struct, to any depth. An entry cannot hold the ARRAY of its own
// children — that array's element type would contain itself and Maxon forbids a type that does (E4014,
// `type 'X' contains a reference cycle`) — so every entry of a case, at every depth, rides in the ONE array
// `EnumLayout.backingFieldsAt` returns and says which GROUP it belongs to. It is the shape
// `SignatureIndex.ConstFactoryCall` already uses one directory over, for the identical reason.
export type EnumBackingField
	// ⭐ **THE FIELD'S NAME AS WRITTEN, OR `EmptySourceText` FOR A POSITIONAL FACTORY ARGUMENT** — the same
	// "no label here" spelling `Parser.consumeConstArgumentLabel` uses, and it means the same thing: the
	// field is the one at THIS entry's `position` in the struct's declaration order, which only the use site
	// can look up. `Meta{value: 1}` names every field; `OpInfo.create(1, throughput: 1)` names the second.
	export let name as ByteArray
	// ⭐ **WHICH ARGUMENT SLOT OF ITS OWN GROUP THIS ENTRY IS** — the number an unlabelled entry's field is
	// looked up by. It is WRITTEN DOWN rather than read off the entry's index in the array, which is what
	// it used to be and stopped being the moment every group of a case shared one array.
	export let position as FieldIndex
	export let group as EnumBackingGroupId
	export let value as EnumBackingFieldValue

	export static function create(name ByteArray, position FieldIndex, group EnumBackingGroupId, value EnumBackingFieldValue) returns EnumBackingField
		return Self{name: name, position: position, group: group, value: value}
	end 'create'
end 'EnumBackingField'

// The index of one entry in a case's flat entry array — `Parser.readEnumBackingEntryInto` pushes them and
// `Parser.requireEnumBackingEntryFilling` hands them back. Bounded like `FieldIndex`, and named apart from
// it because the two count different things: a field of a struct, and an entry of one case's backing.
export typealias EnumBackingEntryIndex = int(0 to 65535)

// ⭐⭐ **WHICH STRUCT CONSTANT AN ENTRY FILLS A FIELD OF** — `RootBackingGroup` for the case's own backing
// struct, and the OWNING ENTRY's index for a nested one. The two live in one number space because the root
// group is not an entry, and the `+ 1` that makes room for it is spelled in exactly one place below so no
// caller does the arithmetic itself.
export typealias EnumBackingGroupId = int(0 to 65536)

// The group every entry the case wrote at its OUTERMOST level belongs to — the case's own backing struct
// (`EnumLayout.backingStructName`), which has no entry of its own to be named by.
export let RootBackingGroup = 0 as EnumBackingGroupId

// The group of the entries filling the nested struct that entry `owner` writes. The ONE place the offset
// between an entry index and a group id exists.
export function nestedBackingGroupOf(owner EnumBackingEntryIndex) returns EnumBackingGroupId
	return owner + 1
end 'nestedBackingGroupOf'

// ⭐ **WHAT A BACKING FIELD'S VALUE IS, IN THE THREE FORMS THE DECLARATION CAN CARRY.** The admitted set is
// exactly `/specs/enum-struct-backing.md`'s — *"compile-time integer, float, or boolean constants, or nested
// struct literals"* — plus the enum-member reference its own two cases write (`Priority.low`, `Mode.fast`,
// `Cat.bool`).
export union EnumBackingFieldValue
	// A literal: `bits` is its value — an int's number, a bool's 0/1, or a float's IEEE-754 BIT PATTERN, the
	// same `ParsedInt` payload every other constant in this compiler travels in (`ConstValue`,
	// `EnumLayout.caseTags`) — and `tag` is WHICH of those it was.
	//
	// ⛔⛔ **`tag` IS NOT DECORATION, AND ITS ABSENCE WAS A COMPILER PANIC AND A WILD POINTER.** This arm
	// carried only the bits for one edit, which made `1`, `1.5` and `true` indistinguishable after parse — so
	// nothing could check a written value against the field's DECLARED type, and nothing did. MEASURED on the
	// tree that shipped it: a `Real` field written `1.5` reached `X64Backend.maxon:834` as
	// *"a register-to-register move from rax to xmm0 crosses register files"*, a compiler panic on a
	// legal-looking program; and a `String` field written `1` COMPILED CLEAN and access-violated at run time
	// (exit `0xC0000005`), a String record address of 1 dereferenced on print. The check that consumes this
	// is `Parser.checkStructBackedCase`.
	//
	// It is an `EnumBackingLiteralKind` and not a `ValueTypeTag` because exactly three literals can be
	// written here: a tag would give the door a match over the whole value space to answer, most of which
	// `readEnumBackingFieldValue` cannot produce, and the two could then drift apart.
	literal(bits ParsedInt, kind EnumBackingLiteralKind)
	// `Priority.low` — a case of ANOTHER enum, whose tag is a whole-program fact the declaration cannot
	// reach. Both names ride verbatim and the tag is read at the use site.
	enumCase(enumName ByteArray, caseName ByteArray)
	// ⭐ **A NESTED STRUCT CONSTANT — `Inner{value: 1}` or `Inner.create(1)` written for a field whose own
	// type is `Inner`.** It carries NO number, because a record is not one: this arm marks the entry as the
	// OWNER of a group, and the constants are the entries of that group (see `EnumBackingField`). The
	// struct's written NAME rides so the door can check it against the field's declared type, exactly as the
	// `enumCase` arm's enum name is checked against a field's declared enum.
	nestedStruct(structName ByteArray)
end 'EnumBackingFieldValue'

// ⭐ **THE THREE LITERALS A BACKING FIELD MAY BE WRITTEN AS** — the whole of what `readEnumBackingFieldValue`
// can produce, and therefore the whole of what the door has to answer for. `1` and `1.0` fold to the SAME
// `ParsedInt` (`floatLiteralBits(0.0)` is 0), so the bits alone cannot tell them apart and this is the fact
// that does.
export enum EnumBackingLiteralKind
	integerLiteral
	floatLiteral
	booleanLiteral
end 'EnumBackingLiteralKind'

// ⭐⭐ **WHAT A BACKING FIELD'S DECLARED TYPE DOES TO THE i64 THE SELECT SUM PRODUCES** — the ONE
// classification, asked by the DOOR that admits a case (`Parser.checkStructBackedCase`) and by the READ that
// decodes the sum (`Parser.emitEnumBackingFieldSelect`). Both are exhaustive over it, which is what makes
// "the door admits exactly what the read can decode" structural instead of a claim in a comment.
//
// ⚠ **THE SUM IS INTEGER ARITHMETIC — `emitCompareAgainstLiteral` → `mul` → `add`, `operandType = i64` —
// AND `retypeValue` ONLY REWRITES TYPE COLUMNS.** It does not convert, reinterpret or check. So a field
// whose domain is not the i64's needs an explicit decode, exactly as `Parser.emitEnumRawValue`'s float arm
// emits `MaxonUnaryOp.bitsToFloat` (whose header records four measured wrong answers from getting this
// wrong). The two pre-existing retype columns are safe only because a `.rdata` String address and a `.text`
// function address ARE i64 at Std — the one property a float field does not have.
export enum EnumBackingFieldDomain
	// `int`, `ExitCode`, a ranged-INT alias — the i64 IS the value, and only an int literal may fill it.
	integerWord
	// `bool` — the i64 is 0 or 1 (`TypeRules.BoolTrueValue` is 1), so the word is the value here too; it is
	// a separate arm because only a `true`/`false` literal may fill it.
	booleanWord
	// A declared enum — the i64 is that enum's TAG, which is what an enum value IS
	// (`Parser.parseEnumLiteral`). Only an `<Enum>.<case>` of the SAME enum may fill it.
	enumWord
	// `float`, or a ranged-FLOAT alias — the i64 is an IEEE-754 bit pattern and the read must REINTERPRET it.
	// An int literal is promoted to its f64 value, the same widening `TypeRules.widensIntToFloat` states and
	// `Parser.constFloatBits` performs for a constant.
	floatBits
	// ⭐⭐ **A DECLARED `type` — THE ONE DOMAIN THAT IS NOT A VALUE AT ALL.** A record is not one machine
	// word and the sum cannot denote one, so nothing is ever SELECTED at this domain: it is the domain a
	// read must keep DESCENDING through (`op.rawValue.meta.latency` — `Parser.resolveEnumBackingLeaf`) and
	// the one the door recurses into (`Parser.checkEnumBackingGroup`). It reaches a leaf, or it is refused.
	//
	// ⚠ It is NOT `unsupported`, and the difference is exactly the one this rung exists for: `unsupported`
	// says "no constant can stand for this", while a nested record's SCALAR LEAVES each can.
	nestedRecord
	// `String`, `Character`, an array, an interface, a function — a value the constant column cannot hold and
	// the sum cannot denote. Refused AT THE DOOR, so the read's decode never meets one.
	unsupported
end 'EnumBackingFieldDomain'

// ⭐ **DOES THIS DOMAIN NEED THE SUM REINTERPRETED?** - the one domain whose i64 is not the value,
// spelled as an exhaustive `match` and never as `== floatBits`, for `namesAnEnumInstanceAccessor`'s reason:
// a domain appended to the enum must be classified HERE too, so the read cannot silently start treating a
// new one as a machine word.
export function domainIsEnumBackingFloatBits(domain EnumBackingFieldDomain) returns bool
	match domain 'd'
		floatBits then return true
		integerWord then return false
		booleanWord then return false
		enumWord then return false
		nestedRecord then return false
		unsupported then return false
	end 'd'
end 'domainIsEnumBackingFloatBits'

// ⭐ **DOES THIS DOMAIN NAME A RECORD THE READ MUST DESCEND INTO RATHER THAN SELECT?** — the third of the
// family, and an exhaustive `match` for its siblings' reason: a domain appended to the enum must be
// classified here too, so a new one cannot silently be treated as a leaf by the walk that reads a chain.
export function domainIsEnumBackingNestedRecord(domain EnumBackingFieldDomain) returns bool
	match domain 'd'
		nestedRecord then return true
		integerWord then return false
		booleanWord then return false
		enumWord then return false
		floatBits then return false
		unsupported then return false
	end 'd'
end 'domainIsEnumBackingNestedRecord'

// ⭐ **IS THIS DOMAIN ONE NO CONSTANT COLUMN CAN HOLD?** — `domainIsEnumBackingFloatBits`' twin, and an
// exhaustive `match` for its reason: a domain appended to the enum must be classified here too, so a new one
// cannot silently be treated as holdable by the two gates that ask.
export function domainIsEnumBackingUnsupported(domain EnumBackingFieldDomain) returns bool
	match domain 'd'
		unsupported then return true
		integerWord then return false
		booleanWord then return false
		enumWord then return false
		floatBits then return false
		nestedRecord then return false
	end 'd'
end 'domainIsEnumBackingUnsupported'

// ⭐⭐ **THE PAIRING TABLE — MAY THIS WRITTEN CONSTANT FILL A FIELD OF THIS DOMAIN?** One function, read by
// one caller (`Parser.requireEnumBackingFieldValueSuitsField`), so the rule that decides and the sentence
// that explains it sit together. Split into the value forms below because they are answered by different
// questions: a LITERAL by its kind alone, and the two forms that NAME a type by that name's IDENTITY
// against the field's declared one — which is why the third argument is the declared TYPE's name and not
// specifically an enum's.
export function enumBackingValueSuitsDomain(value EnumBackingFieldValue, domain EnumBackingFieldDomain, declaredName ByteArray) returns bool
	match value 'written'
		literal(_, kind) then return enumBackingLiteralSuitsDomain(kind, domain: domain)
		enumCase(writtenEnum, _) then return enumBackingNamedValueSuitsDomain(writtenEnum, domain: domain, declaredName: declaredName, wanted: EnumBackingFieldDomain.enumWord)
		nestedStruct(writtenStruct) then return enumBackingNamedValueSuitsDomain(writtenStruct, domain: domain, declaredName: declaredName, wanted: EnumBackingFieldDomain.nestedRecord)
	end 'written'
end 'enumBackingValueSuitsDomain'

// ⚠ **EVERY ARM SPELLED OUT, NO RANGES.** `EnumBacking`'s header states the rule this obeys: a range is the
// one arm shape that can absorb a newly declared member silently, and here that would mean admitting a
// constant into a domain nobody classified — which is a wrong answer at the machine level, not a diagnostic.
function enumBackingLiteralSuitsDomain(kind EnumBackingLiteralKind, domain EnumBackingFieldDomain) returns bool
	match domain 'd'
		integerWord then return kind == EnumBackingLiteralKind.integerLiteral
		booleanWord then return kind == EnumBackingLiteralKind.booleanLiteral
		// ⭐ An INT literal is admitted into a FLOAT field and promoted to its f64 value at the read — the
		// widening `TypeRules.widensIntToFloat` states and `Parser.constFloatBits` performs for a constant,
		// so `M{ratio: 1}` means 1.0 exactly as `let x = 1 + 2.0` does. A bool has no float reading.
		floatBits then return kind == EnumBackingLiteralKind.integerLiteral or kind == EnumBackingLiteralKind.floatLiteral
		// A field of a declared enum takes `<ThatEnum>.<case>` and never a bare number: an enum value IS its
		// tag, and WHICH number that is belongs to the enum's declaration, not to this case.
		enumWord then return false
		// A field of a declared `type` takes that type's own constant (`Inner{…}` / `Inner.create(…)`) and
		// never a number: a record is not one word, and its constants are its LEAVES.
		nestedRecord then return false
		unsupported then return false
	end 'd'
end 'enumBackingLiteralSuitsDomain'

// ⭐ **THE BITS A LITERAL CONTRIBUTES TO THE SELECT SUM, WHICH IS NOT ALWAYS THE BITS IT WAS PARSED AS.**
// An INT literal written into a FLOAT field is PROMOTED to its f64 value here — the one thing the door
// admits that is not already in the field's domain (`enumBackingLiteralSuitsDomain`'s `floatBits` arm), and
// the same `0.0 + payload` widening `Parser.constFloatBits` performs for a constant, so `M{ratio: 1}` sums
// the bits of 1.0 and the read's `bitsToFloat` reinterprets them into 1.0 rather than into 4.9e-324.
//
// Every other admitted pairing already carries the right bits: an int in an integer field, a `true`/`false`
// in a bool field, a float literal in a float field (parsed as its IEEE pattern by `floatLiteralBits`).
export function enumBackingLiteralBits(bits ParsedInt, kind EnumBackingLiteralKind, domain EnumBackingFieldDomain) returns ParsedInt
	if domainIsEnumBackingFloatBits(domain) and kind == EnumBackingLiteralKind.integerLiteral 'promoteToFloat'
		return __Builtins.floatToBits(0.0 + bits)
	end 'promoteToFloat'

	return bits
end 'enumBackingLiteralBits'

// ⭐⭐ **THE TWO WRITTEN FORMS THAT NAME A TYPE — `Priority.low` and `Inner.create(1)` — SUIT A FIELD ONLY
// WHEN THE DOMAIN IS THEIRS *AND* THE NAMES MATCH.** `Config{mode: Priority.low}` on a `Mode`-typed field is
// refused, and so is `X64OpMeta.create(Other.create(1), setsFlags: true)` on an `OpMeta`-typed field — where
// a name-blind check would file one type's constants under a field every reader types as the other.
//
// ⚠ **ONE FUNCTION FOR BOTH FORMS, AND `wanted` IS THE WHOLE OF WHAT DIFFERS.** They ask the identical
// question of the identical pair of names; written out twice, the identity rule would be one fact in two
// places and a later refinement would land in one of them.
function enumBackingNamedValueSuitsDomain(written ByteArray, domain EnumBackingFieldDomain, declaredName ByteArray, wanted EnumBackingFieldDomain) returns bool
	return enumBackingDomainTakesANamedValue(domain, wanted: wanted) and written.equals(declaredName)
end 'enumBackingNamedValueSuitsDomain'

// ⚠ **EVERY ARM SPELLED OUT — NO RANGES, AND NOT A BARE `domain == wanted`.** `EnumBacking`'s header states
// the rule this obeys: a domain appended to the enum must be CLASSIFIED here, and an equality test would
// answer for a new one silently — admitting a `<Type>.<member>` constant into a domain nobody decided it
// suits, which is a wrong answer at the machine level rather than a diagnostic.
function enumBackingDomainTakesANamedValue(domain EnumBackingFieldDomain, wanted EnumBackingFieldDomain) returns bool
	match domain 'd'
		enumWord then return wanted == EnumBackingFieldDomain.enumWord
		nestedRecord then return wanted == EnumBackingFieldDomain.nestedRecord
		integerWord then return false
		booleanWord then return false
		floatBits then return false
		unsupported then return false
	end 'd'
end 'enumBackingDomainTakesANamedValue'

export typealias EnumBackingFieldArray = Array with EnumBackingField
export typealias EnumBackingFieldArrayArray = Array with EnumBackingFieldArray

// ⭐ **THE ONE EMPTY `EnumBackingFieldArray` EVERY NON-STRUCT-BACKED CASE SHARES.** `addCase` fills this
// column for EVERY case of EVERY enum in the program, and all but a struct-backed one have nothing to put
// in it — a fresh `create()` at each would be one allocation per case for a column nothing reads. It is the
// treatment `emitEnumCaseConstant`'s header already argues for one directory over, where a seed
// `ByteArray.create()` above a match was allocating per case for two arms that never read it.
export let sharedEmptyEnumBackingFields = EnumBackingFieldArray.create()

// A boxed union is `UnionTagBytes` (the i64 tag at offset 0) plus `FieldSlotBytes` per payload slot
// of the WIDEST case. The tag is always i64 — an enum value is its i64 tag, boxed or not — so the
// tag store/load width is fixed here rather than derived, the one place it lives.
export let UnionTagOffset = 0 as ByteOffset
let UnionTagBytes = 8 as ByteOffset

// The conformance list of a declaration that writes no `implements` clause — ONE shared empty for the
// whole compile, following `sharedEmptyInnerAliases` and its family: nearly every declaration in the corpus
// declares nothing, and a fresh empty array per declaration would be an allocation for a fact that is the
// absence of one. Read-only; `Parser.readOptionalImplementsClause` builds a real list only for a real clause.
//
// ⚠ **IT LIVES BESIDE THE FIELD IT IS THE EMPTY OF, AND THAT IS WHY IT MOVED HERE (A1s wave 2 review).**
// It was declared in `Parser.maxon` while the three `builtin…Enum()` seeds below — the other constructors of
// an `EnumLayout` — could not see it and each spelled `ByteArrayArray.create()` instead. Three spellings of
// "this enum declares nothing", one of them in the file that owns the field.
//
// ⚠ It is no longer the ENUM's alone: `StructLayout.conformsTo` (interface extensions) is the same column on
// the other declaration kind, filled by the same reader, and its absence is the same fact.
export let sharedEmptyDeclaredConformances = ByteArrayArray.create()

// ⭐ **ONE `with` ARGUMENT LIST PER INTERFACE NAMED, POSITIONAL AGAINST `conformsTo` (W95).** A clause may
// bind at more than one of its names — `implements Tagged with Integer, Held with Integer` binds at both —
// so the bindings are a column beside the names and not a single list belonging to the last of them. A name
// that wrote no `with` carries `sharedEmptyDeclaredConformances` at its position, which is what keeps the
// two columns the same length and makes the pairing index arithmetic rather than a search.
export typealias ConformanceBindingArray = Array with ByteArrayArray

// The bindings column of a declaration whose `implements` clause writes NO `with` anywhere — and of one
// that writes no clause at all. Shared for `sharedEmptyDeclaredConformances`' reason, which is the same
// reason one column over: nearly every declaration in the corpus binds nothing, and a fresh empty array per
// declaration would be an allocation for the absence of a fact. Read-only.
let sharedEmptyConformanceBindings = ConformanceBindingArray.create()

// ⭐ **WHAT ONE `implements` CLAUSE CONTRIBUTES: the interface NAMES, and the `with` arguments EACH of
// them binds.** `Parser.readOptionalImplementsClause` returns the pair rather than the names alone because
// they are one read — see `StructLayout.conformanceBindings` for how the two columns pair — and a bindings
// list handed over without the names it is positional against indexes nothing. An `enum`/`union` takes the
// names half and ignores the other: it has no conditional extension to evaluate.
export type ScannedConformanceClause
	export let names as ByteArrayArray
	export let bindings as ConformanceBindingArray

	export static function create(names ByteArrayArray, bindings ConformanceBindingArray) returns ScannedConformanceClause
		return Self{names: names, bindings: bindings}
	end 'create'

	// A declaration with no `implements` clause at all — both halves the shared empty, so the common case
	// allocates nothing.
	export static function declaringNothing() returns ScannedConformanceClause
		return Self{names: sharedEmptyDeclaredConformances, bindings: sharedEmptyConformanceBindings}
	end 'declaringNothing'
end 'ScannedConformanceClause'

// ⭐ **DOES AN `implements` LIST NAME `interfaceName`? — ONE SCAN, FOR BOTH DECLARATION KINDS.** A `type`'s
// `StructLayout.conformsTo` and an `enum`/`union`'s `EnumLayout.conformsTo` are the same column on two
// records, filled by the same reader, and the question asked of them is the same question. It was a method on
// each — two identical loops — until the `type` half gained the column for interface extensions.
//
// Nominal and direct, matching `ConformanceCheck.typeDeclaresInterface`'s model: shv2's conformance is
// DECLARED, never inferred. A linear scan of a list that holds one entry per name in one clause.
export function conformanceListDeclares(conformsTo ByteArrayArray, interfaceName ByteArray) returns bool
	for declaredInterface in conformsTo 'each'
		if declaredInterface.equals(interfaceName) 'declaresIt'
			return true
		end 'declaresIt'
	end 'each'
	return false
end 'conformanceListDeclares'

// ⭐ **WHAT A COMPILER-SYNTHESIZED *ERROR* ENUM DECLARES (A1s wave 2 review).** `implements Error` — the
// clause the declaration each seed stands in for actually writes, and the fact
// `ConformanceCheck.requireImplErrorConformsAndIsScalar` reads off the layout.
//
// ⚠⚠ **IT IS NOT DECORATION: WITHOUT IT THE SEEDS SAY THE OPPOSITE OF THEIR REFERENCE, AND A LEGAL PROGRAM
// IS REFUSED.** MEASURED — a `type V implements Parsable` whose `fromString` declares `throws ArrayError`
// (the error `arr.get` actually throws, which four committed cases already propagate) compiles and runs
// under the bootstrap and was refused here with `E3016: … throws 'ArrayError' which does not conform to
// Error`, because `builtinArrayErrorEnum` seeded an EMPTY conformance list while `stdlib/Array.maxon:6`
// declares `export enum ArrayError implements Error`. The bootstrap seeds the same fact explicitly
// (`2-Parser.cs:1371`, `conformingInterfaces: ["Error"]`) for the family it synthesizes.
//
// ⇒ A seed stands in for a DECLARATION and owes every clause that declaration writes, not just its cases.
// ⚠ **W3 REMOVED THE ONE SEED THAT GOT THIS RIGHT BY LUCK.** `Ordering` was seeded with the shared EMPTY
// list and was correct to — `stdlib/Interfaces.maxon:34` declares `export enum Ordering` with no clause at
// all — which is exactly the coincidence this paragraph warns about: a seed agrees with its declaration
// until the declaration changes. That enum is now READ rather than seeded, so its clause list is the
// corpus.s and cannot drift; the three below still owe this.
// ⚠ **`module` SINCE SV4**: `ServiceCompanions.buildServiceReplyErrorEnum` synthesizes an error enum too,
// and it owes `implements Error` for the reason this header gives — a `throws Calc.divide.errors` clause is
// checked by `ConformanceCheck.requireImplErrorConformsAndIsScalar` like any other.
module function builtinErrorConformance() returns ByteArrayArray
	var conformsTo = ByteArrayArray.create()
	conformsTo.push(ErrorInterfaceName)
	return conformsTo
end 'builtinErrorConformance'

// EnumLayout — one declared `enum`/`union`: what it is called, whether it is a `union` (the ONLY
// thing that separates the two — identical lowering, different diagnostic wording), and its cases
// IN DECLARATION ORDER.
//
// ⭐⭐ **THE PARALLEL-COLUMN SHAPE IS THE DERIVE-TIER FIX FOR OPEN #21** — the "one field with two
// meanings" hazard both reference compilers carry. The bootstrap's `IrEnumCase.Ordinal` is the
// auto-increment TAG counter that an explicit `= N` resets, and its range code once read it as a
// DECLARATION POSITION — a silent wrong answer (`ok = 500  notFound = 200` matched nothing). Here
// the case's DECLARATION INDEX is the array position (`indexOfCase`, derived, never stored) and the
// case's TAG is the `caseTags[i]` column. The two are SEPARATE BY CONSTRUCTION: no field can carry
// both, so a range arm reading the index against a tag-valued scrutinee — the exact bug — cannot be
// written. It is the enum twin of `StructLayout`'s field columns, and `addCase` is the SOLE writer
// for `StructLayout.addField`'s reason: a caller that pushed a name and forgot a tag would shift
// every later case's tag onto the wrong case.
//
// **TAGS ARE UNIFORMLY `ParsedInt` (i64), for int AND float backing.** An int-backed case's tag is
// its raw value; a FLOAT-backed case's tag is its IEEE-754 BIT PATTERN — the same representation
// `FieldDefault.literal` stores a float default as. An enum value is therefore always an i64 (the
// tag, or the float bits), living in a GENERAL-PURPOSE register and matched by an i64 compare, so a
// `match` needs no float register class and no second dispatch path. (`.rawValue` — the accessor that
// NAMES the decoded value — is a later rung.)
//
// ⚠⚠ **BUT A SITE THAT CONSUMES THE VALUE AS A *NUMBER* MUST DECODE IT, AND THE TAG COLUMN CANNOT TELL
// IT TO (A4o).** The uniform i64 is a representation decision, not a claim that a float-backed enum IS an
// integer: `"{w}"` printed `4612811918334230528` for `light = 2.5`, `Weight.light * scale` multiplied bit
// patterns, and `below < mid` ordered two NEGATIVE cases backwards, all silently. What decides is
// `backing` below, read at each such site and paid for with a `bitsToFloat` REINTERPRETATION — never a
// `cvtsi2sd`, which would convert the encoding as if it were a magnitude.
// See `Parser.floatBehindEnumValue` for the one door every one of those sites goes through.

// ⭐ **THE ENUM ACCESSOR shv2 READS — `s.ordinal`, a case's DECLARATION INDEX.** Spelled beside the
// layout because the layout is what answers it (`tagsAreDeclarationIndices`), and named rather than
// inlined at `Parser.enumAccessorFieldAt` so the member's spelling and the rule that decides it cannot
// come apart.
//
// ⚠ **ITS TWO INSTANCE SIBLINGS ARE `EnumNameMemberName` AND `EnumRawValueMemberName` BELOW, AND ALL THREE
// ARE NOW ONE MECHANISM.** The note that stood here called a name "a value that has to be materialized on
// the selected edge" and therefore a different mechanism from the tag→INDEX arithmetic. It is not: a case
// NAME is an IMMORTAL `.rdata` String, i.e. a machine word that is constant per case exactly as an index is,
// so the identical branchless `Σᵢ constantᵢ × (tag == tagᵢ)` selects it — see
// `Parser.emitEnumCaseConstantSelect`, which is the ONE emitter all three read through.
let EnumOrdinalMemberName = b"ordinal"

// ⭐ **`s.name` — THE CASE'S SPELLING, AS A `String`.** The constant selected is `EnumLayout.caseNames[i]`,
// materialized as the same immortal `.rdata` record a source literal of those bytes materializes, so it is
// never allocated, refcounted or dropped and may be returned out of the function that read it.
let EnumNameMemberName = b"name"

// ⭐ **`s.rawValue` — WHAT THE CASE WAS DECLARED AS, IN THE DOMAIN ITS BACKING NAMES.** The one accessor whose
// RESULT TYPE depends on `EnumLayout.backing`: an `int` for an integer (or unnumbered) backing, a `float` for
// a float one, a `Character` for a char one, a `String` for a string one. For the three backings whose tag IS
// the raw value (`tagCarriesRawValue`) the tag is the answer, decoded into that domain; for a string backing
// the tag is only a declaration index and the value rides `caseRawValues`, selected the same way `.name` is.
export let EnumRawValueMemberName = b"rawValue"

// ⭐⭐ **THE THREE MEMBERS AN ENUM *VALUE* CARRIES, AS A CLASSIFICATION RATHER THAN AS A LIST OF NAMES.**
// Two parties read it — the accessor door's cursor predicate (`Parser.enumAccessorFieldAt`, which only asks
// whether the member is one of them) and the accessor itself (`Parser.parseEnumAccessor`, which has to
// answer for each) — and they must not be able to disagree about the set.
//
// ⛔ **A PREDICATE PLUS AN `if` CHAIN CANNOT DELIVER THAT, AND THE FAILURE IS A RUNTIME PANIC.** Spelled as
// an `or` over three names beside a chain of three `if`s, a fourth member added to the predicate reaches the
// accessor's unreachable arm — a compiler PANIC in front of a user, at run time, for a member the predicate
// itself invited. As a union the accessor's `match` is exhaustive, so the fourth member cannot be admitted
// without the accessor refusing to COMPILE until it is answered. It is `CheckedDivisionKind`'s shape one
// directory over, and its header states the rule this borrows: *"a fourth kind cannot be named as throwing
// without the lowering refusing to compile."*
export union EnumInstanceAccessor
	// `.ordinal` — the case's DECLARATION INDEX.
	ordinal
	// `.name` — the case's SPELLING, as a `String`.
	caseName
	// `.rawValue` — what the case was declared as, in the domain its backing names.
	rawValue
	// The member names none of the three. The door declines it and `requireStructBase`'s refusal stands,
	// which is still the true answer for every other member of an enum.
	notAnAccessor
end 'EnumInstanceAccessor'

// THE classifier — the one place a member NAME becomes one of the three, so the door's cursor test and the
// accessor's dispatch read one answer.
export function enumInstanceAccessorOf(member ByteArray) returns EnumInstanceAccessor
	if member.equals(EnumOrdinalMemberName) 'ordinal'
		return EnumInstanceAccessor.ordinal
	end 'ordinal'
	if member.equals(EnumNameMemberName) 'caseName'
		return EnumInstanceAccessor.caseName
	end 'caseName'
	if member.equals(EnumRawValueMemberName) 'rawValue'
		return EnumInstanceAccessor.rawValue
	end 'rawValue'

	return EnumInstanceAccessor.notAnAccessor
end 'enumInstanceAccessorOf'

// ⭐ **DOES THIS CLASSIFICATION NAME AN ACCESSOR AT ALL?** — the DERIVED predicate the cursor door asks,
// spelled as an exhaustive `match` and never as `!= notAnAccessor`. It is `divisionKindThrows`' shape
// exactly (`Runtime/CheckedDivisionRuntime.maxon`), and for its reason as well as shv2's own: a union may
// not be compared with `==` (E3066), and — the part that matters — a member appended to
// `EnumInstanceAccessor` must be classified HERE too, so the door cannot silently start admitting one that
// `Parser.parseEnumAccessor` has not been taught to answer.
export function namesAnEnumInstanceAccessor(accessor EnumInstanceAccessor) returns bool
	match accessor 'a'
		ordinal then return true
		caseName then return true
		rawValue then return true
		notAnAccessor then return false
	end 'a'
end 'namesAnEnumInstanceAccessor'

// ⭐ **`<Enum>.allCases` — EVERY CASE, IN DECLARATION ORDER, AS AN `Array with <Enum>`.** The STATIC sibling
// of `allCaseNames` and deliberately its twin in shape: an ordinary array value of the type the language
// already has, built op-for-op like the source literal `[E.a, E.b]` — so `.count()`, `.get(0)` and
// `for c in …` reach it through the ordinary postfix and loop machinery with no accessor protocol of its own.
// See `Parser.emitEnumAllCases`.
export let EnumAllCasesMemberName = b"allCases"

// ⭐ **`<Enum>.fromRawValue(raw)` — THE REVERSE LOOKUP, AND THE ONE MEMBER OF THIS SURFACE THAT THROWS.**
// A raw value naming no case is a runtime failure, so unlike its four siblings it cannot be an expression
// the parser expands in place: shv2's `try` binds to a CALL (`Parser.rewriteLastCallToTryCall`), so this one
// is a per-enum Std helper the parser calls. See `Runtime/EnumLookupRuntime.maxon`.
export let EnumFromRawValueMemberName = b"fromRawValue"

// ⭐ **`<Enum>.fromName(name)` / `<Union>.fromName(name, payload…)` — THE LOOKUP BY CASE NAME, AND
// `fromRawValue`'s TWIN IN SHAPE BUT NOT IN SCOPE.** A name naming no case is a runtime failure, so like its
// sibling it is a per-declaration Std helper the parser CALLS rather than an expression the parser expands
// — shv2's `try` binds to a call (`Parser.rewriteLastCallToTryCall`). See `Runtime/EnumLookupRuntime.maxon`.
//
// ⭐⭐ **IT IS ON EVERY DECLARATION, WHERE `fromRawValue` IS ENUM-ONLY AND REACHES ONLY TWO OF THE SEVEN
// BACKINGS — and the asymmetry is not an inconsistency, it is what the two members ASK.** `fromRawValue`
// searches the case TAG column, which carries the declared raw values only for an `integer`-backed or
// unnumbered (`unresolved`) enum; the four in between (`float`, `character`, `string`, `functionRef`) are
// refused by name (E2015, `Parser.requireFromRawValueBacking`), `structRecord` is an absence rather than a
// refusal, and a union is never claimed at all. `fromName` searches the case NAME column, which EVERY
// declaration has in full, whatever its keyword and whatever its backing — and hands back
// `EnumLayout.tagOfIndex`, which IS a case's runtime representation for all seven. So there is no backing to
// refuse and no union to exclude.
// Both references agree (`maxon-sharp/Compiler/2-Parser.cs:19295` claims the member for either spelling;
// `maxon-selfhosted/Compiler/Parser.maxon:19919-19949` keeps `.fromName` for every scalar backing and for
// unions while `classifyEnumLookupForFromRawValue` strips the same declarations of the other member).
export let EnumFromNameMemberName = b"fromName"

// ⭐⭐ **`<Union>.unionCases` — THE COMPILER-SYNTHESIZED COMPANION ENUM OF A PAYLOAD-BEARING UNION**
// (`/specs/union-cases.md`). One bare case per variant of the union, in declaration order, rawValue = index:
// it exposes the union's DISCRIMINANT as a first-class enum value, so a decoder can write the variant's
// `rawValue` to a buffer and lift it back through `fromRawValue` — and adding a variant breaks the match in
// the writer AND the reader.
//
// ⚠ **IT IS SYNTHESIZED ONLY FOR A UNION WITH ASSOCIATED VALUES.** The gate is
// `appendUnionCasesCompanion`'s and so is its reason — stated there once, INCLUDING what the reason is not,
// because this sentence used to carry a false version of it and being the second copy is how it survived.
export let UnionCasesMemberName = b"unionCases"

// ⭐ **THE COMPANION'S REGISTERED NAME — `<Union>.unionCases`, the spelling the author writes.** A DOTTED
// name, which is what makes `function describe(k Shape.unionCases)` resolve with no new type grammar: the
// qualified arm of `Parser.parseTypeReference` already assembles a dotted chain into one `named(...)`, so
// the companion is found under exactly the key a type reference to it produces. It is v1's spelling
// (`maxon-selfhosted/Compiler/Parser.maxon:6145`) and is kept for that reason — the alternative, a reserved
// `__`-prefixed mint, would need a translation at every door the author's spelling arrives through.
export function unionCasesCompanionName(unionName ByteArray) returns ByteArray
	return "{String.from(unionName)}.{String.from(UnionCasesMemberName)}".toByteArray()
end 'unionCasesCompanionName'

// ⭐⭐ **THE TWO SYNTHESIZED SERVICE COMPANIONS' REGISTERED NAMES — `<T>.request` and `<T>.handle` (SV1).**
// DOTTED, on `unionCasesCompanionName`'s precedent and for its exact reason: `Parser.parseTypeReference`'s
// qualified arm already assembles a dotted chain into one `named(…)`, so `function serve(h Calc.handle)`
// resolves with no new type grammar and the companion is found under exactly the key a type reference to it
// produces. A reserved `__`-prefixed mint would need a translation at every door the author's spelling
// arrives through — and the author's spelling is the one the design document teaches.
let ServiceRequestMemberName = b"request"
let ServiceHandleMemberName = b"handle"

export function serviceRequestCompanionName(typeName ByteArray) returns ByteArray
	return "{String.from(typeName)}.{String.from(ServiceRequestMemberName)}".toByteArray()
end 'serviceRequestCompanionName'

export function serviceHandleCompanionName(typeName ByteArray) returns ByteArray
	return "{String.from(typeName)}.{String.from(ServiceHandleMemberName)}".toByteArray()
end 'serviceHandleCompanionName'

// The member half of the DISPATCH LOOP's symbol — `__`-prefixed for `ServiceShutdownCaseName`'s reason: no
// source may declare it (E2051) and no author may call it.
let ServiceLoopMemberName = b"__loop"

// ⭐⭐ **`<T>.__loop` — THE SYNTHESIZED DISPATCH LOOP'S SYMBOL, SPELLED ONCE FOR ITS THREE READERS (SV1 wave
// 3).** `ServiceLoop.installServiceLoops` BUILDS the function under this name,
// `LowerMaxonToStd.lowerServiceSpawn` emits the `funcAddr` that hands its address to `__svc_spawn`, and
// `DeadFunctionElimination` keeps it alive through exactly that edge. Three spellings would be three chances
// to build one symbol and root another — a link failure at best, and at worst a service whose loop is pruned.
//
// It is `qualifiedMethodName`'s shape, so it reads as what it is: a member of `<T>` the compiler wrote.
module function serviceLoopSymbol(typeName ByteArray) returns ByteArray
	return qualifiedMethodName(typeName, methodName: ServiceLoopMemberName)
end 'serviceLoopSymbol'

// The member half of the ABANDON function's symbol — `__`-prefixed for `ServiceLoopMemberName`'s reason.
let ServiceAbandonMemberName = b"__abandon"

// ⭐⭐ **`<T>.__abandon` — WHAT A REQUEST THAT WILL NEVER BE HANDLED GETS (SV2), SPELLED ONCE FOR ITS THREE
// READERS.** `ServiceLoop.buildServiceAbandon` BUILDS it, `LowerMaxonToStd.lowerServiceSpawn` emits the
// `funcAddr` that stores its address into the mailbox's `abandonFn`, and `ServiceLoop.buildServiceDrain`
// calls it by name on the way out.
//
// ⭐ **IT REPLACED A BARE `__destruct_<T>.request`, AND THE DIFFERENCE IS A LIVENESS OBLIGATION.** SV1 handed
// the mailbox the request union's own drop cascade, which frees an unhandled message's payloads and stops.
// A message that dies unprocessed now also has an AWAITER, and leaving it parked for a reply that will never
// come is a hang with no diagnostic — so the abandon path answers `ServiceError.stopped` into the reply slot
// FIRST and then drops the payloads through that same cascade.
module function serviceAbandonSymbol(typeName ByteArray) returns ByteArray
	return qualifiedMethodName(typeName, methodName: ServiceAbandonMemberName)
end 'serviceAbandonSymbol'

// ⭐⭐ **`__shutdown` IS VARIANT 0 OF EVERY REQUEST UNION, SO ADDING A MESSAGE NEVER RENUMBERS IT.** The
// poison pill is the one variant the RUNTIME will construct from a literal tag, and the roster above it is
// the author's to reorder; putting it last would move it every time a method was added. It wears the `__`
// prefix because no source may declare it (`requireUnreservedName`, E2051) and no `match` an author writes
// may name it.
export let ServiceShutdownCaseName = b"__shutdown"

// The variant INDEX that name occupies, which is what a reader that has a layout in hand actually needs.
// Derived from nothing and written here beside the rule that fixes it: `buildServiceRequestUnion` adds the
// pill FIRST, and `addServiceRequestCase` gives each case the index its position in the roster gives it.
export let ServiceShutdownCaseIndex = 0 as CaseIndex

// ⭐⭐ **THE REPLY SLOT IS AN `Integer`, DELIBERATELY, AND THE P1.3 CASCADE IS WHY.** It is a raw cell
// pointer, NOT a managed box: the `__destruct_<U>` payload cascade must SKIP it, and it does so structurally
// because a scalar payload is not managed. Answering an abandoned reply cell is `<T>.__abandon`'s job (SV2),
// not a decref's — and a managed-typed slot here would hand the cascade a box it must not free.
//
// ⚠ **A VARIANT EITHER HAS THIS SLOT OR DOES NOT, AND THERE IS NO `0` STANDING FOR "NO REPLY" (SV2).** SV1
// carried an `export let ServiceNoReplyCell = 0` and stored it into every reply slot, because its send could
// mint no cell; since a send does, the presence of the slot IS the question and
// `ServiceCompanions.serviceReplySlotIndex` is the one place it is asked. A zero left as a second spelling
// of the same fact would be a sentinel every reader had to remember not to dereference.
module let ServiceReplySlotName = b"__reply"

// ⭐ **THE TRANSPORT HALF OF EVERY REPLY'S ERROR TYPE, AS A NAME (SV2).** `stdlib/Builtins.maxon` declares
// `public enum ServiceError`, and the compiler has to look that declaration up to place its cases on a
// reply's fused dispatch line — so the spelling is here, once, rather than as a byte literal at each of the
// three sites that ask (`ServiceCompanions.serviceReplyTransportPlacement`,
// `Parser.serviceReplyErrorMembers` and `ProgramSignatures.serviceReplyErrorName`).
module let ServiceErrorTypeName = b"ServiceError"

// ⭐ **THE ONE CASE OF `ServiceError`, AS A NAME.** `<T>.__abandon` transcribes its ORDINAL into a reply's
// error word, which makes the case ORDER a wire format — so the transcription is checked against the
// declaration on every compile (`BuiltinErrorOrdinalCheck`), exactly as the three `__Managed*Error`
// families' are, and this constant is what names the case at both ends of that check.
module let ServiceErrorStoppedCaseName = b"stopped"

// ⭐ **THE MEMBER HALF OF A TWO-MEMBER REPLY ERROR TYPE'S NAME (SV2)** — `Calc.divide.errors`,
// `SERVICES_DESIGN.md`'s own spelling.
//
// ⛔ **IT USED TO BE A DIAGNOSTIC STRING AND NOTHING ELSE, AND IT IS A REGISTERED TYPE NOW (SV4).** This
// header read *"no registry holds it, nothing resolves it, and that is exactly what makes a bare `try` over
// such a reply E3059 — there is no `throws` clause an author could write that names it."* All three clauses
// are false: `ServiceCompanions.synthesizeServiceCompanions`' third pass mints a nominal enum under this
// name for every THROWING message and registers it through the same `recordEnum` door every author-written
// enum takes, so `function fetch(…) throws Calc.divide.errors` resolves and
// `Promise with (Integer, Calc.divide.errors)` interns. E3059 is still what a bare `try` earns when the
// enclosing clause names the HANDLER half alone — a name mismatch, which is a different sentence for a
// different mistake.
let ServiceReplyErrorSuffix = b"errors"

// ⭐ **THE FUSED REPLY ERROR TYPE'S REGISTERED NAME — `<Service>.<method>.errors`.** DOTTED for
// `serviceRequestCompanionName`'s reason and by the same construction: `Parser.parseTypeReference`'s
// qualified arm and `Parser.parseOptionalThrowsClause` both assemble a dotted chain into one name, so the
// enum is found under exactly the key a `throws Calc.divide.errors` clause produces.
//
// ⚠ **ITS ARGUMENT IS THE MESSAGE KEY (`<Service>.<method>`), not a service name** — the fused pair is a
// property of ONE message, because what it fuses is `ServiceError` with what THAT message declares.
export function serviceReplyErrorsCompanionName(messageKey ByteArray) returns ByteArray
	return "{String.from(messageKey)}.{String.from(ServiceReplyErrorSuffix)}".toByteArray()
end 'serviceReplyErrorsCompanionName'

// The one field of `<T>.handle`: the mailbox pointer. A real 8-byte box on `managedFileLayout`'s shape
// rather than a parse-time mark, so moves, E3102, struct fields, arrays and the drop cascade all reach it
// by construction rather than through a special case at each door.
module let ServiceHandleMailboxFieldName = b"mailbox"

// Its FIELD INDEX, for the one reader that loads it through a `StructLayout` rather than at a raw offset
// (`Parser.emitServiceSendOp`). `buildServiceHandleStruct` adds exactly this one field, and the audit there
// is what keeps the index and `ServiceHandleMailboxOffset` two spellings of one geometry.
export let ServiceHandleMailboxFieldIndex = 0 as FieldIndex

// ⭐⭐ **THE HANDLE BOX'S GEOMETRY AS A NUMBER, FOR THE ONE READER THAT HAS NO LAYOUT — the RUNTIME.**
// `__mbox_handle_clone_box` mints a fresh handle box and `__mbox_handle_drop_box` reads the mailbox out of
// one, and neither can ask `StructLayout` anything: they are Std-tier bodies built after the pipeline. The
// pair is AUDITED against the layout at the one place that builds it
// (`ServiceCompanions.buildServiceHandleStruct`), so a field added to the handle fails the compile rather
// than making the runtime read past the record's end.
// ⭐⭐ **`shutdown` IS THE HANDLE'S OWN METHOD, NOT A MESSAGE — AND IT YIELDS TO ONE OF THAT NAME.** It
// enqueues the `__shutdown` pill BEHIND everything already queued, which is what makes a shutdown a graceful
// drain rather than a kill. It follows `clone`'s precedent exactly (`Parser.structCloneIsSynthesized`): a
// service that declares an `export function shutdown()` of its own WINS, because that declaration is a
// VARIANT of the request union and the dispatch looks for a variant first — which leaves dropping the last
// handle as the other road to the same drain.
//
// ⚠ It is the AUTHOR-SPELLABLE name; `ServiceShutdownCaseName` above is the compiler's `__`-prefixed
// VARIANT, which no source may declare and no author may name.
export let ServiceShutdownMethodName = b"shutdown"

export let ServiceHandleMailboxOffset = 0 as ByteOffset
export let ServiceHandleBoxSize = 8 as ParsedInt

// ⭐⭐ **SYNTHESIZE `<Union>.unionCases` BESIDE THE UNION THAT WAS JUST READ** (`/specs/union-cases.md`).
// One bare case per variant, in declaration order, tag = index — which makes it an ordinary payload-free
// enum in every respect, and that is the whole design: it is APPENDED TO THE SAME `EnumLayoutArray` the
// union itself goes into, so `Shape.unionCases.circle`, `match k`, `.allCases`, `.fromRawValue`, `.name`,
// `.rawValue` and `.ordinal` all reach it through the doors an author-written enum reaches them through.
// Nothing about the companion is special-cased past this function and `Parser.unionCasesCompanionOf`'s hop.
//
// ⭐ **IT IS BORN AT THE DECLARATION AND NOT AT FIRST USE — A DIVERGENCE FROM THE BOOTSTRAP AND AN AGREEMENT
// WITH v1.** The bootstrap materializes the companion lazily on the first `.unionCases` it parses
// (`maxon-sharp/Compiler/2-Parser.cs:19113`); v1 registers it eagerly at the declaration
// (`maxon-selfhosted/Compiler/Parser.maxon:6134`). shv2 must do the latter, and for a reason neither of them
// has: its whole-program index is built by a TOLERANT DECLARATION SWEEP that runs before any body is parsed,
// and a type named in a PARAMETER position (`function describe(k Shape.unionCases)`) has to be resolvable
// from that index. A lazily-minted companion would exist only in files that had already parsed a use of it.
//
// ⭐ **TWO CALLERS, TWO REGISTRIES, ONE FUNCTION — and both are required.** The sweep's array feeds
// `ProgramSignatures.enumTypes` (what the PARSER resolves `Shape.unionCases.circle` and `match k` through);
// the real parse's `FileParseArtifact.enumTypes` feeds `Project.enumTypes` (what `TypeResolution` erases the
// named type through, what `SemanticCheck`'s argument identity reads, and what the Std installer walks).
// ⛔ MEASURED with only the first: `describe(c)` was refused *"expected 'Shape.unionCases', got 'int'"* —
// the argument's own aggregate name came back empty — and `__enum_from_raw_Shape.unionCases` was never
// synthesized, taking the x64 backend down at `resolveCallFixups`.
//
// ⚠ **ONLY FOR A UNION WITH ASSOCIATED VALUES.** `isBoxed` is that question — a union is boxed exactly when
// some case declares a payload. The gate lives HERE rather than at either caller, so the two cannot come to
// disagree about which unions have one, and `UnionCasesMemberName`'s note points at this paragraph instead of
// keeping a second copy of it.
//
// ⛔⛔ **THE REASON IS NOT THAT A PAYLOAD-FREE UNION ALREADY HAS THIS SURFACE — IT HAS NEITHER HALF OF IT.**
// This comment said so twice and credited the spec both times. `/specs/union-cases.md` says *"Plain ENUMS (no
// payloads) already expose `.allCases` / `.fromRawValue` directly"*; the widening from "enum" to "enum or
// union" was this comment's own, and it is false for a union of ANY shape, because both refusals key on the
// declaration keyword rather than on payloads (`Parser.parseEnumLiteral`). MEASURED on `union Level low = 1
// high = 2 end`, a payload-free scalar-backed union: `.allCases` is **E4006** *allCases is not available on
// unions* (shv2 and the bootstrap, byte-identical) and `.fromRawValue` is **E3034** *unknown union case*.
// `specs-shv2/union-scalar-backing.md:17-19` states that rule for unions outright — the helpers *"remain an
// `enum`-only surface"*.
//
// ⇒ **What the exclusion is actually about is what a companion would be FOR.** Its purpose is to expose a
// union's DISCRIMINANT as a first-class enum value (see `UnionCasesMemberName`), and a payload-free union's
// cases ARE first-class values carrying their own tag already — so there is nothing for a second type to
// name, while a BOXED union's discriminant is reachable no other way.
// ⇒ ⚠ **A payload-free union therefore has no route to `.allCases` at all**, and that is the language's rule
// as BOTH references implement it, not a consequence of this gate. Do not "restore" a direct route here (the
// refusal is `parseEnumLiteral`'s and deliberate) and do not delete the gate to grant one.
//
// ⚠ It must be called with the layout AFTER every case is read, because the companion's case list IS the
// union's.
export function appendUnionCasesCompanion(enums EnumLayoutArray, layout EnumLayout)
	if not layout.isBoxed() 'noAssociatedValues'
		return
	end 'noAssociatedValues'

	enums.push(buildUnionCasesCompanion(layout))
end 'appendUnionCasesCompanion'

// ⭐ **THE COMPANION ITSELF, SPLIT FROM THE APPENDER FOR ITS SECOND REGISTRAR (SV1 wave 3).** A SERVICE's
// request union is registered through `ProgramSignatures.recordServiceRequest` rather than pushed onto an
// array, and it owes its `unionCases` companion exactly as an author's union does —
// `services.unioncases-tags-the-request-variants` reads `Calc.request.unionCases.bump.rawValue`. Two builders
// would be two answers to "what tag does a variant carry", which is the drift the header below is entirely
// about.
export function buildUnionCasesCompanion(layout EnumLayout) returns EnumLayout
	// ⛔⛔ **THE COMPANION'S TAG IS THE UNION'S TAG, READ THROUGH `tagOfIndex` — NEVER THE LOOP INDEX.** It was
	// written `tag: i, rawValue: "{i}"`, and that was true only while a boxed union could not declare raw
	// values: every tag WAS its declaration index, so the index was the union's tag spelled differently. The
	// day `Parser.readEnumCaseInto` began reading a payload list and a raw value as independent halves
	// (`/specs/union-struct-backing.md` needs both on one case), `union Instr add(dest ID, src ID) = 5 nop = 7
	// end` became expressible and the two numbers came apart.
	//
	// ⛔ **MEASURED, and it BREAKS THE COMPANION'S STATED PURPOSE** — `/specs/union-cases.md`: *"write the
	// variant's `rawValue` to a buffer …; on read, lift the raw `int` back to a `U.unionCases` via
	// `fromRawValue`"*. On that union, `op.rawValue` answered **5** while `Instr.unionCases.add.rawValue`
	// answered **0**, so `fromRawValue(op.rawValue)` THREW. Both halves are separately pinned by the corpus and
	// nothing COMPOSED them, which is why a full green suite said nothing. ⚠ The C# bootstrap has the identical
	// defect (byte-identical output, same throw), so the oracle does not adjudicate this one — v1 does, and it
	// anticipated exactly this: *"Mirror the parent case's ordinal so `.rawValue` agrees with the union's tag
	// value (the natural pairing for de/serialization)"* (`registerUnionCasesCompanion`).
	//
	// ⇒ **BYTE-NEUTRAL FOR EVERY DECLARATION THAT COULD EXIST BEFORE**, whose tags were `0..n-1` — which is
	// what makes this a latent bug being closed rather than a behaviour change.
	//
	// ⭐⭐ **AND THE BACKING MUST TRAVEL WITH THE TAG, BUT ONLY WHERE THE TAG *IS* THE RAW VALUE.** Copying
	// `layout.backing` unconditionally is WRONG and the classifier says why: a `string` or `functionRef`
	// backing keeps its value in `caseRawValues`, a column the companion does not carry, so a string-backed
	// companion would answer `.rawValue` with the TEXT OF ITS TAG (`"0"`) instead of `"alpha"`. `structRecord`
	// has no single-word raw value at all. For those three the tag is only a declaration index — which is an
	// integer, and that is why `integer` is the right answer there rather than a fallback.
	//
	// ⛔ **KEEPING `integer` FOR ALL SIX IS EQUALLY WRONG, AND ALSO NEWLY REACHABLE.** MEASURED on this tree
	// before the fix: `union F a(x ID) = 1.5 b = 2.5 end` gave `v.rawValue` **1.5** and the companion **0**,
	// and a character-backed one gave `'p'` against **0**. Copying the tag into an `integer` companion would
	// have turned those into an IEEE bit pattern printed as an integer and a bare codepoint — a WRONG ANSWER
	// rather than a refusal. `rawValueIdentity` is the exhaustive classifier that already owns this question,
	// so a backing added to `EnumBacking` cannot slip through unclassified.
	let mirrorsTheUnionsBacking = layout.rawValueIdentity() == EnumRawValueIdentity.theTag

	// It carries the UNION's own visibility and declaring file, not `global`/compiler-owned: the companion is
	// nameable exactly where the union is, so a `module union` does not leak its discriminant type across files.
	var companion = EnumLayout.create(unionCasesCompanionName(layout.name), isUnion: false, conformsTo: sharedEmptyDeclaredConformances, visibility: layout.visibility, declFilePath: layout.declFilePath, backing: layout.backing if mirrorsTheUnionsBacking else EnumBacking.integer)

	for i in 0 upto layout.caseCount() 'eachVariant'
		let tag = layout.tagOfIndex(i)
		// ⭐ The companion DECLARES a raw value exactly where the union did and its tag carries it — which is
		// `mirrorsTheUnionsBacking`'s own condition, so the two travel together for the reason that flag's
		// paragraph gives. Where the tag is only a declaration index the companion states nothing the source
		// wrote, and `Companion.<case>` interpolates as its case NAME, as the union's does.
		companion.addCase(layout.caseNameAt(i), tag: tag, rawValue: "{tag}", declaresRawValue: mirrorsTheUnionsBacking and layout.declaresRawValues, payloads: PayloadFieldArray.create(), backingFields: sharedEmptyEnumBackingFields)
	end 'eachVariant'

	return companion
end 'buildUnionCasesCompanion'

// ⭐ **`<Enum>.allCaseNames` — THE CASE NAMES, IN DECLARATION ORDER, AS AN `Array with String`.** A STATIC
// member of every enum AND every union, payload-bearing ones included: only the NAMES are returned, so a
// case's backing and its payload list are equally irrelevant to it (`/specs/enum-allcasenames.md`).
//
// Spelled beside `EnumOrdinalMemberName` because `EnumLayout.caseNames` is what answers both, and the member
// is materialized from that column alone — see `Parser.emitEnumAllCaseNames`.
export let EnumAllCaseNamesMemberName = b"allCaseNames"

// ⭐⭐ **WHICH KIND OF NUMBER AN ENUM'S i64 TAG *IS*** — the fact `caseTags` structurally cannot carry,
// because both backings store a `ParsedInt` and one bit pattern says nothing about how to read it.
// `enum Z  z = 0` and `enum Z  z = 0.0` produce the IDENTICAL tag column (`floatLiteralBits(0.0)` is 0),
// and every read site — the interpolation renderer, an arithmetic operand, a comparison's domain — must
// answer them differently. So the backing rides the LAYOUT, which is what survives the declaration.
//
// ⚠ `unresolved` is a real state and not a filler: the backing is fixed by the FIRST case, so an enum
// with no cases yet has none, and that is exactly what E3032 (raw-value type mismatch) tests against.
//
// ⭐ **`string` IS THE ONE BACKING WHOSE TAG IS NOT ITS RAW VALUE.** A character raw value IS a number —
// its Unicode codepoint — so `character` tags like `integer` does and every tag-keyed rule (the
// duplicate-raw-value scan, `.ordinal`, a `match`'s i64 compare) reads it unchanged. A STRING raw value is
// not a number at all, so a string-backed case takes the auto-increment DECLARATION INDEX as its tag and
// its raw value rides `caseRawValues` instead.
//
// ⚠ **THE ORDER IS LOAD-BEARING: the three tag-carrying backings are ADJACENT** so
// `EnumLayout.tagCarriesRawValue` can classify them with one range arm rather than two arms giving one
// answer. A backing added later belongs beside the group it joins, and it must be added to BOTH exhaustive
// matches over this enum (here via that predicate, and `enumBackingDiscriminator`).
//
// ⛔ **APPEND IT, OR PUT IT BEFORE `integer` — DO NOT INSERT ONE INSIDE EITHER RUN.**
// `enumBackingDiscriminator` names every arm and so cannot build without the new one; `tagCarriesRawValue`
// spells BOTH groups as RANGES (`integer to character` true, `string to function` false), and a range is
// the one arm shape that can absorb a member silently. At either END of this enum it stops building, which
// is what is wanted. Inserted mid-run it compiles and answers whichever group swallowed it for a backing
// nobody classified, which is a wrong answer (a duplicate-raw-value scan comparing declaration indices)
// rather than the compile error the `match` is here to force.
//
// ⭐ **`functionRef` JOINS `string` ON THE "the tag is only an index" SIDE**, and is appended past it for
// that reason: a case backed by a function REFERENCE (`doubleOp = doubleFn`) has no number to be a tag, so
// it takes the auto-increment declaration index and the function's NAME rides `caseRawValues` exactly as a
// string raw value does. The address itself is materialized per case at the read
// (`Parser.emitEnumCaseConstant`), which is the one thing a declaration cannot carry.
//
// ⚠ It is spelled `functionRef` and not `function` because `function` is a keyword: an arm of that name
// would have to be written in every `match` over this enum in a position the grammar reads as a
// declaration. The word a DIAGNOSTIC uses is still "function" — see `enumBackingNoun`, which is the one
// place the spelling a reader sees is decided.
// ⭐ **`structRecord` JOINS `string` AND `functionRef` ON THE "the tag is only an index" SIDE**, and is
// APPENDED past them for the reason the ⛔ paragraph above gives: appending it leaves it outside BOTH of
// `rawValueIdentity`'s ranges, so that classifier stops building until this backing is answered there.
// (Inserted between `string` and `functionRef` it would have been swallowed by a range and answered
// `recordedText` — a wrong answer, since a struct-backed case records no text at all.)
//
// A case backed by a compile-time constant STRUCT (`add = Meta{value: 1}`, `add = Meta.create(1)`) has no
// number to be a tag, so it takes the auto-increment declaration index; the per-field constants ride
// `EnumLayout.caseBackingFields` and the struct's own name rides `EnumLayout.backingStructName`.
export enum EnumBacking
	unresolved
	integer
	float
	character
	string
	functionRef
	structRecord
end 'EnumBacking'

// The word a diagnostic calls each backing — the bootstrap's spelling, which `E3032`'s
// `expected <established>, got <incoming>` is pinned to by `specs-shv2/enum-full.md`'s two
// `error.raw-value-type-mismatch` / `error.mixed-backing-types` cases.
//
// `unresolved` names no backing and can reach no message: the mismatch is raised only where an
// ESTABLISHED backing disagrees with an incoming one, and `unresolved` is by definition neither.
//
// ⭐⭐ **ONE BACKING'S NOUN IS NOT A FIXED WORD — A STRUCT BACKING IS CALLED BY THE STRUCT TYPE'S OWN NAME**,
// which is why this takes a second argument that five of its six answering arms never read. The pin is
// `specs-shv2/enum-struct-backing.md`'s `error.struct-backing-mixed` — *"expected Meta, got int"* — and both
// references render it from the type-name TOKEN the case wrote (`maxon-selfhosted/Compiler/Parser.maxon:5505`
// spells the same sentence at seven sites; here there is one).
//
// ⚠ `structName` is `EmptySourceText` for every backing that names no struct — the "there is no name here"
// spelling this file already uses for an absent argument label (`Parser.consumeConstArgumentLabel`). The
// `structRecord` arm PANICS on it rather than printing an empty noun, so the one arm that must be handed a
// name cannot be handed nothing quietly.
export function enumBackingNoun(backing EnumBacking, structName ByteArray) returns String
	match backing 'backing'
		integer then return "int"
		float then return "float"
		character then return "char"
		string then return "String"
		// The word the REFERENCE uses for this backing in exactly this sentence
		// (`maxon-selfhosted/Compiler/Parser.maxon:5544` — *"expected int, got function"*), which is why the
		// noun and the arm's own spelling differ; see `EnumBacking.functionRef`.
		functionRef then return "function"
		structRecord then break 'backing'
		unresolved then panic("enumBackingNoun: `unresolved` names no backing — it is the state an enum with no cases yet is in, and `Parser.requireEnumBacking` never reports it as either side of a mismatch")
	end 'backing'

	if structName.isEmpty() 'noStructName'
		panic("enumBackingNoun: a `structRecord` backing is called by its struct type's NAME and none was supplied — every producer of this backing reads the name off the type token the case wrote (`Parser.appendStructBackedEnumCase`), so there is no route to this backing without one")
	end 'noStructName'

	return String.from(structName)
end 'enumBackingNoun'

// ⭐⭐ **WHAT MAKES TWO CASES' RAW VALUES THE SAME VALUE — the THREE-WAY answer that replaced a bool.** Two
// readers with nothing else in common ask it: E3031's collision test (`EnumLayout.rawValueCollidesAt`) and
// the decl-shape content hash (`ProgramSignatures.mixEnumCase`), and both must be exhaustive over it.
//
// ⛔ **IT WAS `tagCarriesRawValue`, A BOOL, AND A THIRD ANSWER DOES NOT FIT IN ONE.** A struct backing
// records no comparable raw value at all, which is neither of the two the bool could say — and either
// answer is a WRONG ANSWER rather than a compile error. `theTag` would compare declaration indices (never
// equal, so E3031 could never fire for anything) and `recordedText` would compare an empty column and
// report EVERY second struct-backed case as a duplicate.
export enum EnumRawValueIdentity
	// `integer` / `float` / `character` — the raw value IS a number, so `caseTags[i]` is it. `1.1` and `1.10`
	// are one float whatever the source text wrote, which is exactly what a tag compare gets right.
	theTag
	// `string` / `functionRef` — the tag is only a declaration index and the value rides `caseRawValues`
	// (the declared text, or the backing function's name). Compared BYTEWISE, which is what refuses
	// `a = "x"  b = "x"` and `a = f  b = f`.
	recordedText
	// ⭐ `structRecord` — **THERE IS NO COMPARISON, AND THAT IS THE LANGUAGE'S RULE RATHER THAN A GAP.** Two
	// cases may carry equal struct backings: `specs-shv2/enum-struct-backing.md`'s `struct-backing-match`
	// declares `add = Meta.create(1)` and `sub = Meta.create(1)` and pins an exit code, so both references
	// compile it. The IDENTITY of such a case is its name and its ordinal; the field constants are metadata.
	incomparable
end 'EnumRawValueIdentity'

export type EnumLayout
	export var name as ByteArray
	// `union U` vs `enum E`. The lowering is identical; this bit only chooses the word a diagnostic
	// prints ("union" vs "enum"), which is exactly what `/specs` says separates the two for a
	// payload-free union.
	export var isUnion as bool
	// Parallel arrays, in DECLARATION order: case `i` is named `caseNames[i]`, carries tag
	// `caseTags[i]` and declares payload fields `casePayloads[i]` (empty for a payload-free case).
	// NEVER appended to directly — `addCase` is the one writer (see the header).
	export var caseNames as ByteArrayArray
	export var caseTags as ParsedIntArray
	// ⭐ **HOW EACH CASE's RAW VALUE WAS WRITTEN** — `"200"`, `"1.1"`, `"application/json"`, `"n"` — the
	// fact `caseTags` structurally cannot carry for a STRING backing, where the tag is only a declaration
	// index. Read by the E3031 duplicate-raw-value scan, which compares tags for the three NUMERIC backings
	// (`1.1` and `1.10` are one float whatever the source text) and these bytes for a string backing.
	export var caseRawValues as StringArray
	// Per-case payload fields (P1.3 slice 1). `casePayloads[i][j]` is case `i`'s slot-`j` field; its
	// byte offset in the box is `UnionTagBytes + j * FieldSlotBytes`. Empty for `red`/`stay`; the
	// box is allocated iff SOME case carries a payload (`isBoxed`), and all cases of a boxed union —
	// payload-free ones included — take the boxed form (a bare tag in a box).
	export var casePayloads as PayloadFieldArrayArray
	// ⭐ **THE INTERFACES THIS ENUM/UNION DECLARES `implements` (A1s wave 2).** Until now the clause was
	// CONSUMED AND DISCARDED — `skipOptionalImplementsClause`'s own comment called the payload-free-enum
	// conforms-to-`Error` check "a follow-up" — so the compiler had no record that `enum ParseError
	// implements Error` says anything. It is the fact the abstract-`throws` narrowing needs
	// (`ConformanceCheck.requireImplErrorConformsAndIsScalar`): without it, `throws Error` narrowed to ANY
	// enum, including one that declares no conformance at all, which the bootstrap refuses with E3016.
	//
	// ⚠ It is NOT a `ConformanceDecl`, and that asymmetry with `type X implements I` is deliberate: a
	// ConformanceDecl drives `checkConformance`'s METHOD checking, and an enum has no methods to check
	// against a requirement. What is recorded here is the DECLARATION only — the nominal fact a narrowing
	// asks for — which is exactly what the clause means for an error enum.
	export var conformsTo as ByteArrayArray
	// ⭐ **THE DECLARATION'S OWN VISIBILITY (N1a)** — `enum Color` vs `module enum Color` vs
	// `export enum Color`, with `declFilePath` the anchor both wider tiers measure a reader against. The
	// `StructLayout` twin in every respect, including `global` + an empty path for the compiler-owned
	// layouts (`Ordering`, the builtin error enums), which no file declares and none may be refused.
	export var visibility as Visibility
	export var declFilePath as FilePath
	// ⭐ **WHAT KIND OF NUMBER `caseTags` HOLDS** (see `EnumBacking`). Written by the case reader as each
	// case fixes or re-confirms it (`Parser.requireIntBacking`/`requireFloatBacking`, which raise E3032 on a
	// mismatch), and read at every site that consumes an enum VALUE as a number rather than as an identity.
	export var backing as EnumBacking
	// ⭐ **THE STRUCT TYPE A `structRecord` BACKING NAMES** — `Meta` out of `add = Meta{value: 1}`. It is
	// `EmptySourceText` for every other backing, and the FIRST struct-backed case fixes it exactly as that
	// case fixes `backing`; a later case naming a DIFFERENT struct is the E3032 mismatch
	// (`Parser.requireEnumBacking` compares both halves in one place).
	//
	// It is a name and not a `StructLayout`, for `caseBackingFields`' reason: the case reader runs inside the
	// sweep that is still building the index this name would be resolved through.
	// ⭐⭐ **DID ANY CASE OF THIS DECLARATION *WRITE* A RAW VALUE? — the fact `backing` cannot carry, and the
	// one string interpolation turns on (W81).** `enum Colour red green` and `enum Colour red = 0 green = 1`
	// produce the IDENTICAL `backing` (`integer`, fixed by `Parser.appendAutoTaggedEnumCase`'s first
	// statement), the identical `caseTags` and the identical `caseRawValues` (an auto-tagged case records
	// `"{tag}"`) — and the language renders the first as `green` and the second as `1`
	// (`/specs/string-interpolation.md:89`). So there is no projection of the columns above that tells them
	// apart, and this is the missing bit rather than a convenience.
	//
	// ⭐ **PER DECLARATION, NOT PER CASE, AND THAT IS THE LANGUAGE'S RULE.** MEASURED against the bootstrap
	// oracle on `enum Mixed  a = 5  b end`: `"{Mixed.b}"` renders **6** — the auto-CONTINUED raw value — and
	// not the name `b`. One `=` anywhere makes every case of that enum render as a number, which is exactly
	// what the reference's own single `HasExplicitBackingValues` flag says (`MlirType.cs:663`, read at
	// `MaxonToStandardConversion.Strings.cs:900`).
	//
	// ⚠ It is OR-ed in by `addCase` rather than assigned, for `backing`'s reason one field up: the case
	// reader fixes it from whichever case first states it and no later case may unstate it.
	export var declaresRawValues as bool
	export var backingStructName as ByteArray
	// ⭐ **PER CASE, THE BACKING STRUCT'S FIELDS AS THE DECLARATION WROTE THEM** — in the order written, which
	// for a positional factory argument IS the field's position (see `EnumBackingField.name`).
	// `sharedEmptyEnumBackingFields` for every case of every other backing.
	//
	// ⚠ **PARALLEL TO THE FOUR COLUMNS ABOVE AND WRITTEN ONLY BY `addCase`**, for their stated reason: a
	// caller that pushed a name and forgot this would shift every later case's backing onto the wrong case.
	export var caseBackingFields as EnumBackingFieldArrayArray

	export static function create(name ByteArray, isUnion bool, conformsTo ByteArrayArray, visibility Visibility, declFilePath FilePath, backing EnumBacking) returns EnumLayout
		return Self{name: name, isUnion: isUnion, caseNames: ByteArrayArray.create(), caseTags: ParsedIntArray.create(), caseRawValues: StringArray.create(), casePayloads: PayloadFieldArrayArray.create(), conformsTo: conformsTo, visibility: visibility, declFilePath: declFilePath, backing: backing, declaresRawValues: false, backingStructName: EmptySourceText, caseBackingFields: EnumBackingFieldArrayArray.create()}
	end 'create'

	// The `EnumLayout` twin of `StructLayout.createCompilerOwned`, for the same reason and with the same
	// tier: a builtin enum is declared in no file, so no file may be refused it.
	//
	// ⚠ It states `integer` rather than `unresolved`, because a builtin's cases are appended through
	// `addBuiltinEnumCase` — which bypasses the case READER that would otherwise fix the backing — and every
	// one of them is a declaration-index tag. An `unresolved` builtin would be a layout whose tag column
	// exists and whose reading rule does not.
	export static function createCompilerOwned(name ByteArray, conformsTo ByteArrayArray) returns EnumLayout
		return EnumLayout.create(name, isUnion: false, conformsTo: conformsTo, visibility: Visibility.global, declFilePath: CompilerOwnedDeclFilePath, backing: EnumBacking.integer)
	end 'createCompilerOwned'

	// ⭐ **REPLACE THE `implements` LIST WITH THE WHOLE-PROGRAM RE-READ'S (W95)** — `StructLayout`'s twin, and
	// it takes NO bindings for the reason `conformsTo` above already states: an enum has no conditional
	// extension whose `where` clause a binding would be evaluated against, so the clause's arguments are read
	// (a `with` still ends an interface name) and dropped. Wholesale, because the clause is read as a unit.
	export function recordConformances(names ByteArrayArray)
		self.conformsTo = names
	end 'recordConformances'

	// Append one declared case. THE one writer of all FIVE columns, so they cannot drift — a caller
	// that pushed a name and forgot the payloads would shift every later case's payloads onto the
	// wrong case. A payload-free case passes an empty array, and every case that is not backed by a
	// constant struct passes `sharedEmptyEnumBackingFields`.
	//
	// ⚠ Both empties are spelled at the call site rather than defaulted, so the sentence above stays
	// literally true: there is no argument this writer can supply on a caller's behalf.
	//
	// ⭐ `declaresRawValue` — did THIS case write one? It is folded into the declaration-wide
	// `declaresRawValues` here rather than set by the case readers, so the one writer of the columns is also
	// the one writer of the fact derived from them and a reader that appends a case cannot forget it.
	export function addCase(caseName ByteArray, tag ParsedInt, rawValue String, declaresRawValue bool, payloads PayloadFieldArray, backingFields EnumBackingFieldArray)
		self.caseNames.push(caseName)
		self.caseTags.push(tag)
		self.caseRawValues.push(rawValue)
		self.casePayloads.push(payloads)
		self.caseBackingFields.push(backingFields)
		self.declaresRawValues = self.declaresRawValues or declaresRawValue
	end 'addCase'

	// The constant struct backing case `index` declares, field by field in the order written — empty for
	// every case of every other backing (see `caseBackingFields`).
	export function backingFieldsAt(index CaseIndex) returns EnumBackingFieldArray
		return try self.caseBackingFields.get(index) otherwise panic("EnumLayout.backingFieldsAt: caseBackingFields.get OOB at {index} for `{self.kindWord()} {String.from(self.name)}`, which declares {self.caseCount()} cases")
	end 'backingFieldsAt'

	// ⭐ **REPLACE CASE `index`'s PAYLOAD SLOTS — `StructLayout.retypeField`'s twin (N3)**, for the same one
	// caller and the same one reason: a payload declared with a generic alias two files declare differently
	// cannot be resolved until every file has folded. Whole-array, where the struct side sets one cell,
	// because a `PayloadField`'s columns are `let`.
	export function retypeCasePayloads(index CaseIndex, payloads PayloadFieldArray)
		try self.casePayloads.set(index, value: payloads) otherwise panic("EnumLayout.retypeCasePayloads: casePayloads.set OOB at {index} for `{self.kindWord()} {String.from(self.name)}`, which declares {self.caseCount()} cases")
	end 'retypeCasePayloads'

	// The payload fields of case `index`, in slot order — empty for a payload-free case.
	export function payloadsAt(index CaseIndex) returns PayloadFieldArray
		return try self.casePayloads.get(index) otherwise panic("EnumLayout.payloadsAt: casePayloads.get OOB at {index} for `{self.kindWord()} {String.from(self.name)}`, which declares {self.caseCount()} cases")
	end 'payloadsAt'

	// The number of payload slots case `index` declares.
	export function payloadArityAt(index CaseIndex) returns CaseIndex
		return self.payloadsAt(index).count()
	end 'payloadArityAt'

	// The union-wide MAX payload arity — the number of payload slots the box reserves, so every case
	// (narrow ones included) shares one allocation size. This is what makes the box's layout a
	// function of the WIDEST case, and it is what a narrow case's zero-fill fills up to.
	export function maxPayloadArity() returns CaseIndex
		var widest = 0 as CaseIndex
		for i in 0 upto self.caseCount() 'each'
			let arity = self.payloadArityAt(i)
			if arity > widest 'wider'
				widest = arity
			end 'wider'
		end 'each'
		return widest
	end 'maxPayloadArity'

	// Is this a HEAP-BOXED union — does SOME case carry a payload? A payload-free enum/union keeps
	// the bare-i64-tag representation P1.1b emits; only a payload-bearing one is boxed
	// (`8 + maxArity*8` bytes, tag@0). The one decider, so construct and match cannot disagree about
	// whether a value is a box or a bare tag.
	export function isBoxed() returns bool
		return self.maxPayloadArity() > 0
	end 'isBoxed'

	// The payload bytes `__mm_alloc` must be asked for: the tag word plus one slot per payload field
	// of the widest case. THE one place the box size is computed, so the allocation and the stores
	// that fill it cannot come to disagree about how big it is.
	export function boxSizeBytes() returns ByteOffset
		return UnionTagBytes + self.maxPayloadArity() * FieldSlotBytes
	end 'boxSizeBytes'

	// The byte offset of payload slot `slot` from the box pointer `__mm_alloc` returns — past the
	// tag word. The enum twin of `StructLayout.offsetOfField`.
	export function payloadSlotOffset(slot CaseIndex) returns ByteOffset
		return UnionTagBytes + slot * FieldSlotBytes
	end 'payloadSlotOffset'

	export function caseCount() returns CaseIndex
		return self.caseNames.count()
	end 'caseCount'

	// The name of case `index`.
	export function caseNameAt(index CaseIndex) returns ByteArray
		return try self.caseNames.get(index) otherwise panic("EnumLayout.caseNameAt: caseNames.get OOB at {index} for `{self.kindWord()} {String.from(self.name)}`, which declares {self.caseCount()} cases")
	end 'caseNameAt'

	// The tag of case `index` — its raw value (int/char backing) or IEEE-754 bit pattern (float backing),
	// and its declaration index for a STRING backing, whose raw value is not a number (see `caseRawValues`).
	export function tagOfIndex(index CaseIndex) returns ParsedInt
		return try self.caseTags.get(index) otherwise panic("EnumLayout.tagOfIndex: caseTags.get OOB at {index} for `{self.kindWord()} {String.from(self.name)}`, which declares {self.caseCount()} cases")
	end 'tagOfIndex'

	// ⭐⭐ **DOES THIS DECLARATION'S TAG COLUMN CARRY THE RAW VALUES, OR ONLY DECLARATION INDICES?** — ONE
	// fact, needed by two readers with nothing else in common: E3031's collision test
	// (`rawValueCollidesAt` below) and the decl-shape content hash (`ProgramSignatures.mixEnumCase`).
	//
	// An `integer`, `float` or `character` raw value IS a number — a raw int, an IEEE-754 bit pattern, a
	// Unicode codepoint — so for those the tag is the value and both readers need nothing else. A `string`
	// raw value is not a number, and neither is a FUNCTION reference, so those cases take the auto-increment
	// declaration index and the value itself rides `caseRawValues` (the declared text, or the function's
	// name).
	//
	// ⛔ **EXHAUSTIVE ON PURPOSE, exactly as `enumBackingDiscriminator` is and for the identical reason.** It
	// replaced an `if backing == string` written out at BOTH readers, each falling through silently to the
	// tag path — and `Parser.readEnumIntRawValue`'s own message still promises a struct backing "arrives with
	// a later rung". Such a backing added to an `if` takes the tag compare at both sites and produces a WRONG
	// ANSWER, not a compile error: two distinct struct raw values reading as a duplicate, and two distinct
	// enums folding to one hash. Written as a `match`, it cannot be declared without being classified here.
	// (The FUNCTION backing is exactly the case this argument predicted: two cases naming two different
	// functions carry declaration indices 0 and 1, so a tag compare would have admitted `a = f  b = f`.)
	export function rawValueIdentity() returns EnumRawValueIdentity
		match self.backing 'backing'
			integer to character then return EnumRawValueIdentity.theTag
			string to functionRef then return EnumRawValueIdentity.recordedText
			structRecord then return EnumRawValueIdentity.incomparable
			unresolved then panic("EnumLayout.rawValueIdentity: `{self.kindWord()} {String.from(self.name)}` has no backing yet — both readers ask this about a case already read, and reading a case is what fixes the backing (`Parser.requireEnumBacking`)")
		end 'backing'
	end 'rawValueIdentity'

	// ⭐ **DO CASE `index` AND AN INCOMING CASE CARRY THE SAME RAW VALUE?** — the E3031 question. A tag
	// compare where the tag is the value (`1.1` and `1.10` are one float, whatever the source text wrote),
	// a byte compare where it is not — because a string backing's tags are declaration indices, never
	// equal between two cases, which would make a tag compare a silent acceptance of `a = "x"  b = "x"` —
	// and NO comparison at all for a struct backing, which declares no comparable raw value
	// (see `EnumRawValueIdentity.incomparable` for the measurement behind that).
	export function rawValueCollidesAt(index CaseIndex, tag ParsedInt, rawValue String) returns bool
		match self.rawValueIdentity() 'identity'
			theTag then return self.tagOfIndex(index) == tag
			recordedText then return self.rawValueAt(index).equals(rawValue)
			incomparable then return false
		end 'identity'
	end 'rawValueCollidesAt'

	// How case `index`'s raw value was written — see `caseRawValues`.
	export function rawValueAt(index CaseIndex) returns String
		return try self.caseRawValues.get(index) otherwise panic("EnumLayout.rawValueAt: caseRawValues.get OOB at {index} for `{self.kindWord()} {String.from(self.name)}`, which declares {self.caseCount()} cases")
	end 'rawValueAt'

	// ⭐ **IS EVERY CASE'S TAG ITS OWN DECLARATION INDEX?** — the question `.ordinal` turns on, and the
	// only shape of enum for which the ordinal is READABLE OFF THE VALUE.
	//
	// An enum value at runtime IS its tag (`parseEnumLiteral`), while `.ordinal` is defined as the
	// DECLARATION INDEX — the bootstrap answers `2` for the third case however it is numbered. The two
	// coincide for an enum that numbers nothing (`idle`/`running`/`done` ⇒ tags 0,1,2), and they do not
	// for one that does (`ok = 5` ⇒ tag 5 at index 0). Where they coincide the accessor is the value
	// itself and costs no instruction; where they do not it is computed by the branchless tag→index sum
	// `Parser.emitEnumCaseConstantSelect` emits. This predicate is what picks between those two routes, and
	// nothing else reads it — so it is a COST question, not a support question.
	//
	// ⚠⚠ **IT ANSWERS ONLY WHETHER A TAG IS ITS INDEX — NEVER WHERE THE TAG IS, AND READING IT AS BOTH IS A
	// MEASURED WRONG ANSWER.** "An enum value IS its tag" above is true of a SCALAR enum and false of a
	// BOXED union, whose value is the box pointer; a boxed union's tags are `0,1,2,…` so this answers true
	// for one, and `.ordinal` used that as permission to skip the tag load and add zero to an address. Ask
	// `isBoxed` for where the tag lives and this for what the tag means — see `Parser.parseEnumAccessor`.
	//
	// A FLOAT-backed enum answers false unless its bit patterns happen to be 0,1,2,… — which no float
	// backing produces — so it always takes the computed route, without being named here.
	export function tagsAreDeclarationIndices() returns bool
		for i in 0 upto self.caseTags.count() 'each'
			let tag = try self.caseTags.get(i) otherwise panic("EnumLayout.tagsAreDeclarationIndices: caseTags.get OOB at {i} for `{self.kindWord()} {String.from(self.name)}`, which declares {self.caseCount()} cases")
			if tag != i 'renumbered'
				return false
			end 'renumbered'
		end 'each'
		return true
	end 'tagsAreDeclarationIndices'

	// The declaration index of the case named `wanted`, or `caseCount()` when no case carries that
	// name. A linear scan for `StructLayout.indexOfField`'s reason: case counts are tiny.
	export function indexOfCase(wanted ByteArray) returns CaseIndex
		for i in 0 upto self.caseNames.count() 'each'
			let caseName = try self.caseNames.get(i) otherwise panic("EnumLayout.indexOfCase: caseNames.get OOB at {i}")
			if caseName.equals(wanted) 'match'
				return i
			end 'match'
		end 'each'
		return self.caseNames.count()
	end 'indexOfCase'

	// Does this enum declare a case named `wanted`?
	export function hasCase(wanted ByteArray) returns bool
		return self.indexOfCase(wanted) < self.caseCount()
	end 'hasCase'

	// ⭐ **THE TAG OF THE CASE NAMED `wanted` — `indexOfCase` and `tagOfIndex` asked as ONE question (7b3).**
	// It lives HERE, beside the two halves it composes and beside `hasCase`, because the alternative is what it
	// replaced: a free function (`orderingTagOf`, below this type) that re-spelled `indexOfCase`'s "absent"
	// convention as `index >= caseCount()` — a THIRD copy of a sentinel comparison `hasCase` already owns, and
	// the copy furthest from the convention it was restating. Nothing was wrong; the convention is now written
	// once. It scans twice for a handful of cases (`indexOfCase`'s own header: case counts are tiny), which is
	// the price of asking `hasCase` rather than re-deriving its test.
	//
	// It PANICS on an absent case rather than returning a sentinel: a caller that does not already know the
	// layout declares the name asks `hasCase` first, which is what that predicate is for — and its two callers
	// name cases the layout they pass DECLARES (`Ordering`.s three, read from `stdlib/Interfaces.maxon`).
	export function tagOfCase(wanted ByteArray) returns ParsedInt
		if not self.hasCase(wanted) 'noSuchCase'
			panic("EnumLayout.tagOfCase: `{self.kindWord()} {String.from(self.name)}` declares no case '{String.from(wanted)}' — ask `hasCase` first when the name is not known to be one of this declaration's own")
		end 'noSuchCase'

		return self.tagOfIndex(self.indexOfCase(wanted))
	end 'tagOfCase'

	// The declaring keyword, for a diagnostic — `union` vs `enum`. The WORDS come from
	// `typeDeclKeyword`, which every other kind's diagnostics already read, so a declaration cannot be
	// called `union` here and something else there; this method only picks WHICH of the two applies to
	// this layout, which is the one fact `isUnion` holds and that function cannot.
	export function kindWord() returns String
		return typeDeclKeyword(TypeDeclKind.unionType if self.isUnion else TypeDeclKind.enumType)
	end 'kindWord'
end 'EnumLayout'

// ⭐⭐ **THE CLOSED INTERVAL A DECLARATION'S CASE TAGS OCCUPY, or `noCases`** — and it is a union rather
// than a pair with a sentinel because the two answers are genuinely different questions' answers: an empty
// declaration inhabits NO value, which is not the same as inhabiting `[0, 0]`, and its two readers disagree
// about what to do with it (`payloadFreeEnumTagSlot` gives it the machine word; a synthesized error union
// gives it no slice of the dispatch line, because nothing can ever be thrown that lands in one).
export union EnumTagSpan
	noCases
	spanning(low ParsedInt, high ParsedInt)
end 'EnumTagSpan'

// ⭐⭐ **THE SMALLEST AND LARGEST TAG A DECLARATION USES — ONE WALK, TWO READERS, AND THEY HAD ALREADY
// DRIFTED.** `SignatureIndex.payloadFreeEnumTagSlot` (which sizes the storage slot an unboxed enum value
// occupies) and `Parser.recordRoutedErrorType` (which measures a synthesized error union member's slice of
// the fused dispatch line) want the same two numbers off the same column, and each had its own copy of the
// loop. The copies differed on the ONE case where it matters: the storage one opened with a zero-case
// guard and the parser's began `tagOfIndex(0)`, so a declaration with no cases PANICKED
// `EnumLayout.tagOfIndex: caseTags.get OOB at 0` on one path and not the other.
//
// ⚠ It is asked of the TAGS and never of the case COUNT — the same number only for a declaration that
// numbers nothing. A renumbered enum (`ok = 200  notFound = 404`) really does occupy that span, and a
// FLOAT-backed one's tags are IEEE-754 bit patterns (`tagOfIndex`), which is how a two-case enum comes to
// span most of the i64 line.
export function enumTagSpan(layout EnumLayout) returns EnumTagSpan
	if layout.caseCount() == 0 'noValuesToSpan'
		return EnumTagSpan.noCases
	end 'noValuesToSpan'

	var low = layout.tagOfIndex(0)
	var high = low
	for i in 1 upto layout.caseCount() 'eachCase'
		let tag = layout.tagOfIndex(i)
		if tag < low 'newLow'
			low = tag
		end 'newLow'
		if tag > high 'newHigh'
			high = tag
		end 'newHigh'
	end 'eachCase'
	return EnumTagSpan.spanning(low, high: high)
end 'enumTagSpan'

export typealias EnumLayoutArray = Array with EnumLayout

// Registry: enum/union name -> its declaration. The twin of `StructLayoutMap`, filled from each
// file's artifact by `mergeArtifact` and read by TypeResolution to resolve `MaxonType.named` for a
// declared `enum`/`union` to its integer representation (an enum value IS its i64 tag).
export typealias EnumLayoutMap = Map with (ByteArray, EnumLayout)

// ⭐⭐ **`Ordering` IS DECLARED, NOT SYNTHESIZED (W3) — AND IT WAS THE LAST TRANSCRIPTION OF A CORPUS
// DECLARATION THIS FILE CARRIED.** `builtinOrderingEnum()` stood here, restating `stdlib/Interfaces.maxon:34-38`
// case for case, for the stated reason that shv2 read no stdlib. It reads that module now
// (`StdlibLoader.whitelistedStdlibModules`), so the declaration arrives through `upsertDeclaredEnum` like any
// other and every tag reader takes its layout from `requireCorpusDeclaredEnum` — the `__Managed*Error`
// precedent directly below, applied to the one enum in the set whose ordinals the compiler EMITS rather than
// merely throws.
//
// ⚠ **THE STAKE IS HIGHER HERE THAN FOR AN ERROR ENUM, WHICH IS WHY THE COPY COULD NOT SIMPLY BE KEPT IN
// STEP.** `Ordering`'s case ORDER is a wire format between code the compiler emits at two different tiers:
// `int.compare`/`float.compare`/`Character.compare` RETURN a tag (`BuiltinConformanceRuntime`), and the
// `<`/`>`/`<=`/`>=` lowering TESTS one (`Parser.emitOrderingVerdict`). Both now read the same declaration, so
// the two cannot disagree; while the transcription stood, agreement rested on nobody editing one of the two
// files, and nothing in the tree would have reported it — `BuiltinErrorOrdinalCheck` covers the error
// families only, and never reached `Ordering` at all.
//
// ⭐⭐ **THE THREE `__Managed*Error` FAMILIES ARE DECLARED, NOT SYNTHESIZED (A1s).** `__ManagedMemoryError`,
// `__ManagedFileError` and `__ManagedDirectoryError` were each transcribed into a `builtin…ErrorEnum()`
// constructor here, a second spelling of declarations that already exist in `stdlib/Builtins.maxon` (`:152`,
// `:175`, `:190`) — this project's signature bug, one fact written down twice, in the one place where a
// divergence is SILENT (the case ORDER is a wire format; see `BuiltinErrorOrdinalCheck`).
//
// ⚠ **THE SECOND SPELLING WAS ALREADY LOSING, AND THAT IS WHY IT HAD TO GO RATHER THAN BE KEPT IN STEP.**
// Once `stdlib/Builtins.maxon` is loaded, its parsed declarations reach BOTH enum registries through
// `upsertDeclaredEnum`, which is a last-wins upsert — so the PARSED layout displaced the seed and every
// handler arm was already being selected from it, while `BuiltinErrorOrdinalCheck` went on verifying the
// synthesized copy. MEASURED before this change: swapping `notFound` and `accessDenied` in
// `stdlib/Builtins.maxon` made `managed-directory.open-search-not-found-variant` abort (for an expected 42)
// with the drift guard SILENT — the guard was checking a layout the program did not use.
//
// ⚠ **THE ABORT'S EXIT CODE IN THAT MEASUREMENT WAS 134 AND IS NOW `PanicExitCode` (1).** The abort is a
// stdlib `panic(…)`, which used to exit 134 with no output at all; since it was wired to the `mrt_panic`
// runtime it prints `panic at <file>:<line>: …` plus a backtrace and exits 1. Re-running the measurement
// today reproduces the same DEFECT with a different, louder number — the record is what was seen then.
//
// ⇒ There is now ONE declaration of each, in `stdlib/Builtins.maxon`, and the compiler READS it
// (`declaredBuiltinErrorEnum`). The three constructors are gone; the case-NAME constants stay in
// `SignatureIndex.maxon`, because the runtime still has to name the case it throws.
//
// ⚠⚠ **`ArrayError`, `StringError` AND `MapError` HAVE NOW MOVED TOO, AND THE ENTRY THAT PREDICTED IT IS THE
// ONE THAT PAID IT.** This paragraph used to read *"TWO FAMILIES DO NOT MOVE … `ArrayError` is declared in
// `stdlib/Array.maxon:6`, which the stdlib loader does not LIST … `ArrayError` moves the day
// `stdlib/Array.maxon` is listed"*. That day is `land-the-listing`, and the same sentence had already come
// due UNNOTICED for the other two — `stdlib/String.maxon` and `stdlib/Map.maxon` were listed by W17 and W41,
// and each left its seed standing. All three constructors are gone; only `__DivisionByZeroError` keeps one,
// because it is declared in NO stdlib file at all and would move only if the reference `stdlib/` all three
// compilers share grew a declaration for it.
//
// ⛔⛔ **A SEED THAT SURVIVES ITS DECLARATION IS NOT INERT — IT DISARMS THE DRIFT GUARD, MEASURED.** The three
// constants are BARE names (`SignatureIndex.ArrayErrorTypeName` is `b"ArrayError"`, not `__ArrayError` — the
// old header here said otherwise and was wrong), so the parsed declaration and the seed land on ONE registry
// key and `upsertDeclaredEnum`'s last-wins upsert hands the program the CORPUS layout. Meanwhile
// `verifyManagedMemoryRuntimeOrdinals` went on checking `builtinArrayErrorEnum()`'s freshly-rebuilt copy — a layout
// nothing uses — so it agreed with itself whatever the corpus said. This is the `Builtins.maxon` defect
// verbatim, one paragraph up: *"the guard was checking a layout the program did not use."*
//
// ⚠ **MEASURED RED BEFORE THE FIX**, by the same experiment that caught it for `__ManagedDirectoryError`:
// swapping `indexOutOfBounds` and `emptySlot` in `stdlib/Array.maxon:7-8` made
// `array-slots.raw-open-slot-reports-empty-slot` answer **99 for an expected 42** and
// `past-the-end-reports-index-out-of-bounds` answer **42 for an expected 99** — the two handler arms trading
// places — with the ordinal guard emitting **nothing at all**. With the seeds retired and the guards reading
// `declaredBuiltinErrorEnum`, the same perturbation is reported as `E4016` naming both cases.
//
// ⇒ The rule this leaves behind, which is the reusable part: **listing a module that declares a builtin error
// enum is not complete until that family's seed is retired and its guard re-pointed.** The seed is not
// belt-and-braces; it is a second copy that silences the instrument watching the first.

// ⭐ **`IterationError` IS DECLARED, NOT SYNTHESIZED (W3)** — what a cursor's `advance()` throws, and the ONE
// builtin error enum the compiler never throws itself: `for … in` over a cursor absorbs the flag without
// naming the case, so every `throw`/`match` of it is the user's. `builtinIterationErrorEnum()` stood here
// because `stdlib/Interfaces.maxon` was not listed; it is listed now, so the declaration arrives through
// `upsertDeclaredEnum` exactly as the `__Managed*Error` families do, and there is one `enum IterationError`
// in the tree rather than two.
//
// ⚠ Its provenance is the one thing that does NOT match `ArrayError`/`StringError`/`MapError`: those three
// name modules the loader cannot list (`Array`, `String` and `Map` are synthesized), so they keep their
// unconditional seed. This one had a declaring file all along — it was merely unreadable.
//
// ⭐ **THE COMPILER-OWNED `__DivisionByZeroError` (A1)** — what a possibly-zero `/` or `mod` throws, and the
// type `specs-shv2/safety.md`'s `divide-by-zero-expression-form` and `mod-by-zero` discriminate.
//
// ⭐ **ONE CASE IS THE POINT, NOT A PLACEHOLDER.** There is exactly one way a divide can fail — its divisor
// was zero — so the enum says so and there is nothing to add later. The bootstrap declares it identically
// (`2-Parser.cs:1360-1364`). A single case still gets the full ordinal claim
// (`CheckedDivisionRuntime.verifyDivisionByZeroOrdinals`): the flag the lowering writes is derived from the
// ordinal, so a case inserted BEFORE it would silently retarget every `otherwise (e)` arm in the program.
//
// Seeded UNCONDITIONALLY beside the other four for their stated reason: `createEnumRegistry` is the one door
// that reaches BOTH registries, and a handler resolves its `match` through `Project.enumTypes`.
module function builtinDivisionByZeroErrorEnum() returns EnumLayout
	var layout = EnumLayout.createCompilerOwned(DivisionByZeroErrorTypeName, conformsTo: builtinErrorConformance())
	addBuiltinEnumCase(layout, caseName: DivisionByZeroCaseName)
	return layout
end 'builtinDivisionByZeroErrorEnum'

// ⭐ **WHAT `<Enum>.fromRawValue(raw)` THROWS ON A RAW VALUE NO CASE CARRIES.** The division family's twin in
// every respect — declared in no corpus file, seeded unconditionally beside it for the same reason, and
// payload-free so it stays golden-neutral (see `createEnumRegistry`).
module function builtinEnumLookupErrorEnum() returns EnumLayout
	var layout = EnumLayout.createCompilerOwned(EnumLookupErrorTypeName, conformsTo: builtinErrorConformance())
	// ⚠ **DECLARATION ORDER IS THE WIRE FORMAT** — `addBuiltinEnumCase` derives each tag from its position,
	// and `EnumLookupRuntime` transcribes both. Appending is safe; reordering silently renames every handler
	// arm, which is what `verifyEnumLookupErrorOrdinals` exists to catch.
	addBuiltinEnumCase(layout, caseName: EnumLookupNoSuchRawValueCaseName)
	addBuiltinEnumCase(layout, caseName: EnumLookupNoSuchCaseNameCaseName)
	return layout
end 'builtinEnumLookupErrorEnum'

// Append one payload-free case carrying the AUTO-INCREMENT tag a bare `enum` case gets. The case count so
// far IS the next tag (`Parser.readEnumCaseInto`'s counter starts at 0 and steps by 1), so the tag is
// DERIVED from declaration order rather than written down — this type's header explains why a tag and a
// declaration position must never be the same stored field, and writing `0`/`1`/`2` here would smuggle the
// conflation back in through the builder.
//
// ⭐ `declaresRawValue: false` for the same reason the tag is derived: a builtin's cases are the AUTO-INCREMENT
// shape, so a caught `__DivisionByZeroError` interpolates as `divisionByZero` exactly as a corpus-declared
// error enum does — which is what a program printing `"{e}"` on one gets from the oracle.
function addBuiltinEnumCase(layout EnumLayout, caseName ByteArray)
	let tag = layout.caseCount()
	layout.addCase(caseName, tag: tag, rawValue: "{tag}", declaresRawValue: false, payloads: PayloadFieldArray.create(), backingFields: sharedEmptyEnumBackingFields)
end 'addBuiltinEnumCase'

// ⭐⭐ **THE ORDINAL DRIFT GUARD FOR THE BUILTIN ERROR ENUMS — ONE MECHANISM, FIVE FAMILIES (7b, +A1, +A1s).**
//
// Each `__Managed*Error` / `ArrayError` / `__DivisionByZeroError` wire format lives in TWO places with
// nothing tying them: the case ORDER (a declaration, where position IS the ordinal), and the ordinals as
// LITERALS in the runtime throw sites. Drift means **every handler arm names the wrong case, silently** — no
// crash, no wrong exit code, just a program that reports `accessDenied` where the OS said
// `openSearchFailed`.
//
// ⚠ **MEASURED, NOT ARGUED, TWICE.** Before this guard existed, swapping two cases and leaving the runtime
// alone left the suite **2758/0 GREEN**. And at A1s — with the guard in place, but anchored to the
// COMPILER's transcribed copy while the program already resolved its handler arms from the PARSED one —
// swapping `notFound` and `accessDenied` in `stdlib/Builtins.maxon` made
// `managed-directory.open-search-not-found-variant` **abort (for an expected 42) with this guard
// SILENT** — see this file's `declaredBuiltinErrorEnum` header for what the abort's exit code was then and
// is now. A guard anchored to a copy the program does not use is not a guard. Correspondence is
// well-checked only by coincidence of coverage — three directory ordinals happen to be pinned by committed
// `match` arms, and the rest need an OS failure mid-iteration that no test can provoke.
//
// ⭐ **WHY A CHECK AND NOT A DERIVATION, WHICH WOULD BE BETTER.** `EnumLayout.tagOfCase` is the cure this
// project prefers and its header says why — the bootstrap "spells 0/1/2 as literals at its consumer sites
// with nothing tying them back to the declaration; shv2 deliberately does not". It is UNAVAILABLE here:
// these ordinals feed `…Flag = …Ordinal + ErrorFlagOrdinalBias` chains that are themselves global `let`s,
// and a global initializer may hold no function call (**E2045**). Deriving would mean threading the layout
// to every throw site — a different rung. So the fact stays written twice and this makes disagreement LOUD.
//
// ⛔⛔ **IT WAS FORWARD ONLY, AND "FORWARD ONLY IS COMPLETE" WAS FALSE — MEASURED (W135).** The paragraph
// that stood here read: *"a case may be DECLARED and never thrown … a backward 'every case is claimed' arm
// would fire on all of them. The forward arm is COMPLETE for the failure this guards: any insertion,
// deletion or reorder that moves a case somebody throws moves it away from its claimed ordinal."* The
// premise is right and the conclusion does not follow — a perturbation confined to the cases NOBODY claims
// moves no claimed ordinal, so the check saw nothing. Eight such edits to `stdlib/Builtins.maxon` compiled
// CLEAN against it: swapping `__ManagedFileError`'s `invalidStatBuffer`/`invalidStatIndex` (8,9) and
// `__ManagedMemoryError`'s `emptySlot`/`sliceOutOfBounds` (1,2), renaming any of the five unclaimed cases
// out of existence, and APPENDING a ninth case to `__ManagedDirectoryError` — in the one place whose own
// sentence two arms down is *"the enum's case ORDER is the wire format"*.
//
// ⇒ **THE CURE IS TOTALITY, NOT FIVE MORE CLAIMS.** Five more `claim` lines would have closed those gaps
// and reopened the identical hole at the next case anyone adds, because the defect is that the check was a
// SUBSET check at all. A declared case is now accounted for EITHER WAY — `claim` (the runtime throws it at
// that ordinal) or `neverThrown` (the runtime never produces it, and its POSITION is transcribed anyway) —
// and `requireTotal` refuses the third answer that used to be available for free: silence. The old
// paragraph's premise survives intact; it is simply WRITTEN DOWN per case now, rather than inferred from an
// omission that reads identically to a forgotten line.
//
// ⭐ **AN EXEMPT CASE IS TRANSCRIBED *AT AN ORDINAL*, WHICH IS NOT OBVIOUS AND IS THE STRONGER HALF.** A
// bare `neverThrown(caseName)` would make the check total over the NAME SET and leave it partial over the
// ORDER — exactly the two swaps above, which move wire values while every claimed ordinal stays put. Naming
// the position makes this a transcription of the DECLARATION rather than of the throw sites, so an edit to
// the declaration that nothing here mirrors is loud whichever cases it touches. It costs one literal per
// exempt case, and that literal is precisely what this type exists to be: the fact written twice, on
// purpose, so a disagreement is LOUD rather than silent (the ⭐ *WHY A CHECK AND NOT A DERIVATION* note
// above is why writing it twice is the shape available here at all).
//
// ⭐⭐ **ONE CLAIM IS ONE CALL, FOR `EnumLayout.addCase`'s EXACT REASON** (fifteen functions up this file:
// "a caller that pushed a name and forgot a tag would shift every later case's tag onto the wrong case").
// 7b first shipped this as a free function taking two PARALLEL ARRAYS — a name column and an ordinal column
// pushed in lockstep at four call sites — plus a runtime `count() != count()` panic apologizing for the
// shape. That panic existed only because the shape PERMITTED desynchronization, and the mismatches it could
// NOT see are the dangerous ones: pushing a name and an ordinal in the wrong ORDER, or dropping a name and
// an ordinal belonging to DIFFERENT cases, leaves the counts equal and silently re-pairs every claim below
// — the very failure this guard exists to catch, reintroduced by the guard's own call shape. Carrying both
// halves in ONE argument list and checking them on the spot makes that unrepresentable, and the count check
// goes away WITH the columns rather than being deleted on an argument.
//
// ⚠⚠ **THE VERDICT'S SEVERITY FOLLOWS THE DECLARATION'S PROVENANCE, AND A1s IS WHY THERE ARE NOW TWO.**
// Until A1s every declaration was a `builtin…ErrorEnum()` CONSTRUCTOR, so the verdict was a property of the
// compiler BINARY alone — it panicked on the first program compiled or on none — and that is exactly what
// made `panic` right rather than a diagnostic: no source could reach it. Three families now read a PARSED
// declaration out of `stdlib/Builtins.maxon`, and that is a property of a FILE ON DISK. A developer editing
// that file can make this disagree, and answering a SOURCE problem with a compiler CRASH would report it as
// an internal one. So `BuiltinErrorDeclarationSource` carries which kind of layout a check holds, and the
// two failures part company at exactly the point where they stop being the same fact: `synthesized` still
// PANICS (only this compiler's own source can move `ArrayError` or `__DivisionByZeroError`), while
// `declared` REPORTS **E4016** against the project, so the pipeline's error gate fails the build with no
// binary written. It is `IrDeclarationTakesCompilerOwnedName`'s provenance discriminator (A1t) applied
// one registry over.
//
// ⚠ A user PROGRAM still cannot steer either verdict: the three declared names are `__`-prefixed, so
// `requireUnreservedName` (E2051) refuses any source but `stdlib/Builtins.maxon` itself to declare them.

// WHERE THE LAYOUT A CHECK VERIFIES AGAINST CAME FROM — and therefore who is at fault when it disagrees.
// ⚠ `module`, not `export`: it is reached only as a field of the check below, from `Compiler/Runtime/`, and
// shv2's own `checkUnusedExports` (E3093) is what says so — the SELF-COMPILE runs that pass and the
// bootstrap does not.
module enum BuiltinErrorDeclarationSource
	// A `builtin…ErrorEnum()` constructor in this file. Nothing outside the compiler's own source can move
	// it, so a disagreement is a compiler bug and the check PANICS.
	synthesized
	// A declaration parsed from `stdlib/Builtins.maxon`. This checkout's source can move it, so a
	// disagreement is reported as E4016 against the project rather than crashing the compiler.
	declared
end 'BuiltinErrorDeclarationSource'

// ⭐ **WHAT A TRANSCRIPTION STATES ABOUT ONE DECLARED CASE (W135).** There are exactly two answers and no
// third — SILENCE is what `BuiltinErrorOrdinalCheck.requireTotal` withdrew, and this enum is what replaced
// it. Read at the two failure arms of `recordCase`, which must say different things about a claim and about
// an exemption: telling an author that a case nothing throws "is thrown as 9" would be a lying diagnostic.
enum BuiltinErrorCaseUse
	// The runtime returns this case's ordinal as an error flag, out of a literal it transcribed.
	thrown
	// The runtime never produces this case at all. Its ordinal is transcribed anyway — see the ⭐ paragraph
	// in `BuiltinErrorOrdinalCheck`'s header for why the POSITION is stated when the throw is not.
	neverThrown
end 'BuiltinErrorCaseUse'

// ⚠ `module`, not `export`: every installer that raises one lives under `Compiler/Runtime/`, and shv2's own
// `checkUnusedExports` (E3093) is what says so — the SELF-COMPILE runs that pass and the bootstrap does not.
module type BuiltinErrorOrdinalCheck
	// The declaration every claim is checked against.
	var declaration as EnumLayout
	// Where that declaration came from — see `BuiltinErrorDeclarationSource`.
	var source as BuiltinErrorDeclarationSource
	// WHO transcribed the ordinals, for the diagnostic — the installer that owns the literals.
	var installer as ByteArray
	// The diagnostic sink a `declared` disagreement is reported against. Carried by every check rather than
	// by the `declared` arm alone, because a `match` binds a union payload IMMUTABLY (E3019) and reporting
	// mutates the project — so the arm could hold it but could not use it. The `synthesized` path never
	// reads it: it panics, which is exactly the difference `source` records.
	var project as Project
	// ⭐ **WHICH DECLARED CASES A VERB HAS ACCOUNTED FOR, BY DECLARATION INDEX (W135)** — the column
	// `requireTotal` reads, and the reason the two verbs are one code path. It is sized from the declaration
	// at construction, so "is every case accounted for?" is asked of exactly the case set the claims were
	// checked against; a set keyed by NAME would re-derive that answer from the claims themselves and could
	// therefore agree with a transcription that had drifted away from the layout entirely.
	var accountedByIndex as BoolArray

	// A check over a layout the COMPILER built — the families that have no loadable stdlib declaration to
	// read, which today are `__DivisionByZeroError` and `__EnumLookupError`.
	//
	// ⚠ **`ArrayError` WAS NAMED HERE AND HAS NOT BELONGED SINCE `stdlib/Array.maxon` WAS LISTED**, which
	// gave it a real declaration and moved its check to `overDeclared` — so this sentence spent a while
	// naming a caller that was not one, beside a count of them. Both are stated as *"today"* now: the SET is
	// a consequence of which modules the loader lists, and that changes without this line being read.
	export static function overSynthesized(project Project, declaration EnumLayout, installer ByteArray) returns BuiltinErrorOrdinalCheck
		return BuiltinErrorOrdinalCheck.over(project, declaration: declaration, source: BuiltinErrorDeclarationSource.synthesized, installer: installer)
	end 'overSynthesized'

	// A check over a layout parsed from `stdlib/Builtins.maxon`, reached through `declaredBuiltinErrorEnum`
	// — which is what turns an ABSENT declaration into one E4016 rather than into a silently-empty enum.
	export static function overDeclared(project Project, declaration EnumLayout, installer ByteArray) returns BuiltinErrorOrdinalCheck
		return BuiltinErrorOrdinalCheck.over(project, declaration: declaration, source: BuiltinErrorDeclarationSource.declared, installer: installer)
	end 'overDeclared'

	// THE one `Self{…}`, so the field list is written once and the two doors above differ only in the FACT
	// they name — `EnumLayout.createCompilerOwned`'s shape, four hundred lines up this file. It is also the
	// one place `accountedByIndex` is sized, which is what makes "sized from the declaration" a property of
	// the type rather than of each door.
	static function over(project Project, declaration EnumLayout, source BuiltinErrorDeclarationSource, installer ByteArray) returns BuiltinErrorOrdinalCheck
		var accountedByIndex = BoolArray.create()
		var filled = 0 as CaseIndex
		while filled < declaration.caseCount() 'eachCase'
			accountedByIndex.push(false)
			filled = filled + 1
		end 'eachCase'

		return Self{declaration: declaration, source: source, installer: installer, project: project, accountedByIndex: accountedByIndex}
	end 'over'

	// One claim — "`installer` throws `caseName` as `ordinal`" — verified against the declaration on the
	// spot. THE only way to state a claim, so a name can never be recorded without the ordinal it belongs to.
	export function claim(caseName ByteArray, ordinal ParsedInt)
		self.recordCase(caseName, ordinal: ordinal, use: BuiltinErrorCaseUse.thrown)
	end 'claim'

	// One case the runtime NEVER throws, at the ordinal the declaration gives it (W135) — an exemption
	// STATED rather than an omission left to be read as one. See this type's header for why the ordinal is
	// named when the throw is not, and each caller for the per-case evidence that nothing produces it.
	export function neverThrown(caseName ByteArray, ordinal ParsedInt)
		self.recordCase(caseName, ordinal: ordinal, use: BuiltinErrorCaseUse.neverThrown)
	end 'neverThrown'

	// THE one place a case is verified AND struck off, so the two verbs above cannot come to disagree about
	// what "accounted for" means or about which ordinal a case sits at. Both halves belong together for
	// `EnumLayout.addCase`'s reason: a verb that checked an ordinal without marking the case, or marked it
	// without checking, would let `requireTotal` pass over a case nothing verified.
	function recordCase(caseName ByteArray, ordinal ParsedInt, use BuiltinErrorCaseUse)
		if not self.declaration.hasCase(caseName) 'noSuchCase'
			match use 'absentCase'
				thrown then self.refuse("{String.from(self.installer)} claims ordinal {ordinal} for '{String.from(caseName)}', but `{self.declaration.kindWord()} {String.from(self.declaration.name)}` declares no such case — the runtime throws a case the enum does not have, so no handler arm could ever match it")
				neverThrown then self.refuse("{String.from(self.installer)} records '{String.from(caseName)}' at ordinal {ordinal} as a case it never throws, but `{self.declaration.kindWord()} {String.from(self.declaration.name)}` declares no such case — an exemption written for a case that is not there excuses nothing, and whichever case it was written for is now unaccounted for")
			end 'absentCase'
			return
		end 'noSuchCase'

		// `hasCase` above has already established the name, so this index is a real one. It is taken rather
		// than asking `tagOfCase` — the pairing 7b3 collapsed into that one method — because the column below
		// is keyed by declaration index and the index is therefore needed anyway; re-deriving the tag through
		// the name would scan the case list a third time to reach a position already in hand. The "absent"
		// convention `tagOfCase` owns is still not re-spelled here: `hasCase` is what asks it.
		let index = self.declaration.indexOfCase(caseName)
		let alreadyAccounted = try self.accountedByIndex.get(index) otherwise panic("BuiltinErrorOrdinalCheck.recordCase: accountedByIndex.get OOB at {index} for `{self.declaration.kindWord()} {String.from(self.declaration.name)}`, whose {self.declaration.caseCount()} cases sized this column at construction — the layout was mutated after the check was built")
		if alreadyAccounted 'accountedTwice'
			self.refuse("{String.from(self.installer)} accounts for '{String.from(caseName)}' twice in `{self.declaration.kindWord()} {String.from(self.declaration.name)}` — a case is either thrown at its ordinal or never thrown, so two verbs over one case means one of them states something false, and the case the second line was meant to cover is going unaccounted for")
			return
		end 'accountedTwice'

		try self.accountedByIndex.set(index, value: true) otherwise panic("BuiltinErrorOrdinalCheck.recordCase: accountedByIndex.set OOB at {index} for `{self.declaration.kindWord()} {String.from(self.declaration.name)}` — the `get` one line up read the same index")

		// Marked BEFORE the ordinal is tested, so a single drifted case earns one diagnostic rather than two:
		// it IS accounted for, and reporting it again from `requireTotal` would name the same edit twice under
		// two different complaints. This arm needs `refuse` and not a panic (a drifted runtime is a compiler
		// defect worth naming, not worth aborting on before the sentence is printed).
		let declared = self.declaration.tagOfIndex(index)
		if declared != ordinal 'drifted'
			match use 'driftedCase'
				thrown then self.refuse("'{String.from(caseName)}' is ordinal {declared} in `{self.declaration.kindWord()} {String.from(self.declaration.name)}` but {String.from(self.installer)} throws it as {ordinal} — the enum's case ORDER is the wire format and the two have DRIFTED. Every handler arm for this case would name the wrong error, silently. Fix the runtime's ordinal, or move the case back")
				neverThrown then self.refuse("'{String.from(caseName)}' is ordinal {declared} in `{self.declaration.kindWord()} {String.from(self.declaration.name)}` but {String.from(self.installer)} transcribes it at {ordinal} as a case it never throws — the enum's case ORDER is the wire format whether or not anybody throws a given case, and the two have DRIFTED. Fix the transcribed ordinal, or move the case back")
			end 'driftedCase'
		end 'drifted'
	end 'recordCase'

	// ⭐⭐ **THE ARM THAT MAKES THIS A TRANSCRIPTION RATHER THAN A SAMPLE (W135), AND EVERY FAMILY OWES ONE
	// CALL.** Without it the verbs above are a SUBSET check: whatever a caller does not mention is exempt by
	// accident, which reads exactly like an exemption on purpose and exactly like a line somebody forgot.
	// The header records the eight measured corpus edits that compiled clean because of it.
	//
	// ⚠ It is the LAST statement of each family's claim function and not a step in a shared driver, because
	// the ordinal literals are file-private to the runtime that transcribes them — so the walk that states
	// them and the walk that closes them are one function by construction. A family that adds a case to its
	// enum and no verb to that function is refused HERE, which is the point at which the omission is still
	// one edit old.
	export function requireTotal()
		for index in 0 upto self.declaration.caseCount() 'eachCase'
			let accounted = try self.accountedByIndex.get(index) otherwise panic("BuiltinErrorOrdinalCheck.requireTotal: accountedByIndex.get OOB at {index} for `{self.declaration.kindWord()} {String.from(self.declaration.name)}`, whose {self.declaration.caseCount()} cases sized this column at construction — the layout was mutated after the check was built")
			if not accounted 'unaccounted'
				self.refuse("`{self.declaration.kindWord()} {String.from(self.declaration.name)}` declares '{String.from(self.declaration.caseNameAt(index))}' at ordinal {self.declaration.tagOfIndex(index)} and {String.from(self.installer)} accounts for it NEITHER WAY — every declared case must be either a `claim` (the runtime throws it at that ordinal) or a `neverThrown` (the runtime never produces it, and its position is transcribed anyway). Silence is the third answer this check no longer takes: a case nobody mentions is a GAP, and an insertion, deletion or reorder inside a gap moves a wire value with nothing watching it. Add whichever verb is true of this case")
			end 'unaccounted'
		end 'eachCase'
	end 'requireTotal'

	// THE one place a failed transcription becomes a verdict, so the failure shapes above — an absent case, a
	// case accounted for twice, a drifted ordinal, a case accounted for neither way — cannot come to disagree
	// about which severity a source earns. See `BuiltinErrorDeclarationSource` for the split.
	function refuse(reason String)
		match self.source 'origin'
			synthesized then panic("BuiltinErrorOrdinalCheck: {reason}")
			// ⚠ **THE DECLARING MODULE IS NOT NAMED, AND IT USED TO BE.** This read
			// "stdlib/Builtins.maxon's `enum …`", which was true while that module declared every family
			// this arm could reach. `land-the-listing` moved three more onto their own modules
			// (`stdlib/Array.maxon`, `stdlib/String.maxon`, `stdlib/Map.maxon`), and the literal became a
			// diagnostic that names the wrong file — MEASURED, on the very drift this rung provoked to
			// prove the guard works. The enum's NAME already locates it and the loader is the one place
			// that knows which module declares what, so the sentence states the fact it actually holds.
			declared then reportDiagnostic(self.project, diagnostic: Diagnostic.create(ErrorCode.builtinErrorEnumMismatch, message: "the corpus's `{self.declaration.kindWord()} {String.from(self.declaration.name)}` disagrees with this compiler's runtime: {reason}"))
		end 'origin'
	end 'refuse'
end 'BuiltinErrorOrdinalCheck'

// What `declaredBuiltinErrorEnum` found. `notDeclared` is a real answer with its own case rather than an
// empty layout, because an empty one would make every `claim` behind it report the SAME "declares no such
// case" — one diagnostic per ordinal, for the single fact that the module was not loaded.
module union DeclaredBuiltinErrorEnum
	found(layout EnumLayout)
	notDeclared
end 'DeclaredBuiltinErrorEnum'

// ⭐ **THE ONE DOOR TO A BUILTIN ERROR ENUM'S *DECLARED* LAYOUT (A1s)** — `stdlib/Builtins.maxon`'s, out of
// the authority registry `commitEnumTypes` fills.
//
// ⚠ **ITS ABSENCE IS A DIAGNOSTIC, NOT A PANIC AND NOT A SILENTLY-EMPTY ENUM** — the coupling this rung's
// ruling deliberately buys is that the builtin error families now depend on a stdlib module being LOADED.
// The file going MISSING is caught earlier and more precisely (`StdlibLoader.listWhitelistedModule` throws
// `fileNotFound` naming the path), so what actually reaches here is the module present but no longer LISTED,
// or listed but no longer declaring the enum. Both are edits to this checkout, and both would otherwise
// produce a compiler that throws ordinals no handler arm can name.
module function declaredBuiltinErrorEnum(project Project, typeName ByteArray, installer ByteArray) returns DeclaredBuiltinErrorEnum
	let layout = try project.enumTypes.get(typeName) otherwise 'notDeclared'
		// ⚠ Names no module either, for `BuiltinErrorOrdinalCheck.refuse`'s reason directly above: SEVERAL
		// families reach this and they are declared across several different files. It said "six families
		// across four different files" and both numbers were stale in the SHRINKING direction — they counted
		// `StringError` and `MapError`, which left this door at W49 and W105 when the corpus became their only
		// producer (`Compiler.compileToCodeResult` records both retirements). Counted again it would go stale
		// again, and in either direction: the set is a consequence of which runtimes still transcribe an
		// ordinal and which modules the loader lists, neither of which is read from here. The roster that DOES
		// know is the call block in `Compiler.compileToCodeResult`; this sentence only needs the fact that
		// makes naming a module wrong, which is that more than one declares one.
		reportDiagnostic(project, diagnostic: Diagnostic.create(ErrorCode.builtinErrorEnumMismatch, message: "'{String.from(typeName)}' is the error enum {String.from(installer)} throws, and this compile declares no enum of that name — it is declared by a stdlib module, which `StdlibLoader.whitelistedStdlibModules` must list for the runtime's error ordinals to name anything"))
		return DeclaredBuiltinErrorEnum.notDeclared
	end 'notDeclared'

	return DeclaredBuiltinErrorEnum.found(layout)
end 'declaredBuiltinErrorEnum'

// ⭐⭐ **THE LAYOUT OF A COMPILER-OWNED ENUM THE COMPILER *BUILDS TAGS FROM* (W3)** — `Ordering`'s, out of
// whichever registry the reader holds: the PARSER reads `ProgramSignatures.enumTypes` while lowering
// `<`/`>`/`<=`/`>=`, and the Std tier reads `Project.enumTypes` while building the `Comparable` cascade. Both
// maps are `createEnumRegistry`'s and both receive the corpus declaration through `upsertDeclaredEnum`, so one
// function over `EnumLayoutMap` serves both and there is one sentence to keep true instead of two.
//
// ⚠ **ITS ABSENCE IS A PANIC, WHERE `declaredBuiltinErrorEnum`'s IS A DIAGNOSTIC, AND THE TWO ANSWER
// DIFFERENT QUESTIONS.** That one asks *"is there a declaration to CHECK the runtime's claimed ordinals
// against?"* — a claim can be refused and the compile can carry on to report it. This one asks *"what tag IS
// `lessThan`?"* at a site that must emit a number: there is no degraded answer, and continuing would mean
// inventing one. The entry cannot be missing in a sound checkout — `StdlibLoader` lists the declaring module
// unconditionally and `listWhitelistedModule` throws `fileNotFound` if the file is gone — so what reaches
// here is a declaration deleted from a listed module, which is the same class of checkout edit
// `EnumLayout.tagOfCase` panics on.
export function requireCorpusDeclaredEnum(registry EnumLayoutMap, typeName ByteArray, reader String) returns EnumLayout
	return try registry.get(typeName) otherwise panic("requireCorpusDeclaredEnum: {reader} needs the case tags of `enum {String.from(typeName)}`, and this compile declares no enum of that name — the compiler reads that declaration out of the corpus rather than transcribing it, so the module declaring it must be listed by `StdlibLoader.whitelistedStdlibModules` and must still declare it")
end 'requireCorpusDeclaredEnum'

// ⭐ **AN ENUM REGISTRY, SEEDED WITH THE ENUMS NO CORPUS FILE DECLARES (P1.7a slice 2b-ii, +W3)** — THE one
// constructor of an `EnumLayoutMap`, used by BOTH registries that hold declared enums (`Project.enumTypes`,
// the authority, and `ProgramSignatures.enumTypes`, the parser's whole-program index).
//
// Seeding at the map's single creation point is what makes a synthesized enum visible to EVERY reader of
// either registry at once — `containsEnum`/`enumOf` (a qualified case value, a `match` scrutinee's enum, a
// field's storage width), `resolveNamedType`'s erase-to-`integer`, `aggregateNameFor`'s nominal identity —
// with no per-reader by-name arm to add today or to forget tomorrow. Three by-name special cases were the
// alternative, and this project's signature bug is one fact written more than once.
//
// It stays GOLDEN-NEUTRAL because every enum seeded here is payload-FREE: every pass that WALKS this registry
// to EMIT something (`installUnionDestructors`, `noteDestructorUsage`, `noteClonerUsage`) selects only unions
// with a managed payload, so a seeded entry contributes no code to any program. **MEASURED: zero modified
// `specs-shv2/fragments` goldens across the whole suite.** Its cost is a FLAT per-compile constant — measured
// +68 allocations / +2,376 bytes, IDENTICAL at scale-test rung 0 and rung 5, i.e. with no growing term —
// almost all of it the two registries' first `Map` upsert initializing their slot arrays. That constant is the
// deliberate price of "every reader, no arm": demand-gating the seed would put the "is it registered yet?"
// question back at each reader, which is the shape this exists to remove.
//
// ⭐⭐ **WHAT IS SEEDED IS EXACTLY WHAT NO LISTED MODULE DECLARES — AND W3 MOVED TWO OFF THIS LIST.**
// `Ordering` and `IterationError` were transcribed here from `stdlib/Interfaces.maxon:28-38`; that module is
// now LISTED, so both arrive through the ordinary declaration path (`upsertDeclaredEnum`) exactly as the
// three `__Managed*Error` families do, and the compiler READS the case order it used to restate
// (`requireCorpusDeclaredEnum`). What remains below is the set with no corpus declaration to read.
//
// ⚠⚠ **AND `land-the-listing` MOVED THREE MORE, LEAVING A SET OF ONE.** This paragraph read *"`Array`,
// `String` and `Map` are SYNTHESIZED rather than loaded, so their error enums have no listed declaring
// file"* — every clause of which is now stale: all three modules are LISTED and all three declare their
// enum (`stdlib/Array.maxon:6`, `stdlib/String.maxon:6`, `stdlib/Map.maxon:6`). Their seeds are retired,
// and the ⛔⛔ block above `declaredBuiltinErrorEnum`'s neighbours records what a seed that outlives its
// declaration actually costs: not a harmless duplicate, but a disarmed drift guard, measured.
export function createEnumRegistry() returns EnumLayoutMap
	var registry = EnumLayoutMap.create()
	// ⚠ **THE SIX DECLARED FAMILIES ARE NOT SEEDED HERE** — the three `__Managed*Error` ones (A1s) are
	// declared in `stdlib/Builtins.maxon`, and `ArrayError` / `StringError` / `MapError` in their own
	// listed modules. All six arrive through the ordinary declaration path (`upsertDeclaredEnum`), which
	// is what makes the declaration the one authority instead of the winner of a last-wins upsert against
	// a seed nothing checks. See `declaredBuiltinErrorEnum` for what happens when a module is not loaded.
	// A1: what a possibly-zero `/` or `mod` throws — declared in no stdlib file, so it is seeded and its
	// guard stays `overSynthesized`. See `builtinDivisionByZeroErrorEnum`.
	registry.upsert(DivisionByZeroErrorTypeName, value: builtinDivisionByZeroErrorEnum())
	// What `<Enum>.fromRawValue(raw)` throws — declared in no stdlib file either, so it is seeded beside the
	// division one. See `builtinEnumLookupErrorEnum`.
	registry.upsert(EnumLookupErrorTypeName, value: builtinEnumLookupErrorEnum())
	return registry
end 'createEnumRegistry'

// ⭐ **THE ONE DOOR A *DECLARED* ENUM ENTERS EITHER REGISTRY THROUGH, AND A USER MAY NOT DISPLACE THE
// COMPILER'S OWN** — `Project.enumTypes` (the authority, via `commitEnumTypes`) and
// `ProgramSignatures.enumTypes` (the parser's whole-program index, via `ProgramSignatures.recordEnum`). Both
// maps are built by `createEnumRegistry`, and every reader that turns a compiler-owned enum's case into a TAG
// (`int.compare`'s cascade, the `<`/`>`/`<=`/`>=` lowering, a `match` arm) resolves it through one of them —
// so two live layouts under one name is a program in which a comparison and its `match` read different
// numbers, silently.
//
// ⚠ **THE PARSE-TIME REJECT ALONE DOES NOT KEEP THAT OUT, AND A REVIEW PROBE PROVED IT.** The
// whole-program DECLARATION SWEEP is deliberately not a validator (`Parser.recordScannedType`), so it folds a
// user `enum Ordering` into `ProgramSignatures.enumTypes` BEFORE the real parse gets to refuse it — measured by
// making this function panic, which fired from `ProgramSignatures.recordEnum` on `enum Ordering … end`. The
// claim held only because such a program never reaches codegen; it was a comment, not an invariant.
//
// ⭐⭐ **W3 TURNED THE DROP INTO A PROVENANCE TEST, BECAUSE THE COMPILER NOW *READS* TWO OF THESE NAMES.**
// `Ordering` and `IterationError` are declared in `stdlib/Interfaces.maxon` and are no longer transcribed
// into this file (`declaredBuiltinEnum`); dropping every compiler-owned layout would drop the very
// declarations the compare cascade and the cursor protocol are built from. So the rule is now the one
// sentence it always meant: **a compiler-owned type name may be declared by the CORPUS and by nothing else.**
// A user declaration is still dropped at this single write — the collision stays unrepresentable rather than
// merely diagnosed, which is what keeps the E2015 (`Parser.requireTypeNameNotCompilerOwned`) a message to the
// author rather than the only thing standing between two numberings of one enum.
//
// ⚠ The bit is the FILE's (`Queries.livesUnderStdlibDirectory`), computed once per file by the caller, so the
// probe `maxon-shv2 build stdlib/Interfaces.maxon` records the same declarations the loaded module does —
// see `Parser.requireTypeNameNotCompilerOwned` for why `isStdlibSource` is the wrong bit here.
export function upsertDeclaredEnum(registry EnumLayoutMap, layout EnumLayout, declaredByTheCorpus bool)
	// An `enum`/`union` layout MINTS an identity of its own, so it can agree with no compiler-owned meaning
	// — see `DeclaredTypeMeaning.nominalIdentity`.
	if declarationContestsACompilerOwnedName(layout.name, declaredByTheCorpus: declaredByTheCorpus, declares: DeclaredTypeMeaning.nominalIdentity) 'aUserContest'
		return
	end 'aUserContest'

	registry.upsert(layout.name, value: layout)
end 'upsertDeclaredEnum'

// ⭐ **THE RULE ITSELF, IN ONE PLACE: A COMPILER-OWNED TYPE NAME MAY BE DECLARED BY THE CORPUS AND BY
// NOTHING ELSE.** Asked by both registries that can be handed such a declaration by a walk that is not a
// validator — `upsertDeclaredEnum` above, and `ProgramSignatures.recordStruct` one file over (W16).
//
// ⚠ **IT IS A FUNCTION BECAUSE THE TWO HAD ALREADY DRIFTED.** Spelled out at each site, the struct registry
// dropped EVERY such declaration while the enum registry dropped only a user's — and since
// `Parser.requireTypeNameNotCompilerOwned` admits a stdlib file, the strict copy threw away layouts the real
// parse then went looking for, taking the compiler down at `enclosingLayout` / `requireConstructible` on
// `stdlib/String.maxon` and `stdlib/Character.maxon`. One conjunction written twice is what let a rule mean
// two things; `recordStruct`'s header carries the measurement.
//
// The bit is the FILE's (`Queries.livesUnderStdlibDirectory`), never `isStdlibSource` — computed once per
// file by each caller, so the readiness probe `maxon-shv2 build stdlib/<M>.maxon` records exactly what the
// loaded module records. See `Parser.requireTypeNameNotCompilerOwned` for why the two bits differ.
// ⭐⭐ **A CONTEST IS A *DISAGREEMENT*, NOT A REPEAT** (spec-port `lazy-static`). The rule used to end at
// "and not declaredByTheCorpus", which refused a user declaration that says exactly what the compiler
// already says — including `typealias CharSet = Set with Character`, which is byte-identical to
// `stdlib/CharacterSet.maxon:19` and which `specs/lazy-static.md` writes verbatim. Such a declaration
// OVERWRITES NOTHING, so it cannot produce the wrong-meaning defect the reservation exists to prevent (see
// `DeclaredTypeMeaning`, which carries the measurement), and refusing it was a false reject.
//
// ⚠ **THE NARROWING IS EXPRESSED ONCE, FOR THE WHOLE OWNED SET, AS A COMPARISON OF MEANINGS** — never as a
// per-name exception. `compilerOwnedTypeMeaning` answers `nominalIdentity` for every owned name but
// `CharSet`, and `typeMeaningsAgree` declines that arm against every input, so the twelve names it does not
// name stay refused BY THE COMPARISON. A name added to `isCompilerOwnedTypeName` therefore arrives fully
// reserved with nothing here to remember.
export function declarationContestsACompilerOwnedName(name ByteArray, declaredByTheCorpus bool, declares DeclaredTypeMeaning) returns bool
	if not isCompilerOwnedTypeName(name) or declaredByTheCorpus 'notAnOwnedNameFromAUserFile'
		return false
	end 'notAnOwnedNameFromAUserFile'

	return not typeMeaningsAgree(compilerOwnedTypeMeaning(name), declared: declares)
end 'declarationContestsACompilerOwnedName'

// --- Project: the compiler-wide shared state (Chunk C growth) ---
//
// GROWTH: this is the M1 `Project`. v1's `Project` has ~90 fields and ~28
// parser-written registries; shv2 starts with the minimum the `return 42` slice
// needs and grows one field/registry per milestone. The parse-staging design
// (PLAN.md) keeps the parser OFF this struct — a file parses into a
// `FileParseArtifact` (see ParseStaging.maxon) and `mergeArtifact` is the ONLY
// writer of the derived registries below (`funcReturnTypes`, `typeNames`), so
// per-file parse stays a pure function and the registries are rebuilt
// deterministically from artifacts on every `queryAllModule` miss.

// Registry: qualified function name -> its declared return type. The M1 example
// of the parse-staging registry set (v1's grows to ~28). Populated by
// `mergeArtifact` from each file's artifact; resolved in place by TypeResolution;
// read by SemanticCheck to locate `main` and validate its return type.
export typealias FuncReturnTypeMap = Map with (ByteArray, MaxonReturnType)

// One PARAMETER declared at a parameterized existential, and the `Base with Args` instance its declared type
// named (W58) — see `FuncSignature.paramExistentialSites` for why the position rides the entry instead of the
// column being dense.
export type ParamExistentialSite
	export var position as ParamCount
	export var instance as GenericInstanceId

	export static function create(position ParamCount, instance GenericInstanceId) returns Self
		return Self{position: position, instance: instance}
	end 'create'
end 'ParamExistentialSite'

export typealias ParamExistentialSiteArray = Array with ParamExistentialSite

// The COW anchors both existential columns start at, and the answer every reader gets for a slot that claims
// nothing — which is very nearly every slot. Homed here, beside the type they anchor, because BOTH the parser
// (which writes them) and SemanticCheck (which must hand the two argument checkers that hold no signature an
// honest empty column) name them. Never mutated: a writer builds a fresh array and returns it whole.
export let sharedEmptyParamExistentialSites = ParamExistentialSiteArray.create()
export let sharedEmptyReturnExistentialSites = GenericInstanceIdArray.create()

// The `Base with Args` instance parameter `position` was declared at, or `MapError.keyNotFound` for a parameter
// that named no generic alias — which is every parameter of almost every function, and is why the column is
// SCANNED rather than indexed (see `FuncSignature.paramExistentialSites`). A free function rather than a method
// because the two argument checkers that have no `FuncSignature` at all still ask it, of the shared empty.
export function paramExistentialSiteAt(sites ParamExistentialSiteArray, position ParamCount) returns GenericInstanceId throws MapError
	for site in sites 'each'
		if site.position == position 'thisOne'
			return site.instance
		end 'thisOne'
	end 'each'

	throw MapError.keyNotFound
end 'paramExistentialSiteAt'

// A function's parameter signature: the declared parameter NAMES (in declaration
// order) and their source-level TYPES (parallel, same order). The M5 parse-staging
// registry the call machinery needs — the return-type registry above answers "what
// does this callee return?", this answers "what does it take, and by what labels?".
// Param NAMES are the load-bearing field: a call reorders its labelled arguments
// (`add(2, b: 3)`) to the callee's declaration order by matching each `name:` label
// to the parameter position holding that name. Param TYPES back arity/type checking.
// (v1 homes the same data on a richer `FuncSignature` with defaults/companions; shv2
// carries only names + types until defaults and generics land.)
export type FuncSignature
	export var paramNames as ByteArrayArray
	export var paramTypes as MaxonTypeArray
	// ⭐ **OPEN #54 Slice B2 — THE PRE-ERASURE AGGREGATE IDENTITY A UNION PARAMETER LOSES.** One entry
	// per parameter: the interned NAME of a declared boxed union/enum parameter, or `EmptySourceText`
	// for everything else. It exists because a `union`/`enum` parameter is the one aggregate whose
	// identity does NOT survive to SemanticCheck — `resolveTypes` collapses its `named` tag to bare
	// `integer` (TypeResolution.resolveNamedType), the same erasure a ranged alias gets, so `paramTypes`
	// carries no name for it. A STRUCT keeps its `structRef(id)` through resolution, so its identity is
	// read straight off `paramTypes` and its slot here stays empty — the name is never stored twice.
	// The parser fills this at `recordFuncSignature`, BEFORE resolution runs, where the union is still
	// `named`; it travels by NAME (a `ByteArray`, no interner id — OPEN #52) so the merge fold needs no
	// remap and `syncResolvedSignature` carries it through untouched.
	export var paramAggregateNames as ByteArrayArray
	// ⭐ **THE PRE-ERASURE *SPELLING* OF A `named` PARAMETER — what an author WROTE, for diagnostics alone
	// (user ruling, 2026-08-04).** One entry per parameter: the interned name of any `named` parameter,
	// `EmptySourceText` for everything else.
	//
	// ⚠ **IT IS NOT A SECOND COPY OF THE COLUMN ABOVE, AND THE TWO ANSWER DIFFERENT QUESTIONS.** That one is
	// an IDENTITY — non-empty only for a registered boxed union/enum, and read to DECIDE whether two types
	// agree; this one is a SPELLING, non-empty for a ranged/float alias too, and read only to print. A ranged
	// alias must stay empty in the identity column (`takeInt(x Integer)` accepts any int-valued argument, and
	// a nominal comparison there would refuse it) and must be present here (`resolveTypes` collapses
	// `n Integer` to bare `integer`, so without it the refusal reads `expected 'int'` where
	// `specs/type-checking.md` pins `expected 'Integer'`). Both are derived from the SAME `paramTypes` array,
	// one entry per parameter and in the same order, so they cannot come to disagree about which parameter is
	// which — see `Parser.paramDeclaredNamesOf` and `Parser.paramAggregateNamesOf`.
	//
	// Travels by NAME like its sibling (a `ByteArray`, no interner id), so the merge needs no remap and
	// `syncResolvedSignature` carries it through untouched.
	export var paramDeclaredNames as ByteArrayArray

	// ⭐ **THE RETURN SLOT'S HALF OF THE IDENTITY COLUMN (BATCH18-b).** `funcReturnTypes` is RESOLVED — the same
	// `resolveTypes` that erases a union PARAMETER erases a union RETURN — so a function value handed to a
	// function type had no name to compare there either. MEASURED: `function() returns Color` accepted where
	// `function() returns Shade` was declared, and the two-arm `match` on the result fell off its end with
	// `STATUS_STACK_OVERFLOW`. One name rather than an array, because a function returns exactly one thing;
	// EMPTY for `void` and for every identity resolution preserves.
	export var returnAggregateName as ByteArray

	// ⭐⭐ **THE `with` ARGUMENTS AN EXISTENTIAL SLOT WAS DECLARED WITH, CARRIED ACROSS THE CALL BOUNDARY
	// (W58).** `ProgramSignatures.instanceDenotedType` collapses `Base with Args` over an interface base to a
	// bare `interfaceRef(Base)`, so a parameter declared `t IntTaker` arrives in `paramTypes` with nothing left
	// to say what `Taker`'s associated positions were bound to. W57 recovered that fact for the CALLEE's own
	// body by keeping it beside the value (`Parser.ValueExistentialInstanceMap`), which is the right home there
	// and is unreachable here: that column is per-function, keyed in the callee's OWN SSA space, and the
	// question this one answers is asked in the CALLER, about a parameter whose value does not exist yet.
	//
	// SPARSE, and empty for very nearly every function: a parameterized existential parameter is rare, and a
	// dense column would cost one entry per parameter of every function in the program to say "nothing" almost
	// every time. `ParamExistentialSite` carries its own position for that reason, so a reader scans a list
	// that is empty or has one or two entries rather than indexing a full-length one.
	//
	// Travels as a `GenericInstanceId`, which — unlike the two name columns above — is NOT interner-local: gids
	// index the whole-program `ProgramSignatures.genericInstances`, the same registry a value's own
	// `MaxonType.genericInstance` payload indexes across the merge. `syncResolvedSignature` carries both
	// columns through untouched, exactly as it does the aggregate ones.
	export var paramExistentialSites as ParamExistentialSiteArray

	// The RETURN slot's half of the column above — EMPTY, or the one instance the declared return type named.
	// An array rather than an option because a Maxon union VALUE is a heap box (`hasTypeParameterParam`'s
	// reason), and every signature in a generics-free program would mint one just to read "none".
	export var returnExistentialSites as GenericInstanceIdArray

	// ⭐⭐ **THE CONDITIONAL TYPE-EXTENSION CLAUSE OF THE DECLARATION THAT CLAIMED *THIS REGISTRATION NAME*
	// (ARR3b)** — the extra `where` constraints on top of the enclosing type's own, and so the second half of
	// the witness-slot count this function's ABI reserves. EMPTY for everything else, which is every function
	// in a program that declares no conditional type extension.
	//
	// ⛔⛔ **IT LIVES ON THE SIGNATURE BECAUSE THE QUESTION IS PER *REGISTRATION NAME* AND
	// `ProgramSignatures.extensionMethodConstraints` IS KEYED PER *DECLARED* NAME — one key, and a contested
	// set has several declarations behind it.** `Array.contains` is declared by `stdlib/Array.maxon`'s
	// `where Element is Equatable` extension AND by `stdlib/Interfaces.maxon`'s unconditional
	// `extension Iterable`, so D7 registers its members as `Array.contains#type parameter`,
	// `Array.contains#struct` and `Array.contains#Array.ElementPredicate` and NOBODY keeps the bare spelling.
	// The bare-keyed map then answered the SUPPLY side (`LowerMaxonToStd.witnessParamCountForCallee`) with
	// nothing at all while the body reserved a slot from its lexical clause — **MEASURED: the caller passed 3
	// arguments where the callee read 4, `bindImplicitParams` computed the layout descriptor's id as
	// `paramCount - witnessCount - 1` and landed on the WITNESS slot, and `[10].contains(10)` segfaulted
	// (0xC0000005).** The mirror shape is a same-file pair where the UNCONDITIONAL declaration is written
	// first and keeps the bare name: there the bare key answered with the CONDITIONAL sibling's clause and
	// every caller pushed a witness argument the callee never reserved.
	//
	// ⭐ **AND IT IS FILLED WHERE THE REGISTRATION NAME IS MINTED** (`Parser.parseFunction`), from the very
	// clause `Parser.openTypeExtensionBodyScope` opened the body with — so the reservation and the supply are
	// not two agreeing derivations, they are one recorded list read twice. A witness-slot count is ABI, and a
	// reservation and a supply that disagree is an argument-register mismatch nothing downstream can notice.
	//
	// Travels as a plain constraint list (interface names are `ByteArray`s, no interner id), so the merge fold
	// needs no remap and `syncResolvedSignature` carries it through untouched.
	export var extensionConstraints as WhereConstraintArray

	export static function create(paramNames ByteArrayArray, paramTypes MaxonTypeArray, paramAggregateNames ByteArrayArray, paramDeclaredNames ByteArrayArray, returnAggregateName ByteArray, paramExistentialSites ParamExistentialSiteArray, returnExistentialSites GenericInstanceIdArray, extensionConstraints WhereConstraintArray) returns FuncSignature
		return Self{paramNames: paramNames, paramTypes: paramTypes, paramAggregateNames: paramAggregateNames, paramDeclaredNames: paramDeclaredNames, returnAggregateName: returnAggregateName, paramExistentialSites: paramExistentialSites, returnExistentialSites: returnExistentialSites, extensionConstraints: extensionConstraints}
	end 'create'

	// The declared parameter count — the arity a call must match.
	export function paramCount() returns ParamCount
		return self.paramNames.count()
	end 'paramCount'

	// Does parameter 0 name the receiver (`__self`) — i.e. is this an INSTANCE method rather than a free
	// function or a receiverless static? THE one home of that fact (`parseTypeMember` records the receiver as
	// this name; see there): SemanticCheck reads it to self-offset a call's arguments from the source
	// parameter list, and LowerMaxonToStd reads it to source a layout descriptor from the receiver rather than
	// the constructor result. Two decisions that must agree on where the receiver is, so they read one bit.
	export function takesReceiver() returns bool
		return self.paramNames.count() > 0 and (try self.paramNames.get(0) otherwise panic("FuncSignature.takesReceiver: paramNames.count() > 0 but get(0) failed")).equals(SelfParamName)
	end 'takesReceiver'

	// Does any parameter declare a bare type parameter (`create(v T)`) — i.e. is this the SHARED body of a
	// generic type's method, whose signature cannot say what its arguments must be (P1.7)? The
	// allocation-free gate `checkTypeParameterArgs` asks before deriving the call's concrete instance, the
	// twin of `ProgramSignatures.hasInnerAliasParams`: a `CallGenericInstance` is a Maxon union VALUE and so
	// a heap box, and every call in a generics-free program would mint one just to read `none`.
	export function hasTypeParameterParam() returns bool
		for paramType in self.paramTypes 'each'
			if maxonTypeTag(paramType) == ValueTypeTag.typeParameter 'opaque'
				return true
			end 'opaque'
		end 'each'
		return false
	end 'hasTypeParameterParam'
end 'FuncSignature'

// Registry: qualified function name -> its parameter signature. Populated by
// `mergeArtifact` alongside `funcReturnTypes`; resolved in place by TypeResolution
// (its param types collapse `named`→concrete); read by SemanticCheck (call
// validation) and lowerCall (label→positional arg slotting).
export typealias FuncSignatureMap = Map with (ByteArray, FuncSignature)

// ⭐ **AN OVERLOAD SET — the bare SOURCE name a call is WRITTEN with ⇒ every REGISTRATION name that answers
// to it, in declaration order** (D7). shv2 registers the FIRST declaration of a name under the name itself
// and every later one under a mangled variant (`process`, then `process#String`), so the callee a call op
// carries is the bare name while the key `funcSignatures` holds a later overload under is not. This map is
// what turns one into the other, and `SemanticCheck.resolveOverloadedCalls` is its only reader.
//
// ⚠ **A CONTESTED EXTENSION METHOD PUTS NO MEMBER AT ALL UNDER THE BARE NAME (X-contains)** — every
// declaration of a `<Conformer>.<method>` that two files' extensions declare is registered under its
// parameter-type suffix. The bare name is still the KEY here and still the callee a call op carries; it is
// simply not one of the values. See `Parser.overloadRegistrationNameFor`.
//
// It is EMPTY for every program that overloads nothing, which is what keeps the resolver a single
// `isEmpty()` test on that overwhelming majority.
//
// ⚠⚠ **IT IS A UNION ACROSS FILES, AND SO IT IS IN `resetMergeTargets` — WHICH THIS HEADER USED TO ARGUE
// AGAINST (X-contains).** The argument was sound for what the map then held: one file declared every member
// of a set, so `commitOverloadSets` could UPSERT the whole value and a re-merge would REPLACE it. A
// cross-file set has no such file. Three files each declaring one member each know only their own, so the
// members have to ACCUMULATE — and the moment they accumulate, a warm rebuild that re-merges the same files
// would append every member a second time. `commitOverloadSets` dedups by name, so the doubling itself is
// inert; the reset is what keeps a member of a set the sources no longer declare from surviving the edit
// that deleted it. (The resolver's `funcSignatures` filter still makes such a leftover harmless — see
// `SemanticCheck.overloadCandidates` — but "harmless because a second mechanism catches it" is the
// arrangement this compiler keeps paying for.)
export typealias OverloadSetMap = Map with (ByteArray, ByteArrayArray)

// ⭐⭐ **WHICH MEMBER SATISFIES EACH WITNESS-TABLE SLOT — THE CONFORMANCE DECISION, WRITTEN DOWN ONCE (R10).**
// `witnessSlotImplKey(<conformer>, <interface>, <method>)` ⇒ the REGISTRATION name of the member
// `ConformanceCheck` accepted for that requirement. `LowerMaxonToStd.ensureWitnessTable` stamps the slot's
// `funcAbs64InRdata` relocation from this, instead of re-joining `<Type>.<method>` for itself.
//
// ⚠ **THE TWO SITES USED TO MINT THAT JOIN INDEPENDENTLY, AND THEY AGREED ONLY BY BOTH BEING WRONG.** Under
// D7 a later overload registers as `Type.method#Suffix` while the un-suffixed join spells the FIRST
// declaration, so a conformance satisfied by a later overload and a slot stamped with the bare name name
// DIFFERENT functions — a wrong `.text` address in the dictionary, no diagnostic, at runtime. Recording the
// selection is what makes them one value; a slot with no recording PANICS in the lowering rather than
// falling back to a second derivation (the one exception being a builtin conformer, which declares no
// `implements` and so has no conformance decision to record — see `ensureWitnessTable`).
//
// ⚠⚠ **IT IS IN `resetMergeTargets`, AND THE HEADER THAT SAID IT NEED NOT BE WAS DESCRIBING A DIFFERENT
// FUNCTION (found at the R10c review).** The claim was *"an UPSERT … so re-running REPLACES"*, which is
// `OverloadSetMap`'s property and not this map's: `ConformanceCheck.recordWitnessSlotImpl` does the
// opposite — it RETURNS EARLY when a key is already filed, because two routes reaching one slot must AGREE
// (that is what E3111 detects). So a stale entry is not inert, it WINS: on a warm rebuild whose sources
// changed which member satisfies a requirement, the previous compile's answer either contradicts the new
// one (a spurious E3111 about a member the source no longer declares) or, when the new selection is never
// filed, leaves the slot's relocation naming the STALE symbol — a wrong function pointer, silently.
//
// It resets beside `conformances` and `interfaces`, the two stores it is derived from, so the three cannot
// come to describe different programs. Within a single compile nothing changes: the map starts empty and
// `checkConformance` fills it before the pipeline runs, which is why no spec case moves — the corpus
// compiles each test in a fresh `Project` and has no mid-session source edit to express this with.
export typealias WitnessSlotImplMap = Map with (ByteArray, ByteArray)

// ⭐ **THE CHARACTER AN OVERLOAD'S REGISTRATION NAME JOINS WITH — and the reason it is not `$`.** The lexer
// admits only `[A-Za-z0-9_]` inside an identifier, so a `#` cannot appear in any name the source can write:
// a minted overload name can never collide with a declared one, the same construction `__` gives the
// reserved generic-instance space and `.` gives the witness label (ARCHITECTURE: "a symbol built by joining
// two names joins them with a character no name can hold").
//
// ⚠ It is NOT `$`, which shv2 already spends on joining a lifted closure to its enclosing function
// (`<enclosing>$closure_<k>`, and it NESTS). A second meaning for that character would make `f$closure_0`
// and `f$int` indistinguishable to anything reading a name — and `Parser.overloadRegistrationNameFor`
// mints a closure's enclosing name, so the two joins genuinely meet.
//
// ⚠ Every SUFFIX PART rides the same separator (`lookup#Registry#bool`), not a `_` join, because `_` IS in
// the identifier alphabet and an `_`-join over names is not injective — the exact trap
// `IrInterface.witnessTableLabel` documents. Uniqueness is nonetheless established by CONSTRUCTION rather
// than by that argument: `Parser.overloadRegistrationNameFor` will not hand back a name this file has
// already registered.
let OverloadNameSeparator = "#"

// Join a bare name and one already-rendered suffix into a registration name. THE one producer; the
// separator has no second speller.
export function overloadRegistrationName(base ByteArray, suffix ByteArray) returns ByteArray
	return "{String.from(base)}{OverloadNameSeparator}{String.from(suffix)}".toByteArray()
end 'overloadRegistrationName'

// ⭐ **AND ITS INVERSE: THE BARE NAME A REGISTRATION NAME WAS MINTED FROM** — `Array.contains` for
// `Array.contains#Element`. The FIRST separator is the join above; every later one is a suffix PART
// (`lookup#Registry#bool`), and a base can hold none of them because `#` is outside the identifier alphabet.
//
// A name carrying no separator comes back UNCHANGED, which is the answer and not a fallback: an unmangled
// registration name IS its own bare name. `bareMethodName` takes the same shape one join over.
//
// ⚠ One caller, and it is a diagnostic (`ParseStaging.duplicateFunctionMessage`): the name it must explain
// is one no declaration wrote, so it has to say what the author DID write. Kept beside the join for the
// reason every inverse in this file is — the separator has one speller.
export function overloadRegistrationBaseName(registered ByteArray) returns ByteArray
	let segments = String.from(registered).split(OverloadNameSeparator)
	return (try segments.get(0) otherwise String.from(registered)).toByteArray()
end 'overloadRegistrationBaseName'

// ⭐ **THE SUFFIX THAT MARKS A CONTESTED `static` MEMBER, AND WHY IT IS IN THE RESERVED SPACE.** A suffix part
// is otherwise a TYPE name or a PARAMETER name (`Parser.overloadTypeSuffix` / `overloadLabelSuffix`), and
// `Parser.requireUnreservedName` refuses a declaration of either under the `__` prefix (E2051) — so no legal
// overload set can render this one and contend for the key it makes. Declared ahead of its join for
// `OverloadNameSeparator`'s reason: the constant is the fact, and a reader who finds it wants the rule here.
let StaticMemberNameSuffix = "__static"

// ⭐⭐ **THE REGISTRATION NAME A TYPE'S `static` MEMBER TAKES WHEN AN INSTANCE MEMBER OF THE SAME TYPE WEARS
// THE SAME NAME** — `Box.getValue#__static` beside the instance's `Box.getValue`. The pair is NOT one
// overload set: with identical user parameter lists there is nothing in the arguments to select on, and the
// discriminator the language actually gives is SYNTACTIC — `Type.m(…)` means the static, `receiver.m(…)` the
// instance. So the two are two names.
//
// ⚠ **THIS IS THE MINT AND NOT THE DECISION.** Whether a declaration or a call takes this name is
// `ProgramSignatures.memberRegistrationKey`'s — THE one composition of the contest and this mint, and the only
// caller that should reach here. Everything else asks that.
//
// ⚠ **MINTED ON CONTEST ONLY, which is what leaves every emitted symbol in the tree exactly where it was.** A
// static whose name no instance member shares registers under the bytes it always did — and a static/instance
// pair is a shape that could not COMPILE before this rung (both declarations rendered one registration name
// and collided as E3006), so no program that has ever built holds one.
//
// It joins through `overloadRegistrationName` because the `#` separator has one speller, and it keeps the
// SOURCE name as its head so `overloadRegistrationBaseName` (which a duplicate diagnostic reads) still
// recovers `Box.getValue`.
export function staticMemberRegistrationName(sourceName ByteArray) returns ByteArray
	return overloadRegistrationName(sourceName, suffix: StaticMemberNameSuffix.toByteArray())
end 'staticMemberRegistrationName'

// ⭐ **THE NAME OF THE SYNTHESIZED NULLARY FUNCTION THAT PRODUCES PARAMETER `paramIndex`'s DEFAULT VALUE**
// (BATCH2 slice 4) — `__paramDefault#greet#0`. See `SignatureIndex.ParamDefaultInfo` for what the mechanism
// is and why a default is a FUNCTION rather than a replayed expression; this is only where its name is
// spelled.
//
// ⚠ **IT HAS EXACTLY ONE CALLER — the declaration SWEEP** (`Parser.recordScannedParamDefaults`), which
// publishes the name whole-program so a call site in any file can emit a call to it. The real parse, which
// synthesizes the helper's BODY, READS that published name back rather than minting a second time
// (`Parser.sweptParamDefaultHelperName`). It did mint its own, briefly, and the two derivations disagreed
// on the one input that differs between them — an instance method's receiver shifts every parameter's
// position by one — which surfaced as a backend `call to unknown function` with no source position at all.
// A name derived in one place cannot disagree with itself.
//
// `paramIndex` is the parameter's CALL-ALIGNED position (the receiver occupies 0 on an instance method),
// which is also the index `ParamDefaultInfo.producerFor` is asked with.
//
// It joins through `overloadRegistrationName` rather than re-spelling `#` — the separator has one speller —
// and it is unique by CONSTRUCTION: `funcName` is the name the DECLARATION registered under, which is unique
// whole-program (a second declaration of one name is E3006, and an overload member wears its own mangled
// registration name — `Parser.declaredParamDefaultHelperName` is what calls this with it), and the `__`
// prefix puts the result in the reserved space no declaration may enter (E2051), so it can collide with
// nothing the author writes. `#` is not in the identifier alphabet, so the two joins are injective by
// character class — the property ARCHITECTURE.md states for every symbol built by joining names.
//
// ⚠ This header said *"an OVERLOADED name is refused a default outright"* until W81, and W74 had already
// made that false — an overload set defaults whatever it likes, each member under its own registration name.
// The uniqueness argument survives the correction because it never rested on the refusal: it rests on the
// key being a REGISTRATION name.
export function paramDefaultHelperName(funcName ByteArray, paramIndex ParamCount) returns ByteArray
	return mintedHelperName(ParamDefaultHelperPrefix, head: funcName, tail: "{paramIndex}".toByteArray())
end 'paramDefaultHelperName'

// ⭐⭐ **THE SAME PARAMETER SLOT'S HELPER, ON ANOTHER MEMBER OF THE CALLEE'S OVERLOAD SET (W81)** — the
// question the stdlib reachability walk asks, because the helper call it sees is as PROVISIONAL as the base
// callee beside it. A short call is filled while it is parsed, from a registry keyed by the name the source
// wrote, so the emitted helper call names the SWEPT helper; `SemanticCheck.repointDefaultedArgHelpers`
// re-points it at the resolved member's own the moment the member is known. Between those two moments the
// name stands for a SET, exactly as the base callee does — see `StdlibSource.markReachable`, the one caller.
//
// ⚠ **IT TAKES THE SLOT OFF THE NAME RATHER THAN BEING HANDED ONE, and that is what makes it a re-key rather
// than a second mint.** The slot is already spelled in the helper it is given; re-deriving it from a
// `ParamDefaultInfo` would be the second derivation of one name this mint's header records a backend
// `call to unknown function` for.
export function paramDefaultHelperNameOnMember(helperName ByteArray, member ByteArray) returns ByteArray
	return mintedHelperName(ParamDefaultHelperPrefix, head: member, tail: splitMintedHelperName(helperName, prefix: ParamDefaultHelperPrefix, mint: "CalleeMint.paramDefaultHelper").tail)
end 'paramDefaultHelperNameOnMember'

// ⭐⭐ **THE JOIN ITSELF — the ONE place a `<prefix>#<head>#<tail>` helper name is built, for EITHER mint
// (W81 review).** The parameter mint's two doors above and the field mint one door down differ only in which
// prefix they carry and where the two halves come from; `splitMintedHelperName`'s self-check re-joins what it
// split and must be re-joining by the SAME rule it is checking, or the check tests a rule nobody uses.
//
// ⛔ **IT WAS SPELLED THREE TIMES — the parameter join, the field join and that re-join — while the parameter
// mint's own header said "a second copy of the join is the thing this mint's header forbids".** Two of the
// three would have failed LOUDLY had the shape moved (the re-join's panic), but the field mint would have
// gone on minting the old shape silently, and the property this file's headers rest on — that a helper name
// is derived in exactly one place — was not true of the file that asserted it.
function mintedHelperName(prefix ByteArray, head ByteArray, tail ByteArray) returns ByteArray
	return overloadRegistrationName(overloadRegistrationName(prefix, suffix: head), suffix: tail)
end 'mintedHelperName'

// ⭐ **IS `callee` ONE OF THE PARAMETER MINT ABOVE? (W81)** — the gate the reachability walk asks before it
// decodes a name, since `splitMintedHelperName` panics on anything this mint did not produce. It reads the
// prefix for `isFieldDefaultHelperName`'s reason one door down, and lives beside the join so the prefix keeps
// its one speller.
export function isParamDefaultHelperName(callee ByteArray) returns bool
	return bytesStartWith(callee, prefix: ParamDefaultHelperPrefix)
end 'isParamDefaultHelperName'

// ⚠⚠ **`b"…"`, NOT A `String`, AND THAT IS A MEASUREMENT RATHER THAN A STYLE (W81 review).** Both this and
// the field twin below are read as BYTES at every one of their five uses, and both were `String`s asked for
// `.toByteArray()` at each — which is `managed.slice` + `ByteArray.init`, an allocation per ask. That put one
// allocation per CALL EDGE inside `StdlibSource.markReachable`, the demand walk's inner loop, and one per
// call op inside `LowerMaxonToStd.materializeLayoutArgFor`.
//
// MEASURED on a 400-function, 2,007-line program, same tree, two binaries differing only in this:
// `phase:deriveRuntimeNeeds` **15,003 → 7,539 allocations** (half the phase), whole compile **2,218,726 →
// 2,181,702 (−1.67%)** and **−1.63 MB**. That is the W81 ladder's whole "+1.18%, all in
// `deriveRuntimeNeeds` and the unbracketed region, +0 in every front-end phase" — it was never the widened
// mark; it was this.
//
// ⇒ It is also the ONE spelling of the prefix. A `String` beside a `b"…"` twin would buy the same allocation
// back as a second copy of the literal, which is the trade this file exists to refuse; the two panics that
// wanted a `String` take `String.from(prefix)` at the panic instead, where the cost is a crash away.
let ParamDefaultHelperPrefix = b"__paramDefault"

// ⭐ **THE NAME OF THE SYNTHESIZED NULLARY FUNCTION THAT PRODUCES FIELD `fieldName`'s DEFAULT VALUE** (S2f)
// — `__fieldDefault#Bag#items`. See `FieldDefault.helper` for what the mechanism is; this is only where
// its name is spelled, and it is spelled HERE, beside the parameter twin, so the `#` join keeps its one
// speller.
//
// ⚠⚠ **UNLIKE THE PARAMETER TWIN, THIS IS MINTED BY BOTH WALKS OF A FIELD DECLARATION — AND THAT IS SAFE
// FOR A REASON THE PARAMETER MINT DOES NOT HAVE.** A parameter's helper is named by its CALL-ALIGNED
// POSITION, which the declaration sweep and the real parse compute from different starting points (an
// instance method's receiver shifts every parameter by one) — so exactly one of them may derive it and the
// other reads it back. A field's helper is named by `(type name, field name)`, and neither is positional:
// `Parser.readStructFieldInto` is THE one field reader, shared by `recordScannedType`'s tolerant sweep and
// `parseTypeDeclaration`'s parse, so the two walks put the identical two names in and get the identical
// name out, by construction. That matters because the LAYOUT a `Self{…}` reads its defaults out of is the
// SWEEP's, while the helper's BODY is parsed by the real parse.
//
// Unique by CONSTRUCTION, exactly as the parameter twin is: a type name is unique whole-program (a second
// declaration of one name is E3006) and a field name is unique within its type, so the pair is; the `__`
// prefix puts the result in the reserved space no declaration may enter (E2051); and `#` is not in the
// identifier alphabet, so the two joins are injective by character class.
export function fieldDefaultHelperName(typeName ByteArray, fieldName ByteArray) returns ByteArray
	return mintedHelperName(FieldDefaultHelperPrefix, head: typeName, tail: fieldName)
end 'fieldDefaultHelperName'

// ⭐ **IS `callee` ONE OF THE MINT ABOVE? (W43b)** — the question `LowerMaxonToStd.materializeLayoutArgFor`
// asks to tell the ONE receiverless callee whose layout descriptor is FORWARDED from its caller apart from
// the static generic constructor whose descriptor is read off its own result. It reads the prefix rather
// than a `CalleeMint`, because the mint is a parse-time fact and does not ride the op; it lives beside the
// join so the prefix keeps its one speller.
module function isFieldDefaultHelperName(callee ByteArray) returns bool
	return bytesStartWith(callee, prefix: FieldDefaultHelperPrefix)
end 'isFieldDefaultHelperName'

// `b"…"` for the parameter twin's measured reason — see its header; `isFieldDefaultHelperName` is the per-op
// caller that was paying the same allocation.
let FieldDefaultHelperPrefix = b"__fieldDefault"

// ⭐ **THE INVERSE OF THE PARAMETER MINT: WHICH CALL DID THE AUTHOR ACTUALLY WRITE?** A helper call is a
// call the author wrote NO part of — they wrote `greet()`, and the compiler supplied the argument — so a
// diagnostic that quoted `__paramDefault#greet#0` would name a symbol absent from the program, which is the
// defect class D11c is on the board for. Every consumer asks THIS rather than decoding the name itself
// (`SemanticCheck.callDiagnosticNoun`), and it lives beside the join so the two cannot drift —
// `primitiveStaticSourceSpelling`'s arrangement exactly, one mint over.
export function paramDefaultCalleeSpelling(helperName ByteArray) returns ByteArray
	return splitMintedHelperName(helperName, prefix: ParamDefaultHelperPrefix, mint: "CalleeMint.paramDefaultHelper").head
end 'paramDefaultCalleeSpelling'

// ⭐ **AND THE INVERSE OF THE FIELD MINT (S2f)** — but the author wrote no CALL here at all: they wrote a
// `Self{…}` that omitted a field, and the compiler supplied its default. So the nearest thing to what they
// wrote is the FIELD, named the way every other diagnostic in the compiler names a type's member. It joins
// through `qualifiedMethodName` rather than re-spelling the `.`, for the reason the mint joins through
// `overloadRegistrationName`.
export function fieldDefaultCalleeSpelling(helperName ByteArray) returns ByteArray
	let parts = splitMintedHelperName(helperName, prefix: FieldDefaultHelperPrefix, mint: "CalleeMint.fieldDefaultHelper")
	return qualifiedMethodName(parts.head, methodName: parts.tail)
end 'fieldDefaultCalleeSpelling'

// The two names a minted helper name splits back into — `("greet", "0")` for `__paramDefault#greet#0`,
// `("Bag", "items")` for `__fieldDefault#Bag#items`. ONE record rather than two scans, because the single
// walk that locates the separators already knows both halves and a second walk would be a second answer.
type MintedHelperNameParts
	export let head as ByteArray
	export let tail as ByteArray

	export static function create(head ByteArray, tail ByteArray) returns MintedHelperNameParts
		return Self{head: head, tail: tail}
	end 'create'
end 'MintedHelperNameParts'

// ⭐ **SPLIT A `<prefix>#<head>#<tail>` HELPER NAME — the shared inverse of both mints above.** Written
// once because the two decodes differ in exactly two ways: which prefix they expect, and what they do with
// the pieces. Written twice, a later fix to the scan would reach one of them.
//
// ⭐ **AND IT CHECKS ITSELF AGAINST THE FORWARD JOIN RATHER THAN TRUSTING ITS OWN SPLIT.** The split takes
// everything between the FIRST separator and the LAST, which is exact only while the prefix holds no
// separator and the trailing part is one run — re-joining the pieces and comparing turns those premises
// into a check the mint owns. `mint` names the `CalleeMint` arm entitled to ask, so a panic here says which
// call site is at fault rather than merely which name looked wrong.
function splitMintedHelperName(helperName ByteArray, prefix ByteArray, mint String) returns MintedHelperNameParts
	let separator = try OverloadNameSeparator.toByteArray().get(0) otherwise panic("splitMintedHelperName: OverloadNameSeparator is a one-byte literal")

	var firstSplit = helperName.count()
	var lastSplit = helperName.count()
	for i in 0 upto helperName.count() 'scan'
		if (try helperName.get(i) otherwise panic("splitMintedHelperName: helperName.get OOB at {i} inside its own count()")) != separator 'ordinaryByte'
			continue
		end 'ordinaryByte'
		if firstSplit == helperName.count() 'firstSeparator'
			firstSplit = i
		end 'firstSeparator'
		lastSplit = i
	end 'scan'

	if firstSplit == lastSplit 'fewerThanTwoSeparators'
		panic("splitMintedHelperName: '{String.from(helperName)}' holds fewer than two '{OverloadNameSeparator}' separators, so the '{String.from(prefix)}' mint cannot have produced it — only a call site the op marks `{mint}` may be asked")
	end 'fewerThanTwoSeparators'

	let head = try helperName.slice(firstSplit + 1, endIndex: lastSplit) otherwise panic("splitMintedHelperName: slice [{firstSplit + 1}, {lastSplit}) of a {helperName.count()}-byte name is in range by the indices just found")
	let tail = try helperName.slice(lastSplit + 1, endIndex: helperName.count()) otherwise panic("splitMintedHelperName: slice [{lastSplit + 1}, {helperName.count()}) is in range by the index just found")
	let remint = mintedHelperName(prefix, head: head, tail: tail)
	if not remint.equals(helperName) 'decodeDisagreesWithTheMint'
		panic("splitMintedHelperName: '{String.from(helperName)}' splits as ('{String.from(head)}', '{String.from(tail)}'), which the '{String.from(prefix)}' mint re-joins as '{String.from(remint)}' — the join and its inverse have come apart")
	end 'decodeDisagreesWithTheMint'

	return MintedHelperNameParts.create(head, tail: tail)
end 'splitMintedHelperName'

// Append one part to an overload suffix under construction — so a suffix's parts and the suffix's own join
// to the base name are the same character, stated once above.
export function overloadSuffixPart(suffix String, part String) returns String
	return "{suffix}{OverloadNameSeparator}{part}" if not suffix.isEmpty() else part
end 'overloadSuffixPart'

// ⭐ **THE THREE REGISTRIES A FUNCTION TYPE'S SHAPE IS LOOKED UP IN, PLUS THE INTERNER THAT NAMES IT — ONE
// CARRIER.** `TypeResolution.declaredFunctionShapeOf` answers "what shape is the function type this
// governing NAME denotes?" from `funcSignatures`+`funcReturnTypes` (a declared function or lifted closure)
// or `functionAliasShapes` (a function typealias), and a `MaxonType.function(id)` carries the id rather
// than the name, so `typeNames` is what turns one into the other. They travel together because every site
// that asks the question needs all four: SemanticCheck's doors, its indirect-call check, and the lowering's
// argument widening. Three loose parameters at each of those sites is three chances to pass a stale half.
export type FunctionTypeRegistry
	export let funcSignatures as FuncSignatureMap
	export let funcReturnTypes as FuncReturnTypeMap
	export let aliasShapes as FunctionShapeMap
	export let typeNames as TypeNameInterner

	export static function create(funcSignatures FuncSignatureMap, funcReturnTypes FuncReturnTypeMap, aliasShapes FunctionShapeMap, typeNames TypeNameInterner) returns FunctionTypeRegistry
		return Self{funcSignatures: funcSignatures, funcReturnTypes: funcReturnTypes, aliasShapes: aliasShapes, typeNames: typeNames}
	end 'create'
end 'FunctionTypeRegistry'

// ⭐ **ONE PAIR OF FUNCTION-TYPE NAMES CURRENTLY UNDER COMPARISON** — the cycle guard a STRUCTURAL descent
// into a nested function type needs. shv2 accepts a self-referential function alias
// (`typealias SelfFn = function(f SelfFn) returns Integer` compiles; the bootstrap refuses it as E2012), and
// two aliases may name each other, so comparing `A` against `B` can reach `A` against `B` again. Meeting a
// pair already under comparison is AGREEMENT: two recursive types are equal exactly when assuming they are
// equal contradicts nothing below, which is the only answer a cycle has and the one that cannot false-reject.
export type FunctionTypePair
	export let declaredName as ByteArray
	export let gotName as ByteArray

	export static function create(declaredName ByteArray, gotName ByteArray) returns FunctionTypePair
		return Self{declaredName: declaredName, gotName: gotName}
	end 'create'
end 'FunctionTypePair'

export typealias FunctionTypePairArray = Array with FunctionTypePair

// ⭐ **A RECORDED FUNCTION-VALUE MERGE awaiting whole-program signature agreement (P1.5 #81).** A ternary
// or match EXPRESSION whose arms are function values (`unary if c else binary`) needs every arm to name a
// function of the SAME type, but the parser cannot check it: a forward-referenced or cross-file arm's
// parameter types are in no registry the parser has at parse time. So the parser records the arms'
// governing NAMES (interner-free ByteArrays, keys into `funcSignatures`/`funcReturnTypes`), the anchor
// (the `if`/`match` position), the FILE (for the diagnostic), and whether it is a ternary (the E2028
// noun) vs a match (E3005). `checkValueMergeSignatures` drains these whole-program, after merge and
// BEFORE `resolveTypes` erases the alias names the diagnostic prints. The NAMES travel plain (no interner
// id — like `paramAggregateNames`), so the record survives the merge with no remap.
export type PendingFnMergeCheck
	export var armNames as ByteArrayArray
	export var line as LineNumber
	export var column as ColumnNumber
	export var filePath as FilePath
	export var isTernary as bool

	export static function create(armNames ByteArrayArray, line LineNumber, column ColumnNumber, filePath FilePath, isTernary bool) returns PendingFnMergeCheck
		return Self{armNames: armNames, line: line, column: column, filePath: filePath, isTernary: isTernary}
	end 'create'
end 'PendingFnMergeCheck'

export typealias PendingFnMergeCheckArray = Array with PendingFnMergeCheck

// WHICH DOOR a function VALUE met a declared function TYPE at. The rule is one — the two shapes must
// agree — so the only thing the whole-program drain needs from the site is which SENTENCE to write and
// which code to write it under: a cast is a cast rejection (E3009, the sibling of the cross-kind
// `castHasNoLegalConversion` refusal), everything else is a type mismatch (E3005, the sibling of every
// other door's refusal).
//
// The CALL-ARGUMENT door is deliberately absent. It is checked in place by `SemanticCheck.checkArgTypes`,
// which already holds both sides and already owns the sentence a bad argument earns; recording it here
// would be the same rule asked twice, and the reader's next question at an argument is WHICH argument.
export enum FunctionTypeDoor
	cast
	returned
	// A boxed union's PAYLOAD (`Box.held(twoArg)` at a `held(f OneArg)` case). It names a place — the payload
	// FIELD — but it is not assignment-SHAPED: the sentence reads "storing into union payload 'f'", not
	// "assigning to <noun> 'f'", because the construct is a union CONSTRUCTION and the field is not something
	// the program could assign to on its own. So it sits ahead of the contiguous assignment band rather than
	// being appended to it, exactly as this enum's own band rule below directs.
	payload
	// ⭐ **A FUNCTION-BACKED ENUM CASE (`tripleOp = tripleFn`) MEETING THE SIGNATURE ITS ENUM ALREADY FIXED.**
	// The declaration is not a place at all — no value flows through it — but the RULE is identical to every
	// door above: two function shapes that must agree, neither of which the parser can resolve. What the
	// enum's `.rawValue` hands back is ONE value carrying ONE governing name (the first case's function), so
	// a second case whose signature differs would be called through a promise it does not keep — the very
	// wrong answer this record exists to close, reached from a declaration rather than from an expression.
	// It names the CASE, so it is not assignment-shaped and sits ahead of the contiguous band below.
	enumCaseBacking
	// ⭐ **AN ARRAY LITERAL'S ELEMENT PAST THE FIRST.** The instance is keyed on ONE element type, so every
	// later element is read back at the FIRST one's shape; two function values differing in arity or return
	// type is the same wrong answer every door above closes, reached through `[a, b]`.
	//
	// ⛔ **MEASURED:** `[oneArg, twoArg]` then `.get(1)` compiled and ran, calling `twoArg` with an argument
	// nobody passed (E3122's own words). It has no later door — `Array` is parser-intrinsic, so a literal's
	// elements travel through runtime entries carrying no `FuncSignature` and `SemanticCheck`'s argument
	// doors never see them.
	//
	// ⚠ **THE MAP LITERAL IS NOT THIS DOOR, THOUGH IT LOOKS LIKE ITS TWIN.** `["k": v]` desugars to real
	// `Map.upsert` calls, so its columns are judged by `SemanticCheck.checkTypeParameterArgsAt` like any other
	// signatured call. A second door for them was built here and then measured away: it reported the same
	// mistake twice.
	containerElement
	// The ASSIGNMENT-shaped doors, which differ from each other only in what the place is CALLED. They are
	// arms of this enum rather than one `assigned` arm beside a noun STRING, and that is MEASURED, not
	// tidiness: a `String` noun threaded on from `Parser.assignableValue` into the door cost ONE ALLOCATION
	// PER ASSIGNMENT, per struct-literal field and per global store in the whole program — +1,852 in
	// `phase:parse` at scale rung 0, growing x1.96/x1.98/x1.99 with the corpus, on a path that records
	// nothing almost every time. It reads as the SAME number whether the door's guard sits at the caller or
	// inside the recorder, which is what identified the noun rather than the branch. A scalar carries the
	// same fact in a register and the ladder now reads allocation-identical to the parent;
	// `functionTypeDoorNoun` renders the word only where a diagnostic is actually built.
	//
	// They sit CONTIGUOUSLY at the end so the site that treats them uniformly covers them with one range
	// arm (`SemanticCheck.functionTypeDoorSite`) — the band discipline `StdOp` states in full. A new
	// assignment-shaped door is APPENDED here; a new non-assignment door goes before `variable`.
	variable
	global
	field
end 'FunctionTypeDoor'

// What an assignment-shaped door calls the place it writes into. Every site that names one — the
// function-type mismatch below, and `Parser.requireAssignable`'s three verdict arms — renders it from
// here, so a global and a field cannot come to be described two ways.
export function functionTypeDoorNoun(door FunctionTypeDoor) returns String
	match door 'd'
		variable then return "variable"
		global then return "global"
		field then return "field"
		// None of the rest takes a noun: a cast and a `return` ARE the construct, a payload and an enum case
		// name their own declaration ("union payload 'f'", "enum case 'tripleOp'"), and a container column
		// names no place at all. Every one of them is worded by `functionTypeDoorSite` without asking here, so
		// reaching this arm means a caller asked the wrong question of the door.
		cast to containerElement then panic("functionTypeDoorNoun: only the assignment-shaped doors name a place with a word — every other door words itself in `functionTypeDoorSite`")
	end 'd'
end 'functionTypeDoorNoun'

// ⭐ **THE PLACE AN ASSIGNMENT NAMES, WORDED THE WAY `specs/assignment.md` WORDS IT.** The noun comes from
// `functionTypeDoorNoun` directly above, so a global and a field still cannot come to be described two ways;
// what this adds is the NAME, and — for the one door whose name is ambiguous without it — the type that
// declares the field. `p.x = "hello"` is a mismatch at `field 'x' of 'Point'`, and `x` alone would not say
// which `x`, which is why the field arm takes an owner and the other two do not.
//
// ⚠ **RENDERED ONLY WHERE A DIAGNOSTIC IS BUILT**, under the same discipline as the noun: the doors thread a
// scalar ENUM plus the names they already hold, never a phrase, because this path is every assignment in the
// program and a String built per call is the +1,852 allocations `FunctionTypeDoor`'s header records.
export function assignedPlacePhrase(door FunctionTypeDoor, name ByteArray, owner ByteArray) returns String
	// The noun REFUSES a door that names no place, so asking for it first is also the guard: the only three
	// doors that reach the lines below are `variable`, `global` and `field`.
	let place = "{functionTypeDoorNoun(door)} '{String.from(name)}'"
	match door 'd'
		variable to global then return place
		field then break 'd'
		cast to containerElement then panic("assignedPlacePhrase: unreachable — `functionTypeDoorNoun` refused this door one line above")
	end 'd'

	if owner.isEmpty() 'ownerless'
		panic("assignedPlacePhrase: a FIELD is named `field 'f' of 'Owner'`, so the declaring type is not optional — a caller reaching this sentence through the field door must thread it")
	end 'ownerless'

	return "{place} of '{String.from(owner)}'"
end 'assignedPlacePhrase'

// ⭐ **A RECORDED FUNCTION-TYPE DOOR awaiting whole-program shape agreement.** A function value meeting a
// function-typed place — `f as Scaler`, `return twice` from a `returns Scaler`, `slot.op = twice` — must
// be a function of THAT type, and until this record existed only the `function` TAG was compared: every
// signature disagreement flowed through untouched and the call site then typed its call from a promise
// the callee does not keep (`intish as FloatFn` read an integer back out of the float return register).
//
// It is recorded rather than checked because the parser cannot answer it: a function value's own shape
// lives in the whole-program `funcSignatures`, which is not assembled until merge, and the shapes are
// compared RESOLVED, which is not true until `resolveTypes`. So the parser records the two governing
// NAMES (interner-free, keys into `funcSignatures`/`functionAliasShapes` — exactly `PendingFnMergeCheck`'s
// carrier), the door, the place's noun and name for the sentence, and the anchor;
// `SemanticCheck.checkFunctionTypeDoors` drains them.
export type PendingFunctionTypeDoor
	// The governing name of the VALUE that arrived — a function, a lifted closure, or a function alias.
	export var gotName as ByteArray
	// The governing name of the function TYPE the place declares — a function alias, or (for a place
	// typed by a `functionRef` value's own name) that function.
	export var declaredName as ByteArray
	export var door as FunctionTypeDoor
	// The NAME of the place written into, for an assignment-shaped door. EMPTY for a cast and a `return`,
	// which name no place — `door` is what decides whether it is read.
	export var placeName as ByteArray
	export var line as LineNumber
	export var column as ColumnNumber
	export var filePath as FilePath

	export static function create(gotName ByteArray, declaredName ByteArray, door FunctionTypeDoor, placeName ByteArray, line LineNumber, column ColumnNumber, filePath FilePath) returns PendingFunctionTypeDoor
		return Self{gotName: gotName, declaredName: declaredName, door: door, placeName: placeName, line: line, column: column, filePath: filePath}
	end 'create'
end 'PendingFunctionTypeDoor'

export typealias PendingFunctionTypeDoorArray = Array with PendingFunctionTypeDoor

// ⭐⭐ **A FUNCTION VALUE BOUND AT A COMPILER-OWNED POSITION WHOSE CONTRACT FIXES ITS ARITY (E3122).** The
// container `map`'s transform is the one such position: `map` is not an `Iterable` extension in shv2 but a
// hand-synthesized builtin (`Parser.parseContainerMap`), so its transform meets no DECLARED function type
// and passes through none of the THREE families that already compare two function shapes — every arm of
// `FunctionTypeDoor` (drained by `SemanticCheck.checkFunctionTypeDoors`), `SemanticCheck.checkOneArgType`'s
// function-argument arm for a DECLARED function-typed parameter, and `checkTypeParameterArgsAt`'s arm for a
// generic instance's SUBSTITUTED type argument. Each family is named by where it lives rather than by how
// many members it has: the count was written here as "five"/"four" and both numbers were stale within two
// ticks, which is this project's signature bug wearing a census. Until this
// record existed nothing checked it at all, and `nums.map(function(a Integer, b Integer) gives a + b)`
// compiled on every target and READ AN ARGUMENT NOBODY PASSED (see E3122's registry entry for the
// measurement, and `Parser.requireElementTransform` for the rule).
//
// ⛔ **DO NOT READ THE DOOR LIST ABOVE AS A CENSUS OF FUNCTION-VALUE POSITIONS — IT IS THE LIST OF DOORS,
// AND THE POSITIONS ARE FOUND ONE AT A TIME.** A union PAYLOAD declared with a function alias reached NO
// door at all: `Parser.requireScalarPayloadArg`'s only gate was `checkDeclaredType`, and `function` into
// `function` answers `ok` on the TAG alone — no shape compare, no arity. MEASURED 2026-08-04, the same two
// measurements that justify E3122, on a two-parameter function stored in a one-parameter payload and called
// through it: arm64-macOS prints `v=7` (the second argument is the leftover slot) and `wasm32-wasi` traps
// with the identical *"indirect call type mismatch"*. **CLOSED at BATCH18** — the payload is the `payload`
// door above, recorded like every other, and `first-class-function.error.wrong-signature-into-union-payload`
// pins it.
//
// Two further positions were reported UNVERIFIED alongside it. Both have since been MEASURED, and the report
// was right about one and WRONG about the other:
//
//   • a witness-dispatched interface ARGUMENT (`Parser.dispatchWitnessMethod`) — **TRUE**, and closed at
//     BATCH18. It checks arity (E3036) and labels and compared no argument TYPE anywhere, so `r.run("nope")`
//     at a `run(n Integer)` requirement compiled while the identical DIRECT call was already E3005;
//     `SemanticCheck.checkWitnessArgTypes` now routes those arguments through the shared `checkOneArgType`.
//   • a generic type PARAMETER bound to a function type (`SemanticCheck.checkTypeParameterArgsAt`) —
//     reported **FALSE** on the reasoning that *"the nominal half FIRES … and a function value cannot bind to
//     a type parameter at all"*. ⛔ **THE REFUTATION WAS ITSELF WRONG, AND RE-MEASURING IT COST A LIVE
//     MISCOMPILE.** The nominal half fires for every type argument that HAS a nominal identity, which is
//     exactly the group a function type is NOT in: `typeArgAggregateName` answers empty for it, correctly,
//     because a function type's identity is its SHAPE. And a function value binds to a type parameter
//     routinely — `generic-type-parameter-slots.function-value-element` is a committed case that does it
//     (`Holder with UnaryOp`, then `h.add(double)`), and a user `Box with UnaryOp` is the same shape.
//     MEASURED on that `Box`: `OpBox.create(floatFn)` compiled clean and `.held()` then called a float
//     function through an int calling convention. **CLOSED** — the substituted door now asks
//     `SemanticCheck.checkFunctionArgShape`, the same comparison `checkOneArgType`'s concrete arm makes.
//
//     ⛔ **IT DOES NOT COVER THE ARRAY LITERAL, WHICH IS PARSER-INTRINSIC** — `[a, b]` builds through
//     runtime entries with no `FuncSignature`, so its elements reach no argument door here and are checked by
//     `FunctionTypeDoor.containerElement` instead. ⚠ This entry has now been wrong three times: refuted by
//     reasoning, then re-claimed by reasoning (as "Map/Set never reach here", which is false — the corpus
//     `Map`'s methods are ordinary signatured calls), before each route was actually RUN. That is worth more
//     than any of the three facts: a position argued is not a position measured, in either direction.
//
// It is a SEPARATE record from `PendingFunctionTypeDoor` and not a sixth arm of it, because the two carry
// different facts. That one names a declared function TYPE and its whole shape must agree; this one has no
// declared type to name — `function(Element) returns Element` is a contract the compiler owns, whose return
// half is already decided in the parser by a rule `functionShapesAgree` cannot express
// (`Parser.elementTransformAnswersElement`: two structs both `structRef` are not the same element). So what
// is left to compare whole-program is the ARITY and the transform's PARAMETER against the element — the two
// facts below, which is why this carries the element alongside the arity rather than the arity alone.
//
// It is RECORDED rather than checked in place for `PendingFunctionTypeDoor`'s reason, and it is the reason
// the check cannot be a closure-literal rule: a function value's own parameter list lives in the
// whole-program `funcSignatures`/`functionAliasShapes`, which the parser does not have. `nums.map(twoArg)`
// carries no closure at all, and its `twoArg` may be declared in another file.
export type PendingTransformArity
	// The governing name of the function value that arrived — a lifted closure, a declared function, or a
	// function alias. Interner-free, exactly as `PendingFunctionTypeDoor.gotName`: a key into
	// `funcSignatures`/`functionAliasShapes`, resolved by `TypeResolution.requireFunctionShapeOf`.
	export var gotName as ByteArray
	// The arity the position calls with. A field rather than the literal 1 so the rule and the sentence
	// cannot come to disagree, and so a future `filter` can record its own.
	export var expectedArity as ParamCount
	// ⭐ **THE ELEMENT THE POSITION CALLS WITH, carried INTERNER-FREE as a `(tag, name)` pair** — exactly the
	// shape `FunctionTypeAlias` keeps its types in, and for the identical reason: a `TypeNameId` is FILE-LOCAL
	// until `mergeArtifact` remaps it, so a record that travels to the drain may carry no id at all.
	//
	// The tag is the element's PRE-resolution tag (a ranged alias is still `named` here), which is what the
	// container-slot half of `elementTypePreserved` is written against. The identity is EMPTY unless the
	// element is a STRUCT — see `Parser.resolvedElementIdentity` for why a union/enum element deliberately
	// carries none across this boundary.
	export var elementTag as ValueTypeTag
	export var elementIdentity as ByteArray
	// The container method whose contract states it, as the source spells it (`map`).
	export var methodName as ByteArray
	export var line as LineNumber
	export var column as ColumnNumber
	export var filePath as FilePath

	export static function create(gotName ByteArray, expectedArity ParamCount, elementTag ValueTypeTag, elementIdentity ByteArray, methodName ByteArray, line LineNumber, column ColumnNumber, filePath FilePath) returns PendingTransformArity
		return Self{gotName: gotName, expectedArity: expectedArity, elementTag: elementTag, elementIdentity: elementIdentity, methodName: methodName, line: line, column: column, filePath: filePath}
	end 'create'
end 'PendingTransformArity'

export typealias PendingTransformArityArray = Array with PendingTransformArity

// ⭐⭐ **A SITE THAT USES NONE OF A CALL'S RESULT, AWAITING THE WHOLE-PROGRAM VERDICT ON WHETHER THE CALLEE
// HAD ANY OTHER REASON TO RUN (E3064, `specs/tuple-assign.md`).** Recorded rather than checked in place for
// `PendingFunctionTypeDoor`'s reason and a sharper one of its own: whether a callee is PURE is a property of
// the whole call graph — its body, its callees, and their callees — and shv2's parser is a pure function of
// ONE FILE, so the callee's body may not even have been read yet when the site is found.
//
// ⚠ **THE ONLY DOOR THAT RECORDS ONE TODAY IS THE ALL-DISCARD TUPLE ASSIGNMENT** — `(_, _) = makePair(…)`,
// which names every target `_` and so uses nothing the call produced. The canonical language raises E3064 at
// two more doors (a bare `foo()` statement and `_ = foo()`), and shv2 raises it at NEITHER: both stand
// shelved with their reason in `specs-shv2/discarded-results.md`, and wiring them is a change of blast
// radius rather than a change of mechanism — this record and the summary that judges it serve all three.
export type PendingDiscardedResult
	// The callee whose result nobody took, as the CALL OP spells it — the key the effect summary is indexed
	// by, so it is the resolved name and not the source token.
	export var callee as ByteArray
	export var line as LineNumber
	export var column as ColumnNumber
	export var filePath as FilePath

	export static function create(callee ByteArray, line LineNumber, column ColumnNumber, filePath FilePath) returns PendingDiscardedResult
		return Self{callee: callee, line: line, column: column, filePath: filePath}
	end 'create'
end 'PendingDiscardedResult'

export typealias PendingDiscardedResultArray = Array with PendingDiscardedResult

// The outcome of slotting a call's arguments to its callee's parameter positions.
// `ordered` carries the arg SSA values in DECLARATION order (label reordering applied);
// every other arm is a call error the caller renders as a positioned diagnostic. This
// single result type is what lets SemanticCheck (which reports the error) and lowerCall
// (which consumes the ordered ids, `otherwise panic` since SemanticCheck already gated
// them) share one slotting algorithm rather than re-deriving the mapping twice.
export union ArgSlotResult
	ordered(argIds ValueIdArray)
	arityMismatch(expected ParamCount, got ParamCount)
	// Both arms carry a String: they exist only to be FORMATTED into a diagnostic.
	unknownLabel(argIndex ParamCount, label String)
	duplicateArg(argIndex ParamCount, paramName String)
end 'ArgSlotResult'

// ⭐ **THE CODE AND THE WORDS EACH SLOTTING FAILURE EARNS — declared beside `ArgSlotResult` so the two
// parties that render one cannot drift.** `SemanticCheck.validateCall` REPORTS these against a
// `funcSignatures` entry; `Parser.slottedWitnessArgs` THROWS them against an interface method's
// `paramNames` (P1.7a slice 2b-vi), which is in no signature registry because a witness dispatch has no
// callee name to register. Two mechanisms, one rule — so the text lives here rather than at either site.
// `callee` is already rendered: a qualified function name for a direct call, `<Interface>.<method>` for a
// witness dispatch, which is what that call actually binds against.
export function argArityMismatchMessage(callee String, expected ParamCount, got ParamCount) returns String
	return "'{callee}' expects {expected} argument(s) but {got} were provided"
end 'argArityMismatchMessage'

export function argUnknownLabelMessage(callee String, label String) returns String
	return "'{callee}' has no parameter named '{label}'"
end 'argUnknownLabelMessage'

export function argDuplicateMessage(callee String, paramName String) returns String
	return "duplicate argument for parameter '{paramName}' of '{callee}'"
end 'argDuplicateMessage'

// The declaration index of the parameter named `name` in `paramNames`, or `paramNames.count()` when no
// parameter carries that name (an unknown label). A linear scan — parameter counts are tiny, so no
// per-signature name→index map is worth its heap object (contrast v1's `nameToIndex`, which paid for one
// on every signature to serve method dispatch this milestone does not have).
//
// ⭐ **IT TAKES THE NAME LIST, NOT A SIGNATURE, BECAUSE THREE DIFFERENT RECORDS CARRY ONE** — a
// `FuncSignature` (SemanticCheck and lowering), a `ParamConsumeInfo` (the parser's consume transfer, which
// runs before any `FuncSignature` exists) and a `WitnessDispatchTarget` (an interface method, which is in no
// registry at all). Each of those grew its own copy of this scan; the list is the only thing the scan reads,
// so taking it directly is what collapses them to one.
function indexOfParamIn(paramNames ByteArrayArray, name ByteArray) returns ParamCount
	for i in 0 upto paramNames.count() 'each'
		let paramName = try paramNames.get(i) otherwise panic("indexOfParamIn: paramNames.get OOB at {i}")
		if paramName.equals(name) 'match'
			return i
		end 'match'
	end 'each'
	return paramNames.count()
end 'indexOfParamIn'

// Slot a call's `args` (in source order, each paired with its `argLabels` entry — the
// empty string for a positional argument) into the callee's DECLARATION order, given the
// callee's `paramNames`. A positional argument at index `i` fills parameter position `i`;
// a labelled argument `name: value` fills the position of the parameter named `name`. The
// parser has already enforced the label GRAMMAR (which arguments may carry one). Returns
// the reordered value list, or the first slotting error found (arity, unknown label, or two
// arguments targeting one parameter). THE one place the label→position mapping lives — shared
// by call validation, call lowering, the parser's consume transfer and witness dispatch.
// ⭐ **THE LABEL→POSITION MAPPING ITSELF, allocation-free** — a positional argument at index `i` fills
// parameter `i`; a labelled one fills the position of the parameter it names, which is
// `paramNames.count()` (one past the end) when no parameter has that name. That out-of-range answer is
// `indexOfParamIn`'s own not-found convention and is DECODED by the askers rather than re-derived:
// `slotCallArgs` turns it into `unknownLabel`, and the parameter-mutation edge builder skips the
// argument (a call whose labels do not resolve is reported by `slotCallArgs`, not by the summary).
//
// It is factored out because the mutation summary needs the mapping WITHOUT the slotted array
// (`SemanticCheck.addCallParamEdges` asks "which parameter does source argument `i` fill?" for a handful
// of arguments and would otherwise pay `slotCallArgs`'s two per-call buffers for every call in the
// program) — and because a second hand-written copy of `label.isEmpty() ? i : indexOfParamIn(label)` is
// exactly the drift that would let a call be summarised against one slotting and checked against another.
// ⭐⭐ **THE LABEL USUALLY NAMES THE PARAMETER AT ITS OWN POSITION, AND TESTING THAT FIRST IS WHAT
// KEEPS A CALL LINEAR IN ITS ARGUMENT COUNT.** `indexOfParamIn` is a scan of the whole name list, so a
// call written `f(a, b: b, c: c)` — Maxon's own spelling, labels in declaration order — costs
// `1 + 2 + … + P` comparisons, i.e. **O(P²) per call**, and this mapping is asked once per argument by
// `slotCallArgs`, again by `SemanticCheck.addCallParamEdges`, and again by
// `checkImmutableArgToMutatingParam`. One equality test against `paramNames[argIndex]` collapses the
// common case to **O(P) per call** and costs one comparison in the reordered case that still falls
// through to the scan.
//
// ⚠ **IT IS EXACTLY EQUIVALENT, NOT AN APPROXIMATION, AND THE REASON IS THAT PARAMETER NAMES ARE
// UNIQUE** — a repeated one is E2014 at the DECLARATION (`duplicate parameter name`, measured), so if
// `paramNames[argIndex]` equals the label then `indexOfParamIn` cannot answer any position but
// `argIndex`: there is no earlier match for it to find. A signature that DID carry a duplicate belongs
// to an already-refused program, so the tie-break could only change which diagnostic that program
// gets — the same reasoning `SemanticCheck.indexModuleFunctionsByName` states for first-index-wins.
//
// ⚠ **`_` IS THE ONE NAME A SIGNATURE MAY REPEAT, AND THE SLOTTING IS STILL EXACT.** The ignore name is
// exempt from that E2014 (`Parser.parseFunctionParameters` — the oracle accepts `make(_ Integer = 1,
// _ String = "n", item T)` and shv2 used to refuse it), so `paramNames` can carry several. It changes
// nothing here, because the ONLY way a repeat is observable is a call that LABELS `_`, and the loop
// below refuses the outcome directly: whichever `_` the scan picks, filling a slot twice is
// `ArgSlotResult.duplicateArg`. The oracle draws the line in the same place, reporting
// `parameter '_' already has a value (passed positionally)` at the CALL and nothing at the declaration.
// A call that does not label `_` never asks about it at all — a positional argument returns at the
// `label.isEmpty()` line above.
//
// MEASURED on `Testing/ladders/genmutchain.sh 1 256 <P>` (one chain, depth 256, every argument
// labelled in declaration order): `phase:semanticCheck` at P = 64 goes **69.8 ms -> 20.5 ms**, and the
// growth per doubling of P falls from **x3.05 to x1.89** while the program itself doubles at x2.00 —
// so the quadratic term is GONE rather than merely smaller. It also lands below the PRE-RUNG base
// (39.6 ms at P = 64), which had the same scan and paid it once instead of twice. Allocations are
// bit-identical on every rung of that ladder: this buys time and moves no memory.
export function argSlotPosition(paramNames ByteArrayArray, argIndex ParamCount, label ByteArray) returns ParamCount
	if label.isEmpty() 'positional'
		return argIndex
	end 'positional'

	let atOwnPosition = try paramNames.get(argIndex) otherwise EmptySourceText
	if atOwnPosition.equals(label) 'labelsInDeclarationOrder'
		return argIndex
	end 'labelsInDeclarationOrder'

	return indexOfParamIn(paramNames, name: label)
end 'argSlotPosition'

// ⭐ **`argDefaultSlots` IS THE COMPILER'S OWN ANSWER FOR THE ARGUMENTS IT SUPPLIED** — see `MaxonOp.call`.
// One entry per synthesized parameter default, and they are the TRAILING run of `args`, so the argument at
// `sourceCount + k` fills slot `argDefaultSlots[k]` and no name is consulted for it. Everything before
// `sourceCount` is the author's and resolves through `argSlotPosition` exactly as before. A caller with no
// synthesized defaults (every witness dispatch, every lowering) passes the shared empty array and this
// function behaves identically to the label-only version it replaced.
export function slotCallArgs(paramNames ByteArrayArray, args ValueIdArray, argLabels ByteArrayArray, argDefaultSlots ParamCountArray) returns ArgSlotResult
	let paramCount = paramNames.count()
	if args.count() != paramCount 'arity'
		return ArgSlotResult.arityMismatch(paramCount, got: args.count())
	end 'arity'

	// Fresh per-call buffers (paramCount is tiny); `filled` starts all-false so the
	// duplicate check below is sound, and `slotIds` is fully written iff every position
	// is filled exactly once — guaranteed once arity matches and no duplicate is found.
	var slotIds = ValueIdArray.create()
	var filled = BoolArray.create()
	for _ in 0 upto paramCount 'initSlots'
		slotIds.push(0 as ValueId)
		filled.push(false)
	end 'initSlots'

	// The author's arguments are everything before the compiler's trailing run of defaults. The subtraction
	// cannot underflow (`ParamCount` is unsigned, so it would be a range panic rather than a wrap): every
	// entry of `argDefaultSlots` was pushed by `Parser.fillArgsFromParamDefaults` in lockstep with an
	// argument APPENDED to this same list, so the column is never longer than `args`. That invariant is
	// stated where the column is declared (`MaxonOp.call`) and named here because this is where it is spent.
	let sourceCount = args.count() - argDefaultSlots.count()

	for i in 0 upto args.count() 'placeArgs'
		let argId = try args.get(i) otherwise panic("slotCallArgs: args.get OOB at {i}")
		let label = try argLabels.get(i) otherwise panic("slotCallArgs: argLabels.get OOB at {i}")

		// A SYNTHESIZED default names its slot outright; only a SOURCE-written argument is resolved by label.
		// That split is the whole fix for two `_` parameters: `_` binds nothing, so a signature may declare it
		// twice, and a name lookup then cannot tell the two apart (`MaxonOp.call`'s `argDefaultSlots`).
		let pos = (try argDefaultSlots.get(i - sourceCount) otherwise panic("slotCallArgs: argDefaultSlots.get OOB at {i - sourceCount} — the synthesized defaults are the trailing run of args")) if i >= sourceCount else argSlotPosition(paramNames, argIndex: i, label: label)
		if pos >= paramCount 'unknown'
			return ArgSlotResult.unknownLabel(i, label: String.from(label))
		end 'unknown'

		let alreadyFilled = try filled.get(pos) otherwise panic("slotCallArgs: filled.get OOB at {pos}")
		if alreadyFilled 'dup'
			let paramName = try paramNames.get(pos) otherwise panic("slotCallArgs: paramNames.get OOB at {pos}")
			return ArgSlotResult.duplicateArg(i, paramName: String.from(paramName))
		end 'dup'
		try slotIds.set(pos, value: argId) otherwise panic("slotCallArgs: slotIds.set OOB at {pos}")
		try filled.set(pos, value: true) otherwise panic("slotCallArgs: filled.set OOB at {pos}")
	end 'placeArgs'

	return ArgSlotResult.ordered(slotIds)
end 'slotCallArgs'

export type Project
	// Incremental query plumbing (source inputs + memo caches + dep graph).
	export var db as QueryDatabase
	// The checkout's `stdlib/` directory, located once at load time (`locateStdlibDir`). Read by the
	// stdlib loader, which enumerates it, and by nothing else — every later pass asks about a
	// FUNCTION, not a path (`isStdlibFunction`).
	export var stdlibDir as FilePath
	// Every file the stdlib loader parsed out of that directory — which is exactly "the STDLIB source
	// this compile contains", established by construction rather than by re-testing paths later (see
	// StdlibSource). Empty until the loader runs; it grows with the stdlib shv2 can load, and in the end
	// state it is every file under `stdlib/`.
	export var stdlibSourcePaths as MaxonSourcePathArray
	// What THIS compile knows about the stdlib source it loaded (`deriveStdlibFacts`), computed once
	// after the module is merged: which stdlib functions the program cannot reach, and which of the
	// ones it CAN reach need the x64-windows substrate. Every PRE-elimination pass that examines
	// function BODIES for a target/runtime decision — `scanRuntimeUsage`'s floor scan, `checkCalls`'s
	// E3104 target-support gate — consults it, so unreachable stdlib code decides nothing about a
	// program that does not contain it. Both halves are empty for stdlib-free code and neither ever
	// holds a USER function, so no user-only program's checks change.
	export var stdlibFacts as StdlibFacts
	// Declared function return types (the M1 parse-staging registry).
	export var funcReturnTypes as FuncReturnTypeMap
	// Declared function parameter signatures (names + types), keyed by name.
	// The M5 parse-staging registry the call machinery reads (see FuncSignature).
	export var funcSignatures as FuncSignatureMap
	// ⭐ Every OVERLOADED bare name in the program ⇒ its members' registration names (see OverloadSetMap for
	// what the two names are and why this one registry is not reset with the others). Empty unless the
	// program declares one name twice with different signatures.
	export var overloadSets as OverloadSetMap
	// ⭐ Which member `checkConformance` accepted for each witness-table slot (R10) — see WitnessSlotImplMap
	// for why the lowering reads this instead of re-deriving the impl symbol. Empty for every program that
	// declares no conformance.
	export var witnessSlotImpls as WitnessSlotImplMap
	// ⭐ Recorded function-value merges awaiting whole-program signature agreement (P1.5 #81). Filled by
	// `mergeArtifact` (each file's `pendingFnMergeChecks` appended in order); drained by
	// `checkValueMergeSignatures` before the pipeline runs. Reset with the other merge targets.
	export var pendingFnMergeChecks as PendingFnMergeCheckArray
	// ⭐ Recorded function-type doors awaiting whole-program shape agreement (see PendingFunctionTypeDoor).
	// Filled by `mergeArtifact` (each file's `pendingFunctionTypeDoors` appended in order); drained by
	// `SemanticCheck.checkFunctionTypeDoors`, which is AFTER `resolveTypes` because the shapes are compared
	// resolved — the one thing that keeps it out of `checkValueMergeSignatures`' pre-resolution sweep. Reset
	// with the other push-merge targets so a warm rebuild does not double it.
	export var pendingFunctionTypeDoors as PendingFunctionTypeDoorArray
	// ⭐ Recorded container-`map` transforms awaiting whole-program arity agreement (see
	// PendingTransformArity). Filled and drained exactly as `pendingFunctionTypeDoors` above, and after
	// resolution for the same reason: a lifted closure's signature is not in the registry until merge.
	export var pendingTransformArities as PendingTransformArityArray
	// ⭐ Recorded sites that used none of a call's result, awaiting the whole-program effect summary (see
	// PendingDiscardedResult). Filled and drained exactly as the two lists above.
	export var pendingDiscardedResults as PendingDiscardedResultArray
	// ⭐ THE TWO DEFERRED NAME DIAGNOSTIC LISTS (P1.9) — E3062 candidates and hidden `as` targets,
	// appended per file by `mergeArtifact` and drained, in this order, by
	// `TypeResolution.reportDeferredNameDiagnostics`. `DeferredNameDiagnostic` carries the argument for
	// why they are held back rather than reported where they are found. Reset with the other push-merge
	// targets so a warm rebuild does not double them.
	export var unusedTypeAliasDiagnostics as DeferredNameDiagnosticArray
	export var hiddenTypeNameDiagnostics as DeferredNameDiagnosticArray
	// ⭐⭐ **THE DECLARATION-HYGIENE DIAGNOSTICS (E3012 unused, E3077 var-should-be-let), HELD BACK UNTIL
	// EVERY CHECK THAT COULD EXPLAIN THE BODY HAS RUN** — appended per file by `mergeArtifact` and drained
	// by `Compiler.reportBindingHygieneDiagnostics`, the last thing `compileToCodeResult` does — AFTER the
	// backend, which is where the reason lives and where the four measurements that fixed the position are
	// written down. ⛔ Moving the drain earlier re-breaks `type-casting.md`; read that header first.
	//
	// ⚠ **REPORTING THEM WHERE THEY ARE FOUND IS A MEASURED CASCADE, and it is why this list exists.** They
	// are decided at a function's `end` DURING THE PARSE, and the parser's diagnostics gate the pipeline
	// before `resolveTypes`/`semanticCheck` ever run — so `let x = 256 as Byte`, whose whole point is the
	// out-of-range cast, reported `unused variable: 'x'` and the E3005 it is a test OF never happened. 26
	// committed error-cases moved that way the first time locals were admitted, `type-casting.md` (a
	// canonical `/specs` port) among them. Both reference compilers defer for exactly this reason: v1 pushes
	// `PendingUnusedCheck` records and drains them in `SemanticCheck`, the bootstrap runs its scan after
	// type resolution.
	//
	// ⇒ **A body the compiler had a real complaint about never also reports its hygiene diagnostics**, which
	// is the drain's one rule (see there for why the suppression is whole-program rather than per function).
	export var bindingHygieneDiagnostics as DiagnosticArray
	// ⭐ Every declaration a type-name COLLISION was reported for (E3061/E3006,
	// `reportTypeNameCollision`) — the suppression set the unused-typealias drain reads, so one mistake
	// earns one diagnostic. Keyed by `fileScopedDeclKey`, per DECLARING FILE: a bare name would let one
	// file's duplicate `Byte` swallow another file's genuinely-unused one, two files being entitled to
	// declare that name (see `TypeNameRegistry`). Reset with `typeNameDecls`, whose walk is its only
	// writer.
	export var collidedTypeNames as CollidedTypeNameSet
	// Declared ranged typealiases, keyed by name (see RangedTypeAlias). The registry
	// TypeResolution resolves every `MaxonType.named` against.
	export var typeAliases as RangedAliasRegistry
	// Every declaration that minted a TYPE NAME, whatever keyword minted it (see TypeNameRegistry).
	// The one decider of "is this type name already declared?", which each per-kind registry above
	// structurally cannot answer — it sees only its own kind. Reset with the other merge targets: it
	// is FIRST-WINS, so a warm rebuild that re-merged the same files would report every declaration
	// in the program as a duplicate of itself.
	export var typeNameDecls as TypeNameRegistry
	// Range-check sites, keyed by function name (see FunctionRangeChecks) — P1.9. The parser
	// records every `as` cast into a ranged alias and every ranged `return`; `InsertRangeChecks`
	// (Std tier) reads this to emit the guards / E3005. Kept SEPARATE from `funcReturnTypes`
	// because that registry is COLLAPSED to primitives by `resolveTypes`, which discards the
	// alias name a check needs; this one is written once at merge and never resolved away.
	export var rangeChecks as RangeCheckPlanMap
	// Declared FUNCTION typealiases, keyed by name (see FunctionTypeAlias) — P1.5-A1. Its OWN registry,
	// not folded into `typeAliases`, because a function alias is not a ranged numeric one (see
	// FunctionTypeAlias). The parser reads it to resolve a function-typed place and to type an indirect
	// call's result.
	export var functionTypeAliases as FunctionTypeAliasMap
	// The RESOLVED shape of each function typealias (see FunctionShapeMap) — derived from the registry
	// above by `TypeResolution.resolveTypes`, not merged, so it is rebuilt whenever resolution runs and
	// there is no second copy of a declaration to keep in step.
	export var functionAliasShapes as FunctionShapeMap
	// Declared struct types, keyed by name (see StructLayout). The registry's OTHER half: a
	// `MaxonType.named` resolves against the aliases above OR against this, and a name in neither
	// is E3011.
	export var structTypes as StructLayoutMap
	// Declared enum/union types, keyed by name (see EnumLayout). The struct registry's twin: a
	// `MaxonType.named` naming a declared `enum`/`union` resolves to `integer` here (an enum value
	// is its i64 tag), and the parser reads the cases through the whole-program signature index.
	export var enumTypes as EnumLayoutMap
	// Declared `interface` types, keyed by name (see IrInterface) — P1.7a slice 1. Holds only
	// USER-declared interfaces; the stdlib protocol interfaces (Stringable, Hashable, …) are
	// synthesized on lookup (`builtinInterface`) rather than merged here, so they never ride the
	// merge/reset machinery. Read whole-program by `checkConformance`.
	export var interfaces as IrInterfaceMap
	// Declared `implements` conformances, one per `type X implements …` (see ConformanceDecl) —
	// P1.7a slice 1. An ARRAY, not a map: the conformance check drains it once whole-program, and a
	// type declaring conformance twice is two decls to report, not one to overwrite. Reset with the
	// other push-merge targets (`pendingFnMergeChecks`) so a warm rebuild does not double it.
	export var conformances as ConformanceDeclArray
	// ⭐ **THE MEMOIZED `type -> interfaces it declares` INDEX** derived from `conformances`
	// (P1.7a-existentials slice 1). Built on first ask by `ConformanceCheck.declaredConformanceIndex` and
	// reset with `conformances` itself, so the two cannot come to describe different programs. The
	// `…Built` flag is what distinguishes "not built yet" from "built, and this program declares none" —
	// `ProgramSignatures.arrayByteInstanceComputed`'s arrangement, and for its reason: an empty map is a
	// legitimate answer, so emptiness cannot double as the validity bit.
	export var declaredConformances as DeclaredConformanceMap
	export var declaredConformanceIndexBuilt as bool
	// Every `<Type> from "…"` construction the program writes (see LiteralInitSite), one per site, in
	// merge order. An ARRAY for `conformances`' reason: the check drains it once whole-program and two
	// constructions of one type are two positions to report. Read by `checkLiteralInitConformance`.
	export var literalInitSites as LiteralInitSiteArray
	// ⭐ **EVERY INSTANTIATION A BRACKETED LITERAL INFERRED (W41-lit)** — one per literal, in merge order,
	// an ARRAY for `literalInitSites`' reason. It is the PARSER-side half of
	// `ProgramSignatures.instantiationSites`, which holds the ones a `typealias` wrote; the two are read
	// together by `checkWhereConstraints`, because a `where` clause binds an instance however it was
	// spelled and a literal is the one spelling that writes no type name.
	export var inferredInstantiationSites as GenericInstantiationSiteArray
	// id <-> name table behind every `MaxonType.named`. Folded from per-file
	// artifact interners at merge time (see TypeNameInterner.maxon).
	export var typeNames as TypeNameInterner
	// Source span of every op in the whole-program Maxon module, parallel by op
	// index. Folded from the per-file artifact tables by `mergeArtifact`, in the
	// same source-path order the module itself merges. A MAXON-TIER table: the Std
	// and Target modules carry no spans (see SourceRangeTable). Read on the cold
	// path only — diagnostics and, later, LSP queries.
	export var opRanges as SourceRangeTable
	// Whether this build emits the green-thread async trace (`--async-trace`). Set by the driver right after the
	// project is loaded and read once, by `installGtRuntime`. A per-BUILD switch rather than a per-file one, so
	// it lives here beside `target` rather than on any artifact.
	export var asyncTrace as bool
	// ⭐ Whether this build emits the DebugStream producer (`--debugstream`). Set by the driver right after
	// the project is loaded, exactly as `asyncTrace` is, and a per-BUILD switch for the same reason — it
	// belongs beside `target`, not on any artifact. It is read at TWO seams and nowhere else: the LOWERING,
	// which appends an allocation's trace tag to its `__mm_alloc` call, and `buildCarriesDebugStream`, which
	// is where every later part — the `.data` slots, the producer install, the module flag the runtime
	// builders read, and through it the entry stub's `__ds_init`/`__ds_shutdown` — takes its one answer from.
	export var debugStream as bool
	// ⭐ The SOURCE TEXT of every `async <call>` spawn, keyed by its `asyncCall` op index — what E3073 quotes
	// back at the author (`'async heavyCompute(5)'`). SPARSE, unlike `opRanges`: only spawn sites have an
	// entry, so it is a map rather than a parallel array.
	//
	// ⚠ **IT IS A SIDE TABLE BECAUSE THE TEXT CANNOT BE RECOVERED LATER, AND BOTH OTHER ROUTES WERE MEASURED
	// DEAD.** Slicing the file at the op's own span does not work: `asyncCall`'s range is
	// `SourceRange.between(anchor, last: rparenTok)` and a PUNCTUATOR carries no byte offsets (`Token.startByte`
	// is 0 for every one), so the span's end byte is 0. Rebuilding the text from the op's own fields does not
	// work either — the arguments are `ValueId`s, so a literal `5` has no spelling left by then. The parser is
	// the last place the text exists, so it is captured there (`Parser.tokenTextFrom`, which lays each token at
	// the column its author wrote it) and carried here. Folded from the per-file artifact by `mergeArtifact`
	// with the same op offset `opRanges` uses. Cold path only.
	export var asyncSpawnSites as AsyncSpawnSiteMap
	// ⭐ Every `await` of a SERVICE REPLY in the program, by op index (SV2) — the seed set of the acyclic
	// blocking graph. Folded from the per-file artifact with the merge's op offset, exactly as
	// `asyncSpawnSites` is. EMPTY for every program that awaits no reply, which is every program with no
	// service in it, and the check reads that count as its own gate.
	export var serviceAwaitSites as ServiceAwaitSiteMap
	// ⭐⭐ **THE mm-trace TAG FOR A BOX THE PARSER MINTS THAT IS NOT ANY DECLARED TYPE'S** — an interpolated
	// part's scratch byte run, a closure's captured environment, and the one-slot cell a reassigned
	// by-reference parameter is promoted into. Keyed by the `__mm_alloc` call's own op index, SPARSE like
	// `asyncSpawnSites` (only those three sites have an entry), folded from the per-file artifact by
	// `mergeArtifact` with the same op offset.
	//
	// ⛔⛔ **IT IS A SIDE CHANNEL BECAUSE A TRACE TAG IS NOT A TYPE, AND THE FIRST ATTEMPT PROVED IT THE
	// HARD WAY.** The tag was briefly carried in the value's `nameId` — the slot `valueNameIds` holds and
	// the TYPE CHECKER reads — on the argument that every reader of that column is gated on the value's
	// tag. It is not: a promoted parameter cell then WAS of type `ParameterCell` for argument checking
	// (`expected 'Node', got 'ParameterCell'`, nine cases) and its real type stopped being visible to
	// field access (E2015, one more). A debugging LABEL and a semantic FACT may not share a slot; this
	// table is read by exactly one function (`LowerMaxonToStd.allocTagIndexOf`) and by nothing else in the
	// compiler.
	//
	// ⚠ **RECORDED UNCONDITIONALLY, never under `--debugstream`.** A parser artifact is CACHED across
	// builds and keyed on the file's content, not the build's flags — so a parser that recorded only when
	// traced would serve one build's artifact to the other. It costs one map entry per closure, per
	// interpolated part and per promoted parameter, and is READ only by a traced build.
	export var allocTagSites as AllocTagSiteMap
	// ⭐⭐ **`__DebugStream.nameId("…")` call op index ⇒ the LITERAL that call names.** The parser reads the
	// name off its own token and emits a `__ds_name_id` marker call carrying NO arguments, because the name
	// is not a value: materializing it as one would mint the `.rdata` String record and the runtime
	// allocation the whole zero-alloc trace tier exists to avoid. The bytes ride here instead, and
	// `LowerMaxonToStd` — the first tier holding the whole-program interner — turns the marker into the
	// constant index.
	//
	// ⚠ **A SIDE TABLE FOR `allocTagSites`' REASON, not for want of a place on the op.** A `MaxonOp.call`
	// has no payload slot for a name that is not a callee, and widening the op — or minting a variant — for
	// one intrinsic would put the cost on every call in every program. Its cost here is one map entry per
	// `nameId` call, in the programs that write one.
	//
	// ⚠ **RECORDED UNCONDITIONALLY, never under `--debugstream`**, for the exact reason stated above it: a
	// parser artifact is CACHED across builds and keyed on the file's content, not the build's flags.
	export var debugStreamNameSites as DebugStreamNameSiteMap
	// ⭐⭐ **THE COMPILE-TIME `element_size@24` STAMP OF A MANAGED-PRIMITIVE CALL'S CONTAINER (EC15)** —
	// what lets `inlineManagedPrimitives` emit ONE of `emitStrideDispatch`'s arms instead of forking on a
	// stride the compiler already knows. `Array with Integer` is 8 at compile time and the pass was emitting a
	// `loadIndirect` of the field, two compares and two branches at every element access in every program.
	//
	// ⚠⚠ **IT IS KEYED BY AN INDEX INTO THE *STD* MODULE'S `ops`, WHICH THE THREE MAPS ABOVE ARE NOT.**
	// `asyncSpawnSites` / `allocTagSites` / `debugStreamNameSites` are written by the PARSER against MAXON op
	// indices and folded per file by `mergeArtifact`; this one is written by `LowerMaxonToStd` against the Std
	// op it has just appended, and is never merged — there is one Std module per compile. The field name
	// carries that difference rather than leaving it to this comment.
	//
	// ⭐⭐ **WHY A SIDE TABLE AND NOT A FIELD ON THE OP: `StdOp.call` CARRIES `callee` AND `args` AND NO
	// TYPE.** The Std tier is deliberately type-free — a stride slot on `call` would be a container fact on
	// every call in every program — and the tier that still HAS the type is the lowering, which is where this
	// is written. The parser is one tier further up and knows it too, but it is NOT the producer: every
	// `__managed_*` call reaches Std through `appendRuntimeCall` / `appendThrowingCall`, so recording it there
	// is one complete door rather than an enumeration of the parser's several element-access sites.
	//
	// ⚠⚠ **THE KEY IS DURABLE BECAUSE `IrModule.ops` ALLOCATES INDICES BY `push` AND THE ONE PASS IN
	// BETWEEN NEITHER CLONES NOR REPLACES A CALL.** `insertRangeChecks` appends guard ops and splits blocks
	// (which moves `opRefs`, never ops). ⇒ every op index recorded here still names the very call the
	// lowering appended.
	//
	// ⭐ **EC17 SHORTENED THAT LIST RATHER THAN LENGTHENING IT.** `inlineLeaves` used to sit between the
	// write and the read as well, and what covered it was that **a leaf holds no call BY RULE**
	// (`LeafOpRole.calling` refuses the callee outright), so it could neither clone nor re-issue a managed
	// primitive. EC17 moved it to run AFTER `inlineManagedPrimitives` — i.e. after this table has been read
	// and spent — so a splice cannot reach a live key at all. The leaf rule still holds and is still what
	// makes the reorder safe in the OTHER direction (see `PassPipeline`'s `inlineManagedPrimitives` entry);
	// it is simply no longer this key's argument.
	//
	// ⚠⚠ **A STAMP IS RECORDED, NOT A VERDICT — AND THE STAMP IS NOT ALWAYS THE RECORD'S.** What may be
	// concluded from it is `strideDispatchPlanForStamp`'s to say, and the answer is not simply "this width":
	// a container declared over a TYPE PARAMETER is created at the machine-word slot inside a shared generic
	// body and read back under a SUBSTITUTED concrete type, so what is provable is
	// `actual ∈ {stamp, MachineWordBytes}`. That function carries the measurement (a byte-typed field
	// answering 0 where 7 is correct) and the three answers that survive it. The sign is part of the value
	// too (`LayoutDescriptor.elementStrideOf`: negative is `-(bits per element)`, a SUB-BYTE PACKED element
	// that must still go to the runtime) — a reader treating a negative stamp as an error rather than as a
	// width would specialize a packed array onto a byte access.
	export var stdOpElementStrides as StdOpElementStrideMap
	// (funcIndex, ValueId) -> Maxon OpIndex for every op-defined value in the
	// whole-program Maxon module (see ValueOrigin). Folded from the per-file artifact
	// tables by `mergeArtifact`, in the same source-path order the module merges. A
	// MAXON-TIER table read on the cold path only — today the backend's E5001
	// (register-pressure) diagnostic maps a Target ValueId back to its source span
	// through it; M6's ownership checker reuses it.
	export var valueOrigins as ValueOriginTable
	// The compile root: the file or directory this build was invoked on. Used to
	// derive per-file namespaces and the default output path.
	export var rootPath as FilePath
	// Target CPU/OS this build emits for.
	//
	// ⭐ **`let`, AND THAT IS LOAD-BEARING RATHER THAN TIDY.** `queryActiveTokens`' memo holds a
	// TARGET-DEPENDENT token stream under a key that is only the file's content hash, which is sound
	// exactly because a `Project` is aimed once and never re-aimed — two targets are two `Project`s
	// and two `QueryDatabase`s, so one cache can never be asked about a target it was not filled for.
	// It had been a `var` with no writer but `create`, which made the argument a survey of the
	// current source rather than a property of the type. Re-aiming a live `Project` now does not
	// compile; if it ever must, mix the target into that memo's key rather than deleting this word.
	export let target as Target
	// Accumulated user-facing diagnostics; a non-empty set fails the build.
	export var diagnostics as DiagnosticArray
	// ⭐ **THE USER CONSTRUCT THE DIAGNOSTICS REPORTED RIGHT NOW ARE ON BEHALF OF** — see
	// `LibraryBlame`. Ambient rather than a parameter on `reportDiagnostic` because the front-end
	// mappers reach that sink through ~200 `reportParseError` match arms, and threading a blame
	// through every one of them would put the rule in 200 places instead of one; it is SET at exactly
	// one site (`Queries.queryParseOps`' parse-failure arm) and cleared on the next line, so the only
	// diagnostic it can reach is the one that arm reports.
	export var libraryBlame as LibraryBlame
	// Backend rdata/global constant table, threaded to `buildBackend`. Empty for
	// the `return 42` slice (no floats / string literals / static globals yet).
	export var globalData as GlobalDataTable
	// Wall-clock attribution for this compile (see CompileTimings). It lives on
	// Project because Project is ALREADY threaded through every phase — the frontend
	// queries, the pass pipeline, and the backend all take it — so no pass needs a new
	// parameter merely to be timed, and each compile gets its own timings instead of
	// the per-file fan-out driver contending on a global.
	export var timings as CompileTimings
	// Allocation attribution for this compile (see CompileMemory) — the twin of
	// `timings`, phase for phase, and here for the same reason. The two are written
	// TOGETHER, from one `PhaseProbe`, so a phase can never be timed at one boundary and
	// metered at another; see PhaseProbe's header for why that is worth a type.
	export var memory as CompileMemory
	// WHICH COMPILE this is, on the DebugStream wire (see DebugTrace). Every trace event this
	// build emits carries it, so a run that compiles N units in one process reads back as N
	// timelines instead of one shuffled pile. Derived from the compile ROOT, not handed out by a
	// counter: a counter is shared mutable state, and this field exists precisely to survive the
	// day N compiles run at once.
	export var traceUnit as TraceUnit

	export static function create(db QueryDatabase, rootPath FilePath, target Target, stdlibDir FilePath) returns Project
		return Self{
			db: db,
			stdlibDir: stdlibDir,
			stdlibSourcePaths: MaxonSourcePathArray.create(),
			stdlibFacts: StdlibFacts.empty(),
			funcReturnTypes: FuncReturnTypeMap.create(),
			funcSignatures: FuncSignatureMap.create(),
			overloadSets: OverloadSetMap.create(),
			witnessSlotImpls: WitnessSlotImplMap.create(),
			pendingFnMergeChecks: PendingFnMergeCheckArray.create(),
			unusedTypeAliasDiagnostics: DeferredNameDiagnosticArray.create(),
			hiddenTypeNameDiagnostics: DeferredNameDiagnosticArray.create(),
			bindingHygieneDiagnostics: DiagnosticArray.create(),
			collidedTypeNames: CollidedTypeNameSet.create(),
			pendingFunctionTypeDoors: PendingFunctionTypeDoorArray.create(),
			pendingTransformArities: PendingTransformArityArray.create(),
			pendingDiscardedResults: PendingDiscardedResultArray.create(),
			// Aimed at the TARGET this project was created for, never the host — see `exitCodeHigh`.
			typeAliases: RangedAliasRegistry.create(target.os),
			typeNameDecls: TypeNameRegistry.create(),
			rangeChecks: RangeCheckPlanMap.create(),
			functionTypeAliases: FunctionTypeAliasMap.create(),
			functionAliasShapes: FunctionShapeMap.create(),
			structTypes: StructLayoutMap.create(),
			enumTypes: createEnumRegistry(),
			interfaces: IrInterfaceMap.create(),
			conformances: ConformanceDeclArray.create(),
			declaredConformances: DeclaredConformanceMap.create(),
			declaredConformanceIndexBuilt: false,
			literalInitSites: LiteralInitSiteArray.create(),
			inferredInstantiationSites: GenericInstantiationSiteArray.create(),
			typeNames: TypeNameInterner.create(),
			opRanges: SourceRangeTable.create(),
			asyncTrace: false,
			debugStream: false,
			asyncSpawnSites: AsyncSpawnSiteMap.create(),
			serviceAwaitSites: ServiceAwaitSiteMap.create(),
			allocTagSites: AllocTagSiteMap.create(),
			debugStreamNameSites: DebugStreamNameSiteMap.create(),
			stdOpElementStrides: StdOpElementStrideMap.create(),
			valueOrigins: ValueOriginTable.create(),
			rootPath: rootPath,
			target: target,
			diagnostics: DiagnosticArray.create(),
			libraryBlame: LibraryBlame.unblamed,
			globalData: GlobalDataTable.create(),
			timings: CompileTimings.create(),
			memory: CompileMemory.create(),
			traceUnit: traceUnitOf(rootPath)
		}
	end 'create'
end 'Project'

// Construct a fresh Project rooted at `rootPath` for `target`. The single
// constructor a driver needs; mirrors v1's `createProject` (which additionally
// seeds three empty memo sentinels — QueryDatabase.create owns those in shv2).
// `stdlibDir` is passed IN rather than located here so the project is born with a
// valid one: the stdlib loader reads it before the first pass runs, and a field
// that is briefly wrong is a field something can read while it is wrong.
export function createProject(rootPath FilePath, target Target, stdlibDir FilePath) returns Project
	return Project.create(QueryDatabase.create(target.os), rootPath: rootPath, target: target, stdlibDir: stdlibDir)
end 'createProject'

// ⭐⭐ **IS THE PROJECT ROOT ITSELF UNDER `stdlib/`? — ONE HOME, BECAUSE THREE RULES REST ON IT AND TWO
// OF THEM ARE EACH OTHER'S PROOF.** The question is `maxon-shv2 build stdlib/URL.maxon`: the user named
// a file inside the toolchain's own `stdlib/` as their project. Three separate rules turn on it, and
// each one used to spell it out for itself:
//
//   * `StdlibLoader.registeredPathsWhenTheRootIsInsideStdlib` — do not load a file the project already
//     registered, or every function in it collides with itself.
//   * `Queries.isStdlibSourceFile` — such a project keeps its OWN files as the USER's (A1t bar 2), so
//     only what the loader pulled in from outside the root is stdlib for VISIBILITY.
//   * `Queries.livesUnderStdlibDirectory` — but for the two `module`-visible `String` methods those same
//     files ARE under `stdlib/`, which is a fact about the PATH and not about visibility.
//
// ⚠ **THE THIRD ONE'S SOUNDNESS IS A CLAIM ABOUT THE SECOND, so a drift between their two spellings is
// not a style problem — it is a wrong answer with nothing to catch it.** `livesUnderStdlibDirectory` is
// derived (`isStdlibSource OR rootIsUnderStdlibDirectory`) and its proof is *"the two differ in exactly
// ONE situation: when the root is under `stdlib/`"* — i.e. exactly when THIS predicate is true. Written
// twice, one of them could be taught about symlinks, or case, or a trailing separator, and the proof
// would go on reading as if it held while the stdlib-only gate quietly refused `stdlib/URL.maxon` (or,
// the other way, opened for a user file). Written once, the proof is about one function.
//
// ⚠ `cwd` is passed IN, never probed here. `isStdlibSourceFile` already resolves the PATH against it and
// runs per file inside two O(files) loops, so probing again would put a second `Directory.currentPath()`
// on the per-file path — the shape `isStdlibSourceFile`'s own header rules out. Resolving at all is not
// optional: `isInside` compares SPELLINGS, so a relative `stdlib/URL.maxon` and an absolute one would
// otherwise be two different answers about one file.
export function rootIsUnderStdlibDirectory(project Project, cwd FilePath) returns bool
	return project.rootPath.resolve(cwd).isInside(project.stdlibDir)
end 'rootIsUnderStdlibDirectory'

// Append a diagnostic to the project's sink. The single funnel every reporting
// pass routes through, so diagnostic bookkeeping lives in one place — which is
// why the library-blame swap (`Diagnostic.blamedAt`) is applied HERE and not at
// each of the parse mappers, semantic checks and conformance checks that report.
export function reportDiagnostic(project Project, diagnostic Diagnostic)
	project.diagnostics.push(diagnostic.blamedAt(project.libraryBlame))
end 'reportDiagnostic'

// True once any diagnostic has been reported. The pipeline's error gate reads
// this after each pass to stop before lowering an invalid module.
export function projectHasErrors(project Project) returns bool
	return project.diagnostics.count() > 0
end 'projectHasErrors'

// Render every accumulated diagnostic, one per line, in report order. The driver calls this on the
// failure path so the exact `error EXXXX: ...` lines the spec compares against reach the user.
//
// ⚠ It writes through `emitDiagnosticLine` rather than to stderr directly, which is what lets a
// caller compiling IN PROCESS read the same bytes a subprocess would have printed — see that
// function, which owns the argument. There is no second route: the line ending is decided there too.
export function printDiagnostics(project Project)
	for diagnostic in project.diagnostics 'each'
		emitDiagnosticLine(diagnostic.render())
	end 'each'
end 'printDiagnostics'
