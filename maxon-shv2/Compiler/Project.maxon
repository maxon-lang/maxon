// Project.maxon — foundational compiler-wide types.
//
// THIN for maxon-shv2 M1. In v1 (`maxon-selfhosted`) this file also holds the
// ~90-field `Project` struct and its ~28 parser-written registries. shv2 splits
// that shared state into a per-file `FileParseArtifact` (see PLAN.md — parse
// staging), so the big `Project` struct + registries + `createProject` are a
// Chunk C deliverable that GROWS this file. What lives here now is the small set
// of foundational, cross-cutting types the type layer depends on that v1 happens
// to home in Project.maxon: the primitive-array aliases, the declaration
// `Visibility` tier, and the parser's `VarInfo` symbol-table record.
//
// GROWTH CONTRACT: Chunk C must ADD the `Project` struct and registries here —
// it must NOT redefine the symbols already defined below.

// Array aliases over primitives / String. Cross-cutting; used by the IR
// containers (StringArray for name lists, BoolArray for the compaction
// liveness bitmaps). v1 scatters these between Project.maxon and Parser.maxon;
// shv2 homes both here so the parser rebuild (Chunk C) doesn't re-declare them.
export typealias StringArray = Array with String
export typealias BoolArray = Array with bool

// Visibility tier of a top-level declaration. Stamped by the parser at
// declaration time; consumed by cross-file name resolution and the unused-export
// check. `file` is the default (positively widened to `module`/`global`).
export enum Visibility
	file
	module
	global
end 'Visibility'

// Ordinal of a union case (and, for a payload binding, the field index within
// that case's payload). Bounded by the max cases a union may declare.
export typealias CaseOrdinal = int(0 to 65535)

// VarInfo — one entry in a function's `Scope` symbol table.
//
// The parser tracks every local by its source-level `MaxonType`; that type is
// carried to lowerMaxonToStd, which resolves the concrete `StdType` (int vs
// float, width) through the typealias registry after resolution. The parser
// never branches on int-vs-float.
//
// `isSelfField` / `isPayloadBinding` mark the two non-slot binding shapes
// (self-field alias inside an instance method; match-arm payload binding on a
// union). Both are inert at M1 (no structs, no enums yet) but the record shape
// is kept whole so M9/M12 activate them without a struct migration.
export type VarInfo
	// A zero-copy slice of the source, straight off the declaring token — names are
	// KEYS, and ByteArray hashes/compares by content, so no String is ever built for one.
	export var name as ByteArray
	export var varType as MaxonType
	export var mutable as bool
	export var slot as VarSlot
	// The SSA ValueId this binding aliases, for M2's value-substitution model: a
	// `let`/`var x = <expr>` binds `x` directly to the ValueId its initializer
	// produced, so a reference to `x` resolves to that value at parse time and no
	// `x` op ever enters the IR (`let x = 42; return x` lowers identically to
	// `return 42`). Meaningful ONLY for value bindings — exactly like `fieldIndex`
	// for self-fields and `payloadFieldIndex` for payload bindings, it is 0 (unused)
	// for every other binding shape. When mutation + `mem2reg` land, the slot
	// model (above) supersedes this direct substitution.
	export var boundValue as ValueId
	// Ownership lattice kind for this binding — the M1 ownership scaffold's
	// per-binding attribute (see OwnershipKind in MaxonDialect.maxon). ALWAYS
	// `trivial` at M1 (all bindings are scalars); the Own tier (M6) sets it to
	// `owned`/`borrow`/`shared` during OwnershipInfer/EscapeAnalysis, and Scope's
	// per-frame owned-values list keys off it to place drops at scope exit.
	// Present-but-inert: designed in from the first commit, not retrofitted.
	export var ownership as OwnershipKind
	// ⭐ **THE ONE BIT WAVE C READS (static single-owner MOVES).** Set true when this binding has been
	// MOVED FROM — its owned heap value was transferred to another binding by a `let u = t` / `s = t`
	// whose RHS was a bare reference to it. A moved-from binding STAYS in `ownedBindings` (mid-stack
	// removal would desync the block/loop drop marks — see `reassignBindingValue`/`removeFromOwnedBindings`)
	// but is SKIPPED by `emitScopeDrops` (its value drops via its NEW owner, exactly once) and REJECTED
	// at EVERY use — a bare read, a field read/write through it, a method call on it (E3102 use-after-move,
	// via the one `Parser.requireBindingLive` guard both `parseVariableReference` and `requireStructBase`
	// ask). A FULL reassignment `t = <expr>` revives it (`reassignBindingValue` clears the bit — the
	// binding then owns the new value); a field store `t.x = …` is a USE, not a revive. Always false for a
	// trivial/scalar binding, because only an owned heap value is ever moved.
	export var movedFrom as bool
	// ⭐ **PARTIALLY MOVED (P1.3 slice 2 — a binding-match that moved a managed payload OUT of this
	// union).** Distinct from `movedFrom` in exactly one respect, and that respect is the whole reason it
	// is a second bit: a `partiallyMoved` union is REJECTED at every use (E3102 — a later `match`/read
	// would deref a nulled slot) via the SAME `requireBindingLive` guard, but it is STILL DROPPED at scope
	// exit (`emitScopeDrops` does NOT skip it). Its box, and any managed fields the match left in place,
	// are freed by its `__destruct_<U>` cascade — the moved-out slots were nulled, so the cascade skips
	// them. `movedFrom` means "another binding owns this value, drop nothing"; `partiallyMoved` means
	// "this binding still owns the box, but its contents may not be read again". Always false for a scalar
	// binding or a union whose match bound no managed payload.
	export var partiallyMoved as bool
	// True when this name is a self-field alias inside an instance method — the bare `width`
	// inside `function area()` of `type Rect`, which means `self.width`.
	//
	// Reads emit loadIndirect through `__self` at the field's offset; writes emit storeIndirect —
	// the SAME two ops `p.x` already rides (there is no `fieldLoad`/`fieldStore` op and there is
	// not going to be one; the memory band is the general pair, per StdDialect). Concretely they
	// ride the same two ROUTINES, `Parser.emitFieldLoad`/`emitFieldStore`, which is the stronger
	// statement and the one that matters: v1 has a SECOND pair of ops for this alias
	// (`selfFieldLoad`/`selfFieldStore`, receiver out-of-band) and paid for it twice — its
	// visibility walker inspects only the ordinary pair, so a bare-name access is structurally
	// invisible to E3014, and its closure lowering has to re-route because the hardcoded receiver
	// slot "would load garbage" inside one.
	//
	// ⭐ **IT CARRIES THE FIELD'S INDEX, NOT ITS OFFSET**, and that is what keeps the two spellings
	// on one path. The index IS the field's identity (see `FieldIndex`); the offset, the declared
	// type, the mutability and the `export` bit are all DERIVED from `(layout, index)` by the four
	// accessors `p.x` already asks. An offset here would answer only the first of those four, and
	// would answer it a SECOND time — `binding.fieldOffset` beside `layout.offsetOfField(index)`,
	// two numbers for one fact, with the write path left needing the index anyway to reach
	// `fieldMutable`. One number, one lookup, no column to keep in step.
	export var isSelfField as bool
	export var fieldIndex as FieldIndex
	// True when this name was introduced as a match-arm binding on a union
	// payload. Reads go through the local slot; writes are rewritten to a
	// payload store against the scrutinee + field index.
	export var isPayloadBinding as bool
	export var payloadScrutineeName as ByteArray
	export var payloadFieldIndex as CaseOrdinal
	// The union case this binding belongs to — different cases of the same
	// union have independent payload field types, so the case name is required.
	export var payloadCaseName as ByteArray

	export static function create(name ByteArray, varType MaxonType, mutable bool, slot VarSlot) returns VarInfo
		return Self{name: name, varType: varType, mutable: mutable, slot: slot, boundValue: 0, ownership: OwnershipKind.trivial, movedFrom: false, partiallyMoved: false, isSelfField: false, fieldIndex: 0, isPayloadBinding: false, payloadScrutineeName: EmptySourceText, payloadFieldIndex: 0, payloadCaseName: EmptySourceText}
	end 'create'

	// A self-field alias: the name of field `fieldIndex` of the enclosing type, bound at
	// instance-method entry. It materializes NO stack slot and aliases NO SSA value — a read is a
	// `loadIndirect` through the receiver and a write is a `storeIndirect`, so there is nothing for
	// either to hold. `slot`/`boundValue` are 0 and unread, exactly as `slot` is for a value
	// binding.
	//
	// `mutable` is FALSE, and that is not the field's mutability — it is this BINDING's, and the
	// two are different questions with different homes. `count = count + 1` is legal iff the
	// FIELD accepts a write, which is `StructLayout.fieldIsMutable(index)`, the one column
	// `c.count = 1` already asks. A `true` here would be that column copied onto every alias, free
	// to disagree with it; a `false` states the honest fact that no reassignment of the alias
	// itself is ever legal, and leaves the field's own answer where it lives.
	export static function createSelfField(name ByteArray, varType MaxonType, fieldIndex FieldIndex) returns VarInfo
		return Self{name: name, varType: varType, mutable: false, slot: 0, boundValue: 0, ownership: OwnershipKind.trivial, movedFrom: false, partiallyMoved: false, isSelfField: true, fieldIndex: fieldIndex, isPayloadBinding: false, payloadScrutineeName: EmptySourceText, payloadFieldIndex: 0, payloadCaseName: EmptySourceText}
	end 'createSelfField'

	export static function createPayloadBinding(name ByteArray, varType MaxonType, mutable bool, slot VarSlot, scrutineeName ByteArray, fieldIndex CaseOrdinal, caseName ByteArray) returns VarInfo
		return Self{name: name, varType: varType, mutable: mutable, slot: slot, boundValue: 0, ownership: OwnershipKind.trivial, movedFrom: false, partiallyMoved: false, isSelfField: false, fieldIndex: 0, isPayloadBinding: true, payloadScrutineeName: scrutineeName, payloadFieldIndex: fieldIndex, payloadCaseName: caseName}
	end 'createPayloadBinding'

	// Construct a value binding for M2's substitution model: `name` aliases the SSA
	// value `boundValue`. No stack slot is materialized (SSA substitution needs
	// none), so `slot` is 0 — a value binding never reads it. The slot-backed
	// constructors above stay the home of the future mutable/mem2reg model.
	export static function createValueBinding(name ByteArray, varType MaxonType, mutable bool, boundValue ValueId) returns VarInfo
		return Self{name: name, varType: varType, mutable: mutable, slot: 0, boundValue: boundValue, ownership: OwnershipKind.trivial, movedFrom: false, partiallyMoved: false, isSelfField: false, fieldIndex: 0, isPayloadBinding: false, payloadScrutineeName: EmptySourceText, payloadFieldIndex: 0, payloadCaseName: EmptySourceText}
	end 'createValueBinding'
end 'VarInfo'

export typealias VarInfoMap = Map with (ByteArray, VarInfo)

// A list of BINDINGS, held by reference (VarInfo is a heap `type`). Scope keeps the
// bindings a frame displaced in one; the parser keeps its mutable bindings in one.
// Both need the binding OBJECT rather than its name — see Scope's header for why a
// name cannot address a binding a nested block has shadowed.
export typealias VarInfoArray = Array with VarInfo

// --- Ranged typealiases ---
//
// `typealias Score = int(0 to 100)` — the declaration form nearly every real Maxon
// file opens with, and the reason `int` is almost never written bare in a type
// position. A DECLARATION, not an op: it contributes a registry entry, and
// TypeResolution collapses every `MaxonType.named(Score)` to the primitive below.
//
// TWO ALIASES OVER THE SAME RANGE ARE THE SAME TYPE — an alias creates no nominal
// distinction, so resolution needs only `underlying`. The BOUNDS are carried anyway
// because they ARE the alias's definition: they are what a narrowing conversion is
// checked against (the runtime range check — a later milestone), and a registry that
// forgot them would force that milestone to re-parse the declaration. This milestone
// emits no range check, so nothing reads them yet.
//
// `low`/`high` are INCLUSIVE and stored as the raw 64-bit pattern `ParsedInt` holds:
// `upto` (an exclusive upper bound) is normalized to `high - 1` at parse time so the
// registry has ONE representation, and an unsigned-domain bound such as `u64.max`
// rides as the signed value with the same bits (which is exactly how a cast against
// it must compare — see specs/ranged-typealias.md's sentinel case).
export type RangedTypeAlias
	export var name as ByteArray
	// The primitive the alias resolves to — the `int` / `float` keyword it was
	// declared over. What TypeResolution substitutes for `named(alias)`.
	export var underlying as MaxonType
	export var low as ParsedInt
	export var high as ParsedInt

	export static function create(name ByteArray, underlying MaxonType, low ParsedInt, high ParsedInt) returns RangedTypeAlias
		return Self{name: name, underlying: underlying, low: low, high: high}
	end 'create'
end 'RangedTypeAlias'

export typealias RangedTypeAliasArray = Array with RangedTypeAlias

// Registry: typealias name -> its declaration. Populated by `mergeArtifact` from each
// file's artifact (alongside `funcReturnTypes` / `funcSignatures`); read by
// TypeResolution to collapse `MaxonType.named` to a primitive.
export typealias RangedTypeAliasMap = Map with (ByteArray, RangedTypeAlias)

// --- Range-check sites (P1.9) — the parser's carrier for `InsertRangeChecks` ---
//
// ⭐ WHY A SIDE TABLE AND NOT A MARKER OP. A narrowing `as` cast has no value of its own — it
// RETAGS the operand and flows it on unchanged — so there is nothing for an IR op to define,
// and the two places that must be checked (a `as`-cast operand, and a ranged `return`'s value)
// are found by the parser at PARSE time, not by any later structural walk. A dedicated
// `MaxonOp` would ALSO force a new arm into every exhaustive `MaxonOp` match — including the
// escape-analysis functions the closures/async rung owns and is actively editing — so the cast
// is recorded HERE instead, keyed by the enclosing function's (unique) name, and resolved by
// the Std-tier `InsertRangeChecks` pass.
//
// The bounds live only in `typeAliases` (an alias resolves AWAY to its primitive before the
// pass runs), so a site carries the alias NAME and the pass looks the bounds up — the linchpin
// the "retain the alias" requirement exists for. `value` is the flat Std `ValueId` the operand
// carries (ids pass through `lowerMaxonToStd` verbatim), never a name string. `line`/`column`
// anchor the E3005 diagnostic and the runtime panic message on the source `as`/`return`.

// One `as`-cast into a ranged alias, recorded where it was written. `block` is the function-local
// BlockId the cast is EVALUATED in (the parser's on-the-fly-SSA current block at the `as`) — the guard
// must split THAT block, not the value's DEFINITION block. An int->int cast is a representational no-op
// with no Std op to anchor to, so without the block a cast of a value defined earlier (a parameter, or a
// value from a dominating block) would place its guard at the definition — which runs UNCONDITIONALLY,
// even when the cast sits in an unselected ternary arm / if-branch. BlockIds survive `lowerMaxonToStd`
// (blocks are cloned 1:1 keeping their id), so the Std pass finds the same block by id.
export type RangeCheckCastSite
	export var value as ValueId
	export var aliasName as ByteArray
	export var block as BlockId
	export var line as LineNumber
	export var column as ColumnNumber

	export static function create(value ValueId, aliasName ByteArray, block BlockId, line LineNumber, column ColumnNumber) returns RangeCheckCastSite
		return Self{value: value, aliasName: aliasName, block: block, line: line, column: column}
	end 'create'
end 'RangeCheckCastSite'

export typealias RangeCheckCastSiteArray = Array with RangeCheckCastSite

// One `return <expr>` in a function whose declared return type is a ranged alias. The pass
// finds the `ret` op by `value` and reports/guards against the function's `returnAliasName`.
export type RangeCheckReturnSite
	export var value as ValueId
	export var line as LineNumber
	export var column as ColumnNumber

	export static function create(value ValueId, line LineNumber, column ColumnNumber) returns RangeCheckReturnSite
		return Self{value: value, line: line, column: column}
	end 'create'
end 'RangeCheckReturnSite'

export typealias RangeCheckReturnSiteArray = Array with RangeCheckReturnSite

// ⭐ Per-function map from a generic-INSTANCE value's function-local `ValueId` to the NAME of the
// instance alias it came from (`WrapperA`) — the parse-time provenance the value's shared
// `GenericInstanceId` cannot recover (P1.6-C). The NAME (not an interned id) so it survives merge with
// no remap, exactly as `returnAliasName` does. SemanticCheck's per-instance argument check reads it off
// the RECEIVER argument to re-qualify a method's inner-alias parameter (`WrapperB.setTag`'s `t Idx` ⇒
// `WrapperB.Idx`). It rides `FunctionRangeChecks` because that is the ONE per-function side table the
// parser fills and `mergeArtifact` copies whole (keyed by function name, id-stable) — a second such table
// would be the same channel written twice.
export typealias ValueInstanceAliasNameMap = Map with (ValueId, ByteArray)

// Every range-check site in one function. `filePath` is stamped by `mergeArtifact` (the
// function's file); `returnAliasName` is EMPTY unless the function returns a ranged INT alias.
export type FunctionRangeChecks
	export var filePath as FilePath
	export var castSites as RangeCheckCastSiteArray
	export var returnAliasName as ByteArray
	export var returnSites as RangeCheckReturnSiteArray
	// P1.6-C — see `ValueInstanceAliasNameMap`. Empty for a function that constructs no generic instance,
	// which is every function outside the generics corpus.
	export var valueInstanceAliases as ValueInstanceAliasNameMap

	export static function create(filePath FilePath, castSites RangeCheckCastSiteArray, returnAliasName ByteArray, returnSites RangeCheckReturnSiteArray, valueInstanceAliases ValueInstanceAliasNameMap) returns FunctionRangeChecks
		return Self{filePath: filePath, castSites: castSites, returnAliasName: returnAliasName, returnSites: returnSites, valueInstanceAliases: valueInstanceAliases}
	end 'create'
end 'FunctionRangeChecks'

// Registry: function name -> its range-check sites. Populated by `mergeArtifact` from each
// file's artifact; read by `InsertRangeChecks` (Std tier). Keyed by name — unique per program
// (E3006) — so it survives the merge with no id remap, exactly like `funcSignatures`.
export typealias RangeCheckPlanMap = Map with (ByteArray, FunctionRangeChecks)

// ⭐ **A FUNCTION TYPEALIAS (P1.5-A1)** — `typealias UnaryOp = function(Integer) returns Integer`. It is
// its OWN registry, NOT a `RangedTypeAlias`, because a function alias names a function TYPE, not a ranged
// numeric one: a value of it is a code pointer (`TypeClass.function`), and `Parser.parseTypeReference`
// resolves a reference to it as `MaxonType.function`, never `named` — so it must never be mistaken for a
// ranged alias (the `typeClassOf`/`fieldStorageType`/`resolveNamedType` consumers of the ranged registry
// all read a numeric `underlying`, which a function alias has none of).
//
// For A1 it carries only the RETURN type (an indirect call needs it to type its result; arg-type/arity
// checking against the PARAM types is a later rung, so they are parsed-and-discarded, not stored). The
// return type is stored INTERNER-FREE — its TAG plus the NAME behind a `named`/`structRef` return (empty
// for a primitive) — so it rides the no-remap alias fold and re-interns cleanly into any reader's own
// interner (`Parser.functionAliasReturnType`). `returnTag == void` means the function returns nothing.
export type FunctionTypeAlias
	export let name as ByteArray
	export let returnTag as ValueTypeTag
	export let returnTypeName as ByteArray
	// ⭐ **THE `fn(P1, P2) returns R` DISPLAY STRING (P1.5 #81).** The full canonical signature — parameter
	// types included — computed at parse (where the param types are still in hand, with THIS file's
	// interner, so a `named` alias reads as `Integer`) and stored as a plain ByteArray. It is what lets a
	// function-value merge whose arm is a function-TYPED PARAMETER (`f UnaryOp`) be signature-compared:
	// shv2 carries no full function type on a value, and the return type alone cannot tell `fn(Integer)`
	// from `fn(Integer, Integer)`. Interner-free, so it rides the no-remap alias fold exactly as the
	// return type does; the whole-program merge check (`checkValueMergeSignatures`) compares it by NAME
	// against a declared function's display built the same way.
	export let display as ByteArray

	export static function create(name ByteArray, returnTag ValueTypeTag, returnTypeName ByteArray, display ByteArray) returns FunctionTypeAlias
		return Self{name: name, returnTag: returnTag, returnTypeName: returnTypeName, display: display}
	end 'create'
end 'FunctionTypeAlias'

export typealias FunctionTypeAliasArray = Array with FunctionTypeAlias
export typealias FunctionTypeAliasMap = Map with (ByteArray, FunctionTypeAlias)

// --- Declared struct types (P1.0r) ---

// The index of a field within its struct's declaration order. It IS the field's identity — the
// offset is derived from it (`StructLayout.offsetOfField`) rather than stored, so there is no
// second number to keep in step. Bounded by the fields a struct may declare.
export typealias FieldIndex = int(0 to 65535)

// The index of a case within its enum's declaration order — the enum twin of `FieldIndex`, and
// bounded the same way (the cases an enum may declare). It IS the case's identity: an enum RANGE
// arm is a slice of this index (OPEN #21), never of the tag, which is the whole point of storing
// cases in declaration order.
export typealias CaseIndex = int(0 to 65535)

// ⭐ **EVERY FIELD OCCUPIES ONE 8-BYTE SLOT, WHATEVER ITS DECLARED TYPE**, and this constant is
// that decision. It is not an alignment convenience: a struct FIELD of struct type is a POINTER
// (`valueTagToStdType(structRef)` → i64), so `sizeof(Outer{p Point, n Integer})` is 16 rather than
// 24 — which is exactly what `specs/sizeof.md` pins, and what makes the layout a function of the
// field COUNT alone. A packed layout would have to know each field's width, which is a Std-tier
// fact this Maxon-tier record deliberately does not carry.
let FieldSlotBytes = 8 as ByteOffset

// The size of a struct with NO fields. A zero-byte allocation would hand two distinct empty
// structs the SAME address (the bump allocator advances by nothing), so identity would collapse
// and a decref of one would free the other. One slot is the floor, and it costs a program that
// declares an empty struct exactly 8 bytes it will never read.
let EmptyStructBytes = FieldSlotBytes

// The value a field declaration supplies when a `Self{…}` literal omits it — `export var value = 0`.
//
// It carries the PAYLOAD only, never a type: the default's type IS the field's declared type, which
// `StructLayout.fieldTypes` already holds. For `= 0` the literal is what SET that type (there is no
// annotation to read); for `as Integer = 0` the annotation set it and the literal was CHECKED
// against it. Either way one field has one type in one column, so a default cannot come to disagree
// with the slot it fills.
//
// The payload is a `ParsedInt` for a float exactly as for an integer — a float literal's value IS
// its IEEE-754 bit pattern (see `Parser.parseFloatLiteral`), which is why a defaulted float costs no
// second column and no second decoder.
export union FieldDefault
	// The declaration supplies none: `export var x as Integer`. A literal that omits this field is
	// E3086, and that is the rule field defaults exist to relax.
	none
	literal(payload ParsedInt)
end 'FieldDefault'

export typealias FieldDefaultArray = Array with FieldDefault

// StructLayout — one declared `type T`: what it is called, and its fields IN DECLARATION ORDER.
//
// It is the struct twin of `FuncSignature` (parallel name/type arrays, a linear index-of lookup),
// and it is homed here for the same reason: it is a parse-staging registry entry, written by the
// parser into a `FileParseArtifact` and folded into `Project` by `mergeArtifact` — never touched
// by the parser on `Project` directly.
//
// ⚠ **IT LIVES IN TWO REGISTRIES, DELIBERATELY, AND THAT IS `RangedTypeAlias`'s ARRANGEMENT
// EXACTLY.** `ProgramSignatures.structOf` answers the PARSER, before any file is parsed, from the
// whole-program TOKEN sweep — because `p.x` needs the field's offset at PARSE time and the
// declaration may be below it or in another file. `Project.structTypes` answers TYPE RESOLUTION,
// after the real parse, and it is the AUTHORITY — a name in neither registry is E3011, and a
// tolerant token sweep must never own a veto (see SignatureIndex's `CalleeReturn.undeclared`).
// Two readers, two moments, one record type.
export type StructLayout
	export var name as ByteArray
	// Parallel arrays, in DECLARATION order: field `i` is called `fieldNames[i]`, is declared
	// `fieldTypes[i]`, accepts a write iff `fieldMutable[i]`, is reachable from outside the type
	// iff `fieldExported[i]`, and defaults to `fieldDefaults[i]`.
	// The declared type is NOT a resolved one — the sweep that records it cannot resolve anything
	// (the alias it names may be in a file not yet folded), and the parser resolves it at the use
	// site through the same `aliasOf` door the shift rule already asks.
	//
	// ⚠ **THE COLUMNS ARE NEVER APPENDED TO DIRECTLY — `addField` IS THE ONE WRITER**, and that is
	// what makes "the columns fell out of lockstep" unrepresentable rather than merely asserted. A
	// reader indexes all four by one `FieldIndex`, so a caller that pushed a name and forgot a
	// default would shift every later field's default onto the wrong field: a silent wrong answer
	// with no crash to find it by.
	export var fieldNames as ByteArrayArray
	export var fieldTypes as MaxonTypeArray
	export var fieldMutable as BoolArray
	// `export var n` vs `var n` — the visibility column, read by `Parser.requireFieldAccessible`
	// (E3014). It is the twin of `fieldMutable` in every respect: one bit per field, off the
	// declaring keyword, written only by `addField`, and read only through an accessor that
	// decodes it for one `FieldIndex`.
	export var fieldExported as BoolArray
	export var fieldDefaults as FieldDefaultArray
	// The GENERIC TYPE PARAMETERS this type declares (P1.6-A): `uses T` ⇒ `[T]`, `uses A, B` ⇒
	// `[A, B]`, empty for a non-generic type. Recorded IN DECLARATION ORDER — a `T` in a field/method
	// type is `typeParameter(POSITION)`, so the order IS the identity, and `Box with X` binds arg 0 to
	// the param at position 0. It rides on the layout (which already travels whole-program) so the
	// instantiation-site arity check reads it straight off `structOf`, needing no separate registry.
	export var typeParamNames as ByteArrayArray

	// An EMPTY layout, filled by `addField` (and, for a generic type, `recordTypeParams`). It does not
	// take the columns, deliberately: handing pre-built parallel arrays across a call boundary is
	// exactly the shape that lets one arrive short.
	export static function create(name ByteArray) returns StructLayout
		return Self{name: name, fieldNames: ByteArrayArray.create(), fieldTypes: MaxonTypeArray.create(), fieldMutable: BoolArray.create(), fieldExported: BoolArray.create(), fieldDefaults: FieldDefaultArray.create(), typeParamNames: ByteArrayArray.create()}
	end 'create'

	// Record the type's `uses` parameter names, in declaration order (P1.6-A). Replaces the column
	// wholesale rather than appending per name — the whole list is known at once (the `uses` clause is
	// parsed as a unit), and the parser and the tolerant sweep must record the SAME list.
	export function recordTypeParams(names ByteArrayArray)
		self.typeParamNames = names
	end 'recordTypeParams'

	// The number of generic type parameters (P1.6-A) — 0 for a non-generic type, the arity a
	// `Base with Args` instantiation must match.
	export function typeParamCount() returns FieldIndex
		return self.typeParamNames.count()
	end 'typeParamCount'

	// Append one declared field. THE one writer of the columns — every column, one push, so they
	// cannot drift.
	export function addField(fieldName ByteArray, declaredType MaxonType, mutable bool, exported bool, defaultValue FieldDefault)
		self.fieldNames.push(fieldName)
		self.fieldTypes.push(declaredType)
		self.fieldMutable.push(mutable)
		self.fieldExported.push(exported)
		self.fieldDefaults.push(defaultValue)
	end 'addField'

	// ⚠ **THE OOB PANIC SENTENCE BELOW IS REPEATED PER COLUMN, AND THE COPY IS FORCED BY THE
	// LANGUAGE, NOT CHOSEN.** `panic` takes a string LITERAL — `panic(msg)` for any String value,
	// even a `let`-bound one, is rejected outright ("panic requires a string argument", measured
	// against the bootstrap) — so the one text cannot be built by a shared helper and handed over.
	// A forced copy is worth saying so about: the cure for one-fact-twice is DERIVE > CHECK >
	// COMMENT, and this is the tier where only the comment is available. If `panic` ever takes an
	// expression, these collapse into one.

	// Does field `index` accept a write? `export var count` does; `export let version` does not, and
	// `c.version = 2` is E2013 (see `Parser.parseFieldAssignment`).
	export function fieldIsMutable(index FieldIndex) returns bool
		return try self.fieldMutable.get(index) otherwise panic("StructLayout.fieldIsMutable: fieldMutable.get OOB at {index} for `type {String.from(self.name)}`, which declares {self.fieldCount()} — every index handed out came from `indexOfField`")
	end 'fieldIsMutable'

	// Is field `index` reachable from outside this type? `export var n` is; a bare `var n` is not,
	// and `v.n` from anywhere but `type Value`'s own body is E3014 (see
	// `Parser.requireFieldAccessible`). The gate is the TYPE, not the file.
	export function fieldIsExported(index FieldIndex) returns bool
		return try self.fieldExported.get(index) otherwise panic("StructLayout.fieldIsExported: fieldExported.get OOB at {index} for `type {String.from(self.name)}`, which declares {self.fieldCount()} — every index handed out came from `indexOfField`")
	end 'fieldIsExported'

	// What field `index` defaults to when a `Self{…}` literal omits it.
	export function fieldDefault(index FieldIndex) returns FieldDefault
		return try self.fieldDefaults.get(index) otherwise panic("StructLayout.fieldDefault: fieldDefaults.get OOB at {index} for `type {String.from(self.name)}`, which declares {self.fieldCount()} — every index handed out came from `indexOfField`")
	end 'fieldDefault'

	export function fieldCount() returns FieldIndex
		return self.fieldNames.count()
	end 'fieldCount'

	// The declaration index of the field named `wanted`, or `fieldCount()` when the struct declares
	// no such field. A linear scan, for `FuncSignature.indexOfParam`'s reason and with its
	// measurement behind it: field counts are tiny, and a per-layout name→index map would be a
	// heap object per declared type bought to serve a handful of lookups.
	export function indexOfField(wanted ByteArray) returns FieldIndex
		for i in 0 upto self.fieldNames.count() 'each'
			let fieldName = try self.fieldNames.get(i) otherwise panic("StructLayout.indexOfField: fieldNames.get OOB at {i}")
			if fieldName.equals(wanted) 'match'
				return i
			end 'match'
		end 'each'
		return self.fieldNames.count()
	end 'indexOfField'

	// The byte displacement of field `index` from the box's PAYLOAD pointer — which is what
	// `__mm_alloc` returns, so the header is invisible here and the first field sits at 0.
	export function offsetOfField(index FieldIndex) returns ByteOffset
		return index * FieldSlotBytes
	end 'offsetOfField'

	// The payload bytes `__mm_alloc` must be asked for. THE one place the size is computed, so the
	// allocation and the field stores that fill it cannot come to disagree about how big the box is.
	export function sizeBytes() returns ByteOffset
		if self.fieldNames.count() == 0 'empty'
			return EmptyStructBytes
		end 'empty'
		return self.fieldNames.count() * FieldSlotBytes
	end 'sizeBytes'
end 'StructLayout'

export typealias StructLayoutArray = Array with StructLayout

// Registry: struct-type name -> its declaration. The twin of `RangedTypeAliasMap`, filled from
// each file's artifact by `mergeArtifact` and read by TypeResolution to turn `MaxonType.named` for
// a declared `type` into `MaxonType.structRef`.
export typealias StructLayoutMap = Map with (ByteArray, StructLayout)

// --- Union payload fields (P1.3 slice 1) ---

// One PAYLOAD FIELD of a `union`/`enum` case — `circle(radius Integer)` declares one named
// `radius` of declared type `named(Integer)`. Its SLOT is its position in the case's field list
// (`payload[j]` lives at byte offset `UnionTagBytes + j * FieldSlotBytes` in the box), so the
// index IS the slot and no second number is stored — the same "index is the identity" discipline
// `StructLayout.offsetOfField` rests on. The declared type is NOT resolved (the sweep that records
// it cannot resolve anything); the construct/extract sites resolve it through the same `aliasOf`/
// `enumOf`/`structOf` doors a struct field is resolved through, and reject the managed/float types
// slice 1 does not lower there.
export type PayloadField
	export let name as ByteArray
	export let declaredType as MaxonType

	export static function create(name ByteArray, declaredType MaxonType) returns PayloadField
		return Self{name: name, declaredType: declaredType}
	end 'create'
end 'PayloadField'

export typealias PayloadFieldArray = Array with PayloadField
export typealias PayloadFieldArrayArray = Array with PayloadFieldArray

// A boxed union is `UnionTagBytes` (the i64 tag at offset 0) plus `FieldSlotBytes` per payload slot
// of the WIDEST case. The tag is always i64 — an enum value is its i64 tag, boxed or not — so the
// tag store/load width is fixed here rather than derived, the one place it lives.
export let UnionTagOffset = 0 as ByteOffset
let UnionTagBytes = 8 as ByteOffset

// EnumLayout — one declared `enum`/`union`: what it is called, whether it is a `union` (the ONLY
// thing that separates the two — identical lowering, different diagnostic wording), and its cases
// IN DECLARATION ORDER.
//
// ⭐⭐ **THE PARALLEL-COLUMN SHAPE IS THE DERIVE-TIER FIX FOR OPEN #21** — the "one field with two
// meanings" hazard both reference compilers carry. The bootstrap's `IrEnumCase.Ordinal` is the
// auto-increment TAG counter that an explicit `= N` resets, and its range code once read it as a
// DECLARATION POSITION — a silent wrong answer (`ok = 500  notFound = 200` matched nothing). Here
// the case's DECLARATION INDEX is the array position (`indexOfCase`, derived, never stored) and the
// case's TAG is the `caseTags[i]` column. The two are SEPARATE BY CONSTRUCTION: no field can carry
// both, so a range arm reading the index against a tag-valued scrutinee — the exact bug — cannot be
// written. It is the enum twin of `StructLayout`'s field columns, and `addCase` is the SOLE writer
// for `StructLayout.addField`'s reason: a caller that pushed a name and forgot a tag would shift
// every later case's tag onto the wrong case.
//
// **TAGS ARE UNIFORMLY `ParsedInt` (i64), for int AND float backing.** An int-backed case's tag is
// its raw value; a FLOAT-backed case's tag is its IEEE-754 BIT PATTERN — the same representation
// `FieldDefault.literal` stores a float default as. An enum value is therefore always an i64 (the
// tag, or the float bits), matched by an i64 compare, so an enum needs no float register class and
// no second code path. (`.rawValue` — the accessor that would decode the bits back to a float — is
// a later rung.)
export type EnumLayout
	export var name as ByteArray
	// `union U` vs `enum E`. The lowering is identical; this bit only chooses the word a diagnostic
	// prints ("union" vs "enum"), which is exactly what `/specs` says separates the two for a
	// payload-free union.
	export var isUnion as bool
	// Parallel arrays, in DECLARATION order: case `i` is named `caseNames[i]`, carries tag
	// `caseTags[i]` and declares payload fields `casePayloads[i]` (empty for a payload-free case).
	// NEVER appended to directly — `addCase` is the one writer (see the header).
	export var caseNames as ByteArrayArray
	export var caseTags as ParsedIntArray
	// Per-case payload fields (P1.3 slice 1). `casePayloads[i][j]` is case `i`'s slot-`j` field; its
	// byte offset in the box is `UnionTagBytes + j * FieldSlotBytes`. Empty for `red`/`stay`; the
	// box is allocated iff SOME case carries a payload (`isBoxed`), and all cases of a boxed union —
	// payload-free ones included — take the boxed form (a bare tag in a box).
	export var casePayloads as PayloadFieldArrayArray

	export static function create(name ByteArray, isUnion bool) returns EnumLayout
		return Self{name: name, isUnion: isUnion, caseNames: ByteArrayArray.create(), caseTags: ParsedIntArray.create(), casePayloads: PayloadFieldArrayArray.create()}
	end 'create'

	// Append one declared case. THE one writer of all THREE columns, so they cannot drift — a caller
	// that pushed a name and forgot the payloads would shift every later case's payloads onto the
	// wrong case. A payload-free case passes an empty array.
	export function addCase(caseName ByteArray, tag ParsedInt, payloads PayloadFieldArray)
		self.caseNames.push(caseName)
		self.caseTags.push(tag)
		self.casePayloads.push(payloads)
	end 'addCase'

	// The payload fields of case `index`, in slot order — empty for a payload-free case.
	export function payloadsAt(index CaseIndex) returns PayloadFieldArray
		return try self.casePayloads.get(index) otherwise panic("EnumLayout.payloadsAt: casePayloads.get OOB at {index} for `{self.kindWord()} {String.from(self.name)}`, which declares {self.caseCount()} cases")
	end 'payloadsAt'

	// The number of payload slots case `index` declares.
	export function payloadArityAt(index CaseIndex) returns CaseIndex
		return self.payloadsAt(index).count()
	end 'payloadArityAt'

	// The union-wide MAX payload arity — the number of payload slots the box reserves, so every case
	// (narrow ones included) shares one allocation size. This is what makes the box's layout a
	// function of the WIDEST case, and it is what a narrow case's zero-fill fills up to.
	export function maxPayloadArity() returns CaseIndex
		var widest = 0 as CaseIndex
		for i in 0 upto self.caseCount() 'each'
			let arity = self.payloadArityAt(i)
			if arity > widest 'wider'
				widest = arity
			end 'wider'
		end 'each'
		return widest
	end 'maxPayloadArity'

	// Is this a HEAP-BOXED union — does SOME case carry a payload? A payload-free enum/union keeps
	// the bare-i64-tag representation P1.1b emits; only a payload-bearing one is boxed
	// (`8 + maxArity*8` bytes, tag@0). The one decider, so construct and match cannot disagree about
	// whether a value is a box or a bare tag.
	export function isBoxed() returns bool
		return self.maxPayloadArity() > 0
	end 'isBoxed'

	// The payload bytes `__mm_alloc` must be asked for: the tag word plus one slot per payload field
	// of the widest case. THE one place the box size is computed, so the allocation and the stores
	// that fill it cannot come to disagree about how big it is.
	export function boxSizeBytes() returns ByteOffset
		return UnionTagBytes + self.maxPayloadArity() * FieldSlotBytes
	end 'boxSizeBytes'

	// The byte offset of payload slot `slot` from the box pointer `__mm_alloc` returns — past the
	// tag word. The enum twin of `StructLayout.offsetOfField`.
	export function payloadSlotOffset(slot CaseIndex) returns ByteOffset
		return UnionTagBytes + slot * FieldSlotBytes
	end 'payloadSlotOffset'

	export function caseCount() returns CaseIndex
		return self.caseNames.count()
	end 'caseCount'

	// The name of case `index`.
	export function caseNameAt(index CaseIndex) returns ByteArray
		return try self.caseNames.get(index) otherwise panic("EnumLayout.caseNameAt: caseNames.get OOB at {index} for `{self.kindWord()} {String.from(self.name)}`, which declares {self.caseCount()} cases")
	end 'caseNameAt'

	// The tag of case `index` — its raw value (int backing) or IEEE-754 bit pattern (float backing).
	export function tagOfIndex(index CaseIndex) returns ParsedInt
		return try self.caseTags.get(index) otherwise panic("EnumLayout.tagOfIndex: caseTags.get OOB at {index} for `{self.kindWord()} {String.from(self.name)}`, which declares {self.caseCount()} cases")
	end 'tagOfIndex'

	// The declaration index of the case named `wanted`, or `caseCount()` when no case carries that
	// name. A linear scan for `StructLayout.indexOfField`'s reason: case counts are tiny.
	export function indexOfCase(wanted ByteArray) returns CaseIndex
		for i in 0 upto self.caseNames.count() 'each'
			let caseName = try self.caseNames.get(i) otherwise panic("EnumLayout.indexOfCase: caseNames.get OOB at {i}")
			if caseName.equals(wanted) 'match'
				return i
			end 'match'
		end 'each'
		return self.caseNames.count()
	end 'indexOfCase'

	// Does this enum declare a case named `wanted`?
	export function hasCase(wanted ByteArray) returns bool
		return self.indexOfCase(wanted) < self.caseCount()
	end 'hasCase'

	// The declaring keyword, for a diagnostic — `union` vs `enum`. One place, so a message can never
	// call the same declaration by both names.
	export function kindWord() returns String
		return "union" if self.isUnion else "enum"
	end 'kindWord'
end 'EnumLayout'

export typealias EnumLayoutArray = Array with EnumLayout

// Registry: enum/union name -> its declaration. The twin of `StructLayoutMap`, filled from each
// file's artifact by `mergeArtifact` and read by TypeResolution to resolve `MaxonType.named` for a
// declared `enum`/`union` to its integer representation (an enum value IS its i64 tag).
export typealias EnumLayoutMap = Map with (ByteArray, EnumLayout)

// --- Project: the compiler-wide shared state (Chunk C growth) ---
//
// GROWTH: this is the M1 `Project`. v1's `Project` has ~90 fields and ~28
// parser-written registries; shv2 starts with the minimum the `return 42` slice
// needs and grows one field/registry per milestone. The parse-staging design
// (PLAN.md) keeps the parser OFF this struct — a file parses into a
// `FileParseArtifact` (see ParseStaging.maxon) and `mergeArtifact` is the ONLY
// writer of the derived registries below (`funcReturnTypes`, `typeNames`), so
// per-file parse stays a pure function and the registries are rebuilt
// deterministically from artifacts on every `queryAllModule` miss.

// Registry: qualified function name -> its declared return type. The M1 example
// of the parse-staging registry set (v1's grows to ~28). Populated by
// `mergeArtifact` from each file's artifact; resolved in place by TypeResolution;
// read by SemanticCheck to locate `main` and validate its return type.
export typealias FuncReturnTypeMap = Map with (ByteArray, MaxonReturnType)

// A function's parameter signature: the declared parameter NAMES (in declaration
// order) and their source-level TYPES (parallel, same order). The M5 parse-staging
// registry the call machinery needs — the return-type registry above answers "what
// does this callee return?", this answers "what does it take, and by what labels?".
// Param NAMES are the load-bearing field: a call reorders its labelled arguments
// (`add(2, b: 3)`) to the callee's declaration order by matching each `name:` label
// to the parameter position holding that name. Param TYPES back arity/type checking.
// (v1 homes the same data on a richer `FuncSignature` with defaults/companions; shv2
// carries only names + types until defaults and generics land.)
export type FuncSignature
	export var paramNames as ByteArrayArray
	export var paramTypes as MaxonTypeArray
	// ⭐ **OPEN #54 Slice B2 — THE PRE-ERASURE AGGREGATE IDENTITY A UNION PARAMETER LOSES.** One entry
	// per parameter: the interned NAME of a declared boxed union/enum parameter, or `EmptySourceText`
	// for everything else. It exists because a `union`/`enum` parameter is the one aggregate whose
	// identity does NOT survive to SemanticCheck — `resolveTypes` collapses its `named` tag to bare
	// `integer` (TypeResolution.resolveNamedType), the same erasure a ranged alias gets, so `paramTypes`
	// carries no name for it. A STRUCT keeps its `structRef(id)` through resolution, so its identity is
	// read straight off `paramTypes` and its slot here stays empty — the name is never stored twice.
	// The parser fills this at `recordFuncSignature`, BEFORE resolution runs, where the union is still
	// `named`; it travels by NAME (a `ByteArray`, no interner id — OPEN #52) so the merge fold needs no
	// remap and `syncResolvedSignature` carries it through untouched.
	export var paramAggregateNames as ByteArrayArray

	export static function create(paramNames ByteArrayArray, paramTypes MaxonTypeArray, paramAggregateNames ByteArrayArray) returns FuncSignature
		return Self{paramNames: paramNames, paramTypes: paramTypes, paramAggregateNames: paramAggregateNames}
	end 'create'

	// The declared parameter count — the arity a call must match.
	export function paramCount() returns ParamCount
		return self.paramNames.count()
	end 'paramCount'

	// The declaration index of the parameter named `name`, or `paramCount()` when
	// no parameter carries that name (an unknown label). A linear scan over the
	// name list — parameter counts are tiny, so no per-signature name→index map is
	// worth its heap object (contrast v1's `nameToIndex`, which paid for one on
	// every signature to serve method dispatch this milestone does not have).
	export function indexOfParam(name ByteArray) returns ParamCount
		for i in 0 upto self.paramNames.count() 'each'
			let paramName = try self.paramNames.get(i) otherwise panic("FuncSignature.indexOfParam: paramNames.get OOB at {i}")
			if paramName.equals(name) 'match'
				return i
			end 'match'
		end 'each'
		return self.paramNames.count()
	end 'indexOfParam'

	// Does parameter 0 name the receiver (`__self`) — i.e. is this an INSTANCE method rather than a free
	// function or a receiverless static? THE one home of that fact (`parseTypeMember` records the receiver as
	// this name; see there): SemanticCheck reads it to self-offset a call's arguments from the source
	// parameter list, and LowerMaxonToStd reads it to source a layout descriptor from the receiver rather than
	// the constructor result. Two decisions that must agree on where the receiver is, so they read one bit.
	export function takesReceiver() returns bool
		return self.paramNames.count() > 0 and (try self.paramNames.get(0) otherwise panic("FuncSignature.takesReceiver: paramNames.count() > 0 but get(0) failed")).equals(SelfParamName)
	end 'takesReceiver'
end 'FuncSignature'

// Registry: qualified function name -> its parameter signature. Populated by
// `mergeArtifact` alongside `funcReturnTypes`; resolved in place by TypeResolution
// (its param types collapse `named`→concrete); read by SemanticCheck (call
// validation) and lowerCall (label→positional arg slotting).
export typealias FuncSignatureMap = Map with (ByteArray, FuncSignature)

// ⭐ **A RECORDED FUNCTION-VALUE MERGE awaiting whole-program signature agreement (P1.5 #81).** A ternary
// or match EXPRESSION whose arms are function values (`unary if c else binary`) needs every arm to name a
// function of the SAME type, but the parser cannot check it: a forward-referenced or cross-file arm's
// parameter types are in no registry the parser has at parse time. So the parser records the arms'
// governing NAMES (interner-free ByteArrays, keys into `funcSignatures`/`funcReturnTypes`), the anchor
// (the `if`/`match` position), the FILE (for the diagnostic), and whether it is a ternary (the E2028
// noun) vs a match (E3005). `checkValueMergeSignatures` drains these whole-program, after merge and
// BEFORE `resolveTypes` erases the alias names the diagnostic prints. The NAMES travel plain (no interner
// id — like `paramAggregateNames`), so the record survives the merge with no remap.
export type PendingFnMergeCheck
	export var armNames as ByteArrayArray
	export var line as LineNumber
	export var column as ColumnNumber
	export var filePath as FilePath
	export var isTernary as bool

	export static function create(armNames ByteArrayArray, line LineNumber, column ColumnNumber, filePath FilePath, isTernary bool) returns PendingFnMergeCheck
		return Self{armNames: armNames, line: line, column: column, filePath: filePath, isTernary: isTernary}
	end 'create'
end 'PendingFnMergeCheck'

export typealias PendingFnMergeCheckArray = Array with PendingFnMergeCheck

// The outcome of slotting a call's arguments to its callee's parameter positions.
// `ordered` carries the arg SSA values in DECLARATION order (label reordering applied);
// every other arm is a call error the caller renders as a positioned diagnostic. This
// single result type is what lets SemanticCheck (which reports the error) and lowerCall
// (which consumes the ordered ids, `otherwise panic` since SemanticCheck already gated
// them) share one slotting algorithm rather than re-deriving the mapping twice.
export union ArgSlotResult
	ordered(argIds ValueIdArray)
	arityMismatch(expected ParamCount, got ParamCount)
	// Both arms carry a String: they exist only to be FORMATTED into a diagnostic.
	unknownLabel(argIndex ParamCount, label String)
	duplicateArg(argIndex ParamCount, paramName String)
end 'ArgSlotResult'

// Slot a call's `args` (in source order, each paired with its `argLabels` entry — the
// empty string for a positional argument) into the callee `sig`'s DECLARATION order.
// A positional argument at index `i` fills parameter position `i`; a labelled argument
// `name: value` fills the position of the parameter named `name`. The parser has
// already enforced that only the first argument is positional. Returns the reordered
// value list, or the first slotting error found (arity, unknown label, or two arguments
// targeting one parameter). THE one place the label→position mapping lives — shared by
// call validation and call lowering.
export function slotCallArgs(sig FuncSignature, args ValueIdArray, argLabels ByteArrayArray) returns ArgSlotResult
	let paramCount = sig.paramCount()
	if args.count() != paramCount 'arity'
		return ArgSlotResult.arityMismatch(paramCount, got: args.count())
	end 'arity'

	// Fresh per-call buffers (paramCount is tiny); `filled` starts all-false so the
	// duplicate check below is sound, and `slotIds` is fully written iff every position
	// is filled exactly once — guaranteed once arity matches and no duplicate is found.
	var slotIds = ValueIdArray.create()
	var filled = BoolArray.create()
	for _ in 0 upto paramCount 'initSlots'
		slotIds.push(0 as ValueId)
		filled.push(false)
	end 'initSlots'

	for i in 0 upto args.count() 'placeArgs'
		let argId = try args.get(i) otherwise panic("slotCallArgs: args.get OOB at {i}")
		let label = try argLabels.get(i) otherwise panic("slotCallArgs: argLabels.get OOB at {i}")

		var pos = i as ParamCount
		if not label.isEmpty() 'labelled'
			pos = sig.indexOfParam(label)
			if pos >= paramCount 'unknown'
				return ArgSlotResult.unknownLabel(i, label: String.from(label))
			end 'unknown'
		end 'labelled'

		let alreadyFilled = try filled.get(pos) otherwise panic("slotCallArgs: filled.get OOB at {pos}")
		if alreadyFilled 'dup'
			let paramName = try sig.paramNames.get(pos) otherwise panic("slotCallArgs: paramNames.get OOB at {pos}")
			return ArgSlotResult.duplicateArg(i, paramName: String.from(paramName))
		end 'dup'
		try slotIds.set(pos, value: argId) otherwise panic("slotCallArgs: slotIds.set OOB at {pos}")
		try filled.set(pos, value: true) otherwise panic("slotCallArgs: filled.set OOB at {pos}")
	end 'placeArgs'

	return ArgSlotResult.ordered(slotIds)
end 'slotCallArgs'

export type Project
	// Incremental query plumbing (source inputs + memo caches + dep graph).
	export var db as QueryDatabase
	// Declared function return types (the M1 parse-staging registry).
	export var funcReturnTypes as FuncReturnTypeMap
	// Declared function parameter signatures (names + types), keyed by name.
	// The M5 parse-staging registry the call machinery reads (see FuncSignature).
	export var funcSignatures as FuncSignatureMap
	// ⭐ Recorded function-value merges awaiting whole-program signature agreement (P1.5 #81). Filled by
	// `mergeArtifact` (each file's `pendingFnMergeChecks` appended in order); drained by
	// `checkValueMergeSignatures` before the pipeline runs. Reset with the other merge targets.
	export var pendingFnMergeChecks as PendingFnMergeCheckArray
	// Declared ranged typealiases, keyed by name (see RangedTypeAlias). The registry
	// TypeResolution resolves every `MaxonType.named` against.
	export var typeAliases as RangedTypeAliasMap
	// Range-check sites, keyed by function name (see FunctionRangeChecks) — P1.9. The parser
	// records every `as` cast into a ranged alias and every ranged `return`; `InsertRangeChecks`
	// (Std tier) reads this to emit the guards / E3005. Kept SEPARATE from `funcReturnTypes`
	// because that registry is COLLAPSED to primitives by `resolveTypes`, which discards the
	// alias name a check needs; this one is written once at merge and never resolved away.
	export var rangeChecks as RangeCheckPlanMap
	// Declared FUNCTION typealiases, keyed by name (see FunctionTypeAlias) — P1.5-A1. Its OWN registry,
	// not folded into `typeAliases`, because a function alias is not a ranged numeric one (see
	// FunctionTypeAlias). The parser reads it to resolve a function-typed place and to type an indirect
	// call's result.
	export var functionTypeAliases as FunctionTypeAliasMap
	// Declared struct types, keyed by name (see StructLayout). The registry's OTHER half: a
	// `MaxonType.named` resolves against the aliases above OR against this, and a name in neither
	// is E3011.
	export var structTypes as StructLayoutMap
	// Declared enum/union types, keyed by name (see EnumLayout). The struct registry's twin: a
	// `MaxonType.named` naming a declared `enum`/`union` resolves to `integer` here (an enum value
	// is its i64 tag), and the parser reads the cases through the whole-program signature index.
	export var enumTypes as EnumLayoutMap
	// id <-> name table behind every `MaxonType.named`. Folded from per-file
	// artifact interners at merge time (see TypeNameInterner.maxon).
	export var typeNames as TypeNameInterner
	// Source span of every op in the whole-program Maxon module, parallel by op
	// index. Folded from the per-file artifact tables by `mergeArtifact`, in the
	// same source-path order the module itself merges. A MAXON-TIER table: the Std
	// and Target modules carry no spans (see SourceRangeTable). Read on the cold
	// path only — diagnostics and, later, LSP queries.
	export var opRanges as SourceRangeTable
	// (funcIndex, ValueId) -> Maxon OpIndex for every op-defined value in the
	// whole-program Maxon module (see ValueOrigin). Folded from the per-file artifact
	// tables by `mergeArtifact`, in the same source-path order the module merges. A
	// MAXON-TIER table read on the cold path only — today the backend's E5001
	// (register-pressure) diagnostic maps a Target ValueId back to its source span
	// through it; M6's ownership checker reuses it.
	export var valueOrigins as ValueOriginTable
	// The compile root: the file or directory this build was invoked on. Used to
	// derive per-file namespaces and the default output path.
	export var rootPath as FilePath
	// Target CPU/OS this build emits for.
	export var target as Target
	// Accumulated user-facing diagnostics; a non-empty set fails the build.
	export var diagnostics as DiagnosticArray
	// Backend rdata/global constant table, threaded to `buildBackend`. Empty for
	// the `return 42` slice (no floats / string literals / static globals yet).
	export var globalData as GlobalDataTable
	// Wall-clock attribution for this compile (see CompileTimings). It lives on
	// Project because Project is ALREADY threaded through every phase — the frontend
	// queries, the pass pipeline, and the backend all take it — so no pass needs a new
	// parameter merely to be timed, and each compile gets its own timings instead of
	// the per-file fan-out driver contending on a global.
	export var timings as CompileTimings
	// Allocation attribution for this compile (see CompileMemory) — the twin of
	// `timings`, phase for phase, and here for the same reason. The two are written
	// TOGETHER, from one `PhaseProbe`, so a phase can never be timed at one boundary and
	// metered at another; see PhaseProbe's header for why that is worth a type.
	export var memory as CompileMemory
	// WHICH COMPILE this is, on the DebugStream wire (see DebugTrace). Every trace event this
	// build emits carries it, so a run that compiles N units in one process reads back as N
	// timelines instead of one shuffled pile. Derived from the compile ROOT, not handed out by a
	// counter: a counter is shared mutable state, and this field exists precisely to survive the
	// day N compiles run at once.
	export var traceUnit as TraceUnit

	export static function create(db QueryDatabase, rootPath FilePath, target Target) returns Project
		return Self{
			db: db,
			funcReturnTypes: FuncReturnTypeMap.create(),
			funcSignatures: FuncSignatureMap.create(),
			pendingFnMergeChecks: PendingFnMergeCheckArray.create(),
			typeAliases: RangedTypeAliasMap.create(),
			rangeChecks: RangeCheckPlanMap.create(),
			functionTypeAliases: FunctionTypeAliasMap.create(),
			structTypes: StructLayoutMap.create(),
			enumTypes: EnumLayoutMap.create(),
			typeNames: TypeNameInterner.create(),
			opRanges: SourceRangeTable.create(),
			valueOrigins: ValueOriginTable.create(),
			rootPath: rootPath,
			target: target,
			diagnostics: DiagnosticArray.create(),
			globalData: GlobalDataTable.create(),
			timings: CompileTimings.create(),
			memory: CompileMemory.create(),
			traceUnit: traceUnitOf(rootPath)
		}
	end 'create'
end 'Project'

// Construct a fresh Project rooted at `rootPath` for `target`. The single
// constructor a driver needs; mirrors v1's `createProject` (which additionally
// seeds three empty memo sentinels — QueryDatabase.create owns those in shv2).
export function createProject(rootPath FilePath, target Target) returns Project
	return Project.create(QueryDatabase.create(), rootPath: rootPath, target: target)
end 'createProject'

// Append a diagnostic to the project's sink. The single funnel every reporting
// pass routes through, so diagnostic bookkeeping lives in one place.
export function reportDiagnostic(project Project, diagnostic Diagnostic)
	project.diagnostics.push(diagnostic)
end 'reportDiagnostic'

// True once any diagnostic has been reported. The pipeline's error gate reads
// this after each pass to stop before lowering an invalid module.
export function projectHasErrors(project Project) returns bool
	return project.diagnostics.count() > 0
end 'projectHasErrors'

// Render every accumulated diagnostic to stderr, one per line, in report order.
// The driver calls this on the failure path so the exact `error EXXXX: ...`
// lines the spec compares against reach stderr.
export function printDiagnostics(project Project)
	for diagnostic in project.diagnostics 'each'
		printError("{diagnostic.render()}\n")
	end 'each'
end 'printDiagnostics'
