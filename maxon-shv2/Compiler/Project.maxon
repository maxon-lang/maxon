// Project.maxon — foundational compiler-wide types.
//
// THIN for maxon-shv2 M1. In v1 (`maxon-selfhosted`) this file also holds the
// ~90-field `Project` struct and its ~28 parser-written registries. shv2 splits
// that shared state into a per-file `FileParseArtifact` (see PLAN.md — parse
// staging), so the big `Project` struct + registries + `createProject` are a
// Chunk C deliverable that GROWS this file. What lives here now is the small set
// of foundational, cross-cutting types the type layer depends on that v1 happens
// to home in Project.maxon: the primitive-array aliases, the declaration
// `Visibility` tier, and the parser's `VarInfo` symbol-table record.
//
// GROWTH CONTRACT: Chunk C must ADD the `Project` struct and registries here —
// it must NOT redefine the symbols already defined below.

// Array aliases over primitives / String. Cross-cutting; used by the IR
// containers (StringArray for name lists, BoolArray for the compaction
// liveness bitmaps). v1 scatters these between Project.maxon and Parser.maxon;
// shv2 homes both here so the parser rebuild (Chunk C) doesn't re-declare them.
export typealias StringArray = Array with String
export typealias BoolArray = Array with bool

// Visibility tier of a top-level declaration. Stamped by the parser at
// declaration time; consumed by cross-file name resolution and the unused-export
// check. `file` is the default (positively widened to `module`/`global`).
export enum Visibility
	file
	module
	global
end 'Visibility'

// Byte offset of a field within a struct's heap layout. Bounded by the max
// struct size the layout descriptor can address. Used by `VarInfo` for the
// self-field-alias fast path (reads/writes lower to loadIndirect/storeIndirect
// through `__self` + this offset rather than a materialized local slot).
//
// ⚠ **STILL ZERO CALLERS AT P1.0r, AND STRUCTS DID NOT CHANGE THAT** — which is worth saying,
// because they look like the same feature and are not. This is the INSTANCE-METHOD alias: inside
// `function area()` of `type Rect`, the bare name `width` means `self.width`, so a name with no
// dot resolves to an offset. P1.0r has only `static function create`, no `self`, and no bare
// field name — its field access is `p.x`, an EXPRESSION over an ordinary value binding, which
// reads the struct's `StructLayout` through the binding's `structRef` type and never touches this
// record (`Parser.emitFieldLoad`). Wiring it here anyway would have given the scaffold a consumer
// and no reason to be right — the `mintPhi` trap, which cost a rung. It waits for instance methods.
export typealias FieldOffset = int(0 to 65520)

// Ordinal of a union case (and, for a payload binding, the field index within
// that case's payload). Bounded by the max cases a union may declare.
export typealias CaseOrdinal = int(0 to 65535)

// VarInfo — one entry in a function's `Scope` symbol table.
//
// The parser tracks every local by its source-level `MaxonType`; that type is
// carried to lowerMaxonToStd, which resolves the concrete `StdType` (int vs
// float, width) through the typealias registry after resolution. The parser
// never branches on int-vs-float.
//
// `isSelfField` / `isPayloadBinding` mark the two non-slot binding shapes
// (self-field alias inside an instance method; match-arm payload binding on a
// union). Both are inert at M1 (no structs, no enums yet) but the record shape
// is kept whole so M9/M12 activate them without a struct migration.
export type VarInfo
	// A zero-copy slice of the source, straight off the declaring token — names are
	// KEYS, and ByteArray hashes/compares by content, so no String is ever built for one.
	export var name as ByteArray
	export var varType as MaxonType
	export var mutable as bool
	export var slot as VarSlot
	// The SSA ValueId this binding aliases, for M2's value-substitution model: a
	// `let`/`var x = <expr>` binds `x` directly to the ValueId its initializer
	// produced, so a reference to `x` resolves to that value at parse time and no
	// `x` op ever enters the IR (`let x = 42; return x` lowers identically to
	// `return 42`). Meaningful ONLY for value bindings — exactly like `fieldOffset`
	// for self-fields and `payloadFieldIndex` for payload bindings, it is 0 (unused)
	// for the slot-backed binding shapes. When mutation + `mem2reg` land, the slot
	// model (above) supersedes this direct substitution.
	export var boundValue as ValueId
	// Ownership lattice kind for this binding — the M1 ownership scaffold's
	// per-binding attribute (see OwnershipKind in MaxonDialect.maxon). ALWAYS
	// `trivial` at M1 (all bindings are scalars); the Own tier (M6) sets it to
	// `owned`/`borrow`/`shared` during OwnershipInfer/EscapeAnalysis, and Scope's
	// per-frame owned-values list keys off it to place drops at scope exit.
	// Present-but-inert: designed in from the first commit, not retrofitted.
	export var ownership as OwnershipKind
	// True when this name is a self-field alias inside an instance method.
	// Reads emit loadIndirect via __self + fieldOffset; writes emit storeIndirect — the SAME two
	// ops `p.x` already rides (there is no `fieldLoad`/`fieldStore` op and there is not going to
	// be one; the memory band is the general pair, per StdDialect).
	export var isSelfField as bool
	export var fieldOffset as FieldOffset
	// True when this name was introduced as a match-arm binding on a union
	// payload. Reads go through the local slot; writes are rewritten to a
	// payload store against the scrutinee + field index.
	export var isPayloadBinding as bool
	export var payloadScrutineeName as ByteArray
	export var payloadFieldIndex as CaseOrdinal
	// The union case this binding belongs to — different cases of the same
	// union have independent payload field types, so the case name is required.
	export var payloadCaseName as ByteArray

	export static function create(name ByteArray, varType MaxonType, mutable bool, slot VarSlot) returns VarInfo
		return Self{name: name, varType: varType, mutable: mutable, slot: slot, boundValue: 0, ownership: OwnershipKind.trivial, isSelfField: false, fieldOffset: 0, isPayloadBinding: false, payloadScrutineeName: EmptySourceText, payloadFieldIndex: 0 as CaseOrdinal, payloadCaseName: EmptySourceText}
	end 'create'

	export static function createSelfField(name ByteArray, varType MaxonType, slot VarSlot, offset FieldOffset) returns VarInfo
		return Self{name: name, varType: varType, mutable: true, slot: slot, boundValue: 0, ownership: OwnershipKind.trivial, isSelfField: true, fieldOffset: offset, isPayloadBinding: false, payloadScrutineeName: EmptySourceText, payloadFieldIndex: 0, payloadCaseName: EmptySourceText}
	end 'createSelfField'

	export static function createPayloadBinding(name ByteArray, varType MaxonType, mutable bool, slot VarSlot, scrutineeName ByteArray, fieldIndex CaseOrdinal, caseName ByteArray) returns VarInfo
		return Self{name: name, varType: varType, mutable: mutable, slot: slot, boundValue: 0, ownership: OwnershipKind.trivial, isSelfField: false, fieldOffset: 0, isPayloadBinding: true, payloadScrutineeName: scrutineeName, payloadFieldIndex: fieldIndex, payloadCaseName: caseName}
	end 'createPayloadBinding'

	// Construct a value binding for M2's substitution model: `name` aliases the SSA
	// value `boundValue`. No stack slot is materialized (SSA substitution needs
	// none), so `slot` is 0 — a value binding never reads it. The slot-backed
	// constructors above stay the home of the future mutable/mem2reg model.
	export static function createValueBinding(name ByteArray, varType MaxonType, mutable bool, boundValue ValueId) returns VarInfo
		return Self{name: name, varType: varType, mutable: mutable, slot: 0, boundValue: boundValue, ownership: OwnershipKind.trivial, isSelfField: false, fieldOffset: 0, isPayloadBinding: false, payloadScrutineeName: EmptySourceText, payloadFieldIndex: 0, payloadCaseName: EmptySourceText}
	end 'createValueBinding'
end 'VarInfo'

export typealias VarInfoMap = Map with (ByteArray, VarInfo)

// A list of BINDINGS, held by reference (VarInfo is a heap `type`). Scope keeps the
// bindings a frame displaced in one; the parser keeps its mutable bindings in one.
// Both need the binding OBJECT rather than its name — see Scope's header for why a
// name cannot address a binding a nested block has shadowed.
export typealias VarInfoArray = Array with VarInfo

// --- Ranged typealiases ---
//
// `typealias Score = int(0 to 100)` — the declaration form nearly every real Maxon
// file opens with, and the reason `int` is almost never written bare in a type
// position. A DECLARATION, not an op: it contributes a registry entry, and
// TypeResolution collapses every `MaxonType.named(Score)` to the primitive below.
//
// TWO ALIASES OVER THE SAME RANGE ARE THE SAME TYPE — an alias creates no nominal
// distinction, so resolution needs only `underlying`. The BOUNDS are carried anyway
// because they ARE the alias's definition: they are what a narrowing conversion is
// checked against (the runtime range check — a later milestone), and a registry that
// forgot them would force that milestone to re-parse the declaration. This milestone
// emits no range check, so nothing reads them yet.
//
// `low`/`high` are INCLUSIVE and stored as the raw 64-bit pattern `ParsedInt` holds:
// `upto` (an exclusive upper bound) is normalized to `high - 1` at parse time so the
// registry has ONE representation, and an unsigned-domain bound such as `u64.max`
// rides as the signed value with the same bits (which is exactly how a cast against
// it must compare — see specs/ranged-typealias.md's sentinel case).
export type RangedTypeAlias
	export var name as ByteArray
	// The primitive the alias resolves to — the `int` / `float` keyword it was
	// declared over. What TypeResolution substitutes for `named(alias)`.
	export var underlying as MaxonType
	export var low as ParsedInt
	export var high as ParsedInt

	export static function create(name ByteArray, underlying MaxonType, low ParsedInt, high ParsedInt) returns RangedTypeAlias
		return Self{name: name, underlying: underlying, low: low, high: high}
	end 'create'
end 'RangedTypeAlias'

export typealias RangedTypeAliasArray = Array with RangedTypeAlias

// Registry: typealias name -> its declaration. Populated by `mergeArtifact` from each
// file's artifact (alongside `funcReturnTypes` / `funcSignatures`); read by
// TypeResolution to collapse `MaxonType.named` to a primitive.
export typealias RangedTypeAliasMap = Map with (ByteArray, RangedTypeAlias)

// --- Declared struct types (P1.0r) ---

// The index of a field within its struct's declaration order. It IS the field's identity — the
// offset is derived from it (`StructLayout.offsetOfField`) rather than stored, so there is no
// second number to keep in step. Bounded by the fields a struct may declare.
export typealias FieldIndex = int(0 to 65535)

// ⭐ **EVERY FIELD OCCUPIES ONE 8-BYTE SLOT, WHATEVER ITS DECLARED TYPE**, and this constant is
// that decision. It is not an alignment convenience: a struct FIELD of struct type is a POINTER
// (`valueTagToStdType(structRef)` → i64), so `sizeof(Outer{p Point, n Integer})` is 16 rather than
// 24 — which is exactly what `specs/sizeof.md` pins, and what makes the layout a function of the
// field COUNT alone. A packed layout would have to know each field's width, which is a Std-tier
// fact this Maxon-tier record deliberately does not carry.
let FieldSlotBytes = 8 as ByteOffset

// The size of a struct with NO fields. A zero-byte allocation would hand two distinct empty
// structs the SAME address (the bump allocator advances by nothing), so identity would collapse
// and a decref of one would free the other. One slot is the floor, and it costs a program that
// declares an empty struct exactly 8 bytes it will never read.
let EmptyStructBytes = FieldSlotBytes

// The value a field declaration supplies when a `Self{…}` literal omits it — `export var value = 0`.
//
// It carries the PAYLOAD only, never a type: the default's type IS the field's declared type, which
// `StructLayout.fieldTypes` already holds. For `= 0` the literal is what SET that type (there is no
// annotation to read); for `as Integer = 0` the annotation set it and the literal was CHECKED
// against it. Either way one field has one type in one column, so a default cannot come to disagree
// with the slot it fills.
//
// The payload is a `ParsedInt` for a float exactly as for an integer — a float literal's value IS
// its IEEE-754 bit pattern (see `Parser.parseFloatLiteral`), which is why a defaulted float costs no
// second column and no second decoder.
export union FieldDefault
	// The declaration supplies none: `export var x as Integer`. A literal that omits this field is
	// E3086, and that is the rule field defaults exist to relax.
	none
	literal(payload ParsedInt)
end 'FieldDefault'

export typealias FieldDefaultArray = Array with FieldDefault

// StructLayout — one declared `type T`: what it is called, and its fields IN DECLARATION ORDER.
//
// It is the struct twin of `FuncSignature` (parallel name/type arrays, a linear index-of lookup),
// and it is homed here for the same reason: it is a parse-staging registry entry, written by the
// parser into a `FileParseArtifact` and folded into `Project` by `mergeArtifact` — never touched
// by the parser on `Project` directly.
//
// ⚠ **IT LIVES IN TWO REGISTRIES, DELIBERATELY, AND THAT IS `RangedTypeAlias`'s ARRANGEMENT
// EXACTLY.** `ProgramSignatures.structOf` answers the PARSER, before any file is parsed, from the
// whole-program TOKEN sweep — because `p.x` needs the field's offset at PARSE time and the
// declaration may be below it or in another file. `Project.structTypes` answers TYPE RESOLUTION,
// after the real parse, and it is the AUTHORITY — a name in neither registry is E3011, and a
// tolerant token sweep must never own a veto (see SignatureIndex's `CalleeReturn.undeclared`).
// Two readers, two moments, one record type.
export type StructLayout
	export var name as ByteArray
	// Parallel arrays, in DECLARATION order: field `i` is called `fieldNames[i]`, is declared
	// `fieldTypes[i]`, accepts a write iff `fieldMutable[i]`, and defaults to `fieldDefaults[i]`.
	// The declared type is NOT a resolved one — the sweep that records it cannot resolve anything
	// (the alias it names may be in a file not yet folded), and the parser resolves it at the use
	// site through the same `aliasOf` door the shift rule already asks.
	//
	// ⚠ **THE COLUMNS ARE NEVER APPENDED TO DIRECTLY — `addField` IS THE ONE WRITER**, and that is
	// what makes "the columns fell out of lockstep" unrepresentable rather than merely asserted. A
	// reader indexes all four by one `FieldIndex`, so a caller that pushed a name and forgot a
	// default would shift every later field's default onto the wrong field: a silent wrong answer
	// with no crash to find it by.
	export var fieldNames as ByteArrayArray
	export var fieldTypes as MaxonTypeArray
	export var fieldMutable as BoolArray
	export var fieldDefaults as FieldDefaultArray

	// An EMPTY layout, filled by `addField`. It does not take the columns, deliberately: handing
	// four pre-built parallel arrays across a call boundary is exactly the shape that lets three of
	// them arrive.
	export static function create(name ByteArray) returns StructLayout
		return Self{name: name, fieldNames: ByteArrayArray.create(), fieldTypes: MaxonTypeArray.create(), fieldMutable: BoolArray.create(), fieldDefaults: FieldDefaultArray.create()}
	end 'create'

	// Append one declared field. THE one writer of the columns — every column, one push, so they
	// cannot drift.
	export function addField(fieldName ByteArray, declaredType MaxonType, mutable bool, defaultValue FieldDefault)
		self.fieldNames.push(fieldName)
		self.fieldTypes.push(declaredType)
		self.fieldMutable.push(mutable)
		self.fieldDefaults.push(defaultValue)
	end 'addField'

	// Does field `index` accept a write? `export var count` does; `export let version` does not, and
	// `c.version = 2` is E2013 (see `Parser.parseFieldAssignment`).
	export function fieldIsMutable(index FieldIndex) returns bool
		return try self.fieldMutable.get(index) otherwise panic("StructLayout.fieldIsMutable: fieldMutable.get OOB at {index} for `type {String.from(self.name)}`, which declares {self.fieldCount()} — every index handed out came from `indexOfField`")
	end 'fieldIsMutable'

	// What field `index` defaults to when a `Self{…}` literal omits it.
	export function fieldDefault(index FieldIndex) returns FieldDefault
		return try self.fieldDefaults.get(index) otherwise panic("StructLayout.fieldDefault: fieldDefaults.get OOB at {index} for `type {String.from(self.name)}`, which declares {self.fieldCount()} — every index handed out came from `indexOfField`")
	end 'fieldDefault'

	export function fieldCount() returns FieldIndex
		return self.fieldNames.count()
	end 'fieldCount'

	// The declaration index of the field named `wanted`, or `fieldCount()` when the struct declares
	// no such field. A linear scan, for `FuncSignature.indexOfParam`'s reason and with its
	// measurement behind it: field counts are tiny, and a per-layout name→index map would be a
	// heap object per declared type bought to serve a handful of lookups.
	export function indexOfField(wanted ByteArray) returns FieldIndex
		for i in 0 upto self.fieldNames.count() 'each'
			let fieldName = try self.fieldNames.get(i) otherwise panic("StructLayout.indexOfField: fieldNames.get OOB at {i}")
			if fieldName.equals(wanted) 'match'
				return i
			end 'match'
		end 'each'
		return self.fieldNames.count()
	end 'indexOfField'

	// The byte displacement of field `index` from the box's PAYLOAD pointer — which is what
	// `__mm_alloc` returns, so the header is invisible here and the first field sits at 0.
	export function offsetOfField(index FieldIndex) returns ByteOffset
		return index * FieldSlotBytes
	end 'offsetOfField'

	// The payload bytes `__mm_alloc` must be asked for. THE one place the size is computed, so the
	// allocation and the field stores that fill it cannot come to disagree about how big the box is.
	export function sizeBytes() returns ByteOffset
		if self.fieldNames.count() == 0 'empty'
			return EmptyStructBytes
		end 'empty'
		return self.fieldNames.count() * FieldSlotBytes
	end 'sizeBytes'
end 'StructLayout'

export typealias StructLayoutArray = Array with StructLayout

// Registry: struct-type name -> its declaration. The twin of `RangedTypeAliasMap`, filled from
// each file's artifact by `mergeArtifact` and read by TypeResolution to turn `MaxonType.named` for
// a declared `type` into `MaxonType.structRef`.
export typealias StructLayoutMap = Map with (ByteArray, StructLayout)

// --- Project: the compiler-wide shared state (Chunk C growth) ---
//
// GROWTH: this is the M1 `Project`. v1's `Project` has ~90 fields and ~28
// parser-written registries; shv2 starts with the minimum the `return 42` slice
// needs and grows one field/registry per milestone. The parse-staging design
// (PLAN.md) keeps the parser OFF this struct — a file parses into a
// `FileParseArtifact` (see ParseStaging.maxon) and `mergeArtifact` is the ONLY
// writer of the derived registries below (`funcReturnTypes`, `typeNames`), so
// per-file parse stays a pure function and the registries are rebuilt
// deterministically from artifacts on every `queryAllModule` miss.

// Registry: qualified function name -> its declared return type. The M1 example
// of the parse-staging registry set (v1's grows to ~28). Populated by
// `mergeArtifact` from each file's artifact; resolved in place by TypeResolution;
// read by SemanticCheck to locate `main` and validate its return type.
export typealias FuncReturnTypeMap = Map with (ByteArray, MaxonReturnType)

// A function's parameter signature: the declared parameter NAMES (in declaration
// order) and their source-level TYPES (parallel, same order). The M5 parse-staging
// registry the call machinery needs — the return-type registry above answers "what
// does this callee return?", this answers "what does it take, and by what labels?".
// Param NAMES are the load-bearing field: a call reorders its labelled arguments
// (`add(2, b: 3)`) to the callee's declaration order by matching each `name:` label
// to the parameter position holding that name. Param TYPES back arity/type checking.
// (v1 homes the same data on a richer `FuncSignature` with defaults/companions; shv2
// carries only names + types until defaults and generics land.)
export type FuncSignature
	export var paramNames as ByteArrayArray
	export var paramTypes as MaxonTypeArray

	export static function create(paramNames ByteArrayArray, paramTypes MaxonTypeArray) returns FuncSignature
		return Self{paramNames: paramNames, paramTypes: paramTypes}
	end 'create'

	// The declared parameter count — the arity a call must match.
	export function paramCount() returns ParamCount
		return self.paramNames.count()
	end 'paramCount'

	// The declaration index of the parameter named `name`, or `paramCount()` when
	// no parameter carries that name (an unknown label). A linear scan over the
	// name list — parameter counts are tiny, so no per-signature name→index map is
	// worth its heap object (contrast v1's `nameToIndex`, which paid for one on
	// every signature to serve method dispatch this milestone does not have).
	export function indexOfParam(name ByteArray) returns ParamCount
		for i in 0 upto self.paramNames.count() 'each'
			let paramName = try self.paramNames.get(i) otherwise panic("FuncSignature.indexOfParam: paramNames.get OOB at {i}")
			if paramName.equals(name) 'match'
				return i
			end 'match'
		end 'each'
		return self.paramNames.count()
	end 'indexOfParam'
end 'FuncSignature'

// Registry: qualified function name -> its parameter signature. Populated by
// `mergeArtifact` alongside `funcReturnTypes`; resolved in place by TypeResolution
// (its param types collapse `named`→concrete); read by SemanticCheck (call
// validation) and lowerCall (label→positional arg slotting).
export typealias FuncSignatureMap = Map with (ByteArray, FuncSignature)

// The outcome of slotting a call's arguments to its callee's parameter positions.
// `ordered` carries the arg SSA values in DECLARATION order (label reordering applied);
// every other arm is a call error the caller renders as a positioned diagnostic. This
// single result type is what lets SemanticCheck (which reports the error) and lowerCall
// (which consumes the ordered ids, `otherwise panic` since SemanticCheck already gated
// them) share one slotting algorithm rather than re-deriving the mapping twice.
export union ArgSlotResult
	ordered(argIds ValueIdArray)
	arityMismatch(expected ParamCount, got ParamCount)
	// Both arms carry a String: they exist only to be FORMATTED into a diagnostic.
	unknownLabel(argIndex ParamCount, label String)
	duplicateArg(argIndex ParamCount, paramName String)
end 'ArgSlotResult'

// Slot a call's `args` (in source order, each paired with its `argLabels` entry — the
// empty string for a positional argument) into the callee `sig`'s DECLARATION order.
// A positional argument at index `i` fills parameter position `i`; a labelled argument
// `name: value` fills the position of the parameter named `name`. The parser has
// already enforced that only the first argument is positional. Returns the reordered
// value list, or the first slotting error found (arity, unknown label, or two arguments
// targeting one parameter). THE one place the label→position mapping lives — shared by
// call validation and call lowering.
export function slotCallArgs(sig FuncSignature, args ValueIdArray, argLabels ByteArrayArray) returns ArgSlotResult
	let paramCount = sig.paramCount()
	if args.count() != paramCount 'arity'
		return ArgSlotResult.arityMismatch(paramCount, got: args.count())
	end 'arity'

	// Fresh per-call buffers (paramCount is tiny); `filled` starts all-false so the
	// duplicate check below is sound, and `slotIds` is fully written iff every position
	// is filled exactly once — guaranteed once arity matches and no duplicate is found.
	var slotIds = ValueIdArray.create()
	var filled = BoolArray.create()
	for _ in 0 upto paramCount 'initSlots'
		slotIds.push(0 as ValueId)
		filled.push(false)
	end 'initSlots'

	for i in 0 upto args.count() 'placeArgs'
		let argId = try args.get(i) otherwise panic("slotCallArgs: args.get OOB at {i}")
		let label = try argLabels.get(i) otherwise panic("slotCallArgs: argLabels.get OOB at {i}")

		var pos = i as ParamCount
		if not label.isEmpty() 'labelled'
			pos = sig.indexOfParam(label)
			if pos >= paramCount 'unknown'
				return ArgSlotResult.unknownLabel(i, label: String.from(label))
			end 'unknown'
		end 'labelled'

		let alreadyFilled = try filled.get(pos) otherwise panic("slotCallArgs: filled.get OOB at {pos}")
		if alreadyFilled 'dup'
			let paramName = try sig.paramNames.get(pos) otherwise panic("slotCallArgs: paramNames.get OOB at {pos}")
			return ArgSlotResult.duplicateArg(i, paramName: String.from(paramName))
		end 'dup'
		try slotIds.set(pos, value: argId) otherwise panic("slotCallArgs: slotIds.set OOB at {pos}")
		try filled.set(pos, value: true) otherwise panic("slotCallArgs: filled.set OOB at {pos}")
	end 'placeArgs'

	return ArgSlotResult.ordered(slotIds)
end 'slotCallArgs'

export type Project
	// Incremental query plumbing (source inputs + memo caches + dep graph).
	export var db as QueryDatabase
	// Declared function return types (the M1 parse-staging registry).
	export var funcReturnTypes as FuncReturnTypeMap
	// Declared function parameter signatures (names + types), keyed by name.
	// The M5 parse-staging registry the call machinery reads (see FuncSignature).
	export var funcSignatures as FuncSignatureMap
	// Declared ranged typealiases, keyed by name (see RangedTypeAlias). The registry
	// TypeResolution resolves every `MaxonType.named` against.
	export var typeAliases as RangedTypeAliasMap
	// Declared struct types, keyed by name (see StructLayout). The registry's OTHER half: a
	// `MaxonType.named` resolves against the aliases above OR against this, and a name in neither
	// is E3011.
	export var structTypes as StructLayoutMap
	// id <-> name table behind every `MaxonType.named`. Folded from per-file
	// artifact interners at merge time (see TypeNameInterner.maxon).
	export var typeNames as TypeNameInterner
	// Source span of every op in the whole-program Maxon module, parallel by op
	// index. Folded from the per-file artifact tables by `mergeArtifact`, in the
	// same source-path order the module itself merges. A MAXON-TIER table: the Std
	// and Target modules carry no spans (see SourceRangeTable). Read on the cold
	// path only — diagnostics and, later, LSP queries.
	export var opRanges as SourceRangeTable
	// (funcIndex, ValueId) -> Maxon OpIndex for every op-defined value in the
	// whole-program Maxon module (see ValueOrigin). Folded from the per-file artifact
	// tables by `mergeArtifact`, in the same source-path order the module merges. A
	// MAXON-TIER table read on the cold path only — today the backend's E5001
	// (register-pressure) diagnostic maps a Target ValueId back to its source span
	// through it; M6's ownership checker reuses it.
	export var valueOrigins as ValueOriginTable
	// The compile root: the file or directory this build was invoked on. Used to
	// derive per-file namespaces and the default output path.
	export var rootPath as FilePath
	// Target CPU/OS this build emits for.
	export var target as Target
	// Accumulated user-facing diagnostics; a non-empty set fails the build.
	export var diagnostics as DiagnosticArray
	// Backend rdata/global constant table, threaded to `buildBackend`. Empty for
	// the `return 42` slice (no floats / string literals / static globals yet).
	export var globalData as GlobalDataTable
	// Wall-clock attribution for this compile (see CompileTimings). It lives on
	// Project because Project is ALREADY threaded through every phase — the frontend
	// queries, the pass pipeline, and the backend all take it — so no pass needs a new
	// parameter merely to be timed, and each compile gets its own timings instead of
	// the per-file fan-out driver contending on a global.
	export var timings as CompileTimings
	// Allocation attribution for this compile (see CompileMemory) — the twin of
	// `timings`, phase for phase, and here for the same reason. The two are written
	// TOGETHER, from one `PhaseProbe`, so a phase can never be timed at one boundary and
	// metered at another; see PhaseProbe's header for why that is worth a type.
	export var memory as CompileMemory
	// WHICH COMPILE this is, on the DebugStream wire (see DebugTrace). Every trace event this
	// build emits carries it, so a run that compiles N units in one process reads back as N
	// timelines instead of one shuffled pile. Derived from the compile ROOT, not handed out by a
	// counter: a counter is shared mutable state, and this field exists precisely to survive the
	// day N compiles run at once.
	export var traceUnit as TraceUnit

	export static function create(db QueryDatabase, rootPath FilePath, target Target) returns Project
		return Self{
			db: db,
			funcReturnTypes: FuncReturnTypeMap.create(),
			funcSignatures: FuncSignatureMap.create(),
			typeAliases: RangedTypeAliasMap.create(),
			structTypes: StructLayoutMap.create(),
			typeNames: TypeNameInterner.create(),
			opRanges: SourceRangeTable.create(),
			valueOrigins: ValueOriginTable.create(),
			rootPath: rootPath,
			target: target,
			diagnostics: DiagnosticArray.create(),
			globalData: GlobalDataTable.create(),
			timings: CompileTimings.create(),
			memory: CompileMemory.create(),
			traceUnit: traceUnitOf(rootPath)
		}
	end 'create'
end 'Project'

// Construct a fresh Project rooted at `rootPath` for `target`. The single
// constructor a driver needs; mirrors v1's `createProject` (which additionally
// seeds three empty memo sentinels — QueryDatabase.create owns those in shv2).
export function createProject(rootPath FilePath, target Target) returns Project
	return Project.create(QueryDatabase.create(), rootPath: rootPath, target: target)
end 'createProject'

// Append a diagnostic to the project's sink. The single funnel every reporting
// pass routes through, so diagnostic bookkeeping lives in one place.
export function reportDiagnostic(project Project, diagnostic Diagnostic)
	project.diagnostics.push(diagnostic)
end 'reportDiagnostic'

// True once any diagnostic has been reported. The pipeline's error gate reads
// this after each pass to stop before lowering an invalid module.
export function projectHasErrors(project Project) returns bool
	return project.diagnostics.count() > 0
end 'projectHasErrors'

// Render every accumulated diagnostic to stderr, one per line, in report order.
// The driver calls this on the failure path so the exact `error EXXXX: ...`
// lines the spec compares against reach stderr.
export function printDiagnostics(project Project)
	for diagnostic in project.diagnostics 'each'
		printError("{diagnostic.render()}\n")
	end 'each'
end 'printDiagnostics'
