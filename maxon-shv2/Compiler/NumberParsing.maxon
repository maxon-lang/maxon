// Pure number parsing functions for the compiler.
// Converts string representations of integer and float literals to numeric values.

export typealias ParsedInt = int(i64.min to i64.max)

// A column of parsed integers. Lives HERE, beside the type it is a column OF, because two passes
// now keep one — the parser's constant folder and `foldConstOperands`' ConstValueMap — and a
// typealias declared twice over the same element type is the same fact written down twice.
//
// A `ParsedInt` is SIGNED, so this is NOT a `DenseColumn` (which is unsigned): never widen one into
// the other.
export typealias ParsedIntArray = Array with ParsedInt

export union ParserError
	unhandledToken
	typeError
	overflow
	unexpectedEof
end 'ParserError'

// The i64 boundary magnitudes, as digit bytes, for the overflow checks below. Built ONCE:
// `parseInt` consults `I64MaxDigits` for EVERY 19-digit literal and `parseNegatedInt`
// consults `I64MinMagnitudeDigits` for every negated one.
let I64MaxDigits = b"9223372036854775807"
let I64MinMagnitudeDigits = b"9223372036854775808"

// --- IEEE 754 binary64 layout and range ---
// The field widths and the two exponent extremes the conversion below has to land inside. Named
// because every one of them is consulted from more than one place, and because a bare `1023` in the
// middle of a shift is indistinguishable from a bare `1023` that means something else.
let SignificandFieldBits = 52
let ExponentBias = 1023
let ImplicitLeadingBit = 0x0010000000000000
let InfinityBits = 0x7FF0000000000000

// Normals run 2^-1022 … 2^1023. Below that the exponent FIELD pins at zero and the significand
// loses one bit per further halving, down to the least subnormal 2^-1074.
let MinNormalBinaryExponent = -1022
let MaxNormalBinaryExponent = 1023
let LeastSubnormalBinaryExponent = -1074

// The decimal magnitude window a literal must fall in, as floor(log10(value)). Above the upper
// bound the value exceeds f64.max (~1.7977e308) and is an error; below the lower bound it is under
// HALF the least subnormal (~4.94e-324), so round-to-nearest gives +0 and that is NOT an error —
// strtod agrees. Both bounds also CAP the magnitudes built during the conversion, which is what
// keeps the fixed-width arithmetic below inside its budget.
let MaxFiniteDecimalExponent = 308
let LeastRoundableDecimalExponent = -324

// How far OUTSIDE the window above an `e` exponent must be clamped before it is safely out of range.
// The scanner has to clamp somewhere — the exponent accumulates through an i64 multiply-add, and
// `1.0e99999999999999999999` would wrap one — but the clamp competes with `decExp`, so where it
// lands is a correctness question, not a comfort one:
//
//   magnitudeExp = (sigDigits - 1) + decExp + sciExp
//
// `sigDigits - 1` tops out at `SignificantDigitBudget - 1` and the window bottoms at
// `LeastRoundableDecimalExponent`, so this span clears both ends of it — and `decExp` moves by ONE
// PER DIGIT, so the literal's own byte count bounds it and `decExp` cannot exceed it. The ceiling is
// therefore this span PLUS `bytes.count()`, per literal, and a clamped exponent is then one no
// `decExp` that same literal can build is able to drag back into range.
//
// ⚠ A FIXED ceiling is NOT safe, and a fixed 100000 was the bug here: an exponent needs only 20
// characters to reach 1e20 while a `decExp` needs 200000 of them to reach -200000, so the two are
// not comparable and the smaller one lost. `0.<200001 zeros>1e999999999` — true magnitude 1e999799997
// — cancelled the clamped 100000 against a -200002 `decExp`, landed at -100002, and compiled to
// SILENT +0. The mirror image, `1<200000 zeros>.0e-999999999`, is a true +0 and was rejected E2011.
// Both now read the same on the clamped exponent as on the true one (verified against the bootstrap).
let DecimalWindowSpan = SignificantDigitBudget - LeastRoundableDecimalExponent

// ⭐ How many significant digits are KEPT. Past this the digits are dropped and only the fact that a
// non-zero one WAS dropped is remembered (`droppedNonZeroDigit`), which is enough to round every
// literal correctly — and the bound is not a guess:
//
// A rounding boundary for a binary64 is a midpoint `m * 2^-n` with `m` ODD and `n <= 1075` (the
// spacing bottoms out at 2^-1074, so a half-spacing bottoms out at 2^-1075). Written out in full it
// is `m * 5^n` scaled by 10^-n, so it TERMINATES — and its width is the width of that product.
//
// ⚠ `5^1075` ALONE is 752 digits, and 752 is NOT the bound: `m` runs up to 2^54 - 1 and multiplies
// another 16 digits onto it. The widest boundary in the whole binary64 space is (2^54 - 1) * 2^-1075,
// and it needs exactly **768**. So this budget is TIGHT, not round: 767 would be WRONG, and a reader
// who takes 752 for the answer would shave 16 digits off a bound that has none to give.
//
// Given 768, a kept prefix and a midpoint are both integer multiples of the same 10^(magnitude-767),
// so they are either EQUAL or at least one such unit apart — while the digits we dropped are worth
// strictly LESS than that unit. So the true value and the prefix always fall on the same side of
// every midpoint, EXCEPT when the prefix lands exactly ON one, and there `droppedNonZeroDigit` is
// precisely the bit that turns a tie into a round-up. `float-literal-magnitude.md`'s
// `tight-budget-768-digit-midpoint` is the case that holds this number down: it is a midpoint with
// exactly 768 significant digits whose tie rounds DOWN, so a budget of 767 flips its second half.
//
// It was 18 for as long as the significand lived in an i64 — the cell, not the arithmetic, set the
// budget. That justification died with the i64, and 18 digits was measurably wrong: 3 of 203 random
// literals carrying 19-30 significant digits landed a full ULP off the correctly-rounded value.
let SignificantDigitBudget = 768

// Convert a decimal float string (e.g. "3.14", "1.5e2", "2.0e-3") to IEEE 754 double raw bits.
// Throws ParserError.overflow if the value exceeds float64 range.
//
// The result is CORRECTLY ROUNDED for every input — bit-for-bit what a full-precision strtod (and
// so the C# bootstrap, which delegates to one) produces.
//
// Accumulator strategy: keep the significant digits in `significandDigits` (regardless of where the
// decimal point falls), and track the implicit decimal exponent separately in `decExp` (≤0 for
// fractional shifts, ≥0 for trailing-zero shifts). After parsing, the literal's value is
// `significandDigits * 10^decExp` times the user-supplied scientific exponent. Digits past
// `SignificantDigitBudget` are dropped, but their POSITION is preserved in `decExp` and the fact
// that a NON-ZERO one was dropped is preserved in `droppedNonZeroDigit`, so a literal like
// `3.14159265358979323846` (21 sig digits) or `0.0000000000000000001` (1e-19) keeps both its
// magnitude and its rounding.
//
// Digits arrive one at a time but a magnitude is scaled in 9-digit strides (the widest power of ten
// a limb holds), so they are gathered in `pendingChunk` and folded in a chunk at a time.
export function parseFloatBits(bytes ByteArray) returns ParsedInt throws ParserError
	var significandDigits = ParsedIntArray.create()  // kept significant digits, as a magnitude
	var pendingChunk = 0  // digits gathered but not yet folded into `significandDigits`
	var pendingCount = 0
	var droppedNonZeroDigit = false  // the sticky bit: a dropped digit past the budget was non-zero
	var decExp = 0  // implicit decimal exponent for the accumulated digits
	var pastDot = false
	var sciExp = 0
	var sciExpNeg = false
	var inExponent = false
	var hasNonZeroDigit = false
	var sigDigits = 0
	var leadingFracZeros = 0  // count of fractional zeros before the first non-zero significant digit

	// This literal's exponent ceiling. It is per-literal because the `decExp` it has to out-rank is
	// bounded by the literal's LENGTH and by nothing else — see `DecimalWindowSpan`.
	let maxSciExp = bytes.count() + DecimalWindowSpan

	var pi = 0
	while pi < bytes.count() 'parse'
		let b = try bytes.get(pi) otherwise panic("parseFloatBits: pi < bytes.count() by loop guard but get({pi}) failed")

		if b == '_' 'skipUnderscore'
			pi = pi + 1
			continue
		end 'skipUnderscore'

		if inExponent 'expPart'
			if b >= '0' and b <= '9' 'expDigit'
				sciExp = sciExp * 10 + (b - '0')
				if sciExp > maxSciExp 'capExp'
					sciExp = maxSciExp
				end 'capExp'
			end 'expDigit'
		end 'expPart' else 'mantissaPart'
			if b == 'e' or b == 'E' 'startExp'
				inExponent = true
				if pi + 1 < bytes.count() 'peekSign'
					let signByte = try bytes.get(pi + 1) otherwise panic("parseFloatBits.peekSign: pi+1 < bytes.count() just checked but get({pi + 1}) failed")
					if signByte == '-' 'negSign'
						sciExpNeg = true
						pi = pi + 1
					end 'negSign' else if signByte == '+' 'posSign'
						pi = pi + 1
					end 'posSign'
				end 'peekSign'
			end 'startExp' else 'notExp'
				if b == '.' 'isDot'
					pastDot = true
				end 'isDot' else 'notDot'
					if b >= '0' and b <= '9' 'isDigit'
						let digitVal = b - '0'
						if not hasNonZeroDigit and digitVal == 0 'leading'
							// Leading zeros: skip mantissa accumulation entirely;
							// just count them so we know how much to shift the
							// decimal exponent later for fractional leading-zero
							// runs (e.g. "0.0001" → leadingFracZeros=3).
							if pastDot 'leadFrac'
								leadingFracZeros = leadingFracZeros + 1
							end 'leadFrac'
						end 'leading' else 'normalDigit'
							hasNonZeroDigit = true
							if sigDigits < SignificantDigitBudget 'inBudget'
								pendingChunk = pendingChunk * 10 + digitVal
								pendingCount = pendingCount + 1
								if pendingCount == Pow10ChunkDigits 'chunkFull'
									bigAppendDigits(significandDigits, chunk: pendingChunk, digits: pendingCount)
									pendingChunk = 0
									pendingCount = 0
								end 'chunkFull'
								sigDigits = sigDigits + 1
								if pastDot 'fracSig'
									decExp = decExp - 1
								end 'fracSig'
							end 'inBudget' else 'overBudget'
								// Drop digits past the budget, but never drop the KNOWLEDGE
								// of one: a non-zero digit down here is what breaks a tie
								// the kept prefix lands exactly on. Integer-part excess
								// bumps the decimal exponent; fractional excess needs no
								// bump (its scale is already encoded in decExp from prior
								// digits).
								if digitVal != 0 'droppedSignificand'
									droppedNonZeroDigit = true
								end 'droppedSignificand'

								if not pastDot 'intExcess'
									decExp = decExp + 1
								end 'intExcess'
							end 'overBudget'
						end 'normalDigit'
					end 'isDigit'
				end 'notDot'
			end 'notExp'
		end 'mantissaPart'
		pi = pi + 1
	end 'parse'

	// The digits that did not fill a whole chunk are still in hand.
	if pendingCount > 0 'flushPendingChunk'
		bigAppendDigits(significandDigits, chunk: pendingChunk, digits: pendingCount)
	end 'flushPendingChunk'

	// Fold the leading-zero fractional run into decExp now (was kept separate
	// to avoid mixing magnitude-tracking with mantissa accumulation above).
	decExp = decExp - leadingFracZeros

	// Combine the user-supplied scientific exponent with the implicit decimal
	// exponent we accumulated. totalExp is the signed power of 10 by which
	// the accumulated digits must be scaled to recover the literal's value.
	var signedSciExp = sciExp
	if sciExpNeg 'negSci'
		signedSciExp = -signedSciExp
	end 'negSci'
	let totalExp = decExp + signedSciExp

	// A literal with no significant digit is zero however it is scaled, `0.0e999` included — which is
	// why this precedes the range guards rather than following them.
	if not hasNonZeroDigit 'isZero'
		return 0
	end 'isZero'

	// `significandDigits` holds exactly `sigDigits` digits and its leading one is non-zero (leading
	// zeros are skipped above), so the value lies in [10^m, 10^(m+1)) and `m` is EXACTLY
	// floor(log10(value)) — not an estimate. It is exact for the TRUE value too, dropped digits and
	// all: they can only push it up by less than one unit in the last kept place, which is strictly
	// inside the same decade.
	let magnitudeExp = sigDigits - 1 + totalExp
	if magnitudeExp > MaxFiniteDecimalExponent 'aboveFloatRange'
		throw ParserError.overflow
	end 'aboveFloatRange'
	if magnitudeExp < LeastRoundableDecimalExponent 'belowFloatRange'
		// Under half the least subnormal, so `+0` IS the correctly-rounded answer and there is nothing
		// to diagnose. Returning here is also what bounds the denominator built below: without it the
		// `sciExp` cap alone would admit `1.0e-100000` and ask for a 100,000-digit magnitude.
		return 0
	end 'belowFloatRange'

	// The literal's kept prefix is now the EXACT rational `numerator / denominator`, and stays exact
	// all the way to the significand; `droppedNonZeroDigit` carries everything below it. The limb
	// representation, and why an i64 pair cannot do this job, are at BOUNDED-WIDTH MAGNITUDES below.
	var numerator = significandDigits
	var denominator = ParsedIntArray.create()
	denominator.push(1)
	if totalExp > 0 'scaleNumerator'
		bigMulPow10(numerator, exponent: totalExp)
	end 'scaleNumerator' else if totalExp < 0 'scaleDenominator'
		bigMulPow10(denominator, exponent: -totalExp)
	end 'scaleDenominator'

	// Normalize the ratio into [1, 2) and keep the power of two that was factored out. A ratio of two
	// magnitudes whose bit lengths are `nb` and `db` lies in [2^(nb-db-1), 2^(nb-db+1)), so ONE shift
	// of the smaller side by `nb - db` lands it in [1/2, 2) and at most one further doubling
	// finishes — no per-step loop to run away, and (unlike the i64 halving dance this replaced) no
	// precision thrown away to keep a cell in range.
	var exponent = bigBitLength(numerator) - bigBitLength(denominator)
	if exponent >= 0 'liftDenominator'
		bigShiftLeft(denominator, bits: exponent)
	end 'liftDenominator' else 'liftNumerator'
		bigShiftLeft(numerator, bits: -exponent)
	end 'liftNumerator'
	if bigCompare(numerator, against: denominator) < 0 'stillBelowOne'
		bigShiftLeft(numerator, bits: 1)
		exponent = exponent - 1
	end 'stillBelowOne'

	// How many significand bits follow the leading one: 52 for a normal, and one fewer for every
	// power of two below 2^-1022, because a subnormal's exponent field is pinned at zero and the
	// leading one has to be spelled out inside the field instead of being implied.
	var significandBits = SignificandFieldBits
	let isSubnormal = exponent < MinNormalBinaryExponent
	if isSubnormal 'denormalize'
		significandBits = exponent - LeastSubnormalBinaryExponent
	end 'denormalize'

	// Below 2^-1074 there is no significand left at all — the entire value is the round bit. Moving
	// the shortfall onto the denominator keeps the division below dividing a proper fraction, so the
	// one rounding rule still decides between +0 and the least subnormal.
	if significandBits < 0 'belowLeastSubnormal'
		bigShiftLeft(denominator, bits: -significandBits)
		significandBits = 0
	end 'belowLeastSubnormal'

	// Long-division: one bit per step, exactly as the i64 version did, but over magnitudes wide
	// enough to hold the operands. The leading bit is taken separately because it is implicit in a
	// normal's encoding and explicit in a subnormal's.
	var significand = 0
	if bigCompare(numerator, against: denominator) >= 0 'leadingOne'
		significand = 1
		bigSubtract(numerator, subtrahend: denominator)
	end 'leadingOne'
	var produced = 0
	while produced < significandBits 'divideBits'
		bigShiftLeft(numerator, bits: 1)
		significand = significand * 2
		if bigCompare(numerator, against: denominator) >= 0 'bitSet'
			significand = significand + 1
			bigSubtract(numerator, subtrahend: denominator)
		end 'bitSet'
		produced = produced + 1
	end 'divideBits'

	// Round-to-nearest-even: produce one more bit and use it, plus whatever residue is left, to
	// decide. Without it the truncation drops up to half a ULP — e.g. 3.14 ended up at 0x...851E
	// (3.1399999999999997) instead of the correctly-rounded 0x...851F.
	//
	// `droppedNonZeroDigit` joins the residue here and NOWHERE else, which is the whole point of the
	// 768-digit budget: a prefix that long can only disagree with the true value about a rounding
	// boundary when it sits exactly ON one, and then the residue is zero and the sticky bit alone
	// says the true value is above it.
	bigShiftLeft(numerator, bits: 1)
	if bigCompare(numerator, against: denominator) >= 0 'halfwayOrAbove'
		bigSubtract(numerator, subtrahend: denominator)
		let aboveHalfway = not numerator.isEmpty() or droppedNonZeroDigit
		if aboveHalfway or (significand and 1) == 1 'roundUp'
			significand = significand + 1
		end 'roundUp'
	end 'halfwayOrAbove'

	if isSubnormal 'subnormalEncoding'
		// Exponent field zero, significand taken whole. A round-up that carried into bit 52 lands
		// exactly on the smallest NORMAL value, which is the right answer and needs no special case:
		// the two encodings are contiguous, so the same integer already spells it.
		return significand
	end 'subnormalEncoding'

	// The magnitude guard above admits values up to 10^309, which is past f64.max, so the exponent
	// can still be out of range here — and a biased exponent past 11 bits would run into the sign
	// bit rather than merely reading as infinity, so it is checked before the shift, not after.
	if exponent > MaxNormalBinaryExponent 'binaryExponentAboveRange'
		throw ParserError.overflow
	end 'binaryExponentAboveRange'

	// IEEE 754 double layout: sign(1) | exponent+1023(11) | significand(52). The sign is the
	// CALLER's (see `negatedFloatBits`). Dropping the implicit leading one by subtraction lets a
	// significand that rounded up to 2^53 carry into the exponent field on its own, which is exactly
	// the renormalization that case wants — and the only way it can then reach the infinity pattern
	// is a genuine overflow of the literal.
	let bits = ((exponent + ExponentBias) shl SignificandFieldBits) + (significand - ImplicitLeadingBit)
	if bits >= InfinityBits 'roundedToInfinity'
		throw ParserError.overflow
	end 'roundedToInfinity'
	return bits
end 'parseFloatBits'

// --- Bounded-width magnitudes for the conversion above ---
//
// `parseFloatBits` is exact rational arithmetic, and that only works if the two cells can actually
// hold `intPart * 10^±exp`. An i64 cannot: `10^k` carries the factor `2^k`, so in 64 bits `10^19`
// already wraps, `10^63` lands on `i64.min` — NEGATIVE, which used to send the normalization loop
// doubling a negative value forever and HANG the compiler on a literal as ordinary as `1.0e63` — and
// `10^64` is exactly zero. Every literal past |exponent| ≈ 19 was silently wrong.
//
// So a magnitude is an array of base-2^32 limbs, little-endian, with NO leading zero limb: an EMPTY
// array is zero, which makes `isEmpty()` the zero test and keeps every operation's cost proportional
// to the value rather than to a fixed width. The radix is 2^32 and not 2^64 because every operation
// here forms a WIDER intermediate before masking back down (`limb * 10^9 + carry` needs 62 bits) and
// Maxon has no cell to form a 128-bit one in.

let LimbBits = 32
let LimbMask = 0xFFFFFFFF

// The widest magnitude the decimal guards in `parseFloatBits` admit. The DENOMINATOR sets it: with
// `magnitudeExp` floored at -324 and `SignificantDigitBudget` digits kept, `totalExp` bottoms out at
// -(324 + 768 - 1), so the denominator reaches 10^1091 — 3625 bits, 114 limbs — and normalization
// then lifts the numerator to the same width. (The numerator alone never exceeds 10^309 / 2^1027,
// because the guard bounds the VALUE, not the digit count.) The headroom is deliberate and the bound
// is CHECKED rather than assumed, because exceeding it means a guard upstream was widened without
// widening this, and an unbounded silent grow is precisely the failure mode this representation
// exists to remove.
let MaxBigLimbs = 144

// A bit position or shift distance inside a magnitude. Non-negative — every caller either passes a
// literal or negates a value it has just tested as negative — and bounded in practice by
// `MaxBigLimbs * LimbBits`, but written open-ended like `CharOffset`: the producers are i64
// subtractions of two bit lengths, and narrowing would only move the check to a cast at each call.
typealias BigBitCount = int(0 to u64.max)

// A power of ten to scale a magnitude by. Bounded by the decimal guards to 1091 — the same figure
// `MaxBigLimbs` is derived from, and it is quoted rather than re-derived for exactly that reason.
typealias DecimalScaleExponent = int(0 to u64.max)

// -1, 0 or 1 as the left magnitude is below, equal to, or above the right.
typealias MagnitudeOrder = int(-1 to 1)

// The largest power of ten that fits a limb, so `bigMulPow10` scales in 9-digit strides instead of
// one digit at a time — the worst-case 1091-digit scaling costs 122 passes rather than 1091.
let Pow10ChunkDigits = 9

// Every site that GROWS a magnitude ends here, so the budget is one fact in one place. There are
// exactly two shapes of growth and both are routed: a carry out the top (`bigPushCarry`) and a
// whole-limb shift's `growFilled` (checked at the end of `bigShiftLeft`).
function requireLimbBudget(limbs ParsedIntArray)
	if limbs.count() > MaxBigLimbs 'overBudget'
		panic("float-literal magnitude grew to {limbs.count()} limbs, past the {MaxBigLimbs}-limb budget — a decimal guard in parseFloatBits was widened without widening MaxBigLimbs")
	end 'overBudget'
end 'requireLimbBudget'

// Flush a pending carry out the top of `limbs` as new high limbs. THE one place a magnitude gets
// wider at the top: `bigAddSmall`, `bigMulSmall` and `bigShiftLeft` all finish this way, and each
// used to spell "push the masked carry, shift it down, check the budget" for itself. Nothing made
// those three agree — one of them dropping the mask, or the budget check, would be a silently
// corrupt high limb rather than a compile error.
function bigPushCarry(limbs ParsedIntArray, carry ParsedInt)
	var remaining = carry
	while remaining > 0 'carryOut'
		limbs.push(remaining and LimbMask)
		remaining = remaining shr LimbBits
	end 'carryOut'

	requireLimbBudget(limbs)
end 'bigPushCarry'

// 10^`digits`, for a `digits` no wider than a limb. The one place a power of ten is built, so the
// chunk stride and the scaling loop cannot come to disagree about what a 9-digit step is worth.
function pow10(digits DecimalScaleExponent) returns ParsedInt
	var factor = 1
	var i = 0
	while i < digits 'multiply'
		factor = factor * 10
		i = i + 1
	end 'multiply'
	return factor
end 'pow10'

// Shift `digits` decimal places into `limbs` and drop `chunk` into the space that opens up — the
// digit-accumulation step, done a chunk at a time rather than a digit at a time.
function bigAppendDigits(limbs ParsedIntArray, chunk ParsedInt, digits DecimalScaleExponent)
	bigMulSmall(limbs, multiplier: pow10(digits))
	bigAddSmall(limbs, addend: chunk)
end 'bigAppendDigits'

// `limbs` += `addend`, in place. `addend` must fit a limb.
function bigAddSmall(limbs ParsedIntArray, addend ParsedInt)
	var carry = addend
	var i = 0
	while carry > 0 and i < limbs.count() 'addEach'
		let widened = (try limbs.get(i) otherwise panic("bigAddSmall: i < count() by loop guard but get({i}) failed")) + carry
		try limbs.set(i, value: widened and LimbMask) otherwise panic("bigAddSmall: set({i}) failed at an index get just accepted")
		carry = widened shr LimbBits
		i = i + 1
	end 'addEach'

	bigPushCarry(limbs, carry: carry)
end 'bigAddSmall'

// `limbs` *= `multiplier`, in place. `multiplier` must fit a limb so that `limb * multiplier + carry`
// stays inside an i64 — the one obligation the whole representation rests on.
function bigMulSmall(limbs ParsedIntArray, multiplier ParsedInt)
	var carry = 0
	var i = 0
	while i < limbs.count() 'scaleEach'
		let widened = (try limbs.get(i) otherwise panic("bigMulSmall: i < count() by loop guard but get({i}) failed")) * multiplier + carry
		try limbs.set(i, value: widened and LimbMask) otherwise panic("bigMulSmall: set({i}) failed at an index get just accepted")
		carry = widened shr LimbBits
		i = i + 1
	end 'scaleEach'

	bigPushCarry(limbs, carry: carry)
end 'bigMulSmall'

// `limbs` *= 10^`exponent`, in place.
function bigMulPow10(limbs ParsedIntArray, exponent DecimalScaleExponent)
	var remaining = exponent
	while remaining > 0 'chunks'
		var digits = Pow10ChunkDigits
		if remaining < digits 'lastChunk'
			digits = remaining
		end 'lastChunk'

		bigMulSmall(limbs, multiplier: pow10(digits))
		remaining = remaining - digits
	end 'chunks'
end 'bigMulPow10'

// `limbs` <<= `bits`, in place.
function bigShiftLeft(limbs ParsedIntArray, bits BigBitCount)
	if limbs.isEmpty() or bits == 0 'nothingToShift'
		return
	end 'nothingToShift'

	let withinLimb = bits mod LimbBits
	if withinLimb != 0 'partialLimb'
		var carry = 0
		var i = 0
		while i < limbs.count() 'shiftEach'
			let widened = ((try limbs.get(i) otherwise panic("bigShiftLeft: i < count() by loop guard but get({i}) failed")) shl withinLimb) or carry
			try limbs.set(i, value: widened and LimbMask) otherwise panic("bigShiftLeft: set({i}) failed at an index get just accepted")
			carry = widened shr LimbBits
			i = i + 1
		end 'shiftEach'

		bigPushCarry(limbs, carry: carry)
	end 'partialLimb'

	// The whole-limb part moves every limb up in ONE pass. Repeated `insert(0, …)` would be
	// Θ(wholeLimbs × count), and normalization shifts by up to the operand's full width — precisely
	// the shape that turns that into a quadratic.
	let wholeLimbs = bits / LimbBits
	if wholeLimbs > 0 'wholeLimbShift'
		let usedBefore = limbs.count()
		limbs.growFilled(usedBefore + wholeLimbs, value: 0)

		var src = usedBefore
		while src > 0 'moveUp'
			src = src - 1
			let limb = try limbs.get(src) otherwise panic("bigShiftLeft: src < usedBefore <= count() but get({src}) failed")
			try limbs.set(src + wholeLimbs, value: limb) otherwise panic("bigShiftLeft: growFilled sized for src + wholeLimbs but set({src + wholeLimbs}) failed")
		end 'moveUp'

		var vacated = 0
		while vacated < wholeLimbs 'clearVacated'
			try limbs.set(vacated, value: 0) otherwise panic("bigShiftLeft: vacated < wholeLimbs <= count() but set({vacated}) failed")
			vacated = vacated + 1
		end 'clearVacated'
	end 'wholeLimbShift'

	requireLimbBudget(limbs)
end 'bigShiftLeft'

// The position of the highest set bit, counting from one. Zero has bit length zero.
function bigBitLength(limbs ParsedIntArray) returns BigBitCount
	if limbs.isEmpty() 'zero'
		return 0
	end 'zero'

	let topIndex = limbs.count() - 1
	var top = try limbs.get(topIndex) otherwise panic("bigBitLength: topIndex = count() - 1 but get({topIndex}) failed")
	var bitsInTop = 0
	while top > 0 'countTopBits'
		bitsInTop = bitsInTop + 1
		top = top shr 1
	end 'countTopBits'
	return topIndex * LimbBits + bitsInTop
end 'bigBitLength'

// Ordering. The no-leading-zero-limb invariant is what makes the width comparison decisive.
function bigCompare(a ParsedIntArray, against ParsedIntArray) returns MagnitudeOrder
	if a.count() != against.count() 'differentWidths'
		return -1 if a.count() < against.count() else 1
	end 'differentWidths'

	var i = a.count()
	while i > 0 'compareLimbs'
		i = i - 1
		let av = try a.get(i) otherwise panic("bigCompare: i < a.count() but get({i}) failed")
		let bv = try against.get(i) otherwise panic("bigCompare: counts are equal but against.get({i}) failed")
		if av != bv 'differs'
			return -1 if av < bv else 1
		end 'differs'
	end 'compareLimbs'
	return 0
end 'bigCompare'

// `a` -= `subtrahend`, in place. The caller guarantees `a >= subtrahend`; every call site has just
// compared the two.
function bigSubtract(a ParsedIntArray, subtrahend ParsedIntArray)
	var borrow = 0
	var i = 0
	while i < a.count() 'subtractEach'
		var diff = (try a.get(i) otherwise panic("bigSubtract: i < count() by loop guard but a.get({i}) failed")) - borrow
		if i < subtrahend.count() 'hasSubtrahendLimb'
			diff = diff - (try subtrahend.get(i) otherwise panic("bigSubtract: i < subtrahend.count() just checked but get({i}) failed"))
		end 'hasSubtrahendLimb'

		if diff < 0 'borrowFromNext'
			diff = diff + LimbMask + 1
			borrow = 1
		end 'borrowFromNext' else 'noBorrow'
			borrow = 0
		end 'noBorrow'

		try a.set(i, value: diff) otherwise panic("bigSubtract: set({i}) failed at an index get just accepted")
		i = i + 1
	end 'subtractEach'

	// A subtraction can only shrink a magnitude, so restoring the no-leading-zero-limb invariant is
	// the only normalization it needs.
	var used = a.count()
	while used > 0 and (try a.get(used - 1) otherwise panic("bigSubtract: used > 0 by loop guard but get({used - 1}) failed")) == 0 'trimLeadingZeroLimbs'
		used = used - 1
	end 'trimLeadingZeroLimbs'
	a.resize(used)
end 'bigSubtract'

// Parse an integer literal. Throws ParserError.overflow if the value exceeds i64 range.
// Handles decimal, hex (0x), binary (0b), and octal (0o) prefixes.
//
// Takes the literal's BYTES — the caller hands over the token's zero-copy slice of the
// source directly. This function only ever read the digits as bytes (as the prefix
// helpers below always have); a `String` parameter merely meant every caller built one
// so that the first statement here could immediately unbuild it again.
export function parseInt(bytes ByteArray) returns ParsedInt throws ParserError
	let sLen = bytes.count()

	if sLen < 1 'empty'
		return 0
	end 'empty'

	if sLen >= 2 'checkPrefix'
		let first = try bytes.get(0) otherwise panic("parseInt.checkPrefix: sLen >= 2 just checked but get(0) failed")
		let second = try bytes.get(1) otherwise panic("parseInt.checkPrefix: sLen >= 2 just checked but get(1) failed")

		if first == '0' and (second == 'x' or second == 'X') 'isHex'
			return try parseHexInt(bytes, startIndex: 2)
		end 'isHex' else if first == '0' and (second == 'b' or second == 'B') 'isBin'
			return try parseBinaryInt(bytes, startIndex: 2)
		end 'isBin' else if first == '0' and (second == 'o' or second == 'O') 'isOct'
			return try parseOctalInt(bytes, startIndex: 2)
		end 'isOct'
	end 'checkPrefix'

	var result = 0
	var digitCount = 0
	var leadingZeros = true
	for pi in 0 upto sLen 'digits'
		let b = try bytes.get(pi) otherwise panic("parseInt.digits: pi < sLen = bytes.count() but get({pi}) failed")
		if b >= '0' and b <= '9' 'digit'
			result = result * 10 + (b - '0')
			if not leadingZeros or b != '0' 'significant'
				leadingZeros = false
				digitCount = digitCount + 1
			end 'significant'
		end 'digit'
	end 'digits'

	// >19 significant digits always overflows i64
	if digitCount > 19 'tooMany'
		throw ParserError.overflow
	end 'tooMany'

	// Exactly 19 digits: compare digit-by-digit against i64.max
	if digitCount == 19 'checkMax'
		var mi = 0
		var pastLeading = false
		for pi in 0 upto sLen 'cmp'
			let b = try bytes.get(pi) otherwise panic("parseInt.cmp: pi < sLen but get({pi}) failed")
			if b == '_' 'skipUs'
				continue
			end 'skipUs'
			if not pastLeading and b == '0' 'skipLz'
				continue
			end 'skipLz'
			if b >= '0' and b <= '9' 'cmpDigit'
				pastLeading = true
				let maxByte = try I64MaxDigits.get(mi) otherwise panic("parseInt.cmp: digitCount==19 so mi < 19 = I64MaxDigits.count() but get({mi}) failed")
				if b > maxByte 'bigger'
					throw ParserError.overflow
				end 'bigger' else if b < maxByte 'smaller'
					return result
				end 'smaller'
				mi = mi + 1
			end 'cmpDigit'
		end 'cmp'
	end 'checkMax'

	return result
end 'parseInt'

// Parse a NEGATED integer literal magnitude `s` (the digits after a leading
// unary `-`). The magnitude `9223372036854775808` (= i64.max + 1) overflows a
// positive i64 but `-9223372036854775808` is exactly i64.min, so it is accepted
// here and returned as i64.min — mirroring the C# bootstrap's
// `ParseNegatedIntegerLiteral`. Every other magnitude parses through `parseInt`
// (which throws on a true overflow) and is negated. The caller must apply this
// ONLY when a `-` immediately precedes the literal.
export function parseNegatedInt(bytes ByteArray) returns ParsedInt throws ParserError
	if digitsWithoutSeparators(bytes).equals(I64MinMagnitudeDigits) 'isI64Min'
		return i64.min
	end 'isI64Min'
	return 0 - (try parseInt(bytes))
end 'parseNegatedInt'

// The literal's digits with `_` separators removed, so a magnitude can be compared
// against a fixed digit string. Only the i64.min check needs this: every other path
// skips separators inline as it scans.
function digitsWithoutSeparators(bytes ByteArray) returns ByteArray
	var digits = ByteArray.create()
	for b in bytes 'each'
		if b != '_' 'keep'
			digits.push(b)
		end 'keep'
	end 'each'
	return digits
end 'digitsWithoutSeparators'

// Parse a hex integer literal. Throws ParserError.overflow if more than 16 significant hex digits.
function parseHexInt(s ByteArray, startIndex CharOffset) returns ParsedInt throws ParserError
	var result = 0
	var digitCount = 0
	var leadingZeros = true
	for pi in startIndex upto s.count() 'hexDigits'
		let b = try s.get(pi) otherwise panic("parseHexInt.hexDigits: pi < s.count() but get({pi}) failed")
		if b >= '0' and b <= '9' 'decDigit'
			result = result * 16 + (b - '0')
			if not leadingZeros or b != '0' 'sigDec'
				leadingZeros = false
				digitCount = digitCount + 1
			end 'sigDec'
		end 'decDigit' else if b >= 'a' and b <= 'f' 'lowerHex'
			result = result * 16 + (b - 'a' + 10)
			leadingZeros = false
			digitCount = digitCount + 1
		end 'lowerHex' else if b >= 'A' and b <= 'F' 'upperHex'
			result = result * 16 + (b - 'A' + 10)
			leadingZeros = false
			digitCount = digitCount + 1
		end 'upperHex'
	end 'hexDigits'
	if digitCount > 16 'overflow'
		throw ParserError.overflow
	end 'overflow'
	return result
end 'parseHexInt'

// Throws ParserError.overflow if more than 64 significant binary digits.
function parseBinaryInt(s ByteArray, startIndex CharOffset) returns ParsedInt throws ParserError
	var result = 0
	var digitCount = 0
	var leadingZeros = true
	for pi in startIndex upto s.count() 'binDigits'
		let b = try s.get(pi) otherwise panic("parseBinaryInt.binDigits: pi < s.count() but get({pi}) failed")
		if b == '0' 'zeroBit'
			result = result * 2
			if not leadingZeros 'sigZero'
				digitCount = digitCount + 1
			end 'sigZero'
		end 'zeroBit' else if b == '1' 'oneBit'
			result = result * 2 + 1
			leadingZeros = false
			digitCount = digitCount + 1
		end 'oneBit'
	end 'binDigits'
	if digitCount > 64 'overflow'
		throw ParserError.overflow
	end 'overflow'
	return result
end 'parseBinaryInt'

// Throws ParserError.overflow if more than 21 significant octal digits,
// or exactly 21 with a leading digit > 1 (exceeds 64 bits).
function parseOctalInt(s ByteArray, startIndex CharOffset) returns ParsedInt throws ParserError
	var result = 0
	var digitCount = 0
	var leadingZeros = true
	var firstSignificantDigit = 0
	for pi in startIndex upto s.count() 'octDigits'
		let b = try s.get(pi) otherwise panic("parseOctalInt.octDigits: pi < s.count() but get({pi}) failed")
		if b >= '0' and b <= '7' 'octDigit'
			result = result * 8 + (b - '0')
			if not leadingZeros or b != '0' 'significant'
				if leadingZeros 'firstSig'
					firstSignificantDigit = b - '0'
				end 'firstSig'
				leadingZeros = false
				digitCount = digitCount + 1
			end 'significant'
		end 'octDigit'
	end 'octDigits'
	// 64 bits = 21 octal digits max, but first digit can be at most 1 (0o1777...7)
	if digitCount > 21 or (digitCount == 21 and firstSignificantDigit > 1) 'overflow'
		throw ParserError.overflow
	end 'overflow'
	return result
end 'parseOctalInt'
