// Diagnostics — the compiler's user-facing error channel, plus the driver-level
// `CompileError` the query/build pipeline throws.
//
// THIN for maxon-shv2 M1: a `Diagnostic` is a code + message + optional source
// position, accumulated on `Project.diagnostics` by the semantic checker (and,
// as the pipeline grows, by every reporting pass). The driver prints them and
// bails. v1's richer diagnostic machinery (severity tiers, related-note spans,
// first-error suppression, the full 4-digit ErrorCode registry) grows back as
// consumers need it; M1 needs exactly the two `basics.md` semantic errors.

// The 4-digit error codes M1 emits. Named constants, not bare string literals —
// the exact code text is part of the spec contract (`specs-shv2/basics.md`), so
// it lives in one place. Grows into a full ErrorCode registry as more checks
// land (v1 has hundreds).
//
// `noMainFunction` / `mainWrongReturnType` are the two `basics.md` semantic
// codes with exact spec-gated text. `parserExpectedToken` (E2010) is the
// positioned "Expected X but got Y" parse diagnostic that `variables.md`'s
// type-annotation-rejection tests gate on. `parserExpectedExpression` (E2004) is
// the positioned "Expected expression but got X" diagnostic the parser raises when
// a primary is required but the token stream has something else — `unary-operators.md`'s
// double-negation test gates on it (`- -x` fails at the second `-`). `lexerError` /
// `parserError` are generic placeholders the query layer reports the remaining
// front-end failures under — the authored specs never trigger them (every other
// authored program lexes and parses cleanly), so they carry no spec-gated text yet
// and split into specific codes when a spec needs a particular front-end diagnostic.
export enum ErrorCode
	// Duplicate-definition codes — a name declared twice where exactly one binding is
	// legal. `duplicateFunction` (E2001) fires at MERGE time when two functions share a
	// name (the second would silently overwrite the first in `funcSignatures`, so a call
	// would validate against the wrong signature); `duplicateParameter` (E2002) fires at
	// PARSE time when one parameter list repeats a name (a dead, uncallable parameter).
	// Both are positioned at the offending (later) declaration.
	duplicateFunction = "E2001"
	duplicateParameter = "E2002"
	noMainFunction = "E3001"
	mainWrongReturnType = "E3002"
	parserExpectedExpression = "E2004"
	parserExpectedToken = "E2010"
	lexerError = "E1001"
	parserError = "E3010"
	// M4b control-flow / mutation codes. `assignToImmutable` (E2013) matches the
	// C# compiler's "cannot assign to immutable variable" code; `controlOutsideLoop`
	// (E2047) and `labelTargetsOwnLoop` (E2048) are the break/continue placement
	// diagnostics (`specs/break.md` gates the own-label text on E2048).
	assignToImmutable = "E2013"
	controlOutsideLoop = "E2047"
	labelTargetsOwnLoop = "E2048"
	// M5 call-argument codes. The two `E205x` codes are PARSE-time argument-label
	// syntax errors (positioned at the offending token by the parser): a first
	// argument cannot carry a `name:` label, and every argument after the first must.
	// The four `E303x` codes are SEMANTIC-time call checks (positioned at the call
	// site / the offending argument by SemanticCheck, which alone has the callee's
	// signature): the callee must exist, the argument count must match, every `name:`
	// label must name a parameter, and no two arguments may target one parameter.
	callFirstArgNamed = "E2052"
	callArgMissingLabel = "E2053"
	callUnknownFunction = "E3030"
	callArgCountMismatch = "E3031"
	callUnknownArgLabel = "E3032"
	callDuplicateArg = "E3033"
end 'ErrorCode'

// One reported problem. `line` / `column` are 1-based source positions, or 0
// when the diagnostic has no single anchor (E3001 "no main" is whole-program).
// `filePath` is the declaring file, empty when program-wide. The rendered form
// (`error <code>: <message>`) matches the `maxoncstderr` spec blocks exactly.
export type Diagnostic
	export let code as ErrorCode
	export let message as String
	export let line as LineNumber
	export let column as ColumnNumber
	export let filePath as FilePath

	export static function create(code ErrorCode, message String, line LineNumber = 0, column ColumnNumber = 0, filePath FilePath = FilePath from "") returns Diagnostic
		return Self{code: code, message: message, line: line, column: column, filePath: filePath}
	end 'create'

	// Render as `error <code>: <message>` — the exact wire format the spec's
	// `maxoncstderr` blocks compare against. The code's `.rawValue` is the 4-digit
	// string.
	//
	// A POSITIONED diagnostic (one with a real source line — parser/lexer errors,
	// e.g. E2010) renders a `<file>:<line>:<col>:` prefix before the message, which
	// `variables.md`'s type-annotation tests gate on. A whole-program semantic error
	// (E3001/E3002) carries no anchor (`line == 0`), so it renders bare, exactly as
	// `basics.md` expects. `line == 0` is the discriminator because 1-based source
	// lines start at 1 — line 0 is unreachable for a real span.
	export function render() returns String
		if self.line == 0 'wholeProgram'
			return "error {self.code.rawValue}: {self.message}"
		end 'wholeProgram'
		return "error {self.code.rawValue}: {self.filePath.toString()}:{self.line}:{self.column}: {self.message}"
	end 'render'
end 'Diagnostic'

export typealias DiagnosticArray = Array with Diagnostic

// Driver / query-pipeline failure modes. Distinct from a `Diagnostic`: a
// `CompileError` is thrown to unwind the build, whereas diagnostics accumulate
// and are rendered. `compileError` is the catch-all raised once one or more
// diagnostics have been reported (the driver has already printed them, so its
// handler stays silent for this arm — see Main.maxon).
export union CompileError implements Error
	fileNotFound(path FilePath)
	directoryNotFound(path FilePath)
	noSourceFiles(root FilePath)
	readError(path FilePath)
	compileError
end 'CompileError'

// Construct and report a positioned diagnostic in one call. The single funnel
// the front-end error mappers (reportLexerError / reportParseError) route each
// match arm through, so the `Diagnostic.create` + `reportDiagnostic` pairing is
// not respelled at every arm. (`reportDiagnostic` — the raw sink — lives in
// Project.maxon alongside the diagnostics field.)
export function reportPositioned(project Project, code ErrorCode, message String, line LineNumber, column ColumnNumber, filePath FilePath)
	reportDiagnostic(project, diagnostic: Diagnostic.create(code, message: message, line: line, column: column, filePath: filePath))
end 'reportPositioned'
