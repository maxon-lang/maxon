	try listWhitelistedModule(stdlibDir, relative: "helpers/string/utf8.maxon", into: listed)
	try listWhitelistedModule(stdlibDir, relative: "helpers/string/hash.maxon", into: listed)
	try listWhitelistedModule(stdlibDir, relative: "helpers/string/grapheme.maxon", into: listed)
