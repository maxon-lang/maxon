// Runtime/VectorRuntime.maxon — the ONE thing a `Vector` needs that no other container does: the element
// access whose bounds proof was already discharged, at COMPILE time, by the call site.
//
// ⭐ **A `Vector` CARRIES ITS SIZE IN ITS TYPE, AND THAT IS THE WHOLE REASON THIS FILE EXISTS.** Every other
// container's length is a runtime field, so `get`/`set` must test it; a `Vector with (int, 4)` publishes its
// count in the type, so a CONSTANT index inside it is a test the compiler has already performed.
// `Parser.elementAccessCallee` performs it and then names the entries here.
//
// ⚠ **THE STORAGE IS STILL THE MANAGED BUFFER'S, AND THESE TWO ENTRIES ARE STILL ITS OPERATIONS** — they
// carry the `__managed_` prefix, ride the buffer runtime's `usesManagedMemory` install, and reach the record
// through `ManagedMemoryRuntime`'s own load/store/detach helpers. Only the ELISION is `Vector`'s, and the
// elision is what lives here. A `__vec_` prefix would need a usage bit and an install of its own — a
// behaviour change, where the split of the SOURCE is not one.

// ⭐⭐ **THE ELEMENT ACCESS WHOSE BOUNDS PROOF WAS DISCHARGED AT THE CALL SITE (S2m-b)** — `__managed_get` and
// `__managed_set` minus the `index < 0 or index >= length` test and the out-of-range return it guards, and
// identical to them in every other respect. `Parser.elementAccessCallee` picks these when the container
// carries its SIZE in its TYPE (only a `Vector` does) and the index is a compile-time constant inside it,
// so the test they drop is one whose answer the compiler already computed.
//
// ⭐ **THEY ARE STILL DECLARED THROWING, AND THAT IS THE SURFACE'S FACT RATHER THAN A HEDGE.**
// `stdlib/Array.maxon` declares `get`/`set` as `throws ArrayError` and a `Vector` publishes that surface, so
// the author writes `try v.get(0) otherwise …` whatever the index is — `/specs/vector.md` writes exactly that
// on every one of its cases. A NON-throwing entry here would make the `try` an E3055 on a program the
// canonical corpus and both reference compilers accept, which is a language change wearing an
// optimization's clothes. What the proof discharges is the ONE failure the clause admits for a vector, not
// the clause; the caller's dual-register protocol is untouched, and `__managed_get_in_bounds` still reports the
// EMPTY-SLOT failure through it (unreachable for a vector, whose element can never be managed — see
// `requireVectorElementType` — and correct for any future sized container whose element can).
//
// ⚠ **NOT `__managed_get_unchecked`, WHICH ALREADY EXISTS AND DROPS THE SAME TEST.** That one is NON-throwing
// (see its header: a `for … in` loop has no `try` to attach), so a call to it under a `try` is E3055 and a
// `tryCall` to it would read an error-flag register the callee never writes. The two differ in the RETURN
// SHAPE, not in the check, and the shape is what each caller needs.
export let ManagedGetInBoundsName = b"__managed_get_in_bounds"
export let ManagedSetInBoundsName = b"__managed_set_in_bounds"

// ⭐ **THE ELIDED TWIN OF A CHECKED ELEMENT ACCESSOR** — the one place the two pairs are related, read by
// `Parser.elementAccessCallee` once it has PROVED the index in range. Total over the two accessors a proof
// can reach: only a `Vector` carries its size in its type, and a vector's whole surface is
// `count`/`get`/`set` plus `for … in` (`Parser.dispatchVectorMethod`), so `insert`, `slice`, `pop`,
// `remove` and the buffer's own `__managed_mem_set` cannot arrive here at all. It panics rather than answering
// `checked` for them, because an identity answer would be a sentinel that silently disables the elision the
// day a sized container grows a fourth member.
export function inBoundsElementAccessor(checked ByteArray) returns ByteArray
	if checked.equals(ManagedGetName) 'get'
		return ManagedGetInBoundsName
	end 'get'

	if checked.equals(ManagedSetName) 'set'
		return ManagedSetInBoundsName
	end 'set'

	panic("inBoundsElementAccessor: '{String.from(checked)}' has no in-bounds twin. The elision is reachable only where the container's SIZE is part of its TYPE, which today is `Vector` alone, and a vector publishes exactly `{String.from(GetMethod)}` and `{String.from(ArraySetMethod)}` as indexed members — so either a sized container gained an indexed member without one being built here, or `Parser.elementAccessCallee` proved an index in range for a callee it must not have")
end 'inBoundsElementAccessor'

// `__managed_get_in_bounds(arr, index) -> (value, flag)` — the read whose index the CALL SITE proved in range
// (see `ManagedGetInBoundsName`). `buildManagedGet` minus its `entry` bounds test and its `oob` block, and nothing
// else: the element load, the element-destructor gate and the empty-slot arm are the same three lines,
// through the same helper.
export function buildManagedGetInBounds(module StdModule)
	var func = IrFunction.createFromStd(ManagedGetInBoundsName, returnType: StdReturnType.value(StdType.i64), paramCount: 2, paramTypes: twoI64Params(), returnLine: 0, throwsTypeName: arrayErrorThrows())
	var ids = ValueMinter.create(2)

	var entry = module.addBlock(func, label: b"entry")
	emitParams(module, block: entry, count: 2)
	let arr = 0 as ValueId
	let index = 1 as ValueId

	emitGetLoadAndReturn(module, func: func, cur: entry, arr: arr, index: index, ids: ids)

	module.functions.push(func)
end 'buildManagedGetInBounds'

// `__managed_set_in_bounds(arr, index, value) -> (_, flag)` — the write whose index the CALL SITE proved in
// range (see `ManagedSetInBoundsName`). `buildManagedSet` minus its `entry` bounds test and its `oob` block, and
// nothing else — the detach and the store are the same two lines through the same helpers.
//
// ⭐ **THE REJECTED-ELEMENT DESTROY GOES WITH THE `oob` BLOCK IT BELONGED TO, AND THAT IS NOT AN OMISSION.**
// `emitDestroyRejectedElement` exists because a MOVED-IN element the setter refuses to store is owned by
// nobody (R4.6, measured as exit 101). This entry refuses nothing, so there is no rejected element — the
// array becomes the owner on the one path this function has.
export function buildManagedSetInBounds(module StdModule)
	var func = IrFunction.createFromStd(ManagedSetInBoundsName, returnType: StdReturnType.value(StdType.i64), paramCount: 3, paramTypes: threeI64Params(), returnLine: 0, throwsTypeName: arrayErrorThrows())
	var ids = ValueMinter.create(3)

	var entry = module.addBlock(func, label: b"entry")
	emitParams(module, block: entry, count: 3)
	let arr = 0 as ValueId
	let index = 1 as ValueId
	let value = 2 as ValueId

	emitCowDetach(module, block: entry, arr: arr, ids: ids)
	emitElementStoreAndOkReturn(module, func: func, store: entry, arr: arr, index: index, value: value, ids: ids)

	module.functions.push(func)
end 'buildManagedSetInBounds'
