// Runtime/FnRefThunk.maxon — the `__fnref_<name>` environment thunks that make a PLAIN named function
// usable as a first-class value under the uniform `(userargs, env)` calling convention (P1.5-A2b-2).
//
// ⭐ **WHY A WRAPPER, AND WHY ONLY FOR PLAIN FUNCTIONS.** A function VALUE is called through ONE uniform
// indirect signature `(userargs, env) -> R`: a value passed DOWN to a generic `apply(f, x)` is called
// `f(x, env)` with no static knowledge of whether it captures, so every callable value must accept the
// trailing env. A LIFTED CLOSURE already carries that shape (its `__env` parameter — see
// `Parser.parseClosureExpression`). A plain named function `triple(n)` does NOT, and it cannot simply gain
// the parameter: its DIRECT calls `triple(10)` must stay `(userargs) -> R` (unchurned — and on wasm a
// direct `call`'s arity is checked too). So `functionRef(triple)` materializes the address of a thunk
// `__fnref_triple(n, __env)` whose signature IS `(userargs, env) -> R` — it ignores `__env` and forwards to
// `triple`. On wasm the `call_indirect` functype is arg-count-derived, so the table element's own functype
// must match; on register targets the extra arg would be harmless, but ONE thunk keeps a single
// cross-target lowering. This is v1's `__fnref_` design (LowerMaxonToStd.maxon:11408) — its knowledge, not
// its cost curve: the thunk is synthesized once per referenced plain function, not per reference.
//
// ⚠ HIGHER-ORDER FUNCTION VALUES ARE OUT OF SCOPE. Binding a function that ITSELF takes a function
// parameter as a value (`let g = apply`) would need the thunk to forward `apply`'s hidden companion-env
// parameters too — a fact this thunk does not have. No enabled case does this; `functionRef` of such a
// function is not reached at this rung.

// A set of symbol names, for O(1) dedup while collecting thunk targets in source order.
export typealias FnRefThunkSet = Set with ByteArray

// True iff `name` is a lifted closure's synthesized name — `<enclosing>$closure_<k>` (see
// `Parser.parseClosureExpression`). The `$` byte is the tell: it is unwritable in a Maxon identifier and no
// other synthesized name contains it, so a function name carrying it is a lifted closure and nothing else —
// which is exactly what tells a closure (already `(userargs, __env)`-shaped) from a plain function (whose
// value use needs a thunk). (Inline `'$'` is the Lexer's char-comparison idiom; a top-level char constant is
// not a constant expression in the bootstrap.)
export function isLiftedClosureName(name ByteArray) returns bool
	for b in name 'each'
		if b == '$' 'marker'
			return true
		end 'marker'
	end 'each'
	return false
end 'isLiftedClosureName'

// The name of the env-thunk for plain function `funcName`. ONE builder, shared by the reference lowering
// (`LowerMaxonToStd.lowerFunctionRef`, which emits `funcAddr(__fnref_<name>)`) and the synthesis below, so
// the two spellings of the name cannot drift.
export function fnRefThunkName(funcName ByteArray) returns ByteArray
	return "__fnref_{String.from(funcName)}".toByteArray()
end 'fnRefThunkName'

// Collect every PLAIN function referenced as a value (`functionRef`), in first-seen source order, deduped.
// A lifted closure is skipped — it carries its own `__env` parameter and needs no thunk. Read post-pipeline
// by `installFnRefThunks`; the walk mirrors `StringRuntime.scanRuntimeUsage`'s — one linear pass over the
// Maxon ops.
export function collectFnRefThunkTargets(module MaxonModule) returns ByteArrayArray
	var seen = FnRefThunkSet.create()
	var targets = ByteArrayArray.create()
	for func in module.functions 'eachFunc'
		for blockRef in func.blockRefs 'eachBlock'
			let block = try module.blocks.get(blockRef) otherwise panic("collectFnRefThunkTargets: blockRef from func.blockRefs not in module.blocks")
			for opIdx in block.opRefs 'eachOp'
				let op = try module.ops.get(opIdx) otherwise panic("collectFnRefThunkTargets: opIdx {opIdx} not in module.ops")
				noteIfFunctionRef(op, seen: seen, targets: targets)
			end 'eachOp'
		end 'eachBlock'
	end 'eachFunc'
	return targets
end 'collectFnRefThunkTargets'

// Record a `functionRef` op's PLAIN target for thunking. It RANGES over the whole `MaxonOp` union so a
// newly-appended op FAILS TO COMPILE here rather than being silently ignored (the band-append invariant):
// `call to panicAbort` is every op before `functionRef`, `indirectCall` the one after it.
function noteIfFunctionRef(op MaxonOp, seen FnRefThunkSet, targets ByteArrayArray)
	match op 'op'
		call to panicAbort then break 'op'
		functionRef(_, funcName) then noteFnRefTarget(funcName, seen: seen, targets: targets)
		indirectCall then break 'op'
		// P1.5-B1a/B2b: an async spawn takes the DIRECT function's address in lowering (not a `functionRef`
		// through the uniform `(userargs, env)` ABI — the trampoline calls it with user args only), so it
		// names no thunk target; `await`/`try await` reference no function value.
		asyncCall to tryAwait then break 'op'
		sizeofType then break 'op'
		byteStringLiteral then break 'op'
	end 'op'
end 'noteIfFunctionRef'

// A plain (non-closure) target seen for the first time joins the ordered thunk list. A lifted closure
// carries its own `__env` and needs no thunk; a COMPILER-INTERNAL callee (`__`-prefixed — an array element
// destructor addressed for `element_destroy@40`, P1.7 slice 3) is invoked through a bare `callIndirect(ptr)`
// in the drop walk, not the uniform closure ABI, so it gets no `__fnref_` thunk either (`lowerFunctionRef`
// takes its bare address). The `__` prefix is the same discriminator that lowering reads.
function noteFnRefTarget(funcName ByteArray, seen FnRefThunkSet, targets ByteArrayArray)
	if isLiftedClosureName(funcName) or isCompilerInternalCallee(funcName) 'noThunk'
		return
	end 'noThunk'
	if seen.contains(funcName) 'already'
		return
	end 'already'
	seen.insert(funcName)
	targets.push(funcName)
end 'noteFnRefTarget'

// Synthesize the `__fnref_<name>` env-thunk for every plain function used as a value. Appended
// already-lowered AFTER the pipeline (like the destructor cascades), so they are never re-optimized and
// still flow through the whole backend (ISel, register allocation, frames) — and on wasm get a funcref-table
// slot at their funcIdx, which is what `funcAddr(__fnref_<name>)` materializes.
export function installFnRefThunks(module StdModule, project Project, targets ByteArrayArray)
	for target in targets 'each'
		synthesizeFnRefThunk(module, project: project, targetName: target)
	end 'each'
end 'installFnRefThunks'

// Emit `__fnref_<name>(userargs..., __env) -> R`:
//
//   entry: materialize each parameter (the trailing `__env` is discarded), `call <name>(userargs...)`,
//          `ret` the result.
//
// ⭐ EACH USER PARAMETER TAKES THE TARGET'S REAL TYPE, the trailing `__env` an i64 (P1.5 #78). A FLOAT
// parameter is an f64: the thunk must capture it from a float argument register and forward it to the
// target — which reads it from a float register too — so a float user param typed i64 here would forward
// a GPR value into the target's XMM parameter (a cross-register-file move). Everything else (int / named /
// String / struct-pointer) is an i64 machine word exactly as before. The caller's indirect-call argument
// routing uses this same float classification (the `argFloatMask` the `callIndirect` carries), so caller, thunk, and target
// agree on every argument's register file. The forwarded call is a DIRECT `call` to the target by name (a
// wasm `call`, arity- and type-checked against the target's OWN `(userargs) -> R` functype), so the thunk
// is precisely what bridges the uniform indirect signature to the target's direct one.
function synthesizeFnRefThunk(module StdModule, project Project, targetName ByteArray)
	let sig = try project.funcSignatures.get(targetName) otherwise panic("synthesizeFnRefThunk: no signature for '{String.from(targetName)}' — a functionRef must name a registered function")
	let ret = try project.funcReturnTypes.get(targetName) otherwise panic("synthesizeFnRefThunk: no return type for '{String.from(targetName)}'")
	let userParamCount = sig.paramCount()
	let thunkParamCount = (userParamCount + 1) as ParamCount
	let targetReturn = maxonReturnTypeToStdReturnType(ret)

	var paramTypes = StdTypeArray.create()
	for i in 0 upto userParamCount 'eachUserParamType'
		paramTypes.push(thunkUserParamStdType(try sig.paramTypes.get(i) otherwise panic("synthesizeFnRefThunk: sig.paramTypes.get OOB at {i} for '{String.from(targetName)}'")))
	end 'eachUserParamType'
	// The trailing companion `__env` pointer is always an i64 machine word.
	paramTypes.push(StdType.i64)

	// ⭐ THE UNIFORM `(userargs, env) -> R` INDIRECT ABI ALWAYS YIELDS ONE MACHINE WORD (P1.5 #68). A
	// value-returning target forwards its result; a VOID target's word is a DUMMY the caller discards —
	// mirroring a void DIRECT call, whose return register holds a garbage integer nobody reads
	// (StdLoweringShared.calleeResultClass). The single result slot is not optional: on wasm the
	// `call_indirect` type check demands the funcref present exactly the one result the caller declares
	// (`emitCallIndirect` always `local.set`s it), and `LowerMaxonToStd.indirectResultType` declares that
	// result an i64 for a void function value — so the thunk must return an i64 to match. This is what makes
	// `let cb = doIt; cb()` callable, where a `panic` stood while statement-position indirect calls were
	// unsupported.
	let func = IrFunction.createFromStd(fnRefThunkName(targetName), returnType: fnRefThunkReturnType(targetReturn), paramCount: thunkParamCount, paramTypes: paramTypes, returnLine: 0)
	var entry = module.addBlock(func, label: b"entry")
	emitTypedParams(module, block: entry, paramTypes: paramTypes)

	var forwardArgs = ValueIdArray.create()
	for i in 0 upto userParamCount 'eachArg'
		forwardArgs.push(i as ValueId)
	end 'eachArg'

	let callResult = thunkParamCount
	module.appendOp(entry, op: StdOp.call(callResult, callee: targetName, args: forwardArgs))
	emitFnRefThunkReturn(module, block: entry, targetReturn: targetReturn, callResult: callResult)

	module.functions.push(func)
end 'synthesizeFnRefThunk'

// The thunk's OWN Std return type: a value-returning target's is forwarded unchanged; a VOID target's is
// `value(i64)`, because the uniform indirect ABI presents exactly one result and `void` would present none
// (see `synthesizeFnRefThunk`).
function fnRefThunkReturnType(targetReturn StdReturnType) returns StdReturnType
	return match targetReturn 'r'
		value gives targetReturn
		void gives StdReturnType.value(StdType.i64)
	end 'r'
end 'fnRefThunkReturnType'

// Emit the thunk's terminator. A value-returning target returns the forwarded call's result; a VOID target
// returns a garbage i64 the caller discards (see `emitVoidThunkReturn`). `callResult` is the highest id
// minted so far, so `callResult + 1` is free for the void case's dummy.
function emitFnRefThunkReturn(module StdModule, block IrBlock, targetReturn StdReturnType, callResult ValueId)
	match targetReturn 'r'
		value then module.setTerminator(block, op: StdOp.ret(callResult))
		void then emitVoidThunkReturn(module, block: block, dummy: (callResult + 1) as ValueId)
	end 'r'
end 'emitFnRefThunkReturn'

// A VOID target's thunk returns a garbage i64 the caller discards — a fresh `const 0` supplies the one
// machine word the uniform `(userargs, env) -> R` indirect ABI must present, since the forwarded void
// `call`'s own result slot names no readable value (see `synthesizeFnRefThunk`).
function emitVoidThunkReturn(module StdModule, block IrBlock, dummy ValueId)
	module.appendOp(block, op: StdOp.const(dummy, value: 0, valueType: StdType.i64))
	module.setTerminator(block, op: StdOp.ret(dummy))
end 'emitVoidThunkReturn'

// The Std type the thunk gives one forwarded USER parameter (P1.5 #78): an f64 for a FLOAT parameter — the
// one case whose register file (XMM/SIMD) differs from the i64 GPR every other function-value argument uses
// — and an i64 machine word for everything else (int / named / String / struct-pointer). Decided off the
// resolved MaxonType's TAG rather than `maxonTypeToStdType`, so a struct/named param (which that collapse
// panics on but which is still an i64 pointer) keeps its i64 exactly as before this rung.
function thunkUserParamStdType(paramType MaxonType) returns StdType
	return StdType.f64 if maxonTypeTag(paramType) == ValueTypeTag.float else StdType.i64
end 'thunkUserParamStdType'
