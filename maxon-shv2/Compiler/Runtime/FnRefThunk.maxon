// Runtime/FnRefThunk.maxon — the `__fnref_<name>` environment thunks that make a PLAIN named function
// usable as a first-class value under the uniform `(userargs, env)` calling convention (P1.5-A2b-2).
//
// ⭐ **WHY A WRAPPER, AND WHY ONLY FOR PLAIN FUNCTIONS.** A function VALUE is called through ONE uniform
// indirect signature `(userargs, env) -> R`: a value passed DOWN to a generic `apply(f, x)` is called
// `f(x, env)` with no static knowledge of whether it captures, so every callable value must accept the
// trailing env. A LIFTED CLOSURE already carries that shape (its `__env` parameter — see
// `Parser.parseClosureExpression`). A plain named function `triple(n)` does NOT, and it cannot simply gain
// the parameter: its DIRECT calls `triple(10)` must stay `(userargs) -> R` (unchurned — and on wasm a
// direct `call`'s arity is checked too). So `functionRef(triple)` materializes the address of a thunk
// `__fnref_triple(n, __env)` whose signature IS `(userargs, env) -> R` — it ignores `__env` and forwards to
// `triple`. On wasm the `call_indirect` functype is SIGNATURE-derived (P1.5 #78: per-argument register
// file), so the table element's own ARITY must match exactly; on register targets the extra arg would be
// harmless, but ONE thunk keeps a single cross-target lowering. This is v1's `__fnref_` design (LowerMaxonToStd.maxon:11408) — its knowledge, not
// its cost curve: the thunk is synthesized once per referenced plain function, not per reference.
//
// ⚠ HIGHER-ORDER FUNCTION VALUES ARE OUT OF SCOPE. Binding a function that ITSELF takes a function
// parameter as a value (`let g = apply`) would need the thunk to forward `apply`'s hidden companion-env
// parameters too — a fact this thunk does not have. No enabled case does this; `functionRef` of such a
// function is not reached at this rung.

// A set of symbol names, for O(1) dedup while collecting thunk targets in source order.
export typealias FnRefThunkSet = Set with ByteArray

// True iff `name` is a lifted closure's synthesized name — `<enclosing>$closure_<k>` (see
// `Parser.parseClosureExpression`), which is what tells a closure (already `(userargs, __env)`-shaped) from
// a plain function (whose value use needs a thunk).
//
// ⛔⛔ **IT SEARCHED FOR A BARE `$`, ON THE CLAIM THAT "no other synthesized name contains it" — AND THAT
// CLAIM HAD ALREADY EXPIRED.** `ProgramSignatures.assignDataLabels` disambiguates a colliding `.data` label
// as `__data_counter$1`, a second meaning for the byte; spec-port `lazy-static` then built
// `__lazy_init#<label>`, whose name EMBEDS such a label — so a `$` can now sit inside a function name that
// is not a closure. The bare search answered TRUE for it: the right answer (that routine needs no env thunk,
// being callable only directly) reached for entirely the wrong reason.
//
// ⭐ **SO THE TEST IS THE MARKER, NOT THE BYTE.** `$closure_` is what `parseClosureExpression` mints, it
// survives nesting (`f$closure_0$closure_1` still contains it), and no label disambiguator can produce it.
function isLiftedClosureName(name ByteArray) returns bool
	return bytesContainSubsequence(name, needle: LiftedClosureMarker)
end 'isLiftedClosureName'

// The join + tag `Parser.parseClosureExpression` mints between an enclosing function and its lifted closure.
let LiftedClosureMarker = b"$closure_"

// Does `haystack` contain `needle` anywhere? `bytesStartWith`'s unanchored twin, written here because this
// is its only caller and the shapes it is asked of are function names — a handful of bytes, once per
// referenced callee.
function bytesContainSubsequence(haystack ByteArray, needle ByteArray) returns bool
	if needle.count() > haystack.count() 'cannotFit'
		return false
	end 'cannotFit'

	for start in 0 upto haystack.count() - needle.count() + 1 'eachStart'
		var matched = true
		for i in 0 upto needle.count() 'eachByte'
			let h = try haystack.get(start + i) otherwise panic("bytesContainSubsequence: haystack.get OOB at {start + i} below count {haystack.count()}")
			let n = try needle.get(i) otherwise panic("bytesContainSubsequence: needle.get OOB at {i} below count {needle.count()}")
			if h != n 'differs'
				matched = false
				break
			end 'differs'
		end 'eachByte'
		if matched 'found'
			return true
		end 'found'
	end 'eachStart'

	return false
end 'bytesContainSubsequence'

// The name of the env-thunk for plain function `funcName`. ONE builder, shared by the reference lowering
// (`LowerMaxonToStd.lowerFunctionRef`, which emits `funcAddr(__fnref_<name>)`) and the synthesis below, so
// the two spellings of the name cannot drift.
export function fnRefThunkName(funcName ByteArray) returns ByteArray
	return "__fnref_{String.from(funcName)}".toByteArray()
end 'fnRefThunkName'

// ⭐⭐ **DOES A VALUE USE OF `funcName` NEED THE UNIFORM-ABI ENV THUNK?** ONE fact, read by the two sites that
// must not disagree about it: `LowerMaxonToStd.lowerFunctionRef`, which NAMES the address a `funcAddr`
// materializes, and `noteFnRefTarget` below, which decides whether anything is there to name.
//
// ⚠ **A DISAGREEMENT IS A COMPILE ERROR AT NEITHER SITE**, which is why the test cannot be written out twice
// (it was, and it is how the A1r review's wasm trap survived a green suite): say-no here and say-yes there
// and the program holds a `funcAddr` of a thunk nobody synthesized; the other way round it holds the bare
// address of an `(args) -> R` function that every caller invokes as `(args, env) -> R`. The first is a link
// failure, the second is a wrong-shaped call that a register target answers CORRECTLY BY ACCIDENT — the
// extra `env` word lands in a register the callee never reads — and only a wasm `call_indirect`, which
// type-checks the funcref against the table slot's functype, reports it at all.
//
// A LIFTED CLOSURE already carries its own trailing `__env`, so it IS the uniform shape and needs no bridge.
// A COMPILER-EMITTED symbol is invoked through a bare `callIndirect(ptr)` in the drop walk rather than the
// closure ABI (an array element destructor stamped into `element_destroy@40`, P1.7 slice 3), so it needs none
// either — and "compiler-emitted" is the REGISTRY's answer, never the `__` prefix, because since D6/A1r
// `stdlib/Builtins.maxon` may declare a `__` name and a value use of THAT is an ordinary user function value.
export function functionValueNeedsEnvThunk(funcName ByteArray, funcSignatures FuncSignatureMap) returns bool
	if isLiftedClosureName(funcName) 'alreadyEnvShaped'
		return false
	end 'alreadyEnvShaped'

	return not isSignaturelessCompilerCallee(funcName, funcSignatures: funcSignatures)
end 'functionValueNeedsEnvThunk'

// Collect every function referenced as a value (`functionRef`) that needs the env thunk, in first-seen source
// order, deduped — WHICH ones is `functionValueNeedsEnvThunk`'s answer above and is not restated here. Read
// post-pipeline by `installFnRefThunks`; the walk mirrors `StringRuntime.scanRuntimeUsage`'s — one linear pass
// over the Maxon ops. `funcSignatures` rides along for that one predicate.
export function collectFnRefThunkTargets(module MaxonModule, funcSignatures FuncSignatureMap) returns ByteArrayArray
	var seen = FnRefThunkSet.create()
	var targets = ByteArrayArray.create()
	for func in module.functions 'eachFunc'
		for blockRef in func.blockRefs 'eachBlock'
			let block = try module.blocks.get(blockRef) otherwise panic("collectFnRefThunkTargets: blockRef from func.blockRefs not in module.blocks")
			for opIdx in block.opRefs 'eachOp'
				let op = try module.ops.get(opIdx) otherwise panic("collectFnRefThunkTargets: opIdx {opIdx} not in module.ops")
				noteIfFunctionRef(op, seen: seen, targets: targets, funcSignatures: funcSignatures)
			end 'eachOp'
		end 'eachBlock'
	end 'eachFunc'
	return targets
end 'collectFnRefThunkTargets'

// Record a `functionRef` op's PLAIN target for thunking. It RANGES over the whole `MaxonOp` union so a
// newly-appended op FAILS TO COMPILE here rather than being silently ignored (the band-append invariant):
// `call to panicAbort` is every op before `functionRef`, `indirectCall` the one after it.
function noteIfFunctionRef(op MaxonOp, seen FnRefThunkSet, targets ByteArrayArray, funcSignatures FuncSignatureMap)
	match op 'op'
		call to panicAbort then break 'op'
		functionRef(_, funcName) then noteFnRefTarget(funcName, seen: seen, targets: targets, funcSignatures: funcSignatures)
		indirectCall then break 'op'
		// P1.5-B1a/B2b: an async spawn takes the DIRECT function's address in lowering (not a `functionRef`
		// through the uniform `(userargs, env)` ABI — the trampoline calls it with user args only), so it
		// names no thunk target; `await`/`try await` reference no function value.
		asyncCall to tryAwait then break 'op'
		sizeofType then break 'op'
		constArrayLiteral then break 'op'
		// The jump table names no function value — it branches on an integer index.
		switch then break 'op'
		// A witness dispatch names no function value — it dispatches through a runtime witness table, not a
		// `funcAddr` thunk target (P1.7a slice 2a); nor does its throwing form.
		witnessDispatch to witnessTryDispatch then break 'op'
		// A rendered panic names no function — its operand is a byte pointer.
		panicAbortValue then break 'op'
		// The error-flag encode names no function value — its operand is an enum tag or a box pointer.
		errorFlagEncode then break 'op'
		// Neither service op names a function VALUE. The two addresses a `serviceSpawn` lowers to
		// (`<T>.__loop`, the request union's drop cascade) are `StdOp.funcAddr`s the LOWERING mints, and both
		// are called through the uniform runtime ABI rather than through a function value's `(args, env)` one.
		serviceSpawn to serviceSend then break 'op'
	end 'op'
end 'noteIfFunctionRef'

// A target that needs the env thunk (`functionValueNeedsEnvThunk` — the one place that rule lives) joins the
// ordered thunk list the first time it is seen. A `__` name that IS in `funcSignatures` reaches
// `synthesizeFnRefThunk` from here and finds the signature that routine panics without.
function noteFnRefTarget(funcName ByteArray, seen FnRefThunkSet, targets ByteArrayArray, funcSignatures FuncSignatureMap)
	if not functionValueNeedsEnvThunk(funcName, funcSignatures: funcSignatures) 'noThunk'
		return
	end 'noThunk'
	if seen.contains(funcName) 'already'
		return
	end 'already'
	seen.insert(funcName)
	targets.push(funcName)
end 'noteFnRefTarget'

// Synthesize the `__fnref_<name>` env-thunk for every plain function used as a value. Appended
// already-lowered AFTER the pipeline (like the destructor cascades — what runs over that appended band is
// stated once, in `Compiler.compileToCodeResult`'s install block), and they still flow through the whole
// backend (ISel, register allocation, frames) — and on wasm get a funcref-table
// slot at their funcIdx, which is what `funcAddr(__fnref_<name>)` materializes.
export function installFnRefThunks(module StdModule, project Project, targets ByteArrayArray)
	for target in targets 'each'
		synthesizeFnRefThunk(module, project: project, targetName: target)
	end 'each'
end 'installFnRefThunks'

// Emit `__fnref_<name>(userargs..., __env) -> R`:
//
//   entry: materialize each parameter (the trailing `__env` is discarded), `call <name>(userargs...)`,
//          `ret` the result.
//
// ⭐ EACH USER PARAMETER TAKES THE TARGET'S REAL TYPE, the trailing `__env` an i64 (P1.5 #78). A FLOAT
// parameter is an f64: the thunk must capture it from a float argument register and forward it to the
// target — which reads it from a float register too — so a float user param typed i64 here would forward
// a GPR value into the target's XMM parameter (a cross-register-file move). Everything else — int, String,
// a struct pointer, a type parameter — is an i64 machine word, and a `named` residue PANICS rather than
// being widened to one. The caller's indirect-call argument routing is derived from the identical
// `maxonTypeToStdType` collapse (the `argFloatMask` the `callIndirect` carries), so caller, thunk and
// target agree on every argument's register file. The forwarded call is a DIRECT `call` to the target by
// name (a wasm `call`, arity- and type-checked against the target's OWN `(userargs) -> R` functype), so the
// thunk is precisely what bridges the uniform indirect signature to the target's direct one.
function synthesizeFnRefThunk(module StdModule, project Project, targetName ByteArray)
	let sig = try project.funcSignatures.get(targetName) otherwise panic("synthesizeFnRefThunk: no signature for '{String.from(targetName)}' — a functionRef must name a registered function")
	let ret = try project.funcReturnTypes.get(targetName) otherwise panic("synthesizeFnRefThunk: no return type for '{String.from(targetName)}'")
	let userParamCount = sig.paramCount()
	let thunkParamCount = (userParamCount + 1) as ParamCount
	let targetReturn = maxonReturnTypeToStdReturnType(ret)

	// ⭐⭐ **EACH FORWARDED USER PARAMETER IS DECLARED THROUGH `maxonTypeToStdType` — THE SAME COLLAPSE THE CALL
	// SITE'S ABI MASK ASKS, AND THAT IDENTITY IS THE POINT.** A `callIndirect`'s per-argument register file
	// comes from the DECLARED parameter types (`LowerMaxonToStd.paramFloatMask`, through that one function);
	// this thunk IS the callee that mask describes whenever the function value names a plain function. Two
	// collapses would be one fact written twice, and wasm's `call_indirect` — which type-checks the declared
	// functype against the funcref's own EXACTLY — is the only thing that would ever report the drift, at RUN
	// time.
	//
	// ⚠⚠ **WIDTH IS NOT PART OF THAT AGREEMENT, AND TWO ATTEMPTS TO MAKE IT ONE EACH COST A TRAP (WASM3).**
	// Widening a `bool` parameter to an i64 HERE trapped while the callee kept its declared `i1`; declaring it
	// `i1` here and giving the call site a matching per-argument width mask trapped the moment the call site
	// sat in a SHARED GENERIC BODY, where the declared type is an opaque `Element`. Neither is repairable,
	// because the two ends do not read one declaration. What is: every wasm signature — this thunk's, a lifted
	// CLOSURE's (which has no thunk at all), and every `call_indirect`'s — is emitted at the MACHINE WORD by
	// `StdToWasm.wasmMachineValTypeOf`, so there is no width for them to disagree about. The `i1` declared here
	// is therefore a STD-tier fact the wasm ABI does not carry, and the register targets never did.
	// (`maxonTypeToStdType` is total over every type a RESOLVED signature can hold — a
	// struct/String/function/type-parameter is an i64 pointer or opaque word by its own arm there — and panics
	// only on the `named`/`unresolved` residues TypeResolution is required to have eliminated.)
	var paramTypes = StdTypeArray.create()
	for i in 0 upto userParamCount 'eachUserParamType'
		paramTypes.push(maxonTypeToStdType(try sig.paramTypes.get(i) otherwise panic("synthesizeFnRefThunk: sig.paramTypes.get OOB at {i} for '{String.from(targetName)}'")))
	end 'eachUserParamType'
	// The trailing companion `__env` pointer is always an i64 machine word.
	paramTypes.push(StdType.i64)

	// ⭐ THE UNIFORM `(userargs, env) -> R` INDIRECT ABI ALWAYS YIELDS ONE MACHINE WORD (P1.5 #68). A
	// value-returning target forwards its result; a VOID target's word is a DUMMY the caller discards —
	// mirroring a void DIRECT call, whose return register holds a garbage integer nobody reads
	// (StdLoweringShared.calleeResultClass). The single result slot is not optional: on wasm the
	// `call_indirect` type check demands the funcref present exactly the one result the caller declares
	// (`emitCallIndirect` always `local.set`s it), and `LowerMaxonToStd.indirectResultType` declares that
	// result an i64 for a void function value — so the thunk must return an i64 to match. This is what makes
	// `let cb = doIt; cb()` callable, where a `panic` stood while statement-position indirect calls were
	// unsupported.
	let func = IrFunction.createFromStd(fnRefThunkName(targetName), returnType: fnRefThunkReturnType(targetReturn), paramCount: thunkParamCount, paramTypes: paramTypes, returnLine: 0)
	var entry = module.addBlock(func, label: b"entry")
	emitTypedParams(module, block: entry, paramTypes: paramTypes)

	var forwardArgs = ValueIdArray.create()
	for i in 0 upto userParamCount 'eachArg'
		forwardArgs.push(i as ValueId)
	end 'eachArg'

	let callResult = thunkParamCount
	module.appendOp(entry, op: StdOp.call(callResult, callee: targetName, args: forwardArgs))
	emitFnRefThunkReturn(module, block: entry, targetReturn: targetReturn, callResult: callResult)

	module.functions.push(func)
end 'synthesizeFnRefThunk'

// The thunk's OWN Std return type: a value-returning target's is forwarded unchanged; a VOID target's is
// `value(i64)`, because the uniform indirect ABI presents exactly one result and `void` would present none
// (see `synthesizeFnRefThunk`).
function fnRefThunkReturnType(targetReturn StdReturnType) returns StdReturnType
	return match targetReturn 'r'
		value gives targetReturn
		void gives StdReturnType.value(StdType.i64)
	end 'r'
end 'fnRefThunkReturnType'

// Emit the thunk's terminator. A value-returning target returns the forwarded call's result; a VOID target
// returns a garbage i64 the caller discards (see `emitVoidThunkReturn`). `callResult` is the highest id
// minted so far, so `callResult + 1` is free for the void case's dummy.
function emitFnRefThunkReturn(module StdModule, block IrBlock, targetReturn StdReturnType, callResult ValueId)
	match targetReturn 'r'
		value then module.setTerminator(block, op: StdOp.ret(callResult))
		void then emitVoidThunkReturn(module, block: block, dummy: (callResult + 1) as ValueId)
	end 'r'
end 'emitFnRefThunkReturn'

// A VOID target's thunk returns a garbage i64 the caller discards — a fresh `const 0` supplies the one
// machine word the uniform `(userargs, env) -> R` indirect ABI must present, since the forwarded void
// `call`'s own result slot names no readable value (see `synthesizeFnRefThunk`).
function emitVoidThunkReturn(module StdModule, block IrBlock, dummy ValueId)
	module.appendOp(block, op: StdOp.const(dummy, value: 0, valueType: StdType.i64))
	module.setTerminator(block, op: StdOp.ret(dummy))
end 'emitVoidThunkReturn'
