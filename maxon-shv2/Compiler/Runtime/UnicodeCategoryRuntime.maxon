// Runtime/UnicodeCategoryRuntime.maxon — the Unicode `General_Category` lookup, and the two checked-in
// tables it reads (P1.8 Slice D, R2).
//
// ⭐ **THE DATA IS CHECKED IN AND IS NOT REGENERATED BY ANY BUILD STEP.** `stdlib/helpers/string/
// ucd_bmp.bin` is one byte of `General_Category` per BMP codepoint, indexed DIRECTLY — 65,536 bytes, no
// search — and `ucd_supp.bin` is a sorted array of 8-byte entries packing `(rangeStart, rangeEnd,
// category)` into one machine word for everything above the BMP. Both are produced offline by
// `tools/unicode/generate_unicode_category.py` from `DerivedGeneralCategory-16.0.0.txt`. This file READS
// them; nothing here derives Unicode data, and the compiler must never try to.
//
// ⭐ **PORTED FROM `stdlib/helpers/string/unicodeCategory.maxon:53-75`, WHICH IS THE ORACLE.** Both
// reference compilers execute that same stdlib source through a pair of intrinsics
// (`__Builtins.ucdByteAt` / `ucdI64At`), so there is no divergence between them to resolve about the
// ANSWER. What changes is the SHAPE: shv2 reads no stdlib, so the lookup is a hand-built `StdOp` graph in
// the manner of `StringRuntime`/`GraphemeRuntime`, and it needs no intrinsic at all — the two blobs are
// ordinary `.rdata` constants and the two loads are ordinary `loadIndirect`s.
//
// ⚠ **WHERE THE BLOB LIVES IS THE ONE PLACE THE TWO REFERENCES DISAGREE, AND SHV2 TAKES v1's ROUTE.**
// The bootstrap gives the tables a DEDICATED `_ucddata` PE/Mach-O section (`X86CodeEmitter.cs:111-118`,
// `ARM64CodeEmitter.cs:116`, RVA math in `0-Compiler.cs:151-206`); v1 folds them into the ordinary
// global-data literal pool (`LowerMaxonToStd.maxon:8464-8552` → `globalAddr(label)` + `loadByte`/
// `loadIndirect`). shv2 emits for FOUR object formats (PE x64-windows, ELF x64-linux, Mach-O arm64-macos,
// a wasm32-wasi component), so a dedicated section is four separate section-table edits for zero semantic
// gain, while `.rdata` already has a home in all four and is what every String literal and every witness
// table already rides. ⇒ v1's route, through `registerRdataConstantLabeled`.
//
// ⚠ **THE LABELS ARE STRUCTURAL AND THE `__ucd_` PREFIX IS A GUARD, NOT DECORATION.** v1 validates it
// (`LowerMaxonToStd.maxon:8464-8486`) because its intrinsic takes the label FROM SOURCE — `__Builtins.
// ucdByteAt("…", cp)` — and a label is turned into a FILE NAME, so an unchecked one is a path traversal.
//
// ⚠⚠ **shv2 NOW HAS THAT DOOR TOO (W64), AND IT IS SHUT BY A ROSTER RATHER THAN BY A PREFIX.** The two
// intrinsics below are Maxon-reachable, so a label DOES come from user text — but only as far as
// `Parser.parseUcdTableLoad`, which compares it against the table its intrinsic reads and DISCARDS it.
// What reaches `.rdata` and what reaches a file name are still derived from a table's own constant here
// (`ucdLabel` / `ucdTableBytes`), so the traversal is structurally impossible rather than merely refused.
// ⛔ **A PREFIX CHECK WOULD NOT HAVE CLOSED IT, AND v1's DOES NOT**: `__ucd_../../x` carries the prefix
// and still escapes the directory — MEASURED against the bootstrap, which answered a crafted label by
// reaching for `stdlib/helpers/string/ucd_../../../evil.bin`. The roster is the guard; the prefix is what
// makes an `.rdata` label tell a reader which mechanism owns a blob.

// ⭐ **THE ENTRY POINTS.** All `__`-prefixed compiler-internal (`isCompilerInternalCallee` — no E3004, no
// signature slotting) but NOT `__mm_`-prefixed, so they widen no heap decision; the family declares its
// floor in `recordCallUsage` exactly as the String and grapheme families do. Each is a LEAF: `.rdata`
// reads and integer arithmetic, calling nothing, allocating nothing.
//
// `__ucd_cat` is the whole `General_Category` lookup, which is what `CharacterSet.contains` reaches.
// ⭐ **THE OTHER TWO ARE THE LOOKUP TAKEN APART**, and they exist because `stdlib/helpers/string/
// unicodeCategory.maxon` writes the SAME algorithm out of two raw table reads — the intrinsic pair both
// reference compilers give it. They are the lowering of `__Builtins.ucdByteAt`/`ucdI64At`, one per
// (table, stride) pairing, and each shares its load with `__ucd_cat`'s own arm (`emitBmpCategoryByte` /
// `emitSuppEntryAt`) so the two routes onto one table cannot come to read it differently.
export let UcdCategoryName = b"__ucd_cat"
export let UcdBmpAtName = b"__ucd_bmp_at"
export let UcdSuppAtName = b"__ucd_supp_at"

// ⭐ **THE FAMILY, AS A PREFIX** — the shape `isClockRuntimeCallee`/`isGtRuntimeCallee` already use, and
// the reason `recordCallUsage` needs no row per entry point: all three above read the same two tables and
// carry the same nothing else, so "does this program touch the UCD tables?" is ONE question. A per-entry-
// point bit would buy only the deletion of a leaf whose whole body is a `lea` and a load, against the
// 72 KB of table the family installs either way.
let UcdRuntimeCallPrefix = b"__ucd_"

export function isUcdRuntimeCallee(callee ByteArray) returns bool
	return bytesStartWith(callee, prefix: UcdRuntimeCallPrefix)
end 'isUcdRuntimeCallee'

// ⭐ **EACH TABLE IS NAMED ONCE, BY ITS STEM** — the `.rdata` label, the file, and the SOURCE label a
// `__Builtins.ucd*` call must name all DERIVE from it (`ucdLabel` / `ucdTableBytes`), so a renamed table
// cannot leave one of the three pointing at the old bytes. v1 builds the file name from the label the same
// way (`ensureUcdLoaded`, `LowerMaxonToStd.maxon:8464-8486`), minus the traversal risk its SOURCE-SUPPLIED
// label carried — here the source label is only ever COMPARED against this, never used to build anything.
export let UcdBmpStem = "ucd_bmp"
export let UcdSuppStem = "ucd_supp"
let UcdLabelPrefix = "__"
let UcdTableExtension = ".bin"
let UcdTableDir = "helpers/string"

// The BMP table is indexed DIRECTLY by codepoint, so its length IS the ceiling — one byte each for
// U+0000..U+FFFF. Anything at or above it is a supplementary codepoint and takes the sorted search.
let UcdBmpCodepointCeiling = 65536

// ⭐ **ONE SUPPLEMENTARY ENTRY, PACKED INTO ONE MACHINE WORD** (the generator's layout, read back by
// `unicodeCategory.maxon:62-70`): bits 0..20 are `rangeStart`, bits 21..41 are `rangeEnd`, bits 42..46 are
// the category. 21 bits covers U+10FFFF exactly. The ENTRY COUNT is deliberately NOT written down here —
// v1's stdlib carries it as `UCD_SUPP_COUNT = 806`, a second copy of the file's own length that a
// regenerated table would silently invalidate; `installUnicodeCategoryRuntime` derives it from the bytes.
let UcdSuppEntryBytes = 8
let UcdRangeFieldBits = 21
let UcdRangeFieldMask = 2097151
let UcdCategoryShift = 42
let UcdCategoryMask = 31

// The category a codepoint in NO supplementary range has — `Cn`, unassigned. It is the same 0 the BMP
// table stores for an unassigned codepoint, and the same 0 the reference's search falls out to
// (`unicodeCategory.maxon:74`), so a `CharacterSet` bitmask never has bit 0 set for a real category.
let UcdUnassignedCategory = 0

// Install the `General_Category` lookup and register the two tables it reads, when — and only when — the
// program names it. Appended AFTER the pipeline like every other runtime install, so it is never
// re-optimized and still flows through the whole backend.
//
// ⚠ It takes `globalData` because it REGISTERS, not merely emits: the two blobs must be in `.rdata`
// before the backend lays the section out. A missing table is a broken checkout and raises the ordinary
// `fileNotFound` naming the path — never a silent skip, which would link a `rdataAddr` at a label nothing
// registered.
export function installUnicodeCategoryRuntime(module StdModule, globalData GlobalDataTable, usage RuntimeUsage, stdlibDir FilePath) throws CompileError
	if not usage.usesUcdCategory 'noCategoryLookup'
		return
	end 'noCategoryLookup'

	_ = globalData.registerRdataConstantLabeled(ucdLabel(UcdBmpStem), bytes: try ucdTableBytes(stdlibDir, stem: UcdBmpStem))
	let supp = try ucdTableBytes(stdlibDir, stem: UcdSuppStem)
	_ = globalData.registerRdataConstantLabeled(ucdLabel(UcdSuppStem), bytes: supp)
	buildUcdCategory(module, suppEntryCount: supp.count() / UcdSuppEntryBytes)
	buildUcdTableLoads(module)
end 'installUnicodeCategoryRuntime'

// The `.rdata` label one table registers under, and the only spelling of it. Exported because the PARSER
// asks it too: `__Builtins.ucdByteAt("__ucd_bmp", …)`'s label is checked against this rather than against a
// second copy of the text, which is the whole of the roster guard the header describes.
export function ucdLabel(stem String) returns String
	return "{UcdLabelPrefix}{stem}"
end 'ucdLabel'

// The bytes of one checked-in table, read from `stdlib/helpers/string/<stem>.bin`. The path is joined off
// `project.stdlibDir` for the reason `StdlibLoader` joins off it — that directory's spelling is owned in
// one place.
function ucdTableBytes(stdlibDir FilePath, stem String) returns ByteArray throws CompileError
	let path = stdlibDir.join("{UcdTableDir}/{stem}{UcdTableExtension}")
	return try File.readBinary(path) otherwise throw CompileError.fileNotFound(path)
end 'ucdTableBytes'

// ⭐⭐ **`__ucd_cat(cp) -> GeneralCategory` — the reference's `unicodeGeneralCategory`
// (`stdlib/helpers/string/unicodeCategory.maxon:53-75`), verbatim in structure.**
//
// A BMP codepoint is ONE indexed byte load and nothing else — no search, no branch beyond the plane test
// — which is what makes `"  hello  ".trim()` cost a table read per space rather than a scan. A
// supplementary codepoint takes a binary search over the sorted range table; `suppEntryCount` is the
// table's own length in entries, passed in by the installer that read it.
function buildUcdCategory(module StdModule, suppEntryCount ElementCount)
	var func = IrFunction.createFromStd(UcdCategoryName, returnType: StdReturnType.value(StdType.i64), paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry")
	var bmp = module.addBlock(func, label: b"bmp")
	var supp = module.addBlock(func, label: b"supp")

	emitParams(module, block: entry, count: 1)
	let cp = 0 as ValueId

	let ceiling = emitConst(module, block: entry, value: UcdBmpCodepointCeiling, ids: ids)
	let inBmp = emitCmp(module, block: entry, a: cp, b: ceiling, pred: StdCmpPred.lt, ids: ids)
	module.setTerminator(entry, op: StdOp.condBranch(inBmp, thenBlockId: bmp.id, elseBlockId: supp.id))

	module.setTerminator(bmp, op: StdOp.ret(emitBmpCategoryByte(module, block: bmp, index: cp, ids: ids)))

	emitSupplementarySearch(module, func: func, cur: supp, cp: cp, suppEntryCount: suppEntryCount, ids: ids)
	module.functions.push(func)
end 'buildUcdCategory'

// ⭐ **`__ucd_bmp_at(offset)` AND `__ucd_supp_at(index)` — the two RAW TABLE READS, as callable leaves.**
// They are what `__Builtins.ucdByteAt`/`ucdI64At` lower to (`Parser.parseUcdTableLoad`), and they exist
// because `stdlib/helpers/string/unicodeCategory.maxon` builds the `General_Category` lookup out of the
// raw reads rather than calling `__ucd_cat`. Both routes onto a table share ONE emitter apiece, so the
// stride and the load width cannot come apart between them.
//
// ⚠ **NEITHER BOUNDS-CHECKS ITS INDEX, and both reference compilers agree** (v1's `lowerBuiltinsUcdByteAt`
// and the bootstrap's `LowerUcdByteLoad` emit a bare `base + index` load). The `__Builtins` namespace is
// the compiler's own plumbing and the index is the caller's obligation; a check here would sit on the
// hot path of every `trim()` and would still be a divergence from the oracle this compiler is graded on.
function buildUcdTableLoads(module StdModule)
	buildUcdTableLoad(module, load: UcdTableStride.byteIndexed)
	buildUcdTableLoad(module, load: UcdTableStride.packedEntry)
end 'buildUcdTableLoads'

// Which table a raw load reads and how it strides — ONE fact, because the two are inseparable: the BMP
// table holds one byte per codepoint and the supplementary table holds 8-byte packed entries, so a stride
// names a table and a table names a stride. It is what makes the pairing check in the parser (E2070) a
// statement about this enum rather than a second rule about labels.
export enum UcdTableStride
	byteIndexed
	packedEntry
end 'UcdTableStride'

// ⭐⭐ **THE THREE DERIVED HALVES OF ONE TABLE, KEYED BY THE STRIDE THAT NAMES IT — so a caller states
// WHICH TABLE and nothing else.** The stem the `.rdata` label and the checked-in file both come from, the
// runtime leaf a `__Builtins.ucd*` call lowers to, and the DECLARED name of that intrinsic's second
// parameter are one fact per table, and they were four independent arguments at the parser's two call
// sites: `parseUcdTableLoad(tableStem: UcdBmpStem, runtimeName: UcdBmpAtName, indexParamName: …)`. Nothing
// made those four agree, and disagreeing is not a compile error — a call site pairing `ucdByteAt` with the
// SUPPLEMENTARY stem would demand the label `__ucd_supp` and then emit a call that reads the BMP blob one
// byte at a time. That is a WRONG ANSWER out of a green build, which is exactly the shape the bootstrap's
// `UcdTableLoadIntrinsic` row exists to make impossible on its side.
export function ucdTableStemOf(load UcdTableStride) returns String
	return match load 'stride'
		byteIndexed gives UcdBmpStem
		packedEntry gives UcdSuppStem
	end 'stride'
end 'ucdTableStemOf'

export function ucdRuntimeNameOf(load UcdTableStride) returns ByteArray
	return match load 'stride'
		byteIndexed gives UcdBmpAtName
		packedEntry gives UcdSuppAtName
	end 'stride'
end 'ucdRuntimeNameOf'

// `offset` counts BYTES into the directly-indexed BMP table; `index` counts 8-byte ENTRIES into the sorted
// supplementary table — so the word IS the stride, which is why the name lives here beside it rather than
// beside the callee spellings in the parser. Both reference compilers use these two names (v1 registers
// them as real signatures, `LowerMaxonToStd.maxon:1110-1111`; the bootstrap's rows carry them since W64).
export function ucdIndexParamNameOf(load UcdTableStride) returns ByteArray
	return match load 'stride'
		byteIndexed gives UcdByteAtIndexParamName
		packedEntry gives UcdI64AtIndexParamName
	end 'stride'
end 'ucdIndexParamNameOf'

let UcdByteAtIndexParamName = b"offset"
let UcdI64AtIndexParamName = b"index"

// One raw-load leaf: one parameter, one table read, one `ret`. Its NAME is derived from the stride like
// every other half of the table, so the leaf this builds and the leaf the parser emits a call to are one
// spelling rather than two that happen to match.
function buildUcdTableLoad(module StdModule, load UcdTableStride)
	var func = IrFunction.createFromStd(ucdRuntimeNameOf(load), returnType: StdReturnType.value(StdType.i64), paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry")
	emitParams(module, block: entry, count: 1)
	let index = 0 as ValueId

	let value = match load 'stride'
		byteIndexed gives emitBmpCategoryByte(module, block: entry, index: index, ids: ids)
		packedEntry gives emitSuppEntryAt(module, block: entry, base: emitRdataAddr(module, block: entry, label: ucdLabel(ucdTableStemOf(load)), ids: ids), index: index, ids: ids)
	end 'stride'

	module.setTerminator(entry, op: StdOp.ret(value))
	module.functions.push(func)
end 'buildUcdTableLoad'

// One byte of the BMP table, indexed DIRECTLY by codepoint and zero-extended. The base address is taken
// per-read rather than hoisted because each of the two readers is a single-block straight line — this IS
// the whole of `__ucd_bmp_at`, and it is `__ucd_cat`'s `bmp` arm entire.
function emitBmpCategoryByte(module StdModule, block IrBlock, index ValueId, ids ValueMinter) returns ValueId
	let base = emitRdataAddr(module, block: block, label: ucdLabel(UcdBmpStem), ids: ids)
	return emitLoadByteIndexed(module, block: block, base: base, index: index, ids: ids)
end 'emitBmpCategoryByte'

// One packed supplementary entry: `base + index * 8`, loaded as a machine word. `base` is a PARAMETER
// because the binary search hoists it out of its loop while the leaf takes it fresh — the address math is
// the part that must not be written twice, not the `lea`.
function emitSuppEntryAt(module StdModule, block IrBlock, base ValueId, index ValueId, ids ValueMinter) returns ValueId
	let stride = emitConst(module, block: block, value: UcdSuppEntryBytes, ids: ids)
	let offset = emitBin(module, block: block, a: index, b: stride, opcode: StdBinOpcode.mul, ids: ids)
	let addr = emitBin(module, block: block, a: base, b: offset, opcode: StdBinOpcode.add, ids: ids)
	return emitLoadField(module, block: block, record: addr, offset: 0, ids: ids)
end 'emitSuppEntryAt'

// The `.rdata` address of `label` as a value. One line, but written once: a `rdataAddr` naming a label
// nothing registered is a link failure, and both readers here name their label from the same two
// constants the installer registers under.
function emitRdataAddr(module StdModule, block IrBlock, label String, ids ValueMinter) returns ValueId
	let addr = ids.mint()
	module.appendOp(block, op: StdOp.rdataAddr(addr, label: label.toByteArray()))
	return addr
end 'emitRdataAddr'

// The supplementary-plane half: a binary search over the sorted `(rangeStart, rangeEnd, category)` table,
// the reference's `while lo <= hi` loop (`unicodeCategory.maxon:57-74`) as a block graph. `lo`/`hi` are the
// header's two phis; a codepoint in no range falls out of the loop as `Cn`.
//
// The two range fields are decoded from ONE loaded word rather than two loads, exactly as the reference
// decodes them, and the low-bound test is made BEFORE the high one is decoded — a codepoint below the
// probe's range never pays for the shift.
function emitSupplementarySearch(module StdModule, func IrFunction, cur IrBlock, cp ValueId, suppEntryCount ElementCount, ids ValueMinter)
	var header = module.addBlock(func, label: b"probe")
	var lookAt = module.addBlock(func, label: b"lookAt")
	var goLeft = module.addBlock(func, label: b"goLeft")
	var testHigh = module.addBlock(func, label: b"testHigh")
	var goRight = module.addBlock(func, label: b"goRight")
	var found = module.addBlock(func, label: b"found")
	var missing = module.addBlock(func, label: b"missing")

	let base = emitRdataAddr(module, block: cur, label: ucdLabel(UcdSuppStem), ids: ids)
	let firstLo = emitConst(module, block: cur, value: 0, ids: ids)
	let firstHi = emitConst(module, block: cur, value: suppEntryCount - 1, ids: ids)
	module.setTerminator(cur, op: StdOp.branch(header.id))

	let lo = ids.mint()
	let hi = ids.mint()
	header.blockArgs.push(IrBlockArg.create(lo, argType: StdType.i64))
	header.blockArgs.push(IrBlockArg.create(hi, argType: StdType.i64))
	cur.branchEdges.push(BranchEdge.create(header.id, argIds: twoArgs(firstLo, second: firstHi)))

	let live = emitCmp(module, block: header, a: lo, b: hi, pred: StdCmpPred.le, ids: ids)
	module.setTerminator(header, op: StdOp.condBranch(live, thenBlockId: lookAt.id, elseBlockId: missing.id))

	// `(lo + hi) shr 1` — a LOGICAL shift, because both bounds are non-negative table indices and the
	// reference's own `shr` on them is the same halving.
	let span = emitBin(module, block: lookAt, a: lo, b: hi, opcode: StdBinOpcode.add, ids: ids)
	let one = emitConst(module, block: lookAt, value: 1, ids: ids)
	let mid = emitBin(module, block: lookAt, a: span, b: one, opcode: StdBinOpcode.shrLogical, ids: ids)
	let packed = emitSuppEntryAt(module, block: lookAt, base: base, index: mid, ids: ids)
	let rangeStart = emitFieldOf(module, block: lookAt, packed: packed, shift: 0, mask: UcdRangeFieldMask, ids: ids)
	let below = emitCmp(module, block: lookAt, a: cp, b: rangeStart, pred: StdCmpPred.lt, ids: ids)
	module.setTerminator(lookAt, op: StdOp.condBranch(below, thenBlockId: goLeft.id, elseBlockId: testHigh.id))

	let midMinusOne = emitBin(module, block: goLeft, a: mid, b: emitConst(module, block: goLeft, value: 1, ids: ids), opcode: StdBinOpcode.sub, ids: ids)
	module.setTerminator(goLeft, op: StdOp.branch(header.id))
	goLeft.branchEdges.push(BranchEdge.create(header.id, argIds: twoArgs(lo, second: midMinusOne)))

	let rangeEnd = emitFieldOf(module, block: testHigh, packed: packed, shift: UcdRangeFieldBits, mask: UcdRangeFieldMask, ids: ids)
	let above = emitCmp(module, block: testHigh, a: cp, b: rangeEnd, pred: StdCmpPred.gt, ids: ids)
	module.setTerminator(testHigh, op: StdOp.condBranch(above, thenBlockId: goRight.id, elseBlockId: found.id))

	let midPlusOne = emitBin(module, block: goRight, a: mid, b: emitConst(module, block: goRight, value: 1, ids: ids), opcode: StdBinOpcode.add, ids: ids)
	module.setTerminator(goRight, op: StdOp.branch(header.id))
	goRight.branchEdges.push(BranchEdge.create(header.id, argIds: twoArgs(midPlusOne, second: hi)))

	module.setTerminator(found, op: StdOp.ret(emitFieldOf(module, block: found, packed: packed, shift: UcdCategoryShift, mask: UcdCategoryMask, ids: ids)))
	module.setTerminator(missing, op: StdOp.ret(emitConst(module, block: missing, value: UcdUnassignedCategory, ids: ids)))
end 'emitSupplementarySearch'

// One packed field: `(packed shr shift) and mask`. All three of the entry's fields are this, and the
// low one takes it with `shift: 0` rather than a shortcut — one extraction shape means a field cannot be
// read with the wrong mask in one arm and the right one in another.
function emitFieldOf(module StdModule, block IrBlock, packed ValueId, shift ParsedInt, mask ParsedInt, ids ValueMinter) returns ValueId
	let shifted = emitBin(module, block: block, a: packed, b: emitConst(module, block: block, value: shift, ids: ids), opcode: StdBinOpcode.shrLogical, ids: ids)
	return emitBin(module, block: block, a: shifted, b: emitConst(module, block: block, value: mask, ids: ids), opcode: StdBinOpcode.bitAnd, ids: ids)
end 'emitFieldOf'
