// Runtime/HashTableRuntime.maxon — ⭐⭐ **ONE OPEN-ADDRESSING HASH TABLE, READ BY BOTH CONTAINERS.**
//
// `Set with Element` and `Map with (Key, Value)` are not two data structures that happen to resemble each
// other: **a `Map` record IS a `Set` record with a value column appended.** The first six slots are
// byte-identical — `count@0`, `capacity@8`, `keys@16`, `states@24`, `hashes@32`, `keyDrop@40` — and a map
// adds `values@48` and `valueDrop@56` behind them. That is a REPRESENTATION claim, and this file is what
// makes it one: the probe, the grow, the teardown walk and the load-factor policy are written HERE, once,
// and each container's file keeps only what is genuinely its own (`SetRuntime`'s `__set_remove`/`__set_from`,
// `MapRuntime`'s throwing `__map_get`).
//
// ⚠ **THE ALTERNATIVE WAS TWO 100-LINE COPIES, AND THE COPIES WOULD HAVE BEEN INVISIBLY WRONG.** `__set_grow`
// and `__map_grow` differ by ONE buffer; `__set_contains` and `__map_contains` are the same body under two
// names; `__set_insert` and `__map_upsert` differ only in the duplicate-key arm. A probe whose tombstone
// preference drifted between the two would produce a table that is correct until the first `remove`, in one
// container and not the other — the shape this project keeps paying for (`BufferOwnership`'s header records
// the same finding for the String/Array `buffer@0`).
//
// ⭐ **THE ALGORITHM IS v1's `stdlib/Set.maxon`, ported to hand-built IR**: open addressing, `capacity` a
// power of two so `index = hash and (capacity - 1)` (no `mod`) and probe step `(index + 1) and mask` (LINEAR
// probing); lazy-init to 16 slots on the first insert; grow (double + rehash, reusing the cached hashes) when
// `count >= (capacity * 3) / 4` (75% load); a `Deleted` tombstone on remove, reused by a later insert
// (`firstDeleted`); and the full `equals` compare guarded by the cached hash (`slotHash == hash` THEN
// `equals`) so an unequal hash skips the witness call.
//
// ⭐ THE SHAPE IS `ArrayRuntime`'s: one fused `__mm_alloc`'d backing record whose fields the runtime functions
// read and the parser/lowering writes, plus a set of `__`-prefixed Std runtime functions built as `StdOp`
// graphs (so they get register allocation, frames and the whole backend for free). It DIVERGES from `Array`
// in the one place a hash table must: an array's element operations are self-contained, but a probe has to
// call the KEY's `hash()` / `equals()`, which are UNKNOWN to a key-type-agnostic runtime. So the record's
// operations DISPATCH THROUGH THE KEY'S WITNESS TABLES (dictionary-passing): every key-touching entry point
// takes two hidden `Hashable`/`Equatable` witness-table pointers, materialized at the concrete call site
// (`LowerMaxonToStd.appendSetWitnessArgs`) and invoked inside the runtime body with the fused `witnessCall`
// StdOp. For an `int` key the witness slots point straight at the synthesized `int.hash` / `int.equals`.
//
// ⚠ **A SET IS FOUR ALLOCATIONS AND A MAP IS FIVE, not one**: the fused record (`__mm_alloc`, a managed box
// with the MM header + refcount before it) plus the THREE (or FOUR) separate external buffers — `keys`,
// `states` (per-slot Empty/Occupied/Deleted, so a removed slot leaves a TOMBSTONE), `hashes` (the cached
// `hash()` per slot, so a grow rehashes without re-calling the witness) and, for a map, `values`. The buffers
// are PARALLEL: slot `i` of each describes one hash-table slot, and the decref frees every one of them.
//
// ⚠ **REGISTER PRESSURE — THE BUFFER POINTERS ARE RELOADED FROM THE RECORD INSIDE EACH LOOP, NOT HOISTED
// ACROSS IT.** A probe needs the record, the key, the equality witness and the cached query hash live at once;
// hoisting the buffer pointers, the capacity and the mask on TOP of those would keep ~12 values live across
// the loop and, in a hand-built function whose values carry no source spans, overruns the 14-GPR pool and
// trips the register-pressure guard (E5001). Reloading the record's fields where each is used (they do not
// change during a probe) keeps the cross-loop live set to `{table, key, eqWitness, hash}` plus the loop's own
// indices — a few extra loads for a probe that runs a handful of iterations, and the difference between
// "allocates" and "cannot".
//
// ⚠ **THE VALUE COLUMN ADDS TO THAT LIVE SET, AND THE GROW REHASH IS WHERE IT WOULD HAVE BITTEN.** A map's
// rehash carries FOUR old buffer pointers across the whole walk; reading the moved VALUE where it is written
// (`place`) rather than where its key is read (`reinsert`) keeps it out of the inner find-loop's live range.
// That is why `emitHtRehashValueMove` reads `oldValues[i]` a block later than it reads the key.

// --- The fused hash-table backing record ---
//
// Eight 8-byte slots at 0/8/16/24/32/40/48/56. `count` and `capacity` are scalars; `keys`/`states`/`hashes`/
// `values` are pointers to the parallel external buffers; `keyDrop@40` and `valueDrop@56` are the per-COLUMN
// destructors a managed column carries (the `Array` twin of `element_destroy@40`), each `0` for a trivial
// column. A fresh record comes ZEROED from `__mm_alloc` (count 0, capacity 0, all buffer pointers null), so
// `create` writes only the destructor stamps and the first insert lazily allocates the buffers via a grow
// from capacity 0.
//
// ⚠ **A `Set` STOPS AT `keyDrop@40` AND A `Map` CONTINUES — the two record SIZES are each container's own**
// (`SetRuntime.SetRecordBytes`, `MapRuntime.MapRecordBytes`), because that is the one number `SignatureIndex`
// asks each of them for. The OFFSETS are shared, which is the whole point: a set's `elements@16` and a map's
// `keys@16` are the same slot under two words, so they are one constant under one word here.
export let HtCountOffset = 0 as ByteOffset
export let HtCapacityOffset = 8 as ByteOffset
export let HtKeysOffset = 16 as ByteOffset
export let HtStatesOffset = 24 as ByteOffset
export let HtHashesOffset = 32 as ByteOffset
export let HtKeyDropOffset = 40 as ByteOffset
export let HtValuesOffset = 48 as ByteOffset
export let HtValueDropOffset = 56 as ByteOffset

// Every buffer slot — a key, a state tag, a cached hash, a value — is one 8-byte machine word, so a slot's
// byte address is `buffer + index * WordSlotBytes` and a buffer sized for `capacity` slots is
// `capacity * WordSlotBytes` bytes. Keys and values are scalar (or a managed POINTER) this slice, so each
// rides its word inline. ⚠ The stride and the three emit helpers over it are `MmRuntime`'s, not this file's:
// they were named `Ht*` here while `__set_from` already used them on an ARRAY's element buffer, and
// `__list_from` uses them on the same buffer — see `MmRuntime.emitWordSlotAddr`.

// The `states` buffer's per-slot tag. `Empty` is 0 so a freshly `__mm_alloc`'d (zeroed) states buffer starts
// all-empty with no init loop — the same reason the record needs no field stamp. Occupied/Deleted match the
// `enum SetSlotState {Empty, Occupied, Deleted}` ordinals in v1's `stdlib/Set.maxon`.
let HtSlotEmpty = 0 as ParsedInt
let HtSlotOccupied = 1 as ParsedInt
let HtSlotDeleted = 2 as ParsedInt

// The lazy-init / first-grow capacity: 16 slots, a power of two so the `and mask` index selection holds from
// the first insert. v1 uses the same initial 16.
let HtInitialCapacity = 16 as ParsedInt

// The 75% load-factor threshold as an exact integer fraction — grow when `count >= (capacity * 3) / 4`
// (v1's `trunc((capacity * 3) / 4)`). Named (and the numerator derived in the IR, not written as a second
// literal) so the policy reads as `3/4`, not as two magic numbers.
let LoadFactorNumerator = 3 as ParsedInt
let LoadFactorDenominator = 4 as ParsedInt

// `firstDeleted`'s "no tombstone seen yet" sentinel — a NEGATIVE slot index no real slot can hold, so
// `firstDeleted >= 0` distinguishes "reuse this tombstone" from "none seen". v1's `-1`.
let FirstDeletedNone = -1 as ParsedInt

// ⭐ **THE KEY'S CONSTRAINTS — `where Key is Hashable and Equatable` — are named by `IrInterface`'s OWN
// `HashableInterfaceName`/`EquatableInterfaceName`, not by copies here.**
// `LowerMaxonToStd.appendSetWitnessArgs` materializes `rdataAddr(__witness_<key>.Hashable)` /
// `__witness_<key>.Equatable`, and the label it takes an address of must be the label the builtin-conformance
// table registers under.
//
// The witness-table slot index of the SOLE method of `Hashable` (`hash`) and of `Equatable` (`equals`) — each
// interface declares one method, at decl-order index 0, so the fused `witnessCall` reads its function pointer
// from `[witnessAddr + 24]` (`witnessMethodSlotOffset(0)`).
let HtWitnessMethodIndex = 0 as WitnessMethodIndex

// ⭐⭐ **ONE HASH-TABLE CONTAINER, DESCRIBED ONCE: its six shared entry-point names, its record size, and
// whether it carries a value column.** Every shared builder below takes exactly this, so "which table am I
// building?" is one argument rather than a per-builder pile of names and flags that a caller could pair
// wrongly. It is built in exactly TWO places — `SetRuntime.installSetRuntime` and
// `MapRuntime.installMapRuntime`, each handing one straight to `installHashTable` — and those two calls are
// the ONLY places either container's shape is stated.
export type HashTableFamily
	export var createName as ByteArray
	// INTERNAL to its container — called only by `insert` when the load factor is crossed (and on the first
	// insert, from capacity 0). It reuses the cached hashes, so it needs NO witnesses; kept out of each
	// container's public name set so no parser path dispatches to it.
	export var growName as ByteArray
	export var insertName as ByteArray
	export var containsName as ByteArray
	export var countName as ByteArray
	export var decrefName as ByteArray
	export var recordBytes as ByteCount
	// Does this table have a `values@48` column (and the `valueDrop@56` stamp behind it)? A `Map` does, a
	// `Set` does not, and that single bool is the whole of the difference between the two families' six
	// shared functions.
	export var carriesValues as bool

	export static function create(createName ByteArray, growName ByteArray, insertName ByteArray, containsName ByteArray, countName ByteArray, decrefName ByteArray, recordBytes ByteCount, carriesValues bool) returns HashTableFamily
		return Self{createName: createName, growName: growName, insertName: insertName, containsName: containsName, countName: countName, decrefName: decrefName, recordBytes: recordBytes, carriesValues: carriesValues}
	end 'create'
end 'HashTableFamily'

// ⭐ **THE VALUE AN INSERT PUBLISHES — A UNION, NOT A `ValueId` GUARDED BY A BOOL, and the difference is a
// register.** `__map_upsert(map, key, value, hashWitness, eqWitness)` holds its value at parameter 2;
// `__set_insert(set, elem, hashWitness, eqWitness)` has no value at all, and ITS parameter 2 is
// `hashWitness`. A `ValueId` field that is meaningless unless a sibling bool is true is a sentinel the
// language cannot check, and reading it on the wrong family would store a WITNESS TABLE POINTER into a value
// column — a wild pointer freed at teardown. The union makes that unrepresentable rather than commented
// against.
union HtInsertValue
	absent
	present(value ValueId)
end 'HtInsertValue'

// Install the six shared entry points of one hash-table container. Each container's own install adds what is
// genuinely its own afterwards (`__set_remove`/`__set_from`, `__map_get`) — this is the part that must not
// become two copies.
export function installHashTable(module StdModule, family HashTableFamily)
	buildHtCreate(module, family: family)
	buildHtGrow(module, family: family)
	buildHtInsert(module, family: family)
	buildHtContains(module, family: family)
	buildHtCount(module, family: family)
	buildHtDecref(module, family: family)
end 'installHashTable'

// --- Shared leaf helpers ---

// Load slot `index` of the buffer at record field `bufferOffset` — reloading the buffer pointer from `table`
// rather than from a hoisted register (see the register-pressure note in the header). The one door a probe
// reads a slot through, so "reload then stride" is written once.
export function emitHtRecordSlotLoad(module StdModule, block IrBlock, table ValueId, bufferOffset ByteOffset, index ValueId, ids ValueMinter) returns ValueId
	let base = emitLoadField(module, block: block, record: table, offset: bufferOffset, ids: ids)
	return emitWordSlotLoad(module, block: block, base: base, index: index, ids: ids)
end 'emitHtRecordSlotLoad'

// Store `value` into slot `index` of the buffer at record field `bufferOffset` — the store twin of
// `emitHtRecordSlotLoad`, reloading the buffer pointer from `table`.
function emitHtRecordSlotStore(module StdModule, block IrBlock, table ValueId, bufferOffset ByteOffset, index ValueId, value ValueId, ids ValueMinter)
	let base = emitLoadField(module, block: block, record: table, offset: bufferOffset, ids: ids)
	emitWordSlotStore(module, block: block, base: base, index: index, value: value, ids: ids)
end 'emitHtRecordSlotStore'

// `capacity - 1` — the power-of-two mask, reloaded from `table`'s `capacity@8` (unchanged during a probe). The
// one place the mask is derived, so the header's bound (`probes >= capacity`) and the step's wrap
// (`(index + 1) and mask`) read the same live-reloaded capacity.
function emitHtMask(module StdModule, block IrBlock, table ValueId, ids ValueMinter) returns ValueId
	let capacity = emitLoadField(module, block: block, record: table, offset: HtCapacityOffset, ids: ids)
	let one = emitConst(module, block: block, value: 1, ids: ids)
	return emitBin(module, block: block, a: capacity, b: one, opcode: StdBinOpcode.sub, ids: ids)
end 'emitHtMask'

// `hash()` of `key` through the `Hashable` witness — `witnessCall(hashWitness, method 0, key) -> HashValue`.
// The fused `callMem [hashWitness + 24]`; for an int key the slot holds `int.hash`, so this is
// `key & 0xFFFFFFFF`.
//
// ⚠ **BOTH PER-ARGUMENT ABI MASKS ARE 0, AND THAT IS A CLAIM ABOUT THE KEY TYPES `Map` ADMITS.** The receiver
// is the sole argument, and every `Hashable` conformer declares its `hash` receiver as a whole machine word:
// `int.hash` an i64, `String.hash`/`Character.hash` the record POINTER, a user type its box pointer. The two
// conformers that would break it are unreachable — `bool` declares no `Hashable` at all
// (`isIntrinsicBuiltinConformance`), and `float.hash`'s f64 receiver cannot be a key because E2062 refuses a
// float TYPE ARGUMENT outright, so `Map with float` does not exist.
function emitHtKeyHash(module StdModule, block IrBlock, hashWitness ValueId, key ValueId, ids ValueMinter) returns ValueId
	let hash = ids.mint()
	module.appendOp(block, op: StdOp.witnessCall(hash, witnessAddr: hashWitness, methodIndex: HtWitnessMethodIndex, resultType: StdReturnType.value(builtinProtocolResultStdType(HashValueTypeName)), argFloatMask: 0, argNarrowMask: 0, args: argsOf(key)))
	return hash
end 'emitHtKeyHash'

// `a.equals(b)` through the `Equatable` witness — `witnessCall(eqWitness, method 0, a, b) -> bool` (0/1). For
// an int key the slot holds `int.equals`, so this is `a == b`.
//
// ⚠ The result type is `builtinProtocolResultStdType`'s and NOT a hand-written `i64`, because this runtime is
// a THIRD party to a witness slot's signature (beside the dispatch site and the impl) and a slot's signature
// is checked exactly on wasm — see that function. `bool` here, a machine word for the `hash` above.
//
// Both per-argument ABI masks are 0 for `emitHtKeyHash`'s reason, one argument further: `equals(self, other
// Self)` takes the key type TWICE, and the key types `Map` admits are all whole machine words.
function emitHtKeyEquals(module StdModule, block IrBlock, eqWitness ValueId, a ValueId, b ValueId, ids ValueMinter) returns ValueId
	let equal = ids.mint()
	module.appendOp(block, op: StdOp.witnessCall(equal, witnessAddr: eqWitness, methodIndex: HtWitnessMethodIndex, resultType: StdReturnType.value(builtinProtocolResultStdType(BoolConformerName)), argFloatMask: 0, argNarrowMask: 0, args: twoArgs(a, second: b)))
	return equal
end 'emitHtKeyEquals'

// Terminate `cur` branching to `matchBlock` iff slot `index` holds an entry EQUAL to `key` — the cached hash
// matches (`hashes[index] == hash`) AND the key compares equal through the Equatable witness — else to
// `noMatchBlock`. The hash guard skips the witness `equals` call whenever the cached hashes differ (v1's
// optimization, and the reason `hashes` is cached at all). The `hashes`/`keys` buffers are reloaded from
// `table` here rather than passed in, keeping them off the probe loop's live set. Shared by insert, the read
// probe and the grow so the "is this slot our key?" test is written once.
function emitHtSlotMatchCheck(module StdModule, func IrFunction, cur IrBlock, table ValueId, index ValueId, hash ValueId, key ValueId, eqWitness ValueId, matchBlock IrBlock, noMatchBlock IrBlock, ids ValueMinter)
	var checkEquals = module.addBlock(func, label: b"hteq")
	let slotHash = emitHtRecordSlotLoad(module, block: cur, table: table, bufferOffset: HtHashesOffset, index: index, ids: ids)
	let hashMatches = emitCmp(module, block: cur, a: slotHash, b: hash, pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(cur, op: StdOp.condBranch(hashMatches, thenBlockId: checkEquals.id, elseBlockId: noMatchBlock.id))

	let slotKey = emitHtRecordSlotLoad(module, block: checkEquals, table: table, bufferOffset: HtKeysOffset, index: index, ids: ids)
	let keyEqual = emitHtKeyEquals(module, block: checkEquals, eqWitness: eqWitness, a: slotKey, b: key, ids: ids)
	module.setTerminator(checkEquals, op: StdOp.condBranch(keyEqual, thenBlockId: matchBlock.id, elseBlockId: noMatchBlock.id))
end 'emitHtSlotMatchCheck'

// Terminate `block` with `ret <value>` — a bool/int constant result (`contains`/`remove` return 1/0; there is
// no `setcc` at this tier, so a verdict is a constant-returning block off a fused compare).
export function emitHtReturnConst(module StdModule, block IrBlock, value ParsedInt, ids ValueMinter)
	let result = emitConst(module, block: block, value: value, ids: ids)
	module.setTerminator(block, op: StdOp.ret(result))
end 'emitHtReturnConst'

// `__mm_free(buffer)` guarded on `buffer != 0` — a table that never grew has null buffers (`create` leaves
// them zeroed), so the drop and the first-grow's old-buffer release must both skip a null pointer
// (`__mm_free` of null faults). Threads `cur` (sets its terminator) and returns the continuation block.
function emitHtFreeBufferIfNonNull(module StdModule, func IrFunction, cur IrBlock, buffer ValueId, ids ValueMinter) returns IrBlock
	var doFree = module.addBlock(func, label: b"htfree")
	let done = module.addBlock(func, label: b"htfreedone")
	let zero = emitConst(module, block: cur, value: 0, ids: ids)
	let nonNull = emitCmp(module, block: cur, a: buffer, b: zero, pred: StdCmpPred.ne, ids: ids)
	module.setTerminator(cur, op: StdOp.condBranch(nonNull, thenBlockId: doFree.id, elseBlockId: done.id))

	let freed = ids.mint()
	module.appendOp(doFree, op: StdOp.call(freed, callee: MmFreeName, args: argsOf(buffer)))
	module.setTerminator(doFree, op: StdOp.branch(done.id))

	return done
end 'emitHtFreeBufferIfNonNull'

// Store a KEY entry — `key`, `Occupied` (state) and `hash` (cached) — into slot `index` of the three parallel
// key-side buffers (each reloaded from `table`) and increment the record's `count`. Does NOT terminate
// `block` (the caller returns), and does NOT touch the value column: the VALUE store is a separate one-line
// call at the sites that have one, which is what keeps a shape flag out of this helper. The shared publish
// action — an empty-slot insert, a tombstone reuse, the probe-exhausted fallback and the grow rehash all use
// it, so the "publish an entry" write set is written once.
function emitHtStoreKeyEntry(module StdModule, block IrBlock, table ValueId, index ValueId, key ValueId, hash ValueId, ids ValueMinter)
	emitHtRecordSlotStore(module, block: block, table: table, bufferOffset: HtKeysOffset, index: index, value: key, ids: ids)
	let occupied = emitConst(module, block: block, value: HtSlotOccupied, ids: ids)
	emitHtRecordSlotStore(module, block: block, table: table, bufferOffset: HtStatesOffset, index: index, value: occupied, ids: ids)
	emitHtRecordSlotStore(module, block: block, table: table, bufferOffset: HtHashesOffset, index: index, value: hash, ids: ids)
	let count = emitLoadField(module, block: block, record: table, offset: HtCountOffset, ids: ids)
	let one = emitConst(module, block: block, value: 1, ids: ids)
	let newCount = emitBin(module, block: block, a: count, b: one, opcode: StdBinOpcode.add, ids: ids)
	emitStoreField(module, block: block, record: table, offset: HtCountOffset, value: newCount)
end 'emitHtStoreKeyEntry'

// Publish a whole entry at `index` — the key side above, plus the value beside it when this operation HAS a
// value to publish. The one door the three insert sites and the rehash write through, so a table that carries
// values can never publish a key without its value.
function emitHtPublishEntry(module StdModule, block IrBlock, table ValueId, index ValueId, key ValueId, hash ValueId, value HtInsertValue, ids ValueMinter)
	emitHtStoreKeyEntry(module, block: block, table: table, index: index, key: key, hash: hash, ids: ids)
	match value 'valueColumn'
		absent then break 'valueColumn'
		present(v) then emitHtRecordSlotStore(module, block: block, table: table, bufferOffset: HtValuesOffset, index: index, value: v, ids: ids)
	end 'valueColumn'
end 'emitHtPublishEntry'

// Tombstone slot `index`: state `Deleted`, `count` down one. The cached hash is deliberately LEFT in the slot
// — the hash guard only runs inside the Occupied branch, so a stale hash on a tombstone can never cause a
// false match (v1's contract). Does NOT drop the stored key or value; that is the caller's, because a
// `remove` that HANDS THE VALUE BACK and one that drops it want different things.
export function emitHtTombstoneSlot(module StdModule, block IrBlock, table ValueId, index ValueId, ids ValueMinter)
	let deletedTag = emitConst(module, block: block, value: HtSlotDeleted, ids: ids)
	emitHtRecordSlotStore(module, block: block, table: table, bufferOffset: HtStatesOffset, index: index, value: deletedTag, ids: ids)
	let count = emitLoadField(module, block: block, record: table, offset: HtCountOffset, ids: ids)
	let one = emitConst(module, block: block, value: 1, ids: ids)
	let newCount = emitBin(module, block: block, a: count, b: one, opcode: StdBinOpcode.sub, ids: ids)
	emitStoreField(module, block: block, record: table, offset: HtCountOffset, value: newCount)
end 'emitHtTombstoneSlot'

// --- Managed-column drop helpers (P1.7b String keys; P1.9 Map values) ---
//
// The destructor CALL ABI itself (`callIndirect(drop, value)`, `(i64) -> void`, mask 0) is NOT restated here:
// a managed table's stored key destructor IS its source array's element destructor (same
// `funcAddr(__str_decref)`, read from `ArrElementDestroyOffset` by `__set_from`), so both drop through
// ArrayRuntime's shared `emitElementDestructorCall` — the ONE home of that ABI, which a third copy here would
// let silently drift into a miscompiled indirect call. These helpers only add the table-specific gating (test
// the column's drop stamp `!= 0`) and the slot walk around it.
//
// ⭐ **THEY ARE PARAMETERIZED BY WHICH COLUMN, so a key and a value drop through ONE piece of code.** The two
// columns are independent — a `Map with (String, int)` walks its keys and not its values — and the gate is
// per column, read off `keyDrop@40` or `valueDrop@56`.

// ⭐⭐ **THE MANAGED-COLUMN GATE, WRITTEN ONCE.** Both helpers below put the identical question to the table —
// *does the column at `dropOffset` carry a destructor?* — and answered it with the identical four ops: load
// the stamp, compare it against 0, and branch `cur` into the managed path or past it. Only the BODY between
// those two blocks differs (one value dropped, or every occupied slot walked), so only the body is written
// twice now.
//
// It returns the LOADED destructor because the managed body needs it and must not load it a second time —
// two loads of one stamp are two things that could disagree after a later edit puts a store between them.
//
// ⚠ **THE CALLER MINTS BOTH BLOCKS AND TERMINATES ITS OWN BODY**, which is not an oversight: the block
// LABELS are what a reader of the emitted IR sees and `htdrop` (drop this one value) and `htdtorw` (walk the
// whole table) name two different jobs, while a body that ends in a DIFFERENT block from the one it started
// in — the walk exits its loop — is exactly the thing a gate cannot know.
function emitHtBranchOnColumnDrop(module StdModule, cur IrBlock, table ValueId, dropOffset ByteOffset, managed IrBlock, cont IrBlock, ids ValueMinter) returns ValueId
	let drop = emitLoadField(module, block: cur, record: table, offset: dropOffset, ids: ids)
	let zeroDrop = emitConst(module, block: cur, value: 0, ids: ids)
	let hasDrop = emitCmp(module, block: cur, a: drop, b: zeroDrop, pred: StdCmpPred.ne, ids: ids)
	module.setTerminator(cur, op: StdOp.condBranch(hasDrop, thenBlockId: managed.id, elseBlockId: cont.id))

	return drop
end 'emitHtBranchOnColumnDrop'

// ⭐ **DROP ONE VALUE IFF the column at `dropOffset` carries a destructor.** When the stamp is non-zero (a
// MANAGED column), call it on `value`; a trivial column (stamp 0) skips it untouched. The single-value twin
// of the teardown walk below, shared by insert's duplicate-key drop (the new key the table did not keep, and
// the old value it replaced) and `__set_remove` (the stored key it vacated), so a trivial-column table can
// never `callIndirect(0)` and each managed value is freed exactly once. Threads `cur` (sets its terminator)
// and returns the block both paths converge on.
export function emitHtDropIfManaged(module StdModule, func IrFunction, cur IrBlock, table ValueId, dropOffset ByteOffset, value ValueId, ids ValueMinter) returns IrBlock
	var doDrop = module.addBlock(func, label: b"htdrop")
	let cont = module.addBlock(func, label: b"htdropc")
	let drop = emitHtBranchOnColumnDrop(module, cur: cur, table: table, dropOffset: dropOffset, managed: doDrop, cont: cont, ids: ids)

	emitElementDestructorCall(module, block: doDrop, destroy: drop, elem: value, ids: ids)
	module.setTerminator(doDrop, op: StdOp.branch(cont.id))

	return cont
end 'emitHtDropIfManaged'

// ⭐ **DESTROY EVERY LIVE ENTRY OF ONE COLUMN on teardown IFF that column carries a destructor.** The
// hash-table twin of `buildArrDecref`'s `emitDestroyRangeIfManaged`: gated on the column's stamp `!= 0` (a
// trivial column skips the whole walk), it scans `[0, capacity)` and, where `states[i] == Occupied`, drops
// `buffer[i]` through the stored destructor. Gated on the STATE buffer (Occupied), not a null pointer,
// because a slot's liveness is its STATE, not its content — a tombstoned (Deleted) slot's contents were
// already dropped by `remove`, and an Empty slot never held any. Called by `decref` BEFORE the buffers are
// freed (it reads them). Threads `cur` (sets its terminator) and returns the block both paths converge on.
function emitHtDestroyColumnIfManaged(module StdModule, func IrFunction, cur IrBlock, table ValueId, dropOffset ByteOffset, bufferOffset ByteOffset, ids ValueMinter) returns IrBlock
	var walk = module.addBlock(func, label: b"htdtorw")
	let cont = module.addBlock(func, label: b"htdtorc")
	let drop = emitHtBranchOnColumnDrop(module, cur: cur, table: table, dropOffset: dropOffset, managed: walk, cont: cont, ids: ids)

	var afterWalk = emitHtOccupiedDropRange(module, func: func, cur: walk, table: table, drop: drop, bufferOffset: bufferOffset, ids: ids)
	module.setTerminator(afterWalk, op: StdOp.branch(cont.id))

	return cont
end 'emitHtDestroyColumnIfManaged'

// The `[0, capacity)` Occupied-slot destroy LOOP of `emitHtDestroyColumnIfManaged` — factored out so the gate
// (load destructor, test non-zero) and the walk read separately, exactly as `emitElementDestroyRange` splits
// from its own gate. `drop` is the already-loaded, non-null column destructor. The capacity and the two
// buffers are loop-invariant (teardown neither grows nor mutates the table), loaded once in `cur` (which
// dominates the loop), so the loop's live set stays small — a non-probe walk, exactly as `buildArrDecref`'s
// does. Returns the loop's exit block.
function emitHtOccupiedDropRange(module StdModule, func IrFunction, cur IrBlock, table ValueId, drop ValueId, bufferOffset ByteOffset, ids ValueMinter) returns IrBlock
	var header = module.addBlock(func, label: b"htoccdh")
	var body = module.addBlock(func, label: b"htoccdb")
	var doDrop = module.addBlock(func, label: b"htoccdd")
	var step = module.addBlock(func, label: b"htoccds")
	let done = module.addBlock(func, label: b"htoccdone")

	let capacity = emitLoadField(module, block: cur, record: table, offset: HtCapacityOffset, ids: ids)
	let states = emitLoadField(module, block: cur, record: table, offset: HtStatesOffset, ids: ids)
	let entries = emitLoadField(module, block: cur, record: table, offset: bufferOffset, ids: ids)
	let scanStart = emitConst(module, block: cur, value: 0, ids: ids)
	module.setTerminator(cur, op: StdOp.branch(header.id))
	cur.branchEdges.push(BranchEdge.create(header.id, argIds: argsOf(scanStart)))

	// header(i): walk the whole table `[0, capacity)`.
	let i = ids.mint()
	header.blockArgs.push(IrBlockArg.create(i, argType: StdType.i64))
	let atEnd = emitCmp(module, block: header, a: i, b: capacity, pred: StdCmpPred.ge, ids: ids)
	module.setTerminator(header, op: StdOp.condBranch(atEnd, thenBlockId: done.id, elseBlockId: body.id))

	// body: an Occupied slot holds a live entry to drop; Empty/Deleted slots hold none.
	let state = emitWordSlotLoad(module, block: body, base: states, index: i, ids: ids)
	let occupiedTag = emitConst(module, block: body, value: HtSlotOccupied, ids: ids)
	let isOccupied = emitCmp(module, block: body, a: state, b: occupiedTag, pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(body, op: StdOp.condBranch(isOccupied, thenBlockId: doDrop.id, elseBlockId: step.id))

	let entry = emitWordSlotLoad(module, block: doDrop, base: entries, index: i, ids: ids)
	emitElementDestructorCall(module, block: doDrop, destroy: drop, elem: entry, ids: ids)
	module.setTerminator(doDrop, op: StdOp.branch(step.id))

	// step: `i = i + 1`.
	let one = emitConst(module, block: step, value: 1, ids: ids)
	let iNext = emitBin(module, block: step, a: i, b: one, opcode: StdBinOpcode.add, ids: ids)
	module.setTerminator(step, op: StdOp.branch(header.id))
	step.branchEdges.push(BranchEdge.create(header.id, argIds: argsOf(iNext)))

	return done
end 'emitHtOccupiedDropRange'

// --- The shared runtime functions ---

// `create(keyDrop[, valueDrop]) -> tablePtr` — a fresh empty table carrying its per-column destructors. The
// record comes zeroed from `__mm_alloc` (count 0, capacity 0, all buffers null), so only the stamps are
// written (`__str_decref` for a String column, 0 for a trivial int one): the first insert grows from capacity
// 0. The record's own MM-header destructor is 0 — its buffers and entries are freed explicitly by `decref`
// (the scope-exit drop), exactly as an array's buffer is freed by `__arr_decref`, not by the header
// destructor. The `keyDrop` param is the `Array` twin of `__arr_create`'s `elementDestroy`.
function buildHtCreate(module StdModule, family HashTableFamily)
	let paramCount = 2 as ParamCount if family.carriesValues else 1
	let paramTypes = twoI64Params() if family.carriesValues else oneI64Param()
	var func = IrFunction.createFromStd(family.createName, returnType: StdReturnType.value(StdType.i64), paramCount: paramCount, paramTypes: paramTypes, returnLine: 0)
	var ids = ValueMinter.create(paramCount)

	var entry = module.addBlock(func, label: b"entry")
	emitParams(module, block: entry, count: paramCount)
	let keyDrop = 0 as ValueId

	let recordSize = emitConst(module, block: entry, value: family.recordBytes as ParsedInt, ids: ids)
	let recordDtor = emitConst(module, block: entry, value: 0, ids: ids)
	let record = ids.mint()
	module.appendOp(entry, op: StdOp.call(record, callee: MmAllocName, args: twoArgs(recordSize, second: recordDtor)))
	emitStoreField(module, block: entry, record: record, offset: HtKeyDropOffset, value: keyDrop)
	if family.carriesValues 'stampValueDrop'
		let valueDrop = 1 as ValueId
		emitStoreField(module, block: entry, record: record, offset: HtValueDropOffset, value: valueDrop)
	end 'stampValueDrop'
	module.setTerminator(entry, op: StdOp.ret(record))

	module.functions.push(func)
end 'buildHtCreate'

// `count(table) -> count` — the record's `count@0`.
function buildHtCount(module StdModule, family HashTableFamily)
	var func = IrFunction.createFromStd(family.countName, returnType: StdReturnType.value(StdType.i64), paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry")
	emitParams(module, block: entry, count: 1)
	let count = emitLoadField(module, block: entry, record: 0 as ValueId, offset: HtCountOffset, ids: ids)
	module.setTerminator(entry, op: StdOp.ret(count))

	module.functions.push(func)
end 'buildHtCount'

// `grow(table)` — double the capacity (or lazily allocate 16 slots when it is 0), reallocate every parallel
// buffer, and REHASH every `Occupied` entry into the new buffers REUSING its cached hash (no witness call).
// Tombstones are DROPPED — the fresh table has no `Deleted` slots — so `grow` also cleans the table. `count`
// is reset to 0 and re-counted during the rehash. Called by `insert` when the load factor is crossed.
//
// The OLD buffers and `oldCap` are carried across the rehash — they are the source data and the record no
// longer points at them once the new buffers are published — but the NEW buffers are reloaded from `table`
// where written, keeping the loop's live set small (the header note).
function buildHtGrow(module StdModule, family HashTableFamily)
	var func = IrFunction.createFromStd(family.growName, returnType: StdReturnType.void, paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry")
	var useInitial = module.addBlock(func, label: b"useinit")
	var useDoubled = module.addBlock(func, label: b"usedbl")
	var alloc = module.addBlock(func, label: b"alloc")
	var rehashHeader = module.addBlock(func, label: b"rehashh")
	var rehashBody = module.addBlock(func, label: b"rehashb")
	var reinsert = module.addBlock(func, label: b"reinsert")
	var findHeader = module.addBlock(func, label: b"findh")
	var findStep = module.addBlock(func, label: b"finds")
	var place = module.addBlock(func, label: b"place")
	var rehashStep = module.addBlock(func, label: b"rehashstep")
	var freeOld = module.addBlock(func, label: b"freeold")

	emitParams(module, block: entry, count: 1)
	let table = 0 as ValueId

	// entry: capture the old table, then pick the new capacity — double it, or 16 when it was 0 (the first
	// grow / lazy init). `oldCap * 2` via `oldCap + oldCap`.
	let oldCap = emitLoadField(module, block: entry, record: table, offset: HtCapacityOffset, ids: ids)
	let oldKeys = emitLoadField(module, block: entry, record: table, offset: HtKeysOffset, ids: ids)
	let oldStates = emitLoadField(module, block: entry, record: table, offset: HtStatesOffset, ids: ids)
	let oldHashes = emitLoadField(module, block: entry, record: table, offset: HtHashesOffset, ids: ids)
	// ⚠ CAPTURED HERE, beside the three key-side buffers and BEFORE the record is repointed in `alloc` — the
	// rehash reads its moved values out of this pointer, and the release below frees it.
	let oldValues = emitHtGrowCaptureOldValues(module, family: family, block: entry, table: table, ids: ids)
	let doubled = emitBin(module, block: entry, a: oldCap, b: oldCap, opcode: StdBinOpcode.add, ids: ids)
	let zero = emitConst(module, block: entry, value: 0, ids: ids)
	let wasEmpty = emitCmp(module, block: entry, a: doubled, b: zero, pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(entry, op: StdOp.condBranch(wasEmpty, thenBlockId: useInitial.id, elseBlockId: useDoubled.id))

	// useInitial / useDoubled → alloc(newCap): the new capacity flows in as `alloc`'s block arg.
	let initialCap = emitConst(module, block: useInitial, value: HtInitialCapacity, ids: ids)
	module.setTerminator(useInitial, op: StdOp.branch(alloc.id))
	useInitial.branchEdges.push(BranchEdge.create(alloc.id, argIds: argsOf(initialCap)))
	module.setTerminator(useDoubled, op: StdOp.branch(alloc.id))
	useDoubled.branchEdges.push(BranchEdge.create(alloc.id, argIds: argsOf(doubled)))

	let newCap = ids.mint()
	alloc.blockArgs.push(IrBlockArg.create(newCap, argType: StdType.i64))
	let slotBytes = emitConst(module, block: alloc, value: WordSlotBytes, ids: ids)
	let newBytes = emitBin(module, block: alloc, a: newCap, b: slotBytes, opcode: StdBinOpcode.mul, ids: ids)
	let bufDtor = emitConst(module, block: alloc, value: 0, ids: ids)
	let newKeys = ids.mint()
	module.appendOp(alloc, op: StdOp.call(newKeys, callee: MmAllocName, args: twoArgs(newBytes, second: bufDtor)))
	let newStates = ids.mint()
	module.appendOp(alloc, op: StdOp.call(newStates, callee: MmAllocName, args: twoArgs(newBytes, second: bufDtor)))
	let newHashes = ids.mint()
	module.appendOp(alloc, op: StdOp.call(newHashes, callee: MmAllocName, args: twoArgs(newBytes, second: bufDtor)))
	// Publish the new (empty) table BEFORE the rehash — `emitHtPublishEntry` reloads the buffers and `count`
	// off the record, so it must already hold the new buffers and a reset count of 0.
	emitStoreField(module, block: alloc, record: table, offset: HtKeysOffset, value: newKeys)
	emitStoreField(module, block: alloc, record: table, offset: HtStatesOffset, value: newStates)
	emitStoreField(module, block: alloc, record: table, offset: HtHashesOffset, value: newHashes)
	emitStoreField(module, block: alloc, record: table, offset: HtCapacityOffset, value: newCap)
	let countReset = emitConst(module, block: alloc, value: 0, ids: ids)
	emitStoreField(module, block: alloc, record: table, offset: HtCountOffset, value: countReset)
	// The VALUE column's new buffer, allocated and published beside the three above and for the same reason:
	// the rehash reloads the record, so it must already hold every new buffer.
	emitHtGrowPublishNewValues(module, family: family, block: alloc, table: table, byteCount: newBytes, bufDtor: bufDtor, ids: ids)
	let scanStart = emitConst(module, block: alloc, value: 0, ids: ids)
	module.setTerminator(alloc, op: StdOp.branch(rehashHeader.id))
	alloc.branchEdges.push(BranchEdge.create(rehashHeader.id, argIds: argsOf(scanStart)))

	// rehashHeader(i): walk the OLD table `[0, oldCap)`.
	let i = ids.mint()
	rehashHeader.blockArgs.push(IrBlockArg.create(i, argType: StdType.i64))
	let scanDone = emitCmp(module, block: rehashHeader, a: i, b: oldCap, pred: StdCmpPred.ge, ids: ids)
	module.setTerminator(rehashHeader, op: StdOp.condBranch(scanDone, thenBlockId: freeOld.id, elseBlockId: rehashBody.id))

	// rehashBody: only an OLD `Occupied` slot is re-inserted (a tombstone is dropped).
	let oldState = emitWordSlotLoad(module, block: rehashBody, base: oldStates, index: i, ids: ids)
	let occupiedTag = emitConst(module, block: rehashBody, value: HtSlotOccupied, ids: ids)
	let isOccupied = emitCmp(module, block: rehashBody, a: oldState, b: occupiedTag, pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(rehashBody, op: StdOp.condBranch(isOccupied, thenBlockId: reinsert.id, elseBlockId: rehashStep.id))

	// reinsert: seed the find-empty-slot probe from the CACHED hash (no witness call).
	let key = emitWordSlotLoad(module, block: reinsert, base: oldKeys, index: i, ids: ids)
	let hash = emitWordSlotLoad(module, block: reinsert, base: oldHashes, index: i, ids: ids)
	let seedMask = emitHtMask(module, block: reinsert, table: table, ids: ids)
	let seedSlot = emitBin(module, block: reinsert, a: hash, b: seedMask, opcode: StdBinOpcode.bitAnd, ids: ids)
	module.setTerminator(reinsert, op: StdOp.branch(findHeader.id))
	reinsert.branchEdges.push(BranchEdge.create(findHeader.id, argIds: argsOf(seedSlot)))

	// findHeader(slot): linear-probe the fresh table for an `Empty` slot (no tombstones exist, so `Empty` is
	// the only stop — the guaranteed free slot the doubled capacity provides).
	let slot = ids.mint()
	findHeader.blockArgs.push(IrBlockArg.create(slot, argType: StdType.i64))
	let slotState = emitHtRecordSlotLoad(module, block: findHeader, table: table, bufferOffset: HtStatesOffset, index: slot, ids: ids)
	let emptyTag = emitConst(module, block: findHeader, value: HtSlotEmpty, ids: ids)
	let slotIsEmpty = emitCmp(module, block: findHeader, a: slotState, b: emptyTag, pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(findHeader, op: StdOp.condBranch(slotIsEmpty, thenBlockId: place.id, elseBlockId: findStep.id))

	// findStep: `slot = (slot + 1) and mask`.
	let stepOne = emitConst(module, block: findStep, value: 1, ids: ids)
	let slotInc = emitBin(module, block: findStep, a: slot, b: stepOne, opcode: StdBinOpcode.add, ids: ids)
	let findMask = emitHtMask(module, block: findStep, table: table, ids: ids)
	let slotNext = emitBin(module, block: findStep, a: slotInc, b: findMask, opcode: StdBinOpcode.bitAnd, ids: ids)
	module.setTerminator(findStep, op: StdOp.branch(findHeader.id))
	findStep.branchEdges.push(BranchEdge.create(findHeader.id, argIds: argsOf(slotNext)))

	// place: store the entry (and bump `count`) at the empty slot, then advance the outer walk. The moved
	// VALUE is read HERE rather than in `reinsert` — see the header's register-pressure note: reading it a
	// block later keeps it out of the find loop's live range, and `oldValues`/`i` are live either way.
	let moved = emitHtRehashValueMove(module, block: place, oldValues: oldValues, index: i, ids: ids)
	emitHtPublishEntry(module, block: place, table: table, index: slot, key: key, hash: hash, value: moved, ids: ids)
	module.setTerminator(place, op: StdOp.branch(rehashStep.id))

	// rehashStep: `i = i + 1`.
	let outerOne = emitConst(module, block: rehashStep, value: 1, ids: ids)
	let iNext = emitBin(module, block: rehashStep, a: i, b: outerOne, opcode: StdBinOpcode.add, ids: ids)
	module.setTerminator(rehashStep, op: StdOp.branch(rehashHeader.id))
	rehashStep.branchEdges.push(BranchEdge.create(rehashHeader.id, argIds: argsOf(iNext)))

	// freeOld: release the old buffers (null on the first grow — skipped by the guard).
	var afterFree = emitHtFreeBufferIfNonNull(module, func: func, cur: freeOld, buffer: oldKeys, ids: ids)
	afterFree = emitHtFreeBufferIfNonNull(module, func: func, cur: afterFree, buffer: oldStates, ids: ids)
	afterFree = emitHtFreeBufferIfNonNull(module, func: func, cur: afterFree, buffer: oldHashes, ids: ids)
	match oldValues 'freeValues'
		absent then break 'freeValues'
		present(buffer) then afterFree = emitHtFreeBufferIfNonNull(module, func: func, cur: afterFree, buffer: buffer, ids: ids)
	end 'freeValues'
	module.setTerminator(afterFree, op: StdOp.retVoid)

	module.functions.push(func)
end 'buildHtGrow'

// A grow's VALUE column, half one: capture the OLD `values@48` before the record is repointed. `absent` for a
// key-only table, so the rehash and the old-buffer release below it are branch-free at BUILD time rather than
// at run time — a `Set`'s grow emits not one instruction of the value column.
function emitHtGrowCaptureOldValues(module StdModule, family HashTableFamily, block IrBlock, table ValueId, ids ValueMinter) returns HtInsertValue
	if not family.carriesValues 'keysOnly'
		return HtInsertValue.absent
	end 'keysOnly'

	return HtInsertValue.present(emitLoadField(module, block: block, record: table, offset: HtValuesOffset, ids: ids))
end 'emitHtGrowCaptureOldValues'

// A grow's VALUE column, half two: allocate the new buffer and publish it into the record, beside the three
// key-side buffers and BEFORE the rehash, which reloads all of them off the record.
function emitHtGrowPublishNewValues(module StdModule, family HashTableFamily, block IrBlock, table ValueId, byteCount ValueId, bufDtor ValueId, ids ValueMinter)
	if not family.carriesValues 'keysOnly'
		return
	end 'keysOnly'

	let newValues = ids.mint()
	module.appendOp(block, op: StdOp.call(newValues, callee: MmAllocName, args: twoArgs(byteCount, second: bufDtor)))
	emitStoreField(module, block: block, record: table, offset: HtValuesOffset, value: newValues)
end 'emitHtGrowPublishNewValues'

// The value the rehash carries across with slot `index`'s key — read out of the OLD values buffer, which the
// record no longer points at. `absent` in, `absent` out: a key-only table moves nothing.
function emitHtRehashValueMove(module StdModule, block IrBlock, oldValues HtInsertValue, index ValueId, ids ValueMinter) returns HtInsertValue
	var moved = HtInsertValue.absent
	match oldValues 'column'
		absent then break 'column'
		present(buffer) then moved = HtInsertValue.present(emitWordSlotLoad(module, block: block, base: buffer, index: index, ids: ids))
	end 'column'
	return moved
end 'emitHtRehashValueMove'

// `insert(table, key[, value], hashWitness, eqWitness)` — publish `key` (and its value) unless the key is
// already present. Grows first when the load factor is crossed (which also covers the lazy init from capacity
// 0). The probe reuses a `Deleted` tombstone (`firstDeleted`) so a remove-then-reinsert refills the vacated
// slot rather than growing.
//
// ⭐ **THE DUPLICATE-KEY ARM IS THE ONE PLACE THE TWO CONTAINERS DIVERGE, AND IT IS ONE BRANCH RATHER THAN A
// SECOND FUNCTION.** A `Set` keeps its existing key and DROPS the redundant new one (`__set_insert` is a
// no-op on a duplicate). A `Map` drops the redundant new key too, then drops the OLD value and stores the new
// one in its place — which is what makes `__map_upsert` an insert-or-REPLACE. Everything above that arm — the
// grow, the seed, the tombstone preference, the probe bound, the exhausted fallback — is the same code.
//
// Across the probe loop only `{table, key, value, eqWitness, hash}` plus the loop indices `{index, probes,
// firstDeleted}` stay live; the buffers, capacity and mask are reloaded from `table` where used (header note).
function buildHtInsert(module StdModule, family HashTableFamily)
	let paramCount = 5 as ParamCount if family.carriesValues else 4
	let paramTypes = fiveI64Params() if family.carriesValues else fourI64Params()
	var func = IrFunction.createFromStd(family.insertName, returnType: StdReturnType.void, paramCount: paramCount, paramTypes: paramTypes, returnLine: 0)
	var ids = ValueMinter.create(paramCount)

	var entry = module.addBlock(func, label: b"entry")
	var doGrow = module.addBlock(func, label: b"dogrow")
	var setup = module.addBlock(func, label: b"setup")
	var header = module.addBlock(func, label: b"probeh")
	var body = module.addBlock(func, label: b"probeb")
	var notEmpty = module.addBlock(func, label: b"notempty")
	var checkDup = module.addBlock(func, label: b"checkdup")
	var noMatchDup = module.addBlock(func, label: b"nomatch")
	var isDeleted = module.addBlock(func, label: b"isdel")
	var keepFirst = module.addBlock(func, label: b"keepfd")
	var recordFirst = module.addBlock(func, label: b"recfd")
	var step = module.addBlock(func, label: b"probestep")
	var emptyInsert = module.addBlock(func, label: b"emptyins")
	var insertAtDeleted = module.addBlock(func, label: b"insdel")
	var insertAtEmpty = module.addBlock(func, label: b"insempty")
	var dupFound = module.addBlock(func, label: b"dupfound")
	var exhausted = module.addBlock(func, label: b"exhausted")
	var fallbackInsert = module.addBlock(func, label: b"fallback")
	var unreachableFull = module.addBlock(func, label: b"nofree")

	emitParams(module, block: entry, count: paramCount)
	let table = 0 as ValueId
	let key = 1 as ValueId
	// ⚠ The two witnesses are APPENDED by lowering (`appendSetWitnessArgs`), so they are always LAST — which
	// is why a map's value sits between the key and them and shifts both by one. `value` is a union rather
	// than a `ValueId` for the reason `HtInsertValue` states: a set's parameter 2 is `hashWitness`.
	var value = HtInsertValue.absent
	if family.carriesValues 'hasValueColumn'
		value = HtInsertValue.present(2 as ValueId)
	end 'hasValueColumn'
	let hashWitness = 3 as ValueId if family.carriesValues else 2
	let eqWitness = 4 as ValueId if family.carriesValues else 3

	// entry: grow when `count >= (capacity * 3) / 4` — which for capacity 0 is `0 >= 0`, so the FIRST insert
	// always grows (lazy init to 16). One grow suffices: it at least doubles, so `count` is well under the new
	// load limit afterward and the probe below never grows again.
	let count = emitLoadField(module, block: entry, record: table, offset: HtCountOffset, ids: ids)
	let capacity = emitLoadField(module, block: entry, record: table, offset: HtCapacityOffset, ids: ids)
	let loadNumerator = emitConst(module, block: entry, value: LoadFactorNumerator, ids: ids)
	let scaled = emitBin(module, block: entry, a: capacity, b: loadNumerator, opcode: StdBinOpcode.mul, ids: ids)
	let loadDenominator = emitConst(module, block: entry, value: LoadFactorDenominator, ids: ids)
	let loadLimit = ids.mint()
	module.appendOp(entry, op: StdOp.div(loadLimit, lhs: scaled, rhs: loadDenominator))
	let needGrow = emitCmp(module, block: entry, a: count, b: loadLimit, pred: StdCmpPred.ge, ids: ids)
	module.setTerminator(entry, op: StdOp.condBranch(needGrow, thenBlockId: doGrow.id, elseBlockId: setup.id))

	let grew = ids.mint()
	module.appendOp(doGrow, op: StdOp.call(grew, callee: family.growName, args: argsOf(table)))
	module.setTerminator(doGrow, op: StdOp.branch(setup.id))

	// setup: hash the key and seed the probe. The mask/capacity/buffers are NOT hoisted — they are reloaded in
	// the loop bodies (see the header's register-pressure note), so only `{table, key, value, eqWitness,
	// hash}` and the three loop indices cross the loop.
	let seedMask = emitHtMask(module, block: setup, table: table, ids: ids)
	let hash = emitHtKeyHash(module, block: setup, hashWitness: hashWitness, key: key, ids: ids)
	let startIndex = emitBin(module, block: setup, a: hash, b: seedMask, opcode: StdBinOpcode.bitAnd, ids: ids)
	let zeroProbes = emitConst(module, block: setup, value: 0, ids: ids)
	let noneDeleted = emitConst(module, block: setup, value: FirstDeletedNone, ids: ids)
	module.setTerminator(setup, op: StdOp.branch(header.id))
	setup.branchEdges.push(BranchEdge.create(header.id, argIds: threeArgs(startIndex, second: zeroProbes, third: noneDeleted)))

	// header(index, probes, firstDeleted): bounded by `capacity` probes — a table full of Occupied+Deleted
	// (no Empty) must not loop forever, and the exhausted exit reuses the guaranteed tombstone.
	let index = ids.mint()
	let probes = ids.mint()
	let firstDeleted = ids.mint()
	header.blockArgs.push(IrBlockArg.create(index, argType: StdType.i64))
	header.blockArgs.push(IrBlockArg.create(probes, argType: StdType.i64))
	header.blockArgs.push(IrBlockArg.create(firstDeleted, argType: StdType.i64))
	let capForBound = emitLoadField(module, block: header, record: table, offset: HtCapacityOffset, ids: ids)
	let atEnd = emitCmp(module, block: header, a: probes, b: capForBound, pred: StdCmpPred.ge, ids: ids)
	module.setTerminator(header, op: StdOp.condBranch(atEnd, thenBlockId: exhausted.id, elseBlockId: body.id))

	// body: an Empty slot ends the probe — insert here (or at an earlier tombstone).
	let state = emitHtRecordSlotLoad(module, block: body, table: table, bufferOffset: HtStatesOffset, index: index, ids: ids)
	let emptyTag = emitConst(module, block: body, value: HtSlotEmpty, ids: ids)
	let isEmpty = emitCmp(module, block: body, a: state, b: emptyTag, pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(body, op: StdOp.condBranch(isEmpty, thenBlockId: emptyInsert.id, elseBlockId: notEmpty.id))

	// notEmpty: an Occupied slot may be our key (dup check); a Deleted slot records the first tombstone.
	let occupiedTag = emitConst(module, block: notEmpty, value: HtSlotOccupied, ids: ids)
	let isOccupied = emitCmp(module, block: notEmpty, a: state, b: occupiedTag, pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(notEmpty, op: StdOp.condBranch(isOccupied, thenBlockId: checkDup.id, elseBlockId: isDeleted.id))

	// checkDup: a matching Occupied slot is a duplicate; otherwise keep probing (firstDeleted unchanged).
	emitHtSlotMatchCheck(module, func: func, cur: checkDup, table: table, index: index, hash: hash, key: key, eqWitness: eqWitness, matchBlock: dupFound, noMatchBlock: noMatchDup, ids: ids)
	module.setTerminator(noMatchDup, op: StdOp.branch(step.id))
	noMatchDup.branchEdges.push(BranchEdge.create(step.id, argIds: argsOf(firstDeleted)))

	// isDeleted: remember the FIRST tombstone (`firstDeleted < 0` still), then keep probing for an Empty (a
	// later insert prefers the tombstone, keeping the table compact).
	let zeroForCheck = emitConst(module, block: isDeleted, value: 0, ids: ids)
	let alreadyHave = emitCmp(module, block: isDeleted, a: firstDeleted, b: zeroForCheck, pred: StdCmpPred.ge, ids: ids)
	module.setTerminator(isDeleted, op: StdOp.condBranch(alreadyHave, thenBlockId: keepFirst.id, elseBlockId: recordFirst.id))
	module.setTerminator(keepFirst, op: StdOp.branch(step.id))
	keepFirst.branchEdges.push(BranchEdge.create(step.id, argIds: argsOf(firstDeleted)))
	module.setTerminator(recordFirst, op: StdOp.branch(step.id))
	recordFirst.branchEdges.push(BranchEdge.create(step.id, argIds: argsOf(index)))

	// step(fd): `index = (index + 1) and mask`, `probes = probes + 1`, carrying the (possibly updated) firstDeleted.
	let fd = ids.mint()
	step.blockArgs.push(IrBlockArg.create(fd, argType: StdType.i64))
	let stepOne = emitConst(module, block: step, value: 1, ids: ids)
	let indexInc = emitBin(module, block: step, a: index, b: stepOne, opcode: StdBinOpcode.add, ids: ids)
	let stepMask = emitHtMask(module, block: step, table: table, ids: ids)
	let nextIndex = emitBin(module, block: step, a: indexInc, b: stepMask, opcode: StdBinOpcode.bitAnd, ids: ids)
	let nextProbes = emitBin(module, block: step, a: probes, b: stepOne, opcode: StdBinOpcode.add, ids: ids)
	module.setTerminator(step, op: StdOp.branch(header.id))
	step.branchEdges.push(BranchEdge.create(header.id, argIds: threeArgs(nextIndex, second: nextProbes, third: fd)))

	// emptyInsert: insert at the earlier tombstone if one was seen, else at this empty slot.
	let zeroForEmpty = emitConst(module, block: emptyInsert, value: 0, ids: ids)
	let haveDeleted = emitCmp(module, block: emptyInsert, a: firstDeleted, b: zeroForEmpty, pred: StdCmpPred.ge, ids: ids)
	module.setTerminator(emptyInsert, op: StdOp.condBranch(haveDeleted, thenBlockId: insertAtDeleted.id, elseBlockId: insertAtEmpty.id))
	emitHtPublishEntry(module, block: insertAtDeleted, table: table, index: firstDeleted, key: key, hash: hash, value: value, ids: ids)
	module.setTerminator(insertAtDeleted, op: StdOp.retVoid)
	emitHtPublishEntry(module, block: insertAtEmpty, table: table, index: index, key: key, hash: hash, value: value, ids: ids)
	module.setTerminator(insertAtEmpty, op: StdOp.retVoid)

	// dupFound: the key is already present — the table keeps its EXISTING copy, so the NEW `key` (moved in by
	// the caller) must be DROPPED here or it leaks. A trivial-key table skips the drop (keyDrop 0). A table
	// WITH a value column then REPLACES the value: the stored one is dropped and the new one takes its slot,
	// which is the whole of `upsert`'s insert-or-replace contract. `index` is the probe header's live index —
	// the header dominates this block and the drop-gate blocks below it — so it names the matched slot
	// throughout.
	var afterDupDrop = emitHtDropIfManaged(module, func: func, cur: dupFound, table: table, dropOffset: HtKeyDropOffset, value: key, ids: ids)
	match value 'replaceValue'
		absent then break 'replaceValue'
		present(v) then afterDupDrop = emitHtReplaceValue(module, func: func, cur: afterDupDrop, table: table, index: index, value: v, ids: ids)
	end 'replaceValue'
	module.setTerminator(afterDupDrop, op: StdOp.retVoid)

	// exhausted: every slot was probed without finding Empty — the table is Occupied+Deleted. The load factor
	// keeps `count` below capacity, so at least one slot is a tombstone and `firstDeleted >= 0` here; reuse it.
	// The `unreachableFull` branch (no tombstone AND no empty ⇒ count == capacity) cannot happen after a grow —
	// so it ABORTS rather than silently `retVoid`ing (which would drop the entry and leave `count` lying); a
	// reachable `unreachableFull` is a broken load-factor/grow invariant, a compiler bug, exactly the
	// "unreachable from source, abort not silence" class `ArrayRuntime`'s aborts already occupy.
	let zeroForFallback = emitConst(module, block: exhausted, value: 0, ids: ids)
	let haveFallback = emitCmp(module, block: exhausted, a: firstDeleted, b: zeroForFallback, pred: StdCmpPred.ge, ids: ids)
	module.setTerminator(exhausted, op: StdOp.condBranch(haveFallback, thenBlockId: fallbackInsert.id, elseBlockId: unreachableFull.id))
	emitHtPublishEntry(module, block: fallbackInsert, table: table, index: firstDeleted, key: key, hash: hash, value: value, ids: ids)
	module.setTerminator(fallbackInsert, op: StdOp.retVoid)
	emitRuntimeAbort(module, func: func, block: unreachableFull, abort: RuntimeAbort.hashTableInsertNoFreeSlot, ids: ids)

	module.functions.push(func)
end 'buildHtInsert'

// Replace slot `index`'s value: drop the stored one through `valueDrop@56` (a trivial value column skips it),
// then store the new one. The load MUST precede the drop's gate blocks, so it reads the slot in `cur` while
// the store writes it in the returned continuation. Threads `cur` and returns the block to carry on in.
function emitHtReplaceValue(module StdModule, func IrFunction, cur IrBlock, table ValueId, index ValueId, value ValueId, ids ValueMinter) returns IrBlock
	let oldValue = emitHtRecordSlotLoad(module, block: cur, table: table, bufferOffset: HtValuesOffset, index: index, ids: ids)
	var afterOldDrop = emitHtDropIfManaged(module, func: func, cur: cur, table: table, dropOffset: HtValueDropOffset, value: oldValue, ids: ids)
	emitHtRecordSlotStore(module, block: afterOldDrop, table: table, bufferOffset: HtValuesOffset, index: index, value: value, ids: ids)
	return afterOldDrop
end 'emitHtReplaceValue'

// `contains(table, key, hashWitness, eqWitness) -> bool` — probe for `key`, stopping at an Empty slot
// (absent) or a matching Occupied slot (present). An empty table (capacity 0) contains nothing. Identical for
// both containers: a value column changes nothing a membership test reads.
function buildHtContains(module StdModule, family HashTableFamily)
	var func = IrFunction.createFromStd(family.containsName, returnType: StdReturnType.value(StdType.i64), paramCount: 4, paramTypes: fourI64Params(), returnLine: 0)
	var ids = ValueMinter.create(4)

	var entry = module.addBlock(func, label: b"entry")
	var emptyTable = module.addBlock(func, label: b"emptytab")
	var probe = module.addBlock(func, label: b"probe")
	var found = module.addBlock(func, label: b"found")
	var notFound = module.addBlock(func, label: b"notfound")

	emitParams(module, block: entry, count: 4)
	let table = 0 as ValueId
	let key = 1 as ValueId
	let hashWitness = 2 as ValueId
	let eqWitness = 3 as ValueId

	emitHtEmptyTableCheck(module, entry: entry, table: table, emptyBlock: emptyTable, probeBlock: probe, ids: ids)
	emitHtReturnConst(module, block: emptyTable, value: 0, ids: ids)

	_ = emitHtLookupProbe(module, func: func, cur: probe, table: table, key: key, hashWitness: hashWitness, eqWitness: eqWitness, foundBlock: found, notFoundBlock: notFound, ids: ids)

	emitHtReturnConst(module, block: found, value: 1, ids: ids)
	emitHtReturnConst(module, block: notFound, value: 0, ids: ids)

	module.functions.push(func)
end 'buildHtContains'

// ⭐ **THE "IS THERE ANYTHING TO PROBE AT ALL?" GUARD, WRITTEN ONCE.** A table that never grew has capacity 0
// — so its mask would be `-1` and its buffers null — and every read entry point (`contains`, `remove`, `get`)
// must answer "absent" before seeding a probe. Terminates `entry` and leaves both destinations to the caller,
// which is what lets one guard serve a bool-returning probe and a throwing one.
export function emitHtEmptyTableCheck(module StdModule, entry IrBlock, table ValueId, emptyBlock IrBlock, probeBlock IrBlock, ids ValueMinter)
	let capacity = emitLoadField(module, block: entry, record: table, offset: HtCapacityOffset, ids: ids)
	let zero = emitConst(module, block: entry, value: 0, ids: ids)
	let isEmptyTable = emitCmp(module, block: entry, a: capacity, b: zero, pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(entry, op: StdOp.condBranch(isEmptyTable, thenBlockId: emptyBlock.id, elseBlockId: probeBlock.id))
end 'emitHtEmptyTableCheck'

// ⭐ **THE SHARED READ PROBE — `contains`, `__set_remove` AND `__map_get`.** Build the linear probe from
// `cur`: seed `index = hash and mask`, then loop bounded by `capacity` probes. Branch to `notFoundBlock` on an
// Empty slot or probe exhaustion, and to `foundBlock` on a matching Occupied slot. Returns the matched slot's
// index — the probe header's `index` block arg, live in `foundBlock` (which the header dominates) — so a
// caller can tombstone it or read its value. `insert` has its own probe (it tracks `firstDeleted` and
// inserts), so this serves the read/delete probes, which are otherwise identical. The capacity/mask/buffers
// are reloaded from `table` in the loop, keeping only `{table, key, eqWitness, hash}` and the two indices live
// across it.
export function emitHtLookupProbe(module StdModule, func IrFunction, cur IrBlock, table ValueId, key ValueId, hashWitness ValueId, eqWitness ValueId, foundBlock IrBlock, notFoundBlock IrBlock, ids ValueMinter) returns ValueId
	var header = module.addBlock(func, label: b"lkph")
	var body = module.addBlock(func, label: b"lkpb")
	var notEmpty = module.addBlock(func, label: b"lkpne")
	var checkKey = module.addBlock(func, label: b"lkpck")
	var step = module.addBlock(func, label: b"lkps")

	let seedMask = emitHtMask(module, block: cur, table: table, ids: ids)
	let hash = emitHtKeyHash(module, block: cur, hashWitness: hashWitness, key: key, ids: ids)
	let startIndex = emitBin(module, block: cur, a: hash, b: seedMask, opcode: StdBinOpcode.bitAnd, ids: ids)
	let zeroProbes = emitConst(module, block: cur, value: 0, ids: ids)
	module.setTerminator(cur, op: StdOp.branch(header.id))
	cur.branchEdges.push(BranchEdge.create(header.id, argIds: twoArgs(startIndex, second: zeroProbes)))

	let index = ids.mint()
	let probes = ids.mint()
	header.blockArgs.push(IrBlockArg.create(index, argType: StdType.i64))
	header.blockArgs.push(IrBlockArg.create(probes, argType: StdType.i64))
	let capForBound = emitLoadField(module, block: header, record: table, offset: HtCapacityOffset, ids: ids)
	let atEnd = emitCmp(module, block: header, a: probes, b: capForBound, pred: StdCmpPred.ge, ids: ids)
	module.setTerminator(header, op: StdOp.condBranch(atEnd, thenBlockId: notFoundBlock.id, elseBlockId: body.id))

	let state = emitHtRecordSlotLoad(module, block: body, table: table, bufferOffset: HtStatesOffset, index: index, ids: ids)
	let emptyTag = emitConst(module, block: body, value: HtSlotEmpty, ids: ids)
	let isEmpty = emitCmp(module, block: body, a: state, b: emptyTag, pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(body, op: StdOp.condBranch(isEmpty, thenBlockId: notFoundBlock.id, elseBlockId: notEmpty.id))

	let occupiedTag = emitConst(module, block: notEmpty, value: HtSlotOccupied, ids: ids)
	let isOccupied = emitCmp(module, block: notEmpty, a: state, b: occupiedTag, pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(notEmpty, op: StdOp.condBranch(isOccupied, thenBlockId: checkKey.id, elseBlockId: step.id))

	emitHtSlotMatchCheck(module, func: func, cur: checkKey, table: table, index: index, hash: hash, key: key, eqWitness: eqWitness, matchBlock: foundBlock, noMatchBlock: step, ids: ids)

	let stepOne = emitConst(module, block: step, value: 1, ids: ids)
	let indexInc = emitBin(module, block: step, a: index, b: stepOne, opcode: StdBinOpcode.add, ids: ids)
	let stepMask = emitHtMask(module, block: step, table: table, ids: ids)
	let nextIndex = emitBin(module, block: step, a: indexInc, b: stepMask, opcode: StdBinOpcode.bitAnd, ids: ids)
	let nextProbes = emitBin(module, block: step, a: probes, b: stepOne, opcode: StdBinOpcode.add, ids: ids)
	module.setTerminator(step, op: StdOp.branch(header.id))
	step.branchEdges.push(BranchEdge.create(header.id, argIds: twoArgs(nextIndex, second: nextProbes)))

	return index
end 'emitHtLookupProbe'

// `decref(table)` — the scope-exit drop for an owned table. Decref the record's refcount, and at the last
// owner DESTROY every live entry of every managed column (a managed key column walks its Occupied slots
// through `keyDrop@40`, a managed value column through `valueDrop@56`; a trivial column skips its walk
// entirely), then free the external buffers (each `__mm_free` guarded on non-null — an empty table never
// allocated them) and then the record. The hash-table twin of `__arr_decref`, entry walk and all.
//
// ⚠ **BOTH WALKS RUN BEFORE ANY FREE**, because each reads `states` plus its own column; freeing the states
// buffer between them would walk released memory.
function buildHtDecref(module StdModule, family HashTableFamily)
	var func = IrFunction.createFromStd(family.decrefName, returnType: StdReturnType.void, paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry")
	var lower = module.addBlock(func, label: b"lower")
	var release = module.addBlock(func, label: b"release")

	emitParams(module, block: entry, count: 1)
	let record = 0 as ValueId

	emitRefcountCheckToLastOwner(module, entry: entry, lower: lower, record: record, lastOwner: release, ids: ids)

	// release: DESTROY every live entry first, then read the buffer pointers BEFORE freeing any of them, and
	// free the buffers and the record.
	var cur = emitHtDestroyColumnIfManaged(module, func: func, cur: release, table: record, dropOffset: HtKeyDropOffset, bufferOffset: HtKeysOffset, ids: ids)
	if family.carriesValues 'destroyValues'
		cur = emitHtDestroyColumnIfManaged(module, func: func, cur: cur, table: record, dropOffset: HtValueDropOffset, bufferOffset: HtValuesOffset, ids: ids)
	end 'destroyValues'

	let keysBuf = emitLoadField(module, block: cur, record: record, offset: HtKeysOffset, ids: ids)
	let statesBuf = emitLoadField(module, block: cur, record: record, offset: HtStatesOffset, ids: ids)
	let hashesBuf = emitLoadField(module, block: cur, record: record, offset: HtHashesOffset, ids: ids)
	cur = emitHtFreeBufferIfNonNull(module, func: func, cur: cur, buffer: keysBuf, ids: ids)
	cur = emitHtFreeBufferIfNonNull(module, func: func, cur: cur, buffer: statesBuf, ids: ids)
	cur = emitHtFreeBufferIfNonNull(module, func: func, cur: cur, buffer: hashesBuf, ids: ids)
	if family.carriesValues 'freeValues'
		let valuesBuf = emitLoadField(module, block: cur, record: record, offset: HtValuesOffset, ids: ids)
		cur = emitHtFreeBufferIfNonNull(module, func: func, cur: cur, buffer: valuesBuf, ids: ids)
	end 'freeValues'

	let recFreed = ids.mint()
	module.appendOp(cur, op: StdOp.call(recFreed, callee: MmFreeName, args: argsOf(record)))
	module.setTerminator(cur, op: StdOp.retVoid)

	module.functions.push(func)
end 'buildHtDecref'
