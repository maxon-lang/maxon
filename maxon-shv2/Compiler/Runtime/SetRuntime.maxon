// Runtime/SetRuntime.maxon — what is genuinely a `Set`'s, and nothing else.
//
// ⭐⭐ **THE HASH TABLE ITSELF IS `HashTableRuntime.maxon`'s** — the record layout, the linear probe, the
// grow, the load factor, the tombstones, the per-column drop walks and the seven shared entry points
// (`create`/`grow`/`insert`/`contains`/`remove`/`count`/`decref`) are built there, once, for BOTH containers:
// a `Map with (Key, Value)` record IS this record with a value column appended, so `__set_grow` and
// `__map_grow` are one graph under two names. Read that file's header for the algorithm, the witness
// dispatch and the register-pressure rule.
//
// ⚠ **`__set_remove` WAS THE SEVENTH, AND THIS HEADER USED TO ARGUE IT COULD NOT BE.** It said a map's
// remove "would have to hand the VALUE back", making the two different signatures rather than one
// `carriesValues` branch. `specs/map.md` declares `remove(key) returns bool` — the set's signature exactly —
// so the premise was never read off the language, and the second copy it justified is now one graph. The
// reasoning lives at `HashTableRuntime.buildHtRemove`.
//
// What stays here is what a `Set` has that a `Map` does not:
//   • its `__set_*` entry-point names, its 48-byte record size, and its usage/witness predicates;
//   • `__set_from` — the `Set from [1,2,3]` construction, which has no map twin at all (a map literal is a
//     different surface).
//
// Keys are `int` / ranged-int (each ≤ 8 bytes, self-owning, no per-key destructor) OR a heap `String`, which
// the set OWNS: it carries a per-key destructor (`keyDrop@40`, the `Array with String` twin) and DROPS each
// live key on teardown, drops a duplicate insert's new key, and drops a removed key — so a managed-key set
// walks its elements exactly where it vacates a slot, while an int-key set (keyDrop 0) skips every walk
// untouched.

// The `Set` record is the shared prefix and stops at `keyDrop@40`: six 8-byte slots, 48 bytes. The OFFSETS
// are `HashTableRuntime`'s (a set's `elements@16` and a map's `keys@16` are one slot under two words); this
// SIZE is the set's own, and it is the number `SignatureIndex.genericInstanceBoxSize` asks this file for.
export let SetRecordBytes = 48 as ByteCount

// The runtime entry points. `__`-prefixed (`isCompilerInternalCallee` routes their calls past the
// user-function checks — no file declares them) but NOT `__mm_`-prefixed, so `isSetRuntimeCallee` carries the
// `usesSet` (and, with it, `usesHeap`) bit rather than `isRuntimeCallee`'s raw-heap one — they `__mm_alloc`/
// `__mm_free` inside their Std bodies.
export let SetCreateName = b"__set_create"
export let SetInsertName = b"__set_insert"
export let SetContainsName = b"__set_contains"
export let SetRemoveName = b"__set_remove"
export let SetCountName = b"__set_count"
export let SetDecrefName = b"__set_decref"

// `__set_from(arr, hashWitness, eqWitness) -> setPtr` — build a set from an array (P1.7b slice B), the
// `Set from [1,2,3]` construction. It BORROWS `arr` and `__set_insert`s each element, so like
// `insert`/`contains`/`remove` it dispatches the key's `hash`/`equals` through witnesses — hence a public
// (parser-reached) entry that `isSetWitnessCallee` threads.
export let SetFromName = b"__set_from"

// ⭐ **`__set_map(set, dest, transform, env)` — `s.map(f)` (interface-extensions).** The `Set` half of the one
// `map` shape: walk the table's OCCUPIED slots, apply the transform to each member and push what it answers
// into the caller-created result array (`ArrayRuntime.emitMappedElementPush` is the shared step, and
// `ArrMapName`'s header states why the parser creates the array).
//
// ⚠ **IT CARRIES NO WITNESSES, which is what keeps it off `isSetWitnessCallee`.** `insert`/`contains`/`remove`/
// `from` all HASH or COMPARE a key; this walk only reads slots the table has already placed, exactly as
// `__set_decref`'s teardown walk does.
//
// ⚠ **THE ITERATION ORDER IS THE TABLE'S SLOT ORDER, AND THAT IS UNSPECIFIED BY DESIGN.** `specs/
// interface-extensions.md:stdlib-map-on-set` says so outright ("order may vary but sum is same") and asserts a
// sum. A set is unordered; making `map` sort would invent an order the language does not promise.
export let SetMapName = b"__set_map"

// `__set_grow` is INTERNAL — called only by `__set_insert` when the load factor is crossed (and on the first
// insert, from capacity 0). It reuses the cached hashes, so it needs NO witnesses; kept out of the public
// name set so no parser path dispatches to it.
let SetGrowName = b"__set_grow"

// ⚠ **THE `Set` METHOD-NAME SPELLINGS ARE NOT HERE, AND NEITHER IS `setMethodMutatesReceiver`** (moved at
// the P1.8 Slice E review). All five of `create`/`insert`/`contains`/`remove`/`count` are names an
// `Array` or a `String` also spells, so a `Set*Method` block here was five constants over five spellings
// that were each already written once in `Parser.maxon` — the one-fact-written-twice shape, whose failure
// mode is a rename that reaches one dispatcher and not the other and compiles either way. They now live in
// that file's shared-spelling block, with the receiver-mutation rule beside its `Array` twin. What stays
// here is what is genuinely this runtime's: the `__set_*` entry-point names above.

// The `__set_` prefix identifying EVERY set runtime entry point — the one test `recordCallUsage` reads to set
// `usesSet` (and `usesHeap`).
let SetRuntimePrefix = b"__set_"

export function isSetRuntimeCallee(callee ByteArray) returns bool
	return bytesStartWith(callee, prefix: SetRuntimePrefix)
end 'isSetRuntimeCallee'

// Is `callee` a set runtime function that DISPATCHES THROUGH THE KEY'S WITNESSES — `insert`/`contains`/
// `remove`, the three that hash the key and compare it, plus `from`, which `__set_insert`s each array element.
// `create`/`count`/`decref`/`grow` touch no key value, so they carry no witnesses.
// `LowerMaxonToStd.lowerRuntimeCall` reads this to decide whether to append the two hidden witness-table
// addresses to a set runtime call.
export function isSetWitnessCallee(callee ByteArray) returns bool
	return callee.equals(SetInsertName) or callee.equals(SetContainsName) or callee.equals(SetRemoveName) or callee.equals(SetFromName)
end 'isSetWitnessCallee'

// ⭐ **THE RUNTIME CALLEES THAT PROBE A `Set with Character` THEY DO NOT HOLD (P1.8 Slice D).** A
// `CharacterSet` keeps its members in a `Set` FIELD, so `__cs_contains` and the trim above it need the
// key's `Hashable`/`Equatable` tables as ordinary arguments — but there is no set among their arguments to
// read a key type off. Their key is `Character` by construction (`SignatureIndex.characterSetLayout`), so
// they take the SAME threading through the SAME `appendSetWitnessArgs`, with the type named rather than
// derived. It lives here, beside its sibling, so "which callees carry witness tables?" is one question
// asked in one file.
export function isCharacterKeyedWitnessCallee(callee ByteArray) returns bool
	return callee.equals(CharSetContainsName) or callee.equals(StrTrimName)
end 'isCharacterKeyedWitnessCallee'

// Install the set runtime into the lowered Std module — ALL of it, when the program touches any set
// (`usesSet`). Golden-neutral: `__`-prefixed functions are excluded from the spec goldens
// (`isRuntimeFunction`), so an all-or-nothing install costs nothing in the fragments and needs no per-helper
// dependency tracking; the helpers call each other (`insert`→`grow`→`__mm_alloc`) so a dependency graph would
// only re-derive the closure this install already is. Appended AFTER the pipeline (like `installArrayRuntime`),
// so they are never re-optimized.
//
// ⭐ The seven shared entries come from `installHashTable`, told THIS container's names and shape — the one
// place a `Set`'s hash-table identity is stated. What is built after it is what this container does not
// share: `from` (the `Set from […]` construction, which has no map twin) and `map` (the element transform).
export function installSetRuntime(module StdModule, usage RuntimeUsage)
	if not usage.usesSet 'noSet'
		return
	end 'noSet'
	installHashTable(module, family: HashTableFamily.create(SetCreateName, growName: SetGrowName, insertName: SetInsertName, containsName: SetContainsName, removeName: SetRemoveName, countName: SetCountName, decrefName: SetDecrefName, recordBytes: SetRecordBytes, carriesValues: false))
	buildSetFrom(module)
	buildSetMap(module)
end 'installSetRuntime'

// `__set_from(arr, hashWitness, eqWitness) -> setPtr` — build a set from an array (P1.7b slice B), the
// `Set from [1,2,3]` / `Set from ["a","b"]` construction. BORROW `arr` (an `Array with <key>`, whose record
// carries `buffer@0` / `length@8` / `element_destroy@40`): create an empty set stamped with the array's own key
// destructor, then walk the array reading each element (one machine word) and `__set_insert` it — which grows
// (double + rehash) as the load factor is crossed and dedups a repeated element, so a 15-element literal grows
// exactly `grow.preserves-elements`. A managed (String) key is MOVED out of the array (the set becomes its
// owner), so each moved-out array slot is NULLED — the array stays the CALLER's owned temporary and its
// `__arr_decref` at statement end skips the nulled slots (no double-free); a trivial int element is copied
// inline (the null is harmless). The two witnesses are the key's `Hashable`/`Equatable` tables, threaded in by
// the caller (`appendSetWitnessArgs`) and passed to `__set_insert`.
function buildSetFrom(module StdModule)
	var func = IrFunction.createFromStd(SetFromName, returnType: StdReturnType.value(StdType.i64), paramCount: 3, paramTypes: threeI64Params(), returnLine: 0)
	var ids = ValueMinter.create(3)

	var entry = module.addBlock(func, label: b"entry")
	var header = module.addBlock(func, label: b"loop")
	var body = module.addBlock(func, label: b"body")
	var done = module.addBlock(func, label: b"done")

	emitParams(module, block: entry, count: 3)
	let arr = 0 as ValueId
	let hashWitness = 1 as ValueId
	let eqWitness = 2 as ValueId

	// entry: create the empty set — STAMPING the SET's key destructor from the SOURCE ARRAY's
	// `element_destroy@40`. The array and the set share a key/element type, so the array's stamped destructor
	// (`__str_decref` for a String element, 0 for a trivial int) IS the set's — which is why `__set_from` needs
	// no witness/parser threading for it. Then capture the array's element count and buffer, seed the walk at
	// index 0. `count`/`buffer` are loop-invariant (the borrowed array is neither grown nor moved here), so they
	// stay dominating values — the loop's live set is `{set, hashWitness, eqWitness, count, buffer, i}`, well
	// under the pool, so nothing spills.
	let elemDrop = emitLoadField(module, block: entry, record: arr, offset: ArrElementDestroyOffset, ids: ids)
	let set = ids.mint()
	module.appendOp(entry, op: StdOp.call(set, callee: SetCreateName, args: argsOf(elemDrop)))
	let count = emitLoadField(module, block: entry, record: arr, offset: ArrLengthOffset, ids: ids)
	let buffer = emitLoadField(module, block: entry, record: arr, offset: ArrBufferOffset, ids: ids)
	let scanStart = emitConst(module, block: entry, value: 0, ids: ids)
	module.setTerminator(entry, op: StdOp.branch(header.id))
	entry.branchEdges.push(BranchEdge.create(header.id, argIds: argsOf(scanStart)))

	// header(i): walk `[0, count)`.
	let i = ids.mint()
	header.blockArgs.push(IrBlockArg.create(i, argType: StdType.i64))
	let atEnd = emitCmp(module, block: header, a: i, b: count, pred: StdCmpPred.ge, ids: ids)
	module.setTerminator(header, op: StdOp.condBranch(atEnd, thenBlockId: done.id, elseBlockId: body.id))

	// body: read element `i` (one machine word — an int inline, or a managed KEY pointer, both one slot wide),
	// MOVE it into the set (`__set_insert` takes ownership of a managed key, or drops it as a dup), then NULL
	// the array slot so the array's own `__arr_decref` walk skips it — the array's decref drops only NON-null
	// slots, so a moved-out slot must read null or the key double-frees (the set owns it now). The exact mirror
	// of `__arr_pop` nulling the slot it hands out. A trivial int element is unaffected by the null (its array
	// decref never walks). Then advance `i = i + 1`.
	let elem = emitWordSlotLoad(module, block: body, base: buffer, index: i, ids: ids)
	let inserted = ids.mint()
	module.appendOp(body, op: StdOp.call(inserted, callee: SetInsertName, args: fourArgs(set, second: elem, third: hashWitness, fourth: eqWitness)))
	let nullSlot = emitConst(module, block: body, value: 0, ids: ids)
	emitWordSlotStore(module, block: body, base: buffer, index: i, value: nullSlot, ids: ids)
	let one = emitConst(module, block: body, value: 1, ids: ids)
	let iNext = emitBin(module, block: body, a: i, b: one, opcode: StdBinOpcode.add, ids: ids)
	module.setTerminator(body, op: StdOp.branch(header.id))
	body.branchEdges.push(BranchEdge.create(header.id, argIds: argsOf(iNext)))

	// done: return the populated set (the caller's owned value, dropped via `__set_decref` at scope exit).
	module.setTerminator(done, op: StdOp.ret(set))

	module.functions.push(func)
end 'buildSetFrom'

// `__set_map(set, dest, transform, env)` — see `SetMapName`. `set` is BORROWED (its members are read for the
// transform, never moved out and never nulled — the exact inverse of `__set_from`, which MOVES a managed key
// out of its source array); `dest` is the caller-created `Array with <key>` the results are pushed into.
function buildSetMap(module StdModule)
	var func = IrFunction.createFromStd(SetMapName, returnType: StdReturnType.void, paramCount: 4, paramTypes: fourI64Params(), returnLine: 0)
	var ids = ValueMinter.create(4)

	var entry = module.addBlock(func, label: b"entry")
	var work = module.addBlock(func, label: b"body")
	var step = module.addBlock(func, label: b"step")
	let done = module.addBlock(func, label: b"done")

	emitParams(module, block: entry, count: 4)
	let set = 0 as ValueId
	let dest = 1 as ValueId
	let transform = 2 as ValueId
	let env = 3 as ValueId

	let slot = emitHtOccupiedSlotWalk(module, func: func, cur: entry, table: set, work: work, step: step, done: done, ids: ids)
	let member = emitHtRecordSlotLoad(module, block: work, table: set, bufferOffset: HtKeysOffset, index: slot, ids: ids)
	emitMappedElementPush(module, block: work, transform: transform, env: env, elem: member, dest: dest, ids: ids)
	module.setTerminator(work, op: StdOp.branch(step.id))

	module.setTerminator(done, op: StdOp.retVoid)

	module.functions.push(func)
end 'buildSetMap'
