// BuiltinConformanceRuntime.maxon — the synthesized `int.hash`/`int.equals` (P1.7a slice 2b),
// `int.compare` (P1.7a slice 2b-ii) and `String.hash`/`String.equals` (P1.7b) impls that make the BUILTIN
// types `int` and `String` conform to `Hashable`/`Equatable`, and `int` additionally to `Comparable`.
//
// ⭐ **`int` and `String` conform NATIVELY, the type-side twin of the synthesized
// `Hashable`/`Equatable`/`Comparable` interfaces (`builtinInterface`).** shv2 reads no stdlib, so there is no
// user `int.hash` / `int.compare` / `String.equals` to point a witness slot at — these are hand-built Std
// bodies, exactly like `__str_eq` / the array runtime, installed after the pipeline so they are never
// re-optimized. They are NOT `__`-prefixed, so they carry a real `.text` symbol the witness-table reloc
// (`recordFuncAbs64InRdata`) can name — the SAME funcAbs64 reloc that stamps `__witness_<Struct>_Digest`, only
// here the target is synthesized rather than user-written. (`String` is a MANAGED concrete type, not a
// primitive — hence the neutral "builtin" spelling over the older "primitive".)
//
// ⭐ **INSTALL IS DRIVEN BY THE REFERENCE, NOT BY A SEPARATE SCAN.** The install asks the emitted program
// one question — *"does anything NAME this impl?"* — and builds the impl iff the answer is yes.
// **REFERENCED ⟺ INSTALLED**, with no second predicate to drift from the first.
//
// There are exactly TWO ways a program can name one, and the question covers both because both are read off
// what was actually emitted rather than off a parallel record of intent:
//
//   • **A WITNESS-TABLE SLOT.** A slot of `__witness_int_Hashable` / `__witness_String_Equatable` / … is
//     stamped with a `funcAbs64` reloc naming `int.hash` / `String.equals` / … iff the program dispatches
//     through it (`ensureWitnessTable`, during lowering). The reference is the RELOC.
//   • **A DIRECT DISPATCH.** `i.compare(j)` on a concrete value is an ordinary `call int.compare`
//     (`Parser.emitBuiltinConformanceCall`) and creates NO reloc at all — the witness table it would have
//     ridden is never built. The reference is the CALL.
//
// ⚠ The reloc half alone was the whole predicate until direct dispatch shipped, and *"no pending reloc ⇒
// return early"* then silently declined to install the very impl a direct call had just named — a link-time
// `resolveCallFixups: call to unknown function 'int.compare'`. The invariant that survives both is
// REFERENCED, not table-built; the shape it is asked in — one walk of the finished module — is what makes a
// third kind of reference impossible to forget, because a reference is by definition something the module
// spells.
//
// Golden-neutral for every program that names no impl (the conformance-free corpus and the whole wasm
// suite): the walk builds nothing, and `eliminateDeadFunctions` would prune an over-installed impl anyway.
//
// The SEMANTICS match the reference compilers' monomorphizing source (`stdlib/PrimitiveExtensions.maxon`,
// `stdlib/helpers/string/hash.maxon`): `int.hash() = self & 0xFFFFFFFF` (the low-32 mask — identity for a
// value that already fits u32); `int.equals(other) = self == other`; `int.compare(other)` = the
// `lessThan`/`greaterThan`/`equalTo` cascade; `String.hash() = djb2` over the bytes; `String.equals(other) =
// __str_eq`'s content compare. x64-only rides the witness reloc, which the arm64/wasm writers already refuse.

// The low-32-bit mask `int.hash`/`String.hash` fold their result through — `HashValue` is `int(0 to u32.max)`,
// so a hash is the low 32 bits. The one place the mask is spelled, shared by both hashers (it IS `HashValue`'s
// width, one fact).
let HashLow32Mask = 0xFFFFFFFF

// `int.equals` returns a materialized bool (0 or 1) — there is no `setcc` at this tier, so the two verdicts
// are two `const`-returning blocks off a fused `cmp`+`jcc`, exactly as `__str_eq` returns its length/byte
// verdicts. Named for the same reason `StrEqEqual`/`StrEqNotEqual` are.
let IntEqualsTrue = 1
let IntEqualsFalse = 0

// djb2 over `String`'s bytes: `h = Djb2Seed`, then `h = h * Djb2Multiplier + b` per byte. The two magic
// numbers of the algorithm, named rather than bare so the loop reads as djb2. `""` -> `5381`, `"abc"` ->
// `193485963`, `"hi"` -> `5863446`.
let Djb2Seed = 5381
let Djb2Multiplier = 33

// Install the synthesized builtin-type conformance impls when — and only when — a witness table references
// them (P1.7a slice 2b + P1.7b). Each impl NAME is `qualifiedMethodName(<conformer>, <method>)`, the SAME
// construction `ensureWitnessTable` names its reloc target by, so the built function, the reloc, and the
// dispatch cannot disagree on the symbol.
export function installBuiltinConformanceRuntime(module StdModule, globalData GlobalDataTable)
	let intHash = qualifiedMethodName(IntConformerName, methodName: HashMethodName)
	let intEquals = qualifiedMethodName(IntConformerName, methodName: EqualsMethodName)
	// `int.compare` (P1.7a slice 2b-ii). `String` has NO `Comparable` conformance (a byte record has no
	// ordering — `isIntrinsicBuiltinConformance`), so there is no `String.compare` twin to install.
	let intCompare = qualifiedMethodName(IntConformerName, methodName: CompareMethodName)
	let strHash = qualifiedMethodName(StringConformerName, methodName: HashMethodName)
	let strEquals = qualifiedMethodName(StringConformerName, methodName: EqualsMethodName)

	// ⭐ ASKED ONCE, BEFORE THE FIRST INSTALL — which is what makes the five answers independent of the
	// order they are acted on in. A scan run BETWEEN installs would see the ops of the impls this very
	// function had already appended; none of the five bodies calls another today, but that is a property of
	// their current shape rather than of the mechanism, and the single up-front call needs no such promise.
	let referenced = referencedBuiltinImpls(module, globalData: globalData, impls: builtinImplNames(intHash, intEquals: intEquals, intCompare: intCompare, strHash: strHash, strEquals: strEquals))

	if referenced.contains(intHash) 'intHash'
		buildIntHash(module, name: intHash)
	end 'intHash'

	if referenced.contains(intEquals) 'intEquals'
		buildIntEquals(module, name: intEquals)
	end 'intEquals'

	if referenced.contains(intCompare) 'intCompare'
		buildIntCompare(module, name: intCompare)
	end 'intCompare'

	if referenced.contains(strHash) 'strHash'
		buildStrHash(module, name: strHash)
	end 'strHash'

	// `String.equals` is `__str_eq`'s byte-compare emitted under the witness-visible symbol — ONE graph, two
	// names (`StringRuntime.buildStrEq`), so the operator path and the witness path cannot drift.
	if referenced.contains(strEquals) 'strEquals'
		buildStrEq(module, name: strEquals)
	end 'strEquals'
end 'installBuiltinConformanceRuntime'

// The five synthesized impl symbols, as the candidate list the reference walk matches against. Taken as
// parameters rather than re-minted here so the names the walk looks for and the names the builders are
// installed under are the SAME `ByteArray`s, not two joins that happen to agree.
function builtinImplNames(intHash ByteArray, intEquals ByteArray, intCompare ByteArray, strHash ByteArray, strEquals ByteArray) returns ByteArrayArray
	var impls = ByteArrayArray.create()
	impls.push(intHash)
	impls.push(intEquals)
	impls.push(intCompare)
	impls.push(strHash)
	impls.push(strEquals)
	return impls
end 'builtinImplNames'

// ⭐ **WHICH OF `impls` THIS PROGRAM NAMES BUT DOES NOT DEFINE** — the install's ONE question, answered for
// all five at once so the module is walked ONCE rather than once per impl. Both reference kinds are
// collected here (see the header): every pending `.rdata` funcAbs64 slot target, and every function name the
// emitted ops spell.
//
// ⚠ **"NAMES BUT DOES NOT DEFINE" — AND THE SECOND HALF IS NOT PEDANTRY, IT IS A MEASURED WRONG ANSWER.**
// A synthesized impl exists to SUPPLY a symbol nothing else provides; a symbol the module already defines
// needs none, and installing one anyway appends a SECOND function under that name, which the by-name link
// then resolves to whichever it likes. `int.*` cannot collide (`int` is a keyword, so no user method can
// wear that qualifier), but `String.*` can: a user `type String` with its own `hash()` mints exactly the
// symbol `String.hash`. MEASURED — crediting that call site made `String.create(7).hash()` return **5381**,
// djb2's seed read off the user's box, instead of `7`. So the candidates are narrowed to the UNDEFINED ones
// before a single reference is credited.
//
// ⚠ It walks the FLAT `module.ops` array, ORPHANS INCLUDED, and that is deliberate rather than a slip of
// the `liveOpIndices` rule. The rule exists for passes asking *"what is actually here?"*, where a dead op is
// a false positive that matters; this asks *"could the program reference this?"*, where the only cost of a
// false positive is an impl `eliminateDeadFunctions` then prunes — while `liveOpIndices` would allocate an
// ops-sized index array PER FUNCTION to answer it. Over-approximating is free here and under-approximating
// is a link failure, so the walk is deliberately the cheap, wide one.
function referencedBuiltinImpls(module StdModule, globalData GlobalDataTable, impls ByteArrayArray) returns FunctionNameSet
	var referenced = FunctionNameSet.create()

	let synthesizable = undefinedImplNames(module, impls: impls)
	if synthesizable.count() == 0 'nothingToSynthesize'
		return referenced
	end 'nothingToSynthesize'

	for reloc in globalData.pendingRdataRelocs 'eachRdataSlot'
		noteBuiltinImplReference(reloc.funcName, impls: synthesizable, referenced: referenced)
	end 'eachRdataSlot'

	for opIndex in 0 upto module.ops.count() 'eachOp'
		noteOpBuiltinImplReference(try module.ops.get(opIndex) otherwise panic("referencedBuiltinImpls: op index {opIndex} below count {module.ops.count()} is not in module.ops"), impls: synthesizable, referenced: referenced)
	end 'eachOp'

	return referenced
end 'referencedBuiltinImpls'

// The candidate impls no function in the module already defines — see `referencedBuiltinImpls`' second
// warning for the wrong answer this exists to prevent. `module.functions` is walked once, and the inner test
// is five byte compares that almost always fail on length.
function undefinedImplNames(module StdModule, impls ByteArrayArray) returns ByteArrayArray
	var undefined = ByteArrayArray.create()
	for impl in impls 'eachImpl'
		if not moduleDefinesFunction(module, funcName: impl) 'undefined'
			undefined.push(impl)
		end 'undefined'
	end 'eachImpl'
	return undefined
end 'undefinedImplNames'

function moduleDefinesFunction(module StdModule, funcName ByteArray) returns bool
	for i in 0 upto module.funcCount() 'eachFunc'
		if module.getFunc(i).name.equals(funcName) 'match'
			return true
		end 'match'
	end 'eachFunc'
	return false
end 'moduleDefinesFunction'

// The function NAME one `StdOp` spells, credited if it is one of the candidate impls. THREE variants carry
// one — `call`, `tryCall` and `funcAddr` — the same three `DeadFunctionElimination.markCalleeOf` walks for
// its reachability edges, and for the same reason: those are the ops that can make a symbol required.
//
// The arms RANGE over the whole union in declaration order, ending at the current last variant, so a variant
// appended past it FAILS TO COMPILE here rather than being silently swallowed — the band-append invariant
// working in the reviewer's favour (StdDialect's header). A new variant carrying a callee name must be added
// as its own arm.
function noteOpBuiltinImplReference(op StdOp, impls ByteArrayArray, referenced FunctionNameSet)
	match op 'op'
		// arith + control + the call band up to `call`: pure computation, branches, `ret`, `param`.
		const to param then break 'op'
		call(_, callee, _) then noteBuiltinImplReference(callee, impls: impls, referenced: referenced)
		// `retVoid` … `rdataAddr`: returns, `.data`/`.rdata` ADDRESSES (labels, not functions), loads,
		// stores, and the two OS primitives that name no Maxon function.
		retVoid to rdataAddr then break 'op'
		tryCall(_, _, callee, _) then noteBuiltinImplReference(callee, impls: impls, referenced: referenced)
		// `errorReturn` reads two local virtuals; `osExit` is an OS primitive.
		errorReturn to osExit then break 'op'
		funcAddr(_, funcName) then noteBuiltinImplReference(funcName, impls: impls, referenced: referenced)
		// `callIndirect`/`witnessCall` consume a code pointer some `funcAddr` or `.rdata` slot already
		// produced, so they name no symbol; nor do the appended `os*` primitives or `switch`.
		callIndirect to osWriteFile then break 'op'
		// The wall-clock read names no Maxon function either — its callee is a Win32 import slot.
		osReadWallClock then break 'op'
	end 'op'
end 'noteOpBuiltinImplReference'

// Credit `name` if it is one of the candidate impls. A linear scan of five, which is why the candidates are
// an array rather than a set: at five entries the compare is cheaper than a hash, and this runs per op.
function noteBuiltinImplReference(name ByteArray, impls ByteArrayArray, referenced FunctionNameSet)
	for impl in impls 'eachImpl'
		if name.equals(impl) 'match'
			referenced.insert(impl)
			return
		end 'match'
	end 'eachImpl'
end 'noteBuiltinImplReference'

// `int.hash(self) -> HashValue` — `self & 0xFFFFFFFF`, one `and` against the low-32 mask. The receiver is a
// by-value scalar i64 in arg-0 (the witness dispatch passes `self.item`, a scalar `T` field read, straight in
// — no pointer indirection), so the whole body is a mask and a return.
function buildIntHash(module StdModule, name ByteArray)
	var func = IrFunction.createFromStd(name, returnType: StdReturnType.value(StdType.i64), paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry")
	emitParams(module, block: entry, count: 1)
	let receiver = 0 as ValueId

	let mask = emitConst(module, block: entry, value: HashLow32Mask, ids: ids)
	let masked = emitBin(module, block: entry, a: receiver, b: mask, opcode: StdBinOpcode.bitAnd, ids: ids)
	module.setTerminator(entry, op: StdOp.ret(masked))

	module.functions.push(func)
end 'buildIntHash'

// `int.equals(self, other) -> bool` — `self == other`, materialized as 1/0 off a fused `cmp`+`jcc` (there is
// no `setcc` at this tier). The `__str_eq` verdict shape: a compare terminates the entry into a true block
// and a false block, each returning its constant. Both receivers are by-value scalar i64s in arg-0/arg-1.
function buildIntEquals(module StdModule, name ByteArray)
	var func = IrFunction.createFromStd(name, returnType: StdReturnType.value(StdType.i64), paramCount: 2, paramTypes: twoI64Params(), returnLine: 0)
	var ids = ValueMinter.create(2)

	var entry = module.addBlock(func, label: b"entry")
	var equalBlock = module.addBlock(func, label: b"equal")
	var notEqualBlock = module.addBlock(func, label: b"notEqual")

	emitParams(module, block: entry, count: 2)
	let receiver = 0 as ValueId
	let other = 1 as ValueId

	let isEqual = emitCmp(module, block: entry, a: receiver, b: other, pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(entry, op: StdOp.condBranch(isEqual, thenBlockId: equalBlock.id, elseBlockId: notEqualBlock.id))

	let trueResult = emitConst(module, block: equalBlock, value: IntEqualsTrue, ids: ids)
	module.setTerminator(equalBlock, op: StdOp.ret(trueResult))

	let falseResult = emitConst(module, block: notEqualBlock, value: IntEqualsFalse, ids: ids)
	module.setTerminator(notEqualBlock, op: StdOp.ret(falseResult))

	module.functions.push(func)
end 'buildIntEquals'

// `int.compare(self, other) -> Ordering` (P1.7a slice 2b-ii) — `lessThan` when `self < other`, `greaterThan`
// when `self > other`, `equalTo` otherwise. Both reference compilers state exactly that cascade
// (`stdlib/PrimitiveExtensions.maxon:11-19`), and its `<`/`>` are plain int compares, so there is no
// recursion back into `Comparable`. An `Ordering` value IS its i64 tag, so the shape is `buildIntEquals`'s
// verdict shape with a third exit: two fused `cmp`+`jcc` tests, each falling through to the next, and one
// `const`-returning block per case.
//
// ⭐ The three returned tags come from `orderingTagOf` — read OFF the `Ordering` layout, so reordering the
// transcription in `Project.builtinOrderingEnum` moves this body and the `<`/`>`/`<=`/`>=` lowering's tag tests
// together. The bootstrap writes them as literals at its consumer sites with nothing tying them back to the
// declaration; that is a latent coupling shv2 deliberately does not copy.
function buildIntCompare(module StdModule, name ByteArray)
	var func = IrFunction.createFromStd(name, returnType: StdReturnType.value(StdType.i64), paramCount: 2, paramTypes: twoI64Params(), returnLine: 0)
	var ids = ValueMinter.create(2)
	let ordering = builtinOrderingEnum()

	var entry = module.addBlock(func, label: b"entry")
	var lessBlock = module.addBlock(func, label: b"less")
	var notLessBlock = module.addBlock(func, label: b"notLess")
	var greaterBlock = module.addBlock(func, label: b"greater")
	var equalBlock = module.addBlock(func, label: b"equal")

	emitParams(module, block: entry, count: 2)
	let receiver = 0 as ValueId
	let other = 1 as ValueId

	let isLess = emitCmp(module, block: entry, a: receiver, b: other, pred: StdCmpPred.lt, ids: ids)
	module.setTerminator(entry, op: StdOp.condBranch(isLess, thenBlockId: lessBlock.id, elseBlockId: notLessBlock.id))

	let lessTag = emitConst(module, block: lessBlock, value: orderingTagOf(ordering, caseName: OrderingLessThanCaseName), ids: ids)
	module.setTerminator(lessBlock, op: StdOp.ret(lessTag))

	let isGreater = emitCmp(module, block: notLessBlock, a: receiver, b: other, pred: StdCmpPred.gt, ids: ids)
	module.setTerminator(notLessBlock, op: StdOp.condBranch(isGreater, thenBlockId: greaterBlock.id, elseBlockId: equalBlock.id))

	let greaterTag = emitConst(module, block: greaterBlock, value: orderingTagOf(ordering, caseName: OrderingGreaterThanCaseName), ids: ids)
	module.setTerminator(greaterBlock, op: StdOp.ret(greaterTag))

	let equalTag = emitConst(module, block: equalBlock, value: orderingTagOf(ordering, caseName: OrderingEqualToCaseName), ids: ids)
	module.setTerminator(equalBlock, op: StdOp.ret(equalTag))

	module.functions.push(func)
end 'buildIntCompare'

// `String.hash(self) -> HashValue` — djb2 over the String's bytes. `self` is a by-value String POINTER in
// arg-0 (the witness dispatch passes `self.item`, an opaque `T` field read, straight in — a `String` rides
// like a struct receiver). It BORROWS `self`: it reads `buffer@0`/`length@8` and walks the bytes, freeing
// nothing — so a hashed boxed String neither double-frees nor leaks (the container drops it once).
//
// `h = 5381`; for each byte `b`: `h = h * 33 + b`; return `h and 0xFFFFFFFF`. The mask is applied ONCE at the
// end: i64 multiply/add wrap mod 2^64, and `(x mod 2^64) mod 2^32 == x mod 2^32`, so masking only at the end
// yields the same low-32 djb2 as masking every iteration would — for a String of any length. The loop carries
// its index `i` and accumulator `h` as the header's two phis, the `buildStrEq` byte-loop shape with an
// accumulator added. Both phi `argType`s are set to i64 explicitly: `retypeBlockArgs` runs in
// `lowerMaxonToStd`, which these post-pipeline functions never pass through.
function buildStrHash(module StdModule, name ByteArray)
	var func = IrFunction.createFromStd(name, returnType: StdReturnType.value(StdType.i64), paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry")
	var header = module.addBlock(func, label: b"header")
	var body = module.addBlock(func, label: b"body")
	var done = module.addBlock(func, label: b"done")

	emitParams(module, block: entry, count: 1)
	let strPtr = 0 as ValueId

	// entry: load `buffer@0`/`length@8`, seed `h = 5381` / `i = 0`, and enter the loop.
	let buffer = emitLoadField(module, block: entry, record: strPtr, offset: StringBufferOffset, ids: ids)
	let length = emitLoadField(module, block: entry, record: strPtr, offset: StringLengthOffset, ids: ids)
	let hSeed = emitConst(module, block: entry, value: Djb2Seed, ids: ids)
	let iSeed = emitConst(module, block: entry, value: 0, ids: ids)

	// The loop's two carried phis, in the order `[i, h]` — the SAME order every incoming edge pushes below.
	let i = ids.mint()
	header.blockArgs.push(IrBlockArg.create(i, argType: StdType.i64))
	let h = ids.mint()
	header.blockArgs.push(IrBlockArg.create(h, argType: StdType.i64))
	module.setTerminator(entry, op: StdOp.branch(header.id))
	entry.branchEdges.push(BranchEdge.create(header.id, argIds: twoArgs(iSeed, second: hSeed)))

	// header: `i >= length` ⇒ every byte folded in ⇒ mask and return; else fold `buffer[i]`.
	let atEnd = emitCmp(module, block: header, a: i, b: length, pred: StdCmpPred.ge, ids: ids)
	module.setTerminator(header, op: StdOp.condBranch(atEnd, thenBlockId: done.id, elseBlockId: body.id))

	// body: `h = h * 33 + buffer[i]`; `i = i + 1`; back-edge. `i`/`h` are the header phis (header dominates
	// body), so they are read directly. The byte is a u8 load off `buffer + i`.
	let addr = emitBin(module, block: body, a: buffer, b: i, opcode: StdBinOpcode.add, ids: ids)
	let curByte = ids.mint()
	module.appendOp(body, op: StdOp.loadIndirect(curByte, addrId: addr, offset: 0, valueType: StdType.u8))
	let mult = emitConst(module, block: body, value: Djb2Multiplier, ids: ids)
	let hScaled = emitBin(module, block: body, a: h, b: mult, opcode: StdBinOpcode.mul, ids: ids)
	let hNext = emitBin(module, block: body, a: hScaled, b: curByte, opcode: StdBinOpcode.add, ids: ids)
	let one = emitConst(module, block: body, value: 1, ids: ids)
	let iNext = emitBin(module, block: body, a: i, b: one, opcode: StdBinOpcode.add, ids: ids)
	module.setTerminator(body, op: StdOp.branch(header.id))
	body.branchEdges.push(BranchEdge.create(header.id, argIds: twoArgs(iNext, second: hNext)))

	// done: mask the accumulator to the low 32 bits (`h` is the header phi, and header dominates done).
	let mask = emitConst(module, block: done, value: HashLow32Mask, ids: ids)
	let masked = emitBin(module, block: done, a: h, b: mask, opcode: StdBinOpcode.bitAnd, ids: ids)
	module.setTerminator(done, op: StdOp.ret(masked))

	module.functions.push(func)
end 'buildStrHash'
