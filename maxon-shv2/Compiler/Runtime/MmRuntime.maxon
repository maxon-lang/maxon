// Runtime/MmRuntime.maxon — the emitted memory-management runtime (Workstream R, slice R1).
//
// ⭐ THIS IS A BUILDER-BUILT `StdModule`, NOT HAND-ASSEMBLED BYTES, and that was a decision taken
// on purpose rather than by inertia (PLAN.md's R1 box exists to force exactly this). The panic
// runtime (P1.0d.3) IS hand-assembled, and that was right for it: the OS calls a VEH thunk with a
// raw ABI, so there is no Maxon-level spelling of "read CONTEXT.Rip". The allocator is not such a
// case — it needs only ordinary calls, arithmetic, loads and stores. Building it as `StdOp`s means
// it gets register allocation, the frame layout, and target-independence for FREE, and every later
// slice of the runtime is IR rather than opcodes. v1 made the same call for the same reason: its
// `runtime.std` is 6,049 lines of Std-level IR text and it hand-emits only the VEH thunk.
//
// The divergence from v1 is the ROUTE, not the form: v1 PARSES its IR from a text file (a 992-line
// `StdParser.maxon`), shv2 builds the graph directly with builder calls. shv2 needs no parser
// because it has no text — the two are the same `IrFunction`/`StdOp` graph, and the text was only
// ever v1's serialization of it. `mrt_start` (`BackendDispatch.prependEntryStub`) already proves
// the builder path end-to-end at the Target tier; this is the same idea one tier up.
//
// WHAT IS DELIBERATELY NOT HERE — this is a bump allocator for a program that allocates one
// `Point`, not a Go-scale one. No size classes, no mcache/mcentral sharding, no remote-free
// queues, and no free list at all. v1 is DEBUGGED, NOT FAST: a copy needs a reason exactly as much
// as a divergence does, and none of that machinery has a consumer at this rung. `__mm_free`
// therefore reclaims nothing yet — it decrements the live count and stops. That is honest rather
// than incomplete: the counter is what the leak gate reads, and recycling is P1.2's work, arriving
// with the free list that makes it meaningful.
//
// ⚠ NO `__slab_alloc_raw`. It is Go's `needzero=false` escape hatch and it has NO CONSUMER here.
// Shipping vocabulary before its consumer is this rung's own founding lesson — it is why P1.0r and
// P1.1a co-land at all — so the hatch arrives with `realloc`, the caller that justifies it.
//
// ⭐ **AND THE FILE OWNS BOTH HALVES OF A MANAGED VALUE'S LIFECYCLE: the per-type DESTRUCTOR cascade
// (`__destruct_<T>`) and, since ARR6, its DEEP-CLONE dual (`__clone_<T>`).** The two walk the same field
// graph in opposite directions, close over the same `CascadeWorklist`, and `noteRelocatedFunctionUsage`
// re-enters both — so a change to what "a managed field" means is one file, not two. The clone half lived
// in the array runtime only because a managed-element array copy was the first thing that needed one.

// The header sits IMMEDIATELY BEFORE the user pointer, so a managed pointer is usable as a plain
// pointer: `p.x` is `[p+0]`, and nothing downstream needs to know a header exists. This is v1's
// layout exactly (`[-24] destructor · [-16] size · [-8] refcount`), expressed from the header BASE
// because `ByteOffset` is `int(0 to u64.max)` — UNSIGNED — so a negative displacement is not
// representable in a `loadIndirect`. The header is addressed as `ptr - HeaderBytes` once and read
// at positive offsets from there, which costs one `sub` per header access and keeps the offset
// type honest. (Making `ByteOffset` signed was the alternative and is wrong: it is shared with the
// PE writer, where a file offset genuinely cannot be negative.)
//
// ⚠ NOT the bootstrap's 32-byte header. Its extra word is `packedId`, which serves MM-TRACE — and
// mm-trace does not exist in shv2. A copy needs a reason; "the bootstrap has it" is not one, and
// the word would be 8 bytes of nothing on every allocation in the language.
let HeaderDestructorOffset = 0 as ByteOffset
let HeaderSizeOffset = 8 as ByteOffset

// ⭐ **THE HEADER GEOMETRY IS PRIVATE TO THIS FILE, AND STAYS THAT WAY.** Every reader outside it —
// `StringRuntime.__str_decref`, `ManagedMemoryRuntime.__managed_cow_detach`, the struct/union/instance destructor
// cascades — reaches the refcount through the exported BUILDERS below (`emitRefcountCheckToLastOwner`,
// `emitIsSharedAllocation`), never by respelling `ptr - HeaderBytes + HeaderRefcountOffset`. That is what
// makes "where the refcount lives" one fact rather than one per caller: a header that grew a field would
// be a change to `emitHeaderBase` and nothing else, and a caller that got it wrong could not compile.
let HeaderRefcountOffset = 16 as ByteOffset
let HeaderBytes = 24

// ⭐⭐ **THE `--debugstream` PREFIX WORD — `(alloc_id << 16 | tag_index)`, AND IT SITS *BELOW* THE HEADER
// ON PURPOSE (Workstream O3).** `mm_incref`/`mm_decref`/`mm_free` know only a POINTER, so the id and the
// type tag an mm-trace event needs must live in the box; `__mm_alloc` is the one place that knows both.
//
// ⚠ **PUTTING IT BELOW THE THREE EXISTING FIELDS RATHER THAN AMONG THEM IS THE WHOLE OF WHY THIS IS A
// SMALL CHANGE.** `ptr - HeaderBytes` still addresses `destructor`/`size`/`refcount` at exactly the
// offsets they have always had, so `emitHeaderBase` and every reader that goes through it — including
// `StringRuntime` and `ManagedMemoryRuntime`, which reach the refcount through this file's exported
// builders — are untouched. Only `__mm_alloc` (which computes the total and the payload offset) and
// `emitPackedIdAddr` below know the word exists.
//
// ⚠⚠ **IT IS PRESENT ONLY UNDER `--debugstream`.** A normal build's box is 24 bytes of header exactly as
// before, which is half of the compile-time gating rule (`DebugStreamRuntime`'s header states the other
// half): 8 bytes on EVERY allocation in the language is not a price a debug instrument may charge a
// program that is not being traced.
let DebugStreamPackedIdBytes = 8

// The bytes `__mm_alloc` prepends to the payload — the header, plus the DebugStream word when this build
// carries one. ONE derivation, read by the allocation itself and by `emitPackedIdAddr`, so the two cannot
// disagree about where the payload starts.
function boxPrefixBytes(debugStream bool) returns ParsedInt
	// ⚠ THE PARENTHESES ARE LOAD-BEARING. `a + b if c else d` binds as `a + (b if c else d)`, so the
	// unparenthesized form returned `HeaderBytes + HeaderBytes` on an UNTRACED build — a 48-byte prefix
	// where every box has always had 24. It compiled, it linked, and it was found only by the
	// byte-identical check against a control build.
	return (HeaderBytes + DebugStreamPackedIdBytes) if debugStream else HeaderBytes
end 'boxPrefixBytes'

// The arena a single `osAllocPages` request commits. 64 KiB is Windows' allocation granularity, so
// a smaller request would round up to it anyway and simply waste the difference.
let ArenaBytes = 0x10000

// The `.data` slots the runtime owns. All three are `__`-prefixed, which is what keeps them out of
// the spec goldens (`TargetPrinter.isRuntimeFunction`'s twin for data) and what guarantees no user
// name can collide — Maxon reserves `__` for compiler-internal names.
//
// ⭐ THEIR ZERO INITIALIZER IS THE ALLOCATOR'S INITIAL STATE, not merely a default. `cursor == 0`
// and `end == 0` mean "no arena yet", and the very first `__slab_alloc` computes `0 + size > 0` and
// takes the grow path. That is why there is no `__slab_init` and nothing to call before `main`: the
// `.data` image IS the initialization, so the state cannot be observed before it is established.
//
// ⚠ **NONE OF THE THREE IS `export`ED ANY MORE (W49 wave 9).** An orphan sweep over this file found no
// cross-file reader for any of them, nor for `buildMmIncref`/`buildMmRetain` below — five `export`s that
// had outlived their last cross-file caller. Nothing in this language reports that, which is why it takes
// a sweep to find and why `StringRuntime`'s `buildStrSplit` grave records the same lesson: *"an `export`
// outlives its last cross-file caller silently … so a retirement has to go looking for them by name"*.
// These slots are the allocator's private state and reading them from another file was never intended.
let SlabCursorLabel = b"__slab_cursor"
let SlabEndLabel = b"__slab_end"
let MmAllocCountLabel = b"__mm_alloc_count"

export let SlabAllocName = b"__slab_alloc"
export let MmIncrefName = b"__mm_incref"
export let MmRetainName = b"__mm_retain"
export let MmAllocName = b"__mm_alloc"
export let MmDecrefName = b"__mm_decref"
export let MmFreeName = b"__mm_free"
export let MmLeakCheckName = b"__mm_leak_check"

// ⭐ **THE COPY-ON-WRITE DETACH, SHARED BY THE STRING AND ARRAY RECORDS** — `__managed_cow_detach` and
// `__managed_append` both reach it rather than each spelling the detach itself. Its NAME lives here, with the
// other `__mm_*` names, because this is the one list of them and `isRuntimeCallee`'s prefix rule is stated
// three lines below; its BODY is built in `BufferOwnership`, which owns the record layout it reads and the
// ownership encoding it republishes. See `buildMmCowDetach` for why it is an `__mm_` operation at all.
export let MmCowDetachName = b"__mm_cow_detach"

// ⭐ **THE NAME OF A MANAGED-PAYLOAD UNION'S SYNTHESIZED DESTRUCTOR — `__destruct_<UnionName>`** (P1.3
// slice 2). It is `__`-prefixed, so `isCompilerInternalCallee` routes its call past the user-function
// checks — no file declares it. ONE speller, so the DROP site (`Parser.decrefCalleeFor`), the USAGE scan
// (`recordCallUsage`) and the SYNTHESIS (`installUnionDestructors`) name it identically and cannot drift.
export let DestructorPrefix = b"__destruct_"

export function destructorSymbol(unionName ByteArray) returns ByteArray
	return "{String.from(DestructorPrefix)}{String.from(unionName)}".toByteArray()
end 'destructorSymbol'

// ⭐ **THE NAME OF A CONCRETE TYPE'S SYNTHESIZED DEEP-CLONER — `__clone_<TypeName>`** (P1.7 slice 3b-vi-b), the
// `(box) -> newBox` DUAL of `__destruct_<TypeName>`. `__`-prefixed, so `isCompilerInternalCallee` routes its
// call/`funcAddr` past the user-function checks and no file declares it. ONE speller, so the STAMP site
// (`Parser.arrayElementCloneValue` / the struct/union field cascade), the USAGE scan (`recordCallUsage`) and
// the SYNTHESIS (`installStructCloners`/`installUnionCloners`) name it identically and cannot drift — exactly as
// `DestructorPrefix`/`destructorSymbol` pair for the drop family.
export let ClonerPrefix = b"__clone_"

export function clonerSymbol(typeName ByteArray) returns ByteArray
	return "{String.from(ClonerPrefix)}{String.from(typeName)}".toByteArray()
end 'clonerSymbol'

// The prefix every HEAP runtime entry point shares — the single test for "does this program touch the
// heap at all?", which `StringRuntime.scanRuntimeUsage` reads for its `usesHeap` bit.
let RuntimeCallPrefix = b"__mm_"

// ⭐ **IS THIS CALLEE A HEAP-RUNTIME ENTRY POINT?** The `__mm_`-only test that decides whether the
// program carries the ALLOCATOR + the leak check. It is DELIBERATELY narrower than
// `isCompilerInternalCallee` (below): a call to any `__mm_*` entry point implies the whole heap
// runtime (`__mm_alloc` calls `__slab_alloc`, `__mm_decref` calls `__mm_free`, the leak check reads
// the counter the others maintain), while a `__print_string`/`__str_eq` call implies NEITHER — a
// print-only program must not drag in the heap floor or the leak gate.
//
// A runtime entry point is DECLARED BY NOTHING — built at the Std tier after lowering — so the `__`
// prefix is what makes deciding it by NAME safe: Maxon reserves `__` for compiler-internal names, so
// no user function can collide. It is the same reservation `TargetPrinter.isRuntimeFunction` keeps the
// runtime out of the spec goldens by.
export function isRuntimeCallee(callee ByteArray) returns bool
	return bytesStartWith(callee, prefix: RuntimeCallPrefix)
end 'isRuntimeCallee'

// The prefix Maxon reserves for compiler-internal names — every runtime entry point the compiler
// EMITS (`__mm_alloc`, `__print_string`, `__str_eq`, …) starts with it. The bootstrap enforces the
// reservation at parse time (`E2051 ParserReservedIdentifier` — "declarations starting with '__' are
// reserved for compiler internals"), so no user name can collide there.
//
// ⭐ **THE RESERVATION IS ENFORCED AT BOTH ENDS, AND IT TAKES BOTH** (OPEN.md #35, CLOSED; completed by
// P1.0b step 2). Two separate rules bound what a `__` callee can be:
//
//   1. **No `__` name may be DECLARED, outside the ONE module that declares the reserved space** —
//      E2051, `Parser.requireUnreservedName`, at all eight binding sites, pinned by
//      `reserved-double-underscore.md`. This closed a SILENT MISCOMPILE: before it, a user could declare
//      and call a `__`-prefixed function (measured — `__add(7)` against a two-parameter `__add` compiled
//      and ran with the second argument uninitialised, exit 65543, where the bootstrap rejects the
//      declaration outright), because this predicate routed that call past `validateCall`'s arity/label
//      checks.
//   2. **No `__` name may be CALLED from source unless it names a recognized intrinsic — or the module
//      that declares the reserved space is calling a name it declares (D6/A1r)** — E3004,
//      `Parser.requireCalleeIsNotReservedName`, at the two source call doors (`emitCall`,
//      `emitAsyncCall`), pinned by `builtins-clock.md` and `reserved-double-underscore.md`.
//
// ⚠ **RULE 1 ALONE IS NOT ENOUGH, AND THIS PREDICATE SPENT A LONG TIME BELIEVING IT WAS.** A callee need
// not be DECLARED anywhere to be WRITTEN — `__whatever()` names nothing, so E2051 never fires, and the
// early return in `SemanticCheck.validateCall` then waved it past every unknown-callee check. It reached
// the linker, or lowering, and PANICKED with neither a file nor a line (three measured shapes:
// `resolveCallFixups: call to unknown function`, `lowerAsyncCall: … has no signature`,
// `valueTagToStdType: an 'unresolved' tag reached lowering`). Rule 2 is what bounds the family.
//
// ⚠⚠ **WHAT THE TWO RULES DO *NOT* GIVE IS "A `__` CALLEE IS COMPILER-OWNED" — rule 1's own exemption is
// why**, and reading them as if they did is what `isSignaturelessCompilerCallee` exists to stop. Since D6
// there is a `__` name with a DECLARATION behind it, and since A1r there is a call to one; such a call is
// an ordinary user function call that happens to wear the prefix. "Compiler-owned" is therefore the
// REGISTRY's answer, not the name's — see below.
let CompilerInternalPrefix = b"__"

// ⭐ **DOES THIS CALLEE WEAR THE COMPILER'S PREFIX?** The GENERAL predicate — a superset of
// `isRuntimeCallee`. It answers about the NAME's SHAPE and nothing else, which since D6/A1r is strictly less
// than "is this callee the compiler's own": for that, ask `isSignaturelessCompilerCallee` below.
//
// ⚠ **ITS THREE REMAINING DIRECT READERS ALL WANT THE SHAPE, and two of them because "declared" is already
// ruled out where they stand.** `Parser.requireCalleeIsNotReservedName` needs the raw shape as its GATE (the
// declaration exemption is its second clause, so the shape and the exemption cannot be one test);
// `Parser.requireThrowingNamedTryTarget`'s builtin arm sits BEHIND `declaresCallee`, so a name reaching it is
// undeclared by construction; and `StdLoweringShared.requireRuntimeChunkCallee` sits behind "no Std function
// in the merged module", which a declared-and-referenced function cannot be. Every other reader wants the
// registry's answer, and asks for it by name — see below.
//
// It is DISTINCT FROM `isRuntimeCallee` (which stays `__mm_`-only) because the two answer different
// questions. `isRuntimeCallee` decides whether the program carries the HEAP RUNTIME + leak check — a
// print-only or string-`==`-only program must NOT, so that decision cannot widen to every `__` name.
// This one decides only "skip the user-function checks", which is true of `__print_string`/`__str_eq`
// just as much as of `__mm_alloc`.
//
// ⭐⭐ **"COMPILER-OWNED" IS NOT THE SAME FACT AS "`__`-PREFIXED", AND THE SECOND CLAUSE IS WHERE THEY PART.**
// The synthesized builtin-conformance impls (`int.compare` and its siblings — the roster is
// `isIntrinsicBuiltinConformance`'s, not restated here, because a copy of it at a READER is exactly what
// went stale twice) are as compiler-owned as `__str_eq` — no file declares them, and they are
// built at the Std tier after the pipeline — but they deliberately wear NO prefix, because a witness-table
// reloc has to name a real `.text` symbol (`BuiltinConformanceRuntime`'s header). The prefix test was
// therefore ALREADY wrong about them; it simply never mattered while nothing called one by NAME. Direct
// dispatch (`i.compare(j)`) does, and the first reader to notice reported **E3004 "call to undefined
// function 'int.compare'"** against a call the user never wrote — the exact failure this predicate exists to
// prevent for `__mm_alloc`.
//
// ⚠ The second clause covers exactly the qualifiers a direct dispatch can be emitted under — `int.`,
// `float.`, `bool.` and, since BATCH2 slice 2, `String.` — and that bound is load-bearing rather than
// conservative. See `isBuiltinConformanceImplName` for the two DIFFERENT things that make it sound: the
// three primitives are keywords, while `String.` rests on the name being reserved from user declarations
// (`TypeResolution.isCompilerOwnedTypeName`). It is allocation-free (`isQualifiedUnderTypeName`), because
// this sits on the per-call path of `validateCall` and `lowerCall`.
export function isCompilerInternalCallee(callee ByteArray) returns bool
	return not (reservedCalleeReasonOf(callee) == ReservedCalleeReason.notReserved)
end 'isCompilerInternalCallee'

// ⭐⭐ **WHY A CALLEE IS THE COMPILER'S OWN — the two clauses above, told apart rather than summed (W55).**
// The predicate answers *whether*; a REFUSAL has to say *why*, and deriving the two separately is how the
// gate and its sentence came to disagree: `Parser.requireCalleeIsNotReservedName` refused on the OR and then
// explained every refusal with the FIRST clause's reason, so a synthesized impl named directly reported
// **`E3004 call to undefined function 'String.compare': the '__' prefix names a compiler intrinsic`** about
// a name carrying no `__` at all. One classifier, asked once, removes the second derivation rather than
// keeping it in step.
//
// ⚠ **THE TWO CLAUSES ARE DISJOINT AND THE ORDER IS THEREFORE NOT A PRECEDENCE.** A synthesized impl is
// `<conformer>.<method>` over `int`/`float`/`bool`/`String`, none of which can wear the reserved prefix
// (three are keywords; `String` is refused to any declaration by `TypeResolution.isCompilerOwnedTypeName`),
// so no callee answers both and neither clause can mask the other.
export enum ReservedCalleeReason
	// An ordinary callee: the name is the program's to declare, and this gate has nothing to say about it.
	notReserved
	// `__`-prefixed. E2051 forbids DECLARING one, so no signature can ever arrive for it.
	compilerInternalPrefix
	// A builtin-conformance impl the compiler synthesizes (`int.compare`, `String.hash`). It wears no prefix
	// — a witness-table reloc needs a real `.text` symbol — and no file declares it, so it is compiler-owned
	// for a reason the name's SHAPE cannot show.
	synthesizedConformanceImpl
end 'ReservedCalleeReason'

export function reservedCalleeReasonOf(callee ByteArray) returns ReservedCalleeReason
	if bytesStartWith(callee, prefix: CompilerInternalPrefix) 'wearsTheReservedPrefix'
		return ReservedCalleeReason.compilerInternalPrefix
	end 'wearsTheReservedPrefix'

	if isBuiltinConformanceImplName(callee) 'aSynthesizedImpl'
		return ReservedCalleeReason.synthesizedConformanceImpl
	end 'aSynthesizedImpl'

	return ReservedCalleeReason.notReserved
end 'reservedCalleeReasonOf'

// ⭐⭐ **DOES THIS CALLEE HAVE NO DECLARED SIGNATURE FOR THE USER-FUNCTION CHECKS TO READ?** Equivalently:
// **is it a name the COMPILER EMITTED**, since a compiler-emitted symbol is built at the Std tier, long after
// the merge that fills `funcSignatures`, and so can never be in it. Both readings are one predicate on
// purpose — they were two spellings of one fact, and a project whose signature bug is ONE FACT WRITTEN TWICE
// does not get to keep them apart.
//
// **The readers, and which reading each takes:**
//
//   • *"nothing to check against"* — `SemanticCheck.validateCall` and `validatePlainCall` (no E3004, no
//     arity/label/type checks), `SemanticCheck.directCallArgEscapes` (the closure-escape slot `validateCall`
//     returns before), `LowerMaxonToStd.lowerCall` / `lowerTryCall` (no signature slotting — the compiler
//     wrote its arguments positionally).
//   • *"the compiler emitted it"* — `LowerMaxonToStd.lowerFunctionRef` and `FnRefThunk.noteFnRefTarget` (a
//     bare `.text` address for a drop-walk `callIndirect(ptr)`, versus the uniform-ABI `__fnref_` thunk a
//     USER function value needs), and `StringRuntime.recordFunctionRefUsage` (does this reference install a
//     runtime floor?). ⚠ **THESE THREE WERE LEFT ON THE PREFIX BY A1r AND ONE OF THEM WAS REACHABLY WRONG** —
//     see `lowerFunctionRef` for the `wasm trap: indirect call type mismatch` it measured.
//
// ⚠ **THEY USED TO ASK IT BY PREFIX, AND D6/A1r BROKE THAT PROXY.** "`__`-prefixed" stood in for "no file
// declares it" only while NO file could declare such a name. D6 exempted `stdlib/Builtins.maxon` at the
// declaration door (`Parser.requireUnreservedName`) and A1r exempted it at the two CALL doors, so a
// `__int_fromString` written in that module is now a call to a REGISTERED function — with parameter names,
// declared types and a `throws` clause every ordinary call is checked against.
//
// ⚠⚠ Left keyed on the prefix it waves that call past all of them, and **BOTH HALVES ARE MEASURED, on the
// flag-only door, against `stdlib/Builtins.maxon` itself**: `__int_fromString()` with its one argument
// OMITTED drew NO DIAGNOSTIC AT ALL (the whole file passed every check, and the only complaint left was
// `E3001: No 'main' function found`), and neither did a BARE `__int_fromString(input)` — a throwing call
// with no `try`, whose error flag nothing would then have read. Both now report (E3036, E3057). That
// silent-acceptance is the same shape the reservation was introduced to close
// (`CompilerInternalPrefix`'s rule 1, `__add(7)`, exit 65543), which is why the fact this predicate states
// is the REGISTRY's answer and not the name's.
//
// A compiler-EMITTED callee is still in no registry (`__mm_alloc`, `__print_string`, `int.compare` are built
// at the Std tier, long after the merge that fills `funcSignatures`), so its answer is unchanged. The
// registry probe runs ONLY for a `__`/builtin-conformance name, behind the allocation-free prefix test.
export function isSignaturelessCompilerCallee(callee ByteArray, funcSignatures FuncSignatureMap) returns bool
	return isCompilerInternalCallee(callee) and not funcSignatures.contains(callee)
end 'isSignaturelessCompilerCallee'

// The runtime's `.data` slots, appended to the user's declared globals before `layOut` orders them.
// They are ordinary slots in every respect — `layOut` sorts and offsets them exactly as it does a
// user's `var`, and the image writer renders them the same way. Nothing here is special-cased.
export function runtimeGlobals() returns DataSectionEntryArray
	var out = DataSectionEntryArray.create()
	out.push(DataSectionEntry.create(String.from(SlabCursorLabel), valueType: StdType.i64, value: 0))
	out.push(DataSectionEntry.create(String.from(SlabEndLabel), valueType: StdType.i64, value: 0))
	out.push(DataSectionEntry.create(String.from(MmAllocCountLabel), valueType: StdType.i64, value: 0))
	return out
end 'runtimeGlobals'

// A per-function dense ValueId minter. The parser mints ids the same way and for the same reason
// (ARCHITECTURE → "Value numbering is born here"): a ValueId IS a dense function-local index, so
// every column the backend sizes by `blockArgIdBound` pays for the highest id minted. Parameters
// occupy `0..paramCount-1` by construction — the Std `param` op's contract — so the counter starts
// there rather than at zero.
export type ValueMinter
	var next as ValueId

	export static function create(paramCount ParamCount) returns ValueMinter
		return Self{next: paramCount}
	end 'create'

	export function mint() returns ValueId
		let id = self.next
		self.next = self.next + 1
		return id
	end 'mint'
end 'ValueMinter'

// Install the runtime into the lowered Std module. Called only when `moduleUsesHeap` held.
//
// The functions are APPENDED, not prepended: only `mrt_start` must lay out first (its `.text`
// offset is the PE entry point), and that is `augmentWithRuntime`'s job at the Target tier. Order
// among the rest is free.
//
// ⚠ `__mm_incref` IS CONDITIONAL, not in the unconditional list. Every function above has a caller in
// every heap-using program (a drop calls `__mm_decref`, which calls `__mm_free`; the exit path calls the
// leak check), so installing them together costs nothing dead. `__mm_incref` does NOT: a heap program
// that never takes a SECOND owner never references it, and it would be 31 unreachable bytes there. It now
// has TWO consumers — the managed-memory runtime's zero-copy view (`usesManagedMemory`) and the parser's `try … otherwise`
// phi reconciliation (`usesIncref`, a `call __mm_incref` `scanRuntimeUsage` sees directly) — so it is
// built here, under either bit, rather than by `installManagedMemoryRuntime` alone: the parser can emit it in a
// program that touches no array. Same "vocabulary ships with its consumer" rule, one home now that the
// consumers are two files apart.
//
// ⚠ `__mm_retain` IS CONDITIONAL for the same reason, under its OWN bit. Its one consumer is the parser
// co-owning a borrowed managed-aggregate parameter into a `var` (`var q = p`, OPEN #40) — a `call
// __mm_retain` `scanRuntimeUsage` sees directly (`usesRetain`). It is NOT folded under `usesIncref`
// despite both being increfs: the two functions have independent callers (an array/`try` program
// references `__mm_incref` but never `__mm_retain`, and vice versa), so folding either bit into the
// other would install an unreachable copy of the unused one in the program that references only the other.
export function installMmRuntime(module StdModule, usage RuntimeUsage)
	buildSlabAlloc(module)
	buildMmAlloc(module)
	buildMmDecref(module)
	buildMmFree(module)
	buildMmLeakCheck(module, usage: usage)
	if usage.usesIncref or usage.usesManagedMemory 'incref'
		buildMmIncref(module)
	end 'incref'
	if usage.usesRetain 'retain'
		buildMmRetain(module)
	end 'retain'

	// ⚠ `__mm_cow_detach` IS CONDITIONAL under its ONE remaining caller's bit — `__managed_cow_detach`, under
	// `usesManagedMemory` — so that a program reaching no array does not carry it dead. It is still built HERE
	// rather than by the managed-memory runtime: installing it twice would emit two copies of one function, and the
	// home is what makes a SECOND caller one `or` rather than a second installation.
	//
	// ⚠ **IT WAS `usesManagedMemory or usesStrAppend` UNTIL W49 WAVE 8, AND THE TERM WENT ONLY BECAUSE THE PRODUCER
	// DID.** `__str_append` retired whole with `String.append`; the corpus reaches this detach through
	// `__managed_append` -> `__managed_reserve` -> `__managed_grow`, which is under `usesManagedMemory` already. Shedding a term
	// whose producer still existed would leave a call unresolved in exactly the program that uses only that
	// side, which is the failure this `or` was built to prevent.
	if usage.usesManagedMemory 'cowDetach'
		buildMmCowDetach(module)
	end 'cowDetach'
end 'installMmRuntime'

// One i64 parameter — the shape five of the six runtime functions share. Exported: the String
// runtime's `__print_string` (one string pointer) shares it, so it is the same helper rather than a
// second copy.
export function oneI64Param() returns StdTypeArray
	var types = StdTypeArray.create()
	types.push(StdType.i64)
	return types
end 'oneI64Param'

// Two i64 parameters — `__mm_alloc(size, destructor)` and the String runtime's `__str_eq(a, b)`.
export function twoI64Params() returns StdTypeArray
	var types = StdTypeArray.create()
	types.push(StdType.i64)
	types.push(StdType.i64)
	return types
end 'twoI64Params'

// One f64 parameter — the synthesized `float.hash(self)` (P1.7a's last slice). The f64 sibling of
// `oneI64Param`, and it exists for `twoF64Params`' reason: the DECLARED f64 is what makes the ABI
// agree at both ends, `calleeParamClass` routing the argument into an XMM register and `lowerParam`
// capturing it from one.
export function oneF64Param() returns StdTypeArray
	var types = StdTypeArray.create()
	types.push(StdType.f64)
	return types
end 'oneF64Param'

// Two f64 parameters — the synthesized `float.equals(self, other)` / `float.compare(self, other)`
// (P1.7a slice 2b-iii). It joins the i64 family here rather than beside its caller for that family's
// reason, and the DECLARED f64 is what makes the ABI agree at both ends: `calleeParamClass` reads these
// types to route each ARGUMENT into an XMM register, and `lowerParam` reads them to capture it from one.
export function twoF64Params() returns StdTypeArray
	var types = StdTypeArray.create()
	types.push(StdType.f64)
	types.push(StdType.f64)
	return types
end 'twoF64Params'

// Three i64 parameters — `__str_copy(dest, src, len)` and the managed-memory runtime's `__managed_set(arr, index,
// value)` / `__managed_mem_set(mem, index, value)`. Shared here so a runtime builder does not mint its own.
export function threeI64Params() returns StdTypeArray
	var types = StdTypeArray.create()
	types.push(StdType.i64)
	types.push(StdType.i64)
	types.push(StdType.i64)
	return types
end 'threeI64Params'

// Four i64 parameters — the managed-memory runtime's `__managed_slice_managed(arr, start, end, cloneFn)`, plus
// `__managed_zero_elems` / `__managed_map` / `__managed_slice_opaque` beside it. It joins the 1/2/3-param
// family here (rather than beside a single caller) because more than one entry needs it.
export function fourI64Params() returns StdTypeArray
	var types = threeI64Params()
	types.push(StdType.i64)
	return types
end 'fourI64Params'

// Five i64 parameters — `__gt_subp_yield_read(readEnd, buf, cap, bytesOutPtr, ownsPipe)`.
export function fiveI64Params() returns StdTypeArray
	var types = fourI64Params()
	types.push(StdType.i64)
	return types
end 'fiveI64Params'

// Six i64 parameters — `__managed_move_elems(dest, destIndex, src, srcIndex, count, elementSize)`.
export function sixI64Params() returns StdTypeArray
	var types = fiveI64Params()
	types.push(StdType.i64)
	return types
end 'sixI64Params'

// ⚠ **`i64Params(count)` STOOD HERE AND WENT AT W129's REVIEW, WITH ITS ONLY CALLER.** The named ladder
// above is right for an entry whose arity IS a source fact — `__mm_alloc` takes two because it takes two.
// It was wrong for one whose arity was a SUM the threading computed (`__cs_contains`: two explicit
// arguments, a layout descriptor, and one witness table per key constraint), because there the count and
// the list are two statements of one number paired by hand, and the hand pairing is what silently survives
// a change to either summand. **NO ENTRY POINT HAS A DERIVED ARITY TODAY** — the last one that did went
// with the `__cs_*` runtime (W129) — so the ladder is complete, and a future derived-arity entry brings the
// deriving helper back rather than writing a count beside a list.

// Emit the `param` ops an entry block owes. A Std function's parameters are materialized once, at
// entry, by the op whose `role` is `param` — the backend turns each into the move that captures the
// incoming ABI register into its virtual register. Parameter `k` is ValueId `k`. All-i64: every
// hand-assembled runtime chunk uses the GPR-only internal ABI. A chunk with a NON-i64 parameter (a
// `__fnref_` thunk forwarding a float — P1.5 #78) uses `emitTypedParams` instead.
export function emitParams(module StdModule, block IrBlock, count ParamCount)
	for k in 0 upto count 'each'
		module.appendOp(block, op: StdOp.param(k as ValueId, index: k, paramType: StdType.i64))
	end 'each'
end 'emitParams'

// Emit the `param` ops for a synthesized function whose parameters are NOT all i64 — the `__fnref_` thunk,
// whose float user parameters must be captured from a float argument register (P1.5 #78). Parameter `k` is
// ValueId `k`, typed `paramTypes[k]`, so the value-class column classes it in the file its type names and
// the entry capture reads it from the matching ABI register. The all-i64 twin of `emitParams`, for the one
// runtime builder whose parameter files vary.
export function emitTypedParams(module StdModule, block IrBlock, paramTypes StdTypeArray)
	for k in 0 upto paramTypes.count() 'each'
		let paramType = try paramTypes.get(k) otherwise panic("emitTypedParams: paramTypes.get OOB at {k}")
		module.appendOp(block, op: StdOp.param(k, index: k, paramType: paramType))
	end 'each'
end 'emitTypedParams'

// --- The single-op emit helpers every runtime builder shares ---
//
// Each is one `StdOp` over one block, minted into a fresh value. They live HERE, beside `emitParams`
// and `argsOf`, because three files build Std graphs by hand (`MmRuntime`, `StringRuntime`,
// `ManagedMemoryRuntime`) plus the two shared homes over them (`BufferOwnership`, `RuntimeAbort`), and a
// `ids.mint()` + `module.appendOp` pair written out at each of a few hundred sites is the same four
// tokens of noise every time. They were `ManagedMemoryRuntime`'s private helpers until `BufferOwnership` and the
// String runtime needed the same four ops to ask the same questions of the same record slots.

// Load `record`'s field at `offset` into a fresh value.
export function emitLoadField(module StdModule, block IrBlock, record ValueId, offset ByteOffset, ids ValueMinter) returns ValueId
	let v = ids.mint()
	module.appendOp(block, op: StdOp.loadIndirect(v, addrId: record, offset: offset, valueType: StdType.i64))
	return v
end 'emitLoadField'

// Store `value` into `record`'s field at `offset`.
export function emitStoreField(module StdModule, block IrBlock, record ValueId, offset ByteOffset, value ValueId)
	module.appendOp(block, op: StdOp.storeIndirect(record, offset: offset, valueId: value, valueType: StdType.i64))
end 'emitStoreField'

// ⭐ **ONE MACHINE-WORD SLOT — the stride every WORD-INDEXED buffer in the runtime uses.** A hash table's
// `keys`/`states`/`hashes`/`values` columns, and the element buffer of any `Array` whose element is a managed
// POINTER or a machine-word int, all address slot `i` at `base + i·8`.
export let WordSlotBytes = 8 as ParsedInt

// The byte address of word slot `index` in a parallel buffer — `base + index · WordSlotBytes`.
//
// ⚠ **IT LIVES HERE, WITH THE OTHER SINGLE-OP EMIT HELPERS, BECAUSE THE HASH TABLE WAS NEVER ITS ONLY
// CALLER.** It was the deleted `HashTableRuntime`'s `emitHtSlotAddr` — but a `from`-construction already reads an ARRAY's element
// buffer through it, which is what identifies it as a word-slot fact rather than a hash-table one, and
// `__list_from` reads the same buffer the same way. A second copy under a list-shaped name would have been
// "the address of word slot i" written down twice, over the same buffers.
function emitWordSlotAddr(module StdModule, block IrBlock, base ValueId, index ValueId, ids ValueMinter) returns ValueId
	let slotBytes = emitConst(module, block: block, value: WordSlotBytes, ids: ids)
	let offset = emitBin(module, block: block, a: index, b: slotBytes, opcode: StdBinOpcode.mul, ids: ids)
	return emitBin(module, block: block, a: base, b: offset, opcode: StdBinOpcode.add, ids: ids)
end 'emitWordSlotAddr'

// Load slot `index` (one i64 word) of parallel buffer `base`.
export function emitWordSlotLoad(module StdModule, block IrBlock, base ValueId, index ValueId, ids ValueMinter) returns ValueId
	return emitLoadField(module, block: block, record: emitWordSlotAddr(module, block: block, base: base, index: index, ids: ids), offset: 0, ids: ids)
end 'emitWordSlotLoad'

// Store `value` into slot `index` (one i64 word) of parallel buffer `base`.
export function emitWordSlotStore(module StdModule, block IrBlock, base ValueId, index ValueId, value ValueId, ids ValueMinter)
	emitStoreField(module, block: block, record: emitWordSlotAddr(module, block: block, base: base, index: index, ids: ids), offset: 0, value: value)
end 'emitWordSlotStore'

// ⭐⭐ **NULL A SLOT WHOSE ELEMENT HAS BEEN MOVED OUT OF A BORROWED ARRAY — AND ONLY WHEN THE NULL MEANS
// SOMETHING.** `__list_from` drains an array the caller still owns: each element is
// handed to the new container, and the source slot is then nulled so the array's OWN `__managed_decref` walk
// does not drop a key the container now owns. This is that step, written once for both.
//
// ⛔⛔ **THE GUARD IS THE WHOLE POINT, AND WITHOUT IT THIS IS A WILD WRITE INTO READ-ONLY MEMORY.** The
// array's decref walk drops slots only when the record carries a per-element destructor
// (`element_destroy@40 != 0`), so for a TRIVIAL element the null does no work — both call sites already
// said so in a comment (*"a trivial int element is unaffected by the null"*) and stored anyway. That was
// harmless only while every array reaching them was heap-allocated. It no longer is: an all-constant array
// literal is now an owned record over an IMMORTAL `.rdata` blob (`LowerMaxonToStd.lowerConstArrayLiteral`),
// and `Set from [1, 2, 3]` drained one straight into `.rdata` — **exit 0xC0000005, 13 cases**.
//
// ⭐ **AND THE TWO CONDITIONS COINCIDE EXACTLY, WHICH IS WHY THIS GUARD IS A CURE AND NOT A PATCH.** A
// record may have an immortal buffer only if its element stores its own bytes
// (`SignatureIndex.arrayElementMayBeConstantBlob` refuses a managed or opaque element), and such a record's
// `element_destroy@40` is never written — `lowerConstArrayLiteral` leaves it at the zero `__mm_alloc`
// guarantees. So *immortal ⇒ trivial ⇒ guarded out*: the store that could reach read-only memory is
// precisely the store that was doing nothing. Nothing that was doing work is skipped.
//
// ⚠ It is a RUN-TIME test and cannot be a compile-time one: one program's `__list_from` serves every
// `Set from […]` in it, so a program with both an int-keyed and a String-keyed set needs both answers from
// one body.
//
// It returns the block execution continues in, because it FORKS: the caller goes on emitting into that.
export function emitMovedOutSlotClear(module StdModule, func IrFunction, block IrBlock, base ValueId, index ValueId, elemDrop ValueId, ids ValueMinter) returns IrBlock
	var clear = module.addBlock(func, label: b"clearmoved")
	let resume = module.addBlock(func, label: b"moveddone")

	let noDrop = emitConst(module, block: block, value: 0, ids: ids)
	let ownsElements = emitCmp(module, block: block, a: elemDrop, b: noDrop, pred: StdCmpPred.ne, ids: ids)
	module.setTerminator(block, op: StdOp.condBranch(ownsElements, thenBlockId: clear.id, elseBlockId: resume.id))

	let nullSlot = emitConst(module, block: clear, value: 0, ids: ids)
	emitWordSlotStore(module, block: clear, base: base, index: index, value: nullSlot, ids: ids)
	module.setTerminator(clear, op: StdOp.branch(resume.id))

	return resume
end 'emitMovedOutSlotClear'

// `a <op> b` into a fresh value.
export function emitBin(module StdModule, block IrBlock, a ValueId, b ValueId, opcode StdBinOpcode, ids ValueMinter) returns ValueId
	let v = ids.mint()
	module.appendOp(block, op: StdOp.binOp(v, lhs: a, rhs: b, opcode: opcode, operandType: StdType.i64))
	return v
end 'emitBin'

// `<op> operand` into a fresh value. `operandType` is the SOURCE's type, never the result's — the
// distinction `StdUnaryOpcode`'s header makes in full, and the reason it is a required argument here
// rather than defaulting to i64 the way `emitCmp`'s does: the ONE caller today
// (`BuiltinConformanceRuntime.buildFloatHash`) reads an f64 and writes an i64, so a defaulted i64
// would be wrong on the only use this helper has.
export function emitUnary(module StdModule, block IrBlock, operand ValueId, opcode StdUnaryOpcode, operandType StdType, ids ValueMinter) returns ValueId
	let v = ids.mint()
	module.appendOp(block, op: StdOp.unaryOp(v, operand: operand, opcode: opcode, operandType: operandType))
	return v
end 'emitUnary'

// A fresh i64 constant.
export function emitConst(module StdModule, block IrBlock, value ParsedInt, ids ValueMinter) returns ValueId
	let v = ids.mint()
	module.appendOp(block, op: StdOp.const(v, value: value, valueType: StdType.i64))
	return v
end 'emitConst'

// `a <pred> b` into a fresh value (a flag).
//
// ⚠ `operandType` DEFAULTS to i64 rather than being spelled at each of its eighty-odd call sites, and the
// default is the GPR-only internal ABI this file's `emitParams` already states: every hand-assembled runtime
// chunk compares machine words. The only callers that do not are the FLOAT builtin-conformance impls
// (`BuiltinConformanceRuntime.buildFloatCompare` and `buildBuiltinEquals` under an f64 operand), and they
// pass `operandType` explicitly. Parameterized rather than FORKED into an `emitFloatCmp`: a fork would be
// this three-line body copied, so the day `StdOp.cmp` gains a field only one copy would learn about it.
export function emitCmp(module StdModule, block IrBlock, a ValueId, b ValueId, pred StdCmpPred, ids ValueMinter, operandType StdType = StdType.i64) returns ValueId
	let v = ids.mint()
	module.appendOp(block, op: StdOp.cmp(v, lhs: a, rhs: b, pred: pred, operandType: operandType))
	return v
end 'emitCmp'

// ⭐⭐ **THE TWO EXITS OF EVERY THROWING RUNTIME FUNCTION, ONE HOME.** A throwing runtime body ends in the
// dual-register `errorReturn(value, flag)` ABI — `flag == NoErrorFlag` on the success edge, `ordinal +
// ErrorFlagOrdinalBias` on the failure edge — and every family needs both spellings.
//
// ⚠ **THEY WERE COPIED, AND THE COPY IS EXACTLY THE PAIR THIS PROJECT KEEPS FINDING DRIFTED.**
// `ManagedMemoryRuntime` had `emitErrorReturn`/`emitOkReturn` and `ManagedFileRuntime` had
// `emitManagedFileThrow`/`emitManagedFileOk` — the same two three-line bodies under two names, and R4.3
// would have made it three. They join the single-op emit helpers above for their reason: `MmRuntime` is the
// runtime's base layer and every family already draws on it, so homing them here needs no new dependency.
//
// ⚠ A VOID throwing function passes a 0 through `value` that the ABI never moves (a void
// `emitReturnValueMove` emits nothing); only the flag register is read.
export function emitErrorReturn(module StdModule, block IrBlock, flag ParsedInt, ids ValueMinter)
	let zeroVal = emitConst(module, block: block, value: 0, ids: ids)
	let flagVal = emitConst(module, block: block, value: flag, ids: ids)
	module.setTerminator(block, op: StdOp.errorReturn(zeroVal, errorFlagId: flagVal))
end 'emitErrorReturn'

// A successful throwing return: `errorReturn(value, 0)`. See `emitErrorReturn` for why the pair lives here.
export function emitOkReturn(module StdModule, block IrBlock, value ValueId, ids ValueMinter)
	let flag = emitConst(module, block: block, value: NoErrorFlag, ids: ids)
	module.setTerminator(block, op: StdOp.errorReturn(value, errorFlagId: flag))
end 'emitOkReturn'

// ⭐ **THE SUCCESS EXIT OF A THROWING *VOID* FUNCTION — the ok return with the placeholder the ABI never
// moves.** It is not a wrapper around `emitOkReturn`: what it adds is the 0, and that 0 is the whole of the
// duplication it removes. `__managed_set_length`, `__managed_set_byte`, `__managed_mem_grow`,
// `__md_create` and `__mf_*`'s void pair both end this way, and each spelled the same two
// statements out — one fact written down seven times, whose failure mode is a family that "returns void"
// with a garbage flag register the day the placeholder is written differently.
export function emitVoidOkReturn(module StdModule, block IrBlock, ids ValueMinter)
	let nothing = emitConst(module, block: block, value: 0, ids: ids)
	emitOkReturn(module, block: block, value: nothing, ids: ids)
end 'emitVoidOkReturn'

// Terminate `block` with `ret <constant>` — the shape EVERY runtime PREDICATE ends in, because there is no
// `setcc` at this tier: a verdict is a constant-returning block off a fused compare, one block per answer.
// A predicate therefore returns a CONSTANT from its own block rather than the compare's flag value directly
// — the shape the deleted `HashTableRuntime.buildHtContains` had, and the one the backend has always been exercised on. (It
// named `ManagedMemoryRuntime.buildManagedIsEmpty` until ARR4 retired `isEmpty` from the `Array` surface and
// deleted that function with it; the shape is the tier's, not that one predicate's.)
//
// ⚠ It was the deleted `HashTableRuntime`'s `emitHtReturnConst` while a hash table was its only caller; the `Array`
// surface's `contains` is the second family to answer a bool this way, and a helper about the STD TIER's
// lack of a `setcc` is not a hash table's property. It joins the single-op emit helpers here for
// `emitErrorReturn`'s stated reason. `StringRuntime.emitPredicateReturn` was a byte-identical THIRD copy and
// `CharacterSetRuntime` (retired) and `BuiltinConformanceRuntime` spelled the two statements out longhand — all folded here.
export function emitConstReturn(module StdModule, block IrBlock, value ParsedInt, ids ValueMinter)
	let result = emitConst(module, block: block, value: value, ids: ids)
	module.setTerminator(block, op: StdOp.ret(result))
end 'emitConstReturn'

// ⚠ **THE TWO BYTE LOADS AND `__str_copy` MOVED HERE FROM `StringRuntime` (W49 wave 9).** They joined the
// single-op emit helpers above for `emitConstReturn`'s stated reason, one family further out: a `u8` LOAD
// and a byte BLIT are properties of the Std tier, not of a String. Both emitters were already `export`ed
// for `GraphemeRuntime`'s decoders and segmenter — which is the shape the header below said it existed to
// prevent, TWO files each owning "the ONE spelling" — and `__str_copy`'s consumers had already outgrown
// their name: `Parser`'s interpolation, `GtRuntime`'s subprocess buffers, `__mm_to_cstring`'s copy path
// and every `emitBuildOwnedInlineString` blit. The callee KEEPS its `__str_copy` spelling, because a
// runtime symbol's name is baked into goldens and into `RuntimeUsage`'s bit; only the source moved.

// The blit's callee name. `__`-prefixed compiler-internal (no E3004, no signature slotting) and NOT
// `__mm_`-prefixed, so `isRuntimeCallee` leaves it out of the heap decision — it allocates nothing, and a
// program that only blits bytes must not carry the allocator or the leak gate.
//
// ⚠ It is spelled `__str_copy` and stays spelled that way though it lives here now and has never been a
// String's: the name is baked into every committed golden that installs it and into `RuntimeUsage`'s
// `usesStrCopy` bit, so changing it would be a codegen change dressed as a rename.
export let StrCopyName = b"__str_copy"

// ⭐ **ONE BYTE AT `addr` — THE `u8` LOAD SPELLING FOR EVERY RUNTIME BUILDER**, so a widened read is a
// one-line change rather than a sweep of every byte-walking loop.
export function emitLoadByteAt(module StdModule, block IrBlock, addr ValueId, ids ValueMinter) returns ValueId
	let v = ids.mint()
	module.appendOp(block, op: StdOp.loadIndirect(v, addrId: addr, offset: 0, valueType: StdType.u8))
	return v
end 'emitLoadByteAt'

// One byte at `base[index]` — the address add plus the `u8` load, the shape every byte-walking loop that
// does NOT also need the address repeats (the compare loop's two operands, the grapheme runtime's
// byte-view fill, the classifying scan in `__str_from_bytes`).
export function emitLoadByteIndexed(module StdModule, block IrBlock, base ValueId, index ValueId, ids ValueMinter) returns ValueId
	return emitLoadByteAt(module, block: block, addr: emitBin(module, block: block, a: base, b: index, opcode: StdBinOpcode.add, ids: ids), ids: ids)
end 'emitLoadByteIndexed'

// `__str_copy(dest, src, len)` — blit `len` bytes from `src` into `dest`. A byte loop rather than a
// `rep movsb`/memcpy op because there is no memory-move op in the Std tier (`system` holds only
// `osAllocPages`/`osWriteStdout`), and a byte loop needs nothing the tier lacks. `len == 0` copies nothing
// (the header guard is `i >= len`, true at once).
//
// The loop index `i` is the header's phi — 0 from entry, `i+1` from the back edge — the same on-the-fly
// SSA shape every runtime builder here constructs directly, a runtime function having no parser.
export function buildStrCopy(module StdModule)
	var func = IrFunction.createFromStd(StrCopyName, returnType: StdReturnType.void, paramCount: 3, paramTypes: threeI64Params(), returnLine: 0)
	var ids = ValueMinter.create(3)

	var entry = module.addBlock(func, label: b"entry")
	var header = module.addBlock(func, label: b"header")
	var body = module.addBlock(func, label: b"body")
	var done = module.addBlock(func, label: b"done")

	emitParams(module, block: entry, count: 3)
	let dest = 0 as ValueId
	let src = 1 as ValueId
	let len = 2 as ValueId

	let zero = ids.mint()
	module.appendOp(entry, op: StdOp.const(zero, value: 0, valueType: StdType.i64))
	module.setTerminator(entry, op: StdOp.branch(header.id))

	let i = ids.mint()
	header.blockArgs.push(IrBlockArg.create(i, argType: StdType.i64))
	entry.branchEdges.push(BranchEdge.create(header.id, argIds: argsOf(zero)))

	let atEnd = ids.mint()
	module.appendOp(header, op: StdOp.cmp(atEnd, lhs: i, rhs: len, pred: StdCmpPred.ge, operandType: StdType.i64))
	module.setTerminator(header, op: StdOp.condBranch(atEnd, thenBlockId: done.id, elseBlockId: body.id))

	let srcAddr = ids.mint()
	module.appendOp(body, op: StdOp.binOp(srcAddr, lhs: src, rhs: i, opcode: StdBinOpcode.add, operandType: StdType.i64))
	let srcByte = ids.mint()
	module.appendOp(body, op: StdOp.loadIndirect(srcByte, addrId: srcAddr, offset: 0, valueType: StdType.u8))
	let dstAddr = ids.mint()
	module.appendOp(body, op: StdOp.binOp(dstAddr, lhs: dest, rhs: i, opcode: StdBinOpcode.add, operandType: StdType.i64))
	module.appendOp(body, op: StdOp.storeIndirect(dstAddr, offset: 0, valueId: srcByte, valueType: StdType.u8))
	let one = ids.mint()
	module.appendOp(body, op: StdOp.const(one, value: 1, valueType: StdType.i64))
	let iNext = ids.mint()
	module.appendOp(body, op: StdOp.binOp(iNext, lhs: i, rhs: one, opcode: StdBinOpcode.add, operandType: StdType.i64))
	module.setTerminator(body, op: StdOp.branch(header.id))
	body.branchEdges.push(BranchEdge.create(header.id, argIds: argsOf(iNext)))

	module.setTerminator(done, op: StdOp.retVoid)

	module.functions.push(func)
end 'buildStrCopy'

// ⭐ **THE TWO WORDS A STD-TIER PREDICATE RETURNS — 1 for yes, 0 for no — WRITTEN DOWN ONCE.** They live
// beside `emitConstReturn` because they are the same fact it is: with no `setcc` at this tier a bool is a
// returned CONSTANT, and which constant means true is not a property of any one runtime family.
//
// ⚠ **THIS WAS FIVE NAMED PAIRS AND TWO PAIRS OF BARE LITERALS, FOR ONE FACT.** `StrPredicateTrue`/`False`,
// `GraphemeTrue`/`False`, `EqualsTrue`/`False`, `ContainsFound`/`Missing`,
// and raw `0`/`1` at the hash-table and set `contains` returns. Each copy carried the same argument — that a
// caller must not read one function's "true" as another's "false" — while being the very thing that could
// make them disagree. The per-family pairs declined to share only because the HELPER was not shared either;
// now that it is, the constants ride the same base layer every runtime family already depends on.
export let PredicateTrue = 1 as ParsedInt
export let PredicateFalse = 0 as ParsedInt

// ⭐ **THE ONE BYTE-GRANULAR FILL LOOP.** Overwrite `byteCount` bytes at `dest` with the low byte of
// `fillValue`, one byte at a time (fill widths are not all 8-multiples — a `b"hi"` buffer is 2 bytes, a
// `pop`'s vacated slot is one ranged element). `byteCount == 0` exits on the first compare, writing nothing.
// Creates its own header/body/done blocks off `cur` and returns the continuation (`done`), so the caller
// threads it like any other loop-emitting helper.
//
// ⚠ **IT IS SHARED ACROSS A FILE BOUNDARY ON PURPOSE, WHICH IS WHY IT LIVES HERE IN THE BASE LAYER.** Two
// call sites fill a contiguous byte range with a constant: `__mm_free`'s poison (fill `PoisonByte`) and the
// array capacity-slot zeroer (`ManagedMemoryRuntime`'s `clear`/`resize`-shrink/`pop`/`remove`, fill 0, which restore
// the `[length, capacity)`-reads-zero invariant the element walk depends on). They were two independent copies
// of the same loop in two files — nothing making them agree, so a future edit to one (a wider store, a changed
// bound) would silently diverge from the other and corrupt exactly one of freed-payload poison / vacated-slot
// zeroing. `MmRuntime` is the runtime's base layer — installed whenever the program touches the heap, and
// already the home of the single-op emit helpers above that `ManagedMemoryRuntime` draws on — so homing the loop here
// single-sources it without any new cross-layer dependency (the managed-memory runtime already depends on this file).
export function emitFillRange(module StdModule, func IrFunction, cur IrBlock, dest ValueId, byteCount ValueId, fillValue ParsedInt, ids ValueMinter) returns IrBlock
	var header = module.addBlock(func, label: b"fillh")
	var body = module.addBlock(func, label: b"fillb")
	let done = module.addBlock(func, label: b"filld")

	let zero = ids.mint()
	module.appendOp(cur, op: StdOp.const(zero, value: 0, valueType: StdType.i64))
	module.setTerminator(cur, op: StdOp.branch(header.id))

	let i = ids.mint()
	header.blockArgs.push(IrBlockArg.create(i, argType: StdType.i64))
	cur.branchEdges.push(BranchEdge.create(header.id, argIds: argsOf(zero)))
	let atEnd = ids.mint()
	module.appendOp(header, op: StdOp.cmp(atEnd, lhs: i, rhs: byteCount, pred: StdCmpPred.ge, operandType: StdType.i64))
	module.setTerminator(header, op: StdOp.condBranch(atEnd, thenBlockId: done.id, elseBlockId: body.id))

	let dstAddr = ids.mint()
	module.appendOp(body, op: StdOp.binOp(dstAddr, lhs: dest, rhs: i, opcode: StdBinOpcode.add, operandType: StdType.i64))
	let fillByte = ids.mint()
	module.appendOp(body, op: StdOp.const(fillByte, value: fillValue, valueType: StdType.i64))
	module.appendOp(body, op: StdOp.storeIndirect(dstAddr, offset: 0, valueId: fillByte, valueType: StdType.u8))
	let one = ids.mint()
	module.appendOp(body, op: StdOp.const(one, value: 1, valueType: StdType.i64))
	let iNext = ids.mint()
	module.appendOp(body, op: StdOp.binOp(iNext, lhs: i, rhs: one, opcode: StdBinOpcode.add, operandType: StdType.i64))
	module.setTerminator(body, op: StdOp.branch(header.id))
	body.branchEdges.push(BranchEdge.create(header.id, argIds: argsOf(iNext)))

	return done
end 'emitFillRange'

// `__slab_alloc(size) -> ptr` — the bump allocator.
//
// ⭐ IT ALWAYS RETURNS ZEROED MEMORY, AND IT PAYS NOTHING FOR IT. `VirtualAlloc(MEM_COMMIT)` hands
// back zero-filled pages, and a bump slot has never been handed out before, so it is still
// pristine — the region `[cursor, end)` is zero by construction and stays that way because nothing
// ever writes into it before it is claimed. The guarantee is the ALLOCATOR's, not each caller's.
//
// ⚠⚠ THAT TRUST IS UNPAID-FOR DEBT THE DAY MEMORY IS RECYCLED. A slot returned to a free list holds
// the previous occupant's bytes, and threading an intrusive free-list link through a fresh span
// would dirty EVERY slot in it — which is precisely why there is no eager free list here. Leaving
// the bump region pristine is the PRECONDITION for zero-elision, not an optimization. Whoever adds
// recycling must memzero on the free-list path, or `Point.create` starts reading a dead object's
// bytes. Non-zeroing alloc cost v1 three separately root-caused bugs, each "fixed" by bolting a
// zeroing loop onto the caller. See ARCHITECTURE.md → "Allocator: the zeroing contract".
function buildSlabAlloc(module StdModule)
	var func = IrFunction.createFromStd(SlabAllocName, returnType: StdReturnType.value(StdType.i64), paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry")
	var grow = module.addBlock(func, label: b"grow")
	var bump = module.addBlock(func, label: b"bump")

	emitParams(module, block: entry, count: 1)
	let size = 0 as ValueId

	// `cursorAddr` and `endAddr` are computed once in the entry block and read in BOTH successors —
	// ordinary SSA, since entry dominates them. `globalAddr` is `isPure: true` and freely
	// rematerializable, so the allocator may choose to recompute rather than keep them live; that
	// is its decision to make, and hoisting the address here is what lets it make one.
	let cursorAddr = ids.mint()
	module.appendOp(entry, op: StdOp.globalAddr(cursorAddr, label: SlabCursorLabel))
	let cursor = ids.mint()
	module.appendOp(entry, op: StdOp.loadIndirect(cursor, addrId: cursorAddr, offset: 0, valueType: StdType.i64))
	let next = ids.mint()
	module.appendOp(entry, op: StdOp.binOp(next, lhs: cursor, rhs: size, opcode: StdBinOpcode.add, operandType: StdType.i64))
	let endAddr = ids.mint()
	module.appendOp(entry, op: StdOp.globalAddr(endAddr, label: SlabEndLabel))
	let arenaEnd = ids.mint()
	module.appendOp(entry, op: StdOp.loadIndirect(arenaEnd, addrId: endAddr, offset: 0, valueType: StdType.i64))
	// A SIGNED compare over two ADDRESSES is correct here, and it is worth saying why rather than
	// leaving it to look like an oversight: `StdTypeInfo` records no signedness, so every Std
	// integer compare takes the signed family. User-mode addresses never set the high bit, so the
	// signed and unsigned orderings agree on every value this can hold.
	let exhausted = ids.mint()
	module.appendOp(entry, op: StdOp.cmp(exhausted, lhs: next, rhs: arenaEnd, pred: StdCmpPred.gt, operandType: StdType.i64))
	module.setTerminator(entry, op: StdOp.condBranch(exhausted, thenBlockId: grow.id, elseBlockId: bump.id))

	// Grow: commit a fresh arena and serve this request from its base.
	//
	// The request is `size + ArenaBytes`, which ALWAYS fits the allocation whatever its size — no
	// `max`, no second branch, and no unserviceable request. The cost is at most one arena of
	// over-commit on an oversized allocation; the alternative was a branch on every grow to answer
	// a question a single `add` answers unconditionally.
	let arenaConst = ids.mint()
	module.appendOp(grow, op: StdOp.const(arenaConst, value: ArenaBytes, valueType: StdType.i64))
	let total = ids.mint()
	module.appendOp(grow, op: StdOp.binOp(total, lhs: size, rhs: arenaConst, opcode: StdBinOpcode.add, operandType: StdType.i64))
	let base = ids.mint()
	module.appendOp(grow, op: StdOp.osAllocPages(base, sizeId: total))
	let newCursor = ids.mint()
	module.appendOp(grow, op: StdOp.binOp(newCursor, lhs: base, rhs: size, opcode: StdBinOpcode.add, operandType: StdType.i64))
	module.appendOp(grow, op: StdOp.storeIndirect(cursorAddr, offset: 0, valueId: newCursor, valueType: StdType.i64))
	let newEnd = ids.mint()
	module.appendOp(grow, op: StdOp.binOp(newEnd, lhs: base, rhs: total, opcode: StdBinOpcode.add, operandType: StdType.i64))
	module.appendOp(grow, op: StdOp.storeIndirect(endAddr, offset: 0, valueId: newEnd, valueType: StdType.i64))
	module.setTerminator(grow, op: StdOp.ret(base))

	// Bump: the request fits the current arena. Publish the advanced cursor, return the old one.
	module.appendOp(bump, op: StdOp.storeIndirect(cursorAddr, offset: 0, valueId: next, valueType: StdType.i64))
	module.setTerminator(bump, op: StdOp.ret(cursor))

	module.functions.push(func)
end 'buildSlabAlloc'

// `__mm_alloc(size, destructor) -> ptr` — a managed box: a header plus `size` bytes of payload.
//
// The returned pointer addresses the PAYLOAD, so a struct's field `i` is at `[ptr + i*8]` and the
// header is invisible to every consumer. `destructor` is stored for `__mm_free` to find; for a
// trivially-owned struct it is **0**, and that is not a placeholder — nothing about a struct of
// scalars needs to run at death, so there is no function to point at. (Synthesizing an empty one
// just to have a non-null pointer would be a function with no reason to exist.) The op pair that
// TAKES a function's address and CALLS one through a register — `funcAddr`/`callIndirect` — is
// therefore deferred to P1.2, where `__destruct_String` is a real consumer with a real reason to
// be right: a String that does not free its buffer leaks, and the leak gate below says so.
function buildMmAlloc(module StdModule)
	// ⚠ **THE ARITY IS THE FLAG'S, AND THAT IS WHY EVERY CALL SITE GOES THROUGH `emitMmAllocCall`.** A
	// `--debugstream` build takes a THIRD argument — the allocation's tag index — because a tag cannot be
	// recovered from a pointer later and this is the only moment it is known. A normal build takes two, as
	// it always has, so its emitted call sites are byte-identical.
	let paramCount = 3 if module.debugStream else 2
	let paramTypes = threeI64Params() if module.debugStream else twoI64Params()
	var func = IrFunction.createFromStd(MmAllocName, returnType: StdReturnType.value(StdType.i64), paramCount: paramCount, paramTypes: paramTypes, returnLine: 0)
	var ids = ValueMinter.create(paramCount)

	var entry = module.addBlock(func, label: b"entry")
	emitParams(module, block: entry, count: paramCount)
	let size = 0 as ValueId
	let destructor = 1 as ValueId
	let tagIndex = 2 as ValueId

	let headerConst = ids.mint()
	module.appendOp(entry, op: StdOp.const(headerConst, value: boxPrefixBytes(module.debugStream), valueType: StdType.i64))
	let total = ids.mint()
	module.appendOp(entry, op: StdOp.binOp(total, lhs: size, rhs: headerConst, opcode: StdBinOpcode.add, operandType: StdType.i64))
	let allocation = ids.mint()
	module.appendOp(entry, op: StdOp.call(allocation, callee: SlabAllocName, args: argsOf(total)))

	// The DebugStream prefix word, when this build has one: `(alloc_id << 16) | tag_index`, stamped once
	// here and read back by every later event on this box. `alloc_id` PRE-increments a monotonic counter,
	// so the first allocation is #1 and a zero packed id can only ever mean "never stamped".
	// ⚠⚠ **`payloadOffset` REUSES `headerConst` WHEN THE BUILD IS UNTRACED, AND THAT IS NOT A
	// MICRO-OPTIMISATION — IT IS THE BYTE-IDENTICAL RULE.** With no prefix word the two distances are the
	// same number, and minting a SECOND `const HeaderBytes` for the payload offset is one more op in
	// `__mm_alloc`: the register allocator then makes different choices and every heap program's `.text`
	// moves, against thousands of committed fragment goldens. (Measured on this rung's first
	// byte-identical check: identical printed IR, 1084 differing bytes in the linked image.) Under the flag
	// the two genuinely differ — the total includes the prefix word, the payload offset does not — so the
	// second constant is minted there and only there.
	var payloadOffset = headerConst
	var base = allocation
	var packedId = 0 as ValueId
	if module.debugStream 'stampPackedId'
		let counterAddr = ids.mint()
		module.appendOp(entry, op: StdOp.globalAddr(counterAddr, label: DsAllocIdLabel))
		let previous = ids.mint()
		module.appendOp(entry, op: StdOp.loadIndirect(previous, addrId: counterAddr, offset: 0, valueType: StdType.i64))
		let one = emitConst(module, block: entry, value: 1, ids: ids)
		let allocId = emitBin(module, block: entry, a: previous, b: one, opcode: StdBinOpcode.add, ids: ids)
		module.appendOp(entry, op: StdOp.storeIndirect(counterAddr, offset: 0, valueId: allocId, valueType: StdType.i64))
		let shift = emitConst(module, block: entry, value: DsMmPackedIdShift, ids: ids)
		let shifted = emitBin(module, block: entry, a: allocId, b: shift, opcode: StdBinOpcode.shl, ids: ids)
		packedId = emitBin(module, block: entry, a: shifted, b: tagIndex, opcode: StdBinOpcode.bitOr, ids: ids)
		module.appendOp(entry, op: StdOp.storeIndirect(allocation, offset: 0, valueId: packedId, valueType: StdType.i64))

		let prefix = emitConst(module, block: entry, value: DebugStreamPackedIdBytes, ids: ids)
		base = emitBin(module, block: entry, a: allocation, b: prefix, opcode: StdBinOpcode.add, ids: ids)
		payloadOffset = emitConst(module, block: entry, value: HeaderBytes, ids: ids)
	end 'stampPackedId'

	module.appendOp(entry, op: StdOp.storeIndirect(base, offset: HeaderDestructorOffset, valueId: destructor, valueType: StdType.i64))
	module.appendOp(entry, op: StdOp.storeIndirect(base, offset: HeaderSizeOffset, valueId: size, valueType: StdType.i64))
	// ⭐ THE REFCOUNT IS NOT WRITTEN, AND ITS ABSENCE IS THE ZEROING CONTRACT DOING ITS JOB. The
	// slab guarantees zeroed memory, and 0 is exactly the initial refcount this model wants (see
	// `__mm_decref` — 0 means ONE owner). Storing it anyway would be the caller re-establishing a
	// guarantee the allocator already makes, which is the precise habit that let v1's non-zeroing
	// slab survive three bugs: every call site "handled" it locally, so nobody fixed the allocator.
	// If this line ever becomes necessary, the allocator is broken, not this function.

	let countAddr = ids.mint()
	module.appendOp(entry, op: StdOp.globalAddr(countAddr, label: MmAllocCountLabel))
	let count = ids.mint()
	module.appendOp(entry, op: StdOp.loadIndirect(count, addrId: countAddr, offset: 0, valueType: StdType.i64))
	let oneConst = ids.mint()
	module.appendOp(entry, op: StdOp.const(oneConst, value: 1, valueType: StdType.i64))
	let raised = ids.mint()
	module.appendOp(entry, op: StdOp.binOp(raised, lhs: count, rhs: oneConst, opcode: StdBinOpcode.add, operandType: StdType.i64))
	module.appendOp(entry, op: StdOp.storeIndirect(countAddr, offset: 0, valueId: raised, valueType: StdType.i64))

	let payload = ids.mint()
	module.appendOp(entry, op: StdOp.binOp(payload, lhs: base, rhs: payloadOffset, opcode: StdBinOpcode.add, operandType: StdType.i64))

	var out = emitMmAllocEvent(module, func: func, block: entry, packedId: packedId, size: size, ids: ids)
	module.setTerminator(out, op: StdOp.ret(payload))

	module.functions.push(func)
end 'buildMmAlloc'

// ⭐ **THE ONE `__mm_alloc` CALL EMISSION, AND THE ONE PLACE ITS FLAG-DEPENDENT ARITY IS KNOWN.** Every
// heap box the compiler builds — a String record, an array record, its element buffer, a list node, a
// user struct — comes through here, so `__mm_alloc(size, destructor[, tag])` is spelled in exactly one
// place. `Parser.emitBoxAlloc`'s header already argued the point for the three call sites it consolidated
// ("an added or reordered alloc argument that reached three of those call sites and missed the fourth
// would corrupt that box silently"); `--debugstream` is that added argument, and it reaches fifteen.
//
// The TAG names what the box IS. A runtime chunk knows that statically and passes a fixed roster case; a
// USER allocation's is interned from its own result type at the lowering (see `LowerMaxonToStd`'s
// `__mm_alloc` arm), which is the only tier that can see it.
export function emitMmAllocCall(module StdModule, block IrBlock, result ValueId, size ValueId, destructor ValueId, tag ParsedInt, ids ValueMinter)
	if not module.debugStream 'untracedBuild'
		module.appendOp(block, op: StdOp.call(result, callee: MmAllocName, args: twoArgs(size, second: destructor)))
		return
	end 'untracedBuild'

	let tagIndex = emitConst(module, block: block, value: tag, ids: ids)
	module.appendOp(block, op: StdOp.call(result, callee: MmAllocName, args: threeArgs(size, second: destructor, third: tagIndex)))
end 'emitMmAllocCall'

// ⭐ **THE `--debugstream` PREFIX WORD'S ADDRESS — `ptr - (HeaderBytes + DebugStreamPackedIdBytes)`.**
// The one place the word's position is expressed, exactly as `emitHeaderBase` is for the header itself,
// and asked ONLY by the three event emitters below. See `DebugStreamPackedIdBytes` for why it sits below
// the header rather than among its fields.
function emitLoadPackedId(module StdModule, block IrBlock, ptr ValueId, ids ValueMinter) returns ValueId
	let prefixConst = emitConst(module, block: block, value: boxPrefixBytes(true), ids: ids)
	let packedIdAddr = emitBin(module, block: block, a: ptr, b: prefixConst, opcode: StdBinOpcode.sub, ids: ids)
	return emitLoadField(module, block: block, record: packedIdAddr, offset: 0, ids: ids)
end 'emitLoadPackedId'

// ⭐⭐ **THE FOUR EVENT EMITTERS, AND EVERY ONE OF THEM ASKS `module.debugStream` ITSELF.**
//
// ⚠⚠ **THAT GATE IS NOT REDUNDANT WITH `emitMmEvent`'S — `emitMmEvent` HAS NONE, DELIBERATELY.** The
// arguments these pass cost OPS to compute (a refcount load, a packed-id load, a plus-one), and those ops
// would be emitted before a gate inside `emitMmEvent` could decline them — which is not a cosmetic
// difference: a `globalAddr __ds_base` emitted into an untraced build names a `.data` slot that build
// never laid out, and the backend PANICS at the relocation. (Measured, on the first byte-identical check
// of this rung: `buildMmAlloc` called `emitMmEvent` directly and every heap program failed to link.) So
// the compile-time gate lives at each of the four, where the arguments are built.
//
// ⭐ **AND THE `owners - 1` CONVENTION IS TRANSLATED HERE.**
//
// shv2 stores `owners - 1` in the refcount word — a box is born at 0 meaning ONE owner
// (`emitRefcountCheckToLastOwner` argues why). That convention is PRIVATE to this file, and the wire's
// `rc=` field is not: the monitor's reader, and the reference this format is shared with, both mean OWNER
// COUNT by it. So the translation happens once, here, rather than leaking a shv2 storage detail into a
// trace that three compilers' readers compare.
//
// ⚠ **DECREF IS THE SUBTLE ONE, AND ITS EXPRESSION IS UNIFORM ONLY BECAUSE OF AN IDENTITY.** On the
// SHARED path the stored count goes `n -> n-1`, so owners go `n+1 -> n`; on the LAST-OWNER path the count
// is never touched and owners go `1 -> 0`. Both are `owners_after == stored_BEFORE` — the shared case by
// arithmetic, the last-owner case because the stored value is 0 there. That identity is why the event is
// emitted ONCE, in the block before the branch, instead of once per arm.
//
// The alloc event, with the requested USER size as its value — never the total, so the number in the
// trace is the one the caller asked for and stays comparable across a header that grows. It is the one
// emitter that takes the packed id as a VALUE rather than reading it back out of the box: `__mm_alloc` has
// just computed it, and re-loading what is already in a register would be the only place in this family
// where the box is read for something the caller knows.
function emitMmAllocEvent(module StdModule, func IrFunction, block IrBlock, packedId ValueId, size ValueId, ids ValueMinter) returns IrBlock
	if not module.debugStream 'untracedBuild'
		return block
	end 'untracedBuild'

	return emitMmEvent(module, func: func, block: block, eventType: DsEvMmAlloc, packedId: packedId, value: size, ids: ids)
end 'emitMmAllocEvent'

function emitMmDecrefEvent(module StdModule, func IrFunction, block IrBlock, ptr ValueId, ids ValueMinter) returns IrBlock
	if not module.debugStream 'untracedBuild'
		return block
	end 'untracedBuild'

	let ownersAfter = emitLoadRefcount(module, block: block, ptr: ptr, ids: ids)
	let packedId = emitLoadPackedId(module, block: block, ptr: ptr, ids: ids)
	return emitMmEvent(module, func: func, block: block, eventType: DsEvMmDecref, packedId: packedId, value: ownersAfter, ids: ids)
end 'emitMmDecrefEvent'

// Called AFTER the increment, so the stored count is already the new one and owners are it plus one.
function emitMmIncrefEvent(module StdModule, func IrFunction, block IrBlock, ptr ValueId, ids ValueMinter) returns IrBlock
	if not module.debugStream 'untracedBuild'
		return block
	end 'untracedBuild'

	let stored = emitLoadRefcount(module, block: block, ptr: ptr, ids: ids)
	let one = emitConst(module, block: block, value: 1, ids: ids)
	let ownersAfter = emitBin(module, block: block, a: stored, b: one, opcode: StdBinOpcode.add, ids: ids)
	let packedId = emitLoadPackedId(module, block: block, ptr: ptr, ids: ids)
	return emitMmEvent(module, func: func, block: block, eventType: DsEvMmIncref, packedId: packedId, value: ownersAfter, ids: ids)
end 'emitMmIncrefEvent'

// A free carries no value: the box has no size to report that the alloc did not already, and no refcount
// left to report at all. The wire's value slot is unused for this event and the monitor never reads it.
function emitMmFreeEvent(module StdModule, func IrFunction, block IrBlock, ptr ValueId, ids ValueMinter) returns IrBlock
	if not module.debugStream 'untracedBuild'
		return block
	end 'untracedBuild'

	let packedId = emitLoadPackedId(module, block: block, ptr: ptr, ids: ids)
	let unused = emitConst(module, block: block, value: 0, ids: ids)
	return emitMmEvent(module, func: func, block: block, eventType: DsEvMmFree, packedId: packedId, value: unused, ids: ids)
end 'emitMmFreeEvent'

// ⭐ **`__mm_incref(ptr)` — ONE MORE OWNER. IT IS BACK, WITH THE CONSUMER ITS ABSENCE WAS WAITING FOR.**
//
// It was deleted because NOTHING CALLED IT — 31 bytes of `.text` in every heap-using program, never
// executed, never proven right — under this file's founding rule: **vocabulary must not ship ahead of
// its consumer.** The rule is unchanged; what changed is that the consumer now exists.
//
// ⭐ **THE CONSUMER IS `__managed_slice`'s ZERO-COPY VIEW (P1.7 COW slice B).** A view is a second owner of
// the parent's ELEMENT BUFFER — a separate `__mm_alloc` allocation from either record — so taking a slice
// increfs that buffer and dropping (or detaching) a view decrefs it. Note WHAT is counted: the buffer, not
// the record. Both reference compilers refcount the RECORD, where a count of 2 cannot distinguish "two
// owners of this array" from "someone is viewing my bytes", which is exactly why the bootstrap gives up and
// eager-copies an owned slice (`MaxonToStandardConversion.Strings.cs:1480`). shv2 is MOVE-ONLY, so a
// record never has two owners and the buffer's own count is unambiguous: non-zero means "someone is
// viewing these bytes", which is precisely what `__managed_cow_detach` must ask before an in-place write.
//
// ⚠⚠ **NON-ATOMIC, DELIBERATELY** — the same decision the decref read-modify-write below carries, and it
// becomes `LOCK`-prefixed on the same day for the same reason. See `emitRefcountCheckToLastOwner`.
//
// There is no overflow check: the count is `owners - 1` in an i64, and a program cannot hold 2^63 views.
function buildMmIncref(module StdModule)
	var func = IrFunction.createFromStd(MmIncrefName, returnType: StdReturnType.void, paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry")
	emitParams(module, block: entry, count: 1)
	let ptr = 0 as ValueId

	emitAdjustRefcount(module, block: entry, ptr: ptr, opcode: StdBinOpcode.add, ids: ids)
	var out = emitMmIncrefEvent(module, func: func, block: entry, ptr: ptr, ids: ids)
	module.setTerminator(out, op: StdOp.retVoid)

	module.functions.push(func)
end 'buildMmIncref'

// ⭐ **`__mm_retain(ptr) -> ptr` — ONE MORE OWNER, HANDING BACK A FRESH SSA NAME FOR THE SAME BOX.**
//
// The incref twin of `buildMmIncref`, differing only in that it RETURNS the pointer it just increfed
// instead of `retVoid`. The parser needs both halves at once to co-own a BORROWED managed-aggregate
// parameter into a `var` (`var q = p`, OPEN #40): the incref makes `q` a second owner of the caller's
// box, and the RETURN gives `q` a ValueId DISTINCT from `p`'s — which the void `__mm_incref` cannot.
// That distinct name is load-bearing, not cosmetic: were `q` to reuse `p`'s ValueId while owned, a
// later re-borrow of `p` (`let r = p`) would `poisonMoveSource`-match `q` and wrongly poison it (see
// `Parser.retainBorrowedAggregate`). The box is otherwise untouched — same pointer, count raised by
// one — so the aggregate's aliasing (`q.x = 100` shows through to the caller) is preserved.
//
// ⚠⚠ **NON-ATOMIC, DELIBERATELY** — the same read-modify-write `buildMmIncref` and `__mm_decref`
// carry, and it becomes `LOCK`-prefixed on the same day for the same reason. See
// `emitRefcountCheckToLastOwner`.
function buildMmRetain(module StdModule)
	var func = IrFunction.createFromStd(MmRetainName, returnType: StdReturnType.value(StdType.i64), paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry")
	emitParams(module, block: entry, count: 1)
	let ptr = 0 as ValueId

	emitAdjustRefcount(module, block: entry, ptr: ptr, opcode: StdBinOpcode.add, ids: ids)
	var out = emitMmIncrefEvent(module, func: func, block: entry, ptr: ptr, ids: ids)
	module.setTerminator(out, op: StdOp.ret(ptr))

	module.functions.push(func)
end 'buildMmRetain'

// The refcount word of the box `ptr` addresses — `[ptr - HeaderBytes + HeaderRefcountOffset]`. ONE of the
// two places the header geometry is spelled (the other is the store in `emitAdjustRefcount`), so nothing
// outside this file has to know a header exists.
function emitLoadRefcount(module StdModule, block IrBlock, ptr ValueId, ids ValueMinter) returns ValueId
	let header = emitHeaderBase(module, block: block, ptr: ptr, ids: ids)
	let rc = ids.mint()
	module.appendOp(block, op: StdOp.loadIndirect(rc, addrId: header, offset: HeaderRefcountOffset, valueType: StdType.i64))
	return rc
end 'emitLoadRefcount'

// `refcount <opcode>= 1` — one more owner (`add`) or one fewer (`sub`). The incref and the not-last-owner
// decref are the SAME four ops differing only in the opcode, so they are written once: a change to how the
// count is maintained cannot be applied to one direction and missed on the other. The header address is
// recomputed for the store rather than threaded out of `emitLoadRefcount`, which costs one `sub` and keeps
// the geometry from leaking into either caller.
function emitAdjustRefcount(module StdModule, block IrBlock, ptr ValueId, opcode StdBinOpcode, ids ValueMinter)
	let rc = emitLoadRefcount(module, block: block, ptr: ptr, ids: ids)
	let oneConst = ids.mint()
	module.appendOp(block, op: StdOp.const(oneConst, value: 1, valueType: StdType.i64))
	let adjusted = ids.mint()
	module.appendOp(block, op: StdOp.binOp(adjusted, lhs: rc, rhs: oneConst, opcode: opcode, operandType: StdType.i64))
	let header = emitHeaderBase(module, block: block, ptr: ptr, ids: ids)
	module.appendOp(block, op: StdOp.storeIndirect(header, offset: HeaderRefcountOffset, valueId: adjusted, valueType: StdType.i64))
end 'emitAdjustRefcount'

// ⭐ **DOES ANYONE BESIDES THIS OWNER HOLD `ptr`?** — ⭐ **THE ONE HOME OF THE `owners - 1` CONVENTION.**
// A box is born at refcount 0 meaning ONE owner (see `emitRefcountCheckToLastOwner` for why), so "shared"
// is `rc != 0` and "sole owner" is its negation. Both readers of that convention derive from HERE:
// `emitRefcountCheckToLastOwner` branches on it, and `ManagedMemoryRuntime.__managed_cow_detach` asks it of an array's
// element BUFFER to decide whether a view is reading the bytes it is about to write.
//
// ⚠ Those two live in different files, which is exactly why this is a function and not a comment: were the
// convention ever to change to a plain owner count, a `rc != 0` open-coded in the managed-memory runtime would go on
// compiling and start answering the opposite question — a shared buffer mutated in place, which is a wrong
// answer and a corruption, not an error anything reports.
//
// ⚠ The caller must already know `ptr` is a pointer `__mm_alloc` RETURNED. An INTERIOR pointer (a view's
// `buffer@0`) has no header, and the word this reads would be the previous element's data.
export function emitIsSharedAllocation(module StdModule, block IrBlock, ptr ValueId, ids ValueMinter) returns ValueId
	let rc = emitLoadRefcount(module, block: block, ptr: ptr, ids: ids)
	let zeroConst = ids.mint()
	module.appendOp(block, op: StdOp.const(zeroConst, value: 0, valueType: StdType.i64))
	let shared = ids.mint()
	module.appendOp(block, op: StdOp.cmp(shared, lhs: rc, rhs: zeroConst, pred: StdCmpPred.ne, operandType: StdType.i64))
	return shared
end 'emitIsSharedAllocation'

// **THE REFCOUNT READ-MODIFY-WRITE EVERY DECREF SHARES.** Ask `emitIsSharedAllocation` (which owns both
// the header geometry and what the count MEANS); when nobody else holds the box this is the FINAL owner
// and control branches to `lastOwner` — the caller's block, which reclaims whatever it must before the
// memory dies — otherwise the count is lowered by one and the box kept.
// It fills `entry` (the check) and `lower` (the not-last decrement), wiring `entry`'s conditional
// branch to the caller-supplied `lastOwner`/`lower`. The caller creates all three blocks so their
// order — and thus its own last-owner blocks — is its to choose.
//
// ⭐ ONE HOME FOR THE REFCOUNT PROTOCOL, so `__mm_decref` and `StringRuntime.__str_decref` cannot
// drift on what "the last owner" means. `__str_decref` needs that SAME answer but must read a
// detached String's `parent`/`buffer` out of the record BEFORE the record is reclaimed, so it cannot
// call `__mm_decref` at runtime — it shares this BUILDER instead, which is where the one fact lives.
//
// ⭐ THE REFCOUNT IS `owners - 1`, NOT `owners`, AND THAT IS WHY `__mm_alloc` WRITES NOTHING. A box
// is born at refcount 0 meaning ONE owner, so the overwhelmingly common case — allocate, use, drop
// — touches the refcount word exactly once, on the way out, and never on the way in. It is v1's
// model. The cost is that "is this the last owner?" reads `rc == 0` rather than `rc == 1`, which
// looks like an off-by-one every time it is read and is not one.
//
// ⚠ There is no underflow check. A decref below zero means the compiler emitted more drops than
// owners, which is an OWNERSHIP bug, not a runtime condition — and at this rung the parser is the
// only thing that emits a drop. The bootstrap panics here ("double-free"); shv2 gets the same
// signal for free from the leak counter going negative, which the exit check reads as nonzero.
//
// ⚠⚠ **NON-ATOMIC, DELIBERATELY, AND THIS COMMENT IS THE DECISION RATHER THAN ITS ABSENCE.** The
// bootstrap's refcount is `LOCK`-prefixed because it must be; shv2 is SINGLE-THREADED until **R3 @
// P1.5** brings green threads, and a plain `sub` is the whole cost until then. **THE DAY GREEN
// THREADS LAND, THIS — AND THE `__mm_incref` ABOVE — MUST BECOME `LOCK`-PREFIXED**:
// a shared box refcounted by two threads with a plain read-modify-write loses updates and frees a
// live object, which is a use-after-free that no test reproduces reliably. It is written here so
// that day is reached by READING rather than by a race. (PLAN.md's R1 box exists to stop inertia
// making this call quietly; this is the call, made out loud.)
//
// The note lives on THIS helper because it is now the ONE place the surviving refcount read-modify-
// write is: `__mm_decref` and `__str_decref` both route through it, so `LOCK`-prefixing it that day
// covers both, and a second RMW cannot hide from the note by living in its own function. `__mm_alloc`
// and `__mm_free` do the same unlocked RMW on `__mm_alloc_count`, and they become `LOCK`-prefixed on
// the same day for the same reason: a counter that loses an update reports a leak that did not
// happen, or hides one that did.
// ⚠ **THE `mm_decref` EVENT IS EMITTED HERE, IN `entry`, BEFORE THE BRANCH — ONCE, NOT ONCE PER ARM.**
// See `emitMmDecrefEvent` for the identity that makes one emission correct for both paths. Emitting it
// before the branch also means the caller's `lastOwner` block is untouched by this function, which every
// one of its nine callers relies on: they append their own reclaim ops into it.
//
// ⚠ `func` is needed only because the event SPLITS `entry` into new blocks; with `--debugstream` off it
// is unread and not one op is emitted.
export function emitRefcountCheckToLastOwner(module StdModule, func IrFunction, entry IrBlock, lower IrBlock, record ValueId, lastOwner IrBlock, ids ValueMinter)
	var cur = emitMmDecrefEvent(module, func: func, block: entry, ptr: record, ids: ids)

	// The test is `emitIsSharedAllocation` with its arms swapped, so "0 means one owner" is asserted in one
	// place and read here rather than restated. `lower` reloads the count instead of threading it out of
	// `entry`, which costs two ops on a path only a SHARED box takes — and under move-only ownership a
	// RECORD is never shared, so at this rung that path belongs to array element buffers under a view.
	let shared = emitIsSharedAllocation(module, block: cur, ptr: record, ids: ids)
	module.setTerminator(cur, op: StdOp.condBranch(shared, thenBlockId: lower.id, elseBlockId: lastOwner.id))

	emitAdjustRefcount(module, block: lower, ptr: record, opcode: StdBinOpcode.sub, ids: ids)
	module.setTerminator(lower, op: StdOp.retVoid)
end 'emitRefcountCheckToLastOwner'

// `__mm_decref(ptr)` — one fewer owner; free at the last. The refcount read-modify-write is the
// shared `emitRefcountCheckToLastOwner`; this function supplies only the LAST-OWNER path — reclaim
// the box.
function buildMmDecref(module StdModule)
	var func = IrFunction.createFromStd(MmDecrefName, returnType: StdReturnType.void, paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry")
	var release = module.addBlock(func, label: b"release")
	var lower = module.addBlock(func, label: b"lower")

	emitParams(module, block: entry, count: 1)
	let ptr = 0 as ValueId

	emitRefcountCheckToLastOwner(module, func: func, entry: entry, lower: lower, record: ptr, lastOwner: release, ids: ids)

	let freed = ids.mint()
	module.appendOp(release, op: StdOp.call(freed, callee: MmFreeName, args: argsOf(ptr)))
	module.setTerminator(release, op: StdOp.retVoid)

	module.functions.push(func)
end 'buildMmDecref'

// The byte written over every freed payload. `0x3F` is chosen for what it does when a
// use-after-free READS the dead memory it should not have: as a small integer it is a
// conspicuous 63 (never the 0 a correct freshly-zeroed slot would hold), and as a POINTER a word
// of it is `0x3F3F3F3F3F3F3F3F` — a non-canonical x64 address, so dereferencing it FAULTS rather
// than silently reads. Either way the bug becomes loud at the read instead of invisible.
let PoisonByte = 0x3F

// `__mm_free(ptr)` — the death of a box.
//
// It reclaims NOTHING, and that is the honest shape of a bump allocator rather than a gap: there is
// no free list for a slot to return to, so the memory stays where it is until the process exits.
// It does two observable things: drop the live count (which the leak gate reads), and **POISON the
// payload**.
//
// ⭐ **POISON-ON-FREE, ALWAYS ON (Workstream R / #108).** The bump allocator never reuses a slot, so
// freed memory keeps its bytes intact until the process exits — which means a use-after-free reads
// exactly the value it wrote before the free and is INVISIBLE to every test. Overwriting the payload
// with `PoisonByte` the instant it dies turns that whole class loud: a read-after-free now returns 63
// or faults on a poisoned pointer instead of the stale-but-correct bytes. This is deliberately not a
// flag — it is unconditional, so the class cannot hide in a build nobody thought to enable it for, and
// so the committed suite is a standing gate against it. **The size is in the header** (`__mm_alloc`
// stored it at `HeaderSizeOffset`), so the poisoned range is exactly `[ptr, ptr + size)` — the payload,
// not the header (a freed header is only ever consulted by double-free detection, which the count owns).
// ⚠ **It pairs with the zeroing contract, and the pairing is why it must land BEFORE a recycling free
// list:** today alloc always hands out fresh zeroed slab memory, so poison-on-free is never seen by a
// later alloc. The day `__mm_free` returns a slot to a free list, the reused slot must be re-zeroed on
// the way out of `__mm_alloc` (poison then zero), or the `[length, capacity)`-reads-zero invariant
// breaks. See PLAN.md #108.
//
// ⭐ THE DESTRUCTOR CASCADE ALSO LANDS HERE AT P1.2 (still deferred): the header carries the destructor
// (`__mm_alloc` stored it at `HeaderDestructorOffset`); loading it and calling it through `callIndirect`
// before the poison is the local change. It is NOT written now — every struct at this rung is trivially
// owned, so the pointer is always 0 and the call would be emitted-but-never-taken, the `mintPhi` failure
// exactly.
function buildMmFree(module StdModule)
	var func = IrFunction.createFromStd(MmFreeName, returnType: StdReturnType.void, paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var start = module.addBlock(func, label: b"entry")

	emitParams(module, block: start, count: 1)
	let ptr = 0 as ValueId

	// The `mm_free` event BEFORE the poison, so the trace reports the death of the box while its header is
	// still the one that identifies it. (The poison covers the payload only, but reporting a free after the
	// reclaim would say it in the wrong order for no gain.)
	var entry = emitMmFreeEvent(module, func: func, block: start, ptr: ptr, ids: ids)

	// Drop the live count — the one number the leak gate reads.
	let countAddr = ids.mint()
	module.appendOp(entry, op: StdOp.globalAddr(countAddr, label: MmAllocCountLabel))
	let count = ids.mint()
	module.appendOp(entry, op: StdOp.loadIndirect(count, addrId: countAddr, offset: 0, valueType: StdType.i64))
	let oneConst = ids.mint()
	module.appendOp(entry, op: StdOp.const(oneConst, value: 1, valueType: StdType.i64))
	let lowered = ids.mint()
	module.appendOp(entry, op: StdOp.binOp(lowered, lhs: count, rhs: oneConst, opcode: StdBinOpcode.sub, operandType: StdType.i64))
	module.appendOp(entry, op: StdOp.storeIndirect(countAddr, offset: 0, valueId: lowered, valueType: StdType.i64))

	// The payload size the alloc recorded in the header; the range to poison is exactly `[ptr, ptr + size)`.
	// The fill itself is the shared `emitFillRange` (the array capacity-slot zeroer is its other caller) — a
	// `size == 0` empty allocation poisons nothing.
	let header = emitHeaderBase(module, block: entry, ptr: ptr, ids: ids)
	let size = ids.mint()
	module.appendOp(entry, op: StdOp.loadIndirect(size, addrId: header, offset: HeaderSizeOffset, valueType: StdType.i64))
	var afterPoison = emitFillRange(module, func: func, cur: entry, dest: ptr, byteCount: size, fillValue: PoisonByte, ids: ids)
	module.setTerminator(afterPoison, op: StdOp.retVoid)

	module.functions.push(func)
end 'buildMmFree'

// ⭐⭐ **THE PER-UNION DESTRUCTOR CASCADE (P1.3 slice 2).** Synthesize `__destruct_<U>(box)` for every
// managed-payload union whose destructor is REFERENCED (`needed`, collected from the module's
// `__destruct_*` calls — install only what is used, exactly like the rest of the runtime). It is
// APPENDED already-lowered after the pipeline (like `installMmRuntime`), so it is never re-optimized.
//
// ⭐ **THE BIGGEST DIVERGENCE FROM v1**: v1's union drop is ONE polymorphic `mm_decref` that recurses
// through the payload's box-HEADER destructor. shv2 has NO header destructor (static dispatch) — so THIS
// function statically emits each managed field's OWN drop (`__str_decref` for a String, `__mm_decref`
// for a struct box), routed off the SAME classifier the construct's move-in reads. The tag switch drops
// only the LIVE case's managed fields; a moved-out slot is null and its null-guard skips it (so a match
// that bound a payload OUT does not double-free it here).
export function installUnionDestructors(module StdModule, project Project, signatures ProgramSignatures, needed DestructorSet)
	for (_, layout) in project.enumTypes 'each'
		if not unionHasManagedField(signatures, typeNames: project.typeNames, layout: layout) 'noManaged'
			continue
		end 'noManaged'
		if not needed.contains(destructorSymbol(layout.name)) 'notReferenced'
			continue
		end 'notReferenced'
		synthesizeUnionDestructor(module, layout: layout, project: project, signatures: signatures)
	end 'each'
end 'installUnionDestructors'

// ⭐ **NOTE WHAT THE REFERENCED DESTRUCTORS TRANSITIVELY NEED**, for both structs and unions — their
// `__str_decref`/`__mm_free`/nested-`__destruct_<T>` calls live in Std bodies the Maxon-module
// `scanRuntimeUsage` cannot see, so they are DECLARED here. Two obligations:
//
//   1. **Close the needed set over NESTING.** A `__destruct_<Outer>` whose field is a managed struct/union
//      calls that field's OWN `__destruct_<Inner>`, which the module never mentions by name — so an inner
//      destructor referenced ONLY through a cascade would never be synthesized. `closeDestructorNeeds`
//      walks the referenced destructors' managed fields to a fixpoint, adding each nested destructor.
//   2. **Turn on the transitive runtime bits.** Every destructor frees the box (`__mm_free` — heap), and
//      one whose type directly owns a `String` field calls `__str_decref`.
//
// Called after `scanRuntimeUsage`, before `.data` layout reads `usesHeap` and `installStringRuntime` reads
// `usesStrDecref` — so the closed set and the bits are settled before anything they gate is built.
//
// ⛔⛔ **IT USED TO OPEN BY ROOTING EVERY MANAGED OPAQUE-`T` `Array` ELEMENT DESTRUCTOR THE DESCRIPTOR
// RELOCS *MIGHT* BAKE, AND THAT PREDICTION IS GONE (W17-c).** It walked the whole instance registry and rooted
// on `genericInstanceHasManagedOpaqueArrayField` alone — unconditional over the instances, by its own header
// — which is a prediction of what LOWERING will emit, made before lowering. Listing the `String`/`Character`
// cone put four instances of `stdlib/helpers/itertools/withIterator.maxon` in every program's registry
// (`WithIterIterator_ByteIterator_Byte` and its three siblings, from the views' `Iterable with (…)`
// conformances), so `return 0 as ExitCode` rooted `__destruct_ByteIterator`, `__destruct_CodepointIterator`,
// `__destruct_UTF16Iterator` and `__destruct_StringIterator`, and the struct loop below turned the heap on for
// a program that allocates nothing — the five `static-variables/data-section-*` pins, reading their `var` 24
// bytes past its true offset.
//
// ⭐ **THE MEASURED SET REPLACES THE PREDICTED ONE, AND IT ALREADY EXISTED**: `noteRelocatedFunctionUsage`
// roots every `.rdata` slot's callee off `pendingRdataRelocs` AFTER lowering — *"the rooted set is the
// RELOCATED set, literally"* — and `ensureLayoutDescriptor`'s `destroyFunc@40` stamp is one of those slots
// (`LowerMaxonToStd:1650`, the very `managedOpaqueArrayElementDropCallee` the prediction named). So the two
// were one fact derived twice, one of them by guessing; the guess is what is deleted. Its clone twin
// (`ManagedMemoryRuntime.rootManagedOpaqueArrayElementClones`) went with it for the identical reason.
export function noteDestructorUsage(usage RuntimeUsage, project Project, signatures ProgramSignatures)
	closeDestructorNeeds(usage, project: project, signatures: signatures)
	declareDestructorCascadeNeeds(usage, project: project, signatures: signatures)
end 'noteDestructorUsage'

// Obligation 2 above — the transitive runtime bits every REFERENCED destructor's synthesized body needs —
// split out because it has TWO callers and must not be one of them's private tail. `noteRelocatedFunctionUsage`
// can put a `__destruct_<T>` in the set that no pre-pipeline walk saw, and a destructor whose `usesStrDecref`
// was never declared links against a `__str_decref` nothing installed.
//
// ⭐⭐ **EVERY BIT IS DERIVED FROM THE DROP CALLEE THE CASCADE WILL ACTUALLY EMIT, AND IT USED TO BE A
// HAND-WRITTEN LIST OF FIELD KINDS — WHICH IS THE SAME FACT WRITTEN TWICE, AND IT WAS WRONG IN ALL THREE ARMS
// AT ONCE.** The three arms asked `structHasStringField` / `structHasArrayField` /
// `unionHasManagedField(wantStringOnly: true)` / `genericInstanceHasStringField`: a fixed roster of the field
// kinds someone remembered, against a synthesis (`managedFieldDropCallee`) that routes SIX. A managed type
// whose drop has its own install bit — rather than one its own construction already turns on — therefore
// linked against nothing.
//
// ⚠ **`CharacterSet` WAS EXACTLY THAT TYPE, AND IT IS WHY THE DEFECT WAS OBSERVABLE (its runtime went at
// W129; the DEFECT class this states did not).** Its family had THREE
// bits (`usesCharSetMake`/`usesCharSetDecref`/`usesCharSetContains`), so `CharacterSet.whitespaces()` declared
// the MAKE and nothing else, and a set reached only through a cascade wanted a `__cs_decref` no install had
// been asked for. MEASURED on this tree at a struct field, at a union payload AND at a generic instance's
// substituted field — all three — `panic at X64Backend.maxon:2027: resolveCallFixups: call to unknown function
// '__cs_decref'`, with no diagnostic and no line. (`Set`/`Map`/`List`/`__ManagedFile`/`__ManagedDirectory`
// escaped only because each has ONE bit that constructing a value already sets; that is a property of their
// bit granularity, not of this walk, and it is not a property worth relying on.)
//
// ⇒ Each arm now walks its own managed fields, asks the SAME router the synthesis will ask, and hands the
// answer to `recordCallUsage` — the one callee-to-bit map, which also closes each family over what its own
// body calls. A drop callee this compiler can emit and this walk cannot account for is now unrepresentable
// rather than a list to remember to extend. It is also CHEAPER than what it replaces: the struct arm ran three
// full field walks (`structHasStringField`, `structHasArrayField`, `structHasExistentialField`) and now runs
// one.
//
// ⚠ **IT IS SAFE TO CALL `recordCallUsage` HERE, AND ONLY HERE, BECAUSE `closeDestructorNeeds` HAS ALREADY
// RUN.** That map INSERTS a `__destruct_<T>` callee into `neededDestructors` without queueing the cascade node
// that closes it over its own nesting — harmless once the closure is at its fixpoint (every such callee is
// already in the set, so the insert is a no-op), and a silently truncated closure if it ever ran first. Both
// callers order the two that way; a third must too.
function declareDestructorCascadeNeeds(usage RuntimeUsage, project Project, signatures ProgramSignatures)
	for (_, layout) in project.structTypes 'eachStruct'
		if usage.neededDestructors.contains(destructorSymbol(layout.name)) 'referenced'
			usage.usesHeap = true
			declareStructFieldDropNeeds(usage, layout: layout, project: project, signatures: signatures)
		end 'referenced'
	end 'eachStruct'

	for (_, layout) in project.enumTypes 'eachUnion'
		if usage.neededDestructors.contains(destructorSymbol(layout.name)) 'referenced'
			usage.usesHeap = true
			declareUnionPayloadDropNeeds(usage, layout: layout, project: project, signatures: signatures)
		end 'referenced'
	end 'eachUnion'

	// A REFERENCED managed generic instance's `__destruct_<mangled>` (P1.6-B2) frees its box (`__mm_free` —
	// heap) and calls each substituted field's own drop, both inside the synthesized body the Maxon scan cannot
	// see. A managed value inside a nested struct/instance field is dropped by that nested destructor, so only
	// a DIRECT substituted field is accounted for here.
	// ⚠ The walk below must be safe to ask of ANY instance, builtin included — see
	// `declareInstanceFieldDropNeeds`, which carries the no-layout guard. `neededDestructors` is keyed by
	// SYMBOL NAME, and a declared `type Array_Foo` used to claim the very name `Array with Foo` mangles to;
	// P1.7 mints that instance as `__Array_Foo` instead (`reservedIfDeclared`), so the two can no longer
	// meet. The guard is the walk's structural precondition regardless of which route reaches it.
	for id in 0 upto signatures.genericInstanceCount() 'eachInstance'
		if usage.neededDestructors.contains(destructorSymbol(signatures.mangleGenericInstance(id))) 'referenced'
			usage.usesHeap = true
			declareInstanceFieldDropNeeds(usage, id: id, signatures: signatures)
		end 'referenced'
	end 'eachInstance'
end 'declareDestructorCascadeNeeds'

// The struct arm's field walk — `addNestedStructDestructors`' bit-declaring dual, and deliberately its
// mirror image field for field: that one collects the nested SYMBOLS a cascade names, this one declares the
// runtime BITS the same callees need. Both ask `managedStructFieldDropCallee`, so the callee a field is
// accounted for under and the callee it is dropped through are one answer.
function declareStructFieldDropNeeds(usage RuntimeUsage, layout StructLayout, project Project, signatures ProgramSignatures)
	for i in 0 upto layout.fieldCount() 'eachField'
		if not signatures.structFieldIsManaged(layout.name, index: i) 'scalar'
			continue
		end 'scalar'
		// ⭐ **AN EXISTENTIAL FIELD NAMES NO CALLEE, so it is the one kind that cannot be derived and is
		// declared directly** (P1.7a-existentials slice 2). Its drop is `__drop_existential(witness, value)`,
		// read out of the witness table at run time, which `managedFieldDropCallee` refuses to answer for at
		// all — the same arm `addNestedStructDestructors` skips for the same reason, one question over.
		if signatures.structFieldIsExistential(layout.name, index: i) 'existential'
			usage.usesDropExistential = true
			continue
		end 'existential'
		recordCallUsage(managedStructFieldDropCallee(layout, index: i, project: project, signatures: signatures), usage: usage)
	end 'eachField'
end 'declareStructFieldDropNeeds'

// The union twin — `addNestedUnionDestructors`' bit-declaring dual, over the same payload classifier.
function declareUnionPayloadDropNeeds(usage RuntimeUsage, layout EnumLayout, project Project, signatures ProgramSignatures)
	for ci in 0 upto layout.caseCount() 'eachCase'
		let payloads = layout.payloadsAt(ci)
		for fi in 0 upto payloads.count() 'eachField'
			let field = try payloads.get(fi) otherwise panic("declareUnionPayloadDropNeeds: payloadsAt count disagrees with get at {fi}")
			let class = classifyUnionPayload(signatures, typeNames: project.typeNames, fieldType: field.declaredType, slotScopeFilePath: layout.declFilePath)
			if not payloadClassIsManaged(class) 'scalar'
				continue
			end 'scalar'
			recordCallUsage(managedFieldDropCallee(signatures, typeNames: project.typeNames, fieldType: field.declaredType), usage: usage)
		end 'eachField'
	end 'eachCase'
end 'declareUnionPayloadDropNeeds'

// The instance twin — `addNestedInstanceDestructors`' bit-declaring dual, carrying that walk's own
// precondition: a layout-less instance (`Array`/`Set` and every undeclared base) synthesizes no cascade, and
// the field walk reads a base struct it does not have. See `genericInstanceHasBaseLayout` for why the
// early-out and the emptiness are one gate.
function declareInstanceFieldDropNeeds(usage RuntimeUsage, id GenericInstanceId, signatures ProgramSignatures)
	if not signatures.genericInstanceHasBaseLayout(id) 'noSynthesizedCascade'
		return
	end 'noSynthesizedCascade'

	for i in 0 upto signatures.genericInstanceFieldCount(id) 'eachField'
		if not signatures.genericInstanceFieldIsManaged(id, index: i) 'scalar'
			continue
		end 'scalar'
		// The base struct's OWN interface-typed field survives substitution into the instance's cascade
		// (`instanceFieldDropKind`) — `declareStructFieldDropNeeds`' arm, for its reason.
		if signatures.genericInstanceFieldIsExistential(id, index: i) 'existential'
			usage.usesDropExistential = true
			continue
		end 'existential'
		recordCallUsage(signatures.genericInstanceFieldDropCallee(id, index: i), usage: usage)
	end 'eachField'
end 'declareInstanceFieldDropNeeds'

// ⭐⭐ **ROOT EVERY FUNCTION AN `.rdata` SLOT NAMES, AFTER LOWERING HAS FILLED THEM (P1.7a-existentials
// slice 2).** A witness table's `destroyFunc@8` and its method slots, and a layout descriptor's
// `destroyFunc@40`/`copyFunc@32`, are reached through DATA rather than through code: `__drop_existential`
// loads the word out of `.rdata` at run time and `callIndirect`s it, so nothing the module's call graph can
// see names it. The writer will bake a `.text` VA for every one of them, so every one must be INSTALLED.
//
// ⭐ **THE ROOTED SET IS THE RELOCATED SET, LITERALLY — read off the relocations rather than re-derived from
// the declarations that produced them.** It is had by CONSTRUCTION here, which matters because WHICH
// `(conformer, interface)` pairs get a table — and which instances get a layout descriptor — is decided
// during LOWERING, and no pre-pipeline walk can know it. That is why the two pre-pipeline PREDICTIONS of the
// descriptor's own `destroyFunc@40`/`copyFunc@32` targets are deleted (W17-c) rather than kept beside this:
// they asked the same question of the declarations and answered it for instances no program reaches. The first attempt rooted every DECLARED conformance instead, and every program has the stdlib's
// (`FilePath` and `URL` conform, reachable or not) — so `var flag = true` grew the three `__slab_*` `.data`
// globals and five `static-variables/data-section-*` cases read their bool 24 bytes off its true offset.
//
// ⚠ **IT MUST RUN AFTER THE PIPELINE AND BEFORE THE INSTALLS, AND THE ONE THING IT CANNOT REACH IS THE
// `.data` LAYOUT** (`globalData.layOut`, which reads `usesHeap` before lowering). That is sound rather than
// lucky: every callee an `.rdata` slot can name releases a HEAP record — a `__destruct_<T>`, `__mm_decref`,
// `__str_decref`, `__managed_decref` — so the program that named it allocated one, and `usesHeap` was already
// true when the layout was taken. The gate below says so rather than trusting it.
//
// Every name goes through `recordCallUsage`, the ONE callee→bit map, so each rooted symbol declares its own
// transitive floor exactly as a direct call to it would; `closeDestructorNeeds` then closes the cascades
// over their nesting, which is why this is the whole of `noteRelocatedFunctionUsage` and not a second copy of
// that closure. A slot naming a USER method (`Point.tag`) sets no bit — it is `.text` the DFE roots
// separately — and costs one prefix test.
//
// ⭐⭐ **THE CLOSURE IS RE-ENTERED ONLY IF THIS WALK ACTUALLY PUT A NEW DESTRUCTOR SYMBOL IN THE SET, AND
// UNGATED IT WAS THIS RUNG'S WHOLE SUPERLINEAR COST.** `noteDestructorUsage` has already run
// `closeDestructorNeeds` to a FIXPOINT, and that closure derives from exactly one input: the seed set. So a
// second run over an unchanged seed set re-expands the identical nodes, re-derives the identical symbols and
// re-sets bits that are already set — the definition of a no-op, at the price of the whole closure.
//
// ⚠ **THE PRICE IS NOT LINEAR, WHICH IS WHY A REDUNDANT RUN MATTERED.** One expansion of the drain costs
// `genericInstanceCount()` allocations (MEASURED on the scale ladder, exactly: 23 / 59 / 203 / 395 per
// expanded node at rungs 0 / 2 / 4 / 5, against instance registries of 23 / 59 / 203 / 395), so the closure
// as a whole is O(referenced cascades x instances) — QUADRATIC in program size. Ungated, this line cost
// +1,458 / +5,406 / +47,084 / +167,161 allocations at those rungs, which was 98% of everything the rung
// added. The quadratic itself is OLDER than this call site and is reported as measured debt; what belongs
// here is not paying it twice for nothing.
//
// The COUNT is the whole test because `neededDestructors` is insert-only: unchanged count ⟺ unchanged set.
// A reloc that names a `__destruct_<T>` — the case this function exists for, a witness table's
// `destroyFunc@8` pointing at a conformer's cascade — grows it and the closure runs exactly as before.
export function noteRelocatedFunctionUsage(usage RuntimeUsage, project Project, signatures ProgramSignatures)
	let heapBefore = usage.usesHeap
	let destructorsBefore = usage.neededDestructors.count()
	let clonersBefore = usage.neededCloners.count()
	for reloc in project.globalData.pendingRdataRelocs 'eachRdataSlot'
		recordCallUsage(reloc.funcName, usage: usage)
	end 'eachRdataSlot'

	// ⭐⭐ **BOTH CASCADES ARE RE-CLOSED, NOT JUST THE DROP ONE, AND THAT IS WHAT LETS THE TWO PRE-PIPELINE
	// PREDICTIONS BE DELETED (W17-c).** A layout descriptor stamps `destroyFunc@40` AND `copyFunc@32`
	// (`LowerMaxonToStd:1650`/`:1664`), so a reloc can be the FIRST mention of either a `__destruct_<T>` or a
	// `__clone_<T>` — and a cascade left unclosed is an inner destructor/cloner nothing synthesizes, plus a
	// `usesStrDecref`/`usesStrClone` nothing declares. Both closures are gated on their OWN set having grown,
	// for the superlinear reason below; both installers run after this call, so a set grown here is still in
	// time to be built.
	if usage.neededDestructors.count() > destructorsBefore 'newDropCascades'
		closeDestructorNeeds(usage, project: project, signatures: signatures)
		declareDestructorCascadeNeeds(usage, project: project, signatures: signatures)
	end 'newDropCascades'

	if usage.neededCloners.count() > clonersBefore 'newCloneCascades'
		noteClonerUsage(usage, project: project, signatures: signatures)
	end 'newCloneCascades'

	// ⚠ **CHECKED LAST, BECAUSE THE TWO CLOSURES ABOVE ALSO SET THE BIT** — a referenced struct destructor
	// and a referenced cloner each declare the heap. Checking it against the reloc loop alone would leave
	// exactly the case this gate exists for unguarded.
	if usage.usesHeap and not heapBefore 'heapArrivedTooLate'
		panic("noteRelocatedFunctionUsage: an `.rdata` slot named a heap callee in a program whose `.data` layout was taken with `usesHeap` false — the runtime globals are laid out before lowering, so the layout is now short by their width. Every relocatable callee releases a heap record, so the program that named one must already have allocated one: a new relocation kind has broken that premise")
	end 'heapArrivedTooLate'
end 'noteRelocatedFunctionUsage'

// Grow `usage.neededDestructors` to a fixpoint over destructor NESTING: for every referenced managed
// struct/union/instance destructor, add the `__destruct_<T>` of each managed field that itself owns managed
// heap (a nested struct/union/instance), because that nested destructor is CALLED by the cascade but named
// nowhere the module scan can see. So `Box with (Box with String)`, reached only through the outer cascade,
// still gets the inner instance destructor synthesized.
//
// ⭐ Driven by the SHARED `CascadeWorklist` (`CascadeNeeds.maxon`) — the same engine that closes the CLONE
// dual (`noteClonerUsage`, in this file). Both used to be a `while changed` RE-SCAN of every declared type,
// which is one quadratic written down twice: a cascade chain of depth D cost D passes over all T types and
// re-minted every type's `__destruct_` symbol on each. Registration walks the node space ONCE, the drain
// expands each referenced node exactly once, and the loop no longer needs a growth flag at all — the queue
// IS the growth signal. See that file for why the graph is demand-driven rather than built up front.
function closeDestructorNeeds(usage RuntimeUsage, project Project, signatures ProgramSignatures)
	// A program that drops no managed type has an EMPTY needed set, and a monotone closure over an empty
	// seed set can only stay empty — nothing derives a nested destructor from no destructor. Early-out then,
	// so registering the node space (a `destructorSymbol` per declared type and a `mangleGenericInstance` per
	// instance) is paid only by a program that actually drops something. This is the same early-out, for the
	// same reason, that the CLONE dual `noteClonerUsage` has always had; the drop side simply never had it,
	// and so re-minted every type's symbol twice on every compile that dropped nothing at all.
	if usage.neededDestructors.count() == 0 'noDestructors'
		return
	end 'noDestructors'

	var work = CascadeWorklist.create()

	for (_, layout) in project.structTypes 'eachStruct'
		work.register(destructorSymbol(layout.name), node: CascadeNode.declaredStruct(layout))
	end 'eachStruct'

	for (_, layout) in project.enumTypes 'eachUnion'
		work.register(destructorSymbol(layout.name), node: CascadeNode.declaredUnion(layout))
	end 'eachUnion'

	// ⚠ A node is keyed by its SYMBOL, and whatever wins a key must be safe to EXPAND — see
	// `addNestedInstanceDestructors`. A declared `type Array_Foo` used to register under the very name an
	// `Array with Foo` instance mangles to, so the two competed for one key; P1.7's reserved-space
	// disjointness (`reservedIfDeclared`) means a declaration and an instance can no longer produce one
	// symbol, and only two INSTANCES can — which is E3006 and fails the build before this runs.
	for id in 0 upto signatures.genericInstanceCount() 'eachInstance'
		work.register(destructorSymbol(signatures.mangleGenericInstance(id)), node: CascadeNode.genericInstance(id))
	end 'eachInstance'

	work.seed(usage.neededDestructors)

	while work.hasPending() 'drain'
		let node = work.take()
		match node 'node'
			declaredStruct(layout) then addNestedStructDestructors(usage, layout: layout, project: project, signatures: signatures, work: work)
			declaredUnion(layout) then addNestedUnionDestructors(usage, layout: layout, project: project, signatures: signatures, work: work)
			genericInstance(id) then addNestedInstanceDestructors(usage, id: id, signatures: signatures, work: work)
		end 'node'
	end 'drain'
end 'closeDestructorNeeds'

// The drop callee for MANAGED field `index` of PROJECT struct `layout` — its field-type id read off the
// project layout and resolved against `project.typeNames`, the ONE interner that layout's ids live in. SOLE
// home of that pairing: both the needs closure (`addNestedStructDestructors`) and the body synthesis
// (`synthesizeStructDestructor`) route through here, so neither can drift back to re-fetching a `signatures`
// layout and misresolving its id against `project.typeNames` — the OPEN #56 mismatch (a panic when the misread
// name was no declared type, a WRONG destructor when it happened to be one), now unrepresentable rather than
// re-asserted by a comment at each site. Precondition: the caller checked `structFieldIsManaged`.
function managedStructFieldDropCallee(layout StructLayout, index FieldIndex, project Project, signatures ProgramSignatures) returns ByteArray
	let fieldType = try layout.fieldTypes.get(index) otherwise panic("managedStructFieldDropCallee: fieldTypes.get OOB at {index}")
	return managedFieldDropCallee(signatures, typeNames: project.typeNames, fieldType: fieldType)
end 'managedStructFieldDropCallee'

// Add the nested `__destruct_<T>` of each managed field of struct `layout` to the needed set, queueing each
// newly-needed cascade on `work` so its OWN nesting is closed in turn. A field whose drop callee is a
// destructor symbol (a managed struct/union) contributes its symbol; a String (`__str_decref`) or scalar-only
// box (`__mm_decref`) contributes none.
function addNestedStructDestructors(usage RuntimeUsage, layout StructLayout, project Project, signatures ProgramSignatures, work CascadeWorklist)
	for i in 0 upto layout.fieldCount() 'eachField'
		if not signatures.structFieldIsManaged(layout.name, index: i) 'scalar'
			continue
		end 'scalar'
		// ⭐ **AN EXISTENTIAL FIELD CONTRIBUTES NO *NESTED* SYMBOL, BECAUSE IT NAMES NONE (P1.7a-existentials
		// slice 2).** Its drop is `__drop_existential`, which reads the destructor out of the witness table at
		// run time — so there is no callee here to close the set over. The destructors those tables can name
		// are rooted from the RELOCATIONS instead (`noteRelocatedFunctionUsage`), which re-enters this closure
		// afterwards, so a conformer that owns a managed field still gets its own cascade expanded.
		if signatures.structFieldIsExistential(layout.name, index: i) 'existential'
			continue
		end 'existential'
		insertIfDestructorSymbol(usage, callee: managedStructFieldDropCallee(layout, index: i, project: project, signatures: signatures), work: work)
	end 'eachField'
end 'addNestedStructDestructors'

// The union twin of `addNestedStructDestructors` — add each managed payload field's nested destructor.
function addNestedUnionDestructors(usage RuntimeUsage, layout EnumLayout, project Project, signatures ProgramSignatures, work CascadeWorklist)
	for ci in 0 upto layout.caseCount() 'eachCase'
		let payloads = layout.payloadsAt(ci)
		for fi in 0 upto payloads.count() 'eachField'
			let field = try payloads.get(fi) otherwise panic("addNestedUnionDestructors: payloadsAt count disagrees with get at {fi}")
			let class = classifyUnionPayload(signatures, typeNames: project.typeNames, fieldType: field.declaredType, slotScopeFilePath: layout.declFilePath)
			if not payloadClassIsManaged(class) 'scalar'
				continue
			end 'scalar'
			insertIfDestructorSymbol(usage, callee: managedFieldDropCallee(signatures, typeNames: project.typeNames, fieldType: field.declaredType), work: work)
		end 'eachField'
	end 'eachCase'
end 'addNestedUnionDestructors'

// The instance twin of `addNestedStructDestructors` (P1.6-B2) — add the nested `__destruct_<T>` of each
// managed SUBSTITUTED field of instance `id` (a nested struct/union/instance) to the needed set. A String
// field's `__str_decref` and a trivial box's `__mm_decref` are leaf drops and add nothing. No `project`:
// every fact is answered inside `signatures`, over its own interner.
function addNestedInstanceDestructors(usage RuntimeUsage, id GenericInstanceId, signatures ProgramSignatures, work CascadeWorklist)
	// ⚠ One of the three sites needing the no-layout early-out — `genericInstanceHasManagedField` and this
	// walk's own bit-declaring dual `declareInstanceFieldDropNeeds` are the others: a node is expanded as soon
	// as its SYMBOL is needed, and the field walk below reads a base struct a layout-less instance does not
	// have. Measured before the guard existed: `panic ProgramSignatures.baseLayoutOf`, no diagnostic. (The
	// route that reached it — a declared `type Array_Foo` expanding the base-less `Array with Foo` node
	// registered under the identical string — is closed by P1.7's `reservedIfDeclared`; the guard is the
	// walk's precondition either way.)
	//
	// Nothing is lost by returning: an `Array`/`Set` instance synthesizes no cascade for its nesting to
	// close over — its elements are dropped by `__managed_decref`, whose own element destructor is
	// rooted by the descriptor reloc that names it (`noteRelocatedFunctionUsage`) — and an UNDECLARED base has no fields to
	// nest through at all. See `ProgramSignatures.genericInstanceHasBaseLayout` for why those are one gate.
	if not signatures.genericInstanceHasBaseLayout(id) 'noSynthesizedCascade'
		return
	end 'noSynthesizedCascade'

	for i in 0 upto signatures.genericInstanceFieldCount(id) 'eachField'
		if not signatures.genericInstanceFieldIsManaged(id, index: i) 'scalar'
			continue
		end 'scalar'
		// An existential field names no nested symbol — `addNestedStructDestructors`' arm, for its reason.
		if signatures.genericInstanceFieldIsExistential(id, index: i) 'existential'
			continue
		end 'existential'
		insertIfDestructorSymbol(usage, callee: signatures.genericInstanceFieldDropCallee(id, index: i), work: work)
	end 'eachField'
end 'addNestedInstanceDestructors'

// Insert `callee` into the needed set iff it is a `__destruct_<T>` symbol not already present, and — only
// when it is NEWLY added — announce it to `work`, whose job is to find the declaration that symbol names and
// queue that declaration's own nested cascades. Announcing exactly on the newly-added edge is what makes the
// closure O(types + fields): a symbol can be new only once, so a node is queued at most once. A
// `__str_decref`/`__mm_decref` callee (a leaf drop) is not a destructor and is left out — only synthesized
// cascades are collected here.
function insertIfDestructorSymbol(usage RuntimeUsage, callee ByteArray, work CascadeWorklist)
	if not bytesStartWith(callee, prefix: DestructorPrefix) 'notDestructor'
		return
	end 'notDestructor'
	if usage.neededDestructors.contains(callee) 'present'
		return
	end 'present'
	usage.neededDestructors.insert(callee)
	work.discovered(callee)
end 'insertIfDestructorSymbol'

// Emit `__destruct_<U>(box)`:
//
//   entry + lower: the shared refcount RMW (`emitRefcountCheckToLastOwner`) — `rc == 0` is the last
//     owner and branches to `drop`; otherwise the count is lowered and the box kept.
//   drop:  load the tag, then a per-managed-case guard chain (`if tag == c_i` → drop c_i's fields).
//          A scalar/payload-free case is not in the chain — its tag falls through to `free`.
//   case:  drop each managed field behind a NULL-guard, then fall to `free`.
//   free:  `__mm_free(box)`; ret.
//
// A void `(i64) -> void` signature — the X64 backend discards nothing, and there is no `call_indirect`
// type tag to satisfy (static dispatch), so it needs no `i64` return the way v1's header destructor did.
function synthesizeUnionDestructor(module StdModule, layout EnumLayout, project Project, signatures ProgramSignatures)
	let func = IrFunction.createFromStd(destructorSymbol(layout.name), returnType: StdReturnType.void, paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry")
	var lower = module.addBlock(func, label: b"lower")
	var drop = module.addBlock(func, label: b"drop")
	var free = module.addBlock(func, label: b"free")

	emitParams(module, block: entry, count: 1)
	let box = 0 as ValueId

	emitRefcountCheckToLastOwner(module, func: func, entry: entry, lower: lower, record: box, lastOwner: drop, ids: ids)

	let tag = ids.mint()
	module.appendOp(drop, op: StdOp.loadIndirect(tag, addrId: box, offset: UnionTagOffset, valueType: StdType.i64))

	var cur = drop
	for ci in 0 upto layout.caseCount() 'eachCase'
		if not caseHasManagedField(signatures, typeNames: project.typeNames, layout: layout, ci: ci) 'scalarCase'
			continue
		end 'scalarCase'
		let caseBlock = module.addBlock(func, label: b"case")
		let nextTest = module.addBlock(func, label: b"casetest")
		let tagConst = ids.mint()
		module.appendOp(cur, op: StdOp.const(tagConst, value: layout.tagOfIndex(ci), valueType: StdType.i64))
		let isCase = ids.mint()
		module.appendOp(cur, op: StdOp.cmp(isCase, lhs: tag, rhs: tagConst, pred: StdCmpPred.eq, operandType: StdType.i64))
		module.setTerminator(cur, op: StdOp.condBranch(isCase, thenBlockId: caseBlock.id, elseBlockId: nextTest.id))
		emitManagedFieldDrops(module, startBlock: caseBlock, box: box, layout: layout, ci: ci, dest: free, project: project, signatures: signatures, ids: ids, func: func)
		cur = nextTest
	end 'eachCase'

	// The final else — a scalar / payload-free case's tag matched no managed case — falls to the free.
	module.setTerminator(cur, op: StdOp.branch(free.id))

	let freed = ids.mint()
	module.appendOp(free, op: StdOp.call(freed, callee: MmFreeName, args: argsOf(box)))
	module.setTerminator(free, op: StdOp.retVoid)

	module.functions.push(func)
end 'synthesizeUnionDestructor'

// ⭐⭐ **THE PER-STRUCT DESTRUCTOR CASCADE (P1.4a wave 2).** The struct twin of `installUnionDestructors`:
// synthesize `__destruct_<Struct>(box)` for every struct that owns a managed field and whose destructor is
// REFERENCED. Appended already-lowered after the pipeline, like the union one, so it is never re-optimized.
// A struct has NO tag — every field is always present — so the cascade drops each managed field
// unconditionally (behind a null-guard) rather than under a tag switch.
export function installStructDestructors(module StdModule, project Project, signatures ProgramSignatures, needed DestructorSet)
	for (_, layout) in project.structTypes 'each'
		installOneStructDestructor(module, layout: layout, project: project, signatures: signatures, needed: needed)
	end 'each'

	// ⭐⭐ **THE TUPLES, FROM THE INDEX — BECAUSE THE PROJECT REGISTRY NEVER RECEIVES A SUBSTITUTED ONE
	// (W41).** `project.structTypes` is fed by `ParseStaging.commitStructTypes`, which copies each FILE
	// ARTIFACT's own layouts, so it holds every tuple the source SPELLS and no tuple minted by SUBSTITUTION —
	// `ProgramSignatures.substituteTupleThroughInstance` creates those at a CALL SITE, straight into the
	// whole-program index. The parser emits the drop call either way, so the missing body is a BACKEND panic
	// rather than a leak: **MEASURED, with the corpus `Map` live, `for (_, value) in m` over `["a": 10]` walks
	// `MapIterator.current()`, whose declared `Entry = (Key, Value)` substitutes to `__Tuple2.String.int`, and
	// the compile stops at `resolveCallFixups: call to unknown function '__destruct___Tuple2.String.int'`.** A
	// plain `function pair() returns (String, Num)` in the same tree compiles and runs, which is what
	// localizes it to the substituted mint rather than to tuples.
	//
	// ⛔⛔ **A NAME THE PROJECT REGISTRY ALREADY HOLDS IS SKIPPED, AND LETTING THIS WALK OWN ALL TUPLES
	// INSTEAD WAS A MEASURED REGRESSION (22 failures against 14).** The two registries are NOT two views of
	// one table for a tuple: a sweep key is `(spelling, file)` and only a CANONICAL name is a whole-program
	// identity, so the index can hold a layout whose elements were resolved in a different file's scope from
	// the one `commitStructTypes` committed — see `ProgramSignatures`' A3v header, which records the wrong
	// answer that shape already produced once. The project's entry is the authoritative resolved one wherever
	// it exists; this walk supplies only what nothing committed.
	//
	// ⚠ **GATED ON ANY DESTRUCTOR BEING NEEDED AT ALL**, so a program that drops nothing does not walk the
	// type registry to discover it needs nothing — `closeDestructorNeeds`' early-out, on the same set and for
	// the same reason.
	if needed.count() == 0 'nothingDrops'
		return
	end 'nothingDrops'

	for layout in signatures.tupleLayouts() 'eachInternedTuple'
		if projectHasStructLayout(project, name: layout.name) 'committedAlready'
			continue
		end 'committedAlready'
		installOneStructDestructor(module, layout: layout, project: project, signatures: signatures, needed: needed)
	end 'eachInternedTuple'
end 'installStructDestructors'

// Has `ParseStaging.commitStructTypes` already committed a layout under this name? The membership half of
// the skip above, spelled as its own question because "the project registry is authoritative where it has an
// entry" is the rule, and a `try … otherwise false` inline would read as a lookup that happened to fail.
function projectHasStructLayout(project Project, name ByteArray) returns bool
	if let committed = try project.structTypes.get(name) 'found'
		return not committed.name.isEmpty()
	end 'found'

	return false
end 'projectHasStructLayout'

// One layout's cascade, or nothing when it is unreferenced or owns nothing droppable. Split out when the
// substituted-tuple walk landed (W41) so the two walks share one admission test rather than each spelling
// it — the shape where one of them comes to admit a layout the other would have declined.
function installOneStructDestructor(module StdModule, layout StructLayout, project Project, signatures ProgramSignatures, needed DestructorSet)
	if not signatures.structHasManagedField(layout.name) 'noManaged'
		return
	end 'noManaged'

	if not needed.contains(destructorSymbol(layout.name)) 'notReferenced'
		return
	end 'notReferenced'

	synthesizeStructDestructor(module, layout: layout, project: project, signatures: signatures)
end 'installOneStructDestructor'

// Emit `__destruct_<Struct>(box)` — the field list is built here and the entry/lower/drop/free skeleton
// runs in the shared `emitFieldCascadeDestructor`:
//
//   drop:  drop each managed field, in declaration order, behind a NULL-guard (a moved-out field slot is
//          null), each through `managedFieldDropCallee`.
//
// A struct has NO tag — every field is always present — so the cascade drops unconditionally rather than
// under a tag switch. It shares its skeleton with the generic-instance cascade (P1.6-B2), which is the same
// tagless box shape over a substituted field list.
function synthesizeStructDestructor(module StdModule, layout StructLayout, project Project, signatures ProgramSignatures)
	var drops = ManagedFieldDropArray.create()
	for i in 0 upto layout.fieldCount() 'eachField'
		if not signatures.structFieldIsManaged(layout.name, index: i) 'scalarField'
			continue
		end 'scalarField'
		drops.push(ManagedFieldDrop.create(layout.offsetOfField(i), kind: structFieldDropKind(layout, index: i, project: project, signatures: signatures)))
	end 'eachField'
	emitFieldCascadeDestructor(module, symbolName: destructorSymbol(layout.name), drops: drops)
end 'synthesizeStructDestructor'

// HOW struct field `index` is released — the `existential` kind for an interface-typed field
// (P1.7a-existentials slice 2), the statically resolved callee for every other. It is asked HERE, off the
// declared type, because the alternative is `managedFieldDropCallee` inventing a 1-argument callee for a
// slot whose destructor is a run-time fact; that function's own `interfaceRef` guard says so from the other
// side.
function structFieldDropKind(layout StructLayout, index FieldIndex, project Project, signatures ProgramSignatures) returns FieldDropKind
	if signatures.structFieldIsExistential(layout.name, index: index) 'fatPointer'
		return FieldDropKind.existential
	end 'fatPointer'
	return FieldDropKind.direct(managedStructFieldDropCallee(layout, index: index, project: project, signatures: signatures))
end 'structFieldDropKind'

// ⭐⭐ **THE PER-INSTANCE DESTRUCTOR CASCADE (P1.6-B2).** A generic instance is a monomorphized base struct
// that OWNS its managed type arguments (moved in at the concrete call site), so `__destruct_<mangled>` drops
// each SUBSTITUTED managed field then frees the box — `Box with String` drops the String, `Box with Holder`
// drops the Holder (through its own `__destruct_Holder`), `Box with (Box with String)` drops the inner box
// (through ITS instance destructor, which drops the String). The base struct's own `__destruct_Box` is NOT
// what a managed instance uses: `Box`'s shared body compiles once against opaque `T` (a borrow, dropping
// nothing), so a per-instance cascade is what makes the type-arg drop concrete. Installed for a REFERENCED
// managed instance only (like the struct/union cascades), appended already-lowered so it is never
// re-optimized. No `project` needed — the instance's every fact is answered inside `signatures`.
function synthesizeGenericInstanceDestructor(module StdModule, id GenericInstanceId, signatures ProgramSignatures)
	var drops = ManagedFieldDropArray.create()
	for i in 0 upto signatures.genericInstanceFieldCount(id) 'eachField'
		if not signatures.genericInstanceFieldIsManaged(id, index: i) 'scalarField'
			continue
		end 'scalarField'
		drops.push(ManagedFieldDrop.create(signatures.genericInstanceFieldOffset(id, index: i), kind: instanceFieldDropKind(signatures, id: id, index: i)))
	end 'eachField'
	emitFieldCascadeDestructor(module, symbolName: destructorSymbol(signatures.mangleGenericInstance(id)), drops: drops)
end 'synthesizeGenericInstanceDestructor'

// HOW substituted instance field `index` is released — `structFieldDropKind`'s instance twin, asked over the
// SUBSTITUTED type for the reason `genericInstanceFieldDropCallee` is: the two must classify one type.
//
// ⚠ It is not a formality that a type ARGUMENT can never be an existential (`checkGenericArgType` refuses
// one): the base struct's OWN interface-typed field — `type Box uses T` declaring a `var tag as Tagged`
// beside its `T` — is in this list too, and substitution leaves it exactly as declared.
function instanceFieldDropKind(signatures ProgramSignatures, id GenericInstanceId, index FieldIndex) returns FieldDropKind
	if signatures.genericInstanceFieldIsExistential(id, index: index) 'fatPointer'
		return FieldDropKind.existential
	end 'fatPointer'
	return FieldDropKind.direct(signatures.genericInstanceFieldDropCallee(id, index: index))
end 'instanceFieldDropKind'

// ⭐ **THE PER-INSTANCE DESTRUCTOR INSTALLER (P1.6-B2)** — the generic-instance twin of
// `installStructDestructors`: synthesize `__destruct_<mangled>` for every managed instance whose destructor
// is REFERENCED (directly by a `decrefCalleeFor` scope-exit drop, or through a nested cascade
// `closeDestructorNeeds` grew the set over). Appended already-lowered after the pipeline.
export function installGenericInstanceDestructors(module StdModule, signatures ProgramSignatures, needed DestructorSet)
	for id in 0 upto signatures.genericInstanceCount() 'each'
		if not signatures.genericInstanceHasManagedField(id) 'noManaged'
			continue
		end 'noManaged'
		if not needed.contains(destructorSymbol(signatures.mangleGenericInstance(id))) 'notReferenced'
			continue
		end 'notReferenced'
		synthesizeGenericInstanceDestructor(module, id: id, signatures: signatures)
	end 'each'
end 'installGenericInstanceDestructors'

// ⭐ **HOW ONE MANAGED SLOT IS RELEASED — the two shapes a field drop comes in.** Carried on
// `ManagedFieldDrop` so the offset and the release travel together and `emitNullGuardedDrop` decides between
// them ONCE, rather than each cascade builder deciding and then agreeing. Exported with that emitter, whose
// callers now include the async releaser's GT-struct slots.
export union FieldDropKind
	// The ordinary field: one machine word holding a managed pointer, released by a STATICALLY chosen
	// `(box) -> void` callee — `__str_decref`, `__mm_decref`, `__managed_decref`, a nested `__destruct_<T>`.
	direct(callee ByteArray)
	// ⭐ An INTERFACE-TYPED field (P1.7a-existentials slice 2): a two-slot fat pointer whose conformer — and
	// therefore whose destructor — is a RUN-TIME fact, so no static callee exists to name. The witness half
	// at `+InterfaceWitnessHalfOffset` is loaded beside the value half and both go to
	// `__drop_existential(witness, value)`, which reads the table's `destroyFunc@8`.
	existential
end 'FieldDropKind'

// One managed field a TAGLESS box destructor must drop: its byte offset in the box, and HOW it is released.
// The struct (P1.4a) and generic-instance (P1.6-B2) cascades each build a list of these and hand it to
// `emitFieldCascadeDestructor`, so the entry/lower/drop/free skeleton lives in ONE place.
type ManagedFieldDrop
	export let offset as ByteOffset
	export let kind as FieldDropKind

	static function create(offset ByteOffset, kind FieldDropKind) returns ManagedFieldDrop
		return Self{offset: offset, kind: kind}
	end 'create'
end 'ManagedFieldDrop'

typealias ManagedFieldDropArray = Array with ManagedFieldDrop

// Emit `<symbolName>(box)` for a TAGLESS box (a struct, or a monomorphized generic instance) — every field
// is always present, so the cascade drops each managed field unconditionally behind a null-guard (a
// moved-out slot is null and falls through), then frees the box:
//
//   entry + lower: the shared refcount RMW (`emitRefcountCheckToLastOwner`) — `rc == 0` is the last owner
//     and branches to `drop`; otherwise the count is lowered and the box kept.
//   drop:  each `drops` spec through `emitNullGuardedDrop`, then fall to `free`.
//   free:  `__mm_free(box)`; ret.
//
// A void `(i64) -> void` static-dispatch signature (the drop callee is picked statically, so there is no
// `call_indirect` type to satisfy and no `i64` return the way v1's header destructor had). It is the same
// skeleton the union cascade uses too, minus the tag switch — hence the shared `emitNullGuardedDrop`.
function emitFieldCascadeDestructor(module StdModule, symbolName ByteArray, drops ManagedFieldDropArray)
	let func = IrFunction.createFromStd(symbolName, returnType: StdReturnType.void, paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry")
	var lower = module.addBlock(func, label: b"lower")
	var drop = module.addBlock(func, label: b"drop")
	var free = module.addBlock(func, label: b"free")

	emitParams(module, block: entry, count: 1)
	let box = 0 as ValueId

	emitRefcountCheckToLastOwner(module, func: func, entry: entry, lower: lower, record: box, lastOwner: drop, ids: ids)

	var cur = drop
	for spec in drops 'eachDrop'
		cur = emitNullGuardedDrop(module, cur: cur, box: box, offset: spec.offset, kind: spec.kind, ids: ids, func: func)
	end 'eachDrop'
	module.setTerminator(cur, op: StdOp.branch(free.id))

	let freed = ids.mint()
	module.appendOp(free, op: StdOp.call(freed, callee: MmFreeName, args: argsOf(box)))
	module.setTerminator(free, op: StdOp.retVoid)

	module.functions.push(func)
end 'emitFieldCascadeDestructor'

// Drop every MANAGED field of case `ci` from `startBlock`, each behind a NULL-guard (a moved-out slot is
// null and must not be decref'd as a bogus pointer), then branch to `dest`. The drop callee comes off
// `managedFieldDropCallee` — a String through `__str_decref`, a nested managed struct/union through ITS
// `__destruct_<T>`, a scalar-only struct/union box through `__mm_decref` — the SAME router the construct's
// drop routing reads, so the dropped set equals the moved-in set by construction.
function emitManagedFieldDrops(module StdModule, startBlock IrBlock, box ValueId, layout EnumLayout, ci CaseIndex, dest IrBlock, project Project, signatures ProgramSignatures, ids ValueMinter, func IrFunction)
	let payloads = layout.payloadsAt(ci)
	var cur = startBlock
	for fi in 0 upto payloads.count() 'eachField'
		let field = try payloads.get(fi) otherwise panic("emitManagedFieldDrops: payloadsAt count disagrees with get at {fi}")
		let class = classifyUnionPayload(signatures, typeNames: project.typeNames, fieldType: field.declaredType, slotScopeFilePath: layout.declFilePath)
		if not payloadClassIsManaged(class) 'scalarField'
			continue
		end 'scalarField'
		let callee = managedFieldDropCallee(signatures, typeNames: project.typeNames, fieldType: field.declaredType)
		cur = emitNullGuardedDrop(module, cur: cur, box: box, offset: layout.payloadSlotOffset(fi), kind: FieldDropKind.direct(callee), ids: ids, func: func)
	end 'eachField'
	module.setTerminator(cur, op: StdOp.branch(dest.id))
end 'emitManagedFieldDrops'

// Load the managed pointer at `box + offset`, and if it is non-null release it as `kind` says — the one
// null-guarded field-drop shape both the union tag-case cascade and the struct cascade emit, so the
// load/compare/branch geometry lives in ONE place. Returns the CONTINUATION block (where the caller
// resumes): a moved-out (null) slot skips the drop and falls straight through.
//
// ⚠ **THE NULL GUARD IS ON THE VALUE HALF FOR BOTH KINDS**, which is what an existential wants too: a
// moved-out existential slot is null exactly as a moved-out pointer slot is, and its witness half is then
// stale rather than merely unread. The witness load therefore sits INSIDE the drop block, where the value
// is already known live.
//
// ⭐ **`box` IS ANY BASE ADDRESS, NOT ONLY A MANAGED BOX**, which is why `Runtime/AsyncReleaser.maxon`'s
// per-callee releaser emits its argument / result / error drops through here over a GT STRUCT: the shape it
// needs — load at `base + offset`, drop it if non-null, continue — is this one exactly, and the second
// emitter it used to keep was a copy nothing forced to agree with this one (a wild free or a leak, and a
// compile error at neither site).
export function emitNullGuardedDrop(module StdModule, cur IrBlock, box ValueId, offset ByteOffset, kind FieldDropKind, ids ValueMinter, func IrFunction) returns IrBlock
	let ptr = ids.mint()
	module.appendOp(cur, op: StdOp.loadIndirect(ptr, addrId: box, offset: offset, valueType: StdType.i64))
	let zero = ids.mint()
	module.appendOp(cur, op: StdOp.const(zero, value: 0, valueType: StdType.i64))
	let nonNull = ids.mint()
	module.appendOp(cur, op: StdOp.cmp(nonNull, lhs: ptr, rhs: zero, pred: StdCmpPred.ne, operandType: StdType.i64))
	var dropBlock = module.addBlock(func, label: b"decref")
	let contBlock = module.addBlock(func, label: b"cont")
	module.setTerminator(cur, op: StdOp.condBranch(nonNull, thenBlockId: dropBlock.id, elseBlockId: contBlock.id))

	let dropped = ids.mint()
	match kind 'k'
		direct(callee) then module.appendOp(dropBlock, op: StdOp.call(dropped, callee: callee, args: argsOf(ptr)))
		existential then emitExistentialFieldDrop(module, block: dropBlock, box: box, offset: offset, value: ptr, dropped: dropped, ids: ids)
	end 'k'
	module.setTerminator(dropBlock, op: StdOp.branch(contBlock.id))

	return contBlock
end 'emitNullGuardedDrop'

// Load the WITNESS half beside an already-live value half and release the pair through
// `__drop_existential(witness, value)` (P1.7a-existentials slice 2). Its own function because a `match` arm
// carries one statement and this shape is two; `dropped` is the caller's result slot, so the two kinds mint
// exactly one apiece.
function emitExistentialFieldDrop(module StdModule, block IrBlock, box ValueId, offset ByteOffset, value ValueId, dropped ValueId, ids ValueMinter)
	let witness = ids.mint()
	module.appendOp(block, op: StdOp.loadIndirect(witness, addrId: box, offset: offset + InterfaceWitnessHalfOffset, valueType: StdType.i64))
	module.appendOp(block, op: StdOp.call(dropped, callee: DropExistentialName, args: twoArgs(witness, second: value)))
end 'emitExistentialFieldDrop'

// --- The per-type deep-cloner cascade (P1.7 slice 3b-vi-b): the DUAL of the destructor cascade ---
//
// ⭐ **IT LIVES BESIDE ITS DUAL, AND IT DID NOT USED TO (ARR6).** `__clone_<T>` synthesizes deep cloners for
// STRUCTS and UNIONS; it has nothing to do with the element buffer, and it sat in `ArrayRuntime.maxon` only
// because the managed-element array copy was the first thing that needed one. Everything it mirrors is in
// this file — `DestructorPrefix`/`destructorSymbol`, `noteDestructorUsage`, `closeDestructorNeeds`,
// `installStructDestructors`/`installUnionDestructors`, `synthesizeStructDestructor`/`synthesizeUnionDestructor`
// — and `noteRelocatedFunctionUsage` (also here) already re-enters this closure, so the drop side and the
// clone side of one field graph are now one file apart from nothing rather than one file apart from each other.

// ⭐ **NOTE WHAT THE REFERENCED CLONERS TRANSITIVELY NEED**, the clone twin of `noteDestructorUsage`. A
// `__clone_<Struct>` whose field is a String calls `__str_clone`, whose field is a nested struct/union calls
// that field's OWN `__clone_<T>`, whose field is a trivial/managed Array calls `__managed_clone`/`__managed_clone_managed`
// — all inside the SYNTHESIZED body the Maxon-module scan cannot see. So this closes `neededCloners` over that
// nesting (a fixpoint, monotonic → terminates) and turns on the transitive `usesStrClone`/`usesManagedMemory`/
// `usesManagedElementCopy`/`usesHeap` bits. Called after `scanRuntimeUsage` (which seeds `neededCloners` from the
// `funcAddr(__clone_<T>)` element-cloner stamps), before `.data` layout reads `usesHeap` and `installStringRuntime`
// reads `usesStrClone`.
//
// ⛔ **ITS OWN OPAQUE-ELEMENT ROOT IS GONE, WITH THE DROP TWIN IT MIRRORED (W17-c).** It rooted every instance
// for which `genericInstanceOpaqueArrayElementIsCopyable` held — a PREDICTION of which `copyFunc@32` relocs
// lowering would stamp, made before lowering, and true of instances no program reaches (the four
// `WithIterIterator_*` the `String` cone puts in every registry). `noteRelocatedFunctionUsage` reads
// the stamps themselves and now re-enters THIS closure when they grow `neededCloners`, so the measured set
// replaces the predicted one on both sides at once. See `noteDestructorUsage` above for the measurement.
export function noteClonerUsage(usage RuntimeUsage, project Project, signatures ProgramSignatures)
	// The overwhelmingly common program (and the entire generic/managed-free scale corpus) references no cloner,
	// so its `neededCloners` is empty and can only STAY empty (nothing seeds a nested need). Early-out then, so
	// the per-type `clonerSymbol` allocations of the registration below are paid only by a program that deep-clones
	// — a managed-copy-gated cost, not a per-compile one on every struct/enum in the program.
	if usage.neededCloners.count() == 0 'noCloners'
		return
	end 'noCloners'

	// ⭐ Closed by the SHARED `CascadeWorklist` (`CascadeNeeds.maxon`) — the same engine that closes the DROP
	// dual (`closeDestructorNeeds` above). Both used to be a `while changed` RE-SCAN of every declared type,
	// which is one quadratic written down twice: a cloner chain of depth D cost D passes over all T types and
	// re-minted every type's `__clone_` symbol on each. Each referenced node is now expanded exactly once.
	//
	// ⭐ The node space is the DROP side's exactly (W162): a generic instance now has a `__clone_<mangled>`
	// beside its `__destruct_<mangled>`, so the drain's instance arm is reachable here and the two closures
	// register one node space rather than two. It USED to register none, because a non-`Array` instance was
	// rejected as uncopyable by `genericTypeFieldUncopyableInstantiation` and the arm could only panic.
	var work = CascadeWorklist.create()

	for (_, layout) in project.structTypes 'eachStruct'
		work.register(clonerSymbol(layout.name), node: CascadeNode.declaredStruct(layout))
	end 'eachStruct'

	for (_, layout) in project.enumTypes 'eachUnion'
		work.register(clonerSymbol(layout.name), node: CascadeNode.declaredUnion(layout))
	end 'eachUnion'

	// ⚠ The instance node space is registered under the SAME symbol-key discipline the drop side states at
	// `closeDestructorNeeds` — a declaration and an instance cannot mint one symbol (P1.7's `reservedIfDeclared`),
	// and two instances that do are E3006 and fail the build before this runs.
	for id in 0 upto signatures.genericInstanceCount() 'eachInstance'
		work.register(clonerSymbol(signatures.mangleGenericInstance(id)), node: CascadeNode.genericInstance(id))
	end 'eachInstance'

	work.seed(usage.neededCloners)

	// Every cloner ALLOCATES a fresh box, so one referenced cloner anywhere means the program touches the
	// heap — a fact about the queue being non-empty, not about any single node in it.
	if work.hasPending() 'anyClonerReferenced'
		usage.usesHeap = true
	end 'anyClonerReferenced'

	while work.hasPending() 'drain'
		let node = work.take()
		match node 'node'
			declaredStruct(layout) then noteStructClonerNeeds(usage, layout: layout, project: project, signatures: signatures, work: work)
			declaredUnion(layout) then noteUnionClonerNeeds(usage, layout: layout, project: project, signatures: signatures, work: work)
			genericInstance(id) then noteInstanceClonerNeeds(usage, id: id, signatures: signatures, work: work)
		end 'node'
	end 'drain'
end 'noteClonerUsage'

// ⭐ The GENERIC-INSTANCE twin of `noteStructClonerNeeds` (W162) — over each SUBSTITUTED managed field, and
// the exact clone dual of `addNestedInstanceDestructors`. It needs no `project`: every fact about an instance
// is answered inside `signatures`, over `signatures`' own interner.
//
// ⚠ The no-layout early-out is this walk's precondition, exactly as it is the drop twin's: a node is expanded
// as soon as its SYMBOL is needed, and the field walk reads a base struct a layout-less instance does not have.
// Nothing is lost by returning — `instanceCloneStrategy` refuses such an instance at the same tier, so no
// referenced `__clone_<mangled>` can name one.
function noteInstanceClonerNeeds(usage RuntimeUsage, id GenericInstanceId, signatures ProgramSignatures, work CascadeWorklist)
	if not signatures.genericInstanceHasBaseLayout(id) 'noSynthesizedCloner'
		return
	end 'noSynthesizedCloner'

	for i in 0 upto signatures.genericInstanceFieldCount(id) 'eachField'
		if not signatures.genericInstanceFieldIsManaged(id, index: i) 'scalar'
			continue
		end 'scalar'
		noteFieldCloneNeeds(usage, strategy: signatures.genericInstanceFieldCloneStrategy(id, index: i), work: work)
	end 'eachField'
end 'noteInstanceClonerNeeds'

// Turn on the transitive bits (and grow `neededCloners`) for every managed field of struct `layout`'s cloner,
// queueing each newly-needed cloner on `work` so its OWN nesting is closed in turn.
function noteStructClonerNeeds(usage RuntimeUsage, layout StructLayout, project Project, signatures ProgramSignatures, work CascadeWorklist)
	for i in 0 upto layout.fieldCount() 'eachField'
		if not signatures.structFieldIsManaged(layout.name, index: i) 'scalar'
			continue
		end 'scalar'
		let fieldType = try layout.fieldTypes.get(i) otherwise panic("noteStructClonerNeeds: fieldTypes.get OOB at {i}")
		noteFieldCloneNeeds(usage, strategy: managedFieldCloneStrategy(signatures, typeNames: project.typeNames, fieldType: fieldType), work: work)
	end 'eachField'
end 'noteStructClonerNeeds'

// The union twin of `noteStructClonerNeeds` — over each managed payload of each case.
function noteUnionClonerNeeds(usage RuntimeUsage, layout EnumLayout, project Project, signatures ProgramSignatures, work CascadeWorklist)
	for ci in 0 upto layout.caseCount() 'eachCase'
		let payloads = layout.payloadsAt(ci)
		for fi in 0 upto payloads.count() 'eachField'
			let field = try payloads.get(fi) otherwise panic("noteUnionClonerNeeds: payloadsAt count disagrees with get at {fi}")
			if not payloadClassIsManaged(classifyUnionPayload(signatures, typeNames: project.typeNames, fieldType: field.declaredType, slotScopeFilePath: layout.declFilePath)) 'scalar'
				continue
			end 'scalar'
			noteFieldCloneNeeds(usage, strategy: managedFieldCloneStrategy(signatures, typeNames: project.typeNames, fieldType: field.declaredType), work: work)
		end 'eachField'
	end 'eachCase'
end 'noteUnionClonerNeeds'

// Turn on the bits a managed field's clone STRATEGY needs, inserting a nested cloner into `neededCloners`.
function noteFieldCloneNeeds(usage RuntimeUsage, strategy ManagedCloneStrategy, work CascadeWorklist)
	match strategy 'strategy'
		direct(callee) then noteCloneCalleeNeeds(usage, callee: callee, work: work)
		managedArray(elementClone) then noteManagedArrayFieldNeeds(usage, elementClone: elementClone, work: work)
		unsupported then panic("noteFieldCloneNeeds: an unsupported managed field strategy reached the cloner-needs closure — arrayElementSupportsDeepClone gates the front end")
	end 'strategy'
end 'noteFieldCloneNeeds'

// A managed-element array FIELD clones through `__managed_clone_managed(field, funcAddr(elementClone))` — route
// BOTH callees the synthesized cloner body will emit through the ONE usage map, so their bits are exactly a
// direct scan of those calls (no second spelling of "__managed_clone_managed → usesManagedElementCopy").
function noteManagedArrayFieldNeeds(usage RuntimeUsage, elementClone ByteArray, work CascadeWorklist)
	recordCallUsage(ManagedCloneManagedName, usage: usage)
	noteCloneCalleeNeeds(usage, callee: elementClone, work: work)
end 'noteManagedArrayFieldNeeds'

// A single `(box) -> newBox` clone callee the synthesized cloner will CALL: its usage bits are exactly what a
// direct scan of that call records, so route through `recordCallUsage` — THE ONE callee→bit map — rather than
// restating "__str_clone → usesStrClone+copy, __managed_clone → usesManagedMemory, __clone_<T> → neededCloners". A nested
// `__clone_<T>` that is NEWLY joined to `neededCloners` is announced to `work`, which queues the declaration
// that symbol names; announcing exactly on the newly-added edge is what makes the closure O(types + fields).
// The leaf callees (`__str_clone`, `__managed_clone`) name no cascade node and announce nothing.
function noteCloneCalleeNeeds(usage RuntimeUsage, callee ByteArray, work CascadeWorklist)
	let grew = bytesStartWith(callee, prefix: ClonerPrefix) and not usage.neededCloners.contains(callee)
	recordCallUsage(callee, usage: usage)

	if grew 'newlyNeeded'
		work.discovered(callee)
	end 'newlyNeeded'
end 'noteCloneCalleeNeeds'

// ⭐ **THE PER-STRUCT DEEP-CLONER INSTALLER (P1.7 slice 3b-vi-b)** — the clone twin of `installStructDestructors`.
// Synthesize `__clone_<Struct>` for every struct whose cloner is REFERENCED (directly by an element-cloner
// stamp, or through a nested cascade `noteClonerUsage` grew the set over). Unlike the destructor installer there
// is NO managed-field gate: a scalar-only struct box still needs a fresh-box clone (the drop side's
// `__mm_decref` has no clone analogue). Appended already-lowered after the pipeline, like the destructor cascades.
export function installStructCloners(module StdModule, project Project, signatures ProgramSignatures, needed ClonerSet)
	if needed.count() == 0 'noCloners'
		return
	end 'noCloners'
	for (_, layout) in project.structTypes 'each'
		if needed.contains(clonerSymbol(layout.name)) 'referenced'
			synthesizeStructCloner(module, layout: layout, project: project, signatures: signatures)
		end 'referenced'
	end 'each'
end 'installStructCloners'

// The union twin of `installStructCloners`.
export function installUnionCloners(module StdModule, project Project, signatures ProgramSignatures, needed ClonerSet)
	if needed.count() == 0 'noCloners'
		return
	end 'noCloners'
	for (_, layout) in project.enumTypes 'each'
		if needed.contains(clonerSymbol(layout.name)) 'referenced'
			synthesizeUnionCloner(module, layout: layout, project: project, signatures: signatures)
		end 'referenced'
	end 'each'
end 'installUnionCloners'

// ⭐ **THE PER-INSTANCE DEEP-CLONER INSTALLER (W162)** — the clone twin of `installGenericInstanceDestructors`,
// and `installStructCloners`' instance twin. Synthesize `__clone_<mangled>` for every instance whose cloner is
// REFERENCED (directly by an element-cloner stamp in a layout descriptor's `copyFunc@32`, or through a nested
// cascade `noteClonerUsage` grew the set over). Like the struct installer there is NO managed-field gate — a
// scalar-only instance box still needs a fresh-box clone — but the base-layout gate IS one: a layout-less
// instance has no field list to cascade over, which `declaredInstanceSupportsDeepClone` refuses at the front end.
export function installGenericInstanceCloners(module StdModule, project Project, signatures ProgramSignatures, needed ClonerSet)
	if needed.count() == 0 'noCloners'
		return
	end 'noCloners'
	for id in 0 upto signatures.genericInstanceCount() 'each'
		if not signatures.genericInstanceHasBaseLayout(id) 'noSynthesizedCloner'
			continue
		end 'noSynthesizedCloner'
		if not needed.contains(clonerSymbol(signatures.mangleGenericInstance(id))) 'notReferenced'
			continue
		end 'notReferenced'
		synthesizeGenericInstanceCloner(module, id: id, project: project, signatures: signatures)
	end 'each'
end 'installGenericInstanceCloners'

// One managed field a TAGLESS box cloner must deep-copy: its byte offset in the box, and HOW it is copied.
// `ManagedFieldDrop`'s clone dual, and it exists for that one's reason — the struct (P1.7 slice 3b-vi-b) and
// generic-instance (W162) cloners each build a list of these and hand it to `emitFieldCascadeCloner`, so the
// alloc/blit/clone/ret skeleton lives in ONE place rather than once per shape of field list.
type ManagedFieldClone
	export let offset as ByteOffset
	export let strategy as ManagedCloneStrategy

	static function create(offset ByteOffset, strategy ManagedCloneStrategy) returns ManagedFieldClone
		return Self{offset: offset, strategy: strategy}
	end 'create'
end 'ManagedFieldClone'

typealias ManagedFieldCloneArray = Array with ManagedFieldClone

// Emit `<symbolName>(src) -> newBox` for a TAGLESS box (a struct, or a monomorphized generic instance):
// `__mm_alloc` a fresh box, BLIT the whole record (every scalar field copied for free), then DEEP-CLONE each
// managed field in place — the blit's shallow pointer is replaced by an independent copy through the field's
// `ManagedCloneStrategy`. A tagless box has no case discriminant, so every field is always present; the
// per-field null-guard (`emitManagedFieldClone`) skips a moved-out (null) slot exactly as the destructor
// cascade's null-guard does. `emitFieldCascadeDestructor`'s dual, minus the refcount check: a clone never
// frees, it always allocates.
function emitFieldCascadeCloner(module StdModule, symbolName ByteArray, boxSize ByteOffset, tagName String, clones ManagedFieldCloneArray, project Project)
	let func = IrFunction.createFromStd(symbolName, returnType: StdReturnType.value(StdType.i64), paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry")
	emitParams(module, block: entry, count: 1)
	let src = 0 as ValueId

	let size = emitConst(module, block: entry, value: boxSize as ParsedInt, ids: ids)
	let zeroDtor = emitConst(module, block: entry, value: TrivialElementDestroy, ids: ids)
	let newBox = ids.mint()
	emitMmAllocCall(module, block: entry, result: newBox, size: size, destructor: zeroDtor, tag: userTagIndex(project.globalData, name: tagName, debugStream: module.debugStream), ids: ids)
	var cur = emitForwardCopy(module, func: func, cur: entry, dest: newBox, src: src, byteCount: size, ids: ids)

	for spec in clones 'eachField'
		cur = emitManagedFieldClone(module, func: func, cur: cur, box: newBox, offset: spec.offset, strategy: spec.strategy, ids: ids)
	end 'eachField'

	module.setTerminator(cur, op: StdOp.ret(newBox))
	module.functions.push(func)
end 'emitFieldCascadeCloner'

// The managed field list of declared struct `layout`, resolved through the shared `managedFieldCloneStrategy`
// over `project.typeNames` — the ONE interner that layout's field-type ids live in.
function synthesizeStructCloner(module StdModule, layout StructLayout, project Project, signatures ProgramSignatures)
	var clones = ManagedFieldCloneArray.create()
	for i in 0 upto layout.fieldCount() 'eachField'
		if not signatures.structFieldIsManaged(layout.name, index: i) 'scalar'
			continue
		end 'scalar'
		let fieldType = try layout.fieldTypes.get(i) otherwise panic("synthesizeStructCloner: fieldTypes.get OOB at {i}")
		clones.push(ManagedFieldClone.create(layout.offsetOfField(i), strategy: managedFieldCloneStrategy(signatures, typeNames: project.typeNames, fieldType: fieldType)))
	end 'eachField'

	emitFieldCascadeCloner(module, symbolName: clonerSymbol(layout.name), boxSize: layout.sizeBytes(), tagName: String.from(layout.name), clones: clones, project: project)
end 'synthesizeStructCloner'

// ⭐⭐ **THE PER-INSTANCE DEEP-CLONER CASCADE (W162)** — the exact clone dual of
// `synthesizeGenericInstanceDestructor`, and the same relationship to `synthesizeStructCloner` that one has to
// `synthesizeStructDestructor`. A generic instance is a monomorphized base struct that OWNS its managed type
// arguments, so `__clone_<mangled>` allocates a fresh box of the BASE's size and deep-clones each SUBSTITUTED
// managed field — `Box with String` clones the String, `Box with Holder` clones the Holder (through its own
// `__clone_Holder`), `Box with (Box with String)` clones the inner box through ITS instance cloner. The base
// struct's own `__clone_Box` is NOT what a managed instance uses: `Box`'s shared body compiles once against
// opaque `T`, so a per-instance cascade is what makes the type-arg clone concrete.
//
// ⭐⭐ **AN INSTANCE OVER THE *ENCLOSING* BODY'S OWN TYPE PARAMETER (`Box with Element` inside
// `Bag uses Element`) CLONES AS A PURE BLIT, AND THAT IS BALANCED AGAINST WHAT THE DROP SIDE ACTUALLY DOES.**
// Its substituted `v` is a bare `typeParameter`, which `typeIsManaged` classifies scalar — so this walk emits
// NO field clone, exactly as `synthesizeGenericInstanceDestructor` emits no field drop and
// `genericInstanceBoxDropCallee` answers the trivial `__mm_decref`.
//
// ⚠ **WHAT MAKES THAT SAFE IS THAT BOTH SIDES ARE NO-OPS ON `v` — NOT THAT SOMETHING ELSE OWNS IT. READ THE
// EMITTED CODE BEFORE BUILDING ON THIS NOTE.** It first credited the balance to the enclosing instance's
// layout-descriptor protocol (`retainFunc@64` / `destroyFunc@40`), and that is NOT what this shape emits.
// MEASURED at W162's review with `--emit-ir-runtime` on `Bag with String`: `Bag.create` builds the element
// array as `__managed_create(8, __mm_decref)`, `Box.create` allocates each element box with a ZERO
// destructor, and `__clone_Box_T<hash>` is `__mm_alloc` + blit with no incref — so `v` is neither retained on
// the way in nor released on the way out, on EITHER side. The clone therefore takes no reference and frees
// none, which is why it can neither leak nor double-free. It is admissible for exactly that reason and for no
// stronger one.
//
// ⛔ The other half of that measurement is a PRE-EXISTING hole this rung neither opened nor widens: the
// enclosing body BORROWS the element it stores. A `Bag with String` whose caller's `String` dies before the
// read SEGFAULTS (139) — and it segfaults identically on the merge base `0b4c57a76b`, on a program with no
// cloner in it at all — so it belongs to the opaque type-parameter ownership protocol, not to this cascade.
// A leak check cannot settle it either way here: the spec case's payload is an `.rdata` literal, and
// `specs-shv2/generic-instance-clone.md` records that `e.v` cannot be read from outside the shared body.
//
// The MM tag is the instance's own mangled name, so a cloned box decodes in `MXDS_TAGS` as the instance it is
// — the same name `__mm_alloc` interns at the concrete construction site.
function synthesizeGenericInstanceCloner(module StdModule, id GenericInstanceId, project Project, signatures ProgramSignatures)
	var clones = ManagedFieldCloneArray.create()
	for i in 0 upto signatures.genericInstanceFieldCount(id) 'eachField'
		if not signatures.genericInstanceFieldIsManaged(id, index: i) 'scalar'
			continue
		end 'scalar'
		clones.push(ManagedFieldClone.create(signatures.genericInstanceFieldOffset(id, index: i), strategy: signatures.genericInstanceFieldCloneStrategy(id, index: i)))
	end 'eachField'

	let mangled = signatures.mangleGenericInstance(id)
	emitFieldCascadeCloner(module, symbolName: clonerSymbol(mangled), boxSize: signatures.genericInstanceBoxSize(id), tagName: String.from(mangled), clones: clones, project: project)
end 'synthesizeGenericInstanceCloner'

// Emit `__clone_<Union>(src) -> newBox`: `__mm_alloc` a fresh box, BLIT the whole box (the tag and every payload
// slot copied for free), then — behind a per-managed-case tag guard chain (the same shape
// `synthesizeUnionDestructor` uses) — DEEP-CLONE the LIVE case's managed payloads in place. A scalar-only union
// (no case owns a managed payload) is a pure blit, which is exactly the fresh independent box its element copy
// needs.
function synthesizeUnionCloner(module StdModule, layout EnumLayout, project Project, signatures ProgramSignatures)
	let func = IrFunction.createFromStd(clonerSymbol(layout.name), returnType: StdReturnType.value(StdType.i64), paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry")
	let done = module.addBlock(func, label: b"done")
	emitParams(module, block: entry, count: 1)
	let src = 0 as ValueId

	let size = emitConst(module, block: entry, value: layout.boxSizeBytes() as ParsedInt, ids: ids)
	let zeroDtor = emitConst(module, block: entry, value: TrivialElementDestroy, ids: ids)
	let newBox = ids.mint()
	emitMmAllocCall(module, block: entry, result: newBox, size: size, destructor: zeroDtor, tag: userTagIndex(project.globalData, name: String.from(layout.name), debugStream: module.debugStream), ids: ids)
	var cur = emitForwardCopy(module, func: func, cur: entry, dest: newBox, src: src, byteCount: size, ids: ids)

	let tag = emitLoadField(module, block: cur, record: newBox, offset: UnionTagOffset, ids: ids)
	for ci in 0 upto layout.caseCount() 'eachCase'
		if not caseHasManagedField(signatures, typeNames: project.typeNames, layout: layout, ci: ci) 'scalarCase'
			continue
		end 'scalarCase'
		let caseBlock = module.addBlock(func, label: b"case")
		let nextTest = module.addBlock(func, label: b"casetest")
		let tagConst = emitConst(module, block: cur, value: layout.tagOfIndex(ci), ids: ids)
		let isCase = emitCmp(module, block: cur, a: tag, b: tagConst, pred: StdCmpPred.eq, ids: ids)
		module.setTerminator(cur, op: StdOp.condBranch(isCase, thenBlockId: caseBlock.id, elseBlockId: nextTest.id))
		emitManagedFieldClones(module, func: func, startBlock: caseBlock, box: newBox, layout: layout, ci: ci, dest: done, project: project, signatures: signatures, ids: ids)
		cur = nextTest
	end 'eachCase'

	module.setTerminator(cur, op: StdOp.branch(done.id))
	module.setTerminator(done, op: StdOp.ret(newBox))
	module.functions.push(func)
end 'synthesizeUnionCloner'

// Deep-clone every MANAGED payload of case `ci` in place (its blit-copied shallow pointer replaced by an
// independent copy), then branch to `dest`. The clone twin of `emitManagedFieldDrops`.
function emitManagedFieldClones(module StdModule, func IrFunction, startBlock IrBlock, box ValueId, layout EnumLayout, ci CaseIndex, dest IrBlock, project Project, signatures ProgramSignatures, ids ValueMinter)
	let payloads = layout.payloadsAt(ci)
	var cur = startBlock
	for fi in 0 upto payloads.count() 'eachField'
		let field = try payloads.get(fi) otherwise panic("emitManagedFieldClones: payloadsAt count disagrees with get at {fi}")
		if not payloadClassIsManaged(classifyUnionPayload(signatures, typeNames: project.typeNames, fieldType: field.declaredType, slotScopeFilePath: layout.declFilePath)) 'scalar'
			continue
		end 'scalar'
		let strategy = managedFieldCloneStrategy(signatures, typeNames: project.typeNames, fieldType: field.declaredType)
		cur = emitManagedFieldClone(module, func: func, cur: cur, box: box, offset: layout.payloadSlotOffset(fi), strategy: strategy, ids: ids)
	end 'eachField'
	module.setTerminator(cur, op: StdOp.branch(dest.id))
end 'emitManagedFieldClones'

// Load the blit-copied shallow pointer at `box + offset` and, when it is NON-NULL, replace it with an
// independent deep clone (via the field's `strategy`); a moved-out (null) slot is left as-is (the blit already
// copied its 0). The one null-guarded field-clone shape both the struct cascade and the union tag-case cascade
// emit, so the load/clone/store geometry lives in ONE place. Returns the CONTINUATION block.
function emitManagedFieldClone(module StdModule, func IrFunction, cur IrBlock, box ValueId, offset ByteOffset, strategy ManagedCloneStrategy, ids ValueMinter) returns IrBlock
	let oldPtr = emitLoadField(module, block: cur, record: box, offset: offset, ids: ids)
	let zero = emitConst(module, block: cur, value: 0, ids: ids)
	let nonNull = emitCmp(module, block: cur, a: oldPtr, b: zero, pred: StdCmpPred.ne, ids: ids)
	var cloneBlock = module.addBlock(func, label: b"clonefld")
	let contBlock = module.addBlock(func, label: b"cont")
	module.setTerminator(cur, op: StdOp.condBranch(nonNull, thenBlockId: cloneBlock.id, elseBlockId: contBlock.id))

	let newPtr = emitCloneCall(module, block: cloneBlock, oldPtr: oldPtr, strategy: strategy, ids: ids)
	emitStoreField(module, block: cloneBlock, record: box, offset: offset, value: newPtr)
	module.setTerminator(cloneBlock, op: StdOp.branch(contBlock.id))

	return contBlock
end 'emitManagedFieldClone'

// Emit the clone call for a managed field's `strategy` and return the fresh pointer. A `direct` callee is a
// plain 1-arg call; a `managedArray` field takes the element's `funcAddr` and calls `__managed_clone_managed`.
function emitCloneCall(module StdModule, block IrBlock, oldPtr ValueId, strategy ManagedCloneStrategy, ids ValueMinter) returns ValueId
	match strategy 'strategy'
		direct(callee) then return emitDirectClone(module, block: block, oldPtr: oldPtr, callee: callee, ids: ids)
		managedArray(elementClone) then return emitManagedArrayFieldClone(module, block: block, oldPtr: oldPtr, elementClone: elementClone, ids: ids)
		unsupported then panic("emitCloneCall: an unsupported managed field strategy reached the cloner synthesis — arrayElementSupportsDeepClone gates the front end")
	end 'strategy'
end 'emitCloneCall'

function emitDirectClone(module StdModule, block IrBlock, oldPtr ValueId, callee ByteArray, ids ValueMinter) returns ValueId
	let newPtr = ids.mint()
	module.appendOp(block, op: StdOp.call(newPtr, callee: callee, args: argsOf(oldPtr)))
	return newPtr
end 'emitDirectClone'

function emitManagedArrayFieldClone(module StdModule, block IrBlock, oldPtr ValueId, elementClone ByteArray, ids ValueMinter) returns ValueId
	let elemFn = ids.mint()
	module.appendOp(block, op: StdOp.funcAddr(elemFn, funcName: elementClone))
	let newPtr = ids.mint()
	module.appendOp(block, op: StdOp.call(newPtr, callee: ManagedCloneManagedName, args: twoArgs(oldPtr, second: elemFn)))
	return newPtr
end 'emitManagedArrayFieldClone'

// `__mm_leak_check(exitCode) -> exitCode` — the gate.
//
// ⭐ IT TAKES AND RETURNS THE EXIT CODE, which is what lets it sit on the exit path as a plain
// function rather than as a special case inside `mrt_start`. A clean program's code passes through
// untouched; a leaked one's is REPLACED by 101. The bootstrap's `mm_leak_check(exit_code)` has the
// same shape for the same reason.
//
// It is a Std function and not hand-assembled bytes because it needs nothing a Std function lacks:
// a load, a compare, and two returns. It notably does NOT need to call `ExitProcess` — returning
// the code to `mrt_start`, which already makes that call, keeps the one OS-exit path in one place.
//
// ⭐ P1.5-B2 #88 — UNDER `usesGt` IT ALSO GATES `__gt_live_count`. A green-thread program's spawned-but-
// unreclaimed GT structs + seed stacks are slab/OS allocations invisible to `__mm_alloc_count`, so the GT
// runtime keeps its own spawn/reclaim counter; this single OS-exit gate is the one home for every "must be
// reclaimed before a clean exit" check, so a clean HEAP count falls through to a SECOND, INDEPENDENT `!= 0`
// test on it. The two are never summed/OR'd into one count — a GT over-reclaim driving `__gt_live_count`
// negative must not cancel a heap under-release — and a GT leak reports a DISTINCT code
// (`RuntimeAbort.greenThreadLeak`, not `leakDetected`) so its diagnosis points at the GT counter. The extra
// load is gated on `usage.usesGt` because `__gt_live_count` only exists when the GT runtime is installed —
// and since `usesGt ⟹ usesHeap`, this gate is always present for a GT program, so no GT leak slips past it.
function buildMmLeakCheck(module StdModule, usage RuntimeUsage)
	var func = IrFunction.createFromStd(MmLeakCheckName, returnType: StdReturnType.value(StdType.i64), paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry")
	var leaked = module.addBlock(func, label: b"leaked")
	var clean = module.addBlock(func, label: b"clean")

	emitParams(module, block: entry, count: 1)
	let exitCode = 0 as ValueId

	let countAddr = ids.mint()
	module.appendOp(entry, op: StdOp.globalAddr(countAddr, label: MmAllocCountLabel))
	let count = ids.mint()
	module.appendOp(entry, op: StdOp.loadIndirect(count, addrId: countAddr, offset: 0, valueType: StdType.i64))
	let zeroConst = ids.mint()
	module.appendOp(entry, op: StdOp.const(zeroConst, value: 0, valueType: StdType.i64))
	// `!= 0` and not `> 0`: an over-release drives the count NEGATIVE, and a gate that only caught
	// under-release would report a clean run for a compiler emitting too many drops — the more
	// dangerous of the two bugs, since it is a use-after-free waiting for a free list to exist.
	let isLeaked = ids.mint()
	module.appendOp(entry, op: StdOp.cmp(isLeaked, lhs: count, rhs: zeroConst, pred: StdCmpPred.ne, operandType: StdType.i64))

	// A heap leak short-circuits to `leaked` (101) either way. When the GT runtime is present, a clean HEAP
	// count falls through to a SECOND check on `__gt_live_count` — two INDEPENDENT `!= 0` tests, never a
	// summed/OR'd single count. Without the GT runtime, the clean count goes straight to `clean`.
	if usage.usesGt 'gtGate'
		var checkGt = module.addBlock(func, label: b"checkgt")
		var gtLeaked = module.addBlock(func, label: b"gtleaked")
		module.setTerminator(entry, op: StdOp.condBranch(isLeaked, thenBlockId: leaked.id, elseBlockId: checkGt.id))
		let gtCountAddr = ids.mint()
		module.appendOp(checkGt, op: StdOp.globalAddr(gtCountAddr, label: GtLiveCountLabel))
		let gtCount = ids.mint()
		module.appendOp(checkGt, op: StdOp.loadIndirect(gtCount, addrId: gtCountAddr, offset: 0, valueType: StdType.i64))
		let gtIsLeaked = ids.mint()
		module.appendOp(checkGt, op: StdOp.cmp(gtIsLeaked, lhs: gtCount, rhs: zeroConst, pred: StdCmpPred.ne, operandType: StdType.i64))
		module.setTerminator(checkGt, op: StdOp.condBranch(gtIsLeaked, thenBlockId: gtLeaked.id, elseBlockId: clean.id))
		// A GT leak reports its OWN code — distinct from the heap 101 — so the diagnosis points at the GT
		// counter, not the heap one.
		let gtLeakCode = RuntimeAbort.greenThreadLeak.rawValue as ParsedInt
		let gtLeakConst = ids.mint()
		module.appendOp(gtLeaked, op: StdOp.const(gtLeakConst, value: gtLeakCode, valueType: StdType.i64))
		module.setTerminator(gtLeaked, op: StdOp.ret(gtLeakConst))
	end 'gtGate' else 'noGt'
		module.setTerminator(entry, op: StdOp.condBranch(isLeaked, thenBlockId: leaked.id, elseBlockId: clean.id))
	end 'noGt'

	// The exit code a leaked program reports lives in `RuntimeAbort` with every other abort code the
	// emitted runtime spends, so the number space has one home and one duplicate check. ⚠ It is ALSO
	// spelled by `SpecWorkerPool.LeakCheckExitCode`, which reads it from the other end (a spec-test worker
	// is itself a leak-gated Maxon program) — that file is outside this rung's list, so the two are still
	// two spellings of one number.
	let leakCode = RuntimeAbort.leakDetected.rawValue as ParsedInt
	let leakConst = ids.mint()
	module.appendOp(leaked, op: StdOp.const(leakConst, value: leakCode, valueType: StdType.i64))
	module.setTerminator(leaked, op: StdOp.ret(leakConst))

	module.setTerminator(clean, op: StdOp.ret(exitCode))

	module.functions.push(func)
end 'buildMmLeakCheck'

// `ptr - HeaderBytes` — the header's base address. Every header access goes through it, so the one
// place the payload/header relationship is expressed is here. See the header-layout note above for
// why this is a subtraction rather than a negative `loadIndirect` offset. Private, like the offsets it
// pairs with: callers outside this file reach the refcount through the exported builders instead.
function emitHeaderBase(module StdModule, block IrBlock, ptr ValueId, ids ValueMinter) returns ValueId
	let headerConst = ids.mint()
	module.appendOp(block, op: StdOp.const(headerConst, value: HeaderBytes, valueType: StdType.i64))
	let header = ids.mint()
	module.appendOp(block, op: StdOp.binOp(header, lhs: ptr, rhs: headerConst, opcode: StdBinOpcode.sub, operandType: StdType.i64))
	return header
end 'emitHeaderBase'

export function argsOf(only ValueId) returns ValueIdArray
	var args = ValueIdArray.create()
	args.push(only)
	return args
end 'argsOf'

// The two- and three-argument branch-edge / call-argument builders — `argsOf`'s pair and triple
// siblings, shared by the String, Array and GT runtimes (a `__mm_alloc(size, dtor)` is two, a
// `__str_copy(dest, src, len)` three). One home so the runtime builders do not each mint their own.
export function twoArgs(first ValueId, second ValueId) returns ValueIdArray
	var args = ValueIdArray.create()
	args.push(first)
	args.push(second)
	return args
end 'twoArgs'

export function threeArgs(first ValueId, second ValueId, third ValueId) returns ValueIdArray
	var args = ValueIdArray.create()
	args.push(first)
	args.push(second)
	args.push(third)
	return args
end 'threeArgs'

// Four positional call arguments — `__managed_slice_managed`. Homed here beside its `argsOf`/`twoArgs`/`threeArgs`
// siblings.
export function fourArgs(first ValueId, second ValueId, third ValueId, fourth ValueId) returns ValueIdArray
	var args = ValueIdArray.create()
	args.push(first)
	args.push(second)
	args.push(third)
	args.push(fourth)
	return args
end 'fourArgs'

// Five positional call arguments — `__gt_subp_yield_read(readEnd, buf, cap, bytesOutPtr, ownsPipe)`.
export function fiveArgs(first ValueId, second ValueId, third ValueId, fourth ValueId, fifth ValueId) returns ValueIdArray
	var args = ValueIdArray.create()
	args.push(first)
	args.push(second)
	args.push(third)
	args.push(fourth)
	args.push(fifth)
	return args
end 'fiveArgs'
