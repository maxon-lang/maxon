// Runtime/StringRuntime.maxon — the String value representation (P1.2 wave A) and the two builder-built
// Std runtime functions a String needs before ownership exists: `__print_string` and `__str_eq`.
//
// ⭐ A WAVE-A STRING IS IMMORTAL RDATA. A string LITERAL lowers to a pointer to a fused 48-byte record
// whose `buffer@0` points at a separate NUL-terminated byte blob — BOTH in read-only `.rdata`. Nothing
// is heap-allocated, refcounted or freed, so neither runtime function touches the MM runtime: a
// print-only or string-`==`-only program stays leak-gate-free (see `scanRuntimeUsage`). The owned heap
// String, its destructor, and drop-at-scope-exit are Wave B.
//
// This file owns TWO things and their single source is here:
//   1. the RECORD LAYOUT — the offsets `__print_string`/`__str_eq` read (`buffer@0`, `length@8`) AND
//      the offsets `LowerMaxonToStd` writes when it assembles a literal's record. One set of constants,
//      read from both ends, so the reader and the writer cannot drift (`buildStringRecordBytes` asserts
//      each field lands at its named offset).
//   2. the two runtime functions, built as `StdOp` graphs exactly as `MmRuntime` builds the allocator
//      — so they get register allocation, frames and the whole backend for free — reusing that file's
//      `ValueMinter`/`emitParams`/`oneI64Param`/`twoI64Params`/`argsOf` rather than a second copy.

// --- The fused 48-byte String record (bootstrap `MaxonToStandardConversion.Helpers.cs:503-536`) ---
//
// Every field is an 8-byte slot, so the six offsets are 0/8/16/24/32/40 and the record is 48 bytes.
// `buffer@0` is the ABSOLUTE VA of the byte blob — emitted as a PLACEHOLDER 0 and patched by the PE
// writer once `.rdata`'s RVA is known (a fixed-base image, so the VA is compile-time computable). The
// blob is a SEPARATE `.rdata` entry, NUL-terminated, and `length@8` EXCLUDES the NUL.
export let StringBufferOffset = 0 as ByteOffset
export let StringLengthOffset = 8 as ByteOffset

// Exported for `Parser.emitStringInterp`, which WRITES all six fields of an owned heap String's record
// (the literal path here only ever writes rdata). One set of offsets, read by the runtime and written by
// the interpolation lowering, so a reader and a writer of the same record cannot drift.
export let StringCapacityOffset = 16 as ByteOffset
export let StringElementSizeOffset = 24 as ByteOffset
export let StringParentPtrOffset = 32 as ByteOffset
export let StringIsAsciiOffset = 40 as ByteOffset
export let StringRecordBytes = 48 as ByteCount
let StringFieldBytes = 8 as ByteCount

// `element_size = 1` — a String's elements are bytes.
//
// ⭐ **A LITERAL'S `capacity@16`/`parent@32` ARE THE SHARED BUFFER-OWNERSHIP ENCODING'S** (`BufferOwnership`),
// not this file's invention and not the Array record's either: `RdataBufferCapacity` says the buffer is an
// immortal `.rdata` blob that is not this record's to write or to release, and `NoOwedAllocation` says the
// record owes no separate allocation a release. The Array record's byte-string literal writes exactly the
// same pair for exactly the same reason.
export let StringElementSize = 1 as ParsedInt

// ⭐ AN OWNED INTERPOLATION RESULT IS A HEAP STRING, and its bytes live INLINE — right after the 48-byte
// record, in the SAME `__mm_alloc` payload (`buffer@0 = record + StringRecordBytes`). So the whole thing
// is one allocation: `__mm_decref` → `__mm_free` reclaims the record AND its bytes together, and the
// destructor a struct passes (`TrivialDestructor`, 0) is exactly right — there is no external buffer to
// free. `capacity@16` is `InlineBufferCapacity` and `parent@32` is `NoOwedAllocation` (unwritten — the
// zeroing contract supplies it), which is the shared encoding saying exactly that: not mine to write in
// place, and no separate allocation owed. See `Parser.emitStringInterp`.
//
// The fixed bytes an owned interpolation result allocates BEYOND its text: the 48-byte record the bytes
// live inline behind, plus one trailing NUL (which the slab's zeroing supplies for free — nothing writes
// it). `Parser.emitStringInterp` sizes its one `__mm_alloc` as `totalLen + StringInterpOverheadBytes`.
export let StringInterpOverheadBytes = (StringRecordBytes as ParsedInt) + 1

// `isAsciiFlag@40` — 1 iff every byte is < 128 (a compile-time scan). An empty string is vacuously
// ASCII. The high-bit threshold and the two flag values are named rather than bare so the scan reads
// as the property it computes.
let AsciiHighBit = 128 as Byte
let AsciiFlagTrue = 1 as ParsedInt
let AsciiFlagFalse = 0 as ParsedInt

// The blob is the payload bytes followed by a single NUL — a C string, so the record's pointer is
// usable by any consumer that wants a NUL-terminated buffer, while `length@8` is what Maxon reads.
let NulTerminator = 0 as Byte

// ⭐ EVERY BLOB IS PADDED TO AN 8-BYTE MULTIPLE, so the RECORD that registers right after it lands at an
// 8-byte-aligned rdata offset. This is load-bearing for arm64-macOS ONLY: a String literal's `buffer@0`
// there is a dyld chained-fixup REBASE (`MachOWriter.writeMachoStringBufferRebases`), and a chain links
// its entries by a 4-byte-granular `next` delta, so every rebased slot MUST sit at an aligned offset or
// the delta cannot be encoded. Records are 48 bytes (an 8-multiple) and arm64 float islands are 8, so
// once blobs are 8-multiples the rdata cursor stays 8-aligned across the whole section and every record
// is naturally aligned. The trailing zero bytes are INVISIBLE to every consumer — the blob is read as a
// NUL-terminated C string from `buffer@0` and `length@8` counts only the payload — so this is free on
// x64 (which bakes an unaligned absolute VA and needs no alignment) and correct on arm64. `v1` does the
// same at its `.data` string helpers (LowerMaxonToStd `addSubprocessString`/`addTraceTagEntry`).
let StringBlobAlignment = 8 as ByteCount

// `__int_to_string`'s decimal machinery. The digits are rendered without ever NEGATING the value, so
// `i64.min` is handled with no overflow: signed `%`/`/` keep the value's sign (`x % 10 ∈ [-9,0]` for a
// negative `x`), and the per-digit magnitude is recovered by MULTIPLYING by `sign = 1 - 2*neg` (`+1` for
// a non-negative value, `-1` for a negative one) rather than by an `abs` that `i64.min` would overflow.
let AsciiZeroDigit = 48 as ParsedInt
let AsciiMinusSign = 45 as ParsedInt
let DecimalRadix = 10 as ParsedInt

// `value >>logical 63` is `1` exactly when the sign bit is set — the branch-free `isNegative` the sign
// and the leading `-` are both derived from.
let SignBitPosition = 63 as ParsedInt
let SignMultiplierBase = 1 as ParsedInt
let SignMultiplierSpan = 2 as ParsedInt

// The scratch an integer part reserves before `__int_to_string` fills it: `i64.min` renders as
// "-9223372036854775808", 20 digits and a sign = 21 bytes, and no i64 is wider. `Parser.emitStringInterp`
// allocates this, the converter fills `len ≤ 21` bytes, and the caller frees it after the copy.
export let IntToStringScratchBytes = 21 as ParsedInt

// `__bool_to_string` renders "true" (4) or "false" (5). The ASCII bytes of both, and the two lengths.
let AsciiLowerT = 116 as ParsedInt
let AsciiLowerR = 114 as ParsedInt
let AsciiLowerU = 117 as ParsedInt
let AsciiLowerE = 101 as ParsedInt
let AsciiLowerF = 102 as ParsedInt
export let AsciiLowerA = 97 as ParsedInt
let AsciiLowerL = 108 as ParsedInt
let AsciiLowerS = 115 as ParsedInt
let BoolTrueLength = 4 as ParsedInt
let BoolFalseLength = 5 as ParsedInt

// "false" is the longest rendering, so 5 bytes cover both.
export let BoolToStringScratchBytes = 5 as ParsedInt

// The `.rdata` label prefixes for a literal's blob and its record. Distinct so a reader of the section
// can tell the two apart; `__`-prefixed so they never collide with a user name and stay out of the
// spec goldens (`TargetPrinter.isRuntimeFunction`'s data twin).
let StringBlobPrefix = "__str_blob_"
let StringRecordPrefix = "__str_rec_"

// The two runtime entry points this file installs. `__`-prefixed (`isCompilerInternalCallee` treats
// them as the compiler's own — no E3004, no signature slotting), but NOT `__mm_`-prefixed, so
// `isRuntimeCallee` leaves them out of the heap-runtime decision: a program that only prints or only
// compares strings carries neither the allocator nor the leak check.
export let PrintStringName = b"__print_string"
export let StrEqName = b"__str_eq"

// The two runtime entry points an interpolation lowers CALLS to (`Parser.emitStringInterp`). `__str_copy`
// blits one part's bytes into the result buffer; `__int_to_string` renders an integer part's decimal text
// into a scratch buffer. Both are `__`-prefixed compiler-internal (no E3004, no signature slotting) but NOT
// `__mm_`-prefixed — like `__print_string`/`__str_eq`, they touch no allocator, so they never widen the
// heap-runtime decision. The heap decision is driven by the interpolation's OWN `__mm_alloc` calls, which
// `scanRuntimeUsage` already sees.
export let StrCopyName = b"__str_copy"
export let IntToStringName = b"__int_to_string"
export let BoolToStringName = b"__bool_to_string"

// The two Wave-D entry points. `__str_append(self, other)` grows a String in place; `__str_decref(record)`
// is a String's drop — a `__mm_decref` that ALSO frees the external buffer of a detached String. Both are
// `__`-prefixed compiler-internal (no E3004, no signature slotting) but NOT `__mm_`-prefixed, so on their
// own they do not widen the heap decision. They DO call `__mm_alloc`/`__mm_free`/`__str_copy` inside their
// Std bodies — which `scanRuntimeUsage` cannot see, since those calls are not in the Maxon module — so a
// reference to either explicitly turns on `usesHeap` (and `__str_append` turns on `usesStrCopy`).
export let StrAppendName = b"__str_append"
export let StrDecrefName = b"__str_decref"

// ⭐ **THE P1.8 SLICE C BYTE/ASCII METHOD FAMILY.** Seven `String` methods reach these eight entry points;
// none of them needs a UCD table, a grapheme segmenter or a `StringIndex`, which is exactly what makes them
// this slice (`findFirst`/`findLast`/`slice` are grapheme-indexed by their SIGNATURES and wait for the index
// type). All are `__`-prefixed compiler-internal (no E3004, no signature slotting) but NOT `__mm_`-prefixed,
// so each declares its own transitive floor in `recordCallUsage` rather than inheriting one from a prefix.
//
//   * `__str_range_eq(aAddr, bAddr, len)` — the raw byte-range compare a positioned search verifies with.
//     The stdlib's `bytesEqual` (`stdlib/String.maxon:979-988`), on ADDRESSES rather than records: every
//     caller here has already resolved a buffer and an offset, and passing records would make them
//     re-derive what they hold.
//   * `__str_find(hay, startPos, needle)` — the ABSOLUTE index of the first occurrence at or after
//     `startPos`, or `StrFindNotFound`. The stdlib's `findIn` (`:1001-1022`) including its FIRST-BYTE fast
//     reject, with the window expressed as a start position rather than an `(offset, len)` pair: the three
//     loop callers all walk a tail, which is what `startPos` says and what an explicit length would only
//     re-encode.
//   * `__str_starts_with` / `__str_ends_with` / `__str_contains` — the three predicates.
//   * `__str_map_case(self, lo, hi, delta)` — ONE graph for `toLower` AND `toUpper` (the stdlib's
//     `mapAsciiCase`, `:589-616`), the parser supplying the gate and the shift. ⭐ It transforms an
//     INDEPENDENT COPY and never the receiver: `let b = a.toLower()` lowercasing `a` too is the exact bug
//     `specs-shv2/string-type-2.md`'s `case-conversion-does-not-mutate-receiver` was written against.
//   * `__str_replace(self, old, with)` — the stdlib's TWO-PASS shape (`:448-517`): count the matches, then
//     build into ONE exactly-sized allocation. ⚠ NOT its `StringBuilder`, which shv2 does not have and is
//     not getting here — the two-pass count is precisely what makes a builder unnecessary, since the final
//     size is known before a byte is written and nothing ever grows.
//   * `__str_split(self, delim, arr)` — fills a CALLER-CREATED `Array with String` (the stdlib's `:557-587`).
//     The array is created by the PARSER through `emitArrayCreateOp`, the one array-creation door, so
//     `split` cannot disagree with a literal about a `Array with String`'s element size or its
//     `element_destroy@40` stamp; this function only pushes.
//
// ⚠ **EVERY SEGMENT / RESULT IS A FRESH OWNED INLINE STRING** built through `emitBuildOwnedInlineString`,
// the one fused-record encoder, so each is independently droppable through `__str_decref` and none of them
// aliases the receiver's bytes. That is what keeps `split`'s array leak-free: `__arr_decref`'s element walk
// calls `__str_decref` on every slot, and a slot holding a view of the receiver would double-free.
export let StrRangeEqName = b"__str_range_eq"
export let StrFindName = b"__str_find"

// ⭐ **`__str_rfind(hay, needle)` — THE BACKWARD BYTE SEARCH (P1.8 Slice B2), `__str_find`'s mirror.** The
// stdlib's `findLastIn` (`stdlib/String.maxon:1003-1028`), including its first-byte fast reject, scanning
// DOWN from `hayLen - needleLen`. It is a BYTE search and needs no backward grapheme segmentation: the
// grapheme index a `findLast` reports is derived from the byte position it lands on, by the SAME forward
// `__strix_bidx` walk the forward search uses. It takes no start position where `__str_find` does — every
// caller wants the whole haystack, and a backward window has no consumer to shape it.
export let StrRFindName = b"__str_rfind"
export let StrStartsWithName = b"__str_starts_with"
export let StrEndsWithName = b"__str_ends_with"
export let StrContainsName = b"__str_contains"
export let StrMapCaseName = b"__str_map_case"
export let StrReplaceName = b"__str_replace"
export let StrSplitName = b"__str_split"

// ⭐ **THE P1.8 SLICE E ENTRY POINTS.**
//   * `__str_replace_first(self, old, with)` — the stdlib's `replaceFirst` (`:565-599`). A SEPARATE graph
//     from `__str_replace` on the reference's own argument: with exactly one match the final size is known
//     outright, so both of `replace`'s loops disappear. See `buildStrReplaceFirst`.
//   * `__str_from_bytes(arr)` — `String.from(bytes)` (`:119-121`), the one exported `String` static. It
//     COPIES where the reference shares a `__ManagedMemory`; see `buildStrFromBytes` for why shv2 cannot.
// Both are `__`-prefixed compiler-internal (no E3004, no signature slotting) and neither is
// `__mm_`-prefixed, so each declares its own transitive floor in `closeStringMethodNeeds`.
export let StrReplaceFirstName = b"__str_replace_first"
export let StrFromBytesName = b"__str_from_bytes"

// ⭐ **`__str_find`/`__str_rfind`'s "no occurrence" answer, and it is a NEGATIVE INDEX rather than a thrown
// error on purpose.** The stdlib spells both searches `throws StringError.notFound`, and a Std graph CAN
// throw — `StdOp.errorReturn`'s dual-register flag is exactly that, and `__strix_first`/`__strix_last` use
// it one file over. What these two must not do is throw, because most of their callers are NOT throwing:
// `contains` wants a bool, `replace` and `split` walk a tail until the search stops finding, and a `tryCall`
// at each of those sites would be a control-flow join per iteration to answer a question the caller already
// treats as ordinary. So the BYTE search answers in the byte domain and the LANGUAGE-level `findFirst`/
// `findLast` do the one sentinel→throw translation, in `buildStringIndexSearch` and nowhere else.
// A byte position is non-negative by construction, so `-1` is outside the answer domain rather than inside
// it, and every caller tests `>= 0`. Named, so the call sites and the two producers cannot drift on which
// number means "nothing here".
let StrFindNotFound = -1 as ParsedInt

// ASCII case folding: `A`..`Z` (65..90) and `a`..`z` (97..122) sit a fixed distance apart, so `toLower` and
// `toUpper` differ ONLY in which range they gate on and the SIGN of the shift. That is why one
// `__str_map_case` graph serves both and the parser supplies the three numbers — and why a byte outside the
// gated range is left ALONE, which is the whole reason a non-ASCII (high-bit) byte passes through a case
// conversion unharmed. `AsciiLowerA` is shared with `__bool_to_string`'s "false": it is the byte `a` in both.
export let AsciiUpperA = 65 as ParsedInt
export let AsciiUpperZ = 90 as ParsedInt
export let AsciiLowerZ = 122 as ParsedInt
export let AsciiToLowerDelta = 32 as ParsedInt
export let AsciiToUpperDelta = -32 as ParsedInt

// `__str_clone(src) -> newStr` — a String's DEEP CLONE (P1.7 slice 3b-vi-b): a fresh OWNED heap String, an
// independent copy of `src` that is droppable through `__str_decref` without touching `src`. The `(box) ->
// newBox` DUAL of `__str_decref`, so a managed array/struct that clones a String field through this drops it
// through `__str_decref`. `__`-prefixed compiler-internal (no E3004, no signature slotting) but NOT
// `__mm_`-prefixed; it calls `__mm_alloc`/`__str_copy` inside its Std body, which `scanRuntimeUsage` cannot
// see, so a reference to it turns on `usesHeap`/`usesStrCopy` explicitly (`recordCallUsage`).
export let StrCloneName = b"__str_clone"

// ⭐ **WHERE A STRING RECORD KEEPS THE BUFFER-OWNERSHIP ENCODING** (`BufferOwnership`) — the three slots
// its predicates read, built from THIS file's offsets. All three provenances the record format admits are
// ordinary values of that encoding, and no String-only branch stands in front of it:
//
//   * INLINE (`capacity@16 = InlineBufferCapacity`, `parent@32 = NoOwedAllocation`) — every owned String
//     is born this way (`Parser.emitStringInterp`, which `promoteToOwnedString` also routes through). Not
//     mine to write in place, and no separate allocation owed: the record's own free takes the bytes.
//   * DETACHED (`capacity@16 >= 0`) — a separate `__mm_alloc`'d buffer this record owns and must release,
//     which is exactly what the encoding calls an OWNER, so its base is its own `buffer@0`.
//   * RDATA (`capacity@16 = RdataBufferCapacity`) — a literal's immortal blob. It never reaches these two
//     functions today: the parser promotes a `var` String at its declaration and only an owned String is
//     ever dropped. It needs no arm of its own regardless — it is a non-owned buffer owing nothing, and
//     both of those are already what the encoding says.
//
// ⚠ **THIS REPLACES `parent@32 == -1` ("a detached root"), AND THE BEHAVIOUR IT DECIDED IS UNCHANGED.**
// That test was this file's own third spelling of "is this buffer mine?" — and, at the same offset as the
// Array record's `parent@32`, it meant the OPPOSITE thing (there, *someone else's allocation I owe a
// release to*). Now `parent@32` means one thing in both records and nothing here has to be told which.
function stringBufferSlots() returns BufferRecordSlots
	return BufferRecordSlots.create(StringBufferOffset, capacityOffset: StringCapacityOffset, parentOffset: StringParentPtrOffset)
end 'stringBufferSlots'

// The bool every String PREDICATE returns, as the word a Std return carries: 1 for yes, 0 for no. Shared by
// `__str_eq`, `__str_range_eq` and the three P1.8 Slice C predicates, so a caller cannot read one function's
// "true" as another's "false".
let StrPredicateTrue = 1 as ParsedInt
let StrPredicateFalse = 0 as ParsedInt

// True iff every byte is ASCII (< 128) — the `isAsciiFlag@40` scan, run once per distinct literal at
// lower time (the cold path), never per value.
export function bytesAreAscii(bytes ByteArray) returns bool
	for b in bytes 'each'
		if b >= AsciiHighBit 'high'
			return false
		end 'high'
	end 'each'
	return true
end 'bytesAreAscii'

// The NUL-terminated blob for a literal's payload — the bytes, then one NUL.
export function stringBlobBytes(bytes ByteArray) returns ByteArray
	var blob = ByteArray.create()
	blob.append(bytes)
	blob.push(NulTerminator)
	while blob.count() mod StringBlobAlignment != 0 'pad'
		blob.push(NulTerminator)
	end 'pad'
	return blob
end 'stringBlobBytes'

// Build the 48-byte record for a literal. `byteLength` EXCLUDES the NUL (it is the payload count);
// `isAscii` is `bytesAreAscii`'s answer.
//
// ⚠ **`buffer@0` HOLDS THE BLOB'S RDATA OFFSET, NOT 0, AND THIS IS LOAD-BEARING FOR DEDUP.** The PE
// writer OVERWRITES `buffer@0` with the blob's absolute VA (`ImageBase + rdataRva + blobOffset`), so
// the value stored here is irrelevant to what the program reads. But it is NOT irrelevant to
// `registerRdataConstant`, which DEDUPES records by their bytes: two different strings of the same
// length and ascii-ness have byte-identical records EXCEPT for `buffer@0`, so a placeholder of 0 would
// collapse `"hello"` and `"world"` into ONE record pointing at ONE blob — a silent wrong answer where
// every same-length string compares equal. Seeding `buffer@0` with the blob's own offset (distinct per
// distinct blob, shared by identical strings that already dedup their blob) makes records dedup EXACTLY
// when their strings are identical.
//
// ⭐ EACH FIELD IS APPENDED AT ITS NAMED OFFSET AND THE APPENDER ASSERTS IT LANDS THERE, so the offsets
// the runtime functions load by (`StringBufferOffset`, `StringLengthOffset`) and the offsets this
// writes are ONE set of constants that cannot drift: reorder a field or mis-size one and this panics
// rather than shipping a record the runtime reads wrong.
export function buildStringRecordBytes(blobOffset ByteOffset, byteLength ByteCount, isAscii bool) returns ByteArray
	var record = ByteArray.create()
	appendRecordField(record, expectedOffset: StringBufferOffset, value: blobOffset as ParsedInt)
	appendRecordField(record, expectedOffset: StringLengthOffset, value: byteLength as ParsedInt)
	appendRecordField(record, expectedOffset: StringCapacityOffset, value: RdataBufferCapacity)
	appendRecordField(record, expectedOffset: StringElementSizeOffset, value: StringElementSize)
	appendRecordField(record, expectedOffset: StringParentPtrOffset, value: NoOwedAllocation)
	appendRecordField(record, expectedOffset: StringIsAsciiOffset, value: asciiFlagValue(isAscii))

	if record.count() != StringRecordBytes 'sizeDrift'
		panic("buildStringRecordBytes: assembled {record.count()} bytes, not {StringRecordBytes} — a field's width does not match its offset spacing")
	end 'sizeDrift'
	return record
end 'buildStringRecordBytes'

function appendRecordField(record ByteArray, expectedOffset ByteOffset, value ParsedInt)
	if record.count() != expectedOffset 'offsetDrift'
		panic("buildStringRecordBytes: a record field is being written at offset {record.count()} but its constant says {expectedOffset} — the record layout the runtime reads and this writes have drifted")
	end 'offsetDrift'
	record.append(scalarImage(value, byteCount: StringFieldBytes))
end 'appendRecordField'

function asciiFlagValue(isAscii bool) returns ParsedInt
	if isAscii 'ascii'
		return AsciiFlagTrue
	end 'ascii'
	return AsciiFlagFalse
end 'asciiFlagValue'

// The `.rdata` labels a literal's blob and record register under. Split out so the two prefixes are
// named at the one place that uses them and `LowerMaxonToStd` names neither.
export function registerStringBlob(globalData GlobalDataTable, bytes ByteArray) returns String
	return globalData.registerRdataConstant(StringBlobPrefix, bytes: stringBlobBytes(bytes))
end 'registerStringBlob'

// Register a literal's record, seeded with its blob's offset (see `buildStringRecordBytes` for why the
// offset, not 0). `blobLabel` must already be registered — its offset is read back here.
export function registerStringRecord(globalData GlobalDataTable, blobLabel String, byteLength ByteCount, isAscii bool) returns String
	let blobOffset = globalData.rdataOffsetOf(blobLabel)
	return globalData.registerRdataConstant(StringRecordPrefix, bytes: buildStringRecordBytes(blobOffset, byteLength: byteLength, isAscii: isAscii))
end 'registerStringRecord'

// --- Which compiler-internal runtime functions a module references ---
//
// ⭐ ONE WALK, THREE ANSWERS. `moduleUsesHeap`'s job (does this program touch the heap?) and the two
// String questions (does it print? does it compare strings?) are the SAME traversal — every call op,
// once — so they are answered together rather than by three near-identical walks. Each answer keys a
// DIFFERENT installation, and the heap answer stays `__mm_`-specific: a print-only program must carry
// NO allocator and NO leak check, so `usesHeap` reads `isRuntimeCallee` (the `__mm_` prefix), never
// "any compiler-internal callee".
//
// It asks the MAXON module because the answers are needed BEFORE lowering — the heap decision drives
// `.data` layout, and all three drive which functions get installed into the Std module.

// The set of `__destruct_<U>` symbols a module CALLS. A SET, not a list, because both
// `noteUnionDestructorUsage` and
// `installUnionDestructors` walk EVERY union (`project.enumTypes`) and ask "is this union's destructor
// referenced?" — a per-union membership test. Against a per-drop-site list that is an O(unions × drop
// sites) scan (the classic linear-lookup-in-a-linear-walk quadratic); against a set it is O(1) each, so
// the whole check is O(unions + drop sites). Insert also DEDUPLICATES — a union dropped D times records
// its one symbol once, not D copies.
export typealias DestructorSet = Set with ByteArray

// The set of `__clone_<T>` symbols a module references (P1.7 slice 3b-vi-b) — the CLONE twin of
// `DestructorSet`, collected from the `funcAddr(__clone_<T>)` element-cloner stamps and closed over nesting by
// `noteClonerUsage`, so `installStructCloners`/`installUnionCloners` synthesize only the referenced cloners.
// The SAME `Set with ByteArray` type is reused by `typeSupportsDeepClone` as its VISITED-name set (a
// cycle-breaker over struct/union names), since both are membership sets of `ByteArray` names.
export typealias ClonerSet = Set with ByteArray

export type RuntimeUsage
	export var usesHeap as bool
	// The program spawns a green thread (`async`/`await`). Drives `installGtRuntime` + the GT `.data`
	// globals + the two hand-assembled backend chunks. Set alongside `usesHeap` (spawn `__slab_alloc`s the
	// GT struct + arg buffer), from the `asyncCall`/`await` Maxon ops rather than a callee name — the async
	// ops are their own op kind, and their `__gt_*` calls do not exist until lowering.
	export var usesGt as bool
	// The program issues a YIELDING overlapped pipe read (`__gt_io_read`, the `spawnReadLine` probe, P1.5 slice
	// 1a-ii). A SUPERSET of `usesGt` (a read yields the green thread, so it needs the whole scheduler), plus the
	// IOCP substrate: `installIoRuntime` (`__io_init` + `__gt_io_read`), the hand-assembled `__io_completion_loop`
	// chunk, the six `__io_*` `.data` slots, and the run-queue CRITICAL_SECTION that guards the completion thread's
	// cross-thread `__gt_enqueue`. Set by `recordCallUsage` on a `__gt_io_read` call (which also sets `usesGt`).
	export var usesIocp as bool
	// The STREAMING subprocess API (P1.5 dogfood slice 1b) — the handle table + `__gt_subp_*` functions. A SUPERSET
	// of `usesIocp` (the yielding line read rides the completion thread), set by `recordCallUsage` on any
	// `__gt_subp_*` call. Drives `installSubpRuntime` + the `__subp_table` `.data` slot.
	export var usesStreaming as bool
	export var usesPrint as bool
	export var usesStrEq as bool
	export var usesStrCopy as bool
	export var usesIntToString as bool
	export var usesBoolToString as bool
	export var usesStrAppend as bool
	export var usesStrDecref as bool
	// The program touches an `Array` (P1.7 slice 1). Any `__arr_*` runtime call turns this on — and, like
	// the String helpers, turns on `usesHeap` too, because the array helpers `__mm_alloc`/`__mm_free` the
	// backing record and its element buffer inside their Std bodies, which this Maxon-module scan cannot
	// see. It drives `installArrayRuntime` (all the array helpers, appended already-lowered).
	export var usesArray as bool
	// The program touches a `Set` (P1.7b slice A). Any `__set_*` runtime call turns this on — and, like
	// `usesArray`, turns on `usesHeap` too, because the set helpers `__mm_alloc`/`__mm_free` the record and
	// its three external buffers inside their Std bodies, which this Maxon-module scan cannot see. It drives
	// `installSetRuntime`. Its own bit so a set-free program stays golden-neutral (installs nothing).
	export var usesSet as bool
	// The program DROPS a single opaque type-parameter value (`__drop_type_param`, P1.7 slice 3b-v /
	// Finding A) — a consumed feed binding left live at a scope exit, an opaque array element moved out
	// (`.pop()`), OR a bare opaque `T` field reassignment (`self.saved = next`). Its OWN bit, decoupled from
	// `usesArray`: a bare-field reassign in an ARRAY-FREE generic struct emits `__drop_type_param` yet touches
	// no `__arr_*`, so gating its install on `usesArray` would leave the call unlinked. `__drop_type_param` is
	// `__`-prefixed but NOT `__mm_`/`__arr_`-prefixed, so a call to it sets no other usage bit; its body only
	// reads the descriptor's `destroyFunc@40` and `callIndirect`s it (no direct alloc/free), so this bit alone
	// drives `installDropTypeParamRuntime` and pulls in no transitive floor of its own.
	export var usesDropTypeParam as bool
	// The program takes a SECOND owner of a heap box (`__mm_incref`). Two producers: the array runtime's
	// zero-copy slice (a view increfs the parent's element buffer — implied by `usesArray`, since the call
	// lives in a Std body this scan cannot see), and the PARSER's `try … otherwise` reconciliation, which
	// increfs an ok-edge borrow or an aliased error-edge binding so both merge into one owned phi — a `call
	// __mm_incref` this scan DOES see. Drives `installMmRuntime` to build `__mm_incref`; a program that never
	// increfs (the common one) keeps it out. Set alongside `usesHeap` (an incref is on a `__mm_alloc`'d box).
	export var usesIncref as bool
	// The program co-owns a BORROWED managed-aggregate parameter into a `var` (`var q = p`, OPEN #40),
	// which the parser makes a second owner of the caller's box via `__mm_retain`. Its OWN bit, not
	// `usesIncref`: `__mm_retain` (returns the pointer) and `__mm_incref` (void) have independent callers,
	// so folding either into the other installs a dead function in the program that uses only the other
	// (see `installMmRuntime`). A `call __mm_retain` this scan sees directly. Drives `installMmRuntime` to
	// build `__mm_retain`; a program that never co-owns a borrowed aggregate keeps it out. Set alongside
	// `usesHeap` (a retain is on a `__mm_alloc`'d box).
	export var usesRetain as bool
	// ⭐ The program declares at least one MANAGED top-level `var` (P1.7 slice 2a), so it carries
	// `__module_init` + `__maxon_global_cleanup` and every entry stub calls them around `main`. Set NOT by
	// this Maxon-module scan but by `installManagedGlobalInit`, which is where the decision is made — the
	// same discipline the leak/GT gates follow (see `BackendDispatch.buildBackend`'s header): an entry stub
	// asking the module "is `__module_init` still there?" would be asking a question dead-function
	// elimination can change the answer to, where "was it installed?" is fixed. The RUNTIME floor those two
	// functions need (`__mm_alloc`, `__str_clone`, `__str_decref`, `__arr_decref`) rides the ordinary bits:
	// they are appended to the Maxon module BEFORE `scanRuntimeUsage` walks it, so their calls are seen
	// exactly as user code's are.
	export var usesManagedGlobals as bool
	// The `__destruct_<U>` symbols this module CALLS (P1.3 slice 2) — collected from the drop sites so
	// `installUnionDestructors` synthesizes only the referenced ones, and `noteUnionDestructorUsage`
	// can classify their transitive `__str_decref`/`__mm_free` needs. Full symbols (not names): the
	// consumers query them against `destructorSymbol(name)`, avoiding a byte-substring extract. A
	// SET so that per-union query is O(1) — see `DestructorSet`.
	export var neededDestructors as DestructorSet
	// The program DEEP-CLONES a String (`__str_clone`, P1.7 slice 3b-vi-b) — a managed array/struct copy that
	// clones a String element/field. Its OWN bit, like `usesStrDecref`: `__str_clone` calls `__mm_alloc`/
	// `__str_copy` inside its Std body this scan cannot see, so a reference turns on `usesHeap`/`usesStrCopy`
	// too (`recordCallUsage`). Drives `installStringRuntime` to build `__str_clone`.
	export var usesStrClone as bool
	// ⭐ The P1.8 Slice C byte/ASCII method family — ONE BIT PER ENTRY POINT, following this file's existing
	// discipline rather than a single `usesStringMethods` blanket: a program that only asks `s.startsWith(p)`
	// must not carry the replace machinery. Each bit is set TRANSITIVELY by `recordCallUsage` from whichever
	// method the module actually names (a `__str_contains` reference turns on `__str_find`, which turns on
	// `__str_range_eq`) — the same "declare what the synthesized body calls, because this Maxon-module scan
	// cannot see inside it" rule `__str_append` and `__str_clone` already follow.
	export var usesStrRangeEq as bool
	export var usesStrFind as bool
	// The BACKWARD byte search (P1.8 Slice B2). Its own bit beside `usesStrFind`, following this file's
	// one-bit-per-entry-point discipline: a program that only asks `s.contains(p)` must not carry a second
	// search loop. It calls `__str_range_eq` inside its synthesized body, which this Maxon-module scan
	// cannot see, so that need is declared by `closeStringMethodNeeds` exactly as `__str_find`'s is.
	export var usesStrRFind as bool
	export var usesStrStartsWith as bool
	export var usesStrEndsWith as bool
	export var usesStrContains as bool
	export var usesStrMapCase as bool
	export var usesStrReplace as bool
	export var usesStrSplit as bool
	// The two P1.8 Slice E entry points, each with its OWN bit under this file's one-bit-per-entry-point
	// discipline: a program that only calls `replaceFirst` must not carry `replace`'s two loops, and a
	// program that only builds a String from bytes must carry neither.
	export var usesStrReplaceFirst as bool
	export var usesStrFromBytes as bool
	// The program copies a MANAGED-element array (`__arr_slice_managed`/`__arr_clone_managed`/
	// `__arr_append_managed`, P1.7 slice 3b-vi-b). Its OWN bit, DECOUPLED from `usesArray`, so a program that
	// only uses TRIVIAL arrays does not carry the three managed-copy helpers. Set alongside `usesArray`/
	// `usesHeap` (the helpers are `__arr_`-prefixed). Drives the managed-copy install in `installArrayRuntime`.
	export var usesManagedArrayCopy as bool
	// The program copies an OPAQUE-`T` array (`__arr_slice_opaque`/`__arr_clone_opaque`/`__arr_append_opaque`,
	// P1.7 slice 3b-vi-b-β) — a `slice`/`clone`/`append` on an `Array with <type parameter>` field in a generic
	// body. Its OWN bit, DECOUPLED from `usesArray`, so a program that touches no opaque-array copy does not carry
	// the three wrappers. Set alongside `usesManagedArrayCopy` (`recordCallUsage`), because each wrapper's managed
	// branch calls the α `__arr_*_managed` helpers. Drives the opaque-copy install in `installArrayRuntime`.
	export var usesOpaqueArrayCopy as bool
	// The `__clone_<T>` symbols this module references (P1.7 slice 3b-vi-b) — the CLONE twin of
	// `neededDestructors`, collected from the `funcAddr(__clone_<T>)` element-cloner stamps and closed over
	// nesting by `noteClonerUsage`, so `installStructCloners`/`installUnionCloners` synthesize only the
	// referenced cloners. `usesHeap` follows any cloner (the box it allocates).
	export var neededCloners as ClonerSet
	// The program reads the WALL clock (`__clock_now_unix_s`, `__Builtins.currentUnixTimeSeconds`). Its OWN
	// bit, DECOUPLED from `usesGt` and from `usesHeap`, and that decoupling is the point: a calendar read is
	// a leaf that calls one Win32 import and divides, with no relationship to the green-thread scheduler
	// whose `__gt_now_ns` answers the OTHER clock question. Folding it under `usesGt` would install the
	// entire scheduler — plus the allocator and the leak gate under it — for a program that asks what
	// today's date is. Drives `installClockRuntime` + the one `__clock_wall_ticks` `.data` slot.
	export var usesWallClock as bool
	// ⭐ **THE P1.8 SLICE B GRAPHEME FAMILY — ONE BIT PER ENTRY POINT**, following this file's existing
	// discipline rather than one `usesGrapheme` blanket: a program that only asks
	// `graphemeBreakProperty(cp)` must carry neither the segmenter nor the UTF-8 decoders, and a program
	// that never touches a String at all must carry none of it. Each is set TRANSITIVELY by
	// `recordCallUsage` from whichever entry point the module actually names (a `__gr_count` reference
	// turns on `__gr_end`, which turns on `__gr_break` and the decoders, which turn on `__gbp` and
	// `__ext_pict`) — the same "declare what the synthesized body calls, because this Maxon-module scan
	// cannot see inside it" rule the String method family already follows.
	export var usesGbp as bool
	export var usesExtPict as bool
	export var usesUtf8Decode as bool
	export var usesGraphemeBreak as bool
	export var usesGraphemeEnd as bool
	export var usesGraphemeCount as bool
	// `__char_at` MINTS a Character — one `__mm_alloc`'d fused record per call, blitted with `__str_copy`
	// — so it declares the heap and the copy loop that `emitBuildOwnedInlineString` puts inside its body.
	export var usesCharAt as bool
	// `__str_to_bytes` PUSHES into a caller-created `Array with Byte`, so it declares the array runtime
	// (and the heap under it) exactly as `__str_split` declares them for its segments.
	export var usesStrToBytes as bool
	// `.codepoints()` and `.utf16()` (P1.8 Slice E) — `__str_to_bytes`'s two siblings, each with its OWN
	// bit under this file's one-bit-per-entry-point discipline: a program that asks for the bytes must not
	// carry a UTF-8 decoder, and a program that asks for the codepoints must not carry the surrogate
	// encoder. Both push into a caller-created array and both decode, so each declares the array runtime
	// and `usesUtf8Decode` in `closeGraphemeNeeds`.
	export var usesStrToCodepoints as bool
	export var usesStrToUtf16 as bool
	// ⭐ **THE P1.8 SLICE B2 `StringIndex` FAMILY — ONE BIT PER ENTRY POINT**, following this file's
	// existing discipline: a program that only asks `s.startIndex()` must carry neither the searches nor
	// the segmenter under them. Each is set TRANSITIVELY by `recordCallUsage` from whichever entry point
	// the module actually names (a `__strix_first` reference turns on `__strix_make`, `__strix_bidx` and
	// `__str_find`, and `__strix_bidx` turns on `__gr_end` and the whole grapheme family under it).
	export var usesStrIndexMake as bool
	export var usesStrIndexEnd as bool
	export var usesStrIndexByteToGrapheme as bool
	export var usesStrIndexAdvance as bool
	export var usesStrIndexFirst as bool
	export var usesStrIndexLast as bool
	export var usesStrIndexSlice as bool
	// ⭐ **THE UNICODE `General_Category` TABLE (P1.8 Slice D, R2).** Its own bit, and DECOUPLED from every
	// String bit: `__ucd_cat` is a LEAF that reads two `.rdata` blobs and does integer arithmetic — no heap,
	// no copy loop, no segmenter — so a program that classifies a codepoint carries nothing else, and a
	// program that never does carries neither the 65,536-byte BMP table nor the supplementary one. Set by
	// `recordCallUsage` on a `__ucd_cat` reference, which is what `CharacterSet.contains` emits.
	export var usesUcdCategory as bool
	// ⭐ **THE P1.8 SLICE D `CharacterSet` FAMILY — ONE BIT PER ENTRY POINT**, following this file's
	// existing discipline: a program that only builds a `CharacterSet` must not carry the trim scan, and a
	// program that only trims must not carry a second copy of anything. Each is set TRANSITIVELY by
	// `recordCharacterSetUsage` from whichever entry point the module actually names (a `__str_trim`
	// reference turns on `__cs_contains`, which turns on `__set_contains` and `__ucd_cat`, and the segmenter
	// and `__char_at` under the walk itself).
	export var usesCharSetMake as bool
	export var usesCharSetDecref as bool
	export var usesCharSetContains as bool
	export var usesStrTrim as bool
	// R4.1: the program opens a file. Unlike the wall clock it DOES declare a transitive dependency —
	// `__mf_open_read` allocates a NUL-terminated scratch copy of the path and the handle box through
	// `__mm_alloc`/`__mm_free`, so it carries `usesHeap` too (set together below).
	export var usesManagedFile as bool

	static function create() returns RuntimeUsage
		return Self{usesHeap: false, usesGt: false, usesIocp: false, usesStreaming: false, usesPrint: false, usesStrEq: false, usesStrCopy: false, usesIntToString: false, usesBoolToString: false, usesStrAppend: false, usesStrDecref: false, usesArray: false, usesSet: false, usesDropTypeParam: false, usesIncref: false, usesRetain: false, usesManagedGlobals: false, neededDestructors: DestructorSet.create(), usesStrClone: false, usesStrRangeEq: false, usesStrFind: false, usesStrRFind: false, usesStrStartsWith: false, usesStrEndsWith: false, usesStrContains: false, usesStrMapCase: false, usesStrReplace: false, usesStrSplit: false, usesStrReplaceFirst: false, usesStrFromBytes: false, usesManagedArrayCopy: false, usesOpaqueArrayCopy: false, neededCloners: ClonerSet.create(), usesWallClock: false, usesGbp: false, usesExtPict: false, usesUtf8Decode: false, usesGraphemeBreak: false, usesGraphemeEnd: false, usesGraphemeCount: false, usesCharAt: false, usesStrToBytes: false, usesStrToCodepoints: false, usesStrToUtf16: false, usesStrIndexMake: false, usesStrIndexEnd: false, usesStrIndexByteToGrapheme: false, usesStrIndexAdvance: false, usesStrIndexFirst: false, usesStrIndexLast: false, usesStrIndexSlice: false, usesUcdCategory: false, usesCharSetMake: false, usesCharSetDecref: false, usesCharSetContains: false, usesStrTrim: false, usesManagedFile: false}
	end 'create'
end 'RuntimeUsage'

// `unreachableStdlib` names the functions this scan must ignore — the STDLIB functions no path from
// `main` reaches (`StdlibFacts.unreachable`, see StdlibSource). Dead-function elimination drops them
// before the back end, so the floor they would ask for is a floor for code the program does not
// contain: a `Clock` nothing calls must not install the green-thread scheduler and the wall-clock
// `.data` slot. It never contains a USER function — an unreached user body still speaks for the
// program — so the answer for every stdlib-free program is unchanged.
export function scanRuntimeUsage(module MaxonModule, unreachableStdlib FunctionNameSet) returns RuntimeUsage
	var usage = RuntimeUsage.create()
	for func in module.functions 'eachFunc'
		if unreachableStdlib.contains(func.name) 'notInTheProgram'
			continue
		end 'notInTheProgram'
		for blockRef in func.blockRefs 'eachBlock'
			let block = try module.blocks.get(blockRef) otherwise panic("scanRuntimeUsage: blockRef from func.blockRefs not in module.blocks")
			for opIdx in block.opRefs 'eachOp'
				let op = try module.ops.get(opIdx) otherwise panic("scanRuntimeUsage: opIdx {opIdx} not in module.ops")
				classifyRuntimeCall(op, usage: usage)
			end 'eachOp'
		end 'eachBlock'
	end 'eachFunc'
	return usage
end 'scanRuntimeUsage'

function classifyRuntimeCall(op MaxonOp, usage RuntimeUsage)
	match op 'op'
		call(_, callee, _, _, _, _) then recordCallUsage(callee, usage: usage)
		literal to stringLiteral then break 'op'
		// A throwing call names a user callee whose runtime usage is scanned exactly as `call`'s is; the
		// throw/propagate terminators and `panicAbort` name no user callee (panic exits directly) (P1.4b).
		tryCall(_, _, callee, _, _, _, _) then recordCallUsage(callee, usage: usage)
		throwError to panicAbort then break 'op'
		// P1.5-A1: an `indirectCall` calls through a code POINTER and names no runtime callee, so it records
		// nothing. A `functionRef` naming a USER function is likewise a bare `lea` of no runtime consequence —
		// but one naming a COMPILER-INTERNAL callee (`__`-prefixed) is the address of an array element destructor
		// stamped into `element_destroy@40` (P1.7 slice 3), and THAT reference must install its target (a
		// `__str_decref`/`__destruct_<T>`/`__mm_decref`/`__arr_decref`) exactly as a direct `call` to it would —
		// its transitive needs then close through `noteDestructorUsage`. Recorded through the same `recordCallUsage`.
		functionRef(_, funcName) then recordFunctionRefUsage(funcName, usage: usage)
		indirectCall then break 'op'
		// P1.5-B1a/B2b: `async`/`await`/`try await` carry the green-thread scheduler. Detected by OP KIND
		// (their `__gt_*` calls do not exist until lowering), and imply the HEAP too — `__gt_spawn`
		// `__slab_alloc`s the GT struct and the argument buffer.
		asyncCall to tryAwait then recordGtUsage(usage)
		// `sizeof(T)` lowers to a plain `loadIndirect` of the layout descriptor — it names no runtime callee
		// and pulls in no runtime floor (the descriptor is pure `.rdata`), so it records no usage (P1.6-B1).
		sizeofType then break 'op'
		byteStringLiteral then recordByteStringUsage(usage)
		// The jump table names no runtime callee and pulls in no runtime floor — a bare indexed branch.
		switch then break 'op'
		// A witness dispatch names no runtime callee and pulls in no runtime floor — the fused call reads a
		// `.rdata` witness table and jumps; the dispatched user impl is scanned on its own (P1.7a slice 2a).
		// The throwing form adds an error flag, not a runtime callee.
		witnessDispatch to witnessTryDispatch then break 'op'
	end 'op'
end 'classifyRuntimeCall'

// An `async`/`await` op turns on both scheduler and heap: the scheduler runs the green threads, and the
// heap floor supplies the `__slab_alloc` that `__gt_spawn` and the async arg-buffer spill need.
function recordGtUsage(usage RuntimeUsage)
	usage.usesGt = true
	usage.usesHeap = true
end 'recordGtUsage'

// A `b"…"` byte-string literal turns on both the Array runtime and the heap under it — the same pair any
// `__arr_*` call declares (`recordCallUsage`'s array arm), because the literal IS an owned Array record
// (`__mm_alloc`) whose `.count()`/`.get()`/drop go through the array runtime.
function recordByteStringUsage(usage RuntimeUsage)
	usage.usesArray = true
	usage.usesHeap = true
end 'recordByteStringUsage'

// A `functionRef` whose target is a COMPILER-INTERNAL callee (`__`-prefixed) is an array element destructor's
// address stamped into `element_destroy@40` (P1.7 slice 3) — its target must be installed exactly as a direct
// `call` to it would, so it routes through the SAME `recordCallUsage` (turning on the heap/`usesStrDecref`/
// `usesArray` bit or adding to `neededDestructors`, per the callee). A `functionRef` to a USER function is a
// plain code-pointer `lea` of no runtime consequence and records nothing (the P1.5-A1 behaviour, unchanged).
function recordFunctionRefUsage(funcName ByteArray, usage RuntimeUsage)
	if isCompilerInternalCallee(funcName) 'runtimeAddress'
		recordCallUsage(funcName, usage: usage)
	end 'runtimeAddress'
end 'recordFunctionRefUsage'

// ⭐ **THE ONE CALLEE-NAME → RUNTIME-USAGE-BIT MAP.** Exported so `noteDestructorUsage` can root a
// managed opaque-`T` `Array` element's destructor (P1.7 slice 3b-iii) through the IDENTICAL mapping the
// module scan gives a callee named directly — a `__str_decref` turns on the String runtime, a `__arr_decref`
// the array runtime, a `__destruct_<T>` joins `neededDestructors` — so the reloc-baked destructor is
// installed for the writer to resolve exactly as if the module had called it.
export function recordCallUsage(callee ByteArray, usage RuntimeUsage)
	if isRuntimeCallee(callee) 'heap'
		usage.usesHeap = true
	end 'heap'
	// A DIRECT `__gt_*` runtime call carries the whole green-thread scheduler (P1.5 mid-body-yield). `async`/
	// `await`/`try await` are detected by op KIND above because their `__gt_*` calls do not exist until
	// lowering, but `__Builtins.sleep(ms)` lowers in the FRONT END to a `call __gt_sleep`, which IS a Maxon
	// `call` this scan sees — so any `__gt_*` callee here turns on the scheduler (and, via `recordGtUsage`,
	// the heap). A source `sleep(ms)` reaches it one frame down, inside `stdlib/Sleep.maxon`'s body, which
	// this scan walks because stdlib source is merged into the module it walks — but ONLY IF A PATH FROM
	// `main` REACHES THAT BODY. `scanRuntimeUsage`'s `unreachableStdlib` filter (above) skips the rest, and
	// that qualifier is the load-bearing half, not a footnote: it is what keeps listing a stdlib module
	// byte-neutral for a program that does not use it, and it is why an unreached `sleep(ms)` compiles for a
	// target with no `__gt_sleep` while an unreached `__Builtins.sleep(ms)` in USER code is still refused.
	if isGtRuntimeCallee(callee) 'gt'
		recordGtUsage(usage)
	end 'gt'
	// A `__gt_io_read` call (the `spawnReadLine` probe, P1.5 slice 1a-ii) additionally carries the IOCP substrate:
	// the completion port + completion thread + wake event + run-queue lock. `usesGt` is already set by the `__gt_`
	// prefix above; this bit installs the IOCP-only pieces.
	if callee.equals(IoReadName) 'ioread'
		usage.usesIocp = true
	end 'ioread'
	// A `__gt_subp_*` call (the P1.5 streaming subprocess API, slice 1b) carries the whole streaming runtime: the
	// handle table + the `__gt_subp_*` functions, which ride the IOCP substrate (`usesIocp`) and build owned Strings
	// from raw bytes (`__mm_alloc`/`__str_copy` inside their bodies — `usesHeap`/`usesStrCopy`, declared here because
	// this Maxon-module scan cannot see those transitive calls). `usesGt`/`usesHeap` are already set by the `__gt_`
	// prefix above; these bits install the streaming-only pieces.
	if bytesStartWith(callee, prefix: SubpCalleePrefix) 'streaming'
		usage.usesStreaming = true
		usage.usesIocp = true
		usage.usesStrCopy = true
	end 'streaming'
	// A `__clock_*` call carries the WALL clock and NOTHING ELSE — no scheduler, no heap, no leak gate. It is
	// the ONE runtime family here that declares no transitive dependency, and that is a fact about the code
	// rather than an omission: `__clock_now_unix_s`'s Std body reads one `.data` word through one Win32 import
	// and divides, calling nothing this Maxon-module scan cannot see.
	if isClockRuntimeCallee(callee) 'wallClock'
		usage.usesWallClock = true
	end 'wallClock'
	// R4.1: a `__mf_*` call. It carries `usesHeap` with it, unlike the clock above — the open allocates a
	// NUL-terminated scratch copy of the path and the handle box, and frees the scratch.
	if isManagedFileRuntimeCallee(callee) 'managedFile'
		usage.usesManagedFile = true
		usage.usesHeap = true
	end 'managedFile'
	if callee.equals(PrintStringName) 'print'
		usage.usesPrint = true
	end 'print'
	if callee.equals(StrEqName) 'streq'
		usage.usesStrEq = true
	end 'streq'
	if callee.equals(StrCopyName) 'strcopy'
		usage.usesStrCopy = true
	end 'strcopy'
	if callee.equals(IntToStringName) 'inttostr'
		usage.usesIntToString = true
	end 'inttostr'
	if callee.equals(BoolToStringName) 'booltostr'
		usage.usesBoolToString = true
	end 'booltostr'
	// `__str_append` and `__str_decref` call `__mm_alloc`/`__mm_free` inside their Std bodies, which
	// this Maxon-module scan cannot see — so their TRANSITIVE heap dependency is declared here rather
	// than discovered. `__str_append` also blits with `__str_copy`. Turning these bits on is what
	// keeps a program that appends from missing its allocator or its copy loop.
	if callee.equals(StrAppendName) 'strappend'
		usage.usesStrAppend = true
		usage.usesHeap = true
		usage.usesStrCopy = true
	end 'strappend'
	if callee.equals(StrDecrefName) 'strdecref'
		usage.usesStrDecref = true
		usage.usesHeap = true
	end 'strdecref'
	// A `__mm_incref` the PARSER emitted (the `try … otherwise` phi reconciliation) — install the incref
	// helper for it, not only for the array runtime's `usesArray`. `usesHeap` follows because the box it
	// increfs was `__mm_alloc`'d (which set `usesHeap` at its own call site anyway).
	if callee.equals(MmIncrefName) 'incref'
		usage.usesIncref = true
		usage.usesHeap = true
	end 'incref'
	// A `__mm_retain` the PARSER emitted (co-owning a borrowed managed-aggregate parameter into a `var`,
	// OPEN #40) — install the retain helper for it. `usesHeap` follows because the box it retains was
	// `__mm_alloc`'d (which set `usesHeap` at that box's own allocation site anyway).
	if callee.equals(MmRetainName) 'retain'
		usage.usesRetain = true
		usage.usesHeap = true
	end 'retain'
	// Any `__arr_*` call carries the whole array runtime, and the heap under it: `__arr_create`/`__arr_grow`
	// `__mm_alloc` the record and the element buffer, `__arr_decref` `__mm_free`s them — none of which this
	// Maxon-module scan sees, since those calls live in the synthesized Std bodies. So a single reference
	// declares both bits, exactly as `__str_append`/`__str_decref` do for their own transitive heap use.
	if isArrayRuntimeCallee(callee) 'array'
		usage.usesArray = true
		usage.usesHeap = true
	end 'array'
	// Any `__set_*` call carries the whole set runtime, and the heap under it: `__set_create`/`__set_grow`
	// `__mm_alloc` the record and its three buffers, `__set_decref` `__mm_free`s them — none of which this
	// Maxon-module scan sees, since those calls live in the synthesized Std bodies. So a single reference
	// declares both bits, exactly as the `__arr_*` arm above does (P1.7b slice A).
	if isSetRuntimeCallee(callee) 'set'
		usage.usesSet = true
		usage.usesHeap = true
	end 'set'
	// The single-value descriptor-gated drop (P1.7 slice 3b-v / Finding A). Decoupled from `usesArray` so an
	// array-free bare-field reassign links: it is `__`-prefixed but neither `__mm_`- nor `__arr_`-prefixed, so
	// none of the arms above sees it. Its body only reads the descriptor and `callIndirect`s the destructor
	// (no direct `__mm_alloc`/`__mm_free`), so it declares no other bit — see `usesDropTypeParam`.
	if callee.equals(DropTypeParamName) 'droptypeparam'
		usage.usesDropTypeParam = true
	end 'droptypeparam'
	// A managed-payload union's scope-exit drop (`__destruct_<U>`). It frees the box (`__mm_free` — heap)
	// and, for a String field, calls `__str_decref` — but those live in the SYNTHESIZED body this scan
	// cannot see, so the symbol is recorded and its transitive needs are declared by
	// `noteUnionDestructorUsage` (which has the signatures/interner to classify the fields).
	if bytesStartWith(callee, prefix: DestructorPrefix) 'uniondtor'
		usage.usesHeap = true
		usage.neededDestructors.insert(callee)
	end 'uniondtor'
	// A String DEEP-CLONE (`__str_clone`, P1.7 slice 3b-vi-b) — a managed array/struct copy cloning a String
	// element/field. It `__mm_alloc`s a fresh fused record and `__str_copy`s the bytes in, inside its SYNTHESIZED
	// body this scan cannot see, so those transitive bits are declared here (the `__str_append` shape).
	if callee.equals(StrCloneName) 'strclone'
		usage.usesStrClone = true
		usage.usesHeap = true
		usage.usesStrCopy = true
	end 'strclone'
	// The `General_Category` lookup (P1.8 Slice D). It declares NOTHING else — see `usesUcdCategory` —
	// which makes it the second family, beside `__clock_*`, whose body calls nothing this scan cannot see.
	if callee.equals(UcdCategoryName) 'ucdcategory'
		usage.usesUcdCategory = true
	end 'ucdcategory'
	// ⚠ FIRST of the three family closures: the `StringIndex` family's members call into the OTHER two
	// (`__gr_end`, `__str_find`/`__str_rfind`), so the bits it turns on must themselves be closed over by
	// the closures below — see `closeStringIndexNeeds`.
	// ⚠ The `CharacterSet` family closes into the THREE below it — `__str_trim` walks `__gr_end` and mints
	// through `__char_at`, and `__cs_contains` decodes a codepoint — so it must record FIRST, exactly as the
	// `StringIndex` family does and for the identical reason: a bit turned on after its family's closure has
	// run installs an entry point without what it calls.
	recordCharacterSetUsage(callee, usage: usage)
	recordStringIndexUsage(callee, usage: usage)
	recordStringMethodUsage(callee, usage: usage)
	recordGraphemeUsage(callee, usage: usage)
	// The three MANAGED-element array copies (`__arr_slice_managed`/`__arr_clone_managed`/`__arr_append_managed`,
	// P1.7 slice 3b-vi-b). `isArrayRuntimeCallee` above already set `usesArray`/`usesHeap` (they are `__arr_`-
	// prefixed); THIS bit gates their install so a trivial-array program does not carry them.
	if isManagedArrayCopyCallee(callee) 'managedcopy'
		usage.usesManagedArrayCopy = true
	end 'managedcopy'
	// The three OPAQUE-`T` array copies (`__arr_slice_opaque`/`__arr_clone_opaque`/`__arr_append_opaque`, P1.7
	// slice 3b-vi-b-β). `isArrayRuntimeCallee` above already set `usesArray`/`usesHeap` (they are `__arr_`-
	// prefixed); THIS turns on the opaque-copy install AND `usesManagedArrayCopy`, because each wrapper's managed
	// branch calls the α `__arr_*_managed` helpers whose own install is gated on that bit.
	if isOpaqueArrayCopyCallee(callee) 'opaquecopy'
		usage.usesOpaqueArrayCopy = true
		usage.usesManagedArrayCopy = true
	end 'opaquecopy'
	// A per-type CLONER (`__clone_<T>`, P1.7 slice 3b-vi-b) — the CLONE twin of the `__destruct_<T>` arm above,
	// referenced through a `funcAddr(__clone_<T>)` element-cloner stamp. It frees no memory but ALLOCATES a box
	// (`usesHeap`), and its transitive `__str_clone`/`__arr_clone`/nested-cloner needs close through
	// `noteClonerUsage` (which has the signatures/interner to classify the fields).
	if bytesStartWith(callee, prefix: ClonerPrefix) 'structcloner'
		usage.usesHeap = true
		usage.neededCloners.insert(callee)
	end 'structcloner'
end 'recordCallUsage'

// ⭐ The P1.8 Slice D `CharacterSet` family's arm of the callee → usage-bit map — the
// `recordGraphemeUsage` twin, split out for the same reason: `recordCallUsage` stays a readable list of
// families. Direct references only; what each referenced body in turn needs is closed by
// `closeCharacterSetNeeds`.
function recordCharacterSetUsage(callee ByteArray, usage RuntimeUsage)
	if callee.equals(CharSetMakeName) 'make'
		usage.usesCharSetMake = true
	end 'make'
	if callee.equals(CharSetDecrefName) 'decref'
		usage.usesCharSetDecref = true
	end 'decref'
	if callee.equals(CharSetContainsName) 'contains'
		usage.usesCharSetContains = true
	end 'contains'
	if callee.equals(StrTrimName) 'trim'
		usage.usesStrTrim = true
	end 'trim'
	closeCharacterSetNeeds(usage)
end 'recordCharacterSetUsage'

// ⭐ **WHAT EACH `CharacterSet` BODY CALLS THAT THIS SCAN CANNOT SEE.** Declared here rather than
// discovered, exactly as the three sibling closures declare their families'. Run as a CLOSURE after every
// record so the answer cannot depend on the order in which the module happens to name its entry points.
function closeCharacterSetNeeds(usage RuntimeUsage)
	// The trim walks CLUSTERS (`__gr_end`), mints a `Character` per cluster (`__char_at`), drops each one
	// (`__str_decref`), probes the set (`__cs_contains`) and builds its result through the shared slice
	// producer (`__mm_alloc` + `__str_copy`).
	if usage.usesStrTrim 'trims'
		usage.usesCharSetContains = true
		usage.usesGraphemeEnd = true
		usage.usesCharAt = true
		usage.usesStrDecref = true
		usage.usesHeap = true
		usage.usesStrCopy = true
	end 'trims'
	// `__cs_contains` probes the member set, decodes the character's first codepoint, and classifies it.
	if usage.usesCharSetContains 'probes'
		usage.usesSet = true
		usage.usesHeap = true
		usage.usesUtf8Decode = true
		usage.usesUcdCategory = true
	end 'probes'
	// The box is one `__mm_alloc`; its drop releases the member set and reclaims the box.
	if usage.usesCharSetMake 'allocatesABox'
		usage.usesHeap = true
	end 'allocatesABox'
	if usage.usesCharSetDecref 'dropsASet'
		usage.usesSet = true
		usage.usesHeap = true
	end 'dropsASet'
end 'closeCharacterSetNeeds'

// ⭐ The P1.8 Slice B grapheme family's arm of the callee → usage-bit map — the `recordStringMethodUsage`
// twin, split out for the same reason: `recordCallUsage` stays a readable list of families. Direct
// references only; what each referenced body in turn needs is closed by `closeGraphemeNeeds`.
function recordGraphemeUsage(callee ByteArray, usage RuntimeUsage)
	if callee.equals(GbpName) 'gbp'
		usage.usesGbp = true
	end 'gbp'
	if callee.equals(ExtPictName) 'extpict'
		usage.usesExtPict = true
	end 'extpict'
	if callee.equals(Utf8CodepointAtName) or callee.equals(Utf8LengthAtName) 'utf8'
		usage.usesUtf8Decode = true
	end 'utf8'
	if callee.equals(GraphemeBreakName) or callee.equals(GraphemeStateName) 'grbreak'
		usage.usesGraphemeBreak = true
	end 'grbreak'
	if callee.equals(GraphemeEndName) 'grend'
		usage.usesGraphemeEnd = true
	end 'grend'
	if callee.equals(GraphemeCountName) 'grcount'
		usage.usesGraphemeCount = true
	end 'grcount'
	if callee.equals(CharAtName) 'charat'
		usage.usesCharAt = true
	end 'charat'
	if callee.equals(StrToBytesName) 'tobytes'
		usage.usesStrToBytes = true
	end 'tobytes'
	if callee.equals(StrToCodepointsName) 'tocodepoints'
		usage.usesStrToCodepoints = true
	end 'tocodepoints'
	if callee.equals(StrToUtf16Name) 'toutf16'
		usage.usesStrToUtf16 = true
	end 'toutf16'
	closeGraphemeNeeds(usage)
end 'recordGraphemeUsage'

// ⭐ The P1.8 Slice B2 `StringIndex` family's arm of the callee → usage-bit map — the
// `recordGraphemeUsage` twin, split out for the same reason: `recordCallUsage` stays a readable list of
// families. Direct references only; what each referenced body in turn needs is closed by
// `closeStringIndexNeeds`.
function recordStringIndexUsage(callee ByteArray, usage RuntimeUsage)
	if callee.equals(StrIndexMakeName) 'make'
		usage.usesStrIndexMake = true
	end 'make'
	if callee.equals(StrIndexEndName) 'end'
		usage.usesStrIndexEnd = true
	end 'end'
	if callee.equals(StrIndexByteToGraphemeName) 'bidx'
		usage.usesStrIndexByteToGrapheme = true
	end 'bidx'
	if callee.equals(StrIndexAdvanceName) 'advance'
		usage.usesStrIndexAdvance = true
	end 'advance'
	if callee.equals(StrIndexFirstName) 'first'
		usage.usesStrIndexFirst = true
	end 'first'
	if callee.equals(StrIndexLastName) 'last'
		usage.usesStrIndexLast = true
	end 'last'
	if callee.equals(StrIndexSliceName) 'slice'
		usage.usesStrIndexSlice = true
	end 'slice'
	closeStringIndexNeeds(usage)
end 'recordStringIndexUsage'

// ⭐ **WHAT EACH `StringIndex` BODY CALLS THAT THIS SCAN CANNOT SEE.** Declared here rather than
// discovered, exactly as `closeStringMethodNeeds` and `closeGraphemeNeeds` declare their families'.
// Run as a CLOSURE after every record so the answer cannot depend on the order in which the module
// happens to name its entry points — and the order matters here more than in either sibling, because
// this family reaches into BOTH of them (`__gr_end` below, `__str_find` beside).
//
// ⚠ It is run BEFORE the grapheme and string-method closures in `recordCallUsage`, so the bits it turns
// on there are themselves closed over by those two. Turning on `usesGraphemeEnd` after
// `closeGraphemeNeeds` had run would install `__gr_end` without the decoders and the classifier it calls.
function closeStringIndexNeeds(usage RuntimeUsage)
	// `__strix_end` counts the clusters; both searches turn a byte position into a grapheme index; and
	// every one of the four producers mints its box through the one door.
	if usage.usesStrIndexEnd 'countsClusters'
		usage.usesGraphemeCount = true
		usage.usesStrIndexMake = true
	end 'countsClusters'
	if usage.usesStrIndexFirst 'searchesForward'
		usage.usesStrFind = true
		usage.usesStrIndexByteToGrapheme = true
		usage.usesStrIndexMake = true
	end 'searchesForward'
	if usage.usesStrIndexLast 'searchesBackward'
		usage.usesStrRFind = true
		usage.usesStrIndexByteToGrapheme = true
		usage.usesStrIndexMake = true
	end 'searchesBackward'
	// Both conversions ARE the cluster walk (`emitGraphemeWalk`), so each pulls in the segmenter.
	if usage.usesStrIndexByteToGrapheme or usage.usesStrIndexAdvance 'walksClusters'
		usage.usesGraphemeEnd = true
	end 'walksClusters'
	// The box is one `__mm_alloc`; the slice builds a fused record and blits its bytes in.
	if usage.usesStrIndexMake 'allocatesABox'
		usage.usesHeap = true
	end 'allocatesABox'
	if usage.usesStrIndexSlice 'buildsAString'
		usage.usesHeap = true
		usage.usesStrCopy = true
	end 'buildsAString'
end 'closeStringIndexNeeds'

// ⭐ **WHAT EACH GRAPHEME BODY CALLS THAT THIS SCAN CANNOT SEE.** The family's members call each other from
// inside their SYNTHESIZED Std bodies, which walk no Maxon module — so the dependency is DECLARED here
// rather than discovered, exactly as `closeStringMethodNeeds` declares the String family's. Run as a
// CLOSURE after every record (rather than each arm listing its own transitive set) so the answer cannot
// depend on the order in which the module happens to name its entry points.
function closeGraphemeNeeds(usage RuntimeUsage)
	if usage.usesGraphemeCount 'countScans'
		usage.usesGraphemeEnd = true
	end 'countScans'
	// `__gr_end` decodes codepoints, classifies them and runs the rules — its whole general scan.
	if usage.usesGraphemeEnd 'scans'
		usage.usesUtf8Decode = true
		usage.usesGraphemeBreak = true
	end 'scans'
	// `__gr_break` asks `__ext_pict` for GB11; `__gr_state` asks it for the emoji-run flag.
	if usage.usesGraphemeBreak 'classifies'
		usage.usesExtPict = true
	end 'classifies'
	// Every scan classifies each codepoint through `__gbp`.
	if usage.usesGraphemeEnd 'needsProperty'
		usage.usesGbp = true
	end 'needsProperty'
	// `__char_at` builds a fresh owned inline record: one `__mm_alloc` plus a `__str_copy` blit.
	if usage.usesCharAt 'mintsCharacters'
		usage.usesHeap = true
		usage.usesStrCopy = true
	end 'mintsCharacters'
	// `__str_to_bytes` pushes into the caller's array.
	if usage.usesStrToBytes 'pushesBytes'
		usage.usesArray = true
		usage.usesHeap = true
	end 'pushesBytes'
	// The two decoding views push into the caller's array as well, and each walks the source through the
	// UTF-8 decoders — `__utf8_cp_at` for the value, `__utf8_len_at` for the step.
	if usage.usesStrToCodepoints or usage.usesStrToUtf16 'pushesDecodedUnits'
		usage.usesArray = true
		usage.usesHeap = true
		usage.usesUtf8Decode = true
	end 'pushesDecodedUnits'
end 'closeGraphemeNeeds'

// The P1.8 Slice C family's own arm of the callee → usage-bit map, split out so `recordCallUsage` stays a
// readable list of families rather than growing eight more inline arms. Direct references only; what each
// referenced body in turn needs is closed by `closeStringMethodNeeds`.
function recordStringMethodUsage(callee ByteArray, usage RuntimeUsage)
	if callee.equals(StrRangeEqName) 'rangeeq'
		usage.usesStrRangeEq = true
	end 'rangeeq'
	if callee.equals(StrFindName) 'find'
		usage.usesStrFind = true
	end 'find'
	if callee.equals(StrRFindName) 'rfind'
		usage.usesStrRFind = true
	end 'rfind'
	if callee.equals(StrStartsWithName) 'startswith'
		usage.usesStrStartsWith = true
	end 'startswith'
	if callee.equals(StrEndsWithName) 'endswith'
		usage.usesStrEndsWith = true
	end 'endswith'
	if callee.equals(StrContainsName) 'contains'
		usage.usesStrContains = true
	end 'contains'
	if callee.equals(StrMapCaseName) 'mapcase'
		usage.usesStrMapCase = true
	end 'mapcase'
	if callee.equals(StrReplaceName) 'replace'
		usage.usesStrReplace = true
	end 'replace'
	if callee.equals(StrSplitName) 'split'
		usage.usesStrSplit = true
	end 'split'
	if callee.equals(StrReplaceFirstName) 'replacefirst'
		usage.usesStrReplaceFirst = true
	end 'replacefirst'
	if callee.equals(StrFromBytesName) 'frombytes'
		usage.usesStrFromBytes = true
	end 'frombytes'
	closeStringMethodNeeds(usage)
end 'recordStringMethodUsage'

// ⭐ **WHAT EACH REFERENCED BODY CALLS THAT THIS SCAN CANNOT SEE.** The family's members call each other and
// the heap helpers from inside their SYNTHESIZED Std bodies, which walk no Maxon module — so the dependency
// is DECLARED here rather than discovered, exactly as `__str_append` declares its `__mm_alloc`/`__str_copy`.
// Run as a CLOSURE after every record (rather than each arm listing its own transitive set) so the answer
// cannot depend on the order in which the module happens to name its methods: `find`'s need for
// `__str_range_eq` is stated once and reached whether `find` was named directly or pulled in by `contains`.
function closeStringMethodNeeds(usage RuntimeUsage)
	if usage.usesStrContains or usage.usesStrReplace or usage.usesStrReplaceFirst or usage.usesStrSplit 'needsFind'
		usage.usesStrFind = true
	end 'needsFind'
	if usage.usesStrFind or usage.usesStrRFind or usage.usesStrStartsWith or usage.usesStrEndsWith 'needsRangeEq'
		usage.usesStrRangeEq = true
	end 'needsRangeEq'
	// `replace` and `split` answer a degenerate (empty) needle/delimiter with a CLONE of the receiver — the
	// one shape neither one's loop can produce, since an empty needle matches at every position.
	if usage.usesStrReplace or usage.usesStrReplaceFirst or usage.usesStrSplit 'clonesReceiver'
		usage.usesStrClone = true
	end 'clonesReceiver'
	// `split` PUSHES its segments into the array the parser created for it.
	if usage.usesStrSplit 'pushesSegments'
		usage.usesArray = true
	end 'pushesSegments'
	// Every string-BUILDING method allocates a fused record and blits bytes into it (`emitBuildOwnedInlineString`
	// ⇒ `__mm_alloc` + `__str_copy`), and `__str_clone` under them does the same.
	if usage.usesStrMapCase or usage.usesStrReplace or usage.usesStrReplaceFirst or usage.usesStrSplit or usage.usesStrFromBytes 'buildsStrings'
		usage.usesHeap = true
		usage.usesStrCopy = true
	end 'buildsStrings'
end 'closeStringMethodNeeds'

// Install the referenced String runtime functions into the lowered Std module. Called AFTER the
// pipeline (like `installMmRuntime`), so these are appended already-lowered and never re-optimized.
// Each is installed ONLY when referenced — vocabulary does not ship ahead of its consumer.
export function installStringRuntime(module StdModule, usage RuntimeUsage)
	if usage.usesPrint 'print'
		buildPrintString(module)
	end 'print'
	if usage.usesStrEq 'streq'
		buildStrEq(module, name: StrEqName)
	end 'streq'
	if usage.usesStrCopy 'strcopy'
		buildStrCopy(module)
	end 'strcopy'
	if usage.usesIntToString 'inttostr'
		buildIntToString(module)
	end 'inttostr'
	if usage.usesBoolToString 'booltostr'
		buildBoolToString(module)
	end 'booltostr'
	if usage.usesStrAppend 'strappend'
		buildStrAppend(module)
	end 'strappend'
	if usage.usesStrDecref 'strdecref'
		buildStrDecref(module)
	end 'strdecref'
	if usage.usesStrClone 'strclone'
		buildStrClone(module)
	end 'strclone'
	if usage.usesStrRangeEq 'strrangeeq'
		buildStrRangeEq(module)
	end 'strrangeeq'
	if usage.usesStrFind 'strfind'
		buildStrFind(module)
	end 'strfind'
	if usage.usesStrRFind 'strrfind'
		buildStrRFind(module)
	end 'strrfind'
	if usage.usesStrStartsWith 'strstartswith'
		buildStrAffixPredicate(module, name: StrStartsWithName, atTail: false)
	end 'strstartswith'
	if usage.usesStrEndsWith 'strendswith'
		buildStrAffixPredicate(module, name: StrEndsWithName, atTail: true)
	end 'strendswith'
	if usage.usesStrContains 'strcontains'
		buildStrContains(module)
	end 'strcontains'
	if usage.usesStrMapCase 'strmapcase'
		buildStrMapCase(module)
	end 'strmapcase'
	if usage.usesStrReplace 'strreplace'
		buildStrReplace(module)
	end 'strreplace'
	if usage.usesStrSplit 'strsplit'
		buildStrSplit(module)
	end 'strsplit'
	if usage.usesStrReplaceFirst 'strreplacefirst'
		buildStrReplaceFirst(module)
	end 'strreplacefirst'
	if usage.usesStrFromBytes 'strfrombytes'
		buildStrFromBytes(module)
	end 'strfrombytes'
end 'installStringRuntime'

// `__print_string(strPtr)` — write a String's bytes to stdout, no trailing newline.
//
// It loads `buffer@0` and `length@8` from the record and hands them to the `osWriteStdout` system op,
// which lowers per target — x64-windows to `GetStdHandle` + `WriteFile` through the IAT, arm64-macOS to
// a POSIX `write` through the GOT. The op is target-neutral, so this function names no OS symbol AND
// sets no frame size: `outgoingArgSize` (WriteFile's stack-arg space on x64, ZERO on arm64's all-register
// `write`) is a TARGET ABI fact, so each backend's isel sets it from the op it actually lowers
// (`StdToX64Conversion` bumps it for `osWriteStdout`; arm64 needs none). Setting it here would bake an
// x64 frame size into a target-neutral function — the leak that made the arm64 prologue panic.
function buildPrintString(module StdModule)
	var func = IrFunction.createFromStd(PrintStringName, returnType: StdReturnType.void, paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry")
	emitParams(module, block: entry, count: 1)
	let strPtr = 0 as ValueId

	let buffer = ids.mint()
	module.appendOp(entry, op: StdOp.loadIndirect(buffer, addrId: strPtr, offset: StringBufferOffset, valueType: StdType.i64))
	let length = ids.mint()
	module.appendOp(entry, op: StdOp.loadIndirect(length, addrId: strPtr, offset: StringLengthOffset, valueType: StdType.i64))
	module.appendOp(entry, op: StdOp.osWriteStdout(buffer, lenId: length))
	module.setTerminator(entry, op: StdOp.retVoid)

	module.functions.push(func)
end 'buildPrintString'

// `<name>(a, b) -> i64(bool)` — content equality: equal LENGTHS and equal BYTES. BOTH String operands are
// BORROWED (read through, never freed), so this allocation-free body is the equality both the `==` operator
// and the `Equatable` witness need.
//
// ⭐ **PARAMETERIZED BY NAME so ONE graph serves TWO symbols.** It is emitted under `__str_eq` for the `==`
// operator path (`installStringRuntime`) AND under `String.equals` for the `Equatable` witness path
// (`installBuiltinConformanceRuntime`), because the witness reloc names the impl `String.equals`
// (`qualifiedMethodName("String", "equals")`), NOT `__str_eq`. Same byte-compare, two `.text` symbols — the
// `buildIntEquals` pattern (which builds `int.equals` fresh), so the two paths cannot drift a byte apart.
//
// This is the bootstrap's `bytesEqual` (a length check, then a byte loop), NOT the enum `memcmp`
// helper. It allocates nothing. Empty strings: length 0 == length 0 → the loop runs zero times →
// return 1. The byte loop itself is `emitByteRangeCompareLoop` — shared with `__str_range_eq`, which
// P1.8 Slice C's positioned searches verify a candidate with; see that emitter for why it is a shared
// EMITTER and not a shared CALL.
// ⭐ **IT RETURNS `bool`, NOT A MACHINE WORD, AND THE WITNESS SLOT IS WHY** (P1.7a slice 2b-iv-B). Under the
// `String.equals` name this graph lands in an `Equatable` witness table, whose slot every dispatch site types
// from `Equatable.equals(other Self) returns bool` — so its declared result must be the one
// `builtinProtocolResultStdType` gives that declaration, an `i1`. Declared `i64` it agreed on the register
// targets (a `bool` rides a 64-bit register) and trapped `indirect call type mismatch` on wasm. The `__str_eq`
// name shares the declaration for the reason it shares the body: ONE graph cannot have two signatures, and
// the operator path already types its result `boolean` at the call site (`Parser.emitStringEquality`), so
// this is the type it was always claiming to return.
export function buildStrEq(module StdModule, name ByteArray)
	var func = IrFunction.createFromStd(name, returnType: StdReturnType.value(builtinProtocolResultStdType(BoolConformerName)), paramCount: 2, paramTypes: twoI64Params(), returnLine: 0)
	var ids = ValueMinter.create(2)

	var entry = module.addBlock(func, label: b"entry")
	var notEqual = module.addBlock(func, label: b"notEqual")
	var lenMatch = module.addBlock(func, label: b"lenMatch")
	var allMatch = module.addBlock(func, label: b"allMatch")

	emitParams(module, block: entry, count: 2)
	let a = 0 as ValueId
	let b = 1 as ValueId

	// entry: lengths differ ⇒ not equal; else fall into the byte loop.
	let aLen = emitLoadField(module, block: entry, record: a, offset: StringLengthOffset, ids: ids)
	let bLen = emitLoadField(module, block: entry, record: b, offset: StringLengthOffset, ids: ids)
	let lenEq = emitCmp(module, block: entry, a: aLen, b: bLen, pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(entry, op: StdOp.condBranch(lenEq, thenBlockId: lenMatch.id, elseBlockId: notEqual.id))

	// lenMatch: the buffers, then the shared byte loop over `aLen` bytes of each.
	let aBuf = emitLoadField(module, block: lenMatch, record: a, offset: StringBufferOffset, ids: ids)
	let bBuf = emitLoadField(module, block: lenMatch, record: b, offset: StringBufferOffset, ids: ids)
	emitByteRangeCompareLoop(module, func: func, cur: lenMatch, aBuf: aBuf, bBuf: bBuf, len: aLen, allMatch: allMatch, notEqual: notEqual, ids: ids)

	emitPredicateReturn(module, block: allMatch, value: StrPredicateTrue, ids: ids)
	emitPredicateReturn(module, block: notEqual, value: StrPredicateFalse, ids: ids)

	module.functions.push(func)
end 'buildStrEq'

// ⭐ **THE ONE BYTE-RANGE COMPARE LOOP.** Emit "every byte of `aBuf[0..len)` equals `bBuf[0..len)`" as a loop
// off `cur`: `cur` is terminated into a fresh header, a full match falls out to `allMatch`, and the first
// mismatching byte to `notEqual`. `len == 0` matches vacuously (the header guard is `i >= len`, true at once).
//
// ⚠ **SHARED BECAUSE TWO RUNTIME FUNCTIONS COMPARE BYTE RANGES**: `__str_eq` compares two whole records after
// a length check, and `__str_range_eq` compares two raw address ranges a search has already positioned. They
// were one loop written twice, with nothing making them agree — a widened load or a changed bound in one would
// silently leave the other reading a byte at a time on exactly one of the two paths.
//
// ⚠ It stays a shared EMITTER and does NOT become a `call __str_range_eq` from inside `__str_eq`: `==` on
// Strings is what the operator lowers to, and routing it through a call would buy this dedup at the price of a
// call per comparison. The duplication being removed is in the COMPILER's source, which is where it was.
//
// The loop index `i` is the header's phi — 0 from `cur`, `i+1` from the back edge — the on-the-fly SSA shape
// every runtime loop here builds directly, a runtime function having no parser. The phi's `argType` is set
// explicitly because `retypeBlockArgs` runs in `lowerMaxonToStd`, which these post-pipeline functions never
// pass through.
function emitByteRangeCompareLoop(module StdModule, func IrFunction, cur IrBlock, aBuf ValueId, bBuf ValueId, len ValueId, allMatch IrBlock, notEqual IrBlock, ids ValueMinter)
	var header = module.addBlock(func, label: b"cmphdr")
	var body = module.addBlock(func, label: b"cmpbody")

	let zero = emitConst(module, block: cur, value: 0, ids: ids)
	module.setTerminator(cur, op: StdOp.branch(header.id))

	let i = ids.mint()
	header.blockArgs.push(IrBlockArg.create(i, argType: StdType.i64))
	cur.branchEdges.push(BranchEdge.create(header.id, argIds: argsOf(zero)))

	let atEnd = emitCmp(module, block: header, a: i, b: len, pred: StdCmpPred.ge, ids: ids)
	module.setTerminator(header, op: StdOp.condBranch(atEnd, thenBlockId: allMatch.id, elseBlockId: body.id))

	// The compare is the LAST flag writer before the branch, so it fuses to a `jcc`.
	let aByte = emitLoadByteIndexed(module, block: body, base: aBuf, index: i, ids: ids)
	let bByte = emitLoadByteIndexed(module, block: body, base: bBuf, index: i, ids: ids)
	let one = emitConst(module, block: body, value: 1, ids: ids)
	let iNext = emitBin(module, block: body, a: i, b: one, opcode: StdBinOpcode.add, ids: ids)
	let byteEq = emitCmp(module, block: body, a: aByte, b: bByte, pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(body, op: StdOp.condBranch(byteEq, thenBlockId: header.id, elseBlockId: notEqual.id))
	body.branchEdges.push(BranchEdge.create(header.id, argIds: argsOf(iNext)))
end 'emitByteRangeCompareLoop'

// Terminate `block` by returning one of the two predicate words. Every String predicate ends in a pair of
// these, so "which constant means true" is written down once (`StrPredicateTrue`/`StrPredicateFalse`) and
// materialized once. A predicate returns a CONSTANT from its own block rather than the `cmp`'s flag value
// directly — `buildArrIsEmpty`'s shape, and the one the backend has always been exercised on.
function emitPredicateReturn(module StdModule, block IrBlock, value ParsedInt, ids ValueMinter)
	let result = emitConst(module, block: block, value: value, ids: ids)
	module.setTerminator(block, op: StdOp.ret(result))
end 'emitPredicateReturn'

// ⭐ **ONE BYTE AT `addr` — THE `u8` LOAD SPELLING FOR EVERY RUNTIME BUILDER**, so a widened read is a
// one-line change rather than a sweep of every byte-walking loop. Exported because `GraphemeRuntime`'s
// decoders and its segmenter walk bytes too: they had their own copy of these two, which is the shape
// this comment claimed to prevent — two files each owning "the ONE spelling".
export function emitLoadByteAt(module StdModule, block IrBlock, addr ValueId, ids ValueMinter) returns ValueId
	let v = ids.mint()
	module.appendOp(block, op: StdOp.loadIndirect(v, addrId: addr, offset: 0, valueType: StdType.u8))
	return v
end 'emitLoadByteAt'

// One byte at `base[index]` — the address add plus the `u8` load, the shape every byte-walking loop that
// does NOT also need the address repeats (the compare loop's two operands, the search's first-byte probe,
// the grapheme runtime's byte-view fill). Exported for `emitLoadByteAt`'s reason.
export function emitLoadByteIndexed(module StdModule, block IrBlock, base ValueId, index ValueId, ids ValueMinter) returns ValueId
	return emitLoadByteAt(module, block: block, addr: emitBin(module, block: block, a: base, b: index, opcode: StdBinOpcode.add, ids: ids), ids: ids)
end 'emitLoadByteIndexed'

// `__str_copy(dest, src, len)` — blit `len` bytes from `src` into `dest`. The one thing an interpolation
// does with every part: each part is materialized to a `(buffer, length)` pair and copied into the fused
// result buffer at a running cursor. A byte loop rather than a `rep movsb`/memcpy op because there is no
// memory-move op in the Std tier (`system` holds only `osAllocPages`/`osWriteStdout`), and a byte loop
// needs nothing the tier lacks. `len == 0` copies nothing (the header guard is `i >= len`, true at once).
//
// The loop index `i` is the header's phi — 0 from entry, `i+1` from the back edge — the same on-the-fly
// SSA shape `buildStrEq` builds directly because a runtime function has no parser.
function buildStrCopy(module StdModule)
	var func = IrFunction.createFromStd(StrCopyName, returnType: StdReturnType.void, paramCount: 3, paramTypes: threeI64Params(), returnLine: 0)
	var ids = ValueMinter.create(3)

	var entry = module.addBlock(func, label: b"entry")
	var header = module.addBlock(func, label: b"header")
	var body = module.addBlock(func, label: b"body")
	var done = module.addBlock(func, label: b"done")

	emitParams(module, block: entry, count: 3)
	let dest = 0 as ValueId
	let src = 1 as ValueId
	let len = 2 as ValueId

	let zero = ids.mint()
	module.appendOp(entry, op: StdOp.const(zero, value: 0, valueType: StdType.i64))
	module.setTerminator(entry, op: StdOp.branch(header.id))

	let i = ids.mint()
	header.blockArgs.push(IrBlockArg.create(i, argType: StdType.i64))
	entry.branchEdges.push(BranchEdge.create(header.id, argIds: argsOf(zero)))

	let atEnd = ids.mint()
	module.appendOp(header, op: StdOp.cmp(atEnd, lhs: i, rhs: len, pred: StdCmpPred.ge, operandType: StdType.i64))
	module.setTerminator(header, op: StdOp.condBranch(atEnd, thenBlockId: done.id, elseBlockId: body.id))

	let srcAddr = ids.mint()
	module.appendOp(body, op: StdOp.binOp(srcAddr, lhs: src, rhs: i, opcode: StdBinOpcode.add, operandType: StdType.i64))
	let srcByte = ids.mint()
	module.appendOp(body, op: StdOp.loadIndirect(srcByte, addrId: srcAddr, offset: 0, valueType: StdType.u8))
	let dstAddr = ids.mint()
	module.appendOp(body, op: StdOp.binOp(dstAddr, lhs: dest, rhs: i, opcode: StdBinOpcode.add, operandType: StdType.i64))
	module.appendOp(body, op: StdOp.storeIndirect(dstAddr, offset: 0, valueId: srcByte, valueType: StdType.u8))
	let one = ids.mint()
	module.appendOp(body, op: StdOp.const(one, value: 1, valueType: StdType.i64))
	let iNext = ids.mint()
	module.appendOp(body, op: StdOp.binOp(iNext, lhs: i, rhs: one, opcode: StdBinOpcode.add, operandType: StdType.i64))
	module.setTerminator(body, op: StdOp.branch(header.id))
	body.branchEdges.push(BranchEdge.create(header.id, argIds: argsOf(iNext)))

	module.setTerminator(done, op: StdOp.retVoid)

	module.functions.push(func)
end 'buildStrCopy'

// `__int_to_string(value, dest) -> len` — render `value`'s signed decimal text into `dest`, returning the
// byte count written (never a NUL — the caller's buffer is zeroed and it copies exactly `len` bytes).
//
// ⭐ IT NEVER NEGATES, so `i64.min` needs no special case. `neg = value >>logical 63` is the sign bit as a
// 0/1. A leading `-` is written UNCONDITIONALLY at `dest[0]` and then OVERWRITTEN by the most-significant
// digit when the value is non-negative (that digit lands at `dest[start]` with `start = neg = 0`), so the
// sign costs no branch. Each digit is `value % 10` — which carries the value's sign — turned positive by
// MULTIPLYING by `sign = 1 - 2*neg` (`+1`/`-1`), again avoiding the `abs` that `i64.min` would overflow.
//
// Values dominating from `entry`/`setup` (`value`, `dest`, `neg`, `sign`) are read directly in the loop
// blocks those dominate; only the loop-variant `digits`/`v`/`pos` ride block-args. `len` is computed once
// in `writeSetup`, which dominates `done`.
function buildIntToString(module StdModule)
	var func = IrFunction.createFromStd(IntToStringName, returnType: StdReturnType.value(StdType.i64), paramCount: 2, paramTypes: twoI64Params(), returnLine: 0)
	var ids = ValueMinter.create(2)

	var entry = module.addBlock(func, label: b"entry")
	var zeroCase = module.addBlock(func, label: b"zeroCase")
	var setup = module.addBlock(func, label: b"setup")
	var countLoop = module.addBlock(func, label: b"countLoop")
	var writeSetup = module.addBlock(func, label: b"writeSetup")
	// The write loop is HEADER-GUARDED (test at the top), following `buildStrEq`/`buildStrCopy`'s shape so
	// the three string builders read the same way. It is a STYLE choice, not a correctness one. A fused
	// loop-test `cmp` whose boolean is a function's highest-numbered value once tripped the value-class
	// column — `setValueClass` sized it off the target OPERANDS, and a flags-only compare is not among them
	// — and this shape happened to dodge it by keeping the loop body's values minted last. That column now
	// GROWS to cover every DEFINED id (see `setValueClass` in StdToX64Conversion), so the dodge is
	// unnecessary and a bottom-tested loop would compile too; the shared shape stays for consistency.
	var writeHeader = module.addBlock(func, label: b"writeHeader")
	var writeBody = module.addBlock(func, label: b"writeBody")
	var done = module.addBlock(func, label: b"done")

	emitParams(module, block: entry, count: 2)
	let value = 0 as ValueId
	let dest = 1 as ValueId

	// entry: `value == 0` prints a lone '0' (the count/write loops assume at least one non-zero step).
	let zeroConst = ids.mint()
	module.appendOp(entry, op: StdOp.const(zeroConst, value: 0, valueType: StdType.i64))
	let isZero = ids.mint()
	module.appendOp(entry, op: StdOp.cmp(isZero, lhs: value, rhs: zeroConst, pred: StdCmpPred.eq, operandType: StdType.i64))
	module.setTerminator(entry, op: StdOp.condBranch(isZero, thenBlockId: zeroCase.id, elseBlockId: setup.id))

	let zeroDigitConst = ids.mint()
	module.appendOp(zeroCase, op: StdOp.const(zeroDigitConst, value: AsciiZeroDigit, valueType: StdType.i64))
	module.appendOp(zeroCase, op: StdOp.storeIndirect(dest, offset: 0, valueId: zeroDigitConst, valueType: StdType.u8))
	let oneLen = ids.mint()
	module.appendOp(zeroCase, op: StdOp.const(oneLen, value: 1, valueType: StdType.i64))
	module.setTerminator(zeroCase, op: StdOp.ret(oneLen))

	// setup: derive `neg` (0/1) and `sign` (+1/-1), and write the provisional '-' at dest[0].
	let signBitConst = ids.mint()
	module.appendOp(setup, op: StdOp.const(signBitConst, value: SignBitPosition, valueType: StdType.i64))
	let neg = ids.mint()
	module.appendOp(setup, op: StdOp.binOp(neg, lhs: value, rhs: signBitConst, opcode: StdBinOpcode.shrLogical, operandType: StdType.i64))
	let minusConst = ids.mint()
	module.appendOp(setup, op: StdOp.const(minusConst, value: AsciiMinusSign, valueType: StdType.i64))
	module.appendOp(setup, op: StdOp.storeIndirect(dest, offset: 0, valueId: minusConst, valueType: StdType.u8))
	let spanConst = ids.mint()
	module.appendOp(setup, op: StdOp.const(spanConst, value: SignMultiplierSpan, valueType: StdType.i64))
	let twoNeg = ids.mint()
	module.appendOp(setup, op: StdOp.binOp(twoNeg, lhs: spanConst, rhs: neg, opcode: StdBinOpcode.mul, operandType: StdType.i64))
	let signBaseConst = ids.mint()
	module.appendOp(setup, op: StdOp.const(signBaseConst, value: SignMultiplierBase, valueType: StdType.i64))
	let sign = ids.mint()
	module.appendOp(setup, op: StdOp.binOp(sign, lhs: signBaseConst, rhs: twoNeg, opcode: StdBinOpcode.sub, operandType: StdType.i64))
	let digitsZero = ids.mint()
	module.appendOp(setup, op: StdOp.const(digitsZero, value: 0, valueType: StdType.i64))
	module.setTerminator(setup, op: StdOp.branch(countLoop.id))

	// countLoop(digits, v): count decimal digits — do { v = v/10; digits += 1 } while v != 0.
	let digits = ids.mint()
	let v = ids.mint()
	countLoop.blockArgs.push(IrBlockArg.create(digits, argType: StdType.i64))
	countLoop.blockArgs.push(IrBlockArg.create(v, argType: StdType.i64))
	setup.branchEdges.push(BranchEdge.create(countLoop.id, argIds: twoArgs(digitsZero, second: value)))

	let radixCount = ids.mint()
	module.appendOp(countLoop, op: StdOp.const(radixCount, value: DecimalRadix, valueType: StdType.i64))
	let vNext = ids.mint()
	module.appendOp(countLoop, op: StdOp.div(vNext, lhs: v, rhs: radixCount))
	let oneCount = ids.mint()
	module.appendOp(countLoop, op: StdOp.const(oneCount, value: 1, valueType: StdType.i64))
	let digitsNext = ids.mint()
	module.appendOp(countLoop, op: StdOp.binOp(digitsNext, lhs: digits, rhs: oneCount, opcode: StdBinOpcode.add, operandType: StdType.i64))
	let countZero = ids.mint()
	module.appendOp(countLoop, op: StdOp.const(countZero, value: 0, valueType: StdType.i64))
	let countDone = ids.mint()
	module.appendOp(countLoop, op: StdOp.cmp(countDone, lhs: vNext, rhs: countZero, pred: StdCmpPred.eq, operandType: StdType.i64))
	module.setTerminator(countLoop, op: StdOp.condBranch(countDone, thenBlockId: writeSetup.id, elseBlockId: countLoop.id))
	countLoop.branchEdges.push(BranchEdge.create(countLoop.id, argIds: twoArgs(digitsNext, second: vNext)))

	// writeSetup: len = digits + neg; the last write position is len - 1. `digitsNext` is read straight —
	// `countLoop` defines it and dominates `writeSetup`, so the last iteration's count reaches here with no
	// exit phi (only the loop-carried `digits`/`v` recurrence needs a header phi). Then fall into the write
	// loop with the cursor at `lastPos` and the value to render.
	let len = ids.mint()
	module.appendOp(writeSetup, op: StdOp.binOp(len, lhs: digitsNext, rhs: neg, opcode: StdBinOpcode.add, operandType: StdType.i64))
	let oneWrite = ids.mint()
	module.appendOp(writeSetup, op: StdOp.const(oneWrite, value: 1, valueType: StdType.i64))
	let lastPos = ids.mint()
	module.appendOp(writeSetup, op: StdOp.binOp(lastPos, lhs: len, rhs: oneWrite, opcode: StdBinOpcode.sub, operandType: StdType.i64))
	module.setTerminator(writeSetup, op: StdOp.branch(writeHeader.id))

	// writeHeader(pos, wv): stop when `wv == 0` — every digit has been consumed. The top-tested guard is
	// what keeps `writeBody`'s materialized values (not this `cmp`) the last minted; see the block header.
	let pos = ids.mint()
	let wv = ids.mint()
	writeHeader.blockArgs.push(IrBlockArg.create(pos, argType: StdType.i64))
	writeHeader.blockArgs.push(IrBlockArg.create(wv, argType: StdType.i64))
	writeSetup.branchEdges.push(BranchEdge.create(writeHeader.id, argIds: twoArgs(lastPos, second: value)))

	let writeZero = ids.mint()
	module.appendOp(writeHeader, op: StdOp.const(writeZero, value: 0, valueType: StdType.i64))
	let writeDone = ids.mint()
	module.appendOp(writeHeader, op: StdOp.cmp(writeDone, lhs: wv, rhs: writeZero, pred: StdCmpPred.eq, operandType: StdType.i64))
	module.setTerminator(writeHeader, op: StdOp.condBranch(writeDone, thenBlockId: done.id, elseBlockId: writeBody.id))

	// writeBody: dest[pos] = '0' + (wv % 10)*sign, then wv /= 10, pos -= 1, and back to the header. `pos`
	// and `wv` are read straight from `writeHeader`, which dominates this block.
	let radixWrite = ids.mint()
	module.appendOp(writeBody, op: StdOp.const(radixWrite, value: DecimalRadix, valueType: StdType.i64))
	let digit = ids.mint()
	module.appendOp(writeBody, op: StdOp.mod(digit, lhs: wv, rhs: radixWrite))
	let digitAbs = ids.mint()
	module.appendOp(writeBody, op: StdOp.binOp(digitAbs, lhs: digit, rhs: sign, opcode: StdBinOpcode.mul, operandType: StdType.i64))
	let asciiZero = ids.mint()
	module.appendOp(writeBody, op: StdOp.const(asciiZero, value: AsciiZeroDigit, valueType: StdType.i64))
	let digitChar = ids.mint()
	module.appendOp(writeBody, op: StdOp.binOp(digitChar, lhs: digitAbs, rhs: asciiZero, opcode: StdBinOpcode.add, operandType: StdType.i64))
	let writeAddr = ids.mint()
	module.appendOp(writeBody, op: StdOp.binOp(writeAddr, lhs: dest, rhs: pos, opcode: StdBinOpcode.add, operandType: StdType.i64))
	module.appendOp(writeBody, op: StdOp.storeIndirect(writeAddr, offset: 0, valueId: digitChar, valueType: StdType.u8))
	let wvRadix = ids.mint()
	module.appendOp(writeBody, op: StdOp.const(wvRadix, value: DecimalRadix, valueType: StdType.i64))
	let wvNext = ids.mint()
	module.appendOp(writeBody, op: StdOp.div(wvNext, lhs: wv, rhs: wvRadix))
	let oneWriteStep = ids.mint()
	module.appendOp(writeBody, op: StdOp.const(oneWriteStep, value: 1, valueType: StdType.i64))
	let posNext = ids.mint()
	module.appendOp(writeBody, op: StdOp.binOp(posNext, lhs: pos, rhs: oneWriteStep, opcode: StdBinOpcode.sub, operandType: StdType.i64))
	module.setTerminator(writeBody, op: StdOp.branch(writeHeader.id))
	writeBody.branchEdges.push(BranchEdge.create(writeHeader.id, argIds: twoArgs(posNext, second: wvNext)))

	module.setTerminator(done, op: StdOp.ret(len))

	module.functions.push(func)
end 'buildIntToString'

// `__bool_to_string(value, dest) -> len` — render a bool as "true" (4 bytes) or "false" (5). The value is
// 0 or 1, so a single branch picks the rendering; each branch writes its bytes with fixed offsets and
// returns its length. The last value minted in each branch is the length const (returned, so materialized),
// never the entry `cmp`, so the value-class column is sized right (see `buildIntToString`'s header).
function buildBoolToString(module StdModule)
	var func = IrFunction.createFromStd(BoolToStringName, returnType: StdReturnType.value(StdType.i64), paramCount: 2, paramTypes: twoI64Params(), returnLine: 0)
	var ids = ValueMinter.create(2)

	var entry = module.addBlock(func, label: b"entry")
	var trueCase = module.addBlock(func, label: b"trueCase")
	var falseCase = module.addBlock(func, label: b"falseCase")

	emitParams(module, block: entry, count: 2)
	let value = 0 as ValueId
	let dest = 1 as ValueId

	let zeroConst = ids.mint()
	module.appendOp(entry, op: StdOp.const(zeroConst, value: 0, valueType: StdType.i64))
	let isFalse = ids.mint()
	module.appendOp(entry, op: StdOp.cmp(isFalse, lhs: value, rhs: zeroConst, pred: StdCmpPred.eq, operandType: StdType.i64))
	module.setTerminator(entry, op: StdOp.condBranch(isFalse, thenBlockId: falseCase.id, elseBlockId: trueCase.id))

	storeConstByte(module, block: trueCase, ids: ids, dest: dest, offset: 0 as ByteOffset, charValue: AsciiLowerT)
	storeConstByte(module, block: trueCase, ids: ids, dest: dest, offset: 1 as ByteOffset, charValue: AsciiLowerR)
	storeConstByte(module, block: trueCase, ids: ids, dest: dest, offset: 2 as ByteOffset, charValue: AsciiLowerU)
	storeConstByte(module, block: trueCase, ids: ids, dest: dest, offset: 3 as ByteOffset, charValue: AsciiLowerE)
	let trueLen = ids.mint()
	module.appendOp(trueCase, op: StdOp.const(trueLen, value: BoolTrueLength, valueType: StdType.i64))
	module.setTerminator(trueCase, op: StdOp.ret(trueLen))

	storeConstByte(module, block: falseCase, ids: ids, dest: dest, offset: 0 as ByteOffset, charValue: AsciiLowerF)
	storeConstByte(module, block: falseCase, ids: ids, dest: dest, offset: 1 as ByteOffset, charValue: AsciiLowerA)
	storeConstByte(module, block: falseCase, ids: ids, dest: dest, offset: 2 as ByteOffset, charValue: AsciiLowerL)
	storeConstByte(module, block: falseCase, ids: ids, dest: dest, offset: 3 as ByteOffset, charValue: AsciiLowerS)
	storeConstByte(module, block: falseCase, ids: ids, dest: dest, offset: 4 as ByteOffset, charValue: AsciiLowerE)
	let falseLen = ids.mint()
	module.appendOp(falseCase, op: StdOp.const(falseLen, value: BoolFalseLength, valueType: StdType.i64))
	module.setTerminator(falseCase, op: StdOp.ret(falseLen))

	module.functions.push(func)
end 'buildBoolToString'

// `__str_append(self, other)` — grow `self` in place by `other`'s bytes. The first time a shv2 String's
// bytes leave the inline/rdata region (Wave D), so the FIRST real exercise of the leak gate on a non-inline
// allocation. Adapted from v1's `__managed_mem_cow_check`+`grow` (`stdlib/Internals.maxon:3432-3491`) to
// shv2's fused record and static single-owner model (no refcount on the detach path).
//
// ⭐ **ONE TEST DECIDES THE DETACH — `emitBufferCannotHold`, WHICH IS THE SHARED ENCODING'S OWN, NOT A
// SECOND SPELLING OF "IS THIS BUFFER MINE?".** The bytes must move to a fresh external buffer whenever
// `capacity@16 < requiredLen`, and that single comparison covers the ordinary grow AND every non-owned
// buffer at once. WHY it covers the second is not stated here: it is a property of the capacity values,
// so it is written where they are declared (`BufferOwnership`), against a type that stops at `-1` so a
// provenance CANNOT be added that slips past this test. `requiredLen = selfLen + otherLen` is this
// function's half of that contract — a sum of two `length@8` byte counts, hence never negative.
//
// ⚠ **THE OLD ALLOCATION IS RELEASED THROUGH THE SHARED PAIR, AND ONLY AFTER BOTH COPIES ARE DONE.**
// `emitOwedAllocationBase` says WHICH allocation the record owes a release to before the detach republishes
// the fields that answer it (an inline String owes nothing — its bytes are in its own box), and
// `emitReleaseOwedBase` pays it, null-guarded, once the blit has finished reading. ⭐ The release rides a
// BLOCK ARG into `blit` (0 on the in-place edge) rather than happening in the detach block, and that is
// load-bearing rather than tidy: `s.append(s)` aliases `other` to `self`'s OLD buffer, so releasing before
// the blit is a read-after-release. It is invisible today — `__mm_free` reclaims nothing under the bump
// allocator (PLAN.md #108) — and it is a use-after-free the day it does.
//
// ⚠ **THE INVARIANT THIS RUNG USED TO SPELL AS `parent@32 == -1` IS UNCHANGED IN BEHAVIOUR**: a String
// that has detached owns an external buffer and must release it, and one whose bytes are inline or in
// `.rdata` must not. What changed is only WHERE that is written down — `capacity@16 >= 0` plus
// `emitOwedAllocationBase`, the same encoding the Array record reads — so a String and an Array can no longer
// disagree about what a record owns. Leave it wrong and the external buffer is never freed (a leak, exit
// 101) or an interior pointer is released (an over-release, also 101).
//
// ⭐⭐ **GROWTH IS GEOMETRIC (`2 * requiredLen`), AND IT HAD TO BECOME SO: EXACT GROWTH MADE THE
// COMMONEST STRING IDIOM IN THE LANGUAGE QUADRATIC.** Exact growth means the buffer is full the instant
// it is published, so the NEXT append fails `capacity < requiredLen` again, reallocates, and re-copies
// every byte written so far — `var s = ""` plus a loop of appends copies O(n²) bytes and makes one
// allocation per append. MEASURED, before this, with `Testing/ladders/genstring.sh <n> data-appendloop`:
// 2,048 → 32,768 chunks of 9 bytes read **×3.94 ×4.07 ×3.82 ×3.88** per doubling — a clean quadratic —
// and the top rung took **5.0 seconds to build a 288 KB string**. Doubling the ask makes the copies
// geometric and the whole build amortized O(n); the same ladder reads ×2 after.
//
// ⭐ **`2 * requiredLen` RATHER THAN `max(requiredLen, 2 * capacity)`, AND THE REASON IS THE BRANCH.**
// `requiredLen = selfLen + otherLen >= selfLen`, so doubling it is unconditionally big enough for both the
// bytes being written now and a growth factor over what was there before — no comparison, no extra block,
// no phi, in a runtime graph that gets real register allocation. A `max` would buy a tighter bound on one
// enormous single append and pay for it on every ordinary one.
//
// ⚠ **NOTHING ELSE READS `capacity@16` AS "THE SIZE OF THE ALLOCATION"** — that is what makes an
// over-allocation safe rather than merely convenient. `emitBufferNotOwned` asks only its SIGN, and
// `2 * requiredLen` of a non-negative sum stays non-negative; `emitBufferCannotHold` asks only whether it
// is below the next `requiredLen`; and the release path takes `buffer@0` (the pointer `__mm_alloc`
// returned) through `emitOwedAllocationBase`, so `__mm_free` reclaims whatever was actually allocated and
// never consults this field. `length@8` remains the byte count every reader uses, so the slack bytes are
// invisible to `print`, to `==`, and to every method in this file. The alloc/free COUNT is still trivially
// balanced — one allocation per detach, as before; there are simply far fewer detaches.
function buildStrAppend(module StdModule)
	var func = IrFunction.createFromStd(StrAppendName, returnType: StdReturnType.void, paramCount: 2, paramTypes: twoI64Params(), returnLine: 0)
	var ids = ValueMinter.create(2)

	var entry = module.addBlock(func, label: b"entry")
	var inPlace = module.addBlock(func, label: b"inPlace")
	var detach = module.addBlock(func, label: b"detach")
	var baseJoin = module.addBlock(func, label: b"baseJoin")
	var blit = module.addBlock(func, label: b"blit")
	var clearAscii = module.addBlock(func, label: b"clearAscii")
	let done = module.addBlock(func, label: b"done")

	emitParams(module, block: entry, count: 2)
	let selfPtr = 0 as ValueId
	let otherPtr = 1 as ValueId

	// entry: load the fields every block reads (entry dominates all of them, so these need no phi),
	// compute the required length, and branch on whether the buffer already has room for it.
	let selfLen = emitLoadField(module, block: entry, record: selfPtr, offset: StringLengthOffset, ids: ids)
	let selfBuf = emitLoadField(module, block: entry, record: selfPtr, offset: StringBufferOffset, ids: ids)
	let otherLen = emitLoadField(module, block: entry, record: otherPtr, offset: StringLengthOffset, ids: ids)
	let otherBuf = emitLoadField(module, block: entry, record: otherPtr, offset: StringBufferOffset, ids: ids)
	let otherAscii = emitLoadField(module, block: entry, record: otherPtr, offset: StringIsAsciiOffset, ids: ids)
	let requiredLen = emitBin(module, block: entry, a: selfLen, b: otherLen, opcode: StdBinOpcode.add, ids: ids)
	let tooSmall = emitBufferCannotHold(module, block: entry, record: selfPtr, slots: stringBufferSlots(), requiredLen: requiredLen, ids: ids)
	module.setTerminator(entry, op: StdOp.condBranch(tooSmall, thenBlockId: detach.id, elseBlockId: inPlace.id))

	// The allocation the blit owes a release to once it has finished reading: the pre-detach one, or none
	// at all when the bytes go into the buffer that is already there.
	let owedBase = ids.mint()
	blit.blockArgs.push(IrBlockArg.create(owedBase, argType: StdType.i64))

	let owesNothing = emitConst(module, block: inPlace, value: NoOwedAllocation, ids: ids)
	module.setTerminator(inPlace, op: StdOp.branch(blit.id))
	inPlace.branchEdges.push(BranchEdge.create(blit.id, argIds: argsOf(owesNothing)))

	// detach: read what the record owes BEFORE the publish below overwrites the fields that answer it.
	let base = emitOwedAllocationBase(module, func: func, cur: detach, join: baseJoin, record: selfPtr, slots: stringBufferSlots(), ids: ids)

	// baseJoin: allocate a fresh external buffer (destructor 0 — raw bytes), copy the live bytes across,
	// and publish it. The ask is GEOMETRIC — see the growth note above — and the SAME value is both
	// allocated and published as `capacity@16`, so the field says exactly how far the next append may
	// write in place. `parent@32` returns to `NoOwedAllocation`: a record that has just copied its bytes
	// into an allocation of its own owes nothing to anyone else, exactly as `__arr_cow_detach` leaves it.
	let zeroDtor = emitConst(module, block: baseJoin, value: 0, ids: ids)
	let grownLen = emitBin(module, block: baseJoin, a: requiredLen, b: requiredLen, opcode: StdBinOpcode.add, ids: ids)
	let newBuf = ids.mint()
	module.appendOp(baseJoin, op: StdOp.call(newBuf, callee: MmAllocName, args: twoArgs(grownLen, second: zeroDtor)))
	let copied = ids.mint()
	module.appendOp(baseJoin, op: StdOp.call(copied, callee: StrCopyName, args: threeArgs(newBuf, second: selfBuf, third: selfLen)))
	emitStoreField(module, block: baseJoin, record: selfPtr, offset: StringBufferOffset, value: newBuf)
	emitStoreField(module, block: baseJoin, record: selfPtr, offset: StringCapacityOffset, value: grownLen)
	let noParent = emitConst(module, block: baseJoin, value: NoOwedAllocation, ids: ids)
	emitStoreField(module, block: baseJoin, record: selfPtr, offset: StringParentPtrOffset, value: noParent)
	module.setTerminator(baseJoin, op: StdOp.branch(blit.id))
	baseJoin.branchEdges.push(BranchEdge.create(blit.id, argIds: argsOf(base)))

	// blit: append `other`'s bytes at the end of `self`'s CURRENT buffer (reloaded, since detach may have
	// replaced it) using the OLD length as the write cursor, then publish the new length. Reached in place
	// and grown alike. Only now is the old allocation released — see the aliasing note above.
	let curBuf = emitLoadField(module, block: blit, record: selfPtr, offset: StringBufferOffset, ids: ids)
	let dstAddr = emitBin(module, block: blit, a: curBuf, b: selfLen, opcode: StdBinOpcode.add, ids: ids)
	let blitted = ids.mint()
	module.appendOp(blit, op: StdOp.call(blitted, callee: StrCopyName, args: threeArgs(dstAddr, second: otherBuf, third: otherLen)))
	emitStoreField(module, block: blit, record: selfPtr, offset: StringLengthOffset, value: requiredLen)
	var afterRelease = emitReleaseOwedBase(module, func: func, cur: blit, base: owedBase, callee: MmDecrefName, ids: ids)

	// afterRelease: `isAscii` is maintained incrementally — the concatenation stays ASCII only if `other` is.
	let zeroAscii = emitConst(module, block: afterRelease, value: AsciiFlagFalse, ids: ids)
	let otherNonAscii = emitCmp(module, block: afterRelease, a: otherAscii, b: zeroAscii, pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(afterRelease, op: StdOp.condBranch(otherNonAscii, thenBlockId: clearAscii.id, elseBlockId: done.id))

	// clearAscii: `other` carried a non-ASCII byte, so the result is not ASCII.
	emitStoreField(module, block: clearAscii, record: selfPtr, offset: StringIsAsciiOffset, value: zeroAscii)
	module.setTerminator(clearAscii, op: StdOp.branch(done.id))

	module.setTerminator(done, op: StdOp.retVoid)

	module.functions.push(func)
end 'buildStrAppend'

// `__str_decref(record)` — a String's DROP. It is `__mm_decref` (dec the refcount; free at the last
// owner) plus the one thing the generic decref structurally cannot do: release the EXTERNAL buffer of a
// detached String BEFORE the record. The parser routes every owned-String drop here by TAG (`emitDecref`),
// so a struct box and a raw scratch buffer still drop through `__mm_decref`; only a String record, which
// alone carries the buffer-ownership encoding, drops through here.
//
// ⭐ **STATIC DISPATCH, NOT A DESTRUCTOR POINTER.** The record stores NO destructor — the parser knows the
// static type at every drop, so there is nothing to dispatch dynamically, and `funcAddr`/`callIndirect`
// stay deferred until a struct/array FIELD can hold a String (P1.4+), where a box's own `__mm_free` must
// reach a destructor it cannot name. Shipping the indirect-call vocabulary now would be vocabulary ahead
// of its forcing consumer — the mistake `__mm_incref` and `mintPhi` are the standing warnings against.
//
// The refcount read-modify-write is the shared `emitRefcountCheckToLastOwner` (load rc; `== 0` ⇒ last
// owner; else lower and keep) — the ONE home of the refcount protocol, so a String and a struct box
// cannot disagree about who the last owner is. `__str_decref` runs that shared check itself, rather
// than calling `__mm_decref` at runtime, because it must read `parent`/`buffer` out of the record on
// the last-owner path BEFORE that record is freed — the generic decref would reclaim the box first.
function buildStrDecref(module StdModule)
	var func = IrFunction.createFromStd(StrDecrefName, returnType: StdReturnType.void, paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry")
	var lower = module.addBlock(func, label: b"lower")
	var release = module.addBlock(func, label: b"release")
	var baseJoin = module.addBlock(func, label: b"baseJoin")
	var freeRec = module.addBlock(func, label: b"freeRec")

	emitParams(module, block: entry, count: 1)
	let record = 0 as ValueId

	// entry + lower: the shared refcount check. `rc == 0` (the last owner) branches to `release`, where a
	// String does the one thing the generic decref structurally cannot — release a detached buffer first.
	emitRefcountCheckToLastOwner(module, entry: entry, lower: lower, record: record, lastOwner: release, ids: ids)

	// release + baseJoin: the last owner asks the shared pair which separate allocation this record owes a
	// release to and pays it, BEFORE the record itself dies — the whole reason this cannot simply call
	// `__mm_decref`, which would reclaim the box while its `capacity`/`buffer` are still the answer. A
	// String that detached is an OWNER (`capacity@16 >= 0`) and owes its own `buffer@0`; one whose bytes are
	// inline (or in an immortal `.rdata` blob) has a negative capacity and leaves through the `parent@32`
	// arm holding `NoOwedAllocation`, which the null guard inside the release step turns into an ordinary
	// answer rather than a case. It is the SAME pair `__arr_decref` uses, so a String and an Array cannot
	// disagree about what a record owns.
	let base = emitOwedAllocationBase(module, func: func, cur: release, join: baseJoin, record: record, slots: stringBufferSlots(), ids: ids)
	var afterRelease = emitReleaseOwedBase(module, func: func, cur: baseJoin, base: base, callee: MmDecrefName, ids: ids)
	module.setTerminator(afterRelease, op: StdOp.branch(freeRec.id))

	// freeRec: release the record itself, its external bytes (if it had any) already released.
	let recFreed = ids.mint()
	module.appendOp(freeRec, op: StdOp.call(recFreed, callee: MmFreeName, args: argsOf(record)))
	module.setTerminator(freeRec, op: StdOp.retVoid)

	module.functions.push(func)
end 'buildStrDecref'

// ⭐ **THE ONE ENCODER of shv2's fused OWNED inline String record** — record + inline bytes + a trailing NUL in
// ONE `__mm_alloc`, `buffer@0` pointing at the inline region, `capacity@16 = InlineBufferCapacity`, `parent@32`
// left 0 by the slab zeroing, and `isAscii@40 = isAscii`. Emits the ops into `block` and returns the record.
// Shared so the record layout has exactly ONE construction site: `__str_clone` (passes the SOURCE's `isAscii`)
// and `__gt_subp_str_from_bytes` (passes 0 — child output is arbitrary bytes, `not-ascii` is the safe class)
// were byte-for-byte copies of this sequence, and a field the record later gains must be initialized once, here,
// not silently in one path and not the other.
export function emitBuildOwnedInlineString(module StdModule, block IrBlock, ids ValueMinter, srcBuf ValueId, srcLen ValueId, isAscii ValueId) returns ValueId
	let newRec = emitAllocOwnedInlineString(module, block: block, ids: ids, byteLen: srcLen, isAscii: isAscii)
	let copied = ids.mint()
	module.appendOp(block, op: StdOp.call(copied, callee: StrCopyName, args: threeArgs(emitInlineStringBuffer(module, block: block, ids: ids, record: newRec), second: srcBuf, third: srcLen)))
	return newRec
end 'emitBuildOwnedInlineString'

// ⭐ **THE RECORD HALF of `emitBuildOwnedInlineString`, split out for the ONE producer that fills the bytes
// from more than one source: `__str_replace` assembles its result from alternating slices of the receiver
// and of the replacement, so it needs the box PUBLISHED and the bytes left to it.** Everything about the
// record is settled here — its size (`byteLen` + record + NUL), its `buffer@0`, and the whole buffer-ownership
// encoding (`capacity@16 = InlineBufferCapacity`, `parent@32` left 0 by the slab's zeroing contract) — so a
// caller that fills the bytes itself cannot publish a record that differs from a cloned one by a field.
export function emitAllocOwnedInlineString(module StdModule, block IrBlock, ids ValueMinter, byteLen ValueId, isAscii ValueId) returns ValueId
	// One `__mm_alloc` for the record + the bytes + a trailing NUL (the slab zeroes it), sized exactly as an
	// interpolation of a single part is (`StringInterpOverheadBytes` = record + NUL).
	let overhead = emitConst(module, block: block, value: StringInterpOverheadBytes, ids: ids)
	let allocSize = emitBin(module, block: block, a: byteLen, b: overhead, opcode: StdBinOpcode.add, ids: ids)
	// A fused String record owns nothing beyond the one allocation it IS, so nothing cascades — the same
	// `TrivialDestructor` the parser passes at `emitBoxAlloc`, read from its one declaration rather than
	// spelled as a bare 0 (`__strix_make` is the third reader of it).
	let zeroDtor = emitConst(module, block: block, value: TrivialDestructor, ids: ids)
	let newRec = ids.mint()
	module.appendOp(block, op: StdOp.call(newRec, callee: MmAllocName, args: twoArgs(allocSize, second: zeroDtor)))

	emitStoreField(module, block: block, record: newRec, offset: StringBufferOffset, value: emitInlineStringBuffer(module, block: block, ids: ids, record: newRec))
	emitStoreField(module, block: block, record: newRec, offset: StringLengthOffset, value: byteLen)
	let capacity = emitConst(module, block: block, value: InlineBufferCapacity as ParsedInt, ids: ids)
	emitStoreField(module, block: block, record: newRec, offset: StringCapacityOffset, value: capacity)
	let elementSize = emitConst(module, block: block, value: StringElementSize, ids: ids)
	emitStoreField(module, block: block, record: newRec, offset: StringElementSizeOffset, value: elementSize)
	emitStoreField(module, block: block, record: newRec, offset: StringIsAsciiOffset, value: isAscii)

	return newRec
end 'emitAllocOwnedInlineString'

// Where a fused record's inline bytes begin: right after the record. ONE definition, asked for by everything
// that writes those bytes — so a caller re-deriving it (two ops, a const and an add, in a compiler-internal
// graph) is cheaper than a second place that could be told a different record size.
export function emitInlineStringBuffer(module StdModule, block IrBlock, ids ValueMinter, record ValueId) returns ValueId
	let recordBytes = emitConst(module, block: block, value: StringRecordBytes as ParsedInt, ids: ids)
	return emitBin(module, block: block, a: record, b: recordBytes, opcode: StdBinOpcode.add, ids: ids)
end 'emitInlineStringBuffer'

// ⭐ **`__str_clone(src) -> newStr` — A STRING'S DEEP CLONE (P1.7 slice 3b-vi-b).** A fresh OWNED heap String,
// an independent copy of `src` that `__str_decref` reclaims without touching `src`. It is the SAME single-
// `__mm_alloc` fused-record path an interpolation builds (`Parser.emitStringInterp` / `promoteToOwnedString`,
// with the source as its one part), packaged as a runtime function so the managed array/struct clone walk can
// take its `funcAddr` and `callIndirect` it per element/field.
//
// ⭐ **THE RESULT IS INLINE, so it is INDEPENDENTLY DROPPABLE with no double-free of the source's bytes.** One
// `__mm_alloc` holds the 48-byte record with the bytes right behind it (`buffer@0 = newRec + StringRecordBytes`),
// `capacity@16 = InlineBufferCapacity` and `parent@32 = NoOwedAllocation` (the slab's zeroing supplies the 0) —
// the same encoding `emitStringInterp` publishes — so `__str_decref` reclaims record and bytes together and owes
// nothing to anyone. A LITERAL source (immortal `.rdata`, `capacity == RdataBufferCapacity`) clones through this
// identical path: its bytes are COPIED into the new inline box, so the clone frees its own copy and never the
// immortal blob. `isAscii@40` is carried over from the source, an accurate copy at no extra cost.
function buildStrClone(module StdModule)
	var func = IrFunction.createFromStd(StrCloneName, returnType: StdReturnType.value(StdType.i64), paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry")
	emitParams(module, block: entry, count: 1)
	let src = 0 as ValueId

	// A clone PRESERVES the source's `isAscii` classification (the bytes are copied verbatim), unlike a
	// raw-bytes construction which cannot know it.
	let srcLen = emitLoadField(module, block: entry, record: src, offset: StringLengthOffset, ids: ids)
	let srcBuf = emitLoadField(module, block: entry, record: src, offset: StringBufferOffset, ids: ids)
	let srcAscii = emitLoadField(module, block: entry, record: src, offset: StringIsAsciiOffset, ids: ids)
	let newRec = emitBuildOwnedInlineString(module, block: entry, ids: ids, srcBuf: srcBuf, srcLen: srcLen, isAscii: srcAscii)

	module.setTerminator(entry, op: StdOp.ret(newRec))

	module.functions.push(func)
end 'buildStrClone'

// --- P1.8 Slice C: the byte/ASCII String methods (see the name block at the head of this file) ---

// `__str_range_eq(aAddr, bAddr, len) -> bool` — do the `len` bytes at `aAddr` equal the `len` bytes at
// `bAddr`? The stdlib's `bytesEqual` (`stdlib/String.maxon:979-988`) on ADDRESSES, because every caller
// here has already resolved a buffer and an offset. `len == 0` is vacuously equal.
//
// ⚠ Its callers guarantee both ranges are in bounds — `__str_starts_with`/`__str_ends_with` check the
// length first and `__str_find` never probes past `hayLen - needleLen`. The stdlib's own note on
// `bytesEqual` records what the alternative costs: every copy of this loop used to answer an
// out-of-range byte with a bare `break`, which fell out and returned TRUE, so an OOB read would have
// reported a MATCH. There is no in-bounds test to get wrong here because there is no per-byte bound at
// all — `len` is the whole contract, and the three callers each establish it before calling.
function buildStrRangeEq(module StdModule)
	var func = IrFunction.createFromStd(StrRangeEqName, returnType: StdReturnType.value(StdType.i1), paramCount: 3, paramTypes: threeI64Params(), returnLine: 0)
	var ids = ValueMinter.create(3)

	var entry = module.addBlock(func, label: b"entry")
	var allMatch = module.addBlock(func, label: b"allMatch")
	var notEqual = module.addBlock(func, label: b"notEqual")

	emitParams(module, block: entry, count: 3)
	let aAddr = 0 as ValueId
	let bAddr = 1 as ValueId
	let len = 2 as ValueId

	emitByteRangeCompareLoop(module, func: func, cur: entry, aBuf: aAddr, bBuf: bAddr, len: len, allMatch: allMatch, notEqual: notEqual, ids: ids)
	emitPredicateReturn(module, block: allMatch, value: StrPredicateTrue, ids: ids)
	emitPredicateReturn(module, block: notEqual, value: StrPredicateFalse, ids: ids)

	module.functions.push(func)
end 'buildStrRangeEq'

// ⭐ **`__str_find(hay, startPos, needle) -> BytePos` — the ABSOLUTE index of the first occurrence of
// `needle` at or after `startPos`, or `StrFindNotFound`.** The stdlib's `findIn` (`:1001-1022`), with its
// window expressed as a START POSITION rather than an `(offset, len)` pair: all three loop callers walk a
// tail after each match, which is exactly what a start position says, and a separate length would only be
// `hayLen - startPos` re-encoded at every call.
//
// ⭐ **THE FIRST-BYTE CHECK IS WHAT PAYS FOR THE SHARED COMPARE LOOP, not a micro-optimisation** — the
// stdlib's own measurement, and it applies here for the same reason: `__str_range_eq` is a real CALL (there
// is no inliner), and nearly every candidate position mismatches on byte 0, so probing through the call
// would spend a call to compare one byte. The receiver's length bound is `last = hayLen - needleLen`,
// computed once; it goes NEGATIVE when the needle is longer than the haystack, which the header's
// `i > last` test answers correctly on the first iteration with no separate too-long case.
//
// ⚠ **THE EMPTY NEEDLE IS ANSWERED BEFORE THE LOOP, AND THAT IS A BOUNDS FACT, NOT A SHORTCUT.** The loop
// loads `needle[0]` once, up front; an empty String's buffer has no byte 0 it may read (a detached buffer is
// allocated to its exact length and carries no NUL). It answers `startPos` — every string contains the empty
// string at every position — which is what makes `"x".contains("")` true. `replace`/`split` never reach it:
// both refuse an empty needle/delimiter before their loops, because an empty needle matches everywhere and
// their loops would not terminate.
function buildStrFind(module StdModule)
	var func = IrFunction.createFromStd(StrFindName, returnType: StdReturnType.value(StdType.i64), paramCount: 3, paramTypes: threeI64Params(), returnLine: 0)
	var ids = ValueMinter.create(3)

	var entry = module.addBlock(func, label: b"entry")
	var emptyNeedle = module.addBlock(func, label: b"emptyNeedle")
	var scan = module.addBlock(func, label: b"scan")
	var header = module.addBlock(func, label: b"header")
	var probe = module.addBlock(func, label: b"probe")
	var verify = module.addBlock(func, label: b"verify")
	var step = module.addBlock(func, label: b"step")
	var found = module.addBlock(func, label: b"found")
	var notFound = module.addBlock(func, label: b"notFound")

	emitParams(module, block: entry, count: 3)
	let hay = 0 as ValueId
	let startPos = 1 as ValueId
	let needle = 2 as ValueId

	// entry: the four record fields every block below reads (entry dominates all of them), then the empty
	// needle split.
	let hayLen = emitLoadField(module, block: entry, record: hay, offset: StringLengthOffset, ids: ids)
	let hayBuf = emitLoadField(module, block: entry, record: hay, offset: StringBufferOffset, ids: ids)
	let needleLen = emitLoadField(module, block: entry, record: needle, offset: StringLengthOffset, ids: ids)
	let needleBuf = emitLoadField(module, block: entry, record: needle, offset: StringBufferOffset, ids: ids)
	let zero = emitConst(module, block: entry, value: 0, ids: ids)
	let isEmpty = emitCmp(module, block: entry, a: needleLen, b: zero, pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(entry, op: StdOp.condBranch(isEmpty, thenBlockId: emptyNeedle.id, elseBlockId: scan.id))

	module.setTerminator(emptyNeedle, op: StdOp.ret(startPos))

	// scan: the needle's first byte and the last position a match could start at, both loop-invariant.
	let firstByte = emitLoadByteAt(module, block: scan, addr: needleBuf, ids: ids)
	let last = emitBin(module, block: scan, a: hayLen, b: needleLen, opcode: StdBinOpcode.sub, ids: ids)
	module.setTerminator(scan, op: StdOp.branch(header.id))

	let i = ids.mint()
	header.blockArgs.push(IrBlockArg.create(i, argType: StdType.i64))
	scan.branchEdges.push(BranchEdge.create(header.id, argIds: argsOf(startPos)))

	let past = emitCmp(module, block: header, a: i, b: last, pred: StdCmpPred.gt, ids: ids)
	module.setTerminator(header, op: StdOp.condBranch(past, thenBlockId: notFound.id, elseBlockId: probe.id))

	let candidate = emitLoadByteIndexed(module, block: probe, base: hayBuf, index: i, ids: ids)
	let firstMatches = emitCmp(module, block: probe, a: candidate, b: firstByte, pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(probe, op: StdOp.condBranch(firstMatches, thenBlockId: verify.id, elseBlockId: step.id))

	let hayAddr = emitBin(module, block: verify, a: hayBuf, b: i, opcode: StdBinOpcode.add, ids: ids)
	let whole = ids.mint()
	module.appendOp(verify, op: StdOp.call(whole, callee: StrRangeEqName, args: threeArgs(hayAddr, second: needleBuf, third: needleLen)))
	module.setTerminator(verify, op: StdOp.condBranch(whole, thenBlockId: found.id, elseBlockId: step.id))

	let one = emitConst(module, block: step, value: 1, ids: ids)
	let iNext = emitBin(module, block: step, a: i, b: one, opcode: StdBinOpcode.add, ids: ids)
	module.setTerminator(step, op: StdOp.branch(header.id))
	step.branchEdges.push(BranchEdge.create(header.id, argIds: argsOf(iNext)))

	module.setTerminator(found, op: StdOp.ret(i))

	let missing = emitConst(module, block: notFound, value: StrFindNotFound, ids: ids)
	module.setTerminator(notFound, op: StdOp.ret(missing))

	module.functions.push(func)
end 'buildStrFind'

// ⭐ **`__str_rfind(hay, needle) -> BytePos` — THE ABSOLUTE INDEX OF THE LAST OCCURRENCE, or
// `StrFindNotFound`.** The stdlib's `findLastIn` (`stdlib/String.maxon:1003-1028`): scan DOWN from the last
// position a match could start at, first-byte-reject each candidate, and verify a hit with
// `__str_range_eq`. `__str_find`'s mirror in every respect but the direction, and it keeps the same
// first-byte check for the same measured reason (`__str_range_eq` is a real call and nearly every
// candidate mismatches on byte 0).
//
// ⭐ **THE DOWNWARD SCAN IS WHAT MAKES AN OVERLAPPING NEEDLE ANSWER THE RIGHTMOST START**, which is the
// behaviour `find-last-overlapping` pins: `"aaa".findLast("aa")` is 1, not 0. A forward scan keeping the
// last hit would give the same answer here but pay the whole haystack every time.
//
// ⚠ **THE EMPTY NEEDLE ANSWERS THE BYTE LENGTH, NOT 0**, and that is the stdlib's answer
// (`findLastIn:1006-1008`) rather than a choice: the empty string occurs at every position, and the LAST
// such position is the end. `__str_find`'s empty-needle arm answers its `startPos` for the same reason
// read forwards. Both are answered before the loop because the loop loads `needle[0]`, which an empty
// String's buffer has no byte for.
//
// ⚠ **THE LOOP BOUND GOES NEGATIVE FOR A NEEDLE LONGER THAN THE HAYSTACK**, and the header's `i < 0` test
// answers that correctly on the first iteration — so there is no separate too-long case, exactly as
// `__str_find`'s `i > last` needs none.
function buildStrRFind(module StdModule)
	var func = IrFunction.createFromStd(StrRFindName, returnType: StdReturnType.value(StdType.i64), paramCount: 2, paramTypes: twoI64Params(), returnLine: 0)
	var ids = ValueMinter.create(2)

	var entry = module.addBlock(func, label: b"entry")
	var emptyNeedle = module.addBlock(func, label: b"emptyNeedle")
	var scan = module.addBlock(func, label: b"scan")
	var header = module.addBlock(func, label: b"header")
	var probe = module.addBlock(func, label: b"probe")
	var verify = module.addBlock(func, label: b"verify")
	var step = module.addBlock(func, label: b"step")
	var found = module.addBlock(func, label: b"found")
	var notFound = module.addBlock(func, label: b"notFound")

	emitParams(module, block: entry, count: 2)
	let hay = 0 as ValueId
	let needle = 1 as ValueId

	let hayLen = emitLoadField(module, block: entry, record: hay, offset: StringLengthOffset, ids: ids)
	let hayBuf = emitLoadField(module, block: entry, record: hay, offset: StringBufferOffset, ids: ids)
	let needleLen = emitLoadField(module, block: entry, record: needle, offset: StringLengthOffset, ids: ids)
	let needleBuf = emitLoadField(module, block: entry, record: needle, offset: StringBufferOffset, ids: ids)
	let zero = emitConst(module, block: entry, value: 0, ids: ids)
	let isEmpty = emitCmp(module, block: entry, a: needleLen, b: zero, pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(entry, op: StdOp.condBranch(isEmpty, thenBlockId: emptyNeedle.id, elseBlockId: scan.id))

	module.setTerminator(emptyNeedle, op: StdOp.ret(hayLen))

	let firstByte = emitLoadByteAt(module, block: scan, addr: needleBuf, ids: ids)
	let last = emitBin(module, block: scan, a: hayLen, b: needleLen, opcode: StdBinOpcode.sub, ids: ids)
	module.setTerminator(scan, op: StdOp.branch(header.id))

	let i = ids.mint()
	header.blockArgs.push(IrBlockArg.create(i, argType: StdType.i64))
	scan.branchEdges.push(BranchEdge.create(header.id, argIds: argsOf(last)))

	let before = emitCmp(module, block: header, a: i, b: zero, pred: StdCmpPred.lt, ids: ids)
	module.setTerminator(header, op: StdOp.condBranch(before, thenBlockId: notFound.id, elseBlockId: probe.id))

	let candidate = emitLoadByteIndexed(module, block: probe, base: hayBuf, index: i, ids: ids)
	let firstMatches = emitCmp(module, block: probe, a: candidate, b: firstByte, pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(probe, op: StdOp.condBranch(firstMatches, thenBlockId: verify.id, elseBlockId: step.id))

	let hayAddr = emitBin(module, block: verify, a: hayBuf, b: i, opcode: StdBinOpcode.add, ids: ids)
	let whole = ids.mint()
	module.appendOp(verify, op: StdOp.call(whole, callee: StrRangeEqName, args: threeArgs(hayAddr, second: needleBuf, third: needleLen)))
	module.setTerminator(verify, op: StdOp.condBranch(whole, thenBlockId: found.id, elseBlockId: step.id))

	let one = emitConst(module, block: step, value: 1, ids: ids)
	let iPrev = emitBin(module, block: step, a: i, b: one, opcode: StdBinOpcode.sub, ids: ids)
	module.setTerminator(step, op: StdOp.branch(header.id))
	step.branchEdges.push(BranchEdge.create(header.id, argIds: argsOf(iPrev)))

	module.setTerminator(found, op: StdOp.ret(i))

	let missing = emitConst(module, block: notFound, value: StrFindNotFound, ids: ids)
	module.setTerminator(notFound, op: StdOp.ret(missing))

	module.functions.push(func)
end 'buildStrRFind'

// ⭐ **`__str_starts_with` AND `__str_ends_with` FROM ONE BUILDER** — the stdlib's `startsWith` (`:368-374`)
// and `endsWith` (`:376-383`), which are the SAME function apart from where the compared window begins:
// offset 0 for a prefix, `selfLen - affixLen` for a suffix. Everything else — the length guard, the two field
// loads, the `__str_range_eq` call, the `false` return — is shared, so it is written once and `atTail` is the
// one documented axis. (`buildStrEq`'s "one graph, two symbols" parameterization, one level up: here the two
// symbols get two graphs, but from one description.)
//
// ⚠ **THE LENGTH GUARD IS NOT AN OPTIMISATION, IT IS `__str_range_eq`'s IN-BOUNDS CONTRACT.** An affix longer
// than the receiver returns `false` without reaching the compare — and for the tail form it is also what makes
// `selfLen - affixLen` non-negative, so the guard must come first in both. An EMPTY affix compares zero bytes,
// which is vacuously `true` at either end.
function buildStrAffixPredicate(module StdModule, name ByteArray, atTail bool)
	var func = IrFunction.createFromStd(name, returnType: StdReturnType.value(StdType.i1), paramCount: 2, paramTypes: twoI64Params(), returnLine: 0)
	var ids = ValueMinter.create(2)

	var entry = module.addBlock(func, label: b"entry")
	var compare = module.addBlock(func, label: b"compare")
	var tooLong = module.addBlock(func, label: b"tooLong")

	emitParams(module, block: entry, count: 2)
	let selfPtr = 0 as ValueId
	let affix = 1 as ValueId

	let selfLen = emitLoadField(module, block: entry, record: selfPtr, offset: StringLengthOffset, ids: ids)
	let affixLen = emitLoadField(module, block: entry, record: affix, offset: StringLengthOffset, ids: ids)
	let doesNotFit = emitCmp(module, block: entry, a: affixLen, b: selfLen, pred: StdCmpPred.gt, ids: ids)
	module.setTerminator(entry, op: StdOp.condBranch(doesNotFit, thenBlockId: tooLong.id, elseBlockId: compare.id))

	let selfBuf = emitLoadField(module, block: compare, record: selfPtr, offset: StringBufferOffset, ids: ids)
	let affixBuf = emitLoadField(module, block: compare, record: affix, offset: StringBufferOffset, ids: ids)
	let windowAddr = affixWindowAddress(module, block: compare, selfBuf: selfBuf, selfLen: selfLen, affixLen: affixLen, atTail: atTail, ids: ids)
	let matches = ids.mint()
	module.appendOp(compare, op: StdOp.call(matches, callee: StrRangeEqName, args: threeArgs(windowAddr, second: affixBuf, third: affixLen)))
	module.setTerminator(compare, op: StdOp.ret(matches))

	emitPredicateReturn(module, block: tooLong, value: StrPredicateFalse, ids: ids)

	module.functions.push(func)
end 'buildStrAffixPredicate'

// Where the compared window starts: the buffer itself for a PREFIX, or `affixLen` bytes back from the end for
// a SUFFIX. The one place the two predicates differ, so it is also the only place the difference is stated.
function affixWindowAddress(module StdModule, block IrBlock, selfBuf ValueId, selfLen ValueId, affixLen ValueId, atTail bool, ids ValueMinter) returns ValueId
	if not atTail 'atHead'
		return selfBuf
	end 'atHead'
	let tailOffset = emitBin(module, block: block, a: selfLen, b: affixLen, opcode: StdBinOpcode.sub, ids: ids)
	return emitBin(module, block: block, a: selfBuf, b: tailOffset, opcode: StdBinOpcode.add, ids: ids)
end 'affixWindowAddress'

// `__str_contains(self, needle) -> bool` — the stdlib's `contains(needle String)` (`:385-390`): a whole-string
// `find`, turned from an INDEX into a PREDICATE. Not a wrapper around `__str_find` but a change of answer
// domain — a `BytePos` (with a `StrFindNotFound` outside it) becomes the bool the language method returns, and
// no caller of `contains` should have to know which number means "nothing here".
function buildStrContains(module StdModule)
	var func = IrFunction.createFromStd(StrContainsName, returnType: StdReturnType.value(StdType.i1), paramCount: 2, paramTypes: twoI64Params(), returnLine: 0)
	var ids = ValueMinter.create(2)

	var entry = module.addBlock(func, label: b"entry")
	var yes = module.addBlock(func, label: b"yes")
	var no = module.addBlock(func, label: b"no")

	emitParams(module, block: entry, count: 2)
	let selfPtr = 0 as ValueId
	let needle = 1 as ValueId

	let zero = emitConst(module, block: entry, value: 0, ids: ids)
	let idx = emitStrFindCall(module, block: entry, hay: selfPtr, startPos: zero, needle: needle, ids: ids)
	let wasFound = emitCmp(module, block: entry, a: idx, b: zero, pred: StdCmpPred.ge, ids: ids)
	module.setTerminator(entry, op: StdOp.condBranch(wasFound, thenBlockId: yes.id, elseBlockId: no.id))

	emitPredicateReturn(module, block: yes, value: StrPredicateTrue, ids: ids)
	emitPredicateReturn(module, block: no, value: StrPredicateFalse, ids: ids)

	module.functions.push(func)
end 'buildStrContains'

// ⭐ **`__str_map_case(self, lo, hi, delta) -> newStr` — ONE graph for BOTH `toLower` and `toUpper`** (the
// stdlib's `mapAsciiCase`, `:589-616`). The parser supplies the gated byte range and the shift, because that
// is the only thing the two methods differ in.
//
// ⭐⭐ **IT TRANSFORMS AN INDEPENDENT COPY AND NEVER THE RECEIVER.** The bytes are cloned into a fresh owned
// record FIRST and the map runs over the COPY's buffer, so `let b = a.toLower()` cannot touch `a` — the exact
// regression `specs-shv2/string-type-2.md`'s `case-conversion-does-not-mutate-receiver` was written against
// (the stdlib's own history: returning the mutated `managed` silently lowercased the receiver too). It is
// also what makes the methods callable on a `let`: they write nothing the receiver owns.
//
// ⭐ **A BYTE OUTSIDE `[lo, hi]` IS LEFT ALONE, and that is the whole reason a non-ASCII string survives a
// case conversion unharmed** — a UTF-8 continuation or lead byte has its high bit set, so it is above `hi`
// (122 at most) and no arm of this loop touches it. There is no ASCII test anywhere here; the range gate IS it.
function buildStrMapCase(module StdModule)
	var func = IrFunction.createFromStd(StrMapCaseName, returnType: StdReturnType.value(StdType.i64), paramCount: 4, paramTypes: fourI64Params(), returnLine: 0)
	var ids = ValueMinter.create(4)

	var entry = module.addBlock(func, label: b"entry")
	var header = module.addBlock(func, label: b"header")
	var body = module.addBlock(func, label: b"body")
	var checkHi = module.addBlock(func, label: b"checkHi")
	var apply = module.addBlock(func, label: b"apply")
	var step = module.addBlock(func, label: b"step")
	var done = module.addBlock(func, label: b"done")

	emitParams(module, block: entry, count: 4)
	let selfPtr = 0 as ValueId
	let lo = 1 as ValueId
	let hi = 2 as ValueId
	let delta = 3 as ValueId

	// entry: the independent copy, and the buffer the loop rewrites. `isAscii@40` carries over verbatim — the
	// mapping moves bytes only WITHIN `[65,122]`, so it can neither create nor remove a high-bit byte.
	let srcLen = emitLoadField(module, block: entry, record: selfPtr, offset: StringLengthOffset, ids: ids)
	let srcBuf = emitLoadField(module, block: entry, record: selfPtr, offset: StringBufferOffset, ids: ids)
	let srcAscii = emitLoadField(module, block: entry, record: selfPtr, offset: StringIsAsciiOffset, ids: ids)
	let newRec = emitBuildOwnedInlineString(module, block: entry, ids: ids, srcBuf: srcBuf, srcLen: srcLen, isAscii: srcAscii)
	let dstBuf = emitInlineStringBuffer(module, block: entry, ids: ids, record: newRec)
	let zero = emitConst(module, block: entry, value: 0, ids: ids)
	module.setTerminator(entry, op: StdOp.branch(header.id))

	let i = ids.mint()
	header.blockArgs.push(IrBlockArg.create(i, argType: StdType.i64))
	entry.branchEdges.push(BranchEdge.create(header.id, argIds: argsOf(zero)))

	let atEnd = emitCmp(module, block: header, a: i, b: srcLen, pred: StdCmpPred.ge, ids: ids)
	module.setTerminator(header, op: StdOp.condBranch(atEnd, thenBlockId: done.id, elseBlockId: body.id))

	// body / checkHi: the two halves of `b >= lo and b <= hi`, as two blocks — a short-circuit `and` IS
	// control flow, and there is no boolean `and` op in the Std tier to fold them into one test.
	let addr = emitBin(module, block: body, a: dstBuf, b: i, opcode: StdBinOpcode.add, ids: ids)
	let copyByte = emitLoadByteAt(module, block: body, addr: addr, ids: ids)
	let atOrAboveLo = emitCmp(module, block: body, a: copyByte, b: lo, pred: StdCmpPred.ge, ids: ids)
	module.setTerminator(body, op: StdOp.condBranch(atOrAboveLo, thenBlockId: checkHi.id, elseBlockId: step.id))

	let atOrBelowHi = emitCmp(module, block: checkHi, a: copyByte, b: hi, pred: StdCmpPred.le, ids: ids)
	module.setTerminator(checkHi, op: StdOp.condBranch(atOrBelowHi, thenBlockId: apply.id, elseBlockId: step.id))

	let shifted = emitBin(module, block: apply, a: copyByte, b: delta, opcode: StdBinOpcode.add, ids: ids)
	module.appendOp(apply, op: StdOp.storeIndirect(addr, offset: 0, valueId: shifted, valueType: StdType.u8))
	module.setTerminator(apply, op: StdOp.branch(step.id))

	let one = emitConst(module, block: step, value: 1, ids: ids)
	let iNext = emitBin(module, block: step, a: i, b: one, opcode: StdBinOpcode.add, ids: ids)
	module.setTerminator(step, op: StdOp.branch(header.id))
	step.branchEdges.push(BranchEdge.create(header.id, argIds: argsOf(iNext)))

	module.setTerminator(done, op: StdOp.ret(newRec))

	module.functions.push(func)
end 'buildStrMapCase'

// ⭐ **`__str_replace(self, old, with) -> newStr` — the stdlib's TWO-PASS `replace` (`:448-517`): COUNT the
// matches, then BUILD into one exactly-sized allocation.** The count is what makes the final size known before
// a byte is written — `selfLen + count * (withLen - oldLen)` — so nothing ever grows and no builder is needed.
//
// ⚠ **THAT IS ALSO WHY shv2 DOES NOT PORT `StringBuilder`.** The stdlib reaches for one and immediately tells
// it the answer (`out.reserve(...)`), i.e. it uses a growable buffer as a fixed one; the two-pass count is the
// part that carries the property, and the builder is the part shv2 has no other consumer for.
//
// ⚠ **AN EMPTY `old` IS ANSWERED WITH A CLONE, BEFORE EITHER LOOP.** An empty needle matches at every
// position, so `pos = idx + oldLen` would not advance and the count loop would not terminate — the stdlib
// guards the same case for the same reason (`:451-453`, `return clone()`). Every OTHER degenerate case falls
// out of the general path: a needle that never matches counts 0, sizes the result at `selfLen`, and copies
// the whole receiver as its tail.
function buildStrReplace(module StdModule)
	var func = IrFunction.createFromStd(StrReplaceName, returnType: StdReturnType.value(StdType.i64), paramCount: 3, paramTypes: threeI64Params(), returnLine: 0)
	var ids = ValueMinter.create(3)

	var entry = module.addBlock(func, label: b"entry")
	var cloneCase = module.addBlock(func, label: b"cloneCase")
	var countHeader = module.addBlock(func, label: b"countHeader")
	var countStep = module.addBlock(func, label: b"countStep")
	var buildSetup = module.addBlock(func, label: b"buildSetup")
	var buildHeader = module.addBlock(func, label: b"buildHeader")
	var copySegment = module.addBlock(func, label: b"copySegment")
	var copyTail = module.addBlock(func, label: b"copyTail")

	emitParams(module, block: entry, count: 3)
	let selfPtr = 0 as ValueId
	let old = 1 as ValueId
	let replacement = 2 as ValueId

	// entry: every field the blocks below read (entry dominates all of them), then the empty-needle split.
	let selfLen = emitLoadField(module, block: entry, record: selfPtr, offset: StringLengthOffset, ids: ids)
	let selfBuf = emitLoadField(module, block: entry, record: selfPtr, offset: StringBufferOffset, ids: ids)
	let selfAscii = emitLoadField(module, block: entry, record: selfPtr, offset: StringIsAsciiOffset, ids: ids)
	let oldLen = emitLoadField(module, block: entry, record: old, offset: StringLengthOffset, ids: ids)
	let withLen = emitLoadField(module, block: entry, record: replacement, offset: StringLengthOffset, ids: ids)
	let withBuf = emitLoadField(module, block: entry, record: replacement, offset: StringBufferOffset, ids: ids)
	let withAscii = emitLoadField(module, block: entry, record: replacement, offset: StringIsAsciiOffset, ids: ids)
	let zero = emitConst(module, block: entry, value: 0, ids: ids)
	let oldIsEmpty = emitCmp(module, block: entry, a: oldLen, b: zero, pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(entry, op: StdOp.condBranch(oldIsEmpty, thenBlockId: cloneCase.id, elseBlockId: countHeader.id))

	let cloned = ids.mint()
	module.appendOp(cloneCase, op: StdOp.call(cloned, callee: StrCloneName, args: argsOf(selfPtr)))
	module.setTerminator(cloneCase, op: StdOp.ret(cloned))

	// countHeader / countStep: pass one — how many non-overlapping matches are there? The cursor jumps PAST
	// each match (`idx + oldLen`), which is what makes `"aaaa".replace("aa", …)` two matches, not three.
	let count = ids.mint()
	let countPos = ids.mint()
	countHeader.blockArgs.push(IrBlockArg.create(count, argType: StdType.i64))
	countHeader.blockArgs.push(IrBlockArg.create(countPos, argType: StdType.i64))
	entry.branchEdges.push(BranchEdge.create(countHeader.id, argIds: twoArgs(zero, second: zero)))

	let countIdx = emitStrFindCall(module, block: countHeader, hay: selfPtr, startPos: countPos, needle: old, ids: ids)
	let countFound = emitCmp(module, block: countHeader, a: countIdx, b: zero, pred: StdCmpPred.ge, ids: ids)
	module.setTerminator(countHeader, op: StdOp.condBranch(countFound, thenBlockId: countStep.id, elseBlockId: buildSetup.id))

	let one = emitConst(module, block: countStep, value: 1, ids: ids)
	let countNext = emitBin(module, block: countStep, a: count, b: one, opcode: StdBinOpcode.add, ids: ids)
	let countPosNext = emitBin(module, block: countStep, a: countIdx, b: oldLen, opcode: StdBinOpcode.add, ids: ids)
	module.setTerminator(countStep, op: StdOp.branch(countHeader.id))
	countStep.branchEdges.push(BranchEdge.create(countHeader.id, argIds: twoArgs(countNext, second: countPosNext)))

	// buildSetup: the exact result size, and the box to write it into. `count` is read straight off
	// `countHeader`, which dominates this block — only the loop-carried recurrence needs a phi, exactly as
	// `__int_to_string`'s `writeSetup` reads its digit count.
	//
	// `isAscii` is the AND of the two contributing strings' flags: every byte of the result comes from the
	// receiver or from the replacement, so ASCII on both sides is ASCII in the result, and either side
	// non-ASCII gives the conservative `false` this record format treats as the safe class.
	let sizeDelta = emitBin(module, block: buildSetup, a: withLen, b: oldLen, opcode: StdBinOpcode.sub, ids: ids)
	let totalDelta = emitBin(module, block: buildSetup, a: count, b: sizeDelta, opcode: StdBinOpcode.mul, ids: ids)
	let outLen = emitBin(module, block: buildSetup, a: selfLen, b: totalDelta, opcode: StdBinOpcode.add, ids: ids)
	let outAscii = emitBin(module, block: buildSetup, a: selfAscii, b: withAscii, opcode: StdBinOpcode.bitAnd, ids: ids)
	let newRec = emitAllocOwnedInlineString(module, block: buildSetup, ids: ids, byteLen: outLen, isAscii: outAscii)
	let outBuf = emitInlineStringBuffer(module, block: buildSetup, ids: ids, record: newRec)
	module.setTerminator(buildSetup, op: StdOp.branch(buildHeader.id))

	// buildHeader(srcPos, dst): pass two — re-walk the same matches, copying the piece before each one and
	// then the replacement. Two loop-carried values: where reading is up to, and where writing is up to.
	let srcPos = ids.mint()
	let dst = ids.mint()
	buildHeader.blockArgs.push(IrBlockArg.create(srcPos, argType: StdType.i64))
	buildHeader.blockArgs.push(IrBlockArg.create(dst, argType: StdType.i64))
	buildSetup.branchEdges.push(BranchEdge.create(buildHeader.id, argIds: twoArgs(zero, second: outBuf)))

	let buildIdx = emitStrFindCall(module, block: buildHeader, hay: selfPtr, startPos: srcPos, needle: old, ids: ids)
	let buildFound = emitCmp(module, block: buildHeader, a: buildIdx, b: zero, pred: StdCmpPred.ge, ids: ids)
	module.setTerminator(buildHeader, op: StdOp.condBranch(buildFound, thenBlockId: copySegment.id, elseBlockId: copyTail.id))

	let preLen = emitBin(module, block: copySegment, a: buildIdx, b: srcPos, opcode: StdBinOpcode.sub, ids: ids)
	let preAddr = emitBin(module, block: copySegment, a: selfBuf, b: srcPos, opcode: StdBinOpcode.add, ids: ids)
	let prefixCopied = ids.mint()
	module.appendOp(copySegment, op: StdOp.call(prefixCopied, callee: StrCopyName, args: threeArgs(dst, second: preAddr, third: preLen)))
	let afterPrefix = emitBin(module, block: copySegment, a: dst, b: preLen, opcode: StdBinOpcode.add, ids: ids)
	let replacementCopied = ids.mint()
	module.appendOp(copySegment, op: StdOp.call(replacementCopied, callee: StrCopyName, args: threeArgs(afterPrefix, second: withBuf, third: withLen)))
	let afterReplacement = emitBin(module, block: copySegment, a: afterPrefix, b: withLen, opcode: StdBinOpcode.add, ids: ids)
	let srcPosNext = emitBin(module, block: copySegment, a: buildIdx, b: oldLen, opcode: StdBinOpcode.add, ids: ids)
	module.setTerminator(copySegment, op: StdOp.branch(buildHeader.id))
	copySegment.branchEdges.push(BranchEdge.create(buildHeader.id, argIds: twoArgs(srcPosNext, second: afterReplacement)))

	// copyTail: no match left, so everything from `srcPos` on is copied verbatim. It runs even when the tail
	// is empty (a receiver ending in a match), copying zero bytes.
	let tailLen = emitBin(module, block: copyTail, a: selfLen, b: srcPos, opcode: StdBinOpcode.sub, ids: ids)
	let tailAddr = emitBin(module, block: copyTail, a: selfBuf, b: srcPos, opcode: StdBinOpcode.add, ids: ids)
	let tailCopied = ids.mint()
	module.appendOp(copyTail, op: StdOp.call(tailCopied, callee: StrCopyName, args: threeArgs(dst, second: tailAddr, third: tailLen)))
	module.setTerminator(copyTail, op: StdOp.ret(newRec))

	module.functions.push(func)
end 'buildStrReplace'

// ⭐ **`__str_replace_first(self, old, with)` — the stdlib's `replaceFirst` (`stdlib/String.maxon:565-599`),
// AND IT IS A SEPARATE GRAPH ON THE REFERENCE'S OWN ARGUMENT.** `replace` needs two passes because it does
// not know how many matches there are until it has counted them; there is exactly ONE match here, so the
// final size is known outright and the whole counting pass — and with it both loops — disappears. The
// reference states that in as many words at its own `replaceFirst` ("`replace`'s three-piece build, with
// the counting pass it does not need"), and the two share every primitive that matters: `__str_find` finds
// the match, `__str_clone` answers both no-op cases, `emitAllocOwnedInlineString`/`emitInlineStringBuffer`
// publish the box and `__str_copy` moves each piece. What is NOT shared is a loop neither would run.
//
// ⚠ **BOTH NO-OP CASES ANSWER WITH `__str_clone`, NOT WITH `self`.** An empty needle and a needle that is
// absent are the two ways this method has nothing to do, and returning the receiver's own record would hand
// the caller a second owner of a box it does not own — the caller drops the result, and the receiver's
// bytes go with it. The reference refuses `return self` for the same reason at its own `clone()`, where the
// note is the Stage 0 bug `let b = a.toLower()` lowercasing `a`.
function buildStrReplaceFirst(module StdModule)
	var func = IrFunction.createFromStd(StrReplaceFirstName, returnType: StdReturnType.value(StdType.i64), paramCount: 3, paramTypes: threeI64Params(), returnLine: 0)
	var ids = ValueMinter.create(3)

	var entry = module.addBlock(func, label: b"entry")
	var search = module.addBlock(func, label: b"search")
	var cloneCase = module.addBlock(func, label: b"cloneCase")
	var build = module.addBlock(func, label: b"build")

	emitParams(module, block: entry, count: 3)
	let selfPtr = 0 as ValueId
	let old = 1 as ValueId
	let replacement = 2 as ValueId

	// entry: every field the blocks below read (entry dominates all of them), then the empty-needle split —
	// `__str_replace`'s opening, for its reason: an empty needle matches at every position, so a search for
	// it answers 0 and the "replacement" would be an insertion at the front rather than a replacement.
	let selfLen = emitLoadField(module, block: entry, record: selfPtr, offset: StringLengthOffset, ids: ids)
	let selfBuf = emitLoadField(module, block: entry, record: selfPtr, offset: StringBufferOffset, ids: ids)
	let selfAscii = emitLoadField(module, block: entry, record: selfPtr, offset: StringIsAsciiOffset, ids: ids)
	let oldLen = emitLoadField(module, block: entry, record: old, offset: StringLengthOffset, ids: ids)
	let withLen = emitLoadField(module, block: entry, record: replacement, offset: StringLengthOffset, ids: ids)
	let withBuf = emitLoadField(module, block: entry, record: replacement, offset: StringBufferOffset, ids: ids)
	let withAscii = emitLoadField(module, block: entry, record: replacement, offset: StringIsAsciiOffset, ids: ids)
	let zero = emitConst(module, block: entry, value: 0, ids: ids)
	let oldIsEmpty = emitCmp(module, block: entry, a: oldLen, b: zero, pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(entry, op: StdOp.condBranch(oldIsEmpty, thenBlockId: cloneCase.id, elseBlockId: search.id))

	let idx = emitStrFindCall(module, block: search, hay: selfPtr, startPos: zero, needle: old, ids: ids)
	let found = emitCmp(module, block: search, a: idx, b: zero, pred: StdCmpPred.ge, ids: ids)
	module.setTerminator(search, op: StdOp.condBranch(found, thenBlockId: build.id, elseBlockId: cloneCase.id))

	let cloned = ids.mint()
	module.appendOp(cloneCase, op: StdOp.call(cloned, callee: StrCloneName, args: argsOf(selfPtr)))
	module.setTerminator(cloneCase, op: StdOp.ret(cloned))

	// build: one match at `idx`, so the result is `[0, idx)` + the replacement + `[idx + oldLen, selfLen)`
	// and its length is known before a byte is written. `isAscii` is the AND of the two contributing
	// strings' flags, `__str_replace`'s rule and for its reason.
	let sizeDelta = emitBin(module, block: build, a: withLen, b: oldLen, opcode: StdBinOpcode.sub, ids: ids)
	let outLen = emitBin(module, block: build, a: selfLen, b: sizeDelta, opcode: StdBinOpcode.add, ids: ids)
	let outAscii = emitBin(module, block: build, a: selfAscii, b: withAscii, opcode: StdBinOpcode.bitAnd, ids: ids)
	let newRec = emitAllocOwnedInlineString(module, block: build, ids: ids, byteLen: outLen, isAscii: outAscii)
	let outBuf = emitInlineStringBuffer(module, block: build, ids: ids, record: newRec)

	let headCopied = ids.mint()
	module.appendOp(build, op: StdOp.call(headCopied, callee: StrCopyName, args: threeArgs(outBuf, second: selfBuf, third: idx)))

	let afterHead = emitBin(module, block: build, a: outBuf, b: idx, opcode: StdBinOpcode.add, ids: ids)
	let replacementCopied = ids.mint()
	module.appendOp(build, op: StdOp.call(replacementCopied, callee: StrCopyName, args: threeArgs(afterHead, second: withBuf, third: withLen)))

	let matchEnd = emitBin(module, block: build, a: idx, b: oldLen, opcode: StdBinOpcode.add, ids: ids)
	let tailAddr = emitBin(module, block: build, a: selfBuf, b: matchEnd, opcode: StdBinOpcode.add, ids: ids)
	let tailLen = emitBin(module, block: build, a: selfLen, b: matchEnd, opcode: StdBinOpcode.sub, ids: ids)
	let afterReplacement = emitBin(module, block: build, a: afterHead, b: withLen, opcode: StdBinOpcode.add, ids: ids)
	let tailCopied = ids.mint()
	module.appendOp(build, op: StdOp.call(tailCopied, callee: StrCopyName, args: threeArgs(afterReplacement, second: tailAddr, third: tailLen)))
	module.setTerminator(build, op: StdOp.ret(newRec))

	module.functions.push(func)
end 'buildStrReplaceFirst'

// ⭐ **`__str_from_bytes(arr) -> newStr` — `String.from(bytes)` (`stdlib/String.maxon:119-121`).** The
// array's buffer holds exactly the UTF-8 bytes the String is to have, so the whole of the work is the
// ASCII classification and the same fused-record build every other owned String is born through.
//
// ⚠ **IT COPIES WHERE THE REFERENCE SHARES, AND THE DIVERGENCE IS FORCED.** The reference builds
// `String{managed: bytes.managed, …}` — a zero-copy view of the array's own backing memory, sound there
// because a `__ManagedMemory` is refcounted and the two records share ownership of one block. shv2 has no
// shared-ownership relationship between an `Array` record and a `String` record: each is an independent
// box whose drop reclaims its own allocation, so a view would be a second reclaimer of one block (a
// double free) or a reader of a block the array's `__arr_decref` has already returned. Copying makes the
// result an ordinary owned inline String, which is what every producer in this file hands back and what
// `__str_decref` already knows how to reclaim.
function buildStrFromBytes(module StdModule)
	var func = IrFunction.createFromStd(StrFromBytesName, returnType: StdReturnType.value(StdType.i64), paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry")
	var scan = module.addBlock(func, label: b"scan")
	var scanBody = module.addBlock(func, label: b"scanBody")
	var stillAscii = module.addBlock(func, label: b"stillAscii")
	var sawHighByte = module.addBlock(func, label: b"sawHighByte")
	var build = module.addBlock(func, label: b"build")

	emitParams(module, block: entry, count: 1)
	let arr = 0 as ValueId

	let len = emitLoadField(module, block: entry, record: arr, offset: ArrLengthOffset, ids: ids)
	let buf = emitLoadField(module, block: entry, record: arr, offset: ArrBufferOffset, ids: ids)
	let zero = emitConst(module, block: entry, value: 0, ids: ids)
	module.setTerminator(entry, op: StdOp.branch(scan.id))

	// The `isAscii@40` classification, computed rather than guessed: it is a claim about these bytes, and
	// the one place a String's is otherwise produced (`bytesAreAscii`) makes the identical claim at lower
	// time for a literal. It is carried as an i64 0/1, the width the field is stored at, which is why the
	// high-byte case is a BRANCH rather than an `and` of the `i1` a compare yields: the two are different
	// Std types and the flag must be the record's.
	let i = ids.mint()
	let ascii = ids.mint()
	scan.blockArgs.push(IrBlockArg.create(i, argType: StdType.i64))
	scan.blockArgs.push(IrBlockArg.create(ascii, argType: StdType.i64))
	let one = emitConst(module, block: entry, value: 1, ids: ids)
	entry.branchEdges.push(BranchEdge.create(scan.id, argIds: twoArgs(zero, second: one)))

	let scanned = emitCmp(module, block: scan, a: i, b: len, pred: StdCmpPred.ge, ids: ids)
	module.setTerminator(scan, op: StdOp.condBranch(scanned, thenBlockId: build.id, elseBlockId: scanBody.id))

	let raw = emitLoadByteIndexed(module, block: scanBody, base: buf, index: i, ids: ids)
	let highBit = emitConst(module, block: scanBody, value: AsciiHighBit, ids: ids)
	let isLow = emitCmp(module, block: scanBody, a: raw, b: highBit, pred: StdCmpPred.lt, ids: ids)
	let iNext = emitBin(module, block: scanBody, a: i, b: one, opcode: StdBinOpcode.add, ids: ids)
	module.setTerminator(scanBody, op: StdOp.condBranch(isLow, thenBlockId: stillAscii.id, elseBlockId: sawHighByte.id))

	module.setTerminator(stillAscii, op: StdOp.branch(scan.id))
	stillAscii.branchEdges.push(BranchEdge.create(scan.id, argIds: twoArgs(iNext, second: ascii)))

	module.setTerminator(sawHighByte, op: StdOp.branch(scan.id))
	sawHighByte.branchEdges.push(BranchEdge.create(scan.id, argIds: twoArgs(iNext, second: zero)))

	module.setTerminator(build, op: StdOp.ret(emitBuildOwnedInlineString(module, block: build, ids: ids, srcBuf: buf, srcLen: len, isAscii: ascii)))

	module.functions.push(func)
end 'buildStrFromBytes'

// ⭐ **`__str_split(self, delim, arr)` — the stdlib's `split` (`:557-587`), filling a CALLER-CREATED array.**
// The `Array with String` is built by the PARSER through `emitArrayCreateOp`, the one array-creation door, so
// `split` cannot disagree with an array literal about the element size or the `element_destroy@40` stamp that
// makes each segment droppable. This function only pushes, and returns nothing.
//
// ⭐ **EVERY SEGMENT IS A FRESH OWNED INLINE STRING, NOT A VIEW.** The array becomes each segment's sole
// owner, so `__arr_decref`'s element walk drops them all and nothing aliases the receiver's bytes — which is
// what makes a split result leak-free AND independent of a receiver that later grows.
//
// ⚠ **THE TAIL SEGMENT IS PUSHED UNCONDITIONALLY**, even when empty, and that is the whole of the
// empty-segment behaviour the corpus pins: `"a,,b"` is three parts, `"hello,"` is two (the second empty),
// `",,"` is three empties, and `""` is one empty. An empty DELIMITER is answered before the loop with a clone
// of the receiver, for `replace`'s reason — it matches at every position, so the cursor would not advance.
function buildStrSplit(module StdModule)
	var func = IrFunction.createFromStd(StrSplitName, returnType: StdReturnType.void, paramCount: 3, paramTypes: threeI64Params(), returnLine: 0)
	var ids = ValueMinter.create(3)

	var entry = module.addBlock(func, label: b"entry")
	var emptyDelim = module.addBlock(func, label: b"emptyDelim")
	var header = module.addBlock(func, label: b"header")
	var pushSegment = module.addBlock(func, label: b"pushSegment")
	var pushTail = module.addBlock(func, label: b"pushTail")

	emitParams(module, block: entry, count: 3)
	let selfPtr = 0 as ValueId
	let delim = 1 as ValueId
	let arr = 2 as ValueId

	let selfLen = emitLoadField(module, block: entry, record: selfPtr, offset: StringLengthOffset, ids: ids)
	let selfBuf = emitLoadField(module, block: entry, record: selfPtr, offset: StringBufferOffset, ids: ids)
	let selfAscii = emitLoadField(module, block: entry, record: selfPtr, offset: StringIsAsciiOffset, ids: ids)
	let delimLen = emitLoadField(module, block: entry, record: delim, offset: StringLengthOffset, ids: ids)
	let zero = emitConst(module, block: entry, value: 0, ids: ids)
	let delimIsEmpty = emitCmp(module, block: entry, a: delimLen, b: zero, pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(entry, op: StdOp.condBranch(delimIsEmpty, thenBlockId: emptyDelim.id, elseBlockId: header.id))

	let whole = ids.mint()
	module.appendOp(emptyDelim, op: StdOp.call(whole, callee: StrCloneName, args: argsOf(selfPtr)))
	emitPushSegment(module, block: emptyDelim, arr: arr, segment: whole, ids: ids)
	module.setTerminator(emptyDelim, op: StdOp.retVoid)

	let pos = ids.mint()
	header.blockArgs.push(IrBlockArg.create(pos, argType: StdType.i64))
	entry.branchEdges.push(BranchEdge.create(header.id, argIds: argsOf(zero)))

	let idx = emitStrFindCall(module, block: header, hay: selfPtr, startPos: pos, needle: delim, ids: ids)
	let found = emitCmp(module, block: header, a: idx, b: zero, pred: StdCmpPred.ge, ids: ids)
	module.setTerminator(header, op: StdOp.condBranch(found, thenBlockId: pushSegment.id, elseBlockId: pushTail.id))

	emitPushSliceSegment(module, block: pushSegment, arr: arr, srcBuf: selfBuf, from: pos, endPos: idx, isAscii: selfAscii, ids: ids)
	let posNext = emitBin(module, block: pushSegment, a: idx, b: delimLen, opcode: StdBinOpcode.add, ids: ids)
	module.setTerminator(pushSegment, op: StdOp.branch(header.id))
	pushSegment.branchEdges.push(BranchEdge.create(header.id, argIds: argsOf(posNext)))

	emitPushSliceSegment(module, block: pushTail, arr: arr, srcBuf: selfBuf, from: pos, endPos: selfLen, isAscii: selfAscii, ids: ids)
	module.setTerminator(pushTail, op: StdOp.retVoid)

	module.functions.push(func)
end 'buildStrSplit'

// ⭐ **ONE SEGMENT OF THE RECEIVER — the bytes `[from, endPos)` — BUILT FRESH AND PUSHED.** `__str_split` has
// exactly two producers of one and they differ ONLY in where the segment STOPS (`endPos`): the piece before a
// delimiter ends at the match, the tail after the last one ends at `length@8`. They were that difference plus three
// identical lines, with nothing making the three agree — and what those lines encode is the whole of
// "a segment is an INDEPENDENT COPY, not a view of the receiver", which is what keeps `__arr_decref`'s
// element walk from double-freeing the receiver's bytes. Written once, so a change to what a segment IS
// (its `isAscii`, its record shape, its owner) cannot reach the interior segments and miss the tail.
function emitPushSliceSegment(module StdModule, block IrBlock, arr ValueId, srcBuf ValueId, from ValueId, endPos ValueId, isAscii ValueId, ids ValueMinter)
	emitPushSegment(module, block: block, arr: arr, segment: emitSliceSegment(module, block: block, srcBuf: srcBuf, from: from, endPos: endPos, isAscii: isAscii, ids: ids), ids: ids)
end 'emitPushSliceSegment'

// ⭐ **THE BYTES `[from, endPos)` OF `srcBuf` AS A FRESH OWNED STRING** — the END-EXCLUSIVE half-open range
// every String-slicing consumer means, and the whole of "a segment is an INDEPENDENT COPY, not a view".
// Split out of `emitPushSliceSegment` for its THIRD consumer: `__str_split` pushes the result into an
// array, and `__strix_slice` (`s.slice(a, endIndex: b)`) RETURNS it. Written once so a change to what a
// slice IS — its `isAscii`, its record shape, its owner — cannot reach the split's segments and miss
// `slice`'s result, which is exactly the drift that would let one of them alias the receiver's bytes and
// double-free under `__str_decref`.
//
// ⚠ **IT DOES NOT VALIDATE THE RANGE.** `__str_split` derives both ends from its own scan and cannot
// produce a bad one; `__strix_slice` takes them from the caller and checks them itself, aborting rather
// than handing a negative length to `__mm_alloc`. The check belongs where an untrusted range enters.
export function emitSliceSegment(module StdModule, block IrBlock, srcBuf ValueId, from ValueId, endPos ValueId, isAscii ValueId, ids ValueMinter) returns ValueId
	let segLen = emitBin(module, block: block, a: endPos, b: from, opcode: StdBinOpcode.sub, ids: ids)
	let segAddr = emitBin(module, block: block, a: srcBuf, b: from, opcode: StdBinOpcode.add, ids: ids)
	return emitBuildOwnedInlineString(module, block: block, ids: ids, srcBuf: segAddr, srcLen: segLen, isAscii: isAscii)
end 'emitSliceSegment'

// Hand one finished segment to the array. `__arr_push` is void, but a Std `call` still defines a result
// value, so the discarded id is minted here once rather than at each of `__str_split`'s three push sites.
function emitPushSegment(module StdModule, block IrBlock, arr ValueId, segment ValueId, ids ValueMinter)
	let pushed = ids.mint()
	module.appendOp(block, op: StdOp.call(pushed, callee: ArrPushName, args: twoArgs(arr, second: segment)))
end 'emitPushSegment'

// `idx = __str_find(hay, startPos, needle)` — the positioned search every consumer makes, minted and appended
// in ONE step. Shared for the reason the argument names are spelled out at the call sites: `contains`,
// `replace`'s two passes and `split`'s scan pass the same three values, and a haystack/needle swap between
// two of those copies is a SILENT WRONG ANSWER (a search of the needle for the haystack still compiles, still
// runs, and simply does not find things) rather than anything a compiler would catch.
export function emitStrFindCall(module StdModule, block IrBlock, hay ValueId, startPos ValueId, needle ValueId, ids ValueMinter) returns ValueId
	let idx = ids.mint()
	module.appendOp(block, op: StdOp.call(idx, callee: StrFindName, args: threeArgs(hay, second: startPos, third: needle)))
	return idx
end 'emitStrFindCall'

// Store one constant byte at `dest[offset]`. The shape a fixed-text renderer (`__bool_to_string`) writes
// each of its bytes with — a `const` typed i64, stored as a `u8` (the store keeps the low byte).
function storeConstByte(module StdModule, block IrBlock, ids ValueMinter, dest ValueId, offset ByteOffset, charValue ParsedInt)
	let ch = ids.mint()
	module.appendOp(block, op: StdOp.const(ch, value: charValue, valueType: StdType.i64))
	module.appendOp(block, op: StdOp.storeIndirect(dest, offset: offset, valueId: ch, valueType: StdType.u8))
end 'storeConstByte'

// `threeI64Params` — `__str_copy(dest, src, len)`'s three-i64 signature — lives in `MmRuntime` next to
// `oneI64Param`/`twoI64Params`, shared with the Array runtime (see MmRuntime).

// `twoArgs` / `threeArgs` — the pair and triple call/branch-edge builders — live in `MmRuntime` next
// to `argsOf`, shared by every runtime builder (see MmRuntime).
