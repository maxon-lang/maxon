// Runtime/StringRuntime.maxon — the String value representation (P1.2 wave A) and the two builder-built
// Std runtime functions a String needs before ownership exists: `__print_string` and `__str_eq`.
//
// ⭐ A WAVE-A STRING IS IMMORTAL RDATA. A string LITERAL lowers to a pointer to a fused 48-byte record
// whose `buffer@0` points at a separate NUL-terminated byte blob — BOTH in read-only `.rdata`. Nothing
// is heap-allocated, refcounted or freed, so neither runtime function touches the MM runtime: a
// print-only or string-`==`-only program stays leak-gate-free (see `scanRuntimeUsage`). The owned heap
// String, its destructor, and drop-at-scope-exit are Wave B.
//
// This file owns TWO things and their single source is here:
//   1. the RECORD LAYOUT — the offsets `__print_string`/`__str_eq` read (`buffer@0`, `length@8`) AND
//      the offsets `LowerMaxonToStd` writes when it assembles a literal's record. One set of constants,
//      read from both ends, so the reader and the writer cannot drift (`buildStringRecordBytes` asserts
//      each field lands at its named offset).
//   2. the two runtime functions, built as `StdOp` graphs exactly as `MmRuntime` builds the allocator
//      — so they get register allocation, frames and the whole backend for free — reusing that file's
//      `ValueMinter`/`emitParams`/`oneI64Param`/`twoI64Params`/`argsOf` rather than a second copy.

// --- The fused 48-byte String record (bootstrap `MaxonToStandardConversion.Helpers.cs:503-536`) ---
//
// Every field is an 8-byte slot, so the six offsets are 0/8/16/24/32/40 and the record is 48 bytes.
// `buffer@0` is the ABSOLUTE VA of the byte blob — emitted as a PLACEHOLDER 0 and patched by the PE
// writer once `.rdata`'s RVA is known (a fixed-base image, so the VA is compile-time computable). The
// blob is a SEPARATE `.rdata` entry, NUL-terminated, and `length@8` EXCLUDES the NUL.
// ⭐ **DERIVED FROM `BufferOwnership`, NOT DECLARED HERE.** The first five slots are the shared prefix the
// Array record also uses, and `__mm_cow_detach` is ONE emitted function that reads them out of BOTH — so
// the numbers exist once and these names alias them. Only `isAscii@40` below is genuinely this record's own
// (the Array record's `@40` is `element_destroy`), which is why the shared prefix stops at `@32`.
export let StringBufferOffset = ManagedRecordBufferOffset
export let StringLengthOffset = ManagedRecordLengthOffset

// Exported for `Parser.emitStringInterp`, which WRITES all six fields of an owned heap String's record
// (the literal path here only ever writes rdata). One set of offsets, read by the runtime and written by
// the interpolation lowering, so a reader and a writer of the same record cannot drift.
// ⭐ **THESE THREE ARE DERIVED FROM `BufferOwnership`, NOT DECLARED HERE**, because `__mm_cow_detach` is ONE
// emitted function that reads them out of this record AND out of the Array record. They were two
// coincidentally-equal sets of literals until that function existed; a divergence would now be a wrong load
// inside it rather than a second value flowing through a parameter, so the numbers live in one place and
// these names alias them. `@40` below is genuinely this record's own — the Array record's `@40` is
// `element_destroy` — which is exactly why the shared prefix stops at `@32`.
export let StringCapacityOffset = ManagedRecordCapacityOffset
export let StringElementSizeOffset = ManagedRecordElementSizeOffset
export let StringParentPtrOffset = ManagedRecordParentOffset

// ⭐⭐ **SLOT@40 IS `singleByteGraphemes` — *EVERY GRAPHEME IN THIS STRING IS EXACTLY ONE BYTE* — AND IT
// USED TO BE THE STRICTLY WEAKER `isAscii`.** The corpus field this record IS
// (`stdlib/String.maxon:86`'s `singleByteGraphemesFlag`) has always carried the stronger fact, and its own
// declaration records the cost of the confusion: *"this field used to say only 'is ASCII', and ten methods
// read THAT as 'one byte per character' … all ten split the cluster"*. **CR+LF is a SINGLE cluster under
// UAX #29 GB3**, so an all-ASCII string is not necessarily one byte per grapheme.
//
// ⚠ **WHILE THE TWO MEANINGS DISAGREED, `String.hasSingleByteGraphemes()` HAD TO ANSWER A CONSERVATIVE
// `false` OUTRIGHT** — serving `isAscii@40` there would have made the corpus's `countGraphemes` take the
// shortcut and return the BYTE length, 2, for a CR+LF string where every other path in all three compilers
// says 1. That refusal cost SPEED on long ASCII strings (measured by the corpus at ×2.4 rising to ×6.5 on
// `findFirst`/`findLast`/`slice-by-length`), and `Parser.dispatchStringMethod` named the cure exactly:
// *"strengthening the record's `@40` flag to the corpus's meaning at its literal scan and at all nine of its
// propagation sites"*. That is what this is.
//
// ⭐ **CR-FREE RATHER THAN CRLF-FREE, AND THAT IS WHAT MAKES IT COMPOSABLE** — *"no CR"* is a property of
// each byte ON ITS OWN, so it survives both slicing and concatenation and `__str_append` may simply AND the
// two flags. *"No CRLF pair"* would not: `"a\r"` and `"\nb"` each lack one and their join has one.
export let StringSingleByteGraphemesOffset = 40 as ByteOffset
export let StringRecordBytes = ManagedRecordBytes
let StringFieldBytes = 8 as ByteCount

// `element_size = 1` — a String's elements are bytes.
//
// ⭐ **A LITERAL'S `capacity@16`/`parent@32` ARE THE SHARED BUFFER-OWNERSHIP ENCODING'S** (`BufferOwnership`),
// not this file's invention and not the Array record's either: `RdataBufferCapacity` says the buffer is an
// immortal `.rdata` blob that is not this record's to write or to release, and `NoOwedAllocation` says the
// record owes no separate allocation a release. The Array record's byte-string literal writes exactly the
// same pair for exactly the same reason.
export let StringElementSize = 1 as ParsedInt

// ⭐ AN OWNED INTERPOLATION RESULT IS A HEAP STRING, and its bytes live INLINE — right after the 48-byte
// record, in the SAME `__mm_alloc` payload (`buffer@0 = record + StringRecordBytes`). So the whole thing
// is one allocation: `__mm_decref` → `__mm_free` reclaims the record AND its bytes together, and the
// destructor a struct passes (`TrivialDestructor`, 0) is exactly right — there is no external buffer to
// free. `capacity@16` is `InlineBufferCapacity` and `parent@32` is `NoOwedAllocation` (unwritten — the
// zeroing contract supplies it), which is the shared encoding saying exactly that: not mine to write in
// place, and no separate allocation owed. See `Parser.emitStringInterp`.
//
// The fixed bytes an owned interpolation result allocates BEYOND its text: the 48-byte record the bytes
// live inline behind, plus one trailing NUL (which the slab's zeroing supplies for free — nothing writes
// it). `Parser.emitStringInterp` sizes its one `__mm_alloc` as `totalLen + StringInterpOverheadBytes`.
export let StringInterpOverheadBytes = (StringRecordBytes as ParsedInt) + 1

// `singleByteGraphemes@40` — 1 iff every byte is < 128 AND no byte is a CR (a compile-time scan). An empty
// string satisfies it vacuously. The high-bit threshold and the two flag values are named rather than bare
// so the scan reads as the property it computes.
let AsciiHighBit = 128 as Byte
let SingleByteGraphemesTrue = 1 as ParsedInt
let SingleByteGraphemesFalse = 0 as ParsedInt

// ⚠ **U+000D, AND THIS IS THE THIRD STATEMENT OF THE BYTE — the corpus already carries two, WITH a measured
// reason, and this one has the same shape of reason.** `stdlib/helpers/string/grapheme.maxon:38` is the
// AUTHORITY (it implements GB3); `stdlib/String.maxon:53` states it a second time because its classifier
// tests every byte of every string as it is constructed and a cross-file call per byte measured worse than
// the second walk it replaced. This copy exists because the scan below runs in the COMPILER, at lower time,
// over a literal's bytes — it cannot call corpus Maxon at all. What holds the three together is a CHECK and
// not a comment: `specs-shv2/grapheme-clusters`'s `grapheme-boundary-crlf` and the literal-flag cases go red
// if any of them stops treating CR specially.
//
// ⚠ **EXPORTED FOR `GraphemeRuntime.buildCharFromCodepoint`, WHICH IS THE OTHER PRODUCER OF THIS FIELD.**
// Slot@40's meaning is declared in this file, so the byte that clears it is declared here too — a second
// `13` in the encoder would be a fourth statement of the number with nothing holding it to this one.
export let CarriageReturnByte = 13 as Byte

// The blob is the payload bytes followed by a single NUL — a C string, so the record's pointer is
// usable by any consumer that wants a NUL-terminated buffer, while `length@8` is what Maxon reads.
let NulTerminator = 0 as Byte

// ⭐ EVERY BLOB IS PADDED TO AN 8-BYTE MULTIPLE, so the RECORD that registers right after it lands at an
// 8-byte-aligned rdata offset. This is load-bearing for arm64-macOS ONLY: a String literal's `buffer@0`
// there is a dyld chained-fixup REBASE (`MachOWriter.writeMachoStringBufferRebases`), and a chain links
// its entries by a 4-byte-granular `next` delta, so every rebased slot MUST sit at an aligned offset or
// the delta cannot be encoded. Records are 48 bytes (an 8-multiple) and arm64 float islands are 8, so
// once blobs are 8-multiples the rdata cursor stays 8-aligned across the whole section and every record
// is naturally aligned. The trailing zero bytes are INVISIBLE to every consumer — the blob is read as a
// NUL-terminated C string from `buffer@0` and `length@8` counts only the payload — so this is free on
// x64 (which bakes an unaligned absolute VA and needs no alignment) and correct on arm64. `v1` does the
// same at its `.data` string helpers (LowerMaxonToStd `addSubprocessString`/`addTraceTagEntry`).
let StringBlobAlignment = 8 as ByteCount

// `__int_to_string`'s decimal machinery. The digits are rendered without ever NEGATING the value, so
// `i64.min` is handled with no overflow: signed `%`/`/` keep the value's sign (`x % 10 ∈ [-9,0]` for a
// negative `x`), and the per-digit magnitude is recovered by MULTIPLYING by `sign = 1 - 2*neg` (`+1` for
// a non-negative value, `-1` for a negative one) rather than by an `abs` that `i64.min` would overflow.
let AsciiZeroDigit = 48 as ParsedInt
let AsciiMinusSign = 45 as ParsedInt
let DecimalRadix = 10 as ParsedInt

// `value >>logical 63` is `1` exactly when the sign bit is set — the branch-free `isNegative` the sign
// and the leading `-` are both derived from.
let SignBitPosition = 63 as ParsedInt
let SignMultiplierBase = 1 as ParsedInt
let SignMultiplierSpan = 2 as ParsedInt

// The scratch an integer part reserves before `__int_to_string` fills it: `i64.min` renders as
// "-9223372036854775808", 20 digits and a sign = 21 bytes, and no i64 is wider. `Parser.emitStringInterp`
// allocates this, the converter fills `len ≤ 21` bytes, and the caller frees it after the copy.
export let IntToStringScratchBytes = 21 as ParsedInt

// The scratch the UNSIGNED renderer reserves (X11): `u64.max` renders as "18446744073709551615", 20
// digits and NO sign, and no u64 is wider. It is a constant of its own rather than the signed budget
// reused, because the two are derived from two different worst cases and the byte the difference is
// made of — the sign — is precisely the byte this renderer never writes. Pairing it with the wrong
// name is what `integerToStringScratchBytes` exists to make impossible.
export let UIntToStringScratchBytes = 20 as ParsedInt

// `__bool_to_string` renders "true" (4) or "false" (5). The ASCII bytes of both, and the two lengths.
//
// ⚠ `AsciiLowerA` was `export`ed for a SECOND reader — the parser's `toLower`/`toUpper` arms, which handed
// the gated range and the shift to `__str_map_case`. Those retired onto `stdlib/String.maxon` in W49 wave 2
// and the five constants that served them went with them, leaving this the byte `a` of "false" and nothing
// else. Non-exported again, so the file that owns the only reader owns the only name.
let AsciiLowerT = 116 as ParsedInt
let AsciiLowerR = 114 as ParsedInt
let AsciiLowerU = 117 as ParsedInt
let AsciiLowerE = 101 as ParsedInt
let AsciiLowerF = 102 as ParsedInt
let AsciiLowerA = 97 as ParsedInt
let AsciiLowerL = 108 as ParsedInt
let AsciiLowerS = 115 as ParsedInt
let BoolTrueLength = 4 as ParsedInt
let BoolFalseLength = 5 as ParsedInt

// "false" is the longest rendering, so 5 bytes cover both.
export let BoolToStringScratchBytes = 5 as ParsedInt

// The `.rdata` label prefixes for a literal's blob and its record. Distinct so a reader of the section
// can tell the two apart; `__`-prefixed so they never collide with a user name and stay out of the
// spec goldens (`TargetPrinter.isRuntimeFunction`'s data twin).
let StringBlobPrefix = "__str_blob_"
let StringRecordPrefix = "__str_rec_"

// ⭐⭐ **THE TWO STREAM WRITERS — `stdlib/Print.maxon`'s and `stdlib/PrintError.maxon`'s ONLY floor (W35),
// and they REPLACE `__print_string`.** That entry point existed to serve a bare-name `print` BUILTIN,
// which is retired: `print` is now an ordinary call to the corpus declaration, whose body is
// `__Builtins.writeStdout(value.addressableBytes())`, and `printError` is its twin one stream over. So the
// graph did not go away — it gained a stderr sibling, a `__ManagedMemory` argument in place of a String
// pointer (the two records agree at `buffer@0`/`length@8`, which is all either reads) and a RESULT.
//
// `__`-prefixed (`isCompilerInternalCallee` treats them as the compiler's own — no E3004, no signature
// slotting), but NOT `__mm_`-prefixed, so `isRuntimeCallee` leaves them out of the heap-runtime decision.
//
// ⚠⚠ **AND THAT NARROWNESS IS A MEASURED POLICY, NOT AN OVERSIGHT — see `MmRuntime.isRuntimeCallee`.**
// Every W5-era runtime family declares `usesHeap` AND `usesArray` transitively, because its Std body calls
// `__arr_create`/`__mm_alloc` one tier down. These two bodies call NOTHING: two loads and one system op.
// Giving them a W5-shaped usage bit by reflex would drag the allocator and the leak gate into every
// program that writes a byte to a stream.
//
// ⚠ **`StreamWrite…`, NOT `WriteStderrName` — that spelling IS TAKEN, by the thing these must not be
// confused with.** `BacktraceFormat.WriteStderrName` is `mrt_write_cstr_stderr`, the hand-assembled
// NUL-terminated panic writer (see `StdOp.osWriteStderr` for why it cannot serve this). Naming a second
// constant that would be the same near-name trap as `X64Runtime.emitPrintString` against
// `buildPrintString`, one namespace collision closer.
export let StreamWriteStdoutName = b"__write_stdout"
export let StreamWriteStderrName = b"__write_stderr"
export let StrEqName = b"__str_eq"

// The two runtime entry points an interpolation lowers CALLS to (`Parser.emitStringInterp`). `__str_copy`
// blits one part's bytes into the result buffer; `__int_to_string` renders an integer part's decimal text
// into a scratch buffer. Both are `__`-prefixed compiler-internal (no E3004, no signature slotting) but NOT
// `__mm_`-prefixed — like `__print_string`/`__str_eq`, they touch no allocator, so they never widen the
// heap-runtime decision. The heap decision is driven by the interpolation's OWN `__mm_alloc` calls, which
// `scanRuntimeUsage` already sees.
export let StrCopyName = b"__str_copy"
export let IntToStringName = b"__int_to_string"
// The UNSIGNED decimal renderer (X11) — `__int_to_string` with no sign handling at all and an unsigned
// digit walk. It is a second ENTRY POINT and not a second implementation: one builder emits both (see
// `buildIntegerToString`), because the two graphs share their count loop and their write loop and
// differ only in the three places the sign reaches.
export let UIntToStringName = b"__uint_to_string"
export let BoolToStringName = b"__bool_to_string"

// ⭐ **WHICH DECIMAL RENDERER, AND WHAT SCRATCH IT NEEDS — the two halves of ONE choice.** The signed
// budget is one byte wider (the sign), so the dangerous pairing is the signed renderer with the unsigned
// budget: `i64.min` would write 21 bytes into a 20-byte scratch. Both are keyed off the same
// `DivideSignedness` — the very enum the builder's own divides carry — and the one selection site
// (`Parser.materializeInterpExpr`) reads both off ONE local, so the wrong pairing cannot be reached by
// deciding twice.
//
// ⚠ It is not made UNREPRESENTABLE by the types, and saying so would be a claim the signatures do not
// keep: `integerToStringName(unsigned)` and `integerToStringScratchBytes(signed)` type-check. What rules
// it out is that no caller derives the signedness twice — so a SECOND selection site must take both from
// one decision too, or pass the `DivideSignedness` itself rather than its two answers.
export function integerToStringName(signedness DivideSignedness) returns ByteArray
	return match signedness 'reading'
		signed gives IntToStringName
		unsigned gives UIntToStringName
	end 'reading'
end 'integerToStringName'

export function integerToStringScratchBytes(signedness DivideSignedness) returns ParsedInt
	return match signedness 'reading'
		signed gives IntToStringScratchBytes
		unsigned gives UIntToStringScratchBytes
	end 'reading'
end 'integerToStringScratchBytes'

// The two Wave-D entry points. `__str_append(self, other)` grows a String in place; `__str_decref(record)`
// is a String's drop — a `__mm_decref` that ALSO frees the external buffer of a detached String. Both are
// `__`-prefixed compiler-internal (no E3004, no signature slotting) but NOT `__mm_`-prefixed, so on their
// own they do not widen the heap decision. They DO call `__mm_alloc`/`__mm_free`/`__str_copy` inside their
// Std bodies — which `scanRuntimeUsage` cannot see, since those calls are not in the Maxon module — so a
// reference to either explicitly turns on `usesHeap` (and `__str_append` turns on `usesStrCopy`).
export let StrAppendName = b"__str_append"
export let StrDecrefName = b"__str_decref"

// ⭐⭐ **THE P1.8 SLICE C BYTE/ASCII METHOD FAMILY IS GONE — ALL EIGHT ENTRY POINTS, ALL SEVEN MEMBERS**
// (W49 waves 1, 2, 4 and 5). It was `__str_starts_with`/`__str_ends_with` (wave 1), `__str_map_case`,
// `__str_replace` and `__str_replace_first` (wave 2), `__str_contains` (wave 4), and finally
// `__str_split` — plus the two it was the last consumer of, `__str_find` and `__str_range_eq` — at wave 5.
// Every one of the seven members is now an ordinary declared function in `stdlib/String.maxon`, reached
// through `Parser.memberBelongsToTheCorpus`, and the corpus bodies these entry points had been transcribed
// FROM are what serves them.
//
// ⚠ **`__str_find` AND `__str_range_eq` DID NOT GO HOME — THEY DIED, AND THAT IS A DIFFERENT FACT.** A
// retired MEMBER hands its body back to the corpus; these two were never members, they were the search
// underneath three of them. `contains` (wave 4) and `__strix_find` (wave 3) had already gone, which left
// `__str_split` as `__str_find`'s only producer and `__str_find` as `__str_range_eq`'s only producer — so
// with `split` retired, nothing in the compiler can emit either callee and no `RuntimeUsage` bit could ever
// turn true. What replaces them is the corpus's own `findIn`/`bytesEqual` (`stdlib/String.maxon:980`,
// `:958`), which these two were transcribed from in the first place. **THE ORDER MATTERS AND IS THE TRAP
// THIS FAMILY KEEPS SETTING**: an entry point is deleted only once EVERY producer of its callee is gone,
// never when merely its most visible one is (see `closeStringMethodNeeds`, whose clauses shed TERMS one at
// a time for exactly this reason, and `StdlibSource.calleeIsGraphemeRuntimeEntry`, which states it again).
//
// ⚠ **THE COST MOVED WITH THE BODY, AND IT IS ACCEPTED** (user ruling, recorded at wave 2). The corpus
// `findIn` asks `byteAt` — a THROWING, bounds-checked accessor — once per candidate position, where
// `__str_find` walked the bytes with a raw load and a first-byte fast reject in one Std body; and the
// corpus `sliceBytes` builds each segment through `managed.slice` + a `String{…}` literal, where
// `__str_split` blitted it straight into a fused record. shv2 has no inliner, so both differences are real
// calls per byte and per segment. Two candidate cures were MEASURED and both are regressions; do not
// attempt a third here (the full argument is at `Parser.stringSurfaceMemberNames`).

// ⚠ **`__str_map_case`, `__str_replace` AND `__str_replace_first` WERE HERE AND WENT WITH THEIR BUILDERS**
// (W49 wave 2). `toLower`/`toUpper`/`replace`/`replaceFirst` are the CORPUS's now — struck from
// `Parser.stringSurfaceMemberNames` — so nothing names any of the three and a constant for them could only
// ever spell a callee no module emits. The corpus bodies behind them reach `byteAt`, `setByte`,
// `addressableBytes` and `__ManagedMemory.slice`, whose doors are all still shv2's.
//
// ⭐ **THE P1.8 SLICE E ENTRY POINT THAT REMAINS.** `__str_from_bytes(arr)` — `String.from(bytes)`
// (`:119-121`), the one exported `String` static. It COPIES where the reference shares a
// `__ManagedMemory`; see `buildStrFromBytes` for why shv2 cannot. It is `__`-prefixed compiler-internal (no
// E3004, no signature slotting) and not `__mm_`-prefixed, so it declares its own transitive floor in
// `closeStringMethodNeeds`.
export let StrFromBytesName = b"__str_from_bytes"

// ⭐⭐ **`__str_of_buffer(srcRecord, singleByteGraphemes) -> String` — THE ENVELOPE COLLAPSE'S CONSTRUCTOR:
// what a corpus `String{managed: X, singleByteGraphemesFlag: F}` LOWERS TO.** `type String` declares two
// fields and IS the fused record (`Project.StructLayout.isInlineManagedField`), so its literal cannot
// store a pointer at offset 0 the way an ordinary struct literal stores a field — offset 0 is `buffer@0`
// of the record being built. This is the producer that builds it instead.
//
// ⭐ **IT IS `__str_from_bytes` WITH THE FLAG SUPPLIED RATHER THAN SCANNED, AND IT IS THE SAME GRAPH
// UNDERNEATH** (`emitBuildOwnedInlineString`). The two differ in exactly one thing and it is the one thing
// the corpus is explicit about: `String.from(bytes)` classifies the bytes it was handed, while
// `fromOwnedBytes` takes a caller *"that ALREADY KNOWS how the bytes classify"* — `StringBuilder.build`
// watched every byte go in, so re-scanning them *"would make finishing a builder cost a second walk"*
// (`stdlib/String.maxon:139-142`). Sharing the builder is what keeps the two from drifting into two record
// shapes.
//
// ⚠⚠ **IT COPIES, WHERE THE REFERENCE BUILDS A ZERO-COPY VIEW — DELIBERATELY, AND THIS IS A DIFFERENT
// ARGUMENT FROM THE ONE `buildStrFromBytes` USED TO MAKE.** That function's header says shv2 *cannot* share,
// *"has no shared-ownership relationship between an `Array` record and a `String` record"*; that was true
// when written and the P1.7 COW slice made it false — `buildStrBytesView`, two screens down, establishes
// exactly that relationship in the other direction, increfing the allocation the bytes live in and stating
// its refcount correct in both drop orders. **So the view is now REPRESENTABLE.** It is not taken here
// because a view is the shape whose failure mode is a double free or a read of returned memory, and it
// buys a constant factor on a path nothing has measured. Copying is what every other producer in this file
// hands back and what `__str_decref` already reclaims. ⇒ A rung with the ladder read, not a line here.
export let StrOfBufferName = b"__str_of_buffer"

// ⭐⭐ **`__mm_to_cstring(bufRecord) -> ptr` — `__ManagedMemory.toCString()`, the corpus's ONE producer of a
// `cstring`** (`stdlib/String.maxon:195`). It implements the contract that declaration states verbatim:
// *"The conversion checks `buffer[length] == 0` and copies if not, so the returned pointer is always safely
// NUL-terminated even when the underlying `__ManagedMemory` happens to be packed tight against its
// allocated capacity (where `strlen` would otherwise walk past the end into adjacent heap)."*
//
// ⭐ **THE CHECK IS NOT AN OPTIMISATION, IT IS WHAT MAKES THE COMMON CASE FREE.** Every String literal's
// blob is NUL-terminated by `stringBlobBytes`, and every owned inline String's trailing NUL comes from the
// slab's zeroing contract — so `buffer[length]` is already 0 for both, the test falls through, and the
// receiver's own bytes are handed back with nothing allocated. Only a buffer that is neither pays a copy.
//
// ⚠⚠ **THE COPY PATH RETURNS AN ADDRESS NOTHING OWNS, AND THAT IS THE `cstring` CONTRACT RATHER THAN AN
// OVERSIGHT.** A `cstring` is a raw pointer with no length, no capacity and no refcount — the type exists
// precisely to hand a `__Builtins.*` intrinsic something to `strlen`. There is no owner to record it
// against and no drop that could reclaim it, in this compiler or in either reference. ⇒ A program that
// reaches the copy path leaks that buffer, and the leak is the DECLARATION's to fix (by keeping the
// receiver alive and NUL-terminated) rather than this graph's. Nothing in the loaded corpus reaches it:
// `cstr()` has no caller, so dead-function elimination drops both.
export let MmToCStringName = b"__mm_to_cstring"

// ⭐⭐ **THE THREE STDLIB-ONLY BYTE DOORS — what `stdlib/`'s own byte walkers actually ask a String for.**
// All three are `module function` in the corpus (`stdlib/String.maxon:181`, `:266` and `:281`), so no user
// program may reach any of them; the visibility is enforced at the PARSER, on stdlib provenance
// (`Parser.requireStdlibOnlyStringMethod`), because shv2 has no `module` keyword.
//
//   * `__str_bytes_view(str) -> arrRecord` — `addressableBytes()`. A ZERO-COPY `Array with Byte` VIEW over
//     the receiver's live bytes: nothing is copied and the cost does not depend on the length. See
//     `buildStrBytesView` for why it is a fresh record rather than the String pointer retagged.
//   * `__str_byte_at(str, index) -> (byte, flag)` — `byteAt(index)`. One bounds-checked byte read that
//     THROWS `__ManagedMemoryError.invalidByteRange`, which is what the corpus declares
//     (`stdlib/String.maxon:266`) and what its own doc argues for: the bounds contract stays the CALLER's
//     to state. It is the primitive `utf8.maxon`, `hash.maxon` and `grapheme.maxon` walk bytes through.
//   * `__str_byte_at_or_panic(str, index) -> byte` — `byteAtOrPanic(index)`. The SAME read with the other
//     failure exit: it ABORTS, because its 17 corpus call sites read bytes inside nested conditions
//     (`if trimmed.byteAtOrPanic(pos) == 47`) where a `try` cannot go — the reference's own reason for the
//     method existing (`stdlib/String.maxon:272-283`).
//
// ⚠ **THE LAST TWO ARE TWO FUNCTIONS BECAUSE THEY DIFFER ON THEIR FAILURE EXIT, AND ON NOTHING ELSE.** The
// load path and the range test are identical and are written once (`emitIndexOutOfRange`); what a `throws`
// stamp buys is a callee whose caller must write `try`, and a panicking one cannot be given that stamp
// without making every `byteAtOrPanic` call site a `tryCall` for a failure that never returns.
//
// All three are `__`-prefixed compiler-internal (no E3004, no signature slotting) and none is
// `__mm_`-prefixed, so each declares its own transitive floor in `closeStringMethodNeeds`.
export let StrBytesViewName = b"__str_bytes_view"
export let StrByteAtName = b"__str_byte_at"
export let StrByteAtOrPanicName = b"__str_byte_at_or_panic"

// ⭐ **THE THROWING `String` RUNTIME CALLEES — one, and this file's first.** `__str_byte_at` returns through
// the dual-register `errorReturn` ABI, so a call to it MUST become a `tryCall`; the parser's E3055 accept and
// SemanticCheck's E3057 reject both read `GtRuntime.isThrowingRuntimeCallee`, which composes this.
//
// ⚠ It ships WITHOUT an install-time drift guard, and `GraphemeRuntime.isThrowingCharacterRuntimeCallee`'s
// three conditions are why — all three hold here. There is exactly ONE member; `buildStrByteRead` DERIVES the
// `throws` stamp it emits by ASKING THIS PREDICATE, so the stamp and the parser's `try` requirement are one
// statement rather than two that agree today (they were two until the slice-8 review, which measured the
// divergence green over the whole corpus — see `buildStrByteRead`); and `runtimeCalleeSourceMethod` answers it
// from `ByteAtMethod` directly rather than through a map that could lose an arm. A SECOND throwing `__str_`
// callee makes this an `or`, and at that same edit it needs the guard `installManagedDirectoryRuntime`
// carries, for the moment a family stops being built by one builder.
export function isThrowingStringRuntimeCallee(callee ByteArray) returns bool
	return callee.equals(StrByteAtName)
end 'isThrowingStringRuntimeCallee'

// ⚠ **`StrFindNotFound` WAS HERE AND WENT WITH `__str_find`** (W49 wave 5). It was that search's "no
// occurrence" answer — a NEGATIVE INDEX rather than a thrown error, because its callers were not throwing
// and a `tryCall` per iteration would have been a control-flow join to answer a question they treated as
// ordinary. The corpus spells the same search `throws StringError.notFound` (`findIn`), which is the
// reference's own shape and needs no sentinel. `CommandLineRuntime.NoMoreArguments` is the one negative
// byte-position sentinel left, and it now carries the argument itself rather than citing this one.

// `__str_clone(src) -> newStr` — a String's DEEP CLONE (P1.7 slice 3b-vi-b): a fresh OWNED heap String, an
// independent copy of `src` that is droppable through `__str_decref` without touching `src`. The `(box) ->
// newBox` DUAL of `__str_decref`, so a managed array/struct that clones a String field through this drops it
// through `__str_decref`. `__`-prefixed compiler-internal (no E3004, no signature slotting) but NOT
// `__mm_`-prefixed; it calls `__mm_alloc`/`__str_copy` inside its Std body, which `scanRuntimeUsage` cannot
// see, so a reference to it turns on `usesHeap`/`usesStrCopy` explicitly (`recordCallUsage`).
export let StrCloneName = b"__str_clone"

// ⭐ **WHERE A STRING RECORD KEEPS THE BUFFER-OWNERSHIP ENCODING** (`BufferOwnership`) — the three slots
// its predicates read, built from THIS file's offsets. All three provenances the record format admits are
// ordinary values of that encoding, and no String-only branch stands in front of it:
//
//   * INLINE (`capacity@16 = InlineBufferCapacity`, `parent@32 = NoOwedAllocation`) — every owned String
//     is born this way (`Parser.emitStringInterp`, which `promoteToOwnedString` also routes through). Not
//     mine to write in place, and no separate allocation owed: the record's own free takes the bytes.
//   * DETACHED (`capacity@16 >= 0`) — a separate `__mm_alloc`'d buffer this record owns and must release,
//     which is exactly what the encoding calls an OWNER, so its base is its own `buffer@0`.
//   * RDATA (`capacity@16 = RdataBufferCapacity`) — a literal's immortal blob. It never reaches these two
//     functions today: the parser promotes a `var` String at its declaration and only an owned String is
//     ever dropped. It needs no arm of its own regardless — it is a non-owned buffer owing nothing, and
//     both of those are already what the encoding says.
//
// ⚠ **THIS REPLACES `parent@32 == -1` ("a detached root"), AND THE BEHAVIOUR IT DECIDED IS UNCHANGED.**
// That test was this file's own third spelling of "is this buffer mine?" — and, at the same offset as the
// Array record's `parent@32`, it meant the OPPOSITE thing (there, *someone else's allocation I owe a
// release to*). Now `parent@32` means one thing in both records and nothing here has to be told which.
// True iff every GRAPHEME of these bytes is exactly one byte — the `singleByteGraphemes@40` scan, run once
// per distinct literal at lower time (the cold path), never per value.
//
// ⭐ **ONE PASS TESTING BOTH, rather than an ASCII scan followed by a CR scan** — the corpus's
// `scanSingleByteGraphemes` (`stdlib/String.maxon:1048`) is the same loop for the same stated reason, and
// this is its compile-time twin over a literal's bytes.
export function bytesAreSingleByteGraphemes(bytes ByteArray) returns bool
	for b in bytes 'each'
		// A CR is ASCII and is NOT a grapheme on its own — GB3 joins it to a following LF — so it is the one
		// byte that clears this flag without being high.
		if b >= AsciiHighBit or b == CarriageReturnByte 'notSingleByte'
			return false
		end 'notSingleByte'
	end 'each'
	return true
end 'bytesAreSingleByteGraphemes'

// The NUL-terminated blob for a literal's payload — the bytes, then one NUL.
export function stringBlobBytes(bytes ByteArray) returns ByteArray
	var blob = ByteArray.create()
	blob.append(bytes)
	blob.push(NulTerminator)
	while blob.count() mod StringBlobAlignment != 0 'pad'
		blob.push(NulTerminator)
	end 'pad'
	return blob
end 'stringBlobBytes'

// Build the 48-byte record for a literal. `byteLength` EXCLUDES the NUL (it is the payload count);
// `singleByteGraphemes` is `bytesAreSingleByteGraphemes`'s answer.
//
// ⚠ **`buffer@0` HOLDS THE BLOB'S RDATA OFFSET, NOT 0, AND THIS IS LOAD-BEARING FOR DEDUP.** The PE
// writer OVERWRITES `buffer@0` with the blob's absolute VA (`ImageBase + rdataRva + blobOffset`), so
// the value stored here is irrelevant to what the program reads. But it is NOT irrelevant to
// `registerRdataConstant`, which DEDUPES records by their bytes: two different strings of the same
// length and ascii-ness have byte-identical records EXCEPT for `buffer@0`, so a placeholder of 0 would
// collapse `"hello"` and `"world"` into ONE record pointing at ONE blob — a silent wrong answer where
// every same-length string compares equal. Seeding `buffer@0` with the blob's own offset (distinct per
// distinct blob, shared by identical strings that already dedup their blob) makes records dedup EXACTLY
// when their strings are identical.
//
// ⭐ EACH FIELD IS APPENDED AT ITS NAMED OFFSET AND THE APPENDER ASSERTS IT LANDS THERE, so the offsets
// the runtime functions load by (`StringBufferOffset`, `StringLengthOffset`) and the offsets this
// writes are ONE set of constants that cannot drift: reorder a field or mis-size one and this panics
// rather than shipping a record the runtime reads wrong.
export function buildStringRecordBytes(blobOffset ByteOffset, byteLength ByteCount, singleByteGraphemes bool) returns ByteArray
	var record = ByteArray.create()
	appendRecordField(record, expectedOffset: StringBufferOffset, value: blobOffset as ParsedInt)
	appendRecordField(record, expectedOffset: StringLengthOffset, value: byteLength as ParsedInt)
	appendRecordField(record, expectedOffset: StringCapacityOffset, value: RdataBufferCapacity)
	appendRecordField(record, expectedOffset: StringElementSizeOffset, value: StringElementSize)
	appendRecordField(record, expectedOffset: StringParentPtrOffset, value: NoOwedAllocation)
	appendRecordField(record, expectedOffset: StringSingleByteGraphemesOffset, value: singleByteGraphemesFlagValue(singleByteGraphemes))

	if record.count() != StringRecordBytes 'sizeDrift'
		panic("buildStringRecordBytes: assembled {record.count()} bytes, not {StringRecordBytes} — a field's width does not match its offset spacing")
	end 'sizeDrift'
	return record
end 'buildStringRecordBytes'

function appendRecordField(record ByteArray, expectedOffset ByteOffset, value ParsedInt)
	if record.count() != expectedOffset 'offsetDrift'
		panic("buildStringRecordBytes: a record field is being written at offset {record.count()} but its constant says {expectedOffset} — the record layout the runtime reads and this writes have drifted")
	end 'offsetDrift'
	record.append(scalarImage(value, byteCount: StringFieldBytes))
end 'appendRecordField'

function singleByteGraphemesFlagValue(singleByteGraphemes bool) returns ParsedInt
	if singleByteGraphemes 'oneByteEach'
		return SingleByteGraphemesTrue
	end 'oneByteEach'
	return SingleByteGraphemesFalse
end 'singleByteGraphemesFlagValue'

// The `.rdata` labels a literal's blob and record register under. Split out so the two prefixes are
// named at the one place that uses them and `LowerMaxonToStd` names neither.
export function registerStringBlob(globalData GlobalDataTable, bytes ByteArray) returns String
	return globalData.registerRdataConstant(StringBlobPrefix, bytes: stringBlobBytes(bytes))
end 'registerStringBlob'

// Register a literal's record, seeded with its blob's offset (see `buildStringRecordBytes` for why the
// offset, not 0). `blobLabel` must already be registered — its offset is read back here.
export function registerStringRecord(globalData GlobalDataTable, blobLabel String, byteLength ByteCount, singleByteGraphemes bool) returns String
	let blobOffset = globalData.rdataOffsetOf(blobLabel)
	return globalData.registerRdataConstant(StringRecordPrefix, bytes: buildStringRecordBytes(blobOffset, byteLength: byteLength, singleByteGraphemes: singleByteGraphemes))
end 'registerStringRecord'

// --- Which compiler-internal runtime functions a module references ---
//
// ⭐ ONE WALK, THREE ANSWERS. `moduleUsesHeap`'s job (does this program touch the heap?) and the two
// String questions (does it print? does it compare strings?) are the SAME traversal — every call op,
// once — so they are answered together rather than by three near-identical walks. Each answer keys a
// DIFFERENT installation, and the heap answer stays `__mm_`-specific: a print-only program must carry
// NO allocator and NO leak check, so `usesHeap` reads `isRuntimeCallee` (the `__mm_` prefix), never
// "any compiler-internal callee".
//
// It asks the MAXON module because the answers are needed BEFORE lowering — the heap decision drives
// `.data` layout, and all three drive which functions get installed into the Std module.

// The set of `__destruct_<U>` symbols a module CALLS. A SET, not a list, because both
// `noteUnionDestructorUsage` and
// `installUnionDestructors` walk EVERY union (`project.enumTypes`) and ask "is this union's destructor
// referenced?" — a per-union membership test. Against a per-drop-site list that is an O(unions × drop
// sites) scan (the classic linear-lookup-in-a-linear-walk quadratic); against a set it is O(1) each, so
// the whole check is O(unions + drop sites). Insert also DEDUPLICATES — a union dropped D times records
// its one symbol once, not D copies.
export typealias DestructorSet = Set with ByteArray

// The set of `__clone_<T>` symbols a module references (P1.7 slice 3b-vi-b) — the CLONE twin of
// `DestructorSet`, collected from the `funcAddr(__clone_<T>)` element-cloner stamps and closed over nesting by
// `noteClonerUsage`, so `installStructCloners`/`installUnionCloners` synthesize only the referenced cloners.
// The SAME `Set with ByteArray` type is reused by `typeSupportsDeepClone` as its VISITED-name set (a
// cycle-breaker over struct/union names), since both are membership sets of `ByteArray` names.
export typealias ClonerSet = Set with ByteArray

export type RuntimeUsage
	export var usesHeap as bool
	// The program spawns a green thread (`async`/`await`). Drives `installGtRuntime` + the GT `.data`
	// globals + the two hand-assembled backend chunks. Set alongside `usesHeap` (spawn `__slab_alloc`s the
	// GT struct + arg buffer), from the `asyncCall`/`await` Maxon ops rather than a callee name — the async
	// ops are their own op kind, and their `__gt_*` calls do not exist until lowering.
	export var usesGt as bool
	// The program issues a YIELDING overlapped pipe read (`__gt_io_read`, the `spawnReadLine` probe, P1.5 slice
	// 1a-ii). A SUPERSET of `usesGt` (a read yields the green thread, so it needs the whole scheduler), plus the
	// IOCP substrate: `installIoRuntime` (`__io_init` + `__gt_io_read`), the hand-assembled `__io_completion_loop`
	// chunk, the six `__io_*` `.data` slots, and the run-queue CRITICAL_SECTION that guards the completion thread's
	// cross-thread `__gt_enqueue`. Set by `recordCallUsage` on a `__gt_io_read` call (which also sets `usesGt`).
	export var usesIocp as bool
	// The STREAMING subprocess API (P1.5 dogfood slice 1b) — the handle table + `__gt_subp_*` functions. A SUPERSET
	// of `usesIocp` (the yielding line read rides the completion thread), set by `recordCallUsage` on any
	// `__gt_subp_*` call. Drives `installSubpRuntime` + the `__subp_table` `.data` slot.
	export var usesStreaming as bool
	// W35: the two stream writers, each with its OWN bit under this file's one-bit-per-entry-point
	// discipline — a program that only prints must not carry the stderr writer, and neither declares any
	// transitive floor (see `StreamWriteStdoutName`).
	export var usesWriteStdout as bool
	export var usesWriteStderr as bool
	export var usesStrEq as bool
	export var usesStrCopy as bool
	export var usesIntToString as bool
	// The UNSIGNED decimal renderer (X11). A bit of its own rather than a widening of the one above,
	// because a program that only prints a declared non-negative value references only `__uint_to_string`
	// and must not carry the signed entry point it never calls — the "vocabulary does not ship ahead of
	// its consumer" rule `installStringRuntime` states, applied to a second entry point of one builder.
	export var usesUIntToString as bool
	export var usesBoolToString as bool
	export var usesStrAppend as bool
	export var usesStrDecref as bool
	// The program touches an `Array` (P1.7 slice 1). Any `__arr_*` runtime call turns this on — and, like
	// the String helpers, turns on `usesHeap` too, because the array helpers `__mm_alloc`/`__mm_free` the
	// backing record and its element buffer inside their Std bodies, which this Maxon-module scan cannot
	// see. It drives `installArrayRuntime` (all the array helpers, appended already-lowered).
	export var usesArray as bool
	// The program touches a `Set` (P1.7b slice A). Any `__set_*` runtime call turns this on — and, like
	// `usesArray`, turns on `usesHeap` too, because the set helpers `__mm_alloc`/`__mm_free` the record and
	// its three external buffers inside their Std bodies, which this Maxon-module scan cannot see. It drives
	// `installSetRuntime`. Its own bit so a set-free program stays golden-neutral (installs nothing).
	export var usesSet as bool
	// The program touches a `Map`. Any `__map_*` runtime call turns this on — and, like `usesSet`, turns on
	// `usesHeap` too, because the map helpers `__mm_alloc`/`__mm_free` the record and its FOUR external
	// buffers inside their Std bodies, which this Maxon-module scan cannot see. It drives `installMapRuntime`.
	// Its OWN bit and NOT `usesSet`, even though the two runtimes are built from one shared graph
	// (`HashTableRuntime`): the graph is shared at BUILD time, but the installed functions are two disjoint
	// name sets, so a set-only program must not carry `__map_*` and a map-only program must not carry
	// `__set_*`.
	export var usesMap as bool
	// The program touches a `List`. Any `__list_*` call turns this on — and, like `usesSet`, turns on
	// `usesHeap` too, because the list helpers `__mm_alloc` the chain header and every node and `__mm_free`
	// them again inside their Std bodies, which this Maxon-module scan cannot see. It drives
	// `installListRuntime`. Its OWN bit so a list-free program stays golden-neutral (installs nothing).
	export var usesList as bool
	// The program DROPS a single opaque type-parameter value (`__drop_type_param`, P1.7 slice 3b-v /
	// Finding A) — a consumed feed binding left live at a scope exit, an opaque array element moved out
	// (`.pop()`), OR a bare opaque `T` field reassignment (`self.saved = next`). Its OWN bit, decoupled from
	// `usesArray`: a bare-field reassign in an ARRAY-FREE generic struct emits `__drop_type_param` yet touches
	// no `__arr_*`, so gating its install on `usesArray` would leave the call unlinked. `__drop_type_param` is
	// `__`-prefixed but NOT `__mm_`/`__arr_`-prefixed, so a call to it sets no other usage bit; its body only
	// reads the descriptor's `destroyFunc@40` and `callIndirect`s it (no direct alloc/free), so this bit alone
	// drives `installDropTypeParamRuntime` and pulls in no transitive floor of its own.
	export var usesDropTypeParam as bool
	// The program DROPS a value held at its INTERFACE type (`__drop_existential`, P1.7a-existentials slice
	// 2) — an owned interface-typed field released by its struct's destructor cascade, or a consumed
	// existential parameter left live at a scope exit. Its OWN bit for `usesDropTypeParam`'s exact reason,
	// with the roles reversed: an interface field drops in a program that instantiates no generic, so gating
	// its install on the descriptor drop's bit would leave THAT call unlinked. Its body only reads the
	// witness table's `destroyFunc@8` and `callIndirect`s it, so it pulls in no transitive floor of its own.
	export var usesDropExistential as bool
	// The program CO-OWNS a value held at its INTERFACE type (`__retain_existential`, P1.7a-existentials
	// slice 2) — a borrowed existential bound into a `var`, or one forwarded to a consuming position. Its
	// OWN bit rather than `usesDropExistential`'s, for the reason `usesRetain` is not `usesIncref`'s: the two
	// have independent callers, so folding either into the other installs an unreachable copy of the unused
	// one. It DOES imply `__mm_incref`, which its body calls — declared through `recordCallUsage`.
	export var usesRetainExistential as bool
	// The program takes a SECOND owner of a heap box (`__mm_incref`). Two producers: the array runtime's
	// zero-copy slice (a view increfs the parent's element buffer — implied by `usesArray`, since the call
	// lives in a Std body this scan cannot see), and the PARSER's `try … otherwise` reconciliation, which
	// increfs an ok-edge borrow or an aliased error-edge binding so both merge into one owned phi — a `call
	// __mm_incref` this scan DOES see. Drives `installMmRuntime` to build `__mm_incref`; a program that never
	// increfs (the common one) keeps it out. Set alongside `usesHeap` (an incref is on a `__mm_alloc`'d box).
	export var usesIncref as bool
	// The program co-owns a BORROWED managed-aggregate parameter into a `var` (`var q = p`, OPEN #40),
	// which the parser makes a second owner of the caller's box via `__mm_retain`. Its OWN bit, not
	// `usesIncref`: `__mm_retain` (returns the pointer) and `__mm_incref` (void) have independent callers,
	// so folding either into the other installs a dead function in the program that uses only the other
	// (see `installMmRuntime`). A `call __mm_retain` this scan sees directly. Drives `installMmRuntime` to
	// build `__mm_retain`; a program that never co-owns a borrowed aggregate keeps it out. Set alongside
	// `usesHeap` (a retain is on a `__mm_alloc`'d box).
	export var usesRetain as bool
	// ⭐ The program declares at least one MANAGED top-level `var` (P1.7 slice 2a), so it carries
	// `__module_init` + `__maxon_global_cleanup` and every entry stub calls them around `main`. Set NOT by
	// this Maxon-module scan but by `installManagedGlobalInit`, which is where the decision is made — the
	// same discipline the leak/GT gates follow (see `BackendDispatch.buildBackend`'s header): an entry stub
	// asking the module "is `__module_init` still there?" would be asking a question dead-function
	// elimination can change the answer to, where "was it installed?" is fixed. The RUNTIME floor those two
	// functions need (`__mm_alloc`, `__str_clone`, `__str_decref`, `__arr_decref`) rides the ordinary bits:
	// they are appended to the Maxon module BEFORE `scanRuntimeUsage` walks it, so their calls are seen
	// exactly as user code's are.
	export var usesManagedGlobals as bool
	// The `__destruct_<U>` symbols this module CALLS (P1.3 slice 2) — collected from the drop sites so
	// `installUnionDestructors` synthesizes only the referenced ones, and `noteUnionDestructorUsage`
	// can classify their transitive `__str_decref`/`__mm_free` needs. Full symbols (not names): the
	// consumers query them against `destructorSymbol(name)`, avoiding a byte-substring extract. A
	// SET so that per-union query is O(1) — see `DestructorSet`.
	export var neededDestructors as DestructorSet
	// The program DEEP-CLONES a String (`__str_clone`, P1.7 slice 3b-vi-b) — a managed array/struct copy that
	// clones a String element/field. Its OWN bit, like `usesStrDecref`: `__str_clone` calls `__mm_alloc`/
	// `__str_copy` inside its Std body this scan cannot see, so a reference turns on `usesHeap`/`usesStrCopy`
	// too (`recordCallUsage`). Drives `installStringRuntime` to build `__str_clone`.
	export var usesStrClone as bool
	// ⚠ **THE P1.8 SLICE C BYTE/ASCII FAMILY'S BITS ARE ALL GONE — ALL EIGHT OF THEM.**
	// `usesStrStartsWith`/`usesStrEndsWith` in W49 wave 1, `usesStrMapCase`/`usesStrReplace`/
	// `usesStrReplaceFirst` in wave 2, `usesStrContains` in wave 4, and `usesStrSplit` with
	// `usesStrFind`/`usesStrRangeEq` in wave 5. All seven members are the CORPUS's now (struck from
	// `Parser.stringSurfaceMemberNames`), so nothing names their entry points and a bit for any of them could
	// only ever read false. The corpus bodies reach `byteAt`, `setByte`, `addressableBytes` and
	// `__ManagedMemory.slice`, whose own doors are still shv2's and keep their own bits below.
	//
	// ⚠ **THE LAST TWO ARE THE ONES THAT CAME OFF DIFFERENTLY, AND THE ORDER IS THE WHOLE OF IT.**
	// `usesStrFind`/`usesStrRangeEq` were never set by a member — they were set TRANSITIVELY, by
	// `closeStringMethodNeeds`, from whichever member reached the search underneath. With `contains` (wave 4)
	// and the `StringIndex` searches (wave 3) already gone, `usesStrSplit` was the last thing that could turn
	// `usesStrFind` on, and `usesStrFind` the last thing that could turn `usesStrRangeEq` on — so all three
	// die together and none of them could die sooner. See the P1.8 Slice C grave at the head of this file for
	// why an entry point may only be deleted once every PRODUCER of its callee is gone.
	// The P1.8 Slice E entry point that remains, with its OWN bit under this file's one-bit-per-entry-point
	// discipline: a program that builds no String from bytes must not carry the classifying scan.
	export var usesStrFromBytes as bool
	export var usesStrOfBuffer as bool
	export var usesMmToCString as bool
	// The three stdlib-only byte doors, each with its OWN bit under this file's one-bit-per-entry-point
	// discipline: a program whose stdlib cone reads bytes must not carry the view builder, and one that takes
	// a byte view must not carry a bounds check it never reaches. `usesStrBytesView` declares
	// `usesArray`/`usesHeap` in `closeStringMethodNeeds` — it calls `__arr_create` and `__mm_incref` inside
	// its synthesized body, which this Maxon-module scan cannot see. `usesStrByteAt` and
	// `usesStrByteAtOrPanic` declare NOTHING: each body loads two words and then either reads a byte or
	// leaves. The two byte reads keep SEPARATE bits although their graphs are near-identical, because a
	// program that only reaches the throwing one must not carry the panicking one's `mrt_panic` call site.
	export var usesStrBytesView as bool
	export var usesStrByteAt as bool
	export var usesStrByteAtOrPanic as bool
	// The program copies a MANAGED-element array (`__arr_slice_managed`/`__arr_clone_managed`/
	// `__arr_append_managed`, P1.7 slice 3b-vi-b). Its OWN bit, DECOUPLED from `usesArray`, so a program that
	// only uses TRIVIAL arrays does not carry the three managed-copy helpers. Set alongside `usesArray`/
	// `usesHeap` (the helpers are `__arr_`-prefixed). Drives the managed-copy install in `installArrayRuntime`.
	export var usesManagedArrayCopy as bool
	// The program copies an OPAQUE-`T` array (`__arr_slice_opaque`/`__arr_clone_opaque`/`__arr_append_opaque`,
	// P1.7 slice 3b-vi-b-β) — a `slice`/`clone`/`append` on an `Array with <type parameter>` field in a generic
	// body. Its OWN bit, DECOUPLED from `usesArray`, so a program that touches no opaque-array copy does not carry
	// the three wrappers. Set alongside `usesManagedArrayCopy` (`recordCallUsage`), because each wrapper's managed
	// branch calls the α `__arr_*_managed` helpers. Drives the opaque-copy install in `installArrayRuntime`.
	export var usesOpaqueArrayCopy as bool
	// The `__clone_<T>` symbols this module references (P1.7 slice 3b-vi-b) — the CLONE twin of
	// `neededDestructors`, collected from the `funcAddr(__clone_<T>)` element-cloner stamps and closed over
	// nesting by `noteClonerUsage`, so `installStructCloners`/`installUnionCloners` synthesize only the
	// referenced cloners. `usesHeap` follows any cloner (the box it allocates).
	export var neededCloners as ClonerSet
	// The program reads the WALL clock (`__clock_now_unix_s`, `__Builtins.currentUnixTimeSeconds`). Its OWN
	// bit, DECOUPLED from `usesGt` and from `usesHeap`, and that decoupling is the point: a calendar read is
	// a leaf that calls one Win32 import and divides, with no relationship to the green-thread scheduler
	// whose `__gt_now_ns` answers the OTHER clock question. Folding it under `usesGt` would install the
	// entire scheduler — plus the allocator and the leak gate under it — for a program that asks what
	// today's date is. Drives `installClockRuntime` + the one `__clock_wall_ticks` `.data` slot.
	export var usesWallClock as bool
	// ⭐ **THE P1.8 SLICE B GRAPHEME FAMILY — ONE BIT PER ENTRY POINT**, following this file's existing
	// discipline rather than one `usesGrapheme` blanket: a program that only asks
	// `graphemeBreakProperty(cp)` must carry neither the segmenter nor the UTF-8 decoders, and a program
	// that never touches a String at all must carry none of it. Each is set TRANSITIVELY by
	// `recordCallUsage` from whichever entry point the module actually names (a `__gr_count` reference
	// turns on `__gr_end`, which turns on `__gr_break` and the decoders, which turn on `__gbp` and
	// `__ext_pict`) — the same "declare what the synthesized body calls, because this Maxon-module scan
	// cannot see inside it" rule the String method family already follows.
	// `__char_at` MINTS a Character — one `__mm_alloc`'d fused record per call, blitted with `__str_copy`
	// — so it declares the heap and the copy loop that `emitBuildOwnedInlineString` puts inside its body.
	export var usesCharAt as bool
	export var usesCharFromCodepoint as bool
	// `__char_cmp` reads two BORROWED records' `buffer@0`/`length@8` and walks their bytes, allocating
	// nothing and calling nothing — `__char_ascii`'s floor-free shape, so it has no arm in
	// `closeGraphemeNeeds` either.
	export var usesCharCmp as bool
	// `__char_ascii` reads two fields of a BORROWED record and calls nothing, so it declares no transitive
	// floor at all — hence no arm in `closeGraphemeNeeds`. `usesCharCmp` above is the other such bit.
	export var usesCharAsciiValue as bool
	// `__str_to_bytes` PUSHES into a caller-created `Array with Byte`, so it declares the array runtime
	// (and the heap under it) in `closeGraphemeNeeds`. It is the LAST entry point that fills an array the
	// parser built — `__str_split` was the other, and retired at W49 wave 5.
	export var usesStrToBytes as bool
	// ⚠ **`usesStrToCodepoints`/`usesStrToUtf16` STOOD HERE AND WENT AT W49 WAVE 6** with the two decoding
	// views, onto the corpus's lazy `CodepointView`/`UTF16View`. They were separate bits under this file's
	// one-bit-per-entry-point discipline — a program asking for the bytes must not carry a UTF-8 decoder, and
	// one asking for the codepoints must not carry the surrogate encoder — and that discipline is why their
	// removal takes nothing else with it: `usesStrToBytes` never stood for any of the three.
	// ⚠ **THE P1.8 SLICE B2 `StringIndex` FAMILY HAS NO BITS LEFT, AND NO FILE EITHER.** Six went with the
	// five members that retired onto `stdlib/String.maxon` at W49 wave 3; the last two
	// (`usesStrIndexAdvance`/`usesStrIndexSlice`) went at wave 4 with `String.slice`, which was the only
	// caller `__strix_advance` and `__strix_slice` had. `Runtime/StringIndexRuntime.maxon` is deleted, not
	// emptied — the corpus bodies behind every one of them are ordinary Maxon call edges now, which the
	// reachability walk FINDS rather than being told.
	// ⭐ **THE UNICODE `General_Category` TABLE (P1.8 Slice D, R2).** Its own bit, and DECOUPLED from every
	// String bit: `__ucd_cat` is a LEAF that reads two `.rdata` blobs and does integer arithmetic — no heap,
	// no copy loop, no segmenter — so a program that classifies a codepoint carries nothing else, and a
	// program that never does carries neither the 65,536-byte BMP table nor the supplementary one. Set by
	// `recordCallUsage` on a `__ucd_cat` reference, which is what `CharacterSet.contains` emits.
	export var usesUcdCategory as bool
	// ⭐ **THE P1.8 SLICE D `CharacterSet` FAMILY — ONE BIT PER ENTRY POINT**, following this file's
	// existing discipline: a program that only builds a `CharacterSet` must not carry the membership probe.
	// Each is set by `recordCharacterSetUsage` from whichever entry point the module actually names, and
	// `__cs_contains` in turn declares `__set_contains` and `__ucd_cat` through `closeCharacterSetNeeds`.
	//
	// ⚠ A FOURTH, `usesStrTrim`, went at W49 wave 4 with the three trims, which are `stdlib/String.maxon`'s
	// now. It was the one bit here that reached into all THREE sibling families, which is what fixed this
	// family's recording ORDER — the order is kept, because it is a rule about families and not about the arm
	// that first needed it.
	export var usesCharSetMake as bool
	export var usesCharSetDecref as bool
	export var usesCharSetContains as bool
	// R4.1: the program opens a file. Unlike the wall clock it DOES declare a transitive dependency —
	// `__mf_open_read` allocates a NUL-terminated scratch copy of the path and the handle box through
	// `__mm_alloc`/`__mm_free`, so it carries `usesHeap` too (set together below).
	export var usesManagedFile as bool
	// R4.3: the program searches, creates or asks about a DIRECTORY. Its own bit, so a file-only program
	// carries none of the directory runtime. Like the file family it declares a transitive dependency on
	// `usesHeap` (the find block, the box and the path scratch are all `__mm_alloc`'d) — and, unlike it,
	// ALSO on `usesArray`: `__md_filename`/`__md_current_path` build their `__ManagedMemory` answer through
	// `__arr_create`/`__arr_reserve`, calls that live in a Std body this Maxon-module scan cannot see.
	export var usesManagedDirectory as bool
	// The program reads its COMMAND LINE. Like the directory family it declares a transitive dependency on
	// `usesHeap` (the scratch buffer is a raw alloc) AND on `usesArray`: `__cl_arg` builds its
	// `__ManagedMemory` answer through `__arr_create`/`__arr_reserve` inside a Std body this Maxon-module
	// scan cannot see.
	export var usesCommandLine as bool
	// W5: the program reads STANDARD INPUT. It carries `usesHeap` (the out word is a raw alloc) AND
	// `usesArray`: `__con_read_stdin` answers with an `Array` record it builds through
	// `__arr_create`/`__arr_reserve` in a Std body this Maxon-module scan cannot see.
	export var usesConsoleStdin as bool
	// W5: the program asks for its own EXECUTABLE PATH. Its own bit rather than sharing the one above, under
	// this file's one-bit-per-entry-point discipline: the two serve different stdlib modules and reach
	// different OS APIs, so a program that reads stdin must not carry a path walk it never calls. Same two
	// transitive bits, for the same two reasons — the grow-and-retry buffer is a raw alloc, and the answer is
	// an `Array` record built one tier down.
	export var usesProcessIntrospection as bool

	static function create() returns RuntimeUsage
		return Self{usesHeap: false, usesGt: false, usesIocp: false, usesStreaming: false, usesWriteStdout: false, usesWriteStderr: false, usesStrEq: false, usesStrCopy: false, usesIntToString: false, usesUIntToString: false, usesBoolToString: false, usesStrAppend: false, usesStrDecref: false, usesArray: false, usesSet: false, usesMap: false, usesList: false, usesDropTypeParam: false, usesDropExistential: false, usesRetainExistential: false, usesIncref: false, usesRetain: false, usesManagedGlobals: false, neededDestructors: DestructorSet.create(), usesStrClone: false, usesStrFromBytes: false, usesStrOfBuffer: false, usesMmToCString: false, usesStrBytesView: false, usesStrByteAt: false, usesStrByteAtOrPanic: false, usesManagedArrayCopy: false, usesOpaqueArrayCopy: false, neededCloners: ClonerSet.create(), usesWallClock: false, usesCharAt: false, usesCharCmp: false, usesCharFromCodepoint: false, usesCharAsciiValue: false, usesStrToBytes: false, usesUcdCategory: false, usesCharSetMake: false, usesCharSetDecref: false, usesCharSetContains: false, usesManagedFile: false, usesManagedDirectory: false, usesCommandLine: false, usesConsoleStdin: false, usesProcessIntrospection: false}
	end 'create'
end 'RuntimeUsage'

// `unreachableStdlib` names the functions this scan must ignore — the STDLIB functions no path from
// `main` reaches (`StdlibFacts.unreachable`, see StdlibSource). Dead-function elimination drops them
// before the back end, so the floor they would ask for is a floor for code the program does not
// contain: a `Clock` nothing calls must not install the green-thread scheduler and the wall-clock
// `.data` slot. It never contains a USER function — an unreached user body still speaks for the
// program — so the answer for every stdlib-free program is unchanged.
export function scanRuntimeUsage(module MaxonModule, unreachableStdlib FunctionNameSet, funcSignatures FuncSignatureMap) returns RuntimeUsage
	var usage = RuntimeUsage.create()
	for func in module.functions 'eachFunc'
		if unreachableStdlib.contains(func.name) 'notInTheProgram'
			continue
		end 'notInTheProgram'
		for blockRef in func.blockRefs 'eachBlock'
			let block = try module.blocks.get(blockRef) otherwise panic("scanRuntimeUsage: blockRef from func.blockRefs not in module.blocks")
			for opIdx in block.opRefs 'eachOp'
				let op = try module.ops.get(opIdx) otherwise panic("scanRuntimeUsage: opIdx {opIdx} not in module.ops")
				classifyRuntimeCall(op, usage: usage, funcSignatures: funcSignatures)
			end 'eachOp'
		end 'eachBlock'
	end 'eachFunc'
	return usage
end 'scanRuntimeUsage'

function classifyRuntimeCall(op MaxonOp, usage RuntimeUsage, funcSignatures FuncSignatureMap)
	match op 'op'
		call(_, callee, _, _, _, _, _, _) then recordCallUsage(callee, usage: usage)
		literal to stringLiteral then break 'op'
		// A throwing call names a user callee whose runtime usage is scanned exactly as `call`'s is; the
		// throw/propagate terminators and `panicAbort` name no user callee (panic exits directly) (P1.4b).
		tryCall(_, _, callee, _, _, _, _, _, _) then recordCallUsage(callee, usage: usage)
		throwError to panicAbort then break 'op'
		// P1.5-A1: an `indirectCall` calls through a code POINTER and names no runtime callee, so it records
		// nothing. A `functionRef` naming a USER function is likewise a bare `lea` of no runtime consequence —
		// but one naming a COMPILER-EMITTED callee is the address of an array element destructor
		// stamped into `element_destroy@40` (P1.7 slice 3), and THAT reference must install its target (a
		// `__str_decref`/`__destruct_<T>`/`__mm_decref`/`__arr_decref`) exactly as a direct `call` to it would —
		// its transitive needs then close through `noteDestructorUsage`. Recorded through the same `recordCallUsage`.
		functionRef(_, funcName) then recordFunctionRefUsage(funcName, usage: usage, funcSignatures: funcSignatures)
		indirectCall then break 'op'
		// P1.5-B1a/B2b: `async`/`await`/`try await` carry the green-thread scheduler. Detected by OP KIND
		// (their `__gt_*` calls do not exist until lowering), and imply the HEAP too — `__gt_spawn`
		// `__slab_alloc`s the GT struct and the argument buffer.
		asyncCall to tryAwait then recordGtUsage(usage)
		// `sizeof(T)` lowers to a plain `loadIndirect` of the layout descriptor — it names no runtime callee
		// and pulls in no runtime floor (the descriptor is pure `.rdata`), so it records no usage (P1.6-B1).
		sizeofType then break 'op'
		constArrayLiteral then recordConstArrayLiteralUsage(usage)
		// The jump table names no runtime callee and pulls in no runtime floor — a bare indexed branch.
		switch then break 'op'
		// A witness dispatch names no runtime callee and pulls in no runtime floor — the fused call reads a
		// `.rdata` witness table and jumps; the dispatched user impl is scanned on its own (P1.7a slice 2a).
		// The throwing form adds an error flag, not a runtime callee.
		witnessDispatch to witnessTryDispatch then break 'op'
		// A panic names no runtime callee under either spelling — it exits directly.
		panicAbortValue then break 'op'
	end 'op'
end 'classifyRuntimeCall'

// An `async`/`await` op turns on both scheduler and heap: the scheduler runs the green threads, and the
// heap floor supplies the `__slab_alloc` that `__gt_spawn` and the async arg-buffer spill need.
function recordGtUsage(usage RuntimeUsage)
	usage.usesGt = true
	usage.usesHeap = true
end 'recordGtUsage'

// A CONSTANT array literal over an immortal `.rdata` blob — a `b"…"` byte string, or a packed
// `[0 as Q, …]` — turns on both the Array runtime and the heap under it, the same pair any `__arr_*` call
// declares (`recordCallUsage`'s array arm), because the literal IS an owned Array record (`__mm_alloc`)
// whose `.count()`/`.get()`/drop go through the array runtime. Both producers of `constArrayLiteral` need
// exactly this pair, which is why one recorder still serves the op after it stopped being byte-string-only.
function recordConstArrayLiteralUsage(usage RuntimeUsage)
	usage.usesArray = true
	usage.usesHeap = true
end 'recordConstArrayLiteralUsage'

// A `functionRef` whose target is a COMPILER-EMITTED callee is an array element destructor's address stamped
// into `element_destroy@40` (P1.7 slice 3) — its target must be installed exactly as a direct `call` to it
// would, so it routes through the SAME `recordCallUsage` (turning on the heap/`usesStrDecref`/`usesArray` bit
// or adding to `neededDestructors`, per the callee). A `functionRef` to a USER function is a plain
// code-pointer `lea` of no runtime consequence and records nothing (the P1.5-A1 behaviour, unchanged).
//
// ⚠ **THE TEST IS `isSignaturelessCompilerCallee` AND NOT THE `__` PREFIX (A1r review)**, because since D6/A1r
// a `__` name may be DECLARED — in `stdlib/Builtins.maxon` — and a value use of THAT is the USER case: it is
// a `funcAddr` of the name's `__fnref_` thunk (`lowerFunctionRef`, which parts the same two ways on the same
// predicate), never an installable runtime entry. Keyed on the prefix, `recordCallUsage` was asked about a
// user function; today's roster maps no such name to a bit, so nothing moved — but the question was already
// the wrong one, and a `Builtins.maxon` declaration sharing a runtime prefix (`__mm_`) would have installed a
// runtime floor for a program that never calls into it.
function recordFunctionRefUsage(funcName ByteArray, usage RuntimeUsage, funcSignatures FuncSignatureMap)
	if isSignaturelessCompilerCallee(funcName, funcSignatures: funcSignatures) 'runtimeAddress'
		recordCallUsage(funcName, usage: usage)
	end 'runtimeAddress'
end 'recordFunctionRefUsage'

// ⭐ **THE ONE CALLEE-NAME → RUNTIME-USAGE-BIT MAP.** Exported so `noteDestructorUsage` can root a
// managed opaque-`T` `Array` element's destructor (P1.7 slice 3b-iii) through the IDENTICAL mapping the
// module scan gives a callee named directly — a `__str_decref` turns on the String runtime, a `__arr_decref`
// the array runtime, a `__destruct_<T>` joins `neededDestructors` — so the reloc-baked destructor is
// installed for the writer to resolve exactly as if the module had called it.
export function recordCallUsage(callee ByteArray, usage RuntimeUsage)
	if isRuntimeCallee(callee) 'heap'
		usage.usesHeap = true
	end 'heap'
	// A DIRECT `__gt_*` runtime call carries the whole green-thread scheduler (P1.5 mid-body-yield). `async`/
	// `await`/`try await` are detected by op KIND above because their `__gt_*` calls do not exist until
	// lowering, but `__Builtins.sleep(ms)` lowers in the FRONT END to a `call __gt_sleep`, which IS a Maxon
	// `call` this scan sees — so any `__gt_*` callee here turns on the scheduler (and, via `recordGtUsage`,
	// the heap). A source `sleep(ms)` reaches it one frame down, inside `stdlib/Sleep.maxon`'s body, which
	// this scan walks because stdlib source is merged into the module it walks — but ONLY IF A PATH FROM
	// `main` REACHES THAT BODY. `scanRuntimeUsage`'s `unreachableStdlib` filter (above) skips the rest, and
	// that qualifier is the load-bearing half, not a footnote: it is what keeps listing a stdlib module
	// byte-neutral for a program that does not use it, and it is why an unreached `sleep(ms)` compiles for a
	// target with no `__gt_sleep` while an unreached `__Builtins.sleep(ms)` in USER code is still refused.
	if isGtRuntimeCallee(callee) 'gt'
		recordGtUsage(usage)
	end 'gt'
	// A `__gt_io_read` call (the `spawnReadLine` probe, P1.5 slice 1a-ii) additionally carries the IOCP substrate:
	// the completion port + completion thread + wake event + run-queue lock. `usesGt` is already set by the `__gt_`
	// prefix above; this bit installs the IOCP-only pieces.
	if callee.equals(IoReadName) 'ioread'
		usage.usesIocp = true
	end 'ioread'
	// A `__gt_subp_*` call (the P1.5 streaming subprocess API, slice 1b) carries the whole streaming runtime: the
	// handle table + the `__gt_subp_*` functions, which ride the IOCP substrate (`usesIocp`) and build owned Strings
	// from raw bytes (`__mm_alloc`/`__str_copy` inside their bodies — `usesHeap`/`usesStrCopy`, declared here because
	// this Maxon-module scan cannot see those transitive calls). `usesGt`/`usesHeap` are already set by the `__gt_`
	// prefix above; these bits install the streaming-only pieces.
	if bytesStartWith(callee, prefix: SubpCalleePrefix) 'streaming'
		usage.usesStreaming = true
		usage.usesIocp = true
		usage.usesStrCopy = true
	end 'streaming'
	// A `__clock_*` call carries the WALL clock and NOTHING ELSE — no scheduler, no heap, no leak gate. It is
	// the ONE runtime family here that declares no transitive dependency, and that is a fact about the code
	// rather than an omission: `__clock_now_unix_s`'s Std body reads one `.data` word through one Win32 import
	// and divides, calling nothing this Maxon-module scan cannot see.
	if isClockRuntimeCallee(callee) 'wallClock'
		usage.usesWallClock = true
	end 'wallClock'
	// R4.1: a `__mf_*` call. It carries `usesHeap` with it, unlike the clock above — the open allocates a
	// NUL-terminated scratch copy of the path and the handle box, and frees the scratch.
	if isManagedFileRuntimeCallee(callee) 'managedFile'
		usage.usesManagedFile = true
		usage.usesHeap = true
	end 'managedFile'
	// R4.3: a `__md_*` call. It carries `usesHeap` (the find block, the box and the path scratch) AND
	// `usesArray`, which the file family does not need: `__md_filename`/`__md_current_path` answer with an
	// `Array` record they build through `__arr_create`/`__arr_reserve` inside their Std bodies, and this
	// Maxon-module scan cannot see a call one tier down. Left off, those two would link against nothing.
	if isManagedDirectoryRuntimeCallee(callee) 'managedDirectory'
		usage.usesManagedDirectory = true
		usage.usesHeap = true
		usage.usesArray = true
	end 'managedDirectory'
	// A `__cl_*` call. Same two transitive bits as the directory family and for the same reasons: the scratch
	// buffer is a raw alloc, and `__cl_arg` answers with an `Array` record it builds one tier down.
	if isCommandLineRuntimeCallee(callee) 'commandLine'
		usage.usesCommandLine = true
		usage.usesHeap = true
		usage.usesArray = true
	end 'commandLine'
	// W5: a `__con_*` or a `__proc_*` call. Same two transitive bits as the command-line family and for the
	// same two reasons — a raw-alloc scratch word (or buffer), and an `Array` record each answers with from a
	// Std body this Maxon-module scan cannot see. Left off, both would link against nothing.
	if isConsoleRuntimeCallee(callee) 'consoleStdin'
		usage.usesConsoleStdin = true
		usage.usesHeap = true
		usage.usesArray = true
	end 'consoleStdin'
	if isProcessRuntimeCallee(callee) 'processIntrospection'
		usage.usesProcessIntrospection = true
		usage.usesHeap = true
		usage.usesArray = true
	end 'processIntrospection'
	if callee.equals(StreamWriteStdoutName) 'writestdout'
		usage.usesWriteStdout = true
	end 'writestdout'
	if callee.equals(StreamWriteStderrName) 'writestderr'
		usage.usesWriteStderr = true
	end 'writestderr'
	if callee.equals(StrEqName) 'streq'
		usage.usesStrEq = true
	end 'streq'
	if callee.equals(StrCopyName) 'strcopy'
		usage.usesStrCopy = true
	end 'strcopy'
	if callee.equals(IntToStringName) 'inttostr'
		usage.usesIntToString = true
	end 'inttostr'
	if callee.equals(UIntToStringName) 'uinttostr'
		usage.usesUIntToString = true
	end 'uinttostr'
	if callee.equals(BoolToStringName) 'booltostr'
		usage.usesBoolToString = true
	end 'booltostr'
	// `__str_append` and `__str_decref` call `__mm_alloc`/`__mm_free` inside their Std bodies, which
	// this Maxon-module scan cannot see — so their TRANSITIVE heap dependency is declared here rather
	// than discovered. `__str_append` also blits with `__str_copy`. Turning these bits on is what
	// keeps a program that appends from missing its allocator or its copy loop.
	if callee.equals(StrAppendName) 'strappend'
		usage.usesStrAppend = true
		usage.usesHeap = true
		usage.usesStrCopy = true
	end 'strappend'
	if callee.equals(StrDecrefName) 'strdecref'
		usage.usesStrDecref = true
		usage.usesHeap = true
	end 'strdecref'
	// A `__mm_incref` the PARSER emitted (the `try … otherwise` phi reconciliation) — install the incref
	// helper for it, not only for the array runtime's `usesArray`. `usesHeap` follows because the box it
	// increfs was `__mm_alloc`'d (which set `usesHeap` at its own call site anyway).
	if callee.equals(MmIncrefName) 'incref'
		usage.usesIncref = true
		usage.usesHeap = true
	end 'incref'
	// A `__mm_retain` the PARSER emitted (co-owning a borrowed managed-aggregate parameter into a `var`,
	// OPEN #40) — install the retain helper for it. `usesHeap` follows because the box it retains was
	// `__mm_alloc`'d (which set `usesHeap` at that box's own allocation site anyway).
	if callee.equals(MmRetainName) 'retain'
		usage.usesRetain = true
		usage.usesHeap = true
	end 'retain'
	// Any `__arr_*` call carries the whole array runtime, and the heap under it: `__arr_create`/`__arr_grow`
	// `__mm_alloc` the record and the element buffer, `__arr_decref` `__mm_free`s them — none of which this
	// Maxon-module scan sees, since those calls live in the synthesized Std bodies. So a single reference
	// declares both bits, exactly as `__str_append`/`__str_decref` do for their own transitive heap use.
	if isArrayRuntimeCallee(callee) 'array'
		usage.usesArray = true
		usage.usesHeap = true
	end 'array'
	// Any `__set_*` call carries the whole set runtime, and the heap under it: `__set_create`/`__set_grow`
	// `__mm_alloc` the record and its three buffers, `__set_decref` `__mm_free`s them — none of which this
	// Maxon-module scan sees, since those calls live in the synthesized Std bodies. So a single reference
	// declares both bits, exactly as the `__arr_*` arm above does (P1.7b slice A).
	if isSetRuntimeCallee(callee) 'set'
		usage.usesSet = true
		usage.usesHeap = true
	end 'set'
	// Any `__map_*` call carries the whole map runtime, and the heap under it — the `__set_*` arm above, one
	// column wider: `__map_create`/`__map_grow` `__mm_alloc` the record and its FOUR buffers and
	// `__map_decref` `__mm_free`s them, none of which this Maxon-module scan sees. It is a SEPARATE arm rather
	// than a widened prefix test because the two runtimes install disjoint name sets — see `usesMap`.
	if isMapRuntimeCallee(callee) 'map'
		usage.usesMap = true
		usage.usesHeap = true
	end 'map'
	// Any `__list_*` call carries the whole list runtime, and the heap under it — the `__set_*` arm above over
	// a CHAIN instead of a table: `__list_create` and every insertion `__mm_alloc` (the header, then one node
	// each) and `__list_decref` `__mm_free`s all of them, none of which this Maxon-module scan sees.
	if isListRuntimeCallee(callee) 'list'
		usage.usesList = true
		usage.usesHeap = true
	end 'list'
	// The single-value descriptor-gated drop (P1.7 slice 3b-v / Finding A). Decoupled from `usesArray` so an
	// array-free bare-field reassign links: it is `__`-prefixed but neither `__mm_`- nor `__arr_`-prefixed, so
	// none of the arms above sees it. Its body only reads the descriptor and `callIndirect`s the destructor
	// (no direct `__mm_alloc`/`__mm_free`), so it declares no other bit — see `usesDropTypeParam`.
	if callee.equals(DropTypeParamName) 'droptypeparam'
		usage.usesDropTypeParam = true
	end 'droptypeparam'
	// The existential's drop (P1.7a-existentials slice 2) — the same shape as the line above and for the same
	// reasons: `__`-prefixed but neither `__mm_`- nor `__arr_`-prefixed, so no arm above sees it, and its body
	// only reads the witness table's `destroyFunc@8` and `callIndirect`s it, so it declares no other bit.
	// ⚠ It does NOT set `usesHeap`: a struct DESTRUCTOR's cascade reaches it from a Std body this scan cannot
	// see, and that destructor's own `__mm_free` already declares the heap (`noteDestructorUsage`).
	if callee.equals(DropExistentialName) 'dropexistential'
		usage.usesDropExistential = true
	end 'dropexistential'
	// The existential's CO-OWNERSHIP (P1.7a-existentials slice 2). Its body names NO callee — since slice 2b it
	// `callIndirect`s the witness's `retainFunc@16`, exactly as its drop twin `callIndirect`s `destroyFunc@8` —
	// so what it reaches is declared by the RELOCATIONS that fill those words (`noteRelocatedFunctionUsage`),
	// not here. It used to declare `usesIncref` for a hardcoded `__mm_incref` that no longer exists.
	// ⚠ **`usesHeap` STILL RIDES, AND IT IS THE ONE BIT THE RELOCATION SCAN CANNOT SUPPLY**: that scan runs
	// after `globalData.layOut`, so a program whose heap is first declared there PANICS
	// (`noteRelocatedFunctionUsage`'s `heapArrivedTooLate` gate) with a `.data` image short by the allocator's
	// globals. Every non-zero ownership word names a heap callee (`__str_clone`/`__str_decref`/`__mm_retain`/a
	// `__destruct_<T>`), so a program that emits this entry may need the allocator whether or not its own
	// source ever allocates — `widen("abc")` is exactly that program, and it is why the bit is taken here
	// rather than inferred later.
	if callee.equals(RetainExistentialName) 'retainexistential'
		usage.usesRetainExistential = true
		usage.usesHeap = true
	end 'retainexistential'
	// A managed-payload union's scope-exit drop (`__destruct_<U>`). It frees the box (`__mm_free` — heap)
	// and, for a String field, calls `__str_decref` — but those live in the SYNTHESIZED body this scan
	// cannot see, so the symbol is recorded and its transitive needs are declared by
	// `noteUnionDestructorUsage` (which has the signatures/interner to classify the fields).
	if bytesStartWith(callee, prefix: DestructorPrefix) 'uniondtor'
		usage.usesHeap = true
		usage.neededDestructors.insert(callee)
	end 'uniondtor'
	// A String DEEP-CLONE (`__str_clone`, P1.7 slice 3b-vi-b) — a managed array/struct copy cloning a String
	// element/field. It `__mm_alloc`s a fresh fused record and `__str_copy`s the bytes in, inside its SYNTHESIZED
	// body this scan cannot see, so those transitive bits are declared here (the `__str_append` shape).
	if callee.equals(StrCloneName) 'strclone'
		usage.usesStrClone = true
		usage.usesHeap = true
		usage.usesStrCopy = true
	end 'strclone'
	// The `General_Category` lookup (P1.8 Slice D). It declares NOTHING else — see `usesUcdCategory` —
	// which makes it the second family, beside `__clock_*`, whose body calls nothing this scan cannot see.
	if callee.equals(UcdCategoryName) 'ucdcategory'
		usage.usesUcdCategory = true
	end 'ucdcategory'
	// ⚠ **THE ORDER IS A RULE ABOUT FAMILIES, NOT ABOUT TODAY'S ARMS, WHICH IS WHY IT SURVIVES THE ARM THAT
	// FORCED IT.** The `CharacterSet` family closes into the two below it — `__cs_contains` decodes a
	// codepoint — so it must record FIRST: a bit turned on after its own family's closure has run installs an
	// entry point without what it calls. A `StringIndex` family recorded here too, ahead of these, for the
	// identical reason; W49 wave 4 retired `String.slice` and its last two entry points went with it.
	recordCharacterSetUsage(callee, usage: usage)
	recordStringMethodUsage(callee, usage: usage)
	recordGraphemeUsage(callee, usage: usage)
	// The three MANAGED-element array copies (`__arr_slice_managed`/`__arr_clone_managed`/`__arr_append_managed`,
	// P1.7 slice 3b-vi-b). `isArrayRuntimeCallee` above already set `usesArray`/`usesHeap` (they are `__arr_`-
	// prefixed); THIS bit gates their install so a trivial-array program does not carry them.
	if isManagedArrayCopyCallee(callee) 'managedcopy'
		usage.usesManagedArrayCopy = true
	end 'managedcopy'
	// The three OPAQUE-`T` array copies (`__arr_slice_opaque`/`__arr_clone_opaque`/`__arr_append_opaque`, P1.7
	// slice 3b-vi-b-β). `isArrayRuntimeCallee` above already set `usesArray`/`usesHeap` (they are `__arr_`-
	// prefixed); THIS turns on the opaque-copy install AND `usesManagedArrayCopy`, because each wrapper's managed
	// branch calls the α `__arr_*_managed` helpers whose own install is gated on that bit.
	if isOpaqueArrayCopyCallee(callee) 'opaquecopy'
		usage.usesOpaqueArrayCopy = true
		usage.usesManagedArrayCopy = true
	end 'opaquecopy'
	// A per-type CLONER (`__clone_<T>`, P1.7 slice 3b-vi-b) — the CLONE twin of the `__destruct_<T>` arm above,
	// referenced through a `funcAddr(__clone_<T>)` element-cloner stamp. It frees no memory but ALLOCATES a box
	// (`usesHeap`), and its transitive `__str_clone`/`__arr_clone`/nested-cloner needs close through
	// `noteClonerUsage` (which has the signatures/interner to classify the fields).
	if bytesStartWith(callee, prefix: ClonerPrefix) 'structcloner'
		usage.usesHeap = true
		usage.neededCloners.insert(callee)
	end 'structcloner'
end 'recordCallUsage'

// ⭐ The P1.8 Slice D `CharacterSet` family's arm of the callee → usage-bit map — the
// `recordGraphemeUsage` twin, split out for the same reason: `recordCallUsage` stays a readable list of
// families. Direct references only; what each referenced body in turn needs is closed by
// `closeCharacterSetNeeds`.
function recordCharacterSetUsage(callee ByteArray, usage RuntimeUsage)
	if callee.equals(CharSetMakeName) 'make'
		usage.usesCharSetMake = true
	end 'make'
	if callee.equals(CharSetDecrefName) 'decref'
		usage.usesCharSetDecref = true
	end 'decref'
	if callee.equals(CharSetContainsName) 'contains'
		usage.usesCharSetContains = true
	end 'contains'
	closeCharacterSetNeeds(usage)
end 'recordCharacterSetUsage'

// ⭐ **WHAT EACH `CharacterSet` BODY CALLS THAT THIS SCAN CANNOT SEE.** Declared here rather than
// discovered, exactly as the three sibling closures declare their families'. Run as a CLOSURE after every
// record so the answer cannot depend on the order in which the module happens to name its entry points.
// ⚠ **A `__str_trim` ARM STOOD HERE UNTIL W49 WAVE 4** — it declared the cluster walk, the `Character` mint,
// the per-cluster drop, the set probe and the slice producer that the SYNTHESIZED trim reached from inside a
// body this scan cannot read. The three trims are `stdlib/String.maxon`'s now, so every one of those is an
// ordinary Maxon call edge the reachability walk finds for itself, and a declared list of them could only go
// stale. Its `usesCharSetContains` feed is why the `probes` arm below must still run after it did.
function closeCharacterSetNeeds(usage RuntimeUsage)
	// `__cs_contains` probes the member set, decodes the character's first codepoint, and classifies it.
	if usage.usesCharSetContains 'probes'
		usage.usesSet = true
		usage.usesHeap = true
		usage.usesUcdCategory = true
	end 'probes'
	// The box is one `__mm_alloc`; its drop releases the member set and reclaims the box.
	if usage.usesCharSetMake 'allocatesABox'
		usage.usesHeap = true
	end 'allocatesABox'
	if usage.usesCharSetDecref 'dropsASet'
		usage.usesSet = true
		usage.usesHeap = true
	end 'dropsASet'
end 'closeCharacterSetNeeds'

// ⭐ The P1.8 Slice B grapheme family's arm of the callee → usage-bit map — the `recordStringMethodUsage`
// twin, split out for the same reason: `recordCallUsage` stays a readable list of families. Direct
// references only; what each referenced body in turn needs is closed by `closeGraphemeNeeds`.
function recordGraphemeUsage(callee ByteArray, usage RuntimeUsage)
	if callee.equals(CharAtName) 'charat'
		usage.usesCharAt = true
	end 'charat'
	if callee.equals(CharFromCodepointName) 'charfromcp'
		usage.usesCharFromCodepoint = true
	end 'charfromcp'
	if callee.equals(CharCmpName) 'charcmp'
		usage.usesCharCmp = true
	end 'charcmp'
	if callee.equals(CharAsciiValueName) 'charascii'
		usage.usesCharAsciiValue = true
	end 'charascii'
	if callee.equals(StrToBytesName) 'tobytes'
		usage.usesStrToBytes = true
	end 'tobytes'
	closeGraphemeNeeds(usage)
end 'recordGraphemeUsage'

// ⭐ **WHAT EACH GRAPHEME BODY CALLS THAT THIS SCAN CANNOT SEE.** The family's members call each other from
// inside their SYNTHESIZED Std bodies, which walk no Maxon module — so the dependency is DECLARED here
// rather than discovered, exactly as `closeStringMethodNeeds` declares the String family's. Run as a
// CLOSURE after every record (rather than each arm listing its own transitive set) so the answer cannot
// depend on the order in which the module happens to name its entry points.
// ⚠ **THE SEGMENTER'S OWN NEEDS ARE NO LONGER CLOSED HERE, BECAUSE IT IS NO LONGER SYNTHESIZED.** This
// closure used to walk `__gr_count` → `__gr_end` → `__utf8_cp_at` / `__gr_break` → `__ext_pict` / `__gbp`,
// which is exactly the chain now living in `stdlib/helpers/string/grapheme.maxon`. Those are ORDINARY Maxon
// call edges, so the query spine follows them without being told: what a corpus function needs is found, not
// declared. What is left here is the residue with no corpus counterpart — the `Character` mint and the three
// array-filling views — plus the ONE thing a scan of the Maxon module still cannot see, which has moved to
// `StdlibSource.markCorpusCalleesOfSynthesizedRuntimes`: the edge FROM these Std bodies INTO the corpus.
function closeGraphemeNeeds(usage RuntimeUsage)
	// `__char_at` builds a fresh owned inline record: one `__mm_alloc` plus a `__str_copy` blit.
	if usage.usesCharAt 'mintsCharacters'
		usage.usesHeap = true
		usage.usesStrCopy = true
	end 'mintsCharacters'
	// `__char_from_cp` builds the same record with one `__mm_alloc` and NO blit — it stores the bytes it
	// encoded, so it needs the allocator and not the copier.
	if usage.usesCharFromCodepoint 'encodesCharacters'
		usage.usesHeap = true
	end 'encodesCharacters'
	// `__str_to_bytes` pushes into the caller's array.
	//
	// ⚠ **A `pushesDecodedUnits` CLAUSE STOOD BESIDE IT FOR `__str_to_codepoints`/`__str_to_utf16` AND WENT
	// WITH THEM (W49 wave 6).** It declared the same two bits and, in prose, the edge INTO the corpus
	// decoders that a scan of this module cannot see — an edge `StdlibSource` owns because what it turns on is
	// a stdlib function's REACHABILITY rather than a runtime-usage bit. The corpus's own
	// `CodepointView`/`UTF16View` reach `utf8DecodeAt`/`utf8ByteLengthAt` through ordinary Maxon call edges,
	// which the query spine follows without being told.
	if usage.usesStrToBytes 'pushesBytes'
		usage.usesArray = true
		usage.usesHeap = true
	end 'pushesBytes'
end 'closeGraphemeNeeds'

// The String-building and byte-reading entry points' own arm of the callee → usage-bit map, split out so
// `recordCallUsage` stays a readable list of families rather than growing six more inline arms. Direct
// references only; what each referenced body in turn needs is closed by `closeStringMethodNeeds`. (It was
// NINE arms until the P1.8 Slice C family retired onto the corpus — see the grave at the head of this file.)
function recordStringMethodUsage(callee ByteArray, usage RuntimeUsage)
	if callee.equals(StrFromBytesName) 'frombytes'
		usage.usesStrFromBytes = true
	end 'frombytes'
	if callee.equals(StrOfBufferName) 'ofbuffer'
		usage.usesStrOfBuffer = true
	end 'ofbuffer'
	if callee.equals(MmToCStringName) 'tocstring'
		usage.usesMmToCString = true
	end 'tocstring'
	if callee.equals(StrBytesViewName) 'bytesview'
		usage.usesStrBytesView = true
	end 'bytesview'
	if callee.equals(StrByteAtName) 'byteat'
		usage.usesStrByteAt = true
	end 'byteat'
	if callee.equals(StrByteAtOrPanicName) 'byteatorpanic'
		usage.usesStrByteAtOrPanic = true
	end 'byteatorpanic'
	closeStringMethodNeeds(usage)
end 'recordStringMethodUsage'

// ⭐ **WHAT EACH REFERENCED BODY CALLS THAT THIS SCAN CANNOT SEE.** These entry points call the heap
// helpers from inside their SYNTHESIZED Std bodies, which walk no Maxon module — so the dependency is
// DECLARED here rather than discovered, exactly as `__str_append` declares its `__mm_alloc`/`__str_copy`.
// Run as a CLOSURE after every record (rather than each arm listing its own transitive set) so the answer
// cannot depend on the order in which the module happens to name its entry points.
function closeStringMethodNeeds(usage RuntimeUsage)
	// Every string-BUILDING entry point allocates a fused record and blits bytes into it
	// (`emitBuildOwnedInlineString` ⇒ `__mm_alloc` + `__str_copy`).
	//
	// ⚠ **A RETIREMENT SHEDS A TERM; ONLY THE LAST TERM SHEDS THE CLAUSE — AND THIS FILE HAS NOW DONE BOTH.**
	// `usesStrMapCase`/`usesStrReplace`/`usesStrReplaceFirst` left this clause as TERMS at W49 wave 2 and
	// `usesStrSplit` at wave 5, each time leaving the surviving terms to keep it alive. Two SIBLING clauses
	// did not survive wave 5, because `split` was their only term: `clonesReceiver` (`split` answered a
	// degenerate empty delimiter with `__str_clone` of the receiver) and `pushesSegments` (it pushed into the
	// array the parser created for it), plus the `needsFind`/`needsRangeEq` pair that installed the search
	// underneath. Deleting a clause while any term could still be true is what would leave a callee
	// uninstalled and a call landing on nothing; deleting it only when nothing can set its last term is what
	// keeps this function from listing conditions no program can meet. What the retired members need instead
	// is declared where a corpus body's needs always are — by the ordinary reachability of what it calls.
	if usage.usesStrFromBytes or usage.usesStrOfBuffer or usage.usesMmToCString 'buildsStrings'
		usage.usesHeap = true
		usage.usesStrCopy = true
	end 'buildsStrings'
	// `__str_bytes_view` publishes an `Array` record through `__arr_create` and increfs the allocation the
	// bytes live in through `__mm_incref` — both inside its synthesized body, which this scan cannot see.
	// `usesArray` is what installs the array runtime AND (through `installMmRuntime`'s `usesIncref or
	// usesArray`) the incref helper, so the two bits below are the whole of its transitive floor.
	if usage.usesStrBytesView 'publishesAView'
		usage.usesArray = true
		usage.usesHeap = true
	end 'publishesAView'
end 'closeStringMethodNeeds'

// Install the referenced String runtime functions into the lowered Std module. Called AFTER the
// pipeline (like `installMmRuntime`), so these are appended already-lowered and never re-optimized.
// Each is installed ONLY when referenced — vocabulary does not ship ahead of its consumer.
export function installStringRuntime(module StdModule, usage RuntimeUsage)
	if usage.usesWriteStdout 'writestdout'
		buildStreamWrite(module, name: StreamWriteStdoutName, stream: OsOutputStream.standardOutput)
	end 'writestdout'
	if usage.usesWriteStderr 'writestderr'
		buildStreamWrite(module, name: StreamWriteStderrName, stream: OsOutputStream.standardError)
	end 'writestderr'
	if usage.usesStrEq 'streq'
		buildStrEq(module, name: StrEqName)
	end 'streq'
	if usage.usesStrCopy 'strcopy'
		buildStrCopy(module)
	end 'strcopy'
	if usage.usesIntToString 'inttostr'
		buildIntegerToString(module, signedness: DivideSignedness.signed)
	end 'inttostr'
	if usage.usesUIntToString 'uinttostr'
		buildIntegerToString(module, signedness: DivideSignedness.unsigned)
	end 'uinttostr'
	if usage.usesBoolToString 'booltostr'
		buildBoolToString(module)
	end 'booltostr'
	if usage.usesStrAppend 'strappend'
		buildStrAppend(module)
	end 'strappend'
	if usage.usesStrDecref 'strdecref'
		buildStrDecref(module)
	end 'strdecref'
	if usage.usesStrClone 'strclone'
		buildStrClone(module)
	end 'strclone'
	if usage.usesStrFromBytes 'strfrombytes'
		buildStrFromBytes(module)
	end 'strfrombytes'
	if usage.usesStrOfBuffer 'strofbuffer'
		buildStrOfBuffer(module)
	end 'strofbuffer'
	if usage.usesMmToCString 'mmtocstring'
		buildMmToCString(module)
	end 'mmtocstring'
	if usage.usesStrBytesView 'strbytesview'
		buildStrBytesView(module)
	end 'strbytesview'
	if usage.usesStrByteAt 'strbyteat'
		buildStrByteRead(module, name: StrByteAtName)
	end 'strbyteat'
	if usage.usesStrByteAtOrPanic 'strbyteatorpanic'
		buildStrByteRead(module, name: StrByteAtOrPanicName)
	end 'strbyteatorpanic'
end 'installStringRuntime'

// `__write_stdout(mm)` / `__write_stderr(mm)` — write a `__ManagedMemory`'s bytes to a standard stream, no
// trailing newline, answering the byte count the OS reports.
//
// It loads `buffer@0` and `length@8` from the record and hands them to the stream's system op, which lowers
// per target — x64-windows to `GetStdHandle` + `WriteFile` through the IAT, arm64-macOS to a POSIX `write`
// through the GOT, wasm to a `wasi:cli` accessor plus `blocking-write-and-flush`. The op is target-neutral,
// so this function names no OS symbol AND sets no frame size: `outgoingArgSize` (WriteFile's stack-arg space
// on x64, ZERO on arm64's all-register `write`) is a TARGET ABI fact, so each backend's isel sets it from the
// op it actually lowers. Setting it here would bake an x64 frame size into a target-neutral function — the
// leak that made the arm64 prologue panic.
//
// ⭐ **PARAMETERIZED so ONE graph serves TWO symbols**, exactly as `buildStrEq` serves `__str_eq` and the
// `Equatable` witness: the stream is the only difference, and the record read is not a fact worth writing
// twice.
//
// ⚠ **THE ARGUMENT IS A `__ManagedMemory`, NOT A String — and the offsets are the same ones because the two
// RECORDS agree there.** `stdlib/Print.maxon` hands over `value.addressableBytes()`, an `Array with Byte`
// view; a String record and an Array record share `buffer@0`/`length@8` (they part company at `@40`, which
// nothing here reads — see `buildStrBytesView` for why that one slot matters elsewhere). The bytes are
// BORROWED: this reads through them and never frees, so a literal argument needs no decref.
function buildStreamWrite(module StdModule, name ByteArray, stream OsOutputStream)
	var func = IrFunction.createFromStd(name, returnType: StdReturnType.value(StdType.i64), paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry")
	emitParams(module, block: entry, count: 1)
	let record = 0 as ValueId

	let buffer = ids.mint()
	module.appendOp(entry, op: StdOp.loadIndirect(buffer, addrId: record, offset: StringBufferOffset, valueType: StdType.i64))
	let length = ids.mint()
	module.appendOp(entry, op: StdOp.loadIndirect(length, addrId: record, offset: StringLengthOffset, valueType: StdType.i64))

	let written = ids.mint()
	match stream 's'
		standardOutput then module.appendOp(entry, op: StdOp.osWriteStdout(written, bufId: buffer, lenId: length))
		standardError then module.appendOp(entry, op: StdOp.osWriteStderr(written, bufId: buffer, lenId: length))
	end 's'

	module.setTerminator(entry, op: StdOp.ret(written))

	module.functions.push(func)
end 'buildStreamWrite'

// `<name>(a, b) -> i64(bool)` — content equality: equal LENGTHS and equal BYTES. BOTH String operands are
// BORROWED (read through, never freed), so this allocation-free body is the equality both the `==` operator
// and the `Equatable` witness need.
//
// ⭐ **PARAMETERIZED BY NAME so ONE graph serves TWO symbols.** It is emitted under `__str_eq` for the `==`
// operator path (`installStringRuntime`) AND under `String.equals` for the `Equatable` witness path
// (`installBuiltinConformanceRuntime`), because the witness reloc names the impl `String.equals`
// (`qualifiedMethodName("String", "equals")`), NOT `__str_eq`. Same byte-compare, two `.text` symbols — the
// `buildIntEquals` pattern (which builds `int.equals` fresh), so the two paths cannot drift a byte apart.
//
// This is the bootstrap's `bytesEqual` (a length check, then a byte loop), NOT the enum `memcmp`
// helper. It allocates nothing. Empty strings: length 0 == length 0 → the loop runs zero times →
// return 1. The byte loop itself is `emitByteRangeCompareLoop` — shared with `__arr_eq`; see that emitter
// for why it is a shared EMITTER and not a shared CALL.
// ⭐ **IT RETURNS `bool`, NOT A MACHINE WORD, AND THE WITNESS SLOT IS WHY** (P1.7a slice 2b-iv-B). Under the
// `String.equals` name this graph lands in an `Equatable` witness table, whose slot every dispatch site types
// from `Equatable.equals(other Self) returns bool` — so its declared result must be the one
// `builtinProtocolResultStdType` gives that declaration, an `i1`. Declared `i64` it agreed on the register
// targets (a `bool` rides a 64-bit register) and trapped `indirect call type mismatch` on wasm. The `__str_eq`
// name shares the declaration for the reason it shares the body: ONE graph cannot have two signatures, and
// the operator path already types its result `boolean` at the call site (`Parser.emitStringEquality`), so
// this is the type it was always claiming to return.
export function buildStrEq(module StdModule, name ByteArray)
	var func = IrFunction.createFromStd(name, returnType: StdReturnType.value(builtinProtocolResultStdType(BoolConformerName)), paramCount: 2, paramTypes: twoI64Params(), returnLine: 0)
	var ids = ValueMinter.create(2)

	var entry = module.addBlock(func, label: b"entry")
	var notEqual = module.addBlock(func, label: b"notEqual")
	var lenMatch = module.addBlock(func, label: b"lenMatch")
	var allMatch = module.addBlock(func, label: b"allMatch")

	emitParams(module, block: entry, count: 2)
	let a = 0 as ValueId
	let b = 1 as ValueId

	// entry: lengths differ ⇒ not equal; else fall into the byte loop.
	let aLen = emitLoadField(module, block: entry, record: a, offset: StringLengthOffset, ids: ids)
	let bLen = emitLoadField(module, block: entry, record: b, offset: StringLengthOffset, ids: ids)
	let lenEq = emitCmp(module, block: entry, a: aLen, b: bLen, pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(entry, op: StdOp.condBranch(lenEq, thenBlockId: lenMatch.id, elseBlockId: notEqual.id))

	// lenMatch: the buffers, then the shared byte loop over `aLen` bytes of each.
	let aBuf = emitLoadField(module, block: lenMatch, record: a, offset: StringBufferOffset, ids: ids)
	let bBuf = emitLoadField(module, block: lenMatch, record: b, offset: StringBufferOffset, ids: ids)
	emitByteRangeCompareLoop(module, func: func, cur: lenMatch, aBuf: aBuf, bBuf: bBuf, len: aLen, allMatch: allMatch, notEqual: notEqual, ids: ids)

	emitConstReturn(module, block: allMatch, value: PredicateTrue, ids: ids)
	emitConstReturn(module, block: notEqual, value: PredicateFalse, ids: ids)

	module.functions.push(func)
end 'buildStrEq'

// ⭐ **THE ONE BYTE-RANGE COMPARE LOOP.** Emit "every byte of `aBuf[0..len)` equals `bBuf[0..len)`" as a loop
// off `cur`: `cur` is terminated into a fresh header, a full match falls out to `allMatch`, and the first
// mismatching byte to `notEqual`. `len == 0` matches vacuously (the header guard is `i >= len`, true at once).
//
// ⚠ **SHARED BECAUSE TWO RUNTIME FUNCTIONS COMPARE BYTE RANGES**: `__str_eq` compares two whole records
// after a length check, and `Array.equals` compares two element buffers after the same length check
// (array-hashable — an array's equality IS a byte compare, `stdlib/Array.maxon:648-663`). They were one loop
// written twice, with nothing making them agree — a widened load or a changed bound in one would silently
// leave the other reading a byte at a time on exactly one of the paths. (A THIRD consumer,
// `__str_range_eq`, retired with the P1.8 Slice C searches at W49 wave 5; the sharing outlives it because
// the two that remain are still two.)
//
// ⚠ It stays a shared EMITTER and does NOT become a shared CALL: `==` on Strings is what the operator
// lowers to, and routing it through a call would buy this dedup at the price of a call per comparison. The
// duplication being removed is in the COMPILER's source, which is where it was.
//
// The loop index `i` is the header's phi — 0 from `cur`, `i+1` from the back edge — the on-the-fly SSA shape
// every runtime loop here builds directly, a runtime function having no parser. The phi's `argType` is set
// explicitly because `retypeBlockArgs` runs in `lowerMaxonToStd`, which these post-pipeline functions never
// pass through.
export function emitByteRangeCompareLoop(module StdModule, func IrFunction, cur IrBlock, aBuf ValueId, bBuf ValueId, len ValueId, allMatch IrBlock, notEqual IrBlock, ids ValueMinter)
	var header = module.addBlock(func, label: b"cmphdr")
	var body = module.addBlock(func, label: b"cmpbody")

	let zero = emitConst(module, block: cur, value: 0, ids: ids)
	module.setTerminator(cur, op: StdOp.branch(header.id))

	let i = ids.mint()
	header.blockArgs.push(IrBlockArg.create(i, argType: StdType.i64))
	cur.branchEdges.push(BranchEdge.create(header.id, argIds: argsOf(zero)))

	let atEnd = emitCmp(module, block: header, a: i, b: len, pred: StdCmpPred.ge, ids: ids)
	module.setTerminator(header, op: StdOp.condBranch(atEnd, thenBlockId: allMatch.id, elseBlockId: body.id))

	// The compare is the LAST flag writer before the branch, so it fuses to a `jcc`.
	let aByte = emitLoadByteIndexed(module, block: body, base: aBuf, index: i, ids: ids)
	let bByte = emitLoadByteIndexed(module, block: body, base: bBuf, index: i, ids: ids)
	let one = emitConst(module, block: body, value: 1, ids: ids)
	let iNext = emitBin(module, block: body, a: i, b: one, opcode: StdBinOpcode.add, ids: ids)
	let byteEq = emitCmp(module, block: body, a: aByte, b: bByte, pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(body, op: StdOp.condBranch(byteEq, thenBlockId: header.id, elseBlockId: notEqual.id))
	body.branchEdges.push(BranchEdge.create(header.id, argIds: argsOf(iNext)))
end 'emitByteRangeCompareLoop'

// ⭐ **ONE BYTE AT `addr` — THE `u8` LOAD SPELLING FOR EVERY RUNTIME BUILDER**, so a widened read is a
// one-line change rather than a sweep of every byte-walking loop. Exported because `GraphemeRuntime`'s
// decoders and its segmenter walk bytes too: they had their own copy of these two, which is the shape
// this comment claimed to prevent — two files each owning "the ONE spelling".
export function emitLoadByteAt(module StdModule, block IrBlock, addr ValueId, ids ValueMinter) returns ValueId
	let v = ids.mint()
	module.appendOp(block, op: StdOp.loadIndirect(v, addrId: addr, offset: 0, valueType: StdType.u8))
	return v
end 'emitLoadByteAt'

// One byte at `base[index]` — the address add plus the `u8` load, the shape every byte-walking loop that
// does NOT also need the address repeats (the compare loop's two operands, the search's first-byte probe,
// the grapheme runtime's byte-view fill). Exported for `emitLoadByteAt`'s reason.
export function emitLoadByteIndexed(module StdModule, block IrBlock, base ValueId, index ValueId, ids ValueMinter) returns ValueId
	return emitLoadByteAt(module, block: block, addr: emitBin(module, block: block, a: base, b: index, opcode: StdBinOpcode.add, ids: ids), ids: ids)
end 'emitLoadByteIndexed'

// `__str_copy(dest, src, len)` — blit `len` bytes from `src` into `dest`. The one thing an interpolation
// does with every part: each part is materialized to a `(buffer, length)` pair and copied into the fused
// result buffer at a running cursor. A byte loop rather than a `rep movsb`/memcpy op because there is no
// memory-move op in the Std tier (`system` holds only `osAllocPages`/`osWriteStdout`), and a byte loop
// needs nothing the tier lacks. `len == 0` copies nothing (the header guard is `i >= len`, true at once).
//
// The loop index `i` is the header's phi — 0 from entry, `i+1` from the back edge — the same on-the-fly
// SSA shape `buildStrEq` builds directly because a runtime function has no parser.
function buildStrCopy(module StdModule)
	var func = IrFunction.createFromStd(StrCopyName, returnType: StdReturnType.void, paramCount: 3, paramTypes: threeI64Params(), returnLine: 0)
	var ids = ValueMinter.create(3)

	var entry = module.addBlock(func, label: b"entry")
	var header = module.addBlock(func, label: b"header")
	var body = module.addBlock(func, label: b"body")
	var done = module.addBlock(func, label: b"done")

	emitParams(module, block: entry, count: 3)
	let dest = 0 as ValueId
	let src = 1 as ValueId
	let len = 2 as ValueId

	let zero = ids.mint()
	module.appendOp(entry, op: StdOp.const(zero, value: 0, valueType: StdType.i64))
	module.setTerminator(entry, op: StdOp.branch(header.id))

	let i = ids.mint()
	header.blockArgs.push(IrBlockArg.create(i, argType: StdType.i64))
	entry.branchEdges.push(BranchEdge.create(header.id, argIds: argsOf(zero)))

	let atEnd = ids.mint()
	module.appendOp(header, op: StdOp.cmp(atEnd, lhs: i, rhs: len, pred: StdCmpPred.ge, operandType: StdType.i64))
	module.setTerminator(header, op: StdOp.condBranch(atEnd, thenBlockId: done.id, elseBlockId: body.id))

	let srcAddr = ids.mint()
	module.appendOp(body, op: StdOp.binOp(srcAddr, lhs: src, rhs: i, opcode: StdBinOpcode.add, operandType: StdType.i64))
	let srcByte = ids.mint()
	module.appendOp(body, op: StdOp.loadIndirect(srcByte, addrId: srcAddr, offset: 0, valueType: StdType.u8))
	let dstAddr = ids.mint()
	module.appendOp(body, op: StdOp.binOp(dstAddr, lhs: dest, rhs: i, opcode: StdBinOpcode.add, operandType: StdType.i64))
	module.appendOp(body, op: StdOp.storeIndirect(dstAddr, offset: 0, valueId: srcByte, valueType: StdType.u8))
	let one = ids.mint()
	module.appendOp(body, op: StdOp.const(one, value: 1, valueType: StdType.i64))
	let iNext = ids.mint()
	module.appendOp(body, op: StdOp.binOp(iNext, lhs: i, rhs: one, opcode: StdBinOpcode.add, operandType: StdType.i64))
	module.setTerminator(body, op: StdOp.branch(header.id))
	body.branchEdges.push(BranchEdge.create(header.id, argIds: argsOf(iNext)))

	module.setTerminator(done, op: StdOp.retVoid)

	module.functions.push(func)
end 'buildStrCopy'

// ⭐ **WHAT THE SIGNED RENDERING DERIVES IN `setup` AND THE SHARED GRAPH THEN READS — and what the
// UNSIGNED one has instead, which is nothing at all (X11).** These two values are the ENTIRETY of the
// difference between the two renderings beyond the divides' own signedness, which is why one builder
// emits both: an unsigned rendering writes no `-`, its digit COUNT is already its length, and each
// `value % 10` is already the digit.
//
// It is a union rather than two `ValueId`s plus a flag because `unsigned` has no ids to carry, and a
// pair of ids that are meaningless in one arm is a sentinel wearing a struct's clothes.
union RenderedSign
	// `neg` — the sign bit as 0/1, which is also the digits' START OFFSET — and `sign`, `+1`/`-1`.
	signed(neg ValueId, sign ValueId)
	unsigned
end 'RenderedSign'

// `__int_to_string(value, dest) -> len` / `__uint_to_string(value, dest) -> len` — render `value`'s
// decimal text into `dest` at the signedness `signedness` names, returning the byte count written (never
// a NUL — the caller's buffer is zeroed and it copies exactly `len` bytes).
//
// ⭐⭐ **ONE BUILDER, TWO ENTRY POINTS, AND THAT IS THE POINT (X11).** The two graphs share their entry
// zero case, their digit-COUNT loop and their digit-WRITE loop — the whole of the algorithm — and differ
// in exactly three places, all of them the sign: what `setup` derives (`RenderedSign`), whether the digit
// count is widened to a length, and whether each digit is multiplied back into its magnitude. Copying the
// 90 lines below to write the unsigned twin would put the shared 90 in two places where a fix to the
// count loop could reach one of them.
//
// ⭐ IT NEVER NEGATES, so `i64.min` needs no special case. `neg = value >>logical 63` is the sign bit as a
// 0/1. A leading `-` is written UNCONDITIONALLY at `dest[0]` and then OVERWRITTEN by the most-significant
// digit when the value is non-negative (that digit lands at `dest[start]` with `start = neg = 0`), so the
// sign costs no branch. Each digit is `value % 10` — which carries the value's sign — turned positive by
// MULTIPLYING by `sign = 1 - 2*neg` (`+1`/`-1`), again avoiding the `abs` that `i64.min` would overflow.
//
// ⚠ **THE SIGNED READING IS THIS GRAPH'S CONTRACT AND THE UNSIGNED ONE IS NOT A RELAXATION OF IT.** The
// divides below take their signedness from the parameter, and it must be the SAME reading the sign
// handling above takes: an unsigned `/10` under a `-` already written at `dest[0]` would emit the
// magnitude's digits while the sign still claimed a negative, and a signed `/10` on a value with bit 63
// set is X11's defect itself.
//
// Values dominating from `entry`/`setup` (`value`, `dest`, `neg`, `sign`) are read directly in the loop
// blocks those dominate; only the loop-variant `digits`/`v`/`pos` ride block-args. `len` is computed once
// in `writeSetup`, which dominates `done`.
function buildIntegerToString(module StdModule, signedness DivideSignedness)
	var func = IrFunction.createFromStd(integerToStringName(signedness), returnType: StdReturnType.value(StdType.i64), paramCount: 2, paramTypes: twoI64Params(), returnLine: 0)
	var ids = ValueMinter.create(2)

	var entry = module.addBlock(func, label: b"entry")
	var zeroCase = module.addBlock(func, label: b"zeroCase")
	var setup = module.addBlock(func, label: b"setup")
	var countLoop = module.addBlock(func, label: b"countLoop")
	var writeSetup = module.addBlock(func, label: b"writeSetup")
	// The write loop is HEADER-GUARDED (test at the top), following `buildStrEq`/`buildStrCopy`'s shape so
	// the three string builders read the same way. It is a STYLE choice, not a correctness one. A fused
	// loop-test `cmp` whose boolean is a function's highest-numbered value once tripped the value-class
	// column — `setValueClass` sized it off the target OPERANDS, and a flags-only compare is not among them
	// — and this shape happened to dodge it by keeping the loop body's values minted last. That column now
	// GROWS to cover every DEFINED id (see `setValueClass` in StdToX64Conversion), so the dodge is
	// unnecessary and a bottom-tested loop would compile too; the shared shape stays for consistency.
	var writeHeader = module.addBlock(func, label: b"writeHeader")
	var writeBody = module.addBlock(func, label: b"writeBody")
	var done = module.addBlock(func, label: b"done")

	emitParams(module, block: entry, count: 2)
	let value = 0 as ValueId
	let dest = 1 as ValueId

	// entry: `value == 0` prints a lone '0' (the count/write loops assume at least one non-zero step).
	let zeroConst = ids.mint()
	module.appendOp(entry, op: StdOp.const(zeroConst, value: 0, valueType: StdType.i64))
	let isZero = ids.mint()
	module.appendOp(entry, op: StdOp.cmp(isZero, lhs: value, rhs: zeroConst, pred: StdCmpPred.eq, operandType: StdType.i64))
	module.setTerminator(entry, op: StdOp.condBranch(isZero, thenBlockId: zeroCase.id, elseBlockId: setup.id))

	let zeroDigitConst = ids.mint()
	module.appendOp(zeroCase, op: StdOp.const(zeroDigitConst, value: AsciiZeroDigit, valueType: StdType.i64))
	module.appendOp(zeroCase, op: StdOp.storeIndirect(dest, offset: 0, valueId: zeroDigitConst, valueType: StdType.u8))
	let oneLen = ids.mint()
	module.appendOp(zeroCase, op: StdOp.const(oneLen, value: 1, valueType: StdType.i64))
	module.setTerminator(zeroCase, op: StdOp.ret(oneLen))

	// setup: derive `neg` (0/1) and `sign` (+1/-1), and write the provisional '-' at dest[0] — or, for the
	// unsigned rendering, none of that.
	let renderedSign = emitRenderedSign(module, block: setup, ids: ids, value: value, dest: dest, signedness: signedness)
	let digitsZero = ids.mint()
	module.appendOp(setup, op: StdOp.const(digitsZero, value: 0, valueType: StdType.i64))
	module.setTerminator(setup, op: StdOp.branch(countLoop.id))

	// countLoop(digits, v): count decimal digits — do { v = v/10; digits += 1 } while v != 0.
	let digits = ids.mint()
	let v = ids.mint()
	countLoop.blockArgs.push(IrBlockArg.create(digits, argType: StdType.i64))
	countLoop.blockArgs.push(IrBlockArg.create(v, argType: StdType.i64))
	setup.branchEdges.push(BranchEdge.create(countLoop.id, argIds: twoArgs(digitsZero, second: value)))

	let radixCount = ids.mint()
	module.appendOp(countLoop, op: StdOp.const(radixCount, value: DecimalRadix, valueType: StdType.i64))
	let vNext = ids.mint()
	// ⭐ **IT TAKES THE READING THE SIGN HANDLING ABOVE TOOK** (X10 made every `StdOp.div` state its reading
	// rather than inherit one; X11 made the reading a parameter). For the SIGNED rendering the sign is
	// handled by `neg`/`sign` and each digit step is multiplied back, so the walk is signed by
	// construction; for the UNSIGNED one there is no sign to handle and bit 63 is a magnitude bit. The two
	// halves cannot be mixed — see this builder's header.
	module.appendOp(countLoop, op: StdOp.div(vNext, lhs: v, rhs: radixCount, signedness: signedness))
	let oneCount = ids.mint()
	module.appendOp(countLoop, op: StdOp.const(oneCount, value: 1, valueType: StdType.i64))
	let digitsNext = ids.mint()
	module.appendOp(countLoop, op: StdOp.binOp(digitsNext, lhs: digits, rhs: oneCount, opcode: StdBinOpcode.add, operandType: StdType.i64))
	let countZero = ids.mint()
	module.appendOp(countLoop, op: StdOp.const(countZero, value: 0, valueType: StdType.i64))
	let countDone = ids.mint()
	module.appendOp(countLoop, op: StdOp.cmp(countDone, lhs: vNext, rhs: countZero, pred: StdCmpPred.eq, operandType: StdType.i64))
	module.setTerminator(countLoop, op: StdOp.condBranch(countDone, thenBlockId: writeSetup.id, elseBlockId: countLoop.id))
	countLoop.branchEdges.push(BranchEdge.create(countLoop.id, argIds: twoArgs(digitsNext, second: vNext)))

	// writeSetup: len = digits + neg; the last write position is len - 1. `digitsNext` is read straight —
	// `countLoop` defines it and dominates `writeSetup`, so the last iteration's count reaches here with no
	// exit phi (only the loop-carried `digits`/`v` recurrence needs a header phi). Then fall into the write
	// loop with the cursor at `lastPos` and the value to render.
	let len = emitSignWidenedLength(module, block: writeSetup, ids: ids, digits: digitsNext, sign: renderedSign)
	let oneWrite = ids.mint()
	module.appendOp(writeSetup, op: StdOp.const(oneWrite, value: 1, valueType: StdType.i64))
	let lastPos = ids.mint()
	module.appendOp(writeSetup, op: StdOp.binOp(lastPos, lhs: len, rhs: oneWrite, opcode: StdBinOpcode.sub, operandType: StdType.i64))
	module.setTerminator(writeSetup, op: StdOp.branch(writeHeader.id))

	// writeHeader(pos, wv): stop when `wv == 0` — every digit has been consumed. The top-tested guard is
	// what keeps `writeBody`'s materialized values (not this `cmp`) the last minted; see the block header.
	let pos = ids.mint()
	let wv = ids.mint()
	writeHeader.blockArgs.push(IrBlockArg.create(pos, argType: StdType.i64))
	writeHeader.blockArgs.push(IrBlockArg.create(wv, argType: StdType.i64))
	writeSetup.branchEdges.push(BranchEdge.create(writeHeader.id, argIds: twoArgs(lastPos, second: value)))

	let writeZero = ids.mint()
	module.appendOp(writeHeader, op: StdOp.const(writeZero, value: 0, valueType: StdType.i64))
	let writeDone = ids.mint()
	module.appendOp(writeHeader, op: StdOp.cmp(writeDone, lhs: wv, rhs: writeZero, pred: StdCmpPred.eq, operandType: StdType.i64))
	module.setTerminator(writeHeader, op: StdOp.condBranch(writeDone, thenBlockId: done.id, elseBlockId: writeBody.id))

	// writeBody: dest[pos] = '0' + (wv % 10)*sign, then wv /= 10, pos -= 1, and back to the header. `pos`
	// and `wv` are read straight from `writeHeader`, which dominates this block.
	let radixWrite = ids.mint()
	module.appendOp(writeBody, op: StdOp.const(radixWrite, value: DecimalRadix, valueType: StdType.i64))
	let digit = ids.mint()
	module.appendOp(writeBody, op: StdOp.mod(digit, lhs: wv, rhs: radixWrite, signedness: signedness))
	let digitAbs = emitDigitMagnitude(module, block: writeBody, ids: ids, digit: digit, sign: renderedSign)
	let asciiZero = ids.mint()
	module.appendOp(writeBody, op: StdOp.const(asciiZero, value: AsciiZeroDigit, valueType: StdType.i64))
	let digitChar = ids.mint()
	module.appendOp(writeBody, op: StdOp.binOp(digitChar, lhs: digitAbs, rhs: asciiZero, opcode: StdBinOpcode.add, operandType: StdType.i64))
	let writeAddr = ids.mint()
	module.appendOp(writeBody, op: StdOp.binOp(writeAddr, lhs: dest, rhs: pos, opcode: StdBinOpcode.add, operandType: StdType.i64))
	module.appendOp(writeBody, op: StdOp.storeIndirect(writeAddr, offset: 0, valueId: digitChar, valueType: StdType.u8))
	let wvRadix = ids.mint()
	module.appendOp(writeBody, op: StdOp.const(wvRadix, value: DecimalRadix, valueType: StdType.i64))
	let wvNext = ids.mint()
	module.appendOp(writeBody, op: StdOp.div(wvNext, lhs: wv, rhs: wvRadix, signedness: signedness))
	let oneWriteStep = ids.mint()
	module.appendOp(writeBody, op: StdOp.const(oneWriteStep, value: 1, valueType: StdType.i64))
	let posNext = ids.mint()
	module.appendOp(writeBody, op: StdOp.binOp(posNext, lhs: pos, rhs: oneWriteStep, opcode: StdBinOpcode.sub, operandType: StdType.i64))
	module.setTerminator(writeBody, op: StdOp.branch(writeHeader.id))
	writeBody.branchEdges.push(BranchEdge.create(writeHeader.id, argIds: twoArgs(posNext, second: wvNext)))

	module.setTerminator(done, op: StdOp.ret(len))

	module.functions.push(func)
end 'buildIntegerToString'

// The SIGNED rendering's `setup`: derive `neg` (0/1) and `sign` (+1/-1) and write the provisional `-` at
// `dest[0]`. The unsigned rendering emits NO OP AT ALL — not a `const 0` and a `const 1` for the shared
// graph to multiply by, which would cost a needless multiply per digit and an add per call for two values
// that are identities. See `RenderedSign`.
function emitRenderedSign(module StdModule, block IrBlock, ids ValueMinter, value ValueId, dest ValueId, signedness DivideSignedness) returns RenderedSign
	// A `match` rather than an equality test, so a third reading added to `DivideSignedness` fails to
	// compile here instead of silently taking the signed path and writing a `-` nothing asked for.
	match signedness 'reading'
		unsigned then return RenderedSign.unsigned
		signed then break 'reading'
	end 'reading'

	let signBitConst = ids.mint()
	module.appendOp(block, op: StdOp.const(signBitConst, value: SignBitPosition, valueType: StdType.i64))
	let neg = ids.mint()
	module.appendOp(block, op: StdOp.binOp(neg, lhs: value, rhs: signBitConst, opcode: StdBinOpcode.shrLogical, operandType: StdType.i64))
	let minusConst = ids.mint()
	module.appendOp(block, op: StdOp.const(minusConst, value: AsciiMinusSign, valueType: StdType.i64))
	module.appendOp(block, op: StdOp.storeIndirect(dest, offset: 0, valueId: minusConst, valueType: StdType.u8))
	let spanConst = ids.mint()
	module.appendOp(block, op: StdOp.const(spanConst, value: SignMultiplierSpan, valueType: StdType.i64))
	let twoNeg = ids.mint()
	module.appendOp(block, op: StdOp.binOp(twoNeg, lhs: spanConst, rhs: neg, opcode: StdBinOpcode.mul, operandType: StdType.i64))
	let signBaseConst = ids.mint()
	module.appendOp(block, op: StdOp.const(signBaseConst, value: SignMultiplierBase, valueType: StdType.i64))
	let sign = ids.mint()
	module.appendOp(block, op: StdOp.binOp(sign, lhs: signBaseConst, rhs: twoNeg, opcode: StdBinOpcode.sub, operandType: StdType.i64))

	return RenderedSign.signed(neg, sign: sign)
end 'emitRenderedSign'

// `len = digits + neg` — the rendered width, which for an unsigned rendering IS the digit count, since
// `neg` is also the offset the most significant digit is written at.
function emitSignWidenedLength(module StdModule, block IrBlock, ids ValueMinter, digits ValueId, sign RenderedSign) returns ValueId
	return match sign 'rendering'
		unsigned gives digits
		signed(neg, _) gives emitI64BinOp(module, block: block, ids: ids, lhs: digits, rhs: neg, opcode: StdBinOpcode.add)
	end 'rendering'
end 'emitSignWidenedLength'

// `digit * sign` — one digit's magnitude. A SIGNED `value % 10` carries the value's sign, so a negative
// value's digits arrive negative and are multiplied back; an unsigned remainder is already the magnitude.
function emitDigitMagnitude(module StdModule, block IrBlock, ids ValueMinter, digit ValueId, sign RenderedSign) returns ValueId
	return match sign 'rendering'
		unsigned gives digit
		signed(_, multiplier) gives emitI64BinOp(module, block: block, ids: ids, lhs: digit, rhs: multiplier, opcode: StdBinOpcode.mul)
	end 'rendering'
end 'emitDigitMagnitude'

// Mint a value and append the 64-bit `binOp` that defines it. The two arms above need that pair as an
// EXPRESSION — a `gives` arm is one — where the builders spell it out as two statements.
function emitI64BinOp(module StdModule, block IrBlock, ids ValueMinter, lhs ValueId, rhs ValueId, opcode StdBinOpcode) returns ValueId
	let result = ids.mint()
	module.appendOp(block, op: StdOp.binOp(result, lhs: lhs, rhs: rhs, opcode: opcode, operandType: StdType.i64))
	return result
end 'emitI64BinOp'

// `__bool_to_string(value, dest) -> len` — render a bool as "true" (4 bytes) or "false" (5). The value is
// 0 or 1, so a single branch picks the rendering; each branch writes its bytes with fixed offsets and
// returns its length. The last value minted in each branch is the length const (returned, so materialized),
// never the entry `cmp`, so the value-class column is sized right (see `buildIntToString`'s header).
function buildBoolToString(module StdModule)
	var func = IrFunction.createFromStd(BoolToStringName, returnType: StdReturnType.value(StdType.i64), paramCount: 2, paramTypes: twoI64Params(), returnLine: 0)
	var ids = ValueMinter.create(2)

	var entry = module.addBlock(func, label: b"entry")
	var trueCase = module.addBlock(func, label: b"trueCase")
	var falseCase = module.addBlock(func, label: b"falseCase")

	emitParams(module, block: entry, count: 2)
	let value = 0 as ValueId
	let dest = 1 as ValueId

	let zeroConst = ids.mint()
	module.appendOp(entry, op: StdOp.const(zeroConst, value: 0, valueType: StdType.i64))
	let isFalse = ids.mint()
	module.appendOp(entry, op: StdOp.cmp(isFalse, lhs: value, rhs: zeroConst, pred: StdCmpPred.eq, operandType: StdType.i64))
	module.setTerminator(entry, op: StdOp.condBranch(isFalse, thenBlockId: falseCase.id, elseBlockId: trueCase.id))

	storeConstByte(module, block: trueCase, ids: ids, dest: dest, offset: 0 as ByteOffset, charValue: AsciiLowerT)
	storeConstByte(module, block: trueCase, ids: ids, dest: dest, offset: 1 as ByteOffset, charValue: AsciiLowerR)
	storeConstByte(module, block: trueCase, ids: ids, dest: dest, offset: 2 as ByteOffset, charValue: AsciiLowerU)
	storeConstByte(module, block: trueCase, ids: ids, dest: dest, offset: 3 as ByteOffset, charValue: AsciiLowerE)
	let trueLen = ids.mint()
	module.appendOp(trueCase, op: StdOp.const(trueLen, value: BoolTrueLength, valueType: StdType.i64))
	module.setTerminator(trueCase, op: StdOp.ret(trueLen))

	storeConstByte(module, block: falseCase, ids: ids, dest: dest, offset: 0 as ByteOffset, charValue: AsciiLowerF)
	storeConstByte(module, block: falseCase, ids: ids, dest: dest, offset: 1 as ByteOffset, charValue: AsciiLowerA)
	storeConstByte(module, block: falseCase, ids: ids, dest: dest, offset: 2 as ByteOffset, charValue: AsciiLowerL)
	storeConstByte(module, block: falseCase, ids: ids, dest: dest, offset: 3 as ByteOffset, charValue: AsciiLowerS)
	storeConstByte(module, block: falseCase, ids: ids, dest: dest, offset: 4 as ByteOffset, charValue: AsciiLowerE)
	let falseLen = ids.mint()
	module.appendOp(falseCase, op: StdOp.const(falseLen, value: BoolFalseLength, valueType: StdType.i64))
	module.setTerminator(falseCase, op: StdOp.ret(falseLen))

	module.functions.push(func)
end 'buildBoolToString'

// `__str_append(self, other)` — grow `self` in place by `other`'s bytes. The first time a shv2 String's
// bytes leave the inline/rdata region (Wave D), so the FIRST real exercise of the leak gate on a non-inline
// allocation. Adapted from v1's `__managed_mem_cow_check`+`grow` (`stdlib/Internals.maxon:3432-3491`) to
// shv2's fused record and static single-owner model (no refcount on the detach path).
//
// ⭐ **ONE TEST DECIDES THE DETACH — `emitBufferCannotHold`, WHICH IS THE SHARED ENCODING'S OWN, NOT A
// SECOND SPELLING OF "IS THIS BUFFER MINE?".** The bytes must move to a fresh external buffer whenever
// `capacity@16 < requiredLen`, and that single comparison covers the ordinary grow AND every non-owned
// buffer at once. WHY it covers the second is not stated here: it is a property of the capacity values,
// so it is written where they are declared (`BufferOwnership`), against a type that stops at `-1` so a
// provenance CANNOT be added that slips past this test. `requiredLen = selfLen + otherLen` is this
// function's half of that contract — a sum of two `length@8` byte counts, hence never negative.
//
// ⚠ **THE OLD ALLOCATION IS RELEASED THROUGH THE SHARED PAIR, AND ONLY AFTER BOTH COPIES ARE DONE.**
// `__mm_cow_detach` reads WHICH allocation the record owes a release to (via `emitOwedAllocationBase`)
// before it republishes the fields that answer it, and RETURNS it rather than paying it — an inline String
// owes nothing, its bytes being in its own box — and `emitReleaseOwedBase` pays it here, null-guarded, once
// the blit has finished reading. That split across the two functions is this caller's doing: see
// `buildMmCowDetach`, where the aliasing below is the stated reason the debt comes back out at all. ⭐ The release rides a
// BLOCK ARG into `blit` (0 on the in-place edge) rather than happening in the detach block, and that is
// load-bearing rather than tidy: `s.append(s)` aliases `other` to `self`'s OLD buffer, so releasing before
// the blit is a read-after-release. It is invisible today — `__mm_free` reclaims nothing under the bump
// allocator (PLAN.md #108) — and it is a use-after-free the day it does.
//
// ⚠ **THE INVARIANT THIS RUNG USED TO SPELL AS `parent@32 == -1` IS UNCHANGED IN BEHAVIOUR**: a String
// that has detached owns an external buffer and must release it, and one whose bytes are inline or in
// `.rdata` must not. What changed is only WHERE that is written down — `capacity@16 >= 0` plus
// `emitOwedAllocationBase`, the same encoding the Array record reads — so a String and an Array can no longer
// disagree about what a record owns. Leave it wrong and the external buffer is never freed (a leak, exit
// 101) or an interior pointer is released (an over-release, also 101).
//
// ⭐⭐ **GROWTH IS GEOMETRIC (`2 * requiredLen`), AND IT HAD TO BECOME SO: EXACT GROWTH MADE THE
// COMMONEST STRING IDIOM IN THE LANGUAGE QUADRATIC.** Exact growth means the buffer is full the instant
// it is published, so the NEXT append fails `capacity < requiredLen` again, reallocates, and re-copies
// every byte written so far — `var s = ""` plus a loop of appends copies O(n²) bytes and makes one
// allocation per append. MEASURED, before this, with `Testing/ladders/genstring.sh <n> data-appendloop`:
// 2,048 → 32,768 chunks of 9 bytes read **×3.94 ×4.07 ×3.82 ×3.88** per doubling — a clean quadratic —
// and the top rung took **5.0 seconds to build a 288 KB string**. Doubling the ask makes the copies
// geometric and the whole build amortized O(n); the same ladder reads ×2 after.
//
// ⭐ **`2 * requiredLen` RATHER THAN `max(requiredLen, 2 * capacity)`, AND THE REASON IS THE BRANCH.**
// `requiredLen = selfLen + otherLen >= selfLen`, so doubling it is unconditionally big enough for both the
// bytes being written now and a growth factor over what was there before — no comparison, no extra block,
// no phi, in a runtime graph that gets real register allocation. A `max` would buy a tighter bound on one
// enormous single append and pay for it on every ordinary one.
//
// ⚠ **NOTHING ELSE READS `capacity@16` AS "THE SIZE OF THE ALLOCATION"** — that is what makes an
// over-allocation safe rather than merely convenient. `emitBufferNotOwned` asks only its SIGN, and
// `2 * requiredLen` of a non-negative sum stays non-negative; `emitBufferCannotHold` asks only whether it
// is below the next `requiredLen`; and the release path takes `buffer@0` (the pointer `__mm_alloc`
// returned) through `emitOwedAllocationBase`, so `__mm_free` reclaims whatever was actually allocated and
// never consults this field. `length@8` remains the byte count every reader uses, so the slack bytes are
// invisible to `print`, to `==`, and to every method in this file. The alloc/free COUNT is still trivially
// balanced — one allocation per detach, as before; there are simply far fewer detaches.
function buildStrAppend(module StdModule)
	var func = IrFunction.createFromStd(StrAppendName, returnType: StdReturnType.void, paramCount: 2, paramTypes: twoI64Params(), returnLine: 0)
	var ids = ValueMinter.create(2)

	var entry = module.addBlock(func, label: b"entry")
	var inPlace = module.addBlock(func, label: b"inPlace")
	var detach = module.addBlock(func, label: b"detach")
	var blit = module.addBlock(func, label: b"blit")
	var clearSingleByte = module.addBlock(func, label: b"clearSingleByte")
	let done = module.addBlock(func, label: b"done")

	emitParams(module, block: entry, count: 2)
	let selfPtr = 0 as ValueId
	let otherPtr = 1 as ValueId

	// entry: load the fields every block reads (entry dominates all of them, so these need no phi),
	// compute the required length, and branch on whether the buffer already has room for it.
	let selfLen = emitLoadField(module, block: entry, record: selfPtr, offset: StringLengthOffset, ids: ids)
	let otherLen = emitLoadField(module, block: entry, record: otherPtr, offset: StringLengthOffset, ids: ids)
	let otherBuf = emitLoadField(module, block: entry, record: otherPtr, offset: StringBufferOffset, ids: ids)
	let otherSingleByte = emitLoadField(module, block: entry, record: otherPtr, offset: StringSingleByteGraphemesOffset, ids: ids)
	let requiredLen = emitBin(module, block: entry, a: selfLen, b: otherLen, opcode: StdBinOpcode.add, ids: ids)
	let tooSmall = emitBufferCannotHold(module, block: entry, record: selfPtr, requiredLen: requiredLen, ids: ids)
	module.setTerminator(entry, op: StdOp.condBranch(tooSmall, thenBlockId: detach.id, elseBlockId: inPlace.id))

	// The allocation the blit owes a release to once it has finished reading: the pre-detach one, or none
	// at all when the bytes go into the buffer that is already there.
	let owedBase = ids.mint()
	blit.blockArgs.push(IrBlockArg.create(owedBase, argType: StdType.i64))

	let owesNothing = emitConst(module, block: inPlace, value: NoOwedAllocation, ids: ids)
	module.setTerminator(inPlace, op: StdOp.branch(blit.id))
	inPlace.branchEdges.push(BranchEdge.create(blit.id, argIds: argsOf(owesNothing)))

	// detach: the shared copy-on-write action. The ask is GEOMETRIC — see the growth note above — and it is
	// passed in ELEMENTS, which for a String (`element_size@24 == 1`) is the same number as bytes; the same
	// value lands in `capacity@16`, so the field says exactly how far the next append may write in place.
	//
	// ⚠ The owed base comes BACK rather than being released inside, and this caller is the reason that is so:
	// `s.append(s)` aliases `otherBuf` to `self`'s OLD buffer, so the release may not happen until the BLIT
	// below has also finished reading. It rides a block arg into `blit` (0 on the in-place edge) and is paid
	// there. `__arr_cow_detach`, which has no such aliasing, pays it immediately instead.
	let grownLen = emitBin(module, block: detach, a: requiredLen, b: requiredLen, opcode: StdBinOpcode.add, ids: ids)
	let base = ids.mint()
	module.appendOp(detach, op: StdOp.call(base, callee: MmCowDetachName, args: twoArgs(selfPtr, second: grownLen)))
	module.setTerminator(detach, op: StdOp.branch(blit.id))
	detach.branchEdges.push(BranchEdge.create(blit.id, argIds: argsOf(base)))

	// blit: append `other`'s bytes at the end of `self`'s CURRENT buffer (reloaded, since detach may have
	// replaced it) using the OLD length as the write cursor, then publish the new length. Reached in place
	// and grown alike. Only now is the old allocation released — see the aliasing note above.
	let curBuf = emitLoadField(module, block: blit, record: selfPtr, offset: StringBufferOffset, ids: ids)
	let dstAddr = emitBin(module, block: blit, a: curBuf, b: selfLen, opcode: StdBinOpcode.add, ids: ids)
	let blitted = ids.mint()
	module.appendOp(blit, op: StdOp.call(blitted, callee: StrCopyName, args: threeArgs(dstAddr, second: otherBuf, third: otherLen)))
	emitStoreField(module, block: blit, record: selfPtr, offset: StringLengthOffset, value: requiredLen)
	var afterRelease = emitReleaseOwedBase(module, func: func, cur: blit, base: owedBase, callee: MmDecrefName, ids: ids)

	// afterRelease: `singleByteGraphemes` is maintained incrementally — the concatenation stays ASCII only if `other` is.
	let notSingleByte = emitConst(module, block: afterRelease, value: SingleByteGraphemesFalse, ids: ids)
	let otherNotSingleByte = emitCmp(module, block: afterRelease, a: otherSingleByte, b: notSingleByte, pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(afterRelease, op: StdOp.condBranch(otherNotSingleByte, thenBlockId: clearSingleByte.id, elseBlockId: done.id))

	// clearSingleByte: `other` carried a non-ASCII byte, so the result is not ASCII.
	emitStoreField(module, block: clearSingleByte, record: selfPtr, offset: StringSingleByteGraphemesOffset, value: notSingleByte)
	module.setTerminator(clearSingleByte, op: StdOp.branch(done.id))

	module.setTerminator(done, op: StdOp.retVoid)

	module.functions.push(func)
end 'buildStrAppend'

// `__str_decref(record)` — a String's DROP. It is `__mm_decref` (dec the refcount; free at the last
// owner) plus the one thing the generic decref structurally cannot do: release the EXTERNAL buffer of a
// detached String BEFORE the record. The parser routes every owned-String drop here by TAG (`emitDecref`),
// so a struct box and a raw scratch buffer still drop through `__mm_decref`; only a String record, which
// alone carries the buffer-ownership encoding, drops through here.
//
// ⭐ **STATIC DISPATCH, NOT A DESTRUCTOR POINTER.** The record stores NO destructor — the parser knows the
// static type at every drop, so there is nothing to dispatch dynamically, and `funcAddr`/`callIndirect`
// stay deferred until a struct/array FIELD can hold a String (P1.4+), where a box's own `__mm_free` must
// reach a destructor it cannot name. Shipping the indirect-call vocabulary now would be vocabulary ahead
// of its forcing consumer — the mistake `__mm_incref` and `mintPhi` are the standing warnings against.
//
// The refcount read-modify-write is the shared `emitRefcountCheckToLastOwner` (load rc; `== 0` ⇒ last
// owner; else lower and keep) — the ONE home of the refcount protocol, so a String and a struct box
// cannot disagree about who the last owner is. `__str_decref` runs that shared check itself, rather
// than calling `__mm_decref` at runtime, because it must read `parent`/`buffer` out of the record on
// the last-owner path BEFORE that record is freed — the generic decref would reclaim the box first.
function buildStrDecref(module StdModule)
	var func = IrFunction.createFromStd(StrDecrefName, returnType: StdReturnType.void, paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry")
	var lower = module.addBlock(func, label: b"lower")
	var release = module.addBlock(func, label: b"release")
	var baseJoin = module.addBlock(func, label: b"baseJoin")
	var freeRec = module.addBlock(func, label: b"freeRec")

	emitParams(module, block: entry, count: 1)
	let record = 0 as ValueId

	// entry + lower: the shared refcount check. `rc == 0` (the last owner) branches to `release`, where a
	// String does the one thing the generic decref structurally cannot — release a detached buffer first.
	emitRefcountCheckToLastOwner(module, entry: entry, lower: lower, record: record, lastOwner: release, ids: ids)

	// release + baseJoin: the last owner asks the shared pair which separate allocation this record owes a
	// release to and pays it, BEFORE the record itself dies — the whole reason this cannot simply call
	// `__mm_decref`, which would reclaim the box while its `capacity`/`buffer` are still the answer. A
	// String that detached is an OWNER (`capacity@16 >= 0`) and owes its own `buffer@0`; one whose bytes are
	// inline (or in an immortal `.rdata` blob) has a negative capacity and leaves through the `parent@32`
	// arm holding `NoOwedAllocation`, which the null guard inside the release step turns into an ordinary
	// answer rather than a case. It is the SAME pair `__arr_decref` uses, so a String and an Array cannot
	// disagree about what a record owns.
	let base = emitOwedAllocationBase(module, func: func, cur: release, join: baseJoin, record: record, ids: ids)
	var afterRelease = emitReleaseOwedBase(module, func: func, cur: baseJoin, base: base, callee: MmDecrefName, ids: ids)
	module.setTerminator(afterRelease, op: StdOp.branch(freeRec.id))

	// freeRec: release the record itself, its external bytes (if it had any) already released.
	let recFreed = ids.mint()
	module.appendOp(freeRec, op: StdOp.call(recFreed, callee: MmFreeName, args: argsOf(record)))
	module.setTerminator(freeRec, op: StdOp.retVoid)

	module.functions.push(func)
end 'buildStrDecref'

// ⭐ **THE ONE ENCODER of shv2's fused OWNED inline String record** — record + inline bytes + a trailing NUL in
// ONE `__mm_alloc`, `buffer@0` pointing at the inline region, `capacity@16 = InlineBufferCapacity`, `parent@32`
// left 0 by the slab zeroing, and `singleByteGraphemes@40 = singleByteGraphemes`. Emits the ops into `block` and returns the record.
// Shared so the record layout has exactly ONE construction site: `__str_clone` (passes the SOURCE's `singleByteGraphemes`)
// and `__gt_subp_str_from_bytes` (passes 0 — child output is arbitrary bytes, `not-ascii` is the safe class)
// were byte-for-byte copies of this sequence, and a field the record later gains must be initialized once, here,
// not silently in one path and not the other.
export function emitBuildOwnedInlineString(module StdModule, block IrBlock, ids ValueMinter, srcBuf ValueId, srcLen ValueId, singleByteGraphemes ValueId) returns ValueId
	let newRec = emitAllocOwnedInlineString(module, block: block, ids: ids, byteLen: srcLen, singleByteGraphemes: singleByteGraphemes)
	let copied = ids.mint()
	module.appendOp(block, op: StdOp.call(copied, callee: StrCopyName, args: threeArgs(emitInlineStringBuffer(module, block: block, ids: ids, record: newRec), second: srcBuf, third: srcLen)))
	return newRec
end 'emitBuildOwnedInlineString'

// ⭐ **THE RECORD HALF of `emitBuildOwnedInlineString`, split out for the producers that do NOT have one
// contiguous source to copy from.** `__str_replace` was the original — it assembled its result from
// alternating slices of the receiver and of the replacement — and it retired onto `stdlib/String.maxon` in
// W49 wave 2; `GraphemeRuntime.emitCharRecordBuffer` is the reader that remains, and it writes a codepoint's
// UTF-8 bytes one at a time. Both need the box PUBLISHED and the bytes left to them. Everything about the
// record is settled here — its size (`byteLen` + record + NUL), its `buffer@0`, and the whole buffer-ownership
// encoding (`capacity@16 = InlineBufferCapacity`, `parent@32` left 0 by the slab's zeroing contract) — so a
// caller that fills the bytes itself cannot publish a record that differs from a cloned one by a field.
export function emitAllocOwnedInlineString(module StdModule, block IrBlock, ids ValueMinter, byteLen ValueId, singleByteGraphemes ValueId) returns ValueId
	// One `__mm_alloc` for the record + the bytes + a trailing NUL (the slab zeroes it), sized exactly as an
	// interpolation of a single part is (`StringInterpOverheadBytes` = record + NUL).
	let overhead = emitConst(module, block: block, value: StringInterpOverheadBytes, ids: ids)
	let allocSize = emitBin(module, block: block, a: byteLen, b: overhead, opcode: StdBinOpcode.add, ids: ids)
	// A fused String record owns nothing beyond the one allocation it IS, so nothing cascades — the same
	// `TrivialDestructor` the parser passes at `emitBoxAlloc`, read from its one declaration rather than
	// spelled as a bare 0 (`__strix_make` is the third reader of it).
	let zeroDtor = emitConst(module, block: block, value: TrivialDestructor, ids: ids)
	let newRec = ids.mint()
	module.appendOp(block, op: StdOp.call(newRec, callee: MmAllocName, args: twoArgs(allocSize, second: zeroDtor)))

	emitStoreField(module, block: block, record: newRec, offset: StringBufferOffset, value: emitInlineStringBuffer(module, block: block, ids: ids, record: newRec))
	emitStoreField(module, block: block, record: newRec, offset: StringLengthOffset, value: byteLen)
	let capacity = emitConst(module, block: block, value: InlineBufferCapacity as ParsedInt, ids: ids)
	emitStoreField(module, block: block, record: newRec, offset: StringCapacityOffset, value: capacity)
	let elementSize = emitConst(module, block: block, value: StringElementSize, ids: ids)
	emitStoreField(module, block: block, record: newRec, offset: StringElementSizeOffset, value: elementSize)
	emitStoreField(module, block: block, record: newRec, offset: StringSingleByteGraphemesOffset, value: singleByteGraphemes)

	return newRec
end 'emitAllocOwnedInlineString'

// Where a fused record's inline bytes begin: right after the record. ONE definition, asked for by everything
// that writes those bytes — so a caller re-deriving it (two ops, a const and an add, in a compiler-internal
// graph) is cheaper than a second place that could be told a different record size.
export function emitInlineStringBuffer(module StdModule, block IrBlock, ids ValueMinter, record ValueId) returns ValueId
	let recordBytes = emitConst(module, block: block, value: StringRecordBytes as ParsedInt, ids: ids)
	return emitBin(module, block: block, a: record, b: recordBytes, opcode: StdBinOpcode.add, ids: ids)
end 'emitInlineStringBuffer'

// ⭐ **`__str_clone(src) -> newStr` — A STRING'S DEEP CLONE (P1.7 slice 3b-vi-b).** A fresh OWNED heap String,
// an independent copy of `src` that `__str_decref` reclaims without touching `src`. It is the SAME single-
// `__mm_alloc` fused-record path an interpolation builds (`Parser.emitStringInterp` / `promoteToOwnedString`,
// with the source as its one part), packaged as a runtime function so the managed array/struct clone walk can
// take its `funcAddr` and `callIndirect` it per element/field.
//
// ⭐ **THE RESULT IS INLINE, so it is INDEPENDENTLY DROPPABLE with no double-free of the source's bytes.** One
// `__mm_alloc` holds the 48-byte record with the bytes right behind it (`buffer@0 = newRec + StringRecordBytes`),
// `capacity@16 = InlineBufferCapacity` and `parent@32 = NoOwedAllocation` (the slab's zeroing supplies the 0) —
// the same encoding `emitStringInterp` publishes — so `__str_decref` reclaims record and bytes together and owes
// nothing to anyone. A LITERAL source (immortal `.rdata`, `capacity == RdataBufferCapacity`) clones through this
// identical path: its bytes are COPIED into the new inline box, so the clone frees its own copy and never the
// immortal blob. `singleByteGraphemes@40` is carried over from the source, an accurate copy at no extra cost.
function buildStrClone(module StdModule)
	var func = IrFunction.createFromStd(StrCloneName, returnType: StdReturnType.value(StdType.i64), paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry")
	emitParams(module, block: entry, count: 1)
	let src = 0 as ValueId

	// A clone PRESERVES the source's `singleByteGraphemes` classification (the bytes are copied verbatim), unlike a
	// raw-bytes construction which cannot know it.
	let srcLen = emitLoadField(module, block: entry, record: src, offset: StringLengthOffset, ids: ids)
	let srcBuf = emitLoadField(module, block: entry, record: src, offset: StringBufferOffset, ids: ids)
	let srcSingleByte = emitLoadField(module, block: entry, record: src, offset: StringSingleByteGraphemesOffset, ids: ids)
	let newRec = emitBuildOwnedInlineString(module, block: entry, ids: ids, srcBuf: srcBuf, srcLen: srcLen, singleByteGraphemes: srcSingleByte)

	module.setTerminator(entry, op: StdOp.ret(newRec))

	module.functions.push(func)
end 'buildStrClone'

// ⚠ **THE `--- P1.8 Slice C ---` SECTION WAS HERE AND IS EMPTY** (W49 wave 5). It held `__str_range_eq`
// and `__str_find` to the end: the raw byte-range compare and the positioned search that `startsWith`,
// `endsWith`, `contains`, `split` and the two `StringIndex` searches were all built on. Every one of those
// members is `stdlib/String.maxon`'s now, and the corpus reaches the same two answers through its own
// `bytesEqual`/`findIn` — which these graphs were transcribed from. See the P1.8 Slice C grave at the head
// of this file for why they could not be deleted one wave sooner.

// ⭐ **`__str_from_bytes(arr) -> newStr` — `String.from(bytes)` (`stdlib/String.maxon:119-121`).** The
// array's buffer holds exactly the UTF-8 bytes the String is to have, so the whole of the work is the
// ASCII classification and the same fused-record build every other owned String is born through.
//
// ⚠ **IT COPIES WHERE THE REFERENCE SHARES, AND THE DIVERGENCE IS FORCED.** The reference builds
// `String{managed: bytes.managed, …}` — a zero-copy view of the array's own backing memory, sound there
// because a `__ManagedMemory` is refcounted and the two records share ownership of one block. shv2 has no
// shared-ownership relationship between an `Array` record and a `String` record: each is an independent
// box whose drop reclaims its own allocation, so a view would be a second reclaimer of one block (a
// double free) or a reader of a block the array's `__arr_decref` has already returned. Copying makes the
// result an ordinary owned inline String, which is what every producer in this file hands back and what
// `__str_decref` already knows how to reclaim.
function buildStrFromBytes(module StdModule)
	var func = IrFunction.createFromStd(StrFromBytesName, returnType: StdReturnType.value(StdType.i64), paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry")
	var scan = module.addBlock(func, label: b"scan")
	var scanBody = module.addBlock(func, label: b"scanBody")
	var notHigh = module.addBlock(func, label: b"notHigh")
	var stillSingleByte = module.addBlock(func, label: b"stillSingleByte")
	var sawMultiByteGrapheme = module.addBlock(func, label: b"sawMultiByteGrapheme")
	var build = module.addBlock(func, label: b"build")

	emitParams(module, block: entry, count: 1)
	let arr = 0 as ValueId

	let len = emitLoadField(module, block: entry, record: arr, offset: ArrLengthOffset, ids: ids)
	let buf = emitLoadField(module, block: entry, record: arr, offset: ArrBufferOffset, ids: ids)
	let zero = emitConst(module, block: entry, value: 0, ids: ids)
	module.setTerminator(entry, op: StdOp.branch(scan.id))

	// The `singleByteGraphemes@40` classification, computed rather than guessed: it is a claim about these
	// bytes, and the one place a String's is otherwise produced (`bytesAreSingleByteGraphemes`) makes the
	// identical claim at lower time for a literal. It is carried as an i64 0/1, the width the field is stored
	// at, which is why each disqualifying case is a BRANCH rather than an `and` of the `i1` a compare yields:
	// the two are different Std types and the flag must be the record's.
	//
	// ⭐ **TWO TESTS PER BYTE, NOT ONE, AND THE SECOND IS THE ONE THIS FLAG IS NAMED FOR.** A high byte begins
	// a multi-byte codepoint; a CR is ASCII yet is not a grapheme on its own, because GB3 joins it to a
	// following LF. Both are disqualifying and they are asked in a LADDER for the reason above — the `and` of
	// two `i1`s would not be the i64 the field holds.
	let i = ids.mint()
	let singleByte = ids.mint()
	scan.blockArgs.push(IrBlockArg.create(i, argType: StdType.i64))
	scan.blockArgs.push(IrBlockArg.create(singleByte, argType: StdType.i64))
	let one = emitConst(module, block: entry, value: 1, ids: ids)
	entry.branchEdges.push(BranchEdge.create(scan.id, argIds: twoArgs(zero, second: one)))

	let scanned = emitCmp(module, block: scan, a: i, b: len, pred: StdCmpPred.ge, ids: ids)
	module.setTerminator(scan, op: StdOp.condBranch(scanned, thenBlockId: build.id, elseBlockId: scanBody.id))

	let raw = emitLoadByteIndexed(module, block: scanBody, base: buf, index: i, ids: ids)
	let highBit = emitConst(module, block: scanBody, value: AsciiHighBit, ids: ids)
	let isLow = emitCmp(module, block: scanBody, a: raw, b: highBit, pred: StdCmpPred.lt, ids: ids)
	let iNext = emitBin(module, block: scanBody, a: i, b: one, opcode: StdBinOpcode.add, ids: ids)
	module.setTerminator(scanBody, op: StdOp.condBranch(isLow, thenBlockId: notHigh.id, elseBlockId: sawMultiByteGrapheme.id))

	let crByte = emitConst(module, block: notHigh, value: CarriageReturnByte as ParsedInt, ids: ids)
	let isNotCr = emitCmp(module, block: notHigh, a: raw, b: crByte, pred: StdCmpPred.ne, ids: ids)
	module.setTerminator(notHigh, op: StdOp.condBranch(isNotCr, thenBlockId: stillSingleByte.id, elseBlockId: sawMultiByteGrapheme.id))

	module.setTerminator(stillSingleByte, op: StdOp.branch(scan.id))
	stillSingleByte.branchEdges.push(BranchEdge.create(scan.id, argIds: twoArgs(iNext, second: singleByte)))

	module.setTerminator(sawMultiByteGrapheme, op: StdOp.branch(scan.id))
	sawMultiByteGrapheme.branchEdges.push(BranchEdge.create(scan.id, argIds: twoArgs(iNext, second: zero)))

	module.setTerminator(build, op: StdOp.ret(emitBuildOwnedInlineString(module, block: build, ids: ids, srcBuf: buf, srcLen: len, singleByteGraphemes: singleByte)))

	module.functions.push(func)
end 'buildStrFromBytes'

// ⭐ **`__str_of_buffer(srcRecord, singleByteGraphemes) -> String`** — see the constant's header for what it
// is for and why it copies. The whole body is `buildStrFromBytes`'s tail with the scan removed: the flag
// arrives as a parameter, so there is no ladder and no loop, just the read of the source's two buffer slots
// and the one shared record build.
//
// ⚠ **THE SOURCE IS READ THROUGH THE *ARRAY* SLOTS, AND THAT IS THE HONEST SPELLING RATHER THAN A COINCIDENCE
// EXPLOITED.** Its argument is a `__ManagedMemory`, which in shv2 IS the array-shaped buffer record — what
// `arr.managed` yields and what `managed.slice(…)` returns (`ArrayRuntime.emitViewRecordHead` builds it
// through `__arr_create`). The two records agree at `buffer@0`/`length@8`, and `BufferOwnership`'s header
// says in so many words that *"the two sets coincide today and nothing here relies on that"* — so reading a
// buffer through the buffer record's own constants is what keeps that true.
function buildStrOfBuffer(module StdModule)
	var func = IrFunction.createFromStd(StrOfBufferName, returnType: StdReturnType.value(StdType.i64), paramCount: 2, paramTypes: twoI64Params(), returnLine: 0)
	var ids = ValueMinter.create(2)

	var entry = module.addBlock(func, label: b"entry")
	emitParams(module, block: entry, count: 2)
	let src = 0 as ValueId
	let singleByteGraphemes = 1 as ValueId

	let len = emitLoadField(module, block: entry, record: src, offset: ArrLengthOffset, ids: ids)
	let buf = emitLoadField(module, block: entry, record: src, offset: ArrBufferOffset, ids: ids)
	module.setTerminator(entry, op: StdOp.ret(emitBuildOwnedInlineString(module, block: entry, ids: ids, srcBuf: buf, srcLen: len, singleByteGraphemes: singleByteGraphemes)))

	module.functions.push(func)
end 'buildStrOfBuffer'

// ⭐ **`__mm_to_cstring(bufRecord) -> ptr`** — see the constant's header for the contract and for why the
// copy path's result is unowned. Three blocks: read `buffer[length]`, hand the buffer straight back when it
// is already 0, otherwise allocate `length + 1` (the slab zeroes the terminator, so nothing writes it),
// blit the payload across and return the fresh address.
function buildMmToCString(module StdModule)
	var func = IrFunction.createFromStd(MmToCStringName, returnType: StdReturnType.value(StdType.i64), paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry")
	var alreadyTerminated = module.addBlock(func, label: b"nulok")
	var copyIt = module.addBlock(func, label: b"copy")

	emitParams(module, block: entry, count: 1)
	let src = 0 as ValueId

	let len = emitLoadField(module, block: entry, record: src, offset: ArrLengthOffset, ids: ids)
	let buf = emitLoadField(module, block: entry, record: src, offset: ArrBufferOffset, ids: ids)
	let terminator = emitLoadByteIndexed(module, block: entry, base: buf, index: len, ids: ids)
	let zero = emitConst(module, block: entry, value: 0, ids: ids)
	let isTerminated = emitCmp(module, block: entry, a: terminator, b: zero, pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(entry, op: StdOp.condBranch(isTerminated, thenBlockId: alreadyTerminated.id, elseBlockId: copyIt.id))

	module.setTerminator(alreadyTerminated, op: StdOp.ret(buf))

	// `len + 1` — the payload plus the terminator the zeroing supplies. `TrivialDestructor` because the
	// block is raw bytes owning nothing, exactly as `emitAllocOwnedInlineString`'s is.
	let one = emitConst(module, block: copyIt, value: 1, ids: ids)
	let withNul = emitBin(module, block: copyIt, a: len, b: one, opcode: StdBinOpcode.add, ids: ids)
	let zeroDtor = emitConst(module, block: copyIt, value: TrivialDestructor, ids: ids)
	let fresh = ids.mint()
	module.appendOp(copyIt, op: StdOp.call(fresh, callee: MmAllocName, args: twoArgs(withNul, second: zeroDtor)))
	let copied = ids.mint()
	module.appendOp(copyIt, op: StdOp.call(copied, callee: StrCopyName, args: threeArgs(fresh, second: buf, third: len)))
	module.setTerminator(copyIt, op: StdOp.ret(fresh))

	module.functions.push(func)
end 'buildMmToCString'

// ⭐⭐ **`__str_bytes_view(str) -> arrRecord` — `addressableBytes()`, AND IT IS A BORROW OF THE BYTES WITH
// AN OWNED RECORD AROUND IT.** The corpus's body is `return managed` (`stdlib/String.maxon:181-183`) — hand
// out this String's own buffer, do not copy it — and that is exactly what this does: a zero-copy
// `Array with Byte` VIEW whose `buffer@0` IS the receiver's, built in O(1) through the same
// `emitViewRecordHead`/`emitViewRecordTail` pair `__arr_slice` uses. Nothing is copied and the cost does not
// depend on the length.
//
// ⚠⚠ **IT IS NOT THE STRING POINTER RETAGGED, AND THE REASON IS ONE SLOT.** A String record and an Array
// record agree at five of their six 8-byte slots — `buffer@0`, `length@8`, `capacity@16`, `element_size@24`
// (a String's is 1), `parent@32` (one shared `BufferOwnership` encoding) — and DISAGREE at `@40`, where a
// String keeps `singleByteGraphemes` and an Array keeps `element_destroy`. Handing the String pointer to the array
// dispatch would therefore make `urlBytes.slice(0, colonPos)` build a view whose `element_destroy@40` is the
// source's ASCII FLAG, and `__arr_decref` would `callIndirect` address 1 on every element of an all-ASCII
// slice. A URL is all-ASCII, so that is not a rare shape — it is every corpus call. A fresh record stamped
// `element_destroy = TrivialDestructor` states the fact instead of inheriting a coincidence, and it costs
// one 48-byte allocation for the whole `addressableBytes()` — the same allocation any `slice` already pays.
//
// ⛔⛔ **A WRITE THROUGH THIS VIEW DOES NOT REACH THE STRING, AND THIS BLOCK USED TO CALL THAT "SAFE".**
// `capacity@16 = ViewBufferCapacity` sends every in-place mutator through `__arr_cow_detach` first, so a
// caller that writes gets a private copy of the bytes and the String is untouched — and since the view is
// an owned TEMPORARY at every call site, that copy dies at statement end and the write is simply LOST. The
// old note argued this was the safer of the two answers and rested on *"nothing in `stdlib/` writes through
// this door"*, which was an observation about today's callers rather than a property of the door. W49 wave 2
// retired `toLower`/`toUpper` onto the corpus, which made `mapAsciiCase` — and with it `String.setByte` —
// reachable for the first time, and every case conversion in the suite returned its receiver verbatim.
//
// ⇒ **`String.setByte` NO LONGER COMES THROUGH HERE**; it hands `__arr_set_byte` the String's own record, so
// the detach asks about the STRING's provenance and the private copy it makes is the String's to keep. What
// this door is for is READING: `addressableBytes()`'s four corpus call sites read, then `slice`. A future
// writer must take the same route `setByte` now takes — the record — because a view cannot carry a write
// home.
//
// ⚠ **LIFETIME: the view holds a REFERENCE COUNT on the allocation the bytes live in** (see
// `emitStringBytesAllocation`), so it cannot outlive them however its binding is scoped. That is one more
// guarantee than the reference gives — where `return managed` relies on the caller keeping the String alive —
// and it is not gold-plating: every other view in this compiler counts its parent, and a view that did not
// would be the one dangling pointer in the runtime.
function buildStrBytesView(module StdModule)
	var func = IrFunction.createFromStd(StrBytesViewName, returnType: StdReturnType.value(StdType.i64), paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry")
	var baseJoin = module.addBlock(func, label: b"bvbase")
	var ret = module.addBlock(func, label: b"ret")

	emitParams(module, block: entry, count: 1)
	let record = 0 as ValueId

	let length = emitLoadField(module, block: entry, record: record, offset: StringLengthOffset, ids: ids)
	let buffer = emitLoadField(module, block: entry, record: record, offset: StringBufferOffset, ids: ids)
	let start = emitConst(module, block: entry, value: 0, ids: ids)
	let elementSize = emitConst(module, block: entry, value: StringElementSize, ids: ids)
	let elementDestroy = emitConst(module, block: entry, value: TrivialDestructor, ids: ids)
	let view = emitViewRecordHead(module, block: entry, srcBuffer: buffer, start: start, sliceLen: length, elementSize: elementSize, elementDestroy: elementDestroy, ids: ids)

	let base = emitStringBytesAllocation(module, func: func, cur: entry, join: baseJoin, record: record, ids: ids)
	emitViewRecordTail(module, func: func, cur: baseJoin, exit: ret, view: view, base: base, ids: ids)

	module.setTerminator(ret, op: StdOp.ret(view))

	module.functions.push(func)
end 'buildStrBytesView'

// ⭐⭐ **WHICH ALLOCATION MUST STAY ALIVE FOR THIS STRING'S BYTES TO BE READABLE — `NoOwedAllocation` when
// none must.** A near-twin of `emitOwedAllocationBase`, and DELIBERATELY BUILT ON IT rather than beside it,
// because the two questions differ by exactly one provenance and the rest of the answer must not be
// restated: *"which separate allocation do I owe a release to?"* and *"where do these bytes live?"* agree
// for a DETACHED String (its own `buffer@0`), for a VIEW (its `parent@32`) and for an `.rdata` literal
// (nothing) — and part company for an INLINE String, whose bytes sit inside its OWN `__mm_alloc` payload.
// That one honestly owes NOTHING, which is the right answer to the first question and a dangling
// `buffer@0` as an answer to this one.
//
// So: ask the shared question first, and answer this one only where it says "nothing".
//
//   * a non-zero owed base — a DETACHED String's own buffer, or a VIEW's shared base. Both are the
//     allocation the bytes are in, and a view's flattens exactly as `emitArrayView`'s nesting note
//     describes, so no chain is built or walked.
//   * `capacity@16 == RdataBufferCapacity` — an immortal blob, and the RECORD is in `.rdata` too, so there
//     is nothing to count and nothing that MAY be counted (an incref of read-only memory faults). This is
//     the one place a specific provenance value has to be compared against, because "immortal" is not
//     derivable from the other slots: an rdata literal and an inline String agree on both of them.
//     ⚠ **THAT COMPARISON IS AN EXCEPTION TO `BufferOwnership`'s STATED RULE** ("no compiler-side reader
//     compares against a specific one"), so the OBLIGATION it creates is recorded at the DECLARATION of
//     the three provenances, where a fourth one will be added — not only here, where nobody adding one
//     would look.
//   * otherwise — INLINE: the bytes are at `record + StringRecordBytes`, so the RECORD is the allocation.
//
// ⭐ **THE COUNT IS CORRECT IN BOTH DROP ORDERS, in every arm.** DETACHED: the view increfs `buffer@0` and
// the String's own `__str_decref` decrefs the same address on its last-owner path, so whichever dies second
// frees it. INLINE: the view increfs the RECORD, so `__str_decref` finds a non-zero count, lowers it and
// keeps the record — and the view's `__arr_decref` then `__mm_decref`s it, which for an inline String is
// exactly right because it owes nothing else. RDATA: nothing happens, twice.
function emitStringBytesAllocation(module StdModule, func IrFunction, cur IrBlock, join IrBlock, record ValueId, ids ValueMinter) returns ValueId
	var owedJoin = module.addBlock(func, label: b"bvowed")
	var separate = module.addBlock(func, label: b"bvsep")
	var noSeparate = module.addBlock(func, label: b"bvnosep")
	var immortal = module.addBlock(func, label: b"bvrdata")
	var inlineBytes = module.addBlock(func, label: b"bvinline")

	let owedBase = emitOwedAllocationBase(module, func: func, cur: cur, join: owedJoin, record: record, ids: ids)

	let base = ids.mint()
	join.blockArgs.push(IrBlockArg.create(base, argType: StdType.i64))

	let zero = emitConst(module, block: owedJoin, value: NoOwedAllocation, ids: ids)
	let owesOne = emitCmp(module, block: owedJoin, a: owedBase, b: zero, pred: StdCmpPred.ne, ids: ids)
	module.setTerminator(owedJoin, op: StdOp.condBranch(owesOne, thenBlockId: separate.id, elseBlockId: noSeparate.id))

	module.setTerminator(separate, op: StdOp.branch(join.id))
	separate.branchEdges.push(BranchEdge.create(join.id, argIds: argsOf(owedBase)))

	let capacity = emitLoadField(module, block: noSeparate, record: record, offset: StringCapacityOffset, ids: ids)
	let rdata = emitConst(module, block: noSeparate, value: RdataBufferCapacity as ParsedInt, ids: ids)
	let isImmortal = emitCmp(module, block: noSeparate, a: capacity, b: rdata, pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(noSeparate, op: StdOp.condBranch(isImmortal, thenBlockId: immortal.id, elseBlockId: inlineBytes.id))

	let nothing = emitConst(module, block: immortal, value: NoOwedAllocation, ids: ids)
	module.setTerminator(immortal, op: StdOp.branch(join.id))
	immortal.branchEdges.push(BranchEdge.create(join.id, argIds: argsOf(nothing)))

	module.setTerminator(inlineBytes, op: StdOp.branch(join.id))
	inlineBytes.branchEdges.push(BranchEdge.create(join.id, argIds: argsOf(record)))

	return base
end 'emitStringBytesAllocation'

// ⭐⭐ **`byteAt` AND `byteAtOrPanic` ARE ONE BOUNDS-CHECKED BYTE READ WITH TWO FAILURE EXITS — ONE GRAPH,
// AND THE EXIT IS THE ONLY PARAMETER.** The corpus says so at the declarations themselves: `byteAtOrPanic`
// (`stdlib/String.maxon:281-283`) IS `try byteAt(index) otherwise panic(…)`, i.e. the same read wearing the
// other exit. Two transcriptions would be two chances to get the bound wrong, and the bound is where every
// signed range check in this compiler has been caught missing.
//
//   * `__str_byte_at(str, index) -> (byte, flag)` THROWS `__ManagedMemoryError.invalidByteRange`, which is
//     what `stdlib/String.maxon:266-268` declares and what its doc argues for — *"the bounds contract stays
//     the CALLER's to state"*. Every stdlib byte walker outside `String.maxon` reads bytes through it.
//   * `__str_byte_at_or_panic(str, index) -> byte` ABORTS. Its 17 corpus call sites read bytes inside NESTED
//     CONDITIONS (`if trimmed.byteAtOrPanic(pos) == 47`), a position a `try` cannot occupy, so the failure
//     has to leave through the process; `RuntimeAbort.stringByteAtOutOfRange` is the same CLASS of answer the
//     oracle gives (the process ends), not the same message.
//
// ⚠ **THEY STAY TWO EMITTED FUNCTIONS, and the `throws` stamp is why.** That stamp is what makes a caller
// write `try` (`isThrowingStringRuntimeCallee` → E3055 accept, E3057 reject); one stamped function serving
// both would make all 17 panicking sites `tryCall` a failure that never returns, and one unstamped function
// serving both would silently drop the error flag at the throwing sites.
//
// ⚠ **AND NEITHER IS AN ALIAS OF `__arr_byte_at`, THOUGH THE BYTES IT READS ARE THE SAME** (`buffer@0`,
// `length@8`, no detach, no ownership). `managedMemorySourceMethodName` maps CALLEE → source method and has
// NO receiver, so routing a String read through the buffer family would tell an author who forgot a `try`
// about `__ManagedMemory.byteAt` — the right E3057 naming a construct their program does not contain, the
// D12 defect this tree has already paid for once.
//
// ⚠ The read goes through `buffer@0` with NO detach and NO ownership, right for the identical reason
// `__arr_byte_at` gives: a read does not write, so an `.rdata` blob, an inline String's bytes and a viewed
// buffer are all perfectly good things to read THROUGH.
function buildStrByteRead(module StdModule, name ByteArray)
	// ⭐⭐ **WHICH EXIT THIS BUILD GETS IS DERIVED FROM THE NAME, NOT PASSED BESIDE IT (review, BATCH2
	// slice 8).** It arrived as a `throwing bool` argument, which made "`__str_byte_at` throws and
	// `__str_byte_at_or_panic` does not" a fact written in TWO places — here at the two install sites, and
	// again in `isThrowingStringRuntimeCallee`, which is what the parser's E3055 accept and SemanticCheck's
	// E3057 reject read. Nothing made the two agree.
	//
	// ⛔ **MEASURED at the review**: building `StrByteAtName` with `throwing: false` — the stamp gone while
	// the predicate still claims it throws — left **all 13 `stdlib-whitelist` cases GREEN**, every corpus
	// byte walker included. A `tryCall` onto a callee that returns through the single-register ABI reads an
	// error flag nothing wrote; the suite is green because no committed input reaches an out-of-range index,
	// which is precisely the shape of divergence a test cannot be relied on to catch.
	//
	// ⇒ The predicate is now the ONE statement, and the divergence is no longer expressible: an install site
	// supplies a name and gets that name's exit.
	let throwing = isThrowingStringRuntimeCallee(name)
	let throwsClause = managedMemoryThrows() if throwing else ThrowsClause.none

	var func = IrFunction.createFromStd(name, returnType: StdReturnType.value(StdType.i64), paramCount: 2, paramTypes: twoI64Params(), returnLine: 0, throwsTypeName: throwsClause)
	var ids = ValueMinter.create(2)

	var entry = module.addBlock(func, label: b"entry")
	var bad = module.addBlock(func, label: b"oob")
	var load = module.addBlock(func, label: b"load")

	emitParams(module, block: entry, count: 2)
	let record = 0 as ValueId
	let index = 1 as ValueId

	let length = emitLoadField(module, block: entry, record: record, offset: StringLengthOffset, ids: ids)
	let outOfRange = emitIndexOutOfRange(module, block: entry, index: index, length: length, ids: ids)
	module.setTerminator(entry, op: StdOp.condBranch(outOfRange, thenBlockId: bad.id, elseBlockId: load.id))

	let buffer = emitLoadField(module, block: load, record: record, offset: StringBufferOffset, ids: ids)
	let byteValue = emitLoadByteIndexed(module, block: load, base: buffer, index: index, ids: ids)

	// The two exits, and the SUCCESS path differs with them: a throwing callee returns through the
	// dual-register `errorReturn` ABI, so its ok-path has a flag to clear that the plain one has no room for.
	if throwing 'throwsOnBadIndex'
		emitMemoryThrow(module, block: bad, flag: MemoryInvalidByteRangeFlag, ids: ids)
		emitOkReturn(module, block: load, value: byteValue, ids: ids)
	end 'throwsOnBadIndex' else 'abortsOnBadIndex'
		emitRuntimeAbort(module, func: func, block: bad, abort: RuntimeAbort.stringByteAtOutOfRange, ids: ids)
		module.setTerminator(load, op: StdOp.ret(byteValue))
	end 'abortsOnBadIndex'

	module.functions.push(func)
end 'buildStrByteRead'

// ⚠ **`buildStrSplit` WAS HERE, WITH THE FOUR EMITTERS IT WAS THE LAST CALLER OF** (W49 wave 5):
// `emitPushSliceSegment`, `emitSliceSegment`, `emitPushSegment` and `emitStrFindCall`. It filled a
// caller-created `Array with String` whose element size and `element_destroy@40` stamp the PARSER decided
// through `emitArrayCreateOp`; the corpus decides both through the ordinary generic-instance path and
// stamps them identically (measured — `Parser.stringSurfaceMemberNames` carries the emitted-code diff).
//
// ⚠ **TWO OF THE FOUR WERE `export`ED FOR CONSUMERS THAT HAD ALREADY GONE**, which is why they are named
// here rather than passed over: `emitSliceSegment`'s header claimed a THIRD consumer in `__strix_slice` and
// `emitStrFindCall`'s claimed one in `__strix_find`, both deleted with `StringIndexRuntime.maxon` at wave 4.
// An `export` outlives its last cross-file caller silently — nothing in this language reports one — so a
// retirement has to go looking for them by name.

// Store one constant byte at `dest[offset]`. The shape a fixed-text renderer (`__bool_to_string`) writes
// each of its bytes with — a `const` typed i64, stored as a `u8` (the store keeps the low byte).
function storeConstByte(module StdModule, block IrBlock, ids ValueMinter, dest ValueId, offset ByteOffset, charValue ParsedInt)
	let ch = ids.mint()
	module.appendOp(block, op: StdOp.const(ch, value: charValue, valueType: StdType.i64))
	module.appendOp(block, op: StdOp.storeIndirect(dest, offset: offset, valueId: ch, valueType: StdType.u8))
end 'storeConstByte'

// `threeI64Params` — `__str_copy(dest, src, len)`'s three-i64 signature — lives in `MmRuntime` next to
// `oneI64Param`/`twoI64Params`, shared with the Array runtime (see MmRuntime).

// `twoArgs` / `threeArgs` — the pair and triple call/branch-edge builders — live in `MmRuntime` next
// to `argsOf`, shared by every runtime builder (see MmRuntime).
