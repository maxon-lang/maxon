// SemanticCheck — the Maxon-tier program-validity pass. Runs AFTER resolveTypes,
// so it reads resolved types from the `funcReturnTypes` registry.
//
// THIN for M1: exactly the two `basics.md` checks —
//   E3001  no `main` function
//   E3002  `main` does not return ExitCode
// Both append a `Diagnostic` to `project.diagnostics`; the pipeline's error gate
// then stops the build before lowering an invalid module. The full semantic
// check set (unused bindings, type mismatches, exhaustiveness, ...) grows here
// per milestone.

// The entrypoint function's unqualified name — a contract shared with the parser
// (which keeps `main` unqualified) and the backend (whose entry stub calls it).
//
// ⚠ **EXPORTED SINCE N1c, because the parser now has to STATE the contract rather than merely keep it.**
// A free function whose bare name is declared in two directories is registered under its namespace-qualified
// spelling; `main` is the one exception, and the exclusion is written where the exclusion happens
// (`Parser.recordScannedSignature`) against this constant — not against a second `b"main"` that could drift
// from the name `checkMainFunction` looks the entry point up by.
export let MainFunctionName = b"main"

// The exact spec-gated diagnostic text (`specs-shv2/basics.md`). Named constants
// so the wire format lives in one place.
let NoMainMessage = "No 'main' function found"
let MainWrongReturnMessage = "Function 'main' must return ExitCode"

// Run the semantic checks over the resolved project + module. M1 checks `main`; M5
// adds per-call-site validation (the callee exists, the argument count matches, every
// `name:` label names a distinct parameter, and every argument's TYPE agrees with its
// parameter's) — the checks that need the callee's signature, which only the whole-program
// `funcSignatures` registry carries.
module function semanticCheck(project Project, module MaxonModule, signatures ProgramSignatures, funcNames FunctionNameIndex)
	// ⭐ **OVERLOAD RESOLUTION RUNS FIRST, BEFORE ANYTHING READS A CALLEE** (D7). Until it has run, a call to
	// an overloaded name carries the BARE name the source wrote, which is the registration name of the FIRST
	// declaration only — so `checkCalls` would validate every one of them against that member's signature and
	// `lowerMaxonToStd` would emit a call to it. It rewrites the ops in place, so every pass below (and the
	// whole backend) sees the member the call actually meant.
	resolveOverloadedCalls(project, module: module)
	checkMainFunction(project)
	checkMainCannotThrow(project, module: module)
	// E3113 — every `throws` clause in the program names a declared enum or union. It runs BEFORE the throws
	// map below, and before every check that reads one: `buildThrowsMap` and the catch-site decode both treat
	// a clause as an error TYPE, and a clause naming an interface (or nothing) is not one.
	checkThrowsClausesNameDeclaredErrors(project, module: module, signatures: signatures)
	// The whole-program throws map (name -> its `throws` clause, throwing functions only) — built once
	// from the merged module and read at every call site to decide whether a plain call needs a `try`
	// (E3057). The parser handled the mirror rule (E3055, `try` on a non-throwing call) at the `try` token.
	let throwsMap = buildThrowsMap(funcNames)
	// ⭐ **ONE CALL-GRAPH EDGE SET, THREE CLOSED-OVER FACTS.** Edge `k` says "function A passes its own
	// parameter p as the argument filling parameter q of function B" — which is the whole of what both
	// interprocedural summaries below propagate, differing only in their SEED. Built here rather than inside
	// either builder because a second walk over every call in the program, to derive the same relation, is the
	// duplication `buildParamMutationSummary`'s header refuses.
	let callEdges = collectCallParamEdges(project, module: module, funcIndexByName: funcNames.byName)
	let edgesByCallee = callEdges.byCallee(funcNames.functions.count())
	// The interprocedural closure-escape summary (P1.5-A2b-2, W58) — built once, read at every call site to
	// refuse a capturing closure passed to a callee that persists the parameter.
	let escapeSummary = buildEscapeSummary(module, funcNames: funcNames, funcSignatures: project.funcSignatures, edges: callEdges, byCallee: edgesByCallee)
	// The interprocedural PARAMETER-MUTATION summary (E3019, the call-site half) — built once, read at every
	// call site to refuse an immutable binding handed to a parameter the callee writes. It reads the same
	// index the two summaries above do; a duplicate function name was refused where that index was BUILT,
	// which is now before this pass runs at all (`PassPipeline.run`, A2l) rather than in the middle of it.
	// ⭐ **AND THE STORAGE COLUMN IS CLOSED OVER A WIDER SET** — the edges above plus the parser's
	// `StorageReachEdge`s, which say "the caller's parameter owns the ARRAY this call's receiver denotes".
	// Built off the same walk's result rather than by a second one, and IDENTICAL to it (same object) for a
	// program that recorded none. See `collectStorageReachEdges`.
	let storageEdges = collectStorageReachEdges(callEdges, module: module, funcSignatures: project.funcSignatures, funcIndexByName: funcNames.byName)
	let mutationSummary = buildParamMutationSummary(funcNames, edges: callEdges, byCallee: edgesByCallee, storageEdges: storageEdges)
	checkCalls(project, module: module, signatures: signatures, funcNames: funcNames, throwsMap: throwsMap, escapeSummary: escapeSummary, mutationSummary: mutationSummary)
	// The RETURN half of the interface-widening rule (P1.7a slice 2). After `checkCalls` so a program with
	// both a bad argument and a bad return reports the argument first, in the order the reader meets them.
	checkReturnedValueTypes(project, module: module)
	// The function-type doors the parser recorded (`PendingFunctionTypeDoor`). It runs HERE, and not beside
	// `checkValueMergeSignatures`, for one reason: the shapes are compared RESOLVED, and resolution has not
	// happened when that check drains. After `checkCalls` so a program with both a bad argument and a bad
	// cast reports the argument first, in the order the reader meets them.
	checkFunctionTypeDoors(project)
	// The container-`map` transforms the parser recorded (`PendingTransformArity`), beside the doors above
	// and for their reason: a function value's parameter list is whole-program, and a lifted closure's does
	// not reach the registry until merge.
	checkTransformArities(project)
	// E3064: the sites the parser recorded that used none of a call's result (`PendingDiscardedResult`),
	// judged against the whole-program effect summary built here. Beside the two drains above and after
	// `resolveOverloadedCalls`, whose rewrite is what makes a call op's `callee` the name the summary is
	// keyed by.
	checkDiscardedResults(project, module: module, funcNames: funcNames)
	// E3073 — a spawn whose callee can never suspend. Whole-program like the summary above it, and for the same
	// reason: whether `f` yields depends on what `f` calls, which is only knowable once every file has merged.
	checkAsyncYielding(project, module: module, funcNames: funcNames)
	// E3139 — two services that can await replies from each other. Whole-program for `checkAsyncYielding`'s
	// exact reason, and over the same closure: whether a message blocks on a service depends on what it
	// CALLS, which is only knowable once every file has merged. See `ServiceCallCycleCheck`.
	checkServiceCallCycles(project, module: module, signatures: signatures, funcNames: funcNames)
	// E3070: a collection mutated while an element borrowed out of it is still live. The facts are the
	// PARSER's (a binding exists nowhere else in shv2), and this is the first point that holds the
	// whole-program `mutationSummary` its call-argument half asks — which is why it runs here rather than in
	// a `CompilePhase` of its own. See `BorrowCheck.checkBorrowConflicts`.
	checkBorrowConflicts(project, module: module, mutationSummary: mutationSummary)
	// E3099 (P1.5, OPEN #73): the DERIVED capturing-closure use invariant. Runs AFTER `checkCalls` so a call
	// site the interprocedural check owns reports through that check's own, better-informed wording (it can
	// name the callee) — this pass then finds only what no call site explains.
	checkCapturingClosureUses(project, module: module)
	// E3100 (P1.5-B2a): a green thread awaited more than once on a single flow path.
	checkLinearAwait(project, module: module)
	// ⭐ **THE ONE REWRITE THIS PASS MAKES BESIDES `resolveOverloadedCalls`, AND IT IS LAST ON PURPOSE.**
	// A byte record handed to a parameter the callee WRITES — a `String` literal, or a MERGE whose edges
	// disagree about their provenance — is given one the write may land in (`LiteralArgPromotion`). It
	// reads the same `mutationSummary` the E3019 check above does — which is
	// why it lives here rather than in a pass of its own, where the whole-program fixpoint would have to
	// be rebuilt — and it runs after every check so that a program with a diagnostic is left exactly as
	// the checks found it.
	promoteArgsNeedingAWritableRecord(project, module: module, mutationSummary: mutationSummary)
end 'semanticCheck'

// ⭐⭐ **PICK THE OVERLOAD EACH CALL MEANT, AND REWRITE THE CALL TO NAME IT** (D7).
//
// **WHY IT IS HERE AND NOT IN THE PARSER, WHICH IS WHERE BOTH REFERENCE COMPILERS DO IT.** The bootstrap
// selects while parsing the call, before its arguments are even parsed, from a token PEEK that guesses each
// argument's type (`SelectOverloadByNamedArgs` / `PeekArgTypes`); v1 selects during type resolution off a
// `project.overloadedNames` bucket its parser filled. Neither is available here: shv2's parser writes only
// into a per-file artifact and learns about other files exclusively through the pre-parse DECLARATION SWEEP,
// which reads tokens and deliberately records NO parameter types — so at parse time there is no candidate
// list to score against. This pass is the first point that holds both halves: RESOLVED parameter types for
// every candidate (`resolveTypes` ran) and a real type for every argument (the parser's per-value columns).
//
// ⭐ That is not merely a forced move, it is a BETTER-INFORMED one. The `method-call-argument-*` family exists
// because the bootstrap's peek has to guess the type of `over(a.count())` from tokens, and its own doc admits
// a wrong guess "can rule the only correct overload incompatible"; here `a.count()`'s type is simply the tag
// the parser minted for that value. The nine cases the oracle needs a postfix-chain walker for are, in shv2,
// one array read.
//
// The SELECTION ORDER follows the bootstrap, which is canonical for `/specs`:
//   1. **candidates** — the set's members that survived to the registry at all (see `overloadCandidates`).
//   2. **labels + arity, together, through `slotCallArgs`** — the ONE label→position mapping in the compiler.
//      A candidate the call cannot be slotted against is out: that is the bootstrap's step 1 (every named
//      argument must name a parameter) and step 2 (the arity must match) asked as one question, by the
//      function that already owns the rule. Asking them separately would be a second copy of it.
//   3. **argument-type SCORE** — `ExactArgScore` for a tag-for-tag match, `WideningArgScore` for a legal
//      coercion, and INCOMPATIBLE (dropped) for anything `checkDeclaredType` refuses. Summed over the
//      arguments; the unique highest total wins. Same shape and same numbers as the oracle.
//   4. **a tie is E3007**, anchored at the call, listing the tied candidates in declaration order.
//   5. **no compatible candidate leaves the op ON THE FIRST MEMBER**, so `checkCalls` then reports its own
//      per-argument mismatch, which names the offending argument. "Ambiguous" would be the wrong sentence
//      for a call that matches nothing. For an ordinary set that is the op left ALONE — the bare name IS
//      the first member's registration name — and for a CONTESTED extension method, where no member holds
//      the bare name, it takes a rewrite: see `leaveUnmatchedCallOnFirstCandidate`.
//
// The two heuristics the bootstrap has after scoring — a first-argument token-shape test and an
// enclosing-type tie-break — are deliberately absent. The first exists to recover the type information its
// peek could not get (a `[` means a collection, a `'c'` means a Character); shv2 has the real type and needs
// no proxy for it. The second breaks ties between same-named methods of DIFFERENT types, which in shv2 are
// not one overload set at all — a method is registered `Type.method`, so `Box.contains` and `Bag.contains`
// never contend.
function resolveOverloadedCalls(project Project, module MaxonModule)
	// A program that declares no overload has nothing here to do and does not walk.
	//
	// ⚠⚠ **THAT GATE USED TO CARRY THE WHOLE COST ARGUMENT, AND IT NO LONGER CAN — `stdlib/FilePath.maxon`
	// OVERLOADS `join`, so EVERY compile now has a non-empty `overloadSets` and takes this walk** (BATCH2
	// slice 3; the measurement is at `maxonOpCalleeKind`, which was a per-op union box until this made it
	// linear in every program). The gate is kept because it is still exactly right for a compile that loads
	// no stdlib, but the walk below is now the common path and is written to cost nothing per op that is not
	// a call: `maxonOpCalleeKind` is a scalar enum, and the NAME — the only part that ever allocated — is
	// fetched for the two kinds that have one.
	if project.overloadSets.count() == 0 'noOverloadInThisProgram'
		return
	end 'noOverloadInThisProgram'

	// ONE column for the whole pass, re-keyed to each function and FILLED only by a call that actually has a
	// defaulted argument to re-point — see `DefaultArgOrigins`.
	var defaultArgOrigins = DefaultArgOrigins.create()
	// An INDEX loop, not `for … in`: the element is a BORROW of `module`, and the call below is
	// recorded as writing that same storage. ⚖ Ruling of 2026-08-26 — canonical note at
	// `IR/Std/ElimTrivialBlockArgs.elimTrivialBlockArgs`.
	for fnIndex in 0 upto module.functions.count() 'eachFunc'
		defaultArgOrigins.beginFunction()
		resolveOverloadedCallsInFunc(project, module: module, func: try module.functions.get(fnIndex) otherwise panic("resolveOverloadedCalls: fnIndex {fnIndex} is below module.functions.count()"), defaultArgOrigins: defaultArgOrigins)
	end 'eachFunc'
end 'resolveOverloadedCalls'

// One function's op walk. ⭐ **IT IS A FUNCTION SO THAT `func` IS A PARAMETER**, which is the same cure
// `Parser.conformanceRequiresMethod` records: an element read out of `module.functions` inline is a borrow
// of `module`, and BOTH calls below take `module` (or storage reached through `project`) mutably, so the
// element cannot be named more than once per statement without going live across one of them. Spelled
// inline this walk needed the same 130-character `try … get(fnIndex) otherwise panic(…)` THREE times, one
// per use — one fact, three copies, in a shape where a future edit to one of them reads as deliberate.
// A parameter carries no borrow of `module`, so each use is just `func`. It is also the shape the two Std
// passes already take (`foldConstOperandsInFunc`, `elimTrivialBlockArgsInFunc`).
function resolveOverloadedCallsInFunc(project Project, module MaxonModule, func IrFunction, defaultArgOrigins DefaultArgOrigins)
	for opIdx in module.liveOpIndices(func) 'eachOp'
		let op = try module.ops.get(opIdx) otherwise panic("resolveOverloadedCallsInFunc: opIdx {opIdx} from liveOpIndices is not in module.ops")
		// ⚠⚠ **THE `direct` ARM IS LAST, AND THE ORDER IS LOAD-BEARING — DO NOT SORT THESE.** An op
		// read out of `module.ops` is a BORROW of `module`, and resolving a direct call REPLACES that
		// element (`commitOverloadChoice`), which releases the very record `op` points into. A borrow's
		// liveness is its last use in SOURCE order, so any arm reading `op` BELOW the resolving one leaves
		// it live across that write — E3070, and a real use-after-free rather than a technicality. Putting
		// the only writing arm last is what ends the borrow before the write; the resolver re-reads the op
		// itself, which is why it is handed an INDEX and not the op.
		match maxonOpCalleeKind(op) 'callee'
			noCallee then break 'callee'
			functionValue then refuseOverloadedFunctionValue(project, func: func, opIndex: opIdx, name: maxonOpCalleeName(op))
			direct then resolveOneOverloadedCall(project, module: module, func: func, opIndex: opIdx, defaultArgOrigins: defaultArgOrigins)
		end 'callee'
	end 'eachOp'
end 'resolveOverloadedCallsInFunc'

// ⭐⭐ **WHICH OP DEFINES EACH VALUE OF THE FUNCTION BEING WALKED (W74)** — the one thing
// `repointDefaultedArgHelpers` needs and the op stream does not offer: a synthesized default argument is
// named to the call by its `ValueId`, and re-pointing it means rewriting the op that PRODUCED it.
//
// ⚠ **`Project.valueOrigins` ALREADY ANSWERS THIS AND MAY NOT BE USED FOR IT.** That table is
// whole-program and its `lookup` is a linear scan its own header calls THE COLD PATH — one diagnostic
// asks it, once. Asked once per re-pointed argument it would be O(program values) per call, which is a
// quadratic in a test file whose every assertion is an overloaded defaulted call. This is the same
// question asked per FUNCTION, off the walk that is happening anyway.
//
// ⚠ **AND IT IS FILLED LAZILY, so a program that re-points nothing pays nothing.** `beginFunction` only
// clears a flag; the two columns are built by the first lookup in a function, which happens only for a
// function containing a call that both resolved to an overload member and omitted a defaulted argument.
type DefaultArgOrigins
	// Do the columns below describe the function currently being walked? Cleared as each function is
	// entered, set by the fill.
	var filled as bool
	var definedAt as OpIndexArray
	var isDefined as BoolArray

	export static function create() returns DefaultArgOrigins
		return Self{filled: false, definedAt: OpIndexArray.create(), isDefined: BoolArray.create()}
	end 'create'

	export function beginFunction()
		self.filled = false
	end 'beginFunction'

	// The op that defined `value` in `func`. It PANICS for a value no op defines, because the one caller
	// asks only about a value `Parser.emitDefaultArgValue` synthesized — the result of a nullary helper
	// `call`, and of nothing else: `retypeOpaqueMethodResult` answers `asItStands` on an empty argument
	// list, so no reinterpretation is ever wrapped around it and the call's own result IS the argument.
	export function definingOp(module MaxonModule, func IrFunction, value ValueId) returns OpIndex
		if not self.filled 'theFirstAskInThisFunction'
			self.fill(module, func: func)
		end 'theFirstAskInThisFunction'

		if not (try self.isDefined.get(value) otherwise panic("DefaultArgOrigins.definingOp: value v{value} is past '{String.from(func.name)}'s own value count — every SSA value is minted through Parser.mintValue, which is what sizes this column")) 'noOpDefinesIt'
			panic("DefaultArgOrigins.definingOp: value v{value} of '{String.from(func.name)}' is defined by no live op — it was read back as a synthesized default ARGUMENT, which `Parser.emitDefaultArgValue` produces as a nullary call's result")
		end 'noOpDefinesIt'

		return try self.definedAt.get(value) otherwise panic("DefaultArgOrigins.definingOp: definedAt.get OOB at v{value} — the two columns are pushed in lockstep")
	end 'definingOp'

	function fill(module MaxonModule, func IrFunction)
		self.definedAt = OpIndexArray.create()
		self.isDefined = BoolArray.create()
		for _ in 0 upto func.valueTags.count() 'oneSlotPerValue'
			// Filler, never read: `isDefined` is what says whether the slot beside it means anything, so
			// this is the array's zero rather than a "no op" index anything could mistake for one.
			self.definedAt.push(0)
			self.isDefined.push(false)
		end 'oneSlotPerValue'

		for opIdx in module.liveOpIndices(func) 'eachOp'
			let op = try module.ops.get(opIdx) otherwise panic("DefaultArgOrigins.fill: opIdx {opIdx} from liveOpIndices is not in module.ops")
			match maxonOpResultValue(op) 'result'
				value(id) then self.record(id, at: opIdx, func: func)
				none then break 'result'
			end 'result'
		end 'eachOp'

		self.filled = true
	end 'fill'

	function record(value ValueId, at OpIndex, func IrFunction)
		try self.definedAt.set(value, value: at) otherwise panic("DefaultArgOrigins.record: op {at} of '{String.from(func.name)}' defines v{value}, which is past the function's own value count")
		try self.isDefined.set(value, value: true) otherwise panic("DefaultArgOrigins.record: isDefined.set OOB at v{value} — the two columns are pushed in lockstep")
	end 'record'
end 'DefaultArgOrigins'

// One call. A callee that names no overload set is left exactly as the parser wrote it, which is every call
// in the program but the handful this rung is about.
// ⚠ **IT TAKES AN INDEX AND READS THE OP ITSELF, AND EVERY DOOR BELOW THAT WRITES `module.ops` DOES
// THE SAME.** The rewrite this resolution ends in replaces the op at `opIndex`, releasing the record — so an
// op handed IN would leave its caller holding a released pointer, and an op held ACROSS the rewrite here
// would be read after free. The rule this pass now keeps, once: **no function both holds an op borrow and
// replaces that op.** E3070 is what named it, on this compiler's own source.
function resolveOneOverloadedCall(project Project, module MaxonModule, func IrFunction, opIndex OpIndex, defaultArgOrigins DefaultArgOrigins)
	let op = try module.ops.get(opIndex) otherwise panic("resolveOneOverloadedCall: ops.get({opIndex}) OOB — the index came from liveOpIndices")
	let callee = maxonOpCalleeName(op)
	let members = try project.overloadSets.get(callee) otherwise return
	let candidates = overloadCandidates(project, members: members)
	if candidates.count() > 1 and callPassesOpaqueArg(func, op: op) 'cannotDiscriminate'
		refuseOpaqueOverloadArgument(project, func: func, opIndex: opIndex, callee: callee)
		return
	end 'cannotDiscriminate'

	match selectOverload(project, func: func, op: op, candidates: candidates) 'pick'
		chosen(member) then bindOverloadChoice(project, module: module, func: func, opIndex: opIndex, callee: callee, member: member, defaultArgOrigins: defaultArgOrigins)
		// ⛔⛔ **AN AMBIGUOUS CALL IS *ALSO* LEFT ON A DECLARED MEMBER, AND UNTIL THIS RUNG IT WAS NOT —
		// WHICH EARNED THE AUTHOR A SECOND, WRONG DIAGNOSTIC.** A CONTESTED set has no member under the bare
		// name (`Parser.overloadRegistrationNameFor`), so an op left naming it reaches `validateCall` and is
		// reported **`E3004: call to undefined function 'f'`** — about a name declared twice over — under the
		// E3007 that has just explained the real fault. MEASURED on two root-level files each declaring
		// `f(a Integer = 1)` / `f(a Count = 1)`, two spellings of one underlying type: E3007 then E3004.
		// It is the same premise `noMatch` needed made true, so it takes the same repair.
		ambiguous(tied) then reportAmbiguousOverload(project, func: func, opIndex: opIndex, callee: callee, tied: tied, module: module, candidates: candidates)
		// Nothing the call could mean. Left on a DECLARED member deliberately — see this pass's header,
		// step 5, and `leaveUnmatchedCallOnFirstCandidate` for the one set where "left alone" is not that.
		noMatch then leaveUnmatchedCallOnFirstCandidate(project, module: module, opIndex: opIndex, callee: callee, candidates: candidates)
	end 'pick'
end 'resolveOneOverloadedCall'

// ⭐⭐ **STEP 5's PREMISE, MADE TRUE RATHER THAN ASSUMED (X-contains).** A call that fits no member is meant
// to reach `checkCalls` still naming a DECLARED function, so the diagnostic the author gets is the
// per-argument mismatch that names the offending argument. This pass got that for free while the bare name
// was always the first member's registration name — "leave the op alone" and "leave it on the first member"
// were the same act.
//
// ⛔ **THEY ARE NOT THE SAME ACT FOR A CONTESTED EXTENSION METHOD, WHERE NO MEMBER HOLDS THE BARE NAME.**
// Every declaration of a `<Conformer>.<method>` two files' extensions declare is registered under its
// parameter-type suffix (`Parser.overloadRegistrationNameFor`), so the bare callee names nothing in
// `funcSignatures` and the untouched op reached `validateCall` instead. MEASURED: `f.pick("nope")` against
// `pick(n Integer)` and `pick(flag bool)` split across two files reported
// **`E3004: call to undefined function 'Five.pick'`** — about a method declared twice over — where the
// identical program with both extensions in ONE file reports
// `E3005: argument type mismatch for 'n': expected 'Integer', got 'String'`.
//
// So the op is pointed at the first candidate, which is exactly where the same-file case already leaves it.
// ONLY the callee is rewritten: no result-type reconcile and no range-site retarget, because neither
// happens on the same-file path either and this is a program that is being rejected — the sole job left is
// to let `checkCalls` say which argument.
//
// ⚠ **TWO CALLERS, AND THE SECOND ONE HAS THE SAME NEED FOR A DIFFERENT REASON.** `noMatch` needs it so
// `checkCalls` can name the offending ARGUMENT; `ambiguous` needs it so `validateCall` does not report the
// bare name as UNDEFINED under the E3007 that has already said what is wrong. Both are programs being
// rejected, and in both the only remaining job of the callee field is to not name something that is not
// there.
//
// A set with NO live candidate is left alone, and there the bare name is the honest answer: nothing the
// call could name survived to the registry.
function leaveUnmatchedCallOnFirstCandidate(project Project, module MaxonModule, opIndex OpIndex, callee ByteArray, candidates ByteArrayArray)
	if project.funcSignatures.contains(callee) 'theBareNameIsItselfAMember'
		return
	end 'theBareNameIsItselfAMember'

	let first = try candidates.get(0) otherwise return
	// The replacement is BUILT before the store, so the op borrow is dead by the time the element it points
	// into is released — see `resolveOneOverloadedCall`'s header for the rule.
	let op = try module.ops.get(opIndex) otherwise panic("leaveUnmatchedCallOnFirstCandidate: ops.get({opIndex}) OOB — the index came from liveOpIndices")
	let rewritten = withRewrittenCallee(op, callee: first)
	try module.ops.set(opIndex, value: rewritten) otherwise panic("leaveUnmatchedCallOnFirstCandidate: ops.set({opIndex}) OOB — the index came from liveOpIndices")
end 'leaveUnmatchedCallOnFirstCandidate'

// ⭐⭐ **AN OPAQUE ARGUMENT CANNOT DISCRIMINATE, AND "CANNOT DISCRIMINATE" IS NOT "IS A SCALAR".**
//
// A `typeParameter` value is a generic's `T` that `retypeOpaqueMethodResult` could not make concrete — which
// it declines to do exactly when the concrete type is MANAGED, because the drop decision the tag governs is
// already emitted. An `unresolved` value is the same shape by deferral. Neither NAMES an aggregate, and that
// is the trap: `aggregateNameFor` answers EMPTY for both, `namedAggregatesConflict` reads empty as "a
// scalar", and the candidate with a SCALAR parameter therefore matched while the candidate with the
// genuinely correct AGGREGATE parameter was refused for disagreeing with it. The answer inverted.
//
// MEASURED, on a `Box with Shape` for a boxed union `Shape`, `over(x Shape)` beside `over(x Integer)`:
// `over(b.get())` selected the `Integer` member and did arithmetic on the payload word — exit 25 where 7 was
// correct, and it stayed exit 25 once the scalar-vs-aggregate quadrant was closed, because an opaque
// argument is not an aggregate at either end.
//
// So a set of two or more candidates and an argument nothing can identify is REFUSED. It cannot be a
// selection (there is no fact to select on) and it must not be a silent one: `noMatch` would leave the bare
// name, which is the FIRST member's registration name, so whichever overload happened to be written first
// would take the call. A single candidate needs no discrimination and is left alone.
function refuseOpaqueOverloadArgument(project Project, func IrFunction, opIndex OpIndex, callee ByteArray)
	let range = project.opRanges.get(opIndex)
	reportPositioned(project, code: ErrorCode.parserUnsupportedFeature, message: "resolving an overload of '{bareMethodName(callee)}' against an argument of opaque generic type — the value is a type parameter whose concrete type is managed, so its type is not known at the call and no overload can be picked by it. Bind the argument to a concretely-typed local first, or give the overloads distinct names", line: range.line, column: range.column, filePath: func.sourceFilePath)
end 'refuseOpaqueOverloadArgument'

// Does this call supply an argument whose type nothing can identify? See `refuseOpaqueOverloadArgument`.
function callPassesOpaqueArg(func IrFunction, op MaxonOp) returns bool
	match overloadCallArgs(op) 'args'
		supplied(args, _, _) then return valueTagsIncludeOpaque(func, args: args)
	end 'args'
end 'callPassesOpaqueArg'

function valueTagsIncludeOpaque(func IrFunction, args ValueIdArray) returns bool
	for argId in args 'each'
		let tag = try func.valueTags.get(argId) otherwise panic("valueTagsIncludeOpaque: value v{argId} of '{String.from(func.name)}' has no recorded type — every SSA value is minted through Parser.mintValue")
		if tag == ValueTypeTag.typeParameter or tag == ValueTypeTag.unresolved 'opaque'
			return true
		end 'opaque'
	end 'each'
	return false
end 'valueTagsIncludeOpaque'

// ⭐ **A FUNCTION VALUE OF AN OVERLOADED NAME HAS NO ARGUMENTS TO PICK BY, so it is REFUSED rather than bound
// to whichever member happens to have registered first.** `let f = process` names a set, not a function, and
// the first member's registration name IS the bare name — so without this the value would silently take one
// overload's body and one overload's signature, and every indirect call through it would be checked against
// them. Neither reference compiler diagnoses this (v1's `firstOverloadVariant` picks member 0 on purpose);
// shv2 has no way to be right, so it says so.
function refuseOverloadedFunctionValue(project Project, func IrFunction, opIndex OpIndex, name ByteArray)
	if not project.overloadSets.contains(name) 'notOverloaded'
		return
	end 'notOverloaded'

	let range = project.opRanges.get(opIndex)
	reportPositioned(project, code: ErrorCode.parserUnsupportedFeature, message: "taking a function value of the overloaded name '{String.from(name)}' — a function value carries no arguments, so there is nothing to pick an overload by. Give the overloads distinct names, or call it directly", line: range.line, column: range.column, filePath: func.sourceFilePath)
end 'refuseOverloadedFunctionValue'

// The members of a set that are actually in the signature registry, in declaration order. A member absent
// from it is one left behind by a previous fold of a project whose sources have since changed (see
// `OverloadSetMap`, which is deliberately not reset); skipping it is what makes that staleness inert.
//
// Exported for `ConformanceCheck.checkOverloadedMembers` (R10), which asks the SAME map the same question a
// call site does — the two differ in what they then match a candidate AGAINST (arguments vs a requirement's
// signature), never in what the candidate list is, and a second walk of `overloadSets` would be free to
// treat a stale member as live in one reader and not the other.
export function overloadCandidates(project Project, members ByteArrayArray) returns ByteArrayArray
	var candidates = ByteArrayArray.create()
	for member in members 'each'
		if project.funcSignatures.contains(member) 'live'
			candidates.push(member)
		end 'live'
	end 'each'
	return candidates
end 'overloadCandidates'

// The outcome of scoring a call against an overload set's candidates. `ambiguous` carries the TIED candidates
// (not all of them) because that is what the diagnostic lists — the ones the call genuinely cannot choose
// between, which is the set the oracle prints too.
union OverloadPick
	chosen(member ByteArray)
	ambiguous(tied ByteArrayArray)
	noMatch
end 'OverloadPick'

// A candidate scores `ExactArgScore` per argument whose tag matches its parameter's exactly and
// `WideningArgScore` per argument that merely coerces legally (an int at a `float`, an int at an `ExitCode`).
// The numbers only have to ORDER the candidates, and these are the oracle's own.
//
// ⭐⭐ **EXPORTED BECAUSE A SECOND DECIDER RANKS BY THEM, AND MUST RANK THE SAME WAY.**
// `Parser.overloadedCallResultType` picks a member at PARSE time, for its return type alone, from what the
// token sweep publishes — and the member it picks has to be the one this pass will pick a whole pass later,
// or the program earns `reportOverloadReturnDisagreement` for a call it got right. The two cannot share a
// scoring FUNCTION (one reads swept types, the other the merged registry), so they share the ORDER: the same
// two numbers, the same "unique highest total wins", the same "nothing fits" floor.
export let ExactArgScore = 2 as OverloadArgScore
export let WideningArgScore = 1 as OverloadArgScore

// Wide enough for `ExactArgScore` at every parameter of the widest signature the ABI admits.
export typealias OverloadArgScore = int(0 to 128)

typealias OverloadArgScoreArray = Array with OverloadArgScore

// Score every candidate and answer which one the call meant. ONE scoring pass, holding the scores.
//
// ⚠ It scored every candidate TWICE — once to find the best total, once to ask who held it — on the stated
// grounds that keeping an array of scores was the more expensive arrangement. It is the cheaper one: scoring
// a candidate runs `slotCallArgs`, which ALLOCATES the slotted argument list, so the second sweep re-paid
// that allocation for every candidate to avoid one array of small integers. Scoring is also the only part
// of this pass that touches the signature registry and the type rules, so doubling it doubled the actual
// work — and the two sweeps had to be kept answering identically by hand, one `overloadCandidateScore` call
// spelled in two places, which is the shape this compiler keeps getting bitten by.
//
// `incompatible` folds to `NoCompatibleOverloadScore`, which needs no second flag and is not a sentinel: a
// candidate that FITS always scores at least `WideningArgScore` (a zero-argument candidate is floored there
// by `overloadArgTypeFit`), so zero is unreachable for a fitting candidate and `best` staying zero means
// nothing fitted.
function selectOverload(project Project, func IrFunction, op MaxonOp, candidates ByteArrayArray) returns OverloadPick
	var scores = OverloadArgScoreArray.create()
	var best = NoCompatibleOverloadScore
	for candidate in candidates 'eachCandidate'
		let score = match overloadCandidateScore(project, func: func, op: op, candidate: candidate) 'fit'
			fits(fitScore) gives fitScore
			incompatible gives NoCompatibleOverloadScore
		end 'fit'
		scores.push(score)
		best = overloadBetterScore(best, candidate: score)
	end 'eachCandidate'

	if best == NoCompatibleOverloadScore 'nothingFits'
		return OverloadPick.noMatch
	end 'nothingFits'

	var tied = ByteArrayArray.create()
	for i in 0 upto candidates.count() 'eachWinner'
		let score = try scores.get(i) otherwise panic("selectOverload: scores.get OOB at {i} — one score was pushed per candidate")
		if score == best 'winner'
			tied.push(try candidates.get(i) otherwise panic("selectOverload: candidates.get OOB at {i} inside its own count()"))
		end 'winner'
	end 'eachWinner'

	if tied.count() == 1 'unique'
		return OverloadPick.chosen(try tied.get(0) otherwise panic("selectOverload: tied.count() == 1 but get(0) failed"))
	end 'unique'
	return OverloadPick.ambiguous(tied)
end 'selectOverload'

// A score no candidate can reach, so "did anything fit?" needs no second flag. It is not a sentinel RETURN:
// nothing outside `selectOverload` sees it, and the answer it produces is a union arm.
export let NoCompatibleOverloadScore = 0 as OverloadArgScore

function overloadBetterScore(best OverloadArgScore, candidate OverloadArgScore) returns OverloadArgScore
	return candidate if candidate > best else best
end 'overloadBetterScore'

union OverloadFit
	fits(score OverloadArgScore)
	incompatible
end 'OverloadFit'

// One candidate's fit. The call's arguments are slotted to the candidate's parameters through the shared
// `slotCallArgs` — which is simultaneously the label test and the arity test — and then each slotted argument
// is measured against its parameter by the SAME coercion rule `checkOneArgType` reports against, so a
// candidate this function accepts cannot then be rejected by the argument check downstream.
//
// ⚠ **AND THE PROMISE HAS TO HOLD IN THE OTHER DIRECTION TOO, WHICH IS WHERE IT WAS BROKEN (W58).** A
// candidate this function REFUSES that `checkArgTypes` would have accepted is not a harmless extra strictness:
// with no candidate fitting, `leaveUnmatchedCallOnFirstCandidate` points the call at the FIRST member and the
// program is refused against a signature it was never written against. The `result` is threaded down for
// exactly that reason — see `overloadArgTypeFit`'s own header.
function overloadCandidateScore(project Project, func IrFunction, op MaxonOp, candidate ByteArray) returns OverloadFit
	let sig = try project.funcSignatures.get(candidate) otherwise panic("overloadCandidateScore: candidate '{String.from(candidate)}' is not in funcSignatures — `overloadCandidates` filtered on exactly that")
	let result = match maxonOpResultValue(op) 'result'
		value(id) gives id
		none panic("overloadCandidateScore: asked of an op that defines no value — `maxonOpCalleeKind` answers `direct` only for the three CALL ops, and every one of them defines its result")
	end 'result'
	match overloadCallArgs(op) 'args'
		supplied(args, argLabels, defaultSlots) then return overloadSlottedFit(project, func: func, sig: sig, result: result, args: args, argLabels: argLabels, defaultSlots: defaultSlots)
		default panic("overloadCandidateScore: asked of an op that supplies no argument list — `maxonOpCalleeKind` answers `direct` for exactly the three ops `overloadCallArgs` covers")
	end 'args'
end 'overloadCandidateScore'

function overloadSlottedFit(project Project, func IrFunction, sig FuncSignature, result ValueId, args ValueIdArray, argLabels ByteArrayArray, defaultSlots ParamCountArray) returns OverloadFit
	match slotCallArgs(sig.paramNames, args: args, argLabels: argLabels, argDefaultSlots: defaultSlots) 'slot'
		ordered(argIds) then return overloadArgTypeFit(project, func: func, sig: sig, result: result, argIds: argIds)
		// An arity mismatch, a label naming no parameter, or two arguments at one parameter: this candidate is
		// not what the call was written against.
		arityMismatch to duplicateArg then return OverloadFit.incompatible
	end 'slot'
end 'overloadSlottedFit'

// ⛔⛔ **IT JUDGES EACH PARAMETER THROUGH THE CALL'S INSTANCE, AND UNTIL W58 IT DID NOT — WHICH MADE EVERY
// OVERLOAD SET ON A GENERIC TYPE'S EXTENSION UNRESOLVABLE.** `checkArgTypes` resolves a parameter's
// declaration-view type against the instance the call is actually made at (`paramTypeThroughCallInstance`,
// W25) precisely because a shared generic body spells `__self` at the base `Array with <T>`. This scorer read
// the raw signature instead, so the RECEIVER of `a.sort(cmp)` on an `Array with Integer` was compared
// nominally against `Array_T<gid>` and every candidate scored `incompatible`. MEASURED against
// `stdlib/Array.maxon` listed: **`E3036: 'Array.sort' expects 1 argument(s) but 2 were provided`** — the
// arity of the OTHER overload, reported because nothing fit and the call fell back to the first member. It was
// order-dependent and silent: swapping the two `extension Array` blocks moved the error to
// `expects 2 argument(s) but 1 were provided`.
//
// So the subject is read HERE the same way `checkArgTypes` reads it — one `callInstanceSubject` per candidate,
// off that candidate's own signature, because whether the receiver IS the subject depends on
// `sig.takesReceiver()` and the candidates of one set need not agree about that.
function overloadArgTypeFit(project Project, func IrFunction, sig FuncSignature, result ValueId, argIds ValueIdArray) returns OverloadFit
	let instanceSubject = callInstanceSubject(sig, result: result, argIds: argIds)
	var score = NoCompatibleOverloadScore
	for i in 0 upto argIds.count() 'eachArg'
		let argId = try argIds.get(i) otherwise panic("overloadArgTypeFit: argIds.get OOB at {i} inside its own count()")
		let paramType = paramTypeThroughCallInstance(project, func: func, subject: instanceSubject, paramType: try sig.paramTypes.get(i) otherwise panic("overloadArgTypeFit: paramTypes.get OOB at {i} — `slotCallArgs` answered `ordered`, so the counts agree"))
		let argTag = try func.valueTags.get(argId) otherwise panic("overloadArgTypeFit: value v{argId} of '{String.from(func.name)}' has no recorded type — every SSA value is minted through Parser.mintValue")
		let paramTag = maxonTypeTag(paramType)
		if checkDeclaredType(argTag, declared: paramTag) != DeclaredTypeMatch.ok 'refused'
			return OverloadFit.incompatible
		end 'refused'

		// ⭐ TWO DIFFERENT AGGREGATES SHARE ONE TAG — two structs are both `structRef`, two boxed unions both
		// erased to `integer` — so the verdict above accepts `over(aBag)` at an `over(x Box)`. Identity is the
		// interned NAME, and it is the same rule `checkOneArgType` applies at the same pair, asked here so a
		// candidate is not selected on a tag agreement its own argument check will refuse.
		var expected = aggregateNameFor(project, tag: paramTag, nameId: typeNameIdOf(paramType), readerFilePath: func.sourceFilePath)
		if expected.isEmpty() 'erasedUnionParam'
			expected = try sig.paramAggregateNames.get(i) otherwise panic("overloadArgTypeFit: paramAggregateNames.get OOB at {i} — a signature's param columns are built in lockstep")
		end 'erasedUnionParam'
		// ⚠ Ungated on the declared side for the reason `checkOneArgType` is: a SCALAR parameter meeting an
		// AGGREGATE argument is a real conflict, and skipping it here is what let this resolver SELECT an
		// `over(x Integer)` for a boxed-union argument (measured: exit 25 from arithmetic on the payload
		// word). Asking the same question the argument check asks is also what makes this function's own
		// promise true — that a candidate it accepts cannot then be rejected downstream.
		let argNameId = try func.valueNameIds.get(argId) otherwise panic("overloadArgTypeFit: value v{argId} of '{String.from(func.name)}' has no recorded type name — the two type columns are minted in lockstep")
		if not expected.isEmpty() or (tagAdmitsNoAggregate(paramTag) and argAggregateCannotDecay(project, tag: argTag, nameId: argNameId)) 'aggregateComparable'
			// ⚠ **`aggregatesConflict`, NOT the bare rule** — the shared door carries the byte-element
			// boundary (`byteBufferBoundaryAdmits`), and this function's own promise is that a candidate it
			// accepts cannot then be rejected downstream. Spelled with the bare rule it answered
			// `incompatible` for a `__ManagedMemory` parameter meeting a compiler-synthesized byte buffer,
			// which `checkOneArgType` accepts — the two answers `checkOneArgType`'s header forbids.
			//
			// ⛔ **AND IT IS OBSERVABLE, WHICH THIS SITE WAS FILED AS NOT BEING (N2b review).** The filing
			// argued that a candidate wrongly refused here is refused a second time by every sibling and the
			// call resolves anyway. It does not: with NO candidate fitting, `selectOverload`'s caller falls
			// back to the FIRST declared overload and reports against ITS parameter. MEASURED —
			// `which(x Ints)` declared ahead of `which(m __ManagedMemory)`, called with a cwd buffer, read
			// `expected 'Array_Integer', got 'Array___ManagedByte'`, naming a parameter the call was never
			// written against. Pinned by `bytearray-element-size.md`'s
			// `overload-scoring-admits-a-synthesized-buffer-at-a-byte-buffer-candidate`.
			if programSignaturesIn(project, asker: "overloadArgTypeFit").aggregatesConflict(expected, expectedTag: paramTag, expectedNameId: typeNameIdOf(paramType), got: aggregateNameFor(project, tag: argTag, nameId: argNameId, readerFilePath: func.sourceFilePath), gotTag: argTag, gotNameId: argNameId) 'aggregateMismatch'
				return OverloadFit.incompatible
			end 'aggregateMismatch'
		end 'aggregateComparable'

		score = score + (ExactArgScore if argTag == paramTag else WideningArgScore)
	end 'eachArg'

	// A ZERO-ARGUMENT candidate scored nothing, and it still FITS — `Counter.create()` beside
	// `Counter.create(value Integer)` is a legitimate arity-only pair, and the arity test that separated them
	// already ran. It reaches `WideningArgScore` rather than the "nothing fits" floor so the answer stays a
	// score the caller can compare.
	return OverloadFit.fits(score if score > NoCompatibleOverloadScore else WideningArgScore)
end 'overloadArgTypeFit'

// ⭐⭐ **A CONSTANT ARGUMENT'S RANGE IS CHECKED AGAINST A CALLEE'S DECLARED PARAMETER ALIAS, AND THAT SITE WAS
// RECORDED PER NAME AT PARSE TIME (P1.9) — so it has to be RETARGETED when the call resolves elsewhere.**
//
// `Parser.recordConstantArgRangeChecks` files a `RangeCheckArgSite` carrying the callee NAME the source wrote;
// `InsertRangeChecks` then reads that callee's `paramSites` to decide whether the constant fits. When the
// call resolves to a member registered under a MANGLED name, a site left naming the bare one aims the check at
// the FIRST declaration's parameter list. MEASURED before this retarget existed, with `Small = int(0 to 10)`
// and `f(x String)` declared first:
//
//     function f(x String) returns ExitCode … end 'f'
//     function f(x Small)  returns ExitCode … end 'f'
//     return f(99)          ⇒ compiled, exit 99
//
// while the identical program with only the `Small` overload is correctly `E3005: Value 99 is outside the
// range of 'Small'`. A silent wrong answer, reachable only through this rung.
//
// ⚠ **A SITE IS KEYED BY ITS ARGUMENT'S `ValueId`, NOT BY ITS CALL**, so the retarget matches on that value
// being one of THIS call's arguments — exact for every program in which a value reaches one call, which is
// every program where the argument is a literal (each literal mints its own value). The one shape it cannot
// separate is a BINDING passed to two calls of the same bare name that resolve to DIFFERENT members: the two
// sites are then indistinguishable, so the second claim is refused rather than allowed to overwrite the
// first. The cure for that residual is to key the site by its call's op index, which is a change to the P1.9
// record and its pass, not to this one.
function bindOverloadChoice(project Project, module MaxonModule, func IrFunction, opIndex OpIndex, callee ByteArray, member ByteArray, defaultArgOrigins DefaultArgOrigins)
	// ⛔⛔ **THE ARGUMENT COLUMNS ARE READ OFF THE OP BEFORE THE COMMIT, AND THEY USED TO BE READ AFTER IT —
	// A USE-AFTER-FREE.** `commitOverloadChoice` stores a rewritten op at this index, which RELEASES the
	// record `overloadCallArgs` reads its `args`/`defaultSlots` columns out of. It survived because a freed
	// box still holds its bytes; E3070 refused the shape when shv2 compiled itself, and reading the op first
	// is the fix rather than a rearrangement. The commit is now the LAST thing this function does, which is
	// also what keeps the borrow dead at the write.
	let op = try module.ops.get(opIndex) otherwise panic("bindOverloadChoice: ops.get({opIndex}) OOB — the index came from liveOpIndices")
	match overloadCallArgs(op) 'args'
		supplied(args, _, defaultSlots) then bindOverloadChoiceArguments(project, module: module, func: func, opIndex: opIndex, callee: callee, member: member, args: args, defaultSlots: defaultSlots, origins: defaultArgOrigins)
	end 'args'
	commitOverloadChoice(project, module: module, func: func, opIndex: opIndex, member: member, disagreement: sharedCallResultSubject)
end 'bindOverloadChoice'

// The two obligations a resolved call's ARGUMENT LIST carries, off ONE destructure of the op — the
// constant-argument range sites this header describes, and the defaulted arguments W74 added. They share the
// destructure because a `match` binding does not outlive the arm that binds it, so two askers of
// `overloadCallArgs` would be two spellings of "what did this call pass".
//
// ⚠ **THE DEFAULT RE-POINT RUNS BEFORE THE `member == callee` RETURN, and the range retarget after it.** They
// gate differently because they are asked of different things: a range SITE names the callee, so a member
// that kept the bare name has nothing to move — while a defaulted argument's TYPE was read off a by-name
// registry that is LAST-WINS over the whole set, so that member's argument may still be tagged as another
// member's and owes the same reconcile every other member owes.
function bindOverloadChoiceArguments(project Project, module MaxonModule, func IrFunction, opIndex OpIndex, callee ByteArray, member ByteArray, args ValueIdArray, defaultSlots ParamCountArray, origins DefaultArgOrigins)
	repointDefaultedArgHelpers(project, module: module, func: func, callee: callee, member: member, args: args, defaultSlots: defaultSlots, origins: origins)
	if member.equals(callee) 'firstMemberKeptTheBareName'
		return
	end 'firstMemberKeptTheBareName'

	retargetArgRangeSites(project, func: func, opIndex: opIndex, callee: callee, member: member, args: args)
end 'bindOverloadChoiceArguments'

// Point every constant-argument range-check site this call owns at the member it resolved to. A function with
// no such site files no entry at all (`Parser.commitRangeChecks`), which is the common case and costs one
// lookup.
function retargetArgRangeSites(project Project, func IrFunction, opIndex OpIndex, callee ByteArray, member ByteArray, args ValueIdArray)
	let checks = try project.rangeChecks.get(func.name) otherwise return
	// Index-based, so `site` is a mutable binding: the retarget writes the record's own `callee` field, and a
	// `for x in …` loop variable is immutable.
	for i in 0 upto checks.argSites.count() 'eachSite'
		var site = try checks.argSites.get(i) otherwise panic("retargetArgRangeSites: argSites.get OOB at {i} inside its own count()")
		// ⭐ **A SITE OF A DIFFERENT CALL IS NOT THIS ONE'S TO CLAIM OR TO COMPLAIN ABOUT.** The match below
		// is by argument VALUE, which a binding passed to two calls shares — so without this the second call
		// reads the first's already-retargeted site as claimed by a foreign member. `bareCallee` is the name
		// the source wrote and is never rewritten; see `RangeCheckArgSite` for the twenty refusals it fixes.
		if not site.bareCallee.equals(callee) 'aSiteOfADifferentCall'
			continue
		end 'aSiteOfADifferentCall'

		if not valueIdArrayContains(args, value: site.value) 'notThisCall'
			continue
		end 'notThisCall'

		if site.callee.equals(callee) 'stillBare'
			site.callee = member
			continue
		end 'stillBare'

		// Already claimed — by this same member (a second argument of one call, or a re-run of this pass over
		// the memoized module) or, the residual the header names, by a DIFFERENT member.
		if not site.callee.equals(member) 'claimedByAnotherMember'
			let range = project.opRanges.get(opIndex)
			reportPositioned(project, code: ErrorCode.parserUnsupportedFeature, message: "two calls to different overloads of '{String.from(callee)}' pass the SAME binding as a constant argument whose range must be checked against the callee's declared parameter type. That check is recorded against the argument's value, before any overload is known, so the two calls cannot be told apart and one would be checked against the other's parameters. Bind the argument separately for each call, or give the overloads distinct names", line: range.line, column: range.column, filePath: func.sourceFilePath)
		end 'claimedByAnotherMember'
	end 'eachSite'
end 'retargetArgRangeSites'

// Is `value` one of these ids? A linear scan over an argument list, which is tiny — and asked only for a call
// that resolved to a mangled overload member in a function that has a range-check site at all.
function valueIdArrayContains(values ValueIdArray, value ValueId) returns bool
	for candidate in values 'each'
		if candidate == value 'found'
			return true
		end 'found'
	end 'each'
	return false
end 'valueIdArrayContains'

// ⭐⭐ **SUPPLY THE RESOLVED MEMBER'S OWN PARAMETER DEFAULT, IN PLACE OF THE ONE THE PARSE COULD ONLY GUESS
// (W74).**
//
// A short call is FILLED while it is parsed, from a registry keyed by the name the source wrote — so every
// member of an overload set publishes one entry and one synthesized helper name, and the fill emits a call to
// it. That is sound for everything the members must agree on (`SignatureIndex.ParamDefaultInfo.matches` lists
// exactly what, and `Parser.captureParamDefault` refuses a set that does not), and it leaves precisely one
// thing still owed: the default's own EXPRESSION, which is a function BODY and belongs to one member.
//
// So each member emits its helper under its own REGISTRATION name (`Parser.declaredParamDefaultHelperName`),
// and this re-points the emitted call the moment the member is known. It is the same move
// `commitOverloadChoice` makes for the call itself, one op earlier in the block — including the RESULT-TYPE
// reconcile, which is owed for the same reason: the argument's tag was minted from
// `ProgramSignatures.returnTypeOf`, whose entry for the shared helper name is last-wins across the set. A
// member whose defaulted parameter is declared at a different type therefore hands the call a value tagged
// as another member's, and where the two live in different REGISTER FILES that is a wrong answer rather than
// a wrong diagnostic — which is exactly the quadrant `reconcileOverloadResultType` refuses.
//
// A CALLER-LOCATION slot is skipped: nothing was synthesized for it, and the constant the fill emitted is
// the caller's own line or path — the same value whichever member wins.
function repointDefaultedArgHelpers(project Project, module MaxonModule, func IrFunction, callee ByteArray, member ByteArray, args ValueIdArray, defaultSlots ParamCountArray, origins DefaultArgOrigins)
	if defaultSlots.count() == 0 'thisCallOmittedNothingTheCalleeDefaults'
		return
	end 'thisCallOmittedNothingTheCalleeDefaults'

	let shape = match programSignaturesIn(project, asker: "repointDefaultedArgHelpers").defaultsOf(callee) 'defaults'
		defaults(info) gives info
		allRequired panic("repointDefaultedArgHelpers: a call to '{String.from(callee)}' carries {defaultSlots.count()} synthesized default argument(s) and the declaration sweep publishes no defaults for that name — `Parser.fillOmittedArgDefaults` reads the same registry to decide what to fill")
	end 'defaults'

	// The synthesized arguments are the TRAILING run, in `argDefaultSlots` order — `MaxonOp.call`'s contract.
	let sourceCount = args.count() - defaultSlots.count()
	for k in 0 upto defaultSlots.count() 'eachSuppliedDefault'
		let slot = try defaultSlots.get(k) otherwise panic("repointDefaultedArgHelpers: defaultSlots.get OOB at {k} inside its own count()")
		match shape.producerFor(slot) 'produces'
			required to callerFile then continue
			helper then break 'produces'
		end 'produces'

		let argValue = try args.get(sourceCount + k) otherwise panic("repointDefaultedArgHelpers: args.get OOB at {sourceCount + k} — the synthesized defaults are the trailing run of args")
		let helperOpIndex = origins.definingOp(module, func: func, value: argValue)
		commitOverloadChoice(project, module: module, func: func, opIndex: helperOpIndex, member: paramDefaultHelperName(member, paramIndex: slot), disagreement: OverloadDisagreementSubject.aDefaultedArgument(callee, slot: slot))
	end 'eachSuppliedDefault'
end 'repointDefaultedArgHelpers'

// Bind the call to the member it chose: rewrite the op's callee IN PLACE, at the same `module.ops` index —
// `block.opRefs` indexes that array, so appending a replacement instead would orphan every reference to it —
// and then reconcile the RESULT's type.
//
// `disagreement` names what the reconcile is ABOUT, because this routine now serves two ops of one call: the
// call itself, and the synthesized helper behind an argument it omitted. The two need one rule and two
// sentences — see `OverloadDisagreementSubject`.
// ⛔⛔ **THE RECONCILE READS THE PRE-REWRITE OP AND USED TO RUN AFTER THE STORE THAT RELEASES IT.** Same
// use-after-free as `bindOverloadChoice`'s, one frame down: `module.ops.set` drops the old element, and
// `reconcileOverloadResultType`'s `overloadResultValue(op)` then read a released record. The op is read
// here rather than handed in for the reason `resolveOneOverloadedCall`'s header states.
function commitOverloadChoice(project Project, module MaxonModule, func IrFunction, opIndex OpIndex, member ByteArray, disagreement OverloadDisagreementSubject)
	let op = try module.ops.get(opIndex) otherwise panic("commitOverloadChoice: ops.get({opIndex}) OOB — the index came from liveOpIndices")
	let rewritten = withRewrittenCallee(op, callee: member)
	reconcileOverloadResultType(project, func: func, opIndex: opIndex, op: op, member: member, disagreement: disagreement)
	try module.ops.set(opIndex, value: rewritten) otherwise panic("commitOverloadChoice: ops.set({opIndex}) OOB — the index came from liveOpIndices")
end 'commitOverloadChoice'

// ⭐ **WHICH VALUE OF A RESOLVED CALL THE RETURN-TYPE RECONCILE IS ABOUT** — the call's own result, or the
// nullary helper standing behind an argument the call omitted (W74). One RULE (`reconcileOverloadResultType`)
// and two sentences: the second names a parameter position rather than a return type, and a reader handed the
// first about a symbol no source wrote — `__paramDefault#Expect.equal#2` — would be reading about a name
// they cannot find and a construct they did not write.
union OverloadDisagreementSubject
	theCallsResult
	aDefaultedArgument(callee ByteArray, slot ParamCount)
end 'OverloadDisagreementSubject'

// The `theCallsResult` answer, shared: a payload-free union case is still a heap object in Maxon, and
// `commitOverloadChoice` runs at every resolved overloaded call in the program.
let sharedCallResultSubject = OverloadDisagreementSubject.theCallsResult

// ⭐⭐ **THE ONE THING SELECTING LATE COSTS: the parser has ALREADY TYPED the call's result, and it may have
// typed it from a registry that cannot tell overloads apart.**
//
// A call's result value is minted during the parse (`Parser.mintCallResult`). Its FIRST question is
// `Parser.overloadedCallResultType`, which asks the sweep's per-declaration parameter types which member the
// call means and answers that member's return type — so for a set whose members disagree, and whose
// arguments settle which one is meant, the tag the parser minted is already the right one and this pass finds
// nothing to do. Where that decider DECLINES (it does not read a compound parameter type, and it will not
// choose between two members that fit equally) the answer falls back to `ProgramSignatures.returnTypeOf`,
// whose table is keyed by the name the SOURCE wrote and is LAST-WINS over duplicate declarations — so the
// call was typed from whichever declaration the sweep read last. When the member this call actually resolves
// to returns something else, that tag is wrong, and it is wrong in a way that reaches the machine: the tag is
// what `lowerMaxonToStd` reads to pick the Std type of the call's result, so a `bool`-tagged result of an
// i64-returning callee is read one byte wide.
//
// So the tag is REPAIRED here — but only where the repair is provably complete:
//
//   • **Same STORAGE ⇒ nothing to do.** A ranged alias's `named` tag against a resolved `integer` is the
//     common case and must NOT be rewritten: the parser keeps `named` on purpose (the alias name carries the
//     signedness `valueIsUnsigned` reads), so "correcting" it would change codegen.
//   • **Different storage, both PLAIN SCALARS ⇒ retype.** `integer`/`boolean`/`exitCode` carry no name, own
//     no heap and travel in a GPR, so nothing the parser emitted for the value encodes which of the three it
//     was: the type is read from this column at lowering and nowhere else.
//   • **Anything else ⇒ REFUSED.** A managed↔scalar divergence is the case that matters: had the parser known
//     the result was a `String` it would have enrolled a scope-exit drop, and no retype can add an op that
//     was never emitted — the program would LEAK. A float↔int divergence changes the register FILE, and a
//     void↔value one changes whether there is a result at all. Each is refused with the reason, rather than
//     silently retyped into a wrong answer.
//
// ⚠ **The narrow residual, stated where it lives:** if the divergence IS scalar-to-scalar, the parser may
// already have rejected or reshaped an expression using the stale tag (`if <int-tagged>`, `<bool> + 1`). That
// is a false diagnostic, not a wrong answer, and it cannot arise for a set whose members agree on their
// return type, nor for one the parse-time decider settled — which is now the common case, and which is what
// the "real cure is per-member return types in the declaration sweep" this note used to end on turned into.
// What is left is the decider's own boundary: a compound parameter type it does not read, and a tie.
function reconcileOverloadResultType(project Project, func IrFunction, opIndex OpIndex, op MaxonOp, member ByteArray, disagreement OverloadDisagreementSubject)
	match overloadResultValue(op) 'result'
		defines(result) then reconcileOverloadResultTag(project, func: func, opIndex: opIndex, result: result, member: member, disagreement: disagreement)
		definesNothing then break 'result'
	end 'result'
end 'reconcileOverloadResultType'

function reconcileOverloadResultTag(project Project, func IrFunction, opIndex OpIndex, result ValueId, member ByteArray, disagreement OverloadDisagreementSubject)
	let declared = try project.funcReturnTypes.get(member) otherwise return
	match declared 'declared'
		value(returnType) then requireOverloadResultTagAgrees(project, func: func, opIndex: opIndex, result: result, member: member, declared: returnType, disagreement: disagreement)
		void then requireOverloadVoidResult(project, func: func, opIndex: opIndex, result: result, member: member, disagreement: disagreement)
	end 'declared'
end 'reconcileOverloadResultTag'

// ⭐⭐ **THE VOID SIDE OF THE SAME DISAGREEMENT, AND IT IS THE ONE QUADRANT NOTHING GUARDED (W49 wave 4).**
//
// This arm used to `break` on the stated grounds that *"a VOID member cannot have been chosen for a call
// whose result is read: the parser refuses a void call in value position, and in statement position the
// result tag is `void` already"*. **Both halves assume the SWEEP recorded the void member**, and the sweep
// is LAST-WINS over one entry per NAME wherever the parse-time decider declines — so when the VALUE member
// is the one it recorded, such a call was typed from it: the result carries that member's tag, and
// `enrolOwnedCallTemp` has already enrolled the scope-exit drop a managed return owes. A call that then resolves HERE, to the void member,
// spends that drop on a register the callee never wrote.
//
// MEASURED, `emit(flag bool)` declared ahead of `emit(tag int) returns String`, called `emit(true)` in
// statement position: compiled clean, no diagnostic at any stage, and died with an ACCESS VIOLATION
// (0xC0000005). The mirror — void recorded, a value member called — was already refused by the sibling
// below, which is why this read as guarded for as long as it did: the family fired, just not in this
// quadrant.
//
// ⭐⭐ **BOTH OF THOSE PROGRAMS NOW COMPILE AND ARE RIGHT, and this arm is what would catch it if they
// stopped being.** `Parser.overloadedCallResultType` types each of them from the member its ARGUMENT means,
// so the void call has no managed result to enrol a drop for and the value call has one to drop — pinned as
// `function-overloads.md`'s two `*-overload-beside-a-*-one-*-resolves-by-argument` cases, which assert the
// answer and the exit code rather than a refusal. What still reaches here is a set that decider declines:
// `cross-file-overload-set.md`'s `error.a-set-the-parse-time-decider-cannot-settle`.
//
// A `void`-tagged result is the agreement, and it is the only one: no repair is possible in either
// direction, because the divergence is over whether there is a value AT ALL.
function requireOverloadVoidResult(project Project, func IrFunction, opIndex OpIndex, result ValueId, member ByteArray, disagreement OverloadDisagreementSubject)
	let currentTag = try func.valueTags.get(result) otherwise panic("requireOverloadVoidResult: value v{result} of '{String.from(func.name)}' has no recorded type — every SSA value is minted through Parser.mintValue")
	if currentTag == ValueTypeTag.void 'alreadyRight'
		return
	end 'alreadyRight'

	reportOverloadReturnDisagreement(project, func: func, opIndex: opIndex, member: member, current: currentTag, declared: ValueTypeTag.void, disagreement: disagreement)
end 'requireOverloadVoidResult'

function requireOverloadResultTagAgrees(project Project, func IrFunction, opIndex OpIndex, result ValueId, member ByteArray, declared MaxonType, disagreement OverloadDisagreementSubject)
	let currentTag = try func.valueTags.get(result) otherwise panic("requireOverloadResultTagAgrees: value v{result} of '{String.from(func.name)}' has no recorded type — every SSA value is minted through Parser.mintValue")
	let declaredTag = maxonTypeTag(declared)
	if overloadResultTagAgrees(currentTag, declared: declaredTag) 'alreadyRight'
		return
	end 'alreadyRight'

	if not tagIsPlainOverloadScalar(currentTag) or not tagIsPlainOverloadScalar(declaredTag) 'notRepairable'
		reportOverloadReturnDisagreement(project, func: func, opIndex: opIndex, member: member, current: currentTag, declared: declaredTag, disagreement: disagreement)
		return
	end 'notRepairable'

	try func.valueTags.set(result, value: declaredTag) otherwise panic("requireOverloadResultTagAgrees: valueTags.set({result}) OOB inside its own count()")
	try func.valueNameIds.set(result, value: typeNameIdOf(declared)) otherwise panic("requireOverloadResultTagAgrees: valueNameIds.set({result}) OOB — the two type columns are minted in lockstep")
end 'requireOverloadResultTagAgrees'

// ONE sentence for every quadrant of the disagreement — value-vs-value that no retype can repair, and
// value-vs-void which nothing can. Spelling it in each arm is how the two would drift into two accounts of
// one rule, and the void arm's own history is that a second account of it was simply MISSING.
function reportOverloadReturnDisagreement(project Project, func IrFunction, opIndex OpIndex, member ByteArray, current ValueTypeTag, declared ValueTypeTag, disagreement OverloadDisagreementSubject)
	let range = project.opRanges.get(opIndex)
	let message = match disagreement 'about'
		theCallsResult gives "the overloads of '{String.from(member)}' do not agree on their return type ('{typeTagName(current)}' and '{typeTagName(declared)}'), and this call needed the one they disagree about. A call's result type is fixed while its file is parsed, from the parameter types the whole-program declaration sweep publishes — and they did not settle which overload this call means, so the result was typed from the single return type that index keeps per NAME. Only a difference between plain scalars can be corrected once the overload is known, a whole pass later. Make the overloads return the same type, or spell every overload's parameters as type NAMES that this call's arguments match in exactly one of them"
		// The op being reconciled is the synthesized helper behind an omitted argument, so `member` is a
		// symbol no source wrote. The sentence names the PARAMETER POSITION and the overloaded name the
		// author did write, and asks for the one thing that repairs it.
		aDefaultedArgument(callee, slot) gives "the overloads of '{bareMethodName(callee)}' do not agree on the TYPE of parameter {slot}, which this call omitted and the compiler supplied from that parameter's default ('{typeTagName(current)}' and '{typeTagName(declared)}'). A defaulted argument's type is fixed while the call is parsed, from a whole-program index that records one answer per NAME, and the overload is resolved a whole pass later — so only a difference between plain scalars can be corrected by then. Declare that parameter at the same type in every overload"
	end 'about'
	reportPositioned(project, code: ErrorCode.parserUnsupportedFeature, message: message, line: range.line, column: range.column, filePath: func.sourceFilePath)
end 'reportOverloadReturnDisagreement'

// Is this tag one of the three the retype above may cross between — unmanaged, un-named, non-float, GPR? See
// `reconcileOverloadResultType` for why each exclusion is load-bearing.
function tagIsPlainOverloadScalar(tag ValueTypeTag) returns bool
	return tag == ValueTypeTag.integer or tag == ValueTypeTag.boolean or tag == ValueTypeTag.exitCode
end 'tagIsPlainOverloadScalar'

// The value an overload-resolvable op DEFINES. All three define one — a `call` in statement position defines
// a `void`-tagged value it never reads — so the `definesNothing` arm exists for the op set to grow into
// rather than for a case that occurs today.
union OverloadResultValue
	defines(result ValueId)
	definesNothing
end 'OverloadResultValue'

function overloadResultValue(op MaxonOp) returns OverloadResultValue
	return match op 'op'
		call(result, _, _, _, _, _, _, _) gives OverloadResultValue.defines(result)
		tryCall(result, _, _, _, _, _, _, _, _) gives OverloadResultValue.defines(result)
		asyncCall(result, _, _, _, _, _, _) gives OverloadResultValue.defines(result)
		default panic("overloadResultValue: asked of an op that binds no direct callee — `maxonOpCalleeKind` answers `direct` for exactly these three")
	end 'op'
end 'overloadResultValue'

// **E3007 — the call cannot pick.** Anchored at the call (`opRanges` puts that at the callee token, which is
// where the author must add a label), naming the callee as WRITTEN with its type qualifier stripped, and
// listing the tied candidates' parameter lists in declaration order. The wording is the oracle's, verbatim,
// because `specs-shv2/function-overloads.md` compares it byte for byte.
function reportAmbiguousOverload(project Project, func IrFunction, opIndex OpIndex, callee ByteArray, tied ByteArrayArray, module MaxonModule, candidates ByteArrayArray)
	let range = project.opRanges.get(opIndex)
	reportPositioned(project, code: ErrorCode.semanticAmbiguousOverload, message: "Ambiguous overload for '{bareMethodName(callee)}': multiple overloads match. Candidates: {renderOverloadCandidates(project, tied: tied)}", line: range.line, column: range.column, filePath: func.sourceFilePath)
	// The op still names a callee, and for a CONTESTED set that name belongs to no declaration — see the
	// `ambiguous` arm above for the second diagnostic that earns.
	leaveUnmatchedCallOnFirstCandidate(project, module: module, opIndex: opIndex, callee: callee, candidates: candidates)
end 'reportAmbiguousOverload'

// `(name String), (label String)` — each tied candidate's parameter list, receiver excluded. Post-resolution
// types, so a ranged alias reads as the primitive it is; the oracle prints its own mangled spelling and the
// two agree on every aggregate, which is what the one spec case pins.
function renderOverloadCandidates(project Project, tied ByteArrayArray) returns String
	var rendered = ""
	for candidate in tied 'each'
		let sig = try project.funcSignatures.get(candidate) otherwise panic("renderOverloadCandidates: candidate '{String.from(candidate)}' is not in funcSignatures — the tie was scored against that entry")
		if not rendered.isEmpty() 'separator'
			rendered = "{rendered}, "
		end 'separator'

		rendered = "{rendered}({renderOverloadParams(project, sig: sig)})"
	end 'each'
	return rendered
end 'renderOverloadCandidates'

function renderOverloadParams(project Project, sig FuncSignature) returns String
	var rendered = ""
	for i in firstUserParamIndex(sig.takesReceiver()) upto sig.paramNames.count() 'eachParam'
		if not rendered.isEmpty() 'separator'
			rendered = "{rendered}, "
		end 'separator'

		let paramName = try sig.paramNames.get(i) otherwise panic("renderOverloadParams: paramNames.get OOB at {i} inside its own count()")
		let paramType = try sig.paramTypes.get(i) otherwise panic("renderOverloadParams: paramTypes.get OOB at {i} — a signature's param columns are built in lockstep")
		rendered = "{rendered}{String.from(paramName)} {maxonTypeName(paramType, typeNames: project.typeNames)}"
	end 'eachParam'
	return rendered
end 'renderOverloadParams'

// The argument list an overload-resolvable op supplies. A THIRD match over the same three variants would be
// one too many, but this one asks a different question from `maxonOpCalleeKind`'s and cannot be folded into it:
// that answer is built once per op, this one is read once per CANDIDATE.
union OverloadCallArgs
	supplied(args ValueIdArray, argLabels ByteArrayArray, defaultSlots ParamCountArray)
end 'OverloadCallArgs'

function overloadCallArgs(op MaxonOp) returns OverloadCallArgs
	return match op 'op'
		call(_, _, args, argLabels, _, _, defaultSlots, _) gives OverloadCallArgs.supplied(args, argLabels: argLabels, defaultSlots: defaultSlots)
		tryCall(_, _, _, args, argLabels, _, _, defaultSlots, _) gives OverloadCallArgs.supplied(args, argLabels: argLabels, defaultSlots: defaultSlots)
		asyncCall(_, _, args, argLabels, _, _, defaultSlots) gives OverloadCallArgs.supplied(args, argLabels: argLabels, defaultSlots: defaultSlots)
		default panic("overloadCallArgs: asked of an op that supplies no argument list — `maxonOpCalleeKind` answers `direct` for exactly these three")
	end 'op'
end 'overloadCallArgs'

// E3054 — `main` cannot declare `throws`: there is no caller left to handle the error. Scans the merged
// module for `main`'s function (whose `throwsTypeName` the parser stamped), positioned at its name token.
function checkMainCannotThrow(project Project, module MaxonModule)
	for func in module.functions 'eachFunc'
		if func.name == MainFunctionName and throwsClauseIsThrowing(func.throwsTypeName) 'mainThrows'
			reportPositioned(project, code: ErrorCode.mainCannotThrow, message: "main cannot throw: 'main'", line: func.nameLine, column: func.nameColumn, filePath: func.sourceFilePath)
		end 'mainThrows'
	end 'eachFunc'
end 'checkMainCannotThrow'

// ⭐⭐ **A FUNCTION'S OWN `throws` CLAUSE MUST NAME A DECLARED ENUM OR UNION (A1s-throwsbox).** Until this
// check existed the clause was validated by NOTHING, and that single absence produced two measured defects:
//
//   • **`throws Error` on a plain function LEAKED THE BOX — exit 101 in shv2 AND in the C# oracle.** The
//     error-flag ABI has two shapes, and the two ends of a throw derive which one is in play from DIFFERENT
//     places: the THROW site reads the value it actually throws (`Parser.emitThrowError` →
//     `throwsTypeIsBoxedUnion(self.typeOf(errValue))`, and `lowerThrowError` then writes the box pointer
//     verbatim), while the CATCH site reads the DECLARED clause (`tryErrorEnumType` → the same predicate over
//     the clause name). `Error` is an INTERFACE, so it is in no enum registry, so the catch answered `false`,
//     subtracted `ErrorFlagOrdinalBias` from what was really a heap pointer, and never enrolled the box for
//     release. Nothing reconciled the two derivations — and nothing CAN, because a clause with no declared
//     cases has no flag shape to reconcile TO.
//   • **`throws Bogus`, a name resolving to nothing at all, compiled and RAN.** Same hole, other end.
//
// **The rule is "names a declared enum or union", asked of the registry the catch DECODE ITSELF consults**
// (`ProgramSignatures.enumTypes`, which `Parser.throwsTypeIsBoxedUnion` reaches through `enumOf`, and NOT the
// `Project.enumTypes` authority beside it — see `PassPipeline.signatures`). Asking the decode's own question
// is what makes the answer honest: a clause this check admits is one `throwsTypeIsBoxedUnion` can classify,
// and a clause it refuses is one that classifier could only have guessed about. The same argument
// `ConformanceCheck.throwsRequirementIsAbstract` makes one door over.
//
// ⚠ **IT IS A RULE ABOUT A FUNCTION'S OWN CLAUSE, NOT ABOUT AN INTERFACE REQUIREMENT'S, and the two are
// structurally separated rather than separated by a test.** `interface Parsable`'s
// `fromString(…) throws Error` is the abstract error channel `Error` exists for: a requirement declares no
// body, is dispatched through the witness ABI, and is already guarded by `validateThrowsConformance` (E3016,
// which narrows an abstract requirement only to a SCALAR-flagged impl error). An interface method is an
// `InterfaceMethodSig` on the interface declaration and never becomes an `IrFunction`, so walking
// `module.functions` cannot reach one.
//
// ⚠ **AND IT RUNS HERE, IN THE PIPELINE, WHICH KEEPS IT BEHIND `checkConformance`'S ERROR GATE.** An impl
// method declaring `throws Bogus` under an abstract requirement is refused by E3016 with a message that can
// name the requirement it violates; `checkConformance` runs before the pipeline, so that program never
// reaches this pass and gets the better-informed sentence rather than two diagnostics about one clause.
// (`specs-shv2/interface-conformance.md`'s `error.throws-unresolvable-impl-type-under-abstract-requirement`
// is the pin on that ordering.)
//
// ⚠ **A PARSE-TIME REFUSAL WAS THE ALTERNATIVE AND IS NOT AVAILABLE.** `parseOptionalThrowsClause` is
// deliberately tolerant — its own comment says the clause is "validated later, in SemanticCheck" — because it
// runs in BOTH the tolerant declaration sweep and the real parse, and the sweep reads a signature while the
// whole-program index is still being BUILT. Asking "is this a declared enum?" there would make a
// declaration's acceptance depend on its POSITION in the sweep, which is the argument
// `Parser.parseTypeReference`'s header already makes about `Self`. This pass is the first point that holds a
// merged module and a complete registry.
function checkThrowsClausesNameDeclaredErrors(project Project, module MaxonModule, signatures ProgramSignatures)
	for func in module.functions 'eachFunc'
		match func.throwsTypeName 'clause'
			none then break 'clause'
			throwing(declared) then requireThrowsClauseNamesADeclaredError(project, signatures: signatures, func: func, declared: declared)
		end 'clause'
	end 'eachFunc'
end 'checkThrowsClausesNameDeclaredErrors'

// One function's clause. Split into two refusals rather than one, because the two mistakes are different
// mistakes and the reader has to be told which one they made: naming an interface is reaching for an
// abstract error channel a plain function has no ABI for, and naming a struct or a typo is naming something
// that was never an error type at all. The same split
// `ConformanceCheck.requireImplErrorIsANarrowableError` makes, for the same reason.
//
// ⚠ **NEITHER MESSAGE NAMES THE FUNCTION, AND THAT IS SO THE ORACLE CAN SAY THE SAME SENTENCE.** The
// bootstrap refuses this at its `ParseThrowsClause`, where the enclosing declaration's registration name is
// not in hand (and would be spelled with ITS namespace scheme even where it is); `maxon-sharp`'s
// `RequireThrowsTypeIsAnErrorEnum` carries both sentences below VERBATIM. One rule refused by two compilers
// should read as one rule, and both position the diagnostic at a file:line:column that identifies the
// declaration exactly — so the name in the prose would have bought nothing but a second spelling for the two
// corpora to keep in step by hand.
// ⚠ **THE SORTING IS `ConformanceCheck.classifyThrowsClauseName`'S, AND ASKING IT IS THE POINT (A1s review).**
// This check and `throwsRequirementIsAbstract` one door over are about different relations, but both begin by
// sorting one clause name into the same three boxes — and each began with its own copy of the two lookups,
// with nothing making the copies agree. A future edit to either ("a typealias to an enum is concrete too")
// would have made the impl side and the plain-function side disagree about what an error type IS, silently.
function requireThrowsClauseNamesADeclaredError(project Project, signatures ProgramSignatures, func IrFunction, declared String)
	match classifyThrowsClauseName(project, signatures: signatures, name: declared, readerFilePath: func.sourceFilePath) 'kind'
		concreteError then break 'kind'
		abstractInterface then reportThrowsClauseViolation(project, func: func, message: "'throws {declared}' names an INTERFACE. A caught error is decoded off the DECLARED clause, and an interface declares no case to decode — a payload-carrying conformer arrives as a heap box pointer that would be read back as an ordinal and never released. Name the error enum or union this function actually throws")
		undeclared then reportThrowsClauseViolation(project, func: func, message: "'throws {declared}' names no declared enum or union. A caught error is decoded off the DECLARED clause, so the clause has to name the type whose cases it decodes into")
	end 'kind'
end 'requireThrowsClauseNamesADeclaredError'

// The ONE report site for the check above — it derives three of `reportPositioned`'s six arguments from the
// function, which each arm would otherwise spell out separately, exactly as
// `ConformanceCheck.reportThrowsViolation` does for its four.
function reportThrowsClauseViolation(project Project, func IrFunction, message String)
	reportPositioned(project, code: ErrorCode.throwsTypeNotAnErrorEnum, message: message, line: func.nameLine, column: func.nameColumn, filePath: func.sourceFilePath)
end 'reportThrowsClauseViolation'

// The throws clauses of every THROWING function in the program, keyed by (mangled) name. A non-throwing
// function is absent — the same "absence is the answer" the parser's `ProgramSignatures.funcThrows` uses.
//
// ⭐ **IT TAKES THE CHECKED INDEX, NOT THE MODULE (A2l).** The map is keyed by NAME and read at every call
// site to decide whether a plain call needs a `try`; two functions of one name would collapse to one entry
// and a call could be validated against the OTHER one's clause. This used to be a bare last-wins `upsert`
// running BEFORE the pass that built the checking index — right on this rule and unable to say why.
function buildThrowsMap(funcNames FunctionNameIndex) returns FuncThrowsMap
	var throwsMap = FuncThrowsMap.create()
	for func in funcNames.functions 'eachFunc'
		if throwsClauseIsThrowing(func.throwsTypeName) 'throwing'
			throwsMap.upsert(func.name, value: func.throwsTypeName)
		end 'throwing'
	end 'eachFunc'
	return throwsMap
end 'buildThrowsMap'

// ⭐ **THE INTERPROCEDURAL CLOSURE-ESCAPE SUMMARY (P1.5-A2b-2)** — for each function, which of its
// FUNCTION-TYPED parameters the body PERSISTS (stores into a field/global/union payload, returns, or passes
// on to another call), keyed by the callee's mangled name. Read at every call site: a CAPTURING closure
// passed to a persisted parameter would keep only its fn-ptr, so its captured environment dangles the moment
// the passing frame dies (a use-after-free = the OPEN #13 interprocedural escape A2b-1 blocked and A2b-2 must
// re-close now that pass-DOWN is allowed).
//
// A parameter is SAFE iff its ValueId is used ONLY as the callee of an indirect call (`f(x)` — the env
// travels as a synchronous companion argument, valid for the call) or handed DOWN a synchronous call to a
// parameter that is itself safe. Every other use — stored, returned, merged through a phi, spawned into a
// green thread, handed to a runtime entry or to a witness dispatch — is an ESCAPE. A function absent from
// the map has no escaping parameter — the same "absence is the answer" `buildThrowsMap` uses, so the
// overwhelming first-order function costs no entry.
//
// ⭐⭐ **PASSING IT ON IS AN EDGE, NOT AN ESCAPE — AND UNTIL W58 IT WAS AN ESCAPE, WHICH BLOCKED
// `arr.sort()`.** This function's own header used to say the conservative answer "may over-refuse an exotic
// pass-through-that-only-calls chain, sound and with no corpus coverage". The corpus has coverage now, and
// the chain is not exotic: it is how a sort is written. `stdlib/Array.maxon`'s `sort()` hands the comparator
// to `Array.driftsortRange`, which hands it to `createRun` / `stableQuicksortRange` / `mergeAdaptive` /
// `smallSortRange`, none of which does anything with it but CALL it — and `sort()`'s comparator is a
// capturing closure (it captures the enclosing extension's `where Element is Comparable` witness through the
// closure env), so the one-hop answer refused it: **`E3099: cannot pass a closure that captures to
// 'Array.driftsortRange', which stores or returns it`** — about a function that does neither. MEASURED
// against `stdlib/Array.maxon` listed; it is `specs-shv2/array-sort.md`'s whole suite.
//
// The RUNTIME had no such limit and never did: `LowerMaxonToStd.appendCalleeEnvArgs` threads a function
// argument's environment as a companion at every direct call, and `Parser.bindClosureEnvParams` gives a
// function-typed PARAMETER its own companion, so `valueClosureEnv` is non-zero for a parameter too and the
// environment rides an arbitrarily deep pass-DOWN chain. The refusal was the analysis being unable to say
// what the lowering already did.
//
// ⭐ **SO IT IS A FIXPOINT, over the SAME call-graph edges, CSR and worklist the parameter-MUTATION summary
// closes over** (`collectCallParamEdges` / `propagateParamMasks`): a caller's parameter escapes if the callee
// parameter it fills escapes. Same shape, different SEED — and a third idiom for "close a per-function fact
// under the call graph" is exactly what `buildParamMutationSummary`'s header forbids. Termination is the same
// argument: a mask only ever GAINS bits and a function has at most `MaxAbiArgs` of them.
//
// ⚠⚠ **THERE IS NOW A SECOND ESCAPE ANALYSIS IN THE COMPILER, AND IT IS DELIBERATE — SEE
// `IR/Std/PromoteStackRecords.buildParamEscapeMasks`.** It asks the same-shaped question of the same call
// graph and it is NOT this idiom a third time. Two things separate them, and both are load-bearing:
//
//   * THE TIER. That one runs on the STD module and is keyed on `__mm_alloc` / `__mm_decref`, ops that do
//     not exist until the lowering has run. It cannot be answered here, and this cannot be answered there
//     (a `function`-typed parameter's closure environment is a Maxon-tier fact).
//   * THE DIRECTION OF CONSERVATISM. This one's wrong answer is a false REFUSAL — a legal program rejected.
//     That one's is a false ADMISSION — an allocation deleted out from under a live pointer, with no
//     diagnostic anywhere. So their ADMITTED USES differ on purpose (a `loadIndirect` through the pointer is
//     the whole point of a record and is meaningless for a closure), and one predicate serving both would
//     have to be the union of their refusals, which is neither answer.
//
// What they DO share is the vocabulary — `ParamPositionMask` with `maskWithParam`/`maskHasParam`, and a CSR
// from `buildCsr`. The PROPAGATION ENGINES differ and that is not a duplication either: this one carries a
// MASK per function and so needs `propagateParamMasks`' mask-valued worklist over per-FUNCTION nodes; that
// one's seeds are per-PARAMETER facts with no mask arithmetic, so it uses one node per (function, parameter)
// and the shared `reverseReachabilityMark`.
//
// ⚠ **THE ESCAPING SET IS A LEAST FIXPOINT, so seeding every parameter SAFE and growing the escaping set is
// SOUND rather than optimistic.** "Escapes" is reachability from a real escape SITE, so a parameter that
// never reaches one does not escape however the recursion is shaped — which matters, because the sort cone is
// mutually recursive (`driftsortRange` → `createRun` → `stableQuicksortRange` → `driftsortRange`) and a
// depth-first "ask the callee" walk would not terminate on it.
typealias ParamEscapeSummary = Map with (ByteArray, ParamPositionMask)

// Keyed by name and read at every call site, so it is built from the CHECKED index for `buildThrowsMap`'s
// reason (A2l); `module` still travels because the per-function escape scan reads the module's OPS, and the
// edges travel because the closure over them is the caller's (`semanticCheck` builds them once for both
// summaries).
function buildEscapeSummary(module MaxonModule, funcNames FunctionNameIndex, funcSignatures FuncSignatureMap, edges CallParamEdges, byCallee CsrGraph) returns ParamEscapeSummary
	var masks = ParamPositionMaskArray.create()
	for func in funcNames.functions 'seed'
		masks.push(directlyEscapingParams(func, module: module, funcSignatures: funcSignatures))
	end 'seed'
	propagateParamMasks(masks, edges: edges, byCallee: byCallee)

	var summary = ParamEscapeSummary.create()
	for i in 0 upto masks.count() 'publish'
		let mask = try masks.get(i) otherwise panic("buildEscapeSummary: masks.get OOB at {i} — one mask was pushed per function of the index")
		if mask == NoParamPositions 'nothingEscapes'
			continue
		end 'nothingEscapes'
		let func = try funcNames.functions.get(i) otherwise panic("buildEscapeSummary: functions.get OOB at {i} — the mask column is built over this array")
		summary.upsert(func.name, value: mask)
	end 'publish'
	return summary
end 'buildEscapeSummary'

// Is parameter `param` of `func` `function`-TYPED? The one place that reads the published per-value tag
// column for this question — the GATE below and the per-parameter BITS below it are the same test asked of
// one function and then of each of its parameters, and a copy each would be one fact with two spellings free
// to drift (the shape this file's `isMarkedCapturingClosure` exists to prevent for the closure column).
//
// A parameter's ValueId IS its index. The column trails the values it describes, so a `paramCount` that runs
// past it is a parser/IR disagreement, not a parameter of some other type — hence the bounds test, and the
// `panic` behind it for the read the bounds test has already made impossible.
function isFunctionTypedParam(func IrFunction, param ValueId) returns bool
	return param < func.valueTags.count() and (try func.valueTags.get(param) otherwise panic("isFunctionTypedParam: valueTags.get OOB at {param} inside its own count()")) == ValueTypeTag.function
end 'isFunctionTypedParam'

// Does `func` take at least one `function`-typed parameter? The cheap gate that keeps the escape scan off
// the overwhelming first-order function — a bounded tag check, no allocation.
function functionHasFunctionParam(func IrFunction) returns bool
	for i in 0 upto func.paramCount 'eachParam'
		if isFunctionTypedParam(func, param: i as ValueId) 'isFunction'
			return true
		end 'isFunction'
	end 'eachParam'
	return false
end 'functionHasFunctionParam'

// ⭐ **THE SEED: the `function`-typed parameters this body lets escape ON ITS OWN**, before the call graph is
// closed over. A non-function parameter is never in it (no closure targets it, so its escape is irrelevant),
// which keeps the published summary keyed on what a call site can actually refuse.
//
// "On its own" is the whole distinction this rung turns on: a parameter handed DOWN a synchronous call to a
// named callee is NOT here, because that is an EDGE `propagateParamMasks` closes over — see
// `syncCallArgEscapes`, which is the one place that decision lives for both of this scan's subjects.
function directlyEscapingParams(func IrFunction, module MaxonModule, funcSignatures FuncSignatureMap) returns ParamPositionMask
	if not functionHasFunctionParam(func) 'noFunctionParam'
		return NoParamPositions
	end 'noFunctionParam'

	var mask = NoParamPositions
	for i in 0 upto func.paramCount 'eachParam'
		let param = i as ValueId
		if isFunctionTypedParam(func, param: param) and escapeSiteFound(valueEscapeSite(func, module: module, subject: EscapeScanSubject.oneParameter(param), funcSignatures: funcSignatures)) 'escapes'
			mask = maskWithParam(mask, param: i)
		end 'escapes'
	end 'eachParam'
	return mask
end 'directlyEscapingParams'

// ⭐ **WHICH VALUES THE ESCAPE SCAN TRACKS — and the ONE slot on which the two rules still differ.**
// A function-typed PARAMETER and a capturing-closure LITERAL leave a frame through exactly the same slots
// (a store, a return, a phi edge, an indirect call's ARGUMENT), and since W58 they answer a SYNCHRONOUS
// direct call's argument the same way too: neither escapes there, because each has a decider that runs later
// and knows the callee — the parameter's is `propagateParamMasks` over the call graph, the closure's is
// `checkCapturingClosureEscape` at the call site. Both are one hop of the same fact, which is what keeps
// `apply(function(n) gives n + c, x)` — a pass DOWN to a callee that only CALLS it — green, and what now
// keeps `arr.sort()` green through the four-deep sort cone.
//
// ⚠ **THE EXCEPTION IS AN `async` SPAWN, and the difference is REAL rather than an omission.** A green
// thread outlives the frame that spawned it, so an argument crossing into one is not "handed down" — it is
// gone. There is deliberately no call-graph EDGE for a spawn (`collectCallParamEdgesAt`'s `asyncCall` arm
// states the exclusion), so for the PARAMETER subject a spawn argument must escape HERE or nothing will ever
// say it does. The closure subject keeps its existing call-site delegation there, untouched.
//
// ⭐⭐ **AND IT IS ALSO HOW MANY VALUES ONE PASS TRACKS, WHICH IS WHAT KEEPS THE CLOSURE RULE LINEAR.**
// The parameter summary asks about ONE value at a time, and can: a function declares a handful of parameters.
// The closure rule asks the SAME question of every capturing closure a function mints — and asking it one
// closure at a time is a body scan PER CLOSURE, i.e. (closures × ops). That is not a benign product: a
// function's op count GROWS WITH its closure count, so it is a quadratic in the function's own size. MEASURED
// on a straight-line function holding C capturing closures, all ACCEPTED so the whole body is scanned:
// `semanticCheck` ran 1.1 / 4.3 / 16.4 / 66.7 / 271.8 ms for C = 40 / 80 / 160 / 320 / 640 — **~4x per
// doubling**. So `everyCapturingClosure` tracks the whole marked column in ONE pass: the mark is an O(1)
// array read, so "is this operand tracked" costs the same as comparing against one id, and the scan is
// O(ops) whatever the closure density. Re-measured on the same ladder after: 0.2 / 0.3 / 0.7 / 1.7 / 2.8 ms
// — ~2x per doubling, i.e. LINEAR, and still 7.2 ms at a sixth rung of C = 1280.
union EscapeScanSubject
	// ONE function-typed parameter, named by its ValueId (a parameter's ValueId is its index). Asked once per
	// parameter, behind `functionHasFunctionParam`.
	oneParameter(param ValueId)
	// EVERY value `func.valueIsCapturingClosure` marks, in a single pass over the body.
	everyCapturingClosure
	// ONE marked capturing closure. The sweep above answers "does any of them escape, and where"; the band
	// match it runs must stay a BOOL to stay allocation-free (see `trackedValueAt`), so "WHICH of them" is a
	// separate question — asked with this subject, on the refusal path only, so it re-asks the SAME closure
	// rule rather than a parameter rule that differs at a direct call's argument.
	oneCapturingClosure(closure ValueId)
end 'EscapeScanSubject'

// Is `candidate` one of the values this scan tracks? **O(1) for every subject** — an identity test, or one
// read of the closure mark column — which is exactly what lets the sweep test every operand it meets instead
// of re-walking the body once per closure.
function isTrackedValue(candidate ValueId, subject EscapeScanSubject, func IrFunction) returns bool
	match subject 'subject'
		oneParameter(param) then return candidate == param
		everyCapturingClosure then break 'subject'
		oneCapturingClosure(closure) then return candidate == closure
	end 'subject'

	return isMarkedCapturingClosure(candidate, func: func)
end 'isTrackedValue'

// Is `value` a capturing-closure LITERAL born in `func`? A value minted after parsing (a lowering temporary)
// has no mark slot and is no closure — `Parser.mintValue` seeds the column per SSA value, so it only ever
// trails the values it describes.
function isMarkedCapturingClosure(value ValueId, func IrFunction) returns bool
	return value < func.valueIsCapturingClosure.count() and (try func.valueIsCapturingClosure.get(value) otherwise panic("isMarkedCapturingClosure: valueIsCapturingClosure.get OOB at {value} inside its own count()"))
end 'isMarkedCapturingClosure'

// Does this scan track capturing closures rather than one parameter? Asked at exactly ONE slot — an `async`
// SPAWN's argument in `spawnArgEscapes`, the only place the two rules still disagree (see
// `EscapeScanSubject`). A predicate rather than a `==`, because two arms carry a payload and a union has no
// equality to compare a constructed value against.
function subjectTracksCapturingClosures(subject EscapeScanSubject) returns bool
	return match subject 'subject'
		oneParameter gives false
		everyCapturingClosure to oneCapturingClosure gives true
	end 'subject'
end 'subjectTracksCapturingClosures'

// WHERE a tracked value leaves its frame, and WHICH value did. Not a bool, because the capturing-closure rule
// must WORD its refusal from the route it found (`closureEscapeReason`) and ANCHOR it at the closure that took
// that route — and the two routes carry different evidence: an op has a flat index the reason can be read off,
// a branch edge is not an op and has none. Constructed at most ONCE per scan, which is what makes it
// affordable: a Maxon union value is a heap object, so a union returned from the per-OP band match would cost
// one allocation per op scanned (measured: +11 per closure).
union ValueEscapeSite
	// A body op or terminator places `value` where the frame's environment cannot follow — `opIndex` is that
	// op's flat `module.ops` index.
	persistedBy(value ValueId, opIndex OpIndex)
	// A branch edge carries `value` into a block-arg phi. One slot, joining every incoming edge, and it
	// carries the code pointer alone — the environment rides a per-value side column no phi can merge.
	mergedIntoPhi(value ValueId)
	none
end 'ValueEscapeSite'

// Did the scan find a real escape? The two escaping arms collapse to one range (the union's own band order),
// so a route appended later must state its own answer rather than inherit `none`'s.
function escapeSiteFound(site ValueEscapeSite) returns bool
	return match site 'site'
		persistedBy to mergedIntoPhi gives true
		none gives false
	end 'site'
end 'escapeSiteFound'

// ⭐ **THE ONE ESCAPE SCAN, over ops, terminators AND branch edges.** Does `func`'s body use a value `subject`
// tracks anywhere other than where the frame's environment can follow it? The ONLY unconditionally safe use is
// `indirectCall`'s CALLEE slot — a call, whose env is threaded synchronously by `emitClosureEnvArg` — plus,
// for a capturing closure, a direct call's arguments (see `EscapeScanSubject`).
//
// The branch-edge scan is load-bearing, not belt-and-braces, and BOTH subjects need it. For a parameter: one
// flowed into a phi — `var h = f` carried across a loop, then `return h` — reaches the return through the
// block ARGUMENT, not an op operand, so an op-only scan misses it. For a capturing closure it is stronger
// still: a phi cannot carry an environment AT ALL, so reaching one is fatal whether or not the merged value
// then escapes (`var f = <closure>` reassigned inside an `if` or a `while` compiled clean and SEGFAULTED).
//
// ⭐ **ONE PASS, WHATEVER THE SUBJECT TRACKS.** It returns the FIRST escape in scan order — blocks, then each
// block's ops, its terminator and its branch edges — and stops there. For a parameter that is the only escape
// there is. For the closure sweep it is the EARLIEST OFFENDING USE, whichever closure took it: a deterministic
// (so worker-invariant) choice, and the one a reader meets first reading the function top to bottom.
function valueEscapeSite(func IrFunction, module MaxonModule, subject EscapeScanSubject, funcSignatures FuncSignatureMap) returns ValueEscapeSite
	for blockRef in func.blockRefs 'eachBlock'
		let block = try module.blocks.get(blockRef) otherwise panic("valueEscapeSite: blockRef from func.blockRefs not in module.blocks")
		for opIdx in block.opRefs 'eachOp'
			let op = try module.ops.get(opIdx) otherwise panic("valueEscapeSite: opIdx {opIdx} not in module.ops")
			if opEscapesValue(op, subject: subject, func: func, funcSignatures: funcSignatures) 'escapes'
				return ValueEscapeSite.persistedBy(trackedValueAt(op, subject: subject, func: func, funcSignatures: funcSignatures), opIndex: opIdx)
			end 'escapes'
		end 'eachOp'

		if block.hasTerminatorOp() 'hasTerminator'
			let termIdx = block.terminatorIndex()
			let term = try module.ops.get(termIdx) otherwise panic("valueEscapeSite: terminatorIndex not in module.ops")
			if terminatorEscapesValue(term, subject: subject, func: func) 'termEscapes'
				return ValueEscapeSite.persistedBy(trackedValueAt(term, subject: subject, func: func, funcSignatures: funcSignatures), opIndex: termIdx)
			end 'termEscapes'
		end 'hasTerminator'

		for edge in block.branchEdges 'eachEdge'
			for argId in edge.argIds 'eachEdgeArg'
				if isTrackedValue(argId, subject: subject, func: func) 'edgeEscapes'
					return ValueEscapeSite.mergedIntoPhi(argId)
				end 'edgeEscapes'
			end 'eachEdgeArg'
		end 'eachEdge'
	end 'eachBlock'

	return ValueEscapeSite.none
end 'valueEscapeSite'

// ⭐ **WHICH tracked value the hit at `op` names.** Split from the band matches below, and asked ONCE per
// scan at the single site it stops at, because those matches run PER OP and must therefore answer in a
// SCALAR: a Maxon union (and a `type`) is a heap object, so handing "which value" back from them costs one
// allocation per op scanned — measured at +11 allocations per closure, on a pass that runs on every compile.
// A single-value subject already knows its answer; the sweep re-asks its own rule of one closure at a time,
// over the ONE op that stopped it, which is O(closures) on the refusal path and never on the accepting one.
function trackedValueAt(op MaxonOp, subject EscapeScanSubject, func IrFunction, funcSignatures FuncSignatureMap) returns ValueId
	match subject 'subject'
		oneParameter(param) then return param
		everyCapturingClosure then break 'subject'
		oneCapturingClosure(closure) then return closure
	end 'subject'

	for v in 0 upto func.valueIsCapturingClosure.count() 'eachValue'
		let closure = v as ValueId
		if not isMarkedCapturingClosure(closure, func: func) 'notAClosure'
			continue
		end 'notAClosure'

		// Body op or terminator: only one of the two matches can claim any given op, and the sweep does not
		// record which of them stopped it — so ask both rather than carry a third route through the union.
		let asOne = EscapeScanSubject.oneCapturingClosure(closure)
		if opEscapesValue(op, subject: asOne, func: func, funcSignatures: funcSignatures) or terminatorEscapesValue(op, subject: asOne, func: func) 'thisOne'
			return closure
		end 'thisOne'
	end 'eachValue'

	panic("trackedValueAt: the sweep stopped at a slot no single marked closure escapes — `everyCapturingClosure` and `oneCapturingClosure` disagree about which values a slot persists")
end 'trackedValueAt'

// Does BODY op `op` persist a value `subject` tracks? A function value can only leave a frame through a STORE
// (its value slot), a direct/try/indirect CALL ARGUMENT, or a RETURN (the terminator, handled separately). It
// is the callee of an indirect call that is SAFE, so `indirectCall` binds only its args (the `_` callee is
// ignored). The non-persisting bands range to `break` — a newly appended op FAILS TO COMPILE here rather than
// silently escaping the scan (the band-append invariant). ⭐ That is the whole guarantee OPEN #73 asked for:
// this match, not a hand-written call at every sink, is what makes the escape rule cover a sink that does not
// exist yet.
function opEscapesValue(op MaxonOp, subject EscapeScanSubject, func IrFunction, funcSignatures FuncSignatureMap) returns bool
	match op 'op'
		call(_, callee, args, _, _, _, _, _) then return syncCallArgEscapes(callee, args: args, subject: subject, func: func, funcSignatures: funcSignatures)
		literal to loadIndirect then break 'op'
		storeIndirect(_, _, stored, _) then return isTrackedValue(stored, subject: subject, func: func)
		stringLiteral then break 'op'
		tryCall(_, _, callee, args, _, _, _, _, _) then return syncCallArgEscapes(callee, args: args, subject: subject, func: func, funcSignatures: funcSignatures)
		throwError to functionRef then break 'op'
		indirectCall(_, _, args) then return trackedValueInArray(args, subject: subject, func: func)
		// P1.5-B1a: an async spawn's arguments cross into a green thread, which OUTLIVES this frame — so it is
		// not the pass-DOWN the two arms above are (`spawnArgEscapes`). An `await`/`try await`'s operand is a
		// runtime promise handle, not a persisted value.
		asyncCall(_, callee, args, _, _, _, _) then return spawnArgEscapes(callee, args: args, subject: subject, func: func, funcSignatures: funcSignatures)
		await to tryAwait then break 'op'
		sizeofType then break 'op'
		constArrayLiteral then break 'op'
		// The jump table branches on its index — it persists no value, so it escapes nothing.
		switch then break 'op'
		// ⭐ A WITNESS DISPATCH IS A CALL WITH NO CALLEE NAME, so it escapes for BOTH subjects — see
		// `syncCallArgEscapes` for why the delegation stops here (P1.7a slice 2a).
		// Its receiver + user args are all in `args`.
		witnessDispatch(_, args, _, _, _, _, _) then return trackedValueInArray(args, subject: subject, func: func)
		witnessTryDispatch(_, _, args, _, _, _, _) then return trackedValueInArray(args, subject: subject, func: func)
		// A panic's message pointer is bytes handed to a diverging runtime — nothing outlives the frame,
		// because there is no frame afterwards.
		panicAbortValue then break 'op'
		// The error-flag encode persists nothing: its result is consumed by the routed edge's phi, in this frame.
		errorFlagEncode then break 'op'
		// ⭐⭐ **A SERVICE OP HANDS ITS OPERAND TO ANOTHER GREEN THREAD, WHICH IS AS FAR OUT OF REACH AS A
		// VALUE GETS.** Neither can carry a closure today — a `function`-typed message parameter is refused at
		// the `spawn` (E3135) and a spawn's state is a static factory's own fresh box — so both arms are the
		// structural backstop rather than a live route, and `closureEscapeReason` answers for each in its own
		// words rather than reaching that function's disagreement panic.
		serviceSpawn(_, _, state) then return isTrackedValue(state, subject: subject, func: func)
		serviceSend(_, _, handle, request) then return isTrackedValue(handle, subject: subject, func: func) or isTrackedValue(request, subject: subject, func: func)
		// A REPLY CELL takes no operand at all — it mints a fresh GT struct out of the slab — so no value of
		// this frame's can escape through it.
		serviceReplyCell then break 'op'
	end 'op'
	return false
end 'opEscapesValue'

// ⭐ **A SYNCHRONOUS DIRECT CALL'S ARGUMENT — DELEGATED, BUT ONLY WHERE A DELEGATE ACTUALLY RUNS.**
//
// The callee's own frame is nested inside this one, so an argument handed down it is not out of reach — a
// LATER decider that knows the callee says whether it stays reachable, and BOTH subjects have one:
//
//   • a function-typed PARAMETER is closed over the call graph by `propagateParamMasks`, which inherits the
//     callee parameter's own verdict through the edge `collectCallParamEdges` recorded for this argument;
//   • a capturing-closure LITERAL is `checkCapturingClosureEscape`'s question at the call site, which reads
//     that same finished summary.
//
// Neither delegate runs everywhere, and they stop at the SAME place: `validateCall` returns before the
// call-site check for a callee with NO DECLARED SIGNATURE, and `addCallParamEdges` records no edge for one
// either — it has no `paramNames` to slot the argument against. So a value handed to a runtime entry is
// refused HERE, for both subjects: `a.push(function(n) gives n + c)` puts a bare code pointer into a heap
// Array that outlives the frame, exactly the escape E3099 exists to forbid.
//
// Delegating a slot the delegate never sees is not "one decider", it is NO decider — the same reason
// `witnessDispatch` (whose callee is chosen at runtime by the witness table, so no name keys a summary)
// escapes unconditionally above.
//
// ⚠ **"NO DECLARED SIGNATURE" IS WHY THIS READS `isSignaturelessCompilerCallee` AND NOT THE `__` PREFIX
// (A1r).** The two must name the same set as `validateCall`'s early return, because this arm exists precisely
// to cover the slots that return skips — and since A1r a `__` callee may be a DECLARED function
// (`stdlib/Builtins.maxon`'s own), for which the delegate does run and holds the better answer. Keyed on the
// prefix, both would fire and the stricter one would win, refusing a closure the callee's summary permits.
function syncCallArgEscapes(callee ByteArray, args ValueIdArray, subject EscapeScanSubject, func IrFunction, funcSignatures FuncSignatureMap) returns bool
	if not isSignaturelessCompilerCallee(callee, funcSignatures: funcSignatures) 'ownedByTheCalleeDecider'
		return false
	end 'ownedByTheCalleeDecider'

	return trackedValueInArray(args, subject: subject, func: func)
end 'syncCallArgEscapes'

// ⭐ **AN `async` SPAWN'S ARGUMENT — THE ONE SLOT THE TWO SUBJECTS STILL ANSWER DIFFERENTLY.** A green thread
// runs past its spawner's frame, so an argument crossing into one is not handed DOWN, it is handed AWAY:
// there is deliberately no call-graph edge for a spawn (`collectCallParamEdgesAt`'s `asyncCall` arm), so a
// function-typed PARAMETER must escape here or nothing downstream will ever say it does. A capturing-closure
// LITERAL keeps the call-site delegation it has always had, which is the arrangement `checkCapturingClosureEscape`
// owns and this rung deliberately leaves alone.
function spawnArgEscapes(callee ByteArray, args ValueIdArray, subject EscapeScanSubject, func IrFunction, funcSignatures FuncSignatureMap) returns bool
	if subjectTracksCapturingClosures(subject) 'ownedByCallSiteCheck'
		return syncCallArgEscapes(callee, args: args, subject: subject, func: func, funcSignatures: funcSignatures)
	end 'ownedByCallSiteCheck'

	return trackedValueInArray(args, subject: subject, func: func)
end 'spawnArgEscapes'

// Does the TERMINATOR `term` persist a value `subject` tracks? Only a `ret` of the bare value does — a
// `condBranch` condition is a bool, a `branch`/`retVoid` carries no value, and an error terminator carries an
// error, never a function value. The bands range to `break` for the band-append invariant. No arm consults
// the subject beyond "is this value tracked": a return escapes for every subject alike, because the frame
// dies at it.
function terminatorEscapesValue(term MaxonOp, subject EscapeScanSubject, func IrFunction) returns bool
	match term 'term'
		call to literal then break 'term'
		ret(returned) then return isTrackedValue(returned, subject: subject, func: func)
		retVoid to tryAwait then break 'term'
		sizeofType then break 'term'
		constArrayLiteral then break 'term'
		// The jump table is a branch terminator — it escapes nothing (only `ret` of the value does).
		switch then break 'term'
		// A witness dispatch is a body op, never a terminator — it escapes nothing here (P1.7a slice 2a).
		witnessDispatch to witnessTryDispatch then break 'term'
		// A panic is a body op followed by a dead return, never a terminator.
		panicAbortValue then break 'term'
		// The error-flag encode is a BODY op — the routed edge's `branch` is what terminates its block.
		errorFlagEncode then break 'term'
		// Every service op is a BODY op — a spawn and a reply cell each define a value, and a send is a
		// statement of its own.
		serviceSpawn to serviceReplyCell then break 'term'
	end 'term'
	return false
end 'terminatorEscapesValue'

// Does an argument array hold a value `subject` tracks? A bounded scan (argument counts are register-capped),
// and allocation-free for the same reason the band matches are: it answers in a bool.
function trackedValueInArray(args ValueIdArray, subject EscapeScanSubject, func IrFunction) returns bool
	for argId in args 'each'
		if isTrackedValue(argId, subject: subject, func: func) 'found'
			return true
		end 'found'
	end 'each'
	return false
end 'trackedValueInArray'

// ⭐⭐ **THE INTERPROCEDURAL PARAMETER-MUTATION SUMMARY (E3019, the call-site half)** — for each function,
// which of its parameters a call to it WRITES. Read at every call site:
// an immutable binding handed to a written parameter is refused, which is the diagnostic the runnable
// oracle raises and the property the byte-string record-immortality work waits on.
//
// ⭐ **IT MUST BE A FIXPOINT, AND THE REASON IS ONE SENTENCE:** `f(x)` that hands `x` to `g(y)` that writes
// `y` writes ITS parameter too, so a function's answer depends on answers that are not yet known. A single
// pass over callees in declaration order gets that wrong for any callee declared after its caller, and a
// pass in CALL order does not terminate on a cycle — `rec(d, n)` calling itself, and `ping`/`pong` calling
// each other, are both ordinary Maxon. The least fixpoint is the only answer that is both order-independent
// and terminating.
//
// ⭐ **IT IS THE SAME WORKLIST SHAPE `Queries.foldDescriptorNeeds` AND THE TRANSITIVE-CONSUME FIXPOINT USE**,
// deliberately — a third idiom for "close a per-function fact under the call graph" would be one concept
// with three spellings. Termination is monotone-and-bounded: a mask only ever GAINS bits (`maskWithParam`
// never clears one) and a function has at most `MaxAbiArgs` of them, so a caller is re-enqueued only on a
// real change and the total number of enqueues is bounded by the program's parameter count.
//
// ⭐ **THE SEED IS THE PARSER'S, NOT A RE-DERIVATION.** `IrFunction.writtenParamMask` already says which
// parameters a body writes DIRECTLY, recorded at the one site that decides whether a receiver-writing method
// may be called at all (`Parser.noteReceiverWrite`). This pass adds only the transitive closure. A FIELD
// write records nothing, deliberately — see `Parser.receiverOwnerMask` for that ruling and the measured
// oracle inconsistency it settles. Re-deriving the base facts here —
// by matching the LOWERED runtime callees (`__managed_push`, `__managed_append`, `__list_append`) — would be a second
// list of receiver-writing operations, three tiers away from the one the parser consults, and the two would
// be free to disagree about a method added to either.
//
// ⭐ **THE ADJACENCY IS A `CsrGraph`, NOT A MAP OF PER-CALLEE LISTS**, because `CsrGraph.maxon`'s header says
// so in as many words — "a new adjacency belongs here rather than hand-rolled at its call site", and "one
// flat pair of columns instead of `Array with (a per-node array)`, which in Maxon is one heap-boxed,
// refcounted object per node". It was written the forbidden way first and MEASURED: on a maximal chain of N
// mutating functions (every function gains a bit, so every distinct callee earns a list), a
// `Map with (ByteArray, OpIndexArray)` index cost one array per callee and made `phase:semanticCheck` 3.1x
// the base at N = 6,400. The CSR costs two dense columns for the whole graph and takes the drain loop's
// hashing to zero — a callee is a function INDEX there, not a name.
//
// The published summary is likewise a DENSE column indexed by function, not a name→mask map: the call site
// resolves its callee's name once (`funcIndexByName`, which the edge walk already needs) and reads the mask
// off an i64 array. A map of masks would be a second index over the same key space, built by N upserts, to
// answer a question the first one already answers.
export type ParamMutationSummary
	// One mask per function of the merged module, by function index. Zero for the overwhelming majority.
	export let masks as ParamPositionMaskArray
	// ⭐⭐ **THE SECOND COLUMN, ANSWERING THE SECOND QUESTION** — see `IrFunction`'s table, where the pair is
	// defined and the ruling that separates them is cited. Same index space and the same fixpoint; the SEED
	// differs (a method writing a field of its own receiver) and so does the EDGE SET — this one closes over
	// `StorageReachEdge`s as well, which is what carries a write through a member the parser does not serve.
	// Two columns and one index rather than two summaries, for the reason the first one is a dense column
	// and not a map: the name resolution is already paid for.
	export let storageMasks as ParamPositionMaskArray
	// ⭐⭐ **THE THIRD COLUMN, ANSWERING THE WIDEST OF THE THREE QUESTIONS (W117)** — "does a call to this
	// function write the RECORD this parameter denotes, at all?". Same index space and the same fixpoint over
	// the same edges; the SEED is `IrFunction.writesThroughParamMask`, whose header carries the two
	// measurements that make it a third column rather than a reading of the other two.
	export let recordWriteMasks as ParamPositionMaskArray
	// Function NAME → its index in that column. A call site holds a name; every other consumer holds an index.
	export let funcIndexByName as FuncIndexByName

	export static function create(masks ParamPositionMaskArray, storageMasks ParamPositionMaskArray, recordWriteMasks ParamPositionMaskArray, funcIndexByName FuncIndexByName) returns ParamMutationSummary
		return Self{masks: masks, storageMasks: storageMasks, recordWriteMasks: recordWriteMasks, funcIndexByName: funcIndexByName}
	end 'create'

	// Which parameters a call to `callee` writes. `NoParamPositions` for a name the module does not declare —
	// a compiler-internal runtime entry, or an undeclared callee `validateCall` has already reported as
	// E3004 — the same "absence is the answer" `buildThrowsMap` uses, and the reason no caller needs a
	// membership test first.
	export function maskOf(callee ByteArray) returns ParamPositionMask
		return self.maskAt(self.masks, callee: callee)
	end 'maskOf'

	// Which parameters' ARRAY storage a call to `callee` writes — E3070's question, its own fields included.
	// ⚠ NOT a superset of `maskOf` above and not a subset: the two diverge in FOUR places, in both
	// directions, and `IrFunction`'s table enumerates them. Reading one where the other is meant is a wrong
	// answer with no compile error, which is why they are two named accessors and not one with a flag.
	export function storageMaskOf(callee ByteArray) returns ParamPositionMask
		return self.maskAt(self.storageMasks, callee: callee)
	end 'storageMaskOf'

	// ⭐ **WHICH PARAMETERS' RECORDS A CALL TO `callee` WRITES BY ANY MEANS (W117)** — read ONLY for an
	// argument that aliases an immutable global, which is what keeps E3019's scope for an ordinary immutable
	// binding byte-identical. ⚠ It is a superset of neither of the two above and a subset of neither; see
	// `IrFunction`'s table, which carries one row per question and now has four.
	export function recordWriteMaskOf(callee ByteArray) returns ParamPositionMask
		return self.maskAt(self.recordWriteMasks, callee: callee)
	end 'recordWriteMaskOf'

	// The one indexed read both columns share. `NoParamPositions` for a name the module does not declare — a
	// compiler-internal runtime entry, or an undeclared callee `validateCall` has already reported as E3004
	// — the same "absence is the answer" `buildThrowsMap` uses, and the reason no caller needs a membership
	// test first.
	function maskAt(column ParamPositionMaskArray, callee ByteArray) returns ParamPositionMask
		let index = try self.funcIndexByName.get(callee) otherwise return NoParamPositions
		return try column.get(index) otherwise panic("ParamMutationSummary.maskAt: function index {index} for '{String.from(callee)}' is outside the mask column — both are built over `module.functions` in one pass")
	end 'maskAt'
end 'ParamMutationSummary'

// The reverse-call-graph edges, as three dense scalar columns plus the CSR key column. Edge `k` says:
// "function `callerIndices[k]` passes its own parameter `callerParams[k]` as the argument filling parameter
// `calleeParams[k]` of function `calleeIndices[k]`." The CSR built over `calleeIndices` is what lets a bit
// toggled on a callee scan only the edges that can carry it.
//
// Dense columns rather than an `Array with <a record>`: a `type` has reference semantics, so an array of
// them is an array of POINTERS to heap-boxed records — one live allocation per edge, on a pass that runs
// over every call in the program. The same discipline `SourceRangeTable` and `ValueOriginTable` state.
type CallParamEdges
	export var calleeIndices as CsrColumn
	export var callerIndices as FuncIndexArray
	export var callerParams as ParamCountArray
	export var calleeParams as ParamCountArray

	export static function create() returns CallParamEdges
		return Self{calleeIndices: CsrColumn.create(), callerIndices: FuncIndexArray.create(), callerParams: ParamCountArray.create(), calleeParams: ParamCountArray.create()}
	end 'create'

	export function count() returns CsrIndex
		return self.calleeIndices.count()
	end 'count'

	// The four columns are only ever pushed together here, so they stay the same length by construction —
	// `pushCallArg`'s reason, reaching the third family of parallel columns in the compiler.
	export function record(calleeIndex FuncIndex, callerIndex FuncIndex, callerParam ParamCount, calleeParam ParamCount)
		self.calleeIndices.push(calleeIndex)
		self.callerIndices.push(callerIndex)
		self.callerParams.push(callerParam)
		self.calleeParams.push(calleeParam)
	end 'record'

	// The CSR over the callee key space: `graph.neighbour(calleeIndex, k)` is the k-th EDGE ROW reaching that
	// callee. The `to` column is the row number itself, which is what makes the other three columns readable
	// straight off a neighbour.
	export function byCallee(funcCount CsrIndex) returns CsrGraph
		var rows = CsrColumn.create()
		for k in 0 upto self.count() 'eachEdge'
			rows.push(k)
		end 'eachEdge'
		return buildCsr(self.calleeIndices, to: rows, nodeCount: funcCount)
	end 'byCallee'
end 'CallParamEdges'

// ⭐ **THERE IS NO TIE-BREAK HERE ANY MORE, AND THAT REPLACES AN ARGUMENT THAT HAD ALREADY BEEN WRONG
// TWICE (A1w).** This index was built FIRST-wins, on a comment asserting that a duplicate belonged to an
// "already-refused" program. It did not: the refusal is E4015 in the BACKEND, strictly after this pass, and
// `installManagedGlobalInit` appends the compiler's own `__module_init` / `__maxon_global_cleanup` into this
// same merged Maxon module (`Compiler.compileToCodeResult`) before the summary is built, so a
// `stdlib/Builtins.maxon` declaration of either name put two functions of one name in front of the loop
// (MEASURED: the whole pipeline ran, this pass silently kept the DECLARATION, and the backend refused seven
// passes later). The A2c review corrected the reason to a narrower true one — nothing between here and the
// backend emits code, so the tie-break could change which body was summarised but not what any program MEANT
// — which is a fine argument for the answer being harmless and no argument at all for it being made
// silently. `FunctionNameIndex` refuses the duplicate instead, so there is nothing left to break a tie over.
function buildParamMutationSummary(funcNames FunctionNameIndex, edges CallParamEdges, byCallee CsrGraph, storageEdges CallParamEdges) returns ParamMutationSummary
	let funcIndexByName = funcNames.byName

	// ⭐⭐ **TWO SEEDS, ONE FIXPOINT RUN TWICE — and since W58 the graph serves a THIRD seed one caller up.**
	// The parser records both per-function facts at the same doors (`Parser.noteReceiverWrite`,
	// `Parser.emitCheckedSelfFieldStore`); the CLOSURE is identical for all of them — "a callee that does X to
	// what it was handed makes its caller do X to what IT was handed" is one statement about one call graph —
	// so the walk that finds the edges runs ONCE, in `semanticCheck`, and is drained here twice and in
	// `buildEscapeSummary` a third time. That is what makes the transitive case work without a second rule:
	// `wipe()` calling a `reset()` that clears the receiver's field inherits the bit through the very same
	// edge E3019's column travels.
	//
	// ⚠⚠ **THE STORAGE COLUMN'S EDGE SET IS A SUPERSET, AND THIS PARAGRAPH SAID "SAME EDGES" UNTIL ARR4
	// MEASURED A USE-AFTER-FREE THROUGH THE DIFFERENCE.** E3019 asks about the ARGUMENT (is this value the
	// caller's parameter?); E3070 asks about the STORAGE (does the caller's parameter OWN the array this
	// receiver denotes?), and `self.items` answers no to the first and yes to the second. The extra rows are
	// `StorageReachEdge`'s — recorded by the parser, added by `collectStorageReachEdges`, and deliberately
	// absent from the owner column, where they would refuse a `let` receiver for a method writing its own
	// field. The two lists are the same OBJECT for a program that records none — no claim is made about how
	// often that is (any program reaching `stdlib/String.maxon`'s builder widens it), only that the identity
	// is exact when it holds, which is what lets the CSR be shared rather than guessed at.
	// Seeded from the INDEX's own array, not the module's, and the two are the same array: the masks are
	// addressed by POSITION and `funcIndexByName` resolves a name TO that position, so a seed walk over any
	// other array would leave every edge pointing at the wrong function's mask (A2l — the staleness
	// `FunctionNameIndex`'s header describes, made unspellable by taking the array off the index).
	var masks = ParamPositionMaskArray.create()
	var storageMasks = ParamPositionMaskArray.create()
	var recordWriteMasks = ParamPositionMaskArray.create()
	for func in funcNames.functions 'seed'
		masks.push(func.writtenParamMask)
		storageMasks.push(func.storageWrittenParamMask)
		recordWriteMasks.push(func.writesThroughParamMask)
	end 'seed'

	propagateParamMasks(masks, edges: edges, byCallee: byCallee)
	// ⭐ **W117's COLUMN DRAINS THE SAME RELATION A THIRD TIME, WHICH IS NOT A THIRD RELATION.** "A callee that
	// writes what it was handed makes its caller write what IT was handed" is one statement about one call
	// graph; the three columns differ only in what they were SEEDED with. It closes over the ARGUMENT edges
	// rather than the wider storage set because its question is about the argument: does the record this call
	// site handed over get written?
	propagateParamMasks(recordWriteMasks, edges: edges, byCallee: byCallee)

	// The CSR over the WIDER set is built HERE and not in `semanticCheck`, because this is its only reader.
	// A program that recorded no storage-reach edge closes both columns over one relation, so it reuses the
	// adjacency already built rather than paying for a byte-identical second one — the `is` is the identity
	// `collectStorageReachEdges` returns its own argument to make answerable, not a length comparison that
	// would be true by coincidence.
	let oneRelationForBothColumns = storageEdges is edges
	var storageByCallee = byCallee
	if not oneRelationForBothColumns 'aWiderRelation'
		storageByCallee = storageEdges.byCallee(funcNames.functions.count())
	end 'aWiderRelation'

	propagateParamMasks(storageMasks, edges: storageEdges, byCallee: storageByCallee)
	return ParamMutationSummary.create(masks, storageMasks: storageMasks, recordWriteMasks: recordWriteMasks, funcIndexByName: funcIndexByName)
end 'buildParamMutationSummary'

// ⭐⭐⭐ **THE STORAGE COLUMN'S EDGE SET: the argument-is-a-parameter edges above, PLUS the parser's
// receiver-owns-a-parameter's-array edges (ARR4).** `StorageReachEdge` carries the measurement — a
// use-after-free that compiled clean with the suite green over it — and the ruling that keeps these rows off
// E3019's column.
//
// ⚠ **THE BASE SET IS RETURNED UNCHANGED WHEN THERE IS NOTHING TO ADD**, which is not an optimisation
// dressed as a shortcut: the two columns then genuinely close over one relation and the caller's `is` test
// says so, where a copy would be a second list nothing keeps equal to the first.
function collectStorageReachEdges(base CallParamEdges, module MaxonModule, funcSignatures FuncSignatureMap, funcIndexByName FuncIndexByName) returns CallParamEdges
	var anyRecorded = false
	for func in module.functions 'anyToAdd'
		anyRecorded = anyRecorded or func.borrowFacts.storageReach.count() > 0
	end 'anyToAdd'

	if not anyRecorded 'theTwoColumnsCloseOverOneRelation'
		return base
	end 'theTwoColumnsCloseOverOneRelation'

	var edges = CallParamEdges.create()
	for k in 0 upto base.count() 'copyTheSharedRows'
		let callee = try base.calleeIndices.get(k) otherwise panic("collectStorageReachEdges: calleeIndices.get OOB at {k} inside count()")
		let caller = try base.callerIndices.get(k) otherwise panic("collectStorageReachEdges: callerIndices.get OOB at {k} — the four columns are parallel by construction")
		let callerParam = try base.callerParams.get(k) otherwise panic("collectStorageReachEdges: callerParams.get OOB at {k} — the four columns are parallel by construction")
		let calleeParam = try base.calleeParams.get(k) otherwise panic("collectStorageReachEdges: calleeParams.get OOB at {k} — the four columns are parallel by construction")
		edges.record(callee, callerIndex: caller, callerParam: callerParam, calleeParam: calleeParam)
	end 'copyTheSharedRows'

	for i in 0 upto module.functions.count() 'eachFunc'
		let func = try module.functions.get(i) otherwise panic("collectStorageReachEdges: functions.get OOB at {i}")
		for reach in func.borrowFacts.storageReach 'eachReach'
			addStorageReachEdges(reach, callerIndex: i, callerParamCount: func.paramCount, funcSignatures: funcSignatures, funcIndexByName: funcIndexByName, edges: edges)
		end 'eachReach'
	end 'eachFunc'
	return edges
end 'collectStorageReachEdges'

// One parser-recorded reach, expanded into one edge per caller parameter that owns the receiver's storage.
// Slotted through the shared `argSlotPosition` for `addCallParamEdges`' reason — a call summarised against
// one slotting and checked against another is the disagreement this whole rung is written to avoid — and the
// label is empty because a prepended receiver never carries one.
//
// A callee with no signature is skipped exactly as it is there: it is compiler-internal or undeclared, and
// either way has no mask for a bit to travel to.
function addStorageReachEdges(reach StorageReachEdge, callerIndex FuncIndex, callerParamCount ParamCount, funcSignatures FuncSignatureMap, funcIndexByName FuncIndexByName, edges CallParamEdges)
	let sig = try funcSignatures.get(reach.callee) otherwise return
	let calleeIndex = try funcIndexByName.get(reach.callee) otherwise return
	let pos = argSlotPosition(sig.paramNames, argIndex: reach.argColumn, label: EmptySourceText)
	if pos >= sig.paramCount() 'unslottable'
		return
	end 'unslottable'

	for param in 0 upto callerParamCount 'eachCallerParam'
		if maskHasParam(reach.callerParams, param: param) 'thisParameterOwnsTheStorage'
			edges.record(calleeIndex, callerIndex: callerIndex, callerParam: param, calleeParam: pos)
		end 'thisParameterOwnsTheStorage'
	end 'eachCallerParam'
end 'addStorageReachEdges'

// Walk every call in the program and record one edge per argument that IS one of the caller's own
// parameters. A caller with no parameters contributes none (nothing of its own can be passed on), which is
// the cheap gate that keeps `main` and every top-level driver out of the graph entirely.
function collectCallParamEdges(project Project, module MaxonModule, funcIndexByName FuncIndexByName) returns CallParamEdges
	var edges = CallParamEdges.create()
	for i in 0 upto module.functions.count() 'eachFunc'
		let func = try module.functions.get(i) otherwise panic("collectCallParamEdges: functions.get OOB at {i}")
		if func.paramCount == 0 'passesNothingOfItsOwn'
			continue
		end 'passesNothingOfItsOwn'

		for blockRef in func.blockRefs 'eachBlock'
			let block = try module.blocks.get(blockRef) otherwise panic("collectCallParamEdges: blockRef from func.blockRefs not in module.blocks")
			for opIdx in block.opRefs 'eachOp'
				collectCallParamEdgesAt(project, op: try module.ops.get(opIdx) otherwise panic("collectCallParamEdges: opIdx {opIdx} not in module.ops"), func: func, callerIndex: i, funcIndexByName: funcIndexByName, edges: edges)
			end 'eachOp'
		end 'eachBlock'
	end 'eachFunc'
	return edges
end 'collectCallParamEdges'

// The per-op arm of the edge walk. Only a call with a callee NAME can propagate: an `indirectCall` chooses
// its callee at run time and a `witnessDispatch` chooses it from a witness table, so neither has a summary
// to reach — see `checkImmutableArgToMutatingParam` for what that costs and why it is not refused instead.
// The non-call bands range to `break`, so a newly appended op fails to compile here rather than silently
// dropping out of the call graph (the band-append invariant).
function collectCallParamEdgesAt(project Project, op MaxonOp, func IrFunction, callerIndex FuncIndex, funcIndexByName FuncIndexByName, edges CallParamEdges)
	match op 'op'
		call(_, callee, args, argLabels, _, _, _, _) then addCallParamEdges(project, callee: callee, args: args, argLabels: argLabels, func: func, callerIndex: callerIndex, funcIndexByName: funcIndexByName, edges: edges)
		literal to stringLiteral then break 'op'
		tryCall(_, _, callee, args, argLabels, _, _, _, _) then addCallParamEdges(project, callee: callee, args: args, argLabels: argLabels, func: func, callerIndex: callerIndex, funcIndexByName: funcIndexByName, edges: edges)
		throwError to indirectCall then break 'op'
		// An `async` spawn runs CONCURRENTLY with its caller, so a write it makes is not ordered against the
		// caller's own use of the value. shv2 refuses a managed `async` argument outright
		// (`requireAsyncScalarParams`) and a scalar parameter cannot be written at all, so no spawn can carry
		// a mutation today; the arm states the exclusion rather than leaving it to that coincidence, which is
		// also what the bootstrap does (`CallEdgeKind.Direct` only).
		asyncCall then break 'op'
		await to tryAwait then break 'op'
		sizeofType then break 'op'
		constArrayLiteral then break 'op'
		switch then break 'op'
		witnessDispatch to witnessTryDispatch then break 'op'
		// A panic calls no user function, so it carries no mutation edge.
		panicAbortValue then break 'op'
		// The error-flag encode calls no user function, so it carries no mutation edge.
		errorFlagEncode then break 'op'
		// ⭐ **NO EDGE, AND THE REASON IS THE SAME ONE THE `asyncCall` ARM GIVES ONE LINE UP, SHARPENED.** This
		// summary answers *"does a call to this function WRITE the caller's own parameter?"*, and a message's
		// arguments are no longer the caller's: `Parser.moveIntoGreenThread` MOVED each of them into the
		// request box, so a handler writing one writes a value this frame has given up. A `serviceSpawn`'s
		// state is a factory's own fresh box and was never a parameter of anybody.
		serviceSpawn to serviceReplyCell then break 'op'
	end 'op'
end 'collectCallParamEdgesAt'

// Record the edges of ONE call: for each argument that is one of the caller's own parameters, the callee
// parameter position it fills. Slotted through the shared `argSlotPosition`, the same mapping
// `slotCallArgs` applies — a call summarised against one slotting and checked against another is the
// disagreement this whole rung is written to avoid.
//
// A callee with NO signature is skipped: it is either compiler-internal (`__managed_push` and friends, whose
// receiver writes the parser already recorded directly) or undeclared (E3004, reported by `checkCalls`).
// A label naming no parameter slots out of range and is skipped for the same reason — `slotCallArgs`
// reports it.
function addCallParamEdges(project Project, callee ByteArray, args ValueIdArray, argLabels ByteArrayArray, func IrFunction, callerIndex FuncIndex, funcIndexByName FuncIndexByName, edges CallParamEdges)
	let sig = try project.funcSignatures.get(callee) otherwise return
	let calleeIndex = try funcIndexByName.get(callee) otherwise return
	for i in 0 upto args.count() 'eachArg'
		let argId = try args.get(i) otherwise panic("addCallParamEdges: args.get OOB at {i}")
		if argId >= func.paramCount 'notOneOfOurParameters'
			continue
		end 'notOneOfOurParameters'

		let pos = argSlotPosition(sig.paramNames, argIndex: i, label: try argLabels.get(i) otherwise panic("addCallParamEdges: argLabels.get OOB at {i} — a call's argument columns are parallel by construction"))
		if pos >= sig.paramCount() 'unslottable'
			continue
		end 'unslottable'

		edges.record(calleeIndex, callerIndex: callerIndex, callerParam: argId, calleeParam: pos)
	end 'eachArg'
end 'addCallParamEdges'

// The least-fixpoint sweep. Seeded with every function that already writes something, it pulls a callee off
// the worklist, propagates its mask across its incoming edges, and re-enqueues a caller only when a bit
// actually changed — which is what bounds the total work and makes a recursive or mutually recursive graph
// terminate rather than spin. No hashing: the CSR is keyed by function index throughout.
function propagateParamMasks(masks ParamPositionMaskArray, edges CallParamEdges, byCallee CsrGraph)
	var worklist = FuncIndexArray.create()
	var queued = BoolArray.create()
	for i in 0 upto masks.count() 'seedWorklist'
		let mask = try masks.get(i) otherwise panic("propagateParamMasks: masks.get OOB at {i}")
		queued.push(mask != NoParamPositions)
		if mask != NoParamPositions 'writesSomething'
			worklist.push(i)
		end 'writesSomething'
	end 'seedWorklist'

	var head = 0 as CsrIndex
	while head < worklist.count() 'drain'
		let calleeIndex = try worklist.get(head) otherwise panic("propagateParamMasks: worklist.get OOB at {head}")
		head = head + 1
		try queued.set(calleeIndex, value: false) otherwise panic("propagateParamMasks: queued.set OOB at {calleeIndex}")
		propagateAcrossEdges(byCallee, masks: masks, edges: edges, calleeIndex: calleeIndex, worklist: worklist, queued: queued)
	end 'drain'
end 'propagateParamMasks'

// Propagate one callee's mask across every edge that reaches it, enqueueing each caller whose own mask grew.
function propagateAcrossEdges(byCallee CsrGraph, masks ParamPositionMaskArray, edges CallParamEdges, calleeIndex FuncIndex, worklist FuncIndexArray, queued BoolArray)
	let calleeMask = try masks.get(calleeIndex) otherwise panic("propagateAcrossEdges: masks.get OOB at {calleeIndex}")
	for k in 0 upto byCallee.degree(calleeIndex) 'eachEdge'
		let row = byCallee.neighbour(calleeIndex, k: k)
		let calleeParam = try edges.calleeParams.get(row) otherwise panic("propagateAcrossEdges: calleeParams.get OOB at {row}")
		if not maskHasParam(calleeMask, param: calleeParam) 'calleeDoesNotWriteThisOne'
			continue
		end 'calleeDoesNotWriteThisOne'

		let callerIndex = try edges.callerIndices.get(row) otherwise panic("propagateAcrossEdges: callerIndices.get OOB at {row}")
		let callerParam = try edges.callerParams.get(row) otherwise panic("propagateAcrossEdges: callerParams.get OOB at {row}")
		let before = try masks.get(callerIndex) otherwise panic("propagateAcrossEdges: masks.get OOB at {callerIndex}")
		let after = maskWithParam(before, param: callerParam)
		if after == before 'nothingNew'
			continue
		end 'nothingNew'

		try masks.set(callerIndex, value: after) otherwise panic("propagateAcrossEdges: masks.set OOB at {callerIndex}")
		let wasQueued = try queued.get(callerIndex) otherwise panic("propagateAcrossEdges: queued.get OOB at {callerIndex}")
		if wasQueued 'alreadyQueued'
			continue
		end 'alreadyQueued'

		try queued.set(callerIndex, value: true) otherwise panic("propagateAcrossEdges: queued.set OOB at {callerIndex}")
		worklist.push(callerIndex)
	end 'eachEdge'
end 'propagateAcrossEdges'

// True iff any bit is set — the "does this function mint a capturing closure at all?" gate that keeps the
// derived use-invariant scan off every closure-free function.
function boolArrayAny(bits BoolArray) returns bool
	for b in bits 'each'
		if b 'set'
			return true
		end 'set'
	end 'each'
	return false
end 'boolArrayAny'

// ⭐ **E3100 — LINEAR AWAIT (P1.5-B2a).** `await` is LINEAR: the green thread a promise names is awaited AT
// MOST ONCE on any single flow path. A second await REACHABLE from a first takes a second reference to a
// payload the awaited thunk owned only once — the two releases underflow the refcount and free it twice — so a
// reachable re-await is REFUSED, making the double free UNREPRESENTABLE rather than a runtime-survivable event.
// (A scalar promise owns no heap, but the rule is structural: at-most-once is exactly what lets a GT struct be
// recycled after its single await — OPEN #87.)
//
// ⭐⭐ **KEYED ON THE PROMISE'S SSA VALUE ID — a thesis-forced divergence from the bootstrap's GreenThreadId.**
// The bootstrap keys linearity on a synthetic GreenThreadId minted at each `async` spawn and carried across
// every alias and every cross-block re-read, BECAUSE its parser COPIES a promise value on `let q = p` and MINTS
// A FRESH SSA value on every cross-block read (`MaxonVarRefOp`) — so one thread wears many SSA ids and needs a
// second, stable identity laid over them. shv2 does NEITHER: `let q = p` binds `q` to `p`'s ValueId verbatim
// (`Parser.parseVariableReference` returns `binding.boundValue`), and a cross-block read resolves to that same
// ValueId (SSA dominance — there is no re-tagging op). So in shv2 the promise's SSA ValueId ALREADY IS the
// stable thread identity: aliasing shares it, cross-block reads share it, and a RE-ARM (`p = async g()`) mints a
// FRESH `asyncCall` ValueId — the new thread — automatically. A separate GreenThreadId column would be a 1:1
// relabelling of the `asyncCall`'s ValueId — one fact written twice, the exact regression this rewrite exists to
// remove. It is NOT the E3102 move model either: both names keep the shared ValueId LIVE and awaitable, so
// `let q = p; await p` (one await of the shared thread) is ACCEPTED; only a SECOND reachable await is refused.
//
// ⭐ **FLOW-SENSITIVE REACHABILITY, and the RE-ARM KILL is the DEFINITION, not a binding-reassignment op.** From
// each `await Vp`, walk the CFG forward; a second `await` of the SAME Vp reachable (INCLUDING via a loop
// back-edge) is the violation. A path is KILLED when it re-passes the `asyncCall` that DEFINES Vp — re-executing
// the spawn re-arms the promise with a fresh green thread, so an await after it is a FIRST await of a new
// instance. This is shv2's analogue of the bootstrap's "kill when the binding is reassigned": the bootstrap
// detects the re-arm as a `MaxonAssignOp` in the block stream, but shv2 emits NO op for a `var` rebind (SSA
// rebinds at parse time), so the ground-truth re-arm signal is re-passing the SSA DEFINITION. It separates the
// two loop shapes exactly: a promise spawned OUTSIDE a loop and awaited inside re-reaches its await without
// re-passing the definition (double-await-in-loop → REFUSED); a promise re-armed INSIDE the loop re-passes the
// definition before the await (await-aliased-loop-element → ACCEPTED, one await per iteration).
function checkLinearAwait(project Project, module MaxonModule)
	for func in module.functions 'eachFunc'
		checkLinearAwaitInFunction(project, module: module, func: func)
	end 'eachFunc'
end 'checkLinearAwait'

// Per-function driver. `functionConsumesAPromise` is the cheap, NON-ALLOCATING gate — mirroring `buildEscapeSummary`'s
// `functionHasFunctionParam` — that keeps the reachability machinery (its per-function block index, site list, and
// walk state) off every await-free function, which is the entire scale corpus. Reports the FIRST violation in op
// order and stops: a function with a double-await needs one diagnostic, and the deterministic op-order scan makes
// the choice worker-invariant.
function checkLinearAwaitInFunction(project Project, module MaxonModule, func IrFunction)
	if not functionConsumesAPromise(func, module: module) 'noConsume'
		return
	end 'noConsume'

	let sites = collectAwaitSites(func, module: module)
	let blockIndex = module.blockIndexById(func)
	for site in sites 'eachSite'
		if checkAwaitSite(project, module: module, blockIndex: blockIndex, func: func, site: site) 'reported'
			return
		end 'reported'
	end 'eachSite'
end 'checkLinearAwaitInFunction'

// Does `func`'s body CONSUME a green thread at all — an `await`, a `try await`, or a `__gt_promise_drop`?
// The gate that keeps the reachability walk off every promise-free function — a bounded tag check per op, no
// allocation, so it costs the scale corpus a scan and nothing more (`scale-test` measures memory; this
// allocates none).
//
// ⛔ **IT WAS "HAS AN `await`", AND THAT SKIPPED THE WHOLE CHECK FOR A FUNCTION WHOSE ONLY CONSUMES ARE
// CANCELS.** MEASURED the moment `p.cancel()` could compile: `p.cancel(); p.cancel()` linked and ran to a
// corrupted scheduler (exit 75) with the reachability walk never entered, while its `cancel`-then-`await`
// sibling — which does contain an `await` — was refused correctly. The gate has to admit exactly the sites
// `collectAwaitSites` collects, which is why both now read `PromiseConsume`'s definition of a consume.
function functionConsumesAPromise(func IrFunction, module MaxonModule) returns bool
	for blockRef in func.blockRefs 'eachBlock'
		let block = try module.blocks.get(blockRef) otherwise panic("functionConsumesAPromise: blockRef from func.blockRefs not in module.blocks")
		for opIdx in block.opRefs 'eachOp'
			if opConsumesAPromise(try module.ops.get(opIdx) otherwise panic("functionConsumesAPromise: opIdx {opIdx} not in module.ops")) 'aConsume'
				return true
			end 'aConsume'
		end 'eachOp'
	end 'eachBlock'
	return false
end 'functionConsumesAPromise'

// Is THIS op a consume? An expression, not a `then`-arm scan, and that is the fix rather than a style
// choice: written as arms, the `call` arm's verdict has to be a `return` — and a `return false` for an
// ORDINARY call abandons the whole walk at the first `File.exists(…)` in the function. MEASURED: it turned
// `error.double-await-through-alias-in-branch` and `error.double-await-after-ternary-arm` green-by-silence,
// two programs whose entire subject is that E3100 fires on them.
function opConsumesAPromise(op MaxonOp) returns bool
	return match op 'op'
		call(_, callee, _, _, _, _, _, _) gives calleeReclaimsAPromise(callee)
		literal to indirectCall gives false
		asyncCall gives false
		await to tryAwait gives true
		sizeofType gives false
		constArrayLiteral gives false
		switch gives false
		witnessDispatch to witnessTryDispatch gives false
		panicAbortValue gives false
		// The error-flag encode neither spawns nor consumes — it is arithmetic.
		errorFlagEncode gives false
		// A SERVICE's green thread is not a promise and neither op reclaims one — a Promise may not be sent at
		// all (`Parser.moveIntoGreenThread` refuses it), which is what keeps this answer true.
		serviceSpawn to serviceReplyCell gives false
	end 'op'
end 'opConsumesAPromise'

// One first-await to check: the block and body position of the `await`, and the promise `ValueId` it awaits —
// which IS the green-thread identity (see the header). Collected in op order so the FIRST violation reported is
// deterministic (worker-invariant). Only built for await-bearing functions, behind the `functionHasAwait` gate.
type AwaitSite
	export let block as IrBlock
	export let pos as BlockOpPos
	export let promise as ValueId
	// WHICH consume this site is. It decides the SENTENCE and nothing else — the rule is one rule — because
	// "already been ..." is a claim about the FIRST consume, and a diagnostic that said "awaited" of a
	// `p.cancel()` would be describing a line the author did not write.
	export let kind as PromiseConsume

	export static function create(block IrBlock, pos BlockOpPos, promise ValueId, kind PromiseConsume) returns AwaitSite
		return Self{block: block, pos: pos, promise: promise, kind: kind}
	end 'create'
end 'AwaitSite'

typealias AwaitSiteArray = Array with AwaitSite

function collectAwaitSites(func IrFunction, module MaxonModule) returns AwaitSiteArray
	var sites = AwaitSiteArray.create()
	for blockRef in func.blockRefs 'eachBlock'
		let block = try module.blocks.get(blockRef) otherwise panic("collectAwaitSites: blockRef from func.blockRefs not in module.blocks")
		for pos in 0 upto block.opRefs.count() 'eachOp'
			let opIdx = try block.opRefs.get(pos) otherwise panic("collectAwaitSites: opRefs.get OOB at {pos}")
			match try module.ops.get(opIdx) otherwise panic("collectAwaitSites: opIdx {opIdx} not in module.ops") 'op'
				// ⭐ A `p.cancel()` is a consume site (P1.5-B2c) — see `PromiseConsume`. It is recognized by
				// CALLEE and not by a source flag, which also takes in the SCOPE-EXIT drop the parser emits for
				// an un-consumed promise; that is correct rather than incidental, because a scope drop
				// reachable from an await would reclaim the same struct twice. It cannot fire spuriously: the
				// parser emits one only when `consumePromiseThread` has NOT run, i.e. exactly when this walk
				// finds no other consume to pair it with.
				call(_, callee, args, _, _, _, _, _) then pushIfPromiseDrop(sites, block: block, pos: pos, callee: callee, args: args)
				literal to indirectCall then break 'op'
				asyncCall then break 'op'
				await (_, promise) then sites.push(AwaitSite.create(block, pos: pos, promise: promise, kind: PromiseConsume.awaited))
				// A `try await` awaits (and consumes) its promise exactly as a plain `await` does — linearity
				// is a property of the green thread, not of whether the error is caught — so it is an await site.
				tryAwait(_, _, promise) then sites.push(AwaitSite.create(block, pos: pos, promise: promise, kind: PromiseConsume.awaited))
				sizeofType then break 'op'
				constArrayLiteral then break 'op'
				switch then break 'op'
				witnessDispatch to witnessTryDispatch then break 'op'
				panicAbortValue then break 'op'
				// The error-flag encode is not an await site: it reads an enum value, never a promise handle.
				errorFlagEncode then break 'op'
				// ⚠ **NO service op awaits or cancels, AND SV2 DID NOT CHANGE THAT — the REASON changed.** SV1's
				// comment here said a send has no reply to wait on, which stopped being true: an awaitable send
				// mints a reply CELL beside itself. What is still true is that the cell op only DEFINES the
				// promise; the `await`/`tryAwait` op above is the site, exactly as it is for an `async` spawn.
				serviceSpawn to serviceReplyCell then break 'op'
			end 'op'
		end 'eachOp'
	end 'eachBlock'
	return sites
end 'collectAwaitSites'

// ⭐ **WHICH CALLEE RECLAIMS A GREEN THREAD — the ONE test the three walk doors share.** The gate
// (`functionConsumesAPromise`), the site collector (`pushIfPromiseDrop`) and the re-consume classifier
// (`reconsumeRoleIfPromiseDrop`) must admit exactly the same calls: a gate narrower than the collector skips
// the check on a program that has one (measured — see `functionConsumesAPromise`), and a classifier narrower
// than the collector starts a walk that can never find its pair.
function calleeReclaimsAPromise(callee ByteArray) returns bool
	return callee.equals(GtPromiseDropName)
end 'calleeReclaimsAPromise'

// Record a `__gt_promise_drop(p)` call as a CANCEL site. Split out so the `call` arm above stays one
// statement, and so the "which callee reclaims a green thread" test has one home shared with
// `classifyOpForPromise`'s matching arm.
function pushIfPromiseDrop(sites AwaitSiteArray, block IrBlock, pos BlockOpPos, callee ByteArray, args ValueIdArray)
	if not calleeReclaimsAPromise(callee) 'notAReclaim'
		return
	end 'notAReclaim'

	sites.push(AwaitSite.create(block, pos: pos, promise: try args.get(0) otherwise panic("pushIfPromiseDrop: `{String.from(GtPromiseDropName)}` was emitted with no argument — every emitter passes the promise handle"), kind: PromiseConsume.cancelled))
end 'pushIfPromiseDrop'

// Check one await site; report E3100 and return `true` iff a second await of its thread is reachable from it.
function checkAwaitSite(project Project, module MaxonModule, blockIndex BlockIndexById, func IrFunction, site AwaitSite) returns bool
	match reachableReawait(module, blockIndex: blockIndex, func: func, startBlock: site.block, startPos: site.pos, promise: site.promise) 'reach'
		found(secondOpIdx) then return reportedViolation(project, func: func, secondOpIdx: secondOpIdx, first: site.kind)
		none then break 'reach'
	end 'reach'
	return false
end 'checkAwaitSite'

// Report E3100 at the SECOND await's own `await`-keyword span — the await that is "already" spent, matching the
// reference compiler's anchor — and return `true` so the caller stops at the first violation. Never spells the
// number: `ErrorCode.promiseAlreadyAwaited` is the registry member.
function reportedViolation(project Project, func IrFunction, secondOpIdx OpIndex, first PromiseConsume) returns bool
	let range = project.opRanges.get(secondOpIdx)
	reportPositioned(project, code: ErrorCode.promiseAlreadyAwaited, message: alreadyConsumedMessage(first), line: range.line, column: range.column, filePath: func.sourceFilePath)
	return true
end 'reportedViolation'

// ⚠ **THE SENTENCE IS CHOSEN BY THE *FIRST* CONSUME, NOT THE SECOND, because "already been ..." is a claim
// about the first.** So the awaited arm carries the wording the corpus pins byte-for-byte across five cases
// and covers `await` then `cancel` as well as `await` then `await` — it HAS already been awaited in both.
// The cancelled arm is the one sentence this rung adds, and it exists because telling an author their
// `p.cancel()` had "already been awaited" would describe a line their program does not contain.
function alreadyConsumedMessage(first PromiseConsume) returns String
	match first 'first'
		notConsumed then panic("alreadyConsumedMessage: asked for the words of a promise nothing consumed — every site this walk collects is an `await`, a `tryAwait` or a `__gt_promise_drop`, and each of those names its door")
		awaited then return "this promise has already been awaited: 'await' is linear — a promise is awaited exactly once, because the awaited thunk hands its result over and a second await would release it twice"
		cancelled then return "this promise has already been cancelled: 'cancel' reclaims the green thread's struct, so awaiting or cancelling it again reads a struct the scheduler may already have handed to another spawn"
	end 'first'
end 'alreadyConsumedMessage'

// The outcome of scanning one block's body ops for a re-await of the tracked promise.
union AwaitScan
	// A second `await` of the tracked promise — its flat op index, which keys the diagnostic's source span.
	foundSecond(secondOpIdx OpIndex)
	// The tracked promise's DEFINING `asyncCall` was re-passed: the promise is re-armed here (a fresh green
	// thread), so this path is dead for the await the walk started from.
	rearmed
	// Neither — control ran off the block's body; follow its successors.
	ranOff
end 'AwaitScan'

// The result of the whole reachability walk from one first-await.
union ReachableReawait
	found(secondOpIdx OpIndex)
	none
end 'ReachableReawait'

// One op's relation to the tracked promise, so `scanBlockForReawait`'s arms stay single statements.
union OpAwaitRole
	// The op is an `await` whose operand is the tracked promise (a re-await).
	reawaitOf
	// The op is the `asyncCall` that defines (re-arms) the tracked promise.
	rearmOf
	// The op touches the tracked promise in neither way.
	unrelated
end 'OpAwaitRole'

// Is a second `await` of `promise` reachable from the first await at `(startBlock, startPos)`? Walks the CFG
// forward: the start block's TAIL (strictly after the first await), then a breadth-first sweep of successors,
// each block entered from its top at most once (`visited`). A path DIES at the `asyncCall` that re-defines
// `promise` (the re-arm). A block reached again via a loop back-edge is scanned from the top — which is what
// makes a single lexical await inside a loop reach ITSELF and be refused.
function reachableReawait(module MaxonModule, blockIndex BlockIndexById, func IrFunction, startBlock IrBlock, startPos BlockOpPos, promise ValueId) returns ReachableReawait
	match scanBlockForReawait(module, block: startBlock, from: startPos + 1, promise: promise) 'tail'
		foundSecond(idx) then return ReachableReawait.found(idx)
		// SSA guarantees the definition dominates (precedes) the await, so a re-arm cannot sit in the tail —
		// but the arm is handled rather than assumed, so a future non-SSA shape cannot fall through silently.
		rearmed then return ReachableReawait.none
		ranOff then break 'tail'
	end 'tail'

	var visited = BlockIdSet.create()
	var worklist = BlockIdArray.create()
	collectAwaitSuccessors(module, block: startBlock, into: worklist)

	var head = 0 as BlockOpPos
	while head < worklist.count() 'bfs'
		let blockId = try worklist.get(head) otherwise panic("reachableReawait: worklist.get OOB at {head}")
		head = head + 1
		if visited.contains(blockId) 'seen'
			continue
		end 'seen'
		visited.insert(blockId)

		let position = try blockIndex.get(blockId) otherwise panic("reachableReawait: successor BlockId {blockId} is not a block of this function")
		let blockRef = try func.blockRefs.get(position) otherwise panic("reachableReawait: blockIndexById placed block {blockId} at position {position}, which is past func.blockRefs")
		let block = try module.blocks.get(blockRef) otherwise panic("reachableReawait: blockRef from func.blockRefs not in module.blocks")
		// ⭐⭐ **A BLOCK ARG IS RE-DEFINED ON EVERY ENTRY TO ITS BLOCK, AND THAT IS A RE-ARM THE OP SCAN
		// STRUCTURALLY CANNOT SEE.** `maxonOpResultValue` answers for ops, and a phi is defined by NO op
		// (`ValueOrigin`'s header says so in as many words), so a loop whose promise `var` is re-armed in its
		// body reaches its own header carrying a FRESH thread in the same ValueId — which is exactly the
		// "re-passes the definition" this walk's header describes, spelled at a block entry instead of at an op.
		//
		// ⛔ **MEASURED AS A FALSE REFUSAL the moment reclaim sites joined the walk**: `while … p = async f() …`
		// emits the re-arm's `__gt_promise_drop` of the phi in the body, and the back edge carried the walk
		// straight back onto it — `async-promise-drop.rearm-var-across-loop` and `.await-rearmed-loop-var`, two
		// programs whose whole subject is that this is legal, both went red.
		//
		// ⚠ It is only sound because a phi genuinely IS a new instance per entry: two consumes on ONE trip
		// through the loop both precede the back edge and are still found by the scan below.
		if blockRedefinesPromise(block, promise: promise) 'reArmedAtEntry'
			continue
		end 'reArmedAtEntry'

		match scanBlockForReawait(module, block: block, from: 0, promise: promise) 'scan'
			foundSecond(idx) then return ReachableReawait.found(idx)
			// Re-armed here — do NOT follow this block's successors; the promise past this point is a new thread.
			rearmed then break 'scan'
			ranOff then collectAwaitSuccessors(module, block: block, into: worklist)
		end 'scan'
	end 'bfs'

	return ReachableReawait.none
end 'reachableReawait'

// Does entering `block` re-define the tracked promise — i.e. does it carry it as a BLOCK ARG? See the call
// site for why a phi entry is a re-arm.
function blockRedefinesPromise(block IrBlock, promise ValueId) returns bool
	for arg in block.blockArgs 'eachArg'
		if arg.valueId == promise 'isThePromise'
			return true
		end 'isThePromise'
	end 'eachArg'
	return false
end 'blockRedefinesPromise'

// Scan `block`'s body ops from position `from` for the tracked promise: a re-await (`foundSecond`), the
// re-arming definition (`rearmed`), or neither (`ranOff`). Only BODY ops (`opRefs`) can be an `await`/`asyncCall`
// — a terminator is a branch/return, handled by `collectAwaitSuccessors` — so this never inspects the terminator.
function scanBlockForReawait(module MaxonModule, block IrBlock, from BlockOpPos, promise ValueId) returns AwaitScan
	for pos in from upto block.opRefs.count() 'eachOp'
		let opIdx = try block.opRefs.get(pos) otherwise panic("scanBlockForReawait: opRefs.get OOB at {pos}")
		match classifyOpForPromise(try module.ops.get(opIdx) otherwise panic("scanBlockForReawait: opIdx {opIdx} not in module.ops"), promise: promise) 'role'
			reawaitOf then return AwaitScan.foundSecond(opIdx)
			rearmOf then return AwaitScan.rearmed
			unrelated then break 'role'
		end 'role'
	end 'eachOp'
	return AwaitScan.ranOff
end 'scanBlockForReawait'

// Classify `op` against the tracked promise: an `await`/`tryAwait` OF it is a re-await, and an op that
// DEFINES it is the re-arm.
//
// ⭐⭐ **THE RE-ARM IS "THE OP THAT DEFINES Vp", NOT "AN `asyncCall` THAT DEFINES Vp" (P1.5-B2c).** The rule
// this walk's header states has always been the general one — *"a path is KILLED when it re-passes the SSA
// DEFINITION of Vp"* — and the implementation read only the `asyncCall` arm, which was the same thing for
// exactly as long as a promise could only come from a spawn in this frame. Storage ended that: a promise
// pulled out of a container is defined by the element accessor's `call`/`tryCall`, so
//
//     for p in promises 'await' … await p … end 'await'
//
// re-passed no `asyncCall` and the single `await p` was reported as a second await of itself — E3100 on the
// central idiom `specs/async-await.md` names in its own prose (*"which is exactly what makes `for p in
// promises … await p … end` one await per promise"*). Reading the DEFINITION through the exhaustive
// `maxonOpResultValue` restores the stated rule and takes the op enumeration with it: a new op variant is a
// compile error THERE rather than a silently-unrecognized definition here.
//
// ⚠ **THE RE-AWAIT TEST COMES FIRST, BECAUSE AN `await` OP IS BOTH.** It defines its result and reads its
// promise, and the walk starts AT an await — asking "does it define Vp?" first would classify the tracked
// await's own successors by the wrong role the moment an await's result ever became a promise.
//
// ⛔ **AND THAT IS ONLY TRUE IF THE await ARMS FALL THROUGH WHEN THE AWAITED VALUE IS NOT Vp, WHICH THEY DO —
// THEY USED TO RETURN UNCONDITIONALLY.** A `roleIfEqual(...)` returned straight out answers `unrelated` for an
// await of a DIFFERENT promise and so never reaches the definition test, which is the exact opposite of the
// robustness the paragraph above claims: the day an await's result could itself be a promise, an `await q`
// DEFINING the tracked `p` would be filed `unrelated` and the re-arm would be lost. Nothing can produce that
// shape today (an async body cannot return a `Promise`), so this changes no current answer — it makes the
// stated rule the one the code actually follows, which is cheaper than a comment explaining why it does not.
function classifyOpForPromise(op MaxonOp, promise ValueId) returns OpAwaitRole
	match op 'op'
		// A `call` is the ONE op that can be either role, so its arm asks both — see `callRoleForPromise`.
		call(result, callee, args, _, _, _, _, _) then return callRoleForPromise(result, callee: callee, args: args, promise: promise)
		literal to indirectCall then break 'op'
		asyncCall then break 'op'
		await (_, awaited) then return awaitRoleForPromise(op, awaited: awaited, promise: promise)
		// A `try await` of the tracked promise is a re-await exactly as a plain `await` is.
		tryAwait(_, _, awaited) then return awaitRoleForPromise(op, awaited: awaited, promise: promise)
		sizeofType then break 'op'
		constArrayLiteral then break 'op'
		// The jump table reads an integer index, never a promise handle — unrelated to any await.
		switch then break 'op'
		witnessDispatch to witnessTryDispatch then break 'op'
		// A rendered panic reads a byte pointer, never a promise handle.
		panicAbortValue then break 'op'
		// The error-flag encode reads an enum tag or a box pointer, never a promise handle.
		errorFlagEncode then break 'op'
		// No service op re-awaits: a spawn DEFINES a mailbox pointer and a reply cell DEFINES a promise (so
		// both fall through to the re-arm test below, exactly as a `call` does), and a send reads a mailbox
		// and a box, never a promise handle.
		serviceSpawn to serviceReplyCell then break 'op'
	end 'op'
	return rearmRoleIfDefines(op, promise: promise)
end 'classifyOpForPromise'

// An `await` / `try await` op asked BOTH questions in the order its header states: is it a re-await of the
// tracked promise, and — if it awaited some OTHER promise — is it the DEFINITION of the tracked one? The
// second can only fire once an await's result can itself be a promise; asking it costs one comparison and is
// what makes "the re-await test comes first" a statement about ORDER rather than about the only test there is.
function awaitRoleForPromise(op MaxonOp, awaited ValueId, promise ValueId) returns OpAwaitRole
	if awaited == promise 'aReawait'
		return OpAwaitRole.reawaitOf
	end 'aReawait'

	return rearmRoleIfDefines(op, promise: promise)
end 'awaitRoleForPromise'

// `rearmOf` when `op` is the definition of the tracked promise — see `classifyOpForPromise`'s header. Ops
// that define no value (`ret`, the branches, a store, a throw) can define nothing and answer `unrelated`.
// ⭐⭐ **A `call` IS THE ONE OP THAT CAN PLAY EITHER ROLE, AND IT MUST BE ASKED BOTH QUESTIONS.**
//   • `__gt_promise_drop(p)` RECLAIMS the tracked thread — a re-consume, exactly as an `await` is.
//   • any other call that DEFINES the tracked value RE-ARMS it — which is how `for p in promises` works,
//     the element accessor being the definition re-passed on every iteration.
//
// ⛔ **AND ANSWERING ONLY THE FIRST IS A FALSE REFUSAL.** An arm that returned the reclaim verdict and
// stopped never reached the definition test, so the four container-loop cases went red again with the
// single `await p` in their loop reported as a second await of itself. The two questions are disjoint by
// construction — a reclaim call's result is a void the source cannot name — so the order is free and the
// omission is silent, which is exactly why both are asked here in one place.
function callRoleForPromise(result ValueId, callee ByteArray, args ValueIdArray, promise ValueId) returns OpAwaitRole
	if calleeReclaimsAPromise(callee) 'aReclaim'
		return roleIfEqual(try args.get(0) otherwise panic("callRoleForPromise: `{String.from(GtPromiseDropName)}` was emitted with no argument — every emitter passes the promise handle"), promise: promise, role: OpAwaitRole.reawaitOf)
	end 'aReclaim'

	return roleIfEqual(result, promise: promise, role: OpAwaitRole.rearmOf)
end 'callRoleForPromise'

function rearmRoleIfDefines(op MaxonOp, promise ValueId) returns OpAwaitRole
	return match maxonOpResultValue(op) 'defined'
		none gives OpAwaitRole.unrelated
		value(id) gives roleIfEqual(id, promise: promise, role: OpAwaitRole.rearmOf)
	end 'defined'
end 'rearmRoleIfDefines'

// `role` when `value` is the tracked promise, else `unrelated` — the equality test the two async arms share.
function roleIfEqual(value ValueId, promise ValueId, role OpAwaitRole) returns OpAwaitRole
	if value == promise 'equal'
		return role
	end 'equal'
	return OpAwaitRole.unrelated
end 'roleIfEqual'

// Append `block`'s CFG successor BlockIds to `into`. Successors come from the block's TERMINATOR op — a
// `branch` (one target) or a `condBranch` (two) — never from a body op; every other terminator (`ret`/`retVoid`
// /`throwError`/`propagateError`/`panicAbort`) leaves the function and has no in-function successor. A block
// with no terminator op (`dead`/`unset`) has none.
function collectAwaitSuccessors(module MaxonModule, block IrBlock, into BlockIdArray)
	if not block.hasTerminatorOp() 'noTerminator'
		return
	end 'noTerminator'
	match try module.ops.get(block.terminatorIndex()) otherwise panic("collectAwaitSuccessors: terminatorIndex not in module.ops") 'term'
		call to compare then break 'term'
		condBranch(_, thenBlockId, elseBlockId) then pushSuccessorPair(into, thenId: thenBlockId, elseId: elseBlockId)
		branch(targetBlockId) then into.push(targetBlockId)
		globalAddr to tryAwait then break 'term'
		sizeofType then break 'term'
		constArrayLiteral then break 'term'
		// A jump table's successors are its distinct case targets plus the default — enumerated for the
		// await-CFG walk exactly as `collectBlockSuccessorIds` does at the Target tier (deduped: a range/`or`
		// arm fills several slots with one block, but the CFG has one edge to it).
		switch(_, denseTargetBlockIds, defaultBlockId) then pushMaxonSwitchSuccessors(into, denseTargetBlockIds: denseTargetBlockIds, defaultBlockId: defaultBlockId)
		// A witness dispatch is a body op, never a terminator — it has no in-function successor (P1.7a slice 2a).
		witnessDispatch to witnessTryDispatch then break 'term'
		// A panic is a body op followed by a dead return, never a terminator.
		panicAbortValue then break 'term'
		// The error-flag encode is a BODY op, so it is never the terminator whose successors this walks.
		errorFlagEncode then break 'term'
		// Every service op is a BODY op, so none is the terminator whose successors this walks.
		serviceSpawn to serviceReplyCell then break 'term'
	end 'term'
end 'collectAwaitSuccessors'

// Push a Maxon `switch`'s distinct successor block ids into `into`: the default plus each distinct case
// target in first-appearance order, one edge per distinct successor (a dense table repeats a block across
// many slots). The distinct set comes from the shared O(slots) `distinctSwitchTargets` — a per-slot linear
// membership scan here was O(slots × distinct), quadratic in the arm count of an all-distinct dense match.
function pushMaxonSwitchSuccessors(into BlockIdArray, denseTargetBlockIds BlockIdArray, defaultBlockId BlockId)
	into.push(defaultBlockId)
	for target in distinctSwitchTargets(denseTargetBlockIds, exclude: defaultBlockId) 'eachDistinct'
		into.push(target)
	end 'eachDistinct'
end 'pushMaxonSwitchSuccessors'

// Append a conditional branch's two successors — factored out so the `condBranch` arm above is one statement.
function pushSuccessorPair(into BlockIdArray, thenId BlockId, elseId BlockId)
	into.push(thenId)
	into.push(elseId)
end 'pushSuccessorPair'

// Validate every `call` op against its callee's signature. Walked by FUNCTION (not the
// flat op array) so each call's diagnostic can name its declaring file (`func.sourceFilePath`);
// the flat op INDEX still keys the call-site span in `project.opRanges`. Calls are body
// ops (never terminators), so only `block.opRefs` is scanned.
function checkCalls(project Project, module MaxonModule, signatures ProgramSignatures, funcNames FunctionNameIndex, throwsMap FuncThrowsMap, escapeSummary ParamEscapeSummary, mutationSummary ParamMutationSummary)
	// ⚠ **THE MEMO IS NOT AN OPTIMIZATION** — the note `LowerMaxonToStd.witnessSlotsOf` carries, one pass
	// over. `interfaceWitnessSlots` walks the `extends` graph and builds a fresh array plus a visited set on
	// every call; asked once per dispatch OP that is a quadratic in a program's dispatch count. The list is a
	// pure function of the interface, which is fixed before any body is parsed, so it is built on the FIRST
	// dispatch through each interface and held. Declared here rather than inside the walk because the walk is
	// per op and this must outlive every one of them.
	var witnessSlots = WitnessSlotsByDeclIndex.create()
	for func in module.functions 'eachFunc'
		// A STDLIB function no path from `main` reaches is code dead-function elimination will drop
		// before the back end, so a check here would report a defect in code the program does not
		// contain. The one that would fire is E3104 — Clock's body reaches
		// `__gt_now_ns`/`__clock_now_unix_s`, x64-only — and firing it on a wasm/arm64 program that
		// never reads a clock would refuse a compile that contains no clock (see Compiler.maxon /
		// StdlibSource). A REACHABLE Clock on wasm is NOT in this set, so a program that genuinely
		// reads the clock still gets its E3104 — at the CROSSING call, not here.
		if project.stdlibFacts.unreachable.contains(func.name) 'notInTheProgram'
			continue
		end 'notInTheProgram'
		// ⭐ **WHO IS BLAMED FOR A TARGET-UNSUPPORTED CALLEE, DECIDED ONCE PER FUNCTION.** Two conditions,
		// both constant for a whole function, so both are settled here rather than at every call op:
		//
		//   • the TARGET must be one that can refuse anything at all. On x64-windows nothing is, and the
		//     second question below costs a hash of the function's name — once per function of the whole
		//     program — so the `and` short-circuits it away on the default target.
		//   • the function must be USER source. A stdlib body is checked like any other EXCEPT for the
		//     E3104 target gate: its substrate requirement is reported at the USER call that crossed INTO
		//     stdlib (`requireTargetSupportsCallee`), and repeating it here would position a second
		//     diagnostic at `stdlib/Clock.maxon:L:C` — a file the user never opened and cannot change.
		//     Keyed on stdlib-vs-user source, the fact that stays true as stdlib grows from one module to
		//     all of it.
		let blameTargetErrorsHere = not targetProvidesEveryFacility(project.target) and not isStdlibFunction(project, func: func)
		for blockRef in func.blockRefs 'eachBlock'
			let block = try module.blocks.get(blockRef) otherwise panic("checkCalls: blockRef from func.blockRefs not in module.blocks")
			for opIdx in block.opRefs 'eachOp'
				let op = try module.ops.get(opIdx) otherwise panic("checkCalls: opIdx {opIdx} not in module.ops")
				match op 'op'
					// A PLAIN call — its args are validated, and a call to a THROWING callee that is not
					// under a `try` is E3057 (it is a `call`, not a `tryCall`, precisely because no `try`
					// covered it).
					call(result, callee, args, argLabels, argRanges, argImmutableNames, argDefaultSlots, mint) then validatePlainCall(project, func: func, signatures: signatures, funcNames: funcNames, opIndex: opIdx, result: result, callee: callee, mint: mint, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: argImmutableNames, argDefaultSlots: argDefaultSlots, throwsMap: throwsMap, escapeSummary: escapeSummary, mutationSummary: mutationSummary, blameTargetErrorsHere: blameTargetErrorsHere)
					// Extended past `branch` to take in the varAccess band and the `stringLiteral` op: a
					// global's address/load/store and a string literal are not calls and have nothing for
					// this check to say. Their CALLEE-shaped question — "does this name resolve?" — was
					// answered before the op was emitted (`ProgramSignatures` for a global; a literal
					// resolves nothing), which is why there is no E3004 twin for either.
					literal to stringLiteral then break 'op'
					// A `tryCall`'s args are validated exactly like a `call`'s (it IS a call plus a flag);
					// its throws-compatibility (E3055) was checked by the parser at the `try` token.
					tryCall(result, _, callee, args, argLabels, argRanges, argImmutableNames, argDefaultSlots, mint) then validateCall(project, func: func, signatures: signatures, funcNames: funcNames, opIndex: opIdx, result: result, callee: callee, mint: mint, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: argImmutableNames, argDefaultSlots: argDefaultSlots, escapeSummary: escapeSummary, mutationSummary: mutationSummary, blameTargetErrorsHere: blameTargetErrorsHere)
					// The error terminators and the panic op read no callee signature.
					throwError to panicAbort then break 'op'
					// P1.5-A1: a `functionRef`'s "does this function name resolve?" was answered by the parser
					// (`emitFunctionRef` checks `returnTypeOf`, else E2004). The TARGET gate is what this pass
					// has to say about it: taking a STDLIB function's ADDRESS reaches its body exactly
					// as a call does (it is one of the four edges `markMaxonCalleeEdge` counts), so the
					// crossing is refused at the span where the address is taken. An `indirectCall`'s callee
					// is a VALUE, whose `functionRef` was already gated here.
					functionRef(_, funcName) then requireTargetSupportsCallee(project, func: func, opIndex: opIdx, callee: funcName, noun: funcName, blameTargetErrorsHere: blameTargetErrorsHere)
					// An INDIRECT call is validated against the function type its callee VALUE was declared
					// with — the arity and the argument types a direct call gets from `funcSignatures`. It is
					// this pass's to make for the same reason a direct call's is: the declared type is a
					// whole-program fact (a function alias, or the callee function's own signature) and the
					// types must be RESOLVED to compare, neither of which is true at parse.
					//
					// ⚠ It hands the WHOLE op on to be re-matched rather than destructuring it here, for the
					// reason `LowerMaxonToStd.lowerIndirectCall`'s header states in full: the C# reference
					// MISCOMPILES a large match's arm that binds an `Array` payload sitting in the TAIL field
					// slot of its variant, corrupting the SCRUTINEE's decref. `indirectCall`'s `args` is
					// exactly that (no field follows it), unlike `call`/`tryCall`, whose trailing `argRanges`
					// makes binding `args` here safe.
					indirectCall then checkIndirectCall(project, func: func, opIndex: opIdx, op: op)
					// P1.5-B1a: an async spawn validates its arguments like a plain call AND requires the
					// callee's PARAMETERS to be GPR scalars (the trampoline passes them through the integer
					// arg registers); `await`'s operand is a runtime promise handle, not a callee to resolve.
					asyncCall(result, callee, args, argLabels, argRanges, argImmutableNames, argDefaultSlots) then validateAsyncCall(project, func: func, signatures: signatures, funcNames: funcNames, opIndex: opIdx, result: result, callee: callee, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: argImmutableNames, argDefaultSlots: argDefaultSlots, escapeSummary: escapeSummary, mutationSummary: mutationSummary, blameTargetErrorsHere: blameTargetErrorsHere)
					// An `await`/`try await`'s operand is a runtime promise handle, not a callee to resolve; the
					// awaited function was validated at its `async` spawn site. The `try await` throws-compatibility
					// (E3057 plain-await, E3059 propagate mismatch) is checked by the parser at the await/try token.
					await to tryAwait then break 'op'
					sizeofType then break 'op'
					constArrayLiteral then break 'op'
					switch then break 'op'
					// A witness dispatch has no callee NAME to resolve — the parser already resolved the interface
					// method against the type's `where` constraints (`findWitnessDispatchCandidates`), so there is nothing
					// for this name-signature validation to say (P1.7a slice 2a). Two obligations remain, and both
					// are this pass's because neither can be keyed on a callee name. The first is the throws rule
					// every other call shape gets here: a dispatch of a THROWING interface method that is still a
					// plain `witnessDispatch` was written without `try`, so its flag would be dropped — the mirror
					// of `validatePlainCall`'s E3057, keyed on the stamp the op carries (P1.7a slice 2b-v). The
					// second is the ARGUMENT TYPES (BATCH18); see `checkWitnessArgTypes`.
					witnessDispatch(_, args, _, methodIndex, interfaceDeclIndex, _, isThrowing) then checkWitnessDispatchOp(project, func: func, signatures: signatures, witnessSlots: witnessSlots, opIndex: opIdx, args: args, methodIndex: methodIndex, interfaceDeclIndex: interfaceDeclIndex, isThrowing: isThrowing)
					// A `witnessTryDispatch` IS the `try` — it is produced by nothing else — so the throws rule is
					// satisfied by its existence, exactly as a `tryCall` satisfies `validatePlainCall`'s. Its
					// ARGUMENTS are the same arguments, so they get the same check: the `try` decides how the error
					// flag travels and says nothing about what may be passed.
					witnessTryDispatch(_, _, args, _, methodIndex, interfaceDeclIndex, _) then checkWitnessArgTypes(project, func: func, signatures: signatures, witnessSlots: witnessSlots, opIndex: opIdx, args: args, methodIndex: methodIndex, interfaceDeclIndex: interfaceDeclIndex)
					// A panic has no callee name to validate.
					panicAbortValue then break 'op'
					// The error-flag encode has no callee name to validate and no arguments to type.
					errorFlagEncode then break 'op'
					// ⭐⭐ **A SERVICE OP'S ARGUMENTS ARE CHECKED AT THE PARSER AND CANNOT BE CHECKED HERE.** By
					// the time either op exists its arguments are gone: a message's are inside the request BOX
					// (typed against the request union's payload fields, which ARE the method's declared
					// parameter types — `ServiceCompanions.serviceRequestPayloads` builds them from exactly that
					// column), and a `spawn`'s state is the factory `call` op's own result, validated as that
					// call. There is nothing left on either op for a signature to be slotted against.
					//
					// ⛔⛔ **THE TARGET GATE IS STILL OWED, AND ITS ABSENCE WAS A COMPILER PANIC ON A VALID
					// PROGRAM (SV1 review, MEASURED on all three non-host targets).** Every other road into the
					// green-thread substrate is a CALL, so `requireTargetSupportsCallee` meets it by NAME —
					// but a service reaches that substrate through an OP whose callee is minted at lowering,
					// and this walk sees no name to key on. `spawn Plot.create()` therefore ran straight past
					// the gate and into the backend that cannot emit it:
					//   • `--target=arm64-macos` — `panic at StdToArm64Conversion.maxon:652: the P1.5 IOCP ops are x64-windows only`
					//   • `--target=wasm32-wasi` — `panic at StdToWasm.maxon:1748:` the same
					//   • `--target=x64-linux`   — `panic at StdToX64Conversion.maxon:3382: lowerTlsAlloc: TlsAlloc is x64-windows only`
					// against the CONTROL one construct over: the same substrate reached by `sleep` answers
					// `E3104 … 'sleep' lowers to the runtime entry '__gt_sleep', which has no <target>
					// implementation` on all three. It is exactly the shape `calleeNeedsWin32Substrate`'s
					// header records for the socket runtime — *"the surface without the floor is worse than
					// neither"* — reached through the one door that carries no callee.
					//
					// ⚠ It names the ENTRY the lowering will mint, through the one E3104 wire format, so a
					// service refusal and a `sleep` refusal cannot become two spellings of one rejection.
					serviceSpawn then requireTargetSupportsServiceEntry(project, func: func, opIndex: opIdx, subject: "'spawn'", entry: SvcSpawnName, blameTargetErrorsHere: blameTargetErrorsHere)
					serviceSend then requireTargetSupportsServiceEntry(project, func: func, opIndex: opIdx, subject: "a message send", entry: MboxSendName, blameTargetErrorsHere: blameTargetErrorsHere)
					// ⭐ A REPLY CELL reaches the scheduler substrate exactly as the two above do — it mints a
					// green-thread struct and steps `__gt_live_count` — and it is emitted only beside a
					// `serviceSend`, so this arm never fires alone. It names its own entry anyway, because a
					// refusal that named a neighbour's would be a wrong attribution rather than a missing one.
					serviceReplyCell then requireTargetSupportsServiceEntry(project, func: func, opIndex: opIdx, subject: "an awaited message send", entry: GtCellAllocName, blameTargetErrorsHere: blameTargetErrorsHere)
				end 'op'
			end 'eachOp'
		end 'eachBlock'
	end 'eachFunc'
end 'checkCalls'

// An `async` spawn (P1.5-B1a): validate its arguments exactly like a plain call, then require the callee's
// PARAMETERS to be GPR scalars. The argument-VALUE and RESULT scalar checks are the parser's (it holds the
// pre-resolution types and must type the promise safely); this is the one check the parser cannot make — a
// callee declared in another file, whose param types only the whole-program `funcSignatures` registry has.
function validateAsyncCall(project Project, func IrFunction, signatures ProgramSignatures, funcNames FunctionNameIndex, opIndex OpIndex, result ValueId, callee ByteArray, args ValueIdArray, argLabels ByteArrayArray, argRanges SourceRangeArray, argImmutableNames ByteArrayArray, argDefaultSlots ParamCountArray, escapeSummary ParamEscapeSummary, mutationSummary ParamMutationSummary, blameTargetErrorsHere bool)
	// `notMinted`: `parseAsyncCall` consumes a bare `identifier` callee, so an `async` spawn's name is always
	// the author's own bytes (`async int.fromString(s)` does not parse at all).
	validateCall(project, func: func, signatures: signatures, funcNames: funcNames, opIndex: opIndex, result: result, callee: callee, mint: CalleeMint.notMinted, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: argImmutableNames, argDefaultSlots: argDefaultSlots, escapeSummary: escapeSummary, mutationSummary: mutationSummary, blameTargetErrorsHere: blameTargetErrorsHere)
	requireAsyncScalarParams(project, func: func, signatures: signatures, opIndex: opIndex, callee: callee)
end 'validateAsyncCall'

// Refuse `async f(…)` when any parameter of `f` cannot ride the green thread's integer channel. The
// trampoline passes every argument through the INTEGER arg registers, so a `float` (XMM) parameter would
// read the wrong register file — a silent miscompile the parser's argument check cannot catch, because an
// int argument LEGALLY coerces to a float parameter (`checkArgTypes`). Reads the RESOLVED signature: a
// ranged-int alias has already collapsed to `integer`, while a boxed union — which resolution erases to
// `integer` too — is recovered by its `paramAggregateNames` entry. A payload-free enum is a genuine i64
// scalar and carries no aggregate name. An undeclared callee is E3004 (reported by `validateCall`); its
// absent signature simply skips this check.
//
// ⭐ **A MANAGED PARAMETER IS ACCEPTED SINCE A2** — a heap pointer is one GPR word, and the spawn hands the
// thread its own reference (`Parser.transferAsyncSpawnArgs`) which `__gt_release_<callee>` gives back. That
// is why a boxed union parameter is no longer refused merely for carrying an aggregate name: `aggName` now
// decides WHICH DROP the releaser needs, not whether the spawn is legal.
//
// ⛔ **A CONSUMED MANAGED PARAMETER IS STILL REFUSED, AND IT IS AN OWNERSHIP BOUNDARY RATHER THAN A CHANNEL
// ONE.** A consumed parameter is enrolled OWNED in the callee's own frame (`Parser.bindParameters`), so the
// callee drops it when it runs — while the releaser drops it too, because the releaser is what discharges
// the reference the spawn took. Pairing them correctly needs the release to be conditional on whether the
// thread ever RAN, which is a per-arm decision `__gt_promise_drop` could make and `__gt_await` could not
// state without knowing it. Nothing in the tree spawns such a callee and every one of them is refused today
// (the whole managed family was), so this narrows an existing refusal rather than opening a hole: a double
// free is the alternative, and a diagnostic is the honest boundary. **The transitive-consume fixpoint is
// what would decide it properly; that is the slice this waits on.**
function requireAsyncScalarParams(project Project, func IrFunction, signatures ProgramSignatures, opIndex OpIndex, callee ByteArray)
	let sig = try project.funcSignatures.get(callee) otherwise return
	for i in 0 upto sig.paramCount() 'eachParam'
		let paramType = try sig.paramTypes.get(i) otherwise panic("requireAsyncScalarParams: paramTypes.get OOB at {i}")
		if not tagRidesAsyncGprChannel(maxonTypeTag(paramType)) 'unfittableParam'
			reportPositioned(project, code: ErrorCode.parserUnsupportedFeature, message: "`async {String.from(callee)}(…)` — parameter '{String.from(asyncParamNameAt(sig, index: i))}' cannot ride the green thread's integer channel: a `float` parameter is passed in an XMM register the hand-assembled trampoline never fills, and one held at an interface type or an opaque type parameter is released through a companion (a witness table, a layout descriptor) the green-thread struct does not carry", line: project.opRanges.get(opIndex).line, column: project.opRanges.get(opIndex).column, filePath: func.sourceFilePath)
			return
		end 'unfittableParam'
		if signatures.paramIsConsumed(callee, index: i) and asyncParamOwnsHeap(signatures, typeNames: project.typeNames, sig: sig, index: i) 'consumedManagedParam'
			reportPositioned(project, code: ErrorCode.parserUnsupportedFeature, message: "`async {String.from(callee)}(…)` — parameter '{String.from(asyncParamNameAt(sig, index: i))}' is a managed value the function KEEPS (it moves it into durable storage), and a spawn cannot yet hand over a managed argument the callee itself releases: the spawn takes a reference on the green thread's behalf and `__gt_release_{String.from(callee)}` gives it back whether or not the thread ever ran, so the callee's own release would be a second one. Call it directly, or pass a value the function only borrows", line: project.opRanges.get(opIndex).line, column: project.opRanges.get(opIndex).column, filePath: func.sourceFilePath)
			return
		end 'consumedManagedParam'
	end 'eachParam'
end 'requireAsyncScalarParams'

// Parameter `index`'s declared name, for the two async refusals above. Split out so the panic message is
// written once rather than once per report site.
function asyncParamNameAt(sig FuncSignature, index ParamCount) returns ByteArray
	return try sig.paramNames.get(index) otherwise panic("asyncParamNameAt: paramNames.get OOB at {index} — a signature's param columns are built in lockstep")
end 'asyncParamNameAt'

// Does parameter `index` hold a heap record the callee would have to release? The SAME classification the
// releaser plan reads (`asyncSlotOwnsHeap`), so "which slots the releaser drops" and "which consumed slots
// are refused" cannot come to disagree — a disagreement between them is a double free on one side and a leak
// on the other, and a compile error on neither.
function asyncParamOwnsHeap(signatures ProgramSignatures, typeNames TypeNameInterner, sig FuncSignature, index ParamCount) returns bool
	return asyncSlotOwnsHeap(signatures, typeNames: typeNames, slotType: try sig.paramTypes.get(index) otherwise panic("asyncParamOwnsHeap: paramTypes.get OOB at {index}"), aggregateName: try sig.paramAggregateNames.get(index) otherwise panic("asyncParamOwnsHeap: paramAggregateNames.get OOB at {index} — a signature's param columns are built in lockstep"))
end 'asyncParamOwnsHeap'

// **E3057 for a witness dispatch of a THROWING interface method written without `try`** (P1.7a slice 2b-v) —
// the witness twin of `validatePlainCall`'s user-function arm, and the same rule: a bare throwing call
// branches on nothing, so the callee's error flag is discarded and its throw-path primary comes back as a
// real answer. It reads a STAMP on the op rather than a signature registry because a witness method has no
// callee name to look up (the parser resolved it against the enclosing type's `where` constraints, which is
// where the interface's `throws` clause lives and the only place it is known).
//
// The diagnostic names the METHOD, which the op does not carry — but `project.opRanges` positions it exactly
// on the dispatch the author wrote, and the wording matches the direct-call form the author already knows.
function requireTriedWitnessDispatch(project Project, func IrFunction, opIndex OpIndex, isThrowing bool)
	if not isThrowing 'nonThrowing'
		return
	end 'nonThrowing'
	let callRange = project.opRanges.get(opIndex)
	reportPositioned(project, code: ErrorCode.throwingFunctionRequiresTry, message: "throwing interface method requires try: wrap the witness dispatch as `try <receiver>.<method>(…)` — a bare call drops the error flag the method returns", line: callRange.line, column: callRange.column, filePath: func.sourceFilePath)
end 'requireTriedWitnessDispatch'

// The witness slot list per dispatched interface, keyed by the declaration-order handle a `witnessDispatch`
// op carries. See `checkCalls`, where the one instance is created, for why it exists.
typealias WitnessSlotsByDeclIndex = Map with (InterfaceDeclIndex, CollectedInterfaceMethodArray)

// What an interface FORMAL denotes at the argument check. `opaque` is a real answer — see
// `witnessFormalDeclaredType` for its four sources and for why each is a position where comparing would be
// WRONG rather than merely unimplemented. `preErasedAggregate` rides with the type for
// `checkOneArgType`'s sake: a boxed union/enum formal resolves to bare `integer` and only the carrier still
// holds its name.
union WitnessFormalType
	declared(paramType MaxonType, preErasedAggregate ByteArray)
	opaque
end 'WitnessFormalType'

// The two obligations a PLAIN `witnessDispatch` carries here, in one call so the big match's arm binds its
// `args` once. A `witnessTryDispatch` asks only the second — it IS the `try`.
function checkWitnessDispatchOp(project Project, func IrFunction, signatures ProgramSignatures, witnessSlots WitnessSlotsByDeclIndex, opIndex OpIndex, args ValueIdArray, methodIndex WitnessMethodIndex, interfaceDeclIndex InterfaceDeclIndex, isThrowing bool)
	requireTriedWitnessDispatch(project, func: func, opIndex: opIndex, isThrowing: isThrowing)
	checkWitnessArgTypes(project, func: func, signatures: signatures, witnessSlots: witnessSlots, opIndex: opIndex, args: args, methodIndex: methodIndex, interfaceDeclIndex: interfaceDeclIndex)
end 'checkWitnessDispatchOp'

// ⭐⭐ **A WITNESS DISPATCH'S ARGUMENTS AGAINST THE REQUIREMENT'S DECLARED FORMALS — AND UNTIL THIS EXISTED
// ONE COMPILER DISAGREED WITH ITSELF (BATCH18).** `Parser.dispatchWitnessMethod` checks the method NAME, the
// ARITY (`pickWitnessDispatchByArity`, a pure count — `r.run()` on a 1-parameter method IS E3036) and the
// LABELS (`slottedWitnessArgs`), and compared no argument TYPE anywhere. So `r.run("nope")` at a
// `run(n Integer)` requirement compiled clean and printed a pointer read as an int, **while the identical
// call by DIRECT dispatch was already refused E3005** — two doors of one compiler answering one question two
// ways. `LowerMaxonToStd.witnessFormalTypes` had already recorded the consequence in its own header
// (*"arg-derived widths are unsound while that check is absent"*); this is that check.
//
// ⛔ **IT WRITES NO COMPARISON OF ITS OWN.** Every argument goes through `checkOneArgType` — the SAME helper
// a direct call's slotted argument, an indirect call's positional one and an `async` spawn already ask —
// which is what makes the existential widening, the nominal aggregate identity, the FUNCTION-SHAPE compare
// and the coercion rule arrive here by construction rather than by a second author remembering all four. A
// second spelling of "do these two types agree" is precisely the defect this closes.
//
// ⚠ **THE FORMALS COME FROM THE REQUIREMENT, NEVER FROM A CONFORMER.** Under dictionary-passing the shared
// body has no concrete callee — the same reason `slottedWitnessArgs` binds LABELS against the interface —
// and `ConformanceCheck.signatureMatches` forces every conformer to declare exactly these types anyway.
//
// ⭐ The actuals are indexed past the borrowed receiver (`WitnessReceiverArgCount`), the same mapping
// `Parser.floatWidenedWitnessArgs` and `requireGenuineSelfArgs` walk. The counts agree by construction — the
// parser's arity check ran before the op was emitted — so a short `args` is a compiler defect and panics
// rather than being absorbed.
function checkWitnessArgTypes(project Project, func IrFunction, signatures ProgramSignatures, witnessSlots WitnessSlotsByDeclIndex, opIndex OpIndex, args ValueIdArray, methodIndex WitnessMethodIndex, interfaceDeclIndex InterfaceDeclIndex)
	let dispatched = dispatchedInterfaceAt(signatures, interfaceDeclIndex: interfaceDeclIndex)
	let slots = witnessSlotsAt(signatures, witnessSlots: witnessSlots, dispatched: dispatched, interfaceDeclIndex: interfaceDeclIndex)
	let requirement = (try slots.get(methodIndex) otherwise panic("checkWitnessArgTypes: slot {methodIndex} is outside the {slots.count()} witness slots of interface '{String.from(dispatched.name)}' — the op's `(interfaceDeclIndex, methodIndex)` pair was numbered against a different slot list")).method
	let callRange = project.opRanges.get(opIndex)
	let witnessReceiver = witnessDispatchReceiver(args)

	for j in 0 upto requirement.paramTypeNames.count() 'eachFormal'
		let formalName = try requirement.paramTypeNames.get(j) otherwise panic("checkWitnessArgTypes: paramTypeNames.get OOB at {j} below count {requirement.paramTypeNames.count()}")
		match witnessFormalDeclaredType(project, signatures: signatures, dispatched: dispatched, formalName: formalName) 'formal'
			opaque then continue
			// ⭐ `declaredParamName` is the formal's OWN rendered name, which is exactly the pre-erasure SPELLING
			// a direct call reads off `FuncSignature.paramDeclaredNames` — an interface stores its formals as
			// source names (`IrInterface`'s header), so this route HAS the fact rather than having to recover it.
			// Passing `EmptySourceText` here would make the witness route report `expected 'int'` where the
			// direct route reports `expected 'Integer'` for the identical declaration: this door's own defect,
			// surviving in the sentence after being closed in the verdict.
			// ⚠ The BORROWED RECEIVER is this dispatch's subject. The shape substitution cannot fire through it
			// and must not: the formals are the INTERFACE's (see this function's header), so their opaque types
			// are owned by the interface rather than by any conformer — which is exactly the owner guard
			// `ProgramSignatures.substituteThroughInstance` applies, and `witnessFormalDeclaredType` has already
			// answered `opaque` for them one line up.
			declared(paramType, preErasedAggregate) then checkOneArgType(project, func: func, paramType: paramType, preErasedAggregate: preErasedAggregate, declaredParamName: formalName, paramName: witnessFormalName(requirement, position: j), position: j, argId: try args.get(j + WitnessReceiverArgCount) otherwise panic("checkWitnessArgTypes: args.get OOB at {j + WitnessReceiverArgCount} below count {args.count()} — a dispatch reaching here has the receiver plus one actual per formal"), callInstanceSubject: witnessReceiver, paramExistentialSites: sharedEmptyParamExistentialSites, callRange: callRange, filePath: func.sourceFilePath)
		end 'formal'
	end 'eachFormal'
end 'checkWitnessArgTypes'

// The formal's own NAME, for the diagnostic — the INTERFACE's, which is the vocabulary the call binds
// against (`WitnessDispatchTarget.paramNames` carries the same list for the same reason). Parallel to
// `paramTypeNames` by construction.
function witnessFormalName(requirement InterfaceMethodSig, position ParamCount) returns ByteArray
	return try requirement.paramNames.get(position) otherwise panic("witnessFormalName: paramNames.get OOB at {position} — an InterfaceMethodSig's paramNames and paramTypeNames are parallel by construction ({requirement.paramNames.count()} names, {requirement.paramTypeNames.count()} types)")
end 'witnessFormalName'

// The interface a dispatch's handle names, resolved through the ONE rule (`lookupInterface`) over the SAME
// store the parser numbered the dispatch against (`ProgramSignatures.interfaceMap()`, which
// `Parser.witnessSlotsOf` also walks). Reading the merged `project.interfaces` instead would be a second
// writer of what must be one declaration, and `LowerMaxonToStd.interfaceAtDeclIndex` has to assert that seam
// precisely because it reads the other store; asking the numbering's own store leaves nothing to assert.
function dispatchedInterfaceAt(signatures ProgramSignatures, interfaceDeclIndex InterfaceDeclIndex) returns IrInterface
	let name = signatures.interfaceNameAtDeclIndex(interfaceDeclIndex)
	match lookupInterface(signatures.interfaceMap(), name: name) 'resolve'
		found(iface) then return iface
		notFound then panic("dispatchedInterfaceAt: interface '{String.from(name)}' holds position {interfaceDeclIndex} in the signature index but resolves to nothing in it — a witness dispatch was numbered against a declaration the index does not carry")
	end 'resolve'
end 'dispatchedInterfaceAt'

// `interfaceDeclIndex`'s transitive witness slot list, walked once per INTERFACE — see `checkCalls`, where
// the memo is created, for why that is a correctness-shaped concern rather than a speed one.
function witnessSlotsAt(signatures ProgramSignatures, witnessSlots WitnessSlotsByDeclIndex, dispatched IrInterface, interfaceDeclIndex InterfaceDeclIndex) returns CollectedInterfaceMethodArray
	if let memoized = try witnessSlots.get(interfaceDeclIndex) 'alreadyWalked'
		return memoized
	end 'alreadyWalked'

	let slots = interfaceWitnessSlots(signatures.interfaceMap(), iface: dispatched)
	witnessSlots.upsert(interfaceDeclIndex, value: slots)
	return slots
end 'witnessSlotsAt'

// ⭐⭐ **WHAT AN INTERFACE FORMAL DENOTES AT THE ARGUMENT CHECK, or that there is nothing here to compare
// against.** An interface stores its formals as RENDERED SOURCE NAMES (`IrInterface`'s header), so this door
// re-derives what a declaration derived once — the same re-derivation `Parser.interfaceReturnMaxonType` makes
// for the RETURN, sourced from the same `builtinTypeNameTag` table so the two cannot drift.
//
// ⚠ **`opaque` IS AN ANSWER, NOT A GAP TO BE FILLED IN LATER.** Three of its four sources are positions where
// a comparison HERE would be wrong rather than merely absent, and the fourth is a name this pass cannot
// resolve at all — in every case refusing on a guess would be a false refusal, which is the failure mode a
// door that starts comparing types most easily acquires.
function witnessFormalDeclaredType(project Project, signatures ProgramSignatures, dispatched IrInterface, formalName ByteArray) returns WitnessFormalType
	// A `Self`-typed formal (`Equatable.equals(other Self)`) is the RECEIVER's own type, which the shared body
	// does not know. `Parser.requireWitnessSelfArgs` already refuses a concrete value there — the check that
	// exists because marshalling an int literal into a `Self` pointer FAULTS — so this is not an unguarded
	// position, it is one guarded by a rule stated where the receiver is.
	if formalName.equals(InterfaceSelfTypeName) 'selfFormal'
		return WitnessFormalType.opaque
	end 'selfFormal'

	// An ASSOCIATED TYPE denotes whatever each CONFORMER binds (`implements Taker with float`), so the
	// interface cannot state it and neither can this. That the conformers must all bind it ALIKE is E3119's,
	// reported by `ConformanceCheck` with a position; asking `associatedAbiBindingOf` here would re-derive that
	// fold to refuse an argument against one conformer's binding in a body compiled for all of them.
	//
	// ⚠ Asked BEFORE `builtinTypeNameTag`, and the order is load-bearing for `LowerMaxonToStd.witnessFormalType`'s
	// measured reason: a `uses` parameter is an IDENTIFIER, and `ExitCode`/`String` are identifiers too, so
	// `interface Taker uses ExitCode` would otherwise read a TYPE PARAMETER as the u32 builtin.
	// `namesInclude`, not a discarded `namePositionIn`: this door answers `opaque` and has no use
	// for the position, and a PURE result may not be dropped in any spelling (E3064) — which is what the
	// `if let _ = try …` that stood here did.
	if namesInclude(dispatched.associatedTypeNames, name: formalName) 'aConformerBindsIt'
		return WitnessFormalType.opaque
	end 'aConformerBindsIt'

	// A builtin whose spelling settles it — the table's answer is valid here because this door holds a
	// RENDERED type name, which is exactly the precondition `builtinTypeNameTag`'s header states.
	let builtinTag = builtinTypeNameTag(formalName)
	if builtinTag != ValueTypeTag.named 'builtinFormal'
		return WitnessFormalType.declared(maxonTypeOfTag(builtinTag, nameId: UnnamedTypeId), preErasedAggregate: EmptySourceText)
	end 'builtinFormal'

	// Every remaining answer needs the name's id in the PROJECT interner, which is where an argument's own
	// name id lives after the merge. A formal naming a type no file of this program interned is a name nothing
	// here can resolve — `resolveTypes` reports it (E3011) against the declaration that wrote it — so it is
	// opaque rather than a second unpositioned report of the same fact.
	let id = try project.typeNames.idOf(formalName) otherwise return WitnessFormalType.opaque

	// A FUNCTION TYPEALIAS, which `denotedNamedType` does not answer for: it resolves TYPES, and a function
	// alias lives in `functionAliasShapes`. Answered as `function(id)` — the same type a declared function
	// PARAMETER of that alias carries — so `checkOneArgType`'s function-shape arm compares the two shapes
	// exactly as it does for a direct call.
	if signatures.isFunctionAliasInAnyFile(formalName) 'functionAliasFormal'
		return WitnessFormalType.declared(MaxonType.function(id), preErasedAggregate: EmptySourceText)
	end 'functionAliasFormal'

	// A struct, an interface, an enum/union, a ranged alias — the whole-program cascade, one door.
	// ⚠ A GENERIC-INSTANCE alias and a TUPLE alias are in NEITHER this cascade nor the one above, so both land
	// on `notDeclared` and are opaque. That is the honest answer and not an omission: both resolve through a
	// READER'S FILE (`genericAliasInstanceFrom`, `qualifiedAliasOf`), and a requirement's formal is a
	// whole-program name with no reading file to scope a contested prefix by.
	//
	// ⚠ **AND IT ASKS ON NO FILE'S BEHALF — `CompilerOwnedDeclFilePath`, which is that fact's one spelling (see its header).** A requirement's formal is a
	// whole-program name written inside an `interface`, and `IrInterface` records no declaring file; the
	// paragraph above already says a name that resolves through a READER is opaque here for exactly that
	// reason, and a cross-KIND contested name is the same shape one registry over.
	let denoted = try denotedNamedType(signatures, name: formalName, id: id, readerFilePath: CompilerOwnedDeclFilePath) otherwise return WitnessFormalType.opaque

	// The identity `resolveTypes` took off this formal, if it took one — see `erasedFormalIdentity`.
	return WitnessFormalType.declared(denoted, preErasedAggregate: erasedFormalIdentity(project, denoted: denoted, id: id))
end 'witnessFormalDeclaredType'

// ⭐⭐ **THE IDENTITY THE FORMAL'S RESOLUTION DESTROYED, ASKED OF THE ONE WHOLE-PROGRAM CLASSIFIER — and
// spelling it a THIRD time here was a measured wrong answer (BATCH18 review, second pass).**
//
// This gate read `containsEnumInAnyFile(formalName)`, which is a third answer to *"which identities does resolution
// destroy?"* beside `Parser.erasedAggregateNameOf` (the parse tier's, which BATCH18-b unified across its own
// two fill sites) and `aggregateNameFor` (this pass's own). It was the narrow one: a boxed enum erases, and
// so does a **PER-INSTANCE RANGED ALIAS**, which it did not name.
//
// **MEASURED.** `interface Taker { take(i IntPool.Idx) }` over `export typealias Idx = int(0 to 15)`: the
// DIRECT call `im.take(n)` with a plain `Integer` is *"E3005: expected 'IntPool.Idx', got 'int'"*, while the
// identical requirement through a WITNESS compiled clean and carried **9999** into the formal, printing
// `v=10019`. One compiler answering one question two ways — the defect this batch exists to close, surviving
// inside the door the batch added, because the two doors classified the same fact apart.
//
// ⚠ **IT WRITES NO FOURTH RULE. It asks `aggregateNameFor` TWICE — LIVE, then PRE-ERASURE** — which is
// exactly the two steps `checkOneArgType` takes for every argument it judges, and exactly what
// `checkTransformParamType` does at the transform door. A formal whose identity SURVIVED (a struct's
// `structRef`, an existential's `interfaceRef`) is read live by the checker and must carry nothing, or one
// name would sit in two places; a formal whose identity did NOT survive arrives as bare `integer`, and the
// pre-resolution `named(id)` is the only thing that still knows what it was. `aggregateNameFor` decides both
// asks, so the enum arm, the per-instance-alias arm and any arm added later reach this door by construction
// rather than by a second author remembering them.
// ⚠ `CompilerOwnedDeclFilePath` for `witnessFormalDeclaredType`'s reason, which is this function's caller: a
// requirement's formal is a whole-program name written inside an `interface`, and `IrInterface` records no
// declaring file.
function erasedFormalIdentity(project Project, denoted MaxonType, id TypeNameId) returns ByteArray
	if not aggregateNameFor(project, tag: maxonTypeTag(denoted), nameId: typeNameIdOf(denoted), readerFilePath: CompilerOwnedDeclFilePath).isEmpty() 'survivedResolution'
		return EmptySourceText
	end 'survivedResolution'

	return aggregateNameFor(project, tag: ValueTypeTag.named, nameId: id, readerFilePath: CompilerOwnedDeclFilePath)
end 'erasedFormalIdentity'

// ⭐⭐ **THE NOUN A DIAGNOSTIC ABOUT THIS CALL MUST USE — THE ONE DOOR (A1s-prim).** Every message below
// that quotes a callee asks HERE rather than rendering `callee` for itself, because for one call family the
// two are different strings: `int.fromString(s)` links to `__int_fromString`, a symbol the author never
// typed. Quoting it gives the right error code about a program the reader does not have — the class shv2
// ruled on at D11c and fixed in its own compiler; a fresh instance of it would be this pass committing the
// sin it already refused.
//
// ⚠⚠ **THE ANSWER IS THE SITE'S, NEVER THE NAME'S, AND THAT IS D12's LESSON PAID FORWARD.**
// `stdlib/Builtins.maxon` DECLARES `__int_fromString` and CALLS it (`__byte_fromString`'s first line),
// having written those bytes; keyed on the name, this would rewrite the author's own diagnostic in their
// own file. A callee two spellings share is a LOSSY KEY used as an identity. `CalleeMint` is the site's
// answer, carried on the op by the parser — the only tier that knows which of its doors the name came
// through.
//
// ⚠ It is NOT `GtRuntime.runtimeCalleeSourceMethod`, and must not be folded into it: that map answers the
// same-sounding question for RUNTIME callees, and may be keyed by NAME precisely because none of them is
// writable. Two questions that read alike, two different keys.
//
// The decode itself is `Parser.primitiveStaticSourceSpelling`, which lives beside the mint and re-mints what
// it split — so this pass owns no copy of the joining rule and cannot drift from it.
//
// ⛔⛔ **IT IS DELIBERATELY NOT NAMESPACE-QUALIFIED, AND W81 MEASURED WHY.** The canonical corpus spells a
// resolved stdlib callee `stdlib.Expect.equal` and shv2 spells it bare, so the obvious cure is to put
// `ProgramSignatures.diagnosticCalleeSpelling` here — one door, every message. **BUILT AND REVERTED**: this
// noun also serves the messages about a name that resolved to NOTHING, and there the author's own spelling
// is the only honest one. MEASURED, on `namespace-qualified-resolution`'s
// `error.contested-bare-call-with-exactly-one-visible-candidate`: `call to undefined function 'helper'`
// became `… 'alpha.helper'` — a symbol the author never wrote, about a call they wrote as `helper()`, which
// is D11c's defect class arriving in the pass that already refused it once. See
// `diagnosticCalleeSpelling`'s own header for the line that does hold and for what is still owed.
function callDiagnosticNoun(callee ByteArray, mint CalleeMint) returns ByteArray
	match mint 'm'
		notMinted then return callee
		primitiveStatic then return primitiveStaticSourceSpelling(callee)
		// ⭐ A parameter default's helper (BATCH2 slice 4): the author wrote a call to the DECLARING
		// function and no argument at all, so that function's name is the whole of what they wrote here.
		paramDefaultHelper then return paramDefaultCalleeSpelling(callee)
		// The author wrote `FilePath from "…"`, whose only NAME is the type's — and that is the head of the
		// mangled callee, so the callee IS the nearest thing to what they wrote.
		stringLiteralInit then return callee
		// ⭐ A field default's helper (S2f): the author wrote a struct literal that OMITTED the field, so
		// the nearest thing they wrote is the field itself — `Bag.items`.
		fieldDefaultHelper then return fieldDefaultCalleeSpelling(callee)
		// ⭐ A method dispatch (F31): the author wrote the MEMBER and a receiver, and `<Type>.<member>` is
		// the noun every method diagnostic in this compiler already uses for that — `p.join(1, 2)` reports
		// `'FilePath.join'`, naming the type off the receiver exactly as this callee does. So the mangled
		// name IS the spelling to quote, and this arm exists to SAY that rather than to inherit it from
		// `notMinted`.
		resolvedTypeQualifier then return callee
	end 'm'
end 'callDiagnosticNoun'

// ⭐⭐ **THE ONE SPELLING OF "A THROWING CALL NEEDS `try`", NAMING WHAT THE AUTHOR WROTE.** FIVE producers
// reach it — an ordinary user function, plus the four compiler-owned families that can hand back a source
// method name (directory, file, string-search, buffer). Before D12 two of them spelled it inline and the
// other three had no arm at all, which is how they came to inherit the array-accessor noun; giving each its
// own inline arm would have made FIVE copies of one sentence, and a later reword that reaches four of them
// is the drift this project keeps finding. So it is spelled here and nowhere else.
//
// ⚠ It takes the name as the caller HAS it (a `ByteArray`, which is what both a callee and a method constant
// are) rather than the callee plus a flag, so the sentence has no branch inside it to get wrong.
function throwingCallRequiresTryMessage(name ByteArray) returns String
	return "throwing function requires try: '{String.from(name)}'"
end 'throwingCallRequiresTryMessage'

// ⭐⭐ **WHAT AN E3057 SAYS ABOUT A COMPILER-OWNED THROWING CALLEE.** The user never wrote `__managed_get` or
// `__md_next`, so the sentence has to name the construct they DID write; a family that falls through to
// another family's wording gets the right code and the wrong noun.
//
// ⚠ **THE SELECTION USED TO BE A BINARY GT-else-ARRAY EXPRESSION**, and its own comment said a third family
// must add an arm here. Three joined it without one (`__strix_*` at P1.8, `__mf_*` at R4.1/R4.2, and
// `__ManagedMemory`'s members at R4.2), so a `s.findFirst(n)` or a `f.openRead(p)` written without `try` was
// told it was a "throwing array accessor". R4.3 recast the chain and claimed a new family would now "fall to
// the LAST arm, which names the callee rather than pretending to know what it is" — but the last arm WAS the
// array wording, so it pretended exactly, and a sentence asserting a guard that does not exist is worse than
// no sentence at all.
//
// ⇒ D12 makes that claim true. The families with a source-method map answer through ONE composed lookup
// (`GtRuntime.runtimeCalleeSourceMethod`), so this function holds WORDING and not family knowledge; the array
// arm became EXPLICIT; and what falls past everything now names the callee, which is honest about being the
// only name it has. A sixth family that adds no map gets that fallback rather than another family's noun.
//
// ⭐⭐ **THE ARRAY ARM MOVED ABOVE THE LOOKUP AT D11c, AND THAT IS A NARROWING OF THIS FUNCTION'S CLAIM, NOT
// A CHANGE OF ITS ANSWER.** It used to sit BELOW, with a note saying it had to: `isThrowingManagedMemoryRuntimeCallee`
// COMPOSES the seven `__ManagedMemory` members (one record, one runtime, all `__managed_`-prefixed), so a wide
// array test above the lookup would have swallowed every buffer member and answered it with the array word —
// the very defect D12 removed. The ordering was the separator, and a required ordering is a test nobody wrote.
//
// ⇒ It now asks `isThrowingArrayAccessorCallee`, the NARROW factoring of that same union, which holds none but
// the nine genuine `Array`-surface accessors — so the arm is correct wherever it sits and sits here because the array
// family is the one family whose SENTENCE is not built from a method name. The map below became total over
// those nine at the same commit (E3059 needs the noun this sentence cannot supply), and without this move the
// per-method sentence would have displaced the family one. **`try-postfix-target.error.two-throwing-calls-in-
// one-chain` pins this wording, on `__managed_slice`, and is the check that the move changed no answer.**
function throwingRuntimeCalleeMessage(callee ByteArray) returns String
	// The subprocess family words itself from the CALL rather than from a method name: `__Builtins.runProcess`
	// is a compiler intrinsic with no source method to name, and what a bare one drops is a spawn failure,
	// not an index.
	if isThrowingGtRuntimeCallee(callee) 'subprocessFamily'
		return "throwing subprocess call requires try: wrap `__Builtins.runProcess(…)` as `try __Builtins.runProcess(…) otherwise …` — a bare call drops the spawn-failure error"
	end 'subprocessFamily'

	// ⚠ The array family's sentence describes a CONSTRUCT and not a method, which is why it is here rather
	// than in the map: E3057's fix for `arr.get(0)` is identical to its fix for `arr.pop()`, so one sentence
	// serves all nine and a per-method one would say nine times what it says once. E3059 asks the OPPOSITE
	// question of the same callee and needs the method — see `GtRuntime.runtimeCalleeSourceMethod`.
	if isThrowingArrayAccessorCallee(callee) 'arrayAccessor'
		return "throwing array accessor requires try: wrap it as `try …(…) otherwise …` — a bare call drops the out-of-bounds error"
	end 'arrayAccessor'

	// ⭐ A FAMILY THAT KNOWS THE AUTHOR'S OWN METHOD GETS THE ORDINARY USER-FUNCTION SENTENCE, and that is
	// right rather than merely convenient: a `dir.next()` or an `f.openRead(p)` is a method call like any
	// other as far as the author is concerned. `specs-shv2/managed-directory.md`'s `next-without-try` pins it.
	//
	// ⚠ A callee two spellings share cannot say which was written, so the sentence names both rather than
	// picking one — quoting `'openWrite'` at an author who wrote `openWriteExecutable` would be this
	// function's own defect (the right code, a construct the program does not contain) wearing a better
	// noun. It is still the ONE sentence above, extended; `specs-shv2/managed-file.md`'s
	// `open-write-executable-without-try` pins it.
	match runtimeCalleeSourceMethod(callee) 'sourceMethod'
		found(method) then return throwingCallRequiresTryMessage(method)
		sharedByTwoSpellings(spelling, alsoSpelled) then return "{throwingCallRequiresTryMessage(spelling)} or '{String.from(alsoSpelled)}' — the two are ONE call, so the callee cannot say which was written"
		notFound then break 'sourceMethod'
	end 'sourceMethod'

	// ⭐ **THE DIVISION FAMILY (A1) NAMES THE OPERATOR AND BOTH WAYS OUT — the second of the two arms here
	// that do NOT take the shared sentence, and for the opposite reason to the array one.** The map above
	// cannot answer for division and is not asked to: there is no method the author wrote to quote back,
	// because they wrote an OPERATOR. (`runtimeCalleeSourceMethod` gates each of its five families behind
	// that family's own predicate and falls to `notFound`, so a division callee reaches here rather than
	// tripping a map that was never given an arm for it.)
	//
	// And unlike every other family here there are TWO fixes rather than one — wrap it in a `try`, or give
	// the divisor a type whose range excludes 0 and get a bare divide back. The second is the one a hot loop
	// wants, so the message has to offer it: the bootstrap's own wording does (`2-Parser.cs:23713-23715`),
	// and a reader who is only told "add try" would never find it.
	//
	// The operator is recovered from the CALLEE, so `mod` is not reported as `/`: `divisionKindOf` is the one
	// place that mapping lives, and `divisionOperatorSpellingForKind` the one place its WORD does — shared with
	// the E3055 sentence A1x's total remainder gets, so no two division diagnostics can spell it differently.
	//
	// ⚠ **A1x's TOTAL REMAINDER NEVER REACHES HERE.** `__guarded_mod` guards `idiv`'s OVERFLOW divisor, answers
	// `0`, and throws nothing — so E3057 is never raised for it, and neither of the two fixes this message
	// offers would apply (there is no error to wrap, and its divisor's range already excludes 0). Reaching here
	// would mean `divisionKindThrows` and `isThrowingRuntimeCallee` had come apart.
	let divisionKind = divisionKindOf(callee)
	match divisionKind 'division'
		quotient to remainder then return divisionRequiresTryMessage(divisionOperatorSpellingForKind(divisionKind))
		guardedRemainder then panic("throwingRuntimeCalleeMessage: the TOTAL `mod` overflow guard is not a throwing callee, so E3057 is never raised for it — this builder is reached only through `isThrowingRuntimeCallee`, whose answer comes from the same `divisionKindThrows` list")
		notCheckedDivision then break 'division'
	end 'division'

	return throwingCallRequiresTryMessage(callee)
end 'throwingRuntimeCalleeMessage'

// The E3057 sentence both division arms share, spelled once with the operator substituted — `/` and `mod` fail
// for the identical reason and are fixed the identical two ways, so two copies would be one fact written twice.
function divisionRequiresTryMessage(operator String) returns String
	return "throwing division requires try: wrap it as `try (a {operator} b) otherwise …`, or give the divisor a ranged type that excludes 0 (e.g. `int(1 to ...)`) — a bare divide drops the divide-by-zero error"
end 'divisionRequiresTryMessage'

// A plain call: validate its arguments, then — if it targets a THROWING callee — report E3057 (a throwing
// call made without `try`). The `tryCall` path skips this: it IS the `try`.
function validatePlainCall(project Project, func IrFunction, signatures ProgramSignatures, funcNames FunctionNameIndex, opIndex OpIndex, result ValueId, callee ByteArray, mint CalleeMint, args ValueIdArray, argLabels ByteArrayArray, argRanges SourceRangeArray, argImmutableNames ByteArrayArray, argDefaultSlots ParamCountArray, throwsMap FuncThrowsMap, escapeSummary ParamEscapeSummary, mutationSummary ParamMutationSummary, blameTargetErrorsHere bool)
	validateCall(project, func: func, signatures: signatures, funcNames: funcNames, opIndex: opIndex, result: result, callee: callee, mint: mint, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: argImmutableNames, argDefaultSlots: argDefaultSlots, escapeSummary: escapeSummary, mutationSummary: mutationSummary, blameTargetErrorsHere: blameTargetErrorsHere)
	// A THROWING BUILTIN reaching here as a plain `call` — not a `tryCall` — was written WITHOUT a `try`, so its
	// error flag would be silently dropped: a throwing array accessor (`__managed_get`/…) would return a dummy 0 on an
	// out-of-bounds read, and a bare `__Builtins.runProcess` (P1.5 #93) would return its sentinel exit code while dropping the
	// spawn-failure/store-overflow flag (a wrong answer). Both are compiler-internal callees, so the blanket skip
	// below would hide them; the same E3057 "throwing call needs try" rule a user function gets is applied here
	// first, off the SAME `isThrowingRuntimeCallee` the parser's E3055 accept reads (they cannot drift). The
	// message is worded per family by `throwingRuntimeCalleeMessage`, so it names the construct the user
	// wrote. A correctly `try`ed call is a `tryCall` and never reaches `validatePlainCall`.
	if isThrowingRuntimeCallee(callee) 'throwingBuiltin'
		let callRange = project.opRanges.get(opIndex)
		reportPositioned(project, code: ErrorCode.throwingFunctionRequiresTry, message: throwingRuntimeCalleeMessage(callee), line: callRange.line, column: callRange.column, filePath: func.sourceFilePath)
		return
	end 'throwingBuiltin'
	// ⚠ **AND THE SKIP IS `isSignaturelessCompilerCallee`, NOT THE PREFIX (A1r).** `stdlib/Builtins.maxon` may
	// call the `__` functions it declares, and one of them THROWS — so a bare `__int_fromString(input)` there is
	// an ordinary throwing call written without `try`, which `throwsMap` below knows about and this return was
	// hiding. MEASURED on the flag-only door: no diagnostic anywhere, the file compiled clean to `E3001`, and
	// the error flag the callee wrote was dropped on the floor.
	if isSignaturelessCompilerCallee(callee, funcSignatures: project.funcSignatures) 'internal'
		return
	end 'internal'
	// `throwsMap` holds ONLY throwing functions, so membership IS "the callee throws" — a non-allocating
	// `contains`, not a `get otherwise ThrowsClause.none` (whose fallback would box a `none` for every one
	// of the program's calls that is not to a throwing callee, i.e. almost all of them).
	if throwsMap.contains(callee) 'throwing'
		let callRange = project.opRanges.get(opIndex)
		// ⚠ The NOUN, not the callee: a bare `int.fromString(s)` is the shape an author most often writes by
		// mistake, and it used to be told about `'__int_fromString'` — see `callDiagnosticNoun`.
		reportPositioned(project, code: ErrorCode.throwingFunctionRequiresTry, message: throwingCallRequiresTryMessage(signatures.diagnosticCalleeSpelling(callDiagnosticNoun(callee, mint: mint))), line: callRange.line, column: callRange.column, filePath: func.sourceFilePath)
	end 'throwing'
end 'validatePlainCall'

// Validate one call site. Reports the FIRST error found (unknown callee, then the arg
// slotting result: arity, unknown label, or a parameter given two arguments; then, on a
// cleanly slotted call, the per-argument TYPES). The call site's own span
// (`project.opRanges[opIndex]`) anchors the callee/arity/type errors; an argument's own span
// (`argRanges[argIndex]`) anchors a per-argument label error.
function validateCall(project Project, func IrFunction, signatures ProgramSignatures, funcNames FunctionNameIndex, opIndex OpIndex, result ValueId, callee ByteArray, mint CalleeMint, args ValueIdArray, argLabels ByteArrayArray, argRanges SourceRangeArray, argImmutableNames ByteArrayArray, argDefaultSlots ParamCountArray, escapeSummary ParamEscapeSummary, mutationSummary ParamMutationSummary, blameTargetErrorsHere bool)
	let callRange = project.opRanges.get(opIndex)
	let filePath = func.sourceFilePath
	// Resolved ONCE, at the top, so every message below quotes one string — and so the decode runs once per
	// call rather than once per message. For all but the primitive-static mint it IS `callee`, at no cost.
	let noun = callDiagnosticNoun(callee, mint: mint)

	// ⭐ THE TARGET GATE IS ASKED OF EVERY CALLEE, compiler-owned or not: a `__gt_now_ns` the parser
	// emitted and a `Clock.nowMs` stdlib declared are the same refusal, and asking it here — once,
	// before the two kinds part company below — is what keeps them one rule.
	requireTargetSupportsCallee(project, func: func, opIndex: opIndex, callee: callee, noun: noun, blameTargetErrorsHere: blameTargetErrorsHere)

	// ⭐ A COMPILER-INTERNAL CALL HAS NOTHING FOR THIS CHECK TO SAY. A `__`-prefixed callee
	// (`__mm_alloc`, `__print_string`, `__str_eq`) is emitted by the PARSER (`Parser.emitRuntimeCall`)
	// and built at the Std tier long after this pass, so it is in no registry — every check below would
	// fire, and each would report a defect in code the user did not write. Its arguments are the
	// compiler's own: their count is fixed at the emit site and their types are the runtime's, not a
	// signature's.
	//
	// ⚠ The early return is SOUND ONLY BECAUSE THE PARSER REFUSES A SOURCE-WRITTEN `__` CALLEE
	// (`Parser.requireCalleeIsNotReservedName`, E3004). Its stated premise used to be "no user name can be
	// DECLARED with this prefix, so a `__` CALLEE is provably compiler-owned" — which is about
	// DECLARATIONS, and a callee need not be declared anywhere. Three panics rode through that gap. What
	// makes the premise true is the closed door, not the reservation; do not remove one without the other.
	//
	// ⚠ **AND THE DOOR IS NOW AJAR FOR ONE FILE, WHICH IS WHY THE TEST IS `isSignaturelessCompilerCallee`
	// AND NOT THE PREFIX (A1r).** `stdlib/Builtins.maxon` may CALL the `__` names it declares, so a `__`
	// callee is no longer provably absent from `funcSignatures` — and one that is PRESENT is an ordinary
	// declared function that owes every check below: the arity that MEASURABLY went unreported for
	// `__int_fromString()` with its argument omitted, the argument LABELS (which is also what keeps a
	// labelled argument out of `lowerRuntimeCall`, whose positional guard would panic on one), and the
	// per-argument types. See `MmRuntime.isSignaturelessCompilerCallee` for the fact and the measurement, and
	// `Parser.requireCalleeIsNotReservedName` for why the registry asked THERE (`ProgramSignatures`, the only
	// one a parser may hold) and the registry asked HERE have to give a `__` name the same answer.
	//
	// The ONE thing this pass can say about a compiler-owned callee is which TARGET it can be lowered for,
	// because it is the first pass that holds both the call's source span and `project.target` — and that
	// is asked of every callee above, before this return.
	if isSignaturelessCompilerCallee(callee, funcSignatures: project.funcSignatures) 'compilerOwnCall'
		return
	end 'compilerOwnCall'

	if not project.funcSignatures.contains(callee) 'unknownFn'
		// ⭐⭐ **E3095, AND IT IS A SECOND PASS RE-EXAMINING A RESOLUTION ALREADY MADE — DELIBERATELY NOT
		// E3063's SHAPE (N1c).**
		//
		// The typealias twin is a candidate-set computation baked INTO the lookup: the alias registry holds
		// every declaration of a contested name under one bare key, so the ambiguity is discovered while
		// resolving. Nothing of the sort is true here. A contested free function has NO bare declaration —
		// each was registered under its own directory-qualified spelling — so by the time this pass runs the
		// parser has already resolved the bare callee, already failed to give it a local meaning
		// (`Parser.parseCallNamed`'s local-namespace tier), and is one line away from being told there is no
		// such function. The candidate set has to be RECONSTRUCTED from the contest index, against a decision
		// that has already been taken. That is the same relationship v1 draws between its two diagnostics
		// (`TypeResolution.maybeEmitAmbiguousCrossFileCall` runs after `qualifyCalleeForContextWithType` has
		// silently picked a first match) reached by shv2's own structure rather than copied from it.
		//
		// ⚠ **IT SITS INSIDE THE `unknownFn` ARM, WHICH IS THE POINT.** "There is no function of this name"
		// and "there are two and you must say which" are answers to one question, and only one of them may be
		// given. Reporting E3095 ahead of the arm would leave E3004 to fire as well; reporting it after would
		// never reach it.
		if reportAmbiguousCrossFileCall(project, signatures: signatures, funcNames: funcNames, callee: callee, callRange: callRange, filePath: filePath) 'ambiguousAcrossDirectories'
			return
		end 'ambiguousAcrossDirectories'

		reportPositioned(project, code: ErrorCode.callUnknownFunction, message: "call to undefined function '{String.from(noun)}'", line: callRange.line, column: callRange.column, filePath: filePath)
		return
	end 'unknownFn'

	if not calleeVisibleFrom(signatures, funcNames: funcNames, callee: callee, mint: mint, readerFilePath: filePath) 'notVisibleHere'
		reportCalleeNotVisible(project, funcNames: funcNames, callee: callee, noun: noun, callRange: callRange, filePath: filePath)
		return
	end 'notVisibleHere'

	let sig = try project.funcSignatures.get(callee) otherwise panic("validateCall: contains('{String.from(callee)}') true but get failed")
	match slotCallArgs(sig.paramNames, args: args, argLabels: argLabels, argDefaultSlots: argDefaultSlots) 'slot'
		ordered(argIds) then checkSlottedCall(project, func: func, result: result, callee: callee, sig: sig, args: args, argLabels: argLabels, argImmutableNames: argImmutableNames, argIds: argIds, escapeSummary: escapeSummary, mutationSummary: mutationSummary, callRange: callRange, filePath: filePath)
		arityMismatch(expected, got) then reportPositioned(project, code: ErrorCode.callArgCountMismatch, message: argArityMismatchMessage(String.from(noun), expected: expected, got: got), line: callRange.line, column: callRange.column, filePath: filePath)
		unknownLabel(argIndex, label) then reportArgError(project, code: ErrorCode.callUnknownArgLabel, message: argUnknownLabelMessage(String.from(noun), label: label), argRanges: argRanges, argIndex: argIndex, filePath: filePath)
		duplicateArg(argIndex, paramName) then reportArgError(project, code: ErrorCode.callDuplicateArg, message: argDuplicateMessage(String.from(noun), paramName: paramName), argRanges: argRanges, argIndex: argIndex, filePath: filePath)
	end 'slot'
end 'validateCall'

// ⭐⭐ **MAY THE CALLING FILE NAME THIS CALLEE (N1a)?** The function half of `Visibility`, which shv2 stamped
// on every declaration from its first commit and, until now, read nowhere: `func.visibility` was written at
// three sites and consulted at none, so ANY file could call ANY other file's non-exported function.
//
// **HERE, AND NOT IN THE PARSER**, for the reason E3004 is here: the parser mints a call before the whole
// program is necessarily parsed, and this is the first pass that holds the CALLER's file, the callee's
// declaration and the call's own span at once. It sits directly after the `unknownFn` gate, so the callee is
// already known to be declared — "no such function" and "not yours to call" are different mistakes and the
// blunter one is reported first.
//
// ⚠ **A CALLEE WITH NO DECLARING FILE IS EXEMPT, AND THAT IS THE RULE RATHER THAN A GUARD.** An empty
// `sourceFilePath` is `IrFunction`'s positive statement that the COMPILER built the function
// (`SourcePosition.synthesized`) — a param-default helper, a lifted closure's shim, a runtime entry point.
// Nobody wrote it, so no file can be refused it, and comparing its empty path against a real caller's would
// refuse every call to it. A callee the index does not know at all is exempt for the same reason it cannot
// be checked: there is no declaration to read a tier off.
function calleeVisibleFrom(signatures ProgramSignatures, funcNames FunctionNameIndex, callee ByteArray, mint CalleeMint, readerFilePath FilePath) returns bool
	// ⭐ **A CALLEE NAME THE AUTHOR DID NOT WRITE HAS NO VISIBILITY TO ANSWER FOR** — visibility governs what
	// a file may NAME, and a minted callee is one the compiler spelled out of something else the author
	// wrote (`int.fromString` ⇒ `__int_fromString`, an omitted argument ⇒ its default helper,
	// `FilePath from "…"` ⇒ `FilePath.init`). Each mint's own header says the call is the compiler's.
	if mintSpellsTheWholeCallee(mint) 'theCompilersOwnSpelling'
		return true
	end 'theCompilersOwnSpelling'

	// ⭐ **AND THE SYMMETRIC HALF: A CALLER WITH NO DECLARING FILE ASKS ON NOBODY'S BEHALF** (spec-port
	// `map-struct-bytearray`). Visibility governs what a FILE may name, and `__module_init` is a function
	// no file wrote — it exists because declarations across the WHOLE program asked for their slots to be
	// filled, so there is no single reader path to hold its calls to, and comparing its empty one against a
	// real declaration's refuses every call it makes. MEASURED: a same-file `var db = Database.create(…)`
	// beside a file-private `static function create` reported `E3008 function 'Database.create' is not
	// exported` — about a program with one file in it.
	//
	// ⛔⛔ **AND IT IS NOT A HOLE, BECAUSE EVERY USER-WRITTEN CALL `__module_init` MAKES IS CHECKED WHERE ITS
	// READER FILE STILL EXISTS.** Every other op in that function is a runtime call the arm above exempts.
	// TWO initializer forms write a user call, and both are decided against the declaring file of the BINDING
	// through this same `isVisibleFrom`: a top-level factory (`var db = Database.create(…)`), whose TYPE half
	// is `Parser.evalConstFactoryCallInto`'s own, and a DECLARED generic's empty record
	// (`var g = StrMap.create()`, W41). Their shared METHOD half is `Parser.requireGlobalInitCalleeIsVisible`.
	// Widening this exemption without those doors in place makes method visibility unaskable for every
	// globally-built record in the program.
	//
	// ⚠ It is asked BEFORE the callee's own path for the caller's-mistake-first reason the header states,
	// and it is exact rather than defensive: `SourcePosition.synthesized()` is `IrFunction`'s positive claim
	// that the compiler built the function, and every such function's calls are the compiler's.
	if readerFilePath.toString().isEmpty() 'callerIsCompilerBuilt'
		return true
	end 'callerIsCompilerBuilt'

	let declared = try funcNames.funcNamed(callee) otherwise return true
	if declared.sourceFilePath.toString().isEmpty() 'compilerBuilt'
		return true
	end 'compilerBuilt'

	return signatures.isVisibleFrom(declared.visibility, declFilePath: declared.sourceFilePath, readerFilePath: readerFilePath)
end 'calleeVisibleFrom'

// ⭐⭐ **DID THE MINT SPELL THE WHOLE CALLEE, OR ONLY ITS QUALIFIER? (F31)** — the exemption above turns on
// the WHOLE of it, because visibility governs what a file may NAME and a file that named nothing cannot be
// refused a name.
//
// ⛔ **IT IS A ROSTER RATHER THAN `mint != notMinted`, AND THE DIFFERENCE IS A HOLE THAT WOULD HAVE OPENED
// SILENTLY.** `resolvedTypeQualifier` is the first arm where the author DID name something — the member of
// `p.toString()` — with only the head resolved for them. Read as "minted, therefore the compiler's", it
// would have exempted EVERY method call in every program from E3008, so a non-exported method would have
// become callable from any file with a value in hand, and no test in the suite asks that question of a
// method. A `match` also makes the next arm a compile error here rather than a default it inherits.
function mintSpellsTheWholeCallee(mint CalleeMint) returns bool
	return match mint 'm'
		notMinted gives false
		primitiveStatic gives true
		paramDefaultHelper gives true
		stringLiteralInit gives true
		fieldDefaultHelper gives true
		resolvedTypeQualifier gives false
	end 'm'
end 'mintSpellsTheWholeCallee'

// ⭐⭐ **E3095 — A BARE CALL THAT COULD MEAN MORE THAN ONE DIRECTORY'S DECLARATION (N1c).** Answers whether
// it reported, so `validateCall` can suppress the "no such function" it would otherwise give the same call.
//
// **THE CANDIDATE SET IS RECONSTRUCTED, NOT LOOKED UP**, which is the whole shape difference from E3063.
// It walks every qualified spelling the contest index recorded for the bare name and keeps the ones that are
// (a) really declared and (b) visible from this file — the second test being the one that stops a
// file-private or out-of-subtree declaration from being offered as a fix the user cannot take. FEWER THAN
// TWO survivors is not an ambiguity: with one, the caller's real mistake is that it did not qualify a name
// it could have; with none, `validateCall`'s own E3004 is the honest answer and this stays quiet.
//
// ⚠ **`CalleeMint.notMinted` IS PASSED TO `calleeVisibleFrom` AND IT IS NOT A GUESS**: a contested name is
// one a USER declared as a free function in two directories, so every candidate is a name the author wrote.
// A minted callee is never in the contest index at all.
//
// Sorted through the shared `insertCandidateName`, so E3063 and E3095 order their candidates by one rule —
// see there for why shv2 cannot inherit v1's unordered rendering.
function reportAmbiguousCrossFileCall(project Project, signatures ProgramSignatures, funcNames FunctionNameIndex, callee ByteArray, callRange SourceRange, filePath FilePath) returns bool
	var candidates = StringArray.create()
	for spelling in signatures.contestedFreeFunctionSpellings(callee) 'eachSpelling'
		if not project.funcSignatures.contains(spelling) 'noSuchDeclarationAfterAll'
			continue
		end 'noSuchDeclarationAfterAll'

		if not calleeVisibleFrom(signatures, funcNames: funcNames, callee: spelling, mint: CalleeMint.notMinted, readerFilePath: filePath) 'notAFixThisFileCouldTake'
			continue
		end 'notAFixThisFileCouldTake'

		insertCandidateName(candidates, candidate: String.from(spelling))
	end 'eachSpelling'

	if candidates.count() < 2 'notAnAmbiguity'
		return false
	end 'notAnAmbiguity'

	reportPositioned(project, code: ErrorCode.semanticAmbiguousCrossFileCall, message: "Ambiguous bare-name call to '{String.from(callee)}': multiple visible definitions found. Qualify with a directory name. Candidates: {renderCandidateList(candidates)}", line: callRange.line, column: callRange.column, filePath: filePath)
	return true
end 'reportAmbiguousCrossFileCall'

// The two refusals, told apart by the TIER the declaration wrote — E3008 for a file-private callee, E3088
// for one scoped to a directory subtree the caller is outside of. Both messages are the reference
// compilers', byte for byte (`export-keyword`, `module-keyword`), and both are anchored on the CALL.
//
// The `global` arm is unreachable by construction — `isVisibleFrom` answers `true` for it and this is
// reached only when it answered `false` — so it panics rather than inventing a third sentence.
function reportCalleeNotVisible(project Project, funcNames FunctionNameIndex, callee ByteArray, noun ByteArray, callRange SourceRange, filePath FilePath)
	let declared = try funcNames.funcNamed(callee) otherwise panic("reportCalleeNotVisible: '{String.from(callee)}' has no declaration — `calleeVisibleFrom` answered `false`, which it can only do for a callee it found")
	reportHiddenCallee(project, noun: String.from(noun), tier: declared.visibility, line: callRange.line, column: callRange.column, filePath: filePath)
end 'reportCalleeNotVisible'

// ⭐ **THE CODE AND THE SENTENCE A HIDDEN CALLEE IS REFUSED WITH — one producer for the two positions a
// call can be written in.** A call in a function BODY reaches it from `validateCall` above, off
// `FunctionNameIndex`; a call in a TOP-LEVEL INITIALIZER reaches it from `Queries.reportParseError`'s
// `calleeNotVisible` arm, off the sweep's own visibility column, because that call is decided before this
// pass exists. Two askers, one wording — the discipline the `unknownTypeName` arm states.
//
// A program-wide callee (`global` or `public`) cannot be refused by any door, so reaching here with one is
// an invariant break.
export function reportHiddenCallee(project Project, noun String, tier Visibility, line LineNumber, column ColumnNumber, filePath FilePath)
	match tier 'tier'
		file then reportPositioned(project, code: ErrorCode.symbolNotExported, message: "function '{noun}' is not exported", line: line, column: column, filePath: filePath)
		module then reportPositioned(project, code: ErrorCode.symbolNotInModuleScope, message: "function '{noun}' is module-scoped and not visible from this directory", line: line, column: column, filePath: filePath)
		global or public then panic("reportHiddenCallee: '{noun}' is program-wide and visible from every file — no visibility door can have refused it")
	end 'tier'
end 'reportHiddenCallee'

// ⭐ **VALIDATE AN INDIRECT CALL AGAINST THE FUNCTION TYPE ITS CALLEE VALUE WAS DECLARED WITH.** The
// declared type is the authority: the call site derives its argument count, its per-argument register file
// and its result register from it, so anything the arguments disagree with it about is a wrong answer the
// backend cannot see. `f(3)` against a two-parameter function type read `b` out of whatever the register
// held; `f("hello")` at an int parameter did integer arithmetic on a heap pointer.
//
// Re-matched in a SMALL match so `args` is bound in a single-call arm, never in `checkCalls`' big one —
// the tail-slot-`Array` decref corruption `LowerMaxonToStd.lowerIndirectCall` documents.
function checkIndirectCall(project Project, func IrFunction, opIndex OpIndex, op MaxonOp)
	match op 'ic'
		indirectCall(_, callee, args) then checkIndirectCallArgs(project, func: func, opIndex: opIndex, callee: callee, args: args)
		default panic("checkIndirectCall: expected an `indirectCall` op, got a different MaxonOp variant — `checkCalls` routes only `indirectCall` here")
	end 'ic'
end 'checkIndirectCall'

// The arity and per-argument type checks, against the callee value's declared shape. A helper because the
// arm above must hand `args` to a function and touch it no other way (see there).
function checkIndirectCallArgs(project Project, func IrFunction, opIndex OpIndex, callee ValueId, args ValueIdArray)
	let callRange = project.opRanges.get(opIndex)
	let calleeName = functionValueGoverningName(project, func: func, value: callee)
	// Unreachable `undeclared`, and PROVEN so at the point the op was emitted rather than assumed here:
	// `Parser.mintIndirectCallResult` types every indirect call's result through `functionValueReturnType`,
	// which resolves the same governing name against the same three producers (a lifted closure, a function
	// alias, a declared function) and panics if it is none of them. So an `indirectCall` op cannot exist
	// with a callee whose type nothing declares.
	let shape = requireFunctionShapeOf(functionTypeRegistryOf(project), name: calleeName, side: "called")

	// The trailing uniform-ABI env pointer is the compiler's, not the program's (see IndirectCallEnvArgCount).
	let suppliedCount = args.count() - IndirectCallEnvArgCount
	if suppliedCount != shape.paramTypes.count() 'arity'
		reportPositioned(project, code: ErrorCode.callArgCountMismatch, message: argArityMismatchMessage(String.from(calleeName), expected: shape.paramTypes.count(), got: suppliedCount), line: callRange.line, column: callRange.column, filePath: func.sourceFilePath)
		return
	end 'arity'

	for i in 0 upto suppliedCount 'eachArg'
		let argId = try args.get(i) otherwise panic("checkIndirectCallArgs: args.get OOB at {i} — the arity check above proved there are at least this many")
		let paramType = try shape.paramTypes.get(i) otherwise panic("checkIndirectCallArgs: paramTypes.get OOB at {i} — the arity check above proved the counts equal")
		// ⭐ **THE FUNCTION TYPE'S OWN PRE-ERASURE CARRIER, and passing `EmptySourceText` here was a measured
		// FALSE REFUSAL rather than a missed one.** This site read *"a function TYPE carries no pre-erasure
		// union/enum identity"* — true until `FunctionShape.paramAggregateNames` existed, stale the moment it
		// did. With the carrier empty, a `function(Payload)` parameter resolved to bare `integer` and the
		// aggregate rule refused the only argument it can legally be called with: *"expected 'int', got
		// 'Payload'"*, a sentence naming the erasure instead of the program.
		//
		// `declaredParamName` stays empty and is the one column a `FunctionShape` genuinely does not have: it is
		// the SPELLING, and a function type gives its parameters no names to spell.
		// ⚠ The CALLEE is this call's own subject, and it is a function VALUE — never `genericInstance`-tagged —
		// so the shape substitution declines. That is the right answer as well as an honest one: an indirect
		// call's declared shape is the function TYPE's own, written in no generic body's declaration view.
		checkOneArgType(project, func: func, paramType: paramType, preErasedAggregate: shapeParamIdentity(shape, index: i), declaredParamName: EmptySourceText, paramName: EmptySourceText, position: i, argId: argId, callInstanceSubject: callee, paramExistentialSites: sharedEmptyParamExistentialSites, callRange: callRange, filePath: func.sourceFilePath)
	end 'eachArg'
end 'checkIndirectCallArgs'

// The NAME that governs a function value's type — the FUNCTION it refers to (a `functionRef`, or a lifted
// closure) or the function TYPEALIAS the place it came from was declared with. It is the value's own
// `named` column entry, because `MaxonType.function(id)` carries exactly that (see MaxonType's `function`
// arm); the parser reads the same fact through its file-local interner in `functionValueReturnType`. The id
// becomes the name through `TypeResolution.functionTypeNameOf`, the one reader every pass shares.
function functionValueGoverningName(project Project, func IrFunction, value ValueId) returns ByteArray
	let nameId = try func.valueNameIds.get(value) otherwise panic("functionValueGoverningName: value v{value} of function '{String.from(func.name)}' has no recorded type name — the two type columns are minted in lockstep")
	return functionTypeNameOf(functionTypeRegistryOf(project), nameId: nameId)
end 'functionValueGoverningName'

// ⭐ **DRAIN THE FUNCTION-TYPE DOORS — the whole-program half of a rule the parser can only record.** Each
// entry is a function VALUE that met a function TYPE the program fixed somewhere else — a place it is stored
// in or passed through, and (since function-backed enums and container columns) a DECLARATION that fixes one
// without any value flowing at all. The two shapes must agree, and until this drained, only the `function`
// TAG was compared. `FunctionTypeDoor` is the roster and is deliberately not re-listed here; see
// `PendingFunctionTypeDoor` and `Parser.recordFunctionTypeDoor`.
function checkFunctionTypeDoors(project Project)
	// An INDEX loop, not `for … in`: the element is a BORROW of `project`, and the call below is
	// recorded as writing that same storage. ⚖ Ruling of 2026-08-26 — canonical note at
	// `IR/Std/ElimTrivialBlockArgs.elimTrivialBlockArgs`.
	for doorIndex in 0 upto project.pendingFunctionTypeDoors.count() 'eachDoor'
		checkOneFunctionTypeDoor(project, door: try project.pendingFunctionTypeDoors.get(doorIndex) otherwise panic("checkFunctionTypeDoors: doorIndex {doorIndex} is below project.pendingFunctionTypeDoors.count()"))
	end 'eachDoor'
end 'checkFunctionTypeDoors'

// One door. Both governing names resolve — see `TypeResolution.requireFunctionShapeOf`.
function checkOneFunctionTypeDoor(project Project, door PendingFunctionTypeDoor)
	let declared = requireFunctionShapeOf(functionTypeRegistryOf(project), name: door.declaredName, side: "declared")
	let got = requireFunctionShapeOf(functionTypeRegistryOf(project), name: door.gotName, side: "arriving")
	if functionShapesAgree(functionTypeRegistryOf(project), declared: declared, got: got) 'agree'
		return
	end 'agree'

	let expected = formatFunctionShapeDisplay(declared, typeNames: project.typeNames)
	let actual = formatFunctionShapeDisplay(got, typeNames: project.typeNames)
	// A cast is a CAST rejection and takes E3009, the sibling of the cross-kind refusal
	// `castHasNoLegalConversion` makes; every other door is a type mismatch and takes E3005, the sibling of
	// what a bool meeting a declared int earns there. ONE sentence for every door, because one RULE decides
	// them all — the site phrase is the whole of what varies.
	let code = ErrorCode.semanticUnsafeCast if door.door == FunctionTypeDoor.cast else ErrorCode.typeMismatch
	reportPositioned(project, code: code, message: "function type mismatch {functionTypeDoorSite(door)}: expected '{expected}', got '{actual}'", line: door.line, column: door.column, filePath: door.filePath)
end 'checkOneFunctionTypeDoor'

// ⭐ **DRAIN THE `map` TRANSFORMS — the PARAMETER half of the same relationship, at the one position whose
// function type the COMPILER owns rather than a declaration.** Each entry is a function value bound as a
// container `map`'s transform; the position calls it with exactly one argument and that argument is the
// container's own element, and until this drained nothing compared either fact against what the value
// declares. See `PendingTransformArity` and `Parser.requireElementTransform`.
function checkTransformArities(project Project)
	// An INDEX loop, not `for … in`: the element is a BORROW of `project`, and the call below is
	// recorded as writing that same storage. ⚖ Ruling of 2026-08-26 — canonical note at
	// `IR/Std/ElimTrivialBlockArgs.elimTrivialBlockArgs`.
	for transformIndex in 0 upto project.pendingTransformArities.count() 'eachTransform'
		checkOneTransform(project, transform: try project.pendingTransformArities.get(transformIndex) otherwise panic("checkTransformArities: transformIndex {transformIndex} is below project.pendingTransformArities.count()"))
	end 'eachTransform'
end 'checkTransformArities'

// One transform. The governing name resolves for the same reason a door's does — a `function` tag is minted
// only from a declared function, a lifted closure or a function alias, and `requireFunctionShapeOf` reads
// all three.
//
// ⚠ **THE WHOLE SHAPE IS NOT ASKED, AND THAT IS DELIBERATE.** The RETURN half is already decided, in the
// parser, by a rule `functionShapesAgree` cannot express (`Parser.elementTransformAnswersElement`: two
// structs both `structRef` are not the same element), so asking `functionShapesAgree` here would either
// duplicate that rule or contradict it. What is left for this tier is exactly the arity and the PARAMETER,
// and the parameter is judged by the SAME `elementTypePreserved` the return half asks — one rule, two
// extractions, which is the only arrangement in which the two halves of one declaration cannot disagree.
function checkOneTransform(project Project, transform PendingTransformArity)
	let shape = requireFunctionShapeOf(functionTypeRegistryOf(project), name: transform.gotName, side: "transform")
	let method = String.from(transform.methodName)
	if shape.paramTypes.count() != transform.expectedArity 'wrongArity'
		reportPositioned(project, code: ErrorCode.transformArityMismatch, message: "`{method}` calls its transform with {transform.expectedArity} argument(s) — the container's own element — but this transform declares {shape.paramTypes.count()} parameter(s); a transform is `function(Element) returns Element`", line: transform.line, column: transform.column, filePath: transform.filePath)
		return
	end 'wrongArity'

	checkTransformParamType(project, transform: transform, shape: shape, method: method)
end 'checkOneTransform'

// ⭐⭐ **THE TRANSFORM'S PARAMETER IS THE CONTAINER'S ELEMENT, AND UNTIL THIS EXISTED IT WAS A REACHABLE
// SEGFAULT.** `stdlib/Interfaces.maxon` declares the transform `function(Element) returns Element`, and the
// walk hands it the element whatever it declares — so `nums.map(function(a String) gives a.count())` over an
// int array compiled clean and died SIGSEGV, dereferencing the integer `1` as a `String` record pointer.
//
// The comparison is `elementTypePreserved`, the return half's own verdict; the only local part is the
// identity EXTRACTION, and the two sides are read at DIFFERENT tiers — the element pre-resolution off the
// record, the parameter post-resolution off the shape. `Parser.resolvedElementIdentity` carries why that
// makes the element's recorded identity narrower than the parser's own.
//
// ⚠ **THE PARAMETER'S IDENTITY IS READ THE WAY `checkOneArgType` READS ITS PARAMETER'S — LIVE FIRST, THEN
// THE PRE-ERASURE CARRIER — because one of the two aggregate kinds does not survive resolution.** A struct
// parameter still says `structRef(Point)` here; a boxed union/enum parameter is bare `integer` and only
// `FunctionShape.paramAggregateNames` still holds its name. Asking only the live answer made every enum
// agree with every other enum — MEASURED as a compiling program that faults, see that column's header — so
// the fallback is not a nicety, it is the half of the check that was missing.
//
// It is E3005 and not E3122: the arity ruling's code says how MANY parameters a transform declares, and
// wearing it for a TYPE disagreement would print a sentence about a count that is correct.
//
// ⚠ Reached only past the arity check, so position 0 exists by construction.
function checkTransformParamType(project Project, transform PendingTransformArity, shape FunctionShape, method String)
	let paramType = try shape.paramTypes.get(0) otherwise panic("checkTransformParamType: paramTypes.get OOB at 0 — the arity check proved this transform declares {transform.expectedArity} parameter(s)")
	let paramTag = maxonTypeTag(paramType)
	var paramIdentity = aggregateNameFor(project, tag: paramTag, nameId: typeNameIdOf(paramType), readerFilePath: transform.filePath)
	if paramIdentity.isEmpty() 'erasedUnionParam'
		paramIdentity = shapeParamIdentity(shape, index: 0)
	end 'erasedUnionParam'

	if elementTypePreserved(transform.elementTag, elementIdentity: transform.elementIdentity, otherTag: paramTag, otherIdentity: paramIdentity) 'agree'
		return
	end 'agree'

	reportPositioned(project, code: ErrorCode.typeMismatch, message: "`{method}` calls its transform with the container's own element, which is '{displayNameOfAggregate(transform.elementTag, aggregate: transform.elementIdentity)}' — but this transform declares its parameter as '{displayNameOfAggregate(paramTag, aggregate: paramIdentity)}'; a transform is `function(Element) returns Element`, so its parameter IS the element", line: transform.line, column: transform.column, filePath: transform.filePath)
end 'checkTransformParamType'

// ⭐⭐ **E3064 — A CALL WHOSE RESULT NOBODY TOOK, WHEN THE CALLEE HAD NO OTHER REASON TO RUN.** Drains the
// sites the parser recorded (`PendingDiscardedResult`) against the effect summary built below. The message
// and the code are `specs/tuple-assign.md`'s, and the anchor is the site's own — the statement's `(`, which
// is where the author wrote the discards.
//
// ⚠ **THE SUMMARY IS ASKED ONLY WHEN A SITE EXISTS**, and that is not an optimization: it is a whole-program
// walk over every function's every op, and almost no program writes an all-discard tuple assignment. A
// compile that records no site pays nothing at all.
// ⭐ **E3073 — a spawn of a function that can never suspend.** `async` exists to overlap waiting with other
// work; a callee that only computes runs straight through on the spawning thread, so the spawn buys nothing
// and the author has almost certainly meant something else. Reported at every `asyncCall` whose callee the
// whole-program yield closure could not mark.
//
// ⚠ The subject is the spawn's SOURCE TEXT (`'async heavyCompute(5)'`), carried from the parser in
// `project.asyncSpawnSites` — see there for why it cannot be recovered at this tier. A spawn with no recorded
// text is skipped rather than reported with an empty subject: the only way to reach that state is a synthetic
// `asyncCall` no author wrote, which is not something to blame anybody for.
function checkAsyncYielding(project Project, module MaxonModule, funcNames FunctionNameIndex)
	if project.asyncSpawnSites.count() == 0 'noSpawnsInThisProgram'
		return
	end 'noSpawnsInThisProgram'

	let yields = buildYieldingSummary(module, funcNames: funcNames)
	for funcIndex in 0 upto funcNames.functions.count() 'eachFunc'
		let func = try funcNames.functions.get(funcIndex) otherwise panic("checkAsyncYielding: functions.get OOB at {funcIndex}")
		for blockRef in func.blockRefs 'eachBlock'
			let block = try module.blocks.get(blockRef) otherwise panic("checkAsyncYielding: blockRef from func.blockRefs not in module.blocks")
			for opIndex in block.opRefs 'eachOp'
				reportIfNonYielding(project, op: try module.ops.get(opIndex) otherwise panic("checkAsyncYielding: opIndex {opIndex} not in module.ops"), opIndex: opIndex, func: func, funcNames: funcNames, yields: yields)
			end 'eachOp'
		end 'eachBlock'
	end 'eachFunc'
end 'checkAsyncYielding'

// One op. Only an `asyncCall` has anything to answer for; the band ranges cover every other op so a newly
// appended one fails to compile here rather than silently escaping the check.
function reportIfNonYielding(project Project, op MaxonOp, opIndex OpIndex, func IrFunction, funcNames FunctionNameIndex, yields BoolArray)
	match op 'op'
		call to indirectCall then return
		asyncCall(_, callee, _, _, _, _, _) then reportSpawnOfNonYielding(project, callee: callee, opIndex: opIndex, func: func, funcNames: funcNames, yields: yields)
		await to errorFlagEncode then return
		// ⭐⭐ **E3073's RULE IS EXACTLY WRONG FOR A SERVICE, SO NEITHER OP MAY EVER REACH IT.** *"function
		// never yields; `async` is for I/O-concurrent work only"* is a statement about a COROUTINE, which
		// overlaps waiting and cannot overlap execution — so a non-yielding one is pure waste. A service's
		// green thread is scheduled independently and CPU-bound work is exactly what one is for; a message
		// handler that never parks is the normal case, not a defect.
		serviceSpawn to serviceReplyCell then return
	end 'op'
end 'reportIfNonYielding'

// The spawn site itself. Keyed by the SAME name `calleeYields` built its edges from, so a spawn can never look
// up a different function than the one whose yields were computed. A callee the index does not know is one
// this pass cannot see through, and by the closure's asymmetry that resolves toward accepting.
function reportSpawnOfNonYielding(project Project, callee ByteArray, opIndex OpIndex, func IrFunction, funcNames FunctionNameIndex, yields BoolArray)
	let calleeIndex = try funcNames.byName.get(callee) otherwise return
	let calleeYieldsSomewhere = try yields.get(calleeIndex) otherwise panic("reportSpawnOfNonYielding: yields.get({calleeIndex}) OOB below count {yields.count()} — the column is built over `funcNames.functions`, which is the index space `byName` resolves into")
	if calleeYieldsSomewhere 'itCanSuspend'
		return
	end 'itCanSuspend'

	let site = try project.asyncSpawnSites.get(opIndex) otherwise return
	reportPositioned(project, code: ErrorCode.asyncNonYielding, message: "'{String.from(site.text)}' — function never yields; 'async' is for I/O-concurrent work only", line: site.line, column: site.column, filePath: func.sourceFilePath)
end 'reportSpawnOfNonYielding'

function checkDiscardedResults(project Project, module MaxonModule, funcNames FunctionNameIndex)
	if project.pendingDiscardedResults.count() == 0 'nothingDiscardedAWholeResult'
		return
	end 'nothingDiscardedAWholeResult'

	let effectFree = buildEffectFreeSummary(module, funcNames: funcNames)
	// An INDEX loop, not `for … in`: the element is a BORROW of `project`, and the call below is
	// recorded as writing that same storage. ⚖ Ruling of 2026-08-26 — canonical note at
	// `IR/Std/ElimTrivialBlockArgs.elimTrivialBlockArgs`.
	for siteIndex in 0 upto project.pendingDiscardedResults.count() 'eachSite'
		let site = try project.pendingDiscardedResults.get(siteIndex) otherwise panic("checkDiscardedResults: siteIndex {siteIndex} is below project.pendingDiscardedResults.count()")
		let calleeIndex = try funcNames.byName.get(site.callee) otherwise continue
		if not (try effectFree.get(calleeIndex) otherwise panic("checkDiscardedResults: effectFree.get({calleeIndex}) OOB below count {effectFree.count()} — the column is built over `funcNames.functions`, which is the index space `byName` resolves into")) 'theCallDidSomething'
			continue
		end 'theCallDidSomething'

		// Scalars off the borrow, a fresh inline read for the managed halves — see the loop header's note.
		let line = site.line
		let column = site.column
		reportPositioned(project, code: ErrorCode.semanticDiscardedPureResult, message: "result of pure function '{String.from((try project.pendingDiscardedResults.get(siteIndex) otherwise panic("checkDiscardedResults: siteIndex {siteIndex} is below project.pendingDiscardedResults.count()")).callee)}' must be used", line: line, column: column, filePath: (try project.pendingDiscardedResults.get(siteIndex) otherwise panic("checkDiscardedResults: siteIndex {siteIndex} is below project.pendingDiscardedResults.count()")).filePath)
	end 'eachSite'
end 'checkDiscardedResults'

// ⭐⭐ **WHICH FUNCTIONS ARE PROVABLY FREE OF OBSERVABLE EFFECT** — a dense `bool` per function over
// `funcNames.functions`, in the index space `funcNames.byName` resolves into, exactly as
// `ParamMutationSummary` publishes its masks.
//
// ⛔⛔ **"NOT PROVABLY EFFECT-FREE" IS THE ANSWER FOR EVERYTHING THIS PASS CANNOT SEE, AND THAT DIRECTION IS
// THE WHOLE SAFETY ARGUMENT.** Its one consumer REFUSES a program when the answer is "effect-free", so an
// over-generous classification does not miss a diagnostic — it rejects a legal program. Every unknown
// therefore reads as an effect: a callee no `IrFunction` declares, an indirect or witness dispatch whose
// target is chosen at run time, a spawn, an await, a throw, a panic, a touch of module storage. The cost is
// missed diagnostics, which is the direction that cannot break anything.
//
// ⛔⛔ **A FIELD ASSIGNMENT IS ON THAT LIST THROUGH A COLUMN OF THIS RULE'S OWN, AND THE FIRST VERSION GOT IT
// WRONG BY BORROWING E3070's.** The seed below reads `IrFunction.assignsIntoAnExistingAggregate`, set at the
// two assignment emitters (`Parser.emitFieldWrite`, `Parser.writeBackPayload`). It used to read the two
// PARAMETER masks alone — both of which their own doors deliberately narrow to ARRAY-instance fields, because
// only an array write can free an array element — so `self.n = self.n + 1` on an int field set neither, a
// method doing exactly that was classified effect-free, and a legal program was REFUSED. A fact recorded for
// one consumer, reused as the floor for another, where the first one's deliberate narrowing is the second
// one's hole; the two doors could not know a second consumer had come to lean on them being wide.
//
// ⚠⚠ **AND THE ORACLE COULD NOT ARBITRATE IT, BECAUSE IT DISAGREES WITH ITSELF.** MEASURED, three programs,
// each `(_, _) = <the call>`, against the bootstrap:
//
//   | the write                                  | bootstrap         | shv2 before | shv2 now |
//   | bare `n = n + 1` inside a method           | COMPILES (impure) | E3064       | COMPILES |
//   | `self.n = self.n + 1` inside a method      | E3064 (pure)      | E3064       | COMPILES |
//   | `c.n = 7` through a `c Counter` PARAMETER  | E3064 (pure)      | E3064       | COMPILES |
//
// One write, two spellings, two verdicts from the reference — so rows 2 and 3 are NOT evidence that refusing
// is correct, they are evidence the bootstrap has a hole of its own, and a check that measured only those two
// read as total agreement. **shv2 deliberately accepts all three.** That is the semantically right answer (a
// method that mutates its receiver has an effect) and the safe direction for a REFUSING diagnostic: shv2 now
// accepts everything the oracle accepts on this axis, plus the two shapes the oracle wrongly refuses. The
// bootstrap's hole is not chased here.
//
// ⭐ **THE ONE CARVE-OUT IS THE HEAP RUNTIME (`isRuntimeCallee`, the `__mm_` family), and without it the
// analysis would be vacuous rather than conservative.** Every struct in shv2 IS a heap box, so `return (a,
// b)` emits an `__mm_alloc` — count that as an effect and NO function that builds a value is ever
// effect-free, including the `makePair` the spec's own case is about. Allocation, retain and release are
// bookkeeping the SOURCE never asked for: the compiler emits them, they are unobservable to the program, and
// `isRuntimeCallee` is the predicate that already draws exactly that line for exactly that reason (see its
// header — it is deliberately narrower than `isCompilerInternalCallee`, so a `__write_stdout` or a
// `__destruct_*` is NOT waved through here and `print` stays what it is).
//
// ⭐ **AND THE CLOSURE IS THE SHARED ENGINE, NOT A ROUND-BASED RE-SCAN.** Effects propagate to CALLERS, which
// is reverse reachability over the call graph — `reverseReachabilityMark` — seeded with the functions whose
// own bodies show one. The same relation, the same CSR and the same complexity argument as the parameter
// mutation and closure escape summaries; see that routine's header for why a re-scan loop is a different
// complexity and not a different spelling.
function buildEffectFreeSummary(module MaxonModule, funcNames FunctionNameIndex) returns BoolArray
	var seeds = BoolArray.create()
	var edges = CallGraphEdges.create()
	for i in 0 upto funcNames.functions.count() 'eachFunc'
		let func = try funcNames.functions.get(i) otherwise panic("buildEffectFreeSummary: functions.get OOB at {i}")
		seeds.push(functionShowsAnEffect(module, func: func, funcIndexByName: funcNames.byName, callerIndex: i, edges: edges))
	end 'eachFunc'

	var effectFree = BoolArray.create()
	let effectful = markSeededCallers(edges, seeds: seeds, nodeCount: funcNames.functions.count())
	for i in 0 upto effectful.count() 'invert'
		effectFree.push(not (try effectful.get(i) otherwise panic("buildEffectFreeSummary: effectful.get({i}) OOB below count {effectful.count()}")))
	end 'invert'
	return effectFree
end 'buildEffectFreeSummary'

// ⭐⭐ **THE WHOLE-PROGRAM YIELD CLOSURE — E3073.** Which functions can give up the green thread, closed over
// the call graph exactly as `buildEffectFreeSummary` closes "shows an effect": seed each function from its own
// body, then let `reverseReachabilityMark` push every yielding callee's mark up into everyone who calls it.
// The result indexes by `FuncIndex` and answers "a spawn of THIS function is a spawn of something that can
// actually suspend".
//
// ⭐ **THE SEEDS ARE THE RUNTIME'S PARK POINTS, NOT A TRANSCRIBED LIST OF STDLIB ENTRY POINTS.** v1 seeds its
// closure from a hand-written roster of ~30 names (`__ManagedFile.exists`, `__ManagedSocket.recv`, …) mapped
// onto its Maxon-tier callees. shv2 needs none of that, and the difference is structural rather than a
// preference: shv2's parser lowers those builtins to their RUNTIME symbols directly, so by the time this walk
// runs there is no `__ManagedFile.exists` left to name — there is `__mf_exists`, which is precisely the
// function that calls `__gt_io_park`. So the seed set is the runtime band itself
// (`ioYieldingRuntimeCallee`), and `File.exists` is derived: stdlib's body calls `__mf_exists`, this walk
// crosses that edge, and `File.exists` comes out yielding without anybody having written its name down.
//
// ⚠ **IT ERRS TOWARD ACCEPTING, DELIBERATELY, AND THE ASYMMETRY IS THE WHOLE SAFETY ARGUMENT.** A function
// this walk cannot see through — an `indirectCall` through a closure, a `witnessDispatch`, a callee no module
// declares — is treated as YIELDING. Over-accepting costs a pointless spawn the compiler failed to complain
// about; under-accepting REFUSES A CORRECT PROGRAM, and a false rejection is not something the author can work
// around. Every unknown therefore resolves toward "yields".
function buildYieldingSummary(module MaxonModule, funcNames FunctionNameIndex) returns BoolArray
	var seeds = BoolArray.create()
	var edges = CallGraphEdges.create()
	for i in 0 upto funcNames.functions.count() 'eachFunc'
		let func = try funcNames.functions.get(i) otherwise panic("buildYieldingSummary: functions.get OOB at {i}")
		seeds.push(functionYieldsDirectly(module, func: func, funcIndexByName: funcNames.byName, callerIndex: i, edges: edges))
	end 'eachFunc'

	return markSeededCallers(edges, seeds: seeds, nodeCount: funcNames.functions.count())
end 'buildYieldingSummary'

// ⛔⛔ **THE CLOSURE STEP OF EVERY WHOLE-PROGRAM SUMMARY IN THIS FILE, AND THE ORIENTATION IS THE WHOLE FACT.**
// `buildCsr(calleeIndices, to: callerIndices)` is the REVERSED relation: each CALLEE's row lists the functions
// that CALL it, which is what lets `reverseReachabilityMark` push a seed's mark UP into its callers. Swap the
// two columns and the walk marks callees of seeds instead — a silent wrong answer in the accepting direction,
// which is the one no test can be relied on to catch (see `CallGraphEdges`' header for the near-identical
// mistake that shipped green because nothing propagated at all).
//
// ⇒ it is written ONCE. The two summaries above differ in their SEED PREDICATE and in nothing else; that
// difference stays where it is, because carrying it in here would mean either a function-value parameter (a
// mechanism no other call site in this compiler uses) or a mode flag selecting between two predicates, which
// is the enumerated door this file spends its length arguing against.
module function markSeededCallers(edges CallGraphEdges, seeds BoolArray, nodeCount CsrIndex) returns BoolArray
	return reverseReachabilityMark(buildCsr(edges.calleeIndices, to: edges.callerIndices, nodeCount: nodeCount), seeds: seeds)
end 'markSeededCallers'

// The SEED: does this function's OWN body reach a park point, before the call graph is closed? The same walk
// records the caller-callee edges, so the graph and the seeds come out of ONE pass — `functionShowsAnEffect`'s
// shape, and its early-return is sound for the same reason: a function already marked needs no incoming edge.
//
// A function with NO body is a declaration this module cannot read (a restored intrinsic, an extern). Nothing
// about it is provable, so by the erring-toward-accepting rule above it counts as yielding.
function functionYieldsDirectly(module MaxonModule, func IrFunction, funcIndexByName FuncIndexByName, callerIndex FuncIndex, edges CallGraphEdges) returns bool
	if func.blockRefs.count() == 0 'noBodyToProveAnythingAbout'
		return true
	end 'noBodyToProveAnythingAbout'

	for blockRef in func.blockRefs 'eachBlock'
		let block = try module.blocks.get(blockRef) otherwise panic("functionYieldsDirectly: blockRef from func.blockRefs not in module.blocks")
		for opIdx in block.opRefs 'eachOp'
			if opYields(try module.ops.get(opIdx) otherwise panic("functionYieldsDirectly: opIdx {opIdx} not in module.ops"), funcIndexByName: funcIndexByName, callerIndex: callerIndex, edges: edges) 'yields'
				return true
			end 'yields'
		end 'eachOp'
	end 'eachBlock'
	return false
end 'functionYieldsDirectly'

// The per-op arm, band-for-band with `opShowsAnEffect` so a newly appended op fails to compile here too. The
// bands that differ from that function are the ones where "suspends the green thread" and "is observable"
// genuinely part company: a `globalAddr` is an effect and no yield at all, while an `await` is both.
function opYields(op MaxonOp, funcIndexByName FuncIndexByName, callerIndex FuncIndex, edges CallGraphEdges) returns bool
	return match op 'op'
		call(_, callee, _, _, _, _, _, _) gives calleeYields(callee, funcIndexByName: funcIndexByName, callerIndex: callerIndex, edges: edges)
		literal to branch gives false
		globalAddr gives false
		loadIndirect to stringLiteral gives false
		tryCall(_, _, callee, _, _, _, _, _, _) gives calleeYields(callee, funcIndexByName: funcIndexByName, callerIndex: callerIndex, edges: edges)
		throwError to propagateError gives false
		panicAbort gives false
		functionRef gives false
		// ⭐ The target is chosen at run time or out of a witness table, so there is no callee to close over —
		// and an unknown resolves toward "yields" (see `buildYieldingSummary`'s asymmetry note).
		indirectCall gives true
		// ⭐ A SPAWN IS AN EDGE, NOT A YIELD. `async f()` suspends this frame exactly when `f` can suspend, so it
		// contributes the same edge an ordinary call does — which is what makes a function that spawns a
		// yielding function itself yielding, and is also exactly the case E3073 rejects when `f` cannot.
		asyncCall(_, callee, _, _, _, _, _) gives calleeYields(callee, funcIndexByName: funcIndexByName, callerIndex: callerIndex, edges: edges)
		// An `await` suspends this frame until another green thread completes. That IS the yield.
		await to tryAwait gives true
		sizeofType to switch gives false
		witnessDispatch to witnessTryDispatch gives true
		panicAbortValue gives false
		errorFlagEncode gives false
		// ⭐ **NEITHER SUSPENDS THE FRAME THAT WROTE IT, AND NEITHER IS AN EDGE EITHER.** A `spawn` hands the
		// work to a green thread of its own and returns a handle; a send appends an envelope under
		// `__sched_lock` and returns. The handler runs on the SERVICE's thread, so whether it can park says
		// nothing about whether this frame can — which is the exact opposite of `asyncCall`, whose coroutine
		// runs on this frame's own thread and therefore contributes its edge.
		serviceSpawn to serviceReplyCell gives false
	end 'op'
end 'opYields'

// One call, judged by its callee: a runtime park point yields outright, a callee this module declares
// contributes an EDGE and lets the closure decide, and anything else is an unknown that resolves toward
// "yields".
function calleeYields(callee ByteArray, funcIndexByName FuncIndexByName, callerIndex FuncIndex, edges CallGraphEdges) returns bool
	if ioYieldingRuntimeCallee(callee) 'parksTheGreenThread'
		return true
	end 'parksTheGreenThread'

	return not recordCallGraphEdge(callee, funcIndexByName: funcIndexByName, callerIndex: callerIndex, edges: edges)
end 'calleeYields'

// ⭐ **RECORD THE (callee, caller) EDGE FOR ONE NAMED CALLEE, AND SAY WHETHER THE MODULE HOLDS THAT CALLEE.**
// A name no `IrFunction` declares — a restored intrinsic, an extern, a runtime entry — contributes no edge,
// and every summary that closes over this graph has to decide for itself what an unresolvable callee MEANS:
// the yield summary reads it as *"assume it yields"* (its accepting direction), and the blocking graph reads
// it as *"no edge"* (its accepting direction). The two answers are opposite because the two diagnostics
// refuse in opposite directions, which is exactly why the verdict is the CALLER's and the recording is
// shared. ⚠ `module`, for `CallGraphEdges`' reason.
module function recordCallGraphEdge(callee ByteArray, funcIndexByName FuncIndexByName, callerIndex FuncIndex, edges CallGraphEdges) returns bool
	let calleeIndex = try funcIndexByName.get(callee) otherwise return false
	edges.record(calleeIndex, callerIndex: callerIndex)
	return true
end 'recordCallGraphEdge'

// ⭐⭐ **THE PARK POINTS — THE ONLY SEEDS OF THE YIELD CLOSURE, AND EACH ONE REALLY SUSPENDS.** Every name here
// is a runtime entry whose body switches the green thread off the CPU, so this predicate describes measured
// behaviour rather than a model of it:
//
//   • `__gt_sleep` — parks on the timer store until its deadline passes (`emitGtParkOnDeadline`).
//   • `__gt_resched` — the cooperative yield behind `Runtime.yield()`: hands the CPU to the next runnable
//     green thread, or drives one from GT0.
//   • `__gt_process_run` — parks on a child process until it exits.
//   • `__gt_await_any` — the SELECT (SV3): it runs the shared cooperative drive loop, so it switches into
//     other green threads and blocks this M on the netpoll exactly as an `await` does. `__mbox_send` and
//     `__mbox_close` are the counter-example and are deliberately absent — both complete INLINE.
//     ⚠ **RE-MEASURED FOR THIS MEMBER, and the block below's finding holds one name later (SV3):** with
//     `__gt_await_any` struck from the predicate and rebuilt, `async` over a function whose ONLY yield is
//     `__Builtins.awaitAny` still COMPILES, and the control — `async` over a pure function — still answers
//     E3073. The unknown-callee fallback decides it, exactly as it decides every other name here.
//   • the `__mf_*` / `__md_*` FILESYSTEM bands — every one that makes a kernel call opens with `__gt_io_park`
//     (see `GtIoParkName`), which is what makes `async` over `File.exists` mean something.
//
// ⚠ **THE FILESYSTEM BANDS ARE A PREFIX TEST AND SO OVER-APPROXIMATE — IN THE SAFE DIRECTION, ON PURPOSE.**
// Three members park nothing because they touch no kernel: `__mf_stat_field`, `__mf_stat_free` and
// `__md_filename` read memory a previous call already fetched. Naming them as exceptions would put the roster
// in TWO places — here, and at the call sites of `emitIoPark` (which is where the roster's own count is
// stated, sites and emitted entry points being two different numbers) — and the two would rot apart the first
// time a `__mf_*` was added. The prefix cannot rot: a new filesystem entry point is covered the day it exists.
// It over-approximates in the direction this walk's asymmetry makes safe — `__mf_stat_field` reads as yielding
// though it never suspends — and that costs nothing on top of what the block below measures: the fallback
// answers "yields" for the same three anyway.
//
// ⛔⛔ **THIS ROSTER IS BELT-AND-BRACES: `calleeYields`'s UNKNOWN-CALLEE FALLBACK ALREADY ANSWERS `true` FOR
// EVERY NAME ON IT, AND TWO FILES USED TO EXPLAIN THE SOCKET BAND'S BEHAVIOUR BY ITS MEMBERSHIP HERE.**
// `checkAsyncYielding` walks the **Maxon**-tier module, so `funcIndexByName` holds the functions this program
// DECLARES. `__gt_sleep`, `__gt_resched`, `__gt_process_run` and the whole `__mf_*`/`__md_*`/`__ms_*` band are
// **Std**-tier runtime entry points, installed after lowering and declared in no source at all
// (`grep -rn "__mf_\|__ms_" stdlib/` is EMPTY — the parser emits calls to these names directly). None of them
// is ever in `funcIndexByName`, so `calleeYields`'s `otherwise return true` is what actually decides them.
//
// ⇒ **SABOTAGE-MEASURED 2026-08-21**, this predicate replaced by `false` for every listed name and rebuilt:
// `async` over a `File.exists` function still compiles, `async` over a `sleep()` function still compiles, and
// the CONTROL — `async` over a pure function — still answers E3073. The roster changes no program's verdict.
//
// ⇒ Which is why the socket band's ABSENCE costs nothing: `async` over a function whose only I/O is a socket
// IS accepted (measured: `async-tcp.connect-error` compiles and returns 99), by the fallback rather than by
// this list. `isManagedSocketRuntimeCallee` is deliberately not added — it would change no answer, and
// widening what E3073 accepts is a decision about that diagnostic rather than about the park.
//
// ⚠ The names stay because they are the SEEDS the walk is DESIGNED around: they say which callees suspend, so
// the day a runtime entry point becomes locally declarable — or the fallback is tightened to refuse unknowns —
// the roster is the fact that was already written down. What may not be said again is that a program's verdict
// depends on it today.
function ioYieldingRuntimeCallee(callee ByteArray) returns bool
	return callee.equals(GtSleepName) or callee.equals(GtReschedName) or callee.equals(GtProcessRunName) or callee.equals(GtAwaitAnyName) or isManagedFileRuntimeCallee(callee) or isManagedDirectoryRuntimeCallee(callee)
end 'ioYieldingRuntimeCallee'

// The plain caller-calls-callee relation, stored so that a CSR over it lists, for each CALLEE, the functions
// that CALL it — the reversed adjacency `reverseReachabilityMark` walks to push a mark from a callee up to
// everyone who calls it.
//
// ⛔⛔ **IT IS NOT `CallParamEdges`, AND THE DIFFERENCE IS NOT THE TWO COLUMNS IT LACKS.** That record's
// `byCallee` builds a CSR whose neighbours are EDGE ROW NUMBERS — the indirection that lets its consumer read
// the two parameter positions off the other columns of the same row — so walking it as though a neighbour
// were a function index marks whatever function happens to share a number with a row. This summary was
// written that way first, and it read GREEN on its own acceptance case for the only reason a wrong answer
// ever reads green: nothing propagated at all, because the single callee in that program was not a seed.
// These neighbours ARE the callers.
// ⚠ **`module` SINCE SV2**, whose acyclic blocking graph is a third whole-program summary over the same
// relation — see `ServiceCallCycleCheck`, which builds its own edges from its own seed walk exactly as the
// two summaries here do, and closes them through `markSeededCallers` rather than re-deriving the closure.
module type CallGraphEdges
	export var calleeIndices as CsrColumn
	export var callerIndices as CsrColumn

	export static function create() returns CallGraphEdges
		return Self{calleeIndices: CsrColumn.create(), callerIndices: CsrColumn.create()}
	end 'create'

	// Pushed together and only here, so the two columns stay the same length by construction. The CSR is built
	// by the one caller straight off the two columns — `buildCsr(calleeIndices, to: callerIndices)` — rather
	// than through a method of this type: a one-line delegation would add a name without adding a fact, and
	// the column ORDER is the fact worth reading at the call site.
	export function record(calleeIndex FuncIndex, callerIndex FuncIndex)
		self.calleeIndices.push(calleeIndex)
		self.callerIndices.push(callerIndex)
	end 'record'
end 'CallGraphEdges'

// The SEED: does this function's OWN body show an effect, before the call graph is closed? The same walk
// records the caller-callee edges, so the graph and the seeds come out of ONE pass over the ops.
//
// ⚠ **THE THREE GUARDS BELOW RETURN WITHOUT RECORDING THIS FUNCTION'S EDGES, AND THAT IS SOUND** — an edge
// (callee, this) exists only to carry a CALLEE's mark up into this function, and this function is already
// marked. Its own mark reaches its callers through the edges THEY record. The op loop returns early for the
// same reason.
function functionShowsAnEffect(module MaxonModule, func IrFunction, funcIndexByName FuncIndexByName, callerIndex FuncIndex, edges CallGraphEdges) returns bool
	// A function with NO body is a declaration this module cannot read — a restored intrinsic, an extern.
	// Nothing about it is provable.
	if func.blockRefs.count() == 0 'noBodyToProveAnythingAbout'
		return true
	end 'noBodyToProveAnythingAbout'

	// A function that returns nothing exists for its effects, whether or not this walk can find one.
	if functionReturnsNothing(func) 'voidExistsForItsEffects'
		return true
	end 'voidExistsForItsEffects'

	// ⭐⭐ **IT ASSIGNS INTO AN AGGREGATE THAT ALREADY EXISTED — THIS RULE'S OWN COLUMN, and reading E3070's
	// instead was a measured false rejection.** See `IrFunction.assignsIntoAnExistingAggregate`: the two
	// parameter masks below are narrowed to ARRAY-instance fields by their own doors, so `self.n = self.n + 1`
	// on an int field set neither and a method doing exactly that was classified effect-free.
	if func.assignsIntoAnExistingAggregate 'writesAnAggregateItWasHanded'
		return true
	end 'writesAnAggregateItWasHanded'

	// It writes what it was handed — the parser's own two masks, the seeds `ParamMutationSummary` closes over.
	// Read UNCLOSED here on purpose: the transitive half arrives through the very same call edges this walk
	// records, so closing it twice would be one fact propagated by two fixpoints. They are kept BESIDE the
	// column above rather than replaced by it: each catches writes the other does not (a `String`/`Set`
	// receiver write is in E3019's mask and is no field assignment at all).
	if func.writtenParamMask != NoParamPositions or func.storageWrittenParamMask != NoParamPositions 'writesItsArguments'
		return true
	end 'writesItsArguments'

	for blockRef in func.blockRefs 'eachBlock'
		let block = try module.blocks.get(blockRef) otherwise panic("functionShowsAnEffect: blockRef from func.blockRefs not in module.blocks")
		for opIdx in block.opRefs 'eachOp'
			if opShowsAnEffect(try module.ops.get(opIdx) otherwise panic("functionShowsAnEffect: opIdx {opIdx} not in module.ops"), funcIndexByName: funcIndexByName, callerIndex: callerIndex, edges: edges) 'effectful'
				return true
			end 'effectful'
		end 'eachOp'
	end 'eachBlock'
	return false
end 'functionShowsAnEffect'

// Does this function promise a value at all? A `void` return is the language's way of saying the call is
// worth making for something other than what it hands back.
function functionReturnsNothing(func IrFunction) returns bool
	return match func.maxonReturnType 'rt'
		void gives true
		value gives false
	end 'rt'
end 'functionReturnsNothing'

// The per-op arm. It answers "does THIS op show an effect", and for a direct call it also records the edge
// the closure will carry the callee's answer back along. The non-call bands range to `break`, so a newly
// appended op fails to compile here rather than silently reading as effect-free — the band-append invariant,
// and here it is load-bearing in the refusing direction (see `buildEffectFreeSummary`'s safety argument).
function opShowsAnEffect(op MaxonOp, funcIndexByName FuncIndexByName, callerIndex FuncIndex, edges CallGraphEdges) returns bool
	return match op 'op'
		call(_, callee, _, _, _, _, _, _) gives calleeShowsAnEffect(callee, funcIndexByName: funcIndexByName, callerIndex: callerIndex, edges: edges)
		literal to branch gives false
		// ⭐ **MODULE STORAGE, READ *OR* WRITTEN.** `globalAddr` is the one door to a global (`emitGlobalAddr`),
		// so this covers both directions — and both are effects for this rule's purpose: a write is the
		// spec's "modifies global state", and a READ of a `var` global makes the result depend on when the
		// call happened, which is exactly what "the result is all this call is for" denies.
		globalAddr gives true
		// ⛔ **A STORE THROUGH A POINTER IS NOT DECIDED HERE, AND THIS ARM ONCE CLAIMED IT WAS.** It read "a
		// store into a heap box the function itself built is not observable outside it", deferring the rest to
		// the `globalAddr` arm — and neither half held: `self.n = 5` and `p.n = 5` both lower to a
		// `storeIndirect` through a box the function was HANDED, which `globalAddr` never sees. Telling "a box
		// this frame allocated" from "a box it was handed" needs provenance this op does not carry, so the OP
		// cannot answer it.
		//
		// It stays `false` because the question is answered EARLIER, on the function rather than on the op:
		// the assignment emitters set `assignsIntoAnExistingAggregate` and the seed above reads it, which is
		// exactly the provenance this op lacks — a store the parser knows to be a field ASSIGNMENT rather than
		// the filling of a fresh box. A `storeIndirect` reaching here has already been counted if it was one.
		loadIndirect to stringLiteral gives false
		tryCall(_, _, callee, _, _, _, _, _, _) gives calleeShowsAnEffect(callee, funcIndexByName: funcIndexByName, callerIndex: callerIndex, edges: edges)
		// Failing is an effect the RETURN type cannot express, so a function that can throw has a reason to be
		// called besides its value (`Parser`'s `_ = try …` note makes the same point from the other side).
		throwError to propagateError gives true
		panicAbort gives true
		// Taking a function's ADDRESS calls nothing.
		functionRef gives false
		// The target is chosen at run time or out of a witness table, so there is no callee to close over.
		indirectCall gives true
		// A spawn runs concurrently and an await orders this frame against another — neither is a value this
		// call merely computed.
		asyncCall to tryAwait gives true
		sizeofType to switch gives false
		witnessDispatch to witnessTryDispatch gives true
		panicAbortValue gives true
		errorFlagEncode gives false
		// Starting a service and delivering a message are both effects no return type expresses — a send has
		// no result at all, so its whole reason for existing is the effect.
		serviceSpawn to serviceReplyCell gives true
	end 'op'
end 'opShowsAnEffect'

// One call, judged by its callee. A `__mm_*` heap entry point says nothing (see `buildEffectFreeSummary`);
// any other callee this module does not declare is an effect; a declared one contributes an EDGE and lets
// the closure decide.
function calleeShowsAnEffect(callee ByteArray, funcIndexByName FuncIndexByName, callerIndex FuncIndex, edges CallGraphEdges) returns bool
	if isRuntimeCallee(callee) 'heapBookkeeping'
		return false
	end 'heapBookkeeping'

	let calleeIndex = try funcIndexByName.get(callee) otherwise return true
	edges.record(calleeIndex, callerIndex: callerIndex)
	return false
end 'calleeShowsAnEffect'

// Where the door was, as the diagnostic says it — ONE arm per `FunctionTypeDoor`, and a new door cannot be
// declared without being given its sentence here. The shapes the arms fall into, rather than a list of them:
// an ASSIGNMENT names its place with a place word (`assigning to variable 'g'`), and those arms differ in
// nothing else, which is why one range arm covers them and `functionTypeDoorNoun` supplies the word. Every
// other door words itself, because each names something that is not a place: a cast and a `return` ARE the
// construct and name nothing (their `placeName` is empty), a payload and an enum case name their own
// DECLARATION, and a container column names neither.
function functionTypeDoorSite(door PendingFunctionTypeDoor) returns String
	return match door.door 'd'
		cast gives "in cast"
		returned gives "in return"
		payload gives "storing into union payload '{String.from(door.placeName)}'"
		enumCaseBacking gives "backing enum case '{String.from(door.placeName)}'"
		// ⚠ It names the ELEMENT and not the literal, because the literal is not what is wrong: the element
		// disagrees with the one the container's instance was fixed to. (An earlier wording said "in a
		// container literal" while the door was also recorded from `m.upsert(…)` — a sentence about syntax,
		// on a method call. That second site turned out to be redundant and is gone; the noun stayed.)
		containerElement gives "in a container element"
		variable to field gives "assigning to {functionTypeDoorNoun(door.door)} '{String.from(door.placeName)}'"
	end 'd'
end 'functionTypeDoorSite'

// ⭐ **THE E3104 ROSTER AND THE CAPABILITY TABLE BOTH LIVE IN `Compiler/TargetFacilities.maxon`.**
// This file used to hold `calleeNeedsWin32Substrate` — a callee test whose answer was the WHOLE verdict,
// because there was only ever one target that could provide anything. That shape could not express a
// LANDED family: the moment arm64-macOS grew a file surface, "does this callee need the substrate" stopped
// being the question and "does THIS TARGET provide what this callee needs" became it. The roster (which
// facility each callee needs, and why each family is on it) and the table (which targets provide it) are
// two facts and now have two functions — `calleeHostFacility` and `targetProvidesFacility` — with the
// per-family membership arguments carried beside the roster where they belong.

// The SUBJECT of an E3104 raised against a COMPILER-OWNED runtime entry. The user wrote
// `__Builtins.currentTimeMs()`, never `__gt_now_ns`, so there is no name of theirs to quote back at them —
// the entry is named later in the same sentence, which is where it belongs. A stdlib function is the
// opposite case and IS quoted: its name is exactly what the user wrote.
let TargetUnsupportedUnnamedSubject = "it"

// ⭐ **REFUSE A CONSTRUCT THE CHOSEN TARGET CANNOT LOWER (E3104), AT THE CALL'S OWN SPAN — OR, FOR A
// SUBPROCESS CROSSING ON A TARGET WITH NO PROCESS-SPAWN PRIMITIVE, E3074 (see the second arm below).**
//
// The x64-windows-only ops behind these entries — `osReadClock`, `osReadWallClock`, `osSleepMs` — are ones
// `StdToArm64`/`StdToWasm` deliberately refuse rather than fake. TWO kinds of callee reach them, and this is
// the one gate both go through:
//
//   • a COMPILER-OWNED runtime entry the parser emitted (`__Builtins.sleep(1)` → `__gt_sleep`). Each
//     builtin lowers to ONE entry, so the callee name is the whole test.
//   • a STDLIB function whose body reaches one, directly or through other stdlib functions
//     (`Clock.elapsedMs` → `Clock.nowMs` → `__gt_now_ns`, and `sleep` → `__gt_sleep`).
//     `stdlibSubstrateEntries` computed which, and which entry each reaches; this is where that fact
//     becomes a refusal.
//
// ⚠ **THE SECOND KIND IS BLAMED AT THE CROSSING, WHICH IS THE POINT.** Stdlib source is compiled as part of
// the program, so refusing it inside its own body positions the error at an absolute
// `…/stdlib/Clock.maxon:19:10` — a file the user never opened, at a line they cannot change, for a choice
// they made at a call site somewhere else. `checkCalls` therefore silences the gate inside STDLIB source
// (`blameTargetErrorsHere`) and it fires instead at the first call from USER code into stdlib. A user's own
// helper is user code, so `main → myHelper → Clock.nowMs` is blamed inside `myHelper`, at code they can act
// on. This gets MORE important as stdlib grows: a program built on `Map` and `String` crosses into stdlib on
// nearly every line, and every leaf down there ends in an intrinsic.
//
// ⚠ It replaces a PANIC, not a diagnostic: before it, such a program crashed the compiler three tiers down
// (`StdToWasm.maxon: 'osReadClock' is x64-windows only`) with no file and no line. Those panics stay as
// BACKSTOPS for a compiler bug that gets one past this gate; they are no longer the user-facing rejection.
//
// ⚠ **IT IS REACHABILITY-BLIND FOR USER CODE, AND REACHABILITY-AWARE FOR STDLIB SOURCE** — an asymmetry
// worth stating because retiring a bare-name builtin turns one into the other. An `__Builtins.sleep(1)`
// inside a function `main` never calls is still refused for wasm (measured), for the same reason a type
// error in an unreached function is: this pass visits every function, and dead-function elimination runs two
// tiers later. STDLIB source is the ONE exemption, because a stdlib module the program does not use must
// leave the compile byte-identical: an unreachable stdlib function is in `stdlibFacts.unreachable`, so it
// has no `substrateEntries` entry and no crossing to it can be refused. Clock shows both halves: a
// `Clock.nowMs()` in code `main` never calls compiles clean for wasm while a reached one is refused.
//
// ⭐ **THE BARE-NAME `sleep` BUILTIN WAS RETIRED THAT WAY, AND MOVED A PROGRAM ACROSS THE ASYMMETRY** — the
// decision this note was written to force, taken rather than discovered. `sleep(1)` used to BE a
// `__gt_sleep` in user code, so an unreached one was refused; it is now a call into `stdlib/Sleep.maxon`,
// so an unreached one COMPILES (`async-sleep.unreached-compiles-on-wasm`, against
// `builtins-sleep.rejected-on-wasm-when-unreached`, which keeps the property at the intrinsic spelling that
// still has it). That is the correct direction: the entry genuinely is stdlib's, and a program with no path
// to it does not contain it. Every builtin retired this way moves the same way.
// `callee` is the KEY (the registry is keyed by the EMITTED name) and `noun` is what the message QUOTES —
// the two part company for a primitive-static mint, and the caller has already resolved which is which
// (`callDiagnosticNoun`). They are the same bytes for every other callee, at no cost.
function requireTargetSupportsCallee(project Project, func IrFunction, opIndex OpIndex, callee ByteArray, noun ByteArray, blameTargetErrorsHere bool)
	// ⚠ `blameTargetErrorsHere` already carries BOTH preconditions — the target can refuse something, and
	// this function is where such a refusal belongs — because both are constant per function and this runs
	// at every call op of the program. Do not re-ask the target here: that would be one fact tested in two
	// places, and the cheap one is the one the caller already settled.
	if not blameTargetErrorsHere 'nothingRefusableHere'
		return
	end 'nothingRefusableHere'

	// ⭐ **THE TWO QUESTIONS, ASKED IN ORDER: what does this callee NEED, and does this target PROVIDE it?**
	// They were one bool until arm64-macOS landed a file surface, at which point a single answer could no
	// longer be right for two families on one target — see `Compiler/TargetFacilities.maxon`.
	if calleeNeedsFacilityTargetLacks(project.target, callee: callee) 'compilerOwnedEntry'
		reportTargetUnsupportedCallee(project, func: func, opIndex: opIndex, subject: TargetUnsupportedUnnamedSubject, entry: callee)
		return
	end 'compilerOwnedEntry'

	if let entry = try project.stdlibFacts.substrateEntries.get(callee) 'stdlibCrossing'
		// ⭐⭐ **THE CROSSING ASKS THE FACILITY TABLE TOO, AND BEFORE ANYTHING ELSE — WITHOUT THIS, A LANDED
		// FAMILY IS STILL REFUSED THROUGH STDLIB.** The fixpoint is target-blind by design
		// (`StdlibSource.noteSubstrateCallee`), so `substrateEntries` holds an entry for every stdlib body
		// that reaches ANY host facility, on every target. While x64-windows was the only provider, "this
		// map has an entry" and "this target cannot serve it" were the same sentence and the test was
		// omitted; they part company the moment a second lane lands a family, and a `File.readText` on
		// arm64-macOS would be refused at the crossing with the direct `__mf_open_read` call already legal
		// four lines up.
		if not calleeNeedsFacilityTargetLacks(project.target, callee: entry) 'targetProvidesIt'
			return
		end 'targetProvidesIt'

		// ⭐⭐ **E3074 TAKES THE CROSSING AHEAD OF E3104 WHEN THE TARGET CAN NEVER HOST A CHILD PROCESS.**
		// The two codes are two DIFFERENT facts about one call and both have to survive: E3104 says the
		// substrate is x64-windows only AT THIS RUNG — true of arm64 and linux, where a child process
		// exists and shv2 has simply not lowered it yet — while E3074 says subprocess can NEVER exist
		// here, which is a permanent property of WASI rather than of this compiler's progress, and so
		// carries advice (`#if not os(Wasi)`) instead of a runtime entry name.
		//
		// ⚠ **IT IS THIS ARM AND NOT THE `compilerOwnedEntry` ONE ABOVE, WHICH IS THE SPEC'S OWN BOUND**:
		// `specs/subprocess-unsupported.md` scopes the check to *"user call sites into the public
		// subprocess API (`Subprocess.run`, `Configuration.run`, `StreamingSubprocess.spawn`, etc.)"*, and
		// a crossing into stdlib is exactly what those are. A bare `__Builtins.subprocessSpawn` — or
		// `__Builtins.runProcess`, or the seven `subp*` builtins — is the INTRINSIC FLOOR rather than the API, it
		// reaches the arm above, and it keeps answering E3104 with the entry named
		// (`subprocess-builtins.rejected-on-wasm`, `async-subprocess.error.rejected-on-wasm`).
		//
		// ⚠ **THE RULE IS ABOUT THE API AND THE TEST IS ABOUT AN ENTRY BAND, AND THOSE ARE NOT THE SAME SET —
		// SAID HERE, where the rule is, rather than left to be discovered at the predicate.**
		// `isSubprocessRuntimeCallee` is the `__gt_subp_` prefix, and `__Builtins.runProcess`/`spawnReadLine` are
		// subprocess surfaces whose entries live in the SCHEDULER band instead
		// (`calleeNeedsWin32Substrate` names them individually for the same reason). Today no stdlib function
		// wraps either, so the two sets agree on every crossing that exists; one that did would be a stdlib
		// crossing answering E3104. That is the direction this fails in — a WEAKER, still-true diagnostic
		// rather than a missing one — and the day a stdlib module wraps `__Builtins.runProcess`, this test becomes
		// `is this entry a process spawn?` rather than `is it in the subprocess band?`.
		//
		// ⚠ **THE MESSAGE CARRIES NO SPAN, AND THAT IS THE PINNED WIRE FORMAT RATHER THAN AN OVERSIGHT.**
		// `specs/subprocess-unsupported.md`'s `maxoncstderr` block is the language definition for this
		// diagnostic and holds one bare line, so it renders through the `line == 0` arm of
		// `Diagnostic.render` — the arm E3001/E3002 use. The CHECK still fires per user call site, which
		// is what the spec's sentence above requires; only the rendering has no anchor to print.
		if isSubprocessRuntimeCallee(entry) and not targetCanHostSubprocess(project.target) 'noProcessSpawnPrimitive'
			reportDiagnostic(project, diagnostic: Diagnostic.create(ErrorCode.semanticSubprocessUnsupportedTarget, message: "Subprocess is not supported on {targetToString(project.target)} (no process-spawn primitive); guard the call with #if not os(Wasi)."))
			return
		end 'noProcessSpawnPrimitive'

		reportTargetUnsupportedCallee(project, func: func, opIndex: opIndex, subject: "'{String.from(noun)}'", entry: entry)
	end 'stdlibCrossing'
end 'requireTargetSupportsCallee'

// ⭐⭐ **THE TARGET GATE FOR A CONSTRUCT WHOSE RUNTIME ENTRY IS MINTED AT LOWERING (SV1 review)** —
// `requireTargetSupportsCallee`'s twin for the ops that carry no callee name. The split is exactly the one
// fact each door holds and the other cannot: that one is handed a NAME and must decide whether the name
// needs the substrate; this one is handed an OP whose entry is already known, and only the TARGET is in
// question. Both end at `reportTargetUnsupportedCallee`, which is the one wire format.
//
// ⚠ `blameTargetErrorsHere` carries both preconditions for `requireTargetSupportsCallee`'s stated reason —
// it is constant per function and the caller has already settled it — so the target is not re-asked here.
function requireTargetSupportsServiceEntry(project Project, func IrFunction, opIndex OpIndex, subject String, entry ByteArray, blameTargetErrorsHere bool)
	if not blameTargetErrorsHere 'nothingRefusableHere'
		return
	end 'nothingRefusableHere'

	// ⭐⭐ **IT ASKS THE FACILITY TABLE NOW, AND IT USED TO REFUSE BLIND.** This door reported on EVERY target
	// it was allowed to blame, without consulting `targetProvidesFacility` at all — which is precisely the
	// target-blind shape `TargetFacilities` replaced everywhere else (see its header on
	// `calleeNeedsWin32Substrate`). It read correctly only while x64-windows was the one lane providing
	// anything.
	//
	// ⭐ **`greenThreads` IS THE RIGHT QUESTION, AND IT IS THE WHOLE QUESTION.** A service is a green thread
	// with a mailbox: `MailboxRuntime` and `ServiceLoop` reach **no `StdOp.os*` op whatsoever** — every OS
	// fact they touch arrives through the scheduler beneath them. So "can this target host a service?" IS
	// "does it have the green-thread floor?", asked of the one table that knows, rather than restated here.
	// ⚠ MEASURED: `specs-shv2/services.md`'s own arm64 refusal case recorded the reason as
	// `lowerTlsAlloc: TlsAlloc is x64-windows only` — a scheduler primitive, not a service one — and it is
	// exactly what the arm64-macOS green-thread floor supplied.
	if targetProvidesFacility(project.target, facility: HostFacility.greenThreads) 'theSubstrateIsHere'
		return
	end 'theSubstrateIsHere'

	reportTargetUnsupportedCallee(project, func: func, opIndex: opIndex, subject: subject, entry: entry)
end 'requireTargetSupportsServiceEntry'

// The one wire format of E3104, so the two subjects cannot drift into two spellings of one rejection. The
// span is materialized HERE rather than at the gate because `SourceRangeTable.get` builds a heap
// `SourceRange` and this is the cold path — the gate itself runs over every call op of every function.
function reportTargetUnsupportedCallee(project Project, func IrFunction, opIndex OpIndex, subject String, entry ByteArray)
	let callRange = project.opRanges.get(opIndex)
	reportPositioned(project, code: ErrorCode.targetUnsupportedConstruct, message: "this construct is x64-windows only at this rung: {subject} lowers to the runtime entry '{String.from(entry)}', which has no {targetToString(project.target)} implementation", line: callRange.line, column: callRange.column, filePath: func.sourceFilePath)
end 'reportTargetUnsupportedCallee'

// ⚠ **`targetHasWin32Substrate` STOOD HERE AND IS GONE.** It answered *"is this x64-windows?"* under a
// capability's name, which was true only while x64-windows was the one target that provided anything.
// `TargetFacilities.targetProvidesEveryFacility` is its replacement and asks the same question HONESTLY —
// by walking the facility table rather than by naming a CPU and an OS — so the day a second lane completes
// that table it becomes true by measurement instead of by someone remembering to widen a hard-coded pair.
//
// ⚠ Its own note is worth keeping: it was NOT EXPORTED, and it once was — the SPEC HARNESS paired it with
// the callee roster to predict whether a case could run on a given target at all. That prediction is gone
// (PLAN row `X2`): a callee-name pair can only answer for the callees it names, so it could neither see a
// case reaching a substrate nobody thought to list nor express a PARTIAL landing. The harness now reads the
// compiler's E3104 verdict itself, which is the table's own consequence rather than a second copy of it —
// and a partial landing is exactly what arm64-macOS now is.

// ⭐⭐ **WHICH OF TWO SUBSTRATE ENTRIES A STDLIB BODY REACHES IS THE ONE ITS CROSSING IS REPORTED FOR — AND
// SINCE E3074 THAT IS A SEMANTIC CHOICE, NOT A TIE-BREAK.**
//
// `StdlibSource.SubstrateFixpoint` records ONE entry per stdlib function, and its `seed` used to say that the
// first a body names wins because *"a body naming two is refused for either, and both are equally true of
// it"*. That was true while every entry produced the same E3104 differing only in the name it quoted. It
// stopped being true the moment `requireTargetSupportsCallee` began reading the entry to CHOOSE THE
// DIAGNOSTIC: a subprocess entry on WASI answers E3074 (*subprocess can NEVER exist here*, with a `#if`
// to write) and every other answers E3104 (*x64-windows only AT THIS RUNG*). Those are different claims with
// different advice, so a body reaching both must not have its code decided by which seed the worklist
// drained first.
//
// ⚠ **NO STDLIB BODY IN THE CORPUS REACHES BOTH BANDS TODAY, so the old rule was stable BY ACCIDENT OF THE
// CORPUS rather than by construction** — which is exactly the kind of accident this project keeps paying for.
// The rank is stated here, beside the arm that reads the entry, so the choice and its reason are one fact.
//
// The permanent claim outranks the provisional one: E3074 is a fact about WASI that no rung can change, while
// E3104 is a statement about this compiler's progress. Telling a user "not at this rung" about a call that can
// never work anywhere is the strictly worse of the two answers.
export function substrateEntryOutranks(candidate ByteArray, incumbent ByteArray) returns bool
	return isSubprocessRuntimeCallee(candidate) and not isSubprocessRuntimeCallee(incumbent)
end 'substrateEntryOutranks'

// ⭐ **CAN THIS TARGET HOST A CHILD PROCESS AT ALL?** A DIFFERENT question from the one above, and the
// difference is what keeps E3074 and E3104 apart. `targetHasWin32Substrate` asks what shv2 has BUILT;
// this asks what the platform CAN EVER OFFER. Windows, Linux and macOS all spawn children — shv2 lowers
// the substrate on x64-windows alone, which is E3104's business and not this predicate's — while WASI
// has no process-spawn primitive in the standard at all, so no rung can add one.
//
// Written as a `match` over the OS rather than as `!= wasi`, so an OS added later must be CLASSIFIED
// here instead of silently inheriting an answer nobody chose for it.
function targetCanHostSubprocess(target Target) returns bool
	return match target.os 'os'
		windows gives true
		linux gives true
		macos gives true
		wasi gives false
	end 'os'
end 'targetCanHostSubprocess'

// The whole-program signature index, for a check running inside `semanticCheck`. Written once because
// three checks ask, and the REASON it cannot fail is one fact about the driver, not three: the index is
// computed and memoized by `compileToCodeResult` before the pipeline runs (`queryProgramSignatures`), so a
// pass downstream of it can only ever take the memo's hit. `asker` names the caller in the panic, which is
// the only part that legitimately differs.

// **The one type rule that cannot live in the parser.** An argument must agree with the
// parameter it fills, and the callee may be declared in another FILE — so the question needs
// the whole-program `funcSignatures` registry, which only this pass has. It asks the SAME
// `typesAgree` every operator asks (TypeRules.maxon); what it brings is the second half of the
// question, from two places the parser could not put together:
//
//   • the ARGUMENT's type — off the calling function's published per-value type column
//     (`IrFunction.valueTags`, which the parser built and handed over);
//   • the PARAMETER's type — off the callee's signature, RESOLVED (`resolveTypes` runs first
//     and has already collapsed every `named` alias in it to its primitive).
//
// `argIds` arrives in DECLARATION order (`slotCallArgs` applied the `name:` label reordering),
// so `argIds[i]` is the value filling parameter `i` and pairs directly with `sig.paramTypes[i]`
// — the reordering is done ONCE, by the one function that owns it, and neither this check nor
// `lowerCall` re-derives it.
//
// The diagnostic anchors on the CALL SITE, not on the argument, and that is the reference
// compiler's anchor: specs/implicit-type-conversion.md's `no-bool-to-int` expects column 9 of
// `\treturn takeInt(b)` — the `takeInt` token, not the `b`. It names the PARAMETER rather than
// the callee, which is also the reference's text — the parameter is what the argument failed to
// match, and the call site already says which function it belongs to.
// A cleanly-slotted call: check per-argument TYPES, then refuse any CAPTURING closure passed to a parameter
// the callee PERSISTS (P1.5-A2b-2), then refuse any IMMUTABLE BINDING passed to a parameter the callee
// WRITES (E3019). The first three read `argIds` in declaration order, so each pairs `argIds[i]` with
// parameter `i` — the slotting is done once, by `slotCallArgs`, and none re-derives it.
function checkSlottedCall(project Project, func IrFunction, result ValueId, callee ByteArray, sig FuncSignature, args ValueIdArray, argLabels ByteArrayArray, argImmutableNames ByteArrayArray, argIds ValueIdArray, escapeSummary ParamEscapeSummary, mutationSummary ParamMutationSummary, callRange SourceRange, filePath FilePath)
	checkArgTypes(project, func: func, result: result, sig: sig, argIds: argIds, callRange: callRange, filePath: filePath)
	checkTypeParameterArgs(project, func: func, result: result, sig: sig, argIds: argIds, callRange: callRange, filePath: filePath)
	checkPerInstanceArgs(project, func: func, callee: callee, sig: sig, argIds: argIds, callRange: callRange, filePath: filePath)
	checkCapturingClosureEscape(project, func: func, callee: callee, argIds: argIds, escapeSummary: escapeSummary, callRange: callRange, filePath: filePath)
	checkImmutableArgToMutatingParam(project, func: func, callee: callee, sig: sig, args: args, argLabels: argLabels, argImmutableNames: argImmutableNames, mutationSummary: mutationSummary, callRange: callRange, filePath: filePath)
	checkResolvedExtensionConstraints(project, func: func, callee: callee, sig: sig, argIds: argIds, callRange: callRange, filePath: filePath)
end 'checkSlottedCall'

// ⭐⭐ **THE CONDITIONAL-EXTENSION REFUSAL ASKED OF THE RESOLVED OVERLOAD MEMBER (E4006).** The parse-time
// gate (`Parser.requireMethodNotWithheldByConstraint`) owns this question wherever the name has ONE reading,
// and it words it better — at the member token, before anything is built. It CANNOT own it where a
// `<Conformer>.<method>` is declared by a conditional extension AND by an unconditional one, because a call
// is dispatched before its arguments are read: there the parser defers
// (`ProgramSignatures.hasUnconstrainedExtensionDeclaration`) and this is the decider, on the member
// `resolveOverloadedCalls` actually chose.
//
// ⚠ **IT IS NOT A SECOND RULE.** The predicate is `receiverMeetsExtensionConstraints` and the sentence is
// `conditionalExtensionWithheldMessage`, both shared verbatim with the parse-time gate — what differs is only
// WHICH callee is asked about, which is the entire reason two askers exist.
//
// ⛔ **THE CLAUSE COMES OFF THE RESOLVED MEMBER'S OWN SIGNATURE, NOT OFF THE DECLARATION-SWEEP MAP (ARR3b).**
// That map is keyed by the DECLARED `<Conformer>.<method>`, and this asker holds the REGISTRATION name of the
// member overload resolution chose — which for a contested set is a suffixed name the map has never heard of,
// so this decider silently never fired for exactly the sets it was written for. `FuncSignature.extensionConstraints`
// is the same clause recorded under the name that was actually minted; see it for the ABI half of the defect.
//
// Allocation-free on every program that declares no conditional type extension: the field is the shared empty
// list for every other declaration.
function checkResolvedExtensionConstraints(project Project, func IrFunction, callee ByteArray, sig FuncSignature, argIds ValueIdArray, callRange SourceRange, filePath FilePath)
	let constraints = sig.extensionConstraints
	if constraints.isEmpty() 'notAConditionalTypeExtensionMethod'
		return
	end 'notAConditionalTypeExtensionMethod'

	if not sig.takesReceiver() or argIds.count() == 0 'noReceiverToJudge'
		return
	end 'noReceiverToJudge'

	let receiverId = try argIds.get(0) otherwise panic("checkResolvedExtensionConstraints: argIds.count() > 0 but get(0) failed")
	let receiverTag = try func.valueTags.get(receiverId) otherwise panic("checkResolvedExtensionConstraints: value v{receiverId} of '{String.from(func.name)}' has no recorded type — every SSA value is minted through Parser.mintValue")
	// An OPAQUE receiver (a generic body's own `self`, a value of its type parameter) forwards its witnesses
	// from the caller and is the parse-time gate's other arm, which the deferral above does not disturb: that
	// arm fires before the name is even looked at as an overload set.
	if receiverTag != ValueTypeTag.genericInstance 'notAConcreteInstance'
		return
	end 'notAConcreteInstance'

	let gid = try func.valueNameIds.get(receiverId) otherwise panic("checkResolvedExtensionConstraints: value v{receiverId} of '{String.from(func.name)}' has no recorded type name — the two type columns are minted in lockstep")
	// Asked only once every cheaper test has passed — the index is needed for the VERDICT and for the
	// sentence, and neither is reached by a call whose callee carries no clause.
	var signatures = programSignaturesIn(project, asker: "checkResolvedExtensionConstraints")
	match receiverMeetsExtensionConstraints(signatures, gid: gid, constraints: constraints) 'constraint'
		met then break 'constraint'
		unmet(interfaceName, argDisplayName) then reportConditionalExtensionWithheld(project, signatures: signatures, callee: callee, constraints: constraints, interfaceName: interfaceName, argDisplayName: argDisplayName, callRange: callRange, filePath: filePath)
	end 'constraint'
end 'checkResolvedExtensionConstraints'

// The refusal itself, split out so the arm above stays one line: the callee is a
// `<Conformer>.<member>` (the fold files constraints under no other shape), possibly wearing an overload
// suffix, and the message names the two halves separately.
function reportConditionalExtensionWithheld(project Project, signatures ProgramSignatures, callee ByteArray, constraints WhereConstraintArray, interfaceName ByteArray, argDisplayName ByteArray, callRange SourceRange, filePath FilePath)
	match splitQualifiedName(overloadRegistrationBaseName(callee)) 'q'
		parts(typeName, member) then reportPositioned(project, code: ErrorCode.invalidFieldAccess, message: conditionalExtensionWithheldMessage(String.from(typeName), methodName: String.from(member), clause: signatures.renderExtensionClause(typeName, constraints: constraints), unmetInterfaceName: String.from(interfaceName), bindingName: String.from(argDisplayName)), line: callRange.line, column: callRange.column, filePath: filePath)
		notQualified then panic("reportConditionalExtensionWithheld: '{String.from(callee)}' carries extension constraints but is not a qualified method name — `Parser.noteTypeExtensionWitnessConstraints` files them under `<Conformer>.<member>` only")
	end 'q'
end 'reportConditionalExtensionWithheld'

// ⭐⭐ **E3019, THE CALL-SITE HALF: AN IMMUTABLE BINDING MAY NOT FILL A PARAMETER THE CALLEE WRITES.**
// The receiver half — `let a = [1,2,3]` then `a.push(9)` — is the PARSER's (`Parser.noteReceiverWrite`),
// because the receiver and the method are the same expression. This half cannot be: whether `grow(a)` is
// legal depends on `grow`'s BODY, which may be in another file, so it needs the whole-program summary and
// the whole-program summary needs every file parsed.
//
// ⚠ **IT READS THE SOURCE-ORDER COLUMNS, NOT `argIds`, AND THAT IS FORCED.** The blame name is a fact about
// the argument the SOURCE wrote, so it lives in the source-order `argImmutableNames`, while the callee's
// mask is indexed by DECLARATION position — `grow(1, dest: a)` writes parameter 1 and the offending
// argument is source argument 1 only by coincidence. The two are bridged by `argSlotPosition`, the same
// mapping `slotCallArgs` used to produce the `argIds` the other checks read; inverting the permutation by
// hand would be the second slotting this rung exists to not have.
//
// ⚠ **AN INDIRECT CALL AND A WITNESS DISPATCH ARE NOT CHECKED, and that is measured agreement rather than
// an oversight.** Neither names a callee a summary could be keyed on. Refusing them conservatively would
// refuse `let a = …` handed to ANY function value — and BOTH reference compilers accept `let f = grow` then
// `f(a)` (measured: the oracle compiles it and the push takes effect), so a conservative refusal would
// break agreement on a legal program rather than close a hole. `parameter-mutation.md` pins the acceptance
// so the gap is visible instead of assumed.
// ⭐⭐ **AND SINCE W117 IT IS ALSO THE DOOR FOR A `let`-DECLARED GLOBAL'S RECORD, THROUGH THE SAME ONE
// REPORTER.** An argument that ALIASES an immutable global (the parser's per-value mark, published as
// `IrFunction.immutableGlobalAliasValues`) is judged against a WIDER mask than an ordinary immutable binding
// is: `maskOf` for both, plus `recordWriteMaskOf` for the alias.
//
// ⛔⛔ **THE WIDENING IS PER-ARGUMENT, NOT PER-CALL, AND THAT IS THE WHOLE OF WHY E3019 DOES NOT MOVE.**
// MEASURED on both compilers: `let a = Box.make()` handed to a `bump(b Box)` whose body is `b.n = 99`
// COMPILES and prints `n 99` — a direct field write through a parameter is legal for an immutable BINDING and
// widening `maskOf` would refuse a program the references accept. The same call is NOT legal when what was
// handed over is a `let` GLOBAL's record: measured before this rung, `let G = Box.make()` + `bump(G)` printed
// `g 99` on shv2 AND on the oracle, silently mutating a global the program declared immutable. Same shape,
// different subject, different answer — so the subject decides which mask applies, one argument at a time.
//
// ⚠ **ONE REPORTER, DELIBERATELY.** A second check reading the third column would be a second site deciding
// what "cannot be written through" means, free to drift from this one and to double-report the arguments they
// both catch. The sentence is unchanged and stays true of both subjects: it names no immutability, only what
// may not be passed where.
function checkImmutableArgToMutatingParam(project Project, func IrFunction, callee ByteArray, sig FuncSignature, args ValueIdArray, argLabels ByteArrayArray, argImmutableNames ByteArrayArray, mutationSummary ParamMutationSummary, callRange SourceRange, filePath FilePath)
	// ONE name resolution and one dense read — `maskOf` answers `NoParamPositions` for a callee the module
	// does not declare, so the overwhelming majority of calls leave here after a single hash and an i64
	// compare, with no membership probe in front of it.
	let mask = mutationSummary.maskOf(callee)
	// ⚡ The second read is taken only when this call could possibly need it: a function that marked no value
	// is every function in nearly every program, and the set is the parser's shared empty one there.
	let recordWriteMask = mutationSummary.recordWriteMaskOf(callee) if func.immutableGlobalAliasValues.count() > 0 else NoParamPositions
	if mask == NoParamPositions and recordWriteMask == NoParamPositions 'writesNoParameter'
		return
	end 'writesNoParameter'

	for i in 0 upto args.count() 'eachArg'
		let argId = try args.get(i) otherwise panic("checkImmutableArgToMutatingParam: args.get OOB at {i} below its own count")
		let aliasesAnImmutableGlobal = func.immutableGlobalAliasValues.contains(argId)
		let blamed = immutableArgNameAt(argImmutableNames, index: i)
		if blamed.isEmpty() and not aliasesAnImmutableGlobal 'writableArgument'
			continue
		end 'writableArgument'

		let pos = argSlotPosition(sig.paramNames, argIndex: i, label: try argLabels.get(i) otherwise panic("checkImmutableArgToMutatingParam: argLabels.get OOB at {i} — a call's argument columns are parallel by construction"))
		let effective = (mask or recordWriteMask) if aliasesAnImmutableGlobal else mask
		if pos >= sig.paramCount() or not maskHasParam(effective, param: pos) 'notAWrittenPosition'
			continue
		end 'notAWrittenPosition'

		let paramName = try sig.paramNames.get(pos) otherwise panic("checkImmutableArgToMutatingParam: paramNames.get OOB at {pos} inside paramCount()")
		// A tainted argument always reaches here with a blame — `Parser.expressionImmutableBlame` falls back to
		// the shared noun when the expression names no binding — EXCEPT on the synthesized call paths that pass
		// `NoImmutableArgNames` wholesale. Naming the noun here rather than skipping the report keeps the
		// diagnostic, and it is the SAME constant that fallback uses, so there is one wording and not two.
		let subject = blamed if not blamed.isEmpty() else ImmutableGlobalAliasBlame
		reportPositioned(project, code: ErrorCode.semanticImmutableRefToMutatingParam, message: immutableMutatingCallMessage(String.from(subject), paramName: displayParamName(paramName), functionName: String.from(func.name)), line: callRange.line, column: callRange.column, filePath: filePath)
		return
	end 'eachArg'
end 'checkImmutableArgToMutatingParam'

// ⭐⭐ **THE TYPE-PARAMETER ARGUMENT CHECK (P1.7, E3005) — WHAT A SHARED GENERIC BODY'S SIGNATURE CANNOT
// SAY.** `Box.create(v T)` is compiled ONCE against the opaque `T` (dictionary-passing, not
// monomorphization), so its published signature types `v` as `typeParameter(0)` — a type NOTHING agrees or
// disagrees with. Every call through a concrete instance therefore passed `checkArgTypes` whatever it was
// handed: a `Box with Other` where the instance binds `T = Box with Leaf`, but equally a `String`, a plain
// `int`, or an unrelated struct. The value is then stored into the box's `T` field and dropped by the
// instance's synthesized `__destruct_<instance>` under the type the instance DECLARED — a wild free, and
// the segfault this rung was opened on.
//
// The missing half is the concrete instance, and it is already on the values this pass reads:
//
//   • a static factory (`LeafBoxBox.create(…)`) — the parser retyped the call's RESULT to
//     `genericInstance(gid)` (`retypeGenericAliasConstructorResult`), which is the instance being built;
//   • an instance method (`b.replace(…)`) — the RECEIVER argument carries it, the same place
//     `checkPerInstanceArgs` reads its own instance from.
//
// Substituting through it turns `T` back into the concrete type argument, and the comparison is then the
// ONE shared rule over the SAME two halves `checkArgTypes` uses on a concrete parameter — the aggregate
// names (`namedAggregatesConflict`), so a nominal argument (a struct, a nested instance) is matched
// EXACTLY, and then the tags (`checkDeclaredType`), so a scalar / `String` / ranged-alias argument — which
// carries no name on either side — is coerced against the type the INSTANCE bound rather than against the
// opaque formal (`Box with Integer` still takes `42`, and now refuses `1.5`).
function checkTypeParameterArgs(project Project, func IrFunction, result ValueId, sig FuncSignature, argIds ValueIdArray, callRange SourceRange, filePath FilePath)
	if not sig.hasTypeParameterParam() 'noOpaqueParams'
		return
	end 'noOpaqueParams'

	// ⭐ The instance is read off a VALUE this pass already holds, so the answer costs no heap object. It
	// used to be a `CallGenericInstance` union — and a Maxon union value IS a heap box, minted once per call
	// into a shared generic body just to be matched and dropped (measured: 1 allocation / 16 bytes per such
	// call, on a path that becomes every array operation at P1.7 Array). A `ValueId` is a scalar.
	let subject = callInstanceSubject(sig, result: result, argIds: argIds)
	// ⚠ **PANIC, NOT `otherwise return`.** `subject` is an SSA value of THIS function — a call's `result`
	// (minted for every call, `void`-tagged when the callee returns nothing) or its first argument — so a
	// missing tag is the same broken invariant the two reads below name, and it must fail the same way.
	// Spelled as a silent `return` it would delete THIS ENTIRE CHECK for the call, restoring in silence the
	// wild free this rung exists to refuse; a green suite could never show it, because the check that
	// vanished is the one that reports.
	let tag = try func.valueTags.get(subject) otherwise panic("checkTypeParameterArgs: value v{subject} of function '{String.from(func.name)}' has no recorded type — every SSA value must be minted through Parser.mintValue")
	if tag != ValueTypeTag.genericInstance 'notAnInstance'
		return
	end 'notAnInstance'

	checkTypeParameterArgsAt(project, func: func, gid: try func.valueNameIds.get(subject) otherwise panic("checkTypeParameterArgs: genericInstance value v{subject} of function '{String.from(func.name)}' has no recorded GenericInstanceId — the two type columns are minted in lockstep"), sig: sig, argIds: argIds, callRange: callRange, filePath: filePath)
end 'checkTypeParameterArgs'

// The body of the type-parameter argument check once the call's concrete instance is known. Only the
// positions whose DECLARED type is a bare type parameter are substituted; every other position was already
// concrete in the shared signature and `checkArgTypes` has judged it.
//
// Each such position is judged by BOTH halves of the argument rule, against the SUBSTITUTED type — the
// nominal half (`aggregatesConflict`, which a tag can never see) and then the scalar half
// (`checkArgAgainstDeclaredTag`, which is the identical verdict and the identical four sentences
// `checkOneArgType` gives a concrete parameter). At most one is reported per call, as the nominal half
// alone always did.
function checkTypeParameterArgsAt(project Project, func IrFunction, gid GenericInstanceId, sig FuncSignature, argIds ValueIdArray, callRange SourceRange, filePath FilePath)
	// ⚠ `var`, because the index MEMOIZES a nested instance's compiled name on first ask — the same reason
	// `compileToCodeResult` binds it that way (see `mangleGenericInstance`).
	var signatures = programSignaturesIn(project, asker: "checkTypeParameterArgsAt")
	for i in 0 upto argIds.count() 'eachArg'
		let paramType = try sig.paramTypes.get(i) otherwise panic("checkTypeParameterArgsAt: paramTypes.get OOB at {i} — slotCallArgs returned {argIds.count()} slots for a {sig.paramCount()}-parameter signature")
		if maxonTypeTag(paramType) != ValueTypeTag.typeParameter 'concreteParam'
			continue
		end 'concreteParam'

		// The opaque formal's position in the base type's `uses` list — since W14 a `typeParameter`'s payload
		// is an IDENTITY rather than that position, so it is recovered through the one door that owns the
		// conversion (`opaqueTypeParamPosition`). The instance's argument list was arity-checked at
		// instantiation (E2056), so it indexes in range.
		let position = signatures.opaqueTypeParamPosition(paramType)
		// ⭐ **SUBSTITUTED AND RESOLVED ONCE, READ THREE TIMES.** A `MaxonType` is a heap box, and this type is
		// wanted for its nominal identity, for the (tag, nameId) pair the shared rule compares with, and — on
		// the scalar path below — for the declared tag. It used to be substituted separately for each, and the
		// alias resolution (`canonicalTypeArg`) lived inside the identity read alone, where the pair could not
		// see it: `Box with Bytes`'s argument then read `Array_Byte` as its identity while its tag stayed
		// `named`, and the byte boundary was asked about a name id that is not an instance id.
		// ⚠ `functionAliasResolved` and `floatAliasResolved` are the LAST steps and not the first:
		// canonicalization works on the interned leaf, and a function alias is only a `function` place — a
		// float alias only a `float` one — once nothing else is going to read either as a name. See those two
		// doors for the programs each refused unresolved; they are disjoint (a name is one kind of alias or
		// the other, never both), so their order between themselves says nothing.
		let substituted = signatures.floatAliasResolved(signatures.functionAliasResolved(signatures.canonicalTypeArg(signatures.substitutedInstanceArg(gid, position: position))))
		let expected = signatures.typeArgAggregateName(substituted, readerFilePath: filePath)
		let argId = try argIds.get(i) otherwise panic("checkTypeParameterArgsAt: argIds.get OOB at {i}")
		let argTag = try func.valueTags.get(argId) otherwise panic("checkTypeParameterArgsAt: value v{argId} of function '{String.from(func.name)}' has no recorded type — every SSA value must be minted through Parser.mintValue")
		let argNameId = try func.valueNameIds.get(argId) otherwise panic("checkTypeParameterArgsAt: value v{argId} of function '{String.from(func.name)}' has no recorded type name — the two type columns are minted in lockstep")
		let got = aggregateNameFor(project, tag: argTag, nameId: argNameId, readerFilePath: filePath)
		// Hoisted out of the failure branch because BOTH halves below want it now, and one unconditional read
		// is cheaper than threading it into two. It is a dense array read on a path that already does four,
		// and `checkArgTypes` fetches the same name unconditionally for every argument of every call.
		let paramName = try sig.paramNames.get(i) otherwise panic("checkTypeParameterArgsAt: paramNames.get OOB at {i}")
		// ⚠ **`aggregatesConflict`, NOT the bare rule — the SAME door every other coercion site uses.**
		// The wrapper adds the P1.6-C decay: a PER-INSTANCE alias (`WA.Idx`) meeting a target that is not one
		// carries no identity claim and decays. Spelled with the bare rule this arm read a decaying argument's
		// name as an aggregate meeting a SCALAR — `expected` is deliberately empty for a ranged-alias type
		// argument — and REJECTED a legal program: `takesPlain(t)` and `IntBox.create(t)` were the same value
		// into the same `Integer`, accepted at the parser and refused here. One comparison rule, one answer.
		// It also carries the byte-element boundary, and that is not theoretical here either: MEASURED on
		// `origin/main`, `MemBox.create(<a cwd buffer>)` at a `Box with Bytes` was refused
		// `expected 'Bytes', got 'Array___ManagedByte'` while the bootstrap compiled it.
		if signatures.aggregatesConflict(expected, expectedTag: maxonTypeTag(substituted), expectedNameId: typeNameIdOf(substituted), got: got, gotTag: argTag, gotNameId: argNameId) 'wrongTypeArgument'
			// The EXPECTED side names the concrete TYPE ARGUMENT, not the identity that was compared: the
			// two agree for an aggregate (`typeArgAggregateName`'s nominal arm IS this call), and where
			// they differ — a scalar / `String` / ranged-alias argument, whose identity is deliberately
			// empty — this is the only one that can say `String` rather than `type parameter`. It is asked
			// on the FAILURE path alone, so the rendering costs a rejected program and nothing else.
			//
			// ⚠ It asks the DISPLAY renderer, so the two halves of this one sentence are spelled the same
			// way (user ruling, 2026-08-04). The compiled twin read `expected 'Box_Leaf', got 'OtherBox'`
			// on a program that declares `typealias LeafBox = Box with Leaf` — the `got` side quoting the
			// author and the `expected` side quoting the mangler.
			reportPositioned(project, code: ErrorCode.typeMismatch, message: argTypeMismatchMessage(paramName, position: i, expected: String.from(signatures.instanceArgDisplayName(gid, position: position)), got: valueTypeDisplayName(project, func: func, value: argId, tag: argTag, nameId: argNameId, readerFilePath: func.sourceFilePath)), line: callRange.line, column: callRange.column, filePath: filePath)
			return
		end 'wrongTypeArgument'

		// ⭐⭐ **THE SAME SUBSTITUTION, HANDED TO THE SCALAR RULE — AND THAT HALF WAS A COMPILER PANIC.** The
		// nominal check above is blind to everything that carries no name: `typeArgAggregateName` answers
		// `EmptySourceText` for a scalar, a `String` and a ranged alias, deliberately, so `Box with Integer`
		// keeps accepting a plain `42`. But a FLOAT carries no name either, so `IntBox.create(1.5)` and
		// `StrBox.create(1.5)` passed both walks — `checkOneArgType` asked `checkDeclaredType(float,
		// typeParameter)`, and a type parameter agrees with everything (`typeClassesAgree`) — and the
		// XMM-born float reached `X64Backend.emitRegRegMove` headed for a GPR parameter slot, where the
		// emitter PANICKED on a program whose only defect was an ordinary lossy conversion.
		//
		// ⚠⚠ **THE TWO HALVES PARTITION THE TYPE ARGUMENTS, AND THIS GATE IS THAT PARTITION — NOT A
		// SHORT-CIRCUIT.** `typeArgAggregateName` answers a NAME for exactly the arguments that carry a
		// nominal identity and `EmptySourceText` for exactly the ones that do not, and its own header states
		// that the second group "meets its argument by TAG (`checkDeclaredType`)". This is that sentence
		// enforced. The tag CANNOT stand in for the first group, because `substitutedInstanceArg` returns the
		// argument AS INTERNED — a user type spelled by name is a `named` LEAF, never `structRef`, and
		// `typeTagName(named)` is "int" — so handing it to the scalar rule refused a `Leaf` into a
		// `Box with Leaf` with "expected 'int', got 'struct'" (MEASURED: 51 legal tests in this suite). The
		// nominal half has already judged that group EXACTLY, by name, against the right interner; reaching
		// here at all means it found the two identities equal, and both empty.
		//
		// ⚠ **THE FIX IS THE SUBSTITUTION, NOT A NEW RULE, AND THAT IS THE RULING** (2026-07-28): a generic
		// call site substitutes its instance's type arguments BEFORE the actual-vs-formal check, so
		// `IntBox.create(1.5)` lands on the SAME E3009 the non-generic `takeInt(1.5)` gives and
		// `StrBox.create(1.5)` on the SAME E3005 as `takeStr(1.5)`. ONE RULE, BOTH PATHS — which is why not
		// one sentence of diagnostic text lives here. The rejected alternative was refusing a float actual at
		// an opaque formal outright: it decides from the FORMAL's shape rather than from the instance's real
		// type, and would answer wrongly the moment a float type argument becomes legal (E2062 is explicitly
		// temporary).
		//
		// ⚠ **IT CANNOT REACH A GENERIC BODY'S OWN `T`.** `checkTypeParameterArgs` only arrives here when the
		// call's subject is tagged `genericInstance` — a concrete instance — so a call made inside a generic
		// body on a `self` receiver (tagged with the base `structRef`) never substitutes and keeps the P1.6-A
		// deferral it must have: inside the body `T` is genuinely opaque and `tagIsIntegral(typeParameter)`
		// stays `false`.

		if not expected.isEmpty() 'nominalArgumentAlreadyMatched'
			continue
		end 'nominalArgumentAlreadyMatched'

		// ⭐⭐ **A `function` TYPE ARGUMENT FALLS BETWEEN THE TWO HALVES ABOVE, AND NOTHING ELSE CATCHES IT.**
		// It carries no nominal identity — `typeArgAggregateName` answers empty, which is right, because a
		// function type's identity IS its shape and not a name — so the nominal half cannot judge it; and the
		// tag half below compares `function` against `function` and agrees with every signature in the program.
		//
		// ⭐ **WHAT REACHES HERE IS ANY CALL WITH A REAL `FuncSignature` WHOSE PARAMETER IS A BARE `T`** — and
		// every route below was RUN before it was written down, because the first two attempts at this
		// paragraph were each partly wrong:
		//
		//   • a user generic's method — `Box with UnaryOp` accepting `OpBox.create(floatFn)`, the measured
		//     miscompile this arm closes (`.held()` then called a float function through an int convention);
		//   • `generic-type-parameter-slots`' `Holder with UnaryOp`, whose committed `function-value-element`
		//     case is what proves this line EXECUTES at all — verified by sabotage, not assumed;
		//   • `Map.upsert`/`insert`, whose corpus `Map` methods are ordinary signatured calls, **including the
		//     ones a `["k": v]` literal desugars to** (`Parser.emitMapLiteralUpsert`). So the map literal and
		//     the hand-written mutator are one route, and it is this one.
		//
		// ⚠ **THE ARRAY LITERAL IS NOT HERE, AND THAT IS WHY ITS OWN DOOR EXISTS.** `Array` is
		// parser-intrinsic: `[a, b]` builds through `__managed_create`/`__managed_push` runtime entries carrying no
		// signature, so nothing in this pass sees its elements. `Parser.requireArrayLiteralElementMatches`
		// records a `containerElement` door for exactly that gap — MEASURED both ways, by deleting each and
		// watching which programs went quiet. `Array.push` and `List.append` are a third route again (the
		// parser's `field` door), which is the asymmetry that hid all of this: one rule, covered on some
		// containers and not their siblings.
		if maxonTypeTag(substituted) == ValueTypeTag.function and argTag == ValueTypeTag.function 'functionTypeArgument'
			if checkFunctionArgShape(project, func: func, declaredShape: requireFunctionShapeOf(functionTypeRegistryOf(project), name: signatures.indexSpaceTypeName(substituted), side: "declared"), argId: argId, paramName: paramName, position: i, callRange: callRange, filePath: filePath) 'signatureMismatch'
				return
			end 'signatureMismatch'
			continue
		end 'functionTypeArgument'

		// The substituted type argument carries no pre-erasure AGGREGATE of either kind: it is the INSTANCE's own
		// argument type, read live out of the signature index rather than off a declaration this pass ever saw.
		//
		// ⭐ **IT DOES CARRY THE OTHER PRE-ERASURE COLUMN — THE `typealias` THE AUTHOR WROTE — AND PASSING IT
		// EMPTY WAS A WRONG NOUN.** `paramDisplayName`'s last arm falls back to the tag's class word, so a
		// refusal at a `Box with Integer` read `expected 'int'` where the concrete `takeInt`-shaped parameter
		// beside it reads `expected 'Integer'` off `sig.paramDeclaredNames` — one rule spelling its type two
		// ways by which door the value entered, and the runnable oracle says `Integer`. Found by ARR1 when
		// `insert` started arriving here (`arrays.error.insert-string-into-int-array`); it was equally wrong for
		// every other substituted scalar argument, ARRR's own `Box with Percent` included.
		if checkArgAgainstDeclaredTag(project, argTag: argTag, argNameId: argNameId, declaredType: substituted, declaredAggregate: EmptySourceText, declaredName: signatures.indexScalarAliasName(substituted), paramName: paramName, position: i, callRange: callRange, filePath: filePath) != DeclaredTypeMatch.ok 'refusedBySubstitutedType'
			return
		end 'refusedBySubstitutedType'
	end 'eachArg'
end 'checkTypeParameterArgsAt'

// ⭐ **WHICH VALUE CARRIES THE INSTANCE a call into a shared generic body is made at.** Two shapes carry
// it, and they are asked in the order that makes a METHOD's answer its receiver's: an instance method's
// receiver IS the instance, whereas its result may be an unrelated type (`get() returns T`), while a static
// factory has no receiver and its RESULT is the instance it built (`retypeGenericAliasConstructorResult`).
// Returns a `ValueId` rather than an instance-or-none union so the answer allocates nothing; the caller
// reads the tag to find out whether it is an instance at all.
function callInstanceSubject(sig FuncSignature, result ValueId, argIds ValueIdArray) returns ValueId
	if sig.takesReceiver() and argIds.count() > 0 'method'
		return try argIds.get(0) otherwise panic("callInstanceSubject: argIds.count() > 0 but get(0) failed")
	end 'method'
	return result
end 'callInstanceSubject'

// ⭐ **THE PER-INSTANCE ARGUMENT CHECK (P1.6-C, E3005).** A method whose parameter is a bare inner alias
// (`setTag(t Idx)`) wants that parameter QUALIFIED to the concrete receiver's instance (`WrapperB.setTag`
// wants `WrapperB.Idx`). The shared method signature cannot carry that identity — `WrapperA` and `WrapperB`
// share one gid and one `Wrapper.setTag` — so the check lives HERE, where the callee's inner-alias parameter
// members are known (the sweep's `methodInnerAliasParams`) AND the caller's per-value instance-alias
// provenance is delivered (`FunctionRangeChecks.valueInstanceAliases`, read off the RECEIVER argument). An
// argument WITH a per-instance identity of the WRONG instance is E3005; an argument with NONE (a literal, a
// field read, a plain integer) DECAYS and is accepted — which matches the oracle exactly. A factory call
// (no receiver) is left to decay: its inner-alias arguments in the corpus are literals.
function checkPerInstanceArgs(project Project, func IrFunction, callee ByteArray, sig FuncSignature, argIds ValueIdArray, callRange SourceRange, filePath FilePath)
	let signatures = programSignaturesIn(project, asker: "checkPerInstanceArgs")

	// Allocation-free short-circuit: when no method in the program declares an inner-alias parameter — every
	// generics-free program — the per-callee lookup below could not possibly find one, and it mints an
	// `InnerAliasParamLookup` union box on EVERY call. Gate it out, exactly as the parser gates
	// `innerAliasParamsIn` on `enclosingInnerAliases.count()` and `aggregateNameFor` gates on `containsQualifier`.
	if not signatures.hasInnerAliasParams() 'noPerInstanceMethods'
		return
	end 'noPerInstanceMethods'

	match signatures.methodInnerAliasParamsOf(callee) 'lookup'
		noInnerAliasParams then return
		found(info) then checkPerInstanceArgsWith(project, signatures: signatures, func: func, sig: sig, argIds: argIds, info: info, callRange: callRange, filePath: filePath)
	end 'lookup'
end 'checkPerInstanceArgs'

// The body of the per-instance argument check once the callee is known to declare an inner-alias parameter.
// The receiver's instance alias re-qualifies each inner-alias parameter; the argument's own aggregate name
// (its per-instance identity, or empty) is compared against it with the SAME `namedAggregatesConflict` rule
// and `typeDisplayName` wording `checkArgTypes` uses on its own `aggregateNameFor` result — a
// per-instance alias IS a nominal aggregate here, so the two aggregate-argument checks stay one rule (a
// future narrower-range compatibility rule lands in one place, not two).
//
// ⚠ **IT IS THE ONE AGGREGATE COMPARISON THAT IS *NOT* ROUTED THROUGH `ProgramSignatures.aggregatesConflict`,
// AND THE REASON IS THAT ITS EXPECTED SIDE IS NOT A TYPE.** `expected` here is a name this function BUILDS
// (`joinQualifiedName(receiverAlias, member)`) rather than one read off a declaration or a value, so there
// is no (tag, nameId) pair to hand the shared door — and nothing is lost by that, because both halves of
// what the shared door adds are unreachable on this comparison: a per-instance alias is a `named` wrapper
// over an int, never an `Array` instance, so the byte-element boundary cannot open, and the decay is
// already decided one line above by `got.isEmpty()`.
//
// ⛔⛔ **IT MINTS `<receiverAlias>.<member>` AS AN IDENTITY, SO IT MAY ONLY BE ASKED WHERE THAT NAME IS ONE
// (W25).** `info` records EVERY parameter typed with an inner alias of the enclosing generic type, and only a
// RANGED one (`typealias Idx = int(0 to 9)`) has a per-instance identity — an int wearing a name, distinct per
// instance alias, which is the whole subject of P1.6-C. A GENERIC-INSTANCE inner alias
// (`typealias Items = Array with T`) has none: `HoldANum.Items` is in no registry, it is a string this line
// builds, and comparing a real type against it can only ever fail. **MEASURED: `a.adopt(b.items)` with `a` and
// `b` both `HoldA with Num` was `E3005: expected 'HoldANum.Items', got 'HoldA.Items'`** — a program handing a
// value to a parameter of its own type, refused by a name no declaration wears. Such a parameter is judged by
// TYPE instead, against the instance view of its declared type (`paramTypeThroughCallInstance`), which is
// where it belongs: that comparison sees `Array with Num` on both sides and also REFUSES a
// `HoldA with String`'s items, which this name check accepted (both spelled `HoldA.Items`).
function checkPerInstanceArgsWith(project Project, signatures ProgramSignatures, func IrFunction, sig FuncSignature, argIds ValueIdArray, info InnerAliasParamInfo, callRange SourceRange, filePath FilePath)
	// A method prepends `__self` at real position 0; the sweep records inner-alias members over the SOURCE
	// parameters (no `__self`), so a method's real position i maps to source i - 1. A static factory has no
	// receiver here — its inner-alias arguments decay — so only a method is checked.
	if not sig.takesReceiver() 'noReceiver'
		return
	end 'noReceiver'

	let receiverAlias = receiverInstanceAlias(project, func: func, argIds: argIds)
	if receiverAlias.isEmpty() 'noReceiverAlias'
		return
	end 'noReceiverAlias'

	for i in 1 upto argIds.count() 'eachArg'
		let member = info.memberAt(i - 1)
		if member.isEmpty() 'notInnerAliasParam'
			continue
		end 'notInnerAliasParam'
		let argId = try argIds.get(i) otherwise panic("checkPerInstanceArgsWith: argIds.get OOB at {i}")
		let argTag = try func.valueTags.get(argId) otherwise panic("checkPerInstanceArgsWith: value v{argId} of function '{String.from(func.name)}' has no recorded type")
		let argNameId = try func.valueNameIds.get(argId) otherwise panic("checkPerInstanceArgsWith: value v{argId} of function '{String.from(func.name)}' has no recorded type name")
		let got = aggregateNameFor(project, tag: argTag, nameId: argNameId, readerFilePath: filePath)
		if got.isEmpty() 'decays'
			continue
		end 'decays'
		let expected = joinQualifiedName(receiverAlias, member: member)
		// The reader is the CALLING file, which is the scope a contested instance-alias prefix resolves in —
		// unlike `aggregatesConflict`, which is handed two bare names and has no reader to ask (N3).
		if not signatures.isPerInstanceAlias(expected, readerFilePath: filePath) 'noPerInstanceIdentityToCompare'
			continue
		end 'noPerInstanceIdentityToCompare'

		if namedAggregatesConflict(expected, got: got) 'wrongInstance'
			let paramName = try sig.paramNames.get(i) otherwise panic("checkPerInstanceArgsWith: paramNames.get OOB at {i}")
			reportPositioned(project, code: ErrorCode.typeMismatch, message: argTypeMismatchMessage(paramName, position: i, expected: String.from(expected), got: valueTypeDisplayName(project, func: func, value: argId, tag: argTag, nameId: argNameId, readerFilePath: func.sourceFilePath)), line: callRange.line, column: callRange.column, filePath: filePath)
			return
		end 'wrongInstance'
	end 'eachArg'
end 'checkPerInstanceArgsWith'

// The instance alias the RECEIVER argument (`argIds[0]`) came from, read off the caller function's delivered
// per-value provenance (`FunctionRangeChecks.valueInstanceAliases`). Empty when the receiver has none — a
// `self` receiver, a value merged across branches — which makes the inner-alias arguments decay.
function receiverInstanceAlias(project Project, func IrFunction, argIds ValueIdArray) returns ByteArray
	if argIds.count() == 0 'noArgs'
		return EmptySourceText
	end 'noArgs'
	let receiverId = try argIds.get(0) otherwise panic("receiverInstanceAlias: argIds.count() > 0 but get(0) failed")
	return instanceAliasOfValue(project, func: func, value: receiverId)
end 'receiverInstanceAlias'

// The instance alias the SOURCE named when it wrote this value down (P1.6-C's per-value provenance), or empty
// where it named none — a `self` receiver, a value merged across branches. Split out of
// `receiverInstanceAlias` when the diagnostics gained a second reason to ask it; the receiver question is now
// "the alias of argument 0" and nothing more.
function instanceAliasOfValue(project Project, func IrFunction, value ValueId) returns ByteArray
	let checks = try project.rangeChecks.get(func.name) otherwise return EmptySourceText
	return try checks.valueInstanceAliases.get(value) otherwise EmptySourceText
end 'instanceAliasOfValue'

// ⭐⭐ **HOW A DIAGNOSTIC SPELLS THE TYPE OF A *VALUE* — the site's own words where the type itself has none.**
//
// ⛔⛔ **R-1 MADE THE gid AN INSUFFICIENT ANSWER, AND THE ORACLE ALREADY KNEW IT.** Two ranged aliases over
// one range are one type, so `WideCol` and `OtherCol` share a `GenericInstanceId` and the per-gid display can
// only pick one of them. MEASURED on `var o = OtherCol.create(); takesNarrow(o)`: the bootstrap says
// `got 'OtherCol'` — the spelling at the site — while a per-gid answer said `got 'WideCol'`, a name that
// appears nowhere in the statement being blamed.
//
// ⭐ **THE CHANNEL ALREADY EXISTED**: `valueInstanceAlias` was built for P1.6-C to carry exactly *"the
// provenance the shared `GenericInstanceId` cannot carry (`WrapperA` and `WrapperB` share one gid)"*. R-1
// makes that sentence true of ranged aliases too, so this reads the same column rather than inventing one.
//
// ⚠ **ASKED ONLY WHERE THE gid CANNOT ANSWER.** An instance one alias spells is spelled that way by
// everyone, and going through the value would change nothing while making every mismatch pay a map probe —
// and would quietly re-spell messages that are pinned against the oracle today.
function valueTypeDisplayName(project Project, func IrFunction, value ValueId, tag ValueTypeTag, nameId TypeNameId, readerFilePath FilePath) returns String
	if tag != ValueTypeTag.genericInstance 'itsTypeHasOneSpelling'
		return typeDisplayName(project, tag: tag, nameId: nameId, readerFilePath: readerFilePath)
	end 'itsTypeHasOneSpelling'

	if not programSignaturesIn(project, asker: "valueTypeDisplayName").instanceIsMultiplyAliased(nameId) 'oneAliasSpellsItForEveryone'
		return typeDisplayName(project, tag: tag, nameId: nameId, readerFilePath: readerFilePath)
	end 'oneAliasSpellsItForEveryone'

	let named = instanceAliasOfValue(project, func: func, value: value)
	if named.isEmpty() 'theSiteNamedNoAlias'
		return typeDisplayName(project, tag: tag, nameId: nameId, readerFilePath: readerFilePath)
	end 'theSiteNamedNoAlias'

	return String.from(named)
end 'valueTypeDisplayName'

// ⭐ **REFUSE A CAPTURING CLOSURE PASSED TO A PERSISTED PARAMETER (P1.5-A2b-2, E3099).** The closure's
// environment belongs to THIS frame; a callee that stores or returns the parameter keeps the closure alive
// past this frame's death, and only the fn-ptr survives — the captured env dangles (OPEN #13's interprocedural
// escape). The refusal keys on the passed VALUE being a capturing-closure LITERAL (`valueIsCapturingClosure`)
// AND the parameter being one the callee's summary marks escaping: a NON-capturing function value (a plain
// reference / non-capturing closure) has no env to lose and passes freely, so `Handler.create(double)` and the
// `field-*` cases stay green; a capturing closure passed to a parameter that is only CALLED
// (`apply(f, x) → f(x)`) is not in the summary and passes freely, keeping the pass-DOWN accepts green.
function checkCapturingClosureEscape(project Project, func IrFunction, callee ByteArray, argIds ValueIdArray, escapeSummary ParamEscapeSummary, callRange SourceRange, filePath FilePath)
	let escapingParams = try escapeSummary.get(callee) otherwise return
	// `argIds` is SLOTTED, so index `i` is the callee's declaration position — the same space the mask is in.
	for i in 0 upto argIds.count() 'eachArg'
		if not maskHasParam(escapingParams, param: i) 'paramSafe'
			continue
		end 'paramSafe'
		let argId = try argIds.get(i) otherwise panic("checkCapturingClosureEscape: argIds.get OOB at {i}")
		// ⭐ THE SAME `isMarkedCapturingClosure` the derived rule asks — not a second reading of the mark
		// column. These two checks are the arrangement's two halves (this one owns the direct-call argument
		// slot the derived scan delegates to it, in `syncCallArgEscapes`), so "which values are capturing
		// closures" is exactly the fact they must never come to answer differently.
		if isMarkedCapturingClosure(argId, func: func) 'capturingEscapes'
			reportPositioned(project, code: ErrorCode.capturingClosureEscapes, message: "cannot pass a closure that captures to '{String.from(callee)}', which stores or returns it: {CapturingClosureEscapeSuffix}", line: callRange.line, column: callRange.column, filePath: filePath)
			return
		end 'capturingEscapes'
	end 'eachArg'
end 'checkCapturingClosureEscape'

// ⭐⭐ **THE CAPTURING-CLOSURE USE INVARIANT (P1.5, OPEN #73) — DERIVED, NOT ENUMERATED.**
//
// A closure that CAPTURES carries its environment in a per-value side column, and that environment is a heap
// block dropped at the scope that built it. The value is therefore safe only where the environment travels
// WITH it: an in-frame indirect call (`emitClosureEnvArg` threads it as the companion argument) and a direct
// call whose callee does not persist the parameter (`checkCapturingClosureEscape`, which owns that question).
// EVERY other appearance loses the environment — a store keeps the code pointer alone, a return outlives the
// frame that owns the block, and a phi joins its edges through ONE slot that no side column can follow.
//
// **The parser refuses the routes a user actually writes AT THE SYNTAX**, and keeps doing so, because it is
// the only place that still holds the words: `storeIndirect` carries no field name, no struct name and no
// union case, and a branch edge carries no source span AT ALL — so "cannot store a closure that captures in
// field 'op' of 'Handler'", at the field token, is text no later pass can rebuild. What the parser could not
// do is GUARANTEE the list was complete: each site is a hand-written call and a NEW value sink is under no
// obligation to add one. That is OPEN #73, and it was not theoretical — TWO escapes were open for exactly
// that reason and both SEGFAULTED, a capturing closure carried across an `if`-continuation phi and one
// carried across a loop-header phi. Neither is a ternary, a match `gives` or an `otherwise`: the three merges
// the parser enumerates.
//
// **THIS is the guarantee, and it is structural.** It runs over the finished module and asks the question of
// the IR rather than of the syntax, through the SAME exhaustive band-append `match` (`opEscapesValue`) the
// interprocedural parameter summary already walks. A newly appended `MaxonOp` FAILS TO COMPILE there rather
// than silently becoming an unguarded sink, and a new store / terminator / phi edge built out of the ops that
// already exist is covered the moment it exists, with no site to remember. The parser's sites are now an
// EARLIER and BETTER-WORDED instance of a rule this pass enforces; delete one and the program is still
// refused, in generic words, instead of miscompiled.
//
// Anchored uniformly at the CLOSURE LITERAL's own `function` token (its `functionRef` op, via
// `project.valueOrigins`), which is the one span that exists on every route — a phi edge has none — and is
// in every case the token the user must change.
function checkCapturingClosureUses(project Project, module MaxonModule)
	for funcIndex in 0 upto module.funcCount() 'eachFunc'
		checkCapturingClosureUsesInFunction(project, module: module, func: module.getFunc(funcIndex as FuncIndex), funcIndex: funcIndex as FuncIndex)
	end 'eachFunc'
end 'checkCapturingClosureUses'

// One function's capturing closures — **ONE body scan for ALL of them.** `boolArrayAny` is the cheap,
// NON-ALLOCATING gate — mirroring `buildEscapeSummary`'s `functionHasFunctionParam` and `checkLinearAwait`'s
// `functionHasAwait` — that keeps the body scan off every closure-free function, which is the entire scale
// corpus. Behind it the scan tracks the whole marked column at once (`EscapeScanSubject`), so the cost is
// O(ops) whatever the function's closure DENSITY; a scan per closure was (closures × ops), and because a
// function's op count grows with its closure count that measured ~4x per doubling of C. It reports the first
// offending USE in scan order and stops — one diagnostic per function, chosen deterministically so the choice
// is worker-invariant.
function checkCapturingClosureUsesInFunction(project Project, module MaxonModule, func IrFunction, funcIndex FuncIndex)
	if not boolArrayAny(func.valueIsCapturingClosure) 'noCapturingClosure'
		return
	end 'noCapturingClosure'

	// The route decides the wording: an op names which slot (`closureEscapeReason`), a phi edge is its own
	// route with no op to read.
	match valueEscapeSite(func, module: module, subject: EscapeScanSubject.everyCapturingClosure, funcSignatures: project.funcSignatures) 'site'
		persistedBy(closure, opIndex) then reportClosureEscapeAtOp(project, module: module, func: func, funcIndex: funcIndex, closure: closure, opIndex: opIndex)
		mergedIntoPhi(closure) then reportClosureEscape(project, func: func, funcIndex: funcIndex, closure: closure, reason: "cannot carry a closure that captures across a branch merge: {CapturingClosureMergeSuffix}")
		none then break 'site'
	end 'site'
end 'checkCapturingClosureUsesInFunction'

// The OP route: fetch the offending op, word the refusal from its kind, report. Split out of the match arm
// above so the fetch is a plain `let` — a `try … otherwise panic` nested two levels deep inside a labelled
// ARGUMENT miscompiles under the bootstrap (`E9001: assign value … not in valueMap`), which is a property of
// the compiler building this source, not of the rule.
function reportClosureEscapeAtOp(project Project, module MaxonModule, func IrFunction, funcIndex FuncIndex, closure ValueId, opIndex OpIndex)
	let op = try module.ops.get(opIndex) otherwise panic("reportClosureEscapeAtOp: escape site op {opIndex} not in module.ops")
	reportClosureEscape(project, func: func, funcIndex: funcIndex, closure: closure, reason: closureEscapeReason(op))
end 'reportClosureEscapeAtOp'

// ⭐ **THE ONE OP-KIND → REASON MAPPING** for a capturing closure found in a slot its environment cannot
// reach. Every arm that RETURNS is one `opEscapesValue` reports for `EscapeScanSubject.everyCapturingClosure`;
// the rest fall through to the panic below rather than invent wording, because reaching it would mean the two
// matches disagree about what a persisting slot IS. The bands range for the band-append invariant, so a newly
// appended op must state its own answer here too.
function closureEscapeReason(op MaxonOp) returns String
	match op 'op'
		call then return runtimeEntryClosureEscapeMessage()
		literal then break 'op'
		ret then return "cannot return a closure that captures: {CapturingClosureEscapeSuffix}"
		retVoid to loadIndirect then break 'op'
		storeIndirect then return "cannot store a closure that captures into memory that outlives this frame: {CapturingClosureEscapeSuffix}"
		stringLiteral then break 'op'
		tryCall then return runtimeEntryClosureEscapeMessage()
		throwError to functionRef then break 'op'
		// A1's higher-order case: a function VALUE's type carries no parameter types, so nothing tells the
		// lowering where to thread the environment (the parser refuses this earlier, E2015, with the fuller
		// explanation — this is the structural backstop for the same route reached any other way).
		indirectCall then return "cannot pass a closure that captures as an argument to an indirect call: {CapturingClosureEscapeSuffix}"
		asyncCall then return runtimeEntryClosureEscapeMessage()
		await to switch then break 'op'
		// PART 3: a witness dispatch picks its concrete method at RUN TIME from the witness table, so there is
		// no callee name to key an escape summary on and `checkCapturingClosureEscape` never sees the call.
		// Refused rather than delegated to a decider that cannot run — before this arm it reached lowering and
		// PANICKED (`maxonTypeToStdType`) on the environment it could not thread.
		witnessDispatch to witnessTryDispatch then return "cannot pass a closure that captures to an interface method dispatched through a witness: the concrete method is chosen at run time, so the compiler cannot tell whether it stores the closure, and its environment cannot be threaded to it. {CapturingClosureEscapeSuffix}"
		// A panic persists nothing (`opEscapesValue` says so), so it falls through to the panic below.
		panicAbortValue then break 'op'
		// The error-flag encode persists nothing (`opEscapesValue` says so), so it falls through to the panic below.
		errorFlagEncode then break 'op'
		// ⚠ **UNREACHABLE TODAY AND STILL THE RIGHT ANSWER, for `untransferableParameterNoun`'s reason.** A
		// `function`-typed message parameter is refused at the `spawn` (E3135) and a spawn's state is a static
		// factory's own box, so no closure can be either operand — but `opEscapesValue` reports the escape
		// structurally, and a `break` here would send a program that somehow reached it to that function's
		// disagreement panic instead of to a sentence.
		serviceSpawn to serviceReplyCell then return "cannot hand a closure that captures to a service: a message MOVES its arguments to another green thread, and a capturing closure's environment is a box this one would still hold. {CapturingClosureEscapeSuffix}"
	end 'op'

	// Reached only if `opEscapesValue` reported an escape at an op this mapping believes cannot persist a
	// value — a compiler bug in exactly one of the two, never a user error.
	panic("closureEscapeReason: this op is not a capturing-closure escape site — `opEscapesValue` and this mapping disagree about which slots persist a value")
end 'closureEscapeReason'

// The wording for a capturing closure handed to a COMPILER-INTERNAL callee (`__managed_push`, …). Written once
// because the three call ops share it — a `call`, a `tryCall` and an `asyncCall` reach this mapping only
// through `directCallArgEscapes`' runtime-entry arm, which is the same fact each time. A function rather
// than a module-scope `let`, because a top-level constant takes a CONSTANT initializer and may not
// interpolate the shared reason (E2004) — and spelling that reason out here would be a fourth copy of it.
function runtimeEntryClosureEscapeMessage() returns String
	return "cannot pass a closure that captures to a compiler runtime entry: it puts the value in heap memory that outlives this frame, and a runtime entry has no signature for the escape summary to be built from. {CapturingClosureEscapeSuffix}"
end 'runtimeEntryClosureEscapeMessage'

// Report E3099 at `closure`'s defining `functionRef` — the closure literal's own `function` keyword.
function reportClosureEscape(project Project, func IrFunction, funcIndex FuncIndex, closure ValueId, reason String)
	let range = project.opRanges.get(closureDefiningOp(project, func: func, funcIndex: funcIndex, closure: closure))
	reportPositioned(project, code: ErrorCode.capturingClosureEscapes, message: reason, line: range.line, column: range.column, filePath: func.sourceFilePath)
end 'reportClosureEscape'

// The op that DEFINED `closure` — the `functionRef` `parseClosureExpression` emits, whose span is the
// closure literal's `function` keyword.
function closureDefiningOp(project Project, func IrFunction, funcIndex FuncIndex, closure ValueId) returns OpIndex
	match project.valueOrigins.lookup(funcIndex, valueId: closure) 'origin'
		found(opIndex) then return opIndex
		none then break 'origin'
	end 'origin'

	// A capturing closure is minted by exactly one op — that `functionRef`, emitted before `buildClosureEnv`
	// marks the value — and `FileParseArtifact.emitOp` files its origin in lockstep, so a marked value with
	// no origin means the mark and the op stream have come apart.
	panic("closureDefiningOp: capturing closure v{closure} of '{String.from(func.name)}' has no defining op in `valueOrigins` — the mark is set only on a value `functionRef` defined")
end 'closureDefiningOp'

function checkArgTypes(project Project, func IrFunction, result ValueId, sig FuncSignature, argIds ValueIdArray, callRange SourceRange, filePath FilePath)
	// ⭐⭐ **A CALL THROUGH A CONCRETE INSTANCE JUDGES ITS ARGUMENTS AGAINST THE INSTANCE VIEW OF EACH
	// PARAMETER, NOT AGAINST THE SHARED BODY'S DECLARATION VIEW (W25).** shv2 compiles one body per generic
	// type, so `adopt(other Items)` and `merge(source Self)` are declared in terms the receiver fixes — and
	// judging them unfixed refuses a program handing a value to a parameter of its own type. The subject is
	// read ONCE, here, through the same `callInstanceSubject` the substituted check below uses, so the two
	// halves of the argument rule cannot come to disagree about which instance this call is made at.
	let instanceSubject = callInstanceSubject(sig, result: result, argIds: argIds)
	for i in 0 upto argIds.count() 'eachArg'
		let argId = try argIds.get(i) otherwise panic("checkArgTypes: argIds.get OOB at {i}")
		let paramType = paramTypeThroughCallInstance(project, func: func, subject: instanceSubject, paramType: try sig.paramTypes.get(i) otherwise panic("checkArgTypes: paramTypes.get OOB at {i} — slotCallArgs returned {argIds.count()} slots for a {sig.paramCount()}-parameter signature"))
		let paramName = try sig.paramNames.get(i) otherwise panic("checkArgTypes: paramNames.get OOB at {i}")

		// ⛔⛔ **THE RECEIVER ARGUMENT (`__self`, position 0) IS JUDGED LIKE EVERY OTHER PARAMETER, AND THE
		// EXEMPTION IT USED TO HAVE WAS A SILENT MEMORY-SAFETY HOLE.** The exemption's premise was that a
		// receiver is *compatible by construction* — the callee was mangled FROM the receiver's own type
		// (`dispatchMethodOnBase`), so a method declared on `Sizer` is only ever reached through a `Sizer`.
		// **That is true of `a.bump()` and false of `Adder.bump(7)`**, where the author NAMED the type and
		// the parser therefore built the call with no receiver at all (`ReceiverArg.none`): the first
		// argument the author wrote lands in slot 0 because that is where an unlabelled argument goes, and
		// slot 0 is `SelfParamName`. `parseQualifiedCall` believed arity refused that shape, which holds
		// only while the counts differ — and they COINCIDE for every zero-parameter instance method called
		// with one argument. MEASURED on the unchanged tree, all three COMPILED CLEAN and then faulted
		// `0xC0000005` dereferencing an `int` as a record pointer: `String.byteLength(3)`,
		// `Character.hash(3)`, and `Adder.bump(7)` on a plain user type.
		//
		// ⭐ **THE FORM ITSELF IS LEGAL AND IS NOT REFUSED.** `Adder.bump(a)` on a real `Adder` is that
		// method call, and the runnable oracle COMPILES AND RUNS IT (exit 42, measured) — so what
		// distinguishes the two is exactly what this check answers, the ARGUMENT'S TYPE, and nothing here
		// needs to know which spelling the author used.
		//
		// ⚠ **WHAT THE EXEMPTION WAS PROTECTING IS `paramTypeThroughCallInstance`'s JOB, AND IT WAS ALREADY
		// DOING IT ONE LINE ABOVE.** A generic INSTANCE receiver (P1.6-B1) is tagged `genericInstance` while
		// the shared body's `__self` param is the base `structRef`, which a raw comparison would read as a
		// spurious mismatch — but `paramType` above has ALREADY been resolved through the call's instance,
		// and that substitution's `maybeSelf` arm maps precisely a base-named `structRef` onto the subject's
		// instance. The receiver is the subject `callInstanceSubject` picks, so the parameter it fixes first
		// is its own. `an-ordinary-method-call-through-a-generic-instance-is-unaffected` is the case that
		// goes red if that stops being true.
		//
		// The two pre-erasure columns a DIRECT call's signature carries — the UNION/ENUM identity and the
		// DECLARED SPELLING; see `checkOneArgType`.
		let preErasedAggregate = try sig.paramAggregateNames.get(i) otherwise panic("checkArgTypes: paramAggregateNames.get OOB at {i} — a signature's param columns (names, types, aggregate names) are built in lockstep")
		let declaredParamName = try sig.paramDeclaredNames.get(i) otherwise panic("checkArgTypes: paramDeclaredNames.get OOB at {i} — a signature's param columns (names, types, aggregate names, declared names) are built in lockstep")
		// ⭐⭐ **ONE CALL EARNS ONE ARGUMENT DIAGNOSTIC — the FIRST (W81).** Past that the call is already
		// refused, and every later argument's verdict is a second sentence about it; the reference emits only
		// the first and the corpus is written from the reference. MEASURED against the oracle on
		// `Box.take(1.5, b: 2.5)`, both arguments wrong: **one** E3009, naming `a`. `testing-assertions`'
		// `error.float-has-no-equal` is the canonical pin — shv2 emitted a second line for `expected` that no
		// spec in either corpus expects, and NO `maxoncstderr` block in `/specs` or `specs-shv2` carries two
		// E3009s (swept 2026-08-13).
		//
		// ⚠ **IT IS THE ONE CALL'S RULE AND NOT A FIRST-ERROR GATE.** Two separately-bad calls still earn two
		// diagnostics here, which is shv2's own design and where it deliberately parts from the bootstrap
		// (measured: the oracle reports one for the whole file). Nothing in the corpus asks for the narrower
		// behaviour, and `project.diagnostics` being first-class is the point of the departure.
		//
		// ⚠ **ASKED OF `project.diagnostics` RATHER THAN THREADED BACK AS A BOOL**, and that is the safer
		// spelling rather than the lazier one: `checkOneArgType` reports from six sites across four functions,
		// so a returned flag is six places to remember and one place to silently forget — where the record
		// that a diagnostic exists cannot be forgotten by a new report site. It is `Queries.foldOneFileInto`'s
		// own before/after idiom.
		let reportedBefore = project.diagnostics.count()
		checkOneArgType(project, func: func, paramType: paramType, preErasedAggregate: preErasedAggregate, declaredParamName: declaredParamName, paramName: paramName, position: i, argId: argId, callInstanceSubject: instanceSubject, paramExistentialSites: sig.paramExistentialSites, callRange: callRange, filePath: filePath)
		if project.diagnostics.count() > reportedBefore 'thisArgumentWasRefused'
			return
		end 'thisArgumentWasRefused'
	end 'eachArg'
end 'checkArgTypes'

// ⭐⭐ **ONE PARAMETER'S TYPE AS THE CALL'S CONCRETE INSTANCE SEES IT (W25)** — the declaration-view types a
// shared generic body spells, resolved against the instance the call is actually made at:
//
//   • an inner-alias / nested-instance parameter (`other Items`, i.e. `Array with T`) becomes the instance's
//     own (`Array with Num`), through `ProgramSignatures.substituteThroughInstance` — the SAME substitution
//     the field read and the drop cascade use, so what `b.items` IS and what `adopt` ACCEPTS are one answer;
//   • a `Self` parameter (`merge(source Self)`, tagged with the base's `structRef`) becomes the instance.
//
// ⛔ **BOTH WERE REFUSALS OF LEGAL PROGRAMS THE ORACLE RUNS.** `a.adopt(b.items)` on two `HoldA with Num` was
// `E3005: expected 'HoldANum.Items', got 'HoldA.Items'` and `b.merge(a)` on two `Container with Integer` was
// `E3005: expected 'Container', got 'IntContainer'` — each a sentence naming one type twice.
//
// ⚠ **A BARE `typeParameter` PARAMETER IS DELIBERATELY LEFT ALONE HERE**, and that is the PARTITION between
// the two halves of the argument rule rather than an omission: `checkTypeParameterArgsAt` owns those
// positions, substitutes them through the same instance, and carries the nominal/scalar split and the
// `instanceArgDisplayName` wording that the whole `IntBox.create(1.5)` argument rests on. Substituting them
// here as well would judge one position twice, under two renderings.
//
// ⚠ **THE `Self` ARM IS THE ARGUMENT CHECK'S AND IS NOT INSIDE THE SHARED SUBSTITUTION.** It was, for one
// build, and it MEASURED **21 newly failing cases** in `--filter=generic` alone: the substitution is also what
// retypes a field READ and a method RETURN, where `returns Self` legitimately keeps the shared body's
// `structRef` and a value that was a `Leaf` became a `LeafBox`. A `structRef` payload is an interner-local
// name id too, so resolving it needs a table the interner-free substitution deliberately does not take.
//
// The subject's tag is read per parameter rather than hoisted for `argParamLabel`'s reason — a dense array
// read is cheaper than threading a second value through, and the overwhelmingly common call (no instance
// subject at all) leaves after it.
function paramTypeThroughCallInstance(project Project, func IrFunction, subject ValueId, paramType MaxonType) returns MaxonType
	let paramTag = maxonTypeTag(paramType)
	if paramTag == ValueTypeTag.typeParameter 'ownedByTheSubstitutedCheck'
		return paramType
	end 'ownedByTheSubstitutedCheck'

	if paramTag != ValueTypeTag.structRef and paramTag != ValueTypeTag.genericInstance 'carriesNoDeclarationView'
		return paramType
	end 'carriesNoDeclarationView'

	let subjectTag = try func.valueTags.get(subject) otherwise panic("paramTypeThroughCallInstance: value v{subject} of function '{String.from(func.name)}' has no recorded type — every SSA value must be minted through Parser.mintValue")
	if subjectTag != ValueTypeTag.genericInstance 'notACallThroughAConcreteInstance'
		return paramType
	end 'notACallThroughAConcreteInstance'

	// ⚠ `var`, because the substitution INTERNS the instance it produces — `Array with T` under `T -> Num` is a
	// type the program may never spell, and the identity it is compared by has to exist. Same reason
	// `checkTypeParameterArgsAt` binds the index that way for the compiled-name memo.
	var signatures = programSignaturesIn(project, asker: "paramTypeThroughCallInstance")
	let gid = try func.valueNameIds.get(subject) otherwise panic("paramTypeThroughCallInstance: genericInstance value v{subject} of function '{String.from(func.name)}' has no recorded GenericInstanceId — the two type columns are minted in lockstep")
	if paramTag == ValueTypeTag.structRef 'maybeSelf'
		let name = try project.typeNames.nameOf(typeNameIdOf(paramType)) otherwise panic("paramTypeThroughCallInstance: structRef id {typeNameIdOf(paramType)} is not in the project interner — a signature's param types are remapped project-global at merge (mergeArtifact)")
		return MaxonType.genericInstance(gid) if name.equals(signatures.genericInstanceBaseName(gid)) else paramType
	end 'maybeSelf'

	return signatures.substituteThroughInstance(paramType, id: gid)
end 'paramTypeThroughCallInstance'

// ⭐⭐ **A FUNCTION-TYPED PARAMETER CARRIES A DECLARATION VIEW TOO — IN ITS SHAPE, WHICH IS WHY THE DOOR ABOVE
// CANNOT REACH IT (W41).** `paramTypeThroughCallInstance` rewrites a TYPE, and a function type is a NAME
// (`MaxonType.function(id)`): its parameter and return types live in a `FunctionShape` off to the side, so
// there is nothing in the type itself for a substitution to fix. The shape is therefore fixed HERE, at the one
// comparison that reads it, rather than by minting a substituted alias nothing else would ever ask for.
//
// ⛔ **MEASURED, and it refused a program the runnable oracle compiles and runs.** `stdlib/Interfaces.maxon`'s
// `map(transform ElementTransform)` is re-parsed once per CONFORMER, so `Map.map`'s transform is
// `function(Map.Entry) returns Map.Entry` — a tuple citing `Map`'s own type parameters. Judged unfixed against a
// closure written at a concrete `Map with (String, int)`, `m.map(function(p (String, Integer)) gives p)` was
// **`E3005 … expected 'fn(__Tuple2.Tfcd8090be60770aa.T5d84c0fc6312cff6) returns …', got 'fn(__Tuple2.String.int)
// returns …'`** — one type named twice, in two views, which is `paramTypeThroughCallInstance`'s own W25
// measurement one tier down. The bootstrap runs that program and answers 6.
//
// ⚠ **THE PRE-ERASURE IDENTITY COLUMNS ARE CARRIED THROUGH UNCHANGED FOR EVERY SLOT BUT ONE, AND THAT
// EXCEPTION IS F3's.** They hold the names resolution DESTROYS — a boxed union/enum, a per-instance ranged
// alias — and `FunctionShape.paramAggregateNames` is deliberately EMPTY for exactly the shapes this
// substitution used to move (a struct, a tuple, a nested instance keep their identity live in `paramTypes`).
// This header used to close *"a type argument cannot turn a position from one kind into the other: the
// substitution replaces a type parameter or an instance argument, never the enum-ness of a slot"*, and a bare
// `T` slot is precisely where that stops being true — its identity column was captured at the PARSE, where
// the slot was an opaque parameter with no identity at all, and the instance may bind it to an ENUM.
// ⛔ MEASURED on `typealias Transform = function(Element) returns Element` at a `Holder with Shade`:
// **`E3005 … expected 'fn(int) returns int', got 'fn(Shade) returns Shade'`** — a legal program refused,
// because the arriving side carried `Shade` and the declared side carried the opaque slot's empty column.
//
// Returns the shape UNCHANGED — the same object — when nothing moved, the early-return contract every
// substitution in this compiler keeps, so the overwhelmingly common non-generic call allocates nothing.
function functionShapeThroughCallInstance(project Project, func IrFunction, subject ValueId, shape FunctionShape) returns FunctionShape
	let subjectTag = try func.valueTags.get(subject) otherwise panic("functionShapeThroughCallInstance: value v{subject} of function '{String.from(func.name)}' has no recorded type — every SSA value must be minted through Parser.mintValue")
	if subjectTag != ValueTypeTag.genericInstance 'notACallThroughAConcreteInstance'
		return shape
	end 'notACallThroughAConcreteInstance'

	// ⚠ `var` for `paramTypeThroughCallInstance`'s reason — the substitution INTERNS the instance and the tuple
	// it produces, so the identity the comparison is about has to exist by the time it is compared.
	var signatures = programSignaturesIn(project, asker: "functionShapeThroughCallInstance")
	let gid = try func.valueNameIds.get(subject) otherwise panic("functionShapeThroughCallInstance: genericInstance value v{subject} of function '{String.from(func.name)}' has no recorded GenericInstanceId — the two type columns are minted in lockstep")
	var substituted = MaxonTypeArray.create()
	var identities = ByteArrayArray.create()
	var moved = false
	for i in 0 upto shape.paramTypes.count() 'eachParam'
		let paramType = try shape.paramTypes.get(i) otherwise panic("functionShapeThroughCallInstance: paramTypes.get OOB at {i} — the count was just read from the same array")
		let next = resolvedSlotThroughCallInstance(project, signatures: signatures, slotType: paramType, gid: gid)
		if not maxonTypesDenoteSame(next, b: paramType) 'paramMoved'
			moved = true
		end 'paramMoved'
		substituted.push(next)
		identities.push(substitutedSlotIdentity(project, signatures: signatures, slotType: paramType, gid: gid, carried: shapeParamIdentity(shape, index: i)))
	end 'eachParam'

	let returnType = returnTypeThroughCallInstance(project, signatures: signatures, returnType: shape.returnType, gid: gid)
	if not moved and maxonReturnTypesDenoteSame(returnType, b: shape.returnType) 'theInstanceFixesNothingHere'
		return shape
	end 'theInstanceFixesNothingHere'

	return FunctionShape.create(substituted, returnType: returnType, paramAggregateNames: identities, returnAggregateName: returnSlotIdentityThroughCallInstance(project, signatures: signatures, shape: shape, gid: gid))
end 'functionShapeThroughCallInstance'

// ⭐⭐ **THE IDENTITY OF A SLOT THE INSTANCE JUST FILLED IN — `Parser.erasedAggregateNameOf`'s RULE stated for
// this tier, and asked for the bare-`T` arm alone (F3).** Every other slot keeps the column the parse
// captured: it was already concrete there, and recomputing it from the RESOLVED type would read `integer`
// and throw a real `Shade` away.
//
// ⚠ **THE RULE IS "THE IDENTITY RESOLUTION DESTROYS", WHICH IS NOT "THE IDENTITY THE TYPE HAS".** A STRUCT
// keeps its `structRef` through resolution and must answer EMPTY here (its name is read live off the type on
// both sides); only what collapses to bare `integer` — a boxed union/enum, a per-instance ranged alias — has
// a name that must be carried. That is why the gate is the RESOLVED tag while the answer comes from the
// UNRESOLVED one, and why `aggregateNameFor` alone would be wrong here: it names a struct.
//
// ⚠ It CROSSES THE SLOT AGAIN rather than taking the caller's crossed type, and that is one extra call of
// ONE function, not a second spelling of it: the caller holds the RESOLVED form, and the name this needs
// exists only in the unresolved one. The crossing is `slotThroughCallInstance` either way, so the two cannot
// come to disagree; and it runs on the bare-`T` arm alone, which is a handful of slots in a whole program.
function substitutedSlotIdentity(project Project, signatures ProgramSignatures, slotType MaxonType, gid GenericInstanceId, carried ByteArray) returns ByteArray
	if not slotIsBareTypeParameter(slotType) 'concreteAtTheParse'
		return carried
	end 'concreteAtTheParse'

	let unresolved = slotThroughCallInstance(project, signatures: signatures, slotType: slotType, gid: gid)
	if maxonTypeTag(resolveType(project, signatures: signatures, t: unresolved, readerFilePath: CompilerOwnedDeclFilePath)) != ValueTypeTag.integer 'identitySurvivesInTheTypeItself'
		return EmptySourceText
	end 'identitySurvivesInTheTypeItself'

	// `CompilerOwnedDeclFilePath` for `resolvedSlotThroughCallInstance`'s reason, two lines up.
	return aggregateNameFor(project, tag: maxonTypeTag(unresolved), nameId: typeNameIdOf(unresolved), readerFilePath: CompilerOwnedDeclFilePath)
end 'substitutedSlotIdentity'

// The RETURN slot's half of the identity above — one name rather than a column, because a function type
// returns exactly one thing. `void` carries no type and therefore no identity.
function returnSlotIdentityThroughCallInstance(project Project, signatures ProgramSignatures, shape FunctionShape, gid GenericInstanceId) returns ByteArray
	match shape.returnType 'declaredSlot'
		void then return EmptySourceText
		value(inner) then return substitutedSlotIdentity(project, signatures: signatures, slotType: inner, gid: gid, carried: shape.returnAggregateName)
	end 'declaredSlot'
end 'returnSlotIdentityThroughCallInstance'

// ⭐ **IS THIS SHAPE SLOT THE BARE-`T` ARM? — the ONE question that decides BOTH halves of the substitution,
// which is why it has one speller (F3).** It says whether the answer crosses an INTERNER
// (`slotThroughCallInstance`) and whether the instance can give the slot a pre-erasure IDENTITY it did not
// have when the alias was parsed (`substitutedSlotIdentity`). Those are two facts about one slot and they
// must never be decided differently for it: a slot crossed as opaque but scored as concrete would compare a
// project-space type against an index-space name, which is the pair of bugs both headers record.
function slotIsBareTypeParameter(slotType MaxonType) returns bool
	return maxonTypeTag(slotType) == ValueTypeTag.typeParameter
end 'slotIsBareTypeParameter'

// ⭐⭐ **ONE SLOT OF THAT SUBSTITUTION, CROSSED BACK INTO THIS PASS'S INTERNER — the first of the two steps
// `Parser.slotTypeThroughReceiver` already takes one tier down, and the half this door was missing (F3).**
// The substitution is asked in the INDEX's space and only the ANSWER crosses, which is that door's own rule;
// what it adds is that a bare-`T` slot's answer is the instance's ARGUMENT, and that comes back in the WRONG
// TABLE. `substitutedInstanceArg` answers in `ProgramSignatures.typeNames`, a different interner with its own
// insertion order, so the id means whatever name happens to sit at that number here.
//
// ⛔ **MEASURED** on `typealias Zog = function(Element) returns Element` inside `extension Holder`, called at
// a `Holder with Integer`: the refusal read **`expected 'fn(Holder.Zog) returns Holder.Zog'`** — the
// substituted argument rendered as the ALIAS'S OWN NAME, because that name sat at the argument's index-space
// id in the project table. The identical program with a CONCRETE parameter read `Integer`, which is the same
// bug landing on a plausible name instead of an absurd one.
//
// ⚠ **GATED ON THE DECLARED SLOT, NOT ON THE ANSWER, for `slotTypeThroughReceiver`'s reason turned to this
// door's shape.** The bare-`T` arm is the ONE arm of `substituteThroughInstanceInterned` that hands back an
// index-space id — a tuple crossed as a NAME into the interner it was GIVEN, a nested instance answers a
// whole-program giid, and every other slot is returned untouched — so adopting an answer that never left
// would re-read a project id in the index's table, which is this same bug pointed the other way.
//
// The answer is deliberately still UNRESOLVED, because its two readers need it in that order: the TYPE wants
// the erasure `resolveTypes` already performed on the arriving side (`resolvedSlotThroughCallInstance`), and
// `substitutedSlotIdentity` wants the name that erasure destroys. One crossing, two readers.
function slotThroughCallInstance(project Project, signatures ProgramSignatures, slotType MaxonType, gid GenericInstanceId) returns MaxonType
	// ⚠ `var` for `functionShapeThroughCallInstance`'s reason — the substitution INTERNS what it produces.
	var index = signatures
	let substituted = index.substituteThroughInstanceInterned(slotType, id: gid, interner: project.typeNames)
	if not slotIsBareTypeParameter(slotType) 'noIndexSpaceIdCrossedOut'
		return substituted
	end 'noIndexSpaceIdCrossedOut'

	return index.adoptType(substituted, into: project.typeNames)
end 'slotThroughCallInstance'

// ⭐ **THE CROSSING'S SECOND STEP — the ERASURE, which is what makes the declared side comparable with the
// arriving one at all.** A generic instance's type ARGUMENT is interned before the alias registries exist,
// so `Integer` crosses back as a `named` LEAF while the arriving function's own parameter was erased to
// `integer` by `resolveTypes`: one type, two spellings, and `resolvedTypesMatch` refuses them. Written once
// rather than at the parameter loop and the return slot, which is where a pair like this comes apart.
function resolvedSlotThroughCallInstance(project Project, signatures ProgramSignatures, slotType MaxonType, gid GenericInstanceId) returns MaxonType
	// ⚠ **`CompilerOwnedDeclFilePath` — a reader with no file: a generic instance's type ARGUMENT was interned before any file read it**, so
	// there is no reading file to scope a cross-KIND contested name by — the same absence
	// `witnessFormalDeclaredType` records, reached from the other side of the same crossing.
	return resolveType(project, signatures: signatures, t: slotThroughCallInstance(project, signatures: signatures, slotType: slotType, gid: gid), readerFilePath: CompilerOwnedDeclFilePath)
end 'resolvedSlotThroughCallInstance'

// The RETURN slot of the substitution above — the `void`/`value` split, which a match arm's single statement
// makes its own function exactly as `mappedArrayElementHint` is in the parser.
function returnTypeThroughCallInstance(project Project, signatures ProgramSignatures, returnType MaxonReturnType, gid GenericInstanceId) returns MaxonReturnType
	match returnType 'returned'
		void then break 'returned'
		value(inner) then return MaxonReturnType.value(resolvedSlotThroughCallInstance(project, signatures: signatures, slotType: inner, gid: gid))
	end 'returned'

	return returnType
end 'returnTypeThroughCallInstance'

// Do two return slots denote the same thing? `void` is `void`, and a value slot defers to the type rule the
// substitutions share. Written here because the substitution above needs the "did anything move" answer over a
// `MaxonReturnType`, and the type-level `maxonTypesDenoteSame` cannot see the union's own arm.
function maxonReturnTypesDenoteSame(a MaxonReturnType, b MaxonReturnType) returns bool
	match a 'left'
		void then return maxonReturnTypeIsVoid(b)
		value(innerA) then return match b 'right'
			void gives false
			value(innerB) gives maxonTypesDenoteSame(innerA, b: innerB)
		end 'right'
	end 'left'
end 'maxonReturnTypesDenoteSame'

// How a diagnostic NAMES the parameter an argument met: by NAME at a direct call, by 1-based POSITION at
// an indirect one — a function TYPE's parameter names are documentation the parser discards
// (`Parser.readFunctionTypeParam`), which is also why `parseIndirectCall` passes arguments positionally.
// An EMPTY name is the indirect call's "there is no name", the same `EmptySourceText`-means-none convention
// `aggregateNameFor` answers with.
//
// ⚠ **IT IS CALLED ONLY FROM THE REPORTING ARMS, and that is a measurement rather than a preference.**
// Rendering the label up front and passing it in cost a `String.from` plus an interpolation on EVERY
// argument of EVERY call in the program — a per-argument allocation on a path that reports nothing almost
// every time. That is why the label arrives as its two pieces.
// ⚠ **THROUGH `displayParamName`, WHICH IS WHAT MAKES THE RECEIVER PRINTABLE.** `__self` is the IR's name
// for parameter 0 and appears nowhere in the author's program; `self` is the keyword they wrote. This label
// could not reach the receiver at all while `checkArgTypes` exempted it, so a bare `String.from` was
// harmless — the moment the exemption went, `'__self'` would have been quoted at every one of them. It is
// the same mapping E3019 already renders its receiver half through, asked here rather than restated.
function argParamLabel(paramName ByteArray, position ParamCount) returns String
	return "{position + 1}" if paramName.isEmpty() else quotedParamLabel(displayParamName(paramName))
end 'argParamLabel'

// How a NAMED parameter is quoted in a diagnostic. ⭐ Exported because the parser tier renders the same
// sentence about a COMPILER BUILTIN's parameter (`Queries.renderParseError`'s `builtinArgumentType` arm), and a
// builtin's parameters always have names — they are written in this compiler's own signature tables, so there
// is no positional fallback for it to choose between.
export function quotedParamLabel(paramName String) returns String
	return "'{paramName}'"
end 'quotedParamLabel'

// ⭐ **THE ARGUMENT-MISMATCH SENTENCE, STATED ONCE FOR THE FIVE SITES THAT REPORT IT.** What DECIDES a
// mismatch is deliberately five different rules — an aggregate IDENTITY asked three ways (a concrete
// parameter's, a `T`-typed formal's substituted type argument, a per-instance alias parameter's), a
// function SHAPE, and a scalar TAG — but what a READER is told is one sentence, and each site differs only
// in how it renders the two types it holds. Rendering is therefore all a caller passes.
//
// ⚠ Written out per site, the sentence had already DRIFTED, silently and in the way this project keeps
// meeting: three of the five hard-coded `'{paramName}'` where the other two asked `argParamLabel`. The two
// spellings agree today only because those three are reachable from DIRECT calls alone, where a parameter
// always has a declared name — a property of today's call graph, not an invariant. The day one of those
// rules serves an indirect call it would name the parameter `''`, and no test would say so.
function argTypeMismatchMessage(paramName ByteArray, position ParamCount, expected String, got String) returns String
	return argTypeMismatchSentence(argParamLabel(paramName, position: position), expected: expected, got: got)
end 'argTypeMismatchMessage'

// ⭐ **THE SENTENCE ITSELF, GIVEN THE LABEL** — exported for the SIXTH site, which is in another TIER: a
// COMPILER BUILTIN's argument mismatch is the PARSER's to raise (a builtin has no signature entry for
// `checkArgTypes` to consult, which is `ParseError.builtinArity`'s reason too) and is rendered in
// `Queries.renderParseError`. `builtin-type-checking.error-managed-file-open-read-int` pins
// `argument type mismatch for 'path': expected '__ManagedMemory', got 'int'` — the SAME sentence a user
// function's wrong argument gets, because it is the same fact. Written out again over there it would drift,
// which is exactly what the note above records this sentence already having done once, among five sites in
// ONE file.
export function argTypeMismatchSentence(label String, expected String, got String) returns String
	return "argument type mismatch for {label}: expected '{expected}', got '{got}'"
end 'argTypeMismatchSentence'

// ⭐ **THE SAME SENTENCE WITH THE ONE TAIL THAT IS NOT AN "EXPECTED/GOT" (P1.7a-existentials slice 1).** A
// value refused at an interface-typed position did not have the WRONG type — `NotRunnable` is exactly the
// type the author meant — it failed a RELATION, and naming the relation is what tells them the cure
// (`implements Runnable`) rather than a type to change. **The wording is the canonical corpus's, verbatim:**
// `specs/interface-dispatch.md`'s `dispatch-nonconforming-error` pins it.
//
// `what` — the head naming WHICH position is at fault — is the only part that differs, and it is a parameter
// for the reason the head is shared with `argTypeMismatchSentence` above: one rule DECIDES, so a reader must
// be told one sentence and not two spellings of it. At the argument position that head is the
// `argument type mismatch for <label>:` its sibling uses, which is what `argParamLabel`'s direct/indirect
// split serves; the RETURN position (P1.7a slice 2) names the function instead.
function nonConformingMessage(what String, conformer String, interfaceName String) returns String
	return "{what}: type '{conformer}' does not implement interface '{interfaceName}'"
end 'nonConformingMessage'

// The three answers `existentialWideningVerdict` gives. An enum (a scalar), so asking costs nothing at the
// two sites that ask; the two refusals are separate arms rather than one `no` because they are refused for
// unrelated reasons and each site words them differently.
enum ExistentialWideningVerdict
	widens
	floatHasNoValueHalf
	doesNotConform
end 'ExistentialWideningVerdict'

// ⭐⭐ **MAY A VALUE OF THIS TYPE CROSS INTO AN INTERFACE-TYPED POSITION? — THE VERDICT, ONCE, FOR BOTH
// POSITIONS THAT WIDEN.** A call ARGUMENT (`checkOneArgType`) and a `return` into an interface-typed return
// (`checkOneReturnedValue`, P1.7a slice 2) ask exactly the same two questions in exactly the same order, and
// they must never come to answer them differently — one gains its witness half in an adjacent hidden argument
// and the other in the secondary return register, which is a difference of TRANSPORT and of nothing else.
// Each site words its own sentence, because only the site knows what to call the place.
//
// ⭐ **A FLOAT IS REFUSED HERE AND NOT INSIDE THE CONFORMANCE DOOR, AND THAT IS DELIBERATE.** `float`
// declares the intrinsic `Comparable`/`Equatable`/`Hashable` conformances, so `valueWidensToInterface`
// answers TRUE and the program is well-typed by every rule these passes otherwise apply. What stops it is
// REPRESENTATION: the fat pointer's value half is a general-purpose machine word (it is what a dispatch hands
// the impl as its receiver, read out of an integer register by every conformer), and a float lives in a
// floating-point register — so the widening is a cross-register-file move that no `TargetOp` performs.
// MEASURED at the argument position: `use(c Comparable, other Comparable)` called with `2.5` reached the x64
// emitter and PANICKED there — `a register-to-register move from xmm0 to rcx crosses register files` — with
// no position and nothing in the message an author could act on. It is E2062's fact one widening position
// over: dictionary passing gives a type parameter and an existential the SAME opaque slot, so the same limit.
function existentialWideningVerdict(project Project, valueTag ValueTypeTag, valueNameId TypeNameId, interfaceName ByteArray) returns ExistentialWideningVerdict
	if valueTag == ValueTypeTag.float 'floatHasNoWayIntoTheFatPointer'
		return ExistentialWideningVerdict.floatHasNoValueHalf
	end 'floatHasNoWayIntoTheFatPointer'

	if not valueWidensToInterface(project, signatures: programSignaturesIn(project, asker: "existentialWideningVerdict"), valueType: maxonTypeOfTag(valueTag, nameId: valueNameId), interfaceName: interfaceName) 'doesNotConform'
		return ExistentialWideningVerdict.doesNotConform
	end 'doesNotConform'

	return ExistentialWideningVerdict.widens
end 'existentialWideningVerdict'

// The three answers `existentialSiteClaimVerdict` gives. `unresolvable` is NOT a shade of `disagrees`: the two
// are refused by one code because they are one fault (a claim the program cannot be shown to keep), and they
// are separate arms because only the caller can say what to do instead — an argument position can name the
// conformer that would fit, a return position can only send the author to the argument position.
enum ExistentialSiteClaimStatus
	agrees
	disagrees
	unresolvable
end 'ExistentialSiteClaimStatus'

// ⭐⭐ **THE DISAGREEMENT ITSELF — WHICH associated position, and the two spellings that met there.** A verdict
// with a payload rather than a bare enum like `ExistentialWideningVerdict`, because a refusal here must NAME
// both bindings (the whole complaint is that two spellings differ, and a sentence that showed only one would
// leave the reader to guess the other). Built only inside the `interfaceRef` branch of a widening whose callee
// actually claimed something, which is a vanishing fraction of any program's arguments.
type ExistentialSiteClaim
	export var status as ExistentialSiteClaimStatus
	export var associatedName as ByteArray
	export var siteBinding as ByteArray
	export var conformerBinding as ByteArray

	// ⭐⭐ **THE ROUTE A NESTED FAULT WAS FOUND DOWN, OR THREE EMPTY NAMES FOR ONE FOUND DIRECTLY (W59).** A
	// claim can fail one level below the interface the position is declared at — `Bag with (Integer, Cursor
	// with Integer)` claims something about the CURSOR a conformer binds, not about the conformer — and a
	// sentence that reported it as the outer interface's would name the wrong type twice: the wrong interface
	// ('Bag' where the fault is 'Cursor'), and the wrong binder ('UpBag' where it is the cursor `UpBag` bound).
	// MEASURED as exactly that pair of wrong nouns before these fields existed.
	//
	// EMPTY for a direct claim, which is the overwhelming majority, and the two sentence builders branch on
	// `heldRoute` being empty. That is the same statement `agreeing()` makes with its three empty names — a
	// name this claim has nothing to say about is written as no name, never as an invented one.
	export var heldRoute as ByteArray
	export var heldAt as ByteArray
	export var heldBinding as ByteArray

	// An agreeing claim names nothing: there is no disagreement to describe, and inventing spellings for the
	// fields would be exactly the sentinel this codebase refuses. Every reader gates on `status` first.
	static function agreeing() returns Self
		return Self{status: ExistentialSiteClaimStatus.agrees, associatedName: EmptySourceText, siteBinding: EmptySourceText, conformerBinding: EmptySourceText, heldRoute: EmptySourceText, heldAt: EmptySourceText, heldBinding: EmptySourceText}
	end 'agreeing'

	static function disagreeing(associatedName ByteArray, siteBinding ByteArray, conformerBinding ByteArray) returns Self
		return Self{status: ExistentialSiteClaimStatus.disagrees, associatedName: associatedName, siteBinding: siteBinding, conformerBinding: conformerBinding, heldRoute: EmptySourceText, heldAt: EmptySourceText, heldBinding: EmptySourceText}
	end 'disagreeing'

	// An unresolvable claim names no conformer binding, and that is not a missing field: the fault is that
	// nothing has fixed the SITE's side, so the conformer's was never reached and there is nothing to report
	// about it. The two sentences that word this refusal say so.
	static function unresolved(associatedName ByteArray, siteBinding ByteArray) returns Self
		return Self{status: ExistentialSiteClaimStatus.unresolvable, associatedName: associatedName, siteBinding: siteBinding, conformerBinding: EmptySourceText, heldRoute: EmptySourceText, heldAt: EmptySourceText, heldBinding: EmptySourceText}
	end 'unresolved'

	// The same verdict, re-anchored on the HELD position it was reached through — what
	// `heldPositionNestedClaim` returns once the recursion has answered. The verdict's own three names stay
	// exactly as the nested level found them; what this adds is where that level came from.
	export function throughHeldPosition(route ByteArray, at ByteArray, binding ByteArray) returns Self
		return Self{status: self.status, associatedName: self.associatedName, siteBinding: self.siteBinding, conformerBinding: self.conformerBinding, heldRoute: route, heldAt: at, heldBinding: binding}
	end 'throughHeldPosition'
end 'ExistentialSiteClaim'

// ⭐⭐ **DOES THE VALUE BEING WIDENED BIND WHAT THE SITE CLAIMED? — E3127, the discharge the E3125 DEFERRAL
// OWES (W58).** A use site writing `I with <Args>` normally restates a settled fact, and E3125 compares its
// argument against the one binding the conformances agreed on. That comparison has no meaning when the argument
// is the enclosing generic's own TYPE PARAMETER: `Taker with T` inside `type Box uses T` claims nothing about
// the program and something about each INSTANTIATION. So E3125 defers such a claim, and this is where the
// deferral is paid: at the WIDENING, the one place a concrete conformer and a site's claim actually meet, with
// the claim already substituted through the call's own instance by the caller.
//
// ⚠ **THE COMPARISON IS RAW, FOR E3125's MEASURED REASON.** Collapsing a ranged alias to its primitive would
// make `Integer` and a `Score = int(0 to 100)` one binding, and E3119's third recorded failure is exactly that
// pair: the actual 5000 answered 5000 through one conformer and RANGE-PANICKED through the other.
//
// ⚠ **A GENERIC CONFORMER'S BINDING IS RESOLVED THROUGH ITS OWN INSTANCE FIRST.** `type Array uses Element`
// conforming `Iterable with Element` records the binding as the string `Element` — its OWN parameter's name, not
// a type. Compared raw against a site's `Integer` that is a false disagreement, and it is the shape
// `stdlib/Array.maxon` is made of. `conformerBindingThroughInstance` reduces it before the comparison.
function existentialSiteClaimVerdict(project Project, signatures ProgramSignatures, siteInstance GenericInstanceId, conformerTag ValueTypeTag, conformerNameId TypeNameId, interfaceName ByteArray) returns ExistentialSiteClaim
	match lookupInterface(project.interfaces, name: interfaceName) 'base'
		notFound then return ExistentialSiteClaim.agreeing()
		found(iface) then return existentialSiteClaimAgainst(project, signatures: signatures, siteInstance: siteInstance, conformerTag: conformerTag, conformerNameId: conformerNameId, iface: iface)
	end 'base'
end 'existentialSiteClaimVerdict'

// The walk over the interface's associated positions, split from the lookup above so that one reads as the
// gate it is. The FIRST position that disagrees is the answer: a second sentence about the same widening would
// describe the same fault twice, and the cure for either is the same edit.
function existentialSiteClaimAgainst(project Project, signatures ProgramSignatures, siteInstance GenericInstanceId, conformerTag ValueTypeTag, conformerNameId TypeNameId, iface IrInterface) returns ExistentialSiteClaim
	let claimed = signatures.genericInstanceArgCount(siteInstance)
	for position in 0 upto iface.associatedTypeNames.count() 'eachAssociatedType'
		// A site that bound FEWER arguments than the interface declares claims nothing here — the same arity
		// gate `checkInterfaceInstantiationBindings` applies, and being short is `checkGenericInstance`'s report.
		if position >= claimed 'claimsNothingHere'
			continue
		end 'claimsNothingHere'

		// ⭐⭐ **A HELD POSITION IS NOT A RESTATEMENT OF A CONFORMER'S BINDING, SO IT IS NOT COMPARED WITH ONE** —
		// the same exemption `ConformanceCheck.checkOneAssociatedBinding` makes, for the reason stated there.
		// The site NAMES the interface the position is HELD at, and every conformer legitimately binds a
		// different concrete type there and is widened into it: `Bag with (Integer, IntegerCursor)` beside an
		// `UpBag` binding `Iter` to `UpCursor` is exactly right. **MEASURED: comparing them refused 8 correct
		// programs across `associated-type-held-at-an-interface` and `parameterized-existential`.** What a held
		// argument must agree with is checked whole-program instead — the holding by E3125, and every
		// conformer's binding against it by E3126.
		//
		// ⚠⚠ **WHAT IS EXEMPT IS THE ARGUMENT ITSELF, NOT THE ARGUMENTS *IT* CARRIES (W59).** `Bag with
		// (Integer, Cursor with Integer)` says two things: that `Iter` is held at `Cursor`, which is E3126's, and
		// that whatever cursor arrives binds `Cursor`'s OWN associated type to `Integer` — a claim no other door
		// checks. E3125 DEFERS it whenever the nested argument is the declaring type's parameter, which is the
		// shape `stdlib/Array.maxon`'s `Iterable with (Element, Iterator with Element)` has, and this deferral
		// used to be discharged by nothing at all. It cost nothing while E3119 forbade two `Iterator` conformers
		// from disagreeing; W59 lifts that for exactly the sites that make a claim, so the claim is now load-
		// bearing and is checked here. **MEASURED with it missing: a conformer binding `Iterable.Element` to
		// `Integer` and `Iter` to an iterator binding `Iterator.Element` to `String` compiled clean, and the
		// `String` came back through a slot typed `Integer` — exit 101 on the leak gate.**
		if signatures.associatedTypeIsHeldAt(iface.name, position: position) 'heldAtAnInterface'
			let nested = heldPositionNestedClaim(project, signatures: signatures, siteInstance: siteInstance, conformerTag: conformerTag, conformerNameId: conformerNameId, iface: iface, position: position)
			if nested.status != ExistentialSiteClaimStatus.agrees 'theNestedClaimIsNotKept'
				return nested
			end 'theNestedClaimIsNotKept'

			continue
		end 'heldAtAnInterface'

		let associatedName = try iface.associatedTypeNames.get(position) otherwise panic("existentialSiteClaimAgainst: associatedTypeNames.get OOB at {position} below the count this loop is bounded by")
		let siteBinding = signatures.instanceArgDisplayName(siteInstance, position: position)

		// ⚠ **AN ARGUMENT STILL OPAQUE AFTER SUBSTITUTION HAS NO ANSWER, AND SILENCE WOULD BE THE WRONG ONE.**
		// The caller substituted the site's instance through the call's own; a `typeParameter` that survived that
		// belongs to a declaration no instance here fixes — a `return` checked in the shared body's declaration
		// view, or a self-call inside it. Admitting the claim would leave exactly the hazard E3127 exists for.
		if maxonTypeTag(signatures.substitutedInstanceArg(siteInstance, position: position)) == ValueTypeTag.typeParameter 'noInstanceFixedIt'
			return ExistentialSiteClaim.unresolved(associatedName, siteBinding: siteBinding)
		end 'noInstanceFixedIt'

		if let conformerBinding = try conformerBindingThroughInstance(project, signatures: signatures, conformerTag: conformerTag, conformerNameId: conformerNameId, interfaceName: iface.name, position: position) 'thisConformerBindsIt'
			if not siteBinding.equals(conformerBinding) 'contradictsTheClaim'
				return ExistentialSiteClaim.disagreeing(associatedName, siteBinding: siteBinding, conformerBinding: conformerBinding)
			end 'contradictsTheClaim'
		end 'thisConformerBindsIt'
	end 'eachAssociatedType'

	return ExistentialSiteClaim.agreeing()
end 'existentialSiteClaimAgainst'

// ⭐⭐ **THE `with` ARGUMENTS A HELD POSITION'S ARGUMENT CARRIES, AGAINST THE CONFORMER THAT WILL FILL IT
// (W59).** The site wrote `Iter` held at `Cursor with Integer`; the conformer being widened binds `Iter` to
// some concrete cursor; the claim is that THAT cursor binds `Cursor`'s associated type to `Integer`. It is
// the same question one level down, so it is asked through the same door rather than by a second walk — the
// arity gate, the type-parameter gate and the held exemption are all stated once, in
// `existentialSiteClaimAgainst`, and the recursion descends into a strictly nested written instance, so it
// terminates on any program whose types are acyclic, which is what `TypeCycleCheck` guarantees.
//
// `agreeing()` for the two shapes that claim nothing: a site naming the BARE interface (`Bag with (Integer,
// Cursor)`), which carries no nested arguments to keep, and a conformer that declares no binding at this
// position at all — E3016's to report, and not a disagreement.
//
// ⚠ **THE ARGUMENT IS READ THROUGH `instanceArgHeldInstance` AND NOT OFF ITS TAG.** A held argument reaches
// the registry in THREE spellings depending on the order two `typealias` lines were swept in, and only one of
// them is a `genericInstance` — MEASURED: a tag test read `Iterable with (Integer, IntIterator)`'s second
// argument as a bare `named` and let the wrong-iterator program through, still leaking.
function heldPositionNestedClaim(project Project, signatures ProgramSignatures, siteInstance GenericInstanceId, conformerTag ValueTypeTag, conformerNameId TypeNameId, iface IrInterface, position ElementCount) returns ExistentialSiteClaim
	let nestedInstance = try signatures.instanceArgHeldInstance(siteInstance, position: position) otherwise 'theSiteNamesTheBareInterface'
		return ExistentialSiteClaim.agreeing()
	end 'theSiteNamesTheBareInterface'

	let binding = try conformerBindingThroughInstance(project, signatures: signatures, conformerTag: conformerTag, conformerNameId: conformerNameId, interfaceName: iface.name, position: position) otherwise 'thisConformerBindsNothingHere'
		return ExistentialSiteClaim.agreeing()
	end 'thisConformerBindsNothingHere'

	let heldAt = try signatures.associatedTypeHeldAt(iface.name, position: position) otherwise panic("heldPositionNestedClaim: '{String.from(iface.name)}' position {position} answered `associatedTypeIsHeldAt` and then held nothing — both doors read the one `associatedTypeHoldings` row")
	let associatedName = try iface.associatedTypeNames.get(position) otherwise panic("heldPositionNestedClaim: associatedTypeNames.get OOB at {position} below count {iface.associatedTypeNames.count()} — the caller's loop is bounded by that same list")
	return nestedClaimAgainstBinding(project, signatures: signatures, nestedInstance: nestedInstance, binding: binding, heldAt: heldAt).throughHeldPosition(associatedName, at: heldAt, binding: signatures.displaySpellingOfDeclaredName(binding))
end 'heldPositionNestedClaim'

// The conformer's binding is a RENDERED NAME and the verdict door names a conformer by `(tag, nameId)`, so
// this is the adapter between them — and it is an adapter rather than a second walk on purpose: reproducing
// `existentialSiteClaimAgainst`'s gates one level down is exactly how the outer and inner rules would come to
// disagree.
//
// The two spellings a binding can have are the two `conformerBindingThroughInstance` already knows: a
// canonical INSTANCE mint (`ArrayIterator_Integer`, which `renderedInstanceOfUnclaimedName` reverses and no
// declaration claims) and a nominal declaration. `agreeing()` for a name this program never interned, which
// is a name no conformance can be keyed by either.
function nestedClaimAgainstBinding(project Project, signatures ProgramSignatures, nestedInstance GenericInstanceId, binding ByteArray, heldAt ByteArray) returns ExistentialSiteClaim
	if let instance = try signatures.renderedInstanceOfUnclaimedName(binding) 'aCanonicalInstanceMint'
		return existentialSiteClaimVerdict(project, signatures: signatures, siteInstance: nestedInstance, conformerTag: ValueTypeTag.genericInstance, conformerNameId: instance, interfaceName: heldAt)
	end 'aCanonicalInstanceMint'

	let id = try project.typeNames.idOf(binding) otherwise 'noFileNamedIt'
		return ExistentialSiteClaim.agreeing()
	end 'noFileNamedIt'

	return existentialSiteClaimVerdict(project, signatures: signatures, siteInstance: nestedInstance, conformerTag: ValueTypeTag.named, conformerNameId: id, interfaceName: heldAt)
end 'nestedClaimAgainstBinding'

// What the value being widened binds `interfaceName`'s associated type at `position` to — the conformer's own
// answer (`conformerAssociatedBinding`), reduced through the conformer's INSTANCE when it has one.
//
// A conformance's `withArgs` are RENDERED SOURCE NAMES, so a GENERIC conformer records its own type parameter's
// spelling: `type Array uses Element implements Iterable with Element` binds the string `Element`. That names a
// type only once an instance says which, so an `Array with Integer` being widened resolves it to `Integer`
// before the comparison. `MapError.keyNotFound` when this type declares no such conformance or bound too few
// arguments — both E3016's to report, and neither a disagreement.
function conformerBindingThroughInstance(project Project, signatures ProgramSignatures, conformerTag ValueTypeTag, conformerNameId TypeNameId, interfaceName ByteArray, position ElementCount) returns ByteArray throws MapError
	if conformerTag != ValueTypeTag.genericInstance 'aNominalConformer'
		let conformerName = try project.typeNames.nameOf(conformerNameId) otherwise panic("conformerBindingThroughInstance: type-name id {conformerNameId} is not in the project interner — a value's name id is remapped project-global at merge (mergeArtifact)")
		return try conformerAssociatedBinding(project.conformances, typeName: conformerName, interfaceName: interfaceName, position: position)
	end 'aNominalConformer'

	let baseName = signatures.genericInstanceBaseName(conformerNameId)
	let declared = try conformerAssociatedBinding(project.conformances, typeName: baseName, interfaceName: interfaceName, position: position)
	if let paramPosition = try namePositionIn(signatures.structTypeParamsOf(baseName), name: declared) 'namesTheConformersOwnParameter'
		return signatures.instanceArgDisplayName(conformerNameId, position: paramPosition)
	end 'namesTheConformersOwnParameter'

	return declared
end 'conformerBindingThroughInstance'

// ⭐ **THE SITE'S CLAIM AS THE CALL SEES IT** — the callee's declared `Base with Args` with the CALLER's own
// generic instance substituted in, so `Taker with T` declared inside `type Box uses T` is `Taker with Integer`
// at a call on an `IntBox`. The same subject and the same substitution `paramTypeThroughCallInstance` uses on
// the parameter's type; this is the half of the parameter's declaration that type no longer carries.
//
// Returns the site UNSUBSTITUTED when the subject is not a concrete instance — a free function's call, or a
// self-call inside the shared body. That is not a silent pass: an argument still opaque afterwards is what
// `existentialSiteClaimAgainst` refuses as `unresolvable`.
function existentialSiteThroughCallInstance(signatures ProgramSignatures, func IrFunction, subject ValueId, siteInstance GenericInstanceId) returns GenericInstanceId
	let subjectTag = try func.valueTags.get(subject) otherwise panic("existentialSiteThroughCallInstance: value v{subject} of function '{String.from(func.name)}' has no recorded type — every SSA value must be minted through Parser.mintValue")
	if subjectTag != ValueTypeTag.genericInstance 'notACallThroughAConcreteInstance'
		return siteInstance
	end 'notACallThroughAConcreteInstance'

	let subjectGid = try func.valueNameIds.get(subject) otherwise panic("existentialSiteThroughCallInstance: genericInstance value v{subject} of function '{String.from(func.name)}' has no recorded GenericInstanceId — the two type columns are minted in lockstep")
	let substituted = signatures.substituteThroughInstance(MaxonType.genericInstance(siteInstance), id: subjectGid)
	// The substitution re-interns and hands back a `genericInstance`, or the SAME instance when no argument
	// moved. A different tag would mean it had rewritten an existential's identity into something else, which
	// only a defect in that door could do — so it is asserted rather than silently reinterpreted.
	if maxonTypeTag(substituted) != ValueTypeTag.genericInstance 'noLongerAnInstance'
		panic("existentialSiteThroughCallInstance: substituting instance {siteInstance} through {subjectGid} produced tag {maxonTypeTag(substituted).rawValue} — `substituteInstanceArgsThrough` re-interns a genericInstance and returns the original when nothing moved, so it can never leave this door")
	end 'noLongerAnInstance'

	return typeNameIdOf(substituted)
end 'existentialSiteThroughCallInstance'

// How BOTH refusals name the position at fault — the interface and the argument the site claimed for one of
// its associated types. Shared for `nonConformingMessage`'s reason: one rule decides, so a reader must be told
// one sentence and not two spellings of it. What differs between the positions is the head in front of it and
// the advice behind it, which is exactly where the two callers take over.
function existentialSiteClaimSentence(interfaceName ByteArray, claim ExistentialSiteClaim) returns String
	if claim.heldRoute.count() == 0 'foundAtTheDeclaredInterface'
		return "the existential type '{String.from(interfaceName)}' with its associated type '{String.from(claim.associatedName)}' bound to '{String.from(claim.siteBinding)}'"
	end 'foundAtTheDeclaredInterface'

	return "the existential type '{String.from(interfaceName)}' with its associated type '{String.from(claim.heldRoute)}' held at '{String.from(claim.heldAt)}', and that holding's own '{String.from(claim.associatedName)}' bound to '{String.from(claim.siteBinding)}'"
end 'existentialSiteClaimSentence'

// WHO contradicts the claim and with what — the other half of both refusals' sentences, split for the reason
// the half above is: one rule decides it, so the two positions must be told one sentence. A NESTED fault
// names the type the conformer bound at the held position, because that is the declaration whose `with`
// clause has to change; the conformer is still named first, because it is what the author wrote at the site.
function existentialSiteClaimContradiction(conformer String, claim ExistentialSiteClaim) returns String
	if claim.heldRoute.count() == 0 'foundAtTheDeclaredInterface'
		return "'{conformer}' binds '{String.from(claim.associatedName)}' to '{String.from(claim.conformerBinding)}'"
	end 'foundAtTheDeclaredInterface'

	return "'{conformer}' binds '{String.from(claim.heldRoute)}' to '{String.from(claim.heldBinding)}', which binds '{String.from(claim.associatedName)}' to '{String.from(claim.conformerBinding)}'"
end 'existentialSiteClaimContradiction'

// The `with` arguments the function's DECLARED RETURN named — off its signature, which is where the parser put
// them. `MapError.keyNotFound` for a name no signature is registered under, which the one caller answers with
// the shared empty column: "claims nothing" is exactly right for a function whose declaration was never seen.
function returnExistentialSitesOfFunc(project Project, name ByteArray) returns GenericInstanceIdArray throws MapError
	return (try project.funcSignatures.get(name)).returnExistentialSites
end 'returnExistentialSitesOfFunc'

// ⭐ **THE ARGUMENT POSITION'S HALF OF E3127.** Reached only once conformance is settled, and only for a callee
// whose signature actually recorded a claim for this parameter — `paramExistentialSiteAt` throws for every
// other parameter of every other function, which is nearly all of them, so the shared empty column costs one
// failed scan of an empty list.
function checkExistentialSiteClaimAtArgument(project Project, func IrFunction, paramExistentialSites ParamExistentialSiteArray, position ParamCount, argTag ValueTypeTag, argNameId TypeNameId, interfaceName ByteArray, paramName ByteArray, callInstanceSubject ValueId, callRange SourceRange, filePath FilePath)
	let declaredSite = try paramExistentialSiteAt(paramExistentialSites, position: position) otherwise return
	var signatures = programSignaturesIn(project, asker: "checkExistentialSiteClaimAtArgument")

	// ⛔⛔ **AN ARGUMENT THAT IS ALREADY AN EXISTENTIAL HAS NO CONFORMER TO ASK, AND AGAINST A DEFERRED CLAIM
	// THAT IS A WRONG ANSWER.** Everything below asks what the ARRIVING TYPE binds; a value held at an interface
	// answers nothing — which conformer is inside it is precisely what a fat pointer exists to not say.
	// For a CONCRETE claim that silence is safe and is why this is not a blanket refusal: E3125 has already
	// checked the claim against the one binding the conformances settled, and E3119 makes that binding unique,
	// so whatever conformer is inside binds it too. A DEFERRED claim has had neither check.
	// ⛔ **MEASURED on this tree**, with `function relay(t Taker) returns Integer` forwarding its bare `t` into a
	// `Box with String`'s `run(t Taker with T)`: it COMPILED, `Runner.take` read a `String` pointer as its
	// `Integer` argument, and the program died `Range check failed: value outside typealias 'ExitCode'` — E3119's
	// own recorded failure class, one indirection later, which is the hazard E3127 exists to stop.
	if argTag == ValueTypeTag.interfaceRef 'theArgumentIsItselfAnExistential'
		checkDeferredClaimAgainstExistentialArgument(project, signatures: signatures, declaredSite: declaredSite, argTag: argTag, argNameId: argNameId, interfaceName: interfaceName, paramName: paramName, position: position, callRange: callRange, filePath: filePath)
		return
	end 'theArgumentIsItselfAnExistential'

	let site = existentialSiteThroughCallInstance(signatures, func: func, subject: callInstanceSubject, siteInstance: declaredSite)
	let claim = existentialSiteClaimVerdict(project, signatures: signatures, siteInstance: site, conformerTag: argTag, conformerNameId: argNameId, interfaceName: interfaceName)
	let conformer = typeDisplayName(project, tag: argTag, nameId: argNameId, readerFilePath: func.sourceFilePath)
	let siteText = existentialSiteClaimSentence(interfaceName, claim: claim)
	let associated = String.from(claim.associatedName)
	match claim.status 'claim'
		agrees then break 'claim'
		disagrees then reportPositioned(project, code: ErrorCode.existentialWideningBindingDisagreement, message: "cannot widen '{conformer}' into {argParamLabel(paramName, position: position)}, which is declared at {siteText} — {existentialSiteClaimContradiction(conformer, claim: claim)}. A dispatch through this value is emitted against the binding the site claims and would reach an impl written for the other one. Write the binding the conformer declares, or widen a conformer that binds '{associated}' to '{String.from(claim.siteBinding)}'", line: callRange.line, column: callRange.column, filePath: filePath)
		unresolvable then reportPositioned(project, code: ErrorCode.existentialWideningBindingDisagreement, message: "cannot widen '{conformer}' into {argParamLabel(paramName, position: position)}, which is declared at {siteText} — '{String.from(claim.siteBinding)}' is a type parameter this call fixes to nothing, so what '{conformer}' would have to bind '{associated}' to is not known here. Call through a concrete instance of the declaring type, or write the binding the conformers declare", line: callRange.line, column: callRange.column, filePath: filePath)
	end 'claim'
end 'checkExistentialSiteClaimAtArgument'

// Was the callee's claim DEFERRED — i.e. is this the one shape an already-existential argument cannot be let
// through? Asked by putting the DECLARED, UNSUBSTITUTED site through the same verdict every other caller uses:
// `unresolvable` there is exactly "some position's argument is the declaring type's own parameter", which is
// E3125's deferral condition read back. Asking it this way rather than with a second predicate is what keeps
// the arity gate and the held-position exemption stated once.
//
// The `disagrees` arm cannot be reached and is not swept into the pass: the conformer lookup is keyed by the
// ARRIVING type's name, which here is an INTERFACE's, and no `type` may share a name with an interface (E3006).
function checkDeferredClaimAgainstExistentialArgument(project Project, signatures ProgramSignatures, declaredSite GenericInstanceId, argTag ValueTypeTag, argNameId TypeNameId, interfaceName ByteArray, paramName ByteArray, position ParamCount, callRange SourceRange, filePath FilePath)
	let claim = existentialSiteClaimVerdict(project, signatures: signatures, siteInstance: declaredSite, conformerTag: argTag, conformerNameId: argNameId, interfaceName: interfaceName)
	match claim.status 'declared'
		agrees then break 'declared'
		disagrees then panic("checkDeferredClaimAgainstExistentialArgument: the argument is held at interface '{String.from(interfaceName)}' and the claim reports a conformer binding — `conformerBindingThroughInstance` keys the lookup by the arriving type's name, which is that interface's, and E3006 forbids a `type` sharing it")
		unresolvable then reportPositioned(project, code: ErrorCode.existentialWideningBindingDisagreement, message: "cannot pass a value already held at the interface type '{String.from(interfaceName)}' as {argParamLabel(paramName, position: position)}, which is declared at {existentialSiteClaimSentence(interfaceName, claim: claim)} — '{String.from(claim.siteBinding)}' is a type parameter of the declaring type, so this site's binding was never settled against the conformances, and a value held at an interface does not say which conformer is inside it for the call to settle it against. Pass the concrete conformer, or declare {argParamLabel(paramName, position: position)} at '{String.from(interfaceName)}' with no `with` clause", line: callRange.line, column: callRange.column, filePath: filePath)
	end 'declared'
end 'checkDeferredClaimAgainstExistentialArgument'

// ⭐ **THE `return` POSITION'S HALF, AND THE ASYMMETRY WITH THE ARGUMENT IS THE WHOLE OF WHY `unresolvable`
// EXISTS.** A `return` is checked ONCE, against the shared body's DECLARATION view, so there is no call whose
// instance could fix an opaque claim — a `returns Taker with T` inside `type Box uses T` therefore has no
// answer here however the program instantiates `Box`, and the refusal points at the position that DOES have
// one. That is the same cure E3120 offers, for the same reason, one door over.
//
// A value that is ALREADY an existential is passed over: `function id(t TakerOfT) returns TakerOfT` hands back
// what it was given, no widening happens, and the claim it restates is its own.
function checkExistentialSiteClaimAtReturn(project Project, func IrFunction, returnExistentialSites GenericInstanceIdArray, valueTag ValueTypeTag, valueNameId TypeNameId, interfaceName ByteArray, retRange SourceRange)
	if valueTag == ValueTypeTag.interfaceRef 'alreadyWidenedElsewhere'
		return
	end 'alreadyWidenedElsewhere'

	let site = try returnExistentialSites.get(0) otherwise return
	var signatures = programSignaturesIn(project, asker: "checkExistentialSiteClaimAtReturn")
	let claim = existentialSiteClaimVerdict(project, signatures: signatures, siteInstance: site, conformerTag: valueTag, conformerNameId: valueNameId, interfaceName: interfaceName)
	let funcName = String.from(func.name)
	let conformer = typeDisplayName(project, tag: valueTag, nameId: valueNameId, readerFilePath: func.sourceFilePath)
	let siteText = existentialSiteClaimSentence(interfaceName, claim: claim)
	let associated = String.from(claim.associatedName)
	match claim.status 'claim'
		agrees then break 'claim'
		disagrees then reportPositioned(project, code: ErrorCode.existentialWideningBindingDisagreement, message: "cannot return '{conformer}' from '{funcName}', which is declared to return {siteText} — {existentialSiteClaimContradiction(conformer, claim: claim)}. A dispatch through the returned value is emitted against the binding the site claims and would reach an impl written for the other one. Write the binding the conformer declares, or return a conformer that binds '{associated}' to '{String.from(claim.siteBinding)}'", line: retRange.line, column: retRange.column, filePath: func.sourceFilePath)
		unresolvable then reportPositioned(project, code: ErrorCode.existentialWideningBindingDisagreement, message: "cannot return a value from '{funcName}', which is declared to return {siteText} — '{String.from(claim.siteBinding)}' is a type parameter of the declaring type, and a `return` is checked once against the shared body, where no instantiation has fixed it. Write the binding the conformers declare, or take the value as a PARAMETER instead, where the call's own instance resolves it", line: retRange.line, column: retRange.column, filePath: func.sourceFilePath)
	end 'claim'
end 'checkExistentialSiteClaimAtReturn'

// The float refusal's REASON, up to the point where the two positions diverge on what to do instead. Shared
// for `nonConformingMessage`'s reason, and split exactly where the advice stops being the same advice.
function floatHasNoValueHalfReason(interfaceName String) returns String
	return "{ExistentialIsFatPointerReason} whose value half is a general-purpose machine word, and a float travels in a floating-point register, so it has no way through. This is the same limit `float` has as a generic type argument (E2062). Wrap the float in a type that implements '{interfaceName}'"
end 'floatHasNoValueHalfReason'

// ⭐⭐ **THE `return` HALF OF THE WIDENING RULE (P1.7a slice 2, the return ABI).** A `returns <Interface>`
// function may hand back a CONFORMING concrete value, which gains its witness half in the secondary return
// register (`LowerMaxonToStd.emitRetOrErrorReturn`). The parser cannot decide whether it conforms — it holds
// no `Project`, and a conformer's `implements` clause is recorded when its OWN file is parsed — so it accepts
// the shape and this pass takes the verdict, through the SAME door the argument position asks.
//
// ⚠ **WITHOUT IT A NON-CONFORMER REACHES `ensureWitnessTable` AND PANICS THE COMPILER** in `witnessSlotImpl`,
// naming a slot no conformance ever filled: the parse-time tag check that used to refuse EVERY concrete
// return is exactly what this replaces, so nothing else is left standing between the two.
//
// The per-function gate is the DECLARED RETURN TYPE, tested before anything walks a body — an
// interface-returning function is a vanishing fraction of any program, and `liveOpIndices` builds an array
// per function it is asked about.
function checkReturnedValueTypes(project Project, module MaxonModule)
	for func in module.functions 'eachFunc'
		// A stdlib function no path from `main` reaches is dropped before the back end, so a diagnostic here
		// would name code the program does not contain — `checkCalls`' gate, for its reason.
		if project.stdlibFacts.unreachable.contains(func.name) 'notInTheProgram'
			continue
		end 'notInTheProgram'

		match func.maxonReturnType 'declaredReturn'
			void then break 'declaredReturn'
			value(inner) then checkReturnsAgainstInterface(project, module: module, func: func, declaredReturn: inner)
		end 'declaredReturn'
	end 'eachFunc'
end 'checkReturnedValueTypes'

// Every `return` of one function against its declared interface return type. A `ret` is usually a block
// TERMINATOR and occasionally a body op (a mid-block return), so the walk is `liveOpIndices` — the single
// home of the blockRefs → opRefs+terminator descent — rather than a scan of `opRefs` that would miss most of
// them, or of the append-only `module.ops` that would report against dead ops from an earlier pass.
function checkReturnsAgainstInterface(project Project, module MaxonModule, func IrFunction, declaredReturn MaxonType)
	if maxonTypeTag(declaredReturn) != ValueTypeTag.interfaceRef 'notAnExistentialReturn'
		return
	end 'notAnExistentialReturn'

	let interfaceName = interfaceNameOfType(declaredReturn, typeNames: project.typeNames)
	// ⭐ The `with` arguments the declared return named (W58), read ONCE per function rather than per `return`:
	// they are a property of the DECLARATION, and this walk visits every `ret` in the body. A function with no
	// registered signature — none today, since the parser records one per function it builds — claims nothing.
	let returnExistentialSites = try returnExistentialSitesOfFunc(project, name: func.name) otherwise sharedEmptyReturnExistentialSites
	for opIdx in module.liveOpIndices(func) 'eachOp'
		let op = try module.ops.get(opIdx) otherwise panic("checkReturnsAgainstInterface: opIdx {opIdx} from liveOpIndices not in module.ops")
		match op 'op'
			ret(value) then checkOneReturnedValue(project, func: func, value: value, interfaceName: interfaceName, returnExistentialSites: returnExistentialSites, retRange: project.opRanges.get(opIdx))
			// Every other op — a `retVoid` included, which a value-returning function's parser never emits —
			// hands nothing back through the return registers. The band range leans on the band-append
			// invariant: a newly appended op FAILS TO COMPILE here rather than being swept into an ignore arm.
			call then break 'op'
			literal then break 'op'
			retVoid to panicAbortValue then break 'op'
			// The error-flag encode hands nothing back through the return registers — its result is a routed edge's.
			errorFlagEncode then break 'op'
			// No service op is a `ret`, so none hands anything back through the return registers.
			serviceSpawn to serviceReplyCell then break 'op'
		end 'op'
	end 'eachOp'
end 'checkReturnsAgainstInterface'

// One `return`'s value against the interface its function promised — the verdict shared with the argument
// position, worded for this one. Anchored on the `return` itself, the line an author would change.
function checkOneReturnedValue(project Project, func IrFunction, value ValueId, interfaceName ByteArray, returnExistentialSites GenericInstanceIdArray, retRange SourceRange)
	let valueTag = try func.valueTags.get(value) otherwise panic("checkOneReturnedValue: value v{value} of function '{String.from(func.name)}' has no recorded type — every SSA value must be minted through Parser.mintValue")
	let valueNameId = try func.valueNameIds.get(value) otherwise panic("checkOneReturnedValue: value v{value} of function '{String.from(func.name)}' has no recorded type name — the two type columns are minted in lockstep")
	let displayName = String.from(interfaceName)
	match existentialWideningVerdict(project, valueTag: valueTag, valueNameId: valueNameId, interfaceName: interfaceName) 'widening'
		// The parameterized half, asked once conformance is settled — the argument position's twin (W58).
		widens then checkExistentialSiteClaimAtReturn(project, func: func, returnExistentialSites: returnExistentialSites, valueTag: valueTag, valueNameId: valueNameId, interfaceName: interfaceName, retRange: retRange)
		floatHasNoValueHalf then reportPositioned(project, code: ErrorCode.floatWidenedToExistential, message: "Cannot return a `float` from '{String.from(func.name)}', which is declared to return the interface type '{displayName}': {floatHasNoValueHalfReason(displayName)}, or declare the return type as `float`", line: retRange.line, column: retRange.column, filePath: func.sourceFilePath)
		doesNotConform then reportPositioned(project, code: ErrorCode.typeMismatch, message: nonConformingMessage("return type mismatch in '{String.from(func.name)}'", conformer: typeDisplayName(project, tag: valueTag, nameId: valueNameId, readerFilePath: func.sourceFilePath), interfaceName: displayName), line: retRange.line, column: retRange.column, filePath: func.sourceFilePath)
	end 'widening'
end 'checkOneReturnedValue'

// ⭐ **ONE ARGUMENT AGAINST ITS PARAMETER — the rule, stated once for both call shapes.** A DIRECT call
// reaches it per slotted argument (`checkArgTypes`) and an INDIRECT one per positional argument
// (`checkIndirectCall`); the two differ ONLY in what the parameter is CALLED, which is `argParamLabel`'s
// question and is asked only when something is actually reported.
//
// `preErasedAggregate` is the union/enum identity `resolveTypes` destroys: a STRUCT parameter keeps its
// `structRef(id)` through resolution so `aggregateNameFor` reads it straight off `paramType`, but a
// UNION/ENUM parameter collapses to bare `integer`, and only the carrier the parser stashed before that
// erasure still holds the name. **BOTH call shapes now have one** — a direct call off its signature
// (`FuncSignature.paramAggregateNames`), an indirect call off the callee's declared shape
// (`FunctionShape.paramAggregateNames`, filled by the identical parser-tier extraction) — so the rule below
// is nominal for both. It was structural for the indirect one until BATCH18-b, and the cost of that was not
// a missed refusal but a WRONG one; `checkIndirectCallArgs` carries the measurement.
//
// `declaredParamName` is the OTHER pre-erasure column — the SPELLING an author wrote, read only to PRINT
// (`FuncSignature.paramDeclaredNames`, user ruling 2026-08-04). Only a direct call has one: a function TYPE
// names its parameters nowhere, so an indirect call passes `EmptySourceText` and the refusal falls back to the
// resolved type's own display name.
//
// `callInstanceSubject` is the value whose CONCRETE generic instance fixes the callee's declaration-view
// parameter types — the same subject `checkArgTypes` reads for `paramTypeThroughCallInstance`. Only the
// function-shape arm below consults it, and it declines for any subject not tagged `genericInstance`, which
// is how the two callers that HAVE no instance pass their own honest subject rather than a sentinel.
//
// `paramExistentialSites` is the callee's sparse record of which parameters were declared at a PARAMETERIZED
// existential (W58) — the `with` arguments `instanceDenotedType` dropped on the way to `paramType`'s bare
// `interfaceRef`. Only the DIRECT-call caller has a `FuncSignature` to read one off; the witness-dispatch and
// indirect-call callers hand over `sharedEmptyParamExistentialSites`, which is their honest answer rather than
// a stand-in — an interface REQUIREMENT's formals are the interface's own spelling, and a function TYPE names
// its parameters' declarations nowhere at all (the same gap `declaredParamName` has at those two sites).
function checkOneArgType(project Project, func IrFunction, paramType MaxonType, preErasedAggregate ByteArray, declaredParamName ByteArray, paramName ByteArray, position ParamCount, argId ValueId, callInstanceSubject ValueId, paramExistentialSites ParamExistentialSiteArray, callRange SourceRange, filePath FilePath)
	let argTag = try func.valueTags.get(argId) otherwise panic("checkOneArgType: value v{argId} of function '{String.from(func.name)}' has no recorded type — every SSA value must be minted through Parser.mintValue")
	let argNameId = try func.valueNameIds.get(argId) otherwise panic("checkOneArgType: value v{argId} of function '{String.from(func.name)}' has no recorded type name — the two type columns are minted in lockstep")
	let paramTag = maxonTypeTag(paramType)

	// ⭐⭐ **AN INTERFACE-TYPED PARAMETER IS A WIDENING POSITION, NOT AN AGREEMENT ONE
	// (P1.7a-existentials slice 1).** A conforming concrete value gains a witness half here and becomes a fat
	// pointer, so `TypeClass.interfaceValue` deliberately agrees with nothing and the tag check below would
	// refuse every legal call. The verdict is `existentialWideningVerdict` — the ONE door BOTH widening
	// positions ask (the RETURN is the other since P1.7a slice 2) — and it is asked WHOLE-PROGRAM rather than
	// at the parse for the reason `checkLiteralInitConformance` states: a conformer's `implements` clause is
	// recorded when its own file is parsed, and the two files have no ordering.
	//
	// It returns rather than falling through: the aggregate-identity rule below compares two NOMINAL names and
	// would call every conformer a mismatch with its interface.
	if paramTag == ValueTypeTag.interfaceRef 'existentialParam'
		let interfaceName = interfaceNameOfType(paramType, typeNames: project.typeNames)
		let displayName = String.from(interfaceName)
		match existentialWideningVerdict(project, valueTag: argTag, valueNameId: argNameId, interfaceName: interfaceName) 'widening'
			// ⭐ **AND THEN THE PARAMETERIZED half of the same question (W58).** Conformance is the door's
			// original verdict and says nothing about `with` arguments — a `Runner` implements `Taker` whichever
			// type the site claims `Element` is. Asked only once conformance is settled, because a
			// non-conformer's bindings are not the fault worth reporting.
			widens then checkExistentialSiteClaimAtArgument(project, func: func, paramExistentialSites: paramExistentialSites, position: position, argTag: argTag, argNameId: argNameId, interfaceName: interfaceName, paramName: paramName, callInstanceSubject: callInstanceSubject, callRange: callRange, filePath: filePath)
			floatHasNoValueHalf then reportPositioned(project, code: ErrorCode.floatWidenedToExistential, message: "Cannot pass a `float` as {argParamLabel(paramName, position: position)}, which is declared at the interface type '{displayName}': {floatHasNoValueHalfReason(displayName)}, or take the parameter as a `float`", line: callRange.line, column: callRange.column, filePath: filePath)
			doesNotConform then reportPositioned(project, code: ErrorCode.typeMismatch, message: nonConformingMessage("argument type mismatch for {argParamLabel(paramName, position: position)}", conformer: valueTypeDisplayName(project, func: func, value: argId, tag: argTag, nameId: argNameId, readerFilePath: func.sourceFilePath), interfaceName: displayName), line: callRange.line, column: callRange.column, filePath: filePath)
		end 'widening'
		return
	end 'existentialParam'

	// ⭐ OPEN #54 Slice B/B2: a DIFFERENT named aggregate passed where one is declared shares the
	// scalar tag — two STRUCTS both `structRef`, two boxed UNIONS both erased to `integer` — so the
	// `checkDeclaredType` tag check below would ACCEPT it, and at a CONSUMING argument (a constructor
	// storing it into a field) it is then dropped under the DECLARED parameter type's destructor: a
	// wild free the tag check cannot see. Identity is the interned name, EXACT — an aggregate is never
	// a subtype of another. The comparison RULE is `namedAggregatesConflict`, shared verbatim with the
	// parser's coercion sites; only the name EXTRACTION is local. The ARG side always resolves live,
	// because an argument keeps its `named`/`structRef` tag (`aggregateNameFor` handles both).
	var expectedAggregate = aggregateNameFor(project, tag: paramTag, nameId: typeNameIdOf(paramType), readerFilePath: filePath)
	if expectedAggregate.isEmpty() 'erasedUnionParam'
		expectedAggregate = preErasedAggregate
	end 'erasedUnionParam'
	// ⚠ The ask is NOT gated on the DECLARED side being an aggregate. It used to be, and that skipped the
	// quadrant where a SCALAR parameter meets an AGGREGATE argument — which the tag check cannot refuse
	// either, so `takesInt(x Integer)` accepted a boxed union and did arithmetic on its payload word.
	// `tagAdmitsNoAggregate` is what keeps that safe for a `T` parameter, and `argAggregateCannotDecay` what
	// keeps it off a byte enum or a per-instance alias, both of which legitimately coerce to an int.
	if not expectedAggregate.isEmpty() or (tagAdmitsNoAggregate(paramTag) and argAggregateCannotDecay(project, tag: argTag, nameId: argNameId)) 'aggregateComparable'
		let gotAggregate = aggregateNameFor(project, tag: argTag, nameId: argNameId, readerFilePath: filePath)
		// ⭐⭐ **THE BYTE-ELEMENT BOUNDARY (R4.7) — the one place two DIFFERENT named aggregates denote one
		// record, and the reason the DECLARED-function door has to ask what the BUILTIN door already asks.**
		// shv2 has two byte element types on purpose (`ProgramSignatures.isBytePackedArrayInstance`), and a
		// builtin's `__ManagedMemory` parameter admits either because `Parser.valueIsByteArray` asks the
		// STRIDE. An ordinary declared parameter is compared NOMINALLY, so `stdlib/File.maxon`'s
		// `FileWriter.open(path __ManagedMemory)` refused the very `String.addressableBytes()` view its own
		// callers hand it — one fact, two answers.
		//
		// ⚠ It is asked THROUGH `aggregatesConflict` and not open-coded beside the name rule. This site was
		// the only one that asked it for a rung, and each of the seven that did not refused a legal program
		// (see `ProgramSignatures.byteBufferBoundaryAdmits`). The P1.6-C decay clause the shared door also
		// carries cannot fire here: it needs an EMPTY `expectedAggregate`, and an empty one only reaches this
		// line through `argAggregateCannotDecay`, which has already answered the same question wider.
		if programSignaturesIn(project, asker: "checkOneArgType").aggregatesConflict(expectedAggregate, expectedTag: paramTag, expectedNameId: typeNameIdOf(paramType), got: gotAggregate, gotTag: argTag, gotNameId: argNameId) 'aggregateArgMismatch'
			// ⚠ **THE OPAQUE TAIL BELONGS HERE TOO, AND FOR ONE FACT THERE IS ONE SENTENCE (W179).** A boxed
			// UNION parameter carries a nominal identity, so an opaque `T` meeting one is refused by THIS arm and
			// never reaches the tag rule below — measured on `takeMsg(t)` with a `union Message` formal. Same
			// fault, same reader, so the same explanation: `argMismatchWithOpaqueTail` appends nothing unless the
			// ARGUMENT is the opaque one, which leaves every nominal-vs-nominal refusal here spelled as before.
			reportPositioned(project, code: ErrorCode.typeMismatch, message: argMismatchWithOpaqueTail(argTypeMismatchMessage(paramName, position: position, expected: paramDisplayName(project, paramType: paramType, paramTag: paramTag, aggregate: expectedAggregate, declaredName: declaredParamName, argTag: argTag, readerFilePath: func.sourceFilePath), got: valueTypeDisplayName(project, func: func, value: argId, tag: argTag, nameId: argNameId, readerFilePath: func.sourceFilePath)), argTag: argTag), line: callRange.line, column: callRange.column, filePath: filePath)
			return
		end 'aggregateArgMismatch'
	end 'aggregateComparable'

	// ⭐ **A FUNCTION VALUE MEETING A FUNCTION-TYPED PARAMETER — the ARGUMENT door.** It is checked HERE and
	// not through a recorded `PendingFunctionTypeDoor` for the reason the parser's doors are recorded: the
	// two shapes must be compared whole-program and RESOLVED, and this pass already is both. `checkDeclaredType`
	// below answers `ok` for it (two `function` tags agree), which is how `use(intish)` reached the backend
	// with a callee returning an integer where the call site read the float return register.
	//
	// ⚠ **THE NAME IS READ IN THIS PASS'S OWN SPACE HERE, AND ITS SIBLING DOOR MUST NOT COPY THAT.**
	// `paramType` is a DECLARED type that `resolveTypes` already crossed into `project.typeNames`, so
	// `functionTypeNameOf` is the right reader for it. The substituted door
	// (`checkTypeParameterArgsAt`) holds an INDEX-space type instead and reads its name through the index —
	// see there. The two are one line apart in shape and a different interner apart in meaning.
	if paramTag == ValueTypeTag.function and argTag == ValueTypeTag.function 'functionArg'
		if checkFunctionArgShape(project, func: func, declaredShape: functionShapeThroughCallInstance(project, func: func, subject: callInstanceSubject, shape: requireFunctionShapeOf(functionTypeRegistryOf(project), name: functionTypeNameOf(functionTypeRegistryOf(project), nameId: typeNameIdOf(paramType)), side: "declared")), argId: argId, paramName: paramName, position: position, callRange: callRange, filePath: filePath) 'signatureMismatch'
			return
		end 'signatureMismatch'
	end 'functionArg'

	_ = checkArgAgainstDeclaredTag(project, argTag: argTag, argNameId: argNameId, declaredType: paramType, declaredAggregate: expectedAggregate, declaredName: declaredParamName, paramName: paramName, position: position, callRange: callRange, filePath: filePath)
end 'checkOneArgType'

// ⭐⭐ **A FUNCTION VALUE MEETING A FUNCTION-TYPED ARGUMENT POSITION — the comparison and its sentence, for
// BOTH doors that reach one.** Answers whether it REPORTED, so each caller stops on a refusal exactly as it
// already did.
//
// ⚠ **IT TAKES THE DECLARED SHAPE ALREADY RESOLVED, AND THAT IS THE WHOLE OF WHY IT IS NOT `(project,
// declaredType)`.** Its two callers hold that type in DIFFERENT INTERNERS — a concrete parameter's is
// project-space, a substituted type argument's is index-space — so a shared `id → name → shape` chain here
// would be exactly the door that hides a cross-space read. Each caller crosses on the side that owns its ids
// and hands over the answer; names travel between interners, ids never do
// (`ProgramSignatures.indexSpaceTypeName`).
//
// ⛔⛔ **THE SECOND CALLER IS WHY THIS IS SHARED, AND IT WAS A LIVE SILENT MISCOMPILE.** A generic instance's
// method takes its parameter as an opaque `T`, so `checkOneArgType`'s own arm — which keys on the PARAMETER
// being `function`-tagged — never sees it; the substituted route (`checkTypeParameterArgsAt`) judges a type
// argument by its NOMINAL identity, and a function type has none (`typeArgAggregateName` answers empty,
// deliberately and correctly — a function type's identity is its SHAPE, not a name). Both halves passed and
// the value fell through to the tag rule, where two `function` tags agree. MEASURED on a user generic:
// `Box with UnaryOp` accepting `OpBox.create(floatFn)`, whose `.held()` then called a float function through
// an int calling convention.
//
// ⚠ **`Project.maxon`'s door census recorded this position as REFUTED — *"the nominal half FIRES"* — and
// that is now corrected there.** It fires for every type argument that HAS a nominal identity, which is
// exactly the group a function type is not in.
function checkFunctionArgShape(project Project, func IrFunction, declaredShape FunctionShape, argId ValueId, paramName ByteArray, position ParamCount, callRange SourceRange, filePath FilePath) returns bool
	let gotShape = requireFunctionShapeOf(functionTypeRegistryOf(project), name: functionValueGoverningName(project, func: func, value: argId), side: "arriving")
	if functionShapesAgree(functionTypeRegistryOf(project), declared: declaredShape, got: gotShape) 'agree'
		return false
	end 'agree'

	reportPositioned(project, code: ErrorCode.typeMismatch, message: argTypeMismatchMessage(paramName, position: position, expected: formatFunctionShapeDisplay(declaredShape, typeNames: project.typeNames), got: formatFunctionShapeDisplay(gotShape, typeNames: project.typeNames)), line: callRange.line, column: callRange.column, filePath: filePath)
	return true
end 'checkFunctionArgShape'

// ⭐ **THE COERCION RULE ON ONE ARGUMENT, AND ITS FOUR WORDINGS — STATED ONCE FOR THE THREE SITES THAT
// ASK IT.** A concrete parameter asks it through `checkOneArgType` (a direct call's slotted argument, an
// indirect call's positional one), and a `T`-TYPED parameter asks it through `checkTypeParameterArgsAt`,
// which first substitutes the instance's concrete type argument for the opaque formal. The substitution is
// the only thing that differs; the verdict and every sentence it provokes are this function's, so
// `IntBox.create(1.5)` and the non-generic `takeInt(1.5)` cannot come to explain one rule two ways.
//
// `checkDeclaredType`, not `typesAgree` — an argument meeting its parameter is a COERCION SITE, and the
// symmetric rule cannot see a direction. A float and an int AGREE (they must, or `5 + 2.0` would not
// compile), so `takeInt(3.7)` passed this check and the float reached the x64 emitter as an f64 headed for
// a GPR argument register. The same rule now answers here, at the `return` and at both assignments.
//
// It ANSWERS the verdict rather than swallowing it, because a caller walking several arguments must stop
// at the first one it refused — one diagnostic per call, the same bound the aggregate arm above it keeps.
// ⚠ **THE PARAMETER ARRIVES AS ITS PIECES AND IS RENDERED ONLY INSIDE THE REPORTING ARMS**, which is
// `argParamLabel`'s discipline for `argParamLabel`'s measured reason: this runs on EVERY argument of EVERY
// call in the program, and `paramDisplayName` builds a `String`. The pieces are values the caller already
// holds, so passing them costs nothing where rendering them up front would cost an allocation per argument.
function checkArgAgainstDeclaredTag(project Project, argTag ValueTypeTag, argNameId TypeNameId, declaredType MaxonType, declaredAggregate ByteArray, declaredName ByteArray, paramName ByteArray, position ParamCount, callRange SourceRange, filePath FilePath) returns DeclaredTypeMatch
	let declaredTag = maxonTypeTag(declaredType)
	let verdict = checkDeclaredType(argTag, declared: declaredTag)
	match verdict 'declared'
		ok then break 'declared'
		mismatch then reportPositioned(project, code: ErrorCode.typeMismatch, message: argMismatchWithOpaqueTail(argTypeMismatchMessage(paramName, position: position, expected: paramDisplayName(project, paramType: declaredType, paramTag: declaredTag, aggregate: declaredAggregate, declaredName: declaredName, argTag: argTag, readerFilePath: filePath), got: typeDisplayName(project, tag: argTag, nameId: argNameId, readerFilePath: filePath)), argTag: argTag), line: callRange.line, column: callRange.column, filePath: filePath)
		// ⚠ **THE TWO ARMS BELOW SPELL THE PARAMETER BY ITS RESOLVED CLASS WORD AND NOT BY ITS DECLARATION,
		// AND THAT IS THE CANONICAL COROLLARY OF THE DISPLAY RULE RATHER THAN AN EXCEPTION TO IT.** Each is
		// ONE SENTENCE WITH SEVERAL DOORS, and every other door of each is a place with no parameter to name:
		// `specs/implicit-type-conversion.md` pins `cannot implicitly convert 'float' to 'int'` at a
		// `x Integer` PARAMETER and at the return, both field doors, the global and the local, all `'int'`;
		// `specs/first-class-functions.md` pins `which holds 'int'` at a `loc Integer` LOCAL, a global, a
		// field and a return. An argument door that answered `'Integer'` alone would make one rule read two
		// ways by which door the value entered — the defect `SlotMismatchVoice` records one tier down.
		//
		// The parameter is still NAMED, unlike the parser's three sites, because the reader's next
		// question is which argument — but the rule's own sentence is `implicitNarrowingMessage`'s,
		// shared verbatim, so the four sites cannot come to explain one rule four ways.
		narrowsFloatToInt then reportPositioned(project, code: ErrorCode.semanticUnsafeCast, message: "argument {argParamLabel(paramName, position: position)}: {implicitNarrowingMessage(typeTagName(argTag), targetType: typeTagName(declaredTag))}", line: callRange.line, column: callRange.column, filePath: filePath)
		// A FUNCTION VALUE passed to a NON-function parameter (P1.5-A1) — the argument twin of the
		// parser's assignment/return sites, sharing `FunctionValueMisuseSuffix` so all four explain one
		// rule one way. (Reached only through the whole-program signature the parser cannot see, which
		// is why the rule's argument arm lives here rather than at the call site.)
		functionIntoNonFunction then reportPositioned(project, code: ErrorCode.typeMismatch, message: "cannot pass a value of type 'function' as argument {argParamLabel(paramName, position: position)}, which holds '{typeTagName(declaredTag)}': {FunctionValueMisuseSuffix}", line: callRange.line, column: callRange.column, filePath: filePath)
	end 'declared'
	return verdict
end 'checkArgAgainstDeclaredTag'

// ⭐ **THE `mismatch` SENTENCE, PLUS THE ONE TAIL AN OPAQUE ARGUMENT NEEDS (W179).** `checkDeclaredType`
// answers one `mismatch` for two quite different faults: a value of the WRONG type (a `bool` where an `int` is
// declared), where the head already tells the reader everything; and a value of NO KNOWN type — an enclosing
// generic's type parameter at a concrete aggregate place — where the head is a contradiction on its face,
// because the author may have bound that parameter to exactly the declared type. The tail is
// `OpaqueValueMisuseSuffix`, stated once beside the rule that decides this, and appended only for the second
// group so the first keeps the corpus-pinned sentence verbatim (`argTypeMismatchSentence`).
function argMismatchWithOpaqueTail(sentence String, argTag ValueTypeTag) returns String
	if argTag != ValueTypeTag.typeParameter 'aConcreteWrongType'
		return sentence
	end 'aConcreteWrongType'

	return "{sentence}: {OpaqueValueMisuseSuffix}"
end 'argMismatchWithOpaqueTail'

// The interned name of the declared STRUCT or boxed UNION/ENUM a (tag, nameId) pair denotes, or
// `EmptySourceText` for anything that is not one — the SemanticCheck half of the OPEN #54 identity
// check, and the full twin of the parser's `aggregateNameOf`. It resolves against the MERGED
// `project.typeNames` (an arg's name id was remapped project-global at merge — mergeArtifact) rather
// than the file-local interner the parser reads, but the SHAPE is identical:
//
//   • `structRef` is ALWAYS a declared struct — its name, no registry lookup.
//   • `named` is a boxed union/enum EXACTLY when the signature index registered its name; a ranged-int
//     alias is `named` too and is numeric, NOT an aggregate (Slice B2 — an argument still carries its
//     `named` tag, unlike a PARAMETER, which `resolveTypes` erased to `integer` before this pass runs).
//   • every other tag names no aggregate.
//
// The "none" answer is `EmptySourceText`, which `namedAggregatesConflict` reads off `isEmpty()`.
// ⭐⭐ **IS THIS VALUE AN AGGREGATE THAT CANNOT DECAY TO A SCALAR? — the ARGUMENT-side companion to
// `tagAdmitsNoAggregate`, and the distinction that "does it NAME an aggregate?" does not draw.**
//
// `aggregateNameFor` answers a name for everything with a nominal identity, and two of those legitimately
// coerce to an integer parameter, so its non-empty answer cannot be the refusal test:
//
//   • a NON-BOXED enum — `enum Ascii` over byte values IS its backing integer, and
//     `byte-enum-comparison.enum-coerces-to-byte-arg` pins the coercion.
//   • a PER-INSTANCE ranged alias (`WA.Idx`) — a ranged int wearing an instance-qualified name, which
//     `per-instance-alias-decays-at-a-type-parameter-argument` and `cast-preserves-source` pin decaying.
//
// What genuinely cannot decay is a value whose scalar reading would be a POINTER or a record: a struct, a
// generic instance, a String/Character record, and a BOXED union/enum. That last one is the measured hole
// (`takesInt(Shape.circle(5))` returned arithmetic on the payload word), and boxed-ness is exactly the line
// between it and the byte enum beside it — the same line `ProgramSignatures.typeIsManaged` draws one tier
// down, for the same reason.
function argAggregateCannotDecay(project Project, tag ValueTypeTag, nameId TypeNameId) returns bool
	if tagIsStructRef(tag) or tag == ValueTypeTag.genericInstance or tag == ValueTypeTag.string or tag == ValueTypeTag.character 'alwaysARecord'
		return true
	end 'alwaysARecord'

	if tag != ValueTypeTag.named 'notNamed'
		return false
	end 'notNamed'

	let name = try project.typeNames.nameOf(nameId) otherwise panic("argAggregateCannotDecay: named id {nameId} is not in the project interner — a named value's name id is remapped project-global at merge (mergeArtifact)")
	if project.structTypes.contains(name) 'namedStruct'
		return true
	end 'namedStruct'

	if not project.enumTypes.contains(name) 'notEnum'
		// A ranged int/float alias, per-instance or plain: a scalar wearing a name.
		return false
	end 'notEnum'

	let layout = try project.enumTypes.get(name) otherwise panic("argAggregateCannotDecay: enumTypes.contains({String.from(name)}) is true but get failed")
	return layout.isBoxed()
end 'argAggregateCannotDecay'

// ⚠ **AND IT ASKS ON A FILE'S BEHALF, because a name TWO KINDS hold carries a nominal identity in one file
// and none in another.** `structTypes`/`enumTypes` are bare and whole-program, so once a `type ParsedInt`
// and a `typealias ParsedInt` in two files may both stand (`typeNamePairMayCoexist`) this answered
// `ParsedInt` for every file — while the PARSER's twin (`Parser.namedAggregateName`, guarded the same way)
// answered EMPTY inside the library. MEASURED: sixteen **E3005 `expected 'ParsedInt', got 'ParsedInt'`**
// inside `stdlib/Builtins.maxon`, one per call, the two tiers disagreeing about one name.
function aggregateNameFor(project Project, tag ValueTypeTag, nameId TypeNameId, readerFilePath FilePath) returns ByteArray
	if tagIsStructRef(tag) 'struct'
		return try project.typeNames.nameOf(nameId) otherwise panic("aggregateNameFor: structRef id {nameId} is not in the project interner — a structRef's name id is remapped project-global at merge (mergeArtifact)")
	end 'struct'

	// ⭐ **AN EXISTENTIAL IS NOMINAL IN ITS INTERFACE** — the whole-program twin of the parser's
	// `aggregateNameOf` arm, and it carries that arm's whole argument (see there for the measured wrong
	// answer an empty name produced). It is reached only where the PARAMETER is not itself an interface —
	// `checkOneArgType`'s existential arm returns before this — so what it answers for is an existential
	// handed to a CONCRETE place, which is refused by name rather than by the kind word `interface`.
	if tag == ValueTypeTag.interfaceRef 'existential'
		return try project.typeNames.nameOf(nameId) otherwise panic("aggregateNameFor: interfaceRef id {nameId} is not in the project interner — an interface name id is remapped project-global at merge (mergeArtifact)")
	end 'existential'

	// ⭐ A GENERIC INSTANCE IS A NOMINAL AGGREGATE, IDENTIFIED BY ITS COMPILED NAME (P1.7) — the twin of
	// the parser's `aggregateNameOf` arm, and it reads no interner at all: the id a `genericInstance`
	// carries is a whole-program `GenericInstanceId`, not a per-file name id. The compiled name is the
	// EXACT identity to compare on, because `checkTypeSymbolNamespace` has already refused (E3006) any
	// program in which two instances — or an instance and a declared type — compile to one name, so two
	// equal names here denote one instance in every program that reaches this pass.
	if tag == ValueTypeTag.genericInstance 'genericInstance'
		return programSignaturesIn(project, asker: "aggregateNameFor").canonicalInstanceName(nameId)
	end 'genericInstance'

	if tag != ValueTypeTag.named 'notNamed'
		return EmptySourceText
	end 'notNamed'

	let name = try project.typeNames.nameOf(nameId) otherwise panic("aggregateNameFor: named id {nameId} is not in the project interner — a named value's name id is remapped project-global at merge (mergeArtifact)")
	if (project.structTypes.contains(name) or project.enumTypes.contains(name)) and not programSignaturesIn(project, asker: "aggregateNameFor").aliasShadowsNominalFor(name, readerFilePath: readerFilePath) 'registeredAggregate'
		return name
	end 'registeredAggregate'

	// ⭐ A REGISTERED PER-INSTANCE ALIAS ("StrWrapper.Idx") is a nominal aggregate (P1.6-C) — the SemanticCheck
	// twin of the parser's `aggregateNameOf` arm, so a per-instance argument meeting a per-instance parameter
	// compares by name here exactly as it does at the parser's coercion sites. Read through the memoized
	// whole-program index (`queryProgramSignatures`), where the inner aliases live; a base-template or plain
	// ranged alias answers false and stays structural. Gated on the allocation-free `containsQualifier` so a
	// plain named argument (`Score`) — the overwhelming case — pays only a byte scan, not the index fetch.
	if containsQualifier(name) 'maybePerInstance'
		let signatures = programSignaturesIn(project, asker: "aggregateNameFor")
		// `CompilerOwnedDeclFilePath` for `aggregatesConflict`'s reason (N3): this twin is handed a NAME out of a
		// whole-program signature and has no reading file to scope a contested prefix by.
		if signatures.isPerInstanceAlias(name, readerFilePath: CompilerOwnedDeclFilePath) 'perInstanceAlias'
			return name
		end 'perInstanceAlias'
	end 'maybePerInstance'

	return EmptySourceText
end 'aggregateNameFor'

// ⭐⭐ **THE DISPLAY TWIN OF `aggregateNameFor`, AND THE WHOLE-PROGRAM HALF OF ONE RULE (user ruling,
// 2026-08-04): a diagnostic names a type the way the AUTHOR WROTE IT.** `aggregateNameFor` answers with the
// IDENTITY the checks compare on, and for a generic instance that identity is the canonical `Array_String` —
// a name no source line holds. The author wrote `typealias StringArray = Array with String`, and
// `specs/type-checking.md` pins `expected 'StringArray'`.
//
// Every other tag already answers with something written: a struct/interface/registered union by its declared
// name, a scalar by the primitive an author sees. So the instance arm is the whole difference, and everything
// else routes through the identity chain rather than re-deciding it.
//
// ⚠ **NOTHING MAY COMPARE TWO OF THESE.** Two `typealias`es legitimately spell one instance, so equal
// identities can render as different strings and vice versa — `aggregatesConflict` is still the only door that
// decides whether two types are one. This function is read BY diagnostics and by nothing else.
//
// ⚠ The parser tier's twin is `Parser.displayTypeNameOf`; the two exist for the reason `aggregateNameOf` and
// `aggregateNameFor` do (different tier, different interner), and both quote the instance name out of the one
// whole-program index, so they cannot spell a type two ways. **The twinning stops at the LOOKUP and the
// instance arm — the tail is `displayNameOfAggregate`, shared, because a tag and an already-resolved name
// belong to no tier.**
function typeDisplayName(project Project, tag ValueTypeTag, nameId TypeNameId, readerFilePath FilePath) returns String
	if tag == ValueTypeTag.genericInstance 'genericInstance'
		return String.from(programSignaturesIn(project, asker: "typeDisplayName").instanceDisplayNameIn(nameId, readerFilePath: readerFilePath))
	end 'genericInstance'

	// Its aggregate NAME when it has one (`BoxB`), else the scalar TYPE it actually is (`int` for a bare
	// integer meeting a union parameter).
	return displayNameOfAggregate(tag, aggregate: aggregateNameFor(project, tag: tag, nameId: nameId, readerFilePath: readerFilePath))
end 'typeDisplayName'

// ⭐⭐ **HOW THE *PARAMETER* SIDE OF AN ARGUMENT REFUSAL IS SPELLED — the display door's other half.** It
// cannot simply be `typeDisplayName` of the parameter's type, because `resolveTypes` has already run over a
// signature by the time this pass reads it and has erased two of the three things an author could have
// written: a boxed union/enum parameter and a RANGED alias parameter are both bare `integer` here. Each side
// therefore arrives with the carrier that survived the erasure —
//
//   • `aggregate`  — the pre-erasure union/enum IDENTITY (`FuncSignature.paramAggregateNames`), which is also
//                    what the mismatch was DECIDED on, so the sentence names the thing that was compared;
//   • `declaredName` — the pre-erasure SPELLING (`FuncSignature.paramDeclaredNames`), which is all that is
//                    left of `n Integer` once the alias has resolved away.
//
// ⚠ The instance arm comes FIRST and reads the type rather than `aggregate`, because for a generic instance
// `aggregate` holds the canonical identity (`Array_Integer`) and the author wrote `IntegerArray`.
//
// ⭐⭐ **THE RANGED-ALIAS ARM IS THE ONE THAT ASKS ABOUT THE *ARGUMENT*, AND THE CANONICAL CORPUS IS WHY.**
// Two canonical specs pin the SAME shape — a scalar argument at a parameter declared `x Integer`, over
// `typealias Integer = int(i64.min to i64.max)` — and they pin DIFFERENT spellings:
//
//   • `specs/type-checking.md`           `expected 'Integer', got 'String'`   (and `'Integer', got 'Point'`)
//   • `specs/implicit-type-conversion.md` `expected 'int',     got 'bool'`
//
// They are not in conflict; they are one rule seen from two sides, and the BOOTSTRAP implements it
// literally (`2-Parser.cs`: the branch printing `IrType.FormatAsSourceName(paramType)` is gated on the
// ARGUMENT being a struct/enum kind — and a `String` is a struct there — while a bare primitive argument
// falls through to the conversion path, which prints the class word). **A declared alias is worth printing
// when the other half of the sentence NAMES a type; when both halves are class words, naming one side
// `Integer` claims a nominal disagreement where the mismatch is purely one of class.** `tagAdmitsNoAggregate`
// is exactly that question and is already the compiler's one answer to it.
//
// ⚠ The gate is on THIS arm alone. The two arms above keep answering unconditionally because their
// fallback is useless: `typeTagName(genericInstance)` is the bare word `struct`, so `expected 'IntegerArray',
// got 'int'` (`specs/type-checking.md`, an `int` argument — a tag that admits no aggregate) would degrade to
// `expected 'struct'`. The ranged arm's fallback is `int`, which is the type.
function paramDisplayName(project Project, paramType MaxonType, paramTag ValueTypeTag, aggregate ByteArray, declaredName ByteArray, argTag ValueTypeTag, readerFilePath FilePath) returns String
	if paramTag == ValueTypeTag.genericInstance 'genericInstance'
		return typeDisplayName(project, tag: paramTag, nameId: typeNameIdOf(paramType), readerFilePath: readerFilePath)
	end 'genericInstance'

	if not aggregate.isEmpty() 'nominal'
		return String.from(aggregate)
	end 'nominal'

	if not declaredName.isEmpty() and not tagAdmitsNoAggregate(argTag) 'declaredAliasAgainstANamedArgument'
		return String.from(declaredName)
	end 'declaredAliasAgainstANamedArgument'

	return typeTagName(paramTag)
end 'paramDisplayName'

// Report a per-ARGUMENT call error anchored on the offending argument's own source
// span (from the call op's inline `argRanges`), so the diagnostic points at the bad
// `name:` label rather than the call site.
function reportArgError(project Project, code ErrorCode, message String, argRanges SourceRangeArray, argIndex ParamCount, filePath FilePath)
	let range = try argRanges.get(argIndex) otherwise panic("reportArgError: argRanges.get OOB at {argIndex}")
	reportPositioned(project, code: code, message: message, line: range.line, column: range.column, filePath: filePath)
end 'reportArgError'

// E3001 / E3002: `main` must exist and return ExitCode.
function checkMainFunction(project Project)
	if not project.funcReturnTypes.contains(MainFunctionName) 'noMain'
		reportDiagnostic(project, diagnostic: Diagnostic.create(ErrorCode.noMainFunction, message: NoMainMessage))
		return
	end 'noMain'

	let returnType = try project.funcReturnTypes.get(MainFunctionName) otherwise panic("checkMainFunction: contains(main) true but get(main) failed")
	if not returnsExitCode(returnType) 'wrongReturn'
		reportDiagnostic(project, diagnostic: Diagnostic.create(ErrorCode.mainWrongReturnType, message: MainWrongReturnMessage))
	end 'wrongReturn'
end 'checkMainFunction'

// True when a return type is exactly the resolved ExitCode type. A void return
// (no `returns` clause) is false — that is the M1-exercised E3002 case.
function returnsExitCode(returnType MaxonReturnType) returns bool
	return match returnType 'r'
		void gives false
		value(inner) gives isExitCodeType(inner)
	end 'r'
end 'returnsExitCode'

function isExitCodeType(t MaxonType) returns bool
	return match t 'r'
		exitCode gives true
		boolean gives false
		integer gives false
		float gives false
		named gives false
		unresolved gives false
		structRef gives false
		string gives false
		function gives false
		typeParameter gives false
		genericInstance gives false
		character gives false
		interfaceRef gives false
	end 'r'
end 'isExitCodeType'
