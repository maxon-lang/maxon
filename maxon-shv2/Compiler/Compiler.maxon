// Compiler — the build driver. Wires source loading → the query spine → the
// pipeline (resolveTypes, semanticCheck, lowerMaxonToStd) → the backend
// (buildBackend, writeExecutable).
//
// The mid + lowering passes run through `PassPipeline` (which owns the error
// gate) and end at a StdModule — shv2's last IR tier before the target dialect
// (see StdDialect: there is no MIR tier). The backend runs backend-direct (a
// CodeResult is not an IR module, so it does not fit the pass-dispatch model —
// mirrors v1's Phase-7 shape). On any failure the accumulated diagnostics are
// printed to stderr, so the exact `error EXXXX: ...` lines the spec compares
// against reach the user.

// Compile the files and/or directories `inputPaths` for `target`, returning the path of
// the produced executable. `outputOverride` (the `-o`/`--output` value, empty
// when unset) wins over the derived output name. `emitIr` (the `--emit-ir` flag)
// additionally writes the lowered Target IR beside the exe as `<output>.ir`, and
// `runtimeIrNames` (the `--emit-ir-runtime=` list) names the compiler-EMITTED
// functions that IR must also render — empty for every build that names none.
//
// The pipeline-driving body lives in `compileToCodeResult` so that the
// `verify-warm-rebuild` gate compiles through the EXACT same path — a determinism
// gate over a divergent code path would prove nothing. `compile` adds only the
// steps unique to a real build: loading the project, writing the executable, and
// (opt-in) writing the IR sidecar.
//
// Two failure channels: (1) file/IO errors (`fileNotFound`, `noSourceFiles`,
// `readError`) carry NO diagnostics and propagate straight to Main, which prints
// a specific message; (2) reported diagnostics (semantic/lexer) are printed inside
// `compileToCodeResult` and re-signaled as a FRESH `compileError`.
// `compile` owns the TOTAL: it is the only entry that spans a whole build, so it is
// the only one that can measure the denominator every phase's share is taken against
// (the warm-rebuild gate drives `compileToCodeResult` directly and never reports).
// Every phase timed below and in the passes/backend is a disjoint sub-interval of the
// wall time measured here, so they sum to at most the total, and whatever they leave
// over is printed as `unattributed` rather than absorbed — see CompileTimings.
export function compile(inputPaths MaxonSourcePathArray, target Target, outputOverride String = "", emitIr bool = false, metricsPath String = "", runtimeIrNames RuntimeFunctionNameArray, asyncTrace bool = false, debugStream bool = false) returns FilePath throws CompileError
	// Every trace event this compile emits is attributed to this unit. Derived from the project ROOT
	// — through the same `commonAncestorOf` the project itself is rooted at below, rather than from a
	// second reading of the command line — so the pre-project `load` bracket and everything after it
	// agree on which compile they are.
	let unit = traceUnitOf(try commonAncestorOf(inputPaths))
	setTraceUnit(unit)

	// ⭐⭐ **THE ONE PLACE A FAILED COMPILE CLOSES WHAT IT LEFT OPEN (A1v).** Four stages inside phase
	// brackets can throw — `load`'s project load, `deadFunctions`' E4015, `regalloc`'s E5001 and `link`'s
	// chunk-label refusal — and none of them reaches the `record*Delta` that would emit its span's END. The
	// split exists ONLY to give that drain one home: an END at each throw site would be the same fact
	// written once per site, forgotten by the next throwing exit exactly as it was by the last two (see
	// `PhaseProbe.openPhaseSpans`).
	//
	// The error is RE-THROWN unchanged, never flattened: `Main` distinguishes the file/IO cases
	// (`fileNotFound`/`noSourceFiles`/`readError`) from a reported `compileError` and prints a different
	// message for each, so a fresh `compileError` here would replace three specific messages with one wrong
	// one.
	//
	// `verifyWarmRebuild` drives `compileToCodeResult` directly and so does not pass through here. It needs
	// no drain of its own for the reason this function's header already gives for the TOTAL: it is the only
	// other whole-build entry, and a throw out of it ends the process with nothing left to mis-nest.
	return try compileMeasured(inputPaths, target: target, outputOverride: outputOverride, emitIr: emitIr, metricsPath: metricsPath, runtimeIrNames: runtimeIrNames, asyncTrace: asyncTrace, debugStream: debugStream, unit: unit) otherwise (e) 'compileFailed'
		closeOpenPhaseSpans(unit)
		throw e
	end 'compileFailed'
end 'compile'

// The build itself, from the whole-compile probe to the timing report — everything `compile` measures. It
// is a separate function for the single reason its caller states: one failure path to hang the trace-span
// drain on, rather than one per `try` in this body.
function compileMeasured(inputPaths MaxonSourcePathArray, target Target, outputOverride String, emitIr bool, metricsPath String, runtimeIrNames RuntimeFunctionNameArray, asyncTrace bool, debugStream bool, unit TraceUnit) returns FilePath throws CompileError
	let whole = PhaseProbe.begin(compilePhaseName(CompilePhase.load), unit: unit)

	// Loading starts the instant the compile does, so `whole` is also the `load` phase's
	// probe — a second set of reads here would sample the same instant.
	var project = try loadProject(inputPaths, target: target)
	project.asyncTrace = asyncTrace
	project.debugStream = debugStream
	recordPhase(project, phase: CompilePhase.load, probe: whole)

	// ⭐ RESOLVED BEFORE THE PIPELINE, AND THAT ORDER IS THE WHOLE POINT: the previous build's
	// artifacts are removed HERE, ahead of every step that can fail. See `discardPreviousOutput`.
	//
	// Bracketed as its own phase rather than left in `load`'s: these two touch the OUTPUT, `load`
	// reads the SOURCES, and a phase that absorbs a neighbour's cost is the defect CompileTimings'
	// header is about.
	let outputProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.prepareOutput)
	let outputPath = try resolveOutputPath(project, outputOverride: outputOverride)
	try discardPreviousOutput(project, outputPath: outputPath)
	recordPhase(project, phase: CompilePhase.prepareOutput, probe: outputProbe)

	let codeResult = try compileToCodeResult(project)

	let writeProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.writeExe)
	writeExecutable(codeResult, target: project.target, outputPath: outputPath)
	recordPhase(project, phase: CompilePhase.writeExe, probe: writeProbe)
	try requireOutputWritten(project, outputPath: outputPath)

	if emitIr 'emitIr'
		let irProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.emitIr)
		writeTargetIr(codeResult, outputPath: outputPath, runtimeIrNames: runtimeIrNames)
		recordPhase(project, phase: CompilePhase.emitIr, probe: irProbe)
	end 'emitIr'

	// Stamp the totals BEFORE anything reads them (every share divides by them, and both
	// reconciliation panics compare against them), and build the tables lazily behind
	// logDebug so a build without `--log=compiler:debug` pays only for the handful of
	// counter reads, never for formatting a row.
	let total = whole.elapsed()
	project.timings.total = PhaseCost.create(total.nanos, cpuTicks: total.cpuTicks)
	project.memory.total = total
	logDebug(LogCategory.compiler, message: function() gives compileTimingsReport(project.timings))
	logDebug(LogCategory.compiler, message: function() gives compileMemoryReport(project.memory))

	// `--metrics=<path>`: the machine-readable twin of those two tables. Written last, so
	// it can report the code size the degeneracy self-check needs (see MetricsEmit).
	if not metricsPath.isEmpty() 'metrics'
		writeMetrics(project, metricsPath: metricsPath, codeBytes: codeResult.code.count())
	end 'metrics'

	logInfo(LogCategory.compiler, message: function() gives "Wrote {codeResult.code.count()} bytes of code to {outputPath}")
	return outputPath
end 'compileMeasured'

// ⭐ **EVERYTHING THIS BUILD WOULD PUBLISH IS REMOVED BEFORE THE FIRST STEP THAT CAN FAIL.**
//
// Truncate-on-open does NOT cover this, and believing it does is the trap. `File.writeBinary` opens
// `CREATE_ALWAYS`, which truncates — but only at the instant the WRITER runs, and the writer is the
// LAST step of a SUCCESSFUL compile. A parse error, a semantic error, an E5001 register overflow or
// an encoder fault never reaches it, so the previous build's bytes survive untouched and keep
// answering. Anything that checks the BINARY rather than the build's exit code then gets a confident
// wrong answer from stale code, which is the one thing this compiler must never hand anybody.
//
// The `.ir` sidecar goes UNCONDITIONALLY, not only under `--emit-ir`: a build that does not produce
// one must not leave the previous one behind either, or dropping the flag silently preserves a stale
// answer beside a fresh exe — a mismatched pair that reads as a matched one.
//
// ⚠ AN OUTPUT THAT SURVIVES THE DELETE IS A HARD FAILURE, and that is what makes
// `requireOutputWritten` exact. On Windows a running (or read-only) executable cannot be removed,
// and the write that follows would fail for the same reason — which `writePe`/`writeElf`/`writeMachO`
// LOG AND SWALLOW, so the compile would go on to print "Wrote N bytes" and exit 0 over the stale
// binary. Refusing here means that once this returns, NOTHING is at `outputPath`; so its presence
// afterwards is proof the writer put it there, and its absence is proof the writer did not.
function discardPreviousOutput(project Project, outputPath FilePath) throws CompileError
	// Absence is the ordinary case (a first build), and `File.delete` signals it by throwing — so the
	// throw carries no information here. The existence re-check below is the only test that can tell
	// "it was not there" from "it would not go", which is the distinction that matters.
	try File.delete(outputPath.changeExtension(IrFileExtension)) otherwise ignore
	try File.delete(outputPath) otherwise ignore

	if File.exists(outputPath) 'undeletable'
		// ⭐ **IT NAMES THE LIKELY CAUSE, BECAUSE THE MECHANICAL ONE IS NOT ACTIONABLE.** "Locked or
		// read-only" is what the OS said and it is true; it is also indistinguishable, to whoever reads
		// it, from a genuinely broken build. In this tree the cause is the same one every time — a
		// `spec-test` or a `build` still running, holding its own image open — measured twice in one
		// session, and both times the reader's first hypothesis was a compiler defect. The compiler
		// cannot NAME the holder (that needs `RestartManager`/`NtQuerySystemInformation`, imported
		// nowhere here), but it does not need to in order to say which way to look.
		//
		// ⚠ AND IT SAYS THE STALE BINARY SURVIVED, which is the one fact `File.exists` has just proved
		// and the one the reader most needs: this function's whole contract is that a failed build
		// leaves NOTHING at `outputPath`, and this is the single branch where that fails. A `;`-chained
		// `build; suite` therefore runs the PREVIOUS binary and reports a false red — or a false green.
		// Measured during A1: a false red of exactly four tests.
		//
		// The deadline is QUOTED from `WedgeWatchdogMs`, never re-spelled: a prose "~5 min" here would
		// be a second copy of it, free to drift the moment the watchdog is retuned.
		//
		// ⚠⚠ AND IT IS ATTACHED TO THE ONE HOLDER IT ACTUALLY BOUNDS. `WedgeWatchdogMs` lives in the
		// spec pool's dispatch loop and bounds exactly that loop; a plain `maxon-shv2 build` runs under
		// no deadline of any kind. This message names TWO possible holders, so a deadline stated over
		// both of them is false for one — and falsely reassuring in the worse direction, because it
		// tells the reader to WAIT. This row's own second incident is the counterexample: a stray
		// `build --emit-ir` held the binary for ~30 minutes, a hundredfold past the number quoted here,
		// and nothing was ever going to end it. So the two holders get two different sentences: the one
		// that self-limits says so with the constant, and the one that does not says THAT.
		let likelyCause = "The likeliest cause is that it is still running — a spec-test or an earlier build in this tree that has not exited. A spec-test that has stopped making progress aborts itself after {formatSeconds(WedgeWatchdogMs)} and releases the file; a stalled build is bounded by nothing and has to be ended by hand. If no process holds it, clear the read-only flag."
		reportDiagnostic(project, diagnostic: Diagnostic.create(ErrorCode.binaryOutputNotReplaceable, message: "could not remove the previous build output at {outputPath} — it is locked or read-only, so this build cannot replace it, and the PREVIOUS build's binary is still in place and will answer anything you run next. {likelyCause}"))
		try refuseCompile(project)
	end 'undeletable'
end 'discardPreviousOutput'

// The backend claimed to have written the executable; check that something is actually there.
//
// `discardPreviousOutput` emptied this path before the compile started, so this is not a heuristic —
// it is an exact reading of whether the writer produced a file. It exists because the four backend
// writers report a failed `File.writeBinary` by LOGGING it and returning, which left `compile` free
// to announce "Wrote N bytes" and exit 0 while nothing had been written. Measured: with the output
// made read-only, a build printed `[BIN] ERROR: Failed to write PE file`, then `Wrote 1512 bytes of
// code`, then `Compiled -> …`, and exited 0 over the previous build's binary.
function requireOutputWritten(project Project, outputPath FilePath) throws CompileError
	if File.exists(outputPath) 'written'
		return
	end 'written'

	reportDiagnostic(project, diagnostic: Diagnostic.create(ErrorCode.binaryOutputNotWritten, message: "the backend produced no file at {outputPath} — the write failed (the writer logged the reason above)"))
	try refuseCompile(project)
end 'requireOutputWritten'

// ⭐ **WHAT A REFUSED COMPILE DOES, WRITTEN ONCE.** Five sites refuse a build after accumulating
// diagnostics — the two output-path checks above, the name-index refusal, the pipeline gate and the backend
// gate — and each carried its own copy of these two lines plus its own retelling of the second one's reason.
//
// ⚠ **A FRESH THROW, NEVER A RETHROW OF THE CAUGHT OBJECT.** Re-throwing the error a `try … otherwise`
// caught miscompiles under the C# runtime's refcount path (a NULL incref on the rethrow), whereas a fresh
// throw of the same arm propagates cleanly. That is the fact this function exists to hold in one place.
function refuseCompile(project Project) throws CompileError
	printDiagnostics(project)
	throw CompileError.compileError
end 'refuseCompile'

// Write the lowered Target IR (via `printTargetModule`) beside the produced exe
// as `<output>.ir`, for `build --emit-ir` and the spec runner's fragment capture.
// This is a diagnostic side output that runs ONLY on the opt-in flag, so a plain
// `build` emits exactly what it did before. A write failure is logged and
// swallowed — mirroring `writePe`, which treats the executable write the same way
// — because the IR sidecar is diagnostic, never a build gate.
//
// The emitted runtime — the entry stub `mrt_start`, the allocator, the `__str_*`/
// `__managed_*` families — is invariant scaffolding, so it is excluded and both the
// fragment and `--emit-ir` show the program's own functions. `runtimeIrNames`
// (`--emit-ir-runtime=`) is how a caller asks for a NAMED one of those bodies
// anyway: it is the only route an emitted body has to a golden, and it is per-build
// so no fragment that does not ask for one moves a byte. See `printTargetModule`.
//
// The CHUNKS ride along for the same list's sake: a hand-assembled runtime piece has no `IrFunction`
// to print, so `printTargetModule` renders its assembled bytes instead — and this is the only place
// that holds both the module and the chunks it was encoded into.
function writeTargetIr(codeResult CodeResult, outputPath FilePath, runtimeIrNames RuntimeFunctionNameArray)
	let irPath = outputPath.changeExtension(IrFileExtension)
	let irText = printTargetModule(codeResult.targetModule, globalData: codeResult.globalData, runtimeNames: runtimeIrNames, codeChunks: codeResult.codeChunks)

	try File.writeText(irPath, content: irText) otherwise 'writeErr'
		logError(LogCategory.binary, message: function() gives "Failed to write Target IR to {irPath}")
		return
	end 'writeErr'

	logInfo(LogCategory.compiler, message: function() gives "Wrote Target IR to {irPath}")
end 'writeTargetIr'

// Create a project rooted at `inputPaths`' common ancestor and register every source file the
// caller named with the query database — the shared "load" step before the pipeline runs.
// Factored out so `build` and the warm-rebuild gate load a project identically
// (the gate compiles the same input into several independent fresh projects).
//
// File/IO errors (`fileNotFound`, `noSourceFiles`, `readError`) carry NO
// diagnostics and propagate straight to the caller, which prints a specific
// message. `loadSourceFiles` is what raises them.
export function loadProject(inputPaths MaxonSourcePathArray, target Target) returns Project throws CompileError
	// The checkout's `stdlib/` is found BEFORE the project exists, because the project carries it to
	// the loader below. Nothing after the load asks where `stdlib/` is — a later pass asks about a
	// FUNCTION (`isStdlibFunction`), which is answered from a set the loader already built.
	var project = createProject(try commonAncestorOf(inputPaths), target: target, stdlibDir: try locateStdlibDir())
	try loadSourceFiles(project, paths: inputPaths)
	// AFTER the user's own sources — so a directory build's output name still derives from a user
	// file (not from a stdlib module), and an empty user project still fails with `noSourceFiles`
	// above rather than compiling only stdlib.
	try loadStdlibSources(project)
	return project
end 'loadProject'

// Drive the query spine + mid/lowering pipeline + backend for an already-loaded
// `project`, returning the emitted `CodeResult` (NOT yet written to disk). This is
// the single compile path both `compile` (which then writes the executable) and
// `verifyWarmRebuild` (which byte-compares two independently-produced CodeResults)
// route through — no duplicated pipeline-driving code.
//
// The mid + lowering pipeline owns one of the three error gates below: it throws once a pass
// (semanticCheck) reports a diagnostic. What each gate then DOES is `refuseCompile`'s, in one place
// (including the reason it must be a fresh throw rather than a rethrow).
export function compileToCodeResult(project Project) returns CodeResult throws CompileError
	// ⚠ `var`, not `let`: `installManagedGlobalInit` below APPENDS to this module (P1.7 slice 2a). It is the
	// memoized `queryAllModule` result and mutating it in place is the established discipline here —
	// `resolveTypes` already rewrites its signatures — which is exactly why `verifyWarmRebuild` compiles
	// each of its probes into its OWN fresh `Project` (see that file's mutate-the-memo header).
	var module = try queryAllModule(project)

	// ⭐ **FUNCTION-VALUE MERGE SIGNATURE AGREEMENT (P1.5 #81) — HERE, before the pipeline.** Every
	// function-value ternary/match recorded its arms' names at parse; now that `queryAllModule` has merged
	// every file's `funcSignatures`, the arms are compared whole-program — catching a forward-referenced or
	// cross-file mismatch a same-file check could not. It runs BEFORE the pipeline's `resolveTypes` so the
	// diagnostic can print the source alias names (`Integer`) that resolution erases to `int`. Any diagnostic
	// it emits is caught by the pipeline's own error gate below (after `resolveTypes`), exactly as an
	// accumulated parse diagnostic is.
	//
	// ⭐ **THE FIRST OF `checkDeclarations`' TWO BRACKETS, AND THE SPLIT IS FORCED BY THE ORDER.**
	// `queryProgramSignatures` runs between this check and the other five, and it owns the
	// `signatures` phase — so one bracket spanning all six would swallow that phase whole and
	// double-count it. `addPhaseCost` accumulates, so two disjoint intervals report as one row.
	let mergeCheckProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.checkDeclarations)
	checkValueMergeSignatures(project)
	recordPhase(project, phase: CompilePhase.checkDeclarations, probe: mergeCheckProbe)

	// ⭐ **`implements`-CONFORMANCE CHECKING (P1.7a slice 1) — HERE, before the pipeline.** It reads the
	// still-UNRESOLVED merged signatures so its E3016 message can print the source type spellings
	// (`Integer`, `Float`, `void`) that `resolveTypes` erases — the same reason `checkValueMergeSignatures`
	// runs here. Any E3015/E3016 it records is caught by the pipeline's error gate after `resolveTypes`.
	// ⚠ `var`, because the index MEMOIZES: `mangleGenericInstance` derives each instance's compiled name
	// on first ask and keeps it (`CompiledInstanceNameMap`), and every pass below asks. One binding, so
	// the derivation is shared by all of them rather than repeated per pass.
	//
	// ⭐ **BOUND HERE, ABOVE `checkConformance`, AND IT COSTS NOTHING TO MOVE IT UP.** The query is memoized
	// and `queryAllModule` above has already forced it — a `Parser` is CONSTRUCTED with the index it sweeps
	// into, so no file can have been parsed without it. What needs it here is the conformance check: a method
	// typed by a generic INSTANCE has no identity outside this index (`canonicalInstanceName`), and rendering
	// one without it spelled `Array with Integer` and `Array with String` as the same word.
	var signatures = try queryProgramSignatures(project)

	// The second of `checkDeclarations`' two brackets — see the first, above `checkValueMergeSignatures`.
	let declCheckProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.checkDeclarations)

	checkConformance(project, module: module, signatures: signatures)

	// ⭐ **`<Type> from "…"` NEEDS `implements InitableFromStringLiteral`** — checked right beside the
	// conformance pass it reads the same store as, and for the same reason it sits before the pipeline: its
	// E3005 is caught by the pipeline's error gate after `resolveTypes`.
	checkLiteralInitConformance(project)

	// ⭐ LAY OUT THE `.data` SECTION — once per compile, and HERE rather than inside
	// `queryProgramSignatures`.
	//
	// ⚠ That placement is the whole cost story. `queryProgramSignatures` is a whole-program query
	// sitting UNDER a per-file one, so it is ASKED once per file; doing O(globals) work inside it
	// would be O(files × globals), the exact shape of the two quadratics this query has already
	// grown and had removed (ARCHITECTURE's warning on it). The query is memoized, so the ARENA is
	// built once — but the layout is not the arena's business anyway: it is a BACKEND fact (offsets,
	// an image, a section), and it belongs at the one point that runs once and knows a backend is
	// about to run.
	//
	// It REBUILDS rather than appends, so it is idempotent: `verifyWarmRebuild` compiles the same
	// project twice, and a layout that accumulated would double every slot on the second pass.
	// Same discipline as `resetMergeTargets` — the arena is the source of truth, the derived table
	// is rebuilt from it.
	// ⭐ **WHERE-CONSTRAINT VALIDATION (P1.7a slice 2a — E3017) — HERE, after the instances are interned.**
	// Every `Box with Foo where T is Digest` instantiation is checked: `Foo` must declare `implements Digest`,
	// else E3017 anchored on the `typealias`. It reads the interned generic instances (`queryProgramSignatures`)
	// and the declared conformances (`checkConformance` already validated them), so it runs after both. Any
	// E3017 it records is caught by the pipeline's error gate, exactly as an E3016 is.
	// ⭐ **A CYCLIC GENERIC ALIAS IS REFUSED FIRST (P1.7, E3091)** — before the two checks below and before
	// the pipeline. An alias whose type arguments lead back to it denotes an INFINITE type, so every later
	// reader (the where-constraint check, the compiled-name space, the argument identity read) would be
	// asking questions of a type that does not exist. Refusing here is what lets all of them assume it does.
	checkGenericAliasCycles(project, signatures: signatures)

	// ⭐ **A RECURSIVE TYPE IS REFUSED (E4014) — AFTER the alias check above, and for its reason one level
	// up.** `specs/ownership.md` forbids a type that transitively contains itself through struct fields,
	// union associated values or container element types, because a drop cascade over a cyclic type graph
	// has no finite order. It reads the interned instances (`queryProgramSignatures`) and the merged
	// declarations (`queryAllModule`), which are exactly the two halves its graph joins; any E4014 it records
	// is caught by the pipeline's error gate, exactly as an E3017 is.
	checkTypeReferenceCycles(project, signatures: signatures)

	checkWhereConstraints(project, signatures: signatures)

	// ⭐ **THE COMPILED TYPE-NAME NAMESPACE (E3006) — HERE, for `checkWhereConstraints`'s two reasons.**
	// Every instantiation is interned by now (`queryProgramSignatures`) and every declaration is merged
	// (`queryAllModule`), which are exactly the two halves it compares: a generic instantiation compiles
	// to a name (`Box with String` ⇒ `Box_String`) that a declared `type Box_String` also claims, and
	// every per-type symbol the backend emits is derived from it. Any E3006 it records is caught by the
	// pipeline's error gate, exactly as an E3017 is.
	checkTypeSymbolNamespace(project, signatures: signatures)

	recordPhase(project, phase: CompilePhase.checkDeclarations, probe: declCheckProbe)

	// The ordinal guards' bracket, OUTSIDE the well-formedness gate below, so the phase reports on
	// every compile: a row that vanished for a failing program would be indistinguishable from a
	// phase that cost nothing.
	let ordinalProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.verifyOrdinals)

	// ⭐⭐ **THE BUILTIN-ERROR ORDINAL CLAIMS — ALL OF THEM, HERE, AND NOT SCATTERED ACROSS THE
	// RUNTIME INSTALLERS THAT TRANSCRIBE THEM (A1s).**
	//
	// ⛔⛔ **THERE IS NO COUNT IN THIS HEADER, AND THAT IS THE THIRD TIME OF ASKING.** It read *"SEVEN
	// FAMILIES, SIX CALLS"*, and its own next sentence recorded the previous correction — *"this line said
	// SIX while the two comments below already numbered `StringError` the sixth and `MapError` the seventh —
	// the count and the ordinals in one block, disagreeing."* Both numbers were stale AGAIN by the time the
	// enum-lookup family arrived: W49 wave 3 retired `StringError`'s claim (the note below survives), leaving
	// **five** calls over **six** families, and neither figure was decremented. A count of the lines directly
	// beneath it is a fact written twice, which is this project's signature bug wearing a tally's clothes.
	//
	// ⇒ **THE RULE, WHICH DOES NOT ROT:** one call per family that TRANSCRIBES its enum's ordinals as
	// literals, except that a family whose runtime shares another's claims through it (`ArrayError` and
	// `__ManagedMemoryError` are both `verifyManagedMemoryRuntimeOrdinals`' — see its header) is one call for two.
	// A family that stops transcribing loses its call and keeps a note saying why, as `StringError` did.
	//
	// Each family's runtime transcribes its enum's ordinals as literals, and each holds them to the
	// declaration on every compile (`Project.BuiltinErrorOrdinalCheck` — drift silently reroutes every
	// handler arm). They used to run from four `install*Runtime` heads plus one free function; three of them
	// now read a PARSED declaration out of `stdlib/Builtins.maxon` and so need the `Project`, and the
	// installs run AFTER the pipeline where a diagnostic would have no gate left to fail against. Here they
	// have both: `queryAllModule` has merged every declaration, and the pipeline's error gate below turns an
	// E4016 into a failed build with no binary written.
	//
	// ⚠ **NOT ON A PROGRAM THAT IS ALREADY FAILING (A1s wave 2).** A file whose parse failed merged none of
	// its declarations, so `stdlib/Builtins.maxon` failing to parse leaves the three DECLARED families
	// absent — and each would then report an E4016 saying the module was not loaded, on top of the real
	// diagnostic that says why. MEASURED while sabotaging the shadow guard with a deliberately malformed
	// addition to that module: one E3058 followed by two E4016s about a module the compile plainly HAD.
	// It is the refusal `checkTypeSymbolNamespace` and `checkGenericAliasCycles` above make, for the same
	// reason: a check whose inputs are half-built cannot produce a verdict worth reading.
	if not projectHasErrors(project) 'wellFormedSoFar'
		verifyManagedFileOrdinals(project)
		verifyManagedDirectoryOrdinals(project)
		verifyManagedMemoryRuntimeOrdinals(project)
		verifyDivisionByZeroOrdinals(project)
		// ⚠ **`StringError` WAS THE SIXTH AND IS NO LONGER CHECKED, BECAUSE NOTHING TRANSCRIBES ITS ORDINALS
		// ANY MORE (W49 wave 3).** A check here holds a runtime's LITERAL error flag against the enum's case
		// ORDER; `StringIndexRuntime` spelled `notFound` as 0 and `invalidIndex` as 1 to build the failure
		// edges of `__strix_first`/`__strix_last`/`__strix_after`. All three members are `stdlib/String.maxon`'s
		// now, so the corpus `throw StringError.notFound` resolves its ordinal from the declaration itself and
		// there is no second half to drift from. Re-adding a throwing `__strix_` graph brings the claim back
		// with it.
		// ⚠ **`MapError` WAS A SEVENTH AND WENT THE WAY `StringError` DID (W105).** `MapRuntime` transcribed
		// `keyNotFound`'s and `keyAlreadyExists`'s ordinals as literals to build `__map_get`'s and
		// `__map_insert`'s failure edges; both entry points are deleted with the synthesized hash table, so the
		// corpus `throw MapError.keyNotFound` resolves its ordinal from `stdlib/Map.maxon`'s own declaration and
		// there is no second half to drift from. Re-adding a throwing `__map_` graph brings the claim back with it.
		// `__EnumLookupError` is here for `__DivisionByZeroError`'s reason exactly: `EnumLookupRuntime`
		// transcribes `noSuchRawValue`'s ordinal as the literal error flag every `__enum_from_raw_<Enum>`
		// returns on a miss, while `Project.builtinEnumLookupErrorEnum` declares it by POSITION. ONE case is
		// not an excuse to skip the claim — see `verifyEnumLookupErrorOrdinals`.
		verifyEnumLookupErrorOrdinals(project)
		// ⛔ **`CharacterError` WAS THE ONE FAMILY THIS ROSTER'S OWN CRITERION SELECTS AND THIS ROSTER DID NOT
		// LIST (W135 review).** The two paragraphs above retire `StringError` and `MapError` on a stated test —
		// a family belongs here exactly while a throwing runtime graph transcribes its ordinals, and leaves when
		// the corpus becomes the only producer. `__char_ascii` is such a graph and has never stopped being one
		// (`GraphemeRuntime.buildCharAscii` returns `CharacterNotAsciiFlag` on its failure edge), while
		// `stdlib/Character.maxon` declares the case order that flag encodes. MEASURED: a case inserted ahead of
		// `notAscii` moved the declared ordinal to 1, `buildCharAscii` went on emitting 0, and the compile
		// exited 0 with no diagnostic. Nothing could read the drift yet — `match e` over this enum is E2015 —
		// which made it a wire format waiting for a reader rather than a family that needed no guard.
		verifyCharacterErrorOrdinals(project)
	end 'wellFormedSoFar'

	recordPhase(project, phase: CompilePhase.verifyOrdinals, probe: ordinalProbe)

	// ⚠ **THE ONE QUERY REACHED FROM INSIDE THIS BRACKET IS A MEMO HIT, AND IF IT EVER IS NOT, THIS
	// COMPILE IS ALREADY FAILING.** `deriveStdlibFacts` below reads each stdlib file's parse artifact
	// back through `queryParseOps`, which opens the `parse` phase — but only on a MISS, and every
	// stdlib file was parsed and cached by `queryAllModule` above. The single way to reach a miss here
	// is a stdlib file whose parse FAILED (a failed parse is never cached), and that compile throws at
	// the pipeline's error gate before anything stamps a total or reads a table. So the nesting the
	// disjointness contract forbids cannot be observed; it is stated because the next reader deserves
	// to know it was checked rather than assumed.
	let needsProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.deriveRuntimeNeeds)

	// ⭐ STDLIB SOURCE THIS PROGRAM CANNOT REACH MUST DECIDE NOTHING ABOUT IT. Stdlib is loaded into
	// EVERY compile, so a `Clock` no path from `main` reaches must be invisible to every
	// pre-elimination pass that examines a body — else its `__gt_now_ns`/`__clock_now_unix_s` calls
	// would install the scheduler + wall-clock `.data` for a program that reads no clock
	// (`scanRuntimeUsage`), and refuse to compile at all on wasm/arm64 (`checkCalls`'s E3104 target
	// gate). Computed ONCE here — stdlib AND unreachable from `main`, plus which of the REACHABLE
	// ones need the x64-windows substrate — and stored on the project so every consumer reads the
	// identical derivation. USER functions are never in it, so nothing about a stdlib-free program
	// changes. See StdlibSource for why the reachability is exact here (a stdlib function is reached
	// only by a direct call or a taken address, never by a witness or `.rdata` edge).
	//
	// ⚠ **ITS OWN GATE, BECAUSE IT IS THE FIRST SITE THAT CAN REFUSE AND THE PIPELINE'S IS STILL BELOW
	// (A1w).** `deriveStdlibFacts` reads every stdlib file's parse artifact back and builds a
	// `FunctionNameIndex` over this module, either of which can throw. Without a gate here that throw would
	// leave `compileToCodeResult` having passed both gates below, and the diagnostic would never be printed:
	// exit 1 with nothing said.
	//
	// ⚠⚠ **IT USED TO SIT ELEVEN LINES LOWER, AND MOVING IT ABOVE THE TWO STATEMENTS BELOW IS THIS RUNG
	// (S2h).** `liveGlobalLabels` must not credit a stdlib body no back end will receive, so it needs
	// `unreachable`; `liveGlobalLabels` must precede `installManagedGlobalInit` (see below); and
	// `installManagedGlobalInit` consumed the answer this derivation needed. What tied the derivation to the
	// LOWER position was a single duplicate-name refusal — its `FunctionNameIndex` was then the earliest
	// index that could meet a `stdlib/Builtins.maxon` declaration of `__module_init` against the compiler's
	// own — and that refusal is made by `PassPipeline.run`'s index one screen below over the SAME pair, and
	// again by `DeadFunctionElimination.markCompilerOwnedRoot` for the case with no pair to count. So the
	// cycle was cut where it was thinnest: nothing is refused later than before, and one derivation feeds
	// both readers instead of one reader re-deriving it. See `FunctionNameIndex`, which records what each
	// index site can actually see.
	project.stdlibFacts = try deriveStdlibFacts(project, module: module, signatures: signatures) otherwise 'stdlibFactsRefused'
		try refuseCompile(project)
	end 'stdlibFactsRefused'

	// ⭐ **WHICH GLOBALS CAN THE PROGRAM STILL NAME — ASKED BEFORE ANYTHING IS BUILT FROM THEM** (P1.7
	// slice 3, see `DeadGlobalElimination`). A binding nothing reads or writes costs an 8-byte slot, an
	// init run and a cleanup drop, and the three are dropped TOGETHER because all three are produced from
	// this one filtered arena — `managedGlobals` below and `declaredGlobals` further down apply the SAME
	// test, so there is nothing to remove afterwards and no ordering between three edits to get right.
	//
	// ⚠ **IT MUST PRECEDE `installManagedGlobalInit`, and not merely for the filtering.** `__module_init`
	// opens every managed global with a `globalAddr` of that global's own slot, so a liveness scan run
	// after the synthesis would find every global keeping itself alive — the answer would be "everything
	// is live", silently and always.
	let liveGlobals = liveGlobalLabels(module, storedGlobals: signatures.storedGlobalCount, unreachableStdlib: project.stdlibFacts.unreachable)

	// ⭐ **SYNTHESIZE `__module_init` / `__maxon_global_cleanup` — HERE, and the position is the whole
	// wiring** (P1.7 slice 2a, see `ModuleInit`). They are Maxon-tier functions appended to the merged
	// module, so everything below this line treats them as ordinary program code: `scanRuntimeUsage` sees
	// their `__str_clone`/`__str_decref`/`__managed_decref` calls and installs the runtime floor they need,
	// `declaredGlobals` (below) reserves the pointer slots they write, and the pipeline lowers them through
	// the SAME `lowerMaxonToStd` that turns a `stringLiteral` op into an rdata record and a
	// `constArrayLiteral` into an owned `Array`. Appending them after any of those would need a second copy
	// of whichever one it skipped.
	//
	// It answers whether the program has any managed global at all, which is the single bit the entry stubs
	// gate their two calls on. A program with none builds nothing and is byte-identical to before this rung.
	let usesManagedGlobals = installManagedGlobalInit(module, project: project, globals: signatures.managedGlobals(liveGlobals))

	recordPhase(project, phase: CompilePhase.deriveRuntimeNeeds, probe: needsProbe)

	// ⭐⭐ **THE PIPELINE RUNS IN TWO STAGES, AND WHAT SITS BETWEEN THEM IS THIS RUNG (the writable-record
	// rung).** The Maxon-tier stage ends at `semanticCheck`, which is where
	// `promoteArgsNeedingAWritableRecord` inserts the `__str_clone` / `__str_retain` / `__str_decref` calls
	// that give a byte record handed to a writing parameter one the write may land in. The runtime-needs
	// scan below then walks the FINAL Maxon module, and the lowering stage runs after it. Both neighbours
	// are forced, and both were measured — see `buildMaxonTierPasses`.
	var pipeline = try PassPipeline.create(project, maxonModule: module, signatures: signatures) otherwise 'duplicateFunctionName'
		try refuseCompile(project)
	end 'duplicateFunctionName'
	try pipeline.run(buildMaxonTierPasses()) otherwise 'maxonTierFailed'
		try refuseCompile(project)
	end 'maxonTierFailed'

	let scanProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.deriveRuntimeNeeds)

	// ⭐ THE HEAP IS CARRIED ONLY BY PROGRAMS THAT REACH IT (P1.0r). A `return 42` program
	// allocates nothing, so it gets no allocator, no `.data` slots and no leak check — and its
	// committed golden is byte-for-byte what it was before this rung existed. That is not an
	// optimization, it is what BackendDispatch's header already promised: the runtime floor GROWS
	// with the program's needs rather than being unconditional.
	//
	// ONE walk of the Maxon module answers all three "which runtime does this program carry?" questions
	// (heap / print / string-`==`). The HEAP answer alone drives `.data` layout — the `.data` slots must
	// exist before the BACKEND resolves a `globalAddr`, which is what fixes this pair's position relative to
	// everything below — and it stays `__mm_`-specific: a print-only program adds no `.data` slots and no
	// leak check.
	// `funcSignatures` rides along for ONE decision inside the walk — whether a `functionRef`'s `__` target is a
	// compiler-emitted symbol or a `stdlib/Builtins.maxon` DECLARATION (`recordFunctionRefUsage`). Its KEY SET
	// is final here: `mergeArtifact` filled it during the module build and `TypeResolution` only `upsert`s keys
	// it already holds, so no pass can change the answer this walk reads.
	var usage = scanRuntimeUsage(module, unreachableStdlib: project.stdlibFacts.unreachable, funcSignatures: project.funcSignatures)
	// ⭐ A TRACED build carries what `__gt_trace_emit` calls, and the scan cannot see any of it: the trace is
	// emitted BELOW the Maxon tier (into the synthesized `__gt_*` runtime), so no Maxon call site exists for
	// `scanRuntimeUsage` to walk. Declared here for the same reason the streaming-subprocess family declares
	// its transitive bits by hand. It is EXACTLY TWO bits, and the third one this used to declare was read
	// off a design that no longer exists:
	//   • `__int_to_string` — the id's digits. `__gt_trace_emit` calls it directly.
	//   • the heap — `__gt_init`'s `__slab_alloc` of the shared 24-byte digit scratch (`GtTraceDigitsLabel`),
	//     which only a traced build makes.
	// NOT `__str_decref`: `__int_to_string` fills that caller-owned scratch and returns a LENGTH, so no String
	// is created and none is released — see `buildGtTraceEmit`, whose header once claimed the opposite.
	if project.asyncTrace 'traceRuntimeNeeds'
		usage.usesIntToString = true
		usage.usesHeap = true
	end 'traceRuntimeNeeds'
	usage.usesManagedGlobals = usesManagedGlobals
	// A managed-payload union's `__destruct_<U>` (P1.3 slice 2) and a managed-field struct's
	// `__destruct_<Struct>` (P1.4a wave 2) call `__str_decref`/`__mm_free`/nested `__destruct_<T>` inside
	// SYNTHESIZED Std bodies the Maxon-module scan above cannot see. Close the needed-destructor set over that
	// nesting and declare its transitive needs now — before `.data` layout reads `usesHeap` and before
	// `installStringRuntime` reads `usesStrDecref`.
	// ⭐ **A2: an `async` spawn's per-callee releaser is synthesized after the pipeline too**, so the scan
	// above cannot see the `__str_decref` / `__destruct_<T>` calls its body will make. Collect the spawned
	// callees from the MAXON module (which the pipeline leaves intact) and declare each plan's drop callees
	// BEFORE `noteDestructorUsage` runs, so the destructors a releaser names are rooted in time for the
	// cascade fixpoint to close over them — the same obligation, and the same ordering, the cascades have.
	let asyncSpawnTargets = collectAsyncSpawnTargets(module)
	declareAsyncReleaserNeeds(usage, targets: asyncSpawnTargets, funcSignatures: project.funcSignatures, signatures: signatures, typeNames: project.typeNames)
	// ⚠ **`declareCharacterSetRuntimeNeeds` STOOD HERE AND WENT WITH THE `__cs_*` RUNTIME (W129).** It rooted the
	// `__destruct_Set_Character` cascade `__cs_decref`'s body would name, which is the obligation any FUTURE
	// synthesized body owning a declared generic's instance still carries — see `declareAsyncReleaserNeeds`
	// above, which states it for the one family that still has one.
	noteDestructorUsage(usage, project: project, signatures: signatures)
	// A managed-element array/struct/union DEEP-CLONE (P1.7 slice 3b-vi-b) synthesizes `__clone_<T>` cascades
	// that call `__str_clone`/`__managed_clone`/nested `__clone_<T>` inside bodies this scan cannot see. Close the
	// needed-cloner set over that nesting and declare its transitive `usesStrClone`/`usesManagedMemory`/`usesHeap` needs
	// now — before `.data` layout reads `usesHeap` and `installStringRuntime` reads `usesStrClone` — exactly as
	// `noteDestructorUsage` does for the drop cascades.
	noteClonerUsage(usage, project: project, signatures: signatures)
	// Every plain function used as a first-class value (`let f = triple`, `apply(triple, …)`) is called
	// through the uniform `(userargs, env)` indirect ABI, whose signature its own `(userargs) -> R` shape does
	// not match. Its `__fnref_` env-thunk targets are collected from the MAXON module — which the pipeline
	// leaves intact — and the thunks are installed already-lowered below, like the destructor cascades
	// (P1.5-A2b-2).
	let fnRefThunkTargets = collectFnRefThunkTargets(module, funcSignatures: project.funcSignatures)
	recordPhase(project, phase: CompilePhase.deriveRuntimeNeeds, probe: scanProbe)

	// The `.data` slot list assembled from those answers, and the section laid out. Its own phase
	// because it is the only step in this run whose cost is O(globals) rather than O(module).
	let layoutProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.layOutGlobals)
	var declaredGlobals = signatures.declaredGlobals(liveGlobals)
	if usage.usesHeap 'heapGlobals'
		for entry in runtimeGlobals() 'each'
			declaredGlobals.push(entry)
		end 'each'
	end 'heapGlobals'
	// The green-thread scheduler's `.data` slots (current GT, run-queue head/tail, init guard) — same
	// pre-lowering timing and same reason as the heap slots: a `globalAddr` the backend resolves needs them
	// laid out first. `usesGt` already implies `usesHeap` (spawn `__slab_alloc`s the GT struct), but the GT
	// slots are its OWN, so they ride their own bit.
	if usage.usesGt 'gtGlobals'
		for entry in gtRuntimeGlobals() 'each'
			declaredGlobals.push(entry)
		end 'each'
	end 'gtGlobals'
	// The IOCP substrate's `.data` slots ride their OWN bit (P1.5 slice 1a-ii), so a plain async/timer/proc program's
	// `.data` layout is unchanged — only a pipe-reading program lays them out.
	if usage.usesIocp 'ioGlobals'
		for entry in ioRuntimeGlobals() 'each'
			declaredGlobals.push(entry)
		end 'each'
	end 'ioGlobals'
	// The streaming subprocess handle-table pointer (P1.5 slice 1b) rides its OWN bit, so a non-streaming IOCP
	// program's `.data` layout is unchanged — only a streaming program lays out `__subp_table`.
	if usage.usesStreaming 'subpGlobals'
		for entry in subpRuntimeGlobals() 'each'
			declaredGlobals.push(entry)
		end 'each'
	end 'subpGlobals'
	// The wall clock's one out-param scratch word rides its OWN bit, so only a program that reads the
	// CALENDAR lays it out — a monotonic-clock or scheduler program's `.data` image is unchanged.
	if usage.usesWallClock 'clockGlobals'
		for entry in clockRuntimeGlobals() 'each'
			declaredGlobals.push(entry)
		end 'each'
	end 'clockGlobals'
	// The DebugStream producer's six `.data` slots ride the FLAG rather than a usage bit — nothing in a
	// program can ask for a trace, so `--debugstream` is the only thing that can. The condition is asked of
	// `buildCarriesDebugStream`, which is where the four parts that must agree about it read it from.
	if buildCarriesDebugStream(project, usage: usage) 'debugStreamGlobals'
		for entry in debugStreamRuntimeGlobals() 'each'
			declaredGlobals.push(entry)
		end 'each'
	end 'debugStreamGlobals'
	project.globalData.layOut(declaredGlobals)
	recordPhase(project, phase: CompilePhase.layOutGlobals, probe: layoutProbe)

	// ⭐ Hand the pipeline the ONE runtime fact a Std pass cannot derive from the Std module: whether this
	// program runs green threads, and so whether any frame can be RELOCATED underneath a pointer into it.
	// See `PassPipeline.usesGreenThreads`. It is set here because this is the seam where `scanRuntimeUsage`
	// has answered and no Std pass has yet run.
	pipeline.usesGreenThreads = usage.usesGt

	try pipeline.run(buildLoweringPasses()) otherwise 'loweringFailed'
		try refuseCompile(project)
	end 'loweringFailed'

	// ⭐ **`Ordering`'s DECLARATION, READ ONCE FOR THE WHOLE BACK END (W3).** The two runtime installs below
	// that emit a `compare` — the builtin-conformance impls and the grapheme runtime's `__char_cmp` — turn
	// its case names into TAGS, and the parser turned the same names into the tags those results are TESTED
	// against. It is fetched here, at the one point both installs are reached from, so there is a single
	// lookup and a single answer rather than one per builder; the layout is the corpus's own
	// (`stdlib/Interfaces.maxon:34-38`), not a transcription of it.
	//
	// ⚠⚠ **BELOW THE ERROR GATE, AND THAT POSITION IS PAID FOR.** `requireCorpusDeclaredEnum` PANICS on an
	// absent entry, and there is one way to be absent in a checkout that lists the declaring module: a stdlib
	// file whose parse FAILED, since a failed parse is never cached and so never merged
	// (`deriveStdlibFacts`' header records the same rule for the same reason). MEASURED with this line above
	// the gate: any user program declaring `implements Iterable` — which expands `stdlib/Interfaces.maxon`'s
	// `extension Iterable` onto the conformer and so can fail inside that file — died with this panic INSTEAD
	// of the diagnostic naming the real fault. Below the gate, that compile has already refused and said why.
	let orderingEnum = requireCorpusDeclaredEnum(project.enumTypes, typeName: OrderingTypeName, reader: "the `Comparable` compare impls")

	// ⭐ **THE `.rdata` SLOTS ARE FILLED NOW, AND WHAT THEY NAME MUST BE INSTALLED (P1.7a-existentials slice
	// 2).** Lowering is what decides which witness tables and layout descriptors a program gets, so the
	// destructors those tables' `destroyFunc` words point at cannot be known before this line — and every
	// install below reads the bits this sets. It sits after `pipeline.run()` and before the first install for
	// exactly that reason; see `noteRelocatedFunctionUsage` for why the `.data` layout above is nonetheless
	// safe. ⚠ It is deliberately OUTSIDE the install probe below: it decides WHAT gets installed, so billing
	// it to `installRuntime` would report a decision as part of the cost it decides.
	noteRelocatedFunctionUsage(usage, project: project, signatures: signatures)

	// ONE bracket over every install below, not one per installer: each is a slice of a single runtime
	// floor gated on its own usage bit, and the question a reader has is what CARRYING THE RUNTIME cost
	// this program (see `CompilePhase.installRuntime`).
	// ⭐ **ARM THE MODULE BEFORE THE FIRST INSTALL.** Every runtime builder below asks the module whether
	// this build carries the DebugStream producer (see `IrModule.debugStream`), so it is set once here — at
	// the seam where lowering has finished and nothing has been installed yet — rather than threaded
	// through forty signatures that could each forget it. It is the FULL condition and not the bare flag,
	// so the field means what its own header says: a heapless traced build installs no producer, and a
	// module claiming one it does not have is what would put a `globalAddr __ds_base` into a build whose
	// `.data` never laid that slot out.
	pipeline.stdModule.debugStream = buildCarriesDebugStream(project, usage: usage)

	let runtimeInstallProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.installRuntime)

	// AFTER the pipeline: the runtime is already lowered Std, so it must not be re-lowered, and it
	// is deliberately not exposed to the Std optimization passes — it is hand-built at the tier
	// they run on, and `foldConstOperands` would only re-derive folds it already has. It still
	// flows through the WHOLE backend (ISel, register allocation, frames), which is the entire
	// argument for building it as `StdOp`s rather than as bytes.
	if usage.usesHeap 'installMm'
		installMmRuntime(pipeline.stdModule, usage: usage)
	end 'installMm'
	// The green-thread scheduler (`__gt_init`/`__gt_spawn`/`__gt_enqueue`/`__gt_dequeue`/`__gt_await`),
	// installed the same way — already-lowered Std, appended after the pipeline so it is never re-optimized.
	// Its two hand-assembled chunks (`__gt_context_switch`/`__gt_trampoline`) are appended separately at the
	// Target tier (BackendDispatch), because they are bytes rather than Std ops.
	if usage.usesGt 'installGt'
		installGtRuntime(pipeline.stdModule, globalData: project.globalData, asyncTrace: project.asyncTrace, usesIocp: usage.usesIocp, usesStreaming: usage.usesStreaming)
	end 'installGt'
	// The String runtime (`__print_string`/`__str_eq`) is installed the SAME way and for the same
	// reason — already-lowered Std, appended after the pipeline so it is never re-optimized — but it is
	// keyed on its OWN usage bits, not on `usesHeap`: a Wave-A literal is immortal rdata, so a
	// print-only or string-`==`-only program pulls in NEITHER the allocator NOR the leak check.
	// `installStringRuntime` installs only the referenced functions (a no-op when neither is used).
	installStringRuntime(pipeline.stdModule, usage: usage)

	// The GRAPHEME runtime (`__gbp`/`__ext_pict`/`__utf8_*`/`__gr_*`/`__char_at`/`__str_to_bytes`, P1.8
	// slice B) — installed the same already-lowered way, keyed on its OWN per-entry-point bits so a
	// program that never segments a String carries none of it. It sits BEFORE the array install because
	// `__str_to_bytes` sets `usesManagedMemory` transitively (`closeGraphemeNeeds`) — but that bit was already
	// settled by `scanRuntimeUsage`, which runs before any install, so the order is readability, not a
	// dependency. It sits AFTER the String install for the same reason `__char_at` needs no ordering: the
	// functions are appended to one module and the backend resolves calls by name.
	installGraphemeRuntime(pipeline.stdModule, usage: usage, ordering: orderingEnum)

	// The two RAW Unicode table loads (`__ucd_bmp_at`/`__ucd_supp_at`, P1.8 Slice D / R2 / W64) — installed the
	// same already-lowered way, on their own `usesUcdCategory` bit. Unlike every install above it, this one also
	// REGISTERS `.rdata`: the two checked-in tables they read are ordinary read-only constants (v1's route,
	// not the bootstrap's dedicated section — see `UnicodeCategoryRuntime`'s header), so they must be in
	// `globalData` before the backend lays the section out. It needs `project.stdlibDir` because the tables
	// are checked into `stdlib/helpers/string/` and are read at COMPILE time, exactly as both reference
	// compilers read them.
	//
	// ⚠ **THE WHOLE `General_Category` LOOKUP (`__ucd_cat`) WAS INSTALLED HERE TOO, AND WENT AT W129** with its
	// one caller, `__cs_contains`. `stdlib/helpers/string/unicodeCategory.maxon` writes the same algorithm out
	// of these two raw reads, so what the corpus reaches is the pair — never a third synthesized entry point.
	try installUnicodeCategoryRuntime(pipeline.stdModule, globalData: project.globalData, usage: usage, stdlibDir: project.stdlibDir)

	// ⚠ **THE `CharacterSet` RUNTIME (`__cs_make`/`__cs_decref`/`__cs_contains`) WAS INSTALLED HERE AND IS
	// DELETED (W129).** `W115` listed `stdlib/CharacterSet.maxon`, which declares the eleven presets, `from` and
	// `contains` as ordinary Maxon; with the parser's interceptions gone nothing could emit any of the three
	// callees, so all three bits were unsettable and this install could only ever install nothing.

	// The file-IO runtime (`__mf_open_read`, R4.1) — installed the same already-lowered way, on its own
	// `usesManagedFile` bit. It must come AFTER the array install is decided but has no ordering dependency
	// on it: it calls `__mm_alloc`/`__mm_free` (carried by the `usesHeap` bit it sets alongside its own) and
	// `ManagedMemoryRuntime.emitForwardCopy`, which is a BUILDER it inlines rather than a callee it references.
	installManagedFileRuntime(pipeline.stdModule, usage: usage)

	// The directory runtime (`__md_open_search`/`__md_next`/…, R4.3) — installed the same already-lowered
	// way, on its own `usesManagedDirectory` bit. It sits beside the file install because the two share this
	// family's helpers (the path scratch copy, the errno classification, the raw alloc/free); it needs no
	// ordering against the ARRAY install below even though `__md_filename` CALLS `__managed_create`, because the
	// functions are appended to one module and the backend resolves calls by name — and the `usesManagedMemory` bit
	// that makes the managed-memory runtime present was settled by `scanRuntimeUsage` before any install ran.
	installManagedDirectoryRuntime(pipeline.stdModule, usage: usage)

	// The command-line runtime (`__cl_count`/`__cl_arg`/`__cl_scan_one`) — installed the same already-lowered
	// way, on its own `usesCommandLine` bit. It sits beside the two families above because it shares their
	// helpers (the raw alloc/free, the cstring walk and the cstring-to-`__ManagedMemory` copy), and it needs
	// no ordering against the Array install below even though `__cl_arg` CALLS `__managed_create`, for the reason
	// stated there: one module, name-resolved calls, and the `usesManagedMemory` bit was settled before any install ran.
	installCommandLineRuntime(pipeline.stdModule, usage: usage)

	// The console and process-introspection runtimes (`__con_read_stdin`, `__proc_exe_path`, W5) — the same
	// already-lowered way, each on its OWN bit, so a program that reads stdin carries no path walk and one
	// that asks for its own path carries no read. They sit beside the three families above because they share
	// their helpers (the raw alloc/free, the Win32 out word, the byte-element record builder and the cstring
	// copy), and they need no ordering against the Array install below for the reason stated there.
	installConsoleRuntime(pipeline.stdModule, usage: usage)
	installProcessRuntime(pipeline.stdModule, usage: usage)

	// The managed-memory runtime (`__managed_create`/`__managed_push`/`__managed_get`/…) — installed the same way and for the
	// same reason: already-lowered Std, appended after the pipeline so it is never re-optimized. Keyed on
	// its own `usesManagedMemory` bit (any `__managed_*` reference), which also implied `usesHeap` above (the helpers
	// `__mm_alloc`/`__mm_free` the record and its element buffer). It installs the WHOLE managed-memory runtime as
	// one closure — the helpers call each other, and `__`-prefixed functions are excluded from the goldens,
	// so an all-or-nothing install is golden-neutral and needs no per-helper dependency tracking (P1.7).
	installManagedMemoryRuntime(pipeline.stdModule, usage: usage)

	// ⚠ **THE `Set` AND `Map` RUNTIMES STOOD HERE AND ARE DELETED (W105).** `__set_*` and `__map_*` were one
	// shared hash-table graph under two names; `W41` made a corpus `Map` retire the synthesized one and `W90`
	// did the same for `Set`, which took the last live reader — `CharacterSet`'s member probe — with it. Both
	// containers are ordinary declared generics now, so their `create`/`insert`/`contains`/`remove`/`count`
	// are compiled Maxon bodies the reachability walk finds for itself, exactly as `StringIndexRuntime`'s
	// were after W49. The `usesSet`/`usesMap` bits went with them, and the `CharacterSet` install that was the
	// last thing still declaring the `usesHeap` those two arms carried alongside went at W129.
	//
	// The List runtime (`__list_create`/`__list_append`/`__list_get`/…) — installed the same already-lowered
	// way, keyed on its own `usesList` bit. It shares no graph with the two above (a chain is not a table), so
	// it is a plain third container install; the order is readability for their reason.
	installListRuntime(pipeline.stdModule, usage: usage)

	// The single-value descriptor-gated drop (`__drop_type_param`, P1.7 slice 3b-v / Finding A) — installed on
	// its OWN `usesDropTypeParam` bit, DECOUPLED from `usesManagedMemory`, so a bare opaque `T` field reassignment in an
	// array-free generic struct links its drop. An opaque-array program sets the bit too, so this installs the
	// one `__drop_type_param` for either case, exactly once (its sole install site).
	installDropTypeParamRuntime(pipeline.stdModule, usage: usage)

	// Its co-ownership twin (`__retain_type_param`, W41-opaque), on its own bit for the same reason: a shared
	// body that only STORES a borrowed opaque `T` never drops one.
	installRetainTypeParamRuntime(pipeline.stdModule, usage: usage)

	// The existential's drop (`__drop_existential`, P1.7a-existentials slice 2) — its sibling above's exact
	// arrangement: the same emitter, its own bit, so a program with an interface-typed field but no generic
	// instantiation links its drop and a program with neither carries neither.
	installDropExistentialRuntime(pipeline.stdModule, usage: usage)

	// Its co-ownership twin (`__retain_existential`), on its own bit for the same reason.
	installRetainExistentialRuntime(pipeline.stdModule, usage: usage)

	// The WALL clock (`__clock_now_unix_s`) — installed the same already-lowered way, on its own
	// `usesWallClock` bit. Its monotonic sibling (`__gt_now_ns`) comes from `installGtRuntime` above instead,
	// because the SCHEDULER owns that counter: its timer deadlines are expressed in it, and routing both the
	// scheduler and `__Builtins.currentTimeNanos` to ONE function is what keeps them from disagreeing.
	installClockRuntime(pipeline.stdModule, usage: usage)

	// The synthesized builtin-type conformance impls (P1.7a slices 2b/2b-ii/2b-iii + P1.7b) — installed the
	// same already-lowered-Std way, but keyed on neither a `usage` bit nor a pre-pipeline scan: BOTH ways of
	// naming one are created too late for either.
	// A witness slot's `funcAbs64` reloc is stamped DURING lowering (`ensureWitnessTable`), and a direct
	// `i.compare(j)` on a concrete value is an ordinary `call int.compare` the parser emits (P1.7a direct
	// dispatch). So the install reads the FINISHED module — every pending rdata reloc and every op that spells
	// a function name — and builds an impl iff the program NAMES it and does not already DEFINE it.
	// **REFERENCED-but-undefined ⟺ INSTALLED**; see `installBuiltinConformanceRuntime`'s own header, which
	// owns this rule, for why the "does not already define" half is load-bearing and why the walk is the wide
	// one. Golden-neutral for every program that names no impl (the conformance-free corpus and the whole
	// wasm suite): the walk builds nothing.
	//
	// ⚠ **WHICH impls those are is deliberately NOT LISTED HERE, and the omission is the point.** The roster
	// is one (type, protocol) pair per impl in `IrInterface.isIntrinsicBuiltinConformance`, and
	// `installBuiltinConformanceRuntime` is its only reader. This comment used to carry a copy of that list,
	// and the copy went stale in each of the two rungs that added a conformer — because a roster at a CALL
	// SITE has no test between it and the original: nothing fails when it drifts, it simply starts lying to
	// the next reader. A pointer at the owner cannot go stale, so this is one.
	installBuiltinConformanceRuntime(pipeline.stdModule, globalData: project.globalData, ordering: orderingEnum, arrayConformerName: signatures.arrayRecordDeclaredName())

	recordPhase(project, phase: CompilePhase.installRuntime, probe: runtimeInstallProbe)

	// The bodies synthesized for THIS program get their own bracket beside the runtime's: the runtime
	// above is a fixed library gated on usage bits, while everything below grows with the program's
	// TYPES, and a single row over both would move for two unrelated reasons.
	let synthesizeProbe = PhaseProbe.beginPhase(project, phase: CompilePhase.synthesizeBodies)

	// The per-union (P1.3 slice 2) and per-struct (P1.4a wave 2) destructor cascades, installed the same way
	// and for the same reason: already-lowered Std, appended after the pipeline so they are never
	// re-optimized. Only the destructors the module actually CALLS — directly or through a nested cascade
	// `noteDestructorUsage` closed the set over — are built (`usage.neededDestructors`).
	installUnionDestructors(pipeline.stdModule, project: project, signatures: signatures, needed: usage.neededDestructors)
	installStructDestructors(pipeline.stdModule, project: project, signatures: signatures, needed: usage.neededDestructors)
	// The per-instance destructor cascade (P1.6-B2) — the same already-lowered append as the struct/union
	// ones. A managed generic instance OWNS its type arguments, so its `__destruct_<mangled>` drops each
	// substituted managed field; only the REFERENCED instances (directly, or through a nested cascade
	// `noteDestructorUsage` closed the set over) are built. It reads the instance registry, which lives on
	// `signatures`, so it needs no `project`.
	installGenericInstanceDestructors(pipeline.stdModule, signatures: signatures, needed: usage.neededDestructors)
	// The per-struct and per-union DEEP-CLONER cascades (P1.7 slice 3b-vi-b) — the clone twins of the destructor
	// installers, appended already-lowered after the pipeline for the same reason. Only the cloners the module
	// references (directly through a `funcAddr(__clone_<T>)` element-cloner stamp, or through a nested cascade
	// `noteClonerUsage` closed the set over) are built (`usage.neededCloners`).
	installUnionCloners(pipeline.stdModule, project: project, signatures: signatures, needed: usage.neededCloners)
	installStructCloners(pipeline.stdModule, project: project, signatures: signatures, needed: usage.neededCloners)
	// The per-instance DEEP-CLONER cascade (W162) — the clone twin of `installGenericInstanceDestructors` above,
	// installed beside the struct/union cloners for the same reason they sit beside their own destructors. It
	// takes `project` (which the destructor twin does not) for one fact the instance registry cannot answer: the
	// MM tag index a fresh box is allocated under lives in `project.globalData`.
	installGenericInstanceCloners(pipeline.stdModule, project: project, signatures: signatures, needed: usage.neededCloners)
	// The `__fnref_` env-thunks for plain functions used as first-class values — collected before the pipeline
	// (see `fnRefThunkTargets`), installed here already-lowered so they flow through the whole backend and (on
	// wasm) receive a funcref-table slot at their funcIdx (P1.5-A2b-2).
	installFnRefThunks(pipeline.stdModule, project: project, targets: fnRefThunkTargets)
	// The `__gt_release_<callee>` helpers that give back the reference an `async` spawn took to each managed
	// argument, and release the result-or-error of a promise nobody awaited (A2). Collected before the
	// pipeline (see `asyncSpawnTargets`), installed here already-lowered like the cascades above; a callee
	// with nothing managed to release gets none, which is why a scalar async program is unchanged.
	installAsyncReleasers(pipeline.stdModule, targets: asyncSpawnTargets, funcSignatures: project.funcSignatures, signatures: signatures, typeNames: project.typeNames)
	// The per-enum `<Enum>.fromRawValue` lookups — the same already-lowered append, and only the helpers the
	// module CALLS. See `Runtime/EnumLookupRuntime.maxon` for why this one member of the enum reflection
	// surface is a function while its four siblings expand in the parser.
	installEnumLookupHelpers(pipeline.stdModule, project: project, needed: usage.neededEnumLookups)

	// ⭐⭐ **THE DEBUGSTREAM PRODUCER, INSTALLED LAST OF EVERYTHING, BECAUSE IT RENDERS THE TAG BLOB.**
	// `MXDS_TAGS` is the table the monitor resolves a 16-bit tag index against, and it is written ONCE, from
	// whatever `globalData` holds at that moment — so every site that can intern a name must have run
	// first. Two do, and they are far apart: the lowering's `__mm_alloc` arm (a user box's own type name)
	// and the synthesized CLONERS just above (a `__clone_<T>` allocating a fresh box of the same type). An
	// install placed with the MM family, where it reads naturally, would render the blob before the cloners
	// existed and every cloned box would decode as `tag=<n>` against a table that had no such entry.
	//
	// ⚠ Gated on the module's own armed flag — `buildCarriesDebugStream`, set above — rather than on a
	// second spelling of the same conjunction.
	if pipeline.stdModule.debugStream 'installDebugStream'
		installDebugStreamRuntime(pipeline.stdModule, globalData: project.globalData)
	end 'installDebugStream'

	recordPhase(project, phase: CompilePhase.synthesizeBodies, probe: synthesizeProbe)

	// The backend owns its own error gate now, and TWO of its stages use it: the register allocator
	// reports E5001 (register pressure) onto `project.diagnostics` and throws when a loop genuinely
	// overflows the register file, and the reachability prune reports E4015 and throws when a
	// declaration takes a name the compiler owns — at its `FunctionNameIndex`, whose Std-tier site is the
	// first point in the compile where BOTH sides of such a pair are present and hence the first that can tell
	// them apart (A1t), and at its root set, for the half of that rule with no pair to count (A1w). Passing
	// `project` is also what gives the allocator the `opRanges`/`valueOrigins` tables it
	// maps a Target ValueId back to its source span through.
	let codeResult = try buildBackend(pipeline.stdModule, target: project.target, globalData: project.globalData, project: project, usage: usage) otherwise 'backendFailed'
		try refuseCompile(project)
	end 'backendFailed'
	// ⭐ **THE DECLARATION-HYGIENE DRAIN (E3012 unused, E3077 var-should-be-let) — AFTER THE BACKEND, which
	// is the first point at which nothing else has anything to say about a body.** See
	// `reportBindingHygieneDiagnostics`.
	try reportBindingHygieneDiagnostics(project)

	return codeResult
end 'compileToCodeResult'

// ⭐⭐ **REPORT THE HYGIENE DIAGNOSTICS THE PARSER DECIDED, NOW THAT EVERY PASS THAT COULD EXPLAIN THE BODY
// INSTEAD HAS RUN.** Both verdicts (E3012 unused, E3077 var-should-be-let) are facts about ONE function,
// settled at its `end` during the parse; only the REPORTING waits, and `Project.bindingHygieneDiagnostics`
// carries the measured cascade that makes it wait.
//
// ⭐⭐ **IT IS CALLED AFTER `buildBackend`, AND EACH STEP OF THAT POSITION WAS PAID FOR BY A MEASUREMENT.**
// Reported where they are DECIDED, they gate the pipeline ahead of `resolveTypes`, and 26 committed
// error-cases moved — `let x = 256 as Byte` reported *"unused variable: 'x'"* instead of the out-of-range
// cast `type-casting.md` exists to pin, and that file is a canonical `/specs` port whose program may not be
// edited to suit us. Moved to the end of `semanticCheck` that specific case STILL moved, because the
// compile-time narrowing (E3005) is `InsertRangeChecks`, a Std-tier pass. And after the lowering stage two
// BACKEND diagnostics still followed it: **E5001** (the register allocator out of registers) and **E4015**
// (the reachability prune) — and the co-occurrence is not hypothetical, since `register-stress.md`'s whole
// subject is a function stuffed with idle `var`s. Here there is nothing left below.
//
// The cost is that a doomed compile pays one codegen pass it will throw away. That is the right trade for a
// diagnostic whose entire purpose is to be the LAST thing a reader is told.
//
// ⚠ **THE SUPPRESSION IS WHOLE-PROGRAM, WHERE v1's IS PER FUNCTION (`functionHasPriorDiagnostic`).** A
// per-function rule needs a second index from a diagnostic's position back to the body containing it, and
// every case in either suite that reaches this point has ONE complaint in the whole program — so the finer
// rule would cost an index to make a distinction nothing observes. It errs toward reporting LESS, which for
// a hygiene diagnostic is the harmless direction.
//
// ⚠ **THE GATE IS NOT REDUNDANT, THOUGH NOTHING CAN TRIP IT FROM HERE TODAY.** Every `otherwise` above
// refuses the compile, so reaching this call means the sink is empty — but that is a property of the
// CALLER, and a hygiene diagnostic stacked on top of a real one is precisely the defect this deferral
// exists to prevent. The rule is written where the rule is, not left resting on the control flow above it.
function reportBindingHygieneDiagnostics(project Project) throws CompileError
	if project.bindingHygieneDiagnostics.count() == 0 or projectHasErrors(project) 'nothingToSayOrSomethingRealerSaidIt'
		return
	end 'nothingToSayOrSomethingRealerSaidIt'

	for diagnostic in project.bindingHygieneDiagnostics 'each'
		reportDiagnostic(project, diagnostic: diagnostic)
	end 'each'

	try refuseCompile(project)
end 'reportBindingHygieneDiagnostics'

// --- Source loading ---

// ⭐⭐ **REGISTER EVERY SOURCE THE CALLER NAMED, IN THE ORDER THE CALLER NAMED IT (A3m).** A single
// `.maxon` file loads directly; a directory loads every `.maxon` file beneath it (except
// `build.maxon`). Throws when a path does not exist or the whole list yields no sources. (v1's
// `.maxonignore` support + `.test`-fragment stripping grow back when the spec runner needs them.)
//
// ⚠⚠ **THE ORDER IS THE CALLER'S INPUT, AND IT IS NEVER A POLICY THIS LOADER APPLIES — SO NOTHING
// HERE SORTS, AND NOTHING BELOW IT SORTS EITHER.** That is exactly the shape `StdlibLoader`'s header
// asks for (user ruling 2026-07-24): a canonical input order imposed by the loader would HIDE an
// order dependence instead of surfacing it, so *"where an ORDER genuinely matters it is canonicalized
// at the point of emission … never by constraining what the loader was handed"*. Before A3m a
// multi-file build had no way to STATE an order at all — `build` kept the first positional and
// silently dropped the rest — so the answer came from raw `Directory.list`, i.e. from the staging
// directory's on-disk state. Five `-either-order` spec pairs were written to pin BOTH walk orders of
// one program and could pin neither: whichever order the host served, both halves got it, and the
// pair was two tickets in one lottery (`specs-shv2/tuples.md`, `managed-memory-methods.md`,
// `cross-file-signatures.md`).
//
// ⚠ A path named twice — directly and again through a directory that contains it — is registered
// ONCE, at its FIRST position. That is not a rule this function applies: `fileChanged` upserts by
// path and pushes onto `sourcePaths` only for a path it has not seen, so re-registering identical
// content is a no-op all the way down. It is what makes `build a.maxon b.maxon <theirDirectory>`
// mean "these two first, then whatever else is under there" — the form the spec runner uses to state
// a case's declared file order while keeping the project rooted at the case's own directory.
function loadSourceFiles(project Project, paths MaxonSourcePathArray) throws CompileError
	for path in paths 'eachNamed'
		if File.exists(path) 'isFile'
			try loadOneSourceFile(project, path: path)
		end 'isFile' else if Directory.exists(path) 'isDir'
			try loadSourceDirectory(project, dir: path)
		end 'isDir' else 'notFound'
			throw CompileError.fileNotFound(path)
		end 'notFound'
	end 'eachNamed'

	if project.db.sourcePaths.count() == 0 'noFiles'
		throw CompileError.noSourceFiles(project.rootPath)
	end 'noFiles'
end 'loadSourceFiles'

// ⭐⭐ **THE PROJECT ROOT OF A BUILD THAT NAMED SEVERAL PATHS — the ONE directory every one of them
// lies under.** It is what `Project.rootPath` becomes, and through it what
// `Queries.namespaceAnchorFor` measures every file's MODULE DIRECTORY from (N1), so getting it wrong
// re-anchors namespaces silently rather than failing.
//
// ⚠ **ONE PATH IS ITS OWN ANCESTOR, and that identity is why nothing moves for the builds that
// existed before A3m.** The narrowing loop's first comparison is `first` against itself, which
// `isInside` answers true for, so a lone `build <file>` or `build <directory>` keeps the root it has
// always had — the spelling the caller TYPED, unresolved. Every downstream reader resolves it against
// the cwd for itself (`namespaceAnchorFor`, `rootIsUnderStdlibDirectory`), and `resolveOutputPath`
// derives a default output name from it, so resolving it here would silently rewrite that name for
// every single-file build in the tree.
//
// ⚠ **THE COMPARISON IS BETWEEN RESOLVED SPELLINGS, because `isInside` compares TEXT** — the same
// trap `Queries.isStdlibSourceFile` records: an absolute path and a relative one naming one file are
// two different strings, and a root that misses its own members would narrow all the way to the drive.
//
// ⛔⛔ **AND WHEN IT DOES NARROW ALL THE WAY TO THE DRIVE, IT REFUSES — because `FilePath.parent()`
// CANNOT EXPRESS A FILESYSTEM ROOT, so the step past the top yields a string that is not a directory
// and not even absolute** (BATCH10 review). `lastSepPlusOne` returns the index AFTER the separator and
// `parent` slices `(0, that - 1)`, so on Windows `parent("C:\\a")` is **`"C:"`** — two bytes, which
// `isAbsolute` denies (its drive arm needs `len >= 3` with a separator at byte 2) — and on POSIX
// `parent("/a")` is **`""`**.
//
// MEASURED on this tree before the guard below: `maxon-shv2 build C:\a C:\b` answered
// `error: no source files under C:`. That `"C:"` was becoming `Project.rootPath`, and because
// `isAbsolute` says it is RELATIVE every downstream `.resolve(cwd)` — `namespaceAnchorFor`,
// `rootIsUnderStdlibDirectory` — joined it onto the working directory as `<cwd>\C:`. The namespace
// happened to come back right through `deriveModuleDirectory`'s not-under-root fallback, which is luck
// and not a mechanism: the value handed downstream named a drive where a directory was promised.
//
// ⇒ **The narrowing stops where the path stops being ABSOLUTE**, which is the one property that marks
// having walked off the top, and the same test answers for both spellings (`"C:"` and `""`). The two
// platforms now agree: POSIX already refused here — `isInside("")` is false, so it narrowed once more
// and `parent("")` threw — and Windows silently did not.
//
// ⚠ **THE RESIDUAL IS THAT A ROOT-ROOTED BUILD IS REFUSED RATHER THAN ROOTED, and it is REFUSED
// rather than left wrong on purpose.** `C:\` really is the common directory of `C:\a\x` and `C:\b\y`,
// so the honest answer is that root — but no `FilePath` in this tree can hold it, since `parent` cuts
// the separator off and nothing reconstructs it. Modelling filesystem roots is `stdlib/FilePath`'s to
// do and touches every path consumer; until it happens, a loud refusal naming both ends beats a
// `Project.rootPath` that `isAbsolute` disowns. Nothing in the harness reaches this: a spec case's
// paths are all under its own `testDir` (`SpecTestRunner.stageSourceFiles` names it last), and every
// other caller passes exactly one path.
export function commonAncestorOf(paths MaxonSourcePathArray) returns FilePath throws CompileError
	let first = try paths.get(0) otherwise panic("commonAncestorOf: an empty path list — `Main.runBuild` refuses a `build` with no positional argument before any of this runs, and every other caller names exactly one path")
	let cwd = Directory.currentPath()

	// Absolute by construction — `resolve` returns the path itself when it is already absolute and
	// joins it onto the cwd otherwise, and `Directory.currentPath()` is absolute. That is what makes
	// "stopped being absolute" below mean "walked off the top" rather than "was never rooted".
	var resolvedRoot = first.resolve(cwd)
	var narrowed = false
	for path in paths 'each'
		let resolved = path.resolve(cwd)
		while not resolved.isInside(resolvedRoot) 'narrow'
			// Monotone, so the paths already checked stay inside: `resolvedRoot` only ever becomes an
			// ancestor of what it was, and each of them was inside it.
			let candidate = try resolvedRoot.parent() otherwise throw CompileError.noCommonRoot(first, other: path)
			if not candidate.isAbsolute() 'walkedOffTheTop'
				throw CompileError.noCommonRoot(first, other: path)
			end 'walkedOffTheTop'

			resolvedRoot = candidate
			narrowed = true
		end 'narrow'
	end 'each'

	if narrowed 'severalPaths'
		return resolvedRoot
	end 'severalPaths'

	return first
end 'commonAncestorOf'

// Load every Maxon source file under `dir`.
function loadSourceDirectory(project Project, dir FilePath) throws CompileError
	var paths = MaxonSourcePathArray.create()
	_ = try collectMaxonSources(dir, into: paths)

	for path in paths 'each'
		try loadOneSourceFile(project, path: path)
	end 'each'
end 'loadSourceDirectory'

// ⭐ **WHAT COUNTS AS A MAXON SOURCE FILE UNDER A DIRECTORY — asked in ONE place.** Every `.maxon`
// file beneath `dir`, subdirectories included, minus the build manifest (a project description, not
// a compilation unit).
//
// ⚠ BOTH of a compile's directory walks go through it — the USER's own root (`loadSourceDirectory`)
// and the checkout's `stdlib/` (`loadStdlibSources`) — because that is ONE question, and two copies
// of the answer are two copies that can come to disagree. The next clauses this rule grows are
// already named in `loadSourceFiles`: v1's `.maxonignore`, and `.test`-fragment stripping. Added to
// one walk and not the other, either would read as correct at BOTH sites while a file was silently
// compiled on one side and silently skipped on the other.
//
// It COLLECTS rather than loading, because the callers do different things with the answer: the user
// walk registers every path it is given, while the stdlib loader filters first and records what it
// kept.
//
// ⚠ IT RETURNS THE DIRECTORIES IT LISTED, WHICH IS A FACT ONLY THE WALK HOLDS. The files it found are
// in `into`, and the parents of those files are NOT the same set: an EMPTY directory is walked, costs
// a `Directory.list`, and contributes no path anybody outside can see. `scale-test` reports both
// numbers so that an ignored directory — invisible to git, visible here — cannot go on being an
// unattributed constant in the trend log (see `printStdlibWalkCensus`), and the count is returned from
// the recursion rather than re-derived by a second traversal because a second traversal would be free
// to disagree the moment this one grows an exclusion.
export function collectMaxonSources(dir FilePath, into MaxonSourcePathArray) returns DirectoryWalkCount throws CompileError
	let entries = try Directory.list(dir) otherwise throw CompileError.directoryNotFound(dir)

	// `dir` itself was listed, so a leaf directory answers 1 and never 0.
	var walked = 1 as DirectoryWalkCount

	for entry in entries 'each'
		if Directory.isDirectory(entry) 'isSubdir'
			let below = try collectMaxonSources(entry, into: into)
			walked = walked + below
		end 'isSubdir' else 'isFile'
			let name = entry.filename()
			if name != BuildManifestName and name.endsWith(MaxonSourceExtension) 'isSource'
				into.push(entry)
			end 'isSource'
		end 'isFile'
	end 'each'

	return walked
end 'collectMaxonSources'

// Read one source file and register its content with the query system. Exported so stdlib modules
// are loaded through the identical read+register path a user file takes.
export function loadOneSourceFile(project Project, path FilePath) throws CompileError
	let content = try File.readText(path) otherwise throw CompileError.readError(path)
	fileChanged(project, path: path, content: content)
end 'loadOneSourceFile'

// --- Output path resolution ---

// The build manifest filename and Maxon source extension. Named, not bare
// literals — both are file-discovery contracts, and `collectMaxonSources` is the
// only reader of either: `stdlib/` is enumerated by that same function, so what a
// source file is called is stated once for the whole compiler.
let BuildManifestName = "build.maxon"
let MaxonSourceExtension = ".maxon"

// Paths of Maxon source files, in the order a walk found them — what `collectMaxonSources`
// produces and what `Project.stdlibSourcePaths` keeps. A DISTINCTLY-named alias rather than
// QueryDatabase's `FilePathArray`, whose name collides with a member typealias inside stdlib's
// `type Directory` and so does not resolve from every compiler file (`DiagnosticArray`, the same
// `Array with T` shape under a unique name, resolves cross-file fine — the name is the difference).
export typealias MaxonSourcePathArray = Array with FilePath

// How many directories one `collectMaxonSources` call LISTED — itself plus everything it recursed
// into. Named for that rather than for a tree's shape: it is the walk's own reach, which is what an
// instrument comparing two checkouts needs, and not "how many directories exist" (a walk that grows an
// exclusion stops answering that question and keeps answering this one).
//
// From 1: a call always lists the directory it was handed, so 0 is not a value the walk can report.
export typealias DirectoryWalkCount = int(1 to u64.max)

// The same paths where the question is MEMBERSHIP rather than order, so it is answered by one hash
// instead of a scan — and each pair a scan would compare is about four String allocations, because
// `FilePath.equals` canonicalizes both sides (on Windows it clones and lower-cases each).
export typealias MaxonSourcePathSet = Set with FilePath

// Extension of the `--emit-ir` Target-IR sidecar written beside the exe. A format
// contract shared with the spec runner (which reads back the same file), so it is
// named here rather than spelled inline.
let IrFileExtension = ".ir"

// Resolve the output executable path: an explicit `-o` override wins; otherwise
// the output is the input's base name with the platform executable extension
// (single-file build → next to the source; every other shape — a directory, or
// several paths at once — → the FIRST registered source file's base name, which
// for a list is the first path the caller named). Deriving a directory build's name from a `build.maxon`
// `build("...")` manifest grows at M2, when directory builds become the norm;
// the M1 verification gate is a single-file build (`basic.maxon` → `basic.exe`).
function resolveOutputPath(project Project, outputOverride String) returns FilePath throws CompileError
	let ext = executableExtension(project.target)

	if not outputOverride.isEmpty() 'hasOverride'
		return try FilePath.from("{outputOverride}{ext}") otherwise panic("resolveOutputPath: invalid -o/--output path '{outputOverride}'")
	end 'hasOverride'

	if File.exists(project.rootPath) 'singleFile'
		return project.rootPath.changeExtension(ext)
	end 'singleFile'

	let firstPath = try project.db.sourcePaths.get(0) otherwise panic("resolveOutputPath: sourcePaths empty — loadSourceFiles should have thrown noSourceFiles")
	return firstPath.changeExtension(ext)
end 'resolveOutputPath'
