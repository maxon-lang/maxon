	// from the parser's own constant view — so this stays a BARE divide with no guard and no `try`, and it
	// stays one for a reason the compiler checks rather than one this comment asserts. Routing it around
	// `emitDivOrMod` to save that check would be the second division path the paragraph above forbids.
	function emitMonotonicMs(args ValueIdArray, calleeTok Token) returns ValueId throws ParseError
		let nanos = try self.emitClockIntrinsicCall(args, name: BuiltinsCurrentTimeMsName, runtimeName: GtNowNsName, calleeTok: calleeTok)
		let perMilli = self.emitLiteral(NanosPerMillisecond, valueType: MaxonType.integer, range: SourceRange.ofToken(calleeTok))
		return try self.emitDivOrMod(nanos, divisor: perMilli, op: MaxonBinOp.div, opTok: calleeTok)
	end 'emitMonotonicMs'

	// ⭐ **THE ARITY CHECK AND THE EMIT EVERY CLOCK INTRINSIC SHARES**, written once and returning the
	// integer-tagged reading. All three take no arguments and become one call to a runtime entry point the
	// compiler builds at the Std tier, so only the entry point's NAME differs.
	//
	// The arity rejection is the SAME `builtinArity` every other builtin raises — a builtin has no signature
	// registry entry for SemanticCheck's ordinary arity check to consult, which is exactly why that variant
	// exists. `name` is the callee's own bytes so the diagnostic quotes what the user wrote.
	function emitClockIntrinsicCall(args ValueIdArray, name ByteArray, runtimeName ByteArray, calleeTok Token) returns ValueId throws ParseError
		if args.count() != ClockIntrinsicArity 'arity'
			throw ParseError.builtinArity(String.from(name), expected: ClockIntrinsicArity, got: args.count(), line: calleeTok.line, column: calleeTok.column)
		end 'arity'

		return self.emitRuntimeCall(runtimeName, args: ValueIdArray.create(), resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(calleeTok))
	end 'emitClockIntrinsicCall'

	// `trunc(x)` — **THE f64 → int BRIDGE**, and a compiler BUILTIN rather than a stdlib function.
	//
	// It is a builtin in both reference compilers (v1: `mathIntrinsicTarget` →
	// `StdArithUnaryOpcode.fpToSiI64`, LowerMaxonToStd.maxon:13888; the bootstrap: `MaxonTruncOp`,
	// 2-Parser.cs:804). For shv2 the reason is sharper than inheritance: it lowers to ONE
	// instruction, so a call would be a call/ret wrapped around a single `cvttsd2si` — and,
	// decisively at THIS rung, a stdlib `trunc` would drag in the stdlib cone, which is P1.0b's.
	// specs-shv2/float-type.md ends nearly every case on it, so it is the difference between the
	// float corpus running and not running at all.
	//
	// ⚠ **`trunc(int)` IS THE IDENTITY, and answering it with the operand is CORRECTNESS, not an
	// optimization.** An int → f64 → int round trip loses precision above f64's 53-bit mantissa,
	// so `trunc(i64.max)` would answer a number that is not `i64.max`. v1 makes the same call for
	// the same reason ("trunc(int) is identity — alias the result to the operand directly",
	// LowerMaxonToStd.maxon:7778). It is also what keeps `fpToSi` from ever naming an int → int
	// conversion, which `lowerUnaryOp` panics on.
	//
	// ⚠ The name is RESERVED wherever a call is parsed: a user function called `trunc` is
	// shadowed by this and never linked. v1 has the same property for its whole math-intrinsic
	// set, and the same absence of a diagnostic for it.
	function emitTrunc(args ValueIdArray, calleeTok Token) returns ValueId throws ParseError
		let operand = try self.numericBuiltinOperand(args, name: TruncBuiltinName, calleeTok: calleeTok)

		// Already an integer: `trunc` has nothing to truncate. See the precision note above.
		if not tagIsFloat(self.tagOf(operand)) 'identity'
			return operand
		end 'identity'

		return self.emitUnaryOp(operand, op: MaxonUnaryOp.trunc, resultTag: ValueTypeTag.integer, range: SourceRange.ofToken(calleeTok))
	end 'emitTrunc'

	// ⭐ **THE ARITY GATE EVERY NUMERIC BUILTIN PASSES**, written once and taking the arity as an
	// argument — because that is the ONLY thing that differs between `trunc`/the five arity-1 math
	// intrinsics and the arity-2 `min`. Splitting it out is what let `min` join without forking the
	// arity-1 path: the two emitters differ in how many operands they fetch and what op they build,
	// and in nothing about how a wrong count is worded.
	//
	// `name` is the callee's own bytes, so the diagnostic quotes what the user wrote — which is also
	// what lets one function serve seven names.
	function requireNumericBuiltinArity(args ValueIdArray, name ByteArray, arity ParamCount, calleeTok Token) throws ParseError
		if args.count() == arity 'matches'
			return
		end 'matches'

		throw ParseError.builtinArity(String.from(name), expected: arity, got: args.count(), line: calleeTok.line, column: calleeTok.column)
	end 'requireNumericBuiltinArity'

	// ⭐ **ONE VALIDATED NUMERIC OPERAND** — `args[index]`, checked to be a number. The operand-class
	// half of the pair above, and the half that a builtin asks once per operand rather than once per
	// call. Every numeric builtin asks it in exactly the same words, so a `min` whose SECOND argument
	// is a bool is refused with the same sentence as a `sqrt` whose only one is.
	//
	// The caller has already passed `requireNumericBuiltinArity`, which is what makes `index` in range.
	function numericBuiltinOperandAt(args ValueIdArray, index ParamCount, name ByteArray, calleeTok Token) returns ValueId throws ParseError
		let operand = try args.get(index) otherwise panic("numericBuiltinOperandAt: args.get OOB at {index} — `requireNumericBuiltinArity` has already fixed args.count() at the builtin's arity, so every index below it resolves")
		let operandTag = self.tagOf(operand)
		if not typeClassAdmits(TypeClass.numeric, tag: operandTag) 'notANumber'
			throw ParseError.builtinOperandType(String.from(name), required: "number", got: typeTagName(operandTag), line: calleeTok.line, column: calleeTok.column)
		end 'notANumber'

		return operand
	end 'numericBuiltinOperandAt'

	// The ARITY-1 pair asked together, returning the single validated operand — the shape `trunc` and
	// the five arity-1 math intrinsics all want, and the reason they each stayed one line.
	function numericBuiltinOperand(args ValueIdArray, name ByteArray, calleeTok Token) returns ValueId throws ParseError
		try self.requireNumericBuiltinArity(args, name: name, arity: NumericBuiltinArity, calleeTok: calleeTok)

		return try self.numericBuiltinOperandAt(args, index: 0, name: name, calleeTok: calleeTok)
	end 'numericBuiltinOperand'

	// `floor(x)` / `ceil(x)` / `round(x)` / `sqrt(x)` / `abs(x)` — the arity-1 FLOAT math intrinsics, written
	// ONCE for all five because everything but the opcode is identical (specs/{floor,ceil,round,sqrt,abs}.md).
	//
	// ⭐ THE ONE PLACE IT DIVERGES FROM `emitTrunc`, AND IT IS THE WHOLE DIFFERENCE BETWEEN THE TWO:
	// `trunc` LEAVES the float domain, so an integer argument is the IDENTITY and is answered with the
	// operand itself. These STAY inside it — `sqrt(16)` is 4, not 16 — so an integer argument is
	// PROMOTED, not short-circuited. That promotion is what `specs/implicit-type-conversion.md`'s
	// `math-intrinsic-int-promotion` case pins, and it is also what keeps the Std opcode's
	// f64-operand precondition true (`assertUnaryOperandDomain`). v1 promotes at the same point for
	// the same reason (`lowerMathIntrinsic`, LowerMaxonToStd.maxon:7784).
	//
	// The result is a FLOAT, per every one of the five spec files' signature (`floor(x float) float`),
	// which is why each of their tests ends on `trunc(...)` to reach an ExitCode. `specs/abs.md` says so
	// in its own words — "Currently only works with float type … For integer values, convert to float
	// first" — so `abs` needs no integer form, exactly like its four siblings.
	//
	// `name` is the callee's own bytes rather than a name derived from `op`: the caller already holds
	// them, and a diagnostic must quote what the user wrote.
	function emitMathIntrinsic(args ValueIdArray, op MaxonUnaryOp, name ByteArray, calleeTok Token) returns ValueId throws ParseError
		let operand = try self.numericBuiltinOperand(args, name: name, calleeTok: calleeTok)
		return self.emitUnaryOp(self.promoteToFloat(operand, opTok: calleeTok), op: op, resultTag: ValueTypeTag.float, range: SourceRange.ofToken(calleeTok))
	end 'emitMathIntrinsic'

	// ⭐ `__Builtins.floatToBits(x)` — the f64's IEEE-754 ENCODING as an i64. See
	// `BuiltinsFloatToBitsName` for why it exists and why there is no inverse.
	//
	// ⚠ **NO int → float PROMOTION, unlike EVERY math intrinsic beside it, and that asymmetry is the
	// point.** `sqrt(16)` means `sqrt(16.0)` because `sqrt` is a function of a NUMBER and 16 is one.
	// This is a function of an ENCODING: a promoted `floatToBits(16)` would answer the bits of 16.0
	// while READING as "the bits of the integer 16", which is a different number entirely
	// (4625196817309499392 against 16). A program that hands it an integer means something this
	// intrinsic cannot do, so it is told so rather than quietly given the other answer.
	//
	// It is also what keeps `assertUnaryOperandDomain` satisfiable: `bitcastF64ToI64` reads the float
	// register file, and the front end owns that precondition.
	function emitFloatToBits(args ValueIdArray, calleeTok Token) returns ValueId throws ParseError
		if args.count() != FloatToBitsArity 'arity'
			throw ParseError.builtinArity(String.from(BuiltinsFloatToBitsName), expected: FloatToBitsArity, got: args.count(), line: calleeTok.line, column: calleeTok.column)
		end 'arity'

		let operand = try args.get(0) otherwise panic("emitFloatToBits: args.count() == FloatToBitsArity just checked but get(0) failed")
		// ⚠ **THROUGH `floatResolvedTag`, NOT THE BARE TAG** — `emitDeadReturn`'s reason, and the one
		// declaration it matters most for is this intrinsic's only caller: `__float_toString(value
		// ParsedFloat)` is a PARAMETER of a ranged float alias, which carries a `named` tag at parse time
		// (aliases erase in `resolveTypes`, later) even though the value occupies XMM exactly as a bare
		// float does. The bare tag would refuse the one program that needs this.
		let operandTag = self.floatResolvedTag(self.tagOf(operand), nameId: self.valueNameId(operand))
		if not tagIsFloat(operandTag) 'notAFloat'
			throw ParseError.builtinOperandType(String.from(BuiltinsFloatToBitsName), required: typeTagName(ValueTypeTag.float), got: typeTagName(operandTag), line: calleeTok.line, column: calleeTok.column)
		end 'notAFloat'

		return self.emitUnaryOp(operand, op: MaxonUnaryOp.floatToBits, resultTag: ValueTypeTag.integer, range: SourceRange.ofToken(calleeTok))
	end 'emitFloatToBits'

	// ⭐ `__Builtins.bitsToFloat(bits)` — the f64 an i64's 64 bits ALREADY SPELL, and the exact inverse of
	// the door above. See `BuiltinsBitsToFloatName` for why it exists: `stdlib/Builtins.maxon` has one
	// decimal→binary64 reader and it answers BITS, so this is what lets `float.fromString` and a float
	// LITERAL be the same conversion instead of two that disagree.
	//
	// ⚠ **NO int → float PROMOTION EITHER, and here the asymmetry is not merely preserved — it is the
	// whole operation.** `emitFloatToBits` refuses an integer because promoting it would answer a
	// different question; this one refuses a FLOAT for the mirror reason. `bitsToFloat(4.0)` cannot mean
	// "the double 4.0" — the operand is an ENCODING, and a float operand has no encoding to read that is
	// not already the value it is. A program handing this a float means something the intrinsic cannot
	// do, so it is told so.
	//
	// It is also what keeps `assertUnaryOperandDomain` satisfiable from the other side:
	// `bitcastI64ToF64` reads the INTEGER register file, and the front end owns that precondition.
	function emitBitsToFloat(args ValueIdArray, calleeTok Token) returns ValueId throws ParseError
		if args.count() != BitsToFloatArity 'arity'
			throw ParseError.builtinArity(String.from(BuiltinsBitsToFloatName), expected: BitsToFloatArity, got: args.count(), line: calleeTok.line, column: calleeTok.column)
		end 'arity'

		let operand = try args.get(0) otherwise panic("emitBitsToFloat: args.count() == BitsToFloatArity just checked but get(0) failed")
		// ⚠ **THROUGH `rangedAliasResolvedTag`, NOT THE BARE TAG** — `emitFloatToBits`'s reason mirrored,
		// and the one declaration it matters most for is again this intrinsic's only caller. The bits
		// `__float_fromString` hands it come out of `__FloatTextResult.bits(value ParsedInt)`, so the
		// operand is a ranged INT alias — which keeps a `named` tag at parse time (deliberately; see
		// `floatResolvedTag`). The bare tag would refuse the one program that needs this, and would say
		// so in the words "requires a int, but its argument is int", because `typeTagName` renders
		// `named` as `int`. Resolving first fixes the verdict AND the sentence.
		let operandTag = self.rangedAliasResolvedTag(self.tagOf(operand), nameId: self.valueNameId(operand))
		if not tagIsInteger(operandTag) 'notAnInteger'
			throw ParseError.builtinOperandType(String.from(BuiltinsBitsToFloatName), required: typeTagName(ValueTypeTag.integer), got: typeTagName(operandTag), line: calleeTok.line, column: calleeTok.column)
		end 'notAnInteger'

		return self.emitUnaryOp(operand, op: MaxonUnaryOp.bitsToFloat, resultTag: ValueTypeTag.float, range: SourceRange.ofToken(calleeTok))
	end 'emitBitsToFloat'

	// ⭐ `min(a, b)` / `max(a, b)` — the ARITY-2 FLOAT MATH INTRINSICS (`specs/min.md`,
	// `specs/max.md`), and the exact mirror of `emitMathIntrinsic` one arity up: same arity gate, same
	// operand-class gate, same promotion, same explicitly-float result. Only the operand COUNT and the
	// op's tier differ, which is why the two share `requireNumericBuiltinArity` and
	// `numericBuiltinOperandAt` rather than each stating the rules again.
	//
	// ⭐ **ONE FUNCTION SERVES BOTH, PARAMETERISED BY THE OPCODE**, exactly as `emitMathIntrinsic` serves
	// five: `min` and `max` differ in nothing this function does — not the arity, not the operand class,
	// not the promotion, not the result tag — so a second copy of it would have been five identical
	// rules and one differing token.
	//
	// ⭐ **BOTH OPERANDS ARE PROMOTED, exactly as the arity-1 intrinsics promote their one.** These
	// stay INSIDE the float domain (`min(3, 5)` is `3.0`, not an integer 3), so an integer argument is
	// converted rather than short-circuited the way `trunc`'s is — and the promotion is what keeps
	// `StdBinOpcode`'s f64-operand precondition true (`appendStdBinOp`'s float-only guard). Each spec's
	// Notes say the same in its own words: *"For integer inputs, values are automatically promoted to
	// float."*
	//
	// ⭐ It reaches `emitBinOpOverCheckedOperands`, NOT `emitBinOp`: the operand rule has already been
	// asked, in the BUILTIN's words (which quote the callee the user wrote) rather than the operator's
	// (which would quote a symbol that appears nowhere in `min(3.0, 5.0)`). That door exists for
	// exactly this — a caller that has done the checking itself — and taking it is what keeps
	// `requireBinOpOperands` a single copy instead of gaining a "trust me" flag.
	//
	// ⚠ The operand ORDER is load-bearing and must not be normalised anywhere downstream: neither op is
	// commutative on NaN input. See `StdBinOpcode`'s `min`/`max` header.
	// ⭐⭐⭐ **THE MATH-INTRINSIC FAMILY'S ONE DISPATCH, ENTERED ONLY THROUGH ITS ONE ROSTER.** Every arm
	// here is reachable exactly when `calleeTakesPositionalArgsOnly` admits the name, because
	// `parseCallNamed` gates the whole function on that predicate — so the SET is written down once and
	// the emit hangs off it, rather than the two being parallel lists 33,000 lines apart that happen to
	// agree today.
	//
	// ⚠⚠ **THE PARALLEL LISTS WERE SCHEDULED TO DIVERGE, THE APPOINTMENT WAS IN THE DIARY, AND IT HAS NOW
	// BEEN KEPT.** `max` arrived at its own whitelist position, arity-2, beside `min`. Under the old shape
	// an implementer who added its emit arm and forgot the roster would have got a compiler where
	// `max(3.0, b: 5.0)` answers **E2052** — the exact wrong noun this family was moved off — as a WRONG
	// ANSWER rather than a compile error, with a green suite, because no `max` label case exists to catch
	// it. That is this project's signature bug (ONE FACT WRITTEN DOWN TWICE), and it is the same shape
	// that left the arity-1 builtins on the old noun when `min` first landed. Under THIS shape the
	// half-edit is not writable: the roster is the gate, so an emit arm alone is dead code and a roster
	// entry alone panics by name.
	//
	// ⭐ IT CLOSES BOTH DIRECTIONS, which is the whole point of the shape:
	//   • a name cannot reach an emit arm without being in the roster — STRUCTURALLY, since the gate is
	//     the roster;
	//   • a roster entry with no emit arm PANICS, loudly, on the first program that calls it — rather
	//     than falling through to `emitCall` and being reported as an undeclared function, which is what
	//     a `return`-less fallthrough would have done.
	//
	// The three emitters differ and that difference is the family's real content: `trunc` LEAVES the float
	// domain (so an integer argument is the identity), the five arity-1 intrinsics STAY inside it (so an
	// integer argument is promoted), and `min`/`max` are the arity-2 pair. See each. Note the emitters
	// number three while the roster numbers eight — the arms below are a NAME→OP map, and how many names
	// share an emitter is the point of having one.
	function emitPositionalMathBuiltin(args ValueIdArray, callee ByteArray, calleeTok Token) returns ValueId throws ParseError
		if callee.equals(TruncBuiltinName) 'truncBuiltin'
			return try self.emitTrunc(args, calleeTok: calleeTok)
		end 'truncBuiltin'

		if callee.equals(FloorBuiltinName) 'floorBuiltin'
			return try self.emitMathIntrinsic(args, op: MaxonUnaryOp.floor, name: callee, calleeTok: calleeTok)
		end 'floorBuiltin'

		if callee.equals(CeilBuiltinName) 'ceilBuiltin'
			return try self.emitMathIntrinsic(args, op: MaxonUnaryOp.ceil, name: callee, calleeTok: calleeTok)
		end 'ceilBuiltin'

		if callee.equals(RoundBuiltinName) 'roundBuiltin'
			return try self.emitMathIntrinsic(args, op: MaxonUnaryOp.round, name: callee, calleeTok: calleeTok)
		end 'roundBuiltin'

		if callee.equals(SqrtBuiltinName) 'sqrtBuiltin'
			return try self.emitMathIntrinsic(args, op: MaxonUnaryOp.sqrt, name: callee, calleeTok: calleeTok)
		end 'sqrtBuiltin'

		if callee.equals(AbsBuiltinName) 'absBuiltin'
			return try self.emitMathIntrinsic(args, op: MaxonUnaryOp.abs, name: callee, calleeTok: calleeTok)
		end 'absBuiltin'

		// The ARITY-2 intrinsics. A `MaxonBinOp` rather than a `MaxonUnaryOp`, so they reach
		// `emitBinaryMathIntrinsic`; everything else about them is the same shape as their five siblings,
		// and the two differ from each other in nothing but which opcode they name.
		if callee.equals(MinBuiltinName) 'minBuiltin'
			return try self.emitBinaryMathIntrinsic(args, op: MaxonBinOp.min, name: callee, calleeTok: calleeTok)
		end 'minBuiltin'

		if callee.equals(MaxBuiltinName) 'maxBuiltin'
			return try self.emitBinaryMathIntrinsic(args, op: MaxonBinOp.max, name: callee, calleeTok: calleeTok)
		end 'maxBuiltin'

		panic("emitPositionalMathBuiltin: '{String.from(callee)}' is in `calleeTakesPositionalArgsOnly` but has no emit arm here — the roster and the dispatch are one fact, and adding a name to the roster without an emit is the half-edit this function exists to catch")
	end 'emitPositionalMathBuiltin'

	function emitBinaryMathIntrinsic(args ValueIdArray, op MaxonBinOp, name ByteArray, calleeTok Token) returns ValueId throws ParseError
		try self.requireNumericBuiltinArity(args, name: name, arity: BinaryNumericBuiltinArity, calleeTok: calleeTok)

		let lhs = self.promoteToFloat(try self.numericBuiltinOperandAt(args, index: 0, name: name, calleeTok: calleeTok), opTok: calleeTok)
		let rhs = self.promoteToFloat(try self.numericBuiltinOperandAt(args, index: 1, name: name, calleeTok: calleeTok), opTok: calleeTok)

		return self.emitBinOpOverCheckedOperands(lhs, rhs: rhs, op: op, leftTag: ValueTypeTag.float, rightTag: ValueTypeTag.float, opTok: calleeTok)
	end 'emitBinaryMathIntrinsic'

	// `__Builtins.writeStdout(mm)` / `__Builtins.writeStderr(mm)` — **WRITE A MANAGED BUFFER'S BYTES TO A
	// STANDARD STREAM** and answer the byte count (W35). `stdlib/Print.maxon`'s and
	// `stdlib/PrintError.maxon`'s only floor: each module's one-line body hands over
	// `value.addressableBytes()` and this is what it reaches.
	//
	// ⚠ **THE INTRINSIC IS STDLIB'S FLOOR, NOT THE SURFACE** — `emitSleep`'s paragraph, one family over.
	// What a user writes is `print(s)`, an ordinary call to a corpus declaration, and the rules it meets
	// are that declaration's (its parameter type, its absent return), checked by SemanticCheck against
	// its signature like every other call's. The check below is what an intrinsic needs BECAUSE no file
	// declares it: there is no signature for the ordinary check to read.
	//
	// ⭐ **IT VALIDATES ITS ARGUMENT, AND THAT IS A CHOICE BETWEEN THE TWO REFERENCES.** The bootstrap's
	// intrinsic handler type-checks nothing (`2-Parser.cs:11451` takes any expression), so a non-managed
	// argument dies as an `InvalidOperationException` at ITS lowering rather than as a diagnostic; v1
	// checks (`SemanticCheck.validateBuiltinsIntrinsicArgs`). shv2 follows v1 — "the oracle does it" is a
	// description of a hole, not a design — through `valueIsByteArray`, the SHARED predicate
	// `String.from` and every `__Managed*` parameter already ask, rather than a fourth spelling of
	// "is this a byte-packed buffer".
	//
	// The refusal NAMES THE CALLEE (`builtinOperandType`), which is the `__Builtins.*` family's spelling
	// and the right one here: an intrinsic has no declaration, so there is no parameter name to quote that
	// the author could have written.
	function emitBuiltinsStreamWrite(args ValueIdArray, callee ByteArray, runtimeName ByteArray, calleeTok Token) returns ValueId throws ParseError
		if args.count() != StreamWriteArity 'arity'
			throw ParseError.builtinArity(String.from(callee), expected: StreamWriteArity, got: args.count(), line: calleeTok.line, column: calleeTok.column)
		end 'arity'

		let arg = try args.get(0) otherwise panic("emitBuiltinsStreamWrite: args.count() == StreamWriteArity just checked but get(0) failed")
		if not self.valueIsByteArray(arg) 'notAManagedBuffer'
			throw ParseError.builtinOperandType(String.from(callee), required: String.from(ManagedMemoryTypeName), got: self.valueDisplayTypeName(arg), line: calleeTok.line, column: calleeTok.column)
		end 'notAManagedBuffer'

		// ⭐⭐ **THE VIEW THIS WRITE WOULD HAVE CONSUMED IS FOLDED AWAY WHEN THE WRITE IS ITS ONLY CONSUMER.**
		// See `foldByteViewIntoStreamWrite` for the two conditions and for what the fold is worth.
		if let viewOpIdx = try self.stringBytesViewOps.get(arg) 'aByteViewOfAString'
			if self.pendingTempsContain(arg) and self.byteViewCallStillSitsAt(viewOpIdx) 'thisWriteIsItsSoleConsumer'
				return self.foldByteViewIntoStreamWrite(arg, viewOpIdx: viewOpIdx, runtimeName: runtimeName)
			end 'thisWriteIsItsSoleConsumer'
		end 'aByteViewOfAString'

		// The buffer is BORROWED — the runtime entry reads `buffer@0`/`length@8` through it and never takes
		// ownership — so there is no owned temporary to enrol and a literal argument needs no decref. This is
		// exactly how `__Builtins.runProcess` borrows its command line.
		var callArgs = ValueIdArray.create()
		callArgs.push(arg)
		return self.emitRuntimeCall(runtimeName, args: callArgs, resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(calleeTok))
	end 'emitBuiltinsStreamWrite'

	// ⭐⭐ **`__Builtins.ucdByteAt("__ucd_bmp", offset: cp)` — A RAW READ OF A CHECKED-IN UNICODE TABLE
	// (W64).** Serves both intrinsics, differing only in `load` — the TABLE — which is what makes the two
	// impossible to enforce differently: the sibling door is where this repo's recorded scar lives (a rule
	// applied to the one name that forced the question and left standing one name over).
	//
	// ⚠ **THE TABLE IS THE ONLY THING A CALLER STATES.** The label this demands, the leaf it emits a call
	// to and the parameter name it checks are DERIVED from `load` (`ucdTableStemOf` / `ucdRuntimeNameOf` /
	// `ucdIndexParamNameOf`), because all three are one fact about one table. Threaded as separate
	// arguments they were three chances for a call site to demand one table's label and read the other's
	// bytes — a wrong ANSWER with nothing to catch it, since neither the label check nor the emitted call
	// can see what the other was handed.
	//
	// ⭐⭐ **IT PARSES ITS OWN ARGUMENTS, AND ONLY THE LABEL IS THE REASON.** The label selects a blob the
	// compiler LINKS, so it has to be known while the call is parsed; taken off its token, a computed
	// label is structurally impossible rather than merely refused, and no dead `stringLiteral` op or
	// `.rdata` String record is minted for text that never becomes a value. v1 takes the other route —
	// an ordinary argument, recovered afterwards through `stringLiteralProvenance`
	// (`LowerMaxonToStd.maxon:1087-1096`) — which is the same refusal one pass later plus that record;
	// the bootstrap takes this one (`2-Parser.cs`'s `ParseUcdTableLoadArgs`).
	//
	// ⭐ **EVERY RULE IT APPLIES IS ASKED THROUGH THE DOOR THAT OWNS IT, NOT RESTATED HERE.**
	// `consumeArgLabel` decides E2052 for the label argument and E2053 for the index argument — the one
	// place either is decided — and this function adds only the question a declared callee's own
	// signature would have answered downstream (does the label name THIS parameter?) plus the roster
	// check, which is the security guard `UnicodeCategoryRuntime`'s header measures.
	//
	// ⚠ The result is a bare i64: `tagIsIntegral` and not `tagIsInteger`, for the reason the `readStdin`
	// arm records — a ranged alias carries the `named` tag until TypeResolution collapses it, and an index
	// is exactly the sort of value a corpus spells with one (`stdlib/helpers/string/unicodeCategory.maxon`
	// hands over a `Codepoint`).
	function parseUcdTableLoad(func IrFunction, callee ByteArray, load UcdTableStride, anchor Token) returns ValueId throws ParseError
		// The table label is the FIRST argument and is therefore positional — the language's rule for the
		// first argument of every call, inherited rather than restated. Asked BEFORE the literal is
		// consumed so a labelled one earns E2052 instead of "expected a string literal".
		_ = try self.consumeArgLabel(0 as ParamCount, rule: ArgLabelRule.ordinary)

		let labelTok = try self.consume(TokenKind.stringLiteral)
		let label = try self.decodedStringLiteralBytes(labelTok)
		let table = ucdLabel(ucdTableStemOf(load))
		if not label.equals(table.toByteArray()) 'notThisIntrinsicsTable'
			throw ParseError.ucdTableLabelUnknown(String.from(callee), table: table, label: String.from(label), line: labelTok.line, column: labelTok.column)
		end 'notThisIntrinsicsTable'

		// A call that stops after the label is a missing second argument, and `consume` says so at the `)`
		// it found. That is also the bootstrap's answer (its `Expect(TokenType.Comma)`), so the two agree
		// on the one call shape neither has a builtin-arity diagnostic for.
		try self.consume(TokenKind.comma)

		let indexTok = self.current()
		let argLabel = try self.consumeArgLabel(1 as ParamCount, rule: ArgLabelRule.ordinary)
		if not argLabel.equals(ucdIndexParamNameOf(load)) 'notTheDeclaredParameter'
			throw ParseError.builtinUnknownArgLabel(String.from(callee), label: String.from(argLabel), line: indexTok.line, column: indexTok.column)
		end 'notTheDeclaredParameter'

		let index = try self.parseValueExpression(func)
		if not tagIsIntegral(self.tagOf(index)) 'notAnIndex'
			throw ParseError.builtinOperandType(String.from(callee), required: typeTagName(ValueTypeTag.integer), got: typeTagName(self.tagOf(index)), line: indexTok.line, column: indexTok.column)
		end 'notAnIndex'

		try self.consume(TokenKind.rightParen)

		return self.emitRuntimeCall(ucdRuntimeNameOf(load), args: singletonArgs(index), resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(anchor))
	end 'parseUcdTableLoad'

	// ⭐⭐ **`__DebugStream.nameId("…")` — THE NAME IS INTERNED, THE CALL IS A MARKER.** The literal is read
	// off its token and recorded against the op this emits (`Project.debugStreamNameSites`); the op itself
	// is a zero-argument `__ds_name_id` call that `LowerMaxonToStd` replaces WHOLE with the interned index.
	// So nothing about the name survives as a value, which is the contract — see `DebugStreamNameIdCallee`.
	//
	// ⚠ **THE INDEX CANNOT BE MINTED HERE, AND THAT IS WHY THIS EMITS AN OP AT ALL RATHER THAN A CONSTANT.**
	// The numbering is a property of the PROGRAM: two files naming `"parse"` must get one id. A parser holds
	// one file's artifact and no whole-program registry it may write to (`ProgramSignatures` takes no
	// `Project`, by design), and artifacts are cached and merged in a fixed order — so the first tier that
	// can number them is the one that walks the merged module.
	//
	// ⚠ **THE LABEL RULE IS `consumeArgLabel`'s, NOT A SECOND COPY**, exactly as the UCD loads' is: the
	// first argument of every call is positional, inherited rather than restated. Asked BEFORE the literal is
	// consumed so a labelled one earns E2052 rather than "expected a string literal".
	//
	// ⚠ **AN INTERPOLATED LITERAL IS REFUSED BY THE `)` EXPECTATION AND NOT BY A RULE OF ITS OWN.** A hole
	// cannot be known while the call is parsed; `self.at(stringLiteral)` is true for `"a{n}"` too, so the
	// consume succeeds and the interpolation start is then what the `)` finds. That is the bootstrap's own
	// answer (its `Expect(TokenType.RightParen)`) and `__Builtins.ucdByteAt`'s label's, so all three shapes
	// of one mistake read the same.
	function parseDebugStreamNameId(func IrFunction, anchor Token) returns ValueId throws ParseError
		_ = try self.consumeArgLabel(0 as ParamCount, rule: ArgLabelRule.ordinary)

		// A non-literal argument is refused with the sentence `parsePanicMessage` uses for the identical
		// requirement, quoting the TYPE the author actually wrote — which means parsing the expression to
		// have a type to name. It is never emitted: the throw is unconditional on this path.
		if not self.at(TokenKind.stringLiteral) 'notALiteral'
			let argTok = self.current()
			let arg = try self.parseValueExpression(func)
			throw ParseError.builtinOperandType(String.from(DebugStreamNameIdCallee), required: StringLiteralRequirement, got: self.valueDisplayTypeName(arg), line: argTok.line, column: argTok.column)
		end 'notALiteral'

		let nameTok = try self.consume(TokenKind.stringLiteral)
		let name = try self.decodedStringLiteralBytes(nameTok)
		try self.consume(TokenKind.rightParen)

		self.artifact.recordDebugStreamNameSite(name)
		return self.emitRuntimeCall(DebugStreamNameIdMarkerName, args: ValueIdArray.create(), resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(anchor))
	end 'parseDebugStreamNameId'

	// ⭐⭐⭐ **`__Builtins.writeStdout(s.addressableBytes())` BECOMES `__write_stdout(s)` — ONE OP REWRITTEN, ONE
	// FIELD CHANGED (W35, re-aimed at W49 wave 7).** The byte value exists to satisfy a TYPE, not a USE:
	// `addressableBytes()` yields an `Array with Byte` so the value can be TYPED as one, and the write reads
	// `buffer@0` and `length@8` — the two slots a String record already carries, at the SAME offsets (see
	// `StringRuntime.buildStreamWrite`). So the whole call chain runs for a consumer that reads nothing the
	// receiver did not already have, and with it arrives `__managed_decref` and the leak gate.
	//
	// ⚠ **WHAT THAT CHAIN COSTS CHANGED AT W157 AND THE FOLD DID NOT.** It used to MINT a 48-byte `Array`
	// record — because a String record and a buffer record disagreed at `@40` (`singleByteGraphemes` against
	// `element_destroy`) — and destroy it again. A String record now IS a buffer record, so the producer is
	// one `__mm_incref` and the drop is a `__managed_decref`. The fold still removes both, plus two calls,
	// and still keeps the buffer runtime out of a program that only prints.
	//
	// MEASURED, on a program whose only call is `print`: **1,749 code bytes with the fold, 3,226 without** —
	// W35 read 1,703 / 3,178 for the same pair before the corpus grew. ⚠ Both numbers predate W157 and were
	// taken against the mint; the fold's WIN is therefore smaller than they say, and the byte counts are
	// worth re-taking by whoever next needs them to decide something.
	//
	// ⚠⚠ **THE OP IT REWRITES CHANGED AT WAVE 7 AND THE REWRITE DID NOT.** It used to be a
	// `__str_bytes_view` call a synthesized arm appended; `String.addressableBytes` is
	// `stdlib/String.maxon:181`'s now, so the producer is the CORPUS CALL `String.addressableBytes(s)`,
	// filed by `dispatchMethodOnBase`. Both ops carry one result and ONE argument, and that argument is the
	// String in both — so re-pointing the callee turns the producer into the consumer exactly as before.
	// ⇒ **The fold is NOT an inliner and does not need to be**: it never reads the callee's body, only the
	// fact that this call's one argument is the thing the write actually wants.
	//
	// ⭐ **THE REWRITE CHANGES THE CALLEE AND NOTHING ELSE.** Same result value, same single argument, same
	// labels, ranges and mint — so the shape cannot drift and there is no second op to keep in step. The
	// value's TYPE moves from the byte instance to `integer` (it is now the write's byte count) and its OWNED
	// enrolment is released, which is what removes the `__managed_decref` the statement would otherwise emit.
	//
	// ⚠⚠ **THE NON-ESCAPE CONDITION IS `pendingTempsContain`, AND IT IS A PROOF RATHER THAN A GUESS.** That
	// list holds exactly the owned temporaries no binding has taken (`removeFromPendingTemps` runs at every
	// transfer, and its own header states the two homes are disjoint by construction). So a view that reached
	// a `let`, a field, a return or a promoted scope is NOT in it and the fold declines — `arr.managed` and
	// `let b = s.addressableBytes()` both keep the record they legitimately need. The only other reader a
	// value in that list can have is the statement-end drop, which is the very op this removes.
	//
	// ⚠ **AND THE INDEX IS RE-MATCHED, NOT TRUSTED** (`opIsSingleArgCallReturning`). The filing site reads
	// `opCount()` as a FLOOR before handing the cursor to `parseCallNamed`; if that ever appends a setup op
	// first, the floor names the wrong op and the fold DECLINES rather than rewriting it.
	// ⚠ The receiver's own ownership is UNTOUCHED: the write BORROWS the String exactly as `__print_string`
	// borrowed it and as `__gt_process_run` borrows its command line, and the String is this call's argument
	// so it outlives the call by construction — the shape `stdlib/Subprocess.maxon:529-536` records a UAF for
	// (a byte view outliving its String) cannot arise, because nothing survives the call at all.
	// The fold's precondition that is about the OP rather than about ownership — asked at the call site so a
	// decline falls through to the ordinary emit, which is where the token for its range lives.
	function byteViewCallStillSitsAt(viewOpIdx OpIndex) returns bool
		return opIsDirectCallTo(try self.artifact.module.ops.get(viewOpIdx) otherwise panic("byteViewCallStillSitsAt: ops.get({viewOpIdx}) OOB — the index was filed by `dispatchMethodOnBase` as the floor the corpus call would land at, and ops are never removed"), callee: qualifiedMethodName(StringConformerName, methodName: CorpusAddressableBytes))
	end 'byteViewCallStillSitsAt'

	function foldByteViewIntoStreamWrite(view ValueId, viewOpIdx OpIndex, runtimeName ByteArray) returns ValueId
		let viewOp = try self.artifact.module.ops.get(viewOpIdx) otherwise panic("foldByteViewIntoStreamWrite: ops.get({viewOpIdx}) OOB — `byteViewCallStillSitsAt` just read the same index")
		try self.artifact.module.ops.set(viewOpIdx, value: callWithCallee(viewOp, callee: runtimeName)) otherwise panic("foldByteViewIntoStreamWrite: ops.set({viewOpIdx}) OOB — the index was read one line above")

		self.releaseOwnedTemp(view)
		self.unmarkBufferSurface(view)
		self.retypeValue(view, valueType: MaxonType.integer)
		return view
	end 'foldByteViewIntoStreamWrite'

	// `__Builtins.sleep(ms)` — **SUSPEND THE CURRENT GREEN THREAD** for `ms` milliseconds, yielding to the
	// scheduler (P1.5 mid-body-yield). It emits no `MaxonOp.call` to a user function — it routes to the
	// `__gt_sleep` scheduler runtime entry (which parks the running GT on a timer and yields). It requires
	// exactly one INTEGER argument (the duration; a float/String/bool is refused) and returns VOID, so a call
	// in value position is rejected exactly as a void user-call is.
	//
	// ⚠ **THE INTRINSIC IS STDLIB'S FLOOR, NOT THE SURFACE.** What a user writes is `sleep(ms)`, an ordinary
	// call to `stdlib/Sleep.maxon`'s declaration, and the rules it meets are that declaration's — its
	// parameter type, its absent return — checked by SemanticCheck against its signature like every other
	// call's. The checks below are what an intrinsic needs BECAUSE no file declares it: there is no signature
	// for the ordinary checks to read. So they are not a second copy of the same rule; they are the rule for
	// the one call site `stdlib/Sleep.maxon`'s body makes.
	function emitSleep(args ValueIdArray, calleeTok Token, resultUsed bool) returns ValueId throws ParseError
		if args.count() != SleepIntrinsicArity 'arity'
			throw ParseError.builtinArity(String.from(BuiltinsSleepName), expected: SleepIntrinsicArity, got: args.count(), line: calleeTok.line, column: calleeTok.column)
		end 'arity'

		let arg = try args.get(0) otherwise panic("emitSleep: args.count() == SleepIntrinsicArity just checked but get(0) failed")
		let argTag = self.tagOf(arg)
		if not typeClassAdmits(TypeClass.numeric, tag: argTag) or tagIsFloat(argTag) 'notAnInt'
			throw ParseError.builtinOperandType(String.from(BuiltinsSleepName), required: "integer", got: typeTagName(argTag), line: calleeTok.line, column: calleeTok.column)
		end 'notAnInt'

		// The intrinsic returns nothing, so using its result is using a value that is not there — the same
		// error a void user-call gets in value position.
		if resultUsed 'noValueToUse'
			throw ParseError.voidCallResultUsed(String.from(BuiltinsSleepName), line: calleeTok.line, column: calleeTok.column)
		end 'noValueToUse'

		var callArgs = ValueIdArray.create()
		callArgs.push(arg)
		return self.emitRuntimeCall(GtSleepName, args: callArgs, resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(calleeTok))
	end 'emitSleep'

	// ⭐⭐ **THE RULE EVERY ARGUMENTLESS VOID INTRINSIC IS CHECKED AGAINST, IN ONE PLACE** —
	// `emitCommandLineRuntimeCall`'s shape one family over, and landed for its stated reason: two doors
	// (`__Builtins.yield` ⇒ `__gt_resched`, `__Builtins.parallelBoundary` ⇒ `__parallel_boundary`) ask the
	// IDENTICAL two questions of the identical argument shape — *were any arguments written?* and *is the
	// nothing it returns being read?* — and a second verbatim copy of the answer is a second place for the
	// rule to drift.
	//
	// There is no operand-type check to make: `emitSleep`'s integer gate exists because `sleep` HAS an
	// argument, and these do not; the arity check alone is the whole rule for an intrinsic no file declares.
	//
	// ⚠ **THE ARITY IS A PARAMETER THOUGH BOTH CALLERS PASS 0**, exactly as `emitCommandLineRuntimeCall`'s is
	// though all three of ITS callers pass 1: the constant is what says what a given intrinsic IS, and
	// collapsing two documented constants into a literal here would put that fact in the wrong file.
	//
	// ⚠ The two callers differ in EVERYTHING the runtime does — one hands the processor to the next green
	// thread, the other returns immediately — and in nothing this function can see. That is the point: what is
	// shared is the CALL CONTRACT, and the entry point is a parameter.
	function emitVoidZeroArgIntrinsic(args ValueIdArray, builtinName ByteArray, runtimeName ByteArray, arity ParamCount, calleeTok Token, resultUsed bool) returns ValueId throws ParseError
		if args.count() != arity 'arity'
			throw ParseError.builtinArity(String.from(builtinName), expected: arity, got: args.count(), line: calleeTok.line, column: calleeTok.column)
		end 'arity'

		if resultUsed 'noValueToUse'
			throw ParseError.voidCallResultUsed(String.from(builtinName), line: calleeTok.line, column: calleeTok.column)
		end 'noValueToUse'

		return self.emitRuntimeCall(runtimeName, args: ValueIdArray.create(), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(calleeTok))
	end 'emitVoidZeroArgIntrinsic'

	// ⭐⭐ **THE RULE EVERY ARGUMENTLESS *INTEGER* INTRINSIC IS CHECKED AGAINST, IN ONE PLACE** — the exact
	// twin of `emitVoidZeroArgIntrinsic` above, and landed for its stated reason at twice the count: FOUR
	// doors (`__Builtins.commandLineCount` ⇒ `__cl_count`, `currentProcessId` ⇒ `__proc_pid`, `cpuCount` ⇒
	// `__cpu_count`, `schedMaxActiveWorkers` ⇒ `__sched_max_active_workers`) ask the IDENTICAL question of
	// the identical argument shape — *were any arguments written?* — and answer with a machine word the
	// caller reads and drops. Two of them had verbatim copies of the answer before the CPU-parallel queries
	// arrived; four would have been four places for one rule to drift.
	//
	// ⚠ **IT DIFFERS FROM THE VOID TWIN IN EXACTLY ONE THING BEYOND THE RESULT TAG: there is no
	// `resultUsed` gate.** A void intrinsic must refuse a value position because there is no value; these
	// four ANSWER one, so reading it is the point and ignoring it is legal.
	//
	// ⚠ There is nothing to own, nothing to enrol as a temporary and no buffer surface to mark, which is
	// what separates this door from `emitOwnedManagedMemoryResult`'s: that one hands back a
	// `__ManagedMemory` the caller frees, and using it here would enrol a drop against an integer.
	//
	// ⚠ **THE ARITY IS A PARAMETER THOUGH ALL FOUR CALLERS PASS 0**, exactly as `emitVoidZeroArgIntrinsic`'s
	// is: the constant is what says what a given intrinsic IS, and collapsing four documented constants into
	// a literal here would put that fact in the wrong file.
	function emitIntegerZeroArgIntrinsic(args ValueIdArray, builtinName ByteArray, runtimeName ByteArray, arity ParamCount, calleeTok Token) returns ValueId throws ParseError
		if args.count() != arity 'arity'
			throw ParseError.builtinArity(String.from(builtinName), expected: arity, got: args.count(), line: calleeTok.line, column: calleeTok.column)
		end 'arity'

		return self.emitRuntimeCall(runtimeName, args: ValueIdArray.create(), resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(calleeTok))
	end 'emitIntegerZeroArgIntrinsic'

	// ⭐⭐ **THE ARGUMENT RULE EVERY COMMAND-LINE BUILTIN IS CHECKED AGAINST, IN ONE PLACE** — the
	// `requireHandleArg`/`requireIntrinsicArgs` shape, one family over. Three doors spawn a child from a
	// command line (`__Builtins.runProcess` → `__gt_process_run`, `spawnReadLine` → `__gt_io_read`,
	// `subpSpawn` → `__gt_subp_spawn`) and every one of them asks the identical two questions of the
	// identical argument shape: exactly one argument, and it is TEXT. They had three verbatim copies of the
	// answer, which is three places for the rule to drift and the thing `requireIntrinsicArgs`'s own header
	// says this file exists to stop ("twenty doors … growing twenty spellings of the same two questions").
	//
	// ⚠ Checking it here at all is what an intrinsic needs BECAUSE no file declares it: there is no
	// signature for SemanticCheck's ordinary arity and argument-type checks to read.
	//
	// ⚠ **THE ARITY IS A PARAMETER THOUGH ALL THREE PASS 1**, exactly as `requireHandleArg`'s is though its
	// six callers pass two values: the constant is what says what a given builtin IS, and collapsing three
	// documented constants into a literal here would put that fact in the wrong file.
	//
	// ⚠ The String is BORROWED by all three entries — each reads `buffer`/`length` out of the 56-byte record
	// and never takes ownership — so this emits an ordinary `emitRuntimeCall` and enrols no drop. A future
	// command-line entry that CONSUMED its argument could not share this door.
	function emitCommandLineRuntimeCall(args ValueIdArray, runtimeName ByteArray, builtinName ByteArray, arity ParamCount, calleeTok Token) returns ValueId throws ParseError
		if args.count() != arity 'arity'
			throw ParseError.builtinArity(String.from(builtinName), expected: arity, got: args.count(), line: calleeTok.line, column: calleeTok.column)
		end 'arity'

		let commandLine = try args.get(0) otherwise panic("emitCommandLineRuntimeCall: arity just checked but get(0) failed")
		let argTag = self.tagOf(commandLine)
		if not tagIsText(argTag) 'notAString'
			throw ParseError.builtinOperandType(String.from(builtinName), required: typeTagName(ValueTypeTag.string), got: typeTagName(argTag), line: calleeTok.line, column: calleeTok.column)
		end 'notAString'

		var callArgs = ValueIdArray.create()
		callArgs.push(commandLine)
		return self.emitRuntimeCall(runtimeName, args: callArgs, resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(calleeTok))
	end 'emitCommandLineRuntimeCall'

	// Validate a streaming builtin's single INTEGER handle argument (arity 1, integer, not float) and return it —
	// the shared front of `subpReadLine`/`subpReadErrLine`/`subpCloseStdin`/`subpWait`/`subpRelease`, so the arity +
	// operand-class diagnostics are produced in one place.
	function requireHandleArg(args ValueIdArray, builtinName ByteArray, arity ParamCount, calleeTok Token) returns ValueId throws ParseError
		if args.count() != arity 'arity'
			throw ParseError.builtinArity(String.from(builtinName), expected: arity, got: args.count(), line: calleeTok.line, column: calleeTok.column)
		end 'arity'

		let handle = try args.get(0) otherwise panic("requireHandleArg: arity just checked but get(0) failed")
		// ⚠ `tagIsIntegral`, NOT `typeClassAdmits(numeric, …) and not tagIsFloat(…)`, and the composed form
		// stood here until the subprocess rung. `tagIsIntegral`'s own header names it as the spelling to
		// avoid and says why: the composition answers TRUE for `unresolved`, a tag that agrees with
		// everything by deferral — so a handle of a type nobody has settled reached the emit unrefused.
		// It is also the one predicate `requireIntrinsicArgs` asks one family over, which is what stops
		// the two doors of one question from drifting.
		if not tagIsIntegral(self.tagOf(handle)) 'notAnInt'
			throw ParseError.builtinOperandType(String.from(builtinName), required: "integer", got: typeTagName(self.tagOf(handle)), line: calleeTok.line, column: calleeTok.column)
		end 'notAnInt'

		return handle
	end 'requireHandleArg'

	// `subpReadLine(h)` / `subpReadErrLine(h)` — **READ ONE STDOUT/STDERR LINE** (P1.5 slice 1b): route to
	// `__gt_subp_read_line` / `__gt_subp_read_err_line`, which yield the green thread while the read is in flight and
	// return an OWNED String (the line INCLUDING its '\n', or "" on EOF). The result is enrolled as a pending owned
	// temporary (`trackOwnedTemp`) so ownership drops it exactly as an interpolation result — the same door.
	function emitSubpReadLine(args ValueIdArray, runtimeName ByteArray, builtinName ByteArray, calleeTok Token) returns ValueId throws ParseError
		let handle = try self.requireHandleArg(args, builtinName: builtinName, arity: SubpReadArity, calleeTok: calleeTok)
		var callArgs = ValueIdArray.create()
		callArgs.push(handle)
		// ⭐ **THE PER-LINE CAP THE READER USED TO BAKE IN.** It became a parameter of the entry point when
		// `__Builtins.subprocessReadStdoutLine(h, maxBytes)` needed to name its own, and this builtin's one
		// argument is a HANDLE — so the cap is supplied here, as the identical value, and this surface's
		// behaviour is unchanged to the byte.
		callArgs.push(self.emitLiteral(SubpMaxLineBytes as ParsedInt, valueType: MaxonType.integer, range: SourceRange.ofToken(calleeTok)))
		return self.emitOwnedRuntimeResult(runtimeName, args: callArgs, resultTag: ValueTypeTag.string, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(calleeTok))
	end 'emitSubpReadLine'

	// `subpWriteLine(h, line: s)` — **WRITE A LINE TO STDIN** (P1.5 slice 1b): route to `__gt_subp_write_line`, which
	// appends '\n' and does a synchronous WriteFile. Two arguments: an INTEGER handle and a BORROWED String line;
	// an INTEGER result (0 success, nonzero broken pipe).
	function emitSubpWriteLine(args ValueIdArray, calleeTok Token) returns ValueId throws ParseError
		// The arity and the HANDLE are `requireHandleArg`'s, exactly as its five siblings' are — this door
		// re-spelled both inline until the subprocess rung, which is how it came to carry the composed
		// integral test that function's header now records as the wrong one. Only the second argument is
		// this door's own, because only this door has one.
		let handle = try self.requireHandleArg(args, builtinName: SubpWriteLineBuiltinName, arity: SubpWriteArity, calleeTok: calleeTok)

		let line = try args.get(1) otherwise panic("emitSubpWriteLine: args.count() == SubpWriteArity just checked but get(1) failed")
		let lineTag = self.tagOf(line)
		if not tagIsText(lineTag) 'notAString'
			throw ParseError.builtinOperandType(String.from(SubpWriteLineBuiltinName), required: typeTagName(ValueTypeTag.string), got: typeTagName(lineTag), line: calleeTok.line, column: calleeTok.column)
		end 'notAString'

		var callArgs = ValueIdArray.create()
		callArgs.push(handle)
		callArgs.push(line)
		return self.emitRuntimeCall(SubpWriteLineName, args: callArgs, resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(calleeTok))
	end 'emitSubpWriteLine'

	// `subpCloseStdin(h)` (void) / `subpWait(h)` (integer exit code) / `subpRelease(h)` (void) — **THE HANDLE-OP
	// BUILTINS** (P1.5 slice 1b): one INTEGER handle argument, routing to the named `__gt_subp_*` entry. A void
	// result used in value position is rejected exactly as a void user-call is.
	function emitSubpHandleOp(args ValueIdArray, runtimeName ByteArray, builtinName ByteArray, resultTag ValueTypeTag, resultUsed bool, calleeTok Token) returns ValueId throws ParseError
		let handle = try self.requireHandleArg(args, builtinName: builtinName, arity: SubpHandleArity, calleeTok: calleeTok)

		if resultTag == ValueTypeTag.void and resultUsed 'noValueToUse'
			throw ParseError.voidCallResultUsed(String.from(builtinName), line: calleeTok.line, column: calleeTok.column)
		end 'noValueToUse'

		var callArgs = ValueIdArray.create()
		callArgs.push(handle)
		return self.emitRuntimeCall(runtimeName, args: callArgs, resultTag: resultTag, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(calleeTok))
	end 'emitSubpHandleOp'

	// ⭐⭐ **THE ARGUMENT RULE EVERY `__Builtins.subprocess*` INTRINSIC IS CHECKED AGAINST, IN ONE PLACE.**
	// Twenty intrinsics, three result shapes and five arities — but exactly ONE argument rule, because every
	// position in the contract is either a `__ManagedMemory` or a machine word. Checking it at all is what an
	// intrinsic needs BECAUSE no file declares it: there is no signature for SemanticCheck's ordinary arity
	// and argument-type checks to read. Checking it HERE is what keeps twenty doors from growing twenty
	// spellings of the same two questions — the shape `requireHandleArg` already took for the streaming
	// builtins, one family wider.
	//
	// ⚠ **THE SCALAR TEST IS `tagIsIntegral`, NOT `== ValueTypeTag.integer`**, and the narrow spelling is a
	// false refusal that has shipped twice in this file already: a value whose static type is a RANGED ALIAS
	// carries the `named` tag until TypeResolution collapses it, and `stdlib/Subprocess.maxon` spells nearly
	// every one of these arguments with one (`StdioKindValue`, `ByteLimit`, `SpawnFlagsValue`, `DurationMs`,
	// `StreamingHandle`, `Pid`). `parseBuiltinIntegerArg`'s header carries the measurement.
	//
	// ⚠ A `cstring` argument is a machine word here, and that is `parseTypeReference`'s decision rather than
	// a shortcut taken at this door: `cstring` resolves to `integer` because it IS a raw address, so
	// `config.workingDirectory.toString().cstr()` arrives INTEGRAL and there is no separate tag to demand.
	function requireIntrinsicArgs(args ValueIdArray, callee ByteArray, arity ParamCount, buffersAt IntrinsicBufferSlots, calleeTok Token) returns ValueIdArray throws ParseError
		if args.count() != arity 'arity'
			throw ParseError.builtinArity(String.from(callee), expected: arity, got: args.count(), line: calleeTok.line, column: calleeTok.column)
		end 'arity'

		var callArgs = ValueIdArray.create()
		for i in 0 upto arity 'each'
			let arg = try args.get(i) otherwise panic("requireIntrinsicArgs: args.count() == arity just checked but get(i) failed")
			if intrinsicSlotIsBuffer(buffersAt, index: i, arity: arity) 'aBuffer'
				if not self.valueIsByteArray(arg) 'notAManagedBuffer'
					throw ParseError.builtinOperandType(String.from(callee), required: String.from(ManagedMemoryTypeName), got: self.valueDisplayTypeName(arg), line: calleeTok.line, column: calleeTok.column)
				end 'notAManagedBuffer'
			end 'aBuffer' else 'aMachineWord'
				try self.requireIntrinsicMachineWordArg(arg, callee: callee, calleeTok: calleeTok)
			end 'aMachineWord'
			callArgs.push(arg)
		end 'each'

		return callArgs
	end 'requireIntrinsicArgs'

	// ⭐ **ONE MACHINE-WORD ARGUMENT OF A `__Builtins` INTRINSIC — A HANDLE, A POINTER, A BUDGET, A FLAG.**
	// Two askers that have nothing else in common: the subprocess family's per-slot walk above, and
	// `__Builtins.gtIsComplete`, whose single argument is a raw green-thread pointer. Written once because
	// the RULE is one rule — an intrinsic's word-shaped operand — and because its two halves are each a
	// measured trap: `tagIsIntegral` rather than `== ValueTypeTag.integer` (the ranged-alias false refusal
	// `parseBuiltinIntegerArg`'s header records, which has shipped twice in this file), and the CALLEE token
	// as the anchor rather than the argument (the position every `__Builtins` refusal in this table uses).
	//
	// ⚠ **IT IS NOT THE SPELLING `commandLineArg`/`readStdin` USE, AND UNIFYING THOSE IS A DIFFERENT RUNG.**
	// Those two render `got:` as `typeTagName(self.tagOf(arg))` where this renders `valueDisplayTypeName`;
	// the two agree on every case any spec pins today, and `specs-shv2/builtins-type.md`'s four disabled
	// `bits-to-float` cases already name the whole `ParseError.builtinOperandType` VOICE as its own rung
	// (it moves every `__Builtins.*` and `subp*` refusal at once, and four spec files pin the current
	// wording). Folding them in here would move pinned diagnostics for a reason unrelated to this cure.
	function requireIntrinsicMachineWordArg(arg ValueId, callee ByteArray, calleeTok Token) throws ParseError
		if not tagIsIntegral(self.tagOf(arg)) 'notAMachineWord'
			throw ParseError.builtinOperandType(String.from(callee), required: typeTagName(ValueTypeTag.integer), got: self.valueDisplayTypeName(arg), line: calleeTok.line, column: calleeTok.column)
		end 'notAMachineWord'
	end 'requireIntrinsicMachineWordArg'

	// ⭐ **A SUBPROCESS INTRINSIC WHOSE RESULT IS A MACHINE WORD OR NOTHING AT ALL** — fourteen of the twenty.
	// The arguments are BORROWED (the runtime entry reads the argv blob's `buffer`/`length` through the
	// record and never takes ownership, exactly as `__print_string` borrows its String), so there is no owned
	// temporary to enrol and a literal argument needs no decref.
	//
	// A void result used in value position is rejected exactly as a void user-call is — the three void
	// members are `subprocessReleaseHandle`, `subprocessResultRelease` and `subprocessCloseStdin`.
	function emitScalarIntrinsicCall(args ValueIdArray, callee ByteArray, runtimeName ByteArray, arity ParamCount, buffersAt IntrinsicBufferSlots, resultTag ValueTypeTag, resultUsed bool, calleeTok Token) returns ValueId throws ParseError
		let callArgs = try self.requireIntrinsicArgs(args, callee: callee, arity: arity, buffersAt: buffersAt, calleeTok: calleeTok)

		if resultTag == ValueTypeTag.void and resultUsed 'noValueToUse'
			throw ParseError.voidCallResultUsed(String.from(callee), line: calleeTok.line, column: calleeTok.column)
		end 'noValueToUse'

		return self.emitRuntimeCall(runtimeName, args: callArgs, resultTag: resultTag, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(calleeTok))
	end 'emitScalarIntrinsicCall'

	// ⭐ **A SUBPROCESS INTRINSIC WHOSE RESULT IS A FRESH OWNED `__ManagedMemory`** — the other six
	// (`subprocessResultStdout`/`Stderr`, the two `subprocessRead*Line` readers, `subprocessResolveOnPath`
	// and `subprocessLastErrorMessage`). `emitOwnedManagedMemoryResult` is what carries the three facts that
	// travel together — owned heap record, byte-PACKED instance, BUFFER SURFACE — so `String.init(managed)`
	// accepts it and its scope exit drops it, the same door `__Builtins.commandLineArg(i)` comes out of.
	function emitSubprocessManagedResult(args ValueIdArray, callee ByteArray, runtimeName ByteArray, arity ParamCount, buffersAt IntrinsicBufferSlots, calleeTok Token) returns ValueId throws ParseError
		let callArgs = try self.requireIntrinsicArgs(args, callee: callee, arity: arity, buffersAt: buffersAt, calleeTok: calleeTok)
		return self.emitOwnedManagedMemoryResult(runtimeName, args: callArgs, range: SourceRange.ofToken(calleeTok))
	end 'emitSubprocessManagedResult'

	// ⭐⭐ **E3070's RECEIVER DOOR: THE RECEIVER IS AN ARGUMENT, AND IT HAD NO ONE ASKING.** `b.wipe()`
	// destroys the element a caller borrowed out of `b.items` exactly as `wipe(b.items)` does, and the two
	// differ only in which column the array arrives in — so the receiver is offered to the conflict check as
	// the ARGUMENT 0 that `parseCallNamed` has already made it. Measured before this door existed: the
	// oracle prints 44, shv2 ran and printed **4557430888798830399** out of freed memory.
	//
	// It is settled against the STORAGE mask like every other call site, and that is what makes the door
	// work at all: `wipe`'s `writtenParamMask` is 0 by the ruling `self-keyword.md:self-with-params` pins,
	// while its `storageWrittenParamMask` carries the receiver's bit (see `IrFunction`'s table).
	//
	// The push and the record are ONE function because the receiver's argument COLUMN is what
	// `argSlotPosition` maps to a parameter, and a site recorded beside a push that had not happened yet
	// would name the wrong column. Recorded BEFORE the push, so `args.count()` is this argument's own index
	// — the identical rule `parseCallArgs` states for the source's arguments.
	//
	// ⭐⭐ **THE TWO SPANS ARE DIFFERENT TOKENS, AND THEY WERE ONE UNTIL ARR1 (a measured wrong anchor).** The
	// ARGUMENT SPAN stays the receiver's own token, because a diagnostic about argument 0 points at the value
	// the author wrote. E3070's WRITE SITE is the METHOD NAME, because its sentence names the method as the
	// instrument — *"cannot mutate 'arr' via 'insert'"* — and every other door recording one hands over
	// `methodTok` (`noteBorrowSubjectWrite`'s four container callers). Sharing one token made a DECLARED
	// mutator blame a different column from the parser-intrinsic mutator on the line above it: MEASURED when
	// `insert` left the roster, `arr.insert(…)` moved from `5:6` to `5:2` while `arr.push(…)` stayed at `5:6`,
	// and the runnable oracle anchors `insert` at the method too.
	function prependReceiverArg(func IrFunction, callee ByteArray, callAnchor Token, receiverTok Token, id ValueId, immutableName ByteArray, subjectName ByteArray, args ValueIdArray, argLabels ByteArrayArray, argRanges SourceRangeArray, argImmutableNames ByteArrayArray) throws ParseError
		self.noteReceiverBorrowSubjects(func, callee: callee, display: EmptySourceText, anchor: callAnchor, argColumn: args.count(), id: id, subjectName: subjectName)
		self.noteStorageReachingCall(func, callee: callee, argColumn: args.count(), id: id, subjectName: subjectName)
		pushCallArg(args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: argImmutableNames, value: id, label: EmptySourceText, range: SourceRange.ofToken(receiverTok), immutableName: immutableName)
	end 'prependReceiverArg'

	// ⭐⭐⭐ **RECORD THAT THIS CALL HANDS A CALLER'S OWN ARRAY TO A DECLARED CALLEE (ARR4).** The write half
	// of the ordinary-call receiver door: `noteReceiverBorrowSubjects` above records the write against THIS
	// body's outstanding borrows, and this records the fact a CALLER's borrow needs — that the storage the
	// receiver denotes belongs to one of this function's parameters, so a callee that writes it writes what
	// this function was handed. `StorageReachEdge` carries the measurement and the ruling; the fixpoint that
	// drains it is `SemanticCheck.buildParamMutationSummary`.
	//
	// Three gates, and each one is the difference between an edge and a wrong answer:
	//
	//   • **THE RECEIVER MUST BE AN ARRAY.** A `String` or `Set` receiver write frees no container element and
	//     so must record NOTHING here: `borrow-liveness.method-writing-a-string-or-set-field-is-not-a-conflict`
	//     is a legal program, and both of those surfaces ARE served by declared callees, so an ungated edge
	//     would refuse it.
	//     ⛔ **This bullet used to justify itself with "E3070 tracks array elements and nothing else", which is
	//     FALSE — a `List`, a `__ManagedList` and a `Vector` all hand out borrows E3070 tracks** (see
	//     `emitCheckedSelfFieldStore`'s gate for the two use-after-frees the identical claim left open at the
	//     STORE doors, both fixed at W-BORROW). ⭐ **The right reason it is nonetheless the `Array` and only the
	//     `Array` is a fact about WHICH RECEIVERS CAN REACH THIS DOOR AT ALL, and it is checkable.** This edge
	//     exists for a DECLARED callee, and of the four borrow-handing containers only an `Array` has any:
	//     `dispatchMethodOnBinding`'s arms intercept a `List`, a `__ManagedList`, a `Vector`, a cursor and a
	//     node handle BEFORE the declared-method path, and each dispatcher ends by refusing every name it does
	//     not serve (measured: `list.clone()` is E2015 from `dispatchListMethod`, not a corpus call). Their
	//     writes reach a caller by the DIRECT column instead — `noteBorrowSubjectWrite`'s `receiverStorage`,
	//     which is the same `subjectStorageMask` derivation this door uses and which covers the field-chain
	//     spelling `b.items.clear()` that has no argument edge (measured: refused E3070 through a callee).
	//     ⇒ A container that ever moves onto the corpus must widen this gate with the same move. **`Vector` DID
	//     (W190)**, and the widening is exactly what that sentence demanded: `dispatchVectorMethod` is gone, so
	//     `v.set(i, value: x)` is a DECLARED callee and its write reaches a caller by this argument edge and no
	//     longer by the receiver mask that dispatcher supplied.
	//   • **THE STORAGE MUST REACH A PARAMETER.** A local, a temporary and a top-level `var` reach no
	//     caller — `subjectStorageMask` is the one derivation that answers this, shared with the roster
	//     door, so the two cannot come to disagree about which storages a receiver stands for.
	//   • **A RECEIVER THAT *IS* A PARAMETER IS ALREADY AN EDGE.** `collectCallParamEdges` records it off
	//     the argument value itself; a second row would say the same thing twice and travel the same bit.
	function noteStorageReachingCall(func IrFunction, callee ByteArray, argColumn ParamCount, id ValueId, subjectName ByteArray)
		if id < func.paramCount 'theArgumentIsTheParameterAndTheEdgeExists'
			return
		end 'theArgumentIsTheParameterAndTheEdgeExists'

		if not self.valueIsCorpusServedContainer(func, value: id) 'notAContainerReceiverWhoseMembersAreDeclared'
			return
		end 'notAContainerReceiverWhoseMembersAreDeclared'

		let reach = self.subjectStorageMask(func, subjectName: subjectName)
		if reach == NoParamPositions 'reachesNoParametersStorage'
			return
		end 'reachesNoParametersStorage'

		var facts = self.borrowFactsOf(func)
		facts.storageReach.push(StorageReachEdge.create(callee, argColumn: argColumn, callerParams: reach))
	end 'noteStorageReachingCall'

	// Is the value at `id` a container whose members the CORPUS serves — the growable record or the sized one?
	// The two-part test `typeIsArrayInstance` makes of a DECLARED type, asked here of a VALUE off the published
	// per-value columns — `TypeNameId` and `GenericInstanceId` share a numeric space, so the tag is not
	// optional (that function's ⚠ block carries the measurement).
	//
	// ⚠ **THE `Vector` HALF ARRIVED WITH ITS DISPATCHER'S RETIREMENT (W190)** and not before: while
	// `dispatchVectorMethod` existed, a vector's write reached a caller through the receiver mask that door
	// passed, and an edge here would have said the same thing twice. The gate's own header names this widening
	// as the obligation a container moving onto the corpus carries.
	function valueIsCorpusServedContainer(func IrFunction, value ValueId) returns bool
		if value >= func.valueTags.count() 'noPublishedTagForThisValue'
			return false
		end 'noPublishedTagForThisValue'

		let tag = try func.valueTags.get(value) otherwise panic("valueIsCorpusServedContainer: valueTags.get OOB at {value} inside its own count()")
		let nameId = try func.valueNameIds.get(value) otherwise panic("valueIsCorpusServedContainer: valueNameIds.get OOB at {value} — the two per-value columns are pushed in lockstep")
		return self.signatures.isArrayInstanceAt(tag, nameId: nameId) or self.signatures.isVectorInstanceAt(tag, nameId: nameId)
	end 'valueIsCorpusServedContainer'

	// ⭐⭐ **WHICH STORAGES A RECEIVER STANDS FOR — and `self` stands for MORE THAN ONE.** An ordinary
	// receiver denotes one binding, so it records one site. The ENCLOSING `self` denotes the whole receiver,
	// and a borrow taken inside this same body was recorded against a FIELD's alias (`items`), never against
	// `self` — so a single site keyed on the receiver would match no borrow and the call would be waved
	// through. MEASURED, both spellings: `let s = try items.get(0) otherwise ""` then `reset()` or
	// `self.reset()`, where `reset` clears `items`, printed **4557430888798830399** out of freed memory while
	// the oracle printed 44.
	//
	// One site per self-field subject is exactly right rather than merely conservative: the callee writes
	// through the receiver PARAMETER, and every field of that receiver is storage the parameter reaches. A
	// callee that writes nothing is still filtered by the summary at the resolver, so a read-only sibling
	// call stays legal. All the sites share one token, which the resolver's ordering check permits (it
	// refuses a DECREASE, not a repeat).
	//
	// ⭐⭐ **BOTH WRITE-THROUGH-A-RECEIVER DOORS COME THROUGH IT, AND THE SITE SHAPE IS THE ONLY THING THEY
	// DIFFER BY (W61).** A CONTAINER METHOD's write is settled by the parser, so an empty `callee` records a
	// container site whose `display` names the method; a CALL ARGUMENT's is not, so a named callee records a
	// call-arg site the whole-program summary settles. The RULE — which storages the receiver reaches — is
	// ONE question, and the second copy of it is exactly what was missing: `dispatchArrayMethod` asked only
	// "did the receiver name a storage?", so `self.set(0, value: b)` inside `type Array`'s own body recorded
	// NOTHING and segfaulted, while `managed.set(0, value: b)` — the same write, one spelling over — was
	// refused. `stdlib/Array.maxon` writes the bare spelling throughout.
	function noteReceiverBorrowSubjects(func IrFunction, callee ByteArray, display ByteArray, anchor Token, argColumn ParamCount, id ValueId, subjectName ByteArray)
		if not subjectName.isEmpty() 'denotesOneNamedStorage'
			self.recordReceiverMutationSite(func, callee: callee, display: display, anchor: anchor, argColumn: argColumn, subjectName: subjectName)
			return
		end 'denotesOneNamedStorage'

		// ⭐ **THE RECEIVER'S OWN STORAGE, THROUGH THE ONE DERIVATION** (`receiverBorrowSubjectName`): an
		// unnamed receiver that IS the enclosing `self` keys on `self`, which is the subject a bare element
		// read out of that same receiver minted. Recorded BESIDE the self-field sites and not instead of
		// them — a record-collapsed `Array` borrows out of `self`, a struct with an array field borrows out
		// of the field, and a bare sibling call reaches both.
		let ownStorage = self.receiverBorrowSubjectName(subjectName, receiver: id)
		if ownStorage.isEmpty() 'denotesNoStorageThisBodyCanName'
			return
		end 'denotesNoStorageThisBodyCanName'

		self.recordReceiverMutationSite(func, callee: callee, display: display, anchor: anchor, argColumn: argColumn, subjectName: ownStorage)

		// The count is taken FIRST: the recorder resolves each name back through `borrowSubjectIdOf`, which
		// appends to this very list for a name it has not seen — and every name here is one it has, so it
		// cannot grow, but reading the bound once says so rather than relying on it.
		let subjectCount = func.borrowFacts.subjects.count()
		for k in 0 upto subjectCount 'eachSubjectOfThisBody'
			let subject = try func.borrowFacts.subjects.get(k) otherwise panic("noteReceiverBorrowSubjects: subjects.get OOB at {k} inside count()")
			// ⚠ **THE NAME IS COPIED, WHICH IS WHAT TURNS THE BOUND ABOVE FROM A PREMISE INTO AN
			// ARGUMENT.** The recorder resolves each name through `borrowSubjectIdOf`, which APPENDS to this
			// very list for a name it has not seen — so the loop is reading elements out of an array its own
			// body can grow. The count taken first says it cannot happen here; the copy means nothing has to
			// believe that. One `ByteArray` per self-field subject, in a body that has any at all.
			let isSelfField = subject.isSelfField
			let subjectOwnName = subject.name.clone()
			if isSelfField 'fieldOfTheEnclosingReceiver'
				self.recordReceiverMutationSite(func, callee: callee, display: display, anchor: anchor, argColumn: argColumn, subjectName: subjectOwnName)
			end 'fieldOfTheEnclosingReceiver'
		end 'eachSubjectOfThisBody'
	end 'noteReceiverBorrowSubjects'

	// Which of the two site shapes a receiver's write takes — the ONE fork, so the fan-out above states its
	// rule once for both doors. An EMPTY callee means the parser already settled that this is a write (a
	// container method); a named one means only the callee's own body can say, and the site carries what
	// `mutationSiteWrites` needs to ask it.
	function recordReceiverMutationSite(func IrFunction, callee ByteArray, display ByteArray, anchor Token, argColumn ParamCount, subjectName ByteArray)
		if callee.isEmpty() 'settledAtTheParse'
			self.recordContainerMutationSite(func, subjectName: subjectName, display: display, anchor: anchor)
			return
		end 'settledAtTheParse'

		self.recordCallArgMutationSite(func, callee: callee, anchor: anchor, argColumn: argColumn, argLabel: EmptySourceText, subjectName: subjectName)
	end 'recordReceiverMutationSite'

	// Is this receiver value the ENCLOSING function's own `self` parameter? Derived from the binding rather
	// than assumed of a token, so both spellings answer alike: `self.reset()` resolves `self` to that value
	// and a bare sibling call (`reset()`) is given it by `implicitSelfReceiver`. False outside an instance
	// method, where there is no receiver to be.
	function receiverIsEnclosingSelf(id ValueId) returns bool
		return id == (try self.scope.lookupValue(SelfParamName) otherwise return false)
	end 'receiverIsEnclosingSelf'

	// Parse a comma-separated argument list into the parallel `args`/`argLabels`/
	// `argRanges` lists (all empty for `()`). The caller has consumed `(`; this leaves
	// the cursor on `)`. Each argument is an expression, optionally prefixed by a
	// `name:` label — the FIRST argument must be positional and every later argument
	// must be labelled (`consumeArgLabel` enforces both, positioned at the offending
	// token) — except under the other two `ArgLabelRule`s, which lift the first-argument
	// rule for an interface / type-parameter receiver and switch labels off entirely for a
	// bare builtin (see there). Whether a `name:` label actually
	// matches a parameter is a check for whoever holds the callee's parameter names —
	// SemanticCheck for a direct call, `slottedWitnessArgs` for a witness dispatch.
	//
	// `callee`/`anchor` name the call being parsed, for the E3070 borrow check: a free call
	// whose argument names a borrowed collection is a mutation site only if the CALLEE writes
	// that parameter's storage, so the site has to be recorded against a name, here, where the
	// argument's own tokens are still in hand (`BorrowCheck.maxon`).
	function parseCallArgs(func IrFunction, callee ByteArray, anchor Token, args ValueIdArray, argLabels ByteArrayArray, argRanges SourceRangeArray, argImmutableNames ByteArrayArray, rule ArgLabelRule) throws ParseError
		if self.at(TokenKind.rightParen) 'noArgs'
			return
		end 'noArgs'

		// ⚡ **THE CALLEE'S BY-REFERENCE FACTS ARE READ ONCE PER CALL, NOT ONCE PER ARGUMENT** — `byRefOf`
		// returns a union (a heap box) and `forwardingIsLiveFor` is a map lookup, and neither answer can change
		// between two arguments of one call. Asked inside the loop they were an allocation per argument of
		// every call in the program; hoisted, a program that uses no pass-by-reference pays one `count()` per
		// call and builds nothing.
		// ⚡ ONE gate for BOTH, and the second half was ungated until the PBR-2 review: `forwardingIsLiveFor`
		// is a `ByteArray`-keyed map lookup returning a boxed optional, so every call in every program paid it
		// — while `calleeTakesArgumentByRef` cannot read it at all once `calleeByRef` is `allByValue`, which
		// is exactly when the gate is shut. Hoisting it under the same `count()` is answer-preserving.
		let programUsesByRef = self.signatures.programTakesAParamByRef()
		let calleeByRef = self.signatures.byRefOf(callee) if programUsesByRef else CalleeByRefParams.allByValue
		let calleeForwardingIsLive = programUsesByRef and self.signatures.forwardingIsLiveFor(callee)

		var argIndex = 0 as ParamCount
		while true 'argLoop'
			// The argument's leading token — the label token when labelled, else the
			// value's first token — anchors this argument's diagnostic span.
			let argFirstTok = self.current()
			let label = try self.consumeArgLabel(argIndex, rule: rule)
			let valueTok = self.current()
			let valueStart = self.pos
			// ⭐⭐ **PBR-2: DOES THIS POSITION TAKE ITS ARGUMENT BY REFERENCE?** Asked BEFORE the value is
			// parsed, because the answer changes what the parse must produce — an address rather than a value —
			// and a read that has already materialized the contents cannot be un-emitted. The label and the
			// column are both in hand here, which is what makes the position answerable this early.
			let byRefPosition = calleeTakesArgumentByRef(calleeByRef, argIndex: args.count(), label: label, forwardingIsLive: calleeForwardingIsLive)
			// Only an argument that is EXACTLY a name can hand over a cell; anything else is an r-value and
			// gets a scratch cell below. Requesting it here (rather than testing afterwards) is what lets the
			// read door skip its load entirely.
			var requestedTheCell = false
			if byRefPosition and self.argumentIsExactlyANameAt(valueStart) 'mayHandOverACell'
				self.cellArgumentTokenIndex = valueStart
				requestedTheCell = true
			end 'mayHandOverACell'
			// ⚠ The blame name is CLEARED before the argument is parsed — by `parseValueExpression` itself,
			// which is the one door every value expression comes through and therefore the one place that
			// clear can be stated once. See `bareArgImmutableName` for what the clear is for.
			// `parseValueExpression` (the climber plus a trailing ternary — `f(a if c else b)`), not
			// `parseExpression`: an argument is parsed INSIDE an expression that has already seeded
			// `currentBlock`, and re-seeding it would discard a short-circuit an EARLIER argument performed.
			let value = try self.parseValueExpression(func)
			// The read CLEARS the request when it takes it, so this is how the call site learns whether it was
			// handed a cell. Cleared unconditionally either way: a request the read declined (the name was not
			// cell-resident) must not outlive this argument.
			let handedTheCell = requestedTheCell and self.cellArgumentTokenIndex == NoCellArgumentRequest
			self.cellArgumentTokenIndex = NoCellArgumentRequest

			// ⭐⭐ **AN R-VALUE AT A BY-REFERENCE POSITION GETS A SCRATCH CELL** — a literal, an expression, a
			// fresh call result, or a binding that is not cell-resident (a `let`, which `checkImmutableArgToMutatingParam`
			// refuses with E3019 a phase later — the spill keeps the IR well-formed until that diagnostic is
			// reported, exactly as every other recovery here does).
			//
			// ⚠⚠ **`let` IS NOT THE ONLY NON-CELL BINDING THAT LANDS HERE, AND THE OTHERS ARE NOT REFUSED —
			// THEY LOSE THE WRITE SILENTLY.** A MODULE-LEVEL `var` and a SELF-FIELD alias are both mutable, so
			// no diagnostic fires, and neither is cell-resident: `collectCellLocalNames` decides LOCAL names
			// and `declareCellLocal` installs a cell only at a local `var`'s declaration. Each therefore
			// spills its VALUE into a scratch cell the callee then writes and the caller never reads back.
			// MEASURED on this tree: `var g = 0` at module level plus `setTo99(g)` prints `g=0`, and a
			// `setTo99(count)` on a self field leaves the field 0.
			//
			// ⚠ **IT IS NOT A PBR-2 REGRESSION — the C# bootstrap answers `g=0` and `field=0` on the identical
			// two programs**, so the gap is the language's, shared with the reference, and predates the cell
			// design. It is recorded HERE because this is the line that decides it, and because the shape the
			// two storage kinds need is a WRITE-BACK or a cell of their own — a rung, not a clause.
			let passed = try self.byRefArgumentValue(value, byRefPosition: byRefPosition, handedTheCell: handedTheCell, anchor: valueTok)

			// ⭐ **E3077's ARGUMENT DOOR.** `f(x)` may write `x` — whether it does is the callee's
			// `writtenParamMask`, a whole-program fact SemanticCheck settles a phase after this diagnostic is
			// decided — so a `var` handed to a call has exercised its mutability. Asked HERE, with the
			// argument's own tokens still in hand and before anything moves the cursor, for the reason
			// `bareArgImmutableName` gives. See `VarInfo.mutabilityExercised` for why both references make
			// the same conservative choice and why matching them is load-bearing.
			if self.argWasBareName(valueTok, valueStart: valueStart) 'bareNameArgument'
				self.markNameMutabilityExercised(valueTok.value)
			end 'bareNameArgument'

			// A capturing closure handed DOWN to a direct callee is now SUPPORTED (P1.5-A2b-2): its environment
			// travels as the companion argument the lowering appends at the function-typed parameter position
			// (`LowerMaxonToStd.appendCalleeEnvArgs`), so the callee's `f(x)` reads the right env. No refusal
			// here. (A capturing closure at a NON-function parameter is a type error caught by SemanticCheck.)
			// ⭐ E3070's call-argument door, taken BEFORE the push so the column index it records is this
			// argument's own — the receiver a method call prepended included, which is the index
			// `argSlotPosition` maps to a parameter position (`noteBorrowSubjectCallArg`).
			self.noteBorrowSubjectCallArg(func, callee: callee, anchor: anchor, argColumn: args.count(), argLabel: label, valueStart: valueStart)

			pushCallArg(args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: argImmutableNames, value: passed, label: label, range: SourceRange.ofToken(argFirstTok), immutableName: self.expressionImmutableBlame(valueTok, valueStart: valueStart, value: value))
			argIndex = argIndex + 1

			if not self.at(TokenKind.comma) 'endArgs'
				break
			end 'endArgs'
			try self.consume(TokenKind.comma)
		end 'argLoop'
	end 'parseCallArgs'

	// What this argument actually hands the callee: the value as parsed when the position takes it by value,
	// the binding's own cell when the read handed one over, and a fresh SCRATCH cell when the position is
	// by-reference and there was no cell to hand. Split out so the argument loop states the rule once and the
	// three outcomes are named rather than nested.
	function byRefArgumentValue(value ValueId, byRefPosition bool, handedTheCell bool, anchor Token) returns ValueId throws ParseError
		if not byRefPosition or handedTheCell 'nothingToMaterialize'
			return value
		end 'nothingToMaterialize'

		return try self.materializeByRefScratchCell(value, anchor: anchor)
	end 'byRefArgumentValue'

	// ⭐⭐ **THE NAME AN E3019 WOULD BLAME FOR THE ARGUMENT JUST PARSED — and the ONE token that makes the
	// question answerable.** An argument names an immutable binding only if it IS that name and nothing
	// else: `f(a)` blames `a`, while `f(a + 1)`, `f(g(a))` and `f(a.count())` all hand over a value the
	// binding does not own and must blame nothing.
	//
	// The test is the CURSOR, not a lookahead: an argument that consumed exactly ONE token, and that token
	// an identifier, is a bare name. A predicate run BEFORE `parseValueExpression` would be a token-shape
	// guess sitting in front of the resolution it guards — the shape this file has already paid for three
	// times — whereas asking afterwards is a statement about what the resolution actually did.
	//
	// The ANSWER comes from the resolution itself (`Parser.lastBareBindingImmutableName`, written by
	// `parseVariableReference` and by nothing else), so the argument rule and the receiver rule reach the
	// same `immutableReceiverNameOf`. `parseCallArgs` clears it before every argument, so a one-token
	// identifier that resolved through some OTHER primary path — one that publishes nothing — answers
	// "writable" rather than inheriting a neighbouring argument's name.
	//
	// ⚠ **A BARE NAME MAY BE SPELLED WITH A KEYWORD (D8), so the one-token test asks `tokenCanBeAName`** —
	// the LAST copy of "is this a bare name?" that still said `identifier` after D8 taught the other twelve
	// otherwise, and the one whose asker is the resolution itself: `parseVariableReference` publishes
	// `lastBareBindingImmutableName` for a keyword-named binding, and this gate then threw that answer away.
	// The consequence is a MISSING E3019 — a mutation through an immutable binding accepted because of how
	// the binding is SPELLED — which is a wrong answer, not a compile error. Widening claims nothing extra:
	// the name still comes from the resolution, `parseCallArgs` clears it before every argument, and a
	// keyword that resolved through some other primary path publishes nothing and still answers "writable".
	// ⚠ Honest scope: I could not construct a program that REACHES the blame with either spelling (the
	// identifier control does not raise E3019 either on every shape I tried), so this closes an asymmetry
	// rather than a reproduced defect.
	function bareArgImmutableName(valueTok Token, valueStart TokenIndex) returns ByteArray
		if not self.argWasBareName(valueTok, valueStart: valueStart) 'notABareName'
			return EmptySourceText
		end 'notABareName'

		return self.lastBareBindingImmutableName
	end 'bareArgImmutableName'

	// Did the argument just parsed consist of exactly ONE token, and was that token a name? The cursor test
	// the block above argues for, lifted because E3077's argument door asks the identical question of the
	// identical position — "did this argument hand a BINDING over, or a value the binding does not own" —
	// and the two verdicts must not be free to disagree about what a bare name is.
	function argWasBareName(valueTok Token, valueStart TokenIndex) returns bool
		return tokenCanBeAName(valueTok) and self.pos == valueStart + 1
	end 'argWasBareName'

	// ⭐⭐ **THE E3019 BLAME OF AN EXPRESSION JUST PARSED — the one-token test, OR the merge it came out of.**
	//
	// ⭐ **A LAUNDER IS NOT A LOOPHOLE.** `grow(g)` on a `let` is refused, so `grow(g if flag else g)` — the
	// SAME binding, reached through a merge that copies nothing — must be refused too. The one-token test
	// alone cannot say so: an inline `if` is three tokens, so `bareArgImmutableName` answers empty and the
	// check skips the argument entirely. Until it was refused this was a MEMORY-SAFETY defect and not a
	// message one: the accepted program wrote into the literal's read-only `.rdata` record on x64 (an access
	// violation) and into a record shared by every use of that literal on wasm32-wasi.
	//
	// So the answer has two sources, asked in the order the language means them: the expression IS a bare
	// immutable name, or it is a MERGE that joined one (`mergeImmutableBlame`, recorded per ARM at the three
	// merge sites). ⚠ **The merge half must be keyed on the phi and never on the arm's own value** — see
	// `MergeBlameMap` for the measured reason a per-value mark is unsound.
	//
	// It is the same three call sites' one question: a call ARGUMENT, a ternary ARM, and a `match … gives`
	// arm each ask "what would a write through this value be blamed on?", and an arm may itself be a nested
	// merge — which is exactly what the second source answers.
	function expressionImmutableBlame(valueTok Token, valueStart TokenIndex, value ValueId) returns ByteArray
		let bare = self.bareArgImmutableName(valueTok, valueStart: valueStart)
		if not bare.isEmpty() 'blamedByName'
			return bare
		end 'blamedByName'

		let merged = self.mergeBlameOf(value)
		if not merged.isEmpty() 'blamedByMerge'
			return merged
		end 'blamedByMerge'

		// ⭐⭐ **A THIRD SOURCE, AND IT IS THE ONE WITH NO NAME TO GIVE (W117).** `bump(Box.get())` hands a
		// `let` global's record straight to a callee that writes it, through an expression that is neither a
		// bare binding nor a merge — so both tests above answer empty and the call would go unchecked. The
		// value itself knows, because the call's result was marked where the callee's name was still in hand
		// (`emitCall`), so the mark is asked directly here.
		//
		// ⚠ **THE BLAME IS A NOUN AND NOT A NAME, DELIBERATELY.** There is no binding to point at, and
		// reconstructing the source text of the expression would be a second renderer of what the author wrote.
		// The sentence it lands in — "cannot pass '…' to function that mutates parameter 'b'" — is true of the
		// noun, and the LINE is the call's own.
		if self.immutableGlobalReads.contains(value) 'aliasesAnImmutableGlobal'
			return ImmutableGlobalAliasBlame
		end 'aliasesAnImmutableGlobal'

		return EmptySourceText
	end 'expressionImmutableBlame'

	// Consume and validate an optional `name:` label on the next argument, returning the
	// label text (the empty string when unlabelled). The FIRST argument (`argIndex == 0`)
	// must be positional — a label there is E2052; every later argument must be labelled —
	// a bare value there is E2053. A `name:` label is two tokens (identifier + colon); a
	// bare value leaves the cursor untouched. (Whether the label names a real parameter
	// is checked later — by SemanticCheck for a direct call, by `slottedWitnessArgs` for a
	// witness dispatch.)
	//
	// ⭐ **`rule` RELAXES THE FIRST-ARGUMENT RULE FOR AN INTERFACE / TYPE-PARAMETER RECEIVER**
	// (`firstMayBeNamed`, P1.7a slice 2b-vi). `specs/interface-dispatch.md` makes the E2052 check apply
	// only to concrete-struct / enum / builtin receivers, so a witness dispatch's first argument may carry
	// a label (`self.item.add(a: 1, b: 2)`) — the concrete receiver whose declaration would forbid it is
	// exactly what the shared body does not know. v1 spells the same exemption the same way, as a flag on
	// its method-call site (`Parser.maxon:14409`: "the receiver may be interface/type-param-typed, which
	// permits a named first arg"). It is a PARAMETER rather than a fork of this function because the
	// E2053 half is unrelaxed and must stay one copy: only the first argument's verdict moves.
	// ⭐ **A LABEL MAY BE SPELLED WITH A KEYWORD (D8), because the PARAMETER it names may be** —
	// `combine(1, enum: 2)` against `function combine(type Integer, enum Integer, …)`. A parameter that
	// cannot be labelled cannot be passed, so the declaration position and this one are one rule; the
	// trailing `:` is what makes the reading unambiguous, since no argument VALUE is a bare keyword
	// followed by a colon.
	function consumeArgLabel(argIndex ParamCount, rule ArgLabelRule) returns ByteArray throws ParseError
		let labelTok = self.current()
		let isNamed = tokenCanBeAName(labelTok) and self.peekKind() == TokenKind.colon

		// The BUILTIN regime is decided WHOLE, before position is looked at, because position is not
		// what makes a label wrong here: a callee with no declaration has no parameters, so a label at
		// ANY index names one that does not exist and that nothing downstream will ever check. It
		// returns rather than falling through to the two rules below — neither of which could state
		// this, since both of their sentences promise that SOME argument position takes labels. See
		// `argLabelRuleForCallee`.
		if rule == ArgLabelRule.allPositional 'builtinArgs'
			if isNamed 'labelled'
				throw ParseError.builtinArgNamed(labelTok.line, column: labelTok.column)
			end 'labelled'

			return EmptySourceText
		end 'builtinArgs'

		// ⭐ **EVERY REGIME IS NAMED, and that is the whole reason this is an enum and not a boolean.**
		// A bare `rule == ArgLabelRule.ordinary` would leave `firstMayBeNamed` as whatever fell through —
		// never mentioned, never checked — so a FOURTH regime added later would silently inherit its
		// behaviour instead of failing to compile. Read as a `match`, the enum keeps the promise its
		// header makes: exactly the states that exist, each with an answer someone wrote down.
		let firstArgMayBeNamed = match rule 'firstArgRegime'
			ordinary gives false
			// A witness dispatch through an interface / type-parameter receiver: the concrete receiver
			// whose declaration would forbid a labelled first argument is exactly what the shared body
			// does not know (P1.7a slice 2b-vi).
			firstMayBeNamed gives true
			// Unreachable — the builtin regime is decided WHOLE and returned above, before position is
			// looked at, because for a builtin no position takes a label.
			allPositional panic("consumeArgLabel: `allPositional` returns above — a builtin's label verdict is decided whole, before argIndex is consulted, so it must never reach the first-argument rule")
		end 'firstArgRegime'

		if argIndex == 0 and isNamed and not firstArgMayBeNamed 'firstNamed'
			throw ParseError.firstArgNamed(labelTok.line, column: labelTok.column)
		end 'firstNamed'
		if argIndex > 0 and not isNamed 'missingLabel'
			throw ParseError.argMissingLabel(labelTok.line, column: labelTok.column)
		end 'missingLabel'

		// Unlabelled past those two rejects means a legal POSITIONAL first argument; the cursor still sits
		// on the value, so nothing is consumed.
		if not isNamed 'positional'
			return EmptySourceText
		end 'positional'

		try self.consumeNameToken(NamePosition.declaration)
		try self.consume(TokenKind.colon)
		return labelTok.value
	end 'consumeArgLabel'

	// Append a `call` op defining a fresh result value; return the ValueId it defines. The
	// callee is a `ByteArray` — a slice of its identifier token for a free call, a freshly built
	// mangled name for a qualified one; the call span runs from `anchor` through the closing `)`
	// (the conventional call anchor).
	//
	// The result is minted BEFORE the op is appended, because the op stores its id — and it is
	// minted through `mintCallResult`, which can REFUSE (a void call in value position), so nothing
	// is emitted for a call the program is not allowed to make.
	//
	// `spelling` says whether those callee bytes are the AUTHOR'S or the COMPILER'S, which is the one
	// question the reserved-space door cannot answer from the name — see `CalleeMint`.
	function emitCall(callee ByteArray, anchor Token, args ValueIdArray, argLabels ByteArrayArray, argRanges SourceRangeArray, argImmutableNames ByteArrayArray, rparenTok Token, resultUsed bool, constructorInstance ConstructorInstance, mint CalleeMint) returns ValueId throws ParseError
		try requireCalleeIsNotReservedName(callee, anchor: anchor, fileDeclaresReservedNames: self.declaresCompilerInternalNames, isStdlibSource: self.isStdlibSource, mint: mint, signatures: self.signatures)
		// ⭐ **W4′ — THE ARGUMENT TWIN OF THE RETURN DOOR (W192 review), asked here because this is the one
		// line every direct, method and static call passes with the whole argument list in hand.**
		// Ahead of the mint and the consume so a refused call emits nothing — the discipline
		// `applyCallerConsume` states below.
		try self.refuseASizedContainersRecordEscapingIntoACall(args, argRanges: argRanges)
		// ⭐ **AN OMITTED ARGUMENT IS SUPPLIED HERE, BEFORE ANYTHING ELSE READS THE ARGUMENT LIST** (BATCH2
		// slice 4). Every direct, method and static call funnels through this one line, so the fill needs no
		// second copy at the method / static / operator-desugar doors — and by the time `applyCallerConsume`
		// and the emit below see `args`, a defaulted argument is indistinguishable from a written one, which
		// is what makes the consume transfer, the drop enrollment and `slotCallArgs`' arity gate correct for
		// it with no change to any of them.
		let argDefaultSlots = try self.fillOmittedArgDefaults(callee, anchor: anchor, args: args, argLabels: argLabels, argRanges: argRanges)
		let result = try self.mintCallResult(callee, anchor: anchor, resultUsed: resultUsed, args: args, argLabels: argLabels, argDefaultSlots: argDefaultSlots)
		let opaqueWordReading = self.retypeOpaqueMethodResult(result, callee: callee, args: args)
		// ⭐⭐ **THE DROP ENROLMENT COMES AFTER THE RETYPE, AND THAT ORDER IS THE WHOLE OF A5o.** It used to sit
		// in the mint's own tail, where the tag was still the opaque `T` — and an opaque tag ALWAYS answers "owns
		// nothing" (`valueIsManagedHeap` tests byte-record and aggregate tags, and `typeParameter` is neither).
		// So the retype was forced to decline for a managed concrete argument rather than move a decision that
		// had already been taken, and `bx.echo(got)` on a `Box with Alpha` was `E3005 … got 'type parameter'` for
		// a value whose type the instance fixes. Asked HERE the tag is the concrete one, so the two halves agree.
		// See `enrolOwnedCallTemp` for why re-ordering it can only ADD enrolments.
		//
		// ⭐⭐ **EVERY CALL RESULT IS ADOPTED, INCLUDING A SUBSTITUTED BARE-`T` ONE (P1.7 slice 3b-vi-a).** The
		// caller used to take its OWN reference to a bare-`T` result instead, on the premise that a shared
		// generic body cannot classify one and so hands it back UNREFERENCED. That premise is a property of the
		// DECLARED type and the obligation is a property of the RETURNED VALUE, and the two came apart the
		// moment a body returned something it already owned: `return fresh()` through a `returns T` handed over
		// a real `+1`, the caller minted a second, and one record leaked per call (exit 101, no wrong answer).
		// There is no convention under which the caller can take that reference — a body that returns a value
		// it created has nowhere to put the one it holds — so the callee takes it for every shape instead, in
		// `emitOwnedValueReturn`, through the enclosing instance's descriptor for the one shape it cannot
		// classify. A `returns T` is now an ordinary `+1` hand-off and is adopted here like every other.
		self.enrolOwnedCallTemp(result)
		// ⭐ **A CALLEE THAT DECLARED `returns __ManagedMemory` YIELDS THE BUFFER SURFACE (A2j).** Read HERE
		// rather than inside the mint chain because the mint's tail (`mintOwnedCallResult`) is handed a
		// `MaxonType` and not the callee name — and the name is the only thing that still knows the spelling,
		// the alias having erased it. Every direct, method and static call funnels through this one line.
		self.markDeclaredSurface(result, declared: self.signatures.declaredReturnSurface(callee))
		self.recordCallResultInstanceAlias(result, callee: callee)
		// ⛔ **AND NO SIZED-CONTAINER MARK, for `bindParameters`' recorded reason**: a `returns ElementMemory`
		// hands back the record OR a view of it and the declaration cannot tell which, so the fact is refused
		// at the RETURN inside the declaration (`emitOwnedValueReturn`) rather than inferred at the call.
		// ⭐⭐ **A CALLEE THAT MAY HAND BACK A `let` GLOBAL'S RECORD MARKS ITS RESULT (W117), HERE FOR THE LINE
		// ABOVE'S REASON**: this is the one place every direct, method and static call passes with the callee's
		// NAME still in hand, which is what the whole-program answer is keyed by. From here the value is
		// indistinguishable from a global read taken in this very function — the same mark, so the same write
		// doors refuse it and the same merge propagation carries it.
		//
		// ⭐ **AND A SYNTHESIZED DEFAULT HELPER IS A CALLEE LIKE ANY OTHER HERE**, which is what makes `f()`
		// carry the same mark `f(A)` carries: `emitDefaultArgValue` fills the omitted argument through this
		// very door with the helper's name in hand.
		if self.functionMayReturnAGlobalAlias(callee) 'mayAliasAnImmutableGlobal'
			self.markImmutableGlobalRead(result)
		end 'mayAliasAnImmutableGlobal'
		// The CALLER SIDE of consume-by-use (P1.4a wave 2, P1.6-B2): an owned argument at a position the callee
		// CONSUMES — a plain-field store, or a type-parameter field of a concrete instance whose argument owns
		// managed heap — is moved (poisoned / drained); a borrowed one is refused. Done BEFORE the op is
		// emitted so a refused call emits nothing.
		try self.applyCallerConsume(callee, args: args, argLabels: argLabels, argRanges: argRanges, anchor: anchor, constructorInstance: constructorInstance)
		// ⭐ The provenance mark's second half (BATCH41 review): the arguments are settled, so the flag
		// `referenceOrMarkOpaqueFeed` armed now has a RESULT to travel on. Cleared whether or not it was set, so
		// one call's answer cannot stand in for the next's.
		if self.callReferencedAnOpaqueFeedSlot 'thisCallReferencedASlot'
			self.markRecordHoldingReferencedOpaqueSlot(result)
			self.callReferencedAnOpaqueFeedSlot = false
		end 'thisCallReferencedASlot'

		self.recordConstantArgRangeChecks(callee, args: args, argLabels: argLabels, anchor: anchor)
		self.recordOpaqueArgRangeChecks(callee, args: args, argLabels: argLabels, anchor: anchor, constructorInstance: constructorInstance)
		let opIdx = self.artifact.module.ops.count()
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.call(result, callee: callee, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: settledImmutableArgNames(argImmutableNames), argDefaultSlots: argDefaultSlots, mint: mint), range: SourceRange.between(anchor, last: rparenTok))
		// ⭐ **THE OTHER ROUTING DOOR FOR A BLOCK-FORM `try` BODY** — this one carries every call the author
		// spelled (free, method, static), so a bare call to a declared throwing function inside such a body
		// reaches the shared handler. `result` rides along because an ADOPTED managed one is already enrolled
		// as an owned temp by `enrolOwnedCallTemp` above, and it must not be dropped on the error edge — see
		// `routeBareThrowingCallToTryBlock`. An opaque `T` result is enrolled on the same terms, so the two ask
		// one question.
		self.routeBareThrowingCallToTryBlock(callee, opIdx: opIdx, result: result)

		// ⭐⭐ **THE OPAQUE WORD IS READ BACK AS THE FLOAT THE RECEIVER'S INSTANCE SAYS IT IS** —
		// `retypeOpaqueReturnValue`'s answer, spent HERE because the reinterpretation is an op and an op must
		// come after the `call` that defines its operand. Everything above deliberately keeps working on the
		// CALL's own value: the drop enrolment, the declared surface, the caller-consume and the throwing-call
		// routing are all facts about the callee's hand-off, and the bitcast is a fact about how this caller
		// reads it. Only the value handed BACK changes.
		//
		// ⚠ **THE `try` DOOR ALREADY KNOWS THIS SHAPE, WHICH IS WHY THIS IS SAFE FOR A THROWING CALLEE.**
		// `rewriteLastCallToTryCall` steps back over exactly one trailing reinterpretation whose operand is the
		// preceding op's result (`tryTargetCallOpIndex`) — built for `emitContainerElementAccessor`'s float
		// element, and true of BOTH readings below for the same reason: the reinterpretation is part of the
		// call's RESULT PRODUCTION, not a second expression the `try` was applied to. Both members are in
		// `unaryOpProducesACallResult`, which is that door's membership list.
		let callRange = SourceRange.between(anchor, last: rparenTok)
		match opaqueWordReading 'reading'
			asItStands then return result
			aFloatsBits then return self.emitUnaryOp(result, op: MaxonUnaryOp.bitsToFloat, resultTag: ValueTypeTag.float, range: callRange)
			aNarrowSignedSlot(slotBytes) then return self.emitSignExtendFromSlot(result, slotBytes: slotBytes, valueType: self.typeOf(result), range: callRange)
		end 'reading'
	end 'emitCall'

	// ⭐ **SUPPLY EVERY ARGUMENT THE CALL OMITTED AND THE DECLARATION DEFAULTS** (BATCH2 slice 4) — each one
	// becomes a call to the declaration's synthesized helper, appended with the parameter's own NAME as its
	// label, so `slotCallArgs` puts it in the right position whatever order the written arguments came in.
	//
	// ⚠ **IT FILLS BY SLOT, NOT BY TRAILING RUN, AND THAT IS WHAT MAKES A NON-TRAILING DEFAULT WORK.**
	// `choose(flag bool = true, a Integer = 40, b Integer = 10)` called `choose()` fills all three; the same
	// declaration called `choose(false, b: 7)` fills only `a`. The occupied slots are computed through
	// `argSlotPosition` — the SAME label→position mapping `slotCallArgs` will use — so a call cannot be
	// filled against one slotting and validated against another.
	//
	// ⚠ **A SLOT WITH NEITHER AN ARGUMENT NOR A DEFAULT IS LEFT EMPTY ON PURPOSE**, and so is a call whose
	// label resolves to no parameter. Both are diagnostics that already exist, own their wording and their
	// position, and read the RESOLVED signature rather than the tolerant sweep — E3036 and E3037, from
	// `SemanticCheck` through `slotCallArgs`. Reporting either here would be a second opinion built on the
	// weaker registry.
	function fillOmittedArgDefaults(callee ByteArray, anchor Token, args ValueIdArray, argLabels ByteArrayArray, argRanges SourceRangeArray) returns ParamCountArray throws ParseError
		// ⚡ The gate is the allocation-free PRESENCE test, not `defaultsOf` itself: this runs at every call
		// in the program, and a payload-free union case still heap-allocates in Maxon — an `allRequired`
		// minted per parsed call is the constant factor that reverted the math-intrinsic resolver
		// (`parseCallNamed`). Only a callee that genuinely declares a default pays for the union.
		if not self.signatures.declaresParamDefaults(callee) 'everyParameterRequired'
			return NoDefaultArgSlots
		end 'everyParameterRequired'

		match self.signatures.defaultsOf(callee) 'defaults'
			allRequired then return NoDefaultArgSlots
			defaults(info) then return try self.fillArgsFromParamDefaults(info, anchor: anchor, args: args, argLabels: argLabels, argRanges: argRanges)
		end 'defaults'
	end 'fillOmittedArgDefaults'

	// ⭐ **RETURNS THE SLOT OF EVERY ARGUMENT IT APPENDED, IN APPEND ORDER** — `MaxonOp.call`'s
	// `argDefaultSlots`. The label it also writes is the parameter's NAME, which is what every by-name reader
	// downstream still bridges through; the slots are what `slotCallArgs` uses, because a name cannot address
	// a position when the signature declares `_` more than once. See the op's own header for why exactly one
	// reader needs the exact answer.
	function fillArgsFromParamDefaults(info ParamDefaultInfo, anchor Token, args ValueIdArray, argLabels ByteArrayArray, argRanges SourceRangeArray) returns ParamCountArray throws ParseError
		let paramCount = info.paramNames.count()
		if args.count() >= paramCount 'nothingOmitted'
			return NoDefaultArgSlots
		end 'nothingOmitted'

		var filled = BoolArray.create()
		for _ in 0 upto paramCount 'initSlots'
			filled.push(false)
		end 'initSlots'

		for i in 0 upto args.count() 'markSupplied'
			let label = try argLabels.get(i) otherwise panic("fillArgsFromParamDefaults: argLabels.get OOB at {i} — the label column is pushed in lockstep with args")
			let suppliedSlot = argSlotPosition(info.paramNames, argIndex: i, label: label)
			if suppliedSlot >= paramCount 'labelNamesNoParameter'
				return NoDefaultArgSlots
			end 'labelNamesNoParameter'
			try filled.set(suppliedSlot, value: true) otherwise panic("fillArgsFromParamDefaults: filled.set OOB at {suppliedSlot} despite suppliedSlot < paramCount")
		end 'markSupplied'

		// ⚠ **THE COLUMN IS BUILT OWNED AND THE SHARED EMPTY ONE IS SUBSTITUTED AT THE RETURN** — it may
		// NOT be seeded with `NoDefaultArgSlots` and pushed into later. That constant is a module-level
		// `let`, and a `var` reaching it is a MUTABLE name for an IMMUTABLE value, which single ownership
		// refuses (E3019 at the `push`, since `push` mutates its receiver) — the guard that made the seed
		// safe at runtime is invisible to a static rule, and rightly so: the rule is about what the name
		// CAN reach, not what this path happens to do. The shared column still leaves this function for
		// every call that fills no default, so nothing downstream changes; only calls that omitted an
		// argument with no default pay a transient empty array, and they are the error paths.
		var defaultSlots = ParamCountArray.create()

		for slot in 0 upto paramCount 'fillDefaults'
			let supplied = try filled.get(slot) otherwise panic("fillArgsFromParamDefaults: filled.get OOB at {slot} despite slot < paramCount")
			if supplied 'alreadyGiven'
				continue
			end 'alreadyGiven'

			let producer = info.producerFor(slot)
			if producerIsRequired(producer) 'noDefault'
				continue
			end 'noDefault'

			defaultSlots.push(slot)

			let paramName = try info.paramNames.get(slot) otherwise panic("fillArgsFromParamDefaults: paramNames.get OOB at {slot} despite slot < paramCount")
			let value = try self.emitDefaultArgValue(producer, anchor: anchor)
			pushDefaultedCallArg(args, argLabels: argLabels, argRanges: argRanges, value: value, label: paramName, range: SourceRange.ofToken(anchor))
		end 'fillDefaults'

		if defaultSlots.count() == 0 'noneFillable'
			return NoDefaultArgSlots
		end 'noneFillable'

		return defaultSlots
	end 'fillArgsFromParamDefaults'

	// ⭐⭐ **THE VALUE ONE OMITTED ARGUMENT TAKES — THE POINT THE LANGUAGE'S TWO DEFAULT DOORS DIVERGE, AND
	// THE ONLY ONE (W72).** Everything around it — the slot bookkeeping, the parameter-name label,
	// `argDefaultSlots`, and every check downstream that cannot tell a defaulted argument from a written one
	// — is shared, because what differs between the doors is exactly and only what produces the value.
	//
	// ⚠ **A CALLER-LOCATION DEFAULT EMITS THE OPS THE CALLER WOULD HAVE EMITTED HAD IT WRITTEN THE VALUE
	// OUT**, and that is what makes it need no rule of its own anywhere else. An `at SourceLineNumber =
	// __line__` filled here is the same `literal` op as a hand-written `at: 7`, so the ranged-alias check in
	// front of the call (`recordConstantArgRangeChecks`) reads it, `SemanticCheck` types it, and the backend
	// sees a constant. A `from String = __file__` is the same immortal `.rdata` record a hand-written
	// `"main.maxon"` is, with the same (absent) ownership obligation.
	function emitDefaultArgValue(producer ParamDefaultProducer, anchor Token) returns ValueId throws ParseError
		let range = SourceRange.ofToken(anchor)
		return match producer 'produces'
			required panic("emitDefaultArgValue: parameter is `required`, which the caller skips before asking — a slot with no default is left empty on purpose (E3036 reports it from the resolved signature)")
			// ⭐ **THE LINE OF THE TOKEN NAMING THE CALLEE**, which `anchor` is at every one of the doors that
			// funnel through `emitCall` — a free call's identifier, a method's name after the final `.`, a
			// static's after the type. That is the spec's rule word for word, and it is what makes two calls
			// to one function on two lines produce two values.
			callerLine gives self.emitLiteral(anchor.line as ParsedInt, valueType: MaxonType.integer, range: range)
			callerFile gives self.emitStringLiteral(self.sourceFileDisplayPath(), range: range)
			// The synthesized nullary function (`SignatureIndex.ParamDefaultInfo`). It is nullary, so this
			// recursion bottoms out at once: no helper declares a parameter, hence none is in
			// `funcParamDefaults` and `fillOmittedArgDefaults` returns on its first match.
			helper(name) gives try self.emitCall(name, anchor: anchor, args: ValueIdArray.create(), argLabels: ByteArrayArray.create(), argRanges: SourceRangeArray.create(), argImmutableNames: NoImmutableArgNames, rparenTok: anchor, resultUsed: true, constructorInstance: ConstructorInstance.none, mint: CalleeMint.paramDefaultHelper)
		end 'produces'
	end 'emitDefaultArgValue'

	// ⭐ **HOW THE FILE BEING PARSED NAMES ITSELF INSIDE EMITTED CODE (W72)** — its path relative to the
	// compile root, `/`-separated on every host, which is what `__file__` expands to.
	//
	// It is DERIVED from the module directory the whole-program index already stamped for this file
	// (`Queries.moduleDirectoryForFile`, which is `Project.deriveModuleDirectory` against the compile
	// anchor) rather than measured a second time here. That directory is already root-relative and already
	// `/`-joined — the separator rewrite lives there, once — so the only thing left to add is the file's own
	// name. A second `relativeTo` here would be the same derivation written twice, free to disagree with the
	// one every namespace and every `Visibility.module` answer is decided on.
	//
	// ⚠ RELATIVE AND NOT ABSOLUTE BY CHOICE, and the reason is a gate rather than taste: an absolute path is
	// a fact about the machine that ran the compiler, so embedding one makes two builds of one commit on two
	// machines emit different bytes — exactly what the golden fragments exist to detect.
	//
	// MEASURED against the oracle, which is canonical for `/specs`: a `__file__` default filled from
	// `sub/helper.maxon` in a directory build prints `sub/helper.maxon`, and one filled from the root file
	// prints `main.maxon`.
	function sourceFileDisplayPath() returns ByteArray
		let directory = self.signatures.moduleDirectoryOf(self.filePath)
		if directory.isEmpty() 'atTheCompileRoot'
			return self.filePath.filename().toByteArray()
		end 'atTheCompileRoot'

		// ⚠ JOINED WITH `ModuleDirectorySeparator` AND NOT A LITERAL `/` (W72 review). The paragraph above
		// argues that the separator rewrite lives in `deriveModuleDirectory` once — and a hardcoded `/` here
		// would be a second speller of the very joiner it is arguing about, free to disagree with
		// `moduleDirectoryContains`' `"{outer}{ModuleDirectorySeparator}"` and with `namespaceForModuleDirectory`'s
		// inversion. It would disagree by emitting a WRONG PATH STRING, not by failing to compile.
		return "{directory}{ModuleDirectorySeparator}{self.filePath.filename()}".toByteArray()
	end 'sourceFileDisplayPath'

	// ⭐ **RETYPE-OF-T AT A CONCRETE METHOD'S RETURN (D7) — `emitFieldLoad`'s rule, reached one op further.**
	// `c.unwrap()` on a `Cell with Wide` returns what the SHARED body declared, the opaque `T`, and an opaque
	// value AGREES WITH EVERY TYPE: it is not merely imprecise, it is the one tag that cannot discriminate,
	// so an overloaded callee handed one has no way to choose (`specs-shv2/function-overloads.md`'s
	// `method-call-argument-generic-element` reported E3007 against a call whose type is fully determined).
	// The receiver's alias binds `T`, so the answer is the instance's substituted argument — the same
	// `substitutedInstanceArg` a concrete field read already asks.
	//
	// ⭐ **IT IS THE FIELD-READ RULE EXACTLY, INCLUDING FOR A MANAGED ARGUMENT (A5o).** It was narrower until
	// A5o, on an ORDERING premise rather than a rule: a call RESULT's drop enrolment ran inside the mint,
	// FROM THE OPAQUE TYPE, so retyping opaque→`Alpha` here would have moved a decision that was already
	// taken. `emitCall` now enrols AFTER this call (`enrolOwnedCallTemp`), so the ownership decision is made
	// from the SUBSTITUTED tag and the substitution applies whether or not the concrete argument owns heap.
	// A field read remains a BORROW and this remains an OWNED result; what they now share is that both learn
	// what `T` is before anything reads the answer.
	//
	// The gate is ordered cheapest-first: almost every call in a program has a non-generic first argument, and
	// that test is one array read. Only past it is the callee's return type looked up.
	//
	// ⚠ **IT REPORTS NOTHING, AND IT USED TO REPORT AN OWNERSHIP BIT.** `emitCall` asked it *"did the shared
	// body hand this back without taking a reference for it?"* to choose between adopting the result and
	// co-owning it. That question is answered from the DECLARED return type and the obligation belongs to the
	// RETURNED VALUE, so the two could disagree — and did, for every body that returned a value it already
	// owned. The callee now discharges the hand-off for every shape (`emitOwnedValueReturn`), so there is one
	// convention, no bit, and nothing here for a caller to read back.
	function retypeOpaqueMethodResult(result ValueId, callee ByteArray, args ValueIdArray) returns OpaqueWordReading
		if args.isEmpty() 'noReceiver'
			return OpaqueWordReading.asItStands
		end 'noReceiver'

		let receiver = try args.get(0) otherwise panic("retypeOpaqueMethodResult: args.get(0) failed on a non-empty list")
		if self.tagOf(receiver) != ValueTypeTag.genericInstance 'concreteReceiverOnly'
			return OpaqueWordReading.asItStands
		end 'concreteReceiverOnly'

		// The callee must be a method OF the receiver's own generic base, or `T` names a different type's
		// parameter and the substitution would be against the wrong binding.
		if not isQualifiedUnderTypeName(callee, typeName: self.signatures.genericInstanceBaseName(self.valueNameId(receiver))) 'notItsOwnMethod'
			return OpaqueWordReading.asItStands
		end 'notItsOwnMethod'

		match self.signatures.returnTypeOf(callee, into: self.artifact.typeNames) 'declared'
			declared(returnType) then return self.retypeOpaqueReturn(result, receiver: receiver, returnType: returnType)
			undeclared then return OpaqueWordReading.asItStands
		end 'declared'
	end 'retypeOpaqueMethodResult'

	function retypeOpaqueReturn(result ValueId, receiver ValueId, returnType MaxonReturnType) returns OpaqueWordReading
		match returnType 'r'
			value(inner) then return self.retypeOpaqueReturnValue(result, receiver: receiver, inner: inner)
			void then return OpaqueWordReading.asItStands
		end 'r'
	end 'retypeOpaqueReturn'

	// ⛔ **THERE IS NO MANAGED/TRIVIAL SPLIT HERE ANY MORE, AND ITS REMOVAL IS A5o.** A `managedConcrete`
	// guard stood between these two statements, refusing the substitution whenever the instance's argument
	// owned heap. Its whole justification was the ORDER `emitCall` used to run in — the drop enrolment was
	// taken from the opaque tag inside the mint, so a later retype would have contradicted it — and with the
	// enrolment moved after this call (`enrolOwnedCallTemp`) there is nothing left for it to protect. It
	// refused a program the oracle runs: `bx.echo(bx.echo(Alpha.create()))` on a `Box with Alpha`, and every
	// field read of the value that came back.
	//
	// ⚠ **The guard is gone; the RULE it was written next to is not.** `typeIsManaged` and every other
	// `ProgramSignatures` classifier must be asked of the INDEX-SPACE type, never of one
	// `slotTypeThroughReceiver` has already re-interned into this file's table — the two interners assign ids
	// in their own insertion orders, so such an answer is right exactly while they coincide and silently
	// wrong when they drift (OPEN #56, and the reason the substitution and `adoptType` are two steps). That is
	// why the substitution below goes through `slotTypeThroughReceiver` and not a bare `adoptType`:
	// `declaredSlotType` re-tags a struct / generic-alias / function name and leaves a union's `named` alone,
	// which is what makes `Box with Shape` pick `over(x Shape)` rather than reading the box pointer as an
	// integer (`generic-managed-union-return-overload-selection` — exit 25 where 7 is correct, the failure this
	// door's predecessor MEASURED before A4i/A4k gave it that cascade).
	//
	// ⚠ **AND ITS OWN `typeParameter`-ONLY GATE IS GONE WITH W25**, for the reason the read door's was: a method
	// declared `returns Items` inside `type HoldA uses T` hands back an `Array with T` that the receiver has
	// already fixed to `Array with Num`, and a gate keyed on the bare opaque tag cannot see it.
	//
	// ⚠⚠ **IT USED TO ANSWER A SECOND QUESTION — *does the caller owe this result a reference?* — AND W41's
	// MEASUREMENT IS WHY THAT QUESTION IS GONE RATHER THAN NARROWED.** The two were ONE answer while the gate
	// was `typeParameter`-only; W25 widened the gate to `returns Items` / `returns Pair` and the bit went on
	// being read as *"the body took no reference"*, so a caller minted a SECOND reference to a record the body
	// had just built — `MapIterator.current()`'s `Entry = (Key, Value)` walked by `for (_, value) in m`, one
	// leaked record per call, five cases at exit 101 with every answer still correct. Narrowing the bit back to
	// the bare-`T` arm cured that instance and left the shape: a caller reading a DECLARED type to decide what
	// a RETURNED VALUE owes. The callee now owes the `+1` on every shape (`emitOwnedValueReturn`) and there is
	// no bit to narrow.
	//
	// ⭐⭐ **AND IT ANSWERS ONE THING THE CALLER MUST ACT ON: A `returns T` THE INSTANCE FIXES TO `float`
	// CANNOT BE THE TYPE IT IS FIXED TO — IT IS THAT TYPE'S 64 BITS.** Under dictionary-passing the callee is
	// compiled ONCE for every instantiation at once, so it hands its result back in the general-purpose
	// register a type parameter travels in. Writing `float` onto that value tells the allocator to colour a
	// GPR-defined value into the XMM file, which is `X64Backend`'s cross-register-file assertion verbatim.
	// So this door reports the case and `emitCall` reinterprets, exactly as `emitContainerElementAccessor`
	// does at the element boundary: the same sentence, the other kind of slot.
	function retypeOpaqueReturnValue(result ValueId, receiver ValueId, inner MaxonType) returns OpaqueWordReading
		// ⭐ **THE SURFACE CROSSES THE INSTANCE WITH THE TYPE** — `emitFieldLoad`'s pairing at the method-RESULT
		// position, and it sits ABOVE the "fixes nothing" return deliberately: which roster the result serves is
		// a fact about the receiver's ARGUMENT SPELLING, and the substitution below can leave a type untouched
		// while that spelling still decides what the value may be asked for. `inner` is the CALLEE'S DECLARED
		// return — the declaration view, before anything has retyped the result — which is exactly the view
		// `surfaceBitsThroughInstanceArg` reads.
		self.markDeclaredSurface(result, declared: self.slotSurfaceThroughReceiver(receiver, declared: inner))

		let fixedByTheInstance = self.slotTypeThroughReceiver(receiver, declared: inner)
		if maxonTypesDenoteSame(fixedByTheInstance, b: inner) 'theInstanceFixesNothingHere'
			return OpaqueWordReading.asItStands
		end 'theInstanceFixesNothingHere'

		// ⚠ **THE GATE READS THE DECLARED SIDE AS WELL AS THE SUBSTITUTED ONE.** A `returns Items` fixes to a
		// `genericInstance` and a `returns Entry` to a tuple; neither can BECOME a float, and only a BARE type
		// parameter occupies the opaque word this rule is about. Testing `tagIsFloat(fixed)` alone would state
		// a rule about a slot KIND while checking only its contents.
		if maxonTypeTag(inner) == ValueTypeTag.typeParameter and tagIsFloat(maxonTypeTag(fixedByTheInstance)) 'aFloatRidingTheOpaqueWord'
			// The call's own result is what the ABI says it is — an i64 — which is also what makes
			// `enrolOwnedCallTemp` decline it correctly: a float owns no heap, so the descriptor-gated drop an
			// opaque tag would have enrolled is work with no effect on every trip of every loop.
			self.retypeValue(result, valueType: MaxonType.integer)
			return OpaqueWordReading.aFloatsBits
		end 'aFloatRidingTheOpaqueWord'

		self.retypeValue(result, valueType: fixedByTheInstance)

		// ⭐⭐ **A NARROW SIGNED VALUE COMES BACK ZERO-EXTENDED THROUGH THE OPAQUE WORD, FOR THE FLOAT ARM'S
		// REASON ONE STEP FURTHER ON (`enum-narrow-storage`).** A shared corpus body — `Array.pop`,
		// `Array.last`, `Array.remove`, `ArrayCursor.current` — is compiled ONCE against an opaque `Element`,
		// so it reads the slot with the zero-extending shared load and cannot know the element is signed.
		// Only the CALLER knows, because only the caller has the instance, which is precisely the situation
		// this whole function exists for. MEASURED before this arm, on a three-case `Signal { minus = -1 }`:
		// `for s in a` (the cursor's `current()`) summed to **256** where 0 is correct and `a.pop()` answered
		// **255** for `-1`, while the compiler-emitted `get`/`first` were already right.
		//
		// ⚠ It asks the SUBSTITUTED type, not the declared one, and it does NOT require `inner` to be a bare
		// type parameter the way the float arm does. A float can only ride the opaque word as an ABI
		// accident of a bare `T`; a narrow signed slot is a property of the VALUE's own type wherever it came
		// from, and `narrowSignedSlotOf`'s header carries why re-extending an already-correct value is the
		// identity rather than a risk. `fixedByTheInstance` is in THIS FILE's interner, so the question goes
		// through `narrowSignedSlotOfLocalType` — see there for the measured wrong answer the id form gave.
		match self.narrowSignedSlotOfLocalType(fixedByTheInstance) 'slot'
			fromBytes(slotBytes) then return OpaqueWordReading.aNarrowSignedSlot(slotBytes)
			notASignExtension then return OpaqueWordReading.asItStands
		end 'slot'
	end 'retypeOpaqueReturnValue'

	// ⭐ **A CALL ARGUMENT MEETS THE PARAMETER'S DECLARED RANGE (P1.9), and this is the door that used to
	// let it through in silence** — `clamp(101)` ran the callee with `p = 101` and the body observed
	// `p > 100` as true. Both reference compilers have the same hole and neither fixed it: the bootstrap's
	// pre-fix path bottomed out at a `MaxonValueKind` and v1's still bottoms out at a `CastCategory`, and
	// *a kind is a lossy projection of a type, and what it drops is exactly the range*.
	//
	// ⚠ **RECORDED, NOT DECIDED, and the reason is cross-file.** Every other range-check door holds the
	// declared type with its alias still on it. This one holds a callee NAME: the parameter belongs to a
	// function that may be declared in a file this one is parsed independently of, and the whole-program
	// index built before any parse (`ProgramSignatures`) carries return types, not parameter types. So the
	// site names the callee and the argument position, and `InsertRangeChecks` — which runs once, after
	// every file has merged — reads the alias back off that callee's `paramSites`.
	//
	// ⚠ **ONLY AN ARGUMENT THAT COULD BE A COMPILE-TIME CONSTANT IS RECORDED.** A call argument owes the
	// COMPILE-TIME half alone (`RangeCheckGuard`), so an argument no constant folds to has nothing a site
	// could report, and recording one would file a row per argument in the program for a check that could
	// never fire.
	//
	// ⚠⚠ **AND THE TWO DOMAINS ANSWER THAT QUESTION DIFFERENTLY, WHICH IS NOT A WART BUT A CONSEQUENCE OF
	// WHAT THE PARSER'S CONSTANT VIEW IS FOR.** `constIsKnown` is the INTEGER view — a float literal's
	// payload is stamped `ConstPayloadDomain.float` and this reader answers only for `integer` — because its
	// readers decide integer questions (a shift COUNT, a folded operand), and a float's payload is an
	// IEEE-754 bit pattern that every one of them would read as a number it is not. So a FLOAT argument is
	// recorded on its TAG alone, and `InsertRangeChecks` decides literal-ness from its own `floatConsts` map,
	// which is built from the Std `const` ops. The cost is a site per float argument rather than per float
	// LITERAL argument; float arguments are rare.
	//
	// ⚠ **A1 ADDED A FLOAT-DOMAIN CONSTANT VIEW (`floatConstIsKnown`), AND NARROWING THIS SITE TO IT IS A
	// QUESTION ABOUT THE TWO VIEWS, NOT ABOUT THE RANGE RULE.** ⛔ The reason written here until this rung
	// — "a NON-literal float argument needs a site precisely SO THAT `needsRuntimeGuard` can emit its
	// RUNTIME guard" — is FALSE, and it is false in the direction that would break the compiler: an
	// argument site is asked as `compileTimeOnly` (`InsertRangeChecks.checkArgAgainstParamRange`), so no
	// runtime guard is EVER emitted from one, and `checkArgAgainstParamRange` PANICS if the shared decider
	// ever answers `guard` there. The argument door's runtime half is the callee's ENTRY guard (A1f), and
	// it stands in front of every caller whether or not the caller filed a site.
	// The honest reason the tag is the admission test is the paragraph above: the parser's own constant
	// view is the INTEGER one and cannot answer for a float, so the TAG is the conservative filter and
	// `InsertRangeChecks` decides literal-ness for itself from its Std-level `floatConsts`. What a narrowing
	// would cost is therefore a COMPILE-TIME E3005 on a float literal the parser's float view fails to
	// recognize — measure the two views against each other before believing they agree.
	//
	// ⚠ Without the float arm, `take(500.0)` into a `float(0 to 100)` parameter compiled and was caught
	// only by the callee's own ranged `return` at RUN time, where the reference refuses it at compile time.
	//
	// The anchor is the CALLEE token, which is where the reference compiler anchors it
	// (`range-check-panic.error.literal-argument` pins the column) — the argument's own span would move the
	// diagnostic off the name that decides which range applies.
	function recordConstantArgRangeChecks(callee ByteArray, args ValueIdArray, argLabels ByteArrayArray, anchor Token)
		// A callee no file DECLARES has no parameter list to consult — a runtime helper (`__managed_push`), or an
		// undeclared name whose own E3004 is SemanticCheck's to raise.
		if not self.signatures.declaresCallee(callee) 'noDeclaredParams'
			return
		end 'noDeclaredParams'

		for i in 0 upto args.count() 'eachArg'
			let argValue = try args.get(i) otherwise panic("recordConstantArgRangeChecks: args.get OOB at {i}")
			if not (self.constIsKnown(argValue) or tagIsFloat(self.tagOf(argValue))) 'cannotBeALiteral'
				continue
			end 'cannotBeALiteral'
			// An ENUM value is a known constant since `enum-narrow-storage` and can never be checked against
			// a ranged parameter — see `argIsAnEnumValue` for why the site would be a guaranteed dead
			// allocation at every call site in every program that passes one.
			if self.argIsAnEnumValue(argValue) 'noRangedParameterCanDeclareIt'
				continue
			end 'noRangedParameterCanDeclareIt'
			let label = try argLabels.get(i) otherwise EmptySourceText
			self.rangeCheckArgSites.push(RangeCheckArgSite.create(argValue, callee: callee, argIndex: i, label: label, block: self.currentBlock.id, line: anchor.line, column: anchor.column))
		end 'eachArg'
	end 'recordConstantArgRangeChecks'

	// ⭐⭐ **AN ARGUMENT AT AN OPAQUE TYPE PARAMETER IS CHECKED AGAINST WHAT THE INSTANCE BOUND IT TO — AND
	// THIS DOOR OWES BOTH HALVES, BECAUSE THE CALLEE CANNOT OWE EITHER (ARRR).**
	//
	// A CONCRETE ranged parameter splits the rule between two places: the caller reports a folded literal
	// (`recordConstantArgRangeChecks`, above) and the CALLEE'S ENTRY guards everything else, once per
	// narrowed parameter, in front of every caller including the indirect ones (A1f, `RangeCheckParamSite`).
	// Neither half is available at a bare `T`. A generic body is compiled ONCE — `Box.put` is one function
	// for `Box with Percent` and `Box with Wide` alike — so the callee has no range to guard and the sweep
	// records it no `paramSite` for the caller's argument site to resolve against. The CALL SITE is the only
	// frame that knows what `T` was bound to, so it owes the whole rule.
	//
	// ⭐ **IT IS THE ORDINARY ALIAS-NAMED SITE, AND THAT IS THE POINT: NOTHING NEW DECIDES ANYTHING.**
	// `recordRangeCheckSite` is the same door the `as` cast, the field store and the array element record,
	// so `InsertRangeChecks` raises the same E3005 for a foldable literal and emits the same cascade for
	// everything else, from one decider (`guardVerdict`). A rule with a second implementation for
	// substituted parameters would be this project's signature defect — one fact written twice — in the very
	// place the first copy is already known to be incomplete.
	//
	// ⭐⭐ **AND THE GUARD LANDS EXACTLY WHERE THE CALLEE'S ENTRY GUARD WOULD HAVE STOOD.** `RangeCheckGuard`'s
	// obstacle — *"a check is a BRANCH, and a call argument is evaluated part-way through building an
	// argument list, so the guard would land PAST the call"* — is about a site recorded WHILE the list is
	// being built. This runs after the last argument is parsed and before the `call` op is emitted, so
	// `recordRangeCheckSite`'s `opRefs.count()` is the ordinal that op is about to take and the split puts
	// the cascade immediately in FRONT of the call. Every argument has been evaluated and the callee has not
	// run: observably the entry guard's position, in the one frame that can hold it. It is the same
	// reasoning — and the same anchor arithmetic — as `requireContainerElementType`'s store guard.
	//
	// ⚠ **THE RUNNABLE ORACLE HAS THE FIRST HALF AND NOT THE SECOND, AND SHV2 DELIBERATELY DIVERGES ON THE
	// SECOND.** The bootstrap MONOMORPHIZES, so its substituted parameter refuses the literal (`E3005`,
	// MEASURED, at this same callee-token anchor) — but its runtime guard is still keyed on the DECLARED
	// type, which is the opaque `T`, so `b.put(grow(5))` compiles there and **exits 505**. `range-check-panic.md`
	// promises both halves at every position, and the one position exempted from the runtime half is exempt
	// only because the callee's entry guard covers it. Here it structurally cannot, so there is no exemption
	// to inherit.
	//
	// ⚠ **THE GATES ARE ORDERED CHEAPEST-FIRST, exactly as `retypeOpaqueMethodResult`'s are**, and for its
	// reason: almost every call in a program has neither a generic-instance receiver nor a constructed
	// instance, and that test is one dense array read. Only past it is the whole-program index probed.
	//
	// ⚠ **AN INSTANCE THAT STILL MENTIONS A TYPE PARAMETER DECLINES BY CONSTRUCTION** — a call made inside a
	// generic body on a `self` receiver is tagged with the base `structRef` and never reaches here, and a
	// partially-opaque instance substitutes to a `typeParameter`, which names no ranged alias. So the shared
	// body keeps the P1.6-A deferral it must have and only a concrete instantiation is checked.
	// ⭐ **THE TWO SHAPES A GENERIC CALL TAKES, IN THE ORDER `SemanticCheck.callInstanceSubject` ASKS THEM** —
	// an instance METHOD carries its instance on argument 0, the receiver `parseCallNamed` prepended; a STATIC
	// FACTORY has no receiver and its instance is the one the caller resolved from the alias it wrote
	// (`constructorInstanceOf`), which is also what retypes its result. The receiver is asked FIRST because a
	// method's answer must be its receiver's.
	//
	// ⚠ **IT MINTS NO UNION OF ITS OWN, and that is worth the two call sites.** A single
	// "which instance, if any?" answer would be a payload-carrying union built at EVERY generic-instance
	// method call, and a Maxon union value IS a heap box — the constant factor that reverted the
	// math-intrinsic resolver one door up (`parseCallNamed`) at +2,193 allocations on the scale ladder's top
	// rung. This reads the receiver's own dense tag column and re-uses the `ConstructorInstance` the CALLER
	// already holds.
	function recordOpaqueArgRangeChecks(callee ByteArray, args ValueIdArray, argLabels ByteArrayArray, anchor Token, constructorInstance ConstructorInstance)
		match constructorInstance 'constructed'
			// ⚠ **THE INSTANCE THE CALL ITSELF NAMED IS ASKED FIRST, AND THE ORDER IS THE SAFE ONE.** It is
			// the ONLY answer available to a receiverless static (`PB.create(505)`, whose instance comes from
			// the alias the call wrote), and where a call carries BOTH — every method site that passes one
			// derives it with `receiverConstructorInstance(<the receiver>)` — the two are the same instance.
			// Reading the receiver first would let a RECEIVERLESS static whose first argument happens to be an
			// instance of the same base substitute against the ARGUMENT's binding instead of the constructed
			// one.
			instance(gid) then self.recordSubstitutedArgRangeChecks(gid, callee: callee, args: args, argLabels: argLabels, anchor: anchor)
			none then self.recordReceiverSubstitutedArgRangeChecks(callee, args: args, argLabels: argLabels, anchor: anchor)
		end 'constructed'
	end 'recordOpaqueArgRangeChecks'

	// The ordinary method call, whose instance is the receiver `parseCallNamed` prepended at argument 0 — the
	// same place `SemanticCheck.callInstanceSubject` reads it from. Two dense reads and no map probe for
	// every call in the program that has no generic-instance receiver, which is almost all of them.
	function recordReceiverSubstitutedArgRangeChecks(callee ByteArray, args ValueIdArray, argLabels ByteArrayArray, anchor Token)
		if args.isEmpty() 'noReceiver'
			return
		end 'noReceiver'

		let receiver = try args.get(0) otherwise panic("recordReceiverSubstitutedArgRangeChecks: args.get(0) failed on a non-empty list")
		if self.tagOf(receiver) != ValueTypeTag.genericInstance 'concreteReceiverOnly'
			return
		end 'concreteReceiverOnly'

		self.recordSubstitutedArgRangeChecks(self.valueNameId(receiver), callee: callee, args: args, argLabels: argLabels, anchor: anchor)
	end 'recordReceiverSubstitutedArgRangeChecks'

	// One call's opaque arguments, once the instance is known. Each argument is slotted to its parameter
	// position through `argSlotPosition` — the ONE label→position mapping, the same one the default fill and
	// `slotCallArgs` use, so a labelled `insert(0, value: 300)` cannot be checked against a different
	// parameter than it is passed to.
	//
	// ⚠ **THE CALLEE MUST BE QUALIFIED UNDER THE INSTANCE'S OWN BASE**, `retypeOpaqueMethodResult`'s guard and
	// for its reason: a `T` recorded against another type's `uses` list is numbered against a list that does
	// not describe this instance, so substituting through it would bind the wrong type argument. It is asked
	// HERE rather than at each of the two doors above so both arms carry it — a fact one caller could forget.
	function recordSubstitutedArgRangeChecks(gid GenericInstanceId, callee ByteArray, args ValueIdArray, argLabels ByteArrayArray, anchor Token)
		if not isQualifiedUnderTypeName(callee, typeName: self.signatures.genericInstanceBaseName(gid)) 'notThisTypesMethod'
			return
		end 'notThisTypesMethod'

		let opaque = self.signatures.opaqueParamsOf(callee)
		if not opaque.declaresATypeParameterParam() 'everyParameterIsConcrete'
			return
		end 'everyParameterIsConcrete'

		let argCount = self.signatures.genericInstanceArgCount(gid)
		for i in 0 upto args.count() 'eachArg'
			let slot = argSlotPosition(opaque.paramNames, argIndex: i, label: try argLabels.get(i) otherwise EmptySourceText)
			if not opaque.namesATypeParameter(slot) 'concreteParam'
				continue
			end 'concreteParam'

			// A position past the instance's own argument list is an arity the instantiation was already
			// refused for (E2056); reading it would index a list that does not describe this type.
			let position = opaque.positionAt(slot)
			if position >= argCount 'boundNothingHere'
				continue
			end 'boundNothingHere'

			// ⚠ **THROUGH `resolvedSlotType`, NEVER `adoptType` ALONE** — the substituted argument comes out
			// of the INDEX's interner, and a sweep-recorded `named` leaf read against this file's interner is
			// a name id that means something else (the trap `slotTypeThroughReceiver` and
			// `requireContainerElementType` both cross through this same door).
			let substituted = self.resolvedSlotType(self.signatures.substitutedInstanceArg(gid, position: position))
			let argValue = try args.get(i) otherwise panic("recordSubstitutedArgRangeChecks: args.get OOB at {i} inside its own count()")
			self.recordRangeCheckSite(argValue, targetAlias: self.declaredAliasOfType(substituted), line: anchor.line, column: anchor.column)
		end 'eachArg'
	end 'recordSubstitutedArgRangeChecks'

	// ⭐ **`async f(args…)` — SPAWN A GREEN THREAD** (P1.5-B1a). The cursor sits just past `async`, on the
	// callee name. B1a supports a FREE call only (`async f(…)`), so the callee name is followed directly by
	// `(` — a qualified `async Type.method(…)` fails at the `(` consume and is refused, which is the intended
	// B1a boundary. The argument grammar and `name:` label rules are `parseCallArgs`, shared with an ordinary
	// call, so a labelled async argument slots exactly as a plain one does.
	function parseAsyncCall(func IrFunction) returns ValueId throws ParseError
		if not self.at(TokenKind.identifier) 'notCall'
			let tok = self.current()
			throw ParseError.unsupported("`async` must be applied to a call — `async f(…)` (got '{tok.kind.rawValue}')", line: tok.line, column: tok.column)
		end 'notCall'
		// ⭐ The first token of the spawn — the `async` KEYWORD, which the sole caller consumed immediately
		// before dispatching here (`parsePrefix`'s `async` arm). E3073 quotes the whole spawn, keyword included
		// (`'async heavyCompute(5)'`), and this is the only point at which its text still exists — see
		// `Project.asyncSpawnTexts` for why nothing downstream can reconstruct it.
		let spawnStart = self.pos - 1

		let calleeTok = self.current()
		try self.consume(TokenKind.identifier)
		try self.consume(TokenKind.leftParen)

		var args = ValueIdArray.create()
		var argLabels = ByteArrayArray.create()
		var argRanges = SourceRangeArray.create()
		var argImmutableNames = ByteArrayArray.create()
		// ORDINARY, unconditionally: an `async` call always emits a real `MaxonOp.call` to a declared
		// function, so its callee always has parameter names — no bare builtin is reachable through
		// this door, and the positional-argument regime would be answering for a callee that cannot
		// arrive here.
		try self.parseCallArgs(func, callee: calleeTok.value, anchor: calleeTok, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: argImmutableNames, rule: ArgLabelRule.ordinary)
		let rparenTok = try self.consume(TokenKind.rightParen)

		// `self.pos` now sits one PAST the `)`, which is exactly `tokenTextFrom`'s exclusive end. The POSITION is
		// the `async` keyword's, so E3073's caret lands on the first character of the text it quotes.
		let asyncTok = self.tokenAt(spawnStart)
		let spawnSite = AsyncSpawnSite.create(self.tokenTextFrom(spawnStart, endIndex: self.pos).toByteArray(), line: asyncTok.line, column: asyncTok.column)

		return try self.emitAsyncCall(calleeTok.value, anchor: calleeTok, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: argImmutableNames, rparenTok: rparenTok, spawnSite: spawnSite)
	end 'parseAsyncCall'

	// Mint the Promise handle an `async` spawn defines and emit the `asyncCall` op. B1a is SCALAR ONLY: the
	// trampoline passes arguments through the GPR arg registers and captures the result from R8, so a
	// managed/float ARGUMENT or a managed/float RESULT is REFUSED here (E2015) rather than leaked or
	// miscompiled. The callee's PARAMETER types are checked by SemanticCheck, which alone holds the resolved
	// signature.
	//
	// ⭐ **THE PROMISE IS AN i64 HANDLE, tagged `integer` — NOT the awaited scalar (P1.5-B2b).** The handle is
	// the spawned GT's pointer; its value is an i64 whatever the awaited result type is. Earlier B1a tagged it
	// with the awaited scalar so `await` could read the result type off `tagOf`, but a VOID async's handle
	// would then be void-tagged and `let p = async voidFn()` could not bind it (a void tag names no value).
	// So the handle carries `integer`, and `await`/`try await` recover the awaited result type from the
	// callee (`awaitedResultTag`) — the same defining-`asyncCall` lookup the `try await` desugar already uses.
	function emitAsyncCall(callee ByteArray, anchor Token, args ValueIdArray, argLabels ByteArrayArray, argRanges SourceRangeArray, argImmutableNames ByteArrayArray, rparenTok Token, spawnSite AsyncSpawnSite) returns ValueId throws ParseError
		// `written` is not a default here, it is the shape of the door: `parseAsyncCall` is the sole caller and
		// it consumes a bare `identifier` callee, so an `async` spawn's name is always the author's own bytes.
		// `async int.fromString(s)` does not parse at all — the `async` target grammar admits a free call only.
		try requireCalleeIsNotReservedName(callee, anchor: anchor, fileDeclaresReservedNames: self.declaresCompilerInternalNames, isStdlibSource: self.isStdlibSource, mint: CalleeMint.notMinted, signatures: self.signatures)
		// ⭐ **AN OMITTED ARGUMENT IS SUPPLIED AT THIS DOOR TOO** (BATCH2 slice 4) — the SECOND of the two
		// source call doors, so `async f()` against `function f(n Integer = 1)` is the same legal call
		// `f()` is. It sits BEFORE the scalar check on purpose: the helper's result is an ordinary value and
		// must meet the async argument rule exactly as a written argument does, so a MANAGED default earns
		// the existing refusal below rather than a second one worded here.
		let argDefaultSlots = try self.fillOmittedArgDefaults(callee, anchor: anchor, args: args, argLabels: argLabels, argRanges: argRanges)
		for i in 0 upto args.count() 'eachArg'
			let argValue = try args.get(i) otherwise panic("emitAsyncCall: args.get OOB at {i} — args are pushed in lockstep by parseCallArgs")
			// Through `rangedAliasResolvedTag`, for `requireAsyncResult`'s reason mirrored onto the argument
			// side: a value of a ranged-int alias type carries tag `named` with its alias name in the parallel
			// name column, so the bare tag cannot tell `Integer` from a `String`. `let r1 = await p1` produces
			// exactly such a value (`awaitedResultTag` types it at the callee's declared `Integer`), so
			// `async step(r1)` — the whole shape of `specs/async-await.md`'s `sequence` — was refused for an
			// argument that is an ordinary i64.
			if not tagRidesAsyncGprChannel(self.rangedAliasResolvedTag(self.tagOf(argValue), nameId: self.valueNameId(argValue))) 'unfittableArg'
				throw ParseError.unsupported("an `async` call argument must ride the green thread's integer channel — a `float` argument travels in an XMM register the hand-assembled trampoline never fills, and a value held at an interface type or an opaque type parameter is released through a companion (a witness table, a layout descriptor) the green-thread struct does not carry. A managed String/struct/array argument is accepted: it is one heap pointer, and the spawn hands the thread its own reference", line: anchor.line, column: anchor.column)
			end 'unfittableArg'
		end 'eachArg'

		// ⛔ **AN `async` CALL HAS ITS OWN, LOWER ARGUMENT CEILING, AND IT IS A DIFFERENT MECHANISM'S LIMIT.**
		// An ordinary call gained stack arguments; a SPAWN did not, and cannot here: the arguments do not travel
		// in a calling convention at all but through the GT struct's INLINE argument region (`GtOffArgInline`,
		// `MaxAsyncArgs` slots), which the HAND-ASSEMBLED trampoline reads back into the ABI argument registers
		// one slot at a time (`X64GtRuntime.buildGtTrampolineChunk`). Passing a seventh would mean teaching that
		// hand-written chunk to build a callee's outgoing stack-argument region on the green thread's stack —
		// the async ABI, not the compiled one.
		//
		// ⚠ It used to be a compiler PANIC in `LowerMaxonToStd.emitAsyncSpawn`, guarding an inequality that
		// "cannot fire today" because `MaxAsyncArgs` equalled the parser's six-register parameter cap. Removing
		// that cap made it reachable from ordinary source, so it is a positioned diagnostic here — where the
		// other two async refusals (a managed argument, a non-scalar result) already are, and for the same
		// reason. The panic stays as the structural backstop it always claimed to be.
		if args.count() > MaxAsyncArgs 'tooManyAsyncArgs'
			throw ParseError.unsupported("`async {String.from(callee)}(…)` passes {args.count()} arguments — more than the {MaxAsyncArgs} a spawn can carry. A spawned call's arguments ride the green thread's inline argument region, which the hand-assembled trampoline reads back into the argument registers, so a spawn has no stack-argument path even though an ordinary call does. Call it directly, or pass fewer arguments", line: anchor.line, column: anchor.column)
		end 'tooManyAsyncArgs'

		try self.requireAsyncResult(callee, anchor: anchor)
		// ⭐⭐ **THE GREEN THREAD IS A DURABLE SINK, SO THE SPAWN HANDS IT ITS OWN REFERENCE (A2).** Runs AFTER
		// both gates, so only arguments that fit the channel are ever transferred — and after
		// `fillOmittedArgDefaults`, so a MANAGED default is transferred exactly as a written argument is.
		try self.transferAsyncSpawnArgs(args, anchor: anchor)
		let result = self.mintValue(ValueTypeTag.integer, nameId: UnnamedTypeId)
		self.markValuePromise(result)
		// ⭐ P1.5-B2 #88: the spawn OWNS a green thread. Enrol it as a statement-scoped pending temporary,
		// exactly as `trackOwnedTemp` enrols an interpolation result: `parseBinding` transfers it to
		// `ownedBindings` when bound (`let p = …`), `emitAwaitOp` clears it when consumed (`await async f()`),
		// and an UNBOUND, UNAWAITED spawn (`async f()` as a bare statement) is dropped at statement end
		// through `drainPendingTemps` — so no spawn path can leak its thread.
		self.pendingTempDrops.push(result)
		// Immediately before the emit, so the site keys the op that emit is about to append.
		self.artifact.recordAsyncSpawnSite(spawnSite)
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.asyncCall(result, callee: callee, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: settledImmutableArgNames(argImmutableNames), argDefaultSlots: argDefaultSlots), range: SourceRange.between(anchor, last: rparenTok))
		return result
	end 'emitAsyncCall'

	// Refuse a `async callee(…)` whose awaited RESULT is not scalar-or-void (a managed/float result has no
	// GPR channel). It asks `asyncCarriedResultTag`, NOT the raw pre-resolution tag: `returnTypeOf` answers
	// before resolution, so `returns Integer` over a ranged int alias arrives as a bare `named` — the same
	// tag a `String` and a struct arrive with — and asking the tag directly refused a result that fits the
	// R8 channel exactly. A union/struct return is still `named`/`structRef` after the alias resolution and
	// is still refused; an UNDECLARED callee defers to SemanticCheck's E3004 (its `integer` placeholder
	// passes). Void passes (P1.5-B2b — the awaiter discards a void async's R8 garbage).
	function requireAsyncResult(callee ByteArray, anchor Token) throws ParseError
		let resultTag = self.asyncCarriedResultTag(callee)
		if resultTag != ValueTypeTag.void and not tagRidesAsyncGprChannel(resultTag) 'unfittableResult'
			throw ParseError.unsupported("`async {String.from(callee)}(…)` must return a value the green thread can carry in R8, or void — a `float` result is returned in XMM0, which the hand-assembled trampoline never captures, and a result held at an interface type or an opaque type parameter is released through a companion the green-thread struct does not carry. A managed String/struct/array result is accepted: it is one heap pointer, and the await takes the thread's reference", line: anchor.line, column: anchor.column)
		end 'unfittableResult'
	end 'requireAsyncResult'

	// ⭐⭐ **HAND THE GREEN THREAD ITS OWN REFERENCE TO EVERY MANAGED ARGUMENT (A2)** — the spawn-site half of
	// the ownership pair whose other half is `__gt_release_<callee>` (`Runtime/AsyncReleaser.maxon`).
	//
	// ⚠ **WITHOUT IT THE ARGUMENT IS FREED BEFORE THE THREAD RUNS.** A spawn does not call its callee; it
	// ENQUEUES one. The spawning statement then ends, this frame's scope-exit drop releases the argument, and
	// the trampoline later loads a dangling pointer out of the inline argument region — a use-after-free
	// whose symptom is a SIGSEGV inside `__gt_trampoline` once allocator churn puts the freed slot back in
	// play, which is exactly what `specs-shv2/async-await.md`'s `managed-args-many` is a regression guard for.
	//
	// ⭐ **IT IS `transferConsumedArg`, THE DOOR AN ORDINARY CONSUMING CALL COMES THROUGH, AND THAT IS THE
	// WHOLE MECHANISM RATHER THAN A CONVENIENCE.** "Hand a managed value to something that will use it after
	// this statement and must release it" is one question, and the tree already answers it: an owned BINDING
	// co-owns (it keeps its own scope drop, the thread takes a second reference), an owned TEMPORARY is
	// adopted (drained from the statement's pending drops), and a BORROWED String — an `.rdata` literal, a
	// borrowed parameter — is PROMOTED to a fresh owned record, because increfing an immortal literal writes
	// into read-only memory. Each of those three is a measured trap paid for elsewhere; a spawn-local
	// `__mm_incref` would have re-derived the easy third of it and reproduced the other two.
	//
	// ⚠ **IT TRANSFERS EVERY MANAGED ARGUMENT, NOT ONLY THE DECLARED-CONSUMED ONES**, which is where it
	// departs from `transferConsumedArgs`: an ordinary call's BORROWED argument needs no transfer because the
	// caller's frame provably outlives the call, and a spawn's provably does not. The declared-consume bits
	// therefore say nothing here — and a callee that genuinely consumes a managed parameter is refused one
	// tier up (`SemanticCheck.requireAsyncScalarParams`), because it would drop the parameter itself when it
	// ran and the releaser would drop it again.
	//
	// The RESULT replaces the argument, for `transferConsumedArgs`' reason: a promoted borrowed String is a
	// DIFFERENT record, and it is the one the inline argument region must carry.
	function transferAsyncSpawnArgs(args ValueIdArray, anchor Token) throws ParseError
		for i in 0 upto args.count() 'eachArg'
			let argValue = try args.get(i) otherwise panic("transferAsyncSpawnArgs: args.get OOB at {i}")
			if not self.valueIsManagedHeap(argValue) 'scalar'
				continue
			end 'scalar'
			try args.set(i, value: try self.transferConsumedArg(argValue, anchor: anchor)) otherwise panic("transferAsyncSpawnArgs: args.set OOB at {i}")
		end 'eachArg'
	end 'transferAsyncSpawnArgs'

	// ⭐⭐ **THE TWO FACTS AN `await` NEEDS, FROM WHICHEVER ROAD ITS PROMISE CAME BY (P1.5-B2c)** — see
	// `AwaitedPromise`, which carries the argument. A SPAWN in this frame is described by the callee its
	// defining `asyncCall` names; a promise out of STORAGE is described by its own type's arguments, because
	// no `asyncCall` is reachable from a container.
	//
	// ⚠⚠ **IT ANSWERS THE TYPE AND NOT THE TAG, AND THAT IS A MISCOMPILE FIX, NOT A REFACTOR.** It used to
	// answer a bare `ValueTypeTag`, and `emitAwaitOp` minted the await's result with that tag beside
	// `nameId: UnnamedTypeId` — a `named` tag carrying the FILLER id. `declaredAliasOfNameId`'s header
	// states the consequence exactly: `UnnamedTypeId` is 0 and a `TypeNameInterner` starts empty, so id 0 is
	// **the first name the file mentions**. An `async` returning a ranged alias therefore produced an await
	// result typed after whatever name that happened to be — measured as
	// `Cannot return 'FilePath' from function declared to return 'int'` on `specs/async-await.md`'s
	// `nested-void`, where `File.exists(FilePath from …)` interns `FilePath` first.
	//
	// It was unreachable only by accident: `requireAsyncResult` refused every `named` return before this
	// line could run, so no `named`-tagged await result was ever minted. The moment that refusal learned to
	// resolve a ranged alias, the filler became reachable — a latent wrong answer sprung by a change in a
	// different function. The name has to come from the callee's return type, the only place it exists.
	function awaitedPromiseFacts(func IrFunction, promise ValueId) returns AwaitedPromise
		// ⭐ **THE STORAGE ROAD IS ASKED FIRST, AND IT HAS TO BE.** A spawn stored into a container keeps its
		// promise MARK (nothing clears it — the mark is what said this frame once owned the thread), so a
		// value can answer to both roads; the one that is TRUE of it is the type it now carries, because the
		// storage door checked that claim against the callee and the callee is no longer what describes it.
		let promiseType = self.valueMaxonType(promise)
		if typeIsPromiseStorage(self.signatures, t: promiseType) 'fromStorage'
			let storage = typeNameIdOf(promiseType)
			return AwaitedPromise.create(MaxonReturnType.value(self.resolvedSlotType(self.signatures.substitutedInstanceArg(storage, position: PromiseResultArgPosition))), tryTarget: TryTarget.promise(self.signatures.instanceDisplayName(storage), throwsClause: promiseStorageThrows(self.signatures, gid: storage)))
		end 'fromStorage'

		match self.asyncCallCalleeOf(func, promise: promise) 'callee'
			found(callee) then return AwaitedPromise.create(self.calleeReturnType(callee), tryTarget: TryTarget.named(callee))
			none then panic("awaitedPromiseFacts: promise v{promise} is neither a stored promise nor defined by an `asyncCall` — `valueIsPromise` admits exactly those two, and every caller gates on it")
		end 'callee'
	end 'awaitedPromiseFacts'

	// **THE OPERAND'S TYPE AS THE `await` DIAGNOSTIC NAMES IT** — the value-KIND vocabulary (`integer`,
	// `boolean`, `float`, `string`), which is NOT `typeTagName`'s ABI vocabulary (`int`, `bool`). The two
	// registers are deliberate and both are pinned across the suite: `typeTagName` says `int` because it
	// answers "what does this compile to", and every conversion and return diagnostic quotes it that way.
	// This message answers "what did you write", which is what an author who typed `await x` over an integer
	// is asking.
	//
	// It is `ValueTypeTag`'s own case name — exactly how the bootstrap derives the same word for the same
	// sentence (`DetermineValueKind(v).ToString().ToLowerInvariant()`, `maxon-sharp/Compiler/2-Parser.cs`),
	// so the two agree because both spell the enum rather than because a word list was copied. A ranged
	// alias is REDUCED first, so `await someInteger` says `integer` and never the tag `named`, which names
	// no type any author wrote.
	function awaitOperandKindName(value ValueId) returns String
		return self.rangedAliasResolvedTag(self.tagOf(value), nameId: self.valueNameId(value)).name
	end 'awaitOperandKindName'

	// The declared return type of `callee`, VOID included (an undeclared callee → an `integer` placeholder,
	// its doomed program rejected before lowering by SemanticCheck's E3004). **THE ONE REGISTRY READ both
	// async result questions are answered from** — what TAGS the await's result value (`calleeReturnTag`)
	// and what the spawn's result channel must CARRY (`asyncCarriedResultTag`) — so the two cannot come to
	// disagree about which callee they are describing.
	//
	// ⭐⭐ **AND IT IS A SWEPT TYPE, SO IT IS REPAIRED HERE — THE ASYNC ROAD'S HALF OF THE ONE THE ORDINARY
	// CALL ALREADY TAKES.** The whole-program sweep records a return type before the aliases are known
	// (`parseTypeReference`'s generic-alias arm is gated on `allFilesFolded`, and `adoptType` re-interns by
	// NAME), so `returns StringArray` arrives here as a bare `named`. An ordinary call's result is repaired
	// at its READ door (`mintOwnedCallResult` → `repairSweptType`) and the await road was not: `await`ing
	// such a spawn bound a `named` value under a name no member read could resolve — MEASURED as
	// `E3011: Unknown type 'StringArray'` at the first `.count()` on it.
	//
	// ⚠ **THE STORAGE-AGREEMENT CHECK IS THE SECOND ASKER, AND IT WAS COMPARING ONE REPAIRED SIDE AGAINST
	// ONE RAW ONE.** `requirePromiseStorageResult` resolves the CLAIMED type through `resolvedSlotType` and
	// read the RETURNED one from here unrepaired, so `Promise with (StringArray, …)` was refused with
	// *"this promise's function returns 'int'"* — a type the program does not contain. Repairing at this ONE
	// read is what makes both sides the same question; repairing at `emitAwaitOp` alone would have left the
	// refusal saying `int`.
	//
	// ⚠ A RANGED int alias is deliberately untouched by the repair (`repairSweptType` resolves a struct, a
	// float alias, a function alias, a generic alias or a tuple alias — never a ranged int), so
	// `calleeReturnTag` keeps the `named` tag its own header requires and the alias name stays available to
	// every downstream range check. That is why the ranged spelling compiled the whole time
	// (`async-await.ranged-alias-result-control`) while this one did not.
	function calleeReturnType(callee ByteArray) returns MaxonReturnType
		let swept = match self.signatures.returnTypeOf(callee, into: self.artifact.typeNames) 'r'
			declared(returnType) gives returnType
			undeclared gives MaxonReturnType.value(MaxonType.integer)
		end 'r'

		return match swept 'repair'
			void gives swept
			value(inner) gives MaxonReturnType.value(self.repairSweptType(inner))
		end 'repair'
	end 'calleeReturnType'

	// The declared return type of `callee` as a value tag, VOID included. The tag that TYPES the awaited
	// value, so a ranged alias deliberately stays `named` here — see `asyncCarriedResultTag`.
	function calleeReturnTag(callee ByteArray) returns ValueTypeTag
		return returnTypeTagOrVoid(self.calleeReturnType(callee))
	end 'calleeReturnTag'

	// ⭐ **WHAT THE SPAWN'S RESULT CHANNEL ACTUALLY CARRIES** — `calleeReturnTag`'s answer with a ranged
	// alias REDUCED to the primitive it underlies (`Integer` → `integer`, `Percent` → `float`). Void
	// answers `void`, which the gate admits.
	//
	// ⚠ **IT IS DELIBERATELY NOT `calleeReturnTag`, AND COLLAPSING THE TWO WOULD LOSE THE ALIAS.**
	// `calleeReturnTag` TYPES the await's result value, and a ranged-int result must keep its `named` tag
	// there or the alias name is gone and every downstream reader of it — `declaredAliasOfValue`, the
	// range-check sites — sees a plain unaliased int. The REFUSAL below asks the opposite question, which
	// register file the result travels in, and `named` is far too coarse to answer that: it covers a
	// `String`, a struct AND `typealias Integer = int(i64.min to i64.max)` alike. Refusing all three
	// together is why nearly every case in `specs/async-await.md` was rejected for a channel its `Integer`
	// result fits exactly — the alias resolver this now asks through (`rangedAliasResolvedTag`) had existed
	// the whole time and was simply never wired to this door.
	function asyncCarriedResultTag(callee ByteArray) returns ValueTypeTag
		return match self.calleeReturnType(callee) 'r'
			void gives ValueTypeTag.void
			value(inner) gives self.rangedAliasResolvedTag(maxonTypeTag(inner), nameId: typeNameIdOf(inner))
		end 'r'
	end 'asyncCarriedResultTag'

	// ⭐ **`await p` — BLOCK ON A PROMISE** (P1.5-B1a/B2b). PLAIN (non-`try`) await. Refuses a THROWING promise
	// (E3057): a plain `await` lowers to `__gt_await`, which yields only the result and DROPS the R10 error
	// flag — a throw would be delivered as a wrong answer (and a boxed error would leak). A throwing promise
	// must be `try await`ed, which the `try` target path (`parseTryCallTarget`) reaches via the SAME
	// `emitAwaitOp` WITHOUT this reject, because catching the error is exactly what `try await` does.
	function emitAwait(func IrFunction, promise ValueId, awaitTok Token) returns ValueId throws ParseError
		// Gated rather than unconditional so a NON-promise operand keeps falling through to `emitAwaitOp`'s
		// E3005 (`await x` over an integer), which is the diagnostic that program owes — the facts lookup
		// would panic on it, and its precondition is exactly this test.
		if self.valueIsPromise(promise) 'aPromise'
			try self.rejectPlainAwaitOfThrowing(self.awaitedPromiseFacts(func, promise: promise), awaitTok: awaitTok)
		end 'aPromise'
		return try self.emitAwaitOp(func, promise: promise, awaitTok: awaitTok)
	end 'emitAwait'

	// Refuse a plain `await` of a THROWING promise (E3057) — the await twin of `try` on a throwing call. A
	// non-throwing promise is accepted (no-op). It reads the clause through `tryTargetThrows`, the SAME
	// accessor the `try await` desugar binds its `otherwise (e)` at, so the form that is refused here and the
	// form that is accepted there cannot come to disagree about whether a promise throws.
	function rejectPlainAwaitOfThrowing(facts AwaitedPromise, awaitTok Token) throws ParseError
		let clause = self.tryTargetThrows(facts.tryTarget)
		if throwsClauseIsThrowing(clause) 'throwing'
			// `otherwise panic` and not a `match`: `throwsClauseIsThrowing` has just answered that this clause
			// carries a name, so the `none` arm is unreachable by the line above it.
			let errorType = try throwsClauseName(clause) otherwise panic("rejectPlainAwaitOfThrowing: a clause throwsClauseIsThrowing accepted has a name")
			throw ParseError.awaitThrowingPromiseNeedsTry(errorType, line: awaitTok.line, column: awaitTok.column)
		end 'throwing'
	end 'rejectPlainAwaitOfThrowing'

	// Emit the `await` op for a validated promise operand — the shared core of plain `await` (`emitAwait`) and
	// the `try await` target (`parseTryCallTarget`). Refuses a non-promise operand (E2015). The result tag is
	// the AWAITED result type (recovered from the callee — the handle carries only `integer`), so a void async
	// yields a void await result the desugar handles and a scalar async yields its scalar.
	function emitAwaitOp(func IrFunction, promise ValueId, awaitTok Token) returns ValueId throws ParseError
		if not self.valueIsPromise(promise) 'notPromise'
			throw ParseError.awaitNonPromise(self.awaitOperandKindName(promise), line: awaitTok.line, column: awaitTok.column)
		end 'notPromise'
		// ⭐ MINTED FROM THE CALLEE'S RETURN **TYPE**, its interner name included — see `awaitedResultType`
		// for the filler-name-id wrong answer that minting from the bare tag produced.
		let result = match self.awaitedPromiseFacts(func, promise: promise).result 'r'
			void gives self.mintValue(ValueTypeTag.void, nameId: UnnamedTypeId)
			value(inner) gives self.mintValueOfType(inner)
		end 'r'
		// ⭐⭐ **THE AWAIT ADOPTS THE THREAD'S REFERENCE TO A MANAGED RESULT (A2)** — the same enrolment an
		// ordinary call's owned managed result gets, and in the same place (between the mint and the op).
		// `__gt_await` hands back the `+1` the green thread's own `return` produced and does NOT release it
		// (`__gt_release_<callee>` is called with the result CONSUMED there), so this frame owes exactly one
		// drop; without the enrolment nobody owes it and the record leaks (exit 101). The DUAL is
		// `__gt_promise_drop`, which calls the releaser with the result NOT consumed precisely because no
		// await ever reached this line.
		self.enrolOwnedCallTemp(result)
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.await(result, promise: promise), range: SourceRange.ofToken(awaitTok))
		// The await consumes the thread — the runtime reclaims its struct here — so its owning binding must not
		// also drop it at scope exit (P1.5-B2 #88). Covers `try await` too: `parseTryCallTarget` emits its target
		// through this same `emitAwaitOp`, then rewrites the op to `tryAwait` (the consume is independent).
		self.consumePromiseThread(promise)
		return result
	end 'emitAwaitOp'

	// ⭐ **TRANSFER OWNERSHIP OF EVERY CONSUMED ARGUMENT** (P1.4a wave 2). For a callee that consumes at
	// least one parameter, slot each SOURCE argument to its parameter position (positional by index,
	// labelled by name — the sweep's `paramNames` stand in for the not-yet-built `FuncSignature`) and, at a
	// consumed position, transfer the argument: an OWNED value is moved (poisoned if it is a live binding,
	// drained if it is a temporary), a BORROWED struct/union is refused (`E2015` — the transitive-consume
	// case), a scalar is inert. The overwhelming common callee `borrowsAll`, so this is a single `match` and
	// returns.
	function applyCallerConsume(callee ByteArray, args ValueIdArray, argLabels ByteArrayArray, argRanges SourceRangeArray, anchor Token, constructorInstance ConstructorInstance) throws ParseError
		match self.signatures.consumeOf(callee) 'c'
			borrowsAll then break 'c'
			consumes(info) then try self.transferConsumedArgs(info, args: args, argLabels: argLabels, argRanges: argRanges, anchor: anchor, constructorInstance: constructorInstance)
		end 'c'
	end 'applyCallerConsume'

	// Transfer every argument that lands at a consumed parameter position. Slots each SOURCE argument to its
	// position through `argSlotPosition` ITSELF — the one home of the label→position mapping — over the
	// sweep's own `paramNames`, because at parse time the `FuncSignature` does not yet exist. It used to
	// re-spell the mapping inline (`i if label.isEmpty() else info.indexOfParam(label)`), which is exactly
	// the drift `argSlotPosition`'s header warns of, and it lost that function's O(P) fast path with it;
	// asking against a bare name LIST rather than a signature (P1.7a slice 2b-vi) is what made the shared
	// door reachable from here at all. A malformed call
	// (an arity mismatch, an unknown label) leaves the position `>= paramNames.count()`, which `isConsumed`
	// answers false, so it is left untouched here and reported by SemanticCheck against the real registry.
	function transferConsumedArgs(info ParamConsumeInfo, args ValueIdArray, argLabels ByteArrayArray, argRanges SourceRangeArray, anchor Token, constructorInstance ConstructorInstance) throws ParseError
		// An OPAQUE `T` value consumed at TWO argument positions of a single call inherits ONE reference twice and
		// so would be dropped twice — a double-free — the call analog of the struct-literal
		// `rejectDoubleOwningStore` (`Self{a: v, b: v}`), asking that door's own gate. Track each such value at a
		// CONSUMING position; a repeat is use-after-move (E3102), positioned on the second occurrence. A BORROWED
		// consumed arg is promoted to a
		// FRESH owned copy per position (`transferConsumedArg`), so it never aliases and is not tracked; a scalar
		// is inert. A two-BORROW call (`sum(box, b: box)`) reaches no consuming position, so it is never rejected.
		// ⛔ **A CONCRETE OWNED MANAGED VALUE IS NO LONGER TRACKED HERE (⚖ 2026-08-12).** It CO-OWNS at each
		// consuming position now (`transferConsumedArg`), so `Pair.create(box, b: box)` takes two references and
		// the two destructor drops release exactly those two — see `isRepeatedOwningMove` for the retraction.
		var consumedOwned = ValueIdArray.create()
		for i in 0 upto args.count() 'eachArg'
			let label = try argLabels.get(i) otherwise panic("transferConsumedArgs: argLabels.get OOB at {i} — args and argLabels are pushed in lockstep")
			let position = argSlotPosition(info.paramNames, argIndex: i, label: label)
			let argValue = try args.get(i) otherwise panic("transferConsumedArgs: args.get OOB at {i}")
			// ⛔⛔ **THE THIRD ARRIVAL: A FEED HANDS THE CALLEE A VALUE IT WILL KEEP (BATCH41 arrival roster).**
			// A `List with <inner alias>` reaches NO other door — `List` is a DECLARED corpus generic since
			// W153, so its chain is built inside `List`'s OWN body over `List`'s own opaque `Element` and the
			// container-create guard never sees it, while `Bag`'s `items.append(EBox.create(…))` is an ordinary
			// CALL and so never reaches `moveManagedValueInto` here either. MEASURED at the BATCH41 review's
			// merge and again at this one: `typealias BoxList = List with EBox` compiled and **segfaulted at
			// the read**. Both feed sinks are durable — a constructor feed fills a record the callee returns, a
			// callee-storage feed fills a container the callee keeps — so the fact is asked of the FEED and not
			// of the sink, and it is asked before the consume/borrow split because both halves store.
			if info.typeParamFeedOf(position).sinkIsCalleeStorage() 'aContainerTheCalleeKeeps'
				try self.requireFedContainerElementDropIsNameable(argValue, range: SourceRange.ofToken(anchor))
			end 'aContainerTheCalleeKeeps'

			// ⭐ A FEED position whose argument is an enrolled opaque owned binding is a SHARED-body forward MOVE
			// (P1.7 slice 3b-v — the forward twin of the direct `self.items.push(item)`): the callee takes
			// ownership, so this frame must move it even though the instance test borrows it (`constructorInstance`
			// none — the shared body does not know the concrete instance). The CONCRETE call site's own argument is
			// never opaque-owned, so it stays on the existing instance-feed path untouched.
			if not self.argIsConsumedAt(info, position: position, constructorInstance: constructorInstance) and not self.isOpaqueOwnedFeedArg(info, position: position, argValue: argValue) 'borrowed'
				// ⭐ A borrowed argument whose borrow ESCAPES into a durable instance field must not dangle when the
				// container OUTLIVES the source (the retain-escaping rung — the RED cross-scope UAF): BOTH feed
				// sinks RETAIN a co-owned trivial aggregate, and the callee-storage one also gives a temporary a
				// scope lifetime. Materializing a temp was the callee-storage sink's WHOLE protection until
				// W41-trivial, and a loop body's scope is shorter than the container's — see there.
				// ⚠ Its RESULT replaces the argument, exactly as `transferConsumedArg`'s does and for the identical
				// reason: an OPAQUE callee-storage feed takes its reference through the descriptor, and for a
				// byte-record type argument that reference is a `__str_clone` — a DIFFERENT record (W41-fix).
				try args.set(i, value: self.handleEscapingBorrowFeed(info, position: position, argValue: argValue, anchor: anchor)) otherwise panic("transferConsumedArgs: args.set OOB at {i}")
				continue
			end 'borrowed'
			// Only a value whose destination INHERITS this frame's reference can double-free, so the same value at
			// a second consuming position is the double-consume. A borrowed arg is promoted or co-owned per
			// position, a concrete owned one takes a reference per position, and a scalar is inert, so none of the
			// three is tracked — `repeatedOwningDestinationWouldDoubleFree` is that question, and the STRUCT-LITERAL
			// guard asks the identical one. The name is resolved only on a repeat (`consumedArgName`), where the
			// value is always a bound local.
			if self.repeatedOwningDestinationWouldDoubleFree(argValue) and self.isRepeatedOwningMove(consumedOwned, value: argValue) 'doubleConsume'
				let range = try argRanges.get(i) otherwise panic("transferConsumedArgs: argRanges.get OOB at {i} — args and argRanges are pushed in lockstep")
				throw ParseError.useAfterMove(String.from(self.consumedArgName(argValue)), line: range.line, column: range.column)
			end 'doubleConsume'
			// A borrowed String consumed arg is PROMOTED to an owned copy the callee can keep — `transferConsumedArg`
			// returns that copy, which must replace the borrowed original in the call's args so the op carries the
			// owned value (`applyCallerConsume` runs BEFORE the op is emitted). An owned/scalar arg returns itself.
			let transferred = try self.transferConsumedArg(argValue, anchor: anchor)
			try args.set(i, value: transferred) otherwise panic("transferConsumedArgs: args.set OOB at {i}")
		end 'eachArg'
	end 'transferConsumedArgs'

	// The declared name of the owning binding a consumed argument value came from — the source name the
	// cross-argument double-consume diagnostic (`transferConsumedArgs`' E3102) reports. A value passed at TWO
	// argument positions is always a bare local referenced twice (a temporary is minted by ONE expression and
	// cannot appear at two positions), so its owning binding — live, or already poisoned by the first position's
	// move — is always present, and the poison leaves its `boundValue` unchanged.
	function consumedArgName(value ValueId) returns ByteArray
		for binding in self.ownedBindings 'each'
			if binding.boundValue == value 'found'
				return binding.name
			end 'found'
		end 'each'
		panic("consumedArgName: v{value} consumed at two argument positions has no owning binding — a value at two positions is a bare local referenced twice, which is always an owned binding")
	end 'consumedArgName'

	// Is the argument at parameter `position` consumed by this call — a plain-field consume (`bits`, whatever
	// the concrete type), OR a P1.6-B2 type-parameter FEED whose concrete instance argument OWNS managed heap.
	// A trivial type-parameter feed (`Box with Point`/`IntBox`) answers false, so it is borrowed exactly as at
	// P1.6-A.
	function argIsConsumedAt(info ParamConsumeInfo, position ParamCount, constructorInstance ConstructorInstance) returns bool
		if info.isConsumed(position) 'plainConsume'
			return true
		end 'plainConsume'
		return self.instanceFeedConsumes(info, position: position, constructorInstance: constructorInstance)
	end 'argIsConsumedAt'

	// ⭐ **IS THE ARGUMENT AT `position` AN OPAQUE OWNED TYPE-PARAMETER FEED FORWARD (P1.7 slice 3b-v)?** A
	// feed position whose argument is an enrolled owned opaque `typeParameter` binding — the SHARED-body
	// forward move (`self.store(item)`) that `argIsConsumedAt`'s instance test cannot see, because the shared
	// body carries no concrete instance (`constructorInstance` none). The value-level dual of the direct
	// `moveElementIntoContainer` opaque poison. False for every non-feed position and every non-opaque argument
	// (a concrete String / struct feed argument, the CONCRETE call site's own value), so it moves nothing the
	// instance path already owns.
	function isOpaqueOwnedFeedArg(info ParamConsumeInfo, position ParamCount, argValue ValueId) returns bool
		return info.typeParamFeedOf(position).isFeed() and self.valueIsOpaqueOwned(argValue)
	end 'isOpaqueOwnedFeedArg'

	// ⭐ **KEEP A BORROWED ARGUMENT ALIVE WHEN ITS BORROW ESCAPES INTO A DURABLE INSTANCE FIELD (the
	// retain-escaping rung — the user ruling, 2026-07-23).** A `T`-typed FEED position stores its argument into
	// an instance field the enclosing container OUTLIVES, so a later read of that field must not see freed
	// memory. Two feed shapes reach here, and they DIFFER in who owns the stored value — the split
	// `TypeParamFeed.sinkIsCalleeStorage` reads, which used to be read off `ParamConsumeInfo.isInstanceMethod()`
	// (W10: a STATIC can feed callee storage through a local `Array with T`, so having a receiver is not the
	// question — where the value LANDS is):
	//
	//   • A CONSTRUCTOR feed (`Box.create(item T)` → `Self{ item: item }`) makes the BOX co-own the
	//     element. For a trivial struct/instance (`Box with Point`), which the call site BORROWS rather than
	//     consumes, `__mm_retain` raises the box's refcount so it holds a REAL second reference — generalizing
	//     OPEN #40's aggregate co-ownership. The box's destructor decref (`genericInstanceFieldIsManaged` now
	//     `typeIsManaged`) releases it, and the caller's OWN drop releases the caller's reference: freed exactly
	//     once whether the source is a temporary, a named inner binding, or an outer binding the box outlives —
	//     all uniformly, which is why no scope-local materialization is needed for this shape. A SCALAR feed
	//     owns no heap and needs no retain.
	//   • A CALLEE-STORAGE feed (`items.push(item)`, `self.saved = next` — the slice-3b mechanism) moves
	//     the argument into durable storage the CALLEE owns, and a borrowed CONCRETE aggregate takes the SAME
	//     `__mm_retain` its constructor sibling above takes, through the same door. It is the same
	//     co-ownership: the container holds a real second reference, released by its own column/field drop.
	//
	//     ⛔⛔ **IT USED TO TAKE NO REFERENCE AT ALL, AND A SCOPE-LIFETIME EXTENSION WAS ITS WHOLE PROTECTION
	//     — WHICH IS SOUND ONLY WHILE THE CONTAINER DOES NOT OUTLIVE THE SCOPE, AND A LOOP GUARANTEES IT DOES
	//     (W41-trivial).** `giveTemporaryScopeLifetime` promotes the temporary to the ENCLOSING FRAME, so a
	//     `m.upsert(Point.create(i), value: i)` written in a loop body is freed at the end of ITS ITERATION
	//     while the map still points at it. MEASURED: `Map with (Point, Val)` filled in a loop printed
	//     `total 0` against the oracle's `total 15` — exit 0, no diagnostic, `count()` correct and every key
	//     in the column dangling. The straight-line spelling of the identical program passed, because
	//     `main`'s own frame is the scope there; that is why `specs-shv2/map.md`'s
	//     `a-user-type-can-be-a-map-key` advertised a capability it did not have.
	//
	//     ⚠ **A NAMED BINDING FAILED IDENTICALLY, so the lifetime extension was never the missing half.**
	//     `let k = Point.create(i)` inside the loop measured `total 0` too — the binding owns the box and
	//     drops it at the body's end exactly as the promoted temporary does. What was missing is a REFERENCE,
	//     which only the retain can supply, and it is taken for a named source and a temporary alike.
	//
	//     The extension still runs and is still correct — it is a no-op on anything no statement owns, and it
	//     is what protects the one shape that takes no reference (an opaque argument whose owner nothing
	//     instantiates, below). Reverse drop order frees the source after the container either way.
	//
	// ⛔⛔ **AND AN OPAQUE `T` ARGUMENT AT A CALLEE-STORAGE POSITION TAKES A REAL REFERENCE HERE — THE OTHER
	// HALF OF THE `Map.grow()` DOUBLE FREE (W41-fix).** A callee-storage feed parameter is enrolled OWNED
	// (`bindParameters`) and its sink MOVES it, so the callee's whole ownership story rests on the caller
	// having handed over a reference. Every other path into that position does hand one over —
	// `argIsConsumedAt` transfers, `isOpaqueOwnedFeedArg` moves — and this one, the SHARED-body borrow, handed
	// over nothing at all: a lifetime extension keeps the caller's own value alive, it does not give the callee
	// a reference to keep. `stdlib/Map.maxon`'s `grow()` → `insertAtSlot(key: <borrowed>)` is exactly that
	// path, and the entry was then freed by the NEW array's element walk and by the OLD array's (measured:
	// `0xC0000005` at 13 entries where the oracle prints `count 200`).
	//
	// ⚠ **IT IS TAKEN HERE AND NOT AT THE STORE, BECAUSE THIS IS THE ONLY FRAME THAT CAN SEE THE BORROW.**
	// Inside the callee the value is a PARAMETER and answers "owned" whatever the caller did — which is the
	// inference that was wrong. Taking it here makes that answer TRUE by construction, and needs no
	// cross-procedural analysis: the rule is local and total — a feed position always receives a reference the
	// callee may keep. (`referenceBorrowedOpaqueElement` carries the measurement showing that widening the STORE
	// instead is cancelled by the parameter's OWN scope drop — an argument about an owned value, which is
	// exactly why a BORROWED store may take its reference at the store and this one still may not.)
	//
	// ⚠ **THE TWO SINKS NOW DIFFER ONLY IN THE LIFETIME EXTENSION AND IN THE OPAQUE ARM** — the reference
	// itself is one act with one spelling (`coOwnConcreteAggregateFeed`), because "a borrowed CONCRETE
	// aggregate escaping into something that outlives this statement takes an `__mm_retain`" is one fact, and
	// it was written at one sink and not the other for as long as both existed.
	function handleEscapingBorrowFeed(info ParamConsumeInfo, position ParamCount, argValue ValueId, anchor Token) returns ValueId
		let feed = info.typeParamFeedOf(position)
		if not feed.isFeed() 'notEscapingFeed'
			return argValue
		end 'notEscapingFeed'
		// ⛔⛔ **AN OPAQUE ARGUMENT AT *THIS* SINK STILL TAKES NO REFERENCE, AND THAT IS A USE-AFTER-FREE —
		// MEASURED AT REVIEW, PRE-EXISTING, AND DELIBERATELY NOT CLOSED HERE.** `coOwnConcreteAggregateFeed`
		// is inert on a `typeParameter` tag (`valueIsNonTextAggregate` is false), so a SHARED body forwarding
		// its own borrowed `T` into another generic's `create()` hands the new box a reference nobody took:
		// `type Outer uses E` doing `return (Inner with E).create(try items.get(i) otherwise …)` at
		// `Outer with String` prints the right answer and dies **0xC0000005**, where the bootstrap exits 0 and
		// the CONCRETE spelling of the same program runs (there `argIsConsumedAt` transfers). It is
		// byte-identical at the merge base — this wave neither caused it nor widened it.
		//
		// ⛔ **THE SYMMETRIC FIX WAS TRIED AND MEASURED WORSE: it refuses FOUR committed programs that need
		// nothing.** Routing the opaque arm below through this sink turns
		// `generic-type-substitution/own-name-in-a-generic-body-is-still-Self`,
		// `inner-alias-construction/generic-body-user-generic-inner-alias-create` and two
		// `self-type-member-expression` cases into E2015 — every one of them a `Box with Integer`, a TRIVIAL
		// instantiation owing no reference, in a `static function` that structurally has no `self` to source a
		// descriptor from. The retain must be reserved statically and can only be needed dynamically, and
		// `genericTypeIsInstantiated`'s header says why the seed cannot ask the stronger question: it runs
		// before any body is parsed, so a CONCRETE instantiation is not yet interned. ⇒ Closing this needs a
		// descriptor-need seed for "forwards a borrowed opaque `T` to a feed position" that the token pre-scan
		// cannot produce — a rung, not a review edit. FILED, with this reproducer, rather than half-taken.
		if not feed.sinkIsCalleeStorage() 'constructorFeed'
			return self.referenceOrMarkOpaqueFeed(argValue, anchor: anchor)
		end 'constructorFeed'

		self.giveTemporaryScopeLifetime(argValue, name: EscapingFeedSourceBindingName)
		// A CONCRETE argument at a feed position is the call site's own value, whose consume/borrow decision
		// `argIsConsumedAt` already made off the instance's type argument — a trivial aggregate is deliberately
		// BORROWED (the caller keeps it usable) and CO-OWNED, so the reference is taken here. An OPAQUE
		// shared-body borrow, which no instance test can see, takes its own through the descriptor below.
		return self.referenceOrMarkOpaqueFeed(argValue, anchor: anchor)
	end 'handleEscapingBorrowFeed'

	// ⭐⭐⭐ **THE ONE ACT BOTH FEED SINKS OWE, AND SINCE BATCH41 THE TWO DIFFER ONLY IN THE LIFETIME
	// EXTENSION.** A CONCRETE argument is the call site's own value, whose consume/borrow decision
	// `argIsConsumedAt` already made off the instance's type argument — a trivial aggregate is deliberately
	// BORROWED and CO-OWNED, so the reference is taken here. An OPAQUE shared-body borrow, which no instance
	// test can see, takes its own through the enclosing instance's descriptor.
	//
	// ⛔⛔ **THE CONSTRUCTOR SINK USED TO TAKE NOTHING AT ALL, AND THAT WAS A USE-AFTER-FREE.** MEASURED, on
	// `Bag.wrap(x Element) returns EBox` at `Bag with String`, whose caller's heap `String` dies at its scope
	// exit and whose `__destruct_Box_String` then frees it a second time: **`0xC0000005`**, byte-identical on
	// `main` and on this branch, and exit 0 with the payload printed once the reference is taken here.
	//
	// ⚠ **THE NARROWING IS THE INSTANTIATION AND NOT THE SINK** (`typeParamFeedCanOwnAReference`): taking it
	// unconditionally refuses FOUR committed programs whose instantiation is trivial and owes no reference at
	// all, because the retain is RESERVED statically (a descriptor parameter) and NEEDED only dynamically.
	// Declining there emits nothing that would have done anything — `retainFunc@64` is 0.
	//
	// ⚠ When no reference IS taken, the record this feed fills gets a slot holding a borrow nobody referenced,
	// which is sound where the record dies inside the borrow's lifetime and is not where it comes to rest.
	// That fact is recorded rather than acted on here; the refusal is at the ARRIVAL
	// (`requireFedContainerElementDropIsNameable`).
	function referenceOrMarkOpaqueFeed(argValue ValueId, anchor Token) returns ValueId
		if self.tagOf(argValue) != ValueTypeTag.typeParameter 'concreteArgument'
			self.coOwnConcreteAggregateFeed(argValue, anchor: anchor)
			return argValue
		end 'concreteArgument'
		if not self.signatures.typeParamFeedCanOwnAReference(self.valueNameId(argValue)) 'noInstantiationOwesOne'
			return argValue
		end 'noInstantiationOwesOne'

		// The record this feed fills now holds a reference only the enclosing instance's descriptor can release
		// (BATCH41 review). Armed here, at the one line that takes it, and carried to the call's RESULT by
		// `emitCall`.
		self.callReferencedAnOpaqueFeedSlot = true

		return self.coOwnBorrowedOpaque(argValue, range: SourceRange.ofToken(anchor))
	end 'referenceOrMarkOpaqueFeed'

	// ⭐ **TAKE THE SECOND REFERENCE A BORROWED CONCRETE AGGREGATE OWES ITS DURABLE SINK** — the one act both
	// feed sinks perform, so a third sink cannot inherit half of it. Only a NON-CONSUMED argument reaches
	// `handleEscapingBorrowFeed` at all (`argIsConsumedAt` diverted every owning one), so what arrives here is
	// exactly the co-owned trivial class (`typeArgIsCoOwnedTrivial`: a struct box, a trivial generic instance)
	// plus the scalars — and a SCALAR is not a pointer, owns no record and needs nothing, which is what
	// `valueIsNonTextAggregate` answers `false` for. A byte record cannot arrive: a `String` type argument is
	// `typeArgIsOwned` and is consumed, never borrowed.
	//
	// The released end is the container's own drop, on the SAME `typeIsManaged` boundary this retain implies —
	// a direct field through `genericInstanceFieldIsManaged`, an opaque column through the descriptor's
	// `destroyFunc@40` (`managedOpaqueArrayElementOf`, which carries the measurement of what the two reading
	// different boundaries cost).
	function coOwnConcreteAggregateFeed(argValue ValueId, anchor Token)
		if not self.valueIsNonTextAggregate(argValue) 'scalarOwnsNoRecord'
			return
		end 'scalarOwnsNoRecord'

		self.emitIncref(argValue, range: SourceRange.ofToken(anchor))
	end 'coOwnConcreteAggregateFeed'

	// Does the concrete instance's argument at parameter `position`'s type-parameter feed own managed heap
	// (P1.6-B2)? Only a generic-alias constructor carries an instance; only a fed parameter has a position; a
	// borrowed (trivial) argument answers false.
	function instanceFeedConsumes(info ParamConsumeInfo, position ParamCount, constructorInstance ConstructorInstance) returns bool
		match constructorInstance 'ci'
			none then return false
			instance(gid) then return self.instanceFeedConsumesFor(gid, info: info, position: position)
		end 'ci'
	end 'instanceFeedConsumes'

	// The instance-in-hand half of `instanceFeedConsumes` — the parameter is consumed iff it feeds a type
	// parameter whose concrete argument owns managed heap. The feed's SINK does not enter here, and deliberately:
	// whether the CALLER must transfer is settled by the concrete argument alone, and both sinks then take
	// ownership of what arrives (one into the value the call returns, one into the callee's own storage).
	function instanceFeedConsumesFor(gid GenericInstanceId, info ParamConsumeInfo, position ParamCount) returns bool
		match info.typeParamFeedOf(position) 'f'
			none then return false
			feeds(tpPos, _) then return self.signatures.genericInstanceArgIsOwned(gid, position: tpPos)
		end 'f'
	end 'instanceFeedConsumesFor'

	// Hand one consumed argument to the callee, returning the value the call must actually carry. A
	// SCALAR argument owns no heap and the consume is inert (returns itself). An OWNED CONCRETE managed value
	// held by a live BINDING is CO-OWNED (the 2026-08-12 durable-sink ruling — the binding stays live and keeps
	// its own scope-exit drop); an owned TEMPORARY is ADOPTED, drained from the statement's pending drops
	// because the callee owns it now. Both go through the shared sink door
	// (`storeOwnedValueIntoDurableSink`), which is where that split and its ruling live. A BORROWED
	// STRING (a long rdata literal, or a borrowed String parameter/field) has a cheap owning copy, so it is
	// PROMOTED into a fresh owned record the callee can move into its field — exactly as a DIRECT struct-field /
	// union-payload move-in does (`moveManagedValueInto`) — and THAT copy is returned to replace the borrowed
	// arg. A borrowed STRUCT/UNION/EXISTENTIAL has no STATIC clone and becomes a SECOND OWNER instead
	// (`coOwnBorrowedForConsume`) — the transitive-consume case, and what it is answered with. Its RESULT
	// replaces the argument too: an existential's reference is taken through the witness, and a byte-record
	// conformer's protocol there is the same COPY the concrete arm above takes.
	function transferConsumedArg(argValue ValueId, anchor Token) returns ValueId throws ParseError
		// ⭐ AN OPAQUE OWNED type-parameter binding forwarded to a consuming sibling feed position (P1.7 slice
		// 3b-v): the callee takes ownership, so MOVE it — poison the source binding so a second use is E3102 and
		// this frame does not drop it too. Its `typeParameter` tag fails `valueIsManagedHeap` below (opaque here),
		// so this must precede the scalar short-circuit; it carries no owning COPY (like an owned aggregate), so
		// the value passes through unchanged, poisoned in place. Reached only for `isOpaqueOwnedFeedArg` positions.
		if self.valueIsOpaqueOwned(argValue) 'opaqueOwned'
			// ⭐⭐ **INSIDE A LOOP THE FRAME TAKES A NEW REFERENCE INSTEAD OF GIVING UP ITS OWN — W58's RULE,
			// AT THE DOOR AN ORDINARY CONSUMING CALL COMES THROUGH (ARRG).** It was written only into
			// `moveElementIntoContainer`, whose header states the whole argument (N iterations take N
			// references; a `movedFrom` bit set once at the store's TEXT cannot say "moved on iteration 3,
			// live on iteration 4"; and a loop that never runs leaks the caller's reference outright). That
			// argument is about the LOOP and the SINK's obligation, not about which door emitted the store —
			// so a sibling call that consumes its opaque argument owes exactly the same discharge, and had
			// only the refusal.
			//
			// ⛔ **MEASURED, on a program with no `Array` mutator in it at all**: `Bag.fill(n, v)` whose loop
			// body calls the consuming sibling `store(v)` was refused *"moving a value declared outside this
			// loop from inside the loop body"*, while the identical loop writing `items.set(n, value: v)`
			// compiled — one rule, two answers, decided by which arm happened to serve the statement. It is
			// also what leaves `stdlib/Array.maxon`'s `set` unreachable from a shared body: served by the
			// corpus, `Bag.fillTo`'s store IS this door.
			//
			// The decision is `moveOfValueEscapesLoop`, read by both doors so they cannot settle on different
			// bindings (see `liveOwnerIndexOf`), and the reference is `coOwnBorrowedOpaque`, emitted by both
			// so the retain and its release are one protocol.
			if self.moveOfValueEscapesLoop(argValue) 'referenceRatherThanMove'
				return self.coOwnBorrowedOpaque(argValue, range: SourceRange.ofToken(anchor))
			end 'referenceRatherThanMove'

			try self.poisonMoveSource(argValue, anchor: anchor)
			self.removeFromPendingTemps(argValue)
			return argValue
		end 'opaqueOwned'
		if not self.valueIsManagedHeap(argValue) 'scalar'
			return argValue
		end 'scalar'
		if not self.valueIsOwnedHeap(argValue) 'borrowedManaged'
			if tagIsByteRecord(self.tagOf(argValue)) 'byteRecord'
				let owned = self.promoteToOwnedString(argValue, range: SourceRange.ofToken(anchor))
				self.removeFromPendingTemps(owned)
				return owned
			end 'byteRecord'
			return self.coOwnBorrowedForConsume(argValue, range: SourceRange.ofToken(anchor))
		end 'borrowedManaged'

		// ⭐⭐ **A CONSUMING ARGUMENT IS A DURABLE SINK, SO IT CO-OWNS RATHER THAN MOVING (⚖ user ruling,
		// 2026-08-12).** The callee stores what it is handed, which is exactly the obligation the DIRECT store
		// door discharges one frame in — so both go through the ONE sink door
		// (`storeOwnedValueIntoDurableSink`, which carries the ruling and the live-binding-vs-temporary split).
		// Two spellings of one sink would be the shape this file keeps naming: `self.saved = chunk` legal and
		// `store(chunk)` an E3102, decided by which door happened to serve the statement. Its owned-set scan is
		// the same one `poisonMoveSource` ran here unconditionally, so the widening costs no lookup that was not
		// already paid.
		return self.storeOwnedValueIntoDurableSink(argValue, isString: tagIsByteRecord(self.tagOf(argValue)), range: SourceRange.ofToken(anchor))
	end 'transferConsumedArg'

	// ⭐⭐ **ARE THESE TWO DECLARED ANSWERS INTERCHANGEABLE AT A CALL?** — the question a whole-program index
	// that keeps ONE return type per key silently answers YES to for every declaration wearing that key.
	//
	// The TAG half is `overloadResultTagAgrees` asked in BOTH directions — the same rule
	// `SemanticCheck.requireOverloadResultTagAgrees` refuses on — so a set the tags call agreeing is exactly
	// a set that pass can never report. Two ranged aliases therefore agree (they are both numbers), which is
	// what keeps `stdlib`'s own overload sets on the untouched path.
	//
	// ⛔⛔ **THE TAG HALF WAS THE WHOLE TEST, AND THAT WAS A MEASURED SILENT WRONG ANSWER (rung review).**
	// Two struct returns are both `structRef` and two generic-instance returns are both `genericInstance`, so
	// a set returning two DIFFERENT aggregates read as agreeing: the decider declined, `returnTypeOf`'s
	// last-wins answer typed the call from the OTHER member — and the sentence above is exactly why nothing
	// reported it, the two being consistently blind together. **MEASURED:** `pick(n Integer) returns Box`
	// beside `pick(s String) returns Bag`, two two-field structs whose fields are declared in OPPOSITE
	// orders, called `pick(1)` — `b.first` printed **22** where the bootstrap prints **11**. The value was a
	// `Box` read at `Bag`'s offsets, compiled clean, with no diagnostic at any stage.
	//
	// ⇒ once the tags agree, only a nominal IDENTITY can still part them, and it is read through the ONE
	// routine that answers it (`aggregateNameOf`) — the same refinement `sweptOverloadArgFit` applies to a
	// PARAMETER at the same pair, and the same "a ranged alias names no aggregate" rule that keeps two
	// spellings of one number interchangeable.
	function returnAnswersAreInterchangeable(left MaxonReturnType, right MaxonReturnType) returns bool
		let leftTag = returnTypeTagOrVoid(left)
		let rightTag = returnTypeTagOrVoid(right)
		// `void` is not a `MaxonType`, so the void/value split is settled before any tag is compared — and a
		// value answer meeting a void one is the quadrant no retype can repair
		// (`SemanticCheck.requireOverloadVoidResult`).
		if leftTag == ValueTypeTag.void or rightTag == ValueTypeTag.void 'oneOfThemReturnsNothing'
			return leftTag == rightTag
		end 'oneOfThemReturnsNothing'

		if not (overloadResultTagAgrees(leftTag, declared: rightTag) and overloadResultTagAgrees(rightTag, declared: leftTag)) 'theTagsAlreadyPartThem'
			return false
		end 'theTagsAlreadyPartThem'

		return not namedAggregatesConflict(self.adoptedReturnAggregateName(left), got: self.adoptedReturnAggregateName(right))
	end 'returnAnswersAreInterchangeable'

	// The aggregate identity of a SWEPT return type, read in this file's own interner. ADOPTED first because
	// `aggregateNameOf` resolves ids against `self.artifact.typeNames` and a swept id is the INDEX's — the
	// same crossing `overloadedCallResultType` makes for the type it finally hands back. Reached only once
	// the tags have already agreed, so no set the tag test parts pays for it.
	function adoptedReturnAggregateName(swept MaxonReturnType) returns ByteArray
		return match self.signatures.adoptReturnType(swept, into: self.artifact.typeNames) 'adopted'
			void gives EmptySourceText
			value(inner) gives self.aggregateNameOf(maxonTypeTag(inner), nameId: typeNameIdOf(inner))
		end 'adopted'
	end 'adoptedReturnAggregateName'

	// ⭐⭐ **DO THE DECLARATIONS OF ONE NAME DISAGREE ABOUT WHAT THEY RETURN?** — the gate that keeps the
	// parse-time overload decider off every call in every program that does not need it. It is asked of ALL
	// the declarations rather than of the visible ones, because what a disagreement spoils is
	// `ProgramSignatures.returnTypeOf`, whose one entry per key is written by whichever declaration was swept
	// last — visible from the reader or not.
	//
	// ⚠ **EVERY CANDIDATE IS COMPARED AGAINST THE FIRST, AND THAT IS COMPLETE BECAUSE THE RELATION IS AN
	// EQUIVALENCE.** Its tag half is class equality (`typeClassesAgree`) refined by floatness — the one
	// non-equality it admits, int-to-float widening, is exactly what the floatness test removes — and its
	// name half is byte equality. A pairwise sweep would find nothing this fold does not.
	function sweptOverloadsDisagreeOnReturnType(candidates OverloadedDeclArray) returns bool
		let first = try candidates.get(0) otherwise panic("sweptOverloadsDisagreeOnReturnType: an empty candidate list — the caller returns on `count() < 2` before asking")
		for i in 1 upto candidates.count() 'eachLater'
			let later = try candidates.get(i) otherwise panic("sweptOverloadsDisagreeOnReturnType: candidates.get OOB at {i} inside its own count()")
			if not self.returnAnswersAreInterchangeable(first.returnType, right: later.returnType) 'twoAnswers'
				return true
			end 'twoAnswers'
		end 'eachLater'
		return false
	end 'sweptOverloadsDisagreeOnReturnType'

	// Mint the SSA value a call to `calleeTok` defines, typed from the WHOLE-PROGRAM signature index
	// (SignatureIndex.maxon) — so the type is exact whether the callee is declared above this call,
	// below it, or in another file entirely.
	//
	// The index answers with the DECLARATION, undistorted, which is what makes the two cases below
	// distinguishable at all. The shipped code asked a file-local table and mapped BOTH "this file
	// does not declare it" and "it declares nothing to return" onto one `MaxonType.unresolved` — a
	// sentinel with two meanings, and TypeRules' `unknown` (which agrees with everything) is what it
	// became. That is how `isReady()` from another file added to 41 and made 42, and how
	// `let x = noop()` then `x + 4` compiled at all.
	// ⭐⭐⭐ **WHICH OVERLOAD'S RETURN TYPE THIS CALL READS — the CALL half of a cross-file overload set, and
	// the only decision the parser has to take about a set it does not resolve.**
	//
	// A call's result type is fixed while its own file is parsed: the tag decides the Std type of the result
	// (`lowerMaxonToStd`), whether a scope-exit drop is enrolled for it (`enrolOwnedCallTemp`) and which
	// register file it travels in. The MEMBER is chosen a whole pass later
	// (`SemanticCheck.resolveOverloadedCalls`), so with one return type per NAME every call to a disagreeing
	// set was typed from whichever declaration the sweep read last. See `ProgramSignatures.OverloadedDecl`
	// for the two measured failures that produced — an access violation and a leak.
	//
	// ⭐ **IT ANSWERS `undecided` WHENEVER THE SET AGREES, AND THAT IS WHAT MAKES THIS DOOR INERT FOR EVERY
	// PROGRAM THAT ALREADY COMPILED.** An agreeing set has one return type however the call resolves, so the
	// by-name answer is already exact and is taken unchanged — no corpus program and no `stdlib` call takes a
	// different path or emits a different byte because of this door.
	//
	// ⚠⚠ **IT IS A NARROW DECIDER, AND IT IS *CHECKED* RATHER THAN TRUSTED.** It answers `undecided` -
	// falling back to the by-name type and to the refusal that has always guarded it
	// (`SemanticCheck.reportOverloadReturnDisagreement`) — for anything it cannot settle: a member the sweep
	// could not read a parameter type for, a call that fits several visible members, a call that fits none.
	// And when it DOES answer, `SemanticCheck.reconcileOverloadResultType` re-asks the same question against
	// the member resolution actually chose and refuses the program if the two types disagree irreconcilably.
	// So a pick this door gets wrong is a DIAGNOSTIC, never a wrong answer — which is what lets the two
	// deciders stay honest about the different things they know: this one sees only what a TOKEN SWEEP could
	// publish, and that one sees the real signatures a pass later.
	//
	// ⚠⚠ **THE TWO DECIDERS DIFFER IN THEIR CANDIDATE SET, NOT ONLY IN SCORING AND SOURCE — say so before
	// reading the paragraph below as a claim that they agree.** This door filters by `isVisibleFrom`;
	// `SemanticCheck.overloadCandidates` filters only on "did the member survive to `funcSignatures`" and
	// applies no visibility rule at all, so that pass may select a member the calling file cannot NAME — which
	// is caught afterwards by `calleeVisibilityFrom` (E3008/E3088), a refusal rather than a privacy hole. What
	// the two share is the ORDER; where their candidate sets part, this door's answer is the narrower one and
	// the wider one is refused a pass later.
	//
	// ⚠ **VISIBILITY IS APPLIED HERE AND NOT IN THE SCORER, because for the shape this rung is about it is
	// the WHOLE answer.** Two files of one module each declaring a file-private helper of one name -
	// `stdlib/Console.maxon` and `stdlib/Subprocess.maxon` each carrying a `stripTrailingCR` — leave exactly
	// one member nameable from either file, so no type has to be compared to know which one a call means. The
	// DISAGREEMENT is still read across ALL declarations, because it is `returnTypeOf`'s answer that the
	// member this file cannot name is what spoils.
	function overloadedCallResultType(callee ByteArray, args ValueIdArray, argLabels ByteArrayArray, argDefaultSlots ParamCountArray) returns SweptOverloadPick
		// ⚡ **THE COST GATE, and it is the first thing this function does because it runs at EVERY call in the
		// program.** A name with one declaration — which is nearly every callee, every builtin and every
		// runtime symbol — leaves here on a count, having allocated nothing: `overloadedDeclsOf` answers a
		// MISS with the shared empty list rather than building one.
		//
		// ⚠ It has a DEFENSIVE property nobody set out to give it, worth knowing before anyone tightens it: a
		// double-fold of one file would push that file's declarations twice and flip this test — and the
		// duplicates then compare as agreeing (they are the same declaration), so the set still lands on
		// `undecided` and the by-name answer still serves. The gate is a cost gate; it is not what makes a
		// double-fold safe.
		let candidates = self.signatures.overloadedDeclsOf(callee)
		if candidates.count() < 2 'oneDeclarationWearsThisName'
			return sharedUndecidedOverloadPick
		end 'oneDeclarationWearsThisName'

		if not self.sweptOverloadsDisagreeOnReturnType(candidates) 'oneAnswerHoweverItResolves'
			return sharedUndecidedOverloadPick
		end 'oneAnswerHoweverItResolves'

		var picked = sharedUndecidedOverloadPick
		var best = NoCompatibleOverloadScore
		var holdingBest = 0 as OverloadCandidateCount
		for candidate in candidates 'eachCandidate'
			if not self.signatures.isVisibleFrom(candidate.visibility, declFilePath: candidate.declFilePath, readerFilePath: self.filePath) 'notNameableFromHere'
				continue
			end 'notNameableFromHere'

			var score = NoCompatibleOverloadScore
			match self.sweptOverloadFit(candidate, args: args, argLabels: argLabels, argDefaultSlots: argDefaultSlots) 'fit'
				// A parameter the sweep did not read leaves this whole set unjudgeable: a candidate that cannot
				// be refused cannot be outranked either, so a winner here would be a claim about the members this
				// door happened to be able to read.
				unscoreable then return sharedUndecidedOverloadPick
				incompatible then continue
				fits(fitScore) then score = fitScore
			end 'fit'
			if score < best 'outranked'
				continue
			end 'outranked'

			if score > best 'aNewBest'
				best = score
				holdingBest = 0
			end 'aNewBest'

			holdingBest = holdingBest + 1
			// ADOPTED into this file's interner, exactly as `returnTypeOf` adopts the by-name answer: the
			// index's ids are its own, and a `named`/`structRef` return read raw would name whatever this
			// file's table happens to hold at that id.
			picked = SweptOverloadPick.resolved(self.signatures.adoptReturnType(candidate.returnType, into: self.artifact.typeNames))
		end 'eachCandidate'

		// A TIE is `undecided` and never a choice: `SemanticCheck.selectOverload` calls the same tie E3007, so
		// the program is refused at the call rather than typed from one of the members it cannot mean.
		return picked if holdingBest == 1 else sharedUndecidedOverloadPick
	end 'overloadedCallResultType'

	// One candidate's fit, scored on the SWEEP's parameter types. Arity and labels are asked through the
	// shared `slotCallArgs` — simultaneously the label test and the arity test, and the one label-to-position
	// mapping in the compiler — and each slotted argument is then measured by `checkDeclaredType`, the same
	// coercion rule `SemanticCheck.overloadArgTypeFit` scores with a pass later and `checkOneArgType` reports
	// against after that.
	//
	// ⚠ **THE SCORE IS THAT PASS'S OWN — `ExactArgScore`/`WideningArgScore`, exported from it for this door.**
	// The two cannot share a scoring FUNCTION (one reads the SWEEP's tolerant types, the other the merged
	// registry), so what they share is the ORDER, which is the part that has to agree: a member this door
	// picks and that pass does not is a call typed from a return type it never gets, and the program earns
	// `reportOverloadReturnDisagreement` for something the author got right.
	function sweptOverloadFit(candidate OverloadedDecl, args ValueIdArray, argLabels ByteArrayArray, argDefaultSlots ParamCountArray) returns SweptOverloadFit
		// The receiver is excluded from a swept parameter list (`OverloadedDecl`) and present in the call's
		// argument list, so the two are aligned here — the same prepend `parseCallNamed` makes.
		let slotNames = callAlignedFrom(candidate.paramNames) if candidate.takesReceiver else candidate.paramNames
		match slotCallArgs(slotNames, args: args, argLabels: argLabels, argDefaultSlots: argDefaultSlots) 'slot'
			ordered(slotted) then return self.sweptOverloadArgFit(candidate, slotted: slotted)
			// An arity mismatch, a label naming no parameter, or two arguments at one parameter: this call was
			// not written against this candidate.
			arityMismatch to duplicateArg then return sharedOverloadIncompatible
		end 'slot'
	end 'sweptOverloadFit'

	function sweptOverloadArgFit(candidate OverloadedDecl, slotted ValueIdArray) returns SweptOverloadFit
		let firstUser = firstUserParamIndex(candidate.takesReceiver)
		var score = NoCompatibleOverloadScore
		for i in 0 upto candidate.paramTypes.count() 'eachUserParam'
			let swept = try candidate.paramTypes.get(i) otherwise panic("sweptOverloadArgFit: paramTypes.get OOB at {i} inside its own count()")
			if maxonTypeTag(swept) == ValueTypeTag.unresolved 'theSweepDidNotReadThisParameterType'
				return sharedOverloadUnscoreable
			end 'theSweepDidNotReadThisParameterType'

			// ⭐⭐ **ADOPTED AND THEN REPAIRED, and BOTH steps are the reason this scores what the argument
			// check will score.** The sweep's ids live in the index's own interner, and the type it recorded is
			// the TOLERANT one — a struct, a float alias and a generic alias all arrive as a bare `named`
			// (`parseTypeReference`'s `allFilesFolded` argument). Compared raw, a `ByteArray` parameter is a
			// `named` while its argument is a generic instance, and every candidate scores incompatible.
			let paramType = self.repairSweptType(self.signatures.adoptType(swept, into: self.artifact.typeNames))
			let paramTag = maxonTypeTag(paramType)
			let argValue = try slotted.get(firstUser + i) otherwise panic("sweptOverloadArgFit: slotted.get OOB at {firstUser + i} — `slotCallArgs` answered `ordered`, so the counts agree, and `paramNames`/`paramTypes` are pushed in lockstep by the one walk that fills them")
			let argTag = self.tagOf(argValue)
			if checkDeclaredType(argTag, declared: paramTag) != DeclaredTypeMatch.ok 'theCoercionRuleRefusesIt'
				return sharedOverloadIncompatible
			end 'theCoercionRuleRefusesIt'

			// ⭐ TWO DIFFERENT AGGREGATES SHARE ONE TAG, so the tag verdict alone accepts a `Bag` at a `Box`
			// parameter. The identity is the aggregate NAME, read on both sides through the ONE routine that
			// answers it (`aggregateNameOf`) — the parser's own half of the refinement
			// `SemanticCheck.overloadArgTypeFit` applies at the same pair, and the same "a ranged alias names no
			// aggregate" rule that lets an `int` literal stand at a `Cnt` parameter.
			//
			// ⚠ **IT IS THE BARE RULE AND THAT PASS USES A WIDER DOOR, SO THE TWO ARE NOT THE SAME PREDICATE.**
			// `overloadArgTypeFit` asks `ProgramSignatures.aggregatesConflict` (which carries the byte-element
			// boundary) and falls back to `sig.paramAggregateNames` for an ERASED union parameter; neither is
			// reachable from here, where the parameter type is the SWEEP's and no signature exists yet. The gap
			// is one-directional — this door can call INCOMPATIBLE a candidate that pass accepts, never the
			// reverse — so its cost is a DECLINE (`undecided`, or at worst a wrong single pick that
			// `reconcileOverloadResultType` refuses), never a candidate selected here and rejected downstream.
			if namedAggregatesConflict(self.aggregateNameOf(paramTag, nameId: typeNameIdOf(paramType)), got: self.aggregateNameOf(argTag, nameId: self.valueNameId(argValue))) 'twoAggregatesThatDoNotDenoteOneRecord'
				return sharedOverloadIncompatible
			end 'twoAggregatesThatDoNotDenoteOneRecord'

			score = score + (ExactArgScore if argTag == overloadRankTagOf(paramTag) else WideningArgScore)
		end 'eachUserParam'

		// A ZERO-PARAMETER candidate scored nothing and still fits — the arity test that separated it from its
		// siblings already ran. It is floored at `WideningArgScore` so the answer stays a score the caller can
		// compare, exactly as `SemanticCheck.overloadArgTypeFit` floors its own.
		return SweptOverloadFit.fits(score if score > NoCompatibleOverloadScore else WideningArgScore)
	end 'sweptOverloadArgFit'

	function mintCallResult(callee ByteArray, anchor Token, resultUsed bool, args ValueIdArray, argLabels ByteArrayArray, argDefaultSlots ParamCountArray) returns ValueId throws ParseError
		// ⭐⭐ **AN OVERLOAD SET WHOSE MEMBERS DISAGREE ABOUT WHAT THEY RETURN IS ASKED FIRST, AND ONLY THEN.**
		// `returnTypeOf` records ONE return type per registration key and is LAST-WINS over the declarations
		// wearing it, which is exactly right for every name whose declarations agree — every name in every
		// program the corpus compiles — and is a wrong answer for one whose declarations do not. See
		// `overloadedCallResultType` for what it will and will not decide.
		match self.overloadedCallResultType(callee, args: args, argLabels: argLabels, argDefaultSlots: argDefaultSlots) 'overloaded'
			resolved(returnType) then return try self.mintDeclaredCallResult(callee, anchor: anchor, returnType: returnType, resultUsed: resultUsed)
			undecided then break 'overloaded'
		end 'overloaded'

		match self.signatures.returnTypeOf(callee, into: self.artifact.typeNames) 'callee'
			declared(returnType) then return try self.mintDeclaredCallResult(callee, anchor: anchor, returnType: returnType, resultUsed: resultUsed)
			// NO file declares this callee. DEFER, and keep deferring: `SemanticCheck.validateCall` owns
			// that diagnostic (E3004, "call to undefined function") because it reads the registry the
			// REAL parse built, and this sweep is the tolerant half of the pair — see
			// `CalleeReturn.undeclared`. So the program is rejected, just not here, and `unresolved`
			// therefore never reaches codegen.
			undeclared then return self.mintValue(ValueTypeTag.unresolved, nameId: UnnamedTypeId)
		end 'callee'
	end 'mintCallResult'

	// The result of a call to a callee some file DOES declare — where the void/value split is
	// finally a split and not a sentinel.
	function mintDeclaredCallResult(callee ByteArray, anchor Token, returnType MaxonReturnType, resultUsed bool) returns ValueId throws ParseError
		match returnType 'r'
			value(inner) then return self.mintDirectCallValueResult(inner)
			void then break 'r'
		end 'r'

		// A VOID callee. In STATEMENT position that is precisely what the position is FOR — the call
		// runs for its effect — so the result value is minted with the `void` tag and never read
		// again (ValueTypeTag.void: it is write-only, and this is the only site that writes it).
		//
		// In VALUE position there is no value to give. The bootstrap says so (`E2004: Function 'noop'
		// does not return a value`), and now so does shv2, at the same anchor.
		if resultUsed 'noValueToUse'
			throw ParseError.voidCallResultUsed(String.from(callee), line: anchor.line, column: anchor.column)
		end 'noValueToUse'

		return self.mintValue(ValueTypeTag.void, nameId: UnnamedTypeId)
	end 'mintDeclaredCallResult'

	// ⭐⭐ **THE VALUE A DIRECT CALL DEFINES — AND, WHEN THE CALLEE RETURNS AN INTERFACE, THE SECOND VALUE IT
	// DEFINES TOO (P1.7a slice 2, the return ABI).** An interface-returning callee hands back a fat pointer:
	// the value half in the primary return register and the WITNESS half in the secondary one — the same
	// register a throwing callee's error flag rides, and the same two-def op (`StdOp.tryCall`) that captures
	// it. So the call defines TWO SSA values, and the second is minted HERE rather than at the Std tier for
	// two reasons the pairing column cannot work without:
	//
	//   • **THE PARSER IS THE FIRST READER.** `let p = f.make()` then `p.produce()` resolves its dispatch
	//     during THIS parse (`witnessOfValue`), and so does passing `p` to an interface parameter, and so
	//     does the scope-exit `__drop_existential`. A witness minted one tier later would arrive after every
	//     one of those had already asked for it.
	//   • **`valueWitnessIds` IS THE MEMO'S OWN ARRAY.** `LowerMaxonToStd` re-points at
	//     `IrFunction.valueWitnessIds` per function and the merged module is a SHARED memo, so a pairing
	//     written down there would mutate what every later compile reads (ARCHITECTURE.md, "the memo is
	//     shared, so nothing may be mutated in place").
	//
	// The witness id is therefore RESERVED by the parser and DEFINED by the Std tier — the one value in the
	// Maxon module with no Maxon op behind it, which is exactly what "the witness rides out of band" means:
	// it is not an operand of the `call`, it is the call's other result, and `StdOp.tryCall` is where that
	// becomes a def. It is tagged `integer` for the reason a merge phi's witness half is: it is a machine
	// address, in the GPR file, and nothing dispatches ON it.
	function mintDirectCallValueResult(inner MaxonType) returns ValueId
		let result = self.mintOwnedCallResult(inner)
		if self.tagOf(result) == ValueTypeTag.interfaceRef 'existentialReturn'
			self.pairInterfaceWitness(result, witness: self.mintValue(ValueTypeTag.integer, nameId: UnnamedTypeId))
		end 'existentialReturn'

		return result
	end 'mintDirectCallValueResult'

	// The SSA value a VALUE-returning callee defines, minted from its declared return type — and ADOPTED
	// as owned when that type is a heap box. A callee that returns a heap value moves it OUT of itself
	// (`parseReturnStatement` — the box leaves the callee's drop sets), so the CALLER becomes its sole
	// owner and must drop it once. Three return types own a droppable box, and the caller adopts each the
	// same way:
	//
	//   • a `returns String` — a fused heap record (a borrowed literal was promoted to one at the return);
	//   • a `returns Pair` — a struct box (`resolveNamedStruct` re-tags the `named` signature type to
	//     `structRef` first, so the result binds a struct and `p.first` resolves — the two-place agreement
	//     the tolerant sweep's `named` return could not make on its own);
	//   • a `returns Container` — a payload-bearing (boxed) union/enum box (`valueIsBoxedUnion`), the
	//     OPEN #44 case: a `named` result whose LAYOUT `isBoxed`, indistinguishable by tag from a bare
	//     enum value, which owns no box and is adopted by no one.
	//
	// ⚠ **THE ADOPTION ITSELF IS THE CALLER'S, NOT THIS FUNCTION'S (A5o) — see `enrolOwnedCallTemp`.** It was
	// this function's tail until A5o, which put it one step too early for the one caller that RETYPES the
	// result afterwards. The name still says `Owned` because that is what the returned value is; what moved
	// is only WHEN the obligation is written down.
	// ⭐⭐ **THE READ-DOOR REPAIR OF A TYPE THE TOLERANT SWEEP RECORDED — one composition, two askers.**
	// `resolveNamedStruct` re-tags a struct-`named` to `structRef`; `resolveFloatAliasType` then resolves a
	// float-alias `named` (`Float`) to `float` (F2a); `resolveNamedAlias` resolves a function, generic or
	// tuple alias to what it denotes. All three are needed and they compose cleanly — a type is a struct, a
	// float alias, a function alias, a generic alias, a tuple alias or a ranged int, never two — so the result
	// of a `returns Float` callee binds a `float` (XMM) value that `trunc` truncates and `return` moves
	// cleanly, rather than a `named` value the tag says is an int while the backend files it in XMM.
	//
	// ⚠ **TWO READERS OF SWEPT TYPES, AND THEY MUST REPAIR THEM ALIKE**: a call's RESULT (below) and an
	// overload candidate's PARAMETER (`sweptOverloadArgFit`). Repairing one and not the other is exactly how a
	// candidate gets scored against a tag its own argument check one pass later never sees.
	function repairSweptType(swept MaxonType) returns MaxonType
		return self.resolveNamedAlias(self.resolveFloatAliasType(self.resolveNamedStruct(swept)))
	end 'repairSweptType'

	function mintOwnedCallResult(inner MaxonType) returns ValueId
		let result = self.mintValueOfType(self.repairSweptType(inner))

		// ⭐ **THE FLOAT LIFT DROPS THE ALIAS NAME, so the alias is recorded beside the value.**
		// `MaxonType.float` has no id slot, so a `returns Float` result lands with tag `float` and no name —
		// and `let f = identity(42.0)` then `f as Float` would read as a cast from a bare `float`, missing
		// E3010. An INT alias keeps its `named` tag and its name, so it needs no entry (see
		// `ValueDeclaredAliasMap`). The test is two tag reads: only the float lift turns a `named` return
		// type into a `float` value.
		if maxonTypeTag(inner) == ValueTypeTag.named and tagIsFloat(self.tagOf(result)) 'floatAliasReturn'
			self.recordValueDeclaredAliasName(result, aliasName: self.internedName(typeNameIdOf(inner)))
		end 'floatAliasReturn'

		return result
	end 'mintOwnedCallResult'

	// ⭐⭐ **THE ONE RULE THAT SAYS A CALL'S RESULT OWES A DROP (A5o).** It ADOPTS the `+1` the callee took on
	// its way out (`emitOwnedValueReturn`): adoption is the one owned-temp door, `trackOwnedTemp`, exactly as
	// an interpolation temporary rides — `parseBinding` transfers a bound result to a scope-exit drop,
	// `drainPendingTemps` frees an unbound one after the consuming statement. A scalar / payload-free-enum /
	// void / unresolved result owns no heap and is enrolled in nothing, so a call door with nothing to
	// classify may ask unconditionally.
	//
	// ⭐⭐ **AN OPAQUE `T` RESULT IS ADOPTED TOO, AND ITS DROP IS THE DESCRIPTOR-GATED ONE (P1.7 slice
	// 3b-vi-a).** A `returns T` callee hands back a `+1` like every other managed return — it retains a borrow
	// through `retainFunc@64` on its way out (`emitOwnedValueReturn`) — so a result the receiver did NOT fix to
	// a concrete type (a `self.get()` relayed inside another shared body) still owes a release. `tagIsManaged`
	// cannot see it: `valueIsManagedHeap` tests byte-record and aggregate tags and `typeParameter` is neither,
	// which is exactly why the tag is named here. `decrefCalleeFor` routes it to `__drop_type_param`, inert on a
	// trivial instantiation whose `destroyFunc@40` is 0.
	//
	// ⛔⛔ **IT IS ASKED ONCE PER CALL DOOR, AND IT MUST BE ASKED OF THE FINAL TAG.** `valueIsManagedHeap`
	// reads the value's TAG, and an OPAQUE tag is none of `string` / `character` / `structRef` /
	// `genericInstance` / `interfaceRef` and is not `named`, so it always answers `false`. Asked while a
	// generic method's result still carried its declared `T`, it therefore enrolled nothing for a
	// `Box with Alpha` — and forced `retypeOpaqueReturnValue` to decline the substitution rather than
	// contradict a decision already taken. So the DIRECT-call door (`emitCall`) asks AFTER
	// `retypeOpaqueMethodResult`; the WITNESS door (`mintWitnessDispatchResult`) and the INDIRECT one
	// (`parseIndirectCall`) have no retype to wait for and ask as soon as the value exists.
	//
	// ⚠ **THE RE-ORDER CAN ONLY ADD ENROLMENTS, NEVER REMOVE ONE.** The retype declines unless the instance
	// fixes something the declaration left open, and the tags it can rewrite (a bare `typeParameter`, and since
	// W25 a `genericInstance`/`structRef` whose arguments the receiver settles) each answer this question at
	// least as generously afterwards as before; and the three lifts inside `mintOwnedCallResult`
	// (`resolveNamedStruct`, `resolveFloatAliasType`, `resolveNamedAlias`) each return their argument
	// unchanged unless the tag is `named`. So the retype is strictly not-managed → maybe-managed, and for
	// every non-generic call it is a no-op and this answer is bit-identical to the pre-A5o one.
	//
	// ⛔ **IT MUST ALSO RUN BEFORE THE CALL'S OWN OP IS APPENDED.** `routeBareThrowingCallToTryBlock` states
	// the invariant it depends on — *a call's own result is the last thing enrolled before the op is
	// appended* — and takes the result back off the pending list while it builds the error edge, because the
	// `tryCall` never wrote that register on a throw.
	//
	// ⚠⚠ **CO-OWNED, BECAUSE A `return` PROMOTES A BORROW BY INCREF.** `emitOwnedValueReturn` runs a borrowed
	// return value through `promoteBorrowedToOwned`, whose aggregate arm is an `__mm_incref` — so
	// `function getTy(h Holder) returns Ty return h.ty end` hands its caller a SECOND owner of the receiver's
	// field, and the callee's signature records nothing about it. `let t = getTy(h)` then matched and moved its
	// payload out nulled `h.ty`'s slot: MEASURED as a segfault. Telling a fresh-box return from a co-owning one
	// is a whole-program fact (which returns launder a borrow), the same fixpoint the transitive consume waits
	// on; until it exists a call result is a co-owner, which costs one refcount pair and never a stolen slot.
	function enrolOwnedCallTemp(result ValueId)
		if self.valueIsManagedHeap(result) or self.tagOf(result) == ValueTypeTag.typeParameter 'adoptsHeapBox'
			self.trackOwnedTemp(result, exclusivity: OwnedHeapExclusivity.coOwned)
		end 'adoptsHeapBox'
	end 'enrolOwnedCallTemp'

	// ⭐ **A CALL THROUGH A FUNCTION VALUE** (P1.5-A1) — `f(21)`, `h.op(21)`, `pick()(21)`. The cursor sits
	// on the `(`; `callee` is the SSA value holding the code pointer (a `function`-tagged value produced by
	// a functionRef, a param, a field load, or another call). Arguments are POSITIONAL: a function type's
	// parameter names are documentation only, so there is nothing to label — `f(a, b)` is two positional
	// args, which a direct call would reject (rest-labelled), so indirect calls have their own arg parser.
	function parseIndirectCall(func IrFunction, callee ValueId, resultUsed bool) returns ValueId throws ParseError
		let anchor = self.current()
		try self.consume(TokenKind.leftParen)

		var args = try self.parseIndirectCallArgs(func)

		let rparenTok = try self.consume(TokenKind.rightParen)

		// ⭐ **THE ENV TRAVELS WITH THE VALUE — UNIFORMLY (P1.5-A2b-2).** Every indirect call passes an
		// environment as the trailing arg: the callee VALUE's own env when it carries one (a capturing closure's
		// block, or a function-typed parameter's companion env), else a materialized null. The uniform ABI is
		// what lets a callee that is only known to be `function(T) returns R` — a value passed DOWN to a generic
		// `apply(f, x)` — be called without static knowledge of whether it captures. `emitClosureEnvArg` answers
		// once, keyed on the value.
		args.push(self.emitClosureEnvArg(callee, range: SourceRange.between(anchor, last: rparenTok)))

		let result = try self.mintIndirectCallResult(callee, resultUsed: resultUsed, anchor: anchor)
		// The indirect twin of `emitCall`'s enrolment, and in the same place — between the mint and the op.
		// No retype stands in between here (a function VALUE's return type is already concrete), so the
		// position is dictated only by `enrolOwnedCallTemp`'s "before the op is appended" half.
		self.enrolOwnedCallTemp(result)
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.indirectCall(result, callee: callee, args: args), range: SourceRange.between(anchor, last: rparenTok))
		return result
	end 'parseIndirectCall'

	// The POSITIONAL arguments of an indirect call — comma-separated expressions, no labels (a function
	// TYPE has no parameter names, so `indirectCall` carries no `argLabels`/`argRanges`; see MaxonDialect).
	// `parseValueExpression` (the climber plus a trailing ternary), not `parseExpression`, for
	// `parseCallArgs`' reason: an argument is parsed inside an expression that already seeded `currentBlock`.
	function parseIndirectCallArgs(func IrFunction) returns ValueIdArray throws ParseError
		var args = ValueIdArray.create()
		if self.at(TokenKind.rightParen) 'noArgs'
			return args
		end 'noArgs'

		while true 'argLoop'
			let argTok = self.current()
			let argValue = try self.parseValueExpression(func)

			// The same refusal the direct-call path makes: a capturing closure passed as an argument (here to
			// an indirect callee) has no env at the callee. Asked before the arg is appended, so the env the
			// indirect call itself later threads for a capturing CALLEE is never mistaken for one.
			try self.rejectCapturingClosureArg(argValue, tok: argTok)
			args.push(argValue)

			if not self.at(TokenKind.comma) 'endArgs'
				break
			end 'endArgs'
			try self.consume(TokenKind.comma)
		end 'argLoop'
		return args
	end 'parseIndirectCallArgs'

	// Mint the SSA value an indirect call defines, typed from the CALLEE FUNCTION VALUE's return type —
	// the mirror of `mintDeclaredCallResult` for a direct call. Here the return type is recovered from the
	// callee value's OWN function type (its governing name), and the value-returning tail
	// (`mintOwnedCallResult`) is shared, so an indirect call binds its result exactly as a direct one does.
	//
	// ⭐ A VOID FUNCTION VALUE IS REJECTED AT THE CALL WHEN ITS RESULT IS USED, exactly as a void DIRECT
	// call is (`resultUsed`, mirroring `mintDeclaredCallResult`). This UPHOLDS the invariant that
	// `maxonTypeOfTag`/`valueTagToStdType` assert — a `void` value is minted ONLY as a discarded statement
	// result, NEVER in a position that reads it. Without the guard, `let cb = doIt; let x = cb()` minted a
	// void value that reached `typeOf` and PANICKED, where the void DIRECT call `let x = doIt()` cleanly
	// reports E2004. Statement position (`resultUsed: false`, the point of #68) still mints the discarded
	// void value; every value position (`resultUsed: true` — a binding, `return`, an operand, an argument)
	// reports E2004 HERE, at the call, the same anchor and text the direct-call diagnostic uses.
	function mintIndirectCallResult(callee ValueId, resultUsed bool, anchor Token) returns ValueId throws ParseError
		match self.functionValueReturnType(callee) 'r'
			value(inner) then return self.mintOwnedCallResult(inner)
			void then break 'r'
		end 'r'

		// A VOID function value used where a value belongs. Reported with the callee's governing function
		// name (`functionValueReturnType` proved it resolvable to reach the `void` arm), the E2004 spelling
		// `mintDeclaredCallResult` renders for a void direct call.
		if resultUsed 'noValueToUse'
			throw ParseError.voidCallResultUsed(String.from(self.internedName(self.valueNameId(callee))), line: anchor.line, column: anchor.column)
		end 'noValueToUse'

		return self.mintValue(ValueTypeTag.void, nameId: UnnamedTypeId)
	end 'mintIndirectCallResult'

	// The RETURN type of a function VALUE, recovered from its governing name (see MaxonType's `function`
	// arm): a function-TYPEALIAS value reads its return from the function-alias registry; a functionRef
	// value's governing name IS a function, so its return is `returnTypeOf`. The two are disjoint — a name
	// is a function alias or a function, never both — so trying the alias first and the function second is
	// unambiguous.
	function functionValueReturnType(callee ValueId) returns MaxonReturnType
		let name = self.internedName(self.valueNameId(callee))

		// ⭐ **A LIFTED CLOSURE first (P1.5-A2a).** Its return type is FILE-LOCAL — the whole-program index
		// never saw it (see `closureReturns`) — so an indirect call through a closure bound to a local
		// (`let f = function(x) gives x*2; f(8)`) recovers it from here. Its `$`-suffixed name is unwritable
		// in source, so this can shadow no real function or alias; a non-closure name misses and falls
		// through to the two whole-program lookups below.
		if let closureReturn = try self.closureReturns.get(name) 'closure'
			return closureReturn
		end 'closure'

		match self.signatures.functionAliasOf(name) 'alias'
			declared(alias) then return self.functionAliasReturnType(alias)
			undeclared then break 'alias'
		end 'alias'

		match self.signatures.returnTypeOf(name, into: self.artifact.typeNames) 'fn'
			declared(returnType) then return returnType
			undeclared then panic("functionValueReturnType: a `function`-tagged value's governing name '{String.from(name)}' is neither a lifted closure, a function alias, nor a declared function — every function value is minted from one of the three (parseClosureExpression / parseTypeReference / emitFunctionRef)")
		end 'fn'
	end 'functionValueReturnType'

	// Reconstruct a function alias's declared return type from its interner-free (tag, name) storage (see
	// FunctionTypeAlias), re-interning the name into THIS file's interner. `void` means the function
	// returns nothing; a primitive return carries no name; a `named`/`structRef`/function return carries
	// the name it re-interns from.
	//
	// ⭐ The rebuild itself is `maxonTypeOfStoredTypeName` — shared with `TypeResolution`'s twin, which does
	// the same job against the PROJECT's merged interner — so this function supplies only the interner. That
	// is what recovers `ExitCode`'s u32 width from the stored NAME rather than dropping it to a `named` i64;
	// see `builtinTypeNameTag` for the wasm trap the third spelling of that rule used to cost (W1).
	function functionAliasReturnType(alias FunctionTypeAlias) returns MaxonReturnType
		if alias.returnTag == ValueTypeTag.void 'voidReturn'
			return MaxonReturnType.void
		end 'voidReturn'

		let nameId = UnnamedTypeId if alias.returnTypeName.isEmpty() else self.artifact.typeNames.intern(alias.returnTypeName)
		return MaxonReturnType.value(maxonTypeOfStoredTypeName(alias.returnTag, name: alias.returnTypeName, nameId: nameId, typeParamToken: alias.returnTypeParamToken))
	end 'functionAliasReturnType'

	// Parse an integer literal token into a `literal` op, and return the value it defines.
	// The token's text becomes a number through the shared `intLiteralValue`, so a literal
	// in an expression and a literal in a range bound are read the same way.
	function parseIntLiteral() returns ValueId throws ParseError
		let tok = try self.consume(TokenKind.intLiteral)
		let value = try self.intLiteralValue(tok, negated: false)
		return self.emitLiteral(value, valueType: MaxonType.integer, range: SourceRange.ofToken(tok))
	end 'parseIntLiteral'

	// Parse a FLOAT literal token into a `literal` op, and return the value it defines.
	//
	// ⭐ **THE LITERAL'S VALUE IS ITS IEEE-754 BIT PATTERN**, carried in the very same `ParsedInt`
	// payload an integer literal uses — and that is why a float costs NO new op at either tier.
	// `MaxonOp.literal` and `StdOp.const` already carry a `valueType` beside the bits, and the
	// type is what says how to READ them; 64 bits are 64 bits. v1 mints a second literal op
	// (`constF64`) and pays for it in every pass that has to match one.
	//
	// ⚠ **THESE BITS ARE RECORDED AS A PARSER CONSTANT SINCE A1 — IN THE FLOAT DOMAIN, NEVER THE INTEGER
	// ONE**, which is what keeps the danger this comment used to describe from returning rather than merely
	// unwritten. A float in the INTEGER fold columns would let `foldIntBinOp` ADD TWO IEEE PATTERNS AS
	// INTEGERS: `3.14 + 2.0` would fold to a number that is neither 5.14 nor anything else, silently, at
	// compile time. `ConstPayloadDomain` stamps the domain beside the payload and `constIsKnown` answers only
	// for `integer`, so the integer folder cannot reach a float pattern at all. The ONE reader of the float
	// half is the divisor proof (`divisorProof`), which needs to see `let zero = 0.0`.
	function parseFloatLiteral() returns ValueId throws ParseError
		let tok = try self.consume(TokenKind.floatLiteral)
		let bits = try self.floatLiteralBits(tok)
		return self.emitLiteral(bits, valueType: MaxonType.float, range: SourceRange.ofToken(tok))
	end 'parseFloatLiteral'

	// `-<numeric literal>` as ONE literal — see `parseUnary`'s note for why the negation belongs to
	// the literal rather than to an operator over it. Both halves read through the SAME decoders the
	// un-negated forms use (`intLiteralValue` with `negated: true`, `negatedFloatBits` over
	// `floatLiteralBits`), which is what makes a negated literal in an expression mean exactly what
	// the same text means in a range bound or a field default. The source range anchors on the `-`,
	// because that is where the literal now starts.
	function parseNegatedNumericLiteral(minusTok Token) returns ValueId throws ParseError
		if self.at(TokenKind.floatLiteral) 'float'
			let tok = try self.consume(TokenKind.floatLiteral)
			return self.emitLiteral(negatedFloatBits(try self.floatLiteralBits(tok)), valueType: MaxonType.float, range: SourceRange.ofToken(minusTok))
		end 'float'

		let tok = try self.consume(TokenKind.intLiteral)
		return self.emitLiteral(try self.intLiteralValue(tok, negated: true), valueType: MaxonType.integer, range: SourceRange.ofToken(minusTok))
	end 'parseNegatedNumericLiteral'

	// Append a `literal` op into the CURRENT block; return the ValueId it defines.
	function emitLiteral(value ParsedInt, valueType MaxonType, range SourceRange) returns ValueId
		return self.emitLiteralIn(self.currentBlock, value: value, valueType: valueType, range: range)
	end 'emitLiteral'

	// Append a `literal` op into a NAMED block. The short-circuit lowering needs this: its
	// seed literal belongs in the ENTRY block, which by the time the phi is wired is no
	// longer the current one.
	function emitLiteralIn(block IrBlock, value ParsedInt, valueType MaxonType, range SourceRange) returns ValueId
		let result = self.mintValueOfType(valueType)
		self.artifact.emitOp(block, op: MaxonOp.literal(result, value: value, valueType: valueType), range: range)

		// THE root of the parser's constant view. A `let` binds its NAME to the value the
		// initializer produced, so `let SHIFT = -1` binds `SHIFT` to this very id — which is why
		// folding a literal is all it takes to see a count named through a `let`, and — since A1 —
		// a zero divisor named through one (`let zero = 0.0` then `x / zero`).
		//
		// ⭐ **THE TWO DOMAINS ARE RECORDED SEPARATELY, WHICH IS THE OPPOSITE OF RECORDING THEM
		// TOGETHER.** The old single `tagIsInteger` gate held the float half OUT of the columns, and
		// its comment named the exact danger: a float in the fold columns would let `foldIntBinOp` add
		// two IEEE patterns as integers. That danger is gone rather than tolerated — a float's slot is
		// stamped `float`, `constIsKnown` answers only for `integer`, and `foldIntBinOp` is reachable
		// only through it. See `ConstPayloadDomain`.
		//
		// ⭐ **A `bool` LITERAL IS RECORDED TOO, IN THE INTEGER DOMAIN, AND IT IS THE SAME FACT RATHER THAN A
		// WIDENING OF ONE.** `true`/`false` materialize as `BoolTrueValue`/`BoolFalseValue` — 1 and 0 — and the
		// file already relies on that identity ("the BITWISE fold of two bools is already the LOGICAL answer",
		// `foldIntBinOp`'s note). What the exclusion cost was measurable: a CONSTANT `[true, false, true,
		// false]` could not be recognised as constant at all, so `bool-bit-packing`'s constant literal could
		// not become the packed `.rdata` blob its spec pins, purely because the parser declined to write down a
		// value it had in hand. The FLOAT split is untouched and is the one this gate was built for — an IEEE
		// pattern must never reach `foldIntBinOp`.
		let tag = maxonTypeTag(valueType)
		if tagIsInteger(tag) or tagIsBool(tag) 'integerDomain'
			self.recordConst(result, folded: value)
		end 'integerDomain' else if tagIsFloat(tag) 'float'
			self.recordFloatConst(result, bits: value)
		end 'float'

		return result
	end 'emitLiteralIn'

	// --- token cursor ---

	// The token at an ABSOLUTE index, or a synthetic EOF once past the end. THE one place the
	// past-the-end rule is written down — `current`, `at`, `kindAt` and `peekKind` are all views
	// over this, so a cursor read and a scan read can never disagree about where the tokens stop.
	// The lexer already appends a real EOF, so the synthetic one is a belt-and-suspenders guard.
	function tokenAt(index TokenIndex) returns Token
		if index >= self.tokens.count() 'pastEnd'
			return Token.eof()
		end 'pastEnd'

		return try self.tokens.get(index) otherwise panic("Parser.tokenAt: index<count just checked but tokens.get({index}) failed")
	end 'tokenAt'

	// The token at the cursor.
	function current() returns Token
		return self.tokenAt(self.pos)
	end 'current'

	function at(kind TokenKind) returns bool
		return self.current().kind == kind
	end 'at'

	// The kind of the token at an ABSOLUTE index. The cursor-independent read the token-extent
	// scans need — `blockStatementEndIndex`, `assignedBindingsIn` and `opensBlockAt` all walk the
	// token array without moving `pos`.
	function kindAt(index TokenIndex) returns TokenKind
		return self.tokenAt(index).kind
	end 'kindAt'

	// **WHERE A STATEMENT STOPS, ASKED AT AN ABSOLUTE INDEX** — the `newline` that separates it from the
	// next one, the `end` that closes the enclosing block when it is that block's last statement, or EOF.
	// Comments are not tokens (the lexer drops them), so a trailing `// …` does not have to be listed here.
	//
	// ONE predicate because three readers ask it and a divergence between them is a WRONG DIAGNOSTIC
	// rather than a crash: `atEnumFunctionRawValue` decides that a name IS the whole raw value,
	// `parseReturnStatement` decides that a `return` is BARE, and `rejectDegenerateAssignment` decides
	// that a chain IS the whole right-hand side. Written out three times — which it was — a fourth
	// terminator taught to one reader leaves the other two reading a complete statement as an unfinished
	// one, each with its own unrelated-looking error.
	//
	// ⛔ **`requireSignatureLineEnd` IS NOT A FOURTH READER AND MUST NOT BE "FINISHED" INTO ONE.** It asks
	// `newline or eof` deliberately, WITHOUT `end`: it guards a DECLARATION HEADER, and a header line can
	// never legitimately be closed by the token that closes the body it introduces. Routed through here it
	// would accept `function f() end` — a signature with no newline after it — as a complete header.
	function statementEndsAt(index TokenIndex) returns bool
		let kind = self.kindAt(index)
		return kind == TokenKind.newline or kind == TokenKind.end or kind == TokenKind.eof
	end 'statementEndsAt'

	// The IDENTIFIER text at an ABSOLUTE index, or the empty source text when that token is anything else
	// (a malformed header, or past the end). The tolerant read a SWEEP needs: it must not throw, because a
	// declaration it cannot read is the real parse's to report with a position.
	function identifierNameAt(index TokenIndex) returns ByteArray
		let tok = self.tokenAt(index)
		if tok.kind != TokenKind.identifier 'notAName'
			return EmptySourceText
		end 'notAName'

		return tok.value
	end 'identifierNameAt'

	// **THE token shape of a reassignment, asked at an ABSOLUTE index — and there is exactly ONE
	// of these on purpose.** Two callers ask it and they must never disagree:
	//
	//   • `parseStatement`, deciding that this statement IS a reassignment, and
	//   • `assignedBindingsIn`, deciding which vars a loop CARRIES A PHI FOR.
	//
	// Written down twice, a new write form (a compound assignment, a store through a field) taught
	// to the dispatcher and not to the scan would compile: the statement would assign the var, the
	// loop would mint no phi for it, and the var would reset to its pre-loop value on every
	// iteration. A SILENT MISCOMPILE — and, unlike a `blockStatementEndIndex` mismatch, one no drift
	// guard can see, because the loop's EXTENT would still be perfectly correct. Teaching this one
	// predicate teaches both.
	//
	// ⚠ AND IT IS NOT ENOUGH TO MAKE THE NEW FORM MERELY *MATCH* — IT MUST NAME THE RIGHT VAR.
	// `a.b = x` already fits `identifier equals`, at `b`. So a field store taught to THIS predicate
	// would silently start inserting **`b`**, the FIELD, and never `a`, the var that carries the
	// loop value. The phi would be minted for a name nothing writes and withheld from the one that
	// does.
	//
	// ⭐ **THAT IS WHY FIELD STORES HAVE THEIR OWN PREDICATE — `fieldAssignsAt` — AND WHY THIS ONE
	// WAS NOT WIDENED** (P1.1a wave 2). `parseStatement` routes on both; `assignedBindingsIn` reads
	// only this one, and that is CORRECT rather than an omission: **a field store assigns no
	// binding.** `p` is a box pointer that `p.x = 5` never reassigns — the write goes to MEMORY,
	// through `storeIndirect`, and the box's address is the same value afterwards. So there is no
	// loop-carried value to merge and no phi to mint.
	//
	// ⚠ `c.value = c.value + 1` DOES make this scan insert `value`, at the field token, and it is
	// harmless — but **for the over-approximation note's SHADOWING reason, not its "selects nothing"
	// one**, and the difference is worth stating because only one of the two survives a local of the
	// same name. With no local called `value`, the name binds nothing at the header and selects
	// nothing. With `var value` ALSO in scope it DOES select, and a header phi IS minted for a var
	// the loop never writes. That phi CARRIES NOTHING — every incoming value is the same one,
	// precisely because nothing assigns it — which is the shape `elimTrivialBlockArgs` exists to fold
	// away (see PassPipeline). MEASURED rather than argued: that program returns 102, the right
	// answer.
	//
	// ⚠ A write with NO `=` ANYWHERE cannot be covered by either half of the above, because it is
	// not a statement to teach the dispatcher about: a `var` PARAMETER is written by `mutate(p)`
	// at the call site. `ParametersAreMutable` is the tripwire for that one — see `assignedBindingsIn`.
	function assignsAt(index TokenIndex) returns bool
		return self.kindAt(index) == TokenKind.identifier and self.kindAt(index + 1) == TokenKind.equals
	end 'assignsAt'

	// ⭐⭐ **`( <target> , … ) =` — THE ONE READER OF A TUPLE ASSIGNMENT'S TARGET-LIST SHAPE**
	// (`specs/tuple-assign.md`). Returns the index of the `=` that closes the list, or `index` itself when
	// the tokens at `index` are not one — the same "the answer IS the start index when there is nothing
	// here" convention `fieldChainEndAfter` uses, and unambiguous because a real answer is always at least
	// three tokens further on.
	//
	// The shape is exactly: `(` TARGET (`,` TARGET)* `)` `=`, where a TARGET is an optional `let`/`var`
	// qualifier followed by one identifier. Nothing else — no expression, no call, no index — which is what
	// makes the admission decidable from tokens alone, before a single op is emitted.
	//
	// ⭐ **THERE IS NO AMBIGUITY TO RESOLVE HERE, AND THAT IS A MEASURED FACT RATHER THAN A HOPE.** shv2
	// admits NO statement that opens with `(` — a parenthesised-expression statement, `(a + b).m()`
	// included, dies in `parseStatement`'s `strayStatementToken` arm as `E2001: unexpected token: '('`. So
	// this predicate can only ever turn an E2001 into a program; every `(`-opening statement it declines
	// keeps the exact sentence it has today. Should a parenthesised-expression statement ever become legal,
	// THIS is the predicate that decides between them, and it is one predicate rather than a rule
	// re-derived at each door — see the second caller.
	//
	// ⚠ **A ONE-NAME LIST IS ADMITTED ON PURPOSE, where `parseDestructuringNames` refuses one outright.**
	// `(x) = makePair(…)` must reach the ARITY diagnostic the spec pins
	// (`tuple-assign/tuple-assign-error-count-mismatch`, E3005 naming both counts), which a syntactic
	// refusal would pre-empt with a sentence about names rather than about the tuple.
	//
	// ⚠ **IT IS BOUNDED BY THE TOKEN ARRAY, NOT BY AN ARITY LIMIT.** `tokenAt` hands back a synthetic EOF
	// past the end, whose kind is neither an identifier nor a comma, so a malformed source falls out of the
	// walk at the first token that does not fit rather than running off. v1 caps its probe at 256 tokens
	// (`Parser.maxon:10510`); shv2 needs no cap because the EOF is the cap.
	//
	// ⚠ **THE "NOTHING HERE" ANSWER IS THE START INDEX, WHERE `DiscardedCallee` IN THIS SAME COMMIT MINTS A
	// UNION RATHER THAN LET AN EMPTY `ByteArray` MEAN NONE — and the two rulings are not in tension.** An
	// empty `ByteArray` is a perfectly good callee KEY, so there "none" and a real answer are indistinguishable
	// to every reader downstream. Here they are not: a real answer is the index of an `=` at least three
	// tokens past the `(`, so `== index` is a value the successful case can never take. Copy the union when
	// the "none" value is one the domain admits; copy this when it is not.
	//
	// ⛔⛔ **A `(` DIRECTLY AFTER `let`/`var` OPENS THE DECLARING DESTRUCTURE AND IS REFUSED HERE, AT THE ONE
	// READER.** `let (x, y) = t` and `(x, y) = f()` are the SAME token run from the `(` onwards — this walk
	// cannot tell them apart looking forward, and `tupleAssignTargetAt` cannot either, because it reads the
	// token before each NAME and in the declaring form the keyword sits before the PAREN, so every name there
	// classified as a REBIND. The loop-phi scan then carried both names of a `let (x, y) = t`: the
	// documented-safe direction (a surplus carried binding costs a phi, never an answer), but a phi that
	// header calls codegen-visible, minted for names the loop cannot be carrying at all.
	//
	// It is refused HERE rather than at the scan because it is a fact about the GRAMMAR — that `(` belongs to
	// another construct — and a guard at one call site is the rule the next caller forgets. `parseStatement`
	// is unaffected: it reaches this at a statement's first token, where the predecessor is a newline, and a
	// `let`/`var` there was consumed by its own arm two branches earlier.
	function tupleAssignEqualsAt(index TokenIndex) returns TokenIndex
		if self.kindAt(index) != TokenKind.leftParen 'notATargetList'
			return index
		end 'notATargetList'

		if index > 0 and (self.kindAt(index - 1) == TokenKind.let or self.kindAt(index - 1) == TokenKind.var) 'opensADeclaringDestructure'
			return index
		end 'opensADeclaringDestructure'

		var i = (index + 1) as TokenIndex
		while i < self.tokens.count() 'eachTarget'
			if self.kindAt(i) == TokenKind.let or self.kindAt(i) == TokenKind.var 'declaresANewBinding'
				i = (i + 1) as TokenIndex
			end 'declaresANewBinding'

			if self.kindAt(i) != TokenKind.identifier 'notATarget'
				return index
			end 'notATarget'
			i = (i + 1) as TokenIndex

			if self.kindAt(i) == TokenKind.rightParen 'endOfList'
				return (i + 1) as TokenIndex if self.kindAt(i + 1) == TokenKind.equals else index
			end 'endOfList'

			if self.kindAt(i) != TokenKind.comma 'notASeparator'
				return index
			end 'notASeparator'
			i = (i + 1) as TokenIndex
		end 'eachTarget'

		// Ran off the end of the token array without ever meeting a `)` — a truncated source, which is no
		// target list. The bound is the array's own length rather than an arity cap for the reason the
		// header gives: past the end every read is a synthetic EOF, so the walk above would decline it on
		// the very next token anyway, and this is the belt to that suspenders.
		return index
	end 'tupleAssignEqualsAt'

	// ⭐ **WHAT ONE ELEMENT OF A CONFIRMED TARGET LIST IS**, read off the identifier at `nameIndex` and the
	// token before it. THE one classifier, so the loop-phi token scan and the parse cannot come to disagree
	// about which elements are WRITES to a binding already in scope — a disagreement in that direction is
	// not a missed diagnostic but a loop that recomputes from its entry value every trip
	// (`assignedBindingsIn`'s "under-approximating would drop a real phi").
	//
	// Precondition: `nameIndex` is an identifier inside a list `tupleAssignEqualsAt` has already accepted AS A
	// TUPLE ASSIGNMENT, so the token before it is the qualifier or a separator and nothing else. That
	// predicate now refuses the DECLARING form outright, which is what makes the precondition true rather than
	// merely intended — before it did, every name of a `let (x, y) = t` classified as a REBIND here, because
	// the keyword sits before the PAREN and never before a name.
	//
	// ⚠ **THE QUALIFIER IS TESTED BEFORE THE DISCARD NAME, so `(let _, y) = f()` DECLARES a binding called
	// `_` and pays a field read where `(_, y)` does neither.** That is the opposite order from `parseAssignment`
	// and the `for` pattern, and it is deliberate: it makes this form agree with `let (a, _) = t`, where the
	// declaring pattern also declares `_` (`parseDestructuringNames` runs every name through
	// `declareInitializedBinding`). One spelling of "declare a name I will not read", answering the same way
	// in both destructuring forms, beats agreeing with the doors that have no declarator to test.
	function tupleAssignTargetAt(nameIndex TokenIndex) returns TupleAssignTarget
		let qualifier = self.kindAt(nameIndex - 1)
		if qualifier == TokenKind.let 'declaresALet'
			return TupleAssignTarget.declares(false)
		end 'declaresALet'

		if qualifier == TokenKind.var 'declaresAVar'
			return TupleAssignTarget.declares(true)
		end 'declaresAVar'

		if self.tokenAt(nameIndex).value.equals(DiscardBindingName) 'discards'
			return TupleAssignTarget.discards
		end 'discards'

		return TupleAssignTarget.rebinds
	end 'tupleAssignTargetAt'

	// ⭐⭐ **`assignsAt` PLUS THE ONE QUALIFIER A *REBIND* NEEDS AND A LOOP PHI DOES NOT (PBR-2): a name
	// preceded by `.` is a FIELD, not a binding.** `hh.op = op` writes a field OF `hh` and rebinds nothing
	// called `op` — but the token `op` is followed by `=`, so the bare textual test answers yes.
	//
	// ⚠ **MEASURED, and it was not merely wasteful.** `first-class-function.capturing-closure-name-not-leaked`
	// declares `storeIt(h Handler, op UnaryOp)` whose body is `hh.op = op`: the field name and the PARAMETER
	// name coincide, so the seed marked `op` reassigned. That opened the program-wide gate, made `op`
	// by-reference, and put a cell under a parameter nothing ever writes — correct output, moved codegen, and
	// a golden that drifted for no reason a reader could find.
	//
	// ⚠ **IT IS NOT FOLDED INTO `assignsAt`, BECAUSE THAT PREDICATE ANSWERS A DIFFERENT QUESTION.** The
	// loop-phi scan asks "does this token sequence look like a write to a carried name", where a false
	// positive costs a phi that `ElimTrivialBlockArgs` folds away; this asks "does this body REBIND its own
	// parameter", where a false positive costs an ABI. Same tokens, different tolerance — so the shared half
	// stays shared and the qualifier lives with the stricter reader.
	function rebindsANameAt(index TokenIndex) returns bool
		if not self.assignsAt(index) 'notAnAssignmentAtAll'
			return false
		end 'notAnAssignmentAtAll'

		return index == 0 or self.kindAt(index - 1) != TokenKind.dot
	end 'rebindsANameAt'

	// ⭐⭐ **THE SAME QUESTION `rebindsANameAt` ANSWERS, ASKED OF THE ONE WRITE FORM WHOSE TARGET CARRIES NO
	// `=`.** `(x, _) = pair(x)` writes `x`; the token after `x` is a comma, so the `identifier =` shape cannot
	// see it. THREE readers decide "does this statement write this name" and the loop-phi scan was the only
	// one taught when tuple assignment landed — leaving the other two answering by SPELLING: `x = f()` on a
	// by-reference parameter compiled and `(x, _) = f()` was E2013, one operation with two answers.
	//
	// ⭐ **THE ENCLOSING `(` COSTS NOTHING TO FIND, because both callers already track it.** They walk forward
	// keeping `openBrackets` (`trackBracketAt`, called before the name test in both), so the innermost opener
	// is an O(1) read — the same one `bareCallArgumentAt` takes. No backward scan, and no second grammar: this
	// only LOCATES a candidate `(`, and `tupleAssignEqualsAt` decides whether it opens a target list. A `(`
	// that opens a call, a group, a `{` on the stack, or a DECLARING destructure is declined there.
	//
	// ⚠ **ZERO BLAST RADIUS ON EXISTING PROGRAMS, and that is checkable rather than hoped:** it can only fire
	// for a name that is BOTH a by-reference parameter (or a closure-captured local) AND a tuple-assignment
	// target, and no program in this tree could contain a tuple assignment at all before this port — every one
	// of them was `E2001: unexpected token: '('`.
	function tupleAssignRebindsANameAt(index TokenIndex, openBrackets TokenIndexArray) returns bool
		if self.kindAt(index) != TokenKind.identifier or openBrackets.count() == 0 'notANameInsideAnOpenBracket'
			return false
		end 'notANameInsideAnOpenBracket'

		// A bare target is always followed by the `,` or `)` of its list. One token, and it keeps an ordinary
		// argument list from paying the forward walk below on every name it holds.
		if self.kindAt(index + 1) != TokenKind.comma and self.kindAt(index + 1) != TokenKind.rightParen 'notInAList'
			return false
		end 'notInAList'

		let opener = try openBrackets.get(openBrackets.count() - 1) otherwise panic("tupleAssignRebindsANameAt: openBrackets is empty though its count was just read as non-zero")
		return index < self.tupleAssignEqualsAt(opener) and tupleAssignTargetRebinds(self.tupleAssignTargetAt(index))
	end 'tupleAssignRebindsANameAt'

	// ⭐ **THE BRACKET BOOKKEEPING BOTH PEEK-ONLY BODY WALKS KEEP** — `scanBodyFacts` (the sweep's, over a
	// whole declaration) and `collectCellLocalNames` (the parse's, over one body, ONCE — never over one
	// binding's remaining scope, which is the Θ(vars × tokens) shape that header rejects by name). They ask
	// different questions and need the identical state, and a second copy of a push/pop pair is a second chance
	// for the two columns to fall out of lockstep — at which point `openBrackets`' top names the wrong call and
	// a forwarding edge is recorded against a function that never saw the argument.
	//
	// `openBrackets` carries the TOKEN INDEX of each open `(` or `{`, which is what makes "which call is this
	// argument in?" an O(1) read of the top rather than a backwards walk. ⚠ A `[` is NOT tracked by either
	// walk — an index expression opens no call and holds no struct literal — so a future subscript rule must
	// teach `trackBracketAt` before relying on the stack's depth to describe one.
	//
	// ⭐ **IT HOLDS THE INDEX AND NOT THE CALLEE NAME, AND THAT IS BOTH CHEAPER AND MORE HONEST.** An index is
	// a scalar push where a name was a `ByteArray` one, and it is pushed for every `(` and `{` in every body
	// — while the two things a reader actually wants (`calleeNameOpeningAt`, `forwardCallOpeningAt`) are needed
	// only at a real forwarding candidate, which is rare. It also lets those readers see the bracket's own KIND
	// rather than trusting the pusher to have blanked a `{`, so "a struct literal opens no call" is checked
	// where it is spent instead of maintained across a column.
	function trackBracketAt(index TokenIndex, braceStack BoolArray, openBrackets TokenIndexArray)
		let kind = self.kindAt(index)
		if kind == TokenKind.leftBrace or kind == TokenKind.leftParen 'open'
			braceStack.push(kind == TokenKind.leftBrace)
			openBrackets.push(index)
		end 'open'

		if (kind == TokenKind.rightBrace or kind == TokenKind.rightParen) and braceStack.count() > 0 'close'
			_ = try braceStack.pop() otherwise panic("trackBracketAt: braceStack.pop on non-empty stack failed")
			_ = try openBrackets.pop() otherwise panic("trackBracketAt: openBrackets.pop failed — it is pushed and popped in lockstep with braceStack")
		end 'close'
	end 'trackBracketAt'

	// The BLOCK-DEPTH bookkeeping those same two walks keep, for `trackBracketAt`'s reason. Depth 0 is the walk's
	// own starting level, so a `closesBlockAt` there is the walk's terminator and is left for the caller to see.
	function blockDepthAfter(index TokenIndex, depth BlockDepth) returns BlockDepth
		if self.opensBlockAt(index) 'opensBlock'
			return depth + 1
		end 'opensBlock'

		if depth > 0 and self.closesBlockAt(index) 'closesBlock'
			return depth - 1
		end 'closesBlock'

		return depth
	end 'blockDepthAfter'

	// ⭐⭐ **WHICH OF THIS BODY'S LOCAL NAMES HAVE TO LIVE IN A CELL (PBR-2)?** — the caller-side half of the
	// decision the sweep makes for parameters, and it has to be made before the body is parsed, because a cell
	// has to dominate every read of the name it holds.
	//
	// TWO reasons, and they are independent — a program can need either without the other:
	//
	//   • the name is handed to a call that takes that argument BY REFERENCE, so the callee's write must land
	//     in this frame;
	//   • the name is CAPTURED by a closure AND assigned, so the closure must see the assignment. Capture is
	//     by value (`emitCaptureRead`), and a captured cell's env slot holds the POINTER — which is what makes
	//     `pass-by-reference.closure-capture-after-mutation` return 99 instead of the 10 it returned before.
	//
	// ⚠⚠ **ONE WALK PER BODY, NOT ONE PER DECLARATION, AND THAT IS A SCALING RULE RATHER THAN A TIDY-UP.**
	// Asked at each `var` over the rest of its scope this is Θ(vars × tokens) — the exact shape
	// `Parse Θ(vars × constructs)` was found and closed as, and it bends in CPU while reading FLAT in
	// allocations, so the memory column could not have caught it. The names are collected once, here, and every
	// declaration below is a set membership test.
	//
	// ⚠ **IT IS A TOKEN SCAN AND SO OVER-APPROXIMATES, IN THE ONE DIRECTION THAT IS SAFE.** A name inside a
	// grouping paren reads as an argument; a name mentioned anywhere after a `function` token reads as
	// captured; a callee is matched by its BARE name, so every `reassign` in the program answers for every
	// other; and the set is keyed by NAME, so an inner block's shadowing `var` of the same name is promoted
	// with it. Each costs a cell that was not needed — an allocation and a load per read — and none can produce
	// a wrong answer, because a cell is a legal home for any value and only the CALLEE's own ABI decides
	// whether an argument is read as an address.
	//
	// ⚡ **THE GATE IS WHY NO EXISTING PROGRAM PAYS FOR THIS.** Parameter reassignment was E2013 before this
	// rung, so `programTakesAParamByRef` is false for every corpus program and every `stdlib` compile; the
	// closure half then costs one linear walk per body, and only in a FILE that spells a closure literal at
	// all. A body that reaches neither test is answered before a token is read.
	function collectCellLocalNames(bodyStart TokenIndex)
		self.cellLocalNames = sharedEmptyCellLocalNames
		if not self.signatures.programTakesAParamByRef() and not self.fileHasClosureLiteral 'nothingCouldWantACell'
			return
		end 'nothingCouldWantACell'

		var handedOverByReference = CellLocalNameSet.create()
		var assigned = CellLocalNameSet.create()
		var mentionedInsideAClosure = CellLocalNameSet.create()
		// ⭐⭐ **THE CLOSURE BODY IS BOUNDED, AND A LOOSER RULE WAS A MEASURED REGRESSION.** "Mentioned anywhere
		// after a `function` token" reads the name that HOLDS a closure as one the closure CAPTURES:
		// `var f = function(n) gives n + bump` … `return f(2)` promoted `f` itself, which turned
		// `first-class-function.capturing-closure-across-if-merge-errors` from the merge refusal it pins into
		// the generic escaping-store one (the cell's `storeIndirect` reaches that backstop first). Two cases,
		// both E3099, both wrong.
		//
		// So the body is delimited: it opens at the `gives` of a `function (` header and closes at the first
		// statement end, or as soon as the bracket depth falls below the one it opened at — which is what ends
		// `apply(function() gives x)` at its `)`. Over-approximate still (a nested closure just re-opens it),
		// and now over-approximate in a direction that costs a cell rather than a diagnostic.
		var sawClosureHeader = false
		var insideAClosureBody = false
		var closureBodyDepth = 0 as ElementCount
		var braceStack = BoolArray.create()
		var openBrackets = TokenIndexArray.create()
		var blockDepth = 0 as BlockDepth

		var q = bodyStart
		while self.kindAt(q) != TokenKind.eof 'walk'
			if blockDepth == 0 and self.closesBlockAt(q) 'bodyEnds'
				break
			end 'bodyEnds'

			self.trackBracketAt(q, braceStack: braceStack, openBrackets: openBrackets)

			// A closure LITERAL, not a declaration: `function` followed by `(` (a declaration puts its name
			// between the two). The same test `scanForClosureLiterals` gates the whole walk on.
			if self.kindAt(q) == TokenKind.function and self.kindAt(q + 1) == TokenKind.leftParen 'aClosureHeader'
				sawClosureHeader = true
			end 'aClosureHeader'

			if sawClosureHeader and self.kindAt(q) == TokenKind.gives 'closureBodyOpens'
				sawClosureHeader = false
				insideAClosureBody = true
				closureBodyDepth = braceStack.count()
			end 'closureBodyOpens'

			if insideAClosureBody and (self.kindAt(q) == TokenKind.newline or braceStack.count() < closureBodyDepth) 'closureBodyCloses'
				insideAClosureBody = false
			end 'closureBodyCloses'

			if tokenCanBeAName(self.tokenAt(q)) 'aName'
				let name = self.tokenAt(q).value
				if insideAClosureBody 'capturedByThatClosure'
					mentionedInsideAClosure.insert(name)
				end 'capturedByThatClosure'

				// The tuple-assignment spelling of the same write, for `scanBodyFacts`' reason one door
				// over: a captured local written ONLY by `(x, _) = f()` would otherwise not be `assigned`, so
				// the closure below would capture it by value and never see the write.
				if self.rebindsANameAt(q) or self.tupleAssignRebindsANameAt(q, openBrackets: openBrackets) 'reassigned'
					assigned.insert(name)
				end 'reassigned'

				if self.bareCallArgumentAt(q, braceStack: braceStack) and self.signatures.bareNameTakesAParamByRef(self.calleeNameOpeningAt(try openBrackets.get(openBrackets.count() - 1) otherwise panic("collectCellLocalNames: openBrackets is empty inside a call argument — `bareCallArgumentAt` has just established an open `(`"))) 'handedToAByRefPosition'
					handedOverByReference.insert(name)
				end 'handedToAByRefPosition'
			end 'aName'

			blockDepth = self.blockDepthAfter(q, depth: blockDepth)
			q = q + 1
		end 'walk'

		self.cellLocalNames = handedOverByReference
		for name in mentionedInsideAClosure 'eachCapture'
			if assigned.contains(name) 'capturedAndWritten'
				self.cellLocalNames.insert(name)
			end 'capturedAndWritten'
		end 'eachCapture'
	end 'collectCellLocalNames'

	// Is the argument beginning at `index` EXACTLY one name and nothing else? The by-reference call site's
	// pre-parse question — asked before the value is parsed, because handing over a cell means the read must
	// not materialize its contents in the first place. `bareCallArgumentAt` above answers the same shape from
	// inside a walk that already knows where it is; this one is asked at a cursor that is standing on the
	// argument's first token, so the bracket state is the caller's own and needs no stack.
	function argumentIsExactlyANameAt(index TokenIndex) returns bool
		if not tokenCanBeAName(self.tokenAt(index)) 'notAName'
			return false
		end 'notAName'

		let after = self.kindAt(index + 1)
		return after == TokenKind.comma or after == TokenKind.rightParen
	end 'argumentIsExactlyANameAt'

	// ⭐ **IS THE TOKEN AT `index` A BARE NAME STANDING ALONE AS A CALL ARGUMENT?** — PBR-2's forwarding probe
	// (`scanBodyFacts`), and the token-level twin of what `argWasBareName` asks of the real parse: an
	// argument names a binding only if it IS that name and nothing else.
	//
	// Four conditions, and the bracket one is what tells an ARGUMENT from a grouping paren's contents or a
	// struct literal's field value: the innermost open bracket must be a `(`. A struct literal is `{…}` and is
	// excluded by it, which is right — a field store is a CONSUME (the column above), never a forward.
	//
	// ⚠ **A PARAMETER'S NAME MAY BE A KEYWORD (D8)**, so this asks `tokenCanBeAName` rather than
	// `== identifier`, for the reason `consumedParamAfterColon` states with its measurement. Claiming nothing
	// extra: the name is looked up in the parameter list by the caller, and a keyword naming no parameter is
	// dropped exactly as an unrelated identifier is.
	//
	// ⚠ It over-detects a GROUPING paren whose whole contents are one name — `(x)` reads as an argument. The
	// edge it records then carries whatever name preceded the paren, which no function wears, so
	// `noteForwardCall` drops it and only the parameter's own `forwarded` bit is set. Harmless: a forwarded
	// bit with no live edge never widens anything.
	function bareCallArgumentAt(index TokenIndex, braceStack BoolArray) returns bool
		if braceStack.count() == 0 or self.braceStackInnermostIsBrace(braceStack) 'notInsideACallsParens'
			return false
		end 'notInsideACallsParens'

		if not tokenCanBeAName(self.tokenAt(index)) 'notAName'
			return false
		end 'notAName'

		let before = self.kindAt(index - 1)
		if before != TokenKind.leftParen and before != TokenKind.comma and before != TokenKind.colon 'notAnArgumentsFirstToken'
			return false
		end 'notAnArgumentsFirstToken'

		let after = self.kindAt(index + 1)
		return after == TokenKind.comma or after == TokenKind.rightParen
	end 'bareCallArgumentAt'

	// The callee name of the bracket at `index`, or EMPTY when it opens no call — PBR-2's forwarding EDGE.
	// It is the token immediately before, which for `reassign(…)`, `f.reassign(…)` and `Type.create(…)` alike
	// is the BARE name, exactly the spelling `ProgramSignatures.closeByRefForwarding` matches against.
	//
	// A `{` opens a STRUCT LITERAL and never a call, so it answers EMPTY however nameable the token before it
	// is — `Self{tag: t}` must not read as a call to `Self`.
	function calleeNameOpeningAt(index TokenIndex) returns ByteArray
		if self.kindAt(index) != TokenKind.leftParen 'opensNoCall'
			return EmptySourceText
		end 'opensNoCall'

		if index == 0 or not tokenCanBeAName(self.tokenAt(index - 1)) 'aGroupingParen'
			return EmptySourceText
		end 'aGroupingParen'

		return self.tokenAt(index - 1).value
	end 'calleeNameOpeningAt'

	// ⭐⭐ **THE FORWARDING EDGE THE BRACKET AT `index` STATES, SHAPE AND ALL (PBR-2).** The name is
	// `calleeNameOpeningAt`'s — it is the same name, and asking it twice is how the two would come apart — and
	// the SHAPE is read off the one or two tokens before it, which is a hard partition of what the call can
	// name (see `ForwardCall`). An EMPTY name means the bracket opened no call at all, which `noteForwardCall`
	// drops; the shape of a non-call is never read.
	//
	// ⭐ **`self.f(` AND `Self.f(` ARE THE NARROWEST SHAPE, AND BOTH KEYWORDS MEAN THE ENCLOSING TYPE** — the
	// instance receiver and the static one name the same declaration space, so `Self.create(…)` is as
	// precisely attributable as `self.swap(…)`. It must be `<self> . <name> (` EXACTLY: a longer chain
	// (`self.managed.swap(`) has a receiver that is a FIELD, whose type this walk cannot know, so it falls
	// through to the wide receiver shape — which is why `Array.swap`'s own `managed.swap(i, j: j)` still
	// widens (see `Parser.requireOverloadableName` for what that leaves open).
	function forwardCallOpeningAt(index TokenIndex) returns ForwardCall
		let name = self.calleeNameOpeningAt(index)
		if index < 2 or self.kindAt(index - 2) != TokenKind.dot 'noReceiverWasWritten'
			return ForwardCall.bare(name)
		end 'noReceiverWasWritten'

		if index >= 3 and receiverIsTheEnclosingType(self.kindAt(index - 3)) and not self.enclosingType.isEmpty() 'theEnclosingTypesOwnMethod'
			return ForwardCall.throughSelf(self.enclosingType, name: name)
		end 'theEnclosingTypesOwnMethod'

		return ForwardCall.throughAReceiver(name)
	end 'forwardCallOpeningAt'

	// ⭐⭐ **E3067 — THE TWO DEGENERATE ASSIGNMENT STATEMENTS, REFUSED AT ONE DOOR, PURELY TEXTUALLY.**
	//
	// THE RULE, STATED SO THAT ITS FALSE-REJECT SURFACE IS OBVIOUS. The statement beginning at `index` is
	// refused when it is EITHER of:
	//
	//   1. `<chain> = <chain> <statement end>` where the two chains are THE SAME TOKENS — equal kind AND
	//      equal spelling, position by position. A chain is `fieldChainEndAfter`'s: a base (an identifier,
	//      or a keyword the same walk admits as a name — `self` among them) followed by zero or more
	//      `.member` hops. So `x = x`, `p.x = p.x`, `self.n = self.n` and `a.b.c = a.b.c` are refused.
	//   2. `_ = <literal> <statement end>` — a discard whose right-hand side is a single literal token.
	//      The discard form exists to say "this call's result is deliberately unused"; a literal was never
	//      a call, so the statement computes nothing and discards nothing.
	//
	// ⚠ **TEXTUAL IS THE WHOLE OF IT** — the registry's own doc for E3067 says "a *textual* self-assignment",
	// and nothing here asks what a name MEANS. Everything below is therefore LEGAL and measured to stay so:
	//
	//   • `x = y` and `x = x + 1` — `self-assignment.md`'s own false-reject controls.
	//   • `x = (x)` — parenthesized: different tokens, so not refused. ⚠ **THE RUNNABLE ORACLE DOES REFUSE
	//     IT** (measured: `error E3067: … self-assignment has no effect: 'x = x'`), because its rule is
	//     SEMANTIC — it asks whether the parsed RHS resolved to the same variable. shv2 takes the reference
	//     v1 compiler's textual rule instead, the one the registry describes and the one that cannot be
	//     wrong about what a program MEANS: it can only ever miss, never mis-refuse.
	//
	// ⚠⚠ **AND IT IS STRICTER THAN THE ORACLE IN TWO DIRECTIONS, WHICH IS THE HALF THAT CAN BREAK A
	// PROGRAM THE ORACLE COMPILES.** A looser rule only lets a bad program through; a stricter one refuses
	// a good one, so these are the divergences worth writing down:
	//
	//   • `self.n = self.n` and `a.b.c = a.b.c` — **both COMPILE CLEAN on the bootstrap** (measured). Its
	//     `IsFieldSelfAssignment` (`2-Parser.cs:11823`) matches a `MaxonStructVarRefOp` plus ONE field
	//     name, so it sees neither the `self` receiver nor a chain of more than one hop. shv2 refuses both,
	//     because they are the same mistake and the chain walk costs nothing to ask uniformly; carving
	//     `self` back out would be more code for a worse rule.
	//   • **PRECEDENCE, not scope**: this runs before name resolution and before the mutability check, so
	//     `let x = 1` / `x = x` is E3067 here where the oracle says "cannot assign to immutable variable",
	//     and an undeclared `x = x` is E3067 here where the oracle says undefined-variable. The refusal is
	//     correct in every case; only which of two true complaints is reported first differs. Nothing pins
	//     either, and moving the check later would cost it the one property that makes it cheap — it reads
	//     TOKENS, at a point where no op has been emitted and nothing has to be unwound.
	//   • `arr[i] = arr[i]`, `m.get(k) = …` — an index or a call is not a chain hop, so the walk stops at
	//     the `[` / `(`, the LHS never reaches an `=`, and this rule never looks at the statement at all.
	//   • `_ = f()`, `_ = try stack.pop() otherwise 0` — the discard's whole purpose.
	//   • `_ = someBinding` — the DISCARD-A-BINDING idiom, which satisfies E3012 for a value a build
	//     configuration leaves unused. It is LIVE in the corpus (`stdlib/Internals.maxon`'s
	//     `__leak_count_dec`, plus four committed `specs-shv2` cases), so only a bare LITERAL is refused
	//     here, never "anything that is not a call". ⚠ The oracle refuses `_ = someBinding`; shv2 does not,
	//     and that gap is deliberate — closing it would falsify five programs this tree already compiles.
	//   • `_ = true` — `true`/`false` lex as KEYWORDS, not as literal kinds, so `tokenIsLiteralKind` (THE
	//     one literal list, shared with `tokenCanBeAName`) does not admit them and this does not fire. A
	//     second literal list written out here to catch two token kinds no corpus program writes would be
	//     the duplication that list exists to prevent.
	//
	// ⚠ **THE STATEMENT-END TEST IS LOAD-BEARING, NOT DEFENSIVE.** Drop it and `x = x + 1` — the spec's own
	// control — fires: its RHS chain IS `x` and matches the LHS token for token. What makes it a different
	// program is only the `+ 1` that follows, so "the chain is the WHOLE right-hand side" is the rule.
	//
	// Asked once, from `parseStatement`, before the dispatch — rather than from each of the three
	// assignment arms — because the shape it refuses spans all of them (`assignsAt`, `fieldAssignsAt` and
	// `selfFieldAssignsAt` each own one spelling of it) and a fourth write form would otherwise have to
	// remember to ask. A statement that opens with something the chain walk refuses costs one predicate.
	//
	// ⛔ **AND THE FOURTH WRITE FORM ARRIVED AND DOES *NOT* REACH IT — TUPLE ASSIGNMENT.** `fieldChainEndAfter`
	// walks a chain from a NAME, so it stops dead at the `(` and this rule never looks at the statement:
	// `(x, y) = (x, y)` compiles where `x = x` is E3067. Left as it is rather than widened, and the reason is
	// that the premise above does not actually cover it — a target LIST is not a chain, so serving it needs a
	// SECOND rule here (compare N targets against N right-hand elements), not the reuse the header promises.
	// It is a missing diagnostic on a statement nobody writes, and inventing a positional self-assignment rule
	// no reference compiler has, on a form neither of them refuses either, is a bigger claim than this port
	// should make. The paragraph above is kept honest by saying so here.
	function rejectDegenerateAssignment(index TokenIndex) throws ParseError
		let lhsEnd = self.fieldChainEndAfter(index, minHops: AnyFieldHops)
		if lhsEnd == index or self.kindAt(lhsEnd) != TokenKind.equals 'notAnAssignmentStatement'
			return
		end 'notAnAssignmentStatement'

		let anchor = self.tokenAt(index)
		let rhsStart = lhsEnd + 1

		// Rule 2 first, because it is the one rule keyed on WHICH name the target is. The discard is the
		// BARE `_` and only that — `lhsEnd == index + 1` is the zero-hop chain — so `_.field = 42` (which
		// binds nothing and is not a legal program by any route) is not told "expected a function call",
		// a sentence about a rule it is not breaking.
		//
		// ⚠ It does NOT `return` when the RHS is not a literal, so `_ = _` still falls through to rule 1
		// and is refused as the self-assignment it textually is. An early return here would have made the
		// header's "rule 1 has no exceptions" false for exactly one spelling.
		if anchor.value.equals(DiscardBindingName) and lhsEnd == index + 1 and tokenIsLiteralKind(self.kindAt(rhsStart)) and self.statementEndsAt(rhsStart + 1) 'discardOfALiteral'
			throw ParseError.discardOfALiteral(anchor.line, column: anchor.column)
		end 'discardOfALiteral'

		// The RHS must be the SAME LENGTH as the LHS and nothing more, which is one question rather than
		// two: read the same span of tokens after the `=`, and require the statement to stop right there.
		let chainLength = lhsEnd - index
		if not self.statementEndsAt(rhsStart + chainLength) 'rhsIsNotJustTheChain'
			return
		end 'rhsIsNotJustTheChain'

		if not self.tokenSpansAreIdentical(index, other: rhsStart, length: chainLength) 'notTheSameChain'
			return
		end 'notTheSameChain'

		throw ParseError.selfAssignmentHasNoEffect(self.renderChain(index, length: chainLength), line: anchor.line, column: anchor.column)
	end 'rejectDegenerateAssignment'

	// ⭐ **THE COMPARE ALLOCATES NOTHING, AND THAT IS THE POINT — IT RUNS ON EVERY ASSIGNMENT IN THE
	// PROGRAM.** `x = y`, `p.x = q.y` and `self.a = self.b` all reach it and all differ; only the refused
	// program ever reaches `renderChain`. Fused with the rendering — which is how it was first written —
	// every one of them paid an empty `String` plus one interpolation and one `String.from` PER MATCHED
	// TOKEN before finding the difference, and `self.a = self.b` paid two of each on every compile.
	//
	// ⚠ **THIS PROJECT HAS ALREADY BOUGHT THIS LESSON ONCE**: `NamePosition` exists because handing a
	// rendered `String` down a per-token path measured **+5,495 allocations at rung 0, doubling per rung**.
	// A diagnostic's text is owed only by the program that gets the diagnostic.
	function tokenSpansAreIdentical(index TokenIndex, other TokenIndex, length TokenIndex) returns bool
		var offset = 0
		while offset < length 'eachToken'
			let left = self.tokenAt(index + offset)
			let right = self.tokenAt(other + offset)
			if left.kind != right.kind or not left.value.equals(right.value) 'differs'
				return false
			end 'differs'

			offset = offset + 1
		end 'eachToken'

		return true
	end 'tokenSpansAreIdentical'

	// A field chain spelled back as the author wrote it, for a diagnostic that must quote it. A chain
	// token is either a name — whose `value` carries the spelling — or the `.`, which is punctuation and
	// whose `value` is EMPTY by `Token.value`'s rule, so its spelling is its kind. That emptiness test is
	// the same one `tokenCanBeAName` tells the two apart by, rather than a second rule about dots.
	function renderChain(index TokenIndex, length TokenIndex) returns String
		var rendered = ""
		var offset = 0
		while offset < length 'eachToken'
			let tok = self.tokenAt(index + offset)
			rendered = "{rendered}{tok.kind.rawValue}" if tok.value.isEmpty() else "{rendered}{String.from(tok.value)}"
			offset = offset + 1
		end 'eachToken'

		return rendered
	end 'renderChain'

	// **The token shape of a FIELD STORE** — `<base> . <field> =`, asked at an ABSOLUTE index.
	//
	// Deliberately NOT folded into `assignsAt`: see there. The two are disjoint by construction (the
	// token after the base is `=` for one and `.` for the other), so `parseStatement` may ask them
	// in either order and get the same answer.
	//
	// `p.x == y` cannot be mistaken for a store: `==` lexes as a single `equalsEquals` token. Nor
	// can `Point.create(…)`, whose token at +3 is `(`.
	//
	// ⭐ **A CHAIN `o.inner.x =` matches too** (P1.4a wave 2): the base identifier is followed by ONE OR
	// MORE `.identifier` hops and then a single `=`. `resolveFieldChain` reads exactly this shape, so the
	// dispatch predicate and the parser agree on where a chained store begins and ends. A `.method()` chain
	// ends in `(` (not `=`) and a comparison in `==`, so neither is mistaken for a store.
	//
	// ⚠ **THE WALK IS `fieldChainEndAfter`'S, NOT A SECOND ONE (A1s-prim review).** This used to re-implement
	// the hop loop inline — a third copy of a walk whose OWN header says a divergence between its askers is a
	// USE-AFTER-FREE rather than a compile error, because `fieldChainMethodCallAt` decides a write goes through
	// a chain and `sourceNamesABase` decides a `for … in` LOCKS that chain's base against exactly that write.
	// A store dispatcher that disagreed with the walk about where a chain ends is inside that blast radius, so
	// it asks the walk — and it is asked EXACTLY as `fieldChainMethodCallAt` asks it, `chainEnd == index` first
	// and the trailing token second. That guard is load-bearing rather than defensive: the walk answers `index`
	// unchanged BOTH for a base it refuses and for a zero-hop chain, so without it a statement standing on a
	// bare `=` — a base `tokenCanBeAName` refuses, leaving `kindAt(index)` the `=` itself — would read as a
	// field store instead of reaching the dispatcher's `unsupported` arm.
	function fieldAssignsAt(index TokenIndex) returns bool
		let chainEnd = self.fieldChainEndAfter(index, minHops: FieldStoreMinHops)
		return chainEnd != index and self.kindAt(chainEnd) == TokenKind.equals
	end 'fieldAssignsAt'

	// **The token shape of a STATIC MEMBER STORE (W65)** — `<Type> . <member> =`, where the base names a
	// declared type rather than a value and the qualified name is a binding the program declared. The
	// shadowing rule and the resolution are `staticMemberBaseAt`'s, stated there once for this door and its
	// call-shaped twin; what is decided HERE is only the token that must follow the pair.
	//
	// The `=` is what separates a store from a read: `Counter.count + 1` has no trailing `=` and belongs to
	// the expression arm, and `Counter.count == 1` lexes its operator as one `equalsEquals` token. It is
	// asked FIRST, ahead of the resolution: it is a token-kind compare that allocates nothing, and
	// everything inside `staticMemberBaseAt` joins a name and boxes two lookups.
	function staticMemberAssignsAt(index TokenIndex) returns bool
		return self.kindAt(index + TokensPerQualifierSegment + 1) == TokenKind.equals and self.staticMemberBaseAt(index)
	end 'staticMemberAssignsAt'

	// **The token shape of a METHOD CALL ON A STATIC MEMBER (W65)** — `<Type> . <member> . <method> (`, the
	// STATEMENT half of the form `parseDottedPrimary`'s static arm already serves in expression position.
	// The trailing member call is what makes it a statement at all: a bare `Names.items` on a line of its
	// own computes nothing and stays the `Unsupported: identifier statement` it has always been.
	//
	// The tail asks `memberCallFollows`, the predicate every other `<base> . <member> (` dispatcher asks, so
	// this door cannot disagree with the rest of the file about what a member call looks like — and it is
	// asked first for `staticMemberAssignsAt`'s cost reason.
	function staticMemberCallsAt(index TokenIndex) returns bool
		return self.memberCallFollows(index + TokensPerQualifierSegment + 1) and self.staticMemberBaseAt(index)
	end 'staticMemberCallsAt'

	// ⭐ **DOES A ONE-HOP DOTTED FORM AT `index` ROOT AT A STATIC MEMBER — the half the two STATEMENT
	// dispatchers share (W65)?** They differ only in the token that must FOLLOW the pair, and everything
	// before that is one question: the `.`, the shadowing rule, the type-naming base and the qualified
	// resolution. Written once so the store door and the call door cannot come to disagree about which
	// spellings are static members — a disagreement that would be silent, each falling through to a
	// different arm's refusal of the same program.
	//
	// ⭐ **A VALUE IN SCOPE OUTRANKS THE TYPE READING, and that test is why this is not merely a name probe.**
	// A local called `Counter` shadows `Counter.` exactly as a local `OFFSET` shadows a top-level constant of
	// that name — the rule `baseNamesAValueInScope` carries — so `Counter.count = 1` with such a local in
	// scope is a FIELD store on that local and must fall through to `fieldAssignsAt`. `Self` is excluded from
	// the shadowing test by that same function, which is what makes `Self.count = 1` inside a static method
	// reach here.
	function staticMemberBaseAt(index TokenIndex) returns bool
		if self.kindAt(index + 1) != TokenKind.dot 'notADottedForm'
			return false
		end 'notADottedForm'

		if self.baseNamesAValueInScope(self.tokenAt(index)) 'aValueBase'
			return false
		end 'aValueBase'

		let baseTok = try self.typeBaseTokenAt(index) otherwise return false
		return self.namesStaticMemberAt(baseTok, memberIndex: index + TokensPerQualifierSegment)
	end 'staticMemberBaseAt'

	// **The token shape of an EXPLICIT self-field store** — `self . <field> =`.
	//
	// Its own predicate rather than a widening of `fieldAssignsAt`, because `self` is a KEYWORD and
	// not an identifier — and, more to the point, for `fieldAssignsAt`'s own reason: it assigns no
	// BINDING, so `assignedBindingsIn` must not see it. (The BARE spelling `count = 5` DOES match
	// `assignsAt` and is deliberately left to; see there.)
	function selfFieldAssignsAt(index TokenIndex) returns bool
		return self.kindAt(index) == TokenKind.self and self.kindAt(index + 1) == TokenKind.dot and self.kindAt(index + 2) == TokenKind.identifier and self.kindAt(index + 3) == TokenKind.equals
	end 'selfFieldAssignsAt'

	// **The token shape of an INSTANCE METHOD CALL** — `<base> . <name> (`, where `<base>` names a
	// value IN SCOPE (a binding, or the `self` keyword's receiver).
	//
	// ⭐ **THE SCOPE TEST IS THE WHOLE PREDICATE**, because the token shape alone cannot tell
	// `c.increment()` from `Point.create()` — they are identical. What separates them is that one
	// base is a VALUE and the other is a TYPE NAME, and only the scope knows which.
	//
	// Asked at an ABSOLUTE index by `parseStatement` and at the cursor by
	// `parseDottedPrimary`/`parseSelfPrimary`, so the statement and expression positions cannot come
	// to disagree about what a method call looks like — which they would, since a method call is
	// legal in both and only one of them may discard the result.
	//
	// ⚠ A STATIC call in statement position stays unsupported, and that is deliberate rather than an
	// oversight of this predicate: `Point.create()` on a line of its own discards a value, and for a
	// factory that value is a box nothing would then free.
	// ⭐⭐ **`<arrayBinding> . managed` — THE FIELD DOOR (R4.4), AND WHY IT NEEDS A PREDICATE OF ITS OWN.**
	//
	// `.managed` is a FIELD: the corpus writes no parentheses (`arr.managed.setLength(2)`,
	// `f(bytes.managed)`), so `methodCallsAt` — which requires a `(` at +3 — is false for it, and the
	// statement/expression dispatchers fall through to the field-access path instead. There the base is an
	// `Array`, whose 48-byte record shv2 SYNTHESIZES rather than compiling `stdlib/Array.maxon`, so
	// `structLayoutOfType` finds no field table at all and `missingBaseLayout` reports E2015.
	//
	// ⭐ **THAT IS PURE PARSER ROUTING AND HAS NOTHING TO DO WITH THE ELEMENT TYPE, WHICH WAS MEASURED**:
	// `arr.managed.setLength(1)` failed identically on an `Array with Byte` — the instance `__ManagedMemory` was
	// already bound to — so every filed note in the corpus blaming the element binding was wrong about the cause.
	// What the access needs is to reach `dispatchArrayMethod`, which has served `.managed` as a member since R4.1
	// (a VALUE receiver, `"…".toByteArray().managed`, has always worked).
	//
	// ⇒ So this predicate routes the BINDING spelling to `parseMethodCall`, the very door `methodCallsAt` routes
	// to, and the dispatcher's own `.managed` arm does the rest. Where the two are asked together they are asked
	// BESIDE each other, never instead: they are disjoint by the `(` immediately after `managed`, which
	// `methodCallsAt` requires and no `.managed` read has.
	//
	// ⭐ **TWO SPELLINGS, ONE RULE PLUS ONE CONJUNCT (BATCH2 slice 6).** `arr.managed` is now claimed in VALUE
	// position too, so the member call is no longer part of *this* question — it is asked by
	// `arrayManagedMemberCallAt` below, which is literally this predicate `and` the `.<member>(` at +3, and
	// which the two positions that need a CALL read instead. The EXPRESSION door reads this one.
	//
	// ⚠ **IT IS NARROW ON PURPOSE, IN TWO WAYS.** The member must be `managed` — `arr.someOtherField` keeps
	// `missingBaseLayout`'s carefully-worded refusal, which is still the true answer for every other field of a
	// synthesized record. And the base must be a binding in THIS function's scope, because that is what makes
	// `parseMethodCall`'s `localReceiver` arm certain to fire; a captured or top-level array's `.managed` stays
	// refused as before rather than reaching that function's impossible-state panic.
	function arrayManagedFieldAt(index TokenIndex) returns bool
		if not tokenCanBeAName(self.tokenAt(index)) 'notABase'
			return false
		end 'notABase'
		if self.kindAt(index + 1) != TokenKind.dot or not self.tokenAt(index + 2).value.equals(ManagedMemoryFieldName) 'notTheManagedField'
			return false
		end 'notTheManagedField'
		// ⭐ **THE BARE VALUE FORM IS CLAIMED TOO (BATCH2 slice 6), AND THE CASE THAT WANTED IT ARRIVED:**
		// `stdlib/File.maxon:147` is `try writer.writeAll(content.managed)` — the buffer of a BORROWED
		// `ByteArray` parameter, in ARGUMENT position, with no member call after it. This predicate used to
		// require a `.<member>(` at +3 and left that spelling to the field machinery, where an `Array`'s
		// synthesized record has no field table and `missingBaseLayout` reported E2015. The member-call
		// conjunct now lives in `arrayManagedMemberCallAt` below, which the two positions that genuinely need
		// a CALL ask instead.
		// ⚠ **IT IS NOT AN IDENTITY ANY MORE, AND THAT IS WHAT MADE THE WIDENING SAFE** — see
		// `dispatchArrayMethod`'s `bufferAsAValue` arm, where the receiver's own `ValueId` handed back to a
		// `let` would have made the binding and the array two owners of one record.
		let baseName = self.baseBindingName(self.tokenAt(index))
		if not self.scope.contains(baseName) 'notALocalBinding'
			return false
		end 'notALocalBinding'

		return self.typeIsArrayInstance(self.scope.getInfo(baseName).varType)
	end 'arrayManagedFieldAt'

	// ⭐⭐ **`<enumBinding> . ordinal` — THE ENUM ACCESSOR DOOR, and it needs a predicate of its own for
	// `arrayManagedFieldAt`'s reason exactly.**
	//
	// `.ordinal` is a FIELD read: no parentheses, so `methodCallsAt` (which requires a `(` at +3) declines
	// it and the expression dispatcher falls through to the field path — where an enum-typed binding is
	// refused, because `TypeResolution` erases a declared `enum` to `integer` and `requireStructBase` finds
	// no struct. That is the E2015 the corpus reported: *"a field access on 's', which is declared 'int' and
	// not a struct type"*. It is pure routing; nothing about the access is ill-formed.
	//
	// ⭐ **THE ENUM IS READ OFF THE VALUE, NOT OFF THE DECLARED TYPE, AND THAT IS THE WHOLE TRICK.**
	// `enumMatchFor` already answers "which enum does this value belong to?" from the value's `named(X)`
	// TAG, which the parser stamps and no later pass rewrites — which is why `match s` works on the very
	// binding whose `varType` reads `integer`. This asks the identical question through the identical door,
	// so the accessor and the `match` can never come to disagree about what `s` is.
	//
	// ⚠ **IT IS NARROW ON PURPOSE, exactly as the `.managed` predicate is.** The member must classify as one
	// of the THREE the language defines on an enum VALUE (`enumInstanceAccessorOf`) — or, on a STRUCT-BACKED
	// enum alone, as a FIELD of its backing struct (see `enumBackingFieldMember`). Every other member of an
	// enum keeps `requireStructBase`'s refusal. And the base must be a binding in THIS function's scope: a
	// captured or top-level enum's accessor stays refused rather than reaching a door built for a local's
	// `boundValue`.
	//
	// It asks the CLASSIFIER through the DERIVED predicate `namesAnEnumInstanceAccessor` — which of the
	// three it got is the whole of what this door does not need to know; `parseEnumAccessor` asks the same
	// classifier and answers for each. One rule, two questions of it, both exhaustive — see
	// `EnumInstanceAccessor` for why it may not be a predicate beside an `if` chain.
	//
	// ⚠⚠ **THE MEMBER TEST MOVED *BELOW* THE SCOPE TEST, AND THAT IS A COST TRADE MADE ON PURPOSE.** The
	// backing-field member set is a property of the LAYOUT, so it cannot be classified before the layout is
	// in hand — which means every `<name> . <name>` in the program now pays a scope probe here where a name
	// like `push` used to be rejected on the spot. It is the probe `methodCallsAt` performed for the same
	// base one line earlier at the only call site (`parseDottedPrimary`), so it is a repeat of a live map
	// read rather than new work — and the ALLOCATING half (`enumMatchFor`, a boxed `DeclaredEnum`) is still
	// behind the scalar tag test, which is the guard `valueIsUnion`'s header argues for.
	function enumAccessorFieldAt(index TokenIndex) returns bool
		if not tokenCanBeAName(self.tokenAt(index)) 'notABase'
			return false
		end 'notABase'
		if not self.enumMemberReadFollowsAt(index + 1) 'notAMemberRead'
			return false
		end 'notAMemberRead'

		let baseName = self.baseBindingName(self.tokenAt(index))
		if not self.scope.contains(baseName) 'notALocalBinding'
			return false
		end 'notALocalBinding'

		// The tag test FIRST, for `valueIsUnion`'s stated reason: `enumMatchFor` returns a `DeclaredEnum`,
		// a union VALUE that heap-allocates even for its `undeclared` case, and this predicate is asked of
		// every `<name>.<name>` in the program. A value can only belong to an enum if its tag is `named`,
		// and that test is a scalar column read that allocates nothing.
		let boundValue = self.scope.getInfo(baseName).boundValue
		if self.tagOf(boundValue) != ValueTypeTag.named 'notAnEnumValue'
			return false
		end 'notAnEnumValue'

		let declaredEnum = self.enumMatchFor(boundValue)
		if not enumMatchIsDeclared(declaredEnum) 'notADeclaredEnum'
			return false
		end 'notADeclaredEnum'

		return self.enumMemberIsReadable(requireEnumLayout(declaredEnum), memberTok: self.enumMemberTokenAt(index + 1))
	end 'enumAccessorFieldAt'

	// ⭐⭐ **DOES `member` NAME SOMETHING READABLE OFF A VALUE OF THIS ENUM?** — the door's admission rule and
	// the accessor's dispatch, asked of ONE function so they cannot come to disagree (which is what
	// `emitEnumInstanceAccessor`'s `notAnAccessor` panic asserts).
	//
	// Two ways to say yes: one of the three members the language defines on every enum VALUE, or — on a
	// STRUCT-BACKED enum only — a field of the backing struct, which such an enum exposes directly.
	//
	// ⚠ **THE THREE ACCESSORS WIN, SO A BACKING FIELD NAMED `name`, `ordinal` OR `rawValue` IS SHADOWED.**
	// `p.name` is the CASE's name even when the backing struct declares a `name` field, and the shorthand's
	// own rule (`p.width` IS `p.rawValue.width`) therefore does not hold for exactly those three spellings —
	// `p.rawValue.name` still reads the field. Both references order it this way. The field is reachable
	// under its long spelling, so nothing is unreachable; it is a precedence worth knowing rather than a gap.
	function enumMemberIsReadable(layout EnumLayout, memberTok Token) returns bool
		if namesAnEnumInstanceAccessor(enumInstanceAccessorOf(memberTok.value)) 'oneOfTheThree'
			return true
		end 'oneOfTheThree'

		return self.enumBackingFieldMember(layout, memberTok: memberTok)
	end 'enumMemberIsReadable'

	// ⭐⭐ **`p.width` IS `p.rawValue.width` — A STRUCT-BACKED ENUM EXPOSES ITS BACKING'S FIELDS DIRECTLY.**
	// `specs-shv2/function-overloads.md`'s `enum-struct-backing-field-argument` states the rule and pins it,
	// and the bootstrap compiles both spellings to the same answer (MEASURED: `p.width` and
	// `p.rawValue.width` both yield 9 on `large = Spec{width: 9, height: 4}`).
	//
	// ⭐ **THE LOOKUP IS THE RULE AND THE BACKING TEST IS A COST GUARD** — `valueIsUnion`'s arrangement, for
	// its reason. The rule has to be the lookup: an enum naming a struct no file declares must not silently
	// admit every member name. But `structOf` boxes a `DeclaredStruct` even to answer `undeclared`, and this
	// is asked of every non-accessor member on every enum binding in the program — where the overwhelming
	// majority are not struct-backed at all and would probe `EmptySourceText` only to be told so.
	function enumBackingFieldMember(layout EnumLayout, memberTok Token) returns bool
		if layout.backing != EnumBacking.structRecord 'notStructBacked'
			return false
		end 'notStructBacked'

		match self.signatures.structOf(layout.backingStructName) 'backing'
			declared(struct) then return struct.declaresField(memberTok.value)
			undeclared then return false
		end 'backing'
	end 'enumBackingFieldMember'

	// ⭐⭐ **THE BINDING SPELLING OF AN ENUM MEMBER READ — `s.ordinal`, `s.name`, `s.rawValue`, `p.width`.**
	// Guarded by `enumAccessorFieldAt`, so the base is a local binding whose value belongs to a declared
	// enum; this consumes `<base> . <member>`.
	//
	// ⭐ **WHAT IT CONTRIBUTES IS THE ONE THING THIS SPELLING KNOWS AND THE TYPE-QUALIFIED ONE DOES NOT: that
	// there IS a value.** So it answers "where is the tag" through `emitEnumTagOf` and hands the tag on;
	// every question about what the MEMBER means is asked once, in `emitEnumInstanceAccessor`, whose header
	// carries them. Written the other way round, the two spellings would each have a copy.
	//
	// It takes no `IrFunction`: the emitters it calls append to `self.currentBlock`, exactly as the
	// `.managed` field door's do. A parameter kept for symmetry would be an unused one (E3012).
	function parseEnumAccessor() returns ValueId throws ParseError
		let baseTok = try self.consumeChainBaseToken()
		try self.consume(TokenKind.dot)
		let memberTok = try self.consumeMemberNameToken()

		let baseBinding = self.scope.getInfo(self.baseBindingName(baseTok))

		// The base is a USE of the binding, so it takes the same liveness/move guard every other read of a
		// name takes — a moved-from enum binding is dead here exactly as it is at `requireStructBase`.
		try self.requireBindingLive(baseBinding, nameTok: baseTok)

		let range = SourceRange.between(baseTok, last: memberTok)
		// ONE read of the binding, serving both questions below: a cell-resident base would otherwise be
		// loaded twice, and the second load is not merely wasteful — the two would be different SSA values
		// describing one enum.
		let baseValue = self.bindingValue(baseBinding, range: range)
		let layout = requireEnumLayout(self.enumMatchFor(baseValue))

		// QUESTION 1 — where the tag is, asked through the door the `match` dispatch asks it through, and the
		// one thing this spelling knows that the type-qualified one does not: there IS a value here.
		return try self.emitEnumInstanceAccessor(layout, tag: self.emitEnumTagOf(baseValue, layout: layout, range: range), memberTok: memberTok, range: range)
	end 'parseEnumAccessor'

	// ⭐⭐ **THE ANSWER ITSELF, ONCE THE TAG IS IN HAND — shared by the two SPELLINGS of an enum member read.**
	// A BINDING's (`op.rawValue`, above) and a type-qualified CASE's (`Op.doubleOp.rawValue`,
	// `TestOp.mul.latency`, `parseEnumLiteral`) differ ONLY in how the tag was obtained; past that they are
	// the same questions of the same layout, so they are asked here once. Written separately, the case
	// spelling would have been a second `.ordinal`/`.name`/`.rawValue` dispatch free to answer differently
	// from the binding one — the shape this file has paid for before.
	//
	// ⭐ **THE SPLIT BETWEEN THE MEMBERS IS THE *CONSTANT* EACH SELECTS AND NOTHING ELSE.** They ask the same
	// questions of the same layout, in the same order, and every one that must compute an answer computes it
	// with the same branchless sum — see `emitEnumCaseConstantSelect`, and `EnumCaseConstant` for the columns
	// it selects from. What differs per member is which column, and what TYPE the answer is handed back at.
	//
	// ⭐⭐ **IT TAKES THE TAG AND NOT A RECEIVER, BECAUSE ONE OF ITS TWO SPELLINGS HAS NO RECEIVER.**
	// `TestOp.mul.latency` names a case of a BOXED union: the read is answered from the constant tag and no
	// box is ever built, so there is no value to hand in.
	//
	// ⭐⭐ **IT ASKS THREE INDEPENDENT QUESTIONS, IN THIS ORDER, AND THEY MUST NEVER BE FUSED INTO ONE.**
	//
	//   1. **WHERE IS THE TAG?** Not asked here at all — asked by each CALLER, through one of the two
	//      functions that answer it: `emitEnumTagOf` for a value (which the `match` dispatch also asks, so
	//      the accessor and the `match` agree about where a union keeps its tag by construction) or
	//      `emitEnumCaseTagConstant` for a case named through its type. The two sit together and neither
	//      rule is spelled out anywhere else.
	//   2. **IS THAT TAG THE ORDINAL, OR ONLY A KEY TO IT?** Where the tag column is `0,1,2,…` the ordinal
	//      is the tag and the accessor costs no instruction; where the author renumbered the cases it is a
	//      different number and the mapping has to be computed (`emitEnumCaseConstantSelect` below).
	//   3. **IS THE ANSWER ALREADY AN `integer`-TYPED VALUE?** A loaded tag is; an unboxed enum's value is
	//      `named(<Enum>)` and needs a `+ 0`. Asked of the value's TYPE COLUMN, not re-derived from question
	//      1 — see `enumTagAsANumber`, which owns that obligation and the measurement behind it.
	//
	// ⭐⭐ **THEY ARE INDEPENDENT, AND THE COMBINATION THIS HEADER CALLED UNREACHABLE NOW ARRIVES — WHICH IS
	// THE ARGUMENT PAYING OUT RATHER THAN AGEING.** It read *"a boxed union cannot currently declare raw
	// values, so 'boxed AND renumbered' never arrives — but that is a fact about what the case reader admits
	// this month, not a law about ordinals"*. The month came: `readEnumCaseInto` reads a case's payload list
	// and its raw value as INDEPENDENT halves (`/specs/union-struct-backing.md` needs both on one case), so
	// `union Instr  add(dest ID, src ID) = 5  nop = 7 end` is boxed AND renumbered. MEASURED, and
	// byte-identical to the oracle: `op.rawValue` is **5** while `op.ordinal` is **0**. A single fused
	// condition would have answered one of those with the other. ⛔ It also broke a THIRD reader that had
	// quietly keyed on the same coincidence — see `appendUnionCasesCompanion`.
	//
	// ⚠⚠ **QUESTION 1 WENT UNASKED UNTIL IT WAS MEASURED, AND EVERY BOXED UNION'S `.ordinal` WAS A BOX
	// POINTER** — `Container.value(7).ordinal` printed 7077912 and `Container.empty.ordinal` printed 7078078
	// against the oracle's 1 and 0, and the numbers MOVED between runs because they were addresses. Both arms
	// of the union, not only the payload-bearing one (see `emitEnumTagOf`). `tagsAreDeclarationIndices` was
	// true for such a union, so it took the `+ 0` route and added zero to an address. This is why the
	// questions are separate: that one predicate was answering all three, and it is only ever an answer to
	// the second.
	function emitEnumInstanceAccessor(layout EnumLayout, tag ValueId, memberTok Token, range SourceRange) returns ValueId throws ParseError
		// The dispatch is EXHAUSTIVE over `EnumInstanceAccessor`, which is what makes the door's cursor test and
		// this answer one rule: a member added to the classifier stops this function compiling until it is
		// answered here. `notAnAccessor` survives as the unreachable arm the guard already excluded.
		match enumInstanceAccessorOf(memberTok.value) 'member'
			caseName then return try self.emitEnumCaseTypedSelect(layout, tag: tag, column: EnumCaseConstant.caseName, valueType: MaxonType.string, anchor: memberTok, range: range)
			rawValue then return try self.emitEnumRawValue(layout, tag: tag, anchor: memberTok, range: range)
			ordinal then break 'member'
			// ⭐ **THE ONE MEMBER THAT IS NOT ONE OF THE THREE AND IS STILL A READ: a STRUCT-BACKED enum's
			// BACKING FIELD** (`p.width`, the shorthand for `p.rawValue.width`). `enumAccessorFieldAt` admits it
			// through `enumMemberIsReadable`, which is the same function this arm's refusal comes from — so the
			// door and the answer stay one rule, exactly as the three accessors are.
			//
			// ⭐ **REACHABLE FROM BOTH SPELLINGS.** `atEnumInstanceAccessor` — the type-qualified door — asks
			// the same `enumMemberIsReadable` this arm's refusal comes from, so `Preset.large.width` and
			// `TestOp.mul.latency` arrive here exactly as `p.width` does. `/specs/union-struct-backing.md`
			// writes the second; the enum spelling is pinned by `specs-shv2/enum-struct-backing.md`'s
			// `struct-backing-type-qualified-field`.
			notAnAccessor then return try self.emitEnumBackingFieldRead(layout, tag: tag, memberTok: memberTok, range: range)
		end 'member'

		// QUESTION 2 — whether that tag is already the answer. The lookup reads the tag as a bare i64, which
		// both forms of it are, so it needs to know nothing about question 1.
		if not layout.tagsAreDeclarationIndices() 'renumberedCases'
			return try self.emitEnumCaseConstantSelect(layout, tag: tag, column: EnumCaseConstant.declarationIndex, anchor: memberTok, range: range)
		end 'renumberedCases'

		return try self.enumTagAsANumber(tag, anchor: memberTok, range: range)
	end 'emitEnumInstanceAccessor'

	// ⭐ **QUESTION 3 — HAND A TAG BACK AS A NUMBER RATHER THAN AS A VALUE OF THE ENUM'S TYPE**, and it is a
	// third question rather than question 1 re-read. It asks what the tag value is TYPED, which is the
	// predicate spelled — a LOADED tag is already `integer` and is returned as it stands, and the `+ 0` below
	// is the same obligation where it is not. Reading `isBoxed` for this would be right only while
	// `emitEnumTagOf`'s load happens to mint `integer`; the type column is what the answer turns on, so it is
	// what is asked.
	//
	// ⭐⭐ **THE `+ 0` IS THE MEANING RATHER THAN A TRICK FOR PRODUCING IT.** An enum value IS its tag
	// (`parseEnumLiteral`), so under the accessor's guard the answer and the value are the same 64 bits — and
	// `s + 0` is already a legal Maxon expression whose result the language types `integer`
	// (`TypeRules.arithResultTag`, a `named` operand being `TypeClass.numeric`). So this emits exactly the IR
	// the equivalent source expression does, and gets its result type from the one rule that types every
	// other arithmetic result rather than from an assertion here.
	//
	// ⚠ **THE FRESH VALUE IS THE POINT, AND HANDING BACK THE RECEIVER'S OWN `ValueId` WAS MEASURED WRONG.**
	// It looks free — same bits, no instruction — but the receiver's value is tagged `named(LocalStatus)`,
	// and that tag is what E3005 reads: `return s.ordinal` from a `returns Integer` function reported
	// *"Cannot return 'LocalStatus' from function declared to return 'int'"*. The tag is not decoration; it
	// is the value's source type, and an ordinal is not of the enum's type. `retypeValue` is not the fix
	// either — it rewrites the columns IN PLACE, and this value may be a BINDING's, so retyping it would
	// break the `match s` two lines later. (`s as Integer` does not help for the same reason: shv2's `as`
	// inside one numeric domain leaves the tag alone, so it is refused identically.)
	//
	// Two readers: `.ordinal` where the tags ARE the declaration indices, and `.rawValue` where the tag IS
	// the raw value and the backing is integral — the same obligation, which is why it is one function.
	function enumTagAsANumber(tag ValueId, anchor Token, range SourceRange) returns ValueId throws ParseError
		if self.tagOf(tag) == ValueTypeTag.integer 'tagIsAlreadyANumber'
			return tag
		end 'tagIsAlreadyANumber'

		let zero = self.emitLiteral(EnumOrdinalTagOffset, valueType: MaxonType.integer, range: range)

		return try self.emitBinOp(tag, rhs: zero, op: MaxonBinOp.add, opTok: anchor)
	end 'enumTagAsANumber'

	// ⭐⭐ **`s.rawValue` — THE ONE ACCESSOR WHOSE RESULT TYPE THE *BACKING* DECIDES**, which is why it has a
	// function of its own where `.name` is one line. Every arm answers from the SAME tag; what differs is the
	// domain the tag is read in:
	//
	//   • `integer` / `unresolved` — the tag IS the raw value and it is already a number. (`unresolved` is an
	//     enum whose cases numbered nothing, where the auto-increment declaration index is the raw value —
	//     which is exactly what the reference answers for `enum Color red green end`.)
	//   • `float` — the tag is the f64's IEEE-754 BIT PATTERN in a GPR, so the read is the `bitsToFloat`
	//     REINTERPRETATION every other float-backed-enum read goes through (`floatBehindEnumValue`, and its
	//     header for the four wrong answers a `cvtsi2sd` produced here).
	//   • `character` — the tag is the Unicode CODEPOINT, and a `Character` is a 56-byte record, so the value
	//     has to be MINTED (`__char_from_cp`) exactly as a `for c in 'a' to 'e'` trip element is. It is the
	//     one raw value that owns heap, so it is enrolled as an owned temporary and dropped at the statement's
	//     end like any other minted record.
	//   • `string` — the tag is only a declaration index (`EnumLayout.rawValueIdentity`), so the value rides
	//     `caseRawValues` and is selected the same way `.name` selects `caseNames`.
	//   • `functionRef` — the tag is only a declaration index too, and `caseRawValues` holds the backing
	//     FUNCTION's name; the constant selected is that function's `__fnref_` thunk address, and the sum is
	//     handed back typed `function(<first case's function>)` so it is CALLABLE. See
	//     `enumFunctionBackingGoverningName` for why the first case's name is the whole enum's answer.
	function emitEnumRawValue(layout EnumLayout, tag ValueId, anchor Token, range SourceRange) returns ValueId throws ParseError
		match layout.backing 'backing'
			// ⚠⚠ **THIS ARM CARRIES EVERY PAYLOAD-BEARING UNION, AND THAT IS THE MEASURED ANSWER RATHER THAN A
			// FALLTHROUGH.** A payload-only case takes `appendAutoTaggedEnumCase`, whose FIRST statement fixes
			// `EnumBacking.integer` — so `union Shape circle(r int) square(s int) blank end` is
			// integer-backed with tags `0,1,2` and `sh.rawValue` lands HERE, not on the `unresolved` arm below.
			// Review once flagged the answer as invented, reasoning from the two STATIC members (`allCases`,
			// `fromRawValue`) being gated `not layout.isUnion` thirty lines up, where the oracle refuses them.
			//
			// ⇒ **REFUTED, twice.** MEASURED against the C# bootstrap on exactly that union: it COMPILES and
			// prints `0/1/2`, byte-identical to shv2's answer. And the CANONICAL spec requires it:
			// `/specs/union-cases.md`'s `union-cases.runtime-accessors` declares
			// `function tagOf(sh Shape) returns Integer  return sh.rawValue` on a payload-bearing union and
			// pins `0`/`1`/`2`. A refusal here would turn that committed case red. The asymmetry with the
			// static members is real and is the reference's: `allCases`/`fromRawValue` need a per-case RAW
			// VALUE the union has not got, while `.rawValue`, `.name` and `.ordinal` need only the tag column
			// every declaration has.
			integer then return try self.enumTagAsANumber(tag, anchor: anchor, range: range)
			// ⭐⭐ **AN UNNUMBERED DECLARATION HAS NO ESTABLISHED BACKING, AND ITS RAW VALUE WOULD BE ITS
			// DECLARATION INDEX** — the same answer the `integer` arm gives, because the tag IS that index.
			//
			// ⛔ **THE PARAGRAPH ABOVE USED TO LIVE HERE, CLAIMING THIS ARM CARRIED EVERY PAYLOAD-BEARING
			// UNION. IT DOES NOT, AND THE MEASUREMENT THAT REFUTES IT RUNS THROUGH `integer`.** Same answer
			// either way, so it was never a wrong answer — which is exactly why it survived: an arm carrying a
			// measurement it is not on the path of. SETTLED by replacing this body with a `panic` and running
			// the union families: **171 passed, 0 failed**, and `tagOf` above still printed `0 1 2`. So the
			// backing is fixed by the first case whatever that case is, and `requireEnumBacking` is the only
			// door to this state — a declaration with NO cases, which cannot be read from.
			unresolved then return try self.enumTagAsANumber(tag, anchor: anchor, range: range)
			float then return self.emitUnaryOp(tag, op: MaxonUnaryOp.bitsToFloat, resultTag: ValueTypeTag.float, range: range)
			character then break 'backing'
			string then return try self.emitEnumCaseTypedSelect(layout, tag: tag, column: EnumCaseConstant.declaredRawValue, valueType: MaxonType.string, anchor: anchor, range: range)
			functionRef then return try self.emitEnumCaseTypedSelect(layout, tag: tag, column: EnumCaseConstant.caseFunctionRef, valueType: MaxonType.function(self.enumFunctionBackingGoverningName(layout)), anchor: anchor, range: range)
			// ⭐ `structRecord` — the tag is only a declaration index, and the raw value is a whole STRUCT, which
			// is not one machine word and therefore not one column. `.rawValue` is not an answer here; the
			// answer is per FIELD, and the field is the token after this one. See `emitEnumBackingRawValue`.
			structRecord then return try self.emitEnumBackingRawValue(layout, tag: tag, anchor: anchor, range: range)
		end 'backing'

		let character = self.emitRuntimeCall(CharFromCodepointName, args: singletonArgs(tag), resultTag: ValueTypeTag.character, resultNameId: UnnamedTypeId, range: range)
		self.trackOwnedTemp(character, exclusivity: OwnedHeapExclusivity.sole)
		return character
	end 'emitEnumRawValue'

	// ⭐ **`p.width` — THE SHORTHAND SPELLING, WHERE THE MEMBER IS THE FIELD AND THERE IS NO `.rawValue` HOP
	// TO CONSUME.** The assertion is what makes the door and this dispatch one rule: `enumAccessorFieldAt`
	// admits a member through `enumMemberIsReadable`, whose second half is the very predicate re-asked here,
	// so a member it admitted cannot be one this refuses — and a member it did NOT admit never arrives,
	// because `parseDottedPrimary` falls through to `parseFieldAccess`'s refusal instead.
	function emitEnumBackingFieldRead(layout EnumLayout, tag ValueId, memberTok Token, range SourceRange) returns ValueId throws ParseError
		if not self.enumBackingFieldMember(layout, memberTok: memberTok) 'notAMemberAtAll'
			panic("emitEnumBackingFieldRead: member '{String.from(memberTok.value)}' reached the accessor and names neither one of the three enum accessors nor a field of `{layout.kindWord()} {String.from(layout.name)}`'s backing struct — EVERY door into this dispatch admits a member through `enumMemberIsReadable`, the very predicate this line re-asks, so a member any of them admitted cannot be one this refuses")
		end 'notAMemberAtAll'

		return try self.emitEnumBackingFieldSelect(layout, tag: tag, fieldTok: memberTok, range: range)
	end 'emitEnumBackingFieldRead'

	// ⭐⭐ **DOES A `.<field>` HOP FOLLOW THE CURSOR? — THE ONE TOKEN-SHAPE TEST FOR CONTINUING A BACKING
	// CHAIN.** Both places that must ask it are the same question about the same two tokens: `.rawValue`
	// deciding whether a field follows it, and a NESTED RECORD deciding whether the chain descends into one.
	//
	// ⚠ **IT WAS WRITTEN OUT TWICE, CHARACTER FOR CHARACTER, AND THE COPIES CANNOT BE MADE TO DISAGREE
	// LOUDLY.** `consumeMemberNameToken` admits more than an identifier (a keyword, and a NUMBER rewritten
	// into a name for a tuple member), so widening one copy for `t.0` and not the other would not be a
	// compile error anywhere — it would accept `.rawValue.0` while refusing `.rawValue.pair.0`, or the
	// reverse. The two SENTENCES stay separate: they are about different subjects, the whole record and one
	// nested field.
	function atEnumBackingFieldHop() returns bool
		return self.enumMemberReadFollowsAt(self.pos) and tokenCanBeAName(self.enumMemberTokenAt(self.pos))
	end 'atEnumBackingFieldHop'

	// ⭐⭐ **`e.rawValue.<field>` ON A STRUCT-BACKED ENUM — THE `.rawValue` IS A HOP, NOT AN ANSWER.** The
	// cursor sits just past `rawValue`; this consumes the `. <field>` that must follow and hands the read to
	// the per-field select.
	//
	// ⛔⛔ **BARE `.rawValue` IS REFUSED, DELIBERATELY, AND BOTH REFERENCES SUPPORT IT.** MEASURED on the C#
	// bootstrap: `let r = p.rawValue` then `r.height` compiles and prints the field, by MATERIALIZING the
	// backing struct — v1 does the same (`LowerMaxonToStd.lowerStructBackedEnumRawValue` heap-allocates the
	// record and fills every leaf from its own select chain). shv2 does not, and the reason is the one
	// `parseEnumLiteral`'s boxed-union hop already states for a neighbouring gap: a materialized record is an
	// OWNED heap value minted mid-expression, which asks who drops it and when — and the wrong answer to that
	// is a leak or a double free rather than a diagnostic. **No case in `/specs/enum-struct-backing.md` puts
	// that question**: every use in it is `.rawValue.<field>`, which needs no record at all. Whoever puts it
	// builds the materialization; until then the refusal says exactly that rather than implying the value
	// cannot exist.
	//
	// ⇒ This refusal is also the REASON `fromRawValue` on such an enum is an absent member rather than a
	// declined one. ⚠ It is not the MECHANISM, and saying so would be prose standing in for code: the
	// absence is produced by the explicit conjunct `and layout.backing != EnumBacking.structRecord` at the
	// claim site in `parseEnumLiteral`. Delete that conjunct and the call reaches
	// `requireFromRawValueBacking`'s `structRecord` arm, which PANICS — it asserts the claim site's decision
	// rather than re-deriving it. Nothing about E3034 falls out on its own.
	function emitEnumBackingRawValue(layout EnumLayout, tag ValueId, anchor Token, range SourceRange) returns ValueId throws ParseError
		if not self.atEnumBackingFieldHop() 'noFieldFollows'
			throw ParseError.unsupported("`{String.from(EnumRawValueMemberName)}` on `{layout.kindWord()} {String.from(layout.name)}` read as a whole value — its raw value is a `{String.from(layout.backingStructName)}` record, which shv2 selects one FIELD of at a time (`.{String.from(EnumRawValueMemberName)}.<field>`) rather than materializing. Both reference compilers do materialize it; doing so here means minting an owned heap record inside an expression, and no case in `/specs/enum-struct-backing.md` asks for one", line: anchor.line, column: anchor.column)
		end 'noFieldFollows'

		try self.consume(TokenKind.dot)
		let fieldTok = try self.consumeMemberNameToken()

		return try self.emitEnumBackingFieldSelect(layout, tag: tag, fieldTok: fieldTok, range: range)
	end 'emitEnumBackingRawValue'

	// ⭐⭐ **WHICH SCALAR LEAF `<field>[.<field>…]` NAMES — THE WALK OVER THE DECLARED TYPES.** The cursor sits
	// just past the FIRST field name (`fieldTok`); every further hop this consumes is one the chain wrote.
	//
	// ⭐⭐ **IT DESCENDS THE *TYPES*, NEVER THE WRITTEN CONSTANTS, AND THAT IS WHAT MAKES ONE PATH SERVE EVERY
	// CASE.** `op.rawValue.meta.latency` means the same field of the same struct whichever case `op` holds —
	// the cases differ only in the NUMBER at the end — so the path is resolved ONCE per read here and the
	// per-case walk (`enumBackingFieldConstant`) merely follows it. Resolving against one case's entries
	// would make the answer depend on which case happened to be looked at first.
	//
	// ⛔ **A CHAIN THAT STOPS ON A RECORD IS REFUSED, AND IT IS BARE `.rawValue`'s REFUSAL ONE LEVEL IN.**
	// `op.rawValue.meta` names a whole `OpMeta` record; handing one back means minting an owned heap record
	// inside an expression, which asks who drops it and when (see `emitEnumBackingRawValue`, where the same
	// question is declined for the backing itself). Nothing in `/specs/enum-nested-struct-backing.md` asks
	// for one: every read in it reaches a scalar.
	//
	// ⚠ **RECURSIVE RATHER THAN A LOOP, AND THE PATH IS PASSED DOWN**: each hop is the identical question of
	// a different struct, and a loop would have to REBIND the struct — a managed value — once per hop.
	function resolveEnumBackingLeaf(struct StructLayout, memberTok Token, path EnumBackingFieldStepArray) returns EnumBackingLeaf throws ParseError
		let field = try self.requireFieldIndex(struct, name: memberTok.value, anchor: memberTok)
		path.push(EnumBackingFieldStep.create(field, fieldName: struct.fieldNameAt(field), ownerName: struct.name))

		let fieldType = self.signatures.fieldTypeOf(struct, index: field, into: self.artifact.typeNames)
		let domain = self.enumBackingFieldDomainOf(fieldType)
		if not domainIsEnumBackingNestedRecord(domain) 'reachedAScalar'
			return EnumBackingLeaf.create(path, fieldType: fieldType, domain: domain)
		end 'reachedAScalar'

		let nested = self.enumBackingNestedStruct(struct, field: field)
		if not self.atEnumBackingFieldHop() 'noFieldFollows'
			throw ParseError.unsupported("field '{String.from(struct.fieldNameAt(field))}' of the `{String.from(struct.name)}` backing read as a whole value — it is declared `{String.from(nested.name)}`, a record, and shv2 selects one SCALAR field of a struct backing at a time (`.{String.from(struct.fieldNameAt(field))}.<field>`) rather than materializing one. That is the refusal `{String.from(EnumRawValueMemberName)}` itself carries, one level in: a materialized record is an owned heap value minted inside an expression", line: memberTok.line, column: memberTok.column)
		end 'noFieldFollows'

		try self.consume(TokenKind.dot)

		return try self.resolveEnumBackingLeaf(nested, memberTok: try self.consumeMemberNameToken(), path: path)
	end 'resolveEnumBackingLeaf'

	// ⭐⭐ **ONE FIELD OF A CONSTANT STRUCT BACKING, AS A VALUE — the per-field column, selected by the very
	// sum `.ordinal` and `.name` are selected by.** That is the whole mechanism: a struct is not one machine
	// word, but each of its FIELDS is, so the branchless `Σᵢ constantᵢ × (tag == tagᵢ)` applies once per field
	// read and nothing new is needed for a backing that is not a scalar.
	//
	// ⭐⭐ **NO CONSTANT-RECEIVER FOLD, AND THAT IS A DELIBERATE DEPARTURE FROM v1.** The spec's prose
	// describes a parser that folds `let op = TestOp.mul` to a literal and emits the select only for a runtime
	// receiver — which is what v1 does, and it costs it a `let`-to-case alias table
	// (`letStructBackedEnumCases`), a second folding walk (`parseStructBackingAccessChain`) and a descent
	// shared between them precisely so the two answers stay "byte-for-byte in sync". **shv2 emits the SELECT
	// for both**, so the constant receiver and the runtime one are one route that cannot disagree, and there
	// is no second walk to keep in step.
	//
	// ⚠ **WHAT THAT COSTS IS MEASURED, AND IT IS NOT ZERO: the chain reaches x64 UNFOLDED.** `struct-backing-
	// basic`'s emitted `main` is `movRegImm32 rax, 1` followed by the full two-case
	// `cmpRegImm32`/`setccReg`/`imulRegRegImm32`/`lea` ladder, not a `movRegImm32 r8, 3`. `foldConstOperands`
	// does not collapse it.
	//
	// ⇒ **AND THAT IS PRE-EXISTING BEHAVIOUR OF `emitEnumCaseConstantSelect`, NOT SOMETHING THIS COLUMN
	// INTRODUCED** — MEASURED on the `.name` column, whose `struct-backing-name` golden emits the identical
	// unfolded ladder for a `let`-bound receiver. So a fold belongs to that emitter, for all five of its
	// columns at once, and not here. Never a wrong answer either way: the ladder computes the same constant.
	//
	// ⭐ **AND THE CHAIN MAY CONTINUE INTO AN ENUM ACCESSOR** — `t.rawValue.priority.ordinal`, where the field
	// is itself enum-typed. That is the third hop `parseEnumLiteral` already makes for `Op.doubleOp.rawValue`,
	// made here for the same reason: the selected value is the ONE enum value that reaches an accessor without
	// ever being bound to a name, so nothing upstream can route it and the postfix loop would read `.ordinal`
	// as a method call.
	//
	// ⭐⭐ **AND THE CHAIN MAY BE LONGER THAN ONE HOP, BECAUSE A BACKING FIELD MAY ITSELF BE A STRUCT**
	// (`/specs/enum-nested-struct-backing.md`: `op.rawValue.meta.latency`). `resolveEnumBackingLeaf` walks
	// the DECLARED types until it reaches a scalar, and what comes back is a PATH — everything past that
	// point is unchanged, because the leaf is still one machine word that is constant per case.
	function emitEnumBackingFieldSelect(layout EnumLayout, tag ValueId, fieldTok Token, range SourceRange) returns ValueId throws ParseError
		// The leaf's DECLARED type comes through the one door an ordinary field read asks it through
		// (`emitFieldLoad`), so a backing field of a ranged alias arrives tagged exactly as `s.width` on a
		// real record does — which is what makes `return op.rawValue.value` from a `returns Latency` function
		// type-check, and what gives the `named(Priority)` an `.ordinal` hop below needs.
		let leaf = try self.resolveEnumBackingLeaf(try self.requireEnumBackingStruct(layout, anchor: fieldTok), memberTok: fieldTok, path: EnumBackingFieldStepArray.create())
		let fieldType = leaf.fieldType
		let domain = leaf.domain

		// ⛔⛔ **THE SUM MUST BE DECODED INTO THE FIELD'S DOMAIN BEFORE IT IS CLAIMED TO BE OF THE FIELD'S
		// TYPE — `retypeValue` ONLY REWRITES TYPE COLUMNS.** The sum is integer arithmetic
		// (`emitCompareAgainstLiteral` → `mul` → `add`, all `operandType = i64`); the retype then CLAIMS it is
		// the field's type. For the three WORD domains that claim is already true of the bits. For a FLOAT
		// field it is not, and the value reached the backend as an f64 defined by an integer `add` —
		// **MEASURED as a compiler panic**, `X64Backend.maxon:834` *"a register-to-register move from rax to
		// xmm0 crosses register files"*, on `type M  export let r as Real end` + `a = M{r: 1.5}`.
		//
		// ⇒ the same `MaxonUnaryOp.bitsToFloat` REINTERPRETATION `emitEnumRawValue`'s float arm emits, and
		// for its reason: the i64 is the IEEE-754 pattern, so it is reinterpreted and never converted (a
		// `cvtsi2sd` would read the encoding as a magnitude — see that arm for the four wrong answers it
		// produced there).
		//
		// ⚠⚠ **AND THE ORDER IS THE WHOLE FIX: REINTERPRET, THEN CLAIM.** Written as the typed select (which
		// retypes) followed by the bitcast, the operand handed to `bitsToFloat` is already claimed f64 and the
		// panic merely MOVES — MEASURED, `LowerMaxonToStd.maxon:291` *"bitcastI64ToF64 reads an INTEGER
		// operand and was handed Std type f64 … a mismatch here is a front-end bug"*. So the three word
		// domains go through the shared typed select and the float one selects RAW.
		if domainIsEnumBackingFloatBits(domain) 'floatField'
			let bits = try self.emitEnumCaseConstantSelect(layout, tag: tag, column: EnumCaseConstant.structBackingField(leaf.path, domain: domain), anchor: fieldTok, range: range)
			let reinterpreted = self.emitUnaryOp(bits, op: MaxonUnaryOp.bitsToFloat, resultTag: ValueTypeTag.float, range: range)
			// The declared type is restored on the DECODED value, so a field of a ranged-float alias arrives
			// tagged `named(Ratio)` exactly as `emitFieldLoad` mints it - a claim that is now true of an
			// operand genuinely living in an XMM register.
			self.retypeValue(reinterpreted, valueType: fieldType)
			return reinterpreted
		end 'floatField'

		// `checkEnumBackingGroup` refuses an `unsupported` field at the DECLARATION, once per case, whether or
		// not any expression reads it — but a READ can still arrive first (see
		// `enumBackingUnsupportedFieldError`), so the gate below throws rather than asserting. Past it only
		// the three word domains remain, and for each the i64 IS the value: an int (or ranged-int alias), a
		// bool whose payload is 0 or 1, and a PAYLOAD-FREE enum whose value is its tag.
		try self.requireEnumBackingFieldDomainIsAWord(leaf.lastStep(), fieldType: fieldType, domain: domain, anchor: fieldTok)
		let selected = try self.emitEnumCaseTypedSelect(layout, tag: tag, column: EnumCaseConstant.structBackingField(leaf.path, domain: domain), valueType: fieldType, anchor: fieldTok, range: range)

		// A `.name`-shaped member on a leaf that is NOT enum-typed is left where it was: the field may be a
		// `String` with a `.count()`, and only the enum route is this function's to claim. The gates that
		// decide it live in `atEnumAccessorHopOn`, which `parsePostfix` reads too.
		if not self.atEnumAccessorHopOn(selected) 'noAccessorHop'
			return selected
		end 'noAccessorHop'

		let fieldLayout = requireEnumLayout(self.enumMatchFor(selected))

		// The selected leaf is a value of `fieldLayout` — the `enumWord` domain, which
		// `enumBackingNamedFieldDomain` admits only for an UNBOXED declaration, so `emitEnumTagOf` is the
		// identity here. It is still asked rather than assumed: that premise lives at the classifier, and a
		// reader that spelled the conclusion out would be a second copy of it.
		return try self.consumeEnumAccessorHop(fieldLayout, tag: self.emitEnumTagOf(selected, layout: fieldLayout, range: range), anchorTok: fieldTok)
	end 'emitEnumBackingFieldSelect'

	// ⭐ **AN ADDRESS-VALUED ACCESSOR — the selection, then the ONE line that says what was selected.** The
	// sum below is arithmetic and types itself `integer`; the selected words are ADDRESSES — a `.rdata`
	// String record for the two string columns, a `.text` `__fnref_` thunk for the function one — so the
	// result IS a String or a function and this is where it is recorded as one. Written once because `.name`,
	// a string backing's `.rawValue` and a function backing's differ only in the column and in that claim.
	//
	// ⚠ **NOTHING OWNS THE RESULT, AND THAT IS A PROPERTY OF WHAT WAS SELECTED.** Every candidate is an
	// IMMORTAL literal record (`capacity = -2`, never allocated, refcounted or dropped) or a code address,
	// so the selected one is too — which is what lets `return sh.name` hand it straight out of the function,
	// exactly as `return "circle"` does.
	function emitEnumCaseTypedSelect(layout EnumLayout, tag ValueId, column EnumCaseConstant, valueType MaxonType, anchor Token, range SourceRange) returns ValueId throws ParseError
		let selected = try self.emitEnumCaseConstantSelect(layout, tag: tag, column: column, anchor: anchor, range: range)
		self.retypeValue(selected, valueType: valueType)
		return selected
	end 'emitEnumCaseTypedSelect'

	// ⭐⭐ **THE NAME THAT GOVERNS A FUNCTION-BACKED ENUM'S `.rawValue` — THE FIRST CASE'S FUNCTION, AND THAT
	// IS A TYPE CLAIM RATHER THAN AN IDENTITY ONE.** A function value's `MaxonType.function(id)` names
	// whatever DECLARES its signature (see MaxonType's `function` arm) — the function it refers to, or the
	// typealias the place was written with — and every reader of it asks exactly one question: what shape may
	// this be called at? `.rawValue` yields ONE value for n cases, so it needs ONE such name, and the first
	// case's function is a name that already resolves in `funcSignatures` whole-program, in every file, for a
	// forward reference as much as a backward one.
	//
	// ⚠ **IT IS ONLY TRUE BECAUSE THE CASES ARE MADE TO AGREE, AND THAT PREMISE IS ENFORCED, NOT ASSUMED** —
	// `Parser.checkFunctionBackedCase` records every later case against this one as a `PendingFunctionTypeDoor`
	// and `SemanticCheck.checkFunctionTypeDoors` refuses a disagreement. Without that check this would be a
	// lossy key standing in for an identity: `Op.tripleOp.rawValue` would be called at `doubleFn`'s shape.
	//
	// ⭐ **A DEPARTURE FROM v1, WHICH INTERNS A STRUCTURAL SIGNATURE ID** (`EnumType.functionBackingTypeId`,
	// `TypeResolution.resolveFunctionBackedEnumRefs`). shv2 has no signature-id registry — a function type is
	// carried by the NAME of something that declares it — so minting a synthetic alias would have meant
	// writing that name into two registries (the parse-time `ProgramSignatures` and the post-merge
	// `functionAliasShapes`) to say what a name already in both says.
	//
	// That case 0 exists at all is the backing's own property, argued and enforced once in
	// `enumCaseFunctionName` rather than assumed here.
	function enumFunctionBackingGoverningName(layout EnumLayout) returns TypeNameId
		return self.artifact.typeNames.intern(self.enumCaseFunctionName(layout, index: FirstCaseIndex))
	end 'enumFunctionBackingGoverningName'

	// ⭐⭐ **THE TAG→CONSTANT MAPPING EVERY ENUM ACCESSOR NEEDS — `Σᵢ constantᵢ × (tag == tagᵢ)`, BRANCHLESS.**
	// `enum Code { ok = 5 }` has ordinal 0 and tag 5, so on that route the tag is NOT the answer and the
	// answer has to be computed from it; a case NAME is never the tag at all. Exactly one of the comparisons
	// holds — an enum value is one of the declared tags, the same closure `match`'s exhaustiveness rests on
	// (nothing in the language mints an enum value except a case construct, a match binding, or a value that
	// came from one) — so the sum is that case's constant and every other term is zero.
	//
	// ⭐⭐ **ONE EMITTER FOR THREE ACCESSORS, AND THE THREE ARE THE SAME QUESTION.** It was `.ordinal`'s alone
	// (`emitEnumOrdinalLookup`) while the other two were unbuilt, and the note beside `EnumOrdinalMemberName`
	// argued that a NAME would need a different mechanism — "a value materialized on the selected edge".
	// That reading was wrong in a way worth recording: an immortal `.rdata` String is a machine word that is
	// CONSTANT PER CASE, exactly as a declaration index is, so it sums identically and needs no edge and no
	// merge. `EnumCaseConstant` is the whole of what varies.
	//
	// It takes the TAG, not the receiver: `parseEnumAccessor` has already answered where the tag lives (the
	// value itself, or a load out of a boxed union's offset 0), and both forms are the bare i64 the compares
	// below read. So this function needs to know nothing about boxing, and cannot get that question wrong.
	//
	// ⭐ **STRAIGHT-LINE, NOT A COMPARE/BRANCH CHAIN, AND THAT IS WHY IT CAN LIVE IN AN EXPRESSION AT ALL.**
	// A branch chain would have to fork mid-expression and merge n arms through a phi (`finalizeMatchMerge`'s
	// machinery), which is the apparatus a `match` EXPRESSION pays for because its arms run user code. Here
	// every arm is a constant, so the selection is arithmetic: a compare materializes its own 0/1
	// (x64 `setcc`+`movzx`, arm64 `cset`, wasm's i32 result zero-extended by `coerceOnStack`), one `mul`
	// scales it by the index, one `add` accumulates. Three ops per case, no blocks, no merge, and the whole
	// thing is an ordinary operand wherever `s.ordinal` was written.
	//
	// ⚠ **IT IS LINEAR IN THE CASE COUNT, PER READ, AND THAT IS THE ACCEPTED COST.** It is the shape v1 emits
	// (`LowerMaxonToStd.lowerEnumOrdinalLookup`) and the one `EnumLayout.indexOfCase` already argues for —
	// case counts are tiny — and the alternative shapes each buy less than they cost: a per-enum helper
	// FUNCTION trades n compares for a call/ret whose prologue outweighs the work at these sizes (the
	// argument `CheckedDivisionRuntime`'s header makes for expanding a checked divide in place), and a table
	// lookup keyed by TAG cannot be indexed by one — `200`/`404`/`500` is exactly the case that reaches here.
	//
	// ⭐⭐ **THE COMPARE IS THE i64 IDENTITY COMPARE ON THE TAG FOR EVERY BACKING, INCLUDING FLOAT — A
	// DELIBERATE DEPARTURE FROM v1, WHICH USES `cmpF64Eq` THERE.** `.ordinal` asks WHICH CASE this is, and
	// shv2 answers that question in exactly one way everywhere else: an i64 compare against the tag column
	// (`EnumLayout`'s header — a float-backed case's tag is its IEEE-754 bit pattern, and `match` dispatches
	// on it with no float register class). Routing this through the same `emitCompareAgainstLiteral` the match
	// dispatch uses is what makes the accessor and the `match` unable to disagree about which case a value is.
	// It is also strictly the more correct compare: IEEE equality identifies `+0.0` with `-0.0`, which are two
	// DISTINCT declarable cases here (`rawValueCollidesAt` compares tags, so it admits both) — under an f64
	// compare `low = 0.0  negLow = -0.0` answers ordinal 1 for BOTH, and under the tag compare each answers
	// its own index.
	function emitEnumCaseConstantSelect(layout EnumLayout, tag ValueId, column EnumCaseConstant, anchor Token, range SourceRange) returns ValueId throws ParseError
		var selected = self.emitLiteral(FirstCaseOrdinal, valueType: MaxonType.integer, range: range)

		for i in firstSummedCaseIndex(column) upto layout.caseCount() 'eachSummedCase'
			// ⚠ **THE COMPARE'S RESULT IS RE-RECORDED AS A NUMBER, AND THE WIDTH CHANGE IS THE POINT.** The
			// mint types it `boolean` (i1 at Std) because that is what every other caller of that door feeds a
			// branch with; here the 0/1 is an arithmetic OPERAND. Left `boolean` it does not reach the machine
			// at all — `bool` is its own `TypeClass` and not `numeric`, so `requireBinOpOperands` refuses the
			// multiply outright — and past that gate `appendStdBinOp` would take the multiply's operand type
			// from this very value and ask for an i1 one. `integer` is the value's true type on this path
			// (`TypeRules.BoolTrueValue` is 1), it is minted one line above so no other reader can hold the
			// old claim, and the three backends each hand back a zero-extended machine word (see the header),
			// so the widened claim is one they already satisfy.
			let isThisCase = self.emitCompareAgainstLiteral(tag, literal: layout.tagOfIndex(i), op: MaxonCmpOp.eq, opTok: anchor)
			self.retypeValue(isThisCase, valueType: MaxonType.integer)

			let caseConstant = try self.emitEnumCaseConstant(layout, index: i, column: column, anchor: anchor, range: range)
			let contribution = try self.emitBinOp(isThisCase, rhs: caseConstant, op: MaxonBinOp.mul, opTok: anchor)

			selected = try self.emitBinOp(selected, rhs: contribution, op: MaxonBinOp.add, opTok: anchor)
		end 'eachSummedCase'

		return selected
	end 'emitEnumCaseConstantSelect'

	// ⭐ **ONE CASE'S CONSTANT, AS AN `integer`-TYPED OPERAND THE SUM ABOVE CAN MULTIPLY.** A declaration
	// index already is a number; a `.rdata` String record and a `.text` function address are ADDRESSES, which
	// are numbers too — so the only thing the three ADDRESS columns need is for the value's TYPE COLUMN to
	// say so, which is the `retypeValue` below.
	//
	// ⚠ **RETYPING THE LITERAL IS SAFE HERE AND NOWHERE ELSE**: the value was minted one line above, names no
	// binding and has no other reader, so the claim cannot be stale for anybody. The op it defines is
	// untouched — a `stringLiteral` still lowers to the record's address and a `functionRef` to the thunk's —
	// and both claims agree at the Std tier, where a String, a code pointer and an `integer` are the same
	// i64. `emitEnumCaseTypedSelect` restores the real claim on the SUM, which is the value a program
	// actually reads.
	//
	// ⭐⭐ **THE FUNCTION COLUMN EMITS A REAL `functionRef` OP, AND THAT IS LOAD-BEARING TWICE OVER.** A
	// hand-built address constant would be the same 64 bits and would still be wrong: `collectFnRefThunkTargets`
	// scans for exactly this op to decide which `__fnref_` thunks to synthesize, and `DeadFunctionElimination`
	// roots the target off the `funcAddr` it lowers to. Emitted as a constant instead, the thunk would never
	// exist and the function would be stripped. It goes through `emitFunctionRef` rather than around it so the
	// case's target meets the same three gates `let f = doubleFn` meets, at a token positioned on the accessor.
	//
	// ⚠ **A FULL MATCH, FOR `firstSummedCaseIndex`'s STATED REASON AND NOT MERELY FOR SYMMETRY.** These are
	// the TWO per-column deciders `EnumCaseConstant` has, and they must refuse an unclassified column
	// ALIKE — an `if` chain ending in an `else` over `caseRawValues` would hand a fifth column the raw-value
	// bytes silently, which is a wrong answer where the sibling gives a compile error, and nothing routes an
	// author from that compile error to this function.
	function emitEnumCaseConstant(layout EnumLayout, index CaseIndex, column EnumCaseConstant, anchor Token, range SourceRange) returns ValueId throws ParseError
		// ⚠ **EVERY ARM RETURNS, AND THE `var bytes` IT REPLACES WAS A PER-CASE ALLOCATION TWO ARMS NEVER
		// READ.** The seed `ByteArray.create()` sat above the match, so an empty array was allocated and
		// discarded ONCE PER CASE IN THE SUM for every `.ordinal` and every function-backed `.rawValue` — in a
		// file that prices allocations at exactly this granularity, on a path the fourth column had just
		// widened. Each column now names its own producer instead, which costs the exhaustive match nothing:
		// all five arms are still named here, so a sixth still fails to compile.
		match column 'c'
			declarationIndex then return self.emitLiteral(index, valueType: MaxonType.integer, range: range)
			caseName then return self.emitEnumCaseStringConstant(layout.caseNameAt(index), range: range)
			declaredRawValue then return self.emitEnumCaseStringConstant(layout.rawValueAt(index).toByteArray(), range: range)
			caseFunctionRef then return try self.emitEnumCaseFunctionConstant(layout, index: index, anchor: anchor)
			structBackingField(path, domain) then return self.emitLiteral(try self.enumBackingFieldConstant(layout, index: index, path: path, domain: domain, anchor: anchor), valueType: MaxonType.integer, range: range)
		end 'c'
	end 'emitEnumCaseConstant'

	// ⭐⭐ **CASE `index`'s NUMBER FOR BACKING FIELD `field` — the whole of what the DECLARATION deferred.**
	// The case reader could not resolve either half of this (it runs inside the sweep that builds the index),
	// so both are answered here: WHICH written entry fills the field, and what NUMBER that entry denotes.
	//
	// ⭐ **AN UNLABELLED FACTORY ARGUMENT IS MATCHED BY POSITION AND A LABELLED ONE BY NAME**, which is the
	// rule `readEnumBackingFields`' header measures off both references: `OpInfo.create(1, throughput: 1)`
	// fills field 0 from argument 0 and `throughput` from the label. A brace literal labels every field, so
	// it only ever takes the name route.
	//
	// ⭐⭐ **AND IT FOLLOWS THE PATH, ONE GROUP PER HOP.** The read resolved which leaf is meant; this asks
	// which entry of THIS case fills each hop, descending into the group that entry owns until the last hop
	// answers with a number.
	function enumBackingFieldConstant(layout EnumLayout, index CaseIndex, path EnumBackingFieldStepArray, domain EnumBackingFieldDomain, anchor Token) returns ParsedInt throws ParseError
		let written = layout.backingFieldsAt(index)
		var group = RootBackingGroup

		for hop in 0 upto path.count() 'eachHop'
			let step = try path.get(hop) otherwise panic("enumBackingFieldConstant: path.get OOB at {hop} below count {path.count()} for case '{String.from(layout.caseNameAt(index))}' of `{layout.kindWord()} {String.from(layout.name)}`")
			let entry = try self.requireEnumBackingEntryFilling(written, group: group, step: step, layout: layout, index: index, anchor: anchor)
			if hop + 1 == path.count() 'theLeafItself'
				return try self.enumBackingFieldNumber(enumBackingEntryAt(written, entry: entry).value, step: step, domain: domain, anchor: anchor)
			end 'theLeafItself'

			group = nestedBackingGroupOf(entry)
		end 'eachHop'

		panic("enumBackingFieldConstant: the path handed here is EMPTY for case '{String.from(layout.caseNameAt(index))}' of `{layout.kindWord()} {String.from(layout.name)}` — `resolveEnumBackingLeaf` pushes one step per hop before any exit, so a read cannot produce a column with no hops")
	end 'enumBackingFieldConstant'

	// ⭐⭐ **WHICH ENTRY OF THIS CASE FILLS ONE HOP** — a LABELLED entry by its name, an UNLABELLED one by its
	// position, and only ever among the entries that belong to the same group. Both spellings may appear in
	// one group (`OpMeta.create(4, isMemory: true, isCall: false)`), which is why neither test alone answers.
	//
	// ⚠ **THE RULE AND ITS DIAGNOSTIC ARE ONE FUNCTION**, `requireFieldIndex`'s shape and for its reason: the
	// only caller wants the entry, and "this case wrote nothing here" is the one thing to say when there is
	// none. See `enumBackingMissingFieldError` for why this copy throws rather than asserting — a file that
	// READS the enum can be parsed before the door that would have reported the gap.
	function requireEnumBackingEntryFilling(written EnumBackingFieldArray, group EnumBackingGroupId, step EnumBackingFieldStep, layout EnumLayout, index CaseIndex, anchor Token) returns EnumBackingEntryIndex throws ParseError
		for entry in 0 upto written.count() 'eachWrittenField'
			if enumBackingEntryFills(enumBackingEntryAt(written, entry: entry), group: group, field: step.field, fieldName: step.fieldName) 'thisHop'
				return entry
			end 'thisHop'
		end 'eachWrittenField'

		// ⚠ **NOT `unknownField`, WHICH WOULD BE A FALSE SENTENCE.** The struct DOES declare this field —
		// `resolveEnumBackingLeaf` looked it up to get here — and what is missing is THIS CASE's value for it.
		// It was `unknownField` for one edit, and on `a = Meta{value: 1}  b = Meta{value: 2, cost: 5}` it said
		// *"type 'Meta' has no field named 'cost'"* about a type that declares `cost` on the line above.
		throw self.enumBackingMissingFieldError(step.ownerName, fieldName: step.fieldName, layout: layout, index: index, anchor: anchor)
	end 'requireEnumBackingEntryFilling'

	// The STRUCT a `structRecord` backing names, or the diagnostic that no file declares it. Refused HERE and
	// not at the declaration for the reason the whole backing is deferred: the case reader runs inside the
	// sweep that is still building the registry this asks.
	function requireEnumBackingStruct(layout EnumLayout, anchor Token) returns StructLayout throws ParseError
		match self.signatures.structOf(layout.backingStructName) 'declaring'
			declared(struct) then return struct
			undeclared then throw ParseError.undefinedVariable(String.from(layout.backingStructName), line: anchor.line, column: anchor.column)
		end 'declaring'
	end 'requireEnumBackingStruct'

	// ⭐ **THE NUMBER ONE WRITTEN FIELD VALUE DENOTES.** A literal already folded to its bits at the
	// declaration; an enum-member reference is the one form that could not, because a case's TAG is a
	// whole-program fact (see `EnumBackingFieldValue.enumCase`).
	//
	// ⚠ **AND A NESTED CONSTANT DENOTES NO NUMBER AT ALL, WHICH IS A DIAGNOSTIC AND NOT AN ASSERTION.** It
	// arrives only when the case wrote a record where the field's DECLARED type is a scalar — which
	// `requireEnumBackingFieldValueSuitsField` refuses at the declaration, in a fuller sentence. It is not
	// asserted here for the reason `enumBackingUnsupportedFieldError` records: a file that READS the enum can
	// be parsed before the one that declares it, so the door may not have run yet.
	function enumBackingFieldNumber(value EnumBackingFieldValue, step EnumBackingFieldStep, domain EnumBackingFieldDomain, anchor Token) returns ParsedInt throws ParseError
		match value 'form'
			literal(bits, kind) then return enumBackingLiteralBits(bits, kind: kind, domain: domain)
			enumCase(enumName, caseName) then return try self.enumBackingFieldCaseTag(enumName, caseName: caseName, anchor: anchor)
			nestedStruct(structName) then throw ParseError.unsupported("a nested `{String.from(structName)}` constant written for field '{String.from(step.fieldName)}' of the `{String.from(step.ownerName)}` backing, which this read selects as a single word — a nested constant fills a field whose OWN declared type is that `type`, and this field's is not, so there is no number for the select to take", line: anchor.line, column: anchor.column)
		end 'form'
	end 'enumBackingFieldNumber'

	// `Priority.low` as a backing field value — the two names the declaration recorded, resolved against the
	// completed index. Both failures are the ordinary ones a `Priority.low` written in an EXPRESSION would
	// get, worded by the same two constructors, so a typo in a backing reads like a typo anywhere else.
	function enumBackingFieldCaseTag(enumName ByteArray, caseName ByteArray, anchor Token) returns ParsedInt throws ParseError
		let referenced = self.signatures.enumOf(enumName)
		if not enumMatchIsDeclared(referenced) 'noSuchEnum'
			throw ParseError.undefinedVariable(String.from(enumName), line: anchor.line, column: anchor.column)
		end 'noSuchEnum'

		let referencedLayout = requireEnumLayout(referenced)
		if not referencedLayout.hasCase(caseName) 'noSuchCase'
			throw ParseError.enumUnknownCase(referencedLayout.kindWord(), caseName: String.from(caseName), line: anchor.line, column: anchor.column)
		end 'noSuchCase'

		// The TAG, not the ordinal — an enum value IS its tag (`parseEnumLiteral`), so this is the same 64 bits
		// the source expression `Priority.low` would have emitted, and a `.ordinal` chained onto the selected
		// value reaches the ordinary accessor with the ordinary tag.
		return referencedLayout.tagOfCase(caseName)
	end 'enumBackingFieldCaseTag'

	// The `.rdata` record address of `bytes`, as an `integer`-typed word the sum can multiply — the two STRING
	// columns' half of the retype `emitEnumCaseConstant`'s header argues for, and the twin of
	// `emitEnumCaseFunctionConstant` below. Two producers rather than one shared tail because the columns mint
	// their word through different emitters, and the retype's safety argument is about the value each one has
	// just minted.
	function emitEnumCaseStringConstant(bytes ByteArray, range SourceRange) returns ValueId
		let literal = self.emitStringLiteral(bytes, range: range)
		self.retypeValue(literal, valueType: MaxonType.integer)
		return literal
	end 'emitEnumCaseStringConstant'

	// Case `index`'s backing function as an `integer`-typed word the sum can multiply — its `__fnref_` thunk
	// address, minted by the ONE producer of a function value (see `emitEnumCaseConstant`'s header for why it
	// must be that producer and not a constant). It is the function column's half of the retype above rather
	// than a share of it, because the two columns mint their word through different emitters and the retype's
	// safety argument is about the value each one just minted.
	function emitEnumCaseFunctionConstant(layout EnumLayout, index CaseIndex, anchor Token) returns ValueId throws ParseError
		let reference = try self.emitFunctionRef(self.enumCaseFunctionToken(layout, index: index, anchor: anchor))
		self.retypeValue(reference, valueType: MaxonType.integer)
		return reference
	end 'emitEnumCaseFunctionConstant'

	// ⭐ **`<arrayBinding> . managed . <member>(` — the CHAINED spelling, for the two positions where a bare
	// `arr.managed` denotes nothing a program can want.** A STATEMENT of it would build a buffer reference and
	// discard it on the same line; a `try` TARGET needs a throwing CALL to be the target at all, and a bare
	// `.managed` throws nothing. Both would be accepted-and-useless under the widened rule, so both ask for
	// the member call and the EXPRESSION door (`parseDottedPrimary`) asks the rule itself.
	//
	// It is the widened predicate `and` one conjunct rather than a second copy of the base/scope/element
	// tests: the day the base rule changes, there is one place it changes.
	function arrayManagedMemberCallAt(index TokenIndex) returns bool
		return self.arrayManagedFieldAt(index) and self.memberCallFollows(index + 3)
	end 'arrayManagedMemberCallAt'

	function methodCallsAt(index TokenIndex) returns bool
		// The BASE is anything `tokenCanBeAName` admits, which subsumes both the identifier and the `self`
		// keyword this used to name explicitly, and adds a KEYWORD-named binding (D8 — `type.method()` where
		// `type` is a parameter). Widening it claims no new program on its own: the SCOPE test below is the
		// predicate (see the header), and a keyword only ever names a binding because a declaration made it one.
		if not tokenCanBeAName(self.tokenAt(index)) 'notABase'
			return false
		end 'notABase'
		// The `. <member> (` TAIL asks the shared `memberCallFollows`, which spells the member half through
		// `namesMemberAt` and so admits a keyword-named member (D8) — `c.to()` routes here rather than falling
		// through to the type-bound reading, exactly as `c.next()` does. It is the same predicate the chain
		// walk and every other `<base> . <member> (` dispatcher read, for their stated reason.
		if not self.memberCallFollows(index + 1) 'notADottedCall'
			return false
		end 'notADottedCall'
		// A LOCAL receiver, a CAPTURED enclosing one (`b.doubled()` inside a closure — P1.5-A2b-2), or a
		// top-level MANAGED BINDING (`Live.count()` — P1.7a; `msg.append("!")` — P1.7 slice 2a). Each is a
		// VALUE the method dispatches on, which is what separates it from a static call on a TYPE name. The
		// managed binding is asked LAST because it is the only one of the three that can allocate (see
		// `managedTopLevelBaseAt`), and a local or captured base has already answered by then.
		//
		// ⚠ **THAT ORDER IS ALSO THE SHADOWING RULE, AND IT MUST MATCH `parseMethodCall`'S ARMS EXACTLY.**
		// Cheapest-first and local-then-capture-then-top-level happen to agree here, which is what makes the
		// agreement easy to break: a reorder for cost alone would silently re-point a name that a closure
		// captures at a same-named global. `parseMethodCall` carries the measurement of what that cost —
		// two resolutions of one name in one expression, neither a compile error.
		//
		// ⚠ The managed binding is ALSO the only one of the three whose name can belong to a declared
		// TYPE as well — which is why it, alone, has to weigh itself against the type-based readings of
		// this same shape (`staticCallClaimsBase`) rather than simply claiming it.
		let baseTok = self.tokenAt(index)
		if self.baseNamesAValueInScope(baseTok) 'localOrCaptured'
			return true
		end 'localOrCaptured'

		// The GATE first and the resolution second, in that order and never fused: the gate is a bool and
		// allocates nothing, and everything past it boxes a union (see `managedTopLevelBaseAt`). A
		// LOOKAHEAD can only answer yes/no anyway — it runs at token shapes the parser has not committed
		// to, so there is nowhere to hand a resolution even if it had one.
		if not self.managedTopLevelBaseAt(index) 'notAManagedBase'
			return false
		end 'notAManagedBase'

		return match self.managedReceiverBindingOf(baseTok) 'managed'
			constant to global gives true
			none gives false
		end 'managed'
	end 'methodCallsAt'

	// **The token shape of A VOID STATIC CALLED FOR ITS EFFECT** — `<type> . <member> (`, the qualified call
	// shapes that ARE statements (see the `voidStaticStmt` arm for why the others are not). Four families
	// reach it: `__Builtins.sleep(ms)`, `__ManagedFile.statFree(buffer)`, ANY declared void static (D10, the
	// index arm below), and a member of a declared struct that resolves to nothing — claimed so it is refused
	// by NAME rather than by shape.
	//
	// It asks the intrinsic table's OWN question, `isBuiltinsIntrinsicCallee`, of the name `parseQualifiedCall`
	// is about to mangle out of these same two tokens — rather than comparing the base token against a second
	// spelling of `__Builtins`. A second spelling is how the statement door and the intrinsic table would come
	// to disagree about which qualifier belongs to the compiler, and the failure would be silent in the worst
	// direction: a statement accepted here and then rejected as an unknown intrinsic three functions later.
	//
	// ⚠⚠ **THE NAME IS BUILT BY THE SAME EXPRESSION `parseQualifiedCall` USES — `genericAliasKeyFor` AND
	// `denotedGenericBaseName`, BOTH — and neither call is decoration.** Deriving the callee here from the BARE
	// base token agrees with the real parse only for as long as those two are jointly the identity on every
	// name that can reach this shape, and **that premise HAS ALREADY FAILED ONCE**: this comment used to claim
	// it "true today" of the base resolution alone, and W7 then taught `parseQualifiedCall` to read an INNER
	// alias under its base-qualified key without teaching this door, so one written name meant two things. The
	// premise is not restated as safe here — it is REMOVED, by making both doors read the one key. Two
	// derivations of one name is the duplication this predicate was written to avoid.
	//
	// The mangling allocates, and it is on a COLD path by construction: the shape is asked only after every
	// cheaper statement form has declined, and `methodCallsAt` has already claimed every qualified shape whose
	// base is a value in scope — so what reaches here is a static-call-shaped statement, which is either an
	// intrinsic or a program that is about to be refused.
	//
	// ⚠⚠ **`__ManagedFile.statFree(buffer)` IS THE SECOND FAMILY, AND WITHOUT IT `stat` COULD NOT BE USED AT
	// ALL (found in review, R4.2).** It is the only `__ManagedFile` static that is BOTH void and NON-throwing,
	// so a statement is the only position it can ever be written in — the void-and-throwing pair
	// (`delete`/`rename`) always arrives under a `try`, which is its own statement form. Left out, the
	// canonical spelling `stdlib/File.maxon:186` uses verbatim died as
	// `E2015: Unsupported: identifier statement` — and since `stat` hands back a raw `__mm_alloc` block that
	// only `statFree` can release, EVERY successful `stat` then leaked it and the program exited 101. MEASURED
	// both ways: the refusal at `:7:2`, and exit 101 with the correct field values printed.
	// (This is `__Builtins.sleep`'s history repeating exactly — see the arm — and for the same structural
	// reason: a VOID member of a family whose other members all return a value.)
	//
	// ⚠ **THE MEMBER HALF ASKS `namesMemberAt`, NOT A RAW `TokenKind.identifier` (D8).** A static may be
	// DECLARED under a keyword — `export static function to()` — and expression position already calls it
	// (`let x = Helper.to()` compiles and runs, measured). A raw kind test here refused the identical name in
	// STATEMENT position as `E2015: Unsupported: identifier statement` while the oracle compiled and ran it,
	// which is the very asymmetry this door was widened to remove, one level down. Since the A1s-prim review it
	// is asked through `memberCallFollows` — the ONE spelling of the `. <member> (` tail that `methodCallsAt`,
	// `isSelfMethodCallAt` and `primitiveStaticCallAt` also read — so a new member-naming token is taught to
	// every dispatcher at once rather than to three of four.
	//
	// The BASE half stays a plain identifier because a keyword cannot NAME a *declared* type: `type to` is
	// refused at its declaration (`E2010: Expected identifier but got 'to'`). `parseQualifiedCall` reads
	// its base through `typeBaseTokenAt`, which resolves two keywords — `Self` and, since A1s-prim, the
	// primitive-type names — so widening this half would claim a shape the routine CAN parse but no
	// STATEMENT wants: `Self.m()` and `int.fromString(s)` are refused as statements exactly as
	// `Point.create()` is, a static call discarding its result. Every primitive static returns a value, so
	// none of them needs this door; widen it when one that does not appears.
	function voidStaticCallsAt(index TokenIndex) returns bool
		if self.kindAt(index) != TokenKind.identifier or not self.memberCallFollows(index + 1) 'notAQualifiedCall'
			return false
		end 'notAQualifiedCall'

		if self.tokenAt(index).value.equals(ManagedFileTypeName) and self.tokenAt(index + 2).value.equals(ManagedFileStatFreeMethod) 'statFree'
			return true
		end 'statFree'

		// The base name is resolved ONCE and threaded to both readings below — the callee mangle and the
		// declared-type claim. `denotedGenericBaseName` is a registry lookup that can allocate, and two calls
		// on one token are two derivations of one name, which is the drift this predicate's header is about.
		//
		// ⛔ **THROUGH `genericAliasKeyFor`, AND THE HEADER'S OWN PREMISE IS WHY (W7 review).** That premise —
		// *"agrees with the real parse only for as long as `denotedGenericBaseName` is the identity on every name
		// that can reach this shape … exactly the kind of premise that quietly stops holding"* — stopped holding
		// the moment `parseQualifiedCall` began resolving an INNER alias under its base-qualified key. Reading
		// the bare member here made THIS door the fifth reader of "which registration does this spelling
		// denote", and the two doors then disagreed about one written name. MEASURED on one binary: with
		// `typealias IntPair = Pair with ExitCode` at FILE scope, `IntPair.shout()` as a statement compiled and
		// ran; with the identical alias declared INSIDE the calling type it was
		// `E2015: Unsupported: identifier statement`, while `let p = IntPair.create(9)` one line below resolved
		// perfectly — a call accepted at one door and refused at the other, which is the exact failure this
		// predicate's header names. `staticCallClaimsBase` asks the same key for the same reason.
		let baseName = self.signatures.denotedGenericBaseName(self.genericAliasKeyFor(self.tokenAt(index).value), readerFilePath: self.filePath)
		let callee = qualifiedMethodName(baseName, methodName: self.tokenAt(index + 2).value)
		if isBuiltinsIntrinsicCallee(callee) 'builtinsIntrinsic'
			return true
		end 'builtinsIntrinsic'

		// ⭐ **THE SECOND BUILTIN TYPE, ON THE SAME TERMS (Workstream O3).** `__DebugStream`'s four emitting
		// members return nothing, so a bare statement is the only position they can be written in — and the
		// compiler's own emitters write exactly that (`Logger.logEvent`, `PhaseProbe.begin`). Without this arm
		// they died as `E2015: Unsupported: identifier statement`, which is `__Builtins.sleep`'s history
		// repeating for the third time and for the same structural reason: a VOID member of a family whose
		// other members all return a value.
		//
		// ⚠ **THE QUALIFIER IS THE TEST, NOT A ROSTER OF THE VOID FOUR**, which is `isBuiltinsIntrinsicCallee`'s
		// rule above and D10's finding one type over: claiming the whole family is what routes an unrecognized
		// member to `parseCallNamed` and so to the positioned `E3004` that NAMES it, instead of a refusal about
		// SHAPE that says nothing about the name. `nameId` is claimed too and its value is then discarded,
		// exactly as a `__Builtins` value-returning intrinsic's is here — an intrinsic allocates nothing, so
		// there is no box for a bare statement to strand.
		if isDebugStreamCallee(callee) 'debugStreamMember'
			return true
		end 'debugStreamMember'

		// ⭐ **A USER TYPE'S VOID STATIC — the same position, asked of the whole-program index instead of a
		// table (D10).** `Helper.shout()` on a line of its own was `E2015: Unsupported: identifier statement`
		// while `__Builtins.sleep(ms)` two arms up was accepted, and the asymmetry was not a rule — it was
		// which callees happened to have a recognizer. The oracle compiles and runs the user form (measured:
		// prints, exit 0), so shv2 was refusing a correct program.
		//
		// ⚠ **VOID IS THE WHOLE CONDITION, and the reason is the one this arm's own dispatch site states**:
		// a value-returning static is refused here because it discards a box nothing would then free, which
		// is a LEAK argument. It does not reach a void static — there is no value to discard, and the call is
		// the entire point of writing it. So this asks the index for the callee's return type and accepts
		// only `void`; a value-returning `Point.create()` still falls through to the same refusal it always
		// had, unchanged.
		//
		// ASKED LAST, after both cheap compiler-owned arms, because `returnTypeOf` ADOPTS the return type
		// into this file's interner and so allocates — on a path already documented as cold by construction
		// (every cheaper statement form has declined, and `methodCallsAt` has taken every qualified shape
		// whose base is a value in scope).
		//
		// ⚠ **BOTH ARMS BELOW READ A COMPLETE INDEX, AND THE REASON IS NOT `constructorInstanceOf`'S.** That
		// one is written for a reader the TOLERANT SWEEP reaches, and answers "the sweep's artifact is
		// discarded". This predicate is not such a reader: the sweep entry point is
		// `foldDeclaredSignaturesInto`, which reads DECLARATIONS only and never a body — "a sweep types no
		// call", as `Queries.queryProgramSignatures` puts it — and the constant evaluator's parser walks an
		// INITIALIZER. `parseStatement` is reached from `parseModule` alone, and `queryProgramSignatures`
		// sets `allFilesFolded` before the first file is parsed. So an `undeclared` here MEANS no file
		// declares the callee; it never means "not swept yet", and neither arm can answer differently
		// depending on how far a sweep had got.
		match self.signatures.returnTypeOf(callee, into: self.artifact.typeNames) 'declaredStatic'
			declared(returnType) then return maxonReturnTypeIsVoid(returnType)
			undeclared then break 'declaredStatic'
		end 'declaredStatic'

		// ⭐⭐ **AN UNKNOWN MEMBER ON A DECLARED TYPE IS CLAIMED TOO — SO IT CAN BE REFUSED BY NAME RATHER
		// THAN BY SHAPE.** `Helper.nope()` is not a void static, so the arm above declined it; left to fall
		// through, it died as `E2015: Unsupported: identifier statement` — and THAT MESSAGE BECAME FALSE THE
		// MOMENT THIS RUNG LANDED. The construct IS supported now; it is the NAME that is wrong, and E2015
		// says nothing about a name. Claiming the shape here routes it to `parseCallNamed`, which reports the
		// positioned **E3004 `call to undefined function 'Helper.nope'`** — the identical answer EXPRESSION
		// position already gives for the same typo, and the identical answer `__Builtins.nope()` already gets
		// in THIS position (measured both ways). The compiler-owned half was never refused by shape; this is
		// the user half catching up, which is the same asymmetry the void arm above closes.
		//
		// ⚠ **A VALUE-RETURNING static is NOT claimed, and that is deliberate rather than an oversight.** It
		// is `declared` with a non-void return, so the arm above returns false and it keeps the refusal it has
		// always had. Whether a bare `Point.create()` should instead be a discard (`_ =`) is a different
		// question with a leak argument behind it — see the dispatch site — and this rung does not answer it.
		// ⇒ what moves here is exactly one case: a member NO file declares, from a refusal about SHAPE to a
		// refusal about the NAME. Pinned by `static-method-statement.error.unknown-static-names-the-callee`.
		return self.signatures.containsStruct(baseName)
	end 'voidStaticCallsAt'

	// The kind of the token ONE past the cursor. The parser's two-token lookahead:
	// distinguishing a reassignment (`ident =`) from a bare identifier statement (`ident …`)
	// needs to see the `=` without committing to consuming the identifier first — and it is
	// the same question `assignedBindingsIn` asks of every token in a loop's extent, which is why
	// both read it through `kindAt` and the past-the-end rule lives in exactly one place.
	function peekKind() returns TokenKind
		return self.kindAt(self.pos + 1)
	end 'peekKind'

	function isEof() returns bool
		return self.at(TokenKind.eof)
	end 'isEof'

	function advance()
		if self.pos < self.tokens.count() 'inRange'
			self.pos = self.pos + 1
		end 'inRange'
	end 'advance'

	// Consume a token of the expected kind, or throw a positioned mismatch error.
	// A TokenKind's `.rawValue` is its human-readable display text ("(", "return").
	// ⭐⭐ **THE LAYOUT RULE EVERY LABELLED BLOCK OPENER ASKS, AND NONE OF THEM RESTATES.** A block's
	// label is the last thing on its line: `if`, `else`, `while`, `for`, `match` and both `try` forms
	// open one, and a rule spelled at seven sites is a rule that drifts at six of them. shv2 enforced it
	// NOWHERE until this call existed — `while i < 1 'w' i = i + 1 end 'w'` compiled and ran, measured on
	// the same binary that refused nothing about it.
	function requireNewlineAfterBlockLabel() throws ParseError
		if self.at(TokenKind.newline) 'endsItsLine'
			return
		end 'endsItsLine'

		let got = self.current()
		throw ParseError.expectedNewlineAfterBlockLabel(tokenDisplayText(got), line: got.line, column: got.column)
	end 'requireNewlineAfterBlockLabel'

	function consume(kind TokenKind) returns Token throws ParseError
		let tok = self.current()
		if tok.kind != kind 'mismatch'
			throw ParseError.unexpectedToken(kind.rawValue, got: tokenDisplayText(tok), line: tok.line, column: tok.column)
		end 'mismatch'
		self.advance()
		return tok
	end 'consume'

	// ⭐ **CONSUME A TOKEN IN A POSITION WHERE ONLY A NAME MAY STAND (D8)** — a declaration's name, a
	// parameter's name, a callee/method name, an enum case name. An identifier, or a KEYWORD spelled there
	// (`function from(…)`, `FilePath.from(…)`): see `tokenCanBeAName` for why the POSITION is what licenses
	// the keyword, and `keyword-as-a-declared-name.md` for the rule.
	//
	// `position` says what the mismatch diagnostic names, because the positions differ in what they are
	// ASKING for and not in what they accept — `'identifier'` for a declaration or a callee (the E2010 text
	// the spec corpus pins), `an enum case name` for a case. ONE reader, so a position taught to admit a
	// keyword cannot be one a sibling still refuses. ⚡ It is an ENUM and not the rendered text: see
	// `NamePosition` for the measurement that says why.
	function consumeNameToken(position NamePosition) returns Token throws ParseError
		let tok = self.current()
		if not tokenCanBeAName(tok) 'notAName'
			throw ParseError.unexpectedToken(nameExpectationOf(position), got: tokenDisplayText(tok), line: tok.line, column: tok.column)
		end 'notAName'
		self.advance()
		return tok
	end 'consumeNameToken'

	// ⭐⭐ **THE TOKEN NAMING A TYPE AT `index`, WITH `Self` ALREADY RESOLVED TO THE NAME IT DENOTES (D9)** —
	// `consumeNameToken`'s sibling for the other half of a dotted expression: that one reads the MEMBER, this
	// one reads the BASE. It is the ONE place the `Self` keyword becomes the enclosing declaration's own name
	// in an expression, and it is a token REWRITE rather than a flag every reader would have to test.
	//
	// ⭐ **THAT IS WHY THERE IS NO `Self` DISPATCHER.** `Self.off` inside `enum Toggle` IS `Toggle.off` and
	// `Self.make(v)` inside `type Box` IS `Box.make(v)`, so the two spellings converge HERE — at the single
	// token every type-named form reads its base through — and every arm downstream (`parseDottedPrimary`'s
	// enum-case and static-call split, `parseQualifiedCall`'s callee mangling, `parseEnumLiteral`, the struct
	// literal, the type-qualified bound) answers for both without knowing the keyword exists. Before this,
	// `Self` in an expression could be exactly ONE thing — `Self{…}` — so `Self.` fell off that expectation
	// and surfaced as `E2010 Expected '{' but got '.'` in a `type` body and as a `requireConstructible`
	// PANIC in an enum's.
	//
	// The rewritten token keeps the `Self` token's line, column and source SPAN, so a diagnostic still points
	// at what the author wrote while NAMING the type it means — which is also what the reference bootstrap
	// reports (measured: `Self.nope` inside `type Box` is *"'Box' is a type and cannot be used directly as a
	// value"*, anchored at the `Self`). It is `identifier`-kinded for `memberNameTokenAt`'s reason: the token
	// is a NAME now, and no later reader may re-decide it was a keyword.
	//
	// ⚠ **IT MOVES NO CURSOR**, because the two askers need different things from it: `parseDottedPrimary`
	// PEEKS to pick an arm, and the arm it picks then consumes the base itself.
	function typeBaseTokenAt(index TokenIndex) returns Token throws ParseError
		let tok = self.tokenAt(index)
		if tok.kind == TokenKind.identifier 'plainTypeName'
			return tok
		end 'plainTypeName'

		// ⭐ **`int`/`float`/`bool` NAME TYPES HERE TOO (A1s-prim) — the SECOND keyword this reader resolves,
		// and it arrives by exactly `Self`'s argument.** A primitive keyword in a dotted base position can
		// only be the type it spells, so it becomes an identifier-kinded token carrying that spelling and
		// every arm downstream — the enum split, `parseQualifiedCall`'s mangle, the type-qualified bound —
		// serves it without learning that a keyword got here. Its line, column and source span are the
		// keyword's own, so a diagnostic still points at what the author wrote; `identifier`-kinded for the
		// reason the `Self` rewrite below is, that the token is a NAME now.
		//
		// ⚠ **NOTHING ROUTES A NON-CALL PRIMITIVE BASE HERE, AND THAT IS DELIBERATE.** The two doors that
		// send a primitive keyword into a dotted expression (`parsePrimary`, `parseTryCallReceiver`) both
		// gate on the WHOLE `<primitive> . <member> (` shape, so `int.max` never reaches this reader and
		// still reports the `expectedExpression` it always has. The oracle has no such form either
		// (measured: `int.max` is `E3003 Undefined variable 'int'`), so admitting it here would be inventing
		// a bound expression, not restoring one.
		if keywordNamesAPrimitiveType(tok) 'primitiveTypeName'
			return Token.create(TokenKind.identifier, line: tok.line, column: tok.column, value: tok.value, startByte: tok.startByte, endByte: tok.endByte)
		end 'primitiveTypeName'

		// Anything else is the mismatch `consume(TokenKind.identifier)` reported before this reader existed,
		// on the same token and in the same words — a base position admits a type NAME and the one keyword
		// that stands for one, and nothing else.
		if tok.kind != TokenKind.selfType 'notATypeName'
			throw ParseError.unexpectedToken(TokenKind.identifier.rawValue, got: tokenDisplayText(tok), line: tok.line, column: tok.column)
		end 'notATypeName'

		// The name is bound before the call rather than passed inline: the bootstrap cannot lower a `try`
		// expression in this argument position (`E9001 … not in valueMap; assigning to '__arg_pin_7'`).
		let denoted = try self.requireEnclosingTypeName(tok)
		return Token.create(TokenKind.identifier, line: tok.line, column: tok.column, value: denoted, startByte: tok.startByte, endByte: tok.endByte)
	end 'typeBaseTokenAt'

	// The type-naming token at the cursor, consumed — `typeBaseTokenAt` plus the advance, split for the
	// reason `consumeMemberNameToken` is split from `memberNameTokenAt`.
	function consumeTypeBaseToken() returns Token throws ParseError
		let tok = try self.typeBaseTokenAt(self.pos)
		self.advance()
		return tok
	end 'consumeTypeBaseToken'

	// Advance the cursor past any newlines — `indexPastNewlines` applied to the cursor, so the MOVER and the
	// LOOKAHEAD read one definition of "which tokens are layout" rather than two copies of it. Two copies
	// would not fail loudly if they drifted: a lookahead that disagreed with the mover would silently route
	// `[10\n]` down a different path from `[10]` (the int fast path settles an element's type off exactly
	// that question), and a wrong element type is a wrong answer, not a compile error.
	function skipNewlines()
		self.pos = self.indexPastNewlines(self.pos)
	end 'skipNewlines'

	// The first index at or after `index` that is not a newline — the LOOKAHEAD form, moving no cursor, and
	// the one definition `skipNewlines` above is derived from. A lookahead that counted newlines as tokens
	// would answer a question about the source's LAYOUT where the asker meant one about its shape: `[10]` and
	// `[10\n]` are the same literal, and the two must not take different paths through the parser. `tokenAt`
	// answers `eof` past the end, so this terminates.
	function indexPastNewlines(index TokenIndex) returns TokenIndex
		var scan = index
		while self.kindAt(scan) == TokenKind.newline 'skip'
			scan = scan + 1
		end 'skip'
		return scan
	end 'indexPastNewlines'

	// Consume an optional block label (`'name'`, a charLiteral) after `end`.
	function skipOptionalLabel()
		if self.at(TokenKind.charLiteral) 'label'
			self.advance()
		end 'label'
	end 'skipOptionalLabel'
end 'Parser'
