		self.rebindableSlotReads = sharedEmptyRebindableSlotReads
		self.constructorFeedParams = sharedEmptyConstructorFeedParams
		self.recordsOwningOpaqueSlots = sharedEmptyRecordsOwningOpaqueSlots
		self.recordsHoldingReferencedOpaqueSlots = sharedEmptyReferencedOpaqueRecords
		self.callReferencedAnOpaqueFeedSlot = false
		// The buffer-surface marks (R4.4, A2m) are per-function for exactly that reason too — see
		// `bufferSurfaceValues`. All THREE reset together, because they describe one value space.
		self.bufferSurfaceValues = sharedEmptyBufferSurfaceValues
		self.bufferSurfaceSlots = sharedEmptyBufferSurfaceSlots
		self.bufferSurfaceElements = sharedEmptyBufferSurfaceElements
		self.sizedContainerBufferValues = sharedEmptySizedContainerBufferValues
