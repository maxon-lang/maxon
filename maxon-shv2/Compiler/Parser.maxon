		// ⭐ **AND ONE HIDDEN WITNESS PER INTERFACE-TYPED USER PARAMETER (P1.7a-existentials slice 1)** — the
		// other half of the fat pointer, travelling as an adjacent ABI parameter rather than as an aggregate.
		// It sits between the env block and the layout slot; see `bindExistentialWitnessParams` for why that
		// is the only placement that moves nothing.
		// Both hidden blocks are sized through the ONE counter the lowering's SUPPLY side reads — see
		// `countParamsWithTag` for why a second body here is an ABI hazard rather than a duplicate.
		let envParamCount = countParamsWithTag(paramTypes, tag: ValueTypeTag.function)
		let existentialWitnessCount = countParamsWithTag(paramTypes, tag: ValueTypeTag.interfaceRef)
		let paramCount = userParamCount + envParamCount + existentialWitnessCount + layoutParamCount + countParamCount + witnessParamCount
		try requireAbiParamCount(paramCount, anchor: nameTok)
		self.scope.reset()
		self.valueIds = ValueIdRef.create(paramCount)
		self.mutableVars = VarInfoArray.create()
		self.mutableVarShadowed = sharedEmptyMutableVarShadowed
		self.mutableVarInnermost = sharedEmptyMutableVarInnermost
		// Re-CREATED, not cleared, exactly as every other per-function column is: a stray owned
		// binding carried across a function boundary would emit a `__mm_decref` of a value from the
		// PREVIOUS function's SSA space — a wild pointer, and one the leak gate could not even
		// report, because the count would still balance.
		self.ownedBindings = VarInfoArray.create()
		// Re-created per function for a plainer reason than the columns around it: a candidate left over from
		// the previous function would be reported against THIS function's `end`, blaming a parameter no part
		// of this declaration names.
		self.unusedCandidates = UnusedBindingCandidateArray.create()
		// Cleared for the reason its header gives: the aliases it stands for belong to the SSA space of the
		// function that minted them, and this one has none until it binds one.
		self.functionMintedValueAliases = false
		// Re-created for the same reason, one step further out: a name mentioned in the PREVIOUS function
		// would excuse a candidate of that name here. The name-scoped half is bounded to ONE function,
		// exactly as the oracle's per-function `_referencedVars` is.
		self.referencedNames = ByteArrayArray.create()
		// E3077's half of the same accounting, bounded to one function for the identical reason.
		self.mutabilityExercisedNames = ByteArrayArray.create()
		// Re-created per function for the same reason `ownedBindings` is: a stray pending temp carried
		// across a function boundary would decref a value from the PREVIOUS function's SSA space.
		self.pendingTempDrops = ValueIdArray.create()
		// Invalidated per function for the same reason: a stale `box` id names a value in the PREVIOUS
		// function's SSA space, so a move-out would null the wrong slot.
		self.lastFieldReadValid = false
		self.loops = LoopContextArray.create()
		// Fresh per function, with its companion flag — see the `tryBlocks` field declaration for why.
		self.tryBlocks = TryBlockContextArray.create()
		self.tryBlockRoutingSuppressed = false
		self.matches = MatchContextArray.create()
		// ⚠ Balanced by construction — pushed and popped around each `for` body — EXCEPT on the error path,
		// where a `ParseError` thrown inside a body skips the release. So the reset is real; it points back
		// at the shared empty rather than allocating (see `sharedEmptyIterationLocks`).
		self.iterationLockedBindings = sharedEmptyIterationLocks
		self.valueTags = ValueTypeTagArray.create()
		self.valueNameIds = TypeNameIdArray.create()
		self.valueConsts = ParsedIntArray.create()
		self.valueConstDomains = ConstPayloadDomainArray.create()
		self.valueOwnsHeap = BoolArray.create()
		self.valueOwnsHeapAlone = BoolArray.create()
		self.valuePromiseMarks = BoolArray.create()
		self.nodeHandleMintedFrom = ValueIdArray.create()
		self.phiAliasUnprovenMarks = BoolArray.create()
		self.valueIsCapturingClosure = BoolArray.create()
		self.valueClosureEnv = ValueIdArray.create()
		self.valueWitnessIds = ValueIdArray.create()
		// ⭐ The witness-parameter RESERVATION, published for the body parse — AFTER the per-function resets
		// above, which is load-bearing: a reset written before them would be zeroed by the block it sits in.
		// A dispatch through a `where` constraint resolves to a parameter ValueId through exactly these two
		// numbers (`witnessParamValueId`).
		self.declaringWitnessParamBase = (paramCount - witnessParamCount) as ValueId
		self.declaringWitnessParamCount = witnessParamCount
		// Per-function, like the sibling value columns: a value's per-instance alias provenance names an id
		// in THIS function's SSA space (P1.6-C). Points at the SHARED empty until the function constructs an
		// instance (`recordValueInstanceAlias` copy-on-writes), so a generics-free function allocates nothing.
		self.valueInstanceAlias = sharedEmptyInstanceAliasMap
		self.valueExistentialInstance = sharedEmptyExistentialInstanceMap
		// Per-function for the identical reason: a value's declared ranged alias names an id in THIS
		// function's SSA space (see `ValueDeclaredAliasMap`), and shares the same copy-on-write anchor.
		self.valueDeclaredAlias = sharedEmptyDeclaredAliasMap
		self.charLiteralOps = sharedEmptyCharLiteralOps
		self.stringBytesViewOps = sharedEmptyStringBytesViewOps
		// Per-function for the identical reason (P1.7 slice 2b): a marked value names an id in THIS
		// function's SSA space, so a mark carried over would name an unrelated value in the next one.
		self.immutableGlobalReads = sharedEmptyImmutableGlobalReads
		self.mergeImmutableBlame = sharedEmptyMergeBlames
		// ⭐ **W117: WHAT THE SWEEP PUBLISHED ABOUT *THIS* DECLARATION**, read once here rather than at each
		// `return` — the answer cannot change while one body is parsed, and the door that reads it sits on the
		// promotion path of every returned aggregate.
