// Parser — the M1 recursive-descent slice.
//
// shv2 keeps v1's "direct-emit" contract: the parser emits Maxon-dialect IR ops
// directly onto blocks (no AST). Two structural changes from v1:
//
//   1. It writes exclusively into a per-file `FileParseArtifact` — its own
//      MaxonModule fragment, its own local type-name interner, and its own
//      registry contributions — and takes NO `Project` (PLAN.md). Per-file parse
//      is therefore a pure function of `(tokens, filePath, namespace)` with no
//      shared state; `mergeArtifact` folds the result into `Project` later.
//   2. **Value numbering is born HERE.** Each op's result gets a dense, function-
//      local `ValueId` from `self.valueIds` at emit time. v1 instead named values
//      with synthetic `$tN` strings and re-derived the ids in `lowerMaxonToStd`
//      from a second counter — paying a heap String + ByteArray per value plus a
//      byte-keyed hash map to undo it. See MaxonDialect's MaxonOp header.
//
// Anything outside the parsed slice is rejected with a positioned diagnostic. What
// the slice covers: free functions (parameters, calls with `name:` labels, an
// optional `returns` clause), ranged `typealias` declarations, `let`/`var` bindings
// and reassignment, `if`/`else`/`while` with `break`/`continue`, integer and bool
// literals, parenthesized grouping, arithmetic, comparison, and type-qualified numeric
// bounds. What it does NOT: user types, generics, strings, floats, logical operators.
//
// THREE THINGS THIS FILE OWNS THAT ARE NOT OBVIOUS FROM ITS SHAPE:
//
//   1. NAME RESOLUTION, INCLUDING LEXICAL BLOCK SCOPING. `Scope` is threaded through
//      the parse, and each `if`/`else`/`while` body is a scope FRAME (parseBlockBody),
//      so a binding declared in a block is gone at its `end` and may legally shadow an
//      outer one while it lives. An unbound name is a parse-time diagnostic.
//   2. ON-THE-FLY SSA. There is no AST and no `mem2reg`: a `let`/`var` binds a name
//      straight to the SSA value its initializer produced, and the block-args (phis)
//      that merge those values across branches and loops are minted HERE, as the
//      control flow is parsed. Mutable bindings are tracked BY REFERENCE for it — see
//      LoopPhiVar for the shadowing hazard that forces that.
//   3. THE IMPLICIT RETURN. A void function's body carries no `return`, so the parser
//      supplies its terminator (closeFunctionBody) — and reports E3013 when a
//      value-returning body can fall off its end instead.

// Cursor position into the token array. Wide range: token counts are unbounded. Exported because a
// top-level constant's declaration records the token RANGE of its initializer (SignatureIndex's
// `TopLevelDecl`) rather than a tree of it.
export typealias TokenIndex = int(0 to u64.max)

// How many blocks are open around a token. 0 is FILE SCOPE — the depth at which a `let` is a
// top-level constant rather than a body-local binding (see `foldDeclaredSignaturesInto`). Wide
// range: nesting is unbounded.
typealias BlockDepth = int(0 to u64.max)

// How many `[` are open around a token — the depth at which a NEWLINE is layout rather than the end of a
// top-level initializer (see `initializerEndIndex`). A separate alias from `BlockDepth` because it counts a
// different thing: an array literal opens no block, and a block keyword opens no bracket.
typealias BracketDepth = int(0 to u64.max)

// (The six-register parameter cap that used to live here is GONE. It was never a limit of the machine —
// only of a milestone that had not been built — and it refused 34 of shv2's own functions. Its
// replacement is the ceiling the representation genuinely has, `StdDialect.MaxAbiArgs`, enforced by
// `requireAbiParamCount` below.)

// The displacement from a top-level `var`'s `globalAddr` to the value itself: ZERO, because every
// global is its OWN labelled `.data` slot and the label already names the exact address.
//
// Named rather than written `0` at the three emit sites, because the zero is a CLAIM ("this label
// names this value, with nothing in front of it") and not an arithmetic accident — P1.1's `point.x`
// goes through the very same `loadIndirect`/`storeIndirect` ops with a real field offset, and at
// that point the two must be told apart by a reader.
export let GlobalSlotOffset = 0 as ByteOffset

// One capture occupies one 8-byte slot in a closure's environment block — a scalar VALUE stored by-value
// for A2b-1 (a pointer, in a later slice). The env block is `__mm_alloc(captureCount * EnvSlotBytes)`, and
// capture slot `i` lives at `env + i * EnvSlotBytes`.
let EnvSlotBytes = 8 as ByteOffset

// The index of a capture within a closure's environment — a slot number, and a count of slots.
typealias EnvSlotIndex = int(0 to u64.max)

// Where slot `slot` starts. The OFFSET half of the pair a capture's store (`buildClosureEnv`) and its
// read (`emitCaptureRead`) must derive identically — `fieldStorageType` is the WIDTH half — written
// once for the reason `emitFieldStore`'s header gives about a struct box: a slot filled at one offset
// and read at another corrupts the environment silently, with no diagnostic anywhere.
function envSlotOffset(slot EnvSlotIndex) returns ByteOffset
	return (slot * EnvSlotBytes) as ByteOffset
end 'envSlotOffset'

// The shared tail of every E3099 (capturing-closure-escapes) message: WHY the closure may not escape. The
// route-specific prefix ("cannot return …", "cannot store … in field …") is built at each site; this is the
// ONE copy of the reason. ⚠ The wording ("by reference") follows the ported golden and the reference
// compilers' by-REFERENCE model; shv2 captures by VALUE into a heap env, but that env is dropped at the
// enclosing frame's scope exit, so the "cannot outlive that frame" conclusion holds identically and the
// byte-identical golden stands. See the `capturingClosureEscapes` ParseError header.
//
// EXPORTED because the DERIVED invariant (`SemanticCheck.checkCapturingClosureUses`) states the same reason
// for the routes the parser cannot word — so the reason lives once for both, and the parser's route-specific
// refusals and the structural backstop cannot come to explain one rule two ways.
export let CapturingClosureEscapeSuffix = "captures are taken by reference to the enclosing function's frame, so a closure that captures cannot outlive that frame. Use a function reference, or a closure that captures nothing"

// The shared tail of every E3099 raised when a capturing closure reaches a MERGE (a match-expression
// `gives` arm, an `otherwise <value>` fallback — and, once the front-end parses it, a ternary arm). A
// merge joins its edges through ONE phi slot that carries the function pointer alone; the env rides a
// separate per-value side column that a phi cannot merge, so the merged closure would be called with no
// environment REGARDLESS of whether the result escapes the frame. The reachable twin of the (front-end-
// unreachable) ternary-arm refusal the corpus already pins; the route-specific prefix ("as a `gives` arm
// …", "as the value of an `otherwise` …") is built at each site so the one reason lives once.
//
// EXPORTED for `CapturingClosureEscapeSuffix`'s reason — and here the second reader is not a nicety: the
// parser enumerates only THREE merges (a ternary arm, a match `gives`, an `otherwise` fallback), while an
// `if`-continuation phi and a loop-header phi are merges too and were reaching the back end unrefused. The
// derived invariant catches those, and says the same thing about them.
export let CapturingClosureMergeSuffix = "a merge joins its arms through a single slot that carries the function pointer but not the capture environment, so the closure would be called with no environment. Use a function reference, or a closure that captures nothing"

// The parser's failure modes. Distinct from NumberParsing's `ParserError` (which
// `intLiteralValue` / `floatLiteralBits` catch and re-raise, positioned, as
// `integerOverflow` / `floatLiteralOverflow`). queryParseOps turns a thrown
// `ParseError` into a project diagnostic — the parser itself never touches `Project`.
export union ParseError implements Error
	unexpectedToken(expected String, got String, line LineNumber, column ColumnNumber)
	// A primary expression was required but the token stream had something else
	// (e.g. an operator where an operand belongs). Distinct from `unexpectedToken`:
	// it renders as E2004 `Expected expression but got '<got>'` (no quotes around
	// `expression`), the exact text `unary-operators.md`'s double-negation gates on
	// — `- -x` fails at the second `-`, since a unary operand is a PRIMARY.
	expectedExpression(got String, line LineNumber, column ColumnNumber)
	unexpectedEof(line LineNumber, column ColumnNumber)
	// An integer literal whose magnitude does not fit an i64. `literal` is the token's RAW TEXT —
	// radix prefix and `_` separators intact — because the diagnostic quotes what the source WROTE
	// (`0x1ff_ffffffffffffff`), which the decoded value can no longer say.
	integerOverflow(literal String, line LineNumber, column ColumnNumber)
	// A float literal whose magnitude exceeds what an f64 can represent (`1e400`). A SEPARATE
	// variant from `integerOverflow` rather than a reuse of it: they share an error CODE (the
	// literal is out of its type's range either way), and they must not share a MESSAGE, because
	// the limit each names is a DIFFERENT limit — an integer's is the i64 span, spelled out; a
	// float's is `f64.max`, which no i64 span describes. Same raw-text rule as its integer twin.
	floatLiteralOverflow(literal String, line LineNumber, column ColumnNumber)
	// An INTEGRAL-ONLY operator (`mod`, the bit band, or a prefix `not`) applied to a float. Both
	// the binary and the unary raiser reach it, because it is one rule — see
	// `TypeRules.operatorIsIntegral`, which is where the operator set is decided, and
	// `notOperatorFor`'s float arm.
	nonIntegralOperands(op String, operand String, line LineNumber, column ColumnNumber)
	// ⭐ A float meeting a declared INTEGER — at a `return`, an assignment, or a global store.
	// ONE variant for every coercion site the parser owns, because they are one rule
	// (`TypeRules.checkDeclaredType`) and one fact, and the message must not vary with the site
	// that noticed. The call-argument site is SemanticCheck's — the callee's signature is not the
	// parser's to see — and it reports the same code with the same words.
	implicitNarrowing(sourceType String, targetType String, line LineNumber, column ColumnNumber)
	// A compiler BUILTIN called with the wrong number of arguments. It is the parser's to report
	// and not SemanticCheck's, because a builtin has no entry in the signature registry that
	// SemanticCheck's arity check reads — there is nothing there to disagree with.
	builtinArity(name String, expected ParamCount, got ParamCount, line LineNumber, column ColumnNumber)
	// A compiler builtin whose argument is the wrong type (`trunc(flag)`, `print(5)`). Same reason as
	// `builtinArity`: no signature exists for the ordinary argument check to consult. `required` names
	// what the builtin DOES accept ("number" for `trunc`, "String" for `print`), because the two differ
	// and a fixed word would be wrong for one of them.
	builtinOperandType(name String, required String, got String, line LineNumber, column ColumnNumber)
	unsupported(feature String, line LineNumber, column ColumnNumber)
	// A parameter list that repeats a name (`function f(x int, x int)`). The second
	// binding would be a dead, uncallable parameter, so it is rejected at parse time.
	// Renders as E2014, positioned at the repeated name.
	duplicateParameter(name String, line LineNumber, column ColumnNumber)
	// A reference to a name with no binding in scope. Distinct from
	// `unexpectedToken` (a syntactic mismatch): this is a name-resolution failure,
	// which the parser can detect because `Scope` is threaded through it.
	undefinedVariable(name String, line LineNumber, column ColumnNumber)
	// A reassignment (`x = expr`) whose target was declared `let` (immutable). M4b
	// added assignment; only `var` bindings accept it. Renders as E2013.
	assignToImmutable(name String, line LineNumber, column ColumnNumber)
	// A READ of a binding that has been MOVED FROM — its owned heap value was transferred to
	// another binding by an earlier `let u = t` / `s = t` (Wave C, static single-owner). Renders
	// as E3102, positioned on the use. A WRITE to a moved-from `var` is legal (it revives the
	// binding) and does NOT come through here — only reads reach `parseVariableReference`. This
	// is shv2's first ownership program-rejection; the reference compilers refcount and have no
	// move model, so there is no bootstrap text to match.
	useAfterMove(name String, line LineNumber, column ColumnNumber)
	// A `break`/`continue` with no enclosing loop. `keyword` is "break"/"continue"
	// for the message. Renders as E2047.
	controlOutsideLoop(keyword String, line LineNumber, column ColumnNumber)
	// A labelled `break 'l'`/`continue 'l'` whose label names the INNERMOST loop —
	// redundant (a plain `break`/`continue` already targets it). Renders as E2048.
	labelTargetsOwnLoop(keyword String, label String, line LineNumber, column ColumnNumber)
	// A labelled `break 'l'`/`continue 'l'` whose label matches no enclosing loop.
	// Renders as E2047.
	unknownLoopLabel(keyword String, label String, line LineNumber, column ColumnNumber)
	// A call whose FIRST argument carries a `name:` label — the first argument is
	// positional, only the 2nd and later take labels. Renders as E2052. A syntactic
	// rule the parser checks without the callee's signature.
	firstArgNamed(line LineNumber, column ColumnNumber)
	// A call whose 2nd-or-later argument has NO `name:` label. Renders as E2053. The
	// symmetric syntactic rule to `firstArgNamed`.
	argMissingLabel(line LineNumber, column ColumnNumber)
	// ⭐ **THE THREE SLOTTING FAILURES OF A WITNESS DISPATCH (P1.7a slice 2b-vi)** — arity, an unknown
	// `name:` label, and two actuals targeting one formal. They render as E3036/E3037/E3038, the SAME
	// three codes `SemanticCheck.validateCall` reports for a direct call, with the SAME words (built by
	// `Project`'s `argArityMismatchMessage`/`argUnknownLabelMessage`/`argDuplicateMessage`, which is why
	// there is one copy of them) — because it is one rule met at a second kind of call site.
	//
	// They are raised HERE rather than in SemanticCheck because a witness dispatch is in no signature
	// registry: there is no callee NAME to look up, so the only pass holding both the interface method's
	// `paramNames` and the call's arguments is the parser. (The stage is derived from a code's leading
	// digit, not from which pass raises it; `requireGenuineSelfArgs` already raises an E3005 from here.)
	// `callee` is `<Interface>.<method>` — what the call actually binds against.
	witnessArgCountMismatch(callee String, expected ParamCount, got ParamCount, line LineNumber, column ColumnNumber)
	witnessUnknownArgLabel(callee String, label String, line LineNumber, column ColumnNumber)
	witnessDuplicateArg(callee String, paramName String, line LineNumber, column ColumnNumber)
	// A VALUE-returning function whose body can fall off its end without returning.
	// Renders as E3013, positioned at the function's name. Detected here, not in a
	// later pass, because the parser is what knows the block its last statement left
	// control in — and whether that block ever got a terminator.
	missingReturn(name String, line LineNumber, column ColumnNumber)
	// A `return <expr>` inside a function that declares NO return type. Renders as
	// E3005 (a type mismatch: the function's declared result is nothing, and `<expr>`
	// is not nothing), positioned at the `return`.
	returnValueFromVoid(name String, line LineNumber, column ColumnNumber)
	// A BARE `return` inside a function that DOES declare a return type — a path that
	// leaves the function with no value to return. Renders as E3013, the same code as
	// falling off the end, because it is the same defect wearing a `return` keyword.
	// Positioned at the `return`, which is where the missing value belongs.
	returnWithoutValue(name String, line LineNumber, column ColumnNumber)
	// A WORD operator (`and`/`or`/`xor`) whose operands are one `bool` and one `int` — in
	// either order, and on either of the two paths such an operator can take (a `binOp`, or
	// the short-circuit lowering). Renders as E3005 (a type mismatch), positioned at the
	// operator. See TypeRules' `BinOpOperands.mixedWordOperands` for why a mixture has no
	// reading at all. v1 reports the identical case with the identical message
	// (Parser.maxon:11771).
	operandTypeMismatch(op String, line LineNumber, column ColumnNumber)
	// An ARITHMETIC / DIVISION / SHIFT operator with a non-numeric operand — `4 + flag`,
	// `flag shl 4`, `true + false`. Renders as E2004 (`Cannot operate on int and bool`),
	// positioned at the operator, which is the code, text and anchor the C# bootstrap uses
	// (2-Parser.cs:17785). Both operand type names ride along because the message names both.
	nonNumericOperands(left String, right String, line LineNumber, column ColumnNumber)
	// A prefix `-` applied to a non-numeric operand (`-flag`). The same rule as
	// `nonNumericOperands`, asked of the one operand a unary has. Renders as E2004,
	// positioned at the `-`. The bootstrap has no diagnostic for this at all — it reaches its
	// lowering and dies with an internal error (E9001 `Unsupported binop: Sub on Bool`), which
	// is a bootstrap BUG, not a spec.
	nonNumericNegation(operand String, line LineNumber, column ColumnNumber)
	// A `shl`/`shr` whose count the compiler FOLDED and found NEGATIVE — `a shl -1`, `a shl -(1)`,
	// `let SHIFT = -1` … `a shl SHIFT`. Renders as E2054, positioned at the count as written. The
	// count rides along because the message names it.
	//
	// A negative count is not a shift the other way: masked, `a shl -1` silently became
	// `a shl 63` — the MAXIMUM left shift, a wrong answer with the opposite sign.
	//
	// ⚠ A count of 64 OR MORE IS NOT THIS ERROR. It is a legal, well-defined shift that moves
	// every bit out (`x shl 64` == 0), and `Parser.emitShift` folds it to that. Rejecting it —
	// which this diagnostic did before the rule was narrowed to Go's — OVER-rejects a correct
	// program, which in this codebase is the worse failure.
	shiftCountNegative(count ParsedInt, line LineNumber, column ColumnNumber)
	// A comparison whose operands are in different type classes (`4 < flag`). Renders as
	// E3005 with the bootstrap's exact text — `type mismatch: 'cannot compare int with bool'`
	// (2-Parser.cs:17777) — positioned at the comparison operator. A comparison over two
	// bools is LEGAL (`a == b`); it is the MIXTURE that is meaningless, because the compare
	// would be over the bool's 0/1 payload rather than over anything the source wrote.
	comparisonTypeMismatch(left String, right String, line LineNumber, column ColumnNumber)
	// A COMPARISON OPERATOR on an UNCONSTRAINED type parameter — `item == other` with no `where T is
	// Equatable`, or `item < other` with no `where T is Comparable`. Renders as **E3005**, positioned at the
	// operator. Both families dispatch through a witness (equality through `Equatable.equals`, ordering
	// through `Comparable.compare`); without the constraint there is no witness, and a scalar `compare` would
	// silently compare two opaque words (a POINTER compare for a struct `T`). `op` is the operator spelling,
	// `typeParamName` the parameter's declared name, `interfaceName` the interface whose constraint the
	// operator needs — ONE variant and ONE message for both families, because the sentence is identical but
	// for that name, and two copies of it would be free to drift.
	operatorRequiresConformance(op String, typeParamName String, interfaceName String, line LineNumber, column ColumnNumber)
	// A value that is NOT of the receiver's own type parameter supplied for a `Self`-typed witness-method
	// argument (`item == 42` / `item.equals(42)` inside `type Box uses T where T is Equatable`, T a struct).
	// Renders as **E3005**, positioned at the operator / method. The `where` constraint only proves
	// `equals(Self)` — against another value of the SAME type parameter T — so anything else is not a `Self`;
	// marshalling it into the `Self` pointer/slot faults (a struct `equals` dereferences an int literal as its
	// `other` pointer). `what` is the operator or method spelling, `typeParamName` the constrained parameter's
	// name, and `got` describes what was supplied instead — the TWO ways an actual can fail (a concrete value,
	// and a value of a DIFFERENT type parameter of the same generic type) share one variant and one sentence,
	// differing only in that phrase, because they are one rule with one cure.
	witnessSelfArgNotTypeParam(what String, typeParamName String, got String, line LineNumber, column ColumnNumber)
	// An `if` / `while` condition that is not a `bool` (`if 4`). Renders as E3005, positioned
	// at the CONDITION's first token — the expression the message is about, not the keyword
	// that introduced it. `keyword` is "if"/"while", so one message template serves both.
	//
	// AUTHORED, not ported: the C# bootstrap accepts `if 4` through its front end and then
	// fails an internal cast in its Maxon→Std lowering, reporting E9001 (an INTERNAL-ERROR
	// code, with a .NET stack trace). An internal error leaking to a user is a bootstrap bug —
	// it names no source position and describes no defect in the program — so it is not a
	// diagnostic to copy. shv2 rejects the condition where the type is known: in the parser.
	nonBoolCondition(keyword String, got String, line LineNumber, column ColumnNumber)
	// A reassignment whose value does not agree with the target binding's DECLARED type
	// (`var x = 5` then `x = true`). Renders as E3005, positioned at the variable name — the
	// same anchor `assignToImmutable` uses, because it is the same statement failing for the
	// other reason a binding can refuse a value. See `parseAssignment` for why this one check
	// is what makes every merge phi's type honest.
	assignTypeMismatch(name String, got String, expected String, line LineNumber, column ColumnNumber)
	// A `return <expr>` whose value's type class differs from the function's declared return
	// type (`return flag` from a function declared `returns Integer`). Renders as E3005 with
	// the bootstrap's exact text — `Cannot return 'bool' from function declared to return
	// 'int'` (2-Parser.cs:7840) — positioned at the `return`. The declared type prints as its
	// RESOLVED primitive, which is what the bootstrap prints (see TypeRules' typeTagName).
	returnTypeMismatch(got String, expected String, line LineNumber, column ColumnNumber)
	// P1.5-A1: a FUNCTION VALUE stored into a NON-function place (`slot = dbl` where `slot` holds an
	// int). Renders as E3005 with the spec's exact text — "cannot assign a value of type 'function' to
	// {noun} '{name}', which holds '{heldType}': …" — positioned at the target. `noun` is "variable" for
	// a local and "global" for a top-level one (the two spellings the spec distinguishes). Its own
	// variant, not `assignTypeMismatch`, because the wording and the noun both differ.
	functionValueIntoNonFunction(noun String, name String, heldType String, line LineNumber, column ColumnNumber)
	// P1.5-A1: a FUNCTION VALUE RETURNED where a NON-function return type is declared (`return dbl` from
	// a `returns Integer` function). Renders as E3005 with the spec's exact text — "Cannot return
	// 'function' from function declared to return '{returnType}': …" — positioned at the `return`.
	functionValueReturned(returnType String, line LineNumber, column ColumnNumber)
	// An `as` cast between FUNDAMENTALLY-INCOMPATIBLE KINDS, where no conversion exists: a managed
	// aggregate (a String, a struct, a function value) cast to or from a scalar number (`"x" as Age`,
	// `p as Age`, `f as Age`, `n as SomeStructAlias`). Renders as E3009 — the SAME code the lossy
	// `5.0 as int` gets, because it is the same fact (a cast that is not a legal conversion), and the
	// same code the bootstrap emits — with the bootstrap's exact text (`Cannot cast from {src} to
	// {tgt}`, 2-Parser.cs `ValidateCast`), positioned at the `as`. `src`/`tgt` are the two types'
	// `typeTagName`s (`String`/`struct`/`function`/`int`), so the two compilers name the pair
	// identically. Before this, `applyCast` let the cast through as a representational no-op, so the
	// aggregate's POINTER flowed on typed as the numeric target and either miscompiled (a range check
	// on a struct pointer) or was caught only downstream at the next type-checked position.
	invalidCast(sourceType String, targetType String, line LineNumber, column ColumnNumber)
	// An `as` cast whose TARGET NAME denotes no type at all — a typo (`Scor` for `Score`), a bare sized
	// name (`u8` is not a type in Maxon; a ranged alias over it is), or a type this slice does not have.
	// Renders as **E3011**, the SAME code `TypeResolution` gives the identical fact met at a parameter, a
	// return type or a field, and from the SAME authority (`denotedNamedType`) — so a name cannot be a
	// type in one position and not in another. Raised by BOTH cast sites (`castTargetTag` for a body
	// cast, `requireConstCastTargetKind` for a top-level `let`'s), positioned at the `as`, which is the
	// half the declaration sites cannot do: they record no span for a type REFERENCE. Before this the
	// cast silently evaporated and the program ran (`5 as CompletelyMadeUpNameXyz` returned 5).
	unknownCastTargetType(typeName String, line LineNumber, column ColumnNumber)
	// P1.5-A1: a THROWING function referenced as a VALUE (`let f = risky`). A function type has no throws
	// clause, so the binding would drop it and there is no indirect try-call to carry it back. Renders as
	// E3101, positioned at the function name. `errorType` is the thrown enum's name (the callee's `throws
	// E` clause), named in the message.
	throwingFunctionAsValue(name String, errorType String, line LineNumber, column ColumnNumber)
	// P1.5-A2b: a CAPTURING closure ESCAPES its defining frame — stored where it can outlive the frame
	// (a return, a struct field, a union payload, a match payload binding). Renders as E3099, positioned at
	// the store. `message` is the WHOLE route-specific text (built at the throw site, since the four routes
	// name different things — a field-and-type, a payload-and-case, a binding) rather than a route enum
	// re-expanded here: the shared suffix is `CapturingClosureEscapeSuffix`, so the one fact "why this is
	// refused" lives once even though the prefixes differ. ⚠ The suffix says "by reference" — the wording of
	// the ported golden and the reference compilers' by-REFERENCE model; shv2 captures BY VALUE into a
	// heap env, but that env is dropped at the enclosing frame's scope exit, so the "cannot outlive that
	// frame" conclusion holds identically and the byte-identical golden stands.
	capturingClosureEscapes(message String, line LineNumber, column ColumnNumber)
	// OPEN #54 Slice C: a match EXPRESSION whose `gives` arms produce values of different types
	// (`match c { 0 gives "s"; default gives 5 }`, or two different structs/unions). The result phi
	// takes the FIRST arm's type, so a later arm's value is wrong-typed through it — a String pointer
	// read off an integer (segfault), or a wild free when the phi is dropped under the first type's
	// destructor. Renders as E3005, positioned at the `match`. `got`/`expected` are the mismatching
	// arm's type and the first arm's, each already the printable name (`typeTagName` for a scalar
	// class, the interned aggregate name for two structs/unions) — the same shape `returnTypeMismatch`
	// carries, so the three coercion-site messages phrase one rule one way.
	giveTypeMismatch(got String, expected String, line LineNumber, column ColumnNumber)
	// P1.5 #80/#81: a TERNARY (`a if c else b`) whose two branches produce different types — the ternary
	// twin of `giveTypeMismatch`, split off because its E2028 wording names the TRUE and FALSE branches by
	// position where a match names the offending arm. Renders as E2028, positioned at the `if`.
	// `trueType`/`falseType` are each already the printable name: a scalar class, an aggregate name, or
	// (the #81 function-arm case) a `fn(…) returns …` signature string. Matches the reference oracle's
	// `ParseTernaryExpression` E2028 (2-Parser.cs:16060/16162).
	ternaryValueTypeMismatch(trueType String, falseType String, line LineNumber, column ColumnNumber)
	// P1.5 #80: a TERNARY whose CONDITION is not a bool (`x if 42 else y`). The ternary twin of
	// `nonBoolCondition`, split off because it renders as E2028 (not E3005) and anchors at the `if`,
	// exactly as the reference oracle does (2-Parser.cs:15997). `got` is the condition's printable type.
	ternaryNonBoolCondition(got String, line LineNumber, column ColumnNumber)
	// A `not` whose operand's type the parser cannot determine. Since the whole-program signature
	// index landed, that is reachable only for a call to a function NO FILE DECLARES — a program
	// already doomed (E3004). Renders as E3005, positioned at the `not`. It is a REJECTION rather
	// than a guess because `not`'s two readings disagree about the VALUE: the bitwise complement
	// of a bool is -1 or -2, and both read as TRUE (see `notOperatorFor`).
	notOnUnknownType(line LineNumber, column ColumnNumber)
	// A call to a VOID function used where a VALUE belongs — `let x = noop()`, `return noop()`,
	// `if noop()`, `noop() + 4`. Renders as E2004 with the C# bootstrap's exact text ("Function
	// 'noop' does not return a value"), positioned at the callee name, which is the bootstrap's
	// anchor too.
	//
	// The parser is the right tier and the CALL SITE is the right anchor, because the parser is the
	// only place that knows which of the two call positions this is: the grammar has exactly two
	// (a bare-call STATEMENT, whose whole purpose is to discard the result, and a call inside an
	// EXPRESSION, which needs one), and `parseCall`'s `resultUsed` is that distinction.
	//
	// It was silently ACCEPTED before the signature index, and the deferral is not what broke it:
	// `calleeResultType` reported a void callee as `MaxonType.unresolved` — the SAME sentinel it
	// used for "I could not see this callee" — so TypeRules classified "there is no value" as "I
	// cannot judge this value", and every rule correctly deferred on it. One sentinel, two
	// meanings. `ValueTypeTag.void` is now the other one.
	voidCallResultUsed(name String, line LineNumber, column ColumnNumber)
	// A character literal whose body is not one character: `''`, or a `\` escape the
	// decoder does not know. Renders as E2016, positioned at the literal. (A literal that
	// is a valid but MULTI-BYTE character — `'é'`, an emoji — is not this: it is a
	// legitimate program shv2 cannot yet compile, so it reports as `unsupported`.)
	invalidCharacterLiteral(reason String, line LineNumber, column ColumnNumber)
	// A `b"…"` byte-string literal names a codepoint above 0xFF — a literal character or a `\uNNNN` escape
	// with no single-byte Latin-1 encoding (`b"Ā"`, `b"Ā"`, an emoji). Renders as E1004, the same
	// `LexerInvalidEscape` code v1 uses. It carries the FULLY-BUILT message (`byteStringCodepointRangeMessage`,
	// with the codepoint hex-formatted at the decode site): the diagnostic is rendered ANCHOR-LESS (see
	// `reportParseError`) because the /specs codepoint-range spec pins a message-only expected with no
	// `<file>:line:col:` prefix, so there is no line/column to carry.
	byteStringCodepointRange(message String)
	// A top-level name DECLARED more than once in one file — `let A = 1` then `let A = 2`, or a
	// `let`/`var` collision on one name. Unlike the constant-evaluator arms below (raised during the
	// sweep, recorded on the decl, re-thrown), this is raised DIRECTLY by the real parse when it reaches
	// the later declaration (`raiseBindingFailure` via `ProgramSignatures.isRedeclaredBinding`). Renders
	// as E3006, positioned at the LATER declaration's name — the top-level twin of the duplicate-FUNCTION
	// check `commitFuncSignatures` makes. `recordDecl` is first-wins, so the first declaration keeps the
	// name and this names the redeclaration the author should remove.
	duplicateTopLevelDeclaration(name String, line LineNumber, column ColumnNumber)
	// --- The top-level constant arms (P1.0d.5a) ---
	//
	// All three are raised by the CONSTANT EVALUATOR, which runs inside the whole-program
	// declaration sweep and so has no business reporting anything itself (`foldDeclaredSignaturesInto`
	// is deliberately tolerant). They are recorded on the declaration and re-thrown here, by the real
	// parse, when it reaches the `let` that owns them — see `TopLevelConstant.failed`. That they are
	// ParseErrors and not a private error space is the point: `reportParseError` is already the one
	// place a parse-time diagnostic becomes a project diagnostic, and a second mapper would be a
	// second opinion about which code means what.
	//
	// A set of top-level constants that reference each other in a closed chain, so none of them can
	// be evaluated. `names` lists the cycle's members in the order the evaluator met them. Renders as
	// E2012, positioned at the LAST-DECLARED member's name — see `ProgramSignatures.recordCycle`.
	circularConstants(names String, line LineNumber, column ColumnNumber)
	// A CALL in a top-level constant's initializer (`let RESULT = compute()`). Renders as E2045,
	// positioned at the callee's name. A call is not a constant expression: its answer needs the
	// program to be RUNNING, and a top-level `let` is folded before any of it exists. Both reference
	// compilers reject it with this exact text (2-Parser.cs:5280-5284; v1's `rejectCallInitializer`,
	// Parser.maxon:3971-3982).
	functionCallInConstant(callee String, line LineNumber, column ColumnNumber)
	// A top-level constant's initializer that the evaluator folded only in PART — it stopped at a
	// token it could not evaluate, with more of the line still to go. Renders as E2045, positioned at
	// the first token it could not fold.
	//
	// ⚠ WITHOUT THIS THE REMAINDER IS SILENTLY DISCARDED, and the declared value quietly becomes
	// something else. It is the failure mode the token-range model has and a tree model does not, and
	// the bootstrap pays for it in the same coin (`ExpectConstInitializerFullyConsumed`,
	// 2-Parser.cs:4971-4987, whose comment records `let B = "lit".toByteArray()` folding to the String
	// "lit" and only surfacing far away, at a use site, as a type mismatch).
	nonConstantInitializer(name String, leftover String, line LineNumber, column ColumnNumber)
	// A name in a top-level constant's initializer that no visible constant declares. Renders as
	// E2004 with the bootstrap's own text (2-Parser.cs:4950) — the same code its sibling
	// `undefinedVariable` reports under, because it is the same defect: a name with no binding. It is
	// a DISTINCT arm because the two are found by different machinery and say different words: at file
	// scope there is no `Scope` to have looked in, and "variable" would name something the source did
	// not write.
	undefinedConstant(name String, line LineNumber, column ColumnNumber)
	// A `/` or `mod` BY ZERO in a top-level constant's initializer (`let X = 1 / 0`), or the one other
	// integer division with no answer (`i64.min / -1`). Renders as E2045, positioned at the operator.
	//
	// A runtime `x / 0` is a trap, and shv2 lets it reach the hardware (OPEN.md #2). A CONSTANT one
	// cannot: there is no run time to trap in, because the fold happens before the program exists. So
	// there is no answer to give and no later pass that could give one, and the only honest move is to
	// reject it where it is written.
	//
	// AUTHORED, not ported — neither reference compiler gets this right. The bootstrap evaluates a
	// constant `1 / 0` through C#'s DOUBLE division and silently declares the constant Infinity
	// (2-Parser.cs:5113-5137); v1 has no division in constant expressions at all (its
	// `UnresolvedConstExpr` union carries `add`/`sub`/`mul` and no `div` — Project.maxon:3401-3423),
	// so the question never reaches it.
	constantDivisionByZero(op String, line LineNumber, column ColumnNumber)
	// A top-level constant cast whose LITERAL value is outside the ranged alias it is cast into
	// (`let BAD = 300 as Byte`). Renders as E3005 with the SAME words and format `InsertRangeChecks`
	// gives a body cast — `literalOutOfRangeMessage` — positioned at the `as` token. It is a distinct
	// arm rather than a runtime guard because a top-level `let` is CONST-ONLY (folded before any code
	// exists), so its only failure is the compile-time one; the runtime cascade a body cast can also
	// emit has no place to live here. The body-cast check happens in the Std pass off the recorded
	// site; a top-level `let` is not a function and records no site, so the const evaluator makes the
	// same call itself. `low`/`high` ride along so the message renders through the one
	// `formatRangeDisplay`, and `isFloat` with them — `value`, `low` and `high` are IEEE-754 BIT
	// PATTERNS for a float alias and numbers for an integer one, and the renderer cannot tell from the
	// payloads which it has been handed.
	constantCastOutOfRange(value ParsedInt, aliasName String, low ParsedInt, high ParsedInt, isFloat bool, line LineNumber, column ColumnNumber)
	// --- The struct arms (P1.0r) ---
	//
	// A struct literal (`Point{…}`) written outside the type's OWN methods. Renders as E3076,
	// positioned at the type name. Construction is restricted to the type's own methods and static
	// factories so a type's invariants have a SINGLE enforcement point — an external caller goes
	// through `Point.create(…)`. Both reference compilers impose the identical restriction under
	// the identical code.
	constructorRestricted(typeName String, line LineNumber, column ColumnNumber)
	// A field access (`p.x`) naming a field the struct does not declare. Renders as E3018,
	// positioned at the FIELD name — the token that is wrong, not the value it is read from.
	unknownField(typeName String, fieldName String, line LineNumber, column ColumnNumber)
	// A struct literal that omits a field the declaration gives no DEFAULT for. Renders as E3086,
	// positioned at the type name.
	//
	// ⚠ It is NOT tolerated by the allocator's zeroing guarantee, and that is worth saying because
	// the guarantee makes it look safe: an omitted slot would read back as 0, which is a plausible
	// number and therefore a WRONG ANSWER rather than a crash. `Point{x: 1}` would have `y == 0`
	// and nothing would say so.
	//
	// Field DEFAULTS (P1.1a wave 2) are what make an omission legal, and they NARROW this arm
	// rather than removing it: `applyFieldDefaults` fills every omitted slot that declares one
	// BEFORE `requireAllFieldsInitialized` looks, so what reaches here is a slot with no value from
	// either source. The message's "and it has no default value" is now a statement of fact.
	fieldNotInitialized(typeName String, fieldName String, line LineNumber, column ColumnNumber)
	// A struct literal that names one field twice (`Point{x: 1, x: 2}`). Renders as E3018 — the
	// same code an unknown field reports, because it is the same defect from the other side: the
	// literal's field list does not correspond to the type's. Positioned at the repeated name.
	duplicateFieldInitializer(typeName String, fieldName String, line LineNumber, column ColumnNumber)
	// --- The field-mutability arm (P1.1a wave 2) ---
	//
	// A write to a field declared `let` — `c.version = 2` where `version` is `export let`. Renders
	// as **E2013, the SAME code as `assignToImmutable`**, because it is the same defect reached
	// from the other side: a write to something declared not to accept one. A second code would
	// split one rule across two numbers, and a reader hitting either wants the identical advice.
	// (Precedent for many-variants-one-code: `unknownLoopLabel` reports `ErrorCode.controlOutsideLoop`.)
	//
	// It is a DISTINCT arm rather than a reuse of `assignToImmutable` because the two must say
	// different words — that one names a VARIABLE, and "cannot assign to immutable variable:
	// 'version'" would name something the source did not write, and would not tell the reader that
	// `var version` is the fix.
	//
	// ⚠ Positioned at the ROOT VARIABLE token, NOT the field — measured from the bootstrap, and
	// pinned at `:16:2` by `structs.md`'s `error.let-field-assign`.
	assignToImmutableField(typeName String, fieldName String, line LineNumber, column ColumnNumber)
	// --- The instance-method arms (P1.1a wave 3) ---
	//
	// A local or a parameter inside an instance method taking the name of a field of the enclosing
	// type — `let count = 5`, or `function bump(count Integer)`, inside a `type Counter` that
	// declares `count`. Renders as **E3006**, whose registry entry already covers this shape ("a
	// local declaration inside an instance method whose name collides with a `self.field`") beside
	// the duplicate-function one; the two are one fact — a name declared twice where exactly one
	// binding is legal.
	//
	// It is a REJECTION rather than a shadow, and the bootstrap's own message says why: the field
	// and the local would share one name-keyed entry, so every later read and write in the method
	// would silently resolve to whichever won. Positioned at the COLLIDING declaration, never at
	// the field — the local is what has to be renamed.
	localShadowsSelfField(name String, typeName String, line LineNumber, column ColumnNumber)
	// A read or a write of a field not declared `export`, from outside the type that declares it.
	// Renders as **E3014**. Positioned at the FIELD token — the name that is not accessible —
	// which is the bootstrap's anchor for the read (`:15:11`) and the write (`:15:4`) alike, and
	// is deliberately NOT `assignToImmutableField`'s root-variable anchor: that one is advice
	// about the BINDING (`var p`), this one is about the field itself.
	unexportedFieldAccess(typeName String, fieldName String, line LineNumber, column ColumnNumber)
	// --- The String-method arm (P1.2 wave D) ---
	//
	// A MUTATING String method (append) called on an IMMUTABLE (let-bound) receiver. Renders as
	// E3019 with the bootstraps exact framing -- cannot pass <name> to function that mutates
	// parameter self (in <function>) -- positioned at the METHOD name (the bootstraps anchor). The
	// bootstrap reaches this because it lowers a method to append(self, ...) and checks the receiver
	// against selfs mutation, machinery shv2 does not have for a builtin -- but the DEFECT and the
	// message are identical, so the code and words are the same. functionName rides along for the
	// (in ...) suffix, which names the enclosing function.
	immutableMutatingCall(name String, functionName String, line LineNumber, column ColumnNumber)
	// --- The scalar-match arms (P1.1b wave A) ---
	//
	// A stray token where a match EXPRESSION arm has finished — the `and` of an `and fallthrough`
	// after a `gives` arm. Renders as **E2001** `unexpected token: '<got>'`, positioned at the
	// stray token, exactly as both reference compilers reject it (v1
	// `rejectFallthroughInMatchExpression`; 2-Parser.cs:14860-14864): fallthrough is meaningless
	// where every arm must yield a value, and the Pratt climber has already stopped at the `and`
	// (see `parseBinary`), so the arm parser meets it as a leftover rather than as an operator.
	matchExpressionStrayToken(got String, line LineNumber, column ColumnNumber)
	// An arm body that both `return`s and falls through (`1 then return 10 and fallthrough`).
	// Renders as **E2025**, positioned at the `and`. The two cannot combine: a `return` has already
	// left the arm, so there is nothing for the fallthrough to carry control out of.
	matchFallthroughWithReturn(line LineNumber, column ColumnNumber)
	// A non-enum match with no `default` arm. Renders as **E2026**, positioned at the closing `end`.
	// `subject` is "match" or "match expression" so the one rule phrases the statement and
	// expression forms as both reference compilers do. A scalar match is exhaustive only through a
	// default: the language will not silently do nothing for an unmatched value.
	matchNotExhaustive(subject String, line LineNumber, column ColumnNumber)
	// Two arms test the same single value (`1 then … 1 then …`). Renders as **E2027**, positioned at
	// the duplicate pattern. `pattern` is the value as written, for the message.
	matchDuplicatePattern(pattern String, line LineNumber, column ColumnNumber)
	// A pattern whose type cannot be compared to the scrutinee's — a `"string"` pattern on an `int`
	// scrutinee, say. Renders as **E2028**, positioned at the pattern. Both type names ride along
	// because the message names both.
	matchPatternTypeMismatch(patternType String, scrutineeType String, line LineNumber, column ColumnNumber)
	// A pattern arm that follows the `default` arm. Renders as **E2029**, positioned at the stray
	// arm's pattern — `default` must be the last case so its catch-all cannot mask a later one.
	matchDefaultNotLast(line LineNumber, column ColumnNumber)
	// A `match <expr>` with no block label after the scrutinee. Renders as **E2042**, positioned at
	// the token where the label belongs (the one just past the scrutinee).
	matchMissingBlockId(line LineNumber, column ColumnNumber)
	// A `match … 'a' … end 'b'` whose closing label does not match the one it opened. Renders as
	// **E2043**, positioned at the `end` (not the wrong label) — both references anchor it there.
	matchMismatchedBlockId(expected String, got String, line LineNumber, column ColumnNumber)
	// A `then` arm body that is a block-opening statement (`if`/`while`/`for`/`match`). Renders as
	// **E2049**, positioned at the opening keyword. Each arm body is a single statement; a
	// block-opener would need a nested scope a single-line arm has no place for.
	matchBlockStatement(keyword String, line LineNumber, column ColumnNumber)
	// --- The enum/union arms (P1.1b wave B) ---
	//
	// An enum/union declares one case name twice. Renders as **E3030**, positioned at the second
	// declaration.
	enumDuplicateCase(caseName String, line LineNumber, column ColumnNumber)
	// Two enum/union cases declare the same raw value (`ok = 200  success = 200`). Renders as
	// **E3031**, positioned at the second case. `rawValue` is the value as the bootstrap prints it.
	enumDuplicateRawValue(rawValue String, line LineNumber, column ColumnNumber)
	// An enum/union case's raw value has a type other than the enum's declared backing (`ok = 100
	// fail = 5.0`). Renders as **E3032**, positioned at the offending case. `detail` is the
	// bootstrap's exact `expected <x>, got <y>` phrasing.
	enumRawValueTypeMismatch(detail String, line LineNumber, column ColumnNumber)
	// A `Color.red` literal, or a match arm, names a case the enum/union does not have. Renders as
	// **E3034**, positioned at the case name. `kindWord` ("enum"/"union") names the CONSTRUCT: the
	// reference compiler distinguishes them here (`IsUnion ? "union" : "enum"` in 2-Parser.cs), so a
	// bad case of a `union` reads "unknown union case", matching the bootstrap and shv2's own
	// E2026/E2046 rather than hardcoding "enum" (which disagreed with both).
	enumUnknownCase(kindWord String, caseName String, line LineNumber, column ColumnNumber)
	// A match arm names a case in QUALIFIED form (`Color.red`). Renders as **E3075**, positioned at
	// the type name — the scrutinee's enum is already known, so the bare name suffices.
	matchQualifiedCaseName(bare String, qualified String, line LineNumber, column ColumnNumber)
	// A `default` arm on an ENUM match that is not `default throws`/`default panic`. Renders as
	// **E2046**, positioned at the `default` — an enum match is exhaustive by listing every case, so
	// a plain catch-all is forbidden (it would silently mask a case added later). `kindWord` is
	// "enum" or "union"; `typeName` the enum's name.
	matchDefaultEnumMustThrow(kindWord String, typeName String, line LineNumber, column ColumnNumber)
	// An enum/union match does not cover every case and has no `default throws`. Renders as **E2026**,
	// positioned at the closing `end`. `missing` is the comma-joined names of the uncovered cases, in
	// declaration order — the enum twin of `matchNotExhaustive`.
	enumMatchNotExhaustive(kindWord String, typeName String, missing String, line LineNumber, column ColumnNumber)
	// Two arms cover the same enum case — a bare name repeated, or a case covered by both a range and
	// a later arm. Renders as **E2027**, positioned at the second (overlapping) arm.
	matchOverlappingCase(caseName String, line LineNumber, column ColumnNumber)
	// A range arm `high to low` whose upper case is declared BEFORE its lower case, so it covers no
	// cases. Renders as **E2027**, positioned at the range. `low`/`high` are the case names written.
	matchEmptyRange(low String, high String, line LineNumber, column ColumnNumber)
	// A `union` value is compared with `==`/`!=`. Renders as **E3066**, positioned at the operator.
	// A union carries no synthesized equality — `Container.value(1) == Container.value(1)` would
	// compare two BOX ADDRESSES, reference equality answering a question about values, the exact
	// hazard `comparableOperands` already refuses for two structs. An ENUM is unaffected (its value
	// IS its i64 tag, so `==` is a real tag compare); only `isUnion` triggers this. `op` is the
	// operator's spelling (`==`/`!=`) for the message.
	unionNotComparable(op String, line LineNumber, column ColumnNumber)
	// --- The reserved-name arm (P1.2 follow-up) ---
	//
	// A user DECLARATION whose name starts with `__` — the prefix Maxon reserves for compiler
	// internals (`__mm_alloc`, `__print_string`, `__destruct_String`, the `__discard_*` temporaries).
	// Renders as **E2051**, positioned at the declared name. Raised by `requireUnreservedName` at every
	// binding site — see there for why one call cannot be traded for eight copies of the check, and
	// why this reservation is what makes `MmRuntime.isCompilerInternalCallee` sound rather than a
	// hopeful shortcut. `name` is the offending identifier, for the message.
	reservedIdentifier(name String, line LineNumber, column ColumnNumber)
	// A user declaration giving a NOMINAL type identity to a name the COMPILER owns — `type Ordering`,
	// `enum HashValue`, a `function`/`Base with Args` typealias over either (`Ordering`, `HashValue`,
	// `ExitCode`; see `TypeResolution.isCompilerOwnedTypeName` for the coupling and the measured fault it
	// closes, and `requireTypeNameNotCompilerOwned` for why a RANGED typealias is legal). Renders as
	// **E2015**, positioned at the declared name. It is `reservedIdentifier`'s sibling: the same "a user
	// declaration may not take this name" rule over a different name set. `name` is the offending type
	// name, for the message.
	declarationTakesCompilerOwnedTypeName(name String, line LineNumber, column ColumnNumber)
	// --- The scalar-error arms (P1.4b) ---
	//
	// An `otherwise` handler with no `try` expression to attach to — `let v = mayFail() otherwise 0`.
	// Renders as **E3058**, positioned at the stray `otherwise`. It is a PARSE error and not a
	// SemanticCheck one because a bare `otherwise` builds no IR to inspect: the parser reaches it as an
	// unexpected token after a complete expression, and only the parser knows there was no `try`.
	otherwiseWithoutTry(line LineNumber, column ColumnNumber)
	// An error-handling TYPE MISMATCH at a `try … otherwise …`. Renders as **E3059**, ONE code with three
	// message variants (all built by `reportParseError` as `type mismatch: '<detail>'`): an `otherwise`
	// value whose type differs from the try's success type; an `otherwise ignore` used in value position;
	// or a value-position `try` on a VOID callee. `detail` is the inner message. Parse-time because each is
	// a fact about the `otherwise` syntax and the assignment context, which only the parser sees.
	errorTypeMismatch(detail String, line LineNumber, column ColumnNumber)
	// A BLOCK-FORM `try` inside a `match` arm — a `try 'label' … end` (grouping multiple calls) or a
	// block-handler `otherwise 'label' … end` — where an arm body must be a single statement. Renders as
	// **E2049** (the same code `matchBlockStatement` reports for `if`/`while`/… arm bodies), positioned at
	// the block label. `isOtherwiseForm` picks the message: the grouped-`try` form or the block-`otherwise`
	// form (both name the single-statement alternatives the arm can use instead).
	tryBlockFormInMatchArm(isOtherwiseForm bool, line LineNumber, column ColumnNumber)
	// A `try` applied to a call that cannot throw — `try noFail()`. Renders as **E3055**, positioned at the
	// `try` token. It is a PARSE error (not SemanticCheck's, where its throws-band siblings E3054/E3057 live)
	// for a positional reason: the reference gates it byte-for-byte at the `try` keyword, and only the
	// parser holds that token — the emitted `tryCall` op's span anchors on the callee, and the append-only
	// span table cannot be retargeted after the fact. `callee` names the non-throwing function.
	tryOnNonThrowing(callee String, line LineNumber, column ColumnNumber)
	// A `try` applied to a BUILTIN call that cannot throw — `try arr.count()`, `try print("x")`,
	// `try s.append(t)`, `try arr.push(1)`. Renders as **E3055** at the `try` token, exactly as its
	// user-function sibling above does; it is a second MESSAGE on one code, the same way `errorTypeMismatch`
	// carries three. It names NO callee on purpose: what the parser holds here is the emitted runtime symbol
	// (`__arr_count`), which the user never wrote and which the `__` reservation exists to keep out of user
	// space — the same reason `SemanticCheck`'s mirror E3057 for a bare throwing accessor describes the CLASS
	// instead of naming the symbol.
	tryOnNonThrowingBuiltin(line LineNumber, column ColumnNumber)
	// A plain `await p` of a promise whose thunk THROWS — `await` lowers to `__gt_await`, which drops the
	// error flag (P1.5-B2b). Renders as **E3057** (the throwing-call-needs-`try` code SemanticCheck reports
	// for an ordinary throwing call), positioned at the `await` token. It is a PARSE error because only the
	// parser holds the promise → awaited-callee mapping (the promise mark and the defining `asyncCall` are
	// per-function parse state). `callee` names the awaited throwing function.
	awaitThrowingPromiseNeedsTry(callee String, line LineNumber, column ColumnNumber)
	// A bare `try f()` / `try await p` (PROPAGATE form) whose propagated error type differs from the
	// enclosing function's `throws` type (P1.4b completion, exercised by P1.5-B2b). Renders as **E3059**,
	// positioned at the `try` token. Without `otherwise`, the caught flag is re-published verbatim into the
	// enclosing function's error register, so the caller would decode one enum's ordinals as another's tags —
	// a silent miscompile a boxed union turns into a wild free. `propagated` is the callee's error type,
	// `enclosing` the function's.
	propagateTypeMismatch(propagated String, enclosing String, line LineNumber, column ColumnNumber)
	// ⭐ A `__`-prefixed CALLEE written in source that names no compiler intrinsic (P1.0b step 2). Renders as
	// **E3004** — the SAME code `SemanticCheck.validateCall` gives `undeclaredThing()` — because it is the
	// same fact: the call names a function that does not exist. `__whatever()` and `whatever()` are one
	// mistake and must not answer with two codes.
	//
	// It is a PARSE error, and that is the one thing about it that needs a reason, because shv2 deliberately
	// moved "undefined function" OUT of the parser: a plain callee may be declared in another FILE, which
	// only the whole-program registry can see. A `__` callee cannot — `E2051` forbids DECLARING one anywhere
	// — so the parser has complete knowledge for exactly this family, and it is also the only tier that knows
	// the name came from SOURCE rather than from the compiler's own `emitRuntimeCall`. SemanticCheck cannot
	// tell those two apart, which is precisely why its `isCompilerInternalCallee` early return let this class
	// of program through to the backend (see `requireCalleeIsNotReservedName`).
	unknownCompilerIntrinsic(callee String, line LineNumber, column ColumnNumber)
	// ⭐ `resize` on an array whose element is MANAGED. Renders as **E3106**, positioned at the method
	// name. `__arr_resize` grows by publishing a longer length over slots `__arr_grow` left zeroed, and
	// a zero is an ELEMENT only while the element lives inline in the buffer; a managed element lives
	// there as a POINTER, so those slots are NULL. Maxon has no default constructor, so there is nothing
	// correct to put in them — the array that comes back answers `count()` = N while `get(0)` reports
	// the slot empty. `elementType` names the element, which is the whole point of refusing HERE: the
	// runtime cannot name it and the caller cannot see it.
	arrayResizeManagedElement(elementType String, line LineNumber, column ColumnNumber)
	// ⭐ A LABELLED CONTROL-FLOW BLOCK WITH NO STATEMENTS IN IT — `if c 'x' end 'x'`, and the same for
	// `else`, `while`, `for` and a block-form `otherwise` handler. Renders as **E3082**, positioned at
	// the closing `end` (which is where the missing statements would have gone) and naming the block's
	// LABEL. A function body is deliberately exempt — `function doNothing() end 'doNothing'` is legal —
	// which falls out of where the check lives: `parseBlockBody` parses every NESTED block and nothing
	// else. `label` is the block's own label, taken from its opening token rather than from the `end`'s
	// optional one, so a block closed by a bare `end` still names itself.
	emptyBlock(label String, line LineNumber, column ColumnNumber)
end 'ParseError'

// The result of recovering a promise handle's AWAITED callee name from its defining `asyncCall`
// (P1.5-B2b) — `found` for a real async spawn's result, `none` for a value that is not one.
union AsyncCalleeLookup
	found(callee ByteArray)
	none
end 'AsyncCalleeLookup'

// The set of promise values already visited while tracing a re-armed `var`'s merge phi back to a defining
// `asyncCall` (P1.5-B2 #88) — breaks the loop back-edge cycle in `resolveAsyncCallee`.
typealias AsyncCalleeVisited = Set with ValueId

// The awaited callee for one op if it is the `asyncCall` that minted `promise`, else `none` (keep scanning).
// Split from `asyncCallCalleeOf`'s loop so the equality test — which a match arm cannot host inline — lives
// in `foundCalleeIfEqual`, and the loop body stays one statement. The `call to indirectCall` / `await to
// tryAwait` band ranges cover every non-`asyncCall` op, so a newly appended op FAILS TO COMPILE here rather
// than being silently misclassified (the band-append invariant).
function asyncCalleeIfMatch(op MaxonOp, promise ValueId) returns AsyncCalleeLookup
	return match op 'op'
		call to indirectCall gives AsyncCalleeLookup.none
		asyncCall(result, callee, _, _, _, _) gives foundCalleeIfEqual(result, callee: callee, promise: promise)
		await to tryAwait gives AsyncCalleeLookup.none
		sizeofType gives AsyncCalleeLookup.none
		byteStringLiteral gives AsyncCalleeLookup.none
		switch gives AsyncCalleeLookup.none
		witnessDispatch to witnessTryDispatch gives AsyncCalleeLookup.none
	end 'op'
end 'asyncCalleeIfMatch'

// `found(callee)` when `result` IS the tracked promise (this `asyncCall` minted it), else `none`.
function foundCalleeIfEqual(result ValueId, callee ByteArray, promise ValueId) returns AsyncCalleeLookup
	if result == promise 'eq'
		return AsyncCalleeLookup.found(callee)
	end 'eq'
	return AsyncCalleeLookup.none
end 'foundCalleeIfEqual'

// A `MaxonReturnType` as a value tag, VOID included — the void-tolerant twin of `maxonReturnTypeTag` (which
// panics on void), because an async result may legitimately be void (P1.5-B2b: a void throwing async carries
// only an error flag). Delegates the value case rather than re-matching it.
function asyncReturnTypeTag(returnType MaxonReturnType) returns ValueTypeTag
	if maxonReturnTypeIsVoid(returnType) 'void'
		return ValueTypeTag.void
	end 'void'
	return maxonReturnTypeTag(returnType)
end 'asyncReturnTypeTag'

// **THE NAME OF THE RECEIVER PARAMETER.** An instance method's parameter 0, pushed by
// `parseFunction` and bound by `bindParameters` exactly like every other parameter — so the
// receiver's SSA value, its register, and its slot in a call's argument list are all decided by
// machinery that does not know what a method is.
//
// It is v1's spelling (`SELF_PARAM_NAME = "__self"`, IR/Maxon/MaxonDialect.maxon:15), taken so the
// two compilers' IR reads the same way to anyone who has read either.
//
// ⚠ It is an ORDINARY IDENTIFIER, so a body that writes `__self` resolves it and gets the
// receiver — an internal name reachable from source. v1 has the identical hole. It is not exploited
// by anything and no corpus case names it; the alternative (binding the receiver under the `self`
// KEYWORD's own text, which no parameter can ever be called) closes it for free but departs from
// both references' convention, so it is recorded here rather than taken unilaterally.
export let SelfParamName = b"__self"

// The empty `MutatedParamMask` — this function writes none of its parameters, which is the overwhelmingly
// common answer and the initial value of every function's mask.
export let NoMutatedParams = 0 as MutatedParamMask

// **THE SOURCE SPELLING OF THE RECEIVER PARAMETER.** `__self` is the IR's name for it; `self` is the
// KEYWORD the user actually wrote, and the only one a diagnostic may quote back at them — a message
// naming `__self` would name an identifier that appears nowhere in their program (and one the language
// reserves). Both reference compilers print `self`.
export let SelfParamDisplayName = "self"

// A parameter's name AS A DIAGNOSTIC PRINTS IT. Only the receiver differs from its IR name; every other
// parameter is spelled exactly as it was declared.
export function displayParamName(name ByteArray) returns String
	return SelfParamDisplayName if name.equals(SelfParamName) else String.from(name)
end 'displayParamName'

// ⭐ **THE ONE WIRE FORMAT OF E3019.** Its two producers are deliberately far apart — the RECEIVER half is
// a `ParseError` the parser throws at the method token (`noteReceiverWrite`, rendered by `Queries`), and
// the CALL-SITE half is a diagnostic SemanticCheck reports at the call, because only it holds the callee's
// whole-program summary — so the sentence itself lives here, where neither owns it. They differ in exactly
// one field: the receiver half's written parameter is always the container's `self`, while the call-site
// half names whichever parameter of the callee the argument filled.
export function immutableMutatingCallMessage(blamed String, paramName String, functionName String) returns String
	return "cannot pass '{blamed}' to function that mutates parameter '{paramName}' (in {functionName})"
end 'immutableMutatingCallMessage'

// A generic type's bare-method-name -> "does it carry a layout-descriptor param?" map (P1.6-B1). See
// `Parser.typeDescriptorNeeds`.
typealias DescriptorNeedMap = Map with (ByteArray, bool)

// The enclosing type's bare-method-name -> "does it take a receiver?" map (#65 implicit-self resolution).
// A bare call `foo(…)` inside a method of the type resolves to the sibling method `foo`; the flag decides
// whether the enclosing `self` is prepended (an instance method) or not (a `static` one). See
// `Parser.siblingReceiverMap`.
typealias SiblingReceiverMap = Map with (ByteArray, bool)

// A generic method's bare name -> the sibling methods it calls on `self` (P1.6-B1) — the self-call edges the
// descriptor-need fixpoint (`solveDescriptorNeedFixpoint`) propagates over.
typealias SelfCalleesMap = Map with (ByteArray, ByteArrayArray)

// A generic method's bare name -> its dense index in the type's method list (P1.6-B1). The descriptor-need
// fixpoint reverses the self-call graph into the shared CSR adjacency (`buildCsr`, over CsrGraph's dense
// `CsrIndex` key space) keyed by this dense index, so it stays borrow-safe (the ownership model forbids
// appending to an array stored inside a map).
typealias MethodIndexMap = Map with (ByteArray, CsrIndex)

// A single shared EMPTY descriptor-need map, held as the INITIAL `Parser.typeDescriptorNeeds` so a parser
// allocates none of its own (a per-file sweep parser never touches the field at all). A generic type REPLACES
// the field with a fresh map (`computeTypeDescriptorNeeds`), and a non-generic method never reads it (gated on
// `enclosingTypeParams`), so this shared instance is only ever an unread placeholder and is never mutated —
// safe to share across the per-file parse fan-out.
let sharedEmptyDescriptorNeeds = DescriptorNeedMap.create()

// The INITIAL `Parser.enclosingWhereConstraints` (P1.7a slice 2a), held here (like
// `sharedEmptyDescriptorNeeds`) so a type with no `where` clause — every type on the generics-free corpus —
// allocates nothing. `readWhereClause` REPLACES the field with a fresh list only when the clause is present,
// and it is never mutated in place, so this shared instance is safe across the per-file parse fan-out.
let sharedEmptyWhereConstraints = WhereConstraintArray.create()

// The INITIAL `Parser.siblingReceivers`, held here (like `sharedEmptyDescriptorNeeds`) so a parser
// allocates none of its own until a bare call inside a type body actually needs the map. The lazy builder
// REPLACES the field with a fresh map — it never mutates in place — so this placeholder stays empty and is
// safe to share across the per-file parse fan-out. A method-free file never touches the field at all.
let sharedEmptySiblingReceivers = SiblingReceiverMap.create()

// The module-level shared empty type-parameter-FEED array (P1.6-B2) every non-generic consuming function's
// `ParamConsumeInfo` holds — a feed requires a type parameter, so such a function never fills one and it is
// never mutated. ONE allocation for the whole compile (like `sharedEmptyDescriptorNeeds`), so a generics-free
// program pays nothing per function OR per parser (`typeParamFeedOf` reads a missing index as `none`).
let sharedEmptyTypeParamFeeds = TypeParamFeedArray.create()

// The module-level shared EMPTY per-instance-alias placeholders (P1.6-C), held as the INITIAL value of the
// `enclosingInnerAliases` / `valueInstanceAlias` working fields AND as the COW anchors the reset points at.
// ONE allocation for the whole compile each (like `sharedEmptyDescriptorNeeds`), so a generics-free program
// — which never declares a nested typealias nor constructs a generic instance — pays NOTHING per parser: a
// parser INCREFS these rather than allocating its own. They are never mutated: `readNestedRangedAlias` and
// `recordValueInstanceAlias` copy-on-write a fresh collection the first time they must write, keyed on the
// `is`-identity of these very instances, so the shared ones stay empty and safe to share across the per-file
// parse fan-out — exactly the invariant `sharedEmptyDescriptorNeeds`/`sharedEmptyTypeParamFeeds` rely on.
let sharedEmptyInnerAliases = InnerAliasNameSet.create()
let sharedEmptyInstanceAliasMap = ValueInstanceAliasMap.create()

// The module-level shared EMPTY immutable-global-read set (P1.7 slice 2b), held as the initial value of
// `immutableGlobalReads` AND as the COW anchor its reset points at — `sharedEmptyInstanceAliasMap`'s pattern,
// for its reason and with its invariant. A program that declares no immutable top-level global with STORAGE
// (which is every program with no array `let`) never writes it, so it stays empty, is safe to share across
// the per-file parse fan-out, and costs a fixed handful of allocations for the whole compile rather than one
// structure per function. `Set.contains` on a zero-capacity set returns before it hashes anything, so the
// programs that never mark also never pay to ask.
let sharedEmptyImmutableGlobalReads = ImmutableGlobalReadSet.create()

// The module-level shared EMPTY iteration-lock stack (P1.8 slice A), held as the initial value of
// `iterationLockedBindings` AND as the COW anchor its per-function reset points at —
// `sharedEmptyInstanceAliasMap`'s pattern, for its reason and with its invariant. It is not a micro-
// optimization: a `Parser` is built PER TOP-LEVEL CONSTANT by `SignatureIndex.walkConstInitializer`, so
// an unconditional `create()` in the constructor is one allocation per constant in the program.
// MEASURED, A/B against the parent built in the same worktree: it billed `phase:signatures`
// +96/+165/+303/+579/+1131/+2235 allocations across the doubling ladder — perfectly linear, and for a
// stack that is EMPTY unless a `for … in` body is being parsed. `lockIterationSource` copy-on-writes a
// fresh array the first time it must push, keyed on this instance's `is`-identity, so the shared one
// stays empty and safe across the per-file parse fan-out.
let sharedEmptyIterationLocks = VarInfoArray.create()

// The module-level shared EMPTY table of E3070 module-storage subject stand-ins, held as the initial value
// of `Parser.topLevelBorrowSubjects` AND as the COW anchor `topLevelBorrowSubjectOf` keys on —
// `sharedEmptyIterationLocks`'s pattern, for its reason and with its invariant. It is never mutated (the
// minting path REPLACES the field with a fresh map before its first upsert), so it stays empty and is safe
// across the per-file parse fan-out; and a `Parser` is built per top-level constant, so an unconditional
// `create()` in the constructor would be one map per constant in the program.
let sharedEmptyTopLevelBorrowSubjects = VarInfoMap.create()

// The NAME-keyed twin delivered to SemanticCheck for a function that has range checks but constructs no
// instance — read-only and STORED into `FunctionRangeChecks` (increfed, so sharing is safe), never mutated.
let sharedEmptyInstanceAliasNames = ValueInstanceAliasNameMap.create()

// The signals one method's body contributes to the descriptor-need fixpoint (P1.6-B1): whether it directly
// reads `sizeof(T)`, the siblings it calls on `self`, and the token position just past its `end` (so the
// type-body walk resumes there). `hasControlFlow` (P1.7 slice 3b-v) records whether the body is NOT
// straight-line — a nested block-opener, or a `return`/`throw`/`break`/`continue` — the sound over-approximation
// of "an opaque feed parameter could be left live at some exit and DROP through `__drop_type_param`", which
// needs the layout descriptor: a straight-line body unconditionally consumes its feed, so it never drops.
// `hasArrayMoveOut` (P1.7 slice 3b-vi-a) records whether the body calls `.pop()`/`.remove()` on ANY receiver:
// the pre-scan cannot resolve the receiver, so any array move-out in a generic instance body is treated as a
// potential OPAQUE move-out whose owned `typeParameter` result drops through the descriptor-gated
// `__drop_type_param` — reaching that drop through a field (`self.items.pop()`), a local (`let a = self.items`)
// or a parameter alike, none of which a receiver-blind token scan can tell apart.
// `reassignsOpaqueField` (P1.7 Finding A) records whether the body REASSIGNS a bare opaque `typeParameter` field
// of `self` that some instantiation makes MANAGED (`self.saved = next` on `Box with String`): that write DROPS
// the field's old value through the descriptor-gated `__drop_type_param`, so the method needs the layout
// descriptor — the same class as the array move-out, reached through a field STORE rather than a move-out call.
// `hasArrayCopy` (P1.7 slice 3b-vi-b-β) records whether the body calls `.slice()`/`.clone()`/`.append()` on ANY
// receiver: a copy of an OPAQUE array lowers to `__arr_{slice,clone,append}_opaque(arr, …, descriptor)`, which
// reads the enclosing instance's `copyFunc@32` — so, like the move-out, a receiver-blind copy in a generic body
// reserves the layout descriptor (over-reserving for a concrete-array copy is sound). Returned by
// `Parser.scanOneMethodDescriptorSignals`.
type MethodDescriptorScan
	export let direct as bool
	export let callees as ByteArrayArray
	export let hasControlFlow as bool
	export let hasArrayMoveOut as bool
	export let reassignsOpaqueField as bool
	export let hasArrayCopy as bool
	export let endPos as TokenIndex

	export static function create(direct bool, callees ByteArrayArray, hasControlFlow bool, hasArrayMoveOut bool, reassignsOpaqueField bool, hasArrayCopy bool, endPos TokenIndex) returns MethodDescriptorScan
		return Self{direct: direct, callees: callees, hasControlFlow: hasControlFlow, hasArrayMoveOut: hasArrayMoveOut, reassignsOpaqueField: reassignsOpaqueField, hasArrayCopy: hasArrayCopy, endPos: endPos}
	end 'create'
end 'MethodDescriptorScan'

// ⭐ **ONE SELF-CALL FORWARD EDGE for the transitive array-feed fixpoint (P1.7 slice 3b-iv)** — the caller's
// CALL-ALIGNED parameter `callerParamPos` is passed to the sibling method `calleeName` as an argument: its FIRST
// positional argument when `argLabel` is empty, or the labelled argument `argLabel:` otherwise. The callee's own
// parameter position is resolved once every sibling's parameter list is known
// (`Parser.solveAndPublishTransitiveFeeds`), exactly as a call site slots a labelled argument against the
// callee's `paramNames` and the first positional argument against slot 1 (the receiver being slot 0).
type ForwardFeedEdge
	export let callerParamPos as ParamCount
	export let calleeName as ByteArray
	export let argLabel as ByteArray

	export static function create(callerParamPos ParamCount, calleeName ByteArray, argLabel ByteArray) returns ForwardFeedEdge
		return Self{callerParamPos: callerParamPos, calleeName: calleeName, argLabel: argLabel}
	end 'create'
end 'ForwardFeedEdge'

export typealias ForwardFeedEdgeArray = Array with ForwardFeedEdge

// ⭐ **ONE GENERIC INSTANCE METHOD's FEED SIGNALS for the transitive array-feed fixpoint (P1.7 slice 3b-iv)** —
// its CALL-ALIGNED parameter names and type-parameter positions (`SelfParamName` at slot 0, matching the
// receiver-prepending call site), the DIRECT array-mutator feeds its body performs (`self.items.push(param)`),
// and the self-call forward edges out of it (`self.N(param)` / bare-sibling `N(param)`). `endPos` is the token
// just past the method's `end`, so the type-body walk resumes there. Returned per method by
// `Parser.scanOneMethodFeedSignals`.
type MethodFeedScan
	export let funcName as ByteArray
	export let paramNames as ByteArrayArray
	export let typeParamPositions as TypeParamIdArray
	export let directFeeds as TypeParamFeedArray
	export let edges as ForwardFeedEdgeArray
	export let endPos as TokenIndex

	export static function create(funcName ByteArray, paramNames ByteArrayArray, typeParamPositions TypeParamIdArray, directFeeds TypeParamFeedArray, edges ForwardFeedEdgeArray, endPos TokenIndex) returns MethodFeedScan
		return Self{funcName: funcName, paramNames: paramNames, typeParamPositions: typeParamPositions, directFeeds: directFeeds, edges: edges, endPos: endPos}
	end 'create'
end 'MethodFeedScan'

export typealias MethodFeedScanArray = Array with MethodFeedScan

// The prefix Maxon RESERVES for compiler-internal names — every symbol the compiler emits
// (`__mm_alloc`, `__print_string`, `__destruct_String`, the `__discard_*` parser temporaries, and
// `__self` above) starts with it. `requireUnreservedName` forbids a USER DECLARATION from taking it.
//
// It is the same value `MmRuntime.CompilerInternalPrefix` tests a CALLEE against, and deliberately so:
// the two are the two ends of one fact. That predicate skips a `__`-named callee's user-function
// checks on the promise that no user `__` name exists — a promise ONLY this reservation can keep. The
// value is duplicated across the two modules rather than shared because they answer opposite questions
// at opposite tiers (a parser reading USER TOKENS; a lowering reading EMITTED CALLEES) and a runtime
// module owning the parser's reservation, or the reverse, would be the worse coupling. The language
// rule that `__` is reserved is what binds them, not a shared symbol.
let ReservedNamePrefix = b"__"

// The receiver a call carries, if any. A union rather than a `ValueId` plus a bool, and rather
// than a reserved id: `ValueId` has no empty value and a sentinel would be READ as a real argument
// by everything downstream (`retVoid` exists in the Maxon dialect for precisely this reason).
// `none` is every free and static call; `value` is an instance method's receiver.
union ReceiverArg
	none
	// `immutableName` is the E3019 blame name for the receiver AS AN ARGUMENT — empty when it may be
	// written through. It rides the receiver because `parseCallNamed` prepends the receiver at argument 0
	// and the fourth argument column needs one entry per argument (`pushCallArg`).
	//
	// `subjectName` is E3070's parallel fact about the same argument: the STORAGE the receiver denotes,
	// empty when it denotes none. The two are NOT the same string and must not be merged — `immutableName`
	// is non-empty only when the binding refuses a write, while a `var` receiver has a subject and no blame
	// name at all, and `b.wipe()` on a `var b` is exactly the conflict this rung closes. It rides here for
	// the reason the blame name does: `parseCallNamed` prepends the receiver as ARGUMENT 0, and a caller
	// holding only the box has lost which binding it came from.
	value(id ValueId, immutableName ByteArray, subjectName ByteArray)
end 'ReceiverArg'

// ⭐ **THE CONCRETE GENERIC INSTANCE A STATIC CONSTRUCTOR CALL BUILDS (P1.6-B2)**, or `none`. Only a
// generic-alias constructor (`StrBox.create(…)`) carries one — it is what tells the caller-side consume
// which argument OWNS its box's managed content and must be MOVED in. Every other call (a plain free call,
// an instance method) borrows its arguments exactly as before.
union ConstructorInstance
	instance(id GenericInstanceId)
	none
end 'ConstructorInstance'

// ⭐ **THE TWO SHAPES A NESTED (inner) TYPEALIAS TAKES (P1.6-C / P1.7 slice 3b-i).** A `typealias Idx =
// int(0 to N)` is a RANGED per-instance alias; a `typealias ElementArray = Array with T` is a
// GENERIC-INSTANCE alias whose instance (`Array with typeParameter(pos)`) is partially opaque. Both record
// their bare member into `enclosingInnerAliases` (so a later bare reference resolves), but they fold into
// DIFFERENT whole-program registries — the ranged one into `innerAliases`, the generic one into
// `genericAliases` under its base-qualified name — so `readNestedTypeAlias` hands the caller the shape it
// read and the caller routes it to the right collection.
union NestedAliasResult
	ranged(alias RangedTypeAlias)
	genericInstance(entry GenericAliasEntry)
end 'NestedAliasResult'

// The BOX a field access goes through, paired with the LAYOUT that says what is inside it.
//
// ⭐ **ONE ANSWER, BECAUSE IT IS ONE QUESTION** — and because the two halves drifting apart is a
// wrong answer rather than a compile error. `requireStructBase` proves a binding is a struct and
// hands back the value holding its pointer, together; a caller cannot end up with a layout it
// PROVED beside a box it merely ASSUMED. They were two separate reads off one `VarInfo` at three
// call sites, and one of the two reads was wrong at all three — see `requireStructBase`.
type StructBase
	export let layout as StructLayout
	export let box as ValueId
	// The name an E3019 would blame for a write through this base, EMPTY when it may be written through
	// (`immutableReceiverNameOf`). It travels with the box for the same reason the layout does: a method
	// dispatched on this base prepends the box as ARGUMENT 0, and the argument's blame name is a fact
	// about the BINDING the base came from — which is exactly what a caller holding only the box has lost.
	export let immutableName as ByteArray
	// E3070's parallel fact — the STORAGE this base denotes, empty when it denotes none. Travels with the
	// box for the identical reason `immutableName` does, and is a DIFFERENT string from it: see
	// `ReceiverArg.value`, which carries the same pair on to the call.
	export let subjectName as ByteArray

	export static function create(layout StructLayout, box ValueId, immutableName ByteArray, subjectName ByteArray) returns StructBase
		return Self{layout: layout, box: box, immutableName: immutableName, subjectName: subjectName}
	end 'create'
end 'StructBase'

// The resolved END of a field-access chain `base.f1.…fN` (P1.4a wave 2): the `box` its LAST field lives in
// (the base's box for a single field, an intermediate struct field's loaded box for a chain), the `layout`
// that box has, the `lastFieldTok` naming the field still to read or write, and the `baseTok`/`baseBinding`
// the chain started from (the write path needs the base binding for its mutability check). `resolveFieldChain`
// is the one producer; a chained read and a chained write are its two consumers.
type FieldChainStep
	export let box as ValueId
	export let layout as StructLayout
	export let lastFieldTok as Token
	export let baseTok as Token
	export let baseBinding as VarInfo

	export static function create(box ValueId, layout StructLayout, lastFieldTok Token, baseTok Token, baseBinding VarInfo) returns FieldChainStep
		return Self{box: box, layout: layout, lastFieldTok: lastFieldTok, baseTok: baseTok, baseBinding: baseBinding}
	end 'create'
end 'FieldChainStep'

// --- Ranged-typealias range bounds ---
//
// The inclusive bounds each sized numeric type's `.min` / `.max` denotes in a range
// declaration (`typealias Handle = int(0 to u32.max)` — specs/ranged-typealias.md).
// Spelled with the very range identifiers they define, so the table cannot drift from
// the language it implements.
//
// `u64.max` does NOT fit a signed 64-bit field, and it rides here as the SAME BIT
// PATTERN `ParsedInt` holds for it (Maxon stores it as the signed -1). That is not a
// lossy stand-in: it is exactly the representation a value in an unsigned-domain alias
// has at runtime, so a future range check compares against it directly.
let U8MaxBound = u8.max as ParsedInt
let U16MaxBound = u16.max as ParsedInt
let U32MaxBound = u32.max as ParsedInt
let U64MaxBound = u64.max as ParsedInt

// Every unsigned type's lower bound. One constant, not four: `u8.min` and `u64.min`
// are the same zero, and a per-type spelling would only invite them to drift apart.
let UnsignedMinBound = 0 as ParsedInt
let I8MinBound = i8.min as ParsedInt
let I8MaxBound = i8.max as ParsedInt
let I16MinBound = i16.min as ParsedInt
let I16MaxBound = i16.max as ParsedInt
let I32MinBound = i32.min as ParsedInt
let I32MaxBound = i32.max as ParsedInt

// Exported because the integer-literal overflow diagnostic names this same span — the range a BARE
// literal must fit — and a second spelling of the i64 extremes could drift from the one `parseInt`
// actually enforces.
export let I64MinBound = i64.min as ParsedInt
export let I64MaxBound = i64.max as ParsedInt

// The finite extremes `f32`/`f64`'s `.min` / `.max` denote in a `float(...)` range declaration live
// in TypeRules (`F64MaxBound` and friends), beside the range predicates that COMPARE against them —
// `rangeIsFull` has to recognize the full f64 span, and the parser has to resolve `f64.max` to it.

// The `.min` / `.max` field names a type-qualified bound may carry.
let MinBoundField = b"min"
let MaxBoundField = b"max"

// Can a PARAMETER be written? No — a reassignment to one is E2013, and mutating a parameter needs
// a local shadow.
//
// **It is NAMED because a second, distant thing depends on the answer and does not look like it
// does**: `namesAssignedIn`, the loop-phi token scan, is exhaustive only while every write to a
// mutable binding is spelled `identifier =` — which a `var` parameter's call-site write is not.
// Written as a bare `false` at the binding site, that coupling was invisible from both ends. The
// tripwire that enforces it lives in `bindParameters`, on the flag itself; this constant is what
// it currently reads.
let ParametersAreMutable = false

// The discard binding name — `walk(_)` matches the case but binds no payload. It is an ordinary
// identifier to the lexer (`_` is a legal identifier), so the payload-binding reader recognizes it
// by TEXT and skips the load + declaration for that slot. A constant because it is a language fact
// (`_` means discard), spelled once.
let DiscardBindingName = b"_"

// How many `.field` HOPS a token-level field-chain walk must find (`Parser.fieldChainEndAfter`). A
// chain-METHOD call needs at least two (`b.ops.push(1)`) — the ONE-hop `b.push(1)` is the binding-
// receiver path's, which `methodCallsAt` takes — while a `for … in` source lock accepts any chain at
// all, a bare name (zero hops) included.
typealias FieldHopCount = int(0 to 255)

let ChainMethodMinHops = 2 as FieldHopCount
let AnyFieldHops = 0 as FieldHopCount

// The label of the placeholder block a Parser holds before it has parsed a function. It
// belongs to no function and is registered in no module; `parseFunction` replaces it
// before any op is emitted. Named so that if one ever DID reach the IR, the printed block
// label would say exactly what went wrong.
let DetachedBlockLabel = b"detached"

// ⭐ What joins a type's name to a method's in the name a method is DECLARED and CALLED under:
// `Point.create`. A dot, VERBATIM — the mangled name carries the separator the source wrote, which
// is what both reference compilers emit and what a golden fragment therefore shows.
//
// It is a constant because two very distant places must spell it identically: `declaredMethodName`
// (which names the `IrFunction` and its `funcSignatures` key) and `parseQualifiedCall` (which
// builds the callee of `Point.create(3, y: 4)`). Written twice, a change to the mangling would
// leave every method declared under one name and called under another — and the failure would be
// E3004 "call to undefined function 'Point.create'", pointing at a call that is perfectly correct.
let MethodNameSeparator = "."

// The same separator as a BYTE, for the join's INVERSE (`isQualifiedUnderTypeName`), which compares one
// byte of a callee name and must not allocate.
//
// ⚠ **YES, THIS IS THE SEPARATOR WRITTEN DOWN TWICE — DELIBERATELY, AND WITH A CHECK BETWEEN THE COPIES.**
// The single-constant version was written first and MEASURED: rendering a `ByteArray` separator into the
// join costs one extra `String.from` per `qualifiedMethodName` call, and that function runs once per method
// DECLARATION, once per method CALL SITE and again in the declaration pre-scan — so the cost is LINEAR in
// the program. scale-test read it as +338/+570/+1,034/+1,962/+3,818/+7,530 allocations across the doubling
// ladder (a ratio converging to 2.00 from below: a linear term, not the flat install cost it was mistaken
// for). A cosmetic single-spelling is not worth a linear term on the compiler's hottest name mangler.
//
// What makes the duplication safe is not this comment: it is that the two copies have a TEST between them.
// Every direct builtin-conformance dispatch resolves through `isCompilerInternalCallee` →
// `isBuiltinConformanceImplName` → `isQualifiedUnderTypeName`, so a byte here that disagrees with the join
// above makes EVERY direct builtin-conformance call fail to be recognized as compiler-owned, and every
// `primitive-comparable`/`primitive-hashable`/`method-call-on-call-result` case goes RED with E3004. The
// copies cannot drift silently.
//
// ⚠ It deliberately quotes neither the impl roster nor a case COUNT. Both were written out here, and both
// were stale within one rung of being written — the count said "eight" when there were nineteen. What the
// check is worth does not depend on the number, and a number nothing verifies is just a second place to be
// wrong.
let MethodNameSeparatorBytes = b"."

// `Point.create` — the name a type's method is declared and called under. ONE spelling, read by
// `Parser.declaredMethodName` (the declaration) and `Parser.parseQualifiedCall` (the use). See
// `MethodNameSeparator` for what a second spelling would cost.
export function qualifiedMethodName(typeName ByteArray, methodName ByteArray) returns ByteArray
	return "{String.from(typeName)}{MethodNameSeparator}{String.from(methodName)}".toByteArray()
end 'qualifiedMethodName'

// ⭐ **DOES `name` WEAR `typeName`'S QUALIFIER — i.e. is it `qualifiedMethodName(typeName, <anything>)`?**
// The join's INVERSE, and deliberately allocation-free: its caller
// (`IrInterface.isBuiltinConformanceImplName` → `MmRuntime.isCompilerInternalCallee`) is asked of EVERY
// callee in the program by `SemanticCheck.validateCall` and `LowerMaxonToStd.lowerCall`, so materializing
// a joined name here would allocate once per call site in every compile.
//
// ⚠ **THE SEPARATOR TEST IS LOAD-BEARING, NOT TIDINESS.** Without it this is a bare `bytesStartWith`, and
// a user function called `internNames` begins with `int` — it would be classified compiler-internal and
// so skip arity validation and signature slotting. A miscompile, from a missing byte compare.
export function isQualifiedUnderTypeName(name ByteArray, typeName ByteArray) returns bool
	if name.count() <= typeName.count() 'noRoomForAMethod'
		return false
	end 'noRoomForAMethod'
	if not bytesStartWith(name, prefix: typeName) 'differentType'
		return false
	end 'differentType'

	let separator = try MethodNameSeparatorBytes.get(0) otherwise panic("isQualifiedUnderTypeName: MethodNameSeparatorBytes is a one-byte literal")
	return (try name.get(typeName.count()) otherwise panic("isQualifiedUnderTypeName: index {typeName.count()} is below count {name.count()} by the guard above, but get failed")) == separator
end 'isQualifiedUnderTypeName'

// ⭐ THE TRIVIAL DESTRUCTOR — the `destructor` argument every `__mm_alloc` at this rung passes.
//
// **NULL IS THE ANSWER, NOT A PLACEHOLDER.** Every struct P1.0r can declare has scalar fields
// only, so nothing has to run when its box dies: there is no function to point at, and
// synthesizing an empty `__destruct_Point` to have a non-null pointer would be a function with no
// reason to exist. The bootstrap oracle agrees exactly — it emits `xor edx, edx` for a Point, and
// reaches for a real `lea_func [__destruct_Outer]` only once a field is itself heap-allocated.
//
// It is what keeps `funcAddr`/`callIndirect` out of this rung: the op pair that TAKES a function's
// address and CALLS one through a register has no consumer while this is 0, so it arrives at P1.2
// with `__destruct_String` — a caller that is a real reason to be right, because a String that
// does not free its buffer leaks and the leak gate says so. See `MmRuntime.buildMmFree`.
//
// EXPORTED because a top-level array global's record is stamped by `ModuleInit` (P1.7 slice 2b) rather than
// by this file, and "no destructor" must be the same number in both — a second spelling of 0 is a second
// thing to get wrong on the day it stops being 0.
export let TrivialDestructor = 0 as ParsedInt

// An array literal's elements must all have the FIRST element's type — one rule, so one wording, read by
// the two walks over that grammar: the emitting one in a function body (`requireArrayLiteralElementMatches`)
// and the folding one at top level (`evalConstArrayLiteral`, P1.7 slice 2b). Two copies would let the same
// mistake be described two ways depending on where it was written.
let MixedArrayLiteralElementsMessage = "an array literal with mixed element types — every element must have the same type as the first"

// ⚠ **THE EMPTY LITERAL IS REFUSED IN BOTH POSITIONS AND THE ADVICE DIFFERS, so this text is deliberately
// NOT shared with `parseArrayLiteral`'s.** The defect is identical — `[]` carries no element to infer a
// type from — but a function body's remedy is `Array with T` + `.create()`, and a top-level initializer must
// be a CONSTANT, so a `create()` call is not available to it (E2018 in a constant). Pointing a user at a
// remedy their position forbids is worse than saying less. The runnable oracle refuses it here too.
let EmptyConstArrayLiteralMessage = "an empty array literal `[]` as a top-level initializer — its element type cannot be inferred, and there is no empty-array form a constant initializer can name (a `.create()` call is not a constant)"

// The result of resolving a `<sized>.min` / `<sized>.max` bound. A union, so the
// caller can tell the two REJECTIONS apart and name the actual gap in its diagnostic
// (a float bound is a missing FEATURE; an unknown name is a typo).
union SizedTypeBound
	value(bound ParsedInt)
	// `f32` / `f64` — the bound is a FLOAT extreme, carried as the IEEE-754 f64 bit pattern
	// `ParsedInt` holds (a float alias resolves to `MaxonType.float` = f64). Legal only inside a
	// `float(...)` typealias; the int-alias and expression callers reject it (`floatBoundInFloatAlias`).
	floatBound(bits ParsedInt)
	notASizedType
end 'SizedTypeBound'

// The bound `<typeName>.<min|max>` denotes, for the eight sized INTEGER types plus `f32`/`f64`
// (whose bounds ride as f64 bit patterns — see `floatBound`). Shared by the range-declaration
// parser (`typealias Port = int(0 to u16.max)`, `typealias Pct = float(f64.min to f64.max)`) and
// the expression parser (`let x = u16.max`), which are the same three tokens in two positions — so
// they resolve through one table rather than two that can disagree. Whether a float bound is LEGAL
// in a given position is the caller's decision, not this table's: it only says what the tokens name.
function sizedTypeBound(typeName ByteArray, wantMax bool) returns SizedTypeBound
	if typeName.equals(b"u8") 'u8'
		return SizedTypeBound.value(pickBound(UnsignedMinBound, high: U8MaxBound, wantMax: wantMax))
	end 'u8'
	if typeName.equals(b"u16") 'u16'
		return SizedTypeBound.value(pickBound(UnsignedMinBound, high: U16MaxBound, wantMax: wantMax))
	end 'u16'
	if typeName.equals(b"u32") 'u32'
		return SizedTypeBound.value(pickBound(UnsignedMinBound, high: U32MaxBound, wantMax: wantMax))
	end 'u32'
	if typeName.equals(b"u64") 'u64'
		return SizedTypeBound.value(pickBound(UnsignedMinBound, high: U64MaxBound, wantMax: wantMax))
	end 'u64'
	if typeName.equals(b"i8") 'i8'
		return SizedTypeBound.value(pickBound(I8MinBound, high: I8MaxBound, wantMax: wantMax))
	end 'i8'
	if typeName.equals(b"i16") 'i16'
		return SizedTypeBound.value(pickBound(I16MinBound, high: I16MaxBound, wantMax: wantMax))
	end 'i16'
	if typeName.equals(b"i32") 'i32'
		return SizedTypeBound.value(pickBound(I32MinBound, high: I32MaxBound, wantMax: wantMax))
	end 'i32'
	if typeName.equals(b"i64") 'i64'
		return SizedTypeBound.value(pickBound(I64MinBound, high: I64MaxBound, wantMax: wantMax))
	end 'i64'
	if typeName.equals(b"f32") 'f32'
		return SizedTypeBound.floatBound(pickBound(F32MinBound, high: F32MaxBound, wantMax: wantMax))
	end 'f32'
	if typeName.equals(b"f64") 'f64'
		return SizedTypeBound.floatBound(pickBound(F64MinBound, high: F64MaxBound, wantMax: wantMax))
	end 'f64'
	return SizedTypeBound.notASizedType
end 'sizedTypeBound'

function pickBound(low ParsedInt, high ParsedInt, wantMax bool) returns ParsedInt
	if wantMax 'max'
		return high
	end 'max'
	return low
end 'pickBound'

// The bits of an `f32`/`f64` `.min`/`.max` bound, but ONLY where a float bound is legal — inside a
// `float(...)` typealias (`isFloat`). In an int alias (`int(0 to f64.max)`) or in expression position
// (`let x = f64.max`) there is no integer value that carries an f64 bit pattern, so it is a positioned
// error rather than a silently reinterpreted number — the same rejection the old `floatBound` arm
// made, now that a float alias is the ONE place the bound belongs. A free function because the match
// arm that needs it cannot host the labelled `if`.
function floatBoundInFloatAlias(bits ParsedInt, isFloat bool, typeTok Token, fieldTok Token) returns ParsedInt throws ParseError
	if not isFloat 'notFloatAlias'
		throw ParseError.unsupported("the float bound '{String.from(typeTok.value)}.{String.from(fieldTok.value)}' outside a `float(...)` typealias — only a float range can carry an f64 bound", line: typeTok.line, column: typeTok.column)
	end 'notFloatAlias'
	return bits
end 'floatBoundInFloatAlias'

// True iff `names` already holds `name`. A linear scan — parameter lists are tiny (the
// only caller is parameter-name duplicate detection), so no membership set is worth its
// heap object (the same reasoning `Project.indexOfParamIn` documents).
function byteArrayContains(names ByteArrayArray, name ByteArray) returns bool
	for existing in names 'each'
		if existing.equals(name) 'match'
			return true
		end 'match'
	end 'each'
	return false
end 'byteArrayContains'

// --- Pratt expression parser: precedence table + operator classifiers ---
//
// M3 replaces M2's `+`-only left-fold with a precedence climber (`Parser.parseBinary`).
// Binary precedence levels — HIGHER binds tighter. Left-associativity falls out of
// recursing the right operand at `precedence + 1`. Unary `-` and `not` are NOT in this
// table — they are prefix operators handled by `parseUnary` (the leaf of the climber), so
// they bind tighter than every binary operator here.
//
// The LADDER, loosest to tightest, is `maxon-selfhosted`'s `infixBindingPower`
// (Parser.maxon:21056-21077) verbatim, halved (v1 spaces its levels by two to leave room
// for right-associative operators it never added):
//
//     or  <  xor  <  and  <  comparison  <  shl/shr  <  + -  <  * / mod
//
// Every one of those relationships is pinned by a spec case, and they are not obvious:
// `12 and 10 or 1` is 9 (`and` binds tighter than `or`), `12 and 10 xor 3` is 11, and
// `1 shl 3 > 5` is `(1 shl 3) > 5` — a shift binds TIGHTER than a comparison, unlike C,
// where it is the reverse (specs/bitwise-operators.md).
typealias InfixPrecedence = int(0 to 100)

// A sentinel-free "not a binary operator": a real level is >= OrPrecedence, so
// `infixPrecedence` returning this makes the climber's loop stop (the expression ends).
// It is a meaningful classification result, not an error sentinel.
let NotAnInfixOperator = 0 as InfixPrecedence

// The three WORD operators, loosest first. Each is CONTEXT-DEPENDENT — bitwise on
// integers, logical on bools — and `and`/`or` are additionally SHORT-CIRCUIT when their
// left operand is a bool, which makes them control flow rather than ops (see
// Parser.emitShortCircuit). Their precedence does not depend on which reading applies.
let OrPrecedence = 1 as InfixPrecedence
let XorPrecedence = 2 as InfixPrecedence
let AndPrecedence = 3 as InfixPrecedence

// Comparison `==`/`!=`/`<`/`>`/`<=`/`>=`. Binds tighter than the word operators, so
// `a > 0 and b > 0` groups as `(a > 0) and (b > 0)` — the reading that makes a
// short-circuit `and` mean anything at all.
let ComparisonPrecedence = 4 as InfixPrecedence

// Shift `shl`/`shr`. Binds TIGHTER than comparison (`1 shl 3 > 5` is `(1 shl 3) > 5`)
// and LOOSER than additive (`a shl 1 + 2` is `a shl (1 + 2)`).
let ShiftPrecedence = 5 as InfixPrecedence

// Additive `+`/`-`.
let AdditivePrecedence = 6 as InfixPrecedence

// Multiplicative `*`/`/`/`mod` — the tightest binary level, so `10 + 5 * 2` groups as
// `10 + (5 * 2)` = 20.
let MultiplicativePrecedence = 7 as InfixPrecedence

// The precedence of a binary-operator token, or NotAnInfixOperator for any token
// that does not begin a binary operation in the grammar.
function infixPrecedence(kind TokenKind) returns InfixPrecedence
	if kind == TokenKind.or 'or'
		return OrPrecedence
	end 'or'

	if kind == TokenKind.xor 'xor'
		return XorPrecedence
	end 'xor'

	if kind == TokenKind.and 'and'
		return AndPrecedence
	end 'and'

	if comparisonOperator(kind) 'comparison'
		return ComparisonPrecedence
	end 'comparison'

	if kind == TokenKind.shl or kind == TokenKind.shr 'shift'
		return ShiftPrecedence
	end 'shift'

	if kind == TokenKind.plus or kind == TokenKind.minus 'additive'
		return AdditivePrecedence
	end 'additive'

	if kind == TokenKind.star or kind == TokenKind.slash or kind == TokenKind.mod 'multiplicative'
		return MultiplicativePrecedence
	end 'multiplicative'

	return NotAnInfixOperator
end 'infixPrecedence'

// The Maxon binary operator a supported infix token maps to. Only called for tokens
// `infixPrecedence` classified as operators (precedence != NotAnInfixOperator) and NOT
// consumed by a more specific path first (a comparison goes to `infixCmpOp`; a bool
// `and`/`or` never reaches an op at all — it is short-circuit control flow). Anything
// else is a climber bug, so it panics rather than guessing an operator.
//
// `and`/`or`/`xor` map to the BIT ops here because that is the only reading left by the
// time this is called: the parser has already established that the operands are not
// bools (see `parseBinary`), and on integers the word operators ARE the bit operators.
function infixMaxonOp(kind TokenKind) returns MaxonBinOp
	if kind == TokenKind.plus 'add'
		return MaxonBinOp.add
	end 'add'

	if kind == TokenKind.minus 'sub'
		return MaxonBinOp.sub
	end 'sub'

	if kind == TokenKind.star 'mul'
		return MaxonBinOp.mul
	end 'mul'

	if kind == TokenKind.slash 'div'
		return MaxonBinOp.div
	end 'div'

	if kind == TokenKind.mod 'mod'
		return MaxonBinOp.mod
	end 'mod'

	if kind == TokenKind.and 'bitAnd'
		return MaxonBinOp.bitAnd
	end 'bitAnd'

	if kind == TokenKind.or 'bitOr'
		return MaxonBinOp.bitOr
	end 'bitOr'

	if kind == TokenKind.xor 'bitXor'
		return MaxonBinOp.bitXor
	end 'bitXor'

	if kind == TokenKind.shl 'shl'
		return MaxonBinOp.shl
	end 'shl'

	if kind == TokenKind.shr 'shr'
		return MaxonBinOp.shr
	end 'shr'

	panic("infixMaxonOp: token '{kind.rawValue}' is not a supported binary operator — infixPrecedence must gate this call")
end 'infixMaxonOp'

// The two operators that SHORT-CIRCUIT when their operands are bools: `and` (skips the
// right operand when the left is false) and `or` (skips it when the left is true). `xor`
// is deliberately absent — no value of one operand makes the other redundant, so there is
// nothing to skip, and on the 0/1 bool domain the bitwise xor already IS the logical one.
function shortCircuitOperator(kind TokenKind) returns bool
	return kind == TokenKind.and or kind == TokenKind.or
end 'shortCircuitOperator'

// The `MaxonType` a folded literal's TAG denotes — the one place a tag becomes the type a
// declaration carries. TWO callers, and they are the two places a literal's value outlives the
// token that wrote it: an INLINED top-level constant (`literal`'s declared type) and a shorthand
// FIELD DEFAULT (`export var value = 0` — the field's declared type, since there is no annotation
// to read it off). One mapping, so `let X = 0` and `var x = 0` cannot come to disagree about what
// an integer literal IS.
//
// Total over what can arrive, and it panics on what cannot: both producers yield `integer`,
// `boolean` and `float` and nothing else (the evaluator's literals are ints, chars, bools and
// floats; a comparison folds to a bool; `binOpResultTag` over two of them yields one of them; and
// `readFieldDefaultLiteral` accepts exactly those three token kinds). The remaining tags name things
// no constant expression can contain — a `named` alias needs an `as` cast (P1.9), and
// `unresolved`/`void` are call results, which are rejected as E2045 before their type is ever asked
// for.
//
// A `float` constant's payload is the IEEE-754 bit pattern — whether it came from a literal
// (`parseFloatBits`) or from a fold (`foldFloatBinOp`/`foldFloatCompare`, which compute with the host's
// f64 and re-encode the bits) — and the `MaxonType.float` this hands back is what tells `lowerLiteral`
// to lay those 8 bytes down as an f64 rather than an i64. That is the whole of `let PI = 3.14`,
// `var ratio = 2.5`, and now `let X = 1.0 + 2.0` too.
export function constantValueType(tag ValueTypeTag) returns MaxonType
	if tag == ValueTypeTag.boolean 'bool'
		return MaxonType.boolean
	end 'bool'

	if tag == ValueTypeTag.integer 'int'
		return MaxonType.integer
	end 'int'

	if tag == ValueTypeTag.float 'float'
		return MaxonType.float
	end 'float'

	panic("constantValueType: a top-level constant is tagged '{typeTagName(tag)}' — the evaluator folds integers, bools and floats only")
end 'constantValueType'

// The interned-NAME id of a function's declared return type, for a function KNOWN to return a value —
// the id half of `maxonReturnTypeTag` (MaxonDialect), read where the aggregate-identity check needs a
// return type's NAME and a scalar tag carries none (OPEN #54). It returns the SCALAR id, never
// materializing the inner `MaxonType`: `typeNameIdOf` reads the borrowed inner's id, so a
// scalar-returning function allocates nothing here — the same reason every type rule is stated over
// the dense `valueTags`/`valueNameIds` columns (see TypeRules' header). Void is a caller bug: every
// caller is gated on `maxonReturnTypeIsVoid`, and a void `return <expr>` is its own diagnostic.
function maxonReturnTypeNameId(ref MaxonReturnType) returns TypeNameId
	match ref 'k'
		void then panic("maxonReturnTypeNameId: a void return type has no value — the caller must gate on maxonReturnTypeIsVoid first")
		value(inner) then return typeNameIdOf(inner)
	end 'k'
end 'maxonReturnTypeNameId'

// IEEE-754's sign bit — the top bit of the 64-bit pattern. Negating a float literal FLIPS it; it is
// not an arithmetic negate, because a `ParsedInt` holding a float carries the BITS (see
// `Parser.parseFloatLiteral`) and `0 - bits` would be nonsense.
//
// It rides `ParsedInt`, which is SIGNED, so the constant IS `i64.min` — the same bit pattern
// `0x8000000000000000`, spelled as the number Maxon can write. `xor` with it flips exactly that bit
// and leaves the other 63 alone, which is negation for every float including zero and infinity.
let FloatSignBit = i64.min as ParsedInt

// `-<float literal>` — the bits of the literal's negation. THE one spelling of a float's sign flip,
// shared by the declaration sweep (a field default has no code to emit into and must be a NUMBER by
// the time the layout is hashed), the range-bound reader, and the expression parser's negated-literal
// fold (`parseNegatedNumericLiteral`). A body's `-x` over a non-literal is still `emitFloatNegation`.
function negatedFloatBits(bits ParsedInt) returns ParsedInt
	return bits xor FloatSignBit
end 'negatedFloatBits'

// The comparison operators (M4). Each maps to a `MaxonOp.compare`. Classifier shared by
// the precedence table (`infixPrecedence`) and the climber's op-dispatch (`parseBinary`).
function comparisonOperator(kind TokenKind) returns bool
	return kind == TokenKind.equalsEquals or kind == TokenKind.bangEquals or kind == TokenKind.lessThan or kind == TokenKind.lessEquals or kind == TokenKind.greaterThan or kind == TokenKind.greaterEquals
end 'comparisonOperator'

// The SOURCE-LEVEL TYPE RULES the parser enforces — what an operator's operands may be, and
// when two types agree — live in TypeRules.maxon, NOT here. They are shared with SemanticCheck
// (whose call-argument check is the one rule that needs whole-program signatures and so cannot
// live in the parser), and a rule with two homes is a rule that will eventually disagree with
// itself. See that file's header. What lives here is only the RAISING of them: turning a
// verdict into a positioned `ParseError`.

// The binary-operand rule, RAISED. **Both paths a word operator can take come through it** —
// the ordinary `binOp` emit, and the short-circuit lowering, which emits no `binOp` at all
// (the blocks are laid down instead) and would otherwise need its own copy of "what counts as
// a mixed operand". A second copy on the OTHER path every `and`/`or` can take is free to
// drift from the first, and the drift would show up as a `bool and int` silently accepted on
// one path and rejected on the other — a wrong answer, not a compile error.
function requireBinOpOperands(op MaxonBinOp, left ValueTypeTag, right ValueTypeTag, opTok Token) throws ParseError
	match checkBinOpOperands(op, left: left, right: right) 'operands'
		ok then break 'operands'
		mixedWordOperands then throw ParseError.operandTypeMismatch(opTok.kind.rawValue, line: opTok.line, column: opTok.column)
		nonNumericOperands then throw ParseError.nonNumericOperands(typeTagName(left), right: typeTagName(right), line: opTok.line, column: opTok.column)
		// The offending tag is ASKED FOR, not assumed. This line named `float` outright, under a
		// comment calling it "the only tag that can trip this rule" — true when written, and
		// falsified by P1.0r admitting `structRef` to the same rule, which left `p and q`
		// reporting "but this one is float" about two structs. `nonIntegralOperandOf` answers it
		// from the same predicate the rule itself decides by, so the two cannot drift again.
		nonIntegralOperands then throw ParseError.nonIntegralOperands(opTok.kind.rawValue, operand: typeTagName(nonIntegralOperandOf(left, right: right)), line: opTok.line, column: opTok.column)
	end 'operands'
end 'requireBinOpOperands'

// **THE `trunc` BUILTIN'S NAME**, and the whole of what makes it one. A `b""` literal, matched
// against the callee token's bytes — the same shape `TypeResolution`'s `ExitCodeBuiltinName` and
// `SemanticCheck`'s `MainFunctionName` use for the same job, which is the compiler recognizing one
// of its own names in user source.
let TruncBuiltinName = b"trunc"

// Every ARITY-1 NUMERIC builtin — `trunc` and the four math intrinsics — takes exactly one argument.
// ONE constant, because `numericBuiltinOperand` is the one function that states it (as both the check
// and the message's `expected`), and a bare `1` there would be a magic value in the more literal
// sense: the number that says what these builtins ARE. (`print`/`__Builtins.sleep`/`runProcess` keep
// their own, because each has its own emit and its own operand rule.)
let NumericBuiltinArity = 1 as ParamCount

// **THE `String` BUILTIN TYPE'S NAME** (P1.2 wave A). Recognized SYNTACTICALLY in `parseTypeReference`
// — like `Self`, a pure token test with no registry — so `function f(s String)` tags `s`'s value
// `string` at PARSE time, which is what `s == t` / `print(s)` read. Recognizing it here (not only in
// `TypeResolution`, the way `ExitCode` is) is load-bearing: `resolveTypes` rewrites SIGNATURES, never
// the parser's `valueTags` column, so a String tagged `named` at parse time would stay `named` on the
// value and the String operators would never see it.
let StringBuiltinName = b"String"

// **THE `print` BUILTIN'S NAME** (P1.2 wave A). Like `trunc`, recognized by name after its arguments
// are parsed (`parseCallNamed`): it takes ordinary call syntax but emits no `MaxonOp.call` to a user
// function — it routes to the `__print_string` runtime entry.
let PrintBuiltinName = b"print"

// `print` takes exactly one argument (a String). Named for the same reason `TruncArity` is: `emitPrint`
// states it as both the check and the diagnostic's `expected`.
let PrintArity = 1 as ParamCount

// **THE `runProcess` BUILTIN** (P1.5 subprocess seed). Like `print`, recognized by name after its arguments are
// parsed: ordinary call syntax, but it emits no `MaxonOp.call` to a user function — it routes to the
// `__gt_process_run(strPtr)` scheduler runtime entry (which spawns a Windows child, parks the current green
// thread with a YIELDING wait, and returns the child's scalar exit code once it finishes).
//
// ⚠ It is a STAND-IN for a stdlib module shv2 cannot compile yet, and it therefore claims the bare name
// `runProcess` the way `sleep` used to claim its own: a declaration of that name anywhere is silently
// unreachable, because this test runs before any registry is consulted. Retire it the same way — delete the
// name here and list the stdlib module that declares it — when that module compiles.
//
// TWO things the `sleep` retirement had that this note would otherwise let a reader assume come free:
//   • The stdlib body needs a FLOOR to bottom out on, and the only one is a `__Builtins.*` intrinsic — the
//     table below. `sleep` was retirable because `__Builtins.sleep` already existed and `stdlib/Sleep.maxon`
//     was already written against it; there is no `__Builtins.runProcess`, so retiring this one MINTS that
//     intrinsic first and the bare name second.
//   • It CHANGES TARGET BEHAVIOUR for calls nothing reaches, and that is a decision, not a side effect: the
//     runtime entry moves out of user code (where the target gate is reachability-BLIND) and into stdlib
//     source (where it is reachability-AWARE), so an unreached call to the retired name starts compiling for
//     targets that cannot lower its entry. `SemanticCheck.requireTargetSupportsCallee`'s header states the
//     asymmetry and names the pair of spec cases that pin both halves for `sleep`. Pin both halves again.
let RunProcessBuiltinName = b"runProcess"

// `runProcess` takes exactly one STRING argument — the command line — and returns an INTEGER (the child's exit
// code), so unlike `__Builtins.sleep` its result IS usable in value position.
let RunProcessArity = 1 as ParamCount

// **THE `spawnReadLine` BUILTIN** (P1.5 dogfood slice 1a-ii — the IOCP overlapped-read PROBE). A TEMPORARY probe
// surface (not the final async-subprocess-stdio API, which arrives with the stdlib in slice 1b): like `runProcess`,
// ordinary call syntax routing to a scheduler runtime entry — `__gt_io_read(strPtr)` — which spawns the command with
// its stdout redirected to a fresh overlapped pipe, issues a YIELDING overlapped ReadFile, and returns the byte count
// once the read completes. Non-throwing (returns an INTEGER, not the dual-register error ABI), so a bare
// `spawnReadLine(cmd)` needs no `try`.
let SpawnReadLineBuiltinName = b"spawnReadLine"

// `spawnReadLine` takes exactly one STRING argument (the command line) and returns an INTEGER (the bytes read).
let SpawnReadLineArity = 1 as ParamCount

// **THE STREAMING SUBPROCESS BUILTINS** (P1.5 dogfood slice 1b) — the real long-lived-child API `StreamingSubprocess`
// wants, exposed as bare-name compiler builtins (like `spawnReadLine`) because shv2 cannot yet compile the stdlib
// cone the stdlib method bodies need (Map/FilePath/`__ManagedMemory`/`cstr`/the union cone — see the slice report).
// Each routes to a `__gt_subp_*` runtime entry: `subpSpawn(cmd)` spawns a child with three pipes and returns a
// handle (or -1); `subpReadLine(h)`/`subpReadErrLine(h)` yield a stdout/stderr line as an OWNED String; `subpWriteLine
// (h, line: s)` writes `s\n` to stdin (0 ok, nonzero fail); `subpCloseStdin(h)` / `subpWait(h)` / `subpRelease(h)`
// close stdin / block for exit code / free the handle. x64-windows only, like the whole subprocess substrate.
let SubpSpawnBuiltinName = b"subpSpawn"
let SubpReadLineBuiltinName = b"subpReadLine"
let SubpReadErrLineBuiltinName = b"subpReadErrLine"
let SubpWriteLineBuiltinName = b"subpWriteLine"
let SubpCloseStdinBuiltinName = b"subpCloseStdin"
let SubpWaitBuiltinName = b"subpWait"
let SubpReleaseBuiltinName = b"subpRelease"

// Arities: spawn/read/close/wait/release take one argument; writeLine takes two (handle, line).
let SubpSpawnArity = 1 as ParamCount
let SubpReadArity = 1 as ParamCount
let SubpWriteArity = 2 as ParamCount
let SubpHandleArity = 1 as ParamCount

// **THE ARITY-1 FLOAT MATH INTRINSICS** (P1.0d.4-C) — `specs/{floor,ceil,round,sqrt}.md`. Builtins for the
// same reason `trunc` is: each lowers to ONE instruction on every target, so a stdlib function would be a
// call/ret wrapped around a single `sqrtsd`/`roundsd`/`fsqrt`/`frint`/`f64.sqrt`. Both reference compilers
// make them builtins too (the bootstrap's `BuiltinOps1` table, 2-Parser.cs:829; v1's `isMathIntrinsicName`,
// TypeResolution.maxon:11613).
//
// ⚠ Like `trunc`, each name is RESERVED wherever a call is parsed: a user `function sqrt` is shadowed by
// this and never linked, undiagnosed. v1 has the identical property for the identical set.
let FloorBuiltinName = b"floor"
let CeilBuiltinName = b"ceil"
let RoundBuiltinName = b"round"
let SqrtBuiltinName = b"sqrt"

// ⭐ **THE `__Builtins` INTRINSIC TABLE (P1.0b step 2) — THE ONE PLACE THE RECOGNIZED SET IS STATED.**
//
// `__Builtins` is the compiler's builtin TYPE, and every leaf of the stdlib bottoms out in a static call on
// it (`stdlib/Clock.maxon`'s `nowMs`/`nowNanos`/`nowUnixSeconds` are three one-line wrappers around the
// first three names below; `stdlib/Sleep.maxon`'s `sleep` is a fourth, around the fourth). It reaches
// `parseCallNamed` as an ORDINARY QUALIFIED CALLEE — the mangled bytes `__Builtins.currentTimeMs` —
// which is exactly why the bare-name builtin table above can never match one,
// and why this table is a separate arm rather than three more rows in it.
//
// Every row is a NAME plus its lowering, so "which intrinsics exist" and "what each one becomes" are one
// fact in one place. A name NOT here is not silently a link error: it falls through to `emitCall`, whose
// reserved-callee rejection refuses every unrecognized `__` callee with a positioned E3004 (see
// `requireCalleeIsNotReservedName` — the "unknown intrinsic" arm of this table, homed there because it
// answers for `__whatever()` too).
//
// The whole arm is gated behind ONE prefix compare, so a program with no `__Builtins` call pays a
// two-byte `bytesStartWith` per parsed call and nothing else — the same allocation-free `equals`
// discipline the math-intrinsic rows document.
let BuiltinsQualifierPrefix = b"__Builtins."
let BuiltinsCurrentTimeNanosName = b"__Builtins.currentTimeNanos"
let BuiltinsCurrentTimeMsName = b"__Builtins.currentTimeMs"
let BuiltinsCurrentUnixTimeSecondsName = b"__Builtins.currentUnixTimeSeconds"
let BuiltinsSleepName = b"__Builtins.sleep"

// ⭐ **IS THIS CALLEE A MEMBER OF THE `__Builtins` TYPE?** THE one test, and it has two askers that
// must never disagree: the intrinsic table in `parseCallNamed` (which dispatches on it) and the
// STATEMENT door's `builtinsIntrinsicCallsAt` (which decides that `__Builtins.sleep(ms)` on a line of
// its own is a statement at all). Written once for the reason `isClockRuntimeCallee` is — a band's
// membership question belongs with the band's names, not restated at each site.
function isBuiltinsIntrinsicCallee(callee ByteArray) returns bool
	return bytesStartWith(callee, prefix: BuiltinsQualifierPrefix)
end 'isBuiltinsIntrinsicCallee'

// Every clock intrinsic reads a clock and takes nothing.
let ClockIntrinsicArity = 0 as ParamCount

// `__Builtins.sleep` takes exactly one INTEGER argument — the duration in milliseconds (per
// `specs/sleep.md`) — and returns void.
//
// ⚠ **THIS IS THE INTRINSIC'S ARITY, NOT `sleep`'s.** A source `sleep(ms)` is an ordinary call to
// `stdlib/Sleep.maxon`'s declaration, and the arity it meets is that declaration's, checked by
// SemanticCheck against its signature exactly like every other call's. An intrinsic has no signature for
// that check to read — no file declares it — which is the whole reason this constant exists, and why it
// belongs here beside the intrinsic table rather than up with the bare-name builtins.
let SleepIntrinsicArity = 1 as ParamCount

// The scale between the two MONOTONIC readings — `currentTimeMs()` IS `currentTimeNanos() / 1e6`. Named
// here because this is the only place it is applied; the wall clock's own two scale constants live with
// the runtime function that uses them (`ClockRuntime.maxon`).
let NanosPerMillisecond = 1000000

// ⭐ **THE "UNKNOWN INTRINSIC" ARM OF THE `__Builtins` TABLE — AND OF EVERY OTHER RESERVED CALLEE.**
//
// `__` is reserved for compiler internals: `E2051` refuses to DECLARE such a name, and the compiler emits
// its own calls to them through `emitRuntimeCall`, never through here. So a `__`-prefixed callee arriving
// at one of the two SOURCE call doors (`emitCall`, `emitAsyncCall`) either matched the intrinsic table
// above — in which case it was already lowered and never reached this — or names nothing at all.
//
// ⚠ **THE CHECK IS HERE AND NOT IN SemanticCheck, AND THAT IS THE WHOLE REPAIR.**
// `SemanticCheck.validateCall` RETURNS EARLY on any `__` callee, on the premise that "no user name can be
// DECLARED with this prefix, so a `__` CALLEE is provably compiler-owned". The premise is about
// DECLARATIONS and the conclusion is about CALLEES, and a callee need not be declared anywhere — so a
// source-written `__foo()` sailed past E3004, past the arity/label/type checks, past lowering, and died in
// the LINKER with neither a file nor a line:
//
//   panic at X64Backend.maxon:1794: resolveCallFixups: call to unknown function '__Builtins.currentTimeMs'
//   panic at LowerMaxonToStd.maxon:1346: lowerAsyncCall: async callee '__whatever' has no signature
//   panic at LowerMaxonToStd.maxon:112:  valueTagToStdType: an `unresolved` tag reached lowering
//
// (all three measured, all three on plain user code). SemanticCheck cannot make this check itself: by the
// time it runs, a `call __mm_decref` the parser emitted and a `call __whatever` the user wrote are the same
// `MaxonOp.call`, and nothing in the Maxon tier records which is which. The PARSER is the one tier that
// knows, because it knows which of its own two doors the name came through — so the fix is to close the
// door, which restores `isCompilerInternalCallee`'s premise for real: after this, every `__` callee in the
// IR was emitted by the compiler.
function requireCalleeIsNotReservedName(callee ByteArray, anchor Token) throws ParseError
	if not isCompilerInternalCallee(callee) 'ordinaryCallee'
		return
	end 'ordinaryCallee'

	throw ParseError.unknownCompilerIntrinsic(String.from(callee), line: anchor.line, column: anchor.column)
end 'requireCalleeIsNotReservedName'

// ⭐⭐ **THE ONE PLACE A SIGNATURE'S ARGUMENT COUNT IS JUDGED**, asked of the ABI count and of nothing
// else. `paramCount` is what the calling convention actually passes: the parameters the source writes,
// PLUS a companion environment per function-typed parameter (the uniform closure ABI), PLUS the layout
// descriptor a generic method that reads `sizeof(T)` carries, PLUS one witness per `where` constraint on
// an instance method. Every one of those occupies an argument slot and a mask bit, so every one counts.
//
// ⚠ **THE PREDECESSOR WAS TWO CHECKS WITH TWO DIFFERENT COUNTS**, and it is exactly the shape this
// project keeps paying for: `parseFunctionParameters` tested the SOURCE parameter count while
// `parseFunction` tested the ABI count, both against one constant, neither aware of the other. Whichever
// fired first decided the message a user saw. There is now one test, and the routines that used to hold
// the weak copy call this instead.
//
// The ceiling itself is `MaxAbiArgs` — the width of the per-argument float mask both ends of every call
// route through (`StdDialect.ArgFloatMask`), which is where the reason lives. It is NOT a register count:
// arguments past the register files travel in stack slots, and a target's register depth is a property of
// that target's ABI (six per file on x64, eight on arm64), not of the language.
function requireAbiParamCount(paramCount ParamCount, anchor Token) throws ParseError
	if paramCount <= MaxAbiArgs 'withinCeiling'
		return
	end 'withinCeiling'

	throw ParseError.unsupported("a function with {paramCount} argument slots — more than the {MaxAbiArgs} a call can carry. A signature's slots are its declared parameters plus the hidden ones the ABI adds (a companion environment per function-typed parameter, a layout descriptor for a generic that reads `sizeof`, one witness per `where` constraint), and the limit is the width of the per-argument float mask that routes each one to its register file", line: anchor.line, column: anchor.column)
end 'requireAbiParamCount'

// **THE BUILTIN STRING METHODS** (P1.2 wave D). `append` grows a `var` String in place; `byteLength` reads
// its byte count. String is the one non-struct type with methods at this rung, dispatched by name in
// `parseStringMethodCall` off a String-typed receiver.
let StringAppendMethod = b"append"
let StringByteLengthMethod = b"byteLength"

// The argument slot a builtin-conformance dispatch spends on its RECEIVER (P1.7a direct dispatch). The
// synthesized impls take `self` positionally in argument 0 — `int.compare(self, other)` — exactly as an
// instance method's receiver does, so an interface formal `j` is actual `j + 1` and the user-visible arity
// is the actual count less this. One name, read by the arity check and the `Self`-argument check.
let BuiltinConformanceReceiverArgs = 1

// The value a short-circuit merge takes on the SKIPPED path: `false` for `and` (a false left
// operand determines the whole expression), `true` for `or`.
function shortCircuitSeed(takesRhsWhenTrue bool) returns ParsedInt
	if takesRhsWhenTrue 'isAnd'
		return BoolFalseValue
	end 'isAnd'
	return BoolTrueValue
end 'shortCircuitSeed'

// The block label a short-circuit's right-hand operand is evaluated under. Distinct per
// operator so a printed IR fragment says which one produced the block.
function shortCircuitLabel(takesRhsWhenTrue bool) returns ByteArray
	if takesRhsWhenTrue 'isAnd'
		return b"andrhs"
	end 'isAnd'
	return b"orrhs"
end 'shortCircuitLabel'

// A one-element branch-edge argument list — the shape every short-circuit edge has (its
// merge block carries exactly one phi: the expression's value).
export function singletonArgs(value ValueId) returns ValueIdArray
	var args = ValueIdArray.create()
	args.push(value)
	return args
end 'singletonArgs'

// A two-element call argument list — `__str_append(self, other)`'s pair. `singletonArgs`' sibling.
export function pairArgs(first ValueId, second ValueId) returns ValueIdArray
	var args = ValueIdArray.create()
	args.push(first)
	args.push(second)
	return args
end 'pairArgs'

// A witness dispatch's final argument list: the BORROWED receiver, then the user's actuals already in the
// interface's declaration order (P1.7a slice 2b-vi). It is what re-establishes the `args[0]` = receiver /
// interface formal `j` = `args[j+1]` convention after `slotCallArgs` — which knows only about the formals —
// has done the reordering. `pairArgs`' variadic sibling, and the ONE place the receiver is put back.
export function withWitnessReceiver(receiver ValueId, ordered ValueIdArray) returns ValueIdArray
	var args = ValueIdArray.create()
	args.push(receiver)
	for id in ordered 'eachOrdered'
		args.push(id)
	end 'eachOrdered'
	return args
end 'withWitnessReceiver'

// The span a witness dispatch's LABEL error is anchored on — the offending ARGUMENT's own, which is where
// `SemanticCheck.reportArgError` anchors the direct call's twin (P1.7a slice 2b-vi). `parseCallArgs` pushes
// one range per argument in lockstep and `slotCallArgs` only ever names an index it was handed, so an
// out-of-range index is a compiler defect and not a program's. It is a named lookup rather than a bare `get`
// at the throw sites because a `match` arm is a single expression and cannot bind the result to a `let`.
export function witnessArgAnchor(argRanges SourceRangeArray, argIndex ParamCount) returns SourceRange
	return try argRanges.get(argIndex) otherwise panic("witnessArgAnchor: argRanges.get OOB at {argIndex} below count {argRanges.count()} — the columns `parseCallArgs` fills are parallel by construction")
end 'witnessArgAnchor'

// A three-element call argument list — `__arr_set(arr, index, value)`'s triple. `pairArgs`' sibling.
function tripleArgs(first ValueId, second ValueId, third ValueId) returns ValueIdArray
	var args = ValueIdArray.create()
	args.push(first)
	args.push(second)
	args.push(third)
	return args
end 'tripleArgs'

// A four-element call argument list — `__arr_slice_managed(arr, start, end, cloneFn)`'s quad (P1.7 slice
// 3b-vi-b). `tripleArgs`' sibling.
function quadArgs(first ValueId, second ValueId, third ValueId, fourth ValueId) returns ValueIdArray
	var args = ValueIdArray.create()
	args.push(first)
	args.push(second)
	args.push(third)
	args.push(fourth)
	return args
end 'quadArgs'

// **THE BUILTIN `Array` METHODS** (P1.7 slice 1). `create` is a static factory; the rest are instance
// methods dispatched by name in `parseArrayMethodCall` off an `Array`-instance receiver. `get`/`set`/
// `first`/`last`/`pop`/`remove` are THROWING (they ride `try … otherwise`); the rest are non-throwing.
let ArrayCreateMethod = b"create"
let ArrayPushMethod = b"push"
let ArrayGetMethod = b"get"
let ArraySetMethod = b"set"
let ArrayCountMethod = b"count"
let ArrayCapacityMethod = b"capacity"
let ArrayIsEmptyMethod = b"isEmpty"
let ArrayReserveMethod = b"reserve"
let ArrayResizeMethod = b"resize"
let ArrayFirstMethod = b"first"
let ArrayLastMethod = b"last"
let ArrayPopMethod = b"pop"
let ArrayClearMethod = b"clear"
let ArrayInsertMethod = b"insert"
let ArrayRemoveMethod = b"remove"

// The whole-array copy methods (P1.7 slice 4). `slice` is THROWING (bounds/inverted-range → `ArrayError`) and
// returns a NEW independent array; `clone` returns a NEW independent array (non-throwing); `append` mutates the
// receiver, borrowing and preserving its argument. TRIVIAL elements only — a managed element needs a deep-clone
// primitive shv2 does not have (P1.2 deferred `.clone` for managed values), so the managed cases are rejected.
let ArraySliceMethod = b"slice"
let ArrayCloneMethod = b"clone"
let ArrayAppendMethod = b"append"

// The label `slice`'s SECOND argument gives its end index: `arr.slice(1, endIndex: 4)`.
let ArrayEndIndexLabel = b"endIndex"

// The label the two-argument mutators (`set`/`insert`) give their VALUE argument: `arr.set(0, value: 9)`.
let ArrayValueLabel = b"value"

// ⭐ **WHICH `Array` METHODS WRITE THEIR RECEIVER** — the `Array` half of the one immutable-receiver
// rule (`noteReceiverWrite`, E3019; `setMethodMutatesReceiver` is the `Set` half, and `String`'s
// half is the single method `append`). Every one of these rewrites the record's own slots:
// `push`/`insert`/`append`/`reserve`/`resize` can grow (`buffer@0` + `capacity@16`), `set` writes an
// element, and `pop`/`remove`/`clear` shorten it (`length@8`).
//
// **MEASURED AGAINST THE RUNNABLE ORACLE, one method at a time**, over `let a = [1, 2, 3]`: these nine
// are E3019 ("cannot pass 'a' to function that mutates parameter 'self'") and `count`/`get`/`clone`
// are accepted. The oracle derives the same list structurally — from the by-reference `self` in the
// stdlib `Array` signatures — which shv2 does not read, so the list is stated here and pinned by
// `specs-shv2/arrays.md`'s `error.let-array-*` cases rather than left to be re-derived.
//
// ⚠ It is NOT `isArrayMoveInMutator`, and neither can be defined from the other: that one answers
// "does this method take OWNERSHIP of an element?" (push/set/insert only), which is a question about
// the ARGUMENT. This one is about the RECEIVER.
function arrayMethodMutatesReceiver(name ByteArray) returns bool
	return name.equals(ArrayPushMethod) or name.equals(ArraySetMethod) or name.equals(ArrayInsertMethod) or name.equals(ArrayAppendMethod) or name.equals(ArrayReserveMethod) or name.equals(ArrayResizeMethod) or name.equals(ArrayClearMethod) or name.equals(ArrayPopMethod) or name.equals(ArrayRemoveMethod)
end 'arrayMethodMutatesReceiver'

// Append one argument to a call's THREE PARALLEL COLUMNS — its value, its `name:` label (the empty
// slice when positional), and its source span.
//
// **THE ONE WRITER OF THEM**, which is `StructLayout.addField`'s reason reaching the other family
// of parallel columns in the compiler: a caller that pushed a value and forgot a label would shift
// every later argument's label onto the wrong argument, and `slotCallArgs` would slot them
// accordingly — a silent wrong answer with no crash to find it by. There are exactly two callers,
// and the second is what made this worth a function: an argument the SOURCE wrote
// (`parseCallArgs`), and the RECEIVER an instance method call prepends (`parseCallNamed`), which is
// positional by construction and would otherwise have been a second, hand-written triple.
//
// `immutableName` is the FOURTH column (`MaxonOp.call`'s `argImmutableNames`): the binding name an
// E3019 would blame for this argument, empty when it may be written through. It rides here rather
// than being derived later for the reason the label does — it is a fact about the SYNTAX at this
// argument, and nothing downstream can recover it (see the op's own header).
function pushCallArg(args ValueIdArray, argLabels ByteArrayArray, argRanges SourceRangeArray, argImmutableNames ByteArrayArray, value ValueId, label ByteArray, range SourceRange, immutableName ByteArray)
	args.push(value)
	argLabels.push(label)
	argRanges.push(range)
	argImmutableNames.push(immutableName)
end 'pushCallArg'

// A `MaxonOp.call`'s `argLabels` column for a call whose every argument is POSITIONAL — one empty
// slice per argument. The op's columns are parallel by construction, so an all-positional call
// still has to say so at every index rather than carry a shorter list.
//
// The empty string is an unambiguous "no label" and not a value-masking sentinel, for the reason
// MaxonOp's `call` header gives: a parameter name can never be empty.
export function emptyArgLabels(args ValueIdArray) returns ByteArrayArray
	var labels = ByteArrayArray.create()
	for _ in 0 upto args.count() 'each'
		labels.push(EmptySourceText)
	end 'each'
	return labels
end 'emptyArgLabels'

// A `MaxonOp.call`'s `argRanges` column when every argument shares ONE span — a call the COMPILER
// wrote, whose arguments no source token spawned individually.
//
// The per-argument span exists so a diagnostic can point at the offending argument
// (`SemanticCheck.reportArgError`), and a compiler-emitted call has no argument a user could have
// got wrong. Giving them all the call's own span is honest — that IS where each came from — and it
// keeps the column parallel, which `emitOp` requires.
export function uniformArgRanges(args ValueIdArray, range SourceRange) returns SourceRangeArray
	var ranges = SourceRangeArray.create()
	for _ in 0 upto args.count() 'each'
		ranges.push(range)
	end 'each'
	return ranges
end 'uniformArgRanges'

// ⭐ **THE `argImmutableNames` COLUMN OF A CALL WHOSE ARGUMENTS NAME NO IMMUTABLE BINDING** — one array
// for the whole compile, the `sharedEmptyInstanceAliasMap` pattern with its invariant: it is never
// mutated (`pushCallArg` builds a FRESH column, and `emitCall` only ever SUBSTITUTES this one in place of
// an all-empty one), so it is safe to share across the per-file parse fan-out.
//
// Every COMPILER-emitted call takes it directly: those callees are `__`-prefixed, `validateCall` returns
// before the E3019 check for them, and their arguments are the compiler's own — so there is no argument a
// blame name could describe. That is the difference from `emptyArgLabels`, which must materialize a real
// per-argument column because `slotCallArgs` indexes it.
export let NoImmutableArgNames = ByteArrayArray.create()

// The name an E3019 would blame for argument `index` of a call, or empty. Decodes BOTH shapes of the
// column — parallel-to-`args`, or the shared empty one above — so no reader has to know which it holds.
export function immutableArgNameAt(argImmutableNames ByteArrayArray, index ParamCount) returns ByteArray
	return try argImmutableNames.get(index) otherwise EmptySourceText
end 'immutableArgNameAt'

// The `argImmutableNames` column to put ON the op: the shared empty one when no argument named an
// immutable binding, else the column as built. Called once per source-written call, at the emit, so the
// overwhelming majority of calls retain nothing — the transient column the parser filled is freed instead
// of living as long as the module.
function settledImmutableArgNames(argImmutableNames ByteArrayArray) returns ByteArrayArray
	for name in argImmutableNames 'each'
		if not name.isEmpty() 'hasOne'
			return argImmutableNames
		end 'hasOne'
	end 'each'
	return NoImmutableArgNames
end 'settledImmutableArgNames'

// The Maxon comparison operator a comparison token maps to. Only called for tokens
// `comparisonOperator` classified as comparisons; anything else is a climber bug, so
// it panics rather than guessing. Kept separate from `infixMaxonOp` because a
// comparison is a distinct op family (`MaxonOp.compare`), not a `binOp` opcode.
function infixCmpOp(kind TokenKind) returns MaxonCmpOp
	if kind == TokenKind.equalsEquals 'eq'
		return MaxonCmpOp.eq
	end 'eq'

	if kind == TokenKind.bangEquals 'ne'
		return MaxonCmpOp.ne
	end 'ne'

	if kind == TokenKind.lessThan 'lt'
		return MaxonCmpOp.lt
	end 'lt'

	if kind == TokenKind.greaterThan 'gt'
		return MaxonCmpOp.gt
	end 'gt'

	if kind == TokenKind.lessEquals 'le'
		return MaxonCmpOp.le
	end 'le'

	if kind == TokenKind.greaterEquals 'ge'
		return MaxonCmpOp.ge
	end 'ge'

	panic("infixCmpOp: token '{kind.rawValue}' is not a comparison operator — comparisonOperator must gate this call")
end 'infixCmpOp'

// The source spelling of a comparison operator, for the E3066 union-comparison message. A `union`
// value has NO comparison of ANY kind: `==`/`!=` carry no synthesized equality, and `<`/`>`/`<=`/`>=`
// would compare two BOX ADDRESSES — a pointer answer to a question about values, the same
// reference-equality hazard `comparableOperands` refuses for two structs. So EVERY operator is named
// here, not only the two the corpus happens to exercise — the message stays honest whichever one the
// author wrote.
function comparisonOpSpelling(op MaxonCmpOp) returns String
	return match op 'op'
		eq gives "=="
		ne gives "!="
		lt gives "<"
		gt gives ">"
		le gives "<="
		ge gives ">="
	end 'op'
end 'comparisonOpSpelling'

// --- Character literals ---
//
// The lexer hands the parser the RAW bytes between the quotes, escapes undecoded, under
// `TokenKind.charLiteral` — and it uses the SAME token kind for a BLOCK LABEL (`'check'`).
// Nothing distinguishes them lexically, and nothing needs to: the two never occur in the
// same grammatical position. A label is consumed by the statement parser at the exactly
// one place each construct allows it (after an `if`/`while` condition, after `else`, after
// `end`, after `break`/`continue`); a character literal is consumed by `parsePrimary`,
// which runs only where an OPERAND is required. `if x 'check'` therefore parses `x` as the
// condition — the climber stops at the `'check'` because a charLiteral is not an infix
// operator — and `if cp == '-' 'dash'` parses `'-'` as the comparison's right operand
// because that IS an operand position, then `'dash'` as the label. This is v1's
// disambiguation, and its comment (Parser.maxon:16600) says the same thing.

// What a character literal's body decodes to.
union CharLiteralValue
	// A single byte — an ASCII character, or an escape that produces one. It materializes
	// as an ordinary integer literal carrying that byte, which is what makes `cp == '-'`,
	// `cp - '0'` and `if c >= '0'` mean what they say.
	byte(value ParsedInt)
	// `''`. No character, and no value to give it.
	empty
	// A literal whose UTF-8 body is more than one byte: `'é'`, `'中'`, an emoji, an EGC.
	// Representing one needs the `Character` TYPE (a heap value with `.bytes()`,
	// `.asciiValue()`, EGC-aware equality) — String's cone, not this rung's.
	multiByte
	// A `\` escape this decoder does not know.
	badEscape(text String)
end 'CharLiteralValue'

// Decode a character-literal body. Ported from maxon-selfhosted's `parseCharLiteralExpr`
// (Parser.maxon:16606-16637) + `decodeStringEscapes` (11069): v1 takes the SINGLE-BYTE
// literal as an `integer` and routes everything wider to its `Character` struct. shv2 keeps
// the first half exactly and rejects the second with a positioned diagnostic naming the gap
// — it has no Character type to route to yet.
function decodeCharLiteral(raw ByteArray) returns CharLiteralValue
	let decoded = decodeEscapes(raw)
	match decoded 'd'
		bytes(buf) then return charValueOf(buf)
		unknownEscape(text) then return CharLiteralValue.badEscape(text)
	end 'd'
end 'decodeCharLiteral'

function charValueOf(buf ByteArray) returns CharLiteralValue
	if buf.count() == 0 'empty'
		return CharLiteralValue.empty
	end 'empty'
	if buf.count() > 1 'wide'
		return CharLiteralValue.multiByte
	end 'wide'
	let b = try buf.get(0) otherwise panic("charValueOf: count()==1 but get(0) failed")
	return CharLiteralValue.byte(b as ParsedInt)
end 'charValueOf'

// The result of decoding a quoted body's escape sequences.
union DecodedLiteral
	bytes(buf ByteArray)
	unknownEscape(text String)
end 'DecodedLiteral'

// The escape sequences a quoted literal accepts, decoded to their bytes. The set is
// maxon-selfhosted's `decodeStringEscapes` (Parser.maxon:11069-11135) verbatim, so a
// character literal and (at P1.2) a string literal read escapes the same way — which is
// the whole reason this is a shared decoder rather than a char-only one.
//
// An UNRECOGNIZED escape is REPORTED, not copied through: v1 falls back to a literal copy
// only because a separate `validateEscapes` pass has already reported it, and shv2 has no
// such pass. Silently turning `'\q'` into two bytes would then surface as the far more
// confusing "multi-byte character literal".
function decodeEscapes(raw ByteArray) returns DecodedLiteral
	var buf = ByteArray.create()
	let len = raw.count()
	var i = 0 as ByteOffset
	while i < len 'decode'
		let ch = try raw.get(i) otherwise panic("decodeEscapes: i < len just held but get({i}) failed")
		if ch != Backslash or i + 1 >= len 'literalByte'
			buf.push(ch)
			i = i + 1
			continue
		end 'literalByte'

		let next = try raw.get(i + 1) otherwise panic("decodeEscapes: i + 1 < len just held but get({i + 1}) failed")
		match escapeByte(next) 'esc'
			byte(b) then buf.push(b)
			unknown then return DecodedLiteral.unknownEscape("\\{String.from(byteSlice(next))}")
		end 'esc'
		i = i + 2
	end 'decode'
	return DecodedLiteral.bytes(buf)
end 'decodeEscapes'

// The byte a two-character escape `\<c>` denotes, or `unknown`.
union EscapeByte
	byte(value Byte)
	unknown
end 'EscapeByte'

function escapeByte(c Byte) returns EscapeByte
	if c == LowerN 'newline'
		return EscapeByte.byte(NewlineByte)
	end 'newline'
	if c == LowerT 'tab'
		return EscapeByte.byte(TabByte)
	end 'tab'
	if c == LowerR 'carriageReturn'
		return EscapeByte.byte(CarriageReturnByte)
	end 'carriageReturn'
	if c == DigitZero 'nul'
		return EscapeByte.byte(NulByte)
	end 'nul'
	// The four self-escapes: a backslash, and the three delimiters a literal must be able
	// to contain — the single quote that would close a character literal, the double quote
	// that would close a string, and the brace that would open an interpolation.
	if c == Backslash or c == SingleQuote or c == DoubleQuote or c == LeftBrace or c == RightBrace 'selfEscape'
		return EscapeByte.byte(c)
	end 'selfEscape'
	return EscapeByte.unknown
end 'escapeByte'

// One byte as a one-element ByteArray, so an offending escape can be interpolated into a
// diagnostic as text.
function byteSlice(b Byte) returns ByteArray
	var one = ByteArray.create()
	one.push(b)
	return one
end 'byteSlice'

// The ASCII bytes the escape decoder produces and recognizes. Named rather than spelled as
// bare numbers or as `'\\'` character literals — the parser cannot bootstrap its own
// character-literal syntax to define the table that decodes it.
let Backslash = 92 as Byte
let SingleQuote = 39 as Byte
let DoubleQuote = 34 as Byte
let LeftBrace = 123 as Byte
let RightBrace = 125 as Byte
let LowerN = 110 as Byte
let LowerT = 116 as Byte
let LowerR = 114 as Byte
let DigitZero = 48 as Byte
let NewlineByte = 10 as Byte
let TabByte = 9 as Byte
let CarriageReturnByte = 13 as Byte
let NulByte = 0 as Byte

// --- Byte-string literal decode (`b"…"`, P1.7 slice 2) ---
//
// A byte-string decodes DIFFERENTLY from a String literal: a String keeps its source UTF-8 bytes verbatim,
// while a byte-string maps each SOURCE CODEPOINT to one Latin-1 byte — so a two-byte UTF-8 `À` becomes the
// single byte 0xC0. Escapes resolve as in a string (`escapeByte`) plus the byte-exact `\xNN` and the
// `\uNNNN` codepoint escape. A codepoint above 0xFF (`b"Ā"`, a `\uNNNN` naming one, an emoji) has no
// single-byte encoding and is REJECTED E1004 — the self-hosted oracle behaviour (the C# bootstrap silently
// best-fit-transliterates it, which shv2 must not). Ported from `maxon-selfhosted` Parser.maxon:11069-11284.

// The high-bit threshold: a source byte `< AsciiCeiling` is a bare ASCII byte; `>= AsciiCeiling` opens a
// multi-byte UTF-8 sequence. A byte-string codepoint must fit in `[0, ByteCodepointMax]` (Latin-1).
let AsciiCeiling = 128 as Byte
let ByteCodepointMax = 255 as ParsedInt

// The low byte of a codepoint (its Latin-1 encoding for a valid one; a harmless recovery value otherwise).
let ByteMask = 255 as ParsedInt
let LowerX = 120 as Byte
let LowerU = 117 as Byte

// A hex nibble is 4 bits; `\xNN` = `\` `x` + 2 hex digits (4 bytes), `\uNNNN` = `\` `u` + 4 hex digits (6).
let HexNibbleBits = 4 as ParsedInt
let HexEscapeDigits = 2 as ByteOffset
let UniEscapeDigits = 4 as ByteOffset
let EscapeMarkerBytes = 2 as ByteOffset

// UTF-8 continuation/lead masks and thresholds (RFC 3629). `Utf8ContinuationMask` keeps the low 6 payload
// bits of a continuation byte; the lead masks keep 5/4/3 payload bits of a 2/3/4-byte lead.
let Utf8LeadTwoByteFloor = 0xC0 as ParsedInt
let Utf8LeadThreeByteFloor = 0xE0 as ParsedInt
let Utf8LeadFourByteFloor = 0xF0 as ParsedInt
let Utf8ContinuationMask = 0x3F as ParsedInt
let Utf8LeadTwoByteMask = 0x1F as ParsedInt
let Utf8LeadThreeByteMask = 0x0F as ParsedInt
let Utf8LeadFourByteMask = 0x07 as ParsedInt
let Utf8ContinuationBits = 6 as ParsedInt
let Utf8ThreeByteHighShift = 12 as ParsedInt
let Utf8FourByteHighShift = 18 as ParsedInt

// The lowercase hex digits and the minimum width a `U+NNNN` codepoint renders at.
let HexDigitsLower = "0123456789abcdef"
let HexRadix = 16 as ParsedInt
let CodepointHexMinDigits = 4 as ByteOffset
let AsciiZeroByte = 48 as Byte

// One decoded UTF-8 sequence: the codepoint and how many source bytes it occupied (1..4).
type Utf8Sequence
	export let codepoint as ParsedInt
	export let byteLength as ByteOffset

	static function of(codepoint ParsedInt, byteLength ByteOffset) returns Self
		return Self{codepoint: codepoint, byteLength: byteLength}
	end 'of'
end 'Utf8Sequence'

// ⭐ Decode a `b"…"` literal body (the raw bytes between the quotes, escapes undecoded) to its Latin-1 byte
// payload. `tok` positions the E2015 an UNKNOWN escape raises (the byte-string twin of `decodeEscapes`'
// `unknownEscape`); a codepoint-range rejection is E1004 and rendered anchor-less (see `reportParseError`).
function decodeByteStringLiteral(raw ByteArray, tok Token) returns ByteArray throws ParseError
	var buf = ByteArray.create()
	let len = raw.count()
	var i = 0 as ByteOffset
	while i < len 'decode'
		let ch = try raw.get(i) otherwise panic("decodeByteStringLiteral: i < len just held but get({i}) failed")
		if ch != Backslash or i + 1 >= len 'notEscape'
			i = try appendLiteralByteStringByte(buf, raw: raw, at: i, ch: ch)
			continue
		end 'notEscape'
		i = try appendByteStringEscape(buf, raw: raw, at: i, len: len, tok: tok)
	end 'decode'
	return buf
end 'decodeByteStringLiteral'

// A NON-escape byte at `at`: a bare ASCII byte is emitted verbatim; a `>= AsciiCeiling` byte opens a
// multi-byte UTF-8 sequence collapsed to its ONE Latin-1 byte (codepoint > 0xFF ⇒ E1004). Returns the
// index of the next byte to decode.
function appendLiteralByteStringByte(buf ByteArray, raw ByteArray, at ByteOffset, ch Byte) returns ByteOffset throws ParseError
	if ch < AsciiCeiling 'ascii'
		buf.push(ch)
		return at + 1
	end 'ascii'
	let seq = decodeUtf8Sequence(raw, start: at)
	try requireByteCodepoint(seq.codepoint)
	buf.push((seq.codepoint and ByteMask) as Byte)
	return at + seq.byteLength
end 'appendLiteralByteStringByte'

// An escape at `at` (`raw[at]` is `\`, and `at + 1 < len`). `\xNN` emits an exact raw byte; `\uNNNN` maps a
// codepoint to one Latin-1 byte (> 0xFF ⇒ E1004); every other `\c` resolves through the shared `escapeByte`
// table (an unknown one is E2015). Returns the index of the next byte to decode.
function appendByteStringEscape(buf ByteArray, raw ByteArray, at ByteOffset, len ByteOffset, tok Token) returns ByteOffset throws ParseError
	let next = try raw.get(at + 1) otherwise panic("appendByteStringEscape: at + 1 < len just held but get({at + 1}) failed")
	if next == LowerX 'hexEscape'
		try requireByteStringHexEscape(raw, at: at, len: len, digitCount: HexEscapeDigits, tok: tok)
		buf.push(hexEscapeByte(raw, at: at))
		return at + EscapeMarkerBytes + HexEscapeDigits
	end 'hexEscape'
	if next == LowerU 'uniEscape'
		try requireByteStringHexEscape(raw, at: at, len: len, digitCount: UniEscapeDigits, tok: tok)
		let cp = uniEscapeCodepoint(raw, at: at)
		try requireByteCodepoint(cp)
		buf.push((cp and ByteMask) as Byte)
		return at + EscapeMarkerBytes + UniEscapeDigits
	end 'uniEscape'
	match escapeByte(next) 'esc'
		byte(b) then buf.push(b)
		unknown then throw ParseError.unsupported("the escape sequence '\\{String.from(byteSlice(next))}' in a byte string literal is not a recognized escape", line: tok.line, column: tok.column)
	end 'esc'
	return at + EscapeMarkerBytes
end 'appendByteStringEscape'

// Reject a codepoint with no single-byte Latin-1 encoding (`> 0xFF`) as E1004. The message names the
// codepoint in the oracle's `U+NNNN` (lowercase-hex, ≥ 4-digit) form and is rendered anchor-less.
function requireByteCodepoint(codepoint ParsedInt) throws ParseError
	if codepoint > ByteCodepointMax 'tooBig'
		throw ParseError.byteStringCodepointRange(byteStringCodepointRangeMessage(codepoint))
	end 'tooBig'
end 'requireByteCodepoint'

// ⭐ **A `b"…"` BLOB IS BYTE-PACKED BY CONSTRUCTION, so the literal is a value of `Array with Byte` only
// while THIS program's `Byte` is one byte wide** — the E2015 both throw sites of that rule share
// (`Parser.requireByteStringBlobStridesLikeItsType` and its const-sweep twin), so the two cannot come to
// describe one defect differently.
//
// `LowerMaxonToStd.lowerByteStringLiteral` lays the blob out one byte per element and stamps
// `element_size@24 = ByteStringElementSize` to match it; every OTHER `Array with Byte` record — `.create()`,
// a global's `__arr_create`, a `clone`/`slice` of either — is stamped from `ProgramSignatures.arrayElementSize`,
// which sizes the element from `Byte`'s DECLARED range. The two agree for the canonical `int(0 to u8.max)`
// and for anything narrower, which is the whole of what a byte string is; they do not agree for a wider one.
//
// ⚠ **WITHOUT THE GATE THAT DISAGREEMENT IS A SILENT WRONG ANSWER, NOT MERELY AN ABORT.** Measured with
// `typealias Byte = int(0 to 1000)`: two `Bytes` values, the same `push(300)` then `get(2)`, read back **44**
// from the literal-produced record and **300** from the `.create()`-produced one — one static type, two
// behaviours, no diagnostic. (`append` between the two does abort — `RuntimeAbort.arrayAppendElementSizeMismatch`
// — but it is the ONE array operation that compares the strides.) There is no reference behaviour to match:
// the bootstrap mis-answers the same program its own way, packing the blob and then TYPING the array u16, so
// `b"CD".get(0)` reads **17475**. Emitting the blob WIDE is an element-wise widening emission — a real
// mechanism and its own rung, exactly as the widening `__arr_append` across differing strides is — so until
// that exists this is E2015 at the literal rather than a record that behaves unlike every other value of its
// own type.
function byteStringBlobStrideMessage(declaredStride ParsedInt) returns String
	return "a `b\"…\"` byte-string literal in a program whose `Byte` is a {declaredStride}-byte range: the literal's blob is byte-PACKED, so its record would stride 1 while every `Array with Byte` built by `.create()` strides {declaredStride} — two values of one type that behave differently. Declare `Byte` as `int(0 to u8.max)` (or any range that fits one byte), or build the array with `.create()` + `push`"
end 'byteStringBlobStrideMessage'

// The exact E1004 text v1 emits (`reportByteStringCodepointRange`), including the literal `\xNN` guidance.
function byteStringCodepointRangeMessage(codepoint ParsedInt) returns String
	return "Codepoint U+{formatCodepointHex(codepoint)} exceeds the byte range 0-255 in byte string literal; use a \\xNN hex escape to embed a raw byte"
end 'byteStringCodepointRangeMessage'

// Render `codepoint` as lowercase hex, zero-padded to at least `CodepointHexMinDigits` — the `U+0100` /
// `U+1f600` form the diagnostic uses. Built least-significant-digit first, then reversed.
function formatCodepointHex(codepoint ParsedInt) returns String
	let digits = HexDigitsLower.toByteArray()
	var lowFirst = ByteArray.create()
	var v = codepoint
	while v > 0 'emit'
		let nibble = v mod HexRadix
		lowFirst.push(try digits.get(nibble) otherwise panic("formatCodepointHex: nibble {nibble} out of the 16-digit table"))
		v = v / HexRadix
	end 'emit'
	while lowFirst.count() < CodepointHexMinDigits 'pad'
		lowFirst.push(AsciiZeroByte)
	end 'pad'
	var out = ByteArray.create()
	var i = lowFirst.count()
	while i > 0 'reverse'
		i = i - 1
		out.push(try lowFirst.get(i) otherwise panic("formatCodepointHex: reverse index {i} out of range"))
	end 'reverse'
	return String.from(out)
end 'formatCodepointHex'

// Validate that a `\x`/`\u` escape at `at` is followed by exactly `digitCount` hex digits in bounds; an
// ill-formed one is E2015 (positioned). No enabled spec hits this — it is the correctness floor that keeps a
// malformed escape a clean reject rather than a silent mis-decode.
function requireByteStringHexEscape(raw ByteArray, at ByteOffset, len ByteOffset, digitCount ByteOffset, tok Token) throws ParseError
	let firstDigit = at + EscapeMarkerBytes
	let afterDigits = firstDigit + digitCount
	if afterDigits > len or not hexDigitsPresent(raw, from: firstDigit, to: afterDigits) 'malformed'
		throw ParseError.unsupported("a malformed hex/unicode escape in a byte string literal: `\\x`/`\\u` must be followed by {digitCount} hex digits", line: tok.line, column: tok.column)
	end 'malformed'
end 'requireByteStringHexEscape'

function hexDigitsPresent(raw ByteArray, from ByteOffset, to ByteOffset) returns bool
	var i = from
	while i < to 'each'
		if not isHexDigit(try raw.get(i) otherwise panic("hexDigitsPresent: i < to <= len but get({i}) failed")) 'notHex'
			return false
		end 'notHex'
		i = i + 1
	end 'each'
	return true
end 'hexDigitsPresent'

// The 0..15 value of a hex-digit byte — caller must have validated it via `hexDigitsPresent`.
function hexDigitValue(b Byte) returns ParsedInt
	if b >= '0' and b <= '9' 'digit'
		return (b - '0') as ParsedInt
	end 'digit'
	if b >= 'a' and b <= 'f' 'lower'
		return (b - 'a' + 10) as ParsedInt
	end 'lower'
	if b >= 'A' and b <= 'F' 'upper'
		return (b - 'A' + 10) as ParsedInt
	end 'upper'
	panic("hexDigitValue: byte {b} is not a hex digit (caller must validate via hexDigitsPresent)")
end 'hexDigitValue'

// The raw byte a `\xNN` escape at `at` denotes: `(hi << 4) | lo`.
function hexEscapeByte(raw ByteArray, at ByteOffset) returns Byte
	let hi = hexDigitValue(try raw.get(at + 2) otherwise panic("hexEscapeByte: validated digit at {at + 2} missing"))
	let lo = hexDigitValue(try raw.get(at + 3) otherwise panic("hexEscapeByte: validated digit at {at + 3} missing"))
	return ((hi shl HexNibbleBits) or lo) as Byte
end 'hexEscapeByte'

// The codepoint a `\uNNNN` escape at `at` names (4 validated hex digits at `at+2 .. at+5`).
function uniEscapeCodepoint(raw ByteArray, at ByteOffset) returns ParsedInt
	let d1 = hexDigitValue(try raw.get(at + 2) otherwise panic("uniEscapeCodepoint: validated digit at {at + 2} missing"))
	let d2 = hexDigitValue(try raw.get(at + 3) otherwise panic("uniEscapeCodepoint: validated digit at {at + 3} missing"))
	let d3 = hexDigitValue(try raw.get(at + 4) otherwise panic("uniEscapeCodepoint: validated digit at {at + 4} missing"))
	let d4 = hexDigitValue(try raw.get(at + 5) otherwise panic("uniEscapeCodepoint: validated digit at {at + 5} missing"))
	return (d1 shl 12) or (d2 shl 8) or (d3 shl HexNibbleBits) or d4
end 'uniEscapeCodepoint'

// Decode the UTF-8 sequence starting at `start` to its codepoint + byte length (1..4). A malformed or
// truncated sequence decodes as its lone lead byte (length 1) so the decode stays aligned — a byte-string
// with genuinely broken UTF-8 is rare and its lead byte is `<= 0xFF`, so it degrades to a raw byte rather
// than desyncing. Ported from `maxon-selfhosted` Parser.maxon:11239-11264.
function decodeUtf8Sequence(raw ByteArray, start ByteOffset) returns Utf8Sequence
	let n = raw.count()
	let b0 = (try raw.get(start) otherwise panic("decodeUtf8Sequence: start {start} out of bounds")) as ParsedInt
	if b0 < Utf8LeadTwoByteFloor or start + 1 >= n 'loneLead'
		return Utf8Sequence.of(b0, byteLength: 1)
	end 'loneLead'
	let b1 = (try raw.get(start + 1) otherwise panic("decodeUtf8Sequence: continuation 1 out of bounds")) as ParsedInt
	if b0 < Utf8LeadThreeByteFloor 'twoByte'
		return Utf8Sequence.of(((b0 and Utf8LeadTwoByteMask) shl Utf8ContinuationBits) or (b1 and Utf8ContinuationMask), byteLength: 2)
	end 'twoByte'
	if start + 2 >= n 'truncated3'
		return Utf8Sequence.of(b0, byteLength: 1)
	end 'truncated3'
	let b2 = (try raw.get(start + 2) otherwise panic("decodeUtf8Sequence: continuation 2 out of bounds")) as ParsedInt
	if b0 < Utf8LeadFourByteFloor 'threeByte'
		return Utf8Sequence.of(((b0 and Utf8LeadThreeByteMask) shl Utf8ThreeByteHighShift) or ((b1 and Utf8ContinuationMask) shl Utf8ContinuationBits) or (b2 and Utf8ContinuationMask), byteLength: 3)
	end 'threeByte'
	if start + 3 >= n 'truncated4'
		return Utf8Sequence.of(b0, byteLength: 1)
	end 'truncated4'
	let b3 = (try raw.get(start + 3) otherwise panic("decodeUtf8Sequence: continuation 3 out of bounds")) as ParsedInt
	return Utf8Sequence.of(((b0 and Utf8LeadFourByteMask) shl Utf8FourByteHighShift) or ((b1 and Utf8ContinuationMask) shl Utf8ThreeByteHighShift) or ((b2 and Utf8ContinuationMask) shl Utf8ContinuationBits) or (b3 and Utf8ContinuationMask), byteLength: 4)
end 'decodeUtf8Sequence'

// --- M4b loop / on-the-fly SSA support ---

// How many bindings of a kind were in scope when a lexical block was opened. A `var`
// declared inside the block joins `Parser.mutableVars`, and must LEAVE it at the
// block's `end`: a binding no source line can name any more must not receive a loop
// phi, nor take a slot in a merge snapshot. Wide range: declaration counts are unbounded.
typealias BindingMark = int(0 to u64.max)

// The floor `emitScopeDrops` releases down to at a FUNCTION exit — the base of the owned-binding
// stack, so every owned binding still in scope is dropped. A block or loop exit passes its own
// recorded height instead, releasing only what it declared.
let WholeFunctionScopeFloor = 0 as BindingMark

// A height in the PENDING-TEMPORARY list — the twin of `BindingMark` for owned temporaries rather than
// owned bindings. A branching construct records the height before it parses a region (a condition, a
// scrutinee, a match arm, a short-circuit's right-hand side) and releases everything enrolled ABOVE it
// once that region's control flow is still single-threaded. See `drainPendingTemps`.
typealias TempDropMark = int(0 to u64.max)

// The floor `drainPendingTemps` releases down to when the WHOLE list goes — a statement's own tail drain
// and a hand-off exit (`return`/`throw`) both end every temporary the statement owns. A region passes its
// own recorded height instead, releasing only what IT built. Named for `WholeFunctionScopeFloor`'s reason:
// a bare `0` at a call site reads as an index into the list rather than as "all of them".
let WholeStatementTempFloor = 0 as TempDropMark

// What a lexical block must be unwound to — the heights of BOTH per-binding lists the parser
// keeps beside `Scope`.
//
// A `type` rather than two return values, because the two heights are one FACT ("where this block
// began") and are read by one caller. Passing them separately is how the two would eventually be
// captured at different moments; a block that recorded its mutable height on entry and its owned
// height a statement later would drain a binding it did not open.
type BlockMark
	export let mutableCount as BindingMark
	export let ownedCount as BindingMark

	export static function create(mutableCount BindingMark, ownedCount BindingMark) returns BlockMark
		return Self{mutableCount: mutableCount, ownedCount: ownedCount}
	end 'create'
end 'BlockMark'

// A snapshot of the PATH-SENSITIVE move state of every owned binding in scope — the twin of
// `snapshotBindings` (which snapshots `boundValue` for the merge phis), for the one bit that must be
// reconciled at a control-flow join rather than accumulated monotonically.
//
// `movedFrom` is that bit: it says "this binding's owned value was handed to another owner, so its
// scope-exit drop is skipped". Set unconditionally where a move is WRITTEN, it leaks onto sibling
// branches — a value moved on ONE `if` branch reads as moved on the branch that never moved it, so its
// drop is skipped there and it LEAKS. Reconciling this bit at each join (restore it around a sibling
// branch, drop the value on the branches that kept it live) is what makes the drop path-sensitive.
//
// `partiallyMoved` is deliberately NOT snapshotted: it never SKIPS a drop (a partially-moved union box
// still drops through its cascade), so leaking it across a branch only over-rejects a later read — sound
// — while the value is always dropped correctly. Only `movedFrom` gates a drop, so only it needs this.
//
// Positional over `ownedBindings`, whose height is STABLE at every join point (a branch's own owned
// bindings are declared above the join's owned floor and popped at the branch's `end` before the join
// runs). `values` carries each binding's `boundValue` at capture time, so a drop placed on an edge that
// kept a binding LIVE decrefs the value that edge actually holds.
type MoveMark
	export let moved as BoolArray
	export let values as ValueIdArray

	export static function create(moved BoolArray, values ValueIdArray) returns MoveMark
		return Self{moved: moved, values: values}
	end 'create'
end 'MoveMark'

// The union of two move marks' `movedFrom` bits — the move state of a path that ran BOTH the moves `a`
// records and the moves `b` records. Its one use is the inline-conditional's TRUE path: the true arm's
// own moves (`a`), plus the unconditionally-evaluated condition's (`b`), which parse in the opposite
// order to how they run (`parseTernaryExpression`). Both marks are positional over the SAME owned-binding
// stack — its height is stable across a ternary, since an expression declares no binding — so the union is
// per-position. Values are identical between the two (an expression reassigns no binding's value), so
// either's serve.
function orMoveMarks(a MoveMark, b MoveMark) returns MoveMark
	if a.moved.count() != b.moved.count() 'drifted'
		panic("orMoveMarks: mark heights {a.moved.count()} and {b.moved.count()} differ — the owned-binding stack moved between captures")
	end 'drifted'
	var moved = BoolArray.create()
	for i in 0 upto a.moved.count() 'each'
		let am = try a.moved.get(i) otherwise panic("orMoveMarks: a.moved.get OOB at {i}")
		let bm = try b.moved.get(i) otherwise panic("orMoveMarks: b.moved.get OOB at {i}")
		moved.push(am or bm)
	end 'each'
	return MoveMark.create(moved, values: b.values)
end 'orMoveMarks'

// How a `try … otherwise …`'s error handler affects the merge (P1.4b). The success (`ok`) block always
// carries the tryCall's `result`; the error block's shape is one of:
//   • `value(v)`      — `otherwise <expr>` produced a fallback value; both edges merge into a result phi.
//   • `terminated`    — propagate / `otherwise return|break|continue|throw|panic` left the error block via
//                       its own terminator, so ONLY the ok block reaches the continuation (no merge).
//   • `fellThrough`   — `otherwise ignore` or a block handler that falls through: both edges reach the
//                       continuation with no try-value (a statement form), merging only carried vars.
union TryHandler
	value(otherwiseValue ValueId)
	terminated
	fellThrough
end 'TryHandler'

// ⭐ **WHAT A `try` IS APPLIED TO — the ONE thing the whole desugar asks about its target (P1.7a slice
// 2b-v).** Everything downstream of `rewriteLastCallToTryCall` wants exactly two facts: the NAME a
// diagnostic blames (E3055/E3059, the void-result E3059) and the ERROR TYPE the target throws (which types
// the `(e)` binding and decides whether the caught error is a heap box). A direct call and an awaited
// promise answer the second by NAME — `ProgramSignatures.throwsOf` — which is why the desugar used to
// thread a bare `callee ByteArray`. A WITNESS dispatch cannot: an interface method is in no signature
// registry, and the only place its `throws` exists is the `where`-constraint resolution the parser just did.
//
// So the two shapes are kept as one union with two accessors (`tryTargetName`/`tryTargetThrows`) rather
// than by widening the thread to a `(name, clause)` pair: `requireThrowingTryTarget` must ALSO distinguish
// them — a name that no file declares is left to E3004, while a witness method that no file declares is
// normal and its non-throwing case is a real E3055 — and a pair would have lost exactly that.
union TryTarget
	// A DIRECT call or an `await`ed promise: the callee NAME, which the signature index answers for.
	named(callee ByteArray)
	// A witness-dispatched interface method (P1.7a slice 2b-v): the method NAME for diagnostics, and the
	// interface's own declared `throws` clause — the only carrier of that fact.
	witness(methodName ByteArray, throwsClause ThrowsClause)
end 'TryTarget'

// The NAME a diagnostic blames for a `try` target — the first of the two questions the desugar asks it. A
// direct/awaited callee blames its callee name; a witness dispatch blames the interface method the author
// actually wrote (the witness table is a compiler artifact with no user spelling).
function tryTargetName(target TryTarget) returns ByteArray
	return match target 'kind'
		named(callee) gives callee
		witness(methodName, _) gives methodName
	end 'kind'
end 'tryTargetName'

// **E3055 for a WITNESS `try` target** — a `try` on an interface method whose declaration carries no
// `throws`. Unconditional, unlike its named twin: an interface method is in no signature registry, so there
// is no "undeclared, leave it to E3004" case to exempt, and the clause is a fact the constraint resolution
// already established.
function requireThrowingWitnessTryTarget(methodName ByteArray, throwsClause ThrowsClause, tryTok Token) throws ParseError
	if not throwsClauseIsThrowing(throwsClause) 'nonThrowing'
		throw ParseError.tryOnNonThrowing(String.from(methodName), line: tryTok.line, column: tryTok.column)
	end 'nonThrowing'
end 'requireThrowingWitnessTryTarget'

// The result of `captureEnclosing` (P1.5-A2b): a name that resolved into an enclosing frame yields
// `captured` with the value read out of the env block; any other name is `notCaptured` and resolves
// through the ordinary top-level path.
union CaptureResult
	captured(value ValueId)
	notCaptured
end 'CaptureResult'

// The result of `captureScopeOf` (P1.5-A2b-2): the immediate enclosing scope that binds a name for capture,
// or `notCaptured`. Distinct from `CaptureResult` — this yields the SCOPE (so a caller can read the binding's
// TYPE, e.g. to resolve a captured struct base's layout), where `CaptureResult` yields the read VALUE.
union CaptureScopeResult
	found(scope Scope)
	notCaptured
end 'CaptureScopeResult'

// ⭐ **WHAT A TOP-LEVEL MANAGED NAME DENOTES AT A METHOD-RECEIVER POSITION** — `managedReceiverBindingOf`'s
// answer, and the reason it is a union rather than two booleans: the two kinds of managed binding need
// DIFFERENT payloads to build a receiver from (a `let` needs the bytes it re-materializes; a `var` needs
// the slot's label and type to load from), and the predicate and the dispatch must read ONE resolution or
// they can claim a shape for a door the other resolves differently.
//
// `none` is an ANSWER, not a failure: the name is spelled like a managed binding somewhere in the program
// but is not visible from THIS file (the file-scoped key), so the shape is not a method call at all.
//
// ⚠ **IT IS BUILT ONLY PAST `Parser.managedTopLevelBaseAt`, AND THAT GATE IS A BOOL FOR THIS UNION'S SAKE.**
// A Maxon union value is a heap object, `none` included, so a version of the gate that answered with this
// type allocated once per DOTTED CALL in the program instead of once per managed-receiver call site — a
// measured +3,465 allocations on rung 5 of a corpus that declares no managed binding at all, doubling with
// the program. The narrow answer is not the cheap one here; the narrow QUESTION is.
union ManagedReceiverBinding
	// A managed `let` (P1.7a) — `bytes`/`kind` are what `emitManagedConstant` re-materializes.
	constant(bytes ByteArray, kind ManagedConstKind)
	// A STORED managed binding (a `var`, P1.7 slice 2a; or an array `let`, P1.7 slice 2b) —
	// `label`/`valueType` are what `emitGlobalLoad` reads the slot with, and `mutable` is what decides
	// whether a receiver-writing method on it is legal. It carries that bit rather than assuming `true`
	// because an array `let` is stored AND immutable: `Live.push(1)` must be E3019 where `Buffer.push(1)`
	// is legal, and the synthetic `VarInfo` the dispatch wears is the only thing that can say so.
	global(label ByteArray, valueType MaxonType, mutable bool)
	none
end 'ManagedReceiverBinding'

// One incoming edge at a control-flow join, for the move reconciliation: the predecessor block a drop is
// emitted INTO when this edge kept a binding live, paired with the move state that edge carries. An
// `if`/`else` builds two (the then and else ends); a `match` builds one per reaching arm.
type ReachingMoveEdge
	export let block as IrBlock
	export let mark as MoveMark

	export static function create(block IrBlock, mark MoveMark) returns ReachingMoveEdge
		return Self{block: block, mark: mark}
	end 'create'
end 'ReachingMoveEdge'

typealias ReachingMoveEdgeArray = Array with ReachingMoveEdge

// A loop-header (or loop-exit) phi: the mutable BINDING it carries, paired with the
// block-arg ValueId minted for it. POSITIONAL — the k-th phi var corresponds to
// `blockArgs[k]` on the merge block and to `argIds[k]` on every predecessor's
// `BranchEdge`, so all three follow one order.
//
// That order is declaration order over the bindings the loop CARRIES — the mutable vars in
// scope that its body assigns (`parseWhileStatement`) — which is a SUBSET of `mutableVars`,
// not a copy of it. So a phi list is indexed by phi position and never by a binding's index
// in `mutableVars`; the two coincided once and no longer do.
//
// The binding is held as the `VarInfo` OBJECT, not as its name. A name cannot address
// it: a block nested inside the loop may SHADOW the name, and then a name-keyed read
// would fetch the shadow — so `break`ing out of such a block would carry the shadow's
// value into the loop's exit phi. A silent miscompile, and the reason `Scope` mutates
// bindings in place instead of replacing them (see Scope's header).
type LoopPhiVar
	export var binding as VarInfo
	export var phiId as ValueId
	// The binding's value on the PREHEADER edge — the one edge into the header that comes from OUTSIDE
	// the loop. It is captured at mint time because installing the phi (`binding.boundValue = phiId`)
	// overwrites the very field it would otherwise be read from, and the preheader's block-arg list is
	// built AFTER every phi has been minted (`edgeArgsFor(preLoop: true)`).
	export var entryValue as ValueId

	export static function create(binding VarInfo, phiId ValueId, entryValue ValueId) returns LoopPhiVar
		return Self{binding: binding, phiId: phiId, entryValue: entryValue}
	end 'create'
end 'LoopPhiVar'

typealias LoopPhiVarArray = Array with LoopPhiVar

// The variable names a construct's token extent ASSIGNS — the set `parseWhileStatement` intersects
// with the mutable bindings in scope to decide which ones the loop carries a phi for. Keyed by
// the identifier's raw source slice, which is how every other name lookup in the parser is keyed
// (`ByteArray` hashes and compares by content — see Token.value).
typealias AssignedNameSet = Set with ByteArray

// A dense per-TOKEN column of token indices — `Parser.blockExtentEnds`, which answers "where does the block
// opened here close?" in one array read. Flat and dense for the reason `SourceRangeTable`'s columns are: a
// per-opener heap object would be one live allocation per construct, on the token array's own scale.
typealias TokenIndexColumn = Array with TokenIndex

// The INITIAL `Parser.blockExtentEnds`, AND the anchor whose `is`-identity says the index has not been built
// yet — `sharedEmptyInstanceAliasMap`'s pattern, for its reason and with its invariant. A parser that never
// asks where a block closes (the signature sweep, a file with no `if`/`while`/`match`) allocates nothing
// here, and `buildBlockExtentIndex` REPLACES the field with a fresh column rather than mutating this one, so
// it stays empty and is safe to share across the per-file parse fan-out. Reading it before the build is
// harmless: `matchingEndOf` is the only reader and an empty column makes it panic rather than answer.
let sharedEmptyBlockExtentEnds = TokenIndexColumn.create()

// The bare member names of a generic type's inner ranged typealiases, in scope while its body is parsed
// (P1.6-C, `Parser.enclosingInnerAliases`). Keyed by content like every other name set here.
typealias InnerAliasNameSet = Set with ByteArray

// A per-function map from an SSA value that is a generic INSTANCE (`WrapperA.create(…)`'s result, or a
// `Self`-returning method result on such a receiver) to the interned NAME id of the instance ALIAS it
// came from (`WrapperA`) — the alias name the value's shared `GenericInstanceId` cannot recover (P1.6-C).
// It is the parse-time carrier the method-return retype and the per-instance argument check read: a
// method's `Idx` return is re-qualified to `named("{alias}.Idx")`, and an inner-alias argument is checked
// against the receiver's `{alias}`. A value with NO entry has no statically-known instance alias, so its
// `Idx` results and arguments DECAY to plain (no per-instance identity) — which matches the oracle.
typealias ValueInstanceAliasMap = Map with (ValueId, TypeNameId)

// The per-function set of SSA values loaded out of an IMMUTABLE top-level global's slot (P1.7 slice 2b) —
// see `Parser.immutableGlobalReads` for what it decides and why it is a hash set rather than a list.
typealias ImmutableGlobalReadSet = Set with ValueId

// One enclosing loop on the parser's loop-context stack. `break`/`continue` read it
// to find their targets (innermost, or by label) and to build the block-arg value
// lists they carry to the exit / header. Because the header phis are created EAGERLY
// at loop entry (before the body is parsed), every in-edge can fill its BranchEdge
// argIds immediately from the current variable values — there is no deferred
// phi-operand backpatching, which keeps the loop lowering a single forward pass.
//
// This mirrors v1's parser loop stack (maxon-selfhosted Parser.parseWhileStatement:
// same cond/header + body + exit block shape, same entry→header branch and
// condBr(then=body, else=exit)). It carries v1's separate continue target too
// (`continueTargetId`): in a `while`, `continue` re-evaluates the condition, so its
// target IS the header; a `for`'s `continue` must run the STEP block's increment first,
// or the counter never advances and the loop spins forever (v1 Parser.maxon:10137-10139
// and the reference bootstrap 2-Parser.cs:13150-13153 both carry that comment, both
// having hit it). A `while` sets it to its own header, so there is exactly ONE rule here
// and `parseContinueStatement` has no construct to branch on.
type LoopContext
	export var label as ByteArray
	// ⭐ **WHERE A COMPLETED ITERATION GOES** — the header for a `while` (the condition is re-evaluated
	// on the back edge), the STEP block for a `for` (whose increment must run first). Read by BOTH
	// `continue` and each parser's fall-through back edge, which is what makes it one fact rather than
	// two agreeing spellings.
	//
	// ⚠ There is deliberately no separate header field beside it. There was, and NOTHING EVER READ IT:
	// write-only state whose value COINCIDED with this one for `while` and not for `for`, so a future
	// reader reaching for the obvious-sounding name would have got `while` right, `for` wrong, and no
	// diagnostic either way. The exit is a field below because it is genuinely a different destination.
	export var continueTargetId as BlockId
	export var exitId as BlockId
	export var phiVars as LoopPhiVarArray
	// True once at least one `break` targeted this loop — the exit then merges the
	// header-false-edge value with each break's value, so it needs its own phis.
	export var hasBreak as bool
	// The owned-binding height when this loop's body was entered — the floor a `break`/`continue`
	// releases down to, dropping every owned binding declared since (this iteration's body-local
	// Strings/structs) before it jumps to the exit / back-edge. Equal to the body block's
	// `BlockMark.ownedCount`, because nothing is pushed between recording it and opening the body.
	export var ownedFloor as BindingMark

	export static function create(label ByteArray, continueTargetId BlockId, exitId BlockId, phiVars LoopPhiVarArray, ownedFloor BindingMark) returns LoopContext
		return Self{label: label, continueTargetId: continueTargetId, exitId: exitId, phiVars: phiVars, hasBreak: false, ownedFloor: ownedFloor}
	end 'create'
end 'LoopContext'

typealias LoopContextArray = Array with LoopContext

// The name of the internal binding a `for … in` over an OWNED array TEMPORARY moves that temporary
// into (`parseForStatement`). It is never installed in a `Scope`, so no source line can name it; the
// `__` prefix is what says so anyway, since `requireUnreservedName` bars every declaration from that
// space. It exists only so `emitScopeDrops` — which drops BINDINGS — reaches the record.
let IterationSourceBindingName = b"__for_source"

// The value a match arm produces, if any: `none` for a `then` (statement) arm, `value` for a
// `gives` (expression) arm. A union rather than a `ValueId` plus a bool — for the reason
// `ReceiverArg` is one: a `ValueId` has no empty value, and a sentinel would be READ downstream
// as a real operand.
union MatchGiveValue
	none
	value(id ValueId)
end 'MatchGiveValue'

// The stateful bookkeeping a single enum/union declaration's case loop threads across its cases:
// the auto-increment TAG counter, and the BACKING (int vs float) that the first explicitly-typed
// case fixes.
//
// A `type` (one heap object per declaration, on the cold declaration path) rather than three
// out-params, which Maxon has no clean spelling for: the counter and the backing decision must
// PERSIST across cases (a bare `b` after `a = 5` must read `6`), so a caller that read them back by
// value would lose the update. `backingResolved` gates `backingIsFloat` — the latter is meaningless
// until the first `= <literal>` sets it, exactly as `StructLayout` has no field until `addField`.
type EnumBackingState
	// The tag the NEXT bare (or first) case takes. Starts at 0; an explicit `= N` resets it to N+1,
	// which is what gives `enum E { a = 5  b }` the tag 6.
	export var nextTag as ParsedInt
	// Has any case fixed the backing yet? Until one does, a case of either kind is accepted and sets
	// it; after, a mismatch is E3032.
	export var backingResolved as bool
	// Which backing, once resolved: float (`= 1.5`) or int (bare, or `= 5`). Read only when
	// `backingResolved`.
	export var backingIsFloat as bool

	export static function create() returns EnumBackingState
		return Self{nextTag: 0, backingResolved: false, backingIsFloat: false}
	end 'create'
end 'EnumBackingState'

// Is `kind` a LITERAL token — an int/float/string/char/byte-string literal? Used to tell a keyword
// used as a case NAME (`keyword-as-case-name.md`: `function`, `end`, ...) from a literal, which the
// lexer emits as its own kind carrying its text. THE one list, so the case-name reader and any
// later reader cannot drift on what counts as a literal.
function tokenIsLiteralKind(kind TokenKind) returns bool
	return kind == TokenKind.intLiteral or kind == TokenKind.floatLiteral or kind == TokenKind.stringLiteral or kind == TokenKind.charLiteral or kind == TokenKind.byteStringLiteral
end 'tokenIsLiteralKind'

// Can `tok` serve as an enum/union CASE NAME? An identifier, or a KEYWORD used as one — `enum
// TokenType { function return end if … }` is legal (`keyword-as-case-name.md`), and a keyword
// carries its source spelling in `.value` (the lexer emits it through the same path an identifier
// takes). The signal that a token is word-shaped rather than punctuation is that it carries text: a
// punctuator, `newline` and EOF all carry the shared EMPTY slice (see Token.value), while a literal
// carries text but is ruled out by its KIND. So a case name is an identifier, or any non-literal
// token that carries a spelling.
function tokenNamesEnumCase(tok Token) returns bool
	if tok.kind == TokenKind.identifier 'plainIdentifier'
		return true
	end 'plainIdentifier'
	if tok.value.isEmpty() 'punctuationOrEof'
		return false
	end 'punctuationOrEof'
	return not tokenIsLiteralKind(tok.kind)
end 'tokenNamesEnumCase'

// Does a scrutinee's type name resolve to a declared enum/union? The predicate `parseMatchCommon`
// branches enum-vs-scalar on, factored out so the flag and the layout extraction below cannot come
// to disagree about what "is an enum match" means.
function enumMatchIsDeclared(decl DeclaredEnum) returns bool
	return match decl 'kind'
		declared gives true
		undeclared gives false
	end 'kind'
end 'enumMatchIsDeclared'

// The layout behind a `declared` enum match — called ONLY where `enumMatchIsDeclared` already
// answered true, so `undeclared` is a caller-guard break, not a program error. Returns the layout
// REFERENCE (no allocation), so re-extracting it at each of the three enum branch sites is free.
function requireEnumLayout(decl DeclaredEnum) returns EnumLayout
	match decl 'kind'
		declared(layout) then return layout
		undeclared then panic("requireEnumLayout: called on a scalar match — guard with enumMatchIsDeclared")
	end 'kind'
end 'requireEnumLayout'

// A match arm that reaches the merge block — its exit block, the carried-variable values it
// leaves scope with, and (expression form only) the value it `gives`. Collected as the arms are
// parsed and drained by `finalizeMatchMerge`, which mints the merge's phis from the whole set.
//
// ⭐ This IS shv2's departure from both references: v1 and the bootstrap join a match's arms
// through a mutable result SLOT (a store per arm, one load at the merge, promoted later by
// mem2reg). shv2 has neither slots nor mem2reg, so it threads each arm's value to the merge as a
// BLOCK-ARG — exactly as `if`/`while` thread a `var` across their joins. A port of the slot would
// reintroduce the very machinery the rewrite exists to avoid.
type MatchArmExit
	export var exitBlock as IrBlock
	export var exitVals as ValueIdArray
	export var give as MatchGiveValue
	// The owned-binding move state this arm carries into the merge — the twin of `exitVals` for the
	// drop-gating bit, reconciled across the reaching arms so a value moved in one arm but left live in
	// another is dropped on the live arms' edges (`finalizeMatchMerge` → `reconcileMovesAtMerge`).
	export var moveMark as MoveMark

	export static function create(exitBlock IrBlock, exitVals ValueIdArray, give MatchGiveValue, moveMark MoveMark) returns MatchArmExit
		return Self{exitBlock: exitBlock, exitVals: exitVals, give: give, moveMark: moveMark}
	end 'create'
end 'MatchArmExit'

typealias MatchArmExitArray = Array with MatchArmExit

// ⭐ **WHICH VALUE-MERGE CONSTRUCT `finalizeMatchMerge` is finishing (P1.5 #80).** The three share ONE
// merge — the phi, the give-agreement rules, the ownership normalisation — but they must NOT share their
// DIAGNOSTIC NOUN: a `match` reports "match arms give incompatible types" (E3005) naming the offending
// arm, while a ternary reports "ternary expression type mismatch" (E2028) naming the TRUE and FALSE
// branches by position. `isExpression` alone cannot tell a match EXPRESSION from a ternary — both give a
// value — so the construct rides explicitly. `matchStatement`'s presence is what lets `isExpression` be
// DERIVED here (`!= matchStatement`) rather than passed alongside, so the two can never disagree.
enum MergeConstruct
	matchStatement
	matchExpression
	ternary
end 'MergeConstruct'

// ⭐ **THE ONE CONSTRUCT→DIAGNOSTIC MAPPING for a value-merge type mismatch (P1.5 #80).** A ternary and a
// match share the merge but not the diagnostic noun: a ternary names its TRUE and FALSE branches by
// position (E2028), a match names the offending arm against the first (E3005). BOTH sides of the
// parse/merge boundary route through here — the parse-time give-type/promotion checks
// (`Parser.valueMergeGiveMismatch`) AND the whole-program fn-signature drain
// (`Queries.checkOneValueMergeSignature`) — so the noun is decided in exactly ONE place. Nothing else
// makes those two sites agree (one keys on `MergeConstruct`, the other on a stored `isTernary` bit, and
// they sit in different files), so a future change to the mapping that touched only one would silently
// diverge the two constructs' diagnostics; keeping it here is what forecloses that. `expectedDisplay` is
// the FIRST branch's already-formatted type, `gotDisplay` the mismatching one.
// ⭐ **THE ONE E2013 "you may not write this name" DIAGNOSTIC**, built from the token that names the
// target. THREE statements raise it and they know three different things — a local binding declared `let`
// (`requireMutableBinding`), a top-level binding that has a slot and still refuses the write
// (`storeToGlobal`, P1.7 slice 2b), and a name that resolved to an INLINED top-level constant
// (`rejectNonGlobalAssignment`) — but they are one RULE stated once, and nothing else makes the three agree
// on the payload or the anchor. A fourth site, or a future change to what E2013 says, has one place to go.
//
// It takes the TOKEN, not a name and a position: the three sites all anchor on the token that spells the
// target, and passing the pieces separately is what lets one of them anchor somewhere else by accident.
function assignToImmutableError(nameTok Token) returns ParseError
	return ParseError.assignToImmutable(String.from(nameTok.value), line: nameTok.line, column: nameTok.column)
end 'assignToImmutableError'

export function valueMergeMismatchError(isTernary bool, expectedDisplay String, gotDisplay String, line LineNumber, column ColumnNumber) returns ParseError
	if isTernary 'ternary'
		return ParseError.ternaryValueTypeMismatch(expectedDisplay, falseType: gotDisplay, line: line, column: column)
	end 'ternary'
	return ParseError.giveTypeMismatch(gotDisplay, expected: expectedDisplay, line: line, column: column)
end 'valueMergeMismatchError'

// How control left one arm's body, plus the exit snapshot the merge (or the next arm's
// fallthrough phi) needs. `fellThrough` and `reachesMerge` are mutually exclusive with each
// other and with a terminated exit: an arm either flows to the next arm's body (`and
// fallthrough`), reaches the merge, or returns/breaks — exactly one.
type MatchArmBody
	export var fellThrough as bool
	export var reachesMerge as bool
	export var exitBlock as IrBlock
	export var exitVals as ValueIdArray
	export var give as MatchGiveValue

	export static function create(fellThrough bool, reachesMerge bool, exitBlock IrBlock, exitVals ValueIdArray, give MatchGiveValue) returns MatchArmBody
		return Self{fellThrough: fellThrough, reachesMerge: reachesMerge, exitBlock: exitBlock, exitVals: exitVals, give: give}
	end 'create'
end 'MatchArmBody'

// What a parsed match leaves behind: the continuation block control resumes in (`cont`, which
// becomes `currentBlock`), and the value it produced — `none` for a statement match, `value(phi)`
// for an expression match. Both entry points read `cont`; only the expression entry reads `result`.
type MatchOutcome
	export var cont as IrBlock
	export var result as MatchGiveValue

	export static function create(cont IrBlock, result MatchGiveValue) returns MatchOutcome
		return Self{cont: cont, result: result}
	end 'create'
end 'MatchOutcome'

// One resolved payload binding of a `walk(dir)` arm (P1.3 slice 1): the binding NAME token (`dir`),
// the case FIELD it reads (its declared name + type), the SLOT it occupies, and whether it is the
// discard `_` (which binds nothing). Resolved at pattern-parse time — where the case index and its
// layout are in hand — and consumed by the arm body, which loads each slot out of the scrutinee box.
type PayloadBinding
	export let nameTok as Token
	export let field as PayloadField
	export let slot as CaseIndex
	export let isDiscard as bool

	export static function bound(nameTok Token, field PayloadField, slot CaseIndex) returns PayloadBinding
		return Self{nameTok: nameTok, field: field, slot: slot, isDiscard: false}
	end 'bound'

	export static function discard(nameTok Token, field PayloadField, slot CaseIndex) returns PayloadBinding
		return Self{nameTok: nameTok, field: field, slot: slot, isDiscard: true}
	end 'discard'
end 'PayloadBinding'

typealias PayloadBindingArray = Array with PayloadBinding

// A pattern arm's parse result: the boolean CONDITION (`subject == tag`, or the OR/range fold) and
// the payload BINDINGS the arm body declares. A scalar match, and every enum pattern that is not a
// single case (an or-chain, a range), carries no bindings.
// ⭐ **THE STRATEGY THRESHOLD — below this many disjoint intervals a `match` dispatches by a linear
// compare chain, at or above it by a balanced binary search.** Three intervals is at most three
// compare-and-branch pairs, cheaper than the compare-per-level a search spends before it reaches a
// leaf; past that the search's logarithmic depth wins. The value is the bootstrap's
// `MinIntervalsForDispatch` (`MaxonToStandardConversion.SwitchDispatch.cs`), shared deliberately so the
// two compilers pick the same strategy for the same match. (The bootstrap's jump-TABLE tier — a fourth
// strategy above a density threshold — is Slice 2 here: it needs an `.rdata` table and an indirect
// jump, neither of which this rung emits.)
let MinIntervalsForDispatch = 4 as ElementCount

// ⭐ **THE DENSE-TABLE DENSITY HEURISTIC — the three caps that decide a jump TABLE is worth its `.rdata`
// slots over a binary search.** All three are the bootstrap's, shared verbatim so the two compilers pick
// the same strategy for the same match (`MaxonToStandardConversion.SwitchDispatch.cs`).
//
// A table COSTS one i32 slot per value in the covered SPAN (min..max) but BUYS the removal of the whole
// compare tree — so the span, not the arm count, is what has to be capped.
//   • `MaxTableSpanSlots` — 4096 slots (a 16 KiB table) is the widest span admitted. The arm64 bounds
//     check materialises this count into a scratch register precisely because 4096 does not fit the CMP
//     imm12 field (`Arm64Backend.emitArm64JumpTable`).
//   • `MaxTableSlotsPerInterval` — density alone cannot judge a table: four arms 30 apart are 88% dense
//     inside the span cap yet trade 128 mostly-identical slots for the three compares a search removes. A
//     slot budget PER interval removed keeps the table proportional to what it actually buys.
//   • `MinTableDensity{Numerator,Denominator}` — the covered slots must be at least 2/5 (0.4) of the span,
//     or the search — whose cost follows the interval COUNT, not the span — wins.
let MaxTableSpanSlots = 4096 as ParsedInt
let MaxTableSlotsPerInterval = 32 as ParsedInt
let MinTableDensityNumerator = 2 as ParsedInt
let MinTableDensityDenominator = 5 as ParsedInt

// ⭐ **ONE NORMALIZED DISPATCH KEY — a closed value interval `[lo, hi]` and the arm body it selects.**
// A `match` over an integer-like scrutinee (an enum/union tag, a scalar `int`/`char`/`bool`, a
// ranged-int alias) is lowered by first reducing every arm to a list of these: a single value is
// `[v, v]`, a range is `[lo, hi]`, an `or`-list contributes one interval per alternative, and an open
// bound is `i64.min`/`i64.max`. `targetBlockId` is the arm body the interval selects; `edgeArgs` are the
// carried-variable phi arguments the dispatch's test→body edge passes (empty when the body has no phis).
// `normalizeDispatchIntervals` sorts these and clips overlaps so earlier arms win, and the strategy
// chooser (`emitDispatchRange`) reads nothing else — so the shape of a `match` is written down ONCE
// (this list) rather than recognised back out of an already-emitted compare chain, which is the seam the
// bootstrap's own `DispatchEmitter` header calls out as the bug this design removes.
type DispatchInterval
	export var lo as ParsedInt
	export var hi as ParsedInt
	export var targetBlockId as BlockId
	// Mutable because the arm loop knows an interval's body before it knows the carried-var phi args
	// that ride the edge into it: the intervals are collected as the pattern is parsed, then the whole
	// arm's edge args are stamped across them once `setupFallthroughTargetPhis`/`restoreBindings` has run.
	export var edgeArgs as ValueIdArray

	export static function create(lo ParsedInt, hi ParsedInt, targetBlockId BlockId, edgeArgs ValueIdArray) returns DispatchInterval
		return Self{lo: lo, hi: hi, targetBlockId: targetBlockId, edgeArgs: edgeArgs}
	end 'create'
end 'DispatchInterval'

typealias DispatchIntervalArray = Array with DispatchInterval

// The verdict of the density heuristic over `intervals[from, to)`: whether a jump table is worth it, and if
// so its `bias` (the minimum lo — subtract it and slot `i` is biased value `i`) and its `span` (the slot
// count, min..max inclusive). `isTable` false leaves the other two unread. Top-level (not nested in
// `Parser`), like `DispatchInterval` — the density planner returns it out of the parser's dispatch methods.
type DispatchTablePlan
	export var isTable as bool
	export var bias as ParsedInt
	export var span as ParsedInt

	export static function notTable() returns DispatchTablePlan
		return Self{isTable: false, bias: 0, span: 0}
	end 'notTable'

	export static function tableWith(bias ParsedInt, span ParsedInt) returns DispatchTablePlan
		return Self{isTable: true, bias: bias, span: span}
	end 'tableWith'
end 'DispatchTablePlan'

// A permutation of `raw` interval positions — the sort order and the min-heap `normalizeDispatchIntervals`
// sweeps with. An entry is an index into the arm-order `raw` array, and because the raw array is built in
// arm order that index IS the arm PRIORITY (lower = earlier arm = wins an overlap), so the heap orders by
// the stored value directly.
typealias DispatchIndexArray = Array with ElementCount

// The single-value patterns a `match` has already seen, for the duplicate-pattern check (E2027). A hash
// set, not a list: the check tests membership once per point arm, so a list makes a match of K distinct
// point arms — a keyword or bytecode dispatch table, the shape a big `match` IS — Θ(K²). Membership is the
// only thing asked of it (add, and "have I seen this?"), which is exactly a set's contract.
typealias SeenPatternValues = Set with ParsedInt

export type Parser
	var tokens as TokenArray
	var pos as TokenIndex
	var filePath as FilePath
	var namespace as String
	// The sole output. Every emit/registry write lands here, never on `Project`.
	var artifact as FileParseArtifact
	// Per-function symbol table (empty at M1 — no locals). Reset per function.
	var scope as Scope
	// ⭐ **THE E3070 SUBJECT STAND-IN FOR EVERY TOP-LEVEL `var` THIS FILE NAMES** (`VarInfo.
	// createModuleStorageSubject`). FILE-scoped and never reset, deliberately: a global's storage is the
	// same storage in every function of the file, and per-function `BorrowFacts` key on the stand-in's
	// IDENTITY, so one object per name is exactly what makes `g.get(0)` in one statement and `g.clear()` in
	// the next the same subject. Points at `sharedEmptyTopLevelBorrowSubjects` until the first mint.
	var topLevelBorrowSubjects as VarInfoMap
	// Per-function ValueId allocator for the values this function's ops define.
	// Re-seeded at `paramCount` per function (params implicitly own 0..paramCount-1
	// by Std-ABI convention), so ids are dense and function-local. The parser is
	// where value numbering is BORN — see MaxonDialect's MaxonOp header.
	var valueIds as ValueIdRef
	// The `var` bindings currently IN SCOPE, in declaration order (M4b) — held as the
	// `VarInfo` objects, for the reason LoopPhiVar documents. A loop header mints a phi for
	// the SUBSET of these its body assigns, in this list's order, so that block-args and
	// every predecessor's BranchEdge argIds stay positionally aligned with each other.
	// `let` bindings never appear (they cannot be reassigned, so they carry no
	// loop-carried phi). A block's `var`s are drained off the end of this list at the
	// block's `end` (see closeBlock). Reset per function.
	//
	// An `if`'s merge works the same way (`assignedBindingsIn`): its snapshots are positional
	// over the SUBSET of this list its branches assign, in this list's order, and it mints a
	// phi only where the two paths differ.
	var mutableVars as VarInfoArray
	// The enclosing loops, innermost last (M4b). `break`/`continue` resolve their
	// target here; a `while` pushes on entry and pops after its body. Reset per
	// function (a stray entry across functions would be a parser bug).
	var loops as LoopContextArray
	// ⭐⭐ **THE BINDINGS AN ENCLOSING `for … in` IS CURRENTLY ITERATING THROUGH** — innermost last, pushed
	// by `lockIterationSource` around each `for` body and popped after it. THE ONE FACT behind the borrow's
	// safety obligation, and the reason it is a list on the parser rather than a flag flipped on the binding:
	// FIVE different write doors have to refuse, and only a single shared fact keeps them from drifting (see
	// `bindingIsIterationLocked` for the five, and for what each one would let through on its own).
	//
	// It holds the binding a write must go THROUGH, which for a field-chain source (`for it in b.items`) is
	// the chain's BASE (`b`) rather than the array itself — a re-read of `b.items` in the body mints a fresh
	// ValueId for the same record, so nothing about the array's own VALUE can identify it. `self.items`
	// resolves to the FIELD's alias rather than to the receiver, so the storage has ONE key however the
	// source and the write spelled it (`iterationSubjectNameAt`, which is where that was measured).
	//
	// Membership is by OBJECT IDENTITY for a local (`VarInfo` is a heap `type`), so a body that SHADOWS the
	// source's name declares a different record and is correctly not locked — and by LAYOUT INDEX for a
	// field of the enclosing `self`, whose store door holds an index and no binding.
	var iterationLockedBindings as VarInfoArray
	// The token index of the `end` most recently consumed by `parseBlockBody`. It exists for
	// the drift guard `assertScanAligned`, which both `parseWhileStatement` and `parseIfStatement`
	// run to check the `end` the parser really closed the last body with against the one
	// `blockStatementEndIndex` predicted from the tokens. A nested block
	// finishes — and writes this — before its enclosing one does, so by the time an outer
	// `parseBlockBody` call returns it holds the OWN `end` of the construct's last body, which
	// is what the guard reads.
	var lastBlockBodyEnd as TokenIndex
	// ⭐ **THE FILE'S BLOCK-EXTENT INDEX: per token, the `end` that closes the block opened there.** Filled
	// in ONE bracket-matching pass by `buildBlockExtentIndex` on the first construct that asks, and read by
	// `matchingEndOf` so `blockStatementEndIndex` can step OVER a nested construct instead of through it.
	//
	// FILE-scoped, not per function, and correct because it is keyed by an ABSOLUTE token index: a construct
	// only ever asks about a token inside its own extent, so an entry belonging to another function can never
	// be reached. That is also why `reset` (per function) leaves it alone — the tokens it indexes do not
	// change for the parser's whole life, and a Parser is built per file and never re-aimed at a second token
	// stream.
	//
	// It points at the shared empty until the first query, and that `is`-identity is what says "not built
	// yet": a file that opens no block at all still gets a FRESH column, so an empty index and an absent one
	// are never confused.
	var blockExtentEnds as TokenIndexColumn
	// THE BLOCK EXPRESSION PARSING IS EMITTING INTO, and it MOVES. Until P1.0d.2 an
	// expression always ended in the block it started in, so "where do ops go" could be a
	// parameter threaded down from the statement. A short-circuit `and`/`or` ends that: it
	// leaves control in a fresh MERGE block, and everything after it — the rest of the
	// expression, the statement's own terminator, every statement that follows — must land
	// there. A parameter cannot express that (a function returns one value, and the
	// expression parser's is the ValueId), so the exit block is published here.
	//
	// This is `maxon-selfhosted`'s `currentBlock`, and it exists there for the same reason
	// (its `parseExpressionBP` does `blk = currentBlock` after every recursive call).
	//
	// Seeded with a DETACHED placeholder: a Parser exists before any function does, so
	// there is no entry block to point at yet. `parseFunction` overwrites it with the real
	// entry before a single op is emitted, and every op the parser emits is emitted from
	// inside a function body — so the placeholder is provably never written to. (The
	// alternative, an optional-block union, would put a `match` at every emit site to
	// handle a case that cannot occur.)
	var currentBlock as IrBlock
	// The source-level type of every SSA value this function's ops define, DENSE by ValueId
	// and split into its two halves: the TAG (the discriminant) and, for a `named` type, the
	// interned name id. The type oracle the context-dependent operators consult:
	// `and`/`or`/`xor` and `not` mean one thing on `bool` and another on `int`, and — because
	// a bool `and`/`or` is CONTROL FLOW, which no later pass can retrofit — the parser is the
	// tier that must know.
	//
	// TWO SCALAR COLUMNS, not an `Array with MaxonType`: a Maxon union value is a heap
	// object, so a `MaxonType` column would put an allocation on every SSA value in the
	// program, and the type RULES that read it would put another on every operator. See
	// MaxonDialect's `ValueTypeTag` for the measurement that settled it.
	//
	// Seeded with the parameter types (which own ids 0..paramCount-1) and appended in
	// lockstep with `valueIds` by `mintValue`. Re-CREATED per function (never cleared) —
	// which is what makes the next line safe:
	//
	// **`valueTags` IS THE FUNCTION'S OWN COLUMN, SHARED BY REFERENCE.** `parseFunction` hands
	// this very array to `IrFunction.create`, so every `mintValue` during the body parse pushes
	// straight into `func.valueTags`. That is not an optimization detail to be tidied away: the
	// column has a SECOND reader (SemanticCheck, for the one type rule that needs a callee's
	// signature and so cannot live here — see IrFunction.valueTags), and copying it out at the
	// end of each body would allocate a dead array per function for nothing.
	//
	// `valueNameIds` — the parallel interned-NAME column — is handed to `IrFunction.create` BY
	// REFERENCE alongside `valueTags`, for the one downstream reader that needs an aggregate's NAME
	// and not just its class: SemanticCheck's call-argument identity check (two structs share the
	// `structRef` tag, so telling a `BoxA` argument from a `BoxB` one needs the name — OPEN #54
	// Slice B). See IrFunction.valueNameIds.
	var valueTags as ValueTypeTagArray
	var valueNameIds as TypeNameIdArray
	// THE PARSER'S CONSTANT FOLDER — two more columns in lockstep with `valueTags`, holding the
	// integer behind every SSA value the compiler KNOWS. It exists for the shift rule, which is
	// the one rule in the language that must ask "what IS this operand?" rather than "what TYPE is
	// it?" (TypeRules' ⭐ THE SHIFT RULE): a negative count is E2054, and a count of 64-or-more
	// names a different shift than the hardware would perform.
	//
	// Filled forward, at the three places an integer value is born — `emitLiteral` (so a count
	// named through a `let` is a count this column holds: `let SHIFT = -1` binds the name to the
	// literal's own ValueId), `emitUnaryOp` (`-1` is `neg` of a literal, not a negative literal),
	// and `emitBinOp` (so `x shl 63 + 1` is a count of 64).
	//
	// Two scalar columns rather than one column of a union, for the reason `valueTags` gives: a
	// Maxon union value is a heap object, and this is the per-VALUE path. Re-created per function,
	// so the cost is bounded by the largest function and not by the module.
	//
	// ⚠ Its REACH is a matter of diagnostic quality, never of correctness. A count it misses is a
	// count `emitGuardedShift` saturates at run time, to exactly the same answer — which is what
	// lets the fold be an optimization rather than a second opinion.
	var valueConsts as ParsedIntArray
	var valueConstKnown as BoolArray
	// ⭐ **THE OWNED-HEAP PROVENANCE — the SSA values that are FRESH owned heap allocations this function
	// must drop.** Today, the interpolation RESULTS (`emitStringInterp`). It exists because ownership CANNOT
	// be read off the type tag: an owned interpolation String and a borrowed-immortal rdata literal String
	// share `ValueTypeTag.string`, so keying a drop on the tag would either decref an immortal literal (a
	// wrong decref of unowned `.rdata`) or leak an interpolation result. This is the provenance the tag
	// cannot carry — recorded by the ONE expression that allocates a String, never by the literal path —
	// read by `parseBinding` (does this binding OWN a drop?) and structurally by the statement-scoped
	// temp-drop. Structs need no entry: every struct is heap, so `tagIsStructRef` already answers for them;
	// this is only the String owned/borrowed split the tag conflates.
	//
	// A PER-VALUE bool column, indexed by ValueId in lockstep with `valueTags`/`valueConstKnown` (pushed
	// `false` in `mintValue`/`recordValueType`, set `true` in `trackOwnedTemp`, read by `valueIsOwnedHeap`).
	// It is a set-MEMBERSHIP fact and nothing more — never iterated, order-independent — so the O(1) column
	// read is the right shape and the earlier sparse list was not: that list was scanned once per binding
	// and grew by one per interpolation, never pruned within a function, so a function with N bound
	// interpolations paid Σk = O(N²) — a `findFirst`-in-a-loop quadratic in one function's size. The column
	// makes each query O(1); its one added bool per value is strictly linear and dwarfed by the four sibling
	// columns already carried per value. Reset per function.
	var valueOwnsHeap as BoolArray
	// ⭐ **THE PROMISE MARK (P1.5-B1a)** — true iff value `v` is an `async` spawn's handle. A per-value bool
	// column in the SAME lockstep as `valueOwnsHeap` (pushed `false` in `mintValue`/`recordValueType`, set by
	// `markValuePromise` on the one value `emitAsyncCall` mints, read by `valueIsPromise`). The handle's TAG
	// already carries its awaited scalar type (int/bool — a managed/float result is rejected before the handle
	// is minted), so `await` reads the result type off `tagOf` and this bit only distinguishes an awaitable
	// handle from a bare int of the same tag. Reset per function and SWAPPED across a closure body's context.
	//
	// ⚠ A DENSE COLUMN, not a sparse Set, EVEN THOUGH a promise is RARE — measured, not assumed: a per-function
	// empty Set's initial hash table costs about as much as the dense bit does across the whole corpus (a sparse
	// Set MEASURED +7,364 allocs / +292K bytes WORSE at scale-rung5), because both allocate one object per
	// function and most functions are small. So the column is simpler (mirrors `valueOwnsHeap`), marginally
	// cheaper, and honest — the sparse-is-cheaper premise did not survive the instrument.
	var valuePromiseMarks as BoolArray
	// ⭐ **THE CAPTURING-CLOSURE MARK AND ITS ENVIRONMENT (P1.5-A2b), carried ON THE VALUE — not in a
	// mutable sidetable.** Two per-value columns in the same lockstep as `valueOwnsHeap`/`valueConstKnown`:
	// `valueIsCapturingClosure[v]` is true iff value `v` is a closure that CAPTURES; `valueClosureEnv[v]` is
	// then its heap environment block's ValueId (meaningless when the flag is false). A non-capturing closure
	// and every other value carry `false`, so the mark keys on the VALUE and cannot leak to an unrelated
	// binding of the same NAME in another function (`capturing-closure-name-not-leaked`). This is shv2's
	// replacement for v1's `fnEnvVarNames` (a `ValueId→ValueId` map mutated during LOWERING, its documented
	// bug source): the env is minted at PARSE time and rides the value directly, so an in-frame call reads
	// `valueClosureEnv` to decide whether to pass an env, and the escape checks read `valueIsCapturingClosure`
	// to decide whether a store is refused — both at parse time, both keyed on the value. Reset per function
	// and SWAPPED across a closure body's context (a closure's value ids are its own SSA space), exactly like
	// the sibling value columns.
	var valueIsCapturingClosure as BoolArray
	var valueClosureEnv as ValueIdArray
	// ⭐ **THE PER-INSTANCE ALIAS PROVENANCE OF EACH GENERIC-INSTANCE VALUE (P1.6-C)** — see
	// `ValueInstanceAliasMap`. Reset per function and SWAPPED across a closure body (its value ids are a
	// fresh SSA space), exactly like the sibling value columns. A Map rather than a dense column because only
	// the few generic-instance values a program constructs ever get an entry.
	var valueInstanceAlias as ValueInstanceAliasMap
	// ⭐⭐ **WHICH VALUES WERE READ OUT OF AN IMMUTABLE TOP-LEVEL GLOBAL (P1.7 slice 2b)** — the fact that
	// stops a `let`-declared array's record from being written through a mutable ALIAS.
	//
	// A top-level array binding is a heap record with a `.data` slot whichever keyword declared it, and a
	// `let` refuses the direct write (E2013 at an assignment, E3019 at a receiver-writing method). But a
	// borrowed managed AGGREGATE bound to a `var` is promoted to owned by an INCREF of the SAME box
	// (`retainBorrowedAggregate` — reference semantics, deliberately: the alias is observable), so `var b = A`
	// followed by `b.push(9)` would write the immutable global's record with every direct guard intact. That
	// is a silent wrong answer, not a crash — MEASURED at 3 where 2 is correct — and it is reachable only
	// because this slice gave an IMMUTABLE binding a shared mutable record for the first time (a `let`
	// String's read is COPIED on promotion, and a `let` byte string re-materializes a fresh record per read).
	//
	// ⚠ **THE MARK KEYS ON THE VALUE, and that is the point.** The alternative — testing the initializer's
	// TOKENS for a bare name and re-resolving it — would be a FOURTH encoding of the local→capture→top-level
	// resolution order, which this file already carries three copies of and has already been bitten by
	// (slice 2a's receiver read the capture and the global for one name in one expression). A value carries
	// where it came from with no order to re-derive and no shadow to mistake.
	//
	// A SPARSE set, not a dense per-value column like `valueOwnsHeap`: the population is the immutable-global
	// reads of ONE function, which is zero in every program that declares no array `let`. Reset per function
	// and SWAPPED across a closure body, exactly like the sibling value columns — a closure's value ids are
	// its own SSA space, so a mark that leaked across would name an unrelated value.
	//
	// ⚠ **A SET RATHER THAN A LIST, BECAUSE BOTH ENDS GROW WITH THE FUNCTION.** The first cut scanned a
	// `ValueIdArray` at the one promotion gate, which is O(1) only if one of the two populations is bounded —
	// and neither is: the marks are this function's immutable-global reads and the scans are its borrowed
	// managed-aggregate promotions, so a single function carrying K of each pays Theta(K^2). MEASURED on a
	// ladder of K interleaved `g(A)` reads and `b = s` promotions, against the identical program with `A`
	// declared `var` (which marks nothing, so the two differ in exactly this structure): the scan's own cost
	// was 3.5 / 15.6 / 65.2 / 259.6 ms at K = 2,000 / 4,000 / 8,000 / 16,000 — x4.41, x4.19, x3.98 per
	// doubling, a textbook quadratic — and 39% of `phase:parse` at the top rung, while the `var` control
	// stayed flat at x1.99. It allocates almost nothing (the list's own geometric growth, +21 allocations at
	// K = 16,000), so `scale-test` is structurally blind to it and it had to be found by reading.
	var immutableGlobalReads as ImmutableGlobalReadSet
	// ⭐ **THE NAME AN E3019 WOULD BLAME FOR THE BARE IDENTIFIER `parseVariableReference` LAST RESOLVED**,
	// empty when that binding may be written through. A scalar hand-off from the ONE resolution that can
	// answer it to the ONE consumer that needs it (`bareArgImmutableName`, at a call argument), because a
	// `ValueId` cannot carry the answer: `let a = p` binds `a` to the parameter `p`'s own value, so the
	// question is about the NAME and dies with the token unless it is published here.
	//
	// ⚠ **ITS SCOPE IS EXACTLY ONE ARGUMENT.** `parseCallArgs` clears it before each argument and reads it
	// after, and only when the argument consumed exactly one identifier token — so a stale answer cannot
	// blame the wrong argument, and a primary path that publishes nothing answers "writable", which is the
	// safe direction (a missed diagnostic, never a refused program).
	var lastBareBindingImmutableName as ByteArray
	// ⭐ **THE CAPTURE SET OF THE CLOSURE CURRENTLY BEING PARSED (P1.5-A2b).** Populated by `captureEnclosing`
	// as the body reads enclosing names (first-seen order = env slot order), read by `parseClosureExpression`
	// after the body parse to build the env block (one `storeIndirect` per capture, by VALUE). SWAPPED across
	// a nested closure body so each closure collects its own. `closureEnvParamId` is the ValueId reserved for
	// the lifted body's trailing `__env` parameter — the address every capture read loads through
	// (`loadIndirect(closureEnvParamId, slot*8)`). It is set at the start of every closure body parse and
	// read only while `closureCaptureScopes` is non-empty, so its value outside a closure body (0) is a
	// never-read placeholder, not a sentinel any code compares against.
	var captureNames as ByteArrayArray
	var captureValues as ValueIdArray
	var captureTypes as MaxonTypeArray
	var closureEnvParamId as ValueId
	// ⭐ **THE RANGE-CHECK SITES OF THE FUNCTION CURRENTLY BEING PARSED (P1.9).** Two accumulators
	// plus the function's return-alias name: every `as` cast into a ranged alias appends to
	// `rangeCheckCastSites`; every `return <expr>` in a ranged-int-alias-returning function appends to
	// `rangeCheckReturnSites`; `rangeCheckReturnAlias` is that alias's name (EMPTY when the return type
	// is not a ranged int alias, which is what gates the return recording). All three are RESET at the
	// top of `parseFunction` and COMMITTED to the artifact at its end (`recordFunctionRangeChecks`),
	// keyed by the function's name — the `InsertRangeChecks` Std pass reads them back by name.
	//
	// ⚠ They are NOT swapped across a nested closure body the way the per-value columns are (that path
	// is P1.5-owned and this rung does not touch it), so a ranged `as` cast written INSIDE a closure
	// would be filed against its enclosing function. No P1.9 or pre-existing case casts inside a
	// closure, so the mis-attribution is unreachable today; when closures grow ranged casts, this
	// wants the same save/restore `parseClosureExpression` already does for `valueTags`.
	var rangeCheckCastSites as RangeCheckCastSiteArray
	var rangeCheckReturnSites as RangeCheckReturnSiteArray
	var rangeCheckReturnAlias as ByteArray
	// Every function declared ANYWHERE IN THE PROGRAM, with its return type — the whole-program
	// signature index (SignatureIndex.maxon), built from every file's TOKENS before any file is
	// parsed and handed to every Parser.
	//
	// A call's result type has to be exact HERE, and it cannot wait: `f() and g()` short-circuits
	// iff `f`'s return type is statically `bool` — a CONTROL-FLOW decision no later pass can
	// retrofit — and `not` picks its opcode from its operand's type. A file-local scan made that
	// exact within one file (so declaration ORDER stops deciding what a program means), and left it
	// WRONG across files: a callee the file could not see was typed `unresolved`, which agrees with
	// everything, so `let x = isReady()` + `x + 41` compiled and returned 42. The index is the same
	// sweep, over every file.
	var signatures as ProgramSignatures
	// ⭐ THE TYPE whose body is being read — EMPTY at file scope. It is the parser's whole knowledge
	// of "am I inside a `type`?", and three things read it:
	//
	//   • `declaredMethodName` — a `function create` inside `type Point` is declared `Point.create`;
	//   • `parseTypeReference` — `Self` (and `Point`) in a type position inside `type Point` is a
	//     `structRef` to it;
	//   • `requireConstructible` — `Self{…}` is legal HERE and nowhere else (E3076).
	//
	// ⭐ **THE TOKEN SWEEP SETS IT TOO, AND THAT IS WHAT KEEPS THE TWO PASSES HONEST.** The first two
	// readers above run in BOTH the tolerant declaration sweep (`recordScannedType`) and the real
	// parse (`parseTypeDeclaration`), and they must not disagree: had the sweep recorded a factory as
	// `create` while the parse declared it `Point.create`, every call would be E3004 against a name
	// nothing declared. The mapping is purely SYNTACTIC — it needs the enclosing declaration and no
	// registry — which is exactly why both passes can make it, and why `Self` need not wait for the
	// index to be complete (mid-sweep, it is not).
	//
	// Empty is not a sentinel: a type's name cannot be empty, and "no enclosing type" is the literal
	// truth at file scope. It is NOT reset per function — a method's parse runs INSIDE the type body
	// that set it (`parseTypeDeclaration` is the one writer, and clears it at the type's `end`).
	var enclosingType as ByteArray
	// The GENERIC TYPE PARAMETERS of the type currently being declared (P1.6-A) — `[T]` while parsing
	// `type Box uses T`, empty otherwise. It is how `parseTypeReference` recognizes a bare `T` as a
	// type parameter (by NAME, so the sweep and the real parse agree without a registry) and mints
	// `typeParameter(POSITION)` — the position is the name's index in this list. Written and cleared in
	// lockstep with `enclosingType` (`parseTypeDeclaration`/`recordScannedType` are the writers).
	var enclosingTypeParams as ByteArrayArray
	// The `where T is <Interface> …` CONSTRAINTS of the type currently being declared (P1.7a slice 2a) —
	// in source order (the witness-slot order), empty otherwise. It is how the body parse recognizes
	// `self.item.digest()` as a witness DISPATCH (the receiver's type parameter has a constraint whose
	// interface declares `digest`) and how `parseFunction` decides an instance method needs witness
	// parameters. Written and cleared in lockstep with `enclosingTypeParams` (`parseTypeDeclaration`/
	// `recordScannedType` are the writers); points at `sharedEmptyWhereConstraints` for an unconstrained
	// type, so a non-generic (or unconstrained-generic) type declaration allocates nothing here.
	var enclosingWhereConstraints as WhereConstraintArray
	// ⭐ **THE PARSE-TIME FACTS OF THE MOST RECENTLY EMITTED `witnessDispatch` (P1.7a slice 2b-v)** — its op
	// INDEX, the interface method's NAME, and the method's declared `throws`. A `try` is written BEFORE its
	// target, so the only thing that can turn a dispatch into a throwing one is the in-place rewrite
	// `rewriteLastCallToTryCall` performs afterwards (the same rewrite `call` -> `tryCall` uses) — and that
	// rewrite holds only an op index. The name and the throws clause are facts of the CONSTRAINT RESOLUTION,
	// which nothing but the parser has, so they are recorded here as the dispatch emits rather than made into
	// op fields every dispatch would carry to answer a question only a `try` asks.
	//
	// ⚠ The record is matched to the op by INDEX, not trusted by position: `commitWitnessTryDispatchRewrite`
	// panics unless `lastWitnessDispatchIndex` IS the op it is rewriting. It always is — a dispatch records at
	// the instant it emits, and the rewrite runs on the op in the last opRef slot — but a future emit path that
	// forgot to record would otherwise mis-type an `(e)` binding silently.
	var lastWitnessDispatchIndex as OpIndex
	var lastWitnessDispatchName as ByteArray
	var lastWitnessDispatchThrows as ThrowsClause
	// ⭐ The BARE MEMBER NAMES of the INNER ranged typealiases declared in the type currently being parsed
	// (P1.6-C) — `{Idx}` inside `type Wrapper` with `typealias Idx = int(0 to u64.max)`, empty otherwise. It
	// is how `parseTypeReference` resolves a bare `Idx` in a field/return/parameter position to the
	// base-qualified `named("Wrapper.Idx")` — recognized by NAME against this set, so the SWEEP and the real
	// parse agree WITHOUT the whole-program `innerAliases` (which the sweep has not folded yet while it is
	// still walking this very type). Written by the `typealias` member arm and cleared in lockstep with
	// `enclosingType` (`parseTypeDeclaration`/`recordScannedType` are the writers).
	var enclosingInnerAliases as InnerAliasNameSet
	// ⭐ **WHICH METHODS OF THE GENERIC TYPE CURRENTLY BEING DECLARED NEED THE LAYOUT-DESCRIPTOR PARAM**
	// (P1.6-B1), keyed by bare method name. Computed ONCE by `computeTypeDescriptorNeeds` when the type
	// declaration opens — a TRANSITIVE fixpoint over the type's own methods: a method needs the descriptor
	// if it directly reads `sizeof(T)` OR calls (on `self`) a sibling method that needs one. `parseFunction`
	// reads it to reserve the descriptor param BEFORE numbering the method's body values (the slot must be a
	// real parameter in `[0, paramCount)` for the backend's clobber guard). The self-call graph is LOCAL to
	// one type declaration (a method self-calls only siblings, same file, contiguous), so no whole-program
	// index is needed. Empty for a non-generic type.
	var typeDescriptorNeeds as DescriptorNeedMap
	// ⭐ **THE ENCLOSING TYPE'S MEMBER METHODS, bare name -> takesReceiver (#65)** — the map that resolves a
	// bare call `foo(…)` inside a method body to the sibling method `foo`, prepending `self` for an instance
	// method and nothing for a `static` one. Built LAZILY (`siblingReceiverMap`) the first time a call inside a
	// type body needs it and memoized on `siblingReceiverScanType`, so a type whose methods make no calls — all
	// of the scale corpus — allocates NOTHING, exactly as `typeDescriptorNeeds` costs a non-generic type nothing.
	// It is the type's WHOLE method set (static and instance), so `contains` answers "is this a sibling?" and the
	// value answers "does it take a receiver?" from one source — no second decider to drift against the qualified
	// name the signature index declares.
	var siblingReceivers as SiblingReceiverMap
	// The type `siblingReceivers` was built for — the memo key. Empty until the first lazy build, and compared
	// against `enclosingType` so a sibling type reuses nothing stale.
	var siblingReceiverScanType as ByteArray
	// The token index at which the enclosing type's body begins (past the header and any `uses` clause) — set by
	// `parseTypeDeclaration`, and where the lazy `siblingReceiverMap` walk starts. The cursor has long since
	// moved on by the time a method body's call needs it, so the start must be remembered rather than re-derived.
	var enclosingTypeBodyStart as TokenIndex
	// A REUSED sink for the REAL parse's generic-instance typealiases (P1.6-A). The whole-program index
	// records every generic alias in the SWEEP (`foldFile`), so the real parse's `readTypeAliasDeclaration`
	// has nowhere to fold one and nothing downstream reads it — but the shared reader records into a
	// `genericOut` regardless. Passing this one reused array (rather than a fresh throwaway per typealias)
	// keeps a ranged alias like `ExitCode` from allocating on the hot real-parse path; only an actual
	// generic-instance typealias — rare, and absent from the scale corpus — ever pushes an entry.
	var genericAliasScratch as GenericAliasEntryArray
	// The SHARED empty type-parameter-POSITION array (P1.6-A/B2) the consume scan passes for every
	// receiver-less function OUTSIDE a generic type — which is all of them on the generics-free corpus. It is
	// never mutated (`paramNamesIn` skips the position work when `collectTypeParamFlags` is false, and
	// `paramIsTypeParamTyped`/`paramTypeParamPositionAt` only read it, OOB-safe), so one allocation per parser
	// serves every non-generic function's consume scan, keeping that hot path allocation-free.
	var emptyTypeParamPositions as TypeParamIdArray
	// The SHARED empty type-parameter-name list (P1.6-A) that `enclosingTypeParams` holds outside a
	// generic type — which is every type on the generics-free corpus. `openTypeParamScope` points at it
	// (rather than allocating an empty `uses` list) for a type with no `uses`, and `closeTypeParamScope`
	// restores it, so a non-generic type declaration allocates nothing here. Never mutated.
	var emptyTypeParams as ByteArrayArray
	// P1.6-C's shared-empty inner-alias / instance-alias placeholders are MODULE-LEVEL globals
	// (`sharedEmptyInnerAliases`, `sharedEmptyInstanceAliasMap`, `sharedEmptyInstanceAliasNames`), not
	// per-parser fields — one allocation for the whole compile, like `sharedEmptyDescriptorNeeds`. The
	// working fields `enclosingInnerAliases` / `valueInstanceAlias` INCREF a global as their initial value.
	// The struct-typed bindings currently IN SCOPE, in declaration order — the values a `return`
	// must DROP (`emitScopeDrops`). Held as the `VarInfo` objects, exactly as `mutableVars` is, and
	// drained off the end at a block's `end` by the same mark (see `closeBlock`). Reset per function.
	//
	// ⚠ **IT IS NOT `Scope.popScope`, AND THAT IS NOT AN OVERSIGHT.** Scope's header argues that a
	// parallel owned-list is state that can drift while `popScope` already resolves every binding a
	// frame tears down — and it is right about a BLOCK. It cannot serve the case this rung has, for
	// two independent reasons:
	//
	//   1. **A `return` TERMINATES ITS BLOCK.** `return p.x + p.y` must read the fields, THEN drop
	//      `p`, then return — so the drop belongs between the value and the terminator, at the
	//      `return` statement. `popScope` runs at a block's `end`, which is after the terminator:
	//      anything it emitted would sit on a path control has already left, and the box would leak.
	//   2. **A FUNCTION-SCOPE BINDING NEVER REACHES `popScope` AT ALL.** `Scope.install` records a
	//      declaration for teardown only while a frame is open (`frameMarks.count() > 0`), and
	//      `parseFunction` opens none — `main`'s `let p` lives for the whole function and is torn
	//      down by `reset`. The hook would not fire for either case this rung exists to turn green.
	//
	// ORDER is the third reason, and `vars` could not give it either: `Scope.allVars` hands back a
	// hash MAP, so draining it would emit the drops in hash order and no golden would reproduce.
	var ownedBindings as VarInfoArray
	// ⭐ **THE OWNED HEAP TEMPORARIES CREATED BY THE STATEMENT BEING PARSED, awaiting their drop.** An
	// UNBOUND owned value — `print("{x}")`, where the interpolation result is consumed by `print` (which
	// BORROWS it) and bound to no name — has, under static single-owner, exactly one possible owner: the
	// STATEMENT that produced it. `emitStringInterp` pushes each result here; `parseStatement` drains it at
	// the statement's end, emitting a `__mm_decref` per entry into `currentBlock` — so the drop lands in the
	// LOOP BODY per iteration (`while … print("{i}") …`), the `if`-branch block, or a short-circuit merge,
	// wherever control is when the statement finishes. This is what makes `print("{x}")` — the dominant
	// interpolation shape — leak-free without binding it to a name.
	//
	// A value that IS bound (`let s = "{x}"`) has its ownership TRANSFERRED to the binding: `parseBinding`
	// removes it from here and adds it to `ownedBindings`, so it drops at SCOPE exit (`emitScopeDrops`), not
	// statement end. Reset per function, like every other per-function column. It holds only owned RESULTS —
	// the interpolation's internal scratch buffers are freed inside `emitStringInterp`, never tracked here.
	var pendingTempDrops as ValueIdArray
	// ⭐ **TRUE WHILE PARSING A `match` ARM's single-statement body (P1.4b).** A match arm body is a single
	// statement, so a `try` used there may take only a single-statement form — the block forms
	// (`try 'label' … end`, `otherwise 'label' … end`, `otherwise (e) 'label' … end`) are rejected as
	// E2049. `parseArmBody` sets it around its `parseStatement` call; `parseTry` reads it to raise the
	// block-form diagnostics at the right position. Saved/restored so nested constructs unwind it.
	var inMatchArmBody as bool
	// ⭐ **THE LAST `named` FIELD READ** (P1.4b wave 2c) — so `throw <boxed-union field>` can MOVE the box out
	// of its container (`emitThrowError` nulls the recorded `(box, offset)`) rather than reject it, the
	// transfer shv2 has no `__mm_incref` to make by sharing. Four SCALAR fields rather than a struct so a
	// field read allocates nothing — a boxed union is thrown as the LAST op before the throw, so recognizing
	// the thrown value by IDENTITY against `lastFieldReadValue` is enough, and an equal value id can only have
	// come from this exact `(box, offset)`. A mismatch (an intervening read, a non-field throw) simply MISSES
	// the move-out and falls to the borrowed-throw reject — never a wrong slot nulled, never a leak. Reset
	// invalid per function (`lastFieldReadValid = false`) so a stale `box` never names a previous function's
	// value; the other three fields are dead while invalid and need no reset.
	var lastFieldReadValid as bool
	var lastFieldReadValue as ValueId
	var lastFieldReadBox as ValueId
	var lastFieldReadOffset as ByteOffset
	// ⭐ **THE RETURN TYPE OF EVERY NON-CAPTURING CLOSURE LIFTED IN THIS FILE (P1.5-A2a), keyed by its
	// synthetic name.** A lifted closure's signature is FILE-LOCAL: it never reaches the whole-program
	// `SignatureIndex` (built from tokens before any body is parsed, and a closure is an EXPRESSION inside a
	// body, not a top-level declaration the token sweep can see). So an indirect call through a closure
	// bound to a local (`let f = function(x) gives x*2; f(8)`) cannot recover its return type the way A1's
	// `functionValueReturnType` recovers a top-level function's — from the index. This map is that recovery:
	// `parseClosureExpression` files each lift's return type under its `$`-suffixed name (unwritable in
	// source, so it can never collide with a real function or alias), and `functionValueReturnType` consults
	// it first. File-scoped, never reset: names are unique per file and a closure value is only ever CALLED
	// within its own defining function (returning one out hands the caller a function-ALIAS-typed value,
	// whose return comes from the alias, not from here).
	var closureReturns as FuncReturnTypeMap
	// ⭐ **THE ENCLOSING-FUNCTION SCOPES A CLOSURE BODY MUST NOT REACH INTO (P1.5-A2a) — the capture
	// detector's input.** Empty outside a closure. `parseClosureExpression` pushes the enclosing `Scope` on
	// entry and pops it on exit, so while a closure body parses this holds the chain of scopes whose
	// bindings would be CAPTURES. `parseVariableReference` checks it before falling through to the top-level
	// registries: a name resolving to one of these scopes (an enclosing local, parameter, or self-field
	// alias) is a capture, refused for A2a and handled for real at A2b. A STACK, not a single scope, so a
	// closure nested inside a closure detects a capture of any enclosing frame, not just its immediate
	// parent — which is what stops an outer local silently resolving to a same-named global.
	var closureCaptureScopes as ScopeArray
	// ⭐ **THE PRE-TERNARY MOVE BASE FOR A CODE PATH WITH NO OWNED BINDINGS (P1.5-A2c).** An inline
	// conditional `<t> if <c> else <f>` parses its TRUE arm before the `if` reveals the form, so the
	// pre-arm move state must be snapshotted at the top of EVERY full expression to rewind the FALSE
	// arm to it (`parseTernaryExpression`). When no owned binding is in scope a ternary arm cannot move
	// one, so the snapshot is this shared empty mark — read-only (`restoreMoveMark`/`reconcileMovesAtMerge`
	// no-op at height 0) and allocated ONCE, so the scale corpus (all scalar, no owned bindings) pays
	// nothing per expression.
	let emptyMoveMark as MoveMark

	export static function create(tokens TokenArray, filePath FilePath, namespace String, signatures ProgramSignatures) returns Parser
		return Self{
			tokens: tokens,
			pos: 0,
			filePath: filePath,
			namespace: namespace,
			artifact: FileParseArtifact.create(filePath),
			scope: Scope.create(),
			topLevelBorrowSubjects: sharedEmptyTopLevelBorrowSubjects,
			valueIds: ValueIdRef.create(0),
			mutableVars: VarInfoArray.create(),
			loops: LoopContextArray.create(),
			iterationLockedBindings: sharedEmptyIterationLocks,
			lastBlockBodyEnd: 0,
			blockExtentEnds: sharedEmptyBlockExtentEnds,
			currentBlock: IrBlock.create(0, label: DetachedBlockLabel),
			valueTags: ValueTypeTagArray.create(),
			valueNameIds: TypeNameIdArray.create(),
			valueConsts: ParsedIntArray.create(),
			valueConstKnown: BoolArray.create(),
			valueOwnsHeap: BoolArray.create(),
			valuePromiseMarks: BoolArray.create(),
			valueIsCapturingClosure: BoolArray.create(),
			valueClosureEnv: ValueIdArray.create(),
			valueInstanceAlias: sharedEmptyInstanceAliasMap,
			immutableGlobalReads: sharedEmptyImmutableGlobalReads,
			lastBareBindingImmutableName: EmptySourceText,
			captureNames: ByteArrayArray.create(),
			captureValues: ValueIdArray.create(),
			captureTypes: MaxonTypeArray.create(),
			closureEnvParamId: 0,
			rangeCheckCastSites: RangeCheckCastSiteArray.create(),
			rangeCheckReturnSites: RangeCheckReturnSiteArray.create(),
			rangeCheckReturnAlias: EmptySourceText,
			signatures: signatures,
			enclosingType: EmptySourceText,
			enclosingTypeParams: ByteArrayArray.create(),
			enclosingWhereConstraints: sharedEmptyWhereConstraints,
			lastWitnessDispatchIndex: 0,
			lastWitnessDispatchName: EmptySourceText,
			lastWitnessDispatchThrows: ThrowsClause.none,
			enclosingInnerAliases: sharedEmptyInnerAliases,
			typeDescriptorNeeds: sharedEmptyDescriptorNeeds,
			siblingReceivers: sharedEmptySiblingReceivers,
			siblingReceiverScanType: EmptySourceText,
			enclosingTypeBodyStart: 0,
			genericAliasScratch: GenericAliasEntryArray.create(),
			emptyTypeParamPositions: TypeParamIdArray.create(),
			emptyTypeParams: ByteArrayArray.create(),
			ownedBindings: VarInfoArray.create(),
			pendingTempDrops: ValueIdArray.create(),
			inMatchArmBody: false,
			lastFieldReadValid: false,
			lastFieldReadValue: 0,
			lastFieldReadBox: 0,
			lastFieldReadOffset: 0,
			closureReturns: FuncReturnTypeMap.create(),
			closureCaptureScopes: ScopeArray.create(),
			emptyMoveMark: MoveMark.create(BoolArray.create(), values: ValueIdArray.create())
		}
	end 'create'

	// Parse the whole file into its artifact. Top-level loop: skip blank lines,
	// dispatch each declaration, stop at EOF.
	export function parseModule() returns FileParseArtifact throws ParseError
		while true 'top'
			self.skipNewlines()
			if self.isEof() 'done'
				break
			end 'done'
			try self.dispatchTopLevel()
		end 'top'
		return self.artifact
	end 'parseModule'

	// ⭐ **WHAT AN ABORTED PARSE STILL KNOWS — and it is exactly ONE thing.** A `ParseError` stops the
	// file mid-way, so its module, its spans and its value origins are half-built and must be thrown
	// away: `queryParseOps` hands back a fresh artifact and the file contributes nothing to the merge.
	//
	// The TYPE NAMES it declared are carried across, and not for symmetry — **because the parse error
	// is so often the collision's own CONSEQUENCE.** A `typealias Box` and a `type Box` in one file
	// make every `as Box` in it resolve to the struct, so the file dies on
	// `E3009: Cannot cast from int to struct` and the duplicate that caused it is never reported at
	// all: the diagnosis is suppressed by its own symptom, which is the exact failure
	// `commitTypeNameDecls` exists to end.
	//
	// It is sound because each entry is a FINISHED record — a name, a kind and a name-token position,
	// pushed by `dispatchTopLevel` only after its declaration parsed. Unlike every other artifact
	// field there is no partial state in the array to salvage, so there is nothing to decide about
	// where the parse stopped. Copied rather than aliased: two artifacts sharing one array is the
	// hazard `IrBlock`'s header states, and this path is cold.
	export function abortedParseArtifact() returns FileParseArtifact
		var salvaged = FileParseArtifact.create(self.filePath)
		for decl in self.artifact.typeNameDecls 'eachDecl'
			salvaged.recordTypeNameDecl(decl)
		end 'eachDecl'

		return salvaged
	end 'abortedParseArtifact'

	// Sweep this file's tokens for every `function <name>(…) [returns <Type>]` it declares, and fold
	// what is found into the whole-program `index`. THE way the signature index is built
	// (`queryProgramSignatures` does this once per file, in source-path order); nothing else calls
	// it, and a Parser used for a sweep parses no body.
	//
	// It records `FuncReturnTypeEntry`s — the SAME record the real parse contributes to the
	// `funcReturnTypes` registry (ParseStaging) — and reads the return type through the SAME
	// `parseOptionalReturnType` the real parse reads it with. That shared routine is what keeps the
	// sweep and the parse from drifting into two opinions of what `returns X` means, which is the
	// standing hazard of having a pre-scan at all.
	//
	// The FOLD happens here, not in the caller, because the ids the sweep interns are file-local —
	// they live in this Parser's own artifact interner, which is private and stays private. Handing
	// the caller the ids without the table they belong to is precisely the mistake this whole index
	// is built to avoid (see SignatureIndex's header on why a signature travels by name).
	//
	// Deliberately TOLERANT: it records only the exact `function NAME ( … ) returns TYPE` shape and
	// skips anything else without complaint. It is NOT a validator — the real parse runs afterwards
	// and produces the positioned diagnostic for whatever is malformed — and it must never become
	// one: a sweep that could VETO a call would reject a correct program the moment it failed to
	// recognize a declaration the parser accepts (see `CalleeReturn.undeclared`). It restores the
	// cursor, so it is invisible to everything downstream.
	export function foldDeclaredSignaturesInto(index ProgramSignatures)
		var entries = FuncReturnTypeEntryArray.create()
		var aliases = RangedTypeAliasArray.create()
		// ⭐ FUNCTION typealiases (P1.5-A1) — recorded from the SAME token walk as the ranged ones, into
		// their own array (a function alias is not a ranged one). Folded whole-program so a function-typed
		// place resolves whether the alias is declared above, below, or in another file.
		var functionAliases = FunctionTypeAliasArray.create()
		// ⭐ Generic-instance typealiases (P1.6-A) — `IntBox = Box with Integer`, recorded from the same
		// token walk, folded whole-program so `IntBox.create` resolves to `Box.create` in any file.
		var genericAliases = GenericAliasEntryArray.create()
		var structs = StructLayoutArray.create()
		var enums = EnumLayoutArray.create()
		var bindings = TopLevelDeclArray.create()
		// ⭐ Per-function CONSUME bits (P1.4a wave 2) — the argument-side dual of the return type, computed
		// from the SAME token walk. `recordScannedSignature` fills one entry per function whose body moves a
		// parameter into a struct field, so a call site can decide whether an owned argument is moved.
		var paramConsumes = ParamConsumeEntryArray.create()
		// ⭐ Per-function `throws E` clauses (P1.4b) — the call-site dual of the return type, from the SAME
		// token walk. One entry per THROWING function so a call site can decide whether it needs `try`.
		var throwsEntries = ThrowsClauseEntryArray.create()
		// ⭐ Inner ranged typealiases (P1.6-C) — one entry per `typealias Idx` declared inside a generic type,
		// keyed whole-program by `base.member` so `Instance.Idx` resolves in any file.
		var innerAliases = InnerAliasEntryArray.create()
		// ⭐ Per-method inner-alias parameter info (P1.6-C) — one entry per method/factory that declares a bare
		// inner-alias parameter, read by the per-instance argument check at concrete call sites.
		var methodInnerAliasParams = MethodInnerAliasParamEntryArray.create()

		let resume = self.pos
		self.pos = 0
		// ⚠ **BLOCK DEPTH, AND THE ONE ARM THAT NEEDS IT.** This loop walks EVERY token in the file,
		// function bodies included, and that is what makes it robust: it cannot miss a `function`
		// keyword however malformed the source around it is. `function` and `typealias` are reserved
		// and appear nowhere but a declaration, so their arms need no context at all.
		//
		// **`let` and `var` are different — they are the most common statements in any body.** So they,
		// and only they, are gated on depth 0. The counter tracks exactly shv2's block syntax:
		// `function`/`if`/`while`/a non-`if` `else` open one, `end` closes one, and nothing else in the
		// parsed slice does either (a typealias, a binding, a return, a call and an assignment are all
		// single-line). The opener predicate is `opensBlockAt` — the one the loop scanner already uses —
		// rather than a second list of block keywords to fall out of step with it.
		//
		// The gate is BELT AND BRACES, not the guarantee: `declaredOutcome` panics if this scan
		// and the real parse ever disagree about which binding is top level.
		var depth = 0 as BlockDepth
		// A `[` token appears ONLY in an array literal (Maxon indexes with `.get()`, not `a[i]`), so seeing
		// one anywhere in the file's tokens means the program materializes an `Array with integer` literal
		// (P1.7 slice 1). The sweep interns that one well-known instance so the parser can read its giid back
		// at literal time (a bare literal has no typealias to intern from). Set here, acted on after the walk.
		var hasIntArrayLiteral = false
		// A `b"…"` token appears ONLY in a byte-string literal, so seeing one means the program materializes an
		// `Array with Byte` (P1.7 slice 2). The sweep interns that one well-known instance so the parser can
		// read its giid back at literal time (a byte-string, like a bare `[…]`, has no typealias to intern from).
		var hasByteStringLiteral = false
		// A MANAGED-element array literal (P1.7 slice 3): a `[` followed by a STRING literal is `Array with String`;
		// a `[` followed by an IDENTIFIER (a local whose type the sweep cannot see) may be a String / struct / union
		// element, so the possible aggregate instances are over-interned. The parser reads back whichever the first
		// element resolves to. A `[` + int-literal stays the int-array default and interns none of these.
		var hasStringArrayLiteral = false
		var hasAggregateArrayLiteral = false
		// A bare `Set` identifier followed by `from` is a `Set from [ints]` / `Set from ["…"]` construction (P1.7b)
		// — the one `from`-construction shv2 parses. Its key type (int or String) is inferred from the array
		// literal, so — like a bare `[…]` — it has no typealias to intern its `Set with <key>` instance from; the
		// sweep over-interns BOTH well-known instances (int and String) for the parser to read back whichever the
		// source array resolves to. (The `[…]` of the literal itself sets `hasIntArrayLiteral` / `hasStringArrayLiteral`,
		// so the SOURCE array instance is interned too.) Set here, acted on after the walk.
		var hasSetFromLiteral = false
		while not self.isEof() 'scan'
			if self.at(TokenKind.leftBracket) 'arrayLiteralToken'
				hasIntArrayLiteral = true
				let afterKind = self.kindAt(self.pos + 1)
				if afterKind == TokenKind.stringLiteral 'stringElement'
					hasStringArrayLiteral = true
				end 'stringElement'
				if afterKind == TokenKind.identifier 'aggregateElement'
					hasAggregateArrayLiteral = true
				end 'aggregateElement'
			end 'arrayLiteralToken'

			if self.at(TokenKind.byteStringLiteral) 'byteStringToken'
				hasByteStringLiteral = true
			end 'byteStringToken'

			if self.atSetFromConstruction() 'setFromToken'
				hasSetFromLiteral = true
			end 'setFromToken'

			if depth == 0 and self.atTopLevelBindingKeyword() 'isTopLevelBinding'
				self.recordScannedBinding(bindings)
				continue
			end 'isTopLevelBinding'

			// A function DECLARATION — `function <name> (`, never a bare `function` keyword. A closure
			// literal spells the keyword and opens no block (see `functionDeclarationAt`); counted as a
			// declaration it would leave `depth` one too deep for the rest of the file, and every depth-0
			// gate below would stop firing.
			if self.functionDeclarationAt(self.pos) 'isFunction'
				// A function opens a block, closed by its own `end`. Counted BEFORE the signature is
				// read, because reading it moves the cursor past the `function` keyword.
				depth = depth + 1
				self.advance()
				self.recordScannedSignature(entries, paramConsumes: paramConsumes, throwsEntries: throwsEntries, methodInnerAliasParamOut: methodInnerAliasParams)
				continue
			end 'isFunction'

			if self.at(TokenKind.typealias) 'isTypeAlias'
				self.recordScannedTypeAlias(aliases, functionAliases: functionAliases, genericAliases: genericAliases)
				continue
			end 'isTypeAlias'

			// A `type` DECLARATION, and it is gated on depth 0 for `let`/`var`'s reason rather than
			// left ungated like `function`/`typealias`: `type` is reserved as a KEYWORD but is legal
			// as a PARAMETER NAME (`function f(type Integer)`), so a bare `type` token can appear
			// inside a parameter list. It cannot appear at depth 0 — the `function` arm above counts
			// the body open BEFORE `recordScannedSignature` reads it, and that routine skips the
			// parenthesized list wholesale — so at depth 0 a `type` token is a declaration and
			// nothing else.
			//
			// `recordScannedType` consumes the WHOLE declaration, cursor landing past its `end`, so
			// the loop's depth invariant is untouched by it and this stays ONE walk of the token
			// array. It consumes the `type` keyword before it can fail, so the cursor always
			// advances and this loop cannot spin.
			if depth == 0 and self.at(TokenKind.type) 'isTypeDecl'
				self.recordScannedType(structs, entries: entries, paramConsumes: paramConsumes, throwsEntries: throwsEntries, innerAliasOut: innerAliases, genericAliasOut: genericAliases, methodInnerAliasParamOut: methodInnerAliasParams)
				continue
			end 'isTypeDecl'

			// An `enum`/`union` DECLARATION, gated on depth 0 for `type`'s exact reason: both are
			// reserved keywords that are nonetheless legal as PARAMETER NAMES, so a bare `enum`/`union`
			// token can sit inside a parameter list (which `recordScannedSignature` skips wholesale). At
			// depth 0 it is a declaration and nothing else. `recordScannedEnum` consumes the whole
			// declaration — cursor past its `end` — so the loop's depth invariant is untouched.
			if depth == 0 and (self.at(TokenKind.enum) or self.at(TokenKind.union)) 'isEnumDecl'
				self.recordScannedEnum(enums, isUnion: self.at(TokenKind.union))
				continue
			end 'isEnumDecl'

			// An `interface` DECLARATION, gated on depth 0 like `type`/`enum`. It MUST be consumed whole
			// here (see `recordScannedInterface`): its bodiless method signatures would otherwise poison the
			// sweep's `function` arm and its block-depth counter.
			if depth == 0 and self.at(TokenKind.interface) 'isInterfaceDecl'
				self.recordScannedInterface()
				continue
			end 'isInterfaceDecl'

			depth = self.blockDepthAfter(depth)
			self.advance()
		end 'scan'
		self.pos = resume

		index.foldFile(entries, aliases: aliases, functionAliases: functionAliases, structs: structs, enums: enums, genericAliasEntries: genericAliases, innerAliasEntries: innerAliases, methodInnerAliasParamEntries: methodInnerAliasParams, bindings: bindings, paramConsumes: paramConsumes, throwsEntries: throwsEntries, fileTypeNames: self.artifact.typeNames)

		// Intern the `Array with integer` literal instance if this file materializes one — after `foldFile`,
		// so its giid follows the file's named generic instances (a stable, source-path-ordered assignment).
		if hasIntArrayLiteral 'internArrayLiteral'
			_ = index.internBuiltinIntegerInstance(ArrayBuiltinBaseName)
		end 'internArrayLiteral'

		// Intern the `Array with Byte` instance if this file materializes a byte-string literal — after
		// `foldFile`, exactly as the int-array literal instance above, so its giid follows the file's named
		// generic instances (a stable, source-path-ordered assignment).
		if hasByteStringLiteral 'internByteStrLiteral'
			_ = index.internArrayByteInstance()
		end 'internByteStrLiteral'

		// Intern the managed-element literal instances — `Array with String` for a `["…"]`, plus every declared
		// struct/union for a `[<identifier>…]` (whose element type the sweep cannot see). After `foldFile` so the
		// aggregate loop reads the folded structs/unions and so the giids follow the file's named instances (P1.7 slice 3).
		if hasStringArrayLiteral 'internStringArrayLiteral'
			_ = index.arrayInstanceForString()
		end 'internStringArrayLiteral'
		if hasAggregateArrayLiteral 'internAggregateArrayLiteral'
			index.internArrayLiteralAggregateInstances()
		end 'internAggregateArrayLiteral'

		// Intern the `Set with integer` AND `Set with String` instances if this file materializes a `Set from […]`
		// construction — its key type (int or String) is inferred from the array literal, which the sweep cannot
		// see, so both are over-interned (the parser reads back whichever the source array resolves to), exactly as
		// `internArrayLiteralAggregateInstances` over-interns the array's possible element instances. After
		// `foldFile` so their giids follow the file's named generic instances (a stable, source-path-ordered assignment).
		if hasSetFromLiteral 'internSetFromLiteral'
			_ = index.internBuiltinIntegerInstance(SetBuiltinBaseName)
			_ = index.setInstanceForString()
		end 'internSetFromLiteral'
	end 'foldDeclaredSignaturesInto'

	// Is the cursor on a `let` or a `var` — the two keywords that introduce a top-level binding?
	//
	// ONE predicate, read by BOTH the declaration sweep's depth-0 gate and `dispatchTopLevel`'s
	// arm, for the reason `assignsAt` is one predicate: a keyword taught to one and not the other
	// would put the sweep's idea of what is a declaration and the parser's a keyword apart. The
	// sweep would not record the binding, and `declaredOutcome`'s drift guard would panic on a
	// program that is perfectly correct.
	function atTopLevelBindingKeyword() returns bool
		return self.at(TokenKind.let) or self.at(TokenKind.var)
	end 'atTopLevelBindingKeyword'

	// ⭐ **DOES THE TOKEN AT `index` OPEN A FUNCTION DECLARATION — `function <name> (` — rather than
	// merely spell the `function` keyword?** The three-token shape IS the declaration: `parseFunction`
	// consumes `function`, a NAME and a parameter list in that order, and no clause may sit between them
	// (there is no generic-function `uses`). Two other things spell `function` and declare nothing:
	//
	//   • a CLOSURE LITERAL — `function(n Integer) gives n + c` — an expression, with no name, no `end`,
	//     and no block of its own;
	//   • an enum/union CASE NAME — `function` is a legal one (`keyword-as-case-name.md`).
	//
	// ONE predicate, read by the whole-file declaration sweep, by `recordScannedType`'s body walk and by
	// `atEnumMethodStart`, for `atTopLevelBindingKeyword`'s reason: the sweep's `function` arm counts a
	// BLOCK OPEN that only a real declaration's `end` ever closes, so a keyword taught to one reader and
	// not another leaves the sweep's block depth permanently one too deep. Every later depth-0 gate then
	// fails to fire — a `type`/`enum`/`interface`/top-level `let` after a closure literal is simply never
	// recorded — and the drift guards that exist for exactly this (`requireConstructible`,
	// `ProgramSignatures.recordedDeclFor`) fire as a compiler PANIC on a correct program. Inside a type
	// body the same overshoot swallows the NEXT type's members into this one's layout, which is a wrong
	// ANSWER: the swallowed type's factory is registered under this type's name, so a call to it is typed
	// from the wrong signature.
	function functionDeclarationAt(index TokenIndex) returns bool
		return self.kindAt(index) == TokenKind.function and self.kindAt(index + 1) == TokenKind.identifier and self.kindAt(index + 2) == TokenKind.leftParen
	end 'functionDeclarationAt'

	// Is the cursor on a `Set from` construction — a bare `Set` identifier immediately followed by `from`
	// (P1.7b slice B)?
	//
	// ONE predicate, read by BOTH the declaration sweep (which PRE-INTERNS `Set with integer` AND `Set with String`
	// so the parser's own read is never the first to mutate the shared registry) and `parsePrimary`'s construction
	// arm (which BUILDS the `__set_from`), for the reason `atTopLevelBindingKeyword` is one predicate. Taught to one
	// and not the other — a broadened `from`-construction trigger the parser builds but the sweep does not recognize
	// — a `Set from` would go un-pre-interned, and the parser's instance read would become the FIRST write to the
	// shared registry mid-parse: an order-dependent gid no drift guard can see. Teaching this one predicate teaches both.
	function atSetFromConstruction() returns bool
		return self.at(TokenKind.identifier) and self.current().value.equals(SetBuiltinBaseName) and self.peekKind() == TokenKind.from
	end 'atSetFromConstruction'

	// The block depth after the token at the cursor. `end` FLOORS at zero rather than underflowing: a
	// stray `end` is malformed source, and the sweep is tolerant — the real parse reports it, with a
	// position. (`BlockDepth` is unsigned, so an underflow would not merely be wrong, it would take the
	// compiler down on a file it should have diagnosed.)
	function blockDepthAfter(depth BlockDepth) returns BlockDepth
		if self.opensBlockAt(self.pos) 'opens'
			return depth + 1
		end 'opens'

		// A keyword case-name arm (`end gives …`) is not a block close — see `keywordIsMatchCaseName`.
		if self.at(TokenKind.end) and depth > 0 and not self.keywordIsMatchCaseName(self.pos) 'closes'
			return depth - 1
		end 'closes'

		return depth
	end 'blockDepthAfter'

	// Cursor is AT a top-level `let`. Append the constant it declares.
	//
	// TOLERANT, exactly as `recordScannedSignature` and `recordScannedTypeAlias` are, and for the same
	// reason: a malformed declaration is the REAL parse's to report, with a position. It reads through
	// `readTopLevelConstant` — the routine the real parse reads with — so the two cannot drift on where
	// an initializer ends. That routine consumes the `let` keyword before it can fail, so the cursor
	// always advances and the caller's loop cannot spin.
	function recordScannedBinding(bindings TopLevelDeclArray)
		let visibility = self.scannedVisibility()
		let decl = try self.readTopLevelBinding(visibility) otherwise return
		bindings.push(decl)
	end 'recordScannedBinding'

	// The visibility of the declaration at the cursor, read from the token BEFORE it.
	//
	// Backwards, rather than by tracking an `export` flag forward across the scan loop: a flag would
	// have to be CLEARED on every token that is not a declaration, and the one clear that got missed
	// would silently export the next declaration — a visibility bug, which is a wrong answer about
	// what another file can see. `dispatchTopLevel` consumes `export` and the keyword adjacently, so
	// the previous token is exactly the modifier and nothing else can sit between them.
	function scannedVisibility() returns Visibility
		if self.pos == 0 'atFileStart'
			return Visibility.file
		end 'atFileStart'

		if self.kindAt(self.pos - 1) == TokenKind.export 'exported'
			return Visibility.module
		end 'exported'

		return Visibility.file
	end 'scannedVisibility'

	// Cursor is just past `function`, ON the declared name. Append the declared return type of the
	// function that name introduces, if the declaration is well-formed enough to read one off.
	//
	// Both callers reach here only through `functionDeclarationAt`, so the `function` NAME `(` shape is
	// already established — this reader never re-asks it. (It stays TOLERANT past that point: a
	// malformed parameter list or return type is the real parse's to report, with a position.)
	//
	// The name is `declaredMethodName`'s, not the token's, so a factory inside `type Point` is
	// recorded under the very key `Point.create(3, y: 4)` will look it up by — see there.
	function recordScannedSignature(entries FuncReturnTypeEntryArray, paramConsumes ParamConsumeEntryArray, throwsEntries ThrowsClauseEntryArray, methodInnerAliasParamOut MethodInnerAliasParamEntryArray)
		let nameTok = self.current()
		// ⚠ Captured NOW, at the name token: the caller has consumed `function` (at `pos - 1`), so its modifier —
		// if any — is the token before that, and `static` is what marks a receiver-less method. Read after the
		// params/return type are consumed, that peek would land inside the return type instead. Asked through the
		// SHARED `functionDeclIsStatic` (the `pos >= 1` guard keeps the `pos - 1` at the very start of a file from
		// underflowing; such a top-level `function` has an empty `enclosingType` anyway) so this scan and the
		// implicit-self sibling walk answer "does this method take `self`?" from one token-level test.
		let hasStaticModifier = self.pos >= 1 and self.functionDeclIsStatic((self.pos - 1) as TokenIndex)
		self.advance()
		// The parameter list's `(` is captured before the skip so the param NAMES can be read back out of it
		// (`paramNamesIn`) — the CONSUME scan needs them, and `skipBalancedParens` only advances past them.
		let paramsStart = self.pos
		if not self.skipBalancedParens() 'malformedParams'
			return
		end 'malformedParams'
		let returnType = try self.parseOptionalReturnType() otherwise return
		let funcName = self.declaredMethodName(nameTok)
		entries.push(FuncReturnTypeEntry.create(funcName, returnType: returnType))
		// The `throws E` clause follows the return type; parsed BEFORE the consume-scan so the cursor lands
		// past it. Only a THROWING function gets an entry (its absence is "does not throw"), mirroring
		// `paramConsumes` recording only consuming functions. Gated on the `throws` KEYWORD being present so
		// the overwhelmingly common non-throwing function allocates neither a `ThrowsClause.none` nor a
		// `ThrowsClauseEntry` — its cursor already sits at the block label with nothing to consume.
		if self.at(TokenKind.throws) 'throwing'
			let throwsClause = try self.parseOptionalThrowsClause() otherwise return
			throwsEntries.push(ThrowsClauseEntry.create(funcName, clause: throwsClause))
		end 'throwing'

		// ⭐ Record which SOURCE parameters are bare inner aliases (P1.6-C), so the parser's per-instance
		// argument check can re-qualify them with a concrete receiver's instance alias at the call site. Only
		// inside a generic type that declares inner aliases, and only a method/factory that HAS such a parameter
		// gets an entry (the common case costs none). This is the ONE place the whole-program index learns a
		// method's inner-alias parameters — the return-type read above SKIPS the parameter list.
		if self.enclosingInnerAliases.count() != 0 'maybeInnerAliasParams'
			let innerAliasInfo = self.innerAliasParamsIn(paramsStart)
			if innerAliasInfo.hasInnerAliasMember() 'hasInnerAliasParam'
				methodInnerAliasParamOut.push(MethodInnerAliasParamEntry.create(funcName, info: innerAliasInfo))
			end 'hasInnerAliasParam'
		end 'maybeInnerAliasParams'

		// The cursor is now at the body start. Scan the body (peek-only, cursor untouched) for parameters
		// this function moves into durable storage — its CONSUME/FEED set.
		//
		// ⚠ **A RECEIVER-LESS function** (top-level function, `static` method) is scanned for BOTH the direct
		// struct-field store (`Self{f: p}`) and, inside a generic type, the type-parameter FEED; its source
		// parameter list already IS its call-site parameter list.
		//
		// ⚠ **AN INSTANCE method** (`push(item Element)`) prepends `self` as parameter 0 (`parseFunction`), so
		// the recorded facts must be CALL-ALIGNED — `SelfParamName` is prepended here so `feeds[i]`/`bits[i]`
		// name the same slot the receiver-prepending call site (`parseCallNamed`) does. It is scanned ONLY for
		// the array-mutator FEED (`self.items.push(item)`, P1.7 slice 3b-iii) and only inside a generic type: a
		// direct `Self{f: p}` store in an instance method is deliberately left to the callee-side borrowed-value
		// refusal (`moveInPayload`'s clean E2015), exactly as before this slice — so no NON-array instance method
		// changes its consume facts (`detectFieldStores: false`).
		let takesReceiver = not self.enclosingType.isEmpty() and not hasStaticModifier
		if not takesReceiver 'receiverless'
			// A parameter can be type-parameter-typed ONLY inside a generic type's body (a non-empty `uses`
			// list); a top-level function and a non-generic type's method have none. Off the generic path the
			// flags stay the SHARED empty array (⚡ no per-function `BoolArray`) and `paramNamesIn` skips the
			// flag work — `paramIsTypeParamTyped` reads every missing index as `false`.
			let collectTypeParamFlags = not self.enclosingTypeParams.isEmpty()
			var typeParamPositions = self.emptyTypeParamPositions
			if collectTypeParamFlags 'genericScope'
				typeParamPositions = TypeParamIdArray.create()
			end 'genericScope'
			let paramNames = self.paramNamesIn(paramsStart, typeParamPositionsOut: typeParamPositions, collectTypeParamFlags: collectTypeParamFlags)
			self.scanConsumeBits(funcName, paramNames: paramNames, typeParamPositions: typeParamPositions, bodyStart: self.pos, paramConsumes: paramConsumes, detectFieldStores: true)
		end 'receiverless' else 'instanceMethod'
			if not self.enclosingTypeParams.isEmpty() 'genericInstanceMethod'
				var typeParamPositions = TypeParamIdArray.create()
				let paramNames = self.callAlignedInstanceParams(paramsStart, typeParamPositionsOut: typeParamPositions)
				self.scanConsumeBits(funcName, paramNames: paramNames, typeParamPositions: typeParamPositions, bodyStart: self.pos, paramConsumes: paramConsumes, detectFieldStores: false)
			end 'genericInstanceMethod'
		end 'instanceMethod'
	end 'recordScannedSignature'

	// ⭐ **THE CALL-ALIGNED PARAMETER LIST of an instance method in a generic type** — `SelfParamName` at slot 0
	// (its sentinel type-parameter position), then the source parameters, in the SAME order the receiver-prepending
	// call site pushes them (`parseCallNamed`), so a per-position consume/feed fact lands at the argument's own
	// call-site position. `typeParamPositionsOut` is filled in lockstep (self's sentinel, then each source
	// parameter's declared position from `paramNamesIn`). The ONE place this alignment is spelled — shared by the
	// consume-bit scan (`recordScannedSignature`) and the transitive array-feed scan (`scanTypeMethodFeeds`) — so
	// the two cannot drift on where `self` sits, which would land a feed on the wrong parameter (a wrong-consume
	// double-free at the concrete call site).
	function callAlignedInstanceParams(paramsStart TokenIndex, typeParamPositionsOut TypeParamIdArray) returns ByteArrayArray
		typeParamPositionsOut.push(self.enclosingTypeParams.count())
		let sourceNames = self.paramNamesIn(paramsStart, typeParamPositionsOut: typeParamPositionsOut, collectTypeParamFlags: true)
		var paramNames = ByteArrayArray.create()
		paramNames.push(SelfParamName)
		for sourceName in sourceNames 'eachSource'
			paramNames.push(sourceName)
		end 'eachSource'
		return paramNames
	end 'callAlignedInstanceParams'

	// ⭐ **THE CONSUME SCAN (P1.4a wave 2)** — one entry per function whose body MOVES a parameter into
	// durable storage (a struct-literal field value). A peek-only walk of the body from `bodyStart` to its
	// matching `end`: it tracks the bracket stack (a struct literal is `{…}`, a call is `(…)`), and when a
	// `:` appears with the innermost open bracket a `{`, it is a struct-field separator — if the value that
	// follows is a bare reference (parens stripped) to a parameter, that parameter is CONSUMED.
	//
	// ⚠ **THIS IS A SOUND APPROXIMATION, NOT AN ORACLE, AND IT DOES NOT NEED TO BE ONE.** The callee-side
	// move (`moveInPayload`) refuses to move a parameter that is NOT enrolled owned, so an UNDER-detected
	// consume becomes a clean `E2015` at the constructor rather than a double-free; an OVER-detected one (a
	// shadowed name) makes the callee OWN and DROP the value once while its caller was poisoned — sound, just
	// stricter. So the scan may be simple: it detects the direct constructor sink (`Self{f: p}`) the corpus
	// uses and leaves the transitive case (a parameter forwarded to a consuming CALLEE — a `:` at a `(`
	// level, or a call argument) to the borrowed-value refusal. Parens are stripped exactly as the real
	// parse's `rhsWasBareLocalReference` strips them, so the two agree on what a bare-parameter value is.
	// The type-parameter position parameter `index` was declared with (P1.6-B2), or `enclosingTypeParams.count()`
	// (the "not a type parameter" sentinel `typeParamPositionOf` uses) when it is a plain type or out of range.
	// SAFE against the SHARED EMPTY positions array outside a generic type (`collectTypeParamFlags` false): a
	// missing index reads as the sentinel — a plain parameter.
	function paramTypeParamPositionAt(positions TypeParamIdArray, index ParamCount) returns TypeParamId
		return try positions.get(index) otherwise self.enclosingTypeParams.count()
	end 'paramTypeParamPositionAt'

	// Is parameter `index` type-parameter-typed, per the positions `paramNamesIn` filled? A position below the
	// type-parameter count names a real `uses` parameter; the sentinel (or a short/empty array) is a plain one.
	function paramIsTypeParamTyped(positions TypeParamIdArray, index ParamCount) returns bool
		return self.paramTypeParamPositionAt(positions, index: index) < self.enclosingTypeParams.count()
	end 'paramIsTypeParamTyped'

	function scanConsumeBits(funcName ByteArray, paramNames ByteArrayArray, typeParamPositions TypeParamIdArray, bodyStart TokenIndex, paramConsumes ParamConsumeEntryArray, detectFieldStores bool)
		if paramNames.count() == 0 'noParams'
			return
		end 'noParams'

		var consumed = BoolArray.create()
		for _ in 0 upto paramNames.count() 'initBits'
			consumed.push(false)
		end 'initBits'
		// The type-parameter FEED map is a fresh array pre-filled with `none` ONLY inside a generic type's
		// body — a feed requires a type-parameter-typed field, so a top-level function and a non-generic type's
		// method (all of them on the generics-free corpus) keep the SHARED empty array (⚡ no per-function
		// allocation; a missing index reads as `none`). `feeds.set` below is reached only through the feed
		// branch, which itself requires a below-count position, so the shared empty array is never mutated.
		let genericScope = self.enclosingTypeParams.count() > 0
		var feeds = self.initialTypeParamFeeds(paramNames.count(), genericScope: genericScope)
		var any = false
		// The bracket stack: `true` for a `{` (struct literal), `false` for a `(`/`[`. The innermost open
		// bracket being a `{` is what distinguishes a struct-field `:` from a labelled-call-argument one.
		var braceStack = BoolArray.create()
		var blockDepth = 0 as BlockDepth

		var q = bodyStart
		while self.kindAt(q) != TokenKind.eof 'walk'
			// The function's own `end` (at block depth 0) closes the scan.
			if blockDepth == 0 and self.closesBlockAt(q) 'funcEnd'
				break
			end 'funcEnd'

			let kind = self.kindAt(q)
			if kind == TokenKind.leftBrace 'openBrace'
				braceStack.push(true)
			end 'openBrace'
			if kind == TokenKind.leftParen 'openParen'
				braceStack.push(false)
			end 'openParen'
			if (kind == TokenKind.rightBrace or kind == TokenKind.rightParen) and braceStack.count() > 0 'close'
				_ = try braceStack.pop() otherwise panic("scanConsumeBits: braceStack.pop on non-empty stack failed")
			end 'close'

			if detectFieldStores and kind == TokenKind.colon and self.braceStackInnermostIsBrace(braceStack) 'fieldSep'
				let idx = self.consumedParamAfterColon(q, paramNames: paramNames)
				if idx < paramNames.count() 'isParam'
					let feedPos = self.paramTypeParamPositionAt(typeParamPositions, index: idx)
					if feedPos < self.enclosingTypeParams.count() 'typeParamField'
						// ⭐ **A TYPE-PARAMETER-typed store is a FEED, not a plain consume (P1.6-A/B2).**
						// `Self{value: v}` on `type Box uses T` stores `v` into `T`, whose managed-ness the shared
						// body cannot see (it is opaque here). P1.6-A EXCLUDED it (the box borrowed, the caller kept
						// the +1); B2 records WHICH type parameter it feeds instead, so the CONCRETE call site — which
						// knows the instance's argument at that position — consumes it iff that argument OWNS managed
						// heap (`Box with String`) and borrows it otherwise (`Box with Point`, byte-identical to A).
						try feeds.set(idx, value: TypeParamFeed.feeds(feedPos)) otherwise panic("scanConsumeBits: feeds.set OOB at {idx} despite idx < paramNames.count()")
						any = true
					end 'typeParamField' else 'plainField'
						// A NON-type-parameter field store (a monomorphic `Self{value: v}` into an `Integer` field,
						// or a direct `String`/struct field) — the callee OWNS it whatever the concrete type, so the
						// plain consume bit is set. A scalar argument makes it inert at the call site anyway.
						try consumed.set(idx, value: true) otherwise panic("scanConsumeBits: consumed.set OOB at {idx} despite idx < paramNames.count()")
						any = true
					end 'plainField'
				end 'isParam'
			end 'fieldSep'

			// ⭐ **`self.items.push(item)` — AN OPAQUE-`T` `Array` MUTATOR IS A FEED (P1.7 slice 3b-iii).** A
			// generic method that pushes/sets/inserts a type-parameter argument into an `Array`-typed FIELD of
			// `self` moves that argument into the field's array, whose element the enclosing instance OWNS (its
			// `__arr_decref` walk destroys it). The shared body cannot see the element's managed-ness — it is
			// opaque here — so the parameter is recorded as a FEED of the type parameter it fills, exactly like a
			// `Self{field: v}` feed, and the CONCRETE call site consumes it iff that instance's argument owns
			// managed heap (`Container with String`) and borrows it otherwise (`Container with SmallInt`,
			// byte-identical). The head test recognises `self . <field> . push/set/insert (` (`self` never a value,
			// so it cannot itself be matched here), and only a BARE type-parameter argument is fed — a concrete
			// element (a monomorphic `Array with String` field) already moves in at the array call.
			// `self.items.push(item)` (an array mutator CALL) and `self.saved = item` (a bare-field REASSIGNMENT,
			// P1.7 Finding A) are the two opaque-`T` feed shapes an instance method performs — both moving a
			// type-parameter argument into durable storage the enclosing instance owns and drops. Probed together
			// at each `self`, mutually exclusive by their fourth token (`.` vs `=`).
			if kind == TokenKind.self 'maybeOpaqueFeed'
				if self.markOpaqueArrayMutatorFeeds(q, paramNames: paramNames, typeParamPositions: typeParamPositions, feeds: feeds) 'fedArray'
					any = true
				end 'fedArray'
				if self.markOpaqueFieldReassignFeed(q, paramNames: paramNames, typeParamPositions: typeParamPositions, feeds: feeds) 'fedField'
					any = true
				end 'fedField'
			end 'maybeOpaqueFeed'

			if self.opensBlockAt(q) 'opensBlock'
				blockDepth = blockDepth + 1
			end 'opensBlock' else 'notOpener'
				if blockDepth > 0 and self.closesBlockAt(q) 'closesBlock'
					blockDepth = blockDepth - 1
				end 'closesBlock'
			end 'notOpener'

			q = q + 1
		end 'walk'

		if any 'consumes'
			paramConsumes.push(ParamConsumeEntry.create(funcName, info: ParamConsumeInfo.create(paramNames, bits: consumed, feeds: feeds)))
		end 'consumes'
	end 'scanConsumeBits'

	// The type-parameter-feed array `scanConsumeBits` starts from: the SHARED empty array outside a generic
	// type (no feed is possible, ⚡ no allocation), or a fresh `count`-long array pre-filled with `none` inside
	// one (which the feed branch then `set`s). Single-assignment, so it needs no cross-block `var`.
	function initialTypeParamFeeds(count ParamCount, genericScope bool) returns TypeParamFeedArray
		if not genericScope 'nonGeneric'
			return sharedEmptyTypeParamFeeds
		end 'nonGeneric'
		var feeds = TypeParamFeedArray.create()
		for _ in 0 upto count 'fill'
			feeds.push(TypeParamFeed.none)
		end 'fill'
		return feeds
	end 'initialTypeParamFeeds'

	// ⭐ **THE TRANSITIVE LAYOUT-DESCRIPTOR-NEED FIXPOINT** (P1.6-B1) — populate `typeDescriptorNeeds` for the
	// generic type whose body the cursor sits at. A method needs the hidden descriptor param iff it directly
	// reads `sizeof(T)` OR calls a sibling method ON `self` that needs one — so `indirectSize` that only does
	// `return self.directSize()` still carries (and forwards) the descriptor. The self-call graph is LOCAL to
	// this one type declaration (a method self-calls only siblings, same file, contiguous), so the whole
	// fixpoint is a single peek-only walk of the type body plus a cheap iterate-to-stable — no whole-program
	// index. A non-generic type has no such methods, so it clears the map and returns.
	//
	// The same framework `scanConsumeBits` uses (`opensBlockAt` / `keywordIsMatchCaseName`) delimits each
	// method body; a named `function <ident>` opens one (a closure is `function(` — no name, no `end`).
	function computeTypeDescriptorNeeds()
		// A NON-generic type has no method that can carry a descriptor, so it allocates NOTHING here (the
		// scale corpus is all non-generic types — a per-type `Map` here would be a linear regression). The
		// stale `typeDescriptorNeeds` from a previous type is never read for it: `parseFunction` gates its read
		// on `enclosingTypeParams` being non-empty.
		if self.enclosingTypeParams.isEmpty() 'notGeneric'
			return
		end 'notGeneric'
		self.typeDescriptorNeeds = DescriptorNeedMap.create()

		var directSizeof = DescriptorNeedMap.create()
		var selfCallees = SelfCalleesMap.create()
		var methodNames = ByteArrayArray.create()

		var q = self.pos
		while self.kindAt(q) != TokenKind.eof 'walk'
			if self.closesBlockAt(q) 'typeEnd'
				break
			end 'typeEnd'
			// A named `function <ident>` at the member level opens a method body (a closure is `function(` —
			// no name, no `end`). Its whole body is scanned in one nested pass, and the walk resumes past its
			// `end` — so this outer loop only ever sees member-level tokens.
			if self.kindAt(q) == TokenKind.function and self.kindAt(q + 1) == TokenKind.identifier 'method'
				let methodName = self.tokenAt(q + 1).value
				let scan = self.scanOneMethodDescriptorSignals(q + 2)
				// ⭐ A method that DROPS a consumed opaque ARRAY feed parameter needs the descriptor too (P1.7
				// slice 3b-v) — the runtime `__drop_type_param` reads the instance's `destroyFunc@40`. That drop
				// happens only when a feed can be left LIVE at an exit: a feed parameter present AND the body is not
				// straight-line (`hasControlFlow`). Gated on `not isStatic`: only an INSTANCE method's feed is an
				// ARRAY feed (a `static` carries only a P1.6-B2 struct-field feed, consumed at its call site and
				// never dropped through the descriptor — seeding it would reserve a descriptor a multi-parameter
				// generic constructor cannot even materialize). The whole-program feed fact
				// (`functionFeedsTypeParam`, from the sweep) is joined with the local body shape; seeded like a
				// direct `sizeof(T)` so the fixpoint propagates it to every method that forwards the descriptor.
				let dropsFeed = scan.hasControlFlow and not self.functionDeclIsStatic(q) and self.signatures.functionFeedsTypeParam(qualifiedMethodName(self.enclosingType, methodName: methodName))
				// ⭐ A method that MOVES an opaque array element OUT (`.pop()`/`.remove()`) drops the owned
				// `typeParameter` result at scope exit through `__drop_type_param`, so it needs the descriptor too
				// (P1.7 slice 3b-vi-a). `not isStatic` for `dropsFeed`'s reason — a generic constructor cannot
				// materialize a descriptor it does not receive; a static never moves an element out of a shared-body
				// opaque array (it has no `self` to reach one and no threaded `T` instance). Over-reserving an unused
				// descriptor for a move-out that turns out concrete is sound; seeded like a direct `sizeof(T)` so the
				// fixpoint gives every self-caller a descriptor to forward.
				let movesOutArrayElement = scan.hasArrayMoveOut and not self.functionDeclIsStatic(q)
				// ⭐ A method that COPIES an opaque array element (`.slice()`/`.clone()`/`.append()`) lowers to an
				// `__arr_*_opaque(arr, …, descriptor)` wrapper reading `copyFunc@32`, so it needs the descriptor too
				// (P1.7 slice 3b-vi-b-β). `not isStatic` mirrors the sibling opaque signals — a static generic method
				// has no `self`-threaded instance descriptor to source. Over-reserving for a concrete-array copy in a
				// generic body is sound; seeded like a direct `sizeof(T)` so the fixpoint forwards it to self-callers.
				let copiesArrayElement = scan.hasArrayCopy and not self.functionDeclIsStatic(q)
				// ⭐ A method that REASSIGNS a bare opaque MANAGED type-parameter field (`self.saved = next`, P1.7
				// Finding A) drops the field's OLD value through the descriptor-gated `__drop_type_param`, so it needs
				// the descriptor too. `not isStatic` mirrors the sibling signals — a static has no `self` to reach a
				// field, and one that needed a descriptor would have no receiver to source it from. `scan.reassignsOpaqueField`
				// is already gated on the field being managed for some instantiation (`isManagedOpaqueTypeParamField`),
				// so a trivial-only instantiation reserves nothing and stays byte-identical; seeded like a direct
				// `sizeof(T)` so the fixpoint gives every self-caller a descriptor to forward.
				let reassignsOpaqueManagedField = scan.reassignsOpaqueField and not self.functionDeclIsStatic(q)
				directSizeof.upsert(methodName, value: scan.direct or dropsFeed or movesOutArrayElement or reassignsOpaqueManagedField or copiesArrayElement)
				selfCallees.upsert(methodName, value: scan.callees)
				methodNames.push(methodName)
				q = scan.endPos
				continue
			end 'method'
			q = q + 1
		end 'walk'

		self.solveDescriptorNeedFixpoint(methodNames, directSizeof: directSizeof, selfCallees: selfCallees)
	end 'computeTypeDescriptorNeeds'

	// Scan ONE method's body — from `bodyStart` (just past `function <name>`) to its own `end` — for the two
	// descriptor signals: a direct `sizeof(T)`, and the sibling methods it calls on `self`. `depth` starts at 1
	// because the method's own block is already open. ALSO records `hasControlFlow` (P1.7 slice 3b-v): the body
	// is NOT straight-line — a nested block-opener, or a `return`/`throw`/`break`/`continue` — the token signal
	// the caller pairs with "has an opaque feed parameter" to decide the drop needs the descriptor. Split into
	// its own function so the accumulators are simple straight-line locals (no loop-carried array reassignment
	// across the outer type walk).
	function scanOneMethodDescriptorSignals(bodyStart TokenIndex) returns MethodDescriptorScan
		var direct = false
		var callees = ByteArrayArray.create()
		var hasControlFlow = false
		var hasArrayMoveOut = false
		var reassignsOpaqueField = false
		var hasArrayCopy = false
		var depth = 1 as BlockDepth
		var q = bodyStart
		while self.kindAt(q) != TokenKind.eof 'walk'
			let kind = self.kindAt(q)
			if kind == TokenKind.sizeof and self.sizeofOperandIsTypeParamAt(q) 'directSizeof'
				direct = true
			end 'directSizeof'
			// A `return`/`throw`/`break`/`continue` is a NON-final exit (or, at the tail, harmless over-inclusion):
			// with one of these OR a nested block below, a feed parameter can be left live at an exit and dropped,
			// so the method needs the descriptor. A straight-line body has none and unconditionally consumes its
			// feed. Over-inclusion only reserves an unused descriptor parameter (sound), never a wrong drop.
			if kind == TokenKind.return or kind == TokenKind.throw or kind == TokenKind.break or kind == TokenKind.continue 'earlyExit'
				hasControlFlow = true
			end 'earlyExit'
			// Constructing an opaque-`T` array (`ElementArray.create()`) stamps its `element_destroy@40` from the
			// enclosing instance's threaded descriptor, so — like `sizeof(T)` — it needs the descriptor param
			// (P1.7 slice 3b-i). `X` `.` `create` `(`, four contiguous tokens with `X` an opaque-array alias.
			if kind == TokenKind.identifier and self.opaqueArrayCreateAt(q) 'opaqueArrayCreate'
				direct = true
			end 'opaqueArrayCreate'
			// A `.pop()`/`.remove(i)` array MOVE-OUT hands back an OWNED element dropped at scope exit; when the
			// element is an opaque `typeParameter` that drop routes through the descriptor-gated
			// `__drop_type_param`, so — like `sizeof(T)` and an opaque `X.create()` — the method needs the
			// descriptor param (P1.7 slice 3b-vi-a). The receiver is NOT resolved here (the pre-scan runs before
			// the body is parsed), so ANY move-out is recorded and the caller decides — over-reserving an unused
			// descriptor for a concrete-array move-out is sound. READ accessors (`get`/`first`/`last`) BORROW and
			// drop nothing, so they are not move-outs and are excluded.
			if kind == TokenKind.identifier and self.arrayMoveOutMethodAt(q) 'arrayMoveOut'
				hasArrayMoveOut = true
			end 'arrayMoveOut'
			// A `.slice()`/`.clone()`/`.append()` array COPY lowers, on an OPAQUE array, to an
			// `__arr_{slice,clone,append}_opaque(arr, …, descriptor)` wrapper that reads the enclosing instance's
			// `copyFunc@32` (P1.7 slice 3b-vi-b-β), so — like the move-out — the method needs the descriptor param.
			// The receiver is NOT resolved here, so ANY copy is recorded and the caller decides; over-reserving an
			// unused descriptor for a concrete-array copy is sound.
			if kind == TokenKind.identifier and self.arrayCopyMethodAt(q) 'arrayCopy'
				hasArrayCopy = true
			end 'arrayCopy'
			// A `self.<opaqueManagedField> = …` REASSIGNMENT drops the field's OLD opaque value through the
			// descriptor-gated `__drop_type_param` (P1.7 Finding A), so — like an opaque array move-out — the
			// method needs the descriptor. `opaqueFieldReassignAt` reads the field's opacity AND managed-ness off
			// `self.signatures` (the SAME `isManagedOpaqueTypeParamField` the reserved slot and the emitted drop
			// decide off), so a trivial-only field reserves nothing (byte-identical) and a managed one reserves.
			if kind == TokenKind.self and self.opaqueFieldReassignAt(q) 'opaqueFieldReassign'
				reassignsOpaqueField = true
			end 'opaqueFieldReassign'
			if kind == TokenKind.self and self.isSelfMethodCallAt(q) 'selfCall'
				callees.push(self.tokenAt(q + 2).value)
			end 'selfCall'
			// A BARE sibling call `method(…)` (#65) is a self-call too: implicit-self resolves it to
			// `self.method(…)`, so it must feed the descriptor-need fixpoint exactly as an explicit
			// `self.method(…)` does — otherwise a method reading `sizeof(T)` reached only through a bare sibling
			// call would leave its caller with no descriptor to forward (a `forwardCallerLayout` panic). A
			// callee that is NOT a sibling (a free function, a builtin) is dropped by the fixpoint's name->index
			// filter, so over-including here is harmless.
			if kind == TokenKind.identifier and self.isBareCallAt(q) 'bareCall'
				callees.push(self.tokenAt(q).value)
			end 'bareCall'

			if self.opensBlockAt(q) 'opensBlock'
				// A nested block-opener (`if`/`while`/`match`/`for`/`try`/inner block) — the feed's consume may be
				// guarded, so it can be left live at the merge. The method's own block is already open (depth 1), so
				// every opener here is a nested one.
				hasControlFlow = true
				depth = depth + 1
			end 'opensBlock' else 'notOpener'
				if self.closesBlockAt(q) 'closes'
					depth = depth - 1
					if depth == 0 'methodEnd'
						return MethodDescriptorScan.create(direct, callees: callees, hasControlFlow: hasControlFlow, hasArrayMoveOut: hasArrayMoveOut, reassignsOpaqueField: reassignsOpaqueField, hasArrayCopy: hasArrayCopy, endPos: (q + 1) as TokenIndex)
					end 'methodEnd'
				end 'closes'
			end 'notOpener'

			q = q + 1
		end 'walk'
		return MethodDescriptorScan.create(direct, callees: callees, hasControlFlow: hasControlFlow, hasArrayMoveOut: hasArrayMoveOut, reassignsOpaqueField: reassignsOpaqueField, hasArrayCopy: hasArrayCopy, endPos: q)
	end 'scanOneMethodDescriptorSignals'

	// Is the token at `selfPos` the start of a `self.<method>(` call — the self-call the descriptor-need
	// fixpoint threads through? `self` `.` `<ident>` `(`, four contiguous tokens.
	function isSelfMethodCallAt(selfPos TokenIndex) returns bool
		return self.kindAt(selfPos + 1) == TokenKind.dot and self.kindAt(selfPos + 2) == TokenKind.identifier and self.kindAt(selfPos + 3) == TokenKind.leftParen
	end 'isSelfMethodCallAt'

	// Is the identifier at `q` a BARE call `<identifier>(` — followed by `(` and NOT preceded by a `.` (which
	// would make it the member of a `receiver.method(…)` or a qualified `Type.method(…)` call, neither of which
	// is a bare self-call)? The callee is the identifier itself. Used by the descriptor-need scan to treat an
	// implicit-self bare sibling call (#65) as the `self.method(…)` it lowers to.
	function isBareCallAt(q TokenIndex) returns bool
		return self.kindAt(q + 1) == TokenKind.leftParen and (q == 0 or self.kindAt(q - 1) != TokenKind.dot)
	end 'isBareCallAt'

	// Does the `function` keyword at `functionTok` carry a `static` modifier — the token IMMEDIATELY before it?
	// `[export] static function` is the only member shape (`export` precedes `static`; `parseTypeMember`), so the
	// token adjacent to `function` is exactly the modifier or not. THE one token-level answer to "is this a
	// receiver-less method?", shared by the descriptor sweep (`recordScannedSignature`) and the implicit-self
	// sibling walk (`ensureSiblingReceivers`, #65) so those two token scans cannot come to disagree about which
	// methods take `self`. The FORWARD twin is `parseTypeMember`'s `not isStatic`, which mints the actual
	// `SelfParamName` parameter every later reader recovers the fact from (`FuncSignature.takesReceiver`).
	function functionDeclIsStatic(functionTok TokenIndex) returns bool
		return functionTok > 0 and self.kindAt((functionTok - 1) as TokenIndex) == TokenKind.static
	end 'functionDeclIsStatic'

	// Is the identifier at `aliasPos` a member-level opaque-`T` array alias followed by `.create(` — the
	// construction that seeds the descriptor need (P1.7 slice 3b-i)? `X` `.` `create` `(`, four contiguous
	// tokens whose `X` qualifies (`Container.X`) to a whole-program generic alias naming an OPAQUE `Array`
	// instance. The opacity is read straight off `self.signatures` — the SAME index and the SAME
	// `arrayElementIsOpaque` predicate `emitArrayCreateOp` branches the descriptor-reading create on — so the
	// reserved slot and the emitted read decide off ONE fact and cannot diverge, whatever their token distance.
	// The sweep has folded every inner alias before the real parse reaches here, so the lookup is complete
	// regardless of where the alias sits in the body (a constructing method may textually precede it).
	function opaqueArrayCreateAt(aliasPos TokenIndex) returns bool
		if self.kindAt(aliasPos + 1) != TokenKind.dot or self.kindAt(aliasPos + 2) != TokenKind.identifier or not self.tokenAt(aliasPos + 2).value.equals(ArrayCreateMethod) or self.kindAt(aliasPos + 3) != TokenKind.leftParen 'notCreateShape'
			return false
		end 'notCreateShape'
		let qualified = joinQualifiedName(self.enclosingType, member: self.tokenAt(aliasPos).value)
		if not self.signatures.isGenericAlias(qualified) 'notAlias'
			return false
		end 'notAlias'
		let giid = self.signatures.genericAliasInstance(qualified)
		return self.signatures.isArrayInstance(giid) and self.signatures.arrayElementIsOpaque(giid)
	end 'opaqueArrayCreateAt'

	// Is the token at `q` a `<receiver> . <method> (` call HEAD — a preceding `.` and a following `(`? The shared
	// shape of the receiver-blind array-method descriptor signals (`arrayMoveOutMethodAt` / `arrayCopyMethodAt`):
	// it distinguishes an array method from a bare free call `pop(…)` without resolving the receiver, which the
	// pre-scan (running before the body is parsed) cannot do. Each caller pairs this shape with its own
	// method-name set.
	function isDotMethodCallHeadAt(q TokenIndex) returns bool
		return q != 0 and self.kindAt((q - 1) as TokenIndex) == TokenKind.dot and self.kindAt(q + 1) == TokenKind.leftParen
	end 'isDotMethodCallHeadAt'

	// Is the identifier at `q` the method name of a `<receiver> . pop/remove (` array MOVE-OUT — the descriptor
	// signal for an opaque element drop (P1.7 slice 3b-vi-a)? The RECEIVER is deliberately NOT resolved: the
	// pre-scan cannot tell whether it is `self.<opaque-field>`, a local bound to it, or an opaque array parameter
	// — every one of which reaches the same descriptor-gated `__drop_type_param` drop — so ANY move-out is
	// signalled and the caller reserves an (at worst unused, always sound) descriptor. `get`/`first`/`last` BORROW
	// and drop nothing, so they are not move-outs and are not matched.
	function arrayMoveOutMethodAt(q TokenIndex) returns bool
		if not self.isDotMethodCallHeadAt(q) 'notMethodCall'
			return false
		end 'notMethodCall'
		let name = self.tokenAt(q).value
		return name.equals(ArrayPopMethod) or name.equals(ArrayRemoveMethod)
	end 'arrayMoveOutMethodAt'

	// Is the identifier at `q` the method name of a `<receiver> . slice/clone/append (` array COPY — the
	// descriptor signal for an OPAQUE array copy (P1.7 slice 3b-vi-b-β)? A preceding `.` and a following `(`
	// distinguish the array method from a bare free call; the RECEIVER is deliberately NOT resolved (the pre-scan
	// runs before the body is parsed), so ANY copy is signalled and the caller reserves an (at worst unused,
	// always sound) descriptor. Shares `isDotMethodCallHeadAt` with `arrayMoveOutMethodAt`, over the COPY names.
	function arrayCopyMethodAt(q TokenIndex) returns bool
		if not self.isDotMethodCallHeadAt(q) 'notMethodCall'
			return false
		end 'notMethodCall'
		let name = self.tokenAt(q).value
		return name.equals(ArraySliceMethod) or name.equals(ArrayCloneMethod) or name.equals(ArrayAppendMethod)
	end 'arrayCopyMethodAt'

	// ⭐ **THE `self . <field> =` REASSIGNMENT HEAD — ONE token-shape recognizer (P1.7 Finding A).** Both the
	// descriptor-need scan (`opaqueFieldReassignAt`, real parse) and the sweep feed (`markOpaqueFieldReassignFeed`,
	// pre-layout) must agree on what OPENS a self field reassignment, or one enrolls the reassigned parameter owned
	// while the other fails to reserve the method's layout descriptor — an owned value then drops through a
	// `__drop_type_param` whose descriptor was never reserved, a fault. So the three tokens after `self` — `.`
	// `<ident>` `=` — are recognized in ONE place, ~240 lines from the other caller; each caller adds only its own
	// tail (the scan checks the field's managed-ness, the feed checks the RHS is a bare type-parameter parameter).
	// `self` is never a value, so a match here is always a field WRITE head, and the trailing `=` separates it from
	// a `self.<field>` READ (`x = self.saved`) and from a nested `self.a.b = …` (a `.`, not `=`, follows the field).
	function fieldReassignHeadAt(selfPos TokenIndex) returns bool
		return self.kindAt(selfPos + 1) == TokenKind.dot and self.kindAt(selfPos + 2) == TokenKind.identifier and self.kindAt(selfPos + 3) == TokenKind.equals
	end 'fieldReassignHeadAt'

	// Is the token at `selfPos` the start of a `self.<field> = ` REASSIGNMENT of a bare opaque type-parameter
	// field that some instantiation makes MANAGED (P1.7 Finding A)? The `self . <ident> =` head is recognized by
	// the shared `fieldReassignHeadAt`; here the `<ident>` must additionally be a `typeParameter` field of the
	// enclosing generic type with a managed instantiation (`isManagedOpaqueTypeParamField`). Only such a
	// reassignment drops the field's old opaque value through `__drop_type_param`, so it is what reserves the
	// layout descriptor — the field-STORE twin of `arrayMoveOutMethodAt`'s move-out call. Runs in the real parse
	// (`computeTypeDescriptorNeeds`, after the whole-program sweep), so the layout AND the instance registry the
	// managed-ness gate reads are complete.
	function opaqueFieldReassignAt(selfPos TokenIndex) returns bool
		if not self.fieldReassignHeadAt(selfPos) 'notReassignShape'
			return false
		end 'notReassignShape'
		return self.signatures.isManagedOpaqueTypeParamField(self.enclosingType, fieldName: self.tokenAt(selfPos + 2).value)
	end 'opaqueFieldReassignAt'

	// Solve the descriptor-need relation to its least fixpoint: a method needs the descriptor iff it directly
	// reads sizeof(T) (a seed) OR self-calls a method that needs one — equivalently, iff it can REACH a seed
	// over the self-call edges. So REVERSE the graph once and mark reachability BACKWARD from the seeds:
	// each method enters the worklist at most once (the first time its bit flips on) and each self-call edge
	// is walked once, for O(methods + self-calls). The earlier iterate-to-stable re-scanned every method each
	// round at O(methods x (methods + self-calls)) — QUADRATIC on a deep self-call chain (a machine-generated
	// wide generic type: mN reads sizeof(T), m(i) calls m(i+1), so need propagates one hop per round against
	// declaration order, forcing O(methods) rounds).
	//
	// The reversal is `buildCsr` — THE shared counting sort (CsrGraph), the same one the CFG's pred/succ lists
	// and the register allocator's death lists build through — fed the self-call edges with (callee, caller)
	// SWAPPED, exactly as `TargetLiveness` swaps (from, to) to turn successors into predecessors. Growing a
	// fourth hand-rolled count/prefix-sum/scatter here is precisely what CsrGraph's header forbids.
	function solveDescriptorNeedFixpoint(methodNames ByteArrayArray, directSizeof DescriptorNeedMap, selfCallees SelfCalleesMap)
		let methodCount = methodNames.count()

		// Dense index per method name, so the self-call graph reverses into the CSR's dense key space below.
		var nameToIndex = MethodIndexMap.create()
		for i in 0 upto methodCount 'index'
			nameToIndex.upsert(try methodNames.get(i) otherwise panic("solveDescriptorNeedFixpoint: methodNames.get({i}) OOB below count {methodCount}"), value: i)
		end 'index'

		// The REVERSED self-call edges: a forward edge (caller `i` -> sibling callee `c`) is recorded as
		// `c -> i`, so a BFS from a needing method reaches the siblings that call it. A self-call to a name that
		// is not a sibling method is not a real edge and is dropped. `buildCsr` counting-sorts these into the
		// reverse adjacency (`callersOf`) in O(edges + methods).
		var edgeCallee = CsrColumn.create()
		var edgeCaller = CsrColumn.create()
		for i in 0 upto methodCount 'edges'
			for calleeName in self.calleesOf(methodNames, selfCallees: selfCallees, callerIndex: i) 'edge'
				if let c = try nameToIndex.get(calleeName) 'realEdge'
					edgeCallee.push(c)
					edgeCaller.push(i)
				end 'realEdge'
			end 'edge'
		end 'edges'
		let callersOf = buildCsr(edgeCallee, to: edgeCaller, nodeCount: methodCount)

		// Seed each method's direct-sizeof bit, then mark every method that REACHES a needing one over the
		// reversed self-call edges — a method needs the descriptor iff it directly reads sizeof(T) or self-calls
		// (transitively) a method that does.
		var seeds = BoolArray.create()
		for i in 0 upto methodCount 'seed'
			seeds.push(try directSizeof.get(try methodNames.get(i) otherwise panic("methodNames.get({i}) in seed")) otherwise false)
		end 'seed'
		let needs = self.reverseReachabilityMark(callersOf, seeds: seeds)

		// Publish each method's final need bit, keyed by name — what `parseFunction` reads to reserve the slot.
		for i in 0 upto methodCount 'publish'
			self.typeDescriptorNeeds.upsert(try methodNames.get(i) otherwise panic("methodNames.get({i}) in publish"), value: try needs.get(i) otherwise panic("needs.get({i}) in publish"))
		end 'publish'
	end 'solveDescriptorNeedFixpoint'

	// ⭐ **REVERSE-REACHABILITY BFS over a CSR adjacency** — return the bit per node that is set iff the node is a
	// seed OR reaches one over `graph`'s edges. The graph is the REVERSED relation (`buildCsr` with (callee,
	// caller) swapped), so a seed's row lists the nodes that point AT it and the BFS propagates the mark BACKWARD.
	// Each node enters the worklist at most once (the first time its bit flips on) and each edge is walked once,
	// for O(nodes + edges). The shared engine of the descriptor-need fixpoint (`solveDescriptorNeedFixpoint`) and
	// the transitive array-feed fixpoint (`solveAndPublishTransitiveFeeds`), so the two cannot drift on how
	// reachability is marked.
	function reverseReachabilityMark(graph CsrGraph, seeds BoolArray) returns BoolArray
		var marked = BoolArray.create()
		var worklist = CsrColumn.create()
		for i in 0 upto seeds.count() 'seed'
			let isSeed = try seeds.get(i) otherwise panic("reverseReachabilityMark: seeds.get({i}) OOB")
			marked.push(isSeed)
			if isSeed 'root'
				worklist.push(i)
			end 'root'
		end 'seed'

		var head = 0 as CsrIndex
		while head < worklist.count() 'drain'
			let node = try worklist.get(head) otherwise panic("reverseReachabilityMark: worklist.get({head}) OOB")
			head = head + 1
			for k in 0 upto graph.degree(node) 'neighbour'
				let nbr = graph.neighbour(node, k: k)
				if not (try marked.get(nbr) otherwise panic("reverseReachabilityMark: marked.get({nbr}) OOB")) 'newlyMarked'
					try marked.set(nbr, value: true) otherwise panic("reverseReachabilityMark: marked.set({nbr}) OOB")
					worklist.push(nbr)
				end 'newlyMarked'
			end 'neighbour'
		end 'drain'
		return marked
	end 'reverseReachabilityMark'

	// The sibling methods `methodNames[callerIndex]` calls on `self` — the forward self-call edges out of one
	// method. A thin read-only view onto `selfCallees` shared by the descriptor-need fixpoint's two CSR passes
	// (count, then scatter) so the edge iteration is written once, not twice.
	function calleesOf(methodNames ByteArrayArray, selfCallees SelfCalleesMap, callerIndex ElementCount) returns ByteArrayArray
		return try selfCallees.get(try methodNames.get(callerIndex) otherwise panic("calleesOf: methodNames.get({callerIndex}) OOB")) otherwise ByteArrayArray.create()
	end 'calleesOf'

	// Is the `sizeof` at `sizeofPos` a `sizeof(<typeParam>)` — the 4 contiguous tokens `sizeof ( ident )`
	// whose identifier names an enclosing type parameter? `parseSizeof` consumes exactly this shape with no
	// newline tolerance, so matching it token-for-token keeps the pre-scan and the real parse in lockstep.
	function sizeofOperandIsTypeParamAt(sizeofPos TokenIndex) returns bool
		if self.kindAt(sizeofPos + 1) != TokenKind.leftParen 'noOpen'
			return false
		end 'noOpen'
		if self.kindAt(sizeofPos + 2) != TokenKind.identifier 'notIdent'
			return false
		end 'notIdent'
		if self.kindAt(sizeofPos + 3) != TokenKind.rightParen 'noClose'
			return false
		end 'noClose'
		return self.typeParamPositionOf(self.tokenAt(sizeofPos + 2).value) < self.enclosingTypeParams.count()
	end 'sizeofOperandIsTypeParamAt'

	// Is the innermost OPEN bracket a `{` (a struct literal)? The stack's top decides whether a `:` is a
	// struct-field separator (yes) or a labelled call argument's (no).
	function braceStackInnermostIsBrace(braceStack BoolArray) returns bool
		if braceStack.count() == 0 'empty'
			return false
		end 'empty'
		return try braceStack.get(braceStack.count() - 1) otherwise panic("braceStackInnermostIsBrace: get OOB on non-empty stack")
	end 'braceStackInnermostIsBrace'

	// The parameter index of the VALUE that follows a struct-field `:` at `colonPos`, or `paramNames.count()`
	// (a non-parameter) when the value is not a bare parameter reference. The value runs to the field's `,`
	// or the literal's `}`; surrounding parens are stripped (matching `rhsWasBareLocalReference`), so
	// `f: p`, `f: (p)` and `f: ((p))` all name `p`, while `f: p + 1`, `f: g(p)` and `f: q.x` name none.
	function consumedParamAfterColon(colonPos TokenIndex, paramNames ByteArrayArray) returns ParamCount
		var q = colonPos + 1
		var opens = 0
		while self.kindAt(q) == TokenKind.leftParen 'stripOpen'
			opens = opens + 1
			q = q + 1
		end 'stripOpen'

		if self.kindAt(q) != TokenKind.identifier 'notIdentifier'
			return paramNames.count()
		end 'notIdentifier'
		let idx = self.paramIndexIn(paramNames, name: self.tokenAt(q).value)
		if idx >= paramNames.count() 'notParam'
			return paramNames.count()
		end 'notParam'
		q = q + 1

		var closes = 0
		while self.kindAt(q) == TokenKind.rightParen and closes < opens 'stripClose'
			closes = closes + 1
			q = q + 1
		end 'stripClose'
		if closes != opens 'unbalanced'
			return paramNames.count()
		end 'unbalanced'

		// The value must END here — the next token is the field separator `,` or the literal close `}`.
		// Anything else (`+`, `.`, `(`) means the parameter was READ inside a larger expression, not moved.
		if self.kindAt(q) == TokenKind.comma or self.kindAt(q) == TokenKind.rightBrace 'bareMove'
			return idx
		end 'bareMove'
		return paramNames.count()
	end 'consumedParamAfterColon'

	// The index of `name` in `paramNames`, or `paramNames.count()` when absent — the linear-scan door the
	// consume scan maps a value token back to a parameter position through.
	function paramIndexIn(paramNames ByteArrayArray, name ByteArray) returns ParamCount
		for i in 0 upto paramNames.count() 'each'
			let paramName = try paramNames.get(i) otherwise panic("paramIndexIn: paramNames.get OOB at {i}")
			if paramName.equals(name) 'match'
				return i
			end 'match'
		end 'each'
		return paramNames.count()
	end 'paramIndexIn'

	// ⭐ **MARK EACH BARE TYPE-PARAMETER ARGUMENT of a `self . <field> . push/set/insert ( … )` CALL AS A FEED
	// (P1.7 slice 3b-iii)**, returning whether any was marked. Cursor `selfPos` is the `self` keyword the walk
	// stopped on. `paramNames`/`typeParamPositions` are CALL-ALIGNED (self at slot 0), so a feed lands at the
	// argument's own call-site position. The array FIELD is not resolved (the sweep has no field types yet) —
	// but no NON-array field can type-check a bare type-parameter element through push/set/insert, so a
	// well-typed program only reaches a real opaque array field here; an ill-typed one is rejected by the real
	// parse regardless. Only a BARE type-parameter argument is fed (a `push`'s sole positional argument, a
	// `set`/`insert`'s labelled `value:` element); an index expression, a chain or a `value` label token is not.
	function markOpaqueArrayMutatorFeeds(selfPos TokenIndex, paramNames ByteArrayArray, typeParamPositions TypeParamIdArray, feeds TypeParamFeedArray) returns bool
		if self.kindAt(selfPos + 1) != TokenKind.dot or self.kindAt(selfPos + 2) != TokenKind.identifier 'notFieldAccess'
			return false
		end 'notFieldAccess'
		if self.kindAt(selfPos + 3) != TokenKind.dot or self.kindAt(selfPos + 4) != TokenKind.identifier 'notMethodCall'
			return false
		end 'notMethodCall'
		if not self.isArrayMoveInMutator(self.tokenAt(selfPos + 4).value) 'notMoveInMutator'
			return false
		end 'notMoveInMutator'
		if self.kindAt(selfPos + 5) != TokenKind.leftParen 'notCall'
			return false
		end 'notCall'

		var any = false
		var depth = 1
		var p = selfPos + 6
		while depth > 0 and self.kindAt(p) != TokenKind.eof 'args'
			let kind = self.kindAt(p)
			if kind == TokenKind.leftParen 'openNested'
				depth = depth + 1
			end 'openNested' else 'notOpen'
				if kind == TokenKind.rightParen 'closeArg'
					depth = depth - 1
				end 'closeArg' else 'notClose'
					if depth == 1 and kind == TokenKind.identifier and self.isBareArgValueAt(p) 'candidate'
						let idx = self.paramIndexIn(paramNames, name: self.tokenAt(p).value)
						if idx < paramNames.count() and self.paramIsTypeParamTyped(typeParamPositions, index: idx) 'typeParamArg'
							try feeds.set(idx, value: TypeParamFeed.feeds(self.paramTypeParamPositionAt(typeParamPositions, index: idx))) otherwise panic("markOpaqueArrayMutatorFeeds: feeds.set OOB at {idx} despite idx < paramNames.count()")
							any = true
						end 'typeParamArg'
					end 'candidate'
				end 'notClose'
			end 'notOpen'
			p = p + 1
		end 'args'
		return any
	end 'markOpaqueArrayMutatorFeeds'

	// ⭐ **`self.<opaqueField> = param` — REASSIGNING A BARE OPAQUE-`T` FIELD IS A FEED (P1.7 Finding A).** A
	// generic instance method that reassigns a bare type-parameter field of `self` from a type-parameter argument
	// MOVES that argument into the field, whose opaque content the enclosing instance OWNS (its
	// `__destruct_<instance>` cascade, or the shared body's `__drop_type_param` on the next reassign, drops it).
	// The shared body cannot see the field's managed-ness — it is opaque here — so the parameter is recorded as a
	// FEED of the type parameter it fills, exactly like a `Self{field: v}` construction feed or a
	// `self.items.push(item)` array feed, and the CONCRETE call site consumes it iff that instance's argument owns
	// managed heap (`Box with String`) and borrows it otherwise (`Box with SmallInt`, byte-identical). Without
	// this the caller would BORROW the managed argument the box then destroys — a double-free (`0xC0000005`), the
	// field-store twin of the array-feed hole `recordTransitiveArrayFeeds` closes. The head test recognises
	// `self . <field> = <param>` where the RHS is a bare type-parameter parameter.
	function markOpaqueFieldReassignFeed(selfPos TokenIndex, paramNames ByteArrayArray, typeParamPositions TypeParamIdArray, feeds TypeParamFeedArray) returns bool
		// The field's opacity is NOT queried here: this runs in the SWEEP, before the struct layouts are merged
		// into `self.signatures` (exactly why `markOpaqueArrayMutatorFeeds` is purely token-based too). It need
		// not be — a type-parameter argument can be assigned ONLY to a type-parameter (opaque) field, so a bare
		// type-parameter RHS on a `self.<field> =` write IMPLIES the field is opaque; any non-opaque target is a
		// type error the real parse rejects before this feed can matter. The precise opacity + managed-ness check
		// lives in the descriptor scan (`opaqueFieldReassignAt`) and the emit (`emitOpaqueFieldReassign`), which
		// run in the real parse where the layout is known — the two agree on a valid program, and disagree only
		// on one the real parse already refuses.
		if not self.fieldReassignHeadAt(selfPos) or self.kindAt(selfPos + 4) != TokenKind.identifier 'notReassignShape'
			return false
		end 'notReassignShape'
		// The RHS must be JUST the parameter — a `.`/`(` after it would make it `next.x`/`next(...)`, a type error
		// on an opaque value the parse rejects, but excluded here so no larger expression is misread as a move.
		if self.kindAt(selfPos + 5) == TokenKind.dot or self.kindAt(selfPos + 5) == TokenKind.leftParen 'notBareMove'
			return false
		end 'notBareMove'
		let idx = self.paramIndexIn(paramNames, name: self.tokenAt(selfPos + 4).value)
		if idx >= paramNames.count() or not self.paramIsTypeParamTyped(typeParamPositions, index: idx) 'notTypeParamArg'
			return false
		end 'notTypeParamArg'
		try feeds.set(idx, value: TypeParamFeed.feeds(self.paramTypeParamPositionAt(typeParamPositions, index: idx))) otherwise panic("markOpaqueFieldReassignFeed: feeds.set OOB at {idx} despite idx < paramNames.count()")
		return true
	end 'markOpaqueFieldReassignFeed'

	// The three `Array` mutators that MOVE an element in — `push` (its sole argument), `set` / `insert` (their
	// labelled `value:` argument) — all of which transfer ownership of that element to the array (P1.7 slice
	// 3b-iii). `append` borrows another array, `reserve`/`resize`/`clear` take no element, so none feeds.
	function isArrayMoveInMutator(name ByteArray) returns bool
		return name.equals(ArrayPushMethod) or name.equals(ArraySetMethod) or name.equals(ArrayInsertMethod)
	end 'isArrayMoveInMutator'

	// Is the identifier at `p` a BARE argument value — the whole of its argument slot? True iff it is bounded
	// by an argument delimiter on both sides: `(`, a top-level `,`, or a label `:` before it, and a `,` or the
	// closing `)` after it. So `push(item)`'s `item` and `set(i, value: item)`'s `item` match, while an index
	// expression, a `.`-chain hop, or a label token (`value`, which is followed by `:`) does not.
	function isBareArgValueAt(p TokenIndex) returns bool
		let before = self.kindAt(p - 1)
		let after = self.kindAt(p + 1)
		let leftBounded = before == TokenKind.leftParen or before == TokenKind.comma or before == TokenKind.colon
		let rightBounded = after == TokenKind.comma or after == TokenKind.rightParen
		return leftBounded and rightBounded
	end 'isBareArgValueAt'

	// ⭐ **CLOSE THE ARRAY-FEED RELATION OVER SELF-CALL FORWARDS (P1.7 slice 3b-iv)** — after every method of a
	// generic type is scanned, a method M's parameter P is ALSO a type-parameter FEED when M forwards P (as a bare
	// argument) to a self-call `self.N(...)` whose corresponding parameter is itself a feed. Without this only the
	// method that DIRECTLY pushes into the array (`store`) is a feed, so a forwarder (`add(item){ self.store(item) }`)
	// leaves its OWN concrete call site (`sc.add("x")`) BORROWING the managed argument — which the owning array then
	// destroys, freeing a value nobody transferred (a double-free, `0xC0000005`). This is the per-parameter analogue
	// of `solveDescriptorNeedFixpoint`: a least fixpoint over the same self-call graph, mirrored here with FORWARD
	// edges (M's parameter -> N's parameter) rather than a per-method boolean, solved by the same linear
	// reverse-reachability BFS. It runs in the SWEEP — feeds are a whole-program `ParamConsumeInfo` fact a cross-file
	// concrete call site reads — after the method loop, so every sibling's parameter list is known for edge
	// resolution. A NON-generic type has no type parameter to feed, so it does nothing.
	function recordTransitiveArrayFeeds(paramConsumes ParamConsumeEntryArray, bodyStart TokenIndex, feedStart ElementCount)
		if self.enclosingTypeParams.isEmpty() 'notGeneric'
			return
		end 'notGeneric'
		self.solveAndPublishTransitiveFeeds(self.scanTypeMethodFeeds(bodyStart), paramConsumes: paramConsumes, feedStart: feedStart)
	end 'recordTransitiveArrayFeeds'

	// Walk the generic type's body once, returning one `MethodFeedScan` per method — its call-aligned parameters,
	// direct array-mutator feeds, and self-call forward edges. Mirrors `computeTypeDescriptorNeeds`' body walk: a
	// named `function <ident>` opens a method whose whole body is scanned in one nested pass
	// (`scanOneMethodFeedSignals`), and the walk resumes past its `end`, so this outer loop only ever sees
	// member-level tokens. A `static` method is scanned uniformly: it has no `self`, so it contributes no direct
	// feed and no self-call edge — inert in the fixpoint (it is never published), so it needs no special case.
	function scanTypeMethodFeeds(bodyStart TokenIndex) returns MethodFeedScanArray
		var scans = MethodFeedScanArray.create()
		var q = bodyStart
		while self.kindAt(q) != TokenKind.eof 'walk'
			if self.closesBlockAt(q) 'typeEnd'
				break
			end 'typeEnd'
			if self.kindAt(q) == TokenKind.function and self.kindAt(q + 1) == TokenKind.identifier 'method'
				var typeParamPositions = TypeParamIdArray.create()
				let paramNames = self.callAlignedInstanceParams(q + 2, typeParamPositionsOut: typeParamPositions)
				let scan = self.scanOneMethodFeedSignals(q + 2, funcName: qualifiedMethodName(self.enclosingType, methodName: self.tokenAt(q + 1).value), paramNames: paramNames, typeParamPositions: typeParamPositions)
				scans.push(scan)
				q = scan.endPos
				continue
			end 'method'
			q = q + 1
		end 'walk'
		return scans
	end 'scanTypeMethodFeeds'

	// Scan ONE method's body — from `startPos` (the `(` of its parameter list) to its own `end` — for the array-feed
	// signals: the DIRECT array-mutator feeds it performs on `self` (`self.items.push(param)`) and the self-call
	// forward edges out of it (`self.N(param)`, plus an implicit-self bare-sibling `N(param)` #65, which lowers to
	// the same self-call). `depth` starts at 1 because the method's own block is already open; the parameter list and
	// return type carry no `self.<field>.mutator` or `self.N` shape and no bare-sibling call, so scanning from
	// `startPos` costs one harmless pass over them — mirroring `scanOneMethodDescriptorSignals`, which starts at the
	// same token.
	function scanOneMethodFeedSignals(startPos TokenIndex, funcName ByteArray, paramNames ByteArrayArray, typeParamPositions TypeParamIdArray) returns MethodFeedScan
		var directFeeds = self.initialTypeParamFeeds(paramNames.count(), genericScope: true)
		var edges = ForwardFeedEdgeArray.create()
		var depth = 1 as BlockDepth
		var q = startPos
		while self.kindAt(q) != TokenKind.eof 'walk'
			let kind = self.kindAt(q)
			if kind == TokenKind.self 'selfToken'
				// `self.<field>.push/set/insert(param)` is a DIRECT feed (two dots); `self.N(param)` is a FORWARD
				// edge (one dot). The two token shapes are mutually exclusive, so both are probed at each `self`.
				_ = self.markOpaqueArrayMutatorFeeds(q, paramNames: paramNames, typeParamPositions: typeParamPositions, feeds: directFeeds)
				// `self.<opaqueField> = param` (P1.7 Finding A) is a DIRECT feed too — seeded here so the transitive
				// closure marks a forwarder INTO a field-reassigning sibling as consuming its own argument.
				_ = self.markOpaqueFieldReassignFeed(q, paramNames: paramNames, typeParamPositions: typeParamPositions, feeds: directFeeds)
				if self.isSelfMethodCallAt(q) 'selfCall'
					self.collectForwardFeedEdges(q + 4, calleeName: qualifiedMethodName(self.enclosingType, methodName: self.tokenAt(q + 2).value), paramNames: paramNames, typeParamPositions: typeParamPositions, edges: edges)
				end 'selfCall'
			end 'selfToken' else 'notSelf'
				// A BARE sibling call `N(param)` (#65) lowers to `self.N(param)`, so it forwards exactly as an explicit
				// self-call does. The callee is qualified to `<enclosingType>.N`; a call to a name that is not a sibling
				// method is dropped by the fixpoint's name->index filter, so over-including here is harmless.
				if kind == TokenKind.identifier and self.isBareCallAt(q) 'bareCall'
					self.collectForwardFeedEdges(q + 2, calleeName: qualifiedMethodName(self.enclosingType, methodName: self.tokenAt(q).value), paramNames: paramNames, typeParamPositions: typeParamPositions, edges: edges)
				end 'bareCall'
			end 'notSelf'

			if self.opensBlockAt(q) 'opensBlock'
				depth = depth + 1
			end 'opensBlock' else 'notOpener'
				if self.closesBlockAt(q) 'closes'
					depth = depth - 1
					if depth == 0 'methodEnd'
						return MethodFeedScan.create(funcName, paramNames: paramNames, typeParamPositions: typeParamPositions, directFeeds: directFeeds, edges: edges, endPos: (q + 1) as TokenIndex)
					end 'methodEnd'
				end 'closes'
			end 'notOpener'

			q = q + 1
		end 'walk'
		return MethodFeedScan.create(funcName, paramNames: paramNames, typeParamPositions: typeParamPositions, directFeeds: directFeeds, edges: edges, endPos: q)
	end 'scanOneMethodFeedSignals'

	// Extract the self-call forward edges from ONE `self.N(...)` / bare-sibling `N(...)` call's argument list, whose
	// first argument token is at `argsStart` (just past the `(`). For each argument that is a BARE reference to a
	// caller parameter that is type-parameter-typed, append an edge to `calleeName` — positional (empty `argLabel`)
	// for the first argument, labelled (`argLabel:`) otherwise — for the fixpoint to resolve to the callee's own
	// parameter position. A non-parameter argument, an index expression, or a `.`-chain hop is not a bare forward and
	// is skipped; a plain-typed caller parameter cannot BE a feed, so it is skipped too.
	function collectForwardFeedEdges(argsStart TokenIndex, calleeName ByteArray, paramNames ByteArrayArray, typeParamPositions TypeParamIdArray, edges ForwardFeedEdgeArray)
		var depth = 1
		var p = argsStart
		while depth > 0 and self.kindAt(p) != TokenKind.eof 'args'
			let kind = self.kindAt(p)
			if kind == TokenKind.leftParen 'openNested'
				depth = depth + 1
			end 'openNested' else 'notOpen'
				if kind == TokenKind.rightParen 'closeArg'
					depth = depth - 1
				end 'closeArg' else 'notClose'
					if depth == 1 and kind == TokenKind.identifier and self.isBareArgValueAt(p) 'candidate'
						let idx = self.paramIndexIn(paramNames, name: self.tokenAt(p).value)
						if idx < paramNames.count() and self.paramIsTypeParamTyped(typeParamPositions, index: idx) 'typeParamArg'
							edges.push(ForwardFeedEdge.create(idx, calleeName: calleeName, argLabel: self.argLabelBefore(p)))
						end 'typeParamArg'
					end 'candidate'
				end 'notClose'
			end 'notOpen'
			p = p + 1
		end 'args'
	end 'collectForwardFeedEdges'

	// The argument LABEL immediately before a bare argument value at `valuePos`, or `EmptySourceText` for the first
	// POSITIONAL argument. A labelled argument is `label : value`, so the label is two tokens back; a positional one
	// is bounded by `(` or `,`. Mirrors how a call site slots a labelled argument by name and the first argument by
	// position (`slotCallArgs`).
	function argLabelBefore(valuePos TokenIndex) returns ByteArray
		if self.kindAt((valuePos - 1) as TokenIndex) == TokenKind.colon and self.kindAt((valuePos - 2) as TokenIndex) == TokenKind.identifier 'labelled'
			return self.tokenAt((valuePos - 2) as TokenIndex).value
		end 'labelled'
		return EmptySourceText
	end 'argLabelBefore'

	// Solve the array-feed relation to its least fixpoint over the self-call forward edges, then publish each
	// method's transitive feeds into `paramConsumes`. A (method, parameter) NODE is a feed iff it directly feeds an
	// array mutator OR it forwards to a feed node — iff it can REACH a directly-fed node over the forward edges. So
	// REVERSE the edges (`buildCsr` with (callee, caller) SWAPPED, exactly as `solveDescriptorNeedFixpoint`) and mark
	// reachability BACKWARD from the seeds: each node enters the worklist at most once (the first time its bit flips
	// on) and each edge is walked once, for O(nodes + edges).
	function solveAndPublishTransitiveFeeds(scans MethodFeedScanArray, paramConsumes ParamConsumeEntryArray, feedStart ElementCount)
		let methodCount = scans.count()

		// Dense method index per qualified name, and the per-method NODE base (prefix sum of call-aligned parameter
		// counts), so a `(method, parameter)` pair flattens into one dense CSR key space. `nodeMethod` is the inverse
		// (node -> its method), read when a newly-fed node marks its method for publishing.
		var nameToIndex = MethodIndexMap.create()
		var paramBase = CsrColumn.create()
		var nodeMethod = CsrColumn.create()
		var totalNodes = 0 as CsrIndex
		for i in 0 upto methodCount 'index'
			let scan = try scans.get(i) otherwise panic("solveAndPublishTransitiveFeeds: scans.get({i}) OOB below count {methodCount}")
			nameToIndex.upsert(scan.funcName, value: i)
			paramBase.push(totalNodes)
			for _ in 0 upto scan.paramNames.count() 'node'
				nodeMethod.push(i)
			end 'node'
			totalNodes = totalNodes + scan.paramNames.count()
		end 'index'

		// The REVERSED forward edges: a forward node edge (caller -> callee) is recorded as `callee -> caller`, so a
		// BFS from a fed node reaches the callers that forward INTO it. An edge to a name that is not a sibling
		// method, or to a callee parameter position out of range (a malformed call), is not a real edge and is
		// dropped — `buildCsr` counting-sorts the rest into the reverse adjacency in O(edges + nodes).
		var edgeCallee = CsrColumn.create()
		var edgeCaller = CsrColumn.create()
		for i in 0 upto methodCount 'edges'
			let scan = try scans.get(i) otherwise panic("solveAndPublishTransitiveFeeds: scans.get({i}) OOB in edges")
			let callerBase = try paramBase.get(i) otherwise panic("solveAndPublishTransitiveFeeds: paramBase.get({i}) OOB")
			for edge in scan.edges 'edge'
				if let j = try nameToIndex.get(edge.calleeName) 'sibling'
					let calleeScan = try scans.get(j) otherwise panic("solveAndPublishTransitiveFeeds: scans.get({j}) OOB for callee")
					let calleePos = self.forwardEdgeCalleePos(edge, calleeScan: calleeScan)
					if calleePos < calleeScan.paramNames.count() 'realEdge'
						edgeCallee.push((try paramBase.get(j) otherwise panic("solveAndPublishTransitiveFeeds: paramBase.get({j}) OOB")) + calleePos)
						edgeCaller.push(callerBase + edge.callerParamPos)
					end 'realEdge'
				end 'sibling'
			end 'edge'
		end 'edges'
		let feedersOf = buildCsr(edgeCallee, to: edgeCaller, nodeCount: totalNodes)

		// Seed each DIRECTLY-fed node, then mark every node that REACHES one over the reversed forward edges — a
		// (method, parameter) node is a feed iff it directly feeds an array mutator or forwards (transitively) to a
		// feed node.
		var seeds = BoolArray.create()
		for i in 0 upto methodCount 'seedNodes'
			let scan = try scans.get(i) otherwise panic("solveAndPublishTransitiveFeeds: scans.get({i}) OOB in seed")
			for p in 0 upto scan.paramNames.count() 'param'
				seeds.push((try scan.directFeeds.get(p) otherwise panic("solveAndPublishTransitiveFeeds: directFeeds.get({p}) OOB")).isFeed())
			end 'param'
		end 'seedNodes'
		let isFeed = self.reverseReachabilityMark(feedersOf, seeds: seeds)

		// A method must have its `paramConsumes` entry (re)written iff it GAINED a feed at a node that was not a
		// direct seed — a method whose feeds are entirely direct already carries the right entry from the sweep.
		var gained = BoolArray.create()
		for _ in 0 upto methodCount 'seedGained'
			gained.push(false)
		end 'seedGained'
		for node in 0 upto totalNodes 'markGained'
			let transitively = (try isFeed.get(node) otherwise panic("solveAndPublishTransitiveFeeds: isFeed.get({node}) OOB")) and not (try seeds.get(node) otherwise panic("solveAndPublishTransitiveFeeds: seeds.get({node}) OOB"))
			if transitively 'gainedFeed'
				try gained.set(try nodeMethod.get(node) otherwise panic("solveAndPublishTransitiveFeeds: nodeMethod.get({node}) OOB"), value: true) otherwise panic("solveAndPublishTransitiveFeeds: gained.set OOB")
			end 'gainedFeed'
		end 'markGained'

		self.publishTransitiveFeeds(scans, paramBase: paramBase, isFeed: isFeed, gained: gained, paramConsumes: paramConsumes, feedStart: feedStart)
	end 'solveAndPublishTransitiveFeeds'

	// The callee's call-aligned parameter position a forward edge targets: its FIRST user parameter (call-aligned
	// slot 1) for a positional argument, or the labelled parameter's position (`paramIndexIn`) otherwise — the same
	// slotting a call site applies (the receiver is call-aligned slot 0, so the first positional argument is slot 1).
	function forwardEdgeCalleePos(edge ForwardFeedEdge, calleeScan MethodFeedScan) returns ParamCount
		if edge.argLabel.isEmpty() 'positional'
			return 1 as ParamCount
		end 'positional'
		return self.paramIndexIn(calleeScan.paramNames, name: edge.argLabel)
	end 'forwardEdgeCalleePos'

	// Write each transitively-fed method's final feeds into `paramConsumes`. Only a method that GAINED a feed at a
	// non-directly-fed parameter is touched: replace the sweep's DIRECT-feed entry in place (a forwarder that ALSO
	// directly feeds), or append a fresh one (a PURE forwarder the sweep recorded no entry for). An instance method
	// has no plain consume bit (`detectFieldStores: false`), so the bits are all false; the feeds are read straight
	// off the solved `isFeed` nodes. A method whose feeds are entirely direct is left as the sweep recorded it, so a
	// type with no forwarder is byte-identical.
	function publishTransitiveFeeds(scans MethodFeedScanArray, paramBase CsrColumn, isFeed BoolArray, gained BoolArray, paramConsumes ParamConsumeEntryArray, feedStart ElementCount)
		for i in 0 upto scans.count() 'publish'
			if not (try gained.get(i) otherwise panic("publishTransitiveFeeds: gained.get({i}) OOB")) 'noGain'
				continue
			end 'noGain'
			let scan = try scans.get(i) otherwise panic("publishTransitiveFeeds: scans.get({i}) OOB")
			let base = try paramBase.get(i) otherwise panic("publishTransitiveFeeds: paramBase.get({i}) OOB")
			var bits = BoolArray.create()
			var feeds = TypeParamFeedArray.create()
			for p in 0 upto scan.paramNames.count() 'buildFeeds'
				bits.push(false)
				let feedParam = try isFeed.get(base + p) otherwise panic("publishTransitiveFeeds: isFeed.get OOB at ({base}+{p})")
				if feedParam 'feedParam'
					feeds.push(TypeParamFeed.feeds(self.paramTypeParamPositionAt(scan.typeParamPositions, index: p)))
				end 'feedParam' else 'plainParam'
					feeds.push(TypeParamFeed.none)
				end 'plainParam'
			end 'buildFeeds'
			self.replaceOrAppendParamConsume(paramConsumes, feedStart: feedStart, entry: ParamConsumeEntry.create(scan.funcName, info: ParamConsumeInfo.create(scan.paramNames, bits: bits, feeds: feeds)))
		end 'publish'
	end 'publishTransitiveFeeds'

	// Publish one transitively-fed method's consume entry: REPLACE the sweep's direct-feed entry for this method in
	// place, or APPEND a fresh one when the sweep recorded none (a pure forwarder). Only entries added since
	// `feedStart` — this type's own methods — are searched, and method names are whole-program unique, so the match
	// is exact.
	function replaceOrAppendParamConsume(paramConsumes ParamConsumeEntryArray, feedStart ElementCount, entry ParamConsumeEntry)
		for i in feedStart upto paramConsumes.count() 'find'
			if (try paramConsumes.get(i) otherwise panic("replaceOrAppendParamConsume: paramConsumes.get({i}) OOB")).name.equals(entry.name) 'match'
				try paramConsumes.set(i, value: entry) otherwise panic("replaceOrAppendParamConsume: paramConsumes.set({i}) OOB")
				return
			end 'match'
		end 'find'
		paramConsumes.push(entry)
	end 'replaceOrAppendParamConsume'

	// ⭐ **READ A PARAMETER LIST IN ONE WALK (P1.6-A/B2)** — the ordered NAMES out of the `(…)` beginning at
	// `parenPos` (returned), and IN THE SAME PASS the type-parameter POSITION each parameter's declared type
	// names (the sentinel `enclosingTypeParams.count()` for a plain type), pushed into
	// `typeParamPositionsOut`. Peek-only (the cursor is untouched). Each parameter is `name Type`, so the
	// first token after `(` or a top-level `,` is the name and the type runs to the next top-level `,` or the
	// closing `)`; `skipParamType` finds that end (paren depth tracked, because a type may itself contain
	// parens — `int(0 to 100)`, `function(X) returns Y`).
	//
	// ⚠ **NAME AND TYPE-PARAM POSITION ARE PRODUCED TOGETHER, SO `names[i]` AND `positions[i]` ALWAYS
	// DESCRIBE THE SAME PARAMETER.** The consume scan reads the position to decide whether parameter `i` was
	// moved into a plain field (`Self{f: p}` — consumed), fed a type parameter (a concrete-site managed
	// consume, B2), or merely aliased — a MISALIGNMENT would fire on the wrong parameter and leak or
	// double-move. Two independent walks would agree only by coincidence; ONE walk makes it structural. When
	// `collectTypeParamFlags` is false — every function OUTSIDE a generic type, i.e. all of them on the
	// generics-free corpus — the position work is skipped and `typeParamPositionsOut` is left untouched (the
	// caller passes the SHARED empty array, ⚡ so the hot path allocates no per-function array).
	function paramNamesIn(parenPos TokenIndex, typeParamPositionsOut TypeParamIdArray, collectTypeParamFlags bool) returns ByteArrayArray
		var names = ByteArrayArray.create()
		var q = parenPos
		if self.kindAt(q) != TokenKind.leftParen 'noParens'
			return names
		end 'noParens'
		q = q + 1
		if self.kindAt(q) == TokenKind.rightParen 'noParams'
			return names
		end 'noParams'

		while true 'params'
			// The parameter's first token is its NAME (an identifier — or a keyword like `type`, which is a
			// legal parameter name; the type reader that follows is what tells them apart, and the sweep only
			// needs the text, not the kind).
			names.push(self.tokenAt(q).value)
			let typeStart = q + 1
			let typeEnd = self.skipParamType(typeStart)
			if collectTypeParamFlags 'flag'
				typeParamPositionsOut.push(self.paramTypeParamPosition(typeStart, typeEnd: typeEnd))
			end 'flag'
			if self.kindAt(typeEnd) != TokenKind.comma 'endList'
				return names
			end 'endList'
			q = typeEnd + 1
		end 'params'
		panic("paramNamesIn: the parameter loop only exits by returning at the closing `)` or at EOF")
	end 'paramNamesIn'

	// The TYPE-PARAMETER POSITION the parameter type spanning `[typeStart, typeEnd)` names (P1.6-A/B2) — a
	// SINGLE identifier (`typeEnd == typeStart + 1`) whose text is a `uses` parameter of the enclosing type
	// resolves to its position; anything else yields the "not a type parameter" sentinel
	// (`enclosingTypeParams.count()`, what `typeParamPositionOf` returns for a non-parameter name). The
	// consume scan reads it BOTH as "is it a type parameter?" (position below count) and, for B2, as the
	// feed position — one walk, one fact.
	function paramTypeParamPosition(typeStart TokenIndex, typeEnd TokenIndex) returns TypeParamId
		if typeEnd == typeStart + 1 and self.kindAt(typeStart) == TokenKind.identifier 'singleIdent'
			return self.typeParamPositionOf(self.tokenAt(typeStart).value)
		end 'singleIdent'
		return self.enclosingTypeParams.count()
	end 'paramTypeParamPosition'

	// ⭐ The inner-alias PARAMETER shape of the parameter list at `parenPos` (P1.6-C) — its SOURCE parameter
	// names and, per position, the bare inner-alias MEMBER (`Idx`) or `EmptySourceText`. It walks the list the
	// way `paramNamesIn` does (the ONE parameter grammar) but reads the TYPE token span rather than skipping
	// it. Only called inside a generic type that declares inner aliases.
	function innerAliasParamsIn(parenPos TokenIndex) returns InnerAliasParamInfo
		var names = ByteArrayArray.create()
		var members = ByteArrayArray.create()
		var q = parenPos
		if self.kindAt(q) != TokenKind.leftParen 'noParens'
			return InnerAliasParamInfo.create(names, members: members)
		end 'noParens'
		q = q + 1
		if self.kindAt(q) == TokenKind.rightParen 'noParams'
			return InnerAliasParamInfo.create(names, members: members)
		end 'noParams'

		while true 'params'
			names.push(self.tokenAt(q).value)
			let typeStart = q + 1
			let typeEnd = self.skipParamType(typeStart)
			members.push(self.innerAliasMemberOfParamType(typeStart, typeEnd: typeEnd))
			if self.kindAt(typeEnd) != TokenKind.comma 'endList'
				return InnerAliasParamInfo.create(names, members: members)
			end 'endList'
			q = typeEnd + 1
		end 'params'
		panic("innerAliasParamsIn: the parameter loop only exits by returning at the closing `)` or at EOF")
	end 'innerAliasParamsIn'

	// The bare inner-alias MEMBER a parameter type spanning `[typeStart, typeEnd)` names (P1.6-C), or
	// `EmptySourceText`. A SINGLE identifier (`typeEnd == typeStart + 1`) in `enclosingInnerAliases` is a bare
	// inner alias (`Idx`); anything else — a `T`, a plain alias, a qualified `Inst.Idx`, a `function(…)` — is
	// not one and reads as empty.
	function innerAliasMemberOfParamType(typeStart TokenIndex, typeEnd TokenIndex) returns ByteArray
		if typeEnd == typeStart + 1 and self.kindAt(typeStart) == TokenKind.identifier and self.enclosingInnerAliases.contains(self.tokenAt(typeStart).value) 'innerAlias'
			return self.tokenAt(typeStart).value
		end 'innerAlias'
		return EmptySourceText
	end 'innerAliasMemberOfParamType'

	// Advance past ONE parameter's TYPE — from the token AFTER the parameter's name to the token that
	// ENDS the type: the `,` before the next parameter, the `)` closing the list, or EOF on a malformed
	// list. Balanced over nested `(...)` (a `function(…)`-typed parameter).
	function skipParamType(fromType TokenIndex) returns TokenIndex
		var q = fromType
		var depth = 0
		while true 'skip'
			let kind = self.kindAt(q)
			if kind == TokenKind.eof 'malformed'
				return q
			end 'malformed'
			if kind == TokenKind.leftParen 'openType'
				depth = depth + 1
			end 'openType'
			if kind == TokenKind.rightParen 'closeType'
				if depth == 0 'endList'
					return q
				end 'endList'
				depth = depth - 1
			end 'closeType'
			if kind == TokenKind.comma and depth == 0 'nextParam'
				return q
			end 'nextParam'
			q = q + 1
		end 'skip'
		panic("skipParamType: the loop only exits by returning at `,`, `)` or EOF")
	end 'skipParamType'

	// The name a `function <nameTok>` is DECLARED under: its own, at file scope; `Point.create`
	// inside `type Point`.
	//
	// It reads `enclosingType`, which BOTH the sweep and the real parse set (see that field), so
	// the key the index records and the key the `IrFunction` carries are one name derived one way.
	// The alternative — the sweep recording `create` and the parse declaring `Point.create` — is
	// not a subtle failure: every call would report E3004 against a name nothing declared.
	function declaredMethodName(nameTok Token) returns ByteArray
		if self.enclosingType.isEmpty() 'freeFunction'
			return nameTok.value
		end 'freeFunction'
		return qualifiedMethodName(self.enclosingType, methodName: nameTok.value)
	end 'declaredMethodName'

	// Cursor is AT `typealias`. Append the alias the declaration names, if it is well-formed enough
	// to read one off.
	//
	// TOLERANT, exactly as `recordScannedSignature` is, and for the same reason: a malformed alias
	// is the REAL parse's to report, with a position; a sweep that could veto would reject a correct
	// program the moment it failed to recognize something the parser accepts.
	//
	// It reads through `readTypeAliasDeclaration` — the very routine the real parse reads with — so
	// the sweep and the parse cannot drift into two opinions of what a range MEANS. That shared
	// routine consumes the `typealias` keyword before it can fail, so the cursor always advances and
	// the caller's loop cannot spin.
	//
	// The FORM it read is discarded here alone: the sweep's job is the registries, and the type-name
	// collision the form feeds is decided at the merge from the REAL parse's artifact (whose position
	// is the one a diagnostic must be anchored on).
	function recordScannedTypeAlias(aliases RangedTypeAliasArray, functionAliases FunctionTypeAliasArray, genericAliases GenericAliasEntryArray)
		_ = try self.readTypeAliasDeclaration(aliases, functionOut: functionAliases, genericOut: genericAliases, buildFunctionDisplay: false) otherwise return
	end 'recordScannedTypeAlias'

	// Cursor is AT `type`. Append the struct it declares, plus a `FuncReturnTypeEntry` for each
	// method it declares, and leave the cursor PAST the declaration's `end`.
	//
	// TOLERANT, exactly as `recordScannedSignature` and `recordScannedTypeAlias` are, and for the
	// same reason: a malformed `type` is the REAL parse's to report, with a position. It shares
	// `readTypeHeader`, `atStructFieldKeyword`, `readStructFieldInto` and `recordScannedSignature`
	// with `parseTypeDeclaration`, so the sweep and the parse cannot drift on what a field IS, what
	// a method is CALLED, or where the declaration ENDS — the three facts they must agree on,
	// because the layout THIS pass records is the one the real parse reads every offset out of.
	//
	// ⚠ IT WALKS THE BODY ITSELF rather than letting the caller's loop do it, and the reason is the
	// depth-0 gate on fields: `export var x as Integer` is a FIELD at the type's top level and a
	// LOCAL BINDING one level down, and only a counter that knows where the type's body starts can
	// tell them apart. `depth` here is relative to the body — 0 is directly inside it — and
	// `blockDepthAfter` is the same opener/closer rule the caller counts with, so a method's `if`
	// and `while` nest correctly and its `end` cannot be mistaken for the type's.
	function recordScannedType(structs StructLayoutArray, entries FuncReturnTypeEntryArray, paramConsumes ParamConsumeEntryArray, throwsEntries ThrowsClauseEntryArray, innerAliasOut InnerAliasEntryArray, genericAliasOut GenericAliasEntryArray, methodInnerAliasParamOut MethodInnerAliasParamEntryArray)
		let nameTok = try self.readTypeHeader() otherwise return
		self.enclosingType = nameTok.value

		var layout = StructLayout.create(nameTok.value)
		// `uses T` (P1.6-A) — parsed here, in the tolerant sweep, exactly as `parseTypeDeclaration` does
		// it, so the scanned layout carries the SAME parameter list the real parse reads a field's
		// `typeParameter(pos)` against. The cursor lands past the clause, at the type body the loop walks.
		self.openTypeParamScope(layout)

		// The cursor now sits at the type body's first token — captured for the transitive array-feed post-pass
		// (P1.7 slice 3b-iv), which re-walks the body once EVERY method's parameter list is known. `feedStart` marks
		// the point in `paramConsumes` this type's own entries begin, so that post-pass patches only them.
		let bodyStart = self.pos
		let feedStart = paramConsumes.count()

		var depth = 0 as BlockDepth
		while not self.isEof() 'body'
			if depth == 0 and self.at(TokenKind.end) 'closesType'
				self.advance()
				self.skipOptionalLabel()
				break
			end 'closesType'

			// A NESTED (inner) typealias (P1.6-C / P1.7 slice 3b-i). Gated on depth 0 so a `typealias` inside a
			// method body is left to the outer walk. Read into `enclosingInnerAliases` (so the rest of the body's
			// bare references resolve while the sweep is still building the whole-program index) AND keyed
			// whole-program — a RANGED alias by `base.member` into `innerAliases`, a GENERIC-INSTANCE alias
			// (`Array with T`) under its base-qualified name into `genericAliases` (so `Container.ElementArray`
			// resolves the way a top-level `IntBox` does, and stays distinct from another type's `ElementArray`).
			// Tolerant, like `readStructFieldInto`: a malformed nested alias is the real parse's to report, and
			// stopping here leaves the remaining tokens to the robust outer walk.
			if depth == 0 and self.atNestedTypeAlias() 'isInnerAlias'
				if self.at(TokenKind.export) 'exportedInnerAlias'
					self.advance()
				end 'exportedInnerAlias'
				let nested = try self.readNestedTypeAlias() otherwise break
				match nested 'nested'
					ranged(alias) then innerAliasOut.push(InnerAliasEntry.create(self.enclosingType, alias: alias))
					genericInstance(entry) then genericAliasOut.push(self.qualifiedInnerGenericAlias(entry))
				end 'nested'
				continue
			end 'isInnerAlias'

			// `where T is <Interface> …` (P1.7a slice 2a) at the type's top level — recorded on the swept
			// layout so `ProgramSignatures.recordStruct` hashes the constraints and the witness lowering /
			// E3017 read them off `structOf` (the sweep's layout is the whole-program one). Handled here in
			// the body loop rather than pre-consumed after `openTypeParamScope`, so it lands whether or not an
			// `implements` clause (which the loop tolerantly skips token-by-token) precedes it. Tolerant, like
			// `readStructFieldInto`: a malformed `where` is the real parse's to report.
			if depth == 0 and self.at(TokenKind.where) 'isWhere'
				layout.recordWhereConstraints(try self.readWhereClause() otherwise break)
				continue
			end 'isWhere'

			if depth == 0 and self.atStructFieldKeyword() 'isField'
				// A field the sweep cannot read leaves the layout SHORT, which would put every later
				// field at the wrong offset — so the scan stops rather than recording a layout it
				// knows is wrong. The real parse reports the malformed declaration properly.
				try self.readStructFieldInto(layout) otherwise break
				continue
			end 'isField'

			// A method DECLARATION, asked through the same `functionDeclarationAt` the outer sweep asks:
			// a closure literal in a method body spells `function` too, and counting it here overshoots
			// the type's `end` — the sweep then reads the NEXT declaration's members into THIS layout.
			if self.functionDeclarationAt(self.pos) 'isMethod'
				// The method opens a block closed by its own `end`. Counted BEFORE the signature is
				// read, because reading it moves the cursor past the `function` keyword — the caller's
				// loop does exactly this, for exactly this reason.
				depth = depth + 1
				self.advance()
				self.recordScannedSignature(entries, paramConsumes: paramConsumes, throwsEntries: throwsEntries, methodInnerAliasParamOut: methodInnerAliasParamOut)
				continue
			end 'isMethod'

			depth = self.blockDepthAfter(depth)
			self.advance()
		end 'body'

		// Close the array-feed relation over self-call forwards (P1.7 slice 3b-iv) now every method's parameter list
		// is scanned — marking a forwarder's parameter a feed so its OWN concrete call site consumes the managed
		// argument, exactly as the directly-pushing method's does. Runs before `closeTypeParamScope` so
		// `enclosingType`/`enclosingTypeParams` still name this type.
		self.recordTransitiveArrayFeeds(paramConsumes, bodyStart: bodyStart, feedStart: feedStart)

		structs.push(layout)
		self.closeTypeParamScope()
	end 'recordScannedType'

	// ⭐ **CONSUME A WHOLE `interface` DECLARATION IN THE TOLERANT SWEEP (P1.7a slice 1)** — the twin of
	// `recordScannedType`/`recordScannedEnum`, and it MUST walk the body itself for a sharp reason: an
	// interface method is a `function` SIGNATURE with NO body and NO `end`. Left to the sweep's outer loop,
	// each would trip the `function` arm — registering the method as a free function AND incrementing the
	// block-depth counter with no matching `end` to decrement it, corrupting the scan for the rest of the
	// file. So the whole declaration is consumed here, records NOTHING (the real parse builds
	// `project.interfaces`, and the conformance check reads that), and lands the cursor past the closing
	// `end`. An interface body opens no blocks, so the FIRST `end` closes it.
	function recordScannedInterface()
		try self.consume(TokenKind.interface) otherwise return
		while not self.isEof() 'body'
			if self.at(TokenKind.end) 'closes'
				self.advance()
				self.skipOptionalLabel()
				return
			end 'closes'
			self.advance()
		end 'body'
	end 'recordScannedInterface'

	// Cursor is AT `enum`/`union`. Append the enum/union it declares and leave the cursor PAST the
	// declaration's `end` — `recordScannedType`'s twin.
	//
	// TOLERANT, for `recordScannedType`'s reason: a malformed enum is the REAL parse's to report,
	// with a position. It shares `readEnumCaseInto` and `atEnumBodyEnd` with `parseEnumDeclaration`,
	// so the sweep and the parse cannot drift on how a case's TAG is assigned — the fact the parser
	// reads back at every `Color.red` and every `match`. `readEnumCaseInto` consumes the keyword
	// before it can fail (below), so the cursor always advances and the caller's loop cannot spin.
	//
	// It walks the body ITSELF (like `recordScannedType`) rather than letting the caller's loop do
	// it: a case named `end` means only `atEnumBodyEnd`'s label-lookahead rule can tell the
	// terminator from a case, which the caller's generic `blockDepthAfter` cannot.
	function recordScannedEnum(enums EnumLayoutArray, isUnion bool)
		try self.consume(TokenKind.union if isUnion else TokenKind.enum) otherwise return
		let nameTok = try self.consume(TokenKind.identifier) otherwise return
		try self.skipOptionalImplementsClause() otherwise return

		var layout = EnumLayout.create(nameTok.value, isUnion: isUnion)
		var state = EnumBackingState.create()

		while not self.isEof() 'body'
			self.skipNewlines()
			if self.atEnumBodyEnd() 'closes'
				self.advance()
				self.skipOptionalLabel()
				break
			end 'closes'

			// A method (`function <name>(`) — stop, tolerantly; the real parse rejects it with a
			// position. `function` ALONE is a legal case name, so only a real method-start stops here.
			if self.atEnumMethodStart() 'method'
				break
			end 'method'

			// A case the sweep cannot read leaves the layout SHORT, which would misassign every later
			// case's tag — so the scan stops rather than recording a layout it knows is wrong.
			try self.readEnumCaseInto(layout, state: state) otherwise break
		end 'body'

		enums.push(layout)
	end 'recordScannedEnum'

	// `type <Name>` — the two tokens every type declaration opens with, read by BOTH the tolerant
	// sweep and the real parse. One reader, so the two can never disagree about what a type is
	// CALLED, which is the name every method of it is declared under and every use of it resolves
	// through.
	function readTypeHeader() returns Token throws ParseError
		try self.consume(TokenKind.type)
		return try self.consume(TokenKind.identifier)
	end 'readTypeHeader'

	// ⭐ **OPEN A GENERIC TYPE'S PARAMETER SCOPE (P1.6-A)** — `type Box uses T` / `type Pair uses A, B`.
	// Called by BOTH `parseTypeDeclaration` and the tolerant sweep `recordScannedType` right after
	// `readTypeHeader`, so the two record the SAME parameter list (the one a field's `typeParameter(pos)`
	// is meaningful against). It sets `self.enclosingTypeParams` — how `parseTypeReference` recognizes a
	// bare `T` — and stamps the names onto the layout so the whole-program arity check can read them off
	// `structOf`. The cursor lands past the clause (at the type body); a type with no `uses` leaves the
	// list empty and consumes nothing.
	//
	// Commas separate the names (`uses A, B`), NO parentheses (the oracle's grammar). The loop stops at
	// the first non-identifier (a newline opening the body), exactly as a top-level `uses` clause does.
	function openTypeParamScope(layout StructLayout)
		// The inner-alias name set is per-TYPE (P1.6-C) — reset here so a sibling type's `Idx` cannot leak into
		// this one, and reset BEFORE the non-generic early return so every type body starts fresh. Points at the
		// SHARED empty set until a nested typealias is recorded (`readNestedRangedAlias` copy-on-writes), so a
		// type that declares none allocates nothing.
		self.enclosingInnerAliases = sharedEmptyInnerAliases
		// The `where`-constraint list is per-TYPE (P1.7a slice 2a), reset here for `enclosingInnerAliases`'
		// reason: a sibling type's constraints must not leak into this one. Points at the SHARED empty until
		// `readWhereClause` builds a real list, so an unconstrained type allocates nothing.
		self.enclosingWhereConstraints = sharedEmptyWhereConstraints

		// A NON-GENERIC type allocates nothing: it keeps the layout's create-time empty `typeParamNames`
		// and points the parser's enclosing scope at the shared empty list. Only a `uses` clause builds a
		// real list — which is the rare case, and absent from the scale corpus entirely.
		if not self.at(TokenKind.uses) 'noUses'
			self.enclosingTypeParams = self.emptyTypeParams
			return
		end 'noUses'

		var names = ByteArrayArray.create()
		self.advance()
		while self.at(TokenKind.identifier) 'usesLoop'
			let paramTok = self.current()
			self.advance()
			names.push(paramTok.value)
			if not self.at(TokenKind.comma) 'doneUses'
				break
			end 'doneUses'
			self.advance()
		end 'usesLoop'
		self.enclosingTypeParams = names
		layout.recordTypeParams(names)
	end 'openTypeParamScope'

	// Close the enclosing-type scope (P1.6-A) — clears both `enclosingType` and `enclosingTypeParams`
	// in lockstep, so a sibling type at file scope starts fresh and a bare `T` outside a generic body
	// resolves as an ordinary named type, not a stale parameter. Restores the SHARED empty list rather
	// than a fresh one, so closing a type scope allocates nothing.
	function closeTypeParamScope()
		self.enclosingType = EmptySourceText
		self.enclosingTypeParams = self.emptyTypeParams
		// Restored to the SHARED empty in lockstep (P1.6-C) so a bare `Idx` at file scope, after a type that
		// declared one, resolves as an ordinary named type rather than a stale inner alias — and allocates
		// nothing, exactly as `emptyTypeParams` restores.
		self.enclosingInnerAliases = sharedEmptyInnerAliases
		// Restored in lockstep (P1.7a slice 2a) so a dispatch outside a constrained type body resolves against
		// no stale constraints — and allocates nothing, exactly as `emptyTypeParams` restores.
		self.enclosingWhereConstraints = sharedEmptyWhereConstraints
	end 'closeTypeParamScope'

	// ⭐ **PARSE A `where <T> is <Interface> [and <Interface>]… [, <U> is …]…` CLAUSE (P1.7a slice 2a).** The
	// cursor sits on `where`. Each `<param> is <Interface>` records a `WhereConstraint`, in SOURCE ORDER —
	// and that order is the witness-slot order the dictionary-passing ABI threads, so it must be stable
	// between the tolerant sweep and the real parse (both call this). A conjunction `is A and B` and a comma
	// list `T is A, U is B` each flatten to one entry per (param, interface) pair. The constrained parameter
	// is resolved to its `uses`-list INDEX against `enclosingTypeParams` (set by `openTypeParamScope`); a name
	// that is not a declared type parameter is rejected — a `where` on a non-parameter has no witness slot to
	// fill. Returns the (possibly empty) constraint list; the caller records it on the layout.
	function readWhereClause() returns WhereConstraintArray throws ParseError
		try self.consume(TokenKind.where)
		var constraints = WhereConstraintArray.create()

		while true 'params'
			let paramTok = try self.consume(TokenKind.identifier)
			let paramIndex = self.typeParamPositionOf(paramTok.value)
			if paramIndex >= self.enclosingTypeParams.count() 'notTypeParam'
				throw ParseError.unsupported("a `where` clause constrains '{String.from(paramTok.value)}', which is not a type parameter of this type — a constraint must name one of its `uses` parameters", line: paramTok.line, column: paramTok.column)
			end 'notTypeParam'
			try self.consume(TokenKind.is)

			while true 'interfaces'
				let ifaceTok = try self.consume(TokenKind.identifier)
				constraints.push(WhereConstraint.create(paramIndex, interfaceName: ifaceTok.value))
				if not self.at(TokenKind.and) 'doneInterfaces'
					break
				end 'doneInterfaces'
				self.advance()
			end 'interfaces'

			if not self.at(TokenKind.comma) 'doneParams'
				break
			end 'doneParams'
			self.advance()
		end 'params'

		return constraints
	end 'readWhereClause'

	// Is the cursor on a FIELD declaration — `[export] (let|var) <name> as <Type>`?
	//
	// It defers to `atTopLevelBindingKeyword` for the keyword test rather than respelling it, for
	// that predicate's own reason: `let` and `var` introduce a binding in three places now (file
	// scope, a type body, a function body), and a keyword taught to one spelling and not another
	// would put two readers of one grammar a token apart.
	function atStructFieldKeyword() returns bool
		if self.at(TokenKind.export) 'exported'
			return self.kindAt(self.pos + 1) == TokenKind.let or self.kindAt(self.pos + 1) == TokenKind.var
		end 'exported'
		return self.atTopLevelBindingKeyword()
	end 'atStructFieldKeyword'

	// Read one field declaration into `layout`. THE one field reader, shared by the sweep and the
	// real parse, so `StructLayout`'s field ORDER (which IS the box's slot order — see
	// `StructLayout.offsetOfField`) is read exactly once from one grammar. Two readers would be free
	// to disagree about how many fields a type has, and the one that was wrong would place every
	// later field at the wrong offset: a silent out-of-bounds read, not a compile error.
	//
	// **THE THREE LEGAL SHAPES**, and the `as` is what tells them apart:
	//
	//   1. `export var x as Integer`     — annotated, no default. A literal must supply it (E3086).
	//   2. `export var x = 0`            — the literal supplies BOTH the value and the TYPE.
	//   3. `export var x as Integer = 0` — annotated AND defaulted; the literal is checked against
	//                                      the annotation.
	//
	// Neither `as` nor `=` is E2010 — the `consume(equals)` below reporting the token it wanted.
	//
	// **TWO KEYWORDS, TWO BITS, AND BOTH ARE KEPT.** `let` vs `var` decides FIELD MUTABILITY
	// (`c.version = 2` on a `let` field is E2013 — `StructLayout.fieldMutable`); `export` decides
	// FIELD VISIBILITY (`v.private` from outside `type Value` is E3014 —
	// `StructLayout.fieldExported`, read by `requireFieldAccessible`). They ride the same
	// `addField` call, which is the one writer of every column.
	//
	// ⚠ The `export` bit was CONSUMED AND DROPPED until P1.1a wave 3, and the reason this comment
	// gave for dropping it was false twice over. It said *"field visibility gates cross-FILE access
	// (E3014), and shv2 has no cross-file name resolution to gate"* — but visibility gates access
	// from outside the TYPE, in the same file (measured: `type B` reading `type A`'s unexported
	// field is E3014 on the bootstrap), so the bit always had a live consumer and shv2 silently
	// accepted a program the language rejects. It is kept now, and the rung that reads it is the
	// one that ported `specs/export-var-fields.md`'s two `error.unexported-field-*` cases.
	function readStructFieldInto(layout StructLayout) throws ParseError
		let exported = self.at(TokenKind.export)
		if exported 'isExported'
			self.advance()
		end 'isExported'

		let mutable = self.at(TokenKind.var)
		try self.consume(TokenKind.var if mutable else TokenKind.let)

		let nameTok = try self.consume(TokenKind.identifier)
		// A `__`-prefixed field is reserved. This reader is shared with the tolerant sweep
		// (`recordScannedType`), which swallows the throw (`otherwise break`) and leaves the positioned
		// diagnostic to the real parse — the sweep is not a validator.
		try self.requireUnreservedName(nameTok)

		if not self.at(TokenKind.as) 'typeFromLiteral'
			// Shape 2. There is no annotation to read the type off, so the literal's TOKEN KIND is
			// the whole of the type inference — see `readFieldDefaultLiteral`.
			try self.consume(TokenKind.equals)
			let inferred = try self.readFieldDefaultLiteral()
			layout.addField(nameTok.value, declaredType: constantValueType(inferred.tag), mutable: mutable, exported: exported, defaultValue: FieldDefault.literal(inferred.payload, tag: inferred.tag))
			return
		end 'typeFromLiteral'

		try self.consume(TokenKind.as)
		let fieldType = try self.parseTypeReference()

		if not self.at(TokenKind.equals) 'noDefault'
			layout.addField(nameTok.value, declaredType: fieldType, mutable: mutable, exported: exported, defaultValue: FieldDefault.none)
			return
		end 'noDefault'

		// Shape 3. The ANNOTATION is the field's type and the literal must agree with it: `as
		// Integer = 50.0` is the same lossy coercion `var x as Integer` then `x = 50.0` is, so it
		// asks the same rule (`requireAssignable`) rather than a second opinion about floats.
		//
		// **THE LITERAL IS RECORDED EXACTLY AS WRITTEN — payload AND tag, unconverted.** The widening a
		// `float` field's `= 3` needs is paid at the ONE place a default becomes a value
		// (`fillFieldDefault`), off the tag recorded here. It cannot be paid at this line: the declaration
		// SWEEP shares this reader and may not resolve `fieldType` when it is a ranged-alias NAME, yet it is
		// the SWEEP's layout a `Self{…}` reads its defaults out of — so a conversion decided here would be
		// decided blind for exactly the fields that need it, and written into the wrong copy besides.
		try self.consume(TokenKind.equals)
		let given = try self.readFieldDefaultLiteral()
		try self.requireFieldDefaultType(nameTok, fieldType: fieldType, given: given)
		layout.addField(nameTok.value, declaredType: fieldType, mutable: mutable, exported: exported, defaultValue: FieldDefault.literal(given.payload, tag: given.tag))
	end 'readStructFieldInto'

	// ⭐ **THE VERDICT ON A FIELD'S LITERAL DEFAULT, ASKED ONLY WHERE IT CAN BE ANSWERED.** `as Integer =
	// 50.0` is the same lossy coercion `var x as Integer` then `x = 50.0` is, so it is the same
	// `requireAssignable` — but the DECLARED type may be a ranged-alias NAME, and a name reads as an
	// INTEGER (`tagIsIntegral`) until the alias registry can resolve it.
	//
	// ⚠ **`allFilesFolded` IS THE GATE**, the same one `checkGenericArgType` and `checkGenericInstance` sit
	// behind and for the identical reason: during the sweep this index is still being BUILT
	// (`Queries.queryProgramSignatures` hands the sweeper the index it is filling), so an alias that is
	// genuinely a `float(low to high)` reads as undeclared and the verdict is not merely discarded, it is
	// systematically WRONG — `as Weight = 2.5` would be refused as a lossy float→int conversion, which is
	// a rejection of legal code. The sweep is not a validator; the real parse is the only reader that
	// reports, and it is on the far side of the fold, so it resolves the alias and decides.
	function requireFieldDefaultType(nameTok Token, fieldType MaxonType, given ConstValue) throws ParseError
		if not self.signatures.allFilesFolded 'indexStillBuilding'
			return
		end 'indexStillBuilding'

		try self.requireAssignable(nameTok, value: given.tag, declared: self.floatResolvedTag(maxonTypeTag(fieldType), nameId: typeNameIdOf(fieldType)), noun: "field")
	end 'requireFieldDefaultType'

	// The literal a field default is, as the SAME tagged pair the constant evaluator speaks in — its
	// VALUE and its TAG, off one token, returned together so a caller cannot read one without the
	// other. `constantValueType` turns the tag into the field's declared type, which is the point:
	// shape 2 above derives that type from nothing but this token.
	//
	// It is a `ConstValue` and not a private record because it IS one — payload plus tag — and the
	// tag→`MaxonType` mapping already exists for the other producer of folded literals. A second
	// pair would have been a second answer to "what type is an integer literal".
	//
	// ⭐ **TYPE INFERENCE HERE IS A TOKEN-KIND LOOKUP, NOT CONSTANT EVALUATION**, and it has to be:
	// the type must be known when `ProgramSignatures.recordStruct` hashes the layout, and that runs
	// inside the declaration SWEEP — before `evaluateInitializers` has folded a single constant. A
	// token kind is available at scan time; a constant's value is not. (v1 infers it the same way,
	// from the same three token kinds: `inferShorthandFieldType`, Parser.maxon:3634-3665.)
	//
	// The three literal DECODERS are the emitting path's own (`intLiteralValue`, `parseFloatBits`,
	// `BoolTrueValue`) — the same ones `evalConstIntLiteral` and friends call, for their stated
	// reason: a field default must read a literal exactly as a function body reads it.
	function readFieldDefaultLiteral() returns ConstValue throws ParseError
		let negated = self.at(TokenKind.minus)
		if negated 'signed'
			self.advance()
		end 'signed'

		if self.at(TokenKind.intLiteral) 'intLit'
			let tok = try self.consume(TokenKind.intLiteral)
			return ConstValue.create(try self.intLiteralValue(tok, negated: negated), tag: ValueTypeTag.integer)
		end 'intLit'

		if self.at(TokenKind.floatLiteral) 'floatLit'
			let tok = try self.consume(TokenKind.floatLiteral)
			let bits = try self.floatLiteralBits(tok)
			return ConstValue.create(negatedFloatBits(bits) if negated else bits, tag: ValueTypeTag.float)
		end 'floatLit'

		if self.at(TokenKind.true) or self.at(TokenKind.false) 'boolLit'
			return try self.readBoolFieldDefault(negated)
		end 'boolLit'

		// Everything else — `= pick()`, `= 2 + 3`, `= OTHER`. See `rejectNonLiteralFieldDefault`.
		throw self.rejectNonLiteralFieldDefault()
	end 'readFieldDefaultLiteral'

	// `= true` / `= false`. A leading `-` is not a sign here — there is no negative bool — so it is
	// rejected as the non-literal it is rather than silently ignored.
	function readBoolFieldDefault(negated bool) returns ConstValue throws ParseError
		if negated 'negatedBool'
			throw self.rejectNonLiteralFieldDefault()
		end 'negatedBool'

		let isTrue = self.at(TokenKind.true)
		self.advance()
		return ConstValue.create(BoolTrueValue if isTrue else BoolFalseValue, tag: ValueTypeTag.boolean)
	end 'readBoolFieldDefault'

	// ⚠ **A NON-LITERAL DEFAULT IS DEFERRED, AND IT IS DEFERRED LOUDLY** — positioned at the token
	// that is not a literal, naming the mechanism that is missing.
	//
	// ⚠ **THIS OVER-REJECTS, DELIBERATELY. THE BOOTSTRAP ACCEPTS IT** (measured: `export var x as
	// Integer = pick()` compiles, and the field arrives holding 4). A default is an arbitrary
	// expression there, evaluated at CONSTRUCTION — v1 implements it by synthesizing a nullary
	// `__field_init_*` function per default and splicing a call into every literal
	// (Parser.maxon:15885-15893). That machinery needs the initializer captured at the declaration
	// and replayed at each construction site, and it has ZERO reachable consumers at this rung:
	// every corpus case that wants it also wants Array (P1.7), String (P1.2) or a struct-typed
	// field. Building it now would be a mechanism with no consumer — this ladder's founding error,
	// made four times on P1.0r — so the rung takes the literal every enabled case actually needs,
	// and says plainly that the rest is not here yet.
	function rejectNonLiteralFieldDefault() returns ParseError
		let tok = self.current()
		return ParseError.unsupported("'{tok.kind.rawValue}' as a field default (only a LITERAL default is parsed — `= 5`, `= 50.0`, `= true`, optionally signed. An arbitrary expression is evaluated once per struct literal, which needs the initializer captured at the declaration and replayed at every literal that omits the field, and arrives with the rung that has a case needing one)", line: tok.line, column: tok.column)
	end 'rejectNonLiteralFieldDefault'

	// Advance past a balanced `( … )` starting at the cursor. Returns false — leaving the
	// cursor where it stopped — when the token stream does not hold one, which the real
	// parse will report properly. Depth-counted rather than "scan to the first `)`" because
	// a parameter's type can itself carry parentheses (`int(0 to 100)`).
	function skipBalancedParens() returns bool
		if not self.at(TokenKind.leftParen) 'noParen'
			return false
		end 'noParen'
		var depth = 0
		while not self.isEof() 'scan'
			if self.at(TokenKind.leftParen) 'open'
				depth = depth + 1
			end 'open' else if self.at(TokenKind.rightParen) 'close'
				depth = depth - 1
			end 'close'
			self.advance()
			if depth == 0 'balanced'
				return true
			end 'balanced'
		end 'scan'
		return false
	end 'skipBalancedParens'

	// One top-level declaration: an optional `export`, then a `function`, a `typealias` in any of its
	// three forms, a `type`, an `enum`, a `union`, an `interface`, or a `let`/`var` binding. Everything
	// else (`extension`, ...) is out of the slice and rejected with a positioned error.
	//
	// `visibility` is consumed by `parseFunction` and by `readTopLevelBinding`. A typealias carries
	// one too, and it is still deliberately DROPPED — but no longer because nothing scopes aliases.
	// `RangedAliasRegistry` resolves them per declaring FILE; what it does not do is let visibility
	// decide REACHABILITY, because `specs-shv2/ranged-typealias.md`'s `cast-to-stdlib-internal-typealias`
	// requires a stdlib alias to be nameable from any file "regardless of its source-level visibility
	// modifier". So an alias is filed under both keys, visibility is read by nobody, and recording it
	// would still be a field nothing reads. It becomes load-bearing with E3063 / cross-file name
	// resolution, which is where `export` gets its meaning as a key.
	//
	// A `type`'s visibility is dropped for the reason a typealias's USED to be — `project.structTypes`
	// is whole-program — which is why `parseTypeDeclaration` does not take one. Its METHODS each carry
	// their own, read at the member (see `parseTypeMember`), because that is where the source writes it.
	function dispatchTopLevel() throws ParseError
		var visibility = Visibility.file
		if self.at(TokenKind.export) 'exported'
			self.advance()
			visibility = Visibility.module
		end 'exported'

		// ⭐ **THE ONE PLACE THAT SEES ALL FIVE TYPE-MINTING KEYWORDS**, which is why the type-name
		// declaration record is taken here and not inside each of the five parsers: the record's whole
		// value is that its ORDER is the file's source order ACROSS kinds, and no per-kind site can
		// know that. The name token sits one past the keyword in every one of the five grammars, so its
		// INDEX is captured before the dispatch (each of those parsers leaves the cursor past its own
		// `end`) and the token itself is fetched only on the paths that record one — a `function` or a
		// `let` pays a scalar add and nothing else. The record is pushed only if the declaration
		// PARSED: a malformed one is the ParseError's, and must not claim a name.
		let nameIndex = self.pos + 1

		if self.at(TokenKind.function) 'isFunction'
			// A FILE-scope function takes no receiver: there is no enclosing type for one to be.
			try self.parseFunction(visibility, takesReceiver: false)
		end 'isFunction' else if self.at(TokenKind.typealias) 'isTypeAlias'
			let form = try self.readTypeAliasDeclaration(self.artifact.typeAliases, functionOut: self.artifact.functionTypeAliases, genericOut: self.genericAliasScratch, buildFunctionDisplay: true)
			self.recordTypeName(nameIndex, kind: form)
		end 'isTypeAlias' else if self.at(TokenKind.type) 'isTypeDecl'
			try self.parseTypeDeclaration()
			self.recordTypeName(nameIndex, kind: TypeDeclKind.structType)
		end 'isTypeDecl' else if self.at(TokenKind.enum) or self.at(TokenKind.union) 'isEnumDecl'
			let isUnion = self.at(TokenKind.union)
			try self.parseEnumDeclaration(isUnion)
			self.recordTypeName(nameIndex, kind: TypeDeclKind.unionType if isUnion else TypeDeclKind.enumType)
		end 'isEnumDecl' else if self.at(TokenKind.interface) 'isInterfaceDecl'
			try self.parseInterfaceDeclaration()
			self.recordTypeName(nameIndex, kind: TypeDeclKind.interfaceType)
		end 'isInterfaceDecl' else if self.atTopLevelBindingKeyword() 'isBinding'
			// The declaration EMITS NOTHING — for a `var` exactly as for a `let`. A constant inlines at
			// every read; a var's slot is laid down by the backend from the arena
			// (`ProgramSignatures.declaredGlobals`), and its every read and write is emitted at the USE
			// site. So there is nothing for the real parse to build here either way, only something for
			// it to REPORT.
			let decl = try self.readTopLevelBinding(visibility)
			try self.raiseBindingFailure(decl)
		end 'isBinding' else 'unsupported'
			let tok = self.current()
			throw ParseError.unsupported("top-level {tok.kind.rawValue}", line: tok.line, column: tok.column)
		end 'unsupported'
	end 'dispatchTopLevel'

	// File the type name a top-level declaration just minted, for the whole-program duplicate check
	// `commitTypeNameDecls` makes at the merge. The position is the NAME token's — the collision blames
	// the declaration the author wrote, never the keyword and never the incumbent. Takes the token's
	// INDEX rather than the token, because the cursor has already moved past the declaration by the
	// time this is called and `dispatchTopLevel` must not pay for a token it may never record.
	function recordTypeName(nameIndex TokenIndex, kind TypeDeclKind)
		let nameTok = self.tokenAt(nameIndex)
		self.artifact.recordTypeNameDecl(TypeNameDecl.create(nameTok.value, kind: kind, declFilePath: self.filePath, nameLine: nameTok.line, nameColumn: nameTok.column))
	end 'recordTypeName'

	// ⭐ A TOP-LEVEL `let` IS A COMPILE-TIME CONSTANT, AND THE DECLARATION IS WHERE ITS DIAGNOSTIC
	// LANDS — but not where its VALUE is computed.
	//
	// The declaration itself emits NO op and reserves NO storage. The whole-program sweep already
	// folded this initializer to a number (`ProgramSignatures.evaluateInitializers`), and every USE
	// inlines that number as an ordinary `literal` (`topLevelConstantReference`). So there is nothing
	// left for the real parse to build — only something for it to REPORT, if the fold failed.
	//
	// That split is why the value is not simply computed here: this file's parse can see this file's
	// initializer, and neither a forward reference (`let TOTAL = FIRST + SECOND` above `FIRST`) nor a
	// cross-file `export let` is visible to it. Both are ordinary in the corpus, so the fold has to
	// happen where every declaration is already in view, and that is the sweep. v1 splits it exactly
	// here too — its parser records an unresolved initializer and TypeResolution evaluates it.
	//
	// A DECL WHOSE FOLD FAILED IS REPORTED HERE, AND EXACTLY ONCE. `poisoned` is silent on purpose —
	// its defect belongs to another declaration, which reports it (see `TopLevelConstant.poisoned`).
	//
	// `declaredOutcome` carries the DRIFT GUARD: a `let` the real parse dispatches at top
	// level must be one the sweep recorded, and a miss panics rather than compiling.
	function raiseBindingFailure(decl TopLevelDecl) throws ParseError
		// A REDECLARATION is reported HERE, at the later declaration — the top-level twin of the
		// duplicate-FUNCTION E3006 `commitFuncSignatures` raises. Checked BEFORE the outcome match
		// because a duplicate is an error independent of whether the first declaration's initializer
		// also failed: that failure reports at the FIRST declaration's own statement, this at the later.
		if self.signatures.isRedeclaredBinding(decl) 'redeclared'
			throw ParseError.duplicateTopLevelDeclaration(String.from(decl.name), line: decl.nameLine, column: decl.nameColumn)
		end 'redeclared'

		// ⚠ The outcome is bound to a LOCAL before the match, and the match's payload is bound to a
		// second one before the throw. Neither is style. Matching the CALL directly and throwing the
		// arm's binding —
		//
		//     match self.signatures.declaredOutcome(decl) 'outcome'
		//         failed(error) then throw error
		//
		// — crashes the compiled compiler with `mm_incref called with NULL pointer`, because the
		// bootstrap drops the temporary scrutinee's box while the payload it lent out is still in
		// flight. This is the sharp end of the hazard `emitShift` already documents (a `throw` of a
		// union that was RETURNED rather than constructed inline LEAKS); here it is not a leak but a
		// null-pointer panic. Recorded for OPEN.md.
		let outcome = self.signatures.declaredOutcome(decl)
		match outcome 'outcome'
			// ⭐ **NOTHING A TOP-LEVEL BINDING CAN FOLD TO IS UNSTORABLE ANY MORE** (P1.7 slice 2a). A
			// scalar occupies its `.data` slot as a value; a MANAGED one occupies it as a POINTER that
			// `__module_init` fills before `main` (see `ModuleInit`). The `requireStorableGlobal` guard
			// that used to stand here — the E2015 refusing `var s = "hi"` — is gone with the reason for
			// it, and its remaining half lives in `globalStdType`, which was already the other copy of
			// the same enumeration and is now the only one.
			value then break 'outcome'
			failed(error) then try self.throwRecordedConstantError(error)
			poisoned to arrayValue then break 'outcome'
			pending to evaluating then panic("Parser.raiseBindingFailure: top-level binding '{String.from(decl.name)}' is unevaluated — `evaluateInitializers` runs to completion inside `queryProgramSignatures`, before any file is parsed")
		end 'outcome'
	end 'raiseBindingFailure'

	// Re-raise a diagnostic the constant evaluator recorded earlier, on another file's behalf. It
	// exists only to give the borrowed payload a scope of its own — see `raiseConstantFailure`.
	function throwRecordedConstantError(error ParseError) throws ParseError
		throw error
	end 'throwRecordedConstantError'

	// Read a top-level binding declaration: `[export] (let|var) <NAME> = <constant expression>`.
	//
	// It READS and does not RECORD, for exactly `readTypeAliasDeclaration`'s reason: it has two
	// callers that record differently. The tolerant declaration sweep folds what it reads into the
	// whole-program index (`recordScannedBinding`); the real parse reads it only to ask that index
	// what the initializer came to, and to raise the answer as a POSITIONED diagnostic if it failed.
	//
	// One reader, so the sweep and the parse can never drift on where an initializer ENDS — which is
	// the one thing they must agree on, because the range this returns is the range the evaluator
	// walks. Two scanners would put the sweep's idea of the initializer and the parser's idea of it a
	// token apart, and the evaluator would fold a different expression than the one the user wrote.
	//
	// ⭐ **`let` AND `var` READ IDENTICALLY, WHICH IS WHY THIS IS ONE FUNCTION.** They differ in the
	// keyword and in nothing else: `static-variables.md` states that a top-level `var`'s initializer
	// obeys the same constant-expression rules as a `let`'s, so the same token range feeds the same
	// evaluator. The mutability is simply carried through to the decl, where it decides storage.
	function readTopLevelBinding(visibility Visibility) returns TopLevelDecl throws ParseError
		let mutable = self.at(TokenKind.var)
		try self.consume(TokenKind.var if mutable else TokenKind.let)
		let nameTok = try self.consume(TokenKind.identifier)
		try self.requireUnreservedName(nameTok)
		try self.consume(TokenKind.equals)

		let initStart = self.pos
		let initEnd = self.initializerEndIndex(initStart)
		self.pos = initEnd

		return TopLevelDecl.create(nameTok.value, mutable: mutable, visibility: visibility, declFilePath: self.filePath, tokens: self.tokens, initStart: initStart, initEnd: initEnd, nameLine: nameTok.line, nameColumn: nameTok.column)
	end 'readTopLevelBinding'

	// One past the last token of a top-level initializer: an initializer runs to the END OF ITS LINE.
	// Maxon has no statement terminator, so the newline IS the boundary — the bootstrap reads it the
	// same way (`SkipToEndOfLine`, 2-Parser.cs:1701).
	//
	// ⚠ **EXCEPT INSIDE `[…]`, WHERE A NEWLINE IS LAYOUT AND NOT A TERMINATOR.** `var xs = [10,\n\t20]`
	// is one initializer written on two lines, and the runnable oracle folds it as one; ending the range at
	// the first newline handed the evaluator `[10,` and reported `Expected expression but got 'newline'`
	// against a program the language accepts. The depth counter is what tells the two newlines apart, and it
	// is the SAME rule the element walks below apply at their own boundaries (`finishArrayLiteral`) — a
	// literal's shape must not depend on where its author pressed return.
	//
	// It cannot run away: `kindAt` answers `eof` past the end of the token array (see `tokenAt`), so
	// an unterminated last line — or an unclosed `[` — stops at the file's end rather than walking off it.
	function initializerEndIndex(start TokenIndex) returns TokenIndex
		var i = start
		var depth = 0 as BracketDepth
		while true 'scan'
			let kind = self.kindAt(i)
			if kind == TokenKind.eof 'fileEnd'
				break
			end 'fileEnd'

			if kind == TokenKind.newline and depth == 0 'lineEnd'
				break
			end 'lineEnd'

			if kind == TokenKind.leftBracket 'openBracket'
				depth = depth + 1
			end 'openBracket'

			// Guarded, because `BracketDepth` is unsigned: a stray `]` with no `[` before it would wrap the
			// counter to its maximum and the scan would swallow the rest of the FILE. Left at 0 it is simply
			// not a bracket the initializer opened, and the line's own newline still ends the range — which
			// is what the malformed initializer's diagnostic then names.
			if kind == TokenKind.rightBracket and depth > 0 'closeBracket'
				depth = depth - 1
			end 'closeBracket'

			i = i + 1
		end 'scan'

		return i
	end 'initializerEndIndex'

	// Parse a ranged typealias declaration: `typealias <Name> = int(<low> to|upto <high>)` or
	// `typealias <Name> = float(<low> to <high>)`. Nearly every real Maxon file opens with one —
	// `int` is almost never written bare in a type position (specs/ranged-typealias.md) — so this
	// is the declaration that gates most of the corpus.
	//
	// It emits NO op: an alias is a DECLARATION, and its whole effect is the registry
	// entry its caller records, which TypeResolution substitutes for every `MaxonType.named`
	// use of the name. Two aliases over the same range are therefore the SAME type — an
	// alias creates no nominal distinction — and a use in a type position needs no parser
	// change at all (`parseTypeReference` already interns a bare identifier).
	//
	// It READS and PUSHES into the caller's arrays, because it has two callers that collect differently:
	// the real parse files the alias in this file's artifact arrays, and the whole-program declaration
	// sweep folds it into its own arrays. One reader, so the two can never disagree about what a range
	// means. A typealias is EITHER a ranged numeric one (into `rangedOut`) or a FUNCTION one (into
	// `functionOut`), and pushing into the target array directly avoids boxing a discriminated-union
	// return on the per-typealias path (nearly every file opens with a `typealias`, so it is a hot one).
	//
	// The RANGE is not yet enforced as a bound: a narrowing conversion into a ranged alias is
	// checked at run time, and that check is a later milestone. It IS read, and by more than the
	// registry — a range whose low bound is 0 declares an UNSIGNED type, and that decides how every
	// `shr` on a value of it fills (TypeRules' `rangeIsUnsigned`).
	//
	// It RETURNS THE FORM it read, and that is not a convenience: the three forms denote three
	// different things and only the ranged one is resolved per declaring FILE, so a duplicate-name
	// rule has to tell them apart (`TypeNameRegistry`). The alternative — the caller inferring the
	// form from which array grew, or re-deciding it off the tokens — would be a second copy of the
	// discrimination this function already makes, which is this project's signature bug.
	function readTypeAliasDeclaration(rangedOut RangedTypeAliasArray, functionOut FunctionTypeAliasArray, genericOut GenericAliasEntryArray, buildFunctionDisplay bool) returns TypeDeclKind throws ParseError
		try self.consume(TokenKind.typealias)
		let nameTok = try self.consume(TokenKind.identifier)
		try self.requireUnreservedName(nameTok)
		try self.consume(TokenKind.equals)

		// A FUNCTION typealias — `function(paramTypes) [returns T]` (P1.5-A1). The literal `function(…)`
		// form is legal ONLY as a typealias RHS (the spec), so this is the one place it is parsed as a
		// type. It records its own registry (`FunctionTypeAlias`), not the ranged one. `buildFunctionDisplay`
		// is the real parse's signal that this alias's `#81` display string is wanted (it will be merged and
		// read by the value-merge check); the sweep and the nested-alias reader pass false.
		if self.at(TokenKind.function) 'functionAlias'
			// A function alias mints a NOMINAL identity (`resolveNamedAlias` re-tags a `named` reference to
			// `function`), so it may not take a compiler-owned type name — unlike the ranged form below, which
			// erases. See `requireTypeNameNotCompilerOwned`.
			try self.requireTypeNameNotCompilerOwned(nameTok)
			functionOut.push(try self.readFunctionTypeAlias(nameTok, buildDisplay: buildFunctionDisplay))
			return TypeDeclKind.functionAlias
		end 'functionAlias'

		// A GENERIC-INSTANCE typealias (P1.6-A) — `IntBox = Box with Integer`. Recognized by a base
		// identifier followed by `with`. It records its own registry (`GenericAliasEntry`), not the
		// ranged one, and (in the REAL parse) checks the instantiation's arity and managed arguments.
		if self.at(TokenKind.identifier) and self.kindAt(self.pos + 1) == TokenKind.with 'genericAlias'
			// A generic-instance alias mints a NOMINAL identity (`resolveNamedAlias` re-tags a `named` reference
			// to `genericInstance`, an owned heap box), the function alias's case exactly.
			try self.requireTypeNameNotCompilerOwned(nameTok)
			try self.readGenericInstanceAlias(nameTok, genericOut: genericOut)
			return TypeDeclKind.genericAlias
		end 'genericAlias'

		// `int(...)` or `float(...)`. A `bool` alias has no range, a generic alias (`Array with T`)
		// needs generics, and a bare `i64` is not legal Maxon at all — each is rejected here, naming
		// its own gap, rather than being mapped onto a numeric path where it would silently mean
		// something else. The two numeric forms differ ONLY in how their bounds read (int literals +
		// `<int>.min/.max` versus float literals + `f32`/`f64.min/.max`), so `isFloat` threads through
		// the shared bound parser rather than forking it.
		let isFloat = self.at(TokenKind.float)
		if not self.at(TokenKind.int) and not isFloat 'notNumeric'
			let tok = self.current()
			throw ParseError.unsupported("a typealias over '{tok.kind.rawValue}' (only `int(low to high)`, `float(low to high)` and `function(...)` are parsed; generic and bare-sized aliases arrive with the milestones that give them meaning)", line: tok.line, column: tok.column)
		end 'notNumeric'

		if isFloat 'consumeFloat'
			try self.consume(TokenKind.float)
		end 'consumeFloat' else 'consumeInt'
			try self.consume(TokenKind.int)
		end 'consumeInt'

		try self.consume(TokenKind.leftParen)
		let low = try self.parseRangeBound(isFloat)
		let high = try self.parseRangeUpperBound(isFloat)
		try self.consume(TokenKind.rightParen)

		let underlying = MaxonType.float if isFloat else MaxonType.integer
		rangedOut.push(RangedTypeAlias.create(nameTok.value, underlying: underlying, low: low, high: high, declFilePath: self.filePath, nameLine: nameTok.line, nameColumn: nameTok.column))

		return TypeDeclKind.rangedAlias
	end 'readTypeAliasDeclaration'

	// Is the cursor at a nested typealias declaration inside a type body (P1.6-C) — `typealias …` or the
	// `export typealias …` the spec writes? A peek only; the caller consumes.
	function atNestedTypeAlias() returns bool
		if self.at(TokenKind.export) 'exported'
			return self.kindAt(self.pos + 1) == TokenKind.typealias
		end 'exported'
		return self.at(TokenKind.typealias)
	end 'atNestedTypeAlias'

	// ⭐ **READ ONE NESTED (INNER) TYPEALIAS (P1.6-C / P1.7 slice 3b-i)** — `typealias Idx = int(0 to u64.max)`
	// OR `typealias ElementArray = Array with T` inside a generic type body. The cursor sits at `typealias`
	// (any `export` is consumed by the caller). It reuses `readTypeAliasDeclaration` — the ONE typealias
	// grammar the sweep and the real parse share — which routes a `Base with Args` RHS into `genericOut` and a
	// ranged RHS into `rangedOut`. A nested FUNCTION alias has neither form and is rejected cleanly (a later
	// slice). Both supported forms record their bare member into `enclosingInnerAliases` so the rest of the
	// body's bare references resolve; the caller keys the returned shape whole-program.
	function readNestedTypeAlias() returns NestedAliasResult throws ParseError
		let aliasTok = self.current()
		var ranged = RangedTypeAliasArray.create()
		var functionAliases = FunctionTypeAliasArray.create()
		var generics = GenericAliasEntryArray.create()

		// The FORM comes from the reader that decided it, never from which array grew: that inference
		// would be a second copy of a discrimination `readTypeAliasDeclaration` already makes, free to
		// drift the day a fourth form appears.
		let form = try self.readTypeAliasDeclaration(ranged, functionOut: functionAliases, genericOut: generics, buildFunctionDisplay: false)

		// A generic-instance nested alias (`Array with T`) — recorded by `readGenericInstanceAlias` into
		// `generics`. Its instance is PARTIALLY OPAQUE (`Array with typeParameter(pos)`), keyed whole-program by
		// the caller under its base-qualified name so a same-named inner alias of another generic type stays
		// distinct, exactly as a ranged inner alias is.
		if form == TypeDeclKind.genericAlias 'genericInstance'
			let entry = try generics.get(0) otherwise panic("readNestedTypeAlias: the generic-instance form was read but generics.get(0) failed")
			self.recordInnerAliasName(entry.aliasName)
			return NestedAliasResult.genericInstance(entry)
		end 'genericInstance'

		// Every remaining form is unsupported nested — today that is the FUNCTION one, and the message
		// names it; a nominal kind cannot reach here at all, `typealias` being the only keyword this
		// reader consumes.
		if form != TypeDeclKind.rangedAlias 'notSupported'
			throw ParseError.unsupported("a nested typealias inside a generic type must be a ranged `int`/`float` alias (`typealias Idx = int(0 to u64.max)`) or a generic-instance alias (`typealias ElementArray = Array with T`); a nested function alias is a later slice", line: aliasTok.line, column: aliasTok.column)
		end 'notSupported'

		let alias = try ranged.get(0) otherwise panic("readNestedTypeAlias: the ranged form was read but ranged.get(0) failed")
		self.recordInnerAliasName(alias.name)
		return NestedAliasResult.ranged(alias)
	end 'readNestedTypeAlias'

	// Record a nested alias's bare member into `enclosingInnerAliases` so the rest of the body's bare
	// references resolve. COPY-ON-WRITE off the shared empty set: only a type that actually declares a nested
	// typealias gets its own set here, so the generics-free corpus never allocates one (the reset points at
	// the shared one). Shared by both nested-alias shapes, so ranged and generic aliases enter the set the
	// same way.
	function recordInnerAliasName(name ByteArray)
		if self.enclosingInnerAliases is sharedEmptyInnerAliases 'stillShared'
			self.enclosingInnerAliases = InnerAliasNameSet.create()
		end 'stillShared'
		self.enclosingInnerAliases.insert(name)
	end 'recordInnerAliasName'

	// Re-key a nested generic-instance alias entry under its BASE-QUALIFIED name (`Container.ElementArray`)
	// before the sweep folds it whole-program (P1.7 slice 3b-i). `readGenericInstanceAlias` records the BARE
	// member (`ElementArray`), but a bare member collides with a same-named inner alias of another generic
	// type, so it is qualified with the enclosing type — the SAME name `parseTypeReference`'s inner-alias arm
	// stamps the field type with (`joinQualifiedName`), so the field's stored `named("Container.ElementArray")`
	// and this `genericAliases` key are one string.
	function qualifiedInnerGenericAlias(entry GenericAliasEntry) returns GenericAliasEntry
		return GenericAliasEntry.create(joinQualifiedName(self.enclosingType, member: entry.aliasName), baseName: entry.baseName, argCount: entry.argCount, args: entry.args)
	end 'qualifiedInnerGenericAlias'

	// ⭐ **A GENERIC-INSTANCE TYPEALIAS (P1.6-A)** — `typealias IntBox = Box with Integer`. The cursor
	// sits on the base identifier. It RECORDS the instance into `genericOut` (which `foldFile` interns
	// into the whole-program `GenericInstanceRegistry`) and THEN checks the instantiation.
	//
	// ⚠ **THE CHECK RECORDS A DIAGNOSTIC, IT DOES NOT THROW, AND THAT IS WHAT MAKES THE SWEEP TOLERANT
	// FOR FREE.** A malformed instantiation (a non-generic base, wrong arity, a managed argument) is a
	// WHOLE-PROGRAM SEMANTIC error, not a syntax error — it does not abort the file's parse, it gates the
	// build like `SemanticCheck`'s errors do. This is why the diagnostic path, not a throw, is the correct
	// tool: a throw would need the sweep to swallow it, and this needs no swallowing at all.
	//
	// ⭐ **AND IT DOES NOT RUN AT ALL DURING THE SWEEP — `signatures.allFilesFolded` IS THE GATE, read by
	// both this check and `checkGenericArgType`.** The verdict is a function of the whole-program index,
	// which is COMPLETE in the real parse and still BUILDING during the sweep, so the sweep's answer is a
	// fact about how far the sweep has got and not about the program. It was previously computed anyway
	// and discarded, on the argument that the SWEEP'S artifact is never merged (`queryProgramSignatures`
	// uses a throwaway `Parser`) — true, and it is still what makes SKIPPING it invisible: the real parse
	// re-reads every one of these declarations with the index complete, so every diagnostic a program
	// earns is still recorded exactly once, at the same position, by the same check. What the discard
	// argument got wrong is that a diagnostic nothing reads is not free: building one is a positioned
	// `Diagnostic` plus an interpolated message, MEASURED at ~6 allocations per generic type ARGUMENT and
	// again per malformed-looking INSTANCE, linear in the program's generic declarations. Spending it to
	// produce an answer that is thrown away — and would be wrong if it were not — is the whole of the cost.
	//
	// ⚠ **It also sidesteps the bootstrap's 64-managed-case union limit** (`ParseError` sits at exactly 64
	// String-carrying arms — a 65th overflows the C# runtime's u64 droppable-case bitmask and corrupts the
	// synthesized `__destruct_ParseError`). A diagnostic carries its message on a `Diagnostic` record, not
	// a new `ParseError` arm, so it adds no managed union case. (See the rung report / DEVLOG.)
	function readGenericInstanceAlias(aliasTok Token, genericOut GenericAliasEntryArray) throws ParseError
		let baseTok = try self.consume(TokenKind.identifier)
		try self.consume(TokenKind.with)
		var args = GenericArgNodeArray.create()
		let argCount = try self.parseGenericArgNodes(args)
		genericOut.push(GenericAliasEntry.create(aliasTok.value, baseName: baseTok.value, argCount: argCount, args: args, nameLine: aliasTok.line, nameColumn: aliasTok.column, filePath: self.filePath))
		self.checkGenericInstance(baseTok, argCount: argCount)
	end 'readGenericInstanceAlias'

	// Record a whole-program semantic DIAGNOSTIC the pure parser detected, WITHOUT unwinding the parse
	// (P1.6-A) — the parser twin of `reportPositioned`, writing into the artifact (which `mergeArtifact`
	// folds into `project.diagnostics`) rather than into `project`, so the pure-parser invariant holds.
	function recordArtifactDiagnostic(code ErrorCode, message String, tok Token)
		self.artifact.diagnostics.push(Diagnostic.create(code, message: message, line: tok.line, column: tok.column, filePath: self.artifact.filePath))
	end 'recordArtifactDiagnostic'

	// The argument list of a `Base with Args` (P1.6-A) — a single arg (`Box with Integer`) or a
	// parenthesized comma list (`Pair with (Integer, Bool)`). Each arg is an ordinary type reference,
	// so `Box with Integer` binds `[Integer]` and `Pair with (A, B)` binds `[A, B]`.
	// Parse a `Base with Args` argument LIST — `Box with Integer` (a single arg) or `Pair with (A, B)` (a
	// parenthesized comma list) — appending its pre-order nodes to `nodes` and returning the number of
	// TOP-LEVEL arguments (the arity `checkGenericInstance` validates).
	function parseGenericArgNodes(nodes GenericArgNodeArray) returns FieldIndex throws ParseError
		if not self.at(TokenKind.leftParen) 'singleArg'
			try self.parseGenericArgNode(nodes)
			return 1
		end 'singleArg'
		try self.consume(TokenKind.leftParen)
		var count = 0 as FieldIndex
		while true 'argLoop'
			try self.parseGenericArgNode(nodes)
			count = count + 1
			if not self.at(TokenKind.comma) 'doneArgs'
				break
			end 'doneArgs'
			try self.consume(TokenKind.comma)
		end 'argLoop'
		try self.consume(TokenKind.rightParen)
		return count
	end 'parseGenericArgNodes'

	// ⭐ **ONE generic-instance argument (P1.6-A/B2)** — a LEAF type reference (`Integer`, `Point`,
	// `String`), or a NESTED instance `Inner with (…)` now that managed instances are owned and dropped. A
	// nested instance's gid is not known at parse time (interning lives in `recordGenericAlias`), so it is
	// FLATTENED pre-order: an `instanceHeader(base, k)` node followed by its `k` args' nodes. It is VALIDATED
	// here, at its own `with`, so a malformed nested base (`Box with (Plain with Integer)`, wrong arity) is
	// diagnosed with the tolerant sweep's index-complete answer, exactly as the outer instance is
	// (`checkGenericInstance` records, never throws). The header is pushed BEFORE its sub-args (parsed into a
	// temp so the header's count is known), preserving pre-order.
	function parseGenericArgNode(nodes GenericArgNodeArray) throws ParseError
		if self.at(TokenKind.identifier) and self.kindAt(self.pos + 1) == TokenKind.with 'nested'
			let baseTok = try self.consume(TokenKind.identifier)
			try self.consume(TokenKind.with)
			var subNodes = GenericArgNodeArray.create()
			let subCount = try self.parseGenericArgNodes(subNodes)
			self.checkGenericInstance(baseTok, argCount: subCount)
			nodes.push(GenericArgNode.instanceHeader(baseTok.value, argCount: subCount))
			nodes.append(subNodes)
			return
		end 'nested'

		let argTok = self.current()
		let argType = try self.parseTypeReference()
		self.checkGenericArgType(argType, argTok: argTok)
		nodes.push(GenericArgNode.leaf(argType))
	end 'parseGenericArgNode'

	// ⭐ **WHAT A TYPE ARGUMENT MAY BE — THREE RULES, AND THE ORDER IS LOAD-BEARING, NOT TIDINESS.**
	//
	// **1. It may not resolve to `float` (E2062)** — bare or through a ranged float alias. A COMPILER
	// limitation, not a language rule: dictionary-passing gives a type parameter a general-purpose slot,
	// which a float cannot travel in. ONE rule with ONE message, decided at TWO points, and each placement
	// is forced. The BARE keyword goes before rule 2, because a bare `float` satisfies rule 2 as well and
	// rule 2's workaround is a trap for it. The ALIAS goes after rule 3 — a name must denote something
	// before it can denote a float, and rule 3's answer already carries the domain, so asking there is free
	// where asking separately is a heap box per argument.
	//
	// **2. It may not be a BARE NUMERIC KEYWORD (E2061).** A bare `int` is minted CONCRETE by
	// `parseTypeReference`, so it too is answered before the `named` cascade it never enters.
	//
	// **3. If it NAMES something, that name must denote a type (E3011).** `checkGenericInstance` validated
	// the BASE and the ARITY and nothing else, so `typealias BadArray = Array with UnknownType` COMPILED,
	// RAN and returned an answer — a silent acceptance of a program naming a type the program does not have,
	// which is the one class of defect a suite cannot catch by being green. The runnable oracle rejects it,
	// and so does this.
	//
	// Rule 3 asks `denotedNamedType` — the ONE cascade `TypeResolution` and both `as`-cast sites ask — so an
	// argument and a cast target can never come to disagree about what a name means. Only a `named` type can
	// be in question THERE: `parseTypeReference` has already answered every spelling it settles syntactically
	// (`Self`, the enclosing type's own name, `String`, a type PARAMETER, a bare inner alias, a
	// generic-instance alias, a function alias, the primitive keywords) with a concrete arm, and a
	// `typeParameter`/`genericInstance`/`structRef` argument is exactly the legal case that must not be
	// refused. Which is precisely why rules 1 and 2 cannot be expressed as extra arms of that cascade — the
	// tags they reject are ones the cascade is never reached for.
	//
	// ⚠ **RECORDED, NOT THROWN, AND NOT COMPUTED AT ALL UNTIL THE INDEX IS WHOLE-PROGRAM** — the same two
	// rules `checkGenericInstance` states beside it, for the same reason and off the same gate
	// (`signatures.allFilesFolded`); its header carries the argument. This check is the sharper case of it:
	// a generic-instance or function alias declared later in the program — or anywhere in this file, whose
	// own declarations fold only after its whole token walk — legitimately reads "undeclared" during the
	// sweep, so the sweep's verdict is not merely discarded, it is systematically wrong.
	//
	// ⚠ **A `b"…"` BYTE-STRING NEEDS NO EXEMPTION, and that is a property of where its instance comes from.**
	// The compiler MINTS `Array with Byte` for a byte-string literal (`internArrayByteInstance`) rather than
	// reading it off a `Base with Args` in source, so a byte string never reaches this check at all. A program
	// that WRITES `Array with Byte` declares its own `typealias Byte = int(0 to u8.max)` — a ranged alias the
	// cascade resolves — which is exactly what `undeclaredNamedElementStorageBytes` means when it says no user
	// type can name the literal's own instance.
	function checkGenericArgType(argType MaxonType, argTok Token)
		if not self.signatures.allFilesFolded 'indexStillBuilding'
			return
		end 'indexStillBuilding'

		let tag = maxonTypeTag(argType)

		// ⭐ **A FLOAT TYPE ARGUMENT IS REFUSED, HOWEVER IT IS SPELLED (E2062).** shv2 DICTIONARY-PASSES
		// rather than monomorphizing, so a type parameter is one opaque 8-byte GENERAL-PURPOSE slot; a float
		// is born in XMM and has no way to travel through it. Both spellings reach the same x64
		// cross-register-file assertion — MEASURED: bare `Box with float` and `Box with Real` over
		// `typealias Real = float(f64.min to f64.max)` panic identically — so refusing only the bare keyword
		// would leave the panic reachable through the very alias E2061 recommends.
		//
		// ⚠ **THE BARE ARM IS ASKED BEFORE E2061, AND THAT ORDER IS THE POINT, not a tidy-up.** A bare
		// `float` satisfies BOTH rules — `tagIsBareNumericKeyword` genuinely admits it, which is what makes
		// this a resolved OVERLAP rather than two disjoint tests in an arbitrary sequence — and E2061's
		// advice ("declare a ranged typealias") is TRUE for `int` and a TRAP for `float`. Asking float first
		// is what stops this compiler from routing a reader into a crash with its own diagnostic, and
		// `error.float-type-arg` is the spec case that turns RED the moment the two arms are swapped. The
		// ALIAS spelling is decided further down instead, off the name cascade's own answer — see there for
		// why that is the cheap place and not merely the late one.
		//
		// ⚠ **A DELIBERATE DIVERGENCE FROM BOTH REFERENCES**, which accept a float type argument because
		// they MONOMORPHIZE — the instantiation gets a genuine f64 slot and the question never arises. This
		// is a COMPILER limitation, not a language rule, so the message names no workaround: at this
		// milestone there is none. It retires when a float register class for descriptor-typed values lands,
		// and until then the diagnostic is what makes that a decision someone takes rather than a panic
		// someone trips over.
		if tagIsFloat(tag) 'bareFloatArg'
			self.recordArtifactDiagnostic(ErrorCode.genericFloatTypeArg, message: floatTypeArgMessage(typeTagName(tag)), tok: argTok)
			return
		end 'bareFloatArg'

		// ⭐ **A BARE `int` IS NOT A TYPE ARGUMENT (E2061)** — the ranged-typealias rule reaching the one
		// type position that never enforced it. Everywhere else a numeric domain must be DECLARED
		// (`typealias Integer = int(i64.min to i64.max)`); a `with` clause let the keyword straight through,
		// and it was silently ACCEPTED. `bool` is DELIBERATELY ADMITTED — it is already a constrained type,
		// with no range to name — as are `String`, a user type, a type PARAMETER, a nested instance, and the
		// ranged INT alias this message names, which is verified to work.
		//
		// It is a TAG test, and it has to be: a bare keyword is minted CONCRETE by `parseTypeReference`
		// (`MaxonType.integer`, never `named`), so it never reached the name cascade below — which is
		// exactly what hid it.
		//
		// ⚠ **IT ASKS FOR THE WHOLE SET — `int` AND `float` — AND RELIES ON THE ARM ABOVE HAVING TAKEN THE
		// FLOAT.** Narrowing this guard to `tagIsInteger` would state the rule as "the bare numeric keywords,
		// minus whatever an earlier arm happened to claim", which reads identically whether the author knew
		// about the overlap or never heard of it — and it would make the ordering above unfalsifiable, since
		// two disjoint equality tests can be swapped with no effect at all. Stated whole, a swap is a
		// behaviour change the suite catches.
		if tagIsBareNumericKeyword(tag) 'barePrimitive'
			// ⚠ **REPORTED AT THE OFFENDING ARGUMENT, NOT AT THE ALIAS NAME — a deliberate divergence from the
			// oracle**, which passes its `aliasNameToken` (`RejectBarePrimitiveTypeArgs`, all three call
			// sites) and so points at the name LEFT of the `=`, away from the token that has to change. Two
			// reasons the argument wins: the E3011 arm below already reports at `argTok`, so one function
			// would otherwise answer one question from two columns; and no corpus case asserts the column.
			let spelling = typeTagName(tag)
			self.recordArtifactDiagnostic(ErrorCode.genericBarePrimitiveArg, message: "Cannot use bare type '{spelling}' as a type argument; use a ranged typealias instead (e.g. typealias MyType = {spelling}(...))", tok: argTok)
			return
		end 'barePrimitive'

		if tag != ValueTypeTag.named 'alreadyConcrete'
			return
		end 'alreadyConcrete'

		let nameId = typeNameIdOf(argType)
		let name = self.internedName(nameId)
		let denoted = try denotedNamedType(self.signatures, name: name, id: nameId) otherwise 'undeclared'
			self.recordArtifactDiagnostic(ErrorCode.unknownType, message: unknownTypeMessage(String.from(name)), tok: argTok)
			return
		end 'undeclared'

		// ⭐ **THE FLOAT RULE'S SECOND SPELLING (E2062), READ OFF THE CASCADE'S OWN ANSWER** — a ranged FLOAT
		// alias, whose `named` tag says nothing about the domain behind it. It is asked HERE, after E3011
		// rather than beside the bare arm above, for two reasons and both are load-bearing:
		//
		// **1. A name must denote something before it can denote a float.** The domain of a name the program
		// does not declare is a question with no answer, and E3011 is the honest verdict.
		//
		// **2. HERE IT COSTS NOTHING, WHERE ASKING SEPARATELY COST ONE HEAP BOX PER ARGUMENT.**
		// `denotedNamedType` erases a plain ranged alias to its UNDERLYING primitive, so the answer is
		// already in its result — and this call was being made anyway, its value discarded into `_`. The
		// obvious alternative, `resolveFloatAliasType`, reaches the registry through `aliasOf`, which hands
		// back a payload union Maxon HEAP-BOXES per call; `denotedNamedType` deliberately goes through
		// `aliasUnderlyingInAnyFile` instead, whose header states that exact reason ("hands back the
		// primitive rather than a `DeclaredAlias` that would be heap-boxed per call"). MEASURED on the scale
		// ladder: the separate lookup cost **+16 / +30 / +58 allocations of 16 bytes** over three rungs — one
		// box per named type argument, linear in the program — and reading it off the cascade is delta-ZERO.
		//
		// A declared `enum`/`union` erases to `integer` here (a float-BACKED enum too — its bits ARE an i64)
		// and a struct stays `structRef`, so `float` reaches this test only from a genuine float alias.
		if tagIsFloat(maxonTypeTag(denoted)) 'floatAliasArg'
			// Named by the ALIAS the source wrote, not by `float`: a reader told "cannot use 'float'" about a
			// line that says `Real` would have to work out which of its aliases is meant.
			self.recordArtifactDiagnostic(ErrorCode.genericFloatTypeArg, message: floatTypeArgMessage(String.from(name)), tok: argTok)
			return
		end 'floatAliasArg'
	end 'checkGenericArgType'

	// The ONE wording of "a float type argument is not supported yet", shared by the two spellings that
	// reach it — the bare `float` keyword and a ranged float alias. They are decided at different points of
	// `checkGenericArgType` (one syntactically, one off the name cascade) and must not be free to drift into
	// two texts for one rule; `spelling` is the only thing that legitimately differs between them.
	function floatTypeArgMessage(spelling String) returns String
		return "Cannot use '{spelling}' as a type argument: a float type argument is not supported yet. A type parameter is an opaque 8-byte general-purpose slot under shv2's dictionary-passing, and a float value travels in a floating-point register, so it has no way through"
	end 'floatTypeArgMessage'

	// ⭐ **CHECK A `Base with Args` INSTANTIATION (P1.6-A/B2)** — reads the whole-program index (complete in
	// the real parse). Two rejections, in the order the reader most wants to hear them, each RECORDED as a
	// diagnostic (not thrown — see `readGenericInstanceAlias`):
	//   1. `Base` is not a generic type — E2055 "has no associated types";
	//   2. wrong arity — `Pair with Integer` for a two-parameter `Pair` (E2056).
	// The P1.6-A managed-argument rejection (E2057) is GONE: B2 owns and drops managed type arguments, so a
	// String / managed-struct / nested-instance argument is now legal. A nested instance validates itself at
	// its own `with` (`parseGenericArgNode`), so this checks ONE level.
	function checkGenericInstance(baseTok Token, argCount FieldIndex)
		if not self.signatures.allFilesFolded 'indexStillBuilding'
			return
		end 'indexStillBuilding'

		// `Array` is a BUILTIN generic with one type parameter `Element` — there is no `type Array uses
		// Element` declaration (its runtime is synthesized, P1.7), so `structOf` finds nothing. Validate its
		// arity here instead; the managed-element rejection (slice 1 is trivial elements only) is done where
		// an array is materialized, which has the resolved element type in hand.
		if self.signatures.isArrayBaseName(baseTok.value) 'array'
			if argCount != ArrayTypeParamCount 'wrongArity'
				self.recordArtifactDiagnostic(ErrorCode.genericArityMismatch, message: "generic type '{String.from(baseTok.value)}' expects {ArrayTypeParamCount} type argument(s), but {argCount} were supplied", tok: baseTok)
			end 'wrongArity'
			return
		end 'array'
		// `Set` is a BUILTIN generic with one type parameter `Element` (P1.7b slice A) — like `Array`, no `type
		// Set uses Element` declaration exists, so validate its arity here; the int-key-only restriction is
		// enforced where a set method receives its element (which has the resolved key type in hand).
		if self.signatures.isSetBaseName(baseTok.value) 'set'
			if argCount != SetTypeParamCount 'wrongArity'
				self.recordArtifactDiagnostic(ErrorCode.genericArityMismatch, message: "generic type '{String.from(baseTok.value)}' expects {SetTypeParamCount} type argument(s), but {argCount} were supplied", tok: baseTok)
			end 'wrongArity'
			return
		end 'set'
		match self.signatures.structOf(baseTok.value) 'base'
			undeclared then self.recordBaseNotGeneric(baseTok)
			declared(layout) then self.checkGenericInstanceAgainst(layout, baseTok: baseTok, argCount: argCount)
		end 'base'
	end 'checkGenericInstance'

	// The "has no associated types" verdict (E2055), from its ONE home (P1.6-A). Reached by BOTH halves
	// of the base check — a `Base` that is not a declared type at all (`structOf` undeclared) and a `Base`
	// that is a declared type with an empty `uses` list (`typeParamCount() == 0`) — which are the same
	// diagnostic. Bound here rather than spelled at each site so the two callers cannot drift the message.
	function recordBaseNotGeneric(baseTok Token)
		self.recordArtifactDiagnostic(ErrorCode.genericBaseNotGeneric, message: "Type '{String.from(baseTok.value)}' has no associated types", tok: baseTok)
	end 'recordBaseNotGeneric'

	// The declared-base half of `checkGenericInstance` — base-is-generic, then arity. The P1.6-A per-argument
	// managed rejection is GONE (B2 owns and drops managed type arguments).
	function checkGenericInstanceAgainst(layout StructLayout, baseTok Token, argCount FieldIndex)
		if layout.typeParamCount() == 0 'notGeneric'
			self.recordBaseNotGeneric(baseTok)
			return
		end 'notGeneric'

		if argCount != layout.typeParamCount() 'wrongArity'
			self.recordArtifactDiagnostic(ErrorCode.genericArityMismatch, message: "generic type '{String.from(baseTok.value)}' expects {layout.typeParamCount()} type argument(s), but {argCount} were supplied", tok: baseTok)
			return
		end 'wrongArity'
	end 'checkGenericInstanceAgainst'

	// Parse `function(paramTypes) [returns T]` on a typealias RHS (P1.5-A1), the cursor sitting on
	// `function`. The RETURN type is stored INTERNER-FREE (tag + name) so it rides the no-remap fold, and an
	// indirect call needs it to type its result. The PARAMETER types are not needed by a call (arg-type/arity
	// checking against a function-typed place is a later rung), but the #81 merge check needs the WHOLE
	// signature to compare a `f UnaryOp` arm — so they are collected here into the `fn(…) returns …` DISPLAY
	// STRING (also interner-free), which is the only thing that carries the params past this point. An absent
	// `returns` clause is a void function type.
	function readFunctionTypeAlias(nameTok Token, buildDisplay bool) returns FunctionTypeAlias throws ParseError
		try self.consume(TokenKind.function)
		try self.consume(TokenKind.leftParen)

		// The parameter TYPES are collected only to build the `#81` display string, and ONLY the real parse
		// needs it: the whole-program token sweep and the nested-alias reader discard the function alias, so
		// they pass `buildDisplay: false`, push nothing into `paramTypes`, and build no display string. The
		// empty `paramTypes` they still construct grows no heap buffer — an `Array`'s backing storage is
		// allocated lazily on the first `push`, which the sweep never makes. The params are PARSED either
		// way — the syntax must be consumed, and a malformed one rejected.
		var paramTypes = MaxonTypeArray.create()
		if not self.at(TokenKind.rightParen) 'params'
			while true 'paramLoop'
				let paramType = try self.readFunctionTypeParam()
				if buildDisplay 'collectParam'
					paramTypes.push(paramType)
				end 'collectParam'
				if not self.at(TokenKind.comma) 'endParams'
					break
				end 'endParams'
				try self.consume(TokenKind.comma)
			end 'paramLoop'
		end 'params'

		try self.consume(TokenKind.rightParen)

		var returnTag = ValueTypeTag.void
		var returnTypeName = EmptySourceText
		var returnForDisplay = MaxonReturnType.void
		if self.at(TokenKind.returns) 'hasReturn'
			try self.consume(TokenKind.returns)
			let returnType = try self.parseTypeReference()
			returnTag = maxonTypeTag(returnType)
			returnTypeName = self.functionAliasReturnName(returnType)
			returnForDisplay = MaxonReturnType.value(returnType)
		end 'hasReturn'

		var display = EmptySourceText
		if buildDisplay 'display'
			display = formatFnTypeDisplay(paramTypes, returnType: returnForDisplay, typeNames: self.artifact.typeNames).toByteArray()
		end 'display'
		return FunctionTypeAlias.create(nameTok.value, returnTag: returnTag, returnTypeName: returnTypeName, display: display)
	end 'readFunctionTypeAlias'

	// One parameter of a function-type signature — an optional NAME followed by its type, or a bare type,
	// returning the parameter's TYPE (the #81 display needs it; the NAME is documentation only, discarded).
	// A `name Type` param is one where an identifier is followed by another type-starting token
	// (`function(x Score)`); otherwise the token IS the type (`function(Integer)`, `function(Integer, Integer)`).
	function readFunctionTypeParam() returns MaxonType throws ParseError
		if self.at(TokenKind.identifier) and self.peekStartsType() 'namedParam'
			try self.consume(TokenKind.identifier)
		end 'namedParam'
		return try self.parseTypeReference()
	end 'readFunctionTypeParam'

	// True when the token ONE past the cursor can BEGIN a type reference — an identifier (a named type
	// or `String`), the `int`/`bool`/`float` keywords, or `Self`. Used to tell a function-type param's
	// optional NAME from its TYPE (`x Score` vs a bare `Integer`).
	function peekStartsType() returns bool
		let k = self.peekKind()
		return k == TokenKind.identifier or k == TokenKind.int or k == TokenKind.bool or k == TokenKind.float or k == TokenKind.selfType
	end 'peekStartsType'

	// The interned NAME behind a function alias's return type, stored so the return type can be
	// re-interned into any reader's own interner at an indirect call (see FunctionTypeAlias). A primitive
	// return (`bool`/`int`/`float`/`ExitCode`/`void`) carries no name and yields the empty string.
	function functionAliasReturnName(returnType MaxonType) returns ByteArray
		return match returnType 'k'
			named(id) gives self.internedName(id)
			structRef(id) gives self.internedName(id)
			function(id) gives self.internedName(id)
			boolean to float gives EmptySourceText
			exitCode to unresolved gives EmptySourceText
			string gives EmptySourceText
			// A type parameter / generic instance carries no re-internable NAME (its id is a POSITION / a
			// GenericInstanceId, P1.6-A), so like a primitive it yields the empty string. A function ALIAS
			// returning one is not reachable in the trivial slice — this is exhaustiveness insurance.
			typeParameter gives EmptySourceText
			genericInstance gives EmptySourceText
		end 'k'
	end 'functionAliasReturnName'

	// The `to <high>` / `upto <high>` half of a range, returned as an INCLUSIVE upper
	// bound: `upto` is exclusive, so it normalizes to `high - 1` here and the registry
	// keeps exactly one representation of a range (`0 upto 10` and `0 to 9` are the same
	// alias, which is what the language says they are).
	//
	// `i64.min` has no `upto` form — its exclusive bound would be one BELOW the smallest
	// representable value. Rejected with a positioned error, because the subtraction that
	// normalizes it would otherwise underflow `ParsedInt` and take the COMPILER down on a
	// source file it should merely have diagnosed.
	function parseRangeUpperBound(isFloat bool) returns ParsedInt throws ParseError
		if self.at(TokenKind.upto) 'exclusive'
			let uptoTok = try self.consume(TokenKind.upto)

			// `upto` normalizes to an inclusive `high - 1` (below) — INTEGER arithmetic on the bound.
			// A float bound is an IEEE-754 bit pattern, not a count, so `bits - 1` is nonsense on it,
			// and no float alias in the corpus uses `upto`. Rejected rather than mis-normalized; a
			// float exclusive bound is a concern only for the P1.9 range check that would read it.
			if isFloat 'floatExclusive'
				throw ParseError.unsupported("an exclusive `upto` upper bound on a float typealias — a float bound is a bit pattern with no integer predecessor; use `to`", line: uptoTok.line, column: uptoTok.column)
			end 'floatExclusive'

			let bound = try self.parseRangeBound(isFloat)
			if bound == I64MinBound 'unrepresentable'
				throw ParseError.unsupported("an exclusive upper bound of i64.min — its inclusive form is one below the smallest 64-bit integer, so the range is empty and not representable", line: uptoTok.line, column: uptoTok.column)
			end 'unrepresentable'
			return bound - 1
		end 'exclusive'

		try self.consume(TokenKind.to)
		return try self.parseRangeBound(isFloat)
	end 'parseRangeUpperBound'

	// One endpoint of a range. For an INT alias: an integer literal (`0`, `-273`, `0xFFFF`) or a
	// type-qualified bound (`i64.min`, `u32.max`). For a FLOAT alias (`isFloat`): a float literal or a
	// float type-qualified bound — see `parseFloatRangeBound`. The two endpoints of one range are
	// parsed with the same `isFloat`, so a range cannot mix an int and a float bound.
	function parseRangeBound(isFloat bool) returns ParsedInt throws ParseError
		if isFloat 'float'
			return try self.parseFloatRangeBound()
		end 'float'

		if self.at(TokenKind.minus) 'negative'
			try self.consume(TokenKind.minus)
			let tok = try self.consume(TokenKind.intLiteral)
			return try self.intLiteralValue(tok, negated: true)
		end 'negative'

		if self.at(TokenKind.intLiteral) 'literal'
			let tok = try self.consume(TokenKind.intLiteral)
			return try self.intLiteralValue(tok, negated: false)
		end 'literal'

		return try self.parseTypeQualifiedBound(false)
	end 'parseRangeBound'

	// One endpoint of a FLOAT range: a float literal (`0.0`, `100.0`, `-2.5`) or a type-qualified
	// float bound (`f32.min`, `f64.max`). The value is the endpoint's IEEE-754 **f64** bit pattern,
	// carried in the same `ParsedInt` an integer bound uses — a float alias resolves to
	// `MaxonType.float` = f64, so its bounds are f64 bits (`RangedTypeAlias`). The literal path reuses
	// the one float decoder `parseFloatLiteral` does (`parseFloatBits`), so `0.0` reads the same bits
	// in a bound as in an expression. A negated literal FLIPS the sign bit (`negatedFloatBits`) rather
	// than subtracting: `0 - bits` on a bit pattern would be nonsense (see `FloatSignBit`).
	function parseFloatRangeBound() returns ParsedInt throws ParseError
		if self.at(TokenKind.minus) 'negative'
			try self.consume(TokenKind.minus)
			let tok = try self.consume(TokenKind.floatLiteral)
			let bits = try self.floatLiteralBits(tok)
			return negatedFloatBits(bits)
		end 'negative'

		if self.at(TokenKind.floatLiteral) 'literal'
			let tok = try self.consume(TokenKind.floatLiteral)
			return try self.floatLiteralBits(tok)
		end 'literal'

		return try self.parseTypeQualifiedBound(true)
	end 'parseFloatRangeBound'

	// Convert an integer-literal token's text to its value, re-raising NumberParsing's
	// overflow as a POSITIONED parse error. THE one place a literal's text becomes a
	// number: the expression parser (`parseIntLiteral`) and the range-bound parser both
	// come through it, so how a literal is read — the radix prefixes it accepts, the
	// overflow it rejects — cannot come to mean one thing in `return 42` and another in
	// `int(0 to 42)`.
	//
	// `negated` routes to `parseNegatedInt` rather than negating the result: `i64.min`'s
	// magnitude does not fit a POSITIVE i64, so negating after the fact would overflow on
	// the one bound that most needs to work.
	function intLiteralValue(tok Token, negated bool) returns ParsedInt throws ParseError
		if negated 'negative'
			return try parseNegatedInt(tok.value) otherwise (err) 'rejected'
				throw self.literalDecodeError(err, tok: tok, isFloat: false)
			end 'rejected'
		end 'negative'
		return try parseInt(tok.value) otherwise (err) 'rejected'
			throw self.literalDecodeError(err, tok: tok, isFloat: false)
		end 'rejected'
	end 'intLiteralValue'

	// The float twin of `intLiteralValue`: THE one place a float literal's text becomes BITS. Six
	// sites used to spell `try parseFloatBits(tok.value) otherwise throw …` for themselves — a field
	// default, both float range bounds, an enum raw value, a constant initializer and the expression
	// parser — which is the same fact written down six times, and the integer side had already been
	// centralized for exactly that reason.
	function floatLiteralBits(tok Token) returns ParsedInt throws ParseError
		return try parseFloatBits(tok.value) otherwise (err) 'rejected'
			throw self.literalDecodeError(err, tok: tok, isFloat: true)
		end 'rejected'
	end 'floatLiteralBits'

	// Turn a NumberParsing failure into the POSITIONED parse error that reports it, quoting the
	// token's RAW TEXT — the radix prefix and `_` separators the source wrote, which the decoded
	// value can no longer say.
	//
	// ⚠ `malformed` is NOT reported: it is unreachable from source. `Lexer.scanNumber` hands a
	// literal token nothing but digits, `_`, `.`, `e`/`E` and an exponent sign, so a byte the number
	// grammar refuses means the lexer and `parseFloatBits`/`parseInt` have come to disagree about
	// what a literal IS — a compiler defect, not a program's. (The variant exists for
	// `Testing/PeSectionReader`, which parses spec-file text no lexer guards; see `ParserError`.)
	function literalDecodeError(err ParserError, tok Token, isFloat bool) returns ParseError
		match err 'kind'
			overflow then break 'kind'
			malformed then panic("literalDecodeError: the number parser rejected '{String.from(tok.value)}' as malformed, but Lexer.scanNumber only ever emits a literal token of digits, '_', '.', 'e'/'E' and an exponent sign — the lexer and the number parser have diverged")
		end 'kind'

		let literal = String.from(tok.value)
		return ParseError.floatLiteralOverflow(literal, line: tok.line, column: tok.column) if isFloat else ParseError.integerOverflow(literal, line: tok.line, column: tok.column)
	end 'literalDecodeError'

	// A type-qualified numeric bound — `<sized>.min` / `<sized>.max`, three tokens
	// (identifier, `.`, identifier). Shared by the range-declaration parser and the
	// expression parser, which meet the same three tokens in two positions. `isFloat` is the
	// caller's domain: true only for the bound of a `float(...)` alias, where an `f32`/`f64` bound
	// is what is wanted; false for an int alias and for expression position (`let x = u16.max`),
	// where a float bound has no integer value to carry and is rejected.
	function parseTypeQualifiedBound(isFloat bool) returns ParsedInt throws ParseError
		let typeTok = try self.consume(TokenKind.identifier)
		try self.consume(TokenKind.dot)
		let fieldTok = try self.consume(TokenKind.identifier)
		let wantMax = try self.boundFieldIsMax(fieldTok)

		match sizedTypeBound(typeTok.value, wantMax: wantMax) 'resolve'
			// An integer bound is accepted in every position — including a `float(...)` alias, where
			// `float(0.0 to i64.max)` is as malformed as an out-of-order int range and left equally
			// unchecked (F1 emits no range check that would read the bound; this matches the int path's
			// existing laxness rather than adding a validation the int path does not have).
			value(bound) then return bound
			floatBound(bits) then return try floatBoundInFloatAlias(bits, isFloat: isFloat, typeTok: typeTok, fieldTok: fieldTok)
			notASizedType then throw ParseError.unexpectedToken("a sized numeric type (u8/u16/u32/u64/i8/i16/i32/i64/f32/f64)", got: String.from(typeTok.value), line: typeTok.line, column: typeTok.column)
		end 'resolve'
	end 'parseTypeQualifiedBound'

	// True for `.max`, false for `.min`. Any other field name is a positioned error —
	// a sized type exposes exactly these two bounds.
	function boundFieldIsMax(fieldTok Token) returns bool throws ParseError
		if fieldTok.value.equals(MaxBoundField) 'max'
			return true
		end 'max'
		if fieldTok.value.equals(MinBoundField) 'min'
			return false
		end 'min'
		throw ParseError.unexpectedToken("'min' or 'max'", got: String.from(fieldTok.value), line: fieldTok.line, column: fieldTok.column)
	end 'boundFieldIsMax'

	// Parse a struct type declaration (P1.0r):
	//
	//     type Point
	//         export var x as Integer
	//         export var y as Integer
	//         static function create(x Integer, y Integer) returns Self
	//             return Self{x: x, y: y}
	//         end 'create'
	//     end 'Point'
	//
	// ⭐ **THE DECLARATION EMITS NOTHING** — no op, no storage, no code. A `type` is a LAYOUT, and
	// its whole effect is the `StructLayout` recorded below, which `Self{…}` sizes its `__mm_alloc`
	// from and `p.x` reads its offsets out of. Its METHODS are ordinary functions, named
	// `Point.create` (`declaredMethodName`) and built by the very same `parseFunction` a free
	// function is: there is no method table, no receiver, and nothing for a call to dispatch
	// through. That is the whole of `static function` at this rung.
	//
	// ⚠ **THE LAYOUT IS RECORDED AFTER THE BODY, AND NOTHING IN THE BODY READS IT.** `Self{x: x, y:
	// y}` inside `create` needs the field list — and it asks `signatures.structOf`, the WHOLE-PROGRAM
	// sweep, which is complete before this file's parse begins. So there is no ordering hazard, and
	// deliberately no half-built artifact registry for a method body to race: a `type` whose fields
	// are declared BELOW its methods parses identically to one that declares them above.
	function parseTypeDeclaration() throws ParseError
		let nameTok = try self.readTypeHeader()
		// The real parse alone rejects a reserved `type __T` or a compiler-owned `type Ordering` —
		// `readTypeHeader` stays a pure reader shared with the tolerant sweep, which is not a validator
		// (see `recordScannedType`).
		try self.requireUnreservedName(nameTok)
		try self.requireTypeNameNotCompilerOwned(nameTok)
		self.enclosingType = nameTok.value

		var layout = StructLayout.create(nameTok.value)
		// `uses T` (P1.6-A) — parsed here so `parseTypeReference` recognizes `T` in the fields and
		// methods below, and the arity check reads the list off the recorded layout.
		self.openTypeParamScope(layout)

		// `implements I1, I2` (P1.7a slice 1) — parsed AFTER `uses` per the grammar
		// `type Name [uses …] [implements …]`. Records a whole-program ConformanceDecl (anchored on the
		// type NAME token) that `checkConformance` validates; the declaration itself emits nothing.
		try self.parseTypeImplementsClause(nameTok)

		// `where T is <Interface> …` (P1.7a slice 2a) — parsed AFTER `implements` per the grammar
		// `type Name uses T [implements I] where T is C`. The constraints are set on `enclosingWhereConstraints`
		// (so the body parse below recognizes a `self.item.digest()` witness dispatch and reserves witness
		// parameters) AND recorded on the layout (so the instantiation-site check validates `Box with Point`).
		if self.at(TokenKind.where) 'whereClause'
			let constraints = try self.readWhereClause()
			self.enclosingWhereConstraints = constraints
			layout.recordWhereConstraints(constraints)
		end 'whereClause'

		// Which of this type's methods carry a layout-descriptor param (P1.6-B1) — a TRANSITIVE fixpoint over
		// the type's own methods, computed NOW (the cursor sits at the body start) so `parseFunction` can
		// reserve the param before it numbers a method's body values. A peek-only walk; the cursor is untouched.
		self.computeTypeDescriptorNeeds()

		// The cursor sits at the type body start; remember it so the lazy sibling-receiver walk (#65) can begin
		// here once a method body's bare call needs it. The memo is invalidated implicitly — its key still names
		// the previous type, so the first call in this body rebuilds against this start.
		self.enclosingTypeBodyStart = self.pos

		while true 'members'
			self.skipNewlines()
			if self.at(TokenKind.end) 'closes'
				break
			end 'closes'
			if self.isEof() 'eof'
				let tok = self.current()
				throw ParseError.unexpectedEof(tok.line, column: tok.column)
			end 'eof'

			if self.atStructFieldKeyword() 'isField'
				try self.readStructFieldInto(layout)
				continue
			end 'isField'

			try self.parseTypeMember()
		end 'members'

		try self.consume(TokenKind.end)
		self.skipOptionalLabel()

		self.artifact.recordStructType(layout)
		self.closeTypeParamScope()
	end 'parseTypeDeclaration'

	// ⭐ **`interface Name [extends …] [uses …] … end` (P1.7a slice 1)** — the FRONT-END half of
	// interfaces. Its whole effect is the `IrInterface` recorded below, which `checkConformance` reads to
	// verify every `implements`-ing type supplies the required methods. It EMITS NOTHING: an interface
	// declares a contract, not code — there are no witness tables, no dispatch, no lowering at this slice.
	//
	// Method signatures have an implicit `self` (never declared), so `parseFunctionParameters` reads the
	// USER parameters only — exactly what the conformance check compares against an impl's parameters once
	// it drops the impl's prepended `__self`. `Self` in a signature resolves against `enclosingType` (set
	// to the interface name here), so the check can substitute the conforming type for it.
	function parseInterfaceDeclaration() throws ParseError
		try self.consume(TokenKind.interface)
		let nameTok = try self.consume(TokenKind.identifier)
		try self.requireUnreservedName(nameTok)
		self.enclosingType = nameTok.value

		var extendsInterfaces = ByteArrayArray.create()
		var associatedTypeNames = ByteArrayArray.create()
		try self.parseInterfaceHeaderClauses(extendsInterfaces, associatedTypeNames: associatedTypeNames)

		var methods = InterfaceMethodSigArray.create()
		while true 'members'
			self.skipNewlines()
			if self.at(TokenKind.end) 'closes'
				break
			end 'closes'
			if self.isEof() 'eof'
				let tok = self.current()
				throw ParseError.unexpectedEof(tok.line, column: tok.column)
			end 'eof'

			methods.push(try self.parseInterfaceMethod(nameTok.value))
		end 'members'

		try self.consume(TokenKind.end)
		self.skipOptionalLabel()

		self.artifact.recordInterface(IrInterface.create(nameTok.value, methods: methods, extendsInterfaces: extendsInterfaces, associatedTypeNames: associatedTypeNames))
		self.enclosingType = EmptySourceText
	end 'parseInterfaceDeclaration'

	// The optional `extends P1, P2` and `uses A, B` clauses of an interface header, in either order. A
	// parent interface's methods a conforming type must ALSO supply (`checkConformance` projects them at
	// decl order); `uses` names associated types (kept for slice 2 — the enabled slice-1 corpus declares
	// none). Stops at the first token that opens neither clause (a newline into the body).
	function parseInterfaceHeaderClauses(extendsInterfaces ByteArrayArray, associatedTypeNames ByteArrayArray) throws ParseError
		while true 'clauses'
			if self.at(TokenKind.extends) 'extendsClause'
				try self.consume(TokenKind.extends)
				try self.parseCommaSeparatedNames(extendsInterfaces)
				continue
			end 'extendsClause'

			if self.at(TokenKind.uses) 'usesClause'
				try self.consume(TokenKind.uses)
				try self.parseCommaSeparatedNames(associatedTypeNames)
				continue
			end 'usesClause'

			break
		end 'clauses'
	end 'parseInterfaceHeaderClauses'

	// A comma-separated list of identifiers (`A, B, C`) into `out` — the shared reader behind an
	// interface's `extends`/`uses` lists and a `type`'s `implements` list.
	function parseCommaSeparatedNames(out ByteArrayArray) throws ParseError
		out.push((try self.consume(TokenKind.identifier)).value)
		while self.at(TokenKind.comma) 'more'
			try self.consume(TokenKind.comma)
			out.push((try self.consume(TokenKind.identifier)).value)
		end 'more'
	end 'parseCommaSeparatedNames'

	// One `[static] function name(params) [returns Type] [throws E]` interface method SIGNATURE (no body).
	// Its param/return types are rendered to SOURCE strings (see IrInterface) via `renderInterfaceTypeName`
	// — `Self` for the enclosing interface, the alias name for a `named` type, `void` for no return.
	function parseInterfaceMethod(interfaceName ByteArray) returns InterfaceMethodSig throws ParseError
		let isStatic = self.at(TokenKind.static)
		if isStatic 'staticMethod'
			self.advance()
		end 'staticMethod'

		try self.consume(TokenKind.function)
		let nameTok = try self.consume(TokenKind.identifier)

		var paramNames = ByteArrayArray.create()
		var paramTypes = MaxonTypeArray.create()
		var paramRanges = SourceRangeArray.create()
		try self.consume(TokenKind.leftParen)
		try self.parseFunctionParameters(paramNames, paramTypes: paramTypes, paramRanges: paramRanges)
		try self.consume(TokenKind.rightParen)

		let returnType = try self.parseOptionalReturnType()
		// ⭐ **THE `throws E` CLAUSE IS RECORDED, NOT DISCARDED (P1.7a slice 2b-v).** It decides which ABI a
		// witness dispatch of this method uses — the dual-register `witnessTryCall` or the single-register
		// `witnessCall` — and it is the ONLY place that fact exists: a witness method has no callee name for
		// `ProgramSignatures.throwsOf` to answer about. Discarded (slice 1), a throwing interface method
		// dispatched through a witness silently DROPPED its error flag: the caller's `otherwise` never ran and
		// the impl's throw-path primary (0) came back as a real answer.
		let throwsClause = try self.parseOptionalThrowsClause()

		return InterfaceMethodSig.create(nameTok.value, paramNames: paramNames, paramTypeNames: self.renderInterfaceParamTypes(paramTypes, interfaceName: interfaceName), returnTypeName: self.renderInterfaceReturnType(returnType, interfaceName: interfaceName), isStatic: isStatic, throwsClause: throwsClause)
	end 'parseInterfaceMethod'

	// Render each of an interface method's parameter types to its source string, parallel to `paramTypes`.
	function renderInterfaceParamTypes(paramTypes MaxonTypeArray, interfaceName ByteArray) returns ByteArrayArray
		var out = ByteArrayArray.create()
		for i in 0 upto paramTypes.count() 'each'
			out.push(self.renderInterfaceTypeName(try paramTypes.get(i) otherwise panic("renderInterfaceParamTypes: paramTypes.get OOB at {i}"), interfaceName: interfaceName))
		end 'each'
		return out
	end 'renderInterfaceParamTypes'

	// Render an interface method's RETURN to its source string — `void` for no `returns`, else the type.
	function renderInterfaceReturnType(returnType MaxonReturnType, interfaceName ByteArray) returns ByteArray
		return match returnType 'r'
			void gives InterfaceVoidTypeName
			value(inner) gives self.renderInterfaceTypeName(inner, interfaceName: interfaceName)
		end 'r'
	end 'renderInterfaceReturnType'

	// Render a parsed interface-signature `MaxonType` to the SOURCE string the conformance check compares
	// and prints. `Self` (a `structRef` whose id is the interface's own name) renders as `Self`; every
	// other type defers to `maxonTypeName` (the alias name for a `named`, the type name for a struct, the
	// tag word for a primitive) — all read off the LOCAL interner, but the STRING is interner-independent,
	// so it matches the impl side rendered off the project interner (the same property `paramAggregateNames`
	// relies on). Rendered at parse time, so `mergeArtifact` folds an interface with no id to remap.
	function renderInterfaceTypeName(t MaxonType, interfaceName ByteArray) returns ByteArray
		if maxonTypeTag(t) == ValueTypeTag.structRef 'structRefType'
			let refName = try self.artifact.typeNames.nameOf(typeNameIdOf(t)) otherwise panic("renderInterfaceTypeName: structRef id {typeNameIdOf(t)} not in the local interner")
			if refName.equals(interfaceName) 'selfRef'
				return InterfaceSelfTypeName
			end 'selfRef'
		end 'structRefType'
		return maxonTypeName(t, typeNames: self.artifact.typeNames).toByteArray()
	end 'renderInterfaceTypeName'

	// The `implements I1, I2 [with …]` conformance clause of a `type` declaration (P1.7a slice 1). Records
	// a ConformanceDecl anchored on the type NAME token, or does nothing when there is no clause. A `with`
	// binds an interface's associated types (slice 2); it is consumed and dropped so a conforming type that
	// names one still parses.
	function parseTypeImplementsClause(nameTok Token) throws ParseError
		if not self.at(TokenKind.implements) 'noImplements'
			return
		end 'noImplements'
		try self.consume(TokenKind.implements)

		var interfaceNames = ByteArrayArray.create()
		interfaceNames.push((try self.consume(TokenKind.identifier)).value)
		try self.skipOptionalWithClause()
		while self.at(TokenKind.comma) 'moreInterfaces'
			try self.consume(TokenKind.comma)
			interfaceNames.push((try self.consume(TokenKind.identifier)).value)
			try self.skipOptionalWithClause()
		end 'moreInterfaces'

		self.artifact.recordConformance(ConformanceDecl.create(nameTok.value, interfaceNames: interfaceNames, nameLine: nameTok.line, nameColumn: nameTok.column, filePath: self.filePath))
	end 'parseTypeImplementsClause'

	// A `with <TypeArg>` / `with (<TypeArgs>)` associated-type binding after an interface name in an
	// `implements` clause (slice 2). Consumed and dropped: slice 1 records only the interface NAMES, and no
	// enabled case binds one. A parenthesized list skips balanced; a single arg is one type reference.
	function skipOptionalWithClause() throws ParseError
		if not self.at(TokenKind.with) 'noWith'
			return
		end 'noWith'
		try self.consume(TokenKind.with)
		if self.at(TokenKind.leftParen) 'parenList'
			_ = self.skipBalancedParens()
			return
		end 'parenList'
		_ = try self.parseTypeReference()
	end 'skipOptionalWithClause'

	// Parse an `enum`/`union` declaration (P1.1b wave B):
	//
	//     enum Color
	//         red
	//         green = 5
	//         blue
	//     end 'Color'
	//
	// ⭐ **THE DECLARATION EMITS NOTHING** — like a `type`, its whole effect is the `EnumLayout`
	// recorded below, which `Color.red` reads a case's TAG out of and an enum `match` reads the case
	// SET out of. `union` and `enum` share this routine entirely: only the diagnostic wording later
	// differs, carried by `layout.isUnion`.
	//
	// PAYLOAD-FREE ONLY. A payload (`case foo(x Int)`), a string/char/struct/function backing, and a
	// method inside the body each name their own later rung rather than being mapped onto the integer
	// path where they would silently mean something else.
	function parseEnumDeclaration(isUnion bool) throws ParseError
		try self.consume(TokenKind.union if isUnion else TokenKind.enum)
		let nameTok = try self.consume(TokenKind.identifier)
		try self.requireUnreservedName(nameTok)
		try self.requireTypeNameNotCompilerOwned(nameTok)
		try self.skipOptionalImplementsClause()

		var layout = EnumLayout.create(nameTok.value, isUnion: isUnion)
		var state = EnumBackingState.create()

		while true 'cases'
			self.skipNewlines()
			if self.atEnumBodyEnd() 'closes'
				break
			end 'closes'
			if self.isEof() 'eof'
				let tok = self.current()
				throw ParseError.unexpectedEof(tok.line, column: tok.column)
			end 'eof'

			// A method inside an enum/union body — its whole surface (a receiver bound to an enum
			// value, `match self`) is a later rung. Rejected here, positioned, rather than silently
			// skipped (which would strand the method's `end` and misparse the rest). `function` alone
			// is a legal CASE name, so only `function <name>(` is a method (`atEnumMethodStart`).
			if self.atEnumMethodStart() 'method'
				let tok = self.current()
				throw ParseError.unsupported("a method on `{layout.kindWord()} {String.from(nameTok.value)}` (methods on an enum/union — a receiver bound to an enum value, `match self` — arrive with a later rung)", line: tok.line, column: tok.column)
			end 'method'

			try self.readEnumCaseInto(layout, state: state)
		end 'cases'

		try self.consume(TokenKind.end)
		self.skipOptionalLabel()

		self.artifact.recordEnumType(layout)
	end 'parseEnumDeclaration'

	// Is the cursor on the `end` that CLOSES an enum/union body — as opposed to a case NAMED `end`?
	//
	// ⚠ **`end` IS A LEGAL CASE NAME** (`keyword-as-case-name.md` declares one), so the terminator
	// cannot be recognized by the `end` keyword alone. The rule, mirrored byte-for-byte from the
	// bootstrap (`IsEndOfBlock`, 2-Parser.cs:3173): a terminating `end` is followed by the block
	// LABEL (a character literal) or by end-of-file; an `end` followed by anything else — a newline,
	// another case — is the case named `end`. Every corpus enum closes with a labelled `end 'Name'`,
	// which this recognizes; a bare unlabelled `end` mid-body would be read as a case, exactly as the
	// bootstrap reads it.
	function atEnumBodyEnd() returns bool
		if not self.at(TokenKind.end) 'notEnd'
			return false
		end 'notEnd'
		let next = self.kindAt(self.pos + 1)
		return next == TokenKind.charLiteral or next == TokenKind.eof
	end 'atEnumBodyEnd'

	// Does the cursor open a METHOD inside an enum/union body — `[export|static] function <name>(`?
	//
	// ⚠ **`function` IS ALSO A LEGAL CASE NAME** (`keyword-as-case-name.md` declares one), so a bare
	// `function` keyword does NOT open a method: a method is `function` followed by a NAME and a `(`
	// — the shared `functionDeclarationAt`, which the declaration sweep reads for the same reason.
	// Mirrors the bootstrap's `IsEnumMethodStart` (2-Parser.cs:3155). Methods on an enum are a later
	// rung, so this predicate exists only to REJECT one cleanly rather than misparse it. All this adds
	// is the leading modifier an enum body may carry before the keyword.
	function atEnumMethodStart() returns bool
		var p = self.pos
		if self.kindAt(p) == TokenKind.export or self.kindAt(p) == TokenKind.static 'modifier'
			p = p + 1
		end 'modifier'
		return self.functionDeclarationAt(p)
	end 'atEnumMethodStart'

	// Read ONE enum/union case into `layout`, threading the tag counter + backing through `state`.
	// Reports the three declaration diagnostics: E3030 (duplicate case name), E3031 (duplicate raw
	// value), E3032 (raw value type mismatch). SHARED by the real parse and the tolerant sweep
	// (`recordScannedEnum`), which wraps it in `otherwise` — so the two cannot drift on how a tag is
	// assigned, the one fact they MUST agree on (the sweep's layout is what the parser reads tags
	// from at a use site).
	function readEnumCaseInto(layout EnumLayout, state EnumBackingState) throws ParseError
		let nameTok = try self.readEnumCaseNameToken()
		let caseName = nameTok.value

		// A `__`-prefixed case is reserved. Checked before the duplicate/backing rules so the
		// reservation is reported at the name, and — as with the field reader — the tolerant sweep
		// (`recordScannedEnum`) swallows the throw and leaves the diagnostic to the real parse.
		try self.requireUnreservedName(nameTok)

		// E3030 — checked at the second declaration, as the bootstrap positions it.
		if layout.hasCase(caseName) 'duplicateCase'
			throw ParseError.enumDuplicateCase(String.from(caseName), line: nameTok.line, column: nameTok.column)
		end 'duplicateCase'

		// A PAYLOAD case (`circle(radius Integer)`) — P1.3 slice 1. It takes an auto-increment tag
		// like a bare case (a payload case carries no explicit raw value in the corpus) and captures
		// its declared field types. The managed/float REJECTION is NOT here — it would `throw` in the
		// tolerant sweep (`recordScannedEnum`'s `otherwise break`), truncating the layout and
		// misassigning every later case's tag. The construct and extract sites resolve each field
		// type and reject the ones slice 1 cannot lower, exactly as a struct's `structRef` field is
		// refused at its USE site (`requireStructBase`) rather than at declaration.
		if self.at(TokenKind.leftParen) 'payload'
			let payloads = try self.readPayloadFieldsInto()
			try self.requireIntBacking(state, caseTok: nameTok)
			let tag = state.nextTag
			state.nextTag = state.nextTag + 1
			try self.appendEnumCase(layout, caseName: caseName, tag: tag, rawDisplay: "{tag}", caseTok: nameTok, payloads: payloads)
			return
		end 'payload'

		if not self.at(TokenKind.equals) 'bareName'
			// A bare case takes the auto-increment tag and requires integer backing.
			try self.requireIntBacking(state, caseTok: nameTok)
			let tag = state.nextTag
			state.nextTag = state.nextTag + 1
			try self.appendEnumCase(layout, caseName: caseName, tag: tag, rawDisplay: "{tag}", caseTok: nameTok, payloads: PayloadFieldArray.create())
			return
		end 'bareName'

		try self.consume(TokenKind.equals)

		// A FLOAT raw value, positive or NEGATED (`= 1.1`, `= -2.2`): its tag is the IEEE-754 BIT PATTERN
		// (matched by an i64 compare, exactly as an int tag is), and its display is the float's source
		// text. A leading `-` folds into the sign bit via `negatedFloatBits` — the same spelling
		// `parseNegatedNumericLiteral` uses in expression position — because a negated float is still a
		// FLOAT, not the int path `readEnumIntRawValue` would send it down (where the float literal after
		// the minus is a type mismatch, not the negation the source wrote).
		let floatNegated = self.at(TokenKind.minus) and self.peekKind() == TokenKind.floatLiteral
		if floatNegated or self.at(TokenKind.floatLiteral) 'floatValue'
			if floatNegated 'consumeMinus'
				try self.consume(TokenKind.minus)
			end 'consumeMinus'
			let floatTok = try self.consume(TokenKind.floatLiteral)
			let magnitude = try self.floatLiteralBits(floatTok)
			let bits = negatedFloatBits(magnitude) if floatNegated else magnitude
			let rawDisplay = "-{String.from(floatTok.value)}" if floatNegated else String.from(floatTok.value)
			try self.requireFloatBacking(state, caseTok: nameTok)
			try self.appendEnumCase(layout, caseName: caseName, tag: bits, rawDisplay: rawDisplay, caseTok: nameTok, payloads: PayloadFieldArray.create())
			return
		end 'floatValue'

		// An INTEGER raw value (possibly negated). It resets the auto-increment counter to value + 1,
		// which is what makes `enum E { a = 5  b }` give `b` the tag 6.
		let intValue = try self.readEnumIntRawValue()
		try self.requireIntBacking(state, caseTok: nameTok)
		state.nextTag = intValue + 1
		try self.appendEnumCase(layout, caseName: caseName, tag: intValue, rawDisplay: "{intValue}", caseTok: nameTok, payloads: PayloadFieldArray.create())
	end 'readEnumCaseInto'

	// Parse a payload field list `(name Type, name2 Type2)` for a `union`/`enum` case, into a
	// `PayloadField` array in slot order. Shared by the real parse and the tolerant sweep, so it
	// captures types WITHOUT rejecting the managed/float ones — see `readEnumCaseInto`'s payload arm
	// for why a rejection here would corrupt the sweep. `parseTypeReference` is the same type reader
	// a struct field and a parameter use, so a payload's type is spelled by one grammar.
	function readPayloadFieldsInto() returns PayloadFieldArray throws ParseError
		try self.consume(TokenKind.leftParen)
		var fields = PayloadFieldArray.create()

		while true 'fieldLoop'
			let nameTok = try self.consume(TokenKind.identifier)
			// A `__`-prefixed field is reserved, at the name, exactly as a struct field's is
			// (`readStructFieldInto`). The tolerant sweep swallows the throw and leaves the diagnostic
			// to the real parse.
			try self.requireUnreservedName(nameTok)
			let fieldType = try self.parseTypeReference()
			fields.push(PayloadField.create(nameTok.value, declaredType: fieldType))

			if not self.at(TokenKind.comma) 'endFields'
				break
			end 'endFields'
			try self.consume(TokenKind.comma)
		end 'fieldLoop'

		try self.consume(TokenKind.rightParen)
		return fields
	end 'readPayloadFieldsInto'

	// Read the token that NAMES a case — an identifier, or a keyword used as one. A string/char
	// literal here is a string/char BACKING (a later rung), reported as such rather than as a bad
	// name; anything else is malformed.
	function readEnumCaseNameToken() returns Token throws ParseError
		let tok = self.current()

		if self.at(TokenKind.stringLiteral) or self.at(TokenKind.charLiteral) 'stringCharBacking'
			throw ParseError.unsupported("a string- or char-backed enum/union case ({String.from(tok.value)}) — string/char backing, and the `.rawValue`/`.name` accessors that read it, arrive with String (P1.2)", line: tok.line, column: tok.column)
		end 'stringCharBacking'

		if not tokenNamesEnumCase(tok) 'notACaseName'
			throw ParseError.unexpectedToken("an enum case name", got: tok.kind.rawValue, line: tok.line, column: tok.column)
		end 'notACaseName'

		self.advance()
		return tok
	end 'readEnumCaseNameToken'

	// Parse an INTEGER raw value (`= 200`, `= -1`) — the same literal reading `parseRangeBound` does,
	// minus the type-qualified bounds a raw value cannot be. A string/identifier/struct raw value is
	// a backing this rung does not have, named rather than silently mapped onto the int path.
	function readEnumIntRawValue() returns ParsedInt throws ParseError
		if self.at(TokenKind.minus) 'negative'
			try self.consume(TokenKind.minus)
			let tok = try self.consume(TokenKind.intLiteral)
			return try self.intLiteralValue(tok, negated: true)
		end 'negative'

		if self.at(TokenKind.intLiteral) 'literal'
			let tok = try self.consume(TokenKind.intLiteral)
			return try self.intLiteralValue(tok, negated: false)
		end 'literal'

		let tok = self.current()
		throw ParseError.unsupported("a raw value of kind '{tok.kind.rawValue}' (only integer and float raw values are parsed; string, char, struct and function backings arrive with later rungs)", line: tok.line, column: tok.column)
	end 'readEnumIntRawValue'

	// Fix the backing to INTEGER, or raise E3032 if a FLOAT backing was already fixed. `caseTok`
	// positions the diagnostic — the bootstrap anchors a mismatch at the offending case.
	function requireIntBacking(state EnumBackingState, caseTok Token) throws ParseError
		if state.backingResolved and state.backingIsFloat 'mismatch'
			throw ParseError.enumRawValueTypeMismatch("expected float, got int", line: caseTok.line, column: caseTok.column)
		end 'mismatch'
		state.backingResolved = true
		state.backingIsFloat = false
	end 'requireIntBacking'

	// Fix the backing to FLOAT, or raise E3032 if an INTEGER backing was already fixed. The exact
	// `expected int, got float` phrasing is the bootstrap's, gated by `error.raw-value-type-mismatch`.
	function requireFloatBacking(state EnumBackingState, caseTok Token) throws ParseError
		if state.backingResolved and not state.backingIsFloat 'mismatch'
			throw ParseError.enumRawValueTypeMismatch("expected int, got float", line: caseTok.line, column: caseTok.column)
		end 'mismatch'
		state.backingResolved = true
		state.backingIsFloat = true
	end 'requireFloatBacking'

	// Append a case after checking E3031 (duplicate raw value) — a linear scan of the tags recorded
	// so far, positioned at the offending case. `rawDisplay` is how the value is written (the int, or
	// the float's source text), which is what the message prints.
	function appendEnumCase(layout EnumLayout, caseName ByteArray, tag ParsedInt, rawDisplay String, caseTok Token, payloads PayloadFieldArray) throws ParseError
		for i in 0 upto layout.caseCount() 'eachExisting'
			if layout.tagOfIndex(i) == tag 'duplicateRawValue'
				throw ParseError.enumDuplicateRawValue(rawDisplay, line: caseTok.line, column: caseTok.column)
			end 'duplicateRawValue'
		end 'eachExisting'
		layout.addCase(caseName, tag: tag, payloads: payloads)
	end 'appendEnumCase'

	// One member of a type body that is not a field: `[export] [static] function …`.
	//
	// ⭐ **`static` IS THE WHOLE DIFFERENCE, AND IT IS ONE BOOLEAN.** A `static function create()`
	// is a free function with a qualified name; a `function area()` is the same thing plus a
	// RECEIVER — `__self` at parameter 0, and every field of the enclosing type bound by name so a
	// bare `width` inside it means `self.width`. Both are built by the same `parseFunction`,
	// because a method IS a function: there is no method table and nothing for a call to dispatch
	// through. `enclosingType` supplies the qualification and is already set.
	//
	// The receiver is passed down as a flag and NOT recorded as one: `parseFunction` turns it into
	// a parameter named `SelfParamName` at position 0, and every later reader asks
	// `FuncSignature.takesReceiver`, which reads that name back. See there — one fact, one home.
	function parseTypeMember() throws ParseError
		var visibility = Visibility.file
		if self.at(TokenKind.export) 'exported'
			self.advance()
			visibility = Visibility.module
		end 'exported'

		let isStatic = self.at(TokenKind.static)
		if isStatic 'staticMember'
			self.advance()
		end 'staticMember'

		// A NESTED (inner) ranged typealias (P1.6-C) — `export typealias Idx = int(0 to u64.max)`. The
		// `export` (visibility) is already consumed above; a nested typealias takes no `static`. It records the
		// bare member into `enclosingInnerAliases` so the rest of the body's bare `Idx` references resolve
		// (whole-program recording is the sweep's — this artifact needs only the local set). Its visibility is
		// inert at this rung (an inner alias erases to `integer`, so it names no cross-file value).
		if self.at(TokenKind.typealias) 'nestedTypeAlias'
			if isStatic 'staticInnerAlias'
				let tok = self.current()
				throw ParseError.unsupported("a nested typealias cannot be `static` — it is a per-type declaration, not a member function", line: tok.line, column: tok.column)
			end 'staticInnerAlias'
			// The whole-program recording (into `innerAliases`/`genericAliases`) is the sweep's; the real parse
			// needs only the local `enclosingInnerAliases` population that `readNestedTypeAlias` performs, so the
			// returned shape is discarded here.
			_ = try self.readNestedTypeAlias()
			return
		end 'nestedTypeAlias'

		if not self.at(TokenKind.function) 'notFunction'
			let tok = self.current()
			throw ParseError.unexpectedToken(TokenKind.function.rawValue, got: tok.kind.rawValue, line: tok.line, column: tok.column)
		end 'notFunction'

		try self.parseFunction(visibility, takesReceiver: not isStatic)
	end 'parseTypeMember'

	// Parse a function: `[static] function <name>(<params>) [returns <Type>] <body> end
	// [label]`. M5 adds parameters (`name type`, comma-separated); there is still no
	// `main` qualification (single-file build), so the declared name is used verbatim
	// for registry keys — `main` stays `main`. P1.0r adds the ONE qualification there is:
	// a function declared inside a `type` body is `Point.create` (`declaredMethodName`).
	//
	// `takesReceiver` is set only by `parseTypeMember`, for a member with no `static`. It adds ONE
	// thing — a leading parameter — and everything else about an instance method follows from
	// that, through machinery that already existed: the call is an ordinary direct call, the
	// receiver is an ordinary argument, `slotCallArgs` slots it at position 0 because it is
	// positional, and the register ABI hands it to the callee in argument register 0.
	function parseFunction(visibility Visibility, takesReceiver bool) throws ParseError
		try self.consume(TokenKind.function)
		let nameTok = try self.consume(TokenKind.identifier)
		// The BARE name only — a method's `Type.` qualification is applied below by
		// `declaredMethodName`, so `Point.create` is checked as `create` and the reserved test never
		// sees the type prefix (`Self` is fine; a `__method` name is not).
		try self.requireUnreservedName(nameTok)
		// `Point.create` inside `type Point`, the bare token at file scope. The SAME derivation the
		// declaration sweep records the signature under, so the key an `IrFunction` carries and the
		// key `mintCallResult` types a call from are one name.
		let name = self.declaredMethodName(nameTok)

		// Parameters are parsed into parallel name/type lists BEFORE the scope reset:
		// binding them needs the fresh per-function scope + value numbering, which is
		// re-seeded at the resulting paramCount just below. Parsing itself only
		// consumes tokens, so it needs no scope.
		var paramNames = ByteArrayArray.create()
		var paramTypes = MaxonTypeArray.create()
		// Parallel to `paramNames`: each parameter's name-token span, so `bindParameters` can
		// record a ValueOrigin at the DECLARATION for parameter `i` — the source site the
		// E5001 diagnostic points at when a parameter is in a register-pressure blocking set.
		var paramRanges = SourceRangeArray.create()

		// ⭐ **THE RECEIVER IS AN ORDINARY PARAMETER, PUSHED FIRST.** That is the entire mechanism:
		// it occupies position 0, so it is ValueId 0 by the same Std-ABI seeding every parameter
		// gets, and no part of the call path, the lowering or the backend learns that methods
		// exist. It is pushed BEFORE `parseFunctionParameters` so the user's own parameters land
		// after it — which also means the receiver is inside the ABI count `requireAbiParamCount`
		// judges, correctly: it occupies an argument slot exactly like a declared parameter.
		//
		// It is typed `structRef(enclosingType)` — the same `Self` means here, through the same
		// routine that resolves the `Self` keyword, so a receiver and a `returns Self` cannot come
		// to disagree about which type encloses them.
		//
		// Its span is the METHOD NAME, because no source token declares it. That is the choice
		// `closeFunctionBody` makes for its synthetic `retVoid` and for E3013, and for the same
		// reason: the name is where a reader looks when something about the function's own shape is
		// at fault.
		if takesReceiver 'receiverParam'
			paramNames.push(SelfParamName)
			paramTypes.push(try self.enclosingStructType(nameTok))
			paramRanges.push(SourceRange.ofToken(nameTok))
		end 'receiverParam'

		try self.consume(TokenKind.leftParen)
		try self.parseFunctionParameters(paramNames, paramTypes: paramTypes, paramRanges: paramRanges)
		try self.consume(TokenKind.rightParen)

		// ⭐ **A STRUCT PARAMETER OR RETURN TYPE IS RE-TAGGED `structRef` HERE**, in the real parse where
		// the whole-program struct registry is complete — the step `parseTypeReference` could not take in
		// the tolerant sweep (see `resolveNamedStruct`). Both lists are rewritten BEFORE anything reads
		// them: the value-tag seeding below, `bindParameters`, `func.maxonParamTypes`, the recorded
		// signature, and `parseReturnStatement`'s declared-type check all then see a struct as a struct.
		paramTypes = self.resolveNamedStructAll(paramTypes)
		let returnType = self.resolveNamedStructReturn(try self.parseOptionalReturnType())
		// The `throws E` clause (P1.4b) — stamped onto the function so the body parse (`throw`/propagate)
		// and the lowering (`ret` → `errorReturn` inside a throwing function) can read it off `func`.
		let throwsClause = try self.parseOptionalThrowsClause()

		// Fresh per-function value numbering, seeded at the function's paramCount so
		// parameter ids occupy 0..paramCount-1 by Std-ABI convention (a body value
		// then starts at paramCount — see IrValueId's ValueIdRef contract). The value-TYPE
		// column is seeded in lockstep, with the parameters' declared types, so
		// `valueTypes[i]` is parameter `i`'s type from the very first lookup.
		//
		// ⭐ **THE UNIFORM ABI APPENDS A COMPANION ENVIRONMENT PARAMETER PER FUNCTION-TYPED PARAMETER
		// (P1.5-A2b-2).** A value passed DOWN to a `function`-typed parameter carries an environment (a
		// capturing closure's block, or null); this function's own `f(x)` call threads it, so the environment
		// must arrive as a parameter. The companions are appended AFTER the user parameters — so every user
		// parameter keeps its own ABI position and the call machinery needs no source-slot→ABI-slot remap — and
		// the full count reserves their ValueIds here so the body numbers after them. `maxonParamTypes` and the
		// recorded signature keep the USER parameters only (an env companion is a lowering detail, never a
		// source argument); `LowerMaxonToStd.transferFuncs` grows the Std parameter list to match `paramCount`.
		let userParamCount = paramNames.count()
		// ⭐ **A GENERIC METHOD THAT READS `sizeof(T)` NEEDS A HIDDEN LAYOUT-DESCRIPTOR PARAMETER**
		// (P1.6-B1, the dictionary). It is reserved HERE — before value numbering — as ONE extra trailing
		// slot, so its ValueId lands in `[0, paramCount)` and the backend's param-capture clobber guard
		// (`ParamCrossForbid`, which only protects `vid < paramCount`) covers it exactly like a user
		// parameter; a fresh id past the dense space would be left unprotected and could be clobbered by a
		// sibling capture. The need is the TRANSITIVE fixpoint `computeTypeDescriptorNeeds` computed when this
		// type declaration opened (direct `sizeof(T)` OR a self-call to a sibling that needs one), keyed by the
		// bare method name — decided BEFORE the body is parsed, because the slot must be reserved before any
		// body value is numbered. `LowerMaxonToStd` detects the reserved slot by param count, so a caller
		// appends the descriptor argument for exactly the methods that carry the param.
		var needsLayoutParam = false
		if not self.enclosingTypeParams.isEmpty() 'genericMethod'
			needsLayoutParam = try self.typeDescriptorNeeds.get(nameTok.value) otherwise false
		end 'genericMethod'

		// ⛔ **A RECEIVERLESS (static) LAYOUT-NEEDING function must RETURN `Self` (P1.7 slice 3b-i).** A `static`
		// has no `self` to carry the type parameter's layout descriptor; a caller sources it instead from the
		// call's RESULT, which is the concrete instance ONLY when the static returns the enclosing type
		// (`create() returns Self`, retyped by `retypeGenericAliasConstructorResult`). A static that constructs an
		// opaque `Array` (or reads `sizeof(T)`) but returns some other type leaves the caller no descriptor
		// source, so `materializeStaticConstructorLayout` would panic on the non-instance result — reject it here
		// cleanly, the way a receiverless `sizeof(T)` body is. An instance method sources it from `self`, so this
		// is gated on `not takesReceiver`.
		if needsLayoutParam and not takesReceiver and not self.returnsEnclosingType(returnType) 'staticLayoutNeedsSelfReturn'
			throw ParseError.unsupported("a `static function` that needs the type parameter's layout descriptor — it constructs an opaque type-parameter `Array` (`ElementArray.create()`) or reads `sizeof` of the type parameter — must return `Self` so the caller can source the descriptor from the instance the static builds; a static returning any other type has no descriptor source (build the array or read the size through an instance method on `self`, or return `Self`). Threading a descriptor from a static call site's alias is a later slice", line: nameTok.line, column: nameTok.column)
		end 'staticLayoutNeedsSelfReturn'

		let layoutParamCount = 1 if needsLayoutParam else 0
		// ⭐ **A HIDDEN WITNESS PARAMETER PER `where` CONSTRAINT (P1.7a slice 2a, the dictionary's dispatch
		// half).** An INSTANCE method of a constrained generic type carries one witness pointer per constraint,
		// TRAILING after the layout descriptor: `[user][env][layout][witness_0..k]`, index-aligned to
		// `enclosingWhereConstraints`. The reservation is UNCONDITIONAL on instance methods (not gated on
		// whether this method actually dispatches), so the type's instance-method ABI is uniform and every
		// caller passes the witnesses; a `static function` carries none (it has no `self` to source a witness
		// from, and a static that dispatches is a later slice). `LowerMaxonToStd` splits layout from witness by
		// this same rule (the enclosing type's constraint count + `takesReceiver`), so the count is derivable
		// whole-program without a per-function field.
		let witnessParamCount = self.witnessParamCountFor(takesReceiver)
		let paramCount = userParamCount + self.countFunctionParams(paramTypes) + layoutParamCount + witnessParamCount
		try requireAbiParamCount(paramCount, anchor: nameTok)
		self.scope.reset()
		self.valueIds = ValueIdRef.create(paramCount)
		self.mutableVars = VarInfoArray.create()
		// Re-CREATED, not cleared, exactly as every other per-function column is: a stray owned
		// binding carried across a function boundary would emit a `__mm_decref` of a value from the
		// PREVIOUS function's SSA space — a wild pointer, and one the leak gate could not even
		// report, because the count would still balance.
		self.ownedBindings = VarInfoArray.create()
		// Re-created per function for the same reason `ownedBindings` is: a stray pending temp carried
		// across a function boundary would decref a value from the PREVIOUS function's SSA space.
		self.pendingTempDrops = ValueIdArray.create()
		// Invalidated per function for the same reason: a stale `box` id names a value in the PREVIOUS
		// function's SSA space, so a move-out would null the wrong slot.
		self.lastFieldReadValid = false
		self.loops = LoopContextArray.create()
		// ⚠ Balanced by construction — pushed and popped around each `for` body — EXCEPT on the error path,
		// where a `ParseError` thrown inside a body skips the release. So the reset is real; it points back
		// at the shared empty rather than allocating (see `sharedEmptyIterationLocks`).
		self.iterationLockedBindings = sharedEmptyIterationLocks
		self.valueTags = ValueTypeTagArray.create()
		self.valueNameIds = TypeNameIdArray.create()
		self.valueConsts = ParsedIntArray.create()
		self.valueConstKnown = BoolArray.create()
		self.valueOwnsHeap = BoolArray.create()
		self.valuePromiseMarks = BoolArray.create()
		self.valueIsCapturingClosure = BoolArray.create()
		self.valueClosureEnv = ValueIdArray.create()
		// Per-function, like the sibling value columns: a value's per-instance alias provenance names an id
		// in THIS function's SSA space (P1.6-C). Points at the SHARED empty until the function constructs an
		// instance (`recordValueInstanceAlias` copy-on-writes), so a generics-free function allocates nothing.
		self.valueInstanceAlias = sharedEmptyInstanceAliasMap
		// Per-function for the identical reason (P1.7 slice 2b): a marked value names an id in THIS
		// function's SSA space, so a mark carried over would name an unrelated value in the next one.
		self.immutableGlobalReads = sharedEmptyImmutableGlobalReads
		// P1.9 range-check accumulators, reset per function (see the field header). The return-alias
		// name is fixed by the DECLARED return type and known here, before the body is parsed; the two
		// site lists fill as the body emits casts / returns.
		self.rangeCheckCastSites = RangeCheckCastSiteArray.create()
		self.rangeCheckReturnSites = RangeCheckReturnSiteArray.create()
		self.rangeCheckReturnAlias = self.rangedReturnAliasName(returnType)
		for paramType in paramTypes 'seedParamTypes'
			// ⭐ A FLOAT-ALIAS parameter is a genuine FLOAT value, so its value TAG must be `float`, not the
			// `named` a ranged alias otherwise carries — exactly as F2a resolves a float-returning callee's
			// result type at `mintOwnedCallResult`. Left `named`, arithmetic on the parameter reads it as
			// integral (`operandsAreFloat` is true and `promoteToFloat` is NOT idempotent on it), emitting a
			// spurious `siToFp` on an already-float value that the backend rejects as a cross-file convert.
			// An INT alias stays `named` (its name carries the signedness `valueIsUnsigned` reads); only a
			// proven float alias is lifted (see `resolveFloatAliasType`). `paramTypes` itself is UNCHANGED —
			// the recorded signature, `func.maxonParamTypes` and the parameter bindings keep the declared
			// alias — so this touches ONLY the value-tag column the operators dispatch on.
			self.recordValueType(self.resolveFloatAliasType(paramType))
		end 'seedParamTypes'

		// Seed and wire the companion environment parameters — AFTER the user parameters, so they occupy
		// ValueIds `userParamCount`.. (P1.5-A2b-2). Each function-typed user parameter's `valueClosureEnv` is
		// then pointed at its companion, so the body's `f(x)` threads that env (`emitClosureEnvArg`).
		self.bindClosureEnvParams(paramTypes, paramRanges: paramRanges, userParamCount: userParamCount)

		// Seed the hidden layout-descriptor parameter's value columns (P1.6-B1) — AFTER the user + env
		// slots, so it occupies the LAST param ValueId (`paramCount - 1`). It is an i64 pointer, unnamed
		// (`bindParameters` never binds it — only the `sizeof(T)` lowering reads it, by position), and its
		// span is the method name (no source token declares it), exactly like an env companion. Seeding here
		// keeps every value column dense through the parameter block.
		if needsLayoutParam 'seedLayoutParam'
			self.recordValueType(MaxonType.integer)
			self.artifact.recordParamOrigin((paramCount - witnessParamCount - 1) as ValueId, range: SourceRange.ofToken(nameTok))
		end 'seedLayoutParam'

		// Seed the hidden witness parameters (P1.7a slice 2a) — AFTER the layout slot, so they occupy the FINAL
		// `witnessParamCount` ValueIds (`paramCount - witnessParamCount .. paramCount - 1`). Each is an i64
		// witness-table pointer, unnamed (only the witness dispatch / forwarding lowering reads them, by
		// position), its span the method name (no source token declares it), exactly like the layout slot.
		// Seeded here keeps every value column dense through the parameter block.
		for w in 0 upto witnessParamCount 'seedWitnessParam'
			self.recordValueType(MaxonType.integer)
			self.artifact.recordParamOrigin((paramCount - witnessParamCount + w) as ValueId, range: SourceRange.ofToken(nameTok))
		end 'seedWitnessParam'

		// `self.valueTags` and `self.valueNameIds` are handed over BY REFERENCE, already seeded with
		// the parameter types. Every `mintValue` below therefore pushes straight into the function's
		// own type columns — there is no second array and no copy-back at the end of the body. It is
		// safe because both are re-created (not cleared) for the next function, so nothing aliases
		// these afterwards. See IrFunction.valueTags / valueNameIds for what the columns are FOR.
		var func = IrFunction.create(name, maxonReturnType: returnType, paramCount: paramCount, maxonParamTypes: paramTypes, valueTags: self.valueTags, valueNameIds: self.valueNameIds, valueClosureEnv: self.valueClosureEnv, valueIsCapturingClosure: self.valueIsCapturingClosure, returnLine: nameTok.line, throwsTypeName: throwsClause)
		func.namespace = self.namespace
		func.visibility = visibility
		func.sourceFilePath = self.filePath
		func.nameLine = nameTok.line
		func.nameColumn = nameTok.column

		// ⭐ **THE FUNCTION IS PUSHED UP FRONT, NOT AT THE END, AND THAT IS WHAT MAKES ValueOrigin CORRECT
		// UNDER NESTED PARSING (P1.5-A2a).** A non-capturing closure literal lifts to a top-level function
		// that is parsed and pushed in the MIDDLE of this body (`parseClosureExpression`), so if this
		// function were pushed only at the END, the closure would take this function's index and every origin
		// keyed to `funcCount()` mid-body would name the wrong function. Pushing here reserves this
		// function's final index BEFORE any closure can push after it, and `currentFuncIndex` records it so
		// `recordValueOrigin`/`recordParamOrigin` (below, in `bindParameters` and every body emit) file
		// against the right function. For a body with no closures the module order is unchanged — a function
		// still completes before the next one starts — so this is index-for-index identical to the old
		// push-at-end for every closure-free program.
		let funcIndex = self.artifact.module.funcCount()
		self.artifact.module.pushFunc(func)
		self.artifact.setCurrentFuncIndex(funcIndex)

		// Create the entry block (registered in func.blockRefs). It also displaces the detached
		// placeholder `currentBlock` was created with — from here on, every op the parser emits goes to a
		// block that belongs to a real function.
		var entry = self.artifact.module.addBlockAt(func, label: b"entry", filePath: self.filePath.toString(), firstLine: nameTok.line)
		self.currentBlock = entry

		// ⭐ **THE FIELD ALIASES ARE DECLARED BEFORE THE PARAMETERS, AND THE ORDER IS THE E3006
		// CONTRACT.** Both a parameter and a body local are bound through `declareValueBinding`,
		// which refuses to displace a self-field alias — so declaring the aliases into the
		// just-`reset` scope FIRST is what puts every colliding declaration on the guarded side of
		// the collision, with its own token in hand to anchor the diagnostic on. Reversed, the
		// parameter would be in place first and the ALIAS would be the one refused, leaving the
		// error to be reported against a field declaration that is not what needs to change.
		if takesReceiver 'selfFieldAliases'
			try self.declareSelfFieldAliases(nameTok)
		end 'selfFieldAliases'

		// Bind each parameter name to its reserved ValueId (i for parameter i), so a
		// body reference resolves straight to the parameter's SSA value — the same
		// value-substitution model `let`/`var` bindings use. Parameters are immutable
		// (a reassignment is E2013); mutating a parameter needs a local shadow. Runs after the push +
		// `setCurrentFuncIndex` above so each parameter's `recordParamOrigin` is filed under this
		// function's real index.
		try self.bindParameters(name, paramNames: paramNames, paramTypes: paramTypes, paramRanges: paramRanges)

		self.skipNewlines()
		// parseStatements threads a "current block" that control-flow statements can
		// move forward (an `if` leaves subsequent statements in its continuation block),
		// so the block it RETURNS — not `entry` — is the one control falls out of.
		var bodyEnd = try self.parseStatements(func, block: entry)
		try self.closeFunctionBody(func, bodyEnd: bodyEnd, nameTok: nameTok)

		try self.consume(TokenKind.end)
		self.skipOptionalLabel()

		self.artifact.recordFuncReturnType(name, returnType: returnType)
		let paramAggregateNames = self.paramAggregateNamesOf(paramTypes)
		self.artifact.recordFuncSignature(name, signature: FuncSignature.create(paramNames, paramTypes: paramTypes, paramAggregateNames: paramAggregateNames), nameLine: nameTok.line, nameColumn: nameTok.column, sourceFilePath: self.filePath)
		self.commitRangeChecks(name)
	end 'parseFunction'

	// Commit this function's accumulated range-check sites to the artifact (P1.9), keyed by `name`.
	// Files nothing when the function has no cast into a ranged alias AND no ranged return — the
	// common case — so the registry stays proportional to the checks a program actually contains.
	function commitRangeChecks(name ByteArray)
		// P1.6-C rides this per-function channel too (`FunctionRangeChecks.valueInstanceAliases`), so a
		// function with NO range check but a generic-instance construction still files an entry. The presence
		// gate reads `count()` (no allocation); only a function that actually constructs an instance packages a
		// fresh map, every other filed entry carries the SHARED empty one.
		let hasInstanceAliases = self.valueInstanceAlias.count() != 0
		if self.rangeCheckCastSites.isEmpty() and self.rangeCheckReturnSites.isEmpty() and not hasInstanceAliases 'noSideData'
			return
		end 'noSideData'
		let instanceAliases = self.packagedInstanceAliases() if hasInstanceAliases else sharedEmptyInstanceAliasNames
		self.artifact.recordFunctionRangeChecks(name, checks: FunctionRangeChecks.create(self.filePath, castSites: self.rangeCheckCastSites, returnAliasName: self.rangeCheckReturnAlias, returnSites: self.rangeCheckReturnSites, valueInstanceAliases: instanceAliases))
	end 'commitRangeChecks'

	// Package the parser's per-value instance-alias provenance (ValueId ⇒ interned alias id, file-local) into
	// the NAME-keyed map SemanticCheck reads (P1.6-C) — names travel the merge with no id remap. Called only
	// when the function actually constructed an instance (`commitRangeChecks` gates on `count()`).
	function packagedInstanceAliases() returns ValueInstanceAliasNameMap
		var out = ValueInstanceAliasNameMap.create()
		for (value, aliasId) in self.valueInstanceAlias 'eachInstanceAlias'
			out.upsert(value, value: self.internedName(aliasId))
		end 'eachInstanceAlias'
		return out
	end 'packagedInstanceAliases'

	// The name of the function's return type IF it is a ranged alias — integer or float — else EMPTY
	// (`ExitCode`, a bare primitive, void: none is a user ranged alias). Asked once per function, off
	// the DECLARED return type, before `resolveTypes` collapses the alias away — which is the whole
	// reason the pass reads a side table rather than the resolved return type.
	//
	// ⭐ A FLOAT ALIAS USED TO BE EXCLUDED HERE, and removing that exclusion is what closed #19. The
	// carve-out was the ONLY thing keeping float bit patterns away from `InsertRangeChecks`' signed
	// integer compares — which made the pass's correctness rest on a caller's discretion. The pass now
	// carries its own float arm (`aliasIsFloat` and the predicates it forks), so the domain is decided
	// where the bounds are read rather than where the site is recorded.
	function rangedReturnAliasName(returnType MaxonReturnType) returns ByteArray
		return match returnType 'r'
			void gives EmptySourceText
			value(inner) gives self.rangedAliasNameOfType(inner)
		end 'r'
	end 'rangedReturnAliasName'

	// ⭐ **THE ONE PLACE A `MaxonType` IS ASKED WHETHER IT DENOTES A RANGED ALIAS.** Every reader of that
	// question goes through here — the return path above, and the `as`-cast path's TWO readers (which
	// alias a narrowing check names, and what that alias's range says about the shift fill).
	//
	// It hands back the ALIAS rather than its name so a caller that needs both answers pays for one
	// lookup: `signatures.aliasOf` is a whole-program registry probe that CONSTRUCTS its `DeclaredAlias`,
	// so a second call is a second allocation and not a second field read. `applyCast` is that caller.
	function declaredAliasOfType(t MaxonType) returns DeclaredAlias
		if maxonTypeTag(t) != ValueTypeTag.named 'notNamed'
			return DeclaredAlias.undeclared
		end 'notNamed'

		return self.signatures.aliasOf(self.internedName(typeNameIdOf(t)), readerFilePath: self.filePath)
	end 'declaredAliasOfType'

	// The ranged-alias name a `named` type denotes, else EMPTY — the RETURN path's spelling of the
	// question above, which stores a name rather than an alias (`commitRangeChecks`).
	function rangedAliasNameOfType(t MaxonType) returns ByteArray
		return match self.declaredAliasOfType(t) 'a'
			declared(alias) gives alias.name
			undeclared gives EmptySourceText
		end 'a'
	end 'rangedAliasNameOfType'

	// Close a function body. `bodyEnd` is the block its last statement left control in;
	// when that block has no terminator, control can FALL OFF THE END of the function
	// and the parser must supply what the source did not:
	//
	//   • VOID function — the implicit `return`. This is why `function doNothing()
	//     end 'doNothing'` compiles (specs/empty-block.md), and it is what every void
	//     function needs, not just an empty one: no void body writes a trailing
	//     `return`. Without it the block reaches the backend in `Terminator.unset`.
	//   • VALUE-returning function — an error: control would leave with no value to
	//     return. E3013, positioned at the function's name (specs/missing-return-error.md).
	//
	// An already-terminated `bodyEnd` covers the UNREACHABLE case for free: an `if`
	// whose branches all return leaves its continuation marked `dead`, which counts as
	// terminated — so `main` ending in a fully-returning `if`/`else` is not a missing
	// return. The synthetic `retVoid` is anchored on the function's name for the same
	// reason E3013 is: no source token spawned it, and the name is where a reader looks
	// for "what does this function return?".
	//
	// Reads the return type off `func` rather than taking it as a parameter — the same
	// place `parseReturnStatement` reads it (see there). `nameTok` still rides along: it
	// is the SPAN the synthetic `retVoid` and the E3013 are anchored on, and a span is
	// not something `IrFunction` carries.
	function closeFunctionBody(func IrFunction, bodyEnd IrBlock, nameTok Token) throws ParseError
		if bodyEnd.isTerminated() 'terminated'
			return
		end 'terminated'

		if not maxonReturnTypeIsVoid(func.maxonReturnType) 'fallsOffEnd'
			throw ParseError.missingReturn(String.from(nameTok.value), line: nameTok.line, column: nameTok.column)
		end 'fallsOffEnd'

		// ⭐ **THE IMPLICIT RETURN IS A RETURN, AND IT OWES THE SAME DROPS** — this is the THIRD
		// exit path a function has, and it was the one that leaked. `emitScopeDrops` hung only off
		// `parseReturnStatement`, so a void function that simply ENDS —
		//
		//     function helper()
		//         let p = Point.create(1, y: 2)
		//     end 'helper'
		//
		// — never dropped `p` and reported exit 101 on a perfectly valid program. It is exactly the
		// case this routine exists for: "no void body writes a trailing `return`" is the sentence
		// three lines up, and it is precisely why the drop cannot live only where `return` is
		// WRITTEN. A VALUE function cannot reach here (E3013 above), so the leak was void-only,
		// which is why no acceptance case saw it.
		//
		// `bodyEnd` IS `self.currentBlock` — `parseStatement` returns the latter and `parseStatements`
		// threads it — so the drops land in the block this terminator ends. The already-terminated
		// case returned above, so a `return` that has dropped cannot be dropped a second time here.
		self.emitScopeDrops(WholeFunctionScopeFloor, anchor: nameTok)
		self.artifact.emitTerminator(bodyEnd, op: MaxonOp.retVoid, range: SourceRange.ofToken(nameTok))
	end 'closeFunctionBody'

	// Parse a comma-separated parameter list `name type[, name type]*` into the
	// parallel `paramNames`/`paramTypes` lists (empty when the list is empty). Each
	// parameter is `name type` — a bare identifier followed by a type reference. A
	// `= <default>` after the type is a later milestone, so it is rejected here with
	// a positioned `unsupported` rather than silently dropped. The caller has already
	// consumed the `(` and consumes the closing `)`.
	function parseFunctionParameters(paramNames ByteArrayArray, paramTypes MaxonTypeArray, paramRanges SourceRangeArray) throws ParseError
		if self.at(TokenKind.rightParen) 'noParams'
			return
		end 'noParams'

		while true 'paramLoop'
			let nameTok = try self.consume(TokenKind.identifier)
			try self.requireUnreservedName(nameTok)
			let paramType = try self.parseTypeReference()

			if self.at(TokenKind.equals) 'hasDefault'
				let eqTok = self.current()
				throw ParseError.unsupported("a default value on parameter '{String.from(nameTok.value)}' (parameter defaults arrive at a later milestone)", line: eqTok.line, column: eqTok.column)
			end 'hasDefault'

			if byteArrayContains(paramNames, name: nameTok.value) 'duplicate'
				throw ParseError.duplicateParameter(String.from(nameTok.value), line: nameTok.line, column: nameTok.column)
			end 'duplicate'

			paramNames.push(nameTok.value)
			paramTypes.push(paramType)
			paramRanges.push(SourceRange.ofToken(nameTok))

			// ⚠ NO COUNT CHECK HERE. There used to be one, testing `paramNames.count()` against the old
			// register cap — a SECOND, and WEAKER, spelling of the ceiling: it counted only the parameters the
			// source writes, while the ABI also passes a companion environment per function-typed parameter,
			// a layout descriptor and one witness per constraint. Two sites, two different counts, one
			// notional rule — the shape this project keeps getting bitten by. The ceiling is now asked exactly
			// once, of the ABI count, by `requireAbiParamCount`; both callers of this routine
			// (`parseFunction`, `parseClosureExpression`) ask it after they know their own full count.
			if not self.at(TokenKind.comma) 'endParams'
				break
			end 'endParams'
			try self.consume(TokenKind.comma)
		end 'paramLoop'
	end 'parseFunctionParameters'

	// Bind each parameter name to its reserved SSA ValueId in the fresh function
	// scope: parameter `i` is ValueId `i` (the ids 0..paramCount-1 the value
	// numbering reserved). Bound as an immutable value binding, so a body reference
	// resolves to the parameter value and a reassignment is rejected as immutable.
	//
	// A parameter of an instance method may COLLIDE with a field of the enclosing type —
	// `function bump(count Integer)` inside a `type Counter` that declares `count`. The aliases are
	// already in scope by now (see `parseFunction`), so `declareValueBinding` refuses it and this
	// is where that refusal becomes E3006, anchored on the PARAMETER's own name token, which is
	// the declaration that has to change. The bootstrap reports the identical program at the
	// identical token.
	function bindParameters(funcName ByteArray, paramNames ByteArrayArray, paramTypes MaxonTypeArray, paramRanges SourceRangeArray) throws ParseError
		// ⭐ **ONLY AN INSTANCE METHOD's feed is an OPAQUE-ARRAY feed** (P1.7 slice 3b-v). A feed can be an ARRAY
		// feed (`self.items.push(item)` / a sibling forward — marked for instance methods) OR a P1.6-B2 STRUCT-
		// FIELD feed (`Self{value: v}` — marked ONLY for a receiverless function, `scanConsumeBits`'s
		// `detectFieldStores`; the transitive fixpoint leaves a `static` inert). A struct-field feed is handled
		// ENTIRELY at the concrete call site (the constructor consumes the argument), so enrolling it owned here
		// would drop it a second time (and through `__drop_type_param`, which a non-array generic program does not
		// install). The receiver (`SelfParamName` at slot 0) is exactly what tells the two apart.
		let isInstanceMethod = paramNames.count() > 0 and (try paramNames.get(0) otherwise panic("bindParameters: paramNames.get(0) on a non-empty list")).equals(SelfParamName)
		for i in 0 upto paramNames.count() 'eachParam'
			let paramName = try paramNames.get(i) otherwise panic("bindParameters: paramNames.get OOB at {i}")
			let paramType = try paramTypes.get(i) otherwise panic("bindParameters: paramTypes.get OOB at {i}")
			let paramRange = try paramRanges.get(i) otherwise panic("bindParameters: paramRanges.get OOB at {i}")

			// ⚠ THE LOOP-PHI TOKEN SCAN DEPENDS ON THIS BEING FALSE, AND NOTHING ELSE SAYS SO.
			//
			// `namesAssignedIn` decides which vars a loop carries a phi for by scanning TOKENS for
			// `identifier =` (`assignsAt`). That is exhaustive only while EVERY write to a mutable
			// binding wears that shape — and a `var` (mutating) PARAMETER does not: its write is
			// `mutate(p)` at the CALL SITE, with no `=` anywhere in the loop for the scan to find.
			// The loop would mint no phi for `p`, and `p` would silently RESET to its entry value
			// on every iteration. A wrong answer, and one no drift guard can catch: unlike a
			// `loopBodyEndIndex` mismatch, the loop's EXTENT would still be perfectly correct.
			//
			// **The assert is on the FLAG ACTUALLY BEING PASSED, at the site that passes it** — not
			// on the constant somewhere else. A real `var`-parameter feature is per-parameter, so it
			// replaces the right-hand side here with `paramIsVar.get(i)`; a tripwire that tested
			// `ParametersAreMutable` would simply stop being read at that moment and never fire,
			// shipping the reset it exists to stop. This one trips on any spelling, because whatever
			// is bound mutable has to come through this line.
			//
			// The other write forms are covered differently: one that IS a statement (`a.b = x`,
			// `x += 1`) has to be taught to `parseStatement`, and `assignsAt`'s comment is the
			// standing instruction to teach the scan in the same edit. A mutating parameter is the
			// case that instruction cannot reach, because it is not a statement at all.
			let paramIsMutable = ParametersAreMutable
			if paramIsMutable 'writesThisScanCannotSee'
				panic("bindParameters: parameter '{String.from(paramName)}' is being bound MUTABLE, but `namesAssignedIn` finds a loop's carried vars by scanning tokens for `identifier =` — and a `var` parameter is written by `mutate(p)` at the CALL SITE, leaving no `=` for that scan to find. The loop would mint no phi and the parameter would silently reset to its entry value every iteration. Teach `assignsAt`/`namesAssignedIn` the new write form before binding a parameter mutable.")
			end 'writesThisScanCannotSee'

			let binding = try self.scope.declareParameterBinding(paramName, varType: paramType, mutable: paramIsMutable, value: i as ValueId) otherwise throw ParseError.localShadowsSelfField(String.from(paramName), typeName: String.from(self.enclosingType), line: paramRange.line, column: paramRange.column)
			// Parameter `i` owns ValueId `i`; record its declaration span so the register-pressure
			// diagnostic can resolve the parameter to source (it is minted by no op — see
			// ParamOriginTable — so it has no `emitOp` origin).
			self.artifact.recordParamOrigin(i as ValueId, range: paramRange)

			// ⭐ **A CONSUMED MANAGED PARAMETER IS ENROLLED AS OWNED** (P1.4a wave 2). The consume analysis
			// marked it moved-into-durable-storage, so the caller transfers ownership at the call site and
			// this function OWNS the value: it is enrolled exactly as an owned local, so `moveInPayload`
			// accepts moving it into a field (an owned bare-local reference is poisoned), and if it is NOT
			// moved on some path `emitScopeDrops` drops it once at function exit — sound whether the analysis
			// was exact or over-approximated. A SCALAR consumed param owns no heap and is left borrowed (its
			// consume bit is inert), so it is never enrolled — a decref of an integer would corrupt the count.
			if self.signatures.paramIsConsumed(funcName, index: i) and self.valueIsManagedHeap(i as ValueId) 'consumedManaged'
				self.markValueOwnsHeap(i as ValueId)
				self.ownedBindings.push(binding)
			end 'consumedManaged'

			// ⭐ **A CONSUMED OPAQUE TYPE-PARAMETER FEED PARAMETER IS ENROLLED AS OWNED** (P1.7 slice 3b-v). A
			// feed parameter (`push(item Element)` moving `item` into `self.items`, or a sibling forwarder the
			// transitive fixpoint marked) is CONSUMED at its concrete call site — the callee OWNS the value — but
			// its `typeParameter` tag fails `valueIsManagedHeap` (opaque here), so the branch above never enrols
			// it. Enrol it now so the SHARED body move-tracks it: a `self.items.push(item)` / consuming
			// `self.N(item)` forward MOVES it (poisons the binding, a second use → E3102), and if it is left LIVE
			// on some path `emitScopeDrops` / the join reconciliation drop it once through the descriptor-gated
			// `__drop_type_param` (0 destructor for a trivial instantiation → inert). An always-moved feed
			// (`push`) is `movedFrom` at exit, so no drop is emitted and the shared body's golden is unchanged —
			// only a method that can drop reserves the descriptor (`computeTypeDescriptorNeeds`).
			//
			// Gated on the opaque `typeParameter` tag as well as `isFeed`: a feed parameter is type-parameter-
			// typed by construction (`markOpaqueArrayMutatorFeeds` marks only such a parameter), so the tag test
			// is redundant with `isFeed` — but it makes this branch PROVABLY exclusive of the managed branch above
			// (which needs `valueIsManagedHeap`, false for a `typeParameter`), so no parameter is ever enrolled
			// twice, and it pins the drop router's `typeParameter` arm to exactly what is enrolled here.
			if isInstanceMethod and self.signatures.paramFeedOf(funcName, index: i).isFeed() and self.tagOf(i as ValueId) == ValueTypeTag.typeParameter 'opaqueFeed'
				self.markValueOwnsHeap(i as ValueId)
				self.ownedBindings.push(binding)
			end 'opaqueFeed'
		end 'eachParam'
	end 'bindParameters'

	// The number of `function`-typed parameters — each of which needs a companion environment parameter under
	// the uniform ABI (P1.5-A2b-2). A function alias was already resolved to `MaxonType.function` by
	// `parseTypeReference`, so the tag is the whole test.
	function countFunctionParams(paramTypes MaxonTypeArray) returns ParamCount
		var n = 0 as ParamCount
		for pt in paramTypes 'each'
			if maxonTypeTag(pt) == ValueTypeTag.function 'fnParam'
				n = n + 1
			end 'fnParam'
		end 'each'
		return n
	end 'countFunctionParams'

	// ⭐ **SEED AND WIRE THE COMPANION ENVIRONMENT PARAMETERS (P1.5-A2b-2).** Under the uniform ABI a
	// function-typed PARAMETER travels with an environment: the caller supplies the (fn ptr, env) pair, and
	// this function's own `f(x)` call threads that env. The companions are APPENDED after the user parameters
	// (ValueIds `userParamCount`..), each an i64 heap pointer, and each function-typed user parameter's
	// `valueClosureEnv` is pointed at its companion. Appending — rather than v1's interleave, which puts the
	// env immediately after its fn parameter — keeps every USER parameter at its own ABI position, so the call
	// machinery needs no source-slot→ABI-slot remap; multiple function parameters compose (their companions
	// append in declaration order, which the caller's `appendCalleeEnvArgs` matches). A companion carries no
	// source name (it is never referenced by the body, only by the indirect call THROUGH the function
	// parameter, via `valueClosureEnv`), so `bindParameters` does not bind it. Its ValueId's value columns are
	// seeded here so the columns stay dense; `recordParamOrigin` gives it the declaring parameter's span for
	// the register-pressure diagnostic.
	function bindClosureEnvParams(paramTypes MaxonTypeArray, paramRanges SourceRangeArray, userParamCount ParamCount)
		var envSlot = userParamCount
		for i in 0 upto userParamCount 'eachParam'
			let paramType = try paramTypes.get(i) otherwise panic("bindClosureEnvParams: paramTypes.get OOB at {i}")
			if maxonTypeTag(paramType) != ValueTypeTag.function 'notFunction'
				continue
			end 'notFunction'
			// Seed the companion's value columns (an i64 pointer) at ValueId `envSlot` — the next push — then
			// point the function parameter at it. Seeding pushes to every value column, so it must precede the set.
			self.recordValueType(MaxonType.integer)
			try self.valueClosureEnv.set(i, value: envSlot) otherwise panic("bindClosureEnvParams: function parameter v{i} has no closure-env slot — the value columns are seeded before this")
			let paramRange = try paramRanges.get(i) otherwise panic("bindClosureEnvParams: paramRanges.get OOB at {i}")
			self.artifact.recordParamOrigin(envSlot, range: paramRange)
			envSlot = envSlot + 1
		end 'eachParam'
	end 'bindClosureEnvParams'

	// Is `value` a managed HEAP value — a struct box, a String, or a boxed union — the kinds a consumed
	// parameter can own (and this function must drop) and a consumed argument must transfer? A ranged-alias /
	// `int` / `bool` owns no heap. This is the one owned-temp adoption test, so `mintOwnedCallResult` routes
	// through it rather than re-spelling the three tags. A managed heap value is a String (text) or a non-text
	// aggregate, so it is derived from `valueIsNonTextAggregate` to keep the aggregate half stated once.
	function valueIsManagedHeap(value ValueId) returns bool
		return tagIsText(self.tagOf(value)) or self.valueIsNonTextAggregate(value)
	end 'valueIsManagedHeap'

	// Is `value` a managed heap AGGREGATE — a struct box or a boxed union — but NOT a String? An aggregate
	// has no cheap owning COPY (unlike a String, which promotes with the fused-record blit
	// `promoteToOwnedString`), so a borrowed one becomes owned only by CO-OWNERSHIP — an `__mm_retain`
	// incref of the shared box (`retainBorrowedAggregate`, OPEN #40). That is wired for a `var q = p`
	// binding, whose scope-exit drop decrefs the co-owned box so the caller stays an owner. It is NOT yet
	// wired for the two HANDOFF sites that name this predicate — `return <borrowed aggregate>`
	// (`emitOwnedValueReturn`) and a borrowed-aggregate `gives`/ternary arm merged into an owned result phi
	// (`promoteBorrowedGive`) — where the value ESCAPES to the caller: co-owning across that boundary needs
	// the cross-call consume (P1.5), so until then both cleanly REFUSE rather than hand off a box whose own
	// owner would free it too (a double free).
	function valueIsNonTextAggregate(value ValueId) returns bool
		let tag = self.tagOf(value)
		// A generic INSTANCE (`Sizer with bool`, P1.6-B1) is a heap box exactly like a plain `structRef`: a
		// pointer to a refcounted record with a baked destructor. It carries the SAME managed-aggregate
		// obligations — owned, dropped once at scope exit, never handed off borrowed-as-owned — so it joins
		// the boundary here rather than being read as a trivial scalar and leaked.
		return tagIsStructRef(tag) or tag == ValueTypeTag.genericInstance or self.valueIsBoxedUnion(value)
	end 'valueIsNonTextAggregate'

	// `returns <Type>` or nothing (void). The return type flows to the registry
	// (for SemanticCheck) and to lowering (via the function signature).
	function parseOptionalReturnType() returns MaxonReturnType throws ParseError
		if not self.at(TokenKind.returns) 'noReturns'
			return MaxonReturnType.void
		end 'noReturns'
		try self.consume(TokenKind.returns)
		return MaxonReturnType.value(try self.parseTypeReference())
	end 'parseOptionalReturnType'

	// The `throws E` clause that follows a function's return type (P1.4b). `E` is a bare enum name — a
	// payload-free enum conforming to `Error` (validated later, in SemanticCheck; the sweep and the real
	// parse are tolerant). Read by BOTH the declaration sweep (`recordScannedSignature`, whole-program) and
	// the real parse (`parseFunction`, which stamps `func.throwsTypeName`), so the throws fact is captured
	// once and shared, exactly as `parseOptionalReturnType` is.
	function parseOptionalThrowsClause() returns ThrowsClause throws ParseError
		if not self.at(TokenKind.throws) 'noThrows'
			return ThrowsClause.none
		end 'noThrows'
		try self.consume(TokenKind.throws)
		let nameTok = try self.consume(TokenKind.identifier)
		return ThrowsClause.throwing(String.from(nameTok.value))
	end 'parseOptionalThrowsClause'

	// The optional `implements <Interface>` clause on an enum/union declaration — error enums declare
	// `implements Error` (P1.4b). Interfaces are not yet modelled in shv2, so the clause is CONSUMED and
	// the conformance ASSUMED; the payload-free-enum-conforms-to-Error check the CONTRACT names is a
	// follow-up (no Wave-1 case declares a non-Error throws enum). Shared by the tolerant declaration sweep
	// and the real parse, exactly as `parseOptionalThrowsClause` is.
	function skipOptionalImplementsClause() throws ParseError
		if not self.at(TokenKind.implements) 'noImplements'
			return
		end 'noImplements'
		try self.consume(TokenKind.implements)
		_ = try self.consume(TokenKind.identifier)
	end 'skipOptionalImplementsClause'

	// A type reference. M1: a bare identifier (a named type like `ExitCode`,
	// interned into the artifact's local interner) or a bare primitive keyword.
	// Ranged/generic/qualified type syntax grows at M2+.
	//
	// ⭐ **`Self` — AND THE ENCLOSING TYPE'S OWN NAME — RESOLVE TO A `structRef` HERE, SYNTACTICALLY.**
	// Every other identifier stays `named` and is resolved later, by `TypeResolution` against the
	// project registry. The asymmetry is not a shortcut, it is the only thing that WORKS:
	//
	//   • **This routine runs in BOTH passes.** The tolerant declaration sweep reads a signature
	//     through it (`recordScannedSignature`) while the whole-program index is still being BUILT,
	//     so it cannot ask "is `Point` a declared type?" — the answer depends on how far the sweep
	//     has got, which would make a declaration's recorded return type depend on its POSITION.
	//   • **`Self` needs no index.** It means the type whose body encloses it, which is a fact about
	//     the TOKENS, so both passes answer it identically and neither has to look anything up.
	//
	// So `static function create(…) returns Self` is `structRef(Point)` in the sweep and in the
	// parse, and a call's result is typed exactly (`mintCallResult` reads the sweep). That is what
	// `let p = Point.create(3, y: 4)` needs to know `p` is a Point at all.
	//
	// ⚠ **`returns Point` from OUTSIDE `type Point` is the gap, and it is LOUD.** The signature
	// resolves to `structRef` (TypeResolution) while the call site's tag comes from the sweep's
	// `named` — so `let p = make()` binds `p` as a ranged int and `p.x` reports "is not a struct".
	// A wrong REJECTION of a correct program, never a wrong answer, and the program it rejects is
	// `struct-return` — still `disabled-test:`, deferred to P1.4's ownership ruling, which is what
	// a struct crossing a call boundary needs before it can be right for any other reason.
	function parseTypeReference() returns MaxonType throws ParseError
		if self.at(TokenKind.selfType) 'selfType'
			let tok = try self.consume(TokenKind.selfType)
			return try self.enclosingStructType(tok)
		end 'selfType'

		if self.at(TokenKind.identifier) 'named'
			let tok = try self.consume(TokenKind.identifier)

			// ⭐ A QUALIFIED PER-INSTANCE ALIAS REFERENCE (P1.6-C) — `StrWrapper.Idx` in a type position. An
			// identifier followed by `.` and another identifier is `Instance.Member`, the ONE dotted type form,
			// so this peek precedes every bare-identifier arm below (the `.` is what tells a qualified reference
			// from a plain one). It resolves to `named(join)` in BOTH passes — the SHAPE is enough, needing no
			// registry, so the tolerant sweep and the real parse answer identically while the index is still
			// building. TypeResolution erases a registered per-instance `X.Y` to `integer` (keeping the nominal
			// name in the value column) and reports an unregistered one as E3011.
			if self.at(TokenKind.dot) and self.kindAt(self.pos + 1) == TokenKind.identifier 'qualifiedMember'
				try self.consume(TokenKind.dot)
				let memberTok = try self.consume(TokenKind.identifier)
				return MaxonType.named(self.artifact.typeNames.intern(joinQualifiedName(tok.value, member: memberTok.value)))
			end 'qualifiedMember'

			// The `String` BUILTIN — recognized SYNTACTICALLY, like `Self` below, so it needs no registry
			// and both the declaration sweep and the real parse answer it identically. It resolves to its
			// own `MaxonType.string` arm (NEVER `named`), which is what tags a `String` parameter's value
			// `string` at parse time. See `StringBuiltinName`.
			if tok.value.equals(StringBuiltinName) 'stringBuiltin'
				return MaxonType.string
			end 'stringBuiltin'
			// The type's own name inside its own body means what `Self` means. Both spellings are
			// legal Maxon and they must not resolve differently — one `structRef`, one `named` —
			// because the second would type `create`'s result as an integer and `p.x` would fail
			// against the very type that declared it.
			if self.namesEnclosingType(tok.value) 'ownName'
				return try self.enclosingStructType(tok)
			end 'ownName'

			// A GENERIC TYPE PARAMETER (P1.6-A) — a bare `T` inside `type Box uses T`. Recognized by NAME
			// against the enclosing type's `uses` list, so the tolerant sweep and the real parse answer it
			// identically without a registry (like `Self`). It resolves to `typeParameter(POSITION)` — an
			// opaque i64 — NEVER `named`, for the reason `structRef`/`string`/`function` are their own arms:
			// the rules that read `named` treat it as a ranged int, and a `T` is neither numeric nor a
			// declared type. There is no shadowing question at this slice: a type param name equal to a
			// declared type name is not in the corpus, and the param wins here (it is the innermost scope).
			let paramPos = self.typeParamPositionOf(tok.value)
			if paramPos < self.enclosingTypeParams.count() 'typeParam'
				return MaxonType.typeParameter(paramPos)
			end 'typeParam'

			// A BARE INNER ALIAS (P1.6-C / P1.7 slice 3b-i) — `Idx` OR `ElementArray` inside `type Wrapper`.
			// Recognized by NAME against `enclosingInnerAliases` (populated while THIS type's body is parsed, so
			// the sweep and the real parse agree without the whole-program registries, which the sweep has not
			// folded yet). It resolves under its BASE-QUALIFIED name (`Wrapper.Idx`), NEVER the bare member (which
			// collides with a same-named inner alias of another generic type). Two shapes: a GENERIC-INSTANCE
			// inner alias (`ElementArray = Array with T`) resolves to `genericInstance(gid)` in the REAL parse
			// (the index is complete), the read-side twin of the top-level generic-alias arm below — so the field
			// type is a genericInstance TypeResolution leaves concrete, not a `named` it would reject as E3011. A
			// RANGED inner alias stays `named("Wrapper.Idx")` (TypeResolution erases it to `integer`, and the
			// method-return retype re-qualifies it at the call site). During the SWEEP `isGenericAlias` answers no
			// for both, so both stay `named` — harmless, as the sweep's field type is re-tagged at every read.
			if self.enclosingInnerAliases.contains(tok.value) 'innerAlias'
				let qualifiedInner = joinQualifiedName(self.enclosingType, member: tok.value)
				if self.signatures.isGenericAlias(qualifiedInner) 'genericInnerAlias'
					return MaxonType.genericInstance(self.signatures.genericAliasInstance(qualifiedInner))
				end 'genericInnerAlias'
				return MaxonType.named(self.artifact.typeNames.intern(qualifiedInner))
			end 'innerAlias'

			// A GENERIC-INSTANCE ALIAS (P1.6-A) — `IntBox` where `typealias IntBox = Box with Integer`.
			// Resolved to `genericInstance(giid)` here in the REAL parse (the whole-program index is
			// complete), the read-side twin of the function-alias arm below. During the SWEEP the index is
			// still building, so `isGenericAlias` answers no and the reference stays `named` — harmless,
			// because a generic alias is used only as a call BASE (resolved through `parseQualifiedCall`,
			// which reads the completed index) at this slice, never as a swept value type.
			if self.signatures.isGenericAlias(tok.value) 'genericAlias'
				return MaxonType.genericInstance(self.signatures.genericAliasInstance(tok.value))
			end 'genericAlias'

			let id = self.artifact.typeNames.intern(tok.value)
			// A FUNCTION typealias name resolves to a `function` type, NEVER a `named` one (P1.5-A1) — so
			// a param/field/return declared with a function alias carries the `function` tag, which is what
			// makes a function value assignable to it and an indirect call reach it. The whole-program
			// signature index has the answer here in the REAL parse (the sweep is complete); during the
			// SWEEP itself `functionAliasOf` is still being built and returns `undeclared`, leaving the raw
			// scanned record a `named` — which the READ sites (call-result / field-load typing) functionize.
			if self.signatures.isFunctionAlias(tok.value) 'functionAlias'
				return MaxonType.function(id)
			end 'functionAlias'

			return MaxonType.named(id)
		end 'named'
		if self.at(TokenKind.int) 'primInt'
			try self.consume(TokenKind.int)
			return MaxonType.integer
		end 'primInt'
		if self.at(TokenKind.bool) 'primBool'
			try self.consume(TokenKind.bool)
			return MaxonType.boolean
		end 'primBool'
		if self.at(TokenKind.float) 'primFloat'
			try self.consume(TokenKind.float)
			return MaxonType.float
		end 'primFloat'
		let tok = self.current()
		throw ParseError.unexpectedToken("a type", got: tok.kind.rawValue, line: tok.line, column: tok.column)
	end 'parseTypeReference'

	// The `structRef` naming the type currently being declared, for `Self` and for its own name.
	// `anchor` is only the token a diagnostic points at.
	//
	// A `Self` at FILE SCOPE has no type to refer to. It is a positioned `unsupported` rather than a
	// panic because the source can perfectly well write one, and it is not `unexpectedToken` because
	// `Self` is a type reference — it simply names nothing here.
	function enclosingStructType(anchor Token) returns MaxonType throws ParseError
		if self.enclosingType.isEmpty() 'outsideAType'
			throw ParseError.unsupported("'{anchor.kind.rawValue}' outside a type declaration (`Self` names the type whose body encloses it, and there is none here)", line: anchor.line, column: anchor.column)
		end 'outsideAType'
		return MaxonType.structRef(self.artifact.typeNames.intern(self.enclosingType))
	end 'enclosingStructType'

	// Does `name` name the type currently being declared? False at file scope, where there is no
	// enclosing type for any name to be — which is what makes the `isEmpty` test load-bearing
	// rather than an optimization: without it a file-scope `EmptySourceText` would match nothing
	// anyway, but only by accident of no identifier being empty.
	function namesEnclosingType(name ByteArray) returns bool
		return not self.enclosingType.isEmpty() and self.enclosingType.equals(name)
	end 'namesEnclosingType'

	// The POSITION of `name` in the enclosing type's `uses` list (P1.6-A), or `count()` when it is not
	// a type parameter — the door `parseTypeReference` recognizes a bare `T` through, and the value that
	// becomes `typeParameter(POSITION)`. A linear scan, for `StructLayout.indexOfField`'s reason: a type
	// declares a handful of parameters, so a per-parse name→index map would be a heap object bought to
	// serve two or three lookups.
	// The number of hidden witness parameters a function of the enclosing type carries (P1.7a slice 2a) — one
	// per `where` constraint for an INSTANCE method of a constrained generic type, zero otherwise (a static, or
	// an unconstrained type). The reservation is uniform across the type's instance methods (see `parseFunction`),
	// so this is a pure function of `takesReceiver` and the type's constraint count.
	function witnessParamCountFor(takesReceiver bool) returns ParamCount
		if not takesReceiver or self.enclosingWhereConstraints.isEmpty() 'noWitness'
			return 0
		end 'noWitness'
		return self.enclosingWhereConstraints.count()
	end 'witnessParamCountFor'

	function typeParamPositionOf(name ByteArray) returns TypeParamId
		for i in 0 upto self.enclosingTypeParams.count() 'each'
			let paramName = try self.enclosingTypeParams.get(i) otherwise panic("typeParamPositionOf: enclosingTypeParams.get OOB at {i}")
			if paramName.equals(name) 'hit'
				return i
			end 'hit'
		end 'each'
		return self.enclosingTypeParams.count()
	end 'typeParamPositionOf'

	// ⭐ **RESOLVE A `named` STRUCT REFERENCE TO `structRef` — the parse-time half of what `resolveTypes`
	// does to a signature.** `parseTypeReference` mints `structRef` SYNTACTICALLY for `Self` and the
	// enclosing type's own name (they need no registry), but leaves every OTHER type name `named`,
	// because it runs in the tolerant declaration sweep too — where "is `Vec2` a struct?" has no answer.
	// This runs in the REAL parse ONLY (`self.signatures` is the complete whole-program index), so it CAN
	// ask, and it re-tags a `named` that denotes a declared `type` as `structRef` — which is what makes a
	// struct PARAMETER (`a Vec2`) a struct base for `a.x`, a struct RETURN (`returns Pair`) agree with the
	// `structRef` a factory hands back, and a struct CALL RESULT (`let p = makePair()`) bind a struct.
	//
	// A `named` that denotes a UNION/ENUM stays `named` — a union value carries the `named` tag
	// (`enumMatchFor` reads it) — and a ranged int ALIAS stays `named` (it IS the integer). `structRef`
	// (a `Self`/own-name reference) and every non-`named` type pass through untouched, so this is
	// idempotent and safe to fold over an already-partly-resolved list. `resolveTypes`'s `structRef` arm
	// then finds the signature already resolved and leaves it, so the two cannot drift.
	//
	// The `containsStruct` guard, not `structOf`, for the reason its header states: this is asked of
	// EVERY `named` parameter and return type, most of them int aliases, and `structOf` would box a
	// throwaway `DeclaredStruct.undeclared` for each.
	function resolveNamedStruct(t MaxonType) returns MaxonType
		if maxonTypeTag(t) != ValueTypeTag.named 'notNamed'
			return t
		end 'notNamed'

		let id = typeNameIdOf(t)
		let name = try self.artifact.typeNames.nameOf(id) otherwise panic("resolveNamedStruct: a `named` type's id is not in this file's interner — `parseTypeReference` interned it from a name in the same table")
		if not self.signatures.containsStruct(name) 'notStruct'
			return t
		end 'notStruct'

		return MaxonType.structRef(id)
	end 'resolveNamedStruct'

	// ⭐ **RESOLVE A `named` FUNCTION-ALIAS REFERENCE TO `function`** (P1.5-A1) — the read-side twin of
	// `resolveNamedStruct`, for the types the WHOLE-PROGRAM signature index hands back as `named` because
	// the SWEEP that recorded them ran before the function alias was known: a call RESULT
	// (`returnTypeOf` → `let f = pickDouble()`) and a struct-FIELD read (`fieldTypeOf` → `let f = h.op`).
	// `parseTypeReference` already re-tags a PARAMETER/return/annotation directly (the sweep is complete
	// by the real parse), so this catches only the sweep-sourced types. A `named` that is neither a function
	// alias (`function`) NOR a generic-instance alias (`genericInstance(gid)`, P1.6-B2 — `returns StrBox`, so
	// `let b = make()` binds a real generic instance with its type-arg managed drop, not an opaque `named` a
	// field access rejects), and every non-`named` type, pass through untouched. The SWEEP records a return
	// type before the index knows its aliases, so both arrive here `named`; a name is a struct, a float
	// alias, a function alias, a generic alias or a ranged int — NEVER two — so ONE `nameOf` decides which,
	// idempotent and foldable alongside `resolveNamedStruct`/`resolveFloatAliasType`.
	function resolveNamedAlias(t MaxonType) returns MaxonType
		if maxonTypeTag(t) != ValueTypeTag.named 'notNamed'
			return t
		end 'notNamed'

		let id = typeNameIdOf(t)
		let name = try self.artifact.typeNames.nameOf(id) otherwise panic("resolveNamedAlias: a `named` type's id is not in this file's interner — `parseTypeReference`/`fieldTypeOf` interned it from a name in the same table")
		if self.signatures.isFunctionAlias(name) 'fa'
			return MaxonType.function(id)
		end 'fa'
		if self.signatures.isGenericAlias(name) 'genericAlias'
			return MaxonType.genericInstance(self.signatures.genericAliasInstance(name))
		end 'genericAlias'
		return t
	end 'resolveNamedAlias'

	// `resolveNamedStruct` folded over a parameter-type list — the whole struct-`named` → `structRef`
	// rewrite for one function's parameters, done ONCE after they are parsed so every downstream reader
	// (the value-tag seeding, the binding types, the recorded signature) sees the same resolved list.
	function resolveNamedStructAll(types MaxonTypeArray) returns MaxonTypeArray
		var resolved = MaxonTypeArray.create()
		for t in types 'each'
			resolved.push(self.resolveNamedStruct(t))
		end 'each'
		return resolved
	end 'resolveNamedStructAll'

	// `resolveNamedStruct` for a return type: a `returns Pair` resolves its inner struct-`named` to
	// `structRef` so `parseReturnStatement`'s declared-type check agrees with the `structRef` a factory's
	// `return Self{…}` hands back, and so the recorded signature matches the call site's adopted result.
	function resolveNamedStructReturn(rt MaxonReturnType) returns MaxonReturnType
		return match rt 'r'
			void gives rt
			value(inner) gives MaxonReturnType.value(self.resolveNamedStruct(inner))
		end 'r'
	end 'resolveNamedStructReturn'

	// Does `returnType` name the ENCLOSING type — `Self`, the base struct, `structRef` after
	// `resolveNamedStructReturn` (P1.7 slice 3b-i)? It is the return a receiverless layout-needing constructor
	// must have: only then does the call's RESULT get retyped to the concrete instance
	// (`retypeGenericAliasConstructorResult`) the caller reads the layout descriptor off. Compared by interned
	// id in `self.artifact.typeNames` — the interner both the resolved return type and `self.enclosingType`
	// live in — so no `nameOf` round-trip is needed.
	function returnsEnclosingType(returnType MaxonReturnType) returns bool
		return match returnType 'r'
			void gives false
			value(inner) gives maxonTypeTag(inner) == ValueTypeTag.structRef and typeNameIdOf(inner) == self.artifact.typeNames.intern(self.enclosingType)
		end 'r'
	end 'returnsEnclosingType'

	// Statement list until the closing `end`, emitting into `block`. Returns the block
	// the LAST statement left control in — the same `block` for straight-line code, but
	// an `if` moves control into its continuation block, so subsequent statements (and
	// the caller) must follow it. `func` is threaded so control-flow statements can
	// create successor blocks. Blank lines separate statements.
	function parseStatements(func IrFunction, block IrBlock) returns IrBlock throws ParseError
		var current = block
		while true 'stmts'
			self.skipNewlines()
			if self.at(TokenKind.end) 'endBlock'
				break
			end 'endBlock'
			if self.isEof() 'eof'
				let tok = self.current()
				throw ParseError.unexpectedEof(tok.line, column: tok.column)
			end 'eof'
			// ⭐⭐ **E3070: AN ELEMENT ACCESSOR NO NAME TOOK DIES WITH ITS STATEMENT** — the watermark is taken
			// here and the claim list is cut back to it below. See `dropUnclaimedPendingBorrows` for why this
			// loop is the only place that may do it, and what it cost when nothing did.
			let pendingBorrowMark = func.borrowFacts.pending.count()
			current = try self.parseStatement(func, block: current)
			self.dropUnclaimedPendingBorrows(func, mark: pendingBorrowMark)
		end 'stmts'
		return current
	end 'parseStatements'

	// One statement. Returns the block subsequent statements continue in.
	//
	// EVERY arm returns `self.currentBlock`, not `block`, and that is the change P1.0d.2
	// forces: a short-circuit `and`/`or` anywhere inside a statement's EXPRESSION leaves
	// control in a fresh merge block, so even a "straight-line" statement — a `let`, an
	// assignment, a bare call — can move it. Returning the incoming `block` would send the
	// next statement's ops to a block control has already left, which reads as a wild
	// miscompile (ops stranded on a dead path) rather than as a parse error.
	//
	// `break`/`continue` are the two that genuinely cannot move it: neither takes an
	// expression. They still route through the same return so there is ONE rule here rather
	// than an exception to remember.
	function parseStatement(func IrFunction, block IrBlock) returns IrBlock throws ParseError
		self.currentBlock = block

		// The statement's first token — the anchor `drainPendingTemps` gives the drops it emits (no source
		// token spawns a drop). Captured before parsing advances the cursor.
		let stmtTok = self.current()

		if self.at(TokenKind.return) 'ret'
			try self.parseReturnStatement(func, block: block)
		end 'ret' else if self.at(TokenKind.let) 'letDecl'
			try self.parseBinding(func, block: block, mutable: false)
		end 'letDecl' else if self.at(TokenKind.var) 'varDecl'
			try self.parseBinding(func, block: block, mutable: true)
		end 'varDecl' else if self.at(TokenKind.if) 'ifStmt'
			return try self.parseIfStatement(func, block: block)
		end 'ifStmt' else if self.at(TokenKind.while) 'whileStmt'
			return try self.parseWhileStatement(func, block: block)
		end 'whileStmt' else if self.at(TokenKind.for) 'forStmt'
			return try self.parseForStatement(func, block: block)
		end 'forStmt' else if self.at(TokenKind.match) 'matchStmt'
			return try self.parseMatchStatement(func, block: block)
		end 'matchStmt' else if self.at(TokenKind.break) 'breakStmt'
			try self.parseBreakStatement(block)
		end 'breakStmt' else if self.at(TokenKind.continue) 'continueStmt'
			try self.parseContinueStatement(block)
		end 'continueStmt' else if self.at(TokenKind.throw) 'throwStmt'
			try self.parseThrowStatement(func, block: block)
		end 'throwStmt' else if self.at(TokenKind.try) 'tryStmt'
			// A `try` in statement position — its value is discarded; the forms are the propagate,
			// the control-flow `otherwise`s, `otherwise ignore`, and the block handlers.
			_ = try self.parseTry(func, resultUsed: false)
		end 'tryStmt' else if self.at(TokenKind.panic) 'panicStmt'
			try self.parsePanicStatement(func, block: block)
		end 'panicStmt' else if self.at(TokenKind.otherwise) 'strayOtherwise'
			// An `otherwise` with no `try` to attach to (`let v = f() otherwise 0`). Reaches here as a
			// statement starter after the preceding expression completed. Renders as E3058.
			let otherwiseTok = self.current()
			throw ParseError.otherwiseWithoutTry(otherwiseTok.line, column: otherwiseTok.column)
		end 'strayOtherwise' else if self.assignsAt(self.pos) 'assign'
			// An identifier followed by `=` is a reassignment. The two-token lookahead
			// keeps a bare identifier from being mis-parsed as an incomplete assignment.
			// Through `assignsAt`, which is also what decides a loop's carried vars — see there.
			try self.parseAssignment(func, block: block)
		end 'assign' else if self.selfFieldAssignsAt(self.pos) 'selfFieldAssign'
			// `self.count = 5` — the explicit spelling of a self-field store. Its own predicate for
			// `fieldAssignsAt`'s reason: it assigns no BINDING, so `namesAssignedIn` must not see it.
			// (The BARE spelling, `count = 5`, matches `assignsAt` and is routed above — see there
			// for why the scan finding `count` is harmless.)
			try self.parseExplicitSelfFieldAssignment(func, block: block)
		end 'selfFieldAssign' else if self.fieldAssignsAt(self.pos) 'fieldAssign'
			// `p.x = 5` — a store THROUGH a binding rather than a rebinding of one. Its own
			// predicate, and `namesAssignedIn` reads only `assignsAt`: see `assignsAt` for why
			// widening that one instead would have minted the loop's phi for the FIELD's name.
			try self.parseFieldAssignment(func, block: block)
		end 'fieldAssign' else if self.methodCallsAt(self.pos) 'methodCallStmt'
			// `c.increment()` / `self.increment()` — a method call for its EFFECT. Void methods are
			// most of what a type declares, and this is the only position that wants no value, so
			// `resultUsed: false` is what makes them callable at all.
			//
			// A FUNCTION-TYPED FIELD reached the same way (`h.op()`, `self.op()`) is NOT a method (#97):
			// `dispatchMethodOnBase` LOADS the field (a `function` value) and leaves the trailing `(args)` for the
			// postfix loop, exactly as it does in expression position. `parsePostfix` applies it as an INDIRECT call
			// (the #68/#78 lowering), so the trailing `(` is not left to be misread as a `( statement` on the next
			// iteration. A real method call consumes its own `(args)`, so `parsePostfix` then sees no trailing `(`
			// and is a no-op — the emitted IR of every existing method-call statement is unchanged.
			_ = try self.parsePostfix(func, value: try self.parseMethodCall(func, resultUsed: false), resultUsed: false)
		end 'methodCallStmt' else if self.fieldChainMethodCallAt(self.pos) 'fieldChainMethodStmt'
			// `b.ops.push(1)` / `o.inner.op()` — a call reached through a ≥2-hop field chain, on an ARRAY FIELD's
			// method or a FUNCTION-typed FIELD (#97). `methodCallsAt` covers only the one-hop `b.push(…)` / `h.op()`;
			// this is the chain case, dispatched for effect (`resultUsed: false`). A function field's trailing
			// `(args)` goes through `parsePostfix` exactly as the one-hop `methodCallStmt` above.
			_ = try self.parseFieldChainCall(func, resultUsed: false)
		end 'fieldChainMethodStmt' else if self.builtinsIntrinsicCallsAt(self.pos) 'builtinsIntrinsicStmt'
			// ⭐ `__Builtins.sleep(ms)` — A VOID COMPILER INTRINSIC CALLED FOR ITS EFFECT, and the reason a
			// STATIC call is otherwise not a statement does not apply to it. `Point.create()` on a line of
			// its own is refused because it discards a box nothing would then free (`methodCallsAt`); an
			// intrinsic allocates nothing, so a value-returning one written here simply has its result
			// discarded, exactly as every other bare-call statement's is.
			//
			// This is the position `stdlib/Sleep.maxon` needs — the module every source-level `sleep(ms)`
			// now resolves to: its whole body is `__Builtins.sleep(milliseconds)` on a line of its own,
			// so without this arm the module does not compile. Until it existed, the three
			// recognized intrinsics all RETURNED a value, so every one of them arrived in expression
			// position and the recognizer was never asked from here — a void intrinsic died as
			// `E2015: Unsupported: identifier statement`, pointing at the `__Builtins` token.
			//
			// A member the table does NOT recognize falls through `parseCallNamed` to `emitCall`, whose
			// reserved-callee rejection reports the positioned E3004 (`requireCalleeIsNotReservedName`) —
			// so widening the statement door widens no name, it only routes them to the same answer
			// expression position already gives.
			_ = try self.parseQualifiedCall(func, resultUsed: false)
		end 'builtinsIntrinsicStmt' else if self.at(TokenKind.identifier) and self.peekKind() == TokenKind.leftParen 'callStmt'
			// An identifier followed by `(` is a bare-call statement — the call is evaluated for its
			// effect and its result discarded (M5). `resultUsed: false` is what makes a VOID call legal
			// HERE and nowhere else: this is the position that wants no value.
			//
			// A FUNCTION-TYPED LOCAL called here (`let cb = doIt; cb()`) is an INDIRECT call through the
			// value — the SAME diversion `parsePrimary` makes in expression position (P1.5-A1, #68).
			// Resolve it as a variable reference and let `parsePostfix` apply the trailing `(args)` as an
			// indirect call, exactly as the expression path does; its result — void, or a value discarded
			// here like any other bare-call statement — is dropped by the statement's `drainPendingTemps`
			// tail when it owns heap. Treating `cb` as a direct call instead is what misreported it E3004.
			if self.calleeIsFunctionTypedLocal() 'functionLocalCallStmt'
				_ = try self.parsePostfix(func, value: try self.parseVariableReference(), resultUsed: false)
			end 'functionLocalCallStmt' else 'directCallStmt'
				// A trailing `(` on the call's RESULT is a call-result callee (`getFn()()`) — the result is itself a
				// `function` value, applied by `parsePostfix` as an indirect call, the statement-position twin of the
				// value-position `pick()(21)` (#97). A plain direct call leaves no trailing `(`, so `parsePostfix` is a
				// no-op and every existing direct-call statement lowers to the same IR.
				_ = try self.parsePostfix(func, value: try self.parseCall(func, resultUsed: false), resultUsed: false)
			end 'directCallStmt'
		end 'callStmt' else 'unsupported'
			let tok = self.current()
			throw ParseError.unsupported("{tok.kind.rawValue} statement", line: tok.line, column: tok.column)
		end 'unsupported'

		// ⭐ **DROP THE STATEMENT'S UNCONSUMED OWNED TEMPORARIES.** `print("{x}")` created an interpolation
		// result that `print` only BORROWED; under static single-owner it is owned by this statement and
		// dies here. A binding transferred its result out already (`parseBinding` cleared it), so a `let s =
		// "{x}"` drains nothing — `s` drops at scope exit instead.
		//
		// ⚠ Guarded on the block NOT being terminated, and that is the fail-safe: `return`/`break`/`continue`
		// have already ended the block, and a `__mm_decref` emitted after a terminator would sit on a dead
		// path (a leak the gate would shout, not a wrong answer). A TERMINATING statement that creates a
		// temporary drops it BEFORE the terminator itself — `return wrap("v{x}")` builds an owned
		// interpolation as a call argument, and `parseReturnStatement` drains it ahead of the `ret` — so by
		// the time control reaches here the block is terminated and its temporaries are already gone. This
		// skip is therefore correct, not a hole: `break`/`continue` carry no expression and so no temporary.
		//
		// The `count() > 0` half is what keeps a statement that produced NO temporary — every statement in a
		// program with no interpolation — from paying anything: `drainPendingTemps` reallocates the list, so
		// calling it per statement would be one allocation on every line of the whole compiler. Almost no
		// statement enrolls a temporary, so the common path skips the call entirely.
		if not self.currentBlock.isTerminated() and self.pendingTempDrops.count() > 0 'dropTemps'
			self.drainPendingTemps(WholeStatementTempFloor, anchor: stmtTok)
		end 'dropTemps'

		return self.currentBlock
	end 'parseStatement'

	// Parse a `let`/`var` binding: `let <name> = <expr>`. M2 rejects a type
	// annotation — a `:` after the name makes the `=` consume fail with E2010
	// (`Expected '=' but got ':'`), which IS the `variables.md` type-annotation
	// contract, so no explicit `:` check is needed. The initializer's SSA value is
	// bound to the name in the scope, so a later reference resolves straight to it
	// (no slot, no load/store — see Scope.declareValueBinding). `mutable`
	// distinguishes `var` from `let`: only a `var` may be reassigned, and only a `var`
	// carries a loop-carried phi.
	//
	// The binding lands in the INNERMOST open scope frame, so a declaration inside an
	// `if`/`while` body is gone at its `end` — and may legally SHADOW an outer binding
	// of the same name while it lives (specs/block-scoping.md).
	// The binding takes the initializer's INFERRED type, not a hardcoded `integer`. That was
	// harmless while every value was an int; it is not any more — `let flag = a > b` binds a
	// `bool`, and `flag and other` short-circuits only if the parser knows so.
	function parseBinding(func IrFunction, block IrBlock, mutable bool) throws ParseError
		if mutable 'isVar'
			try self.consume(TokenKind.var)
		end 'isVar' else 'isLet'
			try self.consume(TokenKind.let)
		end 'isLet'

		let nameTok = try self.consume(TokenKind.identifier)
		try self.requireUnreservedName(nameTok)
		try self.consume(TokenKind.equals)
		let rhsStart = self.pos
		let value = try self.parseExpression(func, block: block)
		// Was the initializer a bare reference to a local (`let u = t`)? A MOVE poisons that source; any
		// other RHS is a consume that poisons nothing. Captured here, off the token position, so the
		// poison never runs its owned-set scan on a consume (see `rhsWasBareLocalReference`).
		let rhsWasBareLocal = self.rhsWasBareLocalReference(rhsStart)

		// ⭐ **A MUTABLE BORROWED MANAGED BINDING IS PROMOTED TO OWNED AT ITS DECLARATION.** A `var` whose
		// initializer is a BORROWED managed value (a `"literal"` rdata String, or a struct/union PARAMETER —
		// both hold a managed tag yet own nothing) is made to own a droppable value here, at ITS OWN scope:
		//
		//   • a String COPIES into a writable owned heap record — `var s = "hi"` binds an immortal READ-ONLY
		//     rdata record `s.append(…)` cannot grow in place, so it is copied (value semantics).
		//   • a struct/union INCREFS the shared box (OPEN #40) — an aggregate has no cheap owning copy and its
		//     alias is observable (`q.x = 100` must show through to the caller), so it stays the SAME box with
		//     one more owner (reference semantics).
		//
		// Promoting at the DECLARATION is what enrols the binding as owned at the depth it is declared. Left
		// borrowed, a later `q = <owned>` inside a NESTED block would be the FIRST thing to make it own a
		// drop, and `reassignBindingValue`'s `borrowedToOwned` would enrol it at the INNER block's depth — so
		// the fresh box would drop at that block's `end` while the binding (declared outer) is read past it: a
		// use-after-free (the String append-in-nested-loop hazard, and its aggregate twin OPEN #40). The
		// retain/copy balances on every path: a reassignment decrefs/drops the promoted value, and an untaken
		// branch leaves the scope-exit drop to reclaim it — net zero, so the caller stays the owner of an
		// aggregate box. An already-OWNED initializer (`var s = "{x}"`, `var p = Point.create(…)`, a move
		// `var q = t`) is left untouched by the `not valueIsOwnedHeap` guard, and a `let` is never reassigned,
		// so only a `var` needs this. The promotion makes the binding a fresh CONSUME, not a bare-local move.
		var boundValue = value
		var boundBareLocal = rhsWasBareLocal
		if mutable and self.valueIsManagedHeap(value) and not self.valueIsOwnedHeap(value) 'promoteBorrowedBinding'
			boundValue = try self.promoteBorrowedToOwned(value, range: SourceRange.ofToken(nameTok))
			boundBareLocal = false
		end 'promoteBorrowedBinding'

		// A local taking the name of a field of the enclosing type is E3006, not a shadow — see
		// `Scope.declareValueBinding`. Anchored on the LOCAL's name token: the field is fine, the
		// local is what has to be renamed.
		var binding = try self.scope.declareValueBinding(nameTok.value, varType: self.typeOf(boundValue), mutable: mutable, value: boundValue) otherwise throw ParseError.localShadowsSelfField(String.from(nameTok.value), typeName: String.from(self.enclosingType), line: nameTok.line, column: nameTok.column)
		// ⭐ E3070: the initializer's outstanding element borrows become THIS binding's, activated HERE — see
		// `attachPendingBorrows` for why the binding and not the accessor is the activation point.
		self.attachPendingBorrows(func, borrower: binding, boundValue: boundValue, liveUntil: self.pos)

		if mutable 'trackVar'
			// Record `var`s in declaration order so loop headers can mint phis for every
			// mutable binding in scope (M4b on-the-fly SSA). `let`s never join — they
			// cannot be reassigned, so they carry no loop-carried phi.
			self.mutableVars.push(binding)
		end 'trackVar'

		// ⭐ **A BINDING OWNS A DROP IFF ITS VALUE OWNS DROPPABLE HEAP** (`valueIsOwnedHeap` — a struct
		// box, a boxed union, an owned interpolation/promotion String, an adopted call result), so it
		// joins the list every scope exit drops (see `ownedBindings`). `let` and `var` alike: ownership is
		// a property of the VALUE, never the mutability — `var p = Point.create(…)` owns exactly what a
		// `let` one does.
		//
		// It keys on the PROVENANCE BIT, not the type tag, and that is what tells an owned box from a
		// BORROWED one: `let s = "hi"` (an immortal rdata literal) and `let q = a` where `a` is a struct
		// PARAMETER (a borrowed pointer) both hold a struct/String tag yet own nothing — no bit, so the
		// binding is borrowed and never dropped. `let u = t` from an already-owned binding DOES own (the
		// bit rides the value), and MOVES it (below). The day a struct arrives from somewhere other than a
		// factory call, its producer set the same bit, and this asks no new question.
		if self.valueIsOwnedHeap(boundValue) 'trackOwned'
			// ⭐ **MOVE-ON-BIND.** If the initializer was a bare reference to an ALREADY-owned binding
			// (`let u = t`), `boundValue` is that binding's value: it MOVES to this new one. Poison the
			// source so a later read of it is use-after-move and only the new owner drops the value.
			// A fresh owned temp (`build()`, `"{x}"`, a promoted mutable-string copy) is held by no
			// binding, so nothing is poisoned — that is a CONSUME (move-in), not a source-poisoning move.
			// Gated on `boundBareLocal`, so a consume never pays the owned-set scan; run BEFORE the push
			// below, so the scan cannot find this new binding (it aliases the same value).
			if boundBareLocal 'moveOnBind'
				try self.poisonMoveSource(boundValue, anchor: nameTok)
			end 'moveOnBind'
			self.ownedBindings.push(binding)
			// Ownership TRANSFERS from the statement to the binding, so the statement must no longer drop it
			// — a second drop of the box the binding now owns is a double-free. A struct box is never in the
			// pending list (only `emitStringInterp` enrolls); an owned interpolation result is, so this is
			// what moves its drop from statement-end to scope-exit.
			self.removeFromPendingTemps(boundValue)
		end 'trackOwned'

		// ⭐ **A PROMISE BINDING OWNS A GREEN THREAD (P1.5-B2 #88), the dual of the E3100 linear-await check.**
		// `let/var p = async f()` enrols the spawn as an owned value, so the SAME scope-exit / re-arm / branch-
		// reconciliation machinery that drops an owned heap box (`emitScopeDrops`, `reconcileMovesAtMerge`,
		// `reassignBindingValue`) drops (and cancels) the thread — through `__gt_promise_drop` — on every path
		// that does not `await` it. `await` marks it moved (`consumePromiseThread`), so an awaited path skips it.
		//
		// ⚠ **AN ALIAS (`let q = p`, `boundBareLocal`) IS NOT A SECOND OWNER.** A promise ALIASES rather than
		// moves (linearity keys on the shared thread ValueId — `await p; await q` is one thread awaited twice),
		// so `q` binds `p`'s value verbatim and is NOT enrolled: exactly the spawn binding drops the one thread
		// once. This is why promises are enrolled separately from `valueIsOwnedHeap` (which move-poisons a bare-
		// local RHS) rather than folded into it. A promise is never `valueIsOwnedHeap`, so the two are disjoint.
		if self.valueIsPromise(boundValue) and not boundBareLocal 'trackPromise'
			self.ownedBindings.push(binding)
			self.removeFromPendingTemps(boundValue)
		end 'trackPromise'
	end 'parseBinding'

	// Open a lexical block — an `if` / `else` / `while` body. THREE things are scoped to
	// it and must be opened and closed TOGETHER: the Scope frame its declarations land
	// in, the height of the mutable-binding list, and the height of the owned-binding
	// list. A `var` that leaves scope must also leave the first, or the next merge
	// snapshot would mint a phi for a binding no source line can name; a struct binding
	// that leaves scope must leave the second, or a later `return` would emit a
	// `__mm_decref` for a name that is gone — a DOUBLE FREE if the block already
	// returned through it. Returns the mark `closeBlock` unwinds to.
	//
	// ONE mark serves both lists, and that is sound rather than a shortcut: both are
	// append-only stacks pushed at a declaration and drained here, so their heights move
	// together with the block structure. It is not one mark serving two INDICES — each
	// list is drained to its own recorded height (see `BlockMark`).
	function openBlock() returns BlockMark
		self.scope.pushScope()
		return BlockMark.create(self.mutableVars.count(), ownedCount: self.ownedBindings.count())
	end 'openBlock'

	// Close a lexical block: drop its declarations out of scope (restoring anything they
	// shadowed), its `var`s off the mutable-binding list, and its owned bindings off the
	// owned list.
	//
	// ⚠ **IT EMITS NO DROP, AND THAT IS NOW CORRECT RATHER THAN A DEFERRAL.** The `__mm_decref` for a
	// block-local owned binding — `if c 'b' let s = build(1) end 'b'` — is emitted by the code that
	// makes control LEAVE the block, keyed on HOW it leaves: a fall-through drops it in `parseBlockBody`
	// (before this pops it), a `break`/`continue` in `parseBreakStatement`/`parseContinueStatement`
	// (down to the enclosing loop's height), a `return` in `emitScopeDrops` (the whole scope). That
	// placement is what avoids the double-free/use-after-free this comment once warned the drop-here
	// approach could not: each edge that leaves the block alive drops exactly once, and a terminated
	// edge has already dropped, so this routine only unwinds the TRACKING lists and emits nothing.
	function closeBlock(mark BlockMark)
		self.scope.popScope()
		while self.mutableVars.count() > mark.mutableCount 'drainVars'
			_ = try self.mutableVars.pop() otherwise panic("closeBlock: mutableVars.pop failed above the mark {mark.mutableCount}")
		end 'drainVars'
		while self.ownedBindings.count() > mark.ownedCount 'drainOwned'
			_ = try self.ownedBindings.pop() otherwise panic("closeBlock: ownedBindings.pop failed above the mark {mark.ownedCount}")
		end 'drainOwned'
	end 'closeBlock'

	// Parse a lexical block's statements into `block`, through its closing `end [label]`.
	// The ONE place a block body is parsed, so the scope frame is opened and closed in
	// one place too: an `if` body, an `else` body, a `while`/`for` body and a block-form
	// `otherwise` handler all come through here. The caller has already consumed the
	// block's opening label and passes it as `label`.
	//
	// Returns the block the body's last statement left control in (which is `block`
	// itself only for straight-line code — a nested `if` moves control into its
	// continuation).
	//
	// ⭐ **AN EMPTY LABELLED BLOCK IS E3082**, and it is checked HERE because this is the one routine
	// that sees a NESTED block's statements — which is also exactly why a FUNCTION body is exempt
	// (`function doNothing() end 'doNothing'` is legal, `empty-block.md`'s `valid-empty-function`).
	// The exemption is therefore structural rather than a carve-out anyone has to remember. The check
	// runs before the scope frame opens, so the throw leaves no half-opened block behind, and it is
	// anchored on the closing `end` — where the missing statements would have gone. A body holding
	// only a COMMENT reads as empty, because the lexer emits no token for one; the spec's own
	// documentation example is exactly that program.
	function parseBlockBody(func IrFunction, block IrBlock, label ByteArray) returns IrBlock throws ParseError
		self.skipNewlines()
		if self.at(TokenKind.end) 'emptyBlock'
			let endTok = self.current()
			throw ParseError.emptyBlock(String.from(label), line: endTok.line, column: endTok.column)
		end 'emptyBlock'

		let mark = self.openBlock()
		let bodyEnd = try self.parseStatements(func, block: block)

		// ⭐ **DROP THE BLOCK'S OWN OWNED BINDINGS ON FALL-THROUGH** — a `let s = build(i)` inside an
		// `if`/`while` body dies at the block's `end`, so a loop body drops per iteration. Only the
		// bindings the block itself declared (above `mark.ownedCount`); the outer ones drop when THEIR
		// block closes. Emitted into `bodyEnd` — which IS `self.currentBlock`, as `parseStatements`
		// threads it — BEFORE `closeBlock` pops them off the list, and before the caller
		// (`parseIf`/`parseWhile`) emits the block's exit jump, so the drops precede the continuation
		// branch / back-edge.
		//
		// ⚠ Skipped on a TERMINATED `bodyEnd`: a `return`/`break`/`continue` on every path has already
		// emitted its own drops (the whole scope, or down to the enclosing loop), so dropping again here
		// would double-free — the exact hazard `closeBlock`'s old comment named. `isTerminated()` is the
		// guard that makes this an addition rather than that bug.
		if not bodyEnd.isTerminated() 'dropBlockOwned'
			self.currentBlock = bodyEnd
			self.emitScopeDrops(mark.ownedCount, anchor: self.current())
		end 'dropBlockOwned'

		// Published for `parseWhileStatement`'s drift guard — the cursor is ON the `end` here,
		// which is the one place the block's closing token index is known.
		self.lastBlockBodyEnd = self.pos
		try self.consume(TokenKind.end)
		self.skipOptionalLabel()
		self.closeBlock(mark)
		return bodyEnd
	end 'parseBlockBody'

	// Parse a reassignment `<name> = <expr>` (M4b). The target must be a declared
	// `var`; a `let` target is E2013, an undeclared name is `undefinedVariable`. The
	// RHS is evaluated FIRST (so `x = x + 1` reads the old `x`), then the binding's
	// current SSA value is rebound to the result via `Scope.setValue` — the read-
	// after-write model that makes a later reference see the new value. No slot,
	// no store op: the value model is on-the-fly SSA (the reassignment is just a
	// rebinding of the variable's current ValueId, and the loop machinery inserts
	// phis where the rebinding crosses a control-flow merge).
	//
	// **THE ASSIGNED VALUE MUST AGREE WITH THE BINDING'S DECLARED TYPE, AND THAT CHECK IS WHAT
	// MAKES EVERY MERGE PHI'S TYPE TRUE.** A binding's type is fixed where it is declared
	// (`var x = 5` is an int) and `VarInfo.varType` holds it; a reassignment does not redeclare
	// it. There are therefore TWO records of a value's type — the per-VALUE column
	// (`self.valueTags`, which follows the value) and the per-BINDING one (`varType`, frozen at
	// the declaration) — and they meet in exactly one place: `mintPhiForBinding`, which stamps
	// a merge phi with the BINDING's type while the phi carries the REASSIGNED value.
	//
	// So without this check the binding type is a LIE that the phi launders into the value
	// column, and every rule downstream reads the lie and is satisfied:
	//
	//     var x = 5
	//     if c 'b'
	//         x = false        // unchecked: the binding still claims `int`
	//     end 'b'
	//     return x + 1         // the phi is tagged `integer`, so `+` sees two ints — and adds
	//                          // a bool. THE ENTIRE RUNG, defeated by one `if`.
	//
	// Checking the ASSIGNMENT — one statement — makes all three phi mint sites (if-merge, loop
	// header, loop exit) sound BY CONSTRUCTION, with no per-edge check anywhere. Deriving each
	// phi's tag from its incoming values instead cannot work: the loop-header phi is minted
	// EAGERLY, before the body that writes those values has been parsed.
	//
	// AUTHORED, not ported — like the `if <int>` rule, and for the same reason. The C# bootstrap
	// has no assignment type check at all: it accepts `var x = 5` / `x = true` outright, and
	// catches the laundered value only when it is USED, in its Maxon→Std lowering, as an
	// INTERNAL error (E9001, a .NET cast failure with a stack trace and no source position). It
	// does not consider such a program valid — it just has nowhere to say so. shv2 says so here,
	// at the statement that introduces the contradiction.
	function parseAssignment(func IrFunction, block IrBlock) throws ParseError
		// The target's own token index, captured before the cursor leaves it, so the E3070 subject below comes
		// through the shared `borrowSubjectNameAt` rather than off `nameTok.value` — one derivation of "which
		// storage does this write go through", asked identically at every door. It is handed on to
		// `parseTopLevelAssignment` as well: the module-storage rebind is the same write one anchoring out,
		// and deriving it there off the token's TEXT would be that one derivation written down twice.
		let nameIndex = self.pos
		let nameTok = try self.consume(TokenKind.identifier)
		try self.consume(TokenKind.equals)

		// `_ = <expr>` — a DISCARD assignment: evaluate the RHS for its effect and throw the value away. `_`
		// binds nothing (`DiscardBindingName`, the same discard the match-payload `walk(_)` uses), so it is
		// never a scope binding and would otherwise reach `undefinedVariable`. An owned RHS temporary drops at
		// statement end through `drainPendingTemps`, exactly as a bare-call statement's result does. This is
		// the value-position twin of the bare-call statement, reached by `_ = try arr.pop() otherwise 0` and
		// any `_ = f(…)`.
		if nameTok.value.equals(DiscardBindingName) 'discardResult'
			_ = try self.parseExpression(func, block: block)
			return
		end 'discardResult'

		if not self.scope.contains(nameTok.value) 'undeclared'
			// Not a local. It may still name a top-level binding — a `var` (a STORE) or a `let` (an
			// error, and a DIFFERENT error from "undefined"). LOCAL FIRST, exactly as
			// `parseVariableReference` resolves a read: a local `var` shadows a top-level one, so the
			// top level is consulted only once the name has failed to resolve as a local.
			try self.parseTopLevelAssignment(func, block: block, nameTok: nameTok, nameIndex: nameIndex)
			return
		end 'undeclared'

		let binding = self.scope.getInfo(nameTok.value)

		// A bare field name inside an instance method — `count = count + 1`. It is a STORE through
		// the receiver, not a rebinding of anything, so it asks the field's mutability rather than
		// this binding's (see `parseSelfFieldAssignment`) and never reaches `setValue` below.
		if binding.isSelfField 'selfField'
			try self.parseSelfFieldAssignment(func, block: block, nameTok: nameTok, binding: binding)
			return
		end 'selfField'

		try self.requireMutableBinding(binding, nameTok: nameTok)

		// ⭐⭐ **E3070's REBIND DOOR — and shv2 must REFUSE where the oracle merely forgets the borrow.**
		// `arr = other` drops the record `arr` held (`reassignBindingValue` decrefs it), so every element
		// borrowed out of it is freed: MEASURED **0xC0000005** on `let s = try arr.get(0) otherwise ""` +
		// `arr = StringArray.create()` + `print("{s}")`, where the oracle prints the string and exits 0. It
		// gets away with it because it RETAINS on `get` and so simply KILLS the borrow at a reassignment
		// (`BorrowCheckPass.cs:129-132`); shv2 takes no reference there, so killing the borrow would be
		// unsound and the only two answers left are retain-on-get or refuse. This rung IS the refusal.
		if self.functionHoldsABorrow(func) 'mayConflictWithABorrow'
			self.noteBorrowSubjectWrite(func, subjectName: self.borrowSubjectNameAt(nameIndex), display: ReassignMutationDisplay, anchor: nameTok, mutatesSubject: true)
		end 'mayConflictWithABorrow'

		let rhsStart = self.pos
		let value = try self.parseExpression(func, block: block)
		// Was the RHS a bare reference to a local (`s = t`)? Only then can this assignment MOVE an owned
		// value out of a source binding; every other RHS is a consume. Captured off the token position
		// so `reassignBindingValue` gates the poison's owned-set scan on it (see `rhsWasBareLocalReference`).
		let rhsWasBareLocal = self.rhsWasBareLocalReference(rhsStart)

		let valueTag = self.tagOf(value)
		let declaredTag = maxonTypeTag(binding.varType)

		// ⭐ The binding KEEPS ITS DECLARED TYPE ACROSS A REBIND, so `x = 3` into a `var x = 0.0` rebinds
		// to a WIDENED float and not to the raw integer. Without the coercion the binding silently became
		// an int: `x == 3.0` on the next line was E3005 ("cannot compare int with float") against a
		// perfectly legal program, and a rebind INSIDE A LOOP fed an i64 and an f64 into one header phi —
		// measured, a cross-register-file panic in the x64 emitter.
		let assigned = try self.assignableValue(nameTok, value: value, declared: declaredTag, noun: "variable")

		// ⭐ OPEN #54/#59: reassigning a `var` to the WRONG named aggregate — a DIFFERENT struct/union, OR
		// an aggregate where the binding declares a SCALAR — is a retype the tag check above cannot see
		// (`structRef == structRef` for any two structs; a boxed union and a ranged-int alias share
		// `named`); the overwritten box would later be dropped under the binding's declared destructor —
		// a wild free / leak. `assignableValue`'s verdict stays tag-based (its scalar-coercion job is, and
		// it is SHARED with the global-store and field callers). Identity is the interned name, EXACT.
		// Un-gated — both names are computed unconditionally, empty for a scalar with no allocation — and
		// `giveTypeName` prints the scalar side's primitive, not an empty name.
		//
		// It reads the PARSED value, not the coerced one: a widening only ever produces a float scalar, so
		// both aggregate names are empty on that path and the question is the same one either way.
		let declaredAggregate = self.aggregateNameOf(declaredTag, nameId: typeNameIdOf(binding.varType))
		let assignedAggregate = self.aggregateNameOf(valueTag, nameId: self.valueNameId(value))
		if self.signatures.aggregatesConflict(declaredAggregate, got: assignedAggregate) 'aggregateReassignMismatch'
			throw ParseError.assignTypeMismatch(String.from(nameTok.value), got: self.giveTypeName(valueTag, aggregateName: assignedAggregate), expected: self.giveTypeName(declaredTag, aggregateName: declaredAggregate), line: nameTok.line, column: nameTok.column)
		end 'aggregateReassignMismatch'

		try self.reassignBindingValue(func, binding: binding, nameTok: nameTok, value: assigned, rhsWasBareLocal: rhsWasBareLocal)
	end 'parseAssignment'

	// ⭐ **REBIND A `var` TO A NEW VALUE, RELEASING WHAT IT OWNED.** The rebinding half is one line —
	// `Scope.setValue` — but a `var` that owns a heap allocation (an owned interpolation String, a
	// struct box) must DROP that allocation as it is overwritten, or it leaks: a binding's scope-exit
	// drop only ever reaches the LAST value it was assigned, so every earlier one is lost.
	//
	// The bug is MASKED at this rung and stops being masked the moment `__mm_free` reclaims: today the
	// bump allocator recycles nothing, and the leak counter nets to zero by coincidence — the
	// overwritten value that leaks and the last value (drained as a statement temporary AND dropped at
	// scope exit) that double-frees cancel one-for-one. With a real free list the same miscompile is a
	// leak, a double-free and a use-after-free at once.
	//
	// ⚠ **OWNERSHIP IS BINDING-LEVEL: `wasOwned` reads membership in `ownedBindings` (`bindingIsOwned`),
	// NEVER `valueIsOwnedHeap(oldValue)`.** A loop-carried `var`'s current value is a header phi, and a
	// phi carries no owned-heap provenance bit (the bit rides the value flowing INTO the merge, not the
	// merge) — so the value column reads `false` for a binding the loop genuinely owns, and the
	// overwritten allocation would leak every iteration. Membership is the only record that survives the
	// phi. `newIsOwned` is `valueIsOwnedHeap` — the SAME predicate `parseBinding` enrols a fresh binding by —
	// so the reassign and the declaration cannot drift on what "owned" means.
	//
	// ⚠ **AN OWNED BINDING STAYS OWNED — a borrowed RHS is PROMOTED to an owned copy rather than the
	// binding being removed from `ownedBindings`.** Removal would be a middle-of-stack delete, and
	// `ownedBindings` is a STACK whose heights the block/loop drop marks (`BlockMark.ownedCount`,
	// `LoopContext.ownedFloor`) index into: reassigning an OUTER owned `var` to a literal inside a
	// nested block would delete a below-mark entry, shift every block-local drop down one slot, and
	// strand a block-local binding to be dropped at function exit on a path where its value is not even
	// defined (a register-allocator "use dominates def" panic, verified). Promoting the literal to an
	// owned heap copy — the SAME fused-record copy a borrowed `return` makes (`promoteToOwnedString`) —
	// keeps every reassignment of an owned binding a uniform owned→owned: the binding never moves, and
	// an `if`/loop merge is handled by the phi machinery exactly as for any other carried value.
	function reassignBindingValue(func IrFunction, binding VarInfo, nameTok Token, value ValueId, rhsWasBareLocal bool) throws ParseError
		let oldValue = binding.boundValue

		// `s = s` (a self-rebind): the value and its ownership are unchanged, so there is nothing to drop
		// and nothing to reclassify. Guarding here is also what keeps a loop self-assign — where
		// `oldValue` is a provenance-free phi — from being misread and re-tracked, and prevents a
		// drop-then-keep (decref'ing a value the binding still holds).
		if oldValue == value 'selfAssign'
			self.scope.setValue(nameTok.value, value: value)
			return
		end 'selfAssign'

		// ⭐ **RE-ARM A PROMISE BINDING (P1.5-B2 #88).** A promise is a scalar green-thread handle with a
		// bespoke drop (`__gt_promise_drop`), never COW-promoted — so a binding that owns (or receives) a
		// thread MUST be handled here, before the heap move/promotion path below (which would `promoteBorrowed`
		// a scalar and panic).
		let oldIsPromise = self.valueIsPromise(oldValue)
		let newIsPromise = self.valueIsPromise(value)
		if oldIsPromise or newIsPromise 'promiseReassign'
			// ⚠ **"STILL OWNS A LIVE THREAD" IS READ FROM MEMBERSHIP, NOT `valueIsPromise(oldValue)`.** A
			// loop-header / if-merge phi carries no promise mark, so the value bit is phi-BLIND — a re-armed
			// `var p` across a merge holds that unmarked phi as `oldValue`. Membership is the SAME source the
			// heap path reads for exactly this reason (`wasOwned` below), which single-sources the drop
			// decision so promise- and heap-provenance cannot drift across a phi again (Finding 1).
			let ownsLiveThread = not binding.movedFrom and self.bindingIsOwned(binding)

			// `p = q` — rebinding a promise binding to an ALIAS is refused: it would give one thread two owners
			// (a double drop) or orphan this binding's own thread. A fresh `async` spawn is the only legal
			// promise RHS; `await` one name before re-binding.
			if newIsPromise and rhsWasBareLocal 'aliasRebind'
				throw ParseError.unsupported("a promise binding ('{String.from(nameTok.value)}') cannot be re-armed from another promise binding — only a fresh `async` spawn may re-arm it; `await` one name before re-binding", line: nameTok.line, column: nameTok.column)
			end 'aliasRebind'

			// ⭐ **FINDING 2 — re-arming would DROP a thread another name still ALIASES.** `let q = p` gives
			// this binding's thread a second name without enrolling it (a promise aliases, it does not move);
			// re-arming `p` here drops the thread while `q` still names it, so a later `await q` reclaims freed
			// memory — a UAF E3100 cannot catch (it is not a double await). Refuse it (a compile error, not a
			// miscompile). Gated on `ownsLiveThread`, so a re-arm AFTER the thread was awaited (the committed
			// `double-await-alias-outlives-rebind`, whose re-arm drops nothing) stays a linearity check, not this.
			if ownsLiveThread and self.promiseThreadHasLiveAlias(func, reArmedName: nameTok.value, thread: oldValue) 'aliasedThreadRearm'
				throw ParseError.unsupported("cannot re-arm the promise binding ('{String.from(nameTok.value)}'): its green thread is still named by an alias, so dropping it here would leave that alias dangling — `await` through one name before re-arming", line: nameTok.line, column: nameTok.column)
			end 'aliasedThreadRearm'

			// Drop (cancel) the old thread iff this binding still OWNS a live one — membership-based, so it
			// fires even when `oldValue` is a phi (a re-armed `var` across a loop / branch). A binding whose
			// thread an `await` consumed (`movedFrom`) owns nothing, so reassigning it to a scalar is fine and
			// drops nothing (Finding 4). `emitDecref` routes an owned promise to `__gt_promise_drop`.
			if ownsLiveThread 'dropOldThread'
				self.emitDecref(oldValue, range: SourceRange.ofToken(nameTok))
			end 'dropOldThread'

			let alreadyInSet = self.bindingIsOwned(binding) or binding.movedFrom
			self.scope.setValue(nameTok.value, value: value)
			if newIsPromise 'revivePromise'
				// The binding owns the fresh thread — revive it for reads and its scope-exit drop, and enrol
				// once (a re-armed promise is already in the set as a moved ghost; a non-promise binding first
				// taking a promise — `var x = 5; x = async f()` — joins now).
				binding.movedFrom = false
				binding.partiallyMoved = false
				if not alreadyInSet 'enrolPromise'
					self.ownedBindings.push(binding)
				end 'enrolPromise'
			end 'revivePromise' else 'becameScalar'
				// A non-promise value (`p = 5` after a consuming `await`, or after the live thread was dropped
				// just above): the binding now owns nothing droppable. It STAYS in `ownedBindings` (mid-stack
				// removal would desync the block/loop drop marks), so it is marked MOVED to make `emitScopeDrops`
				// skip it — a bare scalar must not be `__mm_decref`'d. Reads still work: `requireBindingLive`
				// admits any scalar-tagged binding (a scalar is never an unsafely-moved heap value).
				binding.movedFrom = true
				binding.partiallyMoved = false
			end 'becameScalar'
			self.removeFromPendingTemps(value)
			return
		end 'promiseReassign'

		// ⭐ **MOVE-ON-ASSIGN.** A bare reference to an ALREADY-owned binding as the RHS (`s = t`) MOVES
		// that value: poison the source so a later read of it is use-after-move and only the new owner
		// drops the value. A fresh owned temp is held by no binding — a CONSUME, not a move. Gated on
		// `rhsWasBareLocal`, so a consume never pays the owned-set scan; run BEFORE `setValue` below, so
		// the scan matches the SOURCE's value rather than this binding's (which `setValue` is about to
		// overwrite with the moved value).
		if rhsWasBareLocal 'moveOnAssign'
			try self.poisonMoveSource(value, anchor: nameTok)
		end 'moveOnAssign'

		// Is `binding` a LIVE owner (owes a drop of `oldValue`), and/or already enrolled in
		// `ownedBindings`? `binding.movedFrom` is read DIRECTLY, not via `bindingIsOwned`: a moved-from
		// binding shares its stale `boundValue` with the binding it moved to, so a value-keyed membership
		// test would find that new owner and wrongly report the moved-from binding as still owning a
		// drop. A moved-from binding owns NOTHING (its value belongs to its new owner), so it drops
		// nothing here — but it IS still in `ownedBindings`, so a revive must not re-enrol it.
		let wasMovedFrom = binding.movedFrom
		let wasOwned = not wasMovedFrom and self.bindingIsOwned(binding)
		let inOwnedSet = wasOwned or wasMovedFrom

		// Promote a borrowed value assigned to a binding that is (or stays) in the owned set to an owned
		// value, so the binding keeps owning a droppable one rather than being deleted from the middle of
		// the owned-binding stack (see the header). Two shapes reach here: a borrowed String
		// (owned→borrowed `s = "literal"`, or a moved-from String revived with a literal), COPIED; and a
		// borrowed struct/union (`q = p2`, reassigning a retained OPEN #40 aggregate var to another borrowed
		// parameter — same aggregate type, so `requireAssignable` admits it), INCREF'd. The same
		// `promoteBorrowedToOwned` the declaration routes through, so the two sites cannot answer the
		// String-vs-aggregate question differently: string-promoting a borrowed struct here blits its fields
		// as a fused String record, a silent miscompile.
		var newValue = value
		var newIsOwned = self.valueIsOwnedHeap(value)
		if inOwnedSet and not newIsOwned 'promoteBorrowed'
			newValue = try self.promoteBorrowedToOwned(value, range: SourceRange.ofToken(nameTok))
			newIsOwned = true
		end 'promoteBorrowed'

		// Release the overwritten allocation BEFORE the rebind, while `oldValue` still names it. Only a
		// LIVE owner has one to release: a moved-from binding's old value belongs to the binding it moved
		// to, which drops it — decref-ing it here would double-free.
		if wasOwned 'dropOld'
			self.emitDecref(oldValue, range: SourceRange.ofToken(nameTok))
		end 'dropOld'

		self.scope.setValue(nameTok.value, value: newValue)

		// A WRITE REVIVES the binding: it owns `newValue` now, so a later read of it is legal again. Both
		// move states are cleared — `partiallyMoved` no less than `movedFrom`, because a reassignment gives
		// the binding a WHOLE fresh value (no moved-out slots), so a scrutinee consumed by an earlier
		// binding-match is fully live once overwritten. Clearing only `movedFrom` left `requireBindingLive`
		// (which rejects on EITHER flag) refusing every use of a reassigned `var` union — an over-rejection
		// of a valid program.
		binding.movedFrom = false
		binding.partiallyMoved = false

		if newIsOwned 'trackNew'
			if not inOwnedSet 'borrowedToOwned'
				// A genuinely borrowed binding (`var s = ""; s = build(1)`) joins the owned set. A binding
				// already in the set — a live owner, or a moved-from ghost being revived — must NOT be
				// pushed again, or scope exit would decref `newValue` twice.
				self.ownedBindings.push(binding)
			end 'borrowedToOwned'
			// The new owned value is the binding's to drop at scope exit, so the STATEMENT must not also
			// drop it: a call/interpolation/promotion result is enrolled as a pending temp, and draining
			// it too would be a double-free (and, before the scope-exit drop, a use-after-free).
			self.removeFromPendingTemps(newValue)
		end 'trackNew'
	end 'reassignBindingValue'

	// Assign to a name that is not a local: a top-level `var` (a STORE to its `.data` slot), a
	// top-level `let` (E2013 — assigning to a constant), or nothing (E2004).
	//
	// **THE `let` ARM IS WHY THE CONSTANT IS PROBED AT ALL.** Without it a top-level `let` would
	// resolve as neither a local nor a var and be reported "undefined variable: 'origin'" — naming a
	// name that IS defined, three lines up, which is a diagnostic that sends the reader looking for a
	// typo instead of at the `let` they meant to write `var`. `specs/static-variables.md`'s
	// `top-level-let-struct-reassign-error` pins the honest one (E2013).
	//
	// The type check the local path applies is applied here too, and through the same
	// `typesAgree`/`assignTypeMismatch` pair — a global is no less able to be handed a bool where it
	// declared an int, and a laundered value in a `.data` slot is exactly as wrong as one in a
	// register. The check happens BEFORE the store is emitted, so a rejected program emits no op.
	//
	// ⚠ **HAVING A SLOT IS NOT PERMISSION TO WRITE ONE** (P1.7 slice 2b). `globalDeclFor` answers "which slot
	// does this name denote?", and an array `let` has an answer to that — its value is a heap record, so it
	// is STORED like a `var` and read like one. Whether it may be WRITTEN is the separate question this
	// statement is the only asker of, so the `mutable` bit rides the lookup and the refusal happens here.
	// Without it `let xs = [1, 2]` would silently accept `xs = [3, 4]` — an accepted write that should have
	// been refused, which is a wrong answer rather than a compile error.
	function parseTopLevelAssignment(func IrFunction, block IrBlock, nameTok Token, nameIndex TokenIndex) throws ParseError
		match self.signatures.globalDeclFor(nameTok.value, readerFilePath: self.filePath) 'global'
			found(label, valueType, mutable) then try self.storeToGlobal(func, block: block, nameTok: nameTok, nameIndex: nameIndex, label: label, valueType: valueType, mutable: mutable)
			notFound then try self.rejectNonGlobalAssignment(nameTok)
		end 'global'
	end 'parseTopLevelAssignment'

	// Write a top-level global, or refuse because it is immutable — an array `let`, the one binding that has
	// a slot and still refuses the write (P1.7 slice 2b).
	//
	// It raises E2013 HERE rather than through `rejectNonGlobalAssignment` below, because the two know
	// different things and the difference is the whole diagnostic: that one is reached having established
	// the name is NOT a stored global, so it must go and ask whether the name exists at all before it can
	// choose between E2013 and E2004. This one is holding the resolution that proves the name is declared,
	// so the question is already answered and re-asking it through a kind-filtered door would report a
	// declared name as undefined.
	function storeToGlobal(func IrFunction, block IrBlock, nameTok Token, nameIndex TokenIndex, label ByteArray, valueType MaxonType, mutable bool) throws ParseError
		if not mutable 'immutableGlobal'
			throw assignToImmutableError(nameTok)
		end 'immutableGlobal'

		// ⭐ **E3070's REBIND DOOR FOR MODULE STORAGE — the same write as `arr = other`, one anchoring out.**
		// The store below DECREFS the record the slot was holding (`emitCheckedGlobalStore`), so every element
		// borrowed out of it is freed: MEASURED **0xC0000005** on `let s = try g.get(0) otherwise ""` +
		// `g = StringArray.create()` + `print("{s}")`. The subject comes through `borrowSubjectNameAt` like
		// every other door's, off the target's own token — the derivation, not the token's text.
		if self.functionHoldsABorrow(func) 'mayConflictWithABorrow'
			self.noteBorrowSubjectWrite(func, subjectName: self.borrowSubjectNameAt(nameIndex), display: ReassignMutationDisplay, anchor: nameTok, mutatesSubject: true)
		end 'mayConflictWithABorrow'

		try self.emitCheckedGlobalStore(func, block: block, nameTok: nameTok, label: label, valueType: valueType)
	end 'storeToGlobal'

	// Parse the right-hand side, check it against the global's declared type, and store it.
	//
	// ⭐⭐ **A MANAGED GLOBAL'S WRITE IS THREE THINGS, NOT ONE** (P1.7 slice 2a): take ownership of the new
	// value, RELEASE the record the slot was holding, then store. The order matters in both directions —
	// the release must come after the new value is settled (it may be built from the old one) and before
	// the store overwrites the only pointer to it.
	//
	// ⚠ **THE OLD-VALUE DECREF IS UNCONDITIONAL, WITH NO NULL TEST, AND THAT RESTS ON `__module_init`.**
	// Both reference compilers guard it (`EmitDecrefValueIfNonnull`, `__mm_decref_maybenull_helper`) and
	// then have to special-case the initializer function BY NAME to suppress it, because in their design a
	// global's first store IS an ordinary store into a slot that is still zero. shv2's initializing store
	// is not on this path at all — it is `ModuleInit`'s own emission, in a function that runs before
	// `main` — so every store reaching HERE is a re-assignment of a slot `__module_init` already filled.
	// One fact ("the slot is non-null throughout `main`") replaces a runtime branch on every write and a
	// name match in the middle of the lowering.
	function emitCheckedGlobalStore(func IrFunction, block IrBlock, nameTok Token, label ByteArray, valueType MaxonType) throws ParseError
		let valueStart = self.pos
		let value = try self.parseExpression(func, block: block)

		// The slot keeps the type its declaration gave it, so `g = 3` into a `var g = 0.0` stores a WIDENED
		// f64 and not the integer's raw bytes — the same coercion the local rebind above performs, through
		// the same door.
		let declared = maxonTypeTag(valueType)
		let stored = try self.assignableValue(nameTok, value: value, declared: declared, noun: "global")

		let range = SourceRange.ofToken(nameTok)
		if not self.signatures.typeIsManaged(valueType) 'scalarGlobal'
			self.emitGlobalStore(label, valueType: valueType, value: stored, range: range)
			return
		end 'scalarGlobal'

		// The slot is DURABLE STORAGE, exactly as a struct field or a union payload is, so the new value
		// arrives through the one door that decides copy-vs-move for all of them: a borrowed String is
		// COPIED into a fresh owned record, an already-owned value is MOVED (its source binding poisoned,
		// or its pending statement-end drop cancelled). A second spelling here would be free to leak the
		// temporary or double-free the source.
		let owned = try self.moveManagedValueInto(stored, argBareLocal: self.rhsWasBareLocalReference(valueStart), isString: tagIsText(declared), anchor: nameTok, range: range)

		self.emitDecref(self.emitGlobalLoad(label, valueType: valueType, range: range), range: range)
		self.emitGlobalStore(label, valueType: valueType, value: owned, range: range)
	end 'emitCheckedGlobalStore'

	// **THE MUTABILITY RULE FOR A LOCAL BINDING — asked by both statements that write one**: the
	// reassignment (`x = 5`, the binding itself) and the field store (`p.x = 5`, its INSTANCE). One
	// home, because it is one rule — a binding declared `let` does not accept a write — and the
	// diagnostic names that binding and anchors on the token that names it.
	//
	// ⚠ Written down twice, a future answer to what "writable" MEANS — a captured closure variable
	// (P1.4), a moved-from binding under static ownership — taught to one site and not the other
	// would let `p.x = 5` silently compile where `p = q` correctly reports. An ACCEPTED write that
	// should have been refused is a WRONG ANSWER, not a compile error, and neither site would read
	// as wrong on its own. The bootstrap is the cautionary tale: it spells this rule at FOUR sites
	// and reads `VarInfo.Mutable` in three unrelated places.
	function requireMutableBinding(binding VarInfo, nameTok Token) throws ParseError
		// ⭐ A binding an enclosing `for … in` is iterating may not be REBOUND either: the loop keeps
		// walking the record it captured in its preheader, and rebinding the name drops that record
		// (`reassignBindingValue`) while the header is still reading its length. The same one fact the
		// two receiver doors read — see `bindingIsIterationLocked`.
		if not binding.mutable or self.bindingIsIterationLocked(binding) 'immutable'
			throw assignToImmutableError(nameTok)
		end 'immutable'
	end 'requireMutableBinding'

	// **THE `__`-RESERVATION RULE, IN ONE PLACE.** A user may not DECLARE a name that starts with the
	// prefix Maxon reserves for compiler internals (see `ReservedNamePrefix`). Raised as E2051 at the
	// declared name — the token the user has to change.
	//
	// ⚠ It is called at EIGHT binding sites — function/method name, parameter, top-level and body
	// `let`/`var`, `type` name, struct field, `typealias` name, enum/union case — and it is ONE call
	// at each, never eight copies of `bytesStartWith(…, b"__")` + the message. That the rule reads
	// once is the whole point: eight copies is this project's signature bug, and a reservation that
	// held at seven sites and lapsed at the eighth would be a SILENT hole (a user `__`-name accepted
	// there), not a compile error — exactly the class of defect this rung exists to close.
	//
	// ⭐ It sees only USER SOURCE TOKENS, which is why it does not — and structurally CANNOT — reject
	// the compiler's own `__` functions: `__mm_alloc`, `__print_string`, `__destruct_*` are built by
	// `IrFunction.createFromStd` and never pass through the parser. That is what makes the reservation
	// safe to lean on: once no user `__` name can be declared, `MmRuntime.isCompilerInternalCallee`'s
	// "skip the user-function checks" shortcut is provably sound rather than a hopeful one.
	function requireUnreservedName(nameTok Token) throws ParseError
		if bytesStartWith(nameTok.value, prefix: ReservedNamePrefix) 'reserved'
			throw ParseError.reservedIdentifier(String.from(nameTok.value), line: nameTok.line, column: nameTok.column)
		end 'reserved'
	end 'requireUnreservedName'

	// ⭐ **A DECLARATION MAY NOT GIVE A COMPILER-OWNED TYPE NAME A *NOMINAL* IDENTITY (P1.7a slice 2b-ii).**
	// `requireUnreservedName`'s sibling, and the two are separate rules over separate name sets rather than one
	// combined check, because they govern different things: `__` is reserved at EVERY declaration (a local, a
	// field, a function, an enum case), while `Ordering`/`HashValue`/`ExitCode` are reserved only where a
	// declaration would mint a TYPE IDENTITY under the name — `let Ordering = 5` binds a value and collides
	// with nothing.
	//
	// ⚠ **NOMINAL is the precise line, and a RANGED typealias is deliberately on the legal side of it.** A
	// `type`, an `enum`/`union`, a FUNCTION typealias and a GENERIC-INSTANCE typealias each make the name mean
	// a distinct thing the parser re-tags a `named` reference INTO (`structRef`, an enum layout, `function`,
	// `genericInstance`) — and that is precisely where the parser and `resolveNamedType` come to disagree about
	// a compiler-owned name (see `TypeResolution.isCompilerOwnedTypeName` for the measured 0xC0000005). A
	// RANGED alias mints no identity at all: it ERASES to `integer`/`float`, which is what the builtin does
	// too, so the two answers agree and there is nothing to refuse. `specs-shv2/generic-type-nested-array-
	// typealias.md` declares `typealias ExitCode = int(0 to 125)` in all 27 of its cases and is correct to.
	function requireTypeNameNotCompilerOwned(nameTok Token) throws ParseError
		if isCompilerOwnedTypeName(nameTok.value) 'compilerOwned'
			throw ParseError.declarationTakesCompilerOwnedTypeName(String.from(nameTok.value), line: nameTok.line, column: nameTok.column)
		end 'compilerOwned'
	end 'requireTypeNameNotCompilerOwned'

	// ⭐⭐ **THE PARSER-TIER COERCION, PAID.** `TypeRules.widensIntToFloat` states the obligation an `ok`
	// verdict leaves behind; this is the ONE place the parser discharges it for an SSA value, and every
	// parser-tier coercion site routes through here rather than restating the rule. That is the whole
	// shape of the bug it closes: six doors each asked `checkDeclaredType`, accepted `ok`, and then went
	// on using the value they already held — an i64 in a GPR meeting a slot declared f64.
	//
	// `promoteToFloat` is the primitive (a `cvtsi2sd`, via `MaxonUnaryOp.promoteToFloat`) and it is
	// idempotent, so the guard is about the DECLARED side, not the value's: without it a `return 3` from
	// a `returns int` would convert too.
	//
	// ⚠ It is the PARSER's promotion and deliberately not the Std tier's. shv2 has exactly two promotion
	// primitives and the split is forced: `LowerMaxonToStd.floatWidenedArg` widens a call ARGUMENT, whose
	// callee signature is a whole-program fact the parser may not have; every site below is intra-file —
	// a `return` against its own function's declared type, a field against a layout already in hand, a
	// binding against its own declaration — so all of them promote HERE, off the `valueTags` column, with
	// no second table.
	function coerceToDeclared(value ValueId, declared ValueTypeTag, anchor Token) returns ValueId
		if not widensIntToFloat(self.tagOf(value), declared: declared) 'noWidening'
			return value
		end 'noWidening'

		// ⚠⚠ **THE RULE CANNOT TELL THE TWO `named` KINDS APART, AND ONLY AN INVARIANT HELD ELSEWHERE DOES.**
		// `widensIntToFloat` answers TRUE for a `named` value meeting a `float`, because `tagIsIntegral`
		// answers TRUE for every `named`. That is exactly RIGHT for a ranged INT alias — `var z = 0.0` then
		// `z = aCount` must convert — and CATASTROPHIC for a ranged FLOAT alias, whose value is already an
		// f64: a `cvtsi2sd` over its bit pattern is a silent wrong answer by ~300 orders of magnitude, not a
		// diagnostic. One tag, two representations, and the RULE sees only the tag.
		//
		// What actually keeps them apart is that no float-alias VALUE ever carries a `named` tag: every
		// producer lifts it to `float` first — `resolveFloatAliasType` at a parameter binding, a call result
		// and a closure capture, `ProgramSignatures.fieldTypeOf`'s float-alias arm at a field. So a `named`
		// float alias arriving HERE means a producer was added without that lift, which is a compiler bug and
		// never a program's.
		//
		// It is a PANIC and not a comment because the comment is what failed: `widensIntToFloat`'s own header
		// offered the `ok` verdict as the safeguard, and the verdict is no safeguard at all —
		// `checkDeclaredType(named, float)` answers `ok` and hands the conversion straight through. The next
		// rung to mint a float-alias value gets a named site instead of a number.
		if self.tagOf(value) == ValueTypeTag.named and self.namedIsFloatAlias(self.valueNameId(value)) 'unliftedFloatAlias'
			panic("Parser.coerceToDeclared: value v{value} is tagged `named` for the ranged FLOAT alias '{String.from(self.internedName(self.valueNameId(value)))}' and reached the int->float widening — every producer of a float-alias value must lift its tag through `resolveFloatAliasType` or `ProgramSignatures.fieldTypeOf` first, or this emits a `cvtsi2sd` over an f64 bit pattern")
		end 'unliftedFloatAlias'

		return self.promoteToFloat(value, opTok: anchor)
	end 'coerceToDeclared'

	// **CHECK AN ASSIGNED VALUE AGAINST ITS DECLARED SLOT AND HAND BACK THE VALUE THAT SLOT WANTS** — the
	// verdict and the coercion in ONE call, so a caller cannot take the `ok` and forget the conversion.
	// Every assignment-shaped door in the parser goes through it: a local `var` rebind, a top-level global
	// store, a struct-literal field, a field write, a self-field write.
	//
	// It returns a value rather than nothing precisely because the caller must REBIND: the promoted id is
	// a different SSA value from the one that was parsed, and a caller that stored the original would
	// store the raw integer bits — which is what all five of them did.
	function assignableValue(nameTok Token, value ValueId, declared ValueTypeTag, noun String) returns ValueId throws ParseError
		try self.requireAssignable(nameTok, value: self.tagOf(value), declared: declared, noun: noun)
		return self.coerceToDeclared(value, declared: declared, anchor: nameTok)
	end 'assignableValue'

	// The VERDICT rule for an ASSIGNMENT — the local path, the global one, the struct-literal field, the
	// field write and the field DEFAULT all ask it, and none of them restates it. A global is no less able
	// to be handed a bool where it declared an int, or a float where it declared an int, than a local is;
	// every one of them anchors the diagnostic on the assigned NAME and names its own PLACE (`noun`).
	//
	// ⚠ It is the verdict ALONE, and it is asked DIRECTLY by exactly one caller: the site holding a
	// parse-time CONSTANT rather than an SSA value (a struct field's literal default), which pays the
	// widening the verdict licenses in the constant's own representation. Every site holding a VALUE asks
	// `assignableValue` — this plus that conversion, in one call, so the two halves cannot come apart.
	function requireAssignable(nameTok Token, value ValueTypeTag, declared ValueTypeTag, noun String) throws ParseError
		match checkDeclaredType(value, declared: declared) 'declared'
			ok then break 'declared'
			mismatch then throw ParseError.assignTypeMismatch(String.from(nameTok.value), got: typeTagName(value), expected: typeTagName(declared), line: nameTok.line, column: nameTok.column)
			narrowsFloatToInt then throw ParseError.implicitNarrowing(typeTagName(value), targetType: typeTagName(declared), line: nameTok.line, column: nameTok.column)
			// A FUNCTION VALUE into a NON-function place (P1.5-A1) — the spec's specific E3005 ("cannot
			// assign a value of type 'function' to {noun} '{name}', which holds '{held}'"). `noun` is what
			// the caller names the place ("variable" for a local, "global"/"field" for the others).
			functionIntoNonFunction then throw ParseError.functionValueIntoNonFunction(noun, name: String.from(nameTok.value), heldType: typeTagName(declared), line: nameTok.line, column: nameTok.column)
		end 'declared'
	end 'requireAssignable'

	// The interned NAME behind a `named`/`structRef` id, from THIS file's interner — where every id a
	// type check sees was minted: the value during this parse, a declared return/field/binding type
	// from this file. A miss is a compiler invariant break, never user input (see TypeNameInterner).
	function internedName(id TypeNameId) returns ByteArray
		return try self.artifact.typeNames.nameOf(id) otherwise panic("Parser.internedName: type-name id {id} is not in this file's interner — every `named`/`structRef` id is minted from it")
	end 'internedName'

	// The interned type-name id of an SSA value, read straight from the dense `valueNameIds` column —
	// the id `typeOf` and `valueIsUnsigned` both need, and a scalar (no `MaxonType` materialized). A
	// miss is a parser invariant break: the two type columns are minted in lockstep for every value.
	function valueNameId(value ValueId) returns TypeNameId
		return try self.valueNameIds.get(value) otherwise panic("Parser.valueNameId: value v{value} has no recorded type name — the two type columns fell out of lockstep")
	end 'valueNameId'

	// Record that `value` (a generic instance) came from instance alias `aliasName` (P1.6-C) — the
	// provenance the shared `GenericInstanceId` cannot carry (`WrapperA` and `WrapperB` share one gid). An
	// EMPTY `aliasName` records nothing: a value with no statically-known alias DECAYS (its `Idx` results and
	// arguments lose per-instance identity), which matches the oracle.
	function recordValueInstanceAlias(value ValueId, aliasName ByteArray)
		if aliasName.isEmpty() 'noAlias'
			return
		end 'noAlias'
		// COPY-ON-WRITE off the shared empty map: a function that constructs an instance gets its own map here,
		// on first write, so the generics-free corpus never allocates one (the reset points at the shared one).
		if self.valueInstanceAlias is sharedEmptyInstanceAliasMap 'stillShared'
			self.valueInstanceAlias = ValueInstanceAliasMap.create()
		end 'stillShared'
		self.valueInstanceAlias.upsert(value, value: self.artifact.typeNames.intern(aliasName))
	end 'recordValueInstanceAlias'

	// The instance alias NAME `value` came from (`WrapperA`), or `EmptySourceText` when it has none — a
	// `self` receiver, a value merged across branches, or any non-instance value (P1.6-C).
	function instanceAliasNameOfValue(value ValueId) returns ByteArray
		let aliasId = try self.valueInstanceAlias.get(value) otherwise return EmptySourceText
		return self.internedName(aliasId)
	end 'instanceAliasNameOfValue'

	// ⭐ **THE INTERNED NAME OF THE DECLARED AGGREGATE A (tag, nameId) PAIR DENOTES, OR `EmptySourceText`
	// FOR ANYTHING THAT IS NOT ONE** — a scalar, a ranged-int alias, a String. The parser-tier half of
	// the OPEN #54 identity check, ported from v1's `namedStructOrEnumName` (SemanticCheck.maxon:2687),
	// which tells a struct/enum name apart from a numeric alias by the same registry lookup.
	//
	// ⚠ **KEEP IN LOCKSTEP WITH ITS SemanticCheck TWIN `aggregateNameFor`** — the two answer the SAME
	// question (which tags name an aggregate, and how) on the two interners the two tiers hold (this one
	// on the file-local `self.artifact.typeNames` + `self.signatures`; the other on the merged
	// `project.typeNames` + `project.structTypes`/`enumTypes`). The classification MUST match — teach a
	// new aggregate tag to one and not the other and a value the parser names an aggregate would slip the
	// call-argument check as a scalar. They cannot share a call (different tier, different interner), so
	// the safety net is the specs on BOTH sides: `error.return-wrong-union` guards this one,
	// `error.callarg-wrong-union-*` guards the twin.
	//
	// It takes the SCALAR (tag, nameId) pair, never a `MaxonType`, so a coercion site reads it off the
	// `valueTags`/`valueNameIds` columns (or a declared type's tag/id) and materializes no heap union —
	// the discipline TypeRules' header states for every type rule, and the reason `structRef`-returning
	// is checked without an allocation on the common scalar-returning path.
	//
	//   • `structRef` is ALWAYS a declared struct — its name, no registry lookup (the parser mints the
	//     arm only for a declared `type`, so `structRef` cannot name anything else).
	//   • `named` is a boxed union/enum HERE at the parser (TypeResolution erases it to an integer only
	//     later), so it is an aggregate exactly when the signature index registers its name — a
	//     ranged-int alias is `named` too and is numeric, NOT an aggregate (the theorem `typeClassOf`
	//     rests on).
	//   • every other tag names no aggregate.
	//
	// The "none" answer is `EmptySourceText`, matching this file's `enclosingType` idiom: a real
	// aggregate name is never empty, so `isEmpty()` distinguishes it exactly (`namedAggregatesConflict`).
	function aggregateNameOf(tag ValueTypeTag, nameId TypeNameId) returns ByteArray
		if tag == ValueTypeTag.structRef 'struct'
			return self.internedName(nameId)
		end 'struct'

		// ⭐ A GENERIC INSTANCE IS A NOMINAL AGGREGATE, IDENTIFIED BY ITS COMPILED NAME (P1.7). `Box with
		// Leaf` and `Box with Other` are both `genericInstance`-tagged pointers to a base `Box` box, so the
		// tag check reads them as one type and the wrong one, stored where the other is declared, is later
		// dropped by the wrong `__destruct_<instance>` — the identical wild free two distinct STRUCTS sharing
		// `structRef` would be, one abstraction up. The id a `genericInstance` carries is a
		// `GenericInstanceId`, which is whole-program (not a file-local interner id), so it needs no
		// `internedName` — and its name is a pure READ here, pre-derived by `queryProgramSignatures`.
		if tag == ValueTypeTag.genericInstance 'genericInstance'
			return self.signatures.canonicalInstanceName(nameId)
		end 'genericInstance'

		if tag != ValueTypeTag.named 'notNamed'
			return EmptySourceText
		end 'notNamed'

		let name = self.internedName(nameId)
		if self.signatures.containsStruct(name) or self.signatures.containsEnum(name) 'registeredAggregate'
			return name
		end 'registeredAggregate'

		// ⭐ A REGISTERED PER-INSTANCE ALIAS ("IntWrapper.Idx") is a nominal aggregate too (P1.6-C): a
		// `named` value carrying one has an IDENTITY the tag check cannot see (two per-instance aliases share
		// the `named` tag and the `integer` width). A BASE-TEMPLATE inner alias ("Wrapper.Idx") and a plain
		// ranged alias are NOT nominal — `isPerInstanceAlias` answers false for both — so they stay structural.
		if self.signatures.isPerInstanceAlias(name) 'perInstanceAlias'
			return name
		end 'perInstanceAlias'

		return EmptySourceText
	end 'aggregateNameOf'

	// ⭐ **THE PRE-ERASURE UNION/ENUM IDENTITY COLUMN A SIGNATURE CARRIES (OPEN #54 Slice B2)** — one
	// `ByteArray` per parameter for `FuncSignature.paramAggregateNames`, the interned name of a declared
	// boxed union/enum parameter and `EmptySourceText` for anything else. Captured HERE, at the real
	// parse, because this is the last point a union parameter still knows its name: `resolveTypes`
	// erases its `named` tag to bare `integer` (TypeResolution.resolveNamedType), leaving SemanticCheck's
	// call-argument check no name to compare. A STRUCT is deliberately left empty — its `structRef(id)`
	// survives resolution, so the check reads its name off `paramTypes` and the name is never stored
	// twice. The gate is exactly `tag == named`: a struct is `structRef` (skipped), a scalar or a ranged
	// alias is not `named` (skipped), and a `named` ranged/float alias yields `EmptySourceText` from
	// `aggregateNameOf` (not registered), so only a genuine boxed union/enum lands a non-empty entry.
	function paramAggregateNamesOf(paramTypes MaxonTypeArray) returns ByteArrayArray
		var names = ByteArrayArray.create()
		for pt in paramTypes 'each'
			let tag = maxonTypeTag(pt)
			if tag == ValueTypeTag.named 'erasableAggregate'
				names.push(self.aggregateNameOf(tag, nameId: typeNameIdOf(pt)))
			end 'erasableAggregate' else 'notErasable'
				names.push(EmptySourceText)
			end 'notErasable'
		end 'each'
		return names
	end 'paramAggregateNamesOf'

	// ⭐ **THE PRIMITIVE TAG THE RANGED ALIAS `nameId` REDUCES TO**, or `named` when no ranged alias
	// declares that name. It is decided through the SAME whole-program `aliasOf` door
	// `valueIsUnsigned`/`fieldStorageType` already ask, so an alias declared in ANY file resolves — and
	// NEVER a String/struct/union `named` (`aliasOf` answers `undeclared` for those, and the name keeps
	// its `named` tag). The parse-time twin of `TypeResolution.resolveNamedType`'s alias arm.
	//
	// ⚠ The caller must know the tag is `named` before asking: `nameId` for a non-`named` type is
	// `UnnamedTypeId`, which is not in the interner (`internedName` would panic). `floatResolvedTag` /
	// `resolveFloatAliasType` / `builtinConformerOfType` are the gated doors, and every reader goes
	// through one of them.
	//
	// TWO facts are read off this ONE reduction, and they must not become two lookups: whether a `named`
	// is a FLOAT alias (F2a — the tag `named` was too coarse to carry), and whether it is an INT alias
	// (the builtin-conformance receiver classifier, which must see `Byte` and `Integer` as `int` exactly
	// as `ProgramSignatures.conformerTypeArgName` does for a witness type argument).
	//
	// ⚠ **THE REGISTRY IS NOT THE WHOLE ALIAS SET, AND THE ONE NAME OUTSIDE IT IS THIS RUNG'S OWN RESULT
	// TYPE.** `HashValue` — what `hash()` returns — is a ranged int alias the COMPILER declares, so it is in
	// no registry `aliasOf` can see (`isSynthesizedIntAliasName`). Asked through the registry alone it
	// answered `named`, and `i.hash().hash()` — an int method on an int, which the header of
	// `builtinConformerOfType` claims is one conformer with `Integer`/`Byte`/`int` — was E2015 while
	// `TypeResolution.resolveNamedType` had erased the very same name to `integer` since slice 2a.
	function rangedAliasTag(nameId TypeNameId) returns ValueTypeTag
		let name = self.internedName(nameId)
		if isSynthesizedIntAliasName(name) 'compilerDeclaredIntAlias'
			return ValueTypeTag.integer
		end 'compilerDeclaredIntAlias'

		return match self.signatures.aliasOf(name, readerFilePath: self.filePath) 'a'
			declared(alias) gives maxonTypeTag(alias.underlying)
			undeclared gives ValueTypeTag.named
		end 'a'
	end 'rangedAliasTag'

	// Does `nameId` name a ranged FLOAT alias? A `float(low to high)` alias
	// (`Parser.readTypeAliasDeclaration`) is the ONE `named` type whose VALUE is a genuine float; an
	// `int(low to high)` alias is `named` too and is an int.
	function namedIsFloatAlias(nameId TypeNameId) returns bool
		return tagIsFloat(self.rangedAliasTag(nameId))
	end 'namedIsFloatAlias'

	// A `named` TAG that names a ranged float alias resolves to `float`; every other tag passes through —
	// an INT alias stays `named` (`checkDeclaredType` reads it identically, and its name still carries the
	// signedness `valueIsUnsigned` needs), a scalar/struct/String carries no alias. THE F2a resolution for
	// a DECLARED type met at a coercion site: `checkDeclaredType(3.14's float, Float)` must ask
	// `checkDeclaredType(float, float)` and answer `ok`, not read `Float`'s overloaded `named` tag as an
	// integer and report a false narrowing (E3009). `resolveFloatAliasType` is its twin for a produced
	// VALUE's type; both delegate the alias lookup to `namedIsFloatAlias`.
	function floatResolvedTag(tag ValueTypeTag, nameId TypeNameId) returns ValueTypeTag
		if tag != ValueTypeTag.named 'notNamed'
			return tag
		end 'notNamed'
		return ValueTypeTag.float if self.namedIsFloatAlias(nameId) else tag
	end 'floatResolvedTag'

	// Resolve a float-alias `named` TYPE to `MaxonType.float` — the produced-VALUE twin of
	// `floatResolvedTag`. A `returns Float` CALL RESULT is a genuine float value, so its tag must be
	// `float` (matching the XMM class the value-class column gives a float return from the callee's f64
	// Std return type), or `trunc(x)` reads the `named` tag as already-integral and returns `x` unchanged
	// and `return x` moves an XMM value through a GPR. An int alias keeps its `named` type (its name
	// carries signedness); a struct/scalar/String passes through.
	function resolveFloatAliasType(t MaxonType) returns MaxonType
		if maxonTypeTag(t) != ValueTypeTag.named 'notNamed'
			return t
		end 'notNamed'
		return MaxonType.float if self.namedIsFloatAlias(typeNameIdOf(t)) else t
	end 'resolveFloatAliasType'

	// ⭐ **THE BUILTIN CONFORMER A `(tag, nameId)` TYPE DISPATCHES ITS `.hash()`/`.equals()`/`.compare()`
	// UNDER (P1.7a direct dispatch)** — THE one classifier behind both spellings of a direct dispatch (a
	// binding receiver in `parseMethodCall`, a call-result receiver in `parsePostfix`), so the two cannot
	// come to disagree about which values carry a builtin conformance.
	//
	// A ranged INT alias reduces to `integer` FIRST, which is what makes `Integer`, `Byte`, `HashValue` and
	// a bare `int` one conformer rather than four: `Byte.compare` does not exist and never will — the
	// witness path already collapses a ranged type ARGUMENT the same way
	// (`ProgramSignatures.conformerTypeArgName` → `canonicalizeRangedAlias`), so both dispatch paths key the
	// same `int.compare` symbol off the same type. A ranged FLOAT alias reduces to `float` by the very same
	// step, so `Percent.compare` is `float.compare`.
	//
	// Every tag with no synthesized impl answers `notAConformer` (`builtinConformerOfTag`), which is what
	// keeps a `String`-valued receiver out of here and a struct receiver on the struct path.
	//
	// ⚠ It answers with the CONFORMER and not its name, and that is a measured decision rather than a
	// stylistic one — see `BuiltinConformer`'s header for the 16-byte box this used to allocate at every
	// method-call site in every program, feature or no feature.
	function builtinConformerOfType(tag ValueTypeTag, nameId TypeNameId) returns BuiltinConformer
		return builtinConformerOfTag(tag if tag != ValueTypeTag.named else self.rangedAliasTag(nameId))
	end 'builtinConformerOfType'

	// The classifier above, asked of an SSA VALUE's own type — the form the postfix loop and the
	// `Self`-argument check need (a call result and a method argument are values, not bindings).
	function builtinConformerOfValue(value ValueId) returns BuiltinConformer
		return self.builtinConformerOfType(self.tagOf(value), nameId: self.valueNameId(value))
	end 'builtinConformerOfValue'

	// Is `value` a value of the conformer `conformer`? The concrete-receiver twin of
	// `isReceiverTypeParamValue`: what a `Self`-typed formal accepts. Compared as CONFORMERS rather than as
	// names, so a `Self` argument agrees with its receiver by the same classifier the dispatch was chosen by
	// and no name is materialized to answer a question about types.
	function valueIsConformer(value ValueId, conformer BuiltinConformer) returns bool
		return self.builtinConformerOfValue(value) == conformer
	end 'valueIsConformer'

	// The name is not a local and not a top-level binding WITH STORAGE. Say which of the two remaining things
	// it is: an INLINED top-level constant (E2013) or nothing at all (E2004).
	//
	// A stored-but-immutable binding — an array `let` (P1.7 slice 2b) — never reaches here: it resolves
	// through `globalDeclFor` like any other global, and `storeToGlobal` refuses it there, holding the
	// resolution that proves the name is declared. So the constant probe below is the whole remaining
	// question, exactly as it was before that binding existed.
	function rejectNonGlobalAssignment(nameTok Token) throws ParseError
		match self.signatures.constantValueOf(nameTok.value, readerFilePath: self.filePath) 'constant'
			// Either kind of constant is immutable — assigning to a managed `let` is the same mistake as
			// assigning to a scalar one, and gets the same diagnostic.
			found to foundManaged then throw assignToImmutableError(nameTok)
			notFound then throw ParseError.undefinedVariable(String.from(nameTok.value), line: nameTok.line, column: nameTok.column)
		end 'constant'
	end 'rejectNonGlobalAssignment'

	// `return [<expr>]`. Sets the block's terminator directly, emitting the distinct
	// `retVoid` variant for a void return rather than a `ret` carrying some absent-value
	// sentinel (see MaxonDialect's `retVoid`).
	//
	// WHICH variant is decided by `func`'s DECLARED return type — never by the token that
	// follows `return`. The two are not interchangeable, and the token alone is the wrong
	// question: it says what the source WROTE, not what the function PROMISED, and when
	// they differ it is the promise the whole backend was built around. Deriving the
	// answer from the token stream instead gave the compiler two sources of truth for
	// "is this function void", with nothing to make them agree — and they disagreed on
	// exactly two programs, each of which was a bug no later pass could catch:
	//
	//   • `return <expr>` in a VOID function reached the x64 tier as a value `ret`, where
	//     `emitPrimaryReturnMove` has no return register to move the value into — a
	//     compiler PANIC on a program the reference compiler accepts.
	//   • a BARE `return` in a value-returning function reached it as `retVoid`, which
	//     emits the `ret` without ever writing R8 — a SILENT MISCOMPILE handing the caller
	//     whatever the last op happened to leave in the return register.
	//
	// `func.maxonReturnType` is not a copy of the contract kept beside it: it IS the
	// field the rest of the pipeline reads — it flows to `funcReturnTypes`, through
	// lowering, and becomes the backend's `StdReturnType`. Reading it here means the
	// parser and the tier that must honour it cannot be looking at different answers.
	//
	// So the statement's shape is checked AGAINST the contract rather than used to infer
	// it, and a `return` that cannot honour it is rejected here — where a source position
	// still exists — instead of reaching a tier that can only panic or emit the wrong op.
	function parseReturnStatement(func IrFunction, block IrBlock) throws ParseError
		let retTok = try self.consume(TokenKind.return)
		let bare = self.at(TokenKind.newline) or self.at(TokenKind.end) or self.isEof()

		if maxonReturnTypeIsVoid(func.maxonReturnType) 'voidFunction'
			if not bare 'valueFromVoid'
				throw ParseError.returnValueFromVoid(String.from(func.name), line: retTok.line, column: retTok.column)
			end 'valueFromVoid'

			self.emitScopeDrops(WholeFunctionScopeFloor, anchor: retTok)
			self.artifact.emitTerminator(block, op: MaxonOp.retVoid, range: SourceRange.ofToken(retTok))
			return
		end 'voidFunction'

		// Value-returning: a bare `return` has nothing to return, and there is no value
		// the compiler may invent for it.
		if bare 'noValue'
			throw ParseError.returnWithoutValue(String.from(func.name), line: retTok.line, column: retTok.column)
		end 'noValue'

		// The terminator goes on the block the EXPRESSION ended in, not the one it started
		// in. `return a or b` evaluates the `or` across three blocks and leaves control in
		// the merge; terminating `block` instead would leave the merge unterminated (a
		// backend panic) and put the `ret` on a path the value it returns does not reach.
		let retVal = try self.parseExpression(func, block: block)

		// ⭐ **ESCAPE (P1.5-A2b): a capturing closure may not be RETURNED** — the env it carries is dropped at
		// this frame's scope exit, so handing it back would leave the caller a closure whose environment is
		// gone. This is the route people actually write (`makeAdder`), and the frame guard is structural: the
		// closure mark is a per-function column, so `retVal` can only be a capturing closure of THIS frame. It
		// rides the stable `boundValue`, so a `return f` from a nested block refuses just as one from the top
		// does — the value crossing the block boundary is the same SSA id, still marked.
		try self.rejectEscapingClosure(retVal, message: "cannot return a closure that captures: {CapturingClosureEscapeSuffix}", tok: retTok)

		// The value must satisfy what the function PROMISED — `checkDeclaredType`, the same
		// COERCION-SITE rule the call arguments and the assignments ask, and deliberately not the
		// symmetric `typesAgree` an operator's two operands ask. `return flag` from a function
		// declared `returns Integer` is the argument-position bug in reverse: the bool's 1 payload
		// would be handed back through the return register as the integer 1. And `return 3.7` from
		// one is the LOSSY half — the classes agree, so only a one-sided rule can see it.
		//
		// The declared type here is the RAW parse-time one (a `named` alias, not yet resolved by
		// `TypeResolution`, which runs after the parse). A ranged INT alias's `named` tag is what
		// `typeClassOf`/`tagIsIntegral` are built to read; a ranged FLOAT alias's is not — `named` is
		// `tagIsIntegral`, so `checkDeclaredType(3.14's float, Float)` would read the alias as an int and
		// report a false narrowing (E3009) on `return 3.14`. `floatResolvedTag` resolves a float alias to
		// `float` HERE, at the call site, leaving the shared `named`-is-int rules untouched: `named` still
		// means int everywhere those rules read it, and only a proven float alias is lifted out of it.
		// `typeTagName` then prints `float` for the float alias and `int` for the int one, both the
		// resolved primitive the bootstrap prints.
		let retTag = self.tagOf(retVal)
		let declaredNameId = maxonReturnTypeNameId(func.maxonReturnType)
		let declaredTag = self.floatResolvedTag(maxonReturnTypeTag(func.maxonReturnType), nameId: declaredNameId)

		// The tag check runs FIRST: a genuine CLASS mismatch (a bool, or a struct, where an int is
		// declared) keeps its tag-based message, and the aggregate-name check below only NEWLY catches
		// the case the tag check WRONGLY AGREES on — a boxed union returned where a scalar is declared,
		// where `checkDeclaredType(named, named)` agrees because `ValueTypeTag.named` is overloaded.
		match checkDeclaredType(retTag, declared: declaredTag) 'declared'
			ok then break 'declared'
			mismatch then throw ParseError.returnTypeMismatch(typeTagName(retTag), expected: typeTagName(declaredTag), line: retTok.line, column: retTok.column)
			narrowsFloatToInt then throw ParseError.implicitNarrowing(typeTagName(retTag), targetType: typeTagName(declaredTag), line: retTok.line, column: retTok.column)
			// A FUNCTION VALUE returned where a NON-function type is declared (P1.5-A1) — the spec's
			// specific E3005 ("Cannot return 'function' from function declared to return '{declared}': …").
			// A function returned from a function-typed return (`return double` from `returns UnaryOp`)
			// agrees and never reaches this.
			functionIntoNonFunction then throw ParseError.functionValueReturned(typeTagName(declaredTag), line: retTok.line, column: retTok.column)
		end 'declared'

		// ⭐ OPEN #54/#59: a `return` of the WRONG named aggregate — a DIFFERENT struct/union, OR an
		// aggregate where a SCALAR is declared — is handed back and dropped under the DECLARED return
		// type's destructor: a wild free / leak the tag check above cannot see (two structs share the
		// `structRef` tag; a boxed union and a ranged-int alias share `named`). Identity is the interned
		// name, EXACT (no subtyping). Un-gated — both names are computed unconditionally, `aggregateNameOf`
		// returning the shared empty for a scalar with no allocation — and `giveTypeName` prints the
		// scalar side's primitive (`int`), not an empty name.
		let declaredReturnName = self.aggregateNameOf(declaredTag, nameId: declaredNameId)
		let returnedName = self.aggregateNameOf(retTag, nameId: self.valueNameId(retVal))
		if self.signatures.aggregatesConflict(declaredReturnName, got: returnedName) 'aggregateReturnMismatch'
			throw ParseError.returnTypeMismatch(self.giveTypeName(retTag, aggregateName: returnedName), expected: self.giveTypeName(declaredTag, aggregateName: declaredReturnName), line: retTok.line, column: retTok.column)
		end 'aggregateReturnMismatch'

		// ⭐ **THE `ok` VERDICT ABOVE LICENSED A WIDENING, AND SOMETHING HAS TO PERFORM IT.** `return 3`
		// from a `returns float` function agreed (both numeric, nothing lost) and then handed the raw i64
		// straight to `emitOwnedValueReturn` — which put a GPR where the f64 return register is, and the
		// x64 emitter panicked on the cross-register-file move it was asked for. The same door every other
		// coercion site uses; `retVal` is already a float when the source wrote one, so this is a no-op for
		// every program that compiled before.
		let returned = self.coerceToDeclared(retVal, declared: declaredTag, anchor: retTok)

		// P1.9: a `return` in a ranged-int-alias-returning function is a narrowing site. `returned` is the
		// scalar the `ret` terminator will carry (a ranged int return is never an owned value, so
		// `emitOwnedValueReturn` passes it through unwrapped), so recording it here matches the id the
		// Std pass finds on the `ret` op. Anchored on the `return` keyword (the E3005 position). A ranged
		// INT alias never widens, so this is the value the coercion returned untouched.
		if not self.rangeCheckReturnAlias.isEmpty() 'rangedReturn'
			self.rangeCheckReturnSites.push(RangeCheckReturnSite.create(returned, line: retTok.line, column: retTok.column))
		end 'rangedReturn'

		try self.emitOwnedValueReturn(returned, anchor: retTok)
	end 'parseReturnStatement'

	// ⭐ **EMIT A VALUE `ret` THAT HANDS ITS VALUE TO THE CALLER AS AN OWNED ONE** — the shared tail of a
	// value `return` and a non-capturing closure body's `gives <expr>` (P1.5-A2a). A closure body IS a
	// value return (its expression is the lifted function's returned value), so both go through here rather
	// than each spelling the promotion/reject/drop dance. `anchor` is the token a diagnostic and the span
	// point at (`return`'s keyword, or the closure's `gives`).
	//
	// **A `returns String` FUNCTION HANDS BACK A UNIFORMLY OWNED HEAP String**, and the caller drops that
	// result unconditionally (`mintOwnedCallResult`). So the callee must return something OWNED and must not
	// drop it — two adjustments, in this order, BEFORE the scope drops:
	//
	//   • PROMOTE a borrowed return. `return "hi"` is an immortal rdata literal (capacity == -2), not owned
	//     heap; handed back as-is, the caller would `__mm_decref` read-only data. Copying its bytes into a
	//     fresh owned record — the same single-`__mm_alloc` fused-record path an interpolation builds, with
	//     the source as its one part — gives the caller a box it may safely drop. `return "{x}"` and
	//     `return t` are already owned, so they pass through here. This half is return-specific and stays
	//     here; the MOVE below is the shared hand-off cleanup.
	//   • MOVE the owned return OUT of both drop sets — the shared `emitHandoffExitDrops` (the throw twin
	//     performs the SAME move). It belongs to the caller now: out of `ownedBindings` so `emitScopeDrops`
	//     does not double-free `return t`, and out of `pendingTempDrops` so the interp/promoted temporary is
	//     not dropped on the dead path the `ret` leaves behind. The `ownedBindings` removal is SCOPED to
	//     this return's drops and UNDONE after them (the helper's `savedOwnedBindings`), because
	//     `ownedBindings` OUTLIVES the `return` and the returned binding may sit in an enclosing block with
	//     other LIVE exit edges whose drops are emitted LATER in the parse and still own it.
	//
	// **A RETURNED STRUCT / BOXED UNION MUST BE OWNED — a BORROWED one is refused, not miscompiled.** An
	// OWNED box carries the provenance bit and is moved out, so exactly one owner drops it. A BORROWED
	// aggregate (a struct/union parameter, or a re-borrow of one) has an owner ELSEWHERE, so handing the box
	// back as owned makes two owners free one box: a double free. Consuming or copying a borrowed aggregate
	// to return it is the cross-call CONSUME half deferred to P1.4b; until then it is a clean reject. A
	// String is PROMOTED above; a scalar or payload-free enum carries no box and is always fine.
	//
	// **THE DROPS GO AFTER THE VALUE, BEFORE THE TERMINATOR.** AFTER the value, because `return p.x + p.y`
	// READS the box; dropping first would free the memory the loads are about to read. BEFORE the
	// terminator, because a `ret` ENDS the block. `returned` is already in a register by then.
	function emitOwnedValueReturn(retVal ValueId, anchor Token) throws ParseError
		let retTag = self.tagOf(retVal)
		var returned = retVal
		if tagIsText(retTag) and not self.valueIsOwnedHeap(returned) 'promoteBorrowed'
			returned = self.promoteToOwnedString(returned, range: SourceRange.ofToken(anchor))
		end 'promoteBorrowed'

		let returnedTag = self.tagOf(returned)
		if self.valueIsNonTextAggregate(returned) and not self.valueIsOwnedHeap(returned) 'borrowedAggregateReturn'
			throw ParseError.unsupported("returning a borrowed `{typeTagName(returnedTag)}` value — a struct/union parameter (or a re-borrow of one) is a heap box the caller would adopt and free while the borrow's own owner frees it too, a double free. Return an OWNED value; consuming or copying a borrowed aggregate to return it arrives at P1.4b", line: anchor.line, column: anchor.column)
		end 'borrowedAggregateReturn'

		// ⭐ **REJECT RETURNING AN OWNED OPAQUE type-parameter value (P1.7 slice 3b-vi-a).** `pop`/`remove` on an
		// opaque `Array with <type parameter>` field now hand back an OWNED `typeParameter` element, dropped in
		// the method body through the descriptor-gated `__drop_type_param`. Handing it back through the return
		// register would make the CALLER its owner — but a generic method's opaque `typeParameter` return type is
		// NOT resolved to the instantiation's concrete type at the call site, so the caller neither adopts nor
		// drops it and the moved-out element LEAKS (exit 101, confirmed by probe). Returning an opaque `T` is a
		// distinct future slice, symmetric to the opaque try-merge deferral (`finishValueTry`); until it lands,
		// DROP the moved-out element in the method body or move it back into the array with `push` — both
		// supported. A BORROWED opaque return (`return item` for a borrowed `Element` parameter) owns nothing, so
		// `valueIsOpaqueOwned` is false and it is unaffected.
		if self.valueIsOpaqueOwned(returned) 'ownedOpaqueReturn'
			throw ParseError.unsupported("returning an OWNED opaque type-parameter value — an element moved out of an `Array with <type parameter>` field by `pop`/`remove` inside a generic body. The caller cannot resolve the opaque `T` return to the instantiation's concrete type, so it would neither adopt nor drop the moved-out element and the value would leak. Returning an opaque `T` is a distinct future slice; drop the moved-out element in the method body, or move it back into the array with `push` (P1.7 slice 3b-vi-a).", line: anchor.line, column: anchor.column)
		end 'ownedOpaqueReturn'

		self.emitHandoffExitDrops(returned, anchor: anchor)

		self.artifact.emitTerminator(self.currentBlock, op: MaxonOp.ret(returned), range: SourceRange.ofToken(anchor))
	end 'emitOwnedValueReturn'

	// ============================================================================
	// P1.4b — scalar error handling: throw / try / otherwise / panic
	// ============================================================================

	// `throw E.case` or `throw <e>` — leave the function via the ERROR edge. The thrown expression
	// evaluates to a `named(E)` enum value carrying the case's tag (a literal for `throw E.case`, the
	// caught `(e)` binding for `throw e`); `throwError` carries it and lowering re-encodes it `+1`. Owned
	// locals are dropped before the error terminator (trivial for scalar Wave 1).
	function parseThrowStatement(func IrFunction, block IrBlock) throws ParseError
		self.currentBlock = block
		let throwTok = try self.consume(TokenKind.throw)
		try self.emitThrowError(func, anchor: throwTok)
	end 'parseThrowStatement'

	// Parse the thrown enum expression and emit the `throwError` terminator into `currentBlock`. Shared by
	// the `throw <e>` statement and the match `default throws <E.case>` arm (which differ only in the
	// keyword their caller consumed — `throw` vs `throws`).
	function emitThrowError(func IrFunction, anchor Token) throws ParseError
		let errValue = try self.parseExpression(func, block: self.currentBlock)
		let errorIsBoxed = self.throwsTypeIsBoxedUnion(self.typeOf(errValue))

		// ⭐ **A THROWN BOX MUST BE OWNED BY THIS FRAME — a box owned elsewhere is MOVED OUT of an OWNED-LOCAL
		// container, RETAINED out of a BORROWED one, or refused.** A boxed error is handed to the caller through
		// the flag register, which ADOPTS and drops it once. An OWNED box (a fresh `throw U.case(x)` or a caught
		// `(e)` binding) carries the provenance bit and is moved out below. A box that is NOT owned here splits
		// three ways:
		//   • a boxed-union FIELD read whose CONTAINER is an OWNED LOCAL of THIS function — the throw TRANSFERS
		//     it out by MOVE: `moveOutThrownField` nulls the field slot (so the container's `__destruct_<T>`
		//     cascade skips it) and marks the value owned, so the same owned hand-off below transfers it. Sound
		//     because the owned-local container dies with this frame — no surviving caller can read the nulled
		//     slot, and the null is cheaper than an incref that the container's own drop would only cancel (#64).
		//   • a boxed-union FIELD of a BORROWED container (a `self`-field in an instance method, or a borrowed
		//     struct/union PARAM's field, whose owner is the CALLER's local) — the throw TRANSFERS it out by
		//     RETAIN (#64): `retainThrownField` increfs the box so the thrown reference is a SECOND owner, and
		//     the slot is LEFT INTACT so a caller that catches and re-reads the field still sees a live box. The
		//     caller's container keeps its own reference; the catch consumes the thrown one; the refcount
		//     balances at one free. This applies the #40 retain-promotion thesis to the throw error channel,
		//     sidestepping the cross-call move-tracking a null-move would have needed to tell a re-reading caller
		//     from a tearing-down one.
		//   • anything else NOT owned here — a `throw <union param>` (or a re-borrow of one), a WHOLE borrowed
		//     union value with no owned home in this frame. Two owners would free one box (a double free); throw
		//     an OWNED value instead. Refused until cross-call consume.
		if errorIsBoxed and not self.valueIsOwnedHeap(errValue) 'borrowedThrow'
			let thrownIsFieldRead = self.lastFieldReadValid and self.lastFieldReadValue == errValue
			if thrownIsFieldRead and self.valueIsOwnedHeap(self.lastFieldReadBox) 'fieldThrow'
				self.moveOutThrownField(errValue, anchor: anchor)
			end 'fieldThrow' else 'borrowedFieldOrValue'
				if thrownIsFieldRead 'borrowedField'
					self.retainThrownField(errValue, anchor: anchor)
				end 'borrowedField' else 'borrowedNonField'
					throw ParseError.unsupported("throwing a borrowed union value — a union parameter (or a re-borrow of one) is a heap box the caller would adopt and free while the borrow's own owner frees it too, a double free. Throw an OWNED value (a fresh `throw U.case(x)`, a caught `(e)` binding, or a boxed-union FIELD the throw moves out or retains); consuming a whole borrowed union to throw it arrives with cross-call consume", line: anchor.line, column: anchor.column)
				end 'borrowedNonField'
			end 'borrowedFieldOrValue'
		end 'borrowedThrow'

		// ⭐ **THROW TRANSFERS THE BOX OUT OF THE LOCAL DROP SETS — BEFORE the scope drops.** The box is
		// handed to the caller, so the scope cleanup releases every OTHER owned local on the throw edge but
		// not the box in flight — else it is freed here AND adopted by the caller (a double free, OPEN #16
		// family). This is the SAME hand-off cleanup a `return <value>` performs (`emitHandoffExitDrops`):
		// the thrown box leaves the local drop sets, the throw expression's leftover temporaries and every
		// other owned binding drop, and the owned list is restored for a sibling exit edge that still owns
		// it. A SCALAR error owns no heap, so its move-out is inert — the Wave-1 behaviour, unchanged.
		self.emitHandoffExitDrops(errValue, anchor: anchor)

		self.artifact.emitTerminator(self.currentBlock, op: MaxonOp.throwError(errValue, errorIsBoxed: errorIsBoxed), range: SourceRange.ofToken(anchor))
	end 'emitThrowError'

	// ⭐ **MOVE A THROWN BOXED-UNION FIELD OUT OF ITS OWNED-LOCAL CONTAINER.** The field READ borrowed the
	// box (its container owns it); throwing it transfers ownership to the caller. The transfer is a MOVE:
	// NULL the slot the value was loaded from (recorded by `emitFieldLoad` in the
	// `lastFieldRead*` fields), so the container's `__destruct_<T>` cascade's null-guard SKIPS it — else the
	// container would free the box the caller has just adopted (a double free). Marking the value OWNED then
	// routes it through the SAME hand-off + `throwError` transfer a fresh `throw U.case(x)` takes. This is the
	// throw twin of match's `moveOutManagedPayload`, one field-load out. **The caller GATES this on an OWNED
	// LOCAL container** (`valueIsOwnedHeap(lastFieldReadBox)`): such a container dies with this frame, so its
	// own scope-exit drop honours the null and no surviving caller can read the nulled slot — and the null is
	// cheaper than an incref its own drop would only cancel. A BORROWED container (a `self`-field, a borrowed
	// param's field) instead RETAINS (`retainThrownField`, #64): its owner is the CALLER's local, which may
	// re-read the field after catching, so the slot is left intact and the box increfed rather than nulled.
	//
	// The null store is an i64 pointer write — a boxed-union field slot holds a machine-word box address
	// (`fieldStorageType` gives a boxed-union field `integer`), the same width `moveOutManagedPayload` nulls
	// a match-scrutinee slot at.
	function moveOutThrownField(value ValueId, anchor Token)
		let range = SourceRange.ofToken(anchor)
		let zero = self.emitLiteral(0 as ParsedInt, valueType: MaxonType.integer, range: range)
		self.emitIndirectStore(self.lastFieldReadBox, offset: self.lastFieldReadOffset, value: zero, storageType: MaxonType.integer, range: range)
		self.markValueOwnsHeap(value)
	end 'moveOutThrownField'

	// ⭐ **RETAIN A THROWN BOXED-UNION FIELD OF A BORROWED CONTAINER (#64).** The field READ borrowed the box
	// (the container — a borrowed `self`, or a borrowed struct/union PARAM — owns it, and that owner is the
	// CALLER's local). Throwing it transfers an owned reference to the caller, but unlike `moveOutThrownField`
	// the slot must NOT be nulled: the caller still owns the container and may re-read the field after
	// catching. So instead of a MOVE this RETAINS — `__mm_incref` raises the box's refcount so the thrown
	// reference is a SECOND owner while the field keeps pointing at a live box. The caller's container keeps
	// its own reference (dropped when the container dies), the thrown box is consumed by the catch (`otherwise
	// (e)` skips its incref, no-binding `otherwise` decrefs once), and the refcount balances at exactly one
	// free. Marking the value OWNED then routes it through the SAME hand-off + `throwError` transfer the
	// move-out and a fresh `throw U.case(x)` take, so the box the retain produces is indistinguishable
	// downstream from any other owned thrown box. The RETAIN twin of `moveOutThrownField`, applying the #40
	// retain-promotion thesis (`retainBorrowedAggregate`) to the throw error channel — a bounded refcount
	// exception that sidesteps the cross-call move-tracking a null-move would have needed to tell a re-reading
	// caller from a tearing-down one.
	function retainThrownField(value ValueId, anchor Token)
		self.emitIncref(value, range: SourceRange.ofToken(anchor))
		self.markValueOwnsHeap(value)
	end 'retainThrownField'

	// `panic("message")` — abort the process after printing the message. Emits a `panicAbort` body op
	// (expanded to `osWriteStdout` + `osExit` in lowering) followed by a dead return terminator (control
	// never returns, so the return is unreachable but keeps the block well-formed).
	function parsePanicStatement(func IrFunction, block IrBlock) throws ParseError
		self.currentBlock = block
		let panicTok = try self.consume(TokenKind.panic)
		try self.consume(TokenKind.leftParen)
		let msg = try self.parseExpression(func, block: self.currentBlock)
		try self.consume(TokenKind.rightParen)
		if not tagIsText(self.tagOf(msg)) 'notAString'
			throw ParseError.builtinOperandType("panic", required: typeTagName(ValueTypeTag.string), got: typeTagName(self.tagOf(msg)), line: panicTok.line, column: panicTok.column)
		end 'notAString'
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.panicAbort(msg), range: SourceRange.ofToken(panicTok))
		self.emitDeadReturn(func, anchor: panicTok)
	end 'parsePanicStatement'

	// The dead return terminator emitted after a diverging op (`panicAbort`): a `retVoid` for a void
	// function, else a `ret 0`. Unreachable — the preceding op never returns — but every block must
	// commit to a terminator. Its type need not match the declared return (it is dead code and bypasses
	// the `return`-statement checks); lowering moves it to the return register like any other `ret`.
	function emitDeadReturn(func IrFunction, anchor Token)
		if maxonReturnTypeIsVoid(func.maxonReturnType) 'void'
			self.artifact.emitTerminator(self.currentBlock, op: MaxonOp.retVoid, range: SourceRange.ofToken(anchor))
			return
		end 'void'
		let zero = self.emitLiteral(0, valueType: MaxonType.integer, range: SourceRange.ofToken(anchor))
		self.artifact.emitTerminator(self.currentBlock, op: MaxonOp.ret(zero), range: SourceRange.ofToken(anchor))
	end 'emitDeadReturn'

	// ⭐ **THE try/otherwise DESUGAR.** Parses `try <call> [otherwise <handler>]`, emitting a `tryCall`
	// (the call rewritten to define a second `errorFlag` value), a `compare(flag != 0)` + `condBranch`
	// two-way split, the error handler, and the merge. Returns the try's RESULT value (used in expression
	// position; discarded as a statement). `resultUsed` is true in value position — it decides the
	// void-callee (E3059) and `otherwise ignore` (E3059) rejects.
	function parseTry(func IrFunction, resultUsed bool) returns ValueId throws ParseError
		let tryTok = try self.consume(TokenKind.try)

		// A block-form `try 'label' … end` (grouping multiple calls) is a later slice; only a match arm
		// needs it rejected here (E2049 at the block label).
		if self.at(TokenKind.charLiteral) 'blockForm'
			if self.inMatchArmBody 'inArm'
				throw ParseError.tryBlockFormInMatchArm(false, line: tryTok.line, column: tryTok.column)
			end 'inArm'
			throw ParseError.unsupported("block-form `try 'label' … end` (grouping multiple calls in one try) — a later slice; use a single-statement `try call()` optionally with `otherwise`", line: tryTok.line, column: tryTok.column)
		end 'blockForm'

		let result = try self.parseTryCallTarget(func)
		let flag = self.mintValue(ValueTypeTag.integer, nameId: UnnamedTypeId)
		let target = try self.rewriteLastCallToTryCall(func, flag: flag, tryTok: tryTok)

		try self.requireThrowingTryTarget(target, tryTok: tryTok)

		// A value-position `try` on a VOID callee has no value to yield (E3059).
		if resultUsed and self.tagOf(result) == ValueTypeTag.void 'voidInValue'
			throw ParseError.errorTypeMismatch("'{String.from(tryTargetName(target))}' does not return a value", line: tryTok.line, column: tryTok.column)
		end 'voidInValue'

		return try self.desugarTry(func, tryTok: tryTok, result: result, flag: flag, target: target, resultUsed: resultUsed)
	end 'parseTry'

	// Parse the throwing call target after `try` — a primary call form followed by its WHOLE POSTFIX CHAIN
	// (`try make().slice(1, endIndex: 3)`, `try [10,20,30].get(0)`, `try pick()(21)`). Emits an ordinary
	// `call` op that `rewriteLastCallToTryCall` then converts.
	//
	// ⭐ **THE `try` BINDS TO THE OUTERMOST CALL, WHICH IS WHY THE CHAIN MUST BE PARSED TO ITS END.**
	// `rewriteLastCallToTryCall` converts the LAST op the target emitted, so stopping at the primary hands it
	// the WRONG call: `try make().slice(…)` left `.slice(…)` unconsumed and rewrote `make`'s call, then
	// rejected the whole thing as "'make' does not throw" (OPEN #107) — a program the reference compiler
	// accepts and runs. The reference reaches the same rule from the other end: its `try` parses a whole
	// primary (postfix included) and rewrites the tail op. `try f(g())` is unaffected and must stay so — `g`
	// is an ARGUMENT, emitted BEFORE `f`'s call, so the tail op is still `f`.
	//
	// `resultUsed: false` at every arm, and that is the one thing the try target decides differently from an
	// ordinary expression: whether the try's VALUE is usable is settled ONCE, by `parseTry`, from the try's
	// own position (the void-callee E3059). A second copy of that question inside the target answers it from
	// the wrong place — reporting "this call's value cannot be used" for a `try f().push(1)` STATEMENT, whose
	// value is not used at all — where the real fault is that `push` cannot throw (E3055).
	function parseTryCallTarget(func IrFunction) returns ValueId throws ParseError
		// P1.5-B2b: `try await p` — the awaited THROWING promise is the try target (the AWAIT is the throwing
		// operation). Emit the `await` op via the SHARED `emitAwaitOp`, WITHOUT the plain-await E3057 reject:
		// catching the thrown error is exactly what `try await` does. `rewriteLastCallToTryCall` then converts
		// the `await` into a `tryAwait`, and `parseTry`'s E3055 check refuses a NON-throwing promise here.
		//
		// TERMINAL — no postfix chain is applied to the awaited value, and deliberately so: `emitAwaitOp` was
		// entered WITHOUT the E3057 reject on the promise, so a trailing `.method(…)` would make the METHOD the
		// try target and leave the throwing await unguarded, silently dropping its error flag. `parseUnary`
		// already consumed any postfix on the PROMISE operand itself, so nothing legal is lost here.
		if self.at(TokenKind.await) 'awaitTarget'
			let awaitTok = try self.consume(TokenKind.await)
			let promise = try self.parseUnary(func)
			return try self.emitAwaitOp(func, promise: promise, awaitTok: awaitTok)
		end 'awaitTarget'

		return try self.parsePostfix(func, value: try self.parseTryCallReceiver(func), resultUsed: false)
	end 'parseTryCallTarget'

	// The PRIMARY a `try` target's postfix chain starts from — a free call `f(…)`, a method/qualified call
	// `obj.m(…)` / `Type.m(…)`, a `self.m(…)`, a field-chain call, or an array / byte-string LITERAL receiver.
	// Split from `parseTryCallTarget` so the postfix continuation is applied to EVERY form in one place rather
	// than per arm (it was applied to the two literal arms only, which is how the free-call arm came to stop
	// at the first callee — OPEN #107).
	function parseTryCallReceiver(func IrFunction) returns ValueId throws ParseError
		// `try bag.items.get(0) otherwise …` / `try self.nodes.get(i) otherwise …` — a throwing method on an
		// ARRAY reached through a 2+-hop field chain (P1.7 slice 3). Checked FIRST: a single-hop `self.m(…)` /
		// `obj.m(…)` is not a field chain (`fieldChainMethodCallAt` needs 2+ hops) and falls to the arms below;
		// a 2+-hop chain resolves to the array field and applies the method, leaving the `call __arr_get` as the
		// last op for `rewriteLastCallToTryCall`.
		if self.fieldChainMethodCallAt(self.pos) 'fieldChainTarget'
			return try self.parseFieldChainCall(func, resultUsed: false)
		end 'fieldChainTarget'
		if self.at(TokenKind.self) 'selfCall'
			return try self.parseSelfPrimary(func)
		end 'selfCall'
		if self.at(TokenKind.identifier) 'named'
			if self.peekKind() == TokenKind.leftParen 'freeCall'
				return try self.parseCall(func, resultUsed: false)
			end 'freeCall'
			if self.peekKind() == TokenKind.dot 'dotted'
				return try self.parseDottedPrimary(func, resultUsed: false)
			end 'dotted'
		end 'named'
		// `try [10,20,30].get(0) otherwise …` — a throwing method on an array LITERAL (P1.7 slice 1), and its
		// exact byte-string analogue `try b"…".get(0)` (P1.7 slice 2). Each parses to an owned array temp that
		// the postfix chain applies its method to; the temp is a FORK temporary, dropped once per edge by
		// `desugarTry`. Both literal kinds are enrolled together — accepting one and not the other would
		// reject a legal `try b"…".get(…)` as "not a call".
		if self.at(TokenKind.leftBracket) 'arrayLiteralTarget'
			return try self.parseArrayLiteral(func)
		end 'arrayLiteralTarget'
		if self.at(TokenKind.byteStringLiteral) 'byteStringLiteralTarget'
			return try self.parseByteStringLiteral()
		end 'byteStringLiteralTarget'
		let tok = self.current()
		throw ParseError.unsupported("`try` must be applied to a call — `try f(…)`, `try obj.method(…)`, or `try await p` (got '{tok.kind.rawValue}')", line: tok.line, column: tok.column)
	end 'parseTryCallReceiver'

	// Rewrite the just-emitted `call` op in `currentBlock` into a `tryCall` defining `errorFlag` as its
	// second result. Returns the `TryTarget` the desugar asks its two questions of. v1 rewrites the terminal
	// call in place for the same reason: it makes nested tries (`try consume(try get() otherwise 0)`)
	// work — each inner try rewrites its OWN call, and the outer rewrites the last op after the whole
	// parse, which is its own call.
	function rewriteLastCallToTryCall(func IrFunction, flag ValueId, tryTok Token) returns TryTarget throws ParseError
		let refCount = self.currentBlock.opRefs.count()
		if refCount == 0 'noOp'
			throw ParseError.unsupported("`try` must be applied to a call — the expression after `try` emitted no call", line: tryTok.line, column: tryTok.column)
		end 'noOp'
		let opIdx = try self.currentBlock.opRefs.get(refCount - 1) otherwise panic("rewriteLastCallToTryCall: opRefs.get OOB on a non-empty block")
		let op = try self.artifact.module.ops.get(opIdx) otherwise panic("rewriteLastCallToTryCall: last opRef {opIdx} not in module.ops")
		return match op 'rewrite'
			call(result, callee, args, argLabels, argRanges, argImmutableNames) gives TryTarget.named(self.commitTryCallRewrite(opIdx, result: result, errorFlag: flag, callee: callee, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: argImmutableNames))
			// P1.5-B2b: `try await p` — rewrite the `await` op into a `tryAwait` defining the error flag,
			// exactly as `call` → `tryCall`. The awaited callee (recovered from the promise) is returned for
			// the desugar's E3055/E3059 checks and its `otherwise` error-type binding.
			await (result, promise) gives TryTarget.named(self.commitTryAwaitRewrite(func, opIdx: opIdx, result: result, flag: flag, promise: promise))
			// Only a DIRECT `call` or an `await` can be `try`ed. An `indirectCall`/`functionRef` (P1.5-A1) is
			// never throwing — a throwing function cannot be a function value (E3101) — an `asyncCall` (a spawn)
			// is not the throwing operation (the AWAIT is), and a `tryAwait` cannot be a fresh try target. All
			// reject `try` exactly as the other non-call ops do.
			literal to asyncCall gives try self.rejectTryTarget(tryTok)
			tryAwait gives try self.rejectTryTarget(tryTok)
			sizeofType gives try self.rejectTryTarget(tryTok)
			byteStringLiteral gives try self.rejectTryTarget(tryTok)
			switch gives try self.rejectTryTarget(tryTok)
			// A throwing WITNESS dispatch (`try self.item.digest()`, P1.7a slice 2b-v) — rewritten into the
			// dual-register `witnessTryDispatch` defining the error flag, exactly as `call` becomes `tryCall`.
			// Routed through a helper that RE-MATCHES the op in a SMALL match so `args` is bound in a
			// single-call arm, never in this big one (the tail-slot-Array decref corruption `witnessDispatch`
			// documents).
			witnessDispatch gives self.commitWitnessTryDispatchRewrite(opIdx, flag: flag)
			// A `witnessTryDispatch` in the last slot means an inner `try` already claimed this dispatch; it is
			// no more a fresh try target than a `tryAwait` is.
			witnessTryDispatch gives try self.rejectTryTarget(tryTok)
		end 'rewrite'
	end 'rewriteLastCallToTryCall'

	// Replace the `witnessDispatch` op at `opIdx` with a `witnessTryDispatch` defining the second `errorFlag`
	// result, and return the target the desugar reads — the interface method's NAME and its declared `throws`.
	// The op carries NEITHER (both are parse-time facts of the constraint resolution, and an op field for
	// them would be paid for by every dispatch to answer a question only a `try` asks), so the dispatch
	// RECORDS them as it emits and this reads them back. The recording is exact: a dispatch records at the
	// instant it emits its op, and this runs on the op in the LAST opRef slot — which is that same op,
	// because nothing else can have emitted since. A non-throwing method rewritten here is E3055, reported
	// by `requireThrowingTryTarget` off the `none` clause this hands it: the same route a non-throwing
	// direct callee takes.
	function commitWitnessTryDispatchRewrite(opIdx OpIndex, flag ValueId) returns TryTarget
		// CHECKED BEFORE THE REWRITE, not after: a stale record would mean the target's name and throws clause
		// belong to some OTHER dispatch, and rewriting first would leave a half-converted op behind the panic.
		if self.lastWitnessDispatchIndex != opIdx 'staleRecord'
			panic("commitWitnessTryDispatchRewrite: the `witnessDispatch` at {opIdx} is not the one `emitWitnessDispatch` recorded ({self.lastWitnessDispatchIndex}) — every witness dispatch must be emitted through that one door so its method name and throws clause reach the `try` desugar")
		end 'staleRecord'

		match try self.artifact.module.ops.get(opIdx) otherwise panic("commitWitnessTryDispatchRewrite: opIdx {opIdx} not in module.ops") 'w'
			witnessDispatch(result, args, constraintIndex, methodIndex, isVoid, _) then try self.artifact.module.ops.set(opIdx, value: MaxonOp.witnessTryDispatch(result, errorFlag: flag, args: args, constraintIndex: constraintIndex, methodIndex: methodIndex, isVoid: isVoid)) otherwise panic("commitWitnessTryDispatchRewrite: module.ops.set OOB at {opIdx}")
			default panic("commitWitnessTryDispatchRewrite: the op at {opIdx} is not a `witnessDispatch` — `rewriteLastCallToTryCall`'s match routes only that arm here")
		end 'w'
		return TryTarget.witness(self.lastWitnessDispatchName, throwsClause: self.lastWitnessDispatchThrows)
	end 'commitWitnessTryDispatchRewrite'

	// Replace the `call` op at `opIdx` with a `tryCall` defining the second `errorFlag` result, preserving
	// every call field, and return the callee name.
	function commitTryCallRewrite(opIdx OpIndex, result ValueId, errorFlag ValueId, callee ByteArray, args ValueIdArray, argLabels ByteArrayArray, argRanges SourceRangeArray, argImmutableNames ByteArrayArray) returns ByteArray
		try self.artifact.module.ops.set(opIdx, value: MaxonOp.tryCall(result, errorFlag: errorFlag, callee: callee, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: argImmutableNames)) otherwise panic("commitTryCallRewrite: module.ops.set OOB at {opIdx}")
		return callee
	end 'commitTryCallRewrite'

	// Replace the `await` op at `opIdx` with a `tryAwait` defining the `flag` second result (P1.5-B2b), and
	// return the AWAITED callee name for the desugar's diagnostics + `otherwise` error-type binding. The
	// callee is recovered from the promise's defining `asyncCall`; `emitAwaitOp` only accepts a promise-marked
	// value, which is minted by an `asyncCall`, so the lookup cannot miss (a miss is a parser invariant break).
	function commitTryAwaitRewrite(func IrFunction, opIdx OpIndex, result ValueId, flag ValueId, promise ValueId) returns ByteArray
		try self.artifact.module.ops.set(opIdx, value: MaxonOp.tryAwait(result, errorFlag: flag, promise: promise)) otherwise panic("commitTryAwaitRewrite: module.ops.set OOB at {opIdx}")
		match self.asyncCallCalleeOf(func, promise: promise) 'callee'
			found(callee) then return callee
			none then panic("commitTryAwaitRewrite: `try await` target v{promise} has no defining asyncCall — emitAwaitOp only accepts a promise-marked value, which is minted by an asyncCall")
		end 'callee'
	end 'commitTryAwaitRewrite'

	// The AWAITED callee name a promise handle carries — recovered from the `asyncCall` op that minted it, by
	// scanning this function's emitted blocks. A promise ValueId is minted by exactly ONE `asyncCall` in its
	// OWN function (the promise mark is per-function, so the search never crosses a frame), so the first match
	// is THE one. `none` means the value is not an async spawn's result — the caller reports its own
	// "not a promise" / invariant diagnostic. Read at the `try await`/plain-`await` sites (rare), so an
	// O(function ops) scan costs nothing on the await-free program and keeps the promise → callee fact off
	// every value (no per-value column that the scale corpus, which has no async, would pay for).
	//
	// ⭐ **A RE-ARMED `var`'s PROMISE IS A MERGE PHI (P1.5-B2 #88, Finding 1)** — no `asyncCall` defines it
	// directly, so the direct scan misses and the resolution TRACES the phi's incoming edge values to a
	// defining `asyncCall`. A promise var's phi merges promises on every reaching edge (all from `async
	// <callee>` of the same consistently-typed binding), so the first one reached answers for the awaited
	// result type and the throws check. A `Set` of visited values breaks loop back-edge cycles.
	function asyncCallCalleeOf(func IrFunction, promise ValueId) returns AsyncCalleeLookup
		var visited = AsyncCalleeVisited.create()
		return self.resolveAsyncCallee(func, promise: promise, visited: visited)
	end 'asyncCallCalleeOf'

	function resolveAsyncCallee(func IrFunction, promise ValueId, visited AsyncCalleeVisited) returns AsyncCalleeLookup
		if visited.contains(promise) 'seen'
			return AsyncCalleeLookup.none
		end 'seen'
		visited.insert(promise)
		for blockRef in func.blockRefs 'eachBlock'
			let block = try self.artifact.module.blocks.get(blockRef) otherwise panic("resolveAsyncCallee: blockRef from func.blockRefs not in module.blocks")
			for opIdx in block.opRefs 'eachOp'
				match asyncCalleeIfMatch(try self.artifact.module.ops.get(opIdx) otherwise panic("resolveAsyncCallee: opIdx {opIdx} not in module.ops"), promise: promise) 'm'
					found(callee) then return AsyncCalleeLookup.found(callee)
					none then break 'm'
				end 'm'
			end 'eachOp'
		end 'eachBlock'
		// Not defined by an `asyncCall` directly — trace a merge phi's incoming values.
		for incoming in self.phiIncomingValues(func, phi: promise) 'eachIncoming'
			match self.resolveAsyncCallee(func, promise: incoming, visited: visited) 'r'
				found(callee) then return AsyncCalleeLookup.found(callee)
				none then break 'r'
			end 'r'
		end 'eachIncoming'
		return AsyncCalleeLookup.none
	end 'resolveAsyncCallee'

	// The values that flow INTO `phi` on each predecessor edge, if `phi` is a merge block-arg — else empty. A
	// ValueId is a block-arg of exactly ONE block (SSA), so the first block carrying it is THE one; the phi's
	// slot in that block's `blockArgs` indexes each incoming edge's `argIds` (recorded in lockstep — an edge
	// exists in `branchEdges` iff its target carries block-args, so every edge into this block has one).
	function phiIncomingValues(func IrFunction, phi ValueId) returns ValueIdArray
		var incoming = ValueIdArray.create()
		for blockRef in func.blockRefs 'eachBlock'
			let block = try self.artifact.module.blocks.get(blockRef) otherwise panic("phiIncomingValues: blockRef from func.blockRefs not in module.blocks")
			for slot in 0 upto block.blockArgs.count() 'eachArg'
				let arg = try block.blockArgs.get(slot) otherwise panic("phiIncomingValues: blockArgs.get OOB at {slot}")
				if arg.valueId == phi 'isPhi'
					for predRef in func.blockRefs 'eachPred'
						let pred = try self.artifact.module.blocks.get(predRef) otherwise panic("phiIncomingValues: predRef not in module.blocks")
						for edge in pred.branchEdges 'eachEdge'
							if edge.targetBlockId == block.id 'intoBlock'
								incoming.push(try edge.argIds.get(slot) otherwise panic("phiIncomingValues: an edge into block {block.id} carries {edge.argIds.count()} args but the phi is at slot {slot} — edge args must be lockstep with block args"))
							end 'intoBlock'
						end 'eachEdge'
					end 'eachPred'
					return incoming
				end 'isPhi'
			end 'eachArg'
		end 'eachBlock'
		return incoming
	end 'phiIncomingValues'

	// **E3055 — the `try` target's terminal call must be one that CAN throw.** Anchored on the `try` token,
	// which is why it lives here and not in SemanticCheck (see `ParseError.tryOnNonThrowing`).
	//
	// ⭐ **THERE ARE TWO CALLEE CLASSES, AND ONLY ONE OF THEM WAS BEING ASKED.** A COMPILER-INTERNAL callee
	// (`__arr_count`, `__print_string`, `__str_append`) is in no signature registry, so `calleeIsDeclared`
	// answers `false` for it and the check used to wave every non-throwing builtin through: `try arr.count()`
	// and `try print("x")` compiled, and the desugar then branched on an error-flag register the callee never
	// wrote — a `try` that takes its error path on whatever the ABI left in R10. The reference compiler
	// rejects both. `isThrowingRuntimeCallee` is THE ONE home of "which builtin throws" (a throwing array
	// accessor, or `runProcess`), and this is the exact mirror of `SemanticCheck.validatePlainCall`, which reads
	// the SAME predicate to report the opposite mistake (E3057 — a throwing builtin called WITHOUT `try`).
	// Neither can drift from the other.
	//
	// A callee NO file declares is left to SemanticCheck's E3004: a `try <typo>` is an unknown function, not a
	// non-throwing one.
	//
	// A WITNESS target answers from its OWN clause, and it has no "undeclared" escape. An interface method is
	// in NO signature registry, so routing it through `calleeIsDeclared` would answer `false` and wave every
	// non-throwing interface method through — this very hole, arriving from the other side. Its `throws` is a
	// fact the constraint resolution already established, so the test is unconditional.
	function requireThrowingTryTarget(target TryTarget, tryTok Token) throws ParseError
		match target 'kind'
			named(callee) then try self.requireThrowingNamedTryTarget(callee, tryTok: tryTok)
			witness(methodName, throwsClause) then try requireThrowingWitnessTryTarget(methodName, throwsClause: throwsClause, tryTok: tryTok)
		end 'kind'
	end 'requireThrowingTryTarget'

	// The NAMED half of the check above — a direct callee or an awaited one, asked of the signature index.
	function requireThrowingNamedTryTarget(callee ByteArray, tryTok Token) throws ParseError
		if isCompilerInternalCallee(callee) 'builtin'
			if isThrowingRuntimeCallee(callee) 'throwingAccessor'
				return
			end 'throwingAccessor'
			throw ParseError.tryOnNonThrowingBuiltin(tryTok.line, column: tryTok.column)
		end 'builtin'

		if self.calleeIsDeclared(callee) and not throwsClauseIsThrowing(self.signatures.throwsOf(callee)) 'nonThrowing'
			throw ParseError.tryOnNonThrowing(String.from(callee), line: tryTok.line, column: tryTok.column)
		end 'nonThrowing'
	end 'requireThrowingNamedTryTarget'

	// The expression after `try` was not a call. Typed `returns TryTarget` so it slots into
	// `rewriteLastCallToTryCall`'s `match`, but it always throws.
	function rejectTryTarget(tryTok Token) returns TryTarget throws ParseError
		throw ParseError.unsupported("`try` must be applied to a call — `try f(…)` or `try obj.method(…)`; the expression after `try` is not a call", line: tryTok.line, column: tryTok.column)
	end 'rejectTryTarget'

	// Build the flag split + handler + merge for a parsed `tryCall`. `result` is the success value,
	// `flag` its error flag, both defined by the `tryCall` in `currentBlock`.
	function desugarTry(func IrFunction, tryTok Token, result ValueId, flag ValueId, target TryTarget, resultUsed bool) returns ValueId throws ParseError
		let entryBlock = self.currentBlock
		let zero = self.emitLiteral(0, valueType: MaxonType.integer, range: SourceRange.ofToken(tryTok))
		let isErr = try self.emitCompare(flag, rhs: zero, op: MaxonCmpOp.ne, opTok: tryTok)

		var okBlock = self.newBlock(func, label: b"tryok", line: tryTok.line)
		let errBlock = self.newBlock(func, label: b"tryerr", line: tryTok.line)
		self.emitCondBranch(entryBlock, cond: isErr, thenId: errBlock.id, elseId: okBlock.id, ifTok: tryTok)

		// Values entering both branches: the ok path leaves the carried vars unchanged, so `entryVals`
		// is what it carries; the error handler may reassign them (`otherwise 'err' result = 42`).
		let entryVals = self.snapshotBindings(self.mutableVars)

		// ⭐ **A MANAGED tryCall RESULT IS OWNED ONLY ON THE OK EDGE — pull it out of the ENTRY-block drop
		// set before the handler parses.** `mintOwnedCallResult` tracked the result as an owned pending
		// temp in the entry block, which flows to BOTH `tryok` and `tryerr`; on the `tryerr` edge the
		// result register is NULL (a throw zeroes it). An error handler that drains the pending temps
		// (`otherwise return`/`throw`, whose exit runs `emitHandoffExitDrops`) would then decref that NULL —
		// a segfault. Removing it here confines every touch of the result to the ok path; each finish path
		// re-scopes the still-owned value (the owned-heap bit is untouched, so `valueIsOwnedHeap` still
		// answers true) to the ok block, the phi, or an ok-block drop. A scalar result owns no heap, is in
		// no drop set, and this is a no-op for it — the Wave-1 behaviour, unchanged.
		if self.valueIsOwnedHeap(result) 'managedResultOffEntry'
			self.removeFromPendingTemps(result)
		end 'managedResultOffEntry'

		// ⭐ **THE FORK'S TEMPORARIES ARE LIVE ON BOTH EDGES, SO EACH EDGE DROPS THEM ONCE — IN ITS OWN BLOCK.**
		// Whatever the enclosing statement still owed when the `try` forked (the receiver `make()` built for a
		// `try make().slice(…)`, the `[10,20,30]` an array-literal target parsed, an interpolation passed as an
		// argument) was created BEFORE the branch, so it is live on `tryok` AND on `tryerr` — and the single
		// downstream drain that used to release it reaches only ONE of them. Every way that went wrong was a
		// leak the gate reports as exit 101, and there was one per handler form:
		//   • `otherwise return`/`throw` — the handler's `emitHandoffExitDrops` drained the SHARED list into the
		//     error block and CLEARED it, so the ok path, which still owed them, dropped nothing;
		//   • a handler BLOCK — the first statement inside it drained the shared list for the same reason,
		//     with the same result;
		//   • `propagate` (a bare `try f()`) and `otherwise break`/`continue` — these never drained at all, so
		//     the ERROR edge leaked them instead.
		// Dropping per edge, at the fork, settles all four with one rule and no per-form knowledge: the error
		// edge's drops go in at the top of `errBlock`, the ok edge's at the top of `okBlock`, and the handler
		// parses against a FRESH list so its own temporaries stay its own and it can no longer steal these.
		// It cannot be done in the CONTINUATION instead — `otherwise <value>` and a fell-through block merge
		// both edges there, so one drop in the merge is one drop too few on the other path.
		//
		// Dropping the receiver at the top of `okBlock` (rather than at statement end) is safe for a VIEW
		// result: `__arr_slice` increfs the shared base allocation, so releasing the source RECORD leaves the
		// bytes the view reads alive — the same guarantee that already made the statement-end drop safe.
		//
		// Guarded on a non-empty list: almost no `try` has a pending temporary, and the guard keeps the common
		// one from paying for a fresh array.
		//
		// ⚠ **THE LIST IS REPLACED LAST, AFTER BOTH WALKS, AND THAT ORDER IS LOAD-BEARING.** Written the other
		// way round — replace first, then walk a handle taken before the replace — this crashed the parser:
		// `emitTempDrops` read a POINTER-shaped word where a `ValueId` belonged and `tagOf` panicked, because
		// the store had released the array the handle still named. Measured both ways: a handle is harmless
		// while the field still holds the list and fatal once it does not, so the walks stay ahead of the store
		// and no handle is taken at all, which is what makes the rule unbreakable rather than remembered.
		if self.pendingTempDrops.count() > 0 'forkTemps'
			self.currentBlock = okBlock
			self.emitTempDrops(self.pendingTempDrops, floor: WholeStatementTempFloor, anchor: tryTok)
			self.currentBlock = errBlock
			self.emitTempDrops(self.pendingTempDrops, floor: WholeStatementTempFloor, anchor: tryTok)
			self.pendingTempDrops = ValueIdArray.create()
		end 'forkTemps'

		self.currentBlock = errBlock
		let handler = try self.parseOtherwiseHandler(func, result: result, flag: flag, target: target, resultUsed: resultUsed, tryTok: tryTok)
		var errEnd = self.currentBlock

		return match handler 'h'
			terminated gives self.finishTerminatedTry(okBlock, entryVals: entryVals, result: result)
			value(otherwiseValue) gives try self.finishValueTry(func, okBlock: okBlock, errEnd: errEnd, result: result, otherwiseValue: otherwiseValue, tryTok: tryTok)
			fellThrough gives try self.finishFellThroughTry(func, okBlock: okBlock, errEnd: errEnd, entryVals: entryVals, result: result, resultUsed: resultUsed, tryTok: tryTok)
		end 'h'
	end 'desugarTry'

	// The error handler TERMINATED (propagate / return / break / continue / throw / panic): only the ok
	// block reaches the continuation. Restore the carried vars to their pre-try values (the error path's
	// reassignments do not reach here) and continue in the ok block.
	function finishTerminatedTry(okBlock IrBlock, entryVals ValueIdArray, result ValueId) returns ValueId
		self.restoreBindings(self.mutableVars, snapshot: entryVals)
		self.currentBlock = okBlock

		// ⭐ **RE-ENROL A MANAGED RESULT AS AN OWNED TEMP ON THE OK PATH.** The error handler terminated, so
		// only `okBlock` continues, and here the managed result is a live owned box — exactly a plain managed
		// call result. `desugarTry` pulled it off the entry drop set (it is NULL on the dead error edge); put
		// it back so the ok continuation binds it (`let s = …` → `parseBinding` moves it to a scope-exit drop)
		// or drops it (a discarded `try f()` → the statement drain), on the ok path only. The owned-heap bit
		// survived the removal, so only the pending enrolment is restored; a scalar result owns no heap and is
		// re-enrolled in nothing.
		if self.valueIsOwnedHeap(result) 'reenrollManagedResult'
			self.pendingTempDrops.push(result)
		end 'reenrollManagedResult'

		return result
	end 'finishTerminatedTry'

	// `otherwise <expr>` — both edges reach a fresh continuation carrying a result phi of `result` (ok)
	// and `otherwiseValue` (err). No carried-var phis: an `otherwise` VALUE is an expression, which
	// assigns no binding, so the ok and err edges agree on every carried var.
	function finishValueTry(func IrFunction, okBlock IrBlock, errEnd IrBlock, result ValueId, otherwiseValue ValueId, tryTok Token) returns ValueId throws ParseError
		// CONSUMER GUARD for the void-result invariant OPEN #55 fixed at the producer: a void `try`-result
		// has no width, so a value merge is ill-formed and `mintPhi` below would build a void phi block-arg
		// lowering can't type. `parseUnboundOtherwiseForm`'s value-form guard already rejects it (E3059) —
		// it is the ONE `TryHandler.value` producer and runs strictly before here — so this can only trip on
		// a FUTURE value-handler producer that forgets the check, and it names that invariant rather than
		// deferring the crash to the confusing `valueTagToStdType` lowering panic it used to be.
		if self.tagOf(result) == ValueTypeTag.void 'voidResultPhi'
			panic("finishValueTry: a void try-result reached the value merge — parseUnboundOtherwiseForm's value-form guard (OPEN #55) must reject `try <voidCall> otherwise <value>` before here")
		end 'voidResultPhi'

		// ⭐ **REJECT AN OPAQUE-`T` TRY-MERGE THAT WOULD NEED A DESCRIPTOR-GATED INCREF/COPY (P1.7 slice
		// 3b-vi-a).** The owned reconciliation below assumes a CONCRETE managed pointer: it increfs the borrowed
		// OK result (`__mm_incref`), copies a borrowed String fallback (`promoteToOwnedString`), or increfs an
		// aliased owned fallback (`transferFallbackToPhi`). For an OPAQUE `typeParameter` element every one of
		// those is WRONG — a trivial instantiation's word is a RAW SCALAR a plain `__mm_incref` faults on
		// (access violation), and a managed one needs the enclosing instance's descriptor to pick the retain. So
		// a `try <opaqueArr>.get/first/last(…) otherwise <owned>` (a borrow merged with an owned fallback) or a
		// `try <opaqueArr>.pop/remove(…) otherwise <value>` (an owned move-out merged with a fallback value) is a
		// clean E2015 until a descriptor-gated reconciliation lands (a later slice). A DIVERGING otherwise
		// (`otherwise return`/`throw`/`panic`) routes to `finishTerminatedTry` and never reaches here — that plain
		// borrow / move-out is exactly what this slice supports. Only the opaque array accessors produce a
		// `typeParameter` try-result at this slice (a function cannot yet return an opaque `T`), so the tag is the
		// whole test; a value fallback that must be reconciled is signalled by either side owning heap.
		if self.tagOf(result) == ValueTypeTag.typeParameter and (self.valueIsOwnedHeap(result) or self.valueIsOwnedHeap(otherwiseValue)) 'opaqueTryMerge'
			throw ParseError.unsupported("a `try` on an opaque type-parameter array accessor (`get`/`first`/`last`/`pop`/`remove` on an `Array with <type parameter>` field) with a VALUE `otherwise <expr>` — reconciling the borrowed/moved-out element with the fallback at the `try` continuation needs a descriptor-gated incref/copy the shared body cannot pick statically (the element is a raw scalar for a trivial instantiation and a managed pointer for another), a distinct future slice. Use a DIVERGING `otherwise` (`otherwise return`/`throw`/`panic`) instead — the plain borrow (`get`/`first`/`last`) and move-out (`pop`/`remove`) are supported that way (P1.7 slice 3b-vi-a).", line: tryTok.line, column: tryTok.column)
		end 'opaqueTryMerge'

		var cont = self.newBlock(func, label: b"trycont", line: tryTok.line)
		let phiId = self.mintPhi(cont, tag: self.tagOf(result), nameId: try self.valueNameIds.get(result) otherwise panic("finishValueTry: result has no name column"))

		// ⭐ E3070: a `let s = try arr.get(0) otherwise …` binds THIS phi, not the accessor's result, so an
		// element borrow riding the ok edge has to move onto it or the binding would claim nothing. Done
		// where the phi is minted — the one place both values are in hand (`retargetPendingBorrow`).
		self.retargetPendingBorrow(func, from: result, to: phiId)

		// ⭐ **A MANAGED RESULT PHI IS OWNED — reconcile both edges to owned before wiring them in.** When the
		// try-result owns heap, the phi is the sole owner of whichever value reaches the merge and is dropped
		// once at its scope exit, so each edge's contribution must transfer ONE owned reference IN: the ok
		// `result` was already pulled off the entry drop set (`desugarTry`), and the err `otherwiseValue` — an
		// owned call result, a borrowed String literal PROMOTED to an owned copy in `errEnd` (currentBlock
		// here), or a live owned BINDING aliased into the merge — is reconciled by `transferFallbackToPhi`
		// (move a temp, incref a binding). `parseUnboundOtherwiseForm` already refused a fallback that could not
		// become an owned managed value of the result's type. A SCALAR result keeps the borrowed phi the Wave-1
		// path built — nothing is owned, nothing is dropped.
		var errEdgeValue = otherwiseValue
		var phiOwned = false
		if self.valueIsOwnedHeap(result) 'managedResultPhi'
			if not self.valueIsOwnedHeap(otherwiseValue) 'promoteBorrowedFallback'
				errEdgeValue = self.promoteToOwnedString(otherwiseValue, range: SourceRange.ofToken(tryTok))
			end 'promoteBorrowedFallback'
			self.transferFallbackToPhi(errEdgeValue, tryTok: tryTok)
			phiOwned = true
		end 'managedResultPhi' else 'borrowResult'
			// ⭐ **A BORROW try-result merged with an OWNED fallback** (`try arr.get(i) otherwise Item.create(…)`,
			// P1.7 slice 3). A managed-array `get`/`first`/`last` yields a BORROW — the array owns the element
			// and its `__arr_decref` walk drops it — while the `otherwise` fallback is a FRESH OWNED box. The
			// two edges merge into ONE binding, which has ONE drop discipline, so they MUST agree on ownership.
			//
			// ⚠ **THE OK BORROW IS INCREF'D SO THE PHI IS OWNED — do NOT compensate for the fallback with an
			// error-edge drop.** Making the phi a borrow (never dropped) leaks the owned fallback; the earlier
			// cure — `emitDecref(otherwiseValue)` on the error edge — freed the fallback BEFORE the merged
			// binding was read, a use-after-free the non-reclaiming bump allocator (#108) hid until a poisoning
			// `__mm_free` exposed it (four `array-slots` reads came back `0x3F3F…`). Instead the ok edge takes a
			// SECOND owner of the borrowed element with `__mm_incref`, so the phi owns a reference on BOTH edges
			// and is dropped exactly ONCE at the binding's scope exit — after the last read, on every path.
			// incref and every managed drop (`__mm_decref`/`__str_decref`/`__arr_decref`/`__destruct_*`) share the
			// one header-refcount protocol (`emitRefcountCheckToLastOwner`), so the array's own decref walk and
			// this scope-exit drop balance regardless of which runs last: the element ends at refcount 0 with
			// exactly one free. The incref goes into `okBlock` (single-threaded, before its branch to `cont`);
			// `currentBlock` is `errEnd` and is restored after.
			//
			// The ERROR edge owes the phi a reference too, by the SAME rule: `transferFallbackToPhi` moves an
			// owned temp or increfs an aliased binding, so a `try arr.get(i) otherwise fallbackBinding` (the
			// binding read again after the try) no longer double-frees the box the phi and the binding share.
			//
			// A SCALAR result with a scalar fallback owns nothing on either edge, so the guard is false and the
			// Wave-1 borrowed phi stands — nothing incref'd, nothing dropped.
			if self.valueIsOwnedHeap(otherwiseValue) 'ownedFallbackIntoBorrow'
				let resumeBlock = self.currentBlock
				self.currentBlock = okBlock
				self.emitIncref(result, range: SourceRange.ofToken(tryTok))
				self.currentBlock = resumeBlock

				self.transferFallbackToPhi(otherwiseValue, tryTok: tryTok)
				phiOwned = true
			end 'ownedFallbackIntoBorrow'
		end 'borrowResult'

		// ⭐ **THE FALLBACK EXPRESSION'S ABANDONED TEMPORARIES DIE ON THE ERROR EDGE — the `otherwise <value>`
		// region, the one fork this rung's per-region drop list omitted.** The fallback runs on the error edge
		// ALONE, so a temporary it built and did not hand back (`[1,2]` in `otherwise [1,2].count()`) is exactly a
		// ternary/match arm's abandoned temp, one construct over: releasing it at the shared statement tail —
		// which sits in `cont`, reached from the ok edge too — releases a value that edge never built, the
		// register allocator's "a use dominates its def" (a compiler panic on a valid program). `currentBlock` is
		// `errEnd` (or the block the fallback left control in), which dominates the err→`cont` edge, so the drops
		// ride the single-threaded error path. The floor is `WholeStatementTempFloor`: `desugarTry` cleared the
		// pending list at the fork, so everything enrolled since is the fallback's own, and the fallback VALUE was
		// pulled out just above (into the phi) — the phi is enrolled AFTER this drain so it is not swept here.
		//
		// ⚠ SKIPPED when the phi is a BORROW of a still-live source (`phiOwned` false AND the fallback is a
		// managed pointer): such a fallback can BORROW into one of these temporaries (`otherwise makeX().field`),
		// and dropping the temporary would free what the phi reads. That shape needs the source incref'd, not
		// dropped — a narrower case left for its own change; draining here would trade the pre-existing panic for
		// a use-after-free. A scalar fallback borrows nothing, so the common `otherwise <expr>.count()` is safe.
		if phiOwned or not self.valueIsManagedHeap(otherwiseValue) 'dropFallbackTemps'
			self.drainPendingTemps(WholeStatementTempFloor, anchor: tryTok)
		end 'dropFallbackTemps'

		if phiOwned 'enrolPhi'
			self.trackOwnedTemp(phiId)
		end 'enrolPhi'

		var okArgs = ValueIdArray.create()
		okArgs.push(result)
		self.recordBranchEdge(okBlock, targetId: cont.id, argIds: okArgs)
		self.emitBranch(okBlock, targetId: cont.id)

		var errArgs = ValueIdArray.create()
		errArgs.push(errEdgeValue)
		self.recordBranchEdge(errEnd, targetId: cont.id, argIds: errArgs)
		self.emitBranch(errEnd, targetId: cont.id)

		self.currentBlock = cont
		return phiId
	end 'finishValueTry'

	// ⭐ **HAND THE MERGE PHI EXACTLY ONE OWNED REFERENCE FROM THE ERROR EDGE.** `finishValueTry` drops the
	// phi once at the binding's scope exit, so the value flowing in on the error edge must give the phi a
	// reference it can own outright — and the two fallback shapes owe that reference differently:
	//   • an unconsumed owned TEMPORARY (`otherwise Slot.create(…)`) already owns its one reference and is
	//     handed off — MOVE it into the phi by dropping it from the pending list; nothing else drops it.
	//   • a live owned BINDING or consumed param (`otherwise fallback`, aliased and read again after the
	//     `try`) keeps its OWN reference and drops it at its own scope exit — so the phi needs a SECOND
	//     reference, taken with `__mm_incref` on the error edge (`currentBlock` is `errEnd` at both callers).
	// Getting it backwards is a wrong answer either way: increfing a temp LEAKS (its extra reference is
	// dropped by nobody — no binding owns it), moving a binding DOUBLE-FREES (the phi and the binding each
	// drop the one box, the leak count goes negative → exit 101). `pendingTempsContain` is the discriminator:
	// the two owned homes are disjoint by construction (a transfer to a binding calls `removeFromPendingTemps`
	// first), so a value still in the pending list is owned by no binding. This is the error-edge twin of the
	// ok-edge borrow incref above.
	function transferFallbackToPhi(errEdgeValue ValueId, tryTok Token)
		if self.pendingTempsContain(errEdgeValue) 'movedTemp'
			self.removeFromPendingTemps(errEdgeValue)
		end 'movedTemp' else 'aliasedBinding'
			self.emitIncref(errEdgeValue, range: SourceRange.ofToken(tryTok))
		end 'aliasedBinding'
	end 'transferFallbackToPhi'

	// `otherwise ignore` or a block handler that FELL THROUGH — both edges reach a fresh continuation
	// with no try-value. Merge the carried vars a block handler may have reassigned (`mergeAtContinuation`
	// mints a phi only where the two edges differ). The returned `result` is the discarded statement value.
	function finishFellThroughTry(func IrFunction, okBlock IrBlock, errEnd IrBlock, entryVals ValueIdArray, result ValueId, resultUsed bool, tryTok Token) returns ValueId throws ParseError
		// ⭐ **A FELL-THROUGH HANDLER CARRIES NO VALUE, SO IT CANNOT STAND IN A VALUE POSITION.** `otherwise
		// ignore` and a handler block that runs off its end both catch the error and produce nothing, so the
		// error edge reaches the merge with no value while a value position needs one on BOTH edges — and for
		// a managed result the ok edge is about to DROP that result below, so binding it would read freed heap
		// (a leak/UAF, not merely an undefined scalar). Rejected HERE, the ONE point at which both spellings
		// have collapsed to the `fellThrough` signal, so the rule is stated once rather than at each spelling's
		// parse site (`otherwise ignore` used to reject itself, and a fall-through block went unchecked — the
		// two drifted, and the block case leaked).
		if resultUsed 'valuelessHandlerInValue'
			throw ParseError.errorTypeMismatch("a `try` used for its value needs a value on the error path too, but this `otherwise` handler catches the error without producing one (`otherwise ignore`, or a handler block that runs off its end) — give it a fallback value with `otherwise <expr>`, or make every path of the handler terminate (`return`/`throw`/`break`/`continue`)", line: tryTok.line, column: tryTok.column)
		end 'valuelessHandlerInValue'

		var cont = self.newBlock(func, label: b"trycont", line: tryTok.line)
		let errVals = self.snapshotBindings(self.mutableVars)
		self.mergeAtContinuation(okBlock, predB: errEnd, cont: cont, bindings: self.mutableVars, valsA: entryVals, valsB: errVals)

		// ⭐ **A DISCARDED MANAGED RESULT DROPS ON THE OK EDGE, IN `okBlock`.** A fell-through handler
		// (`otherwise ignore`, or a block that ran off its end) always discards the try's value, and a managed
		// result is a live owned box on the ok edge but NULL on the error edge. Its drop goes into `okBlock`,
		// BEFORE its branch to the shared `cont` — never in `cont` (reached by both edges, so a drop there
		// would decref the NULL error-edge register) and never on the error edge. `desugarTry` already pulled
		// it off the pending list, so the post-statement drain never sees it and this is its only drop.
		if self.valueIsOwnedHeap(result) 'dropManagedResultOnOk'
			self.currentBlock = okBlock
			self.emitDecref(result, range: SourceRange.ofToken(tryTok))
		end 'dropManagedResultOnOk'

		self.emitBranch(okBlock, targetId: cont.id)
		self.emitBranch(errEnd, targetId: cont.id)
		self.currentBlock = cont
		return result
	end 'finishFellThroughTry'

	// Parse the `otherwise` handler (or its absence — a PROPAGATE) into the current (error) block, and
	// report how it affects the merge. On entry `currentBlock` is the error block.
	function parseOtherwiseHandler(func IrFunction, result ValueId, flag ValueId, target TryTarget, resultUsed bool, tryTok Token) returns TryHandler throws ParseError
		if not self.at(TokenKind.otherwise) 'propagate'
			// Uncaught `try f()` / `try await p` — re-publish the callee's flag to this function's caller. The
			// flag is re-emitted VERBATIM, so the propagated error type MUST match this function's `throws`
			// type or the caller decodes one enum's ordinals as another's (E3059, checked here).
			try self.checkPropagateType(func, throwsClause: self.tryTargetThrows(target), tryTok: tryTok)
			self.emitScopeDrops(WholeFunctionScopeFloor, anchor: tryTok)
			self.artifact.emitTerminator(self.currentBlock, op: MaxonOp.propagateError(flag), range: SourceRange.ofToken(tryTok))
			return TryHandler.terminated
		end 'propagate'

		try self.consume(TokenKind.otherwise)

		// Block forms own their caught box end-to-end (`parseOtherwiseBlock` enrols, binds and drops it).
		if self.at(TokenKind.leftParen) 'bindingForm'
			return try self.parseOtherwiseBinding(func, flag: flag, target: target)
		end 'bindingForm'

		if self.at(TokenKind.charLiteral) 'blockForm'
			return try self.parseOtherwiseBlock(func, bindingName: EmptySourceText, hasBinding: false, flag: flag, target: target)
		end 'blockForm'

		// ⭐ **THE NON-BLOCK FORMS DISCARD THE CAUGHT ERROR, SO ITS BOX MUST DROP HERE.** `otherwise ignore`,
		// a fallback VALUE, and the single-statement `return`/`break`/`continue`/`throw <fresh>` each catch a
		// boxed error and then throw it away — so its box, owned by this try, drops exactly once on the error
		// edge. Enrol it (ANONYMOUS — these forms name no `e`) so a terminating form's own `emitScopeDrops`
		// releases it, then drop it here for the non-terminating forms (`dropArmScopedOwned` frees it on a live
		// exit, drains it either way). A SCALAR error owns no box, so `boxed` is false and this is inert — the
		// existing scalar forms are untouched. (`otherwise panic` aborts the process before any free matters.)
		let eType = self.tryErrorEnumType(self.tryTargetThrows(target))
		let ownedFloor = self.ownedBindings.count()
		if self.throwsTypeIsBoxedUnion(eType) 'enrolBox'
			self.enrollCaughtBox(flag, eType: eType, binding: VarInfo.createValueBinding(EmptySourceText, varType: eType, mutable: false, boundValue: flag))
		end 'enrolBox'

		let handler = try self.parseUnboundOtherwiseForm(func, result: result, resultUsed: resultUsed, tryTok: tryTok)
		self.dropArmScopedOwned(ownedFloor, exitBlock: self.currentBlock, anchor: tryTok)
		return handler
	end 'parseOtherwiseHandler'

	// The `otherwise` forms that bind no `e` and open no block: `ignore`, a single-statement `return`/`break`/
	// `continue`/`throw`/`panic`, or a fallback VALUE. Split out of `parseOtherwiseHandler` so its caller can
	// bracket them with the caught-box enrol/drop every one of them shares — each DISCARDS the caught error.
	// Returns how the form affects the merge; on entry `currentBlock` is the error block.
	function parseUnboundOtherwiseForm(func IrFunction, result ValueId, resultUsed bool, tryTok Token) returns TryHandler throws ParseError
		// `otherwise ignore` catches the error and discards the value — a fell-through (statement) form. Its
		// use in a value position is refused uniformly with a fall-through block, at the one `fellThrough`
		// gate in `finishFellThroughTry`; here it only reports HOW the merge behaves.
		if self.at(TokenKind.ignore) 'ignoreForm'
			try self.consume(TokenKind.ignore)
			return TryHandler.fellThrough
		end 'ignoreForm'

		// The single-statement CONTROL-FLOW forms terminate the error block; their own scope drops release
		// the caught box the caller enrolled.
		if self.at(TokenKind.return) or self.at(TokenKind.break) or self.at(TokenKind.continue) 'controlFlow'
			_ = try self.parseStatement(func, block: self.currentBlock)
			return TryHandler.terminated
		end 'controlFlow'
		if self.at(TokenKind.throw) 'rethrow'
			try self.parseThrowStatement(func, block: self.currentBlock)
			return TryHandler.terminated
		end 'rethrow'
		if self.at(TokenKind.panic) 'panicForm'
			try self.parsePanicStatement(func, block: self.currentBlock)
			return TryHandler.terminated
		end 'panicForm'

		// `otherwise <expr>` — a fallback VALUE that merges with the success value.
		//
		// A void `try` (its call returns nothing) has no success value for a fallback VALUE to stand in
		// for, so `otherwise <expr>` is ill-formed here — `finishValueTry` would mint a void phi that
		// lowering cannot type (OPEN #55). The valueless forms a void `try` DOES take (`ignore`, a block,
		// a single-statement return/break/continue/throw/panic) are all handled above, so reaching here
		// means a genuine value. This is the statement-position twin of `parseTry`'s value-position void
		// reject; both are E3059. (A value-position void `try` is rejected before the handler parses, so
		// `result` is void here only in statement position.)
		if self.tagOf(result) == ValueTypeTag.void 'voidTryOtherwiseValue'
			throw ParseError.errorTypeMismatch("a void `try` (its call returns nothing) cannot take an `otherwise <value>` fallback — the success path yields no value for the fallback to stand in for; use `otherwise ignore`, an `otherwise 'block' … end`, or a single-statement `otherwise return`/`throw`", line: tryTok.line, column: tryTok.column)
		end 'voidTryOtherwiseValue'

		let otherwiseTok = self.current()
		let otherwiseValue = try self.parseExpression(func, block: self.currentBlock)

		// ⭐ **MERGE (P1.5-A2b): a capturing closure may not be an `otherwise <value>` fallback** — it merges
		// with the try's success value through one result phi (the code pointer alone), and the env rides a
		// side column a phi cannot carry, so on the error edge the merged closure would be called with env=0
		// and nil-deref. The same merge hazard as a match-expression arm, refused through the same E3099 gate.
		// (The try's SUCCESS value cannot itself be a capturing closure — a function may not RETURN one, so the
		// callee is refused at its own `return` — leaving only the fallback to guard here.)
		try self.rejectEscapingClosure(otherwiseValue, message: "cannot use a closure that captures as the value of an `otherwise` fallback: {CapturingClosureMergeSuffix}", tok: otherwiseTok)

		if resultUsed and tagIsFloat(self.tagOf(otherwiseValue)) != tagIsFloat(self.tagOf(result)) 'typeMismatch'
			throw ParseError.errorTypeMismatch("otherwise type '{typeTagName(self.tagOf(otherwiseValue))}' does not match expected type '{typeTagName(self.tagOf(result))}'", line: tryTok.line, column: tryTok.column)
		end 'typeMismatch'

		// ⭐ OPEN #54/#59: an `otherwise` fallback of the WRONG named aggregate — a DIFFERENT struct/union,
		// OR an aggregate where the try-result is a SCALAR (or the reverse) — merges into the try's owned
		// result phi and is dropped under the RESULT's destructor: a wild free / leak the float check above
		// cannot see (two structs share the `structRef` tag; a boxed union and a ranged-int alias share
		// `named`). Runs regardless of `resultUsed`: the phi is dropped on the discard path too (see the
		// managed-result handling below). Identity is the interned name, EXACT. Un-gated — both names are
		// computed unconditionally, empty for a scalar with no allocation — and `giveTypeName` prints the
		// scalar side's primitive, not an empty name.
		let resultAggregate = self.aggregateNameOf(self.tagOf(result), nameId: self.valueNameId(result))
		let fallbackAggregate = self.aggregateNameOf(self.tagOf(otherwiseValue), nameId: self.valueNameId(otherwiseValue))
		if self.signatures.aggregatesConflict(resultAggregate, got: fallbackAggregate) 'aggregateOtherwiseMismatch'
			throw ParseError.errorTypeMismatch("otherwise type '{self.giveTypeName(self.tagOf(otherwiseValue), aggregateName: fallbackAggregate)}' does not match expected type '{self.giveTypeName(self.tagOf(result), aggregateName: resultAggregate)}'", line: tryTok.line, column: tryTok.column)
		end 'aggregateOtherwiseMismatch'

		// ⭐ **A MANAGED try-result and its `otherwise` fallback merge through an OWNED result phi**
		// (`finishValueTry`), dropped once at its scope exit — so both edges must contribute an OWNED value
		// of the SAME managed type. Two ways that can be violated, both a wild free at the phi's drop, so
		// both are refused HERE where the fallback's type is in hand (and regardless of `resultUsed`: the
		// phi is dropped on the discard path too):
		//   • a TAG MISMATCH — a `String` result with an `int` fallback — whose phi drop would decref an
		//     integer as a String pointer.
		//   • a BORROWED AGGREGATE fallback — a struct/union parameter (or a re-borrow) — which cannot
		//     transfer into the phi because its own owner keeps a live reference: dropping the phi on the
		//     fallback edge would double-free it. This is the same refusal `parseReturnStatement` makes for a
		//     borrowed aggregate return; a borrowed String LITERAL is the one exception, promoted to an owned
		//     copy at the merge (`finishValueTry`).
		if self.valueIsOwnedHeap(result) 'managedOtherwise'
			if self.tagOf(otherwiseValue) != self.tagOf(result) 'managedOtherwiseTypeMismatch'
				throw ParseError.errorTypeMismatch("otherwise type '{typeTagName(self.tagOf(otherwiseValue))}' does not match expected type '{typeTagName(self.tagOf(result))}'", line: tryTok.line, column: tryTok.column)
			end 'managedOtherwiseTypeMismatch'
			if not self.valueIsOwnedHeap(otherwiseValue) and not tagIsText(self.tagOf(otherwiseValue)) 'borrowedAggregateOtherwise'
				throw ParseError.unsupported("an `otherwise` fallback that is a borrowed struct/union value — it merges with the try's owned result through a phi dropped exactly once, and a borrowed aggregate's own owner keeps a live reference, so dropping the merged value would free it twice. Return an OWNED value (a fresh factory call), or catch the error in an `otherwise (e) 'label' … end` block; consuming a borrowed aggregate arrives with cross-call consume", line: tryTok.line, column: tryTok.column)
			end 'borrowedAggregateOtherwise'
		end 'managedOtherwise'

		return TryHandler.value(otherwiseValue)
	end 'parseUnboundOtherwiseForm'

	// `otherwise (e) 'label' … end 'label'` — bind the caught error `e = flag - 1` (typed as the TARGET's
	// throws enum so `match e` recognizes it), then parse the labelled handler block. In a match arm this
	// block form is E2049.
	function parseOtherwiseBinding(func IrFunction, flag ValueId, target TryTarget) returns TryHandler throws ParseError
		try self.consume(TokenKind.leftParen)
		let eNameTok = try self.consume(TokenKind.identifier)
		try self.consume(TokenKind.rightParen)
		return try self.parseOtherwiseBlock(func, bindingName: eNameTok.value, hasBinding: true, flag: flag, target: target)
	end 'parseOtherwiseBinding'

	// ⭐ **ENROL A CAUGHT BOXED ERROR AS OWNED.** The flag IS the box pointer (the throw ENCODE wrote it
	// verbatim), so the binding takes it with NO decode arithmetic — only its type columns are re-recorded to
	// the union (`retypeValue`) so `match e` dispatches through the box (`enumMatchFor`) and the scope-exit
	// drop routes to `__destruct_<U>` (`decrefCalleeFor`), both of which read the value TAG. `markValueOwnsHeap`
	// enrols it so the scope machinery releases it exactly once. `binding` is the NAMED `(e)` binding, or an
	// ANONYMOUS one for a discarding form (a no-binding block, `otherwise ignore`, a fallback value). ONE
	// enrolment shape for every catching form, so they cannot drift on how a transferred box becomes owned.
	function enrollCaughtBox(flag ValueId, eType MaxonType, binding VarInfo)
		self.retypeValue(flag, valueType: eType)
		self.markValueOwnsHeap(flag)
		self.ownedBindings.push(binding)
	end 'enrollCaughtBox'

	// Parse an `otherwise` handler BLOCK (`otherwise ['(e)'] 'label' … end 'label'`) into the error block.
	// When `hasBinding`, `e = flag - 1` is declared in a fresh scope frame before the body. Both forms are
	// E2049 in a match arm (the block label is where the arm-body single-statement rule is violated).
	function parseOtherwiseBlock(func IrFunction, bindingName ByteArray, hasBinding bool, flag ValueId, target TryTarget) returns TryHandler throws ParseError
		if not self.at(TokenKind.charLiteral) 'noLabel'
			let tok = self.current()
			throw ParseError.matchMissingBlockId(tok.line, column: tok.column)
		end 'noLabel'
		let labelTok = self.current()
		if self.inMatchArmBody 'inArm'
			throw ParseError.tryBlockFormInMatchArm(true, line: labelTok.line, column: labelTok.column)
		end 'inArm'
		// Consume the block-open label (`parseBlockBody` consumes only the closing `end <label>`, exactly
		// as `parseIfStatement`/`parseWhileStatement` consume their own opening labels).
		try self.consume(TokenKind.charLiteral)

		var errBlock = self.currentBlock
		let eType = self.tryErrorEnumType(self.tryTargetThrows(target))
		let boxed = self.throwsTypeIsBoxedUnion(eType)

		// The owned-binding height BEFORE the caught box is enrolled — a handler-local drop FLOOR, the try
		// twin of `openBlock`'s `ownedCount` (drained by `dropArmScopedOwned` below). A boxed error is an
		// owned heap value this handler received ownership of; a scalar error owns no heap and adds none.
		let ownedFloor = self.ownedBindings.count()
		self.scope.pushScope()

		if boxed 'boxedError'
			// The caught box is enrolled owned — NAMED for `(e)`, ANONYMOUS for a `otherwise 'l'` — so a
			// binding-less block on a heap error still releases the transferred box exactly once.
			// `dropArmScopedOwned` frees it on the edge that leaves the handler, and a `throw e` that moved it
			// out first is skipped.
			var eBinding = VarInfo.createValueBinding(EmptySourceText, varType: eType, mutable: false, boundValue: flag)
			if hasBinding 'nameBoxedE'
				eBinding = try self.scope.declareValueBinding(bindingName, varType: eType, mutable: false, value: flag) otherwise throw ParseError.localShadowsSelfField(String.from(bindingName), typeName: String.from(self.enclosingType), line: labelTok.line, column: labelTok.column)
			end 'nameBoxedE'
			self.enrollCaughtBox(flag, eType: eType, binding: eBinding)
		end 'boxedError' else 'scalarError'
			if hasBinding 'bindScalarE'
				// DECODE the caught flag back to the enum ordinal: `e = flag - ErrorFlagOrdinalBias`, the exact
				// inverse of the Std-tier throw ENCODE (`lowerThrowError`). Both read the one `ErrorFlagOrdinalBias`
				// so a change to the bias cannot leave this decode silently binding `match e` to the wrong case.
				let bias = self.emitLiteral(ErrorFlagOrdinalBias, valueType: MaxonType.integer, range: SourceRange.ofToken(labelTok))
				let eValue = self.mintValueOfType(eType)
				self.artifact.emitOp(errBlock, op: MaxonOp.binOp(eValue, lhs: flag, rhs: bias, op: MaxonBinOp.sub), range: SourceRange.ofToken(labelTok))
				_ = try self.scope.declareValueBinding(bindingName, varType: eType, mutable: false, value: eValue) otherwise throw ParseError.localShadowsSelfField(String.from(bindingName), typeName: String.from(self.enclosingType), line: labelTok.line, column: labelTok.column)
			end 'bindScalarE'
		end 'scalarError'

		let errEnd = try self.parseBlockBody(func, block: errBlock, label: labelTok.value)
		self.scope.popScope()

		// Release the caught box on whichever edge leaves the handler — a `__destruct_<U>`/decref on a live
		// fall-through (into `errEnd`), the terminating statement's own `emitScopeDrops` on a return/throw —
		// and drain it off the owned list either way, so the function-end drop never sees a handler binding.
		// A no-op when the handler enrolled nothing (a scalar error, or none).
		self.dropArmScopedOwned(ownedFloor, exitBlock: errEnd, anchor: labelTok)

		if errEnd.isTerminated() 'terminated'
			return TryHandler.terminated
		end 'terminated'
		return TryHandler.fellThrough
	end 'parseOtherwiseBlock'

	// The MaxonType of the enum a throwing `callee` throws — the type an `(e)` binding recovers. A callee
	// with no throws clause is rejected by SemanticCheck (E3055), so the fallback `integer` here is never
	// lowered; it only keeps the parser from panicking while building IR the error gate will discard.
	// ⭐ **E3059 — PROPAGATE TYPE MISMATCH.** A bare `try …` (no `otherwise`) re-publishes the caught flag
	// VERBATIM into the ENCLOSING function's error register, so if the propagated callee throws a DIFFERENT
	// error type than the enclosing function declares, the caller decodes one enum's ordinals as another's
	// tags — a silent miscompile a boxed union turns into a wild free. Refused when the two named types differ,
	// AND when the enclosing function names none at all (see `rejectPropagateAgainstEnclosing`). Shared by
	// every try shape — a direct call, `try await p` (the awaited callee's throws type IS the promise's) and a
	// witness dispatch — because each answers `tryTargetThrows` and only the CLAUSE reaches here.
	function checkPropagateType(func IrFunction, throwsClause ThrowsClause, tryTok Token) throws ParseError
		match throwsClause 'calleeThrows'
			none then break 'calleeThrows'
			throwing(propagated) then try self.rejectPropagateAgainstEnclosing(func, propagated: propagated, tryTok: tryTok)
		end 'calleeThrows'
	end 'checkPropagateType'

	// The enclosing-function half of the propagate-type check: refuse when the enclosing function throws a
	// DIFFERENT named type than `propagated` — or NO type at all. Split so the nested `match`/comparison is
	// not an inline labelled-if in a match arm (which the parser rejects).
	//
	// ⚠ **THE `none` ARM IS A REJECT, NOT A FALLTHROUGH.** A bare `try f()` inside a function declaring no
	// `throws` has nowhere to re-publish the flag: `propagateError` writes the enclosing function's error
	// register, and a non-throwing function's caller never reads it — so the error is SILENTLY DISCARDED and
	// the callee's throw-path primary (`0`) comes back as a real answer. MEASURED both ways: `try inner(3)` in
	// a non-throwing `outer` exited 0 where the answer is the error path, and so did the witness spelling
	// (`try self.item.digest()` in a non-throwing generic method). The runnable oracle refuses both — E2001,
	// "try without otherwise requires the enclosing function to have 'throws'" — so this closes a divergence,
	// not a design question. `error-handling.md`'s own Error Propagation section already stated the rule
	// ("only valid in functions with `throws`"); the prose and the compiler had simply disagreed. It rides
	// E3059 through the existing free-form `errorTypeMismatch` arm rather than a new `ParseError` variant,
	// because it is the SAME fact that arm's four other messages carry: the error type does not fit where it
	// is going. A `none` enclosing clause is that mismatch at its limit — there is no there to fit into.
	function rejectPropagateAgainstEnclosing(func IrFunction, propagated String, tryTok Token) throws ParseError
		match func.throwsTypeName 'enclosing'
			none then throw ParseError.errorTypeMismatch("try propagates '{propagated}' but the enclosing function declares no 'throws' — the error has nowhere to go and would be dropped; add 'otherwise' to handle it, or declare 'throws {propagated}'", line: tryTok.line, column: tryTok.column)
			throwing(enclosing) then try self.rejectIfDifferentThrows(propagated, enclosing: enclosing, tryTok: tryTok)
		end 'enclosing'
	end 'rejectPropagateAgainstEnclosing'

	function rejectIfDifferentThrows(propagated String, enclosing String, tryTok Token) throws ParseError
		if not propagated.equals(enclosing) 'mismatch'
			throw ParseError.propagateTypeMismatch(propagated, enclosing: enclosing, line: tryTok.line, column: tryTok.column)
		end 'mismatch'
	end 'rejectIfDifferentThrows'

	// The ERROR TYPE a `try` target throws — the second of the two questions the desugar asks its target, and
	// the one the two shapes answer differently: a NAMED callee is looked up in the whole-program signature
	// index; a WITNESS method carries its own clause, because no registry holds an interface method.
	function tryTargetThrows(target TryTarget) returns ThrowsClause
		return match target 'kind'
			named(callee) gives self.signatures.throwsOf(callee)
			witness(_, throwsClause) gives throwsClause
		end 'kind'
	end 'tryTargetThrows'

	function tryErrorEnumType(throwsClause ThrowsClause) returns MaxonType
		return match throwsClause 'k'
			none gives MaxonType.integer
			throwing(name) gives MaxonType.named(self.artifact.typeNames.intern(name.toByteArray()))
		end 'k'
	end 'tryErrorEnumType'

	// ⭐ **IS THE THROWN/CAUGHT ERROR A BOXED (payload-bearing) UNION?** — the ONE fact the error-flag ABI
	// turns on, and the derive-once point for it. Read at BOTH ends so the flag round-trips: the throw
	// ENCODE (`emitThrowError`, which stamps it on the `throwError` op for `lowerThrowError` to write the box
	// pointer verbatim) and the catch DECODE (`parseOtherwiseBlock`, which binds `e` to that pointer
	// verbatim). Both funnel through the one `enumOf(name).isBoxed()` here, so a boxed union cannot be
	// encoded as a pointer at one end and decoded as an `ordinal + bias` at the other. A SCALAR enum and a
	// non-`named` type are `false` — their flag is `ordinal + ErrorFlagOrdinalBias`.
	function throwsTypeIsBoxedUnion(errorType MaxonType) returns bool
		if maxonTypeTag(errorType) != ValueTypeTag.named 'notNamed'
			return false
		end 'notNamed'
		let name = try self.artifact.typeNames.nameOf(typeNameIdOf(errorType)) otherwise return false
		return match self.signatures.enumOf(name) 'e'
			declared(layout) gives layout.isBoxed()
			undeclared gives false
		end 'e'
	end 'throwsTypeIsBoxedUnion'

	// Does SOME file declare `callee`? The whole-program signature index answers before any file is
	// parsed. Used to keep the E3055 (`try` on a non-throwing call) check off an UNDECLARED callee, whose
	// real defect is E3004 (unknown function), reported by SemanticCheck against the merged registry.
	function calleeIsDeclared(callee ByteArray) returns bool
		return match self.signatures.returnTypeOf(callee, into: self.artifact.typeNames) 'r'
			declared gives true
			undeclared gives false
		end 'r'
	end 'calleeIsDeclared'

	// Emit a `__mm_decref` for every owned binding above `floor`, in REVERSE declaration order.
	//
	// ONE routine serves the two kinds of exit that release owned bindings, differing only in how far
	// down the stack they release: a FUNCTION exit (`return`, an implicit void end) drops the WHOLE
	// in-scope list (`WholeFunctionScopeFloor`), while a nested BLOCK's fall-through and a
	// `break`/`continue` drop only what the block or loop itself declared (their recorded height),
	// leaving the outer bindings for their own scope to release. The floor is the single fact that
	// tells the two apart, so the reverse-order decref loop lives here and cannot drift between them.
	//
	// Reverse, because that is the order ownership is conventionally released in — the last thing
	// built is the first torn down — and because a later binding may (once struct fields land) hold
	// a reference INTO an earlier one, so releasing the outer first would be releasing the thing
	// still being pointed at. Nothing at this rung can tell the two orders apart; the convention
	// costs nothing and is the one that stays right.
	//
	// `anchor` is the token of the statement that made control leave the scope (the `return`, the
	// block's `end`, the `break`/`continue`): no source token spawns a drop, and that statement is
	// where a reader looks for what happened to the values in it.
	function emitScopeDrops(floor BindingMark, anchor Token)
		var i = self.ownedBindings.count()
		while i > floor 'eachOwned'
			i = i - 1
			let binding = try self.ownedBindings.get(i) otherwise panic("emitScopeDrops: ownedBindings.get OOB at {i} — the list is only appended to and drained at a block's end")
			// ⭐ **DROP-SKIP FOR A MOVED-FROM BINDING.** Its owned value was transferred to another
			// binding by a `let u = t` / `s = t`, which now owns and drops it — decref-ing it here too
			// would double-free (the exact bug #41 filed for `s = t`). The moved-from binding stays in
			// the list (removal would desync the block/loop drop marks), so the SKIP is what makes a
			// moved-out value drop exactly once. This one guard serves every exit that funnels through
			// here — `return`, a block fall-through, a `break`/`continue`.
			if not binding.movedFrom 'liveOwner'
				self.emitDecref(binding.boundValue, range: SourceRange.ofToken(anchor))
			end 'liveOwner'
		end 'eachOwned'
	end 'emitScopeDrops'

	// Emit a single drop — the one shape a dropped owned heap value releases through, shared by every drop
	// site: `emitScopeDrops` (a binding at scope exit), `drainPendingTemps` (an unconsumed temporary at
	// statement end), and `emitStringInterp` (its consumed scratch buffers). One door, so the drop's op
	// shape lives in ONE place and cannot drift across the callers. The result is `void` because a decref
	// returns nothing — the tag `ValueTypeTag.void` exists for exactly this, a ValueId the op shape demands
	// and no rule may ever be asked about.
	//
	// ⭐ **THE DROP DISPATCH, DONE STATICALLY** — the parser knows the type at every drop, so there is no
	// stored destructor pointer and no `callIndirect` (`StringRuntime.buildStrDecref` has the full why).
	function emitDecref(value ValueId, range SourceRange)
		let callee = self.decrefCalleeFor(value)
		_ = self.emitRuntimeCall(callee, args: singletonArgs(value), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
	end 'emitDecref'

	// ⭐ **PATH-SENSITIVE MOVE STATE — CAPTURE.** Snapshot the `movedFrom` bit (and current value) of every
	// owned binding in scope, so a branch's moves can be UNDONE for a sibling path (`restoreMoveMark`) or
	// reconciled at a join (`reconcileMovesAtMerge`). The twin of `snapshotBindings` for the drop-gating
	// bit. Positional over `ownedBindings`; see `MoveMark` for why only `movedFrom` rides and why the
	// height is stable at every capture point.
	function captureMoveMark() returns MoveMark
		var moved = BoolArray.create()
		var values = ValueIdArray.create()
		for binding in self.ownedBindings 'each'
			moved.push(binding.movedFrom)
			values.push(binding.boundValue)
		end 'each'
		return MoveMark.create(moved, values: values)
	end 'captureMoveMark'

	// ⭐ **PATH-SENSITIVE MOVE STATE — RESTORE.** Rewind every owned binding's `movedFrom` bit to a
	// captured mark, undoing the moves a sibling branch made so the next path is parsed against the
	// pre-branch ownership state (the twin of `restoreBindings`). Written THROUGH the shared `VarInfo`
	// reference, so every holder observes it. The owned height must match the capture — a branch's own
	// owned bindings were popped before this runs (see `MoveMark`), so a mismatch is a lockstep break.
	function restoreMoveMark(mark MoveMark)
		if self.ownedBindings.count() != mark.moved.count() 'drifted'
			panic("restoreMoveMark: owned-binding height {self.ownedBindings.count()} differs from the captured mark's {mark.moved.count()} — a branch's owned bindings must be popped before its move state is restored")
		end 'drifted'
		var i = 0
		while i < self.ownedBindings.count() 'each'
			var binding = try self.ownedBindings.get(i) otherwise panic("restoreMoveMark: ownedBindings.get OOB at {i}")
			binding.movedFrom = try mark.moved.get(i) otherwise panic("restoreMoveMark: mark.moved.get OOB at {i}")
			i = i + 1
		end 'each'
	end 'restoreMoveMark'

	// ⭐⭐ **PATH-SENSITIVE MOVE STATE — RECONCILE AT A JOIN.** Given the edges that REACH a merge (each an
	// already-live predecessor block paired with the move state it carries), settle every owned binding to
	// a UNIFORM post-merge state so the later scope-exit drop is correct on every path:
	//   • moved on SOME edges, live on OTHERS ⇒ the value was given away on the moved edges but is still
	//     owned on the live ones. Emit its drop on each LIVE edge (using that edge's own value), and mark
	//     the binding moved after the merge — settled on every path, so the scope-exit drop skips it.
	//   • moved on ALL edges ⇒ already given away everywhere; mark moved, drop nothing.
	//   • live on ALL edges ⇒ still owned everywhere; mark live, drop nothing — the scope exit drops it.
	// A binding moved before the whole construct is moved on every reaching edge (the flag is monotonic
	// within a path), so it stays moved; a binding no branch touched is live on every edge and stays live.
	// The reaching edges are UNTERMINATED blocks (a terminated branch dropped its own values and
	// contributes no edge), so a decref appended to one lands before the merge branch the caller emits
	// next. Called only with at least one reaching edge — an all-terminating construct has a dead merge and
	// leaves the move state alone.
	function reconcileMovesAtMerge(edges ReachingMoveEdgeArray, anchor Token)
		// The caller must pass at least one reaching edge — an all-terminating construct has a dead merge and
		// must NOT call this at all. With no edges every binding would read `anyMoved == false` and be marked
		// live, silently clobbering an already-moved binding's state (a mass-leak footgun on the most delicate
		// path). Enforced loudly rather than trusted, since a wrong move state here is a leak or a double-free.
		if edges.count() == 0 'noEdges'
			panic("reconcileMovesAtMerge: called with no reaching edges — an all-terminating construct has a dead merge and must leave the move state alone rather than reconcile it")
		end 'noEdges'

		let n = self.ownedBindings.count()
		for edge in edges 'checkAligned'
			if edge.mark.moved.count() != n 'drifted'
				panic("reconcileMovesAtMerge: a reaching edge's mark holds {edge.mark.moved.count()} entries but {n} owned bindings are in scope — the marks drifted out of lockstep with the owned-binding stack")
			end 'drifted'
		end 'checkAligned'

		var i = 0
		while i < n 'eachBinding'
			var anyMoved = false
			var anyLive = false
			for edge in edges 'scan'
				let movedHere = try edge.mark.moved.get(i) otherwise panic("reconcileMovesAtMerge: edge mark moved.get OOB at {i}")
				if movedHere 'movedHere'
					anyMoved = true
				end 'movedHere' else 'liveHere'
					anyLive = true
				end 'liveHere'
			end 'scan'

			if anyMoved and anyLive 'mixed'
				let saved = self.currentBlock
				for edge in edges 'dropLive'
					let movedOnEdge = try edge.mark.moved.get(i) otherwise panic("reconcileMovesAtMerge: edge mark moved.get OOB at {i}")
					if not movedOnEdge 'liveEdge'
						self.currentBlock = edge.block
						let liveValue = try edge.mark.values.get(i) otherwise panic("reconcileMovesAtMerge: edge mark values.get OOB at {i}")
						self.emitDecref(liveValue, range: SourceRange.ofToken(anchor))
					end 'liveEdge'
				end 'dropLive'
				self.currentBlock = saved
			end 'mixed'

			var binding = try self.ownedBindings.get(i) otherwise panic("reconcileMovesAtMerge: ownedBindings.get OOB at {i}")
			binding.movedFrom = anyMoved
			i = i + 1
		end 'eachBinding'
	end 'reconcileMovesAtMerge'

	// ⭐ **WHICH RUNTIME ENTRY DROPS `value`** — one tag-and-type router, extended per managed kind (Wave
	// D's ruling generalised):
	//   • a STRING (`__str_decref`) frees its record AND the external buffer a grown String leaves behind
	//     (`parent@32`/`buffer@0`), which the generic decref structurally cannot reach;
	//   • a STRUCT box that owns a managed field (`__destruct_<Struct>`) drops each managed field through ITS
	//     own destructor, then frees the box — because the generic decref would leak them (P1.4a wave 2);
	//   • a MANAGED-PAYLOAD union box (`__destruct_<U>`) runs its own tag-conditional cascade — drop each
	//     live managed field through ITS own destructor, then free the box — because a union box carries
	//     owned payloads the generic decref would leak;
	//   • everything else (a SCALAR union box, a struct box whose fields are all scalars, a raw interpolation
	//     buffer) is the generic refcounted `__mm_decref` — its `TrivialDestructor` frees exactly the box.
	// A struct/union routed to a cascade is decided off `managedFieldDropCallee` / `unionBoxDropCallee`,
	// which wrap the SAME predicates the destructor synthesis (and `noteDestructorUsage`) emit from, so a
	// box routed to a cascade here always has one built for it.
	function decrefCalleeFor(value ValueId) returns ByteArray
		// ⭐ **A PROMISE IS A GREEN-THREAD HANDLE, NOT A REFCOUNTED HEAP BOX (P1.5-B2 #88).** An un-awaited
		// `async` spawn dropped at scope exit / a re-arm routes to `__gt_promise_drop`, which reclaims AND
		// cancels the thread — NOT `__mm_decref` (a promise owns no `__mm_alloc` box; the handle is the GT
		// struct pointer). Checked FIRST, off the promise mark column, because a promise's TAG is `integer`
		// (its awaited scalar type), so the tag-based routing below cannot tell it from a bare int.
		if self.valueIsPromise(value) 'promise'
			return GtPromiseDropName
		end 'promise'
		let tag = self.tagOf(value)
		if tag == ValueTypeTag.string 'string'
			return StrDecrefName
		end 'string'
		// ⭐ AN OPAQUE TYPE-PARAMETER binding (`push(item Element)`'s `item`, enrolled owned in a shared generic
		// body, P1.7 slice 3b-v). Its element destructor is not known statically — the body compiles ONCE for
		// every instantiation — so it drops through `__drop_type_param(descriptor, value)`, which reads the
		// enclosing instance's layout descriptor `destroyFunc@40` at run time (0 for a trivial instantiation →
		// inert). `lowerRuntimeCall` prepends the descriptor argument, the drop twin of the opaque array create.
		if tag == ValueTypeTag.typeParameter 'opaque'
			return DropTypeParamName
		end 'opaque'
		// A struct box: `managedFieldDropCallee` returns `__destruct_<Struct>` for one that owns a managed
		// field and the trivial `__mm_decref` otherwise, reading only allocation-free `Map.contains` /
		// per-field checks (no throwaway box), so it needs no hot-path guard of its own.
		if tagIsStructRef(tag) 'struct'
			return managedFieldDropCallee(self.signatures, typeNames: self.artifact.typeNames, fieldType: self.typeOf(value))
		end 'struct'
		// ⭐ A GENERIC-INSTANCE box (`Box with String`, P1.6-B2) drops through its own `__destruct_<mangled>`
		// cascade when the instance owns managed heap, else the trivial `__mm_decref`. The gid is on the value's
		// name column (the same access `materializeLayoutArg` reads at lowering); the drop callee is decided
		// INSIDE `ProgramSignatures` over the instance's own registry/interner — a trivial instance (`IntBox`)
		// answers `__mm_decref`, byte-identical to the pre-B2 fall-through, so existing goldens do not move.
		if tag == ValueTypeTag.genericInstance 'instance'
			return self.signatures.genericInstanceBoxDropCallee(self.valueNameId(value))
		end 'instance'
		// ⚠ **THE `named` PRE-CHECK IS A HOT-PATH ALLOCATION GUARD, NOT A TIDY EARLY RETURN** — the exact
		// one `valueIsUnion` documents. This runs for EVERY dropped owned value (an interpolation buffer),
		// and `enumMatchFor` returns a `DeclaredEnum` — a heap-boxed Maxon union VALUE even for its
		// `undeclared` case. Only a `named`-tagged value can be a union box; an interp buffer is `integer`,
		// so gating here is what keeps a String/interp drop from boxing a throwaway `DeclaredEnum.undeclared`
		// (measured on scale-test: the whole `allocsDelta` this rung added collapses to 0 with this guard).
		if tag != ValueTypeTag.named 'notUnion'
			return MmDecrefName
		end 'notUnion'
		let decl = self.enumMatchFor(value)
		if enumMatchIsDeclared(decl) 'union'
			// The drop callee is decided INSIDE `ProgramSignatures`, over the layout's own interner —
			// NOT here with `self.artifact.typeNames`. A signatures layout's payload ids live in the
			// signatures interner, and resolving them against this file's interner misread a managed
			// payload whenever a ranged alias shifted the interning order (a leak / wild-free, OPEN #52).
			return self.signatures.unionBoxDropCallee(requireEnumLayout(decl))
		end 'union'
		// A `named` value that is not a declared union is a declared STRUCT read from a FIELD: a struct
		// field's value carries `named`, not `structRef` (`fieldTypeOf` re-tags only function/generic-alias
		// fields), so the OLD value dropped on `h.n = …` arrives here. Route it through the SAME
		// `managedFieldDropCallee` the `structRef` arm and the destructor synthesis use, so a MANAGED-owning
		// struct drops through its `__destruct_<T>` cascade — the trivial `MmDecrefName` frees only the box
		// and LEAKS its managed fields (exit 101). A trivial struct answers `MmDecrefName` there too
		// (byte-identical), so only the managed case changes. The `containsStruct` gate keeps a `named` that
		// names no declared struct (a ranged typealias) on the trivial path, where `managedFieldDropCallee`
		// would otherwise panic (it classifies only struct/union/generic-alias fields).
		let name = try self.artifact.typeNames.nameOf(self.valueNameId(value)) otherwise panic("decrefCalleeFor: a `named` value's type-name id is not in this file's interner — every `named` tag is minted with an id from it")
		if self.signatures.containsStruct(name) 'struct'
			return managedFieldDropCallee(self.signatures, typeNames: self.artifact.typeNames, fieldType: self.typeOf(value))
		end 'struct'
		return MmDecrefName
	end 'decrefCalleeFor'

	// ⭐ **CALL AN EMITTED RUNTIME ENTRY POINT** (`__mm_alloc`, `__mm_decref`) — the door the parser
	// reaches the heap through, and the only one.
	//
	// It is NOT `emitCall`, and the difference is what a runtime call IS: `emitCall` types its
	// result from the whole-program signature index and slots its arguments against a declaration.
	// The runtime has neither — it is built at the STD tier, after lowering (`installMmRuntime`),
	// so no file declares it, `mintCallResult` would type it `unresolved` (a tag that PANICS at
	// lowering), and `SemanticCheck` would report E3004 against a name the user never wrote.
	// `isRuntimeCallee` is what tells the two apart, and it is one predicate read by the three
	// places that care (here, `validateCall`, `lowerCall`).
	//
	// So the caller states the result's type, because the caller is the compiler and it KNOWS: an
	// `__mm_alloc` returns the struct it just built, a `__mm_decref` returns nothing.
	//
	// ⚠ **EVERY ARGUMENT IS POSITIONAL, IN DECLARATION ORDER.** There is no label to reorder by —
	// the runtime has no parameter names for a label to match — so `lowerCall` passes them straight
	// through. `emptyArgLabels` is what says so on the op, and `lowerCall`'s guard is what makes a
	// future labelled runtime call fail loudly rather than mis-slot.
	function emitRuntimeCall(callee ByteArray, args ValueIdArray, resultTag ValueTypeTag, resultNameId TypeNameId, range SourceRange) returns ValueId
		let result = self.mintValue(resultTag, nameId: resultNameId)
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.call(result, callee: callee, args: args, argLabels: emptyArgLabels(args), argRanges: uniformArgRanges(args, range: range), argImmutableNames: NoImmutableArgNames), range: range)
		return result
	end 'emitRuntimeCall'

	// ⭐ **EMIT A VOID `__mm_incref` OF `value`** — the one spelling of "take a second owner of this box,
	// discarding the returned nothing". Single-sources the three sites that incref a managed box in place:
	// `retainThrownField` (#64 — a thrown borrowed-container field) and the two `try … otherwise` phi
	// reconciliations (the ok-edge borrow that merges with an owned fallback, and `transferFallbackToPhi`'s
	// aliased-binding error edge). `__mm_retain` is the RETURNING twin (`retainBorrowedAggregate`) for when a
	// FRESH SSA name is needed; this void form is for when the box is increfed in place and the caller already
	// holds the ValueId it means.
	function emitIncref(value ValueId, range SourceRange)
		_ = self.emitRuntimeCall(MmIncrefName, args: singletonArgs(value), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
	end 'emitIncref'

	// ⭐ **THE ONE `__mm_alloc` CALL.** Every heap box the compiler builds — a struct record, a fused
	// String record, an interpolation scratch buffer, a boxed union — is allocated through here, so the
	// `__mm_alloc(size, destructor)` ABI lives in exactly ONE place: the destructor is the SECOND
	// argument, and a box whose contents cascade to nothing passes `TrivialDestructor`. An added or
	// reordered alloc argument that reached three of those call sites and missed the fourth would
	// corrupt that box silently — nothing but this consolidation forces the four to agree. `size` is an
	// already-emitted value (a size literal, or the interpolation length sum), so the caller decides how
	// it is computed; and enrolling the result as an owned temp is the caller's decision too (a struct
	// box is not tracked, a union and an interpolation String are), so `trackOwnedTemp` stays at the
	// call site rather than hiding in here.
	function emitBoxAlloc(size ValueId, resultTag ValueTypeTag, resultNameId TypeNameId, range SourceRange) returns ValueId
		let destructor = self.emitLiteral(TrivialDestructor, valueType: MaxonType.integer, range: range)
		var allocArgs = ValueIdArray.create()
		allocArgs.push(size)
		allocArgs.push(destructor)
		return self.emitRuntimeCall(MmAllocName, args: allocArgs, resultTag: resultTag, resultNameId: resultNameId, range: range)
	end 'emitBoxAlloc'

	// ⭐ **TRACK A FRESH OWNED HEAP TEMPORARY.** The one door `emitStringInterp` reaches ownership through:
	// it records the value's provenance (so `parseBinding` knows the binding owns a drop) AND enrolls it in
	// the statement's pending-drop list (so an UNBOUND result is dropped at statement end). Both from one
	// call, so the two facts — "this value owns heap" and "someone must drop it" — cannot be set apart.
	function trackOwnedTemp(value ValueId)
		self.markValueOwnsHeap(value)
		self.pendingTempDrops.push(value)
	end 'trackOwnedTemp'

	// Set `value`'s owned-heap provenance bit WITHOUT enrolling it as a statement-scoped pending temporary
	// — the half of `trackOwnedTemp` a CONSUMED PARAMETER needs (P1.4a wave 2). The param already drops at
	// FUNCTION scope exit through `ownedBindings` (or is skipped once moved into a field), so adding it to
	// `pendingTempDrops` too would drop it a SECOND time at the enclosing statement's end — the double-free
	// that made `Outer.create(inner)` free its own field. A temporary, by contrast, IS statement-scoped and
	// wants both.
	function markValueOwnsHeap(value ValueId)
		try self.valueOwnsHeap.set(value, value: true) otherwise panic("markValueOwnsHeap: v{value} has no owned-heap slot — every SSA value must be minted through mintValue, which seeds the column")
	end 'markValueOwnsHeap'

	// Mark `value` as an `async` spawn's promise handle (P1.5-B1a), and read that mark back. `await` uses the
	// read to reject a non-promise operand and to know it may unwrap the handle to its awaited scalar.
	function markValuePromise(value ValueId)
		try self.valuePromiseMarks.set(value, value: true) otherwise panic("markValuePromise: v{value} has no promise slot — every SSA value must be minted through mintValue, which seeds the column")
	end 'markValuePromise'

	function valueIsPromise(value ValueId) returns bool
		return try self.valuePromiseMarks.get(value) otherwise panic("valueIsPromise: v{value} has no promise slot — every SSA value must be minted through mintValue, which seeds the column")
	end 'valueIsPromise'

	// ⭐ **THE ONE DEFINITION OF "OWNED": does `value` own a droppable heap allocation it must transfer or
	// drop?** The single predicate the DECLARATION (`parseBinding`), the REASSIGNMENT
	// (`reassignBindingValue`), the RETURN move-out, and the match `gives` transfer all ask, so none of
	// them can drift on what enrols a binding in `ownedBindings`. It is PROVENANCE, never the type tag —
	// see `valueOwnsHeap`'s header for why the tag cannot answer:
	//
	//   • a String's tag conflates an owned heap copy with a borrowed immortal rdata literal;
	//   • a struct/boxed-union tag (`structRef`/`named`) conflates a fresh OWNED box with a BORROWED
	//     PARAMETER — a struct param is `structRef` and a union param `named`, and neither owns anything.
	//     A borrowed aggregate treated as owned would make `let q = a` (re-borrow of a struct param) move
	//     ownership out of a borrow and free it twice — the cross-call double-free this rung exists to
	//     avoid. The bit says NO for a param (`bindParameters` never sets it) and YES for every owned box.
	//
	// So the bit is the whole answer, uniformly across String / struct / union: it is set at every owned
	// heap PRODUCER (`trackOwnedTemp` — an interpolation, a promotion, a struct literal, a boxed-union
	// construct, an owned call result, a managed payload moved out of an owned union) and nowhere else. An
	// O(1) column read, seeded `false` by `mintValue`/`recordValueType`. The day a third owned heap kind
	// (an owned array) lands, its producer calls `trackOwnedTemp` and this answers for it too — no arm to
	// add, because the bit already means exactly "owns droppable heap".
	function valueIsOwnedHeap(value ValueId) returns bool
		return try self.valueOwnsHeap.get(value) otherwise panic("valueIsOwnedHeap: v{value} has no owned-heap slot — every SSA value must be minted through mintValue, which seeds the column")
	end 'valueIsOwnedHeap'

	// ⭐ **IS `value` AN ENROLLED OPAQUE OWNED type-parameter binding (P1.7 slice 3b-v)?** A consumed opaque
	// ARRAY-feed parameter, enrolled owned in a shared generic body (`bindParameters`): its `typeParameter`
	// tag is opaque (the shared body has no static type) yet it owns heap for a managed instantiation. THE one
	// predicate the forward-consume GATE (`isOpaqueOwnedFeedArg`) and the forward TRANSFER
	// (`transferConsumedArg`'s opaque arm) both read, so the "what is an opaque owned value" question is
	// answered once and the two cannot drift into moving different things (a wrong-consume double-free).
	function valueIsOpaqueOwned(value ValueId) returns bool
		return self.tagOf(value) == ValueTypeTag.typeParameter and self.valueIsOwnedHeap(value)
	end 'valueIsOpaqueOwned'

	// ⭐ **RECORD THAT `closureValue` IS A CAPTURING CLOSURE carrying `env` (P1.5-A2b).** The two facts move
	// together — a value is a capturing closure IFF it has an env — so one door sets both columns and they
	// cannot drift. Read back by `isCapturingClosure` (the escape checks) and `closureEnvOf` (the call
	// threading).
	function markCapturingClosure(closureValue ValueId, env ValueId)
		try self.valueIsCapturingClosure.set(closureValue, value: true) otherwise panic("markCapturingClosure: v{closureValue} has no closure-mark slot — every SSA value is minted through mintValue, which seeds the column")
		try self.valueClosureEnv.set(closureValue, value: env) otherwise panic("markCapturingClosure: v{closureValue} has no closure-env slot — the two closure columns are filled in lockstep")
	end 'markCapturingClosure'

	// Is `value` a closure that CAPTURES its enclosing frame? The escape checks (return / field / payload /
	// payload-binding) and the in-frame call threading both ask this ONE predicate, keyed on the VALUE — so
	// an unrelated binding of the same NAME in another function is never flagged (`-name-not-leaked`).
	function isCapturingClosure(value ValueId) returns bool
		return try self.valueIsCapturingClosure.get(value) otherwise panic("isCapturingClosure: v{value} has no closure-mark slot — every SSA value is minted through mintValue, which seeds the column")
	end 'isCapturingClosure'

	// The environment a function value carries, or 0 when it carries none. A real environment is ALWAYS a
	// minted value id (`>= 1` — a heap env block, a materialized companion-env parameter, or a const-0 op is
	// never id 0, which is the first parameter), so a stored 0 unambiguously means "no environment". Set for a
	// capturing closure literal (its heap block, `markCapturingClosure`) AND for a function-typed parameter
	// (its companion env parameter, `bindClosureEnvParams`) — the two producers of a value that travels with a
	// live environment under the uniform ABI.
	function closureEnvOf(value ValueId) returns ValueId
		return try self.valueClosureEnv.get(value) otherwise panic("closureEnvOf: v{value} has no closure-env slot — every SSA value is minted through mintValue, which seeds the column")
	end 'closureEnvOf'

	// Does function value `value` travel with a live environment (a capturing closure's heap block or a
	// function-typed parameter's companion env)? A plain function reference and a non-capturing closure carry
	// none — the uniform ABI passes a null in their place. Keyed on the VALUE through `valueClosureEnv`.
	function valueCarriesEnv(value ValueId) returns bool
		return self.closureEnvOf(value) != 0
	end 'valueCarriesEnv'

	// ⭐ **THE ENVIRONMENT ARGUMENT THREADED AT A CALL THROUGH A FUNCTION VALUE (P1.5-A2b-2).** Under the
	// uniform `(userargs, env)` ABI EVERY indirect call passes an environment: the value's OWN environment
	// when it carries one, else a materialized null. This is the ONE place that answers "what environment
	// travels with this value?" for an indirect call, keyed on the callee VALUE — the mirror of the direct
	// call's `closureEnvOf`-driven threading (`LowerMaxonToStd.appendCalleeEnvArgs`). A non-capturing value
	// gets a fresh `0` literal so the wasm `call_indirect` functype (arg-count-derived) still has its env slot.
	function emitClosureEnvArg(callee ValueId, range SourceRange) returns ValueId
		if self.valueCarriesEnv(callee) 'carriesEnv'
			return self.closureEnvOf(callee)
		end 'carriesEnv'
		return self.emitLiteral(0, valueType: MaxonType.integer, range: range)
	end 'emitClosureEnvArg'

	// ⭐ **REFUSE A CAPTURING CLOSURE THAT ESCAPES ITS FRAME (E3099).** The ONE gate every escape route funnels
	// through — a return, a struct-field store, a union payload, a payload-binding store — so the "is this a
	// capturing closure?" question is answered once (keyed on the VALUE), and only the route-specific message
	// and position differ at each site. A non-capturing closure and a plain function reference pass freely, so
	// this never fires for the values A2a already handles. In-frame USES (a call, a pass DOWN to a callee that
	// only calls it) are NOT stores and never reach here — over-rejecting them would be the worse failure.
	function rejectEscapingClosure(value ValueId, message String, tok Token) throws ParseError
		if self.isCapturingClosure(value) 'escapes'
			throw ParseError.capturingClosureEscapes(message, line: tok.line, column: tok.column)
		end 'escapes'
	end 'rejectEscapingClosure'

	// ⭐ **REFUSE A CAPTURING CLOSURE PASSED AS AN INDIRECT-CALL ARGUMENT (P1.5-A2b-2).** A capturing closure
	// handed DOWN to a DIRECT callee now works — the lowering threads its environment as the companion
	// argument at the function-typed parameter position (`LowerMaxonToStd.appendCalleeEnvArgs`). But an
	// INDIRECT call `f(g)` — where `f` is itself a function VALUE whose type takes a function parameter `g` —
	// has no resolved parameter types to drive that threading (a function TYPE carries none), so the closure's
	// environment would not reach `f`'s eventual callee: the higher-order function-VALUE case, which no case at
	// this rung reaches. Refused as UNSUPPORTED rather than compiled into a segfault, keyed on the VALUE
	// exactly as the escape gate is — a non-capturing closure or a plain function reference passes freely.
	function rejectCapturingClosureArg(value ValueId, tok Token) throws ParseError
		if self.isCapturingClosure(value) 'capturingArg'
			throw ParseError.unsupported("passing a closure that captures as an argument to an INDIRECT call — a function VALUE's type carries no parameter types, so the closure's environment cannot be threaded to its callee (a direct call to a named function threads it; a higher-order function value does not yet)", line: tok.line, column: tok.column)
		end 'capturingArg'
	end 'rejectCapturingClosureArg'

	// Ownership of `value` has been TRANSFERRED to a binding, so the statement no longer owes its drop:
	// remove it from the pending list. A filter-rebuild rather than a pop because, while the transferred
	// value is normally the last one pushed (a binding's initializer is the statement's final expression),
	// keying on identity rather than position is what stays correct if that ever stops holding.
	function removeFromPendingTemps(value ValueId)
		var kept = ValueIdArray.create()
		for pending in self.pendingTempDrops 'each'
			if pending != value 'notTransferred'
				kept.push(pending)
			end 'notTransferred'
		end 'each'
		self.pendingTempDrops = kept
	end 'removeFromPendingTemps'

	// Is `value` still an UNCONSUMED owned temporary — a value `trackOwnedTemp` enrolled and nothing has
	// transferred to a binding yet? The two owned-value homes are disjoint by construction (a transfer to a
	// binding `removeFromPendingTemps` first — `parseBinding`/`moveInPayload`/`moveOutManagedPayload`), so a
	// value in this list is exactly one owned by no binding. `parseMatchCommon` reads it to tell a
	// temporary scrutinee (which needs match-scoped enrollment) from an already-bound one (which does not).
	function pendingTempsContain(value ValueId) returns bool
		for pending in self.pendingTempDrops 'each'
			if pending == value 'found'
				return true
			end 'found'
		end 'each'
		return false
	end 'pendingTempsContain'

	// The value a binding holds has been MOVED OUT — a `return` hands its box to the caller — so the
	// binding must leave `ownedBindings`, else `emitScopeDrops` would decref a box the callee no longer
	// owns (a double-free with the caller's own drop). Keyed on the bound VALUE rather than on position:
	// a returned binding is rarely the last declared, so identity is what stays correct. A filter-rebuild,
	// the `removeFromPendingTemps` shape for the owned-BINDING list.
	function removeFromOwnedBindings(value ValueId)
		var kept = VarInfoArray.create()
		for binding in self.ownedBindings 'each'
			if binding.boundValue != value 'notMovedOut'
				kept.push(binding)
			end 'notMovedOut'
		end 'each'
		self.ownedBindings = kept
	end 'removeFromOwnedBindings'

	// ⭐ **THE OWNED-VALUE CLEANUP A `return <value>` AND A `throw <value>` SHARE** — the two exits that
	// HAND a heap value to the caller. Both must, in this exact order, drop every owned value this function
	// still holds EXCEPT the one in flight, then let the caller emit its own terminator (`ret` / `throwError`):
	//
	//   • MOVE the handed-off value out of the local drop sets — it leaves BOTH the pending-temp list (a
	//     freshly built `return U.case(x)` / `throw U.case(x)` temporary) and the owned-binding list (a
	//     `return t` / re-thrown `throw e` caught binding), one call each, both no-ops on the other's case —
	//     so the caller becomes its sole owner and neither drop below frees it. A no-op for a scalar.
	//   • DROP the exit expression's leftover TEMPORARIES: `return wrap("v{x}")` / `throw E.p(len("v{x}"))`
	//     build an interpolation this statement owns but does NOT hand back. The `count() > 0` guard is
	//     `drainPendingTemps`' own — almost no exit leaves a temporary, so the common exit pays nothing.
	//   • DROP every owned BINDING in scope (`emitScopeDrops`).
	//   • RESTORE the owned-binding list past those drops: it OUTLIVES this exit, and a SIBLING exit edge of
	//     an enclosing block still owns the handed-off binding on ITS runtime path (this exit terminated only
	//     its own), so `removeFromOwnedBindings`' NEW array leaves the original for those edges.
	//
	// The drops land AFTER the caller computed the handed-off value (already a register read, no longer a
	// heap access) and BEFORE the caller's terminator (a `ret`/`throwError` ENDS the block — anything after
	// it sits on a path control has left, and the value leaks: exit 101). Factoring the WHOLE sequence, not
	// just the move-out, is what keeps the two exits from drifting on it: a `throw` that drained its bindings
	// but not its temporaries leaked exactly one interpolation buffer until this became one path.
	function emitHandoffExitDrops(handedOff ValueId, anchor Token)
		let savedOwnedBindings = self.ownedBindings
		if self.valueIsOwnedHeap(handedOff) 'movedOut'
			self.removeFromOwnedBindings(handedOff)
			self.removeFromPendingTemps(handedOff)
		end 'movedOut'

		if self.pendingTempDrops.count() > 0 'dropExitTemps'
			self.drainPendingTemps(WholeStatementTempFloor, anchor: anchor)
		end 'dropExitTemps'

		self.emitScopeDrops(WholeFunctionScopeFloor, anchor: anchor)
		self.ownedBindings = savedOwnedBindings
	end 'emitHandoffExitDrops'

	// Does `binding` currently owe a scope-exit drop — i.e. is it a LIVE owner in `ownedBindings`? The
	// reassignment path's test for whether the value being OVERWRITTEN is owned. It reads MEMBERSHIP,
	// not `valueIsOwnedHeap(binding.boundValue)`, and that distinction is the whole point: a
	// loop-carried `var`'s current value is a header phi with no owned-heap provenance, so the value
	// column would answer `false` for a binding the loop owns (see `reassignBindingValue`). Membership
	// survives the phi; the provenance bit does not.
	//
	// Keyed on `boundValue`, the `removeFromOwnedBindings` idiom — an owned heap value has a single LIVE
	// owner, so at most one non-moved owned binding holds any given value. `movedFrom` GHOSTS are
	// skipped: a moved-from binding stays in the list but shares its stale value with the binding it
	// moved to, so counting it would report two owners of one value. An O(ownedBindings) scan; a
	// reassignment is not a hot path.
	function bindingIsOwned(binding VarInfo) returns bool
		for owned in self.ownedBindings 'each'
			if self.isLiveOwnerOf(owned, value: binding.boundValue) 'match'
				return true
			end 'match'
		end 'each'
		return false
	end 'bindingIsOwned'

	// ⭐ **WHAT MAKES AN OWNED-SET ENTRY THE ONE LIVE OWNER OF `value`**: it holds that value AND has not
	// itself been moved from. Single-homed on purpose — the `valueIsOwnedHeap` pattern. `bindingIsOwned`
	// (does this binding still owe a drop?) and `poisonMoveSource` (which binding does a move poison?)
	// both need exactly this predicate, and if it drifted between the two — a new ownership flag taught
	// to one scan and not the other — one would count a `movedFrom` ghost as a live owner: a double-free
	// or a wrongly-skipped drop, and invisible at either call site read alone. The GHOST skip is the
	// load-bearing half: a moved-from binding shares its stale `boundValue` with the binding it moved to,
	// so a value has exactly one owner only once the flag is checked.
	function isLiveOwnerOf(owned VarInfo, value ValueId) returns bool
		return not owned.movedFrom and owned.boundValue == value
	end 'isLiveOwnerOf'

	// True iff the RHS just parsed — the tokens in `[startPos, self.pos)` — RESOLVES TO a bare reference
	// to a LOCAL binding (`let u = t` / `s = t`, and equally `let u = (t)`). That is the ONLY RHS shape
	// that can MOVE an owned value out of an existing binding: it resolves to that binding's own SSA
	// value (`parseVariableReference` returns `binding.boundValue`), so `poisonMoveSource`'s value-keyed
	// scan can match it. Every other RHS — a call, an interpolation, a field read, any arithmetic —
	// mints a FRESH temp that is the value of no binding (a CONSUME), so the scan is guaranteed to find
	// nothing.
	//
	// ⚠ **REDUNDANT PARENS ARE STRIPPED FIRST, and that is a soundness requirement, not tidiness.**
	// `parseParenthesizedExpression` returns its inner value UNCHANGED, so `(t)` / `((t))` alias the
	// same owned box a bare `t` does. A token-count-only gate (`self.pos == startPos + 1`) called them
	// non-bare-local, so the poison never ran, both bindings dropped the one box, and the #41
	// double-free returned. Stripping the outer parens makes the gate a SOUND over-approximation: it can
	// only ever add moves, never miss one. (The identical 4-line strip lives in `shiftCountAnchor`; see
	// the note there for why it is deliberately inlined at both sites rather than shared through a
	// tuple-returning helper that would heap-allocate on this per-bind/assign path.)
	//
	// ⭐ **A GATE, NOT THE DECISION.** `poisonMoveSource` keeps the authority — given a bare-local RHS it
	// still matches the value against the owned set, so a bare local that is NOT owned (a scalar) still
	// poisons nothing. This only decides whether calling the scan can possibly do anything, so the
	// common case — every consume `let u = build()` — skips the O(ownedBindings) scan the poison used to
	// run on EVERY owned bind and reassignment. Skipping it when this is false is a proven no-op, not a
	// behaviour change: the scan could not have matched a non-bare-local RHS anyway.
	//
	// The single consumed identifier is excluded when it names a top-level binding (`scope.contains`
	// false) or a self-field alias (`isSelfField`, whose read mints a fresh load rather than aliasing a
	// binding's value) — neither is a live owned local the scan would match. Those are the same two
	// conditions `parseVariableReference` treats as a bare LOCAL read, so the gate cannot diverge from
	// what actually resolves to a binding's `boundValue` — parens included, since a parenthesized read
	// resolves through the very same `parseVariableReference`.
	function rhsWasBareLocalReference(startPos TokenIndex) returns bool
		var lo = startPos
		var hi = self.pos
		while lo + 2 <= hi and self.kindAt(lo) == TokenKind.leftParen and self.kindAt(hi - 1) == TokenKind.rightParen 'stripParens'
			lo = lo + 1
			hi = hi - 1
		end 'stripParens'

		if hi != lo + 1 'notSingleToken'
			return false
		end 'notSingleToken'

		let tok = self.tokenAt(lo)
		if tok.kind != TokenKind.identifier 'notIdentifier'
			return false
		end 'notIdentifier'

		return self.scope.contains(tok.value) and not self.scope.isSelfField(tok.value)
	end 'rhsWasBareLocalReference'

	// ⭐ **MOVE THE VALUE OUT OF ITS CURRENT OWNER.** If `value` is the current value of a LIVE owned
	// binding — i.e. the RHS of a bind/assign was a bare reference to that binding (`let u = t`) — mark
	// that source `movedFrom`, so a later read of it is use-after-move (E3102) and `emitScopeDrops`
	// skips its drop (only the new owner drops the value). A fresh owned temp (`build()`, `"{x}"`) is
	// the value of no binding, so nothing is poisoned — that is a CONSUME (move-in), not a
	// source-poisoning move.
	//
	// Finds the ONE live owner via `isLiveOwnerOf` (the same predicate `bindingIsOwned` reads), so a
	// value already moved once — a `movedFrom` ghost — can never be picked as a live source. An
	// O(ownedBindings) scan. **The callers GATE it on `rhsWasBareLocalReference`**, so it runs only when
	// the RHS actually was a bare local reference — never on a consume, which is what kept it off the hot
	// path of every owned bind (the scan-and-find-nothing that made accumulating N owned bindings O(N²)).
	//
	// ⚠ **A MOVE OF A BINDING DECLARED OUTSIDE THE INNERMOST LOOP IS REJECTED HERE** (`anchor` positions the
	// diagnostic). The path-sensitive drop reconciliation (`reconcileMovesAtMerge`) settles an `if`/`match`
	// join, but a LOOP has two exits the join model does not reach: the back edge (which would re-move the
	// binding on the next iteration — a double-free) and a `break` (which leaves the binding live on the
	// normal exit while giving it away on the break edge — a leak or, once the join restores the sibling
	// path, a double-free). Placing the compensating drop on those edges needs elaboration across the loop
	// boundary, a later wave; until then a move that escapes the innermost loop is refused rather than
	// miscompiled. A binding declared INSIDE the loop body (index at or above the loop's owned floor) is
	// reconciled within the body, once per iteration, and is unaffected.
	// ⭐ **`await`/`try await` CONSUMES a promise's green thread (P1.5-B2 #88) — the DUAL of the E3100 linear-
	// await check.** The runtime driver (`__gt_await`/`__gt_try_await`) reclaims the GT struct AT the await, so
	// the thread must NOT also be dropped at scope exit — mark its owning binding `movedFrom` (the scope-exit
	// drop then skips it, exactly as an owned box moved by `let u = t` is skipped), and clear it from the
	// pending-temp list (an UNBOUND awaited spawn, `await async f()`). Keyed on the thread's ValueId — its
	// identity — so awaiting through ANY alias consumes the one thread (`let q = p; await q` consumes `p`'s
	// thread). An unbound-and-unowned promise has no owner to mark, so the scan quietly finds nothing, which is
	// correct — the pending-temp clear is all it needs. Unlike `poisonMoveSource`, it does NOT reject a move
	// that escapes a loop: a promise spawned outside a loop and awaited inside is already E3100 (double-await
	// across the back-edge), so it never reaches lowering, and marking its (outer) owner here is harmless.
	function consumePromiseThread(promise ValueId)
		self.removeFromPendingTemps(promise)
		var i = 0
		while i < self.ownedBindings.count() 'each'
			var owned = try self.ownedBindings.get(i) otherwise panic("consumePromiseThread: ownedBindings.get OOB at {i} — the list is only appended to and drained at a block's end")
			if self.isLiveOwnerOf(owned, value: promise) 'owner'
				owned.movedFrom = true
				return
			end 'owner'
			i = i + 1
		end 'each'
	end 'consumePromiseThread'

	// ⭐ **IS A GREEN THREAD `p` OWNS STILL NAMED BY A LIVE ALIAS? (P1.5-B2 #88, Finding 2)** `let q = p` binds
	// `q` to `p`'s thread ValueId without enrolling a second owner (a promise aliases, it does not move), so
	// re-arming `p` must first confirm no such live alias exists — else dropping the thread dangles the alias
	// (a UAF at `await q`). `thread` is the value being re-armed away. Two shapes:
	//   • DIRECT — `thread` is the spawn's ValueId (a non-loop re-arm): scan the symbol table for a DIFFERENT
	//     live name bound to it.
	//   • MERGE PHI — a re-armed `var` across a loop / branch holds a phi as `thread`; the phi itself is named
	//     by no alias, but the thread it MERGES (on the first reaching edge) may be. So also scan the phi's
	//     incoming edge values (`phiIncomingValues`) — the pre-loop value an outer `let q = p` aliases.
	// Purely a re-arm-time scan (no per-binding/per-value state), so the async-free scale corpus pays nothing.
	function promiseThreadHasLiveAlias(func IrFunction, reArmedName ByteArray, thread ValueId) returns bool
		if self.threadNameAliasedBy(reArmedName, thread: thread) 'direct'
			return true
		end 'direct'
		for incoming in self.phiIncomingValues(func, phi: thread) 'eachIncoming'
			if self.threadNameAliasedBy(reArmedName, thread: incoming) 'phiAlias'
				return true
			end 'phiAlias'
		end 'eachIncoming'
		return false
	end 'promiseThreadHasLiveAlias'

	// A live binding OTHER than `reArmedName` bound to `thread` and not moved-from — the raw symbol-table scan
	// `promiseThreadHasLiveAlias` runs on the re-armed value and on each of its phi's incoming values.
	function threadNameAliasedBy(reArmedName ByteArray, thread ValueId) returns bool
		for (name, info) in self.scope.allVars() 'each'
			if name != reArmedName and info.boundValue == thread and not info.movedFrom 'alias'
				return true
			end 'alias'
		end 'each'
		return false
	end 'threadNameAliasedBy'

	function poisonMoveSource(value ValueId, anchor Token) throws ParseError
		var i = 0
		while i < self.ownedBindings.count() 'each'
			// A `var` bound from `.get(i)`, not a bare `for` element: a field write needs a mutable
			// binding, and it is written THROUGH the shared `VarInfo` reference (the `Scope.setValue`
			// idiom), so the flag is observed by every holder — `ownedBindings`, `Scope.vars`, any
			// loop-phi list.
			var owned = try self.ownedBindings.get(i) otherwise panic("poisonMoveSource: ownedBindings.get OOB at {i} — the list is only appended to and drained at a block's end")
			if self.isLiveOwnerOf(owned, value: value) 'source'
				if self.bindingIndexEscapesLoop(i as BindingMark) 'escapesLoop'
					throw ParseError.unsupported("moving a value declared outside this loop from inside the loop body — its drop on the loop's other exit paths (the back edge would re-move it next iteration; a `break` leaves it live on the normal exit) needs path-sensitive elaboration across the loop boundary, which arrives with a later wave. Move the value into the loop body, or restructure so the move does not cross the loop boundary", line: anchor.line, column: anchor.column)
				end 'escapesLoop'
				owned.movedFrom = true
				return
			end 'source'
			i = i + 1
		end 'each'
	end 'poisonMoveSource'

	// Does moving the owned binding at `index` cross OUT of the innermost enclosing loop — i.e. was that
	// binding declared before the loop body was entered (`LoopContext.ownedFloor`)? Only such a move is
	// unsound at this rung (see `poisonMoveSource`); a move of a body-local binding, or any move outside a
	// loop entirely, is fine. The innermost loop is the top of the loop-context stack.
	function bindingIndexEscapesLoop(index BindingMark) returns bool
		if self.loops.count() == 0 'notInLoop'
			return false
		end 'notInLoop'

		let innermost = try self.loops.get(self.loops.count() - 1) otherwise panic("bindingIndexEscapesLoop: loops.get failed on a non-empty stack")
		return index < innermost.ownedFloor
	end 'bindingIndexEscapesLoop'

	// ⭐ **PROMOTE A BORROWED String TO AN OWNED HEAP COPY** so a `returns String` function ALWAYS hands
	// back something owned. `return "hi"` yields an immortal rdata literal (capacity == -2), and a
	// `returns String` caller drops its result unconditionally — decref'ing read-only data. Copying the
	// source bytes into a fresh fused record — the SAME single-`__mm_alloc` path an interpolation builds,
	// with the source as its one part (`__str_copy` blits `buffer@0`/`length@8`) — yields an owned
	// temporary the caller can safely drop. `emitStringInterp` marks it owned (`trackOwnedTemp`); the
	// return's move-out then takes it out of the pending list. NO second record layout is hand-rolled.
	function promoteToOwnedString(source ValueId, range SourceRange) returns ValueId
		var partBufs = ValueIdArray.create()
		var partLens = ValueIdArray.create()
		var scratchIds = ValueIdArray.create()
		self.materializeStringRecordPart(source, partBufs: partBufs, partLens: partLens, range: range)
		return self.emitStringInterp(partBufs, partLens: partLens, scratchIds: scratchIds, range: range)
	end 'promoteToOwnedString'

	// ⭐ **RETAIN A BORROWED MANAGED AGGREGATE AS A FRESH OWNED VALUE (OPEN #40).** The struct/union analogue
	// of `promoteToOwnedString`: where a String promotes by COPYING into a fresh owned record, an aggregate
	// has no cheap owning copy and MUST stay the same box (the alias is observable through a field write), so
	// it is promoted by an INCREF instead — `__mm_retain` raises the box's refcount and hands back the
	// pointer. That the runtime fn RETURNS the pointer (rather than reusing the void `__mm_incref`) is the
	// point: the result is a FRESH SSA value distinct from `source`, so a later re-borrow of `source`
	// (`let r = p`) cannot `poisonMoveSource`-match this binding, and moving this binding poisons IT, not the
	// source. The result carries the SOURCE's exact type (same tag + name id), so the binding is the same
	// aggregate the source is — its fields, its `match` dispatch, and its drop callee all resolve
	// identically. `markValueOwnsHeap` (not `trackOwnedTemp`) sets the owned-heap provenance WITHOUT
	// enrolling a statement-scoped pending drop: `parseBinding` binds this to the `var`, which drops it at
	// ITS scope exit through `ownedBindings` — the same door a consumed managed parameter drops through.
	function retainBorrowedAggregate(source ValueId, range SourceRange) returns ValueId
		let retained = self.emitRuntimeCall(MmRetainName, args: singletonArgs(source), resultTag: self.tagOf(source), resultNameId: self.valueNameId(source), range: range)
		self.markValueOwnsHeap(retained)
		return retained
	end 'retainBorrowedAggregate'

	// ⭐ **MAKE A BORROWED MANAGED VALUE OWNED — the ONE `String`-copy-vs-aggregate-retain decision both a
	// DECLARATION (`var q = p`) and a REASSIGNMENT (`q = p2`) of an owned binding must make.** A borrowed
	// value cannot be enrolled as owned as-is: its owner is elsewhere, so a scope-exit drop would free the
	// caller's box a second time. So it is promoted — a String COPIES into a fresh owned record (value
	// semantics), a struct/union INCREFS the shared box (reference semantics: an aggregate has no cheap
	// owning copy and its alias is observable through a field write). The caller has already established
	// that `value` is a BORROWED managed heap value (`valueIsManagedHeap and not valueIsOwnedHeap`), so the
	// two arms are exhaustive and a scalar — which owns no heap and never reaches an owned binding — is a
	// parser invariant break, not an unhandled case.
	//
	// ⚠ Single-sourced BECAUSE the two callers straddle a boundary that let them drift: before this, the
	// reassignment path spelled only the String half (`promoteToOwnedString`) and, once the declaration
	// began making struct/union `var`s owned (OPEN #40), string-promoted a borrowed STRUCT on `q = p2` — a
	// blit of the struct's fields as a fused String record, a SILENT miscompile the type checker waves
	// through (both sides are the same aggregate type) and the suite was green over. Routing both sites
	// here makes a future divergence a compile error rather than a wrong answer.
	//
	// ⚠⚠ **AN AGGREGATE READ OUT OF AN IMMUTABLE GLOBAL IS REFUSED HERE (P1.7 slice 2b), and this is the ONE
	// place that can refuse it.** The aggregate arm promotes by INCREF — the binding becomes a second owner of
	// the SAME box, deliberately, because the alias is observable — so a mutable binding of a value read from
	// a `let`-declared global would be a writable alias of a record the language says is immutable:
	// `var b = A` then `b.push(9)` grows A, with E2013 and E3019 both intact and nothing to say so (MEASURED
	// at 3 where 2 is correct, through BOTH callers: the declaration `var b = A` and the reassignment
	// `b = A`). A String source never reaches it — the text arm COPIES, which is why `var b = <a String let>`
	// stays legal and correct.
	//
	// The refusal is E2015 and names the missing mechanism, because that is exactly what this is: a real COPY
	// promotion for a borrowed array would make the program work, and shv2 has none (an `Array` has no clone;
	// `retainBorrowedAggregate` is all there is). Widening the incref into a copy is not an option here — a
	// borrowed array bound to a `var` SHARES in both reference compilers when the source is mutable
	// (measured: the oracle returns 3 for a `var` global and for a parameter, exactly as shv2 does), so
	// copying would break an agreement rather than fix a disagreement. Immutability of the SOURCE is the
	// whole discriminator.
	function promoteBorrowedToOwned(value ValueId, range SourceRange) returns ValueId throws ParseError
		if tagIsText(self.tagOf(value)) 'text'
			return self.promoteToOwnedString(value, range: range)
		end 'text'

		if self.valueIsNonTextAggregate(value) 'aggregate'
			// The one asker of `immutableGlobalReads`, and the one place the answer changes anything: a
			// borrowed managed aggregate about to become an owned mutable binding. The mark reaches every use
			// of the read in THIS function — the direct binding, a reassignment, and a ternary/`match` merge
			// that joins it (`propagateImmutableGlobalReadToPhi`).
			//
			// ⚠ **IT STOPS AT A CALL, and that bound is stated rather than hoped for.** `g(A)` whose callee
			// binds its parameter to a `var` still aliases: the parameter is a fresh value in a fresh SSA
			// space, and whether it may hold an immutable global's record is a property of every CALL SITE,
			// not of the callee — so the answer is a whole-program fixpoint, the same one the transitive
			// -consume case waits on, not something a per-function value mark can ever carry. Recorded in
			// `specs-shv2/static-variables.md` as part of the mutation-enforcement prerequisite, so the gap
			// is documented where a reader of the rule will look rather than discovered by a user.
			if self.immutableGlobalReads.contains(value) 'immutableSource'
				throw ParseError.unsupported("binding a `let`-declared top-level global to a `var` — an aggregate has no owning COPY in shv2, so the binding would alias the SAME record and a write through it would mutate a global declared immutable; read it through a `let` binding, or declare the global `var`", line: range.line, column: range.column)
			end 'immutableSource'

			return self.retainBorrowedAggregate(value, range: range)
		end 'aggregate'

		panic("promoteBorrowedToOwned: v{value} is neither text nor a managed aggregate — the caller has already gated on `valueIsManagedHeap`, so a borrowed value promoted to owned is always a String (copy) or a struct/union box (retain); a scalar owns no heap and never reaches an owned binding's promotion")
	end 'promoteBorrowedToOwned'

	// ⭐ **DROP EVERY OWNED TEMPORARY THE STATEMENT LEFT UNCONSUMED**, in REVERSE creation order (the
	// `emitScopeDrops` convention — the last built is the first torn down), into `currentBlock`. Called at
	// the end of a statement, so the drop lands exactly where control is when the statement finishes: a loop
	// body, an `if` branch, a short-circuit merge. Clears the list — a temporary belongs to ONE statement.
	//
	// `anchor` is the statement's own token; no source token spawns a drop, so it rides the statement that
	// made control leave the temporary's lifetime, exactly as `emitScopeDrops` rides the `return`.
	// ⭐ **RELEASE EVERY PENDING TEMPORARY ABOVE `floor`, AND FORGET THEM.** `WholeStatementTempFloor` ends
	// the whole list (a statement's tail, a hand-off exit); a REGION passes the height it recorded before
	// parsing itself, so it releases what IT built and leaves the enclosing statement's temporaries alone.
	// That distinction is the whole point: an `if` inside `let v = f("{x}", …)` must not release the
	// interpolation `f` has not been handed yet.
	//
	// A floor ABOVE the current count is not an error and does nothing — the list is *shorter* than the
	// region's start only when something already released past it (a `return` inside a match arm drains the
	// whole list on its own edge), and there is then nothing left for the region to release.
	//
	// ⚠ **THE REGIONS THAT MUST CALL THIS, WRITTEN DOWN ONCE — TEACH A NEW ONE HERE.** Every construct that
	// FORKS owes its own temporaries a release in a block their definitions dominate; miss one and the shape
	// is a leak (a release on too few paths) or a release of a value the taken path never built (which the
	// register allocator reports, several passes later, as "a use dominates its def"):
	//   • `parseIfStatement` / `parseWhileStatement` — the condition, in its exit block before the branch;
	//   • `parseMatchCommon` — the scrutinee before the first test, and each ARM at its own exit
	//     (`finishArmValues`);
	//   • `parseTernaryExpression` — the condition, and each of the two arms;
	//   • `emitShortCircuit` — the right-hand side, which runs on one path only;
	//   • `desugarTry` — the odd one out, and deliberately: its fork temporaries belong to the ENCLOSING
	//     statement and are still live past the fork, so they are released once per EDGE rather than swept
	//     here (see there).
	// There is no automatic check behind this list, and that is a known gap rather than an oversight: the
	// flat list is always drained by *something* downstream, so an end-of-parse "nothing left over" assertion
	// cannot see a release that landed in the wrong BLOCK — the defect this discipline exists to prevent. A
	// real guard needs a def-block per temporary plus a dominance query. `specs-shv2/block-condition-temporaries.md`
	// pins one case per region in the meantime, and the leak gate (`!= 0`, so it catches an over-release too)
	// is what makes those cases fail loudly.
	function drainPendingTemps(floor TempDropMark, anchor Token)
		self.emitTempDrops(self.pendingTempDrops, floor: floor, anchor: anchor)
		while self.pendingTempDrops.count() > floor 'forget'
			_ = try self.pendingTempDrops.pop() otherwise panic("drainPendingTemps: pop above floor {floor} failed on a list of {self.pendingTempDrops.count()} — the loop pops strictly while the count exceeds the floor")
		end 'forget'
	end 'drainPendingTemps'

	// Emit the `__mm_decref` for each of `temps` above `floor`, in REVERSE creation order, into
	// `currentBlock`, WITHOUT touching the list. The drop LOOP, split out so the `try` fork — which releases
	// the SAME temporaries into TWO blocks, one per edge, and forgets them once (`desugarTry`) — reuses it
	// instead of spelling the reverse walk a second time. A second copy is how the two would come to disagree
	// on the order, and the order is a rule (`emitScopeDrops`' convention: the last built is the first torn
	// down).
	function emitTempDrops(temps ValueIdArray, floor TempDropMark, anchor Token)
		var i = temps.count()
		while i > floor 'eachTemp'
			i = i - 1
			let temp = try temps.get(i) otherwise panic("emitTempDrops: temps.get OOB at {i} — the list is walked strictly downwards from its own count")
			self.emitDecref(temp, range: SourceRange.ofToken(anchor))
		end 'eachTemp'
	end 'emitTempDrops'

	// Parse an `if` statement (M4):
	//   if <cond> 'thenLabel'
	//       <then-stmts>
	//   end 'thenLabel' [ else 'elseLabel' <else-stmts> end 'elseLabel'
	//                   | else if <cond> …  (the else branch is itself a nested `if`) ]
	//
	// Lowering shape: the entry block (`block`) evaluates `cond` (a comparison, whose
	// value the Std→x64 pass fuses with the branch) and gets a `condBranch` terminator
	// selecting the then block vs the false target (the else block, or the continuation
	// when there is no else). A branch that returns terminates itself; one that falls
	// through gets a `branch` to the continuation. Blocks are created then→else→
	// continuation so `.text` lays them out in source order.
	//
	// Returns the CONTINUATION — where control resumes after the `if`. It is either
	// reachable (Terminator.unset, so subsequent statements emit into it — e.g. the
	// `return 0` after a simple `if`) or, when both branches return, unreachable
	// (Terminator.dead — emits no code, but is still returned so the caller always has
	// a block to continue in).
	//
	// M4b VALUE MERGE: because a `var` may be reassigned inside a branch, the value of
	// a variable at the continuation depends on which path ran. The parser snapshots
	// each carried var's value entering the branches, RESTORES it before the else/false
	// path (so that path resumes from the pre-`if` state), and at the continuation
	// merges the two incoming snapshots — a variable that differs across the paths gets
	// a continuation PHI (the same block-arg mechanism loops use), everything else keeps
	// its common value. Without this, a `var` written only on the taken path would leak
	// its then-value onto the not-taken path (a real miscompile).
	//
	// THE CARRIED SET IS THE VARS THE STATEMENT ASSIGNS, decided from the tokens before
	// anything is emitted (`assignedBindingsIn` over the whole if's extent) — a SUBSET of
	// `mutableVars`, in that list's declaration order. A var no branch assigns holds one
	// value on entry, then-exit AND else-exit, so it can never differ at the merge: it
	// needs neither a phi nor a snapshot slot, and is left out of all three. This is the
	// exact analogue of `parseWhileStatement`'s carried set, and it replaces snapshotting
	// the WHOLE mutable-var set at every branch — which was O(vars in scope) per `if`, and
	// with the scope-filler count doubling on the scale corpus made `phase:parse` BYTES
	// bend quadratically while its ALLOCATIONS stayed linear (bigger snapshots, not more).
	//
	// Each branch body is a lexical BLOCK (parseBlockBody), so the three snapshots are
	// all taken at the SAME scope depth — a `var` declared inside a branch has left
	// `mutableVars` by the time that branch's exit values are read, and is skipped by
	// `assignedBindingsIn` (not bound at entry), which keeps `entryVals` / `thenVals` /
	// `elseVals` positionally aligned with `assignedBindings`.
	function parseIfStatement(func IrFunction, block IrBlock) returns IrBlock throws ParseError
		let ifIndex = self.pos
		let ifTok = try self.consume(TokenKind.if)

		// The carried bindings — read off the tokens covering the WHOLE statement (then plus
		// every `else`/`else if` branch, through the final `end`), before a single op is
		// emitted. Every snapshot below is positional over THIS list, so the per-branch cost
		// is O(assigned), not O(vars in scope). `ifEnd` also feeds the drift guard.
		let ifEnd = self.blockStatementEndIndex(ifIndex, continuesAtElse: true)
		let assignedBindings = self.assignedBindingsIn(ifIndex, endIndex: ifEnd)

		let condTempFloor = self.pendingTempDrops.count()
		let cond = try self.parseBoolCondition(func, block: block, kwTok: ifTok)
		// The condition's own blocks: a short-circuit `and`/`or` in it (`if a() and b()`)
		// has already branched, and control now sits in ITS merge block. That — not the
		// block the `if` started in — is where the two-way branch belongs, and it is the
		// `if`'s true entry for every purpose below.
		var entry = self.currentBlock

		// ⭐ **THE CONDITION'S TEMPORARIES DIE HERE, IN `entry`, BEFORE THE BRANCH.** `if [10,20,30].count()
		// == 99` builds an array that nothing owns once `count()` has read it, and `entry` is the last block
		// on the single path through the condition — it dominates the then branch, the else branch and the
		// continuation alike, so ONE release here is one release on every path. Releasing it anywhere later
		// cannot be: the branches are the two halves of a fork (a drop in the body runs only when the body
		// does — the leak), and the continuation is reached from both (a drop there runs twice, or on a path
		// that returned early, never at all).
		self.drainPendingTemps(condTempFloor, anchor: ifTok)

		let thenLabel = try self.consume(TokenKind.charLiteral)

		// Values entering the branches (the condition only reads, so `entry`'s values
		// are unchanged by it). Positional over `assignedBindings`.
		let entryVals = self.snapshotBindings(assignedBindings)
		// The move state entering the branches — the twin of `entryVals` for the drop-gating bit, over the
		// owned bindings the branches might move (a `let` String, a consumed param), which are NOT the
		// assigned `var`s `entryVals` covers. Reconciled at the join so a conditional move drops correctly.
		let entryMoveMark = self.captureMoveMark()

		// `var` because these blocks are passed to functions that mutate them (the
		// statement parser fills the block; the finalizers wire its terminator) — a
		// `let` binding cannot be forwarded to a mutating parameter (E3019).
		var thenBlock = self.newBlock(func, label: thenLabel.value, line: thenLabel.line)
		var thenEnd = try self.parseBlockBody(func, block: thenBlock, label: thenLabel.value)

		// Snapshot the then-branch's exit values and move state, then rewind BOTH to the entry state so the
		// else/false path is parsed against the pre-`if` values and pre-`if` ownership, not the then-branch's.
		let thenVals = self.snapshotBindings(assignedBindings)
		let thenMoveMark = self.captureMoveMark()
		self.restoreBindings(assignedBindings, snapshot: entryVals)
		self.restoreMoveMark(entryMoveMark)

		if not self.at(TokenKind.else) 'noElse'
			let cont = self.finalizeIfNoElse(func, entry: entry, cond: cond, ifTok: ifTok, thenBlock: thenBlock, thenEnd: thenEnd, bindings: assignedBindings, entryVals: entryVals, thenVals: thenVals, entryMoveMark: entryMoveMark, thenMoveMark: thenMoveMark)
			self.assertScanAligned("parseIfStatement", predictedEnd: ifEnd)
			return cont
		end 'noElse'

		try self.consume(TokenKind.else)
		var elseBlock = self.newBlock(func, label: b"ifelse", line: ifTok.line)
		var elseEnd = try self.parseElseBody(func, elseBlock: elseBlock)
		let elseVals = self.snapshotBindings(assignedBindings)
		let elseMoveMark = self.captureMoveMark()
		let cont = self.finalizeIfElse(func, entry: entry, cond: cond, ifTok: ifTok, thenBlock: thenBlock, thenEnd: thenEnd, elseBlock: elseBlock, elseEnd: elseEnd, bindings: assignedBindings, thenVals: thenVals, elseVals: elseVals, thenMoveMark: thenMoveMark, elseMoveMark: elseMoveMark)
		self.assertScanAligned("parseIfStatement", predictedEnd: ifEnd)
		return cont
	end 'parseIfStatement'

	// Parse an `else` body into `elseBlock`: either a nested `if` (the `else if …`
	// chain — the else branch IS a nested if statement, so `elseBlock` becomes that
	// if's entry) or a plain labelled `else` block. Returns the block the else branch
	// left control in (its own continuation for a nested if; the block its last
	// statement filled for a plain else).
	//
	// The `else if` form opens NO scope frame of its own: its condition is evaluated in
	// the ENCLOSING scope (it is not inside any block), and each of the nested if's own
	// branches opens a frame when it is parsed. Only the plain `else 'label'` form is a
	// block body.
	function parseElseBody(func IrFunction, elseBlock IrBlock) returns IrBlock throws ParseError
		if self.at(TokenKind.if) 'elseIf'
			return try self.parseIfStatement(func, block: elseBlock)
		end 'elseIf'

		let elseLabelTok = try self.consume(TokenKind.charLiteral)
		return try self.parseBlockBody(func, block: elseBlock, label: elseLabelTok.value)
	end 'parseElseBody'

	// Finalize an `if` with no `else`: the false path flows straight to the
	// continuation, so the continuation is always reachable. Wire the entry's
	// condBranch (then vs continuation). When the then branch falls through, the
	// continuation merges the false-edge values (`entryVals`) with the then-branch's
	// exit values (`thenVals`) — a differing var gets a continuation phi. When the then
	// branch returns, the continuation is reached only from the false edge, whose values
	// are already the restored `entryVals` (and whose move state is the restored `entryMoveMark`).
	//
	// ⭐ **A CONDITIONAL MOVE IS RECONCILED HERE.** An owned binding the then branch MOVED but the false
	// path left LIVE must be dropped on the false path so it does not leak. When the then branch FALLS
	// THROUGH, both edges reach the continuation: `reconcileMovesAtMerge` drops the binding on the false
	// edge (routed through a fresh block, since the direct entry->cont edge has none) and marks it moved.
	// When the then branch RETURNS, the continuation is reached only from the false edge — the move state
	// is already the caller's restored `entryMoveMark`, so the binding stays live and its scope exit drops it.
	function finalizeIfNoElse(func IrFunction, entry IrBlock, cond ValueId, ifTok Token, thenBlock IrBlock, thenEnd IrBlock, bindings VarInfoArray, entryVals ValueIdArray, thenVals ValueIdArray, entryMoveMark MoveMark, thenMoveMark MoveMark) returns IrBlock
		var cont = self.newBlock(func, label: b"ifcont", line: ifTok.line)
		if thenEnd.isTerminated() 'thenTerminated'
			self.emitCondBranch(entry, cond: cond, thenId: thenBlock.id, elseId: cont.id, ifTok: ifTok)
			return cont
		end 'thenTerminated'

		// Both the false edge (entry state) and the then edge (then state) reach the continuation. A binding
		// the then branch MOVED but the entry left LIVE must be dropped on the false path — but the direct
		// entry->cont false edge is `entry`, which already ends in the two-way condBranch and cannot take an
		// appended decref. Only then is a fresh `iffalse` block minted on that edge to hold the drop; an `if`
		// with no such conditional move takes the direct edge and its codegen is byte-identical to before.
		if self.thenMovesLiveBinding(entryMoveMark, thenMoveMark: thenMoveMark) 'falseEdgeDrop'
			var falseBlock = self.newBlock(func, label: b"iffalse", line: ifTok.line)
			self.emitCondBranch(entry, cond: cond, thenId: thenBlock.id, elseId: falseBlock.id, ifTok: ifTok)

			var edges = ReachingMoveEdgeArray.create()
			edges.push(ReachingMoveEdge.create(falseBlock, mark: entryMoveMark))
			edges.push(ReachingMoveEdge.create(thenEnd, mark: thenMoveMark))
			self.reconcileMovesAtMerge(edges, anchor: ifTok)

			self.mergeAtContinuation(falseBlock, predB: thenEnd, cont: cont, bindings: bindings, valsA: entryVals, valsB: thenVals)
			self.emitBranch(falseBlock, targetId: cont.id)
			self.emitBranch(thenEnd, targetId: cont.id)
		end 'falseEdgeDrop' else 'directFalseEdge'
			self.emitCondBranch(entry, cond: cond, thenId: thenBlock.id, elseId: cont.id, ifTok: ifTok)
			// The false edge is the direct entry->cont edge; the post-merge move state is the then state (a
			// binding moved before the `if` stays moved on both edges, and nothing new was moved to drop).
			self.restoreMoveMark(thenMoveMark)
			self.mergeAtContinuation(entry, predB: thenEnd, cont: cont, bindings: bindings, valsA: entryVals, valsB: thenVals)
			self.emitBranch(thenEnd, targetId: cont.id)
		end 'directFalseEdge'
		return cont
	end 'finalizeIfNoElse'

	// Does the then branch move an owned binding the ENTRY left live — the one shape an `if` with no `else`
	// must place a drop on its false edge for (see `finalizeIfNoElse`)? The move flag is monotonic within a
	// path, so a binding live at entry and moved after the then branch was moved BY that branch. A binding
	// already moved before the `if` is moved on both edges (nothing to reconcile); a binding no branch
	// touched is live on both.
	function thenMovesLiveBinding(entryMoveMark MoveMark, thenMoveMark MoveMark) returns bool
		var i = 0
		while i < entryMoveMark.moved.count() 'scan'
			let entryLive = not (try entryMoveMark.moved.get(i) otherwise panic("thenMovesLiveBinding: entryMoveMark.moved.get OOB at {i}"))
			let thenMoved = try thenMoveMark.moved.get(i) otherwise panic("thenMovesLiveBinding: thenMoveMark.moved.get OOB at {i}")
			if entryLive and thenMoved 'movedInThenOnly'
				return true
			end 'movedInThenOnly'
			i = i + 1
		end 'scan'
		return false
	end 'thenMovesLiveBinding'

	// Finalize an `if`/`else`: the entry's condBranch targets the then and else blocks.
	// The continuation is reachable only when a branch falls through; when BOTH return
	// it is unreachable and marked `dead`. When BOTH fall through, the continuation
	// merges their exit values (`thenVals`/`elseVals`) with phis for the vars that
	// differ. When only ONE falls through, the continuation simply carries that branch's
	// values (no phi — a single predecessor).
	function finalizeIfElse(func IrFunction, entry IrBlock, cond ValueId, ifTok Token, thenBlock IrBlock, thenEnd IrBlock, elseBlock IrBlock, elseEnd IrBlock, bindings VarInfoArray, thenVals ValueIdArray, elseVals ValueIdArray, thenMoveMark MoveMark, elseMoveMark MoveMark) returns IrBlock
		self.emitCondBranch(entry, cond: cond, thenId: thenBlock.id, elseId: elseBlock.id, ifTok: ifTok)
		let thenTerminated = thenEnd.isTerminated()
		let elseTerminated = elseEnd.isTerminated()

		if thenTerminated and elseTerminated 'bothReturn'
			// Nothing reaches the continuation — mark it dead rather than leave it
			// unterminated (assertAllBlocksTerminated forbids an unset block).
			var cont = self.newBlock(func, label: b"ifcont", line: ifTok.line)
			cont.terminator = Terminator.dead
			return cont
		end 'bothReturn'

		var cont = self.newBlock(func, label: b"ifcont", line: ifTok.line)
		if not thenTerminated and not elseTerminated 'bothFallThrough'
			// ⭐ **CONDITIONAL MOVE RECONCILED across the two live edges** — a binding moved in one branch and
			// left live in the other is dropped on the live edge (both are real, unterminated blocks) and
			// marked uniformly moved past the merge. Emitted BEFORE `mergeAtContinuation` records the phi
			// edges and before the branches, so the decref lands in the branch's own body.
			var edges = ReachingMoveEdgeArray.create()
			edges.push(ReachingMoveEdge.create(thenEnd, mark: thenMoveMark))
			edges.push(ReachingMoveEdge.create(elseEnd, mark: elseMoveMark))
			self.reconcileMovesAtMerge(edges, anchor: ifTok)

			self.mergeAtContinuation(thenEnd, predB: elseEnd, cont: cont, bindings: bindings, valsA: thenVals, valsB: elseVals)
			self.emitBranch(thenEnd, targetId: cont.id)
			self.emitBranch(elseEnd, targetId: cont.id)
		end 'bothFallThrough' else if not thenTerminated 'onlyThen'
			// Only the then branch reaches the continuation — its values AND its move state carry through
			// (the else branch terminated, having dropped its own live values on the way out).
			self.restoreBindings(bindings, snapshot: thenVals)
			self.restoreMoveMark(thenMoveMark)
			self.emitBranch(thenEnd, targetId: cont.id)
		end 'onlyThen' else 'onlyElse'
			// Only the else branch reaches the continuation — its values and move state ARE the current
			// state (else was parsed last and nothing has mutated either since), so both restores are
			// no-ops today. They are written explicitly anyway, symmetric with `onlyThen` above: "the
			// surviving branch's state prevails at the merge" is then stated once per axis rather than
			// left as an unstated dependence on branch-parse order — which, if ever reordered, would keep
			// values correct (explicit restore) while silently diverging the drop-gating move state into a
			// leak or double-free (a wrong answer, not a compile error).
			self.restoreBindings(bindings, snapshot: elseVals)
			self.restoreMoveMark(elseMoveMark)
			self.emitBranch(elseEnd, targetId: cont.id)
		end 'onlyElse'
		return cont
	end 'finalizeIfElse'

	// Merge two incoming value snapshots at a continuation block. A carried binding whose
	// value differs across the paths gets a continuation PHI (a block-arg) and each
	// predecessor records the value it carries on its edge; a binding with the same value
	// on both paths keeps that value with no phi. Each merged binding's current value is
	// set to the phi (or the common value) so code after the `if` reads the merged value.
	//
	// `bindings` is the statement's carried set (`assignedBindings`) in `mutableVars`
	// declaration order, and both snapshots are positional over it. Phis are therefore
	// minted in that same order — which is what makes the emitted code identical to the
	// old whole-`mutableVars` merge: a var no branch assigned had a == b there and got no
	// phi, so leaving it out of `bindings` changes no decision, only the work done to
	// reach it. Both snapshots and `bindings` are the SAME length (asserted): every branch
	// body is a lexical block, so a `var` declared inside one is off `mutableVars` — and so
	// never entered `bindings` — before its exit values are snapshotted.
	function mergeAtContinuation(predA IrBlock, predB IrBlock, cont IrBlock, bindings VarInfoArray, valsA ValueIdArray, valsB ValueIdArray)
		self.assertSnapshotAligned(bindings, snapshot: valsA, site: "mergeAtContinuation/valsA")
		self.assertSnapshotAligned(bindings, snapshot: valsB, site: "mergeAtContinuation/valsB")

		var edgeArgsA = ValueIdArray.create()
		var edgeArgsB = ValueIdArray.create()
		for k in 0 upto bindings.count() 'eachVar'
			var binding = try bindings.get(k) otherwise panic("mergeAtContinuation: bindings.get OOB at {k}")
			let a = try valsA.get(k) otherwise panic("mergeAtContinuation: valsA.get OOB at {k}")
			let b = try valsB.get(k) otherwise panic("mergeAtContinuation: valsB.get OOB at {k}")
			if a == b 'same'
				binding.boundValue = a
			end 'same' else 'differ'
				let phiId = self.mintPhiForBinding(cont, binding: binding)
				binding.boundValue = phiId
				edgeArgsA.push(a)
				edgeArgsB.push(b)
			end 'differ'
		end 'eachVar'
		self.recordBranchEdge(predA, targetId: cont.id, argIds: edgeArgsA)
		self.recordBranchEdge(predB, targetId: cont.id, argIds: edgeArgsB)
	end 'mergeAtContinuation'

	// Rebind each carried binding to a previously-captured snapshot value (from
	// `snapshotBindings` over the SAME `bindings` list). Used to rewind to the pre-branch
	// state before parsing an `if`'s false path, and to select a single surviving branch's
	// values at a continuation. Written THROUGH the binding, not by name, so a value is
	// never routed to a shadow (see LoopPhiVar). A var not in `bindings` is assigned by no
	// branch, so its value is already the one every path agrees on — nothing to restore.
	function restoreBindings(bindings VarInfoArray, snapshot ValueIdArray)
		self.assertSnapshotAligned(bindings, snapshot: snapshot, site: "restoreBindings")
		for k in 0 upto bindings.count() 'each'
			var binding = try bindings.get(k) otherwise panic("restoreBindings: bindings.get OOB at {k}")
			binding.boundValue = try snapshot.get(k) otherwise panic("restoreBindings: snapshot.get OOB at {k}")
		end 'each'
	end 'restoreBindings'

	// Every value snapshot is positional over the carried `bindings` list and must
	// therefore have exactly its length — block scoping is what guarantees that (a
	// branch-local `var` is drained at the block's `end`, so it never entered `bindings`
	// and can never lengthen a snapshot taken outside the block). A mismatch means the two
	// fell out of step, which would misattribute every later binding's value by one, so it
	// fails loudly here rather than silently.
	function assertSnapshotAligned(bindings VarInfoArray, snapshot ValueIdArray, site String)
		let expected = bindings.count()
		if snapshot.count() != expected 'drifted'
			panic("{site}: value snapshot holds {snapshot.count()} entries but the if carries {expected} assigned bindings — the snapshot drifted out of lockstep with the carried-bindings list")
		end 'drifted'
	end 'assertSnapshotAligned'

	// Parse a `while` loop (M4b):
	//   while <cond> 'label'
	//       <body>
	//   end 'label'
	//
	// Lowering shape (the first BACKWARD-branching CFG): the current block becomes the
	// PREHEADER, which branches unconditionally into a fresh HEADER. The header re-
	// evaluates the condition each iteration (a comparison, fused into `cmp`+`jcc` by
	// the Std→x64 pass, exactly as an `if`) and takes a two-way branch to the BODY or
	// the EXIT. The body ends with a BACK-EDGE branch to the header; `break` branches
	// to the exit, `continue` to the header. `resolveBlockJumps` already patches
	// backward rel32, so no new encoder work is needed.
	//
	// On-the-fly SSA: the header carries one PHI (block-arg) per mutable var the loop
	// ASSIGNS, minted eagerly BEFORE the body is parsed. Each phi becomes the var's current
	// value, so the condition and body read the loop-carried value; the preheader and every
	// back-edge feed the phis via the predecessor's `branchEdges`. Returns the EXIT block.
	//
	// **THE CARRIED SET IS THE VARS THE LOOP ASSIGNS — AND EAGER MINTING IS WHAT MAKES THAT
	// THE RIGHT QUESTION.** A var the loop never assigns holds the same value on every
	// iteration, so its pre-loop definition DOMINATES the header and a read inside the body
	// binds it correctly with no phi at all. A var the loop DOES assign needs one, and it
	// must exist before the body is parsed — because every read in the body, and every value
	// SNAPSHOT taken inside it (`parseIfStatement`'s entry/then/else snapshots, a nested
	// loop's preheader), captures whatever the binding holds AT THAT MOMENT. Mint the phi
	// later — on the var's first mention, say — and every snapshot already taken inside the
	// loop is holding the stale PRE-LOOP value, and an `if` merge in the body would carry it
	// onto the not-taken path. That is a silent miscompile on iteration 2, and it is why the
	// carried set is decided UP FRONT rather than discovered as the body is parsed:
	//
	//     var x = 1
	//     while c 'l'
	//         if d 'b'      // entry snapshot of x taken HERE
	//             x = 2     // a phi minted only now is invisible to that snapshot
	//         end 'b'       // ⇒ the false edge would carry 1, resetting x every iteration
	//     end 'l'
	//
	// So the set is read off the TOKENS, before a single op is emitted: `namesAssignedIn`
	// over the loop's token extent. It is an over-approximation on purpose (a shadowed inner
	// declaration of the same name counts, and so does a `let`), and over-approximating is
	// FREE while under-approximating is a miscompile — a surplus phi costs nothing:
	//   • a var the loop never READS gets a phi nothing reads — but the back edge passes
	//     that phi to ITSELF, so it is self-sustaining and liveness holds it live around
	//     the whole loop. `pruneDeadBlockArgs` (a Std pass) deletes those; without it, two
	//     sequential loops inflate maxlive by one per dead var and can FALSE-E5001.
	//   • a var the loop reads but never WRITES gets a phi that copies a value which never
	//     changes. Biased coloring coalesces it with its incoming value into one register
	//     and the edge copy self-elides (see RegisterAllocator.copyGroupBlocked).
	//
	// What this REPLACES is a phi for every mutable var IN SCOPE, which was quadratic in the
	// program: a function's `var`s accumulate as it goes, so the Nth loop minted phis for all
	// ~N of them and assigned a ValueId to each — including every one `pruneDeadBlockArgs`
	// then deleted. `blockArgIdBound`, and every dense column sized by it, is O(ValueIds), so
	// the phis nobody kept were still being paid for in bytes at every later pass.
	function parseWhileStatement(func IrFunction, block IrBlock) returns IrBlock throws ParseError
		let whileIndex = self.pos
		let whileTok = try self.consume(TokenKind.while)

		// Decided from the tokens, before anything is emitted — see the header.
		let bodyEndIndex = self.blockStatementEndIndex(whileIndex, continuesAtElse: false)
		let assigned = self.namesAssignedIn(whileIndex, endIndex: bodyEndIndex)

		var header = self.newBlock(func, label: b"whilehdr", line: whileTok.line)

		let phiVars = self.mintLoopHeaderPhis(header, assigned: assigned)

		self.recordBranchEdge(block, targetId: header.id, argIds: self.edgeArgsFor(phiVars, preLoop: true))
		self.emitBranch(block, targetId: header.id)

		// Condition, evaluated in the header — so `continue` and the back edge, which both
		// target the header, re-evaluate it. A short-circuit `and`/`or` in the condition
		// (`while check() and more()`) spreads that evaluation over blocks BETWEEN the
		// header and the two-way branch; `condExit` is the block it ends in, and that is
		// where the branch — and the exit's incoming edge — belong. The header stays the
		// loop's entry, so nothing about `continue` or the back edge changes.
		let condTempFloor = self.pendingTempDrops.count()
		let cond = try self.parseBoolCondition(func, block: header, kwTok: whileTok)
		var condExit = self.currentBlock

		// ⭐ **PER ITERATION, NOT PER LOOP** — and that is why the release goes HERE rather than in the exit
		// block. The condition is re-evaluated on every trip (the back edge and `continue` both target the
		// header), so it builds a FRESH temporary each time; `condExit` is inside the loop, so the release
		// rides round with it and the live count stays flat. Hoisted to `exit` it would run once for N
		// allocations — a leak that grows with the trip count. The `if` reasoning applies unchanged for the
		// two edges: `condExit` dominates both the body and the exit.
		self.drainPendingTemps(condTempFloor, anchor: whileTok)

		let loopLabelTok = try self.consume(TokenKind.charLiteral)

		var body = self.newBlock(func, label: loopLabelTok.value, line: loopLabelTok.line)
		var exit = self.newBlock(func, label: b"whileexit", line: whileTok.line)
		self.emitCondBranch(condExit, cond: cond, thenId: body.id, elseId: exit.id, ifTok: whileTok)

		// `ownedFloor` is the owned-binding height NOW, before the body opens its block — so a
		// `break`/`continue` releases exactly what the body declares (see LoopContext.ownedFloor).
		// A `while`'s continue target IS its header: the condition is re-evaluated on the back edge,
		// so there is no increment to run first and no step block to run it in.
		self.loops.push(LoopContext.create(loopLabelTok.value, continueTargetId: header.id, exitId: exit.id, phiVars: phiVars, ownedFloor: self.ownedBindings.count()))

		// The body is a lexical BLOCK: its declarations are gone — and its `var`s off
		// `mutableVars` — before the back-edge args below are read, so those args name the
		// loop's own phi bindings and never a body-local shadow.
		var bodyEnd = try self.parseBlockBody(func, block: body, label: loopLabelTok.value)

		// Guard the token scan against the parse it predicted — see `assertScanAligned`.
		self.assertScanAligned("parseWhileStatement", predictedEnd: bodyEndIndex)

		let ctx = try self.loops.pop() otherwise panic("parseWhileStatement: loop stack empty after body of '{String.from(loopLabelTok.value)}'")

		// Normal back-edge: a body that falls through goes wherever a COMPLETED iteration goes, with
		// its (possibly reassigned) current values. A body that always returns/breaks/continues on
		// every path leaves `bodyEnd` terminated — no fall-through edge.
		//
		// ⭐ **THE TARGET IS `ctx.continueTargetId`, DERIVED, NOT THE HEADER SPELLED AGAIN.** "Where a
		// normally-completing iteration lands" is ONE fact, and `continue` already reads it off the
		// context (`parseContinueStatement`); writing `header.id` here too made it a fact stated twice
		// per construct, agreeing only by coincidence. For a `while` the two ARE the header — which is
		// exactly why the duplicate stayed invisible — and for a `for` the fall-through must reach the
		// STEP block or the counter never advances.
		if not bodyEnd.isTerminated() 'fallsBack'
			self.recordBranchEdge(bodyEnd, targetId: ctx.continueTargetId, argIds: self.edgeArgsFor(phiVars, preLoop: false))
			self.emitBranch(bodyEnd, targetId: ctx.continueTargetId)
		end 'fallsBack'

		self.wireLoopExit(condExit, exit: exit, ctx: ctx)
		return exit
	end 'parseWhileStatement'

	// ⭐ **MINT ONE HEADER PHI PER CARRIED BINDING** — the front half BOTH loop statements run, and the
	// only place a loop-carried phi is created. `assigned` is the construct's carried set, read off the
	// tokens by its caller (see `parseWhileStatement`'s header for why it must be known up front); the
	// phis follow `mutableVars` DECLARATION order, which is what makes a merge inside the body mint its
	// own phis in the same order (`assignedBindingsIn`).
	//
	// Each binding's PRE-LOOP value is captured into the `LoopPhiVar` as it goes, because installing the
	// phi overwrites `boundValue` — that snapshot is what `edgeArgsFor(preLoop: true)` reads to build the preheader
	// edge, and reading it here, inside the single forward pass, is what keeps the two positional.
	//
	// Index-based so each binding is a MUTABLE reference — a `for x in …` loop variable is immutable,
	// and installing the phi writes through the binding.
	function mintLoopHeaderPhis(header IrBlock, assigned AssignedNameSet) returns LoopPhiVarArray
		var phiVars = LoopPhiVarArray.create()
		for k in 0 upto self.mutableVars.count() 'mkPhi'
			var binding = try self.mutableVars.get(k) otherwise panic("mintLoopHeaderPhis: mutableVars.get OOB at {k}")
			if not assigned.contains(binding.name) 'neverAssigned'
				continue
			end 'neverAssigned'

			let entryValue = binding.boundValue
			let phiId = self.mintPhiForBinding(header, binding: binding)
			phiVars.push(LoopPhiVar.create(binding, phiId: phiId, entryValue: entryValue))
			binding.boundValue = phiId
		end 'mkPhi'
		return phiVars
	end 'mintLoopHeaderPhis'

	// ⭐⭐ **PARSE A `for` LOOP (P1.8 slice A).** Three source spellings, ONE lowering:
	//
	//     for <name> in <lo> to   <hi> 'label'    — a counted range, INCLUSIVE of `hi`
	//     for <name> in <lo> upto <hi> 'label'    — the same, EXCLUSIVE of `hi`
	//     for <name> in <arraySource>  'label'    — an INDEX COUNTER over the array record
	//
	// FOUR blocks, and the fourth is the one `while` does not have:
	//
	//     preheader → evaluate the source ONCE → br header(idx0, …carried)
	//     header    → idx <= hi ? body : exit          (`<` for `upto`; for an array, `idx < count`)
	//     body      → bind the loop variable; <user statements>; br step
	//     step      → br header(idx + 1, …carried)     ← `continue` targets THIS, not the header
	//     exit
	//
	// ⭐ **THE STEP BLOCK IS MANDATORY.** Every path that continues the loop — the body's tail and every
	// `continue` — lands there, so the counter advances exactly once per iteration however the body was
	// left. Without it a `continue` re-enters the header with the counter unchanged and the loop spins
	// forever; both reference compilers hit that and both wrote a comment about it (v1
	// `Parser.maxon:10137-10139`, bootstrap `2-Parser.cs:13150-13153`), and so did shv2's own
	// `LoopContext` before this rung existed.
	//
	// ⭐ **THE ARRAY FORM IS AN INDEX COUNTER, NOT AN ITERATOR OBJECT** — the reference bootstrap's fast
	// path (`2-Parser.cs:13143-13244`), taken over v1's heap cursor (`Parser.maxon:10205-10373`) for
	// three measured reasons: v1's cursor snapshots `source.buffer` and dangles when the source is freed
	// at its last use (`LowerMaxonToStd.maxon:9750-9760`), it double-retains and leaked the backing of
	// every scope-local collection (`:9789-9800`), and it costs two heap allocations per loop. shv2
	// could not use v1's shape anyway: its `Array` is a hand-synthesized builtin with no
	// `createIterator`, and there is no `Iterable`/associated-type machinery for one to conform to.
	//
	// ⭐ **THE LENGTH IS RE-READ LIVE IN THE HEADER**, never snapshotted into the preheader. The header
	// comparison against the real length IS the bounds check, which is what lets the element read below
	// be the UNCHECKED one; a stale snapshot would let that read run off the end of the buffer.
	//
	// ⭐ **THE ELEMENT IS A BORROW** (`emitArrayElementAccessor(owned: false)`) — the array keeps
	// ownership and its own `__arr_decref` walk destroys it, exactly as `get`/`first`/`last` already
	// yield (`dispatchArrayMethod`). The loop variable is therefore enrolled in NEITHER `ownedBindings`
	// NOR `pendingTempDrops`, and the loop costs zero refcount traffic per iteration. The reference
	// bootstrap RETAINS instead (`MaxonToStandardConversion.ManagedMemory.cs:309-358`); shv2 has exactly
	// ONE door for reading an array element and it borrows, so retaining here would be a second
	// ownership rule for the same read. v1 borrows too (`Parser.maxon:10337`, `markBorrowSlot`).
	function parseForStatement(func IrFunction, block IrBlock) returns IrBlock throws ParseError
		let forIndex = self.pos
		let forTok = try self.consume(TokenKind.for)

		// Decided from the tokens, before anything is emitted — see `parseWhileStatement`'s header.
		let bodyEndIndex = self.blockStatementEndIndex(forIndex, continuesAtElse: false)
		let assigned = self.namesAssignedIn(forIndex, endIndex: bodyEndIndex)

		let nameTok = try self.consume(TokenKind.identifier)
		try self.requireUnreservedName(nameTok)
		try self.consume(TokenKind.in)

		// ⭐ **THE `for` STATEMENT'S OWN LEXICAL FRAME.** Two things live in it and must be gone at the
		// loop's `end`: the loop VARIABLE (`block-scoping.md`'s `for-iterator-not-accessible-after` pins
		// that reading it after the loop is E2004) and, when the source is a fresh OWNED array, the
		// internal binding that owns it. It is opened BEFORE the source is parsed so the owned mark sits
		// below anything the source enrols.
		let forMark = self.openBlock()

		// ⭐ **THE SOURCE IS EVALUATED ONCE, IN THE PREHEADER** — both range bounds, or the array record.
		// Measured against the runnable oracle, which stores the end bound in a `__range_end_N` local
		// ahead of the header (`2-Parser.cs:13490`) rather than re-evaluating it per trip: a bound that
		// calls a side-effecting function is called exactly once.
		let sourceTempFloor = self.pendingTempDrops.count()
		let sourceStart = self.pos
		let source = try self.parseExpression(func, block: block)

		// `to` / `upto` after the first expression is what makes this a RANGE. The operator's token INDEX
		// is carried (not the `Token` itself — a `var` may not alias an immutable aggregate binding,
		// E3078) so the loop test below can anchor its type diagnostic on the operator the user wrote;
		// an array form has no such operator and anchors on the `for`.
		var isRange = false
		var rangeInclusive = false
		var limit = source
		var testAnchorIndex = forIndex
		if self.at(TokenKind.to) or self.at(TokenKind.upto) 'rangeHeader'
			isRange = true
			rangeInclusive = self.at(TokenKind.to)
			testAnchorIndex = self.pos
			self.advance()
			limit = try self.parseExpression(func, block: self.currentBlock)
		end 'rangeHeader'

		// ⭐ **A COUNTED RANGE'S BOUNDS MUST BE INTEGERS**, asked here — the moment both are in hand and
		// before a single block of the loop exists, so a refused program emits no op. See
		// `requireCountableRangeBound`: without it a `float` range PANICKED in the x64 emitter and a
		// `bool` range was silently accepted.
		if isRange 'countedRange'
			try self.requireCountableRangeBound(source, anchor: self.tokenAt(sourceStart))
			try self.requireCountableRangeBound(limit, anchor: self.tokenAt(testAnchorIndex))
		end 'countedRange'

		// ⭐⭐ **ONLY THE ARRAY FORM LOCKS ITS SOURCE, AND THE FORK IS WHERE THAT IS DECIDED.** The lock
		// exists for ONE reason — the array form hands the body a BORROWED element the array still owns,
		// so a mutation that reallocates or clears it leaves that borrow dangling. A RANGE has no borrow
		// to protect: both bounds are snapshotted into the preheader above and the loop variable is the
		// header phi, so a write to a bound's variable inside the body cannot reach the loop at all.
		//
		// ⚠ It was taken BEFORE this fork and that was a FALSE REJECT of a legal program: `for i in n
		// upto 3 'l' n = n + 1 … end` locked `n` and reported **E2013**, where the runnable oracle
		// compiles it and returns 3. The asymmetry is what named it a bug rather than a policy — the END
		// bound's variable stayed writable, because only the FIRST expression starts at `sourceStart`, so
		// one range had two rules for its two halves. Both directions are pinned by
		// `specs-shv2/for-range-bound-mutation.md`, together with the array half, in ONE file: they are
		// two outcomes of one decision and a spec that pinned only one would let the other drift back.
		//
		// Taken here, it is still well before the loop VARIABLE is declared, which is what keeps
		// `for arr in arr` locking the SOURCE binding rather than the loop variable that shadows its name.
		var sourceLock = false
		// ⭐ **THE E3070 SUBJECT OF THE ELEMENT THIS LOOP WILL BORROW** — resolved HERE, beside the lock and
		// off the same `sourceStart`, because both are answers about the SOURCE and both must be taken before
		// the loop VARIABLE is declared: `for arr in arr` must key on the source binding, not on the loop
		// variable that shadows its name. Empty for a range (no borrow) and for a source that names no
		// binding, exactly as the lock is.
		var elementBorrowSubject = EmptySourceText
		if not isRange 'arraySource'
			try self.requireIterableArray(source, forTok: forTok)
			sourceLock = self.lockIterationSource(sourceStart)
			elementBorrowSubject = self.borrowSubjectNameAt(sourceStart)

			// ⭐ **AN OWNED ARRAY TEMPORARY BECOMES AN OWNED BINDING OF THIS FRAME.** `for x in [1,2,3]`
			// / `for x in build()` produces a record the statement owns; left in `pendingTempDrops` it
			// would be dropped by the FIRST `return` inside the body (which drains the WHOLE list,
			// `emitHandoffExitDrops`) and then LEAK on the fall-through path, because the list is empty
			// by the time the exit block drains it. As a binding it is dropped exactly once on every
			// exit: the loop's own `end` (`emitScopeDrops` below), a `return`/`throw` out of the body
			// (the whole binding stack, with the list restored afterwards so this path still drops it),
			// and never by a `break` (whose floor is the BODY's height, above this one).
			//
			// ⚠ The gate is `pendingTempsContain`, NOT `valueIsOwnedHeap`, and the difference is a
			// DOUBLE FREE: `var arr = IntArray.create()` is an owned VALUE whose drop a binding already
			// owes, so adopting it here too emitted two `__arr_decref`s into the exit block (measured —
			// `for-in-iteration` segfaulted). The pending list is exactly the owned values NO binding
			// owns (see `pendingTempsContain`), which is the question being asked.
			if self.pendingTempsContain(source) 'ownSourceTemp'
				self.removeFromPendingTemps(source)
				self.ownedBindings.push(VarInfo.createValueBinding(IterationSourceBindingName, varType: self.typeOf(source), mutable: false, boundValue: source))
			end 'ownSourceTemp'
		end 'arraySource'

		// Every OTHER temporary the source expression built — an interpolation handed to a factory call
		// — belongs to this statement and dies here, in the preheader, exactly as a `while` condition's
		// does. It is released BEFORE the loop rather than at the exit for the reason above: a `return`
		// inside the body would otherwise take the whole list with it.
		self.drainPendingTemps(sourceTempFloor, anchor: forTok)

		var header = self.newBlock(func, label: b"forhdr", line: forTok.line)

		// ⭐ **THE INDEX PHI IS A HEADER BLOCK-ARG, NOT A CARRIED BINDING**, and it is minted FIRST so
		// `header.blockArgs` reads [index, …carried]. It is DEFINED in the header, which dominates the
		// body, the step and the exit, so no other edge has to carry it: only the preheader's entry edge
		// and the step's back edge name it, and both are built right here. That is what lets
		// `break`/`continue` and `wireLoopExit` go on using `edgeArgsFor` unchanged.
		//
		// A RANGE's index IS the user's loop variable, so it takes the START bound's type (a ranged
		// alias stays one). An ARRAY's index is a compiler-owned counter and is a plain integer.
		let indexTag = self.tagOf(source) if isRange else ValueTypeTag.integer
		let indexNameId = self.valueNameId(source) if isRange else UnnamedTypeId
		let indexPhi = self.mintPhi(header, tag: indexTag, nameId: indexNameId)

		let phiVars = self.mintLoopHeaderPhis(header, assigned: assigned)

		// The preheader is `currentBlock`, not `block`: a short-circuit `and`/`or` inside a bound leaves
		// control in a fresh merge block, and the entry edge belongs on the block control is actually in.
		var firstIndex = source
		if not isRange 'arrayCounterStartsAtZero'
			firstIndex = self.emitLiteral(0, valueType: MaxonType.integer, range: SourceRange.ofToken(forTok))
		end 'arrayCounterStartsAtZero'
		self.recordBranchEdge(self.currentBlock, targetId: header.id, argIds: self.loopHeaderArgs(firstIndex, carried: self.edgeArgsFor(phiVars, preLoop: true)))
		self.emitBranch(self.currentBlock, targetId: header.id)

		// The loop test, in the header. For a range it is the user's own comparison against the upper
		// bound and goes through `emitCompare`, so `for i in 1 to "x"` is the ordinary comparison type
		// error; for an array it is `idx < __arr_count(arr)`, both operands compiler-minted integers.
		self.currentBlock = header
		var bound = limit
		if not isRange 'lengthReadLive'
			bound = self.emitRuntimeCall(ArrCountName, args: singletonArgs(source), resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(forTok))
		end 'lengthReadLive'
		let testOp = MaxonCmpOp.le if rangeInclusive else MaxonCmpOp.lt
		let cond = try self.emitCompare(indexPhi, rhs: bound, op: testOp, opTok: self.tokenAt(testAnchorIndex))

		let loopLabelTok = try self.consume(TokenKind.charLiteral)

		var body = self.newBlock(func, label: loopLabelTok.value, line: loopLabelTok.line)
		var step = self.newBlock(func, label: b"forstep", line: loopLabelTok.line)
		var exit = self.newBlock(func, label: b"forexit", line: forTok.line)
		self.emitCondBranch(header, cond: cond, thenId: body.id, elseId: exit.id, ifTok: forTok)

		// The loop variable: the index itself for a range, a BORROWED element read for an array. `_` is
		// the discard (`DiscardBindingName`) and binds nothing at all — declaring it would make an
		// ordinary `_ = f()` discard statement inside the body a write to a `let`.
		self.currentBlock = body
		var loopValue = indexPhi
		if not isRange 'readElement'
			loopValue = self.emitArrayElementAccessor(func, callee: ArrGetUncheckedName, args: pairArgs(source, second: indexPhi), giid: self.valueNameId(source), owned: false, borrowSubjectName: elementBorrowSubject, range: SourceRange.ofToken(nameTok))
		end 'readElement'
		if not nameTok.value.equals(DiscardBindingName) 'bindLoopVariable'
			// Declared in the `for`'s OWN frame (not the body's), so it is in scope for the whole body
			// and gone at the loop's `end`. Immutable: `for-iterator-immutable` pins `item = …` as E2013.
			let loopBinding = try self.scope.declareValueBinding(nameTok.value, varType: self.typeOf(loopValue), mutable: false, value: loopValue) otherwise throw ParseError.localShadowsSelfField(String.from(nameTok.value), typeName: String.from(self.enclosingType), line: nameTok.line, column: nameTok.column)
			// ⭐ E3070: the element this loop just read is a BORROW, and it is live for the BODY'S EXTENT
			// rather than to the variable's last use — see `attachPendingBorrows`'s `liveUntil`. `_` binds
			// nothing, so nothing can hold the element past its read and there is no borrow to record.
			self.attachPendingBorrows(func, borrower: loopBinding, boundValue: loopValue, liveUntil: bodyEndIndex)
		end 'bindLoopVariable'

		// `ownedFloor` is the owned-binding height NOW — above the iteration source's own binding, so a
		// `break` releases the body's declarations and leaves the source for the exit (see below).
		self.loops.push(LoopContext.create(loopLabelTok.value, continueTargetId: step.id, exitId: exit.id, phiVars: phiVars, ownedFloor: self.ownedBindings.count()))

		var bodyEnd = try self.parseBlockBody(func, block: body, label: loopLabelTok.value)

		// Guard the token scan against the parse it predicted — see `assertScanAligned`.
		self.assertScanAligned("parseForStatement", predictedEnd: bodyEndIndex)

		let ctx = try self.loops.pop() otherwise panic("parseForStatement: loop stack empty after body of '{String.from(loopLabelTok.value)}'")
		self.releaseIterationSource(sourceLock)

		// The step block, read off the context rather than spelled again — see `parseWhileStatement`'s
		// fall-through for why the two loop parsers share that derivation.
		if not bodyEnd.isTerminated() 'fallsToStep'
			self.recordBranchEdge(bodyEnd, targetId: ctx.continueTargetId, argIds: self.edgeArgsFor(phiVars, preLoop: false))
			self.emitBranch(bodyEnd, targetId: ctx.continueTargetId)
		end 'fallsToStep'

		// ⭐ **THE STEP BLOCK IS A MERGE, so it carries phis of its own.** Its predecessors are the
		// body's fall-through AND every `continue`, and a carried `var` assigned before a `continue`
		// holds a different value on each — the same shape the exit has for `break` (`wireLoopExit`).
		// The INDEX needs none: it is defined in the header, which dominates the step.
		self.currentBlock = step
		for k in 0 upto ctx.phiVars.count() 'mkStepPhi'
			var pv = try ctx.phiVars.get(k) otherwise panic("parseForStatement: phiVars.get OOB at {k}")
			pv.binding.boundValue = self.mintPhiForBinding(step, binding: pv.binding)
		end 'mkStepPhi'
		let one = self.emitLiteral(1, valueType: MaxonType.integer, range: SourceRange.ofToken(forTok))
		let nextIndex = self.emitMachineWordAdd(indexPhi, rhs: one, range: SourceRange.ofToken(forTok))
		self.recordBranchEdge(step, targetId: header.id, argIds: self.loopHeaderArgs(nextIndex, carried: self.edgeArgsFor(phiVars, preLoop: false)))
		self.emitBranch(step, targetId: header.id)

		// The header carries the two-way branch, so it is the exit's false-edge source. Run AFTER the
		// step wiring: `wireLoopExit` settles each carried binding's POST-loop value, and the step loop
		// above sets those same fields to its own phis on the way through.
		self.wireLoopExit(header, exit: exit, ctx: ctx)

		// The loop variable and the iteration source's binding both leave scope here — the drops for the
		// latter land in the exit block, which every non-terminating path through the loop reaches.
		self.currentBlock = exit
		self.emitScopeDrops(forMark.ownedCount, anchor: forTok)
		self.closeBlock(forMark)
		return exit
	end 'parseForStatement'

	// The block-arg list an edge into a `for` HEADER carries: the index value FIRST (the header's own
	// block-arg 0 — see `parseForStatement`), then one slot per carried binding. Both edges that name
	// the header go through here, so the index can never end up in a different slot on one of them.
	function loopHeaderArgs(indexValue ValueId, carried ValueIdArray) returns ValueIdArray
		var vals = ValueIdArray.create()
		vals.push(indexValue)
		for v in carried 'each'
			vals.push(v)
		end 'each'
		return vals
	end 'loopHeaderArgs'

	// ⭐ **WHAT A `for … in` MAY ITERATE THIS SLICE.** An `Array` instance — the only container whose
	// element read is a random-access index, which is what the counter lowering requires. Everything
	// else is a clean E2015 naming the gap rather than a silent acceptance: a String, a byte/codepoint
	// view, a `Set` and a `Map` each need a cursor protocol shv2 has not built.
	function requireIterableArray(source ValueId, forTok Token) throws ParseError
		if self.tagOf(source) == ValueTypeTag.genericInstance and self.signatures.isArrayInstance(self.valueNameId(source)) 'array'
			return
		end 'array'
		throw ParseError.unsupported("`for … in` over a `{typeTagName(self.tagOf(source))}` value — P1.8 slice A iterates an `Array` and the counted ranges `<lo> to <hi>` / `<lo> upto <hi>`; String / byte-view / codepoint / `Set` / `Map` iteration needs a cursor protocol that arrives with the later P1.8 slices", line: forTok.line, column: forTok.column)
	end 'requireIterableArray'

	// ⭐⭐ **WHAT A COUNTED RANGE'S BOUNDS MAY BE — the RANGE form's twin of `requireIterableArray`, and
	// the rung shipped without it.** A counted range is an INDEX PHI stepped by `emitMachineWordAdd`, a
	// raw i64 add; a bound of any other domain hands that add something it cannot step, and the failure
	// was never a diagnostic:
	//   • `for x in 1.0 to 3.0` reached the x64 emitter and PANICKED — *"rax is in the gpr register file
	//     where the xmm file is required"* (`X64Backend.maxon:1387`), an internal error against a program
	//     the runnable oracle refuses cleanly (`E3005: Range expressions require int or Character, got
	//     'Float'`);
	//   • `for b in false to true` was silently ACCEPTED and ran two trips, incrementing a BOOL.
	// Everything else happened to land on a comparison type error (`"a" to "c"`, `1 to 3.5`) — which is
	// luck, not a rule: it is `emitCompare` refusing two operands, and it says nothing about the STEP.
	//
	// ⚠ **The test is `tagIsIntegral`, NOT `== ValueTypeTag.integer`** — see `requireSetKeyMatchesType`'s
	// header for the measured false refusal the narrow spelling caused. A ranged alias (`typealias Row =
	// int(0 to 63)`) carries `named` until TypeResolution collapses it, and `for r in 0 to lastRow` where
	// `lastRow` is such a parameter must stay legal. A char literal is an integer codepoint here
	// (`ranges.character-range`), so `'a' to 'e'` passes for the reason it prints as one.
	//
	// Both bounds are asked, each anchored on its own half — the START on the source's first token, the
	// END on the `to`/`upto`, so a mixed range names the side that is wrong.
	function requireCountableRangeBound(bound ValueId, anchor Token) throws ParseError
		if tagIsIntegral(self.tagOf(bound)) 'countable'
			return
		end 'countable'

		throw ParseError.unsupported("a counted `for … in <lo> to|upto <hi>` range needs INTEGER bounds — got a '{typeTagName(self.tagOf(bound))}'. The loop variable is a counter stepped by 1, which no other domain has a meaning for; iterate a `float`/`String` by indexing an `Array` over it", line: anchor.line, column: anchor.column)
	end 'requireCountableRangeBound'

	// ⭐⭐ **MAKE THE ITERATED SOURCE UNWRITABLE FOR THE BODY** — the borrow's safety obligation, and the
	// reason `for n in arr 'l' … arr.push(9) … end` is **E3019** rather than a use-after-free. The loop
	// variable holds an element the ARRAY still owns, so a body that makes the array destroy it
	// (`clear`/`set`/`resize`/`remove`), or that rebinds the source out from under the loop, would leave
	// the borrow pointing at freed memory. The runnable oracle refuses the same program with the same
	// code, and the reference bootstrap locks the same thing across the body (`2-Parser.cs:13377-13390`).
	//
	// It records the binding a write would have to go THROUGH, which is the source itself for a bare name
	// and the chain's BASE for `for it in b.items` — the array's own value cannot identify it, because a
	// re-read of `b.items` inside the body mints a fresh ValueId for the same record.
	//
	// ⚠ **A UAF WAS MEASURED THROUGH EXACTLY THAT SECOND SHAPE**, which is why the lock is a list here and
	// not the two writability bits flipped on the binding: `for it in b.items 'scan' b.items.clear();
	// t = t + it.value end` returned **63 (0x3F, the free-poison byte)** where the answer is 5, because a
	// field-chain receiver never asks `immutableReceiverNameOf` at all (shv2 deliberately permits
	// `self.items.push(v)` through a `let`). The reference bootstrap's lock has the same reach and the same
	// hole — it keys on a VARIABLE name — and gets away with it only because it RETAINS the element.
	//
	// A source with no binding at all (a literal, a call result) locks nothing, and needs to: nothing else
	// can name that record, so no statement in the body can reach it.
	function lockIterationSource(sourceStart TokenIndex) returns bool
		if not self.sourceNamesABase(sourceStart) 'notAName'
			return false
		end 'notAName'

		// A SELF-FIELD ALIAS is locked like any other binding, and it has to be: `for it in items 'l'
		// items.clear() … end` inside a method reached the free-poison byte (0x3F) in a probe before it
		// was. The alias's `VarInfo` is installed once at method entry, so `scope.getInfo` hands back the
		// same object the write door resolves — see `selfFieldIsWritable`, which is where that door asks.
		// The name comes through `iterationSubjectNameAt` and NOT `baseBindingName`, because the subject
		// of `for it in self.items` is the FIELD, not the receiver — see that function.
		let baseName = self.iterationSubjectNameAt(sourceStart)
		if not self.scope.contains(baseName) 'notALocalBinding'
			return false
		end 'notALocalBinding'

		// COPY-ON-WRITE off the shared empty before the first push — see `sharedEmptyIterationLocks`.
		if self.iterationLockedBindings is sharedEmptyIterationLocks 'firstLockInThisFunction'
			self.iterationLockedBindings = VarInfoArray.create()
		end 'firstLockInThisFunction'

		self.iterationLockedBindings.push(self.scope.getInfo(baseName))
		return true
	end 'lockIterationSource'

	// ⭐⭐ **THE SCOPE NAME OF THE STORAGE A CHAIN AT `baseIndex` IS WRITTEN THROUGH — THE ONE
	// DERIVATION**, shared by the site that TAKES the iteration lock (`lockIterationSource`) and the
	// site that CONSULTS it for a field-chain write (`iterationLockNameAt`). A divergence between the
	// two is a use-after-free rather than a compile error, and it WAS one.
	//
	// ⚠ **`self.items` RESOLVES TO THE FIELD, NOT TO THE RECEIVER**, and that is the whole reason this
	// is not `baseBindingName`. A self-field's storage has TWO source spellings (`items`, `self.items`)
	// and FOUR write spellings, and `baseBindingName` answers `SelfParamName` for half of them — so the
	// lock and the doors keyed on two different objects for one storage and half the combinations
	// silently missed. MEASURED, before this: `for it in self.items 'l' items = IntArray.create() end`
	// SEGFAULTED (0xC0000005) and `for it in self.items 'l' items.clear() end` was silently ACCEPTED,
	// while the very same programs spelled `for it in items` were correctly E2013/E3019.
	//
	// Nothing is lost by not naming the receiver: `self` is a PARAMETER and no write can go through it
	// (`requireMutableBinding`), so it was never the subject. And the field's name resolves to the one
	// alias `VarInfo` every spelling reaches, because a local may NOT shadow a self-field name inside a
	// method (`Scope.declareBinding`, E3006) — the name is unambiguous by construction, not by luck.
	function iterationSubjectNameAt(baseIndex TokenIndex) returns ByteArray
		let baseTok = self.tokenAt(baseIndex)
		if baseTok.kind != TokenKind.self 'namesItself'
			return baseTok.value
		end 'namesItself'

		if self.kindAt(baseIndex + 1) == TokenKind.dot and self.kindAt(baseIndex + 2) == TokenKind.identifier 'selfRootedChain'
			return self.tokenAt(baseIndex + 2).value
		end 'selfRootedChain'

		// A bare `self` with no hop denotes the receiver itself, which is what `baseBindingName` says.
		return SelfParamName
	end 'iterationSubjectNameAt'

	// Is the iteration source at `sourceStart` a plain NAME or a FIELD CHAIN rooted at one — the two
	// shapes whose base binding is what a write has to go through? It is exactly such a chain when the
	// shared walk ends where the source's own tokens did (the cursor); a call, a literal or an operator
	// expression ends elsewhere and locks nothing. `AnyFieldHops`, because a BARE name is the common
	// case and is every bit as lockable as `b.items`.
	function sourceNamesABase(sourceStart TokenIndex) returns bool
		return self.fieldChainEndAfter(sourceStart, minHops: AnyFieldHops) == self.pos
	end 'sourceNamesABase'

	// Undo `lockIterationSource` once the body is parsed — the source is writable again on the next line.
	// The list is a stack (a nested `for` pushes above this one and pops first), so the release is a pop.
	function releaseIterationSource(locked bool)
		if not locked 'nothingLocked'
			return
		end 'nothingLocked'
		_ = try self.iterationLockedBindings.pop() otherwise panic("releaseIterationSource: the iteration lock stack is empty — every lock is pushed by `lockIterationSource` and popped exactly once here")
	end 'releaseIterationSource'

	// ⭐⭐ **IS `binding` BEING ITERATED BY AN ENCLOSING `for … in`?** THE one fact, and it is read at
	// exactly the FIVE doors a write can NAME the iterated array through. Each one alone leaves a
	// use-after-free open, which is why they share this rather than each carrying its own flag:
	//   • `immutableReceiverNameOf` — `arr.clear()` on the source binding itself, and the same binding
	//     handed to a callee that mutates it (`grow(arr)`, whose blame name this also supplies);
	//   • `parseFieldChainCall` — `b.items.clear()`, whose receiver is a VALUE and so never asks the
	//     binding question at all (the shape the first 0x3F probe found);
	//   • `selfFieldIsWritable` — `items.clear()` on a bare self-field alias, whose receiver binding is
	//     MINTED FRESH per access and so cannot be found by identity (the second 0x3F probe);
	//   • `requireMutableBinding` — `arr = other`, which drops the record the loop is still walking;
	//   • `emitCheckedSelfFieldStore` — `items = other` / `self.items = other`, the SAME rebinding one
	//     indirection out. It was the door this rung shipped without and it SEGFAULTED (0xC0000005 on
	//     every one of the four source×write spellings); see that function.
	//
	// ⭐ **TWO KEYS, ONE LIST — and which key is used is DERIVED from the binding, never chosen by a
	// caller.** A LOCAL is matched by OBJECT IDENTITY, so a body that shadows the source's name declares
	// a different `VarInfo` and is correctly writable. A FIELD OF THE ENCLOSING `self` is matched by its
	// LAYOUT INDEX (`selfFieldIsIterationLocked`), because `emitCheckedSelfFieldStore` holds an index and
	// no alias at all, and because the alias is the only object identity available to the other doors.
	// Every live entry belongs to the function being parsed (`iterationLockedBindings` is reset per
	// function), and a function belongs to one type, so an index cannot mean a field of another layout.
	// A linear scan over a list whose length is the enclosing `for` nesting depth.
	//
	// ⚠⚠ **WHAT IT DOES NOT COVER, AND WHY THAT IS NOT THIS CONSTRUCT'S BUG.** The lock stops a write
	// the loop's own source NAMES. It cannot stop one that reaches the array without naming it — a field
	// chain handed to a mutating callee (`wipe(b.items)`), or a method of the enclosing struct that
	// clears its own field (`b.wipe()`, which shv2 rules does not implicate the caller — see
	// `receiverOwnerMask`). Both destroy the element the loop borrowed, and both read 0x3F.
	//
	// **They are the PRE-EXISTING borrow-on-get hazard, not a for-in one, and the proof is that neither
	// needs a loop:** `let it = try arr.get(0) otherwise …` then `arr.clear()` then `it.value` reads the
	// same 0x3F with no `for` in the program. `for … in` reads its element through the SAME door
	// (`emitArrayElementAccessor(owned: false)`) under the SAME rule, so it inherits that hazard and
	// adds none. Its cure is the thesis decision PLAN.md's P1.7 Slice 3a residual (a) already names —
	// incref-on-get, copy-on-get, or E3070 borrow-liveness — and it is not a loop's to make. The
	// runnable oracle ACCEPTS both uncovered programs (measured: `wipe(b.items)` returns 5), because it
	// RETAINS the element; refusing them here would diverge from it on a legal program while the other
	// half of the same class stayed open.
	//
	// ⚠ **THE EMPTY CHECK IS NOT DEFENSIVE, IT IS THE COST.** Two of the three readers run on the hot
	// statement path (every assignment, every container method call), and the list is empty in every
	// function that contains no `for … in` at all — which, on the scale corpus, is all of them. Entering
	// the walk regardless billed **+270 allocations at rung 0 rising to +2,564 at rung 5** (linear, A/B
	// against the parent built in the same worktree): a `for x in <Array>` over an EMPTY array still
	// materializes the backing record the loop reads its length from. Answering `false` off a `count()`
	// makes the common path free and leaves the walk for the loops that actually have a lock.
	function bindingIsIterationLocked(binding VarInfo) returns bool
		if binding.isSelfField 'fieldOfTheEnclosingSelf'
			return self.selfFieldIsIterationLocked(binding.fieldIndex)
		end 'fieldOfTheEnclosingSelf'

		if self.iterationLockedBindings.count() == 0 'noEnclosingForIn'
			return false
		end 'noEnclosingForIn'

		for locked in self.iterationLockedBindings 'each'
			if locked is binding 'match'
				return true
			end 'match'
		end 'each'
		return false
	end 'bindingIsIterationLocked'

	// ⭐ **IS FIELD `index` OF THE ENCLOSING `self` BEING ITERATED?** The INDEX-keyed half of the one
	// lock above, split out for the door that has an index and no binding: the self-field STORE
	// (`emitCheckedSelfFieldStore`), which both `items = x` and `self.items = x` converge on. Reading the
	// same list under the key that door actually holds is what keeps the two spellings from needing two
	// rules — the shape that let four spellings of one write disagree in the first place.
	function selfFieldIsIterationLocked(index FieldIndex) returns bool
		if self.iterationLockedBindings.count() == 0 'noEnclosingForIn'
			return false
		end 'noEnclosingForIn'

		for locked in self.iterationLockedBindings 'each'
			if locked.isSelfField and locked.fieldIndex == index 'match'
				return true
			end 'match'
		end 'each'
		return false
	end 'selfFieldIsIterationLocked'

	// The E3019 blame name for a write reached through a FIELD CHAIN (`b.items.push(x)`) — non-empty only
	// while an enclosing `for` is iterating through that base. It asks the iteration lock and NOT
	// `immutableReceiverNameOf`, deliberately: shv2 rules that a container held in a FIELD may be written
	// through a `let` base (`receiverOwnerMask`'s header records the measurement and the ruling), so
	// routing the chain through the general rule would newly reject programs the corpus pins.
	// It takes the SUBJECT'S NAME already resolved rather than the base token's index, and that is two
	// reasons which are one reason: the subject of `self.items.clear()` is `items`, and blaming `self` sent
	// the reader to a parameter nothing could be done about (`iterationSubjectNameAt`); and E3070's door at
	// the same call site needs the identical answer — so it is derived ONCE, by `borrowSubjectNameAt`, and
	// handed to both. Empty in, empty out: a chain over no nameable storage locks nothing.
	//
	// ⚠ It resolves through `borrowSubjectBindingOf` and NOT `scope.getInfo`, because the subject space is
	// wider than `Scope`: a MODULE-storage subject has a stand-in `VarInfo` that no scope holds, and
	// `getInfo` panics on a name it does not have. A stand-in is never pushed by `lockIterationSource`
	// (which locks only what `Scope` holds), so it correctly answers "not locked" by identity.
	function iterationLockNameOf(subjectName ByteArray) returns ByteArray
		if subjectName.isEmpty() 'namesNoStorage'
			return EmptySourceText
		end 'namesNoStorage'

		if not self.bindingIsIterationLocked(self.borrowSubjectBindingOf(subjectName)) 'writable'
			return EmptySourceText
		end 'writable'

		return subjectName
	end 'iterationLockNameOf'

	// ⭐⭐ **THE STORAGE A CHAIN AT `baseIndex` NAMES, or empty when it names none** — `iterationSubjectNameAt`
	// (THE one derivation of *which binding a write goes through*) plus the one test that says the name denotes
	// storage this function body can reason about at all.
	//
	// **Two predicates share it, and that sharing IS the E3070 design.** The iteration lock asks of this name
	// *"is this binding being iterated?"* (`iterationLockNameAt`, immediately above); the borrow set asks
	// *"is an element of it still referenced?"* (`borrowSubjectIdOf`). Written twice, a chain shape taught to
	// one and not the other would leave a write locked under one key and checked under another — which is
	// precisely the divergence `iterationSubjectNameAt`'s ⚠ block records as a measured segfault.
	//
	// ⭐⭐ **A TOP-LEVEL `var` IS STORAGE THIS BODY CAN NAME TOO, and leaving it out was a REACHABLE
	// USE-AFTER-FREE.** `var g = [...]` at module scope with `let s = try g.get(0) otherwise ""` then
	// `g.clear()` compiled clean and faulted with **0xC0000005** — the oracle reports E3070 on that very
	// program. The same array reached through `grow(g)`, a rebind `g = <fresh>` (whose store decrefs the
	// record the slot held — `emitCheckedGlobalStore`) and `for it in g` each faulted the same way. A
	// global differs from a local in WHERE the record is anchored and in nothing a borrow can see.
	//
	// ⚠ **LOCAL FIRST, which is what keeps a shadowing local a DIFFERENT subject** — the same order
	// `parseAssignment` resolves an assignment target in, and the reason `shadowed-source-is-writable`
	// compiles. A name that reaches the second test is one no binding of this frame holds.
	function borrowSubjectNameAt(baseIndex TokenIndex) returns ByteArray
		let baseName = self.iterationSubjectNameAt(baseIndex)
		if self.scope.contains(baseName) 'bindingOfThisFrame'
			return baseName
		end 'bindingOfThisFrame'

		return baseName if self.namesWritableModuleStorage(baseName) else EmptySourceText
	end 'borrowSubjectNameAt'

	// Does `name` denote a top-level `var` — module storage a body can BORROW an element out of and can
	// WRITE? An immutable top-level binding is excluded on purpose rather than for tidiness: every write
	// door refuses it already (E2013 at `storeToGlobal`, E3019 at `noteReceiverWrite`), so it can never be
	// half of a conflict, and admitting it would mint borrows and subjects no diagnostic could ever read.
	//
	// ⚠ **THE BOOL GATE IN FRONT OF THE RESOLUTION IS THE COST**, and it is `managedTopLevelBaseAt`'s for
	// its reason: `globalDeclFor` BOXES a union per call, while this runs on every array-method and
	// struct-method receiver in the program. `namesManagedTopLevel` is a set membership test and a `false`
	// from it is final, so a program with no top-level managed binding — the whole scale corpus — never
	// reaches the box.
	function namesWritableModuleStorage(name ByteArray) returns bool
		if not self.signatures.namesManagedTopLevel(name) 'notAManagedTopLevelName'
			return false
		end 'notAManagedTopLevelName'

		return match self.signatures.globalDeclFor(name, readerFilePath: self.filePath) 'global'
			found(_, _, mutable) gives mutable
			notFound gives false
		end 'global'
	end 'namesWritableModuleStorage'

	// ⭐⭐ **THE BINDING A SUBJECT NAME DENOTES — THE ONE RESOLUTION, and the only place the two kinds of
	// storage are told apart.** A name `Scope` holds is that binding; anything else reaching here is a
	// top-level `var` (`borrowSubjectNameAt` admits nothing else) and gets its interned stand-in.
	//
	// Every asker of "which storage is this?" comes through here — the subject id, the storage mask, and
	// the iteration lock — so a third kind of storage taught to one of them is taught to all three.
	function borrowSubjectBindingOf(subjectName ByteArray) returns VarInfo
		if self.scope.contains(subjectName) 'bindingOfThisFrame'
			return self.scope.getInfo(subjectName)
		end 'bindingOfThisFrame'

		return self.topLevelBorrowSubjectOf(subjectName)
	end 'borrowSubjectBindingOf'

	// ⭐ **ONE STAND-IN PER TOP-LEVEL NAME, INTERNED FOR THE FILE** — see
	// `VarInfo.createModuleStorageSubject` for what it stands in for and why identity on the parser's
	// per-access receiver bindings would not do. Interning is what makes `g.get(0)` on line 4 and
	// `g.clear()` on line 5 the SAME subject.
	//
	// COPY-ON-WRITE off the shared empty (`sharedEmptyTopLevelBorrowSubjects`), the
	// `sharedEmptyIterationLocks` pattern with its invariant: a `Parser` is built per top-level constant by
	// `SignatureIndex.walkConstInitializer`, so an unconditional `create()` in the constructor would be one
	// map per constant in the program, and the overwhelming majority of files name no writable global at a
	// borrow subject at all.
	function topLevelBorrowSubjectOf(subjectName ByteArray) returns VarInfo
		let existing = try self.topLevelBorrowSubjects.get(subjectName) otherwise 'mint'
			if self.topLevelBorrowSubjects is sharedEmptyTopLevelBorrowSubjects 'firstSubjectInThisFile'
				self.topLevelBorrowSubjects = VarInfoMap.create()
			end 'firstSubjectInThisFile'

			let minted = VarInfo.createModuleStorageSubject(subjectName, varType: self.moduleStorageTypeOf(subjectName))
			self.topLevelBorrowSubjects.upsert(subjectName, value: minted)
			return minted
		end 'mint'
		return existing
	end 'topLevelBorrowSubjectOf'

	// The declared type of the top-level `var` `subjectName` names, read through the ONE home of that
	// question. A `notFound` is impossible rather than merely unexpected — `borrowSubjectNameAt` admits a
	// name only past `namesWritableModuleStorage`, which resolves through this very lookup — so it panics
	// rather than inventing a type nothing declared.
	function moduleStorageTypeOf(subjectName ByteArray) returns MaxonType
		match self.signatures.globalDeclFor(subjectName, readerFilePath: self.filePath) 'global'
			found(_, valueType, _) then return valueType
			notFound then panic("moduleStorageTypeOf: '{String.from(subjectName)}' is not a top-level binding — a subject name reaches here only past `namesWritableModuleStorage`, which asks this same lookup")
		end 'global'
	end 'moduleStorageTypeOf'

	// ⭐ **THE FUNCTION'S BORROW FACTS, COPY-ON-WRITTEN off the shared empty before the first write.** A body
	// that borrows nothing keeps the shared instance for its whole life and allocates not one array — the
	// `sharedEmptyIterationLocks` pattern, with the same invariant: the shared instance is NEVER mutated, so
	// it is safe across the per-file parse fan-out. Every writer below comes through here first.
	// ⚠ **ASKED BEFORE A SUBJECT NAME IS DERIVED, AND THAT ORDER IS THE COST.** Deriving one costs a
	// `Scope` hash lookup, and two of the write doors — the local rebind and the self-field store — sit on
	// the hot statement path. A write ABOVE every borrow's activation can never conflict (the resolver
	// rejects it on `activationToken > site.token`), so a function that has not yet completed a borrow —
	// nearly every function in any program — answers `false` off one read of a permanently empty array and
	// pays nothing else. The same reading `bindingIsIterationLocked`'s own empty check states, for the same
	// reason: it is not defensive, it IS the cost.
	//
	// ⚠ **TWO SITES DERIVE THE SUBJECT FIRST ANYWAY, AND THAT IS MEASURED RATHER THAN OVERLOOKED.** A method
	// call on an array or a struct resolves its subject unconditionally (`parseArrayMethodCall`,
	// `dispatchMethodOnBinding`), because the name is needed to MINT a borrow as well as to record a write —
	// and minting happens precisely when no borrow exists yet, so the gate cannot be hoisted in front of it.
	// The optimizer measured the one variant that could be — gating the array-method derivation on
	// `functionHoldsABorrow() or arrayElementIsManaged()` — and it read -19k +120k -228k -618k ticks,
	// SIGN-FLIPPING across the ladder, i.e. inside the noise band. It does not ship.
	function functionHoldsABorrow(func IrFunction) returns bool
		return func.borrowFacts.borrows.count() > 0
	end 'functionHoldsABorrow'

	function borrowFactsOf(func IrFunction) returns BorrowFacts
		if func.borrowFacts is sharedEmptyBorrowFacts 'firstFactInThisFunction'
			func.borrowFacts = BorrowFacts.create()
		end 'firstFactInThisFunction'
		return func.borrowFacts
	end 'borrowFactsOf'

	// ⭐ **THE SUBJECT ID FOR `subjectName` — resolved through `Scope`, so the KEY is the binding and not the
	// spelling.** A body that SHADOWS a borrowed array's name declares a different `VarInfo` and gets a
	// different subject (correctly writable); a self-field's two spellings (`items`, `self.items`) both resolve
	// to the ONE alias installed at method entry and share one subject. That is the same two-property key
	// `bindingIsIterationLocked` matches by object identity, reached the same way.
	//
	// A linear scan over a list whose length is the number of DISTINCT storages this body borrows from or
	// writes — a handful — and it is only ever entered once a borrow exists (`noteBorrowSubjectWrite`'s gate).
	// Callers must have established that the name denotes storage, which `borrowSubjectNameAt` is.
	function borrowSubjectIdOf(func IrFunction, subjectName ByteArray) returns BorrowSubjectId
		let binding = self.borrowSubjectBindingOf(subjectName)
		var facts = self.borrowFactsOf(func)
		for k in 0 upto facts.subjects.count() 'seen'
			if (try facts.subjects.get(k) otherwise panic("borrowSubjectIdOf: subjects.get OOB at {k} inside count()")) is binding 'match'
				return k
			end 'match'
		end 'seen'

		facts.subjects.push(binding)
		return facts.subjects.count() - 1
	end 'borrowSubjectIdOf'

	// Record that the element accessor at `range` handed out a BORROW of `subjectName`. Pending until a
	// binding takes it (`attachPendingBorrows`) — an accessor whose result no name holds is unreachable
	// afterwards and borrows nothing that could dangle.
	function mintPendingBorrow(func IrFunction, subjectName ByteArray, borrowValue ValueId, range SourceRange)
		// The id is minted FIRST because `borrowSubjectIdOf` is what copy-on-writes the facts off the shared
		// empty — so the push below is always into this function's own.
		let subject = self.borrowSubjectIdOf(func, subjectName: subjectName)
		func.borrowFacts.pending.push(PendingBorrow.create(subject, borrowValue: borrowValue, borrowLine: range.line))
	end 'mintPendingBorrow'

	// ⭐⭐ **MOVE A PENDING BORROW ONTO THE VALUE A `try` MERGE HANDS BACK.** `let s = try arr.get(0)
	// otherwise ""` does not bind the accessor's result — it binds the CONTINUATION PHI the two edges meet
	// at — so without this the binding would claim nothing and the borrow would silently vanish.
	//
	// It is called from the ONE site that mints that phi (`finishValueTry`), so the key and the value the
	// source actually binds move together and cannot drift apart. The DIVERGING forms need no retarget and
	// correctly get none: `otherwise return`/`throw`/`panic` leave the accessor's own result as the try's
	// value, and so does a propagating `try`.
	function retargetPendingBorrow(func IrFunction, from ValueId, to ValueId)
		// Scanned from the END and stopped at the match, for the reason `attachPendingBorrows` states: a
		// value id is DEFINED ONCE, so at most one entry can carry it, and the one a merge is retargeting was
		// almost always minted by the very expression the merge closes. Both walks are over a list one
		// statement long (`dropUnclaimedPendingBorrows`), so neither can grow with the body.
		var k = func.borrowFacts.pending.count()
		while k > 0 'each'
			k = k - 1
			let pending = try func.borrowFacts.pending.get(k) otherwise panic("retargetPendingBorrow: pending.get OOB at {k} inside count()")
			if pending.borrowValue == from 'thisOne'
				// The entry is REBUILT rather than written through: a `for … in` element is an immutable binding
				// and a field store through one is E2013, which is the language's rule and not a limitation to
				// route around.
				try func.borrowFacts.pending.set(k, value: PendingBorrow.create(pending.subject, borrowValue: to, borrowLine: pending.borrowLine)) otherwise panic("retargetPendingBorrow: pending.set OOB at {k}, the index just read")
				return
			end 'thisOne'
		end 'each'
	end 'retargetPendingBorrow'

	// ⭐⭐ **CUT THE PENDING CLAIM LIST BACK TO `mark` — the ONE thing that keeps it from growing with the
	// function body.** A `PendingBorrow` is minted by an element ACCESSOR and claimed by the BINDING or the
	// MERGE that takes its value, and every one of those claimants is inside the same STATEMENT as the
	// accessor. So whatever is still pending when a statement ends can never be claimed, and both walks over
	// this list (`retargetPendingBorrow`, `attachPendingBorrows`) would otherwise re-read it for the rest of
	// the body.
	//
	// It is a WATERMARK and not a reset, and that distinction is the whole reason this is safe where a reset
	// was not: `let s = try arr.get(0) otherwise return 1` parses its handler by RE-ENTERING the statement
	// parser mid-initializer, and a reset there wiped the OUTER statement's mint — no borrow recorded, the
	// following `arr.clear()` waved through, measured **0xC0000005** (see `PendingBorrow`'s ⭐⭐ block). The
	// nested parse takes its own mark ABOVE the outer's entry and can only ever cut back to it.
	//
	// ⚠ **`parseStatements` IS THE ONLY CALLER, AND MUST STAY SO.** The two direct `parseStatement` call
	// sites — a `try … otherwise return/break/continue` handler and a `match` arm body — are both re-entrant
	// parses INSIDE a statement whose accessors are still claimable; cutting there is exactly the reset that
	// segfaulted. Their leftovers are cut by the enclosing statement's own mark instead.
	//
	// MEASURED, on `Testing/ladders/genborrow.sh <K> pending` — K statements of `s = try arr.get(0)
	// otherwise ""`, an ASSIGNMENT, which takes no borrow a binding can complete and so left one entry behind
	// each time. Before: +0.44M / +0.48M / +2.02M / +7.74M / +24.2M CPU ticks over the parent binary at
	// K = 64 … 1024 — ×4.2 ×3.8 ×3.1 per doubling, and 19% of `phase:parse` at K=1024.
	function dropUnclaimedPendingBorrows(func IrFunction, mark PendingBorrowCount)
		while func.borrowFacts.pending.count() > mark 'dropOne'
			_ = try func.borrowFacts.pending.remove(func.borrowFacts.pending.count() - 1) otherwise panic("dropUnclaimedPendingBorrows: pending.remove OOB at the last index of a non-empty list")
		end 'dropOne'
	end 'dropUnclaimedPendingBorrows'

	// ⭐ **COMPLETE, AT THE BINDING, EVERY BORROW THE INITIALIZER JUST TOOK.** This is where the borrowing NAME
	// and the ACTIVATION point exist, and activating here rather than at the accessor is what makes a mutation
	// inside a `try … otherwise` HANDLER legal: the handler is parsed BEFORE this runs, so its writes sit below
	// the activation and the ordering says "not borrowed yet" by construction rather than by a special case.
	// Both references are emphatic about the same choice (`MaxonBorrowCheck.maxon:425-428`;
	// `BorrowCheckPass.cs:72-80`).
	//
	// Everything pending belongs to THIS statement: `parseStatements` cuts the list back to its entry
	// watermark after every one (`dropUnclaimedPendingBorrows`), so nothing an earlier statement minted and
	// no name took can still be here to be claimed by the wrong binding.
	//
	// ⭐⭐ **`liveUntil` IS WHERE THE TWO BORROW KINDS DIFFER, AND IT IS THE WHOLE DIFFERENCE.**
	//
	//   • A `let`/`var` binding passes **`self.pos`** — the activation itself, so a name never read again is
	//     dead the instant it is bound and only a real later use extends it. That is NLL, and it is what
	//     keeps `borrow-nll-allowed` compiling.
	//   • A `for … in` ELEMENT passes the loop's **`end`** — its liveness is LEXICAL, the body's extent, and
	//     ordinary NLL there is a use-after-free:
	//
	//         for it in arr 'l'
	//             wipe(arr)        // the borrow must be live HERE …
	//         end 'l'              // … even though `it` is never read again
	//
	//     The last use of `it` is at or before the write, so last-use liveness would call the borrow dead
	//     and wave the program through — but the ITERATION keeps reading the record on every later trip
	//     (`__arr_count` in the header, `__arr_get_unchecked` for the element), so the freed buffer is read
	//     again. The body's extent IS that liveness, and it is exactly what P1.8 Slice A's lexical lock
	//     already models, so the two halves of one `for` agree instead of one expiring under the other.
	//
	// `requireBindingLive` only ever moves a last use FORWARD, so an ordinary read of the loop variable
	// inside the body cannot shorten the lexical extent back to itself.
	function attachPendingBorrows(func IrFunction, borrower VarInfo, boundValue ValueId, liveUntil TokenIndex)
		var facts = func.borrowFacts
		if facts.pending.count() == 0 'borrowedNothing'
			return
		end 'borrowedNothing'

		// Scanned from the END, because the borrow a name claims is almost always the one its own initializer
		// just minted; and the claimed entry is REMOVED, which keeps the list down to the accessors no name
		// took.
		//
		// ⚠ **IT RUNS ON PAST THE FIRST MATCH, AND THAT IS LOAD-BEARING RATHER THAN BELT-AND-BRACES.** A
		// MERGE retargets EVERY arm's pending borrow onto the one phi (`finalizeMatchGives` calls
		// `retargetPendingBorrow` per give), so `let s = match m 'p' first gives try a.get(0) otherwise ""
		// second gives try b.get(0) otherwise "" end 'p'` leaves TWO entries carrying the phi's id — one per
		// SUBJECT — and `s` genuinely borrows out of both. MEASURED: both `a.clear()` and `b.clear()` are
		// refused, and a `return` here would silently drop whichever arm was minted first, waving one of them
		// through as a use-after-free. `borrow-liveness.md:match-gives-merges-every-arms-borrow` pins it.
		var k = facts.pending.count()
		while k > 0 'findTheValueThisNameBinds'
			k = k - 1
			let pending = try facts.pending.get(k) otherwise panic("attachPendingBorrows: pending.get OOB at {k} inside count()")
			if pending.borrowValue != boundValue 'someOtherValue'
				continue
			end 'someOtherValue'

			facts.borrows.push(BorrowRecord.create(pending.subject, borrower: borrower, activationToken: self.pos, borrowLine: pending.borrowLine))
			_ = try facts.pending.remove(k) otherwise panic("attachPendingBorrows: pending.remove OOB at {k}, the index this loop just read")

			// FORWARD-ONLY, the same rule `requireBindingLive` writes this field under. Both writers obey it,
			// so a seed can never pull a live borrow's last use BACKWARDS — which would expire it early, and
			// that is a use-after-free with no diagnostic anywhere.
			if liveUntil > borrower.lastUseToken 'extendsTheBorrowersLife'
				borrower.lastUseToken = liveUntil
			end 'extendsTheBorrowersLife'
		end 'findTheValueThisNameBinds'
	end 'attachPendingBorrows'

	// ⭐⭐ **RECORD A WRITE THAT GOES THROUGH A BORROW SUBJECT — the SECOND predicate over the one derivation.**
	// Called at every door `bindingIsIterationLocked` is, for exactly the same reason: a write can NAME the
	// array through a binding receiver, a field chain, a self-field alias, a rebind of the binding, or a
	// self-field store, and each one alone leaves a use-after-free open.
	//
	// ⚠ It is called at ONE door the lock is not — the MODULE-STORAGE rebind (`storeToGlobal`) — and that is
	// a difference in SUBJECT SPACE, not in the rule: the lock only ever holds bindings `Scope` gave it, so
	// a top-level `var` cannot be iteration-locked, while a borrow out of one is an ordinary borrow (see
	// `borrowSubjectNameAt`, which is where the two subject spaces meet).
	//
	// ⚠ **THE `borrows.count()` GATE IS NOT DEFENSIVE, IT IS THE COST.** Two of these doors sit on the hot
	// statement path (every assignment, every container method call). A write ABOVE every borrow's activation
	// can never conflict — the resolver would reject it on `activationToken > site.token` — so a function that
	// has not yet completed a borrow records nothing, allocates nothing, and leaves its facts at the shared
	// empty. That is the same reading `bindingIsIterationLocked`'s own empty check states, and the same reason.
	function noteBorrowSubjectWrite(func IrFunction, subjectName ByteArray, display ByteArray, anchor Token, mutatesSubject bool)
		if not mutatesSubject or subjectName.isEmpty() 'notAWriteThroughANamedBinding'
			return
		end 'notAWriteThroughANamedBinding'

		if not self.functionHoldsABorrow(func) 'nothingBorrowedYet'
			return
		end 'nothingBorrowedYet'

		func.borrowFacts.mutations.push(MutationSite.createContainerWrite(self.borrowSubjectIdOf(func, subjectName: subjectName), subjectName: subjectName, token: self.pos, line: anchor.line, column: anchor.column, display: display))
	end 'noteBorrowSubjectWrite'

	// ⭐ **THE CALL-ARGUMENT DOOR: a borrow subject handed to a CALLEE.** `grow(arr)` destroys the element the caller
	// borrowed exactly as `arr.clear()` does (measured: the oracle reports E3070 and shv2 segfaulted), and it
	// is the one write the parser cannot settle — whether `grow` mutates what it was handed depends on its
	// BODY, possibly in another file. So the site is recorded with the callee and the argument's column and
	// SemanticCheck settles it against the whole-program `ParamMutationSummary` (`mutationSiteWrites`), the
	// same summary E3019's call-site half reads. Never a second copy of "which parameters does this callee
	// write" — that question already has one home.
	//
	// The diagnostic anchors on the CALL, not the argument, which is the oracle's anchor (measured `10:2` for
	// `\tgrow(arr)` — the callee token) and the anchor `checkImmutableArgToMutatingParam` already uses.
	function noteBorrowSubjectCallArg(func IrFunction, callee ByteArray, anchor Token, argColumn ParamCount, argLabel ByteArray, valueStart TokenIndex)
		if not self.functionHoldsABorrow(func) 'nothingBorrowedYet'
			return
		end 'nothingBorrowedYet'

		// ⚠ **AN UNNAMED CALLEE IS A WITNESS DISPATCH, AND THE QUESTION IS UNASKABLE — NOT MERELY UNASKED.**
		// The conflict this door records is "does the CALLEE write the storage this argument names?", answered
		// from the by-callee mutation summary. Under dictionary-passing a witness dispatch resolves to no one
		// impl, so there is no callee to key on (`parseWitnessMethodOnValue` passes empty, for the same reason
		// it discards `argImmutableNames` — E3019 cannot ask there either). Refused HERE, explicitly, because
		// recording a site whose summary lookup is guaranteed to miss would be a silent no-op wearing the shape
		// of a check.
		if callee.isEmpty() 'noSingleCallee'
			return
		end 'noSingleCallee'

		// ⭐ **A FIELD CHAIN COUNTS, NOT ONLY A BARE NAME**, and it has to: `wipe(b.items)` destroys the
		// element a `for it in b.items` — or a `let s = try b.items.get(0)` — is holding, and it is the one
		// route P1.8 Slice A's lock structurally cannot reach (its five doors all NAME the array; this one
		// hands it to a callee). The predicate is `sourceNamesABase`, THE shared walk `for … in` decides
		// lockability with, so an argument shape the lock understands is an argument shape this door
		// understands. E3019's own bare-name rule is untouched — it asks `argWasBareName`, a different
		// question about a different blame.
		if not self.sourceNamesABase(valueStart) 'notANameableStorage'
			return
		end 'notANameableStorage'

		self.recordCallArgMutationSite(func, callee: callee, anchor: anchor, argColumn: argColumn, argLabel: argLabel, subjectName: self.borrowSubjectNameAt(valueStart))
	end 'noteBorrowSubjectCallArg'

	// The recorder every call-ARGUMENT door shares, taking the subject ALREADY RESOLVED — which is the whole
	// difference from `noteBorrowSubjectCallArg` above, and why it is a separate function rather than an
	// overload: the SOURCE's arguments have to be shape-tested to find a subject, while the prepended
	// RECEIVER was handed one by the base that produced it, and `self` supplies several. One record, one
	// column convention, one settlement against the storage mask.
	//
	// The `functionHoldsABorrow` test is paid TWICE on the source-argument path (its caller asks first, to
	// keep a `Scope` walk off the hot statement path — see `functionHoldsABorrow`). That is deliberate: this
	// is the authority, and the caller's is the cost gate.
	function recordCallArgMutationSite(func IrFunction, callee ByteArray, anchor Token, argColumn ParamCount, argLabel ByteArray, subjectName ByteArray)
		if subjectName.isEmpty() 'namesNoStorage'
			return
		end 'namesNoStorage'

		if not self.functionHoldsABorrow(func) 'nothingBorrowedYet'
			return
		end 'nothingBorrowedYet'

		func.borrowFacts.mutations.push(MutationSite.createCallArgWrite(self.borrowSubjectIdOf(func, subjectName: subjectName), subjectName: subjectName, token: self.pos, line: anchor.line, column: anchor.column, callee: callee, argColumn: argColumn, argLabel: argLabel))
	end 'recordCallArgMutationSite'

	// The index of the `end` token that closes the block statement opening at `startIndex`,
	// found by counting block openers against `end`s — the same depth-counted token walk
	// `skipBalancedParens` does for `(`/`)`, and run for the same reason: the answer is needed
	// BEFORE the real parse reaches it. The cursor is not moved.
	//
	// `continuesAtElse` is the ONE difference between the two constructs that call this, and it
	// is exactly the fact that a loop's extent ends at its first depth-0 `end` while an `if`
	// chain's does not:
	//   • `while` passes FALSE — the first depth-0 `end` closes the loop.
	//   • `if` passes TRUE — at each depth-0 `end` the scan PEEKS past the optional block label
	//     (`elseFollowsEnd`); a following `else` opens the next branch (a plain `else`, or the
	//     `if` of an `else if`), re-opens the depth, and the scan carries on, so the extent
	//     spans the then body AND every `else`/`else if` branch through the final `end`.
	//
	// Deliberately TOLERANT of a malformed tail, like `scanFunctionSignatures`: an unterminated
	// construct yields the end of the token stream rather than a diagnostic. That
	// over-approximates the extent, which is the SAFE direction (a carried set is never too
	// SMALL — see `parseWhileStatement` / `assignedBindingsIn`), and the real parse runs next
	// and reports the unexpected EOF with a position.
	//
	// ⭐ **A NESTED CONSTRUCT IS STEPPED OVER, NOT WALKED INTO, AND THAT IS WHAT MAKES THIS LINEAR.** The
	// walk itself is unchanged — the depth counting, the `elseFollowsEnd` continuation and the tolerant
	// tail all still decide the answer — but a construct opening at depth ≥ 1 has its whole extent skipped
	// in ONE array read (`matchingEndOf`). That cannot change the answer: inside a nested pair the depth
	// never returns to 0, so neither the `depth == 0` test nor `elseFollowsEnd` could have fired there, and
	// the pair contributes net zero to the depth on the way through.
	//
	// Walking IN is what made this scan cost `O(depth × tokens)`: a construct nested D deep had its tokens
	// re-walked by all D scans enclosing it. MEASURED on `Testing/ladders/gennest.sh`, which holds
	// `depth × stmtsPerLevel` fixed so the program barely changes size while the nesting doubles: at a
	// constant 1024 statements `phase:parse` CPU climbed ×1.20 ×1.33 ×1.50 ×1.74 per depth doubling, and
	// with this skip it climbs ×1.11 ×1.20 ×1.39 ×1.40 — HALF the depth term, to the tick. The other half
	// is `namesAssignedIn`, whose own scan is the same shape; see its header for why inverting THAT one
	// into a per-name index is a net loss until the Θ(bindings × constructs) loop above it is gone.
	function blockStatementEndIndex(startIndex TokenIndex, continuesAtElse bool) returns TokenIndex
		self.buildBlockExtentIndex()

		let count = self.tokens.count()
		var depth = 0
		var i = startIndex
		while i < count 'scan'
			if self.opensBlockAt(i) 'open'
				if depth > 0 'nested'
					// `i` lands on the nested construct's own `end`; the step below moves past it, so this
					// scan never sees the pair at all. An UNTERMINATED nested construct answers `count`,
					// which ends the walk exactly where walking into it would have.
					i = self.matchingEndOf(i)
				end 'nested' else 'ownOpener'
					depth = depth + 1
				end 'ownOpener'
			end 'open' else if self.closesBlockAt(i) 'close'
				depth = depth - 1
				if depth == 0 and (not continuesAtElse or not self.elseFollowsEnd(i)) 'matched'
					return i
				end 'matched'
			end 'close'

			i = i + 1
		end 'scan'
		return count
	end 'blockStatementEndIndex'

	// Does an `else` follow the `end` at `endIndex` — i.e. does an `if` chain continue past
	// it? Skips the ONE optional block label (`end 'x' else …`) that may sit between them; a
	// bare `end else …` has none. Peeking exactly one charLiteral is enough because an `end`
	// carries at most a single label, and the token after it is either `else` or the next
	// statement. This is the one place `blockStatementEndIndex` decides an `if` chain
	// continues, so a missed `else` under-approximates the extent — which the drift guard
	// converts to a loud panic rather than a silent lost phi.
	function elseFollowsEnd(endIndex TokenIndex) returns bool
		var next = endIndex + 1
		if self.kindAt(next) == TokenKind.charLiteral 'skipLabel'
			next = next + 1
		end 'skipLabel'

		return self.kindAt(next) == TokenKind.else
	end 'elseFollowsEnd'

	// Does the token at `index` open a block that a matching `end` closes?
	//
	// THIS IS MAXON'S BLOCK STRUCTURE, WRITTEN DOWN A SECOND TIME — `parseStatement` and
	// `parseBlockBody` own the first copy. It is kept honest by the drift panic in
	// `parseWhileStatement` rather than by hope: get this wrong and that panic fires, loudly,
	// on the first program that nests the missing construct in a loop.
	//
	// ⭐ `if`/`else` ARE THE SUBTLE PAIR, because the inline conditional `<t> if <c> else <f>`
	// (P1.5-A2c) spells BOTH keywords in EXPRESSION position with NO closing `end`. Counting a
	// ternary `if`/`else` as a block opener over-counts the depth and runs the extent past the real
	// `end`, so the drift guard fires (`let x = a if c else b` inside a loop body is enough). A block
	// `if`/`else` is told from a ternary one by POSITION — the same split the reference bootstrap
	// draws (2-Parser.cs `SkipToMatchingEnd`):
	//   • a block `if` is at STATEMENT START — the previous token is a `newline` (a fresh statement)
	//     or an `else` (an `else if` chain); a ternary `if` follows an operand (`ifBeginsStatement`).
	//   • a block `else` closes a then-branch — it follows that branch's `end` and its one optional
	//     label (`elseFollowsBlockEnd`); a ternary `else` follows the condition operand.
	// `while` and `for` (statement-only) and `match` (statement OR expression) always close with their
	// own `end`, so all three unconditionally open a block.
	//
	// `else`'s pre-ternary subtlety is still live: a plain `else 'label'` opens a block body of its
	// own, but an `else if` does NOT — the else branch simply IS a nested `if` statement
	// (parseElseBody), and that `if` is the opener whose `end` closes it.
	//
	// `otherwise` is the other subtle one: only the BLOCK forms of a `try … otherwise` open a
	// block (`otherwiseOpensBlock`). The rest (`ignore`, a fallback value, a single-statement
	// return/break/continue/throw/panic) open nothing, so counting a bare `otherwise` would
	// leave an `end` unaccounted for — the very miscount OPEN #62 was.
	//
	// ⚠ A construct added here almost certainly has a CONDITION or SCRUTINEE, and an expression can build an
	// owned temporary — so it owes that temporary a release too. See `drainPendingTemps`, which keeps the
	// list of regions that settle their own.
	function opensBlockAt(index TokenIndex) returns bool
		let kind = self.kindAt(index)
		if kind == TokenKind.while or kind == TokenKind.match or kind == TokenKind.for 'alwaysOpens'
			return not self.keywordIsMatchCaseName(index)
		end 'alwaysOpens'

		if kind == TokenKind.if 'ifKw'
			return self.ifBeginsStatement(index) and not self.keywordIsMatchCaseName(index)
		end 'ifKw'

		if kind == TokenKind.otherwise 'tryBlock'
			return self.otherwiseOpensBlock(index)
		end 'tryBlock'

		if kind != TokenKind.else 'notElse'
			return false
		end 'notElse'

		if self.kindAt(index + 1) == TokenKind.if or self.keywordIsMatchCaseName(index) 'notBlockElse'
			return false
		end 'notBlockElse'

		return self.elseFollowsBlockEnd(index)
	end 'opensBlockAt'

	// Does the token at `index` CLOSE a block — `opensBlockAt`'s counterpart, and its own predicate for the
	// same reason `assignsAt` is one. Every token scan in this file that counts block depth has to make the
	// keyword-as-case-name exclusion (`end` is a legal enum case name, so `end then …` is an arm and not a
	// closer), and eight of them had spelled it out independently. Spelled once, a scan cannot be taught the
	// opener rule and miss the closer rule — which would leave a depth counter that never comes back down.
	function closesBlockAt(index TokenIndex) returns bool
		return self.kindAt(index) == TokenKind.end and not self.keywordIsMatchCaseName(index)
	end 'closesBlockAt'

	// Is the `if` at `index` a block-opening STATEMENT `if` rather than the `if` of an inline
	// conditional `<t> if <c> else <f>`? A block `if` sits at statement start: the preceding token is
	// a `newline` (a new statement) or an `else` (the `if` of an `else if` chain). A ternary `if`
	// follows an operand, so neither holds. Index 0 has nothing before it and cannot be a ternary, so
	// it counts as statement start. Mirrors the reference bootstrap (2-Parser.cs `SkipToMatchingEnd`:
	// a block `if` iff `prevWasNewline || prev == else`).
	function ifBeginsStatement(index TokenIndex) returns bool
		if index == 0 'atStart'
			return true
		end 'atStart'

		let prev = self.kindAt(index - 1)
		return prev == TokenKind.newline or prev == TokenKind.else
	end 'ifBeginsStatement'

	// Does the `else` at `index` close an if/else then-branch (a block `else`) rather than tail an
	// inline conditional? A block `else` follows the then-branch's `end` and its ONE optional block
	// label — the backward twin of `elseFollowsEnd` (`end 'x' else` or bare `end else`). A ternary
	// `else` follows the condition operand, so the token before it (past an optional label) is not
	// `end`. Index 0 cannot be an `else`, so it is never a block `else`.
	function elseFollowsBlockEnd(index TokenIndex) returns bool
		if index == 0 'atStart'
			return false
		end 'atStart'

		var prev = index - 1
		if self.kindAt(prev) == TokenKind.charLiteral 'skipLabel'
			if prev == 0 'noRoom'
				return false
			end 'noRoom'
			prev = prev - 1
		end 'skipLabel'

		return self.kindAt(prev) == TokenKind.end
	end 'elseFollowsBlockEnd'

	// Does the `otherwise` at `index` begin a BLOCK-form handler — one closed by its own `end`?
	// Two block forms exist: `otherwise 'label' … end` (a bare charLiteral label) and
	// `otherwise (e) 'label' … end` (a caught-error binding). The NON-block forms open nothing:
	// `otherwise ignore`, a fallback VALUE, and the single-statement `return`/`break`/`continue`/
	// `throw`/`panic`. This is `parseOtherwiseHandler`'s split written down a second time (the drift
	// guard keeps them honest), but with ONE extra care it does not need: `otherwise` IS a legal
	// enum case name (`tokenNamesEnumCase`), so a keyword-spelled match arm `otherwise(x) then` also
	// leads with `otherwise (`. The binding form is told apart by its full SHAPE — `( identifier )`
	// followed by the label charLiteral — which a payload case (`( bindings ) then/gives`, or
	// multi-binding `( a , b )`) never matches. `parseOtherwiseHandler` needs no such check because
	// by the time it runs the leading `try` has already disambiguated the context.
	function otherwiseOpensBlock(index TokenIndex) returns bool
		let next = self.kindAt(index + 1)
		if next == TokenKind.charLiteral 'labelForm'
			return true
		end 'labelForm'

		return next == TokenKind.leftParen and self.kindAt(index + 2) == TokenKind.identifier and self.kindAt(index + 3) == TokenKind.rightParen and self.kindAt(index + 4) == TokenKind.charLiteral
	end 'otherwiseOpensBlock'

	// Is the keyword at `index` being used as a match-arm CASE NAME rather than as control flow?
	//
	// ⚠ **AN ENUM CASE MAY BE SPELLED WITH A KEYWORD** (`enum TokenType { function if else end … }`,
	// keyword-as-case-name.md), and a match over such an enum writes `if gives …`, `end then …`,
	// `else to critical then …`. The block-extent token scans (`opensBlockAt`,
	// `blockStatementEndIndex`, the sweep's `blockDepthAfter`) read `if`/`else`/`end`/`while`/`match`
	// as block STRUCTURE, and would miscount those case-name arms — the match's end would be
	// mispredicted and the drift guard would fire (or the arm loop would stop early). A control
	// keyword is NEVER followed by a match-arm SEPARATOR in real control flow (`if` takes a condition,
	// `end` a label or newline, `while` a condition), so a keyword immediately followed by
	// `gives`/`then`/`to`/`upto`/`or` is unambiguously a case name. That single lookahead is what lets
	// every one of those scans skip a keyword case arm without re-deriving the grammar.
	function keywordIsMatchCaseName(index TokenIndex) returns bool
		let next = self.kindAt(index + 1)
		return next == TokenKind.gives or next == TokenKind.then or next == TokenKind.to or next == TokenKind.upto or next == TokenKind.or
	end 'keywordIsMatchCaseName'

	// The names ASSIGNED anywhere in `[startIndex, endIndex)` — the construct's carried-variable
	// set, read straight off the tokens (see `parseWhileStatement` for why it must be known
	// before the body is parsed).
	//
	// A reassignment is the ONLY way a `var` already in scope changes value, and its syntax is
	// exactly `identifier =` (parseStatement's two-token lookahead). `==` is a single
	// `equalsEquals` token, so a comparison cannot be mistaken for one.
	//
	// It OVER-approximates, and every case where it does is harmless because a surplus phi is
	// harmless while a missing one is a miscompile:
	//   • `let r = …` / `var t = …` inside the loop match the shape too. Those names are not
	//     mutable bindings in scope at the header, so they select nothing — unless an outer var
	//     of the same name is being SHADOWED, in which case the outer one gets a phi it does not
	//     need. Costs one coalesced copy; the alternative is tracking shadowing at token level,
	//     which is the block structure written down a THIRD time.
	//
	// ⚠ **IT IS A SET, PER CONSTRUCT, AND THAT SHAPE IS LOAD-BEARING FOR ITS TWO CALLERS' COST.** Both
	// ask it once and then test it once per MUTABLE BINDING IN SCOPE, so the test runs
	// Θ(bindings × constructs) times — 518 × 800 in ONE function of the scale corpus's `d_blocks`, and
	// 26.5 MILLION times at rung 5. A small per-construct set keeps each of those tests to one hash and
	// one probe. MEASURED: replacing it with a per-FILE `name -> ascending assignment sites` index and a
	// binary-searched `isAssignedIn(name, start, end)` predicate — which does make the SCAN linear in
	// nesting depth — multiplies that quadratic's per-test constant and costs **`phase:parse` ×3.5 on the
	// corpus** (rung 5: 10.0G → 34.5G CPU ticks; rung 2 ×3.03). The scan's own depth term is worth far
	// less than that constant. Making both cheap needs the carried sets computed BOTTOM-UP over the
	// construct tree (each parent unioning its children's), which is a redesign of how a phi set is
	// ordered, not an edit to this function.
	function namesAssignedIn(startIndex TokenIndex, endIndex TokenIndex) returns AssignedNameSet
		// ⚠ THIS SCAN IS EXHAUSTIVE ONLY BECAUSE PARAMETERS ARE IMMUTABLE. Everything below reads
		// TOKENS, so it can only ever find a write that IS tokens — `identifier =`. A `var`
		// parameter is written by `mutate(p)` at the call site, leaving no `=` in this loop at all:
		// the scan would return without `p`, the header would mint no phi, and `p` would reset to
		// its entry value every iteration. Silent, and invisible to the drift panic that guards
		// this scan's OTHER assumption (the loop's extent), because the extent would be right.
		//
		// The tripwire for it is in `bindParameters`, on the mutability flag itself at the moment
		// it is passed — not here. This scan cannot enumerate parameters to check them, and a guard
		// here reading the `ParametersAreMutable` constant would be defeated by the very change it
		// guards against: a per-parameter feature stops reading that constant, and the guard goes
		// quiet exactly when it was needed.
		var assigned = AssignedNameSet.create()
		var i = startIndex
		while i < endIndex 'scan'
			if self.assignsAt(i) 'assignment'
				assigned.insert(self.tokenAt(i).value)
			end 'assignment'

			i = i + 1
		end 'scan'
		return assigned
	end 'namesAssignedIn'

	// ⭐ **THE FILE'S BLOCK-EXTENT INDEX: per token, the `end` that closes the block opened there** — one
	// linear bracket-matching pass over the token array, run on the first construct that asks and shared
	// by every `if`/`while`/`match` after it. It is what lets `blockStatementEndIndex` step OVER a nested
	// construct in one array read instead of walking through its tokens.
	//
	// Idempotent, and the shared-empty `is`-identity of the column is the "have I run?" gate (see the
	// field): the fresh column installed below is what says it has run, whether or not the file opens a
	// single block.
	function buildBlockExtentIndex()
		if self.blockExtentEnds is sharedEmptyBlockExtentEnds 'notBuiltYet'
			let tokenCount = self.tokens.count()
			// One entry per token, and ZERO wherever no block opens — a value no real answer can take, since
			// a matched opener's `end` sits after it and an unmatched one is seeded below with the end of the
			// token stream. `matchingEndOf` panics on a zero rather than inventing an extent.
			var extentEnds = TokenIndexColumn.create()
			extentEnds.resize(tokenCount)
			// The openers not yet closed, innermost last — the bracket-matching stack.
			var openers = TokenIndexColumn.create()

			var i = 0 as TokenIndex
			while i < tokenCount 'scan'
				if self.opensBlockAt(i) 'opensBlock'
					openers.push(i)
					// UNTERMINATED until a closer says otherwise — the end of the token stream, which is the
					// tolerant answer `blockStatementEndIndex`'s header states for a construct with no `end`.
					// Seeded at the PUSH so there is no post-scan drain to keep in step with this loop.
					try extentEnds.set(i, value: tokenCount) otherwise panic("buildBlockExtentIndex: opener {i} is outside this file's token space")
				end 'opensBlock' else if self.closesBlockAt(i) 'closesBlock'
					// A closer with nothing open closes nothing — the same malformed input the walk in
					// `blockStatementEndIndex` carries straight past on a negative depth.
					if openers.count() > 0 'hasOpener'
						let opener = try openers.pop() otherwise panic("buildBlockExtentIndex: pop from an opener stack just checked non-empty")
						try extentEnds.set(opener, value: i) otherwise panic("buildBlockExtentIndex: opener {opener} is outside this file's token space")
					end 'hasOpener'
				end 'closesBlock'

				i = i + 1
			end 'scan'

			self.blockExtentEnds = extentEnds
		end 'notBuiltYet'
	end 'buildBlockExtentIndex'

	// The index of the `end` that closes the block opened at `index`, or the end of the token stream when
	// nothing does — O(1) off `buildBlockExtentIndex`'s column.
	//
	// ⚠ ONLY MEANINGFUL AT AN OPENER, which is why a zero entry PANICS rather than answering: no block
	// opens at that token, and any extent returned for it would be invented. Every caller asks under
	// `opensBlockAt`, so the panic is a tripwire and not a path.
	function matchingEndOf(index TokenIndex) returns TokenIndex
		let closer = try self.blockExtentEnds.get(index) otherwise panic("matchingEndOf: token {index} is outside this file's token space")
		if closer == 0 'notAnOpener'
			panic("matchingEndOf: no block opens at token {index} — the extent column holds a matching `end` only for a token `opensBlockAt` accepts")
		end 'notAnOpener'

		return closer
	end 'matchingEndOf'

	// THE GUARD ON A TOKEN-EXTENT SCAN, shared by `parseWhileStatement` and `parseIfStatement`.
	// `blockStatementEndIndex` re-derives Maxon's block structure at the token
	// level to fix a construct's carried-variable set BEFORE its body is parsed — a SECOND copy
	// of a fact the recursive-descent parser owns. If the two disagree the scan's extent is too
	// SHORT, the carried set is a SUBSET, and a carried var silently loses its merge phi: a wrong
	// answer with no diagnostic. This converts it into a loud one — the `end` the parser actually
	// consumed to close the last body (`lastBlockBodyEnd`) must be the one the scan predicted.
	//
	// It is what makes the duplication safe to keep. A future block statement (`for`, `match`)
	// added to `parseStatement` without teaching `opensBlockAt` about it trips this panic on the
	// first spec that nests it in a loop or an `if`, instead of miscompiling it. (Over-shooting
	// the extent cannot hide here: it never under-counts the carried set, and it would make the
	// prediction miss the actual `end` and panic too — so the scan is pinned from both sides.)
	function assertScanAligned(construct String, predictedEnd TokenIndex)
		if self.lastBlockBodyEnd != predictedEnd 'scanDrifted'
			panic("{construct}: the token scan predicted the closing `end` at token {predictedEnd} but the parser closed the last body at token {self.lastBlockBodyEnd} — `opensBlockAt` does not know every statement that opens a block, so the carried-variable set it computed may be missing a carried var")
		end 'scanDrifted'
	end 'assertScanAligned'

	// Set up the exit block's post-loop variable values. With no `break`, the exit is
	// reached only from the condition's false edge, so each var's value there IS its
	// header phi (no exit phi needed). With ≥1 `break`, the exit MERGES the condition-
	// false value with each break's value, so it gets its own phis and the false edge
	// passes the header phi values into them (the break edges were recorded as the breaks
	// were parsed).
	//
	// `condExit` — the block the condition ENDED in, which carries the two-way branch — is
	// the false edge's source, and it is only the header when the condition short-circuited
	// nowhere. Recording the edge on the header instead would attach the exit's phi operands
	// to a block that does not branch to the exit at all.
	//
	// Index-based in both loops so each phi var is a MUTABLE binding — a `for x in …`
	// loop variable is immutable, and installing the post-loop value writes through the
	// binding it carries.
	function wireLoopExit(condExit IrBlock, exit IrBlock, ctx LoopContext)
		if not ctx.hasBreak 'noBreak'
			for k in 0 upto ctx.phiVars.count() 'inherit'
				var pv = try ctx.phiVars.get(k) otherwise panic("wireLoopExit: phiVars.get OOB at {k}")
				pv.binding.boundValue = pv.phiId
			end 'inherit'
			return
		end 'noBreak'

		var headerVals = ValueIdArray.create()
		for k in 0 upto ctx.phiVars.count() 'mkExitPhi'
			var pv = try ctx.phiVars.get(k) otherwise panic("wireLoopExit: phiVars.get OOB at {k}")
			let exitPhiId = self.mintPhiForBinding(exit, binding: pv.binding)
			pv.binding.boundValue = exitPhiId
			headerVals.push(pv.phiId)
		end 'mkExitPhi'
		self.recordBranchEdge(condExit, targetId: exit.id, argIds: headerVals)
	end 'wireLoopExit'

	// Drop the owned bindings a `break`/`continue` skips past — everything declared since the target
	// loop's body was entered (`ctx.ownedFloor`), in reverse order, into `block` BEFORE the branch that
	// terminates it. A `break`/`continue` leaves its block ALIVE (it jumps forward/back rather than
	// falling through the `end`), so `parseBlockBody`'s fall-through drop never runs on this path — this
	// is the only place that iteration's body-local Strings/structs are released. For a labelled control
	// to an OUTER loop, `ctx` is that outer loop, so the floor releases every binding down to it. The
	// decrefs land in `block` because `emitScopeDrops` emits into `currentBlock` and a `break`/`continue`
	// moves control nowhere until its branch, so `currentBlock` is `block`.
	function dropLoopBodyOwned(block IrBlock, ctx LoopContext, anchor Token)
		self.currentBlock = block
		self.emitScopeDrops(ctx.ownedFloor, anchor: anchor)
	end 'dropLoopBodyOwned'

	// Parse `break ['label']` (M4b): branch to the target loop's EXIT block, carrying
	// the current phi-var values so the exit's merge phis see this path's values.
	function parseBreakStatement(block IrBlock) throws ParseError
		let breakTok = try self.consume(TokenKind.break)
		var ctx = try self.resolveControlTarget("break", kwTok: breakTok)
		ctx.hasBreak = true
		self.dropLoopBodyOwned(block, ctx: ctx, anchor: breakTok)
		self.recordBranchEdge(block, targetId: ctx.exitId, argIds: self.edgeArgsFor(ctx.phiVars, preLoop: false))
		self.emitBranch(block, targetId: ctx.exitId)
	end 'parseBreakStatement'

	// Parse `continue ['label']` (M4b): branch to the target loop's CONTINUE TARGET, carrying the
	// current phi-var values so that block's phis see this path. For a `while` the target is the
	// header (the condition is re-evaluated on the back edge); for a `for` it is the STEP block, whose
	// increment must run before the header or the counter never advances — see `LoopContext`.
	function parseContinueStatement(block IrBlock) throws ParseError
		let continueTok = try self.consume(TokenKind.continue)
		let ctx = try self.resolveControlTarget("continue", kwTok: continueTok)
		self.dropLoopBodyOwned(block, ctx: ctx, anchor: continueTok)
		self.recordBranchEdge(block, targetId: ctx.continueTargetId, argIds: self.edgeArgsFor(ctx.phiVars, preLoop: false))
		self.emitBranch(block, targetId: ctx.continueTargetId)
	end 'parseContinueStatement'

	// Resolve the loop a `break`/`continue` targets. No label → the innermost loop.
	// A label → the enclosing loop with that label; naming the INNERMOST loop's own
	// label is redundant (E2048), and a label matching no enclosing loop is E2047.
	// A `break`/`continue` with no enclosing loop at all is E2047. Returns the live
	// stack entry (a reference) so `break` can flip its `hasBreak`.
	function resolveControlTarget(keyword String, kwTok Token) returns LoopContext throws ParseError
		let depth = self.loops.count()
		if depth == 0 'noLoop'
			throw ParseError.controlOutsideLoop(keyword, line: kwTok.line, column: kwTok.column)
		end 'noLoop'

		if not self.at(TokenKind.charLiteral) 'unlabelled'
			return try self.loops.get(depth - 1) otherwise panic("resolveControlTarget: loops.get({depth - 1}) failed after count check")
		end 'unlabelled'

		let labelTok = try self.consume(TokenKind.charLiteral)
		for i in 0 upto depth 'search'
			let ctx = try self.loops.get(depth - 1 - i) otherwise panic("resolveControlTarget: loops.get OOB during label search")
			if ctx.label.equals(labelTok.value) 'match'
				if i == 0 'ownLabel'
					throw ParseError.labelTargetsOwnLoop(keyword, label: String.from(labelTok.value), line: labelTok.line, column: labelTok.column)
				end 'ownLabel'
				return ctx
			end 'match'
		end 'search'
		throw ParseError.unknownLoopLabel(keyword, label: String.from(labelTok.value), line: labelTok.line, column: labelTok.column)
	end 'resolveControlTarget'

	// The current SSA value of each binding in `bindings`, in the list's order — one of an
	// `if`'s three merge snapshots (entry / then-exit / else-exit), positional over the
	// statement's carried set (`assignedBindings`).
	function snapshotBindings(bindings VarInfoArray) returns ValueIdArray
		var vals = ValueIdArray.create()
		for binding in bindings 'each'
			vals.push(binding.boundValue)
		end 'each'
		return vals
	end 'snapshotBindings'

	// The mutable bindings an `if` statement's token extent ASSIGNS — its carried set, the
	// SUBSET of `mutableVars` a continuation phi can be minted for, returned in `mutableVars`
	// DECLARATION ORDER. That order is load-bearing: the phis a merge mints follow it, and it
	// is what makes the sparse merge emit byte-identical code to the old one that iterated the
	// whole `mutableVars` list (see mergeAtContinuation). Token/assignment order would permute
	// two phis of one `if` and move codegen — the scale corpus's rotating write set proves it
	// (`w5 = …; w0 = …` assigns in the order 5, 0 but must merge in the order 0, 5).
	//
	// Built by filtering `mutableVars` through `namesAssignedIn` — the SAME token scan the loop
	// carried set uses. The scan OVER-approximates (a shadowing inner `let`/`var`, or a name
	// assigned only past the extent when `blockStatementEndIndex` runs wide, is included), and that
	// is FREE: an unassigned carried binding has a == b at the merge and mints no phi, costing
	// one snapshot slot and nothing else. UNDER-approximating would drop a real phi — a silent
	// miscompile — so the extent errs wide and the drift guard (`assertScanAligned`) refuses a
	// too-short one. A name in scope but NOT mutable, or not bound at entry (a branch-local
	// `var`), matches no `mutableVars` entry and is correctly absent.
	function assignedBindingsIn(startIndex TokenIndex, endIndex TokenIndex) returns VarInfoArray
		let assigned = self.namesAssignedIn(startIndex, endIndex: endIndex)
		var bindings = VarInfoArray.create()
		for k in 0 upto self.mutableVars.count() 'each'
			var binding = try self.mutableVars.get(k) otherwise panic("assignedBindingsIn: mutableVars.get OOB at {k}")
			if assigned.contains(binding.name) 'isAssigned'
				bindings.push(binding)
			end 'isAssigned'
		end 'each'
		return bindings
	end 'assignedBindingsIn'

	// One slot per carried binding, in phi order — the block-arg list of EVERY edge in a loop's phi
	// model. `preLoop` picks which value each slot carries, and that is the only thing the two kinds of
	// edge disagree about:
	//   • the PREHEADER edge (`preLoop: true`) carries the value captured OUTSIDE the loop, which
	//     `LoopPhiVar.entryValue` holds because installing the phi overwrote `boundValue`;
	//   • every edge from INSIDE (a back-edge, a `continue` to the step block, a `break` to the exit)
	//     carries the binding's value right now — read off the BINDING, so a `break` out of a block that
	//     SHADOWS a loop-carried `var` still carries the loop's own binding, not the shadow's value.
	//
	// ONE walk, because what must never drift is the POSITIONAL contract (in `phiVars` order, exactly one
	// entry per element, no filtering): a second copy that grew a filter would misalign one edge against
	// the header's block-args, which is a silent miscompile rather than a compile error.
	function edgeArgsFor(phiVars LoopPhiVarArray, preLoop bool) returns ValueIdArray
		var vals = ValueIdArray.create()
		for pv in phiVars 'each'
			vals.push(pv.entryValue if preLoop else pv.binding.boundValue)
		end 'each'
		return vals
	end 'edgeArgsFor'

	// ============================================================================================
	// `match` on SCALAR scrutinees (int/bool/float) — P1.1b wave A. No enums.
	//
	// A match lowers to a CHAIN of two-way `condBranch` test blocks and a block-arg join — the
	// exact primitives `if`/`else`/`while` already use. There is NO new IR op:
	//
	//   test0:  <pattern0 → bool cond0> ; condBranch(cond0, then: body0, else: test1)
	//   test1:  <pattern1 → bool cond1> ; condBranch(cond1, then: body1, else: test2)
	//   ...
	//   testN:  <the default body — the last real arm's `else` target>
	//   body0:  <arm 0's body> ; branch merge   (or → next body on `and fallthrough`)
	//   ...
	//   merge:  phi(s) ; <the result, for a `gives` match>
	//
	// A pattern is OR-folded into ONE boolean, exactly as both reference compilers do: a single
	// value is `scrut == v`, a range `lo to hi` is `(scrut >= lo) and (scrut <= hi)` (a bitwise
	// `and` over the two `bool`s — eager, since a pattern has no side effects), an `or` is a
	// bitwise `or` of the alternatives, `upto` uses `<` for the upper bound, and `min`/`max` drop
	// the corresponding compare.
	//
	// ⭐ The `gives` result and every cross-arm `var` mutation join through BLOCK-ARGS, not v1's /
	// the bootstrap's mutable result SLOT — see MatchArmExit's header. shv2 has no slots and no
	// mem2reg, so the parser threads each reaching arm's value to the merge as a block-arg, the
	// same on-the-fly SSA `if`/`while` use.
	// ============================================================================================

	// The STATEMENT form: `match <expr> 'l' <arms> end 'l'`. Returns the continuation control
	// resumes in — reachable when an arm falls through to it, `dead` when every arm terminates.
	function parseMatchStatement(func IrFunction, block IrBlock) returns IrBlock throws ParseError
		let outcome = try self.parseMatchCommon(func, block: block, isExpression: false)
		return outcome.cont
	end 'parseMatchStatement'

	// The EXPRESSION form: `let r = match …`, `match … * 2`. Yields the merge's result phi and
	// leaves control in the merge, exactly as `emitShortCircuit` does — so the climber continues
	// from `currentBlock` after it.
	function parseMatchExpression(func IrFunction) returns ValueId throws ParseError
		let outcome = try self.parseMatchCommon(func, block: self.currentBlock, isExpression: true)
		match outcome.result 'r'
			value(id) then return id
			none then panic("parseMatchExpression: an expression match produced no value — every `gives` arm must reach the merge")
		end 'r'
	end 'parseMatchExpression'

	// The shared core, driving both forms off `isExpression` (which decides `then` vs `gives` and
	// whether the merge carries a result phi). The single owner of the scrutinee, the block label,
	// the arm loop, exhaustiveness, and the merge join.
	function parseMatchCommon(func IrFunction, block IrBlock, isExpression bool) returns MatchOutcome throws ParseError
		let matchIndex = self.pos
		let matchTok = try self.consume(TokenKind.match)

		// The carried-variable set — the mutable bindings the WHOLE match assigns, read off the
		// tokens before anything is emitted, exactly as `if`/`while` read theirs. `matchEnd` feeds
		// the drift guard below.
		let matchEnd = self.blockStatementEndIndex(matchIndex, continuesAtElse: false)
		let carried = self.assignedBindingsIn(matchIndex, endIndex: matchEnd)

		// The scrutinee. It may itself short-circuit and move `currentBlock`, so the first arm's
		// test goes into wherever the scrutinee left control — its exit block, not `block`.
		let scrutTempFloor = self.pendingTempDrops.count()
		let scrut = try self.parseExpression(func, block: block)
		let scrutTag = self.tagOf(scrut)

		if not self.at(TokenKind.charLiteral) 'noLabel'
			let missing = self.current()
			throw ParseError.matchMissingBlockId(missing.line, column: missing.column)
		end 'noLabel'
		let labelTok = try self.consume(TokenKind.charLiteral)
		let matchLabel = labelTok.value

		let entryVals = self.snapshotBindings(carried)

		// Arm-loop state. The first arm's test goes into the block the scrutinee left control in
		// (`self.currentBlock`); `prevTestBlock`/`prevExitBlock` are seeded with it too and read only
		// under the flag that makes them meaningful (`hasRealArm` / `prevFallthrough`) — a block has
		// no empty value, and a sentinel would be a lie a later read could believe.
		var currentTestBlock = self.currentBlock
		var prevTestBlock = self.currentBlock
		var hasRealArm = false
		var sawDefault = false
		var prevFallthrough = false
		var prevExitBlock = self.currentBlock
		var prevExitVals = ValueIdArray.create()
		var seenValues = SeenPatternValues.create()
		var reachingArms = MatchArmExitArray.create()

		// ⭐ ENUM vs SCALAR is decided ONCE, from the scrutinee's type. A `named(X)` scrutinee whose
		// name is a declared enum/union takes the enum path — case-name patterns, the OPEN #21 range
		// rule, coverage over the case set; every other scrutinee is a scalar match (Wave A). The two
		// share this whole dispatch engine (the `condBranch` chain, the arm bodies, the merge); only
		// the PATTERN emission, the `default` rule, and the exhaustiveness check branch on it.
		let enumMatch = self.enumMatchFor(scrut)
		let isEnumMatch = enumMatchIsDeclared(enumMatch)
		// One coverage bit per case, in declaration order — the enum twin of `seenValues`. Populated
		// only for an enum match; a bare case marks its bit, a range marks the slice it covers, and a
		// second mark on one bit is E2027. Its all-true state IS exhaustiveness.
		var enumCovered = BoolArray.create()
		if isEnumMatch 'initEnumCoverage'
			let layout = requireEnumLayout(enumMatch)
			for _ in 0 upto layout.caseCount() 'eachCase'
				enumCovered.push(false)
			end 'eachCase'
		end 'initEnumCoverage'

		// The DISPATCH SUBJECT — what each arm's tag compare reads. A scalar enum's value IS its tag;
		// a boxed union's value is a heap POINTER, so its i64 tag is loaded ONCE here (into the first
		// test block, which dominates every arm) from offset 0. The scrutinee `scrut` itself stays the
		// BOX, which is what a payload binding reads its slots out of. Mirrors v1's
		// `matchDispatchSubject`.
		var dispatchSubject = scrut
		if isEnumMatch and requireEnumLayout(enumMatch).isBoxed() 'boxedDispatch'
			dispatchSubject = self.emitUnionTagLoad(scrut, range: SourceRange.ofToken(matchTok))
		end 'boxedDispatch'

		// ⭐ **MATCH-CONSUME BOOKKEEPING (P1.3 slice 2).** A managed payload BINDING moves its field out
		// of the box, which is legal only when the scrutinee is an OWNED local (`scrutOwned` — a borrowed
		// param/receiver is the P1.4 case, refused in `moveOutManagedPayload`). If ANY arm moves a managed
		// payload out, the whole scrutinee is consumed: its binding is marked `partiallyMoved` after the
		// loop (a re-read would deref a nulled slot — E3102 — but the box is still dropped, its cascade
		// null-guarding the moved slots). A match that moves nothing BORROWS — the union survives.
		let scrutOwned = self.valueIsOwnedHeap(scrut)
		var matchMovedManaged = false

		// ⭐ **A TEMPORARY OWNED SCRUTINEE IS ENROLLED AS A MATCH-SCOPED OWNED BINDING (P1.3).** A
		// constructed union box used directly — `match U.case(x) …` — is an owned heap TEMPORARY: it sits
		// in the pending-drop list, which is drained per STATEMENT, so whichever arm parses first and
		// terminates (`return`/`break`/`continue`) would drain it into that arm's block ALONE, leaking it
		// on every other arm's runtime path (exit 101, arm-order-dependent). Enrolling it as an owned
		// binding at the enclosing scope BEFORE the arm loop makes it drop EXACTLY ONCE on all four exits —
		// a `return` arm and an implicit end through `emitScopeDrops`, a `break`/`continue` arm through the
		// loop-floor drop, a fall-through arm through the enclosing scope's own exit drop — the same
		// machinery a `let m = U.case(x)` scrutinee already rides. A managed box still drops through its
		// `__destruct_<U>` cascade, null-guarding any slot a binding arm moved out. An ALREADY-BOUND
		// scrutinee (`let m = …; match m`) is already in `ownedBindings` (never in the pending list), so it
		// is left alone — a second enrolment would double-drop the one box.
		if scrutOwned and self.pendingTempsContain(scrut) 'enrollTempScrutinee'
			self.ownedBindings.push(VarInfo.createValueBinding(EmptySourceText, varType: self.typeOf(scrut), mutable: false, boundValue: scrut))
			self.removeFromPendingTemps(scrut)
		end 'enrollTempScrutinee'

		// ⭐ **AND THE SCRUTINEE EXPRESSION'S OTHER TEMPORARIES DIE HERE, BEFORE THE FIRST CASE TEST.** The
		// enrolment above rescues the scrutinee VALUE when it is itself an owned box; it says nothing about
		// what the expression built on the way to producing it — `match [1,2,3].count()` yields a plain
		// integer and abandons an array. Left in the list, that array is released by whichever arm's body
		// drains first, on that arm's path alone (the same arm-order-dependent leak the enrolment comment
		// above describes, one level down). `currentBlock` is the scrutinee's exit block, which dominates
		// every arm test, every arm body and the merge — so one release here covers all of them.
		self.drainPendingTemps(scrutTempFloor, anchor: matchTok)

		// The move state entering the arms — captured after the temp-scrutinee enrolment so the scrutinee
		// binding is included. Each FRESH arm is parsed from it (`restoreMoveMark` at the arm-restore sites,
		// the twin of `restoreBindings`), and each reaching arm captures its own exit move state for the
		// merge reconciliation. A `and fallthrough` arm does NOT restore — it inherits the prior arm's state.
		let entryMoveMark = self.captureMoveMark()

		// ⭐ **DISPATCH STRATEGY (match-dispatch Slice 1).** An integer-like scrutinee builds a normalized
		// interval PLAN and dispatches by a balanced binary search (or a chain when small); a `String`/
		// `float` scrutinee keeps the per-arm compare chain (`emitPatternCondition`). Under the plan the arm
		// loop emits NO test blocks or branches — it only collects `DispatchInterval`s and parses bodies —
		// and the whole dispatch is emitted after the loop, into `dispatchEntry` (the block holding
		// `dispatchSubject`, which every compare then reads). `planMissBlock`/`planMissArgs` name where a
		// value in no interval goes: the `default` body (set when the default arm is parsed) or a `dead`
		// block for an exhaustive enum (created after the loop).
		let usePlan = self.matchUsesIntervalPlan(isEnumMatch, scrut: scrut)
		// `var` because the dispatch is emitted INTO this block after the loop (`emitMatchDispatch` sets its
		// terminator), so the whole-program mutating-parameter analysis sees `entry` mutated — the same
		// let/var sensitivity `finalizeMatchMerge` documents at its edge-recording site.
		var dispatchEntry = currentTestBlock
		var dispatchIntervals = DispatchIntervalArray.create()
		// The block a value in no interval branches to. Seeded to the entry only as a placeholder — it is
		// always overwritten before the dispatch is emitted (a `default` body, or an exhaustive enum's dead
		// block), and a scalar match with no default throws E2026 before then.
		var planMissBlockId = dispatchEntry.id
		var planMissArgs = ValueIdArray.create()

		while true 'arms'
			self.skipNewlines()
			// The closing `end` — unless it is a keyword CASE NAME arm (`end gives …`) on an enum
			// whose case is spelled `end`. See `keywordIsMatchCaseName`.
			if self.at(TokenKind.end) and not self.keywordIsMatchCaseName(self.pos) 'endOfArms'
				break
			end 'endOfArms'

			if self.at(TokenKind.default) 'defaultArm'
				// A second `default`, or any `default` that is not last, is E2029 — reported when a
				// pattern arm FOLLOWS a default (below); a default following a default is the same rule.
				if sawDefault 'defaultAfterDefault'
					let dupTok = self.current()
					throw ParseError.matchDefaultNotLast(dupTok.line, column: dupTok.column)
				end 'defaultAfterDefault'

				let defTok = self.current()
				try self.consume(TokenKind.default)
				// The default's body: for a PLANNED match its own block (the dispatch's miss edges branch
				// here); for the linear chain the last real arm's `else` target (`currentTestBlock`), or the
				// entry block when the match is default-only. `var` because `parseArmBody` mutates it.
				var defaultBody = currentTestBlock
				if usePlan 'planDefaultBlock'
					defaultBody = self.newBlock(func, label: b"matchdefault", line: defTok.line)
				end 'planDefaultBlock'
				if prevFallthrough 'defaultIsFtTarget'
					let matchEdgeArgs = self.setupFallthroughTargetPhis(defaultBody, carried: carried, entryVals: entryVals, prevExitBlock: prevExitBlock, prevExitVals: prevExitVals)
					if usePlan 'planDefaultArgs'
						// The dispatch's miss edges into the default body carry these phi args — recorded when
						// the dispatch is emitted after the loop, not here.
						planMissArgs = matchEdgeArgs
					end 'planDefaultArgs' else if hasRealArm 'defaultFailEdge'
						// The fail edge into the default body — the last real arm's `condBranch` else, already
						// emitted; only its phi args are recorded now.
						self.recordBranchEdge(prevTestBlock, targetId: defaultBody.id, argIds: matchEdgeArgs)
					end 'defaultFailEdge'
				end 'defaultIsFtTarget' else 'defaultFresh'
					self.restoreBindings(carried, snapshot: entryVals)
					self.restoreMoveMark(entryMoveMark)
				end 'defaultFresh'

				if usePlan 'planMissTarget'
					planMissBlockId = defaultBody.id
				end 'planMissTarget'

				// ⭐ **`default throws E.case` / `default panic("…")`** (P1.4b) — a DIVERGING catch-all that
				// covers every unmatched case (so the match is exhaustive). It is the ONLY legal enum
				// default; a scalar match may use it too. A PLAIN `default` (then/gives) stays E2046 on an
				// enum match (a catch-all would silently mask a case added later) and a real body on a
				// scalar match. A diverging default terminates its body and so reaches no merge.
				if self.at(TokenKind.throws) 'defaultThrows'
					self.currentBlock = defaultBody
					let throwsTok = try self.consume(TokenKind.throws)
					try self.emitThrowError(func, anchor: throwsTok)
				end 'defaultThrows' else if self.at(TokenKind.panic) 'defaultPanic'
					try self.parsePanicStatement(func, block: defaultBody)
				end 'defaultPanic' else 'plainDefault'
					if isEnumMatch 'enumPlainDefault'
						let layout = requireEnumLayout(enumMatch)
						throw ParseError.matchDefaultEnumMustThrow(layout.kindWord(), typeName: String.from(layout.name), line: defTok.line, column: defTok.column)
					end 'enumPlainDefault'
					let defaultTempFloor = self.pendingTempDrops.count()
					let defaultArmBody = try self.parseArmBody(func, bodyBlock: defaultBody, isExpression: isExpression, carried: carried)
					// The catch-all arm settles its give and its temporaries exactly as a pattern arm does.
					try self.finishArmValues(defaultArmBody, tempFloor: defaultTempFloor, isExpression: isExpression, anchor: matchTok)
					// `default` is the last arm, so a fall-through has no next arm to reach — it simply
					// continues to the merge. So the test is "did control leave?", not `reachesMerge`.
					if not defaultArmBody.exitBlock.isTerminated() 'defaultReaches'
						reachingArms.push(MatchArmExit.create(defaultArmBody.exitBlock, exitVals: defaultArmBody.exitVals, give: defaultArmBody.give, moveMark: self.captureMoveMark()))
					end 'defaultReaches'
				end 'plainDefault'
				sawDefault = true
				prevFallthrough = false
			end 'defaultArm' else 'patternArm'
				if sawDefault 'armAfterDefault'
					let strayTok = self.current()
					throw ParseError.matchDefaultNotLast(strayTok.line, column: strayTok.column)
				end 'armAfterDefault'

				let patternTok = self.current()
				// `var` because the body block is forwarded to functions that fill it (payload phis, the arm
				// body) — a `let` cannot back a mutating parameter.
				var bodyBlock = self.newBlock(func, label: b"matcharm", line: patternTok.line)
				// The linear chain's next test block. A planned match emits its dispatch after the loop and
				// mints its own test blocks there, so it creates none here (an unused block would be dead).
				var nextTest = bodyBlock
				if not usePlan 'chainNextTest'
					nextTest = self.newBlock(func, label: b"matchnext", line: patternTok.line)
				end 'chainNextTest'

				// The pattern's facts: an interval PLAN (enum tags, or ordered-scalar values — collected, no
				// compare emitted) or an emitted per-arm CONDITION (a `String`/`float` chain). A pattern never
				// short-circuits, so `currentBlock` does not move; it matters only for the emitted-cond path.
				self.currentBlock = currentTestBlock
				var cond = 0 as ValueId
				var payloadBindings = PayloadBindingArray.create()
				let intervalMark = dispatchIntervals.count()
				if isEnumMatch 'enumPattern'
					payloadBindings = try self.collectEnumPatternIntervals(requireEnumLayout(enumMatch), covered: enumCovered, bodyBlockId: bodyBlock.id, into: dispatchIntervals)
				end 'enumPattern' else if usePlan 'scalarPlanPattern'
					try self.collectScalarPatternIntervals(scrutTag, seenValues: seenValues, bodyBlockId: bodyBlock.id, into: dispatchIntervals)
				end 'scalarPlanPattern' else 'scalarChainPattern'
					cond = try self.emitPatternCondition(scrut, scrutTag: scrutTag, seenValues: seenValues)
				end 'scalarChainPattern'

				var matchEdgeArgs = ValueIdArray.create()
				if prevFallthrough 'armIsFtTarget'
					matchEdgeArgs = self.setupFallthroughTargetPhis(bodyBlock, carried: carried, entryVals: entryVals, prevExitBlock: prevExitBlock, prevExitVals: prevExitVals)
				end 'armIsFtTarget' else 'armFresh'
					self.restoreBindings(carried, snapshot: entryVals)
					self.restoreMoveMark(entryMoveMark)
				end 'armFresh'

				if usePlan 'planEdgeArgs'
					// Stamp the carried-var phi args across every interval this arm contributed (an or-arm or a
					// split range reaches one body through several intervals); the dispatch records the
					// test→body edge with them. No `condBranch` here — the dispatch emits all of them later.
					for k in intervalMark upto dispatchIntervals.count() 'stampArgs'
						var interval = try dispatchIntervals.get(k) otherwise panic("parseMatchCommon: dispatchIntervals.get OOB at {k}")
						interval.edgeArgs = matchEdgeArgs
					end 'stampArgs'
				end 'planEdgeArgs' else 'chainEdge'
					self.recordBranchEdge(currentTestBlock, targetId: bodyBlock.id, argIds: matchEdgeArgs)
					self.emitCondBranch(currentTestBlock, cond: cond, thenId: bodyBlock.id, elseId: nextTest.id, ifTok: patternTok)
				end 'chainEdge'

				// A `walk(dir)` arm's payload bindings are declared at the HEAD of the arm body, in a
				// scope frame that closes at the arm's `end` so they cannot leak into the next arm. Each
				// reads a slot out of the scrutinee BOX (`scrut`), not the loaded tag `dispatchSubject`.
				// Only an enum pattern produces bindings, so `requireEnumLayout` is guarded.
				// The owned-binding height BEFORE the arm's payload bindings — an arm-local drop FLOOR, the
				// enum twin of `openBlock`'s `ownedCount`. A managed payload binding is enrolled in
				// `ownedBindings` above this floor, and must be dropped on the edge that leaves the arm (see
				// `dropArmScopedOwned`) rather than accumulating there to be decref'd in the continuation,
				// where a value defined in only one arm's block is garbage on every other arm's path.
				let armOwnedFloor = self.ownedBindings.count()
				let hasPayloadBindings = payloadBindings.count() > 0
				if hasPayloadBindings 'openArmBindings'
					self.currentBlock = bodyBlock
					self.scope.pushScope()
					let armMovedManaged = try self.declarePayloadBindings(payloadBindings, scrutBox: scrut, scrutOwned: scrutOwned, layout: requireEnumLayout(enumMatch))
					if armMovedManaged 'consumed'
						matchMovedManaged = true
					end 'consumed'
				end 'openArmBindings'

				let armTempFloor = self.pendingTempDrops.count()
				let armBody = try self.parseArmBody(func, bodyBlock: bodyBlock, isExpression: isExpression, carried: carried)

				if hasPayloadBindings 'closeArmBindings'
					self.scope.popScope()
				end 'closeArmBindings'

				// An expression arm's OWNED give value escapes to the result phi, so move it out of its owner
				// BEFORE `dropArmScopedOwned` — else a `text(s) gives s` arm would drop the payload it is
				// handing back (a use-after-free), and an owned-interpolation give would be double-freed by
				// the post-match drain. A gives arm always reaches the merge (an expression cannot terminate
				// its block), so the transfer is unconditional for `isExpression`. The arm's abandoned
				// TEMPORARIES leave by the same door and into the same exit block — see `finishArmValues`.
				try self.finishArmValues(armBody, tempFloor: armTempFloor, isExpression: isExpression, anchor: patternTok)
				self.dropArmScopedOwned(armOwnedFloor, exitBlock: armBody.exitBlock, anchor: patternTok)

				if armBody.fellThrough 'fellThrough'
					prevFallthrough = true
					prevExitBlock = armBody.exitBlock
					prevExitVals = armBody.exitVals
				end 'fellThrough' else 'notFallThrough'
					prevFallthrough = false
					if armBody.reachesMerge 'armReaches'
						reachingArms.push(MatchArmExit.create(armBody.exitBlock, exitVals: armBody.exitVals, give: armBody.give, moveMark: self.captureMoveMark()))
					end 'armReaches'
				end 'notFallThrough'

				prevTestBlock = currentTestBlock
				hasRealArm = true
				if not usePlan 'chainAdvance'
					currentTestBlock = nextTest
				end 'chainAdvance'
			end 'patternArm'
		end 'arms'

		// ⚠ An exhaustive enum match's FINAL `else` target — the last arm's fail edge — is UNREACHABLE
		// (every value matches some arm), but the last arm's `condBranch` named it, so the CFG edge
		// exists and the block needs a terminator. `dead` marks it unreachable, the same terminator the
		// parser gives code after a fully-terminated `if`/`else`. A scalar match cannot reach here with
		// a dangling block: it is exhaustive only through a `default`, whose BODY consumes this block.
		// ⚠ Skipped when `sawDefault` (a `default throws`/`panic`): the final-else block IS that diverging
		// default's body, already given a real terminator above — overwriting it with `dead` would orphan
		// the throw/panic and silently drop it.
		if isEnumMatch and not sawDefault 'enumFallOffUnreachable'
			// The dispatch's miss target. A planned match routes misses to a fresh `dead` block; the linear
			// chain's final `else` target IS that block (`currentTestBlock`). Either way the miss is
			// unreachable (every value matches some arm).
			if usePlan 'planDeadMiss'
				var deadBlock = self.newBlock(func, label: b"matchdead", line: matchTok.line)
				deadBlock.terminator = Terminator.dead
				planMissBlockId = deadBlock.id
			end 'planDeadMiss' else 'chainDeadMiss'
				currentTestBlock.terminator = Terminator.dead
			end 'chainDeadMiss'

			// A trailing `and fallthrough` on the LAST arm has no following arm or `default` to fall
			// INTO (a pattern arm cannot follow a default, and an enum match has no legal default at
			// this rung), so it falls OUT of the match to the continuation — exactly as an arm that
			// reaches the merge does. Without this the arm body is left unterminated and
			// `assertAllBlocksTerminated` panics; the reference compiler accepts it as a no-op tail.
			// Statement form only: `and fallthrough` after a `gives` arm is already rejected, so the
			// give is `none`. A SCALAR match cannot reach this with `prevFallthrough`: a trailing
			// fallthrough with no `default` is rejected by the `notExhaustive` throw below.
			if prevFallthrough 'trailingFallthrough'
				reachingArms.push(MatchArmExit.create(prevExitBlock, exitVals: prevExitVals, give: MatchGiveValue.none, moveMark: self.captureMoveMark()))
			end 'trailingFallthrough'
		end 'enumFallOffUnreachable'

		// EXHAUSTIVENESS. An enum match must cover every case (E2026 listing the missing ones); a
		// scalar match is exhaustive only through a `default` (without one it would silently do nothing
		// for an unmatched value). Both are anchored at the closing `end`, as both references anchor it.
		if isEnumMatch and not sawDefault 'enumExhaustive'
			// A `default throws`/`panic` covers every unmatched case, so the case-set need not be complete.
			try self.checkEnumExhaustive(requireEnumLayout(enumMatch), covered: enumCovered)
		end 'enumExhaustive' else if not isEnumMatch and not sawDefault 'notExhaustive'
			var subject = "match"
			if isExpression 'exprSubject'
				subject = "match expression"
			end 'exprSubject'
			let endMissing = self.current()
			throw ParseError.matchNotExhaustive(subject, line: endMissing.line, column: endMissing.column)
		end 'notExhaustive'

		// Drift guard, mirroring the `if`/`while` token-extent scans: the `end` the parser reached
		// must be the one `blockStatementEndIndex` predicted, or `opensBlockAt` misclassified a
		// construct nested in the arms and the carried set may be short.
		self.lastBlockBodyEnd = self.pos
		let endTok = try self.consume(TokenKind.end)
		self.assertScanAligned("parseMatch", predictedEnd: matchEnd)

		if self.at(TokenKind.charLiteral) 'endLabel'
			let closeTok = try self.consume(TokenKind.charLiteral)
			if not closeTok.value.equals(matchLabel) 'labelMismatch'
				throw ParseError.matchMismatchedBlockId(String.from(matchLabel), got: String.from(closeTok.value), line: endTok.line, column: endTok.column)
			end 'labelMismatch'
		end 'endLabel'

		// A binding-match that moved a managed payload out CONSUMES the scrutinee: mark its binding
		// `partiallyMoved` so a later read is E3102 (a re-match would deref a nulled slot). The box is
		// still dropped at scope exit — its cascade null-guards the moved slots. A TEMPORARY scrutinee's
		// SYNTHETIC binding (enrolled above) is marked too, which is harmless — it has no name to re-read,
		// and `partiallyMoved` skips no drop, so the box still drops through the cascade.
		if matchMovedManaged 'consumeScrut'
			self.markScrutineePartiallyMoved(scrut)
		end 'consumeScrut'

		// ⭐ **EMIT THE PLANNED DISPATCH** — after every arm body and the default/dead miss target are in
		// hand, and after exhaustiveness has run (so a non-exhaustive scalar match threw before this).
		// `planMissBlock` is always set for a planned match by here: a `default` set it, an exhaustive enum's
		// dead block set it, and a scalar match with no default cannot reach here. The chain path already
		// wired its dispatch inline, so this runs only for a planned match.
		if usePlan 'emitPlan'
			let normalized = self.normalizeDispatchIntervals(dispatchIntervals)
			try self.emitMatchDispatch(func, entry: dispatchEntry, subject: dispatchSubject, intervals: normalized, missTarget: planMissBlockId, missArgs: planMissArgs, opTok: matchTok)
		end 'emitPlan'

		let outcome = try self.finalizeMatchMerge(func, matchTok: matchTok, carried: carried, reachingArms: reachingArms, construct: MergeConstruct.matchExpression if isExpression else MergeConstruct.matchStatement)
		self.currentBlock = outcome.cont
		return outcome
	end 'parseMatchCommon'

	// Mark the binding a consumed match scrutinee denotes as `partiallyMoved` — a re-read is E3102, but
	// the box is still dropped (see VarInfo.partiallyMoved). Found by VALUE via `isLiveOwnerOf`, the same
	// predicate `poisonMoveSource` uses, so a temporary scrutinee (owned by no binding) is correctly a
	// no-op. An O(ownedBindings) scan, run once per consuming match.
	// ⭐ **DROP A MATCH ARM'S OWNED (managed) PAYLOAD BINDINGS**, the enum twin of `closeBlock` +
	// `parseBlockBody`'s fall-through drop. The arm's managed bindings own heap that must be released when
	// the arm exits, and the release is keyed on HOW it exits (the block rule, exactly):
	//   • a LIVE exit — a fall-through to the merge, or `and fallthrough` to the next arm — still owns the
	//     bindings here, so drop them into the exit block before it merges (a decref left for the
	//     continuation would run in a block where a one-arm value is garbage on every other arm's path — a
	//     use-after-free, exit 0xC0000005);
	//   • a TERMINATED exit — a `return`/`break`/`continue` — already dropped them via `emitScopeDrops`
	//     down to its own floor, so drop nothing.
	// The tracking is drained to `floor` EITHER way, so the next arm starts clean and the function-end
	// drop never sees an arm binding. `patternTok` anchors the drop, as the arm's pattern is where a
	// reader looks for what became of its bindings.
	function dropArmScopedOwned(floor BindingMark, exitBlock IrBlock, anchor Token)
		if not exitBlock.isTerminated() 'leavesAlive'
			let saved = self.currentBlock
			self.currentBlock = exitBlock
			self.emitScopeDrops(floor, anchor: anchor)
			self.currentBlock = saved
		end 'leavesAlive'
		while self.ownedBindings.count() > floor 'drain'
			_ = try self.ownedBindings.pop() otherwise panic("dropArmScopedOwned: ownedBindings.pop failed above the floor {floor}")
		end 'drain'
	end 'dropArmScopedOwned'

	function markScrutineePartiallyMoved(scrut ValueId)
		var i = 0
		while i < self.ownedBindings.count() 'each'
			// A `var` bound from `.get(i)`: the flag is written THROUGH the shared `VarInfo` reference
			// (the `Scope.setValue` idiom `poisonMoveSource` uses), so every holder observes it.
			var owned = try self.ownedBindings.get(i) otherwise panic("markScrutineePartiallyMoved: ownedBindings.get OOB at {i}")
			if self.isLiveOwnerOf(owned, value: scrut) 'source'
				owned.partiallyMoved = true
				return
			end 'source'
			i = i + 1
		end 'each'
	end 'markScrutineePartiallyMoved'

	// Parse ONE arm's body. A `gives` arm is a single expression (its value feeds the merge phi); a
	// `then` arm is a single statement, and `and fallthrough` may follow it. Reports E2049 for a
	// block-opening statement body, E2025 for `return … and fallthrough`, and E2001 for a stray
	// `and` after a `gives` arm.
	function parseArmBody(func IrFunction, bodyBlock IrBlock, isExpression bool, carried VarInfoArray) returns MatchArmBody throws ParseError
		self.currentBlock = bodyBlock

		if isExpression 'givesArm'
			try self.consume(TokenKind.gives)
			let valueTok = self.current()
			let value = try self.parseExpression(func, block: self.currentBlock)

			// ⭐ **MERGE (P1.5-A2b): a capturing closure may not be a `gives` arm of a match EXPRESSION** —
			// every arm feeds ONE result phi (one slot, the code pointer), and the env rides a side column a
			// phi cannot carry, so the merged closure would be called with env=0 and nil-deref, whether or not
			// the result escapes. This is the REACHABLE form of the ternary-arm refusal (match is parsed;
			// `a if c else b` is not), so it must be caught here or a closure launders through the merge into a
			// segfault. Refused via the same E3099 gate the escape routes use, with the merge message.
			try self.rejectEscapingClosure(value, message: "cannot use a closure that captures as a `gives` arm of a match expression: {CapturingClosureMergeSuffix}", tok: valueTok)

			let exitBlock = self.currentBlock
			// `and fallthrough` is meaningless where every arm must yield a value. The climber
			// already stopped at the `and` (see parseBinary), so it sits here as a stray token.
			if self.at(TokenKind.and) 'strayAnd'
				let andTok = self.current()
				throw ParseError.matchExpressionStrayToken(andTok.kind.rawValue, line: andTok.line, column: andTok.column)
			end 'strayAnd'
			return MatchArmBody.create(false, reachesMerge: not exitBlock.isTerminated(), exitBlock: exitBlock, exitVals: self.snapshotBindings(carried), give: MatchGiveValue.value(value))
		end 'givesArm'

		try self.consume(TokenKind.then)

		// Each arm body is a single statement — a block-opening one (`if`/`while`/`for`/`match`)
		// has no place for its nested scope on a single-line arm.
		let firstTok = self.current()
		if self.isBlockOpeningStatement(firstTok.kind) 'blockOpener'
			throw ParseError.matchBlockStatement(firstTok.kind.rawValue, line: firstTok.line, column: firstTok.column)
		end 'blockOpener'

		// Whether the body is a `return` is read BEFORE it is parsed — `and fallthrough` after a
		// `return` cannot combine (the `return` has already left the arm).
		let isReturn = self.at(TokenKind.return)
		// ⭐ A match arm body is a single statement, so a `try` used here may take only a single-statement
		// form — the block forms are E2049 (P1.4b). `parseTry` reads this flag; saved/restored so a nested
		// construct unwinds it. On a throw the parse aborts, so restoring on the error path is moot.
		let savedInMatchArm = self.inMatchArmBody
		self.inMatchArmBody = true
		let exitBlock = try self.parseStatement(func, block: self.currentBlock)
		self.inMatchArmBody = savedInMatchArm

		var fellThrough = false
		if self.at(TokenKind.and) and self.peekKind() == TokenKind.fallthrough 'fallthroughSuffix'
			let andTok = self.current()
			if isReturn 'ftReturn'
				throw ParseError.matchFallthroughWithReturn(andTok.line, column: andTok.column)
			end 'ftReturn'
			try self.consume(TokenKind.and)
			try self.consume(TokenKind.fallthrough)
			fellThrough = true
		end 'fallthroughSuffix'

		let reachesMerge = not exitBlock.isTerminated() and not fellThrough
		return MatchArmBody.create(fellThrough, reachesMerge: reachesMerge, exitBlock: exitBlock, exitVals: self.snapshotBindings(carried), give: MatchGiveValue.none)
	end 'parseArmBody'

	// The block-opening statement keywords — an arm body may not start with one (E2049). `try`'s
	// block form is also one, but `try` is a later rung and cannot appear here yet.
	function isBlockOpeningStatement(kind TokenKind) returns bool
		return kind == TokenKind.if or kind == TokenKind.while or kind == TokenKind.for or kind == TokenKind.match
	end 'isBlockOpeningStatement'

	// Set up the phis of a FALLTHROUGH-TARGET body block — one reached both by its match edge(s)
	// (carrying the pre-match `entryVals`) and by the previous arm's fallthrough edge (carrying
	// that arm's exit values). A carried var gets a merge phi exactly where the two disagree; the
	// fallthrough edge is recorded and emitted here, and the differing `entryVals` are RETURNED for
	// the caller to record on the match edge (a regular arm's `condBranch` then-edge, or the
	// default's fail edge).
	function setupFallthroughTargetPhis(bodyBlock IrBlock, carried VarInfoArray, entryVals ValueIdArray, prevExitBlock IrBlock, prevExitVals ValueIdArray) returns ValueIdArray
		var matchEdgeArgs = ValueIdArray.create()
		var fallthroughEdgeArgs = ValueIdArray.create()
		for k in 0 upto carried.count() 'each'
			var binding = try carried.get(k) otherwise panic("setupFallthroughTargetPhis: carried.get OOB at {k}")
			let entryV = try entryVals.get(k) otherwise panic("setupFallthroughTargetPhis: entryVals.get OOB at {k}")
			let prevV = try prevExitVals.get(k) otherwise panic("setupFallthroughTargetPhis: prevExitVals.get OOB at {k}")
			if entryV == prevV 'same'
				binding.boundValue = entryV
			end 'same' else 'differ'
				let phiId = self.mintPhiForBinding(bodyBlock, binding: binding)
				binding.boundValue = phiId
				matchEdgeArgs.push(entryV)
				fallthroughEdgeArgs.push(prevV)
			end 'differ'
		end 'each'
		self.recordBranchEdge(prevExitBlock, targetId: bodyBlock.id, argIds: fallthroughEdgeArgs)
		self.emitBranch(prevExitBlock, targetId: bodyBlock.id)
		return matchEdgeArgs
	end 'setupFallthroughTargetPhis'

	// Create the merge block LAST (so it lays out after every arm body) and join the reaching arms
	// into it. An empty set means every arm terminated — the merge is `dead`. Otherwise mint the
	// block-args in order — the result phi (expression form) first, then one phi per carried var
	// that differs across the reaching arms — and record each arm's edge in the SAME order.
	function finalizeMatchMerge(func IrFunction, matchTok Token, carried VarInfoArray, reachingArms MatchArmExitArray, construct MergeConstruct) returns MatchOutcome throws ParseError
		// Every value-producing construct (a match EXPRESSION and a ternary) runs the give-agreement,
		// promotion and ownership rules below; a match STATEMENT gives no value and skips them. So the one
		// value/statement bit is DERIVED from the construct rather than passed beside it — the two cannot
		// then disagree — and `construct` itself only ever matters where the DIAGNOSTIC NOUN differs (#80).
		let isExpression = construct != MergeConstruct.matchStatement

		var merge = self.newBlock(func, label: b"matchcont", line: matchTok.line)

		if reachingArms.count() == 0 'allTerminate'
			merge.terminator = Terminator.dead
			if isExpression 'exprNoValue'
				panic("finalizeMatchMerge: a match expression reached no value-producing arm — every `gives` arm must reach the merge (diverging arms are a later rung)")
			end 'exprNoValue'
			return MatchOutcome.create(merge, result: MatchGiveValue.none)
		end 'allTerminate'

		// The first reaching arm is the reference every "do the arms differ / what is the common
		// value" question is asked against, so it is fetched once here (the count check above proves
		// it exists).
		let firstArm = try reachingArms.get(0) otherwise panic("finalizeMatchMerge: reachingArms.get(0) failed after count check")

		// ⭐ **CROSS-REGISTER-CLASS ARMS ARE UNIFIED TO FLOAT (P1.5 #31), not refused.** Every arm's `gives`
		// value feeds ONE result phi, and a value's register file (GP vs XMM) is fixed by its type at birth —
		// so an integer give and a float give hand the phi two values from different files, which the
		// allocator cannot color (`X64Backend.emitRegRegMove` panics "crosses register files"). The reference
		// oracle promotes the INTEGER arms to float (`cvtsi2sd`) so the result is uniformly float, and now
		// that floats are a nameable, working type in shv2 (the stale blocker this once cited is gone) shv2
		// does the same with the instruction it already has (`promoteToFloat`). The promote lands in the
		// ARM'S OWN exit block — its value is computed there, and the branch to the merge is not emitted until
		// below — so the pure `cvtsi2sd` is on the conditional path, never hoisted before the branch. A float
		// arm meeting a NON-numeric arm (a bool/String/struct/union/type-parameter give) is not promotable and
		// is a genuine type mismatch, reported HERE before any phi is built: `checkGiveTypes` below cannot be
		// its backstop, because a `typeParameter`/`unresolved` give AGREES with the float and would slip
		// through to the mixed-class phi. Statement matches give no value and skip this, as they skip every
		// give rule below.
		if isExpression 'unifyRegisterClass'
			var anyFloat = false
			for i in 0 upto reachingArms.count() 'scanFloat'
				let a = try reachingArms.get(i) otherwise panic("finalizeMatchMerge: reachingArms.get OOB at {i}")
				if tagIsFloat(self.tagOf(self.giveValueOf(a.give))) 'floatArm'
					anyFloat = true
				end 'floatArm'
			end 'scanFloat'

			if anyFloat 'promoteIntegerArms'
				for i in 0 upto reachingArms.count() 'eachArm'
					var arm = try reachingArms.get(i) otherwise panic("finalizeMatchMerge: reachingArms.get OOB at {i}")
					let give = self.giveValueOf(arm.give)
					if not tagIsFloat(self.tagOf(give)) 'notYetFloat'
						if not self.giveIsPromotableToFloat(give) 'nonNumericArm'
							throw self.valueMergeGiveMismatch(construct, reachingArms: reachingArms, firstArm: firstArm, gotArm: arm, matchTok: matchTok)
						end 'nonNumericArm'
						let saved = self.currentBlock
						self.currentBlock = arm.exitBlock
						let promoted = self.promoteToFloat(give, opTok: matchTok)
						self.currentBlock = saved
						arm.give = MatchGiveValue.value(promoted)
					end 'notYetFloat'
				end 'eachArm'
			end 'promoteIntegerArms'
		end 'unifyRegisterClass'

		// ⭐ **OPEN #54 SLICE C — EVERY REACHING `gives` ARM MUST YIELD THE FIRST ARM'S TYPE.** The result
		// phi minted below takes the FIRST arm's type (`mintPhi` off `firstGive`), and a value's type is
		// fixed at birth — so an arm giving a value of another type hands the phi a value its own type is a
		// lie about, with no diagnostic. The float/non-float split threw `unsupported` above, so a surviving
		// mismatch is same-register-class and takes one of TWO shapes, each a memory-SAFETY defect:
		//   • a SCALAR-CLASS disagreement — a `String` give and an `int` give, a `bool` give and an `int`
		//     give — whose phi derefs the wrong-domain value as the first arm's type (the int read as a
		//     String pointer: a segfault). Caught by `typesAgree`, the SYMMETRIC form of the rule the
		//     coercion-site twins (`return`, reassignment, `otherwise`, the call argument) ask one-sided as
		//     `checkDeclaredType`. It is `typesAgree`, NOT a raw tag compare, so a ranged-int alias give and
		//     a plain `int` give (both numeric) — or an `ExitCode` give and an `int` give — STAY valid: the
		//     numeric subtypes share a register file and a phi holds either.
		//   • an AGGREGATE-IDENTITY disagreement — two DIFFERENT structs/unions (both aggregates, naming
		//     distinct types), OR a boxed struct/union give and a SCALAR give (`match c { 0 gives
		//     Holder.holds(box); default gives 7 }`). Both are caught by `namedAggregatesConflict` (the ONE
		//     name-agreement rule the coercion sites share, extended by #59 to fire on aggregate-vs-scalar
		//     too). `ValueTypeTag.named` is OVERLOADED — a boxed union VALUE carries it, and so does a
		//     ranged-int alias — so `typesAgree(named, integer)` wrongly AGREES and the phi would deref the
		//     int `7` as a box pointer; but `aggregateNameOf` NAMES a declared struct/union and returns EMPTY
		//     for every scalar/String/ranged-int alias, so the two gives disagree exactly when their
		//     aggregate names differ (one empty, or both non-empty and unequal).
		// The two compose: both-scalar → `typesAgree`; anything with an aggregate → `namedAggregatesConflict`.
		// Read off the scalar tag/name columns, so a scalar match materializes no `MaxonType` and allocates
		// nothing. Placed BEFORE `resolveGivesOwnership` and the phi so an ill-typed match is refused before
		// any phi is built. Expression-only: a statement match gives no value, exactly as the float check above.
		if isExpression 'checkGiveTypes'
			let firstGive = self.giveValueOf(firstArm.give)
			let firstTag = self.tagOf(firstGive)
			let firstAggregate = self.aggregateNameOf(firstTag, nameId: self.valueNameId(firstGive))
			for i in 1 upto reachingArms.count() 'scanGiveType'
				let arm = try reachingArms.get(i) otherwise panic("finalizeMatchMerge: reachingArms.get OOB at {i}")
				let giveVal = self.giveValueOf(arm.give)
				let giveTag = self.tagOf(giveVal)
				let giveAggregate = self.aggregateNameOf(giveTag, nameId: self.valueNameId(giveVal))

				let classDisagrees = not typesAgree(giveTag, right: firstTag)
				let nameDisagrees = self.signatures.aggregatesConflict(firstAggregate, got: giveAggregate)
				if classDisagrees or nameDisagrees 'giveTypeMismatch'
					throw self.valueMergeGiveMismatch(construct, reachingArms: reachingArms, firstArm: firstArm, gotArm: arm, matchTok: matchTok)
				end 'giveTypeMismatch'
			end 'scanGiveType'
		end 'checkGiveTypes'

		// ⭐ **FUNCTION-VALUE ARMS MUST AGREE IN SIGNATURE — RECORDED HERE, CHECKED WHOLE-PROGRAM (P1.5 #81).**
		// `checkGiveTypes` proves every arm shares the FIRST arm's class, so if the first give is a `function`
		// every arm is — but a `function` tag carries no arity or parameter types, so `unary if c else binary`
		// slips it: both arms are the `function` class, no aggregate, and the merge silently adopts the FIRST
		// arm's signature for the phi. A caller then checks its indirect call against `unary`'s one parameter
		// while the value at runtime is `binary`, which reads a garbage second argument — a stack corruption
		// the class check cannot see. The signatures CANNOT be compared here: a forward-referenced or cross-file
		// arm's parameter types are not in any registry the parser has at parse time (`self.artifact` holds only
		// THIS file's functions parsed so far; the whole-program `project.funcSignatures` is not assembled until
		// merge). So the arms' governing NAMES + the anchor + the noun are RECORDED, and the agreement is drained
		// whole-program in `checkValueMergeSignatures` — before `resolveTypes` erases the alias names the
		// diagnostic prints. This is v1's model (`PendingTernaryArmCheck` drained in TypeResolution) and the
		// reference oracle's whole-program `MergeTernaryArmFnTypes` (2-Parser.cs:16149).
		if isExpression 'recordFnMergeCheck'
			if self.tagOf(self.giveValueOf(firstArm.give)) == ValueTypeTag.function 'firstArmIsFunction'
				var armNames = ByteArrayArray.create()
				for i in 0 upto reachingArms.count() 'collectArmNames'
					let arm = try reachingArms.get(i) otherwise panic("finalizeMatchMerge: reachingArms.get OOB at {i}")
					armNames.push(self.internedName(self.valueNameId(self.giveValueOf(arm.give))))
				end 'collectArmNames'
				self.artifact.pendingFnMergeChecks.push(PendingFnMergeCheck.create(armNames, line: matchTok.line, column: matchTok.column, filePath: self.filePath, isTernary: construct == MergeConstruct.ternary))
			end 'firstArmIsFunction'
		end 'recordFnMergeCheck'

		// ⭐ **OWNED-GIVE OWNERSHIP TRANSFER (P1.3).** If any reaching arm gives an OWNED value the result
		// phi takes over ownership (`resultOwned` → the phi is marked owned below): each arm's give value has
		// already left its own owner (`transferGiveToPhi` in the arm loop), so neither `dropArmScopedOwned`
		// nor the post-match statement drain frees it, and a borrowed give (a String literal) is promoted to
		// an owned copy so the phi is uniformly owned and its consumer drops it unconditionally. When NO arm
		// gives an owned value the phi stays borrowed, exactly as before. `finalGives` carries each reaching
		// arm's post-promotion give value (empty for a statement match), used below for the phi and the edges.
		var finalGives = ValueIdArray.create()
		let resultOwned = try self.resolveGivesOwnership(reachingArms, isExpression: isExpression, matchTok: matchTok, finalGives: finalGives)

		// ⭐ **CONDITIONAL MOVE RECONCILED across the reaching arms** — an owned binding moved in one arm and
		// left live in another is dropped on the live arms' exit blocks (all reaching arms are unterminated)
		// and marked uniformly moved past the merge. Emitted BEFORE the branches so the decref lands in the
		// arm's own body. A returning/breaking arm contributed no reaching entry, so it is not reconciled —
		// it dropped its own live values on the way out.
		var moveEdges = ReachingMoveEdgeArray.create()
		for i in 0 upto reachingArms.count() 'collectMoveEdges'
			let arm = try reachingArms.get(i) otherwise panic("finalizeMatchMerge: reachingArms.get OOB at {i}")
			moveEdges.push(ReachingMoveEdge.create(arm.exitBlock, mark: arm.moveMark))
		end 'collectMoveEdges'
		self.reconcileMovesAtMerge(moveEdges, anchor: matchTok)

		// Every reaching arm branches to the merge (its exit block is, by definition, unterminated).
		for i in 0 upto reachingArms.count() 'branchToMerge'
			let arm = try reachingArms.get(i) otherwise panic("finalizeMatchMerge: reachingArms.get OOB at {i}")
			self.emitBranch(arm.exitBlock, targetId: merge.id)
		end 'branchToMerge'

		// A carried var needs a merge phi iff its value is not identical across every reaching arm.
		var differs = BoolArray.create()
		for k in 0 upto carried.count() 'eachVar'
			let v0 = try firstArm.exitVals.get(k) otherwise panic("finalizeMatchMerge: exitVals.get OOB at {k}")
			var anyDiff = false
			for i in 1 upto reachingArms.count() 'eachArm'
				let arm = try reachingArms.get(i) otherwise panic("finalizeMatchMerge: reachingArms.get OOB at {i}")
				let vi = try arm.exitVals.get(k) otherwise panic("finalizeMatchMerge: exitVals.get OOB at {k}")
				if vi != v0 'diff'
					anyDiff = true
				end 'diff'
			end 'eachArm'
			differs.push(anyDiff)
		end 'eachVar'

		// Mint the merge block-args. The result phi (if any) leads, so it is block-arg 0 and every
		// edge lists its `gives` value first.
		var result = MatchGiveValue.none
		if isExpression 'resultPhi'
			let firstGive = try finalGives.get(0) otherwise panic("finalizeMatchMerge: finalGives is empty for an expression match — resolveGivesOwnership fills one per reaching arm")
			let giveType = self.typeOf(firstGive)
			let phiId = self.mintPhi(merge, tag: maxonTypeTag(giveType), nameId: typeNameIdOf(giveType))
			// The phi is the new sole owner of the transferred give value (see the ownership-transfer
			// block above), so it is an owned temp: `parseBinding`/the statement drain drops it once.
			if resultOwned 'ownedResultPhi'
				self.trackOwnedTemp(phiId)
			end 'ownedResultPhi'

			// ⭐⭐ **AN IMMUTABLE-GLOBAL READ SURVIVES THE MERGE (P1.7 slice 2b).** The mark that refuses
			// `var b = <a `let` array>` rides the VALUE — deliberately, so it needs no second encoding of the
			// name-resolution order — and a merge MINTS A NEW VALUE, so without this the mark simply stops at
			// the join and the refusal is bypassed by writing the same thing one keyword longer:
			// `var pick = A if c else M`, or a `match … gives A` arm, then `pick.push(9)` grew a `let` array
			// with E2013, E3019 and the direct E2015 all intact (MEASURED at 3 where 2 is correct, through the
			// ternary AND the match-expression door, including the degenerate `A if c else A`).
			//
			// ANY marked arm marks the phi: the phi is one value standing for every arm's, so it is laundered
			// if even one path can reach it holding an immutable global's record. That is the conservative
			// direction, and it is the only sound one here — the alternative refuses nothing on the path that
			// actually aliases.
			self.propagateImmutableGlobalReadToPhi(phiId, gives: finalGives)

			// ⭐ **AN E3070 ELEMENT BORROW SURVIVES THE MERGE TOO, and for the very same reason** — a borrow is
			// keyed on the VALUE the accessor produced, and a merge MINTS A NEW VALUE, so without this a
			// `let s = try arr.get(0) otherwise "" if c else "…"` (and the `match … gives` spelling one
			// construct over) bound a phi no borrow was attached to and the following `arr.clear()` was waved
			// through: MEASURED 0xC0000005 on both. This is the second of the THREE merges the parser has; the
			// third is `finishValueTry`'s, hooked at its own `mintPhi`. A short-circuit's merge is excluded by
			// its TYPE — its phi is a bool, and no bool is an element borrow.
			for give in finalGives 'eachGive'
				self.retargetPendingBorrow(func, from: give, to: phiId)
			end 'eachGive'

			result = MatchGiveValue.value(phiId)
		end 'resultPhi'

		for k in 0 upto carried.count() 'setBindings'
			var binding = try carried.get(k) otherwise panic("finalizeMatchMerge: carried.get OOB at {k}")
			let isDifferent = try differs.get(k) otherwise panic("finalizeMatchMerge: differs.get OOB at {k}")
			if isDifferent 'phiVar'
				binding.boundValue = self.mintPhiForBinding(merge, binding: binding)
			end 'phiVar' else 'common'
				binding.boundValue = try firstArm.exitVals.get(k) otherwise panic("finalizeMatchMerge: exitVals.get OOB at {k}")
			end 'common'
		end 'setBindings'

		// Record each reaching arm's edge args, in the block-arg order minted above.
		for i in 0 upto reachingArms.count() 'recordEdges'
			var arm = try reachingArms.get(i) otherwise panic("finalizeMatchMerge: reachingArms.get OOB at {i}")
			var argIds = ValueIdArray.create()
			if isExpression 'giveArg'
				argIds.push(try finalGives.get(i) otherwise panic("finalizeMatchMerge: finalGives.get OOB at {i} — one entry per reaching arm"))
			end 'giveArg'
			for k in 0 upto carried.count() 'eachVarArg'
				let isDifferent = try differs.get(k) otherwise panic("finalizeMatchMerge: differs.get OOB at {k}")
				if isDifferent 'diffArg'
					argIds.push(try arm.exitVals.get(k) otherwise panic("finalizeMatchMerge: exitVals.get OOB at {k}"))
				end 'diffArg'
			end 'eachVarArg'

			// The edge is pushed onto the arm's exit block DIRECTLY here, not through `recordBranchEdge`,
			// and that is a deliberate bootstrap-fixpoint workaround, not a style slip: the whole-program
			// mutating-parameter analysis that decides whether `recordBranchEdge`'s `block` is mutated does
			// not converge once the give-ownership helpers enter this function's call graph, so it
			// alternately demands `let` (E3019) and `var` (E3077) for the loop's arm. Mutating `arm`'s own
			// block here is analysed locally and is stable. `argIds.count() == 0` means no phi rides this
			// edge — the same guard `recordBranchEdge` applies — so nothing is recorded for a zero-arg edge.
			if argIds.count() > 0 'hasEdgeArgs'
				arm.exitBlock.branchEdges.push(BranchEdge.create(merge.id, argIds: argIds))
			end 'hasEdgeArgs'
		end 'recordEdges'

		return MatchOutcome.create(merge, result: result)
	end 'finalizeMatchMerge'

	// ⭐ **IS THIS MERGE ARM'S GIVE VALUE AN INTEGER-DOMAIN NUMBER a float arm promotes to float (P1.5 #31)?**
	// True for a plain `int`, an `ExitCode`, or a ranged-INT alias — everything `cvtsi2sd` reads soundly.
	// False for a `float` or ranged-float alias (ALREADY in the float domain — no promotion), for a
	// bool/String/function/type-parameter (NON-numeric — a genuine type mismatch), and for a `named`
	// AGGREGATE, which is numeric-CLASSED (`typeClassOf(named) == numeric`) but is a POINTER to a box that
	// `cvtsi2sd` would corrupt — told apart from a numeric alias by `aggregateNameOf`, exactly as
	// `checkGiveTypes` tells them apart. Reads the tag/name columns only, materialising no `MaxonType`.
	function giveIsPromotableToFloat(give ValueId) returns bool
		let tag = self.tagOf(give)
		let nameId = self.valueNameId(give)

		// A plain `int` or an `ExitCode` is an integer-domain number — always promotable.
		if tagIsInteger(tag) or tag == ValueTypeTag.exitCode 'plainInteger'
			return true
		end 'plainInteger'

		// A `named` value is a ranged alias OR a declared aggregate. A ranged-FLOAT alias is already
		// float-domain (no promotion); a declared aggregate (union/enum/per-instance alias) is a POINTER,
		// not a number, that `cvtsi2sd` would corrupt (`aggregateNameOf` names it); only a plain ranged-INT
		// alias — numeric, no aggregate name — promotes.
		if tag == ValueTypeTag.named 'namedType'
			if self.namedIsFloatAlias(nameId) 'floatAlias'
				return false
			end 'floatAlias'
			return self.aggregateNameOf(tag, nameId: nameId).isEmpty()
		end 'namedType'

		// A `float` (already float-domain), bool, String, function, struct, type parameter, generic
		// instance, unresolved or void give is not an integer-domain number and does not promote.
		return false
	end 'giveIsPromotableToFloat'

	// The printable type name a merge arm's give value carries — a scalar class (`int`/`bool`/`String`/…) or
	// a declared aggregate's interned name — the same column `checkGiveTypes` names a mismatch by.
	function giveDisplayName(give ValueId) returns String
		let tag = self.tagOf(give)
		return self.giveTypeName(tag, aggregateName: self.aggregateNameOf(tag, nameId: self.valueNameId(give)))
	end 'giveDisplayName'

	// A give-type mismatch between the FIRST arm and `gotArm`, phrased for `construct` through the shared
	// `valueMergeMismatchError` mapping. A ternary always names its FALSE (second) branch whichever arm
	// actually mismatched — it has exactly two arms and the message reads them in source order — so the
	// displayed "got" arm is arm 1 for a ternary and the mismatching arm itself for a match.
	function valueMergeGiveMismatch(construct MergeConstruct, reachingArms MatchArmExitArray, firstArm MatchArmExit, gotArm MatchArmExit, matchTok Token) returns ParseError
		var displayArm = gotArm
		if construct == MergeConstruct.ternary 'ternaryFalseArm'
			displayArm = try reachingArms.get(1) otherwise panic("valueMergeGiveMismatch: a ternary merge has no second (false) arm")
		end 'ternaryFalseArm'
		return valueMergeMismatchError(construct == MergeConstruct.ternary, expectedDisplay: self.giveDisplayName(self.giveValueOf(firstArm.give)), gotDisplay: self.giveDisplayName(self.giveValueOf(displayArm.give)), line: matchTok.line, column: matchTok.column)
	end 'valueMergeGiveMismatch'

	// The name a `gives` value prints under in a match type-agreement diagnostic: a declared struct or
	// union by its interned aggregate NAME, and every scalar — an `int`, a `bool`, a `String`, a
	// ranged-int alias whose overloaded `named` tag is NOT an aggregate — by its resolved primitive name.
	// `aggregateName` is `aggregateNameOf`'s result for the value, which is empty for anything that is not
	// a declared aggregate — so the choice is exactly whether that name is present. One home for the two
	// `got`/`expected` operands so the three mismatch shapes phrase the value one way.
	function giveTypeName(tag ValueTypeTag, aggregateName ByteArray) returns String
		if aggregateName.isEmpty() 'scalar'
			return typeTagName(tag)
		end 'scalar'

		return String.from(aggregateName)
	end 'giveTypeName'

	// The `gives` value an expression arm carries. Only ever asked of an expression-match arm, so a
	// `none` is a parser invariant break, not a program error. Takes the `MatchGiveValue` itself so both
	// `MatchArmExit` and the arm loop's `MatchArmBody` reach it through the one extractor.
	function giveValueOf(give MatchGiveValue) returns ValueId
		match give 'g'
			value(id) then return id
			none then panic("giveValueOf: an expression-match arm carries no `gives` value")
		end 'g'
	end 'giveValueOf'

	// ⭐ **TRANSFER AN OWNED `gives` VALUE OUT OF ITS OWNER (P1.3).** An expression arm whose yielded value
	// is OWNED — an owned interpolation/heap `String`, a struct box, or a managed payload a binding arm
	// moved out (`text(s) gives s`) — hands that value to the merge's result phi, which becomes its sole
	// owner (`finalizeMatchMerge` marks the phi owned so its consumer drops it once). So the value must
	// leave its current owner HERE, before `dropArmScopedOwned` releases the arm's bindings and before the
	// post-match statement drain runs: an owned temporary leaves the pending list, and a bare-local owner
	// (the payload binding of `text(s) gives s`, or an outer owned binding) is poisoned so `emitScopeDrops`
	// skips its drop and a later read of it is use-after-move. A borrowed/scalar give owns nothing, so both
	// calls are no-ops — a borrowed String is promoted at the merge instead, where phi ownership is decided.
	// ⭐ **SETTLE ONE MATCH ARM'S OWN VALUES BEFORE ITS EDGE LEAVES.** Two things an arm owes, which used to
	// be one thing done twice (the give transfer was spelled at both the pattern-arm and default-arm sites)
	// and one thing done nowhere:
	//
	//   • an OWNED `gives` value ESCAPES to the result phi, so it leaves its owner here — the merge drops it,
	//     not the arm (`transferGiveToPhi`);
	//   • every TEMPORARY the arm body built and abandoned is released in the arm's OWN exit block, which is
	//     the only block those definitions dominate. An arm runs on one edge, so a release after the merge
	//     would free a value the other arms never built — the short-circuit mistake, in a wider construct.
	//     The give is transferred FIRST, so an escaping value is out of the list before the sweep.
	//
	// Inert for a `then` arm: its body is a STATEMENT, and the statement tail already released the whole list
	// on its own edge, leaving nothing above the floor. It is the `gives` arm of a match EXPRESSION — which
	// parses an expression and so has no statement tail — that this exists for.
	function finishArmValues(armBody MatchArmBody, tempFloor TempDropMark, isExpression bool, anchor Token) throws ParseError
		if isExpression 'transferGive'
			try self.transferGiveToPhi(self.giveValueOf(armBody.give), anchor: anchor)
		end 'transferGive'

		let resumeBlock = self.currentBlock
		self.currentBlock = armBody.exitBlock
		self.drainPendingTemps(tempFloor, anchor: anchor)
		self.currentBlock = resumeBlock
	end 'finishArmValues'

	function transferGiveToPhi(give ValueId, anchor Token) throws ParseError
		if not self.valueIsOwnedHeap(give) 'borrowed'
			return
		end 'borrowed'
		self.removeFromPendingTemps(give)
		try self.poisonMoveSource(give, anchor: anchor)
	end 'transferGiveToPhi'

	// Decide whether an expression match's result phi OWNS its value, and make every arm's give owned so it
	// does. The phi is owned iff any reaching arm gives an owned value (`finalizeMatchMerge` then marks it an
	// owned temp); when it is, each arm that gives a BORROWED value is made owned by `promoteBorrowedGive`
	// (a borrowed String is copied; a borrowed non-text aggregate has no cheap copy and is E2015-refused)
	// so the phi is uniformly owned across all edges. A statement match, or an expression match whose arms
	// all give scalars / immortal rdata, keeps a borrowed phi (returns false).
	//
	// The per-arm give value the merge should use — after any promotion — is collected into `finalGives`
	// (one entry per reaching arm, in order) rather than written back onto the `MatchArmExit`, so nothing
	// here mutates the arm records the caller still reads. `finalGives` is empty for a statement match.
	// Carry the immutable-global-read mark from a merge's arms onto its result phi (P1.7 slice 2b) — see the
	// call site in `finalizeMatchMerge` for why the phi must inherit it at all.
	//
	// It reads the FINAL gives (post-`resolveGivesOwnership`), which is the set of values the phi genuinely
	// joins. On today's rules that is the same set as the raw gives whenever a mark can be present at all: a
	// marked value is a borrowed non-text AGGREGATE (only an ARRAY binding is both stored and immutable — a
	// `let` String has no slot to read), and `promoteBorrowedGive` REFUSES a borrowed aggregate rather than
	// promoting one, so an owned phi cannot have a marked arm. Reading the finals anyway keeps this true if
	// that ever gains a real aggregate copy: the copy's fresh record is what the phi would then hold, and a
	// fresh record is correctly unmarked.
	function propagateImmutableGlobalReadToPhi(phi ValueId, gives ValueIdArray)
		for give in gives 'eachGive'
			if self.immutableGlobalReads.contains(give) 'markedArm'
				self.markImmutableGlobalRead(phi)
				return
			end 'markedArm'
		end 'eachGive'
	end 'propagateImmutableGlobalReadToPhi'

	function resolveGivesOwnership(reachingArms MatchArmExitArray, isExpression bool, matchTok Token, finalGives ValueIdArray) returns bool throws ParseError
		if not isExpression 'statementMatch'
			return false
		end 'statementMatch'

		var resultOwned = false
		for i in 0 upto reachingArms.count() 'anyOwned'
			let a = try reachingArms.get(i) otherwise panic("resolveGivesOwnership: reachingArms.get OOB at {i}")
			let give = self.giveValueOf(a.give)
			if self.valueIsOwnedHeap(give) 'owned'
				resultOwned = true
			end 'owned'
		end 'anyOwned'

		for i in 0 upto reachingArms.count() 'collectGives'
			let a = try reachingArms.get(i) otherwise panic("resolveGivesOwnership: reachingArms.get OOB at {i}")
			let give = self.giveValueOf(a.give)
			if resultOwned and not self.valueIsOwnedHeap(give) 'promoteBorrowed'
				finalGives.push(try self.promoteBorrowedGive(give, arm: a, matchTok: matchTok))
			end 'promoteBorrowed' else 'keepGive'
				finalGives.push(give)
			end 'keepGive'
		end 'collectGives'

		return resultOwned
	end 'resolveGivesOwnership'

	// Make a BORROWED `gives` value owned so a match/conditional whose OTHER arms give owned values has a
	// uniformly-owned result phi its consumer can drop unconditionally. A borrowed STRING is copied — the
	// SAME fused-record blit a borrowed `return`/`var` makes (`promoteToOwnedString`), emitted into the
	// arm's still-unterminated exit block; it is a fresh owned temp the arm hands straight to the phi, so it
	// leaves the pending list at once.
	//
	// A borrowed non-text AGGREGATE (a struct box or a boxed union — a field read, or a re-borrowed param)
	// has NO cheap promotion: shv2 has neither `__mm_incref` nor an aggregate deep-copy, exactly the
	// boundary that already E2015-refuses `return <borrowed aggregate>` (`emitOwnedValueReturn`). Left
	// unpromoted it would hand the owned phi a box it does not own, and the phi's single drop double-frees
	// the box the borrow's real owner also frees — a leak/UAF (OPEN #14, reachable via a `match … gives`
	// arm AND a ternary arm alike). So it is REFUSED here (E2015), not returned unpromoted: every program
	// this rejects currently leaks (exit 101), so the refusal cannot break a passing one.
	//
	// An UNRESOLVED give reaches here too, and is DEFERRED, not refused: a give whose type could not be
	// pinned at parse is a call NO file declares (`mintCallResult` defers rather than throwing), and
	// `checkGiveTypes` let it through because `typesAgree` lets `unresolved` agree with anything and its
	// `aggregateNameOf` is empty. The program is doomed — SemanticCheck rejects the undeclared call (E3004)
	// before any codegen, so the phi's ownership never matters — so the give is left unpromoted (the pre-#14
	// behavior) to let the real diagnostic surface instead of a parser panic. A RESOLVED scalar give cannot
	// reach here: `checkGiveTypes` rejects a resolved scalar arm mixed with an owned aggregate/String give,
	// so it is a parser invariant break.
	function promoteBorrowedGive(give ValueId, arm MatchArmExit, matchTok Token) returns ValueId throws ParseError
		let giveTag = self.tagOf(give)
		if tagIsText(giveTag) 'text'
			let saved = self.currentBlock
			self.currentBlock = arm.exitBlock
			let owned = self.promoteToOwnedString(give, range: SourceRange.ofToken(matchTok))
			self.removeFromPendingTemps(owned)
			self.currentBlock = saved
			return owned
		end 'text'

		if self.valueIsNonTextAggregate(give) 'borrowedAggregate'
			// `named` is the boxed-union tag whose `typeTagName` reads as a bare `int` (it is erased to one
			// later), so the aggregate's real name comes from the registry via `aggregateNameOf` — the same
			// column `checkGiveTypes` names a give by. Non-empty for both throwing shapes (a struct's name, a
			// registered union's name), so the interpolation always names the declared aggregate.
			let aggregateName = self.aggregateNameOf(giveTag, nameId: self.valueNameId(give))
			throw ParseError.unsupported("a match or conditional arm that gives a borrowed `{String.from(aggregateName)}` value while another arm gives an OWNED one — the merged result would adopt and free the borrowed struct/union box while the borrow's own owner frees it too, a double free. Give an OWNED value on every arm; consuming or copying a borrowed aggregate to give it arrives with cross-call consume", line: matchTok.line, column: matchTok.column)
		end 'borrowedAggregate'

		if tagIsUnresolved(giveTag) 'deferredCallError'
			return give
		end 'deferredCallError'

		panic("promoteBorrowedGive: a RESOLVED borrowed scalar give reached an OWNED result phi — checkGiveTypes rejects a resolved scalar mixed with an owned aggregate/String give, and an unresolved give is deferred above, so this is unreachable")
	end 'promoteBorrowedGive'

	// Emit one arm's pattern as a single boolean condition, OR-folding the alternatives (`1 or 2 or
	// 3`). Records single-value patterns for the duplicate check and rejects a pattern whose type
	// cannot be compared to the scrutinee (E2028). Emits into `currentBlock`.
	function emitPatternCondition(scrut ValueId, scrutTag ValueTypeTag, seenValues SeenPatternValues) returns ValueId throws ParseError
		var cond = try self.emitPatternAtom(scrut, scrutTag: scrutTag, seenValues: seenValues)
		while self.at(TokenKind.or) 'orChain'
			let orTok = try self.consume(TokenKind.or)
			let rhs = try self.emitPatternAtom(scrut, scrutTag: scrutTag, seenValues: seenValues)
			cond = try self.emitBinOp(cond, rhs: rhs, op: MaxonBinOp.bitOr, opTok: orTok)
		end 'orChain'
		return cond
	end 'emitPatternCondition'

	// One alternative of a pattern: an open-lower range (`min to/upto hi`), a closed/open-upper
	// range (`lo to/upto hi`, `lo to max`), or a single value.
	function emitPatternAtom(scrut ValueId, scrutTag ValueTypeTag, seenValues SeenPatternValues) returns ValueId throws ParseError
		let startTok = self.current()

		if self.isOpenBoundIdentifier(startTok, marker: MinBoundField) 'openLower'
			self.advance()
			return try self.emitOpenLowerRange(scrut, scrutTag: scrutTag)
		end 'openLower'

		let lo = try self.emitPatternValue(scrutTag)

		if self.at(TokenKind.to) or self.at(TokenKind.upto) 'rangeArm'
			let isUpto = self.at(TokenKind.upto)
			let rangeTok = self.current()
			self.advance()
			return try self.emitClosedRange(scrut, scrutTag: scrutTag, loValue: lo, isUpto: isUpto, rangeTok: rangeTok)
		end 'rangeArm'

		// A single value: `scrut == lo`.
		try self.checkAndRecordDuplicate(lo, seenValues: seenValues, patternTok: startTok)
		return try self.emitCompare(scrut, rhs: lo, op: MaxonCmpOp.eq, opTok: startTok)
	end 'emitPatternAtom'

	// `min to/upto <hi>` — the lower bound is open, so the condition is just the upper compare. A
	// `min to max` covers every value: a constant `true`.
	function emitOpenLowerRange(scrut ValueId, scrutTag ValueTypeTag) returns ValueId throws ParseError
		if not (self.at(TokenKind.to) or self.at(TokenKind.upto)) 'notRange'
			let notRangeTok = self.current()
			throw ParseError.unexpectedToken(TokenKind.to.rawValue, got: notRangeTok.kind.rawValue, line: notRangeTok.line, column: notRangeTok.column)
		end 'notRange'
		let isUpto = self.at(TokenKind.upto)
		let rangeTok = self.current()
		self.advance()

		if self.isOpenBoundIdentifier(self.current(), marker: MaxBoundField) 'openBoth'
			self.advance()
			return self.emitLiteral(BoolTrueValue, valueType: MaxonType.boolean, range: SourceRange.ofToken(rangeTok))
		end 'openBoth'

		let hi = try self.emitPatternValue(scrutTag)
		return try self.emitCompare(scrut, rhs: hi, op: self.rangeUpperCmpOp(isUpto), opTok: rangeTok)
	end 'emitOpenLowerRange'

	// `lo to/upto <hi>` where `lo` is already emitted — a two-compare AND, or (`lo to max`) just the
	// lower compare.
	function emitClosedRange(scrut ValueId, scrutTag ValueTypeTag, loValue ValueId, isUpto bool, rangeTok Token) returns ValueId throws ParseError
		if self.isOpenBoundIdentifier(self.current(), marker: MaxBoundField) 'openUpper'
			self.advance()
			return try self.emitCompare(scrut, rhs: loValue, op: MaxonCmpOp.ge, opTok: rangeTok)
		end 'openUpper'

		let hi = try self.emitPatternValue(scrutTag)
		let loCmp = try self.emitCompare(scrut, rhs: loValue, op: MaxonCmpOp.ge, opTok: rangeTok)
		let hiCmp = try self.emitCompare(scrut, rhs: hi, op: self.rangeUpperCmpOp(isUpto), opTok: rangeTok)
		return try self.emitBinOp(loCmp, rhs: hiCmp, op: MaxonBinOp.bitAnd, opTok: rangeTok)
	end 'emitClosedRange'

	// The upper-bound comparison: `<` for `upto` (exclusive), `<=` for `to` (inclusive).
	function rangeUpperCmpOp(isUpto bool) returns MaxonCmpOp
		if isUpto 'exclusive'
			return MaxonCmpOp.lt
		end 'exclusive'
		return MaxonCmpOp.le
	end 'rangeUpperCmpOp'

	// Parse a pattern LITERAL (a value or a range bound): an optional `-`, then an int/float/bool/
	// character literal. Emits it and checks it is comparable to the scrutinee (E2028). A string
	// literal is E2028 (`"one"` on an `int` scrutinee); `min`/`max` are the caller's, not a value.
	function emitPatternValue(scrutTag ValueTypeTag) returns ValueId throws ParseError
		let firstTok = self.current()

		// A STRING LITERAL pattern — legal only against a `string` scrutinee (P1.2 wave A). Its
		// condition is `__str_eq(scrut, "literal")`: `emitPatternAtom`'s single-value path emits the
		// literal here and then `emitCompare(scrut, lo, eq)`, which — both operands `string` — routes to
		// the `__str_eq` runtime call, feeding the SAME bool the scalar `or`/`default`/expression-merge
		// machinery consumes for an integer pattern. So `match name { "alice" then … }` reuses the whole
		// scalar dispatch unchanged; only "what a pattern atom IS" differs. Against a NON-string
		// scrutinee it stays the E2028 mismatch (`"one"` on an `int`).
		if self.at(TokenKind.stringLiteral) 'stringPattern'
			if tagIsText(scrutTag) 'stringScrutinee'
				// A pattern is a COMPILE-TIME literal — an interpolation there has no meaning (there is
				// nothing to match a runtime-built string against), so it is rejected rather than built.
				if self.peekKind() == TokenKind.stringInterpStart 'interpolatedPattern'
					throw ParseError.unsupported("an interpolated string as a match pattern — a `match` pattern must be a compile-time string literal", line: firstTok.line, column: firstTok.column)
				end 'interpolatedPattern'
				return try self.consumeStringLiteralValue()
			end 'stringScrutinee'
			throw ParseError.matchPatternTypeMismatch("String", scrutineeType: typeTagName(scrutTag), line: firstTok.line, column: firstTok.column)
		end 'stringPattern'

		if self.at(TokenKind.minus) 'negated'
			try self.consume(TokenKind.minus)
			let negValue = try self.emitNegatedPatternValue(firstTok)
			return try self.checkPatternType(negValue, scrutTag: scrutTag, patternTok: firstTok)
		end 'negated'

		if self.at(TokenKind.intLiteral) 'intPattern'
			let intValue = try self.parseIntLiteral()
			return try self.checkPatternType(intValue, scrutTag: scrutTag, patternTok: firstTok)
		end 'intPattern'

		if self.at(TokenKind.floatLiteral) 'floatPattern'
			let floatValue = try self.parseFloatLiteral()
			return try self.checkPatternType(floatValue, scrutTag: scrutTag, patternTok: firstTok)
		end 'floatPattern'

		if self.at(TokenKind.true) or self.at(TokenKind.false) 'boolPattern'
			let boolValue = try self.parseBoolLiteral()
			return try self.checkPatternType(boolValue, scrutTag: scrutTag, patternTok: firstTok)
		end 'boolPattern'

		if self.at(TokenKind.charLiteral) 'charPattern'
			let charValue = try self.parseCharLiteral()
			return try self.checkPatternType(charValue, scrutTag: scrutTag, patternTok: firstTok)
		end 'charPattern'

		// A bare identifier (that is not `min`/`max`, handled by the caller) is an enum-case pattern.
		if self.at(TokenKind.identifier) 'enumCasePattern'
			throw ParseError.unsupported("a match pattern naming '{String.from(firstTok.value)}' (only literal, range, and 'or' patterns over a scalar are supported; enum-case patterns arrive in a later wave)", line: firstTok.line, column: firstTok.column)
		end 'enumCasePattern'

		throw ParseError.expectedExpression(firstTok.kind.rawValue, line: firstTok.line, column: firstTok.column)
	end 'emitPatternValue'

	// The value after a pattern's `-`: a negated int, or `0.0 - x` for a float. Any other token
	// after `-` has no numeric meaning to negate.
	function emitNegatedPatternValue(minusTok Token) returns ValueId throws ParseError
		if self.at(TokenKind.intLiteral) 'negInt'
			let tok = try self.consume(TokenKind.intLiteral)
			let v = try self.intLiteralValue(tok, negated: true)
			return self.emitLiteral(v, valueType: MaxonType.integer, range: SourceRange.ofToken(minusTok))
		end 'negInt'

		if self.at(TokenKind.floatLiteral) 'negFloat'
			let base = try self.parseFloatLiteral()
			return try self.emitFloatNegation(base, opTok: minusTok)
		end 'negFloat'

		let operandTok = self.current()
		throw ParseError.nonNumericNegation(operandTok.kind.rawValue, line: minusTok.line, column: minusTok.column)
	end 'emitNegatedPatternValue'

	// A pattern value must be comparable to the scrutinee — the same DOMAIN rule `emitCompare`
	// applies, asked HERE so the failure is the match-specific E2028 rather than the comparison's
	// E3005. `emitCompare` therefore never rejects a pattern it is handed.
	function checkPatternType(value ValueId, scrutTag ValueTypeTag, patternTok Token) returns ValueId throws ParseError
		let valTag = self.tagOf(value)
		if not comparableOperands(scrutTag, right: valTag) 'mismatch'
			throw ParseError.matchPatternTypeMismatch(typeTagName(valTag), scrutineeType: typeTagName(scrutTag), line: patternTok.line, column: patternTok.column)
		end 'mismatch'
		return value
	end 'checkPatternType'

	// Record a single-value pattern for duplicate detection, or raise E2027 if it repeats one. Only
	// KNOWN-constant patterns (integer literals) participate; a float literal's bits are not tracked
	// as a constant (see `parseFloatLiteral`), and no corpus case tests a duplicate float.
	function checkAndRecordDuplicate(value ValueId, seenValues SeenPatternValues, patternTok Token) throws ParseError
		if not self.constIsKnown(value) 'notConst'
			return
		end 'notConst'

		try self.recordDuplicateInt(self.constOf(value), seenValues: seenValues, patternTok: patternTok)
	end 'checkAndRecordDuplicate'

	// The integer core of duplicate detection, shared by the compare-emitting scalar path (`value` read
	// off a known constant) and the interval-plan path (`value` decoded straight from the pattern token).
	// The set membership test throws on the FIRST repeat in arm order — the same value, the same arm, the
	// linear scan reported — in O(1) rather than O(seen).
	function recordDuplicateInt(value ParsedInt, seenValues SeenPatternValues, patternTok Token) throws ParseError
		if seenValues.contains(value) 'duplicate'
			throw ParseError.matchDuplicatePattern("{value}", line: patternTok.line, column: patternTok.column)
		end 'duplicate'
		seenValues.insert(value)
	end 'recordDuplicateInt'

	// Does `tok` name an open range bound (`min` / `max`) — an identifier whose text is the marker?
	// `min`/`max` lex as identifiers (they are not keywords), and appear only in a range, so their
	// text alone decides it. The bound-field constants spell the same two words the ranged-typealias
	// `.min` / `.max` do, deliberately: it is one lexical fact, not two.
	function isOpenBoundIdentifier(tok Token, marker ByteArray) returns bool
		return tok.kind == TokenKind.identifier and tok.value.equals(marker)
	end 'isOpenBoundIdentifier'

	// ============================================================================================
	// The match DISPATCH PLAN — normalized `[lo, hi]` intervals + strategy (chain vs binary search).
	//
	// A `match` over an integer-like scrutinee reduces every arm to `DispatchInterval`s here rather than
	// emitting a per-arm compare chain inline: the arm loop collects the intervals, `normalizeDispatchIntervals`
	// sorts and clips them, and `emitMatchDispatch` chooses the strategy and emits ALL the compares in one
	// place. A `String`/`float` match keeps `emitPatternCondition` (the linear chain), which is why that
	// path is untouched. NO new IR op — every compare is the same `compare`/`condBranch` the chain used.
	// ============================================================================================

	// Does this `match` build a binary-search DISPATCH PLAN, or keep the linear compare chain? An
	// enum/union tag is always an i64, so every enum match plans. A scalar match plans only when the
	// scrutinee is orderable as one signed i64 — `int`, `char` (a byte value), `bool`, `ExitCode`, or a
	// ranged-INT alias (`named`, told from a ranged-FLOAT alias by its declared backing, exactly as
	// `valueIsUnsigned` reads the alias registry). A `String` (no interval — its only comparison is a
	// runtime byte `==`) and a `float` (whose IEEE bits are not monotonic in value) keep the chain.
	function matchUsesIntervalPlan(isEnumMatch bool, scrut ValueId) returns bool
		if isEnumMatch 'enum'
			return true
		end 'enum'

		let scrutTag = self.tagOf(scrut)
		if tagIsInteger(scrutTag) or scrutTag == ValueTypeTag.boolean or scrutTag == ValueTypeTag.exitCode 'plainInteger'
			return true
		end 'plainInteger'

		if scrutTag == ValueTypeTag.named 'aliasScrutinee'
			let name = self.internedName(self.valueNameId(scrut))
			return match self.signatures.aliasOf(name, readerFilePath: self.filePath) 'a'
				declared(alias) gives not tagIsFloat(maxonTypeTag(alias.underlying))
				undeclared gives false
			end 'a'
		end 'aliasScrutinee'

		return false
	end 'matchUsesIntervalPlan'

	// One arm's SCALAR pattern (an integer-like scrutinee), reduced to DISPATCH INTERVALS. Mirrors
	// `emitPatternCondition`'s grammar — `or`-separated alternatives, each a value, a range, or an
	// open-ended range — but yields intervals over the pattern CONSTANTS rather than an emitted `or`-fold
	// of compares. The float/String path keeps `emitPatternCondition`, so this handles only what
	// `matchUsesIntervalPlan` gates in.
	function collectScalarPatternIntervals(scrutTag ValueTypeTag, seenValues SeenPatternValues, bodyBlockId BlockId, into DispatchIntervalArray) throws ParseError
		try self.collectScalarPatternAtom(scrutTag, seenValues: seenValues, bodyBlockId: bodyBlockId, into: into)
		while self.at(TokenKind.or) 'orChain'
			try self.consume(TokenKind.or)
			try self.collectScalarPatternAtom(scrutTag, seenValues: seenValues, bodyBlockId: bodyBlockId, into: into)
		end 'orChain'
	end 'collectScalarPatternIntervals'

	// One alternative: an open-lower range (`min to/upto hi`), a closed/open-upper range (`lo to/upto hi`,
	// `lo to max`), or a single value. Appends exactly one interval.
	function collectScalarPatternAtom(scrutTag ValueTypeTag, seenValues SeenPatternValues, bodyBlockId BlockId, into DispatchIntervalArray) throws ParseError
		let startTok = self.current()

		if self.isOpenBoundIdentifier(startTok, marker: MinBoundField) 'openLower'
			self.advance()
			try self.collectScalarRangeInterval(I64MinBound, scrutTag: scrutTag, bodyBlockId: bodyBlockId, into: into)
			return
		end 'openLower'

		let lo = try self.decodeScalarPatternBound(scrutTag)

		if self.at(TokenKind.to) or self.at(TokenKind.upto) 'rangeArm'
			try self.collectScalarRangeInterval(lo, scrutTag: scrutTag, bodyBlockId: bodyBlockId, into: into)
			return
		end 'rangeArm'

		try self.recordDuplicateInt(lo, seenValues: seenValues, patternTok: startTok)
		into.push(DispatchInterval.create(lo, hi: lo, targetBlockId: bodyBlockId, edgeArgs: ValueIdArray.create()))
	end 'collectScalarPatternAtom'

	// Consume a range upper (`to`/`upto <literal|max>`) with the cursor at the keyword, and push the arm's
	// interval `[lo, hi]` — UNLESS the range is empty, in which case the arm matches nothing and NO interval
	// is pushed (its twin `collectEnumRangeIntervals` throws `matchEmptyRange`; a scalar range has always
	// been silently empty, matching the always-false compare the old chain emitted). `upto` is exclusive, so
	// its inclusive upper is `hi - 1` — computed ONLY once the range is known non-empty, because `upto
	// i64.min` is ALWAYS empty (nothing is below `i64.min`) and `i64.min - 1` would wrap to `i64.max`,
	// turning the empty range into a near-universal one. That underflow was a real miscompile: `0 upto
	// i64.min` matched every value ≥ 0 instead of nothing.
	function collectScalarRangeInterval(lo ParsedInt, scrutTag ValueTypeTag, bodyBlockId BlockId, into DispatchIntervalArray) throws ParseError
		let isUpto = self.at(TokenKind.upto)
		self.advance()

		// `max` reads as `i64.max` inclusive under EITHER keyword (as `emitClosedRange`'s open-upper arm drops
		// the keyword), so `lo to/upto max` covers `[lo, i64.max]` and is never empty.
		if self.isOpenBoundIdentifier(self.current(), marker: MaxBoundField) 'openUpper'
			self.advance()
			into.push(DispatchInterval.create(lo, hi: I64MaxBound, targetBlockId: bodyBlockId, edgeArgs: ValueIdArray.create()))
			return
		end 'openUpper'

		let rawHi = try self.decodeScalarPatternBound(scrutTag)

		// `upto` excludes `rawHi`, so it is empty when `lo >= rawHi`; inclusive `to` when `lo > rawHi`. An
		// empty range (as before this rung) contributes no interval — the arm body is left unreachable.
		let isEmpty = (isUpto and lo >= rawHi) or ((not isUpto) and lo > rawHi)
		if isEmpty 'emptyRange'
			return
		end 'emptyRange'

		let hi = (rawHi - 1) if isUpto else rawHi
		into.push(DispatchInterval.create(lo, hi: hi, targetBlockId: bodyBlockId, edgeArgs: ValueIdArray.create()))
	end 'collectScalarRangeInterval'

	// Decode a single scalar pattern LITERAL — an int (optionally negated), a character, or a bool — to
	// its integer value, validating it is comparable to the scrutinee (E2028), WITHOUT emitting a
	// `literal` op: the dispatch materialises the constant later, once, as an immediate compare. The
	// float/String literal cases stay E2028 exactly as `emitPatternValue`'s do (only an integer-like
	// scrutinee reaches here); a `min`/`max` bound is the caller's, and any other identifier is the
	// enum-case-pattern error `emitPatternValue` raises.
	function decodeScalarPatternBound(scrutTag ValueTypeTag) returns ParsedInt throws ParseError
		let firstTok = self.current()

		if self.at(TokenKind.stringLiteral) 'stringPattern'
			throw ParseError.matchPatternTypeMismatch("String", scrutineeType: typeTagName(scrutTag), line: firstTok.line, column: firstTok.column)
		end 'stringPattern'

		if self.at(TokenKind.floatLiteral) 'floatPattern'
			throw ParseError.matchPatternTypeMismatch(typeTagName(ValueTypeTag.float), scrutineeType: typeTagName(scrutTag), line: firstTok.line, column: firstTok.column)
		end 'floatPattern'

		if self.at(TokenKind.minus) 'negated'
			try self.consume(TokenKind.minus)
			if self.at(TokenKind.floatLiteral) 'negFloat'
				throw ParseError.matchPatternTypeMismatch(typeTagName(ValueTypeTag.float), scrutineeType: typeTagName(scrutTag), line: firstTok.line, column: firstTok.column)
			end 'negFloat'
			if not self.at(TokenKind.intLiteral) 'nonNumeric'
				let operandTok = self.current()
				throw ParseError.nonNumericNegation(operandTok.kind.rawValue, line: firstTok.line, column: firstTok.column)
			end 'nonNumeric'
			let intTok = try self.consume(TokenKind.intLiteral)
			let value = try self.intLiteralValue(intTok, negated: true)
			return try self.checkScalarPatternBound(value, valTag: ValueTypeTag.integer, scrutTag: scrutTag, patternTok: firstTok)
		end 'negated'

		if self.at(TokenKind.intLiteral) 'intPattern'
			let intTok = try self.consume(TokenKind.intLiteral)
			let value = try self.intLiteralValue(intTok, negated: false)
			return try self.checkScalarPatternBound(value, valTag: ValueTypeTag.integer, scrutTag: scrutTag, patternTok: firstTok)
		end 'intPattern'

		if self.at(TokenKind.true) or self.at(TokenKind.false) 'boolPattern'
			let value = 1 as ParsedInt if self.at(TokenKind.true) else 0 as ParsedInt
			self.advance()
			return try self.checkScalarPatternBound(value, valTag: ValueTypeTag.boolean, scrutTag: scrutTag, patternTok: firstTok)
		end 'boolPattern'

		if self.at(TokenKind.charLiteral) 'charPattern'
			let charTok = try self.consume(TokenKind.charLiteral)
			let value = try self.decodeCharPatternValue(charTok)
			return try self.checkScalarPatternBound(value, valTag: ValueTypeTag.integer, scrutTag: scrutTag, patternTok: firstTok)
		end 'charPattern'

		if self.at(TokenKind.identifier) 'enumCasePattern'
			throw ParseError.unsupported("a match pattern naming '{String.from(firstTok.value)}' (only literal, range, and 'or' patterns over a scalar are supported; enum-case patterns arrive in a later wave)", line: firstTok.line, column: firstTok.column)
		end 'enumCasePattern'

		throw ParseError.expectedExpression(firstTok.kind.rawValue, line: firstTok.line, column: firstTok.column)
	end 'decodeScalarPatternBound'

	// A pattern bound must be comparable to the scrutinee — the interval twin of `checkPatternType`,
	// asked over a decoded value + its tag rather than an emitted ValueId, so the failure is the same
	// match-specific E2028.
	function checkScalarPatternBound(value ParsedInt, valTag ValueTypeTag, scrutTag ValueTypeTag, patternTok Token) returns ParsedInt throws ParseError
		if not comparableOperands(scrutTag, right: valTag) 'mismatch'
			throw ParseError.matchPatternTypeMismatch(typeTagName(valTag), scrutineeType: typeTagName(scrutTag), line: patternTok.line, column: patternTok.column)
		end 'mismatch'
		return value
	end 'checkScalarPatternBound'

	// ============================================================================================
	// ENUM `match` — case-name patterns + the OPEN #21 range rule (P1.1b wave B).
	//
	// Everything here feeds the SAME dispatch engine the scalar match uses (`parseMatchCommon`'s arm
	// loop, `condBranch` chain and merge): the only difference is that a pattern is a case NAME
	// resolved to a tag rather than a literal, and that coverage is a bitmap over the case set rather
	// than a default arm. NO new IR op — a case compare is the same `compare`/`condBranch` a scalar
	// arm emits.
	// ============================================================================================

	// The enum/union a match scrutinee belongs to, or `undeclared` for a scalar scrutinee. Read from
	// the scrutinee's TYPE — a `named(X)` value whose name is in the enum registry — so it works
	// uniformly for a parameter (`c Code`), a local (`let c = Color.red`) and a returned enum. The
	// enum's own name is on the value even after TypeResolution collapses the SIGNATURE type to
	// `integer`, because a value's tag is set by the parser and never rewritten.
	function enumMatchFor(scrut ValueId) returns DeclaredEnum
		if self.tagOf(scrut) != ValueTypeTag.named 'notNamed'
			return DeclaredEnum.undeclared
		end 'notNamed'
		let nameId = try self.valueNameIds.get(scrut) otherwise panic("enumMatchFor: value v{scrut} has no recorded type name — the two type columns fell out of lockstep")
		let name = try self.artifact.typeNames.nameOf(nameId) otherwise panic("enumMatchFor: type-name id {nameId} is not in this file's interner — every `named` tag is minted with an id from it")
		return self.signatures.enumOf(name)
	end 'enumMatchFor'

	// Is `value` a `union` value — a `named(X)` whose type is a declared `union`? The E3066 gate
	// (`emitCompare`), keyed on the SAME `enumMatchFor` a `match` reads its scrutinee's enum through,
	// so "is this a union?" is answered in one place for both. A payload-free ENUM is `false` (its
	// value is a plain tag that `==` may compare); only `isUnion` is a union.
	//
	// ⚠ **THE TAG PRE-CHECK IS A HOT-PATH ALLOCATION GUARD, NOT A TIDY EARLY RETURN.** This runs for
	// BOTH operands of EVERY comparison in the program, and `enumMatchFor` returns a `DeclaredEnum` —
	// a Maxon union VALUE, which is a heap object for its `undeclared` case as much as any other. So
	// calling it for an `int`/`bool` operand (the overwhelming majority) would allocate two throwaway
	// `DeclaredEnum.undeclared` boxes per compare, scaling with the program: scale-test charged
	// exactly that (+1,257 allocs on rung 0, doubling per rung). A value can only be a union if its
	// tag is `named`, and that test is a scalar column read that allocates nothing.
	function valueIsUnion(value ValueId) returns bool
		if self.tagOf(value) != ValueTypeTag.named 'notNamed'
			return false
		end 'notNamed'
		let decl = self.enumMatchFor(value)
		if not enumMatchIsDeclared(decl) 'notEnum'
			return false
		end 'notEnum'
		return requireEnumLayout(decl).isUnion
	end 'valueIsUnion'

	// Is `value` a payload-bearing (HEAP-BOXED) enum/union — a `named(X)` whose layout `isBoxed`?
	// `valueIsUnion`'s twin, differing only in the layout bit it reads: `isBoxed` (a heap box exists),
	// not `isUnion` (a union vs a bare enum). It is what tells a call RESULT that owns a heap box (a
	// boxed-union `make()`, adopted by the caller) from a payload-free enum value (a bare i64 tag,
	// dropped by no one) — the OPEN #44 distinction the tag alone cannot make, since both are `named`.
	// The same `named` tag pre-check is the hot-path allocation guard `valueIsUnion` documents.
	function valueIsBoxedUnion(value ValueId) returns bool
		if self.tagOf(value) != ValueTypeTag.named 'notNamed'
			return false
		end 'notNamed'
		let decl = self.enumMatchFor(value)
		if not enumMatchIsDeclared(decl) 'notEnum'
			return false
		end 'notEnum'
		return requireEnumLayout(decl).isBoxed()
	end 'valueIsBoxedUnion'

	// One arm's enum pattern, reduced to DISPATCH INTERVALS over the case tags (P1.1b + match-dispatch).
	// Alternatives (`red or blue`) each contribute their interval(s); a payload BINDING is legal only on
	// a SINGLE case (`walk(dir)`), never on an or-alternative. Returns the payload bindings the arm body
	// declares (empty for a bare case, an or-chain, or a range). Replaces the old compare-emitting
	// `emitEnumPatternCondition`: an enum/union tag is an i64, so an enum arm ALWAYS feeds the interval
	// plan, and the per-case `== tag` compare is emitted later — once — by the dispatch itself.
	function collectEnumPatternIntervals(layout EnumLayout, covered BoolArray, bodyBlockId BlockId, into DispatchIntervalArray) returns PayloadBindingArray throws ParseError
		let first = try self.collectEnumPatternAtomIntervals(layout, covered: covered, bodyBlockId: bodyBlockId, into: into)
		if not self.at(TokenKind.or) 'single'
			return first
		end 'single'

		try self.rejectOrPatternBinding(first)
		while self.at(TokenKind.or) 'orChain'
			try self.consume(TokenKind.or)
			let rhs = try self.collectEnumPatternAtomIntervals(layout, covered: covered, bodyBlockId: bodyBlockId, into: into)
			try self.rejectOrPatternBinding(rhs)
		end 'orChain'
		return PayloadBindingArray.create()
	end 'collectEnumPatternIntervals'

	// One alternative: a single case (`red`, or `walk(dir)` binding its payload) or a case-name range
	// (`low to high`, `low upto high`). Only the single-case form may carry payload bindings. Appends the
	// covered case tag(s) as point/range intervals into `into` and returns the payload bindings.
	function collectEnumPatternAtomIntervals(layout EnumLayout, covered BoolArray, bodyBlockId BlockId, into DispatchIntervalArray) returns PayloadBindingArray throws ParseError
		let patternTok = self.current()
		let lowIndex = try self.resolveEnumArmCase(layout)

		if self.at(TokenKind.to) or self.at(TokenKind.upto) 'rangeArm'
			let isUpto = self.at(TokenKind.upto)
			self.advance()
			let highIndex = try self.resolveEnumArmCase(layout)
			try self.collectEnumRangeIntervals(layout, lowIndex: lowIndex, highIndex: highIndex, isUpto: isUpto, covered: covered, patternTok: patternTok, bodyBlockId: bodyBlockId, into: into)
			return PayloadBindingArray.create()
		end 'rangeArm'

		var bindings = PayloadBindingArray.create()
		if self.at(TokenKind.leftParen) 'payloadBind'
			bindings = try self.parseCasePayloadBindings(layout, caseIndex: lowIndex)
		end 'payloadBind'

		try self.markEnumCovered(covered, index: lowIndex, layout: layout, patternTok: patternTok)
		let tag = layout.tagOfIndex(lowIndex)
		into.push(DispatchInterval.create(tag, hi: tag, targetBlockId: bodyBlockId, edgeArgs: ValueIdArray.create()))
		return bindings
	end 'collectEnumPatternAtomIntervals'

	// A payload binding is meaningful only where exactly one case matched — refuse it on an
	// or-alternative (`stay or walk(dir)`), whose alternatives may be different cases of different
	// arity. Positioned at the binding name.
	function rejectOrPatternBinding(atomBindings PayloadBindingArray) throws ParseError
		if atomBindings.count() == 0 'noBinding'
			return
		end 'noBinding'
		let binding = try atomBindings.get(0) otherwise panic("rejectOrPatternBinding: bindings.count() > 0 but get(0) failed")
		throw ParseError.unsupported("a payload binding '{String.from(binding.nameTok.value)}' on an `or`-pattern (a binding shared across the alternatives of an or-arm arrives at a later rung)", line: binding.nameTok.line, column: binding.nameTok.column)
	end 'rejectOrPatternBinding'

	// Parse a `(dir)` / `(_)` / `(a, b)` binding list on a single-case pattern, resolving each binding
	// against the case's declared payload fields in SLOT order. A `_` is the discard — it consumes a
	// slot but binds nothing. The binding count must equal the case's declared arity.
	function parseCasePayloadBindings(layout EnumLayout, caseIndex CaseIndex) returns PayloadBindingArray throws ParseError
		let payloads = layout.payloadsAt(caseIndex)
		try self.consume(TokenKind.leftParen)
		var bindings = PayloadBindingArray.create()

		while true 'bindLoop'
			let nameTok = try self.consume(TokenKind.identifier)
			if bindings.count() >= payloads.count() 'tooMany'
				throw ParseError.unsupported("case '{String.from(layout.caseNameAt(caseIndex))}' of `{layout.kindWord()} {String.from(layout.name)}` binds more payloads than the {payloads.count()} it declares", line: nameTok.line, column: nameTok.column)
			end 'tooMany'
			let field = try payloads.get(bindings.count()) otherwise panic("parseCasePayloadBindings: payloads.get OOB after the count guard")
			if nameTok.value.equals(DiscardBindingName) 'discard'
				bindings.push(PayloadBinding.discard(nameTok, field: field, slot: bindings.count()))
			end 'discard' else 'realBinding'
				try self.requireUnreservedName(nameTok)
				bindings.push(PayloadBinding.bound(nameTok, field: field, slot: bindings.count()))
			end 'realBinding'

			if not self.at(TokenKind.comma) 'endBindings'
				break
			end 'endBindings'
			try self.consume(TokenKind.comma)
		end 'bindLoop'

		let closeTok = self.current()
		try self.consume(TokenKind.rightParen)
		if bindings.count() != payloads.count() 'tooFew'
			throw ParseError.unsupported("case '{String.from(layout.caseNameAt(caseIndex))}' of `{layout.kindWord()} {String.from(layout.name)}` binds {bindings.count()} payload(s) but declares {payloads.count()}", line: closeTok.line, column: closeTok.column)
		end 'tooFew'
		return bindings
	end 'parseCasePayloadBindings'

	// Declare a single-case pattern's payload bindings at the head of the arm body — each a
	// `loadIndirect` from the SCRUTINEE BOX (`scrutBox`). Called inside a scope frame the arm loop opens,
	// so the bindings leave scope at the arm's `end` and cannot leak into the next arm. A discard `_`
	// binds nothing (its managed payload is left in the box and dropped by the scope-exit cascade).
	//
	// ⭐ **A SCALAR binding is a COPY** (not a borrow into the box), so dropping the box does not
	// invalidate it. A MANAGED binding (String/struct) is a MOVE-OUT: the binding OWNS the payload and
	// drops it at its own scope exit, and the box slot is nulled so the box's cascade skips it (see
	// `moveOutManagedPayload`). Returns whether ANY managed field was moved out — the whole match then
	// consumes the scrutinee (`markScrutineePartiallyMoved`).
	function declarePayloadBindings(bindings PayloadBindingArray, scrutBox ValueId, scrutOwned bool, layout EnumLayout) returns bool throws ParseError
		var movedManaged = false
		for binding in bindings 'each'
			if binding.isDiscard 'discard'
				continue
			end 'discard'
			let range = SourceRange.ofToken(binding.nameTok)
			// Adopt the signatures-layout payload id into this file's interner before classifying — the
			// match-bind twin of the construct-site adopt in `requirePayloadLowerable` (OPEN #52).
			let class = classifyUnionPayload(self.signatures, typeNames: self.artifact.typeNames, fieldType: self.signatures.adoptType(binding.field.declaredType, into: self.artifact.typeNames))
			let loaded = try self.emitUnionPayloadLoad(scrutBox, field: binding.field, slot: binding.slot, layout: layout, posTok: binding.nameTok, range: range)
			var bindingInfo = try self.scope.declareValueBinding(binding.nameTok.value, varType: self.typeOf(loaded), mutable: false, value: loaded) otherwise throw ParseError.localShadowsSelfField(String.from(binding.nameTok.value), typeName: String.from(self.enclosingType), line: binding.nameTok.line, column: binding.nameTok.column)
			if payloadClassIsManaged(class) 'managedMoveOut'
				try self.moveOutManagedPayload(bindingInfo, loaded: loaded, class: class, scrutBox: scrutBox, scrutOwned: scrutOwned, slot: binding.slot, layout: layout, nameTok: binding.nameTok, range: range)
				movedManaged = true
			end 'managedMoveOut'
		end 'each'
		return movedManaged
	end 'declarePayloadBindings'

	// ⭐ **MOVE A MANAGED PAYLOAD OUT OF THE SCRUTINEE BOX** into its binding — the match half of static
	// single-owner ownership. The binding OWNS the payload (enrolled in `ownedBindings`, so it drops at
	// its own scope exit through `emitDecref`'s tag routing), and the box SLOT is NULLED so the box's own
	// `__destruct_<U>` cascade — which null-guards every field — does not decref it a second time.
	//
	// ⚠ Moving a managed field out of a BORROWED union (a parameter, a receiver) would STEAL it from its
	// owner — the caller's cascade would then skip a payload the callee already dropped, or double-free
	// one it did not. That is the cross-call borrow-consume ruling deferred to P1.4, so the scrutinee must
	// be an OWNED LOCAL; a borrowed one is E2015 here rather than a silent double-free.
	function moveOutManagedPayload(bindingInfo VarInfo, loaded ValueId, class PayloadClass, scrutBox ValueId, scrutOwned bool, slot CaseIndex, layout EnumLayout, nameTok Token, range SourceRange) throws ParseError
		if not scrutOwned 'borrowedScrut'
			throw ParseError.unsupported("binding the managed payload '{String.from(nameTok.value)}' out of a `{layout.kindWord()} {String.from(layout.name)}` that is not an OWNED local — a borrowed union (a parameter, a receiver) cannot have its payload MOVED out; that cross-call ownership arrives at P1.4 (match a payload-free / `_`-discarded arm to borrow it instead)", line: nameTok.line, column: nameTok.column)
		end 'borrowedScrut'

		// The moved-out payload (a String or a struct box — this path is reached only for a managed field)
		// is now OWNED by this binding, so it carries the provenance bit `valueIsOwnedHeap` reads: a later
		// `let q = <it>` re-moves it correctly, and a struct payload is no longer mistaken for a borrow. The
		// binding owns the drop (it is in `ownedBindings`), not the statement, so it leaves the pending-temp
		// list — the `trackOwnedTemp`/`removeFromPendingTemps` pair nets to "bit set, not pending", which is
		// what a value dropped by a binding rather than by the statement needs.
		self.trackOwnedTemp(loaded)
		self.removeFromPendingTemps(loaded)
		self.ownedBindings.push(bindingInfo)

		let zero = self.emitLiteral(0 as ParsedInt, valueType: MaxonType.integer, range: range)
		self.emitIndirectStore(scrutBox, offset: layout.payloadSlotOffset(slot), value: zero, storageType: payloadStorageOf(class), range: range)
	end 'moveOutManagedPayload'

	// The declaration index of the case named by `nameTok`, or E3034 (unknown case) positioned at
	// `posTok`. THE one emitter of "this name is not a case of this enum" — a `Color.red` literal
	// anchors it at the TYPE name and a match arm at the CASE name, so the POSITION is the caller's to
	// pass, but the lookup and the diagnostic are shared so the two sites cannot drift on either.
	function enumCaseIndexOrThrow(layout EnumLayout, nameTok Token, posTok Token) returns CaseIndex throws ParseError
		let index = layout.indexOfCase(nameTok.value)
		if index >= layout.caseCount() 'unknownCase'
			throw ParseError.enumUnknownCase(layout.kindWord(), caseName: String.from(nameTok.value), line: posTok.line, column: posTok.column)
		end 'unknownCase'
		return index
	end 'enumCaseIndexOrThrow'

	// Resolve a case NAME in a match arm to its declaration index. A QUALIFIED name (`Color.red`) is
	// E3075 — the scrutinee's enum is already known, so the bare name suffices — positioned at the
	// type name (the bootstrap's anchor). An unknown case is E3034, at the case name.
	function resolveEnumArmCase(layout EnumLayout) returns CaseIndex throws ParseError
		let caseTok = self.current()
		if not tokenNamesEnumCase(caseTok) 'notACaseName'
			throw ParseError.expectedExpression(caseTok.kind.rawValue, line: caseTok.line, column: caseTok.column)
		end 'notACaseName'

		if self.kindAt(self.pos + 1) == TokenKind.dot 'qualified'
			self.advance()
			try self.consume(TokenKind.dot)
			let realCaseTok = self.current()
			throw ParseError.matchQualifiedCaseName(String.from(realCaseTok.value), qualified: "{String.from(caseTok.value)}.{String.from(realCaseTok.value)}", line: caseTok.line, column: caseTok.column)
		end 'qualified'

		self.advance()
		return try self.enumCaseIndexOrThrow(layout, nameTok: caseTok, posTok: caseTok)
	end 'resolveEnumArmCase'

	// Mark case `index` covered, or raise E2027 if a prior arm already covered it. The overlap is
	// positioned at the CURRENT arm's pattern token (`patternTok`), naming the case that collides —
	// the bootstrap's exact anchor and message.
	function markEnumCovered(covered BoolArray, index CaseIndex, layout EnumLayout, patternTok Token) throws ParseError
		let already = try covered.get(index) otherwise panic("markEnumCovered: covered.get OOB at {index} — the bitmap is sized to the enum's case count")
		if already 'overlap'
			throw ParseError.matchOverlappingCase(String.from(layout.caseNameAt(index)), line: patternTok.line, column: patternTok.column)
		end 'overlap'
		try covered.set(index, value: true) otherwise panic("markEnumCovered: covered.set OOB at {index}")
	end 'markEnumCovered'

	// ⭐ **THE MATCH DISPATCH COMPARE** — `subject <op> tag`, emitting `MaxonOp.compare` DIRECTLY rather
	// than through `emitCompare`, and that bypass is load-bearing. `emitCompare` refuses a `union` operand
	// (E3066), and a PAYLOAD-FREE union match dispatches on the scrutinee itself (a `named(union)` value)
	// — so routing through it would reject `match u`. Both the subject (a scalar enum's `named` value, a
	// boxed union's loaded i64 tag, or a scalar int/char/bool) and the tag literal collapse to i64, so this
	// is a plain i64 comparison with no operand type to check. It is the ONE compare every dispatch node
	// emits: a point leaf's `==`, a range leaf's `>=`/`<=`, and an internal node's `<` pivot test.
	function emitDispatchCompare(subject ValueId, tag ParsedInt, op MaxonCmpOp, opTok Token) returns ValueId
		let tagLit = self.emitLiteral(tag, valueType: MaxonType.integer, range: SourceRange.ofToken(opTok))
		let result = self.mintValue(ValueTypeTag.boolean, nameId: UnnamedTypeId)
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.compare(result, lhs: subject, rhs: tagLit, op: op), range: SourceRange.ofToken(opTok))
		return result
	end 'emitDispatchCompare'

	// The OPEN #21 range rule, reduced to DISPATCH INTERVALS. A range arm `low to high` MEANS the cases in
	// the declaration-index slice `[low, lastCovered]` (`upto` drops the upper). Where the covered cases'
	// tags form a closed interval `[minTag, maxTag]` containing NO uncovered case's tag (`tagRangeCovers`),
	// the whole slice is ONE interval; otherwise each covered case is its own point interval, so an
	// uncovered case whose tag falls between them cannot slip in. Same coverage bookkeeping and same
	// `tagRangeCovers` predicate the old compare-emitting `emitEnumRange` used — only the OUTPUT is an
	// interval list, from which the dispatch emits the range/point compares once.
	function collectEnumRangeIntervals(layout EnumLayout, lowIndex CaseIndex, highIndex CaseIndex, isUpto bool, covered BoolArray, patternTok Token, bodyBlockId BlockId, into DispatchIntervalArray) throws ParseError
		// An empty range: `upto` whose upper is at or before the lower, or a reversed `to` (upper
		// declared before lower). Computed before `lastCovered` so its subtraction cannot underflow.
		let coversNothing = (isUpto and highIndex <= lowIndex) or ((not isUpto) and highIndex < lowIndex)
		if coversNothing 'empty'
			throw ParseError.matchEmptyRange(String.from(layout.caseNameAt(lowIndex)), high: String.from(layout.caseNameAt(highIndex)), line: patternTok.line, column: patternTok.column)
		end 'empty'

		let lastCovered = (highIndex - 1) if isUpto else highIndex

		// Mark the covered slice (overlap-checked) and gather the min/max TAG over it.
		var loTag = layout.tagOfIndex(lowIndex)
		var hiTag = loTag
		var i = lowIndex
		while i <= lastCovered 'coverEach'
			try self.markEnumCovered(covered, index: i, layout: layout, patternTok: patternTok)
			let t = layout.tagOfIndex(i)
			if t < loTag 'newLo'
				loTag = t
			end 'newLo'
			if t > hiTag 'newHi'
				hiTag = t
			end 'newHi'
			i = i + 1
		end 'coverEach'

		if self.tagRangeCovers(layout, lowIndex: lowIndex, lastCovered: lastCovered, loTag: loTag, hiTag: hiTag) 'expressibleAsRange'
			into.push(DispatchInterval.create(loTag, hi: hiTag, targetBlockId: bodyBlockId, edgeArgs: ValueIdArray.create()))
			return
		end 'expressibleAsRange'

		// The covered cases as individual point intervals — the interval twin of the old per-case OR.
		var j = lowIndex
		while j <= lastCovered 'pointEach'
			let tag = layout.tagOfIndex(j)
			into.push(DispatchInterval.create(tag, hi: tag, targetBlockId: bodyBlockId, edgeArgs: ValueIdArray.create()))
			j = j + 1
		end 'pointEach'
	end 'collectEnumRangeIntervals'

	// Is a two-compare tag range `[loTag, hiTag]` faithful to the covered slice — i.e. does NO
	// uncovered case's tag fall inside that closed interval? The predicate at the heart of OPEN #21:
	// where it holds, `serverError`'s 404 does not sit between `ok`'s 500 and `notFound`'s 200, so the
	// range means exactly the covered set and is safe to emit; where it fails, the OR is forced.
	function tagRangeCovers(layout EnumLayout, lowIndex CaseIndex, lastCovered CaseIndex, loTag ParsedInt, hiTag ParsedInt) returns bool
		for j in 0 upto layout.caseCount() 'eachCase'
			if j >= lowIndex and j <= lastCovered 'isCovered'
				continue
			end 'isCovered'
			let t = layout.tagOfIndex(j)
			if t >= loTag and t <= hiTag 'insideInterval'
				return false
			end 'insideInterval'
		end 'eachCase'
		return true
	end 'tagRangeCovers'

	// An enum match must cover EVERY case. The uncovered ones (in declaration order) become E2026's
	// `missing:` list, positioned at the closing `end` — the enum twin of the scalar exhaustiveness
	// gate, and the mechanism that makes adding a case force every match site to handle it.
	function checkEnumExhaustive(layout EnumLayout, covered BoolArray) throws ParseError
		var missing = ""
		var hasMissing = false
		for i in 0 upto layout.caseCount() 'eachCase'
			let isCovered = try covered.get(i) otherwise panic("checkEnumExhaustive: covered.get OOB at {i} — the bitmap is sized to the enum's case count")
			if not isCovered 'uncovered'
				if hasMissing 'notFirst'
					missing = "{missing}, {String.from(layout.caseNameAt(i))}"
				end 'notFirst' else 'first'
					missing = String.from(layout.caseNameAt(i))
				end 'first'
				hasMissing = true
			end 'uncovered'
		end 'eachCase'

		if hasMissing 'incomplete'
			let endTok = self.current()
			throw ParseError.enumMatchNotExhaustive(layout.kindWord(), typeName: String.from(layout.name), missing: missing, line: endTok.line, column: endTok.column)
		end 'incomplete'
	end 'checkEnumExhaustive'

	// ⭐ **CLIP the raw arm intervals into a SORTED, DISJOINT set where EARLIER ARMS WIN.** Overlaps are
	// legal on a scalar match (two ranges may overlap, or a later single value fall inside an earlier
	// range) and the FIRST arm claims the overlap — exactly the order the linear chain gave by testing
	// arms top to bottom. A binary search cannot rely on arm order, so the overlap is resolved HERE. The
	// result is the partition of the value line into maximal runs each OWNED by one arm, where a point's
	// owner is the EARLIEST (lowest-index) raw interval covering it — the "earlier wins" a top-to-bottom
	// chain gave for free. It is sorted by `lo`, which is what makes the median-split search correct.
	// (Enum/union intervals are already disjoint — `markEnumCovered` rejects overlap — so for them this is
	// only the sort.)
	//
	// ⚠ THIS IS O(n log n) IN THE ARM COUNT, AND IT USED TO BE Θ(n²) — a subtract-and-insert that, per raw
	// interval, scanned the whole claimed set and inserted into the middle of a sorted array. MEASURED at
	// 256→2048 distinct scalar arms, the parse phase read x2.3→x2.7→x3.0 per doubling (linear reads x2.0):
	// a 2048-arm dispatch table — a bytecode/keyword switch, the very shape a `match` is FOR — spent ~47 ms
	// of a 70 ms parse in this one function. The scale-test corpus has no `match`, so it never saw it.
	//
	// The replacement is an offline left-to-right sweep: sort the interval indices by `lo` once, then walk
	// the value line, keeping the started-but-not-ended intervals in a min-heap KEYED BY ARM PRIORITY so
	// the current owner is the heap minimum. A segment closes and a new one opens exactly when that owner
	// changes — an earlier-arm interval activating (at its `lo`) or the current owner ending (at its `hi`),
	// the only two coordinates where ownership can change — which coalesces same-owner runs and reproduces
	// the old partition segment-for-segment.
	function normalizeDispatchIntervals(raw DispatchIntervalArray) returns DispatchIntervalArray
		var result = DispatchIntervalArray.create()
		let n = raw.count()
		if n == 0 'empty'
			return result
		end 'empty'

		let order = self.dispatchIntervalsSortedByLo(raw)
		var heap = DispatchIndexArray.create()

		// `si` is the next not-yet-activated interval in `lo` order; `sweepPos` the coordinate whose owner we
		// are currently deciding. A segment for `segOwner` is open over `[segStart, sweepPos-1]` while
		// `segOpen`. (`sweepPos`, not `pos` — that name is the Parser's token cursor.)
		var si = 0 as ElementCount
		var sweepPos = (try raw.get(try order.get(0) otherwise panic("normalizeDispatchIntervals: order.get(0) on n>0")) otherwise panic("normalizeDispatchIntervals: raw.get(order[0]) OOB")).lo
		var segOpen = false
		var segStart = sweepPos
		var segOwner = 0 as ElementCount

		while true 'sweep'
			// Activate every interval that has started by `sweepPos` (its `lo <= sweepPos`); they are
			// contiguous in `order`, so this consumes a prefix. All same-`lo` intervals activate together, so
			// the heap minimum is the earliest arm among them regardless of their order within the run.
			while si < n and self.dispatchLoOf(raw, index: try order.get(si) otherwise panic("normalizeDispatchIntervals: order.get OOB at {si}")) <= sweepPos 'activate'
				self.dispatchHeapPush(heap, value: try order.get(si) otherwise panic("normalizeDispatchIntervals: order.get OOB at {si}"))
				si = si + 1
			end 'activate'

			// Drop intervals that ended before `sweepPos` (their `hi < sweepPos`); they no longer cover it.
			// Lazy: only the heap minima are checked, so each interval is discarded once, when it surfaces.
			while heap.count() > 0 and self.dispatchHiOf(raw, index: try heap.get(0) otherwise panic("normalizeDispatchIntervals: heap.get(0) on non-empty")) < sweepPos 'expire'
				_ = self.dispatchHeapPopMin(heap)
			end 'expire'

			if heap.count() == 0 'gap'
				// No interval covers `sweepPos`. A segment can only have closed at an owner change (below), so
				// none is open here; the next covered region begins at the next interval's `lo`.
				if segOpen 'lostSegment'
					panic("normalizeDispatchIntervals: a segment was left open crossing an uncovered gap")
				end 'lostSegment'
				if si >= n 'done'
					break
				end 'done'
				sweepPos = self.dispatchLoOf(raw, index: try order.get(si) otherwise panic("normalizeDispatchIntervals: order.get OOB at {si}"))
				continue
			end 'gap'

			let owner = try heap.get(0) otherwise panic("normalizeDispatchIntervals: heap.get(0) on non-empty")
			if not segOpen 'openSegment'
				segOpen = true
				segStart = sweepPos
				segOwner = owner
			end 'openSegment' else if owner != segOwner 'ownerChanged'
				// A new interval activated at `sweepPos` outranks the running owner, which therefore owned only
				// up to `sweepPos - 1` (no underflow: `sweepPos > segStart >= i64.min` since it opened earlier).
				self.pushNormalizedSegment(result, raw: raw, owner: segOwner, lo: segStart, hi: sweepPos - 1)
				segStart = sweepPos
				segOwner = owner
			end 'ownerChanged'

			// The owner holds `sweepPos` until either a new interval starts inside its span (re-decide there)
			// or it ends at its own `hi`.
			let ownerHi = self.dispatchHiOf(raw, index: owner)
			var ownerEnds = true
			if si < n 'hasNextStart'
				let nextLo = self.dispatchLoOf(raw, index: try order.get(si) otherwise panic("normalizeDispatchIntervals: order.get OOB at {si}"))
				if nextLo <= ownerHi 'startsInsideOwner'
					sweepPos = nextLo
					ownerEnds = false
				end 'startsInsideOwner'
			end 'hasNextStart'

			if ownerEnds 'closeSegment'
				self.pushNormalizedSegment(result, raw: raw, owner: segOwner, lo: segStart, hi: ownerHi)
				segOpen = false
				if ownerHi == I64MaxBound 'atCeiling'
					// Nothing lies past i64.max, and no interval's `lo` can either, so the sweep is done —
					// and `ownerHi + 1` would overflow, so it is never computed.
					break
				end 'atCeiling'
				sweepPos = ownerHi + 1
			end 'closeSegment'
		end 'sweep'

		return result
	end 'normalizeDispatchIntervals'

	// `raw[index].lo` / `raw[index].hi` — the sweep reads these coordinates far more often than it needs
	// the whole interval, and going through one accessor keeps the `try … otherwise panic` off the sweep.
	function dispatchLoOf(raw DispatchIntervalArray, index ElementCount) returns ParsedInt
		return (try raw.get(index) otherwise panic("dispatchLoOf: raw.get OOB at {index}")).lo
	end 'dispatchLoOf'

	function dispatchHiOf(raw DispatchIntervalArray, index ElementCount) returns ParsedInt
		return (try raw.get(index) otherwise panic("dispatchHiOf: raw.get OOB at {index}")).hi
	end 'dispatchHiOf'

	// Append the segment `[lo, hi]` owned by raw interval `owner`, carrying that arm's body and edge args.
	// A single owner can yield several segments (an interior higher-priority arm splits it), each sharing
	// the same `edgeArgs` — the same reuse the old piece-splitter made, so the retained count is unchanged.
	function pushNormalizedSegment(result DispatchIntervalArray, raw DispatchIntervalArray, owner ElementCount, lo ParsedInt, hi ParsedInt)
		let src = try raw.get(owner) otherwise panic("pushNormalizedSegment: raw.get OOB at owner {owner}")
		result.push(DispatchInterval.create(lo, hi: hi, targetBlockId: src.targetBlockId, edgeArgs: src.edgeArgs))
	end 'pushNormalizedSegment'

	// The interval positions `[0, n)` sorted ascending by `raw[i].lo`. A stable merge sort — O(n log n) in
	// the arm count, the property this whole path exists to hold — over an index permutation, so the raw
	// intervals never move. Ties (equal `lo`) keep ascending index order; the sweep does not depend on that
	// (it activates a whole equal-`lo` run before picking an owner), but it costs nothing and is tidy.
	function dispatchIntervalsSortedByLo(raw DispatchIntervalArray) returns DispatchIndexArray
		let n = raw.count()
		var order = DispatchIndexArray.create()
		for i in 0 upto n 'seed'
			order.push(i)
		end 'seed'

		var scratch = DispatchIndexArray.create()
		scratch.growFilled(n, value: 0 as ElementCount)
		self.mergeSortDispatchIndices(raw, order: order, scratch: scratch, lo: 0, hi: n)
		return order
	end 'dispatchIntervalsSortedByLo'

	// Merge-sort `order[lo, hi)` by `raw[·].lo`, using `scratch` as the merge buffer. Recursion depth is
	// log n and each level touches each slot once, so O(n log n).
	function mergeSortDispatchIndices(raw DispatchIntervalArray, order DispatchIndexArray, scratch DispatchIndexArray, lo ElementCount, hi ElementCount)
		if hi - lo <= 1 'base'
			return
		end 'base'

		let mid = lo + (hi - lo) / 2
		self.mergeSortDispatchIndices(raw, order: order, scratch: scratch, lo: lo, hi: mid)
		self.mergeSortDispatchIndices(raw, order: order, scratch: scratch, lo: mid, hi: hi)

		var i = lo
		var j = mid
		var k = lo
		while i < mid and j < hi 'merge'
			let leftIdx = try order.get(i) otherwise panic("mergeSortDispatchIndices: order.get OOB at {i}")
			let rightIdx = try order.get(j) otherwise panic("mergeSortDispatchIndices: order.get OOB at {j}")
			// `<=` takes the left (lower-index) element on a tie, which is what makes the sort stable.
			if self.dispatchLoOf(raw, index: leftIdx) <= self.dispatchLoOf(raw, index: rightIdx) 'takeLeft'
				try scratch.set(k, value: leftIdx) otherwise panic("mergeSortDispatchIndices: scratch.set OOB at {k}")
				i = i + 1
			end 'takeLeft' else 'takeRight'
				try scratch.set(k, value: rightIdx) otherwise panic("mergeSortDispatchIndices: scratch.set OOB at {k}")
				j = j + 1
			end 'takeRight'
			k = k + 1
		end 'merge'

		while i < mid 'drainLeft'
			try scratch.set(k, value: try order.get(i) otherwise panic("mergeSortDispatchIndices: order.get OOB at {i}")) otherwise panic("mergeSortDispatchIndices: scratch.set OOB at {k}")
			i = i + 1
			k = k + 1
		end 'drainLeft'
		while j < hi 'drainRight'
			try scratch.set(k, value: try order.get(j) otherwise panic("mergeSortDispatchIndices: order.get OOB at {j}")) otherwise panic("mergeSortDispatchIndices: scratch.set OOB at {k}")
			j = j + 1
			k = k + 1
		end 'drainRight'

		for t in lo upto hi 'copyBack'
			try order.set(t, value: try scratch.get(t) otherwise panic("mergeSortDispatchIndices: scratch.get OOB at {t}")) otherwise panic("mergeSortDispatchIndices: order.set OOB at {t}")
		end 'copyBack'
	end 'mergeSortDispatchIndices'

	// Push `value` (an interval index, and thereby its arm priority) onto the min-heap, sifting it up until
	// its parent is no larger. O(log heap).
	function dispatchHeapPush(heap DispatchIndexArray, value ElementCount)
		heap.push(value)
		var child = heap.count() - 1
		while child > 0 'siftUp'
			let parent = (child - 1) / 2
			let parentVal = try heap.get(parent) otherwise panic("dispatchHeapPush: heap.get OOB at parent {parent}")
			let childVal = try heap.get(child) otherwise panic("dispatchHeapPush: heap.get OOB at child {child}")
			if parentVal <= childVal 'ordered'
				break
			end 'ordered'
			try heap.set(parent, value: childVal) otherwise panic("dispatchHeapPush: heap.set OOB at parent {parent}")
			try heap.set(child, value: parentVal) otherwise panic("dispatchHeapPush: heap.set OOB at child {child}")
			child = parent
		end 'siftUp'
	end 'dispatchHeapPush'

	// Remove and return the smallest interval index (earliest arm) on the heap, re-heaping the tail. O(log
	// heap). The caller guarantees the heap is non-empty.
	function dispatchHeapPopMin(heap DispatchIndexArray) returns ElementCount
		let top = try heap.get(0) otherwise panic("dispatchHeapPopMin: heap.get(0) on empty heap")
		let tail = try heap.pop() otherwise panic("dispatchHeapPopMin: pop on empty heap")
		let count = heap.count()
		if count == 0 'wasLast'
			return top
		end 'wasLast'

		try heap.set(0, value: tail) otherwise panic("dispatchHeapPopMin: heap.set(0) after refill")
		var parent = 0 as ElementCount
		while true 'siftDown'
			let left = parent * 2 + 1
			if left >= count 'leaf'
				break
			end 'leaf'
			var smaller = left
			let right = left + 1
			if right < count 'hasRight'
				let leftVal = try heap.get(left) otherwise panic("dispatchHeapPopMin: heap.get OOB at left {left}")
				let rightVal = try heap.get(right) otherwise panic("dispatchHeapPopMin: heap.get OOB at right {right}")
				if rightVal < leftVal 'rightSmaller'
					smaller = right
				end 'rightSmaller'
			end 'hasRight'
			let parentVal = try heap.get(parent) otherwise panic("dispatchHeapPopMin: heap.get OOB at parent {parent}")
			let smallerVal = try heap.get(smaller) otherwise panic("dispatchHeapPopMin: heap.get OOB at smaller {smaller}")
			if parentVal <= smallerVal 'ordered'
				break
			end 'ordered'
			try heap.set(parent, value: smallerVal) otherwise panic("dispatchHeapPopMin: heap.set OOB at parent {parent}")
			try heap.set(smaller, value: parentVal) otherwise panic("dispatchHeapPopMin: heap.set OOB at smaller {smaller}")
			parent = smaller
		end 'siftDown'
		return top
	end 'dispatchHeapPopMin'

	// ⭐ **EMIT A `match`'s DISPATCH from its normalized interval plan** — the ONE place the strategy is
	// chosen. Below `MinIntervalsForDispatch` intervals it is a linear compare chain; at or above it a
	// balanced binary search over the sorted disjoint intervals. Every compare reads `subject` (loaded
	// once, in `entry`, and left in a register across the whole tree); a value in NO interval reaches
	// `missTarget` (the `default` body, or a `dead` block for an exhaustive enum). NO new IR op — internal
	// nodes compare `subject < pivot` and leaves test their interval, all with the same `compare`/
	// `condBranch` the chain used, so the backend and every later pass are untouched (a jump table is Slice 2).
	function emitMatchDispatch(func IrFunction, entry IrBlock, subject ValueId, intervals DispatchIntervalArray, missTarget BlockId, missArgs ValueIdArray, opTok Token) throws ParseError
		try self.emitDispatchRange(func, from: 0, to: intervals.count(), block: entry, subject: subject, intervals: intervals, missTarget: missTarget, missArgs: missArgs, opTok: opTok)
	end 'emitMatchDispatch'

	// The recursion. `[from, to)` is a contiguous slice of the sorted disjoint intervals. A short slice is
	// a chain; a long one splits on the median interval's lower bound — every interval below the pivot lies
	// in the left half and every one at or above it in the right (sorted + disjoint), so both halves are
	// non-empty (the count is at least `MinIntervalsForDispatch`) and the recursion terminates.
	function emitDispatchRange(func IrFunction, from ElementCount, to ElementCount, block IrBlock, subject ValueId, intervals DispatchIntervalArray, missTarget BlockId, missArgs ValueIdArray, opTok Token) throws ParseError
		let count = to - from
		if count < MinIntervalsForDispatch 'chain'
			try self.emitDispatchChain(func, from: from, to: to, block: block, subject: subject, intervals: intervals, missTarget: missTarget, missArgs: missArgs, opTok: opTok)
			return
		end 'chain'

		// A DENSE run — the covered value span is tight enough (see the three density caps) — becomes an
		// O(1) indexed jump TABLE rather than a compare tree. Tried at EVERY level, so a dense sub-range at a
		// binary-search leaf tabulates itself too (the recursion below only reaches sparse regions).
		let table = self.planDispatchTable(from, to: to, intervals: intervals)
		if table.isTable 'dense'
			try self.emitDispatchTable(from, to: to, block: block, subject: subject, intervals: intervals, plan: table, missTarget: missTarget, missArgs: missArgs, opTok: opTok)
			return
		end 'dense'

		let mid = from + count / 2
		let pivot = (try intervals.get(mid) otherwise panic("emitDispatchRange: intervals.get OOB at pivot {mid}")).lo
		self.currentBlock = block
		let cond = self.emitDispatchCompare(subject, tag: pivot, op: MaxonCmpOp.lt, opTok: opTok)
		// `var` because each half is emitted INTO its block by the recursive call, which mutates it — the
		// same mutating-parameter sensitivity `dispatchEntry` carries.
		var lowerBlock = self.newBlock(func, label: b"matchlo", line: opTok.line)
		var upperBlock = self.newBlock(func, label: b"matchhi", line: opTok.line)
		// The internal branch routes between two sub-TESTS, not to an arm body — neither target carries a
		// carried-var phi (both are dominated by `entry`, where the pre-match values still hold), so the
		// branch records no edge args.
		self.emitCondBranch(block, cond: cond, thenId: lowerBlock.id, elseId: upperBlock.id, ifTok: opTok)
		try self.emitDispatchRange(func, from: from, to: mid, block: lowerBlock, subject: subject, intervals: intervals, missTarget: missTarget, missArgs: missArgs, opTok: opTok)
		try self.emitDispatchRange(func, from: mid, to: to, block: upperBlock, subject: subject, intervals: intervals, missTarget: missTarget, missArgs: missArgs, opTok: opTok)
	end 'emitDispatchRange'

	// ⭐ **DECIDE WHETHER A DENSE RUN IS WORTH A JUMP TABLE**, reporting the bias (its minimum) and the slot
	// count (the span). The bootstrap's `TryTableBias` verbatim (`SwitchDispatch.cs`): reject on the covered
	// WIDTH exceeding the span cap, on the span outrunning the per-interval slot budget, then on the density
	// falling below 2/5. `intervals` is sorted disjoint, so `intervals[from].lo` is the minimum and
	// `intervals[to-1].hi` the maximum. Everything is measured MODULO 2^64 (a span crossing zero, or one
	// reaching an open bound, is a real span, not an overflow), so the width is compared without ever
	// forming a difference that would overflow `i64` — see `spanExceedsCap`.
	function planDispatchTable(from ElementCount, to ElementCount, intervals DispatchIntervalArray) returns DispatchTablePlan
		let bias = (try intervals.get(from) otherwise panic("planDispatchTable: intervals.get OOB at from {from}")).lo
		let maxHi = (try intervals.get(to - 1) otherwise panic("planDispatchTable: intervals.get OOB at to-1 {to - 1}")).hi

		// Reject on the covered WIDTH exceeding the cap WITHOUT forming `maxHi - bias`, which overflows i64
		// when the span crosses far into both halves (e.g. `i64.min`..`i64.max`). `maxHi >= bias` always
		// (sorted, disjoint), so the modular width is a mathematical value in `[0, 2^64)`; it is `< cap` iff
		// `maxHi` sits within the `cap`-wide window above `bias`, which `spanWithinCap` tests overflow-safely.
		if not spanWithinCap(bias, maxHi: maxHi) 'tooWide'
			return DispatchTablePlan.notTable()
		end 'tooWide'

		// Both operands are now within `MaxTableSpanSlots` of each other, so `maxHi - bias` fits i64.
		let span = maxHi - bias + 1

		// The table must earn its slots against the compares it removes, not merely against the values it
		// covers (`MaxTableSlotsPerInterval`). `to - from` is the interval count; the product fits i64
		// (span <= 4096, the count is bounded by the arm count).
		if span > ((to - from) as ParsedInt) * MaxTableSlotsPerInterval 'sparse'
			return DispatchTablePlan.notTable()
		end 'sparse'

		var coveredSlots = 0 as ParsedInt
		for i in from upto to 'each'
			let interval = try intervals.get(i) otherwise panic("planDispatchTable: intervals.get OOB at {i}")
			coveredSlots = coveredSlots + (interval.hi - interval.lo + 1)
		end 'each'

		// Dense iff covered/span >= 2/5, kept as a cross-multiply so no division rounds. Both products fit
		// i64 (each factor <= 4096 * 5).
		if coveredSlots * MinTableDensityDenominator < span * MinTableDensityNumerator 'sparse'
			return DispatchTablePlan.notTable()
		end 'sparse'

		return DispatchTablePlan.tableWith(bias, span: span)
	end 'planDispatchTable'

	// Is the modular width `maxHi - bias` (unsigned) strictly below `MaxTableSpanSlots`? Answered WITHOUT
	// forming the difference, which overflows i64 for a span straddling both halves. `maxHi >= bias`
	// (signed) is the caller's invariant, so the width is `maxHi - bias` as a true mathematical integer in
	// `[0, 2^64)`. It is below the cap iff `maxHi` is at most `bias + (cap - 1)`:
	//   • when `bias + (cap - 1)` does NOT overflow i64 (`bias <= i64.max - (cap - 1)`), that is a plain
	//     signed compare;
	//   • when it WOULD overflow, `bias` is within `cap` of `i64.max`, so `maxHi` (<= i64.max) is
	//     necessarily within the window — accept.
	function spanWithinCap(bias ParsedInt, maxHi ParsedInt) returns bool
		let lastSlot = MaxTableSpanSlots - 1
		if bias > I64MaxBound - lastSlot 'windowReachesTop'
			return true
		end 'windowReachesTop'
		return maxHi <= bias + lastSlot
	end 'spanWithinCap'

	// ⭐ **EMIT A DENSE RUN AS A JUMP TABLE.** Bias the subject to a zero-based index (`subject − min`, a
	// modular subtract, so an out-of-range subject wraps to a large unsigned value the target op's UNSIGNED
	// bounds check sends to the default), build the dense block-id table (each interval fills its several
	// slots; holes are the default), record the phi edges for the distinct arm bodies and the default, then
	// emit the `switch` terminator. The bias subtract is elided when the minimum is 0 (a zero-based enum or
	// scalar match), so `match Color` over `red=0…` biases nothing.
	function emitDispatchTable(from ElementCount, to ElementCount, block IrBlock, subject ValueId, intervals DispatchIntervalArray, plan DispatchTablePlan, missTarget BlockId, missArgs ValueIdArray, opTok Token) throws ParseError
		self.currentBlock = block

		var index = subject
		if plan.bias != 0 'bias'
			index = self.emitBiasIndex(subject, bias: plan.bias, opTok: opTok)
		end 'bias'

		// Every slot in `[min, max]` needs a target; the ones no interval covers are the default. A range
		// arm and an `or`-list simply fill several slots each — the whole reason a single range arm no longer
		// forces the match onto a compare tree. `growFilled` from an empty array fills every one of `span`
		// slots with the default.
		var targets = BlockIdArray.create()
		targets.growFilled(plan.span as ElementCount, value: missTarget)
		for i in from upto to 'eachInterval'
			let interval = try intervals.get(i) otherwise panic("emitDispatchTable: intervals.get OOB at {i}")
			// Walk SLOT indices (`lo - bias` … `hi - bias`), never VALUES: a value-driven loop over an
			// interval ending at `i64.max` would never terminate. Both offsets are in `[0, span)` (the
			// interval lies within the covered span), so the subtraction cannot overflow.
			let firstSlot = (interval.lo - plan.bias) as ElementCount
			let lastSlot = (interval.hi - plan.bias) as ElementCount
			for slot in firstSlot upto (lastSlot + 1) 'fill'
				try targets.set(slot, value: interval.targetBlockId) otherwise panic("emitDispatchTable: targets.set OOB at slot {slot} (span {plan.span})")
			end 'fill'
		end 'eachInterval'

		// The phi args each dispatch edge carries. An arm body is a phi target only when it is a fall-through
		// target (`setupFallthroughTargetPhis` stamped its intervals' `edgeArgs`); the default carries
		// `missArgs`. `recordBranchEdge` is a no-op for an empty arg list, so a phi-less table costs nothing
		// here. Recorded ONCE per distinct target — an or-arm or a split range reaches one body through
		// several intervals, all carrying the SAME snapshot, so a second edge to it would double-apply the
		// copy at SSA destruction.
		self.recordBranchEdge(block, targetId: missTarget, argIds: missArgs)
		var seen = BlockIdSet.create()
		for i in from upto to 'eachEdge'
			let interval = try intervals.get(i) otherwise panic("emitDispatchTable: intervals.get OOB at {i}")
			if not seen.contains(interval.targetBlockId) 'firstEdge'
				seen.insert(interval.targetBlockId)
				self.recordBranchEdge(block, targetId: interval.targetBlockId, argIds: interval.edgeArgs)
			end 'firstEdge'
		end 'eachEdge'

		self.artifact.emitTerminator(block, op: MaxonOp.switch(index, denseTargetBlockIds: targets, defaultBlockId: missTarget), range: SourceRange.ofToken(opTok))
	end 'emitDispatchTable'

	// The zero-based table index `subject − bias`, emitted as a RAW `binOp(sub)` that MINTS an `integer`
	// result and bypasses `emitBinOp`'s operand type check — exactly as `emitDispatchCompare` emits a raw
	// `compare`. The bypass is the point: a SCALAR enum's dispatch subject is a `named(<Enum>)` value, and
	// arithmetic on an enum is a user-level type error — but this is not user arithmetic, it is the compiler
	// REINTERPRETING the tag bits as the integer index the jump table needs. The subtraction is MODULAR
	// (i64 wraparound), so a subject outside the covered span wraps to a large unsigned value the target op's
	// UNSIGNED bounds check routes to the default. The Std tier collapses the `named` operand to i64
	// (`stdTypeOf`), so the lowered `sub` is an ordinary i64 subtract.
	function emitBiasIndex(subject ValueId, bias ParsedInt, opTok Token) returns ValueId
		let biasLit = self.emitLiteral(bias, valueType: MaxonType.integer, range: SourceRange.ofToken(opTok))
		let result = self.mintValue(ValueTypeTag.integer, nameId: UnnamedTypeId)
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.binOp(result, lhs: subject, rhs: biasLit, op: MaxonBinOp.sub), range: SourceRange.ofToken(opTok))
		return result
	end 'emitBiasIndex'

	// A leaf region: test each interval in turn, branching to its arm body on a hit and to the next test
	// (or `missTarget` after the last) on a miss. `recordBranchEdge` is a no-op for an empty arg list, so
	// the internal chain edges (no phis) and a phi-less body/miss cost nothing.
	function emitDispatchChain(func IrFunction, from ElementCount, to ElementCount, block IrBlock, subject ValueId, intervals DispatchIntervalArray, missTarget BlockId, missArgs ValueIdArray, opTok Token) throws ParseError
		// A default-only planned match (`match x 'c' default gives … end`) collects NO intervals — every
		// value is a miss — so the entry unconditionally branches to the default, with no compare. The
		// tree recursion never reaches here empty (it splits only at count >= 4 into two non-empty halves),
		// so this is the top-level empty plan alone, but handling it here keeps the terminator obligation in
		// one place.
		if from == to 'noIntervals'
			self.recordBranchEdge(block, targetId: missTarget, argIds: missArgs)
			self.emitBranch(block, targetId: missTarget)
			return
		end 'noIntervals'

		var current = block
		for i in from upto to 'each'
			let interval = try intervals.get(i) otherwise panic("emitDispatchChain: intervals.get OOB at {i}")
			self.currentBlock = current
			let cond = try self.emitIntervalHitTest(subject, lo: interval.lo, hi: interval.hi, opTok: opTok)

			let isLast = i == to - 1
			var elseTarget = missTarget
			var elseArgs = missArgs
			var nextBlock = current
			if not isLast 'moreTests'
				nextBlock = self.newBlock(func, label: b"matchnext", line: opTok.line)
				elseTarget = nextBlock.id
				elseArgs = ValueIdArray.create()
			end 'moreTests'

			self.recordBranchEdge(current, targetId: interval.targetBlockId, argIds: interval.edgeArgs)
			self.recordBranchEdge(current, targetId: elseTarget, argIds: elseArgs)
			self.emitCondBranch(current, cond: cond, thenId: interval.targetBlockId, elseId: elseTarget, ifTok: opTok)
			current = nextBlock
		end 'each'
	end 'emitDispatchChain'

	// The boolean "does `subject` fall in `[lo, hi]`?": an `==` for a point, a two-sided `>=`/`<=` `and`
	// for a range, one open compare when a bound is `i64.min`/`i64.max` (the redundant side elided, exactly
	// as `emitOpenLowerRange`/`emitClosedRange` treat an open bound), and a constant `true` for a
	// min-to-max interval that covers everything (a sole all-covering arm — after clipping it can only be
	// the whole plan, since it would subsume any later arm).
	function emitIntervalHitTest(subject ValueId, lo ParsedInt, hi ParsedInt, opTok Token) returns ValueId throws ParseError
		if lo == hi 'point'
			return self.emitDispatchCompare(subject, tag: lo, op: MaxonCmpOp.eq, opTok: opTok)
		end 'point'

		let needLo = lo > I64MinBound
		let needHi = hi < I64MaxBound
		if needLo and needHi 'closed'
			let loCmp = self.emitDispatchCompare(subject, tag: lo, op: MaxonCmpOp.ge, opTok: opTok)
			let hiCmp = self.emitDispatchCompare(subject, tag: hi, op: MaxonCmpOp.le, opTok: opTok)
			return try self.emitBinOp(loCmp, rhs: hiCmp, op: MaxonBinOp.bitAnd, opTok: opTok)
		end 'closed'
		if needLo 'openUpper'
			return self.emitDispatchCompare(subject, tag: lo, op: MaxonCmpOp.ge, opTok: opTok)
		end 'openUpper'
		if needHi 'openLower'
			return self.emitDispatchCompare(subject, tag: hi, op: MaxonCmpOp.le, opTok: opTok)
		end 'openLower'

		return self.emitLiteral(BoolTrueValue, valueType: MaxonType.boolean, range: SourceRange.ofToken(opTok))
	end 'emitIntervalHitTest'

	// Mint a phi (block-arg) on `block` and return its fresh ValueId. The ONE mint site for
	// every merge phi the parser makes — if-continuation, loop header, loop exit, and (new
	// at P1.0d.2) the short-circuit merge — so a phi's Maxon-tier type is recorded in
	// lockstep with its id at all four.
	//
	// The `argType` passed here is a PLACEHOLDER, overwritten before anything reads it:
	// `LowerMaxonToStd.retypeBlockArgs` is the authority and sets every phi's Std type from the tag
	// column (it explains why the parser is the wrong tier to decide it). A phi's Maxon-tier type is
	// the `tag` recorded below, and that is the only type this function knows.
	//
	// ⚠ NOTHING OVERWROTE IT UNTIL P1.0d.4, AND THAT WAS A COMPILER CRASH: a hardcoded `i64` was
	// harmless only while every value lived in a GPR, and the day `argType` chose a phi's REGISTER
	// FILE, a float phi was coloured into a GPR and the SSA-destruction copy panicked the x64
	// emitter. See `float-phi-*` in specs-shv2/float-type.md.
	function mintPhi(block IrBlock, tag ValueTypeTag, nameId TypeNameId) returns ValueId
		let phiId = self.mintValue(tag, nameId: nameId)
		block.blockArgs.push(IrBlockArg.create(phiId, argType: StdType.i64))
		return phiId
	end 'mintPhi'

	// The phi a MERGED BINDING carries: its type is the binding's declared one, which the
	// binding already holds as a `MaxonType`, so decomposing it constructs nothing.
	//
	// ⭐ **PROPAGATE THE PROMISE MARK ACROSS THE MERGE (P1.5-B2 #88, Finding 1).** `valueIsPromise` is a
	// per-SSA-value mark that a merge phi does not otherwise carry, so a re-armed `var p` (whose value after a
	// loop / branch IS this phi) would lose its promise identity — its scope-exit drop would misroute to
	// `__mm_decref` on a GT pointer, and `await p` on the phi would be rejected as "not a promise". A promise
	// var's phi merges promises on EVERY reaching edge (each value it holds is a spawn handle), so the mark is
	// read off the value flowing IN here (`binding.boundValue`) and stamped on the phi. The ONE choke point
	// for loop-header, loop-exit, if-continuation and match phis, so all four inherit it at once.
	function mintPhiForBinding(block IrBlock, binding VarInfo) returns ValueId
		let phiId = self.mintPhi(block, tag: maxonTypeTag(binding.varType), nameId: typeNameIdOf(binding.varType))
		if self.valueIsPromise(binding.boundValue) 'promisePhi'
			self.markValuePromise(phiId)
		end 'promisePhi'
		return phiId
	end 'mintPhiForBinding'

	// Allocate a fresh ValueId AND record its source-level type, in lockstep. THE only way
	// the parser mints a value: the type columns are dense by ValueId, so an id allocated
	// without a type would shift every later value's type by one — a silent misclassification
	// of every operator that dispatches on type. Splitting the two would make that possible;
	// this makes it impossible.
	//
	// Takes a TAG (plus the name id a `named` type carries), never a `MaxonType`: constructing
	// a union ALLOCATES, and this is the per-VALUE path. `mintValueOfType` is the door for a
	// caller that already holds a `MaxonType` and so constructs nothing new.
	function mintValue(tag ValueTypeTag, nameId TypeNameId) returns ValueId
		let id = allocValueId(self.valueIds)
		self.valueTags.push(tag)
		self.valueNameIds.push(nameId)
		// The constant columns move in the same lockstep, seeded UNKNOWN. A value's constant is
		// discovered by the op that DEFINES it, which is emitted after its id is minted — so the
		// slot must exist first, and the emitter overwrites it (`recordConst`).
		self.valueConsts.push(0)
		self.valueConstKnown.push(false)
		// Owned-heap provenance rides the same lockstep: seeded NOT owned, set true by `trackOwnedTemp`
		// on the one value an interpolation allocates. The slot must exist before that call, exactly as
		// the constant slot must exist before `recordConst`.
		self.valueOwnsHeap.push(false)
		// The promise mark rides the same lockstep, seeded NOT-a-promise; set by `markValuePromise` on the
		// one value an `async` spawn produces.
		self.valuePromiseMarks.push(false)
		// The capturing-closure mark + its env ride the same lockstep, seeded NOT-a-capture / no-env; set by
		// `parseClosureExpression` on the one value a capturing closure produces (see the field header).
		self.valueIsCapturingClosure.push(false)
		self.valueClosureEnv.push(0)
		return id
	end 'mintValue'

	// Mint a value whose type is already in hand as a `MaxonType` — a `literal` op's type (the
	// op stores one anyway), a call's declared return type. It DECOMPOSES an existing union
	// rather than constructing a new one, so it allocates nothing either.
	function mintValueOfType(valueType MaxonType) returns ValueId
		return self.mintValue(maxonTypeTag(valueType), nameId: typeNameIdOf(valueType))
	end 'mintValueOfType'

	// Re-record an EXISTING value's type columns in place. The caught error flag is a box POINTER that
	// `desugarTry` minted as `integer` for the `flag != 0` null test; a boxed `(e)` binding re-records it as
	// its UNION type so `match e` dispatches through the box (`enumMatchFor`) and its scope-exit drop routes
	// to `__destruct_<U>` (`decrefCalleeFor`), both of which read the value TAG. Only the two type columns
	// move — the value's Std width is unchanged (`valueTagToStdType` collapses both `integer` and `named` to
	// i64), so the already-emitted `flag != 0` compare and the `tryCall`'s flag register are unaffected.
	function retypeValue(value ValueId, valueType MaxonType)
		try self.valueTags.set(value, value: maxonTypeTag(valueType)) otherwise panic("retypeValue: v{value} has no type slot — every SSA value is minted through mintValue")
		try self.valueNameIds.set(value, value: typeNameIdOf(valueType)) otherwise panic("retypeValue: v{value} has no type-name slot — the two type columns are filled in lockstep")
	end 'retypeValue'

	// Append a value's type to the columns WITHOUT allocating an id — for the parameters,
	// whose ids (0..paramCount-1) the value numbering RESERVED rather than minted.
	function recordValueType(valueType MaxonType)
		self.valueTags.push(maxonTypeTag(valueType))
		self.valueNameIds.push(typeNameIdOf(valueType))
		// A parameter's value is the one thing the compiler provably cannot see.
		self.valueConsts.push(0)
		self.valueConstKnown.push(false)
		// A parameter is never a fresh interpolation result, so it starts NOT owned — but its slot must
		// exist so the column stays indexable by every ValueId, params included.
		self.valueOwnsHeap.push(false)
		// A parameter is never an async spawn's handle; the slot must exist so the column stays indexable.
		self.valuePromiseMarks.push(false)
		// A parameter is never a capturing closure; the slots must exist so the columns stay indexable by
		// every ValueId, params (including a lifted closure's trailing `__env`) included.
		self.valueIsCapturingClosure.push(false)
		self.valueClosureEnv.push(0)
	end 'recordValueType'

	// Remember the integer behind a value the parser has just DEFINED. Called by the emitters, on
	// the id they minted a moment ago, so the slot is always there.
	function recordConst(id ValueId, folded ParsedInt)
		try self.valueConsts.set(id, value: folded) otherwise panic("Parser.recordConst: value v{id} has no constant slot — every SSA value must be minted through mintValue")
		try self.valueConstKnown.set(id, value: true) otherwise panic("Parser.recordConst: value v{id} has no constant slot — every SSA value must be minted through mintValue")
	end 'recordConst'

	// True iff the compiler holds `id`'s integer.
	function constIsKnown(id ValueId) returns bool
		return try self.valueConstKnown.get(id) otherwise panic("Parser.constIsKnown: value v{id} has no constant slot — every SSA value must be minted through mintValue")
	end 'constIsKnown'

	// The integer behind `id`. Only meaningful when `constIsKnown(id)` — asking otherwise is a
	// caller bug, and handing back the unseeded 0 as if it were a real constant is exactly the
	// wrong answer a sentinel would give, so it panics instead.
	function constOf(id ValueId) returns ParsedInt
		if not self.constIsKnown(id) 'unknown'
			panic("Parser.constOf: value v{id} is not a known constant — guard the call with constIsKnown")
		end 'unknown'

		return try self.valueConsts.get(id) otherwise panic("Parser.constOf: value v{id} has no constant slot — every SSA value must be minted through mintValue")
	end 'constOf'

	// Record a fold's result, if it produced one. `notFoldable` is a DECISION and not a gap — the
	// folder declined an operator whose answer is a diagnostic rather than a number — so the value
	// simply stays unknown, and the guard downstream handles it.
	function recordFold(id ValueId, fold FoldedInt)
		match fold 'f'
			folded(value) then self.recordConst(id, folded: value)
			notFoldable then return
		end 'f'
	end 'recordFold'

	// The TAG of an SSA value's type — the hot read, and the only thing the operator rules
	// need. Every value the parser mints has one (the parameters are seeded from their
	// declarations, `mintValue` records the rest), so a miss is a parser invariant break.
	function tagOf(value ValueId) returns ValueTypeTag
		return try self.valueTags.get(value) otherwise panic("Parser.tagOf: value v{value} has no recorded type — every SSA value must be minted through mintValue")
	end 'tagOf'

	// **IS THIS VALUE'S TYPE UNSIGNED?** The question THE SHIFT RULE asks of a shift's LEFT operand,
	// and the only thing that decides whether `shr` fills with the sign or with zeros. Exhaustive
	// over `ValueTypeTag`, so a new type cannot be added without being placed on one side of it.
	//
	//   • `named`    — a ranged typealias, and unsigned exactly when its LOW BOUND is 0 or above
	//                  (`rangeIsUnsigned`). The alias is looked up in the WHOLE-PROGRAM declaration
	//                  index, never in this file's artifact: an alias declared in another file is
	//                  still an unsigned type here, and a file-local table would answer "signed" and
	//                  emit the wrong instruction. It is order-independent within a file too, which
	//                  the artifact table — filled as declarations are parsed — would not be.
	//   • `exitCode` — `int(0 to u32.max)`. Unsigned, by the same low-bound rule its range would
	//                  give if it were spelled as one.
	//   • `integer`  — a bare `int` is `i64.min to i64.max`. SIGNED, and it is the default every
	//                  shift in the language sign-fills under.
	//   • the rest   — not a number, so not a shift operand at all: `requireBinOpOperands` has
	//                  already rejected the program, and `emitShift` asks it BEFORE this is reached.
	//                  Answering "signed" costs nothing, because no code is kept.
	function valueIsUnsigned(value ValueId) returns bool
		let tag = self.tagOf(value)
		if tag == ValueTypeTag.exitCode 'exitCode'
			return true
		end 'exitCode'

		if tag != ValueTypeTag.named 'notAnAlias'
			return false
		end 'notAnAlias'

		let name = self.internedName(self.valueNameId(value))

		// An alias NO file declares is a user error (E3011, reported by TypeResolution against the
		// merged registry, which is the authority). It is not this rule's to report — the sweep is
		// deliberately tolerant — and the program is rejected before anything emitted here can run,
		// so "signed" is the harmless reading and never a silent wrong answer.
		return match self.signatures.aliasOf(name, readerFilePath: self.filePath) 'a'
			declared(alias) gives rangeIsUnsigned(alias.low)
			undeclared gives false
		end 'a'
	end 'valueIsUnsigned'

	// The full `MaxonType` of an SSA value, REBUILT from the two columns. It CONSTRUCTS a
	// union, so it allocates — which is why it is called only where a `MaxonType` is genuinely
	// STORED (a binding's declared type), and never on a per-value or per-operator path.
	function typeOf(value ValueId) returns MaxonType
		return maxonTypeOfTag(self.tagOf(value), nameId: self.valueNameId(value))
	end 'typeOf'

	// Record the block-arg values `block` passes to `targetId` for the Std-tier
	// phi-elim pass. A branch op carries only the target BlockId, so the per-edge phi
	// operands live on the predecessor's `branchEdges` (see IrBlock). An empty list
	// means the target has no phis — nothing to record.
	function recordBranchEdge(block IrBlock, targetId BlockId, argIds ValueIdArray)
		if argIds.count() == 0 'noArgs'
			return
		end 'noArgs'
		block.branchEdges.push(BranchEdge.create(targetId, argIds: argIds))
	end 'recordBranchEdge'

	// Create + register a fresh block in `func`, filling the source footprint from the
	// parser's own file/position so the four `if` block-creation sites don't each
	// respell it.
	function newBlock(func IrFunction, label ByteArray, line LineNumber) returns IrBlock
		return self.artifact.module.addBlockAt(func, label: label, filePath: self.filePath.toString(), firstLine: line)
	end 'newBlock'

	// Set `block`'s terminator to a two-way conditional branch, anchored on the `if`
	// keyword's span.
	function emitCondBranch(block IrBlock, cond ValueId, thenId BlockId, elseId BlockId, ifTok Token)
		self.artifact.emitTerminator(block, op: MaxonOp.condBranch(cond, thenBlockId: thenId, elseBlockId: elseId), range: SourceRange.ofToken(ifTok))
	end 'emitCondBranch'

	// Set `block`'s terminator to an unconditional branch. The branch is synthetic (no
	// source token spawned it — it is the compiler wiring a fall-through), so it carries
	// the positionless `SourceRange.none()`.
	function emitBranch(block IrBlock, targetId BlockId)
		self.artifact.emitTerminator(block, op: MaxonOp.branch(targetId), range: SourceRange.none())
	end 'emitBranch'

	// Expression entry — EVERY value context: a `let`/`var` initializer, an assignment's
	// right-hand side, a `return` value, a call argument, an `if`/`while` CONDITION, the
	// inside of a parenthesis. There is ONE GRAMMAR for all of them.
	//
	// A condition once had its own, FLATTER grammar (`operand [cmpOp operand]`, operands parsed
	// at additive precedence), for exactly one reason — a comparison could only be consumed by
	// a branch, because the backend had no way to write a boolean into a register. Two things
	// ended that. `setcc` gives it one (`let r = 5 > 3` compiles), and `and`/`or` bind LOOSER
	// than comparison, so `if a > 0 and b > 0` cannot even be expressed by a grammar whose top
	// level is a single comparison. One climber, one set of precedences, and a condition is
	// simply an expression that happens to feed a branch — plus a TYPE rule, which is
	// `parseBoolCondition` below, not a second grammar.
	//
	// Seeds `currentBlock`, which every emit below targets — see the field.
	//
	// ⭐ **THE INLINE CONDITIONAL `<t> if <c> else <f>` IS HOOKED HERE (P1.5-A2c)** — a value-position
	// ternary that binds LOOSER than every binary operator, so it wraps the WHOLE `parseBinary` result and
	// is checked only after the climber has run. `parseBinary`'s RHS recursion never reaches this point, so
	// `a + b if c else d` is `(a + b) if c else (a + b's sibling)`; the `else` arm is a full `parseExpression`
	// again, so `1 if a else 2 if b else 3` right-associates. The block-form `if` cannot collide: it is a
	// STATEMENT keyword `parseStatement` catches at statement start, whereas a ternary `if` only follows an
	// operand — the same split both reference compilers draw (2-Parser.cs:5128).
	//
	// The true arm parses before the `if` announces the form, so two facts about the block ARE captured up
	// front, allocation-free: the IR-detach mark (the start block plus its op/block-ref counts, so
	// `parseTernaryExpression` can lift the arm's ops off the unconditional path into the true branch — only
	// the SELECTED arm may run) and the pre-arm MOVE state (rewound onto the false arm). `captureMoveMark`
	// runs only when an owned binding is in scope; scalar code shares the empty mark and pays nothing.
	function parseExpression(func IrFunction, block IrBlock) returns ValueId throws ParseError
		self.currentBlock = block
		return try self.parseValueExpression(func)
	end 'parseExpression'

	// The climber PLUS the trailing inline conditional, over `self.currentBlock` as it already stands —
	// the entry every value context that must NOT re-seed `currentBlock` calls in place of the bare
	// `parseBinary`. A call argument, a struct-field value, a union-payload value and a parenthesised
	// group are each parsed INSIDE an expression that already moved `currentBlock` (an earlier sibling
	// short-circuited), so seeding it afresh — which `parseExpression` does — would discard that move.
	// They still need the ternary, though (`f(a if c else b)`, `T{x: a if c else b}`, `(a if c else b)`),
	// so the hook lives HERE, below the seed, and those sites call this directly. The mark is recorded off
	// the current block so `parseTernaryExpression` detaches the true arm from wherever control actually is.
	function parseValueExpression(func IrFunction) returns ValueId throws ParseError
		let block = self.currentBlock

		let markOpRefCount = block.opRefs.count()
		let markBlockRefCount = func.blockRefs.count()
		// The pending-temporary height at the same instant as the op/block marks — everything enrolled above
		// it while the value below parses belongs to what may turn out to be a ternary's TRUE ARM, and is
		// released inside that arm rather than on the unconditional path (see `parseTernaryExpression`).
		let markTempCount = self.pendingTempDrops.count()
		var preMoveMark = self.emptyMoveMark
		if self.ownedBindings.count() > 0 'ownedInScope'
			preMoveMark = self.captureMoveMark()
		end 'ownedInScope'

		let value = try self.parseBinary(func, minPrec: OrPrecedence)

		if self.at(TokenKind.if) 'ternary'
			return try self.parseTernaryExpression(func, trueValue: value, startBlock: block, markOpRefCount: markOpRefCount, markBlockRefCount: markBlockRefCount, markTempCount: markTempCount, preMoveMark: preMoveMark)
		end 'ternary'

		return value
	end 'parseValueExpression'

	// ⭐ **THE INLINE CONDITIONAL `<t> if <c> else <f>` (P1.5-A2c).** Called with the TRUE arm already
	// parsed (into `startBlock` since the mark) and the current token at `if`. Two obligations shape it:
	//
	//   **ONLY THE SELECTED ARM IS EVALUATED.** `0 if d == 0 else n / d` must not divide when d is 0, so
	//   neither arm may sit on the unconditional path. The false arm is easy — parsed straight into its own
	//   block. The true arm is not: nothing announced the ternary until the `if` that follows it, so it was
	//   emitted into the fall-through path and is DETACHED here and re-attached inside the true branch. The
	//   IR moves (its `module.ops` indices are unchanged; only the block referencing them changes); nothing
	//   is re-parsed, so no value id is minted twice and no closure is lifted twice — the bootstrap makes the
	//   identical move (2-Parser.cs:ParseTernaryExpression), by necessity, for the identical reason.
	//
	//   **THE TWO ARMS MERGE THROUGH ONE PHI**, exactly as a `match` expression's `gives` arms do — so the
	//   merge is `finalizeMatchMerge` over a two-arm reaching set with no carried vars. That reuse is the
	//   whole point: the give-type agreement (E3005, OPEN #54C), the cross-register-class refusal (OPEN #31),
	//   the owned-give normalisation, and the conditional-move reconciliation are ONE implementation for both
	//   forms, so a ternary cannot drift from a match on any of them.
	//
	// A CAPTURING closure may not be an arm: the phi carries the function pointer but not the capture
	// environment (the same merge hazard the match `gives` arm and the `otherwise` fallback are refused for),
	// so it is rejected E3099 at the `if` — the shared anchor for both arms, where each reference compiler
	// anchors it.
	function parseTernaryExpression(func IrFunction, trueValue ValueId, startBlock IrBlock, markOpRefCount ElementCount, markBlockRefCount ElementCount, markTempCount TempDropMark, preMoveMark MoveMark) returns ValueId throws ParseError
		let ifTok = try self.consume(TokenKind.if)

		// The E3099 refusal for a capturing closure in EITHER arm — the route-specific prefix over the
		// shared merge suffix (the same shape `parseArmBody`'s `gives` refusal builds), computed once and
		// used for both arms. Anchored at the `if`, the shared point of the two arms, where each reference
		// compiler anchors it.
		let armEscapeMessage = "cannot use a closure that captures as an arm of a conditional expression: {CapturingClosureMergeSuffix}"
		try self.rejectEscapingClosure(trueValue, message: armEscapeMessage, tok: ifTok)

		// Where the true arm's VALUE lives: `startBlock` when the arm emitted only straight-line ops, or the
		// arm's own exit block when it grew control flow (a short-circuit, a nested ternary, a match).
		let armExit = self.currentBlock

		// The true arm's owned give leaves its owner (so the merge, not the arm, drops it) — done now, so the
		// transfer's own poison is captured into the true arm's move state below.
		try self.transferGiveToPhi(trueValue, anchor: ifTok)

		// ⭐ **THE TRUE ARM'S TEMPORARIES ARE RELEASED WHILE THE ARM IS STILL DETACHABLE, AND TRAVEL WITH IT.**
		// The arm was parsed onto the unconditional path before the `if` revealed the form, so its temporaries
		// (`[1,2].count() if c else …` builds one) are enrolled as though they were the enclosing statement's —
		// and after the relocation below the arm runs on ONE edge, where a release on the unconditional path
		// would free a value the false path never built. Emitting the release HERE, before the ops are
		// collected, puts it in the tail of `startBlock` that `relocatedOpRefs` sweeps into `trueBranch` (or,
		// for an arm that grew control flow, into the arm's own inner exit block, which is relocated too). So
		// the drop rides the SAME relocation the arm does and needs no second mechanism to follow it.
		// `transferGiveToPhi` above has already taken an owned give out of the list, so the arm's VALUE is
		// never released here — only what it built and abandoned.
		self.drainPendingTemps(markTempCount, anchor: ifTok)

		// ⭐ **THE CONDITION RUNS FIRST AT RUNTIME, THOUGH IT PARSES SECOND.** The true arm was parsed before
		// the `if` revealed the form, so any binding it MOVED (an owned value into a struct field, say) is
		// poisoned now — but the condition, which runs BEFORE the true arm, must see that binding LIVE
		// (`Box.create(k) if isSet(k) else …` reads a live `k`). So the true arm's move state is snapshotted
		// and REWOUND to the pre-ternary state; the condition then parses from there, and the true path's mark
		// is re-formed below as the union of the two.
		let afterTrueArm = self.captureMoveMark()
		self.restoreMoveMark(preMoveMark)

		// ⭐ **DETACH THE TRUE ARM off the unconditional path.** Its ops are the tail of `startBlock`'s
		// `opRefs` since the mark; its terminator and outgoing edges (present only when the arm grew control
		// flow — unset/empty for a straight-line arm, since `startBlock` was unterminated at the mark) and its
		// inner blocks (the `func.blockRefs` tail since the mark) go with them. The ops keep their
		// `module.ops` indices; only the block that references them changes.
		var relocatedOpRefs = OpIndexArray.create()
		for i in markOpRefCount upto startBlock.opRefs.count() 'collectOps'
			relocatedOpRefs.push(try startBlock.opRefs.get(i) otherwise panic("parseTernaryExpression: startBlock.opRefs.get OOB at {i}"))
		end 'collectOps'
		while startBlock.opRefs.count() > markOpRefCount 'truncOps'
			_ = try startBlock.opRefs.pop() otherwise panic("parseTernaryExpression: startBlock.opRefs.pop above the mark {markOpRefCount} failed")
		end 'truncOps'

		let savedTerminator = startBlock.terminator
		let savedEdges = startBlock.branchEdges
		startBlock.terminator = Terminator.unset
		startBlock.branchEdges = BranchEdgeArray.create()

		var armInnerBlockRefs = BlockRefArray.create()
		for i in markBlockRefCount upto func.blockRefs.count() 'collectBlocks'
			armInnerBlockRefs.push(try func.blockRefs.get(i) otherwise panic("parseTernaryExpression: func.blockRefs.get OOB at {i}"))
		end 'collectBlocks'
		while func.blockRefs.count() > markBlockRefCount 'truncBlocks'
			_ = try func.blockRefs.pop() otherwise panic("parseTernaryExpression: func.blockRefs.pop above the mark {markBlockRefCount} failed")
		end 'truncBlocks'

		// ⭐ **THE CONDITION IS THE ONE THING THAT IS UNCONDITIONAL** — it lands where the true arm was and
		// runs before the branch. It may short-circuit and move `currentBlock`, so the two-way branch belongs
		// at the end of whichever block it left (`condExit`), exactly as `parseIfStatement` re-reads its entry
		// after the condition.
		self.currentBlock = startBlock
		// The condition is an ordinary expression that must be a bool — NOT `parseBoolCondition`, whose
		// E3005 "'if' requires a bool condition" is shared with the `if`/`while` STATEMENTS. A ternary's
		// non-bool condition is E2028 "ternary expression requires a bool condition" (#80), anchored at the
		// `if` (where `parseBoolCondition` anchors at the condition token) — matching the reference oracle.
		let cond = try self.parseExpression(func, block: startBlock)
		let condTag = self.tagOf(cond)
		if not typeClassAdmits(TypeClass.boolean, tag: condTag) 'nonBoolCondition'
			throw ParseError.ternaryNonBoolCondition(typeTagName(condTag), line: ifTok.line, column: ifTok.column)
		end 'nonBoolCondition'
		let condExit = self.currentBlock

		// The CONDITION is unconditional, so its own temporaries die on the single path, in the block the
		// condition left control in — the `if`-statement rule, applied to the ternary's condition.
		self.drainPendingTemps(markTempCount, anchor: ifTok)

		// The move state after the (unconditional) condition — the base BOTH arms build on. The TRUE path is
		// that base PLUS the true arm's own moves (rewound above); the FALSE path is that base plus the false
		// arm's, and it inherits `condBase` as the live state directly, since the false arm parses next.
		let condBase = self.captureMoveMark()
		let trueMoveMark = orMoveMarks(afterTrueArm, b: condBase)

		try self.consume(TokenKind.else)

		// Reattach the true arm inside a fresh branch, physically after the condition's blocks. `trueExit` is
		// where its value lives now: the true branch itself when the arm was straight-line, else the arm's own
		// (relocated) exit block.
		var trueBranch = self.newBlock(func, label: b"ternarytrue", line: ifTok.line)
		trueBranch.opRefs = relocatedOpRefs
		trueBranch.terminator = savedTerminator
		trueBranch.branchEdges = savedEdges
		for br in armInnerBlockRefs 'reattach'
			func.blockRefs.push(br)
		end 'reattach'
		var trueExit = trueBranch
		if armExit.id != startBlock.id 'multiBlockArm'
			trueExit = armExit
		end 'multiBlockArm'

		// The false arm parses straight into its own block, so it never runs on the true path — from the
		// post-condition move state (`condBase`, the current live state), never the true arm's moves. A full
		// `parseExpression` — a chained `… else b if c2 else d` right-associates here.
		var falseBranch = self.newBlock(func, label: b"ternaryfalse", line: ifTok.line)
		let falseValue = try self.parseExpression(func, block: falseBranch)
		try self.rejectEscapingClosure(falseValue, message: armEscapeMessage, tok: ifTok)
		let falseExit = self.currentBlock
		try self.transferGiveToPhi(falseValue, anchor: ifTok)

		// The false arm's own temporaries, released in ITS exit block — the mirror of the true arm's, and for
		// the same reason: the arm runs on one edge only. `currentBlock` is `falseExit` here.
		self.drainPendingTemps(markTempCount, anchor: ifTok)

		let falseMoveMark = self.captureMoveMark()

		// The merge is the SAME block-arg join a `match` expression uses (see the header). Two reaching arms,
		// no carried vars; `finalizeMatchMerge` runs every give-agreement/ownership rule and mints the result
		// phi and both edges. The ternary supplies only the branch out of the condition, emitted after so
		// `condExit` is still open when the merge's per-arm reconciliation runs.
		let carried = VarInfoArray.create()
		var reachingArms = MatchArmExitArray.create()
		reachingArms.push(MatchArmExit.create(trueExit, exitVals: ValueIdArray.create(), give: MatchGiveValue.value(trueValue), moveMark: trueMoveMark))
		reachingArms.push(MatchArmExit.create(falseExit, exitVals: ValueIdArray.create(), give: MatchGiveValue.value(falseValue), moveMark: falseMoveMark))
		let outcome = try self.finalizeMatchMerge(func, matchTok: ifTok, carried: carried, reachingArms: reachingArms, construct: MergeConstruct.ternary)

		self.emitCondBranch(condExit, cond: cond, thenId: trueBranch.id, elseId: falseBranch.id, ifTok: ifTok)

		self.currentBlock = outcome.cont
		match outcome.result 'r'
			value(id) then return id
			none then panic("parseTernaryExpression: the merge produced no value — both arms give a value, so the result phi is always present")
		end 'r'
	end 'parseTernaryExpression'

	// An `if` / `while` condition: an ordinary expression that must have type `bool`.
	//
	// **MAXON HAS NO C-STYLE TRUTHINESS.** `if 4` is not "if 4 is nonzero" — it is a type
	// error, and the ONLY tier that can say so is this one, because it is the only one holding
	// the expression's source type. The x64 lowering tests a non-fused condition with
	// `cmp reg, 0` + `jne`, which is exactly right for a bool (a bool IS 0 or 1, and a call
	// result, a parameter or a merge phi has no flags to fuse) — and is precisely why an `int`
	// condition silently "worked", branching on `n != 0`. The instruction cannot tell the two
	// apart. The type can.
	//
	// An `unresolved` condition is ADMITTED, not rejected: a cross-file callee's return type is
	// not known here, and `if isReady()` must compile. `typeClassAdmits` defers on `unknown`.
	//
	// The diagnostic anchors on the CONDITION's first token, not on the keyword: the message is
	// about the expression's type, and that is where the reader has to look — an `if` whose
	// condition spans three lines should not point at the `if`.
	function parseBoolCondition(func IrFunction, block IrBlock, kwTok Token) returns ValueId throws ParseError
		let condTok = self.current()
		let cond = try self.parseExpression(func, block: block)

		let condTag = self.tagOf(cond)
		if not typeClassAdmits(TypeClass.boolean, tag: condTag) 'notABool'
			throw ParseError.nonBoolCondition(kwTok.kind.rawValue, got: typeTagName(condTag), line: condTok.line, column: condTok.column)
		end 'notABool'

		return cond
	end 'parseBoolCondition'

	// The precedence-climbing core. Parse a unary/primary operand, then while the next token
	// is a binary operator whose precedence is >= `minPrec`, consume it and recurse for the
	// right operand at `precedence + 1` (which makes the operator LEFT-associative). A
	// supported operator below `minPrec`, a non-operator, or the end of the expression stops
	// the climb.
	//
	// THREE dispatches, and the middle one is the whole rung:
	//
	//   1. a SHORT-CIRCUIT `and`/`or` over a bool left operand ⇒ not an op at all. It becomes
	//      blocks and a merge phi, and it MOVES `currentBlock` (see emitShortCircuit), which
	//      is why `left`'s block is re-read from the field after every recursive call.
	//   2. a comparison ⇒ `MaxonOp.compare`, typed `boolean`.
	//   3. everything else ⇒ `MaxonOp.binOp`. This is where a bitwise `and`/`or`/`xor` lands:
	//      the short-circuit test above did not fire, so the operands are not bools, and on
	//      integers the word operators ARE the bit operators.
	//
	// No arm rejects anything any more. The old "a comparison is not a value" throw is gone
	// with the machinery that forced it.
	function parseBinary(func IrFunction, minPrec InfixPrecedence) returns ValueId throws ParseError
		var left = try self.parseCast(func)

		while true 'climb'
			let opTok = self.current()

			let prec = infixPrecedence(opTok.kind)
			if prec == NotAnInfixOperator or prec < minPrec 'stop'
				break
			end 'stop'

			// `and fallthrough` ends a match arm's body — it is the fallthrough SUFFIX, not a
			// bitwise `and`. `fallthrough` is a keyword and can never be a variable, so `and
			// fallthrough` has no reading as an expression ANYWHERE in the language; stopping the
			// climb here hands the suffix intact to the match arm parser (P1.1b wave A), which either
			// consumes it or — in a match EXPRESSION arm — rejects the stray `and` (E2001). No mode
			// flag is needed precisely because the pairing is unambiguous everywhere.
			if opTok.kind == TokenKind.and and self.peekKind() == TokenKind.fallthrough 'fallthroughSuffix'
				break
			end 'fallthroughSuffix'

			// The short-circuit test reads the LEFT operand's type only, and reads it BEFORE
			// the right operand is parsed — it has to, because whether the right operand is
			// evaluated AT ALL is the thing being decided. (v1 gates identically:
			// Parser.maxon:11384.)
			if shortCircuitOperator(opTok.kind) and tagIsBool(self.tagOf(left)) 'shortCircuit'
				self.advance()
				left = try self.emitShortCircuit(func, leftValue: left, opTok: opTok, rhsMinPrec: prec + 1)
				continue
			end 'shortCircuit'

			self.advance()
			// The right operand's token span, remembered BEFORE it is parsed and read back after.
			// It is not what the shift rule ASKS — that is the constant folder's job — but it is
			// where E2054 POINTS, and the climber has already decided how far the operand reaches.
			let rhsStart = self.pos
			let right = try self.parseBinary(func, minPrec: prec + 1)
			let rhsEnd = self.pos

			if comparisonOperator(opTok.kind) 'comparison'
				left = try self.emitCompare(left, rhs: right, op: infixCmpOp(opTok.kind), opTok: opTok)
				continue
			end 'comparison'

			let op = infixMaxonOp(opTok.kind)

			// A shift's right operand is not an ordinary number but a DISTANCE, and Maxon's rule
			// for it (Go's) is deliberately not the hardware's. It gets its own emitter, which
			// owns the rule, the diagnostic, AND the runtime guard. See `emitShift`.
			if shiftOperator(op) 'isShift'
				left = try self.emitShift(left, count: right, op: op, opTok: opTok, countStart: rhsStart, countEnd: rhsEnd)
				continue
			end 'isShift'

			left = try self.emitBinOp(left, rhs: right, op: op, opTok: opTok)
		end 'climb'

		return left
	end 'parseBinary'

	// ⭐ Emit `lhs <op> count` under TypeRules' ⭐ THE SHIFT RULE — THE one place a source-level
	// shift is built. Two jobs, separate on purpose:
	//
	//   **LEGALITY.** A count the parser can FOLD is decided here: a negative one is E2054. A count
	//   of 64 or more is LEGAL and is NOT an error — it shifts every bit out — which is the whole
	//   narrowing of this diagnostic. A count the parser CANNOT fold is Go's runtime panic, which
	//   shv2 cannot raise yet; see `emitGuardedShift`.
	//
	//   **VALUE.** A folded count is rewritten into the shift its semantics define, so no count
	//   above `MaxUnguardedShiftCount` ever reaches codegen and the hardware's masking is never
	//   consulted. A count that could NOT be folded gets the GUARD, which saturates it at run time
	//   — to the SAME answer. That the two agree is not a coincidence: both are readings of
	//   `evalShift`.
	function emitShift(lhs ValueId, count ValueId, op MaxonBinOp, opTok Token, countStart TokenIndex, countEnd TokenIndex) returns ValueId throws ParseError
		// The SHIFT's OWN operand rule, asked BEFORE anything is emitted. `emitBinOp` would ask it
		// too, but by then the guard's ops are already in the IR — and the FIRST of them is an
		// `and`, so `4 shr flag` would be rejected as a bad `and` rather than as a bad `shr`
		// (E3005 for the wrong operator instead of E2004 for the right one). A rejected program
		// must also leave no ops behind.
		try requireBinOpOperands(op, left: self.tagOf(lhs), right: self.tagOf(count), opTok: opTok)

		// ⭐ THE SHIFT RULE's one question, asked ONCE, of the LEFT operand — and then CARRIED: to
		// the opcode, to the fold, and to the guard. Never re-derived, because the whole class of
		// bug this file has already paid for is two readers of one rule reaching two answers.
		let signFills = shiftFillsWithSign(op, leftOperandIsUnsigned: self.valueIsUnsigned(lhs))
		let shiftOp = shiftOpcodeFor(op, signFills: signFills)

		if not self.constIsKnown(count) 'dynamic'
			return try self.emitGuardedShift(lhs, count: count, op: shiftOp, opTok: opTok)
		end 'dynamic'

		let folded = self.constOf(count)
		if shiftCountIsNegative(folded) 'negative'
			// Constructed and thrown in ONE expression. A `throw self.someHelper(…)` — building the
			// error in a helper and throwing what it returns — LEAKS the boxed union under the
			// bootstrap's refcounting, which the suite's leak check catches as an extra stderr line.
			let anchor = self.shiftCountAnchor(countStart, countEnd: countEnd)
			throw ParseError.shiftCountNegative(folded, line: anchor.line, column: anchor.column)
		end 'negative'

		if not shiftCountIsUnguarded(folded) 'shiftedOut'
			// A count that shifts every bit out. There is no instruction for it — the hardware
			// would mask it straight back into range — so the compiler writes down what it MEANS.
			// A shift that fills with ZEROS (`shl`, and an unsigned `shrLogical`) leaves the constant
			// 0. One that fills with the SIGN leaves the sign, and `x shr 63` already IS the sign, so
			// it becomes a shift by `MaxUnguardedShiftCount`. Neither is the masked shift the
			// hardware would have performed (`x shl 64` == `x`, `x shl 100` == `x shl 36`).
			//
			// `lhs` keeps its ops either way: they may have side effects, and Go evaluates the
			// left operand of a shift whatever the count turns out to be.
			if not signFills 'zeroFill'
				return self.emitLiteral(0, valueType: MaxonType.integer, range: SourceRange.ofToken(opTok))
			end 'zeroFill'

			let clamped = self.emitLiteral(MaxUnguardedShiftCount, valueType: MaxonType.integer, range: SourceRange.ofToken(opTok))
			return try self.emitBinOp(lhs, rhs: clamped, op: shiftOp, opTok: opTok)
		end 'shiftedOut'

		// A count the instruction takes as written; the hardware's mask is a no-op on it. The
		// operand is emitted UNCHANGED — this compiler folds no constant expression INTO the IR
		// (`1 + 2` still emits an `add`; see FoldConstOperands' header), and a shift count that
		// folds to 3 is a shift by 3 whether it arrives as a literal or as an `add`.
		let result = try self.emitBinOp(lhs, rhs: count, op: shiftOp, opTok: opTok)

		// The shift's own value, when the parser holds both sides — RECORDED, not rewritten. It is
		// what makes `let A = 1 shl 4` a count that `x shl A` can see. It folds under the OPCODE the
		// rule already chose, so the constant recorded here and the instruction that opcode emits
		// cannot answer differently — there is one fact, not two.
		if self.constIsKnown(lhs) 'bothKnown'
			self.recordConst(result, folded: evalShift(self.constOf(lhs), count: folded, op: shiftOp))
		end 'bothKnown'

		return result
	end 'emitShift'

	// A shift whose count the compiler could NOT fold — the runtime half of THE SHIFT RULE, and
	// the half that has to fight the hardware.
	//
	// x64 masks a 64-bit shift's count to its low 6 bits, so the instruction cannot be handed the
	// count as written: `x shl 64` would compute `x shl 0` (x, UNCHANGED) and `x shl 100` would
	// compute `x shl 36`. The count is SATURATED first, by the same rule `evalShift` folds by, and
	// with only the ops the Maxon tier already has (there is no `cmov` and no select in this
	// compiler — see TargetDialect's op inventory):
	//
	//   outOfRange = (count and -64) != 0        — one `and` decides BOTH ends at once: a count is
	//                                              outside 0..63 exactly when a bit above the low 6
	//                                              is set, and a NEGATIVE count has its sign bit
	//                                              set, so it lands out-of-range too.
	//   mask       = (t or -t) shr 63            — an ARITHMETIC shr turns "t is non-zero" into
	//                                              all-ones, and "t is zero" into all-zeros.
	//   ZERO-FILL: (x <shift> count) and not mask   — `shl`, and an UNSIGNED `shrLogical`. Both
	//                                                 shift every bit out, so both saturate to 0.
	//   SIGN-FILL: x shr (count or mask)            — a signed `shr` saturates to the SIGN, and a
	//                                                 count of -1 masks to 63, which IS the sign.
	//
	// Which one applies is read off the OPCODE, which is where `emitShift` already wrote the answer:
	// `shr` is the arithmetic right shift by definition of the enum, and every other shift opcode
	// zero-fills. THE SHIFT RULE was asked once, of the left operand; this is not a second reading
	// of it but a reading of its result.
	//
	// Cost, on top of the shift: 4 ops for the mask, plus 2 (zero-fill) or 1 (sign-fill). Only a
	// count the compiler cannot see pays it — every `x shr 8` and `x shl 3` is folded and untouched.
	//
	// ⚠ TODO — Go PANICS on a negative count at run time ("if the shift count is negative at run
	// time, a run-time panic occurs"), and shv2 CANNOT: it has no panic runtime, no trap op, and
	// no fault handler (the emitted runtime is a 5-instruction entry stub). That is the first
	// slice of **Workstream R**, and **OPEN.md #2** — `a / 0` escaping as a raw 0xC0000094
	// hardware trap — needs the same slice and is blocked on the same thing. Until it lands, a
	// negative count here is NOT a wrong answer: the mask above reads it as out-of-range, so
	// `x shl -1` is 0 and `x shr -1` is the sign. That is defined, deterministic, and NOT the
	// masked `x shl 63` this rule exists to kill — it is simply not yet the panic Go requires.
	// `specs-shv2/bitwise-operators.md` carries the case as a `disabled-test:`, to be enabled by
	// the rung that lands the panic runtime.
	function emitGuardedShift(lhs ValueId, count ValueId, op MaxonBinOp, opTok Token) returns ValueId throws ParseError
		let range = SourceRange.ofToken(opTok)

		let outOfRangeBits = self.emitLiteral(0 - ShiftCountBits, valueType: MaxonType.integer, range: range)
		let bitsAboveCount = try self.emitBinOp(count, rhs: outOfRangeBits, op: MaxonBinOp.bitAnd, opTok: opTok)
		let negatedBits = self.emitUnaryOp(bitsAboveCount, op: MaxonUnaryOp.neg, resultTag: ValueTypeTag.integer, opTok: opTok)
		let signCarrier = try self.emitBinOp(bitsAboveCount, rhs: negatedBits, op: MaxonBinOp.bitOr, opTok: opTok)
		let signBit = self.emitLiteral(MaxUnguardedShiftCount, valueType: MaxonType.integer, range: range)
		// ARITHMETIC, and unconditionally so: this `shr` is not the user's shift but the MASK's, and
		// it works precisely BECAUSE it replicates the sign — `signCarrier shr 63` is all-ones when
		// the count is out of range and all-zeros when it is not. It is a fact about `signCarrier`
		// (a plain `int`, and therefore signed) and never about `lhs`, so the user's shift opcode has
		// no say in it.
		let mask = try self.emitBinOp(signCarrier, rhs: signBit, op: MaxonBinOp.shr, opTok: opTok)

		if op == MaxonBinOp.shr 'signFilling'
			// A count of -1 masks to 63 in the hardware, and `x shr 63` IS the sign — so saturating
			// a sign-filling shift is a CLAMP OF THE COUNT, and needs no select of the result.
			let saturatedCount = try self.emitBinOp(count, rhs: mask, op: MaxonBinOp.bitOr, opTok: opTok)
			return try self.emitBinOp(lhs, rhs: saturatedCount, op: op, opTok: opTok)
		end 'signFilling'

		// A zero-filling shift — `shl`, or an unsigned `shrLogical`. Both shift every bit out for
		// an out-of-range count, so both saturate to 0 by masking the RESULT. The shift itself is
		// `op`, which is why one branch now serves the two of them.
		let raw = try self.emitBinOp(lhs, rhs: count, op: op, opTok: opTok)
		let keep = self.emitUnaryOp(mask, op: MaxonUnaryOp.bitNot, resultTag: ValueTypeTag.integer, opTok: opTok)
		return try self.emitBinOp(raw, rhs: keep, op: MaxonBinOp.bitAnd, opTok: opTok)
	end 'emitGuardedShift'

	// WHERE E2054 POINTS: the first token of the count as WRITTEN. `x shl SHIFT` points at `SHIFT`,
	// where the programmer would look, and not at the `let` that gave it its value. Redundant
	// parentheses are not part of what was written, so `x shl (-1)` points at the `-1`.
	function shiftCountAnchor(countStart TokenIndex, countEnd TokenIndex) returns Token
		var lo = countStart
		var hi = countEnd

		// Strip redundant outer parentheses so `x shl (-1)` anchors E2054 on the `-1`, not the `(`. The
		// same 4-line idiom `rhsWasBareLocalReference` uses to see a move through `(t)` — NOT factored
		// into a shared helper on purpose: the only shv2 return shape that could hand back both narrowed
		// bounds is a tuple, and a tuple return HEAP-ALLOCATES per call, which on the per-bind/assign
		// gate path reintroduces exactly the linear compile-time allocation the move-poison optimizer
		// removed. Each copy is independently pinned by specs (shift goldens here; `paren-move` there), so
		// a divergence cannot pass unnoticed, and the two serve unrelated ends (diagnostic anchor vs move
		// soundness) — a benign shared mechanic, not a shared fact that must agree.
		while lo + 2 <= hi and self.kindAt(lo) == TokenKind.leftParen and self.kindAt(hi - 1) == TokenKind.rightParen 'stripParens'
			lo = lo + 1
			hi = hi - 1
		end 'stripParens'

		return self.tokenAt(lo)
	end 'shiftCountAnchor'

	// Lower a BOOL `and`/`or` to SHORT-CIRCUIT control flow — the point of this rung. `a and
	// b` must not evaluate `b` when `a` is false, so it is not an operator at all: it is a
	// branch, a block, and a merge phi, minted on the same on-the-fly SSA machinery `if` and
	// `while` mint theirs.
	//
	//     entry:  <lhs already evaluated>
	//             cond_br lhs ? rhs   : merge   -- `and`: a FALSE lhs skips the rhs
	//             cond_br lhs ? merge : rhs     -- `or` : a TRUE  lhs skips the rhs
	//     rhsEnd: <the rhs is evaluated HERE, and on no other path>
	//             br merge(rhsValue)
	//     merge:  phi <- [seed from entry] [rhsValue from rhsEnd]
	//
	// The SEED is the answer the skipped path already determined: `false` for `and`, `true`
	// for `or`. Ported from maxon-selfhosted's `emitShortCircuit`
	// (Parser.maxon:11718-11787), with two deliberate divergences:
	//
	//   1. v1 seeds a VAR SLOT, stores the rhs into it, and reloads it at the merge, because
	//      v1 has slots and a `mem2reg` to promote them. shv2 has neither — its parser IS
	//      the SSA constructor — so the merge value is a BLOCK ARG fed by each predecessor's
	//      branch edge. The same shape, one tier earlier and with no store/load round trip.
	//   2. v1 NEGATES the lhs for `or` (`xor lhs, 1`) so the "then" target is always the rhs,
	//      matching its jcc-to-else convention. shv2's `condBranch` names both targets and
	//      `lowerCondBranch` emits `jcc` + `jmp` for EVERY layout, so the targets are simply
	//      SWAPPED — exact, and free, where v1's negation costs a literal and an xor on every
	//      single `or`.
	//
	// The rhs block is created BEFORE the rhs is parsed and the merge block AFTER, so a
	// NESTED short-circuit inside the rhs slots its own blocks between them and `.text` still
	// lays out in evaluation order (v1 makes the same point).
	function emitShortCircuit(func IrFunction, leftValue ValueId, opTok Token, rhsMinPrec InfixPrecedence) returns ValueId throws ParseError
		// `var`, not `let`: the seed literal and the two-way branch are emitted INTO it, and
		// a `let` binding cannot be forwarded to a mutating parameter (E3019).
		var entry = self.currentBlock
		let range = SourceRange.ofToken(opTok)
		let takesRhsWhenTrue = opTok.kind == TokenKind.and

		// The value the SKIPPED path yields, materialized in the entry block: `false and _`
		// is false, `true or _` is true. It is the entry edge's phi operand.
		let seed = self.emitLiteralIn(entry, value: shortCircuitSeed(takesRhsWhenTrue), valueType: MaxonType.boolean, range: range)

		let rhsBlock = self.newBlock(func, label: shortCircuitLabel(takesRhsWhenTrue), line: opTok.line)
		self.currentBlock = rhsBlock
		let rhsTempFloor = self.pendingTempDrops.count()
		let rhsValue = try self.parseBinary(func, minPrec: rhsMinPrec)
		// NOT `rhsBlock`: the rhs may itself have short-circuited (`a or b or c`), leaving
		// control in a merge block of its own. That is the block the value is defined in, and
		// the one that must branch here.
		var rhsEnd = self.currentBlock

		// ⭐ **THE RIGHT-HAND SIDE RUNS ON ONE PATH, SO ITS TEMPORARIES DIE ON THAT PATH.** `a or [4,5].count()
		// == 2` builds its array only when the lhs was false; on the short-circuit path the value does not
		// exist at all. Releasing it after the merge is therefore not a leak but the OPPOSITE mistake — a
		// release of something never built, which is a use of a register the skipped path never wrote. It was
		// caught downstream, loudly, by the allocator's dominance invariant ("a use dominates its def"), which
		// is exactly the right complaint: `rhsEnd` is the only block the rhs's definitions dominate, so this
		// is the only place the release can go. A bool operand is never owned heap, so `rhsValue` itself is
		// never in this list and cannot be released out from under the merge phi.
		self.drainPendingTemps(rhsTempFloor, anchor: opTok)

		// The SHORT-CIRCUIT half of the same rule `emitBinOp` enforces — ASKED, not restated
		// (see `requireBinOpOperands`). The left operand is already known to be a bool: that is
		// what brought control here.
		let op = infixMaxonOp(opTok.kind)
		let rhsTag = self.tagOf(rhsValue)
		try requireBinOpOperands(op, left: ValueTypeTag.boolean, right: rhsTag, opTok: opTok)

		// The merge phi IS the operator's result, so its TAG is the operator's result type — and
		// it is ASKED of the same `binOpResultTag` the `binOp` path asks, not restated as a
		// literal `boolean` here. Restating it left a word operator's result type with TWO
		// deciders, one per path, and nothing making them agree: they answer the same thing today
		// only because a bool left operand makes `wordOpResultTag`'s first arm fire for every rhs
		// that survives the check above. The day that rule changes — deferring on an `unresolved`
		// rhs, say (see TypeRules' `wordOpResultTag`, and the cross-file gap in
		// `calleeResultType`) — the `binOp` path would move and this one would go on ASSERTING
		// `boolean` about a value it cannot type. A wrong tag is not a compile error; it is a
		// wrong answer at whatever reads the tag next, which is every rule this rung added.
		let resultTag = binOpResultTag(op, left: ValueTypeTag.boolean, right: rhsTag)

		var merge = self.newBlock(func, label: b"scmerge", line: opTok.line)
		let result = self.mintPhi(merge, tag: resultTag, nameId: UnnamedTypeId)

		self.recordBranchEdge(entry, targetId: merge.id, argIds: singletonArgs(seed))
		self.recordBranchEdge(rhsEnd, targetId: merge.id, argIds: singletonArgs(rhsValue))
		self.emitShortCircuitBranch(entry, cond: leftValue, rhsId: rhsBlock.id, mergeId: merge.id, takesRhsWhenTrue: takesRhsWhenTrue, range: range)
		self.emitBranch(rhsEnd, targetId: merge.id)

		self.currentBlock = merge
		return result
	end 'emitShortCircuit'

	// The two-way branch out of a short-circuit's entry block. `and` takes the rhs when the
	// lhs is TRUE; `or` takes it when the lhs is FALSE — so the two differ by nothing but
	// which target sits in which slot.
	function emitShortCircuitBranch(entry IrBlock, cond ValueId, rhsId BlockId, mergeId BlockId, takesRhsWhenTrue bool, range SourceRange)
		var thenId = mergeId
		var elseId = rhsId
		if takesRhsWhenTrue 'isAnd'
			thenId = rhsId
			elseId = mergeId
		end 'isAnd'
		self.artifact.emitTerminator(entry, op: MaxonOp.condBranch(cond, thenBlockId: thenId, elseBlockId: elseId), range: range)
	end 'emitShortCircuitBranch'

	// A prefix-operator operand — the climber's leaf.
	//
	// The two prefix operators bind their operands DIFFERENTLY, and both readings are pinned
	// by a spec:
	//   • `-` takes a PRIMARY, so `- -x` fails at the second `-` (parsePrimary raises E2004)
	//     — specs/unary-operators.md's double-negation case.
	//   • `not` takes another UNARY, so `not not a` is legal and is 42 for a == 42
	//     — specs/bitwise-operators.md's `bitwise-not-double`.
	// v1 splits them the same way (its `-` recurses into parsePrimary, its `not` into
	// parseUnary — Parser.maxon:12034-12055).
	//
	// `not` is TYPE-DIRECTED, like `and`/`or`/`xor`: on a bool it flips bit 0 (`not true` is
	// false), on an integer it complements all 64 (`not 5` is -6). The two are different
	// instructions, and choosing the integer one for a bool would give -1/-2 — both of which
	// still read as TRUE in a condition. So the parser, which is the tier that knows the
	// type, picks the opcode; the Std tier just lowers what it is given.
	//
	// `-` is NOT type-directed: it is ARITHMETIC, so its operand must be a number. `-flag` has
	// no reading — it negated the bool's 1 payload and produced -1, which is still TRUE in a
	// condition — so it is rejected by the same numeric-domain rule the binary arithmetic
	// operators use (TypeRules' `typeClassAdmits`).
	// The `as`-cast layer, LOOSER than unary `-`/`not` but TIGHTER than every binary operator: `-5 as Age`
	// is `(-5) as Age`, matching the bootstrap (whose `as` loop sits outside `ParsePrimary`, after the
	// unary), so a negative literal narrowed into a ranged alias is checked as the NEGATIVE value — which
	// is what `error.negative-out-of-range` pins. The cast is therefore NOT a `parsePostfix` operator
	// (that band — the indirect call `f(x)` — stays TIGHTER than `-`, so `-f()` is `-(f())`); it wraps the
	// whole unary result here. `applyCast` retags / range-checks / float-converts (P1.9).
	function parseCast(func IrFunction) returns ValueId throws ParseError
		var current = try self.parseUnary(func)
		while self.at(TokenKind.as) 'cast'
			let asTok = try self.consume(TokenKind.as)
			let targetType = try self.parseTypeReference()
			current = try self.applyCast(current, targetType: targetType, asTok: asTok)
		end 'cast'
		return current
	end 'parseCast'

	function parseUnary(func IrFunction) returns ValueId throws ParseError
		if self.at(TokenKind.minus) 'neg'
			let opTok = try self.consume(TokenKind.minus)

			// ⭐ **A LEADING `-` ON A LITERAL IS PART OF THE LITERAL**, not an operator over it. Two
			// separate wrong answers came from treating it as an operator, and both are fixed here:
			//
			//   • `-9223372036854775808` is exactly `i64.min`, but its MAGNITUDE (`i64.max + 1`) does
			//     not fit a positive i64 — so reading the magnitude first reported E2011 on a literal
			//     that is perfectly in range. `parseNegatedInt` already knew this; only the range-bound
			//     reader was asking it. Now the expression parser asks the same decoder.
			//   • `-0.0` compiled to `0.0 - 0.0`, which IEEE-754 says is `+0.0`. A sign flip is
			//     `negatedFloatBits`, and the declaration/range-bound paths always spelled it that way;
			//     only the expression path went through `emitFloatNegation` and lost the zero's sign.
			//
			// It also costs one op fewer for every negative literal, which is why the emitted code for
			// `let x = -5` changes from `mov 5; neg` to a single negative immediate.
			if self.at(TokenKind.intLiteral) or self.at(TokenKind.floatLiteral) 'negatedLiteral'
				return try self.parseNegatedNumericLiteral(opTok)
			end 'negatedLiteral'

			let operand = try self.parsePostfix(func, value: try self.parsePrimary(func), resultUsed: true)
			let operandTag = self.tagOf(operand)
			if not typeClassAdmits(TypeClass.numeric, tag: operandTag) 'notANumber'
				throw ParseError.nonNumericNegation(typeTagName(operandTag), line: opTok.line, column: opTok.column)
			end 'notANumber'

			if tagIsFloat(operandTag) 'float'
				return try self.emitFloatNegation(operand, opTok: opTok)
			end 'float'

			return self.emitUnaryOp(operand, op: MaxonUnaryOp.neg, resultTag: operandTag, opTok: opTok)
		end 'neg'

		if self.at(TokenKind.not) 'not'
			let opTok = try self.consume(TokenKind.not)
			let operand = try self.parseUnary(func)
			let operandTag = self.tagOf(operand)
			match notOperatorFor(operandTag) 'which'
				op(kind, resultTag) then return self.emitUnaryOp(operand, op: kind, resultTag: resultTag, opTok: opTok)
				unknownOperandType then throw ParseError.notOnUnknownType(opTok.line, column: opTok.column)
				nonIntegralOperand then throw ParseError.nonIntegralOperands(opTok.kind.rawValue, operand: typeTagName(operandTag), line: opTok.line, column: opTok.column)
			end 'which'
		end 'not'

		// `async <call>` SPAWNS a green thread and yields a Promise (P1.5-B1a); `await <expr>` blocks on one.
		// Both are prefix operators, alongside `-`/`not`. `async` must be followed by a free call; `await`
		// takes a unary operand (so `await async f()` — spawn then immediately await — parses).
		if self.at(TokenKind.async) 'async'
			try self.consume(TokenKind.async)
			return try self.parseAsyncCall(func)
		end 'async'

		if self.at(TokenKind.await) 'await'
			let awaitTok = try self.consume(TokenKind.await)
			let promise = try self.parseUnary(func)
			return try self.emitAwait(func, promise: promise, awaitTok: awaitTok)
		end 'await'

		return try self.parsePostfix(func, value: try self.parsePrimary(func), resultUsed: true)
	end 'parseUnary'

	// A primary followed by any trailing INDIRECT CALL `(args)` through a function VALUE (P1.5-A1). This
	// is the ONE place a trailing `(` on a function value becomes an indirect call, which is what makes
	// every producer of a function value callable UNIFORMLY: a local (`f(21)`), a call result
	// (`pick()(21)`), and a field read (`h.op(21)`, `o.inner.op(21)`, `self.op(x)`) all reach here holding
	// a `function`-tagged value, and the trailing `(` is applied the same way regardless of how the value
	// was produced. It also chains — `pick()(2)` or a curried `g(1)(2)` — because an indirect call's
	// result is itself a value the loop re-examines.
	//
	// ⚠ The `as`-CAST is NOT handled here — it is a LOOSER operator than unary `-` (see `parseCast`), so
	// `-5 as Age` is `(-5) as Age`. An indirect call, by contrast, binds TIGHTER than `-` (`-f()` is
	// `-(f())`), which is why it stays in this postfix band and the cast does not.
	//
	// `resultUsed` is whether this postfix chain's FINAL value is read — `false` only for a bare-call
	// STATEMENT (`callStmt`), `true` in every expression. It gates ONLY a VOID indirect-call/array-method
	// result: a void result is always TERMINAL (the loop continues only on a `function`/`Array` value, and
	// void is neither), so the outer `resultUsed` is exactly the one the terminal call sees, and forwarding
	// it uniformly to every hop is correct — an intermediate hop's value is never void.
	function parsePostfix(func IrFunction, value ValueId, resultUsed bool) returns ValueId throws ParseError
		var current = value
		while true 'postfix'
			// A trailing `(` on a FUNCTION value is an indirect call; on anything else it is not a postfix
			// operator at all and the loop ends (a `(` after a non-function value is left for the caller,
			// which is a syntax error there — calling a non-function).
			if self.at(TokenKind.leftParen) and self.tagOf(current) == ValueTypeTag.function 'indirectCall'
				current = try self.parseIndirectCall(func, callee: current, resultUsed: resultUsed)
				continue
			end 'indirectCall'

			// A `.method(…)` on an array-typed VALUE — a method on a fresh literal (`[10,20,30].get(0)`) or any
			// array-valued expression, dispatched to the array runtime (P1.7 slice 1). Keyed on the value being
			// an `Array` instance; a non-array `.method` in postfix position is left for the caller exactly as
			// before (a plain struct's method call reaches the binding path, not this loop).
			if self.at(TokenKind.dot) and self.tagOf(current) == ValueTypeTag.genericInstance and self.signatures.isArrayInstance(self.valueNameId(current)) 'arrayMethod'
				// A postfix receiver is a VALUE the expression just built — a literal, a call result, a
				// slice — so there is no binding for an iteration lock to name (the field-chain door is
				// the one that has one, and it passes it).
				current = try self.parseArrayMethodOnValue(func, arr: current, giid: self.valueNameId(current), resultUsed: resultUsed, immutableReceiverName: EmptySourceText, borrowSubjectName: EmptySourceText)
				continue
			end 'arrayMethod'

			// A `.method(…)` on a CONSTRAINED TYPE-PARAMETER value (P1.7a slice 2a) — `self.item.digest()` where
			// `item` is a `T` value and `T` is constrained `where T is Digest`. The concrete type is unknown in the
			// shared body, so it dispatches through the runtime witness (`witnessDispatch`), NOT a direct call.
			if self.at(TokenKind.dot) and self.tagOf(current) == ValueTypeTag.typeParameter 'witnessMethod'
				current = try self.parseWitnessMethodOnValue(func, receiver: current, resultUsed: resultUsed)
				continue
			end 'witnessMethod'

			// A `.method(…)` on a value with a BUILTIN CONFORMANCE (P1.7a direct dispatch) —
			// `a.get().compare(b.get())`, where the receiver of `.compare` is the `Integer` a prior call
			// RETURNED and so is no binding at all. Keyed on the value's conformer, the same classifier the
			// binding path matches on, so both spellings dispatch the identical impl. It chains like every
			// other hop (`i.hash().hash()` is legal — a `HashValue` is an `int`), which is why it rebinds the
			// cursor and continues rather than returning.
			if self.at(TokenKind.dot) and isBuiltinConformer(self.builtinConformerOfValue(current)) 'builtinConformanceMethod'
				current = try self.parseBuiltinConformanceMethodOnValue(func, receiver: current)
				continue
			end 'builtinConformanceMethod'

			break
		end 'postfix'
		return current
	end 'parsePostfix'

	// Apply one `as <targetType>` cast to `value` (P1.9). Four shapes, decided by the source value's
	// domain and the target's:
	//   • int → float  — emit `promoteToFloat` (`cvtsi2sd`); the value BECOMES a float. This is the
	//     conversion the old no-op `as` skipped (`explicit-cast-int-to-float`).
	//   • float → int  — emit `trunc` (`cvttsd2si`), the truncating bridge out of the float domain.
	//   • same representation (int→int, float→float) — the value flows on UNCHANGED, keeping its own tag,
	//     UNLESS the target type says something the source's tag does not. Then the cast MINTS a distinct
	//     value carrying the target type (`emitRetaggedCastValue`) — see the two predicates below for
	//     exactly when, and the paragraph after this one for why "unchanged" was a wrong answer.
	//     The value's alias name is what a narrowing check needs, and it rides the recorded site rather
	//     than the tag: when the target is a ranged alias that site is recorded so `InsertRangeChecks`
	//     guards / E3005s it.
	//
	//     ⚠ **A RE-TAG CANNOT BE DONE IN PLACE, AND THAT IS MEASURED, NOT ASSUMED.** `let w = x as Word`
	//     leaves `w` and `x` naming ONE SSA value under two declared types (M2 binds a name to a value
	//     and emits no load), so re-recording that value's tag would make `x` unsigned too. Against the
	//     bootstrap oracle, `(w shr 62) + (x shr 62)` of `0xC000000000000000` is `3 + -1`; an in-place
	//     re-tag answers `3 + 3` and a dropped tag `-1 + -1`. Only a DISTINCT value gives both halves
	//     their own answer, which is why this mints one exactly as the per-instance cast already did.
	//
	//     ⚠ **WHAT USED TO BE HERE, AND WHY EACH REASON FELL.** The no-op justified itself by (1) a
	//     `named` value TYPE reaching `lowerMaxonToStd` unresolved and (2) codegen stability. (1) named a
	//     closure capture as its route, which `fieldStorageType` closed for env slots; and it does not
	//     apply to a re-tag at all — a value's TAG is `named` all the time (a `Word` parameter, a
	//     `Word`-returning call result), and `valueTagToStdType` collapses `named` to i64 without help.
	//     Only an OP's stored type reaches `maxonTypeToStdType`, and this mints no op that carries one.
	//     (2) is kept, and it is what the two predicates are for: a cast whose target answers every
	//     question the tag column decides exactly as the source's own type does is still the no-op it
	//     was, byte for byte.
	function applyCast(value ValueId, targetType MaxonType, asTok Token) returns ValueId throws ParseError
		// ⭐ REJECT A FUNDAMENTALLY-INCOMPATIBLE KIND CAST FIRST (E3009), before any conversion is chosen. A
		// managed aggregate (String/struct/function) has no conversion to or from a scalar, nor to a
		// DIFFERENT aggregate; letting such a cast reach the float/no-op branches below would emit a
		// `promoteToFloat` or a range check on a POINTER, or leave a mismatched drop (a String drop run on a
		// struct box — a double free). See `castHasNoLegalConversion` and `ParseError.invalidCast`.
		let sourceTag = self.tagOf(value)
		let targetTag = try self.castTargetTag(targetType, asTok: asTok)
		try self.requireCastKindsConvert(sourceTag, targetTag: targetTag, asTok: asTok)

		let sourceIsFloat = tagIsFloat(self.tagOf(value))
		let targetIsFloat = self.typeIsFloatDomain(targetType)

		if sourceIsFloat and not targetIsFloat 'floatToInt'
			// The trunc RESULT is the narrowed integer, so it — not the float source — is what a ranged INT
			// target checks (`500.7 as Byte` guards `500`). The result has its own Std op, but the guard still
			// anchors at the cast's BLOCK (below) for the same reason an int->int cast does.
			let narrowed = self.emitUnaryOp(value, op: MaxonUnaryOp.trunc, resultTag: ValueTypeTag.integer, opTok: asTok)
			self.recordCastSite(narrowed, targetAlias: self.declaredAliasOfType(targetType), asTok: asTok)
			return narrowed
		end 'floatToInt'

		if not sourceIsFloat and targetIsFloat 'intToFloat'
			return self.promoteToFloat(value, opTok: asTok)
		end 'intToFloat'

		// The target's ranged-alias declaration, resolved ONCE. Both questions below need it — WHICH
		// alias a narrowing check names, and WHAT ITS RANGE says about the shift fill — and each used to
		// re-ask `signatures.aliasOf` for itself.
		let targetAlias = self.declaredAliasOfType(targetType)

		// ⚠ **THE RANGE-CHECK SITE IS THE SOURCE, NOT THE MINTED RESULT, AND THAT IS A CORRECTNESS
		// REQUIREMENT** — which is why it is recorded HERE, once, above a branch whose two arms both
		// anchor on the same value. The source and the mint hold the same number by construction, so
		// either would guard correctly at RUN time; but `InsertRangeChecks` decides COMPILE-TIME E3005
		// versus a runtime guard by looking the site's value up in a map built from Std `const` ops (plus
		// `neg` of one). A constant that arrived through the mint's `add` is in neither, so anchoring on
		// the result would silently downgrade `3 as Big` from a diagnostic to a guard that fires at run
		// time — `ranged-typealias.error.unsigned-max-upper-literal-out-of-range` is the case that says
		// so. The float→int cast above anchors on its RESULT for the opposite reason, stated there:
		// `trunc` changes the number, so the source is not the value being checked.
		self.recordCastSite(value, targetAlias: targetAlias, asTok: asTok)

		// ⭐ **A CAST THAT CHANGES WHAT THE VALUE'S TYPE SAYS IS A CONVERSION, NOT A RE-TAG.** It yields a
		// DISTINCT result value of the target type and leaves the SOURCE untouched, because the source
		// binding stays usable under its own identity: `let b = aTag as WB.Idx` must not corrupt `aTag`
		// (still `WA.Idx`), and `let w = x as Word` must not make `x` unsigned. TWO things a target can
		// say, and each has its own predicate rather than one blurred test — a nominal IDENTITY (P1.6-C)
		// and a SHIFT FILL — because they are answered from different registries and neither implies the
		// other. Everything else is the representational no-op below, with no new value and no new op.
		if self.castConvertsPerInstance(value, targetType: targetType) or self.castChangesTheShiftFill(value, targetAlias: targetAlias) 'retaggingCast'
			return self.emitRetaggedCastValue(value, targetType: targetType, asTok: asTok)
		end 'retaggingCast'

		return value
	end 'applyCast'

	// ⭐ **THE CAST TARGET'S KIND AS THE AUTHORITY DENOTES IT — not as `maxonTypeTag` reads the
	// SPELLING.** `parseTypeReference` answers a handful of type spellings syntactically (`Self`, the
	// enclosing type's own name, `String`, a type parameter, a generic-instance alias, a function
	// alias) and hands back a bare `MaxonType.named` for everything else — a declared `type` named
	// from OUTSIDE its own body, a declared enum/union, a ranged typealias, a qualified inner alias,
	// and a name nothing declares at all. `maxonTypeTag` reads all five as one tag, so the legality
	// gate was asking about a NAME, and its answer for a name that denotes nothing was the same as
	// for a ranged int alias: convert nothing, flow the value on. `5 as CompletelyMadeUpNameXyz`
	// compiled and returned 5; so did `5 as Point`, which `applyCast`'s own header claims to reject.
	//
	// `denotedNamedType` is THE list of the sources a named type can come from — the same list whose
	// `unknown` verdict is `TypeResolution`'s E3011 — so a cast site and the resolution pass cannot
	// come to disagree about what a name means. There is deliberately no second cascade here.
	//
	// ⚠ **THE RESOLVED TYPE IS FOR THIS GATE ONLY and is NOT substituted for `targetType`.** The
	// conversion below still reads the `named` type, because that is what carries the alias NAME a
	// narrowing check records (`recordCastSite`) and the nominal identity a per-instance cast stamps
	// (`castConvertsPerInstance`). Erasing it here would silently drop both — the erasure is the
	// SIGNATURE's, not the cast's.
	function castTargetTag(targetType MaxonType, asTok Token) returns ValueTypeTag throws ParseError
		let spelledTag = maxonTypeTag(targetType)
		if spelledTag != ValueTypeTag.named 'alreadyConcrete'
			return spelledTag
		end 'alreadyConcrete'

		let nameId = typeNameIdOf(targetType)
		return try self.denotedCastTargetTag(self.internedName(nameId), id: nameId, asTok: asTok)
	end 'castTargetTag'

	// The KIND a NAMED cast target denotes, or E3011 anchored on the `as` — the half of the cast-target
	// decision that ASKS THE AUTHORITY. It is a function and not four lines at each site because BOTH
	// cast sites ask it (`castTargetTag` for a body cast, `requireConstCastTargetKind` for a top-level
	// `let`'s), and a name that denotes nothing must reach the same code with the same wording at the
	// same anchor whichever site met it.
	function denotedCastTargetTag(name ByteArray, id TypeNameId, asTok Token) returns ValueTypeTag throws ParseError
		let denoted = try denotedNamedType(self.signatures, name: name, id: id) otherwise 'undeclared'
			throw ParseError.unknownCastTargetType(String.from(name), line: asTok.line, column: asTok.column)
		end 'undeclared'

		return maxonTypeTag(denoted)
	end 'denotedCastTargetTag'

	// May a `sourceTag` value BECOME a `targetTag` one (E3009) — the other half of the cast-target
	// decision, and shared for a sharper reason than tidiness. Sharing `denotedNamedType` alone would
	// have left the two sites agreeing on what a name MEANS while each kept its own copy of what to DO
	// about the answer: the rule, the wording and the anchor, in a `named` arm and a `ConstValue` arm
	// that nothing makes agree. A clause added to one would then be a WRONG ANSWER at the other — a
	// `let X = 5 as T` accepted where `x as T` is refused — and not a compile error anywhere. Mirrors
	// `requireConstOperands`, which is this file's existing answer to the identical split.
	function requireCastKindsConvert(sourceTag ValueTypeTag, targetTag ValueTypeTag, asTok Token) throws ParseError
		if castHasNoLegalConversion(sourceTag, target: targetTag) 'incompatibleKinds'
			throw ParseError.invalidCast(typeTagName(sourceTag), targetType: typeTagName(targetTag), line: asTok.line, column: asTok.column)
		end 'incompatibleKinds'
	end 'requireCastKindsConvert'

	// Does this int→int `as` convert per-instance identity (P1.6-C) — either STAMPING a per-instance target
	// onto the result (`x as StrWrapper.Idx`) or STRIPPING a per-instance source into a plain target
	// (`idx as ExitCode`)? Only then does the cast mint a distinct value; a plain-to-plain `as` stays a no-op.
	function castConvertsPerInstance(value ValueId, targetType MaxonType) returns bool
		if maxonTypeTag(targetType) == ValueTypeTag.named and self.signatures.isPerInstanceAlias(self.internedName(typeNameIdOf(targetType))) 'stampTarget'
			return true
		end 'stampTarget'
		return self.tagOf(value) == ValueTypeTag.named and self.signatures.isPerInstanceAlias(self.internedName(self.valueNameId(value)))
	end 'castConvertsPerInstance'

	// ⭐ **DOES THIS int→int `as` CHANGE HOW A RIGHT SHIFT OF THE VALUE FILLS?** The shift rule reads the
	// value's TAG (`valueIsUnsigned`), so a cast that drops the target alias drops the SIGNEDNESS with it —
	// MEASURED against the bootstrap oracle, `let w = x as Word` (`Word = int(0 to u64.max)`) then
	// `w shr 62` of `0xC000000000000000` answered **-1 here and 3 there**, and the other direction
	// (an unsigned parameter cast to a signed alias) answered **3 here and -1 there**. A silent wrong
	// answer, in the one place no diagnostic can catch it.
	//
	// ⭐ **THE FILL IS THE ONLY ANSWER THAT CAN MOVE INSIDE THIS GATE, AND THAT IS WHY THE GATE IS A
	// DECLARED RANGED ALIAS AND NOTHING ELSE.** A value's tag also picks its DROP routing
	// (`decrefCalleeFor`), its builtin-conformance dispatch (`builtinConformerOfType`) and its float
	// register class — so a broader "always re-tag" would be a different change with a different blast
	// radius. Inside the gate all three are provably fixed: a ranged INT alias is unmanaged (its name is
	// an alias, never an enum/union — `resolveNamedAlias`'s header states a name is one of those, never
	// two — so `valueIsBoxedUnion` cannot start answering `true`), it reduces to `integer` for the
	// conformer exactly as a bare `int` does, and it is not float (a float alias is refused below, since
	// its bounds are f64 BIT PATTERNS that the integer range predicates would read as signed integers).
	// A target OUTSIDE the gate is left alone for the same reason it always was — a `structRef` target
	// would re-point a drop at another type's destructor, and `ExitCode` would trade a fill that cannot
	// differ (see the observability rule below) for a conformer it does not have (`notAConformer`).
	//
	// ⭐ **AND IT ASKS WHETHER THE FILL CAN BE OBSERVED, NOT MERELY WHETHER THE SIGNEDNESS DIFFERS.** An
	// arithmetic and a logical shift differ only on an operand whose bit 63 is set, so a target whose
	// range cannot hold such a value answers the same under either reading — `bitwise-operators.md` says
	// exactly this ("a value of `int(0 to 100)` is provably non-negative, so an arithmetic and a logical
	// shift of it agree bit for bit"), and the cast is guarded INTO that range by the site
	// `recordCastSite` records, so the premise is enforced rather than hoped for. That is what keeps
	// `x as Byte`, `x as Age` and `x as U32` the byte-for-byte no-ops they have always been while
	// `x as Word` is not.
	//
	// It is handed the ALREADY-RESOLVED alias (`declaredAliasOfType`) rather than the target type: the
	// narrowing-check site needs the identical resolution, and `applyCast` is where the two meet.
	function castChangesTheShiftFill(value ValueId, targetAlias DeclaredAlias) returns bool
		return match targetAlias 'a'
			declared(alias) gives self.aliasChangesTheShiftFill(value, alias: alias)
			// Not a declared ranged alias — `ExitCode`, a bare primitive, a struct, a name nothing
			// declares. Nothing the tag column would read differently, so the cast stays the no-op.
			undeclared gives false
		end 'a'
	end 'castChangesTheShiftFill'

	// The half of the question above that is about the ALIAS. Split out because the two arms below read
	// as the two sentences they are.
	function aliasChangesTheShiftFill(value ValueId, alias RangedTypeAlias) returns bool
		if maxonTypeTag(alias.underlying) == ValueTypeTag.float 'floatAlias'
			return false
		end 'floatAlias'

		if not rangeIsUnsigned(alias.low) 'targetIsSigned'
			// A signed range admits negatives, so bit 63 is reachable and the two fills genuinely differ.
			// The cast is load-bearing exactly when the source reads UNSIGNED and the target does not.
			return self.valueIsUnsigned(value)
		end 'targetIsSigned'

		// The target is unsigned. A signed source can only be told apart from it by a bit-63-set value,
		// which an unsigned range admits ONLY in the `u64.max`-upper shape — the same shape the runtime
		// cascade and the compile-time literal check both key on, asked here through the same predicate
		// so a fourth reading of it cannot appear.
		return not self.valueIsUnsigned(value) and rangeIsUnsignedMaxUpper(alias.low, high: alias.high)
	end 'aliasChangesTheShiftFill'

	// ⭐ **EMIT A REPRESENTATIONALLY-NO-OP CAST AS A DISTINCT VALUE.** The conversion moves no bits
	// (int→int), so its RESULT is `value + 0` — one op, minted with a FRESH ValueId typed as the target —
	// which leaves the source ValueId's identity untouched (an in-place re-tag would corrupt `aTag` when a
	// later use reads it as `WA.Idx`, and would make `x` unsigned after `let w = x as Word`). ONE emitter
	// for both reasons a cast mints: a per-instance IDENTITY and a changed SHIFT FILL. Both directions of
	// the per-instance case ride it — STAMP (`x as StrWrapper.Idx`, result typed the per-instance alias,
	// sidestepping the bootstrap's E3010 "unneeded cast" quirk) and STRIP (`idx as ExitCode`, result the
	// plain target, so a per-instance Idx decays to the numeric it is). `foldConstOperands` folds the op
	// to a single `binOpImm add 0`.
	//
	// ⚠ **IT RECORDS NO RANGE-CHECK SITE, AND THAT IS DELIBERATE.** The site is the SOURCE, not this
	// mint, so `applyCast` records it above the branch — see the ⚠ there for why anchoring on the result
	// would downgrade `3 as Big` from an E3005 to a runtime guard.
	//
	// ⚠ **THE PARSER'S CONSTANT VIEW CROSSES THE MINT**, and that is not an optimization either. `x + 0`
	// is `x`, so a constant source names a constant result — and the parser's const table is what turns a
	// shift COUNT into a compile-time decision (`emitShift` rejects a negative count and folds an
	// over-wide one, both guarded on `constIsKnown`). Without this, `a shl (0 - 1 as Word)` would trade
	// its diagnostic for a runtime guard purely because the cast started minting. `recordFold` is what
	// `emitBinOp` does with the same `+`, so the two agree on what a folded `add` knows.
	//
	// ⚠ The base-range compatibility check the spec names (`fooIdx as BarContainer.Idx` requires the SAME
	// low/high) is inert at this rung — every inner alias is `int(0 to u64.max)` — and its diagnostic form is
	// deferred with the first narrower inner range.
	function emitRetaggedCastValue(value ValueId, targetType MaxonType, asTok Token) returns ValueId
		let result = self.mintValueOfType(targetType)
		let zero = self.emitLiteral(0, valueType: MaxonType.integer, range: SourceRange.ofToken(asTok))
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.binOp(result, lhs: value, rhs: zero, op: MaxonBinOp.add), range: SourceRange.ofToken(asTok))

		if self.constIsKnown(value) 'constantSource'
			self.recordConst(result, folded: self.constOf(value))
		end 'constantSource'

		return result
	end 'emitRetaggedCastValue'

	// Record a narrowing-check site for `value` when the cast's target is a ranged alias, integer or
	// float (P1.9, and #19 for the float half). `block` is the CAST'S evaluation block
	// (`self.currentBlock`), so the guard runs on the path the cast is on — an unselected ternary arm /
	// if-branch does not fire it.
	//
	// It takes the RESOLVED alias rather than the target type because every caller already holds one:
	// `applyCast`'s shift-fill predicate asks the identical question of the identical type, and
	// `signatures.aliasOf` allocates per call. `undeclared` — `ExitCode`, a bare primitive, a name
	// nothing declares — records nothing.
	function recordCastSite(value ValueId, targetAlias DeclaredAlias, asTok Token)
		match targetAlias 'a'
			declared(alias) then self.rangeCheckCastSites.push(RangeCheckCastSite.create(value, aliasName: alias.name, block: self.currentBlock.id, line: asTok.line, column: asTok.column))
			undeclared then break 'a'
		end 'a'
	end 'recordCastSite'

	// Is `t` in the FLOAT domain — the bare `float` keyword, or a `named` type that denotes a ranged
	// float alias? Everything else (bare int, an int alias, `ExitCode`, a struct/String/function) is
	// the integer/pointer domain. Exhaustive over `ValueTypeTag`, so a new tag cannot slip through as a
	// silent `false`. `namedIsFloatAlias` is asked only on the `named` arm, where its interner
	// precondition holds.
	function typeIsFloatDomain(t MaxonType) returns bool
		return match maxonTypeTag(t) 'k'
			boolean to integer gives false
			float gives true
			named gives self.namedIsFloatAlias(typeNameIdOf(t))
			// `exitCode to genericInstance` extends the old `exitCode to function` past the P1.6-A tail:
			// a type parameter is an opaque i64 and a generic instance is a struct pointer, neither in the
			// float domain.
			exitCode to genericInstance gives false
		end 'k'
	end 'typeIsFloatDomain'

	// Append a `binOp` op combining two SSA values; return the ValueId it defines. The
	// result's TYPE is the operator's: arithmetic and shifts are integer; `and`/`or`/`xor`
	// follow their operands (see `wordOpResultTag`) — the ONE place a bitwise op's result
	// could be a bool, which is what `consume(f.a or f.b)` against a `bool` parameter needs.
	// The source range anchors on the operator token (the conventional binop anchor).
	function emitBinOp(lhs ValueId, rhs ValueId, op MaxonBinOp, opTok Token) returns ValueId throws ParseError
		let leftTag = self.tagOf(lhs)
		let rightTag = self.tagOf(rhs)
		try requireBinOpOperands(op, left: leftTag, right: rightTag, opTok: opTok)

		let resultTag = binOpResultTag(op, left: leftTag, right: rightTag)

		// ⭐ **NUMERIC PROMOTION, PAID FOR.** `TypeRules.arithResultTag` answering `float` is a
		// PROMISE that both operands are already in the float domain, and this is the one place
		// it is kept: an i64 in a GPR is not an f64 in an XMM, and `addsd` cannot read one. It
		// happens HERE, in the parser, because this is the last tier that knows each operand's
		// source type — by the Std tier `operandType` is a single answer for the whole op, and
		// there is no longer a mixed pair to see.
		let left = self.promotedOperand(lhs, left: leftTag, right: rightTag, opTok: opTok)
		let right = self.promotedOperand(rhs, left: leftTag, right: rightTag, opTok: opTok)

		let result = self.mintValue(resultTag, nameId: UnnamedTypeId)
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.binOp(result, lhs: left, rhs: right, op: op), range: SourceRange.ofToken(opTok))

		// Fold, when the parser holds both operands — so `x shl 63 + 1` is a count of 64 and not an
		// unknown. RECORDED, not rewritten: this compiler emits the `add` either way (see
		// FoldConstOperands' header on why `foldConstants` is deferred).
		//
		// It reads the ORIGINAL ids, not the promoted ones, and it cannot confuse the two: the
		// gate is `tagIsInteger(resultTag)`, and a promotion happens only when the result is a
		// float — so on every path that folds, `left`/`right` ARE `lhs`/`rhs`.
		if tagIsInteger(resultTag) and self.constIsKnown(lhs) and self.constIsKnown(rhs) 'bothKnown'
			self.recordFold(result, fold: foldIntBinOp(op, lhs: self.constOf(lhs), rhs: self.constOf(rhs)))
		end 'bothKnown'

		return result
	end 'emitBinOp'

	// One operand of a binary op or comparison, moved into the float domain if the PAIR meets
	// there. Takes both tags because promotion is a property of the pair, not of the operand —
	// `5` stays an int in `5 + 3` and becomes an f64 in `5 + 2.0`, and only the other side says
	// which.
	//
	// Both operands go through it unconditionally, and `promoteToFloat` is idempotent, so the
	// already-float side costs nothing and no caller has to work out which side to convert.
	function promotedOperand(value ValueId, left ValueTypeTag, right ValueTypeTag, opTok Token) returns ValueId
		if not operandsAreFloat(left, right: right) 'integral'
			return value
		end 'integral'

		return self.promoteToFloat(value, opTok: opTok)
	end 'promotedOperand'

	// Move a value into the float domain — the int→f64 half of the implicit-conversion lattice.
	// `TypeRules.arithResultTag` states the TYPE rule; this emits the INSTRUCTION that makes it
	// true (`cvtsi2sd`, via `MaxonUnaryOp.promoteToFloat`).
	//
	// A value already there is returned untouched, which is what makes it idempotent — and it is
	// also what keeps `siToFp` from ever naming a float→float conversion (`lowerUnaryOp`'s
	// `assertConversionCrossesDomain` is the backstop that says so).
	//
	// Ported from v1's `promoteToFloat` (LowerMaxonToStd.maxon:3459). ONE divergence, and it is
	// the reason shv2 has one type oracle instead of two: v1 promotes during LOWERING, off an
	// `isFloat` side-map it maintains there because by then the source types are gone. shv2
	// promotes in the PARSER, off the `valueTags` column it already keeps for the word operators.
	// Same op, same place in the value graph, one fewer table.
	function promoteToFloat(value ValueId, opTok Token) returns ValueId
		if tagIsFloat(self.tagOf(value)) 'alreadyFloat'
			return value
		end 'alreadyFloat'

		return self.emitUnaryOp(value, op: MaxonUnaryOp.promoteToFloat, resultTag: ValueTypeTag.float, opTok: opTok)
	end 'promoteToFloat'

	// ⭐ **FLOAT NEGATION IS A SUBTRACT FROM ZERO**, and that is a PORT, not a shortcut — v1 says
	// the same of its own parser ("Float negation is normally lowered by the parser as `0.0 - x`",
	// LowerMaxonToStd.maxon:5964).
	//
	// x64 has NO `neg` for an XMM register. The hardware spelling of a sign flip is `xorpd`
	// against a sign-bit mask that has to be materialized in rdata — a new opcode, a new constant,
	// and a new relocation — whereas `subsd` is already in the band this rung landed. So `-x`
	// costs nothing new, and `MaxonUnaryOp.neg` stays what it has always been: the INTEGER negate.
	//
	// ⚠ It differs from a true negation on exactly one input, and it is worth naming rather than
	// discovering: `0.0 - (+0.0)` is `+0.0`, where `-(+0.0)` is `-0.0`. Nothing in the language
	// can yet observe a zero's sign — that needs `print`, which is P1.2's — and v1 has shipped
	// this trade for its whole life. `0.0 - nan` is `nan`, so the unordered case is unaffected.
	function emitFloatNegation(operand ValueId, opTok Token) returns ValueId throws ParseError
		let zero = self.emitLiteral(FloatZeroBits, valueType: MaxonType.float, range: SourceRange.ofToken(opTok))
		return try self.emitBinOp(zero, rhs: operand, op: MaxonBinOp.sub, opTok: opTok)
	end 'emitFloatNegation'

	// Append a `unaryOp` op over one SSA value; return the ValueId it defines. The source
	// range anchors on the operator token, mirroring emitBinOp.
	function emitUnaryOp(operand ValueId, op MaxonUnaryOp, resultTag ValueTypeTag, opTok Token) returns ValueId
		let result = self.mintValue(resultTag, nameId: UnnamedTypeId)
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.unaryOp(result, operand: operand, op: op), range: SourceRange.ofToken(opTok))

		// `-1` is `neg` of the literal 1, not a negative literal — so without this arm the parser
		// could not see the count in `x shl -1` at all.
		if tagIsInteger(resultTag) and self.constIsKnown(operand) 'known'
			self.recordFold(result, fold: foldIntUnaryOp(op, operand: self.constOf(operand)))
		end 'known'

		return result
	end 'emitUnaryOp'

	// Append a `compare` op over two SSA values; return the BOOLEAN ValueId it defines.
	// Mirrors emitBinOp but emits the distinct comparison variant (a comparison is not a
	// `binOp` — see MaxonCmpOp). The source range anchors on the comparison operator.
	//
	// A comparison is STRICT IN BOTH ITS CLASS AND ITS DOMAIN — `TypeRules.comparableOperands`,
	// which is a third question and not `typesAgree`. Two bools compare fine (`a == b`); two ints
	// compare; two floats compare. A MIXTURE does not, in either of the two ways a pair can be
	// mixed:
	//
	//   • a bool against a number — the only thing there is to compare is the bool's 0/1 payload,
	//     which is not what the source wrote: `4 < flag` is `4 < 1`, i.e. always false. v1 states
	//     the identical rule at TypeResolution.maxon:2726 ("Comparisons are category-strict: both
	//     sides must land in the same CastCategory").
	//
	//   • ⭐ an int against a FLOAT — and this one is the rule that ARITHMETIC does not share.
	//     `5 + 2.0` promotes and is 7.0; `f > i` is E3005 (specs/contextual-literal-typing.md,
	//     four cases). A promotion inside a comparison would be INVISIBLE — the result is a bool
	//     either way, so nothing in the program would show that the int had been converted, and
	//     `3.5 > i` would silently answer a question about `3.5 > 2.0` nobody asked.
	//
	// ⚠ THIS FUNCTION ONCE PROMOTED, and that is exactly the bug P1.0d.4 shipped and then fixed:
	// the promotion built for `emitBinOp` was routed through here too, because a compare's
	// operands looked like a binOp's. They are not: one produces a number, the other a verdict.
	function emitCompare(lhs ValueId, rhs ValueId, op MaxonCmpOp, opTok Token) returns ValueId throws ParseError
		let leftTag = self.tagOf(lhs)
		let rightTag = self.tagOf(rhs)

		// ⭐ STRING `==`/`!=` IS A RUNTIME BYTE COMPARE, not a `compare` op (which would compare two box
		// POINTERS — reference equality answering a question about VALUES). Handled at the TOP, before
		// `comparableOperands`: two strings do NOT `comparableOperands` (that rule governs ORDERING,
		// which strings have none of), so a both-`string` pair must be intercepted here or it would be
		// rejected as a mismatch. A string-vs-non-string pair is NOT both-`string`, so it falls through
		// to the mismatch gate below — a clean type error, not a crash.
		if tagIsText(leftTag) and tagIsText(rightTag) 'stringCompare'
			return try self.emitStringCompare(lhs, rhs: rhs, op: op, opTok: opTok)
		end 'stringCompare'

		// ⭐ A `union` VALUE HAS NO COMPARISON — of ANY kind (E3066). Refused BEFORE `comparableOperands`,
		// which would pass a `named`-vs-`named` pair (they agree) and lower to a compare of two BOX
		// ADDRESSES — the same reference-equality wrong answer that rule already refuses for two structs.
		// `==`/`!=` have no synthesized equality; `<`/`>`/`<=`/`>=` a fortiori have no meaning either, so
		// ALL of them reject here (the message names whichever operator the author wrote). An ENUM's value
		// IS its i64 tag, so `Color.red == c` is a real tag compare and stays legal; only a `union`
		// (`isUnion`) is rejected. The match dispatch (`emitDispatchCompare`) builds its tag compare with
		// its own `MaxonOp.compare` and never routes through here, so a `match` arm is unaffected.
		if self.valueIsUnion(lhs) or self.valueIsUnion(rhs) 'unionCompare'
			throw ParseError.unionNotComparable(comparisonOpSpelling(op), line: opTok.line, column: opTok.column)
		end 'unionCompare'

		// ⭐ **EVERY COMPARISON ON AN ENCLOSING (opaque) TYPE PARAMETER dispatches through a witness** — `==`/`!=`
		// through `Equatable.equals` (P1.7a slice 2b), `<`/`>`/`<=`/`>=` through `Comparable.compare` (slice
		// 2b-ii) — the SAME tables `<T>.equals()` / `<T>.compare()` use. Inside the shared body `T`'s concrete
		// type is unknown, so a scalar `compare` would compare two opaque WORDS: right for an `int` by luck, a
		// POINTER compare for a struct `T` (a silent wrong answer). An UNCONSTRAINED enclosing `T` has no witness
		// and is E3005.
		//
		// ⚠ ALL SIX operators are gated, and the ordering half is why: until slice 2b-ii, `<` on a type parameter
		// fell straight past here to the raw `MaxonOp.compare` below, because `typeClassesAgree` lets a
		// `typeParameter` agree with anything (TypeRules) — the same pointer-compare wrong answer the equality
		// half already refused, reachable the moment anything could conform to `Comparable`.
		// ⚠ Only a value of an ENCLOSING type parameter opts in: a `typeParameter`-tagged value in a NON-generic
		// caller is a concrete generic-method result (`let v = intBox.get()`) whose real type IS known (`int`) —
		// it must stay a scalar compare (`isEnclosingTypeParam` is false there, so it falls through to
		// `comparableOperands`).
		if self.isEnclosingTypeParam(lhs) or self.isEnclosingTypeParam(rhs) 'typeParamComparison'
			return try self.emitTypeParamComparison(lhs, rhs: rhs, op: op, opTok: opTok, leftIsParam: self.isEnclosingTypeParam(lhs))
		end 'typeParamComparison'

		if not comparableOperands(leftTag, right: rightTag) 'mismatch'
			throw ParseError.comparisonTypeMismatch(typeTagName(leftTag), right: typeTagName(rightTag), line: opTok.line, column: opTok.column)
		end 'mismatch'

		let result = self.mintValue(ValueTypeTag.boolean, nameId: UnnamedTypeId)
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.compare(result, lhs: lhs, rhs: rhs, op: op), range: SourceRange.ofToken(opTok))
		return result
	end 'emitCompare'

	// The two String comparisons — the ONLY operators String has. `==` is the `__str_eq` runtime call
	// (content equality: equal lengths, then equal bytes); `!=` is its logical negation, built from the
	// same call so the two can never disagree about what equality means. ORDERING (`<`/`>`/`<=`/`>=`)
	// has no meaning on a byte record and is rejected — the bootstrap rejects it identically.
	function emitStringCompare(lhs ValueId, rhs ValueId, op MaxonCmpOp, opTok Token) returns ValueId throws ParseError
		match op 'op'
			eq then return self.emitStrEqCall(lhs, rhs: rhs, opTok: opTok)
			ne then return self.emitUnaryOp(self.emitStrEqCall(lhs, rhs: rhs, opTok: opTok), op: MaxonUnaryOp.logicalNot, resultTag: ValueTypeTag.boolean, opTok: opTok)
			// `lt`/`gt`/`le`/`ge` — ordering on a String. Reported as a comparison type mismatch (there
			// is no ordering to fall through to), which is the acceptable existing diagnostic; a String
			// is orderable by no operator this rung provides.
			lt to ge then throw ParseError.comparisonTypeMismatch(typeTagName(ValueTypeTag.string), right: typeTagName(ValueTypeTag.string), line: opTok.line, column: opTok.column)
		end 'op'
	end 'emitStringCompare'

	// Is `v` a value of one of the ENCLOSING type's parameters (`self.item`, `other T` inside `type Box uses T`)
	// — a genuinely opaque `T`, NOT a concrete generic-method result that the parser happens to tag
	// `typeParameter` in a non-generic caller (P1.7a slice 2b)? The `typeParameter` value's name-id is its
	// parameter POSITION; it names an enclosing parameter iff that position is in range of `enclosingTypeParams`,
	// which is empty outside a generic body. The gate that keeps `==` a scalar compare for `let v = intBox.get();
	// v == 42` while making it a witness dispatch for `item == other` inside `Box`'s own body.
	function isEnclosingTypeParam(v ValueId) returns bool
		if self.tagOf(v) != ValueTypeTag.typeParameter 'notParam'
			return false
		end 'notParam'
		return self.valueNameId(v) < self.enclosingTypeParams.count()
	end 'isEnclosingTypeParam'

	// ⭐ **LOWER A COMPARISON ON A CONSTRAINED TYPE PARAMETER TO A WITNESS DISPATCH (P1.7a slice 2b / 2b-ii).**
	// ONE shape serves both operator families, because both are "dispatch one interface method through the
	// constraint's witness, then read a verdict off its result": `==`/`!=` dispatch `Equatable.equals` and take
	// (or negate) its bool; `<`/`>`/`<=`/`>=` dispatch `Comparable.compare` and test its `Ordering` against a
	// case tag. The receiver choice, the constraint search, the `Self`-argument check, the result typing and the
	// emit are therefore written ONCE, and only the (method, interface) pair and the verdict differ. The
	// dispatch shape is exactly what `parseWitnessMethodOnValue` builds for `<T>.equals(other)` /
	// `<T>.compare(other)`, so the operator form and the method form cannot come to mean different things.
	//
	// The `typeParameter` operand is the witness receiver. Equality is symmetric, so a `T`-vs-value mix may use
	// whichever side is the parameter; ORDERING IS NOT — `self.a < self.b` must dispatch on the LEFT operand —
	// and the shared `Self`-argument check is what guarantees it does: `compare`'s formal is `Self`, so an actual
	// that is not a value of the RECEIVER'S OWN parameter is rejected BEFORE anything is emitted. The emit is
	// therefore only ever reached with both operands values of the SAME enclosing parameter, where `leftIsParam`
	// holds and the receiver IS `lhs`; a `42 < self.item` never reaches it to be silently flipped into
	// `self.item > 42`, and neither does a `self.a < self.b` over two DIFFERENT parameters (see
	// `isReceiverTypeParamValue` — that second half was not true until a review probe segfaulted on it).
	function emitTypeParamComparison(lhs ValueId, rhs ValueId, op MaxonCmpOp, opTok Token, leftIsParam bool) returns ValueId throws ParseError
		let receiver = lhs if leftIsParam else rhs
		let other = rhs if leftIsParam else lhs
		let paramPos = self.valueNameId(receiver)
		let target = try self.requireOperatorWitness(paramPos, op: op, opTok: opTok)

		// The `other` operand fills the method's `Self`-typed formal, so it must be a value of the receiver's own
		// `T` — a concrete literal (`item == 42`, `item < 42`) would be marshalled into the `Self` pointer and
		// faulted. Same reject the method-call form runs, one shared helper.
		let args = pairArgs(receiver, second: other)
		try self.requireGenuineSelfArgs(target, args: args, what: comparisonOpSpelling(op), receiverParamPos: paramPos, errorTok: opTok)

		// Typed through the SAME witness-dispatch result typer the `.method()` form uses, so `equals`'s `bool`
		// and `compare`'s `Ordering` are minted here exactly as they are there (the `Ordering` result carries the
		// enum's `named` tag, which is what lets a `match` on a `compare()` result recognize it). Its void and
		// `Self` arms cannot fire for an operator: `Equatable`/`Comparable` each declare one value-returning
		// method, and `resultUsed` is true because a comparison is only ever parsed for its verdict.
		let dispatchResult = try self.mintWitnessDispatchResult(target, receiverParamPos: paramPos, methodTok: opTok, resultUsed: true)
		self.emitWitnessDispatch(dispatchResult, args: args, target: target, isVoid: false, range: SourceRange.ofToken(opTok), siteTok: opTok)

		// The verdict. `==` is the dispatch's own bool and `!=` negates that SAME dispatch, so the two can never
		// disagree about what equality means (the `emitStringCompare` shape); the four ordering operators read
		// the `Ordering` (below).
		match op 'verdict'
			eq then return dispatchResult
			ne then return self.emitUnaryOp(dispatchResult, op: MaxonUnaryOp.logicalNot, resultTag: ValueTypeTag.boolean, opTok: opTok)
			lt to ge then return self.emitOrderingVerdict(dispatchResult, op: op, opTok: opTok)
		end 'verdict'
	end 'emitTypeParamComparison'

	// The ordinal test that turns a `compare` dispatch's `Ordering` into an ordering operator's bool (P1.7a
	// slice 2b-ii). It reads the THREE-VALUED result: `<` is `lessThan` and `>` is `greaterThan`, while the
	// INCLUSIVE pair is the NEGATION of the strict opposite — `<=` is "not greaterThan", `>=` is "not lessThan"
	// — which is what makes `equalTo` satisfy both without a second compare, and is the bootstrap's mapping
	// (`2-Parser.cs:22293-22302`, the correct 3-valued reading).
	//
	// Every tag is read OFF the `Ordering` layout (`orderingTagOf`), never written as a literal; the layout is
	// fetched ONCE here rather than per arm. The compare itself is `emitDispatchCompare`, the SAME tag compare
	// an enum `match` arm emits — so `a < b` and a hand-written `match a.compare(b)` agree by construction.
	function emitOrderingVerdict(orderingResult ValueId, op MaxonCmpOp, opTok Token) returns ValueId
		let ordering = builtinOrderingEnum()
		let lessThanTag = orderingTagOf(ordering, caseName: OrderingLessThanCaseName)
		let greaterThanTag = orderingTagOf(ordering, caseName: OrderingGreaterThanCaseName)

		match op 'ordinal'
			eq to ne then panic("emitOrderingVerdict: `==`/`!=` are the equality verdict, handled by emitTypeParamComparison before it routes an ORDERING operator here")
			lt then return self.emitDispatchCompare(orderingResult, tag: lessThanTag, op: MaxonCmpOp.eq, opTok: opTok)
			gt then return self.emitDispatchCompare(orderingResult, tag: greaterThanTag, op: MaxonCmpOp.eq, opTok: opTok)
			le then return self.emitDispatchCompare(orderingResult, tag: greaterThanTag, op: MaxonCmpOp.ne, opTok: opTok)
			ge then return self.emitDispatchCompare(orderingResult, tag: lessThanTag, op: MaxonCmpOp.ne, opTok: opTok)
		end 'ordinal'
	end 'emitOrderingVerdict'

	// The witness a comparison operator on type parameter `paramPos` dispatches through (P1.7a slice 2b/2b-ii),
	// or E3005 when the parameter carries no constraint that PROVIDES THE OPERATOR'S PROTOCOL — `Equatable` for
	// `==`/`!=`, `Comparable` for `<`/`>`/`<=`/`>=`.
	//
	// ⭐ **THE PROTOCOL IS FETCHED, NOT DESCRIBED.** The method name the constraints are searched for, the
	// result type the verdict reads and the FORMALS the operator can fill are ALL taken off the interface
	// `builtinInterface` synthesizes — the whole `InterfaceMethodSig` is handed on rather than picked apart
	// into parallel `want*` arguments, so this function names ONE fact (which protocol the operator belongs
	// to) instead of several parallel spellings of it.
	function requireOperatorWitness(paramPos TypeParamId, op MaxonCmpOp, opTok Token) returns WitnessDispatchTarget throws ParseError
		let isEquality = op == MaxonCmpOp.eq or op == MaxonCmpOp.ne
		let protocol = requireBuiltinInterface(EquatableInterfaceName if isEquality else ComparableInterfaceName)
		let method = try protocol.methods.get(0) otherwise panic("requireOperatorWitness: the synthesized protocol '{String.from(protocol.name)}' declares no method — a comparison operator dispatches its SOLE method (`singleMethodInterface`), so `builtinInterface` must give it exactly one")

		// The search itself runs by METHOD (the shared core `.equals()`/`.compare()` dispatch uses), so the hit
		// still has to be PROVED to be the protocol's — see `requireProtocolShape`.
		match try self.findWitnessDispatch(paramPos, methodName: method.name, errorTok: opTok) 'lookup'
			found(target) then return try self.requireProtocolShape(target, protocolName: protocol.name, want: method, paramPos: paramPos, op: op, opTok: opTok)
			notFound then throw ParseError.operatorRequiresConformance(comparisonOpSpelling(op), typeParamName: String.from(self.enclosingTypeParamName(paramPos)), interfaceName: String.from(protocol.name), line: opTok.line, column: opTok.column)
		end 'lookup'
	end 'requireOperatorWitness'

	// ⭐ **A CONSTRAINT DECLARING A METHOD OF THE PROTOCOL'S NAME IS NOT THE PROTOCOL** — and the verdict below
	// reads the dispatch result as if it were. `findWitnessDispatch` matches by METHOD NAME because the
	// `.method()` dispatch it is shared with must, so a USER interface with its own `compare`/`equals` satisfies
	// it: **MEASURED — an `interface Weird` declaring `function compare(other Self) returns Integer` made
	// `a < b` mean `a.compare(b) == 0`, i.e. "less than" whenever the author's `compare` said EQUAL; the twin
	// with `equals` made `a == b` evaluate to the raw `7` that `equals` returned.** Both are silent wrong
	// answers, not crashes, so nothing downstream was ever going to catch them.
	//
	// Requiring the found method's RESULT to be the protocol's own declared result is what makes the target
	// genuinely the protocol's — `equals` must yield the `bool` the `eq`/`ne` arms take, `compare` the `Ordering`
	// whose tags `emitOrderingVerdict` tests. A near-miss reports the SAME E3005 as no constraint at all,
	// because the author's cure is the same sentence: constrain the parameter with the protocol. (Constructed
	// inline at both sites rather than through a shared factory — `throw self.helperReturningAParseError(…)`
	// leaks the boxed union under the bootstrap's refcounting; see `nestedUnionPayloadMessage`.)
	//
	// ⚠ **A THROWING METHOD IS REFUSED HERE FOR THE SAME REASON A WRONG-RESULT ONE IS (P1.7a slice 2b-v).**
	// `Equatable.equals` and `Comparable.compare` are synthesized non-throwing, so a user interface whose
	// `equals` declares `throws E` is no more the protocol than one returning `7` is — and there is no
	// spelling that would make it safe: an OPERATOR has nowhere to put a `try`, so the dispatch would be
	// emitted single-register against a callee returning through the dual-register error ABI, dropping the
	// error exactly as the missing `witnessTryCall` did. Same E3005, because the author's cure is the same
	// sentence.
	//
	// ⚠⚠ **AND SO ARE THE FORMALS — BOTH HOW MANY AND WHAT TYPE — WHICH WERE THE THIRD AND FOURTH HOLES IN
	// THE SAME WALL (P1.7a slice 2b-vi; the type half found in its review).** An operator has exactly one
	// operand to give and that operand is a value of `T`, so the formal LIST is as much a part of "is this
	// the protocol?" as the result type is. Both halves are one question, asked once, against the
	// SYNTHESIZED interface's own `paramTypeNames` — never written as a literal `1` or a literal `Self`, for
	// the reason this function's header gives. Neither is cosmetic; both were MEASURED silent wrong answers:
	//
	// - **ARITY.** `interface Weird { function equals(a Self, b Self) returns bool }` under `where T is
	//   Weird` compiled CLEAN and the impl read its unsupplied second `Self` formal out of an uninitialised
	//   argument register, dereferencing it (a fault away from a crash).
	// - **FORMAL TYPE.** `interface WeirdEq { function equals(other int) returns bool }` under `where T is
	//   WeirdEq` compiled CLEAN and `self.item == self.other` handed the RECEIVER'S `T` POINTER to a formal
	//   the impl reads as an `int` — `equals(other int) { return other == 7 }` answered `false` for two
	//   equal values (measured on `main` as well as on this branch). `requireGenuineSelfArgs` cannot cover
	//   it: it validates the actuals at `Self` formals, and this interface declares none. The `float` twin
	//   is worse — `floatWidenedWitnessArgs` sees a `float` formal and `cvtsi2sd`s the pointer — and a
	//   `String` formal is a type confusion, an unmanaged struct pointer read through a managed header.
	//
	// The `.method()` form reaches neither: `slottedWitnessArgs` checks its arity against the interface, and
	// its `Self` formals really are `Self`. The operator form was the last door left open, and closing the
	// arity half is what makes `requireGenuineSelfArgs`' missing-actual case unrepresentable.
	function requireProtocolShape(target WitnessDispatchTarget, protocolName ByteArray, want InterfaceMethodSig, paramPos TypeParamId, op MaxonCmpOp, opTok Token) returns WitnessDispatchTarget throws ParseError
		if not target.returnTypeName.equals(want.returnTypeName) or throwsClauseIsThrowing(target.throwsClause) or not interfaceFormalsMatch(target.paramTypeNames, b: want.paramTypeNames) 'notTheProtocol'
			throw ParseError.operatorRequiresConformance(comparisonOpSpelling(op), typeParamName: String.from(self.enclosingTypeParamName(paramPos)), interfaceName: String.from(protocolName), line: opTok.line, column: opTok.column)
		end 'notTheProtocol'

		return target
	end 'requireProtocolShape'

	// ⭐ **REJECT ANY NON-`Self` VALUE SUPPLIED FOR A `Self`-TYPED WITNESS-METHOD ARGUMENT (P1.7a slice 2b).** A
	// witness-dispatched method whose formal is `Self` (`Equatable.equals`'s and `Comparable.compare`'s `other
	// Self`) requires an ACTUAL argument that is a value of the receiver's OWN enclosing type parameter — the
	// only thing the `where` constraint proves. Anything else marshalled into that `Self` pointer/slot is a
	// MISCOMPILE: the callee's `equals(other Point)` dereferences whatever word it was handed as its `other`
	// pointer (0xC0000005). Run UNIFORMLY for the operator (`T == 42`, `T < 42`) and method-call
	// (`T.equals(42)`, `T.compare(42)`) forms — their one shared arg-validation point. It also carries a SECOND
	// guarantee for the asymmetric ordering operators: rejecting a non-`Self` actual is what proves the ordering
	// dispatch's receiver is always the LEFT operand (see `emitTypeParamComparison`). `args[0]` is the receiver;
	// interface formal `j` maps to `args[j+1]`.
	//
	// ⭐ **EVERY FORMAL HAS AN ACTUAL BY THE TIME THIS RUNS, AND BOTH CALLERS NOW GUARANTEE IT (P1.7a slice
	// 2b-vi).** It used to skip a formal with no actual, "an arity concern left to the caller" — and no caller
	// had it: the `.method()` form performed no arity check at all, and the operator form supplies one actual
	// to whatever arity the constraint's method declares. Both holes are closed (`slottedWitnessArgs` slots
	// against the interface's `paramNames`; `requireProtocolShape` requires the protocol's own formals), so a
	// missing actual is a compiler defect rather than a program's, and it panics instead of quietly passing an
	// under-supplied dispatch through to the emit.
	function requireGenuineSelfArgs(target WitnessDispatchTarget, args ValueIdArray, what String, receiverParamPos TypeParamId, errorTok Token) throws ParseError
		for j in 0 upto target.paramTypeNames.count() 'eachFormal'
			let formalTypeName = try target.paramTypeNames.get(j) otherwise panic("requireGenuineSelfArgs: paramTypeNames.get OOB at {j}")
			if not formalTypeName.equals(InterfaceSelfTypeName) 'notSelfFormal'
				continue
			end 'notSelfFormal'

			let actual = try args.get(j + 1) otherwise panic("requireGenuineSelfArgs: formal {j} of '{what}' has no actual — args holds {args.count()} entries (receiver + {args.count() - 1}) for {target.paramTypeNames.count()} formals, so the caller's arity check did not run")
			if not self.isReceiverTypeParamValue(actual, receiverParamPos: receiverParamPos) 'notSelfArg'
				throw ParseError.witnessSelfArgNotTypeParam(what, typeParamName: String.from(self.enclosingTypeParamName(receiverParamPos)), got: self.selfArgActualDescription(actual), line: errorTok.line, column: errorTok.column)
			end 'notSelfArg'
		end 'eachFormal'
	end 'requireGenuineSelfArgs'

	// ⭐ **IS `actual` A VALUE OF THE RECEIVER'S OWN TYPE PARAMETER — the ONLY thing a `Self`-typed formal
	// accepts?** "A value of SOME enclosing type parameter" is not enough, and the difference is a **MEASURED
	// 0xC0000005**: in `type Mix uses A, B where A is Comparable, B is Comparable` instantiated at
	// `(Point, Integer)`, `self.a < self.b` dispatched `A`'s witness — `Point.compare` — with a `B` actual, so
	// the callee dereferenced the integer `9` as its `other Point`. Reversed to `(Integer, Point)` it does not
	// fault but silently compares an int against a heap pointer, and the `.compare()` METHOD form takes the same
	// route. `Self` means the receiver's parameter, not "a type parameter", and the witness table it dispatches
	// through belongs to ONE parameter, so the position must match.
	//
	// (A genuine cross-parameter COMPARISON — `A` vs `B` where both conform — is a real feature and needs a
	// second witness plus a conversion; it is not this, and refusing it is what keeps the door shut until then.)
	function isReceiverTypeParamValue(actual ValueId, receiverParamPos TypeParamId) returns bool
		return self.isEnclosingTypeParam(actual) and self.valueNameId(actual) == receiverParamPos
	end 'isReceiverTypeParamValue'

	// WHAT was supplied where a `Self` was required, for `witnessSelfArgNotTypeParam`'s message — the two ways
	// an actual fails `isReceiverTypeParamValue`, described in ONE place so the diagnostic never calls a value
	// of another type parameter "a concrete value".
	function selfArgActualDescription(actual ValueId) returns String
		if not self.isEnclosingTypeParam(actual) 'concrete'
			return "a concrete value"
		end 'concrete'

		return "a value of type parameter '{String.from(self.enclosingTypeParamName(self.valueNameId(actual)))}'"
	end 'selfArgActualDescription'

	// The declared NAME of the enclosing type's type parameter at `pos` (P1.7a slice 2b) — `T` in `type Box uses
	// T`. `enclosingTypeParams` is name-by-position, populated for every generic type body, so a `typeParameter`
	// value's position always indexes it.
	function enclosingTypeParamName(position TypeParamId) returns ByteArray
		return try self.enclosingTypeParams.get(position) otherwise panic("enclosingTypeParamName: type-parameter position {position} out of range of the enclosing type's {self.enclosingTypeParams.count()} parameter(s)")
	end 'enclosingTypeParamName'

	// Emit the `__str_eq(lhs, rhs)` runtime call, typed `boolean` (its i64 result is 0/1). The one
	// caller-typed emit site for both `==` and `!=`, and for a `string`-scrutinee `match` pattern.
	function emitStrEqCall(lhs ValueId, rhs ValueId, opTok Token) returns ValueId
		var args = ValueIdArray.create()
		args.push(lhs)
		args.push(rhs)
		return self.emitRuntimeCall(StrEqName, args: args, resultTag: ValueTypeTag.boolean, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(opTok))
	end 'emitStrEqCall'

	// ⭐ **IS THE IDENTIFIER AT THE CURSOR A FUNCTION-TYPED LOCAL — the callee of an INDIRECT call?** A
	// call on such a name (`let f = double; f(21)`) goes THROUGH the value (P1.5-A1), not to a function
	// NAMED by the identifier. It is the ONE diversion that turns `<name>(` from a direct call into an
	// indirect one, and it must read the SAME in both positions the grammar reaches a bare `<name>(`:
	// EXPRESSION position (`parsePrimary`'s `namedPrimary`) and STATEMENT position (`parseStatement`'s
	// `callStmt`). A non-function local of the same name keeps the direct-call path (`x(5)` with an int
	// `x` is still "call function x", E3004), and a name that is no local at all is a plain direct call —
	// so a genuinely undefined statement-position call is still E3004, not silently accepted.
	//
	// The cursor must sit on the identifier: both callers guard with `at(identifier)` and a `(` peeked
	// behind it, so `current().value` is the callee name and `getInfo` is reached only past `contains`.
	function calleeIsFunctionTypedLocal() returns bool
		return self.scope.contains(self.current().value) and maxonTypeTag(self.scope.getInfo(self.current().value).varType) == ValueTypeTag.function
	end 'calleeIsFunctionTypedLocal'

	// A primary expression: an integer literal, a `true`/`false` literal, a CHARACTER literal,
	// a parenthesized sub-expression, a type-qualified numeric bound (`u16.max`), a call, or a
	// variable reference. Anything else where an operand is required (an operator, a delimiter,
	// EOF) is E2004 — "Expected expression but got '<got>'". This is the site `- -x` hits
	// at its second `-`: unary minus's operand is a primary, and a leading `-` is not one.
	function parsePrimary(func IrFunction) returns ValueId throws ParseError
		if self.at(TokenKind.intLiteral) 'intLit'
			return try self.parseIntLiteral()
		end 'intLit'

		if self.at(TokenKind.floatLiteral) 'floatLit'
			return try self.parseFloatLiteral()
		end 'floatLit'

		if self.at(TokenKind.true) or self.at(TokenKind.false) 'boolLit'
			return try self.parseBoolLiteral()
		end 'boolLit'

		// A charLiteral HERE — where an operand is required — is a character literal. The
		// same token kind is a BLOCK LABEL elsewhere, and the two never collide because a
		// label never sits in operand position (see the CharLiteralValue header).
		if self.at(TokenKind.charLiteral) 'charLit'
			return try self.parseCharLiteral()
		end 'charLit'

		// A `String` LITERAL (P1.2 wave A). A pure literal is a SINGLE `stringLiteral` token; an
		// INTERPOLATED string (`"{x}"`) is the same token followed by `stringInterpStart`, which is
		// Wave B — `parseStringLiteral` rejects it.
		if self.at(TokenKind.stringLiteral) 'strLit'
			return try self.parseStringLiteral(func)
		end 'strLit'

		// A `b"…"` BYTE-STRING LITERAL (P1.7 slice 2) — its own token kind, so it cannot ride the string arm
		// above. It materializes as an owned `Array with Byte` over an immortal rdata blob.
		if self.at(TokenKind.byteStringLiteral) 'byteStrLit'
			return try self.parseByteStringLiteral()
		end 'byteStrLit'

		// `[a, b, c]` — an ARRAY LITERAL (P1.7 slice 1). Its own arm because `[` is its own token. It
		// desugars to `__arr_create` + a `__arr_push` per element, yielding an owned `Array with integer`.
		if self.at(TokenKind.leftBracket) 'arrayLiteral'
			return try self.parseArrayLiteral(func)
		end 'arrayLiteral'

		if self.at(TokenKind.leftParen) 'group'
			return try self.parseParenthesizedExpression(func)
		end 'group'

		// `match <expr> 'label' … end 'label'` in value position — `let r = match …`, `return
		// match …`, `match … * 2`. A distinct parser gap from the statement form: the expression
		// parser had no `match` arm at all (E2004 `Expected expression but got 'match'`), where the
		// statement parser reached lowering before failing (E2015). It leaves control in the merge
		// block and yields the merge's result phi, exactly as `emitShortCircuit` does.
		if self.at(TokenKind.match) 'matchExpr'
			return try self.parseMatchExpression(func)
		end 'matchExpr'

		// `try <call> [otherwise <handler>]` in value position — `let r = try f() otherwise 0`, `return try
		// f() otherwise 42`. Yields the merged result value and leaves control in the merge (or the ok block
		// for a terminating/propagate handler), exactly as `parseMatchExpression` does.
		if self.at(TokenKind.try) 'tryExpr'
			return try self.parseTry(func, resultUsed: true)
		end 'tryExpr'

		// `function(params) gives <expr>` — a CLOSURE LITERAL in value position (P1.5-A2a). `function` is
		// its own keyword, so it cannot ride the identifier arm below. A NON-capturing closure lifts to a
		// top-level function and yields a plain `functionRef` value (the A1 machinery); one that captures an
		// enclosing local is refused (A2b). See `parseClosureExpression`.
		if self.at(TokenKind.function) 'closureLiteral'
			return try self.parseClosureExpression(func)
		end 'closureLiteral'

		// `Self{…}` — a struct literal naming the enclosing type. `Self` is its own KEYWORD token, not
		// an identifier, so it cannot ride the identifier arm below; and `{` is what tells it from
		// `Self` in a type position, which never reaches an expression at all.
		if self.at(TokenKind.selfType) 'selfLiteral'
			return try self.parseStructLiteral(func)
		end 'selfLiteral'

		// `self.x` / `self.m(…)` — the RECEIVER, which is a different keyword from `Self` the TYPE
		// (`self` vs `selfType`; the lexer splits them, so nothing here has to). Its own arm for the
		// same reason `Self{…}` has one: a keyword cannot ride the identifier arm below.
		if self.at(TokenKind.self) 'selfReceiver'
			return try self.parseSelfPrimary(func)
		end 'selfReceiver'

		// `sizeof(Type)` (P1.6-B1) — its own arm because `sizeof` is a KEYWORD, so it cannot ride the
		// identifier arm below (which would treat it as a value-position call to a function named `sizeof`,
		// leaving `T` an "undefined variable").
		if self.at(TokenKind.sizeof) 'sizeofExpr'
			return try self.parseSizeof()
		end 'sizeofExpr'

		if self.at(TokenKind.identifier) 'namedPrimary'
			// `Set from [1, 2, 3]` — a builtin `Set` CONSTRUCTED from an array literal (P1.7b slice B). The bare
			// `Set` identifier followed by `from` is a construction, NOT a variable reference (`Set` names no
			// binding, so the plain path below reports E2004 `Undefined variable 'Set'`). Its element type is
			// inferred from the literal. This is the ONLY `<Type> from […]` form shv2 parses this slice.
			if self.atSetFromConstruction() 'setFromConstruction'
				return try self.parseSetFromConstruction(func)
			end 'setFromConstruction'

			// One-token lookaheads split the four forms an identifier can open. `(` makes it a CALL
			// (the same shape the statement parser uses to tell a call apart from a bare name); `{`
			// makes it a STRUCT LITERAL; `.` makes it one of the three DOTTED forms
			// (`parseDottedPrimary` splits those); anything else is a variable reference.
			if self.peekKind() == TokenKind.leftParen 'callExpr'
				// A LOCAL binding of FUNCTION type shadowed by the same name is called THROUGH its value
				// — an INDIRECT call (`f(21)` where `let f = double`), not a direct call to a function
				// NAMED `f` (P1.5-A1). Resolve it as a variable reference and let the postfix loop
				// (`parsePostfix`) apply the `(args)`. The same diversion — reading the SAME predicate —
				// runs at statement position (`parseStatement`'s `callStmt`); see `calleeIsFunctionTypedLocal`.
				if self.calleeIsFunctionTypedLocal() 'functionLocalCall'
					return try self.parseVariableReference()
				end 'functionLocalCall'

				// A call in an EXPRESSION — its result IS the expression, so a void callee has nothing
				// to give and `parseCall` rejects it (E2004).
				return try self.parseCall(func, resultUsed: true)
			end 'callExpr'
			if self.peekKind() == TokenKind.leftBrace 'structLiteral'
				return try self.parseStructLiteral(func)
			end 'structLiteral'
			if self.peekKind() == TokenKind.dot 'dotted'
				return try self.parseDottedPrimary(func, resultUsed: true)
			end 'dotted'
			return try self.parseVariableReference()
		end 'namedPrimary'

		let tok = self.current()
		throw ParseError.expectedExpression(tok.kind.rawValue, line: tok.line, column: tok.column)
	end 'parsePrimary'

	// ⭐ **`sizeof(Type)`** (P1.6-B1) — the byte size of a type. Two outcomes, decided by the operand:
	//
	//   • A CONCRETE type (a primitive, a ranged alias, a declared struct) is a COMPILE-TIME CONSTANT,
	//     folded to a `literal` right HERE — which is where the struct registry lives. It must fold here
	//     and cannot ride the `sizeofType` op as a `structRef(id)`: `mergeArtifact` remaps signatures and
	//     field types but NOT op operands, so a file-local struct id would survive into a multi-file
	//     lowering as garbage. A concrete `sizeof` is a constant anyway, exactly like `let n = 42`.
	//   • A TYPE PARAMETER (`sizeof(T)` inside `type Sizer uses T`) has NO single compile-time answer — the
	//     body compiles ONCE against an opaque `T` — so it emits a `sizeofType(typeParameter)` op that
	//     lowers to a runtime read of the instance's layout descriptor. `typeParameter` carries a POSITION,
	//     not an interned id, so it survives the merge unremapped.
	function parseSizeof() returns ValueId throws ParseError
		let sizeofTok = try self.consume(TokenKind.sizeof)
		try self.consume(TokenKind.leftParen)
		let operand = self.resolveNamedStruct(try self.parseTypeReference())
		try self.consume(TokenKind.rightParen)

		if maxonTypeTag(operand) == ValueTypeTag.typeParameter 'runtimeSize'
			// ⚠ **A RECEIVER MUST BE IN SCOPE (B1).** The layout descriptor reaches a body by being THREADED
			// from the receiver instance a method is called on (dictionary-passing). A `static function` (called
			// on the TYPE) and a lifted closure (whose ValueId 0 is its first param, not the enclosing `self`)
			// are both RECEIVERLESS, so a caller has no instance whose descriptor to pass. The parser would
			// still reserve the hidden slot for such a body, but a call site would then reach
			// `finalizeCallArgsWithLayout` with no receiver argument (static) — or the closure's own
			// `sizeofType` op would reach lowering with no descriptor param — and PANIC. So reject `sizeof(T)`
			// here, cleanly (E2015), exactly like the multi-parameter case below. `__self` is bound in scope
			// ONLY inside an instance method's own body (the receiver param, the same binding
			// `requireReceiverValue` reads), so its absence IS the receiverless test. Read the size through an
			// instance method on `self` (or a concrete instance); threading a descriptor into a static call
			// site's alias, or capturing it into a closure, is a later slice.
			if not self.scope.contains(SelfParamName) 'noReceiver'
				throw ParseError.unsupported("sizeof of a type parameter with no instance receiver in scope — a `static function` and a closure are both receiverless, and B1 threads the layout descriptor from the instance a method is called on; read the size through an instance method on `self`, or a concrete instance, instead", line: sizeofTok.line, column: sizeofTok.column)
			end 'noReceiver'

			// ⚠ **SINGLE-TYPE-PARAMETER ONLY (B1).** The layout descriptor carries ONE `elementLogicalSize`
			// slot, so `sizeof(K)` in a `uses K, V` generic — which would need a per-parameter size — is a
			// clean E2015 here, not a lowering panic. A multi-parameter descriptor is a later slice.
			if self.enclosingTypeParams.count() > 1 'multiParamGeneric'
				throw ParseError.unsupported("sizeof of a type parameter of a MULTI-parameter generic type (its layout descriptor carries a single element size, so per-parameter sizes need a wider descriptor — a later slice); sizeof(T) on a single-type-parameter generic is supported", line: sizeofTok.line, column: sizeofTok.column)
			end 'multiParamGeneric'

			let result = self.mintValueOfType(MaxonType.integer)
			self.artifact.emitOp(self.currentBlock, op: MaxonOp.sizeofType(result, targetType: operand), range: SourceRange.ofToken(sizeofTok))
			return result
		end 'runtimeSize'

		return self.emitLiteral(try self.concreteSizeofBytes(operand, sizeofTok: sizeofTok), valueType: MaxonType.integer, range: SourceRange.ofToken(sizeofTok))
	end 'parseSizeof'

	// The byte size of a CONCRETE `sizeof` operand, computed at parse time. A struct is its full laid-out
	// box (`StructLayout.sizeBytes`); a generic INSTANCE is the base struct's box; every non-aggregate type
	// is its `primitiveTypeByteSize`. `typeParameter` never reaches here (its caller routes it to the
	// descriptor path); `unresolved` is a TypeResolution bug and `void` is not a value type.
	function concreteSizeofBytes(t MaxonType, sizeofTok Token) returns ParsedInt throws ParseError
		let tag = maxonTypeTag(t)
		if tag == ValueTypeTag.structRef 'struct'
			return self.namedStructSizeBytes(typeNameIdOf(t))
		end 'struct'
		if tag == ValueTypeTag.genericInstance 'instance'
			// ⚠ **AN INSTANCE IS INTERNED FOR WHATEVER A `with` NAMED, SO THE BASE MAY BE NOTHING AT ALL**, and
			// this fold runs at PARSE time while the E2055 `checkGenericInstance` recorded against that `with` is
			// drained whole-program — so the user would never see it. `sizeof(IntMap)` for `typealias IntMap =
			// Map with (Int, Int)` therefore died inside `genericInstanceBoxSize` with a stack trace and no
			// `error E….` at all. Positioned here instead, carrying the cause itself, exactly as the field-access
			// door does (`Parser.missingBaseLayout`). A BUILTIN base is NOT refused: its box is the fixed record
			// and `sizeof(Array with Int)` is 48 — which is why the gate is `genericInstanceBaseIsKnown` and not
			// the field walks' `genericInstanceHasBaseLayout`.
			if not self.signatures.genericInstanceBaseIsKnown(typeNameIdOf(t)) 'unknownBase'
				throw ParseError.unsupported("sizeof of a type that instantiates '{String.from(self.signatures.genericInstanceBaseName(typeNameIdOf(t)))}', which no file declares as a generic `type`, so it has no box to size — the `with` that names it is the error", line: sizeofTok.line, column: sizeofTok.column)
			end 'unknownBase'

			// The instance's box size is THE one authority on ProgramSignatures — the same
			// `genericInstanceBoxSize` the descriptor's `size@0` slot is emitted through — so a concrete
			// `sizeof(Box with Integer)` folded here and a `sizeof(T)` descriptor read for the same instance
			// cannot drift apart. The gid is whole-program (resolved in the real parse), so it needs no
			// file-local interner, unlike the `structRef` arm above.
			return self.signatures.genericInstanceBoxSize(typeNameIdOf(t)) as ParsedInt
		end 'instance'
		return primitiveTypeByteSize(tag) as ParsedInt
	end 'concreteSizeofBytes'

	// The full box byteSize of a declared struct, by its interned name id (a `structRef` operand's id is
	// against THIS file's interner, so it resolves through the file table, not the merged one).
	function namedStructSizeBytes(id TypeNameId) returns ParsedInt
		let name = try self.artifact.typeNames.nameOf(id) otherwise panic("namedStructSizeBytes: a `structRef` id is not in this file's interner — `resolveNamedStruct` interned it from a name in the same table")
		match self.signatures.structOf(name) 'lookup'
			declared(layout) then return layout.sizeBytes() as ParsedInt
			undeclared then panic("namedStructSizeBytes: `structRef` names '{String.from(name)}', which `resolveNamedStruct` only tags for a declared struct")
		end 'lookup'
	end 'namedStructSizeBytes'

	// `( <expr> )` — grouping, which is what makes `(2 + 3) * 4` mean 20 rather than 14.
	// The parentheses produce NO op: the group's value IS the inner expression's, so the
	// only thing they change is the shape of the tree the climber builds.
	//
	// It re-enters the climber at the LOOSEST level (via `parseValueExpression`, so `(a if c else b)`
	// groups a ternary), restoring every operator — `not (a or b)` is the `or` of two bools, `(x > 0)
	// and (y > 0)` groups explicitly. It does NOT go through `parseExpression`, which would re-seed
	// `currentBlock` and undo any short-circuit that moved it.
	function parseParenthesizedExpression(func IrFunction) returns ValueId throws ParseError
		try self.consume(TokenKind.leftParen)
		let value = try self.parseValueExpression(func)
		try self.consume(TokenKind.rightParen)
		return value
	end 'parseParenthesizedExpression'

	// `'a'`, `'\n'`, `'0'` — a character literal in operand position. It materializes as an
	// ordinary INTEGER literal carrying the character's byte, which is exactly what
	// specs/char-literal-to-int.md asks for ("the compiler automatically converts the
	// character literal to its Unicode codepoint value at compile time") and what makes
	// `cp == '-'`, `cp - '0'` and `if c >= '0'` compile and mean what they say.
	//
	// v1 does the same for the single-byte case (`parseCharLiteralExpr`, Parser.maxon:16606:
	// *"Emits an integer literal carrying the byte value of an ASCII character"*) and routes
	// wider literals to its `Character` struct. shv2 has no Character type — it is a heap
	// value, and heap values arrive with String at P1.2 — so it REJECTS them with a
	// positioned diagnostic naming the gap, exactly as v1's own comment says it must
	// ("report them as a diagnostic instead of silently producing the wrong byte").
	function parseCharLiteral() returns ValueId throws ParseError
		let tok = try self.consume(TokenKind.charLiteral)
		let value = try self.decodeCharPatternValue(tok)
		return self.emitLiteral(value, valueType: MaxonType.integer, range: SourceRange.ofToken(tok))
	end 'parseCharLiteral'

	// Decode a single-byte character literal to its byte value, or the same positioned diagnostic
	// `parseCharLiteral` gives for an empty/multi-byte/bad-escape literal. Shared with the match interval
	// plan, which needs the byte VALUE (a pattern bound) rather than an emitted `literal` op.
	function decodeCharPatternValue(tok Token) returns ParsedInt throws ParseError
		match decodeCharLiteral(tok.value) 'decoded'
			byte(value) then return value
			empty then throw ParseError.invalidCharacterLiteral("a character literal must contain exactly one character", line: tok.line, column: tok.column)
			multiByte then throw ParseError.unsupported("the multi-byte character literal '{String.from(tok.value)}' (a character wider than one byte is a `Character` — a heap value with `.bytes()` and `.asciiValue()` — which arrives with String; a single-byte literal materializes as its byte value)", line: tok.line, column: tok.column)
			badEscape(text) then throw ParseError.invalidCharacterLiteral("unknown escape sequence '{text}'", line: tok.line, column: tok.column)
		end 'decoded'
	end 'decodeCharPatternValue'

	// `"hello"`, `""`, `"Use \{expr\} for interpolation"` — a `String` LITERAL in operand position (P1.2
	// wave A). It materializes as a `stringLiteral` op carrying the DECODED bytes, typed `string`;
	// lowering turns it into an immortal `.rdata` record + a `lea` of its address (see
	// `LowerMaxonToStd.lowerStringLiteral`). No heap, no ownership — a literal is never allocated or
	// dropped.
	//
	// ⚠ AN INTERPOLATED STRING IS DEFERRED. The lexer splits `"a{x}b"` into `stringLiteral("a")`,
	// `stringInterpStart`, the `x` tokens, `stringInterpEnd`, `stringLiteral("b")` — so a `stringLiteral`
	// token FOLLOWED BY `stringInterpStart` is an interpolation, which builds an owned HEAP string and is
	// Wave B. `escaped-braces` (`\{`/`\}`) is NOT interpolation: the lexer's escape handling means the
	// braces never open one, so it is a single `stringLiteral` fragment and `decodeEscapes` turns `\{`
	// into `{` here.
	function parseStringLiteral(func IrFunction) returns ValueId throws ParseError
		// A `stringLiteral` FOLLOWED BY `stringInterpStart` is an interpolation (`"a{x}b"`), which builds
		// the first OWNED heap String (P1.2 wave B). A lone `stringLiteral` is an immortal rdata literal.
		if self.peekKind() == TokenKind.stringInterpStart 'interpolated'
			return try self.parseStringInterpolation(func)
		end 'interpolated'

		return try self.consumeStringLiteralValue()
	end 'parseStringLiteral'

	// Consume the current NON-interpolated `stringLiteral` token and emit its decoded bytes as an immortal
	// rdata String. The shared body of the two callers that reach a plain literal — value position
	// (`parseStringLiteral`) and match-pattern position (`emitPatternValue`) — so the decode-and-emit lives
	// in one place.
	function consumeStringLiteralValue() returns ValueId throws ParseError
		let tok = try self.consume(TokenKind.stringLiteral)
		match decodeEscapes(tok.value) 'decoded'
			bytes(buf) then return self.emitStringLiteral(buf, range: SourceRange.ofToken(tok))
			unknownEscape(text) then throw ParseError.unsupported("the escape sequence '{text}' in a string literal is not a recognized escape", line: tok.line, column: tok.column)
		end 'decoded'
	end 'consumeStringLiteralValue'

	// Append a `stringLiteral` op carrying the DECODED bytes; return the `string`-typed ValueId it
	// defines. The one emit site, so a caller that already holds decoded bytes (none today, but the
	// interpolation path at Wave B will hand a materialized buffer here) reaches the type + op in one
	// place.
	function emitStringLiteral(bytes ByteArray, range SourceRange) returns ValueId
		let result = self.mintValue(ValueTypeTag.string, nameId: UnnamedTypeId)
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.stringLiteral(result, bytes: bytes), range: range)
		return result
	end 'emitStringLiteral'

	// ⭐ **`b"hello"`, `b""`, `b"\xc0"`, `b"À"` — a BYTE-STRING LITERAL in operand position (P1.7 slice 2).**
	// It decodes to a raw byte sequence (escapes resolved, one Latin-1 byte per source codepoint) and
	// materializes as an OWNED `Array with Byte` value: a `byteStringLiteral` op that lowers to a heap 48-byte
	// Array record over an IMMORTAL rdata blob (see `LowerMaxonToStd.lowerByteStringLiteral`). Its value type
	// is pinned to the concrete `Array with Byte` gid so `.count()`/`.get()` dispatch through a real generic
	// instance — a bare `named(Array)` would trip the generics machinery. Enrolled as an owned temp so a
	// scope-exit / statement-end drop (`__arr_decref`) frees the record (the rdata buffer is left alone).
	//
	// A codepoint above 0xFF (`b"Ā"`, a `\uNNNN` naming one, an emoji) has no single-byte encoding and is
	// REJECTED with E1004 — the self-hosted oracle's behaviour, deliberately UNLIKE the C# bootstrap, which
	// silently Latin-1 best-fit-transliterates the codepoint away. Use `\xNN` to embed an exact raw byte.
	function parseByteStringLiteral() returns ValueId throws ParseError
		let tok = try self.consume(TokenKind.byteStringLiteral)
		let bytes = try decodeByteStringLiteral(tok.value, tok: tok)
		return try self.emitByteStringLiteralValue(bytes, range: SourceRange.ofToken(tok))
	end 'parseByteStringLiteral'

	// Append a `byteStringLiteral` op carrying the DECODED bytes; return the owned `Array with Byte`
	// ValueId it defines. `emitStringLiteral`'s twin, and split out for its reason: a second caller
	// already holds decoded bytes — a use of a top-level managed constant (`emitManagedConstant`), whose
	// bytes were decoded once by the declaration sweep. One emit site, so the value's TYPE (the concrete
	// `Array with Byte` gid) and its OWNERSHIP (an owned temp the statement drops) cannot drift between
	// the two spellings of the same literal.
	function emitByteStringLiteralValue(bytes ByteArray, range SourceRange) returns ValueId throws ParseError
		try self.requireByteStringBlobStridesLikeItsType(range)

		let giid = self.signatures.internArrayByteInstance()
		let result = self.mintValue(ValueTypeTag.genericInstance, nameId: giid)
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.byteStringLiteral(result, bytes: bytes), range: range)
		self.trackOwnedTemp(result)
		return result
	end 'emitByteStringLiteralValue'

	// ⭐ **A `b"…"` BLOB IS BYTE-PACKED BY CONSTRUCTION, so the literal is a value of `Array with Byte` only
	// while THIS program's `Byte` is one byte wide** — the rule, what it costs when it does not hold, and why
	// it is a refusal rather than a widened blob are all on `byteStringBlobStrideMessage`, beside the words
	// both throw sites emit.
	//
	// ⚠ **THE SAME RULE HAS A SECOND THROW SITE**, `requireConstByteStringBlobStridesLikeItsType`, because a
	// top-level `let G = b"…"` / `var G = b"…"` never reaches this emitter: the initializer sweep folds it to
	// bytes and `ModuleInit` builds the record, so a STORED byte-string global would otherwise slip the gate
	// (measured: it did). The two differ ONLY in the error union their tier speaks — `ParseError` here,
	// `ConstEvalError.defective` there — so the stride and the message are each computed by ONE function and
	// only the `throw` is written twice.
	function requireByteStringBlobStridesLikeItsType(range SourceRange) throws ParseError
		let declaredStride = self.byteElementDeclaredStride()
		if declaredStride != ByteStringElementSize 'blobStrideDisagreesWithTheElement'
			throw ParseError.unsupported(byteStringBlobStrideMessage(declaredStride), line: range.line, column: range.column)
		end 'blobStrideDisagreesWithTheElement'
	end 'requireByteStringBlobStridesLikeItsType'

	// The `requireByteStringBlobStridesLikeItsType` twin for the top-level initializer sweep — same stride,
	// same message, positioned at the `b"…"` token of the declaration rather than at a use.
	function requireConstByteStringBlobStridesLikeItsType(tok Token) throws ConstEvalError
		let declaredStride = self.byteElementDeclaredStride()
		if declaredStride != ByteStringElementSize 'blobStrideDisagreesWithTheElement'
			throw ConstEvalError.defective(ParseError.unsupported(byteStringBlobStrideMessage(declaredStride), line: tok.line, column: tok.column))
		end 'blobStrideDisagreesWithTheElement'
	end 'requireConstByteStringBlobStridesLikeItsType'

	// What THIS program's `Byte` element strides — `arrayElementSize` over the very instance a `b"…"` literal
	// carries, so the gate's antecedent is the number every other `Array with Byte` record is stamped with and
	// not a second reading of the same declaration.
	function byteElementDeclaredStride() returns ParsedInt
		return self.signatures.arrayElementSize(self.signatures.internArrayByteInstance()) as ParsedInt
	end 'byteElementDeclaredStride'

	// ⭐⭐ **`"prefix {x} suffix"` — WHERE THE FIRST OWNED HEAP STRING IS BUILT.** An interpolation lowers to
	// ONE `__mm_alloc`'d fused record: the 48-byte String record with its UTF-8 bytes INLINE right behind it
	// (`buffer@0 = record + StringRecordBytes`), the concatenation of every part's bytes. It is an owned
	// TEMPORARY — `emitStringInterp` enrolls it for the statement-scoped drop — so `print("{x}")` frees it
	// at statement end and `let s = "{x}"` transfers it to a scope-exit drop (`parseBinding`).
	//
	// The lexer splits `"a{x}b"` into `stringLiteral("a") stringInterpStart <expr> stringInterpEnd
	// stringLiteral("b")` — a leading fragment, then any number of `(expr, fragment)` pairs. Each part is
	// materialized to a `(buffer, length)` pair as it is parsed (a literal fragment and a `{s}` String part
	// alike load `buffer@0`/`length@8` from a String record; a primitive renders into a freed scratch
	// buffer), and `emitStringInterp` sums the lengths, allocates once, and copies the parts in.
	//
	// Each `{expr}` is parsed in the block control CURRENTLY occupies, not the entry block — an expression
	// that opens blocks (a short-circuit `{a and b}`) leaves control in its merge, and the next part and the
	// assembly must chain off that merge (the `multiple-try-fragments` regression, deferred here for `try`).
	function parseStringInterpolation(func IrFunction) returns ValueId throws ParseError
		let startTok = self.current()
		let range = SourceRange.ofToken(startTok)

		var partBufs = ValueIdArray.create()
		var partLens = ValueIdArray.create()
		// The OWNED scratch buffers a primitive part rendered into. Freed after the copy in
		// `emitStringInterp` — they are consumed by the blit and otherwise leak (the interp-scratch-buffer
		// leak the leak gate would catch). A literal or String part collects none (its bytes are borrowed).
		var scratchIds = ValueIdArray.create()

		try self.materializeLiteralFragment(partBufs, partLens: partLens, range: range)
		while self.at(TokenKind.stringInterpStart) 'parts'
			try self.consume(TokenKind.stringInterpStart)
			let exprTok = self.current()
			let exprVal = try self.parseExpression(func, block: self.currentBlock)
			try self.consume(TokenKind.stringInterpEnd)
			try self.materializeInterpExpr(exprVal, exprTok: exprTok, partBufs: partBufs, partLens: partLens, scratchIds: scratchIds, range: range)
			try self.materializeLiteralFragment(partBufs, partLens: partLens, range: range)
		end 'parts'

		return self.emitStringInterp(partBufs, partLens: partLens, scratchIds: scratchIds, range: range)
	end 'parseStringInterpolation'

	// Consume the current literal fragment token and, if it decodes to a non-empty byte run, materialize it
	// as a part. An EMPTY fragment (the `""` the lexer emits around adjacent interpolations, `"{a}{b}"`)
	// contributes nothing and is skipped — the bootstrap's `if (string.IsNullOrEmpty(...)) continue`.
	function materializeLiteralFragment(partBufs ValueIdArray, partLens ValueIdArray, range SourceRange) throws ParseError
		let tok = try self.consume(TokenKind.stringLiteral)
		match decodeEscapes(tok.value) 'decoded'
			bytes(buf) then self.materializeFragmentBytes(buf, partBufs: partBufs, partLens: partLens, range: range)
			unknownEscape(text) then throw ParseError.unsupported("the escape sequence '{text}' in a string literal is not a recognized escape", line: tok.line, column: tok.column)
		end 'decoded'
	end 'materializeLiteralFragment'

	function materializeFragmentBytes(buf ByteArray, partBufs ValueIdArray, partLens ValueIdArray, range SourceRange)
		if buf.count() == 0 'empty'
			return
		end 'empty'
		self.materializeStringRecordPart(self.emitStringLiteral(buf, range: range), partBufs: partBufs, partLens: partLens, range: range)
	end 'materializeFragmentBytes'

	// A `{expr}` part. A String value (a literal or an interpolation result) is copied by its bytes exactly
	// as a literal fragment is — `materializeStringRecordPart` reads `buffer@0`/`length@8` from either. An
	// integer renders to decimal text via `__int_to_string` into a scratch buffer. bool/float/enum are the
	// next waves; a Stringable struct is P1.7a.
	function materializeInterpExpr(exprVal ValueId, exprTok Token, partBufs ValueIdArray, partLens ValueIdArray, scratchIds ValueIdArray, range SourceRange) throws ParseError
		let tag = self.tagOf(exprVal)
		if tagIsText(tag) 'stringPart'
			self.materializeStringRecordPart(exprVal, partBufs: partBufs, partLens: partLens, range: range)
			return
		end 'stringPart'

		if tagIsIntegral(tag) 'intPart'
			self.materializeScratchPart(exprVal, converter: IntToStringName, scratchBytes: IntToStringScratchBytes, partBufs: partBufs, partLens: partLens, scratchIds: scratchIds, range: range)
			return
		end 'intPart'

		if tagIsBool(tag) 'boolPart'
			self.materializeScratchPart(exprVal, converter: BoolToStringName, scratchBytes: BoolToStringScratchBytes, partBufs: partBufs, partLens: partLens, scratchIds: scratchIds, range: range)
			return
		end 'boolPart'

		// ⭐ **A USER STRUCT — `"{p}"` → a DIRECT `<Type>.toString()` CALL (P1.7a slice 1).** The concrete
		// type is statically known here, so dispatch is a plain method call, NOT a witness (exactly what the
		// monomorphizing bootstrap emits). Witnesses are needed only for an UNKNOWN concrete type — a
		// constrained type parameter — which is slice 2.
		if tag == ValueTypeTag.structRef 'structPart'
			try self.materializeStructToStringPart(exprVal, exprTok: exprTok, partBufs: partBufs, partLens: partLens, range: range)
			return
		end 'structPart'

		throw ParseError.unsupported("interpolating a value of type '{typeTagName(tag)}' — P1.2 wave B interpolates String, integer and bool expressions; float arrives next, and a Stringable struct at P1.7a", line: exprTok.line, column: exprTok.column)
	end 'materializeInterpExpr'

	// ⭐ **INTERPOLATE A USER STRUCT VIA A DIRECT `<Type>.toString()` CALL (P1.7a slice 1).** A struct is
	// interpolable iff it HAS a `toString` method (by NAME, not by declaring `Stringable` — the oracle's
	// rule); a struct WITHOUT one is E3016, positioned at the interpolated expression. The call's result is
	// classified +1 OWNED by `emitCall` (`mintOwnedCallResult` → `trackOwnedTemp`), so the fresh String is
	// freed at STATEMENT END — after `emitStringInterp` has copied its bytes into the interp result. Its
	// bytes are spliced exactly as a `{s}` String part's are (`materializeStringRecordPart`), the same
	// machinery a String-returning call already interpolates through. Without the owned classify, one
	// String would leak per interpolated struct (a v1 leak trap).
	function materializeStructToStringPart(exprVal ValueId, exprTok Token, partBufs ValueIdArray, partLens ValueIdArray, range SourceRange) throws ParseError
		let structName = self.internedName(self.valueNameId(exprVal))
		let callee = qualifiedMethodName(structName, methodName: ToStringMethodName)

		if not self.calleeIsDeclared(callee) 'noToString'
			self.recordArtifactDiagnostic(ErrorCode.semanticPartialInterfaceImpl, message: "Type '{String.from(structName)}' used in string interpolation must have a toString method", tok: exprTok)
			// The recorded diagnostic fails the build; materialize an EMPTY placeholder part so the interp
			// assembly (which needs at least one part) does not panic on a bare `"{s}"`.
			self.materializeStringRecordPart(self.emitStringLiteral(EmptySourceText, range: range), partBufs: partBufs, partLens: partLens, range: range)
			return
		end 'noToString'

		var args = ValueIdArray.create()
		args.push(exprVal)
		var argLabels = ByteArrayArray.create()
		argLabels.push(EmptySourceText)
		var argRanges = SourceRangeArray.create()
		argRanges.push(range)
		let result = try self.emitCall(callee, anchor: exprTok, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: NoImmutableArgNames, rparenTok: exprTok, resultUsed: true, constructorInstance: ConstructorInstance.none)
		self.materializeStringRecordPart(result, partBufs: partBufs, partLens: partLens, range: range)
	end 'materializeStructToStringPart'

	// A String-record part: load `buffer@0` and `length@8` off the record. Shared by literal fragments and
	// `{s}` String parts — both are pointers to the fused 48-byte record, so both read the same two fields.
	function materializeStringRecordPart(rec ValueId, partBufs ValueIdArray, partLens ValueIdArray, range SourceRange)
		partBufs.push(self.emitLoadStringField(rec, offset: StringBufferOffset, range: range))
		partLens.push(self.emitLoadStringField(rec, offset: StringLengthOffset, range: range))
	end 'materializeStringRecordPart'

	// Render a primitive part into a freshly `__mm_alloc`'d scratch buffer via a `(value, dest) -> length`
	// converter runtime function, enroll the scratch for the post-copy free (it is an owned buffer the blit
	// consumes — otherwise the interp-scratch-buffer leak), and record `(scratch, length)`. The shared shape
	// of every primitive part — int, bool, float — differing only in the converter and its worst-case byte
	// budget. A `named` integer alias is already i64, so the value needs no widening at this rung.
	function materializeScratchPart(exprVal ValueId, converter ByteArray, scratchBytes ParsedInt, partBufs ValueIdArray, partLens ValueIdArray, scratchIds ValueIdArray, range SourceRange)
		let scratchSize = self.emitLiteral(scratchBytes, valueType: MaxonType.integer, range: range)
		let scratch = self.emitBoxAlloc(scratchSize, resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: range)

		var convArgs = ValueIdArray.create()
		convArgs.push(exprVal)
		convArgs.push(scratch)
		let length = self.emitRuntimeCall(converter, args: convArgs, resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: range)

		partBufs.push(scratch)
		partLens.push(length)
		scratchIds.push(scratch)
	end 'materializeScratchPart'

	// ⭐ **ASSEMBLE THE FUSED OWNED STRING.** Sum the part lengths, allocate ONE `__mm_alloc` record big
	// enough for the 48-byte record + the bytes + a NUL, copy every part into the inline region at a running
	// cursor, write the record fields, and free the scratch. The result is an owned temporary
	// (`trackOwnedTemp`) — an INLINE String (`capacity@16 = InlineBufferCapacity`) whose bytes die with the
	// record's slot, so its destructor is `TrivialDestructor` (0), exactly a struct's: `__mm_decref` →
	// `__mm_free` reclaims record and bytes together, with no external buffer and no destructor cascade.
	function emitStringInterp(partBufs ValueIdArray, partLens ValueIdArray, scratchIds ValueIdArray, range SourceRange) returns ValueId
		let totalLen = self.sumPartLengths(partLens, range: range)

		let overhead = self.emitLiteral(StringInterpOverheadBytes, valueType: MaxonType.integer, range: range)
		let allocSize = self.emitMachineWordAdd(totalLen, rhs: overhead, range: range)
		let result = self.emitBoxAlloc(allocSize, resultTag: ValueTypeTag.string, resultNameId: UnnamedTypeId, range: range)
		self.trackOwnedTemp(result)

		// The inline byte region begins right after the record. Copy each part in at a cursor that advances
		// by the part's length; the NUL at `buffer[totalLen]` is already zero (the slab zeroes the payload).
		let recordBytes = self.emitLiteral(StringRecordBytes as ParsedInt, valueType: MaxonType.integer, range: range)
		let inlineBuf = self.emitMachineWordAdd(result, rhs: recordBytes, range: range)
		var cursor = inlineBuf
		for i in 0 upto partBufs.count() 'copyParts'
			let buf = try partBufs.get(i) otherwise panic("emitStringInterp: partBufs.get OOB at {i} — partBufs and partLens grow in lockstep")
			let length = try partLens.get(i) otherwise panic("emitStringInterp: partLens.get OOB at {i} — partBufs and partLens grow in lockstep")
			var copyArgs = ValueIdArray.create()
			copyArgs.push(cursor)
			copyArgs.push(buf)
			copyArgs.push(length)
			_ = self.emitRuntimeCall(StrCopyName, args: copyArgs, resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
			cursor = self.emitMachineWordAdd(cursor, rhs: length, range: range)
		end 'copyParts'

		self.emitStoreStringField(result, offset: StringBufferOffset, value: inlineBuf, range: range)
		self.emitStoreStringField(result, offset: StringLengthOffset, value: totalLen, range: range)
		// ⭐ **`capacity@16 = InlineBufferCapacity` — the buffer-ownership encoding's INLINE provenance**
		// (`BufferOwnership`), and the one fact the whole record has to publish about its bytes: they are
		// part of this box, so they are neither writable in place beyond their exact length nor separately
		// releasable. `__str_append` reads it (any negative capacity is below every required length, so an
		// inline String always detaches into a private buffer before it grows) and `__str_decref` reads it
		// (a negative capacity sends it to `parent@32`, which is `NoOwedAllocation` here, so the record's
		// own free reclaims record and bytes together). It used to publish `length` — an ordinary
		// NON-NEGATIVE capacity, which the shared encoding reads as "I own a separate buffer" — and marked
		// inline-ness in `parent@32` instead, which nothing read: the drop path was correct only because
		// `__str_decref` carried a String-only branch that re-derived inline-ness from the layout.
		// `parent@32` needs no store at all now: `NoOwedAllocation` is 0, which `__mm_alloc`'s zeroing
		// contract already supplies (the same reason `__arr_create` leaves four of its six fields alone).
		let capacity = self.emitLiteral(InlineBufferCapacity, valueType: MaxonType.integer, range: range)
		self.emitStoreStringField(result, offset: StringCapacityOffset, value: capacity, range: range)
		let elementSize = self.emitLiteral(StringElementSize, valueType: MaxonType.integer, range: range)
		self.emitStoreStringField(result, offset: StringElementSizeOffset, value: elementSize, range: range)
		// `isAscii@40 = 0` (conservative) comes from the slab's zeroing — grapheme/ascii refinement is P1.7.

		// Free the owned scratch now its bytes are copied. A `__mm_decref` (rc 0 → `__mm_free`), never a raw
		// free, so the leak counter stays balanced — the same door `emitScopeDrops` drops through.
		for i in 0 upto scratchIds.count() 'freeScratch'
			let scratch = try scratchIds.get(i) otherwise panic("emitStringInterp: scratchIds.get OOB at {i}")
			self.emitDecref(scratch, range: range)
		end 'freeScratch'

		return result
	end 'emitStringInterp'

	// Sum the parts' lengths into a single value. At least one part exists — a real interpolation carries a
	// `{expr}`, so `parseStringInterpolation` always materialized one before calling here.
	function sumPartLengths(partLens ValueIdArray, range SourceRange) returns ValueId
		var total = try partLens.get(0) otherwise panic("sumPartLengths: an interpolation materialized no parts — parseStringInterpolation only reaches emitStringInterp after materializing at least one interpolated part")
		for i in 1 upto partLens.count() 'sum'
			let length = try partLens.get(i) otherwise panic("sumPartLengths: partLens.get OOB at {i}")
			total = self.emitMachineWordAdd(total, rhs: length, range: range)
		end 'sum'
		return total
	end 'sumPartLengths'

	// `lhs + rhs` as raw i64 MACHINE-WORD arithmetic — the interpolation's cursor advance, buffer offset
	// and size math, and a `for` loop's index step. It emits `MaxonOp.binOp(add)` DIRECTLY, bypassing
	// `emitBinOp`'s operand type rules, because the operands are compiler-owned words (a String pointer
	// `result + StringRecordBytes`, a byte length, a loop counter) rather than a source-level `a + b`
	// whose two sides must be shown to agree. The result is integer-tagged; the Std tier reads a String
	// lhs as its i64 pointer (`valueTagToStdType`), so the `add` is a clean i64 add either way.
	function emitMachineWordAdd(lhs ValueId, rhs ValueId, range SourceRange) returns ValueId
		let result = self.mintValue(ValueTypeTag.integer, nameId: UnnamedTypeId)
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.binOp(result, lhs: lhs, rhs: rhs, op: MaxonBinOp.add), range: range)
		return result
	end 'emitMachineWordAdd'

	// Load an 8-byte field of a String record — `buffer@0`, `length@8`. Integer-tagged: the values are a raw
	// pointer and a byte count. The `rec` addr is a String pointer, read by the Std tier as an i64.
	//
	// It routes through `emitIndirectLoad` rather than emitting the op itself, exactly as `emitFieldLoad`
	// does: a String record is a BOX like any other, and its declared type and its storage type coincide
	// at `integer` only because a raw pointer and a byte count are both machine words. That is a fact
	// about this box, and it belongs here — not a reason to own a second copy of the emit.
	function emitLoadStringField(rec ValueId, offset ByteOffset, range SourceRange) returns ValueId
		return self.emitIndirectLoad(MaxonType.integer, box: rec, offset: offset, storageType: MaxonType.integer, range: range)
	end 'emitLoadStringField'

	// Store an 8-byte field of a String record — the mirror of `emitLoadStringField`, the one place
	// `emitStringInterp` writes the fused record's six fields (five explicitly; `isAscii@40` rides the
	// slab's zeroing).
	function emitStoreStringField(rec ValueId, offset ByteOffset, value ValueId, range SourceRange)
		self.emitIndirectStore(rec, offset: offset, value: value, storageType: MaxonType.integer, range: range)
	end 'emitStoreStringField'

	// `true` / `false`. A bool is an i1 carrying 1 or 0 — the same `literal` op an
	// integer uses, typed `boolean` so the Maxon→Std collapse gives it i1 rather than
	// i64. The `bool` TYPE already existed (a comparison produces one, an `if` consumes
	// one); these are the literals that let a program NAME one.
	// ONE emit site, not one per arm: the two literals differ only in the token they
	// consume and the payload they carry, so a change to how a bool is materialized (its
	// MaxonType, its op) lands in a single place and cannot apply to `true` but not `false`.
	function parseBoolLiteral() returns ValueId throws ParseError
		let tok = self.current()
		var value = BoolTrueValue
		if self.at(TokenKind.true) 'isTrue'
			try self.consume(TokenKind.true)
		end 'isTrue' else 'isFalse'
			try self.consume(TokenKind.false)
			value = BoolFalseValue
		end 'isFalse'
		return self.emitLiteral(value, valueType: MaxonType.boolean, range: SourceRange.ofToken(tok))
	end 'parseBoolLiteral'

	// ⭐⭐ **`Self{x: x, y: y}` — WHERE THE HEAP ENTERS THE LANGUAGE.** The first, and at this rung
	// the only, expression that allocates.
	//
	// It lowers to exactly four kinds of op, none of them new:
	//
	//     literal   16                 -- the box's payload size (StructLayout.sizeBytes)
	//     literal   0                  -- the destructor (TrivialDestructor; see there)
	//     call      __mm_alloc         -- returns the PAYLOAD pointer; field i is at [ptr + i*8]
	//     storeIndirect <ptr> 0 <x>    -- one per field, at StructLayout.offsetOfField(i)
	//     storeIndirect <ptr> 8 <y>
	//
	// ⚠ **THE FIELDS ARE STORED IN DECLARATION ORDER, NOT IN THE ORDER THEY WERE WRITTEN**, and the
	// values are parsed in the order they were written. Both are true at once because the values are
	// evaluated into SSA ids as the literal is read, and the STORES are emitted afterwards by walking
	// the layout — so `Point{y: 4, x: 3}` evaluates `4` first and still puts `3` in slot 0. Emitting
	// each store as its field was parsed would have written the box in source order, which is the same
	// thing for these two cases and the wrong thing for one field in a slot the layout disagrees about.
	//
	// ⚠ **EVERY FIELD MUST END UP INITIALIZED, and the allocator's zeroing guarantee is what makes
	// that a RULE rather than a nicety.** An omitted slot reads back as a clean 0 — a plausible
	// number — so `Point{x: 1}` would silently have `y == 0`. E3086 rejects it.
	//
	// A slot gets its value from one of TWO sources, asked in this order: the literal
	// (`parseStructLiteralFields`), then the field's declared DEFAULT (`applyFieldDefaults`). The
	// literal always wins — the default is consulted only for a slot `filled` says nothing wrote.
	// `requireAllFieldsInitialized` then rejects whatever neither supplied.
	//
	// ⭐ **A MANAGED FIELD IS MOVED IN** (`emitStructLiteral` → `moveInPayload`), not stored raw — the
	// CONSUME-into-field half of cross-call ownership. Every managed field kind is now constructible: a
	// `String` (promoted/moved in, dropped through `__str_decref`), a `struct` (moved in, dropped through
	// its own `__destruct_<Struct>`), and a payload-bearing (boxed) UNION field (moved in, dropped through
	// the union's `__destruct_<U>` or the trivial `__mm_decref` for a scalar-only box — P1.4b wave 2c). The
	// box becomes the field's sole owner and its `__destruct_<Struct>` cascade drops it exactly once. A
	// borrowed struct/union value has no `clone`, so moving one into durable storage is refused
	// (`moveInPayload` — the transitive cross-call consume the call-graph fixpoint owns).
	function parseStructLiteral(func IrFunction) returns ValueId throws ParseError
		let typeTok = self.current()
		let typeName = try self.readStructLiteralTypeName()
		let layout = try self.requireConstructible(typeName, anchor: typeTok)

		try self.consume(TokenKind.leftBrace)
		// Parallel to the LAYOUT, not to the source: `fieldValues[i]` is the value for the field the
		// type declares at `i`, whatever position the literal wrote it in. `filled` is what turns an
		// unwritten slot into E3086 rather than into a zero nobody chose. `fieldBareLocal[i]` records
		// whether the literal's value for field `i` was a bare reference to a local binding — what a
		// managed field's move-in poisons (`moveInPayload`), captured here because only the parse can see it.
		var fieldValues = ValueIdArray.create()
		var filled = BoolArray.create()
		var fieldBareLocal = BoolArray.create()
		for _ in 0 upto layout.fieldCount() 'initSlots'
			fieldValues.push(0 as ValueId)
			filled.push(false)
			fieldBareLocal.push(false)
		end 'initSlots'

		try self.parseStructLiteralFields(func, layout: layout, fieldValues: fieldValues, filled: filled, fieldBareLocal: fieldBareLocal)
		let rbraceTok = try self.consume(TokenKind.rightBrace)

		// Defaults are applied BEFORE the check, which is what makes an omitted-but-defaulted field
		// legal without teaching `requireAllFieldsInitialized` a second rule. That one goes on
		// asking exactly what it always asked — "does every slot have a value by now?" — and a
		// default is simply one of the two ways a slot comes to have one. A default is a scalar literal,
		// never a managed value, so its `fieldBareLocal` stays false and its store never moves.
		self.applyFieldDefaults(layout, fieldValues: fieldValues, filled: filled, anchor: typeTok)
		try self.requireAllFieldsInitialized(layout, filled: filled, anchor: typeTok)

		return try self.emitStructLiteral(layout, fieldValues: fieldValues, fieldBareLocal: fieldBareLocal, anchor: typeTok, range: SourceRange.between(typeTok, last: rbraceTok))
	end 'parseStructLiteral'

	// The type a struct literal names: `Self` (the enclosing type) or a bare identifier. Consumes it.
	function readStructLiteralTypeName() returns ByteArray throws ParseError
		if self.at(TokenKind.selfType) 'selfLiteral'
			let tok = try self.consume(TokenKind.selfType)
			if self.enclosingType.isEmpty() 'outsideAType'
				throw ParseError.unsupported("'{tok.kind.rawValue}' outside a type declaration (`Self` names the type whose body encloses it, and there is none here)", line: tok.line, column: tok.column)
			end 'outsideAType'
			return self.enclosingType
		end 'selfLiteral'

		let nameTok = try self.consume(TokenKind.identifier)
		return nameTok.value
	end 'readStructLiteralTypeName'

	// ⭐ **E3076 — CONSTRUCTION IS RESTRICTED TO THE TYPE'S OWN BODY.** `Self{…}` and `Point{…}`
	// inside `type Point`; nothing anywhere else. An external caller goes through
	// `Point.create(…)`.
	//
	// The point is that a type gets ONE place its invariants are established. Both reference
	// compilers impose exactly this restriction under exactly this code, and it is what makes
	// `static function create` the universal shape of the corpus rather than a convention.
	//
	// The order of the two rejections is the decision: a name that is not a struct AT ALL is not a
	// constructor-restriction violation, so it reports what it actually is.
	function requireConstructible(typeName ByteArray, anchor Token) returns StructLayout throws ParseError
		// The RESTRICTION is checked before the LOOKUP, and the order is the decision: `Foo{…}`
		// outside `type Foo` is E3076 whether or not `Foo` exists, because the restriction is about
		// WHERE the literal is written, not about what it names. Asking the registry first would
		// report "no such type" for a `Point{…}` written in `main` — naming a type that is right
		// there in the file, which is a confusing answer to a question the user did not ask.
		if not self.namesEnclosingType(typeName) 'outsideItsOwnBody'
			throw ParseError.constructorRestricted(String.from(typeName), line: anchor.line, column: anchor.column)
		end 'outsideItsOwnBody'

		match self.signatures.structOf(typeName) 'declared'
			declared(layout) then return layout
			// Unreachable: `namesEnclosingType` just held, so this IS the type currently being
			// declared — and the declaration sweep recorded every `type` in the program before this
			// file's parse began. A miss means the sweep and the real parse disagree about what a
			// type declaration is, which is the drift `ProgramSignatures.declaredOutcome` panics on
			// for a constant, stated here for a type.
			undeclared then panic("requireConstructible: `type {String.from(typeName)}` is being parsed right now, but the declaration sweep never recorded it — `recordScannedType` and `parseTypeDeclaration` disagree about what opens a type declaration")
		end 'declared'
	end 'requireConstructible'

	// The `name: value` pairs inside the braces, into the LAYOUT-parallel columns. The caller has
	// consumed `{`; this leaves the cursor on `}`.
	//
	// ⚠ **EVERY FIELD IS LABELLED, INCLUDING THE FIRST — which is the opposite of a CALL's rule**
	// (`consumeArgLabel`: the first argument is positional, E2052 if labelled). They are two
	// syntaxes, not one: a call's arguments are ordered by the DECLARATION and the first needs no
	// name to find its place, while a struct literal names slots outright. So this reads its own
	// labels rather than reusing the call's, and `slotCallArgs` is not involved — there is nothing
	// to reorder, because the label IS the destination.
	function parseStructLiteralFields(func IrFunction, layout StructLayout, fieldValues ValueIdArray, filled BoolArray, fieldBareLocal BoolArray) throws ParseError
		// A struct literal may span lines — `Self{` then one `field: value` per line (the spec writes big
		// constructors this way). Newlines are skipped at each field boundary: after the `{` (here), after a
		// field's value (before the `,`/`}` test), and after the `,` (before the next field name). A single-line
		// literal has no newline to skip, so its token stream — and its codegen — is unchanged.
		self.skipNewlines()
		if self.at(TokenKind.rightBrace) 'noFields'
			return
		end 'noFields'

		// ⭐ **THE VALUES ALREADY MOVED INTO AN OWNING FIELD OF THIS LITERAL (P1.6-B2 double-free fix).** shv2
		// is move-only (no `__mm_incref`), so a single value cannot be OWNED by two fields — `Self{a: v, b: v}`
		// would drop the same String twice (refcount underflow / double-free). Each value moved into an owning
		// field is recorded here; a second reference to it at an owning field is a USE-AFTER-MOVE (E3102).
		var movedOwningValues = ValueIdArray.create()

		while true 'fieldLoop'
			let nameTok = try self.consume(TokenKind.identifier)
			try self.consume(TokenKind.colon)

			let index = try self.requireFieldIndex(layout, fieldTok: nameTok)

			let alreadyFilled = try filled.get(index) otherwise panic("parseStructLiteralFields: filled.get OOB at {index} — the columns are sized to the layout's field count")
			if alreadyFilled 'duplicate'
				throw ParseError.duplicateFieldInitializer(String.from(layout.name), fieldName: String.from(nameTok.value), line: nameTok.line, column: nameTok.column)
			end 'duplicate'

			// `parseValueExpression` (the climber plus a trailing ternary), not `parseExpression`, for
			// `parseCallArgs`' reason: a field's value is parsed INSIDE an expression that has already
			// seeded `currentBlock`, and re-seeding it would discard a short-circuit an earlier field
			// performed — while `T{f: a if c else b}` still needs the ternary. The value's start position is
			// captured first so `rhsWasBareLocalReference` can decide, after the value is parsed, whether
			// it was a bare local — a managed field's move-in poisons that source.
			let valueStart = self.pos
			let parsed = try self.parseValueExpression(func)
			let fieldType = self.signatures.fieldTypeOf(layout.name, index: index, into: self.artifact.typeNames)
			// The COERCED value is what fills the slot — `Self{v: 3}` into a `float` field stores the
			// widened f64, not the integer's bytes. A widening only ever produces a fresh scalar, so the
			// ownership questions below still read the value the source actually named.
			let value = try self.requireFieldType(layout, index: index, fieldType: fieldType, value: parsed, anchor: nameTok)
			try self.rejectDoubleOwningStore(movedOwningValues, value: parsed, fieldType: fieldType, valueStart: valueStart)

			// ⭐ **ESCAPE (P1.5-A2b): a capturing closure may not fill a struct field at CONSTRUCTION either** —
			// a `Self{op: closure}` box is the same heap slot `x.op = closure` writes (one carries only the
			// code pointer, not the env), and construction bypasses `emitFieldWrite`, so the escape gate must be
			// asked HERE too or the closure reaches lowering and panics on its unresolved env. Same message and
			// route as the field-WRITE site, positioned at the field name.
			try self.rejectEscapingClosure(value, message: "cannot store a closure that captures in field '{String.from(nameTok.value)}' of '{String.from(layout.name)}': {CapturingClosureEscapeSuffix}", tok: nameTok)

			try fieldValues.set(index, value: value) otherwise panic("parseStructLiteralFields: fieldValues.set OOB at {index} — the columns are sized to the layout's field count")
			try filled.set(index, value: true) otherwise panic("parseStructLiteralFields: filled.set OOB at {index} — the columns are sized to the layout's field count")
			try fieldBareLocal.set(index, value: self.rhsWasBareLocalReference(valueStart)) otherwise panic("parseStructLiteralFields: fieldBareLocal.set OOB at {index} — the columns are sized to the layout's field count")

			// AFTER `rhsWasBareLocalReference` reads `[valueStart, self.pos)` — skipping here first would widen
			// that window past the single-identifier value and silently mis-decide a managed field's move-in.
			self.skipNewlines()
			if not self.at(TokenKind.comma) 'endFields'
				break
			end 'endFields'
			try self.consume(TokenKind.comma)
			self.skipNewlines()
		end 'fieldLoop'
	end 'parseStructLiteralFields'

	// A field initializer / assignment must agree with the field's DECLARED type. A SCALAR field takes the
	// `checkDeclaredType` coercion-site rule (the same one a call argument, a `return` and an assignment
	// ask). A MANAGED field (a `String` or a `struct`) takes the tag-AND-name check `requireManagedPayloadArg`
	// uses for a union payload — a struct field's declared type is `named(<Struct>)` (unresolved), which the
	// tag path would read as `int` (`typeTagName(named)`), so it MUST classify first (`classifyUnionPayload`
	// resolves it to `managed(structRef)`) rather than compare the raw tag.
	//
	// It is the parser's to check and not SemanticCheck's, unlike a call ARGUMENT: a call's callee
	// may be declared in another file, but a struct literal's layout is already in hand here — the
	// parser had to have it to know the field exists at all.
	//
	// ⭐ **IT RETURNS THE VALUE THE FIELD WANTS, AND EVERY CALLER REBINDS.** A scalar field is a coercion
	// site like any other, so an int meeting a declared `float` widens (`assignableValue`) — and the
	// promoted id is a DIFFERENT SSA value from the one that was parsed. All three callers (the struct
	// literal, the field write, the self-field write) once stored the value they already held, so
	// `Self{v: 3}` into a float field wrote the integer's raw bytes into an f64 slot and read back
	// 1.5e-323. Answering with the coerced value is what makes that unwriteable rather than merely fixed
	// at three sites: the check and the conversion are ONE call, in ONE place, for all three doors.
	//
	// A MANAGED field returns its value untouched — there is no scalar widening on a pointer, and the
	// move-in the callers perform is a separate decision made downstream.
	function requireFieldType(layout StructLayout, index FieldIndex, fieldType MaxonType, value ValueId, anchor Token) returns ValueId throws ParseError
		let class = classifyUnionPayload(self.signatures, typeNames: self.artifact.typeNames, fieldType: fieldType)
		if payloadClassIsManaged(class) 'managed'
			try self.requireManagedValueMatches(payloadStorageOf(class), isString: payloadClassIsString(class), value: value, siteName: self.fieldSiteName(layout, index: index), anchor: anchor)
			return value
		end 'managed'

		// The SAME verdict-plus-coercion the assignment doors ask, noun "field" — which is what it always
		// was, spelled out a second time: the four `DeclaredTypeMatch` arms that stood here were a
		// character-for-character copy of `requireAssignable`'s, and a rule with two homes drifts.
		return try self.assignableValue(anchor, value: value, declared: maxonTypeTag(fieldType), noun: "field")
	end 'requireFieldType'

	// ⭐ **REJECT A DOUBLE-MOVE OF ONE VALUE INTO TWO OWNING FIELDS (P1.6-B2)** — the move-only guard that
	// makes `Self{a: v, b: v}` a clean E3102 instead of a double-free. A value stored into an OWNING field is
	// MOVED, not copied: an OWNED managed value (its heap object would be aliased and dropped twice), or ANY
	// TYPE-PARAMETER field (opaque in the shared body — for a MANAGED instance both fields alias and the
	// instance destructor drops both; rejected even for a trivial instance, since the body is compiled once
	// and move-only has no clone). A SCALAR field COPIES its value, and a BORROWED managed value is PROMOTED
	// to a fresh owned copy per field (`moveInPayload`), so neither aliases — both stay legal. It runs at
	// PARSE, before any move-in, so the value is still live at both references; `valueStart`'s token names and
	// positions the second use.
	function rejectDoubleOwningStore(movedOwningValues ValueIdArray, value ValueId, fieldType MaxonType, valueStart TokenIndex) throws ParseError
		if not (self.valueIsOwnedHeap(value) or maxonTypeTag(fieldType) == ValueTypeTag.typeParameter) 'copiedOrPromoted'
			return
		end 'copiedOrPromoted'
		if self.isRepeatedOwningMove(movedOwningValues, value: value) 'doubleMove'
			let valueTok = self.tokenAt(valueStart)
			throw ParseError.useAfterMove(String.from(valueTok.value), line: valueTok.line, column: valueTok.column)
		end 'doubleMove'
	end 'rejectDoubleOwningStore'

	// ⭐ **THE ONE "same owned value moved into two owning destinations" DETECTOR (P1.7 slice 3a).** shv2 is
	// move-only (no `__mm_incref`), so a single owned value cannot be OWNED by two destinations — the second owner
	// would drop a value the first already owns (a double-free). Returns true when `value` was ALREADY recorded in
	// `movedOwningValues` (a REPEAT owning move — the caller throws its own positioned E3102), else records it and
	// returns false. Shared by the STRUCT-LITERAL guard (`rejectDoubleOwningStore` — `Self{a: v, b: v}`) and the
	// CALL-ARGUMENT double-consume guard (`transferConsumedArgs` — `Pair.create(box, b: box)`), so the two sites
	// cannot drift on what a repeated owning move IS. Each caller keeps its own "is this destination OWNING?" gate
	// (an owned-heap or type-parameter field; a consuming argument position holding an owned-heap value) and its
	// own diagnostic name+position — the name is resolved only on a repeat, where the value is always a bound
	// local (a temporary is minted by one expression and cannot reach two destinations), never an anonymous temp.
	function isRepeatedOwningMove(movedOwningValues ValueIdArray, value ValueId) returns bool
		for prior in movedOwningValues 'eachPrior'
			if prior == value 'doubleMove'
				return true
			end 'doubleMove'
		end 'eachPrior'
		movedOwningValues.push(value)
		return false
	end 'isRepeatedOwningMove'

	// The `<Struct>.<field>` label a managed-field type mismatch names.
	function fieldSiteName(layout StructLayout, index FieldIndex) returns String
		let fieldName = try layout.fieldNames.get(index) otherwise panic("fieldSiteName: fieldNames.get OOB at {index}")
		return "{String.from(layout.name)}.{String.from(fieldName)}"
	end 'fieldSiteName'

	// ⭐ **A MANAGED VALUE MUST BE THE MATCHING HEAP KIND** — the ONE check a struct FIELD and a union
	// PAYLOAD share: a `String` slot takes a `string`; a `struct` slot takes a `structRef` of the SAME struct
	// name (a pointer of the wrong struct would pass a tag-only check). The names are compared through this
	// file's interner, the one the classifier's `structRef` id and the value's own id were both minted from.
	// `siteName` is the `<Type>.<field>` / `<Union>.<case>(<field>)` label the message quotes.
	function requireManagedValueMatches(storage MaxonType, isString bool, value ValueId, siteName String, anchor Token) throws ParseError
		let got = self.tagOf(value)
		let wantTag = maxonTypeTag(storage)
		if got != wantTag 'tagMismatch'
			throw ParseError.assignTypeMismatch(siteName, got: typeTagName(got), expected: typeTagName(wantTag), line: anchor.line, column: anchor.column)
		end 'tagMismatch'
		if isString 'stringOk'
			return
		end 'stringOk'

		// The tag check above (`got != wantTag`) is EXACT, so reaching here means both tags are equal — and
		// the only tag a struct/union storage and a value can share while disagreeing on aggregate identity
		// is the overloaded `named` (a boxed union slot met by a ranged-int alias value, or the reverse).
		// `namedAggregatesConflict` (extended by #59) catches that scalar-vs-aggregate case as well as two
		// distinct aggregates, and `giveTypeName` prints the scalar side's primitive rather than an empty name.
		let wantName = self.aggregateNameOf(maxonTypeTag(storage), nameId: typeNameIdOf(storage))
		let gotName = self.aggregateNameOf(self.tagOf(value), nameId: self.valueNameId(value))
		if self.signatures.aggregatesConflict(wantName, got: gotName) 'nameMismatch'
			throw ParseError.assignTypeMismatch(siteName, got: self.giveTypeName(got, aggregateName: gotName), expected: self.giveTypeName(wantTag, aggregateName: wantName), line: anchor.line, column: anchor.column)
		end 'nameMismatch'
	end 'requireManagedValueMatches'

	// ⭐ **FILL EVERY OMITTED SLOT THAT DECLARES A DEFAULT** — `export var value = 0` + `Self{}`.
	//
	// **A LITERAL-PROVIDED VALUE ALWAYS BEATS THE DEFAULT**, and `filled` is what says so: this only
	// ever looks at slots the literal did not write, so an override is not a race between two stores
	// — the default's `literal` op is never emitted at all. That is the rule
	// `field-initialization.md` states ("A literal-provided value always overrides a declared
	// default") and `literal-overrides-default` pins.
	//
	// The literal is minted at the field's STORAGE type, not its declared one: `emitLiteral` uses
	// one `MaxonType` for both the value's tag and the op's, and `maxonTypeToStdType` PANICS on a
	// `named` — so a field declared `as Integer = 7` would otherwise carry an alias into an op that
	// must be concrete by lowering. Nothing reads this value's tag (it flows straight into the
	// store), and `emitFieldStore` independently derives the same storage type for the slot, so the
	// two agree by construction.
	//
	// The span is the LITERAL's anchor — the `Self` token — and not the field declaration's, which
	// may be in another file entirely: a `SourceRange` is an offset into THIS file's bytes.
	function applyFieldDefaults(layout StructLayout, fieldValues ValueIdArray, filled BoolArray, anchor Token)
		let range = SourceRange.ofToken(anchor)
		for i in 0 upto layout.fieldCount() 'eachField'
			let wasFilled = try filled.get(i) otherwise panic("applyFieldDefaults: filled.get OOB at {i} — the column is sized to the layout's field count")
			if wasFilled 'literalWins'
				continue
			end 'literalWins'

			match layout.fieldDefault(i) 'declared'
				// The literal did not fill this slot and the declaration offers nothing. That is
				// E3086, and `requireAllFieldsInitialized` is what says so — not this function.
				none then continue
				literal(payload, tag) then self.fillFieldDefault(layout, index: i, given: ConstValue.create(payload, tag: tag), fieldValues: fieldValues, filled: filled, range: range)
			end 'declared'
		end 'eachField'
	end 'applyFieldDefaults'

	// Emit one default's `literal` and record it as slot `index`'s value. Split out so the payload
	// is bound by the match arm that proved there IS one, rather than read back out of the union
	// through an accessor with a `none` case to mishandle.
	//
	// ⭐ **THE ONE PLACE A FIELD DEFAULT IS COERCED**, and the only place it can be: `readStructFieldInto`
	// records the literal exactly as the source wrote it, because the declaration sweep it shares cannot
	// resolve a ranged-alias field type. Here the whole program IS known — `fieldTypeOf` answers `float`
	// for a `float(low to high)` alias — so a `= 3` against it widens to the f64 bit pattern. Left unpaid
	// it wrote the integer's raw bytes into an f64 slot and read back 1.5e-323.
	//
	// ⚠ **TWO QUESTIONS, AND EACH IS ASKED EXACTLY ONCE.** The RESOLVED type says whether the slot is an
	// f64 at all; the RECORDED TAG — inside `constFloatBits`, the shared primitive — says whether putting
	// `given` in it is a conversion or a no-op. That second read is the whole reason the tag is stored:
	// `= 3` and `= 3.0` are two `ParsedInt`s and nothing else once the tag is gone, so no rule anywhere
	// else in the compiler could tell them apart, and none is consulted.
	//
	// ⚠ It does NOT re-ask `widensIntToFloat` on the way in, and that is deliberate rather than an
	// oversight: `constFloatBits` already turns away a float, so a guard naming the literal's tag as well
	// would be a second, REDUNDANT read that merely LOOKS load-bearing — measured, replacing it with a
	// constant changed no test. A condition that cannot fail is worse than no condition, because the next
	// reader trusts it.
	function fillFieldDefault(layout StructLayout, index FieldIndex, given ConstValue, fieldValues ValueIdArray, filled BoolArray, range SourceRange)
		let declared = self.signatures.fieldTypeOf(layout.name, index: index, into: self.artifact.typeNames)
		let bits = self.constFloatBits(given) if tagIsFloat(maxonTypeTag(declared)) else given.payload
		let value = self.emitLiteral(bits, valueType: self.fieldStorageType(declared), range: range)

		try fieldValues.set(index, value: value) otherwise panic("fillFieldDefault: fieldValues.set OOB at {index} — the column is sized to the layout's field count")
		try filled.set(index, value: true) otherwise panic("fillFieldDefault: filled.set OOB at {index} — the column is sized to the layout's field count")
	end 'fillFieldDefault'

	// Every declared field must have been given a value — see `parseStructLiteral` for why the
	// allocator's zeroing guarantee makes an omission a WRONG ANSWER rather than a safe default,
	// and `applyFieldDefaults` for the other way a slot comes to have one.
	// Reports the FIRST omitted field, in declaration order, so the message is a function of the
	// type rather than of a hash walk.
	function requireAllFieldsInitialized(layout StructLayout, filled BoolArray, anchor Token) throws ParseError
		for i in 0 upto layout.fieldCount() 'eachField'
			let wasFilled = try filled.get(i) otherwise panic("requireAllFieldsInitialized: filled.get OOB at {i} — the column is sized to the layout's field count")
			if wasFilled 'given'
				continue
			end 'given'
			let fieldName = try layout.fieldNames.get(i) otherwise panic("requireAllFieldsInitialized: fieldNames.get OOB at {i}")
			throw ParseError.fieldNotInitialized(String.from(layout.name), fieldName: String.from(fieldName), line: anchor.line, column: anchor.column)
		end 'eachField'
	end 'requireAllFieldsInitialized'

	// Emit the box: allocate, then fill every slot. `fieldValues` is parallel to the LAYOUT.
	//
	// The result is typed `structRef(layout.name)` — which is what makes `let p = Point.create(…)`
	// bind a Point rather than an integer, since the factory returns this value and
	// `parseTypeReference` typed its `returns Self` the same way. The two meet at
	// `parseReturnStatement`'s `checkDeclaredType`, and they agree because both came from the
	// enclosing type's name.
	//
	// ⭐ **THE BOX IS ENROLLED AS AN OWNED HEAP TEMPORARY** (`trackOwnedTemp`), exactly as a boxed union
	// construct and an interpolation String are: it sets the provenance bit `valueIsOwnedHeap` reads, so a
	// binding of it drops at scope exit and an UNBOUND `Self{…}` (a struct literal passed as a borrowed
	// call argument) is freed at statement end. A `return Self{…}` moves it back OUT of the pending list
	// (`parseReturnStatement`), so the factory does not drop what it hands to its caller. It is the bit —
	// not the `structRef` tag — that owns the drop, because a borrowed struct PARAMETER also carries the
	// tag and owns nothing.
	// ⭐ **A MANAGED FIELD IS MOVED IN** (`moveInPayload`) — the struct half of static single-owner
	// ownership, the exact mirror of `emitEnumBox`'s payload move. A scalar field is stored as-is; a managed
	// field (a `String` or a nested `struct`) transfers its value into the box: a borrowed String literal is
	// promoted to an owned copy, an owned temporary is consumed out of the pending drops, a bare-local
	// reference is poisoned (E3102 on later use), and a borrowed struct is refused (`moveInPayload` — the
	// cross-call consume). The box becomes the field's sole owner, and its `__destruct_<Struct>` cascade
	// drops the field once when the box is dropped.
	function emitStructLiteral(layout StructLayout, fieldValues ValueIdArray, fieldBareLocal BoolArray, anchor Token, range SourceRange) returns ValueId throws ParseError
		let size = self.emitLiteral(layout.sizeBytes(), valueType: MaxonType.integer, range: range)
		let box = self.emitBoxAlloc(size, resultTag: ValueTypeTag.structRef, resultNameId: self.artifact.typeNames.intern(layout.name), range: range)
		self.trackOwnedTemp(box)

		for i in 0 upto layout.fieldCount() 'eachField'
			let value = try fieldValues.get(i) otherwise panic("emitStructLiteral: fieldValues.get OOB at {i} — the column is sized to the layout's field count")
			let bareLocal = try fieldBareLocal.get(i) otherwise panic("emitStructLiteral: fieldBareLocal.get OOB at {i} — the column is sized to the layout's field count")
			let fieldType = self.signatures.fieldTypeOf(layout.name, index: i, into: self.artifact.typeNames)
			let class = classifyUnionPayload(self.signatures, typeNames: self.artifact.typeNames, fieldType: fieldType)
			let stored = try self.moveInPayload(class, arg: value, argBareLocal: bareLocal, anchor: anchor, range: range)
			self.emitFieldStore(box, layout: layout, index: i, value: stored, range: range)
		end 'eachField'

		return box
	end 'emitStructLiteral'

	// ⭐ **THE THREE DOTTED EXPRESSIONS**, split here and nowhere else. The cursor is on an
	// identifier followed by `.`, and the language now spells three unrelated things that way:
	//
	//   1. `Point.create(3, y: 4)` — a QUALIFIED STATIC CALL. Recognized by the `(` at +3, which is
	//      the token neither of the others can have: `u16.max(` is not legal Maxon (a bound is a
	//      value, not a callee) and `p.x(` would be a call THROUGH a field, which needs the
	//      function-typed values P1.2 brings.
	//   2. `p.x` — a FIELD ACCESS, when the base name is bound in this function's scope. Asked
	//      SECOND and by SCOPE, which is the same "LOCAL FIRST" rule `parseVariableReference`
	//      already resolves a bare name by: a local named `u16` would shadow the sized type, exactly
	//      as a local `OFFSET` shadows a top-level constant of that name.
	//   3. `u16.max` — a TYPE-QUALIFIED NUMERIC BOUND, the fallback. It was the only dotted form the
	//      language had, and it stays the answer for a base name that is neither callable nor bound.
	//
	// The order is the decision. Testing the bound table FIRST would have to guess whether `p` is a
	// sized type before knowing `p` is a local, and `sizedTypeBound` answers `notASizedType` for
	// every struct — so `p.x` would have reported "expected a sized numeric type (u8/u16/…)" for a
	// perfectly good field read.
	//
	// `resultUsed` is passed through to the two CALL forms (the method call and the qualified static call)
	// and means what it means everywhere else: is this call's value read? It is `true` from expression
	// position and `false` from a `try` TARGET, where the try's own position decides value usability
	// (`parseTryCallTarget`). Threaded rather than pre-dispatched by the caller: an arm order lives in ONE
	// place, so a form added ahead of the method arm here cannot be silently skipped by a second copy of
	// the split. Hard-coding it `true` is what rejected a VOID throwing static under `try` — `try
	// Gate.check(1)` reported E2004 "does not return a value" for a statement whose value nobody wanted,
	// while its instance twin `try g.bump(1)` was accepted; the reference compiler takes both.
	function parseDottedPrimary(func IrFunction, resultUsed bool) returns ValueId throws ParseError
		// ⭐ **A BOUND BASE IS A VALUE, AND A VALUE OUTRANKS A TYPE NAME.** `p.x` and `p.add(10)` are
		// an instance's field and an instance's METHOD; `Point.create(10)` is a static method, and
		// `u16.max` is a bound. The base being IN SCOPE is what tells the first two from the last
		// two, and it is asked FIRST for `parseVariableReference`'s stated reason: a local binding
		// shadows a name from any wider scope, which is what every language with both does.
		//
		// ⚠ **THE `(` AT +3 IS NOT ENOUGH TO FIND A STATIC CALL**, and that is the trap this order
		// avoids: `p.add(10)` and `Point.create(10)` have IDENTICAL token shapes. Testing `(` first
		// sends `p.add(10)` to `parseQualifiedCall`, which would mangle the callee out of the
		// VARIABLE's name — `p.add`, which no file declares — and report E3004 against a method that
		// is right there in the type. `methodCallsAt` is where that scope test lives, shared with the
		// statement dispatcher.
		if self.methodCallsAt(self.pos) 'methodCall'
			return try self.parseMethodCall(func, resultUsed: resultUsed)
		end 'methodCall'

		if self.scope.contains(self.baseBindingName(self.current())) 'fieldAccess'
			return try self.parseFieldAccess()
		end 'fieldAccess'

		// A CAPTURED enclosing struct is the base (P1.5-A2b-2): `level.rawValue` inside a closure. The base is
		// not in the closure's OWN scope (the check above), but it resolves into an enclosing capture scope, so
		// `parseFieldAccess` (via `resolveFieldChain`'s captured arm) reads it out of the env. Asked BEFORE the
		// type-bound fallback for the same "a value outranks a type name" reason a local base is.
		if self.captureBinds(self.current()) 'capturedFieldAccess'
			return try self.parseFieldAccess()
		end 'capturedFieldAccess'

		// `Color.red` and `Move.walk(Direction.east)` — an ENUM CASE reference or a UNION CONSTRUCT,
		// the base being a declared enum/union. Asked AFTER the scope-based forms above (a bound base
		// outranks a type name, exactly as `u16.max` is the last resort) but BEFORE the qualified STATIC
		// CALL below, because a payload construct `Move.walk(…)` has the SAME `<name>.<name>(` shape a
		// static call does: testing `(` at +3 first would mangle it to a callee `Move.walk` no file
		// declares (E3004) rather than building the box. The two are disjoint by name — a name is one
		// type, so a struct's `Point.create(…)` never resolves as an enum here.
		// Gated on the non-allocating `containsEnum` rather than `enumOf` directly: this runs for EVERY
		// dotted primary, and `enumOf` would box a throwaway `DeclaredEnum.undeclared` for every
		// `Point.create(...)` (scale-test charged exactly that — see `ProgramSignatures.containsEnum`).
		// The `enumOf` inside the guard runs only for a real enum reference, which is rare.
		if self.signatures.containsEnum(self.current().value) 'enumRef'
			match self.signatures.enumOf(self.current().value) 'declared'
				declared(layout) then return try self.parseEnumLiteral(func, layout: layout)
				undeclared then panic("parseDottedPrimary: containsEnum answered yes but enumOf answered undeclared — the two read the same enum registry")
			end 'declared'
		end 'enumRef'

		if self.kindAt(self.pos + 3) == TokenKind.leftParen 'qualifiedCall'
			return try self.parseQualifiedCall(func, resultUsed: resultUsed)
		end 'qualifiedCall'

		return try self.parseTypeQualifiedBoundExpression()
	end 'parseDottedPrimary'

	// `Color.red` — the value of an enum/union case: its TAG, as an i64 `literal` (the raw value for
	// an int backing, the IEEE-754 bit pattern for a float). Named `Color.green` for a case the enum
	// does not have is E3034, positioned at the TYPE name (the bootstrap's anchor, measured).
	//
	// ⭐ The value is TAGGED `named(Color)` while its literal op is typed `integer`, and the two are
	// deliberately different: the TAG carries the enum's name so a `match` can recognize the scrutinee
	// as a `Color`, and the OP's `integer` type is what the Std lowering reads to give it an i64
	// (a `named` op-type would hit `maxonTypeToStdType`'s panic). Both collapse to i64, so the value's
	// register class and its lowering agree — see `emitEnumTagLiteral`.
	function parseEnumLiteral(func IrFunction, layout EnumLayout) returns ValueId throws ParseError
		let typeTok = try self.consume(TokenKind.identifier)
		try self.consume(TokenKind.dot)

		let caseTok = self.current()
		if not tokenNamesEnumCase(caseTok) 'notACaseName'
			throw ParseError.unexpectedToken("an enum case name", got: caseTok.kind.rawValue, line: caseTok.line, column: caseTok.column)
		end 'notACaseName'
		self.advance()

		let index = try self.enumCaseIndexOrThrow(layout, nameTok: caseTok, posTok: typeTok)
		let range = SourceRange.ofToken(typeTok)

		// ⭐ A PAYLOAD-BEARING union is HEAP-BOXED, and EVERY case of it takes the boxed form — a
		// payload-free case (`Container.empty`) is a bare tag in a box, so the box lifetime is uniform
		// (`isBoxed` decides once, per the union, not per the case). A payload-free enum/union stays
		// the bare-i64-tag representation P1.1b emits.
		if layout.isBoxed() 'boxedUnion'
			return try self.parseEnumBoxConstruct(func, layout: layout, caseIndex: index, caseTok: caseTok, range: range)
		end 'boxedUnion'

		// A payload-free enum/union case carries no value list. `Color.red(5)` is a payload on a
		// construct that declares none — refused rather than silently dropped.
		if self.at(TokenKind.leftParen) 'unexpectedPayload'
			let parenTok = self.current()
			throw ParseError.unsupported("a payload on case '{String.from(caseTok.value)}' of `{layout.kindWord()} {String.from(layout.name)}`, which declares no payload on any case", line: parenTok.line, column: parenTok.column)
		end 'unexpectedPayload'

		return self.emitEnumTagLiteral(layout.name, tag: layout.tagOfIndex(index), range: range)
	end 'parseEnumLiteral'

	// ⭐ **CONSTRUCT A BOXED UNION VALUE** — `Move.walk(Direction.east)`, `LexErr.pair(7, column: 13)`,
	// or a payload-free case of a boxed union (`Container.empty`). Parses the payload argument list into
	// LAYOUT-parallel slot columns (`parsePayloadArgs`), checks every declared slot was filled
	// (`requireAllPayloadsProvided`), and hands off to `emitEnumBox`, which validates each field's TYPE
	// (rejecting the managed/float ones slice 1 cannot lower) before it emits a single op.
	//
	// ⭐ **THE PAYLOAD ARGUMENT LIST FOLLOWS THE CALL-ARG RULE** — the first argument is positional, the
	// second and later are named (`consumeArgLabel`) — crossed with the struct literal's slot-by-name: a
	// named argument lands in the slot whose payload FIELD its label names, whatever position it was written
	// in. A case's payload is ordered by its declaration, so the first argument needs no name to find its
	// place; the rest do, exactly as a call's arguments do. This is where the two syntaxes meet, and it is
	// why `slotBareLocal` is captured per SLOT and not per source position — `emitEnumBox`/`moveInPayload`
	// reads `argsBareLocal[i]` for the field at slot `i`, so a reordering named argument must poison the
	// right source (get it wrong and a managed payload's move-in poisons a use-after-move or leaks).
	function parseEnumBoxConstruct(func IrFunction, layout EnumLayout, caseIndex CaseIndex, caseTok Token, range SourceRange) returns ValueId throws ParseError
		let payloads = layout.payloadsAt(caseIndex)
		let arity = layout.payloadArityAt(caseIndex)

		// LAYOUT-parallel columns, the union twin of `parseStructLiteral`'s field columns: `slotValues[i]`
		// is the value for the payload field the case declares at slot `i`, whatever position/label the
		// construct wrote it in; `filled[i]` turns an unwritten slot into a missing-argument error rather
		// than a zero nobody chose; `slotBareLocal[i]` records whether slot `i`'s value was a bare reference
		// to a local binding — what a managed payload's move-in poisons (`moveInPayload`).
		var slotValues = ValueIdArray.create()
		var filled = BoolArray.create()
		var slotBareLocal = BoolArray.create()
		for _ in 0 upto arity 'initSlots'
			slotValues.push(0 as ValueId)
			filled.push(false)
			slotBareLocal.push(false)
		end 'initSlots'

		if self.at(TokenKind.leftParen) 'withArgs'
			try self.parsePayloadArgs(func, layout: layout, payloads: payloads, slotValues: slotValues, filled: filled, slotBareLocal: slotBareLocal, caseTok: caseTok)
		end 'withArgs'

		try self.requireAllPayloadsProvided(layout, payloads: payloads, filled: filled, caseTok: caseTok)

		return try self.emitEnumBox(layout, caseIndex: caseIndex, args: slotValues, argsBareLocal: slotBareLocal, caseTok: caseTok, range: range)
	end 'parseEnumBoxConstruct'

	// Parse the `(pos, label: value, …)` payload argument list into the layout-parallel columns. The caller
	// has confirmed the `(`; this consumes it through the closing `)`. The FIRST argument is positional and
	// fills slot 0; every later argument is named and slots by the payload FIELD name it labels
	// (`payloadSlotFor`). A slot written twice is a duplicate, mirroring `parseStructLiteralFields` — a
	// payload field IS a field, so the same struct-literal diagnostics fit.
	function parsePayloadArgs(func IrFunction, layout EnumLayout, payloads PayloadFieldArray, slotValues ValueIdArray, filled BoolArray, slotBareLocal BoolArray, caseTok Token) throws ParseError
		try self.consume(TokenKind.leftParen)

		// A case that declares NO payload takes no argument LIST — it is written `U.empty`, never `U.empty()`
		// or `U.empty(x)` (both reference compilers reject the parens). Rejected before any argument is
		// parsed, because the columns are empty and every slot lookup below would be out of bounds. A
		// payload-free case with no parens skips this function entirely and constructs a bare-tag box.
		if payloads.count() == 0 'noPayload'
			throw ParseError.unsupported("a payload argument list on case '{String.from(caseTok.value)}' of `{layout.kindWord()} {String.from(layout.name)}`, which declares no payload for that case", line: caseTok.line, column: caseTok.column)
		end 'noPayload'

		var argIndex = 0 as ParamCount
		while true 'argLoop'
			// The label token anchors an unknown/duplicate-label diagnostic; captured before `consumeArgLabel`
			// consumes it, exactly as `parseCallArgs` captures `argFirstTok`.
			let labelTok = self.current()
			let label = try self.consumeArgLabel(argIndex, allowFirstNamed: false)
			let slot = try self.payloadSlotFor(layout, payloads: payloads, argIndex: argIndex, label: label, labelTok: labelTok)

			let alreadyFilled = try filled.get(slot) otherwise panic("parsePayloadArgs: filled.get OOB at slot {slot} — the columns are sized to the case's arity and payloadSlotFor returns an in-range slot")
			if alreadyFilled 'duplicate'
				throw ParseError.duplicateFieldInitializer(String.from(layout.name), fieldName: String.from(label), line: labelTok.line, column: labelTok.column)
			end 'duplicate'

			// `parseValueExpression` (the climber plus a trailing ternary), not `parseExpression`, for
			// `parseStructLiteralFields`' reason: an argument is parsed INSIDE an expression that already
			// seeded `currentBlock`. The value's start position is
			// captured first so `rhsWasBareLocalReference` can decide, after the value is parsed, whether it
			// was a bare local — a managed payload's move-in poisons that source.
			let valueStart = self.pos
			let value = try self.parseValueExpression(func)

			// ⭐ **ESCAPE (P1.5-A2b): a capturing closure may not fill a union PAYLOAD** — the payload is a heap
			// box slot that outlives the frame, so it would carry a closure whose env is gone (exactly a struct
			// field, one indirection out). Positioned at the token after the argument, matching the golden.
			let payloadField = try payloads.get(slot) otherwise panic("parsePayloadArgs: payloads.get OOB at slot {slot} — the columns are sized to the case's arity")
			try self.rejectEscapingClosure(value, message: "cannot store a closure that captures in payload '{String.from(payloadField.name)}' of case '{String.from(caseTok.value)}': {CapturingClosureEscapeSuffix}", tok: self.current())

			try slotValues.set(slot, value: value) otherwise panic("parsePayloadArgs: slotValues.set OOB at slot {slot} — the columns are sized to the case's arity")
			try filled.set(slot, value: true) otherwise panic("parsePayloadArgs: filled.set OOB at slot {slot} — the columns are sized to the case's arity")
			try slotBareLocal.set(slot, value: self.rhsWasBareLocalReference(valueStart)) otherwise panic("parsePayloadArgs: slotBareLocal.set OOB at slot {slot} — the columns are sized to the case's arity")

			argIndex = argIndex + 1

			if not self.at(TokenKind.comma) 'endArgs'
				break
			end 'endArgs'
			try self.consume(TokenKind.comma)
		end 'argLoop'

		try self.consume(TokenKind.rightParen)
	end 'parsePayloadArgs'

	// The layout SLOT a payload argument fills. Argument 0 is positional (`consumeArgLabel` guaranteed it
	// carries no label) and fills slot 0 in declaration order — the payload twin of a call's first argument
	// filling parameter 0. A later argument is named and slots by the payload FIELD name it labels; a label
	// naming no field of this case is an unknown-field error, mirroring `requireFieldIndex`. Slot 0 is in
	// range because a payload-free case never reaches the argument loop (`parsePayloadArgs` rejects its
	// parens before any lookup).
	function payloadSlotFor(layout EnumLayout, payloads PayloadFieldArray, argIndex ParamCount, label ByteArray, labelTok Token) returns CaseIndex throws ParseError
		if argIndex == 0 'positional'
			return 0 as CaseIndex
		end 'positional'

		for i in 0 upto payloads.count() 'each'
			let field = try payloads.get(i) otherwise panic("payloadSlotFor: payloadsAt returned fewer fields than its own count at {i}")
			if field.name.equals(label) 'match'
				return i
			end 'match'
		end 'each'

		throw ParseError.unknownField(String.from(layout.name), fieldName: String.from(label), line: labelTok.line, column: labelTok.column)
	end 'payloadSlotFor'

	// Every declared payload slot must have been given a value. A union payload has NO defaults (unlike a
	// struct field, so there is no `applyFieldDefaults` step here), which makes an omitted slot always an
	// error — reported at the FIRST unfilled slot in declaration order, mirroring `requireAllFieldsInitialized`,
	// so the message is a function of the case rather than of a hash walk. Anchored at the case name.
	function requireAllPayloadsProvided(layout EnumLayout, payloads PayloadFieldArray, filled BoolArray, caseTok Token) throws ParseError
		for i in 0 upto payloads.count() 'each'
			let wasFilled = try filled.get(i) otherwise panic("requireAllPayloadsProvided: filled.get OOB at {i} — the column is sized to the case's arity")
			if wasFilled 'given'
				continue
			end 'given'
			let field = try payloads.get(i) otherwise panic("requireAllPayloadsProvided: payloadsAt returned fewer fields than its own count at {i}")
			throw ParseError.fieldNotInitialized(String.from(layout.name), fieldName: String.from(field.name), line: caseTok.line, column: caseTok.column)
		end 'each'
	end 'requireAllPayloadsProvided'

	// Emit the box: validate + classify every payload field (reject float/nested-union, type-check each
	// argument) BEFORE any op, then `__mm_alloc` the `8 + maxArity*8` bytes, store the case TAG at
	// offset 0, store each payload at `8 + slot*8`, and ZERO-FILL the unused slots `[arity, maxArity)`.
	//
	// ⭐ The box is TAGGED `named(<union>)` — the same tag a scalar enum value carries, so `match`
	// recognizes it through the one `enumMatchFor` door — and enrolled as an OWNED HEAP TEMPORARY
	// (`trackOwnedTemp`), so `parseBinding` binds its drop to scope exit and an unbound `Move.walk(5)`
	// statement is freed at statement end.
	//
	// ⭐ **A MANAGED PAYLOAD IS MOVED IN** (`moveInPayload`) — no incref, no copy of an owned value. The
	// box owns the payload after the store; the source binding is poisoned (E3102) and an owned temporary
	// is removed from the statement's pending drops. A wholly-scalar union keeps slice 1's trivial
	// destructor; a managed one drops through `__destruct_<U>` (see `emitDecref`/`synthesizeUnionDestructor`).
	//
	// ⚠ **THE ZERO-FILL IS MANDATORY** even though the slab returns zeroed memory: it pins a
	// deterministic 0 in a narrow case's unused slots, and a NULL slot is exactly what the cascade's
	// null-guard skips — so a zeroed managed slot is never decref'd as a bogus pointer.
	function emitEnumBox(layout EnumLayout, caseIndex CaseIndex, args ValueIdArray, argsBareLocal BoolArray, caseTok Token, range SourceRange) returns ValueId throws ParseError
		let payloads = layout.payloadsAt(caseIndex)

		// Validate + classify every field before emitting a single op — a refused payload emits no code.
		var classes = PayloadClassArray.create()
		for i in 0 upto payloads.count() 'validate'
			let field = try payloads.get(i) otherwise panic("emitEnumBox: payloadsAt returned fewer fields than its own count at {i}")
			let class = try self.requirePayloadLowerable(field, layout: layout, posTok: caseTok)
			let arg = try args.get(i) otherwise panic("emitEnumBox: args.count() was checked to equal the arity but get OOB at {i}")
			try self.requirePayloadArgType(field, class: class, value: arg, layout: layout, caseTok: caseTok)
			classes.push(class)
		end 'validate'

		let size = self.emitLiteral(layout.boxSizeBytes(), valueType: MaxonType.integer, range: range)
		let box = self.emitBoxAlloc(size, resultTag: ValueTypeTag.named, resultNameId: self.artifact.typeNames.intern(layout.name), range: range)
		self.trackOwnedTemp(box)

		self.emitUnionTagStore(box, tag: layout.tagOfIndex(caseIndex), range: range)

		for i in 0 upto payloads.count() 'storeEach'
			let arg = try args.get(i) otherwise panic("emitEnumBox: args.get OOB at {i} after the arity check")
			let class = try classes.get(i) otherwise panic("emitEnumBox: classes.get OOB at {i} — it is filled in lockstep with the fields")
			let bareLocal = try argsBareLocal.get(i) otherwise panic("emitEnumBox: argsBareLocal.get OOB at {i} — captured in lockstep with the args")
			let stored = try self.moveInPayload(class, arg: arg, argBareLocal: bareLocal, anchor: caseTok, range: range)
			self.emitIndirectStore(box, offset: layout.payloadSlotOffset(i), value: stored, storageType: payloadStorageOf(class), range: range)
		end 'storeEach'

		for j in payloads.count() upto layout.maxPayloadArity() 'zeroFill'
			let zero = self.emitLiteral(0 as ParsedInt, valueType: MaxonType.integer, range: range)
			self.emitIndirectStore(box, offset: layout.payloadSlotOffset(j), value: zero, storageType: MaxonType.integer, range: range)
		end 'zeroFill'

		return box
	end 'emitEnumBox'

	// ⭐ **MOVE A MANAGED VALUE INTO DURABLE STORAGE** — a union payload slot or a struct field, the
	// construct half of static single-owner ownership and the mirror of `parseBinding`'s move-on-bind. A
	// scalar is stored as-is. A managed value transfers into the box, which becomes its sole owner:
	//   • a BORROWED String literal/param is PROMOTED to an owned heap copy first (`promoteToOwnedString`),
	//     so the box owns a droppable payload — the copy is a fresh temp, removed from the pending list;
	//   • an already-OWNED value (an owned String, an interpolation temp, an owned struct/union box, a
	//     CONSUMED param — one the analysis enrolled as owned) is transferred: a bare-local reference is
	//     POISONED (E3102 on later use), an owned temporary is removed from the pending drops. No incref, no
	//     copy.
	//   • a BORROWED struct/union value (a borrowed param, a borrowed field read, a non-consumed argument)
	//     has NO clone, so it cannot be moved into durable storage without the caller keeping a live
	//     reference the box would dangle behind — that is the cross-call CONSUME the call-graph fixpoint
	//     owns, deferred here to a clean `E2015` rather than a silent double-free. (A String is the one
	//     managed kind with a promote, so a borrowed String never reaches this refusal.)
	function moveInPayload(class PayloadClass, arg ValueId, argBareLocal bool, anchor Token, range SourceRange) returns ValueId throws ParseError
		if not payloadClassIsManaged(class) 'scalar'
			return arg
		end 'scalar'
		return try self.moveManagedValueInto(arg, argBareLocal: argBareLocal, isString: payloadClassIsString(class), anchor: anchor, range: range)
	end 'moveInPayload'

	// ⭐ **MOVE AN ALREADY-CLASSIFIED-MANAGED VALUE INTO DURABLE STORAGE** — the core of `moveInPayload`,
	// factored out so a struct field / union payload (`moveInPayload`) and an ARRAY element (P1.7 slice 3,
	// `moveElementIntoArray`) share the ONE transfer rule and cannot drift on it. A borrowed String is promoted
	// to an owned copy (a fresh temp de-listed); an owned managed value is transferred (bare local poisoned,
	// temp de-listed); a borrowed struct/union is refused (no clone). Precondition: the value is managed.
	function moveManagedValueInto(arg ValueId, argBareLocal bool, isString bool, anchor Token, range SourceRange) returns ValueId throws ParseError
		if isString 'string'
			if not self.valueIsOwnedHeap(arg) 'promoteBorrowed'
				// A borrowed String literal/param — copy its bytes into a fresh owned record the box can drop.
				let owned = self.promoteToOwnedString(arg, range: range)
				self.removeFromPendingTemps(owned)
				return owned
			end 'promoteBorrowed'
		end 'string' else 'structOrUnion'
			if not self.valueIsOwnedHeap(arg) 'borrowedManaged'
				throw ParseError.unsupported("moving a borrowed struct/union value into durable storage (a struct field, a union payload, or an array element) — a struct/union has no `clone`, so ownership must transfer, and a borrowed value's owner keeps a live reference; passing a borrowed parameter at a consuming position is the transitive-consume case handled by the call-graph fixpoint (P1.4a wave 2+)", line: anchor.line, column: anchor.column)
			end 'borrowedManaged'
		end 'structOrUnion'

		// An already-owned managed value moves out of its source into the box.
		try self.transferOwnedInto(arg, argBareLocal: argBareLocal, anchor: anchor)
		return arg
	end 'moveManagedValueInto'

	// Transfer an already-OWNED managed value into durable storage: a bare-local reference to a binding is
	// POISONED (`movedFrom` — E3102 on later use); an owned temporary is removed from the statement's pending
	// drops (the box owns it now). THE one place the "who no longer owns this value" bookkeeping lives, so a
	// union payload move and a struct-field move cannot drift on it.
	function transferOwnedInto(arg ValueId, argBareLocal bool, anchor Token) throws ParseError
		if argBareLocal 'moveOnBind'
			try self.poisonMoveSource(arg, anchor: anchor)
		end 'moveOnBind' else 'consumeTemp'
			self.removeFromPendingTemps(arg)
		end 'consumeTemp'
	end 'transferOwnedInto'

	// Store the case TAG at the box's offset 0 as an i64 — the same i64 tag `emitEnumTagLiteral` mints
	// for a bare enum and the same `match` loads back to dispatch, so construct and match cannot
	// disagree about what a case's tag is.
	function emitUnionTagStore(box ValueId, tag ParsedInt, range SourceRange)
		let tagLit = self.emitLiteral(tag, valueType: MaxonType.integer, range: range)
		self.emitIndirectStore(box, offset: UnionTagOffset, value: tagLit, storageType: MaxonType.integer, range: range)
	end 'emitUnionTagStore'

	// Classify a payload field's storage, rejecting the ones this rung's UNION-payload store cannot lower —
	// a FLOAT (needs the bitcast ops a later rung adds) and a NESTED boxed-union payload. A SCALAR, a
	// String, and a struct are lowerable; the returned class carries the storage type and, for a managed
	// payload, whether it is a String. The reject is at the construct/extract USE site (not the
	// declaration), so the tolerant enum sweep never truncates a layout over it.
	//
	// ⚠ **THE nestedUnion REJECT IS THE UNION-PAYLOAD SITE'S ALONE — a boxed-union STRUCT FIELD lowers.**
	// A boxed union is now a MANAGED class (its move-in and drop are wired), so a boxed-union struct FIELD
	// is constructible (its store width comes from `fieldStorageType` → i64). But a union PAYLOAD's store
	// width comes from `payloadStorageOf`, which for a `nestedUnion` is the `named(<union>)` type — and
	// `maxonTypeToStdType` PANICS on a `named`. Storing a boxed-union payload IN A BOX needs the payload
	// slot's width derived the field way (a follow-up slice); until then this refuses it cleanly rather
	// than panic the lowering. Only `emitEnumBox`/`emitUnionPayloadLoad` call this — the struct-field path
	// classifies through `classifyUnionPayload` directly and never reaches here.
	function requirePayloadLowerable(field PayloadField, layout EnumLayout, posTok Token) returns PayloadClass throws ParseError
		// The payload's `declaredType` is a signatures-layout id; adopt it into this file's interner
		// before classifying, or a ranged alias that shifts the interning order makes `classifyUnionPayload`
		// read the wrong name off the id — the wrong E3005 reject (OPEN #52). `adoptType` re-interns by NAME.
		let class = classifyUnionPayload(self.signatures, typeNames: self.artifact.typeNames, fieldType: self.signatures.adoptType(field.declaredType, into: self.artifact.typeNames))
		match class 'c'
			scalar then break 'c'
			managed then break 'c'
			undeclaredName then break 'c'
			floatPayload then throw ParseError.unsupported(self.floatPayloadMessage(field, layout: layout), line: posTok.line, column: posTok.column)
			nestedUnion(storage) then throw ParseError.unsupported(self.nestedUnionPayloadMessage(field, layout: layout, typeName: self.boxedUnionDisplay(storage)), line: posTok.line, column: posTok.column)
		end 'c'
		return class
	end 'requirePayloadLowerable'

	// The "union U"/"enum U" text a boxed-union payload's rejection message names, derived from the payload's
	// `named(<union>)` storage type — a COLD path (only a nested-union-payload reject reaches it), which is why
	// `nestedUnion` carries the type rather than a precomputed `String` every classification would allocate.
	// The storage id lives in this file's interner (`classifyUnionPayload` adopted it), and it always names a
	// declared boxed union (that is what made the classification `nestedUnion`).
	function boxedUnionDisplay(storage MaxonType) returns String
		let name = try self.artifact.typeNames.nameOf(typeNameIdOf(storage)) otherwise panic("boxedUnionDisplay: a nestedUnion storage type's id is not in this file's interner — classifyUnionPayload adopts it before classifying")
		match self.signatures.enumOf(name) 'e'
			declared(layout) then return "{layout.kindWord()} {String.from(name)}"
			undeclared then panic("boxedUnionDisplay: '{String.from(name)}' names no declared enum/union — classifyUnionPayload classifies `nestedUnion` only for a boxed EnumLayout")
		end 'e'
	end 'boxedUnionDisplay'

	// A payload argument must agree with its field's classified type. A SCALAR uses `checkDeclaredType`,
	// the same coercion-site rule a struct literal field, a call argument and a `return` ask; a MANAGED
	// payload requires the matching heap kind (a String, or a struct of the same name). Anchored at the
	// case name (the whole construct's anchor); no per-argument span is tracked at this rung.
	function requirePayloadArgType(field PayloadField, class PayloadClass, value ValueId, layout EnumLayout, caseTok Token) throws ParseError
		match class 'c'
			scalar then try self.requireScalarPayloadArg(field, value: value, layout: layout, caseTok: caseTok)
			managed(storage, isString) then try self.requireManagedPayloadArg(field, storage: storage, isString: isString, value: value, layout: layout, caseTok: caseTok)
			// An undeclared payload name is a user error TypeResolution reports (E3011); the op is kept
			// well-formed for the instant before the pipeline's error gate throws — nothing to check here.
			undeclaredName then break 'c'
			floatPayload then panic("requirePayloadArgType: a float payload reached the arg check — requirePayloadLowerable rejects it first")
			nestedUnion then panic("requirePayloadArgType: a nested-union payload reached the arg check — requirePayloadLowerable rejects it first")
		end 'c'
	end 'requirePayloadArgType'

	function requireScalarPayloadArg(field PayloadField, value ValueId, layout EnumLayout, caseTok Token) throws ParseError
		let declared = maxonTypeTag(field.declaredType)
		let got = self.tagOf(value)
		match checkDeclaredType(got, declared: declared) 'declared'
			ok then break 'declared'
			mismatch then throw ParseError.assignTypeMismatch("{String.from(layout.name)}.{String.from(caseTok.value)}({String.from(field.name)})", got: typeTagName(got), expected: typeTagName(declared), line: caseTok.line, column: caseTok.column)
			narrowsFloatToInt then throw ParseError.implicitNarrowing(typeTagName(got), targetType: typeTagName(declared), line: caseTok.line, column: caseTok.column)
			// A FUNCTION VALUE into a scalar union PAYLOAD (P1.5-A1) — unreachable by A1's enabled cases (a
			// function value in a union payload co-lands with closures at P1.5-A2, where a function-typed
			// payload is functionized like a struct field). The arm keeps the `match` exhaustive with the
			// shared E3005; A2 supplies the accept path.
			functionIntoNonFunction then throw ParseError.functionValueIntoNonFunction("payload", name: String.from(field.name), heldType: typeTagName(declared), line: caseTok.line, column: caseTok.column)
		end 'declared'
	end 'requireScalarPayloadArg'

	// A managed payload argument must be the matching heap kind — the union-payload caller of the shared
	// `requireManagedValueMatches`, naming its site `<Union>.<case>(<field>)`.
	function requireManagedPayloadArg(field PayloadField, storage MaxonType, isString bool, value ValueId, layout EnumLayout, caseTok Token) throws ParseError
		try self.requireManagedValueMatches(storage, isString: isString, value: value, siteName: "{String.from(layout.name)}.{String.from(caseTok.value)}({String.from(field.name)})", anchor: caseTok)
	end 'requireManagedPayloadArg'

	// Load a boxed union's i64 TAG from offset 0 — the DISPATCH SUBJECT a `match` compares against
	// each case's tag. Its result is `integer`-tagged (a plain i64), not `named`, so the dispatch
	// compare is an i64 equality the E3066 union guard never sees. Loaded ONCE per match (it dominates
	// every arm's test block). Mirrors v1's `matchDispatchSubject`.
	function emitUnionTagLoad(box ValueId, range SourceRange) returns ValueId
		return self.emitIndirectLoad(MaxonType.integer, box: box, offset: UnionTagOffset, storageType: MaxonType.integer, range: range)
	end 'emitUnionTagLoad'

	// Load a payload field out of the box at `8 + slot*8` — the `emitFieldLoad` split, one op further.
	// A SCALAR is minted at the field's DECLARED type (so a nested `match dir` sees a `Direction`, and the
	// shift rule reads a ranged alias's low bound); a MANAGED payload is minted at its concrete storage
	// type (`structRef`/`string`) so an extracted struct's field access (`b.mass`) resolves and its
	// ownership is read off the tag. The op carries the concrete storage width in both cases
	// (`maxonTypeToStdType` panics on a `named`). `requirePayloadLowerable` rejects float/nested here.
	function emitUnionPayloadLoad(box ValueId, field PayloadField, slot CaseIndex, layout EnumLayout, posTok Token, range SourceRange) returns ValueId throws ParseError
		let class = try self.requirePayloadLowerable(field, layout: layout, posTok: posTok)
		let storage = payloadStorageOf(class)
		// A scalar payload's loaded value is tagged with its DECLARED type (an enum payload stays
		// `named(<Enum>)` so a nested `match` recognizes it); adopt that id into this file's interner
		// or the minted value carries a signatures id `enumMatchFor` would misresolve (OPEN #52).
		let valueType = payloadValueTypeOf(class, declared: self.signatures.adoptType(field.declaredType, into: self.artifact.typeNames))
		return self.emitIndirectLoad(valueType, box: box, offset: layout.payloadSlotOffset(slot), storageType: storage, range: range)
	end 'emitUnionPayloadLoad'

	// Emit a case's TAG as an i64 `literal` whose VALUE tag is `named(<enum>)`. The one site that
	// mints an enum value, so the tag/op-type split (see `parseEnumLiteral`) lives in exactly one
	// place. The const is deliberately NOT recorded (an enum value is not folded into arithmetic — it
	// is only ever a `match` scrutinee), mirroring `emitLiteralIn`, which records a constant only for
	// an `integer`-TAGGED value.
	function emitEnumTagLiteral(enumName ByteArray, tag ParsedInt, range SourceRange) returns ValueId
		let nameId = self.artifact.typeNames.intern(enumName)
		let result = self.mintValue(ValueTypeTag.named, nameId: nameId)
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.literal(result, value: tag, valueType: MaxonType.integer), range: range)
		return result
	end 'emitEnumTagLiteral'

	// `Point.create(3, y: 4)` — a call to a type's static method.
	//
	// It is an ORDINARY call with a mangled name, and that is the whole implementation: the callee
	// is `Point.create`, which is exactly the key `parseFunction` declared the method under
	// (`declaredMethodName`), so `emitCall` types the result from the signature index and
	// `slotCallArgs` reorders `y: 4` against the declaration — the SAME slotting every free call
	// gets, not a second one. A static method has no receiver, so there is nothing else to pass.
	//
	// ⚠ The base is NOT checked to be a declared type here, and that is deliberate rather than
	// missing: `Foo.bar()` where `Foo` is nothing at all resolves to a callee `Foo.bar` that no file
	// declares, which `SemanticCheck.validateCall` reports as E3004 — the authority for "no such
	// function", reading the registry the real parse built. A check here would be a second opinion
	// from the tolerant sweep, and the sweep must never own a veto (see `CalleeReturn.undeclared`).
	//
	// ⚠ **`Adder.add(5)` — AN INSTANCE METHOD NAMED STATICALLY — REACHES HERE, AND IS REJECTED BY
	// ARITY RATHER THAN BY WHAT IT IS.** It carries no receiver, so its argument list is one short
	// of the signature (whose parameter 0 is `SelfParamName`) and `validateCall` reports E3036. The
	// program is refused, which is right, but it is refused for the wrong reason and the honest fix
	// is a diagnostic that says an instance method needs a receiver — which no corpus case covers,
	// so it is recorded rather than invented here. (The COUNTS that E3036 carries are inflated by
	// the receiver, which is not this routine's doing and is not restated here — see the receiver
	// prepend in `parseCallNamed`, the one place that causes it, for both callers.)
	function parseQualifiedCall(func IrFunction, resultUsed bool) returns ValueId throws ParseError
		let typeTok = try self.consume(TokenKind.identifier)

		// `IntArray.create()` — a static call on an `Array` instance alias (P1.7 slice 1). Intercepted before
		// the generic-alias → base rewrite below (which would mangle it to `Array.create`, a callee no file
		// declares): `Array` has no base struct, so its statics lower to the array runtime, not a user method.
		if self.signatures.isGenericAlias(typeTok.value) and self.signatures.isArrayInstance(self.signatures.genericAliasInstance(typeTok.value)) 'arrayStatic'
			return try self.parseArrayStaticCall(typeTok, giid: self.signatures.genericAliasInstance(typeTok.value))
		end 'arrayStatic'

		// `IntSet.create()` — a static call on a `Set` instance alias (P1.7b slice A), intercepted before the
		// generic-alias → base rewrite (which would mangle it to `Set.create`, a callee no file declares):
		// `Set` has no base struct, so its statics lower to the set runtime, not a user method.
		if self.signatures.isGenericAlias(typeTok.value) and self.signatures.isSetInstance(self.signatures.genericAliasInstance(typeTok.value)) 'setStatic'
			return try self.parseSetStaticCall(typeTok, giid: self.signatures.genericAliasInstance(typeTok.value))
		end 'setStatic'

		// `ElementArray.create()` — a static call on a NESTED generic-instance alias inside the enclosing
		// generic body (P1.7 slice 3b-i). The bare member is recognized against `enclosingInnerAliases` and
		// qualified to the whole-program `Container.ElementArray` key (the same name the field type carries),
		// which resolves to the OPAQUE array instance `Array with typeParameter(pos)`. Intercepted here for the
		// same reason the top-level `arrayStatic` case is: `Array` has no base struct to mangle a `.create` onto.
		if self.enclosingInnerAliases.contains(typeTok.value) 'innerAlias'
			let qualified = joinQualifiedName(self.enclosingType, member: typeTok.value)
			if self.signatures.isGenericAlias(qualified) and self.signatures.isArrayInstance(self.signatures.genericAliasInstance(qualified)) 'innerArrayStatic'
				return try self.parseArrayStaticCall(typeTok, giid: self.signatures.genericAliasInstance(qualified))
			end 'innerArrayStatic'
		end 'innerAlias'

		try self.consume(TokenKind.dot)
		let result = try self.parseCallNamed(func, callee: qualifiedMethodName(self.qualifiedCallBaseName(typeTok.value), methodName: self.current().value), anchor: typeTok, receiver: ReceiverArg.none, resultUsed: resultUsed, constructorInstance: self.constructorInstanceOf(typeTok.value))
		self.retypeGenericAliasConstructorResult(result, aliasName: typeTok.value)
		return result
	end 'parseQualifiedCall'

	// The concrete instance a `Type.method(…)` call constructs (P1.6-B2) — an `instance(gid)` when `Type` is
	// a generic-instance alias (`StrBox`), so the caller-side consume can move its managed arguments into the
	// owning box; `none` for a plain type's static method. It reads the whole-program index, complete in the
	// real parse (during the tolerant sweep `isGenericAlias` answers no, so the consume simply does not fire —
	// which is sound: the sweep's artifact is discarded).
	function constructorInstanceOf(baseName ByteArray) returns ConstructorInstance
		if self.signatures.isGenericAlias(baseName) 'genericAlias'
			return ConstructorInstance.instance(self.signatures.genericAliasInstance(baseName))
		end 'genericAlias'
		return ConstructorInstance.none
	end 'constructorInstanceOf'

	// ⭐ **A GENERIC-ALIAS CONSTRUCTOR'S RESULT IS THE INSTANCE, not the base struct (P1.6-B1).**
	// `BoolSizer.create(…)` links to `Sizer.create`, which returns `Self` — the BASE struct `Sizer`
	// (`structRef`) — because the shared body is compiled once against the opaque `T`. But the VALUE is a
	// `Sizer with bool`, and dictionary-passing needs that instance identity ON the value so a later
	// `s.typeSize()` can pass the right layout descriptor. So when the result adopted the base struct's
	// type, retype it to `genericInstance(gid)`, carrying the gid the method call site reads out of the
	// value's name column. A method returning a SCALAR (`typeSize() returns Integer`) or a DIFFERENT struct
	// keeps its type — only a `Self`/base-struct return is the instance, which the base-id guard enforces.
	function retypeGenericAliasConstructorResult(result ValueId, aliasName ByteArray)
		if not self.signatures.isGenericAlias(aliasName) 'notAlias'
			return
		end 'notAlias'
		if self.tagOf(result) != ValueTypeTag.structRef 'notBaseStruct'
			return
		end 'notBaseStruct'

		let gid = self.signatures.genericAliasInstance(aliasName)
		let baseId = self.artifact.typeNames.intern(self.signatures.genericInstanceBaseName(gid))
		let resultNameId = try self.valueNameIds.get(result) otherwise panic("retypeGenericAliasConstructorResult: result v{result} has no name-id — the two type columns are dense and in lockstep")
		if resultNameId != baseId 'notThisBase'
			return
		end 'notThisBase'
		self.retypeValue(result, valueType: MaxonType.genericInstance(gid))
		// ⭐ Carry the FACTORY's instance-alias provenance onto the result (P1.6-C), so a later
		// `w.getTag()` / `w.setTag(…)` on this value can re-qualify an inner-alias return/parameter to
		// `WrapperA.Idx`. The shared gid cannot recover `WrapperA`; only the syntactic `aliasName` here can.
		self.recordValueInstanceAlias(result, aliasName: aliasName)
	end 'retypeGenericAliasConstructorResult'

	// ⭐ **THE STRUCT A QUALIFIED CALL'S METHOD IS DECLARED ON (P1.6-A).** A generic-instance alias
	// (`IntBox`) dispatches its static methods to the BASE struct (`Box`) — the SHARED body compiled once
	// against the opaque type parameter, so `IntBox.create` links to `@Box.create`, byte-identical to the
	// equivalent monomorphic call. Every other name (a plain struct, `Self`) is already its own base.
	function qualifiedCallBaseName(name ByteArray) returns ByteArray
		if self.signatures.isGenericAlias(name) 'genericAlias'
			return self.signatures.genericInstanceBaseName(self.signatures.genericAliasInstance(name))
		end 'genericAlias'
		return name
	end 'qualifiedCallBaseName'

	// ⭐ **`p.add(10)` / `self.add(10)` — AN INSTANCE METHOD CALL, WHICH IS AN ORDINARY DIRECT CALL
	// WITH ONE EXTRA ARGUMENT.**
	//
	// The callee is `Adder.add` — mangled from the RECEIVER'S DECLARED TYPE and the method name,
	// which is exactly the key `parseFunction` declared it under (`declaredMethodName`), the same
	// key `Point.create` is linked by. So the result is typed from the signature index, arguments
	// are slotted by `slotCallArgs`, arity and labels are validated by `SemanticCheck`, and the
	// backend passes the receiver in argument register 0 — none of which learns that methods exist.
	//
	// **THE RECEIVER IS PREPENDED AS ARGUMENT 0, AND THAT IS THE ENTIRE DISPATCH MECHANISM.** It
	// pairs with the `SelfParamName` parameter `parseFunction` pushed at position 0: the call's
	// first argument is POSITIONAL, so `slotCallArgs` puts it at position 0 without being told
	// anything, and the user's `10` — also positional, at index 1 — lands on the first user
	// parameter. The two halves meet through the ordinary label rules and nothing else.
	//
	// ⭐ **THE RECEIVER IS BORROWED — the callee neither owns it nor drops it.** It is passed as a
	// parameter, and a parameter is not owned by the callee: the CALLER owns the +1, so no incref
	// is emitted here and no drop is emitted there. The receiver's box is dropped by the binding
	// that owns it, at ITS scope exit (`ownedBindings`), which is why `c.increment()` twice over
	// followed by `c.getCount()` is well-defined and returns 42 rather than reading freed memory.
	// Both references agree for the receiver specifically — the bootstrap gives `self`
	// `OwnershipFlags.IsParam`, and v1's `__self` is param 0, which its refcounter treats as a
	// borrow — so this is not the borrow-vs-consume ruling struct-typed PARAMETERS are deferred
	// for. A consume would have to be a SINK: a store of the RECEIVER into heap storage, or its
	// passing to a callee that consumes it.
	//
	// ⚠ **THE SINK IS UNREACHABLE BECAUSE `self` IS NOT A VALUE — NOT BECAUSE FIELDS ARE SCALAR.**
	// This comment claimed the latter ("this rung has scalar and float fields only, so there is
	// nowhere to store it") and it is FALSE, measured: `var next as Node` inside `type Node` is a
	// legal struct-typed field (`parseTypeReference` mints a `structRef` for the enclosing type's
	// own name), and `function link(other Node) → next = other` compiles TODAY, to
	// `storeBaseDispReg.word64 [rcx + 8], rdx`. Heap storage, holding a struct pointer, with no
	// incref. The sink exists. What does not exist is a way to put THE RECEIVER in it:
	// `parseSelfPrimary` refuses a bare `self` as a value, so `next = self` never parses. That
	// refusal is the whole load-bearing mechanism, and it lives one function away — which is
	// exactly why it is named here rather than left to be re-derived. The absence of an incref on
	// the receiver is correct; the reason previously written down was not the reason.
	//
	// ⚠ **THE RUNG THAT MAKES THE SINK REPRESENTABLE MUST REVISIT THIS**, and it is the one that
	// gives a field a struct or `String` type — a method that stores `self` into durable storage is
	// real and the stdlib exercises it. It inherits TWO things, not one: this receiver-ownership
	// question, and the `next = other` store above, which is a live un-increfed store that no
	// analysis checks (`requireStructBase` refuses every path that could OBSERVE such a field, so
	// nothing today can read the dangling pointer back out — that is containment, not a fix). v1
	// does not assert "the receiver is borrowed" anywhere: it FALLS OUT of `__self` being param 0
	// plus a structural per-param consume analysis (`ParamConsumeAnalysis.maxon:5-13`). shv2 will
	// need that analysis at the moment a sink can be written, and not before.
	function parseMethodCall(func IrFunction, resultUsed bool) returns ValueId throws ParseError
		let baseTok = self.current()
		if self.scope.contains(self.baseBindingName(baseTok)) 'localReceiver'
			return try self.dispatchMethodOnBinding(func, binding: self.scope.getInfo(self.baseBindingName(baseTok)), baseTok: baseTok, resultUsed: resultUsed)
		end 'localReceiver'

		// A CAPTURED enclosing receiver (P1.5-A2b-2): `b.doubled()` inside a closure that captures the
		// struct `b`. The base is not in the closure's OWN scope (checked above) but resolves into an
		// enclosing one.
		//
		// ⚠⚠ **IT IS ASKED BEFORE THE TOP-LEVEL FALL-THROUGH, AND THAT ORDER *IS* THE SHADOWING RULE —
		// ONE RULE, ENCODED IN THREE PLACES, WHICH IS WHY EACH OF THEM SAYS SO.** `parseVariableReference`
		// states it for a bare read ("an enclosing local that SHADOWS a same-named global is caught as the
		// capture it is, not silently resolved to the global — a wrong answer"), and `methodCallsAt` asks
		// its two membership tests in the same order. A method RECEIVER is the same name in the same
		// position, so it must resolve to the same binding.
		//
		// This arm sat BELOW the managed one until the P1.7-slice-2a review, and the inversion was a LIVE
		// wrong answer rather than a latent one. With a top-level `var msg = "GLOBAL-TWELVE"` and a
		// `let msg = "ab"` in `main`, a closure body read the CAPTURE for `{msg}` (printing `ab`) and the
		// GLOBAL for `msg.byteLength()` (yielding 13) — two resolutions of one name, in one expression,
		// neither of them a compile error. The `var` half is the worse one: a `var` receiver is WRITABLE,
		// so a mutating method would have written the global while the program named a local.
		match try self.captureScopeOf(baseTok) 'captured'
			found(enclosing) then return try self.capturedMethodCall(func, baseTok: baseTok, enclosing: enclosing, resultUsed: resultUsed)
			notCaptured then break 'captured'
		end 'captured'

		// ⭐ **A TOP-LEVEL MANAGED BINDING IS A RECEIVER** — a `let` (`Live.count()`, `name.byteLength()`,
		// P1.7a) or a `var` (`msg.append("!")`, `Buffer.count()`, P1.7 slice 2a). Neither is a binding in
		// scope and neither is a capture, so without this arm the base reads as a TYPE NAME and the call is
		// mangled to a callee `Live.count` no file declares (E3004, measured).
		//
		// It materializes the receiver and then hands it to the SAME `dispatchMethodOnBinding` a local
		// receiver goes through, wearing a SYNTHETIC binding. That is not a shortcut: the dispatch already
		// routes by TAG (String / Array / Set / conformer / struct) and already enforces the one
		// immutable-receiver rule (`noteReceiverWrite`, E3019). Re-deciding either here would be a
		// second copy of both.
		//
		// ⭐ **THE TWO KINDS ARE TOLD APART BY MATCHING THE RESOLUTION, NOT BY RE-ASKING FOR IT.** Past the
		// gate this resolves the base ONCE and dispatches on the arms; it used to test a predicate that
		// resolved it and then resolve it again to build the receiver. The `let` and the `var` differ in
		// exactly two places — where the value comes from and whether the binding is mutable — and
		// `mutable` is what makes `Live.push(1)` an E3019 while `Buffer.push(1)` is legal.
		//
		// A `none` here is a base spelled like a managed binding but not VISIBLE from this file. It cannot
		// arrive through `methodCallsAt` (which resolved the same answer and declined the shape), and with
		// the capture already ruled out above there is nothing left for it to be — so it joins the gate's
		// own `false` at the one impossible-state panic below rather than getting an arm of its own.
		//
		// ⭐ **A `var` RECEIVER IS THE SLOT'S CURRENT OCCUPANT, LOADED — AND IT IS NOT STORED BACK.** Every
		// receiver-writing method rewrites the RECORD in place and never moves it: `__str_append` grows a
		// String through `buffer@0`/`length@8`, and an `Array`'s `push`/`set`/`clear` detach or rewrite the
		// element buffer while the 48-byte record stays put (`parseArrayMethodCall` states the same
		// invariant for a local receiver). So the pointer in the `.data` slot is still the right pointer
		// after the call, and a store-back would be a second write of a value that did not change. The
		// loaded pointer is BORROWED — the slot owns it (see `emitGlobalLoad`) — so nothing drops it here
		// and `__maxon_global_cleanup` releases it at exit.
		//
		// A `let`'s literal is re-materialized at the use, exactly as a bare reference to it would be.
		if self.managedTopLevelBaseAt(self.pos) 'managedTopLevelBase'
			match self.managedReceiverBindingOf(baseTok) 'binding'
				constant(bytes, kind) then return try self.dispatchOnManagedReceiver(func, baseTok: baseTok, value: try self.emitManagedConstant(bytes, kind: kind, range: SourceRange.ofToken(baseTok)), varType: self.signatures.managedConstValueType(kind), mutable: false, resultUsed: resultUsed)
				global(label, valueType, mutable) then return try self.dispatchOnManagedReceiver(func, baseTok: baseTok, value: self.emitGlobalLoad(label, valueType: valueType, range: SourceRange.ofToken(baseTok)), varType: valueType, mutable: mutable, resultUsed: resultUsed)
				none then break 'binding'
			end 'binding'
		end 'managedTopLevelBase'

		panic("parseMethodCall: '{String.from(baseTok.value)}' is neither a local binding, a capture, nor a top-level managed binding, but `methodCallsAt` gated this call — the two must agree on what a method receiver is, and on the ORDER they resolve one in")
	end 'parseMethodCall'

	// ⭐ **THE SHAPE OF A SYNTHETIC RECEIVER BINDING, DECIDED ONCE.** A top-level managed receiver is not a
	// declaration the parser read, so its `VarInfo` is invented here — and every field of it is a claim the
	// dispatcher acts on: the NAME an E3019 would blame, the TYPE the tag-routing reads, `mutable`, and
	// (by omission) `isParameter: false`, which is what keeps `immutableReceiverNameOf`'s parameter
	// exemption from silently admitting a write to a `let`-bound constant. Two arms building their own
	// would be two chances for one of those to drift.

	function dispatchOnManagedReceiver(func IrFunction, baseTok Token, value ValueId, varType MaxonType, mutable bool, resultUsed bool) returns ValueId throws ParseError
		return try self.dispatchMethodOnBinding(func, binding: VarInfo.createValueBinding(baseTok.value, varType: varType, mutable: mutable, boundValue: value), baseTok: baseTok, resultUsed: resultUsed)
	end 'dispatchOnManagedReceiver'

	// ⭐ **ROUTE A METHOD CALL BY ITS RECEIVER'S TYPE.** The cursor sits ON the base token; every arm
	// consumes it and the `.` itself. Shared by a LOCAL receiver and a top-level MANAGED CONSTANT one,
	// which differ only in where the binding came from — so the two spellings cannot come to disagree
	// about which dispatch a `String`, an `Array`, a `Set` or a conformer receiver gets.
	function dispatchMethodOnBinding(func IrFunction, binding VarInfo, baseTok Token, resultUsed bool) returns ValueId throws ParseError
		// The receiver's own token, captured before the cursor leaves it: a method call on a struct hands the
		// receiver to E3070's conflict check as the implicit ARGUMENT 0 it is, and the subject comes through
		// the one shared derivation (`borrowSubjectNameAt`) like every other door's.
		let baseIndex = self.pos
		// A STRING RECEIVER is dispatched to the builtin String methods (append, byteLength) rather than
		// through requireStructBase, which would reject it as not a struct. String is the one non-struct
		// type carrying methods at this rung; the split is on the binding's TAG, the parser's type oracle.
		// (self never names a String -- a receiver is always a struct -- so baseBindingName is untouched.)
		// ⚠ The OWNER mask is read off the binding as it ARRIVED, before `methodReceiverBinding` materializes
		// a self-field alias into an ordinary value binding — materializing is exactly what erases the fact
		// that the record belongs to `self`. See `receiverOwnerMask`.
		if maxonTypeTag(binding.varType) == ValueTypeTag.string 'stringMethod'
			return try self.parseStringMethodCall(func, binding: try self.methodReceiverBinding(binding, baseTok: baseTok), receiverOwner: self.receiverOwnerMask(func, binding: binding), baseTok: baseTok, resultUsed: resultUsed)
		end 'stringMethod'

		// An ARRAY RECEIVER (`arr.push(x)`, `arr.get(i)`) is dispatched to the array runtime rather than
		// through `requireStructBase` (which would reject a generic instance as not a plain struct). The
		// split is on the binding's genericInstance TAG being an `Array` instance — the parser's type oracle.
		if maxonTypeTag(binding.varType) == ValueTypeTag.genericInstance and self.signatures.isArrayInstance(typeNameIdOf(binding.varType)) 'arrayMethod'
			return try self.parseArrayMethodCall(func, binding: try self.methodReceiverBinding(binding, baseTok: baseTok), receiverOwner: self.receiverOwnerMask(func, binding: binding), baseTok: baseTok, giid: typeNameIdOf(binding.varType), resultUsed: resultUsed)
		end 'arrayMethod'

		// A SET RECEIVER (`s.insert(e)`, `s.contains(e)`) is dispatched to the set runtime, like an array
		// receiver — the split is on the binding's genericInstance TAG being a `Set` instance (P1.7b slice A).
		if maxonTypeTag(binding.varType) == ValueTypeTag.genericInstance and self.signatures.isSetInstance(typeNameIdOf(binding.varType)) 'setMethod'
			return try self.parseSetMethodCall(func, binding: try self.methodReceiverBinding(binding, baseTok: baseTok), receiverOwner: self.receiverOwnerMask(func, binding: binding), baseTok: baseTok, resultUsed: resultUsed)
		end 'setMethod'

		// A BUILTIN-CONFORMER RECEIVER (`i.compare(j)`, `i.hash()`) is dispatched DIRECTLY to the
		// synthesized conformance impl rather than through `requireStructBase`, which would reject an
		// `int` as not a struct. The split is on the binding's declared TYPE reduced to its conformer
		// (`builtinConformerOfType` — the parser's type oracle again), and it must sit AFTER the String
		// arm above: `String` is a conformer too, but a String receiver's methods are
		// `parseStringMethodCall`'s (`s.hash()` direct dispatch is its own slice).
		// A receiver that is NOT a builtin conformer — a struct, a generic instance, or a type with no
		// conformance at all — falls through to the struct path below, which resolves the first two and
		// reports the third.
		let receiverConformer = self.builtinConformerOfType(maxonTypeTag(binding.varType), nameId: typeNameIdOf(binding.varType))
		if isBuiltinConformer(receiverConformer) 'builtinConformer'
			return try self.parseBuiltinConformanceMethodCall(func, binding: try self.methodReceiverBinding(binding, baseTok: baseTok), baseTok: baseTok, conformer: receiverConformer)
		end 'builtinConformer'

		// ⚠ The STRUCT arm alone is handed the ORIGINAL binding, unmaterialized. A struct-typed self field
		// is REFUSED by `requireStructBase` (it has no constructible value at this rung, and that refusal
		// documents its own unreachability); materializing it here would silently turn that refusal into a
		// load nothing has ever exercised.
		self.advance()
		try self.consume(TokenKind.dot)
		return try self.dispatchMethodOnBase(func, base: try self.requireStructBase(binding, baseTok: baseTok, subjectName: self.borrowSubjectNameAt(baseIndex)), baseTok: baseTok, resultUsed: resultUsed)
	end 'dispatchMethodOnBinding'

	// ⭐⭐ **THE BINDING A METHOD DISPATCH ACTS ON — and a SELF-FIELD ALIAS is the one that has to be
	// MATERIALIZED first.** Every other binding already holds its value; a self-field alias holds NONE.
	// `VarInfo.createSelfField` leaves `boundValue` 0 because a read of the alias is a `loadIndirect`
	// through the receiver — **and ValueId 0 IS the receiver** — so a dispatch that took `boundValue` on
	// its own addressed the enclosing struct's BOX as if it were the field.
	//
	// ⚠ **BOTH HALVES OF THAT WERE MEASURED WRONG, and one of them silently.** With `var items as IntArray`
	// inside `type Bag`:
	//   • `items.count()` inside a method compiled clean and answered **0** for an array holding one
	//     element — `__arr_count` was handed the Bag's box and read its second word. A wrong answer with no
	//     diagnostic anywhere, and the runnable oracle answers 1.
	//   • `items.push(v)` was **E3019** — a false rejection of an ordinary struct-with-a-container method,
	//     because the alias is neither `mutable` nor `isParameter`, so `immutableReceiverNameOf` blamed it.
	//     The oracle accepts it.
	//
	// The second half is fixed by asking the right question: a self field's writability is the FIELD's own
	// `var`/`let` (`layout.fieldIsMutable`, the SAME column `emitCheckedSelfFieldStore` asks of `n = 1`),
	// not the receiver binding's — the receiver is a parameter and is therefore never `mutable`. So a `var`
	// field is written freely and a `let` field is refused, blaming the field's name, which is byte-for-byte
	// the oracle's diagnostic.
	//
	// `builtinConformanceReceiverValue` used to be this rule's third copy, for the conformer arm alone
	// (`count.hash()` hashing the receiver's box pointer). It is gone: one materialization, four arms.
	function methodReceiverBinding(binding VarInfo, baseTok Token) returns VarInfo throws ParseError
		if not binding.isSelfField 'holdsItsOwnValue'
			return binding
		end 'holdsItsOwnValue'

		let loaded = try self.parseSelfFieldRead(baseTok, binding: binding)
		return VarInfo.createValueBinding(baseTok.value, varType: binding.varType, mutable: try self.selfFieldIsWritable(binding, nameTok: baseTok), boundValue: loaded)
	end 'methodReceiverBinding'

	// ⭐ **MAY A SELF-FIELD ALIAS BE WRITTEN THROUGH? — THE FIELD'S OWN `var`/`let`, NEVER THE BINDING'S.**
	// `createSelfField` binds every alias `mutable: false` and says why (a rebind of the alias is never legal),
	// so asking the BINDING calls a `var` field immutable — the false E3019 `methodReceiverBinding`'s header
	// measures. `layout.fieldIsMutable` is the SAME column `emitCheckedSelfFieldStore` asks of `n = 1`.
	//
	// ⚠ **BOTH ASKERS COME THROUGH HERE, AND THAT IS WHY IT IS A FUNCTION.** A method RECEIVER (`items.push(v)`)
	// and a bare-name ARGUMENT (`grow(items)`, whose blame name `parseVariableReference` publishes) are the same
	// question about the same field. They were derived twice — once as `mutable:`, once as `not …` — and an
	// INVERTED restatement is the shape that lets a `var` field become one a method may push onto but no callee
	// may be handed, with nothing in either site to say the other exists.
	//
	// ⭐⭐ **AND AN ITERATED FIELD IS NOT WRITABLE, WHATEVER THE FIELD DECLARES.** This is one of the five
	// readers of the iteration lock, and it needs its own arm rather than sharing
	// `immutableReceiverNameOf`'s, because `methodReceiverBinding` MINTS A FRESH `VarInfo` for the alias:
	// the lock is keyed on object identity (so a shadowing declaration is correctly not locked), and that
	// fresh object is not the one the lock holds. Asking HERE — where the alias's own binding is still in
	// hand — covers both of this function's askers at once, which is the reason it is a function.
	function selfFieldIsWritable(binding VarInfo, nameTok Token) returns bool throws ParseError
		if self.bindingIsIterationLocked(binding) 'iterated'
			return false
		end 'iterated'
		return (try self.enclosingLayout(nameTok)).fieldIsMutable(binding.fieldIndex)
	end 'selfFieldIsWritable'

	// ⭐ **COULD THE `<base> . <member> (` AT `index` BE A METHOD CALL ON A TOP-LEVEL MANAGED BINDING?** — a
	// `let` (P1.7a) or a `var` (P1.7 slice 2a). The ONE gate in front of both askers — `methodCallsAt` (is
	// this token shape a method call at all?) and `parseMethodCall` (build the receiver) — for
	// `methodCallsAt`'s own stated reason: a receiver test written twice is free to drift, and the drift
	// is silent.
	//
	// **COULD**, not IS: it answers over the whole program's managed NAMES and the competing type-based
	// readings, and deliberately not over what this FILE can see. Whether the name resolves to a binding
	// visible here is `managedReceiverBindingOf`'s answer, and both askers go on to ask it — so a `true`
	// here is permission to resolve, never a claim on the shape.
	//
	// ⭐ **BOTH KINDS ANSWER HERE, THROUGH ONE FILTER AND ONE `staticCallClaimsBase`.** They are the same
	// question — "does this base name a managed record rather than a type?" — and asking it twice would
	// pay the type-reading probe twice for every managed base and, worse, allow a future rule taught to
	// one door and not the other. Which KIND it is matters only to `parseMethodCall`, where it decides
	// `mutable`, and that comes out of the ONE `managedReceiverBindingOf` below.
	//
	// ⚠⚠ **IT RETURNS A BOOL, AND THAT IS A COST DECISION WITH A MEASUREMENT BEHIND IT.** The obvious
	// tidier shape is to fold this into `managedReceiverBindingOf` and hand every caller the binding — but
	// a Maxon union VALUE IS A HEAP OBJECT, including the payload-free `none`, so a union-returning gate
	// allocates once per DOTTED CALL IN THE PROGRAM rather than once per managed-receiver call site.
	// MEASURED, by building exactly that and running the scale ladder: +441/+873/+1,737/+3,465 allocations
	// on rungs 2-5 of a corpus that declares no managed binding at all — doubling with the program,
	// forever. So the gate that decides "may this allocate?" must not itself allocate to say no.
	//
	// It takes the base's INDEX rather than its token because the answer needs the MEMBER name too
	// (`staticCallClaimsBase`), and deriving that from a token would re-assume the cursor is parked on
	// the base — true at both askers today, and exactly the premise that quietly stops holding.
	//
	// ⚠ **THE `namesManagedTopLevel` FILTER IS NOT AN OPTIMIZATION, IT IS THE COST MODEL.**
	// `methodCallsAt` runs at every dotted-call shape in the program, and the file-scoped probes behind
	// this gate BUILD A STRING KEY (~4 allocations per call — see `fileScopedDeclKey`). In front of it a
	// base that is not spelled like any managed binding in the program — every static call,
	// `Widget.create(…)` and `String.from(…)` alike, which is nearly every base that reaches here — costs
	// ONE hash of bytes it already holds and allocates nothing. `staticCallClaimsBase` sits BEHIND the
	// same filter and inherits the same model: it runs only for a base actually spelled like a managed
	// binding, so its mangled-callee probe is off the hot path entirely.
	//
	// It is a NAME set rather than a whole-program bool for a measured reason: a bool goes permanently
	// true at the first managed binding, and every static dotted call in the program then pays the full
	// probe to be told no. See `ProgramSignatures.managedTopLevelNames`.
	function managedTopLevelBaseAt(index TokenIndex) returns bool
		if not self.signatures.namesManagedTopLevel(self.tokenAt(index).value) 'notAManagedName'
			return false
		end 'notAManagedName'

		return not self.staticCallClaimsBase(index)
	end 'managedTopLevelBaseAt'

	// ⭐ **WHAT A MANAGED TOP-LEVEL NAME DENOTES AT A RECEIVER POSITION — the ONE resolution**, asked by
	// both readers past `managedTopLevelBaseAt`: `methodCallsAt` to decide whether the token shape is a
	// method call at all, `parseMethodCall` to build the receiver. Two probes with two arm orders would be
	// two encodings of "which door claims this name", and the failure mode is silent — one door claiming
	// the shape and the other resolving it differently.
	//
	// One storage key holds ONE declaration (`recordDecl` is first-wins on it), so the two doors are
	// disjoint by construction and the order below is a cost preference, not a precedence: the constant is
	// asked first because a managed `let` is the commoner declaration.
	//
	// ⚠ It BOXES a union per call — `none` included, which is why the GATE in front of it is a bool. That
	// is affordable only because of the gate: it runs solely for a base actually spelled like a managed
	// binding, i.e. once per managed-receiver call SITE at parse time, never per dotted call in the program.
	// A program with no managed binding — the whole scale corpus — never reaches it. MEASURED: the box is 1
	// allocation, and `parseMethodCall` used to pay it twice more, testing this as a predicate and then
	// re-resolving the identical name to build the receiver. A 16,384-site same-lineage ladder read that
	// recompute as exactly 12.000 allocations per managed-`var` site and 6.000 per managed-`let` site; it
	// showed up in the code as an impossible-state `none` panic whose whole justification was "the two read
	// the same resolution and cannot disagree". Passing the answer along makes that true by construction.
	function managedReceiverBindingOf(tok Token) returns ManagedReceiverBinding
		match self.signatures.constantValueOf(tok.value, readerFilePath: self.filePath) 'constant'
			found then break 'constant'
			foundManaged(bytes, kind) then return ManagedReceiverBinding.constant(bytes, kind: kind)
			notFound then break 'constant'
		end 'constant'

		return match self.signatures.globalDeclFor(tok.value, readerFilePath: self.filePath) 'global'
			found(label, valueType, mutable) gives ManagedReceiverBinding.global(label, valueType: valueType, mutable: mutable)
			notFound gives ManagedReceiverBinding.none
		end 'global'
	end 'managedReceiverBindingOf'

	// ⭐⭐ **DOES A TYPE-BASED READING ALREADY CLAIM THIS `<base> . <member> (`?** A managed constant is the
	// WEAKEST claim on that shape, and this is what says so.
	//
	// ⚠ **IT IS THE MIRROR OF `parseDottedPrimary`'S ARM ORDER, AND IT EXISTS BECAUSE THE MANAGED-CONSTANT
	// ARM BROKE THAT ORDER'S PREMISE.** `methodCallsAt`'s header states it: the token shape alone cannot
	// tell `c.increment()` from `Point.create()`, and "only the scope knows which". That held while every
	// receiver was a LOCAL or a CAPTURE — a name was a value or a type, never both. A top-level managed
	// constant is the first receiver that can share its spelling with a declared type, so the shape has to
	// be decided against the type-based readings instead of ahead of them. `methodCallsAt` is asked FIRST
	// of the three dispatchers' arm chains, so without this the constant silently outranks all of them.
	//
	// **MEASURED AGAINST THE RUNNABLE ORACLE, one program at a time.** With `let Widget = "abcdefghij"`
	// beside a `type Widget`, the oracle answers 42 for `Widget.byteLength()` when the type declares that
	// static and 10 — the CONSTANT's byte length — when it declares only `create`. So the rule is not
	// "a type name always wins": the type-based reading is TRIED FIRST and the constant is its FALLBACK,
	// which is exactly what asking the three claims below reproduces. Without it shv2 answered 10 in both
	// cases, silently, with no diagnostic and a green suite.
	//
	// Each clause delegates to the authority that arm already uses — none of them re-derives what a type
	// is:
	//
	//   • `containsEnum` — the enum/union arm, which claims a payload CONSTRUCT `Move.walk(5)`; that has
	//     the same token shape a static call does (`parseDottedPrimary` says so where it orders the two).
	//   • `isGenericAlias` — the `IntArray.create()` / `IntSet.create()` statics `parseQualifiedCall`
	//     intercepts AHEAD of its own mangle. They are the one type-based claim the callee probe below
	//     structurally cannot see: `Array`/`Set` have no base struct, so their statics lower to the array
	//     and set runtimes and NO file declares an `Array.create` to be found.
	//   • a DECLARED callee under the mangled static name — every plain struct's `Widget.byteLength`, and
	//     a user generic alias's `IntBox.create` through its base. The name is built by the SAME
	//     expression `parseQualifiedCall` builds it with, `qualifiedCallBaseName` included, rather than
	//     re-spelled here: two derivations of one callee name is the drift `builtinsIntrinsicCallsAt`
	//     documents at length, and its failure is a call accepted at one door and refused at the other.
	function staticCallClaimsBase(index TokenIndex) returns bool
		let baseName = self.tokenAt(index).value

		if self.signatures.containsEnum(baseName) or self.signatures.isGenericAlias(baseName) 'enumOrGenericAlias'
			return true
		end 'enumOrGenericAlias'

		return self.signatures.declaresCallee(qualifiedMethodName(self.qualifiedCallBaseName(baseName), methodName: self.tokenAt(index + 2).value))
	end 'staticCallClaimsBase'

	// Dispatch a method (or a function-typed FIELD load) on an already-resolved struct base — the shared tail
	// of a LOCAL receiver and a CAPTURED one (P1.5-A2b-2). The cursor sits on the member name.
	//
	// A member that is a FUNCTION-typed FIELD, not a method — `h.op(21)` / `self.op(x)`, where `op` is a
	// function-typed field (P1.5-A1) — is an INDIRECT call, not a method dispatch: load the field (a `function`
	// value) and let the postfix loop (`parsePostfix`) apply the `(args)`. Only a FUNCTION-typed field diverts
	// here — a non-function field followed by `(` (`p.count(…)` on an int field) is not a callable member and
	// falls through to the method path, which reports it as an unknown method. `resultUsed` does not apply to
	// the field load: the value/statement position is decided at the indirect call the postfix loop emits.
	function dispatchMethodOnBase(func IrFunction, base StructBase, baseTok Token, resultUsed bool) returns ValueId throws ParseError
		let memberTok = self.current()
		let fieldIndex = base.layout.indexOfField(memberTok.value)
		if fieldIndex < base.layout.fieldCount() 'fieldMember'
			let fieldType = self.signatures.fieldTypeOf(base.layout.name, index: fieldIndex, into: self.artifact.typeNames)
			if maxonTypeTag(fieldType) == ValueTypeTag.function 'functionField'
				try self.consume(TokenKind.identifier)
				try self.requireFieldAccessible(base.layout, index: fieldIndex, fieldTok: memberTok)
				return self.emitFieldLoad(base.box, layout: base.layout, index: fieldIndex, range: SourceRange.between(baseTok, last: memberTok))
			end 'functionField'
		end 'fieldMember'

		try self.requireSelfForDescriptorForwarding(base, memberTok: memberTok)

		let result = try self.parseCallNamed(func, callee: qualifiedMethodName(base.layout.name, methodName: memberTok.value), anchor: baseTok, receiver: ReceiverArg.value(base.box, immutableName: base.immutableName, subjectName: base.subjectName), resultUsed: resultUsed, constructorInstance: self.receiverConstructorInstance(base.box))
		self.retypeInstanceMethodResult(result, receiver: base.box)
		return result
	end 'dispatchMethodOnBase'

	// ⭐ **THE CONCRETE INSTANCE A METHOD'S RECEIVER SUPPLIES TO THE CALLER-SIDE CONSUME (P1.7 slice 3b-iii).**
	// A `genericInstance` receiver (`sc` of type `Container with String`) knows its instance gid at the call
	// site — the same provenance `retypeGenericAliasConstructorResult` stamped on it — so a method whose param
	// FEEDS an opaque type parameter (`push(item Element)` moving `item` into `self.items`) can decide, right
	// here, whether that argument OWNS managed heap for THIS instance and must be MOVED in. It is the method
	// twin of `constructorInstanceOf`: a generic-alias CONSTRUCTOR reads the instance off the alias name, an
	// instance method reads it off the receiver's value. A `structRef` receiver (a plain struct, or `self` in
	// the shared body, which does not know its concrete instance) supplies `none` and borrows exactly as before.
	function receiverConstructorInstance(box ValueId) returns ConstructorInstance
		if self.tagOf(box) == ValueTypeTag.genericInstance 'instance'
			return ConstructorInstance.instance(self.valueNameId(box))
		end 'instance'
		return ConstructorInstance.none
	end 'receiverConstructorInstance'

	// ⭐ **RETYPE A METHOD RESULT TO CARRY PER-INSTANCE IDENTITY (P1.6-C).** When the receiver has a
	// statically-known instance alias, two shapes gain it:
	//   • an INNER-ALIAS return (`getTag() returns Idx`, resolved to `named("Wrapper.Idx")`) is re-qualified
	//     to `named("{alias}.Idx")` — so `a.getTag()` is a `WrapperA.Idx` value the arg check compares by name;
	//   • a `Self` return (`withTag() returns Self`, resolved to the base `structRef`) is re-tagged to the
	//     receiver's OWN `genericInstance` and its alias propagated — so `w = w.withTag(7)` stays the same
	//     instance and type-checks (the assignment would else reject `Wrapper` into a `genericInstance` var).
	// A receiver with NO alias (a `self` receiver, a value merged across branches) leaves the result plain — it
	// DECAYS, matching the oracle. `receiver` is BORROWED; only the result's type moves.
	function retypeInstanceMethodResult(result ValueId, receiver ValueId)
		let receiverAlias = self.instanceAliasNameOfValue(receiver)
		if receiverAlias.isEmpty() 'noReceiverAlias'
			return
		end 'noReceiverAlias'

		if self.tagOf(result) == ValueTypeTag.named 'namedReturn'
			let member = self.signatures.innerAliasMember(self.internedName(self.valueNameId(result)))
			if not member.isEmpty() 'innerAliasReturn'
				self.retypeValue(result, valueType: MaxonType.named(self.artifact.typeNames.intern(joinQualifiedName(receiverAlias, member: member))))
				return
			end 'innerAliasReturn'
		end 'namedReturn'

		if self.tagOf(result) == ValueTypeTag.structRef and self.tagOf(receiver) == ValueTypeTag.genericInstance 'selfReturn'
			let gid = self.valueNameId(receiver)
			let baseId = self.artifact.typeNames.intern(self.signatures.genericInstanceBaseName(gid))
			if self.valueNameId(result) == baseId 'sameBase'
				self.retypeValue(result, valueType: MaxonType.genericInstance(gid))
				self.recordValueInstanceAlias(result, aliasName: receiverAlias)
			end 'sameBase'
		end 'selfReturn'
	end 'retypeInstanceMethodResult'

	// ⚠ **B1 FORWARDS A LAYOUT DESCRIPTOR ONLY FROM `self`, NOT FROM A `Self`-RETURNING RESULT** (P1.6-B1). A
	// method that reads `sizeof(T)` needs the descriptor threaded to it. When the receiver is a value of the
	// enclosing generic type — `self` (ValueId 0) or a `let c = self.makeCopy()` bound local — the descriptor
	// must be FORWARDED from the caller's own slot, which the caller holds only when its own transitive need
	// was set. `self` always qualifies; a non-`self` same-type value does not (the enclosing method may hold
	// no descriptor to forward, and the token pre-scan cannot see that `c` is same-typed), so it is a CLEAN
	// E2015 here rather than a lowering panic. A CONCRETE-instance receiver (`genericInstance`, not
	// `structRef`) supplies its OWN descriptor and never reaches this guard.
	function requireSelfForDescriptorForwarding(base StructBase, memberTok Token) throws ParseError
		// Only a method INSIDE a generic type can forward a descriptor, so a non-generic context — every
		// struct-method call in a program with no generics — short-circuits on this O(1) check BEFORE the
		// `typeDescriptorNeeds` lookup below, which would otherwise box a `Maybe` on every method call.
		if self.enclosingTypeParams.isEmpty() 'notGenericContext'
			return
		end 'notGenericContext'
		if self.tagOf(base.box) != ValueTypeTag.structRef 'notSameTypeValue'
			return
		end 'notSameTypeValue'
		if base.box == 0 'isSelf'
			return
		end 'isSelf'
		// A `structRef` receiver whose base is the enclosing generic type is a `Self`-returning result; every
		// other `structRef` (a plain non-generic struct local) resolves against no `typeDescriptorNeeds` entry.
		if not base.layout.name.equals(self.enclosingType) 'notEnclosingType'
			return
		end 'notEnclosingType'
		let needsDescriptor = try self.typeDescriptorNeeds.get(memberTok.value) otherwise false
		if needsDescriptor 'reject'
			throw ParseError.unsupported("calling '{String.from(memberTok.value)}' (which reads sizeof of the type parameter) on a value of the enclosing type that is NOT `self` — B1 forwards the layout descriptor only from `self`, so read the size through `self` (or a concrete instance) instead; forwarding from a `Self`-returning result is a later slice", line: memberTok.line, column: memberTok.column)
		end 'reject'
	end 'requireSelfForDescriptorForwarding'

	// ⭐ **A METHOD CALL ON A CAPTURED STRUCT RECEIVER (P1.5-A2b-2).** `b.doubled()` where `b` is an enclosing
	// struct captured by the closure. The receiver box is READ OUT OF THE ENV (`emitCaptureRead` — a borrowed
	// pointer copy), its layout resolved from the enclosing binding's struct type, then dispatched exactly as a
	// local receiver: the borrowed box is passed as `__self` (the method borrows its receiver). A captured
	// non-struct is refused (only a struct carries methods here; a captured String's builtin methods are not
	// reached by any case at this rung).
	function capturedMethodCall(func IrFunction, baseTok Token, enclosing Scope, resultUsed bool) returns ValueId throws ParseError
		self.advance()
		try self.consume(TokenKind.dot)
		return try self.dispatchMethodOnBase(func, base: try self.capturedStructBase(baseTok, enclosing: enclosing), baseTok: baseTok, resultUsed: resultUsed)
	end 'capturedMethodCall'

	// ⭐ **RESOLVE A CAPTURED STRUCT BASE TO ITS (box, layout) (P1.5-A2b-2)** — the shared resolution behind a
	// captured field access (`level.rawValue`) and a captured method call (`b.doubled()`). The box is READ OUT
	// OF THE ENV (`emitCaptureRead` — a borrowed pointer copy, one `loadIndirect`, cursor-independent so a
	// caller may have already consumed the base token), and its layout is resolved from the enclosing binding's
	// struct type exactly as `requireStructBase` does for a local base. A captured non-struct is refused (only a
	// struct carries fields and methods; a captured String's builtin methods are reached by no case here).
	function capturedStructBase(baseTok Token, enclosing Scope) returns StructBase throws ParseError
		let binding = enclosing.getInfo(baseTok.value)
		if maxonTypeTag(binding.varType) != ValueTypeTag.structRef 'notAStruct'
			throw ParseError.unsupported("a field access or method call on the captured '{String.from(baseTok.value)}', which is declared '{typeTagName(maxonTypeTag(binding.varType))}' and not a struct type (only a struct has fields and methods)", line: baseTok.line, column: baseTok.column)
		end 'notAStruct'
		// E3070 exemption, and it is one this rung can prove rather than assume: capture is BY VALUE, so a
		// method call on a CAPTURED receiver cannot reach a binding of the enclosing body, and a captured
		// managed CONTAINER — the only thing a borrow could be taken out of — is refused outright at this rung
		// (`capturedStructBase` admits only a struct). There is no storage here for a conflict to be about.
		return StructBase.create(try self.structLayoutOfBinding(binding, baseTok: baseTok), box: try self.emitCaptureRead(baseTok, enclosing: enclosing), immutableName: self.immutableReceiverNameOf(binding, baseTok: baseTok), subjectName: EmptySourceText)
	end 'capturedStructBase'

	// A STRING'S BUILTIN METHODS -- s.append(t) and s.byteLength(). String is the one non-struct type
	// carrying methods at this rung, so it has its own dispatch rather than riding requireStructBase.
	// The receiver must be LIVE (a moved-from String touched through a method is use-after-move, E3102),
	// checked here before the method name is even resolved -- the same guard requireStructBase gives a
	// struct base.
	function parseStringMethodCall(func IrFunction, binding VarInfo, receiverOwner MutatedParamMask, baseTok Token, resultUsed bool) returns ValueId throws ParseError
		self.advance()
		try self.consume(TokenKind.dot)
		try self.requireBindingLive(binding, nameTok: baseTok)

		let methodTok = try self.consume(TokenKind.identifier)
		if methodTok.value.equals(StringAppendMethod) 'append'
			return try self.parseStringAppend(func, binding: binding, receiverOwner: receiverOwner, baseTok: baseTok, methodTok: methodTok, resultUsed: resultUsed)
		end 'append'
		if methodTok.value.equals(StringByteLengthMethod) 'byteLength'
			return try self.parseStringByteLength(binding, methodTok: methodTok)
		end 'byteLength'

		throw ParseError.unsupported("String method '{String.from(methodTok.value)}' -- P1.2 wave D provides `append` and `byteLength`; the rest (slice/split/toByteArray/...) need Array and arrive at P1.7+", line: methodTok.line, column: methodTok.column)
	end 'parseStringMethodCall'

	// s.append(t) -- grow the String s by t's bytes, IN PLACE (a __str_append(s, t) runtime call). s must
	// be a var (append mutates the receiver), else E3019 with the bootstrap's exact framing. s is already
	// an owned WRITABLE heap record -- a var String initializer is promoted at its declaration
	// (parseBinding) -- so there is nothing to make writable here. t is BORROWED and COPIED (its bytes are
	// blitted), so it is neither moved nor consumed: an owned interpolation argument stays a pending temp
	// and drops at statement end, AFTER the copy. append is void, so a value-position call is rejected.
	function parseStringAppend(func IrFunction, binding VarInfo, receiverOwner MutatedParamMask, baseTok Token, methodTok Token, resultUsed bool) returns ValueId throws ParseError
		// `append` IS the String's one receiver-writing method — the caller matched it to get here — so the
		// per-container half of the rule is a constant `true` and everything else is the shared home's.
		// It used to ask `not binding.mutable` on its own, which made a String PARAMETER receiver a false
		// rejection: see `noteReceiverWrite` for the measurement.
		// `receiverStorage: NoMutatedParams` is E3070's SCOPE, not an omission: only an ARRAY write can free
		// an array element, so a `String` method writing its receiver cannot invalidate a borrow. Recording it
		// would refuse `b.wipe()` while `b.items` is borrowed for a `wipe` that only appends to `b.name`.
		try self.noteReceiverWrite(func, immutableReceiverName: self.immutableReceiverNameOf(binding, baseTok: baseTok), receiverOwner: receiverOwner, receiverStorage: NoMutatedParams, methodTok: methodTok, mutatesReceiver: true)

		if resultUsed 'voidResultUsed'
			throw ParseError.voidCallResultUsed(String.from(StringAppendMethod), line: methodTok.line, column: methodTok.column)
		end 'voidResultUsed'

		try self.consume(TokenKind.leftParen)
		let argTok = self.current()
		let arg = try self.parseExpression(func, block: self.currentBlock)
		try self.consume(TokenKind.rightParen)

		if self.tagOf(arg) != ValueTypeTag.string 'argNotString'
			throw ParseError.builtinOperandType(String.from(StringAppendMethod), required: typeTagName(ValueTypeTag.string), got: typeTagName(self.tagOf(arg)), line: argTok.line, column: argTok.column)
		end 'argNotString'

		_ = self.emitRuntimeCall(StrAppendName, args: pairArgs(binding.boundValue, second: arg), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: SourceRange.between(baseTok, last: methodTok))
		// append is a statement (resultUsed false, checked above); the returned id is discarded by the
		// caller. The receiver value is the honest thing to hand back -- it is what s still denotes.
		return binding.boundValue
	end 'parseStringAppend'

	// s.byteLength() -- the String's byte count, length@8. A non-mutating accessor, so a let or var
	// receiver alike, and it takes no arguments. The value is integer-tagged (a byte count), exactly as a
	// field read is, and returns through the one String-field load site.
	function parseStringByteLength(binding VarInfo, methodTok Token) returns ValueId throws ParseError
		try self.consume(TokenKind.leftParen)
		try self.consume(TokenKind.rightParen)
		return self.emitLoadStringField(binding.boundValue, offset: StringLengthOffset, range: SourceRange.ofToken(methodTok))
	end 'parseStringByteLength'

	// --- Direct builtin-conformance dispatch (P1.7a): `i.compare(j)` / `i.hash()` / `i.equals(j)` ---

	// ⭐ **ONE BODY SERVES BOTH DISPATCH PATHS.** A concrete receiver calls `int.compare` DIRECTLY — the
	// very symbol a `__witness_int.Comparable` slot is stamped with (`ensureWitnessTable`'s funcAbs64
	// reloc), built by the very same `BuiltinConformanceRuntime.buildIntCompare`. There is no second
	// impl for the direct path and no thunk between them: the dictionary-passing form loads the pointer
	// out of `.rdata` and the concrete form names the symbol, and they land in the same function. That is
	// v1's arrangement (`BuildWitnessTables.maxon:57-143` fills a slot with a reloc to the qualified
	// `"{typeName}.{method}"`, which is also what its concrete dispatch calls) and shv2 already minted
	// that exact name, so the only thing this rung adds is the CALL.
	//
	// ⚠ **THE INSTALLER MUST SEE THIS REFERENCE.** `installBuiltinConformanceRuntime` builds an impl iff
	// the program REFERENCES it, and a direct call creates no `.rdata` reloc — see that file's header for
	// how the reference is found. A dispatch emitted here that the installer cannot see is a link-time
	// panic (`resolveCallFixups: call to unknown function 'int.compare'`), never a silent wrong answer.

	// `i.compare(j)` on a BINDING receiver. The cursor sits on the base token; the conformer has already
	// been resolved from the binding's declared type by `parseMethodCall`.
	function parseBuiltinConformanceMethodCall(func IrFunction, binding VarInfo, baseTok Token, conformer BuiltinConformer) returns ValueId throws ParseError
		let receiver = binding.boundValue
		self.advance()
		try self.consume(TokenKind.dot)
		return try self.dispatchBuiltinConformanceMethod(func, receiver: receiver, conformer: conformer, baseTok: baseTok)
	end 'parseBuiltinConformanceMethodCall'

	// The same dispatch on a VALUE that is not a binding — a call result (`a.get().compare(b.get())`), an
	// indirect-call result, an array element. Reached from the postfix loop with the cursor on the `.`, which
	// gated it on `isBuiltinConformer` — so re-reading the classifier here cannot answer `notAConformer`, and
	// `builtinConformerName` panics rather than inventing a symbol if the two ever disagree.
	function parseBuiltinConformanceMethodOnValue(func IrFunction, receiver ValueId) returns ValueId throws ParseError
		let dotTok = self.current()
		try self.consume(TokenKind.dot)
		return try self.dispatchBuiltinConformanceMethod(func, receiver: receiver, conformer: self.builtinConformerOfValue(receiver), baseTok: dotTok)
	end 'parseBuiltinConformanceMethodOnValue'

	// Resolve the method name against the conformer's INTRINSIC conformances and emit the call. The cursor
	// sits on the method NAME. A name no intrinsic conformance supplies is a clean positioned reject — never
	// a route to a `<type>.<method>` symbol nothing installs.
	function dispatchBuiltinConformanceMethod(func IrFunction, receiver ValueId, conformer BuiltinConformer, baseTok Token) returns ValueId throws ParseError
		let methodTok = try self.consume(TokenKind.identifier)
		let typeName = builtinConformerName(conformer)
		match builtinConformerMethod(typeName, methodName: methodTok.value) 'lookup'
			supplied(method) then return try self.emitBuiltinConformanceCall(func, receiver: receiver, conformer: conformer, method: method, baseTok: baseTok, methodTok: methodTok)
			notSupplied then throw ParseError.unsupported("'{String.from(typeName)}' has no method named '{String.from(methodTok.value)}' — its builtin conformances supply {builtinConformerMethodNames(typeName)}; `toString`/`clone` need the Stringable/Cloneable impls, which are not built", line: methodTok.line, column: methodTok.column)
		end 'lookup'
	end 'dispatchBuiltinConformanceMethod'

	// Parse the argument list and emit the call. The receiver is argument 0 and is BORROWED — all three
	// impls read their operands as by-value scalars and free nothing — so no incref is emitted here and no
	// drop is owed there, exactly as an instance method's receiver rides.
	//
	// It goes through `emitRuntimeCall` rather than `emitCall` for that door's stated reason: a synthesized
	// impl is built at the Std tier AFTER the pipeline, so no file declares it, `mintCallResult` would type
	// it `unresolved`, and the argument order is the compiler's own rather than a signature's. The result is
	// typed from the interface method's declared return (`interfaceReturnMaxonType` — the SAME typing the
	// witness-dispatched form gets), so `compare`'s `Ordering` carries the enum's `named` tag a `match`
	// recognizes and `hash`'s `HashValue` carries the ranged alias's.
	function emitBuiltinConformanceCall(func IrFunction, receiver ValueId, conformer BuiltinConformer, method InterfaceMethodSig, baseTok Token, methodTok Token) returns ValueId throws ParseError
		try self.consume(TokenKind.leftParen)
		var args = ValueIdArray.create()
		args.push(receiver)
		if not self.at(TokenKind.rightParen) 'hasArgs'
			while true 'argLoop'
				args.push(try self.parseValueExpression(func))
				if not self.at(TokenKind.comma) 'endArgs'
					break
				end 'endArgs'
				try self.consume(TokenKind.comma)
			end 'argLoop'
		end 'hasArgs'
		let rparenTok = try self.consume(TokenKind.rightParen)

		// A builtin has no signature for `SemanticCheck`'s arity check to consult, so it is raised here —
		// the same `builtinArity` every other builtin raises, counted in USER arguments (the receiver slot
		// is the compiler's, and reporting it would name an argument the author never wrote).
		let userArgs = args.count() - BuiltinConformanceReceiverArgs
		if userArgs != method.paramTypeNames.count() 'arity'
			throw ParseError.builtinArity(String.from(method.name), expected: method.paramTypeNames.count(), got: userArgs, line: methodTok.line, column: methodTok.column)
		end 'arity'

		try self.requireBuiltinConformanceSelfArgs(method, args: args, conformer: conformer, methodTok: methodTok)

		let resultType = self.interfaceReturnMaxonType(method.returnTypeName)
		return self.emitRuntimeCall(qualifiedMethodName(builtinConformerName(conformer), methodName: method.name), args: args, resultTag: maxonTypeTag(resultType), resultNameId: typeNameIdOf(resultType), range: SourceRange.between(baseTok, last: rparenTok))
	end 'emitBuiltinConformanceCall'

	// ⭐ **A `Self`-TYPED FORMAL TAKES A VALUE OF THE RECEIVER'S OWN CONFORMER, AND NOTHING ELSE.**
	// `Equatable.equals` and `Comparable.compare` both declare `other Self`, and `int.equals(self, other)`
	// compares two RAW i64s — so a `String` actual would be compared as its heap POINTER and a struct as its
	// box address. A silent wrong answer, which is precisely what `requireGenuineSelfArgs` refuses for the
	// witness-dispatched form; this is the same question asked of a CONCRETE conformer instead of a type
	// parameter. Interface formal `j` is actual `j + BuiltinConformanceReceiverArgs`; arity was checked above.
	function requireBuiltinConformanceSelfArgs(method InterfaceMethodSig, args ValueIdArray, conformer BuiltinConformer, methodTok Token) throws ParseError
		for j in 0 upto method.paramTypeNames.count() 'eachFormal'
			let formalTypeName = try method.paramTypeNames.get(j) otherwise panic("requireBuiltinConformanceSelfArgs: paramTypeNames.get OOB at {j} below count {method.paramTypeNames.count()}")
			if not formalTypeName.equals(InterfaceSelfTypeName) 'notSelfFormal'
				continue
			end 'notSelfFormal'

			let actual = try args.get(j + BuiltinConformanceReceiverArgs) otherwise panic("requireBuiltinConformanceSelfArgs: args.get OOB at {j + BuiltinConformanceReceiverArgs} below count {args.count()} — the arity check ran first")
			if not self.valueIsConformer(actual, conformer: conformer) 'notSameConformer'
				throw ParseError.builtinOperandType(String.from(method.name), required: String.from(builtinConformerName(conformer)), got: typeTagName(self.tagOf(actual)), line: methodTok.line, column: methodTok.column)
			end 'notSameConformer'
		end 'eachFormal'
	end 'requireBuiltinConformanceSelfArgs'

	// --- Builtin `Array` parsing (P1.7 slice 1) ---

	// `[a, b, c]` — an array literal. Desugars to `__arr_create(elementSize, 0)` then one `__arr_push` per
	// element, yielding an OWNED `Array with integer`. At this slice a literal's elements are all integer
	// (a String / struct / bool / Byte element literal is a later slice, rejected E2015); an empty `[]`
	// carries no element to infer a type from and is rejected (use `Array with T` + `.create()`).
	function parseArrayLiteral(func IrFunction) returns ValueId throws ParseError
		let openTok = try self.consume(TokenKind.leftBracket)
		let range = SourceRange.ofToken(openTok)
		self.skipNewlines()

		if self.at(TokenKind.rightBracket) 'empty'
			throw ParseError.unsupported("an empty array literal `[]` — its element type cannot be inferred; use `Array with T` + `.create()` for an empty typed array", line: openTok.line, column: openTok.column)
		end 'empty'

		// ⭐ **THE INT-LITERAL FAST PATH keeps slice 1's op ORDER (create the record BEFORE evaluating any
		// element)**, so the pre-existing int-array-literal goldens do not move. A MANAGED / inferred literal
		// (`["…"]`, `[p1,p2]`) cannot take it: its record's element_destroy stamp needs the element type, which
		// is only known after the first element is parsed, so that path evaluates the first element first.
		//
		// ⚠ **THE GUARD MUST BE SOUND, NOT MERELY LIKELY — it once asked only whether the first TOKEN was an
		// int literal, and that is a different question from whether the ELEMENT is an integer.** `[10 as Index]`
		// starts with an int literal and is an `Index`: the record was created for `Array with integer`, the
		// element resolved to `Array with Index`, and the mismatch was reported as **"mixed element types" on a
		// literal with ONE element** — a false rejection whose message was false twice over. A token-level guard
		// can settle an element's type for exactly one shape, a BARE int literal, so that is the shape it asks
		// about (`arrayElementIsSingleToken`); anything else goes down the path that asks the element itself.
		if self.at(TokenKind.intLiteral) and self.arrayElementIsSingleToken(self.pos) 'intFastPath'
			return try self.parseIntArrayLiteralBody(func, range: range)
		end 'intFastPath'

		let firstTok = self.current()
		let firstStart = self.pos
		let first = try self.parseExpression(func, block: self.currentBlock)
		let giid = try self.arrayLiteralInstanceFor(first, elemTok: firstTok)
		let arr = self.emitArrayCreateOp(giid, range: range)
		try self.pushArrayLiteralElement(arr, elem: first, giid: giid, valueStart: firstStart, range: range)

		return try self.finishArrayLiteral(func, arr: arr, giid: giid, range: range)
	end 'parseArrayLiteral'

	// The int-array-literal body (`[10, 20, 30]`) — the record is created FIRST (the element type is `integer`,
	// which the caller's guard has already settled from the token), then each element is parsed and pushed.
	// This is slice 1's exact op order, kept so the pre-existing int-literal goldens do not move.
	function parseIntArrayLiteralBody(func IrFunction, range SourceRange) returns ValueId throws ParseError
		let giid = self.signatures.internBuiltinIntegerInstance(ArrayBuiltinBaseName)
		let arr = self.emitArrayCreateOp(giid, range: range)

		// The FIRST element is not checked against `giid` — it is what FIXES it, exactly as in the general
		// path above. Only a LATER element can disagree with the first, which is why the "mixed element types"
		// verdict lives in the shared tail and can never be reached by a one-element literal.
		let firstStart = self.pos
		let first = try self.parseExpression(func, block: self.currentBlock)
		try self.pushArrayLiteralElement(arr, elem: first, giid: giid, valueStart: firstStart, range: range)

		return try self.finishArrayLiteral(func, arr: arr, giid: giid, range: range)
	end 'parseIntArrayLiteralBody'

	// The tail every array literal shares once its record exists and its first element is pushed: the `, e`
	// elements, the closing `]`, and the owned-temp registration. ONE home, so the two entry paths cannot
	// drift on the element rule, on where a newline may fall, or on when the array becomes a tracked temp.
	//
	// ⚠ **A NEWLINE IS SKIPPED ONLY AT AN ELEMENT BOUNDARY, and never before `pushArrayLiteralElement`** —
	// the same two rules `parseStructLiteralFields` states for `{…}`. A skip before the push would widen the
	// `[valueStart, self.pos)` window `moveElementIntoArray` reads to decide whether the element was a bare
	// local, and silently mis-decide a managed element's move-in.
	function finishArrayLiteral(func IrFunction, arr ValueId, giid GenericInstanceId, range SourceRange) returns ValueId throws ParseError
		self.skipNewlines()
		while self.at(TokenKind.comma) 'moreElements'
			try self.consume(TokenKind.comma)
			self.skipNewlines()
			let elemTok = self.current()
			let elemStart = self.pos
			let elem = try self.parseExpression(func, block: self.currentBlock)
			try self.requireArrayLiteralElementMatches(elem, giid: giid, elemTok: elemTok)
			try self.pushArrayLiteralElement(arr, elem: elem, giid: giid, valueStart: elemStart, range: range)
			self.skipNewlines()
		end 'moreElements'
		try self.consume(TokenKind.rightBracket)

		self.trackOwnedTemp(arr)
		return arr
	end 'finishArrayLiteral'

	// Push one already-parsed array-literal element, moving a managed element in (the array owns it; a trivial
	// element passes through) — `moveElementIntoArray` off the value's start position so a bare local is poisoned.
	function pushArrayLiteralElement(arr ValueId, elem ValueId, giid GenericInstanceId, valueStart TokenIndex, range SourceRange) throws ParseError
		let stored = try self.moveElementIntoArray(elem, giid: giid, valueStart: valueStart)
		_ = self.emitRuntimeCall(ArrPushName, args: pairArgs(arr, second: stored), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
	end 'pushArrayLiteralElement'

	// The `Array with T` instance a literal's FIRST element fixes (P1.7 slice 3) — an integer element → the
	// int instance, a String → `Array with String`, a struct/boxed-union → `Array with <name>`. All are
	// interned by the sweep (`internBuiltinIntegerInstance` / `internArrayLiteralAggregateInstances`), so this is a
	// pure lookup. A float/function/other element is not a supported literal element yet (E2015).
	function arrayLiteralInstanceFor(elem ValueId, elemTok Token) returns GenericInstanceId throws ParseError
		let tag = self.tagOf(elem)
		if tag == ValueTypeTag.integer 'int'
			return self.signatures.internBuiltinIntegerInstance(ArrayBuiltinBaseName)
		end 'int'
		if tagIsText(tag) 'string'
			return self.signatures.arrayInstanceForString()
		end 'string'
		if tagIsStructRef(tag) or tag == ValueTypeTag.named 'aggregate'
			return self.signatures.arrayInstanceForNamedElement(try self.artifact.typeNames.nameOf(self.valueNameId(elem)) otherwise panic("arrayLiteralInstanceFor: a struct/union element's name id is not in this file's interner"))
		end 'aggregate'
		throw ParseError.unsupported("an array literal element of type '{typeTagName(tag)}' — a literal's elements are an integer, a String, a struct, or a boxed union (a bare `[…]` infers the type from the first element)", line: elemTok.line, column: elemTok.column)
	end 'arrayLiteralInstanceFor'

	// Every element after the first must have the SAME element type — its inferred instance must equal the
	// first's. A mismatch is an array literal with mixed element types (E2015).
	function requireArrayLiteralElementMatches(elem ValueId, giid GenericInstanceId, elemTok Token) throws ParseError
		if (try self.arrayLiteralInstanceFor(elem, elemTok: elemTok)) != giid 'mismatch'
			throw ParseError.unsupported(MixedArrayLiteralElementsMessage, line: elemTok.line, column: elemTok.column)
		end 'mismatch'
	end 'requireArrayLiteralElementMatches'

	// Emit `__arr_create(elementSize, elementDestroy)` for instance `giid`, yielding the array record — the
	// shared producer for a literal and an `IntArray.create()`. Element size is a compile-time constant here
	// (a concrete instance). The element destructor is the ADDRESS of the element's drop callee for a MANAGED
	// element (P1.7 slice 3), stamped into `element_destroy@40` before any element move (v1 trap #3: `__arr_create`
	// stores it inside its body, so it is set at birth); 0 for a trivial element. NOT tracked owned — the caller
	// decides that (a literal tracks after its pushes, a `create()` immediately).
	function emitArrayCreateOp(giid GenericInstanceId, range SourceRange) returns ValueId
		if self.signatures.arrayElementIsOpaque(giid) 'opaque'
			return self.emitOpaqueArrayCreateOp(giid, range: range)
		end 'opaque'
		let sizeVal = self.emitLiteral(self.signatures.arrayElementSize(giid) as ParsedInt, valueType: MaxonType.integer, range: range)
		let destroyVal = self.arrayElementDestroyValue(giid, range: range)
		return self.emitRuntimeCall(ArrCreateName, args: pairArgs(sizeVal, second: destroyVal), resultTag: ValueTypeTag.genericInstance, resultNameId: giid, range: range)
	end 'emitArrayCreateOp'

	// ⭐ **CREATE AN OPAQUE-`T` ARRAY inside a shared generic body (P1.7 slice 3b-i).** `ElementArray.create()`
	// where `ElementArray = Array with typeParameter(pos)`. Two things differ from a concrete create, both
	// because the element type is opaque here (the shared body compiles ONCE and serves every concrete
	// instance through dictionary-passing):
	//   • element_size is the fixed machine-word slot every opaque `T` occupies (`LAYOUT_TYPE_PARAM_SLOT_BYTES`),
	//     NOT a source-`sizeof` — a managed element is a pointer and a trivial one an inline word, both 8 bytes.
	//   • element_destroy@40 is not known statically, so it is READ from the enclosing instance's threaded
	//     layout descriptor at RUN TIME (`destroyFunc@40`). The parser emits a ONE-argument `__arr_create`
	//     (element_size only); LowerMaxonToStd supplies the descriptor-read second argument, so the tier that
	//     owns the descriptor's ValueId (`implicitLayoutValueId`) is the tier that reads it — the same split
	//     `sizeof(T)` uses. For a TRIVIAL instance the slot reads 0 and the array's drop walk is skipped.
	function emitOpaqueArrayCreateOp(giid GenericInstanceId, range SourceRange) returns ValueId
		let sizeVal = self.emitLiteral(LAYOUT_TYPE_PARAM_SLOT_BYTES as ParsedInt, valueType: MaxonType.integer, range: range)
		return self.emitRuntimeCall(ArrCreateName, args: singletonArgs(sizeVal), resultTag: ValueTypeTag.genericInstance, resultNameId: giid, range: range)
	end 'emitOpaqueArrayCreateOp'

	// ⭐ **THE `element_destroy@40` STAMP VALUE (P1.7 slice 3).** For a MANAGED-element array it is the RAW
	// `.text` ADDRESS of the element's drop callee (`__str_decref` / `__destruct_<T>` / `__mm_decref` / nested
	// `__arr_decref`), which `__arr_decref`'s last-owner walk calls through a `callIndirect` on each live slot;
	// for a trivial element it is 0 (an inline element owns nothing, so the walk is skipped). A CONCRETE site
	// knows the element type, so the address is the existing P1.5-A1 `funcAddr` code→register path — no rdata
	// reloc, no descriptor `destroyFunc@40` (those are the opaque-`T`-in-a-generic-body case, slice 3b).
	//
	// ⚠ **IT ASKS THE TWO `ProgramSignatures` ACCESSORS RATHER THAN A UNION DESCRIBING THE ANSWER, and that
	// is a measured cost decision** (P1.7 slice 2b). A top-level array global's record is stamped from the
	// same pair (`ProgramSignatures.arrayRecordInitializer`), and folding the two into one union-returning
	// door was tidier — but a Maxon union value is a HEAP OBJECT, and this runs at every array creation SITE
	// in the program: MEASURED at exactly +1 allocation per site (32 sites → +32, 64 → +64, and +32 at scale
	// rung 0 doubling to +1,024 at rung 5). The DECISION is single-homed regardless — `arrayElementIsManaged`
	// is the one place "does this element own anything?" is answered, and both sites ask it — so what is
	// written twice is a three-line composition, not a rule.
	function arrayElementDestroyValue(giid GenericInstanceId, range SourceRange) returns ValueId
		if self.signatures.arrayElementIsManaged(giid) 'managed'
			return self.emitRuntimeFuncAddr(self.signatures.arrayElementDropCallee(giid), range: range)
		end 'managed'

		return self.emitLiteral(TrivialDestructor, valueType: MaxonType.integer, range: range)
	end 'arrayElementDestroyValue'

	// Emit the RAW `.text` address of a COMPILER-INTERNAL runtime function (`__str_decref`, `__destruct_<T>`,
	// `__arr_decref`, `__mm_decref`) as a value (P1.7 slice 3). It rides P1.5-A1's `functionRef` → `funcAddr`
	// path, but names a `__`-prefixed runtime callee — which `LowerMaxonToStd.lowerFunctionRef` materializes as
	// the BARE address (NOT the `__fnref_` env thunk: the destructor is invoked through a plain `callIndirect(ptr)`
	// in the drop walk, not the uniform `(userargs, env)` closure ABI) and `scanRuntimeUsage` records so the named
	// destructor is installed (its transitive `__str_decref`/`__mm_free`/nested-cascade needs then close through
	// `noteDestructorUsage`, exactly as a scope-exit `__destruct_<T>` drop's do). The `__` prefix is the ONE
	// discriminator every site reads, so a compiler-internal address and a user function value never cross.
	function emitRuntimeFuncAddr(name ByteArray, range SourceRange) returns ValueId
		let result = self.mintValue(ValueTypeTag.function, nameId: self.artifact.typeNames.intern(name))
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.functionRef(result, funcName: name), range: range)
		return result
	end 'emitRuntimeFuncAddr'

	// `IntArray.create()` — the one `Array` static factory at this slice. Yields an OWNED empty array. Serves
	// a CONCRETE instance (`Array with Integer`) and an OPAQUE one (`Array with T` inside a generic body, P1.7
	// slice 3b) alike — `emitArrayCreateOp` branches on the element. A MANAGED opaque element is fully created
	// here (`emitOpaqueArrayCreateOp` stamps its `element_destroy@40` from the threaded descriptor, P1.7 slice
	// 3b-iii); the element READ (borrow), MOVE-OUT (`__drop_type_param`) and COPY (`__arr_*_opaque` via the
	// descriptor `copyFunc@32`, P1.7 slice 3b-vi-b-β) are all served through the descriptor, never creation.
	function parseArrayStaticCall(aliasTok Token, giid GenericInstanceId) returns ValueId throws ParseError
		try self.consume(TokenKind.dot)
		let methodTok = try self.consume(TokenKind.identifier)
		if not methodTok.value.equals(ArrayCreateMethod) 'unknownStatic'
			throw ParseError.unsupported("`Array` static method '{String.from(methodTok.value)}' — P1.7 slice 1 provides `create()` only", line: methodTok.line, column: methodTok.column)
		end 'unknownStatic'
		try self.consume(TokenKind.leftParen)
		try self.consume(TokenKind.rightParen)
		let arr = self.emitArrayCreateOp(giid, range: SourceRange.between(aliasTok, last: methodTok))
		self.trackOwnedTemp(arr)
		return arr
	end 'parseArrayStaticCall'

	// `IntSet.create()` — the one `Set` static factory at this slice (P1.7b slice A). Yields an OWNED empty set
	// (`__set_create`), tracked so its scope-exit drop routes through `genericInstanceBoxDropCallee` →
	// `__set_decref`, which frees the record and its three buffers. The `Set` twin of `parseArrayStaticCall`.
	function parseSetStaticCall(aliasTok Token, giid GenericInstanceId) returns ValueId throws ParseError
		try self.consume(TokenKind.dot)
		let methodTok = try self.consume(TokenKind.identifier)
		if not methodTok.value.equals(SetCreateMethod) 'unknownStatic'
			throw ParseError.unsupported("`Set` static method '{String.from(methodTok.value)}' — P1.7b slice A provides `create()` only", line: methodTok.line, column: methodTok.column)
		end 'unknownStatic'
		try self.consume(TokenKind.leftParen)
		try self.consume(TokenKind.rightParen)
		try self.requireSetKeyType(giid, tok: aliasTok)
		let set = self.emitSetCreateOp(giid, range: SourceRange.between(aliasTok, last: methodTok))
		self.trackOwnedTemp(set)
		return set
	end 'parseSetStaticCall'

	// Emit `__set_create(elemDrop)` for instance `giid`, yielding the empty set record (P1.7b). The record is
	// zeroed by `__mm_alloc`, so the first insert lazily allocates the buffers; `elemDrop@40` carries the key
	// destructor (`__str_decref` for a String key, 0 for a trivial int key) so the set drops its owned keys at
	// teardown / dup-insert / remove.
	function emitSetCreateOp(giid GenericInstanceId, range SourceRange) returns ValueId
		let elemDrop = self.setElementDestroyValue(giid, range: range)
		return self.emitRuntimeCall(SetCreateName, args: singletonArgs(elemDrop), resultTag: ValueTypeTag.genericInstance, resultNameId: giid, range: range)
	end 'emitSetCreateOp'

	// ⭐ **THE `elemDrop@40` STAMP VALUE for a `Set` (P1.7b) — the `Set` twin of `arrayElementDestroyValue`.** A
	// MANAGED key (String) → the RAW `.text` address of its drop callee (`__str_decref`), via the same P1.5-A1
	// `funcAddr` code→register path the array element destructor rides (no rdata reloc, no descriptor); a trivial
	// int key → 0. `__set_decref`'s teardown walk calls it through a `callIndirect` on each live key.
	function setElementDestroyValue(giid GenericInstanceId, range SourceRange) returns ValueId
		if self.signatures.setKeyIsManaged(giid) 'managed'
			return self.emitRuntimeFuncAddr(self.signatures.setKeyDropCallee(giid), range: range)
		end 'managed'
		return self.emitLiteral(TrivialDestructor, valueType: MaxonType.integer, range: range)
	end 'setElementDestroyValue'

	// ⭐ **THE KEY-TYPE GATE (P1.7b).** A `Set`'s key type must be `int` (or a ranged-int alias) OR `String`:
	// this slice dispatches `hash`/`equals` through the key's `Hashable`/`Equatable` witnesses, and only `int`
	// (2b-i) and `String` (Slice C) have those synthesized. A struct / `ByteArray` key rides a later slice, so it
	// is a clean E2015 here rather than a link failure at the missing witness impl. The key type is read through
	// `conformerTypeArgName` — the SAME canonical-conformer reducer the witness threading uses
	// (`LowerMaxonToStd.appendSetWitnessArgs`) — so the gate and the dispatch agree on the key's identity (an
	// `int` and a ranged-int alias both reduce to `int`; a `String` names itself).
	function requireSetKeyType(giid GenericInstanceId, tok Token) throws ParseError
		let keyType = self.signatures.conformerTypeArgName(giid, position: 0 as TypeParamId).toByteArray()
		if not (keyType.equals(IntConformerName) or keyType.equals(StringConformerName)) 'unsupportedKey'
			throw ParseError.unsupported("`Set` supports `int` and `String` keys — a '{String.from(keyType)}' key (struct / ByteArray) is a later slice", line: tok.line, column: tok.column)
		end 'unsupportedKey'
	end 'requireSetKeyType'

	// ⭐ **`Set from [1, 2, 3]` — CONSTRUCT A SET FROM AN ARRAY LITERAL (P1.7b slice B).** The cursor sits on the
	// `Set` identifier. Parse `from` then the `[…]` through the EXISTING array-literal parser — which infers the
	// element type and yields an OWNED `Array with <elem>` temporary — then emit `__set_from` over it, yielding an
	// OWNED `Set with <elem>`. The array is BORROWED: `__set_from` reads its elements (it does not consume or free
	// it), so the array stays a pending owned temporary the caller drops at statement end, and the constructed set
	// drops at scope exit through `genericInstanceBoxDropCallee` → `__set_decref` — no double-free. INT keys only
	// this slice (a String / managed-element literal is a later slice), gated like `IntSet.create()`.
	function parseSetFromConstruction(func IrFunction) returns ValueId throws ParseError
		let setTok = try self.consume(TokenKind.identifier)
		try self.consume(TokenKind.from)

		// The source must be an array literal `[…]`; `Set from <other-expr>` is not a construction shv2 parses.
		if not self.at(TokenKind.leftBracket) 'notArrayLiteral'
			let srcTok = self.current()
			throw ParseError.unsupported("`Set from` requires an array literal `[…]` — `Set from <expr>` for another source is a later slice", line: srcTok.line, column: srcTok.column)
		end 'notArrayLiteral'

		let arr = try self.parseArrayLiteral(func)
		let setGid = try self.setInstanceForArrayLiteral(self.valueNameId(arr), setTok: setTok)
		let set = self.emitRuntimeCall(SetFromName, args: singletonArgs(arr), resultTag: ValueTypeTag.genericInstance, resultNameId: setGid, range: SourceRange.ofToken(setTok))
		self.trackOwnedTemp(set)
		return set
	end 'parseSetFromConstruction'

	// The `Set with <elem>` instance a `Set from [<literal>]` constructs — its key type is the array literal's
	// ELEMENT type. A `Set from [ints]` → `Set with integer` (whose `integer` element canonicalizes to the `int`
	// witness); a `Set from ["…"]` → `Set with String`. INT and STRING elements this slice: a struct / ByteArray
	// literal is a clean E2015 here rather than a link failure at the missing key witness. Both source instances
	// (`Array with integer` / `Array with String`) and both `Set` instances are pre-interned by the sweep, so
	// these are pure reads.
	function setInstanceForArrayLiteral(arrGid GenericInstanceId, setTok Token) returns GenericInstanceId throws ParseError
		if arrGid == self.signatures.internBuiltinIntegerInstance(ArrayBuiltinBaseName) 'intKey'
			return self.signatures.internBuiltinIntegerInstance(SetBuiltinBaseName)
		end 'intKey'
		if arrGid == self.signatures.arrayInstanceForString() 'stringKey'
			return self.signatures.setInstanceForString()
		end 'stringKey'
		throw ParseError.unsupported("`Set from […]` supports `int` and `String` keys — a struct / ByteArray literal is a later slice", line: setTok.line, column: setTok.column)
	end 'setInstanceForArrayLiteral'

	// ⭐ **DISPATCH A `Set` METHOD off a binding receiver (P1.7b slice A)** — the set twin of
	// `parseArrayMethodCall`. `s.insert(e)` / `s.contains(e)` / `s.remove(e)` / `s.count()`; the receiver is a
	// live `Set` instance (a moved-from set is use-after-move, E3102). The set record's address is stable across
	// a grow (only its buffer pointers move), so a mutating method never rebinds the receiver.
	function parseSetMethodCall(func IrFunction, binding VarInfo, receiverOwner MutatedParamMask, baseTok Token, resultUsed bool) returns ValueId throws ParseError
		self.advance()
		try self.consume(TokenKind.dot)
		try self.requireBindingLive(binding, nameTok: baseTok)
		return try self.dispatchSetMethod(func, set: binding.boundValue, resultUsed: resultUsed, immutableReceiverName: self.immutableReceiverNameOf(binding, baseTok: baseTok), receiverOwner: receiverOwner)
	end 'parseSetMethodCall'

	// Dispatch a builtin `Set` method — cursor on the method NAME, `set` the (borrowed) receiver record (P1.7b).
	// `contains`/`remove` return `bool`; `count` returns the member count; `insert` is a VOID mutator (rejected in
	// value position, E3059) that returns the receiver — what the statement still denotes, like `emitArrayVoidCall`.
	// `insert`/`contains`/`remove` carry the key's witness tables, appended by `LowerMaxonToStd.appendSetWitnessArgs`;
	// the parser passes only `[set, elem]`. The set's key type (`giid`, off the receiver's name-id) gates the key
	// argument's type and decides ownership: `insert` MOVES a managed key in (`consume: true`), while
	// `contains`/`remove` BORROW it (`consume: false`).
	function dispatchSetMethod(func IrFunction, set ValueId, resultUsed bool, immutableReceiverName ByteArray, receiverOwner MutatedParamMask) returns ValueId throws ParseError
		let methodTok = try self.consume(TokenKind.identifier)
		let range = SourceRange.ofToken(methodTok)
		let giid = self.valueNameId(set)

		// A `let`-bound set is not writable either — the same rule, through the same home the `String` and
		// `Array` receivers ask (`noteReceiverWrite`). This dispatcher carried NO such guard, which
		// accepted `let s = IntSet.create()` / `s.insert(1)` where the oracle raises E3019.
		// `receiverStorage: NoMutatedParams` for the reason the `String` dispatcher states: a `Set` write
		// cannot free an ARRAY element, which is the only borrow E3070 tracks.
		try self.noteReceiverWrite(func, immutableReceiverName: immutableReceiverName, receiverOwner: receiverOwner, receiverStorage: NoMutatedParams, methodTok: methodTok, mutatesReceiver: setMethodMutatesReceiver(methodTok.value))

		if methodTok.value.equals(SetCountMethod) 'count'
			try self.parseArrayNoArgs()
			return self.emitRuntimeCall(SetCountName, args: singletonArgs(set), resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: range)
		end 'count'
		if methodTok.value.equals(SetContainsMethod) 'contains'
			let elem = try self.parseSetKeyArg(func, giid: giid, consume: false)
			return self.emitRuntimeCall(SetContainsName, args: pairArgs(set, second: elem), resultTag: ValueTypeTag.boolean, resultNameId: UnnamedTypeId, range: range)
		end 'contains'
		if methodTok.value.equals(SetRemoveMethod) 'remove'
			let elem = try self.parseSetKeyArg(func, giid: giid, consume: false)
			return self.emitRuntimeCall(SetRemoveName, args: pairArgs(set, second: elem), resultTag: ValueTypeTag.boolean, resultNameId: UnnamedTypeId, range: range)
		end 'remove'

		// `insert` is a non-throwing VOID mutator — rejected in value position (E3059, the shared check).
		try self.requireArrayVoidStatement(resultUsed, methodTok: methodTok)
		if methodTok.value.equals(SetInsertMethod) 'insert'
			let elem = try self.parseSetKeyArg(func, giid: giid, consume: true)
			_ = self.emitRuntimeCall(SetInsertName, args: pairArgs(set, second: elem), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
			return set
		end 'insert'

		throw ParseError.unsupported("`Set` method '{String.from(methodTok.value)}' — P1.7b provides create/insert/contains/remove/count; `from`-construction and iteration are later slices", line: methodTok.line, column: methodTok.column)
	end 'dispatchSetMethod'

	// `( key )` — a single positional key argument for `insert`/`contains`/`remove` (P1.7b). The key's type must
	// match the set's key type (int or String), rejected here so a mismatched value (an int where a String key is
	// expected, or vice versa — a pointer hashed as an integer, or an int hashed as String bytes) is a clean E2015
	// rather than a wrong answer. For `insert` (`consume: true`) a managed (String) key is MOVED into the set —
	// the set becomes its sole owner (`moveKeyIntoSet`, the set twin of `moveElementIntoArray`); `contains`/`remove`
	// (`consume: false`) BORROW the key for the compare (its owned temp drops at statement end). A trivial int key
	// is a scalar — no move either way.
	function parseSetKeyArg(func IrFunction, giid GenericInstanceId, consume bool) returns ValueId throws ParseError
		try self.consume(TokenKind.leftParen)
		let keyTok = self.current()
		let valueStart = self.pos
		let key = try self.parseExpression(func, block: self.currentBlock)
		try self.requireSetKeyMatchesType(key, giid: giid, keyTok: keyTok)
		// The move-in MUST run before the `)` is consumed — `rhsWasBareLocalReference` reads `[valueStart, self.pos)`
		// to decide whether the arg is a bare local to POISON, exactly as `parseArrayElementArg` moves before its `)`.
		var result = key
		if consume 'moveIn'
			result = try self.moveKeyIntoSet(key, giid: giid, valueStart: valueStart)
		end 'moveIn'
		try self.consume(TokenKind.rightParen)
		return result
	end 'parseSetKeyArg'

	// The key VALUE's tag must match the set's key TYPE (P1.7b): an int-keyed set takes an integer value, a
	// String-keyed set takes a String value. `requireSetKeyType` at `create` fixed the KEY type; this rejects a
	// mismatched value at the call (a String pointer hashed as an int, or an int hashed as String bytes, would be
	// a wrong answer or a fault). Only int and String keys reach here — the create gate admits no other.
	//
	// ⚠ **"IS THIS AN INT?" IS `tagIsIntegral`, NOT `== ValueTypeTag.integer`, AND THE NARROW SPELLING WAS A
	// MEASURED FALSE REFUSAL.** A value whose static type is a RANGED ALIAS carries the `named` tag until
	// TypeResolution collapses it — which is every parameter and every field read of `typealias Integer =
	// int(…)` — so `insert(v)` inside `function add(s IntSet, v Integer)` was rejected as *"`Set with int`
	// requires an int key — got a 'int' value"*, a sentence that argues against itself precisely because
	// `typeTagName` already reads `named` as `int`. It was unreachable through a self-field receiver only
	// because the false E3019 this rung removed fired first, which is how it survived. Ownership is unaffected:
	// the move-in asks `setKeyIsManaged` — the SET's key TYPE — and never this tag.
	function requireSetKeyMatchesType(key ValueId, giid GenericInstanceId, keyTok Token) throws ParseError
		let keyTag = self.tagOf(key)
		if tagIsText(maxonTypeTag(self.signatures.setKeyType(giid))) 'stringKey'
			if not tagIsText(keyTag) 'notString'
				throw ParseError.unsupported("`Set with String` requires a String key — got a '{typeTagName(keyTag)}' value", line: keyTok.line, column: keyTok.column)
			end 'notString'
			return
		end 'stringKey'
		if not tagIsIntegral(keyTag) 'notInt'
			throw ParseError.unsupported("`Set with int` requires an int key — got a '{typeTagName(keyTag)}' value", line: keyTok.line, column: keyTok.column)
		end 'notInt'
	end 'requireSetKeyMatchesType'

	// ⭐ **MOVE A PARSED KEY INTO A MANAGED-KEY SET (P1.7b String keys).** The `Set` twin of `moveElementIntoArray`:
	// the set becomes the key's sole owner (its `__set_decref` walk / dup-drop / remove-drop destroys it), so a
	// managed (String) key is consumed exactly as an array element is — a borrowed String literal is promoted to
	// an owned copy, an owned value is transferred (bare local poisoned / temp de-listed) — through the SHARED
	// `moveManagedValueInto`. A trivial int key owns no heap and passes through unchanged. A `Set` key is always
	// CONCRETE this slice (int or String), so there is no opaque-`T` case `moveElementIntoArray` carries.
	// `valueStart` locates the value's first token — its bare-local source and the diagnostic anchor both.
	function moveKeyIntoSet(value ValueId, giid GenericInstanceId, valueStart TokenIndex) returns ValueId throws ParseError
		if not self.signatures.setKeyIsManaged(giid) 'trivial'
			return value
		end 'trivial'
		let anchor = self.tokenAt(valueStart)
		let isString = tagIsText(maxonTypeTag(self.signatures.setKeyType(giid)))
		return try self.moveManagedValueInto(value, argBareLocal: self.rhsWasBareLocalReference(valueStart), isString: isString, anchor: anchor, range: SourceRange.ofToken(anchor))
	end 'moveKeyIntoSet'

	// ⭐ **DISPATCH A BUILTIN `Array` METHOD off an instance receiver (P1.7 slice 1).** The array twin of
	// `parseStringMethodCall`: the receiver is a live `Array` instance (a moved-from array touched here is
	// use-after-move, E3102). `get`/`set`/`first`/`last`/`pop`/`remove` are THROWING — they emit a plain
	// `call` that the enclosing `try …` rewrites to a `tryCall` (`rewriteLastCallToTryCall`), so they must be
	// the last op emitted; the rest are non-throwing. A non-throwing VOID method (`push`/`reserve`/`resize`/
	// `clear`/`insert`) in value position is E3059. The array record's ADDRESS is stable across a grow (only
	// its `buffer@0` moves), so a mutating method never rebinds the receiver.
	function parseArrayMethodCall(func IrFunction, binding VarInfo, receiverOwner MutatedParamMask, baseTok Token, giid GenericInstanceId, resultUsed bool) returns ValueId throws ParseError
		// ⭐ The receiver's own token, captured before the cursor leaves it — the E3070 subject comes through
		// the SAME derivation the iteration lock's does (`borrowSubjectNameAt`), never off `binding`: a bare
		// self-field receiver arrives here as a `VarInfo` MINTED FRESH per access (`methodReceiverBinding`),
		// so identity on it would key one storage under a new object at every write. The NAME resolves to the
		// one alias installed at method entry.
		let baseIndex = self.pos
		self.advance()
		try self.consume(TokenKind.dot)
		try self.requireBindingLive(binding, nameTok: baseTok)
		let subjectName = self.borrowSubjectNameAt(baseIndex)
		return try self.dispatchArrayMethod(func, arr: binding.boundValue, giid: giid, resultUsed: resultUsed, immutableReceiverName: self.immutableReceiverNameOf(binding, baseTok: baseTok), borrowSubjectName: subjectName, receiverOwner: receiverOwner, receiverStorage: self.subjectStorageMask(func, subjectName: subjectName))
	end 'parseArrayMethodCall'

	// ⭐ **THE NAME AN E3019 WOULD BLAME FOR THIS BINDING-BACKED RECEIVER — EMPTY when it may be
	// written through.** The ONE place the `let` rule and the parameter exception meet, for EVERY
	// container: `String`, `Array` and `Set` all ask through here (see `noteReceiverWrite`).
	//
	// A `var` may be written through, and so may a PARAMETER — which is NOT `mutable` (a parameter
	// cannot be rebound, `ParametersAreMutable`) yet whose container very much can be written, because
	// the parameter is a borrowed reference to the caller's record. `let a = [1,2,3]` may not, however
	// it was bound — a literal, a `create()`, an alias of a field or of another local.
	//
	// **Every answer here is the runnable oracle's, measured one program at a time**, and the parameter
	// case is not a nicety: without it every container-mutating helper in the corpus is rejected.
	//
	// ⚠ **`isParameter` IS NOT `boundValue < paramCount` WEARING A FLAG, AND THE DIFFERENCE IS A
	// MEASURED ANSWER.** The parameter ValueId convention (`requireReceiverValue`) tempts a reader to
	// derive this from the value instead of storing it — but a `let` that ALIASES a parameter carries
	// the parameter's own ValueId while being a `let`, and `let a = p` / `a.push(9)` is **E3019 in the
	// oracle** (measured). Deriving it from the value would silently accept that. The flag distinguishes
	// "this binding IS the parameter" from "this binding holds the parameter's value"; the ValueId
	// cannot. Do not "simplify" it away.
	//
	// ⭐ **AN ITERATED BINDING IS UNWRITABLE WHATEVER IT WAS DECLARED** — checked FIRST, because the
	// question a `for … in` body asks is not "was this declared `let`?" but "would this write free the
	// element the loop is borrowing?" (see `bindingIsIterationLocked`). A `var` and a PARAMETER both
	// answer "writable" to the two tests below and both would destroy the borrow.
	function immutableReceiverNameOf(binding VarInfo, baseTok Token) returns ByteArray
		if self.bindingIsIterationLocked(binding) 'iterated'
			return baseTok.value
		end 'iterated'
		if binding.mutable or binding.isParameter 'writable'
			return EmptySourceText
		end 'writable'
		return baseTok.value
	end 'immutableReceiverNameOf'

	// A method on an array-typed VALUE that is not a plain local binding — a fresh literal (`[10,20,30].get(0)`)
	// or any array-valued expression, reached from the postfix loop and the `try` target. The cursor sits on
	// the `.`; the receiver `arr` is already parsed (and, for a literal, already an owned pending temp that
	// drops at statement end).
	function parseArrayMethodOnValue(func IrFunction, arr ValueId, giid GenericInstanceId, resultUsed bool, immutableReceiverName ByteArray, borrowSubjectName ByteArray) returns ValueId throws ParseError
		try self.consume(TokenKind.dot)
		// A receiver that is not a binding is WRITABLE: it is a fresh literal, a call result or a field
		// read, and no `let` promises anything about it. There is also no name a rejection could blame,
		// which is exactly what the empty answer says — so the callers that reach a genuinely anonymous
		// receiver pass the empty name, and the FIELD-CHAIN caller passes the one name that can still
		// refuse: the chain's base while a `for … in` is iterating through it (`iterationLockNameAt`).
		// It denotes no PARAMETER either way, so a write through it mutates none: `NoMutatedParams`.
		return try self.dispatchArrayMethod(func, arr: arr, giid: giid, resultUsed: resultUsed, immutableReceiverName: immutableReceiverName, borrowSubjectName: borrowSubjectName, receiverOwner: NoMutatedParams, receiverStorage: self.subjectStorageMask(func, subjectName: borrowSubjectName))
	end 'parseArrayMethodOnValue'

	// ⭐ **DISPATCH AN INTERFACE METHOD ON A CONSTRAINED TYPE-PARAMETER VALUE (P1.7a slice 2a).** `receiver` is a
	// `typeParameter`-tagged value (`self.item`, a `T` field read) and the cursor sits on the `.` before the
	// method name. The concrete type is UNKNOWN in the shared body, so it dispatches through the runtime WITNESS:
	// the enclosing type's `where` constraint whose interface declares this method supplies the witness, and the
	// method's decl-order slot in that interface is the table index. Emits `MaxonOp.witnessDispatch`, which
	// `lowerMaxonToStd` turns into the fused `StdOp.witnessCall`. The receiver is BORROWED (arg 0); its user
	// arguments (none for `digest()`) follow it in `args`.
	//
	// ⭐ **ITS ARGUMENT LIST IS PARSED AND SLOTTED BY THE SAME DOORS EVERY OTHER CALL USES (P1.7a slice
	// 2b-vi).** It used to be a bare comma loop of `parseValueExpression` — a third, unwritten spelling of
	// "parse an argument list" that read no `name:` label, checked no arity and performed no label→position
	// slotting. The same method therefore obeyed OPPOSITE rules depending on how it was reached: `add(1, 2)`
	// was E2053 on the concrete receiver and accepted here, while `add(1, b: 2)` was accepted there and
	// `E2004: Undefined variable 'b'` here. And the missing arity check was not cosmetic — an under-supplied
	// dispatch read an UNINITIALISED REGISTER as its missing actual and returned it (measured: exit
	// 1073754132 from a clean compile; with a ranged return type, a spurious `Range check failed` panic on a
	// correct program). `parseCallArgs` + `slotCallArgs` fix all of it by deleting the second spelling.
	function parseWitnessMethodOnValue(func IrFunction, receiver ValueId, resultUsed bool) returns ValueId throws ParseError
		try self.consume(TokenKind.dot)
		let methodTok = try self.consume(TokenKind.identifier)
		let receiverParamPos = self.valueNameId(receiver)
		let target = try self.resolveWitnessDispatch(receiverParamPos, methodTok: methodTok)

		try self.consume(TokenKind.leftParen)
		// FRESH columns holding the USER's arguments only — the borrowed receiver is prepended after
		// slotting, not before it. `parseCallArgs` counts arguments from 0 against the SOURCE, so the
		// receiver must not be in the array or the user's first argument would be judged as its second.
		var userArgs = ValueIdArray.create()
		var argLabels = ByteArrayArray.create()
		var argRanges = SourceRangeArray.create()
		// `argImmutableNames` is filled and DISCARDED: it exists to blame a binding for E3019 (an immutable
		// argument at a MUTATING parameter), and a mutation summary is keyed by callee — which a witness
		// dispatch has not got. Under dictionary-passing there is no one impl whose mutation of a parameter
		// could be the answer, so the question is not merely unasked here, it is unaskable at this call.
		var argImmutableNames = ByteArrayArray.create()
		// The first argument's label is OPTIONAL at an interface / type-parameter receiver and MANDATORY
		// from the second on — see `consumeArgLabel`.
		//
		// The callee is passed EMPTY, and E3070's call-argument door is unaskable here for the SAME reason
		// `argImmutableNames` is discarded above: the borrow check asks whether the callee writes the storage
		// this argument names, and that summary is keyed by callee. Under dictionary-passing a witness dispatch
		// has no one impl to key on. `noteBorrowSubjectCallArg` refuses an unnamed callee explicitly rather
		// than letting the summary lookup miss — see there.
		try self.parseCallArgs(func, callee: EmptySourceText, anchor: methodTok, args: userArgs, argLabels: argLabels, argRanges: argRanges, argImmutableNames: argImmutableNames, allowFirstNamed: true)
		let rparenTok = try self.consume(TokenKind.rightParen)
		let args = try self.slottedWitnessArgs(target, receiver: receiver, userArgs: userArgs, argLabels: argLabels, argRanges: argRanges, methodTok: methodTok)

		// A `Self`-typed formal (`equals(other Self)`) requires an argument that is a value of `T` — a concrete
		// literal (`self.item.equals(42)`) would be marshalled into the `Self` pointer and faulted. The SAME
		// reject the `==` operator form runs, one shared helper.
		try self.requireGenuineSelfArgs(target, args: args, what: String.from(methodTok.value), receiverParamPos: receiverParamPos, errorTok: methodTok)

		let range = SourceRange.between(methodTok, last: rparenTok)
		let result = try self.mintWitnessDispatchResult(target, receiverParamPos: receiverParamPos, methodTok: methodTok, resultUsed: resultUsed)
		self.emitWitnessDispatch(result, args: args, target: target, isVoid: target.returnTypeName.equals(InterfaceVoidTypeName), range: range, siteTok: methodTok)
		return result
	end 'parseWitnessMethodOnValue'

	// ⭐ **THE USER'S ARGUMENTS IN THE INTERFACE'S DECLARATION ORDER, WITH THE BORROWED RECEIVER BACK AT
	// `args[0]` (P1.7a slice 2b-vi)** — or the first slotting failure, as the SAME code a direct call's
	// would get. The slotting itself is `Project.slotCallArgs`, the one home of the label→position mapping;
	// nothing about labels is re-derived here.
	//
	// ⭐ **THE LABELS BIND AGAINST THE INTERFACE, NOT THE CONFORMER.** Under dictionary-passing the shared
	// body has no concrete callee to ask — the same reason slice 2b-v types a `try`'s binding off the
	// interface's `throws` clause — and it is forced by shv2's own conformance rule besides:
	// `ConformanceCheck.signatureMatches` compares arity and TYPES only (it reads `paramNames` to format
	// E3016 and never compares it), so two conformers may spell their parameters differently and only the
	// interface's names are common to every one of them.
	//
	// The receiver is prepended AFTER slotting, restoring the `args[0]` = receiver / interface formal `j` =
	// `args[j+1]` convention that `requireGenuineSelfArgs`, `floatWidenedWitnessArgs` and
	// `emitWitnessDispatch` all index by — none of which is label-aware, and none of which needs to be.
	function slottedWitnessArgs(target WitnessDispatchTarget, receiver ValueId, userArgs ValueIdArray, argLabels ByteArrayArray, argRanges SourceRangeArray, methodTok Token) returns ValueIdArray throws ParseError
		match slotCallArgs(target.paramNames, args: userArgs, argLabels: argLabels) 'slot'
			ordered(ids) then return withWitnessReceiver(receiver, ordered: ids)
			// The ARITY error blames the call, the two LABEL errors blame the offending argument — the same
			// split `SemanticCheck.validateCall` makes, `methodTok` being this call's own anchor (it is what
			// `SourceRange.between(methodTok, last: rparenTok)` starts the dispatch op's range at).
			arityMismatch(expected, got) then throw ParseError.witnessArgCountMismatch(self.witnessCalleeName(target), expected: expected, got: got, line: methodTok.line, column: methodTok.column)
			unknownLabel(argIndex, label) then throw ParseError.witnessUnknownArgLabel(self.witnessCalleeName(target), label: label, line: witnessArgAnchor(argRanges, argIndex: argIndex).line, column: witnessArgAnchor(argRanges, argIndex: argIndex).column)
			duplicateArg(argIndex, paramName) then throw ParseError.witnessDuplicateArg(self.witnessCalleeName(target), paramName: paramName, line: witnessArgAnchor(argRanges, argIndex: argIndex).line, column: witnessArgAnchor(argRanges, argIndex: argIndex).column)
		end 'slot'
	end 'slottedWitnessArgs'

	// What a witness dispatch's argument diagnostics BLAME: `<Interface>.<method>`, which is what the call
	// actually binds against. A direct call names its callee; a dispatch has no callee name to name — the
	// concrete impl is not known in the shared body, and naming one conformer's would be a lie at every
	// other instantiation. The interface comes from the constraint the method was resolved through
	// (`findWitnessDispatch` stored its index), so it is derived on the COLD path and costs a dispatch that
	// compiles nothing.
	function witnessCalleeName(target WitnessDispatchTarget) returns String
		let constraint = try self.enclosingWhereConstraints.get(target.constraintIndex) otherwise panic("witnessCalleeName: enclosingWhereConstraints.get OOB at {target.constraintIndex} — the index came from `findWitnessDispatch`'s own walk of this array")
		return "{String.from(constraint.interfaceName)}.{String.from(target.methodName)}"
	end 'witnessCalleeName'

	// ⭐ **THE ONE DOOR A `witnessDispatch` IS EMITTED THROUGH** — the `.method()` form and the comparison-
	// OPERATOR form (`emitTypeParamComparison`) both come here, so the op's `isThrowing` stamp and the
	// `lastWitnessDispatch*` record are written for BOTH by construction rather than remembered at each. A
	// dispatch whose record was missed would leave a `try` on it typing its `(e)` binding off a stale clause;
	// keeping the emit and the record in one place is what makes that unrepresentable.
	function emitWitnessDispatch(result ValueId, args ValueIdArray, target WitnessDispatchTarget, isVoid bool, range SourceRange, siteTok Token)
		let placed = self.floatWidenedWitnessArgs(target, args: args, siteTok: siteTok)

		self.lastWitnessDispatchIndex = self.artifact.module.ops.count()
		self.lastWitnessDispatchName = target.methodName
		self.lastWitnessDispatchThrows = target.throwsClause
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.witnessDispatch(result, args: placed, constraintIndex: target.constraintIndex, methodIndex: target.methodIndex, isVoid: isVoid, isThrowing: throwsClauseIsThrowing(target.throwsClause)), range: range)
	end 'emitWitnessDispatch'

	// ⭐⭐ **WIDEN AN INTEGRAL ACTUAL SUPPLIED FOR A `float` INTERFACE FORMAL — the witness twin of
	// `LowerMaxonToStd.widenIntArgsToFloatParams`, and it was MISSING.** A DIRECT call gets this from the
	// callee's resolved signature at the Maxon→Std boundary; a witness dispatch has no callee to look up, so
	// its arguments reached the fused `witnessCall` exactly as written — and the op's `argFloatMask`
	// (`LowerMaxonToStd.argFloatMaskOf`) is read off those already-typed arg VALUES, not off the interface.
	// An `int` actual for a `float` formal therefore declared the argument a GPR/i64 while the conforming impl
	// declares it XMM/f64:
	//
	// **MEASURED (both on `interface Scaled { function scale(k float) returns float }` with
	// `self.item.scale(2)`): x64 compiled clean and returned the WRONG ANSWER** — `movRegImm32 rdx, 2` ahead of
	// `callMem [rbx + 24]`, so the callee's `mulsd xmm0, …` multiplied whatever was left in xmm0 — **and wasm
	// trapped `indirect call type mismatch`**, since `call_indirect` checks the declared functype against the
	// target's own exactly. The wasm half is the hole `requireIndirectlyReachableParamsAreMachineWords` cannot
	// see: it refuses a narrow (i32) parameter, but an f64 one is legal and only DIVERGES when the call site's
	// float mask disagrees — which is precisely what this widening removes.
	//
	// It runs in `emitWitnessDispatch` because that is the ONE door both dispatch forms come through, so the
	// `.method()` and comparison-OPERATOR forms cannot acquire different argument placement. `promoteToFloat`
	// is idempotent, so a genuine `float` actual passes through untouched and emits nothing.
	//
	// ⚠ **IT WAS ARITY-TOLERANT AND IS NOT ANY MORE (P1.7a slice 2b-vi).** A witness dispatch's arity was
	// unchecked when this was written (`self.item.scale()` with no argument compiled), so it walked the
	// ACTUALS and treated a formal-less actual as non-float rather than reading past `paramTypeNames`. Both
	// dispatch forms now guarantee one actual per formal (see `requireGenuineSelfArgs`), so the two counts
	// agree and walking the actuals is simply walking the formals — the loop is unchanged, and what changed
	// is that `witnessFormalIsFloat` may now panic on an index it once absorbed.
	function floatWidenedWitnessArgs(target WitnessDispatchTarget, args ValueIdArray, siteTok Token) returns ValueIdArray
		// FAST PATH, for `widenIntArgsToFloatParams`'s reason: only a `float` FORMAL can force a widening and
		// almost no interface method has one, so every other dispatch returns its arguments verbatim — no array
		// built, no op emitted, and the whole conformance corpus stays byte-identical.
		if not self.witnessTargetHasFloatFormal(target) 'noFloatFormal'
			return args
		end 'noFloatFormal'

		var placed = ValueIdArray.create()

		// `args[0]` is the BORROWED receiver, which fills no formal — interface formal `j` is `args[j+1]`, the
		// same mapping `requireGenuineSelfArgs` walks. It is copied across before the loop so the loop body
		// never has to subtract from an index that could be 0.
		placed.push(try args.get(0) otherwise panic("floatWidenedWitnessArgs: a witness dispatch's args are empty — `args[0]` is the receiver, pushed by both dispatch forms before any actual"))

		for j in 0 upto args.count() - 1 'eachActual'
			let actual = try args.get(j + 1) otherwise panic("floatWidenedWitnessArgs: args.get OOB at {j + 1} below count {args.count()}")

			if not self.witnessFormalIsFloat(target, formalIndex: j) 'noWiden'
				placed.push(actual)
				continue
			end 'noWiden'

			placed.push(self.promoteToFloat(actual, opTok: siteTok))
		end 'eachActual'

		return placed
	end 'floatWidenedWitnessArgs'

	// Does ANY formal of the dispatched interface method declare `float`? The fast-path predicate above, kept
	// beside the per-formal test so the two read the same constant.
	function witnessTargetHasFloatFormal(target WitnessDispatchTarget) returns bool
		for j in 0 upto target.paramTypeNames.count() 'eachFormal'
			if self.witnessFormalIsFloat(target, formalIndex: j) 'found'
				return true
			end 'found'
		end 'eachFormal'
		return false
	end 'witnessTargetHasFloatFormal'

	// Is interface formal `formalIndex` declared `float`? Both askers stay within the declared formals — one
	// loops the formals directly, the other loops actuals a checked arity has made equinumerous with them
	// (see `floatWidenedWitnessArgs`) — so an out-of-range index is a compiler defect, not an arity mismatch
	// to absorb. The name is spelled by `FloatConformerName`, the same constant `interfaceReturnMaxonType`
	// reads it by.
	function witnessFormalIsFloat(target WitnessDispatchTarget, formalIndex ElementCount) returns bool
		return (try target.paramTypeNames.get(formalIndex) otherwise panic("witnessFormalIsFloat: paramTypeNames.get OOB at {formalIndex} below count {target.paramTypeNames.count()} — a dispatch reaching here has one actual per formal")).equals(FloatConformerName)
	end 'witnessFormalIsFloat'

	// Resolve `<receiver>.<method>()` against the enclosing type's `where` constraints (P1.7a slice 2a): find the
	// constraint on the receiver's type parameter whose interface declares `method`, returning its slot index,
	// the method's decl-order index, and its return type. The interface is resolved SAME-FILE (declared before
	// its constrained use), so a forward/cross-file interface is a clean reject rather than a silent miss.
	function resolveWitnessDispatch(receiverParamPos TypeParamId, methodTok Token) returns WitnessDispatchTarget throws ParseError
		match try self.findWitnessDispatch(receiverParamPos, methodName: methodTok.value, errorTok: methodTok) 'lookup'
			found(target) then return target
			notFound then throw ParseError.unsupported("no `where` constraint on this type parameter declares a method '{String.from(methodTok.value)}' — a method call on a constrained type parameter must be provided by one of its interfaces", line: methodTok.line, column: methodTok.column)
		end 'lookup'
	end 'resolveWitnessDispatch'

	// The non-throwing CORE of witness-dispatch resolution (P1.7a slice 2b): find the constraint on
	// `receiverParamPos`'s type parameter whose interface declares `methodName`, returning its slot index, the
	// method's decl-order index, and its return type — or `notFound` when none does. Shared by the `.method()`
	// dispatch (`resolveWitnessDispatch`, which rejects a miss as "no constraint provides this method") and the
	// COMPARISON-OPERATOR lowering (`requireOperatorWitness`, which rejects a miss as E3005 — for `equals` and
	// for `compare` alike), so the constraint search is written once and each caller owns its own diagnostic for
	// the miss. `errorTok` positions `requireInterfaceForParse`'s
	// undeclared-interface reject.
	function findWitnessDispatch(receiverParamPos TypeParamId, methodName ByteArray, errorTok Token) returns WitnessDispatchLookup throws ParseError
		for i in 0 upto self.enclosingWhereConstraints.count() 'eachConstraint'
			let constraint = try self.enclosingWhereConstraints.get(i) otherwise panic("findWitnessDispatch: enclosingWhereConstraints.get OOB at {i}")
			if constraint.typeParamIndex != receiverParamPos 'otherParam'
				continue
			end 'otherParam'

			let iface = try self.requireInterfaceForParse(constraint.interfaceName, methodTok: errorTok)
			let methodIndex = interfaceMethodIndex(iface, methodName: methodName)
			if methodIndex < iface.methods.count() 'declaresMethod'
				let method = try iface.methods.get(methodIndex) otherwise panic("findWitnessDispatch: methods.get OOB at {methodIndex} below count {iface.methods.count()}")
				return WitnessDispatchLookup.found(WitnessDispatchTarget.create(i, methodIndex: methodIndex, returnTypeName: method.returnTypeName, paramTypeNames: method.paramTypeNames, throwsClause: method.throwsClause, methodName: methodName, paramNames: method.paramNames))
			end 'declaresMethod'
		end 'eachConstraint'

		return WitnessDispatchLookup.notFound
	end 'findWitnessDispatch'

	// Resolve an interface NAME during PARSING (P1.7a slice 2a) — a synthesized builtin FIRST (matching
	// `ConformanceCheck.resolveInterface`), then a user interface declared in THIS file. A `where` constraint's
	// interface must be declared before the type it constrains (this slice resolves interfaces same-file, from
	// the parse artifact rather than the not-yet-merged `project.interfaces`); an unresolved name is a clean
	// reject at the dispatch site.
	function requireInterfaceForParse(name ByteArray, methodTok Token) returns IrInterface throws ParseError
		match builtinInterface(name) 'builtin'
			found(iface) then return iface
			notFound then break 'builtin'
		end 'builtin'

		for iface in self.artifact.interfaces 'each'
			if iface.name.equals(name) 'hit'
				return iface
			end 'hit'
		end 'each'

		throw ParseError.unsupported("the `where` constraint interface '{String.from(name)}' is not declared before its constrained use — P1.7a slice 2a resolves a constraint's interface within the same file, declared before the generic type", line: methodTok.line, column: methodTok.column)
	end 'requireInterfaceForParse'

	// Mint the SSA value a witness dispatch defines, typed from the interface method's return type (P1.7a slice
	// 2a) — the witness-dispatch twin of `mintDeclaredCallResult`. A `void` method mints a discarded `void`
	// result in statement position and reports E2004 in value position (like a void direct call); a `Self`
	// return is the receiver's own type parameter (the shared body cannot know the concrete type); every other
	// return type is minted through `mintOwnedCallResult`, so a heap-returning interface method's result is
	// adopted owned exactly as a direct call's is.
	function mintWitnessDispatchResult(target WitnessDispatchTarget, receiverParamPos TypeParamId, methodTok Token, resultUsed bool) returns ValueId throws ParseError
		if target.returnTypeName.equals(InterfaceVoidTypeName) 'voidReturn'
			if resultUsed 'noValueToUse'
				throw ParseError.voidCallResultUsed(String.from(methodTok.value), line: methodTok.line, column: methodTok.column)
			end 'noValueToUse'
			return self.mintValue(ValueTypeTag.void, nameId: UnnamedTypeId)
		end 'voidReturn'

		if target.returnTypeName.equals(InterfaceSelfTypeName) 'selfReturn'
			return self.mintOwnedCallResult(MaxonType.typeParameter(receiverParamPos))
		end 'selfReturn'

		return self.mintOwnedCallResult(self.interfaceReturnMaxonType(target.returnTypeName))
	end 'mintWitnessDispatchResult'

	// A non-void, non-`Self` interface return TYPE NAME (P1.7a slice 2a) as a `MaxonType`: the primitive
	// keywords map to their tags, `String` to the builtin, and every other name — a user ranged alias
	// (`Code`), a struct — to a `named` type `mintOwnedCallResult` resolves through the same alias/struct doors
	// a direct call's return does.
	//
	// ⭐ **`ExitCode` IS CLAIMED HERE, WITH THE KEYWORDS AND NOT WITH THE USER NAMES, AND THE REASON IS A
	// WIDTH (P1.7a slice 2b-iv-B).** An interface stores its return type as a rendered source STRING, so this
	// function RE-DERIVES what a declaration derived once — and the `named` fallback is only safe while the
	// two derivations agree. They agree for every name but this one: a ranged alias, an enum and a struct all
	// collapse to an i64 machine word whichever route reaches them (`valueTagToStdType`), whereas `ExitCode`
	// is the ONE builtin whose tag carries a sub-64 width (u32). Left to the fallback, the dispatch site typed
	// its result i64 while the conforming impl declared u32 — invisible on the register targets, where every
	// value occupies a 64-bit register, and a **`wasm trap: indirect call type mismatch`** on wasm, whose
	// `call_indirect` checks the declared functype against the target's own EXACTLY. MEASURED: an
	// `ExitCode`-returning interface method returned 42 on x64 and trapped under wasmtime.
	//
	// It is claimed by the SAME named constant `denotedNamedType` claims it by — the authority for what a type
	// NAME denotes — rather than a second spelling of the bytes, since a second spelling is the thing that
	// would let the two drift apart again. It cannot be routed through that cascade wholesale: this function
	// answers for the VALUE column, where a ranged alias deliberately keeps its `named` identity (see
	// `castConvertsPerInstance`), while the cascade erases it for the SIGNATURE column.
	// ⚠ Every name below is spelled by the CANONICAL constant `IrInterface` already exports for it, never by a
	// fresh `b"…"` — `BoolConformerName`'s own header says a second spelling of one of these "is the same fact
	// and so must not become a second constant", and these four are the same four names the interface
	// declarations, the conformance answer and the synthesized impl symbols are all keyed by.
	function interfaceReturnMaxonType(returnTypeName ByteArray) returns MaxonType
		if returnTypeName.equals(BoolConformerName) 'boolReturn'
			return MaxonType.boolean
		end 'boolReturn'
		if returnTypeName.equals(IntConformerName) 'intReturn'
			return MaxonType.integer
		end 'intReturn'
		if returnTypeName.equals(FloatConformerName) 'floatReturn'
			return MaxonType.float
		end 'floatReturn'
		if returnTypeName.equals(StringConformerName) 'stringReturn'
			return MaxonType.string
		end 'stringReturn'
		if returnTypeName.equals(ExitCodeBuiltinName) 'exitCodeReturn'
			return MaxonType.exitCode
		end 'exitCodeReturn'
		return MaxonType.named(self.artifact.typeNames.intern(returnTypeName))
	end 'interfaceReturnMaxonType'

	// The token shape of a method call on an ARRAY FIELD reached through a field chain — `<base>(.<field>)+
	// .<method>(` with AT LEAST TWO dots (a one-dot `b.m(…)` is `methodCallsAt`'s). `resolveFieldChainFrom`
	// stops the chain at the array field, so the last hop is the method. The base must be a live local (or a
	// captured enclosing struct), the same gate `methodCallsAt` uses.
	function fieldChainMethodCallAt(index TokenIndex) returns bool
		let chainEnd = self.fieldChainEndAfter(index, minHops: ChainMethodMinHops)
		if chainEnd == index or self.kindAt(chainEnd) != TokenKind.leftParen 'notChainMethod'
			return false
		end 'notChainMethod'
		let baseTok = self.tokenAt(index)
		return self.scope.contains(self.baseBindingName(baseTok)) or self.captureBinds(baseTok)
	end 'fieldChainMethodCallAt'

	// The token index just PAST a field-access chain starting at `index` — a `base` (an identifier or
	// `self`) followed by `.field` hops — or `index` itself when the tokens there are not such a chain
	// with at least `minHops` hops.
	//
	// THE ONE WALK over that shape, and it is shared because a divergence between its two askers is a
	// USE-AFTER-FREE rather than a compile error: `fieldChainMethodCallAt` decides that a WRITE goes
	// through a chain, and `sourceNamesABase` decides that a `for … in` LOCKS that chain's base against
	// exactly that write (`bindingIsIterationLocked`). Teach one a new chain shape and not the other and
	// the lock silently stops covering the door it was built to cover.
	function fieldChainEndAfter(index TokenIndex, minHops FieldHopCount) returns TokenIndex
		let baseKind = self.kindAt(index)
		if baseKind != TokenKind.identifier and baseKind != TokenKind.self 'notABase'
			return index
		end 'notABase'

		var q = index + 1
		var hops = 0
		while self.kindAt(q) == TokenKind.dot and self.kindAt(q + 1) == TokenKind.identifier 'hop'
			hops = hops + 1
			q = q + 2
		end 'hop'
		return q if hops >= minHops else index
	end 'fieldChainEndAfter'

	// Resolve a field chain to its final field and apply the trailing call, returning its result — an ARRAY
	// field's METHOD (`b.ops.push(1)`, a borrowed load; the struct owns and drops it) or a FUNCTION-typed field's
	// INDIRECT call (`o.inner.op()`, #97). Shared by the STATEMENT form (`resultUsed: false`) and the `try`-TARGET
	// form (`try self.nodes.get(i) otherwise …`, P1.7 slice 3), which leaves the throwing `call __arr_get` as the
	// last op for `rewriteLastCallToTryCall`.
	//
	// The dispatch is on the resolved receiver's TAG, exactly as expression position dispatches a postfix chain: an
	// array receiver takes an array method; a `function` receiver takes the trailing `(args)` through `parsePostfix`
	// (the #68/#78 indirect-call path). A `function` receiver reaches the `try`-target caller only through
	// `try o.inner.op() otherwise`, whose indirect call is non-throwing and is cleanly rejected by
	// `rewriteLastCallToTryCall` (`rejectTryTarget`), so both callers stay correct. Any other final field followed
	// by `(` is neither an array method nor callable and is refused.
	function parseFieldChainCall(func IrFunction, resultUsed bool) returns ValueId throws ParseError
		// The chain's BASE token, captured before the chain is resolved — it is the only thing that can
		// name the storage a write through this receiver reaches, and `for it in b.items` locks exactly it
		// (`iterationLockNameAt`).
		let baseIndex = self.pos
		let receiver = try self.parseFieldAccess()
		if self.tagOf(receiver) == ValueTypeTag.genericInstance and self.signatures.isArrayInstance(self.valueNameId(receiver)) 'arrayReceiver'
			// ONE derivation, read ONCE: `iterationLockNameAt` opened with exactly this question, so handing it
			// the answer keeps a chain from resolving its base through `Scope` twice per method call.
			let subjectName = self.borrowSubjectNameAt(baseIndex)
			return try self.parseArrayMethodOnValue(func, arr: receiver, giid: self.valueNameId(receiver), resultUsed: resultUsed, immutableReceiverName: self.iterationLockNameOf(subjectName), borrowSubjectName: subjectName)
		end 'arrayReceiver'
		// A `function`-typed field takes its trailing `(args)` and a TYPE-PARAMETER field takes its
		// `.method(…)`, and BOTH are hops `parsePostfix` already knows how to apply — a function value through
		// its indirect-call arm, an opaque `T` through its witness-dispatch arm. One arm for the two, because
		// the answer is the same one: hand the resolved receiver back to the postfix loop.
		if self.tagOf(receiver) == ValueTypeTag.function or self.tagOf(receiver) == ValueTypeTag.typeParameter 'postfixReceiver'
			return try self.parsePostfix(func, value: receiver, resultUsed: resultUsed)
		end 'postfixReceiver'
		let tok = self.current()
		throw ParseError.unsupported("a method call on a non-array field chain — a nested struct method (`o.inner.m()`) is a later slice", line: tok.line, column: tok.column)
	end 'parseFieldChainCall'

	// Dispatch a builtin `Array` method — cursor on the method NAME, `arr` the (borrowed) receiver record.
	// Shared by the binding receiver (`arr.push(x)`) and a value receiver (`[…].get(0)`). An OPAQUE-`T` array
	// (`self.items.push(x)` in a generic body, P1.7 slice 3b) dispatches here too, and the shared body treats the
	// opaque element as an 8-byte WORD — which is correct for MOVE-IN (`push`/`set`/`insert` move the word, and
	// the call-site consume promotes a managed argument, P1.7 slice 3b-iii), for the metadata methods, for drop,
	// for READING (`get`/`first`/`last` hand back a BORROW) and for MOVING OUT (`pop`/`remove` hand back an OWNED
	// word dropped through the descriptor-gated `__drop_type_param`, P1.7 slice 3b-vi-a) — the word is only
	// carried and dropped, never interpreted. A per-element COPY (`slice`/`clone`/`append`) is served too, through
	// the descriptor `copyFunc@32` (P1.7 slice 3b-vi-b-β): `__arr_*_opaque` byte-blits a trivial element and
	// deep-clones a direct-clonable managed one, so it never duplicates a managed pointer and double-frees it —
	// unless the instantiation's element is a managed type this rung cannot single-function-clone, which
	// `requireOpaqueArrayCopyable` rejects.
	function dispatchArrayMethod(func IrFunction, arr ValueId, giid GenericInstanceId, resultUsed bool, immutableReceiverName ByteArray, borrowSubjectName ByteArray, receiverOwner MutatedParamMask, receiverStorage MutatedParamMask) returns ValueId throws ParseError
		let methodTok = try self.consume(TokenKind.identifier)
		let range = SourceRange.ofToken(methodTok)

		// ⭐ **A `let`-BOUND ARRAY IS NOT WRITABLE** — checked HERE, once, ahead of every arm, because the
		// question is about the METHOD NAME and this is where the name is first known. It goes through
		// `noteReceiverWrite`, the ONE home this rule has for every container, and it is what makes
		// the top-level managed `let` a CONSTANT rather than a value that silently mutates a copy at each
		// read (`emitManagedConstant`).
		let mutatesReceiver = arrayMethodMutatesReceiver(methodTok.value)
		try self.noteReceiverWrite(func, immutableReceiverName: immutableReceiverName, receiverOwner: receiverOwner, receiverStorage: receiverStorage, methodTok: methodTok, mutatesReceiver: mutatesReceiver)

		// ⭐ E3070's container door — the SAME `mutatesReceiver` answer, read once, asked of the SAME receiver at
		// the same instant. The rule above refuses a write through an immutable binding; this one records the
		// write it permits, against the borrows still outstanding on that storage (`noteBorrowSubjectWrite`).
		self.noteBorrowSubjectWrite(func, subjectName: borrowSubjectName, display: methodTok.value, anchor: methodTok, mutatesSubject: mutatesReceiver)

		// Throwing accessors — a plain `call` the enclosing `try` rewrites; result is the element (get/first/
		// last/pop/remove) or a discarded dummy (set). `resultUsed` is the try's concern, not checked here.
		// ⭐ get/first/last yield a BORROW of the element (the array keeps ownership — the caller must not drop
		// it); pop/remove MOVE the element OUT (the runtime nulls its slot), so their result is OWNED (P1.7 slice 3).
		if methodTok.value.equals(ArrayGetMethod) 'get'
			let index = try self.parseArrayOneArg(func)
			return self.emitArrayElementAccessor(func, callee: ArrGetName, args: pairArgs(arr, second: index), giid: giid, owned: false, borrowSubjectName: borrowSubjectName, range: range)
		end 'get'
		if methodTok.value.equals(ArraySetMethod) 'set'
			return try self.parseArraySetOrInsert(func, arr: arr, giid: giid, callee: ArrSetName, throwing: true, range: range)
		end 'set'
		if methodTok.value.equals(ArrayFirstMethod) 'first'
			try self.parseArrayNoArgs()
			return self.emitArrayElementAccessor(func, callee: ArrFirstName, args: singletonArgs(arr), giid: giid, owned: false, borrowSubjectName: borrowSubjectName, range: range)
		end 'first'
		if methodTok.value.equals(ArrayLastMethod) 'last'
			try self.parseArrayNoArgs()
			return self.emitArrayElementAccessor(func, callee: ArrLastName, args: singletonArgs(arr), giid: giid, owned: false, borrowSubjectName: borrowSubjectName, range: range)
		end 'last'
		if methodTok.value.equals(ArrayPopMethod) 'pop'
			try self.parseArrayNoArgs()
			return self.emitArrayElementAccessor(func, callee: ArrPopName, args: singletonArgs(arr), giid: giid, owned: true, borrowSubjectName: borrowSubjectName, range: range)
		end 'pop'
		if methodTok.value.equals(ArrayRemoveMethod) 'remove'
			let index = try self.parseArrayOneArg(func)
			return self.emitArrayElementAccessor(func, callee: ArrRemoveName, args: pairArgs(arr, second: index), giid: giid, owned: true, borrowSubjectName: borrowSubjectName, range: range)
		end 'remove'
		if methodTok.value.equals(ArraySliceMethod) 'slice'
			try self.requireArrayCopyMethodSupported(giid, methodTok: methodTok)
			return try self.parseArraySlice(func, arr: arr, giid: giid, range: range)
		end 'slice'

		// Non-throwing value accessors.
		if methodTok.value.equals(ArrayCountMethod) 'count'
			try self.parseArrayNoArgs()
			return self.emitRuntimeCall(ArrCountName, args: singletonArgs(arr), resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: range)
		end 'count'
		if methodTok.value.equals(ArrayCapacityMethod) 'capacity'
			try self.parseArrayNoArgs()
			return self.emitRuntimeCall(ArrCapacityName, args: singletonArgs(arr), resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: range)
		end 'capacity'
		if methodTok.value.equals(ArrayIsEmptyMethod) 'isEmpty'
			try self.parseArrayNoArgs()
			return self.emitRuntimeCall(ArrIsEmptyName, args: singletonArgs(arr), resultTag: ValueTypeTag.boolean, resultNameId: UnnamedTypeId, range: range)
		end 'isEmpty'
		if methodTok.value.equals(ArrayCloneMethod) 'clone'
			try self.requireArrayCopyMethodSupported(giid, methodTok: methodTok)
			try self.parseArrayNoArgs()
			if self.signatures.arrayElementIsOpaque(giid) 'opaqueClone'
				return self.emitArrayInstanceAccessor(ArrCloneOpaqueName, args: singletonArgs(arr), giid: giid, range: range)
			end 'opaqueClone'
			if self.signatures.arrayElementIsManaged(giid) 'managedClone'
				return self.emitArrayInstanceAccessor(ArrCloneManagedName, args: pairArgs(arr, second: self.arrayElementCloneValue(giid, range: range)), giid: giid, range: range)
			end 'managedClone'
			return self.emitArrayInstanceAccessor(ArrCloneName, args: singletonArgs(arr), giid: giid, range: range)
		end 'clone'

		// Non-throwing void mutators — rejected in value position (E3059).
		try self.requireArrayVoidStatement(resultUsed, methodTok: methodTok)
		if methodTok.value.equals(ArrayPushMethod) 'push'
			let value = try self.parseArrayElementArg(func, giid: giid)
			return self.emitArrayVoidCall(ArrPushName, args: pairArgs(arr, second: value), receiver: arr, range: range)
		end 'push'
		if methodTok.value.equals(ArrayReserveMethod) 'reserve'
			let n = try self.parseArrayOneArg(func)
			return self.emitArrayVoidCall(ArrReserveName, args: pairArgs(arr, second: n), receiver: arr, range: range)
		end 'reserve'
		if methodTok.value.equals(ArrayResizeMethod) 'resize'
			try self.requireArrayResizeHasZeroElement(giid, methodTok: methodTok)
			let n = try self.parseArrayOneArg(func)
			return self.emitArrayVoidCall(ArrResizeName, args: pairArgs(arr, second: n), receiver: arr, range: range)
		end 'resize'
		if methodTok.value.equals(ArrayClearMethod) 'clear'
			try self.parseArrayNoArgs()
			return self.emitArrayVoidCall(ArrClearName, args: singletonArgs(arr), receiver: arr, range: range)
		end 'clear'
		if methodTok.value.equals(ArrayInsertMethod) 'insert'
			return try self.parseArraySetOrInsert(func, arr: arr, giid: giid, callee: ArrInsertName, throwing: false, range: range)
		end 'insert'
		if methodTok.value.equals(ArrayAppendMethod) 'append'
			try self.requireArrayCopyMethodSupported(giid, methodTok: methodTok)
			return try self.parseArrayAppend(func, arr: arr, giid: giid, range: range)
		end 'append'

		throw ParseError.unsupported("`Array` method '{String.from(methodTok.value)}' — P1.7 slice 1 provides create/push/get/set/count/capacity/isEmpty/reserve/resize/first/last/pop/clear/insert/remove and slice 4 adds slice/clone/append; the rest (map/contains/…) arrive later", line: methodTok.line, column: methodTok.column)
	end 'dispatchArrayMethod'

	// ⭐⭐ **REFUSE A RECEIVER-WRITING METHOD ON AN IMMUTABLE RECEIVER (E3019) — ONE RULE, ONE HOME, FOR
	// EVERY CONTAINER.** A read-only method on either kind of receiver, and any method on a writable
	// one, pass straight through.
	//
	// ⚠ **IT IS SHARED BY `String`, `Array` AND `Set` BECAUSE THE THREE HAD ALREADY DRIFTED APART.**
	// `parseStringAppend` asked `not binding.mutable`, `dispatchArrayMethod` asked `mutable or
	// isParameter`, and `dispatchSetMethod` asked NOTHING — three premises for one rule, and two of them
	// disagreed with the runnable oracle, MEASURED:
	//
	//   • `function grow(s String) … s.append("XY")` — the oracle ACCEPTS it (a parameter is a borrowed
	//     reference to the caller's record, exactly as for an array). The `mutable`-only premise made it
	//     a FALSE REJECTION, because a parameter is never `mutable`.
	//   • `let s = IntSet.create() … s.insert(1)` / `s.remove(1)` — the oracle REFUSES both with E3019.
	//     With no premise at all, shv2 accepted them.
	//
	// What stays per-container is only WHICH METHOD NAMES WRITE THE RECEIVER, which is a fact about that
	// container's method table and nothing else; the caller passes it as `mutatesReceiver`. What is
	// shared — the writability of the binding, and the diagnostic — lives here, so a fourth container
	// cannot invent a fourth answer to the same question.
	//
	// ⚠ **`immutableReceiverName` IS ONE `ByteArray`, NOT A UNION, AND THAT IS MEASURED.** The obvious
	// shape is `mutable | immutable(name)` — and it was written that way first — but this runs at every
	// container method call in the program, and Maxon heap-BOXES a union case, INCLUDING a payload-free
	// one. `scale-test` billed it at exactly one box per array-method call site
	// (+120/+240/+480/… across the doubling ladder). This is the same reading, and the same fix, that
	// `BuiltinConformer`'s header records for the per-method-call classifier one rung earlier. It is a
	// `ByteArray` rather than the `VarInfo` for a second reason the array path forces: a receiver that is
	// not a binding at all (`[10,20,30].get(0)`) has no `VarInfo` to hand over.
	//
	// **EMPTY IS NOT A SENTINEL, it is the literal truth**: a writable receiver has no immutable binding
	// for a diagnostic to blame — a `var`, a parameter and a temporary all have nothing to name. The
	// diagnostic REQUIRES a name, so "immutable" and "nameable" are the same state by construction.
	//
	// ⭐⭐ **IT ALSO RECORDS THE WRITE IT PERMITS, AND THE TWO HALVES ARE ONE DECISION.** A write through a
	// receiver that denotes a PARAMETER's record is a mutation of that parameter, which is exactly what the
	// call-site half of E3019 (`SemanticCheck.buildParamMutationSummary`) must know about the enclosing
	// function. Refusing the write and recording it are the same question asked of the same receiver at the
	// same instant — `mutatesReceiver` is the per-container authority's answer and is read ONCE — so they
	// are answered together rather than by two passes that would then have to agree for ever. A summary
	// built by re-reading the LOWERED callee names (`__arr_push`, `__str_append`, `__set_insert`) would be
	// precisely that second list, three tiers away from the one the parser already consults.
	//
	// ⭐⭐ **IT RECORDS TWO MASKS, BECAUSE ONE WRITE ANSWERS TWO QUESTIONS AND shv2 ANSWERS THEM
	// DIFFERENTLY** — see `IrFunction`'s table, which is where the pair is defined. `receiverOwner` is
	// E3019's ("does passing an immutable binding here make it an error?", NO for a self-field write, the
	// ruling `self-keyword.md:self-with-params` pins); `receiverStorage` is E3070's ("does this body write
	// what this parameter points at?", YES for the same write). Both are decided about the SAME receiver at
	// the SAME instant off the SAME `mutatesReceiver` answer, which is why they are recorded together rather
	// than by two passes that would then have to agree for ever.
	function noteReceiverWrite(func IrFunction, immutableReceiverName ByteArray, receiverOwner MutatedParamMask, receiverStorage MutatedParamMask, methodTok Token, mutatesReceiver bool) throws ParseError
		if not mutatesReceiver 'readOnlyMethod'
			return
		end 'readOnlyMethod'

		if not immutableReceiverName.isEmpty() 'immutableReceiver'
			throw ParseError.immutableMutatingCall(String.from(immutableReceiverName), functionName: String.from(func.name), line: methodTok.line, column: methodTok.column)
		end 'immutableReceiver'

		func.writtenParamMask = func.writtenParamMask or receiverOwner
		func.storageWrittenParamMask = func.storageWrittenParamMask or receiverStorage
	end 'noteReceiverWrite'

	// ⭐ **WHICH OF THE ENCLOSING FUNCTION'S PARAMETERS THIS RECEIVER'S RECORD BELONGS TO** — the bits
	// `noteReceiverWrite` sets when the write goes ahead, and 0 for a receiver that denotes storage no
	// parameter owns (a local, a temporary, a top-level global).
	//
	// ⚠ **THIS IS A QUESTION ABOUT THE VALUE, WHERE `VarInfo.isParameter` IS ONE ABOUT THE BINDING, AND THE
	// TWO MUST NOT BE UNIFIED.** `immutableReceiverNameOf` needs `isParameter` because `let a = p` is a
	// `let` even though it carries `p`'s ValueId (E3019, measured). Here the opposite is wanted: `var b = p`
	// followed by `b.push(9)` writes the CALLER's array, so the mutation belongs to `p`. The parameter
	// ValueId convention (`bindParameters` reserves 0..paramCount-1 and `mintValue` starts above it) is what
	// makes "this value IS parameter k" decidable, and it is the right test for THIS question only.
	//
	// ⭐⭐ **A SELF-FIELD ALIAS OWNS NOTHING HERE, AND THAT IS A RULING, NOT AN OMISSION.** A method writing
	// its own receiver's data does NOT make the CALLER's `let` an error in shv2:
	//
	//   *"A `let` on a struct binding refuses a REBIND (`acc = other`) and a direct field write through it
	//   (`acc.total = 1`, E2013); it does not reach inside the type's own methods."*
	//
	// — the rule `parseSelfFieldAssignment` already states, pinned by `specs-shv2/self-keyword.md`'s
	// `self-with-params`: `let acc = Accumulator.create(0)` then `acc.add(10)` expects **42**, and both
	// compilers deliver it.
	//
	// ⚠ **IT IS A MEASURED DIVERGENCE FROM THE ORACLE, AND THE ORACLE DISAGREES WITH ITSELF.** On the same
	// program with a `let` receiver, `self.total = self.total + value` is ACCEPTED (42) while
	// `total = total + value` is **E3019** — one write, two spellings, two verdicts, because its analysis
	// matches op TYPES and only the bare spelling emits the `MaxonAssignOp` its self-field check inspects.
	// shv2 has exactly ONE self-field store (`emitCheckedSelfFieldStore`, deliberately — see its header on
	// what v1's split cost), so it cannot reproduce that split and must choose one answer for both. It
	// chooses the one the corpus pins.
	//
	// The same ruling covers a CONTAINER held in a field (`items.push(v)` / `self.items.push(v)`, which the
	// oracle refuses through a `let` receiver): there is no principled line between writing `self.total` and
	// writing the array `self.items` points at, and drawing one at the spelling is the very inconsistency
	// above. What a `let`-bound struct still refuses is unchanged — a rebind, a direct field write through
	// it, and a receiver-writing method on it AS a container (E3019, the receiver half, which still refuses
	// a `let` FIELD: `push-on-let-self-field-array-error`).
	//
	// ⚠ The arm is EXPLICIT rather than left to the value test below, because a self-field alias's
	// `boundValue` is 0 — `createSelfField` leaves it so — and 0 is `self`'s own id, so the value test would
	// mark parameter 0 for the wrong reason, off the very coincidence `requireStructBase`'s header records
	// three measured miscompiles from.
	//
	// The value test itself is exact rather than approximate: `bindParameters` reserves ids
	// `0..paramCount-1` for the parameters and `mintValue` starts above them, so no body value can collide
	// with a parameter's id. ⭐ It is `paramMaskOfValue` and no longer inline: E3070's `receiverStorageMask`
	// asks the identical question of the identical value, and so does the self-field STORE door, so what had
	// exactly ONE asker now has three.
	function receiverOwnerMask(func IrFunction, binding VarInfo) returns MutatedParamMask
		if binding.isSelfField 'ownedByTheTypeNotTheCaller'
			return NoMutatedParams
		end 'ownedByTheTypeNotTheCaller'

		return paramMaskOfValue(func, value: binding.boundValue)
	end 'receiverOwnerMask'

	// ⭐⭐ **THE E3070 TWIN OF THE MASK ABOVE: WHICH PARAMETER'S STORAGE A WRITE THROUGH THIS RECEIVER
	// REACHES.** It differs from `receiverOwnerMask` in EXACTLY ONE ARM — a SELF-FIELD alias — and that one
	// arm is the whole point of there being two masks. See `IrFunction`'s table for the pair, and
	// `receiverOwnerMask` above for why E3019 must keep answering NO there.
	//
	// `items.clear()` inside a method of `Bag` writes storage the CALLER can reach, because the caller
	// handed `b` over as the receiver: `let s = try b.items.get(0) otherwise ""` then `b.wipe()` frees the
	// element `s` holds. MEASURED before this arm existed — the oracle prints 44 (it RETAINS), shv2 ran and
	// printed **4557430888798830399** out of freed memory, with no diagnostic anywhere.
	//
	// The receiver's parameter index is DERIVED (`self` resolved through the scope), not assumed to be 0:
	// the convention that binds it there lives in `bindParameters`, and restating it here would be a second
	// copy of it.
	function receiverStorageMask(func IrFunction, binding VarInfo) returns MutatedParamMask
		if binding.isSelfField 'fieldOfTheEnclosingReceiver'
			return paramMaskOfValue(func, value: try self.scope.lookupValue(SelfParamName) otherwise panic("receiverStorageMask: a self-field alias is in scope but `self` is not — `declareSelfFieldAliases` and `bindParameters` both run at method entry before a body token is read, and the two paths that could hold an alias without a receiver are refused earlier (a closure body gets a FRESH scope and a self-field access inside one is E2015; a `static function` installs no alias at all)"))
		end 'fieldOfTheEnclosingReceiver'

		// ⚠ **MODULE STORAGE REACHES NO PARAMETER, AND THE ARM IS EXPLICIT FOR `receiverOwnerMask`'s OWN
		// REASON.** A top-level `var` is addressed by `.data` label, never handed to this body — a callee
		// that writes it writes it BY NAME, which is a site recorded in the callee, not a fact about any
		// argument. The stand-in's `boundValue` is 0 and 0 is `self`'s parameter id, so falling through to
		// the value test would mark parameter 0's storage written off that coincidence and refuse every
		// call handing it on: a false rejection with no compile error. See `VarInfo.namesModuleStorage`.
		if binding.namesModuleStorage 'moduleStorageNotTheCallers'
			return NoMutatedParams
		end 'moduleStorageNotTheCallers'

		return paramMaskOfValue(func, value: binding.boundValue)
	end 'receiverStorageMask'

	// The shared arm of the two masks above: the parameter `value` IS, as a mask, or none when it is not a
	// parameter at all. The parameter-ValueId convention (`bindParameters` reserves 0..paramCount-1) is what
	// makes the test a comparison rather than a lookup — see `receiverOwnerMask`'s ⚠ block for why this is
	// a question about the VALUE and `VarInfo.isParameter` is a different one about the BINDING.
	function paramMaskOfValue(func IrFunction, value ValueId) returns MutatedParamMask
		if value >= func.paramCount 'notAParameter'
			return NoMutatedParams
		end 'notAParameter'

		return withMutatedParam(NoMutatedParams, param: value)
	end 'paramMaskOfValue'

	// ⭐ **THE E3070 STORAGE MASK FOR A WRITE NAMED BY ITS SUBJECT** — the same answer `receiverStorageMask`
	// gives, reached through the ONE subject derivation (`borrowSubjectNameAt`) that every E3070 door and the
	// P1.8 iteration lock already share. It is what lets an array method reached through a FIELD CHAIN
	// (`bag.items.clear()` inside `function wipe(bag Bag)`) record the write against `bag`, which the
	// receiver-value path has no binding to find.
	function subjectStorageMask(func IrFunction, subjectName ByteArray) returns MutatedParamMask
		if subjectName.isEmpty() 'noNamedStorage'
			return NoMutatedParams
		end 'noNamedStorage'

		return self.receiverStorageMask(func, binding: self.borrowSubjectBindingOf(subjectName))
	end 'subjectStorageMask'

	// Is this DECLARED type an `Array` instance? Asked by the self-field store door, which holds a
	// `MaxonType` rather than a value.
	//
	// ⚠ **THE TAG TEST IS NOT OPTIONAL, AND LEAVING IT OUT IS A WRONG ANSWER RATHER THAN A LOOSE ONE.**
	// `TypeNameId` and `GenericInstanceId` share a numeric space, so `isArrayInstance` asked of a name that
	// is not an instance at all can answer TRUE by coincidence — MEASURED: without it an `Integer` field's
	// store marked the whole receiver written, and `b.add(42)` was refused while `b.items` was borrowed, a
	// program the oracle compiles and runs (it prints `44 42`). It is the same two-part test
	// `parseFieldChainCall` makes of a receiver's VALUE, asked here of a type.
	function typeIsArrayInstance(t MaxonType) returns bool
		return maxonTypeTag(t) == ValueTypeTag.genericInstance and self.signatures.isArrayInstance(typeNameIdOf(t))
	end 'typeIsArrayInstance'

	// ⭐ **THE DENSE-GROWTH GATE for `resize` (E3106).** `__arr_resize` lengthens by publishing a longer
	// `length@8` over slots `__arr_grow` left ZEROED, and a zero is an ELEMENT only while the element lives
	// INLINE in the buffer. A MANAGED element lives there as an 8-byte POINTER (`ManagedArrayElementBytes`),
	// so a zeroed slot is NULL — an absence, not a value — and Maxon has no default constructor to make one.
	// The array that comes back answers `count()` = N while `get(0)` takes the empty-slot branch of
	// `emitLoadElemAndOkReturn`: a `count()` that does not agree with `get()`, which is a silent wrong answer
	// rather than a missing feature. `push(value)` is the growth that supplies the element.
	//
	// An OPAQUE-`T` element is NOT gated, and that is the rule's scope rather than a gap in it: one shared
	// generic body serves every instantiation, so there is no element type to name and no single answer to
	// give — and a deliberately SPARSE slot table (a hash map's key column, which tracks occupancy in a
	// parallel state column and never reads a slot it did not write) is built through exactly that path.
	// `arrayElementIsManaged` already answers false for a type parameter, so the carve-out needs no second
	// test written here.
	//
	// ⚠⚠ **A SECOND THING NOW DEPENDS ON THIS REFUSAL, IN ANOTHER FILE (P1.8 slice A).**
	// `__arr_get_unchecked` — the element read a `for x in arr` loop makes — DROPPED the empty-slot arm
	// `__arr_get` carries, and is safe only because no index in `[0, count)` can hold a NULL managed slot.
	// That is true precisely because this rule refuses the one operation that would create one. If this
	// refusal is ever relaxed, that read becomes a null deref in a function whose own text still looks
	// correct: `ArrayRuntime.maxon`'s `ArrGetUncheckedName` header states the obligation from its end,
	// and this note is the pointer back, so neither side can be changed without meeting the other.
	function requireArrayResizeHasZeroElement(giid GenericInstanceId, methodTok Token) throws ParseError
		if not self.signatures.arrayElementIsManaged(giid) 'trivial'
			return
		end 'trivial'
		throw ParseError.arrayResizeManagedElement(self.signatures.arrayElementDisplayName(giid), line: methodTok.line, column: methodTok.column)
	end 'requireArrayResizeHasZeroElement'

	// ⭐ **THE COPY GATE for `slice`/`clone`/`append`, routed by element KIND (P1.7 slice 3b-vi-b).** An OPAQUE-`T`
	// element (a generic body's shared `Array with <type parameter>`) copies through the descriptor's `copyFunc@32`
	// (`requireOpaqueArrayCopyable`); a CONCRETE element copies through its statically-known cloner
	// (`requireArrayElementCopyable`). One home so the three copy methods pick the right gate identically.
	function requireArrayCopyMethodSupported(giid GenericInstanceId, methodTok Token) throws ParseError
		if self.signatures.arrayElementIsOpaque(giid) 'opaque'
			try self.requireOpaqueArrayCopyable(giid, methodTok: methodTok)
			return
		end 'opaque'
		try self.requireArrayElementCopyable(giid, methodTok: methodTok)
	end 'requireArrayCopyMethodSupported'

	// ⭐ **THE COPY GATE for an OPAQUE-`T` array (P1.7 slice 3b-vi-b-β).** An opaque `Array with <type parameter>`
	// inside a generic body copies each element through the enclosing instance's descriptor `copyFunc@32`, which
	// can hold only a SINGLE `(box) -> newBox` cloner — so a String / struct / boxed-union / trivial-element-array
	// / trivial-scalar instantiation is served (`__arr_*_opaque` branches on `copyFunc@32`: a byte-blit for a
	// trivial element, a deep clone for a direct-clonable managed one). It REJECTS (E2015) only when SOME
	// instantiation of the enclosing generic type substitutes a managed type this rung cannot deep-clone as a
	// single-function element — a managed-element array (`Array with (Array with String)`) or a non-Array generic
	// instance (`Box with String`, a later slice) — because that element has no single `copyFunc` and its copy
	// would byte-blit a managed pointer and double-free it. The reject is per-INSTANTIATION (the shared body's
	// element is opaque), so it enumerates the enclosing type's instances through
	// `genericTypeFieldHasUncopyableInstantiation`, mirroring the concrete gate's `arrayElementSupportsDeepClone`.
	function requireOpaqueArrayCopyable(giid GenericInstanceId, methodTok Token) throws ParseError
		let elementPosition = typeNameIdOf(self.signatures.arrayElementType(giid))
		if self.signatures.genericTypeFieldHasUncopyableInstantiation(self.enclosingType, position: elementPosition) 'uncopyable'
			throw ParseError.unsupported("`{String.from(methodTok.value)}` COPIES each element of an `Array with <type parameter>` field, but this generic type is instantiated with a type whose managed element cannot be deep-cloned as a single-function element — a managed-element array (`Array with (Array with String)`) or a non-Array generic instance (`Box with String`, whose per-instance cloner is a later slice). String / struct / boxed-union / trivial-element-array / trivial instantiations ARE supported (P1.7 slice 3b-vi-b).", line: methodTok.line, column: methodTok.column)
		end 'uncopyable'
	end 'requireOpaqueArrayCopyable'

	// Emit a VOID array mutator call; return the receiver (what the statement still denotes, like
	// `parseStringAppend`).
	function emitArrayVoidCall(callee ByteArray, args ValueIdArray, receiver ValueId, range SourceRange) returns ValueId
		_ = self.emitRuntimeCall(callee, args: args, resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
		return receiver
	end 'emitArrayVoidCall'

	// ⭐ **EMIT A MANAGED-AWARE ELEMENT ACCESSOR** (`get`/`first`/`last`/`pop`/`remove`, P1.7 slice 3 / 3b-vi-a).
	// The result carries the element's VALUE type: for a CONCRETE managed element its usable form — a struct →
	// `structRef` so `first.name` resolves, a boxed union → `named` so `match first` dispatches, a String → text,
	// an instance → `genericInstance`; for an OPAQUE element the element's own `typeParameter(pos)` (the shared
	// body has no concrete type, so the tag stays opaque and its drop is descriptor-gated — slice 3b-vi-a); or
	// `integer` for a TRIVIAL concrete element (slice 1, unchanged). Ownership:
	//   • get/first/last yield a BORROW (`owned: false`): the array keeps the element, so the result is NOT
	//     tracked owned and is dropped by nothing here — the array's `__arr_decref` walk destroys it. A borrow
	//     merged with an OWNED `otherwise` fallback is reconciled by `finishValueTry` (the fallback drops on the
	//     error edge; see there).
	//   • pop/remove MOVE the element OUT (`owned: true`): the runtime NULLS the slot it hands back (so the
	//     array walk skips it), so the caller becomes the sole owner and the result is tracked owned — dropped by
	//     the concrete destructor (concrete element) or the descriptor-gated `__drop_type_param` (opaque element,
	//     inert for a trivial instantiation). The enclosing method reserves the descriptor for the opaque drop —
	//     `computeTypeDescriptorNeeds` seeds it off any `.pop()`/`.remove()` move-out in the shared body.
	//
	// ⭐⭐ **AND IT IS WHERE AN E3070 BORROW IS MINTED (`BorrowCheck`), off the `owned` flag that already
	// answers the question.** `owned` IS *"does the caller take the element OUT, or look at it in place?"*, so
	// `pop`/`remove` are excluded STRUCTURALLY rather than by a second hand-maintained method list — v1 keeps
	// one (`MaxonBorrowCheck.maxon:42-44`) and shv2 deliberately does not port it, because
	// `arrayMethodMutatesReceiver` is already the ONE such list and answers a different question.
	//
	// `borrowSubjectName` is the storage the element came out of, EMPTY when the receiver is anonymous (an
	// array literal, a call result — nothing else can name that record, so no later statement can free it).
	//
	// ⭐ **THE `for … in` ELEMENT ENROLS TOO, and that is a USER RULING** (`parseForStatement` passes
	// `borrowSubjectNameAt(sourceStart)` here). P1.8 Slice A's lock refuses every write that NAMES the
	// iterated array; it structurally cannot refuse one that hands the array to a CALLEE
	// (`wipe(b.items)`), and shv2 read the free-poison byte 0x3F on exactly that program. The oracle
	// ACCEPTS it — it retains the element — so this refuses a program the oracle compiles, deliberately and
	// in the only direction that is sound for a compiler that does not retain. See
	// `bindingIsIterationLocked`'s ⚠⚠ block, which is what this closes, and `attachPendingBorrows`'s
	// `liveUntil` for why the loop element's borrow is LEXICAL rather than last-use.
	//
	// ⚠ **AN OPAQUE `T` ELEMENT MINTS NO BORROW**, deliberately: a shared generic body is compiled ONCE, so it
	// cannot know whether the instantiation's element owns heap, and a trivial one (`Array with Integer`) hands
	// back a raw word that no mutation can dangle. Refusing there would reject a program the oracle — which
	// monomorphizes — accepts. The managed instantiation's hazard is real and unclosed; it is the same
	// descriptor-gated question `finishValueTry`'s opaque try-merge already defers.
	function emitArrayElementAccessor(func IrFunction, callee ByteArray, args ValueIdArray, giid GenericInstanceId, owned bool, borrowSubjectName ByteArray, range SourceRange) returns ValueId
		// A TRIVIAL CONCRETE element (int / Byte / ranged-int / bool) is a bare inline word that owns nothing: the
		// result is `integer` and is NEVER tracked owned, read or moved out (a decref of an integer would corrupt
		// the count). An OPAQUE element is NOT trivial here — `typeIsManaged` is false for a `typeParameter`, but a
		// managed instantiation's element DOES own heap — so it falls through to the opaque-aware path below.
		if not self.signatures.arrayElementIsManaged(giid) and not self.signatures.arrayElementIsOpaque(giid) 'trivial'
			return self.emitRuntimeCall(callee, args: args, resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: range)
		end 'trivial'

		let resultType = self.elementAccessorResultType(giid)
		let result = self.emitRuntimeCall(callee, args: args, resultTag: maxonTypeTag(resultType), resultNameId: typeNameIdOf(resultType), range: range)
		if owned 'moveOut'
			self.trackOwnedTemp(result)
		end 'moveOut' else 'borrowsInPlace'
			if not borrowSubjectName.isEmpty() and self.signatures.arrayElementIsManaged(giid) 'borrowsANamedSourcesElement'
				self.mintPendingBorrow(func, subjectName: borrowSubjectName, borrowValue: result, range: range)
			end 'borrowsANamedSourcesElement'
		end 'borrowsInPlace'
		return result
	end 'emitArrayElementAccessor'

	// The VALUE type an element accessor's result carries — the opaque element's own `typeParameter(pos)` for an
	// OPAQUE array (the shared body keeps the element opaque; its drop is descriptor-gated, `decrefCalleeFor`'s
	// `typeParameter` arm → `__drop_type_param`), else the CONCRETE managed element's usable value form
	// (`arrayElementValueType`). Split so `emitArrayElementAccessor` reads ONE type either way; the opaque
	// `typeParameter` carries a POSITION, not an interned name, so it needs no interner adoption.
	function elementAccessorResultType(giid GenericInstanceId) returns MaxonType
		if self.signatures.arrayElementIsOpaque(giid) 'opaque'
			return self.signatures.arrayElementType(giid)
		end 'opaque'
		return self.arrayElementValueType(giid)
	end 'elementAccessorResultType'

	// ⭐ **EMIT A WHOLE-ARRAY ACCESSOR that yields a NEW OWNED array** (`slice`/`clone`, P1.7 slice 4). Unlike an
	// element accessor, the result is a fresh `Array` instance (`__mm_alloc`'d record + buffer), so it is typed
	// `genericInstance` at the SAME `giid` as the receiver — `sub.get(0)`/`sub.count()` dispatch on it — and
	// enrolled as an OWNED temp exactly like an array literal (`[10,20,30]`): the caller owns it and its scope-exit
	// drop routes through `genericInstanceBoxDropCallee` → `__arr_decref`, which frees the fresh record + buffer.
	// Shared by `slice` (throwing — the enclosing `try` rewrites this last `call` to a `tryCall`, and `finishValueTry`
	// reconciles the OWNED result with the OWNED `otherwise` fallback: both drop once, on their own edge) and `clone`
	// (non-throwing — the owned temp is bound by `parseBinding` or dropped at statement end).
	function emitArrayInstanceAccessor(callee ByteArray, args ValueIdArray, giid GenericInstanceId, range SourceRange) returns ValueId
		let result = self.emitRuntimeCall(callee, args: args, resultTag: ValueTypeTag.genericInstance, resultNameId: giid, range: range)
		self.trackOwnedTemp(result)
		return result
	end 'emitArrayInstanceAccessor'

	// `slice(start, endIndex: end)` — the index positional, the end labelled `endIndex:` (mirroring `set`'s
	// `value:`). Emits the throwing `__arr_slice(arr, start, end)` as the LAST op so the enclosing `try` rewrites
	// it; returns the fresh owned array. Neither argument is a managed move-in (both are plain indices).
	function parseArraySlice(func IrFunction, arr ValueId, giid GenericInstanceId, range SourceRange) returns ValueId throws ParseError
		try self.consume(TokenKind.leftParen)
		let start = try self.parseExpression(func, block: self.currentBlock)
		try self.consumeArrayArgLabel(ArrayEndIndexLabel)
		let endIndex = try self.parseExpression(func, block: self.currentBlock)
		try self.consume(TokenKind.rightParen)
		if self.signatures.arrayElementIsOpaque(giid) 'opaqueSlice'
			return self.emitArrayInstanceAccessor(ArrSliceOpaqueName, args: tripleArgs(arr, second: start, third: endIndex), giid: giid, range: range)
		end 'opaqueSlice'
		if self.signatures.arrayElementIsManaged(giid) 'managedSlice'
			return self.emitArrayInstanceAccessor(ArrSliceManagedName, args: quadArgs(arr, second: start, third: endIndex, fourth: self.arrayElementCloneValue(giid, range: range)), giid: giid, range: range)
		end 'managedSlice'
		return self.emitArrayInstanceAccessor(ArrSliceName, args: tripleArgs(arr, second: start, third: endIndex), giid: giid, range: range)
	end 'parseArraySlice'

	// `append(other)` — append `other`'s elements to `self`. `other` is BORROWED (read-only, not moved) and
	// PRESERVED (`append-preserves-originals`). Its element type must match the receiver's, which
	// `requireArrayAppendArg` enforces. A TRIVIAL receiver block-copies `other`'s bytes (`__arr_append`); a
	// CONCRETE MANAGED receiver (P1.7 slice 3b-vi-b) DEEP-CLONES each `other` element into `self` via
	// `__arr_append_managed`, stamped with the element's `funcAddr(__clone_<E>)`, so both arrays end up sole
	// owners of independent elements. Returns the receiver (what the statement still denotes).
	function parseArrayAppend(func IrFunction, arr ValueId, giid GenericInstanceId, range SourceRange) returns ValueId throws ParseError
		try self.consume(TokenKind.leftParen)
		let otherTok = self.current()
		let other = try self.parseExpression(func, block: self.currentBlock)
		try self.requireArrayAppendArg(other, giid: giid, otherTok: otherTok)
		try self.consume(TokenKind.rightParen)
		if self.signatures.arrayElementIsOpaque(giid) 'opaqueAppend'
			return self.emitArrayVoidCall(ArrAppendOpaqueName, args: pairArgs(arr, second: other), receiver: arr, range: range)
		end 'opaqueAppend'
		if self.signatures.arrayElementIsManaged(giid) 'managedAppend'
			return self.emitArrayVoidCall(ArrAppendManagedName, args: tripleArgs(arr, second: other, third: self.arrayElementCloneValue(giid, range: range)), receiver: arr, range: range)
		end 'managedAppend'
		return self.emitArrayVoidCall(ArrAppendName, args: pairArgs(arr, second: other), receiver: arr, range: range)
	end 'parseArrayAppend'

	// The argument to `append` must be an `Array` instance of the SAME element type as the receiver. A TRIVIAL
	// receiver copies raw bytes sized by its `element_size`, so same-managedness + same element size is the honest
	// "same array shape" (`[1,2,3]` and an `Array with Integer` binding share it even when their giids differ by
	// how the element interned). A MANAGED receiver deep-clones each element through the RECEIVER's own element
	// cloner, which only fits `other`'s elements when `other` IS the same array instance — so a managed receiver
	// requires `other` to be the identical giid (strict, since the element cloner is receiver-specific).
	function requireArrayAppendArg(other ValueId, giid GenericInstanceId, otherTok Token) throws ParseError
		if self.tagOf(other) != ValueTypeTag.genericInstance or not self.signatures.isArrayInstance(self.valueNameId(other)) 'notArray'
			throw ParseError.unsupported("`append` takes another `Array` of the same element type — got '{typeTagName(self.tagOf(other))}'", line: otherTok.line, column: otherTok.column)
		end 'notArray'
		let otherGiid = self.valueNameId(other)
		// An OPAQUE receiver (`self.items.append(other)` in a generic body) deep-clones `other`'s elements through
		// the RECEIVER's descriptor `copyFunc@32` (P1.7 slice 3b-vi-b-β), which is correct only when `other` shares
		// the receiver's opaque element type — so, like the managed receiver, `other` must be the IDENTICAL giid.
		if self.signatures.arrayElementIsOpaque(giid) 'opaqueReceiver'
			if not self.signatures.arrayElementIsOpaque(otherGiid) or otherGiid != giid 'opaqueMismatch'
				throw ParseError.unsupported("`append` on an opaque `Array with <type parameter>` field requires an `Array` of the same type-parameter element as the receiver", line: otherTok.line, column: otherTok.column)
			end 'opaqueMismatch'
			return
		end 'opaqueReceiver'
		if self.signatures.arrayElementIsManaged(giid) 'managedReceiver'
			if not self.signatures.arrayElementIsManaged(otherGiid) or otherGiid != giid 'managedMismatch'
				throw ParseError.unsupported("`append` requires an `Array` with the same MANAGED element type as the receiver", line: otherTok.line, column: otherTok.column)
			end 'managedMismatch'
			return
		end 'managedReceiver'
		if self.signatures.arrayElementIsManaged(otherGiid) or self.signatures.arrayElementSize(otherGiid) != self.signatures.arrayElementSize(giid) 'mismatch'
			throw ParseError.unsupported("`append` requires an `Array` with the same element type as the receiver", line: otherTok.line, column: otherTok.column)
		end 'mismatch'
	end 'requireArrayAppendArg'

	// ⭐ **THE COPY GATE for `slice`/`clone`/`append` on a CONCRETE-element array (P1.7 slice 3b-vi-b).** A
	// TRIVIAL element passes (its copy is a correct byte blit / COW view). A CONCRETE MANAGED element (String /
	// struct / boxed union) now passes too — its copy is a per-element DEEP CLONE (`arrayElementCloneValue` stamps
	// the element's `funcAddr(__clone_<E>)` into the `_managed` runtime call), shv2's move-only answer to the
	// reference compilers' incref. What still REJECTS (E2015) is a managed element whose nested type this rung's
	// cloner cannot reach: a `Box with T` generic-instance field/element (a per-instance cloner is a later slice)
	// or an array-of-managed-arrays. An OPAQUE-`T` element (a generic body) is routed to `requireOpaqueArrayCopyable`
	// by `requireArrayCopyMethodSupported` instead, so only CONCRETE elements reach here.
	function requireArrayElementCopyable(giid GenericInstanceId, methodTok Token) throws ParseError
		if not self.signatures.arrayElementIsManaged(giid) 'trivial'
			return
		end 'trivial'
		if not self.signatures.arrayElementSupportsDeepClone(giid) 'unsupportedNested'
			throw ParseError.unsupported("`{String.from(methodTok.value)}` on an array whose managed element has a nested type this rung cannot deep-clone yet — a `Box with T` generic-instance field/element (its per-instance cloner is a later slice) or an array-of-managed-arrays. String / struct / boxed-union elements, including nested String, struct, union and Array fields, ARE supported.", line: methodTok.line, column: methodTok.column)
		end 'unsupportedNested'
	end 'requireArrayElementCopyable'

	// ⭐ **THE ELEMENT-CLONER `funcAddr` STAMP (P1.7 slice 3b-vi-b)** — the DUAL of `arrayElementDestroyValue`. A
	// CONCRETE managed element knows its `(box) -> newBox` clone callee at this site (`__str_clone` / `__clone_<T>`
	// / `__arr_clone` for a trivial-element nested array), so the address rides the P1.5-A1 `funcAddr` code→register
	// path — the `_managed` runtime helper `callIndirect`s it per element. `requireArrayElementCopyable` has already
	// guaranteed the strategy is `direct` (an element cloner must satisfy `callIndirect(fn, elem)`); a `managedArray`/
	// `unsupported` strategy at the TOP element is a gate drift, not a valid program.
	function arrayElementCloneValue(giid GenericInstanceId, range SourceRange) returns ValueId
		match self.signatures.arrayElementCloneStrategy(giid) 'strategy'
			direct(callee) then return self.emitRuntimeFuncAddr(callee, range: range)
			managedArray then panic("arrayElementCloneValue: a top-level managed array element resolved to `managedArray` — requireArrayElementCopyable gates this to a `direct` element cloner")
			unsupported then panic("arrayElementCloneValue: a top-level managed array element resolved to `unsupported` — requireArrayElementCopyable rejects it at the front end")
		end 'strategy'
	end 'arrayElementCloneValue'

	// The VALUE type a managed element is loaded as — the element's declared type retyped to its usable value
	// form (a struct → `structRef`, a boxed union → its `named(<union>)`, a String → text, a nested Array /
	// instance → `genericInstance` so `retrieved.count()` dispatches). A NESTED ARRAY element arrives as a
	// `named` generic alias (`ByteArray` = `Array with Byte`) — the sweep recorded the layout before the alias
	// interned — so it is resolved to its `genericInstance` here (the same alias→instance step
	// `managedFieldDropCallee` takes for the drop). Every other element routes through the SAME
	// `classifyUnionPayload`/`payloadValueTypeOf` the union-payload and struct-field reads use. The element id
	// lives in signatures' interner, so it is adopted into this file's interner first (a ranged alias that
	// shifted the interning order would otherwise misresolve — OPEN #52).
	function arrayElementValueType(giid GenericInstanceId) returns MaxonType
		let declared = self.signatures.adoptType(self.signatures.arrayElementType(giid), into: self.artifact.typeNames)
		let tag = maxonTypeTag(declared)
		if tag == ValueTypeTag.genericInstance 'instance'
			return declared
		end 'instance'
		if tag == ValueTypeTag.named 'named'
			let name = try self.artifact.typeNames.nameOf(typeNameIdOf(declared)) otherwise panic("arrayElementValueType: an adopted `named` element type's id is not in this file's interner")
			if self.signatures.isGenericAlias(name) 'genericAlias'
				return MaxonType.genericInstance(self.signatures.genericAliasInstance(name))
			end 'genericAlias'
		end 'named'
		return payloadValueTypeOf(classifyUnionPayload(self.signatures, typeNames: self.artifact.typeNames, fieldType: declared), declared: declared)
	end 'arrayElementValueType'

	// `(` `)` — a no-argument array method (`count`, `first`, `pop`, `clear`, …).
	function parseArrayNoArgs() throws ParseError
		try self.consume(TokenKind.leftParen)
		try self.consume(TokenKind.rightParen)
	end 'parseArrayNoArgs'

	// `( expr )` — a single positional array-method argument (`push(x)`, `get(i)`, `reserve(n)`).
	function parseArrayOneArg(func IrFunction) returns ValueId throws ParseError
		try self.consume(TokenKind.leftParen)
		let arg = try self.parseExpression(func, block: self.currentBlock)
		try self.consume(TokenKind.rightParen)
		return arg
	end 'parseArrayOneArg'

	// The ` , <label> : ` separating a two-argument array method's positional first argument from its LABELLED
	// second — `set`/`insert`'s `value:`, `slice`'s `endIndex:`. ONE home for that shape, so a two-arg array
	// method names its label and inherits the same "must be labelled `<label>:`" diagnostic; the cursor is left
	// on the token that begins the second argument's value.
	function consumeArrayArgLabel(label ByteArray) throws ParseError
		try self.consume(TokenKind.comma)
		let labelTok = try self.consume(TokenKind.identifier)
		if not labelTok.value.equals(label) 'wrongLabel'
			throw ParseError.unsupported("the second argument of a two-argument array method must be labelled `{String.from(label)}:` (got '{String.from(labelTok.value)}:')", line: labelTok.line, column: labelTok.column)
		end 'wrongLabel'
		try self.consume(TokenKind.colon)
	end 'consumeArrayArgLabel'

	// `set`/`insert` — `( index , value: X )`: the index positional, the value labelled `value:`. Emits the
	// `__arr_set`/`__arr_insert` call (throwing for `set`, void for `insert`) and returns its result. The
	// value argument is parsed AFTER the index so the throwing `set`'s call is the last op the enclosing
	// `try` rewrites.
	function parseArraySetOrInsert(func IrFunction, arr ValueId, giid GenericInstanceId, callee ByteArray, throwing bool, range SourceRange) returns ValueId throws ParseError
		try self.consume(TokenKind.leftParen)
		let index = try self.parseExpression(func, block: self.currentBlock)
		try self.consumeArrayArgLabel(ArrayValueLabel)
		// The value is a managed-element MOVE-IN (`set`/`insert`), so it is consumed exactly as `push` is —
		// `moveElementIntoArray` promotes a borrowed String, transfers an owned value, refuses a borrowed
		// aggregate. `__arr_set` destroys the LIVE occupant it overwrites (its element_destroy walk of one
		// slot), so no leak; `__arr_insert` shifts the tail (a relocation) and stores into the vacated slot.
		let valueStart = self.pos
		let raw = try self.parseExpression(func, block: self.currentBlock)
		let value = try self.moveElementIntoArray(raw, giid: giid, valueStart: valueStart)
		try self.consume(TokenKind.rightParen)

		if throwing 'throwing'
			return self.emitRuntimeCall(callee, args: tripleArgs(arr, second: index, third: value), resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: range)
		end 'throwing'
		return self.emitArrayVoidCall(callee, args: tripleArgs(arr, second: index, third: value), receiver: arr, range: range)
	end 'parseArraySetOrInsert'

	// `( expr )` — a single element-VALUE argument (`push(x)`), parsed then MOVED into the array (P1.7 slice 3):
	// a managed element is consumed so the array owns it (its decref walk destroys it), a trivial element passes
	// through. The value's start position is captured so a bare-local source can be poisoned (E3102).
	function parseArrayElementArg(func IrFunction, giid GenericInstanceId) returns ValueId throws ParseError
		try self.consume(TokenKind.leftParen)
		let valueStart = self.pos
		let value = try self.parseExpression(func, block: self.currentBlock)
		// The move-in MUST run before the `)` is consumed: `rhsWasBareLocalReference` reads `[valueStart, self.pos)`
		// to decide whether the arg is a bare local to POISON, and a consumed `)` would widen that window past a
		// single-identifier arg (`push(node)`) — the poison would silently not fire and the moved binding would
		// drop a second time at scope exit (a double-free / over-release, exit 101).
		let moved = try self.moveElementIntoArray(value, giid: giid, valueStart: valueStart)
		try self.consume(TokenKind.rightParen)
		return moved
	end 'parseArrayElementArg'

	// ⭐ **MOVE A PARSED ELEMENT INTO A MANAGED-ELEMENT ARRAY (P1.7 slice 3).** The array becomes the element's
	// sole owner (its `__arr_decref` walk destroys it), so the source is consumed exactly as a struct-field /
	// union-payload move-in (`moveManagedValueInto`): a borrowed String literal is promoted to an owned copy,
	// an owned value is transferred (bare local poisoned / temp de-listed), a borrowed struct/union is refused
	// (no clone). A TRIVIAL-element array's value owns no heap and passes through unchanged. Shared by
	// push/set/insert. `valueStart` locates the value's first token — its bare-local source and the diagnostic
	// anchor both.
	function moveElementIntoArray(value ValueId, giid GenericInstanceId, valueStart TokenIndex) returns ValueId throws ParseError
		// ⭐ **AN OPAQUE-`T` ARRAY MOVE-IN IN THE SHARED BODY (P1.7 slice 3b-v).** The shared generic body has no
		// static type for the element (`arrayElementIsManaged` is false — the element is a `typeParameter` word),
		// so it neither promotes nor refuses here. But when the pushed value is an enrolled opaque owned binding
		// (a consumed feed parameter, `bindParameters`), the array becomes its owner: MOVE it (poison the source
		// binding) so a second use is E3102 and this frame does not also drop it. A borrowed opaque word or a
		// non-bare-local expression owns nothing and passes through. The CONCRETE call site's own consume
		// (3b-iii/3b-iv) is untouched — it runs in the caller's frame on the concrete argument.
		if self.signatures.arrayElementIsOpaque(giid) 'opaque'
			try self.moveOpaqueFeedArg(value, valueStart: valueStart)
			return value
		end 'opaque'
		if not self.signatures.arrayElementIsManaged(giid) 'trivial'
			return value
		end 'trivial'
		let anchor = self.tokenAt(valueStart)
		let isString = tagIsText(maxonTypeTag(self.signatures.arrayElementType(giid)))
		return try self.moveManagedValueInto(value, argBareLocal: self.rhsWasBareLocalReference(valueStart), isString: isString, anchor: anchor, range: SourceRange.ofToken(anchor))
	end 'moveElementIntoArray'

	// ⭐ **MOVE AN OPAQUE OWNED FEED VALUE OUT OF ITS BINDING (P1.7 slice 3b-v).** When the fed value (a
	// `self.items.push(item)` element, or a `self.N(item)` forward argument) is a bare reference to a LIVE owned
	// opaque type-parameter binding, poison it so its new owner (the array, or the consuming sibling) is its
	// sole owner and this frame does not drop it too. A no-op on a borrowed opaque word, a non-bare-local
	// expression, or any non-opaque value: `poisonMoveSource` is value-keyed and matches only a live owned
	// binding, and the bare-local gate keeps it off the hot path (the same gate `moveManagedValueInto` uses).
	function moveOpaqueFeedArg(value ValueId, valueStart TokenIndex) throws ParseError
		if self.rhsWasBareLocalReference(valueStart) 'bareLocal'
			try self.poisonMoveSource(value, anchor: self.tokenAt(valueStart))
		end 'bareLocal'
	end 'moveOpaqueFeedArg'

	// A non-throwing void array mutator (`push`/`reserve`/`resize`/`clear`/`insert`) has no value, so a
	// value-position call is E3059, exactly as a void free call or `String.append` in value position is.
	function requireArrayVoidStatement(resultUsed bool, methodTok Token) throws ParseError
		if resultUsed 'valueUsed'
			throw ParseError.voidCallResultUsed(String.from(methodTok.value), line: methodTok.line, column: methodTok.column)
		end 'valueUsed'
	end 'requireArrayVoidStatement'

	// The SCOPE name a base token denotes. `self` is a keyword, so it carries no binding name of its
	// own; it names the receiver parameter, which is bound under `SelfParamName`. Every other base
	// token names itself.
	//
	// One home, because `p.x`, `p.m()` and their `self` spellings all have to answer it the same
	// way — and because it is the ONLY place the `self` token and the receiver parameter's name are
	// connected. A second copy is a second chance to look the receiver up under the word the source
	// happened to write.
	function baseBindingName(tok Token) returns ByteArray
		return SelfParamName if tok.kind == TokenKind.self else tok.value
	end 'baseBindingName'

	// `p.x` — read field `x` out of the box `p` points at.
	//
	// ⭐ **IT RIDES `loadIndirect`, THE OP A GLOBAL'S READ ALREADY USES** (`emitGlobalLoad`), with a
	// real offset where that one passes `GlobalSlotOffset`. There is no `fieldLoad` op and there is
	// not going to be one: the Std memory band is the GENERAL pair, and P1.0d.5b's comments said so
	// while this rung was still called P1.1 ("the offset field is not dead weight — it is what
	// `point.x` will carry, through this same op").
	//
	// The type comes off the BINDING, not off the value column's tag alone: `VarInfo.varType` is a
	// `structRef` carrying the struct's interned name id, and that name is what the layout registry
	// is keyed by. So `p.x` resolves through the same two steps a human does — which type is `p`,
	// and which slot does that type call `x`.
	function parseFieldAccess() returns ValueId throws ParseError
		let step = try self.resolveFieldChain()
		let index = try self.requireFieldIndex(step.layout, fieldTok: step.lastFieldTok)
		try self.requireFieldAccessible(step.layout, index: index, fieldTok: step.lastFieldTok)

		return self.emitFieldLoad(step.box, layout: step.layout, index: index, range: SourceRange.between(step.baseTok, last: step.lastFieldTok))
	end 'parseFieldAccess'

	// ⭐ **RESOLVE A FIELD-ACCESS CHAIN `base.f1.f2.…fN` to its FINAL box + layout + last field token** —
	// the shared spine of a chained READ (`o.inner.x`) and a chained WRITE (`o.inner.x = 42`). It resolves
	// the base binding to its box and layout (`requireStructBase`, which also enforces the live-binding
	// guard), then for every INTERMEDIATE field (all but the last) LOADS that field — which must be a struct
	// — as the next box and threads its layout onward. A borrowed load: the loaded struct box is a borrow of
	// the owning struct's field, valid while the base binding lives, so no ownership is taken and nothing is
	// dropped. The cursor is left on the token AFTER the last field name (the `=` of a write, or wherever the
	// read's expression continues).
	// Consume a field-chain base token — the receiver `self` (a keyword) or a local identifier. `self` names the
	// receiver parameter (resolved by `baseBindingName` to `SelfParamName`); every other base names itself.
	function consumeChainBaseToken() returns Token throws ParseError
		if self.at(TokenKind.self) 'selfBase'
			let tok = self.current()
			self.advance()
			return tok
		end 'selfBase'
		return try self.consume(TokenKind.identifier)
	end 'consumeChainBaseToken'

	function resolveFieldChain() returns FieldChainStep throws ParseError
		// The base is a local identifier (`b.ops.push`) OR the receiver `self` (`self.nodes.push` — P1.7 slice 3):
		// `self` is a keyword, not an identifier, and it names the receiver parameter bound under `SelfParamName`,
		// which `baseBindingName` maps. A single-hop `self.field` read/write resolves elsewhere; this is the 2+-hop
		// chain and the chain-method-call spine, which `fieldChainMethodCallAt` already admits a `self` base to.
		let baseTok = try self.consumeChainBaseToken()
		let baseName = self.baseBindingName(baseTok)
		if self.scope.contains(baseName) 'localBase'
			let baseBinding = self.scope.getInfo(baseName)
			// ⚠ E3070 exemption with an EXPIRY: this base resolves a FIELD CHAIN, whose trailing call is
			// refused today (a nested struct method `o.inner.m()` is E2015 at `parseFieldChainCall`), so no
			// method dispatch can reach the empty subject from here. The rung that lands that call must pass
			// `borrowSubjectNameAt` of the chain's base instead, or it inherits this exemption in silence.
			let base = try self.requireStructBase(baseBinding, baseTok: baseTok, subjectName: EmptySourceText)
			return try self.resolveFieldChainFrom(base.box, layout: base.layout, baseTok: baseTok, baseBinding: baseBinding)
		end 'localBase'
		// A CAPTURED enclosing struct is the base (P1.5-A2b-2): `level.rawValue` inside a closure that captures
		// `level`. The base is not in the closure's own scope; `resolveCapturedFieldChain` reads the box out of
		// the env and resolves its layout the same way `requireStructBase` does.
		match try self.captureScopeOf(baseTok) 'captured'
			found(enclosing) then return try self.resolveCapturedFieldChain(baseTok, enclosing: enclosing)
			notCaptured then break 'captured'
		end 'captured'
		throw ParseError.undefinedVariable(String.from(baseTok.value), line: baseTok.line, column: baseTok.column)
	end 'resolveFieldChain'

	// ⭐ **RESOLVE A FIELD-ACCESS CHAIN ON A CAPTURED STRUCT BASE (P1.5-A2b-2).** `level.rawValue` inside a
	// closure that captures the enclosing struct `level`. The box is READ OUT OF THE ENV (`emitCaptureRead` —
	// a borrowed pointer copy, one `loadIndirect`), and its layout is resolved from the ENCLOSING binding's
	// struct type, identical to a local base. The enclosing binding is threaded as `baseBinding` so a WRITE
	// through a captured base (`level.x = …`) is correctly refused: a captured `let` is immutable (E2013).
	function resolveCapturedFieldChain(baseTok Token, enclosing Scope) returns FieldChainStep throws ParseError
		let base = try self.capturedStructBase(baseTok, enclosing: enclosing)
		// The enclosing binding is threaded as `baseBinding` so a WRITE through a captured base (`level.x = …`)
		// is correctly refused — a captured `let` is immutable (E2013). A read never reads it.
		return try self.resolveFieldChainFrom(base.box, layout: base.layout, baseTok: baseTok, baseBinding: enclosing.getInfo(baseTok.value))
	end 'resolveCapturedFieldChain'

	// Consume one `.field` on `(box, layout)`. The final field (no `.` after) is RETURNED unread for the
	// caller to read or write; an INTERMEDIATE field (a `.` follows) must be a struct — it is LOADED as the
	// next box (a borrow of the owning struct's field) and the walk recurses. Recursive rather than a `var`
	// loop deliberately: threading a `StructLayout` through a reassigned `var` trips the struct-aliasing
	// policy (E3078), while each recursion binds a fresh `let`. Chains are a handful of hops deep.
	function resolveFieldChainFrom(box ValueId, layout StructLayout, baseTok Token, baseBinding VarInfo) returns FieldChainStep throws ParseError
		try self.consume(TokenKind.dot)
		let fieldTok = try self.consume(TokenKind.identifier)
		if not self.at(TokenKind.dot) 'lastField'
			return FieldChainStep.create(box, layout: layout, lastFieldTok: fieldTok, baseTok: baseTok, baseBinding: baseBinding)
		end 'lastField'

		let index = try self.requireFieldIndex(layout, fieldTok: fieldTok)
		try self.requireFieldAccessible(layout, index: index, fieldTok: fieldTok)

		// ⭐ **AN ARRAY FIELD ENDS THE CHAIN (P1.7 slice 1).** `b.ops.push(1)` / `o.inner.items.count()` — the
		// `.` after an array field opens a METHOD call on the array VALUE, not a further field access (an array
		// has no addressable sub-fields). Stop here, returning the array field as the chain's last field: the
		// caller loads it and the postfix loop / statement dispatch applies the method. A STRUCT field is an
		// intermediate box and the walk recurses; any other non-struct followed by `.` is refused by
		// `structLayoutOfField` below, exactly as before.
		let fieldType = self.signatures.fieldTypeOf(layout.name, index: index, into: self.artifact.typeNames)
		if maxonTypeTag(fieldType) == ValueTypeTag.genericInstance and self.signatures.isArrayInstance(typeNameIdOf(fieldType)) 'arrayField'
			return FieldChainStep.create(box, layout: layout, lastFieldTok: fieldTok, baseTok: baseTok, baseBinding: baseBinding)
		end 'arrayField'

		// ⭐ **A TYPE-PARAMETER FIELD ENDS THE CHAIN TOO (P1.7a slice 2b-v)** — `self.item.digest()` where
		// `item` is a `T` constrained `where T is Digest`. The `.` after it opens a WITNESS-dispatched method
		// call on the opaque value, not a further field access: the concrete type is unknown in the shared
		// body, so `T` has no addressable sub-fields the chain could walk. The same rule the array field above
		// states, for the other kind of value whose members are reached by method rather than by offset.
		//
		// It is not a nicety: without it, the ONLY spelling of a throwing witness dispatch — `try
		// self.item.digest()`, which routes here because `fieldChainMethodCallAt` counts two hops — died on
		// `structLayoutOfField`'s "not a struct" reject, so the feature was unusable in the very form the
		// language requires for it.
		if maxonTypeTag(fieldType) == ValueTypeTag.typeParameter 'typeParameterField'
			return FieldChainStep.create(box, layout: layout, lastFieldTok: fieldTok, baseTok: baseTok, baseBinding: baseBinding)
		end 'typeParameterField'

		let nextLayout = try self.structLayoutOfField(layout, fieldTok: fieldTok, fieldType: fieldType)
		let nextBox = self.emitFieldLoad(box, layout: layout, index: index, range: SourceRange.between(baseTok, last: fieldTok))
		return try self.resolveFieldChainFrom(nextBox, layout: nextLayout, baseTok: baseTok, baseBinding: baseBinding)
	end 'resolveFieldChainFrom'

	// The `StructLayout` of a field whose already-resolved type `fieldType` is passed in — used to continue a
	// field chain THROUGH a struct-typed field (`o.inner.x`). The type is resolved to a `structRef`
	// (`named(Inner)` → `structRef`) and must be a struct; a chain through a scalar / String / array field is
	// refused (an array is handled by the caller before this), since there is nothing to address a further
	// field on. `fieldType` is threaded IN (the caller already computed it) so it is not read twice.
	function structLayoutOfField(baseLayout StructLayout, fieldTok Token, fieldType MaxonType) returns StructLayout throws ParseError
		let resolved = self.resolveNamedStruct(fieldType)
		if maxonTypeTag(resolved) != ValueTypeTag.structRef 'notAStruct'
			throw ParseError.unsupported("a field access through '{String.from(baseLayout.name)}.{String.from(fieldTok.value)}', which is declared '{typeTagName(maxonTypeTag(resolved))}' and not a struct — only a struct field can carry a further field access", line: fieldTok.line, column: fieldTok.column)
		end 'notAStruct'
		let name = try self.artifact.typeNames.nameOf(typeNameIdOf(resolved)) otherwise panic("structLayoutOfField: a struct field's structRef name id is not in this file's interner — every structRef is interned from a recorded name")
		match self.signatures.structOf(name) 'declared'
			declared(layout) then return layout
			undeclared then panic("structLayoutOfField: field '{String.from(fieldTok.value)}' is typed `structRef({String.from(name)})` but no file declares that struct — a structRef is only minted for a recorded type name")
		end 'declared'
	end 'structLayoutOfField'

	// ⭐⭐ **A SELF-FIELD READ — `count` AND `self.count`, ONE PATH.**
	//
	// Both spellings mean the same thing, so both resolve to the same `(layout, index)` and hand it
	// to `emitFieldLoad` — **the very routine `p.x` uses**, emitting the same `loadIndirect` at the
	// same offset with the same storage type. The two spellings differ in exactly one step, and it
	// is the step they *have* to differ in: `self.count` names its field with a TOKEN, so it asks
	// `requireFieldIndex` (and can report E3018); a bare `count` came off an alias that
	// `declareSelfFieldAliases` minted by enumerating the layout, so its index is already known and
	// provably valid.
	//
	// ⚠ **v1 SPLITS THIS AND SHV2 MUST NOT — the split is what this rung exists to not inherit.**
	// There, a bare `x` gets dedicated `selfFieldLoad`/`selfFieldStore` ops carrying the receiver
	// out-of-band with slot 0 hardcoded in lowering, while `self.x` gets an ordinary `varLoad` +
	// `fieldLoad`. Two ops, two lowerings, one fact — and it cost v1 twice over:
	//   • its E3014 walker inspects only `fieldLoad`/`fieldStore`, so a bare-name access is
	//     STRUCTURALLY invisible to field visibility (TypeResolution.maxon:8183-8188);
	//   • inside a closure there is no receiver slot, so the hardcoded slot 0 *"would load
	//     garbage"* and the closure path must re-route to the explicit form
	//     (Parser.maxon:18179-18189).
	// Neither is reachable here, and not because they were fixed — because the second path that
	// would have to be kept in step does not exist. `Project.maxon`'s `VarInfo.isSelfField` states
	// the rule; this is where it is obeyed.
	function parseSelfFieldRead(nameTok Token, binding VarInfo) returns ValueId throws ParseError
		return self.emitFieldLoad(try self.requireReceiverValue(nameTok), layout: try self.enclosingLayout(nameTok), index: binding.fieldIndex, range: SourceRange.ofToken(nameTok))
	end 'parseSelfFieldRead'

	// `count = <expr>` — write a field of the enclosing type through the receiver, named bare. The
	// mirror of `parseSelfFieldRead`, landing on `emitFieldStore` exactly as `p.x = 5` does.
	//
	// ⭐ **THE RECEIVER'S OWN MUTABILITY IS NOT ASKED, AND THAT IS THE LANGUAGE'S RULE, NOT AN
	// OMISSION.** `parseFieldAssignment` demands a mutable INSTANCE because `let p` refuses a write
	// through it; here the instance is `__self`, a parameter, and every parameter is bound
	// immutable — so asking would report E2013 against `self.n = self.n * 2` in every mutating
	// method the corpus has. The corpus is also what settles that this is right rather than
	// convenient: `let acc = Accumulator.create(0)` followed by `acc.add(10)` expects **42**
	// (specs/self-keyword.md, `self-with-params`). A `let` on a struct binding refuses a REBIND
	// (`acc = other`) and a direct field write through it (`acc.total = 1`, E2013 — structs.md pins
	// it); it does not reach inside the type's own methods.
	//
	// What IS asked is the FIELD's mutability — `layout.fieldIsMutable`, the same column and the
	// same diagnostic `c.version = 2` gets, because it is the same question. Anchored at the name
	// token, which is the only token there is.
	function parseSelfFieldAssignment(func IrFunction, block IrBlock, nameTok Token, binding VarInfo) throws ParseError
		try self.emitCheckedSelfFieldStore(func, block: block, receiver: try self.requireReceiverValue(nameTok), layout: try self.enclosingLayout(nameTok), index: binding.fieldIndex, fieldTok: nameTok, range: SourceRange.ofToken(nameTok))
	end 'parseSelfFieldAssignment'

	// **THE ONE SELF-FIELD WRITE**, shared by the two spellings: the bare `count = 1` and the
	// explicit `self.count = 1`. Everything a write decides lives here — whether the field accepts
	// one, when the right-hand side is parsed, what type it must have, and the store itself — so
	// the two spellings cannot come to disagree about any of it. They differ only in how the index
	// was found and which tokens the span covers, which is all either caller passes in.
	//
	// The right-hand side is parsed AFTER the rejection, so a refused program emits no op —
	// `emitCheckedGlobalStore`'s discipline, and its name, for its reason.
	function emitCheckedSelfFieldStore(func IrFunction, block IrBlock, receiver ValueId, layout StructLayout, index FieldIndex, fieldTok Token, range SourceRange) throws ParseError
		// ⭐⭐ **AN ITERATED FIELD REFUSES THE STORE WHATEVER IT WAS DECLARED (P1.8 slice A)** — this is the
		// FIFTH door of the iteration lock, and the rung shipped without it. `for it in items 'l' items =
		// IntArray.create() … end` drops the record the loop is still walking, and the header re-reads
		// `__arr_count` off it on the very next trip: MEASURED 0xC0000005 on all four spellings of one
		// program (`items`/`self.items` as the source × `items = …`/`self.items = …` as the write), where
		// the local twin `arr = other` was already E2013 through `requireMutableBinding`. Asked FIRST, and
		// keyed on the INDEX rather than a binding, because that is what BOTH callers hold and neither
		// carries an alias — see `selfFieldIsIterationLocked`.
		//
		// The same E2013 the local spelling gets, and the same code and wording the runnable oracle emits
		// for the bare form (measured: `cannot assign to immutable variable: 'items'`). It is one rule
		// about one storage; it must not answer differently for the way the source spelled it.
		if self.selfFieldIsIterationLocked(index) 'iteratedField'
			throw assignToImmutableError(fieldTok)
		end 'iteratedField'

		if not layout.fieldIsMutable(index) 'immutableField'
			throw ParseError.assignToImmutableField(String.from(layout.name), fieldName: String.from(fieldTok.value), line: fieldTok.line, column: fieldTok.column)
		end 'immutableField'

		// ⭐ E3070's rebind door ONE INDIRECTION OUT — the same write as `arr = other`, reached through
		// `items = other` / `self.items = other`, which both converge here. This is the ONE door that cannot
		// ask `borrowSubjectNameAt`: it holds a field token and a layout index and no chain base at all
		// (`self.items = x`'s base token is `self`). It needs no re-derivation either — `iterationSubjectNameAt`
		// already rules that a self-field chain's subject is the FIELD's name and never the receiver, and
		// `fieldTok` IS that token in both spellings. The `isSelfField` test is only for a store reached outside
		// an instance method, where no alias is in scope and no borrow could have named one.
		if self.functionHoldsABorrow(func) 'mayConflictWithABorrow'
			self.noteBorrowSubjectWrite(func, subjectName: fieldTok.value if self.scope.isSelfField(fieldTok.value) else EmptySourceText, display: ReassignMutationDisplay, anchor: fieldTok, mutatesSubject: true)
		end 'mayConflictWithABorrow'

		// ⭐ **AND IT IS A WRITE OF THE RECEIVER'S STORAGE, WHICH A CALLER CAN SEE** — `items = <fresh>` inside
		// `b.wipe()` drops the record a caller borrowed an element out of, exactly as `items.clear()` does. It
		// records ONLY the E3070 mask: `writtenParamMask` deliberately stays untouched here, because making a
		// caller's `let b` an E3019 for a method that assigns its own field is the very ruling
		// `self-keyword.md:self-with-params` pins (see `IrFunction`'s table).
		//
		// ⚠ **GATED ON THE FIELD BEING AN ARRAY, which is E3070's SCOPE and the SAME line the String and Set
		// dispatchers draw** (`noteReceiverWrite`'s two `receiverStorage: NoMutatedParams` call sites): only an
		// ARRAY write can free an array element, and an array element is the only thing E3070 tracks. Ungated,
		// `total = total + v` marked its whole receiver written, and a caller holding `let s = try
		// b.items.get(0) otherwise ""` was refused `b.add(42)` — a legal program the oracle compiles and runs
		// (measured: it prints `44 42`). The field type is read through the one accessor the type check below
		// already asks.
		if self.typeIsArrayInstance(self.signatures.fieldTypeOf(layout.name, index: index, into: self.artifact.typeNames)) 'arrayFieldStore'
			func.storageWrittenParamMask = func.storageWrittenParamMask or paramMaskOfValue(func, value: receiver)
		end 'arrayFieldStore'

		let valueStart = self.pos
		let parsed = try self.parseExpression(func, block: block)
		// The COERCED value is what the store writes — `count = 3` into a `float` field stores the widened
		// f64. Same door as the struct literal and the `p.v = 3` spelling.
		let value = try self.requireFieldType(layout, index: index, fieldType: self.signatures.fieldTypeOf(layout.name, index: index, into: self.artifact.typeNames), value: parsed, anchor: fieldTok)

		// Routed through `emitFieldWrite`, exactly as `parseFieldAssignment` is: a MANAGED self-field
		// (`name = n`) must drop its old value and MOVE the new one in (a borrowed String is promoted, a
		// borrowed struct refused), not a raw store that leaks the old value and dangles behind a borrow.
		try self.emitFieldWrite(receiver, layout: layout, index: index, value: value, argBareLocal: self.rhsWasBareLocalReference(valueStart), anchor: fieldTok, range: range)
	end 'emitCheckedSelfFieldStore'

	// `self` inside a closure body is a CAPTURE, which shv2 does not yet support (P1.5-A2b): a lifted closure has
	// no receiver, so reading the enclosing `self` would read the closure's own parameter slot 0 as a struct box
	// — a silent wrong answer or crash. BOTH spellings that resolve a `self` receiver must refuse it identically:
	// the explicit `self.…` (`parseSelfPrimary`) and the implicit-self bare sibling call (`implicitSelfReceiver`,
	// #65). ONE condition, ONE message, ONE home — so a bare `foo()` and an explicit `self.foo()` can never drift
	// into giving different diagnostics for the one unsupported construct.
	function requireNotInSelfCapture(anchor Token) throws ParseError
		if self.closureCaptureScopes.count() > 0 'capturedSelf'
			throw ParseError.unsupported("a closure that captures `self` (P1.5-A2b: capturing closures + env block)", line: anchor.line, column: anchor.column)
		end 'capturedSelf'
	end 'requireNotInSelfCapture'

	// `self.x` / `self.m(…)` — the receiver named explicitly. `self` is its own KEYWORD token, so it
	// cannot ride the identifier paths; what it can do is resolve to the same two destinations they
	// do, which is what this routine is for.
	//
	// The `(` at +3 splits them, exactly as `parseDottedPrimary` splits `p.x` from `p.m(…)` — one
	// lookahead, written the same way, because it is the same question about the same three tokens.
	//
	// A BARE `self` — not followed by a dot — is the receiver as a VALUE, which means returning or
	// passing a struct. That is P1.4's ownership ruling (a struct crossing a call boundary), so it
	// is a positioned `unsupported` naming the rung rather than a confusing parse failure. No
	// corpus case needs it: `self-modify-and-return` returns `self.n`, the FIELD.
	function parseSelfPrimary(func IrFunction) returns ValueId throws ParseError
		let selfTok = self.current()

		// The receiver is required for EITHER destination, so it is established once, here, before
		// the split — which is also what keeps `self` in a `static function` out of
		// `parseMethodCall`, whose binding lookup would panic rather than report.
		//
		// ⭐ **`self` INSIDE A CLOSURE IS A CAPTURE (P1.5-A2a), and this line is what refuses it.** A lifted
		// closure has no receiver — its ValueId 0 is its first PARAMETER, not the enclosing method's `self` —
		// so resolving `self` here would read a parameter as a struct box: a silent wrong answer or crash. It
		// is refused as the capture it is; A2b captures the receiver into the env block. The refusal used to
		// be a SEPARATE `requireNotInSelfCapture` call on this line, which is precisely how the BARE
		// self-field spelling escaped it; it now lives inside `requireReceiverValue`, the one door every
		// spelling passes through. See that function.
		_ = try self.requireReceiverValue(selfTok)

		if self.peekKind() != TokenKind.dot 'bareSelf'
			throw ParseError.unsupported("'{selfTok.kind.rawValue}' as a value (a field can be read THROUGH the receiver — `self.x`, or a bare field name — but passing or returning the receiver itself hands a struct across a call boundary, which needs the ownership ruling struct-typed parameters and returns are deferred to)", line: selfTok.line, column: selfTok.column)
		end 'bareSelf'

		if self.methodCallsAt(self.pos) 'methodCall'
			return try self.parseMethodCall(func, resultUsed: true)
		end 'methodCall'

		return try self.parseExplicitSelfFieldRead()
	end 'parseSelfPrimary'

	// `self.x` in value position. It asks `requireFieldIndex` where the bare spelling reads the
	// alias's index — see `parseSelfFieldRead` for why that is the one legitimate difference — and
	// converges on the same `emitFieldLoad`.
	function parseExplicitSelfFieldRead() returns ValueId throws ParseError
		let selfTok = try self.consume(TokenKind.self)
		try self.consume(TokenKind.dot)
		let fieldTok = try self.consume(TokenKind.identifier)

		let layout = try self.enclosingLayout(selfTok)
		return self.emitFieldLoad(try self.requireReceiverValue(selfTok), layout: layout, index: try self.requireFieldIndex(layout, fieldTok: fieldTok), range: SourceRange.between(selfTok, last: fieldTok))
	end 'parseExplicitSelfFieldRead'

	// `self.x = <expr>`. The explicit spelling, resolving its field token to an index and then
	// handing over to the one shared write above — so both spellings ask one mutability rule and
	// emit one store.
	function parseExplicitSelfFieldAssignment(func IrFunction, block IrBlock) throws ParseError
		let selfTok = try self.consume(TokenKind.self)
		try self.consume(TokenKind.dot)
		let fieldTok = try self.consume(TokenKind.identifier)
		try self.consume(TokenKind.equals)

		// The receiver first, so `self.x = 1` in a `static function` reports what is actually wrong
		// rather than tripping over the enclosing type's layout.
		let receiver = try self.requireReceiverValue(selfTok)
		let layout = try self.enclosingLayout(selfTok)
		try self.emitCheckedSelfFieldStore(func, block: block, receiver: receiver, layout: layout, index: try self.requireFieldIndex(layout, fieldTok: fieldTok), fieldTok: fieldTok, range: SourceRange.between(selfTok, last: fieldTok))
	end 'parseExplicitSelfFieldAssignment'

	// `p.x = <expr>` — write field `x` of the box `p` points at. The exact mirror of
	// `parseFieldAccess`: the same three tokens resolved through the same two steps (which type is
	// `p`, which slot does that type call `x`), landing on `storeIndirect` where that one lands on
	// `loadIndirect`. There is no `fieldStore` op for the same reason there is no `fieldLoad`.
	//
	// ⭐ **TWO THINGS MUST BE MUTABLE AND THEY ARE TWO DIFFERENT FACTS**: the INSTANCE (`let p` is
	// not writable through) and the FIELD (`export let version` is not writable). Both report E2013
	// — one code, because it is one defect from two sides: a write to something declared not to
	// accept one. Both anchor at the ROOT VARIABLE token and not at the field, which is measured
	// from the bootstrap and pinned by `structs.md`'s two `error.*` cases at `:16:2`.
	//
	// ⭐ **RESOLVE, THEN PERMIT — AND THE ORDER IS THE WHOLE DIAGNOSTIC CONTRACT.** The checks below
	// run in two bands, and the band boundary is what makes every message name a change that
	// actually fixes the program:
	//
	//   1. RESOLUTION — is `p` a struct, and does it have a field `x`? Asked FIRST, and asked in the
	//      same order and through the same two helpers `parseFieldAccess` asks them, so a field
	//      WRITE and a field READ can never come to disagree about what `p.x` even DENOTES.
	//   2. PERMISSION — may this write happen? The instance, then the field.
	//
	// ⚠ A PERMISSION message can only ever advise "declare it `var`", so asking permission about a
	// write that does not RESOLVE names a change that does not work: `let n = 5` then `n.x = 1` once
	// reported *"cannot assign to immutable variable: 'n'"*, sending the reader to write `var n` —
	// which changes nothing, because an `int` has no fields. It now reports the not-a-struct error
	// the READ path always reported for the same three tokens. Same defect, same message, whichever
	// way the program touches the field.
	//
	// ⚠ **WITHIN the permission band, THE INSTANCE STILL OUTRANKS THE FIELD, and that too is a
	// decision.** When both fail — a `let` instance holding a `let` field — telling a reader to
	// write `var version` would not fix `let p`. In the bootstrap this ranking is a positional
	// ACCIDENT (`ResolveStructVariable(requireMutable: true)` happens to throw before
	// `RequireMutableField` runs) and nothing there declares it. `struct-field-assign-precedence.md`
	// pins BOTH ranks, because a rule stated only in the order of two `if`s is a rule the next edit
	// reorders.
	//
	// ⭐ **VISIBILITY (E3014) LANDS BETWEEN THE TWO, AND THE WHOLE BAND IS ONE CHAIN: EACH RANK IS
	// THE FIX THAT ACTUALLY WORKS NEXT.** The instance, then whether the field can be SEEN, then
	// whether it can be WRITTEN — because `export private` does not fix `let p`, and `var private`
	// does not fix a field the caller cannot reach at all. All three ranks are MEASURED against the
	// bootstrap, not inferred:
	//
	//   • `var v` + `let` unexported field  → **E3014** (visibility outranks field mutability)
	//   • `let v` + `var` unexported field  → **E2013 'v'** (the instance outranks visibility)
	//   • `v.nosuch`                        → **E3018** (resolution outranks all of it)
	//
	// The READ path asks the same chain minus its middle: it has no instance to write through, so
	// resolution is followed directly by visibility (`parseFieldAccess`).
	function parseFieldAssignment(func IrFunction, block IrBlock) throws ParseError
		// `resolveFieldChain` reads `base.f1.…fN` (a single `p.x` or a chain `o.inner.x`), resolving every
		// intermediate struct field and leaving the cursor on the `=`. Its `requireStructBase` already
		// enforced the base's live-binding guard.
		let step = try self.resolveFieldChain()
		try self.consume(TokenKind.equals)
		let index = try self.requireFieldIndex(step.layout, fieldTok: step.lastFieldTok)

		try self.requireMutableBinding(step.baseBinding, nameTok: step.baseTok)
		try self.requireFieldAccessible(step.layout, index: index, fieldTok: step.lastFieldTok)

		if not step.layout.fieldIsMutable(index) 'immutableField'
			throw ParseError.assignToImmutableField(String.from(step.layout.name), fieldName: String.from(step.lastFieldTok.value), line: step.baseTok.line, column: step.baseTok.column)
		end 'immutableField'

		// Parsed AFTER both rejections, so a refused program emits no op — `emitCheckedGlobalStore`'s
		// discipline, for its reason. The value's start is captured so `emitFieldWrite` can decide, for a
		// MANAGED field, whether the new value is a bare-local reference to poison.
		let valueStart = self.pos
		let parsed = try self.parseExpression(func, block: block)
		// The COERCED value is what the store writes — `p.v = 3` into a `float` field stores the widened
		// f64. Same door as the struct literal and the bare self-field spelling.
		let value = try self.requireFieldType(step.layout, index: index, fieldType: self.signatures.fieldTypeOf(step.layout.name, index: index, into: self.artifact.typeNames), value: parsed, anchor: step.lastFieldTok)

		try self.emitFieldWrite(step.box, layout: step.layout, index: index, value: value, argBareLocal: self.rhsWasBareLocalReference(valueStart), anchor: step.lastFieldTok, range: SourceRange.between(step.baseTok, last: step.lastFieldTok))
	end 'parseFieldAssignment'

	// ⭐ **WRITE A FIELD, DROPPING THE OLD MANAGED VALUE AND MOVING THE NEW ONE IN** (P1.4a wave 2) — the
	// assignment counterpart of the construct-time `emitStructLiteral` move. A SCALAR field is a plain store.
	// A MANAGED field (a `String` or a `struct`) DROPS its current value first (`emitDecref`, tag-routed —
	// the old String/struct is freed) and then MOVES the new value in (`moveInPayload` — a borrowed literal
	// is promoted, an owned value transfers, a borrowed struct is refused), so the field owns exactly one
	// value across the write and the old one is freed exactly once. Mirrors the `var`-String reassignment
	// drop model, one indirection out.
	// ⚠ **A FIELD WRITE DELIBERATELY RECORDS NO PARAMETER MUTATION (E3019, the call-site half).** The only
	// box a write can reach today is the enclosing `self` (a field write through a PARAMETER is refused by
	// `requireMutableBinding`, E2013), and a method writing its own receiver's data does not make the
	// caller's `let` an error in shv2 — see `receiverOwnerMask` for the ruling, the corpus case that pins it
	// and the measured oracle inconsistency it settles. The rung that makes a struct PARAMETER's field
	// writable inherits the question, and inherits it here.
	function emitFieldWrite(box ValueId, layout StructLayout, index FieldIndex, value ValueId, argBareLocal bool, anchor Token, range SourceRange) throws ParseError
		// ⭐ **ESCAPE (P1.5-A2b): a capturing closure may not be stored in a struct FIELD** — a struct box is
		// heap memory that outlives the frame, so the field would hold a closure whose env is gone. Positioned
		// at the field name (`anchor`).
		try self.rejectEscapingClosure(value, message: "cannot store a closure that captures in field '{String.from(anchor.value)}' of '{String.from(layout.name)}': {CapturingClosureEscapeSuffix}", tok: anchor)

		var fieldType = self.signatures.fieldTypeOf(layout.name, index: index, into: self.artifact.typeNames)

		// ⭐ **A BARE OPAQUE `T` FIELD REASSIGNMENT (P1.7 Finding A).** The field is typed opaque `T`
		// (`typeParameter`) in the shared layout; how its OLD value drops depends on the box:
		//   • the enclosing SELF (a `structRef`, the shared generic body) keeps the field opaque, so a MANAGED
		//     instantiation's old value drops through the descriptor-gated `__drop_type_param` and the new value
		//     transfers in — `emitOpaqueFieldReassign`, which also handles the trivial-inert store.
		//   • a CONCRETE instance (`b.saved = …`, a `genericInstance`) knows its argument, so RETYPE the field to
		//     that substituted concrete type (as `emitFieldLoad` retypes a READ) and fall through to the normal
		//     write below — a managed concrete field drops the old through its own decref (`__str_decref` /
		//     `__destruct_<T>`, Finding B) and moves the new in; a trivial one reclassifies to a scalar store.
		if maxonTypeTag(fieldType) == ValueTypeTag.typeParameter 'opaqueTypeParamField'
			let tag = self.tagOf(box)
			if tag == ValueTypeTag.structRef 'sharedBody'
				try self.emitOpaqueFieldReassign(box, layout: layout, index: index, value: value, fieldType: fieldType, argBareLocal: argBareLocal, anchor: anchor, range: range)
				return
			end 'sharedBody'
			if tag == ValueTypeTag.genericInstance 'concreteInstance'
				fieldType = self.signatures.adoptType(self.signatures.substitutedInstanceArg(self.valueNameId(box), position: typeNameIdOf(fieldType)), into: self.artifact.typeNames)
			end 'concreteInstance' else 'unexpectedBox'
				panic("emitFieldWrite: a `typeParameter` field write has a box of tag {tag.name} — only the enclosing self (a structRef) or a concrete generic instance (`b.f = …`) reaches an opaque field")
			end 'unexpectedBox'
		end 'opaqueTypeParamField'

		let class = classifyUnionPayload(self.signatures, typeNames: self.artifact.typeNames, fieldType: fieldType)
		if not payloadClassIsManaged(class) 'scalarField'
			self.emitFieldStore(box, layout: layout, index: index, value: value, range: range)
			return
		end 'scalarField'

		let old = self.emitFieldLoad(box, layout: layout, index: index, range: range)
		self.emitDecref(old, range: range)
		let stored = try self.moveInPayload(class, arg: value, argBareLocal: argBareLocal, anchor: anchor, range: range)
		self.emitFieldStore(box, layout: layout, index: index, value: stored, range: range)
	end 'emitFieldWrite'

	// ⭐ **REASSIGN A BARE OPAQUE `T` FIELD IN THE SHARED GENERIC BODY (P1.7 Finding A)** — the opaque twin of the
	// concrete managed field write. The new value MUST be an OWNED feed parameter: the shared body cannot COPY an
	// opaque `T`, so ownership transfers — `markOpaqueFieldReassignFeed` recorded the reassigned parameter as a
	// feed, so `bindParameters` enrolled it owned and the concrete call site transferred it. The field's OLD value
	// drops ONLY when some instantiation makes it MANAGED: then through the descriptor-gated `__drop_type_param`
	// (`emitDecref`'s `typeParameter` arm, whose descriptor the method reserved via `computeTypeDescriptorNeeds`'s
	// `reassignsOpaqueField` signal, inert for a trivial instantiation whose `destroyFunc@40` is 0). An ALL-TRIVIAL
	// field owns no heap, so no drop and no descriptor — the store is byte-identical to the pre-slice plain store.
	// The new value then ALWAYS transfers into the field (a bare-local source is poisoned, E3102 on later use), so
	// this frame does not also drop it AND the enrolled-owned parameter is never left live to drop at a scope exit
	// (which would need a descriptor a trivial method does not carry). A non-owned RHS (aliasing one opaque field
	// into another, whose descriptor-gated copy is a later slice) is refused cleanly rather than storing a borrow.
	function emitOpaqueFieldReassign(box ValueId, layout StructLayout, index FieldIndex, value ValueId, fieldType MaxonType, argBareLocal bool, anchor Token, range SourceRange) throws ParseError
		if not self.valueIsOwnedHeap(value) 'notOwned'
			throw ParseError.unsupported("reassigning the opaque type-parameter field '{String.from(anchor.value)}' of '{String.from(layout.name)}' from a value that is not an owned parameter — the shared generic body cannot copy an opaque `T` value, so assign it from a parameter the method consumes; aliasing one opaque field into another needs the descriptor-gated copy a later slice adds", line: anchor.line, column: anchor.column)
		end 'notOwned'

		// ⭐ A CO-OWNED TRIVIAL STRUCT instantiation (`Box with Point`, the retain-escaping rung) cannot be
		// reassigned in a shared body: the box CO-OWNS its trivial `T` field (retained at the constructor feed,
		// dropped by its destructor), but this opaque reassignment has no way to drop the field's OLD co-owned
		// value — a trivial struct's `__mm_decref` cannot be emitted from the opaque body, and the descriptor-
		// gated `__drop_type_param` is inert for a trivial instantiation (`destroyFunc@40` is 0). Storing the
		// new value over the old would LEAK it. Rejected cleanly rather than shipping the leak; the trivial-
		// struct single-value drop is a later slice (the descriptor infrastructure this rung deliberately leaves
		// untouched). A managed instantiation reassigns through the descriptor as before, and a scalar is inert —
		// neither is a co-owned trivial, so this fires on exactly the co-ownership gap.
		if self.signatures.genericTypeFieldHasCoOwnedTrivialInstantiation(layout.name, position: typeNameIdOf(fieldType)) 'coOwnedTrivialReassign'
			throw ParseError.unsupported("reassigning the type-parameter field '{String.from(anchor.value)}' of '{String.from(layout.name)}' in a shared generic body, where a trivial-struct instantiation co-owns the field — the box retains a co-owned trivial struct at construction and drops it once at destruction, but a shared-body reassignment cannot drop the old co-owned value (the descriptor-gated single-value drop for a trivial struct is a later slice); reassign the field on a concrete instance, or use a managed element type", line: anchor.line, column: anchor.column)
		end 'coOwnedTrivialReassign'

		if self.signatures.genericTypeFieldHasManagedInstantiation(layout.name, position: typeNameIdOf(fieldType)) 'managedDrop'
			let old = self.emitFieldLoad(box, layout: layout, index: index, range: range)
			self.emitDecref(old, range: range)
		end 'managedDrop'

		try self.transferOwnedInto(value, argBareLocal: argBareLocal, anchor: anchor)
		self.emitFieldStore(box, layout: layout, index: index, value: value, range: range)
	end 'emitOpaqueFieldReassign'

	// Declare every field of the enclosing type as a self-field alias, so a bare `width` inside
	// `function area()` of `type Rect` resolves to `self.width`. Called at instance-method entry
	// only; `anchor` is the method's name token, which the layout lookup's diagnostic points at.
	//
	// The alias carries the field's INDEX and its declared TYPE, both read straight out of the
	// layout being enumerated — so the alias cannot name a field the type does not have, which is
	// what lets the read and write paths skip the "does this type have this field?" question that
	// `self.x` and `p.x` must ask.
	//
	// The type comes through `fieldTypeOf`, not off the layout's column directly, because that is
	// the door that RE-INTERNS a `named` type into this file's own interner — the same door
	// `emitFieldLoad` reads a field's type through. Reading the column raw would bind aliases to
	// type-name ids from the SWEEP's table, which this file's interner cannot resolve.
	function declareSelfFieldAliases(anchor Token) throws ParseError
		let layout = try self.enclosingLayout(anchor)
		for i in 0 upto layout.fieldCount() 'eachField'
			let fieldName = try layout.fieldNames.get(i) otherwise panic("declareSelfFieldAliases: fieldNames.get OOB at {i} for `type {String.from(layout.name)}`, which declares {layout.fieldCount()}")
			self.scope.declareSelfField(fieldName, varType: self.signatures.fieldTypeOf(layout.name, index: i, into: self.artifact.typeNames), fieldIndex: i)
		end 'eachField'
	end 'declareSelfFieldAliases'

	// The `StructLayout` of the type whose body encloses the cursor. The self-field twin of
	// `requireStructBase`: that one resolves the layout of a BINDING's declared type, this one
	// resolves the layout of the enclosing DECLARATION, which is what a receiver and a bare field
	// name are both typed by.
	//
	// Both misses panic rather than report, and for `requireConstructible`'s reason: every caller
	// is inside an instance method, so an enclosing type exists by construction, and the
	// declaration sweep recorded every `type` in the program before this file's parse began.
	function enclosingLayout(anchor Token) returns StructLayout throws ParseError
		if self.enclosingType.isEmpty() 'noEnclosingType'
			panic("enclosingLayout: asked for the enclosing type's layout at {anchor.line}:{anchor.column}, but the cursor is at file scope — every caller is inside an instance method, whose body only `parseTypeDeclaration` reaches")
		end 'noEnclosingType'

		match self.signatures.structOf(self.enclosingType) 'declared'
			declared(layout) then return layout
			undeclared then panic("enclosingLayout: `type {String.from(self.enclosingType)}` is being parsed right now, but the declaration sweep never recorded it — `recordScannedType` and `parseTypeDeclaration` disagree about what opens a type declaration")
		end 'declared'
	end 'enclosingLayout'

	// ⭐ **THE RECEIVER'S SSA VALUE — READ BACK, NEVER ASSUMED.** It is parameter 0, so it is
	// ValueId 0; but that is a CONSEQUENCE of the Std-ABI seeding `parseFunction` performs
	// (`ValueIdRef.create(paramCount)` reserves 0..paramCount-1 and `bindParameters` binds
	// parameter `i` to id `i`), not an independent fact. A literal `0` here would be that
	// convention written down a second time, in the one place that would keep compiling — and
	// silently reading the wrong value — the day the seeding changed.
	//
	// **IT IS ALSO THE ONE PLACE `self` IS REFUSED WHERE THERE IS NO RECEIVER**, because that is
	// the same question: the receiver is bound iff `parseFunction` pushed one, so a failed lookup
	// IS "this is not an instance method". A `static function` is the interesting case — it has an
	// enclosing type but no instance — and file scope has neither. Both report here, positioned,
	// rather than reaching `enclosingLayout` and panicking on an enclosing type that is absent or
	// irrelevant.
	function requireReceiverValue(anchor Token) returns ValueId throws ParseError
		// ⭐⭐ **AND IT IS WHERE `self`-IN-A-CLOSURE IS REFUSED, BECAUSE THE THIRD SPELLING WAS READING
		// GARBAGE.** `parseSelfPrimary` claimed the refusal was shared "so the two spellings cannot disagree
		// about it" — but a bare self-FIELD name is a THIRD spelling, and it reached `parseSelfFieldRead`
		// without ever passing the gate. Inside a closure the enclosing scope is still visible, so
		// `lookupValue(SelfParamName)` SUCCEEDS and hands back ValueId 0 — which in a LIFTED closure is its
		// own first PARAMETER, not the enclosing method's receiver. MEASURED: `apply(function(k int) gives
		// k + n, x: 1)` inside a method of a `type Counter` with `n = 3` compiled clean and returned **25**
		// where the answer is 4, with no diagnostic anywhere; the `self.n` spelling of the same expression was
		// refused, and the ranged-alias spelling panicked in lowering instead. Exactly the wrong answer
		// `parseSelfPrimary`'s own header predicts — "would read a parameter as a struct box".
		//
		// The gate belongs HERE and not at the three call sites because this is the one place the receiver
		// VALUE comes from: a read, a write, `self.x` and a bare `self` all pass through, so every present
		// and future spelling is covered by one statement rather than by remembering. `implicitSelfReceiver`
		// keeps its own call — it needs `none` rather than a value for a static sibling call, so it cannot
		// come through this door.
		try self.requireNotInSelfCapture(anchor)

		return try self.scope.lookupValue(SelfParamName) otherwise throw ParseError.unsupported("'{anchor.kind.rawValue}' outside an instance method (`self` names the instance a method was called on; a `static function` is called on the type itself and has none)", line: anchor.line, column: anchor.column)
	end 'requireReceiverValue'

	// **The declaration index `fieldTok` names in `layout`, or E3018** — asked by every one of the
	// three places a field is named by a TOKEN: the struct literal's `x:` label, the field READ,
	// and the field WRITE. One home, because it is one question, and the three must not come to
	// disagree about what "this type has no such field" means or where the diagnostic points (the
	// FIELD token — the token that is wrong, never the value it is read from).
	//
	// A BARE self-field name does not ask it: its index came off the alias, which
	// `declareSelfFieldAliases` minted by enumerating the layout, so the field provably exists. A
	// bare name that is NOT a field is not a self-field alias at all and never reaches a field
	// path — it is an undefined variable, and reports as one.
	//
	// It is also the one place `indexOfField`'s "not found" convention is READ. That answer is
	// `fieldCount()` — an index one past the end — and every caller comparing against it by hand was
	// a caller that could get the comparison subtly wrong (`>` rather than `>=`) and index a
	// neighbouring field's slot instead of reporting an error. Now the convention is decoded once.
	function requireFieldIndex(layout StructLayout, fieldTok Token) returns FieldIndex throws ParseError
		let index = layout.indexOfField(fieldTok.value)
		if index >= layout.fieldCount() 'noSuchField'
			throw ParseError.unknownField(String.from(layout.name), fieldName: String.from(fieldTok.value), line: fieldTok.line, column: fieldTok.column)
		end 'noSuchField'
		return index
	end 'requireFieldIndex'

	// ⭐ **E3014 — A FIELD NOT DECLARED `export` IS REACHABLE ONLY FROM ITS OWN TYPE'S BODY.**
	//
	//     accessible  ==  the field is exported  OR  this code is inside the declaring type
	//
	// **THE GATE IS THE TYPE, NOT THE FILE**, and that is measured rather than inherited: `type B`
	// reading `type A`'s unexported field is E3014 on the bootstrap **in the same file**. BOTH
	// reference registries call it "another file" and both are wrong — v1's CODE agrees with the
	// measurement (it gates on `structName == enclosingType`, TypeResolution.maxon:8204) and only
	// its prose does not. `docs/error-codes.txt`'s doc line is corrected to match.
	//
	// ⚠ **AND THAT SENTENCE IS PINNED BY A SPEC, BECAUSE FOR ONE REVIEW-ROUND IT WAS NOT.** As
	// first written this comment asserted the type-vs-file rule while **nothing in the suite could
	// tell the two apart**: every corpus case reaches the field from `main()`, which is inside no
	// type, so they pin only *"outside ANY type ⇒ reject"*. Weakening the test below to
	// `not self.enclosingType.isEmpty()` — a compiler where every method reads every type's private
	// state — left `specs-shv2` at **392/0**, both corpus E3014 cases included (measured, not
	// argued). That is OPEN.md #27's shape exactly: the reason written down enforced nothing while
	// the property held for a reason nobody had written. `specs-shv2/field-visibility-is-type-scoped.md`
	// is the sabotage's red, kept: two cases that fail under that edit, plus the positive companion
	// (a type reaching its OWN private field through a LOCAL, which the self-field path never sees)
	// so the rule is pinned in the ADMIT direction too. **Do not delete it to make a refactor green.**
	//
	// **ONE HOME, TWO CALLERS** — the field READ and the field WRITE. It is one rule; written at
	// both sites, a future answer to what "accessible" means (a `module`-visible field, a friend
	// type) taught to one and not the other would let a private field be WRITTEN where reading it
	// correctly reports. An accepted access that should have been refused is a wrong answer, not a
	// compile error.
	//
	// `namesEnclosingType` is the SAME predicate `requireConstructible` (E3076) and
	// `parseTypeReference` ask — "am I inside type T's body?" — so visibility, construction and
	// `Self` cannot come to disagree about where a type's body ends.
	//
	// ⚠ **IT IS NOT ASKED AT THE STRUCT-LITERAL SITE, AND THE REASON IS THE SPEC'S, NOT E3076'S.**
	// Initialization is exempt outright: *"All fields (exported or not) can be initialized in
	// struct literals, since the type itself determines what fields exist. The visibility only
	// affects access after construction"* (specs/export-var-fields.md). In shv2 that exemption is
	// VACUOUS today — E3076 already refuses every literal written outside its own type's body, so
	// no out-of-type literal survives to ask — but it is the SPEC's rule that makes the absence
	// correct rather than merely unreachable, and it is written here so the day E3076 relaxes does
	// not silently take the exemption with it. (v1 needs the rule live, and spells it `isInit`.)
	//
	// ⚠ **NOR IS IT ASKED ON THE SELF-FIELD PATH**, where it could not fail: a bare `count` and
	// `self.count` both resolve through `enclosingLayout`, so `namesEnclosingType(layout.name)`
	// holds by construction. The rule is asked wherever it can be broken, which is wherever the
	// layout came from a BINDING's type rather than from the enclosing declaration.
	function requireFieldAccessible(layout StructLayout, index FieldIndex, fieldTok Token) throws ParseError
		if layout.fieldIsExported(index) 'exported'
			return
		end 'exported'
		if self.namesEnclosingType(layout.name) 'insideDeclaringType'
			return
		end 'insideDeclaringType'
		throw ParseError.unexportedFieldAccess(String.from(layout.name), fieldName: String.from(fieldTok.value), line: fieldTok.line, column: fieldTok.column)
	end 'requireFieldAccessible'

	// ⭐ **A MOVED-FROM BINDING IS DEAD AT EVERY USE, AND THIS IS THE ONE PREDICATE THAT SAYS SO.** Its
	// owned heap value was transferred to another binding by a `let u = t` / `s = t` whose RHS was a
	// bare reference to it (`poisonMoveSource` set `movedFrom`), so the value now belongs to that new
	// owner and any further USE of the source — a bare read, a field read or write THROUGH it, a method
	// call ON it — is use-after-move (E3102), anchored on the USE token. Only a FULL reassignment
	// `t = <expr>` revives it (`reassignBindingValue` clears the bit); a field store `t.x = …` is itself
	// a use of `t`, not a revive of it, so it must route through here and NOT through the reviving path.
	//
	// ⭐ **ONE HOME, TWO ENFORCING CALLERS**: the bare read (`parseVariableReference`) and every base of
	// a `.` — field read (`parseFieldAccess`), field write (`parseFieldAssignment`) and method receiver
	// (`parseMethodCall`), which ALL funnel through `requireStructBase`. Written at only the bare read,
	// a moved-from struct read or written through its fields was an UNCHECKED use-after-move: `let q = p`
	// then `p.x = 99` mutated `q`'s aliased box and `return q.x` returned 99 — a wrong answer for a
	// program that must be rejected (OPEN.md #42). The rule cannot be split across use sites: a site
	// taught it beside a site not taught it IS that bug, and it is the same "one predicate, one enforcing
	// home" the move gate itself is written to.
	//
	// A SELF-FIELD ALIAS is EXCLUDED: a bare `count` inside a method reads a fresh `loadIndirect` through
	// the receiver rather than aliasing an owned value, so it is never moved-from (`poisonMoveSource`
	// gates on `rhsWasBareLocalReference`, which excludes self-fields). `parseVariableReference` routes
	// self-fields away before it reaches this guard; the exclusion here is what keeps the guard safe on
	// the struct-typed self-field base that DOES reach `requireStructBase` (and is refused there for the
	// unrelated reason that its box has to be loaded out of the receiver first).
	function requireBindingLive(binding VarInfo, nameTok Token) throws ParseError
		// ⭐ **THE NON-LEXICAL HALF OF E3070 IS WRITTEN HERE, and this is why it is written HERE.** This is the
		// one chokepoint every USE of a local binding funnels through — the bare read, a field read or write
		// through it, a method call on it — which is exactly the set of events a borrow's lifetime ends at. A
		// second site asking "was this name read?" would be the same defect the guard below documents, one
		// question later: a use taught to one site and not the other lets a borrow expire while it is still
		// live, and a mutation past it becomes a use-after-free the compiler waved through.
		//
		// Written BEFORE both early returns: a self-field alias and a scalar binding are uses too, and the
		// exclusions below are about a MOVE, not about whether the name was read.
		//
		// ⚠ **ONLY EVER FORWARD.** The cursor is monotone through a function body, so the test is a no-op
		// for every ordinary read — it is here for the ONE binding whose last use is seeded AHEAD of the
		// parse, a `for … in` element's (`attachPendingBorrows`'s `liveUntil`). Without it the first read of
		// the loop variable inside the body would pull that lexical extent back to itself and expire a
		// borrow the iteration is still holding: a use-after-free.
		if self.pos > binding.lastUseToken 'laterThanAnyUseSoFar'
			binding.lastUseToken = self.pos
		end 'laterThanAnyUseSoFar'

		if binding.isSelfField 'selfFieldAlias'
			return
		end 'selfFieldAlias'

		// ⭐ **A SCALAR-VALUED BINDING IS ALWAYS SAFE TO READ (P1.5-B2 #88).** `movedFrom`/`partiallyMoved`
		// forbid a read because a MOVED HEAP value now belongs to another owner; a scalar is never moved that
		// way, so a move bit on a scalar-valued binding means something else entirely. Two such cases exist,
		// both from #88: a CONSUMED promise (`movedFrom` = "an `await` reclaimed the green thread" — a second
		// use is caught by the more specific linear-await E3100 at SemanticCheck, which needs the read to PARSE
		// first, and a re-arm revives it), and a promise binding reassigned to a bare scalar (`movedFrom` =
		// "owns nothing droppable"). A promise handle is integer-tagged, so this one predicate admits both.
		let boundTag = self.tagOf(binding.boundValue)
		if tagIsAsyncScalar(boundTag) or boundTag == ValueTypeTag.float 'scalarBinding'
			return
		end 'scalarBinding'

		// Both move states are dead at every read. `movedFrom` (a `let u = t` / `s = t` handed the value
		// to another binding) and `partiallyMoved` (a binding-match moved a managed payload OUT of this
		// union, nulling its slot) differ only in whether the binding still owes a DROP — a use is
		// forbidden for both, and this is the one predicate that says so.
		if binding.movedFrom or binding.partiallyMoved 'moved'
			throw ParseError.useAfterMove(String.from(nameTok.value), line: nameTok.line, column: nameTok.column)
		end 'moved'
	end 'requireBindingLive'

	// The box `binding` denotes and the `StructLayout` describing it — the two-step every field
	// access takes: the binding's declared type must BE a struct, and that struct must be one some
	// file declares.
	//
	// The second step cannot fail for a `structRef` the parser itself minted (it interned the id from
	// a name the sweep had already recorded), so it panics; the first very much can — `let n = 5`
	// then `n.x` — and reports. `baseTok` is only the token those diagnostics point at.
	//
	// ⭐⭐ **IT IS THE ONE READER OF A BASE BINDING'S `boundValue`, AND THAT IS WHY IT RETURNS THE
	// BOX AND NOT JUST THE LAYOUT.** A SELF-FIELD ALIAS HAS NO SSA VALUE: `createSelfField` leaves
	// `boundValue` 0 because a read of the alias is a `loadIndirect` through the receiver, not a
	// reference to a value — **and ValueId 0 IS THE RECEIVER**. So a caller that proved the layout
	// here and then reached for `binding.boundValue` on its own silently addressed `__self`.
	//
	// That is not a hazard this comment is imagining; it was MEASURED, on the three sites that did
	// exactly that. In a self-referential `type Node` (`var next as Node`, which
	// `parseTypeReference` types `structRef` through its `namesEnclosingType` arm):
	//   • `return next.a`      compiled to a single `loadRegBaseDisp r8, [rcx + 0]` — that is
	//                          `return self.a`, off the receiver, at the wrong field's offset.
	//   • `return next.readA()` compiled to a bare `callDirect Node.readA` with NO argument setup —
	//                          the receiver was already in `rcx`, so it is `self.readA()`.
	//   • `next.a = 99`        reported E2013 "cannot assign to immutable variable: 'next'", which
	//                          is simply false of an `export var` field.
	// The first two exit 0 with no diagnostic anywhere. `parseVariableReference` guards this same
	// fact for the bare-name path and its comment states it exactly; the fact was written down
	// once and needed in four places. Handing the box back from here is what makes the other three
	// unable to get it wrong.
	function requireStructBase(binding VarInfo, baseTok Token, subjectName ByteArray) returns StructBase throws ParseError
		// The base binding must be LIVE before anything about it is resolved — a moved-from base is dead,
		// so `p.x`, `p.x = …` and `p.m()` on it are use-after-move (E3102), reported here at the base
		// token before the field/method is even looked up. This is the shared guard's second enforcing
		// home; `parseVariableReference` is the first. See `requireBindingLive`.
		try self.requireBindingLive(binding, nameTok: baseTok)

		// A struct box OR a generic INSTANCE (`Sizer with bool`, P1.6-B1) can be a method/field base — both
		// resolve to a struct layout (the instance's base struct, its methods compiled once against the
		// opaque `T`). Every other tag has no fields.
		let baseTag = maxonTypeTag(binding.varType)
		if baseTag != ValueTypeTag.structRef and baseTag != ValueTypeTag.genericInstance 'notAStruct'
			throw ParseError.unsupported("a field access on '{String.from(baseTok.value)}', which is declared '{typeTagName(baseTag)}' and not a struct type (only a struct has fields)", line: baseTok.line, column: baseTok.column)
		end 'notAStruct'

		// ⚠ **A STRUCT-TYPED FIELD USED AS A BASE IS REFUSED, NOT LOADED** — `next.a` inside `type
		// Node`'s own method. Tested AFTER the `structRef` gate above, so a SCALAR field's alias
		// (`count.x`, where `count` is an `Integer`) still reports what is actually wrong with it
		// rather than being blamed on a struct it is not.
		//
		// Reading it correctly means materializing the field first — `loadIndirect` the box out of
		// the receiver, then address THAT — which is one line, and is deliberately NOT taken here.
		// A struct-typed field cannot be CONSTRUCTED at this rung: `Self{next: …}` needs a `Node`
		// to put there, there is no `null` and no base case, so no program could observe the load
		// being right. That is the `mintPhi` trap exactly — a mechanism handed a consumer and no
		// reason to be right — and it is the same trap this rung's own scaffold waited out. It
		// arrives with the rung that gives a field a struct type, which is the rung that already
		// owes this one its receiver-ownership analysis (see `parseMethodCall`).
		if binding.isSelfField 'structTypedField'
			throw ParseError.unsupported("a field access through '{String.from(baseTok.value)}', which is a struct-typed FIELD of the enclosing type (its box has to be loaded out of the receiver before it can be addressed, which arrives with the rung that gives a field a struct type — no struct-typed field can be constructed yet)", line: baseTok.line, column: baseTok.column)
		end 'structTypedField'

		return StructBase.create(try self.structLayoutOfBinding(binding, baseTok: baseTok), box: binding.boundValue, immutableName: self.immutableReceiverNameOf(binding, baseTok: baseTok), subjectName: subjectName)
	end 'requireStructBase'

	// The `StructLayout` a struct-typed binding names — the guarded layout half of `requireStructBase`,
	// factored out so a CAPTURED struct base (whose box is the value read out of the env, not
	// `binding.boundValue`) can resolve its layout the identical way (`resolveCapturedFieldChain`). The
	// binding's `structRef` name keys the layout registry. Assumes the `structRef`/`genericInstance` gate
	// above already held.
	//
	// ⭐ **THE TWO TAGS THAT GATE REACH HERE DIFFER IN WHETHER A MISSING LAYOUT IS POSSIBLE, AND THAT IS THE
	// WHOLE OF THIS FUNCTION.** A `structRef` was interned by the parser itself from a name the declaration
	// sweep had already recorded, so its layout cannot be absent and an absence is an invariant break — it
	// panics. A `genericInstance`'s base is whatever a `with` NAMED, and the instance is interned for it
	// either way, so a missing layout is an ordinary property of a program a user can write and must be a
	// positioned diagnostic. Both were one panic, and both were reachable: `arr.managed` on an `Array with
	// Int` and `t.foo` on a parameter typed `Nonexistent with Int` each died with a stack trace and no
	// `error E….` at all.
	//
	// ⇒ So the two tags do not ask the same question, and only the `structRef` half may ask `structOf`. The
	// instance half asks the SAME walk gate the four `SignatureIndex` field walks open with, for the reason
	// the gate below states: a name being declared is not the same fact as this instance's fields living
	// there, and where they came apart the compiler read a heap pointer out as user data.
	function structLayoutOfBinding(binding VarInfo, baseTok Token) returns StructLayout throws ParseError
		let typeName = self.baseStructNameOfBinding(binding, baseTok: baseTok)

		// ⚠⚠ **AN INSTANCE ASKS `genericInstanceHasBaseLayout`, NEVER `structOf` ALONE — THE TWO DISAGREE,
		// AND THE DISAGREEMENT IS MEMORY-UNSAFE.** They answer different questions: `structOf` says "is a
		// type of this NAME declared anywhere", the gate says "does THIS INSTANCE have a layout its fields
		// actually live at". For a BUILTIN base they part company the moment a program writes `type Array
		// uses T` — the declaration registers, so `structOf` hands back ITS field table, while the VALUE in
		// hand is the runtime's synthesized 48-byte record, because every other door (`create`, the method
		// router, `genericInstanceBoxSize`, `genericInstanceBoxDropCallee`) is already routed to the builtin
		// by `isArrayInstance`. The field offsets then address the record, and MEASURED, with no diagnostic
		// anywhere and a compile that exits 0: `a.value` on an `Array with Integer` printed 7077984 — the
		// element buffer POINTER read as an Integer — and `a.value = 4242` overwrote that pointer, taking an
		// access violation (0xC0000005) in the teardown. `Set` hands out its record's count the same way.
		//
		// So the walk gate is the ONE door here too, exactly as it is at the four `SignatureIndex` walks: an
		// instance whose base has no layout OF ITS OWN never reads fields, whoever else declares the name.
		if maxonTypeTag(binding.varType) == ValueTypeTag.genericInstance and not self.signatures.genericInstanceHasBaseLayout(typeNameIdOf(binding.varType)) 'noBaseLayout'
			throw self.missingBaseLayout(typeName, baseTok: baseTok)
		end 'noBaseLayout'

		match self.signatures.structOf(typeName) 'declared'
			declared(layout) then return layout
			undeclared then panic("structLayoutOfBinding: '{String.from(baseTok.value)}' resolves to base struct '{String.from(typeName)}' but no file declares that type — a struct base is only minted for a name the declaration sweep recorded (Parser.parseTypeReference), and an INSTANCE base was gated by genericInstanceHasBaseLayout above")
		end 'declared'
	end 'structLayoutOfBinding'

	// Which of the two ways a generic instance's base has no `StructLayout` this one is, worded for a reader
	// who needs opposite things from them — the diagnostic half of `ProgramSignatures.genericInstanceHasBaseLayout`,
	// whose header states the split. Only an instance reaches here; a `structRef` with no layout is an
	// invariant break and panics at the call site above.
	function missingBaseLayout(typeName ByteArray, baseTok Token) returns ParseError
		// ⚠ **DO NOT SAY THE FIELD DOES NOT EXIST — IT VERY LIKELY DOES.** `stdlib/Array.maxon:106` declares
		// `export var managed as ElementMemory`, so `arr.managed` is a real language feature and reporting it
		// as an unknown field would be a false statement about Maxon (12 committed spec cases write exactly
		// that access). What is true is narrower and is what this says: shv2 reads no stdlib and SYNTHESIZES
		// the `Array`/`Set` runtime record instead of compiling the declaration, so no `type` exists here to
		// carry a field table at all. E2015 — a construct this compiler does not implement YET — is exactly
		// the register that carries, and it is the same one the sibling `n.x` guard above reports in.
		//
		// The wording names the stdlib file rather than a field, because the two builtins declare DIFFERENT
		// fields (`Array` its `managed`, `Set` its `elements`/`states`/`hashes`) and a message that named one
		// of them would be false about the other.
		if self.signatures.isBuiltinGenericBaseName(typeName) 'synthesizedBuiltin'
			return ParseError.unsupported("a field access on '{String.from(baseTok.value)}': `{String.from(typeName)}` is a BUILTIN whose runtime record shv2 synthesizes, not a `type` it compiles — shv2 reads no stdlib, so none of the fields `stdlib/{String.from(typeName)}.maxon` declares exist here yet. The field is missing from this compiler, not from the language; reach the contents through the methods", line: baseTok.line, column: baseTok.column)
		end 'synthesizedBuiltin'

		// The base is not declared AT ALL, so it has no fields and never will under this spelling. The
		// `with` that named it is the actual error and `checkGenericInstance` records E2055 against it — but
		// a thrown ParseError discards this file's artifact diagnostics (`abortedParseArtifact`), so this
		// message has to carry the cause on its own rather than defer to one the user will never see.
		return ParseError.unsupported("a field access on '{String.from(baseTok.value)}': its type instantiates '{String.from(typeName)}', which no file declares as a generic `type`, so it has no fields — the `with` that names it is the error", line: baseTok.line, column: baseTok.column)
	end 'missingBaseLayout'

	// The BASE struct name a method/field base resolves to: the struct itself for a `structRef`, or the
	// generic instance's base struct for a `genericInstance` (`Sizer with bool` ⇒ `Sizer`, P1.6-B1) — the
	// SHARED body its methods were compiled once against. The caller's `requireStructBase` has already
	// gated the tag to one of these two.
	function baseStructNameOfBinding(binding VarInfo, baseTok Token) returns ByteArray
		if maxonTypeTag(binding.varType) == ValueTypeTag.genericInstance 'instance'
			return self.signatures.genericInstanceBaseName(typeNameIdOf(binding.varType))
		end 'instance'
		return try self.artifact.typeNames.nameOf(typeNameIdOf(binding.varType)) otherwise panic("baseStructNameOfBinding: '{String.from(baseTok.value)}' carries a structRef whose name id is not in this file's interner — every structRef the parser mints is interned from a name in the same table")
	end 'baseStructNameOfBinding'

	// `loadIndirect <box> <offset>` — the one op a field read is.
	//
	// ⚠ **THE VALUE'S TAG AND THE OP'S `valueType` ARE DELIBERATELY DIFFERENT THINGS**, and reading
	// this as a redundancy is how it would get broken:
	//
	//   • the VALUE is minted with the field's DECLARED type — `named(Integer)` for a ranged alias —
	//     so the tag column keeps what the source said. THE SHIFT RULE reads it (`valueIsUnsigned`
	//     looks the alias's LOW BOUND up by name), so a field of `int(0 to u64.max)` right-shifts
	//     zero-filled, exactly as a PARAMETER of that type does.
	//   • the OP carries the field's STORAGE type — the resolved primitive — because
	//     `maxonTypeToStdType` PANICS on a `named`, and it panics on purpose: an op's type must be
	//     concrete by lowering, and `resolveTypes` rewrites signatures only, never op types.
	//
	// A parameter declared `Integer` already lives with exactly this split (`valueTagToStdType`'s
	// `named` arm exists for it), so this is that arrangement reaching one op further, not a new one.
	function emitFieldLoad(box ValueId, layout StructLayout, index FieldIndex, range SourceRange) returns ValueId
		// A FUNCTION-typed field (`export var op as UnaryOp`) arrives from `fieldTypeOf` already re-tagged
		// `function` (it functionizes over the whole-program function-alias registry, since the SWEEP that
		// recorded the layout ran before the alias was known), which is what makes the loaded value carry
		// the `function` tag so `h.op(21)` reaches an indirect call (P1.5-A1).
		let declared = self.signatures.fieldTypeOf(layout.name, index: index, into: self.artifact.typeNames)
		let offset = layout.offsetOfField(index)
		let result = self.emitIndirectLoad(declared, box: box, offset: offset, storageType: self.fieldStorageType(declared), range: range)

		// ⭐ **RETYPE-OF-T AT A CONCRETE FIELD READ (P1.6-B2).** A `b.value` read on a concrete `Box with String`
		// loads a field the shared body typed opaque `T` (`typeParameter`). Retype the result to the instance's
		// SUBSTITUTED concrete argument (`String`) so it is usable as what it actually is — but ONLY the type
		// moves: the read is a BORROW (`emitFieldLoad` never marks it owned-heap), so the box keeps its +1 and
		// drops the value at ITS scope exit; a `let s = b.value` re-reads a live pointer and is never
		// double-dropped. `adoptType` re-interns any named argument into this file's interner.
		if maxonTypeTag(declared) == ValueTypeTag.typeParameter and self.tagOf(box) == ValueTypeTag.genericInstance 'concreteTypeParamRead'
			self.retypeValue(result, valueType: self.signatures.adoptType(self.signatures.substitutedInstanceArg(self.valueNameId(box), position: typeNameIdOf(declared)), into: self.artifact.typeNames))
		end 'concreteTypeParamRead'

		// ⭐ **RECORD A BOXED-UNION-CANDIDATE FIELD READ**, so a THROW of it can MOVE it out of the container
		// (`emitThrowError` nulls this slot — shv2's only transfer for a borrowed error). Gated on the `named`
		// tag, which a boxed union carries (as do a ranged-int alias and a scalar enum — the throw path
		// filters those out via `throwsTypeIsBoxedUnion`); a scalar/String/struct field is not `named` and is
		// never a thrown error, so the common field read leaves this slot untouched.
		if maxonTypeTag(declared) == ValueTypeTag.named 'namedFieldRead'
			self.lastFieldReadValid = true
			self.lastFieldReadValue = result
			self.lastFieldReadBox = box
			self.lastFieldReadOffset = offset
		end 'namedFieldRead'

		return result
	end 'emitFieldLoad'

	// ⭐ **THE ONE `loadIndirect` EMIT** — and it now IS the one, which it was not when it first claimed
	// to be. A field read (`p.x`), a union tag load, a union payload read, a capturing closure's
	// env-slot read (`emitCaptureRead`), a String record's field (`emitLoadStringField`) and a global's
	// slot (`emitGlobalLoad`) all reach here. One op shape, so the value's SOURCE type (`declared`,
	// minted onto the tag column so a nested `match` or the shift rule reads what the source said) and
	// its STORAGE type (the concrete primitive the op carries, because `maxonTypeToStdType` panics on a
	// `named`) are split in exactly one place. See `emitFieldLoad`'s header for why the two differ.
	//
	// ⚠ **A CALLER THAT PASSES THE SAME TYPE TWICE IS STILL A CALLER, NOT AN EXCEPTION.** The String
	// record and the global do exactly that, each for its own stated reason — and each used to own a
	// raw `artifact.emitOp` instead, which is what made the claim above false. The hazard is not the
	// duplicated line; it is that the split between declared and storage would then have had two more
	// homes free to disagree with this one, with no compile error to say so.
	function emitIndirectLoad(declared MaxonType, box ValueId, offset ByteOffset, storageType MaxonType, range SourceRange) returns ValueId
		let result = self.mintValueOfType(declared)
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.loadIndirect(result, addr: box, offset: offset, valueType: storageType), range: range)
		return result
	end 'emitIndirectLoad'

	// `storeIndirect <box> <offset> <value>` — the one op a field write is, and the exact mirror of
	// `emitFieldLoad` (same offset, same storage type, same reason for each).
	//
	// **THE ONE STORE SITE**, shared by the two paths that write a field: the `Self{…}` loop filling
	// a fresh box (`emitStructLiteral`) and the assignment statement writing a live one
	// (`parseFieldAssignment`). They were one line apart from being two copies of the offset-and-
	// width derivation, which is the pair that must never disagree — a literal that stored `y` at
	// the width the layout says and an assignment that stored it at another would corrupt the box
	// silently.
	function emitFieldStore(box ValueId, layout StructLayout, index FieldIndex, value ValueId, range SourceRange)
		let declared = self.signatures.fieldTypeOf(layout.name, index: index, into: self.artifact.typeNames)
		self.emitIndirectStore(box, offset: layout.offsetOfField(index), value: value, storageType: self.fieldStorageType(declared), range: range)
	end 'emitFieldStore'

	// ⭐ **THE ONE `storeIndirect` EMIT**, the mirror of `emitIndirectLoad` above and true on the same
	// terms. A field write, a union tag store, a union payload store, a union's unused-slot zero-fill, a
	// capturing closure's env-slot fill (`buildClosureEnv`), a String record's field
	// (`emitStoreStringField`) and a global's slot (`emitGlobalStore`) all reach here — one op shape, so
	// the offset-and-width derivation a box's stores must agree on lives in one place (a literal storing
	// `y` at one width and an assignment storing it at another would corrupt the box silently — see
	// `emitFieldStore`).
	function emitIndirectStore(box ValueId, offset ByteOffset, value ValueId, storageType MaxonType, range SourceRange)
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.storeIndirect(box, offset: offset, value: value, valueType: storageType), range: range)
	end 'emitIndirectStore'

	// The CONCRETE `MaxonType` a SLOT holding a `declared`-typed value is accessed as — what the
	// `loadIndirect`/`storeIndirect` carries, and the only type in the compiler that says how wide
	// the access is.
	//
	// TWO kinds of slot ask it, and they are the same question: a struct/union FIELD, whose declared
	// type comes from the layout, and a capturing closure's ENV SLOT, whose declared type comes from
	// the captured binding. The name predates the second caller; it is left alone because four files
	// outside the parser cite it by name (`Project`, `TypeResolution`, `SignatureIndex`, `PLAN.md`).
	//
	// It resolves a `named` alias through `signatures.aliasOf`, the SAME whole-program door THE
	// SHIFT RULE already asks (`valueIsUnsigned`), for the same reason: an alias declared in another
	// file is still an alias here, and this file's own table would answer for neither it nor a
	// forward reference.
	//
	// ⚠ **IT IS THE SECOND STATEMENT OF "WHAT A `named` TYPE DENOTES", AND `TypeResolution.
	// resolveNamedType` IS THE FIRST.** That is not a duplication this rung introduced — it is the
	// standing shape of the two registries (see `ProgramSignatures.structTypes`): the sweep answers
	// the PARSER, the project registry answers the AUTHORITY, and the alias half has been written in
	// both places since ranged typealiases landed. What is new is that a slot's type has to be
	// resolved at PARSE time at all, and that is forced by the op: `resolveTypes` never rewrites an
	// op's type, so the parser is the last tier that can make it concrete.
	function fieldStorageType(declared MaxonType) returns MaxonType
		match declared 'kind'
			// Already concrete. `structRef` included — a struct FIELD is a pointer, and
			// `maxonTypeToStdType` gives it the machine word without help.
			boolean to float then return declared
			exitCode then return declared
			structRef then return declared
			unresolved then panic("fieldStorageType: a slot is declared `unresolved` — `parseTypeReference` produces only `named`, `structRef` and the three primitive keywords, and the one other producer of the sentinel is a VOID callee's result type, which `voidCallResultUsed` refuses to bind; so neither a field declaration nor a captured binding can carry one")
			// A String field stores an i64 POINTER, exactly like a struct-ref field — `maxonTypeToStdType`
			// gives it the machine word. A managed field IS now constructed (`moveInPayload`), and its
			// self-field READ loads through this same width.
			string then return declared
			// A FUNCTION-typed field (P1.5-A1) stores an i64 code POINTER, exactly like a struct/String
			// field — `maxonTypeToStdType`/`valueTagToStdType` give it the machine word. `emitFieldLoad`
			// functionizes a `named` function alias BEFORE this, so a function field arrives here concrete.
			function then return declared
			// A TYPE-PARAMETER field stores an opaque i64 and a GENERIC-INSTANCE field a struct POINTER
			// (P1.6-A) — both already concrete, so `maxonTypeToStdType` gives the machine word directly.
			// This is what a `b.value` read on `type Box uses T` loads through.
			typeParameter then return declared
			genericInstance then return declared
			named then break 'kind'
		end 'kind'

		let name = try self.artifact.typeNames.nameOf(typeNameIdOf(declared)) otherwise panic("fieldStorageType: a slot's named type has an id that is not in this file's interner — a field's type is adopted through `fieldTypeOf`, which re-interns into exactly this table, and a captured binding's was interned by this file's own `parseTypeReference`")
		match self.signatures.aliasOf(name, readerFilePath: self.filePath) 'alias'
			declared(alias) then return alias.underlying
			undeclared then break 'alias'
		end 'alias'

		// A declared enum/union field stores an i64 — a payload-free enum's value IS its i64 tag, and a
		// boxed-union field is an i64 POINTER to its box (P1.4b wave 2c). Both collapse to `integer`,
		// exactly as `TypeResolution.resolveNamedType` erases a declared enum/union to `integer`.
		if self.signatures.containsEnum(name) 'enumOrUnion'
			return MaxonType.integer
		end 'enumOrUnion'

		// A name NO file declares, or a `type` the sweep recorded but whose reference the parser typed
		// `named` rather than `structRef` (a field declared with its own struct's name is `structRef` and
		// never reaches here). The first is a user error — E3011, which `TypeResolution` reports against
		// the merged registry, the authority — and it is not this routine's to report: the sweep is the
		// tolerant half. Returning `integer` keeps the op well-formed for the instant before the
		// pipeline's error gate throws, exactly as `resolveNamedType`'s own recovery does.
		return MaxonType.integer
	end 'fieldStorageType'

	// ⭐ **THE SCALAR-VS-MANAGED PAYLOAD DECISION — the boundary of slice 1.** The concrete storage
	// type a union payload field of declared type `declared` occupies its 8-byte slot as, OR a clean
	// rejection of the types slice 1 cannot lower: a FLOAT (needs the bitcast ops a later rung adds)
	// and every MANAGED reference (String, struct, a boxed union — an owned heap pointer whose
	// move-in/drop is slice 2's ownership work). A SCALAR — `int`/`bool`, a ranged-int alias, or a
	// payload-FREE enum (whose value IS its i64 tag) — is stored inline and returned here.
	//
	// It is the payload twin of `fieldStorageType`, and it is a SEPARATE policy on purpose: a struct
	// FIELD may be a `structRef` (a struct holds a pointer to another struct, `sizeof` counts it as 8
	// bytes) and `fieldStorageType` returns it; a union PAYLOAD may not, because storing a managed
	// pointer without the incref/decref discipline slice 2 supplies would leak it or free it twice.
	// The rejection is deferred to HERE — the construct and extract sites — rather than the
	// declaration, exactly as a struct-typed field's is refused at its use site (`requireStructBase`)
	// and not where the field is declared: a rejection at declaration would `throw` in the tolerant
	// enum sweep and truncate the layout (see `readEnumCaseInto`'s payload arm).
	// The payload-rejection MESSAGES, one shape each, so the construct and extract sites report a refused
	// payload identically. They return the STRING, and each caller throws `ParseError.unsupported(…)`
	// INLINE — never `throw self.helperReturningAParseError(…)`, which LEAKS 2 allocations under the
	// C#-emitted refcount runtime: a freshly-owned union returned across a call and immediately re-thrown
	// is not reconciled (the family OPEN.md records for a `throw` of a call result and for the owned-value
	// ternary). Building the message via a call that returns a String and throwing the ParseError inline
	// is the non-leaking shape.
	function nestedUnionPayloadMessage(field PayloadField, layout EnumLayout, typeName String) returns String
		return "a payload field '{String.from(field.name)}' of type '{typeName}' on `{layout.kindWord()} {String.from(layout.name)}` — a nested payload-bearing union payload needs its own destructor cascade, which arrives at a later rung (String and struct payloads are supported)"
	end 'nestedUnionPayloadMessage'

	function floatPayloadMessage(field PayloadField, layout EnumLayout) returns String
		return "payload field '{String.from(field.name)}' on `{layout.kindWord()} {String.from(layout.name)}`: a `float` payload needs the bitcast ops a later rung adds (a scalar-only union is int-tagged)"
	end 'floatPayloadMessage'

	// A type-qualified numeric bound used as a VALUE (`let x = u16.max`, `if v == u64.max`).
	// The same three tokens a range declaration's endpoint is built from, resolved through
	// the same table — so `int(0 to u64.max)` and `v == u64.max` can never disagree about
	// what `u64.max` is. It materializes an ordinary integer literal.
	function parseTypeQualifiedBoundExpression() returns ValueId throws ParseError
		let boundTok = self.current()
		let value = try self.parseTypeQualifiedBound(false)
		return self.emitLiteral(value, valueType: MaxonType.integer, range: SourceRange.ofToken(boundTok))
	end 'parseTypeQualifiedBoundExpression'

	// Resolve a variable reference to the SSA value its binding aliases — M2's
	// value-substitution model emits NO load op; the reference simply IS the bound
	// value. A name with no local binding may still be a TOP-LEVEL CONSTANT (which inlines) or a
	// TOP-LEVEL `var` (which loads); only a name that is none of the three is a positioned parse
	// error (undefinedVariable).
	//
	// LOCAL FIRST. A local binding SHADOWS a top-level constant of the same name — `let OFFSET = 10`
	// at file scope and `let OFFSET = 2` inside a function means 2 in that function, which is what
	// every language with both scopes does and what the bootstrap does (its constants are consulted
	// only once a bare name has failed to resolve as a local).
	//
	// **CONSTANT BEFORE GLOBAL, and the order costs nothing**: the two are disjoint by construction —
	// one storage key holds ONE decl, and `constantValueOf`/`globalDeclFor` each answer only for
	// their own kind — so at most one of the two probes can ever hit. The order is readability, not
	// precedence.
	// ⚠ **A SELF-FIELD ALIAS IS TESTED BEFORE `lookupValue`, AND THE ORDER IS LOAD-BEARING RATHER
	// THAN TIDY.** An alias aliases no SSA value — a read of it is a `loadIndirect`, so there is
	// nothing for `boundValue` to hold and it is left 0. `lookupValue` would hand that 0 back as if
	// it were the answer, and ValueId 0 is the RECEIVER: `return count` inside a method would
	// silently compile to `return self`, reading a box pointer as an integer. A wrong answer with
	// no diagnostic anywhere.
	// ⭐ **IT ALSO PUBLISHES WHAT THE NAME RESOLVED TO, for the ONE consumer no ValueId can serve** —
	// `lastBareBindingImmutableName`, the E3019 blame name of a bare-identifier call ARGUMENT (see
	// `bareArgImmutableName`). Each arm that can answer sets it, through the same `immutableReceiverNameOf`
	// a receiver asks, so an argument and a receiver naming the same binding get the same verdict.
	function parseVariableReference() returns ValueId throws ParseError
		let tok = try self.consume(TokenKind.identifier)

		if self.scope.isSelfField(tok.value) 'selfField'
			// A self field's writability is the FIELD's own `var`/`let`, exactly as it is for a self-field
			// method receiver (`methodReceiverBinding`) — the receiver is a parameter and is never `mutable`.
			let binding = self.scope.getInfo(tok.value)
			let writable = try self.selfFieldIsWritable(binding, nameTok: tok)
			self.publishBareBindingName(tok, immutable: not writable)
			return try self.parseSelfFieldRead(tok, binding: binding)
		end 'selfField'

		// A LOCAL binding: reject a read of one that has been MOVED FROM through the shared liveness guard
		// (`requireBindingLive`), the SAME predicate the field/method base sites ask. This is the bare
		// READ site — a WRITE target routes through `parseAssignment`, which REVIVES the binding, so the
		// check must not run there. A name that is NOT a local (a top-level constant or `var`) is never
		// owned and never moved, so it stays on the original resolve path.
		if self.scope.contains(tok.value) 'local'
			let binding = self.scope.getInfo(tok.value)
			try self.requireBindingLive(binding, nameTok: tok)
			self.lastBareBindingImmutableName = self.immutableReceiverNameOf(binding, baseTok: tok)
			return binding.boundValue
		end 'local'

		// ⭐ **CAPTURE (P1.5-A2b).** The name is not one of the CLOSURE's own bindings (its scope, checked
		// above). If it resolves into an ENCLOSING function's scope it is a CAPTURE: `captureEnclosing`
		// records it in the current closure's capture set and returns the value read out of the env block
		// (one `loadIndirect` — capture is BY VALUE). Checked BEFORE the top-level fall-through so an
		// enclosing local that SHADOWS a same-named global is caught as the capture it is, not silently
		// resolved to the global (a wrong answer). Outside a closure `closureCaptureScopes` is empty and this
		// returns `notCaptured` after one `count()` read.
		//
		// ⚠ **THE SAME ORDER BINDS A METHOD RECEIVER, WHICH IS THE SAME NAME IN THE SAME POSITION.** It is
		// re-encoded in `parseMethodCall`'s arms and in `methodCallsAt`'s membership tests, because neither
		// can route through this function (one needs a receiver binding, the other a side-effect-free bool).
		// `parseMethodCall` had them the other way round until the P1.7-slice-2a review and carries the
		// measurement of what that cost; a change here is a change there.
		// A CAPTURE publishes nothing, so it reads "writable" — capture is BY VALUE (`loadIndirect` out of
		// the env block), and writing through the loaded copy does not reach the enclosing binding. A
		// captured managed CONTAINER, whose value IS the shared record, is refused outright at this rung
		// (`capturedStructBase` admits only a struct), so the case the answer would matter for cannot arise.
		match try self.captureEnclosing(tok) 'capture'
			captured(value) then return value
			notCaptured then break 'capture'
		end 'capture'

		return try self.topLevelBindingReference(tok)
	end 'parseVariableReference'

	// Publish the blame name of the bare identifier just resolved, or clear it when the binding may be
	// written through — the one shape the arms that do not hold a `VarInfo` (a self field, a top-level
	// binding) use to reach `lastBareBindingImmutableName`'s "empty is writable" convention.
	function publishBareBindingName(tok Token, immutable bool)
		self.lastBareBindingImmutableName = tok.value if immutable else EmptySourceText
	end 'publishBareBindingName'

	// ⭐ **CAPTURE AN ENCLOSING BINDING INTO THE CLOSURE'S ENVIRONMENT (P1.5-A2b) — the real env handling
	// that replaces A2a's E2015 refusal.** A name is a capture iff it resolves into one of the enclosing
	// scopes a closure body is nested in (`closureCaptureScopes`) — an enclosing local or parameter.
	// References to GLOBALS, top-level `let`/`var`, other FUNCTIONS, and the closure's OWN parameters are NOT
	// captures (none lives in an enclosing `Scope`), so they fall through as `notCaptured`.
	//
	// ⭐⭐ **CAPTURE IS BY VALUE — a thesis-forced divergence from v1 / the bootstrap's by-REFERENCE model.**
	// v1 stores the ADDRESS of each captured stack slot (`sys.stackAddr`) and reads a capture through TWO
	// indirect loads, so a read sees later mutations of the captured `var`. shv2 has NO addressable stack
	// slots — locals are SSA values in registers, there is no `stackAddr` and no mem2reg — so the env stores
	// the captured VALUE and a read is ONE `loadIndirect`. The corpus captures only immutable `let`s, so the
	// two models AGREE on every test; a captured-then-mutated `var` would differ, and no test exercises that.
	//
	// The env slot is assigned in first-seen order and DEDUPED by name (a capture read twice occupies one
	// slot); the enclosing binding's value + type are recorded now, read after the body parse by
	// `parseClosureExpression` to fill the env. The capture read loads through the reserved `__env` parameter
	// (`closureEnvParamId`). A capture from a NON-immediate enclosing frame (a nested capturing closure) needs
	// an env chain this slice does not build, so it is refused cleanly (E2015 → A2b-2).
	function captureEnclosing(tok Token) returns CaptureResult throws ParseError
		match try self.captureScopeOf(tok) 'scope'
			found(enclosing) then return CaptureResult.captured(try self.emitCaptureRead(tok, enclosing: enclosing))
			notCaptured then return CaptureResult.notCaptured
		end 'scope'
	end 'captureEnclosing'

	// Does `tok` resolve to a CAPTURE — a binding in any enclosing scope this closure body is nested in? A
	// cheap membership predicate that neither emits a capture nor raises the nested-frame error (the actual
	// capture through `captureScopeOf` does both). Used by `parseDottedPrimary` to route `capturedStruct.field`
	// to field access. False outside a closure (`closureCaptureScopes` empty).
	function captureBinds(tok Token) returns bool
		for enclosing in self.closureCaptureScopes 'each'
			if enclosing.contains(tok.value) 'bound'
				return true
			end 'bound'
		end 'each'
		return false
	end 'captureBinds'

	// ⭐ **THE CAPTURE-SCOPE WALK (P1.5-A2b) — the ONE place that answers "is this name a capture, and from
	// which enclosing frame?"** Shared by the bare read (`captureEnclosing`) and the field/method base
	// (`resolveFieldChain`/`methodBaseCapture`), so they cannot disagree about what is captured. Walks the
	// enclosing scopes innermost-first — a name resolves to the nearest scope that binds it, exactly as an
	// ordinary lookup would (`popScope`'s shadowing rules), so the FIRST hit walking down is the capture
	// source. A hit in a NON-immediate enclosing frame is a nested capturing closure, refused cleanly (the env
	// chain this slice does not build). Outside a closure `closureCaptureScopes` is empty and this returns
	// `notCaptured` after one `count()` read.
	function captureScopeOf(tok Token) returns CaptureScopeResult throws ParseError
		let depth = self.closureCaptureScopes.count()
		var i = depth
		while i > 0 'eachEnclosing'
			i = i - 1
			let enclosing = try self.closureCaptureScopes.get(i) otherwise panic("captureScopeOf: closureCaptureScopes.get OOB at {i}")
			if enclosing.contains(tok.value) 'captured'
				if i != depth - 1 'nested'
					throw ParseError.unsupported("a closure that captures a variable from a non-immediate enclosing frame (nested capturing closures — P1.5-A2b-2)", line: tok.line, column: tok.column)
				end 'nested'
				return CaptureScopeResult.found(enclosing)
			end 'captured'
		end 'eachEnclosing'

		return CaptureScopeResult.notCaptured
	end 'captureScopeOf'

	// Assign (or reuse) the env slot for a captured name and emit its BY-VALUE read: `loadIndirect __env,
	// slot*8`. The slot column (`captureNames`) is env-array order; the parallel `captureValues`/`captureTypes`
	// carry the enclosing value to store and the type to read back, filled in lockstep on FIRST sight only so
	// a name captured twice shares one slot and one env store.
	function emitCaptureRead(tok Token, enclosing Scope) returns ValueId throws ParseError
		let binding = enclosing.getInfo(tok.value)

		// ⭐⭐ **A SELF-FIELD ALIAS IS NOT A CAPTURABLE BINDING — IT HOLDS NO VALUE, AND `boundValue` 0 IS THE
		// RECEIVER.** `createSelfField` leaves `boundValue` 0 because a read of the alias is a `loadIndirect`
		// through the receiver; capturing it therefore stored the enclosing method's `self` BOX in the env
		// slot and handed it back as the field. MEASURED: `apply(function(k int) gives k + n, x: 1)` inside a
		// method of a `type Counter{ var n as int }` holding 3 compiled clean and returned **25** — the box
		// pointer, low byte — where the answer is 4, with no diagnostic anywhere. With `n` declared through a
		// ranged alias the same capture instead PANICKED in lowering, because the env slot's type is filled
		// from `binding.varType` at parse time and a `named` reaches `maxonTypeToStdType` unresolved. One
		// defect, two faces.
		//
		// It is the SAME refusal the explicit spelling already gets, through the same wire format: reading a
		// field by bare name needs the receiver, so it IS a capture of `self`, and `self.n` inside a closure
		// is refused in as many words. This is the THIRD reader of `boundValue` that took 0 for a real id —
		// `dispatchMethodOnBinding` and `builtinConformanceReceiverValue` were the other two, and the census
		// says it is the last: every other reader either guards on `isSelfField` first (`receiverOwnerMask`),
		// is reached only where the alias was already refused (`requireStructBase`'s struct-typed-FIELD arm),
		// or cannot see an alias at all (`parseVariableReference`'s local arm runs under `not isSelfField`;
		// `consumedArgName` and the move/alias searches scan `ownedBindings`, which a `trivial`-ownership
		// alias never joins).
		//
		// ⚠ `requireNotInSelfCapture` ALWAYS throws here — `captureScopeOf` answers `found` only while
		// `closureCaptureScopes` is non-empty, so a capture read is by construction inside a closure body.
		// The DECISION is `isSelfField`; the shared routine is called for its one sentence, not its predicate.
		if binding.isSelfField 'capturedSelfField'
			try self.requireNotInSelfCapture(tok)
		end 'capturedSelfField'

		// ⭐ **DECLARED vs STORAGE, at an env slot.** `captureType` is what the SOURCE said, and it is
		// what the read's value is minted as — a ranged INT alias stays `named` on purpose, because its
		// NAME is what carries the signedness `valueIsUnsigned` reads (a captured `int(0 to u64.max)`
		// must still `shr` zero-filling), and `resolveFloatAliasType` has already collapsed the one
		// alias whose VALUE is a different machine class. The OP, though, carries a WIDTH, and a `named`
		// reaches `maxonTypeToStdType` unresolved — so the slot's type goes through `fieldStorageType`,
		// the same door a struct field's width comes from and the same one `buildClosureEnv`'s store
		// asks. That the two ask ONE routine is the invariant, not a tidiness: a slot filled at one
		// width and read at another corrupts the environment silently.
		let captureType = self.resolveFloatAliasType(binding.varType)
		let slot = self.captureSlotFor(tok.value, enclosingValue: binding.boundValue, captureType: captureType)
		return self.emitIndirectLoad(captureType, box: self.closureEnvParamId, offset: envSlotOffset(slot), storageType: self.fieldStorageType(captureType), range: SourceRange.ofToken(tok))
	end 'emitCaptureRead'

	// The env slot for `name`, appending a fresh one (recording the enclosing value + type to store) on first
	// sight and reusing it thereafter. Dedup keeps `multiple-captures` (`x + a + b`) at one slot per distinct
	// name and, more importantly, keeps a name read twice from storing — and later dropping — two slots.
	function captureSlotFor(name ByteArray, enclosingValue ValueId, captureType MaxonType) returns EnvSlotIndex
		for k in 0 upto self.captureNames.count() 'existing'
			let seen = try self.captureNames.get(k) otherwise panic("captureSlotFor: captureNames.get OOB at {k}")
			if seen == name 'reuse'
				return k
			end 'reuse'
		end 'existing'
		self.captureNames.push(name)
		self.captureValues.push(enclosingValue)
		self.captureTypes.push(captureType)
		return self.captureNames.count() - 1
	end 'captureSlotFor'

	// A bare name that is not a local: a top-level constant, a top-level `var`, or nothing.
	//
	// A top-level CONSTANT is a `let`, so it is immutable wherever it is read — and for a MANAGED one that
	// is not a formality: `let G = "hi"` materializes the ONE immortal `.rdata` record every read of those
	// bytes shares, so a callee that appended through it would write read-only memory (measured: exit 139,
	// where the oracle raises E3019). It publishes its name for the same reason a `let` local does.
	function topLevelBindingReference(tok Token) returns ValueId throws ParseError
		match self.signatures.constantValueOf(tok.value, readerFilePath: self.filePath) 'constant'
			found(payload, tag) then return self.recordImmutableConstantRead(tok, value: self.emitLiteral(payload, valueType: constantValueType(tag), range: SourceRange.ofToken(tok)))
			foundManaged(bytes, kind) then return self.recordImmutableConstantRead(tok, value: try self.emitManagedConstant(bytes, kind: kind, range: SourceRange.ofToken(tok)))
			notFound then break 'constant'
		end 'constant'

		return try self.topLevelGlobalRead(tok)
	end 'topLevelBindingReference'

	// Publish a top-level constant read's blame name and hand the value straight back —
	// `recordGlobalReadValue`'s shape, for its reason: the two arms above differ only in how the value is
	// materialized, and a `let` is immutable in both.
	function recordImmutableConstantRead(tok Token, value ValueId) returns ValueId
		self.publishBareBindingName(tok, immutable: true)
		return value
	end 'recordImmutableConstantRead'

	// ⭐ **A USE OF A TOP-LEVEL MANAGED CONSTANT MATERIALIZES ITS LITERAL** (P1.7a) — the managed twin of
	// the `literal`-op inline directly above, and the same storage model: the declaration reserves
	// nothing, and the READ is where the value comes from.
	//
	// It emits the very ops the literal itself emits, so a managed constant's storage class is the one
	// its literal already has and shv2 grows NO second immortality mechanism (the oracle's
	// `MmImmortalRefcount` sentinel is deliberately not imported — see `ARCHITECTURE.md`):
	//
	//   • a **String** literal is a wholly IMMORTAL `.rdata` record (`lowerStringLiteral`), and
	//     `registerRdataConstant` dedupes it by bytes — so every read of `let name = "Ada"` in the whole
	//     program shares ONE record, materialized once, never allocated and never freed. This is exactly
	//     "materialized once, shared by every read, immortal", reached with no new mechanism at all.
	//   • a **byte string** literal is an owned `Array with Byte` RECORD over an immortal `.rdata` BLOB
	//     (`lowerByteStringLiteral`). The payload is still materialized once and shared — the blob dedupes
	//     by bytes — but the 48-byte record is heap and per-read, because an Array is a MUTABLE container
	//     whose record its own methods rewrite (a `push` detaches the buffer by writing `buffer@0`,
	//     `capacity@16` and `length@8`), and a `.rdata` record cannot be written. Making the RECORD
	//     immortal too needs two things shv2 does not have — enforcement that a `let`-bound array is never
	//     mutated, and a real COPY promotion for `var b = <borrowed array>` (which today increfs the box,
	//     and an rdata box has no refcount word to incref). Both are named in OPEN.md; neither is invented
	//     here, because a SECOND immortality mechanism is precisely what this design exists to avoid.
	function emitManagedConstant(bytes ByteArray, kind ManagedConstKind, range SourceRange) returns ValueId throws ParseError
		return match kind 'k'
			string gives self.emitStringLiteral(bytes, range: range)
			byteArray gives try self.emitByteStringLiteralValue(bytes, range: range)
		end 'k'
	end 'emitManagedConstant'

	// ⭐ **A USE OF A TOP-LEVEL CONSTANT INLINES ITS VALUE, AND THAT IS THE WHOLE STORAGE MODEL.**
	//
	// The constant was folded to a number by the declaration sweep, so the reference materializes as
	// an ordinary `literal` op carrying it — indistinguishable, from here down, from a program that
	// wrote the number out. Nothing is loaded, no `.data` slot is reserved, no relocation is emitted
	// and no backend knows this feature exists: `return ANSWER` compiles to exactly what `return 42`
	// compiles to.
	//
	// Both reference compilers do precisely this. v1 rewrites the read op in place into a `literal`
	// (`rewriteUnresolvedRead`, TypeResolution.maxon:2915-2925) and its `.data` emitter walks
	// `topLevelVars` only — a constant is in a different map and the emitter never sees it. The
	// bootstrap mints a fresh literal per use (`EmitConstantLiteral`, 2-Parser.cs:16870-16900), whose
	// comment says it outright: "a top-level `let` reaches expression position already folded, as a
	// literal". Storage is what a top-level `var` needs, and that is P1.0d.5b.
	//
	// It goes through `emitLiteral`, so an inlined INTEGER constant lands in the parser's constant
	// column (`recordConst`) exactly as a written-out literal does — which is what keeps `let SHIFT =
	// 1` … `x shl SHIFT` folding, and THE SHIFT RULE seeing a count it can check.
	//
	// **A TOP-LEVEL `var` IS THE OTHER HALF OF THAT STORY, AND IT IS THE OPPOSITE ONE** — see
	// `topLevelGlobalRead` directly below. It is what P1.0d.5b added: the read that does NOT
	// disappear.

	// ⭐ **A USE OF A TOP-LEVEL `var` LOADS FROM ITS `.data` SLOT.** The exact inverse of a
	// constant's read: nothing is folded, a slot IS reserved, a relocation IS emitted, and the
	// backend very much knows this feature exists.
	//
	// It emits the GENERAL PAIR — `globalAddr` then `loadIndirect` — rather than a fused
	// `globalLoad`, per the Std memory band's contract: the same two ops a struct field (P1.1) and a
	// heap value (P1.2) read through. The address op is its own value, so a function that reads one
	// global twice materializes the address twice and the ordinary CSE that arrives with the Std
	// optimization passes will fold them — `globalAddr` declares `isPure: true` precisely so that it
	// can.
	//
	// ⚠ The load is NOT hoisted out of a loop that writes the same global, and that is not this
	// function's doing — it is `loadIndirect`'s `isPure: false` (see StdDialect). Get that wrong and
	// this emits perfectly correct IR that a later pass silently breaks.
	function topLevelGlobalRead(tok Token) returns ValueId throws ParseError
		match self.signatures.globalDeclFor(tok.value, readerFilePath: self.filePath) 'global'
			// A read itself does not care whether the slot may be WRITTEN — it borrows the occupant either
			// way. What the MUTABILITY decides is whether the borrowed value may later become a mutable
			// ALIAS, which is `recordGlobalReadValue`'s business (P1.7 slice 2b).
			found(label, valueType, mutable) then return self.recordGlobalReadValue(tok, value: self.emitGlobalLoad(label, valueType: valueType, range: SourceRange.ofToken(tok)), mutable: mutable)
			notFound then return try self.emitFunctionRef(tok)
		end 'global'
	end 'topLevelGlobalRead'

	// Mark a global read that came out of an IMMUTABLE slot, and hand the value straight back (P1.7 slice 2b).
	// It is only the READ path that marks: a receiver load (`parseMethodCall`'s stored-binding arm) is
	// consumed by the dispatch on the spot, where `noteReceiverWrite` already refuses a write through
	// an immutable binding, and it can never reach a `var`'s initializer.
	function recordGlobalReadValue(tok Token, value ValueId, mutable bool) returns ValueId
		// The blame name rides the same mutability answer (a top-level `let` refuses a write through it
		// exactly as a `let` local does), published here so the constant and the slot-backed halves of a
		// top-level read reach `lastBareBindingImmutableName` through one decision each.
		self.publishBareBindingName(tok, immutable: not mutable)

		if mutable 'writableSlot'
			return value
		end 'writableSlot'

		self.markImmutableGlobalRead(value)
		return value
	end 'recordGlobalReadValue'

	// ⭐⭐ **THE ONE WRITER OF `immutableGlobalReads`** — the read that mints a mark and the merge that
	// PROPAGATES one both come through here (P1.7 slice 2b), because the copy-on-write off the shared empty
	// set is the half of this that is dangerous to write twice: a second insert site that skipped the
	// identity test would insert into `sharedEmptyImmutableGlobalReads` itself, and that value is MODULE
	// level and shared across the per-file parse fan-out — every other function in every other file would
	// then see a mark naming an unrelated value in its own SSA space, and a program would be refused for a
	// binding it never wrote. One home makes that unwritable rather than merely unwritten.
	function markImmutableGlobalRead(value ValueId)
		if self.immutableGlobalReads is sharedEmptyImmutableGlobalReads 'stillShared'
			self.immutableGlobalReads = ImmutableGlobalReadSet.create()
		end 'stillShared'

		self.immutableGlobalReads.insert(value)
	end 'markImmutableGlobalRead'

	// ⭐ **A BARE FUNCTION NAME USED AS A VALUE → a `functionRef`** (P1.5-A1), the last resort a name
	// falls to after it is not a local, a self-field, a top-level constant or a `var`. It is what makes
	// `let f = double`, `apply(triple, x: 10)` and `return double` bind a function VALUE — a code pointer.
	//
	// It resolves through the WHOLE-PROGRAM signature index, so a FORWARD reference (a function declared
	// LATER in the file, the `.forward-reference-*` cases) resolves here at parse time exactly as a
	// backward one does — the sweep recorded every declaration before any file was parsed, which is the
	// shv2 thesis (no `unresolvedRead` placeholder, no TypeResolution rewrite pass). A name NO file
	// declares as a function is a genuine undefined variable (E2004), the answer this path used to give
	// unconditionally.
	//
	// A THROWING function is refused here (E3101): a function type has no throws clause, so the binding
	// would drop it and `indirectCall` has no error channel to carry it back. Refused at the point the
	// name becomes a value, with the callee's `throws E` type named.
	//
	// The value's type is `function(intern(name))` — the FUNCTION's own name governs its signature, which
	// is how an indirect call on it (`f(21)`) recovers the return type (`returnTypeOf(name)`).
	function emitFunctionRef(tok Token) returns ValueId throws ParseError
		match self.signatures.returnTypeOf(tok.value, into: self.artifact.typeNames) 'callee'
			declared then break 'callee'
			undeclared then throw ParseError.undefinedVariable(String.from(tok.value), line: tok.line, column: tok.column)
		end 'callee'

		match self.signatures.throwsOf(tok.value) 'throwsClause'
			throwing(errorType) then throw ParseError.throwingFunctionAsValue(String.from(tok.value), errorType: errorType, line: tok.line, column: tok.column)
			none then break 'throwsClause'
		end 'throwsClause'

		let result = self.mintValue(ValueTypeTag.function, nameId: self.artifact.typeNames.intern(tok.value))
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.functionRef(result, funcName: tok.value), range: SourceRange.ofToken(tok))
		return result
	end 'emitFunctionRef'

	// ⭐ **PARSE A CLOSURE LITERAL, LIFTING A NON-CAPTURING ONE TO A TOP-LEVEL FUNCTION (P1.5-A2a).**
	//
	// `function(p1 T1, p2 T2) gives <expr>` is an anonymous function written inline. A closure that
	// captures NOTHING is semantically a plain function reference — it binds no environment to the
	// enclosing frame — so it lifts to an ordinary top-level function `<enclosing>$closure_<k>` and yields
	// the SAME `functionRef` value A1 mints for a named function. Everything downstream (the indirect-call
	// lowering, `funcAddr` → `leaRegFunc`/`callReg`) is then A1's, unchanged — this rung adds NO IR op and
	// NO backend path. A closure that captures an enclosing local is refused (A2b); the DETECTION is built
	// here as the seam (`parseVariableReference`/`parseSelfPrimary` check `closureCaptureScopes`).
	//
	// The body parses into a FRESH function context — its own scope, value numbering, blocks and type
	// columns — swapped in around the parse and restored verbatim after, so the enclosing function's parse
	// is undisturbed. The lift is v1's `parseClosure` (Parser.maxon:17203) shorn of its env/capture
	// machinery (`closureCreate`/`closureEnvLoad`/`__env`), which is A2b's; the state save/restore is v1's,
	// adapted to shv2's field set (its `currentFunc`/`inClosure`/`closureOuterScope` become the swapped
	// per-function columns plus the `closureCaptureScopes` stack, and the `funcCount()`-keyed ValueOrigin
	// needs the `currentFuncIndex` re-stamp that v1's index model did not).
	function parseClosureExpression(func IrFunction) returns ValueId throws ParseError
		let functionTok = try self.consume(TokenKind.function)
		try self.consume(TokenKind.leftParen)

		// Parse the parameters through the shared `parseFunctionParameters` — `name Type` pairs, the
		// no-default rule and the reserved-name check all apply identically. (The ARGUMENT-COUNT ceiling is
		// NOT among them and deliberately so: only a caller knows how many hidden slots its own ABI adds, so
		// each asks `requireAbiParamCount` itself — see that routine's header.) `_` is
		// a legal identifier the check accepts (the corpus's `function(_ Integer) gives …`). An UNTYPED
		// parameter (`function(p) gives …`) is a separate feature — its type is inferred from the call-arg
		// slot at TypeResolution — and the A2a corpus types every one, so `parseTypeReference` rejecting the
		// `,`/`)` that follows an omitted type is the correct interim refusal.
		var paramNames = ByteArrayArray.create()
		var paramTypes = MaxonTypeArray.create()
		var paramRanges = SourceRangeArray.create()
		try self.parseFunctionParameters(paramNames, paramTypes: paramTypes, paramRanges: paramRanges)
		try self.consume(TokenKind.rightParen)
		// A struct parameter is re-tagged `structRef` here, exactly as `parseFunction` does — the whole-program
		// struct registry is complete in the real parse (see `resolveNamedStruct`).
		paramTypes = self.resolveNamedStructAll(paramTypes)
		// The lifted closure's ABI count is its own parameters PLUS the trailing `__env` slot reserved below —
		// so the ceiling is asked of `+ 1`. Asked HERE rather than in the shared `parseFunctionParameters` for
		// the reason `requireAbiParamCount`'s header gives: only the caller knows how many hidden slots its own
		// ABI adds, and a check that did not would be the weak second count all over again.
		//
		// ⚠⚠ AND IT IS ASKED **BEFORE** THE CONTEXT SAVE BELOW, WHICH IS A HARD REQUIREMENT, NOT AN ORDERING
		// PREFERENCE. Each of the ~25 `savedX` locals ALIASES the field it was read from — one object, two
		// names, no incref — until that field is re-pointed at a fresh object. A call that can THROW while an
		// alias is live gives the enclosing frame a failure edge through it, and the drop the throw edge owes
		// for the alias releases an object the field still holds. Placed there, this check made every closure
		// program die compiling with `mm_decref: refcount underflow` inside `__destruct_Parser` — a compiler
		// crash, on programs with SIX parameters, from a check about sixty-five.
		//
		// ⛔ **THE PROTECTED WINDOW IS FIRST SAVE → LAST REASSIGNMENT, *NOT* SAVE → RESTORE.** Getting that
		// boundary right is the whole of the rule, and the two are not the same span: `bindParameters`,
		// `parseExpression` and `emitOwnedValueReturn` all sit between the saves and the restore and all
		// throw — they MUST, since that is how a syntax error inside a closure body is reported. They are
		// safe because by then every managed field has been re-pointed (`self.scope = Scope.create()` and
		// the block below it), so each `savedX` uniquely owns its object and the throw edge releases it
		// exactly once. **So: add nothing that can throw between the first `let savedX =` and the last
		// `self.X =` of that block — and when adding a new saved field, put its reassignment inside that
		// block rather than after the parse.** The fields with no reassignment (`lastFieldRead*`,
		// `closureEnvParamId`, `artifact.currentFuncIndex`) are scalars: copying one aliases nothing.
		try requireAbiParamCount(paramNames.count() + 1, anchor: functionTok)
		let givesTok = try self.consume(TokenKind.gives)

		// The lifted name — `<enclosing>$closure_<k>`. `$` is unwritable in a Maxon identifier, so the name
		// can collide with no user function, alias, or OTHER closure (the counter is per enclosing
		// function). Post-increment so sibling closures get 0, 1, 2, … in source order.
		let k = func.closureSubCounter
		func.closureSubCounter = k + 1
		let closureName = "{String.from(func.name)}$closure_{k}".toByteArray()

		// --- Switch into the lifted function's own parse context. Every per-function column is captured
		//     here and restored verbatim below; the closure gets fresh ones so the enclosing function's SSA
		//     numbering, scope, drop sets and blocks are untouched. ---
		let savedScope = self.scope
		let savedValueIds = self.valueIds
		let savedMutableVars = self.mutableVars
		let savedLoops = self.loops
		let savedCurrentBlock = self.currentBlock
		let savedValueTags = self.valueTags
		let savedValueNameIds = self.valueNameIds
		let savedValueConsts = self.valueConsts
		let savedValueConstKnown = self.valueConstKnown
		let savedValueOwnsHeap = self.valueOwnsHeap
		let savedValuePromiseMarks = self.valuePromiseMarks
		let savedOwnedBindings = self.ownedBindings
		let savedPendingTempDrops = self.pendingTempDrops
		// The last-field-read record is ONE fact spread over FOUR fields, and ALL FOUR are saved/restored as
		// a unit — not `lastFieldReadValid` alone. The closure body opens with `lastFieldReadValid = false`,
		// but if it reads a `named` field it overwrites `lastFieldReadValue`/`Box`/`Offset` with ids in the
		// CLOSURE's SSA space; restoring only `Valid` would leave the enclosing function believing its live
		// field read is a value/box the CLOSURE numbered. The mechanism's whole safety argument (an equal
		// value id can only have come from this exact `(box, offset)`) holds only WITHIN one function's SSA
		// numbering, which a nested closure breaks — so a `throw <named field>` after the closure could
		// mis-fire `moveOutThrownField` on a wrong slot (a closure id that collides with an enclosing one).
		let savedLastFieldReadValid = self.lastFieldReadValid
		let savedLastFieldReadValue = self.lastFieldReadValue
		let savedLastFieldReadBox = self.lastFieldReadBox
		let savedLastFieldReadOffset = self.lastFieldReadOffset
		let savedInMatchArmBody = self.inMatchArmBody
		let savedFuncIndex = self.artifact.currentFuncIndex
		// The two closure columns and the capture-collection set are per-function and per-CLOSURE, so they
		// swap with the rest of the context — a nested closure collects its own captures without disturbing
		// the enclosing closure's.
		let savedValueIsCapturingClosure = self.valueIsCapturingClosure
		let savedValueClosureEnv = self.valueClosureEnv
		let savedValueInstanceAlias = self.valueInstanceAlias
		let savedImmutableGlobalReads = self.immutableGlobalReads
		let savedCaptureNames = self.captureNames
		let savedCaptureValues = self.captureValues
		let savedCaptureTypes = self.captureTypes
		let savedClosureEnvParamId = self.closureEnvParamId

		let paramCount = paramNames.count()
		// ⭐ **RESERVE THE TRAILING `__env` PARAMETER'S ValueId UP FRONT (P1.5-A2b).** A capturing closure
		// receives its environment as a trailing parameter (`closureEnvParamId = paramCount`), and every
		// capture read loads through it — so its id must be fixed BEFORE the body parses, which is BEFORE we
		// know whether the closure captures. So the slot is always reserved: value numbering starts at
		// `paramCount + 1` and the value columns carry one extra entry for it. Whether the closure actually
		// captures is settled AFTER the body parse (`captureNames` non-empty), and only then is the reserved
		// slot promoted to a real parameter (`lifted.paramCount` patched). A non-capturing closure leaves the
		// slot an unused hole — no op references it, so it is dead and the lifted body is A2a-identical.
		//
		// A FRESH scope (not `scope.reset()`) so the enclosing one survives in `savedScope` to be restored;
		// every other per-body column is re-created exactly as `parseFunction` re-creates it (a stray entry
		// carried into the closure body would name a value in the ENCLOSING body's SSA space). This mirrors
		// `parseFunction`'s reset rather than sharing a helper with it: extracting the reassignments into a
		// method that stores into ~11 aliased `self` array-fields tripped a bootstrap ownership crash
		// (`mm_decref` in the compiler itself), so the two copies stay inline and the reviewer's
		// duplication note is answered here rather than by a helper the bootstrap cannot compile.
		self.scope = Scope.create()
		self.valueIds = ValueIdRef.create((paramCount + 1) as ParamCount)
		self.mutableVars = VarInfoArray.create()
		self.ownedBindings = VarInfoArray.create()
		self.pendingTempDrops = ValueIdArray.create()
		self.lastFieldReadValid = false
		self.loops = LoopContextArray.create()
		// ⚠ Balanced by construction — pushed and popped around each `for` body — EXCEPT on the error path,
		// where a `ParseError` thrown inside a body skips the release. So the reset is real; it points back
		// at the shared empty rather than allocating (see `sharedEmptyIterationLocks`).
		self.iterationLockedBindings = sharedEmptyIterationLocks
		self.valueTags = ValueTypeTagArray.create()
		self.valueNameIds = TypeNameIdArray.create()
		self.valueConsts = ParsedIntArray.create()
		self.valueConstKnown = BoolArray.create()
		self.valueOwnsHeap = BoolArray.create()
		self.valuePromiseMarks = BoolArray.create()
		self.valueIsCapturingClosure = BoolArray.create()
		self.valueClosureEnv = ValueIdArray.create()
		self.valueInstanceAlias = sharedEmptyInstanceAliasMap
		self.immutableGlobalReads = sharedEmptyImmutableGlobalReads
		self.captureNames = ByteArrayArray.create()
		self.captureValues = ValueIdArray.create()
		self.captureTypes = MaxonTypeArray.create()
		self.closureEnvParamId = paramCount
		self.inMatchArmBody = false
		// The enclosing scope becomes a CAPTURE scope for the duration of the body — a body name resolving
		// into it (an enclosing local/param/self-field, not the closure's own params) is a capture. Pushed
		// here, popped just before the restore.
		self.closureCaptureScopes.push(savedScope)

		// Seed the closure's value-type columns with its parameter types (ids 0..paramCount-1), exactly as
		// `parseFunction` seeds a function's, so `tagOf(param)` answers the operators before any op runs. A
		// float-alias parameter is lifted to a genuine `float` tag (`resolveFloatAliasType`), the same care.
		for paramType in paramTypes 'seedParamTypes'
			self.recordValueType(self.resolveFloatAliasType(paramType))
		end 'seedParamTypes'
		// The reserved `__env` slot (ValueId `paramCount`) gets its own column entry — an i64 heap pointer —
		// so the columns stay indexable by every ValueId whether or not the closure ends up capturing.
		self.recordValueType(MaxonType.integer)

		// The lifted function, created with a PLACEHOLDER return type and its NON-capturing signature (the
		// user parameters only). If the body captures, `paramCount`/`maxonParamTypes` are patched below to
		// carry the trailing `__env`. File-private (a closure is never callable across files by name), and it
		// NEVER throws (the closure grammar has no throws clause).
		var lifted = IrFunction.create(closureName, maxonReturnType: MaxonReturnType.value(MaxonType.unresolved), paramCount: paramCount, maxonParamTypes: paramTypes, valueTags: self.valueTags, valueNameIds: self.valueNameIds, valueClosureEnv: self.valueClosureEnv, valueIsCapturingClosure: self.valueIsCapturingClosure, returnLine: givesTok.line)
		lifted.namespace = self.namespace
		lifted.visibility = Visibility.file
		lifted.sourceFilePath = self.filePath
		lifted.nameLine = functionTok.line
		lifted.nameColumn = functionTok.column

		// Push up front — reserving the closure's index AFTER the enclosing function's (which was pushed at
		// its own start) — and re-stamp `currentFuncIndex` so the body's value origins file under the
		// closure, not the enclosing function.
		let closureIndex = self.artifact.module.funcCount()
		self.artifact.module.pushFunc(lifted)
		self.artifact.setCurrentFuncIndex(closureIndex)

		let entry = self.artifact.module.addBlockAt(lifted, label: b"entry", filePath: self.filePath.toString(), firstLine: givesTok.line)
		self.currentBlock = entry

		try self.bindParameters(closureName, paramNames: paramNames, paramTypes: paramTypes, paramRanges: paramRanges)

		// Parse the single body expression, then close the lifted function like a value `return`: the body
		// IS the closure's returned value, so `emitOwnedValueReturn` promotes a borrowed String to owned and
		// drains the (single-expression body's) drop sets, exactly as `parseReturnStatement` does. This is
		// what materializes a bare-string-literal body — shv2's `stringLiteral` already emits a backing op,
		// so unlike v1 the `ret` never references an unbound value, and the promotion makes it an owned
		// return the caller can drop (`closure-capture.string-literal-body`).
		let bodyValue = try self.parseExpression(lifted, block: entry)
		let bodyType = self.typeOf(bodyValue)
		try self.emitOwnedValueReturn(bodyValue, anchor: givesTok)

		// Did the body capture? Snapshot the collected set before it is restored away.
		let captureCount = self.captureNames.count()
		let capturedValuesSnapshot = self.captureValues
		let capturedTypesSnapshot = self.captureTypes
		// ⭐ **PROMOTE THE RESERVED `__env` SLOT TO A REAL TRAILING PARAMETER — ALWAYS (P1.5-A2b-2).** Under the
		// uniform `(userargs, env)` ABI EVERY function value is called through the SAME indirect signature, so a
		// lifted closure's own type must be `(userargs, __env) -> R` whether or not it captures — on wasm the
		// `call_indirect` functype is derived from the ARG COUNT (userargs + env), and the table element's own
		// functype must match. A NON-capturing closure never reads the slot (its body has no capture load), so the
		// param is inert there, but its presence keeps the closure's functype uniform with a capturing one and with
		// a plain function's `__fnref_` thunk. `emitParams` (lowering) reads `paramCount`/`maxonParamTypes`, so a
		// patch here is seen.
		lifted.paramCount = (paramCount + 1) as ParamCount
		var liftedParamTypes = MaxonTypeArray.create()
		for pt in paramTypes 'copyUserParams'
			liftedParamTypes.push(pt)
		end 'copyUserParams'
		liftedParamTypes.push(MaxonType.integer)
		lifted.maxonParamTypes = liftedParamTypes
		// Give the `__env` param a source origin (its declaring `function` keyword) so the register-pressure
		// diagnostic can resolve it, exactly as `bindParameters` records one per user parameter.
		self.artifact.recordParamOrigin(paramCount, range: SourceRange.ofToken(functionTok))

		// Patch the return type now the body is known, and register the lift so it is callable (module +
		// project signature registries) and its return type is resolvable at an indirect call through a
		// closure-bound local (`closureReturns`, read by `functionValueReturnType`). The signature keeps the
		// USER parameters only — an indirect call is positional and never slot-validates against it, and the
		// `__env` is a lowering-level detail the caller supplies from `valueClosureEnv`, not a source arg.
		let returnType = MaxonReturnType.value(bodyType)
		lifted.maxonReturnType = returnType
		self.artifact.recordFuncReturnType(closureName, returnType: returnType)
		let paramAggregateNames = self.paramAggregateNamesOf(paramTypes)
		self.artifact.recordFuncSignature(closureName, signature: FuncSignature.create(paramNames, paramTypes: paramTypes, paramAggregateNames: paramAggregateNames), nameLine: functionTok.line, nameColumn: functionTok.column, sourceFilePath: self.filePath)
		self.closureReturns.upsert(closureName, value: returnType)

		// --- Restore the enclosing function's parse context. ---
		_ = try self.closureCaptureScopes.pop() otherwise panic("parseClosureExpression: closureCaptureScopes underflow — the enclosing scope pushed at entry is missing")
		self.scope = savedScope
		self.valueIds = savedValueIds
		self.mutableVars = savedMutableVars
		self.loops = savedLoops
		self.currentBlock = savedCurrentBlock
		self.valueTags = savedValueTags
		self.valueNameIds = savedValueNameIds
		self.valueConsts = savedValueConsts
		self.valueConstKnown = savedValueConstKnown
		self.valueOwnsHeap = savedValueOwnsHeap
		self.valuePromiseMarks = savedValuePromiseMarks
		self.ownedBindings = savedOwnedBindings
		self.pendingTempDrops = savedPendingTempDrops
		// Restore the whole last-field-read record, not just its `Valid` flag — see the save block: the
		// closure body may have overwritten the value/box/offset with its own SSA ids.
		self.lastFieldReadValid = savedLastFieldReadValid
		self.lastFieldReadValue = savedLastFieldReadValue
		self.lastFieldReadBox = savedLastFieldReadBox
		self.lastFieldReadOffset = savedLastFieldReadOffset
		self.inMatchArmBody = savedInMatchArmBody
		self.artifact.setCurrentFuncIndex(savedFuncIndex)
		self.valueIsCapturingClosure = savedValueIsCapturingClosure
		self.valueClosureEnv = savedValueClosureEnv
		self.valueInstanceAlias = savedValueInstanceAlias
		self.immutableGlobalReads = savedImmutableGlobalReads
		self.captureNames = savedCaptureNames
		self.captureValues = savedCaptureValues
		self.captureTypes = savedCaptureTypes
		self.closureEnvParamId = savedClosureEnvParamId

		// In the ENCLOSING function's value space now: mint the closure VALUE — a `function`-tagged code
		// pointer governed by the lifted name — and emit the `functionRef` A1 lowers to `funcAddr`.
		let result = self.mintValue(ValueTypeTag.function, nameId: self.artifact.typeNames.intern(closureName))
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.functionRef(result, funcName: closureName), range: SourceRange.ofToken(functionTok))

		// A NON-capturing closure IS `emitFunctionRef`'s value: a bare code pointer, done. A CAPTURING one
		// additionally allocates its environment here in the ENCLOSING frame and marks the value, so every
		// in-frame call reads `valueClosureEnv` and passes the env as the trailing `__env` arg.
		if captureCount > 0 'buildEnv'
			self.buildClosureEnv(result, captureCount: captureCount, capturedValues: capturedValuesSnapshot, capturedTypes: capturedTypesSnapshot, anchor: functionTok)
		end 'buildEnv'

		return result
	end 'parseClosureExpression'

	// ⭐ **BUILD A CAPTURING CLOSURE'S ENVIRONMENT (P1.5-A2b), in the enclosing frame.** The env is a real
	// `__mm_alloc(captureCount * EnvSlotBytes)` heap block carrying each captured value BY VALUE (one
	// `storeIndirect` per capture, matching the `loadIndirect` the body reads through `__env`). It owns
	// NOTHING — the captures are copies of the enclosing frame's values, borrowed for the closure's lifetime —
	// so it takes the trivial destructor (`emitBoxAlloc`) and, tagged `integer`, its drop routes to the plain
	// `__mm_decref` (`decrefCalleeFor`), a single free with no cascade.
	//
	// ⭐⭐ **THE ENV IS ENROLLED AS AN ANONYMOUS OWNED BINDING, not a statement-scoped pending temp** — so it
	// drops at the SCOPE that created the closure, exactly once, via the ordinary `emitScopeDrops` machinery
	// (the same `ownedBindings.push` a temporary match scrutinee uses). A closure bound OUTSIDE a loop lands
	// its env at function scope → dropped once at the return, alive across every iteration
	// (`-bound-outside-loop-called-inside`); one REBOUND inside the loop body lands its env in the loop-body
	// frame → dropped on each back edge, five allocated and five freed (`-rebound-in-loop`). A pending temp
	// would free it at the end of the `let f = …` statement — before the first call — so the scope-scoped
	// binding is load-bearing, not a stylistic choice.
	function buildClosureEnv(closureValue ValueId, captureCount EnvSlotIndex, capturedValues ValueIdArray, capturedTypes MaxonTypeArray, anchor Token)
		let range = SourceRange.ofToken(anchor)
		let size = self.emitLiteral((captureCount * EnvSlotBytes) as ParsedInt, valueType: MaxonType.integer, range: range)
		let env = self.emitBoxAlloc(size, resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: range)

		for i in 0 upto captureCount 'storeEach'
			let capValue = try capturedValues.get(i) otherwise panic("buildClosureEnv: capturedValues.get OOB at {i} — filled in lockstep with captureNames")
			let capType = try capturedTypes.get(i) otherwise panic("buildClosureEnv: capturedTypes.get OOB at {i} — filled in lockstep with captureNames")

			// The WIDTH comes from `fieldStorageType` and the OFFSET from `envSlotOffset`, because
			// `emitCaptureRead` reads the slot back through those same two — and `capType` is the
			// SOURCE type it recorded, which for a ranged alias is `named` and has no width of its own.
			self.emitIndirectStore(env, offset: envSlotOffset(i), value: capValue, storageType: self.fieldStorageType(capType), range: range)
		end 'storeEach'

		self.markValueOwnsHeap(env)
		self.ownedBindings.push(VarInfo.createValueBinding(EmptySourceText, varType: MaxonType.integer, mutable: false, boundValue: env))
		self.markCapturingClosure(closureValue, env: env)
	end 'buildClosureEnv'

	// `globalAddr <label>` then `loadIndirect <addr> 0` — the two ops a global's read is.
	//
	// OFFSET 0, ALWAYS: each global is its OWN labelled slot, so the label already names the exact
	// address and there is nothing to add to it. The offset field is not dead weight — it is what
	// P1.1's `point.x` will carry, through this same op.
	//
	// ⭐ **A MANAGED GLOBAL'S LOAD IS A BORROW** (P1.7 slice 2a): the result is the record's ADDRESS, and
	// the `.data` slot keeps owning it, so the value is minted WITHOUT `markValueOwnsHeap` and nothing
	// drops it. That is not an omission — a scope-exit drop of a borrowed global would free the program's
	// only copy while the slot still points at it, and the cleanup after `main` would then double-free.
	//
	// ⚠ **THE SLOT'S DECLARED AND STORAGE TYPES COINCIDE, AND THAT IS A PROPERTY OF A GLOBAL, NOT A
	// SHORTCUT.** Elsewhere the two differ and `fieldStorageType` bridges them (a `named` ranged alias
	// has no width of its own); a global's type is INFERRED FROM ITS INITIALIZER and so is never `named`
	// — `ProgramSignatures.mixValueTag` panics on a `named`-tagged top-level binding for exactly this
	// reason, and `var g = 5 as Word` collapses to `integer` before it gets here. So `valueType` is
	// already concrete and is passed as both.
	function emitGlobalLoad(label ByteArray, valueType MaxonType, range SourceRange) returns ValueId
		let addr = self.emitGlobalAddr(label, range: range)
		return self.emitIndirectLoad(valueType, box: addr, offset: GlobalSlotOffset, storageType: valueType, range: range)
	end 'emitGlobalLoad'

	// `globalAddr <label>` then `storeIndirect <addr> 0 <value>` — a global's write, the mirror of
	// `emitGlobalLoad`. It defines no value: a store is a statement.
	function emitGlobalStore(label ByteArray, valueType MaxonType, value ValueId, range SourceRange)
		let addr = self.emitGlobalAddr(label, range: range)
		self.emitIndirectStore(addr, offset: GlobalSlotOffset, value: value, storageType: valueType, range: range)
	end 'emitGlobalStore'

	// The `globalAddr` half both a read and a write open with. A POINTER, so its value is typed
	// `integer` — the Maxon tier has no pointer type today, and an address is a machine word; the
	// Std tier it lowers into is typeless anyway, and nothing dispatches on this value's tag (it is
	// read only by the load/store that follows).
	function emitGlobalAddr(label ByteArray, range SourceRange) returns ValueId
		let addr = self.mintValue(ValueTypeTag.integer, nameId: UnnamedTypeId)
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.globalAddr(addr, label: label), range: range)
		return addr
	end 'emitGlobalAddr'

	// --- The top-level constant evaluator (P1.0d.5a) ---
	//
	// ⭐ **ONE GRAMMAR, TWO OUTPUTS.** Below is a second walk over the same expression syntax
	// `parseBinary` walks — and it is the minimum irreducible duplication of this rung, so it is worth
	// being exact about what is and is not shared.
	//
	// SHARED, because every one of them is a DECISION: the precedence table (`infixPrecedence`), the
	// operator maps (`infixMaxonOp`, `infixCmpOp`, `comparisonOperator`), the operand rules
	// (`requireBinOpOperands`), the result types (`binOpResultTag`, `wordOpResultTag`), the folds
	// (`foldIntBinOp`, `foldIntUnaryOp`, `foldIntCompare`, `foldLogicalNot`), THE SHIFT RULE
	// (`shiftFillsWithSign` → `shiftOpcodeFor` → `evalShift`), the `not` reading (`notOperatorFor`),
	// the cursor, the literal decoders, and the bound table. A constant expression and a runtime one
	// therefore cannot come to MEAN different things — which is the failure that matters, because
	// `let X = 1 shl 64` folding to 1 while `x shl 64` computes 0 is a silent wrong answer, not a
	// compile error.
	//
	// NOT SHARED: the climb loop itself, because the two produce different things. `parseBinary`
	// EMITS OPS and yields a `ValueId`; this yields a NUMBER. They cannot be one function, and the
	// reason is not the return type — it is `and`/`or`. Over bools those are CONTROL FLOW in a
	// function body (`emitShortCircuit` mints blocks and a merge phi, and the phi is by construction
	// not a constant), while a top-level `let BOTH = true and true` must be the value `true`. The op
	// path is *right* to branch and this path is *right* to fold, so the fork is real. Both reference
	// compilers keep the same two walks for the same reason (2-Parser.cs's `EvalConstOr` ladder;
	// v1's `evaluateUnresolvedConstExpr`).
	//
	// The evaluator lives on `Parser` because everything it reads is a Parser's: the token cursor,
	// `intLiteralValue`, `parseTypeQualifiedBound`, `decodeCharLiteral`. It is driven from
	// `ProgramSignatures.walkConstInitializer`, which builds a throwaway Parser per declaration and
	// keeps the ARENA and the recursion. It emits no ops and touches no artifact.

	// Fold one declaration's initializer to its value. The cursor is seated on the recorded token
	// range, and the walk must consume ALL of it — see `requireInitializerConsumed`.
	//
	// ⭐ **A MANAGED LITERAL IS THE WHOLE INITIALIZER OR IT IS NOT A CONSTANT AT ALL** (P1.7a). The
	// split is made HERE, once, on the token range — never inside the fold — and that is what keeps
	// this ONE mechanism rather than v1's four. v1 dispatches a top-level initializer into four
	// structurally different implementations chosen by the RHS's syntax (`Parser.maxon:3251-3347`): a
	// const-folded string rematerialized at every read, an eagerly-built array in a synthesized
	// `__module_init_<n>`, the same again for `T.from`, and a LAZILY-built struct behind a first-read
	// guard. Here there is one arena, one memoized DFS, one outcome union and one use-site inline; a
	// managed constant differs from a scalar one in exactly what its VALUE is (bytes, not a number).
	//
	// The runnable oracle makes the same split at the same place and for the same reason — its
	// `IsComplexInitializer` (2-Parser.cs:2101-2143) routes a bare managed literal away from the scalar
	// evaluator before a single operator is read.
	export function evalConstInitializer(decl TopLevelDecl, stack TopLevelDeclIndexArray) returns ConstInitializerValue throws ConstEvalError
		self.pos = decl.initStart

		// ⚠ **ONE TOKEN IS THE WHOLE MANAGED TEST, and that is what keeps an INTERPOLATION out.** The
		// lexer splits `"a{x}b"` into `stringLiteral("a") stringInterpStart … stringInterpEnd
		// stringLiteral("b")`, so an interpolated string is never one token: it falls to the scalar walk,
		// which rejects it — correctly, since its value is a heap String built from a runtime expression
		// and no constant at all. The same test turns away `"a" as T` and every other trailing form, each
		// of which would need a rule this slice does not have.
		//
		// The two arms are written out HERE rather than behind a probe that answers "which kind?",
		// because that probe's answer is a union and this walk runs once per top-level binding in the
		// program: it would be a heap box per declaration, allocated only to be matched on one line
		// later. The token test IS the kind test, read once.
		if decl.initEnd == decl.initStart + 1 'singleTokenInitializer'
			if self.at(TokenKind.stringLiteral) 'stringLiteral'
				return ConstInitializerValue.managed(try self.decodeConstStringLiteral(self.consumeManagedLiteral()), kind: ManagedConstKind.string)
			end 'stringLiteral'
			if self.at(TokenKind.byteStringLiteral) 'byteStringLiteral'
				let byteStringTok = self.consumeManagedLiteral()
				try self.requireConstByteStringBlobStridesLikeItsType(byteStringTok)

				return ConstInitializerValue.managed(try self.decodeConstByteStringLiteral(byteStringTok), kind: ManagedConstKind.byteArray)
			end 'byteStringLiteral'
		end 'singleTokenInitializer'

		// ⭐ **AN ARRAY LITERAL IS THE THIRD ANSWER, AND IT IS DECIDED ON THE OPENING TOKEN** (P1.7 slice
		// 2b). It cannot ride the single-token test above — `[1, 2]` is five tokens — and it must not fall
		// to the scalar walk, whose `evalConstPrimary` has no `[` and would report `Expected expression but
		// got '['` (which is what it did before this slice, in every position). Unlike the two literal arms,
		// it is followed by `requireInitializerConsumed`: the walk stops at the closing `]`, so a trailing
		// `var xs = [1, 2] junk` would otherwise be silently truncated to `[1, 2]`.
		if self.at(TokenKind.leftBracket) 'arrayLiteralInitializer'
			let array = try self.evalConstArrayLiteral(stack)
			try self.requireInitializerConsumed(decl)

			return array
		end 'arrayLiteralInitializer'

		let value = try self.evalConstBinary(stack, minPrec: OrPrecedence)
		try self.requireInitializerConsumed(decl)

		return ConstInitializerValue.scalar(value)
	end 'evalConstInitializer'

	// ⭐ **`[e0, e1, …]` AT TOP LEVEL — the constant twin of `parseArrayLiteral`**, and the same three rules
	// read off the same grammar: an EMPTY literal has no element type to infer, the FIRST element fixes the
	// element type, and every later element must match it. What differs is only what the walk produces —
	// folded VALUES here, ops there — which is the fork `evalConstInitializer`'s header states for the whole
	// evaluator. The two REJECTIONS are worded once and shared (`MixedArrayLiteralElementsMessage`) or
	// deliberately not (`EmptyConstArrayLiteralMessage` — see there).
	//
	// ⚠ **NO OWNERSHIP BOOKKEEPING, and that is a property of the position rather than an omission.** A
	// literal in a function body must move each element into the array (poisoning a bare local, de-listing an
	// owned temp) because its elements can be values something else already owns. A top-level initializer's
	// elements are CONSTANTS — there is no binding to poison and no temp to de-list — so the only thing that
	// carries over is that a String element must reach the array OWNED, which `ModuleInit` does by cloning
	// the literal exactly as `moveElementIntoArray` promotes a borrowed one.
	function evalConstArrayLiteral(stack TopLevelDeclIndexArray) returns ConstInitializerValue throws ConstEvalError
		let openTok = try self.consumeConst(TokenKind.leftBracket)
		self.skipNewlines()
		if self.at(TokenKind.rightBracket) 'empty'
			throw ConstEvalError.defective(ParseError.unsupported(EmptyConstArrayLiteralMessage, line: openTok.line, column: openTok.column))
		end 'empty'

		var elements = ConstArrayElementArray.create()
		let first = try self.evalConstArrayElement(stack)
		let element = constArrayElementKindOf(first)
		elements.push(first)

		// A newline at each element boundary, exactly as the body walk allows one (`finishArrayLiteral`) — a
		// multi-line literal is the same literal, and the two positions must not disagree about that.
		self.skipNewlines()
		while self.at(TokenKind.comma) 'moreElements'
			try self.consumeConst(TokenKind.comma)
			self.skipNewlines()
			let elemTok = self.current()
			let elem = try self.evalConstArrayElement(stack)
			if constArrayElementKindOf(elem) != element 'mixed'
				throw ConstEvalError.defective(ParseError.unsupported(MixedArrayLiteralElementsMessage, line: elemTok.line, column: elemTok.column))
			end 'mixed'
			elements.push(elem)
			self.skipNewlines()
		end 'moreElements'
		try self.consumeConst(TokenKind.rightBracket)

		return ConstInitializerValue.arrayLiteral(elements, element: element)
	end 'evalConstArrayLiteral'

	// ONE element of a top-level array literal: a STRING literal, or anything the scalar evaluator folds to
	// an integer. The managed/scalar split is `evalConstInitializer`'s, applied between two separators —
	// a String element is exactly one token, so `["a{x}b"]` (several tokens) and `["a" as T]` fall to the
	// scalar walk and are rejected there, which is what they are.
	//
	// A non-integer SCALAR is refused here rather than silently stored: `[true, false]` folds perfectly well
	// and would then be built as an `Array with Integer` of 1s and 0s, which is not the type the program
	// wrote. shv2 rejects a bool element in a function body too (`arrayLiteralInstanceFor`), so this is the
	// same boundary at the same width — a top-level literal must never accept more than a body does.
	function evalConstArrayElement(stack TopLevelDeclIndexArray) returns ConstArrayElement throws ConstEvalError
		if self.at(TokenKind.stringLiteral) and self.arrayElementIsSingleToken(self.pos) 'stringElement'
			return ConstArrayElement.string(try self.decodeConstStringLiteral(self.consumeManagedLiteral()))
		end 'stringElement'

		let tok = self.current()
		let value = try self.evalConstBinary(stack, minPrec: OrPrecedence)
		if value.tag != ValueTypeTag.integer 'notAnInteger'
			throw ConstEvalError.defective(ParseError.unsupported("a top-level array literal element of type '{typeTagName(value.tag)}' — a constant array's elements are integers or String literals", line: tok.line, column: tok.column))
		end 'notAnInteger'

		return ConstArrayElement.integer(value.payload)
	end 'evalConstArrayElement'

	// Is the element STARTING at `index` exactly one token — i.e. is the next SIGNIFICANT token the `,` or `]`
	// that ends it? The element-level twin of `evalConstInitializer`'s `initEnd == initStart + 1`, and it is
	// there for the identical reason: one token is the whole managed test, so an interpolation (several tokens)
	// and every trailing form stay out of the String arm and reach the walk that rejects them.
	//
	// ⭐ **BOTH array-literal walks ask it, and they ask the SAME question about DIFFERENT token kinds** — the
	// top-level one about a `"…"` (is this element a bare String literal?), the body one about an int literal
	// (is this element a bare integer, so the record may be created before it is evaluated?). Each caller has
	// already matched the kind; what neither can settle alone is whether the token is the WHOLE element, and
	// that is this. A second copy of it would be a second answer to "where does an element end".
	function arrayElementIsSingleToken(index TokenIndex) returns bool
		let after = self.kindAt(self.indexPastNewlines(index + 1))
		return after == TokenKind.comma or after == TokenKind.rightBracket
	end 'arrayElementIsSingleToken'

	// Take the managed-literal token the caller has just recognized and step past it. It cannot be
	// `consumeConst(kind)`: the caller has already matched the kind, and this is used in ARGUMENT
	// position, where a two-statement read-then-advance cannot be written inline.
	function consumeManagedLiteral() returns Token
		let tok = self.current()
		self.advance()
		return tok
	end 'consumeManagedLiteral'

	// ⭐ The two decoders below are the ones the EXPRESSION path uses (`decodeEscapes`,
	// `decodeByteStringLiteral`), so a literal means the same thing in a `let` as it does in a function
	// body — the property the scalar evaluator's header states for numbers, applied to bytes. Each is
	// wrapped for the evaluator's error type, for `consumeConst`'s reason: a `ParseError` raised here is
	// a defect in THIS initializer and must be recorded on its declaration, not thrown at whatever file
	// happens to be parsing.

	function decodeConstStringLiteral(tok Token) returns ByteArray throws ConstEvalError
		match decodeEscapes(tok.value) 'decoded'
			bytes(buf) then return buf
			unknownEscape(text) then throw ConstEvalError.defective(ParseError.unsupported("the escape sequence '{text}' in a string literal is not a recognized escape", line: tok.line, column: tok.column))
		end 'decoded'
	end 'decodeConstStringLiteral'

	function decodeConstByteStringLiteral(tok Token) returns ByteArray throws ConstEvalError
		return try decodeByteStringLiteral(tok.value, tok: tok) otherwise (err) 'rejected'
			throw ConstEvalError.defective(err)
		end 'rejected'
	end 'decodeConstByteStringLiteral'

	// ⚠ A PARTLY-FOLDED INITIALIZER IS AN ERROR, NOT A TRUNCATION. The walk stops at the first token
	// it cannot fold; without this check the rest of the line is silently DISCARDED and the constant
	// quietly becomes whatever the prefix came to. It is the one failure mode the token-range model
	// has that a tree model does not, and the bootstrap guards it in the same place and words
	// (`ExpectConstInitializerFullyConsumed`, 2-Parser.cs:4979-4987).
	function requireInitializerConsumed(decl TopLevelDecl) throws ConstEvalError
		if self.pos >= decl.initEnd 'fullyConsumed'
			return
		end 'fullyConsumed'

		let tok = self.current()
		throw ConstEvalError.defective(ParseError.nonConstantInitializer(String.from(decl.name), leftover: self.tokenTextFrom(self.pos, endIndex: decl.initEnd), line: tok.line, column: tok.column))
	end 'requireInitializerConsumed'

	// The source text of a token range, as the diagnostic prints it. Space-joined rather than
	// reconstructed from byte offsets: this is a COLD path (a rejected program), and the tokens are
	// what the evaluator actually choked on.
	//
	// ⚠ **A TOKEN'S `value` IS ITS LEXEME ONLY WHERE THE KIND DOES NOT ALREADY IMPLY ONE.** The lexer
	// fills it for identifiers and literals and leaves it EMPTY for punctuation and keywords, whose
	// spelling is `TokenKind.rawValue` (the same text `consume` puts in a mismatch). Reading `value`
	// alone therefore printed NOTHING for a leftover made of punctuation — `var xs = [1]]` and
	// `var a = 1)` both reported `''`, a diagnostic that promises to name the text it could not
	// evaluate and then names nothing at all.
	function tokenTextFrom(start TokenIndex, endIndex TokenIndex) returns String
		var text = ""
		for i in start upto endIndex 'each'
			let tok = self.tokenAt(i)
			if i > start 'separator'
				text = "{text} "
			end 'separator'

			let spelling = tok.kind.rawValue if tok.value.isEmpty() else String.from(tok.value)
			text = "{text}{spelling}"
		end 'each'

		return text
	end 'tokenTextFrom'

	// The precedence-climbing core, mirroring `parseBinary`'s shape over values instead of ops. It
	// reads the SAME precedence table, so `1 + 2 * 3` is 7 in a constant for the same reason it is 7
	// in a function.
	function evalConstBinary(stack TopLevelDeclIndexArray, minPrec InfixPrecedence) returns ConstValue throws ConstEvalError
		var left = try self.evalConstUnary(stack)

		while true 'climb'
			let opTok = self.current()
			let prec = infixPrecedence(opTok.kind)
			if prec == NotAnInfixOperator or prec < minPrec 'stop'
				break
			end 'stop'

			self.advance()
			let rhsStart = self.pos
			let right = try self.evalConstBinary(stack, minPrec: prec + 1)
			left = try self.foldConstBinOp(left, right: right, opTok: opTok, countStart: rhsStart)
		end 'climb'

		return left
	end 'evalConstBinary'

	// Apply one binary operator to two constants, under the very rules the emitting path applies.
	//
	// **`and`/`or`/`xor` NEED NO SPECIAL CASE HERE, AND THAT IS NOT LUCK.** A bool's payload IS 0 or 1
	// (TypeRules' `BoolTrueValue`), so the BITWISE fold of two bools is already the LOGICAL answer —
	// `1 and 1` is 1, `0 or 1` is 1 — and `wordOpResultTag` supplies the `boolean` tag that says which
	// reading it was. The bootstrap writes the two readings out separately (`lhs is bool lb && rhs is
	// bool rb ? lb && rb : ll & rl`, 2-Parser.cs:4997-5031) and computes the identical answer both
	// ways. What is lost by folding rather than branching is only the ELISION, and a constant has no
	// side effect to elide.
	function foldConstBinOp(left ConstValue, right ConstValue, opTok Token, countStart TokenIndex) returns ConstValue throws ConstEvalError
		if comparisonOperator(opTok.kind) 'comparison'
			try self.requireConstComparable(left, right: right, opTok: opTok)
			let cmpOp = infixCmpOp(opTok.kind)

			// A float comparison folds with the host's native f64 (`foldFloatCompare`), NEVER over the
			// raw bit patterns: two negatives order opposite to their patterns, so an integer compare of
			// `-1.0 > -2.0` would answer backwards. Both operands are float here — `requireConstComparable`
			// rejects a mixed int/float compare — so `operandsAreFloat` true means BOTH sides carry bits.
			if operandsAreFloat(left.tag, right: right.tag) 'float'
				return ConstValue.create(foldFloatCompare(cmpOp, lhs: left.payload, rhs: right.payload), tag: ValueTypeTag.boolean)
			end 'float'

			return ConstValue.create(foldIntCompare(cmpOp, lhs: left.payload, rhs: right.payload), tag: ValueTypeTag.boolean)
		end 'comparison'

		let op = infixMaxonOp(opTok.kind)
		try self.requireConstOperands(op, left: left, right: right, opTok: opTok)

		if shiftOperator(op) 'shift'
			return try self.foldConstShift(left, count: right, op: op, countStart: countStart)
		end 'shift'

		// Float arithmetic (`+ - * /`) folds with the host's native f64 (`foldFloatBinOp`), an INT
		// operand of a mixed `1 + 2.0` first PROMOTED to its f64 value (`constFloatBits`). `mod` and the
		// bit ops are integral-only, so `requireConstOperands` has already turned a float away from them
		// above — a float pair here is always one of the four SSE-backed operators, and its result is
		// always a `float` (`arithResultTag` promotes), so the tag is not re-asked of `binOpResultTag`.
		if operandsAreFloat(left.tag, right: right.tag) 'float'
			match foldFloatBinOp(op, lhs: self.constFloatBits(left), rhs: self.constFloatBits(right)) 'f'
				folded(value) then return ConstValue.create(value, tag: ValueTypeTag.float)
				// A float `/ 0`. shv2's own `divsd` yields ±inf/nan at run time, but a CONSTANT folds with
				// the host's f64 — which faults on `/ 0` — and this rung does no software IEEE, so the
				// constant is rejected. A DOCUMENTED divergence from the runtime, and its OWN message
				// rather than the integer `constantDivisionByZero` one, whose "no run time to trap in"
				// would tell a user who expected inf the wrong story (a float `/0` does not trap).
				notFoldable then throw ConstEvalError.defective(ParseError.unsupported("`/` by zero in a float constant initializer: a constant is folded with the host's f64, which faults on division by zero (shv2's own float division would yield an infinity or NaN at run time), so the constant has no value", line: opTok.line, column: opTok.column))
			end 'f'
		end 'float'

		match foldIntBinOp(op, lhs: left.payload, rhs: right.payload) 'folded'
			folded(value) then return ConstValue.create(value, tag: binOpResultTag(op, left: left.tag, right: right.tag))
			// `foldIntBinOp` declines exactly one family here — a division or modulo whose answer is a
			// TRAP rather than a number (`1 / 0`, `i64.min / -1`); the shifts it also declines are
			// handled above (`shiftOperator`). A runtime `x / 0` panics, but a top-level constant has no
			// run time to panic IN: it is folded before the program exists, so there is no answer to
			// give and no later pass that could give one.
			notFoldable then throw ConstEvalError.defective(ParseError.constantDivisionByZero(opTok.kind.rawValue, line: opTok.line, column: opTok.column))
		end 'folded'
	end 'foldConstBinOp'

	// ⭐ **THE COMPILE-TIME `cvtsi2sd`** — the f64 BIT PATTERN of a constant the parser is holding, and the
	// CONSTANT half of the `TypeRules.widensIntToFloat` obligation (its SSA half is `promoteToFloat`). A
	// float carries its bits already; an INT is promoted to its f64 value first, so `1 + 2.0` folds to 3.0
	// and not to a summed bit pattern, and a `as float = 3` field default fills its slot with 3.0 rather
	// than with eight bytes of two's complement. `0.0 + payload` is the host's own int→f64 conversion;
	// `floatToBits` captures the result.
	//
	// Idempotent, exactly as `promoteToFloat` is, so neither caller — the float FOLD or the field DEFAULT —
	// has to work out which side it is holding.
	function constFloatBits(value ConstValue) returns ParsedInt
		if tagIsFloat(value.tag) 'alreadyFloat'
			return value.payload
		end 'alreadyFloat'

		return __Builtins.floatToBits(0.0 + value.payload)
	end 'constFloatBits'

	// ⭐ THE SHIFT RULE, asked of a constant. Every part of the answer comes from TypeRules — the fill,
	// the opcode, the legality of the count, and the fold — so a shift in a `let` and a shift in a
	// function body cannot disagree. `1 shl 64` is 0 in both, and `1 shl -1` is E2054 in both.
	//
	// `leftOperandIsUnsigned` is FALSE, and asked rather than assumed. A top-level constant carries no
	// ranged type — its initializer is a bare expression and shv2 infers `int` or `bool`, nothing else
	// — so its left operand is signed by construction. The rule is still routed through
	// `shiftFillsWithSign` so that the day a constant CAN be unsigned, this answers it the same way
	// the expression parser does instead of having quietly hard-coded the fill. The bootstrap makes
	// exactly this call, and says so at 2-Parser.cs:5062-5068.
	function foldConstShift(left ConstValue, count ConstValue, op MaxonBinOp, countStart TokenIndex) returns ConstValue throws ConstEvalError
		if shiftCountIsNegative(count.payload) 'negative'
			let anchor = self.shiftCountAnchor(countStart, countEnd: self.pos)
			throw ConstEvalError.defective(ParseError.shiftCountNegative(count.payload, line: anchor.line, column: anchor.column))
		end 'negative'

		let shiftOp = shiftOpcodeFor(op, signFills: shiftFillsWithSign(op, leftOperandIsUnsigned: false))

		// The TAG is ASKED of `binOpResultTag` — the same decider, handed the same rewritten opcode,
		// that `emitShift`'s `emitBinOp` asks — and not restated as a literal `integer` here. It
		// answers `integer` for every shift today, so this is not a bug being fixed; it is the second
		// decider not being created. `emitShortCircuit` records what restating one costs: a word
		// operator's result type ended up with one decider per path and nothing making them agree,
		// and the day the rule moves, the path that ASSERTS goes on asserting. A wrong tag is not a
		// compile error, it is a wrong answer at whatever reads the tag next.
		return ConstValue.create(evalShift(left.payload, count: count.payload, op: shiftOp), tag: binOpResultTag(shiftOp, left: left.tag, right: count.tag))
	end 'foldConstShift'

	// A comparison's operands must AGREE — the same class-strict rule `emitCompare` enforces, asked of
	// the same `typesAgree`, and reported under the same code and text.
	// The COMPARISON rule, asked of two constants — `comparableOperands`, the same decider
	// `emitCompare` asks, so `let X = 3.5 > 2` and `f > i` in a body cannot come to disagree about
	// whether a float may be compared with an int. It used to ask `typesAgree`, which admits the
	// pair (float and int agree, and must), and so would have folded the mixed compare that the
	// expression path rejects.
	function requireConstComparable(left ConstValue, right ConstValue, opTok Token) throws ConstEvalError
		if comparableOperands(left.tag, right: right.tag) 'comparable'
			return
		end 'comparable'

		throw ConstEvalError.defective(ParseError.comparisonTypeMismatch(typeTagName(left.tag), right: typeTagName(right.tag), line: opTok.line, column: opTok.column))
	end 'requireConstComparable'

	// Every other binary operator's operand rule, asked of `requireBinOpOperands` — the one classifier
	// the emitting path asks. It throws a `ParseError`; the evaluator's failures are wrapped, so the
	// two paths reject `let X = 4 + true` and `y = 4 + true` with the identical diagnostic.
	function requireConstOperands(op MaxonBinOp, left ConstValue, right ConstValue, opTok Token) throws ConstEvalError
		try requireBinOpOperands(op, left: left.tag, right: right.tag, opTok: opTok) otherwise (err) 'rejected'
			throw ConstEvalError.defective(err)
		end 'rejected'
	end 'requireConstOperands'

	// A prefix `-` or `not`, mirroring `parseUnary` over values. Both readings of `not` come from
	// `notOperatorFor`, so a constant `not` complements exactly what a runtime `not` complements.
	function evalConstUnary(stack TopLevelDeclIndexArray) returns ConstValue throws ConstEvalError
		if self.at(TokenKind.minus) 'neg'
			let opTok = self.current()
			self.advance()

			// ⭐ A leading `-` on a FLOAT LITERAL is part of the literal — a sign flip (`negatedFloatBits`),
			// NOT `0.0 - x`, which would lose `-0.0`'s sign. This mirrors `parseUnary`'s negated-literal
			// fold and shares the ONE sign-flip spelling, so `-2.5` means the same in a `let` and a body.
			// Trailing `as` casts then apply exactly as to a primary (as `parseCast` wraps `parseUnary`).
			if self.at(TokenKind.floatLiteral) 'negatedFloatLiteral'
				let tok = self.current()
				self.advance()
				return try self.applyConstCasts(try self.evalConstFloatLiteral(tok, negated: true))
			end 'negatedFloatLiteral'

			let operand = try self.evalConstPostfix(stack)
			if not typeClassAdmits(TypeClass.numeric, tag: operand.tag) 'notANumber'
				throw ConstEvalError.defective(ParseError.nonNumericNegation(typeTagName(operand.tag), line: opTok.line, column: opTok.column))
			end 'notANumber'

			if tagIsFloat(operand.tag) 'float'
				// A NON-literal float negation (a float const REFERENCE, or `-(expr)`) is `0.0 - x` — the
				// subtract-from-zero the runtime's `emitFloatNegation` emits (x64 has no XMM negate),
				// routed through the ONE float sub fold so the constant and the codegen cannot disagree.
				// `-(0.0)` is therefore `+0.0`, exactly as `emitFloatNegation` and the bootstrap give it.
				// A subtract never divides, so the fold never declines.
				match foldFloatBinOp(MaxonBinOp.sub, lhs: FloatZeroBits, rhs: operand.payload) 'negated'
					folded(value) then return ConstValue.create(value, tag: ValueTypeTag.float)
					notFoldable then panic("evalConstUnary: foldFloatBinOp declined `0.0 - x` — only division declines, and negation is a subtraction")
				end 'negated'
			end 'float'

			return ConstValue.create(try self.foldConstUnary(MaxonUnaryOp.neg, operand: operand.payload, opTok: opTok), tag: operand.tag)
		end 'neg'

		if self.at(TokenKind.not) 'not'
			let opTok = self.current()
			self.advance()
			let operand = try self.evalConstUnary(stack)
			return try self.foldConstNot(operand, opTok: opTok)
		end 'not'

		return try self.evalConstPostfix(stack)
	end 'evalConstUnary'

	// A constant primary followed by any trailing `as <Type>` casts. A cast to a ranged-int alias or a
	// primitive is a compile-time NO-OP on the value's bytes (`0 as Integer` is `0`), so the target type
	// is consumed and the value passes through unchanged — the same shape the emitting path uses for a
	// numeric range cast. ⚠ NO-OP ON THE BYTES IS NOT UNCHECKED: `applyConstCast` checks the target's
	// KIND (`requireConstCastTargetKind` — E3011 for a name that denotes nothing, E3009 for a pair with
	// no conversion) and its RANGE (`checkConstCastRange` — `let X = 256 as Octet` is E3005), through the
	// same deciders the emitting path uses. The value passing through unchanged is the CODEGEN, not the
	// verdict.
	function evalConstPostfix(stack TopLevelDeclIndexArray) returns ConstValue throws ConstEvalError
		return try self.applyConstCasts(try self.evalConstPrimary(stack))
	end 'evalConstPostfix'

	// Consume any trailing `as <Type>` casts on an already-evaluated constant. Split out so the
	// negated-float-literal path applies the same casts a primary gets (mirroring `parseCast`, which
	// wraps `parseUnary`'s negated literal in the identical cast loop).
	function applyConstCasts(value ConstValue) returns ConstValue throws ConstEvalError
		var result = value
		while self.at(TokenKind.as) 'cast'
			result = try self.applyConstCast(result)
		end 'cast'
		return result
	end 'applyConstCasts'

	// Consume one `as <Type>` cast and return the value (unchanged on the bytes; see `evalConstPostfix`).
	// The target is a named alias or a primitive keyword — a single token at this rung (a ranged
	// `int(low to high)` cast is a follow-up). When the target is a ranged INT alias and the value is an
	// integer LITERAL, the range is checked HERE — a top-level `let` is not a function, so it records no
	// site for `InsertRangeChecks` to guard, and the compile-time E3005 that a body cast gets from that
	// pass must be raised by the evaluator instead.
	function applyConstCast(value ConstValue) returns ConstValue throws ConstEvalError
		let asTok = self.current()
		try self.consumeConstToken(TokenKind.as)
		if self.at(TokenKind.identifier) or self.at(TokenKind.int) or self.at(TokenKind.bool) or self.at(TokenKind.float) 'targetType'
			let targetTok = self.current()
			self.advance()
			try self.requireConstCastTargetKind(value, targetTok: targetTok, asTok: asTok)
			try self.checkConstCastRange(value, targetTok: targetTok, asTok: asTok)
			return value
		end 'targetType'
		let tok = self.current()
		throw ConstEvalError.defective(ParseError.nonConstantInitializer("cast target", leftover: String.from(tok.value), line: tok.line, column: tok.column))
	end 'applyConstCast'

	// ⭐ **`castTargetTag`'S CONST TWIN — THE SECOND PLACE A CAST TARGET IS WRITTEN.** A top-level
	// `let X = 5 as T` never reaches the expression path: it is folded here, by a walk driven from
	// `ProgramSignatures.evaluateInitializers` before any file is parsed. Checking only `applyCast`
	// would have left `let SENTINEL = 5 as Bogus` evaporating exactly as it always had — half a fact,
	// which is worse than none, because the half that works makes the other half look tested.
	//
	// It asks the identical authority and raises the identical two diagnostics, anchored on the same
	// `as` token, so the two spellings of one mistake are reported identically.
	//
	// A PRIMITIVE-KEYWORD target (`int`/`bool`/`float`) denotes itself and is never `named`, so only
	// the identifier form has anything to look up. ⚠ The id handed to the authority is the filler
	// `UnnamedTypeId`: this walk STORES no type — it reads only the target's KIND — and the id rides
	// exactly one arm (a declared `type`'s `structRef`), whose TAG is all this gate reads. It is also
	// the only id available: the const evaluator "emits no ops and touches no artifact", so it has no
	// interner of its own, and minting into the signature index's would mutate a memo mid-build.
	function requireConstCastTargetKind(value ConstValue, targetTok Token, asTok Token) throws ConstEvalError
		if targetTok.kind != TokenKind.identifier 'primitiveKeyword'
			return
		end 'primitiveKeyword'

		// Both halves are the EMITTING path's own deciders and both raise a `ParseError`; `defective` is
		// the one wrapper every parser diagnostic reaches this walk's `ConstEvalError` channel through, so
		// the const and the body spelling of one mistake cannot report differently. Exactly
		// `requireConstOperands`' shape, for exactly its reason.
		let targetTag = try self.denotedCastTargetTag(targetTok.value, id: UnnamedTypeId, asTok: asTok) otherwise (err) 'undeclared'
			throw ConstEvalError.defective(err)
		end 'undeclared'

		try self.requireCastKindsConvert(value.tag, targetTag: targetTag, asTok: asTok) otherwise (err) 'incompatibleKinds'
			throw ConstEvalError.defective(err)
		end 'incompatibleKinds'
	end 'requireConstCastTargetKind'

	// Compile-time range check for a constant `as` cast — the top-level `let` half of the narrowing
	// E3005, mirroring `InsertRangeChecks.needsRuntimeGuard`'s literal path. It fires only for a
	// NUMERIC literal cast into a ranged alias: a bare `int`/`bool`/`float` primitive target has no
	// range, and a bool const carries no number to test. The out-of-range verdict is `literalInRange`'s
	// — the same decider the body path uses, so the const and runtime casts cannot disagree — and the
	// message is the shared one, anchored at the `as` token as the body cast is.
	function checkConstCastRange(value ConstValue, targetTok Token, asTok Token) throws ConstEvalError
		if targetTok.kind != TokenKind.identifier or not typeClassAdmits(TypeClass.numeric, tag: value.tag) 'notCheckable'
			return
		end 'notCheckable'

		match self.signatures.aliasOf(targetTok.value, readerFilePath: self.filePath) 'a'
			undeclared then break 'a'
			declared(alias) then try self.reportConstCastIfOutOfRange(value, alias: alias, asTok: asTok)
		end 'a'
	end 'checkConstCastRange'

	// Raise the E3005 when `value` is outside `alias`.
	//
	// ⚠ THE CONST AND THE ALIAS MUST BE IN THE SAME DOMAIN. A float const's payload is an IEEE-754 bit
	// pattern and an integer const's is a number, so testing one against the other's bounds compares
	// numbers that were never the same kind of thing. A MISMATCH IS NOT A DEFECT to report here — an
	// int const into a float alias is a promotion, which is legal and simply unchecked — so the
	// mismatched pair is skipped, exactly as `InsertRangeChecks.needsRuntimeGuard` falls through to the
	// runtime guard for the same pair, and exactly as the bootstrap does.
	function reportConstCastIfOutOfRange(value ConstValue, alias RangedTypeAlias, asTok Token) throws ConstEvalError
		let isFloat = aliasIsFloat(alias)
		if tagIsFloat(value.tag) != isFloat 'domainMismatch'
			return
		end 'domainMismatch'

		if literalInRange(value.payload, low: alias.low, high: alias.high, isFloat: isFloat) 'inRange'
			return
		end 'inRange'

		throw ConstEvalError.defective(ParseError.constantCastOutOfRange(value.payload, aliasName: String.from(alias.name), low: alias.low, high: alias.high, isFloat: isFloat, line: asTok.line, column: asTok.column))
	end 'reportConstCastIfOutOfRange'

	// Consume `kind` in the constant evaluator, wrapping a mismatch as a `ConstEvalError`.
	function consumeConstToken(kind TokenKind) throws ConstEvalError
		if not self.at(kind) 'mismatch'
			let tok = self.current()
			throw ConstEvalError.defective(ParseError.unexpectedToken(kind.rawValue, got: tok.kind.rawValue, line: tok.line, column: tok.column))
		end 'mismatch'
		self.advance()
	end 'consumeConstToken'

	// Which `not` this is, and the fold for it — one question, asked of `notOperatorFor`.
	//
	// `logicalNot` cannot come through `foldIntUnaryOp`, which declines it: that folder's domain is
	// the INTEGERS, where a logical not is a parser bug. Over the bool domain it is meaningful and
	// total, which is `foldLogicalNot`. The two live side by side in TypeRules, and this is the split
	// they exist for.
	function foldConstNot(operand ConstValue, opTok Token) returns ConstValue throws ConstEvalError
		match notOperatorFor(operand.tag) 'which'
			op(kind, resultTag) then return ConstValue.create(try self.foldConstUnary(kind, operand: operand.payload, opTok: opTok), tag: resultTag)
			// Unreachable from a constant: `unresolved` is a call to a function no file declares and
			// `void` a call to one returning nothing, and NO call reaches this evaluator at all — a call
			// in an initializer is rejected as E2045 before its type is ever asked for. It is kept as a
			// case rather than a panic because it is the truthful answer if a second route to an untyped
			// operand ever appears.
			unknownOperandType then throw ConstEvalError.defective(ParseError.notOnUnknownType(opTok.line, column: opTok.column))
			// `not 3.14` — reachable here, unlike the two above: a float literal IS a constant.
			// Same rule and same message as the expression path's, because it is the same rule.
			nonIntegralOperand then throw ConstEvalError.defective(ParseError.nonIntegralOperands(opTok.kind.rawValue, operand: typeTagName(operand.tag), line: opTok.line, column: opTok.column))
		end 'which'
	end 'foldConstNot'

	// The unary folds, both routed through TypeRules. `neg` and `bitNot` are `foldIntUnaryOp`'s;
	// `logicalNot` is `foldLogicalNot`'s (see `foldConstNot`).
	function foldConstUnary(op MaxonUnaryOp, operand ParsedInt, opTok Token) returns ParsedInt throws ConstEvalError
		if op == MaxonUnaryOp.logicalNot 'logical'
			return foldLogicalNot(operand)
		end 'logical'

		match foldIntUnaryOp(op, operand: operand) 'folded'
			folded(value) then return value
			// `foldIntUnaryOp` declines only `logicalNot`, which the guard above already took. Reaching
			// here means a unary operator was added to the enum without being given a fold.
			notFoldable then panic("Parser.foldConstUnary: TypeRules declined to fold '{op.rawValue}' over the integer {operand} at {opTok.line}:{opTok.column} — only `logicalNot` is declinable there, and it is handled above")
		end 'folded'
	end 'foldConstUnary'

	// A constant PRIMARY: an integer literal, `true`/`false`, a character literal, a parenthesized
	// sub-expression, a type-qualified bound (`u16.max`), or a reference to another top-level
	// constant. Every literal decoder is the one the emitting path uses, so a constant reads a
	// literal exactly as a function body reads it.
	function evalConstPrimary(stack TopLevelDeclIndexArray) returns ConstValue throws ConstEvalError
		if self.at(TokenKind.intLiteral) 'intLit'
			return try self.evalConstIntLiteral()
		end 'intLit'

		if self.at(TokenKind.floatLiteral) 'floatLit'
			let tok = self.current()
			self.advance()
			return try self.evalConstFloatLiteral(tok, negated: false)
		end 'floatLit'

		if self.at(TokenKind.true) or self.at(TokenKind.false) 'boolLit'
			return self.evalConstBoolLiteral()
		end 'boolLit'

		if self.at(TokenKind.charLiteral) 'charLit'
			return try self.evalConstCharLiteral()
		end 'charLit'

		if self.at(TokenKind.leftParen) 'group'
			return try self.evalConstGroup(stack)
		end 'group'

		if self.at(TokenKind.identifier) 'namedPrimary'
			return try self.evalConstNamed(stack)
		end 'namedPrimary'

		let tok = self.current()
		throw ConstEvalError.defective(ParseError.expectedExpression(tok.kind.rawValue, line: tok.line, column: tok.column))
	end 'evalConstPrimary'

	function evalConstIntLiteral() returns ConstValue throws ConstEvalError
		let tok = self.current()
		self.advance()
		let value = try self.intLiteralValue(tok, negated: false) otherwise (err) 'overflow'
			throw ConstEvalError.defective(err)
		end 'overflow'

		return ConstValue.create(value, tag: ValueTypeTag.integer)
	end 'evalConstIntLiteral'

	// A float literal in a constant initializer — `let PI = 3.14`, `var zeroA = 0.0`, and the operands
	// a fold like `let X = 1.0 + 2.0` computes on. It carries the IEEE-754 bit pattern in the same
	// `ParsedInt` payload every other constant uses, exactly as `parseFloatLiteral` does in an
	// expression, through the same `floatLiteralBits` — so the bits of a float in a `let` and a float
	// in a body cannot differ.
	//
	// `negated` folds a leading `-` INTO the literal (`negatedFloatBits`, a sign flip), the same way
	// `parseNegatedNumericLiteral` does — the reason `-0.0` keeps its sign where `0.0 - x` would lose
	// it. `evalConstUnary` is its only negated caller; every other float literal reads un-negated. The
	// caller has already consumed `tok`, mirroring `evalConstIntLiteral`'s call to `intLiteralValue`.
	function evalConstFloatLiteral(tok Token, negated bool) returns ConstValue throws ConstEvalError
		let bits = try self.floatLiteralBits(tok) otherwise (err) 'rejected'
			throw ConstEvalError.defective(err)
		end 'rejected'

		return ConstValue.create(negatedFloatBits(bits) if negated else bits, tag: ValueTypeTag.float)
	end 'evalConstFloatLiteral'

	function evalConstBoolLiteral() returns ConstValue
		let isTrue = self.at(TokenKind.true)
		self.advance()
		if isTrue 'true'
			return ConstValue.create(BoolTrueValue, tag: ValueTypeTag.boolean)
		end 'true'

		return ConstValue.create(BoolFalseValue, tag: ValueTypeTag.boolean)
	end 'evalConstBoolLiteral'

	// A character literal is an INTEGER carrying its byte — the same reading `parseCharLiteral` gives
	// it, through the same decoder, so `let DASH = '-'` and `c == '-'` cannot disagree about what a
	// dash is.
	function evalConstCharLiteral() returns ConstValue throws ConstEvalError
		let tok = self.current()
		self.advance()
		match decodeCharLiteral(tok.value) 'decoded'
			byte(value) then return ConstValue.create(value, tag: ValueTypeTag.integer)
			empty then throw ConstEvalError.defective(ParseError.invalidCharacterLiteral("a character literal must contain exactly one character", line: tok.line, column: tok.column))
			multiByte then throw ConstEvalError.defective(ParseError.unsupported("the multi-byte character literal '{String.from(tok.value)}' (a character wider than one byte is a `Character` — a heap value — which arrives with String; a single-byte literal materializes as its byte value)", line: tok.line, column: tok.column))
			badEscape(text) then throw ConstEvalError.defective(ParseError.invalidCharacterLiteral("unknown escape sequence '{text}'", line: tok.line, column: tok.column))
		end 'decoded'
	end 'evalConstCharLiteral'

	// `( … )` — grouping, re-entering the climb at the LOOSEST precedence exactly as
	// `parseParenthesizedExpression` does, so a parenthesis restores every operator.
	function evalConstGroup(stack TopLevelDeclIndexArray) returns ConstValue throws ConstEvalError
		try self.consumeConst(TokenKind.leftParen)
		let value = try self.evalConstBinary(stack, minPrec: OrPrecedence)
		try self.consumeConst(TokenKind.rightParen)

		return value
	end 'evalConstGroup'

	// An identifier in a constant: a CALL (rejected), a type-qualified bound (`u16.max`), or a
	// reference to another top-level constant. The same two one-token lookaheads `parsePrimary`
	// splits these three forms with.
	function evalConstNamed(stack TopLevelDeclIndexArray) returns ConstValue throws ConstEvalError
		let tok = self.current()

		// ⚠ REJECTED BEFORE THE CALL IS READ, not after. A call's answer needs the program to be
		// RUNNING, and a top-level `let` is folded before any of it exists — so there is nothing to
		// fold and no later pass that could supply one. Both reference compilers reject it here with
		// this exact text.
		if self.peekKind() == TokenKind.leftParen 'call'
			throw ConstEvalError.defective(ParseError.functionCallInConstant(String.from(tok.value), line: tok.line, column: tok.column))
		end 'call'

		if self.peekKind() == TokenKind.dot 'qualifiedBound'
			let value = try self.parseTypeQualifiedBound(false) otherwise (err) 'badBound'
				throw ConstEvalError.defective(err)
			end 'badBound'
			return ConstValue.create(value, tag: ValueTypeTag.integer)
		end 'qualifiedBound'

		self.advance()
		return try self.evalConstNameRef(tok, stack: stack)
	end 'evalConstNamed'

	// **THE FORWARD REFERENCE, AND THE CROSS-FILE ONE.** A name in an initializer resolves through the
	// whole-program arena, which recursively evaluates whatever it finds — so declaration ORDER does
	// not decide what a program means, and a constant in another file is as reachable as one on the
	// line above. The cycle detection is the arena's (`ProgramSignatures.evaluateDecl`), which is
	// the only place that can see one.
	function evalConstNameRef(tok Token, stack TopLevelDeclIndexArray) returns ConstValue throws ConstEvalError
		match self.signatures.evaluateNamed(tok.value, readerFilePath: self.filePath, stack: stack) 'resolved'
			value(payload, tag) then return ConstValue.create(payload, tag: tag)
			// It exists and has no value. Its own declaration carries the diagnostic, so this one stays
			// quiet — see `TopLevelConstant.poisoned`.
			failed then throw ConstEvalError.dependencyFailed
			notFound then throw ConstEvalError.defective(ParseError.undefinedConstant(String.from(tok.value), line: tok.line, column: tok.column))
		end 'resolved'
	end 'evalConstNameRef'

	// `consume`, wrapped for the evaluator's error type. The evaluator cannot use `consume` directly:
	// it throws `ParseError`, and a `ParseError` raised HERE is a defect in THIS initializer that must
	// be recorded on its declaration rather than thrown at whatever file happens to be parsing.
	function consumeConst(kind TokenKind) returns Token throws ConstEvalError
		return try self.consume(kind) otherwise (err) 'unexpected'
			throw ConstEvalError.defective(err)
		end 'unexpected'
	end 'consumeConst'

	// ⭐ **#65 — IS `name` A METHOD OF THE ENCLOSING TYPE?** A bare call `name(…)` inside a method body resolves
	// to the sibling method `name` rather than a free function — and the method WINS when a free function of the
	// same name also exists (oracle-verified), which is why the free-call path asks this FIRST. False at file
	// scope, where there is no enclosing type and every call is free.
	function isImplicitSelfMethod(name ByteArray) returns bool
		if self.enclosingType.isEmpty() 'notInType'
			return false
		end 'notInType'
		self.ensureSiblingReceivers()
		return self.siblingReceivers.contains(name)
	end 'isImplicitSelfMethod'

	// The receiver a bare call to the sibling `name` carries. An INSTANCE method gets the enclosing `self`
	// prepended at parameter 0 — resolved EXACTLY as an explicit `self.name(…)` resolves it, so the two spellings
	// emit byte-identical calls in every context. A `static` sibling gets none. Two contexts make the self
	// resolution more than a plain scope read, and BOTH are shared with the explicit path so they cannot drift:
	//   • inside a CLOSURE, `self` is an unsupported capture (P1.5-A2b) — refused with the SAME E2015
	//     `parseSelfPrimary` raises (`requireNotInSelfCapture`), NOT the confusing arity E3036 a silent
	//     receiver-less fallback would surface on a call the explicit spelling rejects outright;
	//   • in a `static` method there is no `self` at all, so the lookup fails and the sibling resolves
	//     receiver-less, failing the arity check on the hidden `self` parameter (E3036) — the same rejection the
	//     oracle gives ("missing argument for parameter 'self'").
	// The caller (`parseCall`) has already established `name` IS a sibling (`isImplicitSelfMethod`), so the map
	// is built and this `ensureSiblingReceivers` is a memo hit.
	function implicitSelfReceiver(name ByteArray, anchor Token) returns ReceiverArg throws ParseError
		self.ensureSiblingReceivers()
		if not (try self.siblingReceivers.get(name) otherwise false) 'staticSibling'
			return ReceiverArg.none
		end 'staticSibling'
		try self.requireNotInSelfCapture(anchor)
		// `self` is a PARAMETER — a borrowed reference to the caller's record — so it is writable and has no
		// blame name, which is exactly what keeps a sibling call inside a mutating method legal.
		// ⭐ The empty subject is not an exemption here — it is what makes `self` reach ALL of them. A bare
		// sibling call names no ONE storage, and `noteReceiverBorrowSubjects` turns that plus the receiver's
		// own value into one site per borrowed field of the enclosing receiver. See there.
		return ReceiverArg.value(try self.scope.lookupValue(SelfParamName) otherwise return ReceiverArg.none, immutableName: EmptySourceText, subjectName: EmptySourceText)
	end 'implicitSelfReceiver'

	// Populate `siblingReceivers` (the enclosing type's member methods, bare name -> takesReceiver) unless it is
	// already built for this type. LAZY so a type whose methods make no calls — the whole scale corpus — never
	// builds it and allocates nothing (the field keeps its `sharedEmptySiblingReceivers` placeholder). A
	// file-local token walk of the type body, so it sees every sibling regardless of declaration order: a
	// forward reference resolves exactly as a backward one, and recursion sees the method itself. It is the ONE
	// source of both "is this a sibling?" (`contains`) and "does it take a receiver?" (the value), so those two
	// facts cannot drift apart.
	function ensureSiblingReceivers()
		if self.siblingReceiverScanType.equals(self.enclosingType) 'memoHit'
			return
		end 'memoHit'

		var map = SiblingReceiverMap.create()
		var depth = 0 as BlockDepth
		var q = self.enclosingTypeBodyStart
		while self.kindAt(q) != TokenKind.eof 'walk'
			// A member method is `function <name>` — a closure is `function(` (no name, and no `end`), and no
			// other construct pairs `function` with an identifier, so this cannot mistake one for a method. It
			// opens the method's own block, which `opensBlockAt` does NOT count (it knows if/while/match, not
			// `function`), so counting it here is the +1 that balances the method's `end`.
			let isMethod = self.kindAt(q) == TokenKind.function and self.kindAt(q + 1) == TokenKind.identifier
			if isMethod 'method'
				// A method with no `static` modifier takes the hidden `self` receiver — the SAME token-level test
				// the descriptor sweep uses (`functionDeclIsStatic`), so the two scans agree by construction.
				map.upsert(self.tokenAt(q + 1).value, value: not self.functionDeclIsStatic(q))
			end 'method'

			if isMethod or self.opensBlockAt(q) 'opens'
				depth = depth + 1
			end 'opens' else 'notOpener'
				if self.closesBlockAt(q) 'closes'
					if depth == 0 'typeEnd'
						break
					end 'typeEnd'
					depth = depth - 1
				end 'closes'
			end 'notOpener'

			q = q + 1
		end 'walk'

		self.siblingReceivers = map
		self.siblingReceiverScanType = self.enclosingType
	end 'ensureSiblingReceivers'

	// Parse a call expression `callee(args…)` and return the ValueId its result defines. The
	// callee name is kept as identifier TEXT (a `ByteArray` slice per the MaxonOp value/name
	// split); the arguments are parsed in source order with their `name:` labels. Call-site
	// diagnostics anchor on the callee-through-`)` span.
	//
	// The call op lands in `currentBlock` AFTER the arguments are parsed, because an argument
	// can short-circuit (`f(a or b)`) and move it. Emitting into the block the call STARTED in
	// would put the call on a path its own arguments do not reach.
	// `resultUsed` names the ONE thing the two call positions differ by, and the grammar has exactly
	// two of them: a bare-call STATEMENT (`greet()` on a line of its own — the result is evaluated
	// for effect and discarded) and a call inside an EXPRESSION (`let x = f()`, `f() + 1`,
	// `if ready()`, `g(f())` — the result IS the expression). The parser is therefore the only tier
	// that can tell a legal void call from an illegal use of nothing, which is why the check lives
	// here and not in a later pass.
	function parseCall(func IrFunction, resultUsed bool) returns ValueId throws ParseError
		let calleeTok = self.current()
		// #65 — a bare call to a sibling method of the enclosing type resolves to that method under its
		// qualified name, prepending `self` for an instance method. The method takes precedence over a
		// same-named free function; a name that is NOT a sibling stays the free/direct call below (E3004 if it
		// names nothing declared).
		if self.isImplicitSelfMethod(calleeTok.value) 'implicitSelfMethod'
			let receiver = try self.implicitSelfReceiver(calleeTok.value, anchor: calleeTok)
			return try self.parseCallNamed(func, callee: qualifiedMethodName(self.enclosingType, methodName: calleeTok.value), anchor: calleeTok, receiver: receiver, resultUsed: resultUsed, constructorInstance: ConstructorInstance.none)
		end 'implicitSelfMethod'

		// A free call has no receiver and constructs no generic instance: there is no value to its left, and
		// a generic type is instantiated only through a `Type.method` qualified call.
		return try self.parseCallNamed(func, callee: calleeTok.value, anchor: calleeTok, receiver: ReceiverArg.none, resultUsed: resultUsed, constructorInstance: ConstructorInstance.none)
	end 'parseCall'

	// The call parser proper, taking the callee's NAME rather than reading it — because two call
	// syntaxes produce one call, and only the name differs. `greet()` is its own token's text;
	// `Point.create(…)` is `Point.create`, mangled by `parseQualifiedCall` from two tokens plus a
	// dot. Everything after the name — the argument grammar, the `name:` label rules, the builtin
	// check, the result typing, the emit — is identical, so it is written once.
	//
	// The CURSOR is on the callee's final name token (`greet`, `create`) with `(` behind it; the
	// caller has already consumed any qualification. `anchor` is the token diagnostics point at,
	// which for a qualified call is the TYPE name — the start of what the user wrote, and the same
	// anchor the span runs from.
	function parseCallNamed(func IrFunction, callee ByteArray, anchor Token, receiver ReceiverArg, resultUsed bool, constructorInstance ConstructorInstance) returns ValueId throws ParseError
		try self.consume(TokenKind.identifier)
		try self.consume(TokenKind.leftParen)

		var args = ValueIdArray.create()
		var argLabels = ByteArrayArray.create()
		var argRanges = SourceRangeArray.create()
		var argImmutableNames = ByteArrayArray.create()

		// ⭐ **THE RECEIVER GOES IN FIRST, AS AN UNLABELLED ARGUMENT, AND THEN IT IS JUST AN
		// ARGUMENT.** Pushed BEFORE the source's own arguments are parsed, so it occupies index 0
		// and everything downstream slots it there without being told: `slotCallArgs` puts an
		// unlabelled argument at index `i` into parameter position `i`, and parameter 0 is
		// `SelfParamName`. The two ends of the convention never speak to each other.
		//
		// It does NOT disturb the label rules. `parseCallArgs` counts the SOURCE's arguments from
		// zero on its own counter, so `acc.add(10)`'s `10` is still "the first argument" and is
		// still required to be positional — the receiver is not something the user wrote and must
		// not shift what they did.
		//
		// ⚠ **IT DOES DISTURB THE ARITY COUNTS, AND THIS IS THE ONE PLACE THAT CAN SAY SO.** Every
		// E3036 against a method now counts the receiver on BOTH sides, so both numbers are one
		// higher than anything the source wrote: `a.add()` — zero arguments written — reports
		// *"'Adder.add' expects 2 argument(s) but 1 were provided"* (measured). The count is
		// internally consistent and the program is correctly refused; the numbers are just not the
		// user's. Every method call is affected, through both callers — `parseMethodCall`'s
		// `a.add()` and `parseQualifiedCall`'s receiverless `Adder.add(5)` — which is exactly why
		// the note lives HERE, at the prepend that causes it, rather than being written once per
		// caller and drifting. The bootstrap dodges it by reporting per-parameter ("missing argument
		// for parameter 'value'") instead of by count. The honest fix is a diagnostic that speaks in
		// the SOURCE's arity, and no corpus case covers one — so it is recorded, not invented here.
		//
		// Its span is the receiver EXPRESSION's anchor (`acc`, or the `self` keyword), which is the
		// token a diagnostic about the receiver has to point at.
		match receiver 'prependReceiver'
			none then break 'prependReceiver'
			value(id, immutableName, subjectName) then try self.prependReceiverArg(func, callee: callee, anchor: anchor, id: id, immutableName: immutableName, subjectName: subjectName, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: argImmutableNames)
		end 'prependReceiver'

		try self.parseCallArgs(func, callee: callee, anchor: anchor, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: argImmutableNames, allowFirstNamed: false)

		let rparenTok = try self.consume(TokenKind.rightParen)

		// A BUILTIN is recognized by name, AFTER its arguments are parsed — so it takes the
		// ordinary call syntax and the ordinary argument rules, and only the emit differs. The
		// check sits here rather than in `emitCall` because a builtin emits no `MaxonOp.call` at
		// all: it has no signature to slot arguments against and no symbol to link.
		//
		// A QUALIFIED callee can never match: `Point.trunc` is not `trunc`, so a type may declare a
		// static method of that name and it is linked, not shadowed. The reservation the builtin
		// does impose — a free `function trunc` is unreachable — is unchanged and still undiagnosed
		// (see `emitTrunc`).
		if callee.equals(TruncBuiltinName) 'truncBuiltin'
			return try self.emitTrunc(args, calleeTok: anchor)
		end 'truncBuiltin'

		if callee.equals(PrintBuiltinName) 'printBuiltin'
			return try self.emitPrint(args, calleeTok: anchor, resultUsed: resultUsed)
		end 'printBuiltin'

		if callee.equals(RunProcessBuiltinName) 'runProcessBuiltin'
			return try self.emitRunProcess(args, calleeTok: anchor)
		end 'runProcessBuiltin'

		if callee.equals(SpawnReadLineBuiltinName) 'spawnReadLineBuiltin'
			return try self.emitSpawnReadLine(args, calleeTok: anchor)
		end 'spawnReadLineBuiltin'

		// The seven streaming subprocess builtins (P1.5 slice 1b). Each is recognized by name after its arguments
		// are parsed, exactly like `spawnReadLine`, and routes to a `__gt_subp_*` runtime entry.
		if callee.equals(SubpSpawnBuiltinName) 'subpSpawnBuiltin'
			return try self.emitSubpSpawn(args, calleeTok: anchor)
		end 'subpSpawnBuiltin'

		if callee.equals(SubpReadLineBuiltinName) 'subpReadLineBuiltin'
			return try self.emitSubpReadLine(args, runtimeName: SubpReadLineName, builtinName: SubpReadLineBuiltinName, calleeTok: anchor)
		end 'subpReadLineBuiltin'

		if callee.equals(SubpReadErrLineBuiltinName) 'subpReadErrLineBuiltin'
			return try self.emitSubpReadLine(args, runtimeName: SubpReadErrLineName, builtinName: SubpReadErrLineBuiltinName, calleeTok: anchor)
		end 'subpReadErrLineBuiltin'

		if callee.equals(SubpWriteLineBuiltinName) 'subpWriteLineBuiltin'
			return try self.emitSubpWriteLine(args, calleeTok: anchor)
		end 'subpWriteLineBuiltin'

		if callee.equals(SubpCloseStdinBuiltinName) 'subpCloseStdinBuiltin'
			return try self.emitSubpHandleOp(args, runtimeName: SubpCloseStdinName, builtinName: SubpCloseStdinBuiltinName, resultTag: ValueTypeTag.void, resultUsed: resultUsed, calleeTok: anchor)
		end 'subpCloseStdinBuiltin'

		if callee.equals(SubpWaitBuiltinName) 'subpWaitBuiltin'
			return try self.emitSubpHandleOp(args, runtimeName: SubpWaitName, builtinName: SubpWaitBuiltinName, resultTag: ValueTypeTag.integer, resultUsed: resultUsed, calleeTok: anchor)
		end 'subpWaitBuiltin'

		if callee.equals(SubpReleaseBuiltinName) 'subpReleaseBuiltin'
			return try self.emitSubpHandleOp(args, runtimeName: SubpReleaseName, builtinName: SubpReleaseBuiltinName, resultTag: ValueTypeTag.void, resultUsed: resultUsed, calleeTok: anchor)
		end 'subpReleaseBuiltin'

		// The four MATH INTRINSICS. Only the DISPATCH repeats — the emit itself (arity, operand class,
		// the int→float promotion, the op) is written once in `emitMathIntrinsic`, so each of these is
		// a single line naming its opcode. They are the same `if callee.equals(…)` entries the four
		// builtins above are; this is the builtin table, and a table's rows are data.
		//
		// ⚠⚠ A `union MathIntrinsic{notAnIntrinsic, op(MaxonUnaryOp)}` returned by a name→op resolver
		// would read better and was written first. It was REVERTED ON MEASUREMENT: **a payload-FREE
		// union case still heap-allocates**, so returning `notAnIntrinsic` cost ONE allocation per
		// PARSED CALL — +85/+153/+289/+561/+1105/+2193 allocations across the six scale rungs, a
		// linear constant factor on the hottest path in the parser, for a call that is not an
		// intrinsic 99.99% of the time. These four `equals` allocate nothing and `scale-test` returns
		// to bit-for-bit parity with main. (The `flat union` rule in ARCHITECTURE.md is about NESTING
		// costing a box per level; this is the same accounting one level down.)
		if callee.equals(FloorBuiltinName) 'floorBuiltin'
			return try self.emitMathIntrinsic(args, op: MaxonUnaryOp.floor, name: callee, calleeTok: anchor)
		end 'floorBuiltin'

		if callee.equals(CeilBuiltinName) 'ceilBuiltin'
			return try self.emitMathIntrinsic(args, op: MaxonUnaryOp.ceil, name: callee, calleeTok: anchor)
		end 'ceilBuiltin'

		if callee.equals(RoundBuiltinName) 'roundBuiltin'
			return try self.emitMathIntrinsic(args, op: MaxonUnaryOp.round, name: callee, calleeTok: anchor)
		end 'roundBuiltin'

		if callee.equals(SqrtBuiltinName) 'sqrtBuiltin'
			return try self.emitMathIntrinsic(args, op: MaxonUnaryOp.sqrt, name: callee, calleeTok: anchor)
		end 'sqrtBuiltin'

		// The `__Builtins.*` intrinsic table (see `BuiltinsQualifierPrefix`). Gated behind ONE prefix compare
		// so a call to anything else pays two bytes and no allocation; an unrecognized member falls through to
		// `emitCall`'s reserved-callee rejection, which is this table's "unknown intrinsic" arm.
		if isBuiltinsIntrinsicCallee(callee) 'builtinsIntrinsic'
			if callee.equals(BuiltinsCurrentTimeNanosName) 'currentTimeNanos'
				return try self.emitClockIntrinsicCall(args, name: callee, runtimeName: GtNowNsName, calleeTok: anchor)
			end 'currentTimeNanos'

			if callee.equals(BuiltinsCurrentTimeMsName) 'currentTimeMs'
				return try self.emitMonotonicMs(args, calleeTok: anchor)
			end 'currentTimeMs'

			if callee.equals(BuiltinsCurrentUnixTimeSecondsName) 'currentUnixTimeSeconds'
				return try self.emitClockIntrinsicCall(args, name: callee, runtimeName: WallClockNowUnixSecondsName, calleeTok: anchor)
			end 'currentUnixTimeSeconds'

			// ⭐ **THE ONLY SPELLING OF `sleep` THE PARSER RECOGNIZES — STDLIB'S OWN FLOOR.** A source
			// `sleep(ms)` is an ordinary call to `stdlib/Sleep.maxon`'s declaration, which the loader
			// brings into every compile and whose one-line body is exactly this intrinsic; there is no
			// bare-name `sleep` builtin and there must never be a second one, or a call and a declaration
			// of the same name would reach the scheduler by two routes that could come to disagree.
			if callee.equals(BuiltinsSleepName) 'sleep'
				return try self.emitSleep(args, calleeTok: anchor, resultUsed: resultUsed)
			end 'sleep'
		end 'builtinsIntrinsic'

		return try self.emitCall(callee, anchor: anchor, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: argImmutableNames, rparenTok: rparenTok, resultUsed: resultUsed, constructorInstance: constructorInstance)
	end 'parseCallNamed'

	// ⭐ **`__Builtins.currentTimeMs()` — THE NANOSECOND READING, SCALED. NOT the coarse tick.**
	//
	// `stdlib/Clock.maxon`'s doc-comment says `nowMs()` is backed by `GetTickCount64`, whose period is
	// ~15.6 ms. A QPC-derived millisecond satisfies every promise that comment makes — monotonic,
	// milliseconds, absolute value platform-defined — and satisfies them BETTER, so the stdlib is left
	// exactly as it is and this lowering is the stronger contract. The only direction that could break a
	// caller is the other one (a coarse tick where a fine one was promised), and
	// `specs-shv2/builtins-clock.md`'s `ms-resolves-sub-tick` is the test that would catch it.
	//
	// The divide is emitted INLINE rather than as a `__clock_now_ms` runtime function, because a runtime
	// function whose whole body is one call and one divide is a call/ret wrapped around two instructions —
	// the same reasoning that makes `trunc` a builtin instead of a stdlib call. It goes through the ordinary
	// `emitBinOp`, so the operand rules, the result tag and the constant view are the ones every source-level
	// `/` gets; there is no second division path to keep in step.
	function emitMonotonicMs(args ValueIdArray, calleeTok Token) returns ValueId throws ParseError
		let nanos = try self.emitClockIntrinsicCall(args, name: BuiltinsCurrentTimeMsName, runtimeName: GtNowNsName, calleeTok: calleeTok)
		let perMilli = self.emitLiteral(NanosPerMillisecond, valueType: MaxonType.integer, range: SourceRange.ofToken(calleeTok))
		return try self.emitBinOp(nanos, rhs: perMilli, op: MaxonBinOp.div, opTok: calleeTok)
	end 'emitMonotonicMs'

	// ⭐ **THE ARITY CHECK AND THE EMIT EVERY CLOCK INTRINSIC SHARES**, written once and returning the
	// integer-tagged reading. All three take no arguments and become one call to a runtime entry point the
	// compiler builds at the Std tier, so only the entry point's NAME differs.
	//
	// The arity rejection is the SAME `builtinArity` every other builtin raises — a builtin has no signature
	// registry entry for SemanticCheck's ordinary arity check to consult, which is exactly why that variant
	// exists. `name` is the callee's own bytes so the diagnostic quotes what the user wrote.
	function emitClockIntrinsicCall(args ValueIdArray, name ByteArray, runtimeName ByteArray, calleeTok Token) returns ValueId throws ParseError
		if args.count() != ClockIntrinsicArity 'arity'
			throw ParseError.builtinArity(String.from(name), expected: ClockIntrinsicArity, got: args.count(), line: calleeTok.line, column: calleeTok.column)
		end 'arity'

		return self.emitRuntimeCall(runtimeName, args: ValueIdArray.create(), resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(calleeTok))
	end 'emitClockIntrinsicCall'

	// `trunc(x)` — **THE f64 → int BRIDGE**, and a compiler BUILTIN rather than a stdlib function.
	//
	// It is a builtin in both reference compilers (v1: `mathIntrinsicTarget` →
	// `StdArithUnaryOpcode.fpToSiI64`, LowerMaxonToStd.maxon:13888; the bootstrap: `MaxonTruncOp`,
	// 2-Parser.cs:804). For shv2 the reason is sharper than inheritance: it lowers to ONE
	// instruction, so a call would be a call/ret wrapped around a single `cvttsd2si` — and,
	// decisively at THIS rung, a stdlib `trunc` would drag in the stdlib cone, which is P1.0b's.
	// specs-shv2/float-type.md ends nearly every case on it, so it is the difference between the
	// float corpus running and not running at all.
	//
	// ⚠ **`trunc(int)` IS THE IDENTITY, and answering it with the operand is CORRECTNESS, not an
	// optimization.** An int → f64 → int round trip loses precision above f64's 53-bit mantissa,
	// so `trunc(i64.max)` would answer a number that is not `i64.max`. v1 makes the same call for
	// the same reason ("trunc(int) is identity — alias the result to the operand directly",
	// LowerMaxonToStd.maxon:7778). It is also what keeps `fpToSi` from ever naming an int → int
	// conversion, which `lowerUnaryOp` panics on.
	//
	// ⚠ The name is RESERVED wherever a call is parsed: a user function called `trunc` is
	// shadowed by this and never linked. v1 has the same property for its whole math-intrinsic
	// set, and the same absence of a diagnostic for it.
	function emitTrunc(args ValueIdArray, calleeTok Token) returns ValueId throws ParseError
		let operand = try self.numericBuiltinOperand(args, name: TruncBuiltinName, calleeTok: calleeTok)

		// Already an integer: `trunc` has nothing to truncate. See the precision note above.
		if not tagIsFloat(self.tagOf(operand)) 'identity'
			return operand
		end 'identity'

		return self.emitUnaryOp(operand, op: MaxonUnaryOp.trunc, resultTag: ValueTypeTag.integer, opTok: calleeTok)
	end 'emitTrunc'

	// ⭐ **THE ARITY AND OPERAND-CLASS CHECK EVERY ARITY-1 NUMERIC BUILTIN MAKES**, written once and
	// returning the validated operand. `trunc` and the four math intrinsics ask exactly the same two
	// questions in exactly the same words — one argument, and it is a number — and only what they DO
	// with the answer differs. Restating the pair per builtin is how the five would come to disagree
	// about the wording of a rejection nobody asked for.
	//
	// `name` is the callee's own bytes, so the diagnostic quotes what the user wrote — which is also
	// what lets one function serve four names.
	function numericBuiltinOperand(args ValueIdArray, name ByteArray, calleeTok Token) returns ValueId throws ParseError
		if args.count() != NumericBuiltinArity 'arity'
			throw ParseError.builtinArity(String.from(name), expected: NumericBuiltinArity, got: args.count(), line: calleeTok.line, column: calleeTok.column)
		end 'arity'

		let operand = try args.get(0) otherwise panic("numericBuiltinOperand: args.count() == NumericBuiltinArity just checked but get(0) failed")
		let operandTag = self.tagOf(operand)
		if not typeClassAdmits(TypeClass.numeric, tag: operandTag) 'notANumber'
			throw ParseError.builtinOperandType(String.from(name), required: "number", got: typeTagName(operandTag), line: calleeTok.line, column: calleeTok.column)
		end 'notANumber'

		return operand
	end 'numericBuiltinOperand'

	// `floor(x)` / `ceil(x)` / `round(x)` / `sqrt(x)` — the arity-1 FLOAT math intrinsics, written
	// ONCE for all four because everything but the opcode is identical (specs/{floor,ceil,round,sqrt}.md).
	//
	// ⭐ THE ONE PLACE IT DIVERGES FROM `emitTrunc`, AND IT IS THE WHOLE DIFFERENCE BETWEEN THE TWO:
	// `trunc` LEAVES the float domain, so an integer argument is the IDENTITY and is answered with the
	// operand itself. These STAY inside it — `sqrt(16)` is 4, not 16 — so an integer argument is
	// PROMOTED, not short-circuited. That promotion is what `specs/implicit-type-conversion.md`'s
	// `math-intrinsic-int-promotion` case pins, and it is also what keeps the Std opcode's
	// f64-operand precondition true (`assertUnaryOperandDomain`). v1 promotes at the same point for
	// the same reason (`lowerMathIntrinsic`, LowerMaxonToStd.maxon:7784).
	//
	// The result is a FLOAT, per every one of the four spec files' signature (`floor(x float) float`),
	// which is why each of their tests ends on `trunc(...)` to reach an ExitCode.
	//
	// `name` is the callee's own bytes rather than a name derived from `op`: the caller already holds
	// them, and a diagnostic must quote what the user wrote.
	function emitMathIntrinsic(args ValueIdArray, op MaxonUnaryOp, name ByteArray, calleeTok Token) returns ValueId throws ParseError
		let operand = try self.numericBuiltinOperand(args, name: name, calleeTok: calleeTok)
		return self.emitUnaryOp(self.promoteToFloat(operand, opTok: calleeTok), op: op, resultTag: ValueTypeTag.float, opTok: calleeTok)
	end 'emitMathIntrinsic'

	// `print(s)` — **WRITE A STRING TO STDOUT**, no trailing newline (P1.2 wave A). A compiler BUILTIN
	// like `trunc`: it takes ordinary call syntax but emits no `MaxonOp.call` to a user function — it
	// routes to the `__print_string` runtime entry (which loads `buffer@0`/`length@8` and writes them).
	//
	// It requires exactly one `String` argument and returns VOID, so a call in VALUE position is
	// rejected exactly as a void user-call is (`mintDeclaredCallResult`'s `voidCallResultUsed`), and at
	// the same anchor.
	function emitPrint(args ValueIdArray, calleeTok Token, resultUsed bool) returns ValueId throws ParseError
		if args.count() != PrintArity 'arity'
			throw ParseError.builtinArity(String.from(PrintBuiltinName), expected: PrintArity, got: args.count(), line: calleeTok.line, column: calleeTok.column)
		end 'arity'

		let arg = try args.get(0) otherwise panic("emitPrint: args.count() == PrintArity just checked but get(0) failed")
		let argTag = self.tagOf(arg)
		if not tagIsText(argTag) 'notAString'
			throw ParseError.builtinOperandType(String.from(PrintBuiltinName), required: typeTagName(ValueTypeTag.string), got: typeTagName(argTag), line: calleeTok.line, column: calleeTok.column)
		end 'notAString'

		// `print` returns nothing, so using its result is using a value that is not there — the same
		// error a void user-call gets in value position.
		if resultUsed 'noValueToUse'
			throw ParseError.voidCallResultUsed(String.from(PrintBuiltinName), line: calleeTok.line, column: calleeTok.column)
		end 'noValueToUse'

		var callArgs = ValueIdArray.create()
		callArgs.push(arg)
		return self.emitRuntimeCall(PrintStringName, args: callArgs, resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(calleeTok))
	end 'emitPrint'

	// `__Builtins.sleep(ms)` — **SUSPEND THE CURRENT GREEN THREAD** for `ms` milliseconds, yielding to the
	// scheduler (P1.5 mid-body-yield). It emits no `MaxonOp.call` to a user function — it routes to the
	// `__gt_sleep` scheduler runtime entry (which parks the running GT on a timer and yields). It requires
	// exactly one INTEGER argument (the duration; a float/String/bool is refused) and returns VOID, so a call
	// in value position is rejected exactly as a void user-call is.
	//
	// ⚠ **THE INTRINSIC IS STDLIB'S FLOOR, NOT THE SURFACE.** What a user writes is `sleep(ms)`, an ordinary
	// call to `stdlib/Sleep.maxon`'s declaration, and the rules it meets are that declaration's — its
	// parameter type, its absent return — checked by SemanticCheck against its signature like every other
	// call's. The checks below are what an intrinsic needs BECAUSE no file declares it: there is no signature
	// for the ordinary checks to read. So they are not a second copy of the same rule; they are the rule for
	// the one call site `stdlib/Sleep.maxon`'s body makes.
	function emitSleep(args ValueIdArray, calleeTok Token, resultUsed bool) returns ValueId throws ParseError
		if args.count() != SleepIntrinsicArity 'arity'
			throw ParseError.builtinArity(String.from(BuiltinsSleepName), expected: SleepIntrinsicArity, got: args.count(), line: calleeTok.line, column: calleeTok.column)
		end 'arity'

		let arg = try args.get(0) otherwise panic("emitSleep: args.count() == SleepIntrinsicArity just checked but get(0) failed")
		let argTag = self.tagOf(arg)
		if not typeClassAdmits(TypeClass.numeric, tag: argTag) or tagIsFloat(argTag) 'notAnInt'
			throw ParseError.builtinOperandType(String.from(BuiltinsSleepName), required: "integer", got: typeTagName(argTag), line: calleeTok.line, column: calleeTok.column)
		end 'notAnInt'

		// The intrinsic returns nothing, so using its result is using a value that is not there — the same
		// error a void user-call gets in value position.
		if resultUsed 'noValueToUse'
			throw ParseError.voidCallResultUsed(String.from(BuiltinsSleepName), line: calleeTok.line, column: calleeTok.column)
		end 'noValueToUse'

		var callArgs = ValueIdArray.create()
		callArgs.push(arg)
		return self.emitRuntimeCall(GtSleepName, args: callArgs, resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(calleeTok))
	end 'emitSleep'

	// `runProcess(cmd)` — **SPAWN A WINDOWS CHILD AND AWAIT ITS EXIT CODE**, yielding the current green thread
	// while it runs (P1.5 subprocess seed). A compiler BUILTIN like `print`: ordinary call syntax, but it emits no
	// `MaxonOp.call` to a user function — it routes to the `__gt_process_run(strPtr)` scheduler runtime entry
	// (which spawns the child with CreateProcessA, parks the GT on the process, and — once the netpoll observes
	// the child exit — resumes and returns its scalar exit code). It requires exactly one STRING argument (the
	// command line; a non-String is refused with E3005, mirroring `emitSleep`'s integer check) and returns an
	// INTEGER, so — unlike `emitSleep`'s void — its result IS usable in value position and needs no `resultUsed` gate.
	//
	// The String is BORROWED, exactly as `print` borrows its argument: `__gt_process_run` reads the command
	// line's `buffer`/`length` out of the 48-byte record (like `__print_string` does) and never takes ownership,
	// so a literal command line needs no decref.
	function emitRunProcess(args ValueIdArray, calleeTok Token) returns ValueId throws ParseError
		if args.count() != RunProcessArity 'arity'
			throw ParseError.builtinArity(String.from(RunProcessBuiltinName), expected: RunProcessArity, got: args.count(), line: calleeTok.line, column: calleeTok.column)
		end 'arity'

		let arg = try args.get(0) otherwise panic("emitRunProcess: args.count() == RunProcessArity just checked but get(0) failed")
		let argTag = self.tagOf(arg)
		if not tagIsText(argTag) 'notAString'
			throw ParseError.builtinOperandType(String.from(RunProcessBuiltinName), required: typeTagName(ValueTypeTag.string), got: typeTagName(argTag), line: calleeTok.line, column: calleeTok.column)
		end 'notAString'

		var callArgs = ValueIdArray.create()
		callArgs.push(arg)
		return self.emitRuntimeCall(GtProcessRunName, args: callArgs, resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(calleeTok))
	end 'emitRunProcess'

	// `spawnReadLine(cmd)` — **THE IOCP OVERLAPPED-READ PROBE** (P1.5 slice 1a-ii). A compiler BUILTIN like
	// `runProcess`: ordinary call syntax routing to the `__gt_io_read(strPtr)` scheduler runtime entry (spawn the
	// command with stdout → a fresh overlapped pipe, issue a YIELDING overlapped read, return the byte count). It
	// requires exactly one STRING argument (the command line; a non-String is refused, mirroring `emitRunProcess`)
	// and returns an INTEGER. NON-throwing (a plain integer result, not the dual-register error ABI), so no `try`.
	// The String is BORROWED exactly as `runProcess` borrows it (`__gt_io_read` reads buffer/length, never owns).
	function emitSpawnReadLine(args ValueIdArray, calleeTok Token) returns ValueId throws ParseError
		if args.count() != SpawnReadLineArity 'arity'
			throw ParseError.builtinArity(String.from(SpawnReadLineBuiltinName), expected: SpawnReadLineArity, got: args.count(), line: calleeTok.line, column: calleeTok.column)
		end 'arity'

		let arg = try args.get(0) otherwise panic("emitSpawnReadLine: args.count() == SpawnReadLineArity just checked but get(0) failed")
		let argTag = self.tagOf(arg)
		if not tagIsText(argTag) 'notAString'
			throw ParseError.builtinOperandType(String.from(SpawnReadLineBuiltinName), required: typeTagName(ValueTypeTag.string), got: typeTagName(argTag), line: calleeTok.line, column: calleeTok.column)
		end 'notAString'

		var callArgs = ValueIdArray.create()
		callArgs.push(arg)
		return self.emitRuntimeCall(IoReadName, args: callArgs, resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(calleeTok))
	end 'emitSpawnReadLine'

	// `subpSpawn(cmd)` — **SPAWN A STREAMING CHILD** (P1.5 slice 1b): route to `__gt_subp_spawn`, which creates three
	// pipes, spawns the child, and returns a non-negative handle (or -1). One BORROWED String argument (the command
	// line, read like `spawnReadLine`'s), an INTEGER result (the handle) usable in value position.
	function emitSubpSpawn(args ValueIdArray, calleeTok Token) returns ValueId throws ParseError
		if args.count() != SubpSpawnArity 'arity'
			throw ParseError.builtinArity(String.from(SubpSpawnBuiltinName), expected: SubpSpawnArity, got: args.count(), line: calleeTok.line, column: calleeTok.column)
		end 'arity'

		let arg = try args.get(0) otherwise panic("emitSubpSpawn: args.count() == SubpSpawnArity just checked but get(0) failed")
		let argTag = self.tagOf(arg)
		if not tagIsText(argTag) 'notAString'
			throw ParseError.builtinOperandType(String.from(SubpSpawnBuiltinName), required: typeTagName(ValueTypeTag.string), got: typeTagName(argTag), line: calleeTok.line, column: calleeTok.column)
		end 'notAString'

		var callArgs = ValueIdArray.create()
		callArgs.push(arg)
		return self.emitRuntimeCall(SubpSpawnName, args: callArgs, resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(calleeTok))
	end 'emitSubpSpawn'

	// Validate a streaming builtin's single INTEGER handle argument (arity 1, integer, not float) and return it —
	// the shared front of `subpReadLine`/`subpReadErrLine`/`subpCloseStdin`/`subpWait`/`subpRelease`, so the arity +
	// operand-class diagnostics are produced in one place.
	function requireHandleArg(args ValueIdArray, builtinName ByteArray, arity ParamCount, calleeTok Token) returns ValueId throws ParseError
		if args.count() != arity 'arity'
			throw ParseError.builtinArity(String.from(builtinName), expected: arity, got: args.count(), line: calleeTok.line, column: calleeTok.column)
		end 'arity'

		let handle = try args.get(0) otherwise panic("requireHandleArg: arity just checked but get(0) failed")
		let handleTag = self.tagOf(handle)
		if not typeClassAdmits(TypeClass.numeric, tag: handleTag) or tagIsFloat(handleTag) 'notAnInt'
			throw ParseError.builtinOperandType(String.from(builtinName), required: "integer", got: typeTagName(handleTag), line: calleeTok.line, column: calleeTok.column)
		end 'notAnInt'

		return handle
	end 'requireHandleArg'

	// `subpReadLine(h)` / `subpReadErrLine(h)` — **READ ONE STDOUT/STDERR LINE** (P1.5 slice 1b): route to
	// `__gt_subp_read_line` / `__gt_subp_read_err_line`, which yield the green thread while the read is in flight and
	// return an OWNED String (the line INCLUDING its '\n', or "" on EOF). The result is enrolled as a pending owned
	// temporary (`trackOwnedTemp`) so ownership drops it exactly as an interpolation result — the same door.
	function emitSubpReadLine(args ValueIdArray, runtimeName ByteArray, builtinName ByteArray, calleeTok Token) returns ValueId throws ParseError
		let handle = try self.requireHandleArg(args, builtinName: builtinName, arity: SubpReadArity, calleeTok: calleeTok)
		var callArgs = ValueIdArray.create()
		callArgs.push(handle)
		let result = self.emitRuntimeCall(runtimeName, args: callArgs, resultTag: ValueTypeTag.string, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(calleeTok))
		self.trackOwnedTemp(result)
		return result
	end 'emitSubpReadLine'

	// `subpWriteLine(h, line: s)` — **WRITE A LINE TO STDIN** (P1.5 slice 1b): route to `__gt_subp_write_line`, which
	// appends '\n' and does a synchronous WriteFile. Two arguments: an INTEGER handle and a BORROWED String line;
	// an INTEGER result (0 success, nonzero broken pipe).
	function emitSubpWriteLine(args ValueIdArray, calleeTok Token) returns ValueId throws ParseError
		if args.count() != SubpWriteArity 'arity'
			throw ParseError.builtinArity(String.from(SubpWriteLineBuiltinName), expected: SubpWriteArity, got: args.count(), line: calleeTok.line, column: calleeTok.column)
		end 'arity'

		let handle = try args.get(0) otherwise panic("emitSubpWriteLine: args.count() == SubpWriteArity just checked but get(0) failed")
		let handleTag = self.tagOf(handle)
		if not typeClassAdmits(TypeClass.numeric, tag: handleTag) or tagIsFloat(handleTag) 'notAnInt'
			throw ParseError.builtinOperandType(String.from(SubpWriteLineBuiltinName), required: "integer", got: typeTagName(handleTag), line: calleeTok.line, column: calleeTok.column)
		end 'notAnInt'

		let line = try args.get(1) otherwise panic("emitSubpWriteLine: args.count() == SubpWriteArity just checked but get(1) failed")
		let lineTag = self.tagOf(line)
		if not tagIsText(lineTag) 'notAString'
			throw ParseError.builtinOperandType(String.from(SubpWriteLineBuiltinName), required: typeTagName(ValueTypeTag.string), got: typeTagName(lineTag), line: calleeTok.line, column: calleeTok.column)
		end 'notAString'

		var callArgs = ValueIdArray.create()
		callArgs.push(handle)
		callArgs.push(line)
		return self.emitRuntimeCall(SubpWriteLineName, args: callArgs, resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(calleeTok))
	end 'emitSubpWriteLine'

	// `subpCloseStdin(h)` (void) / `subpWait(h)` (integer exit code) / `subpRelease(h)` (void) — **THE HANDLE-OP
	// BUILTINS** (P1.5 slice 1b): one INTEGER handle argument, routing to the named `__gt_subp_*` entry. A void
	// result used in value position is rejected exactly as a void user-call is.
	function emitSubpHandleOp(args ValueIdArray, runtimeName ByteArray, builtinName ByteArray, resultTag ValueTypeTag, resultUsed bool, calleeTok Token) returns ValueId throws ParseError
		let handle = try self.requireHandleArg(args, builtinName: builtinName, arity: SubpHandleArity, calleeTok: calleeTok)

		if resultTag == ValueTypeTag.void and resultUsed 'noValueToUse'
			throw ParseError.voidCallResultUsed(String.from(builtinName), line: calleeTok.line, column: calleeTok.column)
		end 'noValueToUse'

		var callArgs = ValueIdArray.create()
		callArgs.push(handle)
		return self.emitRuntimeCall(runtimeName, args: callArgs, resultTag: resultTag, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(calleeTok))
	end 'emitSubpHandleOp'

	// ⭐⭐ **E3070's RECEIVER DOOR: THE RECEIVER IS AN ARGUMENT, AND IT HAD NO ONE ASKING.** `b.wipe()`
	// destroys the element a caller borrowed out of `b.items` exactly as `wipe(b.items)` does, and the two
	// differ only in which column the array arrives in — so the receiver is offered to the conflict check as
	// the ARGUMENT 0 that `parseCallNamed` has already made it. Measured before this door existed: the
	// oracle prints 44, shv2 ran and printed **4557430888798830399** out of freed memory.
	//
	// It is settled against the STORAGE mask like every other call site, and that is what makes the door
	// work at all: `wipe`'s `writtenParamMask` is 0 by the ruling `self-keyword.md:self-with-params` pins,
	// while its `storageWrittenParamMask` carries the receiver's bit (see `IrFunction`'s table).
	//
	// The push and the record are ONE function because the receiver's argument COLUMN is what
	// `argSlotPosition` maps to a parameter, and a site recorded beside a push that had not happened yet
	// would name the wrong column. Recorded BEFORE the push, so `args.count()` is this argument's own index
	// — the identical rule `parseCallArgs` states for the source's arguments.
	function prependReceiverArg(func IrFunction, callee ByteArray, anchor Token, id ValueId, immutableName ByteArray, subjectName ByteArray, args ValueIdArray, argLabels ByteArrayArray, argRanges SourceRangeArray, argImmutableNames ByteArrayArray) throws ParseError
		self.noteReceiverBorrowSubjects(func, callee: callee, anchor: anchor, argColumn: args.count(), id: id, subjectName: subjectName)
		pushCallArg(args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: argImmutableNames, value: id, label: EmptySourceText, range: SourceRange.ofToken(anchor), immutableName: immutableName)
	end 'prependReceiverArg'

	// ⭐⭐ **WHICH STORAGES A RECEIVER STANDS FOR — and `self` stands for MORE THAN ONE.** An ordinary
	// receiver denotes one binding, so it records one site. The ENCLOSING `self` denotes the whole receiver,
	// and a borrow taken inside this same body was recorded against a FIELD's alias (`items`), never against
	// `self` — so a single site keyed on the receiver would match no borrow and the call would be waved
	// through. MEASURED, both spellings: `let s = try items.get(0) otherwise ""` then `reset()` or
	// `self.reset()`, where `reset` clears `items`, printed **4557430888798830399** out of freed memory while
	// the oracle printed 44.
	//
	// One site per self-field subject is exactly right rather than merely conservative: the callee writes
	// through the receiver PARAMETER, and every field of that receiver is storage the parameter reaches. A
	// callee that writes nothing is still filtered by the summary at the resolver, so a read-only sibling
	// call stays legal. All the sites share one token, which the resolver's ordering check permits (it
	// refuses a DECREASE, not a repeat).
	function noteReceiverBorrowSubjects(func IrFunction, callee ByteArray, anchor Token, argColumn ParamCount, id ValueId, subjectName ByteArray)
		if not subjectName.isEmpty() 'denotesOneNamedStorage'
			self.recordCallArgMutationSite(func, callee: callee, anchor: anchor, argColumn: argColumn, argLabel: EmptySourceText, subjectName: subjectName)
			return
		end 'denotesOneNamedStorage'

		if not self.receiverIsEnclosingSelf(id) 'denotesNoStorageThisBodyCanName'
			return
		end 'denotesNoStorageThisBodyCanName'

		// The count is taken FIRST: `recordCallArgMutationSite` resolves each name back through
		// `borrowSubjectIdOf`, which appends to this very list for a name it has not seen — and every name
		// here is one it has, so it cannot grow, but reading the bound once says so rather than relying on it.
		let subjectCount = func.borrowFacts.subjects.count()
		for k in 0 upto subjectCount 'eachSubjectOfThisBody'
			let subject = try func.borrowFacts.subjects.get(k) otherwise panic("noteReceiverBorrowSubjects: subjects.get OOB at {k} inside count()")
			if subject.isSelfField 'fieldOfTheEnclosingReceiver'
				self.recordCallArgMutationSite(func, callee: callee, anchor: anchor, argColumn: argColumn, argLabel: EmptySourceText, subjectName: subject.name)
			end 'fieldOfTheEnclosingReceiver'
		end 'eachSubjectOfThisBody'
	end 'noteReceiverBorrowSubjects'

	// Is this receiver value the ENCLOSING function's own `self` parameter? Derived from the binding rather
	// than assumed of a token, so both spellings answer alike: `self.reset()` resolves `self` to that value
	// and a bare sibling call (`reset()`) is given it by `implicitSelfReceiver`. False outside an instance
	// method, where there is no receiver to be.
	function receiverIsEnclosingSelf(id ValueId) returns bool
		return id == (try self.scope.lookupValue(SelfParamName) otherwise return false)
	end 'receiverIsEnclosingSelf'

	// Parse a comma-separated argument list into the parallel `args`/`argLabels`/
	// `argRanges` lists (all empty for `()`). The caller has consumed `(`; this leaves
	// the cursor on `)`. Each argument is an expression, optionally prefixed by a
	// `name:` label — the FIRST argument must be positional and every later argument
	// must be labelled (`consumeArgLabel` enforces both, positioned at the offending
	// token), except that `allowFirstNamed` lifts the first-argument rule for an
	// interface / type-parameter receiver (see there). Whether a `name:` label actually
	// matches a parameter is a check for whoever holds the callee's parameter names —
	// SemanticCheck for a direct call, `slottedWitnessArgs` for a witness dispatch.
	//
	// `callee`/`anchor` name the call being parsed, for the E3070 borrow check: a free call
	// whose argument names a borrowed collection is a mutation site only if the CALLEE writes
	// that parameter's storage, so the site has to be recorded against a name, here, where the
	// argument's own tokens are still in hand (`BorrowCheck.maxon`).
	function parseCallArgs(func IrFunction, callee ByteArray, anchor Token, args ValueIdArray, argLabels ByteArrayArray, argRanges SourceRangeArray, argImmutableNames ByteArrayArray, allowFirstNamed bool) throws ParseError
		if self.at(TokenKind.rightParen) 'noArgs'
			return
		end 'noArgs'

		var argIndex = 0 as ParamCount
		while true 'argLoop'
			// The argument's leading token — the label token when labelled, else the
			// value's first token — anchors this argument's diagnostic span.
			let argFirstTok = self.current()
			let label = try self.consumeArgLabel(argIndex, allowFirstNamed: allowFirstNamed)
			let valueTok = self.current()
			let valueStart = self.pos
			// Cleared HERE, before the argument is parsed, so an argument whose one identifier token resolved
			// through a primary path that publishes nothing reads "writable" rather than a previous
			// argument's answer. See `bareArgImmutableName`.
			self.lastBareBindingImmutableName = EmptySourceText
			// `parseValueExpression` (the climber plus a trailing ternary — `f(a if c else b)`), not
			// `parseExpression`: an argument is parsed INSIDE an expression that has already seeded
			// `currentBlock`, and re-seeding it would discard a short-circuit an EARLIER argument performed.
			let value = try self.parseValueExpression(func)

			// A capturing closure handed DOWN to a direct callee is now SUPPORTED (P1.5-A2b-2): its environment
			// travels as the companion argument the lowering appends at the function-typed parameter position
			// (`LowerMaxonToStd.appendCalleeEnvArgs`), so the callee's `f(x)` reads the right env. No refusal
			// here. (A capturing closure at a NON-function parameter is a type error caught by SemanticCheck.)
			// ⭐ E3070's call-argument door, taken BEFORE the push so the column index it records is this
			// argument's own — the receiver a method call prepended included, which is the index
			// `argSlotPosition` maps to a parameter position (`noteBorrowSubjectCallArg`).
			self.noteBorrowSubjectCallArg(func, callee: callee, anchor: anchor, argColumn: args.count(), argLabel: label, valueStart: valueStart)

			pushCallArg(args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: argImmutableNames, value: value, label: label, range: SourceRange.ofToken(argFirstTok), immutableName: self.bareArgImmutableName(valueTok, valueStart: valueStart))
			argIndex = argIndex + 1

			if not self.at(TokenKind.comma) 'endArgs'
				break
			end 'endArgs'
			try self.consume(TokenKind.comma)
		end 'argLoop'
	end 'parseCallArgs'

	// ⭐⭐ **THE NAME AN E3019 WOULD BLAME FOR THE ARGUMENT JUST PARSED — and the ONE token that makes the
	// question answerable.** An argument names an immutable binding only if it IS that name and nothing
	// else: `f(a)` blames `a`, while `f(a + 1)`, `f(g(a))` and `f(a.count())` all hand over a value the
	// binding does not own and must blame nothing.
	//
	// The test is the CURSOR, not a lookahead: an argument that consumed exactly ONE token, and that token
	// an identifier, is a bare name. A predicate run BEFORE `parseValueExpression` would be a token-shape
	// guess sitting in front of the resolution it guards — the shape this file has already paid for three
	// times — whereas asking afterwards is a statement about what the resolution actually did.
	//
	// The ANSWER comes from the resolution itself (`Parser.lastBareBindingImmutableName`, written by
	// `parseVariableReference` and by nothing else), so the argument rule and the receiver rule reach the
	// same `immutableReceiverNameOf`. `parseCallArgs` clears it before every argument, so a one-token
	// identifier that resolved through some OTHER primary path — one that publishes nothing — answers
	// "writable" rather than inheriting a neighbouring argument's name.
	function bareArgImmutableName(valueTok Token, valueStart TokenIndex) returns ByteArray
		if valueTok.kind != TokenKind.identifier or self.pos != valueStart + 1 'notABareName'
			return EmptySourceText
		end 'notABareName'

		return self.lastBareBindingImmutableName
	end 'bareArgImmutableName'

	// Consume and validate an optional `name:` label on the next argument, returning the
	// label text (the empty string when unlabelled). The FIRST argument (`argIndex == 0`)
	// must be positional — a label there is E2052; every later argument must be labelled —
	// a bare value there is E2053. A `name:` label is two tokens (identifier + colon); a
	// bare value leaves the cursor untouched. (Whether the label names a real parameter
	// is checked later — by SemanticCheck for a direct call, by `slottedWitnessArgs` for a
	// witness dispatch.)
	//
	// ⭐ **`allowFirstNamed` RELAXES THE FIRST-ARGUMENT RULE FOR AN INTERFACE / TYPE-PARAMETER RECEIVER,
	// AND NOTHING ELSE** (P1.7a slice 2b-vi). `specs/interface-dispatch.md` makes the E2052 check apply
	// only to concrete-struct / enum / builtin receivers, so a witness dispatch's first argument may carry
	// a label (`self.item.add(a: 1, b: 2)`) — the concrete receiver whose declaration would forbid it is
	// exactly what the shared body does not know. v1 spells the same exemption the same way, as a flag on
	// its method-call site (`Parser.maxon:14409`: "the receiver may be interface/type-param-typed, which
	// permits a named first arg"). It is a PARAMETER rather than a fork of this function because the
	// E2053 half is unrelaxed and must stay one copy: only the first argument's verdict moves.
	function consumeArgLabel(argIndex ParamCount, allowFirstNamed bool) returns ByteArray throws ParseError
		let labelTok = self.current()
		let isNamed = labelTok.kind == TokenKind.identifier and self.peekKind() == TokenKind.colon

		if argIndex == 0 and isNamed and not allowFirstNamed 'firstNamed'
			throw ParseError.firstArgNamed(labelTok.line, column: labelTok.column)
		end 'firstNamed'
		if argIndex > 0 and not isNamed 'missingLabel'
			throw ParseError.argMissingLabel(labelTok.line, column: labelTok.column)
		end 'missingLabel'

		// Unlabelled past those two rejects means a legal POSITIONAL first argument; the cursor still sits
		// on the value, so nothing is consumed.
		if not isNamed 'positional'
			return EmptySourceText
		end 'positional'

		try self.consume(TokenKind.identifier)
		try self.consume(TokenKind.colon)
		return labelTok.value
	end 'consumeArgLabel'

	// Append a `call` op defining a fresh result value; return the ValueId it defines. The
	// callee is a `ByteArray` — a slice of its identifier token for a free call, a freshly built
	// mangled name for a qualified one; the call span runs from `anchor` through the closing `)`
	// (the conventional call anchor).
	//
	// The result is minted BEFORE the op is appended, because the op stores its id — and it is
	// minted through `mintCallResult`, which can REFUSE (a void call in value position), so nothing
	// is emitted for a call the program is not allowed to make.
	function emitCall(callee ByteArray, anchor Token, args ValueIdArray, argLabels ByteArrayArray, argRanges SourceRangeArray, argImmutableNames ByteArrayArray, rparenTok Token, resultUsed bool, constructorInstance ConstructorInstance) returns ValueId throws ParseError
		try requireCalleeIsNotReservedName(callee, anchor: anchor)
		let result = try self.mintCallResult(callee, anchor: anchor, resultUsed: resultUsed)
		// The CALLER SIDE of consume-by-use (P1.4a wave 2, P1.6-B2): an owned argument at a position the callee
		// CONSUMES — a plain-field store, or a type-parameter field of a concrete instance whose argument owns
		// managed heap — is moved (poisoned / drained); a borrowed one is refused. Done BEFORE the op is
		// emitted so a refused call emits nothing.
		try self.applyCallerConsume(callee, args: args, argLabels: argLabels, argRanges: argRanges, anchor: anchor, constructorInstance: constructorInstance)
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.call(result, callee: callee, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: settledImmutableArgNames(argImmutableNames)), range: SourceRange.between(anchor, last: rparenTok))
		return result
	end 'emitCall'

	// ⭐ **`async f(args…)` — SPAWN A GREEN THREAD** (P1.5-B1a). The cursor sits just past `async`, on the
	// callee name. B1a supports a FREE call only (`async f(…)`), so the callee name is followed directly by
	// `(` — a qualified `async Type.method(…)` fails at the `(` consume and is refused, which is the intended
	// B1a boundary. The argument grammar and `name:` label rules are `parseCallArgs`, shared with an ordinary
	// call, so a labelled async argument slots exactly as a plain one does.
	function parseAsyncCall(func IrFunction) returns ValueId throws ParseError
		if not self.at(TokenKind.identifier) 'notCall'
			let tok = self.current()
			throw ParseError.unsupported("`async` must be applied to a call — `async f(…)` (got '{tok.kind.rawValue}')", line: tok.line, column: tok.column)
		end 'notCall'
		let calleeTok = self.current()
		try self.consume(TokenKind.identifier)
		try self.consume(TokenKind.leftParen)

		var args = ValueIdArray.create()
		var argLabels = ByteArrayArray.create()
		var argRanges = SourceRangeArray.create()
		var argImmutableNames = ByteArrayArray.create()
		try self.parseCallArgs(func, callee: calleeTok.value, anchor: calleeTok, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: argImmutableNames, allowFirstNamed: false)
		let rparenTok = try self.consume(TokenKind.rightParen)

		return try self.emitAsyncCall(calleeTok.value, anchor: calleeTok, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: argImmutableNames, rparenTok: rparenTok)
	end 'parseAsyncCall'

	// Mint the Promise handle an `async` spawn defines and emit the `asyncCall` op. B1a is SCALAR ONLY: the
	// trampoline passes arguments through the GPR arg registers and captures the result from R8, so a
	// managed/float ARGUMENT or a managed/float RESULT is REFUSED here (E2015) rather than leaked or
	// miscompiled. The callee's PARAMETER types are checked by SemanticCheck, which alone holds the resolved
	// signature.
	//
	// ⭐ **THE PROMISE IS AN i64 HANDLE, tagged `integer` — NOT the awaited scalar (P1.5-B2b).** The handle is
	// the spawned GT's pointer; its value is an i64 whatever the awaited result type is. Earlier B1a tagged it
	// with the awaited scalar so `await` could read the result type off `tagOf`, but a VOID async's handle
	// would then be void-tagged and `let p = async voidFn()` could not bind it (a void tag names no value).
	// So the handle carries `integer`, and `await`/`try await` recover the awaited result type from the
	// callee (`awaitedResultTag`) — the same defining-`asyncCall` lookup the `try await` desugar already uses.
	function emitAsyncCall(callee ByteArray, anchor Token, args ValueIdArray, argLabels ByteArrayArray, argRanges SourceRangeArray, argImmutableNames ByteArrayArray, rparenTok Token) returns ValueId throws ParseError
		try requireCalleeIsNotReservedName(callee, anchor: anchor)
		for i in 0 upto args.count() 'eachArg'
			let argValue = try args.get(i) otherwise panic("emitAsyncCall: args.get OOB at {i} — args are pushed in lockstep by parseCallArgs")
			if not tagIsAsyncScalar(self.tagOf(argValue)) 'managedArg'
				throw ParseError.unsupported("an `async` call argument must be a scalar (int/bool) — a managed (String/struct) or float argument travels in a register file the green-thread trampoline cannot fill at this rung (managed async is P1.5-B1c)", line: anchor.line, column: anchor.column)
			end 'managedArg'
		end 'eachArg'

		// ⛔ **AN `async` CALL HAS ITS OWN, LOWER ARGUMENT CEILING, AND IT IS A DIFFERENT MECHANISM'S LIMIT.**
		// An ordinary call gained stack arguments; a SPAWN did not, and cannot here: the arguments do not travel
		// in a calling convention at all but through the GT struct's INLINE argument region (`GtOffArgInline`,
		// `MaxAsyncArgs` slots), which the HAND-ASSEMBLED trampoline reads back into the ABI argument registers
		// one slot at a time (`X64GtRuntime.buildGtTrampolineChunk`). Passing a seventh would mean teaching that
		// hand-written chunk to build a callee's outgoing stack-argument region on the green thread's stack —
		// the async ABI, not the compiled one.
		//
		// ⚠ It used to be a compiler PANIC in `LowerMaxonToStd.emitAsyncSpawn`, guarding an inequality that
		// "cannot fire today" because `MaxAsyncArgs` equalled the parser's six-register parameter cap. Removing
		// that cap made it reachable from ordinary source, so it is a positioned diagnostic here — where the
		// other two async refusals (a managed argument, a non-scalar result) already are, and for the same
		// reason. The panic stays as the structural backstop it always claimed to be.
		if args.count() > MaxAsyncArgs 'tooManyAsyncArgs'
			throw ParseError.unsupported("`async {String.from(callee)}(…)` passes {args.count()} arguments — more than the {MaxAsyncArgs} a spawn can carry. A spawned call's arguments ride the green thread's inline argument region, which the hand-assembled trampoline reads back into the argument registers, so a spawn has no stack-argument path even though an ordinary call does. Call it directly, or pass fewer arguments", line: anchor.line, column: anchor.column)
		end 'tooManyAsyncArgs'

		try self.requireAsyncResult(callee, anchor: anchor)
		let result = self.mintValue(ValueTypeTag.integer, nameId: UnnamedTypeId)
		self.markValuePromise(result)
		// ⭐ P1.5-B2 #88: the spawn OWNS a green thread. Enrol it as a statement-scoped pending temporary,
		// exactly as `trackOwnedTemp` enrols an interpolation result: `parseBinding` transfers it to
		// `ownedBindings` when bound (`let p = …`), `emitAwaitOp` clears it when consumed (`await async f()`),
		// and an UNBOUND, UNAWAITED spawn (`async f()` as a bare statement) is dropped at statement end
		// through `drainPendingTemps` — so no spawn path can leak its thread.
		self.pendingTempDrops.push(result)
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.asyncCall(result, callee: callee, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: settledImmutableArgNames(argImmutableNames)), range: SourceRange.between(anchor, last: rparenTok))
		return result
	end 'emitAsyncCall'

	// Refuse a `async callee(…)` whose awaited RESULT is not scalar-or-void (a managed/float result has no
	// GPR channel). `returnTypeOf` answers PRE-resolution, so a union/alias/struct return is `named`/`structRef`
	// here and correctly refused; an UNDECLARED callee defers to SemanticCheck's E3004 (its `integer`
	// placeholder passes). Void passes (P1.5-B2b — the awaiter discards a void async's R8 garbage).
	function requireAsyncResult(callee ByteArray, anchor Token) throws ParseError
		let resultTag = self.calleeReturnTag(callee)
		if resultTag != ValueTypeTag.void and not tagIsAsyncScalar(resultTag) 'nonScalarResult'
			throw ParseError.unsupported("`async {String.from(callee)}(…)` must return a scalar (int/bool) or void — the green-thread runtime captures the result through R8, so a managed (String/struct) or float result has no channel to await at this rung (managed async is P1.5-B1c)", line: anchor.line, column: anchor.column)
		end 'nonScalarResult'
	end 'requireAsyncResult'

	// The awaited-result tag a promise carries — its callee's declared return type — recovered from the
	// defining `asyncCall` (the same lookup `commitTryAwaitRewrite` uses). A promise-marked value always has
	// one (invariant). Read by both `await` and `try await` so a void async's result is void and a scalar's
	// is its scalar, without the handle needing to carry the (possibly-void) tag.
	function awaitedResultTag(func IrFunction, promise ValueId) returns ValueTypeTag
		match self.asyncCallCalleeOf(func, promise: promise) 'callee'
			found(callee) then return self.calleeReturnTag(callee)
			none then panic("awaitedResultTag: promise v{promise} has no defining asyncCall — every promise-marked value is minted by an asyncCall")
		end 'callee'
	end 'awaitedResultTag'

	// The declared return type of `callee` as a value tag, VOID included (an undeclared callee → `integer`
	// placeholder, its doomed program rejected before lowering). The shared async result-type reader.
	function calleeReturnTag(callee ByteArray) returns ValueTypeTag
		return match self.signatures.returnTypeOf(callee, into: self.artifact.typeNames) 'r'
			declared(returnType) gives asyncReturnTypeTag(returnType)
			undeclared gives ValueTypeTag.integer
		end 'r'
	end 'calleeReturnTag'

	// ⭐ **`await p` — BLOCK ON A PROMISE** (P1.5-B1a/B2b). PLAIN (non-`try`) await. Refuses a THROWING promise
	// (E3057): a plain `await` lowers to `__gt_await`, which yields only the result and DROPS the R10 error
	// flag — a throw would be delivered as a wrong answer (and a boxed error would leak). A throwing promise
	// must be `try await`ed, which the `try` target path (`parseTryCallTarget`) reaches via the SAME
	// `emitAwaitOp` WITHOUT this reject, because catching the error is exactly what `try await` does.
	function emitAwait(func IrFunction, promise ValueId, awaitTok Token) returns ValueId throws ParseError
		match self.asyncCallCalleeOf(func, promise: promise) 'throwing'
			found(callee) then try self.rejectPlainAwaitOfThrowing(callee, awaitTok: awaitTok)
			none then break 'throwing'
		end 'throwing'
		return try self.emitAwaitOp(func, promise: promise, awaitTok: awaitTok)
	end 'emitAwait'

	// Refuse a plain `await` of a THROWING awaited callee (E3057) — the await twin of `try` on a throwing
	// call. A non-throwing callee is accepted (no-op). A non-promise operand reaches `none` in `emitAwait` and
	// is refused by `emitAwaitOp` instead.
	function rejectPlainAwaitOfThrowing(callee ByteArray, awaitTok Token) throws ParseError
		if throwsClauseIsThrowing(self.signatures.throwsOf(callee)) 'throwing'
			throw ParseError.awaitThrowingPromiseNeedsTry(String.from(callee), line: awaitTok.line, column: awaitTok.column)
		end 'throwing'
	end 'rejectPlainAwaitOfThrowing'

	// Emit the `await` op for a validated promise operand — the shared core of plain `await` (`emitAwait`) and
	// the `try await` target (`parseTryCallTarget`). Refuses a non-promise operand (E2015). The result tag is
	// the AWAITED result type (recovered from the callee — the handle carries only `integer`), so a void async
	// yields a void await result the desugar handles and a scalar async yields its scalar.
	function emitAwaitOp(func IrFunction, promise ValueId, awaitTok Token) returns ValueId throws ParseError
		if not self.valueIsPromise(promise) 'notPromise'
			throw ParseError.unsupported("`await` applies to a Promise produced by an `async` call — the operand here is not an async spawn's result", line: awaitTok.line, column: awaitTok.column)
		end 'notPromise'
		let result = self.mintValue(self.awaitedResultTag(func, promise: promise), nameId: UnnamedTypeId)
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.await(result, promise: promise), range: SourceRange.ofToken(awaitTok))
		// The await consumes the thread — the runtime reclaims its struct here — so its owning binding must not
		// also drop it at scope exit (P1.5-B2 #88). Covers `try await` too: `parseTryCallTarget` emits its target
		// through this same `emitAwaitOp`, then rewrites the op to `tryAwait` (the consume is independent).
		self.consumePromiseThread(promise)
		return result
	end 'emitAwaitOp'

	// ⭐ **TRANSFER OWNERSHIP OF EVERY CONSUMED ARGUMENT** (P1.4a wave 2). For a callee that consumes at
	// least one parameter, slot each SOURCE argument to its parameter position (positional by index,
	// labelled by name — the sweep's `paramNames` stand in for the not-yet-built `FuncSignature`) and, at a
	// consumed position, transfer the argument: an OWNED value is moved (poisoned if it is a live binding,
	// drained if it is a temporary), a BORROWED struct/union is refused (`E2015` — the transitive-consume
	// case), a scalar is inert. The overwhelming common callee `borrowsAll`, so this is a single `match` and
	// returns.
	function applyCallerConsume(callee ByteArray, args ValueIdArray, argLabels ByteArrayArray, argRanges SourceRangeArray, anchor Token, constructorInstance ConstructorInstance) throws ParseError
		match self.signatures.consumeOf(callee) 'c'
			borrowsAll then break 'c'
			consumes(info) then try self.transferConsumedArgs(info, args: args, argLabels: argLabels, argRanges: argRanges, anchor: anchor, constructorInstance: constructorInstance)
		end 'c'
	end 'applyCallerConsume'

	// Transfer every argument that lands at a consumed parameter position. Slots each SOURCE argument to its
	// position through `argSlotPosition` ITSELF — the one home of the label→position mapping — over the
	// sweep's own `paramNames`, because at parse time the `FuncSignature` does not yet exist. It used to
	// re-spell the mapping inline (`i if label.isEmpty() else info.indexOfParam(label)`), which is exactly
	// the drift `argSlotPosition`'s header warns of, and it lost that function's O(P) fast path with it;
	// asking against a bare name LIST rather than a signature (P1.7a slice 2b-vi) is what made the shared
	// door reachable from here at all. A malformed call
	// (an arity mismatch, an unknown label) leaves the position `>= paramNames.count()`, which `isConsumed`
	// answers false, so it is left untouched here and reported by SemanticCheck against the real registry.
	function transferConsumedArgs(info ParamConsumeInfo, args ValueIdArray, argLabels ByteArrayArray, argRanges SourceRangeArray, anchor Token, constructorInstance ConstructorInstance) throws ParseError
		// shv2 is move-only, so one OWNED value consumed at TWO argument positions of a single call would be
		// dropped twice — a double-free — the call analog of the struct-literal `rejectDoubleOwningStore`
		// (`Self{a: v, b: v}`). Track each owned value moved in at a CONSUMING position; a repeat is
		// use-after-move (E3102), positioned on the second occurrence. A BORROWED consumed arg is promoted to a
		// FRESH owned copy per position (`transferConsumedArg`), so it never aliases and is not tracked; a scalar
		// is inert. A two-BORROW call (`sum(box, b: box)`) reaches no consuming position, so it is never rejected.
		var consumedOwned = ValueIdArray.create()
		for i in 0 upto args.count() 'eachArg'
			let label = try argLabels.get(i) otherwise panic("transferConsumedArgs: argLabels.get OOB at {i} — args and argLabels are pushed in lockstep")
			let position = argSlotPosition(info.paramNames, argIndex: i, label: label)
			let argValue = try args.get(i) otherwise panic("transferConsumedArgs: args.get OOB at {i}")
			// ⭐ A FEED position whose argument is an enrolled opaque owned binding is a SHARED-body forward MOVE
			// (P1.7 slice 3b-v — the forward twin of the direct `self.items.push(item)`): the callee takes
			// ownership, so this frame must move it even though the instance test borrows it (`constructorInstance`
			// none — the shared body does not know the concrete instance). The CONCRETE call site's own argument is
			// never opaque-owned, so it stays on the existing instance-feed path untouched.
			if not self.argIsConsumedAt(info, position: position, constructorInstance: constructorInstance) and not self.isOpaqueOwnedFeedArg(info, position: position, argValue: argValue) 'borrowed'
				// ⭐ A borrowed argument whose borrow ESCAPES into a durable instance field must not dangle when the
				// container OUTLIVES the source (the retain-escaping rung — the RED cross-scope UAF): a static
				// constructor feed RETAINS a co-owned trivial struct, an instance-method feed materializes a temp.
				self.handleEscapingBorrowFeed(info, position: position, argValue: argValue, anchor: anchor)
				continue
			end 'borrowed'
			// Only an OWNED managed value can double-free: it MOVES (no per-position copy), so the same value at a
			// second consuming position is the double-consume. A borrowed arg is promoted per position and a scalar
			// is inert, so neither is tracked. The gate mirrors `transferConsumedArg`'s own owned-move path. The name
			// is resolved only on a repeat (`consumedArgName`), where the value is always a bound local.
			if self.valueIsOwnedHeap(argValue) and self.isRepeatedOwningMove(consumedOwned, value: argValue) 'doubleConsume'
				let range = try argRanges.get(i) otherwise panic("transferConsumedArgs: argRanges.get OOB at {i} — args and argRanges are pushed in lockstep")
				throw ParseError.useAfterMove(String.from(self.consumedArgName(argValue)), line: range.line, column: range.column)
			end 'doubleConsume'
			// A borrowed String consumed arg is PROMOTED to an owned copy the callee can keep — `transferConsumedArg`
			// returns that copy, which must replace the borrowed original in the call's args so the op carries the
			// owned value (`applyCallerConsume` runs BEFORE the op is emitted). An owned/scalar arg returns itself.
			let transferred = try self.transferConsumedArg(argValue, anchor: anchor)
			try args.set(i, value: transferred) otherwise panic("transferConsumedArgs: args.set OOB at {i}")
		end 'eachArg'
	end 'transferConsumedArgs'

	// The declared name of the owning binding a consumed argument value came from — the source name the
	// cross-argument double-consume diagnostic (`transferConsumedArgs`' E3102) reports. A value passed at TWO
	// argument positions is always a bare local referenced twice (a temporary is minted by ONE expression and
	// cannot appear at two positions), so its owning binding — live, or already poisoned by the first position's
	// move — is always present, and the poison leaves its `boundValue` unchanged.
	function consumedArgName(value ValueId) returns ByteArray
		for binding in self.ownedBindings 'each'
			if binding.boundValue == value 'found'
				return binding.name
			end 'found'
		end 'each'
		panic("consumedArgName: v{value} consumed at two argument positions has no owning binding — a value at two positions is a bare local referenced twice, which is always an owned binding")
	end 'consumedArgName'

	// Is the argument at parameter `position` consumed by this call — a plain-field consume (`bits`, whatever
	// the concrete type), OR a P1.6-B2 type-parameter FEED whose concrete instance argument OWNS managed heap.
	// A trivial type-parameter feed (`Box with Point`/`IntBox`) answers false, so it is borrowed exactly as at
	// P1.6-A.
	function argIsConsumedAt(info ParamConsumeInfo, position ParamCount, constructorInstance ConstructorInstance) returns bool
		if info.isConsumed(position) 'plainConsume'
			return true
		end 'plainConsume'
		return self.instanceFeedConsumes(info, position: position, constructorInstance: constructorInstance)
	end 'argIsConsumedAt'

	// ⭐ **IS THE ARGUMENT AT `position` AN OPAQUE OWNED TYPE-PARAMETER FEED FORWARD (P1.7 slice 3b-v)?** A
	// feed position whose argument is an enrolled owned opaque `typeParameter` binding — the SHARED-body
	// forward move (`self.store(item)`) that `argIsConsumedAt`'s instance test cannot see, because the shared
	// body carries no concrete instance (`constructorInstance` none). The value-level dual of the direct
	// `moveElementIntoArray` opaque poison. False for every non-feed position and every non-opaque argument
	// (a concrete String / struct feed argument, the CONCRETE call site's own value), so it moves nothing the
	// instance path already owns.
	function isOpaqueOwnedFeedArg(info ParamConsumeInfo, position ParamCount, argValue ValueId) returns bool
		return info.typeParamFeedOf(position).isFeed() and self.valueIsOpaqueOwned(argValue)
	end 'isOpaqueOwnedFeedArg'

	// ⭐ **KEEP A BORROWED ARGUMENT ALIVE WHEN ITS BORROW ESCAPES INTO A DURABLE INSTANCE FIELD (the
	// retain-escaping rung — the user ruling, 2026-07-23).** A `T`-typed FEED position stores its argument into
	// an instance field the enclosing container OUTLIVES, so a later read of that field must not see freed
	// memory. Two feed shapes reach here, and they DIFFER in who owns the stored value — the STATIC-vs-INSTANCE
	// split `ParamConsumeInfo.isInstanceMethod` reads:
	//
	//   • A STATIC CONSTRUCTOR feed (`Box.create(item T)` → `Self{ item: item }`) makes the BOX co-own the
	//     element. For a trivial struct/instance (`Box with Point`), which the call site BORROWS rather than
	//     consumes, `__mm_retain` raises the box's refcount so it holds a REAL second reference — generalizing
	//     OPEN #40's aggregate co-ownership. The box's destructor decref (`genericInstanceFieldIsManaged` now
	//     `typeIsManaged`) releases it, and the caller's OWN drop releases the caller's reference: freed exactly
	//     once whether the source is a temporary, a named inner binding, or an outer binding the box outlives —
	//     all uniformly, which is why no scope-local materialization is needed for this shape. A SCALAR feed
	//     owns no heap and needs no retain.
	//   • An INSTANCE-METHOD feed (`self.items.push(item)`, `self.saved = next` — the slice-3b mechanism) moves
	//     the argument into durable storage the CALLEE owns. A trivial `Array with T` element the array does not
	//     per-element drop is still a BORROW the caller keeps; a borrowed TEMPORARY of it is otherwise freed at
	//     statement end while the array points at it, so it is materialized as a hidden scope-local (a nameless
	//     owned binding, as a temporary `match` scrutinee is) to move its drop to scope exit. (A shared-body
	//     REASSIGN feed of a co-owned trivial struct is rejected up front at `emitOpaqueFieldReassign`, so it
	//     never reaches this materialization.)
	function handleEscapingBorrowFeed(info ParamConsumeInfo, position ParamCount, argValue ValueId, anchor Token)
		if not info.typeParamFeedOf(position).isFeed() 'notEscapingFeed'
			return
		end 'notEscapingFeed'
		if not info.isInstanceMethod() 'constructorFeed'
			if self.valueIsNonTextAggregate(argValue) 'coOwnedAggregate'
				self.emitIncref(argValue, range: SourceRange.ofToken(anchor))
			end 'coOwnedAggregate'
			return
		end 'constructorFeed'
		self.materializeEscapingBorrowTemp(argValue)
	end 'handleEscapingBorrowFeed'

	// Give a borrowed instance-method-feed TEMPORARY a scope lifetime (see `handleEscapingBorrowFeed`): the
	// callee borrows it into durable storage (a trivial `Array with T` element) the container outlives, so a
	// statement-end drop would dangle. Enrolling it as a nameless owned binding moves its drop to scope exit;
	// reverse drop order frees the element after the container that borrowed it. A NON-temporary source (a named
	// binding) already drops at its own scope and needs nothing.
	function materializeEscapingBorrowTemp(argValue ValueId)
		if not self.pendingTempsContain(argValue) 'notTemporary'
			return
		end 'notTemporary'

		self.removeFromPendingTemps(argValue)
		self.ownedBindings.push(VarInfo.createValueBinding(EmptySourceText, varType: self.typeOf(argValue), mutable: false, boundValue: argValue))
	end 'materializeEscapingBorrowTemp'

	// Does the concrete instance's argument at parameter `position`'s type-parameter feed own managed heap
	// (P1.6-B2)? Only a generic-alias constructor carries an instance; only a fed parameter has a position; a
	// borrowed (trivial) argument answers false.
	function instanceFeedConsumes(info ParamConsumeInfo, position ParamCount, constructorInstance ConstructorInstance) returns bool
		match constructorInstance 'ci'
			none then return false
			instance(gid) then return self.instanceFeedConsumesFor(gid, info: info, position: position)
		end 'ci'
	end 'instanceFeedConsumes'

	// The instance-in-hand half of `instanceFeedConsumes` — the parameter is consumed iff it feeds a type
	// parameter whose concrete argument owns managed heap.
	function instanceFeedConsumesFor(gid GenericInstanceId, info ParamConsumeInfo, position ParamCount) returns bool
		match info.typeParamFeedOf(position) 'f'
			none then return false
			feeds(tpPos) then return self.signatures.genericInstanceArgIsOwned(gid, position: tpPos)
		end 'f'
	end 'instanceFeedConsumesFor'

	// Transfer one consumed argument out of its owner, returning the value the call must actually carry. A
	// SCALAR argument owns no heap and the consume is inert (returns itself). An OWNED managed value moves — a
	// live owned BINDING is poisoned (E3102 on later use), an owned TEMPORARY is drained from the statement's
	// pending drops (the callee owns it now); `poisonMoveSource` and `removeFromPendingTemps` are each a no-op
	// on the other's case, so both run without a bare-local flag to gate them (returns itself). A BORROWED
	// STRING (a long rdata literal, or a borrowed String parameter/field) has a cheap owning copy, so it is
	// PROMOTED into a fresh owned record the callee can move into its field — exactly as a DIRECT struct-field /
	// union-payload move-in does (`moveManagedValueInto`) — and THAT copy is returned to replace the borrowed
	// arg. A borrowed STRUCT/UNION has no clone and stays refused (the transitive-consume case the call-graph
	// fixpoint owns).
	function transferConsumedArg(argValue ValueId, anchor Token) returns ValueId throws ParseError
		// ⭐ AN OPAQUE OWNED type-parameter binding forwarded to a consuming sibling feed position (P1.7 slice
		// 3b-v): the callee takes ownership, so MOVE it — poison the source binding so a second use is E3102 and
		// this frame does not drop it too. Its `typeParameter` tag fails `valueIsManagedHeap` below (opaque here),
		// so this must precede the scalar short-circuit; it carries no owning COPY (like an owned aggregate), so
		// the value passes through unchanged, poisoned in place. Reached only for `isOpaqueOwnedFeedArg` positions.
		if self.valueIsOpaqueOwned(argValue) 'opaqueOwned'
			try self.poisonMoveSource(argValue, anchor: anchor)
			self.removeFromPendingTemps(argValue)
			return argValue
		end 'opaqueOwned'
		if not self.valueIsManagedHeap(argValue) 'scalar'
			return argValue
		end 'scalar'
		if not self.valueIsOwnedHeap(argValue) 'borrowedManaged'
			if tagIsText(self.tagOf(argValue)) 'string'
				let owned = self.promoteToOwnedString(argValue, range: SourceRange.ofToken(anchor))
				self.removeFromPendingTemps(owned)
				return owned
			end 'string'
			throw ParseError.unsupported("passing a borrowed struct/union value at a CONSUMING argument position — the callee moves it into durable storage, so ownership must transfer, and a borrowed struct/union has no `clone`, so its owner keeps a live reference the callee's field would dangle behind; forwarding a borrowed aggregate parameter to a consuming callee is the transitive-consume case handled by the call-graph fixpoint (P1.4a wave 2+)", line: anchor.line, column: anchor.column)
		end 'borrowedManaged'
		try self.poisonMoveSource(argValue, anchor: anchor)
		self.removeFromPendingTemps(argValue)
		return argValue
	end 'transferConsumedArg'

	// Mint the SSA value a call to `calleeTok` defines, typed from the WHOLE-PROGRAM signature index
	// (SignatureIndex.maxon) — so the type is exact whether the callee is declared above this call,
	// below it, or in another file entirely.
	//
	// The index answers with the DECLARATION, undistorted, which is what makes the two cases below
	// distinguishable at all. The shipped code asked a file-local table and mapped BOTH "this file
	// does not declare it" and "it declares nothing to return" onto one `MaxonType.unresolved` — a
	// sentinel with two meanings, and TypeRules' `unknown` (which agrees with everything) is what it
	// became. That is how `isReady()` from another file added to 41 and made 42, and how
	// `let x = noop()` then `x + 4` compiled at all.
	function mintCallResult(callee ByteArray, anchor Token, resultUsed bool) returns ValueId throws ParseError
		match self.signatures.returnTypeOf(callee, into: self.artifact.typeNames) 'callee'
			declared(returnType) then return try self.mintDeclaredCallResult(callee, anchor: anchor, returnType: returnType, resultUsed: resultUsed)
			// NO file declares this callee. DEFER, and keep deferring: `SemanticCheck.validateCall` owns
			// that diagnostic (E3004, "call to undefined function") because it reads the registry the
			// REAL parse built, and this sweep is the tolerant half of the pair — see
			// `CalleeReturn.undeclared`. So the program is rejected, just not here, and `unresolved`
			// therefore never reaches codegen.
			undeclared then return self.mintValue(ValueTypeTag.unresolved, nameId: UnnamedTypeId)
		end 'callee'
	end 'mintCallResult'

	// The result of a call to a callee some file DOES declare — where the void/value split is
	// finally a split and not a sentinel.
	function mintDeclaredCallResult(callee ByteArray, anchor Token, returnType MaxonReturnType, resultUsed bool) returns ValueId throws ParseError
		match returnType 'r'
			value(inner) then return self.mintOwnedCallResult(inner)
			void then break 'r'
		end 'r'

		// A VOID callee. In STATEMENT position that is precisely what the position is FOR — the call
		// runs for its effect — so the result value is minted with the `void` tag and never read
		// again (ValueTypeTag.void: it is write-only, and this is the only site that writes it).
		//
		// In VALUE position there is no value to give. The bootstrap says so (`E2004: Function 'noop'
		// does not return a value`), and now so does shv2, at the same anchor.
		if resultUsed 'noValueToUse'
			throw ParseError.voidCallResultUsed(String.from(callee), line: anchor.line, column: anchor.column)
		end 'noValueToUse'

		return self.mintValue(ValueTypeTag.void, nameId: UnnamedTypeId)
	end 'mintDeclaredCallResult'

	// The SSA value a VALUE-returning callee defines, minted from its declared return type — and ADOPTED
	// as owned when that type is a heap box. A callee that returns a heap value moves it OUT of itself
	// (`parseReturnStatement` — the box leaves the callee's drop sets), so the CALLER becomes its sole
	// owner and must drop it once. Three return types own a droppable box, and the caller adopts each the
	// same way:
	//
	//   • a `returns String` — a fused heap record (a borrowed literal was promoted to one at the return);
	//   • a `returns Pair` — a struct box (`resolveNamedStruct` re-tags the `named` signature type to
	//     `structRef` first, so the result binds a struct and `p.first` resolves — the two-place agreement
	//     the tolerant sweep's `named` return could not make on its own);
	//   • a `returns Container` — a payload-bearing (boxed) union/enum box (`valueIsBoxedUnion`), the
	//     OPEN #44 case: a `named` result whose LAYOUT `isBoxed`, indistinguishable by tag from a bare
	//     enum value, which owns no box and is adopted by no one.
	//
	// Adoption is the one owned-temp door, `trackOwnedTemp`, exactly as an interpolation temporary rides:
	// `parseBinding` transfers a bound result to a scope-exit drop, `drainPendingTemps` frees an unbound
	// one after the consuming statement. A scalar / payload-free-enum result owns no heap and is enrolled
	// in nothing.
	function mintOwnedCallResult(inner MaxonType) returns ValueId
		// `resolveNamedStruct` re-tags a struct-`named` return to `structRef`; `resolveFloatAliasType` then
		// resolves a float-alias `named` return (`returns Float`) to `float` (F2a). Both are needed and
		// compose cleanly — a type is a struct, a float alias, an int alias or a scalar, never two — so the
		// result of a `returns Float` callee binds a `float` (XMM) value that `trunc` truncates and `return`
		// moves cleanly, rather than a `named` value the tag says is an int while the backend files it in XMM.
		let result = self.mintValueOfType(self.resolveNamedAlias(self.resolveFloatAliasType(self.resolveNamedStruct(inner))))
		if self.valueIsManagedHeap(result) 'adoptsHeapBox'
			self.trackOwnedTemp(result)
		end 'adoptsHeapBox'
		return result
	end 'mintOwnedCallResult'

	// ⭐ **A CALL THROUGH A FUNCTION VALUE** (P1.5-A1) — `f(21)`, `h.op(21)`, `pick()(21)`. The cursor sits
	// on the `(`; `callee` is the SSA value holding the code pointer (a `function`-tagged value produced by
	// a functionRef, a param, a field load, or another call). Arguments are POSITIONAL: a function type's
	// parameter names are documentation only, so there is nothing to label — `f(a, b)` is two positional
	// args, which a direct call would reject (rest-labelled), so indirect calls have their own arg parser.
	function parseIndirectCall(func IrFunction, callee ValueId, resultUsed bool) returns ValueId throws ParseError
		let anchor = self.current()
		try self.consume(TokenKind.leftParen)

		var args = try self.parseIndirectCallArgs(func)

		let rparenTok = try self.consume(TokenKind.rightParen)

		// ⭐ **THE ENV TRAVELS WITH THE VALUE — UNIFORMLY (P1.5-A2b-2).** Every indirect call passes an
		// environment as the trailing arg: the callee VALUE's own env when it carries one (a capturing closure's
		// block, or a function-typed parameter's companion env), else a materialized null. The uniform ABI is
		// what lets a callee that is only known to be `function(T) returns R` — a value passed DOWN to a generic
		// `apply(f, x)` — be called without static knowledge of whether it captures. `emitClosureEnvArg` answers
		// once, keyed on the value.
		args.push(self.emitClosureEnvArg(callee, range: SourceRange.between(anchor, last: rparenTok)))

		let result = try self.mintIndirectCallResult(callee, resultUsed: resultUsed, anchor: anchor)
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.indirectCall(result, callee: callee, args: args), range: SourceRange.between(anchor, last: rparenTok))
		return result
	end 'parseIndirectCall'

	// The POSITIONAL arguments of an indirect call — comma-separated expressions, no labels (a function
	// TYPE has no parameter names, so `indirectCall` carries no `argLabels`/`argRanges`; see MaxonDialect).
	// `parseValueExpression` (the climber plus a trailing ternary), not `parseExpression`, for
	// `parseCallArgs`' reason: an argument is parsed inside an expression that already seeded `currentBlock`.
	function parseIndirectCallArgs(func IrFunction) returns ValueIdArray throws ParseError
		var args = ValueIdArray.create()
		if self.at(TokenKind.rightParen) 'noArgs'
			return args
		end 'noArgs'

		while true 'argLoop'
			let argTok = self.current()
			let argValue = try self.parseValueExpression(func)

			// The same refusal the direct-call path makes: a capturing closure passed as an argument (here to
			// an indirect callee) has no env at the callee. Asked before the arg is appended, so the env the
			// indirect call itself later threads for a capturing CALLEE is never mistaken for one.
			try self.rejectCapturingClosureArg(argValue, tok: argTok)
			args.push(argValue)

			if not self.at(TokenKind.comma) 'endArgs'
				break
			end 'endArgs'
			try self.consume(TokenKind.comma)
		end 'argLoop'
		return args
	end 'parseIndirectCallArgs'

	// Mint the SSA value an indirect call defines, typed from the CALLEE FUNCTION VALUE's return type —
	// the mirror of `mintDeclaredCallResult` for a direct call. Here the return type is recovered from the
	// callee value's OWN function type (its governing name), and the value-returning tail
	// (`mintOwnedCallResult`) is shared, so an indirect call binds its result exactly as a direct one does.
	//
	// ⭐ A VOID FUNCTION VALUE IS REJECTED AT THE CALL WHEN ITS RESULT IS USED, exactly as a void DIRECT
	// call is (`resultUsed`, mirroring `mintDeclaredCallResult`). This UPHOLDS the invariant that
	// `maxonTypeOfTag`/`valueTagToStdType` assert — a `void` value is minted ONLY as a discarded statement
	// result, NEVER in a position that reads it. Without the guard, `let cb = doIt; let x = cb()` minted a
	// void value that reached `typeOf` and PANICKED, where the void DIRECT call `let x = doIt()` cleanly
	// reports E2004. Statement position (`resultUsed: false`, the point of #68) still mints the discarded
	// void value; every value position (`resultUsed: true` — a binding, `return`, an operand, an argument)
	// reports E2004 HERE, at the call, the same anchor and text the direct-call diagnostic uses.
	function mintIndirectCallResult(callee ValueId, resultUsed bool, anchor Token) returns ValueId throws ParseError
		match self.functionValueReturnType(callee) 'r'
			value(inner) then return self.mintOwnedCallResult(inner)
			void then break 'r'
		end 'r'

		// A VOID function value used where a value belongs. Reported with the callee's governing function
		// name (`functionValueReturnType` proved it resolvable to reach the `void` arm), the E2004 spelling
		// `mintDeclaredCallResult` renders for a void direct call.
		if resultUsed 'noValueToUse'
			throw ParseError.voidCallResultUsed(String.from(self.internedName(self.valueNameId(callee))), line: anchor.line, column: anchor.column)
		end 'noValueToUse'

		return self.mintValue(ValueTypeTag.void, nameId: UnnamedTypeId)
	end 'mintIndirectCallResult'

	// The RETURN type of a function VALUE, recovered from its governing name (see MaxonType's `function`
	// arm): a function-TYPEALIAS value reads its return from the function-alias registry; a functionRef
	// value's governing name IS a function, so its return is `returnTypeOf`. The two are disjoint — a name
	// is a function alias or a function, never both — so trying the alias first and the function second is
	// unambiguous.
	function functionValueReturnType(callee ValueId) returns MaxonReturnType
		let name = self.internedName(self.valueNameId(callee))

		// ⭐ **A LIFTED CLOSURE first (P1.5-A2a).** Its return type is FILE-LOCAL — the whole-program index
		// never saw it (see `closureReturns`) — so an indirect call through a closure bound to a local
		// (`let f = function(x) gives x*2; f(8)`) recovers it from here. Its `$`-suffixed name is unwritable
		// in source, so this can shadow no real function or alias; a non-closure name misses and falls
		// through to the two whole-program lookups below.
		if let closureReturn = try self.closureReturns.get(name) 'closure'
			return closureReturn
		end 'closure'

		match self.signatures.functionAliasOf(name) 'alias'
			declared(alias) then return self.functionAliasReturnType(alias)
			undeclared then break 'alias'
		end 'alias'

		match self.signatures.returnTypeOf(name, into: self.artifact.typeNames) 'fn'
			declared(returnType) then return returnType
			undeclared then panic("functionValueReturnType: a `function`-tagged value's governing name '{String.from(name)}' is neither a lifted closure, a function alias, nor a declared function — every function value is minted from one of the three (parseClosureExpression / parseTypeReference / emitFunctionRef)")
		end 'fn'
	end 'functionValueReturnType'

	// Reconstruct a function alias's declared return type from its interner-free (tag, name) storage (see
	// FunctionTypeAlias), re-interning the name into THIS file's interner. `void` means the function
	// returns nothing; a primitive return carries no name; a `named`/`structRef`/function return carries
	// the name it re-interns from.
	function functionAliasReturnType(alias FunctionTypeAlias) returns MaxonReturnType
		if alias.returnTag == ValueTypeTag.void 'voidReturn'
			return MaxonReturnType.void
		end 'voidReturn'

		let nameId = UnnamedTypeId if alias.returnTypeName.isEmpty() else self.artifact.typeNames.intern(alias.returnTypeName)
		return MaxonReturnType.value(maxonTypeOfTag(alias.returnTag, nameId: nameId))
	end 'functionAliasReturnType'

	// Parse an integer literal token into a `literal` op, and return the value it defines.
	// The token's text becomes a number through the shared `intLiteralValue`, so a literal
	// in an expression and a literal in a range bound are read the same way.
	function parseIntLiteral() returns ValueId throws ParseError
		let tok = try self.consume(TokenKind.intLiteral)
		let value = try self.intLiteralValue(tok, negated: false)
		return self.emitLiteral(value, valueType: MaxonType.integer, range: SourceRange.ofToken(tok))
	end 'parseIntLiteral'

	// Parse a FLOAT literal token into a `literal` op, and return the value it defines.
	//
	// ⭐ **THE LITERAL'S VALUE IS ITS IEEE-754 BIT PATTERN**, carried in the very same `ParsedInt`
	// payload an integer literal uses — and that is why a float costs NO new op at either tier.
	// `MaxonOp.literal` and `StdOp.const` already carry a `valueType` beside the bits, and the
	// type is what says how to READ them; 64 bits are 64 bits. v1 mints a second literal op
	// (`constF64`) and pays for it in every pass that has to match one.
	//
	// ⚠ These bits are deliberately NOT recorded as a parser constant, and the guard that stops it
	// is `emitLiteralIn`'s `tagIsInteger` — already there, written for the bool case, and load-
	// bearing here for a different one. A float in the fold columns would let `foldIntBinOp` ADD
	// TWO IEEE PATTERNS AS INTEGERS: `3.14 + 2.0` would fold to a number that is neither 5.14 nor
	// anything else, silently, at compile time.
	function parseFloatLiteral() returns ValueId throws ParseError
		let tok = try self.consume(TokenKind.floatLiteral)
		let bits = try self.floatLiteralBits(tok)
		return self.emitLiteral(bits, valueType: MaxonType.float, range: SourceRange.ofToken(tok))
	end 'parseFloatLiteral'

	// `-<numeric literal>` as ONE literal — see `parseUnary`'s note for why the negation belongs to
	// the literal rather than to an operator over it. Both halves read through the SAME decoders the
	// un-negated forms use (`intLiteralValue` with `negated: true`, `negatedFloatBits` over
	// `floatLiteralBits`), which is what makes a negated literal in an expression mean exactly what
	// the same text means in a range bound or a field default. The source range anchors on the `-`,
	// because that is where the literal now starts.
	function parseNegatedNumericLiteral(minusTok Token) returns ValueId throws ParseError
		if self.at(TokenKind.floatLiteral) 'float'
			let tok = try self.consume(TokenKind.floatLiteral)
			return self.emitLiteral(negatedFloatBits(try self.floatLiteralBits(tok)), valueType: MaxonType.float, range: SourceRange.ofToken(minusTok))
		end 'float'

		let tok = try self.consume(TokenKind.intLiteral)
		return self.emitLiteral(try self.intLiteralValue(tok, negated: true), valueType: MaxonType.integer, range: SourceRange.ofToken(minusTok))
	end 'parseNegatedNumericLiteral'

	// Append a `literal` op into the CURRENT block; return the ValueId it defines.
	function emitLiteral(value ParsedInt, valueType MaxonType, range SourceRange) returns ValueId
		return self.emitLiteralIn(self.currentBlock, value: value, valueType: valueType, range: range)
	end 'emitLiteral'

	// Append a `literal` op into a NAMED block. The short-circuit lowering needs this: its
	// seed literal belongs in the ENTRY block, which by the time the phi is wired is no
	// longer the current one.
	function emitLiteralIn(block IrBlock, value ParsedInt, valueType MaxonType, range SourceRange) returns ValueId
		let result = self.mintValueOfType(valueType)
		self.artifact.emitOp(block, op: MaxonOp.literal(result, value: value, valueType: valueType), range: range)

		// THE root of the parser's constant view. A `let` binds its NAME to the value the
		// initializer produced, so `let SHIFT = -1` binds `SHIFT` to this very id — which is why
		// folding a literal is all it takes to see a count named through a `let`.
		if tagIsInteger(maxonTypeTag(valueType)) 'integer'
			self.recordConst(result, folded: value)
		end 'integer'

		return result
	end 'emitLiteralIn'

	// --- token cursor ---

	// The token at an ABSOLUTE index, or a synthetic EOF once past the end. THE one place the
	// past-the-end rule is written down — `current`, `at`, `kindAt` and `peekKind` are all views
	// over this, so a cursor read and a scan read can never disagree about where the tokens stop.
	// The lexer already appends a real EOF, so the synthetic one is a belt-and-suspenders guard.
	function tokenAt(index TokenIndex) returns Token
		if index >= self.tokens.count() 'pastEnd'
			return Token.eof()
		end 'pastEnd'

		return try self.tokens.get(index) otherwise panic("Parser.tokenAt: index<count just checked but tokens.get({index}) failed")
	end 'tokenAt'

	// The token at the cursor.
	function current() returns Token
		return self.tokenAt(self.pos)
	end 'current'

	function at(kind TokenKind) returns bool
		return self.current().kind == kind
	end 'at'

	// The kind of the token at an ABSOLUTE index. The cursor-independent read the token-extent
	// scans need — `blockStatementEndIndex`, `namesAssignedIn` and `opensBlockAt` all walk the
	// token array without moving `pos`.
	function kindAt(index TokenIndex) returns TokenKind
		return self.tokenAt(index).kind
	end 'kindAt'

	// **THE token shape of a reassignment, asked at an ABSOLUTE index — and there is exactly ONE
	// of these on purpose.** Two callers ask it and they must never disagree:
	//
	//   • `parseStatement`, deciding that this statement IS a reassignment, and
	//   • `namesAssignedIn`, deciding which vars a loop CARRIES A PHI FOR.
	//
	// Written down twice, a new write form (a compound assignment, a store through a field) taught
	// to the dispatcher and not to the scan would compile: the statement would assign the var, the
	// loop would mint no phi for it, and the var would reset to its pre-loop value on every
	// iteration. A SILENT MISCOMPILE — and, unlike a `blockStatementEndIndex` mismatch, one no drift
	// guard can see, because the loop's EXTENT would still be perfectly correct. Teaching this one
	// predicate teaches both.
	//
	// ⚠ AND IT IS NOT ENOUGH TO MAKE THE NEW FORM MERELY *MATCH* — IT MUST NAME THE RIGHT VAR.
	// `a.b = x` already fits `identifier equals`, at `b`. So a field store taught to THIS predicate
	// would silently start inserting **`b`**, the FIELD, and never `a`, the var that carries the
	// loop value. The phi would be minted for a name nothing writes and withheld from the one that
	// does.
	//
	// ⭐ **THAT IS WHY FIELD STORES HAVE THEIR OWN PREDICATE — `fieldAssignsAt` — AND WHY THIS ONE
	// WAS NOT WIDENED** (P1.1a wave 2). `parseStatement` routes on both; `namesAssignedIn` reads
	// only this one, and that is CORRECT rather than an omission: **a field store assigns no
	// binding.** `p` is a box pointer that `p.x = 5` never reassigns — the write goes to MEMORY,
	// through `storeIndirect`, and the box's address is the same value afterwards. So there is no
	// loop-carried value to merge and no phi to mint.
	//
	// ⚠ `c.value = c.value + 1` DOES make this scan insert `value`, at the field token, and it is
	// harmless — but **for the over-approximation note's SHADOWING reason, not its "selects nothing"
	// one**, and the difference is worth stating because only one of the two survives a local of the
	// same name. With no local called `value`, the name binds nothing at the header and selects
	// nothing. With `var value` ALSO in scope it DOES select, and a header phi IS minted for a var
	// the loop never writes. That phi CARRIES NOTHING — every incoming value is the same one,
	// precisely because nothing assigns it — which is the shape `elimTrivialBlockArgs` exists to fold
	// away (see PassPipeline). MEASURED rather than argued: that program returns 102, the right
	// answer.
	//
	// ⚠ A write with NO `=` ANYWHERE cannot be covered by either half of the above, because it is
	// not a statement to teach the dispatcher about: a `var` PARAMETER is written by `mutate(p)`
	// at the call site. `ParametersAreMutable` is the tripwire for that one — see `namesAssignedIn`.
	function assignsAt(index TokenIndex) returns bool
		return self.kindAt(index) == TokenKind.identifier and self.kindAt(index + 1) == TokenKind.equals
	end 'assignsAt'

	// **The token shape of a FIELD STORE** — `<base> . <field> =`, asked at an ABSOLUTE index.
	//
	// Deliberately NOT folded into `assignsAt`: see there. The two are disjoint by construction (the
	// token after the base is `=` for one and `.` for the other), so `parseStatement` may ask them
	// in either order and get the same answer.
	//
	// `p.x == y` cannot be mistaken for a store: `==` lexes as a single `equalsEquals` token. Nor
	// can `Point.create(…)`, whose token at +3 is `(`.
	//
	// ⭐ **A CHAIN `o.inner.x =` matches too** (P1.4a wave 2): the base identifier is followed by ONE OR
	// MORE `.identifier` hops and then a single `=`. `resolveFieldChain` reads exactly this shape, so the
	// dispatch predicate and the parser agree on where a chained store begins and ends. A `.method()` chain
	// ends in `(` (not `=`) and a comparison in `==`, so neither is mistaken for a store.
	function fieldAssignsAt(index TokenIndex) returns bool
		if self.kindAt(index) != TokenKind.identifier 'notBase'
			return false
		end 'notBase'
		var q = index + 1
		var hops = 0
		while self.kindAt(q) == TokenKind.dot and self.kindAt(q + 1) == TokenKind.identifier 'hop'
			hops = hops + 1
			q = q + 2
		end 'hop'
		return hops > 0 and self.kindAt(q) == TokenKind.equals
	end 'fieldAssignsAt'

	// **The token shape of an EXPLICIT self-field store** — `self . <field> =`.
	//
	// Its own predicate rather than a widening of `fieldAssignsAt`, because `self` is a KEYWORD and
	// not an identifier — and, more to the point, for `fieldAssignsAt`'s own reason: it assigns no
	// BINDING, so `namesAssignedIn` must not see it. (The BARE spelling `count = 5` DOES match
	// `assignsAt` and is deliberately left to; see there.)
	function selfFieldAssignsAt(index TokenIndex) returns bool
		return self.kindAt(index) == TokenKind.self and self.kindAt(index + 1) == TokenKind.dot and self.kindAt(index + 2) == TokenKind.identifier and self.kindAt(index + 3) == TokenKind.equals
	end 'selfFieldAssignsAt'

	// **The token shape of an INSTANCE METHOD CALL** — `<base> . <name> (`, where `<base>` names a
	// value IN SCOPE (a binding, or the `self` keyword's receiver).
	//
	// ⭐ **THE SCOPE TEST IS THE WHOLE PREDICATE**, because the token shape alone cannot tell
	// `c.increment()` from `Point.create()` — they are identical. What separates them is that one
	// base is a VALUE and the other is a TYPE NAME, and only the scope knows which.
	//
	// Asked at an ABSOLUTE index by `parseStatement` and at the cursor by
	// `parseDottedPrimary`/`parseSelfPrimary`, so the statement and expression positions cannot come
	// to disagree about what a method call looks like — which they would, since a method call is
	// legal in both and only one of them may discard the result.
	//
	// ⚠ A STATIC call in statement position stays unsupported, and that is deliberate rather than an
	// oversight of this predicate: `Point.create()` on a line of its own discards a value, and for a
	// factory that value is a box nothing would then free.
	function methodCallsAt(index TokenIndex) returns bool
		let baseKind = self.kindAt(index)
		if baseKind != TokenKind.identifier and baseKind != TokenKind.self 'notABase'
			return false
		end 'notABase'
		if self.kindAt(index + 1) != TokenKind.dot or self.kindAt(index + 2) != TokenKind.identifier or self.kindAt(index + 3) != TokenKind.leftParen 'notADottedCall'
			return false
		end 'notADottedCall'
		// A LOCAL receiver, a CAPTURED enclosing one (`b.doubled()` inside a closure — P1.5-A2b-2), or a
		// top-level MANAGED BINDING (`Live.count()` — P1.7a; `msg.append("!")` — P1.7 slice 2a). Each is a
		// VALUE the method dispatches on, which is what separates it from a static call on a TYPE name. The
		// managed binding is asked LAST because it is the only one of the three that can allocate (see
		// `managedTopLevelBaseAt`), and a local or captured base has already answered by then.
		//
		// ⚠ **THAT ORDER IS ALSO THE SHADOWING RULE, AND IT MUST MATCH `parseMethodCall`'S ARMS EXACTLY.**
		// Cheapest-first and local-then-capture-then-top-level happen to agree here, which is what makes the
		// agreement easy to break: a reorder for cost alone would silently re-point a name that a closure
		// captures at a same-named global. `parseMethodCall` carries the measurement of what that cost —
		// two resolutions of one name in one expression, neither a compile error.
		//
		// ⚠ The managed binding is ALSO the only one of the three whose name can belong to a declared
		// TYPE as well — which is why it, alone, has to weigh itself against the type-based readings of
		// this same shape (`staticCallClaimsBase`) rather than simply claiming it.
		let baseTok = self.tokenAt(index)
		if self.scope.contains(self.baseBindingName(baseTok)) or self.captureBinds(baseTok) 'localOrCaptured'
			return true
		end 'localOrCaptured'

		// The GATE first and the resolution second, in that order and never fused: the gate is a bool and
		// allocates nothing, and everything past it boxes a union (see `managedTopLevelBaseAt`). A
		// LOOKAHEAD can only answer yes/no anyway — it runs at token shapes the parser has not committed
		// to, so there is nowhere to hand a resolution even if it had one.
		if not self.managedTopLevelBaseAt(index) 'notAManagedBase'
			return false
		end 'notAManagedBase'

		return match self.managedReceiverBindingOf(baseTok) 'managed'
			constant to global gives true
			none gives false
		end 'managed'
	end 'methodCallsAt'

	// **The token shape of a `__Builtins` INTRINSIC CALL STATEMENT** — `__Builtins . <member> (`, the one
	// qualified call shape that IS a statement (see the `builtinsIntrinsicStmt` arm for why the others are not).
	//
	// It asks the intrinsic table's OWN question, `isBuiltinsIntrinsicCallee`, of the name `parseQualifiedCall`
	// is about to mangle out of these same two tokens — rather than comparing the base token against a second
	// spelling of `__Builtins`. A second spelling is how the statement door and the intrinsic table would come
	// to disagree about which qualifier belongs to the compiler, and the failure would be silent in the worst
	// direction: a statement accepted here and then rejected as an unknown intrinsic three functions later.
	//
	// ⚠ **THE NAME IS BUILT BY THE SAME EXPRESSION `parseQualifiedCall` USES, `qualifiedCallBaseName` INCLUDED**,
	// and that call is not decoration. Deriving the callee here as a bare `qualifiedMethodName(baseToken, …)`
	// agrees with the real parse only for as long as `qualifiedCallBaseName` is the identity on every name that
	// can reach this shape — true today (it rewrites a GENERIC ALIAS to its base struct, and no user name may
	// wear the `__` prefix), and exactly the kind of premise that quietly stops holding. Two derivations of one
	// name is the duplication this predicate was written to avoid, so it makes the one call rather than
	// re-deriving a name that merely happens to match.
	//
	// The mangling allocates, and it is on a COLD path by construction: the shape is asked only after every
	// cheaper statement form has declined, and `methodCallsAt` has already claimed every qualified shape whose
	// base is a value in scope — so what reaches here is a static-call-shaped statement, which is either an
	// intrinsic or a program that is about to be refused.
	function builtinsIntrinsicCallsAt(index TokenIndex) returns bool
		if self.kindAt(index) != TokenKind.identifier or self.kindAt(index + 1) != TokenKind.dot or self.kindAt(index + 2) != TokenKind.identifier or self.kindAt(index + 3) != TokenKind.leftParen 'notAQualifiedCall'
			return false
		end 'notAQualifiedCall'

		return isBuiltinsIntrinsicCallee(qualifiedMethodName(self.qualifiedCallBaseName(self.tokenAt(index).value), methodName: self.tokenAt(index + 2).value))
	end 'builtinsIntrinsicCallsAt'

	// The kind of the token ONE past the cursor. The parser's two-token lookahead:
	// distinguishing a reassignment (`ident =`) from a bare identifier statement (`ident …`)
	// needs to see the `=` without committing to consuming the identifier first — and it is
	// the same question `namesAssignedIn` asks of every token in a loop's extent, which is why
	// both read it through `kindAt` and the past-the-end rule lives in exactly one place.
	function peekKind() returns TokenKind
		return self.kindAt(self.pos + 1)
	end 'peekKind'

	function isEof() returns bool
		return self.at(TokenKind.eof)
	end 'isEof'

	function advance()
		if self.pos < self.tokens.count() 'inRange'
			self.pos = self.pos + 1
		end 'inRange'
	end 'advance'

	// Consume a token of the expected kind, or throw a positioned mismatch error.
	// A TokenKind's `.rawValue` is its human-readable display text ("(", "return").
	function consume(kind TokenKind) returns Token throws ParseError
		let tok = self.current()
		if tok.kind != kind 'mismatch'
			throw ParseError.unexpectedToken(kind.rawValue, got: tok.kind.rawValue, line: tok.line, column: tok.column)
		end 'mismatch'
		self.advance()
		return tok
	end 'consume'

	// Advance the cursor past any newlines — `indexPastNewlines` applied to the cursor, so the MOVER and the
	// LOOKAHEAD read one definition of "which tokens are layout" rather than two copies of it. Two copies
	// would not fail loudly if they drifted: a lookahead that disagreed with the mover would silently route
	// `[10\n]` down a different path from `[10]` (the int fast path settles an element's type off exactly
	// that question), and a wrong element type is a wrong answer, not a compile error.
	function skipNewlines()
		self.pos = self.indexPastNewlines(self.pos)
	end 'skipNewlines'

	// The first index at or after `index` that is not a newline — the LOOKAHEAD form, moving no cursor, and
	// the one definition `skipNewlines` above is derived from. A lookahead that counted newlines as tokens
	// would answer a question about the source's LAYOUT where the asker meant one about its shape: `[10]` and
	// `[10\n]` are the same literal, and the two must not take different paths through the parser. `tokenAt`
	// answers `eof` past the end, so this terminates.
	function indexPastNewlines(index TokenIndex) returns TokenIndex
		var scan = index
		while self.kindAt(scan) == TokenKind.newline 'skip'
			scan = scan + 1
		end 'skip'
		return scan
	end 'indexPastNewlines'

	// Consume an optional block label (`'name'`, a charLiteral) after `end`.
	function skipOptionalLabel()
		if self.at(TokenKind.charLiteral) 'label'
			self.advance()
		end 'label'
	end 'skipOptionalLabel'
end 'Parser'
