		if needsCountParam 'seedCountParam'
			self.fixedElementCountParamValueId = fixedElementCountSlotValueId(paramCount, witnessParamCount: witnessParamCount)
			self.recordValueType(MaxonType.integer)
			self.artifact.recordParamOrigin(self.fixedElementCountParamValueId, range: SourceRange.ofToken(nameTok))
		end 'seedCountParam'

