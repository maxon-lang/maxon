// Parser — the M1 recursive-descent slice.
//
// shv2 keeps v1's "direct-emit" contract: the parser emits Maxon-dialect IR ops
// directly onto blocks (no AST). Two structural changes from v1:
//
//   1. It writes exclusively into a per-file `FileParseArtifact` — its own
//      MaxonModule fragment, its own local type-name interner, and its own
//      registry contributions — and takes NO `Project` (PLAN.md). Per-file parse
//      is therefore a pure function of `(tokens, filePath, namespace)` with no
//      shared state; `mergeArtifact` folds the result into `Project` later.
//   2. **Value numbering is born HERE.** Each op's result gets a dense, function-
//      local `ValueId` from `self.valueIds` at emit time. v1 instead named values
//      with synthetic `$tN` strings and re-derived the ids in `lowerMaxonToStd`
//      from a second counter — paying a heap String + ByteArray per value plus a
//      byte-keyed hash map to undo it. See MaxonDialect's MaxonOp header.
//
// Anything outside the parsed slice is rejected with a positioned diagnostic. What
// the slice covers: free functions (parameters, calls with `name:` labels, an
// optional `returns` clause), ranged `typealias` declarations, `let`/`var` bindings
// and reassignment, `if`/`else`/`while` with `break`/`continue`, integer and bool
// literals, parenthesized grouping, arithmetic, comparison, and type-qualified numeric
// bounds. What it does NOT: user types, generics, strings, floats, logical operators.
//
// THREE THINGS THIS FILE OWNS THAT ARE NOT OBVIOUS FROM ITS SHAPE:
//
//   1. NAME RESOLUTION, INCLUDING LEXICAL BLOCK SCOPING. `Scope` is threaded through
//      the parse, and each `if`/`else`/`while` body is a scope FRAME (parseBlockBody),
//      so a binding declared in a block is gone at its `end` and may legally shadow an
//      outer one while it lives. An unbound name is a parse-time diagnostic.
//   2. ON-THE-FLY SSA. There is no AST and no `mem2reg`: a `let`/`var` binds a name
//      straight to the SSA value its initializer produced, and the block-args (phis)
//      that merge those values across branches and loops are minted HERE, as the
//      control flow is parsed. Mutable bindings are tracked BY REFERENCE for it — see
//      LoopPhiVar for the shadowing hazard that forces that.
//   3. THE IMPLICIT RETURN. A void function's body carries no `return`, so the parser
//      supplies its terminator (closeFunctionBody) — and reports E3013 when a
//      value-returning body can fall off its end instead.

// Cursor position into the token array. Wide range: token counts are unbounded. Exported because a
// top-level constant's declaration records the token RANGE of its initializer (SignatureIndex's
// `TopLevelDecl`) rather than a tree of it.
export typealias TokenIndex = int(0 to u64.max)

// How many blocks are open around a token. 0 is FILE SCOPE — the depth at which a `let` is a
// top-level constant rather than a body-local binding (see `foldDeclaredSignaturesInto`). Wide
// range: nesting is unbounded.
typealias BlockDepth = int(0 to u64.max)

// The custom ABI passes arguments in six registers (StdToX64Conversion.argRegisters), so
// M5 caps a function at six parameters. A seventh would need a stack argument slot — a
// later milestone — so the parser rejects it up front with a positioned `unsupported`
// rather than letting it reach the backend as a crash.
let MaxRegisterParams = 6 as ParamCount

// The displacement from a top-level `var`'s `globalAddr` to the value itself: ZERO, because every
// global is its OWN labelled `.data` slot and the label already names the exact address.
//
// Named rather than written `0` at the three emit sites, because the zero is a CLAIM ("this label
// names this value, with nothing in front of it") and not an arithmetic accident — P1.1's `point.x`
// goes through the very same `loadIndirect`/`storeIndirect` ops with a real field offset, and at
// that point the two must be told apart by a reader.
let GlobalSlotOffset = 0 as ByteOffset

// The parser's failure modes. Distinct from NumberParsing's `ParserError` (which
// `parseIntLiteral` catches and re-raises as `integerOverflow`). queryParseOps
// turns a thrown `ParseError` into a project diagnostic — the parser itself never
// touches `Project`.
export union ParseError implements Error
	unexpectedToken(expected String, got String, line LineNumber, column ColumnNumber)
	// A primary expression was required but the token stream had something else
	// (e.g. an operator where an operand belongs). Distinct from `unexpectedToken`:
	// it renders as E2004 `Expected expression but got '<got>'` (no quotes around
	// `expression`), the exact text `unary-operators.md`'s double-negation gates on
	// — `- -x` fails at the second `-`, since a unary operand is a PRIMARY.
	expectedExpression(got String, line LineNumber, column ColumnNumber)
	unexpectedEof(line LineNumber, column ColumnNumber)
	integerOverflow(line LineNumber, column ColumnNumber)
	// A float literal whose magnitude exceeds what an f64 can represent (`1e400`). A SEPARATE
	// variant from `integerOverflow` rather than a reuse of it: they share an error CODE (the
	// literal is out of its type's range either way), and they must not share a MESSAGE, because
	// "Integer literal out of range" pointed at `1e400` names the wrong type and the wrong limit.
	floatLiteralOverflow(line LineNumber, column ColumnNumber)
	// An INTEGRAL-ONLY operator (`mod`, the bit band, or a prefix `not`) applied to a float. Both
	// the binary and the unary raiser reach it, because it is one rule — see
	// `TypeRules.operatorIsIntegral`, which is where the operator set is decided, and
	// `notOperatorFor`'s float arm.
	nonIntegralOperands(op String, operand String, line LineNumber, column ColumnNumber)
	// ⭐ A float meeting a declared INTEGER — at a `return`, an assignment, or a global store.
	// ONE variant for every coercion site the parser owns, because they are one rule
	// (`TypeRules.checkDeclaredType`) and one fact, and the message must not vary with the site
	// that noticed. The call-argument site is SemanticCheck's — the callee's signature is not the
	// parser's to see — and it reports the same code with the same words.
	implicitNarrowing(sourceType String, targetType String, line LineNumber, column ColumnNumber)
	// A compiler BUILTIN called with the wrong number of arguments. It is the parser's to report
	// and not SemanticCheck's, because a builtin has no entry in the signature registry that
	// SemanticCheck's arity check reads — there is nothing there to disagree with.
	builtinArity(name String, expected ParamCount, got ParamCount, line LineNumber, column ColumnNumber)
	// A compiler builtin whose argument is the wrong type (`trunc(flag)`, `print(5)`). Same reason as
	// `builtinArity`: no signature exists for the ordinary argument check to consult. `required` names
	// what the builtin DOES accept ("number" for `trunc`, "String" for `print`), because the two differ
	// and a fixed word would be wrong for one of them.
	builtinOperandType(name String, required String, got String, line LineNumber, column ColumnNumber)
	unsupported(feature String, line LineNumber, column ColumnNumber)
	// A parameter list that repeats a name (`function f(x int, x int)`). The second
	// binding would be a dead, uncallable parameter, so it is rejected at parse time.
	// Renders as E2014, positioned at the repeated name.
	duplicateParameter(name String, line LineNumber, column ColumnNumber)
	// A reference to a name with no binding in scope. Distinct from
	// `unexpectedToken` (a syntactic mismatch): this is a name-resolution failure,
	// which the parser can detect because `Scope` is threaded through it.
	undefinedVariable(name String, line LineNumber, column ColumnNumber)
	// A reassignment (`x = expr`) whose target was declared `let` (immutable). M4b
	// added assignment; only `var` bindings accept it. Renders as E2013.
	assignToImmutable(name String, line LineNumber, column ColumnNumber)
	// A `break`/`continue` with no enclosing loop. `keyword` is "break"/"continue"
	// for the message. Renders as E2047.
	controlOutsideLoop(keyword String, line LineNumber, column ColumnNumber)
	// A labelled `break 'l'`/`continue 'l'` whose label names the INNERMOST loop —
	// redundant (a plain `break`/`continue` already targets it). Renders as E2048.
	labelTargetsOwnLoop(keyword String, label String, line LineNumber, column ColumnNumber)
	// A labelled `break 'l'`/`continue 'l'` whose label matches no enclosing loop.
	// Renders as E2047.
	unknownLoopLabel(keyword String, label String, line LineNumber, column ColumnNumber)
	// A call whose FIRST argument carries a `name:` label — the first argument is
	// positional, only the 2nd and later take labels. Renders as E2052. A syntactic
	// rule the parser checks without the callee's signature.
	firstArgNamed(line LineNumber, column ColumnNumber)
	// A call whose 2nd-or-later argument has NO `name:` label. Renders as E2053. The
	// symmetric syntactic rule to `firstArgNamed`.
	argMissingLabel(line LineNumber, column ColumnNumber)
	// A VALUE-returning function whose body can fall off its end without returning.
	// Renders as E3013, positioned at the function's name. Detected here, not in a
	// later pass, because the parser is what knows the block its last statement left
	// control in — and whether that block ever got a terminator.
	missingReturn(name String, line LineNumber, column ColumnNumber)
	// A `return <expr>` inside a function that declares NO return type. Renders as
	// E3005 (a type mismatch: the function's declared result is nothing, and `<expr>`
	// is not nothing), positioned at the `return`.
	returnValueFromVoid(name String, line LineNumber, column ColumnNumber)
	// A BARE `return` inside a function that DOES declare a return type — a path that
	// leaves the function with no value to return. Renders as E3013, the same code as
	// falling off the end, because it is the same defect wearing a `return` keyword.
	// Positioned at the `return`, which is where the missing value belongs.
	returnWithoutValue(name String, line LineNumber, column ColumnNumber)
	// A WORD operator (`and`/`or`/`xor`) whose operands are one `bool` and one `int` — in
	// either order, and on either of the two paths such an operator can take (a `binOp`, or
	// the short-circuit lowering). Renders as E3005 (a type mismatch), positioned at the
	// operator. See TypeRules' `BinOpOperands.mixedWordOperands` for why a mixture has no
	// reading at all. v1 reports the identical case with the identical message
	// (Parser.maxon:11771).
	operandTypeMismatch(op String, line LineNumber, column ColumnNumber)
	// An ARITHMETIC / DIVISION / SHIFT operator with a non-numeric operand — `4 + flag`,
	// `flag shl 4`, `true + false`. Renders as E2004 (`Cannot operate on int and bool`),
	// positioned at the operator, which is the code, text and anchor the C# bootstrap uses
	// (2-Parser.cs:17785). Both operand type names ride along because the message names both.
	nonNumericOperands(left String, right String, line LineNumber, column ColumnNumber)
	// A prefix `-` applied to a non-numeric operand (`-flag`). The same rule as
	// `nonNumericOperands`, asked of the one operand a unary has. Renders as E2004,
	// positioned at the `-`. The bootstrap has no diagnostic for this at all — it reaches its
	// lowering and dies with an internal error (E9001 `Unsupported binop: Sub on Bool`), which
	// is a bootstrap BUG, not a spec.
	nonNumericNegation(operand String, line LineNumber, column ColumnNumber)
	// A `shl`/`shr` whose count the compiler FOLDED and found NEGATIVE — `a shl -1`, `a shl -(1)`,
	// `let SHIFT = -1` … `a shl SHIFT`. Renders as E2054, positioned at the count as written. The
	// count rides along because the message names it.
	//
	// A negative count is not a shift the other way: masked, `a shl -1` silently became
	// `a shl 63` — the MAXIMUM left shift, a wrong answer with the opposite sign.
	//
	// ⚠ A count of 64 OR MORE IS NOT THIS ERROR. It is a legal, well-defined shift that moves
	// every bit out (`x shl 64` == 0), and `Parser.emitShift` folds it to that. Rejecting it —
	// which this diagnostic did before the rule was narrowed to Go's — OVER-rejects a correct
	// program, which in this codebase is the worse failure.
	shiftCountNegative(count ParsedInt, line LineNumber, column ColumnNumber)
	// A comparison whose operands are in different type classes (`4 < flag`). Renders as
	// E3005 with the bootstrap's exact text — `type mismatch: 'cannot compare int with bool'`
	// (2-Parser.cs:17777) — positioned at the comparison operator. A comparison over two
	// bools is LEGAL (`a == b`); it is the MIXTURE that is meaningless, because the compare
	// would be over the bool's 0/1 payload rather than over anything the source wrote.
	comparisonTypeMismatch(left String, right String, line LineNumber, column ColumnNumber)
	// An `if` / `while` condition that is not a `bool` (`if 4`). Renders as E3005, positioned
	// at the CONDITION's first token — the expression the message is about, not the keyword
	// that introduced it. `keyword` is "if"/"while", so one message template serves both.
	//
	// AUTHORED, not ported: the C# bootstrap accepts `if 4` through its front end and then
	// fails an internal cast in its Maxon→Std lowering, reporting E9001 (an INTERNAL-ERROR
	// code, with a .NET stack trace). An internal error leaking to a user is a bootstrap bug —
	// it names no source position and describes no defect in the program — so it is not a
	// diagnostic to copy. shv2 rejects the condition where the type is known: in the parser.
	nonBoolCondition(keyword String, got String, line LineNumber, column ColumnNumber)
	// A reassignment whose value does not agree with the target binding's DECLARED type
	// (`var x = 5` then `x = true`). Renders as E3005, positioned at the variable name — the
	// same anchor `assignToImmutable` uses, because it is the same statement failing for the
	// other reason a binding can refuse a value. See `parseAssignment` for why this one check
	// is what makes every merge phi's type honest.
	assignTypeMismatch(name String, got String, expected String, line LineNumber, column ColumnNumber)
	// A `return <expr>` whose value's type class differs from the function's declared return
	// type (`return flag` from a function declared `returns Integer`). Renders as E3005 with
	// the bootstrap's exact text — `Cannot return 'bool' from function declared to return
	// 'int'` (2-Parser.cs:7840) — positioned at the `return`. The declared type prints as its
	// RESOLVED primitive, which is what the bootstrap prints (see TypeRules' typeTagName).
	returnTypeMismatch(got String, expected String, line LineNumber, column ColumnNumber)
	// A `not` whose operand's type the parser cannot determine. Since the whole-program signature
	// index landed, that is reachable only for a call to a function NO FILE DECLARES — a program
	// already doomed (E3004). Renders as E3005, positioned at the `not`. It is a REJECTION rather
	// than a guess because `not`'s two readings disagree about the VALUE: the bitwise complement
	// of a bool is -1 or -2, and both read as TRUE (see `notOperatorFor`).
	notOnUnknownType(line LineNumber, column ColumnNumber)
	// A call to a VOID function used where a VALUE belongs — `let x = noop()`, `return noop()`,
	// `if noop()`, `noop() + 4`. Renders as E2004 with the C# bootstrap's exact text ("Function
	// 'noop' does not return a value"), positioned at the callee name, which is the bootstrap's
	// anchor too.
	//
	// The parser is the right tier and the CALL SITE is the right anchor, because the parser is the
	// only place that knows which of the two call positions this is: the grammar has exactly two
	// (a bare-call STATEMENT, whose whole purpose is to discard the result, and a call inside an
	// EXPRESSION, which needs one), and `parseCall`'s `resultUsed` is that distinction.
	//
	// It was silently ACCEPTED before the signature index, and the deferral is not what broke it:
	// `calleeResultType` reported a void callee as `MaxonType.unresolved` — the SAME sentinel it
	// used for "I could not see this callee" — so TypeRules classified "there is no value" as "I
	// cannot judge this value", and every rule correctly deferred on it. One sentinel, two
	// meanings. `ValueTypeTag.void` is now the other one.
	voidCallResultUsed(name String, line LineNumber, column ColumnNumber)
	// A character literal whose body is not one character: `''`, or a `\` escape the
	// decoder does not know. Renders as E2016, positioned at the literal. (A literal that
	// is a valid but MULTI-BYTE character — `'é'`, an emoji — is not this: it is a
	// legitimate program shv2 cannot yet compile, so it reports as `unsupported`.)
	invalidCharacterLiteral(reason String, line LineNumber, column ColumnNumber)
	// --- The top-level constant arms (P1.0d.5a) ---
	//
	// All three are raised by the CONSTANT EVALUATOR, which runs inside the whole-program
	// declaration sweep and so has no business reporting anything itself (`foldDeclaredSignaturesInto`
	// is deliberately tolerant). They are recorded on the declaration and re-thrown here, by the real
	// parse, when it reaches the `let` that owns them — see `TopLevelConstant.failed`. That they are
	// ParseErrors and not a private error space is the point: `reportParseError` is already the one
	// place a parse-time diagnostic becomes a project diagnostic, and a second mapper would be a
	// second opinion about which code means what.
	//
	// A set of top-level constants that reference each other in a closed chain, so none of them can
	// be evaluated. `names` lists the cycle's members in the order the evaluator met them. Renders as
	// E2012, positioned at the LAST-DECLARED member's name — see `ProgramSignatures.recordCycle`.
	circularConstants(names String, line LineNumber, column ColumnNumber)
	// A CALL in a top-level constant's initializer (`let RESULT = compute()`). Renders as E2045,
	// positioned at the callee's name. A call is not a constant expression: its answer needs the
	// program to be RUNNING, and a top-level `let` is folded before any of it exists. Both reference
	// compilers reject it with this exact text (2-Parser.cs:5280-5284; v1's `rejectCallInitializer`,
	// Parser.maxon:3971-3982).
	functionCallInConstant(callee String, line LineNumber, column ColumnNumber)
	// A top-level constant's initializer that the evaluator folded only in PART — it stopped at a
	// token it could not evaluate, with more of the line still to go. Renders as E2045, positioned at
	// the first token it could not fold.
	//
	// ⚠ WITHOUT THIS THE REMAINDER IS SILENTLY DISCARDED, and the declared value quietly becomes
	// something else. It is the failure mode the token-range model has and a tree model does not, and
	// the bootstrap pays for it in the same coin (`ExpectConstInitializerFullyConsumed`,
	// 2-Parser.cs:4971-4987, whose comment records `let B = "lit".toByteArray()` folding to the String
	// "lit" and only surfacing far away, at a use site, as a type mismatch).
	nonConstantInitializer(name String, leftover String, line LineNumber, column ColumnNumber)
	// A name in a top-level constant's initializer that no visible constant declares. Renders as
	// E2004 with the bootstrap's own text (2-Parser.cs:4950) — the same code its sibling
	// `undefinedVariable` reports under, because it is the same defect: a name with no binding. It is
	// a DISTINCT arm because the two are found by different machinery and say different words: at file
	// scope there is no `Scope` to have looked in, and "variable" would name something the source did
	// not write.
	undefinedConstant(name String, line LineNumber, column ColumnNumber)
	// A `/` or `mod` BY ZERO in a top-level constant's initializer (`let X = 1 / 0`), or the one other
	// integer division with no answer (`i64.min / -1`). Renders as E2045, positioned at the operator.
	//
	// A runtime `x / 0` is a trap, and shv2 lets it reach the hardware (OPEN.md #2). A CONSTANT one
	// cannot: there is no run time to trap in, because the fold happens before the program exists. So
	// there is no answer to give and no later pass that could give one, and the only honest move is to
	// reject it where it is written.
	//
	// AUTHORED, not ported — neither reference compiler gets this right. The bootstrap evaluates a
	// constant `1 / 0` through C#'s DOUBLE division and silently declares the constant Infinity
	// (2-Parser.cs:5113-5137); v1 has no division in constant expressions at all (its
	// `UnresolvedConstExpr` union carries `add`/`sub`/`mul` and no `div` — Project.maxon:3401-3423),
	// so the question never reaches it.
	constantDivisionByZero(op String, line LineNumber, column ColumnNumber)
	// --- The struct arms (P1.0r) ---
	//
	// A struct literal (`Point{…}`) written outside the type's OWN methods. Renders as E3076,
	// positioned at the type name. Construction is restricted to the type's own methods and static
	// factories so a type's invariants have a SINGLE enforcement point — an external caller goes
	// through `Point.create(…)`. Both reference compilers impose the identical restriction under
	// the identical code.
	constructorRestricted(typeName String, line LineNumber, column ColumnNumber)
	// A field access (`p.x`) naming a field the struct does not declare. Renders as E3018,
	// positioned at the FIELD name — the token that is wrong, not the value it is read from.
	unknownField(typeName String, fieldName String, line LineNumber, column ColumnNumber)
	// A struct literal that omits a field the declaration gives no DEFAULT for. Renders as E3086,
	// positioned at the type name.
	//
	// ⚠ It is NOT tolerated by the allocator's zeroing guarantee, and that is worth saying because
	// the guarantee makes it look safe: an omitted slot would read back as 0, which is a plausible
	// number and therefore a WRONG ANSWER rather than a crash. `Point{x: 1}` would have `y == 0`
	// and nothing would say so.
	//
	// Field DEFAULTS (P1.1a wave 2) are what make an omission legal, and they NARROW this arm
	// rather than removing it: `applyFieldDefaults` fills every omitted slot that declares one
	// BEFORE `requireAllFieldsInitialized` looks, so what reaches here is a slot with no value from
	// either source. The message's "and it has no default value" is now a statement of fact.
	fieldNotInitialized(typeName String, fieldName String, line LineNumber, column ColumnNumber)
	// A struct literal that names one field twice (`Point{x: 1, x: 2}`). Renders as E3018 — the
	// same code an unknown field reports, because it is the same defect from the other side: the
	// literal's field list does not correspond to the type's. Positioned at the repeated name.
	duplicateFieldInitializer(typeName String, fieldName String, line LineNumber, column ColumnNumber)
	// --- The field-mutability arm (P1.1a wave 2) ---
	//
	// A write to a field declared `let` — `c.version = 2` where `version` is `export let`. Renders
	// as **E2013, the SAME code as `assignToImmutable`**, because it is the same defect reached
	// from the other side: a write to something declared not to accept one. A second code would
	// split one rule across two numbers, and a reader hitting either wants the identical advice.
	// (Precedent for many-variants-one-code: `unknownLoopLabel` reports `ErrorCode.controlOutsideLoop`.)
	//
	// It is a DISTINCT arm rather than a reuse of `assignToImmutable` because the two must say
	// different words — that one names a VARIABLE, and "cannot assign to immutable variable:
	// 'version'" would name something the source did not write, and would not tell the reader that
	// `var version` is the fix.
	//
	// ⚠ Positioned at the ROOT VARIABLE token, NOT the field — measured from the bootstrap, and
	// pinned at `:16:2` by `structs.md`'s `error.let-field-assign`.
	assignToImmutableField(typeName String, fieldName String, line LineNumber, column ColumnNumber)
	// --- The instance-method arms (P1.1a wave 3) ---
	//
	// A local or a parameter inside an instance method taking the name of a field of the enclosing
	// type — `let count = 5`, or `function bump(count Integer)`, inside a `type Counter` that
	// declares `count`. Renders as **E3006**, whose registry entry already covers this shape ("a
	// local declaration inside an instance method whose name collides with a `self.field`") beside
	// the duplicate-function one; the two are one fact — a name declared twice where exactly one
	// binding is legal.
	//
	// It is a REJECTION rather than a shadow, and the bootstrap's own message says why: the field
	// and the local would share one name-keyed entry, so every later read and write in the method
	// would silently resolve to whichever won. Positioned at the COLLIDING declaration, never at
	// the field — the local is what has to be renamed.
	localShadowsSelfField(name String, typeName String, line LineNumber, column ColumnNumber)
	// A read or a write of a field not declared `export`, from outside the type that declares it.
	// Renders as **E3014**. Positioned at the FIELD token — the name that is not accessible —
	// which is the bootstrap's anchor for the read (`:15:11`) and the write (`:15:4`) alike, and
	// is deliberately NOT `assignToImmutableField`'s root-variable anchor: that one is advice
	// about the BINDING (`var p`), this one is about the field itself.
	unexportedFieldAccess(typeName String, fieldName String, line LineNumber, column ColumnNumber)
	// --- The scalar-match arms (P1.1b wave A) ---
	//
	// A stray token where a match EXPRESSION arm has finished — the `and` of an `and fallthrough`
	// after a `gives` arm. Renders as **E2001** `unexpected token: '<got>'`, positioned at the
	// stray token, exactly as both reference compilers reject it (v1
	// `rejectFallthroughInMatchExpression`; 2-Parser.cs:14860-14864): fallthrough is meaningless
	// where every arm must yield a value, and the Pratt climber has already stopped at the `and`
	// (see `parseBinary`), so the arm parser meets it as a leftover rather than as an operator.
	matchExpressionStrayToken(got String, line LineNumber, column ColumnNumber)
	// An arm body that both `return`s and falls through (`1 then return 10 and fallthrough`).
	// Renders as **E2025**, positioned at the `and`. The two cannot combine: a `return` has already
	// left the arm, so there is nothing for the fallthrough to carry control out of.
	matchFallthroughWithReturn(line LineNumber, column ColumnNumber)
	// A non-enum match with no `default` arm. Renders as **E2026**, positioned at the closing `end`.
	// `subject` is "match" or "match expression" so the one rule phrases the statement and
	// expression forms as both reference compilers do. A scalar match is exhaustive only through a
	// default: the language will not silently do nothing for an unmatched value.
	matchNotExhaustive(subject String, line LineNumber, column ColumnNumber)
	// Two arms test the same single value (`1 then … 1 then …`). Renders as **E2027**, positioned at
	// the duplicate pattern. `pattern` is the value as written, for the message.
	matchDuplicatePattern(pattern String, line LineNumber, column ColumnNumber)
	// A pattern whose type cannot be compared to the scrutinee's — a `"string"` pattern on an `int`
	// scrutinee, say. Renders as **E2028**, positioned at the pattern. Both type names ride along
	// because the message names both.
	matchPatternTypeMismatch(patternType String, scrutineeType String, line LineNumber, column ColumnNumber)
	// A pattern arm that follows the `default` arm. Renders as **E2029**, positioned at the stray
	// arm's pattern — `default` must be the last case so its catch-all cannot mask a later one.
	matchDefaultNotLast(line LineNumber, column ColumnNumber)
	// A `match <expr>` with no block label after the scrutinee. Renders as **E2042**, positioned at
	// the token where the label belongs (the one just past the scrutinee).
	matchMissingBlockId(line LineNumber, column ColumnNumber)
	// A `match … 'a' … end 'b'` whose closing label does not match the one it opened. Renders as
	// **E2043**, positioned at the `end` (not the wrong label) — both references anchor it there.
	matchMismatchedBlockId(expected String, got String, line LineNumber, column ColumnNumber)
	// A `then` arm body that is a block-opening statement (`if`/`while`/`for`/`match`). Renders as
	// **E2049**, positioned at the opening keyword. Each arm body is a single statement; a
	// block-opener would need a nested scope a single-line arm has no place for.
	matchBlockStatement(keyword String, line LineNumber, column ColumnNumber)
	// --- The enum/union arms (P1.1b wave B) ---
	//
	// An enum/union declares one case name twice. Renders as **E3030**, positioned at the second
	// declaration.
	enumDuplicateCase(caseName String, line LineNumber, column ColumnNumber)
	// Two enum/union cases declare the same raw value (`ok = 200  success = 200`). Renders as
	// **E3031**, positioned at the second case. `rawValue` is the value as the bootstrap prints it.
	enumDuplicateRawValue(rawValue String, line LineNumber, column ColumnNumber)
	// An enum/union case's raw value has a type other than the enum's declared backing (`ok = 100
	// fail = 5.0`). Renders as **E3032**, positioned at the offending case. `detail` is the
	// bootstrap's exact `expected <x>, got <y>` phrasing.
	enumRawValueTypeMismatch(detail String, line LineNumber, column ColumnNumber)
	// A `Color.red` literal, or a match arm, names a case the enum/union does not have. Renders as
	// **E3034**, positioned at the case name. `kindWord` ("enum"/"union") names the CONSTRUCT: the
	// reference compiler distinguishes them here (`IsUnion ? "union" : "enum"` in 2-Parser.cs), so a
	// bad case of a `union` reads "unknown union case", matching the bootstrap and shv2's own
	// E2026/E2046 rather than hardcoding "enum" (which disagreed with both).
	enumUnknownCase(kindWord String, caseName String, line LineNumber, column ColumnNumber)
	// A match arm names a case in QUALIFIED form (`Color.red`). Renders as **E3075**, positioned at
	// the type name — the scrutinee's enum is already known, so the bare name suffices.
	matchQualifiedCaseName(bare String, qualified String, line LineNumber, column ColumnNumber)
	// A `default` arm on an ENUM match that is not `default throws`/`default panic`. Renders as
	// **E2046**, positioned at the `default` — an enum match is exhaustive by listing every case, so
	// a plain catch-all is forbidden (it would silently mask a case added later). `kindWord` is
	// "enum" or "union"; `typeName` the enum's name.
	matchDefaultEnumMustThrow(kindWord String, typeName String, line LineNumber, column ColumnNumber)
	// An enum/union match does not cover every case and has no `default throws`. Renders as **E2026**,
	// positioned at the closing `end`. `missing` is the comma-joined names of the uncovered cases, in
	// declaration order — the enum twin of `matchNotExhaustive`.
	enumMatchNotExhaustive(kindWord String, typeName String, missing String, line LineNumber, column ColumnNumber)
	// Two arms cover the same enum case — a bare name repeated, or a case covered by both a range and
	// a later arm. Renders as **E2027**, positioned at the second (overlapping) arm.
	matchOverlappingCase(caseName String, line LineNumber, column ColumnNumber)
	// A range arm `high to low` whose upper case is declared BEFORE its lower case, so it covers no
	// cases. Renders as **E2027**, positioned at the range. `low`/`high` are the case names written.
	matchEmptyRange(low String, high String, line LineNumber, column ColumnNumber)
	// --- The reserved-name arm (P1.2 follow-up) ---
	//
	// A user DECLARATION whose name starts with `__` — the prefix Maxon reserves for compiler
	// internals (`__mm_alloc`, `__print_string`, `__destruct_String`, the `__discard_*` temporaries).
	// Renders as **E2051**, positioned at the declared name. Raised by `requireUnreservedName` at every
	// binding site — see there for why one call cannot be traded for eight copies of the check, and
	// why this reservation is what makes `MmRuntime.isCompilerInternalCallee` sound rather than a
	// hopeful shortcut. `name` is the offending identifier, for the message.
	reservedIdentifier(name String, line LineNumber, column ColumnNumber)
end 'ParseError'

// **THE NAME OF THE RECEIVER PARAMETER.** An instance method's parameter 0, pushed by
// `parseFunction` and bound by `bindParameters` exactly like every other parameter — so the
// receiver's SSA value, its register, and its slot in a call's argument list are all decided by
// machinery that does not know what a method is.
//
// It is v1's spelling (`SELF_PARAM_NAME = "__self"`, IR/Maxon/MaxonDialect.maxon:15), taken so the
// two compilers' IR reads the same way to anyone who has read either.
//
// ⚠ It is an ORDINARY IDENTIFIER, so a body that writes `__self` resolves it and gets the
// receiver — an internal name reachable from source. v1 has the identical hole. It is not exploited
// by anything and no corpus case names it; the alternative (binding the receiver under the `self`
// KEYWORD's own text, which no parameter can ever be called) closes it for free but departs from
// both references' convention, so it is recorded here rather than taken unilaterally.
let SelfParamName = b"__self"

// The prefix Maxon RESERVES for compiler-internal names — every symbol the compiler emits
// (`__mm_alloc`, `__print_string`, `__destruct_String`, the `__discard_*` parser temporaries, and
// `__self` above) starts with it. `requireUnreservedName` forbids a USER DECLARATION from taking it.
//
// It is the same value `MmRuntime.CompilerInternalPrefix` tests a CALLEE against, and deliberately so:
// the two are the two ends of one fact. That predicate skips a `__`-named callee's user-function
// checks on the promise that no user `__` name exists — a promise ONLY this reservation can keep. The
// value is duplicated across the two modules rather than shared because they answer opposite questions
// at opposite tiers (a parser reading USER TOKENS; a lowering reading EMITTED CALLEES) and a runtime
// module owning the parser's reservation, or the reverse, would be the worse coupling. The language
// rule that `__` is reserved is what binds them, not a shared symbol.
let ReservedNamePrefix = b"__"

// The receiver a call carries, if any. A union rather than a `ValueId` plus a bool, and rather
// than a reserved id: `ValueId` has no empty value and a sentinel would be READ as a real argument
// by everything downstream (`retVoid` exists in the Maxon dialect for precisely this reason).
// `none` is every free and static call; `value` is an instance method's receiver.
union ReceiverArg
	none
	value(id ValueId)
end 'ReceiverArg'

// The BOX a field access goes through, paired with the LAYOUT that says what is inside it.
//
// ⭐ **ONE ANSWER, BECAUSE IT IS ONE QUESTION** — and because the two halves drifting apart is a
// wrong answer rather than a compile error. `requireStructBase` proves a binding is a struct and
// hands back the value holding its pointer, together; a caller cannot end up with a layout it
// PROVED beside a box it merely ASSUMED. They were two separate reads off one `VarInfo` at three
// call sites, and one of the two reads was wrong at all three — see `requireStructBase`.
type StructBase
	export let layout as StructLayout
	export let box as ValueId

	export static function create(layout StructLayout, box ValueId) returns StructBase
		return Self{layout: layout, box: box}
	end 'create'
end 'StructBase'

// --- Ranged-typealias range bounds ---
//
// The inclusive bounds each sized numeric type's `.min` / `.max` denotes in a range
// declaration (`typealias Handle = int(0 to u32.max)` — specs/ranged-typealias.md).
// Spelled with the very range identifiers they define, so the table cannot drift from
// the language it implements.
//
// `u64.max` does NOT fit a signed 64-bit field, and it rides here as the SAME BIT
// PATTERN `ParsedInt` holds for it (Maxon stores it as the signed -1). That is not a
// lossy stand-in: it is exactly the representation a value in an unsigned-domain alias
// has at runtime, so a future range check compares against it directly.
let U8MaxBound = u8.max as ParsedInt
let U16MaxBound = u16.max as ParsedInt
let U32MaxBound = u32.max as ParsedInt
let U64MaxBound = u64.max as ParsedInt

// Every unsigned type's lower bound. One constant, not four: `u8.min` and `u64.min`
// are the same zero, and a per-type spelling would only invite them to drift apart.
let UnsignedMinBound = 0 as ParsedInt
let I8MinBound = i8.min as ParsedInt
let I8MaxBound = i8.max as ParsedInt
let I16MinBound = i16.min as ParsedInt
let I16MaxBound = i16.max as ParsedInt
let I32MinBound = i32.min as ParsedInt
let I32MaxBound = i32.max as ParsedInt
let I64MinBound = i64.min as ParsedInt
let I64MaxBound = i64.max as ParsedInt

// The `.min` / `.max` field names a type-qualified bound may carry.
let MinBoundField = b"min"
let MaxBoundField = b"max"

// Can a PARAMETER be written? No — a reassignment to one is E2013, and mutating a parameter needs
// a local shadow.
//
// **It is NAMED because a second, distant thing depends on the answer and does not look like it
// does**: `namesAssignedIn`, the loop-phi token scan, is exhaustive only while every write to a
// mutable binding is spelled `identifier =` — which a `var` parameter's call-site write is not.
// Written as a bare `false` at the binding site, that coupling was invisible from both ends. The
// tripwire that enforces it lives in `bindParameters`, on the flag itself; this constant is what
// it currently reads.
let ParametersAreMutable = false

// The label of the placeholder block a Parser holds before it has parsed a function. It
// belongs to no function and is registered in no module; `parseFunction` replaces it
// before any op is emitted. Named so that if one ever DID reach the IR, the printed block
// label would say exactly what went wrong.
let DetachedBlockLabel = b"detached"

// ⭐ What joins a type's name to a method's in the name a method is DECLARED and CALLED under:
// `Point.create`. A dot, VERBATIM — the mangled name carries the separator the source wrote, which
// is what both reference compilers emit and what a golden fragment therefore shows.
//
// It is a constant because two very distant places must spell it identically: `declaredMethodName`
// (which names the `IrFunction` and its `funcSignatures` key) and `parseQualifiedCall` (which
// builds the callee of `Point.create(3, y: 4)`). Written twice, a change to the mangling would
// leave every method declared under one name and called under another — and the failure would be
// E3004 "call to undefined function 'Point.create'", pointing at a call that is perfectly correct.
let MethodNameSeparator = "."

// `Point.create` — the name a type's method is declared and called under. ONE spelling, read by
// `Parser.declaredMethodName` (the declaration) and `Parser.parseQualifiedCall` (the use). See
// `MethodNameSeparator` for what a second spelling would cost.
function qualifiedMethodName(typeName ByteArray, methodName ByteArray) returns ByteArray
	return "{String.from(typeName)}{MethodNameSeparator}{String.from(methodName)}".toByteArray()
end 'qualifiedMethodName'

// ⭐ THE TRIVIAL DESTRUCTOR — the `destructor` argument every `__mm_alloc` at this rung passes.
//
// **NULL IS THE ANSWER, NOT A PLACEHOLDER.** Every struct P1.0r can declare has scalar fields
// only, so nothing has to run when its box dies: there is no function to point at, and
// synthesizing an empty `__destruct_Point` to have a non-null pointer would be a function with no
// reason to exist. The bootstrap oracle agrees exactly — it emits `xor edx, edx` for a Point, and
// reaches for a real `lea_func [__destruct_Outer]` only once a field is itself heap-allocated.
//
// It is what keeps `funcAddr`/`callIndirect` out of this rung: the op pair that TAKES a function's
// address and CALLS one through a register has no consumer while this is 0, so it arrives at P1.2
// with `__destruct_String` — a caller that is a real reason to be right, because a String that
// does not free its buffer leaks and the leak gate says so. See `MmRuntime.buildMmFree`.
let TrivialDestructor = 0 as ParsedInt

// The result of resolving a `<sized>.min` / `<sized>.max` bound. A union, so the
// caller can tell the two REJECTIONS apart and name the actual gap in its diagnostic
// (a float bound is a missing FEATURE; an unknown name is a typo).
union SizedTypeBound
	value(bound ParsedInt)
	// `f32` / `f64` — genuinely sized numeric types, but their bounds are FLOAT values
	// this milestone cannot represent. Rejected loudly rather than silently collapsed
	// to an integer.
	floatBound
	notASizedType
end 'SizedTypeBound'

// The bound `<typeName>.<min|max>` denotes, for the eight sized INTEGER types. Shared
// by the range-declaration parser (`typealias Port = int(0 to u16.max)`) and the
// expression parser (`let x = u16.max`), which are the same three tokens in two
// positions — so they resolve through one table rather than two that can disagree.
function sizedTypeBound(typeName ByteArray, wantMax bool) returns SizedTypeBound
	if typeName.equals(b"u8") 'u8'
		return SizedTypeBound.value(pickBound(UnsignedMinBound, high: U8MaxBound, wantMax: wantMax))
	end 'u8'
	if typeName.equals(b"u16") 'u16'
		return SizedTypeBound.value(pickBound(UnsignedMinBound, high: U16MaxBound, wantMax: wantMax))
	end 'u16'
	if typeName.equals(b"u32") 'u32'
		return SizedTypeBound.value(pickBound(UnsignedMinBound, high: U32MaxBound, wantMax: wantMax))
	end 'u32'
	if typeName.equals(b"u64") 'u64'
		return SizedTypeBound.value(pickBound(UnsignedMinBound, high: U64MaxBound, wantMax: wantMax))
	end 'u64'
	if typeName.equals(b"i8") 'i8'
		return SizedTypeBound.value(pickBound(I8MinBound, high: I8MaxBound, wantMax: wantMax))
	end 'i8'
	if typeName.equals(b"i16") 'i16'
		return SizedTypeBound.value(pickBound(I16MinBound, high: I16MaxBound, wantMax: wantMax))
	end 'i16'
	if typeName.equals(b"i32") 'i32'
		return SizedTypeBound.value(pickBound(I32MinBound, high: I32MaxBound, wantMax: wantMax))
	end 'i32'
	if typeName.equals(b"i64") 'i64'
		return SizedTypeBound.value(pickBound(I64MinBound, high: I64MaxBound, wantMax: wantMax))
	end 'i64'
	if typeName.equals(b"f32") or typeName.equals(b"f64") 'float'
		return SizedTypeBound.floatBound
	end 'float'
	return SizedTypeBound.notASizedType
end 'sizedTypeBound'

function pickBound(low ParsedInt, high ParsedInt, wantMax bool) returns ParsedInt
	if wantMax 'max'
		return high
	end 'max'
	return low
end 'pickBound'

// True iff `names` already holds `name`. A linear scan — parameter lists are tiny (the
// only caller is parameter-name duplicate detection), so no membership set is worth its
// heap object (the same reasoning `FuncSignature.indexOfParam` documents).
function byteArrayContains(names ByteArrayArray, name ByteArray) returns bool
	for existing in names 'each'
		if existing.equals(name) 'match'
			return true
		end 'match'
	end 'each'
	return false
end 'byteArrayContains'

// --- Pratt expression parser: precedence table + operator classifiers ---
//
// M3 replaces M2's `+`-only left-fold with a precedence climber (`Parser.parseBinary`).
// Binary precedence levels — HIGHER binds tighter. Left-associativity falls out of
// recursing the right operand at `precedence + 1`. Unary `-` and `not` are NOT in this
// table — they are prefix operators handled by `parseUnary` (the leaf of the climber), so
// they bind tighter than every binary operator here.
//
// The LADDER, loosest to tightest, is `maxon-selfhosted`'s `infixBindingPower`
// (Parser.maxon:21056-21077) verbatim, halved (v1 spaces its levels by two to leave room
// for right-associative operators it never added):
//
//     or  <  xor  <  and  <  comparison  <  shl/shr  <  + -  <  * / mod
//
// Every one of those relationships is pinned by a spec case, and they are not obvious:
// `12 and 10 or 1` is 9 (`and` binds tighter than `or`), `12 and 10 xor 3` is 11, and
// `1 shl 3 > 5` is `(1 shl 3) > 5` — a shift binds TIGHTER than a comparison, unlike C,
// where it is the reverse (specs/bitwise-operators.md).
typealias InfixPrecedence = int(0 to 100)

// A sentinel-free "not a binary operator": a real level is >= OrPrecedence, so
// `infixPrecedence` returning this makes the climber's loop stop (the expression ends).
// It is a meaningful classification result, not an error sentinel.
let NotAnInfixOperator = 0 as InfixPrecedence

// The three WORD operators, loosest first. Each is CONTEXT-DEPENDENT — bitwise on
// integers, logical on bools — and `and`/`or` are additionally SHORT-CIRCUIT when their
// left operand is a bool, which makes them control flow rather than ops (see
// Parser.emitShortCircuit). Their precedence does not depend on which reading applies.
let OrPrecedence = 1 as InfixPrecedence
let XorPrecedence = 2 as InfixPrecedence
let AndPrecedence = 3 as InfixPrecedence

// Comparison `==`/`!=`/`<`/`>`/`<=`/`>=`. Binds tighter than the word operators, so
// `a > 0 and b > 0` groups as `(a > 0) and (b > 0)` — the reading that makes a
// short-circuit `and` mean anything at all.
let ComparisonPrecedence = 4 as InfixPrecedence

// Shift `shl`/`shr`. Binds TIGHTER than comparison (`1 shl 3 > 5` is `(1 shl 3) > 5`)
// and LOOSER than additive (`a shl 1 + 2` is `a shl (1 + 2)`).
let ShiftPrecedence = 5 as InfixPrecedence

// Additive `+`/`-`.
let AdditivePrecedence = 6 as InfixPrecedence

// Multiplicative `*`/`/`/`mod` — the tightest binary level, so `10 + 5 * 2` groups as
// `10 + (5 * 2)` = 20.
let MultiplicativePrecedence = 7 as InfixPrecedence

// The precedence of a binary-operator token, or NotAnInfixOperator for any token
// that does not begin a binary operation in the grammar.
function infixPrecedence(kind TokenKind) returns InfixPrecedence
	if kind == TokenKind.or 'or'
		return OrPrecedence
	end 'or'

	if kind == TokenKind.xor 'xor'
		return XorPrecedence
	end 'xor'

	if kind == TokenKind.and 'and'
		return AndPrecedence
	end 'and'

	if comparisonOperator(kind) 'comparison'
		return ComparisonPrecedence
	end 'comparison'

	if kind == TokenKind.shl or kind == TokenKind.shr 'shift'
		return ShiftPrecedence
	end 'shift'

	if kind == TokenKind.plus or kind == TokenKind.minus 'additive'
		return AdditivePrecedence
	end 'additive'

	if kind == TokenKind.star or kind == TokenKind.slash or kind == TokenKind.mod 'multiplicative'
		return MultiplicativePrecedence
	end 'multiplicative'

	return NotAnInfixOperator
end 'infixPrecedence'

// The Maxon binary operator a supported infix token maps to. Only called for tokens
// `infixPrecedence` classified as operators (precedence != NotAnInfixOperator) and NOT
// consumed by a more specific path first (a comparison goes to `infixCmpOp`; a bool
// `and`/`or` never reaches an op at all — it is short-circuit control flow). Anything
// else is a climber bug, so it panics rather than guessing an operator.
//
// `and`/`or`/`xor` map to the BIT ops here because that is the only reading left by the
// time this is called: the parser has already established that the operands are not
// bools (see `parseBinary`), and on integers the word operators ARE the bit operators.
function infixMaxonOp(kind TokenKind) returns MaxonBinOp
	if kind == TokenKind.plus 'add'
		return MaxonBinOp.add
	end 'add'

	if kind == TokenKind.minus 'sub'
		return MaxonBinOp.sub
	end 'sub'

	if kind == TokenKind.star 'mul'
		return MaxonBinOp.mul
	end 'mul'

	if kind == TokenKind.slash 'div'
		return MaxonBinOp.div
	end 'div'

	if kind == TokenKind.mod 'mod'
		return MaxonBinOp.mod
	end 'mod'

	if kind == TokenKind.and 'bitAnd'
		return MaxonBinOp.bitAnd
	end 'bitAnd'

	if kind == TokenKind.or 'bitOr'
		return MaxonBinOp.bitOr
	end 'bitOr'

	if kind == TokenKind.xor 'bitXor'
		return MaxonBinOp.bitXor
	end 'bitXor'

	if kind == TokenKind.shl 'shl'
		return MaxonBinOp.shl
	end 'shl'

	if kind == TokenKind.shr 'shr'
		return MaxonBinOp.shr
	end 'shr'

	panic("infixMaxonOp: token '{kind.rawValue}' is not a supported binary operator — infixPrecedence must gate this call")
end 'infixMaxonOp'

// The two operators that SHORT-CIRCUIT when their operands are bools: `and` (skips the
// right operand when the left is false) and `or` (skips it when the left is true). `xor`
// is deliberately absent — no value of one operand makes the other redundant, so there is
// nothing to skip, and on the 0/1 bool domain the bitwise xor already IS the logical one.
function shortCircuitOperator(kind TokenKind) returns bool
	return kind == TokenKind.and or kind == TokenKind.or
end 'shortCircuitOperator'

// The `MaxonType` a folded literal's TAG denotes — the one place a tag becomes the type a
// declaration carries. TWO callers, and they are the two places a literal's value outlives the
// token that wrote it: an INLINED top-level constant (`literal`'s declared type) and a shorthand
// FIELD DEFAULT (`export var value = 0` — the field's declared type, since there is no annotation
// to read it off). One mapping, so `let X = 0` and `var x = 0` cannot come to disagree about what
// an integer literal IS.
//
// Total over what can arrive, and it panics on what cannot: both producers yield `integer`,
// `boolean` and `float` and nothing else (the evaluator's literals are ints, chars, bools and
// floats; a comparison folds to a bool; `binOpResultTag` over two of them yields one of them; and
// `readFieldDefaultLiteral` accepts exactly those three token kinds). The remaining tags name things
// no constant expression can contain — a `named` alias needs an `as` cast (P1.9), and
// `unresolved`/`void` are call results, which are rejected as E2045 before their type is ever asked
// for.
//
// A `float` constant reaches here only as a LITERAL — `requireConstNotFloat` refuses every fold
// over one — so its payload is the bit pattern `parseFloatBits` produced, and the `MaxonType.float`
// this hands back is what tells `lowerLiteral` to lay those 8 bytes down as an f64 rather than an
// i64. That is the whole of `let PI = 3.14` and `var ratio = 2.5`.
function constantValueType(tag ValueTypeTag) returns MaxonType
	if tag == ValueTypeTag.boolean 'bool'
		return MaxonType.boolean
	end 'bool'

	if tag == ValueTypeTag.integer 'int'
		return MaxonType.integer
	end 'int'

	if tag == ValueTypeTag.float 'float'
		return MaxonType.float
	end 'float'

	panic("constantValueType: a top-level constant is tagged '{typeTagName(tag)}' — the evaluator folds integers, bools and floats only")
end 'constantValueType'

// IEEE-754's sign bit — the top bit of the 64-bit pattern. Negating a float literal FLIPS it; it is
// not an arithmetic negate, because a `ParsedInt` holding a float carries the BITS (see
// `Parser.parseFloatLiteral`) and `0 - bits` would be nonsense.
//
// It rides `ParsedInt`, which is SIGNED, so the constant IS `i64.min` — the same bit pattern
// `0x8000000000000000`, spelled as the number Maxon can write. `xor` with it flips exactly that bit
// and leaves the other 63 alone, which is negation for every float including zero and infinity.
let FloatSignBit = i64.min as ParsedInt

// `-<float literal>` — the bits of the literal's negation. The declaration sweep needs this and the
// expression parser does not: a body's `-x` is `emitFloatNegation` (a real `0.0 - x` op), while a
// field default has no code to emit into and must be a NUMBER by the time the layout is hashed.
function negatedFloatBits(bits ParsedInt) returns ParsedInt
	return bits xor FloatSignBit
end 'negatedFloatBits'

// The comparison operators (M4). Each maps to a `MaxonOp.compare`. Classifier shared by
// the precedence table (`infixPrecedence`) and the climber's op-dispatch (`parseBinary`).
function comparisonOperator(kind TokenKind) returns bool
	return kind == TokenKind.equalsEquals or kind == TokenKind.bangEquals or kind == TokenKind.lessThan or kind == TokenKind.lessEquals or kind == TokenKind.greaterThan or kind == TokenKind.greaterEquals
end 'comparisonOperator'

// The SOURCE-LEVEL TYPE RULES the parser enforces — what an operator's operands may be, and
// when two types agree — live in TypeRules.maxon, NOT here. They are shared with SemanticCheck
// (whose call-argument check is the one rule that needs whole-program signatures and so cannot
// live in the parser), and a rule with two homes is a rule that will eventually disagree with
// itself. See that file's header. What lives here is only the RAISING of them: turning a
// verdict into a positioned `ParseError`.

// The binary-operand rule, RAISED. **Both paths a word operator can take come through it** —
// the ordinary `binOp` emit, and the short-circuit lowering, which emits no `binOp` at all
// (the blocks are laid down instead) and would otherwise need its own copy of "what counts as
// a mixed operand". A second copy on the OTHER path every `and`/`or` can take is free to
// drift from the first, and the drift would show up as a `bool and int` silently accepted on
// one path and rejected on the other — a wrong answer, not a compile error.
function requireBinOpOperands(op MaxonBinOp, left ValueTypeTag, right ValueTypeTag, opTok Token) throws ParseError
	match checkBinOpOperands(op, left: left, right: right) 'operands'
		ok then break 'operands'
		mixedWordOperands then throw ParseError.operandTypeMismatch(opTok.kind.rawValue, line: opTok.line, column: opTok.column)
		nonNumericOperands then throw ParseError.nonNumericOperands(typeTagName(left), right: typeTagName(right), line: opTok.line, column: opTok.column)
		// The offending tag is ASKED FOR, not assumed. This line named `float` outright, under a
		// comment calling it "the only tag that can trip this rule" — true when written, and
		// falsified by P1.0r admitting `structRef` to the same rule, which left `p and q`
		// reporting "but this one is float" about two structs. `nonIntegralOperandOf` answers it
		// from the same predicate the rule itself decides by, so the two cannot drift again.
		nonIntegralOperands then throw ParseError.nonIntegralOperands(opTok.kind.rawValue, operand: typeTagName(nonIntegralOperandOf(left, right: right)), line: opTok.line, column: opTok.column)
	end 'operands'
end 'requireBinOpOperands'

// **THE `trunc` BUILTIN'S NAME**, and the whole of what makes it one. A `b""` literal, matched
// against the callee token's bytes — the same shape `TypeResolution`'s `ExitCodeBuiltinName` and
// `SemanticCheck`'s `MainFunctionName` use for the same job, which is the compiler recognizing one
// of its own names in user source.
let TruncBuiltinName = b"trunc"

// `trunc` takes exactly one argument. Named because `emitTrunc` states it twice — once as the
// check and once as the message's `expected` — and a bare `1` in either would be a magic value in
// the more literal sense: the number that says what the builtin IS.
let TruncArity = 1 as ParamCount

// **THE `String` BUILTIN TYPE'S NAME** (P1.2 wave A). Recognized SYNTACTICALLY in `parseTypeReference`
// — like `Self`, a pure token test with no registry — so `function f(s String)` tags `s`'s value
// `string` at PARSE time, which is what `s == t` / `print(s)` read. Recognizing it here (not only in
// `TypeResolution`, the way `ExitCode` is) is load-bearing: `resolveTypes` rewrites SIGNATURES, never
// the parser's `valueTags` column, so a String tagged `named` at parse time would stay `named` on the
// value and the String operators would never see it.
let StringBuiltinName = b"String"

// **THE `print` BUILTIN'S NAME** (P1.2 wave A). Like `trunc`, recognized by name after its arguments
// are parsed (`parseCallNamed`): it takes ordinary call syntax but emits no `MaxonOp.call` to a user
// function — it routes to the `__print_string` runtime entry.
let PrintBuiltinName = b"print"

// `print` takes exactly one argument (a String). Named for the same reason `TruncArity` is: `emitPrint`
// states it as both the check and the diagnostic's `expected`.
let PrintArity = 1 as ParamCount

// The value a short-circuit merge takes on the SKIPPED path: `false` for `and` (a false left
// operand determines the whole expression), `true` for `or`.
function shortCircuitSeed(takesRhsWhenTrue bool) returns ParsedInt
	if takesRhsWhenTrue 'isAnd'
		return BoolFalseValue
	end 'isAnd'
	return BoolTrueValue
end 'shortCircuitSeed'

// The block label a short-circuit's right-hand operand is evaluated under. Distinct per
// operator so a printed IR fragment says which one produced the block.
function shortCircuitLabel(takesRhsWhenTrue bool) returns ByteArray
	if takesRhsWhenTrue 'isAnd'
		return b"andrhs"
	end 'isAnd'
	return b"orrhs"
end 'shortCircuitLabel'

// A one-element branch-edge argument list — the shape every short-circuit edge has (its
// merge block carries exactly one phi: the expression's value).
function singletonArgs(value ValueId) returns ValueIdArray
	var args = ValueIdArray.create()
	args.push(value)
	return args
end 'singletonArgs'

// Append one argument to a call's THREE PARALLEL COLUMNS — its value, its `name:` label (the empty
// slice when positional), and its source span.
//
// **THE ONE WRITER OF THEM**, which is `StructLayout.addField`'s reason reaching the other family
// of parallel columns in the compiler: a caller that pushed a value and forgot a label would shift
// every later argument's label onto the wrong argument, and `slotCallArgs` would slot them
// accordingly — a silent wrong answer with no crash to find it by. There are exactly two callers,
// and the second is what made this worth a function: an argument the SOURCE wrote
// (`parseCallArgs`), and the RECEIVER an instance method call prepends (`parseCallNamed`), which is
// positional by construction and would otherwise have been a second, hand-written triple.
function pushCallArg(args ValueIdArray, argLabels ByteArrayArray, argRanges SourceRangeArray, value ValueId, label ByteArray, range SourceRange)
	args.push(value)
	argLabels.push(label)
	argRanges.push(range)
end 'pushCallArg'

// A `MaxonOp.call`'s `argLabels` column for a call whose every argument is POSITIONAL — one empty
// slice per argument. The op's columns are parallel by construction, so an all-positional call
// still has to say so at every index rather than carry a shorter list.
//
// The empty string is an unambiguous "no label" and not a value-masking sentinel, for the reason
// MaxonOp's `call` header gives: a parameter name can never be empty.
function emptyArgLabels(args ValueIdArray) returns ByteArrayArray
	var labels = ByteArrayArray.create()
	for _ in 0 upto args.count() 'each'
		labels.push(EmptySourceText)
	end 'each'
	return labels
end 'emptyArgLabels'

// A `MaxonOp.call`'s `argRanges` column when every argument shares ONE span — a call the COMPILER
// wrote, whose arguments no source token spawned individually.
//
// The per-argument span exists so a diagnostic can point at the offending argument
// (`SemanticCheck.reportArgError`), and a compiler-emitted call has no argument a user could have
// got wrong. Giving them all the call's own span is honest — that IS where each came from — and it
// keeps the column parallel, which `emitOp` requires.
function uniformArgRanges(args ValueIdArray, range SourceRange) returns SourceRangeArray
	var ranges = SourceRangeArray.create()
	for _ in 0 upto args.count() 'each'
		ranges.push(range)
	end 'each'
	return ranges
end 'uniformArgRanges'

// The Maxon comparison operator a comparison token maps to. Only called for tokens
// `comparisonOperator` classified as comparisons; anything else is a climber bug, so
// it panics rather than guessing. Kept separate from `infixMaxonOp` because a
// comparison is a distinct op family (`MaxonOp.compare`), not a `binOp` opcode.
function infixCmpOp(kind TokenKind) returns MaxonCmpOp
	if kind == TokenKind.equalsEquals 'eq'
		return MaxonCmpOp.eq
	end 'eq'

	if kind == TokenKind.bangEquals 'ne'
		return MaxonCmpOp.ne
	end 'ne'

	if kind == TokenKind.lessThan 'lt'
		return MaxonCmpOp.lt
	end 'lt'

	if kind == TokenKind.greaterThan 'gt'
		return MaxonCmpOp.gt
	end 'gt'

	if kind == TokenKind.lessEquals 'le'
		return MaxonCmpOp.le
	end 'le'

	if kind == TokenKind.greaterEquals 'ge'
		return MaxonCmpOp.ge
	end 'ge'

	panic("infixCmpOp: token '{kind.rawValue}' is not a comparison operator — comparisonOperator must gate this call")
end 'infixCmpOp'

// --- Character literals ---
//
// The lexer hands the parser the RAW bytes between the quotes, escapes undecoded, under
// `TokenKind.charLiteral` — and it uses the SAME token kind for a BLOCK LABEL (`'check'`).
// Nothing distinguishes them lexically, and nothing needs to: the two never occur in the
// same grammatical position. A label is consumed by the statement parser at the exactly
// one place each construct allows it (after an `if`/`while` condition, after `else`, after
// `end`, after `break`/`continue`); a character literal is consumed by `parsePrimary`,
// which runs only where an OPERAND is required. `if x 'check'` therefore parses `x` as the
// condition — the climber stops at the `'check'` because a charLiteral is not an infix
// operator — and `if cp == '-' 'dash'` parses `'-'` as the comparison's right operand
// because that IS an operand position, then `'dash'` as the label. This is v1's
// disambiguation, and its comment (Parser.maxon:16600) says the same thing.

// What a character literal's body decodes to.
union CharLiteralValue
	// A single byte — an ASCII character, or an escape that produces one. It materializes
	// as an ordinary integer literal carrying that byte, which is what makes `cp == '-'`,
	// `cp - '0'` and `if c >= '0'` mean what they say.
	byte(value ParsedInt)
	// `''`. No character, and no value to give it.
	empty
	// A literal whose UTF-8 body is more than one byte: `'é'`, `'中'`, an emoji, an EGC.
	// Representing one needs the `Character` TYPE (a heap value with `.bytes()`,
	// `.asciiValue()`, EGC-aware equality) — String's cone, not this rung's.
	multiByte
	// A `\` escape this decoder does not know.
	badEscape(text String)
end 'CharLiteralValue'

// Decode a character-literal body. Ported from maxon-selfhosted's `parseCharLiteralExpr`
// (Parser.maxon:16606-16637) + `decodeStringEscapes` (11069): v1 takes the SINGLE-BYTE
// literal as an `integer` and routes everything wider to its `Character` struct. shv2 keeps
// the first half exactly and rejects the second with a positioned diagnostic naming the gap
// — it has no Character type to route to yet.
function decodeCharLiteral(raw ByteArray) returns CharLiteralValue
	let decoded = decodeEscapes(raw)
	match decoded 'd'
		bytes(buf) then return charValueOf(buf)
		unknownEscape(text) then return CharLiteralValue.badEscape(text)
	end 'd'
end 'decodeCharLiteral'

function charValueOf(buf ByteArray) returns CharLiteralValue
	if buf.count() == 0 'empty'
		return CharLiteralValue.empty
	end 'empty'
	if buf.count() > 1 'wide'
		return CharLiteralValue.multiByte
	end 'wide'
	let b = try buf.get(0) otherwise panic("charValueOf: count()==1 but get(0) failed")
	return CharLiteralValue.byte(b as ParsedInt)
end 'charValueOf'

// The result of decoding a quoted body's escape sequences.
union DecodedLiteral
	bytes(buf ByteArray)
	unknownEscape(text String)
end 'DecodedLiteral'

// The escape sequences a quoted literal accepts, decoded to their bytes. The set is
// maxon-selfhosted's `decodeStringEscapes` (Parser.maxon:11069-11135) verbatim, so a
// character literal and (at P1.2) a string literal read escapes the same way — which is
// the whole reason this is a shared decoder rather than a char-only one.
//
// An UNRECOGNIZED escape is REPORTED, not copied through: v1 falls back to a literal copy
// only because a separate `validateEscapes` pass has already reported it, and shv2 has no
// such pass. Silently turning `'\q'` into two bytes would then surface as the far more
// confusing "multi-byte character literal".
function decodeEscapes(raw ByteArray) returns DecodedLiteral
	var buf = ByteArray.create()
	let len = raw.count()
	var i = 0 as ByteOffset
	while i < len 'decode'
		let ch = try raw.get(i) otherwise panic("decodeEscapes: i < len just held but get({i}) failed")
		if ch != Backslash or i + 1 >= len 'literalByte'
			buf.push(ch)
			i = i + 1
			continue
		end 'literalByte'

		let next = try raw.get(i + 1) otherwise panic("decodeEscapes: i + 1 < len just held but get({i + 1}) failed")
		match escapeByte(next) 'esc'
			byte(b) then buf.push(b)
			unknown then return DecodedLiteral.unknownEscape("\\{String.from(byteSlice(next))}")
		end 'esc'
		i = i + 2
	end 'decode'
	return DecodedLiteral.bytes(buf)
end 'decodeEscapes'

// The byte a two-character escape `\<c>` denotes, or `unknown`.
union EscapeByte
	byte(value Byte)
	unknown
end 'EscapeByte'

function escapeByte(c Byte) returns EscapeByte
	if c == LowerN 'newline'
		return EscapeByte.byte(NewlineByte)
	end 'newline'
	if c == LowerT 'tab'
		return EscapeByte.byte(TabByte)
	end 'tab'
	if c == LowerR 'carriageReturn'
		return EscapeByte.byte(CarriageReturnByte)
	end 'carriageReturn'
	if c == DigitZero 'nul'
		return EscapeByte.byte(NulByte)
	end 'nul'
	// The four self-escapes: a backslash, and the three delimiters a literal must be able
	// to contain — the single quote that would close a character literal, the double quote
	// that would close a string, and the brace that would open an interpolation.
	if c == Backslash or c == SingleQuote or c == DoubleQuote or c == LeftBrace or c == RightBrace 'selfEscape'
		return EscapeByte.byte(c)
	end 'selfEscape'
	return EscapeByte.unknown
end 'escapeByte'

// One byte as a one-element ByteArray, so an offending escape can be interpolated into a
// diagnostic as text.
function byteSlice(b Byte) returns ByteArray
	var one = ByteArray.create()
	one.push(b)
	return one
end 'byteSlice'

// The ASCII bytes the escape decoder produces and recognizes. Named rather than spelled as
// bare numbers or as `'\\'` character literals — the parser cannot bootstrap its own
// character-literal syntax to define the table that decodes it.
let Backslash = 92 as Byte
let SingleQuote = 39 as Byte
let DoubleQuote = 34 as Byte
let LeftBrace = 123 as Byte
let RightBrace = 125 as Byte
let LowerN = 110 as Byte
let LowerT = 116 as Byte
let LowerR = 114 as Byte
let DigitZero = 48 as Byte
let NewlineByte = 10 as Byte
let TabByte = 9 as Byte
let CarriageReturnByte = 13 as Byte
let NulByte = 0 as Byte

// --- M4b loop / on-the-fly SSA support ---

// How many bindings of a kind were in scope when a lexical block was opened. A `var`
// declared inside the block joins `Parser.mutableVars`, and must LEAVE it at the
// block's `end`: a binding no source line can name any more must not receive a loop
// phi, nor take a slot in a merge snapshot. Wide range: declaration counts are unbounded.
typealias BindingMark = int(0 to u64.max)

// What a lexical block must be unwound to — the heights of BOTH per-binding lists the parser
// keeps beside `Scope`.
//
// A `type` rather than two return values, because the two heights are one FACT ("where this block
// began") and are read by one caller. Passing them separately is how the two would eventually be
// captured at different moments; a block that recorded its mutable height on entry and its owned
// height a statement later would drain a binding it did not open.
type BlockMark
	export let mutableCount as BindingMark
	export let ownedCount as BindingMark

	export static function create(mutableCount BindingMark, ownedCount BindingMark) returns BlockMark
		return Self{mutableCount: mutableCount, ownedCount: ownedCount}
	end 'create'
end 'BlockMark'

// A loop-header (or loop-exit) phi: the mutable BINDING it carries, paired with the
// block-arg ValueId minted for it. POSITIONAL — the k-th phi var corresponds to
// `blockArgs[k]` on the merge block and to `argIds[k]` on every predecessor's
// `BranchEdge`, so all three follow one order.
//
// That order is declaration order over the bindings the loop CARRIES — the mutable vars in
// scope that its body assigns (`parseWhileStatement`) — which is a SUBSET of `mutableVars`,
// not a copy of it. So a phi list is indexed by phi position and never by a binding's index
// in `mutableVars`; the two coincided once and no longer do.
//
// The binding is held as the `VarInfo` OBJECT, not as its name. A name cannot address
// it: a block nested inside the loop may SHADOW the name, and then a name-keyed read
// would fetch the shadow — so `break`ing out of such a block would carry the shadow's
// value into the loop's exit phi. A silent miscompile, and the reason `Scope` mutates
// bindings in place instead of replacing them (see Scope's header).
type LoopPhiVar
	export var binding as VarInfo
	export var phiId as ValueId

	export static function create(binding VarInfo, phiId ValueId) returns LoopPhiVar
		return Self{binding: binding, phiId: phiId}
	end 'create'
end 'LoopPhiVar'

typealias LoopPhiVarArray = Array with LoopPhiVar

// The variable names a loop's token extent ASSIGNS — the set `parseWhileStatement` intersects
// with the mutable bindings in scope to decide which ones the loop carries a phi for. Keyed by
// the identifier's raw source slice, which is how every other name lookup in the parser is keyed
// (`ByteArray` hashes and compares by content — see Token.value).
typealias AssignedNameSet = Set with ByteArray

// One enclosing loop on the parser's loop-context stack. `break`/`continue` read it
// to find their targets (innermost, or by label) and to build the block-arg value
// lists they carry to the exit / header. Because the header phis are created EAGERLY
// at loop entry (before the body is parsed), every in-edge can fill its BranchEdge
// argIds immediately from the current variable values — there is no deferred
// phi-operand backpatching, which keeps the loop lowering a single forward pass.
//
// This mirrors v1's parser loop stack (maxon-selfhosted Parser.parseWhileStatement:
// same cond/header + body + exit block shape, same entry→header branch and
// condBr(then=body, else=exit)). One field v1 carries that this does not: a separate
// `continueBlockId`. In a `while`, `continue` re-evaluates the condition, so its target
// IS the header (`headerId` here); v1 splits the two only for `for` loops, whose
// `continue` jumps to a STEP block that runs the increment before the header. When
// `for` lands (M5), this gains that split; at M4b `continue` → `headerId` is exact.
type LoopContext
	export var label as ByteArray
	export var headerId as BlockId
	export var exitId as BlockId
	export var phiVars as LoopPhiVarArray
	// True once at least one `break` targeted this loop — the exit then merges the
	// header-false-edge value with each break's value, so it needs its own phis.
	export var hasBreak as bool

	export static function create(label ByteArray, headerId BlockId, exitId BlockId, phiVars LoopPhiVarArray) returns LoopContext
		return Self{label: label, headerId: headerId, exitId: exitId, phiVars: phiVars, hasBreak: false}
	end 'create'
end 'LoopContext'

typealias LoopContextArray = Array with LoopContext

// The value a match arm produces, if any: `none` for a `then` (statement) arm, `value` for a
// `gives` (expression) arm. A union rather than a `ValueId` plus a bool — for the reason
// `ReceiverArg` is one: a `ValueId` has no empty value, and a sentinel would be READ downstream
// as a real operand.
union MatchGiveValue
	none
	value(id ValueId)
end 'MatchGiveValue'

// The stateful bookkeeping a single enum/union declaration's case loop threads across its cases:
// the auto-increment TAG counter, and the BACKING (int vs float) that the first explicitly-typed
// case fixes.
//
// A `type` (one heap object per declaration, on the cold declaration path) rather than three
// out-params, which Maxon has no clean spelling for: the counter and the backing decision must
// PERSIST across cases (a bare `b` after `a = 5` must read `6`), so a caller that read them back by
// value would lose the update. `backingResolved` gates `backingIsFloat` — the latter is meaningless
// until the first `= <literal>` sets it, exactly as `StructLayout` has no field until `addField`.
type EnumBackingState
	// The tag the NEXT bare (or first) case takes. Starts at 0; an explicit `= N` resets it to N+1,
	// which is what gives `enum E { a = 5  b }` the tag 6.
	export var nextTag as ParsedInt
	// Has any case fixed the backing yet? Until one does, a case of either kind is accepted and sets
	// it; after, a mismatch is E3032.
	export var backingResolved as bool
	// Which backing, once resolved: float (`= 1.5`) or int (bare, or `= 5`). Read only when
	// `backingResolved`.
	export var backingIsFloat as bool

	export static function create() returns EnumBackingState
		return Self{nextTag: 0, backingResolved: false, backingIsFloat: false}
	end 'create'
end 'EnumBackingState'

// Is `kind` a LITERAL token — an int/float/string/char/byte-string literal? Used to tell a keyword
// used as a case NAME (`keyword-as-case-name.md`: `function`, `end`, ...) from a literal, which the
// lexer emits as its own kind carrying its text. THE one list, so the case-name reader and any
// later reader cannot drift on what counts as a literal.
function tokenIsLiteralKind(kind TokenKind) returns bool
	return kind == TokenKind.intLiteral or kind == TokenKind.floatLiteral or kind == TokenKind.stringLiteral or kind == TokenKind.charLiteral or kind == TokenKind.byteStringLiteral
end 'tokenIsLiteralKind'

// Can `tok` serve as an enum/union CASE NAME? An identifier, or a KEYWORD used as one — `enum
// TokenType { function return end if … }` is legal (`keyword-as-case-name.md`), and a keyword
// carries its source spelling in `.value` (the lexer emits it through the same path an identifier
// takes). The signal that a token is word-shaped rather than punctuation is that it carries text: a
// punctuator, `newline` and EOF all carry the shared EMPTY slice (see Token.value), while a literal
// carries text but is ruled out by its KIND. So a case name is an identifier, or any non-literal
// token that carries a spelling.
function tokenNamesEnumCase(tok Token) returns bool
	if tok.kind == TokenKind.identifier 'plainIdentifier'
		return true
	end 'plainIdentifier'
	if tok.value.isEmpty() 'punctuationOrEof'
		return false
	end 'punctuationOrEof'
	return not tokenIsLiteralKind(tok.kind)
end 'tokenNamesEnumCase'

// Does a scrutinee's type name resolve to a declared enum/union? The predicate `parseMatchCommon`
// branches enum-vs-scalar on, factored out so the flag and the layout extraction below cannot come
// to disagree about what "is an enum match" means.
function enumMatchIsDeclared(decl DeclaredEnum) returns bool
	return match decl 'kind'
		declared gives true
		undeclared gives false
	end 'kind'
end 'enumMatchIsDeclared'

// The layout behind a `declared` enum match — called ONLY where `enumMatchIsDeclared` already
// answered true, so `undeclared` is a caller-guard break, not a program error. Returns the layout
// REFERENCE (no allocation), so re-extracting it at each of the three enum branch sites is free.
function requireEnumLayout(decl DeclaredEnum) returns EnumLayout
	match decl 'kind'
		declared(layout) then return layout
		undeclared then panic("requireEnumLayout: called on a scalar match — guard with enumMatchIsDeclared")
	end 'kind'
end 'requireEnumLayout'

// A match arm that reaches the merge block — its exit block, the carried-variable values it
// leaves scope with, and (expression form only) the value it `gives`. Collected as the arms are
// parsed and drained by `finalizeMatchMerge`, which mints the merge's phis from the whole set.
//
// ⭐ This IS shv2's departure from both references: v1 and the bootstrap join a match's arms
// through a mutable result SLOT (a store per arm, one load at the merge, promoted later by
// mem2reg). shv2 has neither slots nor mem2reg, so it threads each arm's value to the merge as a
// BLOCK-ARG — exactly as `if`/`while` thread a `var` across their joins. A port of the slot would
// reintroduce the very machinery the rewrite exists to avoid.
type MatchArmExit
	export var exitBlock as IrBlock
	export var exitVals as ValueIdArray
	export var give as MatchGiveValue

	export static function create(exitBlock IrBlock, exitVals ValueIdArray, give MatchGiveValue) returns MatchArmExit
		return Self{exitBlock: exitBlock, exitVals: exitVals, give: give}
	end 'create'
end 'MatchArmExit'

typealias MatchArmExitArray = Array with MatchArmExit

// How control left one arm's body, plus the exit snapshot the merge (or the next arm's
// fallthrough phi) needs. `fellThrough` and `reachesMerge` are mutually exclusive with each
// other and with a terminated exit: an arm either flows to the next arm's body (`and
// fallthrough`), reaches the merge, or returns/breaks — exactly one.
type MatchArmBody
	export var fellThrough as bool
	export var reachesMerge as bool
	export var exitBlock as IrBlock
	export var exitVals as ValueIdArray
	export var give as MatchGiveValue

	export static function create(fellThrough bool, reachesMerge bool, exitBlock IrBlock, exitVals ValueIdArray, give MatchGiveValue) returns MatchArmBody
		return Self{fellThrough: fellThrough, reachesMerge: reachesMerge, exitBlock: exitBlock, exitVals: exitVals, give: give}
	end 'create'
end 'MatchArmBody'

// What a parsed match leaves behind: the continuation block control resumes in (`cont`, which
// becomes `currentBlock`), and the value it produced — `none` for a statement match, `value(phi)`
// for an expression match. Both entry points read `cont`; only the expression entry reads `result`.
type MatchOutcome
	export var cont as IrBlock
	export var result as MatchGiveValue

	export static function create(cont IrBlock, result MatchGiveValue) returns MatchOutcome
		return Self{cont: cont, result: result}
	end 'create'
end 'MatchOutcome'

export type Parser
	var tokens as TokenArray
	var pos as TokenIndex
	var filePath as FilePath
	var namespace as String
	// The sole output. Every emit/registry write lands here, never on `Project`.
	var artifact as FileParseArtifact
	// Per-function symbol table (empty at M1 — no locals). Reset per function.
	var scope as Scope
	// Per-function ValueId allocator for the values this function's ops define.
	// Re-seeded at `paramCount` per function (params implicitly own 0..paramCount-1
	// by Std-ABI convention), so ids are dense and function-local. The parser is
	// where value numbering is BORN — see MaxonDialect's MaxonOp header.
	var valueIds as ValueIdRef
	// The `var` bindings currently IN SCOPE, in declaration order (M4b) — held as the
	// `VarInfo` objects, for the reason LoopPhiVar documents. A loop header mints a phi for
	// the SUBSET of these its body assigns, in this list's order, so that block-args and
	// every predecessor's BranchEdge argIds stay positionally aligned with each other.
	// `let` bindings never appear (they cannot be reassigned, so they carry no
	// loop-carried phi). A block's `var`s are drained off the end of this list at the
	// block's `end` (see closeBlock). Reset per function.
	//
	// An `if`'s merge works the same way (`assignedBindingsIn`): its snapshots are positional
	// over the SUBSET of this list its branches assign, in this list's order, and it mints a
	// phi only where the two paths differ.
	var mutableVars as VarInfoArray
	// The enclosing loops, innermost last (M4b). `break`/`continue` resolve their
	// target here; a `while` pushes on entry and pops after its body. Reset per
	// function (a stray entry across functions would be a parser bug).
	var loops as LoopContextArray
	// The token index of the `end` most recently consumed by `parseBlockBody`. It exists for
	// the drift guard `assertScanAligned`, which both `parseWhileStatement` and `parseIfStatement`
	// run to check the `end` the parser really closed the last body with against the one
	// `blockStatementEndIndex` predicted from the tokens. A nested block
	// finishes — and writes this — before its enclosing one does, so by the time an outer
	// `parseBlockBody` call returns it holds the OWN `end` of the construct's last body, which
	// is what the guard reads.
	var lastBlockBodyEnd as TokenIndex
	// THE BLOCK EXPRESSION PARSING IS EMITTING INTO, and it MOVES. Until P1.0d.2 an
	// expression always ended in the block it started in, so "where do ops go" could be a
	// parameter threaded down from the statement. A short-circuit `and`/`or` ends that: it
	// leaves control in a fresh MERGE block, and everything after it — the rest of the
	// expression, the statement's own terminator, every statement that follows — must land
	// there. A parameter cannot express that (a function returns one value, and the
	// expression parser's is the ValueId), so the exit block is published here.
	//
	// This is `maxon-selfhosted`'s `currentBlock`, and it exists there for the same reason
	// (its `parseExpressionBP` does `blk = currentBlock` after every recursive call).
	//
	// Seeded with a DETACHED placeholder: a Parser exists before any function does, so
	// there is no entry block to point at yet. `parseFunction` overwrites it with the real
	// entry before a single op is emitted, and every op the parser emits is emitted from
	// inside a function body — so the placeholder is provably never written to. (The
	// alternative, an optional-block union, would put a `match` at every emit site to
	// handle a case that cannot occur.)
	var currentBlock as IrBlock
	// The source-level type of every SSA value this function's ops define, DENSE by ValueId
	// and split into its two halves: the TAG (the discriminant) and, for a `named` type, the
	// interned name id. The type oracle the context-dependent operators consult:
	// `and`/`or`/`xor` and `not` mean one thing on `bool` and another on `int`, and — because
	// a bool `and`/`or` is CONTROL FLOW, which no later pass can retrofit — the parser is the
	// tier that must know.
	//
	// TWO SCALAR COLUMNS, not an `Array with MaxonType`: a Maxon union value is a heap
	// object, so a `MaxonType` column would put an allocation on every SSA value in the
	// program, and the type RULES that read it would put another on every operator. See
	// MaxonDialect's `ValueTypeTag` for the measurement that settled it.
	//
	// Seeded with the parameter types (which own ids 0..paramCount-1) and appended in
	// lockstep with `valueIds` by `mintValue`. Re-CREATED per function (never cleared) —
	// which is what makes the next line safe:
	//
	// **`valueTags` IS THE FUNCTION'S OWN COLUMN, SHARED BY REFERENCE.** `parseFunction` hands
	// this very array to `IrFunction.create`, so every `mintValue` during the body parse pushes
	// straight into `func.valueTags`. That is not an optimization detail to be tidied away: the
	// column has a SECOND reader (SemanticCheck, for the one type rule that needs a callee's
	// signature and so cannot live here — see IrFunction.valueTags), and copying it out at the
	// end of each body would allocate a dead array per function for nothing.
	//
	// `valueNameIds` is NOT shared — nothing downstream needs an alias's NAME, only its class
	// (TypeRules' `typeClassOf`), so it stays parser-local and is dropped at the next function.
	var valueTags as ValueTypeTagArray
	var valueNameIds as TypeNameIdArray
	// THE PARSER'S CONSTANT FOLDER — two more columns in lockstep with `valueTags`, holding the
	// integer behind every SSA value the compiler KNOWS. It exists for the shift rule, which is
	// the one rule in the language that must ask "what IS this operand?" rather than "what TYPE is
	// it?" (TypeRules' ⭐ THE SHIFT RULE): a negative count is E2054, and a count of 64-or-more
	// names a different shift than the hardware would perform.
	//
	// Filled forward, at the three places an integer value is born — `emitLiteral` (so a count
	// named through a `let` is a count this column holds: `let SHIFT = -1` binds the name to the
	// literal's own ValueId), `emitUnaryOp` (`-1` is `neg` of a literal, not a negative literal),
	// and `emitBinOp` (so `x shl 63 + 1` is a count of 64).
	//
	// Two scalar columns rather than one column of a union, for the reason `valueTags` gives: a
	// Maxon union value is a heap object, and this is the per-VALUE path. Re-created per function,
	// so the cost is bounded by the largest function and not by the module.
	//
	// ⚠ Its REACH is a matter of diagnostic quality, never of correctness. A count it misses is a
	// count `emitGuardedShift` saturates at run time, to exactly the same answer — which is what
	// lets the fold be an optimization rather than a second opinion.
	var valueConsts as ParsedIntArray
	var valueConstKnown as BoolArray
	// ⭐ **THE OWNED-HEAP PROVENANCE — the SSA values that are FRESH owned heap allocations this function
	// must drop.** Today, the interpolation RESULTS (`emitStringInterp`). It exists because ownership CANNOT
	// be read off the type tag: an owned interpolation String and a borrowed-immortal rdata literal String
	// share `ValueTypeTag.string`, so keying a drop on the tag would either decref an immortal literal (a
	// wrong decref of unowned `.rdata`) or leak an interpolation result. This is the provenance the tag
	// cannot carry — recorded by the ONE expression that allocates a String, never by the literal path —
	// read by `parseBinding` (does this binding OWN a drop?) and structurally by the statement-scoped
	// temp-drop. Structs need no entry: every struct is heap, so `tagIsStructRef` already answers for them;
	// this is only the String owned/borrowed split the tag conflates.
	//
	// A PER-VALUE bool column, indexed by ValueId in lockstep with `valueTags`/`valueConstKnown` (pushed
	// `false` in `mintValue`/`recordValueType`, set `true` in `trackOwnedTemp`, read by `valueIsOwnedHeap`).
	// It is a set-MEMBERSHIP fact and nothing more — never iterated, order-independent — so the O(1) column
	// read is the right shape and the earlier sparse list was not: that list was scanned once per binding
	// and grew by one per interpolation, never pruned within a function, so a function with N bound
	// interpolations paid Σk = O(N²) — a `findFirst`-in-a-loop quadratic in one function's size. The column
	// makes each query O(1); its one added bool per value is strictly linear and dwarfed by the four sibling
	// columns already carried per value. Reset per function.
	var valueOwnsHeap as BoolArray
	// Every function declared ANYWHERE IN THE PROGRAM, with its return type — the whole-program
	// signature index (SignatureIndex.maxon), built from every file's TOKENS before any file is
	// parsed and handed to every Parser.
	//
	// A call's result type has to be exact HERE, and it cannot wait: `f() and g()` short-circuits
	// iff `f`'s return type is statically `bool` — a CONTROL-FLOW decision no later pass can
	// retrofit — and `not` picks its opcode from its operand's type. A file-local scan made that
	// exact within one file (so declaration ORDER stops deciding what a program means), and left it
	// WRONG across files: a callee the file could not see was typed `unresolved`, which agrees with
	// everything, so `let x = isReady()` + `x + 41` compiled and returned 42. The index is the same
	// sweep, over every file.
	var signatures as ProgramSignatures
	// ⭐ THE TYPE whose body is being read — EMPTY at file scope. It is the parser's whole knowledge
	// of "am I inside a `type`?", and three things read it:
	//
	//   • `declaredMethodName` — a `function create` inside `type Point` is declared `Point.create`;
	//   • `parseTypeReference` — `Self` (and `Point`) in a type position inside `type Point` is a
	//     `structRef` to it;
	//   • `requireConstructible` — `Self{…}` is legal HERE and nowhere else (E3076).
	//
	// ⭐ **THE TOKEN SWEEP SETS IT TOO, AND THAT IS WHAT KEEPS THE TWO PASSES HONEST.** The first two
	// readers above run in BOTH the tolerant declaration sweep (`recordScannedType`) and the real
	// parse (`parseTypeDeclaration`), and they must not disagree: had the sweep recorded a factory as
	// `create` while the parse declared it `Point.create`, every call would be E3004 against a name
	// nothing declared. The mapping is purely SYNTACTIC — it needs the enclosing declaration and no
	// registry — which is exactly why both passes can make it, and why `Self` need not wait for the
	// index to be complete (mid-sweep, it is not).
	//
	// Empty is not a sentinel: a type's name cannot be empty, and "no enclosing type" is the literal
	// truth at file scope. It is NOT reset per function — a method's parse runs INSIDE the type body
	// that set it (`parseTypeDeclaration` is the one writer, and clears it at the type's `end`).
	var enclosingType as ByteArray
	// The struct-typed bindings currently IN SCOPE, in declaration order — the values a `return`
	// must DROP (`emitScopeDrops`). Held as the `VarInfo` objects, exactly as `mutableVars` is, and
	// drained off the end at a block's `end` by the same mark (see `closeBlock`). Reset per function.
	//
	// ⚠ **IT IS NOT `Scope.popScope`, AND THAT IS NOT AN OVERSIGHT.** Scope's header argues that a
	// parallel owned-list is state that can drift while `popScope` already resolves every binding a
	// frame tears down — and it is right about a BLOCK. It cannot serve the case this rung has, for
	// two independent reasons:
	//
	//   1. **A `return` TERMINATES ITS BLOCK.** `return p.x + p.y` must read the fields, THEN drop
	//      `p`, then return — so the drop belongs between the value and the terminator, at the
	//      `return` statement. `popScope` runs at a block's `end`, which is after the terminator:
	//      anything it emitted would sit on a path control has already left, and the box would leak.
	//   2. **A FUNCTION-SCOPE BINDING NEVER REACHES `popScope` AT ALL.** `Scope.install` records a
	//      declaration for teardown only while a frame is open (`frameMarks.count() > 0`), and
	//      `parseFunction` opens none — `main`'s `let p` lives for the whole function and is torn
	//      down by `reset`. The hook would not fire for either case this rung exists to turn green.
	//
	// ORDER is the third reason, and `vars` could not give it either: `Scope.allVars` hands back a
	// hash MAP, so draining it would emit the drops in hash order and no golden would reproduce.
	var ownedBindings as VarInfoArray
	// ⭐ **THE OWNED HEAP TEMPORARIES CREATED BY THE STATEMENT BEING PARSED, awaiting their drop.** An
	// UNBOUND owned value — `print("{x}")`, where the interpolation result is consumed by `print` (which
	// BORROWS it) and bound to no name — has, under static single-owner, exactly one possible owner: the
	// STATEMENT that produced it. `emitStringInterp` pushes each result here; `parseStatement` drains it at
	// the statement's end, emitting a `__mm_decref` per entry into `currentBlock` — so the drop lands in the
	// LOOP BODY per iteration (`while … print("{i}") …`), the `if`-branch block, or a short-circuit merge,
	// wherever control is when the statement finishes. This is what makes `print("{x}")` — the dominant
	// interpolation shape — leak-free without binding it to a name.
	//
	// A value that IS bound (`let s = "{x}"`) has its ownership TRANSFERRED to the binding: `parseBinding`
	// removes it from here and adds it to `ownedBindings`, so it drops at SCOPE exit (`emitScopeDrops`), not
	// statement end. Reset per function, like every other per-function column. It holds only owned RESULTS —
	// the interpolation's internal scratch buffers are freed inside `emitStringInterp`, never tracked here.
	var pendingTempDrops as ValueIdArray

	export static function create(tokens TokenArray, filePath FilePath, namespace String, signatures ProgramSignatures) returns Parser
		return Self{
			tokens: tokens,
			pos: 0,
			filePath: filePath,
			namespace: namespace,
			artifact: FileParseArtifact.create(filePath),
			scope: Scope.create(),
			valueIds: ValueIdRef.create(0),
			mutableVars: VarInfoArray.create(),
			loops: LoopContextArray.create(),
			lastBlockBodyEnd: 0,
			currentBlock: IrBlock.create(0, label: DetachedBlockLabel),
			valueTags: ValueTypeTagArray.create(),
			valueNameIds: TypeNameIdArray.create(),
			valueConsts: ParsedIntArray.create(),
			valueConstKnown: BoolArray.create(),
			valueOwnsHeap: BoolArray.create(),
			signatures: signatures,
			enclosingType: EmptySourceText,
			ownedBindings: VarInfoArray.create(),
			pendingTempDrops: ValueIdArray.create()
		}
	end 'create'

	// Parse the whole file into its artifact. Top-level loop: skip blank lines,
	// dispatch each declaration, stop at EOF.
	export function parseModule() returns FileParseArtifact throws ParseError
		while true 'top'
			self.skipNewlines()
			if self.isEof() 'done'
				break
			end 'done'
			try self.dispatchTopLevel()
		end 'top'
		return self.artifact
	end 'parseModule'

	// Sweep this file's tokens for every `function <name>(…) [returns <Type>]` it declares, and fold
	// what is found into the whole-program `index`. THE way the signature index is built
	// (`queryProgramSignatures` does this once per file, in source-path order); nothing else calls
	// it, and a Parser used for a sweep parses no body.
	//
	// It records `FuncReturnTypeEntry`s — the SAME record the real parse contributes to the
	// `funcReturnTypes` registry (ParseStaging) — and reads the return type through the SAME
	// `parseOptionalReturnType` the real parse reads it with. That shared routine is what keeps the
	// sweep and the parse from drifting into two opinions of what `returns X` means, which is the
	// standing hazard of having a pre-scan at all.
	//
	// The FOLD happens here, not in the caller, because the ids the sweep interns are file-local —
	// they live in this Parser's own artifact interner, which is private and stays private. Handing
	// the caller the ids without the table they belong to is precisely the mistake this whole index
	// is built to avoid (see SignatureIndex's header on why a signature travels by name).
	//
	// Deliberately TOLERANT: it records only the exact `function NAME ( … ) returns TYPE` shape and
	// skips anything else without complaint. It is NOT a validator — the real parse runs afterwards
	// and produces the positioned diagnostic for whatever is malformed — and it must never become
	// one: a sweep that could VETO a call would reject a correct program the moment it failed to
	// recognize a declaration the parser accepts (see `CalleeReturn.undeclared`). It restores the
	// cursor, so it is invisible to everything downstream.
	export function foldDeclaredSignaturesInto(index ProgramSignatures)
		var entries = FuncReturnTypeEntryArray.create()
		var aliases = RangedTypeAliasArray.create()
		var structs = StructLayoutArray.create()
		var enums = EnumLayoutArray.create()
		var bindings = TopLevelDeclArray.create()

		let resume = self.pos
		self.pos = 0
		// ⚠ **BLOCK DEPTH, AND THE ONE ARM THAT NEEDS IT.** This loop walks EVERY token in the file,
		// function bodies included, and that is what makes it robust: it cannot miss a `function`
		// keyword however malformed the source around it is. `function` and `typealias` are reserved
		// and appear nowhere but a declaration, so their arms need no context at all.
		//
		// **`let` and `var` are different — they are the most common statements in any body.** So they,
		// and only they, are gated on depth 0. The counter tracks exactly shv2's block syntax:
		// `function`/`if`/`while`/a non-`if` `else` open one, `end` closes one, and nothing else in the
		// parsed slice does either (a typealias, a binding, a return, a call and an assignment are all
		// single-line). The opener predicate is `opensBlockAt` — the one the loop scanner already uses —
		// rather than a second list of block keywords to fall out of step with it.
		//
		// The gate is BELT AND BRACES, not the guarantee: `declaredOutcome` panics if this scan
		// and the real parse ever disagree about which binding is top level.
		var depth = 0 as BlockDepth
		while not self.isEof() 'scan'
			if depth == 0 and self.atTopLevelBindingKeyword() 'isTopLevelBinding'
				self.recordScannedBinding(bindings)
				continue
			end 'isTopLevelBinding'

			if self.at(TokenKind.function) 'isFunction'
				// A function opens a block, closed by its own `end`. Counted BEFORE the signature is
				// read, because reading it moves the cursor past the `function` keyword.
				depth = depth + 1
				self.advance()
				self.recordScannedSignature(entries)
				continue
			end 'isFunction'

			if self.at(TokenKind.typealias) 'isTypeAlias'
				self.recordScannedTypeAlias(aliases)
				continue
			end 'isTypeAlias'

			// A `type` DECLARATION, and it is gated on depth 0 for `let`/`var`'s reason rather than
			// left ungated like `function`/`typealias`: `type` is reserved as a KEYWORD but is legal
			// as a PARAMETER NAME (`function f(type Integer)`), so a bare `type` token can appear
			// inside a parameter list. It cannot appear at depth 0 — the `function` arm above counts
			// the body open BEFORE `recordScannedSignature` reads it, and that routine skips the
			// parenthesized list wholesale — so at depth 0 a `type` token is a declaration and
			// nothing else.
			//
			// `recordScannedType` consumes the WHOLE declaration, cursor landing past its `end`, so
			// the loop's depth invariant is untouched by it and this stays ONE walk of the token
			// array. It consumes the `type` keyword before it can fail, so the cursor always
			// advances and this loop cannot spin.
			if depth == 0 and self.at(TokenKind.type) 'isTypeDecl'
				self.recordScannedType(structs, entries: entries)
				continue
			end 'isTypeDecl'

			// An `enum`/`union` DECLARATION, gated on depth 0 for `type`'s exact reason: both are
			// reserved keywords that are nonetheless legal as PARAMETER NAMES, so a bare `enum`/`union`
			// token can sit inside a parameter list (which `recordScannedSignature` skips wholesale). At
			// depth 0 it is a declaration and nothing else. `recordScannedEnum` consumes the whole
			// declaration — cursor past its `end` — so the loop's depth invariant is untouched.
			if depth == 0 and (self.at(TokenKind.enum) or self.at(TokenKind.union)) 'isEnumDecl'
				self.recordScannedEnum(enums, isUnion: self.at(TokenKind.union))
				continue
			end 'isEnumDecl'

			depth = self.blockDepthAfter(depth)
			self.advance()
		end 'scan'
		self.pos = resume

		index.foldFile(entries, aliases: aliases, structs: structs, enums: enums, bindings: bindings, fileTypeNames: self.artifact.typeNames)
	end 'foldDeclaredSignaturesInto'

	// Is the cursor on a `let` or a `var` — the two keywords that introduce a top-level binding?
	//
	// ONE predicate, read by BOTH the declaration sweep's depth-0 gate and `dispatchTopLevel`'s
	// arm, for the reason `assignsAt` is one predicate: a keyword taught to one and not the other
	// would put the sweep's idea of what is a declaration and the parser's a keyword apart. The
	// sweep would not record the binding, and `declaredOutcome`'s drift guard would panic on a
	// program that is perfectly correct.
	function atTopLevelBindingKeyword() returns bool
		return self.at(TokenKind.let) or self.at(TokenKind.var)
	end 'atTopLevelBindingKeyword'

	// The block depth after the token at the cursor. `end` FLOORS at zero rather than underflowing: a
	// stray `end` is malformed source, and the sweep is tolerant — the real parse reports it, with a
	// position. (`BlockDepth` is unsigned, so an underflow would not merely be wrong, it would take the
	// compiler down on a file it should have diagnosed.)
	function blockDepthAfter(depth BlockDepth) returns BlockDepth
		if self.opensBlockAt(self.pos) 'opens'
			return depth + 1
		end 'opens'

		// A keyword case-name arm (`end gives …`) is not a block close — see `keywordIsMatchCaseName`.
		if self.at(TokenKind.end) and depth > 0 and not self.keywordIsMatchCaseName(self.pos) 'closes'
			return depth - 1
		end 'closes'

		return depth
	end 'blockDepthAfter'

	// Cursor is AT a top-level `let`. Append the constant it declares.
	//
	// TOLERANT, exactly as `recordScannedSignature` and `recordScannedTypeAlias` are, and for the same
	// reason: a malformed declaration is the REAL parse's to report, with a position. It reads through
	// `readTopLevelConstant` — the routine the real parse reads with — so the two cannot drift on where
	// an initializer ends. That routine consumes the `let` keyword before it can fail, so the cursor
	// always advances and the caller's loop cannot spin.
	function recordScannedBinding(bindings TopLevelDeclArray)
		let visibility = self.scannedVisibility()
		let decl = try self.readTopLevelBinding(visibility) otherwise return
		bindings.push(decl)
	end 'recordScannedBinding'

	// The visibility of the declaration at the cursor, read from the token BEFORE it.
	//
	// Backwards, rather than by tracking an `export` flag forward across the scan loop: a flag would
	// have to be CLEARED on every token that is not a declaration, and the one clear that got missed
	// would silently export the next declaration — a visibility bug, which is a wrong answer about
	// what another file can see. `dispatchTopLevel` consumes `export` and the keyword adjacently, so
	// the previous token is exactly the modifier and nothing else can sit between them.
	function scannedVisibility() returns Visibility
		if self.pos == 0 'atFileStart'
			return Visibility.file
		end 'atFileStart'

		if self.kindAt(self.pos - 1) == TokenKind.export 'exported'
			return Visibility.module
		end 'exported'

		return Visibility.file
	end 'scannedVisibility'

	// Cursor is just past `function`. Append the declared return type of the function whose
	// name follows, if the declaration is well-formed enough to read one off.
	//
	// The name is `declaredMethodName`'s, not the token's, so a factory inside `type Point` is
	// recorded under the very key `Point.create(3, y: 4)` will look it up by — see there.
	function recordScannedSignature(entries FuncReturnTypeEntryArray)
		if not self.at(TokenKind.identifier) 'noName'
			return
		end 'noName'
		let nameTok = self.current()
		self.advance()
		if not self.skipBalancedParens() 'malformedParams'
			return
		end 'malformedParams'
		let returnType = try self.parseOptionalReturnType() otherwise return
		entries.push(FuncReturnTypeEntry.create(self.declaredMethodName(nameTok), returnType: returnType))
	end 'recordScannedSignature'

	// The name a `function <nameTok>` is DECLARED under: its own, at file scope; `Point.create`
	// inside `type Point`.
	//
	// It reads `enclosingType`, which BOTH the sweep and the real parse set (see that field), so
	// the key the index records and the key the `IrFunction` carries are one name derived one way.
	// The alternative — the sweep recording `create` and the parse declaring `Point.create` — is
	// not a subtle failure: every call would report E3004 against a name nothing declared.
	function declaredMethodName(nameTok Token) returns ByteArray
		if self.enclosingType.isEmpty() 'freeFunction'
			return nameTok.value
		end 'freeFunction'
		return qualifiedMethodName(self.enclosingType, methodName: nameTok.value)
	end 'declaredMethodName'

	// Cursor is AT `typealias`. Append the alias the declaration names, if it is well-formed enough
	// to read one off.
	//
	// TOLERANT, exactly as `recordScannedSignature` is, and for the same reason: a malformed alias
	// is the REAL parse's to report, with a position; a sweep that could veto would reject a correct
	// program the moment it failed to recognize something the parser accepts.
	//
	// It reads through `readTypeAliasDeclaration` — the very routine the real parse reads with — so
	// the sweep and the parse cannot drift into two opinions of what a range MEANS. That shared
	// routine consumes the `typealias` keyword before it can fail, so the cursor always advances and
	// the caller's loop cannot spin.
	function recordScannedTypeAlias(aliases RangedTypeAliasArray)
		let alias = try self.readTypeAliasDeclaration() otherwise return
		aliases.push(alias)
	end 'recordScannedTypeAlias'

	// Cursor is AT `type`. Append the struct it declares, plus a `FuncReturnTypeEntry` for each
	// method it declares, and leave the cursor PAST the declaration's `end`.
	//
	// TOLERANT, exactly as `recordScannedSignature` and `recordScannedTypeAlias` are, and for the
	// same reason: a malformed `type` is the REAL parse's to report, with a position. It shares
	// `readTypeHeader`, `atStructFieldKeyword`, `readStructFieldInto` and `recordScannedSignature`
	// with `parseTypeDeclaration`, so the sweep and the parse cannot drift on what a field IS, what
	// a method is CALLED, or where the declaration ENDS — the three facts they must agree on,
	// because the layout THIS pass records is the one the real parse reads every offset out of.
	//
	// ⚠ IT WALKS THE BODY ITSELF rather than letting the caller's loop do it, and the reason is the
	// depth-0 gate on fields: `export var x as Integer` is a FIELD at the type's top level and a
	// LOCAL BINDING one level down, and only a counter that knows where the type's body starts can
	// tell them apart. `depth` here is relative to the body — 0 is directly inside it — and
	// `blockDepthAfter` is the same opener/closer rule the caller counts with, so a method's `if`
	// and `while` nest correctly and its `end` cannot be mistaken for the type's.
	function recordScannedType(structs StructLayoutArray, entries FuncReturnTypeEntryArray)
		let nameTok = try self.readTypeHeader() otherwise return
		self.enclosingType = nameTok.value

		var layout = StructLayout.create(nameTok.value)

		var depth = 0 as BlockDepth
		while not self.isEof() 'body'
			if depth == 0 and self.at(TokenKind.end) 'closesType'
				self.advance()
				self.skipOptionalLabel()
				break
			end 'closesType'

			if depth == 0 and self.atStructFieldKeyword() 'isField'
				// A field the sweep cannot read leaves the layout SHORT, which would put every later
				// field at the wrong offset — so the scan stops rather than recording a layout it
				// knows is wrong. The real parse reports the malformed declaration properly.
				try self.readStructFieldInto(layout) otherwise break
				continue
			end 'isField'

			if self.at(TokenKind.function) 'isMethod'
				// The method opens a block closed by its own `end`. Counted BEFORE the signature is
				// read, because reading it moves the cursor past the `function` keyword — the caller's
				// loop does exactly this, for exactly this reason.
				depth = depth + 1
				self.advance()
				self.recordScannedSignature(entries)
				continue
			end 'isMethod'

			depth = self.blockDepthAfter(depth)
			self.advance()
		end 'body'

		structs.push(layout)
		self.enclosingType = EmptySourceText
	end 'recordScannedType'

	// Cursor is AT `enum`/`union`. Append the enum/union it declares and leave the cursor PAST the
	// declaration's `end` — `recordScannedType`'s twin.
	//
	// TOLERANT, for `recordScannedType`'s reason: a malformed enum is the REAL parse's to report,
	// with a position. It shares `readEnumCaseInto` and `atEnumBodyEnd` with `parseEnumDeclaration`,
	// so the sweep and the parse cannot drift on how a case's TAG is assigned — the fact the parser
	// reads back at every `Color.red` and every `match`. `readEnumCaseInto` consumes the keyword
	// before it can fail (below), so the cursor always advances and the caller's loop cannot spin.
	//
	// It walks the body ITSELF (like `recordScannedType`) rather than letting the caller's loop do
	// it: a case named `end` means only `atEnumBodyEnd`'s label-lookahead rule can tell the
	// terminator from a case, which the caller's generic `blockDepthAfter` cannot.
	function recordScannedEnum(enums EnumLayoutArray, isUnion bool)
		try self.consume(TokenKind.union if isUnion else TokenKind.enum) otherwise return
		let nameTok = try self.consume(TokenKind.identifier) otherwise return

		var layout = EnumLayout.create(nameTok.value, isUnion: isUnion)
		var state = EnumBackingState.create()

		while not self.isEof() 'body'
			self.skipNewlines()
			if self.atEnumBodyEnd() 'closes'
				self.advance()
				self.skipOptionalLabel()
				break
			end 'closes'

			// A method (`function <name>(`) — stop, tolerantly; the real parse rejects it with a
			// position. `function` ALONE is a legal case name, so only a real method-start stops here.
			if self.atEnumMethodStart() 'method'
				break
			end 'method'

			// A case the sweep cannot read leaves the layout SHORT, which would misassign every later
			// case's tag — so the scan stops rather than recording a layout it knows is wrong.
			try self.readEnumCaseInto(layout, state: state) otherwise break
		end 'body'

		enums.push(layout)
	end 'recordScannedEnum'

	// `type <Name>` — the two tokens every type declaration opens with, read by BOTH the tolerant
	// sweep and the real parse. One reader, so the two can never disagree about what a type is
	// CALLED, which is the name every method of it is declared under and every use of it resolves
	// through.
	function readTypeHeader() returns Token throws ParseError
		try self.consume(TokenKind.type)
		return try self.consume(TokenKind.identifier)
	end 'readTypeHeader'

	// Is the cursor on a FIELD declaration — `[export] (let|var) <name> as <Type>`?
	//
	// It defers to `atTopLevelBindingKeyword` for the keyword test rather than respelling it, for
	// that predicate's own reason: `let` and `var` introduce a binding in three places now (file
	// scope, a type body, a function body), and a keyword taught to one spelling and not another
	// would put two readers of one grammar a token apart.
	function atStructFieldKeyword() returns bool
		if self.at(TokenKind.export) 'exported'
			return self.kindAt(self.pos + 1) == TokenKind.let or self.kindAt(self.pos + 1) == TokenKind.var
		end 'exported'
		return self.atTopLevelBindingKeyword()
	end 'atStructFieldKeyword'

	// Read one field declaration into `layout`. THE one field reader, shared by the sweep and the
	// real parse, so `StructLayout`'s field ORDER (which IS the box's slot order — see
	// `StructLayout.offsetOfField`) is read exactly once from one grammar. Two readers would be free
	// to disagree about how many fields a type has, and the one that was wrong would place every
	// later field at the wrong offset: a silent out-of-bounds read, not a compile error.
	//
	// **THE THREE LEGAL SHAPES**, and the `as` is what tells them apart:
	//
	//   1. `export var x as Integer`     — annotated, no default. A literal must supply it (E3086).
	//   2. `export var x = 0`            — the literal supplies BOTH the value and the TYPE.
	//   3. `export var x as Integer = 0` — annotated AND defaulted; the literal is checked against
	//                                      the annotation.
	//
	// Neither `as` nor `=` is E2010 — the `consume(equals)` below reporting the token it wanted.
	//
	// **TWO KEYWORDS, TWO BITS, AND BOTH ARE KEPT.** `let` vs `var` decides FIELD MUTABILITY
	// (`c.version = 2` on a `let` field is E2013 — `StructLayout.fieldMutable`); `export` decides
	// FIELD VISIBILITY (`v.private` from outside `type Value` is E3014 —
	// `StructLayout.fieldExported`, read by `requireFieldAccessible`). They ride the same
	// `addField` call, which is the one writer of every column.
	//
	// ⚠ The `export` bit was CONSUMED AND DROPPED until P1.1a wave 3, and the reason this comment
	// gave for dropping it was false twice over. It said *"field visibility gates cross-FILE access
	// (E3014), and shv2 has no cross-file name resolution to gate"* — but visibility gates access
	// from outside the TYPE, in the same file (measured: `type B` reading `type A`'s unexported
	// field is E3014 on the bootstrap), so the bit always had a live consumer and shv2 silently
	// accepted a program the language rejects. It is kept now, and the rung that reads it is the
	// one that ported `specs/export-var-fields.md`'s two `error.unexported-field-*` cases.
	function readStructFieldInto(layout StructLayout) throws ParseError
		let exported = self.at(TokenKind.export)
		if exported 'isExported'
			self.advance()
		end 'isExported'

		let mutable = self.at(TokenKind.var)
		try self.consume(TokenKind.var if mutable else TokenKind.let)

		let nameTok = try self.consume(TokenKind.identifier)
		// A `__`-prefixed field is reserved. This reader is shared with the tolerant sweep
		// (`recordScannedType`), which swallows the throw (`otherwise break`) and leaves the positioned
		// diagnostic to the real parse — the sweep is not a validator.
		try self.requireUnreservedName(nameTok)

		if not self.at(TokenKind.as) 'typeFromLiteral'
			// Shape 2. There is no annotation to read the type off, so the literal's TOKEN KIND is
			// the whole of the type inference — see `readFieldDefaultLiteral`.
			try self.consume(TokenKind.equals)
			let inferred = try self.readFieldDefaultLiteral()
			layout.addField(nameTok.value, declaredType: constantValueType(inferred.tag), mutable: mutable, exported: exported, defaultValue: FieldDefault.literal(inferred.payload))
			return
		end 'typeFromLiteral'

		try self.consume(TokenKind.as)
		let fieldType = try self.parseTypeReference()

		if not self.at(TokenKind.equals) 'noDefault'
			layout.addField(nameTok.value, declaredType: fieldType, mutable: mutable, exported: exported, defaultValue: FieldDefault.none)
			return
		end 'noDefault'

		// Shape 3. The ANNOTATION is the field's type and the literal must agree with it: `as
		// Integer = 50.0` is the same lossy coercion `var x as Integer` then `x = 50.0` is, so it
		// asks the same rule (`requireAssignable`) rather than a second opinion about floats.
		try self.consume(TokenKind.equals)
		let given = try self.readFieldDefaultLiteral()
		try self.requireAssignable(nameTok, value: given.tag, declared: maxonTypeTag(fieldType))
		layout.addField(nameTok.value, declaredType: fieldType, mutable: mutable, exported: exported, defaultValue: FieldDefault.literal(given.payload))
	end 'readStructFieldInto'

	// The literal a field default is, as the SAME tagged pair the constant evaluator speaks in — its
	// VALUE and its TAG, off one token, returned together so a caller cannot read one without the
	// other. `constantValueType` turns the tag into the field's declared type, which is the point:
	// shape 2 above derives that type from nothing but this token.
	//
	// It is a `ConstValue` and not a private record because it IS one — payload plus tag — and the
	// tag→`MaxonType` mapping already exists for the other producer of folded literals. A second
	// pair would have been a second answer to "what type is an integer literal".
	//
	// ⭐ **TYPE INFERENCE HERE IS A TOKEN-KIND LOOKUP, NOT CONSTANT EVALUATION**, and it has to be:
	// the type must be known when `ProgramSignatures.recordStruct` hashes the layout, and that runs
	// inside the declaration SWEEP — before `evaluateInitializers` has folded a single constant. A
	// token kind is available at scan time; a constant's value is not. (v1 infers it the same way,
	// from the same three token kinds: `inferShorthandFieldType`, Parser.maxon:3634-3665.)
	//
	// The three literal DECODERS are the emitting path's own (`intLiteralValue`, `parseFloatBits`,
	// `BoolTrueValue`) — the same ones `evalConstIntLiteral` and friends call, for their stated
	// reason: a field default must read a literal exactly as a function body reads it.
	function readFieldDefaultLiteral() returns ConstValue throws ParseError
		let negated = self.at(TokenKind.minus)
		if negated 'signed'
			self.advance()
		end 'signed'

		if self.at(TokenKind.intLiteral) 'intLit'
			let tok = try self.consume(TokenKind.intLiteral)
			return ConstValue.create(try self.intLiteralValue(tok, negated: negated), tag: ValueTypeTag.integer)
		end 'intLit'

		if self.at(TokenKind.floatLiteral) 'floatLit'
			let tok = try self.consume(TokenKind.floatLiteral)
			let bits = try parseFloatBits(tok.value) otherwise throw ParseError.floatLiteralOverflow(tok.line, column: tok.column)
			return ConstValue.create(negatedFloatBits(bits) if negated else bits, tag: ValueTypeTag.float)
		end 'floatLit'

		if self.at(TokenKind.true) or self.at(TokenKind.false) 'boolLit'
			return try self.readBoolFieldDefault(negated)
		end 'boolLit'

		// Everything else — `= pick()`, `= 2 + 3`, `= OTHER`. See `rejectNonLiteralFieldDefault`.
		throw self.rejectNonLiteralFieldDefault()
	end 'readFieldDefaultLiteral'

	// `= true` / `= false`. A leading `-` is not a sign here — there is no negative bool — so it is
	// rejected as the non-literal it is rather than silently ignored.
	function readBoolFieldDefault(negated bool) returns ConstValue throws ParseError
		if negated 'negatedBool'
			throw self.rejectNonLiteralFieldDefault()
		end 'negatedBool'

		let isTrue = self.at(TokenKind.true)
		self.advance()
		return ConstValue.create(BoolTrueValue if isTrue else BoolFalseValue, tag: ValueTypeTag.boolean)
	end 'readBoolFieldDefault'

	// ⚠ **A NON-LITERAL DEFAULT IS DEFERRED, AND IT IS DEFERRED LOUDLY** — positioned at the token
	// that is not a literal, naming the mechanism that is missing.
	//
	// ⚠ **THIS OVER-REJECTS, DELIBERATELY. THE BOOTSTRAP ACCEPTS IT** (measured: `export var x as
	// Integer = pick()` compiles, and the field arrives holding 4). A default is an arbitrary
	// expression there, evaluated at CONSTRUCTION — v1 implements it by synthesizing a nullary
	// `__field_init_*` function per default and splicing a call into every literal
	// (Parser.maxon:15885-15893). That machinery needs the initializer captured at the declaration
	// and replayed at each construction site, and it has ZERO reachable consumers at this rung:
	// every corpus case that wants it also wants Array (P1.7), String (P1.2) or a struct-typed
	// field. Building it now would be a mechanism with no consumer — this ladder's founding error,
	// made four times on P1.0r — so the rung takes the literal every enabled case actually needs,
	// and says plainly that the rest is not here yet.
	function rejectNonLiteralFieldDefault() returns ParseError
		let tok = self.current()
		return ParseError.unsupported("'{tok.kind.rawValue}' as a field default (only a LITERAL default is parsed — `= 5`, `= 50.0`, `= true`, optionally signed. An arbitrary expression is evaluated once per struct literal, which needs the initializer captured at the declaration and replayed at every literal that omits the field, and arrives with the rung that has a case needing one)", line: tok.line, column: tok.column)
	end 'rejectNonLiteralFieldDefault'

	// Advance past a balanced `( … )` starting at the cursor. Returns false — leaving the
	// cursor where it stopped — when the token stream does not hold one, which the real
	// parse will report properly. Depth-counted rather than "scan to the first `)`" because
	// a parameter's type can itself carry parentheses (`int(0 to 100)`).
	function skipBalancedParens() returns bool
		if not self.at(TokenKind.leftParen) 'noParen'
			return false
		end 'noParen'
		var depth = 0
		while not self.isEof() 'scan'
			if self.at(TokenKind.leftParen) 'open'
				depth = depth + 1
			end 'open' else if self.at(TokenKind.rightParen) 'close'
				depth = depth - 1
			end 'close'
			self.advance()
			if depth == 0 'balanced'
				return true
			end 'balanced'
		end 'scan'
		return false
	end 'skipBalancedParens'

	// One top-level declaration: an optional `export`, then a `function`, a ranged `typealias`, a
	// `type`, or a `let`/`var` binding. Everything else (enum, union, extension, interface, ...) is
	// out of the slice and rejected with a positioned error.
	//
	// `visibility` is consumed by `parseFunction` and by `readTopLevelBinding`. A typealias carries
	// one too, and it is deliberately DROPPED: alias visibility decides whether a name is reachable
	// from another FILE, and the alias registry is whole-program until cross-file name resolution
	// lands (see `commitTypeAliases`). Recording it now would be a field nothing reads. A `type`'s
	// visibility is dropped for the identical reason — `project.structTypes` is whole-program —
	// which is why `parseTypeDeclaration` does not take one. Its METHODS each carry their own, read
	// at the member (see `parseTypeMember`), because that is where the source writes it.
	function dispatchTopLevel() throws ParseError
		var visibility = Visibility.file
		if self.at(TokenKind.export) 'exported'
			self.advance()
			visibility = Visibility.module
		end 'exported'

		if self.at(TokenKind.function) 'isFunction'
			// A FILE-scope function takes no receiver: there is no enclosing type for one to be.
			try self.parseFunction(visibility, takesReceiver: false)
		end 'isFunction' else if self.at(TokenKind.typealias) 'isTypeAlias'
			self.artifact.recordTypeAlias(try self.readTypeAliasDeclaration())
		end 'isTypeAlias' else if self.at(TokenKind.type) 'isTypeDecl'
			try self.parseTypeDeclaration()
		end 'isTypeDecl' else if self.at(TokenKind.enum) or self.at(TokenKind.union) 'isEnumDecl'
			try self.parseEnumDeclaration(self.at(TokenKind.union))
		end 'isEnumDecl' else if self.atTopLevelBindingKeyword() 'isBinding'
			// The declaration EMITS NOTHING — for a `var` exactly as for a `let`. A constant inlines at
			// every read; a var's slot is laid down by the backend from the arena
			// (`ProgramSignatures.declaredGlobals`), and its every read and write is emitted at the USE
			// site. So there is nothing for the real parse to build here either way, only something for
			// it to REPORT.
			let decl = try self.readTopLevelBinding(visibility)
			try self.raiseBindingFailure(decl)
		end 'isBinding' else 'unsupported'
			let tok = self.current()
			throw ParseError.unsupported("top-level {tok.kind.rawValue}", line: tok.line, column: tok.column)
		end 'unsupported'
	end 'dispatchTopLevel'

	// ⭐ A TOP-LEVEL `let` IS A COMPILE-TIME CONSTANT, AND THE DECLARATION IS WHERE ITS DIAGNOSTIC
	// LANDS — but not where its VALUE is computed.
	//
	// The declaration itself emits NO op and reserves NO storage. The whole-program sweep already
	// folded this initializer to a number (`ProgramSignatures.evaluateInitializers`), and every USE
	// inlines that number as an ordinary `literal` (`topLevelConstantReference`). So there is nothing
	// left for the real parse to build — only something for it to REPORT, if the fold failed.
	//
	// That split is why the value is not simply computed here: this file's parse can see this file's
	// initializer, and neither a forward reference (`let TOTAL = FIRST + SECOND` above `FIRST`) nor a
	// cross-file `export let` is visible to it. Both are ordinary in the corpus, so the fold has to
	// happen where every declaration is already in view, and that is the sweep. v1 splits it exactly
	// here too — its parser records an unresolved initializer and TypeResolution evaluates it.
	//
	// A DECL WHOSE FOLD FAILED IS REPORTED HERE, AND EXACTLY ONCE. `poisoned` is silent on purpose —
	// its defect belongs to another declaration, which reports it (see `TopLevelConstant.poisoned`).
	//
	// `declaredOutcome` carries the DRIFT GUARD: a `let` the real parse dispatches at top
	// level must be one the sweep recorded, and a miss panics rather than compiling.
	function raiseBindingFailure(decl TopLevelDecl) throws ParseError
		// ⚠ The outcome is bound to a LOCAL before the match, and the match's payload is bound to a
		// second one before the throw. Neither is style. Matching the CALL directly and throwing the
		// arm's binding —
		//
		//     match self.signatures.declaredOutcome(decl) 'outcome'
		//         failed(error) then throw error
		//
		// — crashes the compiled compiler with `mm_incref called with NULL pointer`, because the
		// bootstrap drops the temporary scrutinee's box while the payload it lent out is still in
		// flight. This is the sharp end of the hazard `emitShift` already documents (a `throw` of a
		// union that was RETURNED rather than constructed inline LEAKS); here it is not a leak but a
		// null-pointer panic. Recorded for OPEN.md.
		let outcome = self.signatures.declaredOutcome(decl)
		match outcome 'outcome'
			value(_, tag) then try self.requireStorableGlobal(decl, tag: tag)
			poisoned then break 'outcome'
			failed(error) then try self.throwRecordedConstantError(error)
			pending to evaluating then panic("Parser.raiseBindingFailure: top-level binding '{String.from(decl.name)}' is unevaluated — `evaluateInitializers` runs to completion inside `queryProgramSignatures`, before any file is parsed")
		end 'outcome'
	end 'raiseBindingFailure'

	// ⚠ **A TOP-LEVEL `var` MUST BE A SCALAR — there is no heap until P1.2.** Rejected AT THE
	// DECLARATION, which is the line the user wrote and the only place the diagnostic can name it;
	// a use site would report against code that is merely reading a name.
	//
	// It fires on nothing today and that is deliberate rather than dead: the constant evaluator folds
	// integers and bools only, so a `var s = "hi"` is already rejected upstream as a non-constant
	// initializer. This is the guard for the day the evaluator LEARNS a type before the backend can
	// store one — the first of those is P1.0d.4's float, which is a scalar and will simply pass, and
	// the one that matters is P1.2's `String`, which is a heap pointer and must not. `globalStdType`
	// is the same decision's other half, and it panics where this reports: a decl that reached the
	// backend unstorable is an invariant break, a decl the USER wrote unstorable is a diagnostic.
	function requireStorableGlobal(decl TopLevelDecl, tag ValueTypeTag) throws ParseError
		if not decl.mutable 'constantNeedsNoStorage'
			return
		end 'constantNeedsNoStorage'
		// A float is a SCALAR — 8 bytes of `.data`, exactly as an `int` is, and `globalStdType` gets
		// the width from the same table the lowering uses. What the rule is really asking is
		// "does this type need the HEAP?", and a double no more needs one than an i64 does.
		if tag == ValueTypeTag.integer or tag == ValueTypeTag.boolean or tag == ValueTypeTag.float 'scalar'
			return
		end 'scalar'

		throw ParseError.unsupported("a top-level `var` of type '{typeTagName(tag)}' (a global with a managed or non-scalar type needs the heap and the runtime that owns it — P1.2 String; only `int`/`bool`/`float` globals have storage today)", line: decl.nameLine, column: decl.nameColumn)
	end 'requireStorableGlobal'

	// Re-raise a diagnostic the constant evaluator recorded earlier, on another file's behalf. It
	// exists only to give the borrowed payload a scope of its own — see `raiseConstantFailure`.
	function throwRecordedConstantError(error ParseError) throws ParseError
		throw error
	end 'throwRecordedConstantError'

	// Read a top-level binding declaration: `[export] (let|var) <NAME> = <constant expression>`.
	//
	// It READS and does not RECORD, for exactly `readTypeAliasDeclaration`'s reason: it has two
	// callers that record differently. The tolerant declaration sweep folds what it reads into the
	// whole-program index (`recordScannedBinding`); the real parse reads it only to ask that index
	// what the initializer came to, and to raise the answer as a POSITIONED diagnostic if it failed.
	//
	// One reader, so the sweep and the parse can never drift on where an initializer ENDS — which is
	// the one thing they must agree on, because the range this returns is the range the evaluator
	// walks. Two scanners would put the sweep's idea of the initializer and the parser's idea of it a
	// token apart, and the evaluator would fold a different expression than the one the user wrote.
	//
	// ⭐ **`let` AND `var` READ IDENTICALLY, WHICH IS WHY THIS IS ONE FUNCTION.** They differ in the
	// keyword and in nothing else: `static-variables.md` states that a top-level `var`'s initializer
	// obeys the same constant-expression rules as a `let`'s, so the same token range feeds the same
	// evaluator. The mutability is simply carried through to the decl, where it decides storage.
	function readTopLevelBinding(visibility Visibility) returns TopLevelDecl throws ParseError
		let mutable = self.at(TokenKind.var)
		try self.consume(TokenKind.var if mutable else TokenKind.let)
		let nameTok = try self.consume(TokenKind.identifier)
		try self.requireUnreservedName(nameTok)
		try self.consume(TokenKind.equals)

		let initStart = self.pos
		let initEnd = self.initializerEndIndex(initStart)
		self.pos = initEnd

		return TopLevelDecl.create(nameTok.value, mutable: mutable, visibility: visibility, declFilePath: self.filePath, tokens: self.tokens, initStart: initStart, initEnd: initEnd, nameLine: nameTok.line, nameColumn: nameTok.column)
	end 'readTopLevelBinding'

	// One past the last token of a top-level initializer: an initializer runs to the END OF ITS LINE.
	// Maxon has no statement terminator, so the newline IS the boundary — the bootstrap reads it the
	// same way (`SkipToEndOfLine`, 2-Parser.cs:1701).
	//
	// It cannot run away: `kindAt` answers `eof` past the end of the token array (see `tokenAt`), so
	// an unterminated last line stops at the file's end rather than walking off it.
	function initializerEndIndex(start TokenIndex) returns TokenIndex
		var i = start
		while self.kindAt(i) != TokenKind.newline and self.kindAt(i) != TokenKind.eof 'scan'
			i = i + 1
		end 'scan'

		return i
	end 'initializerEndIndex'

	// Parse a ranged typealias declaration: `typealias <Name> = int(<low> to|upto <high>)`.
	// Nearly every real Maxon file opens with one — `int` is almost never written bare in
	// a type position (specs/ranged-typealias.md) — so this is the declaration that gates
	// most of the corpus.
	//
	// It emits NO op: an alias is a DECLARATION, and its whole effect is the registry
	// entry its caller records, which TypeResolution substitutes for every `MaxonType.named`
	// use of the name. Two aliases over the same range are therefore the SAME type — an
	// alias creates no nominal distinction — and a use in a type position needs no parser
	// change at all (`parseTypeReference` already interns a bare identifier).
	//
	// It READS and does not RECORD, because it has two callers that record differently: the real
	// parse files the alias in this file's artifact, and the whole-program declaration sweep
	// (`recordScannedTypeAlias`) folds it into the cross-file index the shift rule reads. One
	// reader, so the two can never disagree about what a range means.
	//
	// The RANGE is not yet enforced as a bound: a narrowing conversion into a ranged alias is
	// checked at run time, and that check is a later milestone. It IS read, and by more than the
	// registry — a range whose low bound is 0 declares an UNSIGNED type, and that decides how every
	// `shr` on a value of it fills (TypeRules' `rangeIsUnsigned`).
	function readTypeAliasDeclaration() returns RangedTypeAlias throws ParseError
		try self.consume(TokenKind.typealias)
		let nameTok = try self.consume(TokenKind.identifier)
		try self.requireUnreservedName(nameTok)
		try self.consume(TokenKind.equals)

		// `int(...)` only. A `float(...)` alias needs float literals for its bounds, a
		// generic alias (`Array with T`) needs generics, and a bare `i64` is not legal
		// Maxon at all — each is rejected here, naming its own gap, rather than being
		// mapped onto the integer path where it would silently mean something else.
		if not self.at(TokenKind.int) 'notInt'
			let tok = self.current()
			throw ParseError.unsupported("a typealias over '{tok.kind.rawValue}' (only `int(low to high)` is parsed; float, generic and bare-sized aliases arrive with the milestones that give them meaning)", line: tok.line, column: tok.column)
		end 'notInt'
		try self.consume(TokenKind.int)

		try self.consume(TokenKind.leftParen)
		let low = try self.parseRangeBound()
		let high = try self.parseRangeUpperBound()
		try self.consume(TokenKind.rightParen)

		return RangedTypeAlias.create(nameTok.value, underlying: MaxonType.integer, low: low, high: high)
	end 'readTypeAliasDeclaration'

	// The `to <high>` / `upto <high>` half of a range, returned as an INCLUSIVE upper
	// bound: `upto` is exclusive, so it normalizes to `high - 1` here and the registry
	// keeps exactly one representation of a range (`0 upto 10` and `0 to 9` are the same
	// alias, which is what the language says they are).
	//
	// `i64.min` has no `upto` form — its exclusive bound would be one BELOW the smallest
	// representable value. Rejected with a positioned error, because the subtraction that
	// normalizes it would otherwise underflow `ParsedInt` and take the COMPILER down on a
	// source file it should merely have diagnosed.
	function parseRangeUpperBound() returns ParsedInt throws ParseError
		if self.at(TokenKind.upto) 'exclusive'
			let uptoTok = try self.consume(TokenKind.upto)
			let bound = try self.parseRangeBound()
			if bound == I64MinBound 'unrepresentable'
				throw ParseError.unsupported("an exclusive upper bound of i64.min — its inclusive form is one below the smallest 64-bit integer, so the range is empty and not representable", line: uptoTok.line, column: uptoTok.column)
			end 'unrepresentable'
			return bound - 1
		end 'exclusive'

		try self.consume(TokenKind.to)
		return try self.parseRangeBound()
	end 'parseRangeUpperBound'

	// One endpoint of a range: an integer literal (`0`, `-273`, `0xFFFF`) or a
	// type-qualified bound (`i64.min`, `u32.max`).
	function parseRangeBound() returns ParsedInt throws ParseError
		if self.at(TokenKind.minus) 'negative'
			try self.consume(TokenKind.minus)
			let tok = try self.consume(TokenKind.intLiteral)
			return try self.intLiteralValue(tok, negated: true)
		end 'negative'

		if self.at(TokenKind.intLiteral) 'literal'
			let tok = try self.consume(TokenKind.intLiteral)
			return try self.intLiteralValue(tok, negated: false)
		end 'literal'

		return try self.parseTypeQualifiedBound()
	end 'parseRangeBound'

	// Convert an integer-literal token's text to its value, re-raising NumberParsing's
	// overflow as a POSITIONED parse error. THE one place a literal's text becomes a
	// number: the expression parser (`parseIntLiteral`) and the range-bound parser both
	// come through it, so how a literal is read — the radix prefixes it accepts, the
	// overflow it rejects — cannot come to mean one thing in `return 42` and another in
	// `int(0 to 42)`.
	//
	// `negated` routes to `parseNegatedInt` rather than negating the result: `i64.min`'s
	// magnitude does not fit a POSITIVE i64, so negating after the fact would overflow on
	// the one bound that most needs to work.
	function intLiteralValue(tok Token, negated bool) returns ParsedInt throws ParseError
		if negated 'negative'
			return try parseNegatedInt(tok.value) otherwise throw ParseError.integerOverflow(tok.line, column: tok.column)
		end 'negative'
		return try parseInt(tok.value) otherwise throw ParseError.integerOverflow(tok.line, column: tok.column)
	end 'intLiteralValue'

	// A type-qualified numeric bound — `<sized>.min` / `<sized>.max`, three tokens
	// (identifier, `.`, identifier). Shared by the range-declaration parser and the
	// expression parser, which meet the same three tokens in two positions.
	function parseTypeQualifiedBound() returns ParsedInt throws ParseError
		let typeTok = try self.consume(TokenKind.identifier)
		try self.consume(TokenKind.dot)
		let fieldTok = try self.consume(TokenKind.identifier)
		let wantMax = try self.boundFieldIsMax(fieldTok)

		match sizedTypeBound(typeTok.value, wantMax: wantMax) 'resolve'
			value(bound) then return bound
			floatBound then throw ParseError.unsupported("the float bound '{String.from(typeTok.value)}.{String.from(fieldTok.value)}' (float bounds arrive with floats)", line: typeTok.line, column: typeTok.column)
			notASizedType then throw ParseError.unexpectedToken("a sized numeric type (u8/u16/u32/u64/i8/i16/i32/i64)", got: String.from(typeTok.value), line: typeTok.line, column: typeTok.column)
		end 'resolve'
	end 'parseTypeQualifiedBound'

	// True for `.max`, false for `.min`. Any other field name is a positioned error —
	// a sized type exposes exactly these two bounds.
	function boundFieldIsMax(fieldTok Token) returns bool throws ParseError
		if fieldTok.value.equals(MaxBoundField) 'max'
			return true
		end 'max'
		if fieldTok.value.equals(MinBoundField) 'min'
			return false
		end 'min'
		throw ParseError.unexpectedToken("'min' or 'max'", got: String.from(fieldTok.value), line: fieldTok.line, column: fieldTok.column)
	end 'boundFieldIsMax'

	// Parse a struct type declaration (P1.0r):
	//
	//     type Point
	//         export var x as Integer
	//         export var y as Integer
	//         static function create(x Integer, y Integer) returns Self
	//             return Self{x: x, y: y}
	//         end 'create'
	//     end 'Point'
	//
	// ⭐ **THE DECLARATION EMITS NOTHING** — no op, no storage, no code. A `type` is a LAYOUT, and
	// its whole effect is the `StructLayout` recorded below, which `Self{…}` sizes its `__mm_alloc`
	// from and `p.x` reads its offsets out of. Its METHODS are ordinary functions, named
	// `Point.create` (`declaredMethodName`) and built by the very same `parseFunction` a free
	// function is: there is no method table, no receiver, and nothing for a call to dispatch
	// through. That is the whole of `static function` at this rung.
	//
	// ⚠ **THE LAYOUT IS RECORDED AFTER THE BODY, AND NOTHING IN THE BODY READS IT.** `Self{x: x, y:
	// y}` inside `create` needs the field list — and it asks `signatures.structOf`, the WHOLE-PROGRAM
	// sweep, which is complete before this file's parse begins. So there is no ordering hazard, and
	// deliberately no half-built artifact registry for a method body to race: a `type` whose fields
	// are declared BELOW its methods parses identically to one that declares them above.
	function parseTypeDeclaration() throws ParseError
		let nameTok = try self.readTypeHeader()
		// The real parse alone rejects a reserved `type __T` — `readTypeHeader` stays a pure reader
		// shared with the tolerant sweep, which is not a validator (see `recordScannedType`).
		try self.requireUnreservedName(nameTok)
		self.enclosingType = nameTok.value

		var layout = StructLayout.create(nameTok.value)

		while true 'members'
			self.skipNewlines()
			if self.at(TokenKind.end) 'closes'
				break
			end 'closes'
			if self.isEof() 'eof'
				let tok = self.current()
				throw ParseError.unexpectedEof(tok.line, column: tok.column)
			end 'eof'

			if self.atStructFieldKeyword() 'isField'
				try self.readStructFieldInto(layout)
				continue
			end 'isField'

			try self.parseTypeMember()
		end 'members'

		try self.consume(TokenKind.end)
		self.skipOptionalLabel()

		self.artifact.recordStructType(layout)
		self.enclosingType = EmptySourceText
	end 'parseTypeDeclaration'

	// Parse an `enum`/`union` declaration (P1.1b wave B):
	//
	//     enum Color
	//         red
	//         green = 5
	//         blue
	//     end 'Color'
	//
	// ⭐ **THE DECLARATION EMITS NOTHING** — like a `type`, its whole effect is the `EnumLayout`
	// recorded below, which `Color.red` reads a case's TAG out of and an enum `match` reads the case
	// SET out of. `union` and `enum` share this routine entirely: only the diagnostic wording later
	// differs, carried by `layout.isUnion`.
	//
	// PAYLOAD-FREE ONLY. A payload (`case foo(x Int)`), a string/char/struct/function backing, and a
	// method inside the body each name their own later rung rather than being mapped onto the integer
	// path where they would silently mean something else.
	function parseEnumDeclaration(isUnion bool) throws ParseError
		try self.consume(TokenKind.union if isUnion else TokenKind.enum)
		let nameTok = try self.consume(TokenKind.identifier)
		try self.requireUnreservedName(nameTok)

		var layout = EnumLayout.create(nameTok.value, isUnion: isUnion)
		var state = EnumBackingState.create()

		while true 'cases'
			self.skipNewlines()
			if self.atEnumBodyEnd() 'closes'
				break
			end 'closes'
			if self.isEof() 'eof'
				let tok = self.current()
				throw ParseError.unexpectedEof(tok.line, column: tok.column)
			end 'eof'

			// A method inside an enum/union body — its whole surface (a receiver bound to an enum
			// value, `match self`) is a later rung. Rejected here, positioned, rather than silently
			// skipped (which would strand the method's `end` and misparse the rest). `function` alone
			// is a legal CASE name, so only `function <name>(` is a method (`atEnumMethodStart`).
			if self.atEnumMethodStart() 'method'
				let tok = self.current()
				throw ParseError.unsupported("a method on `{layout.kindWord()} {String.from(nameTok.value)}` (methods on an enum/union — a receiver bound to an enum value, `match self` — arrive with a later rung)", line: tok.line, column: tok.column)
			end 'method'

			try self.readEnumCaseInto(layout, state: state)
		end 'cases'

		try self.consume(TokenKind.end)
		self.skipOptionalLabel()

		self.artifact.recordEnumType(layout)
	end 'parseEnumDeclaration'

	// Is the cursor on the `end` that CLOSES an enum/union body — as opposed to a case NAMED `end`?
	//
	// ⚠ **`end` IS A LEGAL CASE NAME** (`keyword-as-case-name.md` declares one), so the terminator
	// cannot be recognized by the `end` keyword alone. The rule, mirrored byte-for-byte from the
	// bootstrap (`IsEndOfBlock`, 2-Parser.cs:3173): a terminating `end` is followed by the block
	// LABEL (a character literal) or by end-of-file; an `end` followed by anything else — a newline,
	// another case — is the case named `end`. Every corpus enum closes with a labelled `end 'Name'`,
	// which this recognizes; a bare unlabelled `end` mid-body would be read as a case, exactly as the
	// bootstrap reads it.
	function atEnumBodyEnd() returns bool
		if not self.at(TokenKind.end) 'notEnd'
			return false
		end 'notEnd'
		let next = self.kindAt(self.pos + 1)
		return next == TokenKind.charLiteral or next == TokenKind.eof
	end 'atEnumBodyEnd'

	// Does the cursor open a METHOD inside an enum/union body — `[export|static] function <name>(`?
	//
	// ⚠ **`function` IS ALSO A LEGAL CASE NAME** (`keyword-as-case-name.md` declares one), so a bare
	// `function` keyword does NOT open a method: a method is `function` followed by a NAME and a `(`.
	// Mirrors the bootstrap's `IsEnumMethodStart` (2-Parser.cs:3155). Methods on an enum are a later
	// rung, so this predicate exists only to REJECT one cleanly rather than misparse it.
	function atEnumMethodStart() returns bool
		var p = self.pos
		if self.kindAt(p) == TokenKind.export or self.kindAt(p) == TokenKind.static 'modifier'
			p = p + 1
		end 'modifier'
		if self.kindAt(p) != TokenKind.function 'notFunction'
			return false
		end 'notFunction'
		return self.kindAt(p + 1) == TokenKind.identifier and self.kindAt(p + 2) == TokenKind.leftParen
	end 'atEnumMethodStart'

	// Read ONE enum/union case into `layout`, threading the tag counter + backing through `state`.
	// Reports the three declaration diagnostics: E3030 (duplicate case name), E3031 (duplicate raw
	// value), E3032 (raw value type mismatch). SHARED by the real parse and the tolerant sweep
	// (`recordScannedEnum`), which wraps it in `otherwise` — so the two cannot drift on how a tag is
	// assigned, the one fact they MUST agree on (the sweep's layout is what the parser reads tags
	// from at a use site).
	function readEnumCaseInto(layout EnumLayout, state EnumBackingState) throws ParseError
		let nameTok = try self.readEnumCaseNameToken()
		let caseName = nameTok.value

		// A `__`-prefixed case is reserved. Checked before the duplicate/backing rules so the
		// reservation is reported at the name, and — as with the field reader — the tolerant sweep
		// (`recordScannedEnum`) swallows the throw and leaves the diagnostic to the real parse.
		try self.requireUnreservedName(nameTok)

		// E3030 — checked at the second declaration, as the bootstrap positions it.
		if layout.hasCase(caseName) 'duplicateCase'
			throw ParseError.enumDuplicateCase(String.from(caseName), line: nameTok.line, column: nameTok.column)
		end 'duplicateCase'

		// A payload (`case foo(x Int)`) — P1.3. Rejected here so the case list stays payload-free.
		if self.at(TokenKind.leftParen) 'payload'
			throw ParseError.unsupported("a payload on case '{String.from(caseName)}' (enum/union payloads — `case foo(x Int)` and their `foo(let x)` bindings — arrive at P1.3)", line: nameTok.line, column: nameTok.column)
		end 'payload'

		if not self.at(TokenKind.equals) 'bareName'
			// A bare case takes the auto-increment tag and requires integer backing.
			try self.requireIntBacking(state, caseTok: nameTok)
			let tag = state.nextTag
			state.nextTag = state.nextTag + 1
			try self.appendEnumCase(layout, caseName: caseName, tag: tag, rawDisplay: "{tag}", caseTok: nameTok)
			return
		end 'bareName'

		try self.consume(TokenKind.equals)

		// A FLOAT raw value: its tag is the IEEE-754 BIT PATTERN (matched by an i64 compare, exactly
		// as an int tag is), and its display is the float's source text.
		if self.at(TokenKind.floatLiteral) 'floatValue'
			let floatTok = try self.consume(TokenKind.floatLiteral)
			let bits = try parseFloatBits(floatTok.value) otherwise throw ParseError.floatLiteralOverflow(floatTok.line, column: floatTok.column)
			try self.requireFloatBacking(state, caseTok: nameTok)
			try self.appendEnumCase(layout, caseName: caseName, tag: bits, rawDisplay: String.from(floatTok.value), caseTok: nameTok)
			return
		end 'floatValue'

		// An INTEGER raw value (possibly negated). It resets the auto-increment counter to value + 1,
		// which is what makes `enum E { a = 5  b }` give `b` the tag 6.
		let intValue = try self.readEnumIntRawValue()
		try self.requireIntBacking(state, caseTok: nameTok)
		state.nextTag = intValue + 1
		try self.appendEnumCase(layout, caseName: caseName, tag: intValue, rawDisplay: "{intValue}", caseTok: nameTok)
	end 'readEnumCaseInto'

	// Read the token that NAMES a case — an identifier, or a keyword used as one. A string/char
	// literal here is a string/char BACKING (a later rung), reported as such rather than as a bad
	// name; anything else is malformed.
	function readEnumCaseNameToken() returns Token throws ParseError
		let tok = self.current()

		if self.at(TokenKind.stringLiteral) or self.at(TokenKind.charLiteral) 'stringCharBacking'
			throw ParseError.unsupported("a string- or char-backed enum/union case ({String.from(tok.value)}) — string/char backing, and the `.rawValue`/`.name` accessors that read it, arrive with String (P1.2)", line: tok.line, column: tok.column)
		end 'stringCharBacking'

		if not tokenNamesEnumCase(tok) 'notACaseName'
			throw ParseError.unexpectedToken("an enum case name", got: tok.kind.rawValue, line: tok.line, column: tok.column)
		end 'notACaseName'

		self.advance()
		return tok
	end 'readEnumCaseNameToken'

	// Parse an INTEGER raw value (`= 200`, `= -1`) — the same literal reading `parseRangeBound` does,
	// minus the type-qualified bounds a raw value cannot be. A string/identifier/struct raw value is
	// a backing this rung does not have, named rather than silently mapped onto the int path.
	function readEnumIntRawValue() returns ParsedInt throws ParseError
		if self.at(TokenKind.minus) 'negative'
			try self.consume(TokenKind.minus)
			let tok = try self.consume(TokenKind.intLiteral)
			return try self.intLiteralValue(tok, negated: true)
		end 'negative'

		if self.at(TokenKind.intLiteral) 'literal'
			let tok = try self.consume(TokenKind.intLiteral)
			return try self.intLiteralValue(tok, negated: false)
		end 'literal'

		let tok = self.current()
		throw ParseError.unsupported("a raw value of kind '{tok.kind.rawValue}' (only integer and float raw values are parsed; string, char, struct and function backings arrive with later rungs)", line: tok.line, column: tok.column)
	end 'readEnumIntRawValue'

	// Fix the backing to INTEGER, or raise E3032 if a FLOAT backing was already fixed. `caseTok`
	// positions the diagnostic — the bootstrap anchors a mismatch at the offending case.
	function requireIntBacking(state EnumBackingState, caseTok Token) throws ParseError
		if state.backingResolved and state.backingIsFloat 'mismatch'
			throw ParseError.enumRawValueTypeMismatch("expected float, got int", line: caseTok.line, column: caseTok.column)
		end 'mismatch'
		state.backingResolved = true
		state.backingIsFloat = false
	end 'requireIntBacking'

	// Fix the backing to FLOAT, or raise E3032 if an INTEGER backing was already fixed. The exact
	// `expected int, got float` phrasing is the bootstrap's, gated by `error.raw-value-type-mismatch`.
	function requireFloatBacking(state EnumBackingState, caseTok Token) throws ParseError
		if state.backingResolved and not state.backingIsFloat 'mismatch'
			throw ParseError.enumRawValueTypeMismatch("expected int, got float", line: caseTok.line, column: caseTok.column)
		end 'mismatch'
		state.backingResolved = true
		state.backingIsFloat = true
	end 'requireFloatBacking'

	// Append a case after checking E3031 (duplicate raw value) — a linear scan of the tags recorded
	// so far, positioned at the offending case. `rawDisplay` is how the value is written (the int, or
	// the float's source text), which is what the message prints.
	function appendEnumCase(layout EnumLayout, caseName ByteArray, tag ParsedInt, rawDisplay String, caseTok Token) throws ParseError
		for i in 0 upto layout.caseCount() 'eachExisting'
			if layout.tagOfIndex(i) == tag 'duplicateRawValue'
				throw ParseError.enumDuplicateRawValue(rawDisplay, line: caseTok.line, column: caseTok.column)
			end 'duplicateRawValue'
		end 'eachExisting'
		layout.addCase(caseName, tag: tag)
	end 'appendEnumCase'

	// One member of a type body that is not a field: `[export] [static] function …`.
	//
	// ⭐ **`static` IS THE WHOLE DIFFERENCE, AND IT IS ONE BOOLEAN.** A `static function create()`
	// is a free function with a qualified name; a `function area()` is the same thing plus a
	// RECEIVER — `__self` at parameter 0, and every field of the enclosing type bound by name so a
	// bare `width` inside it means `self.width`. Both are built by the same `parseFunction`,
	// because a method IS a function: there is no method table and nothing for a call to dispatch
	// through. `enclosingType` supplies the qualification and is already set.
	//
	// The receiver is passed down as a flag and NOT recorded as one: `parseFunction` turns it into
	// a parameter named `SelfParamName` at position 0, and every later reader asks
	// `signatureTakesReceiver`, which reads that name back. See there — one fact, one home.
	function parseTypeMember() throws ParseError
		var visibility = Visibility.file
		if self.at(TokenKind.export) 'exported'
			self.advance()
			visibility = Visibility.module
		end 'exported'

		let isStatic = self.at(TokenKind.static)
		if isStatic 'staticMember'
			self.advance()
		end 'staticMember'

		if not self.at(TokenKind.function) 'notFunction'
			let tok = self.current()
			throw ParseError.unexpectedToken(TokenKind.function.rawValue, got: tok.kind.rawValue, line: tok.line, column: tok.column)
		end 'notFunction'

		try self.parseFunction(visibility, takesReceiver: not isStatic)
	end 'parseTypeMember'

	// Parse a function: `[static] function <name>(<params>) [returns <Type>] <body> end
	// [label]`. M5 adds parameters (`name type`, comma-separated); there is still no
	// `main` qualification (single-file build), so the declared name is used verbatim
	// for registry keys — `main` stays `main`. P1.0r adds the ONE qualification there is:
	// a function declared inside a `type` body is `Point.create` (`declaredMethodName`).
	//
	// `takesReceiver` is set only by `parseTypeMember`, for a member with no `static`. It adds ONE
	// thing — a leading parameter — and everything else about an instance method follows from
	// that, through machinery that already existed: the call is an ordinary direct call, the
	// receiver is an ordinary argument, `slotCallArgs` slots it at position 0 because it is
	// positional, and the register ABI hands it to the callee in argument register 0.
	function parseFunction(visibility Visibility, takesReceiver bool) throws ParseError
		try self.consume(TokenKind.function)
		let nameTok = try self.consume(TokenKind.identifier)
		// The BARE name only — a method's `Type.` qualification is applied below by
		// `declaredMethodName`, so `Point.create` is checked as `create` and the reserved test never
		// sees the type prefix (`Self` is fine; a `__method` name is not).
		try self.requireUnreservedName(nameTok)
		// `Point.create` inside `type Point`, the bare token at file scope. The SAME derivation the
		// declaration sweep records the signature under, so the key an `IrFunction` carries and the
		// key `mintCallResult` types a call from are one name.
		let name = self.declaredMethodName(nameTok)

		// Parameters are parsed into parallel name/type lists BEFORE the scope reset:
		// binding them needs the fresh per-function scope + value numbering, which is
		// re-seeded at the resulting paramCount just below. Parsing itself only
		// consumes tokens, so it needs no scope.
		var paramNames = ByteArrayArray.create()
		var paramTypes = MaxonTypeArray.create()
		// Parallel to `paramNames`: each parameter's name-token span, so `bindParameters` can
		// record a ValueOrigin at the DECLARATION for parameter `i` — the source site the
		// E5001 diagnostic points at when a parameter is in a register-pressure blocking set.
		var paramRanges = SourceRangeArray.create()

		// ⭐ **THE RECEIVER IS AN ORDINARY PARAMETER, PUSHED FIRST.** That is the entire mechanism:
		// it occupies position 0, so it is ValueId 0 by the same Std-ABI seeding every parameter
		// gets, and no part of the call path, the lowering or the backend learns that methods
		// exist. It is pushed BEFORE `parseFunctionParameters` so the user's own parameters land
		// after it — which also means the `MaxRegisterParams` cap that routine enforces counts the
		// receiver, correctly: a 6-argument register ABI passes the receiver in one of the six.
		//
		// It is typed `structRef(enclosingType)` — the same `Self` means here, through the same
		// routine that resolves the `Self` keyword, so a receiver and a `returns Self` cannot come
		// to disagree about which type encloses them.
		//
		// Its span is the METHOD NAME, because no source token declares it. That is the choice
		// `closeFunctionBody` makes for its synthetic `retVoid` and for E3013, and for the same
		// reason: the name is where a reader looks when something about the function's own shape is
		// at fault.
		if takesReceiver 'receiverParam'
			paramNames.push(SelfParamName)
			paramTypes.push(try self.enclosingStructType(nameTok))
			paramRanges.push(SourceRange.ofToken(nameTok))
		end 'receiverParam'

		try self.consume(TokenKind.leftParen)
		try self.parseFunctionParameters(paramNames, paramTypes: paramTypes, paramRanges: paramRanges)
		try self.consume(TokenKind.rightParen)

		let returnType = try self.parseOptionalReturnType()

		// Fresh per-function value numbering, seeded at the function's paramCount so
		// parameter ids occupy 0..paramCount-1 by Std-ABI convention (a body value
		// then starts at paramCount — see IrValueId's ValueIdRef contract). The value-TYPE
		// column is seeded in lockstep, with the parameters' declared types, so
		// `valueTypes[i]` is parameter `i`'s type from the very first lookup.
		let paramCount = paramNames.count()
		self.scope.reset()
		self.valueIds = ValueIdRef.create(paramCount)
		self.mutableVars = VarInfoArray.create()
		// Re-CREATED, not cleared, exactly as every other per-function column is: a stray owned
		// binding carried across a function boundary would emit a `__mm_decref` of a value from the
		// PREVIOUS function's SSA space — a wild pointer, and one the leak gate could not even
		// report, because the count would still balance.
		self.ownedBindings = VarInfoArray.create()
		// Re-created per function for the same reason `ownedBindings` is: a stray pending temp carried
		// across a function boundary would decref a value from the PREVIOUS function's SSA space.
		self.pendingTempDrops = ValueIdArray.create()
		self.loops = LoopContextArray.create()
		self.valueTags = ValueTypeTagArray.create()
		self.valueNameIds = TypeNameIdArray.create()
		self.valueConsts = ParsedIntArray.create()
		self.valueConstKnown = BoolArray.create()
		self.valueOwnsHeap = BoolArray.create()
		for paramType in paramTypes 'seedParamTypes'
			self.recordValueType(paramType)
		end 'seedParamTypes'

		// ⭐ **THE FIELD ALIASES ARE DECLARED BEFORE THE PARAMETERS, AND THE ORDER IS THE E3006
		// CONTRACT.** Both a parameter and a body local are bound through `declareValueBinding`,
		// which refuses to displace a self-field alias — so declaring the aliases into the
		// just-`reset` scope FIRST is what puts every colliding declaration on the guarded side of
		// the collision, with its own token in hand to anchor the diagnostic on. Reversed, the
		// parameter would be in place first and the ALIAS would be the one refused, leaving the
		// error to be reported against a field declaration that is not what needs to change.
		if takesReceiver 'selfFieldAliases'
			try self.declareSelfFieldAliases(nameTok)
		end 'selfFieldAliases'

		// Bind each parameter name to its reserved ValueId (i for parameter i), so a
		// body reference resolves straight to the parameter's SSA value — the same
		// value-substitution model `let`/`var` bindings use. Parameters are immutable
		// (a reassignment is E2013); mutating a parameter needs a local shadow.
		try self.bindParameters(paramNames, paramTypes: paramTypes, paramRanges: paramRanges)

		// `self.valueTags` is handed over BY REFERENCE, already seeded with the parameter types.
		// Every `mintValue` below therefore pushes straight into the function's own type column
		// — there is no second array and no copy-back at the end of the body. It is safe because
		// `self.valueTags` is re-created (not cleared) for the next function, so nothing aliases
		// this one afterwards. See IrFunction.valueTags for what the column is FOR.
		var func = IrFunction.create(name, maxonReturnType: returnType, paramCount: paramCount, maxonParamTypes: paramTypes, valueTags: self.valueTags, returnLine: nameTok.line)
		func.namespace = self.namespace
		func.visibility = visibility
		func.sourceFilePath = self.filePath
		func.nameLine = nameTok.line
		func.nameColumn = nameTok.column

		// Create the entry block (registered in func.blockRefs) BEFORE pushing the
		// function, mirroring the backend's own function-building order. It also displaces
		// the detached placeholder `currentBlock` was created with — from here on, every op
		// the parser emits goes to a block that belongs to a real function.
		var entry = self.artifact.module.addBlockAt(func, label: b"entry", filePath: self.filePath.toString(), firstLine: nameTok.line)
		self.currentBlock = entry

		self.skipNewlines()
		// parseStatements threads a "current block" that control-flow statements can
		// move forward (an `if` leaves subsequent statements in its continuation block),
		// so the block it RETURNS — not `entry` — is the one control falls out of.
		var bodyEnd = try self.parseStatements(func, block: entry)
		try self.closeFunctionBody(func, bodyEnd: bodyEnd, nameTok: nameTok)

		try self.consume(TokenKind.end)
		self.skipOptionalLabel()

		self.artifact.module.pushFunc(func)
		self.artifact.recordFuncReturnType(name, returnType: returnType)
		self.artifact.recordFuncSignature(name, signature: FuncSignature.create(paramNames, paramTypes: paramTypes), nameLine: nameTok.line, nameColumn: nameTok.column, sourceFilePath: self.filePath)
	end 'parseFunction'

	// Close a function body. `bodyEnd` is the block its last statement left control in;
	// when that block has no terminator, control can FALL OFF THE END of the function
	// and the parser must supply what the source did not:
	//
	//   • VOID function — the implicit `return`. This is why `function doNothing()
	//     end 'doNothing'` compiles (specs/empty-block.md), and it is what every void
	//     function needs, not just an empty one: no void body writes a trailing
	//     `return`. Without it the block reaches the backend in `Terminator.unset`.
	//   • VALUE-returning function — an error: control would leave with no value to
	//     return. E3013, positioned at the function's name (specs/missing-return-error.md).
	//
	// An already-terminated `bodyEnd` covers the UNREACHABLE case for free: an `if`
	// whose branches all return leaves its continuation marked `dead`, which counts as
	// terminated — so `main` ending in a fully-returning `if`/`else` is not a missing
	// return. The synthetic `retVoid` is anchored on the function's name for the same
	// reason E3013 is: no source token spawned it, and the name is where a reader looks
	// for "what does this function return?".
	//
	// Reads the return type off `func` rather than taking it as a parameter — the same
	// place `parseReturnStatement` reads it (see there). `nameTok` still rides along: it
	// is the SPAN the synthetic `retVoid` and the E3013 are anchored on, and a span is
	// not something `IrFunction` carries.
	function closeFunctionBody(func IrFunction, bodyEnd IrBlock, nameTok Token) throws ParseError
		if bodyEnd.isTerminated() 'terminated'
			return
		end 'terminated'

		if not maxonReturnTypeIsVoid(func.maxonReturnType) 'fallsOffEnd'
			throw ParseError.missingReturn(String.from(nameTok.value), line: nameTok.line, column: nameTok.column)
		end 'fallsOffEnd'

		// ⭐ **THE IMPLICIT RETURN IS A RETURN, AND IT OWES THE SAME DROPS** — this is the THIRD
		// exit path a function has, and it was the one that leaked. `emitScopeDrops` hung only off
		// `parseReturnStatement`, so a void function that simply ENDS —
		//
		//     function helper()
		//         let p = Point.create(1, y: 2)
		//     end 'helper'
		//
		// — never dropped `p` and reported exit 101 on a perfectly valid program. It is exactly the
		// case this routine exists for: "no void body writes a trailing `return`" is the sentence
		// three lines up, and it is precisely why the drop cannot live only where `return` is
		// WRITTEN. A VALUE function cannot reach here (E3013 above), so the leak was void-only,
		// which is why no acceptance case saw it.
		//
		// `bodyEnd` IS `self.currentBlock` — `parseStatement` returns the latter and `parseStatements`
		// threads it — so the drops land in the block this terminator ends. The already-terminated
		// case returned above, so a `return` that has dropped cannot be dropped a second time here.
		self.emitScopeDrops(nameTok)
		self.artifact.emitTerminator(bodyEnd, op: MaxonOp.retVoid, range: SourceRange.ofToken(nameTok))
	end 'closeFunctionBody'

	// Parse a comma-separated parameter list `name type[, name type]*` into the
	// parallel `paramNames`/`paramTypes` lists (empty when the list is empty). Each
	// parameter is `name type` — a bare identifier followed by a type reference. A
	// `= <default>` after the type is a later milestone, so it is rejected here with
	// a positioned `unsupported` rather than silently dropped. The caller has already
	// consumed the `(` and consumes the closing `)`.
	function parseFunctionParameters(paramNames ByteArrayArray, paramTypes MaxonTypeArray, paramRanges SourceRangeArray) throws ParseError
		if self.at(TokenKind.rightParen) 'noParams'
			return
		end 'noParams'

		while true 'paramLoop'
			let nameTok = try self.consume(TokenKind.identifier)
			try self.requireUnreservedName(nameTok)
			let paramType = try self.parseTypeReference()

			if self.at(TokenKind.equals) 'hasDefault'
				let eqTok = self.current()
				throw ParseError.unsupported("a default value on parameter '{String.from(nameTok.value)}' (parameter defaults arrive at a later milestone)", line: eqTok.line, column: eqTok.column)
			end 'hasDefault'

			if byteArrayContains(paramNames, name: nameTok.value) 'duplicate'
				throw ParseError.duplicateParameter(String.from(nameTok.value), line: nameTok.line, column: nameTok.column)
			end 'duplicate'

			paramNames.push(nameTok.value)
			paramTypes.push(paramType)
			paramRanges.push(SourceRange.ofToken(nameTok))

			if paramNames.count() > MaxRegisterParams 'tooMany'
				throw ParseError.unsupported("more than {MaxRegisterParams} parameters (M5 passes arguments in registers only; stack arguments are a later milestone)", line: nameTok.line, column: nameTok.column)
			end 'tooMany'

			if not self.at(TokenKind.comma) 'endParams'
				break
			end 'endParams'
			try self.consume(TokenKind.comma)
		end 'paramLoop'
	end 'parseFunctionParameters'

	// Bind each parameter name to its reserved SSA ValueId in the fresh function
	// scope: parameter `i` is ValueId `i` (the ids 0..paramCount-1 the value
	// numbering reserved). Bound as an immutable value binding, so a body reference
	// resolves to the parameter value and a reassignment is rejected as immutable.
	//
	// A parameter of an instance method may COLLIDE with a field of the enclosing type —
	// `function bump(count Integer)` inside a `type Counter` that declares `count`. The aliases are
	// already in scope by now (see `parseFunction`), so `declareValueBinding` refuses it and this
	// is where that refusal becomes E3006, anchored on the PARAMETER's own name token, which is
	// the declaration that has to change. The bootstrap reports the identical program at the
	// identical token.
	function bindParameters(paramNames ByteArrayArray, paramTypes MaxonTypeArray, paramRanges SourceRangeArray) throws ParseError
		for i in 0 upto paramNames.count() 'eachParam'
			let paramName = try paramNames.get(i) otherwise panic("bindParameters: paramNames.get OOB at {i}")
			let paramType = try paramTypes.get(i) otherwise panic("bindParameters: paramTypes.get OOB at {i}")
			let paramRange = try paramRanges.get(i) otherwise panic("bindParameters: paramRanges.get OOB at {i}")

			// ⚠ THE LOOP-PHI TOKEN SCAN DEPENDS ON THIS BEING FALSE, AND NOTHING ELSE SAYS SO.
			//
			// `namesAssignedIn` decides which vars a loop carries a phi for by scanning TOKENS for
			// `identifier =` (`assignsAt`). That is exhaustive only while EVERY write to a mutable
			// binding wears that shape — and a `var` (mutating) PARAMETER does not: its write is
			// `mutate(p)` at the CALL SITE, with no `=` anywhere in the loop for the scan to find.
			// The loop would mint no phi for `p`, and `p` would silently RESET to its entry value
			// on every iteration. A wrong answer, and one no drift guard can catch: unlike a
			// `loopBodyEndIndex` mismatch, the loop's EXTENT would still be perfectly correct.
			//
			// **The assert is on the FLAG ACTUALLY BEING PASSED, at the site that passes it** — not
			// on the constant somewhere else. A real `var`-parameter feature is per-parameter, so it
			// replaces the right-hand side here with `paramIsVar.get(i)`; a tripwire that tested
			// `ParametersAreMutable` would simply stop being read at that moment and never fire,
			// shipping the reset it exists to stop. This one trips on any spelling, because whatever
			// is bound mutable has to come through this line.
			//
			// The other write forms are covered differently: one that IS a statement (`a.b = x`,
			// `x += 1`) has to be taught to `parseStatement`, and `assignsAt`'s comment is the
			// standing instruction to teach the scan in the same edit. A mutating parameter is the
			// case that instruction cannot reach, because it is not a statement at all.
			let paramIsMutable = ParametersAreMutable
			if paramIsMutable 'writesThisScanCannotSee'
				panic("bindParameters: parameter '{String.from(paramName)}' is being bound MUTABLE, but `namesAssignedIn` finds a loop's carried vars by scanning tokens for `identifier =` — and a `var` parameter is written by `mutate(p)` at the CALL SITE, leaving no `=` for that scan to find. The loop would mint no phi and the parameter would silently reset to its entry value every iteration. Teach `assignsAt`/`namesAssignedIn` the new write form before binding a parameter mutable.")
			end 'writesThisScanCannotSee'

			// The installed binding is discarded: only MUTABLE bindings are tracked by
			// reference (for loop phis), and a parameter is immutable.
			_ = try self.scope.declareValueBinding(paramName, varType: paramType, mutable: paramIsMutable, value: i as ValueId) otherwise throw ParseError.localShadowsSelfField(String.from(paramName), typeName: String.from(self.enclosingType), line: paramRange.line, column: paramRange.column)
			// Parameter `i` owns ValueId `i`; record its declaration span so the register-pressure
			// diagnostic can resolve the parameter to source (it is minted by no op — see
			// ParamOriginTable — so it has no `emitOp` origin).
			self.artifact.recordParamOrigin(i as ValueId, range: paramRange)
		end 'eachParam'
	end 'bindParameters'

	// `returns <Type>` or nothing (void). The return type flows to the registry
	// (for SemanticCheck) and to lowering (via the function signature).
	function parseOptionalReturnType() returns MaxonReturnType throws ParseError
		if not self.at(TokenKind.returns) 'noReturns'
			return MaxonReturnType.void
		end 'noReturns'
		try self.consume(TokenKind.returns)
		return MaxonReturnType.value(try self.parseTypeReference())
	end 'parseOptionalReturnType'

	// A type reference. M1: a bare identifier (a named type like `ExitCode`,
	// interned into the artifact's local interner) or a bare primitive keyword.
	// Ranged/generic/qualified type syntax grows at M2+.
	//
	// ⭐ **`Self` — AND THE ENCLOSING TYPE'S OWN NAME — RESOLVE TO A `structRef` HERE, SYNTACTICALLY.**
	// Every other identifier stays `named` and is resolved later, by `TypeResolution` against the
	// project registry. The asymmetry is not a shortcut, it is the only thing that WORKS:
	//
	//   • **This routine runs in BOTH passes.** The tolerant declaration sweep reads a signature
	//     through it (`recordScannedSignature`) while the whole-program index is still being BUILT,
	//     so it cannot ask "is `Point` a declared type?" — the answer depends on how far the sweep
	//     has got, which would make a declaration's recorded return type depend on its POSITION.
	//   • **`Self` needs no index.** It means the type whose body encloses it, which is a fact about
	//     the TOKENS, so both passes answer it identically and neither has to look anything up.
	//
	// So `static function create(…) returns Self` is `structRef(Point)` in the sweep and in the
	// parse, and a call's result is typed exactly (`mintCallResult` reads the sweep). That is what
	// `let p = Point.create(3, y: 4)` needs to know `p` is a Point at all.
	//
	// ⚠ **`returns Point` from OUTSIDE `type Point` is the gap, and it is LOUD.** The signature
	// resolves to `structRef` (TypeResolution) while the call site's tag comes from the sweep's
	// `named` — so `let p = make()` binds `p` as a ranged int and `p.x` reports "is not a struct".
	// A wrong REJECTION of a correct program, never a wrong answer, and the program it rejects is
	// `struct-return` — still `disabled-test:`, deferred to P1.4's ownership ruling, which is what
	// a struct crossing a call boundary needs before it can be right for any other reason.
	function parseTypeReference() returns MaxonType throws ParseError
		if self.at(TokenKind.selfType) 'selfType'
			let tok = try self.consume(TokenKind.selfType)
			return try self.enclosingStructType(tok)
		end 'selfType'

		if self.at(TokenKind.identifier) 'named'
			let tok = try self.consume(TokenKind.identifier)
			// The `String` BUILTIN — recognized SYNTACTICALLY, like `Self` below, so it needs no registry
			// and both the declaration sweep and the real parse answer it identically. It resolves to its
			// own `MaxonType.string` arm (NEVER `named`), which is what tags a `String` parameter's value
			// `string` at parse time. See `StringBuiltinName`.
			if tok.value.equals(StringBuiltinName) 'stringBuiltin'
				return MaxonType.string
			end 'stringBuiltin'
			// The type's own name inside its own body means what `Self` means. Both spellings are
			// legal Maxon and they must not resolve differently — one `structRef`, one `named` —
			// because the second would type `create`'s result as an integer and `p.x` would fail
			// against the very type that declared it.
			if self.namesEnclosingType(tok.value) 'ownName'
				return try self.enclosingStructType(tok)
			end 'ownName'
			return MaxonType.named(self.artifact.typeNames.intern(tok.value))
		end 'named'
		if self.at(TokenKind.int) 'primInt'
			try self.consume(TokenKind.int)
			return MaxonType.integer
		end 'primInt'
		if self.at(TokenKind.bool) 'primBool'
			try self.consume(TokenKind.bool)
			return MaxonType.boolean
		end 'primBool'
		if self.at(TokenKind.float) 'primFloat'
			try self.consume(TokenKind.float)
			return MaxonType.float
		end 'primFloat'
		let tok = self.current()
		throw ParseError.unexpectedToken("a type", got: tok.kind.rawValue, line: tok.line, column: tok.column)
	end 'parseTypeReference'

	// The `structRef` naming the type currently being declared, for `Self` and for its own name.
	// `anchor` is only the token a diagnostic points at.
	//
	// A `Self` at FILE SCOPE has no type to refer to. It is a positioned `unsupported` rather than a
	// panic because the source can perfectly well write one, and it is not `unexpectedToken` because
	// `Self` is a type reference — it simply names nothing here.
	function enclosingStructType(anchor Token) returns MaxonType throws ParseError
		if self.enclosingType.isEmpty() 'outsideAType'
			throw ParseError.unsupported("'{anchor.kind.rawValue}' outside a type declaration (`Self` names the type whose body encloses it, and there is none here)", line: anchor.line, column: anchor.column)
		end 'outsideAType'
		return MaxonType.structRef(self.artifact.typeNames.intern(self.enclosingType))
	end 'enclosingStructType'

	// Does `name` name the type currently being declared? False at file scope, where there is no
	// enclosing type for any name to be — which is what makes the `isEmpty` test load-bearing
	// rather than an optimization: without it a file-scope `EmptySourceText` would match nothing
	// anyway, but only by accident of no identifier being empty.
	function namesEnclosingType(name ByteArray) returns bool
		return not self.enclosingType.isEmpty() and self.enclosingType.equals(name)
	end 'namesEnclosingType'

	// Statement list until the closing `end`, emitting into `block`. Returns the block
	// the LAST statement left control in — the same `block` for straight-line code, but
	// an `if` moves control into its continuation block, so subsequent statements (and
	// the caller) must follow it. `func` is threaded so control-flow statements can
	// create successor blocks. Blank lines separate statements.
	function parseStatements(func IrFunction, block IrBlock) returns IrBlock throws ParseError
		var current = block
		while true 'stmts'
			self.skipNewlines()
			if self.at(TokenKind.end) 'endBlock'
				break
			end 'endBlock'
			if self.isEof() 'eof'
				let tok = self.current()
				throw ParseError.unexpectedEof(tok.line, column: tok.column)
			end 'eof'
			current = try self.parseStatement(func, block: current)
		end 'stmts'
		return current
	end 'parseStatements'

	// One statement. Returns the block subsequent statements continue in.
	//
	// EVERY arm returns `self.currentBlock`, not `block`, and that is the change P1.0d.2
	// forces: a short-circuit `and`/`or` anywhere inside a statement's EXPRESSION leaves
	// control in a fresh merge block, so even a "straight-line" statement — a `let`, an
	// assignment, a bare call — can move it. Returning the incoming `block` would send the
	// next statement's ops to a block control has already left, which reads as a wild
	// miscompile (ops stranded on a dead path) rather than as a parse error.
	//
	// `break`/`continue` are the two that genuinely cannot move it: neither takes an
	// expression. They still route through the same return so there is ONE rule here rather
	// than an exception to remember.
	function parseStatement(func IrFunction, block IrBlock) returns IrBlock throws ParseError
		self.currentBlock = block

		// The statement's first token — the anchor `drainPendingTemps` gives the drops it emits (no source
		// token spawns a drop). Captured before parsing advances the cursor.
		let stmtTok = self.current()

		if self.at(TokenKind.return) 'ret'
			try self.parseReturnStatement(func, block: block)
		end 'ret' else if self.at(TokenKind.let) 'letDecl'
			try self.parseBinding(func, block: block, mutable: false)
		end 'letDecl' else if self.at(TokenKind.var) 'varDecl'
			try self.parseBinding(func, block: block, mutable: true)
		end 'varDecl' else if self.at(TokenKind.if) 'ifStmt'
			return try self.parseIfStatement(func, block: block)
		end 'ifStmt' else if self.at(TokenKind.while) 'whileStmt'
			return try self.parseWhileStatement(func, block: block)
		end 'whileStmt' else if self.at(TokenKind.match) 'matchStmt'
			return try self.parseMatchStatement(func, block: block)
		end 'matchStmt' else if self.at(TokenKind.break) 'breakStmt'
			try self.parseBreakStatement(block)
		end 'breakStmt' else if self.at(TokenKind.continue) 'continueStmt'
			try self.parseContinueStatement(block)
		end 'continueStmt' else if self.assignsAt(self.pos) 'assign'
			// An identifier followed by `=` is a reassignment. The two-token lookahead
			// keeps a bare identifier from being mis-parsed as an incomplete assignment.
			// Through `assignsAt`, which is also what decides a loop's carried vars — see there.
			try self.parseAssignment(func, block: block)
		end 'assign' else if self.selfFieldAssignsAt(self.pos) 'selfFieldAssign'
			// `self.count = 5` — the explicit spelling of a self-field store. Its own predicate for
			// `fieldAssignsAt`'s reason: it assigns no BINDING, so `namesAssignedIn` must not see it.
			// (The BARE spelling, `count = 5`, matches `assignsAt` and is routed above — see there
			// for why the scan finding `count` is harmless.)
			try self.parseExplicitSelfFieldAssignment(func, block: block)
		end 'selfFieldAssign' else if self.fieldAssignsAt(self.pos) 'fieldAssign'
			// `p.x = 5` — a store THROUGH a binding rather than a rebinding of one. Its own
			// predicate, and `namesAssignedIn` reads only `assignsAt`: see `assignsAt` for why
			// widening that one instead would have minted the loop's phi for the FIELD's name.
			try self.parseFieldAssignment(func, block: block)
		end 'fieldAssign' else if self.methodCallsAt(self.pos) 'methodCallStmt'
			// `c.increment()` / `self.increment()` — a method call for its EFFECT. Void methods are
			// most of what a type declares, and this is the only position that wants no value, so
			// `resultUsed: false` is what makes them callable at all.
			_ = try self.parseMethodCall(func, resultUsed: false)
		end 'methodCallStmt' else if self.at(TokenKind.identifier) and self.peekKind() == TokenKind.leftParen 'callStmt'
			// An identifier followed by `(` is a bare-call statement — the call is evaluated for its
			// effect and its result discarded (M5). `resultUsed: false` is what makes a VOID call legal
			// HERE and nowhere else: this is the position that wants no value.
			_ = try self.parseCall(func, resultUsed: false)
		end 'callStmt' else 'unsupported'
			let tok = self.current()
			throw ParseError.unsupported("{tok.kind.rawValue} statement", line: tok.line, column: tok.column)
		end 'unsupported'

		// ⭐ **DROP THE STATEMENT'S UNCONSUMED OWNED TEMPORARIES.** `print("{x}")` created an interpolation
		// result that `print` only BORROWED; under static single-owner it is owned by this statement and
		// dies here. A binding transferred its result out already (`parseBinding` cleared it), so a `let s =
		// "{x}"` drains nothing — `s` drops at scope exit instead.
		//
		// ⚠ Guarded on the block NOT being terminated, and that is the fail-safe: `return`/`break`/`continue`
		// have already ended the block, and a `__mm_decref` emitted after a terminator would sit on a dead
		// path (a leak the gate would shout, not a wrong answer). A TERMINATING statement that creates a
		// temporary drops it BEFORE the terminator itself — `return wrap("v{x}")` builds an owned
		// interpolation as a call argument, and `parseReturnStatement` drains it ahead of the `ret` — so by
		// the time control reaches here the block is terminated and its temporaries are already gone. This
		// skip is therefore correct, not a hole: `break`/`continue` carry no expression and so no temporary.
		//
		// The `count() > 0` half is what keeps a statement that produced NO temporary — every statement in a
		// program with no interpolation — from paying anything: `drainPendingTemps` reallocates the list, so
		// calling it per statement would be one allocation on every line of the whole compiler. Almost no
		// statement enrolls a temporary, so the common path skips the call entirely.
		if not self.currentBlock.isTerminated() and self.pendingTempDrops.count() > 0 'dropTemps'
			self.drainPendingTemps(stmtTok)
		end 'dropTemps'

		return self.currentBlock
	end 'parseStatement'

	// Parse a `let`/`var` binding: `let <name> = <expr>`. M2 rejects a type
	// annotation — a `:` after the name makes the `=` consume fail with E2010
	// (`Expected '=' but got ':'`), which IS the `variables.md` type-annotation
	// contract, so no explicit `:` check is needed. The initializer's SSA value is
	// bound to the name in the scope, so a later reference resolves straight to it
	// (no slot, no load/store — see Scope.declareValueBinding). `mutable`
	// distinguishes `var` from `let`: only a `var` may be reassigned, and only a `var`
	// carries a loop-carried phi.
	//
	// The binding lands in the INNERMOST open scope frame, so a declaration inside an
	// `if`/`while` body is gone at its `end` — and may legally SHADOW an outer binding
	// of the same name while it lives (specs/block-scoping.md).
	// The binding takes the initializer's INFERRED type, not a hardcoded `integer`. That was
	// harmless while every value was an int; it is not any more — `let flag = a > b` binds a
	// `bool`, and `flag and other` short-circuits only if the parser knows so.
	function parseBinding(func IrFunction, block IrBlock, mutable bool) throws ParseError
		if mutable 'isVar'
			try self.consume(TokenKind.var)
		end 'isVar' else 'isLet'
			try self.consume(TokenKind.let)
		end 'isLet'

		let nameTok = try self.consume(TokenKind.identifier)
		try self.requireUnreservedName(nameTok)
		try self.consume(TokenKind.equals)
		let value = try self.parseExpression(func, block: block)
		// A local taking the name of a field of the enclosing type is E3006, not a shadow — see
		// `Scope.declareValueBinding`. Anchored on the LOCAL's name token: the field is fine, the
		// local is what has to be renamed.
		var binding = try self.scope.declareValueBinding(nameTok.value, varType: self.typeOf(value), mutable: mutable, value: value) otherwise throw ParseError.localShadowsSelfField(String.from(nameTok.value), typeName: String.from(self.enclosingType), line: nameTok.line, column: nameTok.column)
		if mutable 'trackVar'
			// Record `var`s in declaration order so loop headers can mint phis for every
			// mutable binding in scope (M4b on-the-fly SSA). `let`s never join — they
			// cannot be reassigned, so they carry no loop-carried phi.
			self.mutableVars.push(binding)
		end 'trackVar'

		// ⭐ **A STRUCT BINDING OWNS ITS BOX**, so it joins the list every `return` drops (see
		// `ownedBindings`). `let` and `var` alike: ownership is a property of the TYPE, not of the
		// mutability — `var p = Point.create(…)` owns exactly what a `let` one does.
		//
		// It keys on the TAG, which is the parser's one type oracle, rather than on where the value
		// came from. So a binding is owned iff it holds a struct, whatever expression produced it —
		// and there is no second question to get wrong the day a struct arrives from somewhere other
		// than a factory call.
		// A binding OWNS a drop iff its value is a FRESH owned heap allocation — a struct box (every struct
		// is heap, so the tag answers, `tagIsStructRef`) or an owned interpolation String (`valueIsOwnedHeap`
		// provenance, because the tag conflates it with a borrowed-immortal literal — see `valueOwnsHeap`).
		// `let s = "hi"` is NOT owned: a literal sets no provenance bit, so the binding is borrowed and never
		// dropped, exactly as an immortal rdata String must be. `let` and `var` alike: ownership is a
		// property of the VALUE, never the mutability.
		if tagIsStructRef(self.tagOf(value)) or self.valueIsOwnedHeap(value) 'trackOwned'
			self.ownedBindings.push(binding)
			// Ownership TRANSFERS from the statement to the binding, so the statement must no longer drop it
			// — a second drop of the box the binding now owns is a double-free. A struct box is never in the
			// pending list (only `emitStringInterp` enrolls); an owned interpolation result is, so this is
			// what moves its drop from statement-end to scope-exit.
			self.removeFromPendingTemps(value)
		end 'trackOwned'
	end 'parseBinding'

	// Open a lexical block — an `if` / `else` / `while` body. THREE things are scoped to
	// it and must be opened and closed TOGETHER: the Scope frame its declarations land
	// in, the height of the mutable-binding list, and the height of the owned-binding
	// list. A `var` that leaves scope must also leave the first, or the next merge
	// snapshot would mint a phi for a binding no source line can name; a struct binding
	// that leaves scope must leave the second, or a later `return` would emit a
	// `__mm_decref` for a name that is gone — a DOUBLE FREE if the block already
	// returned through it. Returns the mark `closeBlock` unwinds to.
	//
	// ONE mark serves both lists, and that is sound rather than a shortcut: both are
	// append-only stacks pushed at a declaration and drained here, so their heights move
	// together with the block structure. It is not one mark serving two INDICES — each
	// list is drained to its own recorded height (see `BlockMark`).
	function openBlock() returns BlockMark
		self.scope.pushScope()
		return BlockMark.create(self.mutableVars.count(), ownedCount: self.ownedBindings.count())
	end 'openBlock'

	// Close a lexical block: drop its declarations out of scope (restoring anything they
	// shadowed), its `var`s off the mutable-binding list, and its struct bindings off the
	// owned list.
	//
	// ⚠ **IT EMITS NO DROP, AND THE FAILURE THAT CAUSES IS LOUD.** A struct declared in a
	// block and not returned through — `if c 'b' let p = Point.create(1, y: 2) end 'b'` —
	// leaves scope here with its box still live, so the program LEAKS and `__mm_leak_check`
	// reports exit 101. That is a real gap and it is stated rather than papered: no case in
	// `specs-shv2/structs.md` declares a struct inside a block, so a drop emitted here would
	// be code nothing executes and nothing proves — and the failure mode of getting it wrong
	// (a decref onto a path control has already left, or a second decref of a box the
	// `return` already dropped) is a USE-AFTER-FREE, which is strictly worse than the leak
	// the gate already shouts about. Fail-safe beats untested.
	function closeBlock(mark BlockMark)
		self.scope.popScope()
		while self.mutableVars.count() > mark.mutableCount 'drainVars'
			_ = try self.mutableVars.pop() otherwise panic("closeBlock: mutableVars.pop failed above the mark {mark.mutableCount}")
		end 'drainVars'
		while self.ownedBindings.count() > mark.ownedCount 'drainOwned'
			_ = try self.ownedBindings.pop() otherwise panic("closeBlock: ownedBindings.pop failed above the mark {mark.ownedCount}")
		end 'drainOwned'
	end 'closeBlock'

	// Parse a lexical block's statements into `block`, through its closing `end [label]`.
	// The ONE place a block body is parsed, so the scope frame is opened and closed in
	// one place too: an `if` body, an `else` body and a `while` body all come through
	// here. The caller has already consumed the block's opening label.
	//
	// Returns the block the body's last statement left control in (which is `block`
	// itself only for straight-line code — a nested `if` moves control into its
	// continuation).
	function parseBlockBody(func IrFunction, block IrBlock) returns IrBlock throws ParseError
		let mark = self.openBlock()
		self.skipNewlines()
		let bodyEnd = try self.parseStatements(func, block: block)

		// Published for `parseWhileStatement`'s drift guard — the cursor is ON the `end` here,
		// which is the one place the block's closing token index is known.
		self.lastBlockBodyEnd = self.pos
		try self.consume(TokenKind.end)
		self.skipOptionalLabel()
		self.closeBlock(mark)
		return bodyEnd
	end 'parseBlockBody'

	// Parse a reassignment `<name> = <expr>` (M4b). The target must be a declared
	// `var`; a `let` target is E2013, an undeclared name is `undefinedVariable`. The
	// RHS is evaluated FIRST (so `x = x + 1` reads the old `x`), then the binding's
	// current SSA value is rebound to the result via `Scope.setValue` — the read-
	// after-write model that makes a later reference see the new value. No slot,
	// no store op: the value model is on-the-fly SSA (the reassignment is just a
	// rebinding of the variable's current ValueId, and the loop machinery inserts
	// phis where the rebinding crosses a control-flow merge).
	//
	// **THE ASSIGNED VALUE MUST AGREE WITH THE BINDING'S DECLARED TYPE, AND THAT CHECK IS WHAT
	// MAKES EVERY MERGE PHI'S TYPE TRUE.** A binding's type is fixed where it is declared
	// (`var x = 5` is an int) and `VarInfo.varType` holds it; a reassignment does not redeclare
	// it. There are therefore TWO records of a value's type — the per-VALUE column
	// (`self.valueTags`, which follows the value) and the per-BINDING one (`varType`, frozen at
	// the declaration) — and they meet in exactly one place: `mintPhiForBinding`, which stamps
	// a merge phi with the BINDING's type while the phi carries the REASSIGNED value.
	//
	// So without this check the binding type is a LIE that the phi launders into the value
	// column, and every rule downstream reads the lie and is satisfied:
	//
	//     var x = 5
	//     if c 'b'
	//         x = false        // unchecked: the binding still claims `int`
	//     end 'b'
	//     return x + 1         // the phi is tagged `integer`, so `+` sees two ints — and adds
	//                          // a bool. THE ENTIRE RUNG, defeated by one `if`.
	//
	// Checking the ASSIGNMENT — one statement — makes all three phi mint sites (if-merge, loop
	// header, loop exit) sound BY CONSTRUCTION, with no per-edge check anywhere. Deriving each
	// phi's tag from its incoming values instead cannot work: the loop-header phi is minted
	// EAGERLY, before the body that writes those values has been parsed.
	//
	// AUTHORED, not ported — like the `if <int>` rule, and for the same reason. The C# bootstrap
	// has no assignment type check at all: it accepts `var x = 5` / `x = true` outright, and
	// catches the laundered value only when it is USED, in its Maxon→Std lowering, as an
	// INTERNAL error (E9001, a .NET cast failure with a stack trace and no source position). It
	// does not consider such a program valid — it just has nowhere to say so. shv2 says so here,
	// at the statement that introduces the contradiction.
	function parseAssignment(func IrFunction, block IrBlock) throws ParseError
		let nameTok = try self.consume(TokenKind.identifier)
		try self.consume(TokenKind.equals)
		if not self.scope.contains(nameTok.value) 'undeclared'
			// Not a local. It may still name a top-level binding — a `var` (a STORE) or a `let` (an
			// error, and a DIFFERENT error from "undefined"). LOCAL FIRST, exactly as
			// `parseVariableReference` resolves a read: a local `var` shadows a top-level one, so the
			// top level is consulted only once the name has failed to resolve as a local.
			try self.parseTopLevelAssignment(func, block: block, nameTok: nameTok)
			return
		end 'undeclared'

		let binding = self.scope.getInfo(nameTok.value)

		// A bare field name inside an instance method — `count = count + 1`. It is a STORE through
		// the receiver, not a rebinding of anything, so it asks the field's mutability rather than
		// this binding's (see `parseSelfFieldAssignment`) and never reaches `setValue` below.
		if binding.isSelfField 'selfField'
			try self.parseSelfFieldAssignment(func, block: block, nameTok: nameTok, binding: binding)
			return
		end 'selfField'

		try self.requireMutableBinding(binding, nameTok: nameTok)

		let value = try self.parseExpression(func, block: block)

		let valueTag = self.tagOf(value)
		let declaredTag = maxonTypeTag(binding.varType)
		try self.requireAssignable(nameTok, value: valueTag, declared: declaredTag)

		self.scope.setValue(nameTok.value, value: value)
	end 'parseAssignment'

	// Assign to a name that is not a local: a top-level `var` (a STORE to its `.data` slot), a
	// top-level `let` (E2013 — assigning to a constant), or nothing (E2004).
	//
	// **THE `let` ARM IS WHY THE CONSTANT IS PROBED AT ALL.** Without it a top-level `let` would
	// resolve as neither a local nor a var and be reported "undefined variable: 'origin'" — naming a
	// name that IS defined, three lines up, which is a diagnostic that sends the reader looking for a
	// typo instead of at the `let` they meant to write `var`. `specs/static-variables.md`'s
	// `top-level-let-struct-reassign-error` pins the honest one (E2013).
	//
	// The type check the local path applies is applied here too, and through the same
	// `typesAgree`/`assignTypeMismatch` pair — a global is no less able to be handed a bool where it
	// declared an int, and a laundered value in a `.data` slot is exactly as wrong as one in a
	// register. The check happens BEFORE the store is emitted, so a rejected program emits no op.
	function parseTopLevelAssignment(func IrFunction, block IrBlock, nameTok Token) throws ParseError
		match self.signatures.globalDeclFor(nameTok.value, readerFilePath: self.filePath) 'global'
			found(label, tag) then try self.emitCheckedGlobalStore(func, block: block, nameTok: nameTok, label: label, tag: tag)
			notFound then try self.rejectNonGlobalAssignment(nameTok)
		end 'global'
	end 'parseTopLevelAssignment'

	// Parse the right-hand side, check it against the global's declared type, and store it.
	function emitCheckedGlobalStore(func IrFunction, block IrBlock, nameTok Token, label ByteArray, tag ValueTypeTag) throws ParseError
		let value = try self.parseExpression(func, block: block)

		try self.requireAssignable(nameTok, value: self.tagOf(value), declared: tag)

		self.emitGlobalStore(label, tag: tag, value: value, range: SourceRange.ofToken(nameTok))
	end 'emitCheckedGlobalStore'

	// **THE MUTABILITY RULE FOR A LOCAL BINDING — asked by both statements that write one**: the
	// reassignment (`x = 5`, the binding itself) and the field store (`p.x = 5`, its INSTANCE). One
	// home, because it is one rule — a binding declared `let` does not accept a write — and the
	// diagnostic names that binding and anchors on the token that names it.
	//
	// ⚠ Written down twice, a future answer to what "writable" MEANS — a captured closure variable
	// (P1.4), a moved-from binding under static ownership — taught to one site and not the other
	// would let `p.x = 5` silently compile where `p = q` correctly reports. An ACCEPTED write that
	// should have been refused is a WRONG ANSWER, not a compile error, and neither site would read
	// as wrong on its own. The bootstrap is the cautionary tale: it spells this rule at FOUR sites
	// and reads `VarInfo.Mutable` in three unrelated places.
	function requireMutableBinding(binding VarInfo, nameTok Token) throws ParseError
		if not binding.mutable 'immutable'
			throw ParseError.assignToImmutable(String.from(nameTok.value), line: nameTok.line, column: nameTok.column)
		end 'immutable'
	end 'requireMutableBinding'

	// **THE `__`-RESERVATION RULE, IN ONE PLACE.** A user may not DECLARE a name that starts with the
	// prefix Maxon reserves for compiler internals (see `ReservedNamePrefix`). Raised as E2051 at the
	// declared name — the token the user has to change.
	//
	// ⚠ It is called at EIGHT binding sites — function/method name, parameter, top-level and body
	// `let`/`var`, `type` name, struct field, `typealias` name, enum/union case — and it is ONE call
	// at each, never eight copies of `bytesStartWith(…, b"__")` + the message. That the rule reads
	// once is the whole point: eight copies is this project's signature bug, and a reservation that
	// held at seven sites and lapsed at the eighth would be a SILENT hole (a user `__`-name accepted
	// there), not a compile error — exactly the class of defect this rung exists to close.
	//
	// ⭐ It sees only USER SOURCE TOKENS, which is why it does not — and structurally CANNOT — reject
	// the compiler's own `__` functions: `__mm_alloc`, `__print_string`, `__destruct_*` are built by
	// `IrFunction.createFromStd` and never pass through the parser. That is what makes the reservation
	// safe to lean on: once no user `__` name can be declared, `MmRuntime.isCompilerInternalCallee`'s
	// "skip the user-function checks" shortcut is provably sound rather than a hopeful one.
	function requireUnreservedName(nameTok Token) throws ParseError
		if bytesStartWith(nameTok.value, prefix: ReservedNamePrefix) 'reserved'
			throw ParseError.reservedIdentifier(String.from(nameTok.value), line: nameTok.line, column: nameTok.column)
		end 'reserved'
	end 'requireUnreservedName'

	// The COERCION rule for an ASSIGNMENT — shared by the local path and the global one, which
	// were already two copies of the same three lines and would now have been two copies of the
	// same five. A global is no less able to be handed a bool where it declared an int, or a float
	// where it declared an int, than a local is; both anchor the diagnostic on the assigned NAME.
	function requireAssignable(nameTok Token, value ValueTypeTag, declared ValueTypeTag) throws ParseError
		match checkDeclaredType(value, declared: declared) 'declared'
			ok then break 'declared'
			mismatch then throw ParseError.assignTypeMismatch(String.from(nameTok.value), got: typeTagName(value), expected: typeTagName(declared), line: nameTok.line, column: nameTok.column)
			narrowsFloatToInt then throw ParseError.implicitNarrowing(typeTagName(value), targetType: typeTagName(declared), line: nameTok.line, column: nameTok.column)
		end 'declared'
	end 'requireAssignable'

	// The name is not a local and not a top-level `var`. Say which of the two remaining things it is.
	function rejectNonGlobalAssignment(nameTok Token) throws ParseError
		match self.signatures.constantValueOf(nameTok.value, readerFilePath: self.filePath) 'constant'
			found then throw ParseError.assignToImmutable(String.from(nameTok.value), line: nameTok.line, column: nameTok.column)
			notFound then throw ParseError.undefinedVariable(String.from(nameTok.value), line: nameTok.line, column: nameTok.column)
		end 'constant'
	end 'rejectNonGlobalAssignment'

	// `return [<expr>]`. Sets the block's terminator directly, emitting the distinct
	// `retVoid` variant for a void return rather than a `ret` carrying some absent-value
	// sentinel (see MaxonDialect's `retVoid`).
	//
	// WHICH variant is decided by `func`'s DECLARED return type — never by the token that
	// follows `return`. The two are not interchangeable, and the token alone is the wrong
	// question: it says what the source WROTE, not what the function PROMISED, and when
	// they differ it is the promise the whole backend was built around. Deriving the
	// answer from the token stream instead gave the compiler two sources of truth for
	// "is this function void", with nothing to make them agree — and they disagreed on
	// exactly two programs, each of which was a bug no later pass could catch:
	//
	//   • `return <expr>` in a VOID function reached the x64 tier as a value `ret`, where
	//     `emitPrimaryReturnMove` has no return register to move the value into — a
	//     compiler PANIC on a program the reference compiler accepts.
	//   • a BARE `return` in a value-returning function reached it as `retVoid`, which
	//     emits the `ret` without ever writing R8 — a SILENT MISCOMPILE handing the caller
	//     whatever the last op happened to leave in the return register.
	//
	// `func.maxonReturnType` is not a copy of the contract kept beside it: it IS the
	// field the rest of the pipeline reads — it flows to `funcReturnTypes`, through
	// lowering, and becomes the backend's `StdReturnType`. Reading it here means the
	// parser and the tier that must honour it cannot be looking at different answers.
	//
	// So the statement's shape is checked AGAINST the contract rather than used to infer
	// it, and a `return` that cannot honour it is rejected here — where a source position
	// still exists — instead of reaching a tier that can only panic or emit the wrong op.
	function parseReturnStatement(func IrFunction, block IrBlock) throws ParseError
		let retTok = try self.consume(TokenKind.return)
		let bare = self.at(TokenKind.newline) or self.at(TokenKind.end) or self.isEof()

		if maxonReturnTypeIsVoid(func.maxonReturnType) 'voidFunction'
			if not bare 'valueFromVoid'
				throw ParseError.returnValueFromVoid(String.from(func.name), line: retTok.line, column: retTok.column)
			end 'valueFromVoid'

			self.emitScopeDrops(retTok)
			self.artifact.emitTerminator(block, op: MaxonOp.retVoid, range: SourceRange.ofToken(retTok))
			return
		end 'voidFunction'

		// Value-returning: a bare `return` has nothing to return, and there is no value
		// the compiler may invent for it.
		if bare 'noValue'
			throw ParseError.returnWithoutValue(String.from(func.name), line: retTok.line, column: retTok.column)
		end 'noValue'

		// The terminator goes on the block the EXPRESSION ended in, not the one it started
		// in. `return a or b` evaluates the `or` across three blocks and leaves control in
		// the merge; terminating `block` instead would leave the merge unterminated (a
		// backend panic) and put the `ret` on a path the value it returns does not reach.
		let retVal = try self.parseExpression(func, block: block)

		// The value must satisfy what the function PROMISED — `checkDeclaredType`, the same
		// COERCION-SITE rule the call arguments and the assignments ask, and deliberately not the
		// symmetric `typesAgree` an operator's two operands ask. `return flag` from a function
		// declared `returns Integer` is the argument-position bug in reverse: the bool's 1 payload
		// would be handed back through the return register as the integer 1. And `return 3.7` from
		// one is the LOSSY half — the classes agree, so only a one-sided rule can see it.
		//
		// The declared type here is the RAW parse-time one (a `named` alias, not yet resolved),
		// which is exactly what `typeClassOf` is built to take — every alias shv2 can declare is
		// a ranged int, and `typeTagName` prints the resolved primitive the bootstrap prints.
		let retTag = self.tagOf(retVal)
		let declaredTag = maxonReturnTypeTag(func.maxonReturnType)
		match checkDeclaredType(retTag, declared: declaredTag) 'declared'
			ok then break 'declared'
			mismatch then throw ParseError.returnTypeMismatch(typeTagName(retTag), expected: typeTagName(declaredTag), line: retTok.line, column: retTok.column)
			narrowsFloatToInt then throw ParseError.implicitNarrowing(typeTagName(retTag), targetType: typeTagName(declaredTag), line: retTok.line, column: retTok.column)
		end 'declared'

		// ⭐ **A `returns String` FUNCTION HANDS BACK A UNIFORMLY OWNED HEAP String**, and the caller
		// drops that result unconditionally (`mintOwnedCallResult`). So the callee must return
		// something OWNED and must not drop it — two adjustments, in this order, BEFORE the scope drops:
		//
		//   • PROMOTE a borrowed return. `return "hi"` is an immortal rdata literal (capacity == -2),
		//     not owned heap; handed back as-is, the caller would `__mm_decref` read-only data. Copying
		//     its bytes into a fresh owned record — the same single-`__mm_alloc` fused-record path an
		//     interpolation builds, with the source as its one part — gives the caller a box it may
		//     safely drop. `return "{x}"` and `return t` are already owned, so they pass through here.
		//   • MOVE the owned return OUT of both drop sets. It belongs to the caller now: out of
		//     `ownedBindings` so `emitScopeDrops` does not double-free `return t`, and out of
		//     `pendingTempDrops` so the interp/promoted temporary is not dropped on the dead path the
		//     `ret` leaves behind.
		var returned = retVal
		if tagIsText(retTag) and not self.valueIsOwnedHeap(returned) 'promoteBorrowed'
			returned = self.promoteToOwnedString(returned, range: SourceRange.ofToken(retTok))
		end 'promoteBorrowed'

		if self.valueIsOwnedHeap(returned) 'moveOut'
			self.removeFromOwnedBindings(returned)
			self.removeFromPendingTemps(returned)
		end 'moveOut'

		// ⭐⭐ **THE DROP GOES HERE — AFTER THE VALUE, BEFORE THE TERMINATOR — AND BOTH HALVES OF
		// THAT ARE LOAD-BEARING.**
		//
		//   • AFTER the value, because `return p.x + p.y` READS the box. Dropping `p` first would
		//     free the very memory the two `loadIndirect`s are about to read: the answer would be 7
		//     today (a bump allocator reclaims nothing, so the bytes survive) and garbage the moment
		//     P1.2 gives `__mm_free` a free list to return the slot to. A use-after-free that passes
		//     its test is the worst outcome available here, so the ordering is not left to luck.
		//   • BEFORE the terminator, because a `ret` ENDS the block. Anything emitted after it sits
		//     on a path control has already left, and the box would leak — exit 101.
		//
		// `returned` is already computed, so it is a value in a register and no longer a read of the
		// box. That is what makes the window between the two lines safe.
		//
		// ⚠ **AN OWNED String RETURN HAS ALREADY LEFT THIS DROP SET (moved out above), which is what
		// makes the caller its sole owner.** A returned STRUCT is the one owned value the move-out does
		// NOT yet cover, and it cannot arise at this rung: the only struct-returning function is a
		// factory, whose `return Self{…}` returns a TEMPORARY bound to no name and so in no scope
		// (`emitStructLiteral` mints a value, not a binding). The day a struct is returned through a
		// BINDING (`struct-return`, still `disabled-test:`, P1.4), the move-out above must also ask
		// `tagIsStructRef` — today it asks only `valueIsOwnedHeap`, which a struct box never sets.
		//
		// TWO drop sets empty here, both before the `ret` and both with the returned value already moved
		// out: the owned TEMPORARIES this return's expression created but does NOT hand back, and the
		// owned BINDINGS in scope. The temporary case is `return wrap("v{x}")` — the interpolation is
		// built here, handed to `wrap` (which BORROWS it), and belongs to this statement, which owns and
		// drops it exactly as `print("{x}")` does. `parseStatement`'s statement-end drain cannot: a `ret`
		// has terminated the block, so it sees the termination and skips, and the drop has to land here
		// instead. The `count() > 0` guard is that drain's own — `drainPendingTemps` reallocates the list
		// and almost no return leaves a temporary, so the common return pays nothing. Temporaries drop
		// before bindings: the return expression's temporaries are the last owned values built.
		if self.pendingTempDrops.count() > 0 'dropReturnTemps'
			self.drainPendingTemps(retTok)
		end 'dropReturnTemps'

		self.emitScopeDrops(retTok)
		self.artifact.emitTerminator(self.currentBlock, op: MaxonOp.ret(returned), range: SourceRange.ofToken(retTok))
	end 'parseReturnStatement'

	// Emit a `__mm_decref` for every struct binding in scope, in REVERSE declaration order.
	//
	// Reverse, because that is the order ownership is conventionally released in — the last thing
	// built is the first torn down — and because a later binding may (once struct fields land) hold
	// a reference INTO an earlier one, so releasing the outer first would be releasing the thing
	// still being pointed at. Nothing at this rung can tell the two orders apart; the convention
	// costs nothing and is the one that stays right.
	//
	// `anchor` is the `return` token: no source token spawns a drop, and the statement that made
	// control leave the scope is where a reader looks for what happened to the values in it.
	function emitScopeDrops(anchor Token)
		var i = self.ownedBindings.count()
		while i > 0 'eachOwned'
			i = i - 1
			let binding = try self.ownedBindings.get(i) otherwise panic("emitScopeDrops: ownedBindings.get OOB at {i} — the list is only appended to and drained at a block's end")
			self.emitDecref(binding.boundValue, range: SourceRange.ofToken(anchor))
		end 'eachOwned'
	end 'emitScopeDrops'

	// Emit a single `__mm_decref` — the one shape a dropped owned heap value releases through, shared by
	// every drop site: `emitScopeDrops` (a binding at scope exit), `drainPendingTemps` (an unconsumed
	// temporary at statement end), and `emitStringInterp` (its consumed scratch buffers). One door, so the
	// decref's op shape lives in ONE place and cannot drift across the three callers. The result is `void`
	// because `__mm_decref` returns nothing — the tag `ValueTypeTag.void` exists for exactly this, a
	// ValueId the op shape demands and no rule may ever be asked about.
	function emitDecref(value ValueId, range SourceRange)
		_ = self.emitRuntimeCall(MmDecrefName, args: singletonArgs(value), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
	end 'emitDecref'

	// ⭐ **CALL AN EMITTED RUNTIME ENTRY POINT** (`__mm_alloc`, `__mm_decref`) — the door the parser
	// reaches the heap through, and the only one.
	//
	// It is NOT `emitCall`, and the difference is what a runtime call IS: `emitCall` types its
	// result from the whole-program signature index and slots its arguments against a declaration.
	// The runtime has neither — it is built at the STD tier, after lowering (`installMmRuntime`),
	// so no file declares it, `mintCallResult` would type it `unresolved` (a tag that PANICS at
	// lowering), and `SemanticCheck` would report E3004 against a name the user never wrote.
	// `isRuntimeCallee` is what tells the two apart, and it is one predicate read by the three
	// places that care (here, `validateCall`, `lowerCall`).
	//
	// So the caller states the result's type, because the caller is the compiler and it KNOWS: an
	// `__mm_alloc` returns the struct it just built, a `__mm_decref` returns nothing.
	//
	// ⚠ **EVERY ARGUMENT IS POSITIONAL, IN DECLARATION ORDER.** There is no label to reorder by —
	// the runtime has no parameter names for a label to match — so `lowerCall` passes them straight
	// through. `emptyArgLabels` is what says so on the op, and `lowerCall`'s guard is what makes a
	// future labelled runtime call fail loudly rather than mis-slot.
	function emitRuntimeCall(callee ByteArray, args ValueIdArray, resultTag ValueTypeTag, resultNameId TypeNameId, range SourceRange) returns ValueId
		let result = self.mintValue(resultTag, nameId: resultNameId)
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.call(result, callee: callee, args: args, argLabels: emptyArgLabels(args), argRanges: uniformArgRanges(args, range: range)), range: range)
		return result
	end 'emitRuntimeCall'

	// ⭐ **TRACK A FRESH OWNED HEAP TEMPORARY.** The one door `emitStringInterp` reaches ownership through:
	// it records the value's provenance (so `parseBinding` knows the binding owns a drop) AND enrolls it in
	// the statement's pending-drop list (so an UNBOUND result is dropped at statement end). Both from one
	// call, so the two facts — "this value owns heap" and "someone must drop it" — cannot be set apart.
	function trackOwnedTemp(value ValueId)
		try self.valueOwnsHeap.set(value, value: true) otherwise panic("trackOwnedTemp: v{value} has no owned-heap slot — every SSA value must be minted through mintValue, which seeds the column")
		self.pendingTempDrops.push(value)
	end 'trackOwnedTemp'

	// Does `value` own a droppable heap allocation? Read by `parseBinding` (the String half of "is this
	// binding owned?") and by the reassignment/return paths as they arrive. It is provenance, NOT the type
	// tag — see `valueOwnsHeap`'s header for why the tag cannot answer. An O(1) column read, seeded `false`
	// for every minted value and set `true` by `trackOwnedTemp`.
	function valueIsOwnedHeap(value ValueId) returns bool
		return try self.valueOwnsHeap.get(value) otherwise panic("valueIsOwnedHeap: v{value} has no owned-heap slot — every SSA value must be minted through mintValue, which seeds the column")
	end 'valueIsOwnedHeap'

	// Ownership of `value` has been TRANSFERRED to a binding, so the statement no longer owes its drop:
	// remove it from the pending list. A filter-rebuild rather than a pop because, while the transferred
	// value is normally the last one pushed (a binding's initializer is the statement's final expression),
	// keying on identity rather than position is what stays correct if that ever stops holding.
	function removeFromPendingTemps(value ValueId)
		var kept = ValueIdArray.create()
		for pending in self.pendingTempDrops 'each'
			if pending != value 'notTransferred'
				kept.push(pending)
			end 'notTransferred'
		end 'each'
		self.pendingTempDrops = kept
	end 'removeFromPendingTemps'

	// The value a binding holds has been MOVED OUT — a `return` hands its box to the caller — so the
	// binding must leave `ownedBindings`, else `emitScopeDrops` would decref a box the callee no longer
	// owns (a double-free with the caller's own drop). Keyed on the bound VALUE rather than on position:
	// a returned binding is rarely the last declared, so identity is what stays correct. A filter-rebuild,
	// the `removeFromPendingTemps` shape for the owned-BINDING list.
	function removeFromOwnedBindings(value ValueId)
		var kept = VarInfoArray.create()
		for binding in self.ownedBindings 'each'
			if binding.boundValue != value 'notMovedOut'
				kept.push(binding)
			end 'notMovedOut'
		end 'each'
		self.ownedBindings = kept
	end 'removeFromOwnedBindings'

	// ⭐ **PROMOTE A BORROWED String TO AN OWNED HEAP COPY** so a `returns String` function ALWAYS hands
	// back something owned. `return "hi"` yields an immortal rdata literal (capacity == -2), and a
	// `returns String` caller drops its result unconditionally — decref'ing read-only data. Copying the
	// source bytes into a fresh fused record — the SAME single-`__mm_alloc` path an interpolation builds,
	// with the source as its one part (`__str_copy` blits `buffer@0`/`length@8`) — yields an owned
	// temporary the caller can safely drop. `emitStringInterp` marks it owned (`trackOwnedTemp`); the
	// return's move-out then takes it out of the pending list. NO second record layout is hand-rolled.
	function promoteToOwnedString(source ValueId, range SourceRange) returns ValueId
		var partBufs = ValueIdArray.create()
		var partLens = ValueIdArray.create()
		var scratchIds = ValueIdArray.create()
		self.materializeStringRecordPart(source, partBufs: partBufs, partLens: partLens, range: range)
		return self.emitStringInterp(partBufs, partLens: partLens, scratchIds: scratchIds, range: range)
	end 'promoteToOwnedString'

	// ⭐ **DROP EVERY OWNED TEMPORARY THE STATEMENT LEFT UNCONSUMED**, in REVERSE creation order (the
	// `emitScopeDrops` convention — the last built is the first torn down), into `currentBlock`. Called at
	// the end of a statement, so the drop lands exactly where control is when the statement finishes: a loop
	// body, an `if` branch, a short-circuit merge. Clears the list — a temporary belongs to ONE statement.
	//
	// `anchor` is the statement's own token; no source token spawns a drop, so it rides the statement that
	// made control leave the temporary's lifetime, exactly as `emitScopeDrops` rides the `return`.
	function drainPendingTemps(anchor Token)
		var i = self.pendingTempDrops.count()
		while i > 0 'eachTemp'
			i = i - 1
			let temp = try self.pendingTempDrops.get(i) otherwise panic("drainPendingTemps: pendingTempDrops.get OOB at {i} — the list is only appended to and drained here")
			self.emitDecref(temp, range: SourceRange.ofToken(anchor))
		end 'eachTemp'
		self.pendingTempDrops = ValueIdArray.create()
	end 'drainPendingTemps'

	// Parse an `if` statement (M4):
	//   if <cond> 'thenLabel'
	//       <then-stmts>
	//   end 'thenLabel' [ else 'elseLabel' <else-stmts> end 'elseLabel'
	//                   | else if <cond> …  (the else branch is itself a nested `if`) ]
	//
	// Lowering shape: the entry block (`block`) evaluates `cond` (a comparison, whose
	// value the Std→x64 pass fuses with the branch) and gets a `condBranch` terminator
	// selecting the then block vs the false target (the else block, or the continuation
	// when there is no else). A branch that returns terminates itself; one that falls
	// through gets a `branch` to the continuation. Blocks are created then→else→
	// continuation so `.text` lays them out in source order.
	//
	// Returns the CONTINUATION — where control resumes after the `if`. It is either
	// reachable (Terminator.unset, so subsequent statements emit into it — e.g. the
	// `return 0` after a simple `if`) or, when both branches return, unreachable
	// (Terminator.dead — emits no code, but is still returned so the caller always has
	// a block to continue in).
	//
	// M4b VALUE MERGE: because a `var` may be reassigned inside a branch, the value of
	// a variable at the continuation depends on which path ran. The parser snapshots
	// each carried var's value entering the branches, RESTORES it before the else/false
	// path (so that path resumes from the pre-`if` state), and at the continuation
	// merges the two incoming snapshots — a variable that differs across the paths gets
	// a continuation PHI (the same block-arg mechanism loops use), everything else keeps
	// its common value. Without this, a `var` written only on the taken path would leak
	// its then-value onto the not-taken path (a real miscompile).
	//
	// THE CARRIED SET IS THE VARS THE STATEMENT ASSIGNS, decided from the tokens before
	// anything is emitted (`assignedBindingsIn` over the whole if's extent) — a SUBSET of
	// `mutableVars`, in that list's declaration order. A var no branch assigns holds one
	// value on entry, then-exit AND else-exit, so it can never differ at the merge: it
	// needs neither a phi nor a snapshot slot, and is left out of all three. This is the
	// exact analogue of `parseWhileStatement`'s carried set, and it replaces snapshotting
	// the WHOLE mutable-var set at every branch — which was O(vars in scope) per `if`, and
	// with the scope-filler count doubling on the scale corpus made `phase:parse` BYTES
	// bend quadratically while its ALLOCATIONS stayed linear (bigger snapshots, not more).
	//
	// Each branch body is a lexical BLOCK (parseBlockBody), so the three snapshots are
	// all taken at the SAME scope depth — a `var` declared inside a branch has left
	// `mutableVars` by the time that branch's exit values are read, and is skipped by
	// `assignedBindingsIn` (not bound at entry), which keeps `entryVals` / `thenVals` /
	// `elseVals` positionally aligned with `assignedBindings`.
	function parseIfStatement(func IrFunction, block IrBlock) returns IrBlock throws ParseError
		let ifIndex = self.pos
		let ifTok = try self.consume(TokenKind.if)

		// The carried bindings — read off the tokens covering the WHOLE statement (then plus
		// every `else`/`else if` branch, through the final `end`), before a single op is
		// emitted. Every snapshot below is positional over THIS list, so the per-branch cost
		// is O(assigned), not O(vars in scope). `ifEnd` also feeds the drift guard.
		let ifEnd = self.blockStatementEndIndex(ifIndex, continuesAtElse: true)
		let assignedBindings = self.assignedBindingsIn(ifIndex, endIndex: ifEnd)

		let cond = try self.parseBoolCondition(func, block: block, kwTok: ifTok)
		// The condition's own blocks: a short-circuit `and`/`or` in it (`if a() and b()`)
		// has already branched, and control now sits in ITS merge block. That — not the
		// block the `if` started in — is where the two-way branch belongs, and it is the
		// `if`'s true entry for every purpose below.
		var entry = self.currentBlock
		let thenLabel = try self.consume(TokenKind.charLiteral)

		// Values entering the branches (the condition only reads, so `entry`'s values
		// are unchanged by it). Positional over `assignedBindings`.
		let entryVals = self.snapshotBindings(assignedBindings)

		// `var` because these blocks are passed to functions that mutate them (the
		// statement parser fills the block; the finalizers wire its terminator) — a
		// `let` binding cannot be forwarded to a mutating parameter (E3019).
		var thenBlock = self.newBlock(func, label: thenLabel.value, line: thenLabel.line)
		var thenEnd = try self.parseBlockBody(func, block: thenBlock)

		// Snapshot the then-branch's exit values, then rewind to the entry state so the
		// else/false path is parsed against the pre-`if` values, not the then-branch's.
		let thenVals = self.snapshotBindings(assignedBindings)
		self.restoreBindings(assignedBindings, snapshot: entryVals)

		if not self.at(TokenKind.else) 'noElse'
			let cont = self.finalizeIfNoElse(func, entry: entry, cond: cond, ifTok: ifTok, thenBlock: thenBlock, thenEnd: thenEnd, bindings: assignedBindings, entryVals: entryVals, thenVals: thenVals)
			self.assertScanAligned("parseIfStatement", predictedEnd: ifEnd)
			return cont
		end 'noElse'

		try self.consume(TokenKind.else)
		var elseBlock = self.newBlock(func, label: b"ifelse", line: ifTok.line)
		var elseEnd = try self.parseElseBody(func, elseBlock: elseBlock)
		let elseVals = self.snapshotBindings(assignedBindings)
		let cont = self.finalizeIfElse(func, entry: entry, cond: cond, ifTok: ifTok, thenBlock: thenBlock, thenEnd: thenEnd, elseBlock: elseBlock, elseEnd: elseEnd, bindings: assignedBindings, thenVals: thenVals, elseVals: elseVals)
		self.assertScanAligned("parseIfStatement", predictedEnd: ifEnd)
		return cont
	end 'parseIfStatement'

	// Parse an `else` body into `elseBlock`: either a nested `if` (the `else if …`
	// chain — the else branch IS a nested if statement, so `elseBlock` becomes that
	// if's entry) or a plain labelled `else` block. Returns the block the else branch
	// left control in (its own continuation for a nested if; the block its last
	// statement filled for a plain else).
	//
	// The `else if` form opens NO scope frame of its own: its condition is evaluated in
	// the ENCLOSING scope (it is not inside any block), and each of the nested if's own
	// branches opens a frame when it is parsed. Only the plain `else 'label'` form is a
	// block body.
	function parseElseBody(func IrFunction, elseBlock IrBlock) returns IrBlock throws ParseError
		if self.at(TokenKind.if) 'elseIf'
			return try self.parseIfStatement(func, block: elseBlock)
		end 'elseIf'

		try self.consume(TokenKind.charLiteral)
		return try self.parseBlockBody(func, block: elseBlock)
	end 'parseElseBody'

	// Finalize an `if` with no `else`: the false path flows straight to the
	// continuation, so the continuation is always reachable. Wire the entry's
	// condBranch (then vs continuation). When the then branch falls through, the
	// continuation merges the false-edge values (`entryVals`) with the then-branch's
	// exit values (`thenVals`) — a differing var gets a continuation phi. When the then
	// branch returns, the continuation is reached only from the false edge, whose values
	// are already the restored `entryVals`.
	function finalizeIfNoElse(func IrFunction, entry IrBlock, cond ValueId, ifTok Token, thenBlock IrBlock, thenEnd IrBlock, bindings VarInfoArray, entryVals ValueIdArray, thenVals ValueIdArray) returns IrBlock
		var cont = self.newBlock(func, label: b"ifcont", line: ifTok.line)
		self.emitCondBranch(entry, cond: cond, thenId: thenBlock.id, elseId: cont.id, ifTok: ifTok)
		if not thenEnd.isTerminated() 'thenFallsThrough'
			self.mergeAtContinuation(entry, predB: thenEnd, cont: cont, bindings: bindings, valsA: entryVals, valsB: thenVals)
			self.emitBranch(thenEnd, targetId: cont.id)
		end 'thenFallsThrough'
		return cont
	end 'finalizeIfNoElse'

	// Finalize an `if`/`else`: the entry's condBranch targets the then and else blocks.
	// The continuation is reachable only when a branch falls through; when BOTH return
	// it is unreachable and marked `dead`. When BOTH fall through, the continuation
	// merges their exit values (`thenVals`/`elseVals`) with phis for the vars that
	// differ. When only ONE falls through, the continuation simply carries that branch's
	// values (no phi — a single predecessor).
	function finalizeIfElse(func IrFunction, entry IrBlock, cond ValueId, ifTok Token, thenBlock IrBlock, thenEnd IrBlock, elseBlock IrBlock, elseEnd IrBlock, bindings VarInfoArray, thenVals ValueIdArray, elseVals ValueIdArray) returns IrBlock
		self.emitCondBranch(entry, cond: cond, thenId: thenBlock.id, elseId: elseBlock.id, ifTok: ifTok)
		let thenTerminated = thenEnd.isTerminated()
		let elseTerminated = elseEnd.isTerminated()

		if thenTerminated and elseTerminated 'bothReturn'
			// Nothing reaches the continuation — mark it dead rather than leave it
			// unterminated (assertAllBlocksTerminated forbids an unset block).
			var cont = self.newBlock(func, label: b"ifcont", line: ifTok.line)
			cont.terminator = Terminator.dead
			return cont
		end 'bothReturn'

		var cont = self.newBlock(func, label: b"ifcont", line: ifTok.line)
		if not thenTerminated and not elseTerminated 'bothFallThrough'
			self.mergeAtContinuation(thenEnd, predB: elseEnd, cont: cont, bindings: bindings, valsA: thenVals, valsB: elseVals)
			self.emitBranch(thenEnd, targetId: cont.id)
			self.emitBranch(elseEnd, targetId: cont.id)
		end 'bothFallThrough' else if not thenTerminated 'onlyThen'
			// Only the then branch reaches the continuation — its values carry through.
			self.restoreBindings(bindings, snapshot: thenVals)
			self.emitBranch(thenEnd, targetId: cont.id)
		end 'onlyThen' else 'onlyElse'
			// Only the else branch reaches the continuation (its values are already the
			// current bindings after parsing it, but restore explicitly for symmetry).
			self.restoreBindings(bindings, snapshot: elseVals)
			self.emitBranch(elseEnd, targetId: cont.id)
		end 'onlyElse'
		return cont
	end 'finalizeIfElse'

	// Merge two incoming value snapshots at a continuation block. A carried binding whose
	// value differs across the paths gets a continuation PHI (a block-arg) and each
	// predecessor records the value it carries on its edge; a binding with the same value
	// on both paths keeps that value with no phi. Each merged binding's current value is
	// set to the phi (or the common value) so code after the `if` reads the merged value.
	//
	// `bindings` is the statement's carried set (`assignedBindings`) in `mutableVars`
	// declaration order, and both snapshots are positional over it. Phis are therefore
	// minted in that same order — which is what makes the emitted code identical to the
	// old whole-`mutableVars` merge: a var no branch assigned had a == b there and got no
	// phi, so leaving it out of `bindings` changes no decision, only the work done to
	// reach it. Both snapshots and `bindings` are the SAME length (asserted): every branch
	// body is a lexical block, so a `var` declared inside one is off `mutableVars` — and so
	// never entered `bindings` — before its exit values are snapshotted.
	function mergeAtContinuation(predA IrBlock, predB IrBlock, cont IrBlock, bindings VarInfoArray, valsA ValueIdArray, valsB ValueIdArray)
		self.assertSnapshotAligned(bindings, snapshot: valsA, site: "mergeAtContinuation/valsA")
		self.assertSnapshotAligned(bindings, snapshot: valsB, site: "mergeAtContinuation/valsB")

		var edgeArgsA = ValueIdArray.create()
		var edgeArgsB = ValueIdArray.create()
		for k in 0 upto bindings.count() 'eachVar'
			var binding = try bindings.get(k) otherwise panic("mergeAtContinuation: bindings.get OOB at {k}")
			let a = try valsA.get(k) otherwise panic("mergeAtContinuation: valsA.get OOB at {k}")
			let b = try valsB.get(k) otherwise panic("mergeAtContinuation: valsB.get OOB at {k}")
			if a == b 'same'
				binding.boundValue = a
			end 'same' else 'differ'
				let phiId = self.mintPhiForBinding(cont, binding: binding)
				binding.boundValue = phiId
				edgeArgsA.push(a)
				edgeArgsB.push(b)
			end 'differ'
		end 'eachVar'
		self.recordBranchEdge(predA, targetId: cont.id, argIds: edgeArgsA)
		self.recordBranchEdge(predB, targetId: cont.id, argIds: edgeArgsB)
	end 'mergeAtContinuation'

	// Rebind each carried binding to a previously-captured snapshot value (from
	// `snapshotBindings` over the SAME `bindings` list). Used to rewind to the pre-branch
	// state before parsing an `if`'s false path, and to select a single surviving branch's
	// values at a continuation. Written THROUGH the binding, not by name, so a value is
	// never routed to a shadow (see LoopPhiVar). A var not in `bindings` is assigned by no
	// branch, so its value is already the one every path agrees on — nothing to restore.
	function restoreBindings(bindings VarInfoArray, snapshot ValueIdArray)
		self.assertSnapshotAligned(bindings, snapshot: snapshot, site: "restoreBindings")
		for k in 0 upto bindings.count() 'each'
			var binding = try bindings.get(k) otherwise panic("restoreBindings: bindings.get OOB at {k}")
			binding.boundValue = try snapshot.get(k) otherwise panic("restoreBindings: snapshot.get OOB at {k}")
		end 'each'
	end 'restoreBindings'

	// Every value snapshot is positional over the carried `bindings` list and must
	// therefore have exactly its length — block scoping is what guarantees that (a
	// branch-local `var` is drained at the block's `end`, so it never entered `bindings`
	// and can never lengthen a snapshot taken outside the block). A mismatch means the two
	// fell out of step, which would misattribute every later binding's value by one, so it
	// fails loudly here rather than silently.
	function assertSnapshotAligned(bindings VarInfoArray, snapshot ValueIdArray, site String)
		let expected = bindings.count()
		if snapshot.count() != expected 'drifted'
			panic("{site}: value snapshot holds {snapshot.count()} entries but the if carries {expected} assigned bindings — the snapshot drifted out of lockstep with the carried-bindings list")
		end 'drifted'
	end 'assertSnapshotAligned'

	// Parse a `while` loop (M4b):
	//   while <cond> 'label'
	//       <body>
	//   end 'label'
	//
	// Lowering shape (the first BACKWARD-branching CFG): the current block becomes the
	// PREHEADER, which branches unconditionally into a fresh HEADER. The header re-
	// evaluates the condition each iteration (a comparison, fused into `cmp`+`jcc` by
	// the Std→x64 pass, exactly as an `if`) and takes a two-way branch to the BODY or
	// the EXIT. The body ends with a BACK-EDGE branch to the header; `break` branches
	// to the exit, `continue` to the header. `resolveBlockJumps` already patches
	// backward rel32, so no new encoder work is needed.
	//
	// On-the-fly SSA: the header carries one PHI (block-arg) per mutable var the loop
	// ASSIGNS, minted eagerly BEFORE the body is parsed. Each phi becomes the var's current
	// value, so the condition and body read the loop-carried value; the preheader and every
	// back-edge feed the phis via the predecessor's `branchEdges`. Returns the EXIT block.
	//
	// **THE CARRIED SET IS THE VARS THE LOOP ASSIGNS — AND EAGER MINTING IS WHAT MAKES THAT
	// THE RIGHT QUESTION.** A var the loop never assigns holds the same value on every
	// iteration, so its pre-loop definition DOMINATES the header and a read inside the body
	// binds it correctly with no phi at all. A var the loop DOES assign needs one, and it
	// must exist before the body is parsed — because every read in the body, and every value
	// SNAPSHOT taken inside it (`parseIfStatement`'s entry/then/else snapshots, a nested
	// loop's preheader), captures whatever the binding holds AT THAT MOMENT. Mint the phi
	// later — on the var's first mention, say — and every snapshot already taken inside the
	// loop is holding the stale PRE-LOOP value, and an `if` merge in the body would carry it
	// onto the not-taken path. That is a silent miscompile on iteration 2, and it is why the
	// carried set is decided UP FRONT rather than discovered as the body is parsed:
	//
	//     var x = 1
	//     while c 'l'
	//         if d 'b'      // entry snapshot of x taken HERE
	//             x = 2     // a phi minted only now is invisible to that snapshot
	//         end 'b'       // ⇒ the false edge would carry 1, resetting x every iteration
	//     end 'l'
	//
	// So the set is read off the TOKENS, before a single op is emitted: `namesAssignedIn`
	// over the loop's token extent. It is an over-approximation on purpose (a shadowed inner
	// declaration of the same name counts, and so does a `let`), and over-approximating is
	// FREE while under-approximating is a miscompile — a surplus phi costs nothing:
	//   • a var the loop never READS gets a phi nothing reads — but the back edge passes
	//     that phi to ITSELF, so it is self-sustaining and liveness holds it live around
	//     the whole loop. `pruneDeadBlockArgs` (a Std pass) deletes those; without it, two
	//     sequential loops inflate maxlive by one per dead var and can FALSE-E5001.
	//   • a var the loop reads but never WRITES gets a phi that copies a value which never
	//     changes. Biased coloring coalesces it with its incoming value into one register
	//     and the edge copy self-elides (see RegisterAllocator.copyGroupBlocked).
	//
	// What this REPLACES is a phi for every mutable var IN SCOPE, which was quadratic in the
	// program: a function's `var`s accumulate as it goes, so the Nth loop minted phis for all
	// ~N of them and assigned a ValueId to each — including every one `pruneDeadBlockArgs`
	// then deleted. `blockArgIdBound`, and every dense column sized by it, is O(ValueIds), so
	// the phis nobody kept were still being paid for in bytes at every later pass.
	function parseWhileStatement(func IrFunction, block IrBlock) returns IrBlock throws ParseError
		let whileIndex = self.pos
		let whileTok = try self.consume(TokenKind.while)

		// Decided from the tokens, before anything is emitted — see the header.
		let bodyEndIndex = self.blockStatementEndIndex(whileIndex, continuesAtElse: false)
		let assigned = self.namesAssignedIn(whileIndex, endIndex: bodyEndIndex)

		var header = self.newBlock(func, label: b"whilehdr", line: whileTok.line)

		// Mint the header phis for the carried bindings, in declaration order, capturing each
		// one's PRE-LOOP value as it goes — `preheaderVals` is the preheader→header block-arg
		// list, so it is positional over `phiVars` (NOT over `mutableVars`, which now holds
		// bindings this loop does not carry). Reading `boundValue` before the phi overwrites
		// it is what keeps the two in step within the single pass.
		//
		// Index-based so each binding is a MUTABLE reference — a `for x in …` loop variable is
		// immutable, and installing the phi writes through the binding.
		var phiVars = LoopPhiVarArray.create()
		var preheaderVals = ValueIdArray.create()
		for k in 0 upto self.mutableVars.count() 'mkPhi'
			var binding = try self.mutableVars.get(k) otherwise panic("parseWhileStatement: mutableVars.get OOB at {k}")
			if not assigned.contains(binding.name) 'neverAssigned'
				continue
			end 'neverAssigned'

			preheaderVals.push(binding.boundValue)
			let phiId = self.mintPhiForBinding(header, binding: binding)
			phiVars.push(LoopPhiVar.create(binding, phiId: phiId))
			binding.boundValue = phiId
		end 'mkPhi'

		self.recordBranchEdge(block, targetId: header.id, argIds: preheaderVals)
		self.emitBranch(block, targetId: header.id)

		// Condition, evaluated in the header — so `continue` and the back edge, which both
		// target the header, re-evaluate it. A short-circuit `and`/`or` in the condition
		// (`while check() and more()`) spreads that evaluation over blocks BETWEEN the
		// header and the two-way branch; `condExit` is the block it ends in, and that is
		// where the branch — and the exit's incoming edge — belong. The header stays the
		// loop's entry, so nothing about `continue` or the back edge changes.
		let cond = try self.parseBoolCondition(func, block: header, kwTok: whileTok)
		var condExit = self.currentBlock
		let loopLabelTok = try self.consume(TokenKind.charLiteral)

		var body = self.newBlock(func, label: loopLabelTok.value, line: loopLabelTok.line)
		var exit = self.newBlock(func, label: b"whileexit", line: whileTok.line)
		self.emitCondBranch(condExit, cond: cond, thenId: body.id, elseId: exit.id, ifTok: whileTok)

		self.loops.push(LoopContext.create(loopLabelTok.value, headerId: header.id, exitId: exit.id, phiVars: phiVars))

		// The body is a lexical BLOCK: its declarations are gone — and its `var`s off
		// `mutableVars` — before the back-edge args below are read, so those args name the
		// loop's own phi bindings and never a body-local shadow.
		var bodyEnd = try self.parseBlockBody(func, block: body)

		// Guard the token scan against the parse it predicted — see `assertScanAligned`.
		self.assertScanAligned("parseWhileStatement", predictedEnd: bodyEndIndex)

		let ctx = try self.loops.pop() otherwise panic("parseWhileStatement: loop stack empty after body of '{String.from(loopLabelTok.value)}'")

		// Normal back-edge: a body that falls through returns to the header with its
		// (possibly reassigned) current values. A body that always returns/breaks/
		// continues on every path leaves `bodyEnd` terminated — no fall-through edge.
		if not bodyEnd.isTerminated() 'fallsBack'
			self.recordBranchEdge(bodyEnd, targetId: header.id, argIds: self.edgeArgsFor(phiVars))
			self.emitBranch(bodyEnd, targetId: header.id)
		end 'fallsBack'

		self.wireLoopExit(condExit, exit: exit, ctx: ctx)
		return exit
	end 'parseWhileStatement'

	// The index of the `end` token that closes the block statement opening at `startIndex`,
	// found by counting block openers against `end`s — the same depth-counted token walk
	// `skipBalancedParens` does for `(`/`)`, and run for the same reason: the answer is needed
	// BEFORE the real parse reaches it. The cursor is not moved.
	//
	// `continuesAtElse` is the ONE difference between the two constructs that call this, and it
	// is exactly the fact that a loop's extent ends at its first depth-0 `end` while an `if`
	// chain's does not:
	//   • `while` passes FALSE — the first depth-0 `end` closes the loop.
	//   • `if` passes TRUE — at each depth-0 `end` the scan PEEKS past the optional block label
	//     (`elseFollowsEnd`); a following `else` opens the next branch (a plain `else`, or the
	//     `if` of an `else if`), re-opens the depth, and the scan carries on, so the extent
	//     spans the then body AND every `else`/`else if` branch through the final `end`.
	//
	// Deliberately TOLERANT of a malformed tail, like `scanFunctionSignatures`: an unterminated
	// construct yields the end of the token stream rather than a diagnostic. That
	// over-approximates the extent, which is the SAFE direction (a carried set is never too
	// SMALL — see `parseWhileStatement` / `assignedBindingsIn`), and the real parse runs next
	// and reports the unexpected EOF with a position.
	function blockStatementEndIndex(startIndex TokenIndex, continuesAtElse bool) returns TokenIndex
		let count = self.tokens.count()
		var depth = 0
		var i = startIndex
		while i < count 'scan'
			if self.opensBlockAt(i) 'open'
				depth = depth + 1
			end 'open' else if self.kindAt(i) == TokenKind.end and not self.keywordIsMatchCaseName(i) 'close'
				depth = depth - 1
				if depth == 0 and (not continuesAtElse or not self.elseFollowsEnd(i)) 'matched'
					return i
				end 'matched'
			end 'close'

			i = i + 1
		end 'scan'
		return count
	end 'blockStatementEndIndex'

	// Does an `else` follow the `end` at `endIndex` — i.e. does an `if` chain continue past
	// it? Skips the ONE optional block label (`end 'x' else …`) that may sit between them; a
	// bare `end else …` has none. Peeking exactly one charLiteral is enough because an `end`
	// carries at most a single label, and the token after it is either `else` or the next
	// statement. This is the one place `blockStatementEndIndex` decides an `if` chain
	// continues, so a missed `else` under-approximates the extent — which the drift guard
	// converts to a loud panic rather than a silent lost phi.
	function elseFollowsEnd(endIndex TokenIndex) returns bool
		var next = endIndex + 1
		if self.kindAt(next) == TokenKind.charLiteral 'skipLabel'
			next = next + 1
		end 'skipLabel'

		return self.kindAt(next) == TokenKind.else
	end 'elseFollowsEnd'

	// Does the token at `index` open a block that a matching `end` closes?
	//
	// THIS IS MAXON'S BLOCK STRUCTURE, WRITTEN DOWN A SECOND TIME — `parseStatement` and
	// `parseBlockBody` own the first copy. It is kept honest by the drift panic in
	// `parseWhileStatement` rather than by hope: get this wrong and that panic fires, loudly,
	// on the first program that nests the missing construct in a loop.
	//
	// `else` is the subtle one. A plain `else 'label'` opens a block body of its own, but an
	// `else if` does NOT — the else branch simply IS a nested `if` statement (parseElseBody),
	// and that `if` is the opener whose `end` closes it. Counting `else if` as an opener would
	// leave one `end` unaccounted for and run the extent past the loop, which is safe but
	// wrong; counting it correctly keeps the scan exact and the drift guard meaningful.
	function opensBlockAt(index TokenIndex) returns bool
		let kind = self.kindAt(index)
		if kind == TokenKind.if or kind == TokenKind.while or kind == TokenKind.match 'alwaysOpens'
			return not self.keywordIsMatchCaseName(index)
		end 'alwaysOpens'

		if kind != TokenKind.else 'notElse'
			return false
		end 'notElse'

		return self.kindAt(index + 1) != TokenKind.if and not self.keywordIsMatchCaseName(index)
	end 'opensBlockAt'

	// Is the keyword at `index` being used as a match-arm CASE NAME rather than as control flow?
	//
	// ⚠ **AN ENUM CASE MAY BE SPELLED WITH A KEYWORD** (`enum TokenType { function if else end … }`,
	// keyword-as-case-name.md), and a match over such an enum writes `if gives …`, `end then …`,
	// `else to critical then …`. The block-extent token scans (`opensBlockAt`,
	// `blockStatementEndIndex`, the sweep's `blockDepthAfter`) read `if`/`else`/`end`/`while`/`match`
	// as block STRUCTURE, and would miscount those case-name arms — the match's end would be
	// mispredicted and the drift guard would fire (or the arm loop would stop early). A control
	// keyword is NEVER followed by a match-arm SEPARATOR in real control flow (`if` takes a condition,
	// `end` a label or newline, `while` a condition), so a keyword immediately followed by
	// `gives`/`then`/`to`/`upto`/`or` is unambiguously a case name. That single lookahead is what lets
	// every one of those scans skip a keyword case arm without re-deriving the grammar.
	function keywordIsMatchCaseName(index TokenIndex) returns bool
		let next = self.kindAt(index + 1)
		return next == TokenKind.gives or next == TokenKind.then or next == TokenKind.to or next == TokenKind.upto or next == TokenKind.or
	end 'keywordIsMatchCaseName'

	// The names ASSIGNED anywhere in `[startIndex, endIndex)` — the loop's carried-variable
	// set, read straight off the tokens (see `parseWhileStatement` for why it must be known
	// before the body is parsed).
	//
	// A reassignment is the ONLY way a `var` already in scope changes value, and its syntax is
	// exactly `identifier =` (parseStatement's two-token lookahead). `==` is a single
	// `equalsEquals` token, so a comparison cannot be mistaken for one.
	//
	// It OVER-approximates, and every case where it does is harmless because a surplus phi is
	// harmless while a missing one is a miscompile:
	//   • `let r = …` / `var t = …` inside the loop match the shape too. Those names are not
	//     mutable bindings in scope at the header, so they select nothing — unless an outer var
	//     of the same name is being SHADOWED, in which case the outer one gets a phi it does not
	//     need. Costs one coalesced copy; the alternative is tracking shadowing at token level,
	//     which is the block structure written down a THIRD time.
	function namesAssignedIn(startIndex TokenIndex, endIndex TokenIndex) returns AssignedNameSet
		// ⚠ THIS SCAN IS EXHAUSTIVE ONLY BECAUSE PARAMETERS ARE IMMUTABLE. Everything below reads
		// TOKENS, so it can only ever find a write that IS tokens — `identifier =`. A `var`
		// parameter is written by `mutate(p)` at the call site, leaving no `=` in this loop at all:
		// the scan would return without `p`, the header would mint no phi, and `p` would reset to
		// its entry value every iteration. Silent, and invisible to the drift panic that guards
		// this scan's OTHER assumption (the loop's extent), because the extent would be right.
		//
		// The tripwire for it is in `bindParameters`, on the mutability flag itself at the moment
		// it is passed — not here. This scan cannot enumerate parameters to check them, and a guard
		// here reading the `ParametersAreMutable` constant would be defeated by the very change it
		// guards against: a per-parameter feature stops reading that constant, and the guard goes
		// quiet exactly when it was needed.
		var assigned = AssignedNameSet.create()
		var i = startIndex
		while i < endIndex 'scan'
			if self.assignsAt(i) 'assignment'
				assigned.insert(self.tokenAt(i).value)
			end 'assignment'

			i = i + 1
		end 'scan'
		return assigned
	end 'namesAssignedIn'

	// THE GUARD ON A TOKEN-EXTENT SCAN, shared by `parseWhileStatement` and `parseIfStatement`.
	// `blockStatementEndIndex` re-derives Maxon's block structure at the token
	// level to fix a construct's carried-variable set BEFORE its body is parsed — a SECOND copy
	// of a fact the recursive-descent parser owns. If the two disagree the scan's extent is too
	// SHORT, the carried set is a SUBSET, and a carried var silently loses its merge phi: a wrong
	// answer with no diagnostic. This converts it into a loud one — the `end` the parser actually
	// consumed to close the last body (`lastBlockBodyEnd`) must be the one the scan predicted.
	//
	// It is what makes the duplication safe to keep. A future block statement (`for`, `match`)
	// added to `parseStatement` without teaching `opensBlockAt` about it trips this panic on the
	// first spec that nests it in a loop or an `if`, instead of miscompiling it. (Over-shooting
	// the extent cannot hide here: it never under-counts the carried set, and it would make the
	// prediction miss the actual `end` and panic too — so the scan is pinned from both sides.)
	function assertScanAligned(construct String, predictedEnd TokenIndex)
		if self.lastBlockBodyEnd != predictedEnd 'scanDrifted'
			panic("{construct}: the token scan predicted the closing `end` at token {predictedEnd} but the parser closed the last body at token {self.lastBlockBodyEnd} — `opensBlockAt` does not know every statement that opens a block, so the carried-variable set it computed may be missing a carried var")
		end 'scanDrifted'
	end 'assertScanAligned'

	// Set up the exit block's post-loop variable values. With no `break`, the exit is
	// reached only from the condition's false edge, so each var's value there IS its
	// header phi (no exit phi needed). With ≥1 `break`, the exit MERGES the condition-
	// false value with each break's value, so it gets its own phis and the false edge
	// passes the header phi values into them (the break edges were recorded as the breaks
	// were parsed).
	//
	// `condExit` — the block the condition ENDED in, which carries the two-way branch — is
	// the false edge's source, and it is only the header when the condition short-circuited
	// nowhere. Recording the edge on the header instead would attach the exit's phi operands
	// to a block that does not branch to the exit at all.
	//
	// Index-based in both loops so each phi var is a MUTABLE binding — a `for x in …`
	// loop variable is immutable, and installing the post-loop value writes through the
	// binding it carries.
	function wireLoopExit(condExit IrBlock, exit IrBlock, ctx LoopContext)
		if not ctx.hasBreak 'noBreak'
			for k in 0 upto ctx.phiVars.count() 'inherit'
				var pv = try ctx.phiVars.get(k) otherwise panic("wireLoopExit: phiVars.get OOB at {k}")
				pv.binding.boundValue = pv.phiId
			end 'inherit'
			return
		end 'noBreak'

		var headerVals = ValueIdArray.create()
		for k in 0 upto ctx.phiVars.count() 'mkExitPhi'
			var pv = try ctx.phiVars.get(k) otherwise panic("wireLoopExit: phiVars.get OOB at {k}")
			let exitPhiId = self.mintPhiForBinding(exit, binding: pv.binding)
			pv.binding.boundValue = exitPhiId
			headerVals.push(pv.phiId)
		end 'mkExitPhi'
		self.recordBranchEdge(condExit, targetId: exit.id, argIds: headerVals)
	end 'wireLoopExit'

	// Parse `break ['label']` (M4b): branch to the target loop's EXIT block, carrying
	// the current phi-var values so the exit's merge phis see this path's values.
	function parseBreakStatement(block IrBlock) throws ParseError
		let breakTok = try self.consume(TokenKind.break)
		var ctx = try self.resolveControlTarget("break", kwTok: breakTok)
		ctx.hasBreak = true
		self.recordBranchEdge(block, targetId: ctx.exitId, argIds: self.edgeArgsFor(ctx.phiVars))
		self.emitBranch(block, targetId: ctx.exitId)
	end 'parseBreakStatement'

	// Parse `continue ['label']` (M4b): branch to the target loop's HEADER (a back-
	// edge), carrying the current phi-var values so the header phis see this path.
	function parseContinueStatement(block IrBlock) throws ParseError
		let continueTok = try self.consume(TokenKind.continue)
		let ctx = try self.resolveControlTarget("continue", kwTok: continueTok)
		self.recordBranchEdge(block, targetId: ctx.headerId, argIds: self.edgeArgsFor(ctx.phiVars))
		self.emitBranch(block, targetId: ctx.headerId)
	end 'parseContinueStatement'

	// Resolve the loop a `break`/`continue` targets. No label → the innermost loop.
	// A label → the enclosing loop with that label; naming the INNERMOST loop's own
	// label is redundant (E2048), and a label matching no enclosing loop is E2047.
	// A `break`/`continue` with no enclosing loop at all is E2047. Returns the live
	// stack entry (a reference) so `break` can flip its `hasBreak`.
	function resolveControlTarget(keyword String, kwTok Token) returns LoopContext throws ParseError
		let depth = self.loops.count()
		if depth == 0 'noLoop'
			throw ParseError.controlOutsideLoop(keyword, line: kwTok.line, column: kwTok.column)
		end 'noLoop'

		if not self.at(TokenKind.charLiteral) 'unlabelled'
			return try self.loops.get(depth - 1) otherwise panic("resolveControlTarget: loops.get({depth - 1}) failed after count check")
		end 'unlabelled'

		let labelTok = try self.consume(TokenKind.charLiteral)
		for i in 0 upto depth 'search'
			let ctx = try self.loops.get(depth - 1 - i) otherwise panic("resolveControlTarget: loops.get OOB during label search")
			if ctx.label.equals(labelTok.value) 'match'
				if i == 0 'ownLabel'
					throw ParseError.labelTargetsOwnLoop(keyword, label: String.from(labelTok.value), line: labelTok.line, column: labelTok.column)
				end 'ownLabel'
				return ctx
			end 'match'
		end 'search'
		throw ParseError.unknownLoopLabel(keyword, label: String.from(labelTok.value), line: labelTok.line, column: labelTok.column)
	end 'resolveControlTarget'

	// The current SSA value of each binding in `bindings`, in the list's order — one of an
	// `if`'s three merge snapshots (entry / then-exit / else-exit), positional over the
	// statement's carried set (`assignedBindings`).
	function snapshotBindings(bindings VarInfoArray) returns ValueIdArray
		var vals = ValueIdArray.create()
		for binding in bindings 'each'
			vals.push(binding.boundValue)
		end 'each'
		return vals
	end 'snapshotBindings'

	// The mutable bindings an `if` statement's token extent ASSIGNS — its carried set, the
	// SUBSET of `mutableVars` a continuation phi can be minted for, returned in `mutableVars`
	// DECLARATION ORDER. That order is load-bearing: the phis a merge mints follow it, and it
	// is what makes the sparse merge emit byte-identical code to the old one that iterated the
	// whole `mutableVars` list (see mergeAtContinuation). Token/assignment order would permute
	// two phis of one `if` and move codegen — the scale corpus's rotating write set proves it
	// (`w5 = …; w0 = …` assigns in the order 5, 0 but must merge in the order 0, 5).
	//
	// Built by filtering `mutableVars` through `namesAssignedIn` — the SAME token scan the loop
	// carried set uses. The scan OVER-approximates (a shadowing inner `let`/`var`, or a name
	// assigned only past the extent when `blockStatementEndIndex` runs wide, is included), and that
	// is FREE: an unassigned carried binding has a == b at the merge and mints no phi, costing
	// one snapshot slot and nothing else. UNDER-approximating would drop a real phi — a silent
	// miscompile — so the extent errs wide and the drift guard (`assertScanAligned`) refuses a
	// too-short one. A name in scope but NOT mutable, or not bound at entry (a branch-local
	// `var`), matches no `mutableVars` entry and is correctly absent.
	function assignedBindingsIn(startIndex TokenIndex, endIndex TokenIndex) returns VarInfoArray
		let assigned = self.namesAssignedIn(startIndex, endIndex: endIndex)
		var bindings = VarInfoArray.create()
		for k in 0 upto self.mutableVars.count() 'each'
			var binding = try self.mutableVars.get(k) otherwise panic("assignedBindingsIn: mutableVars.get OOB at {k}")
			if assigned.contains(binding.name) 'isAssigned'
				bindings.push(binding)
			end 'isAssigned'
		end 'each'
		return bindings
	end 'assignedBindingsIn'

	// The current SSA value of each phi binding, in phi order — an in-edge's block-arg
	// list (a back-edge to the header, or a break to the exit). Read off the BINDING, so
	// a `break` out of a block that shadows a loop-carried `var` still carries the
	// loop's own binding to the exit phi, not the shadow's value.
	function edgeArgsFor(phiVars LoopPhiVarArray) returns ValueIdArray
		var vals = ValueIdArray.create()
		for pv in phiVars 'each'
			vals.push(pv.binding.boundValue)
		end 'each'
		return vals
	end 'edgeArgsFor'

	// ============================================================================================
	// `match` on SCALAR scrutinees (int/bool/float) — P1.1b wave A. No enums.
	//
	// A match lowers to a CHAIN of two-way `condBranch` test blocks and a block-arg join — the
	// exact primitives `if`/`else`/`while` already use. There is NO new IR op:
	//
	//   test0:  <pattern0 → bool cond0> ; condBranch(cond0, then: body0, else: test1)
	//   test1:  <pattern1 → bool cond1> ; condBranch(cond1, then: body1, else: test2)
	//   ...
	//   testN:  <the default body — the last real arm's `else` target>
	//   body0:  <arm 0's body> ; branch merge   (or → next body on `and fallthrough`)
	//   ...
	//   merge:  phi(s) ; <the result, for a `gives` match>
	//
	// A pattern is OR-folded into ONE boolean, exactly as both reference compilers do: a single
	// value is `scrut == v`, a range `lo to hi` is `(scrut >= lo) and (scrut <= hi)` (a bitwise
	// `and` over the two `bool`s — eager, since a pattern has no side effects), an `or` is a
	// bitwise `or` of the alternatives, `upto` uses `<` for the upper bound, and `min`/`max` drop
	// the corresponding compare.
	//
	// ⭐ The `gives` result and every cross-arm `var` mutation join through BLOCK-ARGS, not v1's /
	// the bootstrap's mutable result SLOT — see MatchArmExit's header. shv2 has no slots and no
	// mem2reg, so the parser threads each reaching arm's value to the merge as a block-arg, the
	// same on-the-fly SSA `if`/`while` use.
	// ============================================================================================

	// The STATEMENT form: `match <expr> 'l' <arms> end 'l'`. Returns the continuation control
	// resumes in — reachable when an arm falls through to it, `dead` when every arm terminates.
	function parseMatchStatement(func IrFunction, block IrBlock) returns IrBlock throws ParseError
		let outcome = try self.parseMatchCommon(func, block: block, isExpression: false)
		return outcome.cont
	end 'parseMatchStatement'

	// The EXPRESSION form: `let r = match …`, `match … * 2`. Yields the merge's result phi and
	// leaves control in the merge, exactly as `emitShortCircuit` does — so the climber continues
	// from `currentBlock` after it.
	function parseMatchExpression(func IrFunction) returns ValueId throws ParseError
		let outcome = try self.parseMatchCommon(func, block: self.currentBlock, isExpression: true)
		match outcome.result 'r'
			value(id) then return id
			none then panic("parseMatchExpression: an expression match produced no value — every `gives` arm must reach the merge")
		end 'r'
	end 'parseMatchExpression'

	// The shared core, driving both forms off `isExpression` (which decides `then` vs `gives` and
	// whether the merge carries a result phi). The single owner of the scrutinee, the block label,
	// the arm loop, exhaustiveness, and the merge join.
	function parseMatchCommon(func IrFunction, block IrBlock, isExpression bool) returns MatchOutcome throws ParseError
		let matchIndex = self.pos
		let matchTok = try self.consume(TokenKind.match)

		// The carried-variable set — the mutable bindings the WHOLE match assigns, read off the
		// tokens before anything is emitted, exactly as `if`/`while` read theirs. `matchEnd` feeds
		// the drift guard below.
		let matchEnd = self.blockStatementEndIndex(matchIndex, continuesAtElse: false)
		let carried = self.assignedBindingsIn(matchIndex, endIndex: matchEnd)

		// The scrutinee. It may itself short-circuit and move `currentBlock`, so the first arm's
		// test goes into wherever the scrutinee left control — its exit block, not `block`.
		let scrut = try self.parseExpression(func, block: block)
		let scrutTag = self.tagOf(scrut)

		if not self.at(TokenKind.charLiteral) 'noLabel'
			let missing = self.current()
			throw ParseError.matchMissingBlockId(missing.line, column: missing.column)
		end 'noLabel'
		let labelTok = try self.consume(TokenKind.charLiteral)
		let matchLabel = labelTok.value

		let entryVals = self.snapshotBindings(carried)

		// Arm-loop state. The first arm's test goes into the block the scrutinee left control in
		// (`self.currentBlock`); `prevTestBlock`/`prevExitBlock` are seeded with it too and read only
		// under the flag that makes them meaningful (`hasRealArm` / `prevFallthrough`) — a block has
		// no empty value, and a sentinel would be a lie a later read could believe.
		var currentTestBlock = self.currentBlock
		var prevTestBlock = self.currentBlock
		var hasRealArm = false
		var sawDefault = false
		var prevFallthrough = false
		var prevExitBlock = self.currentBlock
		var prevExitVals = ValueIdArray.create()
		var seenValues = ParsedIntArray.create()
		var reachingArms = MatchArmExitArray.create()

		// ⭐ ENUM vs SCALAR is decided ONCE, from the scrutinee's type. A `named(X)` scrutinee whose
		// name is a declared enum/union takes the enum path — case-name patterns, the OPEN #21 range
		// rule, coverage over the case set; every other scrutinee is a scalar match (Wave A). The two
		// share this whole dispatch engine (the `condBranch` chain, the arm bodies, the merge); only
		// the PATTERN emission, the `default` rule, and the exhaustiveness check branch on it.
		let enumMatch = self.enumMatchFor(scrut)
		let isEnumMatch = enumMatchIsDeclared(enumMatch)
		// One coverage bit per case, in declaration order — the enum twin of `seenValues`. Populated
		// only for an enum match; a bare case marks its bit, a range marks the slice it covers, and a
		// second mark on one bit is E2027. Its all-true state IS exhaustiveness.
		var enumCovered = BoolArray.create()
		if isEnumMatch 'initEnumCoverage'
			let layout = requireEnumLayout(enumMatch)
			for _ in 0 upto layout.caseCount() 'eachCase'
				enumCovered.push(false)
			end 'eachCase'
		end 'initEnumCoverage'

		while true 'arms'
			self.skipNewlines()
			// The closing `end` — unless it is a keyword CASE NAME arm (`end gives …`) on an enum
			// whose case is spelled `end`. See `keywordIsMatchCaseName`.
			if self.at(TokenKind.end) and not self.keywordIsMatchCaseName(self.pos) 'endOfArms'
				break
			end 'endOfArms'

			if self.at(TokenKind.default) 'defaultArm'
				// ⚠ **A `default` ON AN ENUM MATCH IS E2046** — an enum match is exhaustive by listing
				// every case, so a plain catch-all is forbidden (it would silently mask a case added
				// later). The only legal enum default is `default throws`/`default panic`, neither of
				// which shv2 has yet, so EVERY enum `default` is this error at this rung. Positioned at
				// the `default`, before the scalar default machinery below runs.
				if isEnumMatch 'enumDefault'
					let defTok = self.current()
					let layout = requireEnumLayout(enumMatch)
					throw ParseError.matchDefaultEnumMustThrow(layout.kindWord(), typeName: String.from(layout.name), line: defTok.line, column: defTok.column)
				end 'enumDefault'

				// A second `default`, or any `default` that is not last, is E2029 — reported when a
				// pattern arm FOLLOWS a default (below); a default following a default is the same rule.
				if sawDefault 'defaultAfterDefault'
					let dupTok = self.current()
					throw ParseError.matchDefaultNotLast(dupTok.line, column: dupTok.column)
				end 'defaultAfterDefault'

				try self.consume(TokenKind.default)
				// The default's body IS the last real arm's `else` target (or the entry block when the
				// match is default-only): there is no pattern to test. `var` because `parseArmBody`
				// mutates the block it fills.
				var defaultBody = currentTestBlock
				if prevFallthrough 'defaultIsFtTarget'
					let matchEdgeArgs = self.setupFallthroughTargetPhis(defaultBody, carried: carried, entryVals: entryVals, prevExitBlock: prevExitBlock, prevExitVals: prevExitVals)
					// The fail edge into the default body — the last real arm's `condBranch` else,
					// already emitted; only its phi args are recorded now.
					if hasRealArm 'defaultFailEdge'
						self.recordBranchEdge(prevTestBlock, targetId: defaultBody.id, argIds: matchEdgeArgs)
					end 'defaultFailEdge'
				end 'defaultIsFtTarget' else 'defaultFresh'
					self.restoreBindings(carried, snapshot: entryVals)
				end 'defaultFresh'

				let defaultArmBody = try self.parseArmBody(func, bodyBlock: defaultBody, isExpression: isExpression, carried: carried)
				// `default` is the last arm, so a fall-through has no next arm to reach — it simply
				// continues to the merge. So the test is "did control leave?", not `reachesMerge`.
				if not defaultArmBody.exitBlock.isTerminated() 'defaultReaches'
					reachingArms.push(MatchArmExit.create(defaultArmBody.exitBlock, exitVals: defaultArmBody.exitVals, give: defaultArmBody.give))
				end 'defaultReaches'
				sawDefault = true
				prevFallthrough = false
			end 'defaultArm' else 'patternArm'
				if sawDefault 'armAfterDefault'
					let strayTok = self.current()
					throw ParseError.matchDefaultNotLast(strayTok.line, column: strayTok.column)
				end 'armAfterDefault'

				let patternTok = self.current()
				// `var` because both blocks are forwarded to functions that fill them (the pattern's
				// phis, the arm body, the next arm's test) — a `let` cannot back a mutating parameter.
				var bodyBlock = self.newBlock(func, label: b"matcharm", line: patternTok.line)
				let nextTest = self.newBlock(func, label: b"matchnext", line: patternTok.line)

				// Emit the pattern condition into the current test block. A pattern never
				// short-circuits (eager bitwise fold), so `currentBlock` does not move. Enum patterns
				// are case names + the #21 range rule; scalar patterns are literals + ranges (Wave A).
				self.currentBlock = currentTestBlock
				var cond = 0 as ValueId
				if isEnumMatch 'enumPattern'
					cond = try self.emitEnumPatternCondition(scrut, layout: requireEnumLayout(enumMatch), covered: enumCovered)
				end 'enumPattern' else 'scalarPattern'
					cond = try self.emitPatternCondition(scrut, scrutTag: scrutTag, seenValues: seenValues)
				end 'scalarPattern'

				var matchEdgeArgs = ValueIdArray.create()
				if prevFallthrough 'armIsFtTarget'
					matchEdgeArgs = self.setupFallthroughTargetPhis(bodyBlock, carried: carried, entryVals: entryVals, prevExitBlock: prevExitBlock, prevExitVals: prevExitVals)
				end 'armIsFtTarget' else 'armFresh'
					self.restoreBindings(carried, snapshot: entryVals)
				end 'armFresh'

				self.recordBranchEdge(currentTestBlock, targetId: bodyBlock.id, argIds: matchEdgeArgs)
				self.emitCondBranch(currentTestBlock, cond: cond, thenId: bodyBlock.id, elseId: nextTest.id, ifTok: patternTok)

				let armBody = try self.parseArmBody(func, bodyBlock: bodyBlock, isExpression: isExpression, carried: carried)
				if armBody.fellThrough 'fellThrough'
					prevFallthrough = true
					prevExitBlock = armBody.exitBlock
					prevExitVals = armBody.exitVals
				end 'fellThrough' else 'notFallThrough'
					prevFallthrough = false
					if armBody.reachesMerge 'armReaches'
						reachingArms.push(MatchArmExit.create(armBody.exitBlock, exitVals: armBody.exitVals, give: armBody.give))
					end 'armReaches'
				end 'notFallThrough'

				prevTestBlock = currentTestBlock
				hasRealArm = true
				currentTestBlock = nextTest
			end 'patternArm'
		end 'arms'

		// ⚠ An exhaustive enum match's FINAL `else` target — the last arm's fail edge — is UNREACHABLE
		// (every value matches some arm), but the last arm's `condBranch` named it, so the CFG edge
		// exists and the block needs a terminator. `dead` marks it unreachable, the same terminator the
		// parser gives code after a fully-terminated `if`/`else`. A scalar match cannot reach here with
		// a dangling block: it is exhaustive only through a `default`, whose BODY consumes this block.
		if isEnumMatch 'enumFallOffUnreachable'
			currentTestBlock.terminator = Terminator.dead

			// A trailing `and fallthrough` on the LAST arm has no following arm or `default` to fall
			// INTO (a pattern arm cannot follow a default, and an enum match has no legal default at
			// this rung), so it falls OUT of the match to the continuation — exactly as an arm that
			// reaches the merge does. Without this the arm body is left unterminated and
			// `assertAllBlocksTerminated` panics; the reference compiler accepts it as a no-op tail.
			// Statement form only: `and fallthrough` after a `gives` arm is already rejected, so the
			// give is `none`. A SCALAR match cannot reach this with `prevFallthrough`: a trailing
			// fallthrough with no `default` is rejected by the `notExhaustive` throw below.
			if prevFallthrough 'trailingFallthrough'
				reachingArms.push(MatchArmExit.create(prevExitBlock, exitVals: prevExitVals, give: MatchGiveValue.none))
			end 'trailingFallthrough'
		end 'enumFallOffUnreachable'

		// EXHAUSTIVENESS. An enum match must cover every case (E2026 listing the missing ones); a
		// scalar match is exhaustive only through a `default` (without one it would silently do nothing
		// for an unmatched value). Both are anchored at the closing `end`, as both references anchor it.
		if isEnumMatch 'enumExhaustive'
			try self.checkEnumExhaustive(requireEnumLayout(enumMatch), covered: enumCovered)
		end 'enumExhaustive' else if not sawDefault 'notExhaustive'
			var subject = "match"
			if isExpression 'exprSubject'
				subject = "match expression"
			end 'exprSubject'
			let endMissing = self.current()
			throw ParseError.matchNotExhaustive(subject, line: endMissing.line, column: endMissing.column)
		end 'notExhaustive'

		// Drift guard, mirroring the `if`/`while` token-extent scans: the `end` the parser reached
		// must be the one `blockStatementEndIndex` predicted, or `opensBlockAt` misclassified a
		// construct nested in the arms and the carried set may be short.
		self.lastBlockBodyEnd = self.pos
		let endTok = try self.consume(TokenKind.end)
		self.assertScanAligned("parseMatch", predictedEnd: matchEnd)

		if self.at(TokenKind.charLiteral) 'endLabel'
			let closeTok = try self.consume(TokenKind.charLiteral)
			if not closeTok.value.equals(matchLabel) 'labelMismatch'
				throw ParseError.matchMismatchedBlockId(String.from(matchLabel), got: String.from(closeTok.value), line: endTok.line, column: endTok.column)
			end 'labelMismatch'
		end 'endLabel'

		let outcome = try self.finalizeMatchMerge(func, matchTok: matchTok, carried: carried, reachingArms: reachingArms, isExpression: isExpression)
		self.currentBlock = outcome.cont
		return outcome
	end 'parseMatchCommon'

	// Parse ONE arm's body. A `gives` arm is a single expression (its value feeds the merge phi); a
	// `then` arm is a single statement, and `and fallthrough` may follow it. Reports E2049 for a
	// block-opening statement body, E2025 for `return … and fallthrough`, and E2001 for a stray
	// `and` after a `gives` arm.
	function parseArmBody(func IrFunction, bodyBlock IrBlock, isExpression bool, carried VarInfoArray) returns MatchArmBody throws ParseError
		self.currentBlock = bodyBlock

		if isExpression 'givesArm'
			try self.consume(TokenKind.gives)
			let value = try self.parseExpression(func, block: self.currentBlock)
			let exitBlock = self.currentBlock
			// `and fallthrough` is meaningless where every arm must yield a value. The climber
			// already stopped at the `and` (see parseBinary), so it sits here as a stray token.
			if self.at(TokenKind.and) 'strayAnd'
				let andTok = self.current()
				throw ParseError.matchExpressionStrayToken(andTok.kind.rawValue, line: andTok.line, column: andTok.column)
			end 'strayAnd'
			return MatchArmBody.create(false, reachesMerge: not exitBlock.isTerminated(), exitBlock: exitBlock, exitVals: self.snapshotBindings(carried), give: MatchGiveValue.value(value))
		end 'givesArm'

		try self.consume(TokenKind.then)

		// Each arm body is a single statement — a block-opening one (`if`/`while`/`for`/`match`)
		// has no place for its nested scope on a single-line arm.
		let firstTok = self.current()
		if self.isBlockOpeningStatement(firstTok.kind) 'blockOpener'
			throw ParseError.matchBlockStatement(firstTok.kind.rawValue, line: firstTok.line, column: firstTok.column)
		end 'blockOpener'

		// Whether the body is a `return` is read BEFORE it is parsed — `and fallthrough` after a
		// `return` cannot combine (the `return` has already left the arm).
		let isReturn = self.at(TokenKind.return)
		let exitBlock = try self.parseStatement(func, block: self.currentBlock)

		var fellThrough = false
		if self.at(TokenKind.and) and self.peekKind() == TokenKind.fallthrough 'fallthroughSuffix'
			let andTok = self.current()
			if isReturn 'ftReturn'
				throw ParseError.matchFallthroughWithReturn(andTok.line, column: andTok.column)
			end 'ftReturn'
			try self.consume(TokenKind.and)
			try self.consume(TokenKind.fallthrough)
			fellThrough = true
		end 'fallthroughSuffix'

		let reachesMerge = not exitBlock.isTerminated() and not fellThrough
		return MatchArmBody.create(fellThrough, reachesMerge: reachesMerge, exitBlock: exitBlock, exitVals: self.snapshotBindings(carried), give: MatchGiveValue.none)
	end 'parseArmBody'

	// The block-opening statement keywords — an arm body may not start with one (E2049). `try`'s
	// block form is also one, but `try` is a later rung and cannot appear here yet.
	function isBlockOpeningStatement(kind TokenKind) returns bool
		return kind == TokenKind.if or kind == TokenKind.while or kind == TokenKind.for or kind == TokenKind.match
	end 'isBlockOpeningStatement'

	// Set up the phis of a FALLTHROUGH-TARGET body block — one reached both by its match edge(s)
	// (carrying the pre-match `entryVals`) and by the previous arm's fallthrough edge (carrying
	// that arm's exit values). A carried var gets a merge phi exactly where the two disagree; the
	// fallthrough edge is recorded and emitted here, and the differing `entryVals` are RETURNED for
	// the caller to record on the match edge (a regular arm's `condBranch` then-edge, or the
	// default's fail edge).
	function setupFallthroughTargetPhis(bodyBlock IrBlock, carried VarInfoArray, entryVals ValueIdArray, prevExitBlock IrBlock, prevExitVals ValueIdArray) returns ValueIdArray
		var matchEdgeArgs = ValueIdArray.create()
		var fallthroughEdgeArgs = ValueIdArray.create()
		for k in 0 upto carried.count() 'each'
			var binding = try carried.get(k) otherwise panic("setupFallthroughTargetPhis: carried.get OOB at {k}")
			let entryV = try entryVals.get(k) otherwise panic("setupFallthroughTargetPhis: entryVals.get OOB at {k}")
			let prevV = try prevExitVals.get(k) otherwise panic("setupFallthroughTargetPhis: prevExitVals.get OOB at {k}")
			if entryV == prevV 'same'
				binding.boundValue = entryV
			end 'same' else 'differ'
				let phiId = self.mintPhiForBinding(bodyBlock, binding: binding)
				binding.boundValue = phiId
				matchEdgeArgs.push(entryV)
				fallthroughEdgeArgs.push(prevV)
			end 'differ'
		end 'each'
		self.recordBranchEdge(prevExitBlock, targetId: bodyBlock.id, argIds: fallthroughEdgeArgs)
		self.emitBranch(prevExitBlock, targetId: bodyBlock.id)
		return matchEdgeArgs
	end 'setupFallthroughTargetPhis'

	// Create the merge block LAST (so it lays out after every arm body) and join the reaching arms
	// into it. An empty set means every arm terminated — the merge is `dead`. Otherwise mint the
	// block-args in order — the result phi (expression form) first, then one phi per carried var
	// that differs across the reaching arms — and record each arm's edge in the SAME order.
	function finalizeMatchMerge(func IrFunction, matchTok Token, carried VarInfoArray, reachingArms MatchArmExitArray, isExpression bool) returns MatchOutcome throws ParseError
		var merge = self.newBlock(func, label: b"matchcont", line: matchTok.line)

		if reachingArms.count() == 0 'allTerminate'
			merge.terminator = Terminator.dead
			if isExpression 'exprNoValue'
				panic("finalizeMatchMerge: a match expression reached no value-producing arm — every `gives` arm must reach the merge (diverging arms are a later rung)")
			end 'exprNoValue'
			return MatchOutcome.create(merge, result: MatchGiveValue.none)
		end 'allTerminate'

		// The first reaching arm is the reference every "do the arms differ / what is the common
		// value" question is asked against, so it is fetched once here (the count check above proves
		// it exists).
		let firstArm = try reachingArms.get(0) otherwise panic("finalizeMatchMerge: reachingArms.get(0) failed after count check")

		// ⚠ **A CROSS-REGISTER-CLASS EXPRESSION MATCH IS REFUSED HERE, LOUDLY — it must not reach the
		// backend.** Every arm's `gives` value is fed into ONE result phi, and a value's register file
		// (GP vs XMM) is fixed by its type at birth. So an integer give and a float give in the same
		// match hand the phi two values from different files; the allocator cannot color that move and
		// `X64Backend.emitRegRegMove` panics ("crosses register files") — a compiler crash on a user
		// program, not a diagnostic. The reference oracle UNIFIES such arms, promoting the integer
		// arms to float (`cvtsi2sd`) so the result is uniformly float; shv2 has that instruction
		// (`promoteToFloat`) and lattice already, but the *result* of such a match is a float value,
		// and a float has no nameable type in shv2 yet (`typealias F = float(…)` is itself still
		// E2015). Building the promotion before floats are nameable would be a value nothing can hold.
		// ⇒ refused as "not yet", positioned, exactly as every other unbuilt scalar surface is — and
		// recorded in OPEN.md as the promotion the float rung supplies. Same-class arms (int + bool)
		// share a file, need no promotion, and never reach this throw.
		if isExpression 'checkGiveClass'
			var anyFloat = false
			var anyNonFloat = false
			for i in 0 upto reachingArms.count() 'scanClass'
				let a = try reachingArms.get(i) otherwise panic("finalizeMatchMerge: reachingArms.get OOB at {i}")
				if tagIsFloat(self.tagOf(self.giveValueOf(a))) 'isFloat'
					anyFloat = true
				end 'isFloat' else 'notFloat'
					anyNonFloat = true
				end 'notFloat'
			end 'scanClass'

			if anyFloat and anyNonFloat 'crossClass'
				throw ParseError.unsupported("a match expression whose arms give values of different register classes (a float arm and a non-float arm) — unifying them promotes the integer arms to float, whose result has no nameable type until the float type system lands (a `float` typealias is itself not yet parsed), and it arrives with that rung", line: matchTok.line, column: matchTok.column)
			end 'crossClass'
		end 'checkGiveClass'

		// Every reaching arm branches to the merge (its exit block is, by definition, unterminated).
		for i in 0 upto reachingArms.count() 'branchToMerge'
			var arm = try reachingArms.get(i) otherwise panic("finalizeMatchMerge: reachingArms.get OOB at {i}")
			self.emitBranch(arm.exitBlock, targetId: merge.id)
		end 'branchToMerge'

		// A carried var needs a merge phi iff its value is not identical across every reaching arm.
		var differs = BoolArray.create()
		for k in 0 upto carried.count() 'eachVar'
			let v0 = try firstArm.exitVals.get(k) otherwise panic("finalizeMatchMerge: exitVals.get OOB at {k}")
			var anyDiff = false
			for i in 1 upto reachingArms.count() 'eachArm'
				let arm = try reachingArms.get(i) otherwise panic("finalizeMatchMerge: reachingArms.get OOB at {i}")
				let vi = try arm.exitVals.get(k) otherwise panic("finalizeMatchMerge: exitVals.get OOB at {k}")
				if vi != v0 'diff'
					anyDiff = true
				end 'diff'
			end 'eachArm'
			differs.push(anyDiff)
		end 'eachVar'

		// Mint the merge block-args. The result phi (if any) leads, so it is block-arg 0 and every
		// edge lists its `gives` value first.
		var result = MatchGiveValue.none
		if isExpression 'resultPhi'
			let firstGive = self.giveValueOf(firstArm)
			let giveType = self.typeOf(firstGive)
			let phiId = self.mintPhi(merge, tag: maxonTypeTag(giveType), nameId: typeNameIdOf(giveType))
			result = MatchGiveValue.value(phiId)
		end 'resultPhi'

		for k in 0 upto carried.count() 'setBindings'
			var binding = try carried.get(k) otherwise panic("finalizeMatchMerge: carried.get OOB at {k}")
			let isDifferent = try differs.get(k) otherwise panic("finalizeMatchMerge: differs.get OOB at {k}")
			if isDifferent 'phiVar'
				binding.boundValue = self.mintPhiForBinding(merge, binding: binding)
			end 'phiVar' else 'common'
				binding.boundValue = try firstArm.exitVals.get(k) otherwise panic("finalizeMatchMerge: exitVals.get OOB at {k}")
			end 'common'
		end 'setBindings'

		// Record each reaching arm's edge args, in the block-arg order minted above.
		for i in 0 upto reachingArms.count() 'recordEdges'
			var arm = try reachingArms.get(i) otherwise panic("finalizeMatchMerge: reachingArms.get OOB at {i}")
			var argIds = ValueIdArray.create()
			if isExpression 'giveArg'
				argIds.push(self.giveValueOf(arm))
			end 'giveArg'
			for k in 0 upto carried.count() 'eachVarArg'
				let isDifferent = try differs.get(k) otherwise panic("finalizeMatchMerge: differs.get OOB at {k}")
				if isDifferent 'diffArg'
					argIds.push(try arm.exitVals.get(k) otherwise panic("finalizeMatchMerge: exitVals.get OOB at {k}"))
				end 'diffArg'
			end 'eachVarArg'
			self.recordBranchEdge(arm.exitBlock, targetId: merge.id, argIds: argIds)
		end 'recordEdges'

		return MatchOutcome.create(merge, result: result)
	end 'finalizeMatchMerge'

	// The `gives` value an expression arm carries. Only ever asked of an expression-match arm, so a
	// `none` is a parser invariant break, not a program error.
	function giveValueOf(arm MatchArmExit) returns ValueId
		match arm.give 'g'
			value(id) then return id
			none then panic("giveValueOf: an expression-match arm carries no `gives` value")
		end 'g'
	end 'giveValueOf'

	// Emit one arm's pattern as a single boolean condition, OR-folding the alternatives (`1 or 2 or
	// 3`). Records single-value patterns for the duplicate check and rejects a pattern whose type
	// cannot be compared to the scrutinee (E2028). Emits into `currentBlock`.
	function emitPatternCondition(scrut ValueId, scrutTag ValueTypeTag, seenValues ParsedIntArray) returns ValueId throws ParseError
		var cond = try self.emitPatternAtom(scrut, scrutTag: scrutTag, seenValues: seenValues)
		while self.at(TokenKind.or) 'orChain'
			let orTok = try self.consume(TokenKind.or)
			let rhs = try self.emitPatternAtom(scrut, scrutTag: scrutTag, seenValues: seenValues)
			cond = try self.emitBinOp(cond, rhs: rhs, op: MaxonBinOp.bitOr, opTok: orTok)
		end 'orChain'
		return cond
	end 'emitPatternCondition'

	// One alternative of a pattern: an open-lower range (`min to/upto hi`), a closed/open-upper
	// range (`lo to/upto hi`, `lo to max`), or a single value.
	function emitPatternAtom(scrut ValueId, scrutTag ValueTypeTag, seenValues ParsedIntArray) returns ValueId throws ParseError
		let startTok = self.current()

		if self.isOpenBoundIdentifier(startTok, marker: MinBoundField) 'openLower'
			self.advance()
			return try self.emitOpenLowerRange(scrut, scrutTag: scrutTag)
		end 'openLower'

		let lo = try self.emitPatternValue(scrutTag)

		if self.at(TokenKind.to) or self.at(TokenKind.upto) 'rangeArm'
			let isUpto = self.at(TokenKind.upto)
			let rangeTok = self.current()
			self.advance()
			return try self.emitClosedRange(scrut, scrutTag: scrutTag, loValue: lo, isUpto: isUpto, rangeTok: rangeTok)
		end 'rangeArm'

		// A single value: `scrut == lo`.
		try self.checkAndRecordDuplicate(lo, seenValues: seenValues, patternTok: startTok)
		return try self.emitCompare(scrut, rhs: lo, op: MaxonCmpOp.eq, opTok: startTok)
	end 'emitPatternAtom'

	// `min to/upto <hi>` — the lower bound is open, so the condition is just the upper compare. A
	// `min to max` covers every value: a constant `true`.
	function emitOpenLowerRange(scrut ValueId, scrutTag ValueTypeTag) returns ValueId throws ParseError
		if not (self.at(TokenKind.to) or self.at(TokenKind.upto)) 'notRange'
			let notRangeTok = self.current()
			throw ParseError.unexpectedToken(TokenKind.to.rawValue, got: notRangeTok.kind.rawValue, line: notRangeTok.line, column: notRangeTok.column)
		end 'notRange'
		let isUpto = self.at(TokenKind.upto)
		let rangeTok = self.current()
		self.advance()

		if self.isOpenBoundIdentifier(self.current(), marker: MaxBoundField) 'openBoth'
			self.advance()
			return self.emitLiteral(BoolTrueValue, valueType: MaxonType.boolean, range: SourceRange.ofToken(rangeTok))
		end 'openBoth'

		let hi = try self.emitPatternValue(scrutTag)
		return try self.emitCompare(scrut, rhs: hi, op: self.rangeUpperCmpOp(isUpto), opTok: rangeTok)
	end 'emitOpenLowerRange'

	// `lo to/upto <hi>` where `lo` is already emitted — a two-compare AND, or (`lo to max`) just the
	// lower compare.
	function emitClosedRange(scrut ValueId, scrutTag ValueTypeTag, loValue ValueId, isUpto bool, rangeTok Token) returns ValueId throws ParseError
		if self.isOpenBoundIdentifier(self.current(), marker: MaxBoundField) 'openUpper'
			self.advance()
			return try self.emitCompare(scrut, rhs: loValue, op: MaxonCmpOp.ge, opTok: rangeTok)
		end 'openUpper'

		let hi = try self.emitPatternValue(scrutTag)
		let loCmp = try self.emitCompare(scrut, rhs: loValue, op: MaxonCmpOp.ge, opTok: rangeTok)
		let hiCmp = try self.emitCompare(scrut, rhs: hi, op: self.rangeUpperCmpOp(isUpto), opTok: rangeTok)
		return try self.emitBinOp(loCmp, rhs: hiCmp, op: MaxonBinOp.bitAnd, opTok: rangeTok)
	end 'emitClosedRange'

	// The upper-bound comparison: `<` for `upto` (exclusive), `<=` for `to` (inclusive).
	function rangeUpperCmpOp(isUpto bool) returns MaxonCmpOp
		if isUpto 'exclusive'
			return MaxonCmpOp.lt
		end 'exclusive'
		return MaxonCmpOp.le
	end 'rangeUpperCmpOp'

	// Parse a pattern LITERAL (a value or a range bound): an optional `-`, then an int/float/bool/
	// character literal. Emits it and checks it is comparable to the scrutinee (E2028). A string
	// literal is E2028 (`"one"` on an `int` scrutinee); `min`/`max` are the caller's, not a value.
	function emitPatternValue(scrutTag ValueTypeTag) returns ValueId throws ParseError
		let firstTok = self.current()

		// A STRING LITERAL pattern — legal only against a `string` scrutinee (P1.2 wave A). Its
		// condition is `__str_eq(scrut, "literal")`: `emitPatternAtom`'s single-value path emits the
		// literal here and then `emitCompare(scrut, lo, eq)`, which — both operands `string` — routes to
		// the `__str_eq` runtime call, feeding the SAME bool the scalar `or`/`default`/expression-merge
		// machinery consumes for an integer pattern. So `match name { "alice" then … }` reuses the whole
		// scalar dispatch unchanged; only "what a pattern atom IS" differs. Against a NON-string
		// scrutinee it stays the E2028 mismatch (`"one"` on an `int`).
		if self.at(TokenKind.stringLiteral) 'stringPattern'
			if tagIsText(scrutTag) 'stringScrutinee'
				// A pattern is a COMPILE-TIME literal — an interpolation there has no meaning (there is
				// nothing to match a runtime-built string against), so it is rejected rather than built.
				if self.peekKind() == TokenKind.stringInterpStart 'interpolatedPattern'
					throw ParseError.unsupported("an interpolated string as a match pattern — a `match` pattern must be a compile-time string literal", line: firstTok.line, column: firstTok.column)
				end 'interpolatedPattern'
				return try self.consumeStringLiteralValue()
			end 'stringScrutinee'
			throw ParseError.matchPatternTypeMismatch("String", scrutineeType: typeTagName(scrutTag), line: firstTok.line, column: firstTok.column)
		end 'stringPattern'

		if self.at(TokenKind.minus) 'negated'
			try self.consume(TokenKind.minus)
			let negValue = try self.emitNegatedPatternValue(firstTok)
			return try self.checkPatternType(negValue, scrutTag: scrutTag, patternTok: firstTok)
		end 'negated'

		if self.at(TokenKind.intLiteral) 'intPattern'
			let intValue = try self.parseIntLiteral()
			return try self.checkPatternType(intValue, scrutTag: scrutTag, patternTok: firstTok)
		end 'intPattern'

		if self.at(TokenKind.floatLiteral) 'floatPattern'
			let floatValue = try self.parseFloatLiteral()
			return try self.checkPatternType(floatValue, scrutTag: scrutTag, patternTok: firstTok)
		end 'floatPattern'

		if self.at(TokenKind.true) or self.at(TokenKind.false) 'boolPattern'
			let boolValue = try self.parseBoolLiteral()
			return try self.checkPatternType(boolValue, scrutTag: scrutTag, patternTok: firstTok)
		end 'boolPattern'

		if self.at(TokenKind.charLiteral) 'charPattern'
			let charValue = try self.parseCharLiteral()
			return try self.checkPatternType(charValue, scrutTag: scrutTag, patternTok: firstTok)
		end 'charPattern'

		// A bare identifier (that is not `min`/`max`, handled by the caller) is an enum-case pattern.
		if self.at(TokenKind.identifier) 'enumCasePattern'
			throw ParseError.unsupported("a match pattern naming '{String.from(firstTok.value)}' (only literal, range, and 'or' patterns over a scalar are supported; enum-case patterns arrive in a later wave)", line: firstTok.line, column: firstTok.column)
		end 'enumCasePattern'

		throw ParseError.expectedExpression(firstTok.kind.rawValue, line: firstTok.line, column: firstTok.column)
	end 'emitPatternValue'

	// The value after a pattern's `-`: a negated int, or `0.0 - x` for a float. Any other token
	// after `-` has no numeric meaning to negate.
	function emitNegatedPatternValue(minusTok Token) returns ValueId throws ParseError
		if self.at(TokenKind.intLiteral) 'negInt'
			let tok = try self.consume(TokenKind.intLiteral)
			let v = try self.intLiteralValue(tok, negated: true)
			return self.emitLiteral(v, valueType: MaxonType.integer, range: SourceRange.ofToken(minusTok))
		end 'negInt'

		if self.at(TokenKind.floatLiteral) 'negFloat'
			let base = try self.parseFloatLiteral()
			return try self.emitFloatNegation(base, opTok: minusTok)
		end 'negFloat'

		let operandTok = self.current()
		throw ParseError.nonNumericNegation(operandTok.kind.rawValue, line: minusTok.line, column: minusTok.column)
	end 'emitNegatedPatternValue'

	// A pattern value must be comparable to the scrutinee — the same DOMAIN rule `emitCompare`
	// applies, asked HERE so the failure is the match-specific E2028 rather than the comparison's
	// E3005. `emitCompare` therefore never rejects a pattern it is handed.
	function checkPatternType(value ValueId, scrutTag ValueTypeTag, patternTok Token) returns ValueId throws ParseError
		let valTag = self.tagOf(value)
		if not comparableOperands(scrutTag, right: valTag) 'mismatch'
			throw ParseError.matchPatternTypeMismatch(typeTagName(valTag), scrutineeType: typeTagName(scrutTag), line: patternTok.line, column: patternTok.column)
		end 'mismatch'
		return value
	end 'checkPatternType'

	// Record a single-value pattern for duplicate detection, or raise E2027 if it repeats one. Only
	// KNOWN-constant patterns (integer literals) participate; a float literal's bits are not tracked
	// as a constant (see `parseFloatLiteral`), and no corpus case tests a duplicate float.
	function checkAndRecordDuplicate(value ValueId, seenValues ParsedIntArray, patternTok Token) throws ParseError
		if not self.constIsKnown(value) 'notConst'
			return
		end 'notConst'

		let folded = self.constOf(value)
		for i in 0 upto seenValues.count() 'seen'
			let prev = try seenValues.get(i) otherwise panic("checkAndRecordDuplicate: seenValues.get OOB at {i}")
			if prev == folded 'duplicate'
				throw ParseError.matchDuplicatePattern("{folded}", line: patternTok.line, column: patternTok.column)
			end 'duplicate'
		end 'seen'
		seenValues.push(folded)
	end 'checkAndRecordDuplicate'

	// Does `tok` name an open range bound (`min` / `max`) — an identifier whose text is the marker?
	// `min`/`max` lex as identifiers (they are not keywords), and appear only in a range, so their
	// text alone decides it. The bound-field constants spell the same two words the ranged-typealias
	// `.min` / `.max` do, deliberately: it is one lexical fact, not two.
	function isOpenBoundIdentifier(tok Token, marker ByteArray) returns bool
		return tok.kind == TokenKind.identifier and tok.value.equals(marker)
	end 'isOpenBoundIdentifier'

	// ============================================================================================
	// ENUM `match` — case-name patterns + the OPEN #21 range rule (P1.1b wave B).
	//
	// Everything here feeds the SAME dispatch engine the scalar match uses (`parseMatchCommon`'s arm
	// loop, `condBranch` chain and merge): the only difference is that a pattern is a case NAME
	// resolved to a tag rather than a literal, and that coverage is a bitmap over the case set rather
	// than a default arm. NO new IR op — a case compare is the same `compare`/`condBranch` a scalar
	// arm emits.
	// ============================================================================================

	// The enum/union a match scrutinee belongs to, or `undeclared` for a scalar scrutinee. Read from
	// the scrutinee's TYPE — a `named(X)` value whose name is in the enum registry — so it works
	// uniformly for a parameter (`c Code`), a local (`let c = Color.red`) and a returned enum. The
	// enum's own name is on the value even after TypeResolution collapses the SIGNATURE type to
	// `integer`, because a value's tag is set by the parser and never rewritten.
	function enumMatchFor(scrut ValueId) returns DeclaredEnum
		if self.tagOf(scrut) != ValueTypeTag.named 'notNamed'
			return DeclaredEnum.undeclared
		end 'notNamed'
		let nameId = try self.valueNameIds.get(scrut) otherwise panic("enumMatchFor: value v{scrut} has no recorded type name — the two type columns fell out of lockstep")
		let name = try self.artifact.typeNames.nameOf(nameId) otherwise panic("enumMatchFor: type-name id {nameId} is not in this file's interner — every `named` tag is minted with an id from it")
		return self.signatures.enumOf(name)
	end 'enumMatchFor'

	// One arm's enum pattern as a single boolean, OR-folding alternatives (`red or blue`) exactly as
	// the scalar path does — a bitwise `or` over the `bool`s, eager because a pattern has no side
	// effects.
	function emitEnumPatternCondition(scrut ValueId, layout EnumLayout, covered BoolArray) returns ValueId throws ParseError
		var cond = try self.emitEnumPatternAtom(scrut, layout: layout, covered: covered)
		while self.at(TokenKind.or) 'orChain'
			let orTok = try self.consume(TokenKind.or)
			let rhs = try self.emitEnumPatternAtom(scrut, layout: layout, covered: covered)
			cond = try self.emitBinOp(cond, rhs: rhs, op: MaxonBinOp.bitOr, opTok: orTok)
		end 'orChain'
		return cond
	end 'emitEnumPatternCondition'

	// One alternative: a single case (`red`) or a case-name range (`low to high`, `low upto high`).
	function emitEnumPatternAtom(scrut ValueId, layout EnumLayout, covered BoolArray) returns ValueId throws ParseError
		let patternTok = self.current()
		let lowIndex = try self.resolveEnumArmCase(layout)

		if self.at(TokenKind.to) or self.at(TokenKind.upto) 'rangeArm'
			let isUpto = self.at(TokenKind.upto)
			self.advance()
			let highIndex = try self.resolveEnumArmCase(layout)
			return try self.emitEnumRange(scrut, layout: layout, lowIndex: lowIndex, highIndex: highIndex, isUpto: isUpto, covered: covered, patternTok: patternTok)
		end 'rangeArm'

		try self.markEnumCovered(covered, index: lowIndex, layout: layout, patternTok: patternTok)
		return try self.emitEnumTagCompare(scrut, layout: layout, index: lowIndex, opTok: patternTok)
	end 'emitEnumPatternAtom'

	// The declaration index of the case named by `nameTok`, or E3034 (unknown case) positioned at
	// `posTok`. THE one emitter of "this name is not a case of this enum" — a `Color.red` literal
	// anchors it at the TYPE name and a match arm at the CASE name, so the POSITION is the caller's to
	// pass, but the lookup and the diagnostic are shared so the two sites cannot drift on either.
	function enumCaseIndexOrThrow(layout EnumLayout, nameTok Token, posTok Token) returns CaseIndex throws ParseError
		let index = layout.indexOfCase(nameTok.value)
		if index >= layout.caseCount() 'unknownCase'
			throw ParseError.enumUnknownCase(layout.kindWord(), caseName: String.from(nameTok.value), line: posTok.line, column: posTok.column)
		end 'unknownCase'
		return index
	end 'enumCaseIndexOrThrow'

	// Resolve a case NAME in a match arm to its declaration index. A QUALIFIED name (`Color.red`) is
	// E3075 — the scrutinee's enum is already known, so the bare name suffices — positioned at the
	// type name (the bootstrap's anchor). An unknown case is E3034, at the case name.
	function resolveEnumArmCase(layout EnumLayout) returns CaseIndex throws ParseError
		let caseTok = self.current()
		if not tokenNamesEnumCase(caseTok) 'notACaseName'
			throw ParseError.expectedExpression(caseTok.kind.rawValue, line: caseTok.line, column: caseTok.column)
		end 'notACaseName'

		if self.kindAt(self.pos + 1) == TokenKind.dot 'qualified'
			self.advance()
			try self.consume(TokenKind.dot)
			let realCaseTok = self.current()
			throw ParseError.matchQualifiedCaseName(String.from(realCaseTok.value), qualified: "{String.from(caseTok.value)}.{String.from(realCaseTok.value)}", line: caseTok.line, column: caseTok.column)
		end 'qualified'

		self.advance()
		return try self.enumCaseIndexOrThrow(layout, nameTok: caseTok, posTok: caseTok)
	end 'resolveEnumArmCase'

	// Mark case `index` covered, or raise E2027 if a prior arm already covered it. The overlap is
	// positioned at the CURRENT arm's pattern token (`patternTok`), naming the case that collides —
	// the bootstrap's exact anchor and message.
	function markEnumCovered(covered BoolArray, index CaseIndex, layout EnumLayout, patternTok Token) throws ParseError
		let already = try covered.get(index) otherwise panic("markEnumCovered: covered.get OOB at {index} — the bitmap is sized to the enum's case count")
		if already 'overlap'
			throw ParseError.matchOverlappingCase(String.from(layout.caseNameAt(index)), line: patternTok.line, column: patternTok.column)
		end 'overlap'
		try covered.set(index, value: true) otherwise panic("markEnumCovered: covered.set OOB at {index}")
	end 'markEnumCovered'

	// `scrut == tag(index)` — one case's compare, the same `compare` a bare scalar pattern emits. The
	// tag literal is `integer`-typed (a plain number): the scrutinee is `named` (→ i64) and the tag
	// i64, so the compare is an i64 equality, for an int backing and a float backing alike (a float
	// tag IS its bit pattern — see EnumLayout).
	function emitEnumTagCompare(scrut ValueId, layout EnumLayout, index CaseIndex, opTok Token) returns ValueId throws ParseError
		let tagLit = self.emitLiteral(layout.tagOfIndex(index), valueType: MaxonType.integer, range: SourceRange.ofToken(opTok))
		return try self.emitCompare(scrut, rhs: tagLit, op: MaxonCmpOp.eq, opTok: opTok)
	end 'emitEnumTagCompare'

	// ⭐⭐⭐ THE OPEN #21 RANGE RULE. A range arm `low to high` MEANS the OR of the cases it covers,
	// selected BY DECLARATION INDEX — the slice `[indexOfCase(low), indexOfCase(high)]` (`upto` drops
	// the upper). It is NOT a raw-value range over the tags.
	//
	// The optimization (and the trap): emit a two-compare TAG range `[min tag, max tag]` over the
	// covered set ONLY where no UNCOVERED case's tag falls inside that closed interval; otherwise the
	// OR of the covered cases (one `== tag` each). For an auto-increment enum the tags equal the
	// indices, so the covered span is contiguous and the range always fits; explicit out-of-order
	// tags (`ok = 500  notFound = 200` spanning [200,500] over an uncovered `serverError = 404`) are
	// where the OR is forced. The synthesized bounds are the real min/max TAGS, so they are inclusive
	// and `upto` is already accounted for by which cases the slice covers.
	function emitEnumRange(scrut ValueId, layout EnumLayout, lowIndex CaseIndex, highIndex CaseIndex, isUpto bool, covered BoolArray, patternTok Token) returns ValueId throws ParseError
		// An empty range: `upto` whose upper is at or before the lower, or a reversed `to` (upper
		// declared before lower). Computed before `lastCovered` so its subtraction cannot underflow.
		let coversNothing = (isUpto and highIndex <= lowIndex) or ((not isUpto) and highIndex < lowIndex)
		if coversNothing 'empty'
			throw ParseError.matchEmptyRange(String.from(layout.caseNameAt(lowIndex)), high: String.from(layout.caseNameAt(highIndex)), line: patternTok.line, column: patternTok.column)
		end 'empty'

		let lastCovered = (highIndex - 1) if isUpto else highIndex

		// Mark the covered slice (overlap-checked) and gather the min/max TAG over it.
		var loTag = layout.tagOfIndex(lowIndex)
		var hiTag = loTag
		var i = lowIndex
		while i <= lastCovered 'coverEach'
			try self.markEnumCovered(covered, index: i, layout: layout, patternTok: patternTok)
			let t = layout.tagOfIndex(i)
			if t < loTag 'newLo'
				loTag = t
			end 'newLo'
			if t > hiTag 'newHi'
				hiTag = t
			end 'newHi'
			i = i + 1
		end 'coverEach'

		if self.tagRangeCovers(layout, lowIndex: lowIndex, lastCovered: lastCovered, loTag: loTag, hiTag: hiTag) 'expressibleAsRange'
			let loLit = self.emitLiteral(loTag, valueType: MaxonType.integer, range: SourceRange.ofToken(patternTok))
			let hiLit = self.emitLiteral(hiTag, valueType: MaxonType.integer, range: SourceRange.ofToken(patternTok))
			let loCmp = try self.emitCompare(scrut, rhs: loLit, op: MaxonCmpOp.ge, opTok: patternTok)
			let hiCmp = try self.emitCompare(scrut, rhs: hiLit, op: MaxonCmpOp.le, opTok: patternTok)
			return try self.emitBinOp(loCmp, rhs: hiCmp, op: MaxonBinOp.bitAnd, opTok: patternTok)
		end 'expressibleAsRange'

		// The OR of the covered cases — the same path a bare case name takes, one compare each.
		var cond = try self.emitEnumTagCompare(scrut, layout: layout, index: lowIndex, opTok: patternTok)
		var j = lowIndex + 1
		while j <= lastCovered 'orEach'
			let rhs = try self.emitEnumTagCompare(scrut, layout: layout, index: j, opTok: patternTok)
			cond = try self.emitBinOp(cond, rhs: rhs, op: MaxonBinOp.bitOr, opTok: patternTok)
			j = j + 1
		end 'orEach'
		return cond
	end 'emitEnumRange'

	// Is a two-compare tag range `[loTag, hiTag]` faithful to the covered slice — i.e. does NO
	// uncovered case's tag fall inside that closed interval? The predicate at the heart of OPEN #21:
	// where it holds, `serverError`'s 404 does not sit between `ok`'s 500 and `notFound`'s 200, so the
	// range means exactly the covered set and is safe to emit; where it fails, the OR is forced.
	function tagRangeCovers(layout EnumLayout, lowIndex CaseIndex, lastCovered CaseIndex, loTag ParsedInt, hiTag ParsedInt) returns bool
		for j in 0 upto layout.caseCount() 'eachCase'
			if j >= lowIndex and j <= lastCovered 'isCovered'
				continue
			end 'isCovered'
			let t = layout.tagOfIndex(j)
			if t >= loTag and t <= hiTag 'insideInterval'
				return false
			end 'insideInterval'
		end 'eachCase'
		return true
	end 'tagRangeCovers'

	// An enum match must cover EVERY case. The uncovered ones (in declaration order) become E2026's
	// `missing:` list, positioned at the closing `end` — the enum twin of the scalar exhaustiveness
	// gate, and the mechanism that makes adding a case force every match site to handle it.
	function checkEnumExhaustive(layout EnumLayout, covered BoolArray) throws ParseError
		var missing = ""
		var hasMissing = false
		for i in 0 upto layout.caseCount() 'eachCase'
			let isCovered = try covered.get(i) otherwise panic("checkEnumExhaustive: covered.get OOB at {i} — the bitmap is sized to the enum's case count")
			if not isCovered 'uncovered'
				if hasMissing 'notFirst'
					missing = "{missing}, {String.from(layout.caseNameAt(i))}"
				end 'notFirst' else 'first'
					missing = String.from(layout.caseNameAt(i))
				end 'first'
				hasMissing = true
			end 'uncovered'
		end 'eachCase'

		if hasMissing 'incomplete'
			let endTok = self.current()
			throw ParseError.enumMatchNotExhaustive(layout.kindWord(), typeName: String.from(layout.name), missing: missing, line: endTok.line, column: endTok.column)
		end 'incomplete'
	end 'checkEnumExhaustive'

	// Mint a phi (block-arg) on `block` and return its fresh ValueId. The ONE mint site for
	// every merge phi the parser makes — if-continuation, loop header, loop exit, and (new
	// at P1.0d.2) the short-circuit merge — so a phi's Maxon-tier type is recorded in
	// lockstep with its id at all four.
	//
	// The `argType` passed here is a PLACEHOLDER, overwritten before anything reads it:
	// `LowerMaxonToStd.retypeBlockArgs` is the authority and sets every phi's Std type from the tag
	// column (it explains why the parser is the wrong tier to decide it). A phi's Maxon-tier type is
	// the `tag` recorded below, and that is the only type this function knows.
	//
	// ⚠ NOTHING OVERWROTE IT UNTIL P1.0d.4, AND THAT WAS A COMPILER CRASH: a hardcoded `i64` was
	// harmless only while every value lived in a GPR, and the day `argType` chose a phi's REGISTER
	// FILE, a float phi was coloured into a GPR and the SSA-destruction copy panicked the x64
	// emitter. See `float-phi-*` in specs-shv2/float-type.md.
	function mintPhi(block IrBlock, tag ValueTypeTag, nameId TypeNameId) returns ValueId
		let phiId = self.mintValue(tag, nameId: nameId)
		block.blockArgs.push(IrBlockArg.create(phiId, argType: StdType.i64))
		return phiId
	end 'mintPhi'

	// The phi a MERGED BINDING carries: its type is the binding's declared one, which the
	// binding already holds as a `MaxonType`, so decomposing it constructs nothing.
	function mintPhiForBinding(block IrBlock, binding VarInfo) returns ValueId
		return self.mintPhi(block, tag: maxonTypeTag(binding.varType), nameId: typeNameIdOf(binding.varType))
	end 'mintPhiForBinding'

	// Allocate a fresh ValueId AND record its source-level type, in lockstep. THE only way
	// the parser mints a value: the type columns are dense by ValueId, so an id allocated
	// without a type would shift every later value's type by one — a silent misclassification
	// of every operator that dispatches on type. Splitting the two would make that possible;
	// this makes it impossible.
	//
	// Takes a TAG (plus the name id a `named` type carries), never a `MaxonType`: constructing
	// a union ALLOCATES, and this is the per-VALUE path. `mintValueOfType` is the door for a
	// caller that already holds a `MaxonType` and so constructs nothing new.
	function mintValue(tag ValueTypeTag, nameId TypeNameId) returns ValueId
		let id = allocValueId(self.valueIds)
		self.valueTags.push(tag)
		self.valueNameIds.push(nameId)
		// The constant columns move in the same lockstep, seeded UNKNOWN. A value's constant is
		// discovered by the op that DEFINES it, which is emitted after its id is minted — so the
		// slot must exist first, and the emitter overwrites it (`recordConst`).
		self.valueConsts.push(0)
		self.valueConstKnown.push(false)
		// Owned-heap provenance rides the same lockstep: seeded NOT owned, set true by `trackOwnedTemp`
		// on the one value an interpolation allocates. The slot must exist before that call, exactly as
		// the constant slot must exist before `recordConst`.
		self.valueOwnsHeap.push(false)
		return id
	end 'mintValue'

	// Mint a value whose type is already in hand as a `MaxonType` — a `literal` op's type (the
	// op stores one anyway), a call's declared return type. It DECOMPOSES an existing union
	// rather than constructing a new one, so it allocates nothing either.
	function mintValueOfType(valueType MaxonType) returns ValueId
		return self.mintValue(maxonTypeTag(valueType), nameId: typeNameIdOf(valueType))
	end 'mintValueOfType'

	// Append a value's type to the columns WITHOUT allocating an id — for the parameters,
	// whose ids (0..paramCount-1) the value numbering RESERVED rather than minted.
	function recordValueType(valueType MaxonType)
		self.valueTags.push(maxonTypeTag(valueType))
		self.valueNameIds.push(typeNameIdOf(valueType))
		// A parameter's value is the one thing the compiler provably cannot see.
		self.valueConsts.push(0)
		self.valueConstKnown.push(false)
		// A parameter is never a fresh interpolation result, so it starts NOT owned — but its slot must
		// exist so the column stays indexable by every ValueId, params included.
		self.valueOwnsHeap.push(false)
	end 'recordValueType'

	// Remember the integer behind a value the parser has just DEFINED. Called by the emitters, on
	// the id they minted a moment ago, so the slot is always there.
	function recordConst(id ValueId, folded ParsedInt)
		try self.valueConsts.set(id, value: folded) otherwise panic("Parser.recordConst: value v{id} has no constant slot — every SSA value must be minted through mintValue")
		try self.valueConstKnown.set(id, value: true) otherwise panic("Parser.recordConst: value v{id} has no constant slot — every SSA value must be minted through mintValue")
	end 'recordConst'

	// True iff the compiler holds `id`'s integer.
	function constIsKnown(id ValueId) returns bool
		return try self.valueConstKnown.get(id) otherwise panic("Parser.constIsKnown: value v{id} has no constant slot — every SSA value must be minted through mintValue")
	end 'constIsKnown'

	// The integer behind `id`. Only meaningful when `constIsKnown(id)` — asking otherwise is a
	// caller bug, and handing back the unseeded 0 as if it were a real constant is exactly the
	// wrong answer a sentinel would give, so it panics instead.
	function constOf(id ValueId) returns ParsedInt
		if not self.constIsKnown(id) 'unknown'
			panic("Parser.constOf: value v{id} is not a known constant — guard the call with constIsKnown")
		end 'unknown'

		return try self.valueConsts.get(id) otherwise panic("Parser.constOf: value v{id} has no constant slot — every SSA value must be minted through mintValue")
	end 'constOf'

	// Record a fold's result, if it produced one. `notFoldable` is a DECISION and not a gap — the
	// folder declined an operator whose answer is a diagnostic rather than a number — so the value
	// simply stays unknown, and the guard downstream handles it.
	function recordFold(id ValueId, fold FoldedInt)
		match fold 'f'
			folded(value) then self.recordConst(id, folded: value)
			notFoldable then return
		end 'f'
	end 'recordFold'

	// The TAG of an SSA value's type — the hot read, and the only thing the operator rules
	// need. Every value the parser mints has one (the parameters are seeded from their
	// declarations, `mintValue` records the rest), so a miss is a parser invariant break.
	function tagOf(value ValueId) returns ValueTypeTag
		return try self.valueTags.get(value) otherwise panic("Parser.tagOf: value v{value} has no recorded type — every SSA value must be minted through mintValue")
	end 'tagOf'

	// **IS THIS VALUE'S TYPE UNSIGNED?** The question THE SHIFT RULE asks of a shift's LEFT operand,
	// and the only thing that decides whether `shr` fills with the sign or with zeros. Exhaustive
	// over `ValueTypeTag`, so a new type cannot be added without being placed on one side of it.
	//
	//   • `named`    — a ranged typealias, and unsigned exactly when its LOW BOUND is 0 or above
	//                  (`rangeIsUnsigned`). The alias is looked up in the WHOLE-PROGRAM declaration
	//                  index, never in this file's artifact: an alias declared in another file is
	//                  still an unsigned type here, and a file-local table would answer "signed" and
	//                  emit the wrong instruction. It is order-independent within a file too, which
	//                  the artifact table — filled as declarations are parsed — would not be.
	//   • `exitCode` — `int(0 to u32.max)`. Unsigned, by the same low-bound rule its range would
	//                  give if it were spelled as one.
	//   • `integer`  — a bare `int` is `i64.min to i64.max`. SIGNED, and it is the default every
	//                  shift in the language sign-fills under.
	//   • the rest   — not a number, so not a shift operand at all: `requireBinOpOperands` has
	//                  already rejected the program, and `emitShift` asks it BEFORE this is reached.
	//                  Answering "signed" costs nothing, because no code is kept.
	function valueIsUnsigned(value ValueId) returns bool
		let tag = self.tagOf(value)
		if tag == ValueTypeTag.exitCode 'exitCode'
			return true
		end 'exitCode'

		if tag != ValueTypeTag.named 'notAnAlias'
			return false
		end 'notAnAlias'

		let nameId = try self.valueNameIds.get(value) otherwise panic("Parser.valueIsUnsigned: value v{value} has no recorded type name — the two type columns fell out of lockstep")
		let name = try self.artifact.typeNames.nameOf(nameId) otherwise panic("Parser.valueIsUnsigned: type-name id {nameId} is not in this file's interner — every `named` tag is minted with an id from it")

		// An alias NO file declares is a user error (E3011, reported by TypeResolution against the
		// merged registry, which is the authority). It is not this rule's to report — the sweep is
		// deliberately tolerant — and the program is rejected before anything emitted here can run,
		// so "signed" is the harmless reading and never a silent wrong answer.
		return match self.signatures.aliasOf(name) 'a'
			declared(alias) gives rangeIsUnsigned(alias.low)
			undeclared gives false
		end 'a'
	end 'valueIsUnsigned'

	// The full `MaxonType` of an SSA value, REBUILT from the two columns. It CONSTRUCTS a
	// union, so it allocates — which is why it is called only where a `MaxonType` is genuinely
	// STORED (a binding's declared type), and never on a per-value or per-operator path.
	function typeOf(value ValueId) returns MaxonType
		let nameId = try self.valueNameIds.get(value) otherwise panic("Parser.typeOf: value v{value} has no recorded type name — the two type columns fell out of lockstep")
		return maxonTypeOfTag(self.tagOf(value), nameId: nameId)
	end 'typeOf'

	// Record the block-arg values `block` passes to `targetId` for the Std-tier
	// phi-elim pass. A branch op carries only the target BlockId, so the per-edge phi
	// operands live on the predecessor's `branchEdges` (see IrBlock). An empty list
	// means the target has no phis — nothing to record.
	function recordBranchEdge(block IrBlock, targetId BlockId, argIds ValueIdArray)
		if argIds.count() == 0 'noArgs'
			return
		end 'noArgs'
		block.branchEdges.push(BranchEdge.create(targetId, argIds: argIds))
	end 'recordBranchEdge'

	// Create + register a fresh block in `func`, filling the source footprint from the
	// parser's own file/position so the four `if` block-creation sites don't each
	// respell it.
	function newBlock(func IrFunction, label ByteArray, line LineNumber) returns IrBlock
		return self.artifact.module.addBlockAt(func, label: label, filePath: self.filePath.toString(), firstLine: line)
	end 'newBlock'

	// Set `block`'s terminator to a two-way conditional branch, anchored on the `if`
	// keyword's span.
	function emitCondBranch(block IrBlock, cond ValueId, thenId BlockId, elseId BlockId, ifTok Token)
		self.artifact.emitTerminator(block, op: MaxonOp.condBranch(cond, thenBlockId: thenId, elseBlockId: elseId), range: SourceRange.ofToken(ifTok))
	end 'emitCondBranch'

	// Set `block`'s terminator to an unconditional branch. The branch is synthetic (no
	// source token spawned it — it is the compiler wiring a fall-through), so it carries
	// the positionless `SourceRange.none()`.
	function emitBranch(block IrBlock, targetId BlockId)
		self.artifact.emitTerminator(block, op: MaxonOp.branch(targetId), range: SourceRange.none())
	end 'emitBranch'

	// Expression entry — EVERY value context: a `let`/`var` initializer, an assignment's
	// right-hand side, a `return` value, a call argument, an `if`/`while` CONDITION, the
	// inside of a parenthesis. There is ONE GRAMMAR for all of them.
	//
	// A condition once had its own, FLATTER grammar (`operand [cmpOp operand]`, operands parsed
	// at additive precedence), for exactly one reason — a comparison could only be consumed by
	// a branch, because the backend had no way to write a boolean into a register. Two things
	// ended that. `setcc` gives it one (`let r = 5 > 3` compiles), and `and`/`or` bind LOOSER
	// than comparison, so `if a > 0 and b > 0` cannot even be expressed by a grammar whose top
	// level is a single comparison. One climber, one set of precedences, and a condition is
	// simply an expression that happens to feed a branch — plus a TYPE rule, which is
	// `parseBoolCondition` below, not a second grammar.
	//
	// Seeds `currentBlock`, which every emit below targets — see the field.
	function parseExpression(func IrFunction, block IrBlock) returns ValueId throws ParseError
		self.currentBlock = block
		return try self.parseBinary(func, minPrec: OrPrecedence)
	end 'parseExpression'

	// An `if` / `while` condition: an ordinary expression that must have type `bool`.
	//
	// **MAXON HAS NO C-STYLE TRUTHINESS.** `if 4` is not "if 4 is nonzero" — it is a type
	// error, and the ONLY tier that can say so is this one, because it is the only one holding
	// the expression's source type. The x64 lowering tests a non-fused condition with
	// `cmp reg, 0` + `jne`, which is exactly right for a bool (a bool IS 0 or 1, and a call
	// result, a parameter or a merge phi has no flags to fuse) — and is precisely why an `int`
	// condition silently "worked", branching on `n != 0`. The instruction cannot tell the two
	// apart. The type can.
	//
	// An `unresolved` condition is ADMITTED, not rejected: a cross-file callee's return type is
	// not known here, and `if isReady()` must compile. `typeClassAdmits` defers on `unknown`.
	//
	// The diagnostic anchors on the CONDITION's first token, not on the keyword: the message is
	// about the expression's type, and that is where the reader has to look — an `if` whose
	// condition spans three lines should not point at the `if`.
	function parseBoolCondition(func IrFunction, block IrBlock, kwTok Token) returns ValueId throws ParseError
		let condTok = self.current()
		let cond = try self.parseExpression(func, block: block)

		let condTag = self.tagOf(cond)
		if not typeClassAdmits(TypeClass.boolean, tag: condTag) 'notABool'
			throw ParseError.nonBoolCondition(kwTok.kind.rawValue, got: typeTagName(condTag), line: condTok.line, column: condTok.column)
		end 'notABool'

		return cond
	end 'parseBoolCondition'

	// The precedence-climbing core. Parse a unary/primary operand, then while the next token
	// is a binary operator whose precedence is >= `minPrec`, consume it and recurse for the
	// right operand at `precedence + 1` (which makes the operator LEFT-associative). A
	// supported operator below `minPrec`, a non-operator, or the end of the expression stops
	// the climb.
	//
	// THREE dispatches, and the middle one is the whole rung:
	//
	//   1. a SHORT-CIRCUIT `and`/`or` over a bool left operand ⇒ not an op at all. It becomes
	//      blocks and a merge phi, and it MOVES `currentBlock` (see emitShortCircuit), which
	//      is why `left`'s block is re-read from the field after every recursive call.
	//   2. a comparison ⇒ `MaxonOp.compare`, typed `boolean`.
	//   3. everything else ⇒ `MaxonOp.binOp`. This is where a bitwise `and`/`or`/`xor` lands:
	//      the short-circuit test above did not fire, so the operands are not bools, and on
	//      integers the word operators ARE the bit operators.
	//
	// No arm rejects anything any more. The old "a comparison is not a value" throw is gone
	// with the machinery that forced it.
	function parseBinary(func IrFunction, minPrec InfixPrecedence) returns ValueId throws ParseError
		var left = try self.parseUnary(func)

		while true 'climb'
			let opTok = self.current()

			let prec = infixPrecedence(opTok.kind)
			if prec == NotAnInfixOperator or prec < minPrec 'stop'
				break
			end 'stop'

			// `and fallthrough` ends a match arm's body — it is the fallthrough SUFFIX, not a
			// bitwise `and`. `fallthrough` is a keyword and can never be a variable, so `and
			// fallthrough` has no reading as an expression ANYWHERE in the language; stopping the
			// climb here hands the suffix intact to the match arm parser (P1.1b wave A), which either
			// consumes it or — in a match EXPRESSION arm — rejects the stray `and` (E2001). No mode
			// flag is needed precisely because the pairing is unambiguous everywhere.
			if opTok.kind == TokenKind.and and self.peekKind() == TokenKind.fallthrough 'fallthroughSuffix'
				break
			end 'fallthroughSuffix'

			// The short-circuit test reads the LEFT operand's type only, and reads it BEFORE
			// the right operand is parsed — it has to, because whether the right operand is
			// evaluated AT ALL is the thing being decided. (v1 gates identically:
			// Parser.maxon:11384.)
			if shortCircuitOperator(opTok.kind) and tagIsBool(self.tagOf(left)) 'shortCircuit'
				self.advance()
				left = try self.emitShortCircuit(func, leftValue: left, opTok: opTok, rhsMinPrec: prec + 1)
				continue
			end 'shortCircuit'

			self.advance()
			// The right operand's token span, remembered BEFORE it is parsed and read back after.
			// It is not what the shift rule ASKS — that is the constant folder's job — but it is
			// where E2054 POINTS, and the climber has already decided how far the operand reaches.
			let rhsStart = self.pos
			let right = try self.parseBinary(func, minPrec: prec + 1)
			let rhsEnd = self.pos

			if comparisonOperator(opTok.kind) 'comparison'
				left = try self.emitCompare(left, rhs: right, op: infixCmpOp(opTok.kind), opTok: opTok)
				continue
			end 'comparison'

			let op = infixMaxonOp(opTok.kind)

			// A shift's right operand is not an ordinary number but a DISTANCE, and Maxon's rule
			// for it (Go's) is deliberately not the hardware's. It gets its own emitter, which
			// owns the rule, the diagnostic, AND the runtime guard. See `emitShift`.
			if shiftOperator(op) 'isShift'
				left = try self.emitShift(left, count: right, op: op, opTok: opTok, countStart: rhsStart, countEnd: rhsEnd)
				continue
			end 'isShift'

			left = try self.emitBinOp(left, rhs: right, op: op, opTok: opTok)
		end 'climb'

		return left
	end 'parseBinary'

	// ⭐ Emit `lhs <op> count` under TypeRules' ⭐ THE SHIFT RULE — THE one place a source-level
	// shift is built. Two jobs, separate on purpose:
	//
	//   **LEGALITY.** A count the parser can FOLD is decided here: a negative one is E2054. A count
	//   of 64 or more is LEGAL and is NOT an error — it shifts every bit out — which is the whole
	//   narrowing of this diagnostic. A count the parser CANNOT fold is Go's runtime panic, which
	//   shv2 cannot raise yet; see `emitGuardedShift`.
	//
	//   **VALUE.** A folded count is rewritten into the shift its semantics define, so no count
	//   above `MaxUnguardedShiftCount` ever reaches codegen and the hardware's masking is never
	//   consulted. A count that could NOT be folded gets the GUARD, which saturates it at run time
	//   — to the SAME answer. That the two agree is not a coincidence: both are readings of
	//   `evalShift`.
	function emitShift(lhs ValueId, count ValueId, op MaxonBinOp, opTok Token, countStart TokenIndex, countEnd TokenIndex) returns ValueId throws ParseError
		// The SHIFT's OWN operand rule, asked BEFORE anything is emitted. `emitBinOp` would ask it
		// too, but by then the guard's ops are already in the IR — and the FIRST of them is an
		// `and`, so `4 shr flag` would be rejected as a bad `and` rather than as a bad `shr`
		// (E3005 for the wrong operator instead of E2004 for the right one). A rejected program
		// must also leave no ops behind.
		try requireBinOpOperands(op, left: self.tagOf(lhs), right: self.tagOf(count), opTok: opTok)

		// ⭐ THE SHIFT RULE's one question, asked ONCE, of the LEFT operand — and then CARRIED: to
		// the opcode, to the fold, and to the guard. Never re-derived, because the whole class of
		// bug this file has already paid for is two readers of one rule reaching two answers.
		let signFills = shiftFillsWithSign(op, leftOperandIsUnsigned: self.valueIsUnsigned(lhs))
		let shiftOp = shiftOpcodeFor(op, signFills: signFills)

		if not self.constIsKnown(count) 'dynamic'
			return try self.emitGuardedShift(lhs, count: count, op: shiftOp, opTok: opTok)
		end 'dynamic'

		let folded = self.constOf(count)
		if shiftCountIsNegative(folded) 'negative'
			// Constructed and thrown in ONE expression. A `throw self.someHelper(…)` — building the
			// error in a helper and throwing what it returns — LEAKS the boxed union under the
			// bootstrap's refcounting, which the suite's leak check catches as an extra stderr line.
			let anchor = self.shiftCountAnchor(countStart, countEnd: countEnd)
			throw ParseError.shiftCountNegative(folded, line: anchor.line, column: anchor.column)
		end 'negative'

		if not shiftCountIsUnguarded(folded) 'shiftedOut'
			// A count that shifts every bit out. There is no instruction for it — the hardware
			// would mask it straight back into range — so the compiler writes down what it MEANS.
			// A shift that fills with ZEROS (`shl`, and an unsigned `shrLogical`) leaves the constant
			// 0. One that fills with the SIGN leaves the sign, and `x shr 63` already IS the sign, so
			// it becomes a shift by `MaxUnguardedShiftCount`. Neither is the masked shift the
			// hardware would have performed (`x shl 64` == `x`, `x shl 100` == `x shl 36`).
			//
			// `lhs` keeps its ops either way: they may have side effects, and Go evaluates the
			// left operand of a shift whatever the count turns out to be.
			if not signFills 'zeroFill'
				return self.emitLiteral(0, valueType: MaxonType.integer, range: SourceRange.ofToken(opTok))
			end 'zeroFill'

			let clamped = self.emitLiteral(MaxUnguardedShiftCount, valueType: MaxonType.integer, range: SourceRange.ofToken(opTok))
			return try self.emitBinOp(lhs, rhs: clamped, op: shiftOp, opTok: opTok)
		end 'shiftedOut'

		// A count the instruction takes as written; the hardware's mask is a no-op on it. The
		// operand is emitted UNCHANGED — this compiler folds no constant expression INTO the IR
		// (`1 + 2` still emits an `add`; see FoldConstOperands' header), and a shift count that
		// folds to 3 is a shift by 3 whether it arrives as a literal or as an `add`.
		let result = try self.emitBinOp(lhs, rhs: count, op: shiftOp, opTok: opTok)

		// The shift's own value, when the parser holds both sides — RECORDED, not rewritten. It is
		// what makes `let A = 1 shl 4` a count that `x shl A` can see. It folds under the OPCODE the
		// rule already chose, so the constant recorded here and the instruction that opcode emits
		// cannot answer differently — there is one fact, not two.
		if self.constIsKnown(lhs) 'bothKnown'
			self.recordConst(result, folded: evalShift(self.constOf(lhs), count: folded, op: shiftOp))
		end 'bothKnown'

		return result
	end 'emitShift'

	// A shift whose count the compiler could NOT fold — the runtime half of THE SHIFT RULE, and
	// the half that has to fight the hardware.
	//
	// x64 masks a 64-bit shift's count to its low 6 bits, so the instruction cannot be handed the
	// count as written: `x shl 64` would compute `x shl 0` (x, UNCHANGED) and `x shl 100` would
	// compute `x shl 36`. The count is SATURATED first, by the same rule `evalShift` folds by, and
	// with only the ops the Maxon tier already has (there is no `cmov` and no select in this
	// compiler — see TargetDialect's op inventory):
	//
	//   outOfRange = (count and -64) != 0        — one `and` decides BOTH ends at once: a count is
	//                                              outside 0..63 exactly when a bit above the low 6
	//                                              is set, and a NEGATIVE count has its sign bit
	//                                              set, so it lands out-of-range too.
	//   mask       = (t or -t) shr 63            — an ARITHMETIC shr turns "t is non-zero" into
	//                                              all-ones, and "t is zero" into all-zeros.
	//   ZERO-FILL: (x <shift> count) and not mask   — `shl`, and an UNSIGNED `shrLogical`. Both
	//                                                 shift every bit out, so both saturate to 0.
	//   SIGN-FILL: x shr (count or mask)            — a signed `shr` saturates to the SIGN, and a
	//                                                 count of -1 masks to 63, which IS the sign.
	//
	// Which one applies is read off the OPCODE, which is where `emitShift` already wrote the answer:
	// `shr` is the arithmetic right shift by definition of the enum, and every other shift opcode
	// zero-fills. THE SHIFT RULE was asked once, of the left operand; this is not a second reading
	// of it but a reading of its result.
	//
	// Cost, on top of the shift: 4 ops for the mask, plus 2 (zero-fill) or 1 (sign-fill). Only a
	// count the compiler cannot see pays it — every `x shr 8` and `x shl 3` is folded and untouched.
	//
	// ⚠ TODO — Go PANICS on a negative count at run time ("if the shift count is negative at run
	// time, a run-time panic occurs"), and shv2 CANNOT: it has no panic runtime, no trap op, and
	// no fault handler (the emitted runtime is a 5-instruction entry stub). That is the first
	// slice of **Workstream R**, and **OPEN.md #2** — `a / 0` escaping as a raw 0xC0000094
	// hardware trap — needs the same slice and is blocked on the same thing. Until it lands, a
	// negative count here is NOT a wrong answer: the mask above reads it as out-of-range, so
	// `x shl -1` is 0 and `x shr -1` is the sign. That is defined, deterministic, and NOT the
	// masked `x shl 63` this rule exists to kill — it is simply not yet the panic Go requires.
	// `specs-shv2/bitwise-operators.md` carries the case as a `disabled-test:`, to be enabled by
	// the rung that lands the panic runtime.
	function emitGuardedShift(lhs ValueId, count ValueId, op MaxonBinOp, opTok Token) returns ValueId throws ParseError
		let range = SourceRange.ofToken(opTok)

		let outOfRangeBits = self.emitLiteral(0 - ShiftCountBits, valueType: MaxonType.integer, range: range)
		let bitsAboveCount = try self.emitBinOp(count, rhs: outOfRangeBits, op: MaxonBinOp.bitAnd, opTok: opTok)
		let negatedBits = self.emitUnaryOp(bitsAboveCount, op: MaxonUnaryOp.neg, resultTag: ValueTypeTag.integer, opTok: opTok)
		let signCarrier = try self.emitBinOp(bitsAboveCount, rhs: negatedBits, op: MaxonBinOp.bitOr, opTok: opTok)
		let signBit = self.emitLiteral(MaxUnguardedShiftCount, valueType: MaxonType.integer, range: range)
		// ARITHMETIC, and unconditionally so: this `shr` is not the user's shift but the MASK's, and
		// it works precisely BECAUSE it replicates the sign — `signCarrier shr 63` is all-ones when
		// the count is out of range and all-zeros when it is not. It is a fact about `signCarrier`
		// (a plain `int`, and therefore signed) and never about `lhs`, so the user's shift opcode has
		// no say in it.
		let mask = try self.emitBinOp(signCarrier, rhs: signBit, op: MaxonBinOp.shr, opTok: opTok)

		if op == MaxonBinOp.shr 'signFilling'
			// A count of -1 masks to 63 in the hardware, and `x shr 63` IS the sign — so saturating
			// a sign-filling shift is a CLAMP OF THE COUNT, and needs no select of the result.
			let saturatedCount = try self.emitBinOp(count, rhs: mask, op: MaxonBinOp.bitOr, opTok: opTok)
			return try self.emitBinOp(lhs, rhs: saturatedCount, op: op, opTok: opTok)
		end 'signFilling'

		// A zero-filling shift — `shl`, or an unsigned `shrLogical`. Both shift every bit out for
		// an out-of-range count, so both saturate to 0 by masking the RESULT. The shift itself is
		// `op`, which is why one branch now serves the two of them.
		let raw = try self.emitBinOp(lhs, rhs: count, op: op, opTok: opTok)
		let keep = self.emitUnaryOp(mask, op: MaxonUnaryOp.bitNot, resultTag: ValueTypeTag.integer, opTok: opTok)
		return try self.emitBinOp(raw, rhs: keep, op: MaxonBinOp.bitAnd, opTok: opTok)
	end 'emitGuardedShift'

	// WHERE E2054 POINTS: the first token of the count as WRITTEN. `x shl SHIFT` points at `SHIFT`,
	// where the programmer would look, and not at the `let` that gave it its value. Redundant
	// parentheses are not part of what was written, so `x shl (-1)` points at the `-1`.
	function shiftCountAnchor(countStart TokenIndex, countEnd TokenIndex) returns Token
		var lo = countStart
		var hi = countEnd

		while lo + 2 <= hi and self.kindAt(lo) == TokenKind.leftParen and self.kindAt(hi - 1) == TokenKind.rightParen 'stripParens'
			lo = lo + 1
			hi = hi - 1
		end 'stripParens'

		return self.tokenAt(lo)
	end 'shiftCountAnchor'

	// Lower a BOOL `and`/`or` to SHORT-CIRCUIT control flow — the point of this rung. `a and
	// b` must not evaluate `b` when `a` is false, so it is not an operator at all: it is a
	// branch, a block, and a merge phi, minted on the same on-the-fly SSA machinery `if` and
	// `while` mint theirs.
	//
	//     entry:  <lhs already evaluated>
	//             cond_br lhs ? rhs   : merge   -- `and`: a FALSE lhs skips the rhs
	//             cond_br lhs ? merge : rhs     -- `or` : a TRUE  lhs skips the rhs
	//     rhsEnd: <the rhs is evaluated HERE, and on no other path>
	//             br merge(rhsValue)
	//     merge:  phi <- [seed from entry] [rhsValue from rhsEnd]
	//
	// The SEED is the answer the skipped path already determined: `false` for `and`, `true`
	// for `or`. Ported from maxon-selfhosted's `emitShortCircuit`
	// (Parser.maxon:11718-11787), with two deliberate divergences:
	//
	//   1. v1 seeds a VAR SLOT, stores the rhs into it, and reloads it at the merge, because
	//      v1 has slots and a `mem2reg` to promote them. shv2 has neither — its parser IS
	//      the SSA constructor — so the merge value is a BLOCK ARG fed by each predecessor's
	//      branch edge. The same shape, one tier earlier and with no store/load round trip.
	//   2. v1 NEGATES the lhs for `or` (`xor lhs, 1`) so the "then" target is always the rhs,
	//      matching its jcc-to-else convention. shv2's `condBranch` names both targets and
	//      `lowerCondBranch` emits `jcc` + `jmp` for EVERY layout, so the targets are simply
	//      SWAPPED — exact, and free, where v1's negation costs a literal and an xor on every
	//      single `or`.
	//
	// The rhs block is created BEFORE the rhs is parsed and the merge block AFTER, so a
	// NESTED short-circuit inside the rhs slots its own blocks between them and `.text` still
	// lays out in evaluation order (v1 makes the same point).
	function emitShortCircuit(func IrFunction, leftValue ValueId, opTok Token, rhsMinPrec InfixPrecedence) returns ValueId throws ParseError
		// `var`, not `let`: the seed literal and the two-way branch are emitted INTO it, and
		// a `let` binding cannot be forwarded to a mutating parameter (E3019).
		var entry = self.currentBlock
		let range = SourceRange.ofToken(opTok)
		let takesRhsWhenTrue = opTok.kind == TokenKind.and

		// The value the SKIPPED path yields, materialized in the entry block: `false and _`
		// is false, `true or _` is true. It is the entry edge's phi operand.
		let seed = self.emitLiteralIn(entry, value: shortCircuitSeed(takesRhsWhenTrue), valueType: MaxonType.boolean, range: range)

		let rhsBlock = self.newBlock(func, label: shortCircuitLabel(takesRhsWhenTrue), line: opTok.line)
		self.currentBlock = rhsBlock
		let rhsValue = try self.parseBinary(func, minPrec: rhsMinPrec)
		// NOT `rhsBlock`: the rhs may itself have short-circuited (`a or b or c`), leaving
		// control in a merge block of its own. That is the block the value is defined in, and
		// the one that must branch here.
		var rhsEnd = self.currentBlock

		// The SHORT-CIRCUIT half of the same rule `emitBinOp` enforces — ASKED, not restated
		// (see `requireBinOpOperands`). The left operand is already known to be a bool: that is
		// what brought control here.
		let op = infixMaxonOp(opTok.kind)
		let rhsTag = self.tagOf(rhsValue)
		try requireBinOpOperands(op, left: ValueTypeTag.boolean, right: rhsTag, opTok: opTok)

		// The merge phi IS the operator's result, so its TAG is the operator's result type — and
		// it is ASKED of the same `binOpResultTag` the `binOp` path asks, not restated as a
		// literal `boolean` here. Restating it left a word operator's result type with TWO
		// deciders, one per path, and nothing making them agree: they answer the same thing today
		// only because a bool left operand makes `wordOpResultTag`'s first arm fire for every rhs
		// that survives the check above. The day that rule changes — deferring on an `unresolved`
		// rhs, say (see TypeRules' `wordOpResultTag`, and the cross-file gap in
		// `calleeResultType`) — the `binOp` path would move and this one would go on ASSERTING
		// `boolean` about a value it cannot type. A wrong tag is not a compile error; it is a
		// wrong answer at whatever reads the tag next, which is every rule this rung added.
		let resultTag = binOpResultTag(op, left: ValueTypeTag.boolean, right: rhsTag)

		var merge = self.newBlock(func, label: b"scmerge", line: opTok.line)
		let result = self.mintPhi(merge, tag: resultTag, nameId: UnnamedTypeId)

		self.recordBranchEdge(entry, targetId: merge.id, argIds: singletonArgs(seed))
		self.recordBranchEdge(rhsEnd, targetId: merge.id, argIds: singletonArgs(rhsValue))
		self.emitShortCircuitBranch(entry, cond: leftValue, rhsId: rhsBlock.id, mergeId: merge.id, takesRhsWhenTrue: takesRhsWhenTrue, range: range)
		self.emitBranch(rhsEnd, targetId: merge.id)

		self.currentBlock = merge
		return result
	end 'emitShortCircuit'

	// The two-way branch out of a short-circuit's entry block. `and` takes the rhs when the
	// lhs is TRUE; `or` takes it when the lhs is FALSE — so the two differ by nothing but
	// which target sits in which slot.
	function emitShortCircuitBranch(entry IrBlock, cond ValueId, rhsId BlockId, mergeId BlockId, takesRhsWhenTrue bool, range SourceRange)
		var thenId = mergeId
		var elseId = rhsId
		if takesRhsWhenTrue 'isAnd'
			thenId = rhsId
			elseId = mergeId
		end 'isAnd'
		self.artifact.emitTerminator(entry, op: MaxonOp.condBranch(cond, thenBlockId: thenId, elseBlockId: elseId), range: range)
	end 'emitShortCircuitBranch'

	// A prefix-operator operand — the climber's leaf.
	//
	// The two prefix operators bind their operands DIFFERENTLY, and both readings are pinned
	// by a spec:
	//   • `-` takes a PRIMARY, so `- -x` fails at the second `-` (parsePrimary raises E2004)
	//     — specs/unary-operators.md's double-negation case.
	//   • `not` takes another UNARY, so `not not a` is legal and is 42 for a == 42
	//     — specs/bitwise-operators.md's `bitwise-not-double`.
	// v1 splits them the same way (its `-` recurses into parsePrimary, its `not` into
	// parseUnary — Parser.maxon:12034-12055).
	//
	// `not` is TYPE-DIRECTED, like `and`/`or`/`xor`: on a bool it flips bit 0 (`not true` is
	// false), on an integer it complements all 64 (`not 5` is -6). The two are different
	// instructions, and choosing the integer one for a bool would give -1/-2 — both of which
	// still read as TRUE in a condition. So the parser, which is the tier that knows the
	// type, picks the opcode; the Std tier just lowers what it is given.
	//
	// `-` is NOT type-directed: it is ARITHMETIC, so its operand must be a number. `-flag` has
	// no reading — it negated the bool's 1 payload and produced -1, which is still TRUE in a
	// condition — so it is rejected by the same numeric-domain rule the binary arithmetic
	// operators use (TypeRules' `typeClassAdmits`).
	function parseUnary(func IrFunction) returns ValueId throws ParseError
		if self.at(TokenKind.minus) 'neg'
			let opTok = try self.consume(TokenKind.minus)
			let operand = try self.parsePrimary(func)
			let operandTag = self.tagOf(operand)
			if not typeClassAdmits(TypeClass.numeric, tag: operandTag) 'notANumber'
				throw ParseError.nonNumericNegation(typeTagName(operandTag), line: opTok.line, column: opTok.column)
			end 'notANumber'

			if tagIsFloat(operandTag) 'float'
				return try self.emitFloatNegation(operand, opTok: opTok)
			end 'float'

			return self.emitUnaryOp(operand, op: MaxonUnaryOp.neg, resultTag: operandTag, opTok: opTok)
		end 'neg'

		if self.at(TokenKind.not) 'not'
			let opTok = try self.consume(TokenKind.not)
			let operand = try self.parseUnary(func)
			let operandTag = self.tagOf(operand)
			match notOperatorFor(operandTag) 'which'
				op(kind, resultTag) then return self.emitUnaryOp(operand, op: kind, resultTag: resultTag, opTok: opTok)
				unknownOperandType then throw ParseError.notOnUnknownType(opTok.line, column: opTok.column)
				nonIntegralOperand then throw ParseError.nonIntegralOperands(opTok.kind.rawValue, operand: typeTagName(operandTag), line: opTok.line, column: opTok.column)
			end 'which'
		end 'not'

		return try self.parsePrimary(func)
	end 'parseUnary'

	// Append a `binOp` op combining two SSA values; return the ValueId it defines. The
	// result's TYPE is the operator's: arithmetic and shifts are integer; `and`/`or`/`xor`
	// follow their operands (see `wordOpResultTag`) — the ONE place a bitwise op's result
	// could be a bool, which is what `consume(f.a or f.b)` against a `bool` parameter needs.
	// The source range anchors on the operator token (the conventional binop anchor).
	function emitBinOp(lhs ValueId, rhs ValueId, op MaxonBinOp, opTok Token) returns ValueId throws ParseError
		let leftTag = self.tagOf(lhs)
		let rightTag = self.tagOf(rhs)
		try requireBinOpOperands(op, left: leftTag, right: rightTag, opTok: opTok)

		let resultTag = binOpResultTag(op, left: leftTag, right: rightTag)

		// ⭐ **NUMERIC PROMOTION, PAID FOR.** `TypeRules.arithResultTag` answering `float` is a
		// PROMISE that both operands are already in the float domain, and this is the one place
		// it is kept: an i64 in a GPR is not an f64 in an XMM, and `addsd` cannot read one. It
		// happens HERE, in the parser, because this is the last tier that knows each operand's
		// source type — by the Std tier `operandType` is a single answer for the whole op, and
		// there is no longer a mixed pair to see.
		let left = self.promotedOperand(lhs, left: leftTag, right: rightTag, opTok: opTok)
		let right = self.promotedOperand(rhs, left: leftTag, right: rightTag, opTok: opTok)

		let result = self.mintValue(resultTag, nameId: UnnamedTypeId)
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.binOp(result, lhs: left, rhs: right, op: op), range: SourceRange.ofToken(opTok))

		// Fold, when the parser holds both operands — so `x shl 63 + 1` is a count of 64 and not an
		// unknown. RECORDED, not rewritten: this compiler emits the `add` either way (see
		// FoldConstOperands' header on why `foldConstants` is deferred).
		//
		// It reads the ORIGINAL ids, not the promoted ones, and it cannot confuse the two: the
		// gate is `tagIsInteger(resultTag)`, and a promotion happens only when the result is a
		// float — so on every path that folds, `left`/`right` ARE `lhs`/`rhs`.
		if tagIsInteger(resultTag) and self.constIsKnown(lhs) and self.constIsKnown(rhs) 'bothKnown'
			self.recordFold(result, fold: foldIntBinOp(op, lhs: self.constOf(lhs), rhs: self.constOf(rhs)))
		end 'bothKnown'

		return result
	end 'emitBinOp'

	// One operand of a binary op or comparison, moved into the float domain if the PAIR meets
	// there. Takes both tags because promotion is a property of the pair, not of the operand —
	// `5` stays an int in `5 + 3` and becomes an f64 in `5 + 2.0`, and only the other side says
	// which.
	//
	// Both operands go through it unconditionally, and `promoteToFloat` is idempotent, so the
	// already-float side costs nothing and no caller has to work out which side to convert.
	function promotedOperand(value ValueId, left ValueTypeTag, right ValueTypeTag, opTok Token) returns ValueId
		if not operandsAreFloat(left, right: right) 'integral'
			return value
		end 'integral'

		return self.promoteToFloat(value, opTok: opTok)
	end 'promotedOperand'

	// Move a value into the float domain — the int→f64 half of the implicit-conversion lattice.
	// `TypeRules.arithResultTag` states the TYPE rule; this emits the INSTRUCTION that makes it
	// true (`cvtsi2sd`, via `MaxonUnaryOp.promoteToFloat`).
	//
	// A value already there is returned untouched, which is what makes it idempotent — and it is
	// also what keeps `siToFp` from ever naming a float→float conversion (`lowerUnaryOp`'s
	// `assertConversionCrossesDomain` is the backstop that says so).
	//
	// Ported from v1's `promoteToFloat` (LowerMaxonToStd.maxon:3459). ONE divergence, and it is
	// the reason shv2 has one type oracle instead of two: v1 promotes during LOWERING, off an
	// `isFloat` side-map it maintains there because by then the source types are gone. shv2
	// promotes in the PARSER, off the `valueTags` column it already keeps for the word operators.
	// Same op, same place in the value graph, one fewer table.
	function promoteToFloat(value ValueId, opTok Token) returns ValueId
		if tagIsFloat(self.tagOf(value)) 'alreadyFloat'
			return value
		end 'alreadyFloat'

		return self.emitUnaryOp(value, op: MaxonUnaryOp.promoteToFloat, resultTag: ValueTypeTag.float, opTok: opTok)
	end 'promoteToFloat'

	// ⭐ **FLOAT NEGATION IS A SUBTRACT FROM ZERO**, and that is a PORT, not a shortcut — v1 says
	// the same of its own parser ("Float negation is normally lowered by the parser as `0.0 - x`",
	// LowerMaxonToStd.maxon:5964).
	//
	// x64 has NO `neg` for an XMM register. The hardware spelling of a sign flip is `xorpd`
	// against a sign-bit mask that has to be materialized in rdata — a new opcode, a new constant,
	// and a new relocation — whereas `subsd` is already in the band this rung landed. So `-x`
	// costs nothing new, and `MaxonUnaryOp.neg` stays what it has always been: the INTEGER negate.
	//
	// ⚠ It differs from a true negation on exactly one input, and it is worth naming rather than
	// discovering: `0.0 - (+0.0)` is `+0.0`, where `-(+0.0)` is `-0.0`. Nothing in the language
	// can yet observe a zero's sign — that needs `print`, which is P1.2's — and v1 has shipped
	// this trade for its whole life. `0.0 - nan` is `nan`, so the unordered case is unaffected.
	function emitFloatNegation(operand ValueId, opTok Token) returns ValueId throws ParseError
		let zero = self.emitLiteral(FloatZeroBits, valueType: MaxonType.float, range: SourceRange.ofToken(opTok))
		return try self.emitBinOp(zero, rhs: operand, op: MaxonBinOp.sub, opTok: opTok)
	end 'emitFloatNegation'

	// Append a `unaryOp` op over one SSA value; return the ValueId it defines. The source
	// range anchors on the operator token, mirroring emitBinOp.
	function emitUnaryOp(operand ValueId, op MaxonUnaryOp, resultTag ValueTypeTag, opTok Token) returns ValueId
		let result = self.mintValue(resultTag, nameId: UnnamedTypeId)
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.unaryOp(result, operand: operand, op: op), range: SourceRange.ofToken(opTok))

		// `-1` is `neg` of the literal 1, not a negative literal — so without this arm the parser
		// could not see the count in `x shl -1` at all.
		if tagIsInteger(resultTag) and self.constIsKnown(operand) 'known'
			self.recordFold(result, fold: foldIntUnaryOp(op, operand: self.constOf(operand)))
		end 'known'

		return result
	end 'emitUnaryOp'

	// Append a `compare` op over two SSA values; return the BOOLEAN ValueId it defines.
	// Mirrors emitBinOp but emits the distinct comparison variant (a comparison is not a
	// `binOp` — see MaxonCmpOp). The source range anchors on the comparison operator.
	//
	// A comparison is STRICT IN BOTH ITS CLASS AND ITS DOMAIN — `TypeRules.comparableOperands`,
	// which is a third question and not `typesAgree`. Two bools compare fine (`a == b`); two ints
	// compare; two floats compare. A MIXTURE does not, in either of the two ways a pair can be
	// mixed:
	//
	//   • a bool against a number — the only thing there is to compare is the bool's 0/1 payload,
	//     which is not what the source wrote: `4 < flag` is `4 < 1`, i.e. always false. v1 states
	//     the identical rule at TypeResolution.maxon:2726 ("Comparisons are category-strict: both
	//     sides must land in the same CastCategory").
	//
	//   • ⭐ an int against a FLOAT — and this one is the rule that ARITHMETIC does not share.
	//     `5 + 2.0` promotes and is 7.0; `f > i` is E3005 (specs/contextual-literal-typing.md,
	//     four cases). A promotion inside a comparison would be INVISIBLE — the result is a bool
	//     either way, so nothing in the program would show that the int had been converted, and
	//     `3.5 > i` would silently answer a question about `3.5 > 2.0` nobody asked.
	//
	// ⚠ THIS FUNCTION ONCE PROMOTED, and that is exactly the bug P1.0d.4 shipped and then fixed:
	// the promotion built for `emitBinOp` was routed through here too, because a compare's
	// operands looked like a binOp's. They are not: one produces a number, the other a verdict.
	function emitCompare(lhs ValueId, rhs ValueId, op MaxonCmpOp, opTok Token) returns ValueId throws ParseError
		let leftTag = self.tagOf(lhs)
		let rightTag = self.tagOf(rhs)

		// ⭐ STRING `==`/`!=` IS A RUNTIME BYTE COMPARE, not a `compare` op (which would compare two box
		// POINTERS — reference equality answering a question about VALUES). Handled at the TOP, before
		// `comparableOperands`: two strings do NOT `comparableOperands` (that rule governs ORDERING,
		// which strings have none of), so a both-`string` pair must be intercepted here or it would be
		// rejected as a mismatch. A string-vs-non-string pair is NOT both-`string`, so it falls through
		// to the mismatch gate below — a clean type error, not a crash.
		if tagIsText(leftTag) and tagIsText(rightTag) 'stringCompare'
			return try self.emitStringCompare(lhs, rhs: rhs, op: op, opTok: opTok)
		end 'stringCompare'

		if not comparableOperands(leftTag, right: rightTag) 'mismatch'
			throw ParseError.comparisonTypeMismatch(typeTagName(leftTag), right: typeTagName(rightTag), line: opTok.line, column: opTok.column)
		end 'mismatch'

		let result = self.mintValue(ValueTypeTag.boolean, nameId: UnnamedTypeId)
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.compare(result, lhs: lhs, rhs: rhs, op: op), range: SourceRange.ofToken(opTok))
		return result
	end 'emitCompare'

	// The two String comparisons — the ONLY operators String has. `==` is the `__str_eq` runtime call
	// (content equality: equal lengths, then equal bytes); `!=` is its logical negation, built from the
	// same call so the two can never disagree about what equality means. ORDERING (`<`/`>`/`<=`/`>=`)
	// has no meaning on a byte record and is rejected — the bootstrap rejects it identically.
	function emitStringCompare(lhs ValueId, rhs ValueId, op MaxonCmpOp, opTok Token) returns ValueId throws ParseError
		match op 'op'
			eq then return self.emitStrEqCall(lhs, rhs: rhs, opTok: opTok)
			ne then return self.emitUnaryOp(self.emitStrEqCall(lhs, rhs: rhs, opTok: opTok), op: MaxonUnaryOp.logicalNot, resultTag: ValueTypeTag.boolean, opTok: opTok)
			// `lt`/`gt`/`le`/`ge` — ordering on a String. Reported as a comparison type mismatch (there
			// is no ordering to fall through to), which is the acceptable existing diagnostic; a String
			// is orderable by no operator this rung provides.
			lt to ge then throw ParseError.comparisonTypeMismatch(typeTagName(ValueTypeTag.string), right: typeTagName(ValueTypeTag.string), line: opTok.line, column: opTok.column)
		end 'op'
	end 'emitStringCompare'

	// Emit the `__str_eq(lhs, rhs)` runtime call, typed `boolean` (its i64 result is 0/1). The one
	// caller-typed emit site for both `==` and `!=`, and for a `string`-scrutinee `match` pattern.
	function emitStrEqCall(lhs ValueId, rhs ValueId, opTok Token) returns ValueId
		var args = ValueIdArray.create()
		args.push(lhs)
		args.push(rhs)
		return self.emitRuntimeCall(StrEqName, args: args, resultTag: ValueTypeTag.boolean, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(opTok))
	end 'emitStrEqCall'

	// A primary expression: an integer literal, a `true`/`false` literal, a CHARACTER literal,
	// a parenthesized sub-expression, a type-qualified numeric bound (`u16.max`), a call, or a
	// variable reference. Anything else where an operand is required (an operator, a delimiter,
	// EOF) is E2004 — "Expected expression but got '<got>'". This is the site `- -x` hits
	// at its second `-`: unary minus's operand is a primary, and a leading `-` is not one.
	function parsePrimary(func IrFunction) returns ValueId throws ParseError
		if self.at(TokenKind.intLiteral) 'intLit'
			return try self.parseIntLiteral()
		end 'intLit'

		if self.at(TokenKind.floatLiteral) 'floatLit'
			return try self.parseFloatLiteral()
		end 'floatLit'

		if self.at(TokenKind.true) or self.at(TokenKind.false) 'boolLit'
			return try self.parseBoolLiteral()
		end 'boolLit'

		// A charLiteral HERE — where an operand is required — is a character literal. The
		// same token kind is a BLOCK LABEL elsewhere, and the two never collide because a
		// label never sits in operand position (see the CharLiteralValue header).
		if self.at(TokenKind.charLiteral) 'charLit'
			return try self.parseCharLiteral()
		end 'charLit'

		// A `String` LITERAL (P1.2 wave A). A pure literal is a SINGLE `stringLiteral` token; an
		// INTERPOLATED string (`"{x}"`) is the same token followed by `stringInterpStart`, which is
		// Wave B — `parseStringLiteral` rejects it.
		if self.at(TokenKind.stringLiteral) 'strLit'
			return try self.parseStringLiteral(func)
		end 'strLit'

		if self.at(TokenKind.leftParen) 'group'
			return try self.parseParenthesizedExpression(func)
		end 'group'

		// `match <expr> 'label' … end 'label'` in value position — `let r = match …`, `return
		// match …`, `match … * 2`. A distinct parser gap from the statement form: the expression
		// parser had no `match` arm at all (E2004 `Expected expression but got 'match'`), where the
		// statement parser reached lowering before failing (E2015). It leaves control in the merge
		// block and yields the merge's result phi, exactly as `emitShortCircuit` does.
		if self.at(TokenKind.match) 'matchExpr'
			return try self.parseMatchExpression(func)
		end 'matchExpr'

		// `Self{…}` — a struct literal naming the enclosing type. `Self` is its own KEYWORD token, not
		// an identifier, so it cannot ride the identifier arm below; and `{` is what tells it from
		// `Self` in a type position, which never reaches an expression at all.
		if self.at(TokenKind.selfType) 'selfLiteral'
			return try self.parseStructLiteral(func)
		end 'selfLiteral'

		// `self.x` / `self.m(…)` — the RECEIVER, which is a different keyword from `Self` the TYPE
		// (`self` vs `selfType`; the lexer splits them, so nothing here has to). Its own arm for the
		// same reason `Self{…}` has one: a keyword cannot ride the identifier arm below.
		if self.at(TokenKind.self) 'selfReceiver'
			return try self.parseSelfPrimary(func)
		end 'selfReceiver'

		if self.at(TokenKind.identifier) 'namedPrimary'
			// One-token lookaheads split the four forms an identifier can open. `(` makes it a CALL
			// (the same shape the statement parser uses to tell a call apart from a bare name); `{`
			// makes it a STRUCT LITERAL; `.` makes it one of the three DOTTED forms
			// (`parseDottedPrimary` splits those); anything else is a variable reference.
			if self.peekKind() == TokenKind.leftParen 'callExpr'
				// A call in an EXPRESSION — its result IS the expression, so a void callee has nothing
				// to give and `parseCall` rejects it (E2004).
				return try self.parseCall(func, resultUsed: true)
			end 'callExpr'
			if self.peekKind() == TokenKind.leftBrace 'structLiteral'
				return try self.parseStructLiteral(func)
			end 'structLiteral'
			if self.peekKind() == TokenKind.dot 'dotted'
				return try self.parseDottedPrimary(func)
			end 'dotted'
			return try self.parseVariableReference()
		end 'namedPrimary'

		let tok = self.current()
		throw ParseError.expectedExpression(tok.kind.rawValue, line: tok.line, column: tok.column)
	end 'parsePrimary'

	// `( <expr> )` — grouping, which is what makes `(2 + 3) * 4` mean 20 rather than 14.
	// The parentheses produce NO op: the group's value IS the inner expression's, so the
	// only thing they change is the shape of the tree the climber builds.
	//
	// It re-enters the climber at the LOOSEST level, so a parenthesis restores every operator
	// — `not (a or b)` is the `or` of two bools, `(x > 0) and (y > 0)` groups explicitly. It
	// does NOT go through `parseExpression`, which would re-seed `currentBlock` and undo any
	// short-circuit that moved it.
	function parseParenthesizedExpression(func IrFunction) returns ValueId throws ParseError
		try self.consume(TokenKind.leftParen)
		let value = try self.parseBinary(func, minPrec: OrPrecedence)
		try self.consume(TokenKind.rightParen)
		return value
	end 'parseParenthesizedExpression'

	// `'a'`, `'\n'`, `'0'` — a character literal in operand position. It materializes as an
	// ordinary INTEGER literal carrying the character's byte, which is exactly what
	// specs/char-literal-to-int.md asks for ("the compiler automatically converts the
	// character literal to its Unicode codepoint value at compile time") and what makes
	// `cp == '-'`, `cp - '0'` and `if c >= '0'` compile and mean what they say.
	//
	// v1 does the same for the single-byte case (`parseCharLiteralExpr`, Parser.maxon:16606:
	// *"Emits an integer literal carrying the byte value of an ASCII character"*) and routes
	// wider literals to its `Character` struct. shv2 has no Character type — it is a heap
	// value, and heap values arrive with String at P1.2 — so it REJECTS them with a
	// positioned diagnostic naming the gap, exactly as v1's own comment says it must
	// ("report them as a diagnostic instead of silently producing the wrong byte").
	function parseCharLiteral() returns ValueId throws ParseError
		let tok = try self.consume(TokenKind.charLiteral)
		match decodeCharLiteral(tok.value) 'decoded'
			byte(value) then return self.emitLiteral(value, valueType: MaxonType.integer, range: SourceRange.ofToken(tok))
			empty then throw ParseError.invalidCharacterLiteral("a character literal must contain exactly one character", line: tok.line, column: tok.column)
			multiByte then throw ParseError.unsupported("the multi-byte character literal '{String.from(tok.value)}' (a character wider than one byte is a `Character` — a heap value with `.bytes()` and `.asciiValue()` — which arrives with String; a single-byte literal materializes as its byte value)", line: tok.line, column: tok.column)
			badEscape(text) then throw ParseError.invalidCharacterLiteral("unknown escape sequence '{text}'", line: tok.line, column: tok.column)
		end 'decoded'
	end 'parseCharLiteral'

	// `"hello"`, `""`, `"Use \{expr\} for interpolation"` — a `String` LITERAL in operand position (P1.2
	// wave A). It materializes as a `stringLiteral` op carrying the DECODED bytes, typed `string`;
	// lowering turns it into an immortal `.rdata` record + a `lea` of its address (see
	// `LowerMaxonToStd.lowerStringLiteral`). No heap, no ownership — a literal is never allocated or
	// dropped.
	//
	// ⚠ AN INTERPOLATED STRING IS DEFERRED. The lexer splits `"a{x}b"` into `stringLiteral("a")`,
	// `stringInterpStart`, the `x` tokens, `stringInterpEnd`, `stringLiteral("b")` — so a `stringLiteral`
	// token FOLLOWED BY `stringInterpStart` is an interpolation, which builds an owned HEAP string and is
	// Wave B. `escaped-braces` (`\{`/`\}`) is NOT interpolation: the lexer's escape handling means the
	// braces never open one, so it is a single `stringLiteral` fragment and `decodeEscapes` turns `\{`
	// into `{` here.
	function parseStringLiteral(func IrFunction) returns ValueId throws ParseError
		// A `stringLiteral` FOLLOWED BY `stringInterpStart` is an interpolation (`"a{x}b"`), which builds
		// the first OWNED heap String (P1.2 wave B). A lone `stringLiteral` is an immortal rdata literal.
		if self.peekKind() == TokenKind.stringInterpStart 'interpolated'
			return try self.parseStringInterpolation(func)
		end 'interpolated'

		return try self.consumeStringLiteralValue()
	end 'parseStringLiteral'

	// Consume the current NON-interpolated `stringLiteral` token and emit its decoded bytes as an immortal
	// rdata String. The shared body of the two callers that reach a plain literal — value position
	// (`parseStringLiteral`) and match-pattern position (`emitPatternValue`) — so the decode-and-emit lives
	// in one place.
	function consumeStringLiteralValue() returns ValueId throws ParseError
		let tok = try self.consume(TokenKind.stringLiteral)
		match decodeEscapes(tok.value) 'decoded'
			bytes(buf) then return self.emitStringLiteral(buf, range: SourceRange.ofToken(tok))
			unknownEscape(text) then throw ParseError.unsupported("the escape sequence '{text}' in a string literal is not a recognized escape", line: tok.line, column: tok.column)
		end 'decoded'
	end 'consumeStringLiteralValue'

	// Append a `stringLiteral` op carrying the DECODED bytes; return the `string`-typed ValueId it
	// defines. The one emit site, so a caller that already holds decoded bytes (none today, but the
	// interpolation path at Wave B will hand a materialized buffer here) reaches the type + op in one
	// place.
	function emitStringLiteral(bytes ByteArray, range SourceRange) returns ValueId
		let result = self.mintValue(ValueTypeTag.string, nameId: UnnamedTypeId)
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.stringLiteral(result, bytes: bytes), range: range)
		return result
	end 'emitStringLiteral'

	// ⭐⭐ **`"prefix {x} suffix"` — WHERE THE FIRST OWNED HEAP STRING IS BUILT.** An interpolation lowers to
	// ONE `__mm_alloc`'d fused record: the 48-byte String record with its UTF-8 bytes INLINE right behind it
	// (`buffer@0 = record + StringRecordBytes`), the concatenation of every part's bytes. It is an owned
	// TEMPORARY — `emitStringInterp` enrolls it for the statement-scoped drop — so `print("{x}")` frees it
	// at statement end and `let s = "{x}"` transfers it to a scope-exit drop (`parseBinding`).
	//
	// The lexer splits `"a{x}b"` into `stringLiteral("a") stringInterpStart <expr> stringInterpEnd
	// stringLiteral("b")` — a leading fragment, then any number of `(expr, fragment)` pairs. Each part is
	// materialized to a `(buffer, length)` pair as it is parsed (a literal fragment and a `{s}` String part
	// alike load `buffer@0`/`length@8` from a String record; a primitive renders into a freed scratch
	// buffer), and `emitStringInterp` sums the lengths, allocates once, and copies the parts in.
	//
	// Each `{expr}` is parsed in the block control CURRENTLY occupies, not the entry block — an expression
	// that opens blocks (a short-circuit `{a and b}`) leaves control in its merge, and the next part and the
	// assembly must chain off that merge (the `multiple-try-fragments` regression, deferred here for `try`).
	function parseStringInterpolation(func IrFunction) returns ValueId throws ParseError
		let startTok = self.current()
		let range = SourceRange.ofToken(startTok)

		var partBufs = ValueIdArray.create()
		var partLens = ValueIdArray.create()
		// The OWNED scratch buffers a primitive part rendered into. Freed after the copy in
		// `emitStringInterp` — they are consumed by the blit and otherwise leak (the interp-scratch-buffer
		// leak the leak gate would catch). A literal or String part collects none (its bytes are borrowed).
		var scratchIds = ValueIdArray.create()

		try self.materializeLiteralFragment(partBufs, partLens: partLens, range: range)
		while self.at(TokenKind.stringInterpStart) 'parts'
			try self.consume(TokenKind.stringInterpStart)
			let exprTok = self.current()
			let exprVal = try self.parseExpression(func, block: self.currentBlock)
			try self.consume(TokenKind.stringInterpEnd)
			try self.materializeInterpExpr(exprVal, exprTok: exprTok, partBufs: partBufs, partLens: partLens, scratchIds: scratchIds, range: range)
			try self.materializeLiteralFragment(partBufs, partLens: partLens, range: range)
		end 'parts'

		return self.emitStringInterp(partBufs, partLens: partLens, scratchIds: scratchIds, range: range)
	end 'parseStringInterpolation'

	// Consume the current literal fragment token and, if it decodes to a non-empty byte run, materialize it
	// as a part. An EMPTY fragment (the `""` the lexer emits around adjacent interpolations, `"{a}{b}"`)
	// contributes nothing and is skipped — the bootstrap's `if (string.IsNullOrEmpty(...)) continue`.
	function materializeLiteralFragment(partBufs ValueIdArray, partLens ValueIdArray, range SourceRange) throws ParseError
		let tok = try self.consume(TokenKind.stringLiteral)
		match decodeEscapes(tok.value) 'decoded'
			bytes(buf) then self.materializeFragmentBytes(buf, partBufs: partBufs, partLens: partLens, range: range)
			unknownEscape(text) then throw ParseError.unsupported("the escape sequence '{text}' in a string literal is not a recognized escape", line: tok.line, column: tok.column)
		end 'decoded'
	end 'materializeLiteralFragment'

	function materializeFragmentBytes(buf ByteArray, partBufs ValueIdArray, partLens ValueIdArray, range SourceRange)
		if buf.count() == 0 'empty'
			return
		end 'empty'
		self.materializeStringRecordPart(self.emitStringLiteral(buf, range: range), partBufs: partBufs, partLens: partLens, range: range)
	end 'materializeFragmentBytes'

	// A `{expr}` part. A String value (a literal or an interpolation result) is copied by its bytes exactly
	// as a literal fragment is — `materializeStringRecordPart` reads `buffer@0`/`length@8` from either. An
	// integer renders to decimal text via `__int_to_string` into a scratch buffer. bool/float/enum are the
	// next waves; a Stringable struct is P1.7a.
	function materializeInterpExpr(exprVal ValueId, exprTok Token, partBufs ValueIdArray, partLens ValueIdArray, scratchIds ValueIdArray, range SourceRange) throws ParseError
		let tag = self.tagOf(exprVal)
		if tagIsText(tag) 'stringPart'
			self.materializeStringRecordPart(exprVal, partBufs: partBufs, partLens: partLens, range: range)
			return
		end 'stringPart'

		if tagIsIntegral(tag) 'intPart'
			self.materializeScratchPart(exprVal, converter: IntToStringName, scratchBytes: IntToStringScratchBytes, partBufs: partBufs, partLens: partLens, scratchIds: scratchIds, range: range)
			return
		end 'intPart'

		if tagIsBool(tag) 'boolPart'
			self.materializeScratchPart(exprVal, converter: BoolToStringName, scratchBytes: BoolToStringScratchBytes, partBufs: partBufs, partLens: partLens, scratchIds: scratchIds, range: range)
			return
		end 'boolPart'

		throw ParseError.unsupported("interpolating a value of type '{typeTagName(tag)}' — P1.2 wave B interpolates String, integer and bool expressions; float arrives next, and a Stringable struct at P1.7a", line: exprTok.line, column: exprTok.column)
	end 'materializeInterpExpr'

	// A String-record part: load `buffer@0` and `length@8` off the record. Shared by literal fragments and
	// `{s}` String parts — both are pointers to the fused 48-byte record, so both read the same two fields.
	function materializeStringRecordPart(rec ValueId, partBufs ValueIdArray, partLens ValueIdArray, range SourceRange)
		partBufs.push(self.emitLoadStringField(rec, offset: StringBufferOffset, range: range))
		partLens.push(self.emitLoadStringField(rec, offset: StringLengthOffset, range: range))
	end 'materializeStringRecordPart'

	// Render a primitive part into a freshly `__mm_alloc`'d scratch buffer via a `(value, dest) -> length`
	// converter runtime function, enroll the scratch for the post-copy free (it is an owned buffer the blit
	// consumes — otherwise the interp-scratch-buffer leak), and record `(scratch, length)`. The shared shape
	// of every primitive part — int, bool, float — differing only in the converter and its worst-case byte
	// budget. A `named` integer alias is already i64, so the value needs no widening at this rung.
	function materializeScratchPart(exprVal ValueId, converter ByteArray, scratchBytes ParsedInt, partBufs ValueIdArray, partLens ValueIdArray, scratchIds ValueIdArray, range SourceRange)
		let scratchSize = self.emitLiteral(scratchBytes, valueType: MaxonType.integer, range: range)
		let destructor = self.emitLiteral(TrivialDestructor, valueType: MaxonType.integer, range: range)
		var allocArgs = ValueIdArray.create()
		allocArgs.push(scratchSize)
		allocArgs.push(destructor)
		let scratch = self.emitRuntimeCall(MmAllocName, args: allocArgs, resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: range)

		var convArgs = ValueIdArray.create()
		convArgs.push(exprVal)
		convArgs.push(scratch)
		let length = self.emitRuntimeCall(converter, args: convArgs, resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: range)

		partBufs.push(scratch)
		partLens.push(length)
		scratchIds.push(scratch)
	end 'materializeScratchPart'

	// ⭐ **ASSEMBLE THE FUSED OWNED STRING.** Sum the part lengths, allocate ONE `__mm_alloc` record big
	// enough for the 48-byte record + the bytes + a NUL, copy every part into the inline region at a running
	// cursor, write the record fields, and free the scratch. The result is an owned temporary
	// (`trackOwnedTemp`) — an inline String (`parent_ptr = InlineParentSentinel`) whose bytes die with the
	// record's slot, so its destructor is `TrivialDestructor` (0), exactly a struct's: `__mm_decref` →
	// `__mm_free` reclaims record and bytes together, with no external buffer and no destructor cascade.
	function emitStringInterp(partBufs ValueIdArray, partLens ValueIdArray, scratchIds ValueIdArray, range SourceRange) returns ValueId
		let totalLen = self.sumPartLengths(partLens, range: range)

		let overhead = self.emitLiteral(StringInterpOverheadBytes, valueType: MaxonType.integer, range: range)
		let allocSize = self.emitInterpArith(totalLen, rhs: overhead, range: range)
		let destructor = self.emitLiteral(TrivialDestructor, valueType: MaxonType.integer, range: range)
		var allocArgs = ValueIdArray.create()
		allocArgs.push(allocSize)
		allocArgs.push(destructor)
		let result = self.emitRuntimeCall(MmAllocName, args: allocArgs, resultTag: ValueTypeTag.string, resultNameId: UnnamedTypeId, range: range)
		self.trackOwnedTemp(result)

		// The inline byte region begins right after the record. Copy each part in at a cursor that advances
		// by the part's length; the NUL at `buffer[totalLen]` is already zero (the slab zeroes the payload).
		let recordBytes = self.emitLiteral(StringRecordBytes as ParsedInt, valueType: MaxonType.integer, range: range)
		let inlineBuf = self.emitInterpArith(result, rhs: recordBytes, range: range)
		var cursor = inlineBuf
		for i in 0 upto partBufs.count() 'copyParts'
			let buf = try partBufs.get(i) otherwise panic("emitStringInterp: partBufs.get OOB at {i} — partBufs and partLens grow in lockstep")
			let length = try partLens.get(i) otherwise panic("emitStringInterp: partLens.get OOB at {i} — partBufs and partLens grow in lockstep")
			var copyArgs = ValueIdArray.create()
			copyArgs.push(cursor)
			copyArgs.push(buf)
			copyArgs.push(length)
			_ = self.emitRuntimeCall(StrCopyName, args: copyArgs, resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
			cursor = self.emitInterpArith(cursor, rhs: length, range: range)
		end 'copyParts'

		self.emitStoreStringField(result, offset: StringBufferOffset, value: inlineBuf, range: range)
		self.emitStoreStringField(result, offset: StringLengthOffset, value: totalLen, range: range)
		// capacity == length: the bytes are exact and never grown at this rung. `append` (Wave D) detaches.
		self.emitStoreStringField(result, offset: StringCapacityOffset, value: totalLen, range: range)
		let elementSize = self.emitLiteral(StringElementSize, valueType: MaxonType.integer, range: range)
		self.emitStoreStringField(result, offset: StringElementSizeOffset, value: elementSize, range: range)
		let parent = self.emitLiteral(InlineParentSentinel, valueType: MaxonType.integer, range: range)
		self.emitStoreStringField(result, offset: StringParentPtrOffset, value: parent, range: range)
		// `isAscii@40 = 0` (conservative) comes from the slab's zeroing — grapheme/ascii refinement is P1.7.

		// Free the owned scratch now its bytes are copied. A `__mm_decref` (rc 0 → `__mm_free`), never a raw
		// free, so the leak counter stays balanced — the same door `emitScopeDrops` drops through.
		for i in 0 upto scratchIds.count() 'freeScratch'
			let scratch = try scratchIds.get(i) otherwise panic("emitStringInterp: scratchIds.get OOB at {i}")
			self.emitDecref(scratch, range: range)
		end 'freeScratch'

		return result
	end 'emitStringInterp'

	// Sum the parts' lengths into a single value. At least one part exists — a real interpolation carries a
	// `{expr}`, so `parseStringInterpolation` always materialized one before calling here.
	function sumPartLengths(partLens ValueIdArray, range SourceRange) returns ValueId
		var total = try partLens.get(0) otherwise panic("sumPartLengths: an interpolation materialized no parts — parseStringInterpolation only reaches emitStringInterp after materializing at least one interpolated part")
		for i in 1 upto partLens.count() 'sum'
			let length = try partLens.get(i) otherwise panic("sumPartLengths: partLens.get OOB at {i}")
			total = self.emitInterpArith(total, rhs: length, range: range)
		end 'sum'
		return total
	end 'sumPartLengths'

	// `lhs + rhs` as raw i64 pointer/length arithmetic — the interpolation's cursor advance, buffer offset
	// and size math. It emits `MaxonOp.binOp(add)` DIRECTLY, bypassing `emitBinOp`'s operand type rules,
	// because the operands are a String pointer (`result + StringRecordBytes`) or lengths the interpolation
	// controls, not a source-level `a + b`. The result is integer-tagged (a machine word); the Std tier
	// reads a String lhs as its i64 pointer (`valueTagToStdType`), so the `add` is a clean i64 add.
	function emitInterpArith(lhs ValueId, rhs ValueId, range SourceRange) returns ValueId
		let result = self.mintValue(ValueTypeTag.integer, nameId: UnnamedTypeId)
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.binOp(result, lhs: lhs, rhs: rhs, op: MaxonBinOp.add), range: range)
		return result
	end 'emitInterpArith'

	// Load an 8-byte field of a String record — `buffer@0`, `length@8`. Integer-tagged: the values are a raw
	// pointer and a byte count. The `rec` addr is a String pointer, read by the Std tier as an i64.
	function emitLoadStringField(rec ValueId, offset ByteOffset, range SourceRange) returns ValueId
		let result = self.mintValue(ValueTypeTag.integer, nameId: UnnamedTypeId)
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.loadIndirect(result, addr: rec, offset: offset, valueType: MaxonType.integer), range: range)
		return result
	end 'emitLoadStringField'

	// Store an 8-byte field of a String record — the mirror of `emitLoadStringField`, the one place
	// `emitStringInterp` writes the fused record's six fields (five explicitly; `isAscii@40` rides the
	// slab's zeroing).
	function emitStoreStringField(rec ValueId, offset ByteOffset, value ValueId, range SourceRange)
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.storeIndirect(rec, offset: offset, value: value, valueType: MaxonType.integer), range: range)
	end 'emitStoreStringField'

	// `true` / `false`. A bool is an i1 carrying 1 or 0 — the same `literal` op an
	// integer uses, typed `boolean` so the Maxon→Std collapse gives it i1 rather than
	// i64. The `bool` TYPE already existed (a comparison produces one, an `if` consumes
	// one); these are the literals that let a program NAME one.
	// ONE emit site, not one per arm: the two literals differ only in the token they
	// consume and the payload they carry, so a change to how a bool is materialized (its
	// MaxonType, its op) lands in a single place and cannot apply to `true` but not `false`.
	function parseBoolLiteral() returns ValueId throws ParseError
		let tok = self.current()
		var value = BoolTrueValue
		if self.at(TokenKind.true) 'isTrue'
			try self.consume(TokenKind.true)
		end 'isTrue' else 'isFalse'
			try self.consume(TokenKind.false)
			value = BoolFalseValue
		end 'isFalse'
		return self.emitLiteral(value, valueType: MaxonType.boolean, range: SourceRange.ofToken(tok))
	end 'parseBoolLiteral'

	// ⭐⭐ **`Self{x: x, y: y}` — WHERE THE HEAP ENTERS THE LANGUAGE.** The first, and at this rung
	// the only, expression that allocates.
	//
	// It lowers to exactly four kinds of op, none of them new:
	//
	//     literal   16                 -- the box's payload size (StructLayout.sizeBytes)
	//     literal   0                  -- the destructor (TrivialDestructor; see there)
	//     call      __mm_alloc         -- returns the PAYLOAD pointer; field i is at [ptr + i*8]
	//     storeIndirect <ptr> 0 <x>    -- one per field, at StructLayout.offsetOfField(i)
	//     storeIndirect <ptr> 8 <y>
	//
	// ⚠ **THE FIELDS ARE STORED IN DECLARATION ORDER, NOT IN THE ORDER THEY WERE WRITTEN**, and the
	// values are parsed in the order they were written. Both are true at once because the values are
	// evaluated into SSA ids as the literal is read, and the STORES are emitted afterwards by walking
	// the layout — so `Point{y: 4, x: 3}` evaluates `4` first and still puts `3` in slot 0. Emitting
	// each store as its field was parsed would have written the box in source order, which is the same
	// thing for these two cases and the wrong thing for one field in a slot the layout disagrees about.
	//
	// ⚠ **EVERY FIELD MUST END UP INITIALIZED, and the allocator's zeroing guarantee is what makes
	// that a RULE rather than a nicety.** An omitted slot reads back as a clean 0 — a plausible
	// number — so `Point{x: 1}` would silently have `y == 0`. E3086 rejects it.
	//
	// A slot gets its value from one of TWO sources, asked in this order: the literal
	// (`parseStructLiteralFields`), then the field's declared DEFAULT (`applyFieldDefaults`). The
	// literal always wins — the default is consulted only for a slot `filled` says nothing wrote.
	// `requireAllFieldsInitialized` then rejects whatever neither supplied.
	function parseStructLiteral(func IrFunction) returns ValueId throws ParseError
		let typeTok = self.current()
		let typeName = try self.readStructLiteralTypeName()
		let layout = try self.requireConstructible(typeName, anchor: typeTok)

		try self.consume(TokenKind.leftBrace)
		// Parallel to the LAYOUT, not to the source: `fieldValues[i]` is the value for the field the
		// type declares at `i`, whatever position the literal wrote it in. `filled` is what turns an
		// unwritten slot into E3086 rather than into a zero nobody chose.
		var fieldValues = ValueIdArray.create()
		var filled = BoolArray.create()
		for _ in 0 upto layout.fieldCount() 'initSlots'
			fieldValues.push(0 as ValueId)
			filled.push(false)
		end 'initSlots'

		try self.parseStructLiteralFields(func, layout: layout, fieldValues: fieldValues, filled: filled)
		let rbraceTok = try self.consume(TokenKind.rightBrace)

		// Defaults are applied BEFORE the check, which is what makes an omitted-but-defaulted field
		// legal without teaching `requireAllFieldsInitialized` a second rule. That one goes on
		// asking exactly what it always asked — "does every slot have a value by now?" — and a
		// default is simply one of the two ways a slot comes to have one.
		self.applyFieldDefaults(layout, fieldValues: fieldValues, filled: filled, anchor: typeTok)
		try self.requireAllFieldsInitialized(layout, filled: filled, anchor: typeTok)

		return self.emitStructLiteral(layout, fieldValues: fieldValues, range: SourceRange.between(typeTok, last: rbraceTok))
	end 'parseStructLiteral'

	// The type a struct literal names: `Self` (the enclosing type) or a bare identifier. Consumes it.
	function readStructLiteralTypeName() returns ByteArray throws ParseError
		if self.at(TokenKind.selfType) 'selfLiteral'
			let tok = try self.consume(TokenKind.selfType)
			if self.enclosingType.isEmpty() 'outsideAType'
				throw ParseError.unsupported("'{tok.kind.rawValue}' outside a type declaration (`Self` names the type whose body encloses it, and there is none here)", line: tok.line, column: tok.column)
			end 'outsideAType'
			return self.enclosingType
		end 'selfLiteral'

		let nameTok = try self.consume(TokenKind.identifier)
		return nameTok.value
	end 'readStructLiteralTypeName'

	// ⭐ **E3076 — CONSTRUCTION IS RESTRICTED TO THE TYPE'S OWN BODY.** `Self{…}` and `Point{…}`
	// inside `type Point`; nothing anywhere else. An external caller goes through
	// `Point.create(…)`.
	//
	// The point is that a type gets ONE place its invariants are established. Both reference
	// compilers impose exactly this restriction under exactly this code, and it is what makes
	// `static function create` the universal shape of the corpus rather than a convention.
	//
	// The order of the two rejections is the decision: a name that is not a struct AT ALL is not a
	// constructor-restriction violation, so it reports what it actually is.
	function requireConstructible(typeName ByteArray, anchor Token) returns StructLayout throws ParseError
		// The RESTRICTION is checked before the LOOKUP, and the order is the decision: `Foo{…}`
		// outside `type Foo` is E3076 whether or not `Foo` exists, because the restriction is about
		// WHERE the literal is written, not about what it names. Asking the registry first would
		// report "no such type" for a `Point{…}` written in `main` — naming a type that is right
		// there in the file, which is a confusing answer to a question the user did not ask.
		if not self.namesEnclosingType(typeName) 'outsideItsOwnBody'
			throw ParseError.constructorRestricted(String.from(typeName), line: anchor.line, column: anchor.column)
		end 'outsideItsOwnBody'

		match self.signatures.structOf(typeName) 'declared'
			declared(layout) then return layout
			// Unreachable: `namesEnclosingType` just held, so this IS the type currently being
			// declared — and the declaration sweep recorded every `type` in the program before this
			// file's parse began. A miss means the sweep and the real parse disagree about what a
			// type declaration is, which is the drift `ProgramSignatures.declaredOutcome` panics on
			// for a constant, stated here for a type.
			undeclared then panic("requireConstructible: `type {String.from(typeName)}` is being parsed right now, but the declaration sweep never recorded it — `recordScannedType` and `parseTypeDeclaration` disagree about what opens a type declaration")
		end 'declared'
	end 'requireConstructible'

	// The `name: value` pairs inside the braces, into the LAYOUT-parallel columns. The caller has
	// consumed `{`; this leaves the cursor on `}`.
	//
	// ⚠ **EVERY FIELD IS LABELLED, INCLUDING THE FIRST — which is the opposite of a CALL's rule**
	// (`consumeArgLabel`: the first argument is positional, E2052 if labelled). They are two
	// syntaxes, not one: a call's arguments are ordered by the DECLARATION and the first needs no
	// name to find its place, while a struct literal names slots outright. So this reads its own
	// labels rather than reusing the call's, and `slotCallArgs` is not involved — there is nothing
	// to reorder, because the label IS the destination.
	function parseStructLiteralFields(func IrFunction, layout StructLayout, fieldValues ValueIdArray, filled BoolArray) throws ParseError
		if self.at(TokenKind.rightBrace) 'noFields'
			return
		end 'noFields'

		while true 'fieldLoop'
			let nameTok = try self.consume(TokenKind.identifier)
			try self.consume(TokenKind.colon)

			let index = try self.requireFieldIndex(layout, fieldTok: nameTok)

			let alreadyFilled = try filled.get(index) otherwise panic("parseStructLiteralFields: filled.get OOB at {index} — the columns are sized to the layout's field count")
			if alreadyFilled 'duplicate'
				throw ParseError.duplicateFieldInitializer(String.from(layout.name), fieldName: String.from(nameTok.value), line: nameTok.line, column: nameTok.column)
			end 'duplicate'

			// The climber, not `parseExpression`, for `parseCallArgs`' reason: a field's value is
			// parsed INSIDE an expression that has already seeded `currentBlock`, and re-seeding it
			// would discard a short-circuit an earlier field performed.
			let value = try self.parseBinary(func, minPrec: OrPrecedence)
			try self.requireFieldType(layout, index: index, value: value, anchor: nameTok)

			try fieldValues.set(index, value: value) otherwise panic("parseStructLiteralFields: fieldValues.set OOB at {index} — the columns are sized to the layout's field count")
			try filled.set(index, value: true) otherwise panic("parseStructLiteralFields: filled.set OOB at {index} — the columns are sized to the layout's field count")

			if not self.at(TokenKind.comma) 'endFields'
				break
			end 'endFields'
			try self.consume(TokenKind.comma)
		end 'fieldLoop'
	end 'parseStructLiteralFields'

	// A field initializer must agree with the field's DECLARED type — `checkDeclaredType`, the same
	// COERCION-SITE rule a call argument, a `return` and an assignment ask, and deliberately not the
	// symmetric `typesAgree` an operator's two operands ask.
	//
	// It is the parser's to check and not SemanticCheck's, unlike a call ARGUMENT: a call's callee
	// may be declared in another file, but a struct literal's layout is already in hand here — the
	// parser had to have it to know the field exists at all.
	function requireFieldType(layout StructLayout, index FieldIndex, value ValueId, anchor Token) throws ParseError
		let declared = maxonTypeTag(self.signatures.fieldTypeOf(layout.name, index: index, into: self.artifact.typeNames))
		let got = self.tagOf(value)
		match checkDeclaredType(got, declared: declared) 'declared'
			ok then break 'declared'
			mismatch then throw ParseError.assignTypeMismatch(String.from(anchor.value), got: typeTagName(got), expected: typeTagName(declared), line: anchor.line, column: anchor.column)
			narrowsFloatToInt then throw ParseError.implicitNarrowing(typeTagName(got), targetType: typeTagName(declared), line: anchor.line, column: anchor.column)
		end 'declared'
	end 'requireFieldType'

	// ⭐ **FILL EVERY OMITTED SLOT THAT DECLARES A DEFAULT** — `export var value = 0` + `Self{}`.
	//
	// **A LITERAL-PROVIDED VALUE ALWAYS BEATS THE DEFAULT**, and `filled` is what says so: this only
	// ever looks at slots the literal did not write, so an override is not a race between two stores
	// — the default's `literal` op is never emitted at all. That is the rule
	// `field-initialization.md` states ("A literal-provided value always overrides a declared
	// default") and `literal-overrides-default` pins.
	//
	// The literal is minted at the field's STORAGE type, not its declared one: `emitLiteral` uses
	// one `MaxonType` for both the value's tag and the op's, and `maxonTypeToStdType` PANICS on a
	// `named` — so a field declared `as Integer = 7` would otherwise carry an alias into an op that
	// must be concrete by lowering. Nothing reads this value's tag (it flows straight into the
	// store), and `emitFieldStore` independently derives the same storage type for the slot, so the
	// two agree by construction.
	//
	// The span is the LITERAL's anchor — the `Self` token — and not the field declaration's, which
	// may be in another file entirely: a `SourceRange` is an offset into THIS file's bytes.
	function applyFieldDefaults(layout StructLayout, fieldValues ValueIdArray, filled BoolArray, anchor Token)
		let range = SourceRange.ofToken(anchor)
		for i in 0 upto layout.fieldCount() 'eachField'
			let wasFilled = try filled.get(i) otherwise panic("applyFieldDefaults: filled.get OOB at {i} — the column is sized to the layout's field count")
			if wasFilled 'literalWins'
				continue
			end 'literalWins'

			match layout.fieldDefault(i) 'declared'
				// The literal did not fill this slot and the declaration offers nothing. That is
				// E3086, and `requireAllFieldsInitialized` is what says so — not this function.
				none then continue
				literal(payload) then self.fillFieldDefault(layout, index: i, payload: payload, fieldValues: fieldValues, filled: filled, range: range)
			end 'declared'
		end 'eachField'
	end 'applyFieldDefaults'

	// Emit one default's `literal` and record it as slot `index`'s value. Split out so the payload
	// is bound by the match arm that proved there IS one, rather than read back out of the union
	// through an accessor with a `none` case to mishandle.
	function fillFieldDefault(layout StructLayout, index FieldIndex, payload ParsedInt, fieldValues ValueIdArray, filled BoolArray, range SourceRange)
		let declared = self.signatures.fieldTypeOf(layout.name, index: index, into: self.artifact.typeNames)
		let value = self.emitLiteral(payload, valueType: self.fieldStorageType(declared), range: range)

		try fieldValues.set(index, value: value) otherwise panic("fillFieldDefault: fieldValues.set OOB at {index} — the column is sized to the layout's field count")
		try filled.set(index, value: true) otherwise panic("fillFieldDefault: filled.set OOB at {index} — the column is sized to the layout's field count")
	end 'fillFieldDefault'

	// Every declared field must have been given a value — see `parseStructLiteral` for why the
	// allocator's zeroing guarantee makes an omission a WRONG ANSWER rather than a safe default,
	// and `applyFieldDefaults` for the other way a slot comes to have one.
	// Reports the FIRST omitted field, in declaration order, so the message is a function of the
	// type rather than of a hash walk.
	function requireAllFieldsInitialized(layout StructLayout, filled BoolArray, anchor Token) throws ParseError
		for i in 0 upto layout.fieldCount() 'eachField'
			let wasFilled = try filled.get(i) otherwise panic("requireAllFieldsInitialized: filled.get OOB at {i} — the column is sized to the layout's field count")
			if wasFilled 'given'
				continue
			end 'given'
			let fieldName = try layout.fieldNames.get(i) otherwise panic("requireAllFieldsInitialized: fieldNames.get OOB at {i}")
			throw ParseError.fieldNotInitialized(String.from(layout.name), fieldName: String.from(fieldName), line: anchor.line, column: anchor.column)
		end 'eachField'
	end 'requireAllFieldsInitialized'

	// Emit the box: allocate, then fill every slot. `fieldValues` is parallel to the LAYOUT.
	//
	// The result is typed `structRef(layout.name)` — which is what makes `let p = Point.create(…)`
	// bind a Point rather than an integer, since the factory returns this value and
	// `parseTypeReference` typed its `returns Self` the same way. The two meet at
	// `parseReturnStatement`'s `checkDeclaredType`, and they agree because both came from the
	// enclosing type's name.
	function emitStructLiteral(layout StructLayout, fieldValues ValueIdArray, range SourceRange) returns ValueId
		let size = self.emitLiteral(layout.sizeBytes(), valueType: MaxonType.integer, range: range)
		let destructor = self.emitLiteral(TrivialDestructor, valueType: MaxonType.integer, range: range)

		var allocArgs = ValueIdArray.create()
		allocArgs.push(size)
		allocArgs.push(destructor)
		let box = self.emitRuntimeCall(MmAllocName, args: allocArgs, resultTag: ValueTypeTag.structRef, resultNameId: self.artifact.typeNames.intern(layout.name), range: range)

		for i in 0 upto layout.fieldCount() 'eachField'
			let value = try fieldValues.get(i) otherwise panic("emitStructLiteral: fieldValues.get OOB at {i} — the column is sized to the layout's field count")
			self.emitFieldStore(box, layout: layout, index: i, value: value, range: range)
		end 'eachField'

		return box
	end 'emitStructLiteral'

	// ⭐ **THE THREE DOTTED EXPRESSIONS**, split here and nowhere else. The cursor is on an
	// identifier followed by `.`, and the language now spells three unrelated things that way:
	//
	//   1. `Point.create(3, y: 4)` — a QUALIFIED STATIC CALL. Recognized by the `(` at +3, which is
	//      the token neither of the others can have: `u16.max(` is not legal Maxon (a bound is a
	//      value, not a callee) and `p.x(` would be a call THROUGH a field, which needs the
	//      function-typed values P1.2 brings.
	//   2. `p.x` — a FIELD ACCESS, when the base name is bound in this function's scope. Asked
	//      SECOND and by SCOPE, which is the same "LOCAL FIRST" rule `parseVariableReference`
	//      already resolves a bare name by: a local named `u16` would shadow the sized type, exactly
	//      as a local `OFFSET` shadows a top-level constant of that name.
	//   3. `u16.max` — a TYPE-QUALIFIED NUMERIC BOUND, the fallback. It was the only dotted form the
	//      language had, and it stays the answer for a base name that is neither callable nor bound.
	//
	// The order is the decision. Testing the bound table FIRST would have to guess whether `p` is a
	// sized type before knowing `p` is a local, and `sizedTypeBound` answers `notASizedType` for
	// every struct — so `p.x` would have reported "expected a sized numeric type (u8/u16/…)" for a
	// perfectly good field read.
	function parseDottedPrimary(func IrFunction) returns ValueId throws ParseError
		// ⭐ **A BOUND BASE IS A VALUE, AND A VALUE OUTRANKS A TYPE NAME.** `p.x` and `p.add(10)` are
		// an instance's field and an instance's METHOD; `Point.create(10)` is a static method, and
		// `u16.max` is a bound. The base being IN SCOPE is what tells the first two from the last
		// two, and it is asked FIRST for `parseVariableReference`'s stated reason: a local binding
		// shadows a name from any wider scope, which is what every language with both does.
		//
		// ⚠ **THE `(` AT +3 IS NOT ENOUGH TO FIND A STATIC CALL**, and that is the trap this order
		// avoids: `p.add(10)` and `Point.create(10)` have IDENTICAL token shapes. Testing `(` first
		// sends `p.add(10)` to `parseQualifiedCall`, which would mangle the callee out of the
		// VARIABLE's name — `p.add`, which no file declares — and report E3004 against a method that
		// is right there in the type. `methodCallsAt` is where that scope test lives, shared with the
		// statement dispatcher.
		if self.methodCallsAt(self.pos) 'methodCall'
			return try self.parseMethodCall(func, resultUsed: true)
		end 'methodCall'

		if self.scope.contains(self.baseBindingName(self.current())) 'fieldAccess'
			return try self.parseFieldAccess()
		end 'fieldAccess'

		if self.kindAt(self.pos + 3) == TokenKind.leftParen 'qualifiedCall'
			return try self.parseQualifiedCall(func)
		end 'qualifiedCall'

		// `Color.red` — an ENUM CASE reference, the value being the case's tag. Asked AFTER the three
		// forms above (a bound base outranks a type name, exactly as `u16.max` is the last resort) and
		// BEFORE the sized-bound fallback, because a declared enum name is not a sized type and would
		// otherwise report "expected a sized numeric type" for a perfectly good case reference.
		match self.signatures.enumOf(self.current().value) 'enumRef'
			declared(layout) then return try self.parseEnumLiteral(layout)
			undeclared then break 'enumRef'
		end 'enumRef'

		return try self.parseTypeQualifiedBoundExpression()
	end 'parseDottedPrimary'

	// `Color.red` — the value of an enum/union case: its TAG, as an i64 `literal` (the raw value for
	// an int backing, the IEEE-754 bit pattern for a float). Named `Color.green` for a case the enum
	// does not have is E3034, positioned at the TYPE name (the bootstrap's anchor, measured).
	//
	// ⭐ The value is TAGGED `named(Color)` while its literal op is typed `integer`, and the two are
	// deliberately different: the TAG carries the enum's name so a `match` can recognize the scrutinee
	// as a `Color`, and the OP's `integer` type is what the Std lowering reads to give it an i64
	// (a `named` op-type would hit `maxonTypeToStdType`'s panic). Both collapse to i64, so the value's
	// register class and its lowering agree — see `emitEnumTagLiteral`.
	function parseEnumLiteral(layout EnumLayout) returns ValueId throws ParseError
		let typeTok = try self.consume(TokenKind.identifier)
		try self.consume(TokenKind.dot)

		let caseTok = self.current()
		if not tokenNamesEnumCase(caseTok) 'notACaseName'
			throw ParseError.unexpectedToken("an enum case name", got: caseTok.kind.rawValue, line: caseTok.line, column: caseTok.column)
		end 'notACaseName'
		self.advance()

		let index = try self.enumCaseIndexOrThrow(layout, nameTok: caseTok, posTok: typeTok)

		return self.emitEnumTagLiteral(layout.name, tag: layout.tagOfIndex(index), range: SourceRange.ofToken(typeTok))
	end 'parseEnumLiteral'

	// Emit a case's TAG as an i64 `literal` whose VALUE tag is `named(<enum>)`. The one site that
	// mints an enum value, so the tag/op-type split (see `parseEnumLiteral`) lives in exactly one
	// place. The const is deliberately NOT recorded (an enum value is not folded into arithmetic — it
	// is only ever a `match` scrutinee), mirroring `emitLiteralIn`, which records a constant only for
	// an `integer`-TAGGED value.
	function emitEnumTagLiteral(enumName ByteArray, tag ParsedInt, range SourceRange) returns ValueId
		let nameId = self.artifact.typeNames.intern(enumName)
		let result = self.mintValue(ValueTypeTag.named, nameId: nameId)
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.literal(result, value: tag, valueType: MaxonType.integer), range: range)
		return result
	end 'emitEnumTagLiteral'

	// `Point.create(3, y: 4)` — a call to a type's static method.
	//
	// It is an ORDINARY call with a mangled name, and that is the whole implementation: the callee
	// is `Point.create`, which is exactly the key `parseFunction` declared the method under
	// (`declaredMethodName`), so `emitCall` types the result from the signature index and
	// `slotCallArgs` reorders `y: 4` against the declaration — the SAME slotting every free call
	// gets, not a second one. A static method has no receiver, so there is nothing else to pass.
	//
	// ⚠ The base is NOT checked to be a declared type here, and that is deliberate rather than
	// missing: `Foo.bar()` where `Foo` is nothing at all resolves to a callee `Foo.bar` that no file
	// declares, which `SemanticCheck.validateCall` reports as E3004 — the authority for "no such
	// function", reading the registry the real parse built. A check here would be a second opinion
	// from the tolerant sweep, and the sweep must never own a veto (see `CalleeReturn.undeclared`).
	//
	// ⚠ **`Adder.add(5)` — AN INSTANCE METHOD NAMED STATICALLY — REACHES HERE, AND IS REJECTED BY
	// ARITY RATHER THAN BY WHAT IT IS.** It carries no receiver, so its argument list is one short
	// of the signature (whose parameter 0 is `SelfParamName`) and `validateCall` reports E3036. The
	// program is refused, which is right, but it is refused for the wrong reason and the honest fix
	// is a diagnostic that says an instance method needs a receiver — which no corpus case covers,
	// so it is recorded rather than invented here. (The COUNTS that E3036 carries are inflated by
	// the receiver, which is not this routine's doing and is not restated here — see the receiver
	// prepend in `parseCallNamed`, the one place that causes it, for both callers.)
	function parseQualifiedCall(func IrFunction) returns ValueId throws ParseError
		let typeTok = try self.consume(TokenKind.identifier)
		try self.consume(TokenKind.dot)
		return try self.parseCallNamed(func, callee: qualifiedMethodName(typeTok.value, methodName: self.current().value), anchor: typeTok, receiver: ReceiverArg.none, resultUsed: true)
	end 'parseQualifiedCall'

	// ⭐ **`p.add(10)` / `self.add(10)` — AN INSTANCE METHOD CALL, WHICH IS AN ORDINARY DIRECT CALL
	// WITH ONE EXTRA ARGUMENT.**
	//
	// The callee is `Adder.add` — mangled from the RECEIVER'S DECLARED TYPE and the method name,
	// which is exactly the key `parseFunction` declared it under (`declaredMethodName`), the same
	// key `Point.create` is linked by. So the result is typed from the signature index, arguments
	// are slotted by `slotCallArgs`, arity and labels are validated by `SemanticCheck`, and the
	// backend passes the receiver in argument register 0 — none of which learns that methods exist.
	//
	// **THE RECEIVER IS PREPENDED AS ARGUMENT 0, AND THAT IS THE ENTIRE DISPATCH MECHANISM.** It
	// pairs with the `SelfParamName` parameter `parseFunction` pushed at position 0: the call's
	// first argument is POSITIONAL, so `slotCallArgs` puts it at position 0 without being told
	// anything, and the user's `10` — also positional, at index 1 — lands on the first user
	// parameter. The two halves meet through the ordinary label rules and nothing else.
	//
	// ⭐ **THE RECEIVER IS BORROWED — the callee neither owns it nor drops it.** It is passed as a
	// parameter, and a parameter is not owned by the callee: the CALLER owns the +1, so no incref
	// is emitted here and no drop is emitted there. The receiver's box is dropped by the binding
	// that owns it, at ITS scope exit (`ownedBindings`), which is why `c.increment()` twice over
	// followed by `c.getCount()` is well-defined and returns 42 rather than reading freed memory.
	// Both references agree for the receiver specifically — the bootstrap gives `self`
	// `OwnershipFlags.IsParam`, and v1's `__self` is param 0, which its refcounter treats as a
	// borrow — so this is not the borrow-vs-consume ruling struct-typed PARAMETERS are deferred
	// for. A consume would have to be a SINK: a store of the RECEIVER into heap storage, or its
	// passing to a callee that consumes it.
	//
	// ⚠ **THE SINK IS UNREACHABLE BECAUSE `self` IS NOT A VALUE — NOT BECAUSE FIELDS ARE SCALAR.**
	// This comment claimed the latter ("this rung has scalar and float fields only, so there is
	// nowhere to store it") and it is FALSE, measured: `var next as Node` inside `type Node` is a
	// legal struct-typed field (`parseTypeReference` mints a `structRef` for the enclosing type's
	// own name), and `function link(other Node) → next = other` compiles TODAY, to
	// `storeBaseDispReg.word64 [rcx + 8], rdx`. Heap storage, holding a struct pointer, with no
	// incref. The sink exists. What does not exist is a way to put THE RECEIVER in it:
	// `parseSelfPrimary` refuses a bare `self` as a value, so `next = self` never parses. That
	// refusal is the whole load-bearing mechanism, and it lives one function away — which is
	// exactly why it is named here rather than left to be re-derived. The absence of an incref on
	// the receiver is correct; the reason previously written down was not the reason.
	//
	// ⚠ **THE RUNG THAT MAKES THE SINK REPRESENTABLE MUST REVISIT THIS**, and it is the one that
	// gives a field a struct or `String` type — a method that stores `self` into durable storage is
	// real and the stdlib exercises it. It inherits TWO things, not one: this receiver-ownership
	// question, and the `next = other` store above, which is a live un-increfed store that no
	// analysis checks (`requireStructBase` refuses every path that could OBSERVE such a field, so
	// nothing today can read the dangling pointer back out — that is containment, not a fix). v1
	// does not assert "the receiver is borrowed" anywhere: it FALLS OUT of `__self` being param 0
	// plus a structural per-param consume analysis (`ParamConsumeAnalysis.maxon:5-13`). shv2 will
	// need that analysis at the moment a sink can be written, and not before.
	function parseMethodCall(func IrFunction, resultUsed bool) returns ValueId throws ParseError
		let baseTok = self.current()
		self.advance()
		try self.consume(TokenKind.dot)

		let base = try self.requireStructBase(self.scope.getInfo(self.baseBindingName(baseTok)), baseTok: baseTok)

		return try self.parseCallNamed(func, callee: qualifiedMethodName(base.layout.name, methodName: self.current().value), anchor: baseTok, receiver: ReceiverArg.value(base.box), resultUsed: resultUsed)
	end 'parseMethodCall'

	// The SCOPE name a base token denotes. `self` is a keyword, so it carries no binding name of its
	// own; it names the receiver parameter, which is bound under `SelfParamName`. Every other base
	// token names itself.
	//
	// One home, because `p.x`, `p.m()` and their `self` spellings all have to answer it the same
	// way — and because it is the ONLY place the `self` token and the receiver parameter's name are
	// connected. A second copy is a second chance to look the receiver up under the word the source
	// happened to write.
	function baseBindingName(tok Token) returns ByteArray
		return SelfParamName if tok.kind == TokenKind.self else tok.value
	end 'baseBindingName'

	// `p.x` — read field `x` out of the box `p` points at.
	//
	// ⭐ **IT RIDES `loadIndirect`, THE OP A GLOBAL'S READ ALREADY USES** (`emitGlobalLoad`), with a
	// real offset where that one passes `GlobalSlotOffset`. There is no `fieldLoad` op and there is
	// not going to be one: the Std memory band is the GENERAL pair, and P1.0d.5b's comments said so
	// while this rung was still called P1.1 ("the offset field is not dead weight — it is what
	// `point.x` will carry, through this same op").
	//
	// The type comes off the BINDING, not off the value column's tag alone: `VarInfo.varType` is a
	// `structRef` carrying the struct's interned name id, and that name is what the layout registry
	// is keyed by. So `p.x` resolves through the same two steps a human does — which type is `p`,
	// and which slot does that type call `x`.
	function parseFieldAccess() returns ValueId throws ParseError
		let baseTok = try self.consume(TokenKind.identifier)
		try self.consume(TokenKind.dot)
		let fieldTok = try self.consume(TokenKind.identifier)

		// The binding is fetched ONCE and `requireStructBase` reads both facts off it: `parseDotted
		// Primary` routed here on `scope.contains`, so it exists, and its layout and the box it is
		// held in are one answer (see `StructBase`). Asking `Scope` twice would be two hash lookups
		// for one answer.
		let base = try self.requireStructBase(self.scope.getInfo(baseTok.value), baseTok: baseTok)
		let index = try self.requireFieldIndex(base.layout, fieldTok: fieldTok)
		try self.requireFieldAccessible(base.layout, index: index, fieldTok: fieldTok)

		return self.emitFieldLoad(base.box, layout: base.layout, index: index, range: SourceRange.between(baseTok, last: fieldTok))
	end 'parseFieldAccess'

	// ⭐⭐ **A SELF-FIELD READ — `count` AND `self.count`, ONE PATH.**
	//
	// Both spellings mean the same thing, so both resolve to the same `(layout, index)` and hand it
	// to `emitFieldLoad` — **the very routine `p.x` uses**, emitting the same `loadIndirect` at the
	// same offset with the same storage type. The two spellings differ in exactly one step, and it
	// is the step they *have* to differ in: `self.count` names its field with a TOKEN, so it asks
	// `requireFieldIndex` (and can report E3018); a bare `count` came off an alias that
	// `declareSelfFieldAliases` minted by enumerating the layout, so its index is already known and
	// provably valid.
	//
	// ⚠ **v1 SPLITS THIS AND SHV2 MUST NOT — the split is what this rung exists to not inherit.**
	// There, a bare `x` gets dedicated `selfFieldLoad`/`selfFieldStore` ops carrying the receiver
	// out-of-band with slot 0 hardcoded in lowering, while `self.x` gets an ordinary `varLoad` +
	// `fieldLoad`. Two ops, two lowerings, one fact — and it cost v1 twice over:
	//   • its E3014 walker inspects only `fieldLoad`/`fieldStore`, so a bare-name access is
	//     STRUCTURALLY invisible to field visibility (TypeResolution.maxon:8183-8188);
	//   • inside a closure there is no receiver slot, so the hardcoded slot 0 *"would load
	//     garbage"* and the closure path must re-route to the explicit form
	//     (Parser.maxon:18179-18189).
	// Neither is reachable here, and not because they were fixed — because the second path that
	// would have to be kept in step does not exist. `Project.maxon`'s `VarInfo.isSelfField` states
	// the rule; this is where it is obeyed.
	function parseSelfFieldRead(nameTok Token, binding VarInfo) returns ValueId throws ParseError
		return self.emitFieldLoad(try self.requireReceiverValue(nameTok), layout: try self.enclosingLayout(nameTok), index: binding.fieldIndex, range: SourceRange.ofToken(nameTok))
	end 'parseSelfFieldRead'

	// `count = <expr>` — write a field of the enclosing type through the receiver, named bare. The
	// mirror of `parseSelfFieldRead`, landing on `emitFieldStore` exactly as `p.x = 5` does.
	//
	// ⭐ **THE RECEIVER'S OWN MUTABILITY IS NOT ASKED, AND THAT IS THE LANGUAGE'S RULE, NOT AN
	// OMISSION.** `parseFieldAssignment` demands a mutable INSTANCE because `let p` refuses a write
	// through it; here the instance is `__self`, a parameter, and every parameter is bound
	// immutable — so asking would report E2013 against `self.n = self.n * 2` in every mutating
	// method the corpus has. The corpus is also what settles that this is right rather than
	// convenient: `let acc = Accumulator.create(0)` followed by `acc.add(10)` expects **42**
	// (specs/self-keyword.md, `self-with-params`). A `let` on a struct binding refuses a REBIND
	// (`acc = other`) and a direct field write through it (`acc.total = 1`, E2013 — structs.md pins
	// it); it does not reach inside the type's own methods.
	//
	// What IS asked is the FIELD's mutability — `layout.fieldIsMutable`, the same column and the
	// same diagnostic `c.version = 2` gets, because it is the same question. Anchored at the name
	// token, which is the only token there is.
	function parseSelfFieldAssignment(func IrFunction, block IrBlock, nameTok Token, binding VarInfo) throws ParseError
		try self.emitCheckedSelfFieldStore(func, block: block, receiver: try self.requireReceiverValue(nameTok), layout: try self.enclosingLayout(nameTok), index: binding.fieldIndex, fieldTok: nameTok, range: SourceRange.ofToken(nameTok))
	end 'parseSelfFieldAssignment'

	// **THE ONE SELF-FIELD WRITE**, shared by the two spellings: the bare `count = 1` and the
	// explicit `self.count = 1`. Everything a write decides lives here — whether the field accepts
	// one, when the right-hand side is parsed, what type it must have, and the store itself — so
	// the two spellings cannot come to disagree about any of it. They differ only in how the index
	// was found and which tokens the span covers, which is all either caller passes in.
	//
	// The right-hand side is parsed AFTER the rejection, so a refused program emits no op —
	// `emitCheckedGlobalStore`'s discipline, and its name, for its reason.
	function emitCheckedSelfFieldStore(func IrFunction, block IrBlock, receiver ValueId, layout StructLayout, index FieldIndex, fieldTok Token, range SourceRange) throws ParseError
		if not layout.fieldIsMutable(index) 'immutableField'
			throw ParseError.assignToImmutableField(String.from(layout.name), fieldName: String.from(fieldTok.value), line: fieldTok.line, column: fieldTok.column)
		end 'immutableField'

		let value = try self.parseExpression(func, block: block)
		try self.requireFieldType(layout, index: index, value: value, anchor: fieldTok)

		self.emitFieldStore(receiver, layout: layout, index: index, value: value, range: range)
	end 'emitCheckedSelfFieldStore'

	// `self.x` / `self.m(…)` — the receiver named explicitly. `self` is its own KEYWORD token, so it
	// cannot ride the identifier paths; what it can do is resolve to the same two destinations they
	// do, which is what this routine is for.
	//
	// The `(` at +3 splits them, exactly as `parseDottedPrimary` splits `p.x` from `p.m(…)` — one
	// lookahead, written the same way, because it is the same question about the same three tokens.
	//
	// A BARE `self` — not followed by a dot — is the receiver as a VALUE, which means returning or
	// passing a struct. That is P1.4's ownership ruling (a struct crossing a call boundary), so it
	// is a positioned `unsupported` naming the rung rather than a confusing parse failure. No
	// corpus case needs it: `self-modify-and-return` returns `self.n`, the FIELD.
	function parseSelfPrimary(func IrFunction) returns ValueId throws ParseError
		let selfTok = self.current()

		// The receiver is required for EITHER destination, so it is established once, here, before
		// the split — which is also what keeps `self` in a `static function` out of
		// `parseMethodCall`, whose binding lookup would panic rather than report.
		_ = try self.requireReceiverValue(selfTok)

		if self.peekKind() != TokenKind.dot 'bareSelf'
			throw ParseError.unsupported("'{selfTok.kind.rawValue}' as a value (a field can be read THROUGH the receiver — `self.x`, or a bare field name — but passing or returning the receiver itself hands a struct across a call boundary, which needs the ownership ruling struct-typed parameters and returns are deferred to)", line: selfTok.line, column: selfTok.column)
		end 'bareSelf'

		if self.methodCallsAt(self.pos) 'methodCall'
			return try self.parseMethodCall(func, resultUsed: true)
		end 'methodCall'

		return try self.parseExplicitSelfFieldRead()
	end 'parseSelfPrimary'

	// `self.x` in value position. It asks `requireFieldIndex` where the bare spelling reads the
	// alias's index — see `parseSelfFieldRead` for why that is the one legitimate difference — and
	// converges on the same `emitFieldLoad`.
	function parseExplicitSelfFieldRead() returns ValueId throws ParseError
		let selfTok = try self.consume(TokenKind.self)
		try self.consume(TokenKind.dot)
		let fieldTok = try self.consume(TokenKind.identifier)

		let layout = try self.enclosingLayout(selfTok)
		return self.emitFieldLoad(try self.requireReceiverValue(selfTok), layout: layout, index: try self.requireFieldIndex(layout, fieldTok: fieldTok), range: SourceRange.between(selfTok, last: fieldTok))
	end 'parseExplicitSelfFieldRead'

	// `self.x = <expr>`. The explicit spelling, resolving its field token to an index and then
	// handing over to the one shared write above — so both spellings ask one mutability rule and
	// emit one store.
	function parseExplicitSelfFieldAssignment(func IrFunction, block IrBlock) throws ParseError
		let selfTok = try self.consume(TokenKind.self)
		try self.consume(TokenKind.dot)
		let fieldTok = try self.consume(TokenKind.identifier)
		try self.consume(TokenKind.equals)

		// The receiver first, so `self.x = 1` in a `static function` reports what is actually wrong
		// rather than tripping over the enclosing type's layout.
		let receiver = try self.requireReceiverValue(selfTok)
		let layout = try self.enclosingLayout(selfTok)
		try self.emitCheckedSelfFieldStore(func, block: block, receiver: receiver, layout: layout, index: try self.requireFieldIndex(layout, fieldTok: fieldTok), fieldTok: fieldTok, range: SourceRange.between(selfTok, last: fieldTok))
	end 'parseExplicitSelfFieldAssignment'

	// `p.x = <expr>` — write field `x` of the box `p` points at. The exact mirror of
	// `parseFieldAccess`: the same three tokens resolved through the same two steps (which type is
	// `p`, which slot does that type call `x`), landing on `storeIndirect` where that one lands on
	// `loadIndirect`. There is no `fieldStore` op for the same reason there is no `fieldLoad`.
	//
	// ⭐ **TWO THINGS MUST BE MUTABLE AND THEY ARE TWO DIFFERENT FACTS**: the INSTANCE (`let p` is
	// not writable through) and the FIELD (`export let version` is not writable). Both report E2013
	// — one code, because it is one defect from two sides: a write to something declared not to
	// accept one. Both anchor at the ROOT VARIABLE token and not at the field, which is measured
	// from the bootstrap and pinned by `structs.md`'s two `error.*` cases at `:16:2`.
	//
	// ⭐ **RESOLVE, THEN PERMIT — AND THE ORDER IS THE WHOLE DIAGNOSTIC CONTRACT.** The checks below
	// run in two bands, and the band boundary is what makes every message name a change that
	// actually fixes the program:
	//
	//   1. RESOLUTION — is `p` a struct, and does it have a field `x`? Asked FIRST, and asked in the
	//      same order and through the same two helpers `parseFieldAccess` asks them, so a field
	//      WRITE and a field READ can never come to disagree about what `p.x` even DENOTES.
	//   2. PERMISSION — may this write happen? The instance, then the field.
	//
	// ⚠ A PERMISSION message can only ever advise "declare it `var`", so asking permission about a
	// write that does not RESOLVE names a change that does not work: `let n = 5` then `n.x = 1` once
	// reported *"cannot assign to immutable variable: 'n'"*, sending the reader to write `var n` —
	// which changes nothing, because an `int` has no fields. It now reports the not-a-struct error
	// the READ path always reported for the same three tokens. Same defect, same message, whichever
	// way the program touches the field.
	//
	// ⚠ **WITHIN the permission band, THE INSTANCE STILL OUTRANKS THE FIELD, and that too is a
	// decision.** When both fail — a `let` instance holding a `let` field — telling a reader to
	// write `var version` would not fix `let p`. In the bootstrap this ranking is a positional
	// ACCIDENT (`ResolveStructVariable(requireMutable: true)` happens to throw before
	// `RequireMutableField` runs) and nothing there declares it. `struct-field-assign-precedence.md`
	// pins BOTH ranks, because a rule stated only in the order of two `if`s is a rule the next edit
	// reorders.
	//
	// ⭐ **VISIBILITY (E3014) LANDS BETWEEN THE TWO, AND THE WHOLE BAND IS ONE CHAIN: EACH RANK IS
	// THE FIX THAT ACTUALLY WORKS NEXT.** The instance, then whether the field can be SEEN, then
	// whether it can be WRITTEN — because `export private` does not fix `let p`, and `var private`
	// does not fix a field the caller cannot reach at all. All three ranks are MEASURED against the
	// bootstrap, not inferred:
	//
	//   • `var v` + `let` unexported field  → **E3014** (visibility outranks field mutability)
	//   • `let v` + `var` unexported field  → **E2013 'v'** (the instance outranks visibility)
	//   • `v.nosuch`                        → **E3018** (resolution outranks all of it)
	//
	// The READ path asks the same chain minus its middle: it has no instance to write through, so
	// resolution is followed directly by visibility (`parseFieldAccess`).
	function parseFieldAssignment(func IrFunction, block IrBlock) throws ParseError
		let baseTok = try self.consume(TokenKind.identifier)
		try self.consume(TokenKind.dot)
		let fieldTok = try self.consume(TokenKind.identifier)
		try self.consume(TokenKind.equals)

		if not self.scope.contains(baseTok.value) 'undeclared'
			// A field store names a LOCAL box. A top-level `var` of struct type would resolve here
			// too, and cannot yet exist: a global holds a scalar until the heap reaches `.data`
			// (`readTopLevelBinding` rejects the rest), so there is no second lookup to miss.
			throw ParseError.undefinedVariable(String.from(baseTok.value), line: baseTok.line, column: baseTok.column)
		end 'undeclared'

		let binding = self.scope.getInfo(baseTok.value)
		let base = try self.requireStructBase(binding, baseTok: baseTok)
		let index = try self.requireFieldIndex(base.layout, fieldTok: fieldTok)

		try self.requireMutableBinding(binding, nameTok: baseTok)
		try self.requireFieldAccessible(base.layout, index: index, fieldTok: fieldTok)

		if not base.layout.fieldIsMutable(index) 'immutableField'
			throw ParseError.assignToImmutableField(String.from(base.layout.name), fieldName: String.from(fieldTok.value), line: baseTok.line, column: baseTok.column)
		end 'immutableField'

		// Parsed AFTER both rejections, so a refused program emits no op — `emitCheckedGlobalStore`'s
		// discipline, for its reason.
		let value = try self.parseExpression(func, block: block)
		try self.requireFieldType(base.layout, index: index, value: value, anchor: fieldTok)

		self.emitFieldStore(base.box, layout: base.layout, index: index, value: value, range: SourceRange.between(baseTok, last: fieldTok))
	end 'parseFieldAssignment'

	// Declare every field of the enclosing type as a self-field alias, so a bare `width` inside
	// `function area()` of `type Rect` resolves to `self.width`. Called at instance-method entry
	// only; `anchor` is the method's name token, which the layout lookup's diagnostic points at.
	//
	// The alias carries the field's INDEX and its declared TYPE, both read straight out of the
	// layout being enumerated — so the alias cannot name a field the type does not have, which is
	// what lets the read and write paths skip the "does this type have this field?" question that
	// `self.x` and `p.x` must ask.
	//
	// The type comes through `fieldTypeOf`, not off the layout's column directly, because that is
	// the door that RE-INTERNS a `named` type into this file's own interner — the same door
	// `emitFieldLoad` reads a field's type through. Reading the column raw would bind aliases to
	// type-name ids from the SWEEP's table, which this file's interner cannot resolve.
	function declareSelfFieldAliases(anchor Token) throws ParseError
		let layout = try self.enclosingLayout(anchor)
		for i in 0 upto layout.fieldCount() 'eachField'
			let fieldName = try layout.fieldNames.get(i) otherwise panic("declareSelfFieldAliases: fieldNames.get OOB at {i} for `type {String.from(layout.name)}`, which declares {layout.fieldCount()}")
			self.scope.declareSelfField(fieldName, varType: self.signatures.fieldTypeOf(layout.name, index: i, into: self.artifact.typeNames), fieldIndex: i)
		end 'eachField'
	end 'declareSelfFieldAliases'

	// The `StructLayout` of the type whose body encloses the cursor. The self-field twin of
	// `requireStructBase`: that one resolves the layout of a BINDING's declared type, this one
	// resolves the layout of the enclosing DECLARATION, which is what a receiver and a bare field
	// name are both typed by.
	//
	// Both misses panic rather than report, and for `requireConstructible`'s reason: every caller
	// is inside an instance method, so an enclosing type exists by construction, and the
	// declaration sweep recorded every `type` in the program before this file's parse began.
	function enclosingLayout(anchor Token) returns StructLayout throws ParseError
		if self.enclosingType.isEmpty() 'noEnclosingType'
			panic("enclosingLayout: asked for the enclosing type's layout at {anchor.line}:{anchor.column}, but the cursor is at file scope — every caller is inside an instance method, whose body only `parseTypeDeclaration` reaches")
		end 'noEnclosingType'

		match self.signatures.structOf(self.enclosingType) 'declared'
			declared(layout) then return layout
			undeclared then panic("enclosingLayout: `type {String.from(self.enclosingType)}` is being parsed right now, but the declaration sweep never recorded it — `recordScannedType` and `parseTypeDeclaration` disagree about what opens a type declaration")
		end 'declared'
	end 'enclosingLayout'

	// ⭐ **THE RECEIVER'S SSA VALUE — READ BACK, NEVER ASSUMED.** It is parameter 0, so it is
	// ValueId 0; but that is a CONSEQUENCE of the Std-ABI seeding `parseFunction` performs
	// (`ValueIdRef.create(paramCount)` reserves 0..paramCount-1 and `bindParameters` binds
	// parameter `i` to id `i`), not an independent fact. A literal `0` here would be that
	// convention written down a second time, in the one place that would keep compiling — and
	// silently reading the wrong value — the day the seeding changed.
	//
	// **IT IS ALSO THE ONE PLACE `self` IS REFUSED WHERE THERE IS NO RECEIVER**, because that is
	// the same question: the receiver is bound iff `parseFunction` pushed one, so a failed lookup
	// IS "this is not an instance method". A `static function` is the interesting case — it has an
	// enclosing type but no instance — and file scope has neither. Both report here, positioned,
	// rather than reaching `enclosingLayout` and panicking on an enclosing type that is absent or
	// irrelevant.
	function requireReceiverValue(anchor Token) returns ValueId throws ParseError
		return try self.scope.lookupValue(SelfParamName) otherwise throw ParseError.unsupported("'{anchor.kind.rawValue}' outside an instance method (`self` names the instance a method was called on; a `static function` is called on the type itself and has none)", line: anchor.line, column: anchor.column)
	end 'requireReceiverValue'

	// **The declaration index `fieldTok` names in `layout`, or E3018** — asked by every one of the
	// three places a field is named by a TOKEN: the struct literal's `x:` label, the field READ,
	// and the field WRITE. One home, because it is one question, and the three must not come to
	// disagree about what "this type has no such field" means or where the diagnostic points (the
	// FIELD token — the token that is wrong, never the value it is read from).
	//
	// A BARE self-field name does not ask it: its index came off the alias, which
	// `declareSelfFieldAliases` minted by enumerating the layout, so the field provably exists. A
	// bare name that is NOT a field is not a self-field alias at all and never reaches a field
	// path — it is an undefined variable, and reports as one.
	//
	// It is also the one place `indexOfField`'s "not found" convention is READ. That answer is
	// `fieldCount()` — an index one past the end — and every caller comparing against it by hand was
	// a caller that could get the comparison subtly wrong (`>` rather than `>=`) and index a
	// neighbouring field's slot instead of reporting an error. Now the convention is decoded once.
	function requireFieldIndex(layout StructLayout, fieldTok Token) returns FieldIndex throws ParseError
		let index = layout.indexOfField(fieldTok.value)
		if index >= layout.fieldCount() 'noSuchField'
			throw ParseError.unknownField(String.from(layout.name), fieldName: String.from(fieldTok.value), line: fieldTok.line, column: fieldTok.column)
		end 'noSuchField'
		return index
	end 'requireFieldIndex'

	// ⭐ **E3014 — A FIELD NOT DECLARED `export` IS REACHABLE ONLY FROM ITS OWN TYPE'S BODY.**
	//
	//     accessible  ==  the field is exported  OR  this code is inside the declaring type
	//
	// **THE GATE IS THE TYPE, NOT THE FILE**, and that is measured rather than inherited: `type B`
	// reading `type A`'s unexported field is E3014 on the bootstrap **in the same file**. BOTH
	// reference registries call it "another file" and both are wrong — v1's CODE agrees with the
	// measurement (it gates on `structName == enclosingType`, TypeResolution.maxon:8204) and only
	// its prose does not. `docs/error-codes.txt`'s doc line is corrected to match.
	//
	// ⚠ **AND THAT SENTENCE IS PINNED BY A SPEC, BECAUSE FOR ONE REVIEW-ROUND IT WAS NOT.** As
	// first written this comment asserted the type-vs-file rule while **nothing in the suite could
	// tell the two apart**: every corpus case reaches the field from `main()`, which is inside no
	// type, so they pin only *"outside ANY type ⇒ reject"*. Weakening the test below to
	// `not self.enclosingType.isEmpty()` — a compiler where every method reads every type's private
	// state — left `specs-shv2` at **392/0**, both corpus E3014 cases included (measured, not
	// argued). That is OPEN.md #27's shape exactly: the reason written down enforced nothing while
	// the property held for a reason nobody had written. `specs-shv2/field-visibility-is-type-scoped.md`
	// is the sabotage's red, kept: two cases that fail under that edit, plus the positive companion
	// (a type reaching its OWN private field through a LOCAL, which the self-field path never sees)
	// so the rule is pinned in the ADMIT direction too. **Do not delete it to make a refactor green.**
	//
	// **ONE HOME, TWO CALLERS** — the field READ and the field WRITE. It is one rule; written at
	// both sites, a future answer to what "accessible" means (a `module`-visible field, a friend
	// type) taught to one and not the other would let a private field be WRITTEN where reading it
	// correctly reports. An accepted access that should have been refused is a wrong answer, not a
	// compile error.
	//
	// `namesEnclosingType` is the SAME predicate `requireConstructible` (E3076) and
	// `parseTypeReference` ask — "am I inside type T's body?" — so visibility, construction and
	// `Self` cannot come to disagree about where a type's body ends.
	//
	// ⚠ **IT IS NOT ASKED AT THE STRUCT-LITERAL SITE, AND THE REASON IS THE SPEC'S, NOT E3076'S.**
	// Initialization is exempt outright: *"All fields (exported or not) can be initialized in
	// struct literals, since the type itself determines what fields exist. The visibility only
	// affects access after construction"* (specs/export-var-fields.md). In shv2 that exemption is
	// VACUOUS today — E3076 already refuses every literal written outside its own type's body, so
	// no out-of-type literal survives to ask — but it is the SPEC's rule that makes the absence
	// correct rather than merely unreachable, and it is written here so the day E3076 relaxes does
	// not silently take the exemption with it. (v1 needs the rule live, and spells it `isInit`.)
	//
	// ⚠ **NOR IS IT ASKED ON THE SELF-FIELD PATH**, where it could not fail: a bare `count` and
	// `self.count` both resolve through `enclosingLayout`, so `namesEnclosingType(layout.name)`
	// holds by construction. The rule is asked wherever it can be broken, which is wherever the
	// layout came from a BINDING's type rather than from the enclosing declaration.
	function requireFieldAccessible(layout StructLayout, index FieldIndex, fieldTok Token) throws ParseError
		if layout.fieldIsExported(index) 'exported'
			return
		end 'exported'
		if self.namesEnclosingType(layout.name) 'insideDeclaringType'
			return
		end 'insideDeclaringType'
		throw ParseError.unexportedFieldAccess(String.from(layout.name), fieldName: String.from(fieldTok.value), line: fieldTok.line, column: fieldTok.column)
	end 'requireFieldAccessible'

	// The box `binding` denotes and the `StructLayout` describing it — the two-step every field
	// access takes: the binding's declared type must BE a struct, and that struct must be one some
	// file declares.
	//
	// The second step cannot fail for a `structRef` the parser itself minted (it interned the id from
	// a name the sweep had already recorded), so it panics; the first very much can — `let n = 5`
	// then `n.x` — and reports. `baseTok` is only the token those diagnostics point at.
	//
	// ⭐⭐ **IT IS THE ONE READER OF A BASE BINDING'S `boundValue`, AND THAT IS WHY IT RETURNS THE
	// BOX AND NOT JUST THE LAYOUT.** A SELF-FIELD ALIAS HAS NO SSA VALUE: `createSelfField` leaves
	// `boundValue` 0 because a read of the alias is a `loadIndirect` through the receiver, not a
	// reference to a value — **and ValueId 0 IS THE RECEIVER**. So a caller that proved the layout
	// here and then reached for `binding.boundValue` on its own silently addressed `__self`.
	//
	// That is not a hazard this comment is imagining; it was MEASURED, on the three sites that did
	// exactly that. In a self-referential `type Node` (`var next as Node`, which
	// `parseTypeReference` types `structRef` through its `namesEnclosingType` arm):
	//   • `return next.a`      compiled to a single `loadRegBaseDisp r8, [rcx + 0]` — that is
	//                          `return self.a`, off the receiver, at the wrong field's offset.
	//   • `return next.readA()` compiled to a bare `callDirect Node.readA` with NO argument setup —
	//                          the receiver was already in `rcx`, so it is `self.readA()`.
	//   • `next.a = 99`        reported E2013 "cannot assign to immutable variable: 'next'", which
	//                          is simply false of an `export var` field.
	// The first two exit 0 with no diagnostic anywhere. `parseVariableReference` guards this same
	// fact for the bare-name path and its comment states it exactly; the fact was written down
	// once and needed in four places. Handing the box back from here is what makes the other three
	// unable to get it wrong.
	function requireStructBase(binding VarInfo, baseTok Token) returns StructBase throws ParseError
		if maxonTypeTag(binding.varType) != ValueTypeTag.structRef 'notAStruct'
			throw ParseError.unsupported("a field access on '{String.from(baseTok.value)}', which is declared '{typeTagName(maxonTypeTag(binding.varType))}' and not a struct type (only a struct has fields)", line: baseTok.line, column: baseTok.column)
		end 'notAStruct'

		// ⚠ **A STRUCT-TYPED FIELD USED AS A BASE IS REFUSED, NOT LOADED** — `next.a` inside `type
		// Node`'s own method. Tested AFTER the `structRef` gate above, so a SCALAR field's alias
		// (`count.x`, where `count` is an `Integer`) still reports what is actually wrong with it
		// rather than being blamed on a struct it is not.
		//
		// Reading it correctly means materializing the field first — `loadIndirect` the box out of
		// the receiver, then address THAT — which is one line, and is deliberately NOT taken here.
		// A struct-typed field cannot be CONSTRUCTED at this rung: `Self{next: …}` needs a `Node`
		// to put there, there is no `null` and no base case, so no program could observe the load
		// being right. That is the `mintPhi` trap exactly — a mechanism handed a consumer and no
		// reason to be right — and it is the same trap this rung's own scaffold waited out. It
		// arrives with the rung that gives a field a struct type, which is the rung that already
		// owes this one its receiver-ownership analysis (see `parseMethodCall`).
		if binding.isSelfField 'structTypedField'
			throw ParseError.unsupported("a field access through '{String.from(baseTok.value)}', which is a struct-typed FIELD of the enclosing type (its box has to be loaded out of the receiver before it can be addressed, which arrives with the rung that gives a field a struct type — no struct-typed field can be constructed yet)", line: baseTok.line, column: baseTok.column)
		end 'structTypedField'

		let typeName = try self.artifact.typeNames.nameOf(typeNameIdOf(binding.varType)) otherwise panic("requireStructBase: '{String.from(baseTok.value)}' carries a structRef whose name id is not in this file's interner — every structRef the parser mints is interned from a name in the same table")
		match self.signatures.structOf(typeName) 'declared'
			declared(layout) then return StructBase.create(layout, box: binding.boundValue)
			undeclared then panic("requireStructBase: '{String.from(baseTok.value)}' is typed `structRef({String.from(typeName)})` but no file declares that type — a structRef is only minted for a name the declaration sweep recorded (Parser.parseTypeReference)")
		end 'declared'
	end 'requireStructBase'

	// `loadIndirect <box> <offset>` — the one op a field read is.
	//
	// ⚠ **THE VALUE'S TAG AND THE OP'S `valueType` ARE DELIBERATELY DIFFERENT THINGS**, and reading
	// this as a redundancy is how it would get broken:
	//
	//   • the VALUE is minted with the field's DECLARED type — `named(Integer)` for a ranged alias —
	//     so the tag column keeps what the source said. THE SHIFT RULE reads it (`valueIsUnsigned`
	//     looks the alias's LOW BOUND up by name), so a field of `int(0 to u64.max)` right-shifts
	//     zero-filled, exactly as a PARAMETER of that type does.
	//   • the OP carries the field's STORAGE type — the resolved primitive — because
	//     `maxonTypeToStdType` PANICS on a `named`, and it panics on purpose: an op's type must be
	//     concrete by lowering, and `resolveTypes` rewrites signatures only, never op types.
	//
	// A parameter declared `Integer` already lives with exactly this split (`valueTagToStdType`'s
	// `named` arm exists for it), so this is that arrangement reaching one op further, not a new one.
	function emitFieldLoad(box ValueId, layout StructLayout, index FieldIndex, range SourceRange) returns ValueId
		let declared = self.signatures.fieldTypeOf(layout.name, index: index, into: self.artifact.typeNames)
		let result = self.mintValueOfType(declared)
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.loadIndirect(result, addr: box, offset: layout.offsetOfField(index), valueType: self.fieldStorageType(declared)), range: range)
		return result
	end 'emitFieldLoad'

	// `storeIndirect <box> <offset> <value>` — the one op a field write is, and the exact mirror of
	// `emitFieldLoad` (same offset, same storage type, same reason for each).
	//
	// **THE ONE STORE SITE**, shared by the two paths that write a field: the `Self{…}` loop filling
	// a fresh box (`emitStructLiteral`) and the assignment statement writing a live one
	// (`parseFieldAssignment`). They were one line apart from being two copies of the offset-and-
	// width derivation, which is the pair that must never disagree — a literal that stored `y` at
	// the width the layout says and an assignment that stored it at another would corrupt the box
	// silently.
	function emitFieldStore(box ValueId, layout StructLayout, index FieldIndex, value ValueId, range SourceRange)
		let declared = self.signatures.fieldTypeOf(layout.name, index: index, into: self.artifact.typeNames)
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.storeIndirect(box, offset: layout.offsetOfField(index), value: value, valueType: self.fieldStorageType(declared)), range: range)
	end 'emitFieldStore'

	// The CONCRETE `MaxonType` a field of declared type `declared` occupies its slot as — what the
	// `loadIndirect`/`storeIndirect` carries, and the only type in the compiler that says how wide
	// the access is.
	//
	// It resolves a `named` alias through `signatures.aliasOf`, the SAME whole-program door THE
	// SHIFT RULE already asks (`valueIsUnsigned`), for the same reason: an alias declared in another
	// file is still an alias here, and this file's own table would answer for neither it nor a
	// forward reference.
	//
	// ⚠ **IT IS THE SECOND STATEMENT OF "WHAT A `named` TYPE DENOTES", AND `TypeResolution.
	// resolveNamedType` IS THE FIRST.** That is not a duplication this rung introduced — it is the
	// standing shape of the two registries (see `ProgramSignatures.structTypes`): the sweep answers
	// the PARSER, the project registry answers the AUTHORITY, and the alias half has been written in
	// both places since ranged typealiases landed. What is new is that a field's type has to be
	// resolved at PARSE time at all, and that is forced by the op: `resolveTypes` never rewrites an
	// op's type, so the parser is the last tier that can make it concrete.
	function fieldStorageType(declared MaxonType) returns MaxonType
		match declared 'kind'
			// Already concrete. `structRef` included — a struct FIELD is a pointer, and
			// `maxonTypeToStdType` gives it the machine word without help.
			boolean to float then return declared
			exitCode then return declared
			structRef then return declared
			unresolved then panic("fieldStorageType: a field is declared `unresolved` — `parseTypeReference` produces only `named`, `structRef` and the three primitive keywords, so no field declaration can carry one")
			// A String field stores an i64 POINTER, exactly like a struct-ref field — `maxonTypeToStdType`
			// gives it the machine word. (No enabled case declares one; a String field can only hold an
			// immortal literal at Wave A, and the owned-heap-String field is Wave B's.)
			string then return declared
			named then break 'kind'
		end 'kind'

		let name = try self.artifact.typeNames.nameOf(typeNameIdOf(declared)) otherwise panic("fieldStorageType: a field's named type has an id that is not in this file's interner — the layout's types are adopted through `fieldTypeOf`, which re-interns into exactly this table")
		match self.signatures.aliasOf(name) 'alias'
			declared(alias) then return alias.underlying
			// A field typed with a name NO file declares, or with a `type` the sweep recorded but
			// whose reference the parser typed `named` rather than `structRef` (a field declared
			// with its own struct's name is `structRef` and never reaches here). The FIRST is a user
			// error — E3011, which `TypeResolution` reports against the merged registry, the
			// authority — and it is not this routine's to report: the sweep is the tolerant half.
			// Returning `integer` keeps the op well-formed for the instant before the pipeline's
			// error gate throws, which is exactly what `resolveNamedType`'s own recovery does and
			// for the same reason.
			undeclared then return MaxonType.integer
		end 'alias'
	end 'fieldStorageType'

	// A type-qualified numeric bound used as a VALUE (`let x = u16.max`, `if v == u64.max`).
	// The same three tokens a range declaration's endpoint is built from, resolved through
	// the same table — so `int(0 to u64.max)` and `v == u64.max` can never disagree about
	// what `u64.max` is. It materializes an ordinary integer literal.
	function parseTypeQualifiedBoundExpression() returns ValueId throws ParseError
		let boundTok = self.current()
		let value = try self.parseTypeQualifiedBound()
		return self.emitLiteral(value, valueType: MaxonType.integer, range: SourceRange.ofToken(boundTok))
	end 'parseTypeQualifiedBoundExpression'

	// Resolve a variable reference to the SSA value its binding aliases — M2's
	// value-substitution model emits NO load op; the reference simply IS the bound
	// value. A name with no local binding may still be a TOP-LEVEL CONSTANT (which inlines) or a
	// TOP-LEVEL `var` (which loads); only a name that is none of the three is a positioned parse
	// error (undefinedVariable).
	//
	// LOCAL FIRST. A local binding SHADOWS a top-level constant of the same name — `let OFFSET = 10`
	// at file scope and `let OFFSET = 2` inside a function means 2 in that function, which is what
	// every language with both scopes does and what the bootstrap does (its constants are consulted
	// only once a bare name has failed to resolve as a local).
	//
	// **CONSTANT BEFORE GLOBAL, and the order costs nothing**: the two are disjoint by construction —
	// one storage key holds ONE decl, and `constantValueOf`/`globalDeclFor` each answer only for
	// their own kind — so at most one of the two probes can ever hit. The order is readability, not
	// precedence.
	// ⚠ **A SELF-FIELD ALIAS IS TESTED BEFORE `lookupValue`, AND THE ORDER IS LOAD-BEARING RATHER
	// THAN TIDY.** An alias aliases no SSA value — a read of it is a `loadIndirect`, so there is
	// nothing for `boundValue` to hold and it is left 0. `lookupValue` would hand that 0 back as if
	// it were the answer, and ValueId 0 is the RECEIVER: `return count` inside a method would
	// silently compile to `return self`, reading a box pointer as an integer. A wrong answer with
	// no diagnostic anywhere.
	function parseVariableReference() returns ValueId throws ParseError
		let tok = try self.consume(TokenKind.identifier)

		if self.scope.isSelfField(tok.value) 'selfField'
			return try self.parseSelfFieldRead(tok, binding: self.scope.getInfo(tok.value))
		end 'selfField'

		return try self.scope.lookupValue(tok.value) otherwise return try self.topLevelBindingReference(tok)
	end 'parseVariableReference'

	// A bare name that is not a local: a top-level constant, a top-level `var`, or nothing.
	function topLevelBindingReference(tok Token) returns ValueId throws ParseError
		match self.signatures.constantValueOf(tok.value, readerFilePath: self.filePath) 'constant'
			found(payload, tag) then return self.emitLiteral(payload, valueType: constantValueType(tag), range: SourceRange.ofToken(tok))
			notFound then break 'constant'
		end 'constant'

		return try self.topLevelGlobalRead(tok)
	end 'topLevelBindingReference'

	// ⭐ **A USE OF A TOP-LEVEL CONSTANT INLINES ITS VALUE, AND THAT IS THE WHOLE STORAGE MODEL.**
	//
	// The constant was folded to a number by the declaration sweep, so the reference materializes as
	// an ordinary `literal` op carrying it — indistinguishable, from here down, from a program that
	// wrote the number out. Nothing is loaded, no `.data` slot is reserved, no relocation is emitted
	// and no backend knows this feature exists: `return ANSWER` compiles to exactly what `return 42`
	// compiles to.
	//
	// Both reference compilers do precisely this. v1 rewrites the read op in place into a `literal`
	// (`rewriteUnresolvedRead`, TypeResolution.maxon:2915-2925) and its `.data` emitter walks
	// `topLevelVars` only — a constant is in a different map and the emitter never sees it. The
	// bootstrap mints a fresh literal per use (`EmitConstantLiteral`, 2-Parser.cs:16870-16900), whose
	// comment says it outright: "a top-level `let` reaches expression position already folded, as a
	// literal". Storage is what a top-level `var` needs, and that is P1.0d.5b.
	//
	// It goes through `emitLiteral`, so an inlined INTEGER constant lands in the parser's constant
	// column (`recordConst`) exactly as a written-out literal does — which is what keeps `let SHIFT =
	// 1` … `x shl SHIFT` folding, and THE SHIFT RULE seeing a count it can check.
	//
	// **A TOP-LEVEL `var` IS THE OTHER HALF OF THAT STORY, AND IT IS THE OPPOSITE ONE** — see
	// `topLevelGlobalRead` directly below. It is what P1.0d.5b added: the read that does NOT
	// disappear.

	// ⭐ **A USE OF A TOP-LEVEL `var` LOADS FROM ITS `.data` SLOT.** The exact inverse of a
	// constant's read: nothing is folded, a slot IS reserved, a relocation IS emitted, and the
	// backend very much knows this feature exists.
	//
	// It emits the GENERAL PAIR — `globalAddr` then `loadIndirect` — rather than a fused
	// `globalLoad`, per the Std memory band's contract: the same two ops a struct field (P1.1) and a
	// heap value (P1.2) read through. The address op is its own value, so a function that reads one
	// global twice materializes the address twice and the ordinary CSE that arrives with the Std
	// optimization passes will fold them — `globalAddr` declares `isPure: true` precisely so that it
	// can.
	//
	// ⚠ The load is NOT hoisted out of a loop that writes the same global, and that is not this
	// function's doing — it is `loadIndirect`'s `isPure: false` (see StdDialect). Get that wrong and
	// this emits perfectly correct IR that a later pass silently breaks.
	function topLevelGlobalRead(tok Token) returns ValueId throws ParseError
		match self.signatures.globalDeclFor(tok.value, readerFilePath: self.filePath) 'global'
			found(label, tag) then return self.emitGlobalLoad(label, tag: tag, range: SourceRange.ofToken(tok))
			notFound then throw ParseError.undefinedVariable(String.from(tok.value), line: tok.line, column: tok.column)
		end 'global'
	end 'topLevelGlobalRead'

	// `globalAddr <label>` then `loadIndirect <addr> 0` — the two ops a global's read is.
	//
	// OFFSET 0, ALWAYS: each global is its OWN labelled slot, so the label already names the exact
	// address and there is nothing to add to it. The offset field is not dead weight — it is what
	// P1.1's `point.x` will carry, through this same op.
	function emitGlobalLoad(label ByteArray, tag ValueTypeTag, range SourceRange) returns ValueId
		let valueType = constantValueType(tag)
		let addr = self.emitGlobalAddr(label, range: range)
		let result = self.mintValueOfType(valueType)
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.loadIndirect(result, addr: addr, offset: GlobalSlotOffset, valueType: valueType), range: range)
		return result
	end 'emitGlobalLoad'

	// `globalAddr <label>` then `storeIndirect <addr> 0 <value>` — a global's write, the mirror of
	// `emitGlobalLoad`. It defines no value: a store is a statement.
	function emitGlobalStore(label ByteArray, tag ValueTypeTag, value ValueId, range SourceRange)
		let addr = self.emitGlobalAddr(label, range: range)
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.storeIndirect(addr, offset: GlobalSlotOffset, value: value, valueType: constantValueType(tag)), range: range)
	end 'emitGlobalStore'

	// The `globalAddr` half both a read and a write open with. A POINTER, so its value is typed
	// `integer` — the Maxon tier has no pointer type today, and an address is a machine word; the
	// Std tier it lowers into is typeless anyway, and nothing dispatches on this value's tag (it is
	// read only by the load/store that follows).
	function emitGlobalAddr(label ByteArray, range SourceRange) returns ValueId
		let addr = self.mintValue(ValueTypeTag.integer, nameId: UnnamedTypeId)
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.globalAddr(addr, label: label), range: range)
		return addr
	end 'emitGlobalAddr'

	// --- The top-level constant evaluator (P1.0d.5a) ---
	//
	// ⭐ **ONE GRAMMAR, TWO OUTPUTS.** Below is a second walk over the same expression syntax
	// `parseBinary` walks — and it is the minimum irreducible duplication of this rung, so it is worth
	// being exact about what is and is not shared.
	//
	// SHARED, because every one of them is a DECISION: the precedence table (`infixPrecedence`), the
	// operator maps (`infixMaxonOp`, `infixCmpOp`, `comparisonOperator`), the operand rules
	// (`requireBinOpOperands`), the result types (`binOpResultTag`, `wordOpResultTag`), the folds
	// (`foldIntBinOp`, `foldIntUnaryOp`, `foldIntCompare`, `foldLogicalNot`), THE SHIFT RULE
	// (`shiftFillsWithSign` → `shiftOpcodeFor` → `evalShift`), the `not` reading (`notOperatorFor`),
	// the cursor, the literal decoders, and the bound table. A constant expression and a runtime one
	// therefore cannot come to MEAN different things — which is the failure that matters, because
	// `let X = 1 shl 64` folding to 1 while `x shl 64` computes 0 is a silent wrong answer, not a
	// compile error.
	//
	// NOT SHARED: the climb loop itself, because the two produce different things. `parseBinary`
	// EMITS OPS and yields a `ValueId`; this yields a NUMBER. They cannot be one function, and the
	// reason is not the return type — it is `and`/`or`. Over bools those are CONTROL FLOW in a
	// function body (`emitShortCircuit` mints blocks and a merge phi, and the phi is by construction
	// not a constant), while a top-level `let BOTH = true and true` must be the value `true`. The op
	// path is *right* to branch and this path is *right* to fold, so the fork is real. Both reference
	// compilers keep the same two walks for the same reason (2-Parser.cs's `EvalConstOr` ladder;
	// v1's `evaluateUnresolvedConstExpr`).
	//
	// The evaluator lives on `Parser` because everything it reads is a Parser's: the token cursor,
	// `intLiteralValue`, `parseTypeQualifiedBound`, `decodeCharLiteral`. It is driven from
	// `ProgramSignatures.walkConstInitializer`, which builds a throwaway Parser per declaration and
	// keeps the ARENA and the recursion. It emits no ops and touches no artifact.

	// Fold one declaration's initializer to its value. The cursor is seated on the recorded token
	// range, and the walk must consume ALL of it — see `requireInitializerConsumed`.
	export function evalConstInitializer(decl TopLevelDecl, stack TopLevelDeclIndexArray) returns ConstValue throws ConstEvalError
		self.pos = decl.initStart
		let value = try self.evalConstBinary(stack, minPrec: OrPrecedence)
		try self.requireInitializerConsumed(decl)

		return value
	end 'evalConstInitializer'

	// ⚠ A PARTLY-FOLDED INITIALIZER IS AN ERROR, NOT A TRUNCATION. The walk stops at the first token
	// it cannot fold; without this check the rest of the line is silently DISCARDED and the constant
	// quietly becomes whatever the prefix came to. It is the one failure mode the token-range model
	// has that a tree model does not, and the bootstrap guards it in the same place and words
	// (`ExpectConstInitializerFullyConsumed`, 2-Parser.cs:4979-4987).
	function requireInitializerConsumed(decl TopLevelDecl) throws ConstEvalError
		if self.pos >= decl.initEnd 'fullyConsumed'
			return
		end 'fullyConsumed'

		let tok = self.current()
		throw ConstEvalError.defective(ParseError.nonConstantInitializer(String.from(decl.name), leftover: self.tokenTextFrom(self.pos, endIndex: decl.initEnd), line: tok.line, column: tok.column))
	end 'requireInitializerConsumed'

	// The source text of a token range, as the diagnostic prints it. Space-joined rather than
	// reconstructed from byte offsets: this is a COLD path (a rejected program), and the tokens are
	// what the evaluator actually choked on.
	function tokenTextFrom(start TokenIndex, endIndex TokenIndex) returns String
		var text = ""
		for i in start upto endIndex 'each'
			let tok = self.tokenAt(i)
			if i > start 'separator'
				text = "{text} "
			end 'separator'
			text = "{text}{String.from(tok.value)}"
		end 'each'

		return text
	end 'tokenTextFrom'

	// The precedence-climbing core, mirroring `parseBinary`'s shape over values instead of ops. It
	// reads the SAME precedence table, so `1 + 2 * 3` is 7 in a constant for the same reason it is 7
	// in a function.
	function evalConstBinary(stack TopLevelDeclIndexArray, minPrec InfixPrecedence) returns ConstValue throws ConstEvalError
		var left = try self.evalConstUnary(stack)

		while true 'climb'
			let opTok = self.current()
			let prec = infixPrecedence(opTok.kind)
			if prec == NotAnInfixOperator or prec < minPrec 'stop'
				break
			end 'stop'

			self.advance()
			let rhsStart = self.pos
			let right = try self.evalConstBinary(stack, minPrec: prec + 1)
			left = try self.foldConstBinOp(left, right: right, opTok: opTok, countStart: rhsStart)
		end 'climb'

		return left
	end 'evalConstBinary'

	// Apply one binary operator to two constants, under the very rules the emitting path applies.
	//
	// **`and`/`or`/`xor` NEED NO SPECIAL CASE HERE, AND THAT IS NOT LUCK.** A bool's payload IS 0 or 1
	// (TypeRules' `BoolTrueValue`), so the BITWISE fold of two bools is already the LOGICAL answer —
	// `1 and 1` is 1, `0 or 1` is 1 — and `wordOpResultTag` supplies the `boolean` tag that says which
	// reading it was. The bootstrap writes the two readings out separately (`lhs is bool lb && rhs is
	// bool rb ? lb && rb : ll & rl`, 2-Parser.cs:4997-5031) and computes the identical answer both
	// ways. What is lost by folding rather than branching is only the ELISION, and a constant has no
	// side effect to elide.
	function foldConstBinOp(left ConstValue, right ConstValue, opTok Token, countStart TokenIndex) returns ConstValue throws ConstEvalError
		if comparisonOperator(opTok.kind) 'comparison'
			try self.requireConstComparable(left, right: right, opTok: opTok)
			try self.requireConstNotFloat(left, right: right, opTok: opTok)
			return ConstValue.create(foldIntCompare(infixCmpOp(opTok.kind), lhs: left.payload, rhs: right.payload), tag: ValueTypeTag.boolean)
		end 'comparison'

		let op = infixMaxonOp(opTok.kind)
		try self.requireConstOperands(op, left: left, right: right, opTok: opTok)
		try self.requireConstNotFloat(left, right: right, opTok: opTok)

		if shiftOperator(op) 'shift'
			return try self.foldConstShift(left, count: right, op: op, countStart: countStart)
		end 'shift'

		match foldIntBinOp(op, lhs: left.payload, rhs: right.payload) 'folded'
			folded(value) then return ConstValue.create(value, tag: binOpResultTag(op, left: left.tag, right: right.tag))
			// `foldIntBinOp` declines exactly one family here — a division or modulo whose answer is a
			// TRAP rather than a number (`1 / 0`, `i64.min / -1`); the shifts it also declines are
			// handled above (`shiftOperator`). A runtime `x / 0` panics, but a top-level constant has no
			// run time to panic IN: it is folded before the program exists, so there is no answer to
			// give and no later pass that could give one.
			notFoldable then throw ConstEvalError.defective(ParseError.constantDivisionByZero(opTok.kind.rawValue, line: opTok.line, column: opTok.column))
		end 'folded'
	end 'foldConstBinOp'

	// ⭐ THE SHIFT RULE, asked of a constant. Every part of the answer comes from TypeRules — the fill,
	// the opcode, the legality of the count, and the fold — so a shift in a `let` and a shift in a
	// function body cannot disagree. `1 shl 64` is 0 in both, and `1 shl -1` is E2054 in both.
	//
	// `leftOperandIsUnsigned` is FALSE, and asked rather than assumed. A top-level constant carries no
	// ranged type — its initializer is a bare expression and shv2 infers `int` or `bool`, nothing else
	// — so its left operand is signed by construction. The rule is still routed through
	// `shiftFillsWithSign` so that the day a constant CAN be unsigned, this answers it the same way
	// the expression parser does instead of having quietly hard-coded the fill. The bootstrap makes
	// exactly this call, and says so at 2-Parser.cs:5062-5068.
	function foldConstShift(left ConstValue, count ConstValue, op MaxonBinOp, countStart TokenIndex) returns ConstValue throws ConstEvalError
		if shiftCountIsNegative(count.payload) 'negative'
			let anchor = self.shiftCountAnchor(countStart, countEnd: self.pos)
			throw ConstEvalError.defective(ParseError.shiftCountNegative(count.payload, line: anchor.line, column: anchor.column))
		end 'negative'

		let shiftOp = shiftOpcodeFor(op, signFills: shiftFillsWithSign(op, leftOperandIsUnsigned: false))

		// The TAG is ASKED of `binOpResultTag` — the same decider, handed the same rewritten opcode,
		// that `emitShift`'s `emitBinOp` asks — and not restated as a literal `integer` here. It
		// answers `integer` for every shift today, so this is not a bug being fixed; it is the second
		// decider not being created. `emitShortCircuit` records what restating one costs: a word
		// operator's result type ended up with one decider per path and nothing making them agree,
		// and the day the rule moves, the path that ASSERTS goes on asserting. A wrong tag is not a
		// compile error, it is a wrong answer at whatever reads the tag next.
		return ConstValue.create(evalShift(left.payload, count: count.payload, op: shiftOp), tag: binOpResultTag(shiftOp, left: left.tag, right: count.tag))
	end 'foldConstShift'

	// A comparison's operands must AGREE — the same class-strict rule `emitCompare` enforces, asked of
	// the same `typesAgree`, and reported under the same code and text.
	// The COMPARISON rule, asked of two constants — `comparableOperands`, the same decider
	// `emitCompare` asks, so `let X = 3.5 > 2` and `f > i` in a body cannot come to disagree about
	// whether a float may be compared with an int. It used to ask `typesAgree`, which admits the
	// pair (float and int agree, and must), and so would have folded the mixed compare that the
	// expression path rejects.
	function requireConstComparable(left ConstValue, right ConstValue, opTok Token) throws ConstEvalError
		if comparableOperands(left.tag, right: right.tag) 'comparable'
			return
		end 'comparable'

		throw ConstEvalError.defective(ParseError.comparisonTypeMismatch(typeTagName(left.tag), right: typeTagName(right.tag), line: opTok.line, column: opTok.column))
	end 'requireConstComparable'

	// Every other binary operator's operand rule, asked of `requireBinOpOperands` — the one classifier
	// the emitting path asks. It throws a `ParseError`; the evaluator's failures are wrapped, so the
	// two paths reject `let X = 4 + true` and `y = 4 + true` with the identical diagnostic.
	function requireConstOperands(op MaxonBinOp, left ConstValue, right ConstValue, opTok Token) throws ConstEvalError
		try requireBinOpOperands(op, left: left.tag, right: right.tag, opTok: opTok) otherwise (err) 'rejected'
			throw ConstEvalError.defective(err)
		end 'rejected'
	end 'requireConstOperands'

	// ⛔ **A FLOAT IS NEVER FOLDED**, and this is the guard that says so — on the arithmetic path
	// and the comparison path both, which is why it is one function called twice rather than two
	// conditions.
	//
	// A `ConstValue`'s payload is a `ParsedInt`, and for a float it holds the IEEE-754 BIT
	// PATTERN. Every fold this evaluator owns is INTEGER arithmetic over that payload
	// (`foldIntBinOp`, `foldIntCompare`), so folding `3.14 + 2.0` would add two bit patterns and
	// label the sum a float — a wrong answer computed before the program exists, with no run time
	// left in which to be wrong.
	//
	// ⚠ **The COMPARISON is the subtler half, and the one that would survive testing.** Two
	// POSITIVE doubles order exactly as their bit patterns do, so `3.5 > 2.5` folds to the RIGHT
	// answer and the guard looks unnecessary; only a negative operand (whose sign bit inverts the
	// integer order) or a NaN (which no integer compare can call unordered) shows it. StdDialect's
	// `binOpImm` documents the identical trap one tier down, and `FoldConstOperands` carries the
	// identical guard for the identical reason — three places, one fact, because a float's bits
	// are reachable from three different folders.
	//
	// Doing better needs software IEEE-754 arithmetic inside the compiler — a real thing, not this
	// rung's, and v1 does not fold them either. A float LITERAL is unaffected, and a literal is
	// what every float constant in the corpus is: `let PI = 3.14`, `var ratio = 2.5`,
	// `var zeroA = 0.0`. The bits are CARRIED, never computed on.
	function requireConstNotFloat(left ConstValue, right ConstValue, opTok Token) throws ConstEvalError
		if not operandsAreFloat(left.tag, right: right.tag) 'integral'
			return
		end 'integral'

		throw ConstEvalError.defective(ParseError.unsupported("folding '{opTok.kind.rawValue}' over a float in a constant initializer (a float constant is held as its IEEE-754 bit pattern and the evaluator folds with integer arithmetic only, so the answer would be a bit pattern rather than a number — a float constant must be a literal)", line: opTok.line, column: opTok.column))
	end 'requireConstNotFloat'

	// A prefix `-` or `not`, mirroring `parseUnary` over values. Both readings of `not` come from
	// `notOperatorFor`, so a constant `not` complements exactly what a runtime `not` complements.
	function evalConstUnary(stack TopLevelDeclIndexArray) returns ConstValue throws ConstEvalError
		if self.at(TokenKind.minus) 'neg'
			let opTok = self.current()
			self.advance()
			let operand = try self.evalConstPrimary(stack)
			if not typeClassAdmits(TypeClass.numeric, tag: operand.tag) 'notANumber'
				throw ConstEvalError.defective(ParseError.nonNumericNegation(typeTagName(operand.tag), line: opTok.line, column: opTok.column))
			end 'notANumber'

			// `-3.14` in a constant would `0 - bits` the IEEE pattern, which is not the negation of
			// anything. The EXPRESSION path spells float negation `0.0 - x` and lets `subsd` answer
			// it (`emitFloatNegation`) — a constant has no run time to do that in, and the correct
			// compile-time answer (flip bit 63) is the one float operation this evaluator could
			// perform, which is not a reason to let it perform exactly one. Same line as
			// `requireConstNotFloat`, drawn in the same place.
			try self.requireConstNotFloat(operand, right: operand, opTok: opTok)

			return ConstValue.create(try self.foldConstUnary(MaxonUnaryOp.neg, operand: operand.payload, opTok: opTok), tag: operand.tag)
		end 'neg'

		if self.at(TokenKind.not) 'not'
			let opTok = self.current()
			self.advance()
			let operand = try self.evalConstUnary(stack)
			return try self.foldConstNot(operand, opTok: opTok)
		end 'not'

		return try self.evalConstPrimary(stack)
	end 'evalConstUnary'

	// Which `not` this is, and the fold for it — one question, asked of `notOperatorFor`.
	//
	// `logicalNot` cannot come through `foldIntUnaryOp`, which declines it: that folder's domain is
	// the INTEGERS, where a logical not is a parser bug. Over the bool domain it is meaningful and
	// total, which is `foldLogicalNot`. The two live side by side in TypeRules, and this is the split
	// they exist for.
	function foldConstNot(operand ConstValue, opTok Token) returns ConstValue throws ConstEvalError
		match notOperatorFor(operand.tag) 'which'
			op(kind, resultTag) then return ConstValue.create(try self.foldConstUnary(kind, operand: operand.payload, opTok: opTok), tag: resultTag)
			// Unreachable from a constant: `unresolved` is a call to a function no file declares and
			// `void` a call to one returning nothing, and NO call reaches this evaluator at all — a call
			// in an initializer is rejected as E2045 before its type is ever asked for. It is kept as a
			// case rather than a panic because it is the truthful answer if a second route to an untyped
			// operand ever appears.
			unknownOperandType then throw ConstEvalError.defective(ParseError.notOnUnknownType(opTok.line, column: opTok.column))
			// `not 3.14` — reachable here, unlike the two above: a float literal IS a constant.
			// Same rule and same message as the expression path's, because it is the same rule.
			nonIntegralOperand then throw ConstEvalError.defective(ParseError.nonIntegralOperands(opTok.kind.rawValue, operand: typeTagName(operand.tag), line: opTok.line, column: opTok.column))
		end 'which'
	end 'foldConstNot'

	// The unary folds, both routed through TypeRules. `neg` and `bitNot` are `foldIntUnaryOp`'s;
	// `logicalNot` is `foldLogicalNot`'s (see `foldConstNot`).
	function foldConstUnary(op MaxonUnaryOp, operand ParsedInt, opTok Token) returns ParsedInt throws ConstEvalError
		if op == MaxonUnaryOp.logicalNot 'logical'
			return foldLogicalNot(operand)
		end 'logical'

		match foldIntUnaryOp(op, operand: operand) 'folded'
			folded(value) then return value
			// `foldIntUnaryOp` declines only `logicalNot`, which the guard above already took. Reaching
			// here means a unary operator was added to the enum without being given a fold.
			notFoldable then panic("Parser.foldConstUnary: TypeRules declined to fold '{op.rawValue}' over the integer {operand} at {opTok.line}:{opTok.column} — only `logicalNot` is declinable there, and it is handled above")
		end 'folded'
	end 'foldConstUnary'

	// A constant PRIMARY: an integer literal, `true`/`false`, a character literal, a parenthesized
	// sub-expression, a type-qualified bound (`u16.max`), or a reference to another top-level
	// constant. Every literal decoder is the one the emitting path uses, so a constant reads a
	// literal exactly as a function body reads it.
	function evalConstPrimary(stack TopLevelDeclIndexArray) returns ConstValue throws ConstEvalError
		if self.at(TokenKind.intLiteral) 'intLit'
			return try self.evalConstIntLiteral()
		end 'intLit'

		if self.at(TokenKind.floatLiteral) 'floatLit'
			return try self.evalConstFloatLiteral()
		end 'floatLit'

		if self.at(TokenKind.true) or self.at(TokenKind.false) 'boolLit'
			return self.evalConstBoolLiteral()
		end 'boolLit'

		if self.at(TokenKind.charLiteral) 'charLit'
			return try self.evalConstCharLiteral()
		end 'charLit'

		if self.at(TokenKind.leftParen) 'group'
			return try self.evalConstGroup(stack)
		end 'group'

		if self.at(TokenKind.identifier) 'namedPrimary'
			return try self.evalConstNamed(stack)
		end 'namedPrimary'

		let tok = self.current()
		throw ConstEvalError.defective(ParseError.expectedExpression(tok.kind.rawValue, line: tok.line, column: tok.column))
	end 'evalConstPrimary'

	function evalConstIntLiteral() returns ConstValue throws ConstEvalError
		let tok = self.current()
		self.advance()
		let value = try self.intLiteralValue(tok, negated: false) otherwise (err) 'overflow'
			throw ConstEvalError.defective(err)
		end 'overflow'

		return ConstValue.create(value, tag: ValueTypeTag.integer)
	end 'evalConstIntLiteral'

	// A float literal in a constant initializer — `let PI = 3.14`, `var zeroA = 0.0`. It carries
	// the IEEE-754 bit pattern in the same `ParsedInt` payload every other constant uses, exactly
	// as `parseFloatLiteral` does in an expression, and through the same `parseFloatBits` — so the
	// bits of a float in a `let` and a float in a body cannot come to differ.
	//
	// ⚠ It is the ONLY float a constant can contain, and `requireConstNotFloat` is what enforces
	// that. The payload is a bit pattern, and every fold this evaluator has is integer arithmetic
	// over it.
	function evalConstFloatLiteral() returns ConstValue throws ConstEvalError
		let tok = self.current()
		self.advance()
		let bits = try parseFloatBits(tok.value) otherwise 'overflow'
			throw ConstEvalError.defective(ParseError.floatLiteralOverflow(tok.line, column: tok.column))
		end 'overflow'

		return ConstValue.create(bits, tag: ValueTypeTag.float)
	end 'evalConstFloatLiteral'

	function evalConstBoolLiteral() returns ConstValue
		let isTrue = self.at(TokenKind.true)
		self.advance()
		if isTrue 'true'
			return ConstValue.create(BoolTrueValue, tag: ValueTypeTag.boolean)
		end 'true'

		return ConstValue.create(BoolFalseValue, tag: ValueTypeTag.boolean)
	end 'evalConstBoolLiteral'

	// A character literal is an INTEGER carrying its byte — the same reading `parseCharLiteral` gives
	// it, through the same decoder, so `let DASH = '-'` and `c == '-'` cannot disagree about what a
	// dash is.
	function evalConstCharLiteral() returns ConstValue throws ConstEvalError
		let tok = self.current()
		self.advance()
		match decodeCharLiteral(tok.value) 'decoded'
			byte(value) then return ConstValue.create(value, tag: ValueTypeTag.integer)
			empty then throw ConstEvalError.defective(ParseError.invalidCharacterLiteral("a character literal must contain exactly one character", line: tok.line, column: tok.column))
			multiByte then throw ConstEvalError.defective(ParseError.unsupported("the multi-byte character literal '{String.from(tok.value)}' (a character wider than one byte is a `Character` — a heap value — which arrives with String; a single-byte literal materializes as its byte value)", line: tok.line, column: tok.column))
			badEscape(text) then throw ConstEvalError.defective(ParseError.invalidCharacterLiteral("unknown escape sequence '{text}'", line: tok.line, column: tok.column))
		end 'decoded'
	end 'evalConstCharLiteral'

	// `( … )` — grouping, re-entering the climb at the LOOSEST precedence exactly as
	// `parseParenthesizedExpression` does, so a parenthesis restores every operator.
	function evalConstGroup(stack TopLevelDeclIndexArray) returns ConstValue throws ConstEvalError
		try self.consumeConst(TokenKind.leftParen)
		let value = try self.evalConstBinary(stack, minPrec: OrPrecedence)
		try self.consumeConst(TokenKind.rightParen)

		return value
	end 'evalConstGroup'

	// An identifier in a constant: a CALL (rejected), a type-qualified bound (`u16.max`), or a
	// reference to another top-level constant. The same two one-token lookaheads `parsePrimary`
	// splits these three forms with.
	function evalConstNamed(stack TopLevelDeclIndexArray) returns ConstValue throws ConstEvalError
		let tok = self.current()

		// ⚠ REJECTED BEFORE THE CALL IS READ, not after. A call's answer needs the program to be
		// RUNNING, and a top-level `let` is folded before any of it exists — so there is nothing to
		// fold and no later pass that could supply one. Both reference compilers reject it here with
		// this exact text.
		if self.peekKind() == TokenKind.leftParen 'call'
			throw ConstEvalError.defective(ParseError.functionCallInConstant(String.from(tok.value), line: tok.line, column: tok.column))
		end 'call'

		if self.peekKind() == TokenKind.dot 'qualifiedBound'
			let value = try self.parseTypeQualifiedBound() otherwise (err) 'badBound'
				throw ConstEvalError.defective(err)
			end 'badBound'
			return ConstValue.create(value, tag: ValueTypeTag.integer)
		end 'qualifiedBound'

		self.advance()
		return try self.evalConstNameRef(tok, stack: stack)
	end 'evalConstNamed'

	// **THE FORWARD REFERENCE, AND THE CROSS-FILE ONE.** A name in an initializer resolves through the
	// whole-program arena, which recursively evaluates whatever it finds — so declaration ORDER does
	// not decide what a program means, and a constant in another file is as reachable as one on the
	// line above. The cycle detection is the arena's (`ProgramSignatures.evaluateDecl`), which is
	// the only place that can see one.
	function evalConstNameRef(tok Token, stack TopLevelDeclIndexArray) returns ConstValue throws ConstEvalError
		match self.signatures.evaluateNamed(tok.value, readerFilePath: self.filePath, stack: stack) 'resolved'
			value(payload, tag) then return ConstValue.create(payload, tag: tag)
			// It exists and has no value. Its own declaration carries the diagnostic, so this one stays
			// quiet — see `TopLevelConstant.poisoned`.
			failed then throw ConstEvalError.dependencyFailed
			notFound then throw ConstEvalError.defective(ParseError.undefinedConstant(String.from(tok.value), line: tok.line, column: tok.column))
		end 'resolved'
	end 'evalConstNameRef'

	// `consume`, wrapped for the evaluator's error type. The evaluator cannot use `consume` directly:
	// it throws `ParseError`, and a `ParseError` raised HERE is a defect in THIS initializer that must
	// be recorded on its declaration rather than thrown at whatever file happens to be parsing.
	function consumeConst(kind TokenKind) returns Token throws ConstEvalError
		return try self.consume(kind) otherwise (err) 'unexpected'
			throw ConstEvalError.defective(err)
		end 'unexpected'
	end 'consumeConst'

	// Parse a call expression `callee(args…)` and return the ValueId its result defines. The
	// callee name is kept as identifier TEXT (a `ByteArray` slice per the MaxonOp value/name
	// split); the arguments are parsed in source order with their `name:` labels. Call-site
	// diagnostics anchor on the callee-through-`)` span.
	//
	// The call op lands in `currentBlock` AFTER the arguments are parsed, because an argument
	// can short-circuit (`f(a or b)`) and move it. Emitting into the block the call STARTED in
	// would put the call on a path its own arguments do not reach.
	// `resultUsed` names the ONE thing the two call positions differ by, and the grammar has exactly
	// two of them: a bare-call STATEMENT (`greet()` on a line of its own — the result is evaluated
	// for effect and discarded) and a call inside an EXPRESSION (`let x = f()`, `f() + 1`,
	// `if ready()`, `g(f())` — the result IS the expression). The parser is therefore the only tier
	// that can tell a legal void call from an illegal use of nothing, which is why the check lives
	// here and not in a later pass.
	function parseCall(func IrFunction, resultUsed bool) returns ValueId throws ParseError
		let calleeTok = self.current()
		// A free call has no receiver: there is no value to its left.
		return try self.parseCallNamed(func, callee: calleeTok.value, anchor: calleeTok, receiver: ReceiverArg.none, resultUsed: resultUsed)
	end 'parseCall'

	// The call parser proper, taking the callee's NAME rather than reading it — because two call
	// syntaxes produce one call, and only the name differs. `greet()` is its own token's text;
	// `Point.create(…)` is `Point.create`, mangled by `parseQualifiedCall` from two tokens plus a
	// dot. Everything after the name — the argument grammar, the `name:` label rules, the builtin
	// check, the result typing, the emit — is identical, so it is written once.
	//
	// The CURSOR is on the callee's final name token (`greet`, `create`) with `(` behind it; the
	// caller has already consumed any qualification. `anchor` is the token diagnostics point at,
	// which for a qualified call is the TYPE name — the start of what the user wrote, and the same
	// anchor the span runs from.
	function parseCallNamed(func IrFunction, callee ByteArray, anchor Token, receiver ReceiverArg, resultUsed bool) returns ValueId throws ParseError
		try self.consume(TokenKind.identifier)
		try self.consume(TokenKind.leftParen)

		var args = ValueIdArray.create()
		var argLabels = ByteArrayArray.create()
		var argRanges = SourceRangeArray.create()

		// ⭐ **THE RECEIVER GOES IN FIRST, AS AN UNLABELLED ARGUMENT, AND THEN IT IS JUST AN
		// ARGUMENT.** Pushed BEFORE the source's own arguments are parsed, so it occupies index 0
		// and everything downstream slots it there without being told: `slotCallArgs` puts an
		// unlabelled argument at index `i` into parameter position `i`, and parameter 0 is
		// `SelfParamName`. The two ends of the convention never speak to each other.
		//
		// It does NOT disturb the label rules. `parseCallArgs` counts the SOURCE's arguments from
		// zero on its own counter, so `acc.add(10)`'s `10` is still "the first argument" and is
		// still required to be positional — the receiver is not something the user wrote and must
		// not shift what they did.
		//
		// ⚠ **IT DOES DISTURB THE ARITY COUNTS, AND THIS IS THE ONE PLACE THAT CAN SAY SO.** Every
		// E3036 against a method now counts the receiver on BOTH sides, so both numbers are one
		// higher than anything the source wrote: `a.add()` — zero arguments written — reports
		// *"'Adder.add' expects 2 argument(s) but 1 were provided"* (measured). The count is
		// internally consistent and the program is correctly refused; the numbers are just not the
		// user's. Every method call is affected, through both callers — `parseMethodCall`'s
		// `a.add()` and `parseQualifiedCall`'s receiverless `Adder.add(5)` — which is exactly why
		// the note lives HERE, at the prepend that causes it, rather than being written once per
		// caller and drifting. The bootstrap dodges it by reporting per-parameter ("missing argument
		// for parameter 'value'") instead of by count. The honest fix is a diagnostic that speaks in
		// the SOURCE's arity, and no corpus case covers one — so it is recorded, not invented here.
		//
		// Its span is the receiver EXPRESSION's anchor (`acc`, or the `self` keyword), which is the
		// token a diagnostic about the receiver has to point at.
		match receiver 'prependReceiver'
			none then break 'prependReceiver'
			value(id) then pushCallArg(args, argLabels: argLabels, argRanges: argRanges, value: id, label: EmptySourceText, range: SourceRange.ofToken(anchor))
		end 'prependReceiver'

		try self.parseCallArgs(func, args: args, argLabels: argLabels, argRanges: argRanges)

		let rparenTok = try self.consume(TokenKind.rightParen)

		// A BUILTIN is recognized by name, AFTER its arguments are parsed — so it takes the
		// ordinary call syntax and the ordinary argument rules, and only the emit differs. The
		// check sits here rather than in `emitCall` because a builtin emits no `MaxonOp.call` at
		// all: it has no signature to slot arguments against and no symbol to link.
		//
		// A QUALIFIED callee can never match: `Point.trunc` is not `trunc`, so a type may declare a
		// static method of that name and it is linked, not shadowed. The reservation the builtin
		// does impose — a free `function trunc` is unreachable — is unchanged and still undiagnosed
		// (see `emitTrunc`).
		if callee.equals(TruncBuiltinName) 'truncBuiltin'
			return try self.emitTrunc(args, calleeTok: anchor)
		end 'truncBuiltin'

		if callee.equals(PrintBuiltinName) 'printBuiltin'
			return try self.emitPrint(args, calleeTok: anchor, resultUsed: resultUsed)
		end 'printBuiltin'

		return try self.emitCall(callee, anchor: anchor, args: args, argLabels: argLabels, argRanges: argRanges, rparenTok: rparenTok, resultUsed: resultUsed)
	end 'parseCallNamed'

	// `trunc(x)` — **THE f64 → int BRIDGE**, and a compiler BUILTIN rather than a stdlib function.
	//
	// It is a builtin in both reference compilers (v1: `mathIntrinsicTarget` →
	// `StdArithUnaryOpcode.fpToSiI64`, LowerMaxonToStd.maxon:13888; the bootstrap: `MaxonTruncOp`,
	// 2-Parser.cs:804). For shv2 the reason is sharper than inheritance: it lowers to ONE
	// instruction, so a call would be a call/ret wrapped around a single `cvttsd2si` — and,
	// decisively at THIS rung, a stdlib `trunc` would drag in the stdlib cone, which is P1.0b's.
	// specs-shv2/float-type.md ends nearly every case on it, so it is the difference between the
	// float corpus running and not running at all.
	//
	// ⚠ **`trunc(int)` IS THE IDENTITY, and answering it with the operand is CORRECTNESS, not an
	// optimization.** An int → f64 → int round trip loses precision above f64's 53-bit mantissa,
	// so `trunc(i64.max)` would answer a number that is not `i64.max`. v1 makes the same call for
	// the same reason ("trunc(int) is identity — alias the result to the operand directly",
	// LowerMaxonToStd.maxon:7778). It is also what keeps `fpToSi` from ever naming an int → int
	// conversion, which `lowerUnaryOp` panics on.
	//
	// ⚠ The name is RESERVED wherever a call is parsed: a user function called `trunc` is
	// shadowed by this and never linked. v1 has the same property for its whole math-intrinsic
	// set, and the same absence of a diagnostic for it.
	function emitTrunc(args ValueIdArray, calleeTok Token) returns ValueId throws ParseError
		if args.count() != TruncArity 'arity'
			throw ParseError.builtinArity(String.from(TruncBuiltinName), expected: TruncArity, got: args.count(), line: calleeTok.line, column: calleeTok.column)
		end 'arity'

		let operand = try args.get(0) otherwise panic("emitTrunc: args.count() == TruncArity just checked but get(0) failed")
		let operandTag = self.tagOf(operand)
		if not typeClassAdmits(TypeClass.numeric, tag: operandTag) 'notANumber'
			throw ParseError.builtinOperandType(String.from(TruncBuiltinName), required: "number", got: typeTagName(operandTag), line: calleeTok.line, column: calleeTok.column)
		end 'notANumber'

		// Already an integer: `trunc` has nothing to truncate. See the precision note above.
		if not tagIsFloat(operandTag) 'identity'
			return operand
		end 'identity'

		return self.emitUnaryOp(operand, op: MaxonUnaryOp.trunc, resultTag: ValueTypeTag.integer, opTok: calleeTok)
	end 'emitTrunc'

	// `print(s)` — **WRITE A STRING TO STDOUT**, no trailing newline (P1.2 wave A). A compiler BUILTIN
	// like `trunc`: it takes ordinary call syntax but emits no `MaxonOp.call` to a user function — it
	// routes to the `__print_string` runtime entry (which loads `buffer@0`/`length@8` and writes them).
	//
	// It requires exactly one `String` argument and returns VOID, so a call in VALUE position is
	// rejected exactly as a void user-call is (`mintDeclaredCallResult`'s `voidCallResultUsed`), and at
	// the same anchor.
	function emitPrint(args ValueIdArray, calleeTok Token, resultUsed bool) returns ValueId throws ParseError
		if args.count() != PrintArity 'arity'
			throw ParseError.builtinArity(String.from(PrintBuiltinName), expected: PrintArity, got: args.count(), line: calleeTok.line, column: calleeTok.column)
		end 'arity'

		let arg = try args.get(0) otherwise panic("emitPrint: args.count() == PrintArity just checked but get(0) failed")
		let argTag = self.tagOf(arg)
		if not tagIsText(argTag) 'notAString'
			throw ParseError.builtinOperandType(String.from(PrintBuiltinName), required: typeTagName(ValueTypeTag.string), got: typeTagName(argTag), line: calleeTok.line, column: calleeTok.column)
		end 'notAString'

		// `print` returns nothing, so using its result is using a value that is not there — the same
		// error a void user-call gets in value position.
		if resultUsed 'noValueToUse'
			throw ParseError.voidCallResultUsed(String.from(PrintBuiltinName), line: calleeTok.line, column: calleeTok.column)
		end 'noValueToUse'

		var callArgs = ValueIdArray.create()
		callArgs.push(arg)
		return self.emitRuntimeCall(PrintStringName, args: callArgs, resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(calleeTok))
	end 'emitPrint'

	// Parse a comma-separated argument list into the parallel `args`/`argLabels`/
	// `argRanges` lists (all empty for `()`). The caller has consumed `(`; this leaves
	// the cursor on `)`. Each argument is an expression, optionally prefixed by a
	// `name:` label — the FIRST argument must be positional and every later argument
	// must be labelled (`consumeArgLabel` enforces both, positioned at the offending
	// token). Whether a `name:` label actually matches a parameter is a SEMANTIC check
	// (SemanticCheck, which has the callee's signature) — not the parser's job.
	function parseCallArgs(func IrFunction, args ValueIdArray, argLabels ByteArrayArray, argRanges SourceRangeArray) throws ParseError
		if self.at(TokenKind.rightParen) 'noArgs'
			return
		end 'noArgs'

		var argIndex = 0 as ParamCount
		while true 'argLoop'
			// The argument's leading token — the label token when labelled, else the
			// value's first token — anchors this argument's diagnostic span.
			let argFirstTok = self.current()
			let label = try self.consumeArgLabel(argIndex)
			// The climber, not `parseExpression`: an argument is parsed INSIDE an expression
			// that has already seeded `currentBlock`, and re-seeding it would discard a
			// short-circuit an EARLIER argument performed.
			let value = try self.parseBinary(func, minPrec: OrPrecedence)

			pushCallArg(args, argLabels: argLabels, argRanges: argRanges, value: value, label: label, range: SourceRange.ofToken(argFirstTok))
			argIndex = argIndex + 1

			if not self.at(TokenKind.comma) 'endArgs'
				break
			end 'endArgs'
			try self.consume(TokenKind.comma)
		end 'argLoop'
	end 'parseCallArgs'

	// Consume and validate an optional `name:` label on the next argument, returning the
	// label text (the empty string when unlabelled). The FIRST argument (`argIndex == 0`)
	// must be positional — a label there is E2052; every later argument must be labelled —
	// a bare value there is E2053. A `name:` label is two tokens (identifier + colon); a
	// bare value leaves the cursor untouched. (Whether the label names a real parameter
	// is checked later, in SemanticCheck.)
	function consumeArgLabel(argIndex ParamCount) returns ByteArray throws ParseError
		let labelTok = self.current()
		let isNamed = labelTok.kind == TokenKind.identifier and self.peekKind() == TokenKind.colon

		if argIndex == 0 'firstArg'
			if isNamed 'firstNamed'
				throw ParseError.firstArgNamed(labelTok.line, column: labelTok.column)
			end 'firstNamed'
			return EmptySourceText
		end 'firstArg'

		if not isNamed 'missingLabel'
			throw ParseError.argMissingLabel(labelTok.line, column: labelTok.column)
		end 'missingLabel'
		try self.consume(TokenKind.identifier)
		try self.consume(TokenKind.colon)
		return labelTok.value
	end 'consumeArgLabel'

	// Append a `call` op defining a fresh result value; return the ValueId it defines. The
	// callee is a `ByteArray` — a slice of its identifier token for a free call, a freshly built
	// mangled name for a qualified one; the call span runs from `anchor` through the closing `)`
	// (the conventional call anchor).
	//
	// The result is minted BEFORE the op is appended, because the op stores its id — and it is
	// minted through `mintCallResult`, which can REFUSE (a void call in value position), so nothing
	// is emitted for a call the program is not allowed to make.
	function emitCall(callee ByteArray, anchor Token, args ValueIdArray, argLabels ByteArrayArray, argRanges SourceRangeArray, rparenTok Token, resultUsed bool) returns ValueId throws ParseError
		let result = try self.mintCallResult(callee, anchor: anchor, resultUsed: resultUsed)
		self.artifact.emitOp(self.currentBlock, op: MaxonOp.call(result, callee: callee, args: args, argLabels: argLabels, argRanges: argRanges), range: SourceRange.between(anchor, last: rparenTok))
		return result
	end 'emitCall'

	// Mint the SSA value a call to `calleeTok` defines, typed from the WHOLE-PROGRAM signature index
	// (SignatureIndex.maxon) — so the type is exact whether the callee is declared above this call,
	// below it, or in another file entirely.
	//
	// The index answers with the DECLARATION, undistorted, which is what makes the two cases below
	// distinguishable at all. The shipped code asked a file-local table and mapped BOTH "this file
	// does not declare it" and "it declares nothing to return" onto one `MaxonType.unresolved` — a
	// sentinel with two meanings, and TypeRules' `unknown` (which agrees with everything) is what it
	// became. That is how `isReady()` from another file added to 41 and made 42, and how
	// `let x = noop()` then `x + 4` compiled at all.
	function mintCallResult(callee ByteArray, anchor Token, resultUsed bool) returns ValueId throws ParseError
		match self.signatures.returnTypeOf(callee, into: self.artifact.typeNames) 'callee'
			declared(returnType) then return try self.mintDeclaredCallResult(callee, anchor: anchor, returnType: returnType, resultUsed: resultUsed)
			// NO file declares this callee. DEFER, and keep deferring: `SemanticCheck.validateCall` owns
			// that diagnostic (E3004, "call to undefined function") because it reads the registry the
			// REAL parse built, and this sweep is the tolerant half of the pair — see
			// `CalleeReturn.undeclared`. So the program is rejected, just not here, and `unresolved`
			// therefore never reaches codegen.
			undeclared then return self.mintValue(ValueTypeTag.unresolved, nameId: UnnamedTypeId)
		end 'callee'
	end 'mintCallResult'

	// The result of a call to a callee some file DOES declare — where the void/value split is
	// finally a split and not a sentinel.
	function mintDeclaredCallResult(callee ByteArray, anchor Token, returnType MaxonReturnType, resultUsed bool) returns ValueId throws ParseError
		match returnType 'r'
			value(inner) then return self.mintOwnedCallResult(inner)
			void then break 'r'
		end 'r'

		// A VOID callee. In STATEMENT position that is precisely what the position is FOR — the call
		// runs for its effect — so the result value is minted with the `void` tag and never read
		// again (ValueTypeTag.void: it is write-only, and this is the only site that writes it).
		//
		// In VALUE position there is no value to give. The bootstrap says so (`E2004: Function 'noop'
		// does not return a value`), and now so does shv2, at the same anchor.
		if resultUsed 'noValueToUse'
			throw ParseError.voidCallResultUsed(String.from(callee), line: anchor.line, column: anchor.column)
		end 'noValueToUse'

		return self.mintValue(ValueTypeTag.void, nameId: UnnamedTypeId)
	end 'mintDeclaredCallResult'

	// The SSA value a VALUE-returning callee defines, minted from its declared return type. A
	// `returns String` callee hands back a uniformly OWNED heap String (`parseReturnStatement` moved
	// it out of the callee, promoting a borrowed literal if need be), so the CALLER owns the result
	// and must drop it. It is enrolled exactly as an interpolation temporary is — `parseBinding`
	// transfers a bound result to a scope-exit drop, `drainPendingTemps` frees an unbound one after
	// the consuming statement — through the one owned-temp door, `trackOwnedTemp`. A non-String result
	// owns no heap, so it is enrolled in nothing. String-ness is the tag `ValueTypeTag.string`, read
	// through the same `tagIsText` predicate every String site asks.
	function mintOwnedCallResult(inner MaxonType) returns ValueId
		let result = self.mintValueOfType(inner)
		if tagIsText(self.tagOf(result)) 'ownsStringResult'
			self.trackOwnedTemp(result)
		end 'ownsStringResult'
		return result
	end 'mintOwnedCallResult'

	// Parse an integer literal token into a `literal` op, and return the value it defines.
	// The token's text becomes a number through the shared `intLiteralValue`, so a literal
	// in an expression and a literal in a range bound are read the same way.
	function parseIntLiteral() returns ValueId throws ParseError
		let tok = try self.consume(TokenKind.intLiteral)
		let value = try self.intLiteralValue(tok, negated: false)
		return self.emitLiteral(value, valueType: MaxonType.integer, range: SourceRange.ofToken(tok))
	end 'parseIntLiteral'

	// Parse a FLOAT literal token into a `literal` op, and return the value it defines.
	//
	// ⭐ **THE LITERAL'S VALUE IS ITS IEEE-754 BIT PATTERN**, carried in the very same `ParsedInt`
	// payload an integer literal uses — and that is why a float costs NO new op at either tier.
	// `MaxonOp.literal` and `StdOp.const` already carry a `valueType` beside the bits, and the
	// type is what says how to READ them; 64 bits are 64 bits. v1 mints a second literal op
	// (`constF64`) and pays for it in every pass that has to match one.
	//
	// ⚠ These bits are deliberately NOT recorded as a parser constant, and the guard that stops it
	// is `emitLiteralIn`'s `tagIsInteger` — already there, written for the bool case, and load-
	// bearing here for a different one. A float in the fold columns would let `foldIntBinOp` ADD
	// TWO IEEE PATTERNS AS INTEGERS: `3.14 + 2.0` would fold to a number that is neither 5.14 nor
	// anything else, silently, at compile time.
	function parseFloatLiteral() returns ValueId throws ParseError
		let tok = try self.consume(TokenKind.floatLiteral)
		let bits = try parseFloatBits(tok.value) otherwise throw ParseError.floatLiteralOverflow(tok.line, column: tok.column)
		return self.emitLiteral(bits, valueType: MaxonType.float, range: SourceRange.ofToken(tok))
	end 'parseFloatLiteral'

	// Append a `literal` op into the CURRENT block; return the ValueId it defines.
	function emitLiteral(value ParsedInt, valueType MaxonType, range SourceRange) returns ValueId
		return self.emitLiteralIn(self.currentBlock, value: value, valueType: valueType, range: range)
	end 'emitLiteral'

	// Append a `literal` op into a NAMED block. The short-circuit lowering needs this: its
	// seed literal belongs in the ENTRY block, which by the time the phi is wired is no
	// longer the current one.
	function emitLiteralIn(block IrBlock, value ParsedInt, valueType MaxonType, range SourceRange) returns ValueId
		let result = self.mintValueOfType(valueType)
		self.artifact.emitOp(block, op: MaxonOp.literal(result, value: value, valueType: valueType), range: range)

		// THE root of the parser's constant view. A `let` binds its NAME to the value the
		// initializer produced, so `let SHIFT = -1` binds `SHIFT` to this very id — which is why
		// folding a literal is all it takes to see a count named through a `let`.
		if tagIsInteger(maxonTypeTag(valueType)) 'integer'
			self.recordConst(result, folded: value)
		end 'integer'

		return result
	end 'emitLiteralIn'

	// --- token cursor ---

	// The token at an ABSOLUTE index, or a synthetic EOF once past the end. THE one place the
	// past-the-end rule is written down — `current`, `at`, `kindAt` and `peekKind` are all views
	// over this, so a cursor read and a scan read can never disagree about where the tokens stop.
	// The lexer already appends a real EOF, so the synthetic one is a belt-and-suspenders guard.
	function tokenAt(index TokenIndex) returns Token
		if index >= self.tokens.count() 'pastEnd'
			return Token.eof()
		end 'pastEnd'

		return try self.tokens.get(index) otherwise panic("Parser.tokenAt: index<count just checked but tokens.get({index}) failed")
	end 'tokenAt'

	// The token at the cursor.
	function current() returns Token
		return self.tokenAt(self.pos)
	end 'current'

	function at(kind TokenKind) returns bool
		return self.current().kind == kind
	end 'at'

	// The kind of the token at an ABSOLUTE index. The cursor-independent read the token-extent
	// scans need — `blockStatementEndIndex`, `namesAssignedIn` and `opensBlockAt` all walk the
	// token array without moving `pos`.
	function kindAt(index TokenIndex) returns TokenKind
		return self.tokenAt(index).kind
	end 'kindAt'

	// **THE token shape of a reassignment, asked at an ABSOLUTE index — and there is exactly ONE
	// of these on purpose.** Two callers ask it and they must never disagree:
	//
	//   • `parseStatement`, deciding that this statement IS a reassignment, and
	//   • `namesAssignedIn`, deciding which vars a loop CARRIES A PHI FOR.
	//
	// Written down twice, a new write form (a compound assignment, a store through a field) taught
	// to the dispatcher and not to the scan would compile: the statement would assign the var, the
	// loop would mint no phi for it, and the var would reset to its pre-loop value on every
	// iteration. A SILENT MISCOMPILE — and, unlike a `blockStatementEndIndex` mismatch, one no drift
	// guard can see, because the loop's EXTENT would still be perfectly correct. Teaching this one
	// predicate teaches both.
	//
	// ⚠ AND IT IS NOT ENOUGH TO MAKE THE NEW FORM MERELY *MATCH* — IT MUST NAME THE RIGHT VAR.
	// `a.b = x` already fits `identifier equals`, at `b`. So a field store taught to THIS predicate
	// would silently start inserting **`b`**, the FIELD, and never `a`, the var that carries the
	// loop value. The phi would be minted for a name nothing writes and withheld from the one that
	// does.
	//
	// ⭐ **THAT IS WHY FIELD STORES HAVE THEIR OWN PREDICATE — `fieldAssignsAt` — AND WHY THIS ONE
	// WAS NOT WIDENED** (P1.1a wave 2). `parseStatement` routes on both; `namesAssignedIn` reads
	// only this one, and that is CORRECT rather than an omission: **a field store assigns no
	// binding.** `p` is a box pointer that `p.x = 5` never reassigns — the write goes to MEMORY,
	// through `storeIndirect`, and the box's address is the same value afterwards. So there is no
	// loop-carried value to merge and no phi to mint.
	//
	// ⚠ `c.value = c.value + 1` DOES make this scan insert `value`, at the field token, and it is
	// harmless — but **for the over-approximation note's SHADOWING reason, not its "selects nothing"
	// one**, and the difference is worth stating because only one of the two survives a local of the
	// same name. With no local called `value`, the name binds nothing at the header and selects
	// nothing. With `var value` ALSO in scope it DOES select, and a header phi IS minted for a var
	// the loop never writes. That phi CARRIES NOTHING — every incoming value is the same one,
	// precisely because nothing assigns it — which is the shape `elimTrivialBlockArgs` exists to fold
	// away (see PassPipeline). MEASURED rather than argued: that program returns 102, the right
	// answer.
	//
	// ⚠ A write with NO `=` ANYWHERE cannot be covered by either half of the above, because it is
	// not a statement to teach the dispatcher about: a `var` PARAMETER is written by `mutate(p)`
	// at the call site. `ParametersAreMutable` is the tripwire for that one — see `namesAssignedIn`.
	function assignsAt(index TokenIndex) returns bool
		return self.kindAt(index) == TokenKind.identifier and self.kindAt(index + 1) == TokenKind.equals
	end 'assignsAt'

	// **The token shape of a FIELD STORE** — `<base> . <field> =`, asked at an ABSOLUTE index.
	//
	// Deliberately NOT folded into `assignsAt`: see there. The two are disjoint by construction (the
	// token after the base is `=` for one and `.` for the other), so `parseStatement` may ask them
	// in either order and get the same answer.
	//
	// `p.x == y` cannot be mistaken for a store: `==` lexes as a single `equalsEquals` token. Nor
	// can `Point.create(…)`, whose token at +3 is `(`.
	function fieldAssignsAt(index TokenIndex) returns bool
		return self.kindAt(index) == TokenKind.identifier and self.kindAt(index + 1) == TokenKind.dot and self.kindAt(index + 2) == TokenKind.identifier and self.kindAt(index + 3) == TokenKind.equals
	end 'fieldAssignsAt'

	// **The token shape of an EXPLICIT self-field store** — `self . <field> =`.
	//
	// Its own predicate rather than a widening of `fieldAssignsAt`, because `self` is a KEYWORD and
	// not an identifier — and, more to the point, for `fieldAssignsAt`'s own reason: it assigns no
	// BINDING, so `namesAssignedIn` must not see it. (The BARE spelling `count = 5` DOES match
	// `assignsAt` and is deliberately left to; see there.)
	function selfFieldAssignsAt(index TokenIndex) returns bool
		return self.kindAt(index) == TokenKind.self and self.kindAt(index + 1) == TokenKind.dot and self.kindAt(index + 2) == TokenKind.identifier and self.kindAt(index + 3) == TokenKind.equals
	end 'selfFieldAssignsAt'

	// **The token shape of an INSTANCE METHOD CALL** — `<base> . <name> (`, where `<base>` names a
	// value IN SCOPE (a binding, or the `self` keyword's receiver).
	//
	// ⭐ **THE SCOPE TEST IS THE WHOLE PREDICATE**, because the token shape alone cannot tell
	// `c.increment()` from `Point.create()` — they are identical. What separates them is that one
	// base is a VALUE and the other is a TYPE NAME, and only the scope knows which.
	//
	// Asked at an ABSOLUTE index by `parseStatement` and at the cursor by
	// `parseDottedPrimary`/`parseSelfPrimary`, so the statement and expression positions cannot come
	// to disagree about what a method call looks like — which they would, since a method call is
	// legal in both and only one of them may discard the result.
	//
	// ⚠ A STATIC call in statement position stays unsupported, and that is deliberate rather than an
	// oversight of this predicate: `Point.create()` on a line of its own discards a value, and for a
	// factory that value is a box nothing would then free.
	function methodCallsAt(index TokenIndex) returns bool
		let baseKind = self.kindAt(index)
		if baseKind != TokenKind.identifier and baseKind != TokenKind.self 'notABase'
			return false
		end 'notABase'
		if self.kindAt(index + 1) != TokenKind.dot or self.kindAt(index + 2) != TokenKind.identifier or self.kindAt(index + 3) != TokenKind.leftParen 'notADottedCall'
			return false
		end 'notADottedCall'
		return self.scope.contains(self.baseBindingName(self.tokenAt(index)))
	end 'methodCallsAt'

	// The kind of the token ONE past the cursor. The parser's two-token lookahead:
	// distinguishing a reassignment (`ident =`) from a bare identifier statement (`ident …`)
	// needs to see the `=` without committing to consuming the identifier first — and it is
	// the same question `namesAssignedIn` asks of every token in a loop's extent, which is why
	// both read it through `kindAt` and the past-the-end rule lives in exactly one place.
	function peekKind() returns TokenKind
		return self.kindAt(self.pos + 1)
	end 'peekKind'

	function isEof() returns bool
		return self.at(TokenKind.eof)
	end 'isEof'

	function advance()
		if self.pos < self.tokens.count() 'inRange'
			self.pos = self.pos + 1
		end 'inRange'
	end 'advance'

	// Consume a token of the expected kind, or throw a positioned mismatch error.
	// A TokenKind's `.rawValue` is its human-readable display text ("(", "return").
	function consume(kind TokenKind) returns Token throws ParseError
		let tok = self.current()
		if tok.kind != kind 'mismatch'
			throw ParseError.unexpectedToken(kind.rawValue, got: tok.kind.rawValue, line: tok.line, column: tok.column)
		end 'mismatch'
		self.advance()
		return tok
	end 'consume'

	function skipNewlines()
		while self.at(TokenKind.newline) 'skip'
			self.advance()
		end 'skip'
	end 'skipNewlines'

	// Consume an optional block label (`'name'`, a charLiteral) after `end`.
	function skipOptionalLabel()
		if self.at(TokenKind.charLiteral) 'label'
			self.advance()
		end 'label'
	end 'skipOptionalLabel'
end 'Parser'
