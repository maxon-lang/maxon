		// then pointed at its companion, so the body's `f(x)` threads that env (`emitClosureEnvArg`).
		self.bindClosureEnvParams(paramTypes, paramRanges: paramRanges, userParamCount: userParamCount)

		// And the companion WITNESS parameters, AFTER the env block — see `bindExistentialWitnessParams`.
		self.bindExistentialWitnessParams(paramTypes, paramRanges: paramRanges, userParamCount: userParamCount, envParamCount: envParamCount)

		// Seed the hidden layout-descriptor parameter's value columns (P1.6-B1) — AFTER the user + env
