// Parser — the M1 recursive-descent slice.
//
// shv2 keeps v1's "direct-emit" contract: the parser emits Maxon-dialect IR ops
// directly onto blocks (no AST). Two structural changes from v1:
//
//   1. It writes exclusively into a per-file `FileParseArtifact` — its own
//      MaxonModule fragment, its own local type-name interner, and its own
//      registry contributions — and takes NO `Project` (PLAN.md). Per-file parse
//      is therefore a pure function of `(tokens, filePath, namespace)` with no
//      shared state; `mergeArtifact` folds the result into `Project` later.
//   2. **Value numbering is born HERE.** Each op's result gets a dense, function-
//      local `ValueId` from `self.valueIds` at emit time. v1 instead named values
//      with synthetic `$tN` strings and re-derived the ids in `lowerMaxonToStd`
//      from a second counter — paying a heap String + ByteArray per value plus a
//      byte-keyed hash map to undo it. See MaxonDialect's MaxonOp header.
//
// Anything outside the parsed slice is rejected with a positioned diagnostic. What
// the slice covers: free functions (parameters, calls with `name:` labels, an
// optional `returns` clause), ranged `typealias` declarations, `let`/`var` bindings
// and reassignment, `if`/`else`/`while` with `break`/`continue`, integer and bool
// literals, parenthesized grouping, arithmetic, comparison, and type-qualified numeric
// bounds. What it does NOT: user types, generics, strings, floats, logical operators.
//
// THREE THINGS THIS FILE OWNS THAT ARE NOT OBVIOUS FROM ITS SHAPE:
//
//   1. NAME RESOLUTION, INCLUDING LEXICAL BLOCK SCOPING. `Scope` is threaded through
//      the parse, and each `if`/`else`/`while` body is a scope FRAME (parseBlockBody),
//      so a binding declared in a block is gone at its `end` and may legally shadow an
//      outer one while it lives. An unbound name is a parse-time diagnostic.
//   2. ON-THE-FLY SSA. There is no AST and no `mem2reg`: a `let`/`var` binds a name
//      straight to the SSA value its initializer produced, and the block-args (phis)
//      that merge those values across branches and loops are minted HERE, as the
//      control flow is parsed. Mutable bindings are tracked BY REFERENCE for it — see
//      LoopPhiVar for the shadowing hazard that forces that.
//   3. THE IMPLICIT RETURN. A void function's body carries no `return`, so the parser
//      supplies its terminator (closeFunctionBody) — and reports E3013 when a
//      value-returning body can fall off its end instead.

// Cursor position into the token array. Wide range: token counts are unbounded.
typealias TokenIndex = int(0 to u64.max)

// The custom ABI passes arguments in six registers (StdToX64Conversion.argRegisters), so
// M5 caps a function at six parameters. A seventh would need a stack argument slot — a
// later milestone — so the parser rejects it up front with a positioned `unsupported`
// rather than letting it reach the backend as a crash.
let MaxRegisterParams = 6 as ParamCount

// The parser's failure modes. Distinct from NumberParsing's `ParserError` (which
// `parseIntLiteral` catches and re-raises as `integerOverflow`). queryParseOps
// turns a thrown `ParseError` into a project diagnostic — the parser itself never
// touches `Project`.
export union ParseError implements Error
	unexpectedToken(expected String, got String, line LineNumber, column ColumnNumber)
	// A primary expression was required but the token stream had something else
	// (e.g. an operator where an operand belongs). Distinct from `unexpectedToken`:
	// it renders as E2004 `Expected expression but got '<got>'` (no quotes around
	// `expression`), the exact text `unary-operators.md`'s double-negation gates on
	// — `- -x` fails at the second `-`, since a unary operand is a PRIMARY.
	expectedExpression(got String, line LineNumber, column ColumnNumber)
	unexpectedEof(line LineNumber, column ColumnNumber)
	integerOverflow(line LineNumber, column ColumnNumber)
	unsupported(feature String, line LineNumber, column ColumnNumber)
	// A parameter list that repeats a name (`function f(x int, x int)`). The second
	// binding would be a dead, uncallable parameter, so it is rejected at parse time.
	// Renders as E2002, positioned at the repeated name.
	duplicateParameter(name String, line LineNumber, column ColumnNumber)
	// A reference to a name with no binding in scope. Distinct from
	// `unexpectedToken` (a syntactic mismatch): this is a name-resolution failure,
	// which the parser can detect because `Scope` is threaded through it.
	undefinedVariable(name String, line LineNumber, column ColumnNumber)
	// A reassignment (`x = expr`) whose target was declared `let` (immutable). M4b
	// added assignment; only `var` bindings accept it. Renders as E2013.
	assignToImmutable(name String, line LineNumber, column ColumnNumber)
	// A `break`/`continue` with no enclosing loop. `keyword` is "break"/"continue"
	// for the message. Renders as E2047.
	controlOutsideLoop(keyword String, line LineNumber, column ColumnNumber)
	// A labelled `break 'l'`/`continue 'l'` whose label names the INNERMOST loop —
	// redundant (a plain `break`/`continue` already targets it). Renders as E2048.
	labelTargetsOwnLoop(keyword String, label String, line LineNumber, column ColumnNumber)
	// A labelled `break 'l'`/`continue 'l'` whose label matches no enclosing loop.
	// Renders as E2047.
	unknownLoopLabel(keyword String, label String, line LineNumber, column ColumnNumber)
	// A call whose FIRST argument carries a `name:` label — the first argument is
	// positional, only the 2nd and later take labels. Renders as E2052. A syntactic
	// rule the parser checks without the callee's signature.
	firstArgNamed(line LineNumber, column ColumnNumber)
	// A call whose 2nd-or-later argument has NO `name:` label. Renders as E2053. The
	// symmetric syntactic rule to `firstArgNamed`.
	argMissingLabel(line LineNumber, column ColumnNumber)
	// A VALUE-returning function whose body can fall off its end without returning.
	// Renders as E3013, positioned at the function's name. Detected here, not in a
	// later pass, because the parser is what knows the block its last statement left
	// control in — and whether that block ever got a terminator.
	missingReturn(name String, line LineNumber, column ColumnNumber)
end 'ParseError'

// --- Ranged-typealias range bounds ---
//
// The inclusive bounds each sized numeric type's `.min` / `.max` denotes in a range
// declaration (`typealias Handle = int(0 to u32.max)` — specs/ranged-typealias.md).
// Spelled with the very range identifiers they define, so the table cannot drift from
// the language it implements.
//
// `u64.max` does NOT fit a signed 64-bit field, and it rides here as the SAME BIT
// PATTERN `ParsedInt` holds for it (Maxon stores it as the signed -1). That is not a
// lossy stand-in: it is exactly the representation a value in an unsigned-domain alias
// has at runtime, so a future range check compares against it directly.
let U8MaxBound = u8.max as ParsedInt
let U16MaxBound = u16.max as ParsedInt
let U32MaxBound = u32.max as ParsedInt
let U64MaxBound = u64.max as ParsedInt

// Every unsigned type's lower bound. One constant, not four: `u8.min` and `u64.min`
// are the same zero, and a per-type spelling would only invite them to drift apart.
let UnsignedMinBound = 0 as ParsedInt
let I8MinBound = i8.min as ParsedInt
let I8MaxBound = i8.max as ParsedInt
let I16MinBound = i16.min as ParsedInt
let I16MaxBound = i16.max as ParsedInt
let I32MinBound = i32.min as ParsedInt
let I32MaxBound = i32.max as ParsedInt
let I64MinBound = i64.min as ParsedInt
let I64MaxBound = i64.max as ParsedInt

// The `.min` / `.max` field names a type-qualified bound may carry.
let MinBoundField = b"min"
let MaxBoundField = b"max"

// The i1 payloads of the `true` / `false` literals. `BoolFalseValue` is also the zero a
// boolean-valued condition is truth-tested against (`emitTruthTest`) — one constant, so
// "false" and "the value a false condition compares equal to" cannot drift apart.
let BoolTrueValue = 1 as ParsedInt
let BoolFalseValue = 0 as ParsedInt

// The result of resolving a `<sized>.min` / `<sized>.max` bound. A union, so the
// caller can tell the two REJECTIONS apart and name the actual gap in its diagnostic
// (a float bound is a missing FEATURE; an unknown name is a typo).
union SizedTypeBound
	value(bound ParsedInt)
	// `f32` / `f64` — genuinely sized numeric types, but their bounds are FLOAT values
	// this milestone cannot represent. Rejected loudly rather than silently collapsed
	// to an integer.
	floatBound
	notASizedType
end 'SizedTypeBound'

// The bound `<typeName>.<min|max>` denotes, for the eight sized INTEGER types. Shared
// by the range-declaration parser (`typealias Port = int(0 to u16.max)`) and the
// expression parser (`let x = u16.max`), which are the same three tokens in two
// positions — so they resolve through one table rather than two that can disagree.
function sizedTypeBound(typeName ByteArray, wantMax bool) returns SizedTypeBound
	if typeName.equals(b"u8") 'u8'
		return SizedTypeBound.value(pickBound(UnsignedMinBound, high: U8MaxBound, wantMax: wantMax))
	end 'u8'
	if typeName.equals(b"u16") 'u16'
		return SizedTypeBound.value(pickBound(UnsignedMinBound, high: U16MaxBound, wantMax: wantMax))
	end 'u16'
	if typeName.equals(b"u32") 'u32'
		return SizedTypeBound.value(pickBound(UnsignedMinBound, high: U32MaxBound, wantMax: wantMax))
	end 'u32'
	if typeName.equals(b"u64") 'u64'
		return SizedTypeBound.value(pickBound(UnsignedMinBound, high: U64MaxBound, wantMax: wantMax))
	end 'u64'
	if typeName.equals(b"i8") 'i8'
		return SizedTypeBound.value(pickBound(I8MinBound, high: I8MaxBound, wantMax: wantMax))
	end 'i8'
	if typeName.equals(b"i16") 'i16'
		return SizedTypeBound.value(pickBound(I16MinBound, high: I16MaxBound, wantMax: wantMax))
	end 'i16'
	if typeName.equals(b"i32") 'i32'
		return SizedTypeBound.value(pickBound(I32MinBound, high: I32MaxBound, wantMax: wantMax))
	end 'i32'
	if typeName.equals(b"i64") 'i64'
		return SizedTypeBound.value(pickBound(I64MinBound, high: I64MaxBound, wantMax: wantMax))
	end 'i64'
	if typeName.equals(b"f32") or typeName.equals(b"f64") 'float'
		return SizedTypeBound.floatBound
	end 'float'
	return SizedTypeBound.notASizedType
end 'sizedTypeBound'

function pickBound(low ParsedInt, high ParsedInt, wantMax bool) returns ParsedInt
	if wantMax 'max'
		return high
	end 'max'
	return low
end 'pickBound'

// True iff `names` already holds `name`. A linear scan — parameter lists are tiny (the
// only caller is parameter-name duplicate detection), so no membership set is worth its
// heap object (the same reasoning `FuncSignature.indexOfParam` documents).
function byteArrayContains(names ByteArrayArray, name ByteArray) returns bool
	for existing in names 'each'
		if existing.equals(name) 'match'
			return true
		end 'match'
	end 'each'
	return false
end 'byteArrayContains'

// --- Pratt expression parser: precedence table + operator classifiers ---
//
// M3 replaces M2's `+`-only left-fold with a precedence climber (`Parser.parseBinary`).
// Binary precedence levels — HIGHER binds tighter. Left-associativity falls out of
// recursing the right operand at `precedence + 1`. The table is deliberately shaped
// so later milestones EXTEND it without reshaping the climber: M4 inserted comparison
// BELOW additive (this commit); M5 adds `/`/`mod` at the multiplicative level. Unary
// minus is NOT in this table — it is a prefix operator handled by `parseUnary` (the
// leaf of the climber), so it binds tighter than every binary operator here.
typealias InfixPrecedence = int(0 to 100)

// A sentinel-free "not a binary operator": a real level is >= ComparisonPrecedence,
// so `infixPrecedence` returning this makes the climber's loop stop (the expression
// ends). It is a meaningful classification result, not an error sentinel.
let NotAnInfixOperator = 0 as InfixPrecedence

// Comparison `==`/`!=`/`<`/`>`/`<=`/`>=` — the LOOSEST binary level. Binding below
// additive means `x + 1 == y` groups as `(x + 1) == y`.
//
// The CLIMBER never consumes a comparison operator. A comparison is legal in exactly
// one place — an `if`/`while` condition — and `parseCondition` handles it directly
// (`cond := operand [cmpOp operand]`, each operand parsed at AdditivePrecedence, which
// is what stops the climber short of the `==`). The level survives here so a VALUE
// context, which starts the climber at it, still SEES the operator and rejects it with
// the diagnostic that explains why — rather than stopping silently and blaming the next
// statement. See `parseBinary`.
let ComparisonPrecedence = 1 as InfixPrecedence

// Additive `+`/`-` — binds tighter than comparison.
let AdditivePrecedence = 2 as InfixPrecedence

// Multiplicative `*` — binds tighter than additive, so `10 + 5 * 2` groups as
// `10 + (5 * 2)` = 20.
let MultiplicativePrecedence = 3 as InfixPrecedence

// The precedence of a binary-operator token, or NotAnInfixOperator for any token
// that does not begin a binary operation in the grammar. `*`, `/`, and `mod` all
// bind at the multiplicative level (M5.4 joined the division family here), so
// `2 * 6 mod 4` is left-associative `((2 * 6) mod 4)`.
function infixPrecedence(kind TokenKind) returns InfixPrecedence
	if comparisonOperator(kind) 'comparison'
		return ComparisonPrecedence
	end 'comparison'

	if kind == TokenKind.plus or kind == TokenKind.minus 'additive'
		return AdditivePrecedence
	end 'additive'

	if kind == TokenKind.star or kind == TokenKind.slash or kind == TokenKind.mod 'multiplicative'
		return MultiplicativePrecedence
	end 'multiplicative'

	return NotAnInfixOperator
end 'infixPrecedence'

// The Maxon binary operator a supported infix token maps to. Only called for tokens
// `infixPrecedence` classified as operators (precedence != NotAnInfixOperator);
// anything else is a climber bug, so it panics rather than guessing an operator.
function infixMaxonOp(kind TokenKind) returns MaxonBinOp
	if kind == TokenKind.plus 'add'
		return MaxonBinOp.add
	end 'add'

	if kind == TokenKind.minus 'sub'
		return MaxonBinOp.sub
	end 'sub'

	if kind == TokenKind.star 'mul'
		return MaxonBinOp.mul
	end 'mul'

	if kind == TokenKind.slash 'div'
		return MaxonBinOp.div
	end 'div'

	if kind == TokenKind.mod 'mod'
		return MaxonBinOp.mod
	end 'mod'

	panic("infixMaxonOp: token '{kind.rawValue}' is not a supported binary operator — infixPrecedence must gate this call")
end 'infixMaxonOp'

// The Maxon comparison operator a comparison token maps to. Only called for tokens
// `comparisonOperator` classified as comparisons; anything else is a climber bug, so
// it panics rather than guessing. Kept separate from `infixMaxonOp` because a
// comparison is a distinct op family (`MaxonOp.compare`), not a `binOp` opcode.
function infixCmpOp(kind TokenKind) returns MaxonCmpOp
	if kind == TokenKind.equalsEquals 'eq'
		return MaxonCmpOp.eq
	end 'eq'

	if kind == TokenKind.bangEquals 'ne'
		return MaxonCmpOp.ne
	end 'ne'

	if kind == TokenKind.lessThan 'lt'
		return MaxonCmpOp.lt
	end 'lt'

	if kind == TokenKind.greaterThan 'gt'
		return MaxonCmpOp.gt
	end 'gt'

	if kind == TokenKind.lessEquals 'le'
		return MaxonCmpOp.le
	end 'le'

	if kind == TokenKind.greaterEquals 'ge'
		return MaxonCmpOp.ge
	end 'ge'

	panic("infixCmpOp: token '{kind.rawValue}' is not a comparison operator — comparisonOperator must gate this call")
end 'infixCmpOp'

// The comparison operators (M4). Each maps to a `MaxonOp.compare` and, since it
// feeds an `if`, fuses with the branch at the x64 tier. Classifier shared by the
// precedence table (`infixPrecedence`) and the climber's op-dispatch (`parseBinary`).
function comparisonOperator(kind TokenKind) returns bool
	return kind == TokenKind.equalsEquals or kind == TokenKind.bangEquals or kind == TokenKind.lessThan or kind == TokenKind.lessEquals or kind == TokenKind.greaterThan or kind == TokenKind.greaterEquals
end 'comparisonOperator'

// --- M4b loop / on-the-fly SSA support ---

// How many mutable bindings were in scope when a lexical block was opened. A `var`
// declared inside the block joins `Parser.mutableVars`, and must LEAVE it at the
// block's `end`: a binding no source line can name any more must not receive a loop
// phi, nor take a slot in a merge snapshot.
typealias MutableVarMark = int(0 to u64.max)

// A loop-header (or loop-exit) phi: the mutable BINDING it carries, paired with the
// block-arg ValueId minted for it. POSITIONAL — the k-th phi var corresponds to
// `blockArgs[k]` on the merge block and to `argIds[k]` on every predecessor's
// `BranchEdge`, so all three follow one order (mutable-binding declaration order).
//
// The binding is held as the `VarInfo` OBJECT, not as its name. A name cannot address
// it: a block nested inside the loop may SHADOW the name, and then a name-keyed read
// would fetch the shadow — so `break`ing out of such a block would carry the shadow's
// value into the loop's exit phi. A silent miscompile, and the reason `Scope` mutates
// bindings in place instead of replacing them (see Scope's header).
type LoopPhiVar
	export var binding as VarInfo
	export var phiId as ValueId

	export static function create(binding VarInfo, phiId ValueId) returns LoopPhiVar
		return Self{binding: binding, phiId: phiId}
	end 'create'
end 'LoopPhiVar'

typealias LoopPhiVarArray = Array with LoopPhiVar

// One enclosing loop on the parser's loop-context stack. `break`/`continue` read it
// to find their targets (innermost, or by label) and to build the block-arg value
// lists they carry to the exit / header. Because the header phis are created EAGERLY
// at loop entry (before the body is parsed), every in-edge can fill its BranchEdge
// argIds immediately from the current variable values — there is no deferred
// phi-operand backpatching, which keeps the loop lowering a single forward pass.
//
// This mirrors v1's parser loop stack (maxon-selfhosted Parser.parseWhileStatement:
// same cond/header + body + exit block shape, same entry→header branch and
// condBr(then=body, else=exit)). One field v1 carries that this does not: a separate
// `continueBlockId`. In a `while`, `continue` re-evaluates the condition, so its target
// IS the header (`headerId` here); v1 splits the two only for `for` loops, whose
// `continue` jumps to a STEP block that runs the increment before the header. When
// `for` lands (M5), this gains that split; at M4b `continue` → `headerId` is exact.
type LoopContext
	export var label as ByteArray
	export var headerId as BlockId
	export var exitId as BlockId
	export var phiVars as LoopPhiVarArray
	// True once at least one `break` targeted this loop — the exit then merges the
	// header-false-edge value with each break's value, so it needs its own phis.
	export var hasBreak as bool

	export static function create(label ByteArray, headerId BlockId, exitId BlockId, phiVars LoopPhiVarArray) returns LoopContext
		return Self{label: label, headerId: headerId, exitId: exitId, phiVars: phiVars, hasBreak: false}
	end 'create'
end 'LoopContext'

typealias LoopContextArray = Array with LoopContext

export type Parser
	var tokens as TokenArray
	var pos as TokenIndex
	var filePath as FilePath
	var namespace as String
	// The sole output. Every emit/registry write lands here, never on `Project`.
	var artifact as FileParseArtifact
	// Per-function symbol table (empty at M1 — no locals). Reset per function.
	var scope as Scope
	// Per-function ValueId allocator for the values this function's ops define.
	// Re-seeded at `paramCount` per function (params implicitly own 0..paramCount-1
	// by Std-ABI convention), so ids are dense and function-local. The parser is
	// where value numbering is BORN — see MaxonDialect's MaxonOp header.
	var valueIds as ValueIdRef
	// The `var` bindings currently IN SCOPE, in declaration order (M4b) — held as the
	// `VarInfo` objects, for the reason LoopPhiVar documents. A loop header mints one
	// phi per mutable binding in scope, and the phi order follows this list so that
	// block-args and every predecessor's BranchEdge argIds stay positionally aligned.
	// `let` bindings never appear (they cannot be reassigned, so they carry no
	// loop-carried phi). A block's `var`s are drained off the end of this list at the
	// block's `end` (see closeBlock). Reset per function.
	var mutableVars as VarInfoArray
	// The enclosing loops, innermost last (M4b). `break`/`continue` resolve their
	// target here; a `while` pushes on entry and pops after its body. Reset per
	// function (a stray entry across functions would be a parser bug).
	var loops as LoopContextArray

	export static function create(tokens TokenArray, filePath FilePath, namespace String) returns Parser
		return Self{
			tokens: tokens,
			pos: 0,
			filePath: filePath,
			namespace: namespace,
			artifact: FileParseArtifact.create(filePath),
			scope: Scope.create(),
			valueIds: ValueIdRef.create(0),
			mutableVars: VarInfoArray.create(),
			loops: LoopContextArray.create()
		}
	end 'create'

	// Parse the whole file into its artifact. Top-level loop: skip blank lines,
	// dispatch each declaration, stop at EOF.
	export function parseModule() returns FileParseArtifact throws ParseError
		while true 'top'
			self.skipNewlines()
			if self.isEof() 'done'
				break
			end 'done'
			try self.dispatchTopLevel()
		end 'top'
		return self.artifact
	end 'parseModule'

	// One top-level declaration: an optional `export`, then a `function` or a ranged
	// `typealias`. Everything else (type, enum, union, extension, top-level `let`/`var`,
	// ...) is out of the slice and rejected with a positioned error.
	//
	// `visibility` is consumed only by `parseFunction`. A typealias carries one too, and
	// it is deliberately DROPPED: alias visibility decides whether a name is reachable
	// from another FILE, and the alias registry is whole-program until cross-file name
	// resolution lands (see `commitTypeAliases`). Recording it now would be a field
	// nothing reads.
	function dispatchTopLevel() throws ParseError
		var visibility = Visibility.file
		if self.at(TokenKind.export) 'exported'
			self.advance()
			visibility = Visibility.module
		end 'exported'

		if self.at(TokenKind.function) 'isFunction'
			try self.parseFunction(visibility)
		end 'isFunction' else if self.at(TokenKind.typealias) 'isTypeAlias'
			try self.parseTypeAlias()
		end 'isTypeAlias' else 'unsupported'
			let tok = self.current()
			throw ParseError.unsupported("top-level {tok.kind.rawValue}", line: tok.line, column: tok.column)
		end 'unsupported'
	end 'dispatchTopLevel'

	// Parse a ranged typealias declaration: `typealias <Name> = int(<low> to|upto <high>)`.
	// Nearly every real Maxon file opens with one — `int` is almost never written bare in
	// a type position (specs/ranged-typealias.md) — so this is the declaration that gates
	// most of the corpus.
	//
	// It emits NO op: an alias is a DECLARATION, and its whole effect is the registry
	// entry recorded here, which TypeResolution substitutes for every `MaxonType.named`
	// use of the name. Two aliases over the same range are therefore the SAME type — an
	// alias creates no nominal distinction — and a use in a type position needs no parser
	// change at all (`parseTypeReference` already interns a bare identifier).
	//
	// The RANGE is recorded but not yet enforced: a narrowing conversion into a ranged
	// alias is checked at run time, and that check is a later milestone. The corpus's
	// ranges are overwhelmingly WIDE (`i64.min to i64.max`, `0 to u64.max`), for which no
	// check would be emitted regardless.
	function parseTypeAlias() throws ParseError
		try self.consume(TokenKind.typealias)
		let nameTok = try self.consume(TokenKind.identifier)
		try self.consume(TokenKind.equals)

		// `int(...)` only. A `float(...)` alias needs float literals for its bounds, a
		// generic alias (`Array with T`) needs generics, and a bare `i64` is not legal
		// Maxon at all — each is rejected here, naming its own gap, rather than being
		// mapped onto the integer path where it would silently mean something else.
		if not self.at(TokenKind.int) 'notInt'
			let tok = self.current()
			throw ParseError.unsupported("a typealias over '{tok.kind.rawValue}' (only `int(low to high)` is parsed; float, generic and bare-sized aliases arrive with the milestones that give them meaning)", line: tok.line, column: tok.column)
		end 'notInt'
		try self.consume(TokenKind.int)

		try self.consume(TokenKind.leftParen)
		let low = try self.parseRangeBound()
		let high = try self.parseRangeUpperBound()
		try self.consume(TokenKind.rightParen)

		self.artifact.recordTypeAlias(RangedTypeAlias.create(nameTok.value, underlying: MaxonType.integer, low: low, high: high))
	end 'parseTypeAlias'

	// The `to <high>` / `upto <high>` half of a range, returned as an INCLUSIVE upper
	// bound: `upto` is exclusive, so it normalizes to `high - 1` here and the registry
	// keeps exactly one representation of a range (`0 upto 10` and `0 to 9` are the same
	// alias, which is what the language says they are).
	//
	// `i64.min` has no `upto` form — its exclusive bound would be one BELOW the smallest
	// representable value. Rejected with a positioned error, because the subtraction that
	// normalizes it would otherwise underflow `ParsedInt` and take the COMPILER down on a
	// source file it should merely have diagnosed.
	function parseRangeUpperBound() returns ParsedInt throws ParseError
		if self.at(TokenKind.upto) 'exclusive'
			let uptoTok = try self.consume(TokenKind.upto)
			let bound = try self.parseRangeBound()
			if bound == I64MinBound 'unrepresentable'
				throw ParseError.unsupported("an exclusive upper bound of i64.min — its inclusive form is one below the smallest 64-bit integer, so the range is empty and not representable", line: uptoTok.line, column: uptoTok.column)
			end 'unrepresentable'
			return bound - 1
		end 'exclusive'

		try self.consume(TokenKind.to)
		return try self.parseRangeBound()
	end 'parseRangeUpperBound'

	// One endpoint of a range: an integer literal (`0`, `-273`, `0xFFFF`) or a
	// type-qualified bound (`i64.min`, `u32.max`).
	function parseRangeBound() returns ParsedInt throws ParseError
		if self.at(TokenKind.minus) 'negative'
			try self.consume(TokenKind.minus)
			let tok = try self.consume(TokenKind.intLiteral)
			return try self.intLiteralValue(tok, negated: true)
		end 'negative'

		if self.at(TokenKind.intLiteral) 'literal'
			let tok = try self.consume(TokenKind.intLiteral)
			return try self.intLiteralValue(tok, negated: false)
		end 'literal'

		return try self.parseTypeQualifiedBound()
	end 'parseRangeBound'

	// Convert an integer-literal token's text to its value, re-raising NumberParsing's
	// overflow as a POSITIONED parse error. THE one place a literal's text becomes a
	// number: the expression parser (`parseIntLiteral`) and the range-bound parser both
	// come through it, so how a literal is read — the radix prefixes it accepts, the
	// overflow it rejects — cannot come to mean one thing in `return 42` and another in
	// `int(0 to 42)`.
	//
	// `negated` routes to `parseNegatedInt` rather than negating the result: `i64.min`'s
	// magnitude does not fit a POSITIVE i64, so negating after the fact would overflow on
	// the one bound that most needs to work.
	function intLiteralValue(tok Token, negated bool) returns ParsedInt throws ParseError
		if negated 'negative'
			return try parseNegatedInt(tok.value) otherwise throw ParseError.integerOverflow(tok.line, column: tok.column)
		end 'negative'
		return try parseInt(tok.value) otherwise throw ParseError.integerOverflow(tok.line, column: tok.column)
	end 'intLiteralValue'

	// A type-qualified numeric bound — `<sized>.min` / `<sized>.max`, three tokens
	// (identifier, `.`, identifier). Shared by the range-declaration parser and the
	// expression parser, which meet the same three tokens in two positions.
	function parseTypeQualifiedBound() returns ParsedInt throws ParseError
		let typeTok = try self.consume(TokenKind.identifier)
		try self.consume(TokenKind.dot)
		let fieldTok = try self.consume(TokenKind.identifier)
		let wantMax = try self.boundFieldIsMax(fieldTok)

		match sizedTypeBound(typeTok.value, wantMax: wantMax) 'resolve'
			value(bound) then return bound
			floatBound then throw ParseError.unsupported("the float bound '{String.from(typeTok.value)}.{String.from(fieldTok.value)}' (float bounds arrive with floats)", line: typeTok.line, column: typeTok.column)
			notASizedType then throw ParseError.unexpectedToken("a sized numeric type (u8/u16/u32/u64/i8/i16/i32/i64)", got: String.from(typeTok.value), line: typeTok.line, column: typeTok.column)
		end 'resolve'
	end 'parseTypeQualifiedBound'

	// True for `.max`, false for `.min`. Any other field name is a positioned error —
	// a sized type exposes exactly these two bounds.
	function boundFieldIsMax(fieldTok Token) returns bool throws ParseError
		if fieldTok.value.equals(MaxBoundField) 'max'
			return true
		end 'max'
		if fieldTok.value.equals(MinBoundField) 'min'
			return false
		end 'min'
		throw ParseError.unexpectedToken("'min' or 'max'", got: String.from(fieldTok.value), line: fieldTok.line, column: fieldTok.column)
	end 'boundFieldIsMax'

	// Parse a free function: `function <name>(<params>) [returns <Type>] <body> end
	// [label]`. M5 adds parameters (`name type`, comma-separated); there is still no
	// `main` qualification (single-file build), so the declared name is used verbatim
	// for registry keys — `main` stays `main`.
	function parseFunction(visibility Visibility) throws ParseError
		try self.consume(TokenKind.function)
		let nameTok = try self.consume(TokenKind.identifier)
		let name = nameTok.value

		// Parameters are parsed into parallel name/type lists BEFORE the scope reset:
		// binding them needs the fresh per-function scope + value numbering, which is
		// re-seeded at the resulting paramCount just below. Parsing itself only
		// consumes tokens, so it needs no scope.
		try self.consume(TokenKind.leftParen)
		var paramNames = ByteArrayArray.create()
		var paramTypes = MaxonTypeArray.create()
		// Parallel to `paramNames`: each parameter's name-token span, so `bindParameters` can
		// record a ValueOrigin at the DECLARATION for parameter `i` — the source site the
		// E5001 diagnostic points at when a parameter is in a register-pressure blocking set.
		var paramRanges = SourceRangeArray.create()
		try self.parseFunctionParameters(paramNames, paramTypes: paramTypes, paramRanges: paramRanges)
		try self.consume(TokenKind.rightParen)

		let returnType = try self.parseOptionalReturnType()

		// Fresh per-function value numbering, seeded at the function's paramCount so
		// parameter ids occupy 0..paramCount-1 by Std-ABI convention (a body value
		// then starts at paramCount — see IrValueId's ValueIdRef contract).
		let paramCount = paramNames.count()
		self.scope.reset()
		self.valueIds = ValueIdRef.create(paramCount)
		self.mutableVars = VarInfoArray.create()
		self.loops = LoopContextArray.create()

		// Bind each parameter name to its reserved ValueId (i for parameter i), so a
		// body reference resolves straight to the parameter's SSA value — the same
		// value-substitution model `let`/`var` bindings use. Parameters are immutable
		// (a reassignment is E2013); mutating a parameter needs a local shadow.
		self.bindParameters(paramNames, paramTypes: paramTypes, paramRanges: paramRanges)

		var func = IrFunction.create(name, maxonReturnType: returnType, paramCount: paramCount, maxonParamTypes: paramTypes, returnLine: nameTok.line)
		func.namespace = self.namespace
		func.visibility = visibility
		func.sourceFilePath = self.filePath
		func.nameLine = nameTok.line
		func.nameColumn = nameTok.column

		// Create the entry block (registered in func.blockRefs) BEFORE pushing the
		// function, mirroring the backend's own function-building order.
		var entry = self.artifact.module.addBlockAt(func, label: b"entry", filePath: self.filePath.toString(), firstLine: nameTok.line)

		self.skipNewlines()
		// parseStatements threads a "current block" that control-flow statements can
		// move forward (an `if` leaves subsequent statements in its continuation block),
		// so the block it RETURNS — not `entry` — is the one control falls out of.
		var bodyEnd = try self.parseStatements(func, block: entry)
		try self.closeFunctionBody(bodyEnd, returnType: returnType, nameTok: nameTok)

		try self.consume(TokenKind.end)
		self.skipOptionalLabel()

		self.artifact.module.pushFunc(func)
		self.artifact.recordFuncReturnType(name, returnType: returnType)
		self.artifact.recordFuncSignature(name, signature: FuncSignature.create(paramNames, paramTypes: paramTypes), nameLine: nameTok.line, nameColumn: nameTok.column, sourceFilePath: self.filePath)
	end 'parseFunction'

	// Close a function body. `bodyEnd` is the block its last statement left control in;
	// when that block has no terminator, control can FALL OFF THE END of the function
	// and the parser must supply what the source did not:
	//
	//   • VOID function — the implicit `return`. This is why `function doNothing()
	//     end 'doNothing'` compiles (specs/empty-block.md), and it is what every void
	//     function needs, not just an empty one: no void body writes a trailing
	//     `return`. Without it the block reaches the backend in `Terminator.unset`.
	//   • VALUE-returning function — an error: control would leave with no value to
	//     return. E3013, positioned at the function's name (specs/missing-return-error.md).
	//
	// An already-terminated `bodyEnd` covers the UNREACHABLE case for free: an `if`
	// whose branches all return leaves its continuation marked `dead`, which counts as
	// terminated — so `main` ending in a fully-returning `if`/`else` is not a missing
	// return. The synthetic `retVoid` is anchored on the function's name for the same
	// reason E3013 is: no source token spawned it, and the name is where a reader looks
	// for "what does this function return?".
	function closeFunctionBody(bodyEnd IrBlock, returnType MaxonReturnType, nameTok Token) throws ParseError
		if bodyEnd.isTerminated() 'terminated'
			return
		end 'terminated'

		if not maxonReturnTypeIsVoid(returnType) 'fallsOffEnd'
			throw ParseError.missingReturn(String.from(nameTok.value), line: nameTok.line, column: nameTok.column)
		end 'fallsOffEnd'

		self.artifact.emitTerminator(bodyEnd, op: MaxonOp.retVoid, range: SourceRange.ofToken(nameTok))
	end 'closeFunctionBody'

	// Parse a comma-separated parameter list `name type[, name type]*` into the
	// parallel `paramNames`/`paramTypes` lists (empty when the list is empty). Each
	// parameter is `name type` — a bare identifier followed by a type reference. A
	// `= <default>` after the type is a later milestone, so it is rejected here with
	// a positioned `unsupported` rather than silently dropped. The caller has already
	// consumed the `(` and consumes the closing `)`.
	function parseFunctionParameters(paramNames ByteArrayArray, paramTypes MaxonTypeArray, paramRanges SourceRangeArray) throws ParseError
		if self.at(TokenKind.rightParen) 'noParams'
			return
		end 'noParams'

		while true 'paramLoop'
			let nameTok = try self.consume(TokenKind.identifier)
			let paramType = try self.parseTypeReference()

			if self.at(TokenKind.equals) 'hasDefault'
				let eqTok = self.current()
				throw ParseError.unsupported("a default value on parameter '{String.from(nameTok.value)}' (parameter defaults arrive at a later milestone)", line: eqTok.line, column: eqTok.column)
			end 'hasDefault'

			if byteArrayContains(paramNames, name: nameTok.value) 'duplicate'
				throw ParseError.duplicateParameter(String.from(nameTok.value), line: nameTok.line, column: nameTok.column)
			end 'duplicate'

			paramNames.push(nameTok.value)
			paramTypes.push(paramType)
			paramRanges.push(SourceRange.ofToken(nameTok))

			if paramNames.count() > MaxRegisterParams 'tooMany'
				throw ParseError.unsupported("more than {MaxRegisterParams} parameters (M5 passes arguments in registers only; stack arguments are a later milestone)", line: nameTok.line, column: nameTok.column)
			end 'tooMany'

			if not self.at(TokenKind.comma) 'endParams'
				break
			end 'endParams'
			try self.consume(TokenKind.comma)
		end 'paramLoop'
	end 'parseFunctionParameters'

	// Bind each parameter name to its reserved SSA ValueId in the fresh function
	// scope: parameter `i` is ValueId `i` (the ids 0..paramCount-1 the value
	// numbering reserved). Bound as an immutable value binding, so a body reference
	// resolves to the parameter value and a reassignment is rejected as immutable.
	function bindParameters(paramNames ByteArrayArray, paramTypes MaxonTypeArray, paramRanges SourceRangeArray)
		for i in 0 upto paramNames.count() 'eachParam'
			let paramName = try paramNames.get(i) otherwise panic("bindParameters: paramNames.get OOB at {i}")
			let paramType = try paramTypes.get(i) otherwise panic("bindParameters: paramTypes.get OOB at {i}")
			let paramRange = try paramRanges.get(i) otherwise panic("bindParameters: paramRanges.get OOB at {i}")
			// The installed binding is discarded: only MUTABLE bindings are tracked by
			// reference (for loop phis), and a parameter is immutable.
			_ = self.scope.declareValueBinding(paramName, varType: paramType, mutable: false, value: i as ValueId)
			// Parameter `i` owns ValueId `i`; record its declaration span so the register-pressure
			// diagnostic can resolve the parameter to source (it is minted by no op — see
			// ParamOriginTable — so it has no `emitOp` origin).
			self.artifact.recordParamOrigin(i as ValueId, range: paramRange)
		end 'eachParam'
	end 'bindParameters'

	// `returns <Type>` or nothing (void). The return type flows to the registry
	// (for SemanticCheck) and to lowering (via the function signature).
	function parseOptionalReturnType() returns MaxonReturnType throws ParseError
		if not self.at(TokenKind.returns) 'noReturns'
			return MaxonReturnType.void
		end 'noReturns'
		try self.consume(TokenKind.returns)
		return MaxonReturnType.value(try self.parseTypeReference())
	end 'parseOptionalReturnType'

	// A type reference. M1: a bare identifier (a named type like `ExitCode`,
	// interned into the artifact's local interner) or a bare primitive keyword.
	// Ranged/generic/qualified type syntax grows at M2+.
	function parseTypeReference() returns MaxonType throws ParseError
		if self.at(TokenKind.identifier) 'named'
			let tok = try self.consume(TokenKind.identifier)
			return MaxonType.named(self.artifact.typeNames.intern(tok.value))
		end 'named'
		if self.at(TokenKind.int) 'primInt'
			try self.consume(TokenKind.int)
			return MaxonType.integer
		end 'primInt'
		if self.at(TokenKind.bool) 'primBool'
			try self.consume(TokenKind.bool)
			return MaxonType.boolean
		end 'primBool'
		if self.at(TokenKind.float) 'primFloat'
			try self.consume(TokenKind.float)
			return MaxonType.float
		end 'primFloat'
		let tok = self.current()
		throw ParseError.unexpectedToken("a type", got: tok.kind.rawValue, line: tok.line, column: tok.column)
	end 'parseTypeReference'

	// Statement list until the closing `end`, emitting into `block`. Returns the block
	// the LAST statement left control in — the same `block` for straight-line code, but
	// an `if` moves control into its continuation block, so subsequent statements (and
	// the caller) must follow it. `func` is threaded so control-flow statements can
	// create successor blocks. Blank lines separate statements.
	function parseStatements(func IrFunction, block IrBlock) returns IrBlock throws ParseError
		var current = block
		while true 'stmts'
			self.skipNewlines()
			if self.at(TokenKind.end) 'endBlock'
				break
			end 'endBlock'
			if self.isEof() 'eof'
				let tok = self.current()
				throw ParseError.unexpectedEof(tok.line, column: tok.column)
			end 'eof'
			current = try self.parseStatement(func, block: current)
		end 'stmts'
		return current
	end 'parseStatements'

	// One statement. Returns the block subsequent statements continue in — `block`
	// itself for `return`/`let`/`var`/assignment/`break`/`continue` (straight-line),
	// an `if`'s continuation block, or a `while`'s exit block. M4a added `if`; M4b
	// added assignment, `while`, `break`, and `continue`.
	function parseStatement(func IrFunction, block IrBlock) returns IrBlock throws ParseError
		if self.at(TokenKind.return) 'ret'
			try self.parseReturnStatement(block)
			return block
		end 'ret' else if self.at(TokenKind.let) 'letDecl'
			try self.parseBinding(block, mutable: false)
			return block
		end 'letDecl' else if self.at(TokenKind.var) 'varDecl'
			try self.parseBinding(block, mutable: true)
			return block
		end 'varDecl' else if self.at(TokenKind.if) 'ifStmt'
			return try self.parseIfStatement(func, block: block)
		end 'ifStmt' else if self.at(TokenKind.while) 'whileStmt'
			return try self.parseWhileStatement(func, block: block)
		end 'whileStmt' else if self.at(TokenKind.break) 'breakStmt'
			try self.parseBreakStatement(block)
			return block
		end 'breakStmt' else if self.at(TokenKind.continue) 'continueStmt'
			try self.parseContinueStatement(block)
			return block
		end 'continueStmt' else if self.at(TokenKind.identifier) and self.peekKind() == TokenKind.equals 'assign'
			// An identifier followed by `=` is a reassignment. The two-token lookahead
			// keeps a bare identifier from being mis-parsed as an incomplete assignment.
			try self.parseAssignment(block)
			return block
		end 'assign' else if self.at(TokenKind.identifier) and self.peekKind() == TokenKind.leftParen 'callStmt'
			// An identifier followed by `(` is a bare-call statement — the call is
			// evaluated for its effect and its result discarded (M5).
			try self.parseCallStatement(block)
			return block
		end 'callStmt' else 'unsupported'
			let tok = self.current()
			throw ParseError.unsupported("{tok.kind.rawValue} statement", line: tok.line, column: tok.column)
		end 'unsupported'
	end 'parseStatement'

	// Parse a `let`/`var` binding: `let <name> = <expr>`. M2 rejects a type
	// annotation — a `:` after the name makes the `=` consume fail with E2010
	// (`Expected '=' but got ':'`), which IS the `variables.md` type-annotation
	// contract, so no explicit `:` check is needed. The initializer's SSA value is
	// bound to the name in the scope, so a later reference resolves straight to it
	// (no slot, no load/store — see Scope.declareValueBinding). `mutable`
	// distinguishes `var` from `let`: only a `var` may be reassigned, and only a `var`
	// carries a loop-carried phi.
	//
	// The binding lands in the INNERMOST open scope frame, so a declaration inside an
	// `if`/`while` body is gone at its `end` — and may legally SHADOW an outer binding
	// of the same name while it lives (specs/block-scoping.md).
	function parseBinding(block IrBlock, mutable bool) throws ParseError
		if mutable 'isVar'
			try self.consume(TokenKind.var)
		end 'isVar' else 'isLet'
			try self.consume(TokenKind.let)
		end 'isLet'

		let nameTok = try self.consume(TokenKind.identifier)
		try self.consume(TokenKind.equals)
		let value = try self.parseExpression(block)
		var binding = self.scope.declareValueBinding(nameTok.value, varType: MaxonType.integer, mutable: mutable, value: value)
		if mutable 'trackVar'
			// Record `var`s in declaration order so loop headers can mint phis for every
			// mutable binding in scope (M4b on-the-fly SSA). `let`s never join — they
			// cannot be reassigned, so they carry no loop-carried phi.
			self.mutableVars.push(binding)
		end 'trackVar'
	end 'parseBinding'

	// Open a lexical block — an `if` / `else` / `while` body. Two things are scoped to
	// it and must be opened and closed TOGETHER: the Scope frame its declarations land
	// in, and the height of the mutable-binding list. A `var` that leaves scope must
	// also leave that list, or the next merge snapshot would mint a phi for a binding
	// no source line can name. Returns the mark `closeBlock` unwinds to.
	function openBlock() returns MutableVarMark
		self.scope.pushScope()
		return self.mutableVars.count()
	end 'openBlock'

	// Close a lexical block: drop its declarations out of scope (restoring anything they
	// shadowed) and its `var`s off the mutable-binding list.
	function closeBlock(mark MutableVarMark)
		self.scope.popScope()
		while self.mutableVars.count() > mark 'drain'
			_ = try self.mutableVars.pop() otherwise panic("closeBlock: mutableVars.pop failed above the mark {mark}")
		end 'drain'
	end 'closeBlock'

	// Parse a lexical block's statements into `block`, through its closing `end [label]`.
	// The ONE place a block body is parsed, so the scope frame is opened and closed in
	// one place too: an `if` body, an `else` body and a `while` body all come through
	// here. The caller has already consumed the block's opening label.
	//
	// Returns the block the body's last statement left control in (which is `block`
	// itself only for straight-line code — a nested `if` moves control into its
	// continuation).
	function parseBlockBody(func IrFunction, block IrBlock) returns IrBlock throws ParseError
		let mark = self.openBlock()
		self.skipNewlines()
		let bodyEnd = try self.parseStatements(func, block: block)
		try self.consume(TokenKind.end)
		self.skipOptionalLabel()
		self.closeBlock(mark)
		return bodyEnd
	end 'parseBlockBody'

	// Parse a reassignment `<name> = <expr>` (M4b). The target must be a declared
	// `var`; a `let` target is E2013, an undeclared name is `undefinedVariable`. The
	// RHS is evaluated FIRST (so `x = x + 1` reads the old `x`), then the binding's
	// current SSA value is rebound to the result via `Scope.setValue` — the read-
	// after-write model that makes a later reference see the new value. No slot,
	// no store op: the value model is on-the-fly SSA (the reassignment is just a
	// rebinding of the variable's current ValueId, and the loop machinery inserts
	// phis where the rebinding crosses a control-flow merge).
	function parseAssignment(block IrBlock) throws ParseError
		let nameTok = try self.consume(TokenKind.identifier)
		try self.consume(TokenKind.equals)
		if not self.scope.contains(nameTok.value) 'undeclared'
			throw ParseError.undefinedVariable(String.from(nameTok.value), line: nameTok.line, column: nameTok.column)
		end 'undeclared'
		if not self.scope.getInfo(nameTok.value).mutable 'immutable'
			throw ParseError.assignToImmutable(String.from(nameTok.value), line: nameTok.line, column: nameTok.column)
		end 'immutable'
		let value = try self.parseExpression(block)
		self.scope.setValue(nameTok.value, value: value)
	end 'parseAssignment'

	// `return [<expr>]`. Sets the block's terminator directly. A bare `return`
	// emits the distinct `retVoid` variant rather than a `ret` carrying some
	// absent-value sentinel — see MaxonDialect's `retVoid`.
	function parseReturnStatement(block IrBlock) throws ParseError
		let retTok = try self.consume(TokenKind.return)
		if self.at(TokenKind.newline) or self.at(TokenKind.end) or self.isEof() 'bareReturn'
			self.artifact.emitTerminator(block, op: MaxonOp.retVoid, range: SourceRange.ofToken(retTok))
			return
		end 'bareReturn'
		let retVal = try self.parseExpression(block)
		self.artifact.emitTerminator(block, op: MaxonOp.ret(retVal), range: SourceRange.ofToken(retTok))
	end 'parseReturnStatement'

	// Parse an `if` statement (M4):
	//   if <cond> 'thenLabel'
	//       <then-stmts>
	//   end 'thenLabel' [ else 'elseLabel' <else-stmts> end 'elseLabel'
	//                   | else if <cond> …  (the else branch is itself a nested `if`) ]
	//
	// Lowering shape: the entry block (`block`) evaluates `cond` (a comparison, whose
	// value the Std→x64 pass fuses with the branch) and gets a `condBranch` terminator
	// selecting the then block vs the false target (the else block, or the continuation
	// when there is no else). A branch that returns terminates itself; one that falls
	// through gets a `branch` to the continuation. Blocks are created then→else→
	// continuation so `.text` lays them out in source order.
	//
	// Returns the CONTINUATION — where control resumes after the `if`. It is either
	// reachable (Terminator.unset, so subsequent statements emit into it — e.g. the
	// `return 0` after a simple `if`) or, when both branches return, unreachable
	// (Terminator.dead — emits no code, but is still returned so the caller always has
	// a block to continue in).
	//
	// M4b VALUE MERGE: because a `var` may be reassigned inside a branch, the value of
	// a variable at the continuation depends on which path ran. The parser snapshots
	// each mutable var's value entering the branches, RESTORES it before the else/false
	// path (so that path resumes from the pre-`if` state), and at the continuation
	// merges the two incoming snapshots — a variable that differs across the paths gets
	// a continuation PHI (the same block-arg mechanism loops use), everything else keeps
	// its common value. Without this, a `var` written only on the taken path would leak
	// its then-value onto the not-taken path (a real miscompile).
	//
	// Each branch body is a lexical BLOCK (parseBlockBody), so the three snapshots are
	// all taken at the SAME scope depth — a `var` declared inside a branch has left
	// `mutableVars` by the time that branch's exit values are read, which is what keeps
	// `entryVals` / `thenVals` / `elseVals` positionally aligned.
	function parseIfStatement(func IrFunction, block IrBlock) returns IrBlock throws ParseError
		let ifTok = try self.consume(TokenKind.if)
		let cond = try self.parseCondition(block)
		let thenLabel = try self.consume(TokenKind.charLiteral)

		// Values entering the branches (the condition only reads, so `block`'s values
		// are unchanged by it). Positional over `mutableVars`, like a loop phi list.
		let entryVals = self.snapshotMutableValues()

		// `var` because these blocks are passed to functions that mutate them (the
		// statement parser fills the block; the finalizers wire its terminator) — a
		// `let` binding cannot be forwarded to a mutating parameter (E3019).
		var thenBlock = self.newBlock(func, label: thenLabel.value, line: thenLabel.line)
		var thenEnd = try self.parseBlockBody(func, block: thenBlock)

		// Snapshot the then-branch's exit values, then rewind to the entry state so the
		// else/false path is parsed against the pre-`if` values, not the then-branch's.
		let thenVals = self.snapshotMutableValues()
		self.restoreValues(entryVals)

		if not self.at(TokenKind.else) 'noElse'
			return self.finalizeIfNoElse(func, entry: block, cond: cond, ifTok: ifTok, thenBlock: thenBlock, thenEnd: thenEnd, entryVals: entryVals, thenVals: thenVals)
		end 'noElse'

		try self.consume(TokenKind.else)
		var elseBlock = self.newBlock(func, label: b"ifelse", line: ifTok.line)
		var elseEnd = try self.parseElseBody(func, elseBlock: elseBlock)
		let elseVals = self.snapshotMutableValues()
		return self.finalizeIfElse(func, entry: block, cond: cond, ifTok: ifTok, thenBlock: thenBlock, thenEnd: thenEnd, elseBlock: elseBlock, elseEnd: elseEnd, thenVals: thenVals, elseVals: elseVals)
	end 'parseIfStatement'

	// Parse an `else` body into `elseBlock`: either a nested `if` (the `else if …`
	// chain — the else branch IS a nested if statement, so `elseBlock` becomes that
	// if's entry) or a plain labelled `else` block. Returns the block the else branch
	// left control in (its own continuation for a nested if; the block its last
	// statement filled for a plain else).
	//
	// The `else if` form opens NO scope frame of its own: its condition is evaluated in
	// the ENCLOSING scope (it is not inside any block), and each of the nested if's own
	// branches opens a frame when it is parsed. Only the plain `else 'label'` form is a
	// block body.
	function parseElseBody(func IrFunction, elseBlock IrBlock) returns IrBlock throws ParseError
		if self.at(TokenKind.if) 'elseIf'
			return try self.parseIfStatement(func, block: elseBlock)
		end 'elseIf'

		try self.consume(TokenKind.charLiteral)
		return try self.parseBlockBody(func, block: elseBlock)
	end 'parseElseBody'

	// Finalize an `if` with no `else`: the false path flows straight to the
	// continuation, so the continuation is always reachable. Wire the entry's
	// condBranch (then vs continuation). When the then branch falls through, the
	// continuation merges the false-edge values (`entryVals`) with the then-branch's
	// exit values (`thenVals`) — a differing var gets a continuation phi. When the then
	// branch returns, the continuation is reached only from the false edge, whose values
	// are already the restored `entryVals`.
	function finalizeIfNoElse(func IrFunction, entry IrBlock, cond ValueId, ifTok Token, thenBlock IrBlock, thenEnd IrBlock, entryVals ValueIdArray, thenVals ValueIdArray) returns IrBlock
		var cont = self.newBlock(func, label: b"ifcont", line: ifTok.line)
		self.emitCondBranch(entry, cond: cond, thenId: thenBlock.id, elseId: cont.id, ifTok: ifTok)
		if not thenEnd.isTerminated() 'thenFallsThrough'
			self.mergeAtContinuation(entry, predB: thenEnd, cont: cont, valsA: entryVals, valsB: thenVals)
			self.emitBranch(thenEnd, targetId: cont.id)
		end 'thenFallsThrough'
		return cont
	end 'finalizeIfNoElse'

	// Finalize an `if`/`else`: the entry's condBranch targets the then and else blocks.
	// The continuation is reachable only when a branch falls through; when BOTH return
	// it is unreachable and marked `dead`. When BOTH fall through, the continuation
	// merges their exit values (`thenVals`/`elseVals`) with phis for the vars that
	// differ. When only ONE falls through, the continuation simply carries that branch's
	// values (no phi — a single predecessor).
	function finalizeIfElse(func IrFunction, entry IrBlock, cond ValueId, ifTok Token, thenBlock IrBlock, thenEnd IrBlock, elseBlock IrBlock, elseEnd IrBlock, thenVals ValueIdArray, elseVals ValueIdArray) returns IrBlock
		self.emitCondBranch(entry, cond: cond, thenId: thenBlock.id, elseId: elseBlock.id, ifTok: ifTok)
		let thenTerminated = thenEnd.isTerminated()
		let elseTerminated = elseEnd.isTerminated()

		if thenTerminated and elseTerminated 'bothReturn'
			// Nothing reaches the continuation — mark it dead rather than leave it
			// unterminated (assertAllBlocksTerminated forbids an unset block).
			var cont = self.newBlock(func, label: b"ifcont", line: ifTok.line)
			cont.terminator = Terminator.dead
			return cont
		end 'bothReturn'

		var cont = self.newBlock(func, label: b"ifcont", line: ifTok.line)
		if not thenTerminated and not elseTerminated 'bothFallThrough'
			self.mergeAtContinuation(thenEnd, predB: elseEnd, cont: cont, valsA: thenVals, valsB: elseVals)
			self.emitBranch(thenEnd, targetId: cont.id)
			self.emitBranch(elseEnd, targetId: cont.id)
		end 'bothFallThrough' else if not thenTerminated 'onlyThen'
			// Only the then branch reaches the continuation — its values carry through.
			self.restoreValues(thenVals)
			self.emitBranch(thenEnd, targetId: cont.id)
		end 'onlyThen' else 'onlyElse'
			// Only the else branch reaches the continuation (its values are already the
			// current bindings after parsing it, but restore explicitly for symmetry).
			self.restoreValues(elseVals)
			self.emitBranch(elseEnd, targetId: cont.id)
		end 'onlyElse'
		return cont
	end 'finalizeIfElse'

	// Merge two incoming value snapshots at a continuation block. A mutable binding whose
	// value differs across the paths gets a continuation PHI (a block-arg) and each
	// predecessor records the value it carries on its edge; a binding with the same value
	// on both paths keeps that value with no phi. Each merged binding's current value is
	// set to the phi (or the common value) so code after the `if` reads the merged value.
	//
	// Both snapshots and `mutableVars` are the SAME length: every branch body is a
	// lexical block, so a `var` declared inside one is out of scope — and off
	// `mutableVars` — before its exit values are snapshotted. Anything else would mean
	// the three fell out of step, which is a parser bug, so it panics rather than
	// merging a prefix and silently dropping the rest.
	function mergeAtContinuation(predA IrBlock, predB IrBlock, cont IrBlock, valsA ValueIdArray, valsB ValueIdArray)
		self.assertSnapshotAligned(valsA, site: "mergeAtContinuation/valsA")
		self.assertSnapshotAligned(valsB, site: "mergeAtContinuation/valsB")

		var edgeArgsA = ValueIdArray.create()
		var edgeArgsB = ValueIdArray.create()
		for k in 0 upto self.mutableVars.count() 'eachVar'
			var binding = try self.mutableVars.get(k) otherwise panic("mergeAtContinuation: mutableVars.get OOB at {k}")
			let a = try valsA.get(k) otherwise panic("mergeAtContinuation: valsA.get OOB at {k}")
			let b = try valsB.get(k) otherwise panic("mergeAtContinuation: valsB.get OOB at {k}")
			if a == b 'same'
				binding.boundValue = a
			end 'same' else 'differ'
				let phiId = self.mintPhi(cont)
				binding.boundValue = phiId
				edgeArgsA.push(a)
				edgeArgsB.push(b)
			end 'differ'
		end 'eachVar'
		self.recordBranchEdge(predA, targetId: cont.id, argIds: edgeArgsA)
		self.recordBranchEdge(predB, targetId: cont.id, argIds: edgeArgsB)
	end 'mergeAtContinuation'

	// Rebind each mutable binding to a previously-captured snapshot value (from
	// `snapshotMutableValues`). Used to rewind to the pre-branch state before parsing an
	// `if`'s false path, and to select a single surviving branch's values at a
	// continuation. Written THROUGH the binding, not by name, so a value is never routed
	// to a shadow (see LoopPhiVar).
	function restoreValues(snapshot ValueIdArray)
		self.assertSnapshotAligned(snapshot, site: "restoreValues")
		for k in 0 upto self.mutableVars.count() 'each'
			var binding = try self.mutableVars.get(k) otherwise panic("restoreValues: mutableVars.get OOB at {k}")
			binding.boundValue = try snapshot.get(k) otherwise panic("restoreValues: snapshot.get OOB at {k}")
		end 'each'
	end 'restoreValues'

	// Every value snapshot is positional over `mutableVars` and must therefore have
	// exactly its length — block scoping is what guarantees that (a branch-local `var`
	// is drained at the block's `end`, so it can never lengthen a snapshot taken outside
	// the block). A mismatch means the two fell out of step, which would misattribute
	// every later binding's value by one, so it fails loudly here rather than silently.
	function assertSnapshotAligned(snapshot ValueIdArray, site String)
		let expected = self.mutableVars.count()
		if snapshot.count() != expected 'drifted'
			panic("{site}: value snapshot holds {snapshot.count()} entries but {expected} mutable bindings are in scope — the snapshot drifted out of lockstep with mutableVars")
		end 'drifted'
	end 'assertSnapshotAligned'

	// Parse a `while` loop (M4b):
	//   while <cond> 'label'
	//       <body>
	//   end 'label'
	//
	// Lowering shape (the first BACKWARD-branching CFG): the current block becomes the
	// PREHEADER, which branches unconditionally into a fresh HEADER. The header re-
	// evaluates the condition each iteration (a comparison, fused into `cmp`+`jcc` by
	// the Std→x64 pass, exactly as an `if`) and takes a two-way branch to the BODY or
	// the EXIT. The body ends with a BACK-EDGE branch to the header; `break` branches
	// to the exit, `continue` to the header. `resolveBlockJumps` already patches
	// backward rel32, so no new encoder work is needed.
	//
	// On-the-fly SSA: the header carries one PHI (block-arg) per mutable var in scope,
	// created eagerly BEFORE the body is parsed (the set of body-mutated vars is not yet
	// known). Each phi becomes the var's current value, so the condition and body read
	// the loop-carried value; the preheader and every back-edge feed the phis via the
	// predecessor's `branchEdges`. Returns the EXIT block — the continuation.
	//
	// Minting one phi per var in scope OVER-PRODUCES, and the surplus is not free:
	//   • a var the loop never READS gets a phi nothing reads — but the back edge passes
	//     that phi to ITSELF, so it is self-sustaining and liveness holds it live around
	//     the whole loop. `pruneDeadBlockArgs` (a Std pass) deletes those; without it, two
	//     sequential loops inflate maxlive by one per dead var and can FALSE-E5001.
	//   • a var the loop reads but never WRITES gets a phi that copies a value which never
	//     changes. That one is left in place: biased coloring coalesces it with its
	//     incoming value into one register and the edge copy self-elides, so it costs
	//     nothing (see RegisterAllocator.copyGroupBlocked).
	function parseWhileStatement(func IrFunction, block IrBlock) returns IrBlock throws ParseError
		let whileTok = try self.consume(TokenKind.while)

		// Snapshot each mutable var's value BEFORE the header phis overwrite the
		// current values — the preheader→header block-arg list (their pre-loop values).
		let preheaderVals = self.snapshotMutableValues()

		var header = self.newBlock(func, label: b"whilehdr", line: whileTok.line)
		self.recordBranchEdge(block, targetId: header.id, argIds: preheaderVals)
		self.emitBranch(block, targetId: header.id)

		// Mint the header phis (one per mutable binding in scope, in declaration order so
		// blockArgs and every predecessor's branchEdge argIds stay aligned). Index-based
		// so each binding is a MUTABLE reference — a `for x in …` loop variable is
		// immutable, and installing the phi writes through the binding.
		var phiVars = LoopPhiVarArray.create()
		for k in 0 upto self.mutableVars.count() 'mkPhi'
			var binding = try self.mutableVars.get(k) otherwise panic("parseWhileStatement: mutableVars.get OOB at {k}")
			let phiId = self.mintPhi(header)
			phiVars.push(LoopPhiVar.create(binding, phiId: phiId))
			binding.boundValue = phiId
		end 'mkPhi'

		// Condition, emitted into the header so its flags are live for the condBranch.
		let cond = try self.parseCondition(header)
		let loopLabelTok = try self.consume(TokenKind.charLiteral)

		var body = self.newBlock(func, label: loopLabelTok.value, line: loopLabelTok.line)
		var exit = self.newBlock(func, label: b"whileexit", line: whileTok.line)
		self.emitCondBranch(header, cond: cond, thenId: body.id, elseId: exit.id, ifTok: whileTok)

		self.loops.push(LoopContext.create(loopLabelTok.value, headerId: header.id, exitId: exit.id, phiVars: phiVars))

		// The body is a lexical BLOCK: its declarations are gone — and its `var`s off
		// `mutableVars` — before the back-edge args below are read, so those args name the
		// loop's own phi bindings and never a body-local shadow.
		var bodyEnd = try self.parseBlockBody(func, block: body)

		let ctx = try self.loops.pop() otherwise panic("parseWhileStatement: loop stack empty after body of '{String.from(loopLabelTok.value)}'")

		// Normal back-edge: a body that falls through returns to the header with its
		// (possibly reassigned) current values. A body that always returns/breaks/
		// continues on every path leaves `bodyEnd` terminated — no fall-through edge.
		if not bodyEnd.isTerminated() 'fallsBack'
			self.recordBranchEdge(bodyEnd, targetId: header.id, argIds: self.edgeArgsFor(phiVars))
			self.emitBranch(bodyEnd, targetId: header.id)
		end 'fallsBack'

		self.wireLoopExit(header, exit: exit, ctx: ctx)
		return exit
	end 'parseWhileStatement'

	// Set up the exit block's post-loop variable values. With no `break`, the exit is
	// reached only from the header's false edge, so each var's value there IS its
	// header phi (no exit phi needed). With ≥1 `break`, the exit MERGES the header-
	// false value with each break's value, so it gets its own phis and the header's
	// false edge passes the header phi values into them (the break edges were recorded
	// as the breaks were parsed).
	// Index-based in both loops so each phi var is a MUTABLE binding — a `for x in …`
	// loop variable is immutable, and installing the post-loop value writes through the
	// binding it carries.
	function wireLoopExit(header IrBlock, exit IrBlock, ctx LoopContext)
		if not ctx.hasBreak 'noBreak'
			for k in 0 upto ctx.phiVars.count() 'inherit'
				var pv = try ctx.phiVars.get(k) otherwise panic("wireLoopExit: phiVars.get OOB at {k}")
				pv.binding.boundValue = pv.phiId
			end 'inherit'
			return
		end 'noBreak'

		var headerVals = ValueIdArray.create()
		for k in 0 upto ctx.phiVars.count() 'mkExitPhi'
			var pv = try ctx.phiVars.get(k) otherwise panic("wireLoopExit: phiVars.get OOB at {k}")
			let exitPhiId = self.mintPhi(exit)
			pv.binding.boundValue = exitPhiId
			headerVals.push(pv.phiId)
		end 'mkExitPhi'
		self.recordBranchEdge(header, targetId: exit.id, argIds: headerVals)
	end 'wireLoopExit'

	// Parse `break ['label']` (M4b): branch to the target loop's EXIT block, carrying
	// the current phi-var values so the exit's merge phis see this path's values.
	function parseBreakStatement(block IrBlock) throws ParseError
		let breakTok = try self.consume(TokenKind.break)
		var ctx = try self.resolveControlTarget("break", kwTok: breakTok)
		ctx.hasBreak = true
		self.recordBranchEdge(block, targetId: ctx.exitId, argIds: self.edgeArgsFor(ctx.phiVars))
		self.emitBranch(block, targetId: ctx.exitId)
	end 'parseBreakStatement'

	// Parse `continue ['label']` (M4b): branch to the target loop's HEADER (a back-
	// edge), carrying the current phi-var values so the header phis see this path.
	function parseContinueStatement(block IrBlock) throws ParseError
		let continueTok = try self.consume(TokenKind.continue)
		let ctx = try self.resolveControlTarget("continue", kwTok: continueTok)
		self.recordBranchEdge(block, targetId: ctx.headerId, argIds: self.edgeArgsFor(ctx.phiVars))
		self.emitBranch(block, targetId: ctx.headerId)
	end 'parseContinueStatement'

	// Resolve the loop a `break`/`continue` targets. No label → the innermost loop.
	// A label → the enclosing loop with that label; naming the INNERMOST loop's own
	// label is redundant (E2048), and a label matching no enclosing loop is E2047.
	// A `break`/`continue` with no enclosing loop at all is E2047. Returns the live
	// stack entry (a reference) so `break` can flip its `hasBreak`.
	function resolveControlTarget(keyword String, kwTok Token) returns LoopContext throws ParseError
		let depth = self.loops.count()
		if depth == 0 'noLoop'
			throw ParseError.controlOutsideLoop(keyword, line: kwTok.line, column: kwTok.column)
		end 'noLoop'

		if not self.at(TokenKind.charLiteral) 'unlabelled'
			return try self.loops.get(depth - 1) otherwise panic("resolveControlTarget: loops.get({depth - 1}) failed after count check")
		end 'unlabelled'

		let labelTok = try self.consume(TokenKind.charLiteral)
		for i in 0 upto depth 'search'
			let ctx = try self.loops.get(depth - 1 - i) otherwise panic("resolveControlTarget: loops.get OOB during label search")
			if ctx.label.equals(labelTok.value) 'match'
				if i == 0 'ownLabel'
					throw ParseError.labelTargetsOwnLoop(keyword, label: String.from(labelTok.value), line: labelTok.line, column: labelTok.column)
				end 'ownLabel'
				return ctx
			end 'match'
		end 'search'
		throw ParseError.unknownLoopLabel(keyword, label: String.from(labelTok.value), line: labelTok.line, column: labelTok.column)
	end 'resolveControlTarget'

	// The current SSA value of each mutable binding IN SCOPE, in declaration order — the
	// preheader block-arg list for a loop header (their values before the loop runs), and
	// the branch snapshots an `if` merges.
	function snapshotMutableValues() returns ValueIdArray
		var vals = ValueIdArray.create()
		for binding in self.mutableVars 'each'
			vals.push(binding.boundValue)
		end 'each'
		return vals
	end 'snapshotMutableValues'

	// The current SSA value of each phi binding, in phi order — an in-edge's block-arg
	// list (a back-edge to the header, or a break to the exit). Read off the BINDING, so
	// a `break` out of a block that shadows a loop-carried `var` still carries the
	// loop's own binding to the exit phi, not the shadow's value.
	function edgeArgsFor(phiVars LoopPhiVarArray) returns ValueIdArray
		var vals = ValueIdArray.create()
		for pv in phiVars 'each'
			vals.push(pv.binding.boundValue)
		end 'each'
		return vals
	end 'edgeArgsFor'

	// Mint a phi (block-arg) on `block` and return its fresh ValueId. Every M4b merge phi
	// — if-continuation, loop header, loop exit — is i64 (the milestone is int-only), so
	// the block-arg width is fixed here in ONE place rather than respelled at each of the
	// three mint sites.
	function mintPhi(block IrBlock) returns ValueId
		let phiId = allocValueId(self.valueIds)
		block.blockArgs.push(IrBlockArg.create(phiId, argType: StdType.i64))
		return phiId
	end 'mintPhi'

	// Record the block-arg values `block` passes to `targetId` for the Std-tier
	// phi-elim pass. A branch op carries only the target BlockId, so the per-edge phi
	// operands live on the predecessor's `branchEdges` (see IrBlock). An empty list
	// means the target has no phis — nothing to record.
	function recordBranchEdge(block IrBlock, targetId BlockId, argIds ValueIdArray)
		if argIds.count() == 0 'noArgs'
			return
		end 'noArgs'
		block.branchEdges.push(BranchEdge.create(targetId, argIds: argIds))
	end 'recordBranchEdge'

	// Create + register a fresh block in `func`, filling the source footprint from the
	// parser's own file/position so the four `if` block-creation sites don't each
	// respell it.
	function newBlock(func IrFunction, label ByteArray, line LineNumber) returns IrBlock
		return self.artifact.module.addBlockAt(func, label: label, filePath: self.filePath.toString(), firstLine: line)
	end 'newBlock'

	// Set `block`'s terminator to a two-way conditional branch, anchored on the `if`
	// keyword's span.
	function emitCondBranch(block IrBlock, cond ValueId, thenId BlockId, elseId BlockId, ifTok Token)
		self.artifact.emitTerminator(block, op: MaxonOp.condBranch(cond, thenBlockId: thenId, elseBlockId: elseId), range: SourceRange.ofToken(ifTok))
	end 'emitCondBranch'

	// Set `block`'s terminator to an unconditional branch. The branch is synthetic (no
	// source token spawned it — it is the compiler wiring a fall-through), so it carries
	// the positionless `SourceRange.none()`.
	function emitBranch(block IrBlock, targetId BlockId)
		self.artifact.emitTerminator(block, op: MaxonOp.branch(targetId), range: SourceRange.none())
	end 'emitBranch'

	// Expression entry — a VALUE context (`let`/`var`/`return`/an argument/inside
	// parentheses). A Pratt precedence climber (M3 replaced M2's `+`-only left-fold):
	// it starts at the loosest binary level, `parseBinary` climbs the precedence table
	// (`infixPrecedence`), and `parseUnary` handles prefix `-` as the climber's leaf.
	// See the precedence table above the Parser type.
	//
	// It starts at ComparisonPrecedence — the level BELOW the loosest operator it can
	// actually accept — precisely so that a comparison written here is SEEN by the
	// climber and rejected with the diagnostic that explains why (parseBinary), instead
	// of being left unconsumed and blamed on whatever follows it.
	function parseExpression(block IrBlock) returns ValueId throws ParseError
		return try self.parseBinary(block, minPrec: ComparisonPrecedence)
	end 'parseExpression'

	// Condition entry — the `if`/`while` condition, and the ONE context where a
	// comparison is legal, because it is the one context where its result is CONSUMED by
	// a branch (the Std→x64 pass fuses the pair into `cmp` + `jcc` and never materializes
	// the boolean). The grammar is flat, not climbed:
	//
	//     cond := operand [ cmpOp operand ]        operand := <expression at additive precedence>
	//
	// Parsing each operand at AdditivePrecedence is what stops the climber short of the
	// comparison operator, so the comparison is consumed HERE and nowhere else — which
	// is also why a chain (`a == b == c`) cannot parse: the second `==` is left where the
	// `if`'s block label was expected.
	//
	// A condition that is NOT a comparison is a BOOLEAN VALUE (`if flag`, `while true`).
	// x64 branches on FLAGS, and the fused lowering only knows the flags a `cmp` set — so
	// the truth test is materialized as exactly that: `value != 0`.
	function parseCondition(block IrBlock) returns ValueId throws ParseError
		let condTok = self.current()
		let left = try self.parseBinary(block, minPrec: AdditivePrecedence)

		let opTok = self.current()
		if not comparisonOperator(opTok.kind) 'booleanValue'
			return self.emitTruthTest(block, value: left, condTok: condTok)
		end 'booleanValue'

		self.advance()
		let right = try self.parseBinary(block, minPrec: AdditivePrecedence)
		return self.emitCompare(block, lhs: left, rhs: right, op: infixCmpOp(opTok.kind), opTok: opTok)
	end 'parseCondition'

	// The precedence-climbing core. Parse a unary/primary operand, then while the
	// next token is a binary operator whose precedence is >= `minPrec`, consume it
	// and recurse for the right operand at `precedence + 1` (which makes the operator
	// LEFT-associative). A supported operator below `minPrec`, a non-operator, or the
	// end of the expression stops the climb.
	//
	// The climber emits ARITHMETIC only. A comparison reaching it is a comparison in a
	// VALUE position (`let x = a == b`, `(a == b) + 1`, or the right operand of another
	// comparison) — it would have to materialize a boolean, which the fused compare/branch
	// lowering cannot do, so it is rejected loudly, in operator position, rather than
	// lowered into something that reads stale EFLAGS or an unwritten result register.
	// `parseCondition` consumes the one comparison the language currently allows before
	// the climber ever sees it. Boolean materialization (setcc) lifts this wholesale.
	function parseBinary(block IrBlock, minPrec InfixPrecedence) returns ValueId throws ParseError
		var left = try self.parseUnary(block)

		while true 'climb'
			let opTok = self.current()

			let prec = infixPrecedence(opTok.kind)
			if prec == NotAnInfixOperator or prec < minPrec 'stop'
				break
			end 'stop'

			if comparisonOperator(opTok.kind) 'comparisonNotAValue'
				throw ParseError.unsupported("operator '{opTok.kind.rawValue}' — a comparison is only valid as the sole top-level operator of an `if`/`while` condition (its result fuses into the branch; chained comparison and comparison-as-a-value arrive with boolean materialization)", line: opTok.line, column: opTok.column)
			end 'comparisonNotAValue'

			self.advance()
			let right = try self.parseBinary(block, minPrec: prec + 1)
			left = self.emitBinOp(block, lhs: left, rhs: right, op: infixMaxonOp(opTok.kind), opTok: opTok)
		end 'climb'

		return left
	end 'parseBinary'

	// Materialize the truth test a BOOLEAN-VALUED condition needs: `value != 0`, emitted
	// as the same `compare` op a written-out comparison produces, against a `false`
	// literal. The Std tier's const-folder collapses the pair to `cmp reg, 0` (the zero
	// never occupies a register), and the x64 tier fuses that with the branch — so
	// `if flag` and `if flag != false` lower identically, which is what makes a bool
	// condition need no new machinery in the backend at all.
	//
	// Anchored on the condition's FIRST token: the test is synthetic (no operator token
	// spawned it), and the condition itself is what a diagnostic about it should point at.
	function emitTruthTest(block IrBlock, value ValueId, condTok Token) returns ValueId
		let falseValue = self.emitLiteral(block, value: BoolFalseValue, valueType: MaxonType.boolean, range: SourceRange.ofToken(condTok))
		return self.emitCompare(block, lhs: value, rhs: falseValue, op: MaxonCmpOp.ne, opTok: condTok)
	end 'emitTruthTest'

	// A prefix-operator operand — the climber's leaf. M3 handles prefix `-` (negate).
	// Its operand is a PRIMARY, not another unary: `- -x` therefore fails at the
	// second `-` (parsePrimary raises E2004), matching unary-operators.md's
	// double-negation. Because parseUnary is the leaf of parseBinary, unary minus
	// binds tighter than every binary operator without a precedence entry of its own.
	function parseUnary(block IrBlock) returns ValueId throws ParseError
		if self.at(TokenKind.minus) 'neg'
			let opTok = try self.consume(TokenKind.minus)
			let operand = try self.parsePrimary(block)
			return self.emitUnaryOp(block, operand: operand, op: MaxonUnaryOp.neg, opTok: opTok)
		end 'neg'

		return try self.parsePrimary(block)
	end 'parseUnary'

	// Append a `binOp` op combining two SSA values; return the ValueId it defines.
	// The source range anchors on the operator token (the conventional binop anchor).
	function emitBinOp(block IrBlock, lhs ValueId, rhs ValueId, op MaxonBinOp, opTok Token) returns ValueId
		let result = allocValueId(self.valueIds)
		self.artifact.emitOp(block, op: MaxonOp.binOp(result, lhs: lhs, rhs: rhs, op: op), range: SourceRange.ofToken(opTok))
		return result
	end 'emitBinOp'

	// Append a `unaryOp` op over one SSA value; return the ValueId it defines. The
	// source range anchors on the operator token, mirroring emitBinOp.
	function emitUnaryOp(block IrBlock, operand ValueId, op MaxonUnaryOp, opTok Token) returns ValueId
		let result = allocValueId(self.valueIds)
		self.artifact.emitOp(block, op: MaxonOp.unaryOp(result, operand: operand, op: op), range: SourceRange.ofToken(opTok))
		return result
	end 'emitUnaryOp'

	// Append a `compare` op over two SSA values; return the i1 ValueId it defines.
	// Mirrors emitBinOp but emits the distinct comparison variant (a comparison is not
	// a `binOp` — see MaxonCmpOp). The source range anchors on the comparison operator.
	function emitCompare(block IrBlock, lhs ValueId, rhs ValueId, op MaxonCmpOp, opTok Token) returns ValueId
		let result = allocValueId(self.valueIds)
		self.artifact.emitOp(block, op: MaxonOp.compare(result, lhs: lhs, rhs: rhs, op: op), range: SourceRange.ofToken(opTok))
		return result
	end 'emitCompare'

	// A primary expression: an integer literal, a `true`/`false` literal, a parenthesized
	// sub-expression, a type-qualified numeric bound (`u16.max`), a call, or a variable
	// reference. Anything else where an operand is required (an operator, a delimiter,
	// EOF) is E2004 — "Expected expression but got '<got>'". This is the site `- -x` hits
	// at its second `-`: unary minus's operand is a primary, and a leading `-` is not one.
	function parsePrimary(block IrBlock) returns ValueId throws ParseError
		if self.at(TokenKind.intLiteral) 'intLit'
			return try self.parseIntLiteral(block)
		end 'intLit'

		if self.at(TokenKind.true) or self.at(TokenKind.false) 'boolLit'
			return try self.parseBoolLiteral(block)
		end 'boolLit'

		if self.at(TokenKind.leftParen) 'group'
			return try self.parseParenthesizedExpression(block)
		end 'group'

		if self.at(TokenKind.identifier) 'namedPrimary'
			// Two one-token lookaheads split the three forms an identifier can open. `(`
			// makes it a CALL (the same shape the statement parser uses to tell a call
			// apart from a bare name); `.` makes it a type-qualified numeric bound
			// (`u16.max`) — the only dotted expression the language has until member
			// access lands, and the sized-type names are reserved, so the two cannot
			// collide. Anything else is a variable reference.
			if self.peekKind() == TokenKind.leftParen 'callExpr'
				return try self.parseCallExpression(block)
			end 'callExpr'
			if self.peekKind() == TokenKind.dot 'qualifiedBound'
				return try self.parseTypeQualifiedBoundExpression(block)
			end 'qualifiedBound'
			return try self.parseVariableReference()
		end 'namedPrimary'

		let tok = self.current()
		throw ParseError.expectedExpression(tok.kind.rawValue, line: tok.line, column: tok.column)
	end 'parsePrimary'

	// `( <expr> )` — grouping, which is what makes `(2 + 3) * 4` mean 20 rather than 14.
	// The parentheses produce NO op: the group's value IS the inner expression's, so the
	// only thing they change is the shape of the tree the climber builds.
	//
	// The inner expression is a VALUE context, so a comparison inside parentheses is
	// rejected exactly as one on a `let`'s right-hand side is. That is not a rule about
	// parentheses — it is the fused compare/branch restriction (see parseBinary), and it
	// lifts for both at once when boolean materialization lands.
	function parseParenthesizedExpression(block IrBlock) returns ValueId throws ParseError
		try self.consume(TokenKind.leftParen)
		let value = try self.parseExpression(block)
		try self.consume(TokenKind.rightParen)
		return value
	end 'parseParenthesizedExpression'

	// `true` / `false`. A bool is an i1 carrying 1 or 0 — the same `literal` op an
	// integer uses, typed `boolean` so the Maxon→Std collapse gives it i1 rather than
	// i64. The `bool` TYPE already existed (a comparison produces one, an `if` consumes
	// one); these are the literals that let a program NAME one.
	// ONE emit site, not one per arm: the two literals differ only in the token they
	// consume and the payload they carry, so a change to how a bool is materialized (its
	// MaxonType, its op) lands in a single place and cannot apply to `true` but not `false`.
	function parseBoolLiteral(block IrBlock) returns ValueId throws ParseError
		let tok = self.current()
		var value = BoolTrueValue
		if self.at(TokenKind.true) 'isTrue'
			try self.consume(TokenKind.true)
		end 'isTrue' else 'isFalse'
			try self.consume(TokenKind.false)
			value = BoolFalseValue
		end 'isFalse'
		return self.emitLiteral(block, value: value, valueType: MaxonType.boolean, range: SourceRange.ofToken(tok))
	end 'parseBoolLiteral'

	// A type-qualified numeric bound used as a VALUE (`let x = u16.max`, `if v == u64.max`).
	// The same three tokens a range declaration's endpoint is built from, resolved through
	// the same table — so `int(0 to u64.max)` and `v == u64.max` can never disagree about
	// what `u64.max` is. It materializes an ordinary integer literal.
	function parseTypeQualifiedBoundExpression(block IrBlock) returns ValueId throws ParseError
		let boundTok = self.current()
		let value = try self.parseTypeQualifiedBound()
		return self.emitLiteral(block, value: value, valueType: MaxonType.integer, range: SourceRange.ofToken(boundTok))
	end 'parseTypeQualifiedBoundExpression'

	// Resolve a variable reference to the SSA value its binding aliases — M2's
	// value-substitution model emits NO load op; the reference simply IS the bound
	// value. An unbound name is a positioned parse error (undefinedVariable).
	function parseVariableReference() returns ValueId throws ParseError
		let tok = try self.consume(TokenKind.identifier)
		return try self.scope.lookupValue(tok.value) otherwise throw ParseError.undefinedVariable(String.from(tok.value), line: tok.line, column: tok.column)
	end 'parseVariableReference'

	// Parse a bare-call statement `callee(args…)` — the call is emitted for its effect
	// and its freshly-minted result value is discarded (M5). Deferred result-use rules
	// (`discarded non-void result` lints) grow at a later milestone.
	function parseCallStatement(block IrBlock) throws ParseError
		_ = try self.parseCallExpression(block)
	end 'parseCallStatement'

	// Parse a call expression `callee(args…)` into `block` and return the ValueId its
	// result defines. The callee name is kept as identifier TEXT (a `ByteArray` slice
	// per the MaxonOp value/name split); the arguments are parsed in source order with
	// their `name:` labels. Call-site diagnostics anchor on the callee-through-`)` span.
	function parseCallExpression(block IrBlock) returns ValueId throws ParseError
		let calleeTok = try self.consume(TokenKind.identifier)
		try self.consume(TokenKind.leftParen)

		var args = ValueIdArray.create()
		var argLabels = ByteArrayArray.create()
		var argRanges = SourceRangeArray.create()
		try self.parseCallArgs(block, args: args, argLabels: argLabels, argRanges: argRanges)

		let rparenTok = try self.consume(TokenKind.rightParen)
		return self.emitCall(block, calleeTok: calleeTok, args: args, argLabels: argLabels, argRanges: argRanges, rparenTok: rparenTok)
	end 'parseCallExpression'

	// Parse a comma-separated argument list into the parallel `args`/`argLabels`/
	// `argRanges` lists (all empty for `()`). The caller has consumed `(`; this leaves
	// the cursor on `)`. Each argument is an expression, optionally prefixed by a
	// `name:` label — the FIRST argument must be positional and every later argument
	// must be labelled (`consumeArgLabel` enforces both, positioned at the offending
	// token). Whether a `name:` label actually matches a parameter is a SEMANTIC check
	// (SemanticCheck, which has the callee's signature) — not the parser's job.
	function parseCallArgs(block IrBlock, args ValueIdArray, argLabels ByteArrayArray, argRanges SourceRangeArray) throws ParseError
		if self.at(TokenKind.rightParen) 'noArgs'
			return
		end 'noArgs'

		var argIndex = 0 as ParamCount
		while true 'argLoop'
			// The argument's leading token — the label token when labelled, else the
			// value's first token — anchors this argument's diagnostic span.
			let argFirstTok = self.current()
			let label = try self.consumeArgLabel(argIndex)
			let value = try self.parseExpression(block)

			args.push(value)
			argLabels.push(label)
			argRanges.push(SourceRange.ofToken(argFirstTok))
			argIndex = argIndex + 1

			if not self.at(TokenKind.comma) 'endArgs'
				break
			end 'endArgs'
			try self.consume(TokenKind.comma)
		end 'argLoop'
	end 'parseCallArgs'

	// Consume and validate an optional `name:` label on the next argument, returning the
	// label text (the empty string when unlabelled). The FIRST argument (`argIndex == 0`)
	// must be positional — a label there is E2052; every later argument must be labelled —
	// a bare value there is E2053. A `name:` label is two tokens (identifier + colon); a
	// bare value leaves the cursor untouched. (Whether the label names a real parameter
	// is checked later, in SemanticCheck.)
	function consumeArgLabel(argIndex ParamCount) returns ByteArray throws ParseError
		let labelTok = self.current()
		let isNamed = labelTok.kind == TokenKind.identifier and self.peekKind() == TokenKind.colon

		if argIndex == 0 'firstArg'
			if isNamed 'firstNamed'
				throw ParseError.firstArgNamed(labelTok.line, column: labelTok.column)
			end 'firstNamed'
			return EmptySourceText
		end 'firstArg'

		if not isNamed 'missingLabel'
			throw ParseError.argMissingLabel(labelTok.line, column: labelTok.column)
		end 'missingLabel'
		try self.consume(TokenKind.identifier)
		try self.consume(TokenKind.colon)
		return labelTok.value
	end 'consumeArgLabel'

	// Append a `call` op defining a fresh result value; return the ValueId it defines.
	// The callee is stored as a `ByteArray` slice of its identifier token; the call span
	// runs from the callee name through the closing `)` (the conventional call anchor).
	function emitCall(block IrBlock, calleeTok Token, args ValueIdArray, argLabels ByteArrayArray, argRanges SourceRangeArray, rparenTok Token) returns ValueId
		let result = allocValueId(self.valueIds)
		self.artifact.emitOp(block, op: MaxonOp.call(result, callee: calleeTok.value, args: args, argLabels: argLabels, argRanges: argRanges), range: SourceRange.between(calleeTok, last: rparenTok))
		return result
	end 'emitCall'

	// Parse an integer literal token into a `literal` op, and return the value it defines.
	// The token's text becomes a number through the shared `intLiteralValue`, so a literal
	// in an expression and a literal in a range bound are read the same way.
	function parseIntLiteral(block IrBlock) returns ValueId throws ParseError
		let tok = try self.consume(TokenKind.intLiteral)
		let value = try self.intLiteralValue(tok, negated: false)
		return self.emitLiteral(block, value: value, valueType: MaxonType.integer, range: SourceRange.ofToken(tok))
	end 'parseIntLiteral'

	// Append a `literal` op defining a fresh value; return the ValueId it defines.
	function emitLiteral(block IrBlock, value ParsedInt, valueType MaxonType, range SourceRange) returns ValueId
		let result = allocValueId(self.valueIds)
		self.artifact.emitOp(block, op: MaxonOp.literal(result, value: value, valueType: valueType), range: range)
		return result
	end 'emitLiteral'

	// --- token cursor ---

	// The token at the cursor, or a synthetic EOF once past the end. The lexer
	// already appends a real EOF, so this is only a belt-and-suspenders guard.
	function current() returns Token
		if self.pos < self.tokens.count() 'inRange'
			return try self.tokens.get(self.pos) otherwise panic("Parser.current: pos<count just checked but get({self.pos}) failed")
		end 'inRange'
		return Token.eof()
	end 'current'

	function at(kind TokenKind) returns bool
		return self.current().kind == kind
	end 'at'

	// The kind of the token ONE past the cursor (or eof past the end). The parser's
	// only two-token lookahead: distinguishing a reassignment (`ident =`) from a bare
	// identifier statement (`ident …`) needs to see the `=` without committing to
	// consuming the identifier first.
	function peekKind() returns TokenKind
		let next = self.pos + 1
		if next < self.tokens.count() 'inRange'
			let tok = try self.tokens.get(next) otherwise panic("Parser.peekKind: next<count just checked but get({next}) failed")
			return tok.kind
		end 'inRange'
		return TokenKind.eof
	end 'peekKind'

	function isEof() returns bool
		return self.at(TokenKind.eof)
	end 'isEof'

	function advance()
		if self.pos < self.tokens.count() 'inRange'
			self.pos = self.pos + 1
		end 'inRange'
	end 'advance'

	// Consume a token of the expected kind, or throw a positioned mismatch error.
	// A TokenKind's `.rawValue` is its human-readable display text ("(", "return").
	function consume(kind TokenKind) returns Token throws ParseError
		let tok = self.current()
		if tok.kind != kind 'mismatch'
			throw ParseError.unexpectedToken(kind.rawValue, got: tok.kind.rawValue, line: tok.line, column: tok.column)
		end 'mismatch'
		self.advance()
		return tok
	end 'consume'

	function skipNewlines()
		while self.at(TokenKind.newline) 'skip'
			self.advance()
		end 'skip'
	end 'skipNewlines'

	// Consume an optional block label (`'name'`, a charLiteral) after `end`.
	function skipOptionalLabel()
		if self.at(TokenKind.charLiteral) 'label'
			self.advance()
		end 'label'
	end 'skipOptionalLabel'
end 'Parser'
